// ============================================ RUNDE BELEG: DER MESSAUSGANG
// STEHT IM NORMALBETRIEB AUS.
//
// Justins Befund am Abbild vom 12.09.2026: im Terminalfenster standen
// Zeilen wie `explorer: krumm n=2 fold=0` und `bg=...`. Gezaehlt hat er
// auch: 160 `ulib.say` in taskbar.fi, 38 in explorer.fi.
//
// Die Regel dazu steht seit Runde LAUFZEIT in taskmgr.fi:
//
//   EIN MESSAUSGANG GEHOERT HINTER EINEN SCHALTER, UND DER SCHALTER
//   STEHT IM NORMALBETRIEB AUS. Ein Programm, das im Auslieferungs-
//   zustand misst, misst vor allem sich selbst.
//
// NICHT GELOESCHT, SONDERN GESCHALTET. Die Zaehler (`fui=`, `fuix=`,
// `rect id=`, `text ... base=`) waren mehrfach der Schluessel zur
// Fehlersuche -- sie muessen fuer die Abnahme da sein. Also EIN Schalter
// statt zweihundert geloeschter Zeilen.
//
// ZWEI WEGE, IHN EINZUSCHALTEN, und beide gab es schon:
//   /etc/uitrace   die Datei, mit der `wlib` seit Runde LOOK dasselbe
//                  tut -- die Pruefstaende legen sie ohnehin an
//   `debug`        als Wort auf der Programmzeile, fuer den Fall, dass
//                  einer allein gestartet wird
//
// OHNE BEIDES AENDERT SICH KEIN OKTETT gegenueber vorher -- das ist die
// Bedingung dafuer, dass kein bestehender Testlaeufer davon etwas merkt.
static mut s_dbg: u64 = 0

// Die drei Ausgaenge dieses Programms, an EINER Stelle geschaltet.
// `sayn` und `nl` stehen hier, damit kein Aufrufer `ulib.` direkt
// nimmt und damit am Schalter vorbeigeht.
fn dbg_on() -> bool {
    return s_dbg != 0
}

fn dbg_setup(args: u64) {
    // `qs` ist die Schnelleinstellung der Leiste und bekommt keine
    // Programmzeile -- `args` bleibt hier ungenutzt, der Schalter kommt
    // ueber die Datei. Die Signatur ist trotzdem dieselbe wie in den
    // fuenf Programmen, damit man nicht zweimal hinsehen muss.
    let _unused: u64 = args
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_dbg = 1
    }
    var a_dbg: [u8; 6] = "debug\0"
    let argc: u64 = ulib.arg_count(args)
    var ai: u64 = 1
    while ai < argc {
        if ulib.streq(ulib.arg_at(args, ai), (&a_dbg[0 as usize]) as u64) {
            s_dbg = 1
        }
        ai = ai + 1
    }
}

fn say(p: u64) {
    if s_dbg == 0 {
        return
    }
    ulib.say(p)
}

fn sayn(v: u64) {
    if s_dbg == 0 {
        return
    }
    ulib.sayn(v)
}

fn nl() {
    if s_dbg == 0 {
        return
    }
    ulib.nl()
}

fn tlen(p: u64) -> u64 {
    return ulib.length(p)
}

fn nth(p: u64, i: u64) -> u64 {
    var at: u64 = 0
    var k: u64 = 0
    while k < i {
        while __mmio_read8((p + at) as *mut u8) != 0 as u8 {
            at = at + 1
        }
        at = at + 1
        k = k + 1
    }
    return p + at
}

// CLOCK_MONOTONIC, the same clock `kbd.fi` stamped the press with and
// the same one `nvcheck` measures the faked connection with. Not
// `ticks` -- ticks are ten milliseconds in this kernel and the whole
// question here is whether the panel is up in less than that.
fn now_ns() -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    let _r: u64 = kcall.sys2(kcall.SYS_CLOCK_GETTIME, 1,
        (&ts[0 as usize]) as u64)
    return (ts[0 as usize] *% 1000000000) +% ts[1 as usize]
}

// ------------------------------------------------------- the symbols

fn icon_read(name: u64, dst: u64, max: u64) -> u64 {
    var path: [u8; 48] = [0 as u8; 48]
    let p: u64 = (&path[0 as usize]) as u64
    var at: u64 = ulib.strcpy(p, (&p_icons[0 as usize]) as u64)
    at = at + ulib.strcpy(p + at, name)
    let fd: u64 = io.open(p, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = io.read(fd, dst, max)
    io.close(fd)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn icons_load() {
    ic_ok = 0
    var i: u64 = 0
    while i < N_TILE_ALL {
        if icon_read(nth((&n_ic[0 as usize]) as u64, i),
            (&ic_buf[0 as usize]) as u64 + i * ICON_MAX, ICON_MAX) > 12 {
            ic_ok = ic_ok + 1
        }
        i = i + 1
    }
}

// ONE DRAWING PER TILE, not one per tile and state. It was built the
// other way first and measured: two sixteen-by-sixteen glyphs that
// differ only on the inside come out about a quarter of their pixels
// apart, under the third `tools/netview/icons.py` demands of any two
// signs that mean different things -- and the tool was right, a quarter
// is not something anybody sees at a glance.
//
// So the switch position is carried where a toggle actually carries it,
// and only one of the three is colour: the WORD under the tile ("an" /
// "aus"), the RELIEF of the frame (raised off, sunken on), and the
// fill. See `assets/netview/tile-net.txt`, where the reasoning sits
// next to the drawing.
fn tile_icon(t: u64) -> u64 {
    if ic_ok < N_TILE_ALL {
        return 0
    }
    return (&ic_buf[0 as usize]) as u64 + t * ICON_MAX
}

// ---------------------------------------------------- what each tile is
//
// READ FRESH, NEVER REMEMBERED. Every one of these three is a question
// somebody else can also answer -- `/bin/netview fallback` sets the
// first, `dhcp` can change the second, `/bin/settings` the third.
// A panel with its own copy would show the copy.

fn pget(f: u64) -> u64 {
    let v: u64 = ulib.sys(SYS_PWRGET, f, 0, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

fn dget(f: u64) -> u64 {
    let v: u64 = ulib.sys(SYS_DISPGET, f, 0, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

fn tget(f: u64) -> u64 {
    let v: u64 = ulib.sys(SYS_TILEGET, f, 0, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

// KANN DIE MASCHINE DAS UEBERHAUPT? Der Kern sagt es selbst: `PG_READY`
// ist 1, wenn die Energieverwaltung ihre Register wirklich gelesen hat.
// Steht dort eine Null, zeigt die Kachel einen Strich -- und nicht
// "sparen", was wie eine Einstellung aussaehe.
fn power_da() -> bool {
    return pget(PG_READY) != 0
}

fn tile_on(t: u64) -> bool {
    if t == 0 {
        return nv.fallback_on()
    }
    if t == 1 {
        return nv.net_ip() != 0 && !ulib.bad(nv.net_ip())
    }
    if t == 2 {
        return ah_on != 0
    }
    if t == 3 {
        return wlibc.theme_dark()
    }
    if t == 4 {
        // "an" heisst hier: nicht auf Sparen. Das Wort darunter sagt
        // ohnehin, welches der drei Profile laeuft.
        return power_da() && pget(PG_PROFILE) != 0
    }
    return tget(TL_ON) != 0
}

fn tile_label(t: u64) -> u64 {
    if t == 0 {
        return msg.get((&k_fake[0 as usize]) as u64)
    }
    if t == 1 {
        return msg.get((&k_net[0 as usize]) as u64)
    }
    if t == 2 {
        return msg.get((&k_hide[0 as usize]) as u64)
    }
    if t == 3 {
        return msg.get((&k_dark[0 as usize]) as u64)
    }
    if t == 4 {
        return msg.get((&k_power[0 as usize]) as u64)
    }
    return msg.get((&k_tile[0 as usize]) as u64)
}

// ================================================== RUNDE FUI-WIN11
// DER GLYPH JE KACHEL, AUS DER SYMBOLSCHRIFT DES SYSTEMS.
//
// lib/icons.fi ist die EINE Quelle fuer Symbole in diesem Baum -- die
// Leiste nimmt daraus START, Netz, Ton und Akku. Hier stehen die
// Entsprechungen fuer die vier Trayschalter. Kein zweiter Symbolsatz,
// keine eigenen Bilddateien: genau die Regel, die der Auftrag
// verlangt.
//
// DAS NETZSYMBOL WECHSELT MIT DEM ZUSTAND, weil es das auf jedem
// System tut: ein durchgestrichenes Kabel heisst etwas anderes als ein
// verbundenes. Die anderen drei tragen EIN Zeichen; ihren Zustand
// traegt die Farbe.
fn tile_glyph(t: u64) -> u64 {
    if t == 0 {
        return icons.NETWORK_FAKED
    }
    if t == 1 {
        if tile_on(1) {
            return icons.NETWORK_WIRED
        }
        return icons.NETWORK_OFFLINE
    }
    if t == 2 {
        return icons.MENU
    }
    if t == 3 {
        return icons.SETTINGS
    }
    if t == 4 {
        return icons.BATTERY_CHARGING
    }
    return icons.START
}

// HAT DIESE KACHEL ETWAS HINTER SICH? Nur das Energieprofil: drei
// Stufen, die man waehlen kann. Alles andere ist ein Schalter.
fn tile_has_sub(t: u64) -> bool {
    return t == 4
}

// Die Groesse des Pfeilknopfes rechts an solchen Kacheln.
fn CHEV_W() -> u64 {
    return 14 * sk()
}

fn CHEV_G() -> u64 {
    return 8 * sk()
}

// ================================================== RUNDE FUI-WIN11
// DIE AUFSCHRIFT DER KACHEL -- MIT DEM DRITTEN ZUSTAND DARIN.
//
// Vier der fuenf Kacheln sind Schalter: ihre Aufschrift ist der Name,
// ihr Zustand ist die Farbe, und ein Wort darunter waere die
// Verdopplung, die Justin angestrichen hat.
//
// Das ENERGIEPROFIL ist die Ausnahme, und sie ist echt: es hat DREI
// Stufen (sparen/mitte/leistung), und drei Zustaende lassen sich nicht
// mit zwei Farben sagen. Sein Name steht deshalb hinter dem der
// Kachel, in DERSELBEN Zeile: "Energie: sparen". Das ist eine Angabe
// und kein Zustandswort -- und es bleibt bei einer Textzeile.
fn tile_label_txt(t: u64) -> u64 {
    if t != 4 {
        return tile_label(t)
    }
    let z: u64 = (&lab_buf[0 as usize]) as u64
    var at: u64 = ulib.strcpy(z, tile_label(t))
    at = at + ulib.strcpy(z + at, (&u_sp[0 as usize]) as u64)
    let _r: u64 = ulib.strcpy(z + at, tile_word(t))
    return z
}

// DAS WORT UNTER DER KACHEL. Bei fuenf Kacheln ist es "an" oder "aus";
// beim Energieprofil ist es der NAME des Profils, denn drei Zustaende
// lassen sich nicht mit zwei Woertern sagen -- und ein Schalter, der
// "an" zeigt, wenn drei Dinge moeglich sind, sagt nichts.
fn tile_word(t: u64) -> u64 {
    if t == 4 {
        if !power_da() {
            return msg.get((&k_na[0 as usize]) as u64)
        }
        let p: u64 = pget(PG_PROFILE)
        if p == 0 {
            return msg.get((&k_p0[0 as usize]) as u64)
        }
        if p == 1 {
            return msg.get((&k_p1[0 as usize]) as u64)
        }
        return msg.get((&k_p2[0 as usize]) as u64)
    }
    if tile_on(t) {
        return msg.get((&k_on[0 as usize]) as u64)
    }
    return msg.get((&k_off[0 as usize]) as u64)
}

// The address the machine had before "network off" took it away, so
// that "network on" can give the same one back. It is REMEMBERED HERE
// and nowhere else, and it is deliberately not written to a file: a
// remembered address that survives a reboot would be a second, stale
// answer to a question DHCP already answers at every start.
static mut old_ip: u64 = 0
static mut old_mask: u64 = 0
static mut old_gw: u64 = 0

fn tile_click(t: u64) -> u64 {
    if t == 3 {
        // SOFORT UND DAUERHAFT. `theme_set_mode` schreibt in die
        // gemeinsame Bank, aus der JEDES Fenster liest -- die anderen
        // Programme ziehen beim naechsten `theme_poll` nach, ohne dass
        // hier jemand benachrichtigt werden muesste. `mode_write` legt
        // eine Zeile in /etc/theme.conf, damit es den Neustart
        // ueberlebt; geschrieben wird sie von dem Modul, das die Datei
        // ohnehin schreibt, und nicht von hier.
        var neu: u64 = wlibc.MODE_DARK
        if wlibc.theme_dark() {
            neu = wlibc.MODE_LIGHT
        }
        wlibc.theme_set_mode(neu)
        if !template.mode_write(neu) {
            return 0 - 1
        }
        return 0
    }
    if t == 4 {
        if !power_da() {
            return 0 - 1
        }
        var p: u64 = pget(PG_PROFILE) + 1
        if p > 2 {
            p = 0
        }
        return ulib.sys(SYS_PWRSET, PS_PROFILE, p, 0)
    }
    if t == 5 {
        return ulib.sys(SYS_TILEDO, A_TILE_TOGGLE, 0, 0)
    }
    if t == 0 {
        return nv.fallback_switch(!nv.fallback_on())
    }
    if t == 1 {
        if tile_on(1) {
            old_ip = nv.net_ip()
            old_mask = nv.net_mask()
            old_gw = nv.net_gw()
            return nv.net_off()
        }
        if old_ip == 0 {
            return 0 - 1
        }
        return nv.net_on(old_ip, old_mask, old_gw)
    }
    // The taskbar owns `/etc/taskbar.conf` and writes it in exactly one
    // place. This tile asks; `taskbar.fi` does it and tells us what came
    // of it (`took_hide`). Two writers of one file is how a file ends
    // up disagreeing with itself.
    if ah_on != 0 {
        hide_want = 2
    } else {
        hide_want = 1
    }
    return 0
}

fn want_hide() -> u64 {
    return hide_want
}

// The bar hands back what it actually did, and the tile shows THAT --
// not what it asked for.
fn took_hide(now: u64) {
    hide_want = 0
    ah_on = now
}

// --------------------------------------------------------- the window

fn init(autohide: u64) -> bool {
    dbg_setup(0)
    ah_on = autohide
    asc = wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    icons_load()
    say((&s_ico[0 as usize]) as u64)
    sayn(ic_ok)
    nl()
    let h: u64 = wlibc.sys5(wlibc.WM_CREATE, 0, (W() << 16) | H(),
        (&t_title[0 as usize]) as u64, 0, 0)
    if ulib.bad(h) || h == 0 {
        return false
    }
    w_h = h
    let _d: u64 = wlibc.win_state(h, wlibc.WS_DECO, 0)
    // L_NORMAL AND NOT L_TOP, and it was L_TOP first and measured
    // wrong: Escape never arrived. The window server gives the keyboard
    // ONLY to a window on the normal layer -- `wm.set_layer` explicitly
    // takes the focus away from anything that leaves it, and
    // `wm.on_mouse` only calls `set_focus` for L_NORMAL. That is a good
    // rule and it is round DESKTOP's: a taskbar that swallowed the
    // keyboard would make every key after a click on it useless.
    //
    // But this panel is not a taskbar. It has to be typed at -- Escape
    // is one of its three ways of closing, and a panel the keyboard
    // cannot get out of would be worse than none. So it lives on the
    // normal layer and is RAISED when it opens, which puts it over
    // everything except the bar itself; and since it sits beside the
    // bar rather than on it, that is exactly right.
    //
    // The price is one line in the taskbar: a window on the normal
    // layer gets a button in the bar, and this one must not
    // (`taskbar.list_read` skips this id). It is part of the bar, not an
    // application.
    // ============================================ RUNDE ECHTHARDWARE-3
    // JETZT GEHT BEIDES: UEBER DER LEISTE *UND* MIT TASTATUR.
    //
    // Der Absatz darueber beschreibt eine Zwangslage, die es seit
    // dieser Runde nicht mehr gibt. Sie lautete: entweder `L_TOP`
    // (dann ueber der Leiste, aber ohne Tastatur, also ohne Escape)
    // oder `L_NORMAL` (dann mit Tastatur, aber unter der Leiste und
    // mit einem Knopf in ihr, den `taskbar.list_read` eigens
    // wegfiltern muss).
    //
    // Beides ist jetzt keine Wahl mehr: `L_MENUE` liegt UEBER der
    // Leiste (wm.fi: L_TOP < L_MENUE), und `WS_KEYS` sagt dem Server
    // ausdruecklich, dass dieses Fenster die Tastatur will -- die
    // Ausnahme, die `wm.on_mouse` seit ECHTHARDWARE-1 kennt (F_KEYS).
    // Das Kontrollzentrum ist ein Teil der Leiste und gehoert dorthin,
    // wo das Startmenue auch liegt.
    let _l: u64 = wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_MENUE)
    let _k: u64 = wlibc.win_state(h, wlibc.WS_KEYS, 1)
    let _v: u64 = wlibc.win_state(h, wlibc.WS_HIDDEN, 1)
    // Eine Marke NACH den drei Zustandsaufrufen: kommt sie, haben alle
    // drei zurueckgekehrt, und der Verdacht liegt allein auf WM_INFO.
    say((&s_wst[0 as usize]) as u64)
    nl()
    say((&s_wfrag[0 as usize]) as u64)
    w_id = wlibc.sys3w(wlibc.WM_INFO, h, wlibc.WI_ID, 0)
    // EIN Schreibvorgang fuer die ganze Zeile, Zeilenende eingebaut.
    var zl: [u8; 48] = [0 as u8; 48]
    let zp: u64 = (&zl[0 as usize]) as u64
    var zn: u64 = 0
    zn = anhaengen(zp, zn, (&s_wid[0 as usize]) as u64)
    zn = zn + ulib.digits(w_id, zp + zn)
    __mmio_write8((zp + zn) as *mut u8, 10 as u8)
    zn = zn + 1
    let _z: u64 = ulib.put(zp, zn)
    return true
}

// Text an einen Puffer haengen, ohne Zeilenende. Fuer die eine Zeile,
// die in EINEM Stueck hinausgehen muss.
fn anhaengen(buf: u64, at: u64, t: u64) -> u64 {
    let n: u64 = ulib.length(t)
    var i: u64 = 0
    while i < n {
        __mmio_write8((buf + at + i) as *mut u8, *((t + i) as *mut u8))
        i = i + 1
    }
    return at + n
}

// So the bar can leave itself out of its own list of windows.
fn win_id() -> u64 {
    return w_id
}

// WHERE THE TASKBAR IS, out of the taskbar. The work area is what is
// left of the screen after every reserved edge; the panel goes in the
// corner of THAT, on the side the bar is on.
fn anchor(edge: u64, wx: u64, wy: u64, ww: u64, wh: u64) {
    a_edge = edge
    a_x = wx
    a_y = wy
    a_w = ww
    a_h = wh
    place()
}

fn place() {
    var x: u64 = 0
    var y: u64 = 0
    if a_w > W() + 2 * MARGIN {
        x = a_x + a_w - W() - MARGIN
    } else {
        x = a_x
    }
    if a_h > H() + 2 * MARGIN {
        y = a_y + a_h - H() - MARGIN
    } else {
        y = a_y
    }
    // TOP: the bar is above, so the panel hangs from the top of what is
    // left. LEFT: the bar is beside it, so the panel starts at the left
    // of what is left -- and stays at the BOTTOM, because that is where
    // the icon group of a vertical bar is.
    if a_edge == wlibc.WE_TOP {
        y = a_y + MARGIN
    }
    if a_edge == wlibc.WE_LEFT {
        x = a_x + MARGIN
    }
    px_ = x
    py_ = y
    // RUNDE TON-2: WO DAS PANEL STEHT, auf der Leitung.
    //
    // Ohne diese Zeile ist jedes Bildschirmfoto des Panels eine
    // Suchaufgabe: die Texte melden PANEL-Koordinaten (`qs: text x=10
    // y=320`), das Bild hat BILDSCHIRM-Koordinaten, und der Ursprung
    // stand nirgends. Ein Pruefer, der ihn raten muss, misst
    // irgendwann die falsche Stelle und glaubt das Ergebnis.
    say((&s_geo[0 as usize]) as u64)
    sayn(px_)
    say((&s_gy2[0 as usize]) as u64)
    sayn(py_)
    say((&s_gw[0 as usize]) as u64)
    sayn(W())
    say((&s_gh[0 as usize]) as u64)
    sayn(H())
    nl()
    if open_ != 0 {
        let _m: u64 = wlibc.sys3w(wlibc.WM_MOVE, w_h, (px_ << 16) | py_, 0)
    }
}

fn is_open() -> bool {
    return open_ != 0
}

// Is this SCREEN point on the panel? The taskbar asks before it treats
// a press as the beginning of a drag.
fn hit(x: u64, y: u64) -> bool {
    if open_ == 0 {
        return false
    }
    return x >= px_ && x < px_ + W() && y >= py_ && y < py_ + H()
}

fn open_at(when: u64) {
    if open_ != 0 {
        return
    }
    t0 = when
    place()
    let _m: u64 = wlibc.sys3w(wlibc.WM_MOVE, w_h, (px_ << 16) | py_, 0)
    let _v: u64 = wlibc.win_state(w_h, wlibc.WS_HIDDEN, 0)
    open_ = 1
    opens = opens + 1
    // ================================================== RUNDE 31
    // DIE FLANKE, DIE DAS PANEL GEOEFFNET HAT, DARF ES NICHT SOFORT
    // WIEDER SCHLIESSEN.
    //
    // GEMESSEN, und zwar auch OHNE die Umstellung auf fUi (eigener
    // Arbeitsbaum auf dem Stand davor -- gleiches Ergebnis):
    //
    //     qs: hell spur von=898 bis=1266 ym=583     <- einmal gemalt
    //     qs: closed by outside                     <- und schon zu
    //
    // Das Panel malte sich EINMAL und war dann `hidden=1`. Der Grund
    // steht in `step`: sie pollt den Zeiger und schliesst bei einer
    // Tastenflanke ausserhalb. Der Klick, der das Panel aufmacht,
    // liegt aber auf dem Symbol in der TASKLEISTE (y=764..796) --
    // also ausserhalb des Panels (y=386..756). Beim ersten Poll nach
    // dem Oeffnen ist die Taste noch unten und `btn_last` noch 0:
    // eine Flanke, die von aussen kommt, und weg ist das Panel.
    //
    // Es fiel nicht auf, weil das eingebaute Drehbuch von
    // tools/design/capture.sh danach nur FOTOGRAFIERT -- und ein Bild
    // ohne Panel sieht aus wie ein Bild, auf dem das Panel eben nicht
    // mehr offen ist. Erst wer den Regler ZIEHEN will, merkt es:
    // der Wert blieb bei jedem Zug auf seinem Anfangswert stehen.
    //
    // Also: beim Oeffnen so tun, als sei die Taste schon gesehen
    // worden. Dann ist die naechste Flanke die, die der Benutzer
    // WIRKLICH neu macht -- und ein Druck daneben schliesst weiter
    // sofort, was der Sinn dieser Abfrage ist.
    btn_last = wlibc.mouse_btn() & 1
    // TWO STAMPS AND NOT ONE, because a single number does not say
    // where the time went. The first is the moment the WINDOW STANDS
    // (moved, unhidden) -- everything before it is the wait for the
    // taskbar's poll to come round. The second is after the PAINT. The
    // difference between them is drawing; the first one on its own is
    // latency, and they are worth different things.
    let t_up: u64 = now_ns()
    // PAINTED, NOT REPORTED, AND THE STOPWATCH STOPS HERE. The first
    // measurement said 365 771 microseconds and it was measuring the
    // SERIAL LINE: `paint(true)` writes a dozen lines about what it
    // drew, at 115 200 baud, inside the window being timed. Round
    // TASKBAR made exactly this mistake with auto-hide and wrote it
    // down; this is the same lesson, applied to the same file. What is
    // timed is the work the person waits for -- move, show, draw. The
    // report comes afterwards, outside the measurement.
    paint(false)
    let t_done: u64 = now_ns()
    // AND THE FOCUS, so that Escape arrives. A panel that could only be
    // closed with the pointer would be a panel the keyboard cannot get
    // out of.
    let _a: u64 = wlibc.win_act(w_id, wlibc.WA_RAISE)
    // THE STOPWATCH STOPS HERE, after the window stands and is painted,
    // and it started in the KEYBOARD INTERRUPT (`kbd.fi` wrote the
    // clock into the latch). One clock, both ends, nothing in between
    // estimated.
    say((&s_open[0 as usize]) as u64)
    sayn(px_)
    say((&s_y[0 as usize]) as u64)
    sayn(py_)
    say((&s_w[0 as usize]) as u64)
    sayn(W())
    say((&s_h[0 as usize]) as u64)
    sayn(H())
    say((&s_ed[0 as usize]) as u64)
    sayn(a_edge)
    say((&s_up[0 as usize]) as u64)
    var d1: u64 = 0
    if t0 != 0 && t_up > t0 {
        d1 = (t_up -% t0) / 1000
    }
    sayn(d1)
    say((&s_us[0 as usize]) as u64)
    var d: u64 = 0
    if t0 != 0 && t_done > t0 {
        d = (t_done -% t0) / 1000
    }
    sayn(d)
    nl()
    // RUNDE ECHT: und wo die Kacheln liegen, damit ein Laeufer sie
    // treffen kann, ohne PAD/TW/GAP nachzurechnen.
    kacheln_say()
    paint(true)
}

fn shut(why: u64) {
    if open_ == 0 {
        return
    }
    open_ = 0
    t0 = 0
    let _v: u64 = wlibc.win_state(w_h, wlibc.WS_HIDDEN, 1)
    say((&s_shut[0 as usize]) as u64)
    say(why)
    nl()
}

fn toggle() {
    if open_ != 0 {
        shut((&s_key[0 as usize]) as u64)
    } else {
        open_at(now_ns())
    }
}

// ----------------------------------------------------------- the poll
//
// Called once per turn of the taskbar's loop. Three jobs and none of
// them costs anything while the panel is shut: the hotkey latch is one
// system call, the event ring is one, and the pointer is only asked
// while the panel is open.
// RUNDE ECHTHARDWARE-3: laeuft gerade ein Ziehen, das mit einem Druck
// IN diesem Fenster begonnen hat? Nur dann verstellt eine Bewegung
// einen Regler.
static mut zieht: u64 = 0

fn step() -> bool {
    var changed: bool = false
    let seq: u64 = nv.hotkey_seq()
    if seq != hk_last {
        let was: u64 = hk_last
        hk_last = seq
        // 97 is `a`. ONE hotkey, and it is spelled out rather than
        // configurable: a key map is a round of its own and inventing
        // half of one here would be the kind of half-thing this round
        // keeps refusing.
        if was != 0 || seq == 1 {
            if nv.hotkey_key() == 97 {
                if open_ != 0 {
                    shut((&s_key[0 as usize]) as u64)
                } else {
                    open_at(nv.hotkey_ns())
                }
                changed = true
            }
        }
    }
    if open_ == 0 {
        return changed
    }
    var n: u64 = 0
    while n < 16 && wlibc.sys3w(wlibc.WM_EVENT, w_h,
        (&ev[0 as usize]) as u64, 0) == 1 {
        let b: u64 = (&ev[0 as usize]) as u64
        let typ: u64 = __mmio_read64((b) as *mut u64)
        let d: u64 = __mmio_read64((b + 8) as *mut u64)
        if typ == wlibc.EV_KEY {
            // THE CHARACTER IS AT BITS 32..47 AND NOT AT 0. One event
            // word carries three numbers -- `wm.ev_push` packs them
            // `(a << 32) | (b << 16) | c` -- and for a key the
            // character is `a`. Read as the whole word it is 27 << 32,
            // which is never 27, so the first version of this simply
            // ignored every Escape and looked exactly like a focus
            // problem. It cost two runs to stop believing that.
            if ((d >> 32) & 0xFFFF) == 27 {
                shut((&s_esc[0 as usize]) as u64)
                return true
            }
        } else if typ == wlibc.EV_DOWN {
            // JEDER DRUCK WIRD GEMELDET, bevor er ausgewertet wird.
            // Ohne diese Zeile ist ein Klick, der gar nicht ankommt,
            // nicht von einem zu unterscheiden, der ankommt und
            // danebenliegt -- und die Abnahme dieser Runde hat genau
            // diese beiden Faelle zweimal verwechselt.
            say((&s_druck[0 as usize]) as u64)
            sayn((d >> 32) & 0xFFFF)
            say((&s_y[0 as usize]) as u64)
            sayn((d >> 16) & 0xFFFF)
            nl()
            // RUNDE ECHTHARDWARE-6: die gedrueckte Kachel merken,
            // BEVOR `click` sie umschaltet -- danach ist der Zeiger
            // vielleicht schon woanders.
            if print_set(tile_at((d >> 32) & 0xFFFF,
                (d >> 16) & 0xFFFF)) {
                changed = true
            }
            click((d >> 32) & 0xFFFF, (d >> 16) & 0xFFFF)
            zieht = 1
            changed = true
        } else if typ == wlibc.EV_MOVE {
            // ==================================== RUNDE ECHTHARDWARE-3
            // DER REGLER LIESS SICH NICHT ZIEHEN.
            //
            // Justins Befund: "Helligkeitsregler im Kontrollzentrum
            // laesst sich nicht verstellen (Wert aendert sich nicht
            // beim Ziehen)." Diese Schleife kannte genau drei
            // Ereignisse -- EV_KEY, EV_DOWN, EV_CLOSE. Eine BEWEGUNG
            // bei gedrueckter Taste kam nie an, also war der Regler
            // ein Knopf: der Wert sprang auf die Stelle des Klicks
            // und blieb dort. Wer die Maus danach zog, sah nichts
            // mehr passieren -- genau das, was er beschreibt.
            //
            // `click` rechnet aus der Stelle bereits den Wert (die
            // Stelle IST der Wert, siehe dort); es genuegt also, die
            // Bewegung bei gedrueckter Taste durch dieselbe Rechnung
            // zu schicken. `zieht` sorgt dafuer, dass nur eine
            // Bewegung zaehlt, die auf einem Druck IN diesem Fenster
            // begonnen hat -- sonst verstellt ein Zeiger, der bei
            // gedrueckter Taste von aussen hereinfaehrt, die
            // Helligkeit.
            if zieht != 0 && (d & 0xFFFF & 1) != 0 {
                click((d >> 32) & 0xFFFF, (d >> 16) & 0xFFFF)
                changed = true
            }
            if (d & 0xFFFF & 1) == 0 {
                zieht = 0
            }
            // RUNDE ECHTHARDWARE-6: der Zeigerzustand. Nur eine
            // ECHTE Aenderung malt neu -- sonst waere jede
            // Mausbewegung ein voller Anstrich des Panels.
            if hover_set(tile_at((d >> 32) & 0xFFFF,
                (d >> 16) & 0xFFFF)) {
                changed = true
            }
        } else if typ == wlibc.EV_UP {
            zieht = 0
            if print_set(99) {
                changed = true
            }
        } else if typ == wlibc.EV_CLOSE {
            shut((&s_esc[0 as usize]) as u64)
            return true
        }
        n = n + 1
    }
    if open_ == 0 {
        return changed
    }
    // A PRESS BESIDE IT. The window server tells a window about the
    // pointer only while the pointer is INSIDE it, so a press somewhere
    // else raises no event of ours -- the same reason the drag of the
    // bar polls. Only the EDGE of the press counts: holding the button
    // down must not close the panel forty times.
    let btn: u64 = wlibc.mouse_btn() & 1
    if btn != 0 && btn_last == 0 {
        let mx: u64 = wlibc.mouse_x()
        let my: u64 = wlibc.mouse_y()
        // ============================================ RUNDE ECHTHARDWARE-3
        // EIN ZIEHEN IST KEIN DRUCK DANEBEN.
        //
        // Diese Abfrage pollt den Zeiger, weil der Fensterserver einem
        // Fenster nur erzaehlt, was INNERHALB von ihm geschieht -- ein
        // Druck woanders erzeugt hier kein Ereignis. Sie sieht dabei
        // aber nur "Taste unten" und "Zeiger da", und beides trifft
        // auch auf die MITTE EINES ZIEHENS zu, sobald der Zeiger den
        // Reglerknopf ueber den Fensterrand hinauszieht.
        //
        // GEMESSEN: `ziehespur` von 5 % auf 95 % der Rinne ergab
        // `qs: closed by outside`, und der Regler stand danach
        // unveraendert -- es sah aus, als taete er nichts. Er tat
        // etwas, das Panel war nur schon zu.
        //
        // Laeuft ein Ziehen, das INNERHALB begonnen hat (`zieht`),
        // gehoert die Taste dem Regler und nicht dem Schliessweg.
        // ZUERST NACHSEHEN, WO DIE TASTE HERUNTERGING -- und das ist
        // NICHT unbedingt, wo der Zeiger jetzt steht.
        //
        // GEMESSEN, zweiter Anlauf: der `zieht`-Merker allein genuegt
        // nicht. Er wird in der Ereignisschleife aus `EV_DOWN`
        // gesetzt, diese Abfrage hier pollt aber und laeuft im selben
        // Umlauf FRUEHER -- beim ersten Bild eines Ziehens ist er
        // deshalb noch 0, das Panel schliesst, und der `EV_DOWN`
        // kommt nie an, weil es das Fenster nicht mehr gibt.
        //
        // Also entscheidet die FLANKE selbst: ging die Taste INNERHALB
        // herunter, ist es der Anfang eines Ziehens (der Regler, eine
        // Kachel) und nicht der Wunsch zu schliessen. Erst ein Druck,
        // der AUSSERHALB beginnt, schliesst.
        if hit(mx, my) {
            zieht = 1
        } else {
            shut((&s_out[0 as usize]) as u64)
            changed = true
        }
    }
    if btn == 0 {
        zieht = 0
    }
    btn_last = btn
    return changed
}

// ---------------------------------------------------------- the clicks

// ============================================== RUNDE ECHTHARDWARE-6
// DIE KACHELN BEKOMMEN EINEN ZEIGER- UND EINEN DRUCKZUSTAND.
//
// Justin: die Fensterknoepfe "gehen super" mit Rueckmeldung, die
// Knoepfe im Kontrollzentrum haben GAR KEINE Hervorhebung.
//
// Er hat auch gleich nachgesehen, wo es liegt, und er hat recht:
// `wlib.paint_button` (wlib.fi) kann die drei Zustaende laengst --
// F_PRESSED -> T_BTNDN, F_HOVER -> T_BTNHI, sonst T_BTN. Diese Datei
// benutzt `paint_button` aber gar nicht: sie malt ihre Kacheln selbst
// mit `mal_tafel` und kannte genau ZWEI Zustaende, an und aus.
//
// WARUM NICHT EINFACH AUF `paint_button` UMSTELLEN: eine Kachel ist
// kein Knopf. Sie traegt ein Symbol, eine Titelzeile UND eine
// Zustandszeile, sie hat einen Ein-Zustand mit eigener Farbe (T_SEL),
// und ihre zwei Grundlinien sind in der Vorrunde muehsam auf das
// Raster gerechnet worden. `paint_button` malt einen Knopf mit EINER
// Beschriftung. Was fehlte, waren nicht die Zeichenroutinen, sondern
// die ZUSTAENDE -- und die holt sich diese Datei jetzt aus denselben
// Themenfarben, die `paint_button` benutzt. Ein Erscheinungsbild,
// zwei Zeichner, dieselbe Tabelle.
//
// N_TILE + 1 ist "keine": 0 waere die erste Kachel.
static mut hov_tile: u64 = 99
static mut dn_tile: u64 = 99

fn tile_at(x: u64, y: u64) -> u64 {
    var sl: u64 = 0
    while sl < N_TILE {
        let tx: u64 = tile_rect_x(sl)
        let ty: u64 = tile_rect_y(sl)
        if x >= tx && x < tx + TWc() && y >= ty && y < ty + TH() {
            return sl
        }
        sl = sl + 1
    }
    return 99
}

// Der Zeiger ist gewandert. Gibt zurueck, ob sich dadurch etwas
// GEAENDERT hat -- nur dann wird neu gemalt. Ohne diese Frage maelte
// das Panel bei jeder Mausbewegung neu, und das ist bei einer Bewegung
// je Bericht eine Menge Anstrich fuer nichts.
fn hover_set(t: u64) -> bool {
    if t == hov_tile {
        return false
    }
    hov_tile = t
    return true
}

fn print_set(t: u64) -> bool {
    if t == dn_tile {
        return false
    }
    dn_tile = t
    return true
}

fn tile_rect_x(t: u64) -> u64 {
    return PAD() + (t % COLS) * (TWc() + GAP())
}

fn tile_rect_y(t: u64) -> u64 {
    return PAD() + (t / COLS) * (TH() + GAP())
}

fn kacheln_say() {
    var sl: u64 = 0
    while sl < N_TILE {
        let t: u64 = tile_of(sl)
        say((&s_krect[0 as usize]) as u64)
        sayn(t)
        say((&s_kpl[0 as usize]) as u64)
        sayn(sl)
        say((&s_kx[0 as usize]) as u64)
        sayn(tile_rect_x(sl))
        say((&s_ky[0 as usize]) as u64)
        sayn(tile_rect_y(sl))
        say((&s_kw[0 as usize]) as u64)
        sayn(TWc())
        say((&s_kh[0 as usize]) as u64)
        sayn(TH())
        say((&s_kan[0 as usize]) as u64)
        if tile_on(t) {
            sayn(1)
        } else {
            sayn(0)
        }
        nl()
        sl = sl + 1
    }
}

fn click(x: u64, y: u64) {
    var sl: u64 = 0
    while sl < N_TILE {
        // RUNDE ECHTHARDWARE-2: der PLATZ ist nicht die KACHEL.
        let t: u64 = tile_of(sl)
        let tx: u64 = tile_rect_x(sl)
        let ty: u64 = tile_rect_y(sl)
        if x >= tx && x < tx + TWc() && y >= ty && y < ty + TH() {
            let rc: u64 = tile_click(t)
            say((&s_tile[0 as usize]) as u64)
            sayn(t)
            say((&s_to[0 as usize]) as u64)
            if tile_on(t) {
                sayn(1)
            } else {
                sayn(0)
            }
            say((&s_rc[0 as usize]) as u64)
            sayn(rc)
            nl()
            paint(true)
            return
        }
        sl = sl + 1
    }
    // DER HELLIGKEITSREGLER. Die Stelle des Klicks IST der Wert -- kein
    // Ziehen, kein Griff, den man treffen muss: das Panel schliesst
    // sich bei einem Druck ausserhalb, und ein Ziehen ueber den Rand
    // hinaus waere genau so ein Druck.
    if y >= SLY() && y < SLY() + SLH() && x >= SL_X() {
        let spur: u64 = W() - PAD() - SL_X()
        var rel: u64 = x - SL_X()
        if rel > spur {
            rel = spur
        }
        let v: u64 = BR_MIN + rel * (BR_MAX - BR_MIN) / spur
        let rc: u64 = ulib.sys(SYS_DISPSET, DS_BRIGHT, v, 0)
        say((&s_hell[0 as usize]) as u64)
        sayn(v)
        say((&s_rc[0 as usize]) as u64)
        sayn(rc)
        nl()
        paint(true)
        return
    }
    // RUNDE TON-2: DER LAUTSTAERKEREGLER. Die Stelle des Klicks IST
    // der Wert, genau wie bei der Helligkeit darueber und aus
    // demselben Grund: das Panel schliesst sich bei einem Druck
    // ausserhalb, ein Ziehen ueber den Rand waere so ein Druck.
    //
    // EIN KLICK AUF DIE BESCHRIFTUNG (links von der Rinne) SCHALTET
    // STUMM. Das ist die Klickfaehigkeit, die der Auftrag verlangt,
    // und sie sitzt da, wo sonst nichts passiert -- ein eigener Knopf
    // haette die Zeile schmaler gemacht als die Helligkeitszeile
    // darueber.
    if y >= VLY() && y < VLY() + SLH() {
        if ulib.sys(SYS_AUDGET, A_READY, 0, 0) != 1 {
            return
        }
        // ================================== RUNDE FUI-WIN11
        // STUMM LIEGT WIEDER LINKS -- AUF DEM LAUTSPRECHERSYMBOL.
        //
        // Die Beschriftungszeile, auf der dieser Klick zuletzt lag,
        // gibt es nicht mehr (Symbol statt Ueberschrift). Das Symbol
        // ist jetzt die Stummtaste, und das ist genau die Stelle, an
        // der Windows 11 sie auch hat -- man trifft den Lautsprecher
        // und der Ton geht aus.
        if x < SL_X() {
            let an: u64 = ulib.sys(SYS_AUDGET, A_MUTED, 0, 0)
            var neu: u64 = 1
            if an == 1 {
                neu = 0
            }
            let rc: u64 = ulib.sys(SYS_AUDSET, AS_MUTE, neu, 0)
            say((&s_mute[0 as usize]) as u64)
            sayn(neu)
            say((&s_rc[0 as usize]) as u64)
            sayn(rc)
            nl()
            paint(true)
            return
        }
        let spur: u64 = W() - PAD() - SL_X()
        var rel: u64 = x - SL_X()
        if rel > spur {
            rel = spur
        }
        let v: u64 = rel * 100 / spur
        let rc: u64 = ulib.sys(SYS_AUDSET, AS_VOLUME, v, 0)
        // WER DIE LAUTSTAERKE ZIEHT, WILL SIE HOEREN. Stumm bleibt
        // stumm waere hier die falsche Treue zum Zustand: das Ziehen
        // IST die Ansage, dass wieder Ton kommen soll.
        if v > 0 && ulib.sys(SYS_AUDGET, A_MUTED, 0, 0) == 1 {
            ulib.sys(SYS_AUDSET, AS_MUTE, 0, 0)
        }
        say((&s_vol[0 as usize]) as u64)
        sayn(v)
        say((&s_rc[0 as usize]) as u64)
        sayn(rc)
        nl()
        paint(true)
        return
    }
    if y >= L1Y() && y < L1Y() + FH() {
        // ==================================== RUNDE ECHTHARDWARE-5
        // SYS_SPAWN KANN KEINEN PFAD -- ES MUSS SYS_EXEC SEIN.
        //
        // Justins Befund F: "Taskmanager und Einstellungen lassen sich
        // nicht oeffnen, die Knoepfe reagieren nicht."
        //
        // GEMESSEN, nicht vermutet -- die serielle Leitung sagte es
        // woertlich:
        //
        //     qs: settings pid=-22
        //
        // -22 ist EINVAL, und es kommt aus `sys.do_spawn`:
        //
        //     if prog == 0 || (prog > 16 && prog != P_BUSB_SPAWN) {
        //         return neg(errno.E_INVAL)
        //     }
        //
        // `SYS_SPAWN` (1000) startet ein EINGEBAUTES Programm des
        // Kerns und nimmt dessen NUMMER (hoechstens 16). Hier wurde
        // ihm ein ZEIGER auf "/bin/taskmgr" gegeben, und ein Zeiger
        // ist immer groesser als 16 -- also kam bei JEDEM Druck auf
        // beide Knoepfe -22 zurueck und es lief nie etwas an.
        //
        // Der Weg mit Pfad ist `SYS_EXEC` (1001). Genau dieser Fehler
        // stand schon einmal in `launcher.fi` und ist dort in Runde
        // BLECHKERN behoben worden (siehe die Anmerkung bei
        // `SYS_EXEC` dort) -- dieses Panel ist damals uebersehen
        // worden.
        let pid: u64 = ulib.sys(ulib.SYS_EXEC,
            (&p_taskmgr[0 as usize]) as u64, 0, 0)
        say((&s_spawn[0 as usize]) as u64)
        say((&s_eq[0 as usize]) as u64)
        sayn(pid)
        nl()
        shut((&s_out[0 as usize]) as u64)
        return
    }
    if y >= L2Y() && y < L2Y() + FH() {
        // RUNDE ECHTHARDWARE-5: derselbe Fehler wie eine Kachel
        // weiter oben, dieselbe Begruendung -- `SYS_SPAWN` nimmt eine
        // Nummer, kein `/bin/settings`.
        let pid: u64 = ulib.sys(ulib.SYS_EXEC,
            (&p_settings[0 as usize]) as u64, 0, 0)
        say((&s_spawn[0 as usize]) as u64)
        say((&s_eq[0 as usize]) as u64)
        sayn(pid)
        nl()
        shut((&s_out[0 as usize]) as u64)
    }
}

// ---------------------------------------------------------- the drawing

// Every string this panel puts on the screen is also written to the
// serial line with the place and the colours it was drawn in, so that
// `tools/netview/run.sh` can hold the report against the picture -- the
// rule the taskbar has followed since round DESKTOP, and the reason a
// program cannot report one thing and paint another here either.
// The label, cut to `avail` pixels, one character at a time. It
// returns a pointer into a scratch buffer, so exactly one label may be
// in flight at a time -- which is true, because they are drawn one
// after another.
static mut cut: [u8; 64] = [0 as u8; 64]
// Zwei Zeilen der Kachelbeschriftung. Getrennte Puffer, weil beide
// gleichzeitig gebraucht werden -- `cut` kann nur eine halten.
static mut z1: [u8; 64] = [0 as u8; 64]
static mut z2: [u8; 64] = [0 as u8; 64]
static mut z1n: u64 = 0
static mut z2n: u64 = 0

// ====================================================== RUNDE FUI-VENDOR-BILD
// DIE KACHELBESCHRIFTUNG BRICHT AN DER WORTGRENZE UM.
//
// Justin, 13.09.2026: "Windows 11 loest das mit einem groesseren Symbol
// und einer Beschriftung, die UMBRICHT oder mit Auslassungspunkten
// endet. Ein abgeschnittenes 'Netz vortaeusc' ist kein akzeptables
// Ergebnis."
//
// WARUM DAS HIER STEHT UND NICHT IN fUi, obwohl fUi es seit dieser
// Runde kann (`painter.run_draw_wrapped`, Zweig `fui-kachel-mitte`):
// fUi malt in diesem System KEINEN Text. `kernel/user/fuib.fi` setzt
// `painter_set_font(pz(), s_fm)` mit `s_fm = 0` -- die Bruecke hat
// keine Schriftmasse, und jeder Textaufruf in fUi kehrt deshalb sofort
// zurueck (`painter.fi`: `if !metrics.fm_present((*z).fm) { return }`).
// Der Text dieses Systems kommt aus `wlibc.text_at`, und das ist
// Absicht: Umlaute, die Symbolschrift und `say_painted` haengen daran.
// Zwei Schriftsetzer auf einer Flaeche waeren zwei Ergebnisse -- der
// Kopf von `fuib.draw` sagt das ausdruecklich.
//
// Die REGEL ist damit eingehalten: es entsteht keine zweite
// ZEICHENSCHICHT. Gemalt wird weiter mit `wlib.draw_text`; hier steht
// nur, WO die Zeilen anfangen. Der Umbruch folgt Zeichen fuer Zeichen
// derselben Regel wie `painter.run_line_upto` -- an der letzten
// Wortgrenze, die noch passt; passt kein ganzes Wort, wird hart
// getrennt, damit die Schleife vorankommt.
fn kopiere(ziel: u64, quelle: u64, n: u64) {
    var i: u64 = 0
    while i < n && i < 63 {
        __mmio_write8((ziel + i) as *mut u8,
            __mmio_read8((quelle + i) as *mut u8))
        i = i + 1
    }
    __mmio_write8((ziel + i) as *mut u8, 0 as u8)
}

// Zerlegt `p` in hoechstens zwei Zeilen, die je in `breit` passen.
// Die zweite bekommt "..." , wenn danach noch Text steht.
fn zwei_zeilen(p: u64, breit: u64) {
    let n: u64 = tlen(p)
    z1n = 0
    z2n = 0
    let q1: u64 = (&z1[0 as usize]) as u64
    let q2: u64 = (&z2[0 as usize]) as u64
    // Passt alles in eine Zeile, ist nichts zu teilen.
    if wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, n) <= breit {
        kopiere(q1, p, n)
        z1n = n
        return
    }
    // Die letzte Wortgrenze suchen, die noch passt.
    var schnitt: u64 = 0
    var i: u64 = 0
    while i < n {
        if __mmio_read8((p + i) as *mut u8) == 32 as u8 {
            if wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, i) <= breit {
                schnitt = i
            }
        }
        i = i + 1
    }
    if schnitt == 0 {
        // Kein ganzes Wort passt: hart trennen, genau wie fUi es tut.
        schnitt = wlibc.fit(wlibc.F_UI, wlibc.px_ui(), p, n, breit)
        if schnitt == 0 {
            schnitt = 1
        }
        kopiere(q1, p, schnitt)
        z1n = schnitt
        let rest: u64 = p + schnitt
        let rn: u64 = n - schnitt
        let g: u64 = fit(rest, breit)
        kopiere(q2, g, tlen(g))
        z2n = tlen(g)
        return
    }
    kopiere(q1, p, schnitt)
    z1n = schnitt
    // Das Leerzeichen gehoert keiner der beiden Zeilen.
    let rest: u64 = p + schnitt + 1
    let rn: u64 = n - schnitt - 1
    // Die zweite Zeile kuerzt mit Punkten, wenn sie selbst zu lang ist.
    let g: u64 = fit(rest, breit)
    kopiere(q2, g, tlen(g))
    z2n = tlen(g)
}

// RUNDE ECHTHARDWARE-1: GEKUERZT WIRD AN DER ZEICHENGRENZE, UND ES
// STEHEN DREI PUNKTE DAHINTER.
//
// Justins Foto zeigt "Netz vortae", "Dunkelmo", "Energiepr" -- Woerter,
// die mitten im Wort aufhoeren, ohne dass man es ihnen ansieht. Zwei
// Fehler in einer Funktion:
//
//   1. Sie zaehlte OKTETTE herunter. "Netz vortaeuschen" traegt ein
//      `ä` als zwei Oktette; wer eines davon abschneidet, laesst eine
//      halbe UTF-8-Folge stehen, und `text_at` malt dafuer ein
//      Ersatzzeichen. `wlibc.fit` kann das seit Runde I18N richtig --
//      diese Datei hat es nur nicht benutzt.
//   2. Sie schrieb kein Zeichen dafuer, DASS gekuerzt wurde. Ein Wort,
//      das ohne Zeichen aufhoert, sieht aus wie ein falsches Wort.
//
// Beides macht `wlibc.fit` plus ein angehaengtes "..." -- und die
// Kachel meldet auf der seriellen Leitung genau das, was sie malt.
fn fit(p: u64, avail: u64) -> u64 {
    let n: u64 = tlen(p)
    if wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, n) <= avail {
        return p
    }
    var pu: [u8; 4] = "...\0"
    let pp: u64 = (&pu[0 as usize]) as u64
    let dw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), pp, 3)
    var platz: u64 = 0
    if avail > dw {
        platz = avail - dw
    }
    // AN DER ZEICHENGRENZE. `wlibc.fit` gibt eine Laenge in OKTETTEN
    // zurueck, die nie mitten in einer UTF-8-Folge endet.
    var k: u64 = wlibc.fit(wlibc.F_UI, wlibc.px_ui(), p, n, platz)
    if k > 59 {
        k = 59
    }
    let q: u64 = (&cut[0 as usize]) as u64
    var i: u64 = 0
    while i < k {
        __mmio_write8((q + i) as *mut u8, __mmio_read8((p + i) as *mut u8))
        i = i + 1
    }
    var d: u64 = 0
    while d < 3 {
        __mmio_write8((q + k + d) as *mut u8, 46 as u8)
        d = d + 1
    }
    __mmio_write8((q + k + 3) as *mut u8, 0 as u8)
    return q
}

fn say_text(x: u64, base: u64, fg: u64, bg: u64, txt: u64) {
    say((&s_txt[0 as usize]) as u64)
    say((&s_eq[0 as usize]) as u64)
    sayn(x)
    say((&s_ty[0 as usize]) as u64)
    sayn(base)
    say((&s_tf[0 as usize]) as u64)
    sayn(fg)
    say((&s_tb[0 as usize]) as u64)
    sayn(bg)
    say((&s_tt[0 as usize]) as u64)
    say(txt)
    say((&s_te[0 as usize]) as u64)
    nl()
}

fn paint_band(y0: u64, hh: u64, report: bool) {
    wlibc.set_band(y0)
    wlibc.clip_set(0, y0, W(), y0 + hh)
    wlib.draw_area(0, y0, W(), hh, wlibc.theme(wlibc.T_PANEL))
    // A LINE ROUND IT. Without it the panel and the bar are the same
    // grey with no edge between them, and the person cannot see where
    // one stops.
    wlib.draw_frame(0, 0, W(), H(), wlib.MR_TAFEL,
        wlibc.theme(wlibc.T_LINE))
    var sl: u64 = 0
    while sl < N_TILE {
        // RUNDE ECHTHARDWARE-2: gemalt wird der PLATZ, gefragt die KACHEL.
        let t: u64 = tile_of(sl)
        let tx: u64 = tile_rect_x(sl)
        let ty: u64 = tile_rect_y(sl)
        if ty + TH() > y0 && ty < y0 + hh {
            // DRAWN IN EVERY BAND IT TOUCHES, REPORTED IN ONE. The
            // drawing surface is 81 rows (`wlibc.SURF_ROWS`), so a
            // 62-pixel tile straddles a band boundary and is painted
            // twice -- reporting it twice would put two lines with two
            // different truths about one tile on the serial line.
            let mine: bool = report && ty >= y0 && ty < y0 + hh
            let on: bool = tile_on(t)
            // ============================== RUNDE FUI-WIN11
            // DER ZUSTAND IST DIE FARBE -- UND SONST NICHTS.
            //
            // EINGESCHALTET: die Kachel ist mit der AKZENTFARBE
            // ausgefuellt, Symbol und Schrift stehen in der Farbe, die
            // auf dem Akzent lesbar ist (T_SELFG). Das ist die Kachel,
            // die auf Windows 11 blau leuchtet.
            //
            // AUSGESCHALTET: heller Knopfgrund (T_BTN), normale
            // Schriftfarbe. Kein Wort, kein Rahmenrelief, kein
            // Zustandstext -- man sieht am Farbblock, was an ist,
            // genauso wie man es dort sieht.
            //
            // WARUM T_ACCENT UND NICHT T_SEL: T_SEL ist die Farbe
            // einer AUSWAHL (eine markierte Zeile in einer Liste);
            // T_ACCENT ist die Akzentfarbe des Systems, die der Nutzer
            // in den Einstellungen waehlt. Eine eingeschaltete Kachel
            // ist keine Auswahl, sie ist ein aktiver Schalter -- und
            // sie soll die Farbe tragen, die er sich ausgesucht hat.
            var bg: u64 = wlibc.theme(wlibc.T_BTN)
            var fg: u64 = wlibc.theme(wlibc.T_FG)
            var dim: u64 = wlibc.theme(wlibc.T_DIM)
            if on {
                bg = wlibc.theme(wlibc.T_ACCENT)
                fg = wlibc.theme(wlibc.T_SELFG)
                dim = wlibc.theme(wlibc.T_SELFG)
            }
            // ==================================== RUNDE ECHTHARDWARE-6
            // DIESELBEN ZWEI FARBEN, DIE `wlib.paint_button` NIMMT.
            // Gedrueckt sticht Zeiger-drueber; eine EINGESCHALTETE
            // Kachel behaelt ihre Auswahlfarbe und wird nur AUFGEHELLT,
            // sonst spraenge sie beim Ueberfahren von blau auf grau
            // und saehe aus, als haette sie sich ausgeschaltet.
            if sl == dn_tile {
                if on {
                    bg = wlibc.mix(bg, wlibc.theme(wlibc.T_BTNDN), 50)
                } else {
                    bg = wlibc.theme(wlibc.T_BTNDN)
                }
            } else if sl == hov_tile {
                if on {
                    bg = wlibc.mix(bg, wlibc.theme(wlibc.T_BTNHI), 50)
                } else {
                    bg = wlibc.theme(wlibc.T_BTNHI)
                }
            }
            // RUNDE FUI-WIN11: FLACH UND OHNE RAND, wenn sie AN ist.
            //
            // Eine gefuellte Akzentkachel braucht keine Umrandung --
            // der Farbblock IST die Kante. Die ausgeschaltete Kachel
            // bekommt eine, damit sie sich vom Panelgrund abhebt (auf
            // Windows 11 ist das genauso: die inaktive Kachel ist ein
            // heller Block mit feiner Linie, die aktive ein
            // randloser Farbblock).
            var kante: u64 = wlibc.theme(wlibc.T_LINE)
            if on {
                kante = bg
            }
            wlib.draw_board(tx, ty, TWc(), TH(), wlib.MR_BUTTON,
                wlibc.EL_FLAT, bg, kante)
            // ============================== RUNDE FUI-WIN11
            // DAS SYMBOL KOMMT AUS DER SYMBOLSCHRIFT DES SYSTEMS.
            //
            // Vorher: sechs OSYM-Bilder aus /etc/netview/, fest 16x16,
            // in zwei Farbrollen. Die wuchsen bei uiscale=2 NICHT mit
            // (`icon_draw` malt Punkt fuer Punkt) und lagen auf einer
            // eingeschalteten Kachel in der falschen Farbe, weil ihre
            // Rollen den Akzentgrund nicht kennen.
            //
            // `wlibc.icon_at` nimmt einen Glyphen aus lib/icons.fi,
            // zeichnet ihn VEKTORIELL in der gewuenschten Kantenlaenge
            // und in EINER Farbe -- also mitwachsend und immer lesbar,
            // auf hellem Grund wie auf dem Akzent. Dieselbe Quelle, die
            // die Leiste schon benutzt (taskbar.fi: icons.START).
            // ============================ RUNDE FUI-VENDOR-BILD
            // DAS SYMBOL STEHT MITTIG, NICHT OBEN LINKS.
            //
            // Justin, 13.09.2026: "Heute sitzt das Symbol oben links
            // und der Text darunter linksbuendig -- deshalb wirkt die
            // Kachel wie eine Listenzeile mit Rahmen. Ich will sie
            // mittig."
            //
            // In fUi heisst diese Anordnung ab dieser Runde
            // `widget.ART_ABOVE_CENTER` (Zweig `fui-kachel-mitte`);
            // hier wird sie von Hand gerechnet, weil die Bruecke keinen
            // Text malen kann (siehe der Kopf von `zwei_zeilen`). Die
            // RECHNUNG ist dieselbe: Symbol waagerecht mittig, Text
            // darunter, ebenfalls mittig.
            let gz: u64 = IC()
            let gx: u64 = tx + sub1(TWc() + 1 - gz) / 2
            let gy: u64 = ty + PAD() / 2
            var gemalt: bool = wlibc.icon_at(tile_glyph(t), gx, gy, gz, fg)
            if !gemalt {
                // RUECKFALL auf das alte OSYM-Bild, falls die
                // Symbolschrift in diesem Abbild fehlt. Lieber das
                // alte Bild als eine leere Kachel.
                let ip: u64 = tile_icon(t)
                if ip != 0 {
                    gemalt = wlibc.icon_draw(ip, gx, gy)
                }
            }
            if gemalt && mine {
                say((&s_sym[0 as usize]) as u64)
                sayn(t)
                say((&s_sx[0 as usize]) as u64)
                sayn(px_ + gx)
                say((&s_y[0 as usize]) as u64)
                sayn(py_ + gy)
                say((&s_to[0 as usize]) as u64)
                if on {
                    sayn(1)
                } else {
                    sayn(0)
                }
                nl()
            }
            // ============================== RUNDE FUI-WIN11
            // EINE TEXTZEILE, UND DAS ZUSTANDSWORT IST WEG.
            //
            // `tile_label_txt` liefert beim Energieprofil den
            // Profilnamen mit ("Energie: sparen"), weil drei Zustaende
            // sich nicht faerben lassen. Bei allen anderen Kacheln ist
            // es der blosse Name -- der Zustand steht in der Farbe.
            // ============================ RUNDE FUI-VENDOR-BILD
            // ZWEI ZEILEN, MITTIG -- statt einer abgeschnittenen.
            //
            // `wide` ist die NUTZBARE Breite der schmaleren Kachel. Der
            // Pfeil steht jetzt UNTEN rechts in der Ecke und nicht mehr
            // neben der Schrift, also nimmt er ihr keine Breite weg;
            // abgezogen wird nur der Rand.
            let wide: u64 = sub1(TWc() + 1 - PAD())
            zwei_zeilen(tile_label_txt(t), wide)
            let q1: u64 = (&z1[0 as usize]) as u64
            let q2: u64 = (&z2[0 as usize]) as u64
            let lb: u64 = ty + PAD() / 2 + IC() + 5 * sk() + asc
            let b1: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q1, z1n)
            let x1: u64 = tx + sub1(TWc() + 1 - b1) / 2
            let _e: u64 = wlib.draw_text(x1, lb, q1, z1n, fg,
                wlibc.TY_BODY)
            var x0: u64 = x1
            if z2n > 0 {
                let b2: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(),
                    q2, z2n)
                let x2: u64 = tx + sub1(TWc() + 1 - b2) / 2
                let _e2: u64 = wlib.draw_text(x2, lb + ZH(), q2, z2n,
                    fg, wlibc.TY_BODY)
            }
            let lab: u64 = q1
            // ============================== RUNDE FUI-WIN11
            // DER PFEILKNOPF AN DER KACHEL MIT UNTERMENUE.
            //
            // Auf Windows 11 sitzt rechts an genau den Kacheln ein
            // kleiner Pfeil, hinter denen noch etwas steckt (WLAN ->
            // Netzliste). In diesem System ist das das ENERGIEPROFIL:
            // es hat drei Stufen, und ein Klick auf den Pfeil geht in
            // die Einstellungen, wo man sie waehlt. Die anderen drei
            // Kacheln sind reine Schalter und bekommen keinen -- ein
            // Pfeil, hinter dem nichts liegt, ist dieselbe Luege mit
            // runden Ecken, vor der der Kopf dieser Datei warnt.
            if tile_has_sub(t) {
                let cx: u64 = tx + sub1(TWc() - CHEV_W())
                let cy: u64 = ty + sub1(TH() - CHEV_W())
                let _c: bool = wlibc.icon_at(icons.CHEVRON_RIGHT,
                    cx + (CHEV_W() - CHEV_G()) / 2,
                    cy + (CHEV_W() - CHEV_G()) / 2 - CHEV_W() / 2,
                    CHEV_G(), dim)
            }
            if mine {
                say_text(x0, lb, fg, bg, lab)
            }
        }
        sl = sl + 1
    }
    // ------------------------------------------------ der Helligkeitsregler
    if SLY() + SLH() > y0 && SLY() < y0 + hh {
        // ================================== RUNDE FUI-WIN11
        // SYMBOL LINKS, RINNE RECHTS -- KEINE UEBERSCHRIFT.
        //
        // Die Beschriftungszeile "Helligkeit" ist weg; an ihrer Stelle
        // steht links eine Sonne. Das ist die Windows-11-Form und
        // spart dieser Zeile die halbe Hoehe.
        let mitte: u64 = SLY() + SLH() / 2
        let _si: bool = wlibc.icon_at(icons.SETTINGS, PAD(),
            mitte - IC() / 2, IC(), wlibc.theme(wlibc.T_FG))
        let spur: u64 = W() - PAD() - SL_X()
        let rh: u64 = 4 * sk()
        wlib.draw_bar(SL_X(), mitte - rh / 2, spur, rh,
            wlibc.theme(wlibc.T_SCROLL))
        var v: u64 = dget(DG_BRIGHT)
        if v < BR_MIN {
            v = BR_MIN
        }
        if v > BR_MAX {
            v = BR_MAX
        }
        let kx: u64 = SL_X() + (v - BR_MIN) * (spur - SL_KN())
            / (BR_MAX - BR_MIN)
        // DER TEIL LINKS VOM GRIFF IN DER AKZENTFARBE: so sieht man, wo
        // der Regler steht, auch wenn man den Griff nicht erkennt.
        wlib.draw_bar(SL_X(), mitte - rh / 2, kx - SL_X(), rh,
            wlibc.theme(wlibc.T_ACCENT))
        let kh: u64 = 16 * sk()
        wlib.draw_board(kx, mitte - kh / 2, SL_KN(), kh, wlib.MR_GRIFF,
            wlibc.EL_RAISED, wlibc.theme(wlibc.T_BTN),
            wlibc.theme(wlibc.T_LINE))
        if report && SLY() >= y0 && SLY() < y0 + hh {
            say((&s_hellist[0 as usize]) as u64)
            sayn(v)
            say((&s_sx[0 as usize]) as u64)
            sayn(kx)
            nl()
            // ================================ RUNDE ECHTHARDWARE-3
            // DIE RINNE SAGT, WO SIE LIEGT -- IN BILDSCHIRMPUNKTEN.
            //
            // Ein Testlaeufer, der den Regler ziehen soll, musste
            // seine Lage bisher aus PAD/GAP/TOP2/ZH nachrechnen. Ich
            // habe das in dieser Runde zweimal getan und zweimal
            // danebengegriffen: beide Male lag der Griff AUSSERHALB
            // des Panels, das Panel schloss sich voellig zu Recht
            // (`qs: closed by outside`), und es sah aus, als taete
            // der Regler nichts. Der Fehler lag im Laeufer, nicht im
            // Programm -- aber unterscheiden liess er sich nicht.
            //
            // Also sagt das Programm selbst, wo man greifen muss:
            // linke Kante, rechte Kante und Mitte der Rinne, absolut
            // auf dem Schirm. Dieselbe Regel wie bei `wlib: rect`.
            say((&s_hellspur[0 as usize]) as u64)
            sayn(px_ + SL_X())
            say((&s_bis[0 as usize]) as u64)
            sayn(px_ + W() - PAD())
            say((&s_ymit[0 as usize]) as u64)
            sayn(py_ + mitte)
            nl()
        }
    }
    // ------------------------------------------------ RUNDE TON-2:
    // DER LAUTSTAERKEREGLER. Gebaut wie der Helligkeitsregler darueber,
    // Bildpunkt fuer Bildpunkt, und aus denselben Themenmarken --
    // T_SCROLL fuer die Rinne, T_ACCENT fuer den gefuellten Teil,
    // T_BTN fuer den Griff, T_LINE fuer die Kante. Kein fester
    // Farbwert, kein eigener Zeichenweg.
    //
    // IST STUMM GESCHALTET, wird die Rinne NICHT gefuellt und der
    // Wert in der gedaempften Farbe geschrieben: "stumm bei 70" ist
    // ein anderer Zustand als "auf null gedreht", und ein Regler, der
    // beides gleich zeigt, verschweigt den Unterschied.
    if VLY() + SLH() > y0 && VLY() < y0 + hh {
        // RUNDE ECHTHARDWARE-1: BESCHRIFTUNG OBEN, RINNE DARUNTER --
        // und gemalt mit denselben wlib-Aufrufen wie die Helligkeit
        // darueber. Vorher lief diese Zeile ueber `wlibc.rect` und
        // `wlibc.text_at` direkt am Widget-Satz vorbei; Justins
        // Kritik "verwende die Bibliothek ueberall" trifft genau das.
        // ================================== RUNDE FUI-WIN11
        // SYMBOL LINKS STATT UEBERSCHRIFT -- und das Symbol SAGT den
        // Zustand: durchgestrichener Lautsprecher, wenn stumm, sonst
        // einer mit Wellen. Das ist derselbe Satz Glyphen, den die
        // Leiste in ihrem Statusfeld benutzt (taskbar.fi), und es ist
        // der Grund, warum hier kein Wort "Stumm" mehr stehen muss.
        let da: bool = ulib.sys(SYS_AUDGET, A_READY, 0, 0) == 1
        var vfg: u64 = wlibc.theme(wlibc.T_FG)
        if !da {
            vfg = wlibc.theme(wlibc.T_DIM)
        }
        let mitte: u64 = VLY() + SLH() / 2
        let spur: u64 = W() - PAD() - SL_X()
        let rh: u64 = 4 * sk()
        wlib.draw_bar(SL_X(), mitte - rh / 2, spur, rh,
            wlibc.theme(wlibc.T_SCROLL))
        var v: u64 = 0
        var stumm: bool = false
        if da {
            v = ulib.sys(SYS_AUDGET, A_VOLUME, 0, 0)
            if v > 100 {
                v = 100
            }
            stumm = ulib.sys(SYS_AUDGET, A_MUTED, 0, 0) == 1
        }
        // JETZT ist bekannt, ob stumm und wie laut -- also jetzt das
        // Symbol, das genau das zeigt.
        var vglyph: u64 = icons.VOLUME_HIGH
        if stumm || !da {
            vglyph = icons.VOLUME_MUTED
        } else if v == 0 {
            vglyph = icons.VOLUME_ZERO
        } else if v < 50 {
            vglyph = icons.VOLUME_LOW
        }
        let _vi: bool = wlibc.icon_at(vglyph, PAD(), mitte - IC() / 2,
            IC(), vfg)
        let kx: u64 = SL_X() + v * (spur - SL_KN()) / 100
        if !stumm && v > 0 {
            wlib.draw_bar(SL_X(), mitte - rh / 2, kx - SL_X(), rh,
                wlibc.theme(wlibc.T_ACCENT))
        }
        let kh: u64 = 16 * sk()
        wlib.draw_board(kx, mitte - kh / 2, SL_KN(), kh, wlib.MR_GRIFF,
            wlibc.EL_RAISED, wlibc.theme(wlibc.T_BTN),
            wlibc.theme(wlibc.T_LINE))
        if report && VLY() >= y0 && VLY() < y0 + hh {
            say((&s_volist[0 as usize]) as u64)
            sayn(v)
            say((&s_vomute[0 as usize]) as u64)
            if stumm {
                sayn(1)
            } else {
                sayn(0)
            }
            say((&s_sx[0 as usize]) as u64)
            sayn(kx)
            nl()
        }
    }
    // ------------------------------------------------------ der Akkustand
    if BAY() + FH() > y0 && BAY() < y0 + hh {
        let base: u64 = BAY() + (FH() + asc) / 2 - 1
        var zeile: [u8; 64] = [0 as u8; 64]
        let z: u64 = (&zeile[0 as usize]) as u64
        // ================================== RUNDE FUI-WIN11
        // DAS WORT "Akku:" IST WEG -- DAS SYMBOL SAGT ES.
        //
        // Justin hat "Akku: keiner" ausdruecklich angestrichen. Ein
        // Akkusymbol mit einem Strich daneben sagt dasselbe ohne ein
        // Wort, und welches Symbol es ist, sagt den Zustand mit:
        // ladend, voll, leer oder gar keiner. Genau die Glyphen, die
        // die Leiste im Statusfeld schon benutzt.
        var bglyph: u64 = icons.BATTERY_ABSENT
        if pget(PG_BATPRESENT) != 0 {
            let pr: u64 = pget(PG_BATPERCENT)
            if (pget(PG_BATSTATE) & 2) != 0 {
                bglyph = icons.BATTERY_CHARGING
            } else if pr >= 80 {
                bglyph = icons.BATTERY_FULL
            } else if pr >= 40 {
                bglyph = icons.BATTERY_MEDIUM
            } else if pr >= 15 {
                bglyph = icons.BATTERY_LOW
            } else {
                bglyph = icons.BATTERY_EMPTY
            }
        }
        let _bi: bool = wlibc.icon_at(bglyph, PAD(),
            BAY() + (FH() - IC()) / 2, IC(),
            wlibc.theme(wlibc.T_DIM))
        var at: u64 = 0
        // KEIN AKKU IST KEINE NULL PROZENT. Der Kern sagt, ob einer da
        // ist; steht dort eine Null, steht hier ein Wort und keine Zahl.
        if pget(PG_BATPRESENT) == 0 {
            at = at + ulib.strcpy(z + at,
                msg.get((&k_nobat[0 as usize]) as u64))
        } else {
            at = at + ulib.digits(pget(PG_BATPERCENT), z + at)
            at = at + ulib.strcpy(z + at, (&u_pct[0 as usize]) as u64)
            if (pget(PG_BATSTATE) & 2) != 0 {
                at = at + ulib.strcpy(z + at, (&u_op[0 as usize]) as u64)
                at = at + ulib.strcpy(z + at,
                    msg.get((&k_chg[0 as usize]) as u64))
                at = at + ulib.strcpy(z + at, (&u_cl[0 as usize]) as u64)
            }
        }
        let btx: u64 = PAD() + SL_ICW()
        let _b: u64 = wlib.draw_text(btx, base, z, at,
            wlibc.theme(wlibc.T_DIM), wlibc.TY_BODY)
        if report && BAY() >= y0 && BAY() < y0 + hh {
            say_text(btx, base, wlibc.theme(wlibc.T_DIM),
                wlibc.theme(wlibc.T_PANEL), z)
        }
    }
    // -------------------------------------------------- die Verknuepfungen
    if L1Y() + FH() > y0 && L1Y() < y0 + hh {
        wlib.draw_separator(PAD(), L1Y() - 4, W() - 2 * PAD())
        let p: u64 = msg.get((&k_tm[0 as usize]) as u64)
        let base: u64 = L1Y() + (FH() + asc) / 2 - 1
        // RUNDE FUI-WIN11: die Fusszeilen tragen ihr Symbol, genau wie
        // die Zahnradzeile auf Windows 11.
        let _ti: bool = wlibc.icon_at(icons.FILE_PROGRAM, PAD(),
            L1Y() + (FH() - IC()) / 2, IC(), wlibc.theme(wlibc.T_FG))
        let ltx: u64 = PAD() + SL_ICW()
        let _g: u64 = wlib.draw_text(ltx, base, p, tlen(p),
            wlibc.theme(wlibc.T_FG), wlibc.TY_BODY)
        if report && L1Y() >= y0 && L1Y() < y0 + hh {
            say_text(ltx, base, wlibc.theme(wlibc.T_FG),
                wlibc.theme(wlibc.T_PANEL), p)
        }
    }
    if L2Y() + FH() > y0 && L2Y() < y0 + hh {
        let p: u64 = msg.get((&k_all[0 as usize]) as u64)
        let base: u64 = L2Y() + (FH() + asc) / 2 - 1
        // DAS ZAHNRAD. Die Zeile, die auf Windows 11 ganz unten sitzt
        // und in die Einstellungen fuehrt.
        let _gi: bool = wlibc.icon_at(icons.SETTINGS, PAD(),
            L2Y() + (FH() - IC()) / 2, IC(), wlibc.theme(wlibc.T_FG))
        let ltx: u64 = PAD() + SL_ICW()
        let _g: u64 = wlib.draw_text(ltx, base, p, tlen(p),
            wlibc.theme(wlibc.T_FG), wlibc.TY_BODY)
        if report && L2Y() >= y0 && L2Y() < y0 + hh {
            say_text(ltx, base, wlibc.theme(wlibc.T_FG),
                wlibc.theme(wlibc.T_PANEL), p)
        }
    }
    let _p: u64 = wlibc.push(w_h, 0, y0, W(), hh)
}

// ==================================================== RUNDE ECHTHARDWARE-5
// DAS THEMA HAT GEWECHSELT -- UND ZWAR JETZT, NICHT BEIM NAECHSTEN
// AUFMACHEN.
//
// Justins Befund J, woertlich: schaltet er von hell auf dunkel, bleibt
// das Kontrollzentrum rechts "komisch blau" -- also im alten Schema --
// und wird erst richtig, wenn er es SCHLIESST und NEU OEFFNET.
//
// DIE URSACHE, und sie ist dieselbe Wurzel wie bei den anderen
// Oberflaechen: dieses Panel hat eine EIGENE Ereignisschleife und ruft
// `wlib.step()` nie. `wlib.step` ist aber die Stelle, an der
// `theme_watch()` sitzt -- der Wecker, der zehnmal je Sekunde
// nachsieht, ob sich die aufgeloesten Marken geaendert haben, und dann
// ALLE Fenster schmutzig macht. Ein Programm, das an `step` vorbei
// lebt, bekommt davon nichts mit und malt weiter mit den Farben, die
// es beim Aufmachen gelesen hat.
//
// Die Leiste ueber uns POLLT das Thema bereits (`wlibc.theme_poll` in
// ihrer Schleife) -- sie hat es nur fuer sich behalten. Diese Funktion
// ist der fehlende Weitersager: sie wird von dort gerufen, wenn sich
// wirklich etwas geaendert hat, und malt das Panel vollstaendig neu.
//
// VOLLSTAENDIG und nicht teilweise: die Farben stecken in jedem Band,
// in jeder Kachel und in beiden Reglern. Ein halber Anstrich waere
// genau der Zwischenzustand, den Justin ausdruecklich nicht will.
fn theme_new() -> bool {
    if open_ == 0 {
        return false
    }
    // ==================================================== RUNDE ECHT
    // DIE LIVE-BANK HOLEN, BEVOR GEMALT WIRD.
    //
    // Gemessen nach dem ersten Anlauf: Terminal, Schreibtisch und
    // Leiste waren dunkel, der PANELGRUND des Kontrollzentrums aber
    // hell (198 gegen 43 in den Luecken zwischen den Kacheln). Also
    // hat dieses Panel zwar neu gemalt -- aber mit den ALTEN Farben.
    //
    // `wlibc.theme(i)` liest absichtlich die Bank, die der LAUFENDE
    // Anstrich gelatcht hat ("a window that started painting light
    // finishes light"). Wird hier gemalt, ohne vorher neu zu latchen,
    // ist das die Bank von vorhin -- und die ist hell. Ein
    // `theme_frame_begin`/`_end` um den Anstrich herum holt die
    // aktuelle und gibt sie danach wieder frei.
    let _g: u64 = wlibc.theme_frame_begin()
    paint(false)
    let _s: bool = wlibc.theme_frame_end()
    return true
}

fn paint(report: bool) {
    if open_ == 0 {
        return
    }
    var y: u64 = 0
    var first: bool = true
    let _q: bool = first
    while y < H() {
        var hh: u64 = BAND
        if y + hh > H() {
            hh = H() - y
        }
        paint_band(y, hh, report)
        first = false
        y = y + hh
    }
    let _f: u64 = wlibc.sys3w(wlibc.WM_FLUSH, w_h, 0, 0)
    // ============================================ RUNDE ECHTHARDWARE-5
    // DIE ZWEI KNOPFZEILEN, ABSOLUT AUF DEM SCHIRM -- HIER UND NICHT
    // IM BANDMALER.
    //
    // Erster Anlauf dieser Runde: die Zeilen standen in
    // `paint_band`, und dort rechnet alles in BANDKOORDINATEN
    // (`wlibc.set_band(y0)`). Gemeldet wurde deshalb `y=970`, waehrend
    // der Druck bei `y=348` im Fenster ankam -- der Klick landete eine
    // Zeile zu tief, auf `All settings` statt auf `Task manager`.
    // Gemessen an genau diesem Lauf: `qs: druck x=194 y=348`.
    //
    // `paint` laeuft einmal je Anstrich und kennt `py_`, den Ursprung
    // des Fensters. Damit ist die gemeldete Zahl die, auf die ein
    // Klick zielen muss.
    if report {
        say((&s_zeile1[0 as usize]) as u64)
        sayn(py_ + L1Y())
        say((&s_hoehe[0 as usize]) as u64)
        sayn(FH())
        nl()
        say((&s_zeile2[0 as usize]) as u64)
        sayn(py_ + L2Y())
        say((&s_hoehe[0 as usize]) as u64)
        sayn(FH())
        nl()
    }
}
