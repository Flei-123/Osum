// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/qs.fi -- round NETVIEW, third addendum: QUICK SETTINGS.
//
// The small panel that opens over the corner of the taskbar, the way
// Win+A does on Windows. It exists because of ONE switch -- "fake a
// network" -- and the rule that got it built is worth more than the
// panel:
//
//   ONLY WHAT REALLY EXISTS AND WHAT IS REALLY SWITCHED OFTEN GOES IN
//   HERE. Four honest tiles beat twelve of which half do nothing. A
//   tile for something this system does not have is not a placeholder,
//   it is a lie with rounded corners.
//
// SO HERE IS WHAT WAS LEFT OUT AND WHY -- MEASURED IN THIS TREE, not
// assumed:
//
//   VOLUME.       There is no sound. `grep -ri audio kernel/*.fi`
//                 finds `A_VOLUME` in the FAT driver and nothing else.
//                 A slider would move a number that reaches no speaker.
//   BRIGHTNESS.   Round DISPLAY has not delivered a gamma ramp on this
//                 branch. What DOES exist is `pwr.rescale`, which
//                 multiplies every pixel in the framebuffer in place
//                 and says so in its own comment. That is fine for
//                 `power hell 40` typed once; a slider is dragged
//                 across fifty values, and every one of them throws
//                 away low bits that the next one cannot get back. A
//                 slider over a lossy operation is worse than no
//                 slider.
//   LIGHT/DARK.   The theme interface is not there yet. `/etc/theme`
//                 exists and is one file of colour VALUES; the settings
//                 read a list of named schemes out of `/etc/schemas`,
//                 and NOTHING IN THIS TREE CREATES THAT DIRECTORY --
//                 no image builder writes it, so on a running machine
//                 it is empty. There is no mark anywhere saying which
//                 scheme is the light one. Round THEME is building
//                 exactly that; a tile here would have had to invent
//                 their interface and then disagree with it.
//   DO NOT DISTURB. There are no notifications. Nothing to silence.
//
// WHAT IS LEFT IS THREE, and all three are switches a person really
// flips:
//
//   FAKE NETWORK   the reason this panel was asked for. off <-> always.
//   NETWORK        the machine's address, away and back. This is NOT
//                  the same switch: a faked program keeps believing in
//                  its invented network when the real address is gone,
//                  and a real one genuinely loses everything.
//   HIDE THE BAR   `/etc/taskbar.conf`, `autohide`. It belongs to the
//                  taskbar and so does this panel.
//
// ------------------------------------------------------------------
// WHERE IT APPEARS. At the edge the bar is on, in the corner the icon
// group is in -- and the rectangle it is allowed to use is the WORK
// AREA (`wlibc.work_*`, the interface addendum TASKBAR built), never
// the screen. A panel that assumed the screen would sit under the bar
// on three of the four edges.
//
// WHOSE WINDOW IT IS. The taskbar's, created at start and kept HIDDEN.
// Opening it is `WS_HIDDEN 0` plus a move plus a paint -- not a program
// start. That is not a detail: `tools/netview/run.sh` measures the time
// from the key press to the panel standing, and a fork+exec would put
// that measurement in a different order of magnitude.
//
// HOW IT CLOSES. Three ways, and the panel has to survive all three:
// Escape (it takes the focus when it opens, so the key arrives),
// the hotkey again, and a press anywhere outside it -- which is polled
// from the pointer, because a press outside a window raises no event
// belonging to that window.

profile kernel

import ulib
import wlibc
import nv
import msg
import vorlage
import libc.io
import libc.kcall

export {
    init, anchor, step, toggle, is_open, hit, want_hide, took_hide,
    win_id, W, H
}

// --------------------------------------------------------- the shape
//
// DRAWN AT THE SIZE IT HANGS AT, and every number below came off a
// screenshot rather than out of somebody's head.

// THESE NUMBERS WERE MEASURED, NOT CHOSEN. The first build had
// TW = 120 and TH = 62, which looked right in the source and was wrong
// on the screen -- `tools/netview/kachel.py` read the picture back and
// found "Netz vortaeuschen" four pixels past the right edge of its own
// tile and, on the third tile, the label and the word under it sharing
// a row of pixels. Neither is visible in a source file; both are
// obvious in a screenshot, which is why the checker exists and why it
// runs on every one of the four edges.
//
//   TW  180  the widest label this panel has is "Netz vortaeuschen",
//            and its width was found by BISECTION AGAINST THE RUNNING
//            SYSTEM rather than by reading the font: at TW = 140 `fit`
//            cut it to "Netz vortaeusc", at 160 to "Netz vortaeusche",
//            at 180 it stands whole. So it is between 141 and 160
//            pixels, and 160 of usable width is what a tile needs.
//   TH   74  icon (16) + 4 + a line of text + 12 clear + a line of
//            text + 10. The 12 is the gap the first version did not
//            have.
const PAD: u64 = 10
const TW: u64 = 180 // one tile
const TH: u64 = 74
const GAP: u64 = 8
const FH: u64 = 22 // eine Zeile am Fuss
const W: u64 = PAD + TW + GAP + TW + PAD // 388
// ============================================== RUNDE WERKZEUGE
// DAS PANEL IST GEWACHSEN, UND JEDE NEUE ZEILE HAT EINE QUELLE.
//
// Drei Kacheln waren es, weil im August drei Dinge WIRKLICH da waren.
// Seither sind vier davon dazugekommen, und die Begruendung fuer jede
// steht neben ihr:
//
//   DUNKELMODUS   Runde THEME/THEMESTORE hat die Schnittstelle gebaut,
//                 die es im August nicht gab: `wlibc.theme_set_mode`
//                 gilt sofort in JEDEM Fenster (gemeinsame Bank,
//                 `theme_gen` zieht die anderen Programme nach), und
//                 `vorlage.mode_write` schreibt eine Zeile in
//                 /etc/theme.conf, damit es den Neustart ueberlebt.
//   ENERGIEPROFIL Runde K18 hat `osum_pwrget/pwrset`. Der Kern sagt
//                 selbst, ob er die MSR wirklich lesen konnte
//                 (`PG_READY`) -- steht dort eine Null, zeigt die
//                 Kachel einen Strich und tut nichts. Eine Kachel, die
//                 auf einer Maschine ohne diese Register etwas
//                 verspraeche, waere genau die Luege mit runden Ecken,
//                 vor der der Kopf dieser Datei warnt.
//   KACHELN       Runde TILING, `osum_tileget/tiledo`. Ein Schalter,
//                 den man wirklich oft umlegt.
//   HELLIGKEIT    Die Begruendung von damals ist NACHGEPRUEFT und
//                 hinfaellig: `pwr.rescale` skalierte den Rahmenpuffer
//                 an Ort und Stelle und verlor bei jedem Schritt Bits.
//                 Runde DISPLAY hat das ersetzt -- `vmode.set_picture`
//                 baut eine NACHSCHLAGETABELLE, die beim Ausgeben
//                 angewandt wird; der Rahmenpuffer bleibt unberuehrt,
//                 und fuenfzig Schritte hintereinander kosten nichts.
//                 Deshalb steht hier jetzt ein Schieberegler.
//
// UND JETZT STEHT LAUTSTAERKE DOCH DA -- RUNDE TON-2.
//
// Der Satz von damals stimmte, als er geschrieben wurde: "es gibt
// keinen Tontreiber, keinen Mischer und keine Lautstaerke, die man
// setzen koennte". Seit Runde MEDIA1 gibt es einen Treiber (AC97),
// seit Runde HDA einen zweiten und einen Mischer mit Lautstaerke JE
// STROM, und seit Runde TON einen Master samt Stummschaltung
// (`audset AS_VOLUME`, `AS_MUTE`). Die Begruendung ist damit
// hinfaellig, und die Regel dieser Datei -- nur was WIRKLICH da ist --
// verlangt jetzt das Gegenteil: der Regler gehoert hierher.
//
// NACHGEMESSEN UND NICHT ANGENOMMEN, wie es der Kopf dieser Datei
// vorschreibt: `kernel/audio.fi` und `kernel/mix.fi` sind da,
// `audio.set_volume` schreibt `L_MASTER`, und `A_VOLGEN` zaehlt jede
// Aenderung mit -- damit dieses Panel weiss, wann es neu malen muss,
// ohne in einer Schleife zu fragen.
//
// DER MASTER IST LINEAR IN PROZENT, 0..100, und er wird auf die
// ABTASTWERTE angewandt und nicht auf den Verstaerker des Codecs
// (Runde TON hat das umgestellt). Deshalb wirkt er auf BEIDE Wege --
// Einstrom wie Mischer -- und auf jeder Maschine gleich.
const TOP2: u64 = PAD + 3 * TH + 2 * GAP // unter den sechs Kacheln
const SLY: u64 = TOP2 + GAP // der Helligkeitsregler
const SLH: u64 = 34
// RUNDE TON-2: der Lautstaerkeregler, eine Zeile unter der Helligkeit.
// Gleiche Hoehe, gleiche Rinne, gleicher Griff -- zwei Regler
// untereinander, die verschieden aussehen, sind zwei Regler zu viel.
const VLY: u64 = SLY + SLH + GAP
const BAY: u64 = VLY + SLH + GAP // der Akkustand
const L1Y: u64 = BAY + FH + GAP // Verknuepfung: Aufgabenverwaltung
const L2Y: u64 = L1Y + FH + GAP // Verknuepfung: Alle Einstellungen
const H: u64 = L2Y + FH + PAD
const SL_X: u64 = PAD + 104 // wo die Rinne des Reglers anfaengt
const SL_KN: u64 = 12 // die Breite des Griffs
// 20 UND NICHT 0. Der Kern nimmt 0..200; eine Null macht den Schirm
// schwarz, und einen Regler, mit dem man sich aussperren kann, gibt
// dieses Panel nicht her -- man saehe ihn danach nicht mehr, um ihn
// zurueckzuschieben.
const BR_MIN: u64 = 20
const BR_MAX: u64 = 200
const MARGIN: u64 = 4 // between the panel and the bar it sits beside
const BAND: u64 = 64 // rows of the drawing surface used at a time
const IC: u64 = 16 // the tile symbol, at its target size

const N_TILE: u64 = 6

// Die Aufrufe, die die neuen Kacheln bedienen. Dieselben Nummern wie in
// /bin/dispctl, /bin/power und /bin/tiling -- kein zweiter Weg zu
// derselben Sache.
const SYS_DISPGET: u64 = 1810
const SYS_DISPSET: u64 = 1811
const DG_BRIGHT: u64 = 16
const DS_BRIGHT: u64 = 3
const SYS_PWRGET: u64 = 1750
const SYS_PWRSET: u64 = 1751
const PG_READY: u64 = 0
const PG_PROFILE: u64 = 1
const PG_BATPRESENT: u64 = 24
const PG_BATPERCENT: u64 = 25
const PG_BATSTATE: u64 = 27
const PS_PROFILE: u64 = 0
// RUNDE TON-2: die Tonschnittstelle. Dieselben Nummern wie in
// /bin/play und kernel/sys.fi -- kein zweiter Weg zu derselben Sache.
const SYS_AUDGET: u64 = 1850
const SYS_AUDSET: u64 = 1851
const A_VOLUME: u64 = 4
const A_MUTED: u64 = 21
const A_READY: u64 = 0
const A_VOLGEN: u64 = 44
const AS_VOLUME: u64 = 0
const AS_MUTE: u64 = 2

const SYS_TILEGET: u64 = 1820
const SYS_TILEDO: u64 = 1821
const TL_ON: u64 = 0
const A_TILE_TOGGLE: u64 = 29

// ---------------------------------------------------------- the state

static mut w_h: u64 = 0
static mut w_id: u64 = 0
static mut open_: u64 = 0
static mut px_: u64 = 0
static mut py_: u64 = 0
static mut asc: u64 = 0
static mut a_edge: u64 = 0
static mut a_x: u64 = 0
static mut a_y: u64 = 0
static mut a_w: u64 = 800
static mut a_h: u64 = 600
static mut hk_last: u64 = 0
static mut t0: u64 = 0 // the press this opening answers, in ns
static mut btn_last: u64 = 0
static mut hide_want: u64 = 0 // 0 nothing, 1 turn on, 2 turn off
static mut ah_on: u64 = 0
static mut opens: u64 = 0
static mut ev: [u8; 16] = [0 as u8; 16]

// The tile symbols, read once at start. Same format as everything else
// in this round -- OSYM with colour ROLES, so one file is right in a
// light scheme and in a dark one.
const ICON_MAX: u64 = 1100
static mut ic_buf: [u8; 6600] = [0 as u8; 6600] // 6 Bilder
static mut ic_ok: u64 = 0

static mut p_icons: [u8; 14] = "/etc/netview/\0"
static mut n_ic: [u8; 76] = "tile-fake␀tile-net␀tile-hide␀tile-dark␀tile-power␀tile-tile␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀"
static mut p_settings: [u8; 14] = "/bin/settings\0"

// The words. German, like every other string the taskbar and the
// settings put on the screen in this tree; round I18N is the one that
// changes that, everywhere at once.
// RUNDE WERKZEUGE: DIE WOERTER STEHEN IM KATALOG, NICHT HIER.
//
// Bis zu dieser Runde standen "Netz vortäuschen", "Leiste verbergen"
// und "Alle Einstellungen" als deutsche Zeichenketten im Quelltext --
// zwei davon hat `tools/i18n/scan.py` seit Runde I18N angeschlagen, und
// zu Recht: das Panel ist Oberflaeche, und Oberflaeche gehoert
// uebersetzt. Was hier steht, sind SCHLUESSEL.
static mut k_fake: [u8; 8] = "qs.fake\0"
static mut k_net: [u8; 7] = "qs.net\0"
static mut k_hide: [u8; 8] = "qs.hide\0"
static mut k_dark: [u8; 8] = "qs.dark\0"
static mut k_power: [u8; 9] = "qs.power\0"
static mut k_tile: [u8; 8] = "qs.tile\0"
static mut k_on: [u8; 6] = "qs.on\0"
static mut k_off: [u8; 7] = "qs.off\0"
static mut k_na: [u8; 6] = "qs.na\0"
static mut k_bright: [u8; 10] = "qs.bright\0"
static mut k_volume: [u8; 10] = "qs.volume\0"
static mut k_bat: [u8; 11] = "qs.battery\0"
static mut k_nobat: [u8; 13] = "qs.nobattery\0"
static mut k_chg: [u8; 12] = "qs.charging\0"
static mut k_all: [u8; 12] = "qs.settings\0"
static mut k_tm: [u8; 11] = "qs.taskmgr\0"
static mut k_p0: [u8; 13] = "qs.prof.save\0"
static mut k_p1: [u8; 12] = "qs.prof.mid\0"
static mut k_p2: [u8; 12] = "qs.prof.max\0"
static mut k_title: [u8; 9] = "qs.title\0"
static mut t_title: [u8; 16] = "Schnelleinst.\0\0\0"
static mut p_taskmgr: [u8; 13] = "/bin/taskmgr\0"
static mut u_pct: [u8; 3] = " %\0"
static mut u_sp: [u8; 2] = " \0"
static mut u_op: [u8; 3] = " (\0"
static mut u_cl: [u8; 2] = ")\0"

static mut s_open: [u8; 12] = "qs: open x=\0"
static mut s_y: [u8; 4] = " y=\0"
static mut s_w: [u8; 4] = " w=\0"
static mut s_h: [u8; 4] = " h=\0"
static mut s_ed: [u8; 7] = " edge=\0"
static mut s_up: [u8; 6] = " up=\0\0"
static mut s_us: [u8; 5] = " us=\0"
static mut s_shut: [u8; 15] = "qs: closed by \0"
static mut s_esc: [u8; 7] = "escape\0"
static mut s_out: [u8; 8] = "outside\0"
static mut s_key: [u8; 7] = "hotkey\0"
static mut s_tile: [u8; 12] = "qs: tile n=\0"
static mut s_to: [u8; 5] = " to=\0"
static mut s_rc: [u8; 5] = " rc=\0"
static mut s_ico: [u8; 15] = "qs: symbols n=\0"
static mut s_wid: [u8; 12] = "qs: win id=\0"
// RUNDE HAENGER: DIE MARKEN, DIE JUSTINS FOTO LESBAR MACHEN.
//
// Auf dem Foto vom 04.09. 10:35 bricht die Ausgabe MITTEN in der Zeile
// "qs: win id=" ab -- der Text steht da, die Zahl nicht. Zwischen
// beiden liegt genau ein Aufruf (`WM_INFO`) und ein zweiter
// Schreibvorgang. Welcher von beiden es ist, war nicht zu sehen.
//
// Ab hier ist es zu sehen:
//   "qs: info?"      steht VOR dem Aufruf. Fehlt sie, kommt qs gar
//                    nicht bis hierher.
//   "qs: win id=N"   wird als EINE Zeile in EINEM Schreibvorgang
//                    ausgegeben. Bricht danach immer noch etwas
//                    mitten in dieser Zeile ab, dann schneidet die
//                    KONSOLE, nicht das Programm -- ein ganz anderer
//                    Fehler, und ohne diese Aenderung nicht zu trennen.
static mut s_wfrag: [u8; 11] = "qs: info?\n\0"
static mut s_wst: [u8; 11] = "qs: state \0"
static mut s_spawn: [u8; 17] = "qs: settings pid\0"
static mut s_txt: [u8; 11] = "qs: text x\0"
static mut s_eq: [u8; 2] = "=\0"
static mut s_ty: [u8; 4] = " y=\0"
static mut s_tf: [u8; 5] = " fg=\0"
static mut s_tb: [u8; 5] = " bg=\0"
static mut s_tt: [u8; 3] = " [\0"
static mut s_te: [u8; 3] = "]\0\0"
static mut s_sym: [u8; 12] = "qs: sym n=\0\0"
static mut s_sx: [u8; 4] = " x=\0"
static mut s_hell: [u8; 15] = "qs: hell auf =\0"
static mut s_druck: [u8; 13] = "qs: druck x=\0"
static mut s_hellist: [u8; 14] = "qs: hell ist=\0"
// RUNDE TON-2: dieselbe Bauart wie die Helligkeitszeile -- ein
// Pruefstand liest diese Zeilen und muss nicht raten, was gemalt wurde.
static mut s_volist: [u8; 13] = "qs: vol ist=\0"
static mut s_vomute: [u8; 8] = " stumm=\0"
static mut s_vol: [u8; 9] = "qs: vol=\0"
static mut s_mute: [u8; 10] = "qs: mute=\0"

fn say(p: u64) {
    ulib.say(p)
}

fn tlen(p: u64) -> u64 {
    return ulib.length(p)
}

fn nth(p: u64, i: u64) -> u64 {
    var at: u64 = 0
    var k: u64 = 0
    while k < i {
        while __mmio_read8((p + at) as *mut u8) != 0 as u8 {
            at = at + 1
        }
        at = at + 1
        k = k + 1
    }
    return p + at
}

// CLOCK_MONOTONIC, the same clock `kbd.fi` stamped the press with and
// the same one `nvcheck` measures the faked connection with. Not
// `ticks` -- ticks are ten milliseconds in this kernel and the whole
// question here is whether the panel is up in less than that.
fn now_ns() -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    let _r: u64 = kcall.sys2(kcall.SYS_CLOCK_GETTIME, 1,
        (&ts[0 as usize]) as u64)
    return (ts[0 as usize] *% 1000000000) +% ts[1 as usize]
}

// ------------------------------------------------------- the symbols

fn icon_read(name: u64, dst: u64, max: u64) -> u64 {
    var path: [u8; 48] = [0 as u8; 48]
    let p: u64 = (&path[0 as usize]) as u64
    var at: u64 = ulib.strcpy(p, (&p_icons[0 as usize]) as u64)
    at = at + ulib.strcpy(p + at, name)
    let fd: u64 = io.open(p, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = io.read(fd, dst, max)
    io.close(fd)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn icons_load() {
    ic_ok = 0
    var i: u64 = 0
    while i < N_TILE {
        if icon_read(nth((&n_ic[0 as usize]) as u64, i),
            (&ic_buf[0 as usize]) as u64 + i * ICON_MAX, ICON_MAX) > 12 {
            ic_ok = ic_ok + 1
        }
        i = i + 1
    }
}

// ONE DRAWING PER TILE, not one per tile and state. It was built the
// other way first and measured: two sixteen-by-sixteen glyphs that
// differ only on the inside come out about a quarter of their pixels
// apart, under the third `tools/netview/icons.py` demands of any two
// signs that mean different things -- and the tool was right, a quarter
// is not something anybody sees at a glance.
//
// So the switch position is carried where a toggle actually carries it,
// and only one of the three is colour: the WORD under the tile ("an" /
// "aus"), the RELIEF of the frame (raised off, sunken on), and the
// fill. See `assets/netview/tile-net.txt`, where the reasoning sits
// next to the drawing.
fn tile_icon(t: u64) -> u64 {
    if ic_ok < N_TILE {
        return 0
    }
    return (&ic_buf[0 as usize]) as u64 + t * ICON_MAX
}

// ---------------------------------------------------- what each tile is
//
// READ FRESH, NEVER REMEMBERED. Every one of these three is a question
// somebody else can also answer -- `/bin/netview fallback` sets the
// first, `dhcp` can change the second, `/bin/settings` the third.
// A panel with its own copy would show the copy.

fn pget(f: u64) -> u64 {
    let v: u64 = ulib.sys(SYS_PWRGET, f, 0, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

fn dget(f: u64) -> u64 {
    let v: u64 = ulib.sys(SYS_DISPGET, f, 0, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

fn tget(f: u64) -> u64 {
    let v: u64 = ulib.sys(SYS_TILEGET, f, 0, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

// KANN DIE MASCHINE DAS UEBERHAUPT? Der Kern sagt es selbst: `PG_READY`
// ist 1, wenn die Energieverwaltung ihre Register wirklich gelesen hat.
// Steht dort eine Null, zeigt die Kachel einen Strich -- und nicht
// "sparen", was wie eine Einstellung aussaehe.
fn power_da() -> bool {
    return pget(PG_READY) != 0
}

fn tile_on(t: u64) -> bool {
    if t == 0 {
        return nv.fallback_on()
    }
    if t == 1 {
        return nv.net_ip() != 0 && !ulib.bad(nv.net_ip())
    }
    if t == 2 {
        return ah_on != 0
    }
    if t == 3 {
        return wlibc.theme_dark()
    }
    if t == 4 {
        // "an" heisst hier: nicht auf Sparen. Das Wort darunter sagt
        // ohnehin, welches der drei Profile laeuft.
        return power_da() && pget(PG_PROFILE) != 0
    }
    return tget(TL_ON) != 0
}

fn tile_label(t: u64) -> u64 {
    if t == 0 {
        return msg.get((&k_fake[0 as usize]) as u64)
    }
    if t == 1 {
        return msg.get((&k_net[0 as usize]) as u64)
    }
    if t == 2 {
        return msg.get((&k_hide[0 as usize]) as u64)
    }
    if t == 3 {
        return msg.get((&k_dark[0 as usize]) as u64)
    }
    if t == 4 {
        return msg.get((&k_power[0 as usize]) as u64)
    }
    return msg.get((&k_tile[0 as usize]) as u64)
}

// DAS WORT UNTER DER KACHEL. Bei fuenf Kacheln ist es "an" oder "aus";
// beim Energieprofil ist es der NAME des Profils, denn drei Zustaende
// lassen sich nicht mit zwei Woertern sagen -- und ein Schalter, der
// "an" zeigt, wenn drei Dinge moeglich sind, sagt nichts.
fn tile_word(t: u64) -> u64 {
    if t == 4 {
        if !power_da() {
            return msg.get((&k_na[0 as usize]) as u64)
        }
        let p: u64 = pget(PG_PROFILE)
        if p == 0 {
            return msg.get((&k_p0[0 as usize]) as u64)
        }
        if p == 1 {
            return msg.get((&k_p1[0 as usize]) as u64)
        }
        return msg.get((&k_p2[0 as usize]) as u64)
    }
    if tile_on(t) {
        return msg.get((&k_on[0 as usize]) as u64)
    }
    return msg.get((&k_off[0 as usize]) as u64)
}

// The address the machine had before "network off" took it away, so
// that "network on" can give the same one back. It is REMEMBERED HERE
// and nowhere else, and it is deliberately not written to a file: a
// remembered address that survives a reboot would be a second, stale
// answer to a question DHCP already answers at every start.
static mut old_ip: u64 = 0
static mut old_mask: u64 = 0
static mut old_gw: u64 = 0

fn tile_click(t: u64) -> u64 {
    if t == 3 {
        // SOFORT UND DAUERHAFT. `theme_set_mode` schreibt in die
        // gemeinsame Bank, aus der JEDES Fenster liest -- die anderen
        // Programme ziehen beim naechsten `theme_poll` nach, ohne dass
        // hier jemand benachrichtigt werden muesste. `mode_write` legt
        // eine Zeile in /etc/theme.conf, damit es den Neustart
        // ueberlebt; geschrieben wird sie von dem Modul, das die Datei
        // ohnehin schreibt, und nicht von hier.
        var neu: u64 = wlibc.MODE_DARK
        if wlibc.theme_dark() {
            neu = wlibc.MODE_LIGHT
        }
        wlibc.theme_set_mode(neu)
        if !vorlage.mode_write(neu) {
            return 0 - 1
        }
        return 0
    }
    if t == 4 {
        if !power_da() {
            return 0 - 1
        }
        var p: u64 = pget(PG_PROFILE) + 1
        if p > 2 {
            p = 0
        }
        return ulib.sys(SYS_PWRSET, PS_PROFILE, p, 0)
    }
    if t == 5 {
        return ulib.sys(SYS_TILEDO, A_TILE_TOGGLE, 0, 0)
    }
    if t == 0 {
        return nv.fallback_switch(!nv.fallback_on())
    }
    if t == 1 {
        if tile_on(1) {
            old_ip = nv.net_ip()
            old_mask = nv.net_mask()
            old_gw = nv.net_gw()
            return nv.net_off()
        }
        if old_ip == 0 {
            return 0 - 1
        }
        return nv.net_on(old_ip, old_mask, old_gw)
    }
    // The taskbar owns `/etc/taskbar.conf` and writes it in exactly one
    // place. This tile asks; `taskbar.fi` does it and tells us what came
    // of it (`took_hide`). Two writers of one file is how a file ends
    // up disagreeing with itself.
    if ah_on != 0 {
        hide_want = 2
    } else {
        hide_want = 1
    }
    return 0
}

fn want_hide() -> u64 {
    return hide_want
}

// The bar hands back what it actually did, and the tile shows THAT --
// not what it asked for.
fn took_hide(now: u64) {
    hide_want = 0
    ah_on = now
}

// --------------------------------------------------------- the window

fn init(autohide: u64) -> bool {
    ah_on = autohide
    asc = wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    icons_load()
    say((&s_ico[0 as usize]) as u64)
    ulib.sayn(ic_ok)
    ulib.nl()
    let h: u64 = wlibc.sys5(wlibc.WM_CREATE, 0, (W << 16) | H,
        (&t_title[0 as usize]) as u64, 0, 0)
    if ulib.bad(h) || h == 0 {
        return false
    }
    w_h = h
    let _d: u64 = wlibc.win_state(h, wlibc.WS_DECO, 0)
    // L_NORMAL AND NOT L_TOP, and it was L_TOP first and measured
    // wrong: Escape never arrived. The window server gives the keyboard
    // ONLY to a window on the normal layer -- `wm.set_layer` explicitly
    // takes the focus away from anything that leaves it, and
    // `wm.on_mouse` only calls `set_focus` for L_NORMAL. That is a good
    // rule and it is round DESKTOP's: a taskbar that swallowed the
    // keyboard would make every key after a click on it useless.
    //
    // But this panel is not a taskbar. It has to be typed at -- Escape
    // is one of its three ways of closing, and a panel the keyboard
    // cannot get out of would be worse than none. So it lives on the
    // normal layer and is RAISED when it opens, which puts it over
    // everything except the bar itself; and since it sits beside the
    // bar rather than on it, that is exactly right.
    //
    // The price is one line in the taskbar: a window on the normal
    // layer gets a button in the bar, and this one must not
    // (`taskbar.list_read` skips this id). It is part of the bar, not an
    // application.
    let _l: u64 = wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_NORMAL)
    let _v: u64 = wlibc.win_state(h, wlibc.WS_HIDDEN, 1)
    // Eine Marke NACH den drei Zustandsaufrufen: kommt sie, haben alle
    // drei zurueckgekehrt, und der Verdacht liegt allein auf WM_INFO.
    say((&s_wst[0 as usize]) as u64)
    ulib.nl()
    say((&s_wfrag[0 as usize]) as u64)
    w_id = wlibc.sys3w(wlibc.WM_INFO, h, wlibc.WI_ID, 0)
    // EIN Schreibvorgang fuer die ganze Zeile, Zeilenende eingebaut.
    var zl: [u8; 48] = [0 as u8; 48]
    let zp: u64 = (&zl[0 as usize]) as u64
    var zn: u64 = 0
    zn = anhaengen(zp, zn, (&s_wid[0 as usize]) as u64)
    zn = zn + ulib.digits(w_id, zp + zn)
    __mmio_write8((zp + zn) as *mut u8, 10 as u8)
    zn = zn + 1
    let _z: u64 = ulib.put(zp, zn)
    return true
}

// Text an einen Puffer haengen, ohne Zeilenende. Fuer die eine Zeile,
// die in EINEM Stueck hinausgehen muss.
fn anhaengen(buf: u64, at: u64, t: u64) -> u64 {
    let n: u64 = ulib.length(t)
    var i: u64 = 0
    while i < n {
        __mmio_write8((buf + at + i) as *mut u8, *((t + i) as *mut u8))
        i = i + 1
    }
    return at + n
}

// So the bar can leave itself out of its own list of windows.
fn win_id() -> u64 {
    return w_id
}

// WHERE THE TASKBAR IS, out of the taskbar. The work area is what is
// left of the screen after every reserved edge; the panel goes in the
// corner of THAT, on the side the bar is on.
fn anchor(edge: u64, wx: u64, wy: u64, ww: u64, wh: u64) {
    a_edge = edge
    a_x = wx
    a_y = wy
    a_w = ww
    a_h = wh
    place()
}

fn place() {
    var x: u64 = 0
    var y: u64 = 0
    if a_w > W + 2 * MARGIN {
        x = a_x + a_w - W - MARGIN
    } else {
        x = a_x
    }
    if a_h > H + 2 * MARGIN {
        y = a_y + a_h - H - MARGIN
    } else {
        y = a_y
    }
    // TOP: the bar is above, so the panel hangs from the top of what is
    // left. LEFT: the bar is beside it, so the panel starts at the left
    // of what is left -- and stays at the BOTTOM, because that is where
    // the icon group of a vertical bar is.
    if a_edge == wlibc.WE_TOP {
        y = a_y + MARGIN
    }
    if a_edge == wlibc.WE_LEFT {
        x = a_x + MARGIN
    }
    px_ = x
    py_ = y
    if open_ != 0 {
        let _m: u64 = wlibc.sys3w(wlibc.WM_MOVE, w_h, (px_ << 16) | py_, 0)
    }
}

fn is_open() -> bool {
    return open_ != 0
}

// Is this SCREEN point on the panel? The taskbar asks before it treats
// a press as the beginning of a drag.
fn hit(x: u64, y: u64) -> bool {
    if open_ == 0 {
        return false
    }
    return x >= px_ && x < px_ + W && y >= py_ && y < py_ + H
}

fn open_at(when: u64) {
    if open_ != 0 {
        return
    }
    t0 = when
    place()
    let _m: u64 = wlibc.sys3w(wlibc.WM_MOVE, w_h, (px_ << 16) | py_, 0)
    let _v: u64 = wlibc.win_state(w_h, wlibc.WS_HIDDEN, 0)
    open_ = 1
    opens = opens + 1
    // TWO STAMPS AND NOT ONE, because a single number does not say
    // where the time went. The first is the moment the WINDOW STANDS
    // (moved, unhidden) -- everything before it is the wait for the
    // taskbar's poll to come round. The second is after the PAINT. The
    // difference between them is drawing; the first one on its own is
    // latency, and they are worth different things.
    let t_up: u64 = now_ns()
    // PAINTED, NOT REPORTED, AND THE STOPWATCH STOPS HERE. The first
    // measurement said 365 771 microseconds and it was measuring the
    // SERIAL LINE: `paint(true)` writes a dozen lines about what it
    // drew, at 115 200 baud, inside the window being timed. Round
    // TASKBAR made exactly this mistake with auto-hide and wrote it
    // down; this is the same lesson, applied to the same file. What is
    // timed is the work the person waits for -- move, show, draw. The
    // report comes afterwards, outside the measurement.
    paint(false)
    let t_done: u64 = now_ns()
    // AND THE FOCUS, so that Escape arrives. A panel that could only be
    // closed with the pointer would be a panel the keyboard cannot get
    // out of.
    let _a: u64 = wlibc.win_act(w_id, wlibc.WA_RAISE)
    // THE STOPWATCH STOPS HERE, after the window stands and is painted,
    // and it started in the KEYBOARD INTERRUPT (`kbd.fi` wrote the
    // clock into the latch). One clock, both ends, nothing in between
    // estimated.
    say((&s_open[0 as usize]) as u64)
    ulib.sayn(px_)
    say((&s_y[0 as usize]) as u64)
    ulib.sayn(py_)
    say((&s_w[0 as usize]) as u64)
    ulib.sayn(W)
    say((&s_h[0 as usize]) as u64)
    ulib.sayn(H)
    say((&s_ed[0 as usize]) as u64)
    ulib.sayn(a_edge)
    say((&s_up[0 as usize]) as u64)
    var d1: u64 = 0
    if t0 != 0 && t_up > t0 {
        d1 = (t_up -% t0) / 1000
    }
    ulib.sayn(d1)
    say((&s_us[0 as usize]) as u64)
    var d: u64 = 0
    if t0 != 0 && t_done > t0 {
        d = (t_done -% t0) / 1000
    }
    ulib.sayn(d)
    ulib.nl()
    paint(true)
}

fn shut(why: u64) {
    if open_ == 0 {
        return
    }
    open_ = 0
    t0 = 0
    let _v: u64 = wlibc.win_state(w_h, wlibc.WS_HIDDEN, 1)
    say((&s_shut[0 as usize]) as u64)
    say(why)
    ulib.nl()
}

fn toggle() {
    if open_ != 0 {
        shut((&s_key[0 as usize]) as u64)
    } else {
        open_at(now_ns())
    }
}

// ----------------------------------------------------------- the poll
//
// Called once per turn of the taskbar's loop. Three jobs and none of
// them costs anything while the panel is shut: the hotkey latch is one
// system call, the event ring is one, and the pointer is only asked
// while the panel is open.
fn step() -> bool {
    var changed: bool = false
    let seq: u64 = nv.hotkey_seq()
    if seq != hk_last {
        let was: u64 = hk_last
        hk_last = seq
        // 97 is `a`. ONE hotkey, and it is spelled out rather than
        // configurable: a key map is a round of its own and inventing
        // half of one here would be the kind of half-thing this round
        // keeps refusing.
        if was != 0 || seq == 1 {
            if nv.hotkey_key() == 97 {
                if open_ != 0 {
                    shut((&s_key[0 as usize]) as u64)
                } else {
                    open_at(nv.hotkey_ns())
                }
                changed = true
            }
        }
    }
    if open_ == 0 {
        return changed
    }
    var n: u64 = 0
    while n < 16 && wlibc.sys3w(wlibc.WM_EVENT, w_h,
        (&ev[0 as usize]) as u64, 0) == 1 {
        let b: u64 = (&ev[0 as usize]) as u64
        let typ: u64 = __mmio_read64((b) as *mut u64)
        let d: u64 = __mmio_read64((b + 8) as *mut u64)
        if typ == wlibc.EV_KEY {
            // THE CHARACTER IS AT BITS 32..47 AND NOT AT 0. One event
            // word carries three numbers -- `wm.ev_push` packs them
            // `(a << 32) | (b << 16) | c` -- and for a key the
            // character is `a`. Read as the whole word it is 27 << 32,
            // which is never 27, so the first version of this simply
            // ignored every Escape and looked exactly like a focus
            // problem. It cost two runs to stop believing that.
            if ((d >> 32) & 0xFFFF) == 27 {
                shut((&s_esc[0 as usize]) as u64)
                return true
            }
        } else if typ == wlibc.EV_DOWN {
            // JEDER DRUCK WIRD GEMELDET, bevor er ausgewertet wird.
            // Ohne diese Zeile ist ein Klick, der gar nicht ankommt,
            // nicht von einem zu unterscheiden, der ankommt und
            // danebenliegt -- und die Abnahme dieser Runde hat genau
            // diese beiden Faelle zweimal verwechselt.
            say((&s_druck[0 as usize]) as u64)
            ulib.sayn((d >> 32) & 0xFFFF)
            say((&s_y[0 as usize]) as u64)
            ulib.sayn((d >> 16) & 0xFFFF)
            ulib.nl()
            click((d >> 32) & 0xFFFF, (d >> 16) & 0xFFFF)
            changed = true
        } else if typ == wlibc.EV_CLOSE {
            shut((&s_esc[0 as usize]) as u64)
            return true
        }
        n = n + 1
    }
    if open_ == 0 {
        return changed
    }
    // A PRESS BESIDE IT. The window server tells a window about the
    // pointer only while the pointer is INSIDE it, so a press somewhere
    // else raises no event of ours -- the same reason the drag of the
    // bar polls. Only the EDGE of the press counts: holding the button
    // down must not close the panel forty times.
    let btn: u64 = wlibc.mouse_btn() & 1
    if btn != 0 && btn_last == 0 {
        let mx: u64 = wlibc.mouse_x()
        let my: u64 = wlibc.mouse_y()
        if !hit(mx, my) {
            shut((&s_out[0 as usize]) as u64)
            changed = true
        }
    }
    btn_last = btn
    return changed
}

// ---------------------------------------------------------- the clicks

fn tile_rect_x(t: u64) -> u64 {
    if (t % 2) == 0 {
        return PAD
    }
    return PAD + TW + GAP
}

fn tile_rect_y(t: u64) -> u64 {
    return PAD + (t / 2) * (TH + GAP)
}

fn click(x: u64, y: u64) {
    var t: u64 = 0
    while t < N_TILE {
        let tx: u64 = tile_rect_x(t)
        let ty: u64 = tile_rect_y(t)
        if x >= tx && x < tx + TW && y >= ty && y < ty + TH {
            let rc: u64 = tile_click(t)
            say((&s_tile[0 as usize]) as u64)
            ulib.sayn(t)
            say((&s_to[0 as usize]) as u64)
            if tile_on(t) {
                ulib.sayn(1)
            } else {
                ulib.sayn(0)
            }
            say((&s_rc[0 as usize]) as u64)
            ulib.sayn(rc)
            ulib.nl()
            paint(true)
            return
        }
        t = t + 1
    }
    // DER HELLIGKEITSREGLER. Die Stelle des Klicks IST der Wert -- kein
    // Ziehen, kein Griff, den man treffen muss: das Panel schliesst
    // sich bei einem Druck ausserhalb, und ein Ziehen ueber den Rand
    // hinaus waere genau so ein Druck.
    if y >= SLY && y < SLY + SLH && x >= SL_X {
        let spur: u64 = W - PAD - SL_X
        var rel: u64 = x - SL_X
        if rel > spur {
            rel = spur
        }
        let v: u64 = BR_MIN + rel * (BR_MAX - BR_MIN) / spur
        let rc: u64 = ulib.sys(SYS_DISPSET, DS_BRIGHT, v, 0)
        say((&s_hell[0 as usize]) as u64)
        ulib.sayn(v)
        say((&s_rc[0 as usize]) as u64)
        ulib.sayn(rc)
        ulib.nl()
        paint(true)
        return
    }
    // RUNDE TON-2: DER LAUTSTAERKEREGLER. Die Stelle des Klicks IST
    // der Wert, genau wie bei der Helligkeit darueber und aus
    // demselben Grund: das Panel schliesst sich bei einem Druck
    // ausserhalb, ein Ziehen ueber den Rand waere so ein Druck.
    //
    // EIN KLICK AUF DIE BESCHRIFTUNG (links von der Rinne) SCHALTET
    // STUMM. Das ist die Klickfaehigkeit, die der Auftrag verlangt,
    // und sie sitzt da, wo sonst nichts passiert -- ein eigener Knopf
    // haette die Zeile schmaler gemacht als die Helligkeitszeile
    // darueber.
    if y >= VLY && y < VLY + SLH {
        if ulib.sys(SYS_AUDGET, A_READY, 0, 0) != 1 {
            return
        }
        if x < SL_X {
            let an: u64 = ulib.sys(SYS_AUDGET, A_MUTED, 0, 0)
            var neu: u64 = 1
            if an == 1 {
                neu = 0
            }
            let rc: u64 = ulib.sys(SYS_AUDSET, AS_MUTE, neu, 0)
            say((&s_mute[0 as usize]) as u64)
            ulib.sayn(neu)
            say((&s_rc[0 as usize]) as u64)
            ulib.sayn(rc)
            ulib.nl()
            paint(true)
            return
        }
        let spur: u64 = W - PAD - SL_X
        var rel: u64 = x - SL_X
        if rel > spur {
            rel = spur
        }
        let v: u64 = rel * 100 / spur
        let rc: u64 = ulib.sys(SYS_AUDSET, AS_VOLUME, v, 0)
        // WER DIE LAUTSTAERKE ZIEHT, WILL SIE HOEREN. Stumm bleibt
        // stumm waere hier die falsche Treue zum Zustand: das Ziehen
        // IST die Ansage, dass wieder Ton kommen soll.
        if v > 0 && ulib.sys(SYS_AUDGET, A_MUTED, 0, 0) == 1 {
            ulib.sys(SYS_AUDSET, AS_MUTE, 0, 0)
        }
        say((&s_vol[0 as usize]) as u64)
        ulib.sayn(v)
        say((&s_rc[0 as usize]) as u64)
        ulib.sayn(rc)
        ulib.nl()
        paint(true)
        return
    }
    if y >= L1Y && y < L1Y + FH {
        let pid: u64 = ulib.sys(ulib.SYS_SPAWN,
            (&p_taskmgr[0 as usize]) as u64, 0, 0)
        say((&s_spawn[0 as usize]) as u64)
        say((&s_eq[0 as usize]) as u64)
        ulib.sayn(pid)
        ulib.nl()
        shut((&s_out[0 as usize]) as u64)
        return
    }
    if y >= L2Y && y < L2Y + FH {
        let pid: u64 = ulib.sys(ulib.SYS_SPAWN,
            (&p_settings[0 as usize]) as u64, 0, 0)
        say((&s_spawn[0 as usize]) as u64)
        say((&s_eq[0 as usize]) as u64)
        ulib.sayn(pid)
        ulib.nl()
        shut((&s_out[0 as usize]) as u64)
    }
}

// ---------------------------------------------------------- the drawing

// Every string this panel puts on the screen is also written to the
// serial line with the place and the colours it was drawn in, so that
// `tools/netview/run.sh` can hold the report against the picture -- the
// rule the taskbar has followed since round DESKTOP, and the reason a
// program cannot report one thing and paint another here either.
// The label, cut to `avail` pixels, one character at a time. It
// returns a pointer into a scratch buffer, so exactly one label may be
// in flight at a time -- which is true, because they are drawn one
// after another.
static mut cut: [u8; 64] = [0 as u8; 64]

fn fit(p: u64, avail: u64) -> u64 {
    var n: u64 = tlen(p)
    if wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, n) <= avail {
        return p
    }
    let q: u64 = (&cut[0 as usize]) as u64
    if n > 63 {
        n = 63
    }
    var k: u64 = 0
    while k < n {
        __mmio_write8((q + k) as *mut u8, __mmio_read8((p + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((q + n) as *mut u8, 0 as u8)
    while n > 1 && wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q, n) > avail {
        n = n - 1
        __mmio_write8((q + n) as *mut u8, 0 as u8)
    }
    return q
}

fn say_text(x: u64, base: u64, fg: u64, bg: u64, txt: u64) {
    say((&s_txt[0 as usize]) as u64)
    say((&s_eq[0 as usize]) as u64)
    ulib.sayn(x)
    say((&s_ty[0 as usize]) as u64)
    ulib.sayn(base)
    say((&s_tf[0 as usize]) as u64)
    ulib.sayn(fg)
    say((&s_tb[0 as usize]) as u64)
    ulib.sayn(bg)
    say((&s_tt[0 as usize]) as u64)
    say(txt)
    say((&s_te[0 as usize]) as u64)
    ulib.nl()
}

fn paint_band(y0: u64, hh: u64, report: bool) {
    wlibc.set_band(y0)
    wlibc.clip_set(0, y0, W, y0 + hh)
    wlibc.rect(0, y0, W, hh, wlibc.theme(wlibc.T_PANEL))
    // A LINE ROUND IT. Without it the panel and the bar are the same
    // grey with no edge between them, and the person cannot see where
    // one stops.
    wlibc.frame(0, 0, W, H, wlibc.theme(wlibc.T_LINE))
    var t: u64 = 0
    while t < N_TILE {
        let tx: u64 = tile_rect_x(t)
        let ty: u64 = tile_rect_y(t)
        if ty + TH > y0 && ty < y0 + hh {
            // DRAWN IN EVERY BAND IT TOUCHES, REPORTED IN ONE. The
            // drawing surface is 81 rows (`wlibc.SURF_ROWS`), so a
            // 62-pixel tile straddles a band boundary and is painted
            // twice -- reporting it twice would put two lines with two
            // different truths about one tile on the serial line.
            let mine: bool = report && ty >= y0 && ty < y0 + hh
            let on: bool = tile_on(t)
            var bg: u64 = wlibc.theme(wlibc.T_BTN)
            var fg: u64 = wlibc.theme(wlibc.T_FG)
            var dim: u64 = wlibc.theme(wlibc.T_DIM)
            if on {
                bg = wlibc.theme(wlibc.T_SEL)
                fg = wlibc.theme(wlibc.T_SELFG)
                dim = wlibc.theme(wlibc.T_SELFG)
            }
            wlibc.rect(tx, ty, TW, TH, bg)
            wlibc.frame3(tx, ty, TW, TH, wlibc.theme(wlibc.T_BTNHI),
                wlibc.theme(wlibc.T_LINE), on)
            let ip: u64 = tile_icon(t)
            if ip != 0 {
                let _i: bool = wlibc.icon_draw(ip, tx + 10, ty + 10)
                if mine {
                    say((&s_sym[0 as usize]) as u64)
                    ulib.sayn(t)
                    say((&s_sx[0 as usize]) as u64)
                    ulib.sayn(px_ + tx + 10)
                    say((&s_y[0 as usize]) as u64)
                    ulib.sayn(py_ + ty + 10)
                    say((&s_to[0 as usize]) as u64)
                    if on {
                        ulib.sayn(1)
                    } else {
                        ulib.sayn(0)
                    }
                    ulib.nl()
                }
            }
            // AND IT IS SHORTENED IF IT STILL DOES NOT FIT, and the
            // SHORTENED one is what gets reported. A tile that reported
            // the long label and painted a clipped one would pass a
            // checker that compares the two -- which is exactly the
            // trap round DESKTOP wrote down for the status fields.
            let lab: u64 = fit(tile_label(t), TW - 20)
            let lb: u64 = ty + 8 + IC + 4 + asc
            let _e: u64 = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), tx + 10,
                lb, lab, tlen(lab), fg)
            let st: u64 = tile_word(t)
            let sb: u64 = ty + TH - 10
            let _f: u64 = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), tx + 10,
                sb, st, tlen(st), dim)
            if mine {
                say_text(tx + 10, lb, fg, bg, lab)
                say_text(tx + 10, sb, dim, bg, st)
            }
        }
        t = t + 1
    }
    // ------------------------------------------------ der Helligkeitsregler
    if SLY + SLH > y0 && SLY < y0 + hh {
        let lb: u64 = msg.get((&k_bright[0 as usize]) as u64)
        let base: u64 = SLY + (SLH + asc) / 2 - 1
        let _h1: u64 = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), PAD, base,
            lb, tlen(lb), wlibc.theme(wlibc.T_FG))
        let spur: u64 = W - PAD - SL_X
        let mitte: u64 = SLY + SLH / 2
        wlibc.rect(SL_X, mitte - 2, spur, 4, wlibc.theme(wlibc.T_SCROLL))
        var v: u64 = dget(DG_BRIGHT)
        if v < BR_MIN {
            v = BR_MIN
        }
        if v > BR_MAX {
            v = BR_MAX
        }
        let kx: u64 = SL_X + (v - BR_MIN) * (spur - SL_KN)
            / (BR_MAX - BR_MIN)
        // DER TEIL LINKS VOM GRIFF IN DER AKZENTFARBE: so sieht man, wo
        // der Regler steht, auch wenn man den Griff nicht erkennt.
        wlibc.rect(SL_X, mitte - 2, kx - SL_X, 4, wlibc.theme(wlibc.T_ACCENT))
        wlibc.rect(kx, mitte - 8, SL_KN, 16, wlibc.theme(wlibc.T_BTN))
        wlibc.frame(kx, mitte - 8, SL_KN, 16, wlibc.theme(wlibc.T_LINE))
        if report && SLY >= y0 && SLY < y0 + hh {
            say_text(PAD, base, wlibc.theme(wlibc.T_FG),
                wlibc.theme(wlibc.T_PANEL), lb)
            say((&s_hellist[0 as usize]) as u64)
            ulib.sayn(v)
            say((&s_sx[0 as usize]) as u64)
            ulib.sayn(kx)
            ulib.nl()
        }
    }
    // ------------------------------------------------ RUNDE TON-2:
    // DER LAUTSTAERKEREGLER. Gebaut wie der Helligkeitsregler darueber,
    // Bildpunkt fuer Bildpunkt, und aus denselben Themenmarken --
    // T_SCROLL fuer die Rinne, T_ACCENT fuer den gefuellten Teil,
    // T_BTN fuer den Griff, T_LINE fuer die Kante. Kein fester
    // Farbwert, kein eigener Zeichenweg.
    //
    // IST STUMM GESCHALTET, wird die Rinne NICHT gefuellt und der
    // Wert in der gedaempften Farbe geschrieben: "stumm bei 70" ist
    // ein anderer Zustand als "auf null gedreht", und ein Regler, der
    // beides gleich zeigt, verschweigt den Unterschied.
    if VLY + SLH > y0 && VLY < y0 + hh {
        let lb: u64 = msg.get((&k_volume[0 as usize]) as u64)
        let base: u64 = VLY + (SLH + asc) / 2 - 1
        let da: bool = ulib.sys(SYS_AUDGET, A_READY, 0, 0) == 1
        var vfg: u64 = wlibc.theme(wlibc.T_FG)
        if !da {
            vfg = wlibc.theme(wlibc.T_DIM)
        }
        let _h2: u64 = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), PAD, base,
            lb, tlen(lb), vfg)
        let spur: u64 = W - PAD - SL_X
        let mitte: u64 = VLY + SLH / 2
        wlibc.rect(SL_X, mitte - 2, spur, 4, wlibc.theme(wlibc.T_SCROLL))
        var v: u64 = 0
        var stumm: bool = false
        if da {
            v = ulib.sys(SYS_AUDGET, A_VOLUME, 0, 0)
            if v > 100 {
                v = 100
            }
            stumm = ulib.sys(SYS_AUDGET, A_MUTED, 0, 0) == 1
        }
        let kx: u64 = SL_X + v * (spur - SL_KN) / 100
        if !stumm && v > 0 {
            wlibc.rect(SL_X, mitte - 2, kx - SL_X, 4,
                wlibc.theme(wlibc.T_ACCENT))
        }
        wlibc.rect(kx, mitte - 8, SL_KN, 16, wlibc.theme(wlibc.T_BTN))
        wlibc.frame(kx, mitte - 8, SL_KN, 16, wlibc.theme(wlibc.T_LINE))
        if report && VLY >= y0 && VLY < y0 + hh {
            say_text(PAD, base, vfg, wlibc.theme(wlibc.T_PANEL), lb)
            say((&s_volist[0 as usize]) as u64)
            ulib.sayn(v)
            say((&s_vomute[0 as usize]) as u64)
            if stumm {
                ulib.sayn(1)
            } else {
                ulib.sayn(0)
            }
            say((&s_sx[0 as usize]) as u64)
            ulib.sayn(kx)
            ulib.nl()
        }
    }
    // ------------------------------------------------------ der Akkustand
    if BAY + FH > y0 && BAY < y0 + hh {
        let base: u64 = BAY + (FH + asc) / 2 - 1
        var zeile: [u8; 64] = [0 as u8; 64]
        let z: u64 = (&zeile[0 as usize]) as u64
        var at: u64 = ulib.strcpy(z, msg.get((&k_bat[0 as usize]) as u64))
        at = at + ulib.strcpy(z + at, (&u_sp[0 as usize]) as u64)
        // KEIN AKKU IST KEINE NULL PROZENT. Der Kern sagt, ob einer da
        // ist; steht dort eine Null, steht hier ein Wort und keine Zahl.
        if pget(PG_BATPRESENT) == 0 {
            at = at + ulib.strcpy(z + at,
                msg.get((&k_nobat[0 as usize]) as u64))
        } else {
            at = at + ulib.digits(pget(PG_BATPERCENT), z + at)
            at = at + ulib.strcpy(z + at, (&u_pct[0 as usize]) as u64)
            if (pget(PG_BATSTATE) & 2) != 0 {
                at = at + ulib.strcpy(z + at, (&u_op[0 as usize]) as u64)
                at = at + ulib.strcpy(z + at,
                    msg.get((&k_chg[0 as usize]) as u64))
                at = at + ulib.strcpy(z + at, (&u_cl[0 as usize]) as u64)
            }
        }
        let _b: u64 = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), PAD, base,
            z, at, wlibc.theme(wlibc.T_DIM))
        if report && BAY >= y0 && BAY < y0 + hh {
            say_text(PAD, base, wlibc.theme(wlibc.T_DIM),
                wlibc.theme(wlibc.T_PANEL), z)
        }
    }
    // -------------------------------------------------- die Verknuepfungen
    if L1Y + FH > y0 && L1Y < y0 + hh {
        wlibc.hline(PAD, L1Y - 4, W - 2 * PAD, wlibc.theme(wlibc.T_LINE))
        let p: u64 = msg.get((&k_tm[0 as usize]) as u64)
        let base: u64 = L1Y + (FH + asc) / 2 - 1
        let _g: u64 = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), PAD + 10,
            base, p, tlen(p), wlibc.theme(wlibc.T_FG))
        if report && L1Y >= y0 && L1Y < y0 + hh {
            say_text(PAD + 10, base, wlibc.theme(wlibc.T_FG),
                wlibc.theme(wlibc.T_PANEL), p)
        }
    }
    if L2Y + FH > y0 && L2Y < y0 + hh {
        let p: u64 = msg.get((&k_all[0 as usize]) as u64)
        let base: u64 = L2Y + (FH + asc) / 2 - 1
        let _g: u64 = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), PAD + 10,
            base, p, tlen(p), wlibc.theme(wlibc.T_FG))
        if report && L2Y >= y0 && L2Y < y0 + hh {
            say_text(PAD + 10, base, wlibc.theme(wlibc.T_FG),
                wlibc.theme(wlibc.T_PANEL), p)
        }
    }
    let _p: u64 = wlibc.push(w_h, 0, y0, W, hh)
}

fn paint(report: bool) {
    if open_ == 0 {
        return
    }
    var y: u64 = 0
    var first: bool = true
    let _q: bool = first
    while y < H {
        var hh: u64 = BAND
        if y + hh > H {
            hh = H - y
        }
        paint_band(y, hh, report)
        first = false
        y = y + hh
    }
    let _f: u64 = wlibc.sys3w(wlibc.WM_FLUSH, w_h, 0, 0)
}
