profile app

export { compute, cols, rows, card_w, card_h, tile_w, tile_h, content_w, content_h, entry_w, per_page, per_page_up, update_tile_w, side_w }

const NAV_COLUMN_W: u64 = 68
const SIDE_GAP: u64 = 8
const FRAME_H: u64 = 8
const COLUMN_PAD: u64 = 16
const ROW_GAP: u64 = 12
const MIN_CARD_W: u64 = 224
const MIN_CARD_H: u64 = 112
const MAX_CARD_H: u64 = 156
const GRID_OVERHEAD: u64 = 236
const UPDATE_OVERHEAD: u64 = 222
const UPDATE_ROW_H: u64 = 60
const UPDATE_ACTION_W: u64 = 158
const TILE_INSET_W: u64 = 24
const TILE_INSET_H: u64 = 58
const ENTRY_MAX_W: u64 = 420
const MAX_SLOTS: u64 = 20
const MAX_COLS: u64 = 5

static mut g_cols: u64 = 3
static mut g_rows: u64 = 3
static mut g_card_w: u64 = 240
static mut g_card_h: u64 = 128
static mut g_content_w: u64 = 744
static mut g_content_h: u64 = 552
static mut g_update_rows: u64 = 5

fn sat(a: u64, b: u64) -> u64 {
    if a > b {
        return a - b
    }
    return 0
}

fn clamp(v: u64, lo: u64, hi: u64) -> u64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn compute(win_w: u64, win_h: u64, info_h: u64) {
    g_content_w = sat(win_w, NAV_COLUMN_W + SIDE_GAP)
    g_content_h = sat(win_h, FRAME_H + info_h)
    let inner_w: u64 = sat(g_content_w, 2 * COLUMN_PAD)
    g_cols = clamp((inner_w + ROW_GAP) / (MIN_CARD_W + ROW_GAP), 1, MAX_COLS)
    g_card_w = sat(inner_w, (g_cols - 1) * ROW_GAP) / g_cols
    let avail_h: u64 = sat(g_content_h, GRID_OVERHEAD)
    g_rows = clamp((avail_h + ROW_GAP) / (MIN_CARD_H + ROW_GAP), 1, MAX_SLOTS)
    while g_cols * g_rows > MAX_SLOTS {
        g_rows = g_rows - 1
    }
    g_card_h = clamp(sat(avail_h, (g_rows - 1) * ROW_GAP) / g_rows, MIN_CARD_H, MAX_CARD_H)
    g_update_rows = clamp(sat(g_content_h, UPDATE_OVERHEAD) / UPDATE_ROW_H, 3, MAX_SLOTS)
}

fn cols() -> u64 {
    return g_cols
}

fn rows() -> u64 {
    return g_rows
}

fn card_w() -> u64 {
    return g_card_w
}

fn card_h() -> u64 {
    return g_card_h
}

fn tile_w() -> u64 {
    return sat(g_card_w, TILE_INSET_W)
}

fn tile_h() -> u64 {
    return sat(g_card_h, TILE_INSET_H)
}

fn content_w() -> u64 {
    return g_content_w
}

fn content_h() -> u64 {
    return g_content_h
}

fn side_w() -> u64 {
    return sat(g_content_w, 2 * COLUMN_PAD)
}

fn entry_w() -> u64 {
    return clamp(side_w(), 1, ENTRY_MAX_W)
}

fn per_page() -> u64 {
    return g_cols * g_rows
}

fn per_page_up() -> u64 {
    return g_update_rows
}

fn update_tile_w() -> u64 {
    return sat(side_w(), UPDATE_ACTION_W + 8)
}
