profile app

import fuiapp.hosthead
import fuiapp.hostwin
import fuiscene
import uikit.uiscale
import uitheme
import ulib

export { MAX_SLOTS, MAX_W, MAX_H, box_w, box_h, prepare, refresh, paint, ready, acquire, release }

const MAX_SLOTS: u64 = 5
const MAX_W: u64 = 200
const MAX_H: u64 = 130
const MIN_W: u64 = 96
const MIN_H: u64 = 64
const HOVER_FILL_ALPHA: u64 = 96
const HOVER_RING_ALPHA: u64 = 255
const HOVER_RING_PX: u64 = 2
const MAX_PIXEL_SCALE: u64 = 2
const BYTES_PER_PIXEL: u64 = 4
const SLOT_BYTES: u64 = MAX_W * MAX_PIXEL_SCALE * MAX_H * MAX_PIXEL_SCALE * BYTES_PER_PIXEL
const POOL_BYTES: u64 = SLOT_BYTES * MAX_SLOTS
const SYS_MUNMAP: u64 = 11

static mut pool: u64 = 0
static mut win_id: [u64; 5] = [0 as u64; 5]
static mut px_w: [u64; 5] = [0 as u64; 5]
static mut px_h: [u64; 5] = [0 as u64; 5]
static mut got: [u64; 5] = [0 as u64; 5]
static mut box_dw: [u64; 5] = [0 as u64; 5]
static mut box_dh: [u64; 5] = [0 as u64; 5]

fn slot_ptr(i: u64) -> u64 {
    return pool + i * SLOT_BYTES
}

fn acquire() -> bool {
    if pool != 0 {
        return true
    }
    let p: u64 = hosthead.map_surface(POOL_BYTES)
    if ulib.bad(p) {
        return false
    }
    pool = p
    return true
}

fn release() {
    if pool == 0 {
        return
    }
    let _u: u64 = ulib.sys(SYS_MUNMAP, pool, POOL_BYTES, 0)
    pool = 0
    var i: u64 = 0
    while i < MAX_SLOTS {
        got[i as usize] = 0
        i = i + 1
    }
}

fn pixel_pct() -> u64 {
    let p: u64 = uiscale.pct()
    if p > MAX_PIXEL_SCALE * 100 {
        return MAX_PIXEL_SCALE * 100
    }
    return p
}

fn thumb_px(points: u64) -> u64 {
    return (points * pixel_pct() + 50) / 100
}

fn box_w(i: u64) -> u64 {
    return box_dw[i as usize]
}

fn box_h(i: u64) -> u64 {
    return box_dh[i as usize]
}

fn size_box(i: u64, ww: u64, wh: u64) {
    var bw: u64 = MAX_W
    var bh: u64 = MAX_H
    if ww != 0 && wh != 0 {
        if ww * MAX_H >= wh * MAX_W {
            bh = wh * MAX_W / ww
        } else {
            bw = ww * MAX_H / wh
        }
    }
    if bw < MIN_W {
        bw = MIN_W
    }
    if bh < MIN_H {
        bh = MIN_H
    }
    box_dw[i as usize] = bw
    box_dh[i as usize] = bh
}

fn fit(i: u64, ww: u64, wh: u64) {
    let box_pw: u64 = thumb_px(box_dw[i as usize])
    let box_ph: u64 = thumb_px(box_dh[i as usize])
    var tw: u64 = box_pw
    var th: u64 = box_pw
    if wh != 0 && ww != 0 {
        th = wh * box_pw / ww
    }
    if th > box_ph || ww == 0 || wh == 0 {
        th = box_ph
        tw = box_ph
        if wh != 0 {
            tw = ww * box_ph / wh
        }
    }
    if tw == 0 {
        tw = 1
    }
    if th == 0 {
        th = 1
    }
    px_w[i as usize] = tw
    px_h[i as usize] = th
}

fn capture(i: u64) {
    if pool == 0 {
        return
    }
    let rc: u64 = hostwin.win_thumb(win_id[i as usize], slot_ptr(i),
        px_w[i as usize], px_h[i as usize])
    got[i as usize] = 0
    if !ulib.bad(rc) {
        got[i as usize] = 1
    }
}

fn prepare(i: u64, id: u64, ww: u64, wh: u64) {
    if i >= MAX_SLOTS {
        return
    }
    win_id[i as usize] = id
    size_box(i, ww, wh)
    fit(i, ww, wh)
    capture(i)
}

fn refresh(n: u64) {
    var i: u64 = 0
    while i < n && i < MAX_SLOTS {
        capture(i)
        i = i + 1
    }
}

fn ready(i: u64) -> bool {
    return pool != 0 && i < MAX_SLOTS && got[i as usize] != 0
}

fn paint_hover(x: u64, y: u64, w: u64, h: u64) {
    let r: u64 = fuiscene.rb_px()
    fuiscene.cv_round_a(x, y, w, h, r, uitheme.theme(uitheme.T_BTNHI), HOVER_FILL_ALPHA)
    fuiscene.cv_ring_a(x, y, w, h, r, uiscale.sp(HOVER_RING_PX), uitheme.theme(uitheme.T_ACCENT),
        HOVER_RING_ALPHA)
}

fn paint(i: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    var plate: u64 = uitheme.theme(uitheme.T_BTN)
    if (st & fuiscene.TS_DOWN) != 0 {
        plate = uitheme.theme(uitheme.T_BTNDN)
    }
    fuiscene.cv_round_rgb(x, y, w, h, fuiscene.rb_px(), plate)
    if ready(i) {
        let tw: u64 = px_w[i as usize]
        let th: u64 = px_h[i as usize]
        fuiscene.cv_image(slot_ptr(i), tw, th, x + (w - tw) / 2, y + (h - th) / 2, tw, th)
    }
    if (st & (fuiscene.TS_HOT | fuiscene.TS_DOWN)) != 0 {
        paint_hover(x, y, w, h)
    }
}
