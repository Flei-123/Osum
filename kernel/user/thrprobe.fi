profile app

import ulib
import libc.threadprobe
import libc.syncprobe
import libc.rwprobe
import libc.pthreadprobe
import libc.pthreadxprobe
import libc.pthreadyprobe
import libc.threadlatency

export { u_start }

fn u_start(args: u64) -> u64 {
    var passed_label: [u8; 17] = "thrprobe passed=\0"
    var failed_label: [u8; 17] = "thrprobe failed=\0"
    var done_label: [u8; 14] = "thrprobe done\0"
    var latency_label: [u8; 24] = "thrprobe latency_ticks=\0"
    var latency_bad: [u8; 21] = "thrprobe latency bad\0"
    var failed: u64 = threadprobe.run_all()
    failed = syncprobe.run_all()
    failed = rwprobe.run_all()
    failed = pthreadprobe.run_all()
    failed = pthreadxprobe.run_all()
    failed = pthreadyprobe.run_all()
    let latency_ok: bool = threadlatency.join_latency_ok()
    ulib.say_line((&latency_label[0]) as u64, threadlatency.worst_ticks())
    if !latency_ok {
        ulib.say((&latency_bad[0]) as u64)
        ulib.nl()
        failed = failed + 1
    }
    ulib.say_line((&passed_label[0]) as u64, syncprobe.passed_count())
    ulib.say_line((&failed_label[0]) as u64, failed)
    ulib.say((&done_label[0]) as u64)
    ulib.nl()
    return failed
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
