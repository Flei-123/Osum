profile app

import ulib
import libc.threadprobe

export { u_start }

fn u_start(args: u64) -> u64 {
    var passed_label: [u8; 17] = "thrprobe passed=\0"
    var failed_label: [u8; 17] = "thrprobe failed=\0"
    var done_label: [u8; 14] = "thrprobe done\0"
    let failed: u64 = threadprobe.run_all()
    ulib.say_line((&passed_label[0]) as u64, threadprobe.passed_count())
    ulib.say_line((&failed_label[0]) as u64, failed)
    ulib.say((&done_label[0]) as u64)
    ulib.nl()
    return failed
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
