profile kernel

import ulib
import pw
import grp
import xfxio
import xfxpath
import xfxproc
import xfxpack

export { start, stop }

const SYS_SETUID: u64 = 105
const SYS_SETGID: u64 = 106
const SYS_GETEUID: u64 = 107
const SYS_CHOWN: u64 = 92
const SYS_CHMOD: u64 = 90
const O_LOG: u64 = 1089
const FMODE: u64 = 420
const DMODE: u64 = 448

fn sock_path(uid: u64, out: u64) {
    var p_sock: [u8; 11] = "/wayland-0\0"
    var t: [u8; 24] = [0 as u8; 24]
    ulib.strcpy(out, xfxpath.p_run())
    xfxio.num_text(uid, (&t[0 as usize]) as u64)
    ulib.strcat(out, (&t[0 as usize]) as u64)
    ulib.strcat(out, (&p_sock[0 as usize]) as u64)
}

fn prep_child(name: u64, uid: u64, gid: u64, home: u64) -> u64 {
    var s_x: [u8; 6] = "/.xfx\0"
    var s_p: [u8; 9] = "/profile\0"
    var s_j: [u8; 9] = "/user.js\0"
    var d1: [u8; 200] = [0 as u8; 200]
    var d2: [u8; 224] = [0 as u8; 224]
    var js: [u8; 240] = [0 as u8; 240]
    var buf: [u8; 4096] = [0 as u8; 4096]
    grp.initgroups(name)
    ulib.sys(SYS_SETGID, gid, 0, 0)
    if ulib.bad(ulib.sys(SYS_SETUID, uid, 0, 0)) || ulib.sys(SYS_GETEUID, 0, 0, 0) != uid {
        return 3
    }
    ulib.strcpy((&d1[0 as usize]) as u64, home)
    ulib.strcat((&d1[0 as usize]) as u64, (&s_x[0 as usize]) as u64)
    ulib.sys(ulib.SYS_MKDIR, (&d1[0 as usize]) as u64, DMODE, 0)
    if !ulib.is_dir((&d1[0 as usize]) as u64) {
        return 4
    }
    ulib.strcpy((&d2[0 as usize]) as u64, (&d1[0 as usize]) as u64)
    ulib.strcat((&d2[0 as usize]) as u64, (&s_p[0 as usize]) as u64)
    ulib.sys(ulib.SYS_MKDIR, (&d2[0 as usize]) as u64, DMODE, 0)
    if !ulib.is_dir((&d2[0 as usize]) as u64) {
        return 4
    }
    ulib.strcpy((&js[0 as usize]) as u64, (&d2[0 as usize]) as u64)
    ulib.strcat((&js[0 as usize]) as u64, (&s_j[0 as usize]) as u64)
    if xfxio.read_text(xfxpath.p_js(), (&buf[0 as usize]) as u64, 4096) == ulib.EOF {
        return 5
    }
    if !xfxio.write_text((&js[0 as usize]) as u64, (&buf[0 as usize]) as u64, ulib.O_MAKE) {
        return 6
    }
    return 0
}

fn start() -> u64 {
    var e_root: [u8; 15] = "xfx: root only\0"
    var e_inst: [u8; 19] = "xfx: not installed\0"
    var e_run: [u8; 21] = "xfx: already running\0"
    var e_ses: [u8; 34] = "xfx: no desktop session, refusing\0"
    var e_gid: [u8; 31] = "xfx: session user has no group\0"
    var e_prep: [u8; 37] = "xfx: cannot prepare the user profile\0"
    var e_spawn: [u8; 18] = "xfx: cannot start\0"
    var e_sock: [u8; 26] = "xfx: wayd did not come up\0"
    var e_dead: [u8; 48] = "xfx: firefox exited early, see /var/log/xfx.log\0"
    var e_uid: [u8; 56] = "xfx: firefox is not running as the session user, killed\0"
    var m_ok: [u8; 14] = "xfx: started \0"
    var k_uid: [u8; 5] = "uid=\0"
    var k_home: [u8; 6] = "HOME=\0"
    var k_xdg: [u8; 17] = "XDG_RUNTIME_DIR=\0"
    var k_way: [u8; 17] = "WAYLAND_DISPLAY=\0"
    var s_prof: [u8; 14] = "/.xfx/profile\0"
    var a_nr: [u8; 12] = "--no-remote\0"
    var a_pr: [u8; 10] = "--profile\0"
    var a_bl: [u8; 12] = "about:blank\0"
    var a_wd: [u8; 5] = "wayd\0"
    var a_ms: [u8; 11] = "2000000000\0"
    var a_z: [u8; 2] = "0\0"
    var f1: [u8; 21] = "MOZ_ENABLE_WAYLAND=1\0"
    var f2: [u8; 20] = "GDK_BACKEND=wayland\0"
    var f3: [u8; 30] = "MOZ_DISABLE_CONTENT_SANDBOX=1\0"
    var f4: [u8; 28] = "MOZ_CRASHREPORTER_DISABLE=1\0"
    var f5: [u8; 26] = "MOZ_DISABLE_RDD_SANDBOX=1\0"
    var f6: [u8; 26] = "MOZ_DISABLE_GMP_SANDBOX=1\0"
    var f7: [u8; 38] = "FONTCONFIG_FILE=/etc/fonts/fonts.conf\0"
    if !xfxio.is_root() {
        xfxio.msg((&e_root[0 as usize]) as u64)
        return 1
    }
    if !xfxpack.installed() {
        xfxio.msg((&e_inst[0 as usize]) as u64)
        return 1
    }
    if xfxproc.proc_ok(xfxio.pid_field(xfxpath.p_pidf(), 0), xfxpath.n_fx()) {
        xfxio.msg((&e_run[0 as usize]) as u64)
        return 1
    }
    var name: [u8; 64] = [0 as u8; 64]
    var home: [u8; 120] = [0 as u8; 120]
    let uid: u64 = ulib.session_owner()
    if uid == 0 || !pw.name_of_uid(uid, (&name[0 as usize]) as u64, 64) || !pw.home_of_name((&name[0 as usize]) as u64, (&home[0 as usize]) as u64, 120) || home[0 as usize] != 47 as u8 {
        xfxio.msg((&e_ses[0 as usize]) as u64)
        return 1
    }
    let gid: u64 = pw.gid_of_name((&name[0 as usize]) as u64)
    if gid == ulib.EOF {
        xfxio.msg((&e_gid[0 as usize]) as u64)
        return 1
    }
    var rd: [u8; 48] = [0 as u8; 48]
    var sock: [u8; 80] = [0 as u8; 80]
    var t: [u8; 24] = [0 as u8; 24]
    ulib.strcpy((&rd[0 as usize]) as u64, xfxpath.p_run())
    xfxio.num_text(uid, (&t[0 as usize]) as u64)
    ulib.strcat((&rd[0 as usize]) as u64, (&t[0 as usize]) as u64)
    ulib.sys(ulib.SYS_MKDIR, (&rd[0 as usize]) as u64, DMODE, 0)
    ulib.sys(SYS_CHOWN, (&rd[0 as usize]) as u64, uid, gid)
    ulib.sys(SYS_CHMOD, (&rd[0 as usize]) as u64, DMODE, 0)
    sock_path(uid, (&sock[0 as usize]) as u64)
    ulib.sys(ulib.SYS_UNLINK, (&sock[0 as usize]) as u64, 0, 0)
    let pk: u64 = ulib.sys(ulib.SYS_FORK, 0, 0, 0)
    if pk == 0 {
        ulib.sys(ulib.SYS_EXIT, prep_child((&name[0 as usize]) as u64, uid, gid, (&home[0 as usize]) as u64), 0, 0)
    }
    if ulib.bad(pk) || ulib.wait_code(pk) != 0 {
        xfxio.msg((&e_prep[0 as usize]) as u64)
        return 1
    }
    var env: [u8; 1024] = [0 as u8; 1024]
    var kv: [u8; 240] = [0 as u8; 240]
    var at: u64 = 0
    ulib.strcpy((&kv[0 as usize]) as u64, (&k_home[0 as usize]) as u64)
    ulib.strcat((&kv[0 as usize]) as u64, (&home[0 as usize]) as u64)
    at = xfxio.env_put((&env[0 as usize]) as u64, at, (&kv[0 as usize]) as u64)
    ulib.strcpy((&kv[0 as usize]) as u64, (&k_xdg[0 as usize]) as u64)
    ulib.strcat((&kv[0 as usize]) as u64, (&rd[0 as usize]) as u64)
    at = xfxio.env_put((&env[0 as usize]) as u64, at, (&kv[0 as usize]) as u64)
    ulib.strcpy((&kv[0 as usize]) as u64, (&k_way[0 as usize]) as u64)
    ulib.strcat((&kv[0 as usize]) as u64, (&sock[0 as usize]) as u64)
    at = xfxio.env_put((&env[0 as usize]) as u64, at, (&kv[0 as usize]) as u64)
    at = xfxio.env_put((&env[0 as usize]) as u64, at, (&f1[0 as usize]) as u64)
    at = xfxio.env_put((&env[0 as usize]) as u64, at, (&f2[0 as usize]) as u64)
    at = xfxio.env_put((&env[0 as usize]) as u64, at, (&f3[0 as usize]) as u64)
    at = xfxio.env_put((&env[0 as usize]) as u64, at, (&f4[0 as usize]) as u64)
    at = xfxio.env_put((&env[0 as usize]) as u64, at, (&f5[0 as usize]) as u64)
    at = xfxio.env_put((&env[0 as usize]) as u64, at, (&f6[0 as usize]) as u64)
    at = xfxio.env_put((&env[0 as usize]) as u64, at, (&f7[0 as usize]) as u64)
    var prof: [u8; 240] = [0 as u8; 240]
    ulib.strcpy((&prof[0 as usize]) as u64, (&home[0 as usize]) as u64)
    ulib.strcat((&prof[0 as usize]) as u64, (&s_prof[0 as usize]) as u64)
    let s1: u64 = ulib.sys(ulib.SYS_DUP, 1, 0, 0)
    let s2: u64 = ulib.sys(ulib.SYS_DUP, 2, 0, 0)
    let lf: u64 = ulib.sys(ulib.SYS_OPEN, xfxpath.p_log(), O_LOG, FMODE)
    if !ulib.bad(lf) {
        ulib.sys(ulib.SYS_DUP2, lf, 1, 0)
        ulib.sys(ulib.SYS_DUP2, lf, 2, 0)
        ulib.sys(ulib.SYS_CLOSE, lf, 0, 0)
    }
    ulib.set_env((&env[0 as usize]) as u64, at)
    var wv: [u64; 5] = [0 as u64; 5]
    wv[0] = (&a_wd[0 as usize]) as u64
    wv[1] = (&sock[0 as usize]) as u64
    wv[2] = (&a_ms[0 as usize]) as u64
    wv[3] = (&a_z[0 as usize]) as u64
    let wpid: u64 = ulib.spawn_user(xfxpath.p_wayd(), (&wv[0 as usize]) as u64, 4)
    var up: bool = false
    var fpid: u64 = ulib.EOF
    if !ulib.bad(wpid) {
        var i: u64 = 0
        while i < 80 && !up {
            up = xfxio.exists((&sock[0 as usize]) as u64)
            if !up {
                ulib.sleep_ms(100)
            }
            i = i + 1
        }
        if up {
            var fv: [u64; 6] = [0 as u64; 6]
            fv[0] = xfxpath.p_fx()
            fv[1] = (&a_nr[0 as usize]) as u64
            fv[2] = (&a_pr[0 as usize]) as u64
            fv[3] = (&prof[0 as usize]) as u64
            fv[4] = (&a_bl[0 as usize]) as u64
            fpid = ulib.spawn_user(xfxpath.p_fx(), (&fv[0 as usize]) as u64, 5)
        }
    }
    ulib.set_env(0, 0)
    ulib.sys(ulib.SYS_DUP2, s1, 1, 0)
    ulib.sys(ulib.SYS_DUP2, s2, 2, 0)
    ulib.sys(ulib.SYS_CLOSE, s1, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, s2, 0, 0)
    if ulib.bad(wpid) || ulib.bad(fpid) {
        if !ulib.bad(wpid) {
            ulib.sys(ulib.SYS_KILL, wpid, 143, 0)
            xfxio.msg((&e_sock[0 as usize]) as u64)
        } else {
            xfxio.msg((&e_spawn[0 as usize]) as u64)
        }
        return 1
    }
    ulib.sleep_ms(1500)
    if xfxproc.find_slot(fpid) == ulib.EOF {
        ulib.sys(ulib.SYS_KILL, wpid, 143, 0)
        xfxio.msg((&e_dead[0 as usize]) as u64)
        return 1
    }
    if xfxproc.proc_uid(fpid) != uid || xfxproc.proc_uid(wpid) != uid {
        ulib.sys(ulib.SYS_KILL, fpid, 143, 0)
        ulib.sys(ulib.SYS_KILL, wpid, 143, 0)
        xfxio.msg((&e_uid[0 as usize]) as u64)
        return 1
    }
    xfxio.store_pid(xfxpath.p_pidw(), wpid, uid)
    xfxio.store_pid(xfxpath.p_pidf(), fpid, uid)
    ulib.say((&m_ok[0 as usize]) as u64)
    ulib.say((&k_uid[0 as usize]) as u64)
    ulib.sayu(uid)
    ulib.nl()
    return 0
}

fn stop() -> u64 {
    var e_root: [u8; 15] = "xfx: root only\0"
    var m_stop: [u8; 13] = "xfx: stopped\0"
    var sock: [u8; 80] = [0 as u8; 80]
    if !xfxio.is_root() {
        xfxio.msg((&e_root[0 as usize]) as u64)
        return 1
    }
    let uid: u64 = xfxio.pid_field(xfxpath.p_pidw(), 1)
    xfxproc.kill_pid(xfxpath.p_pidf(), xfxpath.n_fx())
    xfxproc.kill_pid(xfxpath.p_pidw(), xfxpath.n_wayd())
    if uid != 0 {
        sock_path(uid, (&sock[0 as usize]) as u64)
        ulib.sys(ulib.SYS_UNLINK, (&sock[0 as usize]) as u64, 0, 0)
    }
    xfxio.msg((&m_stop[0 as usize]) as u64)
    return 0
}
