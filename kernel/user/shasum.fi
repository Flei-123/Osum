// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/shasum.fi -- SHA-256 of files, one line each, like
// `sha256sum`:
//
//     shasum <file> [<file> ...]
//     -> <64 hex digits>  <file>
//
// Why it exists (27.09.2026): the Dell is updated from a distance --
// `fetch` writes the new kernel and root image onto the stick's EFI
// partition, and before the boot menu is switched over, the files are
// READ BACK and hashed here. `fetch`'s own `bodysha` is the hash of what
// came over the wire, not of what landed on the stick.

profile kernel

import ulib
import sha

export { u_start }

static mut dig: [u8; 32] = [0 as u8; 32]
static mut hex: [u8; 65] = [0 as u8; 65]
static mut buf: [u8; 4096] = [0 as u8; 4096]

fn u_start(args: u64) -> u64 {
    var s_open: [u8; 21] = "shasum: cannot open \0"
    var s_use: [u8; 32] = "usage: shasum <file> [<file>]\n\0\0"
    var s_sp: [u8; 3] = "  \0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.say((&s_use[0 as usize]) as u64)
        return 2
    }
    var code: u64 = 0
    var k: u64 = 1
    while k < argc {
        let p: u64 = ulib.arg_at(args, k)
        let fd: u64 = ulib.sys(ulib.SYS_OPEN, p, 0, 0)
        if ulib.bad(fd) {
            ulib.esay_line((&s_open[0 as usize]) as u64, p)
            code = 1
        } else {
            sha.begin()
            var going: bool = true
            while going {
                let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&buf[0 as usize]) as u64, 4096)
                if n == 0 || ulib.bad(n) {
                    going = false
                } else {
                    sha.update((&buf[0 as usize]) as u64, n)
                }
            }
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
            sha.finish((&dig[0 as usize]) as u64)
            sha.hex_out((&dig[0 as usize]) as u64, 32, (&hex[0 as usize]) as u64)
            ulib.say((&hex[0 as usize]) as u64)
            ulib.say((&s_sp[0 as usize]) as u64)
            ulib.say(p)
            ulib.nl()
        }
        k = k + 1
    }
    return code
}
