
profile kernel

import ulib
import codec.b64

export { u_start }

const SYS_WGGET: u64 = 1950
const SYS_WGSET: u64 = 1951

const WG_READY: u64 = 0
const WG_UP: u64 = 1
const WG_PEERS: u64 = 2
const WG_HANDSHAKES: u64 = 3
const WG_KILLED: u64 = 4
const WG_KILLARMED: u64 = 5
const WG_PORT: u64 = 6
const WG_PUBLIC: u64 = 8

const WS_INIT: u64 = 0
const WS_CLEAR: u64 = 1
const WS_PRIVATE: u64 = 2
const WS_PEER: u64 = 3
const WS_ALLOW: u64 = 4
const WS_ENDPOINT: u64 = 5
const WS_KEEPALIVE: u64 = 7
const WS_ADDR: u64 = 8
const WS_UP: u64 = 9
const WS_KILL: u64 = 10

fn wgget(field: u64, ptr: u64, len: u64) -> i64 {
    return ulib.sys(SYS_WGGET, field, ptr, len) as i64
}

fn wgset(field: u64, ptr: u64, n: u64) -> i64 {
    return ulib.sys(SYS_WGSET, field, ptr, n) as i64
}

fn b64_key(src: u64, dst: u64) -> bool {
    return b64.b64_decode_cap(src, 44, dst, 32, false) == 32
}

fn b64_encode(src: u64, dst: u64) {
    let n: u64 = b64.b64_encode_opt(src, 32, dst, true)
    __mmio_write8((dst + n) as *mut u8, 0 as u8)
}

fn show() {
    var s_aus: [u8; 42] = "vpn: kein Tunnel in diesem Kern (-ENODEV)\0"
    var s_ready: [u8; 26] = "vpn: eingerichtet, aus\0\0\0\0"
    var s_an: [u8; 14] = "vpn: läuft\0\0\0"
    var s_empty: [u8; 30] = "vpn: nicht eingerichtet\0\0\0\0\0\0\0"
    var s_peer: [u8; 16] = "  Gegenstellen \0"
    var s_hs: [u8; 17] = "  Handschläge  \0"
    var s_port: [u8; 16] = "  Port         \0"
    var s_kill: [u8; 16] = "  Notaus       \0"
    var s_koct: [u8; 16] = "  verworfen    \0"

    let r: i64 = wgget(WG_READY, 0, 0)
    if r < 0 {
        ulib.say((&s_aus[0]) as u64)
        ulib.nl()
        return
    }
    if r == 0 {
        ulib.say((&s_empty[0]) as u64)
        ulib.nl()
        return
    }
    if wgget(WG_UP, 0, 0) == 1 {
        ulib.say((&s_an[0]) as u64)
        ulib.nl()
    } else {
        ulib.say((&s_ready[0]) as u64)
        ulib.nl()
    }
    ulib.say((&s_peer[0]) as u64)
    ulib.sayu(wgget(WG_PEERS, 0, 0) as u64)
    ulib.nl()
    ulib.say((&s_hs[0]) as u64)
    ulib.sayu(wgget(WG_HANDSHAKES, 0, 0) as u64)
    ulib.nl()
    ulib.say((&s_port[0]) as u64)
    ulib.sayu(wgget(WG_PORT, 0, 0) as u64)
    ulib.nl()
    ulib.say((&s_kill[0]) as u64)
    ulib.sayu(wgget(WG_KILLARMED, 0, 0) as u64)
    ulib.nl()
    ulib.say((&s_koct[0]) as u64)
    ulib.sayu(wgget(WG_KILLED, 0, 0) as u64)
    ulib.nl()
}

fn pubkey_show() {
    var key: [u8; 32] = [0 as u8; 32]
    var txt: [u8; 48] = [0 as u8; 48]
    var s_kein: [u8; 20] = "vpn: no key set yet\0"
    if wgget(WG_PUBLIC, (&key[0]) as u64, 32) != 32 {
        ulib.say((&s_kein[0]) as u64)
        ulib.nl()
        return
    }
    b64_encode((&key[0]) as u64, (&txt[0]) as u64)
    ulib.say((&txt[0]) as u64)
    ulib.nl()
}

fn u_start(args: u64) -> u64 {
    var s_use1: [u8; 28] = "vpn [on <profile>|off|key]\0\0"
    var s_use2: [u8; 30] = "vpn notaus an|aus | vergessen\0"
    var c_an: [u8; 3] = "an\0"
    var c_aus: [u8; 4] = "aus\0"
    var c_sch: [u8; 12] = "schluessel\0\0"
    var c_sch_u: [u8; 12] = "schlüssel\0\0"
    var c_not: [u8; 7] = "notaus\0"
    var c_hilf: [u8; 6] = "hilfe\0"

    let n: u64 = ulib.arg_count(args)
    if n < 2 {
        show()
        return 0
    }
    let a1: u64 = ulib.arg_at(args, 1)
    if ulib.streq(a1, (&c_hilf[0]) as u64) {
        ulib.say((&s_use1[0]) as u64)
        ulib.nl()
        ulib.say((&s_use2[0]) as u64)
        ulib.nl()
        return 0
    }
    if ulib.streq(a1, (&c_sch[0]) as u64)
        || ulib.streq(a1, (&c_sch_u[0]) as u64) {
        pubkey_show()
        return 0
    }
    if ulib.streq(a1, (&c_aus[0]) as u64) {
        var arg: [u64; 1] = [0 as u64; 1]
        arg[0] = 0
        var s_ok: [u8; 13] = "vpn: aus\0\0\0\0\0"
        var s_no: [u8; 22] = "vpn: that failed\0\0\0\0\0\0"
        if wgset(WS_UP, (&arg[0]) as u64, 1) == 0 {
            ulib.say((&s_ok[0]) as u64)
            ulib.nl()
        } else {
            ulib.say((&s_no[0]) as u64)
            ulib.nl()
        }
        return 0
    }
    if ulib.streq(a1, (&c_not[0]) as u64) && n >= 3 {
        var arg: [u64; 1] = [0 as u64; 1]
        var s_ok: [u8; 22] = "vpn: Notaus gesetzt\0\0\0"
        var s_no: [u8; 22] = "vpn: that failed\0\0\0\0\0\0"
        arg[0] = 0
        if ulib.streq(ulib.arg_at(args, 2), (&c_an[0]) as u64) {
            arg[0] = 1
        }
        if wgset(WS_KILL, (&arg[0]) as u64, 1) == 0 {
            ulib.say((&s_ok[0]) as u64)
            ulib.nl()
        } else {
            ulib.say((&s_no[0]) as u64)
            ulib.nl()
        }
        return 0
    }
    ulib.say((&s_use1[0]) as u64)
    ulib.nl()
    ulib.say((&s_use2[0]) as u64)
    ulib.nl()
    return 0
}
