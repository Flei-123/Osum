// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/termfull.fi -- the error window of /bin/term (r530).
//
// /bin/term asks the kernel for a new terminal window (SYS_OSUM_TERMNEW). When no tty slot or no window is left the call
// fails; before, the only trace was a line on the serial console and nothing happened on the screen. term then executes this
// program: a small window "No terminal free" with the reason and an OK button. It ends on OK or on its close button.

profile app

import ulib
import fuiscene
import msg

export { u_start }

static mut k_ft: [u8; 16] = "term.full.title\0"
static mut k_fx: [u8; 15] = "term.full.text\0"
static mut k_fo: [u8; 13] = "term.full.ok\0"
static mut t_shown: [u8; 24] = "termfull: window shown\n\0"

fn build() {
    let col: usize = fuiscene.root()
    let _l: usize = fuiscene.label_wrap(col, msg.get((&k_fx[0 as usize]) as u64), 3)
    let _b: usize = fuiscene.button(col, msg.get((&k_fo[0 as usize]) as u64), 1)
}

fn u_start(args: u64) -> u64 {
    if !fuiscene.open(260, 200, 440, 170, msg.get((&k_ft[0 as usize]) as u64), build) {
        return 1
    }
    let _s: u64 = ulib.say((&t_shown[0 as usize]) as u64)
    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        if key == 1 {
            fuiscene.quit()
        }
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
