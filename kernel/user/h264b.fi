profile kernel

export {
    SHAPE_16X16, SHAPE_16X8, SHAPE_8X16, SHAPE_8X8, SHAPE_DIRECT,
    MODE_L0, MODE_L1, MODE_BI, MODE_DIRECT,
    bmb_shape, bmb_mode, bsub_mode, bsub_shape, uses_l0, uses_l1,
    poc_msb, implicit_w1
}

const SHAPE_16X16: u64 = 0
const SHAPE_16X8: u64 = 1
const SHAPE_8X16: u64 = 2
const SHAPE_8X8: u64 = 3
const SHAPE_DIRECT: u64 = 4

const MODE_L0: u64 = 0
const MODE_L1: u64 = 1
const MODE_BI: u64 = 2
const MODE_DIRECT: u64 = 3

static mut PAIR_FIRST: [u64; 9] = [0, 1, 0, 1, 0, 1, 2, 2, 2]
static mut PAIR_SECOND: [u64; 9] = [0, 1, 1, 0, 2, 2, 0, 1, 2]
static mut SUB_MODE: [u64; 13] = [3, 0, 1, 2, 0, 0, 1, 1, 2, 2, 0, 1, 2]
static mut SUB_SHAPE: [u64; 13] = [0, 0, 0, 0, 1, 2, 1, 2, 1, 2, 3, 3, 3]

fn bmb_shape(t: u64) -> u64 {
    if t == 0 { return SHAPE_DIRECT }
    if t <= 3 { return SHAPE_16X16 }
    if t == 22 { return SHAPE_8X8 }
    if (t & 1) == 0 { return SHAPE_16X8 }
    return SHAPE_8X16
}

fn bmb_mode(t: u64, part: u64) -> u64 {
    if t <= 3 { return t - 1 }
    let k: u64 = (t - 4) / 2
    if part == 0 { return PAIR_FIRST[(k) as usize] }
    return PAIR_SECOND[(k) as usize]
}

fn bsub_mode(st: u64) -> u64 { return SUB_MODE[(st) as usize] }

fn bsub_shape(st: u64) -> u64 { return SUB_SHAPE[(st) as usize] }

fn uses_l0(mode: u64) -> bool { return mode == MODE_L0 || mode == MODE_BI }

fn uses_l1(mode: u64) -> bool { return mode == MODE_L1 || mode == MODE_BI }

fn poc_msb(prev_msb: i64, prev_lsb: i64, lsb: i64, max_lsb: i64) -> i64 {
    if lsb < prev_lsb && prev_lsb - lsb >= max_lsb / 2 { return prev_msb + max_lsb }
    if lsb > prev_lsb && lsb - prev_lsb > max_lsb / 2 { return prev_msb - max_lsb }
    return prev_msb
}

fn clip_i(lo: i64, hi: i64, v: i64) -> i64 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn implicit_w1(cur: i64, poc0: i64, poc1: i64) -> i64 {
    let diff: i64 = poc1 - poc0
    if diff == 0 { return 32 }
    let tb: i64 = clip_i(-128, 127, cur - poc0)
    let td: i64 = clip_i(-128, 127, diff)
    var half: i64 = td / 2
    if half < 0 { half = 0 - half }
    let tx: i64 = (16384 + half) / td
    let scale: i64 = clip_i(-1024, 1023, (tb * tx + 32) >> 6)
    let w1: i64 = scale >> 2
    if w1 < -64 || w1 > 128 { return 32 }
    return w1
}
