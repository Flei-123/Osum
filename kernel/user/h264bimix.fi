profile kernel

import libc.octets
import libc.regio

export { bimix_save, bimix_blend }

const ROW: u64 = 16

static mut saved: [u8; 256] = [0 as u8; 256]

fn clip255(v: i64) -> i64 {
    if v < 0 { return 0 }
    if v > 255 { return 255 }
    return v
}

fn bimix_save(base: u64, stride: u64, x: u64, y: u64, w: u64, h: u64) {
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            saved[((r * ROW + c)) as usize] = octets.ld8(base, (y + r) * stride + x + c) as u8
            c = c + 1
        }
        r = r + 1
    }
}

fn bimix_blend(base: u64, stride: u64, x: u64, y: u64, w: u64, h: u64, w1: i64) {
    let w0: i64 = 64 - w1
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let a: i64 = saved[((r * ROW + c)) as usize] as i64
            let b: i64 = octets.ld8(base, (y + r) * stride + x + c) as i64
            let v: i64 = clip255((a * w0 + b * w1 + 32) >> 6)
            regio.write8_at(base, (y + r) * stride + x + c, v as u64)
            c = c + 1
        }
        r = r + 1
    }
}
