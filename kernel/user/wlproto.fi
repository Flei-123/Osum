const RQ_XDG_TOPLEVEL_SET_FULLSCREEN: u64 = 11
const RQ_XDG_TOPLEVEL_UNSET_FULLSCREEN: u64 = 12
const RQ_XDG_TOPLEVEL_SET_MINIMIZED: u64 = 13

// Traegt diese Anfrage einen Deskriptor?
fn req_has_fd(iface: u64, op: u64) -> bool {
    if iface == IF_WL_SHM && op == 0 {
        return true // wl_shm.create_pool
    }
    return false
}

// Wieviele Anfragen kennt diese Schnittstelle? Ein
// Opcode darueber ist ein Protokollfehler -- und genau
// das ist die Gegenprobe 'falsches Opcode-Paket'.
fn req_count(iface: u64) -> u64 {
    if iface == IF_WL_DISPLAY {
        return 2
    }
    if iface == IF_WL_REGISTRY {
        return 1
    }
    if iface == IF_WL_CALLBACK {
        return 0
    }
    if iface == IF_WL_COMPOSITOR {
        return 2
    }
    if iface == IF_WL_SHM {
        return 1
    }
    if iface == IF_WL_SHM_POOL {
        return 3
    }
    if iface == IF_WL_BUFFER {
        return 1
    }
    if iface == IF_WL_SURFACE {
        return 11
    }
    if iface == IF_WL_SEAT {
        return 4
    }
    if iface == IF_WL_KEYBOARD {
        return 1
    }
    if iface == IF_WL_POINTER {
        return 2
    }
    if iface == IF_WL_OUTPUT {
        return 1
    }
    if iface == IF_WL_REGION {
        return 3
    }
    if iface == IF_XDG_WM_BASE {
        return 4
    }
    if iface == IF_XDG_SURFACE {
        return 5
    }
    if iface == IF_XDG_TOPLEVEL {
        return 14
    }
    return 0
}

