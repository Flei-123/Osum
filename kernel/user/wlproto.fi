// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/wlproto.fi -- ERZEUGT von tools/wayland/gen.py.
//
// NICHT VON HAND AENDERN. Die Quelle sind die offiziellen
// Protokolldateien:
//   /usr/share/wayland/wayland.xml
//   /usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml
//
// Neu erzeugen:  ./tools/wayland/gen.py > kernel/user/wlproto.fi
//
// Was hier steht, sind DATEN und keine Logik: die Nummern der
// Schnittstellen, die Signaturen der Anfragen (woran der Server
// die Laenge eines Pakets misst) und die Opcodes der Ereignisse,
// die dieser Server wirklich schickt. Die Logik steht in
// kernel/user/wayd.fi.

profile kernel

export {
