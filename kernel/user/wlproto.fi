// ------------------------------------- die Schnittstellen
//
// Unsere eigene Nummerierung. Im Protokoll kommen
// Schnittstellen als ZEICHENKETTE vor (wl_registry.bind);
// der Server loest sie einmal auf und rechnet danach mit
// diesen Zahlen.
const IF_WL_DISPLAY: u64 = 0
const IF_WL_REGISTRY: u64 = 1
const IF_WL_CALLBACK: u64 = 2
const IF_WL_COMPOSITOR: u64 = 3
const IF_WL_SHM: u64 = 4
const IF_WL_SHM_POOL: u64 = 5
const IF_WL_BUFFER: u64 = 6
const IF_WL_SURFACE: u64 = 7
const IF_WL_SEAT: u64 = 8
const IF_WL_KEYBOARD: u64 = 9
const IF_WL_POINTER: u64 = 10
const IF_WL_OUTPUT: u64 = 11
const IF_WL_REGION: u64 = 12
const IF_XDG_WM_BASE: u64 = 13
const IF_XDG_SURFACE: u64 = 14
const IF_XDG_TOPLEVEL: u64 = 15
const IF_COUNT: u64 = 16
const IF_NONE: u64 = 16

// Welche Fassung dieser Server anbietet. Mehr zu
// behaupten als gebaut ist, ist die eine Luege, die ein
// Client nicht ueberlebt.
fn version_of(iface: u64) -> u64 {
    if iface == IF_WL_COMPOSITOR {
        return 4
    }
    if iface == IF_WL_SHM {
        return 1
    }
    if iface == IF_WL_SEAT {
        return 5
    }
    if iface == IF_WL_OUTPUT {
        return 2
    }
    if iface == IF_XDG_WM_BASE {
        return 3
    }
    return 1
}

// Der NAME einer Schnittstelle, wie er im Protokoll
// steht. `wl_registry.global` schickt ihn, und
// `wl_registry.bind` bringt ihn zurueck.
fn name_len(iface: u64) -> u64 {
    if iface == IF_WL_DISPLAY {
        return 10
    }
    if iface == IF_WL_REGISTRY {
        return 11
    }
    if iface == IF_WL_CALLBACK {
        return 11
    }
    if iface == IF_WL_COMPOSITOR {
        return 13
    }
    if iface == IF_WL_SHM {
        return 6
    }
    if iface == IF_WL_SHM_POOL {
        return 11
    }
    if iface == IF_WL_BUFFER {
        return 9
    }
    if iface == IF_WL_SURFACE {
        return 10
    }
    if iface == IF_WL_SEAT {
        return 7
    }
    if iface == IF_WL_KEYBOARD {
        return 11
    }
    if iface == IF_WL_POINTER {
        return 10
    }
    if iface == IF_WL_OUTPUT {
        return 9
    }
    if iface == IF_WL_REGION {
        return 9
    }
    if iface == IF_XDG_WM_BASE {
        return 11
    }
    if iface == IF_XDG_SURFACE {
        return 11
    }
    if iface == IF_XDG_TOPLEVEL {
        return 12
    }
    return 0
}

// Das i-te Oktett des Namens. Eine Tabelle aus Zeichen-
