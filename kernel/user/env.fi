
profile kernel

import ulib
import tools

export { u_start }

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc > 1 {
        let v: u64 = ulib.env_get(args, ulib.arg_at(args, 1))
        if v == 0 {
            return 1
        }
        tools.ob_str(v)
        tools.ob_nl()
        tools.ob_flush()
        return 0
    }
    var i: u64 = 0
    while i < ulib.env_count(args) {
        tools.ob_str(ulib.env_at(args, i))
        tools.ob_nl()
        i = i + 1
    }
    tools.ob_flush()
    return 0
}
