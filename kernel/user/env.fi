// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/env.fi -- Runde K11: die Umgebung, wie sie ankommt.
//
// `env` ohne Argumente schreibt jede Zeichenkette des Blocks, den der
// Kernel diesem Prozess auf die Argumentseite gelegt hat -- also genau
// das, was `export` in der Shell markiert hat. `env NAME` schreibt nur
// den Wert dazu und antwortet mit 1, wenn es ihn nicht gibt.
//
// Es setzt NICHTS. Die Form `env NAME=wert BEFEHL` gehoert zu einer
// Umgebung, die je Prozess steht; dieser Kernel hat EINEN Block, den die
// Shell fuellt (docs/ROUNDK11.md sagt, warum).

profile kernel

import ulib
import tools

export { u_start }

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc > 1 {
        let v: u64 = ulib.env_get(args, ulib.arg_at(args, 1))
        if v == 0 {
            return 1
        }
        tools.ob_str(v)
        tools.ob_nl()
        tools.ob_flush()
        return 0
    }
    var i: u64 = 0
    while i < ulib.env_count(args) {
        tools.ob_str(ulib.env_at(args, i))
        tools.ob_nl()
        i = i + 1
    }
    tools.ob_flush()
    return 0
}
