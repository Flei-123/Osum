profile kernel


export { is_protected }

const MAX_PATH: u64 = 400

static mut PROTECTED: [u8; 106] = "/\0/apps\0/bin\0/lib\0/etc\0/usr\0/users\0/boot\0/dev\0/proc\0/mnt\0/esp\0/store\0/system\0/run\0/var\0/sys\0/sysesp\0/tmp\0\0"

fn byte_at(address: u64) -> u64 {
    let value: u8 = *((address) as *mut u8)
    return value as u64
}

fn trimmed_length(path: u64) -> u64 {
    var n: u64 = 0
    while n < MAX_PATH && byte_at(path + n) != 0 {
        n = n + 1
    }
    while n > 1 && byte_at(path + n - 1) == 47 {
        n = n - 1
    }
    return n
}

fn entry_matches(path: u64, length: u64, entry: u64) -> bool {
    var i: u64 = 0
    while i < length {
        if byte_at(entry + i) != byte_at(path + i) {
            return false
        }
        i = i + 1
    }
    return byte_at(entry + length) == 0
}

fn is_protected(path: u64) -> bool {
    let length: u64 = trimmed_length(path)
    var at: u64 = 0
    while at < 106 && byte_at((&PROTECTED[0 as usize]) as u64 + at) != 0 {
        let entry: u64 = (&PROTECTED[0 as usize]) as u64 + at
        if entry_matches(path, length, entry) {
            return true
        }
        while byte_at((&PROTECTED[0 as usize]) as u64 + at) != 0 {
            at = at + 1
        }
        at = at + 1
    }
    return false
}
