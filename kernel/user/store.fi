static mut sb_buf: u64 = 0
static mut sb_at: u64 = 0
static mut sb_cap: u64 = 0

fn sb_begin(buf: u64, cap: u64) {
    sb_buf = buf
    sb_at = 0
    sb_cap = cap
    __mmio_write8(buf as *mut u8, 0 as u8)
}

fn sb_c(c: u64) {
    if sb_at + 1 < sb_cap {
        __mmio_write8((sb_buf + sb_at) as *mut u8, c as u8)
        sb_at = sb_at + 1
        __mmio_write8((sb_buf + sb_at) as *mut u8, 0 as u8)
    }
}

fn sb_s(p: u64) {
    var i: u64 = 0
    while (*((p + i) as *mut u8)) != 0 as u8 {
        sb_c((*((p + i) as *mut u8)) as u64)
        i = i + 1
    }
}

fn sb_n(v: u64) {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = text.digits(v, (&z[0 as usize]) as u64, true)
    var i: u64 = 0
    while i < n {
        sb_c(z[i as usize] as u64)
        i = i + 1
    }
}

fn sb_size(bytes: u64) {
    if bytes >= 1048576 {
        sb_n(bytes / 1048576)
        sb_s((&T_SIZE_M[0 as usize]) as u64)
    } else if bytes >= 1024 {
        sb_n(bytes / 1024)
        sb_s((&T_SIZE_K[0 as usize]) as u64)
    } else {
        sb_n(bytes)
        sb_s((&T_SIZE_B[0 as usize]) as u64)
    }
}

fn put(buf: u64, at: u64, c: u64) -> u64 {
    __mmio_write8((buf + at) as *mut u8, c as u8)
    return at + 1
}

fn puts(buf: u64, at: u64, p: u64) -> u64 {
    var i: u64 = 0
    var a: u64 = at
    while (*((p + i) as *mut u8)) != 0 as u8 {
        a = put(buf, a, (*((p + i) as *mut u8)) as u64)
        i = i + 1
    }
    return a
}

fn putn(buf: u64, at: u64, v: u64) -> u64 {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = text.digits(v, (&z[0 as usize]) as u64, true)
    var a: u64 = at
    var i: u64 = 0
    while i < n {
        a = put(buf, a, z[i as usize] as u64)
        i = i + 1
    }
    return a
}

fn set_status(a: u64, b: u64) {
    let st: u64 = (&s_status[0 as usize]) as u64
    var at: u64 = 0
    if a != 0 {
        at = puts(st, at, a)
    }
    if b != 0 {
        at = puts(st, at, b)
    }
    put(st, at, 0)
}

fn name_at(i: u64) -> u64 {
    return (&s_names[0 as usize]) as u64 + i * NAMEW
}

fn ver_at(i: u64) -> u64 {
    return name_at(i) + 24
}

fn bytes_at(i: u64) -> u64 {
    var sz: u64 = 0
    var k: u64 = name_at(i) + 36
    while (*(k as *mut u8)) >= 48 as u8 && (*(k as *mut u8)) <= 57 as u8 {
        sz = sz * 10 + ((*(k as *mut u8)) as u64 - 48)
        k = k + 1
    }
    return sz
}

fn starts(s: u64, pre: u64) -> bool {
    var i: u64 = 0
    while (*((pre + i) as *mut u8)) != 0 as u8 {
        if ascii.lower((*((s + i) as *mut u8)) as u64) != ascii.lower((*((pre + i) as *mut u8)) as u64) {
            return false
        }
        i = i + 1
    }
    return true
}

fn contains(hay: u64, needle: u64) -> bool {
    if (*(needle as *mut u8)) == 0 as u8 {
        return true
    }
    var i: u64 = 0
    while (*((hay + i) as *mut u8)) != 0 as u8 {
        if starts(hay + i, needle) {
            return true
        }
        i = i + 1
    }
    return false
}

fn meta_line(name: u64) -> u64 {
    let m: u64 = (&META[0 as usize]) as u64
    var at: u64 = 0
    while (*((m + at) as *mut u8)) != 0 as u8 {
        var i: u64 = 0
        var same: bool = true
        while (*((name + i) as *mut u8)) != 0 as u8 {
            if (*((m + at + i) as *mut u8)) != (*((name + i) as *mut u8)) {
                same = false
            }
            i = i + 1
        }
        if same && (*((m + at + i) as *mut u8)) == 124 as u8 {
            return m + at
        }
        while (*((m + at) as *mut u8)) != 10 as u8 && (*((m + at) as *mut u8)) != 0 as u8 {
            at = at + 1
        }
        if (*((m + at) as *mut u8)) == 10 as u8 {
            at = at + 1
        }
    }
    return 0
}

fn class_of(i: u64) -> u64 {
    let nm: u64 = name_at(i)
    let ln: u64 = meta_line(nm)
    if ln != 0 {
        var j: u64 = 0
        while (*((ln + j) as *mut u8)) != 124 as u8 {
            j = j + 1
        }
        return (*((ln + j + 1) as *mut u8)) as u64 - 48
    }
    if starts(nm, (&P_THEME[0 as usize]) as u64) {
        return 1
    }
    if starts(nm, (&P_FONT[0 as usize]) as u64) || starts(nm, (&P_MEDIA[0 as usize]) as u64) {
        return 2
    }
    return 0
}

fn app_text(i: u64, pre: u64, out: u64, cap: u64) -> bool {
    var k: [u8; 64] = [0 as u8; 64]
    ulib.strcpy((&k[0 as usize]) as u64, pre)
    ulib.strcat((&k[0 as usize]) as u64, name_at(i))
    let v: u64 = msg.get((&k[0 as usize]) as u64)
    if v == (&k[0 as usize]) as u64 || (*(v as *mut u8)) == 0 as u8 {
        return false
    }
    ulib.strncpy(out, v, cap)
    return true
}

fn desc_of(i: u64) -> u64 {
    let d: u64 = (&b_dsc[0 as usize]) as u64
    var pre: [u8; 11] = "store.app.\0"
    if !app_text(i, (&pre[0 as usize]) as u64, d, 127) {
        let c: u64 = catalog_of(i)
        if (s_state[i as usize] == ST_UNLISTED as u8 || s_system[i as usize] != 0 as u8) && c != storecat2.NONE {
            ulib.strncpy(d, storecat2.level_text(storecat2.list_level(c)), 127)
        } else {
            ulib.strncpy(d, msg.get((&T_GENERIC[0 as usize]) as u64), 127)
        }
    }
    return d
}

fn title_of(i: u64) -> u64 {
    let d: u64 = (&b_disp[0 as usize]) as u64
    var pre: [u8; 12] = "store.name.\0"
    if app_text(i, (&pre[0 as usize]) as u64, d, 63) {
        return d
    }
    let cat: u64 = catalog_of(i)
    if cat != storecat2.NONE {
        ulib.strncpy(d, storecat2.list_name(cat), 63)
        return d
    }
    ulib.strncpy(d, name_at(i), 63)
    let c: u64 = (*(d as *mut u8)) as u64
    if c >= 97 && c <= 122 {
        *(d as *mut u8) = (c - 32) as u8
    }
    return d
}

fn catalog_of(i: u64) -> u64 {
    return storecat2.list_find(name_at(i))
}

fn item_works(i: u64) -> bool {
    let c: u64 = catalog_of(i)
    return c != storecat2.NONE && storecat2.list_level(c) == storecat2.LEVEL_WORKS
}

fn is_installed(i: u64) -> bool {
    let st: u64 = s_state[i as usize] as u64
    return st == 1 || st == 2
}

fn query_match(i: u64, q: u64) -> bool {
    if contains(name_at(i), q) || contains(title_of(i), q) {
        return true
    }
    return contains(desc_of(i), q)
}

fn item_match(i: u64) -> bool {
    let q: u64 = (&s_q[0 as usize]) as u64
    if (*(q as *mut u8)) != 0 as u8 {
        return query_match(i, q)
    }
    return view_match(i)
}

fn view_match(i: u64) -> bool {
    let cls: u64 = class_of(i)
    let st: u64 = s_state[i as usize] as u64
    if !storetabs.visible(s_cat, i, is_installed(i), false) {
        return false
    }
    if s_cat == 1 && cls != 0 {
        return false
    }
    if s_cat == 2 && cls != 1 {
        return false
    }
    if s_cat == 3 && cls != 2 {
        return false
    }
    if s_cat == 4 && st != 2 {
        return false
    }
    if s_cat == 5 && (st == 0 || st == ST_UNLISTED) {
        return false
    }
    if s_works && !item_works(i) {
        return false
    }
    if s_chip > 0 && s_chip < s_chip_n {
        if !ulib.streq(cat_of(i), (&b_chip[0 as usize]) as u64 + s_chip * 32) {
            return false
        }
    }
    return true
}

fn per_page() -> u64 {
    if s_cat == 4 {
        return storegeom.per_page_up()
    }
    return storegeom.per_page()
}

fn pages() -> u64 {
    return pagegrid.grid_pages(s_vis_n, per_page())
}

fn refilter() {
    s_vis_n = 0
    var i: u64 = 0
    while i < s_count {
        if item_match(i) {
            s_vis[s_vis_n as usize] = i
            s_vis_n = s_vis_n + 1
        }
        i = i + 1
    }
    if s_page >= pages() {
        s_page = pages() - 1
    }
}

fn count_classes() {
    s_n_upd = 0
    s_n_inst = 0
    s_n_cls[0 as usize] = 0
    s_n_cls[1 as usize] = 0
    s_n_cls[2 as usize] = 0
    var i: u64 = 0
    while i < s_count {
        let st: u64 = s_state[i as usize] as u64
        if st == 2 {
            s_n_upd = s_n_upd + 1
        }
        if st == 1 || st == 2 {
            s_n_inst = s_n_inst + 1
        }
        let c: u64 = class_of(i)
        s_n_cls[c as usize] = s_n_cls[c as usize] + 1
        i = i + 1
    }
}

fn kv(lp: u64, key: u64, out: u64, max: u64) -> bool {
    let kl: u64 = text.length(key)
    var i: u64 = 0
    while i < kl {
        if (*((lp + i) as *mut u8)) != (*((key + i) as *mut u8)) {
            return false
        }
        i = i + 1
    }
    var o: u64 = 0
    while (*((lp + kl + o) as *mut u8)) != 0 as u8 && o + 1 < max {
        __mmio_write8((out + o) as *mut u8, *((lp + kl + o) as *mut u8))
        o = o + 1
    }
    __mmio_write8((out + o) as *mut u8, 0 as u8)
    return true
}

fn parse_num(p: u64) -> u64 {
    var v: u64 = 0
    var k: u64 = p
    while (*(k as *mut u8)) >= 48 as u8 && (*(k as *mut u8)) <= 57 as u8 {
        v = v * 10 + ((*(k as *mut u8)) as u64 - 48)
        k = k + 1
    }
    return v
}

fn is_listed(short: u64) -> bool {
    var i: u64 = 0
    while i < s_count {
        if ulib.streq(name_at(i), short) {
            return true
        }
        i = i + 1
    }
    return false
}

fn add_unlisted() {
    var c: u64 = 0
    while c < storecat2.list_count() && s_count < MAXI {
        if !is_listed(storecat2.list_short(c)) {
            let row: u64 = name_at(s_count)
            memcopy.fill(row, 0, NAMEW)
            ulib.strncpy(row, storecat2.list_short(c), 23)
            ulib.strncpy(row + 24, storecat2.list_version(c), 11)
            s_state[s_count as usize] = ST_UNLISTED as u8
            s_system[s_count as usize] = 0 as u8
            if startcat.bundle_present(storecat2.list_short(c)) {
                s_state[s_count as usize] = 1 as u8
                s_system[s_count as usize] = 1 as u8
            }
            s_autooff[s_count as usize] = 0 as u8
            s_count = s_count + 1
        }
        c = c + 1
    }
}

fn refresh_registry() {
    storetabs.begin()
    var i: u64 = 0
    while i < s_count {
        let c: u64 = catalog_of(i)
        var kind: u64 = registry.KIND_APP
        var requires: u64 = (&E_EMPTY[0 as usize]) as u64
        var version: u64 = (&E_EMPTY[0 as usize]) as u64
        if c != storecat2.NONE {
            kind = storecat2.list_kind(c)
            requires = storecat2.list_requires(c)
        }
        if is_installed(i) {
            version = ver_at(i)
        }
        storetabs.push(name_at(i), version, requires, kind, s_system[i as usize] != 0 as u8)
        i = i + 1
    }
}

fn load_local() {
    let n: u64 = storelocal.scan()
    var i: u64 = 0
    while i < n && s_count < MAXI {
        let row: u64 = name_at(s_count)
        memcopy.fill(row, 0, NAMEW)
        ulib.strncpy(row, storelocal.name_at(i), 24)
        ulib.strncpy(row + 24, storelocal.version_at(i), 12)
        s_state[s_count as usize] = 1 as u8
        s_autooff[s_count as usize] = 0 as u8
        s_system[s_count as usize] = 0 as u8
        s_count = s_count + 1
        i = i + 1
    }
    s_local = true
    refresh_registry()
    count_classes()
    refilter()
}

fn load_list() {
    storecat2.reset()
    storeicon.reset()
    s_count = 0
    s_can_i = false
    s_can_r = false
    s_source[0 as usize] = 0 as u8
    s_local = false
    if !actcli.open() {
        s_bus = false
        set_status(msg.get((&T_NOBUS[0 as usize]) as u64), 0)
        load_local()
        return
    }
    actcli.req((&V_LIST[0 as usize]) as u64)
    if actcli.send(300) != actcli.R_OK {
        s_bus = false
        set_status(msg.get((&T_NOBUS[0 as usize]) as u64), 0)
        load_local()
        return
    }
    s_bus = true
    var ln: [u8; 160] = [0 as u8; 160]
    let lp: u64 = (&ln[0 as usize]) as u64
    var v: [u8; 40] = [0 as u8; 40]
    var n: u64 = 1
    while actcli.line(n, lp, 160) {
        let _src: bool = kv(lp, (&S_SRC[0 as usize]) as u64, (&s_source[0 as usize]) as u64, 100)
        if kv(lp, (&S_AUTOAPPS[0 as usize]) as u64, (&v[0 as usize]) as u64, 40) {
            s_auto_all = (*((&v[0 as usize]) as *mut u8)) != 48 as u8
        }
        if kv(lp, (&S_CI[0 as usize]) as u64, (&v[0 as usize]) as u64, 40) {
            s_can_i = (*((&v[0 as usize]) as *mut u8)) == 49 as u8
        } else if kv(lp, (&S_CR[0 as usize]) as u64, (&v[0 as usize]) as u64, 40) {
            s_can_r = (*((&v[0 as usize]) as *mut u8)) == 49 as u8
        } else if kv(lp, (&S_ITEM[0 as usize]) as u64, (&s_tmp[0 as usize]) as u64, 160) && s_count < MAXI {
            let t: u64 = (&s_tmp[0 as usize]) as u64
            let row: u64 = name_at(s_count)
            var f: u64 = 0
            var o: u64 = 0
            var i: u64 = 0
            memcopy.fill(row, 0, NAMEW)
            s_state[s_count as usize] = 0 as u8
            s_autooff[s_count as usize] = 0 as u8
            s_system[s_count as usize] = 0 as u8
            while (*((t + i) as *mut u8)) != 0 as u8 {
                let c: u64 = (*((t + i) as *mut u8)) as u64
                if c == 124 {
                    f = f + 1
                    o = 0
                } else {
                    var base: u64 = 0
                    var cap: u64 = 23
                    if f == 1 {
                        base = 24
                        cap = 11
                    } else if f == 2 {
                        base = 36
                        cap = 11
                    }
                    if f <= 2 && o < cap {
                        __mmio_write8((row + base + o) as *mut u8, c as u8)
                        o = o + 1
                    } else if f == 3 {
                        if o == 0 {
                            if c == 110 {
                                s_state[s_count as usize] = 0 as u8
                            } else if c == 97 {
                                s_state[s_count as usize] = 1 as u8
                            } else if c == 117 {
                                s_state[s_count as usize] = 2 as u8
                            }
                        }
                        o = o + 1
                    } else if f == 4 && o == 0 {
                        if c == 48 {
                            s_autooff[s_count as usize] = 1 as u8
                        }
                        o = o + 1
                    }
                }
                i = i + 1
            }
            s_count = s_count + 1
        }
        n = n + 1
    }
    storecat2.load_list()
    add_unlisted()
    refresh_registry()
    count_classes()
    refilter()
    if s_count == 0 {
        set_status(msg.get((&T_EMPTY[0 as usize]) as u64), 0)
    }
    lineout.add_text((&S_LISTED[0 as usize]) as u64)
    lineout.add_unum(s_count)
    lineout.end_line()
}

static mut PH_DONE: [u8; 5] = "done\0"

static mut PH_DONE_OLD: [u8; 7] = "fertig\0"

static mut PH_FAILED: [u8; 7] = "failed\0"

static mut PH_FAILED_OLD: [u8; 7] = "fehler\0"

fn phase_is_done(p: u64) -> bool {
    return ulib.streq(p, (&PH_DONE[0 as usize]) as u64) || ulib.streq(p, (&PH_DONE_OLD[0 as usize]) as u64)
}

fn phase_is_failed(p: u64) -> bool {
    return ulib.streq(p, (&PH_FAILED[0 as usize]) as u64) || ulib.streq(p, (&PH_FAILED_OLD[0 as usize]) as u64)
}

fn load_status() {
    if !actcli.open() {
        return
    }
    actcli.req((&V_STATUS[0 as usize]) as u64)
    if actcli.send(300) != actcli.R_OK {
        return
    }
    var ln: [u8; 160] = [0 as u8; 160]
    let lp: u64 = (&ln[0 as usize]) as u64
    var ph: [u8; 16] = [0 as u8; 16]
    var ms: [u8; 160] = [0 as u8; 160]
    var vb: [u8; 16] = [0 as u8; 16]
    var nm: [u8; 64] = [0 as u8; 64]
    var bz: [u8; 8] = [0 as u8; 8]
    var pc: [u8; 8] = [0 as u8; 8]
    var n: u64 = 1
    while actcli.line(n, lp, 160) {
        let _a: bool = kv(lp, (&S_PH[0 as usize]) as u64, (&ph[0 as usize]) as u64, 16)
        let _b: bool = kv(lp, (&S_MS[0 as usize]) as u64, (&ms[0 as usize]) as u64, 160)
        let _c: bool = kv(lp, (&S_VB[0 as usize]) as u64, (&vb[0 as usize]) as u64, 16)
        let _d: bool = kv(lp, (&S_NM[0 as usize]) as u64, (&nm[0 as usize]) as u64, 64)
        let _e: bool = kv(lp, (&S_BZ[0 as usize]) as u64, (&bz[0 as usize]) as u64, 8)
        let _f: bool = kv(lp, (&S_PC[0 as usize]) as u64, (&pc[0 as usize]) as u64, 8)
        n = n + 1
    }
    s_busy = (*((&bz[0 as usize]) as *mut u8)) == 49 as u8
    ulib.strcpy((&s_phase[0 as usize]) as u64, (&ph[0 as usize]) as u64)
    ulib.strcpy((&s_verb[0 as usize]) as u64, (&vb[0 as usize]) as u64)
    ulib.strcpy((&s_job[0 as usize]) as u64, (&nm[0 as usize]) as u64)
    s_pct_srv = parse_num((&pc[0 as usize]) as u64)
    if s_pct_srv > 100 {
        s_pct_srv = 100
    }
    if s_busy && storetabs.plan_total() > 1 {
        set_status((&b_step[0 as usize]) as u64, 0)
    } else if s_busy {
        set_status((&T_BUSY[0 as usize]) as u64, 0)
    } else if phase_is_done((&ph[0 as usize]) as u64) {
        set_status((&T_DONE[0 as usize]) as u64, (&ms[0 as usize]) as u64)
    } else if phase_is_failed((&ph[0 as usize]) as u64) {
        set_status(msg.get((&T_FAIL[0 as usize]) as u64), (&ms[0 as usize]) as u64)
    }
    lineout.add_text((&S_ST[0 as usize]) as u64)
    lineout.add_text((&ph[0 as usize]) as u64)
    if ms[0 as usize] != 0 as u8 {
        lineout.add_text((&T_SP[0 as usize]) as u64)
        lineout.add_text((&ms[0 as usize]) as u64)
    }
    lineout.end_line()
}

fn call_verb(verb: u64, name: u64) -> bool {
    if !actcli.open() {
        notice(msg.get((&T_NOBUS[0 as usize]) as u64), 0)
        return false
    }
    actcli.req(verb)
    if name != 0 {
        actcli.arg((&K_NAMEARG[0 as usize]) as u64, name)
    }
    var rc: u64 = actcli.send(300)
    if rc == actcli.R_CONFIRM {
        lineout.add_text((&S_ASK[0 as usize]) as u64)
        lineout.add_unum(rc)
        lineout.end_line()
        set_status(msg.get((&T_ASKSYS[0 as usize]) as u64), 0)
        var cl: [u8; 40] = [0 as u8; 40]
        let cp: u64 = (&cl[0 as usize]) as u64
        s_askno = 0
        s_grace = 0
        if actcli.line(0, cp, 40) {
            var q: u64 = 0
            while (*((cp + q) as *mut u8)) != 0 as u8 && (*((cp + q) as *mut u8)) != 32 as u8 {
                q = q + 1
            }
            s_askno = parse_num(cp + q + 1)
        }
        s_pct = 2
        s_pct_srv = 0
        return true
    }
    lineout.add_text((&S_ASK[0 as usize]) as u64)
    lineout.add_unum(rc)
    lineout.end_line()
    if rc == actcli.R_OK {
        set_status((&T_SENT[0 as usize]) as u64, 0)
        s_pct = 2
        s_pct_srv = 0
        return true
    }
    var ln2: [u8; 160] = [0 as u8; 160]
    let lp2: u64 = (&ln2[0 as usize]) as u64
    let _l2: bool = actcli.line(0, lp2, 160)
    var denied: [u8; 12] = "not_allowed\0"
    if ulib.find(lp2, (&denied[0 as usize]) as u64) != 0xFFFFFFFFFFFFFFFF {
        notice(msg.get((&T_DENIED[0 as usize]) as u64), 0)
    } else if ulib.find(lp2, (&K_USEDLG[0 as usize]) as u64) != 0xFFFFFFFFFFFFFFFF {
        set_status(msg.get((&T_ASKSYS[0 as usize]) as u64), 0)
    } else {
        notice(msg.get((&T_FAIL[0 as usize]) as u64), lp2)
    }
    return false
}

fn set_auto(name: u64, on: bool) {
    if !actcli.open() {
        notice(msg.get((&T_NOBUS[0 as usize]) as u64), 0)
        return
    }
    actcli.req((&V_AUTOSET[0 as usize]) as u64)
    if on {
        actcli.arg((&K_VALUEARG[0 as usize]) as u64, (&V_ON[0 as usize]) as u64)
    } else {
        actcli.arg((&K_VALUEARG[0 as usize]) as u64, (&V_OFF[0 as usize]) as u64)
    }
    if name != 0 {
        actcli.arg((&K_NAMEARG[0 as usize]) as u64, name)
    }
    if actcli.send(300) != actcli.R_OK {
        notice(msg.get((&T_DENIED[0 as usize]) as u64), 0)
        return
    }
    load_list()
}

fn ask_check() {
    if s_grace > 0 {
        s_grace = s_grace - 1
        if s_grace == 0 {
            s_askno = 0
            s_pct = 0
            notice((&T_REJECTED[0 as usize]) as u64, 0)
            return
        }
        s_busy = true
        return
    }
    if !actcli.open() {
        s_askno = 0
        return
    }
    actcli.req_num((&V_CONFIRM[0 as usize]) as u64, s_askno)
    let rc: u64 = actcli.send(300)
    var ln: [u8; 80] = [0 as u8; 80]
    let lp: u64 = (&ln[0 as usize]) as u64
    let _l: bool = actcli.line(0, lp, 80)
    if rc != actcli.R_ERR || ulib.find(lp, (&K_USEDLG[0 as usize]) as u64) != 0xFFFFFFFFFFFFFFFF {
        s_busy = true
    } else if ulib.find(lp, (&K_NOREQ[0 as usize]) as u64) != 0xFFFFFFFFFFFFFFFF {
        s_grace = 6
        s_busy = true
    } else {
        s_askno = 0
    }
}

fn tt(x: u64, y: u64, w: u64, p: u64, px: u64, bold: bool, role: u64) {
    fuiscene.text_role(x, y + px - px / 5, w, p, px, bold, role)
}

fn radius() -> u64 {
    return fuiscene.rb_px() + fuiscene.sp(2)
}

fn paint_icon(i: u64, x: u64, y: u64, size: u64) {
    let sym: u64 = storeicon.slot_for(name_at(i))
    if sym != 0 {
        fuiscene.icon_at(sym, x, y, size, 0)
        return
    }
    appglyph.paint(name_at(i), x, y, size)
}

fn paint_chip(x: u64, y: u64, text: u64, accent: bool) -> u64 {
    let px: u64 = fuiscene.sp(11)
    let w: u64 = fuiscene.text_width(text, px) + fuiscene.sp(12)
    let h: u64 = fuiscene.sp(18)
    if accent {
        fuiscene.cv_round(x, y, w, h, h / 2, fuiscene.R_ACCENT)
        tt(x + fuiscene.sp(6), y + fuiscene.sp(2), w, text, px, true, fuiscene.R_ONFILL)
    } else {
        fuiscene.cv_round(x, y, w, h, h / 2, fuiscene.R_FIELD)
        tt(x + fuiscene.sp(6), y + fuiscene.sp(2), w, text, px, true, fuiscene.R_SUCCESS)
    }
    return w
}

fn focus_ring(x: u64, y: u64, w: u64, h: u64, r: u64) {
    fuiscene.cv_ring(x, y, w, h, r, fuiscene.R_ACCENT)
    fuiscene.cv_ring(x + 1, y + 1, w - 2, h - 2, r, fuiscene.R_ACCENT)
}

fn category_text(i: u64, out: u64) -> bool {
    let c: u64 = catalog_of(i)
    if c != storecat2.NONE {
        ulib.strncpy(out, storecat2.list_label(c), 63)
        return true
    }
    var pre: [u8; 11] = "store.cat.\0"
    return app_text(i, (&pre[0 as usize]) as u64, out, 63)
}

fn tab_label(i: u64) -> u64 {
    if storetabs.tab_of(i) == registry.TAB_SYSTEM {
        return msg.get((&T_TAB_SYSTEM[0 as usize]) as u64)
    }
    return msg.get((&T_TAB_RUNTIME[0 as usize]) as u64)
}

fn cat_of(i: u64) -> u64 {
    let d: u64 = (&b_line[0 as usize]) as u64
    if s_q[0 as usize] != 0 as u8 && storetabs.tab_of(i) != registry.TAB_APPS {
        sb_begin(d, 96)
        sb_s(tab_label(i))
        return d
    }
    if category_text(i, d) {
        return d
    }
    sb_begin(d, 96)
    sb_s(ver_at(i))
    sb_s((&T_DOT[0 as usize]) as u64)
    sb_size(bytes_at(i))
    return d
}

fn wrap_cut(p: u64, w: u64, px: u64) -> u64 {
    let d: u64 = (&b_wrap[0 as usize]) as u64
    var n: u64 = 0
    var last: u64 = 0
    while (*((p + n) as *mut u8)) != 0 as u8 && n < 126 {
        *((d + n) as *mut u8) = *((p + n) as *mut u8)
        *((d + n + 1) as *mut u8) = 0 as u8
        if fuiscene.text_width(d, px) > w {
            if last > 0 {
                return last
            }
            return n
        }
        if (*((p + n) as *mut u8)) == 32 as u8 {
            last = n
        }
        n = n + 1
    }
    return n
}

fn tt_wrap2(x: u64, y: u64, w: u64, p: u64, px: u64, gap: u64) {
    let cut: u64 = wrap_cut(p, w, px)
    let d: u64 = (&b_wrap[0 as usize]) as u64
    ulib.strncpy(d, p, 127)
    *((d + cut) as *mut u8) = 0 as u8
    tt(x, y, w, d, px, false, fuiscene.R_MUTED)
    if (*((p + cut) as *mut u8)) == 0 as u8 {
        return
    }
    var rest: u64 = p + cut
    while (*(rest as *mut u8)) == 32 as u8 {
        rest = rest + 1
    }
    tt(x, y + gap, w, rest, px, false, fuiscene.R_MUTED)
}

fn paint_card_info(i: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    if i >= s_count {
        return
    }
    let isz: u64 = fuiscene.sp(40)
    paint_icon(i, x, y + fuiscene.sp(2), isz)
    let tx: u64 = x + isz + fuiscene.sp(12)
    let room: u64 = w - isz - fuiscene.sp(12)
    tt(tx, y, room, title_of(i), fuiscene.sp(14), true, fuiscene.R_TEXT)
    var catw: u64 = room
    let c: u64 = catalog_of(i)
    if c != storecat2.NONE {
        let rank: u64 = storecat2.list_level(c)
        let bw: u64 = badge_width(rank)
        catw = room - bw - fuiscene.sp(6)
        paint_level_badge(tx + room - bw, y + fuiscene.sp(18), rank)
    }
    tt(tx, y + fuiscene.sp(18), catw, cat_of(i), fuiscene.sp(12), false, fuiscene.R_MUTED)
    tt_wrap2(tx, y + fuiscene.sp(36), room, desc_of(i), fuiscene.sp(12), fuiscene.sp(17))
    if (st & fuiscene.TS_FOCUS) != 0 {
        focus_ring(x, y, w, h, radius())
    }
}

fn paint_row_info(i: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    if i >= s_count {
        return
    }
    let isz: u64 = fuiscene.sp(36)
    let gx: u64 = x + fuiscene.sp(8)
    paint_icon(i, gx, y + (h - isz) / 2, isz)
    let tx: u64 = gx + isz + fuiscene.sp(12)
    tt(tx, y + fuiscene.sp(7), w - isz - fuiscene.sp(36), title_of(i), fuiscene.sp(14), true, fuiscene.R_TEXT)
    let c: u64 = catalog_of(i)
    if c != storecat2.NONE {
        let rank: u64 = storecat2.list_level(c)
        paint_level_badge(x + w - badge_width(rank) - fuiscene.sp(8), y + fuiscene.sp(7), rank)
    }
    sb_begin((&b_line[0 as usize]) as u64, 96)
    sb_s(ver_at(i))
    sb_s((&T_DOT[0 as usize]) as u64)
    sb_size(bytes_at(i))
    sb_s((&T_DOT[0 as usize]) as u64)
    sb_s(desc_of(i))
    tt(tx, y + fuiscene.sp(28), w - isz - fuiscene.sp(36), (&b_line[0 as usize]) as u64, fuiscene.sp(12), false, fuiscene.R_MUTED)
    if (st & fuiscene.TS_FOCUS) != 0 {
        focus_ring(x, y, w, h, radius())
    }
}

fn nav_glyph(id: u64) -> u64 {
    if id == 0 {
        return icons.START
    } else if id == 1 {
        return icons.FILE_PROGRAM
    } else if id == 2 {
        return icons.SETTINGS
    } else if id == 3 {
        return icons.FILE_IMAGE
    } else if id == 4 {
        return icons.ARROW_DOWN
    } else if id == CAT_SYSTEM {
        return icons.SETTINGS_SYSTEM
    } else if id == CAT_RUNTIME {
        return icons.PAGE_DETAILS
    }
    return icons.CHECK
}

fn paint_nav(k: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    if k >= s_nav_n {
        return
    }
    let id: u64 = s_nav_id[k as usize]
    let sel: bool = id == s_cat
    let r: u64 = fuiscene.sp(4)
    if sel {
        fuiscene.cv_round(x, y, w, h, r, fuiscene.R_SURFACE)
        fuiscene.cv_round(x, y + fuiscene.sp(16), fuiscene.sp(3), h - fuiscene.sp(32), fuiscene.sp(2), fuiscene.R_ACCENT)
    }
    let gs: u64 = fuiscene.sp(20)
    var ink: u64 = 0x5D5D5D
    if sel {
        ink = 0x0067C0
    }
    fuiscene.cv_glyph(nav_glyph(id), x + (w - gs) / 2, y + fuiscene.sp(7), gs, ink)
    let nm: u64 = (&b_nav[0 as usize]) as u64 + k * 32
    let px: u64 = fuiscene.sp(11)
    var tw: u64 = fuiscene.text_width(nm, px)
    if tw > w {
        tw = w
    }
    tt(x + (w - tw) / 2, y + fuiscene.sp(32), w, nm, px, sel, fuiscene.R_TEXT)
    var cnt: u64 = 0
    if id == 4 {
        cnt = s_n_upd
    }
    if cnt > 0 {
        let bh: u64 = fuiscene.sp(8)
        fuiscene.cv_round(x + w / 2 + fuiscene.sp(6), y + fuiscene.sp(5), bh, bh, bh / 2, fuiscene.R_ACCENT)
    }
    if (st & fuiscene.TS_FOCUS) != 0 {
        focus_ring(x, y, w, h, r)
    }
}

fn paint_chip_tile(k: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    var on: bool = k == s_chip
    var nm: u64 = (&b_chip[0 as usize]) as u64 + k * 32
    if k == MAXCHIP {
        on = s_works
        nm = msg.get((&T_CHIP_WORKS[0 as usize]) as u64)
    }
    let r: u64 = h / 2
    if on {
        fuiscene.cv_round(x, y, w, h, r, fuiscene.R_ACCENT)
    } else {
        fuiscene.cv_round(x, y, w, h, r, fuiscene.R_SURFACE)
        fuiscene.cv_ring(x, y, w, h, r, fuiscene.R_BORDER)
    }
    let px: u64 = fuiscene.sp(12)
    let tw: u64 = fuiscene.text_width(nm, px)
    var role: u64 = fuiscene.R_TEXT
    if on {
        role = fuiscene.R_ONFILL
    }
    tt(x + (w - tw) / 2, y + (h - px) / 2 - fuiscene.sp(1), w, nm, px, on, role)
    if (st & fuiscene.TS_FOCUS) != 0 {
        focus_ring(x, y, w, h, r)
    }
}

fn chip_add(p: u64) {
    var k: u64 = 1
    while k < s_chip_n {
        if ulib.streq((&b_chip[0 as usize]) as u64 + k * 32, p) {
            return
        }
        k = k + 1
    }
    if s_chip_n >= MAXCHIP {
        return
    }
    ulib.strncpy((&b_chip[0 as usize]) as u64 + s_chip_n * 32, p, 31)
    s_chip_n = s_chip_n + 1
}

fn collect_chips() {
    ulib.strncpy((&b_chip[0 as usize]) as u64, msg.get((&N_ALL[0 as usize]) as u64), 31)
    s_chip_n = 1
    var i: u64 = 0
    while i < s_count {
        if class_of(i) == 0 && category_text(i, (&b_catq[0 as usize]) as u64) {
            chip_add((&b_catq[0 as usize]) as u64)
        }
        i = i + 1
    }
}

fn build_chips(col: usize) {
    collect_chips()
    if s_chip_n < 2 && storecat2.list_count() == 0 {
        return
    }
    let cr: usize = fuiscene.row(col)
    fuiscene.set_gap(cr, 8)
    var k: u64 = 0
    while k < s_chip_n {
        let nm: u64 = (&b_chip[0 as usize]) as u64 + k * 32
        let w: u64 = fuiscene.text_width(nm, 12) + 26
        let _t: usize = fuiscene.ftile_nb(cr, K_CHIP + k, nm, w, 28, 300 + k, tile_cb)
        k = k + 1
    }
    if storecat2.list_count() > 0 {
        let wn: u64 = msg.get((&T_CHIP_WORKS[0 as usize]) as u64)
        let ww: u64 = fuiscene.text_width(wn, 12) + 26
        let _w: usize = fuiscene.ftile_nb(cr, K_WORKS, wn, ww, 28, 300 + MAXCHIP, tile_cb)
    }
}

fn tile_cb(ud: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    if ud < 100 {
        paint_card_info(ud, x, y, w, h, st)
    } else if ud < 200 {
        paint_nav(ud - 100, x, y, w, h, st)
    } else if ud >= 300 {
        paint_chip_tile(ud - 300, x, y, w, h, st)
    } else {
        paint_row_info(ud - 200, x, y, w, h, st)
    }
}

fn cv_job(x: u64, y: u64, w: u64, h: u64) {
    sb_begin((&b_num[0 as usize]) as u64, 24)
    sb_n(s_pct)
    sb_s((&T_PCT[0 as usize]) as u64)
    let px: u64 = fuiscene.sp(12)
    let tw: u64 = fuiscene.text_width((&b_num[0 as usize]) as u64, px)
    let bh: u64 = fuiscene.sp(4)
    let bw: u64 = w - tw - fuiscene.sp(8)
    let by: u64 = y + (h - bh) / 2
    fuiscene.cv_round(x, by, bw, bh, bh / 2, fuiscene.R_FIELD)
    var pct: u64 = s_pct
    if pct > 100 {
        pct = 100
    }
    if pct > 0 {
        fuiscene.cv_round(x, by, bw * pct / 100, bh, bh / 2, fuiscene.R_ACCENT)
    }
    tt(x + bw + fuiscene.sp(8), y + (h - px) / 2 - fuiscene.sp(1), tw, (&b_num[0 as usize]) as u64, px, false, fuiscene.R_MUTED)
}

fn cv_title(x: u64, y: u64, w: u64, h: u64) {
    tt(x, y + fuiscene.sp(2), w, (&b_title[0 as usize]) as u64, fuiscene.sp(20), true, fuiscene.R_TEXT)
}

fn cv_pager(x: u64, y: u64, w: u64, h: u64) {
    let pw: u64 = fuiscene.text_width((&b_pager[0 as usize]) as u64, fuiscene.sp(13))
    tt(x + (w - pw) / 2, y + (h - fuiscene.sp(13)) / 2, w, (&b_pager[0 as usize]) as u64, fuiscene.sp(13), false, fuiscene.R_MUTED)
}

fn cv_hero(x: u64, y: u64, w: u64, h: u64) {
    let i: u64 = s_detail
    if i >= s_count {
        return
    }
    let isz: u64 = fuiscene.sp(88)
    paint_icon(i, x + fuiscene.sp(4), y + fuiscene.sp(8), isz)
    let tx: u64 = x + isz + fuiscene.sp(24)
    tt(tx, y + fuiscene.sp(10), w - isz - fuiscene.sp(30), title_of(i), fuiscene.sp(26), true, fuiscene.R_TEXT)
    sb_begin((&b_line[0 as usize]) as u64, 96)
    sb_s(ver_at(i))
    sb_s((&T_DOT[0 as usize]) as u64)
    sb_size(bytes_at(i))
    tt(tx, y + fuiscene.sp(46), w - isz - fuiscene.sp(30), (&b_line[0 as usize]) as u64, fuiscene.sp(13), false, fuiscene.R_MUTED)
    let stt: u64 = s_state[i as usize] as u64
    var cx: u64 = tx
    if stt == 2 {
        cx = cx + paint_chip(tx, y + fuiscene.sp(72), msg.get((&T_CHIP_UPD[0 as usize]) as u64), true) + fuiscene.sp(8)
    } else if stt == 1 {
        cx = cx + paint_chip(tx, y + fuiscene.sp(72), msg.get((&T_CHIP_INST[0 as usize]) as u64), false) + fuiscene.sp(8)
    }
    if storecat2.loaded() {
        paint_level_badge(cx, y + fuiscene.sp(72), storecat2.level_rank())
    }
}

fn level_role(r: u64) -> u64 {
    if r == storecat2.LEVEL_WORKS {
        return fuiscene.R_SUCCESS
    }
    if r == storecat2.LEVEL_PARTIAL {
        return fuiscene.R_WARN
    }
    if r == storecat2.LEVEL_BROKEN {
        return fuiscene.R_ERR
    }
    return fuiscene.R_MUTED
}

fn badge_width(rank: u64) -> u64 {
    return fuiscene.text_width(storecat2.level_text(rank), fuiscene.sp(11)) + fuiscene.sp(12)
}

fn paint_level_badge(x: u64, y: u64, rank: u64) {
    let w: u64 = badge_width(rank)
    let h: u64 = fuiscene.sp(18)
    fuiscene.cv_round(x, y, w, h, h / 2, fuiscene.R_FIELD)
    tt(x + fuiscene.sp(6), y + fuiscene.sp(2), w, storecat2.level_text(rank), fuiscene.sp(11), true, level_role(rank))
    fuiscene.say_cv_text(x + fuiscene.sp(6), y + fuiscene.sp(2) + fuiscene.sp(11) - fuiscene.sp(11) / 5, level_role(rank), fuiscene.R_FIELD, fuiscene.sp(11), storecat2.level_text(rank))
}

fn cv_empty(x: u64, y: u64, w: u64, h: u64) {
    var t: u64 = msg.get((&E_NOHIT_T[0 as usize]) as u64)
    var m: u64 = (&E_NOHIT_X[0 as usize]) as u64
    var sym: u64 = (&E_SYM_Q[0 as usize]) as u64
    if s_et_kind == 1 {
        t = msg.get((&E_OK_T[0 as usize]) as u64)
        m = msg.get((&E_OK_X[0 as usize]) as u64)
        sym = (&E_SYM_OK[0 as usize]) as u64
    } else if s_et_kind == 2 {
        t = msg.get((&E_NET_T[0 as usize]) as u64)
        m = msg.get((&E_NET_X[0 as usize]) as u64)
        sym = (&E_SYM_NET[0 as usize]) as u64
    } else if s_et_kind == 3 {
        t = msg.get((&E_INST_T[0 as usize]) as u64)
        m = msg.get((&E_INST_X[0 as usize]) as u64)
    } else if s_et_kind == 4 {
        t = (&E_NONE_T[0 as usize]) as u64
        m = msg.get((&E_NONE_X[0 as usize]) as u64)
    }
    let d: u64 = fuiscene.sp(72)
    let cx: u64 = x + (w - d) / 2
    let cy: u64 = y + fuiscene.sp(30)
    fuiscene.cv_round(cx, cy, d, d, d / 2, fuiscene.R_FIELD)
    var role: u64 = fuiscene.R_MUTED
    if s_et_kind == 1 {
        role = fuiscene.R_SUCCESS
    } else if s_et_kind == 2 {
        role = fuiscene.R_WARN
    }
    let sw: u64 = fuiscene.text_width(sym, fuiscene.sp(32))
    tt(cx + (d - sw) / 2, cy + fuiscene.sp(16), d, sym, fuiscene.sp(32), true, role)
    let tw: u64 = fuiscene.text_width(t, fuiscene.sp(20))
    tt(x + (w - tw) / 2, cy + d + fuiscene.sp(18), w, t, fuiscene.sp(20), true, fuiscene.R_TEXT)
    let mw: u64 = fuiscene.text_width(m, fuiscene.sp(13))
    var mx: u64 = x + fuiscene.sp(8)
    if mw < w {
        mx = x + (w - mw) / 2
    }
    tt(mx, cy + d + fuiscene.sp(48), w - fuiscene.sp(16), m, fuiscene.sp(13), false, fuiscene.R_MUTED)
}

fn cv_skel(x: u64, y: u64, w: u64, h: u64) {
    var k: u64 = 0
    let cw: u64 = fuiscene.sp(storegeom.card_w())
    let ch: u64 = fuiscene.sp(storegeom.card_h())
    let gap: u64 = fuiscene.sp(12)
    let skel_cols: u64 = storegeom.cols()
    while k < skel_cols * 2 {
        let col: u64 = k % skel_cols
        let rw: u64 = k / skel_cols
        let cx: u64 = x + col * (cw + gap)
        let cy: u64 = y + rw * (ch + gap)
        fuiscene.cv_round(cx, cy, cw, ch, radius(), fuiscene.R_FIELD)
        fuiscene.cv_round(cx + fuiscene.sp(16), cy + fuiscene.sp(16), fuiscene.sp(44), fuiscene.sp(44), fuiscene.sp(10), fuiscene.R_BORDER)
        fuiscene.cv_round(cx + fuiscene.sp(72), cy + fuiscene.sp(20), fuiscene.sp(90), fuiscene.sp(12), fuiscene.sp(6), fuiscene.R_BORDER)
        fuiscene.cv_round(cx + fuiscene.sp(72), cy + fuiscene.sp(42), fuiscene.sp(60), fuiscene.sp(10), fuiscene.sp(5), fuiscene.R_BORDER)
        fuiscene.cv_round(cx + fuiscene.sp(16), cy + fuiscene.sp(76), fuiscene.sp(150), fuiscene.sp(10), fuiscene.sp(5), fuiscene.R_BORDER)
        fuiscene.cv_round(cx + fuiscene.sp(16), cy + ch - fuiscene.sp(40), cw - fuiscene.sp(32), fuiscene.sp(26), fuiscene.sp(8), fuiscene.R_BORDER)
        k = k + 1
    }
}

fn nav_name(buf: u64, p: u64) {
    sb_begin(buf, 32)
    sb_s(p)
}

fn build_nav(col: usize) {
    s_nav_n = 0
    s_nav_id[s_nav_n as usize] = 0
    nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_ALL[0 as usize]) as u64))
    s_nav_n = s_nav_n + 1
    s_nav_id[s_nav_n as usize] = 1
    nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_APPS[0 as usize]) as u64))
    s_nav_n = s_nav_n + 1
    s_nav_id[s_nav_n as usize] = CAT_SYSTEM
    nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_SYSTEM[0 as usize]) as u64))
    s_nav_n = s_nav_n + 1
    s_nav_id[s_nav_n as usize] = CAT_RUNTIME
    nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_RUNTIME[0 as usize]) as u64))
    s_nav_n = s_nav_n + 1
    if s_n_cls[1 as usize] > 0 {
        s_nav_id[s_nav_n as usize] = 2
        nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_THEMES[0 as usize]) as u64))
        s_nav_n = s_nav_n + 1
    }
    if s_n_cls[2 as usize] > 0 {
        s_nav_id[s_nav_n as usize] = 3
        nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_MEDIA[0 as usize]) as u64))
        s_nav_n = s_nav_n + 1
    }
    s_nav_id[s_nav_n as usize] = 4
    nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_UPD[0 as usize]) as u64))
    s_nav_n = s_nav_n + 1
    s_nav_id[s_nav_n as usize] = 5
    nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_INST[0 as usize]) as u64))
    s_nav_n = s_nav_n + 1
    var k: u64 = 0
    while k < s_nav_n {
        let _t: usize = fuiscene.ftile_nb(col, K_NAV + k, (&b_nav[0 as usize]) as u64 + k * 32, NAV_W, NAV_H, 100 + k, tile_cb)
        k = k + 1
    }
}

fn page_title() -> u64 {
    if s_cat == 1 {
        return msg.get((&H_APPS[0 as usize]) as u64)
    } else if s_cat == 2 {
        return msg.get((&H_THEMES[0 as usize]) as u64)
    } else if s_cat == 3 {
        return msg.get((&H_MEDIA[0 as usize]) as u64)
    } else if s_cat == 4 {
        return msg.get((&H_UPD[0 as usize]) as u64)
    } else if s_cat == 5 {
        return msg.get((&H_INST[0 as usize]) as u64)
    } else if s_cat == CAT_SYSTEM {
        return msg.get((&H_SYSTEM[0 as usize]) as u64)
    } else if s_cat == CAT_RUNTIME {
        return msg.get((&H_RUNTIME[0 as usize]) as u64)
    }
    return msg.get((&H_ALL[0 as usize]) as u64)
}

fn make_titles() {
    sb_begin((&b_title[0 as usize]) as u64, 96)
    sb_s(page_title())
    sb_begin((&b_sub[0 as usize]) as u64, 96)
    if (s_q[0 as usize]) != 0 as u8 {
        sb_s(msg.get((&T_FOR[0 as usize]) as u64))
        sb_s((&s_q[0 as usize]) as u64)
        sb_s((&T_DOT[0 as usize]) as u64)
        sb_n(s_vis_n)
        sb_s((&T_HITS[0 as usize]) as u64)
    } else {
        sb_n(s_vis_n)
        if s_vis_n == 1 {
            sb_s(msg.get((&T_PROG1[0 as usize]) as u64))
        } else {
            sb_s(msg.get((&T_PROGN[0 as usize]) as u64))
        }
    }
    sb_begin((&b_pager[0 as usize]) as u64, 48)
    sb_s(msg.get((&T_PAGE[0 as usize]) as u64))
    sb_n(s_page + 1)
    sb_s((&T_OF[0 as usize]) as u64)
    sb_n(pages())
}

fn plan_has(i: u64) -> bool {
    if storetabs.plan_total() < 2 || !s_busy {
        return false
    }
    var k: u64 = 0
    while k < storetabs.plan_total() {
        if ulib.streq(storetabs.plan_name(k), name_at(i)) {
            return true
        }
        k = k + 1
    }
    return false
}

fn job_is(i: u64) -> bool {
    return (s_busy && ulib.streq((&s_job[0 as usize]) as u64, name_at(i))) || plan_has(i)
}

fn item_of(name: u64) -> u64 {
    var i: u64 = 0
    while i < s_count {
        if ulib.streq(name_at(i), name) {
            return i
        }
        i = i + 1
    }
    return NONE
}

fn dep_met(j: u64, min: u64) -> bool {
    let have: u64 = registry.reg_installed(j)
    return (*(have as *mut u8)) != 0 as u8 && registry.ver_at_least(have, min)
}

fn needs_text(i: u64) -> bool {
    let req: u64 = registry.reg_requires(i)
    if !registry.requires_has(req) {
        return false
    }
    var name: [u8; 24] = [0 as u8; 24]
    var min: [u8; 12] = [0 as u8; 12]
    let np: u64 = (&name[0 as usize]) as u64
    sb_begin((&b_need[0 as usize]) as u64, 200)
    sb_s(msg.get((&T_NEEDS[0 as usize]) as u64))
    sb_c(32)
    var at: u64 = 0
    var first: bool = true
    while at != NONE {
        at = registry.requires_next(req, at, np, (&min[0 as usize]) as u64)
        if at != NONE {
            if !first {
                sb_s((&T_COMMA[0 as usize]) as u64)
            }
            first = false
            let j: u64 = registry.reg_find(np)
            if j == NONE {
                sb_s(np)
                sb_s((&T_OPEN_P[0 as usize]) as u64)
                sb_s(msg.get((&T_NEEDS_AUTO[0 as usize]) as u64))
            } else {
                sb_s(title_of(j))
                sb_s((&T_OPEN_P[0 as usize]) as u64)
                if dep_met(j, (&min[0 as usize]) as u64) {
                    sb_s(msg.get((&T_NEEDS_HAVE[0 as usize]) as u64))
                } else {
                    sb_s(msg.get((&T_NEEDS_AUTO[0 as usize]) as u64))
                }
            }
            sb_s((&T_CLOSE_P[0 as usize]) as u64)
        }
    }
    return true
}

fn plan_status(name: u64) {
    sb_begin((&b_step[0 as usize]) as u64, 96)
    sb_s(msg.get((&T_STEP[0 as usize]) as u64))
    sb_c(32)
    sb_n(storetabs.plan_step())
    sb_s((&T_SLASH[0 as usize]) as u64)
    sb_n(storetabs.plan_total())
    sb_s((&T_COLON[0 as usize]) as u64)
    let i: u64 = item_of(name)
    if i == NONE {
        sb_s(name)
    } else {
        sb_s(title_of(i))
    }
    set_status((&b_step[0 as usize]) as u64, 0)
}

fn plan_step_run() -> bool {
    let name: u64 = storetabs.plan_next()
    if name == NONE {
        return false
    }
    if !call_verb((&V_INSTALL[0 as usize]) as u64, name) {
        storetabs.plan_clear()
        return false
    }
    plan_status(name)
    s_busy = true
    return true
}

fn button_text(i: u64) -> u64 {
    let st: u64 = s_state[i as usize] as u64
    if st == 2 {
        return msg.get((&T_UPDATE[0 as usize]) as u64)
    } else if st == 1 {
        return msg.get((&T_OPEN[0 as usize]) as u64)
    } else if st == ST_UNLISTED {
        return msg.get((&T_NOPKG[0 as usize]) as u64)
    }
    return msg.get((&T_INSTALL[0 as usize]) as u64)
}

fn can_act(i: u64) -> bool {
    let st: u64 = s_state[i as usize] as u64
    if st == 1 {
        return true
    }
    if st == ST_UNLISTED {
        return false
    }
    return !s_busy && s_bus && s_can_i
}

fn notice(a: u64, b: u64) {
    sb_begin((&b_notice[0 as usize]) as u64, 160)
    sb_s(a)
    if b != 0 {
        sb_s(b)
    }
    s_ask_verb = 0
    fuiscene.dialog_open((&T_BRAND[0 as usize]) as u64, (&b_notice[0 as usize]) as u64,
        msg.get((&T_DLG_OK[0 as usize]) as u64), 0)
}

fn open_by_arg(arg: u64) {
    if !starts(arg, (&P_ARG_APP[0 as usize]) as u64) {
        return
    }
    var i: u64 = 0
    while i < s_count {
        if ulib.streq(name_at(i), arg + 4) {
            open_detail(i)
            return
        }
        i = i + 1
    }
}

fn open_app(i: u64) -> bool {
    var path: [u8; 64] = [0 as u8; 64]
    ulib.strcpy((&path[0 as usize]) as u64, (&P_APPS[0 as usize]) as u64)
    ulib.strcat((&path[0 as usize]) as u64, name_at(i))
    ulib.strcat((&path[0 as usize]) as u64, (&P_START[0 as usize]) as u64)
    let pid: u64 = appreg.launch((&path[0 as usize]) as u64, 0, 0)
    if pid >= 0xFFFFFFFFFFFFF000 {
        notice(msg.get((&T_OPENFAIL[0 as usize]) as u64), title_of(i))
        return false
    }
    return true
}

fn build_grid(col: usize) {
    var r: u64 = 0
    var k: u64 = 0
    let cols: u64 = storegeom.cols()
    let first: u64 = s_page * storegeom.per_page()
    while r < storegeom.per_page() / cols {
        let rw: usize = fuiscene.row(col)
        fuiscene.set_gap(rw, 12)
        var c: u64 = 0
        while c < cols {
            let slot: u64 = first + k
            if slot < s_vis_n {
                let i: u64 = s_vis[slot as usize]
                let card: usize = fuiscene.card_soft(rw)
                fuiscene.set_size(card, storegeom.card_w(), storegeom.card_h())
                let nb: u64 = (&b_tile[0 as usize]) as u64 + k * 128
                sb_begin(nb, 128)
                sb_s(title_of(i))
                sb_s((&T_DOT[0 as usize]) as u64)
                sb_s(ver_at(i))
                sb_s((&T_DOT[0 as usize]) as u64)
                sb_size(bytes_at(i))
                let st: u64 = s_state[i as usize] as u64
                if st == 2 {
                    sb_s((&T_DOT[0 as usize]) as u64)
                    sb_s(msg.get((&T_HASUPD[0 as usize]) as u64))
                } else if st == 1 {
                    sb_s((&T_DOT[0 as usize]) as u64)
                    sb_s(msg.get((&T_CURRENT[0 as usize]) as u64))
                }
                if s_q[0 as usize] != 0 as u8 && storetabs.tab_of(i) != registry.TAB_APPS {
                    sb_s((&T_DOT[0 as usize]) as u64)
                    sb_s(tab_label(i))
                }
                let _t: usize = fuiscene.ftile_nb(card, K_TILE + k, nb, storegeom.tile_w(), storegeom.tile_h(), i, tile_cb)
                if job_is(i) {
                    let pg: usize = fuiscene.canvas(card, 0, 150, BTN_H, cv_job)
                    fuiscene.set_align_end(pg)
                } else {
                    var bt: usize = NONE as usize
                    if st == 1 {
                        bt = fuiscene.button(card, button_text(i), K_QACT + k)
                    } else {
                        bt = fuiscene.button_main(card, button_text(i), K_QACT + k)
                    }
                    var bw: u64 = fuiscene.text_width(button_text(i), 13) + 32
                    if bw < BTN_W {
                        bw = BTN_W
                    }
                    fuiscene.set_size(bt, bw, BTN_H)
                    fuiscene.set_align_end(bt)
                    fuiscene.set_enabled(bt, can_act(i))
                }
            } else {
                let _e: usize = fuiscene.space(rw, storegeom.card_w(), storegeom.card_h())
            }
            k = k + 1
            c = c + 1
        }
        r = r + 1
    }
}

fn build_updates(col: usize) {
    var k: u64 = 0
    let first: u64 = s_page * storegeom.per_page_up()
    while k < storegeom.per_page_up() {
        let slot: u64 = first + k
        if slot < s_vis_n {
            let i: u64 = s_vis[slot as usize]
            let rw: usize = fuiscene.row(col)
            fuiscene.set_gap(rw, 8)
            let nb: u64 = (&b_tile[0 as usize]) as u64 + k * 128
            sb_begin(nb, 128)
            sb_s(title_of(i))
            sb_s((&T_DOT[0 as usize]) as u64)
            sb_s(ver_at(i))
            sb_s((&T_DOT[0 as usize]) as u64)
            sb_s(msg.get((&T_HASUPD[0 as usize]) as u64))
            let _t: usize = fuiscene.ftile(rw, K_ROW + k, nb, storegeom.update_tile_w(), 52, 200 + i, tile_cb)
            if job_is(i) {
                let _p: usize = fuiscene.progress(rw, 150, s_pct)
            } else {
                let bt: usize = fuiscene.button(rw, msg.get((&T_UPDATE[0 as usize]) as u64), K_ROWACT + k)
                fuiscene.set_size(bt, 150, 36)
                fuiscene.set_enabled(bt, can_act(i))
            }
        }
        k = k + 1
    }
}

fn build_pager(col: usize) {
    let pg: usize = fuiscene.row(col)
    fuiscene.set_gap(pg, 8)
    let sp0: usize = fuiscene.row(pg)
    fuiscene.set_grow(sp0, 1)
    let b0: usize = fuiscene.button(pg, msg.get((&T_PREV[0 as usize]) as u64), K_PGPREV)
    fuiscene.set_size(b0, 130, 30)
    fuiscene.set_enabled(b0, s_page > 0)
    let _c: usize = fuiscene.canvas(pg, 0, 120, 30, cv_pager)
    let b1: usize = fuiscene.button(pg, msg.get((&T_NEXT[0 as usize]) as u64), K_PGNEXT)
    fuiscene.set_size(b1, 130, 30)
    fuiscene.set_enabled(b1, s_page + 1 < pages())
    let sp1: usize = fuiscene.row(pg)
    fuiscene.set_grow(sp1, 1)
}

fn filled(p: u64) -> bool {
    return (*(p as *mut u8)) != 0 as u8
}

fn build_compat(col: usize, i: u64) {
    storecat2.ensure(name_at(i))
    if !storecat2.loaded() {
        return
    }
    let card: usize = fuiscene.card(col)
    sb_begin((&b_cat2[0 as usize]) as u64, 160)
    sb_s(msg.get((&T_DEVL[0 as usize]) as u64))
    sb_s(storecat2.developer())
    sb_s((&T_DOT[0 as usize]) as u64)
    sb_s(storecat2.category())
    sb_s((&T_DOT[0 as usize]) as u64)
    sb_s(storecat2.license())
    let _a: usize = fuiscene.label(card, (&b_cat2[0 as usize]) as u64)
    sb_begin((&b_cat2[0 as usize]) as u64 + 160, 480)
    sb_s(msg.get((&T_COMPATL[0 as usize]) as u64))
    sb_s(storecat2.level_key())
    let _b: usize = fuiscene.label_wrap(card, (&b_cat2[0 as usize]) as u64 + 160, 3)
    if filled(storecat2.notes()) {
        let _n: usize = fuiscene.label_wrap(card, storecat2.notes(), 3)
    }
    if filled(storecat2.limits()) {
        sb_begin((&b_cat2[0 as usize]) as u64 + 640, 400)
        sb_s(msg.get((&T_LIMITL[0 as usize]) as u64))
        sb_s(storecat2.limits())
        let _c: usize = fuiscene.label_wrap(card, (&b_cat2[0 as usize]) as u64 + 640, 4)
    }
    if filled(storecat2.tested()) {
        sb_begin((&b_cat2[0 as usize]) as u64 + 1040, 260)
        sb_s(msg.get((&T_TESTEDL[0 as usize]) as u64))
        sb_s(storecat2.tested())
        if filled(storecat2.gate()) {
            sb_s((&T_DOT[0 as usize]) as u64)
            sb_s(storecat2.gate())
        }
        let _d: usize = fuiscene.label_wrap(card, (&b_cat2[0 as usize]) as u64 + 1040, 2)
    }
}

fn build_detail(col: usize) {
    let i: u64 = s_detail
    let bk: usize = fuiscene.icon_button(col, icons.ARROW_LEFT, msg.get((&T_BACK[0 as usize]) as u64), K_BACK)
    fuiscene.set_size(bk, 36, 32)
    let _h: usize = fuiscene.canvas(col, 0, storegeom.side_w(), 104, cv_hero)
    ulib.strncpy((&b_det[0 as usize]) as u64, desc_of(i), 159)
    let _d: usize = fuiscene.label(col, (&b_det[0 as usize]) as u64)
    let _l: usize = fuiscene.label_wrap(col, msg.get((&T_LONG[0 as usize]) as u64), 2)
    if needs_text(i) {
        let _n: usize = fuiscene.label_wrap(col, (&b_need[0 as usize]) as u64, 2)
    }
    build_detail_actions(col, i)
    let card: usize = fuiscene.card(col)
    sb_begin((&b_inf[0 as usize]) as u64, 128)
    sb_s((&T_VERS[0 as usize]) as u64)
    sb_s(ver_at(i))
    let _a: usize = fuiscene.label(card, (&b_inf[0 as usize]) as u64)
    sb_begin((&b_inf[0 as usize]) as u64 + 128, 128)
    sb_s(msg.get((&T_SIZEL[0 as usize]) as u64))
    sb_size(bytes_at(i))
    let _b: usize = fuiscene.label(card, (&b_inf[0 as usize]) as u64 + 128)
    sb_begin((&b_inf[0 as usize]) as u64 + 256, 128)
    sb_s((&T_SRCL[0 as usize]) as u64)
    if s_source[0 as usize] != 0 as u8 {
        sb_s((&s_source[0 as usize]) as u64)
    } else {
        sb_s((&T_NOSRC[0 as usize]) as u64)
    }
    let _c: usize = fuiscene.label(card, (&b_inf[0 as usize]) as u64 + 256)
    let _e: usize = fuiscene.label_wrap(card, msg.get((&T_CHECK[0 as usize]) as u64), 2)
    build_compat(col, i)
}

fn build_detail_actions(col: usize, i: u64) {
    let ar: usize = fuiscene.row(col)
    fuiscene.set_gap(ar, 10)
    if job_is(i) {
        let _p: usize = fuiscene.progress(ar, 360, s_pct)
        sb_begin((&b_pcl[0 as usize]) as u64, 24)
        sb_n(s_pct)
        sb_s((&T_PCT[0 as usize]) as u64)
        let _q: usize = fuiscene.label(ar, (&b_pcl[0 as usize]) as u64)
        if storetabs.plan_total() > 1 {
            let _st: usize = fuiscene.label(ar, (&b_step[0 as usize]) as u64)
        }
    } else {
        let st: u64 = s_state[i as usize] as u64
        if st == 2 {
            let pb: usize = fuiscene.button_main(ar, msg.get((&T_UPDATE[0 as usize]) as u64), K_PRIMARY)
            fuiscene.set_size(pb, 150, 36)
            fuiscene.set_enabled(pb, can_act(i))
        } else if st == 1 {
            let ob: usize = fuiscene.button_main(ar, msg.get((&T_OPEN[0 as usize]) as u64), K_PRIMARY)
            fuiscene.set_size(ob, 150, 36)
        } else if st == 0 {
            let pb2: usize = fuiscene.button_main(ar, msg.get((&T_INSTALL[0 as usize]) as u64), K_PRIMARY)
            fuiscene.set_size(pb2, 150, 36)
            fuiscene.set_enabled(pb2, can_act(i))
        } else if st == ST_UNLISTED {
            let nb: usize = fuiscene.button(ar, msg.get((&T_NOPKG[0 as usize]) as u64), K_PRIMARY)
            fuiscene.set_size(nb, 200, 36)
            fuiscene.set_enabled(nb, false)
        }
        if st != ST_UNLISTED {
            let rb: usize = fuiscene.button(ar, msg.get((&T_REMOVE[0 as usize]) as u64), K_REMOVE)
            fuiscene.set_size(rb, 130, 36)
            fuiscene.set_enabled(rb, !s_busy && s_bus && s_can_r && st != 0 && s_system[i as usize] == 0 as u8)
        }
        if (st == 1 || st == 2) && s_system[i as usize] == 0 as u8 {
            let ag: usize = fuiscene.toggle(ar, msg.get((&T_AUTOAPP[0 as usize]) as u64), K_AUTOAPP, s_autooff[i as usize] == 0 as u8)
            fuiscene.set_enabled(ag, s_bus && s_can_i)
        }
        if st != 0 && st != ST_UNLISTED && storeautostart.offered(name_at(i)) {
            let _as: usize = fuiscene.toggle(ar, msg.get((&T_AUTOSTART[0 as usize]) as u64), K_AUTOSTART, storeautostart.enabled(name_at(i)))
        }
    }
}

fn empty_kind() -> u64 {
    if s_local && s_cat != CAT_INSTALLED {
        return 2
    }
    if s_count == 0 {
        if s_local && s_cat == CAT_INSTALLED {
            return 3
        }
        if !s_bus {
            return 2
        }
        if !s_busy && phase_is_failed((&s_phase[0 as usize]) as u64) {
            return 2
        }
        if s_busy || s_loading {
            return 9
        }
        return 4
    }
    if s_vis_n > 0 {
        return 99
    }
    if s_q[0 as usize] != 0 as u8 {
        return 0
    }
    if s_cat == 4 {
        return 1
    }
    if s_cat == 5 {
        return 3
    }
    return 0
}

fn fit_geometry() {
    var info_h: u64 = 0
    if s_info[0 as usize] != 0 as u8 {
        info_h = INFO_H
    }
    storegeom.compute(fuiscene.width(), fuiscene.height(), info_h)
}

fn build() {
    let root: usize = fuiscene.root()
    fuiscene.set_gap(root, 0)
    fuiscene.set_pad(root, 0)
    make_titles()
    fit_geometry()
    if s_page >= pages() {
        s_page = pages() - 1
    }
    let body: usize = fuiscene.row(root)
    fuiscene.set_gap(body, 8)
    fuiscene.set_grow(body, 1)
    let nav: usize = fuiscene.column(body)
    fuiscene.set_size(nav, NAV_W + 8, storegeom.content_h())
    fuiscene.set_pad(nav, 4)
    fuiscene.set_gap(nav, 4)
    build_nav(nav)
    let col: usize = fuiscene.layer(body)
    fuiscene.set_size(col, storegeom.content_w(), storegeom.content_h())
    fuiscene.set_gap(col, 12)
    fuiscene.set_pad(col, 16)
    let hr: usize = fuiscene.row(col)
    let hl: usize = fuiscene.row(hr)
    fuiscene.set_size(hl, (storegeom.side_w() - storegeom.entry_w()) / 2, 1)
    let _se: usize = fuiscene.entry(hr, K_SEARCH, storegeom.entry_w(), (&s_q[0 as usize]) as u64)
    fuiscene.entry_hint(K_SEARCH, msg.get((&T_HINT[0 as usize]) as u64))
    fuiscene.ax_name(K_SEARCH, msg.get((&T_HINT[0 as usize]) as u64))
    if s_detail != NONE && s_detail < s_count {
        build_detail(col)
    } else {
        let tr: usize = fuiscene.row(col)
        fuiscene.set_gap(tr, 8)
        if s_cat == 4 {
            let _tu: usize = fuiscene.canvas(tr, 0, 200, 32, cv_title)
            let tg: usize = fuiscene.toggle(tr, msg.get((&T_AUTOALL[0 as usize]) as u64), K_AUTOALL, s_auto_all)
            fuiscene.set_enabled(tg, s_bus && s_can_i)
        } else {
            let _ti: usize = fuiscene.canvas(tr, 0, 420, 32, cv_title)
        }
        let tsp: usize = fuiscene.row(tr)
        fuiscene.set_grow(tsp, 1)
        if s_cat == 1 {
            let _si: usize = fuiscene.toggle(tr, msg.get((&T_SHOWINST[0 as usize]) as u64), K_SHOWINST, storetabs.show_installed())
        }
        if s_cat == 4 && s_vis_n > 0 {
            let ua: usize = fuiscene.button_main(tr, msg.get((&T_ALLUP[0 as usize]) as u64), K_ALLUP)
            fuiscene.set_size(ua, 170, 34)
            fuiscene.set_enabled(ua, !s_busy && s_bus && s_can_i)
        }
        if s_cat != 4 {
            build_chips(col)
        }
        let ek: u64 = empty_kind()
        if ek == 99 {
            if s_cat == 4 {
                build_updates(col)
            } else {
                build_grid(col)
            }
            if pages() > 1 {
                let fill: usize = fuiscene.row(col)
                fuiscene.set_grow(fill, 1)
                build_pager(col)
            }
        } else if ek == 9 {
            let _sk: usize = fuiscene.canvas(col, 0, storegeom.side_w(), 320, cv_skel)
        } else {
            s_et_kind = ek
            let _em: usize = fuiscene.canvas(col, 0, storegeom.side_w(), 280, cv_empty)
            if ek == 2 {
                let rb: usize = fuiscene.button_main(col, msg.get((&T_RETRY[0 as usize]) as u64), K_RETRY)
                fuiscene.set_size(rb, 170, 36)
                fuiscene.set_enabled(rb, !s_busy)
            }
        }
    }
    if s_info[0 as usize] != 0 as u8 {
        let _i: usize = fuiscene.label_muted(root, (&s_info[0 as usize]) as u64)
    }
}

fn sync_info() {
    let inf: u64 = (&s_info[0 as usize]) as u64
    var a: u64 = 0
    if s_bus && (!s_can_i || !s_can_r) {
        a = puts(inf, a, msg.get((&T_RIGHTS[0 as usize]) as u64))
    }
    put(inf, a, 0)
}

fn warn_dialog() {
    let has_needs: bool = storetabs.plan_total() > 1 && needs_text(s_ask_item)
    var title: u64 = msg.get((&T_WARN_UNTESTED[0 as usize]) as u64)
    if storecat2.level_rank() == storecat2.LEVEL_PARTIAL {
        title = msg.get((&T_WARN_PARTIAL[0 as usize]) as u64)
    } else if storecat2.level_rank() == storecat2.LEVEL_BROKEN {
        title = msg.get((&T_WARN_BROKEN[0 as usize]) as u64)
    }
    sb_begin((&s_warn[0 as usize]) as u64, 400)
    sb_s((&s_ask_title[0 as usize]) as u64)
    if filled(storecat2.notes()) {
        sb_s((&T_DOT[0 as usize]) as u64)
        sb_s(storecat2.notes())
    } else {
        sb_s((&T_DOT[0 as usize]) as u64)
        sb_s(msg.get((&T_WARN_BODY[0 as usize]) as u64))
    }
    if has_needs {
        sb_s((&T_DOT[0 as usize]) as u64)
        sb_s((&b_need[0 as usize]) as u64)
    }
    fuiscene.dialog_open(title, (&s_warn[0 as usize]) as u64,
        msg.get((&T_YES_I[0 as usize]) as u64), msg.get((&T_NO[0 as usize]) as u64))
}

fn ask(verb: u64, item: u64) {
    if item == NONE || item >= s_count {
        notice(msg.get((&T_PICK[0 as usize]) as u64), 0)
        return
    }
    if s_state[item as usize] == ST_UNLISTED as u8 {
        return
    }
    if verb != 3 && !s_can_i {
        notice(msg.get((&T_DENIED[0 as usize]) as u64), 0)
        return
    }
    if verb == 3 && !s_can_r {
        notice(msg.get((&T_DENIED[0 as usize]) as u64), 0)
        return
    }
    ulib.strncpy((&s_ask_name[0 as usize]) as u64, name_at(item), 47)
    ulib.strncpy((&s_ask_title[0 as usize]) as u64, title_of(item), 63)
    s_ask_item = item
    s_ask_verb = verb
    storecat2.ensure(name_at(item))
    if verb == 1 {
        let _n: u64 = storetabs.plan_start(item)
    } else {
        storetabs.plan_clear()
    }
    if verb != 3 && storecat2.loaded() && storecat2.level_rank() != storecat2.LEVEL_WORKS {
        warn_dialog()
        return
    }
    if verb == 1 && storetabs.plan_total() > 1 && needs_text(item) {
        sb_begin((&s_warn[0 as usize]) as u64, 400)
        sb_s((&s_ask_title[0 as usize]) as u64)
        sb_s((&T_DOT[0 as usize]) as u64)
        sb_s((&b_need[0 as usize]) as u64)
        fuiscene.dialog_open(msg.get((&T_ASK_I[0 as usize]) as u64), (&s_warn[0 as usize]) as u64,
            msg.get((&T_YES_I[0 as usize]) as u64), msg.get((&T_NO[0 as usize]) as u64))
    } else if verb == 1 {
        fuiscene.dialog_open(msg.get((&T_ASK_I[0 as usize]) as u64), (&s_ask_title[0 as usize]) as u64,
            msg.get((&T_YES_I[0 as usize]) as u64), msg.get((&T_NO[0 as usize]) as u64))
    } else if verb == 2 {
        fuiscene.dialog_open(msg.get((&T_ASK_U[0 as usize]) as u64), (&s_ask_title[0 as usize]) as u64,
            msg.get((&T_YES_U[0 as usize]) as u64), msg.get((&T_NO[0 as usize]) as u64))
    } else {
        fuiscene.dialog_open(msg.get((&T_ASK_R[0 as usize]) as u64), (&s_ask_title[0 as usize]) as u64,
            msg.get((&T_YES_R[0 as usize]) as u64), msg.get((&T_NO[0 as usize]) as u64))
    }
}

fn ask_all() {
    if !s_can_i {
        notice(msg.get((&T_DENIED[0 as usize]) as u64), 0)
        return
    }
    sb_begin((&s_batch[0 as usize]) as u64, 40)
    sb_n(s_n_upd)
    if s_n_upd == 1 {
        sb_s(msg.get((&T_PROG1[0 as usize]) as u64))
    } else {
        sb_s(msg.get((&T_PROGN[0 as usize]) as u64))
    }
    s_ask_verb = 4
    fuiscene.dialog_open(msg.get((&T_ASK_A[0 as usize]) as u64), (&s_batch[0 as usize]) as u64,
        msg.get((&T_YES_U[0 as usize]) as u64), msg.get((&T_NO[0 as usize]) as u64))
}

fn queue_fill() {
    var i: u64 = 0
    while i < MAXI {
        s_queue[i as usize] = 0 as u8
        if i < s_count && s_state[i as usize] == 2 as u8 {
            s_queue[i as usize] = 1 as u8
        }
        i = i + 1
    }
}

fn queue_left() -> bool {
    var i: u64 = 0
    while i < s_count {
        if s_queue[i as usize] != 0 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

fn queue_next() -> bool {
    var i: u64 = 0
    while i < s_count {
        if s_queue[i as usize] != 0 as u8 {
            s_queue[i as usize] = 0 as u8
            if call_verb((&V_UPDATE[0 as usize]) as u64, name_at(i)) {
                s_busy = true
                return true
            }
            return false
        }
        i = i + 1
    }
    return false
}

fn queue_clear() {
    var i: u64 = 0
    while i < MAXI {
        s_queue[i as usize] = 0 as u8
        i = i + 1
    }
}

fn batch_list() -> u64 {
    if !actcli.open() {
        lineout.add_text(msg.get((&T_NOBUS[0 as usize]) as u64))
        lineout.end_line()
        return 1
    }
    actcli.req((&V_LIST[0 as usize]) as u64)
    if actcli.send(300) != actcli.R_OK {
        lineout.add_text(msg.get((&T_NOBUS[0 as usize]) as u64))
        lineout.end_line()
        return 1
    }
    lineout.add_text(actcli.reply())
    return 0
}

fn go_cat(id: u64) {
    s_cat = id
    s_page = 0
    s_detail = NONE
    refilter()
}

fn open_detail(i: u64) {
    if i < s_count {
        s_detail = i
        storeautostart.refresh()
    }
}

fn grid_move(k: u64, key: u64) {
    let pp: u64 = per_page()
    let cnt: u64 = pagegrid.grid_page_count(s_vis_n, s_page, pp)
    var dir: u64 = pagegrid.GRID_DOWN
    if key == hostkey.KEY_LEFT {
        dir = pagegrid.GRID_LEFT
    } else if key == hostkey.KEY_RIGHT {
        dir = pagegrid.GRID_RIGHT
    } else if key == hostkey.KEY_UP {
        dir = pagegrid.GRID_UP
    }
    var cols: u64 = storegeom.cols()
    var base: u64 = K_TILE
    if s_cat == 4 {
        cols = 1
        base = K_ROW
    }
    if dir == pagegrid.GRID_UP && k < cols && s_cat != 4 {
        fuiscene.focus(K_SEARCH)
        return
    }
    fuiscene.focus(base + pagegrid.grid_move(k, cnt, cols, dir))
}

fn parse_size(p: u64) {
    s_arg_w = 0
    s_arg_h = 0
    var i: u64 = 0
    var on_height: bool = false
    while (*((p + i) as *mut u8)) != 0 as u8 {
        let c: u64 = (*((p + i) as *mut u8)) as u64
        if c == 120 {
            on_height = true
        } else if c >= 48 && c <= 57 {
            if on_height {
                s_arg_h = s_arg_h * 10 + (c - 48)
            } else {
                s_arg_w = s_arg_w * 10 + (c - 48)
            }
        }
        i = i + 1
    }
}

fn u_start(args: u64) -> u64 {
    let _mi: u64 = msg.init()
    var o_list: [u8; 7] = "--list\0"
    var size_w: u64 = 0
    var size_h: u64 = 0
    if ulib.arg_count(args) >= 3 && ulib.streq(ulib.arg_at(args, 1), (&O_SIZE[0 as usize]) as u64) {
        parse_size(ulib.arg_at(args, 2))
        size_w = s_arg_w
        size_h = s_arg_h
    }
    if ulib.arg_count(args) >= 2 && ulib.streq(ulib.arg_at(args, 1), (&o_list[0 as usize]) as u64) {
        return batch_list()
    }
    var o_installed: [u8; 17] = "--show-installed\0"
    var a: u64 = 1
    while a < ulib.arg_count(args) {
        if ulib.streq(ulib.arg_at(args, a), (&o_installed[0 as usize]) as u64) {
            storetabs.set_show_installed(true)
        }
        a = a + 1
    }
    fuiapp.set_atomic(true)
    if !fuiscene.open(40, 24, WIN_W, WIN_H, (&T_APP[0 as usize]) as u64, build) {
        return 1
    }
    var win_app_name: [u8; 6] = "store\0"
    fuiscene.set_app((&win_app_name[0 as usize]) as u64)
    s_detail = NONE
    s_loading = true
    load_list()
    load_status()
    sync_info()
    if size_w != 0 && size_h != 0 {
        let _sz: bool = fuiscene.win_size(size_w, size_h)
    } else if ulib.arg_count(args) >= 2 {
        open_by_arg(ulib.arg_at(args, 1))
    }
    var target: [u8; 96] = [0 as u8; 96]
    if deeplink.target_of(args, (&target[0 as usize]) as u64, deeplink.URI_CAP) > 0 {
        open_by_arg((&target[0 as usize]) as u64)
    }
    fuiscene.refresh()
    var rounds: u64 = 0
    var wait_empty: bool = s_count == 0 && s_bus
    var was_busy: bool = false
    var q_shown: u64 = 0
    while fuiscene.alive() && rounds < 1000000000000 {
        rounds = rounds + 1
        let key: u64 = fuiscene.pump()
        var changed: bool = false
        if fuiscene.painted() != s_traced && fuiscene.trace_on() {
            s_traced = fuiscene.painted()
            fuiscene.say_rects((&T_APP[0 as usize]) as u64)
            fuiscene.say_texts()
            lineout.add_text((&S_GEOM[0 as usize]) as u64)
            lineout.add_unum(storegeom.cols())
            lineout.add_text((&S_ROWS[0 as usize]) as u64)
            lineout.add_unum(storegeom.rows())
            lineout.add_text((&S_WIDTH[0 as usize]) as u64)
            lineout.add_unum(fuiscene.width())
            lineout.add_text((&S_HEIGHT[0 as usize]) as u64)
            lineout.add_unum(fuiscene.height())
            lineout.end_line()
            lineout.add_text((&S_TILES[0 as usize]) as u64)
            if s_detail != NONE {
                lineout.add_unum(0)
            } else {
                lineout.add_unum(pagegrid.grid_page_count(s_vis_n, s_page, per_page()))
            }
            lineout.add_text((&S_HITS[0 as usize]) as u64)
            lineout.add_unum(s_vis_n)
            lineout.end_line()
        }
        let rseq: u64 = fuiscene.resized()
        if rseq != s_rseq {
            s_rseq = rseq
            fit_geometry()
            refilter()
            changed = true
        }
        let dr: u64 = fuiscene.dialog_result()
        if dr == 1 && s_ask_verb != 0 {
            if s_ask_verb == 4 {
                queue_fill()
                if queue_next() {
                    s_busy = true
                }
            } else if s_ask_verb == 1 && storetabs.plan_total() > 1 {
                let _r: bool = plan_step_run()
            } else {
                var vb: u64 = (&V_INSTALL[0 as usize]) as u64
                if s_ask_verb == 2 {
                    vb = (&V_UPDATE[0 as usize]) as u64
                } else if s_ask_verb == 3 {
                    vb = (&V_REMOVE[0 as usize]) as u64
                }
                if call_verb(vb, (&s_ask_name[0 as usize]) as u64) {
                    s_busy = true
                }
            }
            s_ask_verb = 0
            changed = true
        } else if dr == 2 {
            s_ask_verb = 0
            storetabs.plan_clear()
        }
        if key == K_REFRESH || key == K_RETRY {
            s_loading = true
            if !s_bus {
                load_list()
            }
            if call_verb((&V_REFRESH[0 as usize]) as u64, 0) {
                s_busy = true
            }
            changed = true
        } else if key == K_BACK {
            s_detail = NONE
            changed = true
        } else if key == K_WORKS {
            s_works = !s_works
            s_page = 0
            refilter()
            changed = true
        } else if key >= K_CHIP && key < K_CHIP + s_chip_n {
            s_chip = key - K_CHIP
            s_page = 0
            refilter()
            changed = true
        } else if key >= K_NAV && key < K_NAV + s_nav_n {
            go_cat(s_nav_id[(key - K_NAV) as usize])
            changed = true
        } else if key >= K_TILE && key < K_TILE + storegeom.per_page() {
            let slot: u64 = s_page * storegeom.per_page() + (key - K_TILE)
            if slot < s_vis_n {
                open_detail(s_vis[slot as usize])
            }
            changed = true
        } else if key >= K_QACT && key < K_QACT + storegeom.per_page() {
            let slot2: u64 = s_page * storegeom.per_page() + (key - K_QACT)
            if slot2 < s_vis_n {
                let it: u64 = s_vis[slot2 as usize]
                if s_state[it as usize] == 1 as u8 {
                    let _o: bool = open_app(it)
                } else if s_state[it as usize] == 2 as u8 {
                    ask(2, it)
                } else {
                    ask(1, it)
                }
            }
        } else if key >= K_ROW && key < K_ROW + storegeom.per_page_up() {
            let slot3: u64 = s_page * storegeom.per_page_up() + (key - K_ROW)
            if slot3 < s_vis_n {
                open_detail(s_vis[slot3 as usize])
            }
            changed = true
        } else if key >= K_ROWACT && key < K_ROWACT + storegeom.per_page_up() {
            let slot4: u64 = s_page * storegeom.per_page_up() + (key - K_ROWACT)
            if slot4 < s_vis_n {
                ask(2, s_vis[slot4 as usize])
            }
        } else if key == K_PRIMARY {
            if s_detail != NONE {
                if s_state[s_detail as usize] == 2 as u8 {
                    ask(2, s_detail)
                } else if s_state[s_detail as usize] == 1 as u8 {
                    let _o: bool = open_app(s_detail)
                } else {
                    ask(1, s_detail)
                }
            }
        } else if key == K_REMOVE {
            ask(3, s_detail)
        } else if key == K_ALLUP {
            ask_all()
        } else if key == K_SHOWINST {
            storetabs.set_show_installed(!storetabs.show_installed())
            s_page = 0
            refilter()
            changed = true
        } else if key == K_AUTOALL {
            set_auto(0, !s_auto_all)
            changed = true
        } else if key == K_AUTOAPP && s_detail != NONE {
            set_auto(name_at(s_detail), s_autooff[s_detail as usize] == 1 as u8)
            changed = true
        } else if key == K_AUTOSTART && s_detail != NONE {
            let _t: bool = storeautostart.toggle(name_at(s_detail))
            storeautostart.refresh()
            changed = true
        } else if key == K_PGPREV {
            if s_page > 0 {
                s_page = s_page - 1
            }
            changed = true
        } else if key == K_PGNEXT {
            if s_page + 1 < pages() {
                s_page = s_page + 1
            }
            changed = true
        }
        let ks: u64 = fuiscene.key_seq()
        if ks != s_kseq {
            s_kseq = ks
            let ka: u64 = fuiscene.key_any()
            let fk: u64 = fuiscene.focus_key()
            if ka == hostkey.KEY_CTRL_F {
                s_detail = NONE
                fuiscene.refresh()
                fuiscene.focus(K_SEARCH)
                changed = true
            } else if ka == hostkey.KEY_ESC && !fuiscene.dialog_is_open() {
                if s_detail != NONE {
                    s_detail = NONE
                    changed = true
                } else if s_q[0 as usize] != 0 as u8 {
                    s_q[0 as usize] = 0 as u8
                    fuiscene.entry_set(K_SEARCH, (&s_q[0 as usize]) as u64)
                    refilter()
                    changed = true
                }
            } else if ka == hostkey.KEY_PGDN && s_detail == NONE {
                if s_page + 1 < pages() {
                    s_page = s_page + 1
                    changed = true
                }
            } else if ka == hostkey.KEY_PGUP && s_detail == NONE {
                if s_page > 0 {
                    s_page = s_page - 1
                    changed = true
                }
            } else if s_detail == NONE && (ka == hostkey.KEY_LEFT || ka == hostkey.KEY_RIGHT || ka == hostkey.KEY_UP || ka == hostkey.KEY_DOWN) {
                if s_cat == 4 && fk >= K_ROW && fk < K_ROW + storegeom.per_page_up() {
                    grid_move(fk - K_ROW, ka)
                } else if fk >= K_TILE && fk < K_TILE + storegeom.per_page() {
                    grid_move(fk - K_TILE, ka)
                } else if fk == K_SEARCH && ka == hostkey.KEY_DOWN && s_vis_n > 0 {
                    if s_cat == 4 {
                        fuiscene.focus(K_ROW)
                    } else {
                        fuiscene.focus(K_TILE)
                    }
                }
            }
        }
        let k: u64 = fuiscene.last_key()
        if (k == 114 || k == 0xF5) && !s_busy {
            s_loading = true
            if call_verb((&V_REFRESH[0 as usize]) as u64, 0) {
                s_busy = true
            }
            changed = true
        }
        if wait_empty {
            wait_empty = false
            if call_verb((&V_REFRESH[0 as usize]) as u64, 0) {
                s_busy = true
            }
            changed = true
        }
        let qp: u64 = fuiscene.entry_text(K_SEARCH)
        if qp != 0 && !ulib.streq(qp, (&s_q[0 as usize]) as u64) {
            ulib.strncpy((&s_q[0 as usize]) as u64, qp, 63)
            s_page = 0
            refilter()
            changed = true
        }
        if s_busy {
            let now: u64 = fuiapp.now_ms()
            if now - s_polled > 250 {
                s_polled = now
                load_status()
                if s_askno != 0 {
                    if s_busy {
                        s_askno = 0
                    } else {
                        s_pct_srv = 0
                        ask_check()
                    }
                }
                if s_pct_srv > s_pct {
                    s_pct = s_pct_srv
                }
                if s_pct != q_shown {
                    q_shown = s_pct
                    lineout.add_text((&S_PCTT[0 as usize]) as u64)
                    lineout.add_unum(s_pct)
                    lineout.end_line()
                }
                if !s_busy {
                    s_loading = false
                    load_list()
                    if phase_is_failed((&s_phase[0 as usize]) as u64) {
                        queue_clear()
                        storetabs.plan_clear()
                    } else if queue_left() {
                        if queue_next() {
                            s_busy = true
                        }
                    } else if storetabs.plan_active() {
                        let _r: bool = plan_step_run()
                    } else {
                        storetabs.plan_clear()
                    }
                }
                changed = true
            }
        }
        if was_busy != s_busy {
            was_busy = s_busy
            changed = true
        }
        if s_detail != NONE && s_detail >= s_count {
            s_detail = NONE
            changed = true
        }
        if changed {
            sync_info()
            fuiscene.refresh()
        }
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
