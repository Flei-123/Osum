// ------------------------------------------------------------------ string building
static mut sb_buf: u64 = 0
static mut sb_at: u64 = 0
static mut sb_cap: u64 = 0

fn sb_begin(buf: u64, cap: u64) {
    sb_buf = buf
    sb_at = 0
    sb_cap = cap
    __mmio_write8(buf as *mut u8, 0 as u8)
}

fn sb_c(c: u64) {
    if sb_at + 1 < sb_cap {
        __mmio_write8((sb_buf + sb_at) as *mut u8, c as u8)
        sb_at = sb_at + 1
        __mmio_write8((sb_buf + sb_at) as *mut u8, 0 as u8)
    }
}

fn sb_s(p: u64) {
    var i: u64 = 0
    while (*((p + i) as *mut u8)) != 0 as u8 {
        sb_c((*((p + i) as *mut u8)) as u64)
        i = i + 1
    }
}

fn sb_n(v: u64) {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = ulib.digits(v, (&z[0 as usize]) as u64)
    var i: u64 = 0
    while i < n {
        sb_c(z[i as usize] as u64)
        i = i + 1
    }
}

fn sb_size(bytes: u64) {
    if bytes >= 1048576 {
        sb_n(bytes / 1048576)
        sb_s((&T_SIZE_M[0 as usize]) as u64)
    } else if bytes >= 1024 {
        sb_n(bytes / 1024)
        sb_s((&T_SIZE_K[0 as usize]) as u64)
    } else {
        sb_n(bytes)
        sb_s((&T_SIZE_B[0 as usize]) as u64)
    }
}

fn put(buf: u64, at: u64, c: u64) -> u64 {
    __mmio_write8((buf + at) as *mut u8, c as u8)
    return at + 1
}

fn puts(buf: u64, at: u64, p: u64) -> u64 {
    var i: u64 = 0
    var a: u64 = at
    while (*((p + i) as *mut u8)) != 0 as u8 {
        a = put(buf, a, (*((p + i) as *mut u8)) as u64)
        i = i + 1
    }
    return a
}

fn putn(buf: u64, at: u64, v: u64) -> u64 {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = ulib.digits(v, (&z[0 as usize]) as u64)
    var a: u64 = at
    var i: u64 = 0
    while i < n {
        a = put(buf, a, z[i as usize] as u64)
        i = i + 1
    }
    return a
}

fn set_status(a: u64, b: u64) {
    let st: u64 = (&s_status[0 as usize]) as u64
    var at: u64 = 0
    if a != 0 {
        at = puts(st, at, a)
    }
    if b != 0 {
        at = puts(st, at, b)
    }
    put(st, at, 0)
}

// ------------------------------------------------------------------ the catalog in memory
fn name_at(i: u64) -> u64 {
    return (&s_names[0 as usize]) as u64 + i * NAMEW
}

fn ver_at(i: u64) -> u64 {
    return name_at(i) + 24
}

fn bytes_at(i: u64) -> u64 {
    var sz: u64 = 0
    var k: u64 = name_at(i) + 36
    while (*(k as *mut u8)) >= 48 as u8 && (*(k as *mut u8)) <= 57 as u8 {
        sz = sz * 10 + ((*(k as *mut u8)) as u64 - 48)
        k = k + 1
    }
    return sz
}

fn lc(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

// does `s` start with `pre` (lower case compare)
fn starts(s: u64, pre: u64) -> bool {
    var i: u64 = 0
    while (*((pre + i) as *mut u8)) != 0 as u8 {
        if lc((*((s + i) as *mut u8)) as u64) != lc((*((pre + i) as *mut u8)) as u64) {
            return false
        }
        i = i + 1
    }
    return true
}

// does `hay` contain `needle` (lower case, plain octets)
fn contains(hay: u64, needle: u64) -> bool {
    if (*(needle as *mut u8)) == 0 as u8 {
        return true
    }
    var i: u64 = 0
    while (*((hay + i) as *mut u8)) != 0 as u8 {
        if starts(hay + i, needle) {
            return true
        }
        i = i + 1
    }
    return false
}

// the META line of a program (start of the line), or 0
fn meta_line(name: u64) -> u64 {
    let m: u64 = (&META[0 as usize]) as u64
    var at: u64 = 0
    while (*((m + at) as *mut u8)) != 0 as u8 {
        var i: u64 = 0
        var same: bool = true
        while (*((name + i) as *mut u8)) != 0 as u8 {
            if (*((m + at + i) as *mut u8)) != (*((name + i) as *mut u8)) {
                same = false
            }
            i = i + 1
        }
        if same && (*((m + at + i) as *mut u8)) == 124 as u8 {
            return m + at
        }
        while (*((m + at) as *mut u8)) != 10 as u8 && (*((m + at) as *mut u8)) != 0 as u8 {
            at = at + 1
        }
        if (*((m + at) as *mut u8)) == 10 as u8 {
            at = at + 1
        }
    }
    return 0
}

// class of a program: 0 program, 1 theme, 2 fonts and media
fn class_of(i: u64) -> u64 {
    let nm: u64 = name_at(i)
    let ln: u64 = meta_line(nm)
    if ln != 0 {
        var j: u64 = 0
        while (*((ln + j) as *mut u8)) != 124 as u8 {
            j = j + 1
        }
        return (*((ln + j + 1) as *mut u8)) as u64 - 48
    }
    if starts(nm, (&P_THEME[0 as usize]) as u64) {
        return 1
    }
    if starts(nm, (&P_FONT[0 as usize]) as u64) || starts(nm, (&P_MEDIA[0 as usize]) as u64) {
        return 2
    }
    return 0
}

fn app_text(i: u64, pre: u64, out: u64, cap: u64) -> bool {
    var k: [u8; 64] = [0 as u8; 64]
    ulib.strcpy((&k[0 as usize]) as u64, pre)
    ulib.strcat((&k[0 as usize]) as u64, name_at(i))
    let v: u64 = msg.get((&k[0 as usize]) as u64)
    if v == (&k[0 as usize]) as u64 || (*(v as *mut u8)) == 0 as u8 {
        return false
    }
    ulib.strncpy(out, v, cap)
    return true
}

fn desc_of(i: u64) -> u64 {
    let d: u64 = (&b_dsc[0 as usize]) as u64
    var pre: [u8; 11] = "store.app.\0"
    if !app_text(i, (&pre[0 as usize]) as u64, d, 127) {
        ulib.strncpy(d, msg.get((&T_GENERIC[0 as usize]) as u64), 127)
    }
    return d
}

fn title_of(i: u64) -> u64 {
    let d: u64 = (&b_disp[0 as usize]) as u64
    var pre: [u8; 12] = "store.name.\0"
    if !app_text(i, (&pre[0 as usize]) as u64, d, 63) {
        ulib.strncpy(d, name_at(i), 63)
        let c: u64 = (*(d as *mut u8)) as u64
        if c >= 97 && c <= 122 {
            *(d as *mut u8) = (c - 32) as u8
        }
    }
    return d
}

fn item_match(i: u64) -> bool {
    let cls: u64 = class_of(i)
    let st: u64 = s_state[i as usize] as u64
    if s_cat == 1 && cls != 0 {
        return false
    }
    if s_cat == 2 && cls != 1 {
        return false
    }
    if s_cat == 3 && cls != 2 {
        return false
    }
    if s_cat == 4 && st != 2 {
        return false
    }
    if s_cat == 5 && st == 0 {
        return false
    }
    if s_chip > 0 && s_chip < s_chip_n {
        if !ulib.streq(cat_of(i), (&b_chip[0 as usize]) as u64 + s_chip * 32) {
            return false
        }
    }
    let q: u64 = (&s_q[0 as usize]) as u64
    if (*(q as *mut u8)) != 0 as u8 {
        let hit: bool = contains(name_at(i), q) || contains(title_of(i), q)
        if !hit {
            let d: u64 = desc_of(i)
            return contains(d, q)
        }
    }
    return true
}

fn per_page() -> u64 {
    if s_cat == 4 {
        return PER_PAGE_UP
    }
    return PER_PAGE
}

fn pages() -> u64 {
    return grid.grid_pages(s_vis_n, per_page())
}

fn refilter() {
    s_vis_n = 0
    var i: u64 = 0
    while i < s_count {
        if item_match(i) {
            s_vis[s_vis_n as usize] = i
            s_vis_n = s_vis_n + 1
        }
        i = i + 1
    }
    if s_page >= pages() {
        s_page = pages() - 1
    }
}

fn count_classes() {
    s_n_upd = 0
    s_n_inst = 0
    s_n_cls[0 as usize] = 0
    s_n_cls[1 as usize] = 0
    s_n_cls[2 as usize] = 0
    var i: u64 = 0
    while i < s_count {
        let st: u64 = s_state[i as usize] as u64
        if st == 2 {
            s_n_upd = s_n_upd + 1
        }
        if st != 0 {
            s_n_inst = s_n_inst + 1
        }
        let c: u64 = class_of(i)
        s_n_cls[c as usize] = s_n_cls[c as usize] + 1
        i = i + 1
    }
}

// ------------------------------------------------------------------ the bus
// the value after `key` at the start of line `lp`, into out; false if the line is another
fn kv(lp: u64, key: u64, out: u64, max: u64) -> bool {
    let kl: u64 = ulib.length(key)
    var i: u64 = 0
    while i < kl {
        if (*((lp + i) as *mut u8)) != (*((key + i) as *mut u8)) {
            return false
        }
        i = i + 1
    }
    var o: u64 = 0
    while (*((lp + kl + o) as *mut u8)) != 0 as u8 && o + 1 < max {
        __mmio_write8((out + o) as *mut u8, *((lp + kl + o) as *mut u8))
        o = o + 1
    }
    __mmio_write8((out + o) as *mut u8, 0 as u8)
    return true
}

fn parse_num(p: u64) -> u64 {
    var v: u64 = 0
    var k: u64 = p
    while (*(k as *mut u8)) >= 48 as u8 && (*(k as *mut u8)) <= 57 as u8 {
        v = v * 10 + ((*(k as *mut u8)) as u64 - 48)
        k = k + 1
    }
    return v
}

fn load_list() {
    s_count = 0
    s_can_i = false
    s_can_r = false
    s_source[0 as usize] = 0 as u8
    if !actcli.open() {
        s_bus = false
        set_status(msg.get((&T_NOBUS[0 as usize]) as u64), 0)
        return
    }
    actcli.req((&V_LIST[0 as usize]) as u64)
    if actcli.send(300) != actcli.R_OK {
        s_bus = false
        set_status(msg.get((&T_NOBUS[0 as usize]) as u64), 0)
        return
    }
    s_bus = true
    var ln: [u8; 160] = [0 as u8; 160]
    let lp: u64 = (&ln[0 as usize]) as u64
    var v: [u8; 40] = [0 as u8; 40]
    var n: u64 = 1
    while actcli.line(n, lp, 160) {
        let _src: bool = kv(lp, (&S_SRC[0 as usize]) as u64, (&s_source[0 as usize]) as u64, 100)
        if kv(lp, (&S_CI[0 as usize]) as u64, (&v[0 as usize]) as u64, 40) {
            s_can_i = (*((&v[0 as usize]) as *mut u8)) == 49 as u8
        } else if kv(lp, (&S_CR[0 as usize]) as u64, (&v[0 as usize]) as u64, 40) {
            s_can_r = (*((&v[0 as usize]) as *mut u8)) == 49 as u8
        } else if kv(lp, (&S_ITEM[0 as usize]) as u64, (&s_tmp[0 as usize]) as u64, 160) && s_count < MAXI {
            // name|version|size|state -> a row: name at +0, version at +24, size at +36
            let t: u64 = (&s_tmp[0 as usize]) as u64
            let row: u64 = name_at(s_count)
            var f: u64 = 0
            var o: u64 = 0
            var i: u64 = 0
            ulib.fill(row, 0, NAMEW)
            s_state[s_count as usize] = 0 as u8
            while (*((t + i) as *mut u8)) != 0 as u8 {
                let c: u64 = (*((t + i) as *mut u8)) as u64
                if c == 124 {
                    f = f + 1
                    o = 0
                } else {
                    var base: u64 = 0
                    var cap: u64 = 23
                    if f == 1 {
                        base = 24
                        cap = 11
                    } else if f == 2 {
                        base = 36
                        cap = 11
                    }
                    if f <= 2 && o < cap {
                        __mmio_write8((row + base + o) as *mut u8, c as u8)
                        o = o + 1
                    } else if f == 3 {
                        // only the first letter decides: n(eu), a(ktuell), u(pdate)
                        if o == 0 {
                            if c == 110 {
                                s_state[s_count as usize] = 0 as u8
                            } else if c == 97 {
                                s_state[s_count as usize] = 1 as u8
                            } else if c == 117 {
                                s_state[s_count as usize] = 2 as u8
                            }
                        }
                        o = o + 1
                    }
                }
                i = i + 1
            }
            s_count = s_count + 1
        }
        n = n + 1
    }
    count_classes()
    refilter()
    if s_count == 0 {
        set_status(msg.get((&T_EMPTY[0 as usize]) as u64), 0)
    }
    ulib.say((&S_LISTED[0 as usize]) as u64)
    ulib.sayu(s_count)
    ulib.nl()
}

fn load_status() {
    if !actcli.open() {
        return
    }
    actcli.req((&V_STATUS[0 as usize]) as u64)
    if actcli.send(300) != actcli.R_OK {
        return
    }
    var ln: [u8; 160] = [0 as u8; 160]
    let lp: u64 = (&ln[0 as usize]) as u64
    var ph: [u8; 16] = [0 as u8; 16]
    var ms: [u8; 160] = [0 as u8; 160]
    var vb: [u8; 16] = [0 as u8; 16]
    var nm: [u8; 64] = [0 as u8; 64]
    var bz: [u8; 8] = [0 as u8; 8]
    var pc: [u8; 8] = [0 as u8; 8]
    var n: u64 = 1
    while actcli.line(n, lp, 160) {
        let _a: bool = kv(lp, (&S_PH[0 as usize]) as u64, (&ph[0 as usize]) as u64, 16)
        let _b: bool = kv(lp, (&S_MS[0 as usize]) as u64, (&ms[0 as usize]) as u64, 160)
        let _c: bool = kv(lp, (&S_VB[0 as usize]) as u64, (&vb[0 as usize]) as u64, 16)
        let _d: bool = kv(lp, (&S_NM[0 as usize]) as u64, (&nm[0 as usize]) as u64, 64)
        let _e: bool = kv(lp, (&S_BZ[0 as usize]) as u64, (&bz[0 as usize]) as u64, 8)
        let _f: bool = kv(lp, (&S_PC[0 as usize]) as u64, (&pc[0 as usize]) as u64, 8)
        n = n + 1
    }
    s_busy = (*((&bz[0 as usize]) as *mut u8)) == 49 as u8
    ulib.strcpy((&s_phase[0 as usize]) as u64, (&ph[0 as usize]) as u64)
    ulib.strcpy((&s_verb[0 as usize]) as u64, (&vb[0 as usize]) as u64)
    ulib.strcpy((&s_job[0 as usize]) as u64, (&nm[0 as usize]) as u64)
    s_pct_srv = parse_num((&pc[0 as usize]) as u64)
    if s_pct_srv > 100 {
        s_pct_srv = 100
    }
    var done: [u8; 7] = "fertig\0"
    var fehler: [u8; 7] = "fehler\0"
    if s_busy {
        set_status((&T_BUSY[0 as usize]) as u64, 0)
    } else if ulib.streq((&ph[0 as usize]) as u64, (&done[0 as usize]) as u64) {
        set_status((&T_DONE[0 as usize]) as u64, (&ms[0 as usize]) as u64)
    } else if ulib.streq((&ph[0 as usize]) as u64, (&fehler[0 as usize]) as u64) {
        set_status(msg.get((&T_FAIL[0 as usize]) as u64), (&ms[0 as usize]) as u64)
    }
    ulib.say((&S_ST[0 as usize]) as u64)
    ulib.say((&ph[0 as usize]) as u64)
    if ms[0 as usize] != 0 as u8 {
        ulib.say((&T_SP[0 as usize]) as u64)
        ulib.say((&ms[0 as usize]) as u64)
    }
    ulib.nl()
}

// one call to the provider; a critical one comes back as a question that THIS
// window has already put to the person -- so it is confirmed at once
fn call_verb(verb: u64, name: u64) -> bool {
    if !actcli.open() {
        set_status(msg.get((&T_NOBUS[0 as usize]) as u64), 0)
        return false
    }
    actcli.req(verb)
    if name != 0 {
        actcli.arg((&K_NAMEARG[0 as usize]) as u64, name)
    }
    var rc: u64 = actcli.send(300)
    if rc == actcli.R_CONFIRM {
        // A critical call is parked by the broker and put to the person in the SYSTEM dialog (painted by the window
        // server, answered by the real keyboard / mouse only). This window must not confirm it itself -- the broker
        // refuses that with `use_dialog` -- so it only says what is going on. If the answer is yes the provider starts
        // the job and the progress poll picks it up; if it is no (or 60 s pass) nothing starts.
        ulib.say((&S_ASK[0 as usize]) as u64)
        ulib.sayu(rc)
        ulib.nl()
        set_status(msg.get((&T_ASKSYS[0 as usize]) as u64), 0)
        // the token number is the second word of the reply line: "confirm <n> ..."
        var cl: [u8; 40] = [0 as u8; 40]
        let cp: u64 = (&cl[0 as usize]) as u64
        s_askno = 0
        s_grace = 0
        if actcli.line(0, cp, 40) {
            var q: u64 = 0
            while (*((cp + q) as *mut u8)) != 0 as u8 && (*((cp + q) as *mut u8)) != 32 as u8 {
                q = q + 1
            }
            s_askno = parse_num(cp + q + 1)
        }
        s_pct = 2
        s_pct_srv = 0
        return true
    }
    ulib.say((&S_ASK[0 as usize]) as u64)
    ulib.sayu(rc)
    ulib.nl()
    if rc == actcli.R_OK {
        set_status((&T_SENT[0 as usize]) as u64, 0)
        s_pct = 2
        s_pct_srv = 0
        return true
    }
    var ln2: [u8; 160] = [0 as u8; 160]
    let lp2: u64 = (&ln2[0 as usize]) as u64
    let _l2: bool = actcli.line(0, lp2, 160)
    var denied: [u8; 12] = "not_allowed\0"
    if ulib.find(lp2, (&denied[0 as usize]) as u64) != 0xFFFFFFFFFFFFFFFF {
        set_status(msg.get((&T_DENIED[0 as usize]) as u64), 0)
    } else if ulib.find(lp2, (&K_USEDLG[0 as usize]) as u64) != 0xFFFFFFFFFFFFFFFF {
        set_status(msg.get((&T_ASKSYS[0 as usize]) as u64), 0)
    } else {
        set_status(msg.get((&T_FAIL[0 as usize]) as u64), lp2)
    }
    return false
}

// The question went to the system dialog. Still open -> keep waiting (the broker refuses our own
// `confirm` with use_dialog while it stands). Gone -> the answer was yes (the provider starts within a few
// polls: status goes busy) or no / timeout (nothing starts: say so).
fn ask_check() {
    if s_grace > 0 {
        s_grace = s_grace - 1
        if s_grace == 0 {
            s_askno = 0
            s_pct = 0
            set_status((&T_REJECTED[0 as usize]) as u64, 0)
            return
        }
        s_busy = true
        return
    }
    if !actcli.open() {
        s_askno = 0
        return
    }
    actcli.req_num((&V_CONFIRM[0 as usize]) as u64, s_askno)
    let rc: u64 = actcli.send(300)
    var ln: [u8; 80] = [0 as u8; 80]
    let lp: u64 = (&ln[0 as usize]) as u64
    let _l: bool = actcli.line(0, lp, 80)
    if rc != actcli.R_ERR || ulib.find(lp, (&K_USEDLG[0 as usize]) as u64) != 0xFFFFFFFFFFFFFFFF {
        s_busy = true
    } else if ulib.find(lp, (&K_NOREQ[0 as usize]) as u64) != 0xFFFFFFFFFFFFFFFF {
        s_grace = 6
        s_busy = true
    } else {
        s_askno = 0
    }
}

// ------------------------------------------------------------------ painting helpers
fn tt(x: u64, y: u64, w: u64, p: u64, px: u64, bold: bool, role: u64) {
    fuiscene.text_role(x, y + px - px / 5, w, p, px, bold, role)
}

fn radius() -> u64 {
    return fuiscene.rb_px() + fuiscene.sp(2)
}

fn paint_icon(i: u64, x: u64, y: u64, size: u64) {
    appglyph.paint(name_at(i), x, y, size)
}

fn paint_chip(x: u64, y: u64, text: u64, accent: bool) -> u64 {
    let px: u64 = fuiscene.sp(11)
    let w: u64 = fuiscene.text_width(text, px) + fuiscene.sp(12)
    let h: u64 = fuiscene.sp(18)
    if accent {
        fuiscene.cv_round(x, y, w, h, h / 2, fuiscene.R_ACCENT)
        tt(x + fuiscene.sp(6), y + fuiscene.sp(2), w, text, px, true, fuiscene.R_ONFILL)
    } else {
        fuiscene.cv_round(x, y, w, h, h / 2, fuiscene.R_FIELD)
        tt(x + fuiscene.sp(6), y + fuiscene.sp(2), w, text, px, true, fuiscene.R_SUCCESS)
    }
    return w
}

fn focus_ring(x: u64, y: u64, w: u64, h: u64, r: u64) {
    fuiscene.cv_ring(x, y, w, h, r, fuiscene.R_ACCENT)
    fuiscene.cv_ring(x + 1, y + 1, w - 2, h - 2, r, fuiscene.R_ACCENT)
}

// the info area of a card: picture, name, version, a line of text, size and the state chip
fn cat_of(i: u64) -> u64 {
    let d: u64 = (&b_line[0 as usize]) as u64
    var pre: [u8; 11] = "store.cat.\0"
    if app_text(i, (&pre[0 as usize]) as u64, d, 63) {
        return d
    }
    sb_begin(d, 96)
    sb_s(ver_at(i))
    sb_s((&T_DOT[0 as usize]) as u64)
    sb_size(bytes_at(i))
    return d
}

fn wrap_cut(p: u64, w: u64, px: u64) -> u64 {
    let d: u64 = (&b_wrap[0 as usize]) as u64
    var n: u64 = 0
    var last: u64 = 0
    while (*((p + n) as *mut u8)) != 0 as u8 && n < 126 {
        *((d + n) as *mut u8) = *((p + n) as *mut u8)
        *((d + n + 1) as *mut u8) = 0 as u8
        if fuiscene.text_width(d, px) > w {
            if last > 0 {
                return last
            }
            return n
        }
        if (*((p + n) as *mut u8)) == 32 as u8 {
            last = n
        }
        n = n + 1
    }
    return n
}

fn tt_wrap2(x: u64, y: u64, w: u64, p: u64, px: u64, gap: u64) {
    let cut: u64 = wrap_cut(p, w, px)
    let d: u64 = (&b_wrap[0 as usize]) as u64
    ulib.strncpy(d, p, 127)
    *((d + cut) as *mut u8) = 0 as u8
    tt(x, y, w, d, px, false, fuiscene.R_MUTED)
    if (*((p + cut) as *mut u8)) == 0 as u8 {
        return
    }
    var rest: u64 = p + cut
    while (*(rest as *mut u8)) == 32 as u8 {
        rest = rest + 1
    }
    tt(x, y + gap, w, rest, px, false, fuiscene.R_MUTED)
}

fn paint_card_info(i: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    if i >= s_count {
        return
    }
    let isz: u64 = fuiscene.sp(40)
    paint_icon(i, x, y + fuiscene.sp(2), isz)
    let tx: u64 = x + isz + fuiscene.sp(12)
    let room: u64 = w - isz - fuiscene.sp(12)
    tt(tx, y, room, title_of(i), fuiscene.sp(14), true, fuiscene.R_TEXT)
    tt(tx, y + fuiscene.sp(18), room, cat_of(i), fuiscene.sp(12), false, fuiscene.R_MUTED)
    tt_wrap2(tx, y + fuiscene.sp(36), room, desc_of(i), fuiscene.sp(12), fuiscene.sp(17))
    if (st & fuiscene.TS_FOCUS) != 0 {
        focus_ring(x, y, w, h, radius())
    }
}

fn paint_row_info(i: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    if i >= s_count {
        return
    }
    let isz: u64 = fuiscene.sp(36)
    let gx: u64 = x + fuiscene.sp(8)
    paint_icon(i, gx, y + (h - isz) / 2, isz)
    let tx: u64 = gx + isz + fuiscene.sp(12)
    tt(tx, y + fuiscene.sp(7), w - isz - fuiscene.sp(36), title_of(i), fuiscene.sp(14), true, fuiscene.R_TEXT)
    sb_begin((&b_line[0 as usize]) as u64, 96)
    sb_s(ver_at(i))
    sb_s((&T_DOT[0 as usize]) as u64)
    sb_size(bytes_at(i))
    sb_s((&T_DOT[0 as usize]) as u64)
    sb_s(desc_of(i))
    tt(tx, y + fuiscene.sp(28), w - isz - fuiscene.sp(36), (&b_line[0 as usize]) as u64, fuiscene.sp(12), false, fuiscene.R_MUTED)
    if (st & fuiscene.TS_FOCUS) != 0 {
        focus_ring(x, y, w, h, radius())
    }
}

fn nav_glyph(id: u64) -> u64 {
    if id == 0 {
        return icons.START
    } else if id == 1 {
        return icons.FILE_PROGRAM
    } else if id == 2 {
        return icons.SETTINGS
    } else if id == 3 {
        return icons.FILE_IMAGE
    } else if id == 4 {
        return icons.ARROW_DOWN
    }
    return icons.CHECK
}

fn paint_nav(k: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    if k >= s_nav_n {
        return
    }
    let id: u64 = s_nav_id[k as usize]
    let sel: bool = id == s_cat
    let r: u64 = fuiscene.sp(4)
    if sel {
        fuiscene.cv_round(x, y, w, h, r, fuiscene.R_SURFACE)
        fuiscene.cv_round(x, y + fuiscene.sp(16), fuiscene.sp(3), h - fuiscene.sp(32), fuiscene.sp(2), fuiscene.R_ACCENT)
    }
    let gs: u64 = fuiscene.sp(20)
    var ink: u64 = 0x5D5D5D
    if sel {
        ink = 0x0067C0
    }
    fuiscene.cv_glyph(nav_glyph(id), x + (w - gs) / 2, y + fuiscene.sp(7), gs, ink)
    let nm: u64 = (&b_nav[0 as usize]) as u64 + k * 32
    let px: u64 = fuiscene.sp(11)
    var tw: u64 = fuiscene.text_width(nm, px)
    if tw > w {
        tw = w
    }
    tt(x + (w - tw) / 2, y + fuiscene.sp(32), w, nm, px, sel, fuiscene.R_TEXT)
    var cnt: u64 = 0
    if id == 4 {
        cnt = s_n_upd
    }
    if cnt > 0 {
        let bh: u64 = fuiscene.sp(8)
        fuiscene.cv_round(x + w / 2 + fuiscene.sp(6), y + fuiscene.sp(5), bh, bh, bh / 2, fuiscene.R_ACCENT)
    }
    if (st & fuiscene.TS_FOCUS) != 0 {
        focus_ring(x, y, w, h, r)
    }
}

fn paint_chip_tile(k: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    let on: bool = k == s_chip
    let r: u64 = h / 2
    if on {
        fuiscene.cv_round(x, y, w, h, r, fuiscene.R_ACCENT)
    } else {
        fuiscene.cv_round(x, y, w, h, r, fuiscene.R_SURFACE)
        fuiscene.cv_ring(x, y, w, h, r, fuiscene.R_BORDER)
    }
    let nm: u64 = (&b_chip[0 as usize]) as u64 + k * 32
    let px: u64 = fuiscene.sp(12)
    let tw: u64 = fuiscene.text_width(nm, px)
    var role: u64 = fuiscene.R_TEXT
    if on {
        role = fuiscene.R_ONFILL
    }
    tt(x + (w - tw) / 2, y + (h - px) / 2 - fuiscene.sp(1), w, nm, px, on, role)
    if (st & fuiscene.TS_FOCUS) != 0 {
        focus_ring(x, y, w, h, r)
    }
}

fn chip_add(p: u64) {
    var k: u64 = 1
    while k < s_chip_n {
        if ulib.streq((&b_chip[0 as usize]) as u64 + k * 32, p) {
            return
        }
        k = k + 1
    }
    if s_chip_n >= MAXCHIP {
        return
    }
    ulib.strncpy((&b_chip[0 as usize]) as u64 + s_chip_n * 32, p, 31)
    s_chip_n = s_chip_n + 1
}

fn collect_chips() {
    ulib.strncpy((&b_chip[0 as usize]) as u64, msg.get((&N_ALL[0 as usize]) as u64), 31)
    s_chip_n = 1
    var i: u64 = 0
    while i < s_count {
        if class_of(i) == 0 {
            var pre: [u8; 11] = "store.cat.\0"
            if app_text(i, (&pre[0 as usize]) as u64, (&b_catq[0 as usize]) as u64, 63) {
                chip_add((&b_catq[0 as usize]) as u64)
            }
        }
        i = i + 1
    }
}

fn build_chips(col: usize) {
    collect_chips()
    if s_chip_n < 2 {
        return
    }
    let cr: usize = fuiscene.row(col)
    fuiscene.set_gap(cr, 8)
    var k: u64 = 0
    while k < s_chip_n {
        let nm: u64 = (&b_chip[0 as usize]) as u64 + k * 32
        let w: u64 = fuiscene.text_width(nm, 12) + 26
        let _t: usize = fuiscene.ftile_nb(cr, K_CHIP + k, nm, w, 28, 300 + k, tile_cb)
        k = k + 1
    }
}

// ONE callback for every tile of the window (the host keeps one): ud tells which tile
fn tile_cb(ud: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    if ud < 100 {
        paint_card_info(ud, x, y, w, h, st)
    } else if ud < 200 {
        paint_nav(ud - 100, x, y, w, h, st)
    } else if ud >= 300 {
        paint_chip_tile(ud - 300, x, y, w, h, st)
    } else {
        paint_row_info(ud - 200, x, y, w, h, st)
    }
}

fn cv_job(x: u64, y: u64, w: u64, h: u64) {
    sb_begin((&b_num[0 as usize]) as u64, 24)
    sb_n(s_pct)
    sb_s((&T_PCT[0 as usize]) as u64)
    let px: u64 = fuiscene.sp(12)
    let tw: u64 = fuiscene.text_width((&b_num[0 as usize]) as u64, px)
    let bh: u64 = fuiscene.sp(4)
    let bw: u64 = w - tw - fuiscene.sp(8)
    let by: u64 = y + (h - bh) / 2
    fuiscene.cv_round(x, by, bw, bh, bh / 2, fuiscene.R_FIELD)
    var pct: u64 = s_pct
    if pct > 100 {
        pct = 100
    }
    if pct > 0 {
        fuiscene.cv_round(x, by, bw * pct / 100, bh, bh / 2, fuiscene.R_ACCENT)
    }
    tt(x + bw + fuiscene.sp(8), y + (h - px) / 2 - fuiscene.sp(1), tw, (&b_num[0 as usize]) as u64, px, false, fuiscene.R_MUTED)
}

fn cv_title(x: u64, y: u64, w: u64, h: u64) {
    tt(x, y + fuiscene.sp(2), w, (&b_title[0 as usize]) as u64, fuiscene.sp(20), true, fuiscene.R_TEXT)
}

fn cv_pager(x: u64, y: u64, w: u64, h: u64) {
    let pw: u64 = fuiscene.text_width((&b_pager[0 as usize]) as u64, fuiscene.sp(13))
    tt(x + (w - pw) / 2, y + (h - fuiscene.sp(13)) / 2, w, (&b_pager[0 as usize]) as u64, fuiscene.sp(13), false, fuiscene.R_MUTED)
}

// the big picture of the detail page
fn cv_hero(x: u64, y: u64, w: u64, h: u64) {
    let i: u64 = s_detail
    if i >= s_count {
        return
    }
    let isz: u64 = fuiscene.sp(88)
    paint_icon(i, x + fuiscene.sp(4), y + fuiscene.sp(8), isz)
    let tx: u64 = x + isz + fuiscene.sp(24)
    tt(tx, y + fuiscene.sp(10), w - isz - fuiscene.sp(30), title_of(i), fuiscene.sp(26), true, fuiscene.R_TEXT)
    sb_begin((&b_line[0 as usize]) as u64, 96)
    sb_s(ver_at(i))
    sb_s((&T_DOT[0 as usize]) as u64)
    sb_size(bytes_at(i))
    tt(tx, y + fuiscene.sp(46), w - isz - fuiscene.sp(30), (&b_line[0 as usize]) as u64, fuiscene.sp(13), false, fuiscene.R_MUTED)
    let stt: u64 = s_state[i as usize] as u64
    if stt == 2 {
        let _w: u64 = paint_chip(tx, y + fuiscene.sp(72), msg.get((&T_CHIP_UPD[0 as usize]) as u64), true)
    } else if stt == 1 {
        let _w2: u64 = paint_chip(tx, y + fuiscene.sp(72), msg.get((&T_CHIP_INST[0 as usize]) as u64), false)
    }
}

// an empty page: a round symbol, a title, a line of text
fn cv_empty(x: u64, y: u64, w: u64, h: u64) {
    var t: u64 = msg.get((&E_NOHIT_T[0 as usize]) as u64)
    var m: u64 = (&E_NOHIT_X[0 as usize]) as u64
    var sym: u64 = (&E_SYM_Q[0 as usize]) as u64
    if s_et_kind == 1 {
        t = msg.get((&E_OK_T[0 as usize]) as u64)
        m = msg.get((&E_OK_X[0 as usize]) as u64)
        sym = (&E_SYM_OK[0 as usize]) as u64
    } else if s_et_kind == 2 {
        t = msg.get((&E_NET_T[0 as usize]) as u64)
        m = msg.get((&E_NET_X[0 as usize]) as u64)
        sym = (&E_SYM_NET[0 as usize]) as u64
    } else if s_et_kind == 3 {
        t = msg.get((&E_INST_T[0 as usize]) as u64)
        m = msg.get((&E_INST_X[0 as usize]) as u64)
    } else if s_et_kind == 4 {
        t = (&E_NONE_T[0 as usize]) as u64
        m = msg.get((&E_NONE_X[0 as usize]) as u64)
    }
    let d: u64 = fuiscene.sp(72)
    let cx: u64 = x + (w - d) / 2
    let cy: u64 = y + fuiscene.sp(30)
    fuiscene.cv_round(cx, cy, d, d, d / 2, fuiscene.R_FIELD)
    var role: u64 = fuiscene.R_MUTED
    if s_et_kind == 1 {
        role = fuiscene.R_SUCCESS
    } else if s_et_kind == 2 {
        role = fuiscene.R_WARN
    }
    let sw: u64 = fuiscene.text_width(sym, fuiscene.sp(32))
    tt(cx + (d - sw) / 2, cy + fuiscene.sp(16), d, sym, fuiscene.sp(32), true, role)
    let tw: u64 = fuiscene.text_width(t, fuiscene.sp(20))
    tt(x + (w - tw) / 2, cy + d + fuiscene.sp(18), w, t, fuiscene.sp(20), true, fuiscene.R_TEXT)
    let mw: u64 = fuiscene.text_width(m, fuiscene.sp(13))
    var mx: u64 = x + fuiscene.sp(8)
    if mw < w {
        mx = x + (w - mw) / 2
    }
    tt(mx, cy + d + fuiscene.sp(48), w - fuiscene.sp(16), m, fuiscene.sp(13), false, fuiscene.R_MUTED)
}

// the skeleton while the catalog loads: six grey cards
fn cv_skel(x: u64, y: u64, w: u64, h: u64) {
    var k: u64 = 0
    let cw: u64 = fuiscene.sp(CARD_W)
    let ch: u64 = fuiscene.sp(CARD_H)
    let gap: u64 = fuiscene.sp(12)
    while k < 6 {
        let col: u64 = k % COLS
        let rw: u64 = k / COLS
        let cx: u64 = x + col * (cw + gap)
        let cy: u64 = y + rw * (ch + gap)
        fuiscene.cv_round(cx, cy, cw, ch, radius(), fuiscene.R_FIELD)
        fuiscene.cv_round(cx + fuiscene.sp(16), cy + fuiscene.sp(16), fuiscene.sp(44), fuiscene.sp(44), fuiscene.sp(10), fuiscene.R_BORDER)
        fuiscene.cv_round(cx + fuiscene.sp(72), cy + fuiscene.sp(20), fuiscene.sp(90), fuiscene.sp(12), fuiscene.sp(6), fuiscene.R_BORDER)
        fuiscene.cv_round(cx + fuiscene.sp(72), cy + fuiscene.sp(42), fuiscene.sp(60), fuiscene.sp(10), fuiscene.sp(5), fuiscene.R_BORDER)
        fuiscene.cv_round(cx + fuiscene.sp(16), cy + fuiscene.sp(76), fuiscene.sp(150), fuiscene.sp(10), fuiscene.sp(5), fuiscene.R_BORDER)
        fuiscene.cv_round(cx + fuiscene.sp(16), cy + ch - fuiscene.sp(40), cw - fuiscene.sp(32), fuiscene.sp(26), fuiscene.sp(8), fuiscene.R_BORDER)
        k = k + 1
    }
}

// ------------------------------------------------------------------ the window
fn nav_name(buf: u64, p: u64) {
    sb_begin(buf, 32)
    sb_s(p)
}

fn build_nav(col: usize) {
    s_nav_n = 0
    s_nav_id[s_nav_n as usize] = 0
    nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_ALL[0 as usize]) as u64))
    s_nav_n = s_nav_n + 1
    s_nav_id[s_nav_n as usize] = 1
    nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_APPS[0 as usize]) as u64))
    s_nav_n = s_nav_n + 1
    if s_n_cls[1 as usize] > 0 {
        s_nav_id[s_nav_n as usize] = 2
        nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_THEMES[0 as usize]) as u64))
        s_nav_n = s_nav_n + 1
    }
    if s_n_cls[2 as usize] > 0 {
        s_nav_id[s_nav_n as usize] = 3
        nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_MEDIA[0 as usize]) as u64))
        s_nav_n = s_nav_n + 1
    }
    s_nav_id[s_nav_n as usize] = 4
    nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_UPD[0 as usize]) as u64))
    s_nav_n = s_nav_n + 1
    s_nav_id[s_nav_n as usize] = 5
    nav_name((&b_nav[0 as usize]) as u64 + s_nav_n * 32, msg.get((&N_INST[0 as usize]) as u64))
    s_nav_n = s_nav_n + 1
    var k: u64 = 0
    while k < s_nav_n {
        let _t: usize = fuiscene.ftile_nb(col, K_NAV + k, (&b_nav[0 as usize]) as u64 + k * 32, NAV_W, NAV_H, 100 + k, tile_cb)
        k = k + 1
    }
}

fn page_title() -> u64 {
    if s_cat == 1 {
        return msg.get((&H_APPS[0 as usize]) as u64)
    } else if s_cat == 2 {
        return msg.get((&H_THEMES[0 as usize]) as u64)
    } else if s_cat == 3 {
        return msg.get((&H_MEDIA[0 as usize]) as u64)
    } else if s_cat == 4 {
        return msg.get((&H_UPD[0 as usize]) as u64)
    } else if s_cat == 5 {
        return msg.get((&H_INST[0 as usize]) as u64)
    }
    return msg.get((&H_ALL[0 as usize]) as u64)
}

fn make_titles() {
    sb_begin((&b_title[0 as usize]) as u64, 96)
    sb_s(page_title())
    sb_begin((&b_sub[0 as usize]) as u64, 96)
    if (s_q[0 as usize]) != 0 as u8 {
        sb_s(msg.get((&T_FOR[0 as usize]) as u64))
        sb_s((&s_q[0 as usize]) as u64)
        sb_s((&T_DOT[0 as usize]) as u64)
        sb_n(s_vis_n)
        sb_s((&T_HITS[0 as usize]) as u64)
    } else {
        sb_n(s_vis_n)
        if s_vis_n == 1 {
            sb_s(msg.get((&T_PROG1[0 as usize]) as u64))
        } else {
            sb_s(msg.get((&T_PROGN[0 as usize]) as u64))
        }
    }
    sb_begin((&b_pager[0 as usize]) as u64, 48)
    sb_s(msg.get((&T_PAGE[0 as usize]) as u64))
    sb_n(s_page + 1)
    sb_s((&T_OF[0 as usize]) as u64)
    sb_n(pages())
}

// is the job that runs the one for program `i`
fn job_is(i: u64) -> bool {
    return s_busy && ulib.streq((&s_job[0 as usize]) as u64, name_at(i))
}

fn button_text(i: u64) -> u64 {
    let st: u64 = s_state[i as usize] as u64
    if st == 2 {
        return msg.get((&T_UPDATE[0 as usize]) as u64)
    } else if st == 1 {
        return msg.get((&T_OPEN[0 as usize]) as u64)
    }
    return msg.get((&T_INSTALL[0 as usize]) as u64)
}

fn can_act(i: u64) -> bool {
    let st: u64 = s_state[i as usize] as u64
    if st == 1 {
        return true
    }
    return !s_busy && s_bus && s_can_i
}

fn open_app(i: u64) {
    var path: [u8; 64] = [0 as u8; 64]
    ulib.strcpy((&path[0 as usize]) as u64, (&P_BIN[0 as usize]) as u64)
    ulib.strcat((&path[0 as usize]) as u64, name_at(i))
    let _pid: u64 = ulib.spawn_app((&path[0 as usize]) as u64, 0, 0)
}

fn build_grid(col: usize) {
    var r: u64 = 0
    var k: u64 = 0
    let first: u64 = s_page * PER_PAGE
    while r < PER_PAGE / COLS {
        let rw: usize = fuiscene.row(col)
        fuiscene.set_gap(rw, 12)
        var c: u64 = 0
        while c < COLS {
            let slot: u64 = first + k
            if slot < s_vis_n {
                let i: u64 = s_vis[slot as usize]
                let card: usize = fuiscene.card_soft(rw)
                fuiscene.set_size(card, CARD_W, CARD_H)
                // the name a screen reader says for the card
                let nb: u64 = (&b_tile[0 as usize]) as u64 + k * 128
                sb_begin(nb, 128)
                sb_s(title_of(i))
                sb_s((&T_DOT[0 as usize]) as u64)
                sb_s(ver_at(i))
                sb_s((&T_DOT[0 as usize]) as u64)
                sb_size(bytes_at(i))
                let st: u64 = s_state[i as usize] as u64
                if st == 2 {
                    sb_s((&T_DOT[0 as usize]) as u64)
                    sb_s(msg.get((&T_HASUPD[0 as usize]) as u64))
                } else if st == 1 {
                    sb_s((&T_DOT[0 as usize]) as u64)
                    sb_s(msg.get((&T_CURRENT[0 as usize]) as u64))
                }
                let _t: usize = fuiscene.ftile_nb(card, K_TILE + k, nb, TILE_W, TILE_H, i, tile_cb)
                if job_is(i) {
                    let pg: usize = fuiscene.canvas(card, 0, 150, BTN_H, cv_job)
                    fuiscene.set_align_end(pg)
                } else {
                    var bt: usize = NONE as usize
                    if st == 1 {
                        bt = fuiscene.button(card, button_text(i), K_QACT + k)
                    } else {
                        bt = fuiscene.button_main(card, button_text(i), K_QACT + k)
                    }
                    var bw: u64 = fuiscene.text_width(button_text(i), 13) + 32
                    if bw < BTN_W {
                        bw = BTN_W
                    }
                    fuiscene.set_size(bt, bw, BTN_H)
                    fuiscene.set_align_end(bt)
                    fuiscene.set_enabled(bt, can_act(i))
                }
            } else {
                let _e: usize = fuiscene.space(rw, CARD_W, CARD_H)
            }
            k = k + 1
            c = c + 1
        }
        r = r + 1
    }
}

fn build_updates(col: usize) {
    var k: u64 = 0
    let first: u64 = s_page * PER_PAGE_UP
    while k < PER_PAGE_UP {
        let slot: u64 = first + k
        if slot < s_vis_n {
            let i: u64 = s_vis[slot as usize]
            let rw: usize = fuiscene.row(col)
            fuiscene.set_gap(rw, 8)
            let nb: u64 = (&b_tile[0 as usize]) as u64 + k * 128
            sb_begin(nb, 128)
            sb_s(title_of(i))
            sb_s((&T_DOT[0 as usize]) as u64)
            sb_s(ver_at(i))
            sb_s((&T_DOT[0 as usize]) as u64)
            sb_s(msg.get((&T_HASUPD[0 as usize]) as u64))
            let _t: usize = fuiscene.ftile(rw, K_ROW + k, nb, 510, 52, 200 + i, tile_cb)
            if job_is(i) {
                let _p: usize = fuiscene.progress(rw, 150, s_pct)
            } else {
                let bt: usize = fuiscene.button(rw, msg.get((&T_UPDATE[0 as usize]) as u64), K_ROWACT + k)
                fuiscene.set_size(bt, 150, 36)
                fuiscene.set_enabled(bt, can_act(i))
            }
        }
        k = k + 1
    }
}

fn build_pager(col: usize) {
    let pg: usize = fuiscene.row(col)
    fuiscene.set_gap(pg, 8)
    let sp0: usize = fuiscene.row(pg)
    fuiscene.set_grow(sp0, 1)
    let b0: usize = fuiscene.button(pg, msg.get((&T_PREV[0 as usize]) as u64), K_PGPREV)
    fuiscene.set_size(b0, 130, 30)
    fuiscene.set_enabled(b0, s_page > 0)
    let _c: usize = fuiscene.canvas(pg, 0, 120, 30, cv_pager)
    let b1: usize = fuiscene.button(pg, msg.get((&T_NEXT[0 as usize]) as u64), K_PGNEXT)
    fuiscene.set_size(b1, 130, 30)
    fuiscene.set_enabled(b1, s_page + 1 < pages())
    let sp1: usize = fuiscene.row(pg)
    fuiscene.set_grow(sp1, 1)
}

fn build_detail(col: usize) {
    let i: u64 = s_detail
    let bk: usize = fuiscene.button(col, msg.get((&T_BACK[0 as usize]) as u64), K_BACK)
    fuiscene.set_size(bk, 100, 32)
    let _h: usize = fuiscene.canvas(col, 0, CONT_W, 104, cv_hero)
    ulib.strncpy((&b_det[0 as usize]) as u64, desc_of(i), 159)
    let _d: usize = fuiscene.label(col, (&b_det[0 as usize]) as u64)
    let _l: usize = fuiscene.label_wrap(col, msg.get((&T_LONG[0 as usize]) as u64), 2)
    let card: usize = fuiscene.card(col)
    sb_begin((&b_inf[0 as usize]) as u64, 128)
    sb_s((&T_VERS[0 as usize]) as u64)
    sb_s(ver_at(i))
    let _a: usize = fuiscene.label(card, (&b_inf[0 as usize]) as u64)
    sb_begin((&b_inf[0 as usize]) as u64 + 128, 128)
    sb_s(msg.get((&T_SIZEL[0 as usize]) as u64))
    sb_size(bytes_at(i))
    let _b: usize = fuiscene.label(card, (&b_inf[0 as usize]) as u64 + 128)
    sb_begin((&b_inf[0 as usize]) as u64 + 256, 128)
    sb_s((&T_SRCL[0 as usize]) as u64)
    if s_source[0 as usize] != 0 as u8 {
        sb_s((&s_source[0 as usize]) as u64)
    } else {
        sb_s((&T_NOSRC[0 as usize]) as u64)
    }
    let _c: usize = fuiscene.label(card, (&b_inf[0 as usize]) as u64 + 256)
    let _e: usize = fuiscene.label_wrap(card, msg.get((&T_CHECK[0 as usize]) as u64), 2)
    let ar: usize = fuiscene.row(col)
    fuiscene.set_gap(ar, 10)
    if job_is(i) {
        let _p: usize = fuiscene.progress(ar, 360, s_pct)
        sb_begin((&b_pcl[0 as usize]) as u64, 24)
        sb_n(s_pct)
        sb_s((&T_PCT[0 as usize]) as u64)
        let _q: usize = fuiscene.label(ar, (&b_pcl[0 as usize]) as u64)
    } else {
        let st: u64 = s_state[i as usize] as u64
        if st == 2 {
            let pb: usize = fuiscene.button_main(ar, msg.get((&T_UPDATE[0 as usize]) as u64), K_PRIMARY)
            fuiscene.set_size(pb, 150, 36)
            fuiscene.set_enabled(pb, can_act(i))
        } else if st == 0 {
            let pb2: usize = fuiscene.button_main(ar, msg.get((&T_INSTALL[0 as usize]) as u64), K_PRIMARY)
            fuiscene.set_size(pb2, 150, 36)
            fuiscene.set_enabled(pb2, can_act(i))
        }
        let rb: usize = fuiscene.button(ar, msg.get((&T_REMOVE[0 as usize]) as u64), K_REMOVE)
        fuiscene.set_size(rb, 130, 36)
        fuiscene.set_enabled(rb, !s_busy && s_bus && s_can_r && st != 0)
    }
}

// which empty page (if any) the list shows now
fn empty_kind() -> u64 {
    if s_count == 0 {
        if !s_bus {
            return 2
        }
        var fehler: [u8; 7] = "fehler\0"
        if !s_busy && ulib.streq((&s_phase[0 as usize]) as u64, (&fehler[0 as usize]) as u64) {
            return 2
        }
        if s_busy || s_loading {
            return 9
        }
        return 4
    }
    if s_vis_n > 0 {
        return 99
    }
    if s_q[0 as usize] != 0 as u8 {
        return 0
    }
    if s_cat == 4 {
        return 1
    }
    if s_cat == 5 {
        return 3
    }
    return 0
}

fn build() {
    let root: usize = fuiscene.root()
    fuiscene.set_gap(root, 0)
    fuiscene.set_pad(root, 0)
    make_titles()
    let body: usize = fuiscene.row(root)
    fuiscene.set_gap(body, 8)
    fuiscene.set_grow(body, 1)
    let nav: usize = fuiscene.column(body)
    fuiscene.set_size(nav, NAV_W, WIN_H - 40)
    fuiscene.set_gap(nav, 4)
    build_nav(nav)
    let col: usize = fuiscene.layer(body)
    fuiscene.set_gap(col, 12)
    fuiscene.set_pad(col, 16)
    let hr: usize = fuiscene.row(col)
    let hl: usize = fuiscene.row(hr)
    fuiscene.set_size(hl, (CONT_W - 420) / 2, 1)
    let _se: usize = fuiscene.entry(hr, K_SEARCH, 420, (&s_q[0 as usize]) as u64)
    fuiscene.entry_hint(K_SEARCH, msg.get((&T_HINT[0 as usize]) as u64))
    fuiscene.ax_name(K_SEARCH, msg.get((&T_HINT[0 as usize]) as u64))
    if s_detail != NONE && s_detail < s_count {
        build_detail(col)
    } else {
        let tr: usize = fuiscene.row(col)
        fuiscene.set_gap(tr, 8)
        let _ti: usize = fuiscene.canvas(tr, 0, 420, 32, cv_title)
        let tsp: usize = fuiscene.row(tr)
        fuiscene.set_grow(tsp, 1)
        if s_cat == 4 && s_vis_n > 0 {
            let ua: usize = fuiscene.button_main(tr, msg.get((&T_ALLUP[0 as usize]) as u64), K_ALLUP)
            fuiscene.set_size(ua, 170, 34)
            fuiscene.set_enabled(ua, !s_busy && s_bus && s_can_i)
        }
        if s_cat != 4 {
            build_chips(col)
        }
        let ek: u64 = empty_kind()
        if ek == 99 {
            if s_cat == 4 {
                build_updates(col)
            } else {
                build_grid(col)
            }
            if pages() > 1 {
                build_pager(col)
            }
        } else if ek == 9 {
            let _sk: usize = fuiscene.canvas(col, 0, CONT_W, 320, cv_skel)
        } else {
            s_et_kind = ek
            let _em: usize = fuiscene.canvas(col, 0, CONT_W, 280, cv_empty)
            if ek == 2 {
                let rb: usize = fuiscene.button_main(col, msg.get((&T_RETRY[0 as usize]) as u64), K_RETRY)
                fuiscene.set_size(rb, 170, 36)
                fuiscene.set_enabled(rb, !s_busy)
            }
        }
    }
    if s_info[0 as usize] != 0 as u8 {
        let _i: usize = fuiscene.label_muted(root, (&s_info[0 as usize]) as u64)
    }
}

fn sync_info() {
    let inf: u64 = (&s_info[0 as usize]) as u64
    var a: u64 = 0
    if s_bus && (!s_can_i || !s_can_r) {
        a = puts(inf, a, msg.get((&T_RIGHTS[0 as usize]) as u64))
    }
    put(inf, a, 0)
}

fn ask(verb: u64, item: u64) {
    if item == NONE || item >= s_count {
        set_status(msg.get((&T_PICK[0 as usize]) as u64), 0)
        return
    }
    if verb != 3 && !s_can_i {
        set_status(msg.get((&T_DENIED[0 as usize]) as u64), 0)
        return
    }
    if verb == 3 && !s_can_r {
        set_status(msg.get((&T_DENIED[0 as usize]) as u64), 0)
        return
    }
    ulib.strncpy((&s_ask_name[0 as usize]) as u64, name_at(item), 47)
    s_ask_item = item
    s_ask_verb = verb
    if verb == 1 {
        fuiscene.dialog_open(msg.get((&T_ASK_I[0 as usize]) as u64), (&s_ask_name[0 as usize]) as u64,
            msg.get((&T_YES_I[0 as usize]) as u64), msg.get((&T_NO[0 as usize]) as u64))
    } else if verb == 2 {
        fuiscene.dialog_open(msg.get((&T_ASK_U[0 as usize]) as u64), (&s_ask_name[0 as usize]) as u64,
            msg.get((&T_YES_U[0 as usize]) as u64), msg.get((&T_NO[0 as usize]) as u64))
    } else {
        fuiscene.dialog_open(msg.get((&T_ASK_R[0 as usize]) as u64), (&s_ask_name[0 as usize]) as u64,
            msg.get((&T_YES_R[0 as usize]) as u64), msg.get((&T_NO[0 as usize]) as u64))
    }
}

// one question for every update on the list; the answer starts them one after the other
fn ask_all() {
    if !s_can_i {
        set_status(msg.get((&T_DENIED[0 as usize]) as u64), 0)
        return
    }
    sb_begin((&s_batch[0 as usize]) as u64, 40)
    sb_n(s_n_upd)
    if s_n_upd == 1 {
        sb_s(msg.get((&T_PROG1[0 as usize]) as u64))
    } else {
        sb_s(msg.get((&T_PROGN[0 as usize]) as u64))
    }
    s_ask_verb = 4
    fuiscene.dialog_open(msg.get((&T_ASK_A[0 as usize]) as u64), (&s_batch[0 as usize]) as u64,
        msg.get((&T_YES_U[0 as usize]) as u64), msg.get((&T_NO[0 as usize]) as u64))
}

fn queue_fill() {
    var i: u64 = 0
    while i < MAXI {
        s_queue[i as usize] = 0 as u8
        if i < s_count && s_state[i as usize] == 2 as u8 {
            s_queue[i as usize] = 1 as u8
        }
        i = i + 1
    }
}

fn queue_left() -> bool {
    var i: u64 = 0
    while i < s_count {
        if s_queue[i as usize] != 0 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

// start the next queued update; false if there is none
fn queue_next() -> bool {
    var i: u64 = 0
    while i < s_count {
        if s_queue[i as usize] != 0 as u8 {
            s_queue[i as usize] = 0 as u8
            if call_verb((&V_UPDATE[0 as usize]) as u64, name_at(i)) {
                s_busy = true
                return true
            }
            return false
        }
        i = i + 1
    }
    return false
}

fn queue_clear() {
    var i: u64 = 0
    while i < MAXI {
        s_queue[i as usize] = 0 as u8
        i = i + 1
    }
}

fn batch_list() -> u64 {
    if !actcli.open() {
        ulib.say(msg.get((&T_NOBUS[0 as usize]) as u64))
        ulib.nl()
        return 1
    }
    actcli.req((&V_LIST[0 as usize]) as u64)
    if actcli.send(300) != actcli.R_OK {
        ulib.say(msg.get((&T_NOBUS[0 as usize]) as u64))
        ulib.nl()
        return 1
    }
    ulib.say(actcli.reply())
    return 0
}

fn go_cat(id: u64) {
    s_cat = id
    s_page = 0
    s_detail = NONE
    refilter()
}

fn open_detail(i: u64) {
    if i < s_count {
        s_detail = i
    }
}

// move the focus on the grid: from card `k` of the page by (dc, dr); past an edge the page turns
fn grid_move(k: u64, key: u64) {
    let pp: u64 = per_page()
    let cnt: u64 = grid.grid_page_count(s_vis_n, s_page, pp)
    var dir: u64 = grid.GRID_DOWN
    if key == wlib.KEY_LEFT {
        dir = grid.GRID_LEFT
    } else if key == wlib.KEY_RIGHT {
        dir = grid.GRID_RIGHT
    } else if key == wlib.KEY_UP {
        dir = grid.GRID_UP
    }
    // the updates are a list (one column), the rest a grid of COLS columns
    var cols: u64 = COLS
    var base: u64 = K_TILE
    if s_cat == 4 {
        cols = 1
        base = K_ROW
    }
    // up from the first row goes to the search box
    if dir == grid.GRID_UP && k < cols && s_cat != 4 {
        fuiscene.focus(K_SEARCH)
        return
    }
    fuiscene.focus(base + grid.grid_move(k, cnt, cols, dir))
}

fn u_start(args: u64) -> u64 {
    let _mi: u64 = msg.init()
    var o_list: [u8; 7] = "--list\0"
    if ulib.arg_count(args) >= 2 && ulib.streq(ulib.arg_at(args, 1), (&o_list[0 as usize]) as u64) {
        return batch_list()
    }
    fuiapp.set_atomic(true)
    if !fuiscene.open(40, 24, WIN_W, WIN_H, (&T_APP[0 as usize]) as u64, build) {
        return 1
    }
    // The window tells the taskbar which bundle it belongs to (WM_APP); without it the button has no icon.
    var win_app_name: [u8; 6] = "store\0"
    fuiscene.set_app((&win_app_name[0 as usize]) as u64)
    s_detail = NONE
    s_loading = true
    load_list()
    load_status()
    sync_info()
    fuiscene.refresh()
    var rounds: u64 = 0
    var wait_empty: bool = s_count == 0 && s_bus
    var was_busy: bool = false
    var q_shown: u64 = 0
    while fuiscene.alive() && rounds < 1000000000000 {
        rounds = rounds + 1
        let key: u64 = fuiscene.pump()
        var changed: bool = false
        if fuiscene.painted() != s_traced && fuiscene.trace_on() {
            s_traced = fuiscene.painted()
            fuiscene.say_rects((&T_APP[0 as usize]) as u64)
            fuiscene.say_texts()
            // what the page holds, for the acceptance runs: items on the page, matches in all, detail open or not
            ulib.say((&S_TILES[0 as usize]) as u64)
            if s_detail != NONE {
                ulib.sayu(0)
            } else {
                ulib.sayu(grid.grid_page_count(s_vis_n, s_page, per_page()))
            }
            ulib.say((&S_HITS[0 as usize]) as u64)
            ulib.sayu(s_vis_n)
            ulib.nl()
        }
        // the answer of the question window
        let dr: u64 = fuiscene.dialog_result()
        if dr == 1 && s_ask_verb != 0 {
            if s_ask_verb == 4 {
                queue_fill()
                if queue_next() {
                    s_busy = true
                }
            } else {
                var vb: u64 = (&V_INSTALL[0 as usize]) as u64
                if s_ask_verb == 2 {
                    vb = (&V_UPDATE[0 as usize]) as u64
                } else if s_ask_verb == 3 {
                    vb = (&V_REMOVE[0 as usize]) as u64
                }
                if call_verb(vb, (&s_ask_name[0 as usize]) as u64) {
                    s_busy = true
                }
            }
            s_ask_verb = 0
            changed = true
        } else if dr == 2 {
            s_ask_verb = 0
        }
        // what was pressed
        if key == K_REFRESH || key == K_RETRY {
            s_loading = true
            if call_verb((&V_REFRESH[0 as usize]) as u64, 0) {
                s_busy = true
            }
            changed = true
        } else if key == K_BACK {
            s_detail = NONE
            changed = true
        } else if key >= K_CHIP && key < K_CHIP + s_chip_n {
            s_chip = key - K_CHIP
            s_page = 0
            refilter()
            changed = true
        } else if key >= K_NAV && key < K_NAV + s_nav_n {
            go_cat(s_nav_id[(key - K_NAV) as usize])
            changed = true
        } else if key >= K_TILE && key < K_TILE + PER_PAGE {
            let slot: u64 = s_page * PER_PAGE + (key - K_TILE)
            if slot < s_vis_n {
                open_detail(s_vis[slot as usize])
            }
            changed = true
        } else if key >= K_QACT && key < K_QACT + PER_PAGE {
            let slot2: u64 = s_page * PER_PAGE + (key - K_QACT)
            if slot2 < s_vis_n {
                let it: u64 = s_vis[slot2 as usize]
                if s_state[it as usize] == 1 as u8 {
                    open_app(it)
                } else if s_state[it as usize] == 2 as u8 {
                    ask(2, it)
                } else {
                    ask(1, it)
                }
            }
        } else if key >= K_ROW && key < K_ROW + PER_PAGE_UP {
            let slot3: u64 = s_page * PER_PAGE_UP + (key - K_ROW)
            if slot3 < s_vis_n {
                open_detail(s_vis[slot3 as usize])
            }
            changed = true
        } else if key >= K_ROWACT && key < K_ROWACT + PER_PAGE_UP {
            let slot4: u64 = s_page * PER_PAGE_UP + (key - K_ROWACT)
            if slot4 < s_vis_n {
                ask(2, s_vis[slot4 as usize])
            }
        } else if key == K_PRIMARY {
            if s_detail != NONE {
                if s_state[s_detail as usize] == 2 as u8 {
                    ask(2, s_detail)
                } else {
                    ask(1, s_detail)
                }
            }
        } else if key == K_REMOVE {
            ask(3, s_detail)
        } else if key == K_ALLUP {
            ask_all()
        } else if key == K_PGPREV {
            if s_page > 0 {
                s_page = s_page - 1
            }
            changed = true
        } else if key == K_PGNEXT {
            if s_page + 1 < pages() {
                s_page = s_page + 1
            }
            changed = true
        }
        // keys no field and no button took
        let ks: u64 = fuiscene.key_seq()
        if ks != s_kseq {
            s_kseq = ks
            let ka: u64 = fuiscene.key_any()
            let fk: u64 = fuiscene.focus_key()
            if ka == wlib.KEY_CTRL_F {
                s_detail = NONE
                fuiscene.refresh()
                fuiscene.focus(K_SEARCH)
                changed = true
            } else if ka == wlib.KEY_ESC && !fuiscene.dialog_is_open() {
                if s_detail != NONE {
                    s_detail = NONE
                    changed = true
                } else if s_q[0 as usize] != 0 as u8 {
                    s_q[0 as usize] = 0 as u8
                    fuiscene.entry_set(K_SEARCH, (&s_q[0 as usize]) as u64)
                    refilter()
                    changed = true
                }
            } else if ka == wlib.KEY_PGDN && s_detail == NONE {
                if s_page + 1 < pages() {
                    s_page = s_page + 1
                    changed = true
                }
            } else if ka == wlib.KEY_PGUP && s_detail == NONE {
                if s_page > 0 {
                    s_page = s_page - 1
                    changed = true
                }
            } else if s_detail == NONE && (ka == wlib.KEY_LEFT || ka == wlib.KEY_RIGHT || ka == wlib.KEY_UP || ka == wlib.KEY_DOWN) {
                if s_cat == 4 && fk >= K_ROW && fk < K_ROW + PER_PAGE_UP {
                    grid_move(fk - K_ROW, ka)
                } else if fk >= K_TILE && fk < K_TILE + PER_PAGE {
                    grid_move(fk - K_TILE, ka)
                } else if fk == K_SEARCH && ka == wlib.KEY_DOWN && s_vis_n > 0 {
                    if s_cat == 4 {
                        fuiscene.focus(K_ROW)
                    } else {
                        fuiscene.focus(K_TILE)
                    }
                }
            }
        }
        let k: u64 = fuiscene.last_key()
        if (k == 114 || k == 0xF5) && !s_busy {
            s_loading = true
            if call_verb((&V_REFRESH[0 as usize]) as u64, 0) {
                s_busy = true
            }
            changed = true
        }
        // the first start with no catalog yet: fetch it once
        if wait_empty {
            wait_empty = false
            if call_verb((&V_REFRESH[0 as usize]) as u64, 0) {
                s_busy = true
            }
            changed = true
        }
        // the search box: what it holds now
        let qp: u64 = fuiscene.entry_text(K_SEARCH)
        if qp != 0 && !ulib.streq(qp, (&s_q[0 as usize]) as u64) {
            ulib.strncpy((&s_q[0 as usize]) as u64, qp, 63)
            s_page = 0
            refilter()
            changed = true
        }
        // while the provider works: ask for its state four times a second, move the bar;
        // when it is done, read the catalog again
        if s_busy {
            let now: u64 = fuiapp.now_ms()
            if now - s_polled > 250 {
                s_polled = now
                load_status()
                if s_askno != 0 {
                    if s_busy {
                        s_askno = 0 // the provider runs: the question was answered with yes
                    } else {
                        s_pct_srv = 0 // the state is still the one of the last job
                        ask_check()
                    }
                }
                // the provider reports the stages; the bar shows exactly those, nothing in between
                if s_pct_srv > s_pct {
                    s_pct = s_pct_srv
                }
                if s_pct != q_shown {
                    q_shown = s_pct
                    ulib.say((&S_PCTT[0 as usize]) as u64)
                    ulib.sayu(s_pct)
                    ulib.nl()
                }
                if !s_busy {
                    s_loading = false
                    load_list()
                    // the next update of "update all", or stop at the first failure
                    var fehler: [u8; 7] = "fehler\0"
                    if ulib.streq((&s_phase[0 as usize]) as u64, (&fehler[0 as usize]) as u64) {
                        queue_clear()
                    } else if queue_left() {
                        if queue_next() {
                            s_busy = true
                        }
                    }
                }
                changed = true
            }
        }
        if was_busy != s_busy {
            was_busy = s_busy
            changed = true
        }
        if s_detail != NONE && s_detail >= s_count {
            s_detail = NONE
            changed = true
        }
        if changed {
            sync_info()
            fuiscene.refresh()
        }
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
