profile kernel

import ulib
import libc.octets
import xfxio

export { append_env, read_url }

const NEWLINE: u64 = 10
const ENV_CONF_MAX: u64 = 512

fn append_env(env: u64, at: u64) -> u64 {
    var p_conf: [u8; 13] = "/etc/xfx.env\0"
    var buf: [u8; 512] = [0 as u8; 512]
    let n: u64 = xfxio.read_text((&p_conf[0 as usize]) as u64, (&buf[0 as usize]) as u64, ENV_CONF_MAX)
    if n == ulib.EOF {
        return at
    }
    var pos: u64 = at
    var start: u64 = 0
    var i: u64 = 0
    while i <= n {
        let last: bool = i == n
        if last || buf[i as usize] as u64 == NEWLINE {
            buf[i as usize] = 0 as u8
            if i > start {
                pos = xfxio.env_put(env, pos, (&buf[start as usize]) as u64)
            }
            start = i + 1
        }
        i = i + 1
    }
    return pos
}

fn read_url(out: u64, max: u64) -> bool {
    var p_conf: [u8; 13] = "/etc/xfx.url\0"
    let n: u64 = xfxio.read_text((&p_conf[0 as usize]) as u64, out, max)
    if n == ulib.EOF || n == 0 {
        return false
    }
    var i: u64 = 0
    while i < n {
        if octets.ld8(out, i) == NEWLINE {
            __mmio_write8((out + i) as *mut u8, 0 as u8)
            return i > 0
        }
        i = i + 1
    }
    return true
}
