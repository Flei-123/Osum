profile kernel

import ulib
import msg
import busy
import bootcfg
import bootlog

export { announce }

static mut k_title: [u8; 16] = "dual.boot.title\0"
static mut k_a: [u8; 12] = "dual.boot.a\0"
static mut k_b: [u8; 12] = "dual.boot.b\0"
static mut k_c: [u8; 12] = "dual.boot.c\0"
static mut k_d: [u8; 12] = "dual.boot.d\0"
static mut k_title2: [u8; 17] = "dual.boot.title2\0"
static mut s_space: [u8; 2] = " \0"

static mut g_text: [u8; 480] = [0 as u8; 480]
static mut g_title: [u8; 96] = [0 as u8; 96]
static mut g_at: u64 = 0

fn add(p: u64) {
    var i: u64 = 0
    while __mmio_read8((p + i) as *mut u8) != 0 as u8 && g_at < 479 {
        __mmio_write8(((&g_text[0 as usize]) as u64 + g_at) as *mut u8, __mmio_read8((p + i) as *mut u8))
        g_at = g_at + 1
        i = i + 1
    }
    __mmio_write8(((&g_text[0 as usize]) as u64 + g_at) as *mut u8, 0 as u8)
}

fn add_key(k: u64) {
    add(msg.get(k))
    add((&s_space[0 as usize]) as u64)
}

fn begin() {
    g_at = 0
    __mmio_write8((&g_text[0 as usize]) as u64 as *mut u8, 0 as u8)
}

fn title_of(k: u64) -> u64 {
    ulib.strcpy((&g_title[0 as usize]) as u64, msg.get(k))
    return (&g_title[0 as usize]) as u64
}

fn announce() {
    bootlog.log_hint()
    begin()
    add_key((&k_a[0 as usize]) as u64)
    add(bootcfg.loader_display())
    add((&s_space[0 as usize]) as u64)
    add_key((&k_b[0 as usize]) as u64)
    add(bootcfg.register_entry())
    busy.alert(title_of((&k_title[0 as usize]) as u64), (&g_text[0 as usize]) as u64)
    begin()
    add_key((&k_c[0 as usize]) as u64)
    add_key((&k_d[0 as usize]) as u64)
    add(bootcfg.loader_display())
    busy.alert(title_of((&k_title2[0 as usize]) as u64), (&g_text[0 as usize]) as u64)
}
