// ------------------------------------------------------- die Nummern

const WIG_BLIT: u64 = 1800
const WIG_GLYPH: u64 = 1801
const WIG_KERN: u64 = 1802
// ===================================================== RUNDE SYSTEMBUS
//
// DER BUS, VON RING 3 AUS. Ein Systemruf mit einem Op-Wort, und die
// Zahlen stehen in `kernel/sys.fi` (SYS_OSUM_BUS). Was frueher
// `WIG_CLIPSET` war, geht jetzt hier durch -- mit einem TYP, einem
// BESITZER und einem VERLAUF, und zwischen zwei Prozessen statt in
// einem Kernpuffer ohne Namen.
//
// DER RUECKFALL IST ABSICHT und nicht Vorsicht: `nobus` auf der
// Kernel-Befehlszeile schaltet den Bus ab, und dann MUSS die alte
// Zwischenablage weiter tun, was sie seit Runde WIG tut. Das ist die
// Gegenprobe, mit der `tools/systembus/run.sh` misst, dass die neue
// wirklich die neue ist.
const SYS_OSUM_BUS: u64 = 1960

const BUS_REG_OP: u64 = 1
const BUS_FIND_OP: u64 = 2
const BUS_SEND_OP: u64 = 3
const BUS_RECV_OP: u64 = 4
const BUS_SUB_OP: u64 = 5
const BUS_PUB_OP: u64 = 6
const BUS_CLIPSET_OP: u64 = 10
const BUS_CLIPGET_OP: u64 = 11
const BUS_CLIPINFO_OP: u64 = 12
