const C_INPUT_BORDER: u64 = 31
const C_LIST_BG: u64 = 32
const C_MENU_TEXT: u64 = 33
const C_SHADOW: u64 = 34
const C_DANGER: u64 = 35
const C_WARNING: u64 = 36
const C_SUCCESS: u64 = 37
const C_ON_ACCENT: u64 = 38
const C_ACCENT_HOVER: u64 = 39
const C_ACCENT_PRESSED: u64 = 40
const C_COUNT: u64 = 41

// The eighteen names of round K15, kept as ALIASES on the component
// numbers above so that every call written before this round still
// means what it meant. They are the keys of the legacy /etc/theme
// override file as well.
const T_BG: u64 = 0
const T_FG: u64 = 1
const T_DIM: u64 = 2
const T_PANEL: u64 = 3
const T_BTN: u64 = 4
const T_BTNHI: u64 = 5
const T_BTNDN: u64 = 6
const T_LINE: u64 = 7
const T_SEL: u64 = 8
const T_SELFG: u64 = 9
const T_FOCUS: u64 = 10
const T_ENTRY: u64 = 11
const T_HEAD: u64 = 12
const T_SCROLL: u64 = 13
const T_THUMB: u64 = 14
const T_ACCENT: u64 = 15
const T_DLG: u64 = 16
const T_MENU: u64 = 17
const T_COUNT: u64 = 18

// ==================== ROUND LOOK: THE FOURTH LAYER, AND WHY IT EXISTS
//
// Round THEME replaced eighteen hardcoded colours with three layers of
// COLOUR tokens, and it made the interface themable in exactly one
// direction. Justin looked at the result and said it still looks like
// Windows XP -- and he was right, and the reason is that NOTHING ABOUT
// THE SHAPE was ever a token. Every border in this system is one pixel,
// every corner is square, every inner margin is a number somebody typed
// into a painting routine, and no scheme file can reach any of it.
// Repainting a square 1-pixel box in a nicer grey gives a nicer grey
// square box.
//
// So: the same treatment, for FORM. Fourteen tokens, one file per set
// under /etc/shapes/, chosen by `shape=` in /etc/theme.conf --
// deliberately the same arrangement as /etc/schemas/ and `scheme=`,
// because they are the same kind of thing.
//
// FORM AND COLOUR ARE TWO AXES AND NOT ONE POT. `shape=modern
// scheme=night mode=dark` is a legal and useful combination, and so is
// `shape=classic scheme=night`. Anyone who folds them into one
// "theme" has to write four files to offer two shapes and two colour
// schemes, and sixteen to offer four of each.
//
// WHERE THE NUMBERS COME FROM. /root/jarvis/plugins/ui-ux-pro-max --
// design-system/references/primitive-tokens.md (the 4px spacing scale
// and the radius scale: 2, 4, 6, 8, 12, 16) and
// design-system/references/component-specs.md (the button and input
// size table). `modern` uses that table's `sm` row -- 32 px high, 12 px
// of horizontal padding, radius-md -- and NOT its `default` row (40 px,
// 16 px). That is a deliberate, measured departure and it is written
// down in docs/ROUNDLOOK.md: the pages this system already has are laid
// out for windows of 400 to 800 pixels and for a 15-pixel font, and at
// 40 px per control the settings program's Darstellung page is 720
// pixels tall on a 600-pixel screen. A design system is a set of
// numbers to reason with, not a set of numbers to obey.
//
// EVERY TOKEN IS A NUMBER OF PIXELS except the last three, which are
// per-hundred: shadow strength, divider opacity and nothing else.
const M_RADIUS_WINDOW: u64 = 0
const M_RADIUS_PANEL: u64 = 1
const M_RADIUS_BUTTON: u64 = 2
const M_RADIUS_INPUT: u64 = 3
const M_BORDER: u64 = 4
const M_PAD_X: u64 = 5
const M_PAD_Y: u64 = 6
const M_GAP: u64 = 7
const M_ROW: u64 = 8
const M_CTRL_H: u64 = 9
const M_SHADOW: u64 = 10 // 0..100, the strength of a drop shadow
const M_SHADOW_R: u64 = 11 // how far it reaches, in pixels
const M_DIVIDER: u64 = 12 // 0..100, how solid a separating line is
const M_FOCUS: u64 = 13
// ================================================== ROUND SOFTUI
//
// THE THIRD AXIS: SPACE.
//
// Round THEME made COLOUR a token and round LOOK made FORM one, and
// between them they still could not express the single most visible
// difference between an interface from 1998 and one from 2021.  That
// difference is not a colour and it is not a corner radius -- it is how
// much NOTHING there is between two things.  A 1998 dialogue packs a
// label against a field against a frame; a 2021 one puts sixteen pixels
// of surface between them and drops the frame.
//
// So: four numbers on the four-pixel grid the design system ships
// (primitive-tokens.md, --space-1 .. --space-6), named for what they
// separate and not for how big they are:
//
//   spacing_xs   inside a control, between its parts
//   spacing_s    between two controls of one group
//   spacing_m    between two groups -- the padding of a card
//   spacing_l    between two cards, and the margin of a page
//
// `classic` gets the numbers that WERE in the painting routines, so it
// is unchanged by construction: 2 (the inner edge of `frame`), 6 and 10
// (the gap and the padding that stood in six `wlib.box_v` calls in the
// settings program), 12 (pad_x).  `modern` takes 4/8/16/24.
const M_SP_XS: u64 = 14
const M_SP_S: u64 = 15
const M_SP_M: u64 = 16
const M_SP_L: u64 = 17
// The gradient of a title bar and of the taskbar, in brightness steps
// over the whole height.  0 is a flat fill -- what every round before
// this one drew.
const M_GRAD: u64 = 18
// HOW LOUD THE WINDOW CHROME IS, 0..100.  This is the one token in this
// file that decides which ROLE a component reads, and it earns its
// place next to `divider`: both answer the question "how much does this
// shout".
//
// At 100 the title bar of the focused window is the accent colour, the
// way every round since THEME painted it.  At 0 it is a surface, the
// text on it is the ordinary window text, and the accent is left for
// the ONE control the person is working in.  Justin's words: "der
// heutige Stil schreit mit sattem Blau in jeder Titelleiste".
const M_TONE: u64 = 19
// The shadow under a window that is NOT focused.  Two numbers, because
// "flatter" is both weaker and shorter.
const M_SHADOW2: u64 = 20
const M_SHADOW_R2: u64 = 21
// 0 = one red close box, 1 = the three Windows caption buttons.
const M_CAPTION: u64 = 22
// ================================================== RUNDE OBERFLAECHE
//
// DIE FUENFTE SCHICHT: SCHRIFT, HOEHE UND ZEIT.
//
// Runde THEME hat FARBE zu Marken gemacht, LOOK die FORM, SOFTUI den
// RAUM.  Was danach noch als Zahl im Quelltext stand -- und zwar in
// jeder Malroutine einzeln --, war dreierlei:
//
//   1. DIE SCHRIFT.  `wlibc.px_ui()` war EINE Groesse fuer alles.  Eine
//      Oberflaeche mit genau einer Schriftgroesse hat keine Hierarchie;
//      man erkennt an nichts, was eine Ueberschrift und was eine
//      Fussnote ist.  Windows 11, macOS, Material 3 und Adwaita haben
//      alle vier bis sechs Stufen mit FESTGELEGTEN Zeilenhoehen.
//   2. DIE HOEHE.  Es gab genau einen Schatten -- den unter einem
//      Fenster -- und er war ein Zahlenpaar in `wm.fi`.  Eine Karte,
//      ein Menue und ein Dialog liegen aber auf drei verschiedenen
//      Ebenen ueber der Flaeche, und wenn alle drei mit einer 1
//      Bildpunkt breiten Linie abgesetzt werden, sieht die Oberflaeche
//      flach aus, egal welche Farbe man nimmt.
//   3. DIE ZEIT.  Es gab sie gar nicht: nichts in diesem System hat je
//      eine Dauer gekannt.
//
// ZWEI ZAHLEN, NICHT ZWOELF.  Eine Schriftskala mit fuenf Stufen und
// fuenf Zeilenhoehen waere zehn weitere Schluessel in jeder Formdatei
// -- zehn Zahlen, die auseinanderlaufen koennen.  Stattdessen traegt
// die Datei EINE Grundgroesse, und die Stufen sind Abstaende darauf
// (-3, 0, +3, +9); die Zeilenhoehen sind daraus auf das Viererraster
// aufgerundet.  Dieselbe Regel wie bei `ctrl_small`/`ctrl_thin` in
// wlib: eine Zahl in der Datei, feste Verhaeltnisse im Code.
const M_FONT: u64 = 23 // die Grundgroesse der Oberflaechenschrift
const M_MOTION: u64 = 24 // die Grunddauer einer Bewegung, in ms
// ================================================== RUNDE GLAS
//
// DIE SECHSTE SCHICHT IST KEINE SCHICHT, SONDERN DREI ZAHLEN.
//
// Justin will die Taskleiste durchsichtig und wahlweise als Milchglas.
// Das ist keine neue Marke pro Bauteil: es sind drei Zahlen, die den
// ZUSAMMENBAU betreffen und nicht das Malen -- wie deckend eine
// Leiste, wie deckend ein Fenster, wie stark der Weichzeichner
// darunter. Sie stehen trotzdem hier und nicht neben dem
// Fensterserver, weil sie aus derselben Datei kommen wie alles andere
// Aussehen (/etc/theme.conf) und ueber denselben Weg gehen
// (`form_push`).
//
// DER FREIE RADIUS BEKOMMT HIER KEINEN PLATZ, und das ist Absicht: er
// wird beim Aufloesen in M_RADIUS_WINDOW/PANEL/BUTTON/INPUT
// HINEINGESCHRIEBEN. Damit kommt er ohne eine einzige neue Abfrage an
// jeder Stelle an, die heute schon einen Radius malt. Ein
// fuenfundzwanzigster Platz "freier Radius" waere eine zweite Quelle
// fuer dieselbe Zahl gewesen, und dann haette jede Malroutine
// entscheiden muessen, welche der beiden gilt.
const M_TB_ALPHA: u64 = 25 // Deckkraft der Taskleiste, 0..100
const M_WIN_ALPHA: u64 = 26 // Deckkraft gewoehnlicher Fenster, 0..100
const M_TB_BLUR: u64 = 27 // Milchglas unter der Leiste, 0..16
const M_COUNT: u64 = 28

// DIE SCHRIFTSTUFEN.  Fuenf, und jede hat eine ROLLE und keine Groesse
// im Namen -- `TY_TITLE` bleibt richtig, wenn die Grundgroesse sich
// aendert, `px18` nicht.
const TY_CAPTION: u64 = 0 // Hilfstext, Statuszeile, Zeitstempel
const TY_BODY: u64 = 1 // alles Normale: Listen, Knoepfe, Felder
const TY_STRONG: u64 = 2 // betont: Spaltenkopf, Kachelname
const TY_TITLE: u64 = 3 // Abschnitts- und Fenstertitel
const TY_DISPLAY: u64 = 4 // die eine Ueberschrift einer Seite
const TY_COUNT: u64 = 5

// DIE HOEHENSTUFEN.  Was ueber der Flaeche liegt, liegt verschieden
// hoch, und der Unterschied wird ueber FLAECHE, RAHMEN und SCHATTEN
// ausgedrueckt -- nicht ueber eine Linie mehr.
const EL_FLAT: u64 = 0 // die Flaeche selbst
const EL_RAISED: u64 = 1 // eine Karte, ein Kachelfeld
const EL_OVERLAY: u64 = 2 // Menue, Kontrollzentrum, Hinweis
const EL_MODAL: u64 = 3 // ein Dialog
const EL_WINDOW: u64 = 4 // ein Fenster
const EL_COUNT: u64 = 5

// DAS RASTER.  Vier Bildpunkte, wie in jedem der vier Systeme, gegen
// die diese Runde misst.  Es steht hier als Zahl EINMAL, damit
// `snap` und die Formdateien dieselbe Vorstellung davon haben.
const GRID: u64 = 4

// Die kleinste Hoehe, die eine Flaeche haben darf, die man ANFASST.
// 32 ist der Wert, auf den sich Fluent (32), HIG (28..44), Material 3
// (40 empfohlen, 32 dicht) und Adwaita (34) in ihrer dichten Variante
// einigen; darunter wird ein Treffer auf einem Beruehrungsschirm zum
// Gluecksspiel.
const HIT_MIN: u64 = 32
// Die drei Dauern, als Rollen und nicht als Zahlen.
const MO_FAST: u64 = 0
const MO_NORMAL: u64 = 1
const MO_SLOW: u64 = 2

// The two sets this round ships, as NUMBERS and not as names, so that a
// program can ask which one is running without comparing strings.
const SHAPE_CLASSIC: u64 = 0
const SHAPE_MODERN: u64 = 1

// The biggest radius the corner routine will draw. It is a bound on
// work and not on taste: a corner of radius r costs r*r coverage
// samples, and four of them per rectangle.
const RADIUS_MAX: u64 = 24

const MODE_LIGHT: u64 = 0
const MODE_DARK: u64 = 1
const MODE_AUTO: u64 = 2

// ------------------------------------------------------------ the state
static mut neutral: [u64; 13] = [0 as u64; 13]
static mut ramps: [u64; 36] = [0 as u64; 36]
static mut sem: [u64; 23] = [0 as u64; 23]
static mut comp_role: [u64; 41] = [0 as u64; 41]
static mut tok: [u64; 82] = [0 as u64; 82]
static mut ovr_val: [u64; 41] = [0 as u64; 41]
static mut ovr_on: [u64; 41] = [0 as u64; 41]
static mut ovr_n: u64 = 0
static mut live: u64 = 0
static mut generation: u64 = 0
static mut paint_base: u64 = 0
static mut paint_gen: u64 = 0
static mut frame_open: u64 = 0
static mut conf_copy: [u8; 512] = [0 as u8; 512]
static mut conf_len: u64 = 0
static mut booted: u64 = 0

// ---- ROUND LOOK: the shape state
//
// `met` is what every painting routine reads. It starts as `classic`,
// octet for octet the behaviour of every round before this one, so a
// machine with no /etc/shapes and no `shape=` line looks EXACTLY as it
// did -- that is the condition under which this round can be landed
// without re-measuring every screenshot in the repository.
static mut met: [u64; 28] = [0 as u64; 28]
static mut shp_name: [u8; 32] = [0 as u8; 32]
static mut shp_file: [u8; 32] = [0 as u8; 32]
static mut shp_keys: u64 = 0
static mut shp_id: u64 = 0
static mut aa_px: u64 = 0

static mut sch_mode: u64 = 1
static mut sch_high: u64 = 0
static mut sch_accent: u64 = 0
static mut sch_danger: u64 = 0
static mut sch_warning: u64 = 0
static mut sch_success: u64 = 0
static mut sch_name: [u8; 32] = [0 as u8; 32]
static mut sch_file: [u8; 32] = [0 as u8; 32]
// ======================================================= RUNDE FARBE
// DER ZWEITE SCHEMANAME: WELCHE RAMPE DER DUNKELMODUS NIMMT.
//
// GEMESSEN, warum es ihn braucht (Justins Schirm, 2560x1440):
//   scheme=day  mode=dark  ->  window-bg #0f172a  panel-bg #1e293b
// Das sind die Slate-Toene, und Slate ist eine BLAUE Graustufenrampe:
//   #0f172a  B-R = +27      #1e293b  B-R = +29
// Zum Vergleich dieselbe Messung an fremden Systemen:
//   Windows 11 dunkel  0    GNOME 46 dunkel  0    KDE 6 dunkel  +6
// und an der neutralen Rampe, die dieses System schon mitbringt:
//   scheme=midnight (Zinc) ->  #18181b B-R = +3   #27272a B-R = +2
//
// Ein Schema traegt EINE Rampe. `mode=dark` waehlt darin nur das
// andere Ende -- es wechselt NICHT die Rampe. Darum ist der
// Dunkelmodus von `tageslicht` blau: es ist dieselbe Slate-Rampe,
// von unten gelesen.
//
// DIE LOESUNG IST EIN PAAR UND KEINE NEUE RAMPE: `dark_scheme=` nennt
// das Schema, das im Dunkelmodus gilt. Steht die Zeile nicht da,
// bleibt alles wie vorher (dasselbe Schema in beiden Modi) -- kein
// bestehendes Abbild und kein Bildschirmfoto aendert sich dadurch.
static mut sch_dark_file: [u8; 32] = [0 as u8; 32]
static mut sch_keys: u64 = 0
static mut kv_bad: u64 = 0

static mut set_mode: u64 = 2
static mut set_accent: u64 = 0
static mut set_light_min: u64 = 420
static mut set_dark_min: u64 = 1140
static mut tz_offset: u64 = 0

static mut cur_dark: u64 = 0
static mut acc_ok: u64 = 1
static mut acc_exact: u64 = 1
static mut acc_moved: u64 = 0
static mut acc_r_text: u64 = 0
static mut acc_r_ui: u64 = 0

// ============================ ROUND THEMESTORE: THE PROBE
//
// A preset names a scheme, a mode, a shape and an accent.  The list in
// the settings window has to show, for each of ten of them, what it
// LOOKS like and what its contrast IS -- before anything is applied.
//
// There is exactly one resolver in this file and there is going to
// stay exactly one.  So the probe does not re-implement anything: it
// puts the preset's values into the same three variables the settings
// file would have put them in, runs the same `theme_apply`, copies the
// answer out, and then calls `theme_reload()` -- which reads
// /etc/theme.conf off the disk again and restores the true state from
// the file, not from a remembered copy.  Restoring from a copy is how
// round THEME's `theme_reload` came to be one step behind itself.
//
// WHAT IT COSTS AND WHAT IT DOES NOT COST.  Two file reads and two
// resolves per preset; the numbers are in docs/ROUNDTHEMESTORE.md.
// It does publish into the live bank for the length of the call --
// a program that painted in the middle of a probe would paint the
// probed colours.  Nothing does: a probe runs to completion inside one
// event, and `theme_frame_begin` latches a bank for the whole of a
// paint.  It is written down here rather than left to be found.
static mut prb_comp: [u64; 41] = [0 as u64; 41]
static mut prb_met: [u64; 28] = [0 as u64; 28]
static mut prb_pair: [u64; 17] = [0 as u64; 17]
static mut prb_txt: u64 = 0
static mut prb_min: u64 = 0
static mut prb_worst: u64 = 0
static mut prb_ok: u64 = 1
static mut prb_moved: u64 = 0
static mut prb_high: u64 = 0

// THE SEVENTEEN TEXT PAIRINGS, and they are the same seventeen
// `tools/theme/model.py` calls TEXT_PAIRS with kind "normal".  Two
// implementations of one list; `tools/themestore/run.sh` prints both
// and compares them pair by pair, which is the only reason a second
// list is allowed to exist at all.
const PAIR_COUNT: u64 = 17
static mut pair_fg: [u64; 17] = [0 as u64; 17]
static mut pair_bg: [u64; 17] = [0 as u64; 17]
static mut pairs_ok: u64 = 0

fn pairs_init() {
    if pairs_ok != 0 {
        return
    }
    pair_fg[(0) as usize] = S_TEXT_PRIMARY
    pair_bg[(0) as usize] = S_SURFACE
    pair_fg[(1) as usize] = S_TEXT_PRIMARY
    pair_bg[(1) as usize] = S_SURFACE_RAISED
    pair_fg[(2) as usize] = S_TEXT_PRIMARY
    pair_bg[(2) as usize] = S_SURFACE_SUNKEN
    pair_fg[(3) as usize] = S_TEXT_PRIMARY
    pair_bg[(3) as usize] = S_SURFACE_HOVER
    pair_fg[(4) as usize] = S_TEXT_PRIMARY
    pair_bg[(4) as usize] = S_SURFACE_PRESSED
    pair_fg[(5) as usize] = S_TEXT_PRIMARY
    pair_bg[(5) as usize] = S_OVERLAY
    pair_fg[(6) as usize] = S_TEXT_SECONDARY
    pair_bg[(6) as usize] = S_SURFACE
    pair_fg[(7) as usize] = S_TEXT_SECONDARY
    pair_bg[(7) as usize] = S_SURFACE_RAISED
    pair_fg[(8) as usize] = S_TEXT_SECONDARY
    pair_bg[(8) as usize] = S_SURFACE_SUNKEN
    pair_fg[(9) as usize] = S_TEXT_SECONDARY
    pair_bg[(9) as usize] = S_SURFACE_HOVER
    pair_fg[(10) as usize] = S_ON_ACCENT
    pair_bg[(10) as usize] = S_ACCENT
    pair_fg[(11) as usize] = S_ON_ACCENT
    pair_bg[(11) as usize] = S_ACCENT_HOVER
    pair_fg[(12) as usize] = S_ON_ACCENT
    pair_bg[(12) as usize] = S_ACCENT_PRESSED
    pair_fg[(13) as usize] = S_ON_SELECTION
    pair_bg[(13) as usize] = S_SELECTION
    pair_fg[(14) as usize] = S_DANGER
    pair_bg[(14) as usize] = S_SURFACE
    pair_fg[(15) as usize] = S_WARNING
    pair_bg[(15) as usize] = S_SURFACE
    pair_fg[(16) as usize] = S_SUCCESS
    pair_bg[(16) as usize] = S_SURFACE
    pairs_ok = 1
}

static mut st_hover: u64 = 0
static mut st_pressed: u64 = 0
static mut st_on: u64 = 0

// ------------------------------------------- fixed point, sRGB and WCAG
//
// One scale for everything: 1.0 is 1 << 24. The product of two values
// in [0,1] fits in 48 bits, so nothing here needs a 128-bit type -- and
// nothing here needs a float, which matters, because this is a
// freestanding profile and there is no libm under it.

fn mulf(a: u64, b: u64) -> u64 {
    return (a * b) >> 24
}

// v to the power 1/5, Newton: r <- (4r + v/r^4) / 5.
fn fifth_root(v: u64) -> u64 {
    if v == 0 {
        return 0
    }
    var r: u64 = SCALE
    var k: u64 = 0
    while k < 60 {
        let r2: u64 = mulf(r, r)
        let r4: u64 = mulf(r2, r2)
        if r4 == 0 {
            k = 60
        } else {
            let q: u64 = (v << 24) / r4
            let nr: u64 = (4 * r + q) / 5
            if nr == r {
                k = 60
            } else {
                r = nr
                k = k + 1
            }
        }
    }
    return r
}

// One sRGB channel (0..255) to linear light, scaled by SCALE.
//
//     WCAG 2.x:  c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055)^2.4
//
// and x^2.4 == x^2 * (x^2)^(1/5) -- which is why a fifth root is the
// whole of the machinery. 0.03928 * 255 = 10.02, so the cut on the
// integer grid falls at c <= 10, and tools/theme/model.py cuts in
// exactly the same place: two implementations that round differently
// are not two implementations of the same thing.
fn lin_of(c: u64) -> u64 {
    let x: u64 = (c * SCALE) / 255
    if c <= 10 {
        return (x * 10000) / 129200
    }
    let t: u64 = ((x + (55 * SCALE) / 1000) * 1000) / 1055
    let t2: u64 = mulf(t, t)
    return mulf(t2, fifth_root(t2))
}

fn luminance(rgb: u64) -> u64 {
    let r: u64 = lin_of((rgb >> 16) & 255)
    let g: u64 = lin_of((rgb >> 8) & 255)
    let b: u64 = lin_of(rgb & 255)
    return (2126 * r + 7152 * g + 722 * b) / 10000
}

// (L1 + 0.05) / (L2 + 0.05), times 100. 452 reads as 4.52 to 1.
fn contrast(a: u64, b: u64) -> u64 {
    var la: u64 = luminance(a)
    var lb: u64 = luminance(b)
    if la < lb {
        let t: u64 = la
        la = lb
        lb = t
    }
    return ((la + SCALE / 20) * 100) / (lb + SCALE / 20)
}

// p percent of b into a, one sRGB channel at a time. Mixing in sRGB
// and not in linear light is a simplification and a visible one; what
// it costs and why it stays is in docs/ROUNDTHEME.md.
fn mix(a: u64, b: u64, p: u64) -> u64 {
    var out: u64 = 0
    var n: u64 = 0
    while n < 3 {
        let s: u64 = 16 - n * 8
        let ca: u64 = (a >> s) & 255
        let cb: u64 = (b >> s) & 255
        let cv: u64 = ((ca * (100 - p) + cb * p) / 100) & 255
        out = out | (cv << s)
        n = n + 1
    }
    return out
}

// -------------------------------------------------- layer 1: the ramps
//
// Steps 100..500 are the base mixed towards white, 700..900 towards
// black, and the base itself is step 600. The percentages are read off
// the Tailwind ramps that the palette file of the design skill is built
// on, so a ramp generated from #2563EB lands within a few units of
// blue-100 .. blue-900 -- which is the point: the ramp is DERIVED, so a
// user who types one colour gets nine that belong together.
fn ramp_build(slot: u64, base: u64) {
    let at: u64 = slot * RAMP_STEPS
    ramps[((at + 0)) as usize] = mix(base, RGB_WHITE, 88)
    ramps[((at + 1)) as usize] = mix(base, RGB_WHITE, 76)
    ramps[((at + 2)) as usize] = mix(base, RGB_WHITE, 60)
    ramps[((at + 3)) as usize] = mix(base, RGB_WHITE, 38)
    ramps[((at + 4)) as usize] = mix(base, RGB_WHITE, 18)
    ramps[((at + 5)) as usize] = base
    ramps[((at + 6)) as usize] = mix(base, RGB_BLACK, 16)
    ramps[((at + 7)) as usize] = mix(base, RGB_BLACK, 33)
    ramps[((at + 8)) as usize] = mix(base, RGB_BLACK, 50)
}

fn ramp_at(slot: u64, step: u64) -> u64 {
    return ramps[((slot * RAMP_STEPS + step)) as usize]
}

// The readable label for a surface: white, black or the darkest
// neutral, whichever reads best. This is not a way around a bad choice
// -- the bad choice is still reported -- it is the difference between
// "hard to read" and "invisible".
fn pick_on(bg: u64) -> u64 {
    var best: u64 = neutral[(N_0) as usize]
    var bestr: u64 = contrast(best, bg)
    var i: u64 = 0
    while i < 2 {
        var c: u64 = neutral[(N_1000) as usize]
        if i == 1 {
            c = neutral[(N_900) as usize]
        }
        let r: u64 = contrast(c, bg)
        if r > bestr {
            bestr = r
            best = c
        }
        i = i + 1
    }
    return best
}

// The hover and pressed states of the accent, DERIVED and not set.
//
// They used to be ramp steps, and the green accent of `night` is why
// they are not: on a green the readable label is BLACK, so walking the
// ramp darker to satisfy the surface rule walks the label rule off a
// cliff, and no step of a green ramp satisfies both at once. They are
// now moved in the direction that can only HELP the label -- if the
// label is light the states go darker, if the label is dark they go
// lighter -- so the label contrast of hover and pressed is at least
// that of the accent itself, by construction.
fn states_of(a: u64) {
    let on: u64 = pick_on(a)
    var towards: u64 = RGB_WHITE
    if luminance(on) > luminance(a) {
        towards = RGB_BLACK
    }
    st_hover = mix(a, towards, 12)
    st_pressed = mix(a, towards, 26)
    st_on = on
}

// ------------------------------------------------ layer 2: the binding
//
// The one function that knows about light and dark, and it does it
// three times: light, dark, and the high-contrast binding that
// `contrast=high` in a scheme file selects. In that third binding the
// border IS the text colour, secondary text is primary text, and the
// raised and sunken surfaces collapse onto the surface -- depth drawn
// as three close greys is depth a washed-out display eats.
fn bind_neutrals(dark: bool) {
    if !dark {
        if sch_high != 0 {
            sem[(S_SURFACE) as usize] = neutral[(N_0) as usize]
            sem[(S_SURFACE_RAISED) as usize] = neutral[(N_0) as usize]
            sem[(S_SURFACE_SUNKEN) as usize] = neutral[(N_0) as usize]
            sem[(S_SURFACE_HOVER) as usize] = neutral[(N_100) as usize]
            sem[(S_SURFACE_PRESSED) as usize] = neutral[(N_200) as usize]
            sem[(S_TEXT_PRIMARY) as usize] = neutral[(N_1000) as usize]
            sem[(S_TEXT_SECONDARY) as usize] = neutral[(N_1000) as usize]
            sem[(S_TEXT_DISABLED) as usize] = neutral[(N_500) as usize]
            sem[(S_BORDER) as usize] = neutral[(N_1000) as usize]
            sem[(S_BORDER_STRONG) as usize] = neutral[(N_1000) as usize]
            sem[(S_SHADOW) as usize] = neutral[(N_1000) as usize]
        } else {
            sem[(S_SURFACE) as usize] = neutral[(N_50) as usize]
            sem[(S_SURFACE_RAISED) as usize] = neutral[(N_0) as usize]
            sem[(S_SURFACE_SUNKEN) as usize] = neutral[(N_100) as usize]
            sem[(S_SURFACE_HOVER) as usize] = neutral[(N_100) as usize]
            sem[(S_SURFACE_PRESSED) as usize] = neutral[(N_200) as usize]
            sem[(S_TEXT_PRIMARY) as usize] = neutral[(N_900) as usize]
            // n600 and not n500: n500 on surface-sunken measures 4.34
            // to 1 and the bar is 4.5. The number picked the token.
            sem[(S_TEXT_SECONDARY) as usize] = neutral[(N_600) as usize]
            sem[(S_TEXT_DISABLED) as usize] = neutral[(N_400) as usize]
            sem[(S_BORDER) as usize] = neutral[(N_200) as usize]
            // n500 and not n400: a control boundary is a user interface
            // component (WCAG 1.4.11) and needs 3 to 1; n400 measures
            // 2.45 on this surface.
            sem[(S_BORDER_STRONG) as usize] = neutral[(N_500) as usize]
            sem[(S_SHADOW) as usize] = neutral[(N_950) as usize]
        }
    } else {
        if sch_high != 0 {
            sem[(S_SURFACE) as usize] = neutral[(N_1000) as usize]
            sem[(S_SURFACE_RAISED) as usize] = neutral[(N_1000) as usize]
            sem[(S_SURFACE_SUNKEN) as usize] = neutral[(N_1000) as usize]
            sem[(S_SURFACE_HOVER) as usize] = neutral[(N_800) as usize]
            sem[(S_SURFACE_PRESSED) as usize] = neutral[(N_700) as usize]
            sem[(S_TEXT_PRIMARY) as usize] = neutral[(N_0) as usize]
            sem[(S_TEXT_SECONDARY) as usize] = neutral[(N_0) as usize]
            sem[(S_TEXT_DISABLED) as usize] = neutral[(N_400) as usize]
            sem[(S_BORDER) as usize] = neutral[(N_0) as usize]
            sem[(S_BORDER_STRONG) as usize] = neutral[(N_0) as usize]
            sem[(S_SHADOW) as usize] = neutral[(N_1000) as usize]
        } else {
            sem[(S_SURFACE) as usize] = neutral[(N_900) as usize]
            sem[(S_SURFACE_RAISED) as usize] = neutral[(N_800) as usize]
            sem[(S_SURFACE_SUNKEN) as usize] = neutral[(N_950) as usize]
            // ================================= RUNDE HOVERSTIL
            // HIER STAND N_800 -- DIESELBE STUFE WIE DIE FLAECHE.
            //
            // Gemessen im Lauf hd1 (Schema midnight, mode=dark):
            //
            //     qs: kf sl=3 on=0 hov=99 bg=2565930 bthi=2565930
            //
            // T_BTN und T_BTNHI waren beide 0x27272A. Ein Zeiger ueber
            // einer ausgeschalteten Kachel oder einem Fussknopf
            // aenderte im Bild deshalb GAR NICHTS (Abstand 0 von 255),
            // waehrend derselbe Fall im hellen Schema 14 Stufen
            // Unterschied hat. Das Kontrollzentrum war unschuldig --
            // es malt die Farbe, die hier steht.
            //
            // WIE HERUM: hell geht der Hover von N_0 nach N_100, also
            // vom Grund WEG ins Dunklere. Dunkel muss er entsprechend
            // ins Hellere gehen, sonst verschwindet er im Grund.
            //
            // UND WARUM GEDRUECKT MITWANDERT: N_700 war bereits
            // S_SURFACE_PRESSED. Haette nur der Hover sich dorthin
            // bewegt, waeren ueberfahren und gedrueckt gleich -- der
            // Fehler waere nur verschoben. Jetzt sind es vier Stufen:
            // Grund 900, Flaeche 800, ueberfahren 700, gedrueckt 600.
            sem[(S_SURFACE_HOVER) as usize] = neutral[(N_700) as usize]
            sem[(S_SURFACE_PRESSED) as usize] = neutral[(N_600) as usize]
            sem[(S_TEXT_PRIMARY) as usize] = neutral[(N_50) as usize]
            // ================================= RUNDE FARBE (15.09.2026), A-021
            // HIER STAND N_400, UND DAS WAR SEIT DEM HOVER-FIX ZU WENIG.
            //
            // WCAG 2.1 (1.4.3) verlangt 4,5:1 fuer normalen Text. Gemessen mit
            // `tools/theme/wcag_check.py` (Gleitkomma, unabhaengig von der
            // Festkommarechnung dieser Datei) auf S_SURFACE_HOVER:
            //
            //     Schema     surface-hover   N_400 (alt)   N_300 (neu)
            //     day        #334155          4,038         6,974
            //     paper      #44403c          4,073         6,896
            //     night      #334155          4,038         6,974
            //     midnight   #3f3f46          4,075         7,066
            //
            // URSACHE IST DER HOVER-FIX DARUEBER, UND ER WAR RICHTIG.
            // S_SURFACE_HOVER ist von N_800 nach N_700 gewandert, also
            // HELLER geworden -- sonst aenderte ein Zeiger ueber einer
            // Kachel gar nichts. Damit ist der Abstand zum gedaempften
            // N_400 unter die Schwelle gerutscht. Die Zusage wurde damals
            // ausdruecklich ROT GELASSEN statt entschaerft; das hier ist
            // die Gegenbuchung dazu.
            //
            // WARUM N_300 UND NICHT N_200: N_300 raeumt alle vier Faelle mit
            // Abstand (6,9..7,1) und bleibt dabei sichtbar GEDAEMPFT
            // gegenueber S_TEXT_PRIMARY (N_50) -- das ist der Sinn der
            // Rolle. N_200 (8,2..8,4) wuerde den Unterschied zwischen
            // primaer und sekundaer weiter einebnen, ohne dass die Zahl es
            // verlangt.
            //
            // GEGENGEPRUEFT, dass N_300 nirgends anders knapp wird -- die
            // engste andere Paarung ist auf S_SURFACE_RAISED (N_800) und
            // steht bei 9,85 / 10,18 / 10,08. Keine Paarung verschlechtert
            // sich, 110 von 110 erfuellen die Schwelle.
            //
            // ZWEITE STELLE: tools/theme/model.py. Genau dieses Nicht-
            // Nachziehen war vier von fuenf Ursachen der Runde KLEINKRAM.
            sem[(S_TEXT_SECONDARY) as usize] = neutral[(N_300) as usize]
            sem[(S_TEXT_DISABLED) as usize] = neutral[(N_600) as usize]
            sem[(S_BORDER) as usize] = neutral[(N_700) as usize]
            sem[(S_BORDER_STRONG) as usize] = neutral[(N_500) as usize]
            sem[(S_SHADOW) as usize] = neutral[(N_1000) as usize]
        }
    }
}

// The d-th candidate step around `start`: the preferred direction
// first, then the other one. RAMP_STEPS means "there is none".
fn cand_step(start: u64, up: bool, d: u64, second: bool) -> u64 {
    var forward: bool = up
    if second {
        if d == 0 {
            return RAMP_STEPS
        }
        forward = !up
    }
    if forward {
        if start + d < RAMP_STEPS {
            return start + d
        }
        return RAMP_STEPS
    }
    if start >= d {
        return start - d
    }
    return RAMP_STEPS
}

// The step of a generated ramp nearest to `start` that clears `need`
// against the surface; if none does, the step with the most contrast.
// The status colours go through here, and the high-contrast scheme in
// dark mode is why: at its own step danger measured 5.32 to 1 against
// a 7 to 1 bar.
fn fit_status(slot: u64, start: u64, up: bool, need: u64) -> u64 {
    let bg: u64 = sem[(S_SURFACE) as usize]
    var d: u64 = 0
    while d < RAMP_STEPS {
        var k: u64 = 0
        while k < 2 {
            let i: u64 = cand_step(start, up, d, k == 1)
            if i < RAMP_STEPS {
                if contrast(ramp_at(slot, i), bg) >= need {
                    return ramp_at(slot, i)
                }
            }
            k = k + 1
        }
        d = d + 1
    }
    var best: u64 = ramp_at(slot, 0)
    var bestr: u64 = contrast(best, bg)
    var i2: u64 = 1
    while i2 < RAMP_STEPS {
        let r: u64 = contrast(ramp_at(slot, i2), bg)
        if r > bestr {
            bestr = r
            best = ramp_at(slot, i2)
        }
        i2 = i2 + 1
    }
    return best
}

// THE ACCENT, AND THE TWO RULES THAT DECIDE WHETHER IT MAY STAY.
//
//   WCAG 1.4.3   text on the accent needs 4.5 to 1
//   WCAG 1.4.11  the accent is a user interface component against the
//                surface and needs 3 to 1
//
// The high-contrast scheme raises both to 7 and 4.5, which is the
// entire reason it exists. If the colour the user typed fails, the
// generated ramp is searched -- nearest step first, in the direction
// the mode prefers -- and the accent MOVES. It is not silently
// allowed, and it is not silently refused either: `acc_exact` and
// `acc_ok` come back out and the settings window prints them.
fn bind_accent(dark: bool) {
    var need_text: u64 = 450
    var need_ui: u64 = 300
    if sch_high != 0 {
        need_text = 700
        need_ui = 450
    }
    var start: u64 = A_600
    var up: bool = true
    if dark {
        start = A_400
        up = false
    }
    let bg: u64 = sem[(S_SURFACE) as usize]
    var idx: u64 = start
    var found: bool = false
    var d: u64 = 0
    while d < RAMP_STEPS && !found {
        var k: u64 = 0
        while k < 2 && !found {
            let i: u64 = cand_step(start, up, d, k == 1)
            if i < RAMP_STEPS {
                let a: u64 = ramp_at(R_ACCENT, i)
                states_of(a)
                if contrast(st_on, a) >= need_text
                    && contrast(a, bg) >= need_ui {
                    idx = i
                    found = true
                }
            }
            k = k + 1
        }
        d = d + 1
    }
    if !found {
        // Nothing on the ramp satisfies both rules. Take the step that
        // comes closest rather than the one that was asked for, and
        // keep the answer "no" -- the settings window has to be able to
        // say so instead of quietly drawing something unreadable.
        var bestscore: u64 = 0
        var i3: u64 = 0
        while i3 < RAMP_STEPS {
            let a3: u64 = ramp_at(R_ACCENT, i3)
            states_of(a3)
            var t: u64 = (contrast(st_on, a3) * 100) / need_text
            var u: u64 = (contrast(a3, bg) * 100) / need_ui
            if t > 100 {
                t = 100
            }
            if u > 100 {
                u = 100
            }
            if t + u > bestscore {
                bestscore = t + u
                idx = i3
            }
            i3 = i3 + 1
        }
    }
    acc_ok = 0
    if found {
        acc_ok = 1
    }
    acc_exact = 0
    if idx == start {
        acc_exact = 1
    }
    if idx > start {
        acc_moved = idx - start
    } else {
        acc_moved = start - idx
    }
    let accent: u64 = ramp_at(R_ACCENT, idx)
    states_of(accent)
    acc_r_text = contrast(st_on, accent)
    acc_r_ui = contrast(accent, bg)

    // THE FOCUS RING IS NOT THE ACCENT. It is the step of the accent
    // ramp that stands out most against the surface. Tying it to the
    // accent gave a 1.91 to 1 ring for the green scheme in light mode,
    // and a focus ring nobody can see is not a focus ring.
    var fbest: u64 = ramp_at(R_ACCENT, 0)
    var fr: u64 = contrast(fbest, bg)
    var i4: u64 = 1
    while i4 < RAMP_STEPS {
        let r4: u64 = contrast(ramp_at(R_ACCENT, i4), bg)
        if r4 > fr {
            fr = r4
            fbest = ramp_at(R_ACCENT, i4)
        }
        i4 = i4 + 1
    }

    sem[(S_ACCENT) as usize] = accent
    sem[(S_ACCENT_HOVER) as usize] = st_hover
    sem[(S_ACCENT_PRESSED) as usize] = st_pressed
    sem[(S_ACCENT_DISABLED) as usize] = mix(accent, bg, 65)
    sem[(S_ON_ACCENT) as usize] = st_on
    sem[(S_BORDER_FOCUS) as usize] = fbest
    sem[(S_SELECTION) as usize] = accent
    sem[(S_ON_SELECTION) as usize] = st_on
    sem[(S_OVERLAY) as usize] = sem[(S_SURFACE_RAISED) as usize]
    sem[(S_DANGER) as usize] = fit_status(R_DANGER, start, up, need_text)
    sem[(S_WARNING) as usize] = fit_status(R_WARNING, start, up, need_text)
    sem[(S_SUCCESS) as usize] = fit_status(R_SUCCESS, start, up, need_text)
}

// ------------------------------------------ layer 3: component to role
//
// THIS TABLE IS THE RULE "no component names a colour", written down.
// Every entry is a semantic index. Adding a component means adding a
// line here, not adding a colour somewhere.
fn comp_map_init() {
    comp_role[(C_WINDOW_BG) as usize] = S_SURFACE
    comp_role[(C_WINDOW_TEXT) as usize] = S_TEXT_PRIMARY
    comp_role[(C_TEXT_MUTED) as usize] = S_TEXT_SECONDARY
    comp_role[(C_PANEL_BG) as usize] = S_SURFACE_RAISED
    comp_role[(C_BUTTON_FACE) as usize] = S_SURFACE_RAISED
    comp_role[(C_BUTTON_HOVER) as usize] = S_SURFACE_HOVER
    comp_role[(C_BUTTON_PRESSED) as usize] = S_SURFACE_PRESSED
    comp_role[(C_BORDER) as usize] = S_BORDER
    comp_role[(C_SELECT_BG) as usize] = S_SELECTION
    comp_role[(C_SELECT_TEXT) as usize] = S_ON_SELECTION
    comp_role[(C_FOCUS_RING) as usize] = S_BORDER_FOCUS
    comp_role[(C_INPUT_BG) as usize] = S_SURFACE_SUNKEN
    comp_role[(C_HEADER_BG) as usize] = S_SURFACE_HOVER
    comp_role[(C_SCROLL_TRACK) as usize] = S_SURFACE_SUNKEN
    comp_role[(C_SCROLL_THUMB) as usize] = S_BORDER_STRONG
    comp_role[(C_ACCENT) as usize] = S_ACCENT
    comp_role[(C_DIALOG_BG) as usize] = S_OVERLAY
    comp_role[(C_MENU_BG) as usize] = S_OVERLAY
    comp_role[(C_TITLEBAR_BG) as usize] = S_ACCENT
    comp_role[(C_TITLEBAR_TEXT) as usize] = S_ON_ACCENT
    comp_role[(C_TITLEBAR_OFF_BG) as usize] = S_SURFACE_RAISED
    comp_role[(C_TITLEBAR_OFF_TEXT) as usize] = S_TEXT_SECONDARY
    comp_role[(C_WINDOW_FRAME) as usize] = S_BORDER_STRONG
    comp_role[(C_TASKBAR_BG) as usize] = S_SURFACE_RAISED
    comp_role[(C_TASKBAR_TEXT) as usize] = S_TEXT_PRIMARY
    comp_role[(C_TASKBAR_ACTIVE) as usize] = S_ACCENT
    comp_role[(C_DESKTOP_TOP) as usize] = S_SURFACE_SUNKEN
    comp_role[(C_DESKTOP_BOTTOM) as usize] = S_SURFACE
    comp_role[(C_BUTTON_TEXT) as usize] = S_TEXT_PRIMARY
    comp_role[(C_BUTTON_DISABLED_TEXT) as usize] = S_TEXT_DISABLED
    comp_role[(C_INPUT_TEXT) as usize] = S_TEXT_PRIMARY
    comp_role[(C_INPUT_BORDER) as usize] = S_BORDER_STRONG
    comp_role[(C_LIST_BG) as usize] = S_SURFACE_SUNKEN
    comp_role[(C_MENU_TEXT) as usize] = S_TEXT_PRIMARY
    comp_role[(C_SHADOW) as usize] = S_SHADOW
    comp_role[(C_DANGER) as usize] = S_DANGER
    comp_role[(C_WARNING) as usize] = S_WARNING
    comp_role[(C_SUCCESS) as usize] = S_SUCCESS
    comp_role[(C_ON_ACCENT) as usize] = S_ON_ACCENT
    comp_role[(C_ACCENT_HOVER) as usize] = S_ACCENT_HOVER
    comp_role[(C_ACCENT_PRESSED) as usize] = S_ACCENT_PRESSED
}

// FILL THE BANK THAT IS NOT IN USE, THEN FLIP ONE WORD. That is the
// whole of the tear-free switch on the window side.
fn publish() {
    var shadow: u64 = 1
    if live == 1 {
        shadow = 0
    }
    let at: u64 = shadow * C_COUNT
    var i: u64 = 0
    while i < C_COUNT {
        var v: u64 = sem[(comp_role[(i) as usize]) as usize]
        if ovr_on[(i) as usize] != 0 {
            v = ovr_val[(i) as usize]
        }
        tok[((at + i)) as usize] = v
        i = i + 1
    }
    live = shadow
    generation = generation + 1
    // A program that is NOT inside a paint reads the live bank at
    // once. A program that IS inside one keeps the bank it latched --
    // that is the entire promise, and moving `paint_base` here would
    // break it. It was broken exactly once, and the latch test said so
    // in one line: L_INNER came back dark inside a light frame.
    if frame_open == 0 {
        paint_base = live * C_COUNT
    }
}

// ----------------------------------------------------------- reading
//
// `theme(i)` reads the bank the CURRENT PAINT latched, not the live
// one. A window that started painting light finishes light.
fn theme(i: u64) -> u64 {
    if i >= C_COUNT {
        return 0
    }
    return tok[((paint_base + i)) as usize]
}

// ============================================ RUNDE BLECHFUENF
// DIE SCHRIFT AUF DER AUSWAHL, MIT ZUSAGE STATT MIT HOFFNUNG.
//
// Justin meldet: in der Programmliste des Suchen-Dialogs laesst sich
// nichts anklicken. Gemessen an seiner eigenen Diagnosezeile stimmt das
// nicht ganz -- die Auswahl WIRD gesetzt (`wlib.on_down` ruft
// `row_under` und schreibt D_VAL), aber sie wird UNSICHTBAR gemalt:
//
//     sel=3104668  selfg=0
//
// 3104668 ist 0x2F5CDC, ein dunkles Blau; 0 ist Schwarz. Schwarze
// Schrift auf dunkelblauem Grund hat ein Kontrastverhaeltnis von 3,7 --
// unter jeder Lesbarkeitsgrenze und neben der ungewaehlten Zeile
// (0xF8F8FC auf dunkel) schlicht ein leerer Balken. Wer darauf klickt,
// sieht die Zeile VERSCHWINDEN und schliesst daraus, dass der Klick
// nichts tut. Er tut etwas, und das ist schlimmer.
//
// Warum `pick_on` fuer diesen Akzent Schwarz gewaehlt hat, ist mit den
// Zahlen aus dem Foto nicht zu belegen -- also wird hier nicht geraten,
// sondern eine ZUSAGE eingezogen: die Schrift auf der Auswahl muss
// gegen die Auswahl mindestens 4,5 zu 1 stehen. Haelt der Wert aus dem
// Farbwerk das, bleibt er; haelt er es nicht, wird der bessere von
// Schwarz und Weiss genommen. Eine Auswahl, die niemand lesen kann,
// ist keine.
fn theme_selfg() -> u64 {
    let bg: u64 = theme(T_SEL)
    let fg: u64 = theme(T_SELFG)
    if contrast(fg, bg) >= 45 {
        return fg
    }
    let w: u64 = RGB_WHITE
    let b: u64 = RGB_BLACK
    if contrast(w, bg) >= contrast(b, bg) {
        return w
    }
    return b
}

// Die gemessenen Zahlen dazu, damit ein Testlaeufer sie nachrechnen
// kann statt sie zu glauben.
fn theme_selfg_kontrast() -> u64 {
    return contrast(theme_selfg(), theme(T_SEL))
}

fn theme_live(i: u64) -> u64 {
    if i >= C_COUNT {
        return 0
    }
    return tok[((live * C_COUNT + i)) as usize]
}

fn theme_semantic(i: u64) -> u64 {
    if i >= S_COUNT {
        return 0
    }
    return sem[(i) as usize]
}

fn theme_neutral(i: u64) -> u64 {
    if i >= NEUTRAL_STEPS {
        return 0
    }
    return neutral[(i) as usize]
}

fn theme_ramp(slot: u64, step: u64) -> u64 {
    if slot >= R_COUNT || step >= RAMP_STEPS {
        return 0
    }
    return ramp_at(slot, step)
}

fn theme_role_of(i: u64) -> u64 {
    if i >= C_COUNT {
        return S_COUNT
    }
    return comp_role[(i) as usize]
}

fn theme_gen() -> u64 {
    return generation
}

// Latch the live bank for one paint and answer the generation it got.
fn theme_frame_begin() -> u64 {
    frame_open = 1
    paint_base = live * C_COUNT
    paint_gen = generation
    return paint_gen
}

// Close the paint and answer whether the theme moved while it ran.
// Closing matters: after it, `theme()` follows the live bank again.
fn theme_frame_end() -> bool {
    frame_open = 0
    let stale: bool = paint_gen != generation
    paint_base = live * C_COUNT
    return stale
}

// Did the theme move while that paint was running? Then the window
// owes the screen ONE more pass -- one, not a loop, because the next
// paint latches the new bank.
fn theme_frame_stale() -> bool {
    return paint_gen != generation
}

fn theme_dark() -> bool {
    return cur_dark != 0
}

fn theme_mode() -> u64 {
    return set_mode
}

fn theme_scheme_mode() -> u64 {
    return sch_mode
}

fn theme_high() -> bool {
    return sch_high != 0
}

fn theme_accent_ok() -> bool {
    return acc_ok != 0
}

fn theme_accent_exact() -> bool {
    return acc_exact != 0
}

fn theme_accent_moved() -> u64 {
    return acc_moved
}

fn theme_accent_ratio_text() -> u64 {
    return acc_r_text
}

fn theme_accent_ratio_ui() -> u64 {
    return acc_r_ui
}

// ROUND THEMESTORE: what /etc/theme.conf's `accent=` line SAYS, and 0
// if the line is empty. `theme_accent_wanted` answers a different
// question -- it falls back to the scheme's own accent, which is what
// the settings window wants to display and exactly what a preset
// writer must NOT write down, because then the preset would pin a
// colour the scheme is free to change.
fn theme_accent_own() -> u64 {
    if set_accent == ACCENT_BLACK {
        return ACCENT_BLACK
    }
    return set_accent
}

fn theme_accent_wanted() -> u64 {
    if set_accent != 0 {
        if set_accent == ACCENT_BLACK {
            return 0
        }
        return set_accent
    }
    return sch_accent
}

fn theme_scheme_name() -> u64 {
    return (&sch_name[0 as usize]) as u64
}

fn theme_scheme_file() -> u64 {
    return (&sch_file[0 as usize]) as u64
}

fn theme_contrast(a: u64, b: u64) -> u64 {
    return contrast(a, b)
}

fn theme_luminance(c: u64) -> u64 {
    return luminance(c)
}

fn theme_linear(c: u64) -> u64 {
    if c > 255 {
        return 0
    }
    return lin_of(c)
}

fn theme_on(bg: u64) -> u64 {
    return pick_on(bg)
}

fn theme_light_start() -> u64 {
    return set_light_min
}

fn theme_dark_start() -> u64 {
    return set_dark_min
}

fn theme_tz_offset() -> u64 {
    return tz_offset
}

// ------------------------------------------------------------- names
//
// One blob and an index built by scanning it, instead of a function
// per name. The order MUST match the C_* and S_* numbers above; the
// test walks both lists and says so if it does not.
static mut comp_blob: [u8; 474] = "window-bg\0window-text\0text-muted\0panel-bg\0button-face\0button-hover\0button-pressed\0border\0select-bg\0select-text\0focus-ring\0input-bg\0header-bg\0scroll-track\0scroll-thumb\0accent\0dialog-bg\0menu-bg\0titlebar-bg\0titlebar-text\0titlebar-off-bg\0titlebar-off-text\0window-frame\0taskbar-bg\0taskbar-text\0taskbar-active\0desktop-top\0desktop-bottom\0button-text\0button-disabled-text\0input-text\0input-border\0list-bg\0menu-text\0shadow\0danger\0warning\0success\0on-accent\0accent-hover\0accent-pressed\0"
static mut sem_blob: [u8; 266] = "surface\0surface-raised\0surface-sunken\0surface-hover\0surface-pressed\0text-primary\0text-secondary\0text-disabled\0border\0border-strong\0border-focus\0accent\0accent-hover\0accent-pressed\0accent-disabled\0on-accent\0selection\0on-selection\0overlay\0danger\0warning\0success\0shadow\0"
static mut legacy_blob: [u8; 93] = "bg\0fg\0dim\0panel\0btn\0btnhi\0btndn\0line\0sel\0selfg\0focus\0entry\0head\0scroll\0thumb\0accent\0dlg\0menu\0"
static mut comp_at: [u64; 41] = [0 as u64; 41]
static mut sem_at: [u64; 23] = [0 as u64; 23]
static mut legacy_at: [u64; 18] = [0 as u64; 18]
static mut names_ok: u64 = 0

fn blob_index(blob: u64, out: u64, n: u64) {
    var p: u64 = blob
    var i: u64 = 0
    while i < n {
        __mmio_write64((out + i * 8) as *mut u64, p)
        while *((p) as *mut u8) != 0 as u8 {
            p = p + 1
        }
        p = p + 1
        i = i + 1
    }
}

fn names_init() {
    if names_ok != 0 {
        return
    }
    blob_index((&comp_blob[0 as usize]) as u64,
        (&comp_at[0 as usize]) as u64, C_COUNT)
    blob_index((&sem_blob[0 as usize]) as u64,
        (&sem_at[0 as usize]) as u64, S_COUNT)
    blob_index((&legacy_blob[0 as usize]) as u64,
        (&legacy_at[0 as usize]) as u64, T_COUNT)
    names_ok = 1
}

fn theme_name_at(i: u64) -> u64 {
    names_init()
    if i >= C_COUNT {
        return 0
    }
    return comp_at[(i) as usize]
}

fn theme_semantic_name_at(i: u64) -> u64 {
    names_init()
    if i >= S_COUNT {
        return 0
    }
    return sem_at[(i) as usize]
}

fn name_eq(p: u64, n: u64, q: u64) -> bool {
    var k: u64 = 0
    while k < n {
        let a: u64 = (*((p + k) as *mut u8)) as u64
        let b: u64 = (*((q + k) as *mut u8)) as u64
        if b == 0 || a != b {
            return false
        }
        k = k + 1
    }
    return (*((q + n) as *mut u8)) as u64 == 0
}

// A name to a component number. The new names first, then the eighteen
// short ones of round K15 -- a /etc/theme written before this round
// still says what it said.
fn theme_named(p: u64, n: u64) -> u64 {
    names_init()
    var i: u64 = 0
    while i < C_COUNT {
        if name_eq(p, n, comp_at[(i) as usize]) {
            return i
        }
        i = i + 1
    }
    var j: u64 = 0
    while j < T_COUNT {
        if name_eq(p, n, legacy_at[(j) as usize]) {
            return j
        }
        j = j + 1
    }
    return C_COUNT
}

// ----------------------------------------------------------- parsing
//
// A scheme file and the settings file have the same shape: key=value,
// one per line, `#` starts a comment, and a line that names nothing is
// COUNTED and not swallowed -- mistype a key and you want to be told,
// not to spend an evening looking for a colour.

fn hex4(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return 16
}

fn parse_hex(p: u64, n: u64) -> u64 {
    var v: u64 = 0
    var digits: u64 = 0
    var k: u64 = 0
    while k < n {
        let d: u64 = hex4((*((p + k) as *mut u8)) as u64)
        if d >= 16 {
            return RGB_BAD
        }
        v = (v << 4) | d
        digits = digits + 1
        k = k + 1
    }
    if digits != 6 {
        return RGB_BAD
    }
    return v
}

fn parse_dec(p: u64, n: u64) -> u64 {
    var v: u64 = 0
    var digits: u64 = 0
    var k: u64 = 0
    while k < n {
        let c: u64 = (*((p + k) as *mut u8)) as u64
        if c < 48 || c > 57 {
            return DEC_BAD
        }
        v = v * 10 + (c - 48)
        digits = digits + 1
        k = k + 1
    }
    if digits == 0 {
        return DEC_BAD
    }
    return v
}

// "07:30" -> 450 minutes. Anything else -> DEC_BAD.
fn parse_clock(p: u64, n: u64) -> u64 {
    var h: u64 = 0
    var m: u64 = 0
    var seen: u64 = 0
    var at: u64 = 0
    var k: u64 = 0
    while k < n {
        let c: u64 = (*((p + k) as *mut u8)) as u64
        if c == 58 {
            if at == 1 {
                return DEC_BAD
            }
            at = 1
            seen = 0
        } else if c >= 48 && c <= 57 {
            if at == 0 {
                h = h * 10 + (c - 48)
            } else {
                m = m * 10 + (c - 48)
            }
            seen = seen + 1
        } else {
            return DEC_BAD
        }
        k = k + 1
    }
    if at != 1 || seen == 0 || h > 23 || m > 59 {
        return DEC_BAD
    }
    return h * 60 + m
}

fn neutral_index(step: u64) -> u64 {
    if step == 0 {
        return N_0
    }
    if step == 50 {
        return N_50
    }
    if step == 100 {
        return N_100
    }
    if step == 200 {
        return N_200
    }
    if step == 300 {
        return N_300
    }
    if step == 400 {
        return N_400
    }
    if step == 500 {
        return N_500
    }
    if step == 600 {
        return N_600
    }
    if step == 700 {
        return N_700
    }
    if step == 800 {
        return N_800
    }
    if step == 900 {
        return N_900
    }
    if step == 950 {
        return N_950
    }
    if step == 1000 {
        return N_1000
    }
    return NEUTRAL_STEPS
}

fn copy_bounded(dst: u64, src: u64, n: u64, max: u64) {
    var k: u64 = 0
    while k < n && k + 1 < max {
        __mmio_write8((dst + k) as *mut u8, *((src + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((dst + k) as *mut u8, 0 as u8)
}

fn scheme_key(kp: u64, kn: u64, vp: u64, vn: u64) -> bool {
    var k_name: [u8; 5] = "name\0"
    var k_mode: [u8; 5] = "mode\0"
    var k_shadow: [u8; 7] = "shadow\0"
    var k_contrast: [u8; 9] = "contrast\0"
    var k_accent: [u8; 7] = "accent\0"
    var k_danger: [u8; 7] = "danger\0"
    var k_warning: [u8; 8] = "warning\0"
    var k_success: [u8; 8] = "success\0"
    var k_neutral: [u8; 8] = "neutral\0"
    var v_dark: [u8; 5] = "dark\0"
    var v_high: [u8; 5] = "high\0"

    if name_eq(kp, kn, (&k_name[0 as usize]) as u64) {
        copy_bounded((&sch_name[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    // RUNDE ECHTHARDWARE-6: der Schattenschalter. `on`/`1` schaltet
    // ihn an, alles andere aus -- und nicht gesetzt heisst aus.
    if name_eq(kp, kn, (&k_shadow[0 as usize]) as u64) {
        var v_on: [u8; 3] = "on\0"
        var v_eins: [u8; 2] = "1\0"
        set_shadow = SHDW_OFF
        if name_eq(vp, vn, (&v_on[0 as usize]) as u64)
            || name_eq(vp, vn, (&v_eins[0 as usize]) as u64) {
            set_shadow = SHDW_AN
        }
        return true
    }
    if name_eq(kp, kn, (&k_mode[0 as usize]) as u64) {
        sch_mode = MODE_LIGHT
        if name_eq(vp, vn, (&v_dark[0 as usize]) as u64) {
            sch_mode = MODE_DARK
        }
        return true
    }
    if name_eq(kp, kn, (&k_contrast[0 as usize]) as u64) {
        sch_high = 0
        if name_eq(vp, vn, (&v_high[0 as usize]) as u64) {
            sch_high = 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_accent[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == RGB_BAD {
            return false
        }
        sch_accent = v
        return true
    }
    if name_eq(kp, kn, (&k_danger[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == RGB_BAD {
            return false
        }
        sch_danger = v
        return true
    }
    if name_eq(kp, kn, (&k_warning[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == RGB_BAD {
            return false
        }
        sch_warning = v
        return true
    }
    if name_eq(kp, kn, (&k_success[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == RGB_BAD {
            return false
        }
        sch_success = v
        return true
    }
    // `neutral<step>`. The literal is exactly seven characters, so
    // comparing seven of them IS the prefix test -- `name_eq` insists
    // that the literal end there, and here it does.
    if kn > 7 {
        if name_eq(kp, 7, (&k_neutral[0 as usize]) as u64) {
            let step: u64 = parse_dec(kp + 7, kn - 7)
            if step == DEC_BAD {
                return false
            }
            let idx: u64 = neutral_index(step)
            if idx >= NEUTRAL_STEPS {
                return false
            }
            let v: u64 = parse_hex(vp, vn)
            if v == RGB_BAD {
                return false
            }
            neutral[(idx) as usize] = v
            return true
        }
    }
    return false
}

// ============================================== RUNDE ECHTHARDWARE-6
// DER SCHATTEN IST EIN SCHALTER, UND ER STEHT AUF AUS.
//
// Justin hat die Diagnose selbst gestellt: die Kammstreifen folgen den
// Fensterkanten, sie entstehen beim Vergroessern und beim Verschieben,
// und der Schatten ist das Problem. Die `sfence`-Massnahme der
// Vorrunde hat sie NICHT beseitigt -- die Erklaerung ueber die
// Schreibpufferordnung war also hoechstens die halbe Wahrheit.
//
// Der Schatten ist der einzige Teil des Anstrichs, der AUSSERHALB des
// Fensterrechtecks malt. Alles andere bleibt in seinen Grenzen; er
// greift `shadow_r` Bildpunkte darueber hinaus. Beim Ziehen und beim
// Groessenaendern wandert damit eine Flaeche mit, die zu KEINEM
// Fensterpuffer gehoert und deshalb auch von keinem Fenster wieder
// sauber uebermalt wird -- was stehenbleibt, sieht aus wie ein Kamm
// entlang der Kante. Das ist Justins Beobachtung, Wort fuer Wort.
//
// Deshalb: STANDARD AUS. Nicht entfernt -- `shadow=on` in
// /etc/theme.conf schaltet ihn zurueck, und die Einstellungen zeigen
// den Schalter. Wer ihn anschaltet, sieht die Streifen wieder, und
// genau das ist zugleich der Beweis fuer die Ursache.
//
// -1 waere hier der schoenere Wert fuer "nicht gesetzt"; diese
// Sprache rechnet an dieser Stelle vorzeichenlos, also 0 = aus,
// 1 = an, 2 = die Form entscheidet.
const SHDW_OFF: u64 = 0
const SHDW_AN: u64 = 1
static mut set_shadow: u64 = SHDW_OFF

fn shadow_an() -> bool {
    return set_shadow == SHDW_AN
}

// Was wirklich an den Fensterserver geht. Steht der Schalter auf aus,
// ist es null -- unabhaengig davon, was die Formdatei sagt.
fn shadow_value(roh: u64) -> u64 {
    if set_shadow == SHDW_AN {
        return roh
    }
    return 0
}

fn conf_key(kp: u64, kn: u64, vp: u64, vn: u64) -> bool {
    var k_scheme: [u8; 7] = "scheme\0"
    var k_dscheme: [u8; 12] = "dark_scheme\0"
    var k_shape: [u8; 6] = "shape\0"
    var k_mode: [u8; 5] = "mode\0"
    var k_accent: [u8; 7] = "accent\0"
    var k_ls: [u8; 12] = "light_start\0"
    var k_ds: [u8; 11] = "dark_start\0"
    // RUNDE GLAS: die vier neuen Zeilen, in derselben Datei und neben
    // den anderen, weil es Einstellungen derselben Art sind.
    var k_rad: [u8; 7] = "radius\0"
    var k_tba: [u8; 14] = "taskbar_alpha\0"
    var k_wa: [u8; 13] = "window_alpha\0"
    var k_blr: [u8; 13] = "taskbar_blur\0"
    var v_dark: [u8; 5] = "dark\0"
    var v_light: [u8; 6] = "light\0"

    if name_eq(kp, kn, (&k_scheme[0 as usize]) as u64) {
        copy_bounded((&sch_file[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    // RUNDE FARBE: das Schema fuer den Dunkelmodus. Siehe die
    // Begruendung bei `sch_dark_file`.
    if name_eq(kp, kn, (&k_dscheme[0 as usize]) as u64) {
        copy_bounded((&sch_dark_file[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    // ROUND LOOK: the second axis, in the same file and beside the
    // first, because they are settings of the same kind.
    if name_eq(kp, kn, (&k_shape[0 as usize]) as u64) {
        copy_bounded((&shp_file[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    if name_eq(kp, kn, (&k_mode[0 as usize]) as u64) {
        set_mode = MODE_AUTO
        if name_eq(vp, vn, (&v_dark[0 as usize]) as u64) {
            set_mode = MODE_DARK
        }
        if name_eq(vp, vn, (&v_light[0 as usize]) as u64) {
            set_mode = MODE_LIGHT
        }
        return true
    }
    if name_eq(kp, kn, (&k_accent[0 as usize]) as u64) {
        if vn == 0 {
            set_accent = 0
            return true
        }
        let v: u64 = parse_hex(vp, vn)
        if v == RGB_BAD {
            return false
        }
        set_accent = v
        if v == 0 {
            set_accent = ACCENT_BLACK
        }
        return true
    }
    if name_eq(kp, kn, (&k_ls[0 as usize]) as u64) {
        let v: u64 = parse_clock(vp, vn)
        if v == DEC_BAD {
            return false
        }
        set_light_min = v
        return true
    }
    if name_eq(kp, kn, (&k_ds[0 as usize]) as u64) {
        let v: u64 = parse_clock(vp, vn)
        if v == DEC_BAD {
            return false
        }
        set_dark_min = v
        return true
    }
    // RUNDE GLAS: VIER ZAHLEN, UND JEDE LIEST NUR ZIFFERN.
    //
    // `parse_dec` gibt DEC_BAD zurueck, sobald ein Zeichen keine Ziffer
    // ist, und dann antwortet diese Funktion `false` -- die Zeile wird
    // als SCHLECHT GEZAEHLT und nicht stillschweigend auf 0 gesetzt.
    // Das ist dieselbe Regel, die `accent=` und `light_start=` schon
    // haben, und sie ist der Grund, warum in einer dieser Zeilen kein
    // Pfad und kein Befehl stehen kann.
    if name_eq(kp, kn, (&k_rad[0 as usize]) as u64) {
        let r: u64 = parse_dec(vp, vn)
        if r == DEC_BAD {
            return false
        }
        usr_radius = cap(r, RADIUS_MAX)
        glas_metrics()
        return true
    }
    if name_eq(kp, kn, (&k_tba[0 as usize]) as u64) {
        let a: u64 = parse_dec(vp, vn)
        if a == DEC_BAD {
            return false
        }
        usr_tba = clamp_alpha(a)
        glas_metrics()
        return true
    }
    if name_eq(kp, kn, (&k_wa[0 as usize]) as u64) {
        let a2: u64 = parse_dec(vp, vn)
        if a2 == DEC_BAD {
            return false
        }
        usr_wa = clamp_alpha(a2)
        glas_metrics()
        return true
    }
    if name_eq(kp, kn, (&k_blr[0 as usize]) as u64) {
        let b: u64 = parse_dec(vp, vn)
        if b == DEC_BAD {
            return false
        }
        usr_blur = cap(b, BLUR_MAX)
        glas_metrics()
        return true
    }
    return false
}

// which: 0 = a scheme file, 1 = the settings file, 2 = the legacy
// /etc/theme override file.
// ROUND LOOK: 4096 AND NOT 1536, and the reason is a bug this round
// walked straight into. A shape file with its rationale in it is 4459
// octets; `kv_read` read the first 1535, which were all comment, and
// reported ZERO keys -- so the resolver fell back to `classic` and the
// two screenshots came out identical. Nothing said so, because "no
// keys" and "no file" took the same branch.
//
// Both are fixed: the buffer is big enough for a documented file, and
// `shape_keys()` is reported on the serial line so that zero is
// visible. The scheme files (about 1.5 kilooctets) were inside the old
// bound by luck and are inside the new one by margin.
// ================================================== ROUND SOFTUI
//
// AND THE SAME BUG AGAIN, ONE FILE LATER -- SO THIS TIME THE LIMIT GOES
// AWAY INSTEAD OF GOING UP.
//
// Round LOOK raised this buffer from 1536 to 4096 because a shape file
// with its reasoning written into it was 4459 octets and the reader saw
// only comment.  Round SOFTUI added nine tokens to `modern.shape`, each
// with the measurement that produced it, and the file became 6981
// octets.  The symptom was identical and just as quiet:
//
//     taskbar: shape file=modern name= id=0 keys=0 ctrl_h=26
//
// -- keys=0, the resolver falls back to `classic`, and a round about
// how the system LOOKS renders in the old shape while every other line
// of the log says `modern`.
//
// Raising 4096 to 8192 would buy exactly one more round.  So the reader
// now takes the file in pieces and carries the unfinished last line
// over into the next one: the buffer bounds a LINE, not a FILE, and
// there is no length at which a documented configuration file stops
// working.  `tools/softui/run.sh` section B checks it on a file with
// twelve kilooctets of comment in front of one key.
fn kv_read(path: u64, which: u64) -> u64 {
    var buf: [u8; 4096] = [0 as u8; 4096]
    let fd: u64 = io.open(path, 0)
    if ulib.bad(fd) {
        return 0
    }
    let b: u64 = (&buf[0 as usize]) as u64
    var taken: u64 = 0
    var rest: u64 = 0
    var weiter: bool = true
    while weiter {
        let n: u64 = io.read(fd, b + rest, 4095 - rest)
        if ulib.bad(n) || n == 0 {
            weiter = false
        } else {
            let have: u64 = rest + n
            // bis zum LETZTEN Zeilenende auswerten; was danach kommt,
            // ist eine angefangene Zeile und wandert nach vorn.
            var cut: u64 = have
            while cut > 0 && *((b + cut - 1) as *mut u8) != 10 as u8 {
                cut = cut - 1
            }
            if cut == 0 {
                // Eine Zeile, die laenger ist als der Puffer. Sie wird
                // ausgewertet und dann verworfen -- eine Marke mit
                // viertausend Oktetten Wert gibt es nicht.
                taken = taken + kv_scan(b, have, which)
                rest = 0
            } else {
                taken = taken + kv_scan(b, cut, which)
                var k: u64 = 0
                while cut + k < have {
                    *((b + k) as *mut u8) =
                        *((b + cut + k) as *mut u8)
                    k = k + 1
                }
                rest = have - cut
            }
        }
    }
    io.close(fd)
    if rest > 0 {
        taken = taken + kv_scan(b, rest, which)
    }
    return taken
}

// DIE OKTETTE, DIE SCHON IM SPEICHER LIEGEN. `conf_changed` liest
// /etc/theme.conf, um zu VERGLEICHEN; ohne diese Trennung las
// `theme_reload` dieselbe Datei gleich danach ein zweites Mal, und auf
// einer Platte, die mit PIO angesprochen wird, ist ein Lesen die
// teuerste Zeile im ganzen Umschalten.
fn kv_scan(b: u64, n: u64, which: u64) -> u64 {
    var taken: u64 = 0
    var i: u64 = 0
    while i < n {
        var e: u64 = i
        while e < n && *((b + e) as *mut u8) != 10 as u8 {
            e = e + 1
        }
        var end: u64 = e
        if end > i {
            if *((b + end - 1) as *mut u8) == 13 as u8 {
                end = end - 1
            }
        }
        if end > i {
            if *((b + i) as *mut u8) != 35 as u8 {
                var g: u64 = i
                while g < end && *((b + g) as *mut u8) != 61 as u8 {
                    g = g + 1
                }
                if g < end {
                    var ve: u64 = g + 1
                    while ve < end && *((b + ve) as *mut u8) != 35 as u8 {
                        ve = ve + 1
                    }
                    while ve > g + 1
                        && *((b + ve - 1) as *mut u8) == 32 as u8 {
                        ve = ve - 1
                    }
                    var ok: bool = false
                    if which == 0 {
                        ok = scheme_key(b + i, g - i, b + g + 1,
                            ve - g - 1)
                    } else if which == 1 {
                        ok = conf_key(b + i, g - i, b + g + 1, ve - g - 1)
                    } else if which == 4 {
                        ok = shape_key(b + i, g - i, b + g + 1,
                            ve - g - 1)
                    } else if which == 3 {
                        var k_off: [u8; 7] = "offset\0"
                        if name_eq(b + i, g - i,
                            (&k_off[0 as usize]) as u64) {
                            let v: u64 = parse_dec(b + g + 1, ve - g - 1)
                            if v != DEC_BAD && v <= 1440 {
                                tz_offset = v
                                ok = true
                            }
                        }
                    } else {
                        let idx: u64 = theme_named(b + i, g - i)
                        let v: u64 = parse_hex(b + g + 1, ve - g - 1)
                        if idx < C_COUNT && v != RGB_BAD {
                            ovr_val[(idx) as usize] = v
                            ovr_on[(idx) as usize] = 1
                            ovr_n = ovr_n + 1
                            ok = true
                        }
                    }
                    if ok {
                        taken = taken + 1
                    } else {
                        kv_bad = kv_bad + 1
                    }
                } else {
                    kv_bad = kv_bad + 1
                }
            }
        }
        i = e + 1
    }
    return taken
}

// ---------------------------------------------------- the local clock
//
// AUTOMATIC MEANS BY THE CLOCK, and the clock in this machine runs on
// UTC: round K9 gave it `sysinfo`, and this kernel cannot set the
// hardware clock at all. What a program in ring 3 can do is shift the
// DISPLAY, and the shift is the one number in /etc/time.conf:
//
//     offset=120
//
// Without the file it is UTC, and nothing here pretends otherwise.
fn timezone_read() {
    var p_new: [u8; 15] = "/etc/time.conf\0"
    var p_old: [u8; 15] = "/etc/zeit.conf\0"
    // The FILE and not sixty-four octets of it. The first attempt read
    // 63 bytes into a small buffer, and /etc/time.conf opens with two
    // lines of comment -- so the whole read was comment, `offset=` was
    // never reached, and the machine ran on UTC while the file said
    // otherwise. `kv_read` reads the file and skips comments, which is
    // what a parser is for.
    if kv_read((&p_new[0 as usize]) as u64, 3) > 0 {
        return
    }
    // The file was called /etc/zeit.conf before the names were
    // translated. Reading both is one line; a machine that loses its
    // timezone on an upgrade is not.
    let _o: u64 = kv_read((&p_old[0 as usize]) as u64, 3)
}

fn local_minutes() -> u64 {
    let h: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_HOUR, 0, 0)
    let m: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_MIN, 0, 0)
    if ulib.bad(h) || ulib.bad(m) {
        return 1441
    }
    return ((h * 60 + m) + tz_offset) % 1440
}

// Dark from dark_start until light_start, wrapping over midnight --
// 19:00 to 07:00 is the normal case and it is exactly the one a naive
// `a <= t && t < b` gets wrong.
fn auto_is_dark() -> bool {
    let t: u64 = local_minutes()
    if t > 1440 {
        return sch_mode == MODE_DARK
    }
    if set_dark_min > set_light_min {
        return t >= set_dark_min || t < set_light_min
    }
    return t >= set_dark_min && t < set_light_min
}

fn effective_dark() -> bool {
    if set_mode == MODE_LIGHT {
        return false
    }
    if set_mode == MODE_DARK {
        return true
    }
    return auto_is_dark()
}

fn theme_auto_dark() -> bool {
    return auto_is_dark()
}

// ---------------------------------------------------------- applying
//
// primitives -> semantics -> components -> publish. The one place the
// three layers are put together, and the only writer of `sem`.
fn theme_apply() {
    let dark: bool = effective_dark()
    cur_dark = 0
    if dark {
        cur_dark = 1
    }
    var acc: u64 = sch_accent
    if set_accent != 0 {
        acc = set_accent
        if set_accent == ACCENT_BLACK {
            acc = 0
        }
    }
    ramp_build(R_ACCENT, acc)
    ramp_build(R_DANGER, sch_danger)
    ramp_build(R_WARNING, sch_warning)
    ramp_build(R_SUCCESS, sch_success)
    bind_neutrals(dark)
    bind_accent(dark)
    publish()
}

// THE ONLY RAW COLOURS IN THE SYSTEM ARE THE NEXT NINETEEN LINES, and
// they are here because a machine whose /etc is empty still has to
// draw a window. They are the Slate ramp of assets/schemes/day.scheme;
// if that file is on the disk it overwrites every one of them.
// tests/theme/rawcolour.py counts colour literals everywhere else and
// the answer has to be nought.
fn primitives_builtin() {
    neutral[(N_0) as usize] = 0x00FFFFFF
    neutral[(N_50) as usize] = 0x00F8FAFC
    neutral[(N_100) as usize] = 0x00F1F5F9
    neutral[(N_200) as usize] = 0x00E2E8F0
    neutral[(N_300) as usize] = 0x00CBD5E1
    neutral[(N_400) as usize] = 0x0094A3B8
    neutral[(N_500) as usize] = 0x0064748B
    neutral[(N_600) as usize] = 0x00475569
    neutral[(N_700) as usize] = 0x00334155
    neutral[(N_800) as usize] = 0x001E293B
    neutral[(N_900) as usize] = 0x000F172A
    neutral[(N_950) as usize] = 0x00020617
    neutral[(N_1000) as usize] = 0x00000000
    sch_accent = 0x002563EB
    sch_danger = 0x00DC2626
    sch_warning = 0x00B45309
    sch_success = 0x0015803D
    sch_mode = MODE_DARK
    sch_high = 0
}

fn path_join(dir: u64, name: u64, out: u64, max: u64) {
    var at: u64 = 0
    var k: u64 = 0
    while *((dir + k) as *mut u8) != 0 as u8 && at + 1 < max {
        __mmio_write8((out + at) as *mut u8, *((dir + k) as *mut u8))
        at = at + 1
        k = k + 1
    }
    k = 0
    while *((name + k) as *mut u8) != 0 as u8 && at + 1 < max {
        __mmio_write8((out + at) as *mut u8, *((name + k) as *mut u8))
        at = at + 1
        k = k + 1
    }
    __mmio_write8((out + at) as *mut u8, 0 as u8)
}

// ============================== ROUND LOOK: THE FORM TOKENS
//
// `classic` IS THE BUILT-IN. Every number below is the number that was
// written into a painting routine before this round, read out of the
// source it came from -- a 1-pixel border (`frame`), a 26-pixel button
// (`wlib.button`), a 20-pixel list row (`wlib.zeilen_hoehe`), 6 pixels
// of padding in an entry (`wlib.paint_entry`), 8 between two controls
// (`wlib.want_gap`). Nothing here is new; it is the old behaviour,
// named.
fn metrics_classic() {
    met[(M_RADIUS_WINDOW) as usize] = 0
    met[(M_RADIUS_PANEL) as usize] = 0
    met[(M_RADIUS_BUTTON) as usize] = 0
    met[(M_RADIUS_INPUT) as usize] = 0
    met[(M_BORDER) as usize] = 1
    met[(M_PAD_X) as usize] = 12
    met[(M_PAD_Y) as usize] = 4
    met[(M_GAP) as usize] = 8
    met[(M_ROW) as usize] = 20
    met[(M_CTRL_H) as usize] = 26
    met[(M_SHADOW) as usize] = 0
    met[(M_SHADOW_R) as usize] = 0
    met[(M_DIVIDER) as usize] = 100
    met[(M_FOCUS) as usize] = 1
    // ROUND SOFTUI: and every one of these nine is the behaviour of
    // the rounds BEFORE this one, written down.  A machine with no
    // /etc/shapes draws exactly what it drew yesterday.
    met[(M_SP_XS) as usize] = 2
    met[(M_SP_S) as usize] = 6
    met[(M_SP_M) as usize] = 10
    met[(M_SP_L) as usize] = 12
    met[(M_GRAD) as usize] = 0
    met[(M_TONE) as usize] = 100
    met[(M_SHADOW2) as usize] = 0
    met[(M_SHADOW_R2) as usize] = 0
    met[(M_CAPTION) as usize] = 0
    // RUNDE OBERFLAECHE: und diese zwei ebenfalls auf das, was war.
    // 15 ist `PX_UI0` -- die eine Schriftgroesse, die dieses System bis
    // hierher kannte -- und 0 ms heisst: keine Bewegung, so wie es sie
    // vorher nirgends gab.  `classic` bleibt damit Wort fuer Wort die
    // Vergangenheit, auch mit zwei Marken mehr.
    met[(M_FONT) as usize] = PX_UI0
    met[(M_MOTION) as usize] = 0
    // RUNDE GLAS: und diese drei ebenfalls auf das, was war. 100
    // Prozent heisst VOLL DECKEND -- also Bildpunkt fuer Bildpunkt das
    // Bild jeder Runde vor dieser --, und 0 heisst kein Milchglas.
    // Nicht 0 Prozent: eine Leiste, die beim ersten Bild unsichtbar
    // ist, weil noch niemand eine Zahl geschickt hat, waere ein
    // Fehlerbild und keine Voreinstellung.
    met[(M_TB_ALPHA) as usize] = 100
    met[(M_WIN_ALPHA) as usize] = 100
    met[(M_TB_BLUR) as usize] = 0
    shp_id = SHAPE_CLASSIC
}

// ================================================== RUNDE GLAS
//
// DIE VIER ZAHLEN AUS /etc/theme.conf, UND GENAU EINE STELLE, DIE SIE
// IN DIE MARKEN SCHREIBT.
//
// `usr_radius` ist -1, solange die Datei keine Zeile `radius=` hatte
// (vorzeichenlos gerechnet: RAD_NONE). Dann gilt die Formdatei wie
// bisher, und `shape=classic|modern` ist weiter das, was es war. Steht
// die Zeile da, sticht sie die Formdatei -- das ist die ganze Bedeutung
// von "shape setzt nur noch den Startwert".
//
// WARUM DIE WERTE ZWEIMAL LIEGEN (hier als `usr_*` und drueben in
// `met`): `metrics_classic()` setzt `met` zurueck, und zwar an zwei
// Stellen, die nichts von dieser Runde wissen -- zu Beginn von
// `reload_inner` und noch einmal, wenn die Formdatei null Schluessel
// hatte. Laegen die Werte nur in `met`, waere eine Vorlage mit
// `shape=` auf eine nicht vorhandene Datei genug, um die eingestellte
// Durchsicht stillschweigend auf 100 zurueckzustellen. `usr_*` ist die
// Quelle, `met` ist die Kopie, und `glas_metrics()` ist der einzige
// Weg von der einen zur anderen.
const RAD_NONE: u64 = 0xFFFFFFFFFFFFFFFF

static mut usr_radius: u64 = RAD_NONE
static mut usr_tba: u64 = 100
static mut usr_wa: u64 = 100
static mut usr_blur: u64 = 0

// DIE UNTERGRENZE DER DECKKRAFT, 20 PROZENT. Eine Leiste, die man gar
// nicht mehr sieht, ist keine Einstellung, sondern ein Fehlerbild --
// und sie waere ausserdem die eine Stellung, in der die Schrift
// darueber gegen ein helles Hintergrundbild nicht mehr 4,5:1 schafft.
// Geklemmt wird HIER, beim Einlesen, damit die Grenze auch fuer eine
// Datei gilt, die von Hand geschrieben wurde.
const ALPHA_MIN: u64 = 20
const BLUR_MAX: u64 = 16

fn clamp_alpha(v: u64) -> u64 {
    if v > 100 {
        return 100
    }
    if v < ALPHA_MIN {
        return ALPHA_MIN
    }
    return v
}

fn glas_metrics() {
    if usr_radius != RAD_NONE {
        let r: u64 = cap(usr_radius, RADIUS_MAX)
        met[(M_RADIUS_WINDOW) as usize] = r
        met[(M_RADIUS_PANEL) as usize] = r
        met[(M_RADIUS_BUTTON) as usize] = r
        met[(M_RADIUS_INPUT) as usize] = r
    }
    met[(M_TB_ALPHA) as usize] = clamp_alpha(usr_tba)
    met[(M_WIN_ALPHA) as usize] = clamp_alpha(usr_wa)
    met[(M_TB_BLUR) as usize] = cap(usr_blur, BLUR_MAX)
}

// DIE OEFFENTLICHEN LESER. Das ist die ganze Schnittstelle, die die
// Widgets, die Leiste und die Einstellungsseite von dieser Runde
// brauchen -- vier Zahlen zu lesen und vier zu setzen.
fn radius() -> u64 {
    return cap(met[(M_RADIUS_WINDOW) as usize], RADIUS_MAX)
}

fn tb_alpha() -> u64 {
    return met[(M_TB_ALPHA) as usize]
}

fn win_alpha() -> u64 {
    return met[(M_WIN_ALPHA) as usize]
}

fn tb_blur() -> u64 {
    return met[(M_TB_BLUR) as usize]
}

// SETZEN HEISST HIER: SOFORT SICHTBAR, ABER NICHT GESCHRIEBEN. Die
// Datei schreibt das Einstellungsfenster, und zwar erst beim Loslassen
// des Reglers -- /etc/theme.conf bei jeder Reglerbewegung neu zu
// schreiben waere ein Schreibvorgang je Bildpunkt Reglerweg.
fn set_radius(r: u64) {
    usr_radius = cap(r, RADIUS_MAX)
    glas_metrics()
    theme_apply()
}

fn set_tb_alpha(a: u64) {
    usr_tba = clamp_alpha(a)
    glas_metrics()
    theme_apply()
}

fn set_win_alpha(a: u64) {
    usr_wa = clamp_alpha(a)
    glas_metrics()
    theme_apply()
}

fn set_tb_blur(b: u64) {
    usr_blur = cap(b, BLUR_MAX)
    glas_metrics()
    theme_apply()
}

// ================================================== RUNDE OBERFLAECHE
//
// DIE SCHRIFTSKALA.  Fuenf Rollen aus EINER Grundgroesse.
//
// Die Abstaende (-3, 0, 0, +3, +9) sind auf die Grundgroesse 15 dieses
// Systems gerechnet und ergeben 12/15/15/18/24 -- dieselbe Folge, die
// design-system/references/primitive-tokens.md als 12/14/16/18/24
// fuehrt, nur auf die Zelle dieser Schrift gelegt.  Bei einer anderen
// Grundgroesse wandern sie mit; das ist der Zweck.
//
// STRONG IST NICHT GROESSER ALS BODY.  Es ist dieselbe Groesse in einer
// anderen ROLLE -- ein Spaltenkopf wird durch Farbe und Gewicht betont
// und nicht durch zwei Bildpunkte mehr.
fn type_base() -> u64 {
    let v: u64 = met[(M_FONT) as usize]
    if v == 0 {
        return PX_UI0 * ui_scale()
    }
    return v * ui_scale()
}

fn type_px(rolle: u64) -> u64 {
    let b: u64 = type_base()
    let k: u64 = ui_scale()
    if rolle == TY_CAPTION {
        // Nie unter zehn Bildpunkten: darunter faellt der Rasterer auf
        // Formen zurueck, die man nicht mehr unterscheidet.
        if b <= 13 * k {
            return b
        }
        return b - 3 * k
    }
    if rolle == TY_TITLE {
        return b + 3 * k
    }
    if rolle == TY_DISPLAY {
        return b + 9 * k
    }
    return b
}

// DIE ZEILENHOEHE, und warum sie AUFGERUNDET wird und nicht gerechnet.
//
// Eine Zeilenhoehe von 1,33 auf 15 Bildpunkten sind 19,95 -- also 20,
// und 20 liegt auf dem Viererraster.  Auf 18 waeren es 23,94, und 23
// liegt daneben.  Ein Raster, das nur meistens stimmt, ist keines: also
// wird auf das naechste Vielfache von vier AUFgerundet.
fn type_lh(rolle: u64) -> u64 {
    let px: u64 = type_px(rolle)
    return snap_up(px * 4 / 3)
}

// ------------------------------------------------- die Hoehenstufen
//
// EINE Schattenstaerke in der Formdatei, fuenf Stufen im Code -- wieder
// die Regel "eine Zahl in der Datei, feste Verhaeltnisse hier".  Eine
// Karte liegt tiefer als ein Menue, ein Menue tiefer als ein Dialog;
// wer die drei Zahlen einzeln pflegt, hat sie in drei Runden
// auseinanderlaufen.
fn elev_strength(stufe: u64) -> u64 {
    let s: u64 = met[(M_SHADOW) as usize]
    if s == 0 || stufe == EL_FLAT {
        return 0
    }
    if stufe == EL_RAISED {
        return s / 2
    }
    if stufe == EL_OVERLAY {
        return s * 3 / 4
    }
    return s
}

fn elev_reach(stufe: u64) -> u64 {
    let r: u64 = metric(M_SHADOW_R)
    if r == 0 || stufe == EL_FLAT {
        return 0
    }
    if stufe == EL_RAISED {
        var h: u64 = r / 2
        if h == 0 {
            h = 1
        }
        return h
    }
    if stufe == EL_OVERLAY {
        var q: u64 = r * 3 / 4
        if q == 0 {
            q = 1
        }
        return q
    }
    return r
}

// WELCHER RADIUS ZU WELCHER HOEHE GEHOERT.  Die Rollen sind schon da
// (Fenster > Tafel > Knopf > Feld); das hier ist nur die Zuordnung, die
// sonst jede Malroutine einzeln treffen muesste.
fn elev_radius(stufe: u64) -> u64 {
    if stufe == EL_WINDOW {
        return metric(M_RADIUS_WINDOW)
    }
    if stufe == EL_MODAL {
        return metric(M_RADIUS_PANEL)
    }
    if stufe == EL_OVERLAY {
        return metric(M_RADIUS_PANEL)
    }
    if stufe == EL_RAISED {
        return metric(M_RADIUS_PANEL)
    }
    return 0
}

// ------------------------------------------------------- das Raster
fn grid() -> u64 {
    return GRID * ui_scale()
}

// Auf das naechste Vielfache des Rasters, kaufmaennisch.
fn snap(v: u64) -> u64 {
    let g: u64 = grid()
    if g == 0 {
        return v
    }
    return (v + g / 2) / g * g
}

// Auf das naechste Vielfache NACH OBEN.  Fuer alles, was hineinpassen
// muss: eine Zeilenhoehe, die abgerundet wird, schneidet Text ab.
fn snap_up(v: u64) -> u64 {
    let g: u64 = grid()
    if g == 0 {
        return v
    }
    return (v + g - 1) / g * g
}

fn hit_min() -> u64 {
    return HIT_MIN * ui_scale()
}

// ------------------------------------------------------- die Bewegung
//
// DREI DAUERN AUS EINER.  Die Zahlen kommen aus
// design-system/references/states-and-variants.md (Farbe 150 ms,
// Verschiebung 200 ms, Deckkraft 150 ms) und aus dem, worauf sich
// Fluent, HIG und Material 3 einig sind: unter 100 ms wirkt es wie ein
// Sprung, ueber 300 ms wie Zaehigkeit.
//
// `motion` gibt MILLISEKUNDEN und keine Bildpunkte -- also NICHT durch
// `metric` und nicht mit `ui_scale` multipliziert.  Eine Bewegung wird
// auf einem grossen Schirm nicht langsamer.
fn motion(stufe: u64) -> u64 {
    let m: u64 = met[(M_MOTION) as usize]
    if m == 0 {
        return 0
    }
    if stufe == MO_FAST {
        return m * 3 / 4
    }
    if stufe == MO_SLOW {
        return m * 5 / 4
    }
    return m
}

// RUNDE SCHIRM: LAENGEN WACHSEN MIT DER OBERFLAECHENSCHRIFT.
//
// Die Zahlen der Formentabelle sind Bildpunkte fuer eine Zelle von
// 10x19 -- eine Listenzeile von 20, ein Knopf von 26. Bei doppelter
// Schrift ist eine Textzeile 38 Bildpunkte hoch, und sie wurde in eine
// Zeile von 20 gemalt: im Bild von 3840x2160 lagen die Eintraege des
// Starters UEBEREINANDER ("Suchen -- Programm..." im "Terminal --").
// Also mal dem Faktor -- aber NUR die Laengen. `M_SHADOW`, `M_TONE`,
// `M_DIVIDER` und `M_GRAD` sind Hundertstel und bleiben, wie sie sind;
// ein verdoppelter Prozentwert waere ein anderer Farbton.
fn metric_is_len(i: u64) -> bool {
    if i == M_SHADOW || i == M_SHADOW2 || i == M_DIVIDER {
        return false
    }
    if i == M_TONE || i == M_GRAD {
        return false
    }
    // RUNDE GLAS: die beiden Deckkraefte sind Hundertstel und der
    // Weichzeichner ist ein Radius im BILDPUNKTRASTER DES SCHIRMS, den
    // der Fensterserver anwendet -- keine der drei Zahlen darf mit der
    // Oberflaechenskalierung wachsen. Eine verdoppelte Deckkraft waere
    // 200 Prozent, und das ist keine Zahl.
    if i == M_TB_ALPHA || i == M_WIN_ALPHA || i == M_TB_BLUR {
        return false
    }
    return true
}

fn metric(i: u64) -> u64 {
    if i >= M_COUNT {
        return 0
    }
    let v: u64 = met[(i) as usize]
    if v != 0 && metric_is_len(i) {
        return v * ui_scale()
    }
    return v
}

fn shape_name() -> u64 {
    return (&shp_name[0 as usize]) as u64
}

fn shape_file() -> u64 {
    return (&shp_file[0 as usize]) as u64
}

fn shape_keys() -> u64 {
    return shp_keys
}

fn shape_id() -> u64 {
    return shp_id
}

fn aa_pixels() -> u64 {
    return aa_px
}

// One line of a shape file. Unknown keys are counted as bad, exactly
// like a scheme file -- a misspelt `radus_button=8` must not be
// swallowed, or the person changes it, sees nothing, and blames the
// drawing.
fn shape_key(kp: u64, kn: u64, vp: u64, vn: u64) -> bool {
    var k_name: [u8; 5] = "name␀"
    var k_rw: [u8; 14] = "radius_window␀"
    var k_rp: [u8; 13] = "radius_panel␀"
    var k_rb: [u8; 14] = "radius_button␀"
    var k_ri: [u8; 13] = "radius_input␀"
    var k_bo: [u8; 7] = "border␀"
    var k_px: [u8; 6] = "pad_x␀"
    var k_py: [u8; 6] = "pad_y␀"
    var k_ga: [u8; 4] = "gap␀"
    var k_ro: [u8; 4] = "row␀"
    var k_ch: [u8; 7] = "ctrl_h␀"
    var k_sh: [u8; 7] = "shadow␀"
    var k_sr: [u8; 9] = "shadow_r␀"
    var k_dv: [u8; 8] = "divider␀"
    var k_fo: [u8; 6] = "focus␀"
    var k_xs: [u8; 11] = "spacing_xs␀"
    var k_ss: [u8; 10] = "spacing_s␀"
    var k_sm: [u8; 10] = "spacing_m␀"
    var k_sl: [u8; 10] = "spacing_l␀"
    var k_gr: [u8; 5] = "grad␀"
    var k_to: [u8; 5] = "tone␀"
    var k_s2: [u8; 11] = "shadow_off␀"
    var k_r2: [u8; 13] = "shadow_off_r␀"
    var k_cp: [u8; 8] = "caption␀"
    var k_ft: [u8; 5] = "font␀"
    var k_mo: [u8; 7] = "motion␀"
    if name_eq(kp, kn, (&k_name[0 as usize]) as u64) {
        copy_bounded((&shp_name[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    let v: u64 = parse_dec(vp, vn)
    if v == DEC_BAD {
        return false
    }
    if name_eq(kp, kn, (&k_rw[0 as usize]) as u64) {
        met[(M_RADIUS_WINDOW) as usize] = cap(v, RADIUS_MAX)
        return true
    }
    if name_eq(kp, kn, (&k_rp[0 as usize]) as u64) {
        met[(M_RADIUS_PANEL) as usize] = cap(v, RADIUS_MAX)
        return true
    }
    if name_eq(kp, kn, (&k_rb[0 as usize]) as u64) {
        met[(M_RADIUS_BUTTON) as usize] = cap(v, RADIUS_MAX)
        return true
    }
    if name_eq(kp, kn, (&k_ri[0 as usize]) as u64) {
        met[(M_RADIUS_INPUT) as usize] = cap(v, RADIUS_MAX)
        return true
    }
    if name_eq(kp, kn, (&k_bo[0 as usize]) as u64) {
        met[(M_BORDER) as usize] = cap(v, 4)
        return true
    }
    if name_eq(kp, kn, (&k_px[0 as usize]) as u64) {
        met[(M_PAD_X) as usize] = cap(v, 32)
        return true
    }
    if name_eq(kp, kn, (&k_py[0 as usize]) as u64) {
        met[(M_PAD_Y) as usize] = cap(v, 32)
        return true
    }
    if name_eq(kp, kn, (&k_ga[0 as usize]) as u64) {
        met[(M_GAP) as usize] = cap(v, 32)
        return true
    }
    if name_eq(kp, kn, (&k_ro[0 as usize]) as u64) {
        met[(M_ROW) as usize] = cap(v, 48)
        return true
    }
    if name_eq(kp, kn, (&k_ch[0 as usize]) as u64) {
        met[(M_CTRL_H) as usize] = cap(v, 48)
        return true
    }
    if name_eq(kp, kn, (&k_sh[0 as usize]) as u64) {
        met[(M_SHADOW) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_sr[0 as usize]) as u64) {
        met[(M_SHADOW_R) as usize] = cap(v, 16)
        return true
    }
    if name_eq(kp, kn, (&k_dv[0 as usize]) as u64) {
        met[(M_DIVIDER) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_fo[0 as usize]) as u64) {
        met[(M_FOCUS) as usize] = cap(v, 4)
        return true
    }
    if name_eq(kp, kn, (&k_xs[0 as usize]) as u64) {
        met[(M_SP_XS) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_ss[0 as usize]) as u64) {
        met[(M_SP_S) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_sm[0 as usize]) as u64) {
        met[(M_SP_M) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_sl[0 as usize]) as u64) {
        met[(M_SP_L) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_gr[0 as usize]) as u64) {
        met[(M_GRAD) as usize] = cap(v, 24)
        return true
    }
    if name_eq(kp, kn, (&k_to[0 as usize]) as u64) {
        met[(M_TONE) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_s2[0 as usize]) as u64) {
        met[(M_SHADOW2) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_r2[0 as usize]) as u64) {
        met[(M_SHADOW_R2) as usize] = cap(v, 16)
        return true
    }
    if name_eq(kp, kn, (&k_cp[0 as usize]) as u64) {
        met[(M_CAPTION) as usize] = cap(v, 1)
        return true
    }
    // RUNDE OBERFLAECHE.  `font` wird nach UNTEN begrenzt und nicht nur
    // nach oben: eine Formdatei mit `font=2` haette eine Oberflaeche
    // hinterlassen, in der nichts mehr zu lesen ist, und der Weg
    // zurueck fuehrt ueber genau diese Oberflaeche.
    if name_eq(kp, kn, (&k_ft[0 as usize]) as u64) {
        var f: u64 = cap(v, 32)
        if f < 10 {
            f = 10
        }
        met[(M_FONT) as usize] = f
        return true
    }
    if name_eq(kp, kn, (&k_mo[0 as usize]) as u64) {
        met[(M_MOTION) as usize] = cap(v, 400)
        return true
    }
    return false
}

// THE SPACE TOKENS, READ THE WAY EVERY OTHER TOKEN IS READ.
//
// `space(0)` and not `12`.  There is exactly one reason this is a
// function and not four constants: a program that asks is a program
// that follows the shape when the shape is switched at run time, and
// four constants are four numbers frozen at compile time.
// ============================================ RUNDE ECHTHARDWARE-4
// DIE ABSTAENDE WACHSEN MIT DER VERVIELFACHUNG. Sie taten es nicht.
//
// GEMESSEN an den Belegen dieser Runde, bevor die Zeile stand:
//     1280x800, uiscale 1   Leiste 40 hoch  (32 Knopf + 2*4 Rand)
//     2560x1440, uiscale 2  Leiste 72 hoch  (64 Knopf + 2*4 Rand)
// Der Knopf hat sich verdoppelt, der RAND nicht -- weil `metric()`
// jede Laenge mit `ui_scale()` malnimmt, diese Funktion aber an
// `metric()` vorbei direkt in die Tafel griff. Ergebnis: auf einem
// 1440p-Schirm ist jeder Abstand der Oberflaeche halb so gross wie
// gewollt, die Leiste 72 statt 80 hoch, und der erste Eintrag klebt
// mit vier statt acht Bildpunkten am Bildschirmrand -- genau Justins
// Punkt 3 ("nicht bei x=12 kleben").
//
// GEGENPROBE: bei `ui_scale() == 1` multipliziert `metric()` mit eins.
// Kein einziges Bild und keine Bildpunktzusage einer frueheren Runde
// aendert sich dadurch; alle sind bei Vervielfachung 1 entstanden.
fn space(i: u64) -> u64 {
    if i > 3 {
        return 0
    }
    return metric(M_SP_XS + i)
}

// ROUND SOFTUI: THE GRADIENT, AND IT IS THE SAME ARITHMETIC IN BOTH
// RINGS.  The compositor shades the title bar (kernel/wm.fi,
// `paint_title`) and the taskbar shades itself; if the two used
// different rules the two bars would not match, and they sit four
// hundred pixels apart on the same screen.  So the rule lives once,
// in words, and twice in code -- and `tools/softui/run.sh` section D
// reads both bars out of the SAME picture and compares the step.
//
// `shade` darkens; `grad_room` says by how much the colour can be
// darkened before its smallest channel hits zero, because a gradient
// that clips one channel is a gradient that changes the hue.
fn shade(c: u64, d: u64) -> u64 {
    var r: u64 = (c >> 16) & 255
    var g: u64 = (c >> 8) & 255
    var b: u64 = c & 255
    if r > d {
        r = r - d
    } else {
        r = 0
    }
    if g > d {
        g = g - d
    } else {
        g = 0
    }
    if b > d {
        b = b - d
    } else {
        b = 0
    }
    return (r << 16) | (g << 8) | b
}

fn grad_room(c: u64, want: u64) -> u64 {
    var m: u64 = (c >> 16) & 255
    let g: u64 = (c >> 8) & 255
    let b: u64 = c & 255
    if g < m {
        m = g
    }
    if b < m {
        m = b
    }
    if want > m {
        return m
    }
    return want
}

fn cap(v: u64, hi: u64) -> u64 {
    if v > hi {
        return hi
    }
    return v
}

// A checksum over the RESOLVED component table. Equality here means
// "the same forty-one values", which is the only question a program
// asking "must I repaint?" actually has.
fn theme_sum() -> u64 {
    var h: u64 = 1469598103934665603
    var i: u64 = 0
    while i < C_COUNT {
        h = (h ^ tok[((live * C_COUNT + i)) as usize]) *% 1099511628211
        i = i + 1
    }
    // RUNDE GLAS: DIE VIER ZAHLEN GEHOEREN IN DIESE SUMME.
    //
    // Ohne sie antwortet `theme_poll` "nichts geaendert", sobald jemand
    // nur den Radius oder nur die Durchsicht verstellt -- die
    // Farbmarken sind dann ja wirklich dieselben vierzig Werte --, und
    // die Aenderung wirkt erst nach einem Neustart. Genau das ist die
    // Zusage, die diese Runde gibt, und sie haengt an diesen vier
    // Zeilen.
    h = (h ^ met[(M_RADIUS_WINDOW) as usize]) *% 1099511628211
    h = (h ^ met[(M_TB_ALPHA) as usize]) *% 1099511628211
    h = (h ^ met[(M_WIN_ALPHA) as usize]) *% 1099511628211
    h = (h ^ met[(M_TB_BLUR) as usize]) *% 1099511628211
    return h
}

// The whole chain from the disk: settings, scheme, legacy override,
// timezone, resolve. Answers the generation.
// `aus_kopie` sagt, ob /etc/theme.conf aus der Kopie genommen werden
// darf, die `conf_changed` gerade gelesen hat. Nur `theme_poll` darf
// ja sagen, und nur, weil es die Datei EBEN gelesen hat. Jeder andere
// bekommt einen frischen Lesevorgang.
//
// Die Unterscheidung ist keine Feinheit. Ohne sie loest ein Programm,
// das /etc/theme.conf SCHREIBT und sofort neu laedt -- und genau das
// tun das Einstellungsfenster und das Testprogramm --, die Datei auf,
// die es gerade ersetzt hat. Der Testlauf hat es gefunden: fuenf von
// zehn Schemalaeufen kamen mit den Farben des anderen Modus zurueck,
// und zwar immer genau EINEN Schritt hinterher.
fn reload_inner(aus_kopie: bool) -> u64 {
    var p_conf: [u8; 16] = "/etc/theme.conf\0"
    var p_dir: [u8; 14] = "/etc/schemas/\0"
    var p_shapes: [u8; 13] = "/etc/shapes/\0"
    var p_theme: [u8; 11] = "/etc/theme\0"
    var path: [u8; 64] = [0 as u8; 64]
    kv_bad = 0
    ovr_n = 0
    var z: u64 = 0
    while z < C_COUNT {
        ovr_on[(z) as usize] = 0
        z = z + 1
    }
    primitives_builtin()
    comp_map_init()
    metrics_classic()
    __mmio_write8(((&shp_file[0 as usize]) as u64) as *mut u8, 0 as u8)
    __mmio_write8(((&shp_name[0 as usize]) as u64) as *mut u8, 0 as u8)
    aa_px = 0
    set_mode = MODE_AUTO
    set_accent = 0
    // RUNDE GLAS: die vier Werte auf "keine Zeile" zurueck, VOR dem
    // Lesen der Datei. Sonst uebersteht eine geloeschte Zeile
    // `taskbar_alpha=` das Neuladen und die Leiste bliebe durchsichtig,
    // obwohl in der Datei nichts mehr davon steht.
    usr_radius = RAD_NONE
    usr_tba = 100
    usr_wa = 100
    usr_blur = 0
    __mmio_write8(((&sch_file[0 as usize]) as u64) as *mut u8, 0 as u8)
    __mmio_write8(((&sch_dark_file[0 as usize]) as u64) as *mut u8, 0 as u8)
    __mmio_write8(((&sch_name[0 as usize]) as u64) as *mut u8, 0 as u8)
    var nc: u64 = 0
    if aus_kopie && conf_len > 0 {
        nc = kv_scan((&conf_copy[0 as usize]) as u64, conf_len, 1)
    } else {
        nc = kv_read((&p_conf[0 as usize]) as u64, 1)
    }
    let _nc: u64 = nc
    // ==================================================== RUNDE FARBE
    // WELCHE RAMPE GILT: die des Tag-Schemas oder die des Nacht-Schemas.
    //
    // Die Entscheidung faellt HIER und nicht in `theme_apply`, weil sie
    // bestimmt, welche DATEI gelesen wird -- `theme_apply` bindet nur
    // noch die Zahlen, die dann in `neutral` stehen.
    //
    // DREI DINGE MUESSEN VORHER FESTSTEHEN, sonst antwortet
    // `effective_dark()` hier anders als gleich in `theme_apply`, und
    // dann liest diese Runde die Rampe des einen Modus und malt den
    // anderen:
    //
    //   1. die Einstellungsdatei ist gelesen  -> `set_mode` steht
    //   2. `set_mode = sch_mode`, falls es KEINE Einstellungsdatei gibt
    //      (die Begruendung dafuer steht unten bei `nc == 0` und ist
    //      aelter als diese Runde)
    //   3. `timezone_read()`, denn `mode=auto` fragt die ORTSZEIT --
    //      ohne den Versatz stuende hier die UTC-Stunde und der
    //      Dunkelmodus begaenne bis zu zwei Stunden zu frueh
    //
    // Punkt 2 und 3 standen vor dieser Runde WEITER UNTEN. Sie sind
    // hier heraufgezogen und nicht verdoppelt worden; darunter steht
    // an ihrer alten Stelle nichts mehr.
    if nc == 0 {
        set_mode = sch_mode
    }
    timezone_read()
    // Ohne `dark_scheme=` ist `sch_dark_file` leer und es bleibt bei
    // `sch_file`: dann verhaelt sich alles wie vor dieser Runde.
    var pick: u64 = (&sch_file[0 as usize]) as u64
    if *(((&sch_dark_file[0 as usize]) as u64) as *mut u8) != 0 as u8
        && effective_dark() {
        pick = (&sch_dark_file[0 as usize]) as u64
    }
    if *((pick) as *mut u8) != 0 as u8 {
        path_join((&p_dir[0 as usize]) as u64, pick,
            (&path[0 as usize]) as u64, 64)
        sch_keys = kv_read((&path[0 as usize]) as u64, 0)
    } else {
        sch_keys = 0
    }
    // ROUND LOOK: THE SHAPE SET, after the colour scheme and by exactly
    // the same route. `classic` is already in `met` (it was put there
    // before the settings file was read), so a machine with no
    // /etc/shapes/ and no `shape=` line keeps the behaviour of every
    // round before this one -- and a `shape=` naming a file that is not
    // there keeps it too, instead of drawing half a set.
    if *(((&shp_file[0 as usize]) as u64) as *mut u8) != 0 as u8 {
        path_join((&p_shapes[0 as usize]) as u64,
            (&shp_file[0 as usize]) as u64,
            (&path[0 as usize]) as u64, 64)
        shp_keys = kv_read((&path[0 as usize]) as u64, 4)
        if shp_keys == 0 {
            metrics_classic()
        } else if met[(M_RADIUS_BUTTON) as usize] != 0
            || met[(M_SHADOW) as usize] != 0 {
            shp_id = SHAPE_MODERN
        }
    } else {
        shp_keys = 0
    }
    // RUNDE GLAS: NACH DER FORMDATEI, NICHT DAVOR.
    //
    // Die Formdatei setzt `radius_window` und die drei anderen Radien;
    // stand in /etc/theme.conf eine Zeile `radius=`, sticht sie diese
    // vier Werte. Die Reihenfolge ist die ganze Regel: davor
    // aufgerufen, wuerde `modern.shape` die eingestellte Zahl wieder
    // ueberschreiben, und der Regler haette bei jeder Vorlage mit
    // Formdatei nichts getan. Dieselbe Regel steht in `theme_probe`.
    glas_metrics()
    // OHNE EINSTELLUNGSDATEI GILT DER MODUS DES SCHEMAS, nicht `auto`.
    //
    // Das ist nicht Geschmack, das hat der Testlauf entschieden. Ein
    // Abbild aus Runde K15 hat kein /etc/theme.conf, wohl aber ein
    // /etc/theme mit zwoelf DUNKLEN Flaechenfarben und ohne eine
    // Schriftfarbe. Mit `auto` haengt der Modus dann an der Uhr des
    // Rechners: bei Tag wurde die Schrift hell-auf-hell aufgeloest und
    // ueber die dunklen Flaechen der alten Datei gelegt. Im Bild sah
    // man ein Menue, dessen Text zu 60 Prozent verschwunden war, und
    // tools/k15/run.sh hat genau das gemeldet.
    //
    // `auto` ist eine ausdrueckliche Wahl und darf keine Voreinstellung
    // sein. Ohne Datei gilt, wofuer das Schema gezeichnet wurde.
    //
    // RUNDE FARBE: diese zwei Zeilen und `timezone_read()` stehen jetzt
    // WEITER OBEN, vor der Wahl der Rampe -- siehe dort. Hier bleibt
    // die Begruendung stehen, weil sie zu der Regel gehoert und nicht
    // zu der Stelle.
    //
    // Die alte Ueberschreibungsdatei ZULETZT, damit eine Maschine aus
    // Runde K15 aussieht wie vorher. Sie ist das einzige im System, was
    // noch eine Farbe benennen darf -- und sie ist eine DATEI, kein Code.
    let _no: u64 = kv_read((&p_theme[0 as usize]) as u64, 2)
    theme_apply()
    booted = 1
    let _c: bool = conf_changed()
    return generation
}

fn theme_reload() -> u64 {
    return reload_inner(false)
}

// ROUND THEMESTORE.  `scheme` and `shape` are file names under
// /etc/schemas and /etc/shapes, `mode` is MODE_LIGHT/DARK/AUTO,
// `accent` is an RGB value or 0 for "the scheme's own".  Returns the
// number of scheme keys understood -- 0 means the scheme file was not
// there, and the caller has to say so rather than show a preview of
// the built-in ramp under somebody else's name.
fn theme_probe(scheme: u64, mode: u64, shape: u64, accent: u64) -> u64 {
    var p_dir: [u8; 14] = "/etc/schemas/\0"
    var p_shapes: [u8; 13] = "/etc/shapes/\0"
    var path: [u8; 64] = [0 as u8; 64]
    pairs_init()
    comp_map_init()
    kv_bad = 0
    primitives_builtin()
    metrics_classic()
    var n: u64 = 0
    while *((scheme + n) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    copy_bounded((&sch_file[0 as usize]) as u64, scheme, n, 32)
    path_join((&p_dir[0 as usize]) as u64, (&sch_file[0 as usize]) as u64,
        (&path[0 as usize]) as u64, 64)
    let keys: u64 = kv_read((&path[0 as usize]) as u64, 0)
    // The shape set, by the same route as in `reload_inner`: `classic`
    // is already in `met`, so a shape file that is not there leaves the
    // old behaviour standing instead of half a set.
    var m: u64 = 0
    while *((shape + m) as *mut u8) != 0 as u8 {
        m = m + 1
    }
    if m > 0 {
        copy_bounded((&shp_file[0 as usize]) as u64, shape, m, 32)
        path_join((&p_shapes[0 as usize]) as u64,
            (&shp_file[0 as usize]) as u64,
            (&path[0 as usize]) as u64, 64)
        let sk: u64 = kv_read((&path[0 as usize]) as u64, 4)
        if sk == 0 {
            metrics_classic()
        } else if met[(M_RADIUS_BUTTON) as usize] != 0
            || met[(M_SHADOW) as usize] != 0 {
            shp_id = SHAPE_MODERN
        }
    }
    // RUNDE GLAS: dieselbe Regel wie in `reload_inner`, an derselben
    // Stelle -- nach der Formdatei. Eine Vorschau, die den
    // eingestellten Radius nicht zeigt, zeigt nicht, was man bekommt.
    glas_metrics()
    set_mode = mode
    set_accent = accent
    if accent != 0 && (accent & RGB24) == 0 {
        set_accent = ACCENT_BLACK
    }
    // A preset with mode=auto is resolved the way the clock would
    // resolve it right now; that is what the person would get.
    theme_apply()
    var i: u64 = 0
    while i < C_COUNT {
        prb_comp[(i) as usize] = sem[(comp_role[(i) as usize]) as usize]
        i = i + 1
    }
    var j: u64 = 0
    while j < M_COUNT {
        prb_met[(j) as usize] = met[(j) as usize]
        j = j + 1
    }
    prb_high = sch_high
    prb_ok = 0
    if acc_ok != 0 {
        prb_ok = 1
    }
    prb_moved = acc_moved
    prb_txt = contrast(sem[(S_TEXT_PRIMARY) as usize],
        sem[(S_SURFACE) as usize])
    var k: u64 = 0
    var least: u64 = 0xFFFFFFFFFFFFFFFF
    var wat: u64 = 0
    while k < PAIR_COUNT {
        let r: u64 = contrast(sem[(pair_fg[(k) as usize]) as usize],
            sem[(pair_bg[(k) as usize]) as usize])
        prb_pair[(k) as usize] = r
        if r < least {
            least = r
            wat = k
        }
        k = k + 1
    }
    prb_min = least
    prb_worst = wat
    // AND BACK, OFF THE DISK. Not from a saved copy of the variables:
    // the file is the truth about what this machine is set to, and a
    // probe that restored a copy would be one step behind itself the
    // moment anything else wrote the file.
    let _g: u64 = reload_inner(false)
    return keys
}

fn theme_probe_comp(i: u64) -> u64 {
    if i >= C_COUNT {
        return 0
    }
    return prb_comp[(i) as usize]
}

fn theme_probe_metric(i: u64) -> u64 {
    if i >= M_COUNT {
        return 0
    }
    return prb_met[(i) as usize]
}

// text-primary on surface, times 100. The number Justin asked for.
fn theme_probe_txt() -> u64 {
    return prb_txt
}

// The SMALLEST of the seventeen. A preset is only as readable as its
// worst pairing, and quoting the flattering one would be the sort of
// number this repository does not print.
fn theme_probe_min() -> u64 {
    return prb_min
}

fn theme_probe_worst() -> u64 {
    return prb_worst
}

fn theme_probe_ok() -> bool {
    return prb_ok != 0
}

fn theme_probe_moved() -> u64 {
    return prb_moved
}

// A high-contrast scheme is judged against 7:1 and not 4.5:1, and the
// caller has to know which bar applies.
fn theme_probe_high() -> bool {
    return prb_high != 0
}

fn theme_probe_pairs() -> u64 {
    return PAIR_COUNT
}

fn theme_probe_pair(i: u64) -> u64 {
    if i >= PAIR_COUNT {
        return 0
    }
    return prb_pair[(i) as usize]
}

fn theme_probe_pair_fg(i: u64) -> u64 {
    pairs_init()
    if i >= PAIR_COUNT {
        return 0
    }
    return pair_fg[(i) as usize]
}

fn theme_probe_pair_bg(i: u64) -> u64 {
    pairs_init()
    if i >= PAIR_COUNT {
        return 0
    }
    return pair_bg[(i) as usize]
}

// HAT SICH /etc/theme.conf GEAENDERT? Ein Vergleich der Oktette und
// nicht ein Zeitstempel -- dieses Dateisystem fuehrt keinen, und die
// Groesse allein sagt nichts (`mode=dark` und `mode=auto` sind gleich
// lang).
fn conf_changed() -> bool {
    var p_conf: [u8; 16] = "/etc/theme.conf\0"
    var buf: [u8; 512] = [0 as u8; 512]
    var n: u64 = 0
    let fd: u64 = io.open((&p_conf[0 as usize]) as u64, 0)
    if !ulib.bad(fd) {
        let r: u64 = io.read(fd, (&buf[0 as usize]) as u64, 511)
        io.close(fd)
        if !ulib.bad(r) {
            n = r
        }
    }
    var same: bool = n == conf_len
    if same {
        var k: u64 = 0
        while k < n {
            if buf[(k) as usize] != conf_copy[(k) as usize] {
                same = false
                k = n
            } else {
                k = k + 1
            }
        }
    }
    if same {
        return false
    }
    var k2: u64 = 0
    while k2 < n {
        conf_copy[(k2) as usize] = buf[(k2) as usize]
        k2 = k2 + 1
    }
    conf_len = n
    return true
}

// WAS EIN PROGRAMM IN SEINER EREIGNISSCHLEIFE AUFRUFT.
//
// Der teure Weg ist der ganze Neuaufbau: drei Dateien lesen, vier
// Rampen bauen, die Kontrastsuche laufen lassen. Gemessen kostet das
// ein Vielfaches dessen, was das Aufloesen allein kostet, und fast
// alles davon ist die Platte -- die Zahlen stehen in
// docs/ROUNDTHEME.md. Ein Schreibtisch, der das zehnmal in der
// Sekunde tut, tut nichts anderes mehr.
//
// Also zwei billige Fragen zuerst:
//
//   1. Haben sich die Oktette von /etc/theme.conf geaendert? Das ist
//      EINE kleine Datei statt dreien und der einzige Weg, auf dem
//      eine Einstellung hereinkommt.
//   2. Steht der Modus auf `auto` und hat die UHR die Bindung
//      umgelegt? Das kostet zwei Systemaufrufe und keine Platte.
//
// WAS DAMIT NICHT ERKANNT WIRD, und es steht hier und nicht in einer
// Fussnote: eine Aenderung IN einer Schemadatei unter /etc/schemas/,
// waehrend dieses Schema ausgewaehlt ist. Wer eine Schemadatei
// bearbeitet, muss /etc/theme.conf anfassen -- oder das Programm neu
// starten. Ein Schema ist Inhalt und keine Einstellung.
fn theme_poll() -> bool {
    if conf_changed() {
        let before: u64 = theme_sum()
        let _g: u64 = reload_inner(true)
        return theme_sum() != before
    }
    if set_mode == MODE_AUTO {
        var want: u64 = 0
        if auto_is_dark() {
            want = 1
        }
        if want != cur_dark {
            let before: u64 = theme_sum()
            theme_apply()
            return theme_sum() != before
        }
    }
    return false
}

fn theme_set_mode(m: u64) {
    if m <= MODE_AUTO {
        set_mode = m
        theme_apply()
    }
}

fn theme_set_accent(rgb: u64) {
    set_accent = rgb & RGB24
    if set_accent == 0 {
        set_accent = ACCENT_BLACK
    }
    theme_apply()
}

fn theme_clear_accent() {
    set_accent = 0
    theme_apply()
}

fn theme_bad_keys() -> u64 {
    return kv_bad
}

fn theme_scheme_keys() -> u64 {
    return sch_keys
}

// WIE VIELE FARBEN DIE UEBERSCHREIBUNGSDATEI WIRKLICH GESETZT HAT.
//
// Das war die Bedeutung in Runde K15 und sie bleibt es. Diese Runde
// hatte sie kurz auf "wie viele Marken es gibt" umgedeutet, und
// tools/k15/run.sh hat das in einer Zeile gemeldet: erwartet 12,
// bekommen 41. Eine Funktion, deren Name gleich bleibt und deren
// Bedeutung sich aendert, ist schlimmer als eine umbenannte.
fn theme_count() -> u64 {
    return ovr_n
}

// Wie viele Komponentenmarken es gibt. Das ist die neue Frage und sie
// bekommt einen neuen Namen.
fn theme_token_count() -> u64 {
    return C_COUNT
}

fn theme_semantic_count() -> u64 {
    return S_COUNT
}

fn theme_override_count() -> u64 {
    return ovr_n
}

// ------------------------------------------ the round K15 entry points
//
// `theme_load` read eighteen colours out of /etc/theme and that was
// the whole theme. It still works, and it still means the same thing:
// the file OVERRIDES resolved tokens by name. What changed is that it
// is now the last step of a resolve and not the resolve itself, so a
// file that sets `bg` no longer decides what `text-primary` should be.
fn theme_load(path: u64) -> u64 {
    if booted == 0 {
        let _g: u64 = theme_reload()
    }
    ovr_n = 0
    var z: u64 = 0
    while z < C_COUNT {
        ovr_on[(z) as usize] = 0
        z = z + 1
    }
    let n: u64 = kv_read(path, 2)
    theme_apply()
    return n
}

// One token by hand, without a file -- the settings window shows a
// preview while a scheme is being picked and only writes on Apply.
fn theme_set(i: u64, v: u64) {
    if i < C_COUNT {
        ovr_val[(i) as usize] = v
        ovr_on[(i) as usize] = 1
        theme_apply()
    }
}

// ====================================================== RUNDE DESKTOP
//
// DREI AUFRUFE, EINE ZEILE JEDER. Sie stehen hier und nicht in
// `wlib.fi`, weil sie kein Widget kennen: eine Ebene, ein verborgenes
// Fenster und eine Fenstertafel sind Begriffe des SERVERS.

// Den eigenen Zustand setzen: Ebene, verborgen, Schmuck.
fn win_state(h: u64, was: u64, wert: u64) -> u64 {
    return sys3w(WM_STATE, h, was, wert)
}

// EINEN Satz aus der Fenstertafel holen. 1 = der Platz ist belegt,
// 0 = er ist frei, negativ = dieser Prozess ist keine Taskleiste.
fn win_list(platz: u64, aus: u64) -> u64 {
    return sys3w(WM_LIST, platz, aus, WL_BYTES)
}

// ROUND PAINT: SAY WHICH BUNDLE THIS WINDOW BELONGS TO.
//
// One call, once, at start-up.  What it buys is the taskbar button's
// icon: the symbols have existed since round K15 in
// `/apps/<name>.osp/symbol`, and what was missing was the sentence
// "this window is that program".  A title could not say it -- it is
// translated, it changes while the program runs ("Terminal -- sh"), and
// two programs may share one.
//
// Whoever does not call this gets an empty name and a button with text
// only.  That is the same fallback the network and the battery use, and
// it is the reason this can be added without touching a single program
// that does not want it.
fn win_app(h: u64, name: u64) -> u64 {
    return sys3w(WM_APP, h, name, ulib.length(name) + 1)
}

// Ein FREMDES Fenster hervorholen oder wegtun. Erstes Argument ist
// seine Nummer aus WL_ID und kein Handle -- fuer fremde Fenster gibt
// es keines.
fn win_act(id: u64, was: u64) -> u64 {
    return sys3w(WM_ACT, id, was, 0)
}

// ---------------------------------------------------- RUNDE THEME
//
// DIE FENSTERDEKORATION AN DEN SERVER GEBEN.
//
// Rahmen und Titelleiste malt der Fensterserver -- er muss, er setzt
// das Bild zusammen --, und damit war die Titelleiste bis zu dieser
// Runde die einzige Flaeche der Oberflaeche, die kein Schema erreichte.
// Hier stehen die acht Farben, die er dafuer bekommt, und sie sind
// AUSSCHLIESSLICH Komponentenmarken: der Kernel bekommt kein Thema, er
// bekommt acht aufgeloeste Zahlen.
//
// Wer darf das? Wer eine Taskleiste IST (ein Fenster auf Ebene L_TOP).
// Duerfte es jede Anwendung, koennte jede Anwendung jede fremde
// Titelleiste faerben. Fuer alle anderen kommt -E_RIGHTS zurueck und
// diese Funktion antwortet 0 -- das ist kein Fehler, das ist die
// Rechtelage.
const DECO_SLOTS: u64 = 11

fn deco_one(slot: u64, colour: u64) -> u64 {
    if ulib.bad(sys3w(WM_DECO, slot, colour, 0)) {
        return 0
    }
    return 1
}

// =============== ROUND PAINT: THE FORM OF THE WINDOW, TO THE SERVER
//
// Round LOOK built the form tokens and wrote down, honestly, that the
// window frame did not get them: "`radius_window` and the window shadow
// are read out of the shape file, carried through the resolver and NOT
// DRAWN.  Those pixels belong to the kernel's compositor, not to the
// widget library, and reaching them means widening a protocol."
//
// This is the other end of that widened protocol.  It carries FOUR
// RESOLVED NUMBERS and no notion of a shape: the server never learns
// that there is a file called `modern.shape`, it learns that the corner
// is eight pixels.  Which is the same division of labour as `deco_push`
// -- the policy stays in ring 3, the server gets the result.
//
// `classic` sends radius 0, shadow 0, reach 0.  The server's rounding
// routine is call-for-call the old square fill at radius 0 and its
// shadow routine returns on the first line at strength 0, so classic
// costs exactly nothing and draws exactly what it drew before.
fn form_one(slot: u64, wert: u64) -> u64 {
    if ulib.bad(sys3w(WM_FORM, slot, wert, 0)) {
        return 0
    }
    return 1
}

fn form_push() -> u64 {
    var n: u64 = 0
    n = n + form_one(WF_RADIUS, met[(M_RADIUS_WINDOW) as usize])
    // RUNDE ECHTHARDWARE-6: der Schalter sticht die Formdatei. Steht
    // er auf aus, geht eine Null an den Server, und `paint_shadow`
    // kehrt auf der ersten Zeile um (wm.fi, `FM_SHADOW == 0`).
    n = n + form_one(WF_SHADOW, shadow_value(met[(M_SHADOW) as usize]))
    n = n + form_one(WF_SHADOW_R, met[(M_SHADOW_R) as usize])
    // THE SHADOW HAS A ROLE AND NOT A COLOUR.  `shadow` is one of the
    // component tokens (C_SHADOW) and it is a different colour in the
    // light and the dark scheme -- a black shadow under a dark window
    // is invisible, and that is exactly the case a hard-coded 0x000000
    // gets wrong.
    n = n + form_one(WF_SHADOW_C, theme_live(C_SHADOW))
    // ROUND SOFTUI: the flat shadow of an unfocused window, the
    // gradient of the title bar, and whether the title bar carries
    // three Windows buttons.
    n = n + form_one(WF_SHADOW2, shadow_value(met[(M_SHADOW2) as usize]))
    n = n + form_one(WF_SHADOW_R2, met[(M_SHADOW_R2) as usize])
    n = n + form_one(WF_GRAD, met[(M_GRAD) as usize])
    n = n + form_one(WF_CAPTION, met[(M_CAPTION) as usize])
    // RUNDE GLAS: die vier Zahlen des Zusammenbaus.  Sie gehen
    // denselben Weg wie der Radius und der Schatten -- eine
    // Systemnummer, dreizehn Plaetze --, weil die Taskleiste in Ring 3
    // laeuft und nicht wissen kann, was unter ihr liegt.  Mischen kann
    // nur, wer das Bild zusammensetzt.
    n = n + form_one(WF_TB_ALPHA, met[(M_TB_ALPHA) as usize])
    n = n + form_one(WF_WIN_ALPHA, met[(M_WIN_ALPHA) as usize])
    n = n + form_one(WF_BLUR, met[(M_TB_BLUR) as usize])
    // DIE SCHLUESSELFARBE IST DIE FLAECHENFARBE DER LEISTE, aufgeloest
    // -- `C_PANEL_BG` und nicht eine Zahl.  Der Server vergleicht jeden
    // Bildpunkt mit ihr und laesst nur die FLAECHE durchsichtig werden;
    // Schrift und Sinnbilder bleiben deckend.  Schickte man hier eine
    // falsche Farbe, wuerde die Schrift mitgemischt und der Kontrast
    // ueber einem hellen Hintergrundbild faellt unter 4,5:1.
    n = n + form_one(WF_GLASS_KEY, theme_live(C_PANEL_BG))
    return n
}

// ==================================================== ROUND SOFTUI
//
// THE SAME EIGHT COLOURS, AND ONE QUESTION IN FRONT OF THEM: HOW LOUD?
//
// Justin, looking at the picture round LOOK produced: "der heutige Stil
// schreit mit sattem Blau in jeder Titelleiste".  He is right, and the
// blue is not a bad choice of blue -- it is the accent, and the accent
// is on the largest single surface of every window on the screen.  An
// accent that is everywhere is not an accent.
//
// So `tone` decides which ROLE the chrome reads, and nothing else
// changes: the colours are the same colours, the scheme is the same
// scheme, and switching `shape` at run time switches this with it.
//
//   tone >= 50   the focused title bar is the accent, its text is the
//                colour that is legible on the accent, the focused
//                frame is the accent.  Every round since THEME.
//   tone <  50   the focused title bar is a RAISED SURFACE and its text
//                the ordinary window text; the unfocused one is the
//                plain surface with muted text; both frames are the
//                quiet border.  What tells the two apart is the SHADOW
//                and the weight of the text -- which is what Windows 11
//                does, and it is why this round had to build a second
//                shadow first.
//
// AND THE CONTRAST GOES UP, NOT DOWN.  White on #2563eb is 4.6 : 1.
// Near-black text on a white surface is 16.1 : 1.  The measurement is
// in docs/ROUNDSOFTUI.md, section 6.
fn deco_push() -> u64 {
    var n: u64 = 0
    if met[(M_TONE) as usize] < 50 {
        // THE FOCUSED BAR IS THE RAISED SURFACE AND THE OTHER ONE IS
        // THE PLAIN SURFACE.  Not two arbitrary greys: `raised` is
        // DEFINED as the step above `surface` in both the light and the
        // dark binding, so the focused window is nearer the light in
        // either mode.  The distance is seven levels in day/light --
        // enough to see side by side, not enough to shout -- and the
        // rest of the focus cue is the text weight and the shadow.
        n = n + deco_one(0, theme_live(C_BORDER))
        n = n + deco_one(1, theme_live(C_WINDOW_BG))
        n = n + deco_one(2, theme_live(C_TEXT_MUTED))
        n = n + deco_one(3, theme_live(C_BORDER))
        n = n + deco_one(4, theme_live(C_PANEL_BG))
        n = n + deco_one(5, theme_live(C_WINDOW_TEXT))
        n = n + deco_one(6, theme_live(C_DANGER))
        n = n + deco_one(7, theme_on(theme_live(C_DANGER)))
        n = n + deco_one(8, theme_live(C_DESKTOP_BOTTOM))
        n = n + deco_one(9, theme_live(C_WINDOW_TEXT))
        n = n + deco_one(10, theme_live(C_INPUT_BG))
        return n
    }
    n = n + deco_one(0, theme_live(C_WINDOW_FRAME))
    n = n + deco_one(1, theme_live(C_TITLEBAR_OFF_BG))
    n = n + deco_one(2, theme_live(C_TITLEBAR_OFF_TEXT))
    n = n + deco_one(3, theme_live(C_ACCENT))
    n = n + deco_one(4, theme_live(C_TITLEBAR_BG))
    n = n + deco_one(5, theme_live(C_TITLEBAR_TEXT))
    n = n + deco_one(6, theme_live(C_DANGER))
    // Das Kreuz auf dem Schliessfeld bekommt die Farbe, die auf ROT
    // lesbar ist, und nicht die, die frueher dort stand. Dieselbe
    // Rechnung wie fuer die Schrift auf der Akzentfarbe.
    n = n + deco_one(7, theme_on(theme_live(C_DANGER)))
    // Der Grund unter allen Fenstern und die beiden Farben eines
    // Terminalfensters. Der Grund ist normalerweise vom Schreibtisch
    // verdeckt -- normalerweise: laeuft keiner, sieht man ihn, und
    // dann soll er nicht aus einem anderen Thema stammen.
    n = n + deco_one(8, theme_live(C_DESKTOP_BOTTOM))
    n = n + deco_one(9, theme_live(C_WINDOW_TEXT))
    n = n + deco_one(10, theme_live(C_INPUT_BG))
    return n
}

// ================== ADDENDUM TASKBAR: THE WORK AREA, SEEN FROM RING 3
//
// Six one-line calls. They exist so that no application has to know
// that a taskbar is 28 pixels high or which edge it is on -- it asks
// for the free rectangle and gets it. That is the whole point of a
// strut: the reservation is declared once and read everywhere.

// Reserve `size` pixels of screen edge `edge` for this window. Only a
// window on layer 0 or 2 may; everyone else gets a negative result.
// `size == 0` gives the edge back.
fn win_strut(h: u64, edge: u64, size: u64) -> u64 {
    return sys3w(WM_STRUT, h, edge, size)
}

// ================================================ RUNDE MERGE-11: R5
// EIN FENSTER VERSCHIEBEN. Es gab den Systemruf (sysgui.fi:917), aber
// keine Fassung dafuer -- deshalb konnte kein Programm sein Fenster
// nachtraeglich an die Arbeitsflaeche ruecken.
//
// Genau das braucht das Startmenue: seine Lage haengt von der
// Arbeitsflaeche ab, und die ist erst zu HABEN, wenn das Fenster
// existiert (`sysgui.fi:790` weist ein Feld >= MAX_WIN ab, ein
// Handle 0 also auch). Also: anlegen, fragen, ruecken.
fn win_move(h: u64, x: u64, y: u64) -> u64 {
    return sys3w(WM_MOVE, h, (x << 16) | y, 0)
}

// Change the size of this window. It cannot grow past the buffer it was
// created with; the server says so instead of pretending.
fn win_size(h: u64, w: u64, hh: u64) -> u64 {
    return sys3w(WM_SIZE, h, (w << 16) | hh, 0)
}

// Fill the work area -- and keep filling it when it changes.
fn win_max(h: u64, on: bool) -> u64 {
    var v: u64 = 0
    if on {
        v = 1
    }
    return sys3w(WM_STATE, h, WS_MAXIMIZED, v)
}

// RUNDE GLAS: WO DAS FENSTER WIRKLICH STEHT -- den Server gefragt.
//
// Ein Programm kennt die Stelle, an der es sein Fenster ANGELEGT hat.
// Der Fensterserver setzt es aber auch von sich aus um: an den
// Arbeitsbereich, wenn die Taskleiste am oberen Rand sitzt, und
// dorthin, wohin eine Hand es zieht. Danach stimmt die gemerkte Zahl
// nicht mehr, und jede absolute Angabe, die aus ihr gerechnet wird --
// wo ein Menue aufgeht, wo ein Laeufer klicken soll -- ist um die
// Verschiebung daneben. GEMESSEN: mit `edge=top` lag alles, was
// /bin/settings meldete, 25 Bildpunkte ueber dem, was gemalt wurde.
//
// `WI_X` und `WI_Y` sind die Antwort des Servers auf dieselbe Frage.
fn win_info(h: u64, feld: u64) -> u64 {
    return sys3w(WM_INFO, h, feld, 0)
}

fn work_x(h: u64) -> u64 {
    return sys3w(WM_INFO, h, WI_WORKX, 0)
}

fn work_y(h: u64) -> u64 {
    return sys3w(WM_INFO, h, WI_WORKY, 0)
}

fn work_w(h: u64) -> u64 {
    return sys3w(WM_INFO, h, WI_WORKW, 0)
}

fn work_h(h: u64) -> u64 {
    return sys3w(WM_INFO, h, WI_WORKH, 0)
}

// THE NAME OF AN EDGE, and its opposite. /etc/taskbar.conf holds words
// and not numbers, because a configuration file that says `edge=2` is a
// file nobody can read without the source. The two directions of the
// translation stand next to each other here, in ONE place -- the
// taskbar reads and the settings application writes, and they must not
// disagree.
static mut e_names: [u8; 23] = "bottom\0top\0left\0right\0\0"

fn edge_name(e: u64) -> u64 {
    let b: u64 = (&e_names[0 as usize]) as u64
    var i: u64 = 0
    var k: u64 = 0
    while k < e && i < 24 {
        if __mmio_read8((b + i) as *mut u8) == 0 as u8 {
            k = k + 1
        }
        i = i + 1
    }
    return b + i
}

fn edge_by_name(p: u64) -> u64 {
    var e: u64 = 0
    while e < 4 {
        let q: u64 = edge_name(e)
        var i: u64 = 0
        var gleich: bool = true
        while __mmio_read8((q + i) as *mut u8) != 0 as u8 {
            if __mmio_read8((p + i) as *mut u8)
                != __mmio_read8((q + i) as *mut u8) {
                gleich = false
            }
            i = i + 1
        }
        if gleich && __mmio_read8((p + i) as *mut u8) == 0 as u8 {
            return e
        }
        e = e + 1
    }
    return 4 // no such edge -- the caller keeps what it had
}


// ---------------------------------------------------------- ROUND ICONS
//
// AN ICON IS A GLYPH.  Everything below goes through the same path as a
// letter -- `gfind` into the Ring 3 glyph cache, WIG_GLYPH into the
// kernel rasteriser, `draw_glyph` onto the surface -- and that is the
// whole point of the round.  What it buys, measured in docs/ICONS.md:
//
//   * ONE COLOUR, PASSED IN.  The glyph is a coverage field, so the
//     caller mixes it with whatever colour it likes.  Light theme and
//     dark theme need no second set of pictures; they pass a different
//     colour.  A bitmap icon cannot do that -- its colours are baked.
//   * ONE OUTLINE, ANY SIZE.  16, 20 and 24 pixels come out of the same
//     outline, rasterised once each and then cached.  A bitmap needs
//     one file per size.
//   * THE CACHE IS SHARED WITH TEXT.  An interface that draws forty
//     icons and eight hundred characters keeps them in the same 512
//     slots and pays one system call per (font, size, glyph).
//
// WHAT THE CALLER MUST NOT DO: write a code point here.  Every one of
// these takes `id`, and every `id` comes from `icons.fi` by name.
// `tools/icons/rawcp.py` counts the ones that do not and the count has
// to stay 0.

// Is there an icon font at all?  A system whose disk has no
// /lib/icons.ttf is a system without icons, not a broken one -- the
// caller draws its text and leaves the box empty.
fn icon_have() -> bool {
    return gfind(F_ICON, icon_small(), icons.NETWORK_WIRED)
        != 0xFFFFFFFFFFFFFFFF
}

// The box an icon occupies at size `px_`: square, `px_` on a side.
//
// This holds because the icon font's ascent is its whole em (the
// builder prints it: upm 1000, ascent 1000, descent 0) and every glyph
// is one em wide.  So the em box sits entirely ABOVE the baseline, and
// an icon placed with its baseline at `y + px_` fills exactly
// `y .. y + px_`.  It is a property of the font, so it is asserted in
// `kernel/user/icont.fi` rather than assumed here.
fn icon_box(px_: u64) -> u64 {
    return px_
}

// The ink of an icon -- what it actually covers, which is smaller than
// the box.  Wanted by anyone centring an icon against text.
fn icon_ink_w(id: u64, px_: u64) -> u64 {
    let at: u64 = gfind(F_ICON, px_, id)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return gc[(at + GC_W) as usize]
}

fn icon_ink_h(id: u64, px_: u64) -> u64 {
    let at: u64 = gfind(F_ICON, px_, id)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return gc[(at + GC_H) as usize]
}

// ONE ICON, top left corner at (x, y), `px_` on a side, in `color`.
//
// `color` is a value the caller got from the theme (`theme(T_...)`),
// never a literal -- that is round THEME's rule and this round does not
// break it.  What this round adds is that the SAME call works in light
// and in dark: the glyph carries no colour of its own.
//
// Returns false when there is no such glyph, so that a caller can fall
// back to a label instead of silently drawing nothing.
fn icon_at(id: u64, x: u64, y: u64, px_: u64, color: u64) -> bool {
    let at: u64 = gfind(F_ICON, px_, id)
    if at == 0xFFFFFFFFFFFFFFFF {
        return false
    }
    if gc[(at + GC_W) as usize] == 0 || gc[(at + GC_H) as usize] == 0 {
        return false
    }
    draw_glyph(at, x as i64, (y + px_) as i64, color)
    return true
}

// ============================================== RUNDE LEISTE-RECHTS
// EIN SYMBOL, DAS WIRKLICH IN DER MITTE SITZT.
//
// `icon_at` haengt den Glyphen an eine GRUNDLINIE: `draw_glyph`
// bekommt `y + px_` und zieht davon `GC_T` ab. Fuer Schrift ist das
// richtig -- Buchstaben einer Zeile muessen auf derselben Linie stehen,
// sonst tanzt das Wort. Fuer ein SYMBOL im Statusfeld ist es falsch:
// dort steht jedes Zeichen fuer sich, und was der Mensch sieht, ist
// nicht die Grundlinie, sondern der Klotz Tinte.
//
// GEMESSEN (3440x1440, uiscale=2, Feld 64 hoch, gl_w()=42): WLAN und
// Ton haben BEIDE die Oberkante 1384, weil beide dieselbe `GC_T=37`
// tragen. Die Tinte des WLAN ist aber nur 26 Punkte hoch, die des Tons
// 32 -- also sass WLAN bei oben=24/unten=30 und der Ton bei 24/24.
// Sechs Punkte Unterschied zwischen zwei Symbolen, die nebeneinander
// stehen; genau das sieht man als "das eine haengt zu hoch".
//
// DIESE ROUTINE ZENTRIERT NACH DER GEMALTEN HOEHE (`GC_H`) und nicht
// nach der geplanten (`px_`). Sie bekommt den KASTEN (y, h) und rechnet
// die Grundlinie so, dass oben und unten gleich viel Luft bleibt:
//
//     oberkante = y + (h - GC_H) / 2
//     grundlinie = oberkante + GC_T
//
// Das ist dieselbe Lehre wie beim Kreuz und beim Anhefter: WER
// ZENTRIERT, MUSS DIE ZAHL ERFRAGEN, DIE WIRKLICH GEMALT WIRD -- nicht
// die, die er bestellt hat.
fn icon_mid(id: u64, x: u64, y: u64, h: u64, px_: u64, color: u64) -> bool {
    let at: u64 = gfind(F_ICON, px_, id)
    if at == 0xFFFFFFFFFFFFFFFF {
        return false
    }
    let gw: u64 = gc[(at + GC_W) as usize]
    let gh: u64 = gc[(at + GC_H) as usize]
    if gw == 0 || gh == 0 {
        return false
    }
    var oben: u64 = y
    if h > gh {
        oben = y + (h - gh) / 2
    }
    draw_glyph(at, x as i64, (oben + gc[(at + GC_T) as usize]) as i64,
        color)
    return true
}


// ============================================ ROUND NETVIEW, addendum
//
// AN ICON WHOSE COLOURS COME FROM THE SCHEME.
//
// OSYM (`tools/k15/icon.py`) stores four octets per pixel: blue,
// green, red, coverage. Coverage 0 has always meant transparent and 255
// has always meant "these three octets are the colour". This round uses
// the numbers in between -- 1 to 5 -- to mean "ask the scheme": ink,
// dim, accent, warn, panel.
//
// WHY IN THE COVERAGE OCTET AND NOT IN A SECOND FILE FORMAT. Because
// every symbol that existed before this addendum carries 0 and 255 and
// therefore does not change by one octet; `tools/k15/run.sh` reads all
// five bundle symbols back pixel by pixel and would say so. A second
// format would have been a second reader, a second writer and a second
// place to be wrong.
//
// AND THIS IS WHAT MAKES ONE DRAWING RIGHT IN BOTH SCHEMES. A taskbar
// icon with 0xE8EEF4 written into it is a light icon; on a light scheme
// it is a white shape on a white bar, which is not an icon. A drawing
// that says `@ink` is whatever the running scheme calls its foreground,
// and the same file is right in both.
const ICON_ROLES: u64 = 5

fn icon_role(a: u64) -> u64 {
    if a == 1 {
        return theme(T_FG)
    }
    if a == 2 {
        return theme(T_DIM)
    }
    if a == 3 {
        return theme(T_ACCENT)
    }
    if a == 4 {
        return theme(T_FOCUS)
    }
    if a == 5 {
        return theme(T_PANEL)
    }
    return theme(T_FG)
}

// "OSYM", octet by octet -- read as one number it would depend on the
// byte order of the machine, and the header of a file does not.
fn icon_ok(p: u64) -> bool {
    if p == 0 {
        return false
    }
    if __mmio_read8((p) as *mut u8) != 79 as u8 {
        return false
    }
    if __mmio_read8((p + 1) as *mut u8) != 83 as u8 {
        return false
    }
    if __mmio_read8((p + 2) as *mut u8) != 89 as u8 {
        return false
    }
    return __mmio_read8((p + 3) as *mut u8) == 77 as u8
}

fn icon_w(p: u64) -> u64 {
    if !icon_ok(p) {
        return 0
    }
    return __mmio_read32((p + 4) as *mut u32) as u64
}

fn icon_h(p: u64) -> u64 {
    if !icon_ok(p) {
        return 0
    }
    return __mmio_read32((p + 8) as *mut u32) as u64
}

// The picture at x, y. Transparent pixels leave what is underneath
// alone -- so an icon on a taskbar button keeps the button's face, and
// a pixel checker that measures the face at the corners still finds it.
fn icon_draw(p: u64, x: u64, y: u64) -> bool {
    return icon_draw_sc(p, x, y, ui_scale())
}

// ==================================================== RUNDE ECHTHARDWARE-2
//
// WIE GROSS DAS BILD AM ENDE WIRKLICH IST.
//
// Wer ein Symbol senkrecht mittig setzen will, rechnet `(h - GROESSE)
// / 2` -- und GROESSE muss die Zahl sein, die auch gemalt wird. Bis zu
// dieser Runde stand dort `gl_w()` (16 * Vervielfachung = 32), gemalt
// wurden aber `icon_h() * Vervielfachung`. Bei einem 14 Punkte hohen
// Bild in einem 16er Feld sind das 28 statt 32, und das Symbol sass
// GEMESSEN fuenf Punkte zu hoch -- genau Justins "Symbol und Text
// nicht auf gleicher Hoehe".
//
// Also gibt es die Zahl jetzt zum Nachfragen, statt sie an jeder
// Malstelle neu zu schaetzen.
fn icon_draw_w(p: u64) -> u64 {
    return icon_w(p) * ui_scale()
}

fn icon_draw_h(p: u64) -> u64 {
    return icon_h(p) * ui_scale()
}

// ============================================== RUNDE LEISTE-RECHTS
// WIE VIEL VON EINEM OSYM-BILD WIRKLICH TINTE IST.
//
// `icon_draw_h` liefert den KASTEN (Kopfzeile mal Vervielfachung). Das
// ist nicht dasselbe wie das, was man sieht: `state-nocarrier.txt` ist
// ein 16x16-Bild, dessen Tinte nur in den Zeilen 0..12 steht -- die
// unteren drei sind leer. Wer den KASTEN mittig setzt, setzt die Tinte
// um die Haelfte der leeren Zeilen zu hoch.
//
// GEMESSEN (3440x1440, uiscale=2, Feld 64 hoch): das WLAN-Symbol sass
// bei oben=24/unten=30, der Ton daneben bei 24/24. Sechs Punkte
// Unterschied zwischen zwei Symbolen, die nebeneinander stehen.
//
// Diese beiden Routinen geben die ERSTE Tintenzeile und die HOEHE der
// Tinte zurueck, beide schon mit der Vervielfachung multipliziert.
// Damit rechnet ein Aufrufer:
//
//     y = kasten_y + (kasten_h - ink_h) / 2 - ink_top
//
// also: die TINTE steht mittig, egal wo sie im Bild liegt.
fn icon_ink_top(p: u64) -> u64 {
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return 0
    }
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let v: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            if ((v >> 24) & 0xFF) != 0 {
                return r * ui_scale()
            }
            c = c + 1
        }
        r = r + 1
    }
    return 0
}

fn icon_ink_hgt(p: u64) -> u64 {
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return 0
    }
    var erst: u64 = h
    var letzt: u64 = 0
    var gab: bool = false
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let v: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            if ((v >> 24) & 0xFF) != 0 {
                if !gab {
                    erst = r
                    gab = true
                }
                letzt = r
                c = w
            } else {
                c = c + 1
            }
        }
        r = r + 1
    }
    if !gab {
        return 0
    }
    return (letzt - erst + 1) * ui_scale()
}

// ============================================== RUNDE LEISTE-RECHTS
// DASSELBE IN DER WAAGRECHTEN -- UND AUS DEMSELBEN GRUND.
//
// `icon_ink_top`/`icon_ink_hgt` haben die Frage fuer die ZEILEN
// beantwortet und die WLAN-Tinte senkrecht mittig gesetzt. Waagrecht
// stand die Frage nie: die Feldbreite rechnete mit `ic_w()`, also mit
// dem KASTEN (16 * 2 = 32). Die Tinte von `state-nocarrier` ist aber
// nur 14 Spalten breit (28 gemalt) -- die vier ueberzaehligen Punkte
// legten sich neben das Symbol und vergroesserten die LUECKE zum
// Tonfeld. Gemessen am laufenden System: 37 Punkte zwischen WLAN und
// Ton, 19 zwischen Ton und Akku. Gleich weit ist etwas anderes.
//
// Wer Abstaende gleich haben will, muss die Breite messen, die WIRKLICH
// gemalt wird -- nicht die, die bestellt wurde.
fn icon_ink_lft(p: u64) -> u64 {
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return 0
    }
    var c: u64 = 0
    while c < w {
        var r: u64 = 0
        while r < h {
            let v: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            if ((v >> 24) & 0xFF) != 0 {
                return c * ui_scale()
            }
            r = r + 1
        }
        c = c + 1
    }
    return 0
}

fn icon_ink_wid(p: u64) -> u64 {
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return 0
    }
    var erst: u64 = w
    var letzt: u64 = 0
    var gab: bool = false
    var c: u64 = 0
    while c < w {
        var r: u64 = 0
        while r < h {
            let v: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            if ((v >> 24) & 0xFF) != 0 {
                if !gab {
                    erst = c
                    gab = true
                }
                letzt = c
                r = h
            } else {
                r = r + 1
            }
        }
        c = c + 1
    }
    if !gab {
        return 0
    }
    return (letzt - erst + 1) * ui_scale()
}

// ==================================================== RUNDE ECHTHARDWARE-2
//
// DAS SYMBOL WAECHST MIT DEM SCHIRM -- UND DAS WAR DIE WURZEL DER
// "WINZIGEN SYMBOLE".
//
// Justin hat auf 2560x1440 fotografiert: die Zeichen in der Taskleiste
// sind Stecknadelkoepfe in einem 80 Bildpunkte hohen Streifen. Auf der
// seriellen Leitung stand dazu
//
//     taskbar: sym btn=0 app=terminal w=16 ink=196
//
// und diese 16 sind NICHT die Zeichengroesse, sondern `icon_w()` --
// die Groesse der Bilddatei. Genau hier lag der Fehler: `icon_draw`
// hat das Feld PUNKT FUER PUNKT ausgegeben, ohne die Vervielfachung
// auch nur zu kennen. Jede andere Groesse im System (Schrift ueber
// `px_ui()`, Knopfhoehen, `gl_w()`) nimmt `ui_scale()` mit -- dieses
// eine Blit nicht. Die Leiste wurde doppelt so hoch, das Symbol blieb
// 16 Punkte.
//
// GENOMMEN WIRD DIE NAECHSTE NACHBARSCHAFT und keine Glaettung: die
// Quellen sind Flaechenzeichnungen mit harten Kanten (siehe
// assets/apps/*/symbol.txt), und eine Glaettung machte daraus bei
// ganzzahliger Vervielfachung nur einen weichen Rand. Ganzzahlig
// vervielfacht ist ein Kaestchen ein Kaestchen.
//
// `icon_draw_sc` steht daneben, damit ein Aufrufer, der eine ANDERE
// Groesse braucht (die Vorschau in den Einstellungen), sie nennen
// kann, ohne dass hier eine zweite Schleife entsteht.
fn icon_draw_sc(p: u64, x: u64, y: u64, sc: u64) -> bool {
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return false
    }
    var s: u64 = sc
    if s == 0 {
        s = 1
    }
    if s > 8 {
        s = 8
    }
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let v: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            let a: u64 = (v >> 24) & 0xFF
            if a != 0 {
                var f: u64 = v & RGB24
                if a != 255 {
                    f = icon_role(a)
                }
                // Ein Quellpunkt wird zu einem s-mal-s-Kaestchen.
                var dy: u64 = 0
                while dy < s {
                    var dx: u64 = 0
                    while dx < s {
                        px(x + c * s + dx, y + r * s + dy, f)
                        dx = dx + 1
                    }
                    dy = dy + 1
                }
            }
            c = c + 1
        }
        r = r + 1
    }
    return true
}
