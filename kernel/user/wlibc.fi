const WS_LAYER: u64 = 0
const WS_HIDDEN: u64 = 1
const WS_DECO: u64 = 2
// RUNDE ECHTHARDWARE-1: dieselbe Nummer wie `sys.WS_KEYS`. 1 = dieses
// Fenster will die Tastatur, auch wenn es nicht auf der normalen
