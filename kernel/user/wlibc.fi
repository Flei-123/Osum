const BUS_DRAGGET_OP: u64 = 16
const BUS_DRAGCLEAR_OP: u64 = 17
const BUS_DRAGINFO_OP: u64 = 18
const BUS_NOTIPOST_OP: u64 = 19
const BUS_NOTIGET_OP: u64 = 20
const BUS_NOTIINFO_OP: u64 = 21

const BT_TEXT: u64 = 1
const BT_PATH: u64 = 2
const BT_HTML: u64 = 4
const BT_IMAGE: u64 = 8
const BT_FILES: u64 = 16

const WIG_CLIPSET: u64 = 1803
const WIG_CLIPGET: u64 = 1804
