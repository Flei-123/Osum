// them against each other.
const WL_APP: u64 = 104
const WL_BYTES: u64 = 128
const APP_LEN: u64 = 24
const WM_APP: u64 = 2116

const L_DESK: u64 = 0
const L_NORMAL: u64 = 1
const L_TOP: u64 = 2
// RUNDE ECHTHARDWARE-3: die Ebenen UEBER der Taskleiste. Die
// Zahlen sind dieselben wie in `kernel/wm.fi`; sie stehen hier ein
// zweites Mal, weil Ring 3 den Fensterserver nicht importieren kann.
//
// RUNDE VOLLBILD: DIESE LISTE MUSS MIT wm.fi MITWANDERN. L_FULL ist
// dort als 3 eingeschoben worden, also ruecken die drei darueber auch
// hier um eins. Haette nur wm.fi sich geaendert, saetzte jedes
// Startmenue sich auf Ebene 3 -- und das ist seitdem das VOLLBILD.
// Eine Zahl, die an zwei Stellen steht, ist eine Zahl, die an zwei
// Stellen falsch werden kann.
const L_FULL: u64 = 3
const L_MENUE: u64 = 4
const L_POPUP: u64 = 5
const L_TIP: u64 = 6
const F_HIDDEN: u64 = 1
const F_NODECO: u64 = 2

const EV_KEY: u64 = 1
const EV_DOWN: u64 = 2
const EV_UP: u64 = 3
const EV_MOVE: u64 = 4
const EV_CLOSE: u64 = 5
const EV_FOCUS: u64 = 6
const EV_RESIZE: u64 = 7

const SYS_MMAP: u64 = 9
const PROT_RW: u64 = 3
const MAP_ANON_PRIV: u64 = 34

// Die beiden Schriften, die der Server geladen hat, und die Groessen,
// in denen er sie setzt (`kmain.fi`: PX_UI 15, PX_MONO 16). Dieselben
// Zahlen hier, weil eine Oberflaeche, die den Titel in 15 und ihren
// eigenen Text in 14 setzt, zwei Schriftbilder hat.
const F_UI: u64 = 0
const F_MONO: u64 = 1
// RUNDE SCHIRM: aus zwei Zahlen wurden zwei Grundmasse. Multipliziert
// wird mit dem, was der Server sagt (WIG_SCREEN, WS_SCALE) -- derselbe
// Faktor, mit dem er seine Titelleisten und seine eigene Schrift setzt.
// Stuende hier weiter 15, setzte auf einer 4K-Tafel der Server den Titel
// in 30 und das Programm darunter seinen Text in 15.
const PX_UI0: u64 = 15
const PX_MONO0: u64 = 16

// ROUND ICONS: the third role.  Same number as `wig.F_ICON`, and it has
// to be -- the value travels through WIG_GLYPH unchanged.
const F_ICON: u64 = 2

// THE FOUR SIZES AN ICON IS DRAWN AT, and they are four and not any
// number the caller likes for one reason: an icon has to be CHECKED at
// the size it is used.  A drawing that turns to mush at sixteen pixels
// is worthless, and it only shows if the sheet is rendered at sixteen
// -- not at ninety-six and then shrunk.
//
//   ICON_SMALL    16  list rows, the file manager, status in a line
//   ICON_MENU     16  next to a menu entry, same box as the text line
//   ICON_TASKBAR  20  the taskbar, where the row is taller
//   ICON_LARGE    24  buttons with an icon above the label, dialogues
//
// SMALL and MENU are the same number today.  They are two names because
// they answer to different things: SMALL follows the row height of a
// list, MENU follows PX_UI.  When one of the two moves, the other must
// not move with it by accident.
const ICON_SMALL0: u64 = 16
const ICON_MENU0: u64 = 16
const ICON_TASKBAR0: u64 = 20
const ICON_LARGE0: u64 = 24

// ------------------------------------------------------- die Flaeche

// RUNDE SCHIRM -- WARUM HIER EINE KONSTANTE STAND UND JETZT KEINE MEHR.
//
// Bis zu dieser Runde war die Malflaeche 800 x 81 Bildpunkte GROSS UND
// FEST, und `start` gab `false` zurueck, sobald der Bildschirm breiter
// war als 800:
//
//     if ulib.bad(s_scr_w) || s_scr_w == 0 || s_scr_w > SURF_W {
//         return false
//     }
//
// Das war keine Schranke, das war ein Ausschalter. GEMESSEN, mit
// demselben Kern und derselben Platte, nur mit `fbbig` dazu:
//
//     800x600    wm: windows=5   Schreibtisch, Leiste, Starter, Terminal
//     1024x768   wm: windows=1   "desktop: keine Flaeche",
//                                "taskbar: no surface",
//                                "launcher: keine Flaeche"
//
// Und auf ECHTEM Blech faengt es erst ueber 800 an: Limine liefert dem
// Kern unter UEFI/OVMF 1280x800, unter BIOS mit EDID 1920x1080. Osum
// startete dort also und zeigte einen leeren Schirm mit einem einzigen
// Terminalfenster -- genau der Zustand "bootet, ist aber nicht
// benutzbar".
//
// JETZT IST DIE FLAECHE SO BREIT WIE DER SCHIRM. Ihre HOEHE faellt aus
// einem festen Vorrat: SURF_BUDGET Oktette, geteilt durch eine
// Bildzeile. Damit kostet ein Prozess unabhaengig von der Aufloesung
// dasselbe, und die Zahl der Streifen waechst statt der Speicherbedarf:
//
//     800 breit   -> 327 Zeilen (vorher 81)
//    1920 breit   -> 136 Zeilen
//    3840 breit   ->  68 Zeilen
//
// Der 800er Fall wird dabei nebenbei schneller, weil ein voller
// Schreibtisch statt in acht Streifen in zwei geht.
const SURF_BUDGET: u64 = 1048576
// Weiter als das ist kein Bildschirm, den dieser Kernel abbilden kann;
// die Schranke steht hier gegen eine unsinnige Antwort des Servers und
// nicht gegen eine Aufloesung.
const SURF_W_MAX: u64 = 8192

static mut s_surf: u64 = 0
static mut s_sw: u64 = 0 // Breite der Flaeche = Breite des Schirms
static mut s_srows: u64 = 0 // wie viele Bildzeilen ein Streifen traegt
static mut s_band: u64 = 0
static mut s_scr_w: u64 = 0
static mut s_scr_h: u64 = 0
static mut s_cx0: u64 = 0
static mut s_cy0: u64 = 0
static mut s_cx1: u64 = 0
static mut s_cy1: u64 = 0
static mut s_ready: u64 = 0
static mut s_noclip: u64 = 0
static mut s_shape: u64 = 0
static mut s_scale: u64 = 0 // 0 = noch nicht gefragt

fn sys5(number: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, in("r10") a3, in("r8") a4,
        clobber("rcx"), clobber("r11"), clobber("memory"))
}

fn sys3w(number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

// RUNDE ALLTAG: auch nach aussen. Ein Bildbetrachter braucht Megabytes
// fuer die Bildpunkte, und der einzige Weg dazu ist derselbe, den die
// Zeichenflaeche nimmt -- anonymes `mmap`. Der Name bleibt, obwohl es
// nicht mehr nur um Flaechen geht; ihn zu aendern hiesse jede
// Fundstelle anzufassen.
fn map_surface(bytes: u64) -> u64 {
    let no: u64 = 0 -% 1
    return asm("syscall", out("rax"), in("rax") SYS_MMAP, in("rdi") 0,
        in("rsi") bytes, in("rdx") PROT_RW, in("r10") MAP_ANON_PRIV,
        in("r8") no, in("r9") 0, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

fn start(noclip: bool) -> bool {
    if s_ready != 0 {
        return true
    }
    // ERST FRAGEN, DANN ABBILDEN. Die Reihenfolge war umgekehrt, solange
    // die Groesse der Flaeche im Quelltext stand; jetzt haengt sie von
    // der Antwort des Servers ab und muss danach kommen.
    s_scr_w = sys3w(WIG_SCREEN, 0, 0, 0)
    s_scr_h = sys3w(WIG_SCREEN, 1, 0, 0)
    if ulib.bad(s_scr_w) || s_scr_w == 0 || s_scr_w > SURF_W_MAX {
        return false
    }
    if ulib.bad(s_scr_h) || s_scr_h == 0 {
        return false
    }
    var rows: u64 = SURF_BUDGET / (s_scr_w *% 4)
    if rows == 0 {
        return false
    }
    if rows > s_scr_h {
        rows = s_scr_h
    }
    let p: u64 = map_surface(s_scr_w *% rows *% 4)
    if ulib.bad(p) || p == 0 {
        return false
    }
    s_surf = p
    s_sw = s_scr_w
    s_srows = rows
    if noclip {
        s_noclip = 1
    }
    let _tg: u64 = theme_reload()
    s_ready = 1
    return true
}

fn ready() -> bool {
    return s_ready != 0
}

// RUNDE SCHIRM: die Vervielfachung. Einmal gefragt, dann gemerkt -- sie
// aendert sich nicht, solange das Programm laeuft, und ein Systemaufruf
// je gezeichnetem Buchstaben waere teurer als der Buchstabe.
fn ui_scale() -> u64 {
    if s_scale == 0 {
        let v: u64 = sys3w(WIG_SCREEN, 6, 0, 0)
        if ulib.bad(v) || v == 0 || v > 4 {
            s_scale = 1
        } else {
            s_scale = v
        }
    }
    return s_scale
}

fn px_ui() -> u64 {
    return PX_UI0 * ui_scale()
}

fn px_mono() -> u64 {
    return PX_MONO0 * ui_scale()
}

fn icon_small() -> u64 {
    return ICON_SMALL0 * ui_scale()
}

fn icon_menu() -> u64 {
    return ICON_MENU0 * ui_scale()
}

fn icon_taskbar() -> u64 {
    return ICON_TASKBAR0 * ui_scale()
}

fn icon_large() -> u64 {
    return ICON_LARGE0 * ui_scale()
}

fn surface() -> u64 {
    return s_surf
}

fn surf_w() -> u64 {
    return s_sw
}

fn surf_rows() -> u64 {
    return s_srows
}

fn band_y() -> u64 {
    return s_band
}

fn screen_w() -> u64 {
    return s_scr_w
}

fn screen_h() -> u64 {
    return s_scr_h
}

fn mouse_x() -> u64 {
    return sys3w(WIG_SCREEN, 2, 0, 0)
}

fn mouse_y() -> u64 {
    return sys3w(WIG_SCREEN, 3, 0, 0)
}

// ADDENDUM TASKBAR: WHICH BUTTONS ARE DOWN RIGHT NOW. Bit 0 is left.
// A window only gets EV_DOWN and EV_UP for the pointer INSIDE it; the
// taskbar has to follow a drag that leaves it, all the way to the other
// side of the screen, and this is the only way to see the button let
// go out there.
fn mouse_btn() -> u64 {
    return sys3w(WIG_SCREEN, 4, 0, 0)
}

// Der Streifen faengt bei dieser Fensterzeile an. Alles, was danach
// gemalt wird, rechnet in FENSTERKOORDINATEN -- die Umrechnung auf die
// Flaeche steht an genau einer Stelle, in `px`.
fn set_band(y: u64) {
    s_band = y
}

fn clip_set(x0: u64, y0: u64, x1: u64, y1: u64) {
    s_cx0 = x0
    s_cy0 = y0
    s_cx1 = x1
    s_cy1 = y1
}

fn clip_x0() -> u64 {
    return s_cx0
}

fn clip_y0() -> u64 {
    return s_cy0
}

fn clip_x1() -> u64 {
    return s_cx1
}

fn clip_y1() -> u64 {
    return s_cy1
}

// ---------------------------------------------------- die Grundformen

fn px(x: u64, y: u64, color: u64) {
    if x < s_cx0 || x >= s_cx1 || y < s_cy0 || y >= s_cy1 {
        return
    }
    if x >= s_sw || y < s_band {
        return
    }
    let r: u64 = y - s_band
    if r >= s_srows {
        return
    }
    __mmio_write32((s_surf +% (r *% s_sw +% x) *% 4) as *mut u32,
        color as u32)
}

fn get(x: u64, y: u64) -> u64 {
    if x >= s_sw || y < s_band {
        return 0
    }
    let r: u64 = y - s_band
    if r >= s_srows {
        return 0
    }
    return __mmio_read32((s_surf +% (r *% s_sw +% x) *% 4)
        as *mut u32) as u64
}

// DIESELBE ZEILE WIE `wm.blend` UND WIE `mische` in
// tools/gfx/checkshot.py. Sie steht dreimal, in drei Sprachen, und das ist
// kein Versehen: ein bildpunktgenauer Vergleich eines
// kantengeglaetteten Zeichens ist nur moeglich, wenn alle drei
// dieselbe Rundung nehmen.
fn blend(alt: u64, neu: u64, a: u64) -> u64 {
    if a == 0 {
        return alt
    }
    if a >= 255 {
        return neu
    }
    let ia: u64 = 255 - a
    // ROUND PAINT: the same arithmetic as `fb.blend`, and it is a
    // DIFFERENT ANSWER from the one that stood here.  This line divided
    // by 255 and truncated; measured over all 16 777 216 triples
    // (a, src, dst) against the exact, half-up rounded value, that is
    // off by one on 8 164 890 of them -- 48.67 per cent.
    // `(num + 127) / 255` is exact on every one of the 16.7 million,
    // and measured (see the header of `fb.mix8`) it is also the FASTER
    // of the two exact forms on this machine -- the division-free
    // variant lost by a fifth.
    // tools/paint/blendcheck.py is the measurement, and it checks all
    // FOUR places this line lives in (kernel/fb.fi, kernel/wm.fi,
    // kernel/user/wlibc.fi, tools/gfx/checkshot.py) against each other.
    let r: u64 = mix8((alt >> 16) & 0xFF, (neu >> 16) & 0xFF, a, ia)
    let g: u64 = mix8((alt >> 8) & 0xFF, (neu >> 8) & 0xFF, a, ia)
    let b: u64 = mix8(alt & 0xFF, neu & 0xFF, a, ia)
    return (r << 16) | (g << 8) | b
}

// One channel.  See the header of `fb.mix8` for why it is written this
// way and what it was measured against.
fn mix8(dst: u64, src: u64, a: u64, ia: u64) -> u64 {
    return (src *% a +% dst *% ia +% 127) / 255
}

fn rect(x: u64, y: u64, w: u64, h: u64, color: u64) {
    if w == 0 || h == 0 {
        return
    }
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            px(x + c, y + r, color)
            c = c + 1
        }
        r = r + 1
    }
}

fn hline(x: u64, y: u64, w: u64, color: u64) {
    rect(x, y, w, 1, color)
}

fn vline(x: u64, y: u64, h: u64, color: u64) {
    rect(x, y, 1, h, color)
}

// Ein Rahmen von einem Bildpunkt -- vier Linien und KEINE Fuellung.
// `tools/gfx/checkshot.py rechteck` rechnet genau diese vier Kanten nach
// und prueft dazu, dass einen Bildpunkt daneben die Farbe NICHT steht.
fn frame(x: u64, y: u64, w: u64, h: u64, color: u64) {
    if w < 2 || h < 2 {
        return
    }
    hline(x, y, w, color)
    hline(x, y + h - 1, w, color)
    vline(x, y, h, color)
    vline(x + w - 1, y, h, color)
}

// Ein Rahmen, der eine Kante hat: hell oben und links, dunkel unten und
// rechts (oder umgekehrt, wenn `ein` gesetzt ist). Zwei Zeilen Code und
// der ganze Unterschied zwischen "ein Rechteck" und "ein Knopf".
fn frame3(x: u64, y: u64, w: u64, h: u64, hell: u64, dunkel: u64,
    ein: bool) {
    var o: u64 = hell
    var u: u64 = dunkel
    if ein {
        o = dunkel
        u = hell
    }
    if w < 2 || h < 2 {
        return
    }
    hline(x, y, w, o)
    vline(x, y, h, o)
    hline(x, y + h - 1, w, u)
    vline(x + w - 1, y, h, u)
}

// =============== ROUND LOOK: ROUNDED RECTANGLES, AND WHAT THEY COST
//
// A radius token is worth nothing without something that can draw one,
// and a rounded corner drawn with hard pixels is a staircase, which at
// radius 8 is MORE conspicuous than a square corner, not less. So the
// corners are antialiased, and here is exactly how much that costs and
// why it is affordable:
//
//   * ONLY THE FOUR CORNER SQUARES ARE SAMPLED. Everything else is the
//     same run of `rect` it always was. A rectangle of radius r pays
//     for 4 * r * r pixels no matter how big it is -- 256 pixels at
//     r = 8, whether the rectangle is 60 x 26 or 796 x 576.
//   * EACH OF THOSE PIXELS IS SAMPLED 4 x 4. Sixteen point-in-circle
//     tests, all of them integer: (2dx+1)^2 + (2dy+1)^2 against
//     (2r)^2 in quarter-pixel units, no square root, no division.
//   * THE COVERAGE IS BLENDED AGAINST WHAT IS ALREADY THERE, with the
//     SAME `blend` the glyph rasteriser uses, so a corner and a letter
//     of the same colour over the same background come out of the same
//     arithmetic.
//
// `aa_pixels()` counts every pixel that went through the sampler, so
// the cost is a MEASUREMENT in every run and not a claim in a comment.
//
// If this ever turns out to be too expensive the honest fallback is
// hard edges with the CORRECT rounding -- coverage >= 128 becomes ink,
// below becomes background -- and not a smaller radius. That is one
// line (`if cov >= 128`), and it is written here so that whoever needs
// it does not have to redesign anything.

// Is (dx, dy) -- the distance from the centre of the corner circle, in
// whole pixels, of the pixel's TOP LEFT -- inside the circle? Answered
// as a coverage 0..255 by sampling the pixel sixteen times.
fn corner_cov(dx: u64, dy: u64, r: u64) -> u64 {
    if r == 0 {
        return 255
    }
    // The far corner of the pixel is inside: fully covered.
    // Cheap early exits, and they carry most of the pixels.
    let rr: u64 = r *% r
    if (dx + 1) * (dx + 1) + (dy + 1) * (dy + 1) <= rr {
        return 255
    }
    if dx * dx + dy * dy >= rr {
        return 0
    }
    var hits: u64 = 0
    var sy: u64 = 0
    while sy < 4 {
        var sx: u64 = 0
        while sx < 4 {
            // the centre of sub-sample (sx, sy), in eighths of a pixel
            let px8: u64 = dx *% 8 +% sx *% 2 +% 1
            let py8: u64 = dy *% 8 +% sy *% 2 +% 1
            if px8 *% px8 +% py8 *% py8 <= (r *% 8) *% (r *% 8) {
                hits = hits + 1
            }
            sx = sx + 1
        }
        sy = sy + 1
    }
    aa_px = aa_px + 1
    return hits * 255 / 16
}

// ====================================================== RUNDE VEKTOR
//
// DER KURVENRASTERER FUER RING 3.
//
// Warum hier eine zweite Fassung steht und nicht `kernel/vektor.fi`
// benutzt wird: `kernel/user/*.fi` wird in EIGENE Objektdateien
// uebersetzt (tools/design/capture.sh, Zeile 150) und darf nichts aus
// dem Kern aufrufen -- dieselbe Regel, die in `kernel/uprog.fi` oben
// steht. Ein `import vektor` waere ein undefinierter Name beim Binden.
//
// Was hier steht, ist deshalb der KERN desselben Verfahrens, Zeile fuer
// Zeile mit derselben Arithmetik: 26.6 Festkomma, kubische Bezier mit
// KAPPA = 35, vier Abtastzeilen und vier Abtastspalten je Bildpunkt,
// Deckung (cov * 255 + 8) / 16. Was der Kern fuer den Fensterrahmen
// malt und was diese Bibliothek fuer einen Knopf malt, hat damit
// DIESELBE Kruemmung und DIESELBE Kante.
//
// `tools/design/vektorcheck.py` prueft beide gegen dieselben Sollwerte.

const V_EINS: i64 = 64
const V_KAPPA: i64 = 35
const V_TEILE: i64 = 16
// So viele Punkte braucht die groesste Form dieser Bibliothek: ein
// Rechteck mit vier Ecken a 16 Kurvenstuecken plus die Geraden.
const V_MAXP: u64 = 96
const V_MAXK: u64 = 96

static mut vpx: [i64; 96] = [0 as i64; 96]
static mut vpy: [i64; 96] = [0 as i64; 96]
static mut vn: u64 = 0
static mut vkx0: [i64; 96] = [0 as i64; 96]
static mut vky0: [i64; 96] = [0 as i64; 96]
static mut vkx1: [i64; 96] = [0 as i64; 96]
static mut vky1: [i64; 96] = [0 as i64; 96]
static mut vkn: u64 = 0
static mut vstart: u64 = 0
// Die Schnittpunkte EINER Abtastzeile.
static mut vcx: [i64; 96] = [0 as i64; 96]
static mut vcd: [i64; 96] = [0 as i64; 96]

// Teilen mit Runden, symmetrisch um die Null. Muss Bit fuer Bit
// dasselbe tun wie `rdiv` in kernel/vektor.fi -- sonst rundet ein
// Knopf anders als der Fensterrahmen daneben. Mit abschneidender
// Division waren bei einem Kreis von r=8 sechzig von sechzig
// Abtastzeilen unsymmetrisch; gemessen in tools/design/vektorcheck.py.
fn vrdiv(a: i64, b: i64) -> i64 {
    if b == 0 {
        return 0
    }
    var za: i64 = a
    var nb: i64 = b
    if nb < 0 {
        za = 0 - za
        nb = 0 - nb
    }
    if za >= 0 {
        return (za + nb / 2) / nb
    }
    return 0 - ((0 - za) + nb / 2) / nb
}

fn v_new() {
    vn = 0
    vkn = 0
    vstart = 0
}

fn v_point(x: i64, y: i64) {
    if vn >= V_MAXP {
        return
    }
    vpx[(vn) as usize] = x
    vpy[(vn) as usize] = y
    vn = vn + 1
}

fn v_edge(ax: i64, ay: i64, bx: i64, by: i64) {
    if ay == by {
        return
    }
    if vkn >= V_MAXK {
        return
    }
    vkx0[(vkn) as usize] = ax
    vky0[(vkn) as usize] = ay
    vkx1[(vkn) as usize] = bx
    vky1[(vkn) as usize] = by
    vkn = vkn + 1
}

fn v_move_to(x: i64, y: i64) {
    vstart = vn
    v_point(x, y)
}

fn v_line(x: i64, y: i64) {
    v_point(x, y)
}

fn v_kubik(c1x: i64, c1y: i64, c2x: i64, c2y: i64, x: i64, y: i64) {
    if vn == 0 {
        v_move_to(x, y)
        return
    }
    let ax: i64 = vpx[((vn - 1)) as usize]
    let ay: i64 = vpy[((vn - 1)) as usize]
    let n: i64 = V_TEILE
    var i: i64 = 1
    while i <= n {
        let t: i64 = i
        let u: i64 = n - i
        let nnn: i64 = n * n * n
        v_point(vrdiv(u * u * u * ax + 3 * u * u * t * c1x
            + 3 * u * t * t * c2x + t * t * t * x, nnn),
            vrdiv(u * u * u * ay + 3 * u * u * t * c1y
            + 3 * u * t * t * c2y + t * t * t * y, nnn))
        i = i + 1
    }
}

// Ein Viertelkreis von (x0,y0) nach (x1,y1) um die Ecke (ex,ey).
fn v_bogen(x0: i64, y0: i64, ex: i64, ey: i64, x1: i64, y1: i64) {
    v_kubik(x0 + vrdiv((ex - x0) * V_KAPPA, 64),
        y0 + vrdiv((ey - y0) * V_KAPPA, 64),
        x1 + vrdiv((ex - x1) * V_KAPPA, 64),
        y1 + vrdiv((ey - y1) * V_KAPPA, 64), x1, y1)
}

fn v_close_path() {
    if vn <= vstart + 1 {
        return
    }
    var i: u64 = vstart
    while i + 1 < vn {
        v_edge(vpx[(i) as usize], vpy[(i) as usize],
            vpx[((i + 1)) as usize], vpy[((i + 1)) as usize])
        i = i + 1
    }
    v_edge(vpx[((vn - 1)) as usize], vpy[((vn - 1)) as usize],
        vpx[(vstart) as usize], vpy[(vstart) as usize])
    vstart = vn
}

// Rechteck mit Eckradius, alles in 26.6.
fn v_rundeck(x: i64, y: i64, w: i64, h: i64, r0: i64) {
    if w <= 0 || h <= 0 {
        return
    }
    var r: i64 = r0
    if r < 0 {
        r = 0
    }
    if r > w / 2 {
        r = w / 2
    }
    if r > h / 2 {
        r = h / 2
    }
    let x1: i64 = x + w
    let y1: i64 = y + h
    if r == 0 {
        v_move_to(x, y)
        v_line(x1, y)
        v_line(x1, y1)
        v_line(x, y1)
        v_close_path()
        return
    }
    v_move_to(x + r, y)
    v_line(x1 - r, y)
    v_bogen(x1 - r, y, x1, y, x1, y + r)
    v_line(x1, y1 - r)
    v_bogen(x1, y1 - r, x1, y1, x1 - r, y1)
    v_line(x + r, y1)
    v_bogen(x + r, y1, x, y1, x, y1 - r)
    v_line(x, y + r)
    v_bogen(x, y + r, x, y, x + r, y)
    v_close_path()
}

fn v_ellipse(cx: i64, cy: i64, rx: i64, ry: i64) {
    if rx <= 0 || ry <= 0 {
        return
    }
    v_move_to(cx, cy - ry)
    v_bogen(cx, cy - ry, cx + rx, cy - ry, cx + rx, cy)
    v_bogen(cx + rx, cy, cx + rx, cy + ry, cx, cy + ry)
    v_bogen(cx, cy + ry, cx - rx, cy + ry, cx - rx, cy)
    v_bogen(cx - rx, cy, cx - rx, cy - ry, cx, cy - ry)
    v_close_path()
}

fn v_cross_add(n: u64, x: i64, d: i64) -> u64 {
    if n >= V_MAXK {
        return n
    }
    var j: u64 = n
    while j > 0 {
        if vcx[((j - 1)) as usize] <= x {
            break
        }
        vcx[(j) as usize] = vcx[((j - 1)) as usize]
        vcd[(j) as usize] = vcd[((j - 1)) as usize]
        j = j - 1
    }
    vcx[(j) as usize] = x
    vcd[(j) as usize] = d
    return n + 1
}

// DEN AUFGEBAUTEN PFAD MALEN, direkt in die Zeichenflaeche.
//
// Es gibt keine Deckungstafel wie im Kern: hier wird Zeile fuer Zeile
// gerastert und sofort gemischt. Das spart den Puffer (ein Knopf von
// 200x40 waere 8000 Oktette in einer Bibliothek, die in dreizehn
// Programmen steckt) und kostet nichts, weil jede Zeile ohnehin nur
// einmal gebraucht wird.
fn v_fuellen(farbe: u64) {
    if vkn == 0 {
        return
    }
    var miny: i64 = vky0[(0) as usize]
    var maxy: i64 = miny
    var minx: i64 = vkx0[(0) as usize]
    var maxx: i64 = minx
    var i: u64 = 0
    while i < vkn {
        if vky0[(i) as usize] < miny { miny = vky0[(i) as usize] }
        if vky1[(i) as usize] < miny { miny = vky1[(i) as usize] }
        if vky0[(i) as usize] > maxy { maxy = vky0[(i) as usize] }
        if vky1[(i) as usize] > maxy { maxy = vky1[(i) as usize] }
        if vkx0[(i) as usize] < minx { minx = vkx0[(i) as usize] }
        if vkx1[(i) as usize] < minx { minx = vkx1[(i) as usize] }
        if vkx0[(i) as usize] > maxx { maxx = vkx0[(i) as usize] }
        if vkx1[(i) as usize] > maxx { maxx = vkx1[(i) as usize] }
        i = i + 1
    }
    let by0: i64 = miny >> 6
    let by1: i64 = (maxy + 63) >> 6
    let bx0: i64 = minx >> 6
    let bx1: i64 = (maxx + 63) >> 6
    let breite: i64 = bx1 - bx0
    if breite <= 0 || breite > 4096 {
        return
    }
    var py: i64 = by0
    while py < by1 {
        // Die Deckung dieser Zeile, 0..16 je Bildpunkt. Auf dem Stapel,
        // damit die Bibliothek keinen weiteren festen Puffer braucht.
        var cov: [u8; 4096] = [0 as u8; 4096]
        var sub: i64 = 0
        while sub < 4 {
            let ys: i64 = py * 64 + 8 + sub * 16
            var n: u64 = 0
            i = 0
            while i < vkn {
                let ay: i64 = vky0[(i) as usize]
                let by: i64 = vky1[(i) as usize]
                var lo: i64 = ay
                var hi: i64 = by
                var dir: i64 = 1
                if ay > by {
                    lo = by
                    hi = ay
                    dir = 0 - 1
                }
                if ys >= lo && ys < hi {
                    let ax: i64 = vkx0[(i) as usize]
                    let bx: i64 = vkx1[(i) as usize]
                    n = v_cross_add(n, ax + vrdiv((bx - ax) * (ys - ay),
                        by - ay), dir)
                }
                i = i + 1
            }
            var wind: i64 = 0
            var anfang: i64 = 0
            var j: u64 = 0
            while j < n {
                let xs: i64 = vcx[(j) as usize]
                let vorher: i64 = wind
                wind = wind + vcd[(j) as usize]
                if vorher == 0 && wind != 0 {
                    anfang = xs
                }
                if vorher != 0 && wind == 0 {
                    var j0: i64 = (anfang - 8 + 15) >> 4
                    var j1: i64 = (xs - 8 + 15) >> 4
                    if j0 < bx0 * 4 {
                        j0 = bx0 * 4
                    }
                    if j1 > bx1 * 4 {
                        j1 = bx1 * 4
                    }
                    var k: i64 = j0
                    while k < j1 {
                        let c: i64 = (k >> 2) - bx0
                        if c >= 0 && c < breite {
                            cov[(c) as usize] = cov[(c) as usize] + 1 as u8
                        }
                        k = k + 1
                    }
                }
                j = j + 1
            }
            sub = sub + 1
        }
        if py >= 0 {
            var c: i64 = 0
            while c < breite {
                let v: u64 = cov[(c) as usize] as u64
                if v > 0 {
                    var a: u64 = v
                    if a > 16 {
                        a = 16
                    }
                    let deck: u64 = (a * 255 + 8) / 16
                    let xx: i64 = bx0 + c
                    if xx >= 0 {
                        let ux: u64 = xx as u64
                        let uy: u64 = py as u64
                        px(ux, uy, blend(get(ux, uy), farbe, deck))
                    }
                }
                c = c + 1
            }
        }
        py = py + 1
    }
}

// ------------------------------------------------- WAS DIE WIDGETS RUFEN

// Ein gefuelltes Rechteck mit ECHTEM Eckradius, in Bildpunkten.
fn vrect(x: u64, y: u64, w: u64, h: u64, r: u64, farbe: u64) {
    if w == 0 || h == 0 {
        return
    }
    v_new()
    v_rundeck((x as i64) * V_EINS, (y as i64) * V_EINS,
        (w as i64) * V_EINS, (h as i64) * V_EINS, (r as i64) * V_EINS)
    v_fuellen(farbe)
}

// EIN KREIS -- der runde Reglergriff, den es bis hierher nicht gab.
fn vkreis(cx: u64, cy: u64, r: u64, farbe: u64) {
    if r == 0 {
        return
    }
    v_new()
    v_ellipse((cx as i64) * V_EINS, (cy as i64) * V_EINS,
        (r as i64) * V_EINS, (r as i64) * V_EINS)
    v_fuellen(farbe)
}

// Ein Ring: aussen minus innen, ueber die Fuellregel. Beide Umrisse
// laufen in DERSELBEN Richtung, deshalb hebt die Nichtnull-Windung den
// inneren nicht auf -- er wird rueckwaerts gelegt.
fn vring(cx: u64, cy: u64, r: u64, dick: u64, farbe: u64) {
    if r == 0 || dick == 0 || dick >= r {
        return
    }
    v_new()
    v_ellipse((cx as i64) * V_EINS, (cy as i64) * V_EINS,
        (r as i64) * V_EINS, (r as i64) * V_EINS)
    // der innere Kreis, gegen den Uhrzeigersinn
    let ri: i64 = ((r - dick) as i64) * V_EINS
    let mx: i64 = (cx as i64) * V_EINS
    let my: i64 = (cy as i64) * V_EINS
    v_move_to(mx, my - ri)
    v_bogen(mx, my - ri, mx - ri, my - ri, mx - ri, my)
    v_bogen(mx - ri, my, mx - ri, my + ri, mx, my + ri)
    v_bogen(mx, my + ri, mx + ri, my + ri, mx + ri, my)
    v_bogen(mx + ri, my, mx + ri, my - ri, mx, my - ri)
    v_close_path()
    v_fuellen(farbe)
}

// A FILLED RECTANGLE WITH ROUNDED CORNERS.
//
// r == 0 is the old `rect`, call for call, and that is not an
// optimisation -- it is the promise that `classic` is bit-identical to
// what this system drew before the round.
//
// ================================================== RUNDE VEKTOR
// WARUM DIESE FUNKTION *NICHT* AUF `vrect` UMGESTELLT WURDE.
//
// Der naheliegende Schritt waere, hier `vrect` zu rufen und damit
// alles ueber einen Rasterer laufen zu lassen. Nachgemessen ist das
// eine VERSCHLECHTERUNG, und deshalb steht es nicht da.
//
// Ein Viertelkreis als kubische Bezier liegt immer ein wenig INNEN;
// `corner_cov` tastet dagegen den echten Kreis ab. Flaeche gegen die
// Formel w*h - (4-pi)*r^2, gemessen:
//
//   40x24 r=6    soll  929.10   corner_cov -0.39   Bezier -0.60
//   64x64 r=16   soll 3876.25   corner_cov +1.31   Bezier -2.76
//   48x48 r=24   soll 1809.56   corner_cov +0.69   Bezier -7.13
//   100x30 r=8   soll 2945.06   corner_cov +0.60   Bezier -0.84
//
// Der Bezierfehler liegt bei 0.4 Prozent der Flaeche und waechst mit
// dem Quadrat des Radius. Das sieht niemand -- aber es waere Arbeit
// mit einem schlechteren Ergebnis, und das ist kein Fortschritt.
//
// DIE REGEL, DIE DARAUS FOLGT: die runde Ecke eines Rechtecks bleibt
// bei `corner_cov`; `vrect`/`vkreis` sind fuer das da, was
// `corner_cov` NICHT kann -- Kreise, Ringe, Striche, Diagonalen,
// beliebige Umrisse. Beide rechnen in derselben Art (4x4-
// Unterabtastung, Deckung (cov*255+8)/16), also passen ihre Kanten
// zusammen, wo sie aneinanderstossen.
fn rrect(x: u64, y: u64, w: u64, h: u64, r0: u64, color: u64) {
    if w == 0 || h == 0 {
        return
    }
    var r: u64 = r0
    if r > RADIUS_MAX {
        r = RADIUS_MAX
    }
    if r * 2 > w {
        r = w / 2
    }
    if r * 2 > h {
        r = h / 2
    }
    if r == 0 {
        rect(x, y, w, h, color)
        return
    }
    // the middle band, full width
    rect(x, y + r, w, h - 2 * r, color)
    // the two straight parts of the top and bottom bands
    rect(x + r, y, w - 2 * r, r, color)
    rect(x + r, y + h - r, w - 2 * r, r, color)
    // and the four corners
    var dy: u64 = 0
    while dy < r {
        var dx: u64 = 0
        while dx < r {
            let cov: u64 = corner_cov(r - 1 - dx, r - 1 - dy, r)
            if cov != 0 {
                let x0: u64 = x + dx
                let y0: u64 = y + dy
                let x1: u64 = x + w - 1 - dx
                let y1: u64 = y + h - 1 - dy
                px(x0, y0, blend(get(x0, y0), color, cov))
                px(x1, y0, blend(get(x1, y0), color, cov))
                px(x0, y1, blend(get(x0, y1), color, cov))
                px(x1, y1, blend(get(x1, y1), color, cov))
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

// THE OUTLINE OF THE SAME SHAPE, `bw` pixels thick.
//
// Drawn as two filled shapes and not as a traced curve: fill the outer
// rounded rectangle in the border colour, then fill the inner one back
// in the surface colour. That is four `rrect` corners' worth of
// sampling instead of a second, differently-rounded arc -- and, more to
// the point, the inner curve is then guaranteed concentric with the
// outer one, which a traced curve is not.
// A BOX: an outline `bw` pixels thick in `color`, and the inside filled
// with `inner`.
//
// THE FAST PATH FILLS TOO, and the first version of it did not. That was
// a real regression and tools/k15/run.sh caught it: `rect` + `frame` had
// always been two calls, this replaced them with one, and at radius 0 the
// one drew only the outline. Seven pixel checks in round K15 went red --
// a text field with no face, a list with no background, and four rows of
// text measured against the wrong colour behind them. The lesson is the
// one this repository keeps relearning: a shortcut that "is the same
// thing" has to be the same thing in EVERY branch of itself.
//
// For a pure ring with nothing filled -- a focus ring over a control
// that is already painted -- use `rring`.
fn rframe(x: u64, y: u64, w: u64, h: u64, r: u64, bw: u64, color: u64,
    inner: u64) {
    if w < 2 || h < 2 || bw == 0 {
        return
    }
    if r == 0 && bw == 1 {
        rect(x + 1, y + 1, w - 2, h - 2, inner)
        frame(x, y, w, h, color)
        return
    }
    var b: u64 = bw
    if b * 2 >= w || b * 2 >= h {
        b = 1
    }
    rrect(x, y, w, h, r, color)
    var ri: u64 = 0
    if r > b {
        ri = r - b
    }
    rrect(x + b, y + b, w - 2 * b, h - 2 * b, ri, inner)
}

// AN OUTLINE AND NOTHING ELSE -- what is inside it is left alone.
//
// A focus ring goes on top of a control that has already been painted,
// so it cannot be "two filled shapes" the way `rframe` is: the second
// shape would erase the control. Four straight bars and four corner
// arcs, and the arcs are the same coverage sampler the filled corners
// use, so a ring and a face of the same radius are concentric.
fn rring(x: u64, y: u64, w: u64, h: u64, r0: u64, bw: u64, color: u64) {
    if w < 2 || h < 2 || bw == 0 {
        return
    }
    var r: u64 = r0
    if r > RADIUS_MAX {
        r = RADIUS_MAX
    }
    if r * 2 > w {
        r = w / 2
    }
    if r * 2 > h {
        r = h / 2
    }
    if r == 0 {
        // RUNDE ECHTHARDWARE-2: derselbe Fehler wie in `drop_shadow`,
        // eine Schleife weiter. `w - 2 * k` laeuft unter null, sobald
        // der Ring breiter ist als das halbe Bedienelement -- bei
        // uiscale=2 ist `bw` doppelt so breit, das Element aber nicht
        // zwangslaeufig. Es wird abgebrochen statt gerechnet: ein Ring,
        // fuer den kein Platz mehr ist, wird nicht gemalt.
        var k: u64 = 0
        while k < bw && 2 * k < w && 2 * k < h {
            frame(x + k, y + k, w - 2 * k, h - 2 * k, color)
            k = k + 1
        }
        return
    }
    // the four straight runs, stopping short of the corners
    rect(x + r, y, w - 2 * r, bw, color)
    rect(x + r, y + h - bw, w - 2 * r, bw, color)
    rect(x, y + r, bw, h - 2 * r, color)
    rect(x + w - bw, y + r, bw, h - 2 * r, color)
    // and the four arcs: a pixel belongs to the ring when it is inside
    // the outer circle and outside the inner one.
    var ri: u64 = 0
    if r > bw {
        ri = r - bw
    }
    var dy: u64 = 0
    while dy < r {
        var dx: u64 = 0
        while dx < r {
            let a: u64 = corner_cov(r - 1 - dx, r - 1 - dy, r)
            var b: u64 = 0
            if ri > 0 {
                b = corner_cov(r - 1 - dx, r - 1 - dy, ri)
            }
            var cov: u64 = 0
            if a > b {
                cov = a - b
            }
            if cov != 0 {
                let x0: u64 = x + dx
                let y0: u64 = y + dy
                let x1: u64 = x + w - 1 - dx
                let y1: u64 = y + h - 1 - dy
                px(x0, y0, blend(get(x0, y0), color, cov))
                px(x1, y0, blend(get(x1, y0), color, cov))
                px(x0, y1, blend(get(x0, y1), color, cov))
                px(x1, y1, blend(get(x1, y1), color, cov))
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

// A SOFT DROP SHADOW UNDER A RECTANGLE.
//
// Not a blur -- a blur needs a second buffer and two passes over it, and
// this library paints into an 800 x 81 band. What it does instead is
// draw `n` nested outlines, each one pixel further out and each weaker
// than the last, in the shadow colour. That is a linear falloff instead
// of a Gaussian one; at the four to six pixels a window shadow actually
// uses, the difference is not visible and the cost is n outlines
// instead of a convolution.
//
// `strength` is 0..100 and 0 draws nothing at all -- which is what
// `classic` asks for, so classic pays nothing.
// ================================================ RUNDE ECHTHARDWARE-2
//
// `x - i` WAR JUSTINS PANIC -- DIE, DIE ER ZWEIMAL FOTOGRAFIERT HAT.
//
// Auf seinem Foto steht
//
//     panic: integer overflow in 'u64 - u64'
//            at kernel/user/wlib.fi:969:25
//
// und diese Angabe fuehrt in die Irre: die Datei heisst `wlibc.fi` und
// nicht `wlib.fi`, und die Zeile ist 970. Beides ist kein Lesefehler
// von ihm -- die serielle Leitung schreibt die Meldung MITTEN in eine
// andere Zeile hinein, weil zwei Prozesse gleichzeitig schreiben:
//
//     taskbar: field panic: integer overflow in 'u64 - u64'
//              at kernel/user/wlibc.fi:970:25net x=2012 y=8 w=248 ...
//
// Wer das abliest, liest `wlib` und eine Zahl daneben. NACHGESTELLT in
// dieser Runde (pruef/einst.py, Lauf einst1): Spalte 25 der Zeile 970
// ist woertlich `x - i`.
//
// WAS PASSIERT. `drop_shadow` malt `reach` Ringe UM ein Fenster, jeder
// einen Bildpunkt weiter aussen. Der linke Rand des Ringes liegt bei
// `x - i`. Steht das Fenster naeher als `reach` am linken Schirmrand --
// bei x=0 also immer --, ist das in `u64` keine negative Zahl, sondern
// eine in der Naehe von 2^64, und der Kern erschlaegt den Prozess.
//
// WARUM ES ERST JETZT ZUSCHLUG: Schatten gibt es nur unter `shape=osum`
// (unter `classic` ist `strength` 0 und die Funktion kehrt sofort um),
// und `shape=osum` bringt der Stick erst seit Runde ECHTHARDWARE-1 mit.
// Getroffen hat es die EINSTELLUNGEN, weil deren Fenster als erstes
// gross genug ist, um am Rand zu stehen.
//
// DIE WURZEL UND NICHT DIE STELLE: es wird nicht nur hier abgefangen,
// sondern es gibt jetzt `sub()` in dieser Datei -- dieselbe saettigende
// Subtraktion, die `wlib.fi` seit Langem hat. Ein Ring, der links oder
// oben aus dem Schirm ragt, wird BESCHNITTEN und nicht verschoben:
// wuerde man ihn nur nach rechts ruecken, saesse der Schatten schief
// unter dem Fenster.
fn sub(a: u64, b: u64) -> u64 {
    if b >= a {
        return 0
    }
    return a - b
}

fn drop_shadow(x: u64, y: u64, w: u64, h: u64, r: u64, strength: u64,
    reach: u64, color: u64) {
    if strength == 0 || reach == 0 || w == 0 || h == 0 {
        return
    }
    var i: u64 = reach
    while i > 0 {
        // the outermost ring is the weakest
        let a: u64 = strength * 255 / 100 * (reach + 1 - i) / (reach + 1)
        if a != 0 {
            // A SHADOW SITS BELOW ITS WINDOW AND NOT AROUND IT. One
            // pixel of downward offset per ring is what every system
            // that draws one does, and it is what makes the thing read
            // as "above" instead of "glowing".
            //
            // RUNDE ECHTHARDWARE-2: links und oben gesaettigt. Was
            // ueber den Rand hinausragt, wird von der Breite bzw. der
            // Hoehe abgezogen -- der Ring endet am Schirmrand, statt
            // um 2^64 zu springen.
            let lx: u64 = sub(x, i)
            let fehlt_x: u64 = sub(i, x)
            let oy: u64 = y + 1
            var ly: u64 = 0
            if oy > i {
                ly = oy - i
            }
            let fehlt_y: u64 = sub(i, oy)
            shadow_edge(lx, ly, sub(w + 2 * i, fehlt_x),
                sub(h + 2 * i, fehlt_y), r + i, color, a)
        }
        i = i - 1
    }
}

// EIN UMRISS VON EINEM BILDPUNKT, GEMISCHT -- und die Berichtigung
// eines Fehlers, den erst diese Runde sichtbar gemacht hat.
//
// WAS HIER STAND. `drop_shadow` hat jeden seiner Ringe als `rframe`
// gemalt, und zwar mit DERSELBEN Farbe fuer den Rand UND fuer das
// Innere:
//
//     rframe(ox, oy, w + 2i, h + 2i, r + i, 1, c, c)
//
// `rframe` fuellt das Innere -- das ist seine Aufgabe und steht so in
// seinem eigenen Kommentar. Der "Schatten" war also ein VOLL GEFUELLTES
// Rechteck in Schattenfarbe, und er ist nur deshalb nie aufgefallen,
// weil sein einziger Aufrufer (die Vorschaukachel aus Runde THEMESTORE)
// unmittelbar danach ein Fenster darueber gemalt hat. Die Karte dieser
// Runde tut das nicht -- sie ist kleiner als ihr Schatten --, und das
// Bild kam mit einer schwarzen Flaeche statt einer Fensteroberflaeche
// heraus. Gemessen: die Fensterflaeche neben der Karte war (0, 0, 1)
// statt (248, 250, 252).
//
// ZWEITER FEHLER IN DERSELBEN ZEILE. Die Farbe wurde EINMAL aus EINEM
// Bildpunkt am linken Rand gemischt (`blend(get(ox, oy + h/2), ...)`)
// und dann ueberall hingeschrieben. Ein Schatten, der ueber zwei
// verschiedene Untergruende laeuft, hatte damit auf beiden dieselbe
// Farbe -- also auf einem der beiden die falsche.
//
// Beides ist hier behoben: EIN Bildpunkt breit, nichts gefuellt, und
// jeder Bildpunkt einzeln gegen DAS gemischt, was unter IHM liegt.
fn shadow_edge(x: u64, y: u64, w: u64, h: u64, r0: u64, color: u64,
    a: u64) {
    if w < 2 || h < 2 || a == 0 {
        return
    }
    var r: u64 = r0
    if r > RADIUS_MAX {
        r = RADIUS_MAX
    }
    if r * 2 > w {
        r = w / 2
    }
    if r * 2 > h {
        r = h / 2
    }
    // die vier geraden Stuecke
    var c: u64 = r
    while c < w - r {
        let x0: u64 = x + c
        px(x0, y, blend(get(x0, y), color, a))
        px(x0, y + h - 1, blend(get(x0, y + h - 1), color, a))
        c = c + 1
    }
    var q: u64 = r
    while q < h - r {
        let y0: u64 = y + q
        px(x, y0, blend(get(x, y0), color, a))
        px(x + w - 1, y0, blend(get(x + w - 1, y0), color, a))
        q = q + 1
    }
    if r == 0 {
        return
    }
    // und die vier Boegen, mit derselben Deckung wie `rring`
    var innen: u64 = 0
    if r > 1 {
        innen = r - 1
    }
    var dy: u64 = 0
    while dy < r {
        var dx: u64 = 0
        while dx < r {
            let aussen: u64 = corner_cov(r - 1 - dx, r - 1 - dy, r)
            var i2: u64 = 0
            if innen > 0 {
                i2 = corner_cov(r - 1 - dx, r - 1 - dy, innen)
            }
            var cov: u64 = 0
            if aussen > i2 {
                cov = aussen - i2
            }
            if cov != 0 {
                let d: u64 = cov * a / 255
                let x0: u64 = x + dx
                let y0: u64 = y + dy
                let x1: u64 = x + w - 1 - dx
                let y1: u64 = y + h - 1 - dy
                px(x0, y0, blend(get(x0, y0), color, d))
                px(x1, y0, blend(get(x1, y0), color, d))
                px(x0, y1, blend(get(x0, y1), color, d))
                px(x1, y1, blend(get(x1, y1), color, d))
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

// A SEPARATING LINE AT THE OPACITY THE SHAPE ASKS FOR.
//
// `classic` says 100 and gets the same hard `hline` it always got.
// `modern` says 45, and the line is mixed into what is under it -- which
// is the single biggest reason a modern interface reads as calm: the
// lines are still there, they are just not shouting.
fn divider(x: u64, y: u64, w: u64, color: u64) {
    let o: u64 = met[(M_DIVIDER) as usize]
    if o == 0 {
        return
    }
    if o >= 100 {
        hline(x, y, w, color)
        return
    }
    let a: u64 = o * 255 / 100
    var c: u64 = 0
    while c < w {
        px(x + c, y, blend(get(x + c, y), color, a))
        c = c + 1
    }
}

// ------------------------------------------------- der Glyphenspeicher
//
// Der Kernel rastert und speichert zwischen (`kernel/ttf.fi`); DIESER
// Speicher hier spart den SYSTEMAUFRUF. Ohne ihn kostet jede Textzeile
// je Zeichen einen Aufruf samt Kopie des Deckungsfeldes -- bei sechs
// Streifen je Neuzeichnen sechsmal. Mit ihm kostet ein Zeichen den
// Aufruf genau einmal im ganzen Programmlauf.
//
// Offene Adressierung mit linearem Sondieren, wie im Kernel. Der
// Schluessel traegt Schrift, Groesse und Zeichen. Freigegeben wird
// nichts.

const GC_SLOTS: u64 = 512
const GC_KEY: u64 = 0
const GC_W: u64 = 1
const GC_H: u64 = 2
const GC_L: u64 = 3
const GC_T: u64 = 4
const GC_ADV: u64 = 5
const GC_DATA: u64 = 6
const GC_FIELDS: u64 = 8

static mut gc: [u64; 4096] = [0 as u64; 4096]
static mut gc_used: u64 = 0
static mut gc_calls: u64 = 0
static mut gbuf: [u8; 2048] = [0 as u8; 2048]

// RUNDE I18N: DER SCHLUESSEL WURDE BREITER. Er trug `c & 0xFFFF`, also
// sechzehn Bit -- genug fuer ein Oktett, genug fuer die
// mehrsprachige Ebene, und zu wenig fuer einen Codepunkt: Unicode
// reicht bis U+10FFFF, das sind einundzwanzig Bit. Mit der alten Maske
// haetten sich U+1F600 und U+F600 denselben Platz im Zwischenspeicher
// geteilt und waeren als DASSELBE Zeichen gemalt worden. Jetzt:
// vierundzwanzig Bit fuer den Codepunkt, acht fuer die Groesse, der
// Rest fuer die Schrift -- dieselbe Aufteilung wie in `ttf.key_of` im
// Kernel, damit beide Speicher dasselbe Zeichen unter derselben Zahl
// fuehren.
// ROUND MERGE: `& RGB24` and not `& 0xFFFFFF`. It is a codepoint mask
// and not a colour, and tests/theme/rawcolour.py cannot tell the two
// apart -- which is why RGB24 has a name in the first place (see the
// header of that script, and the same reasoning in kernel/wm.fi).
fn gkey(f: u64, px_: u64, c: u64) -> u64 {
    return (f << 32) | ((px_ & 0xFF) << 24) | (c & RGB24)
        | 0x8000000000000000
}

fn ghash(k: u64) -> u64 {
    var h: u64 = k *% 1099511628211
    h = h ^ (h >> 29)
    return h % GC_SLOTS
}

fn gfind(f: u64, px_: u64, c: u64) -> u64 {
    let k: u64 = gkey(f, px_, c)
    var i: u64 = ghash(k)
    var n: u64 = 0
    while n < GC_SLOTS {
        let at: u64 = i * GC_FIELDS
        if gc[(at + GC_KEY) as usize] == k {
            return at
        }
        if gc[(at + GC_KEY) as usize] == 0 {
            return gload(at, f, px_, c, k)
        }
        i = (i + 1) % GC_SLOTS
        n = n + 1
    }
    return 0xFFFFFFFFFFFFFFFF
}

// Die groesste Glyphe, die der Rasterer im Kern ueberhaupt hergibt --
// `ttf.MAX_W` und `ttf.MAX_H`. Steht hier als Zahl, weil Ring 3 die
// Konstanten des Kerns nicht einbindet; laeuft sie auseinander, faellt
// das im Prueflauf auf und nicht im Betrieb.
const GMAX: u64 = 256
// =========================== RUNDE CERTUS-AUF-OSUM: DER GLYPHENSPEICHER
//
// Bis zu dieser Runde kam der Speicher fuer die Glyphenbilder aus
// `libc.mem` -- dem brk-Allokator der libc. Das war richtig und ist es
// geblieben; was sich geaendert hat, ist der NAME. Firn fuehrt Module am
// Kurznamen (`compiler/src/modules.rs`), und der Browser Certus, der
// diese Bibliothek seit dieser Runde in EINEM Programm mit seinen
// eigenen Modulen bindet, hat ein Modul `html.mem`. Zwei Module namens
// `mem` in einem Programm: der erste Treffer gewinnt STILL, und das
// zweite ruft danach Funktionen, die es nicht gibt (docs/RUNDE-EINKERN.md
// in Certus hat genau das gemessen).
//
// Also holt sich diese Bibliothek den Glyphenspeicher selbst: 64-KiB-
// Stuecke aus `mmap` -- derselbe Weg, auf dem oben schon die Malflaeche
// kommt (`map_surface`) -- und ein Zeiger, der darin nach vorn laeuft.
// Glyphen werden nie freigegeben (das war mit libc.mem nicht anders:
// es gab kein `release` in dieser Datei), also braucht es keine Liste.
// Ein Glyph ist hoechstens 2000 Oktette gross (`gbuf`); 64 KiB fassen
// davon dreissig, und die 512 Plaetze der Tafel oben brauchen im
// schlimmsten Fall sechzehn Stuecke.
static mut g_arena: u64 = 0
static mut g_arena_rest: u64 = 0
const G_CHUNK: u64 = 65536

fn gmem(n: u64) -> u64 {
    let m: u64 = (n + 15) & ~15
    if m > G_CHUNK {
        return 0
    }
    if g_arena == 0 || g_arena_rest < m {
        let p: u64 = map_surface(G_CHUNK)
        if ulib.bad(p) || p == 0 {
            return 0
        }
        g_arena = p
        g_arena_rest = G_CHUNK
    }
    let r: u64 = g_arena
    g_arena = g_arena + m
    g_arena_rest = g_arena_rest - m
    return r
}

fn gload(at: u64, f: u64, px_: u64, c: u64, k: u64) -> u64 {
    let n: u64 = sys5(WIG_GLYPH, f, px_, c, (&gbuf[0 as usize]) as u64,
        2048)
    if ulib.bad(n) || n < 48 {
        return 0xFFFFFFFFFFFFFFFF
    }
    gc_calls = gc_calls + 1
    let b: u64 = (&gbuf[0 as usize]) as u64
    let gw: u64 = __mmio_read64((b + 0) as *mut u64)
    let gh: u64 = __mmio_read64((b + 8) as *mut u64)
    // ================================================== RUNDE GLYPHE
    // DER KOPF WIRD GEPRUEFT, BEVOR MIT IHM GERECHNET WIRD.
    //
    // `gw * gh` ist eine u64-Multiplikation, und Firn faengt ihren
    // Ueberlauf mit einem Panic ab. Das ist die Zeile, an der in Runde
    // MERGE-6 der Aufgabenverwalter starb -- eine Zeile nach
    // `taskmgr: start`, in einem von fuenf Laeufen mit vier Kernen:
    //
    //   panic: integer overflow in 'u64 * u64' at wlibc.fi:1128:8
    //
    // DIE URSACHE LAG IM KERN und ist behoben (`wig.stage_of`, eine
    // Buehne je Kern): im Kopf stand die Breite des einen Zeichens und
    // dahinter die Bildpunkte des anderen. NACHGERECHNET: mit sauberen
    // Werten kann die Rechnung NICHT ueberlaufen -- der Rasterer
    // liefert hoechstens 256 x 256 (`ttf.MAX_W`/`MAX_H`), und der
    // Umschlag ist 2048 Oktett gross. Diese drei Vergleiche sind
    // deshalb kein Ersatz fuer die Reparatur, sondern der zweite
    // Riegel: ein Kopf, der nicht zu der gemeldeten Laenge passt, wird
    // VERWORFEN statt multipliziert. Die Laengenprobe kommt ohne
    // Multiplikation aus (Division statt Produkt).
    if gw > GMAX || gh > GMAX {
        return 0xFFFFFFFFFFFFFFFF
    }
    if gw != 0 && gh > (n - 48) / gw {
        return 0xFFFFFFFFFFFFFFFF
    }
    gc[(at + GC_KEY) as usize] = k
    gc[(at + GC_W) as usize] = gw
    gc[(at + GC_H) as usize] = gh
    gc[(at + GC_L) as usize] = __mmio_read64((b + 16) as *mut u64)
    gc[(at + GC_T) as usize] = __mmio_read64((b + 24) as *mut u64)
    gc[(at + GC_ADV) as usize] = __mmio_read64((b + 32) as *mut u64)
    gc[(at + GC_DATA) as usize] = 0
    if gw * gh > 0 {
        let p: u64 = gmem(gw * gh)
        if p != 0 {
            ulib.copy(p, b + 48, gw * gh)
            gc[(at + GC_DATA) as usize] = p
        } else {
            gc[(at + GC_W) as usize] = 0
            gc[(at + GC_H) as usize] = 0
        }
    }
    gc_used = gc_used + 1
    return at
}

fn kern26(f: u64, px_: u64, c1: u64, c2: u64) -> i64 {
    return sys5(WIG_KERN, f, px_, c1, c2, 0) as i64
}

// EINE GLYPHE AUF DIE FLAECHE, in der Farbe, die der Aufrufer will --
// und auf den Beschnitt beschnitten. Genau `wm.draw_glyph_clip`, nur in
// Ring 3 und mit einer Farbe je Widget statt einer je Fenster.
fn draw_glyph(at: u64, x: i64, y: i64, color: u64) {
    let gw: u64 = gc[(at + GC_W) as usize]
    let gh: u64 = gc[(at + GC_H) as usize]
    let data: u64 = gc[(at + GC_DATA) as usize]
    if gw == 0 || gh == 0 || data == 0 {
        return
    }
    let x0: i64 = x + gc[(at + GC_L) as usize] as i64
    let y0: i64 = y - gc[(at + GC_T) as usize] as i64
    var r: u64 = 0
    while r < gh {
        let py: i64 = y0 + r as i64
        if py >= 0 {
            var c: u64 = 0
            while c < gw {
                let pxx: i64 = x0 + c as i64
                if pxx >= 0 {
                    let a: u64 = (*((data + r * gw + c) as *mut u8)) as u64
                    if a != 0 {
                        let ux: u64 = pxx as u64
                        let uy: u64 = py as u64
                        px(ux, uy, blend(get(ux, uy), color, a))
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

// Eine Zeile Text. `y` ist die GRUNDLINIE. Gibt die Stelle HINTER dem
// Text zurueck, damit ein Aufrufer zwei Stuecke aneinandersetzen kann.
//
// DIE REIHENFOLGE IST DIE VON `wm.text` UND VON
// `tools/ttf/raster.py stellen`: Unterschneidung VOR dem Zeichen,
// Laufweite DANACH, und gemalt wird bei `cx >> 6`. Wer eines davon
// vertauscht, hat eine Oberflaeche, deren Text sich nicht mehr gegen
// die zweite Rasterung rechnen laesst.
//
// RUNDE I18N: EIN DURCHLAUF JE ZEICHEN. Vorher las die Schleife ein
// Oktett, fragte den Kernel nach der Glyphe dieses Oktetts und schob den
// Zeiger um eins weiter. Fuer "Aufloesung" mit echtem Umlaut heisst das:
// 0xC3 und 0xB6 einzeln, zwei Glyphen, die keine Schrift hat, also zwei
// Leerraeume -- und der Text ist auch noch zu breit, weil zweimal eine
// Laufweite dazukam.
fn text_at(f: u64, px_: u64, x: u64, y: u64, p: u64, n: u64,
    color: u64) -> u64 {
    var cx: i64 = (x as i64) * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = n
        } else {
            if vorher != 0 {
                cx = cx + kern26(f, px_, vorher, c)
            }
            let at: u64 = gfind(f, px_, c)
            if at != 0xFFFFFFFFFFFFFFFF {
                draw_glyph(at, cx >> 6, y as i64, color)
                cx = cx + gc[(at + GC_ADV) as usize] as i64
            }
            vorher = c
            k = k + l
        }
    }
    return (cx >> 6) as u64
}

// Dieselbe Rechnung OHNE zu malen -- fuer die Anordnung, fuer das
// Mittigsetzen und fuer die Stelle, an der eine Einfuegemarke steht.
fn text_w(f: u64, px_: u64, p: u64, n: u64) -> u64 {
    var cx: i64 = 0
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = n
        } else {
            if vorher != 0 {
                cx = cx + kern26(f, px_, vorher, c)
            }
            let at: u64 = gfind(f, px_, c)
            if at != 0xFFFFFFFFFFFFFFFF {
                cx = cx + gc[(at + GC_ADV) as usize] as i64
            }
            vorher = c
            k = k + l
        }
    }
    return (cx >> 6) as u64
}

// ---------------------------------------------- RUNDE I18N: UMBRECHEN
//
// WER TEXT ABSCHNEIDET, MUSS AN EINER ZEICHENGRENZE ABSCHNEIDEN. Das
// klingt selbstverstaendlich und war es bis heute nicht: `wlib.fi`
// kuerzt eine zu lange Zeile, indem es die Laenge um eins verringert,
// bis sie passt (`while cl > 0 && text_w(...) > ...`). Ein Oktett
// weniger heisst bei einem Umlaut: die ERSTE Haelfte des Zeichens bleibt
// stehen. Das ist keine gekuerzte Zeichenkette mehr, das ist eine
// kaputte -- und `text_at` malt dafuer ein Ersatzzeichen.
//
// Diese beiden Funktionen sind die Antwort. `back` geht von `k` aus
// EIN Zeichen zurueck, `fit` sagt, wieviele OKTETTE hoechstens passen,
// ohne ein Zeichen zu zerteilen.

// Der Anfang des Zeichens VOR dem Oktett `k`. Sucht rueckwaerts das
// naechste Oktett, das keine Fortsetzung (10xxxxxx) ist -- hoechstens
// vier Schritte, denn laenger ist keine Folge.
fn back(p: u64, k: u64) -> u64 {
    if k == 0 {
        return 0
    }
    var i: u64 = k - 1
    var n: u64 = 0
    while n < 3 {
        if ((*((p + i) as *mut u8)) as u64 & 0xC0) != 0x80 {
            return i
        }
        if i == 0 {
            return 0
        }
        i = i - 1
        n = n + 1
    }
    return i
}

// Wieviele der `n` Oktette passen in `breite` Bildpunkte, ohne ein
// Zeichen zu zerschneiden? Gibt eine Laenge in OKTETTEN zurueck, die
// immer auf einer Zeichengrenze endet.
fn fit(f: u64, px_: u64, p: u64, n: u64, breite: u64) -> u64 {
    var cx: i64 = 0
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            return k
        }
        if vorher != 0 {
            cx = cx + kern26(f, px_, vorher, c)
        }
        let at: u64 = gfind(f, px_, c)
        if at != 0xFFFFFFFFFFFFFFFF {
            cx = cx + gc[(at + GC_ADV) as usize] as i64
        }
        if (cx >> 6) as u64 > breite {
            return k
        }
        vorher = c
        k = k + l
    }
    return n
}

// Wieviele ZEICHEN in `n` Oktetten stehen. Ein Textfeld zaehlt damit
// seine Einfuegemarke, statt Oktette zu zaehlen.
fn chars(p: u64, n: u64) -> u64 {
    return utf8.chars(p, n)
}

fn glyph_w(f: u64, px_: u64, c: u64) -> u64 {
    let at: u64 = gfind(f, px_, c)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return (gc[(at + GC_ADV) as usize] as i64 >> 6) as u64
}

// Der Aufsteiger der Schrift in Bildpunkten -- die Strecke von der
// Oberkante einer Zeile bis zur Grundlinie. Gemessen am Zeichen, das
// die Oberkante bestimmt, statt geraten: `M` reicht bis zur
// Versalhoehe, `l` und `k` bis zum Aufsteiger.
fn ascent_of(f: u64, px_: u64) -> u64 {
    let at: u64 = gfind(f, px_, 108)
    if at == 0xFFFFFFFFFFFFFFFF {
        return px_
    }
    return gc[(at + GC_T) as usize]
}

fn text_h(px_: u64) -> u64 {
    return px_ + px_ / 4
}

// Die Zellenbreite der Festbreitenschrift: die Laufweite von `0`,
// aufgerundet. Genau die Rechnung, mit der `wm.term_setup` sein Raster
// legt -- ein Dateimanager, der eine Spalte aus Ziffern setzt, will
// dieselbe.
fn mono_cell(px_: u64) -> u64 {
    let at: u64 = gfind(F_MONO, px_, 48)
    if at == 0xFFFFFFFFFFFFFFFF {
        return px_
    }
    return ((gc[(at + GC_ADV) as usize] as i64 + 63) >> 6) as u64
}

// ------------------------------------------------- hinueber ins Fenster

// EIN STREIFEN, EIN AUFRUF. `x` und `y` sind Fensterkoordinaten, die
// Quelle ist die Flaeche mit ihrer eigenen Zeilenlaenge.
//
// ==================================================== RUNDE UHRWERK
// HIER STAND JUSTINS STEHENDE UHR, UND SIE STAND AN EINER
// RECHNUNG, DIE NUR AUF BREITEN SCHIRMEN SCHIEFGEHT.
//
// Die Zeichenflaeche ist ein STREIFEN mit festem Platzbedarf
// (`SURF_BUDGET` = 1 MiB). Wie viele BILDZEILEN das sind, haengt an der
// Breite des Schirms:
//
//     1920 -> 136 Zeilen      2560 -> 102 Zeilen
//     3440 ->  76 Zeilen      3840 ->  68 Zeilen
//
// Die Taskleiste malt in EINEM Band von `BAND` = 80 Zeilen (bei
// height=40 und Skala 2). Auf 1920 und 2560 passt das. AUF JUSTINS
// 3440x1440 PASST ES NICHT: 80 angeforderte Zeilen gegen 76
// abgebildete.
//
// Was dann geschah, war schlimmer als ein abgeschnittener Streifen.
// `push` reichte dem Kern Quelle UND Hoehe; `wig.blit` las daraus
// zeilenweise ueber `fetch`, und `fetch` fragt `proc.user_ok` --
// die vier Zeilen hinter der Abbildung sind fuer den Prozess NICHT
// lesbar. Also gab `fetch` false, `blit` brach ab und lieferte NULL,
// und `wm.damage` am Ende von `blit` wurde NIE ERREICHT.
//
// Das Ergebnis ist genau das Foto: die Leiste steht auf dem Schirm, wie
// sie beim allerersten Mal gemalt wurde, und keine spaetere Aenderung
// kommt je an. Bewegt man die Maus darueber, malt der FENSTERSERVER
// den Bereich neu (Zeiger, Damage aus dem Eingabepfad) -- und schiebt
// dabei den Fensterpuffer mit, in dem die neue Uhrzeit laengst steht.
// Deshalb sprang die Uhr nur unter dem Mauszeiger.
//
// GEMESSEN, vorher: `px=0 soll=4403200 null=16` -- jeder einzelne
// Push brachte null Bildpunkte hinueber.
//
// Die Abhilfe steht HIER und nicht bei der Leiste, weil der Fehler
// hier ist: `push` darf nicht mehr Zeilen versprechen, als die Flaeche
// traegt. Was nicht in den Streifen passt, wird nicht gelesen -- und
// der Rest kommt an, statt dass alles verlorengeht.
fn push(h: u64, x: u64, y: u64, w: u64, hh: u64) -> u64 {
    if w == 0 || hh == 0 {
        return 0
    }
    if y < s_band {
        return 0
    }
    let r: u64 = y -% s_band
    if r >= s_srows {
        return 0
    }
    // NUR SO VIELE ZEILEN, WIE WIRKLICH ABGEBILDET SIND.
    var hn: u64 = hh
    if r +% hn > s_srows {
        hn = s_srows -% r
    }
    if hn == 0 {
        return 0
    }
    let src: u64 = s_surf +% r *% s_sw *% 4 +% x *% 4
    return sys5(WIG_BLIT, h, (x << 16) | y, (w << 16) | hn, src, s_sw)
}

fn push_rect(h: u64, x: u64, y: u64, w: u64, hh: u64) -> u64 {
    return push(h, x, y, w, hh)
}

fn cursor_shape(s: u64) {
    if s == s_shape {
        return
    }
    s_shape = s
    sys3w(WIG_CURSOR, s, 0, 0)
}

// ------------------------------------------------- die Zwischenablage
//
// Sie liegt im Kernel, weil sie per Definition das ist, was ZWEI
// Prozesse teilen. `noclip` ist die Gegenprobe: dieselbe Anwendung, nur
// dass Kopieren und Einfuegen nichts tun -- und die Messung, die zeigt,
// dass ein Text von einem Feld ins andere gewandert ist, MUSS dann
// einbrechen.

fn bus5(op: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") SYS_OSUM_BUS, in("rdi") op,
        in("rsi") a1, in("rdx") a2, in("r10") a3, in("r8") a4, in("r9") 0,
        clobber("rcx"), clobber("r11"), clobber("memory"))
}

// Gibt es den Bus in diesem Kern? Ein Ruf, der nichts tut: die Zahl der
// Verlaufsplaetze. Kommt ein Fehler, laeuft der Kern mit `nobus`, und
// jede Anwendung faellt auf die alte Zwischenablage zurueck.
fn bus_da() -> bool {
    return !ulib.bad(bus5(BUS_CLIPINFO_OP, 0, 3, 0, 0))
}

fn clip_put(p: u64, n: u64) -> u64 {
    return clip_put_typ(BT_TEXT, p, n)
}

// MIT TYP. Derselbe Text kann Text UND Pfad sein -- der Explorer legt
// einen Dateinamen ab, der Editor liest ihn als Text, und beide haben
// recht. Genau dafuer ist der erste Wert eine Maske.
fn clip_put_typ(typen: u64, p: u64, n: u64) -> u64 {
    if s_noclip != 0 {
        return 0
    }
    let r: u64 = bus5(BUS_CLIPSET_OP, typen, p, n, 0)
    if !ulib.bad(r) {
        return n
    }
    return sys3w(WIG_CLIPSET, p, n, 0)
}

fn clip_take(p: u64, max: u64) -> u64 {
    return clip_hist_take(0, p, max)
}

// `zurueck` 0 ist das Neueste, 1 das davor -- der Verlauf, und Win+V
// ist genau diese Zahl und sonst nichts.
fn clip_hist_take(back: u64, p: u64, max: u64) -> u64 {
    if s_noclip != 0 {
        return 0
    }
    let n: u64 = bus5(BUS_CLIPGET_OP, back, p, max, 0)
    if !ulib.bad(n) {
        return n
    }
    if back != 0 {
        return 0
    }
    let m: u64 = sys3w(WIG_CLIPGET, p, max, 0)
    if ulib.bad(m) {
        return 0
    }
    return m
}

fn clip_hist_count() -> u64 {
    let n: u64 = bus5(BUS_CLIPINFO_OP, 0, 3, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn clip_hist_typ(back: u64) -> u64 {
    let n: u64 = bus5(BUS_CLIPINFO_OP, back, 0, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn clip_hist_owner(back: u64) -> u64 {
    let n: u64 = bus5(BUS_CLIPINFO_OP, back, 2, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

// ------------------------------------------------------ Drag-and-Drop
//
// DASSELBE MODELL, EIN PLATZ. Der Explorer legt beim Ziehen einen Pfad
// ab, der Editor fragt beim Loslassen danach. Dass das keine zweite
// Ablage ist, sondern dieselben Felder, ist die Entscheidung 2 der
// Wegkarte -- und der Grund, warum diese vier Funktionen zusammen
// kuerzer sind als eine eigene Ablage waere.
fn drag_put(typen: u64, p: u64, n: u64) -> u64 {
    return bus5(BUS_DRAGSET_OP, typen, p, n, 0)
}

fn drag_take(p: u64, max: u64) -> u64 {
    let n: u64 = bus5(BUS_DRAGGET_OP, p, max, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn drag_an() -> bool {
    return bus5(BUS_DRAGINFO_OP, 0, 0, 0, 0) == 1
}

fn drag_drop() -> u64 {
    return bus5(BUS_DRAGCLEAR_OP, 0, 0, 0, 0)
}

// --------------------------------------------------- Benachrichtigungen
fn noti_post(dringlich: u64, p: u64, n: u64) -> u64 {
    return bus5(BUS_NOTIPOST_OP, dringlich, p, n, 0)
}

fn noti_count() -> u64 {
    let n: u64 = bus5(BUS_NOTIINFO_OP, 0, 0, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

// Wieviele noch NIEMAND gelesen hat -- die Zahl auf der Glocke.
fn noti_new() -> u64 {
    let n: u64 = bus5(BUS_NOTIINFO_OP, 1, 0, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn noti_take(back: u64, p: u64, max: u64) -> u64 {
    let n: u64 = bus5(BUS_NOTIGET_OP, back, p, max, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

// ------------------------------------------------- Dienste und Nachrichten
fn bus_reg(name: u64, n: u64, zugriff: u64) -> u64 {
    return bus5(BUS_REG_OP, name, n, zugriff, 0)
}

fn bus_find(name: u64, n: u64) -> u64 {
    return bus5(BUS_FIND_OP, name, n, 0, 0)
}

fn bus_send(dienst: u64, p: u64, n: u64) -> u64 {
    return bus5(BUS_SEND_OP, dienst, p, n, 0)
}

fn bus_recv(p: u64, max: u64, kopf: u64) -> u64 {
    return bus5(BUS_RECV_OP, p, max, kopf, 0)
}

fn bus_sub(dienst: u64) -> u64 {
    return bus5(BUS_SUB_OP, dienst, 0, 0, 0)
}

fn bus_pub(dienst: u64, p: u64, n: u64) -> u64 {
    return bus5(BUS_PUB_OP, dienst, p, n, 0)
}

fn clip_len() -> u64 {
    if s_noclip != 0 {
        return 0
    }
    return sys3w(WIG_SCREEN, 5, 0, 0)
}

// ============================================== ROUND THEME: THE TOKENS
//
// THE COLOURS ARE NOT A LIST ANY MORE. Round K15 put eighteen colours
// with names in a file and let every widget pick one; that works right
// up to the moment somebody wants the same interface in light AND in
// dark, and then it is eighteen colours times two files times every
// scheme, kept in step by hand. What is here instead is the three-layer
// arrangement that design systems use, in the order the resolver runs:
//
//   1. PRIMITIVE   the raw ramps and nothing with a meaning. A neutral
//                  ramp of thirteen steps (neutral0 .. neutral1000) and
//                  four generated hue ramps of nine steps each (accent,
//                  danger, warning, success). They come out of a scheme
//                  file under /etc/schemas/.
//
//   2. SEMANTIC    twenty-three ROLES -- surface, surface-raised,
//                  surface-sunken, text-primary, text-secondary,
//                  text-disabled, border, border-strong, border-focus,
//                  accent, accent-hover, accent-pressed, on-accent,
//                  selection, danger, warning, success, shadow and the
//                  rest. `bind_neutrals` and `bind_accent` fill them,
//                  and they are the ONLY functions in the system that
//                  know whether it is light or dark.
//
//   3. COMPONENT   what a window frame, a title bar, a button, an entry
//                  field, a list and the taskbar actually draw with.
//                  Every component token is a SEMANTIC NAME:
//                  `comp_role` is a table from component to role, and
//                  there is no second way in. No drawing routine in
//                  this repository contains a colour.
//
// SO LIGHT AND DARK ARE TWO BINDINGS OF THE SAME NAMES. There is no
// second set of colours, and there is no `if dark` in any drawing code
// -- there are two branches in one function, `bind_neutrals`, and the
// high-contrast scheme adds a third.
//
// SWITCHING AT RUNTIME WITHOUT A HALF-DRAWN WINDOW. The resolved
// component table exists TWICE (`tok`, two banks). A rebuild fills the
// bank that is not in use and then flips ONE word, `live`. A window
// latches the live bank at the top of its paint (`theme_frame_begin`)
// and reads that bank until the paint is finished, so a rebuild that
// lands in the middle of a paint cannot colour half a window;
// `theme_frame_stale` afterwards tells the window it owes the screen
// one more pass. What this does NOT buy is the whole SCREEN at one
// instant: every program picks the change up on its own poll, and the
// gap that leaves is measured in docs/ROUNDTHEME.md rather than
// glossed over here.

const SCALE: u64 = 16777216
const RGB24: u64 = 0x00FFFFFF
const RGB_WHITE: u64 = 0x00FFFFFF
const RGB_BLACK: u64 = 0x00000000
const RGB_BAD: u64 = 0xFFFFFFFF
const DEC_BAD: u64 = 0xFFFFFFFF
// #000000 is a legal accent and 0 is also the "nothing chosen" marker.
// Two meanings on one word is how black stops working and nobody finds
// out why, so black is carried one bit above the 24 that a colour uses.
const ACCENT_BLACK: u64 = 0x01000000

// ---- layer 1
const NEUTRAL_STEPS: u64 = 13
const N_0: u64 = 0
const N_50: u64 = 1
const N_100: u64 = 2
const N_200: u64 = 3
const N_300: u64 = 4
const N_400: u64 = 5
const N_500: u64 = 6
const N_600: u64 = 7
const N_700: u64 = 8
const N_800: u64 = 9
const N_900: u64 = 10
const N_950: u64 = 11
const N_1000: u64 = 12

const RAMP_STEPS: u64 = 9
const A_400: u64 = 3
const A_600: u64 = 5

const R_ACCENT: u64 = 0
const R_DANGER: u64 = 1
const R_WARNING: u64 = 2
const R_SUCCESS: u64 = 3
const R_COUNT: u64 = 4

// ---- layer 2
const S_SURFACE: u64 = 0
const S_SURFACE_RAISED: u64 = 1
const S_SURFACE_SUNKEN: u64 = 2
const S_SURFACE_HOVER: u64 = 3
const S_SURFACE_PRESSED: u64 = 4
const S_TEXT_PRIMARY: u64 = 5
const S_TEXT_SECONDARY: u64 = 6
const S_TEXT_DISABLED: u64 = 7
const S_BORDER: u64 = 8
const S_BORDER_STRONG: u64 = 9
const S_BORDER_FOCUS: u64 = 10
const S_ACCENT: u64 = 11
const S_ACCENT_HOVER: u64 = 12
const S_ACCENT_PRESSED: u64 = 13
const S_ACCENT_DISABLED: u64 = 14
const S_ON_ACCENT: u64 = 15
const S_SELECTION: u64 = 16
const S_ON_SELECTION: u64 = 17
const S_OVERLAY: u64 = 18
const S_DANGER: u64 = 19
const S_WARNING: u64 = 20
const S_SUCCESS: u64 = 21
const S_SHADOW: u64 = 22
const S_COUNT: u64 = 23

// ---- layer 3
//
// The first eighteen numbers are the ones round K15 handed out, so no
// call site in `wlib.fi` has to be renumbered. The NAMES are new,
// because the old ones named a colour ("btnhi") and these name a part
// of a control.
const C_WINDOW_BG: u64 = 0
const C_WINDOW_TEXT: u64 = 1
const C_TEXT_MUTED: u64 = 2
const C_PANEL_BG: u64 = 3
const C_BUTTON_FACE: u64 = 4
const C_BUTTON_HOVER: u64 = 5
const C_BUTTON_PRESSED: u64 = 6
const C_BORDER: u64 = 7
const C_SELECT_BG: u64 = 8
const C_SELECT_TEXT: u64 = 9
const C_FOCUS_RING: u64 = 10
const C_INPUT_BG: u64 = 11
const C_HEADER_BG: u64 = 12
const C_SCROLL_TRACK: u64 = 13
const C_SCROLL_THUMB: u64 = 14
const C_ACCENT: u64 = 15
const C_DIALOG_BG: u64 = 16
const C_MENU_BG: u64 = 17
const C_TITLEBAR_BG: u64 = 18
const C_TITLEBAR_TEXT: u64 = 19
const C_TITLEBAR_OFF_BG: u64 = 20
const C_TITLEBAR_OFF_TEXT: u64 = 21
const C_WINDOW_FRAME: u64 = 22
const C_TASKBAR_BG: u64 = 23
const C_TASKBAR_TEXT: u64 = 24
const C_TASKBAR_ACTIVE: u64 = 25
const C_DESKTOP_TOP: u64 = 26
const C_DESKTOP_BOTTOM: u64 = 27
const C_BUTTON_TEXT: u64 = 28
