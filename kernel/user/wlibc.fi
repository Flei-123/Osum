const SYS_MMAP: u64 = 9
const PROT_RW: u64 = 3
const MAP_ANON_PRIV: u64 = 34

// Die beiden Schriften, die der Server geladen hat, und die Groessen,
// in denen er sie setzt (`kmain.fi`: PX_UI 15, PX_MONO 16). Dieselben
// Zahlen hier, weil eine Oberflaeche, die den Titel in 15 und ihren
// eigenen Text in 14 setzt, zwei Schriftbilder hat.
const F_UI: u64 = 0
const F_MONO: u64 = 1
const PX_UI: u64 = 15
const PX_MONO: u64 = 16

// ================================================== RUNDE A11Y
//
// DIE SCHRIFTGROESSE IST VON JETZT AN EINE RECHNUNG UND KEINE KONSTANTE.
//
// `PX_UI` bleibt als GRUNDGROESSE stehen -- sie ist das, was bei 100
// Prozent gilt, und `kmain.fi` setzt dieselbe Zahl im Fensterserver.
// Was die Oberflaeche wirklich benutzt, ist `px_ui()`: die Grundgroesse
// mal der systemweiten Skalierung. Die Skalierung kommt aus dem Kernel
// (`ax_info(AI_SCALE)`) und nicht aus einer Datei je Programm -- sonst
// waere sie nicht systemweit, sondern eine Bitte an jedes Programm
// einzeln.
//
// `sc(v)` skaliert eine LAENGE. Jede feste Zahl in der Anordnung geht
// dadurch: ein Knopf, der bei 100 Prozent 26 Bildpunkte hoch ist, ist
// bei 150 Prozent 39 hoch. Ohne das waechst die Schrift und der Kasten
// nicht -- und GENAU DAS ist der haeufigste Fehler beim Skalieren, der
// abgeschnittene Beschriftungen macht.
//
// BEI 100 PROZENT IST JEDE DIESER RECHNUNGEN DIE IDENTITAET
// (v * 100 / 100 == v). Kein bestehender Testlauf sieht einen
// Unterschied; das ist keine Hoffnung, sondern eine Rechnung.
const AX_PUSH: u64 = 1960
const AX_READ_NR: u64 = 1961
const AX_EVENT_NR: u64 = 1962
const AX_PERM: u64 = 1963
const AX_INFO_NR: u64 = 1964

const AI_COUNT: u64 = 0
const AI_GEN: u64 = 1
const AI_PUSHES: u64 = 2
const AI_READS: u64 = 3
const AI_DENIED: u64 = 4
const AI_SECRETS: u64 = 5
const AI_LEAKS: u64 = 6
const AI_SCALE: u64 = 7
const AI_HIGH: u64 = 8
const AI_MAG: u64 = 9
const AI_STICKY: u64 = 10
const AI_ON: u64 = 13

// Die Packung eines Knotens -- WORTGLEICH mit `kernel/ax.fi`.
// `tools/a11y/felder.py` haelt beide Dateien gegeneinander; eine
// Packung, die an zwei Stellen steht, laeuft sonst auseinander.
const AX_NODE: u64 = 64
const AX_NAME_OFF: u64 = 24
const AX_NAME_MAX: u64 = 40

const AR_NONE: u64 = 0
const AR_WINDOW: u64 = 1
const AR_LABEL: u64 = 2
const AR_BUTTON: u64 = 3
const AR_CHECK: u64 = 4
const AR_ENTRY: u64 = 5
const AR_PASSWORD: u64 = 6
const AR_LIST: u64 = 7
const AR_TABLE: u64 = 8
const AR_TAB: u64 = 9
const AR_MENUBAR: u64 = 10
const AR_CHOICE: u64 = 11
const AR_SEPARATOR: u64 = 12
const AR_SCROLLBAR: u64 = 13
const AR_MENU: u64 = 14
const AR_DIALOG: u64 = 15

const AS_ENABLED: u64 = 1
const AS_FOCUSABLE: u64 = 2
const AS_FOCUSED: u64 = 4
const AS_SELECTED: u64 = 8
const AS_HIDDEN: u64 = 16
const AS_CHECKED: u64 = 32
const AS_PROTECTED: u64 = 64

// ROUND ICONS: the third role.  Same number as `wig.F_ICON`, and it has
// to be -- the value travels through WIG_GLYPH unchanged.
const F_ICON: u64 = 2

// THE FOUR SIZES AN ICON IS DRAWN AT, and they are four and not any
// number the caller likes for one reason: an icon has to be CHECKED at
// the size it is used.  A drawing that turns to mush at sixteen pixels
// is worthless, and it only shows if the sheet is rendered at sixteen
// -- not at ninety-six and then shrunk.
//
//   ICON_SMALL    16  list rows, the file manager, status in a line
//   ICON_MENU     16  next to a menu entry, same box as the text line
//   ICON_TASKBAR  20  the taskbar, where the row is taller
//   ICON_LARGE    24  buttons with an icon above the label, dialogues
//
// SMALL and MENU are the same number today.  They are two names because
// they answer to different things: SMALL follows the row height of a
// list, MENU follows PX_UI.  When one of the two moves, the other must
// not move with it by accident.
const ICON_SMALL: u64 = 16
const ICON_MENU: u64 = 16
const ICON_TASKBAR: u64 = 20
const ICON_LARGE: u64 = 24

// ------------------------------------------------------- die Flaeche

// 800 x 81 Bildpunkte = 259 200 Oktette, aufgerundet 64 Seiten.
const SURF_W: u64 = 800
const SURF_ROWS: u64 = 81
const SURF_BYTES: u64 = 259200

static mut s_surf: u64 = 0
static mut s_band: u64 = 0
static mut s_scr_w: u64 = 0
static mut s_scr_h: u64 = 0
static mut s_cx0: u64 = 0
static mut s_cy0: u64 = 0
static mut s_cx1: u64 = 0
static mut s_cy1: u64 = 0
static mut s_ready: u64 = 0
static mut s_noclip: u64 = 0
static mut s_shape: u64 = 0
static mut s_scale: u64 = 100
static mut s_high: u64 = 0
static mut s_axon: u64 = 0

fn sys5(number: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, in("r10") a3, in("r8") a4,
        clobber("rcx"), clobber("r11"), clobber("memory"))
}

fn sys3w(number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

fn map_surface() -> u64 {
    let no: u64 = 0 -% 1
    return asm("syscall", out("rax"), in("rax") SYS_MMAP, in("rdi") 0,
        in("rsi") SURF_BYTES, in("rdx") PROT_RW, in("r10") MAP_ANON_PRIV,
        in("r8") no, in("r9") 0, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

fn start(noclip: bool) -> bool {
    if s_ready != 0 {
        return true
    }
    let p: u64 = map_surface()
    if ulib.bad(p) || p == 0 {
        return false
    }
    s_surf = p
    s_scr_w = sys3w(WIG_SCREEN, 0, 0, 0)
    s_scr_h = sys3w(WIG_SCREEN, 1, 0, 0)
    if ulib.bad(s_scr_w) || s_scr_w == 0 || s_scr_w > SURF_W {
        return false
    }
    if noclip {
        s_noclip = 1
    }
    // RUNDE A11Y: DIE SYSTEMWEITEN EINSTELLUNGEN, EINMAL BEIM AUFSETZEN.
    //
    // Sie kommen VOR `theme_reload`, weil der hohe Kontrast ein
    // Farbschema WAEHLT -- ein Programm, das erst laedt und dann
    // nachsieht, malt sein erstes Bild in den falschen Farben.
    s_scale = ax_info(AI_SCALE)
    if s_scale < 100 || s_scale > 300 {
        s_scale = 100
    }
    s_high = ax_info(AI_HIGH)
    s_axon = ax_info(AI_ON)
    let _tg: u64 = theme_reload()
    s_ready = 1
    return true
}

fn ready() -> bool {
    return s_ready != 0
}

// ---------------------------------------------------- RUNDE A11Y

fn a11y_scale() -> u64 {
    return s_scale
}

fn a11y_high() -> bool {
    return s_high != 0
}

fn a11y_on() -> bool {
    return s_axon != 0
}

fn px_ui() -> u64 {
    return PX_UI * s_scale / 100
}

fn px_mono() -> u64 {
    return PX_MONO * s_scale / 100
}

// Eine LAENGE skalieren. Absichtlich ganzzahlig und absichtlich
// abrundend: eine Anordnung, die mit Bruechen rechnet, hat an jeder
// zweiten Kante einen halben Bildpunkt, und `wlibc.rect` kennt keine
// halben.
fn sc(v: u64) -> u64 {
    return v * s_scale / 100
}

fn ax_info(feld: u64) -> u64 {
    let v: u64 = sys3w(AX_INFO_NR, feld, 0, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

// Darf ICH den Baum lesen? Jeder darf das FRAGEN -- die Antwort ist
// keine Auskunft ueber andere.
fn ax_may() -> bool {
    return sys3w(AX_PERM, 0, 0, 0) == 1
}

fn ax_read(nr: u64, ziel: u64) -> u64 {
    return sys3w(AX_READ_NR, nr, ziel, AX_NODE)
}

fn ax_event(ziel: u64) -> u64 {
    return sys3w(AX_EVENT_NR, ziel, 16, 0)
}

// Die drei Schritte des Eintragens. `begin` merkt sich den alten Stand,
// `send` schiebt bis zu 64 Knoten am Stueck herueber, `end` bildet die
// Ereignisse aus dem Unterschied und schaltet scharf.
fn ax_begin() -> u64 {
    return sys3w(AX_PUSH, 0, 1, 0)
}

fn ax_send(ptr: u64, n: u64) -> u64 {
    return sys3w(AX_PUSH, ptr, n, 0)
}

fn ax_end() -> u64 {
    return sys3w(AX_PUSH, 0, 0, 0)
}

fn surface() -> u64 {
    return s_surf
}

fn surf_w() -> u64 {
    return SURF_W
}

fn surf_rows() -> u64 {
    return SURF_ROWS
}

fn band_y() -> u64 {
    return s_band
}

fn screen_w() -> u64 {
    return s_scr_w
}

fn screen_h() -> u64 {
    return s_scr_h
}

fn mouse_x() -> u64 {
    return sys3w(WIG_SCREEN, 2, 0, 0)
}

fn mouse_y() -> u64 {
    return sys3w(WIG_SCREEN, 3, 0, 0)
}

// ADDENDUM TASKBAR: WHICH BUTTONS ARE DOWN RIGHT NOW. Bit 0 is left.
// A window only gets EV_DOWN and EV_UP for the pointer INSIDE it; the
// taskbar has to follow a drag that leaves it, all the way to the other
// side of the screen, and this is the only way to see the button let
// go out there.
fn mouse_btn() -> u64 {
    return sys3w(WIG_SCREEN, 4, 0, 0)
}

// Der Streifen faengt bei dieser Fensterzeile an. Alles, was danach
// gemalt wird, rechnet in FENSTERKOORDINATEN -- die Umrechnung auf die
// Flaeche steht an genau einer Stelle, in `px`.
fn set_band(y: u64) {
    s_band = y
}

fn clip_set(x0: u64, y0: u64, x1: u64, y1: u64) {
    s_cx0 = x0
    s_cy0 = y0
    s_cx1 = x1
    s_cy1 = y1
}

fn clip_x0() -> u64 {
    return s_cx0
}

fn clip_y0() -> u64 {
    return s_cy0
}

fn clip_x1() -> u64 {
    return s_cx1
}

fn clip_y1() -> u64 {
    return s_cy1
}

// ---------------------------------------------------- die Grundformen

fn px(x: u64, y: u64, color: u64) {
    if x < s_cx0 || x >= s_cx1 || y < s_cy0 || y >= s_cy1 {
        return
    }
    if x >= SURF_W || y < s_band {
        return
    }
    let r: u64 = y - s_band
    if r >= SURF_ROWS {
        return
    }
    __mmio_write32((s_surf +% (r *% SURF_W +% x) *% 4) as *mut u32,
        color as u32)
}

fn get(x: u64, y: u64) -> u64 {
    if x >= SURF_W || y < s_band {
        return 0
    }
    let r: u64 = y - s_band
    if r >= SURF_ROWS {
        return 0
    }
    return __mmio_read32((s_surf +% (r *% SURF_W +% x) *% 4)
        as *mut u32) as u64
}

// DIESELBE ZEILE WIE `wm.blend` UND WIE `mische` in
// tools/gfx/checkshot.py. Sie steht dreimal, in drei Sprachen, und das ist
// kein Versehen: ein bildpunktgenauer Vergleich eines
// kantengeglaetteten Zeichens ist nur moeglich, wenn alle drei
// dieselbe Rundung nehmen.
fn blend(alt: u64, neu: u64, a: u64) -> u64 {
    if a == 0 {
        return alt
    }
    if a >= 255 {
        return neu
    }
    let ia: u64 = 255 - a
    let r: u64 = (((alt >> 16) & 0xFF) * ia + ((neu >> 16) & 0xFF) * a) / 255
    let g: u64 = (((alt >> 8) & 0xFF) * ia + ((neu >> 8) & 0xFF) * a) / 255
    let b: u64 = ((alt & 0xFF) * ia + (neu & 0xFF) * a) / 255
    return (r << 16) | (g << 8) | b
}

fn rect(x: u64, y: u64, w: u64, h: u64, color: u64) {
    if w == 0 || h == 0 {
        return
    }
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            px(x + c, y + r, color)
            c = c + 1
        }
        r = r + 1
    }
}

fn hline(x: u64, y: u64, w: u64, color: u64) {
    rect(x, y, w, 1, color)
}

fn vline(x: u64, y: u64, h: u64, color: u64) {
    rect(x, y, 1, h, color)
}

// Ein Rahmen von einem Bildpunkt -- vier Linien und KEINE Fuellung.
// `tools/gfx/checkshot.py rechteck` rechnet genau diese vier Kanten nach
// und prueft dazu, dass einen Bildpunkt daneben die Farbe NICHT steht.
fn frame(x: u64, y: u64, w: u64, h: u64, color: u64) {
    if w < 2 || h < 2 {
        return
    }
    hline(x, y, w, color)
    hline(x, y + h - 1, w, color)
    vline(x, y, h, color)
    vline(x + w - 1, y, h, color)
}

// Ein Rahmen, der eine Kante hat: hell oben und links, dunkel unten und
// rechts (oder umgekehrt, wenn `ein` gesetzt ist). Zwei Zeilen Code und
// der ganze Unterschied zwischen "ein Rechteck" und "ein Knopf".
fn frame3(x: u64, y: u64, w: u64, h: u64, hell: u64, dunkel: u64,
    ein: bool) {
    var o: u64 = hell
    var u: u64 = dunkel
    if ein {
        o = dunkel
        u = hell
    }
    if w < 2 || h < 2 {
        return
    }
    hline(x, y, w, o)
    vline(x, y, h, o)
    hline(x, y + h - 1, w, u)
    vline(x + w - 1, y, h, u)
}

// ------------------------------------------------- der Glyphenspeicher
//
// Der Kernel rastert und speichert zwischen (`kernel/ttf.fi`); DIESER
// Speicher hier spart den SYSTEMAUFRUF. Ohne ihn kostet jede Textzeile
// je Zeichen einen Aufruf samt Kopie des Deckungsfeldes -- bei sechs
// Streifen je Neuzeichnen sechsmal. Mit ihm kostet ein Zeichen den
// Aufruf genau einmal im ganzen Programmlauf.
//
// Offene Adressierung mit linearem Sondieren, wie im Kernel. Der
// Schluessel traegt Schrift, Groesse und Zeichen. Freigegeben wird
// nichts.

const GC_SLOTS: u64 = 512
const GC_KEY: u64 = 0
const GC_W: u64 = 1
const GC_H: u64 = 2
const GC_L: u64 = 3
const GC_T: u64 = 4
const GC_ADV: u64 = 5
const GC_DATA: u64 = 6
const GC_FIELDS: u64 = 8

static mut gc: [u64; 4096] = [0 as u64; 4096]
static mut gc_used: u64 = 0
static mut gc_calls: u64 = 0
static mut gbuf: [u8; 2048] = [0 as u8; 2048]

// RUNDE I18N: DER SCHLUESSEL WURDE BREITER. Er trug `c & 0xFFFF`, also
// sechzehn Bit -- genug fuer ein Oktett, genug fuer die
// mehrsprachige Ebene, und zu wenig fuer einen Codepunkt: Unicode
// reicht bis U+10FFFF, das sind einundzwanzig Bit. Mit der alten Maske
// haetten sich U+1F600 und U+F600 denselben Platz im Zwischenspeicher
// geteilt und waeren als DASSELBE Zeichen gemalt worden. Jetzt:
// vierundzwanzig Bit fuer den Codepunkt, acht fuer die Groesse, der
// Rest fuer die Schrift -- dieselbe Aufteilung wie in `ttf.key_of` im
// Kernel, damit beide Speicher dasselbe Zeichen unter derselben Zahl
// fuehren.
// ROUND MERGE: `& RGB24` and not `& 0xFFFFFF`. It is a codepoint mask
// and not a colour, and tests/theme/rawcolour.py cannot tell the two
// apart -- which is why RGB24 has a name in the first place (see the
// header of that script, and the same reasoning in kernel/wm.fi).
fn gkey(f: u64, px_: u64, c: u64) -> u64 {
    return (f << 32) | ((px_ & 0xFF) << 24) | (c & RGB24)
        | 0x8000000000000000
}

fn ghash(k: u64) -> u64 {
    var h: u64 = k *% 1099511628211
    h = h ^ (h >> 29)
    return h % GC_SLOTS
}

fn gfind(f: u64, px_: u64, c: u64) -> u64 {
    let k: u64 = gkey(f, px_, c)
    var i: u64 = ghash(k)
    var n: u64 = 0
    while n < GC_SLOTS {
        let at: u64 = i * GC_FIELDS
        if gc[(at + GC_KEY) as usize] == k {
            return at
        }
        if gc[(at + GC_KEY) as usize] == 0 {
            return gload(at, f, px_, c, k)
        }
        i = (i + 1) % GC_SLOTS
        n = n + 1
    }
    return 0xFFFFFFFFFFFFFFFF
}

fn gload(at: u64, f: u64, px_: u64, c: u64, k: u64) -> u64 {
    let n: u64 = sys5(WIG_GLYPH, f, px_, c, (&gbuf[0 as usize]) as u64,
        2048)
    if ulib.bad(n) || n < 48 {
        return 0xFFFFFFFFFFFFFFFF
    }
    gc_calls = gc_calls + 1
    let b: u64 = (&gbuf[0 as usize]) as u64
    let gw: u64 = __mmio_read64((b + 0) as *mut u64)
    let gh: u64 = __mmio_read64((b + 8) as *mut u64)
    gc[(at + GC_KEY) as usize] = k
    gc[(at + GC_W) as usize] = gw
    gc[(at + GC_H) as usize] = gh
    gc[(at + GC_L) as usize] = __mmio_read64((b + 16) as *mut u64)
    gc[(at + GC_T) as usize] = __mmio_read64((b + 24) as *mut u64)
    gc[(at + GC_ADV) as usize] = __mmio_read64((b + 32) as *mut u64)
    gc[(at + GC_DATA) as usize] = 0
    if gw * gh > 0 {
        let p: u64 = mem.alloc(gw * gh)
        if p != 0 {
            mem.copy(p, b + 48, gw * gh)
            gc[(at + GC_DATA) as usize] = p
        } else {
            gc[(at + GC_W) as usize] = 0
            gc[(at + GC_H) as usize] = 0
        }
    }
    gc_used = gc_used + 1
    return at
}

fn kern26(f: u64, px_: u64, c1: u64, c2: u64) -> i64 {
    return sys5(WIG_KERN, f, px_, c1, c2, 0) as i64
}

// EINE GLYPHE AUF DIE FLAECHE, in der Farbe, die der Aufrufer will --
// und auf den Beschnitt beschnitten. Genau `wm.draw_glyph_clip`, nur in
// Ring 3 und mit einer Farbe je Widget statt einer je Fenster.
fn draw_glyph(at: u64, x: i64, y: i64, color: u64) {
    let gw: u64 = gc[(at + GC_W) as usize]
    let gh: u64 = gc[(at + GC_H) as usize]
    let data: u64 = gc[(at + GC_DATA) as usize]
    if gw == 0 || gh == 0 || data == 0 {
        return
    }
    let x0: i64 = x + gc[(at + GC_L) as usize] as i64
    let y0: i64 = y - gc[(at + GC_T) as usize] as i64
    var r: u64 = 0
    while r < gh {
        let py: i64 = y0 + r as i64
        if py >= 0 {
            var c: u64 = 0
            while c < gw {
                let pxx: i64 = x0 + c as i64
                if pxx >= 0 {
                    let a: u64 = (*((data + r * gw + c) as *mut u8)) as u64
                    if a != 0 {
                        let ux: u64 = pxx as u64
                        let uy: u64 = py as u64
                        px(ux, uy, blend(get(ux, uy), color, a))
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

// Eine Zeile Text. `y` ist die GRUNDLINIE. Gibt die Stelle HINTER dem
// Text zurueck, damit ein Aufrufer zwei Stuecke aneinandersetzen kann.
//
// DIE REIHENFOLGE IST DIE VON `wm.text` UND VON
// `tools/ttf/raster.py stellen`: Unterschneidung VOR dem Zeichen,
// Laufweite DANACH, und gemalt wird bei `cx >> 6`. Wer eines davon
// vertauscht, hat eine Oberflaeche, deren Text sich nicht mehr gegen
// die zweite Rasterung rechnen laesst.
//
// RUNDE I18N: EIN DURCHLAUF JE ZEICHEN. Vorher las die Schleife ein
// Oktett, fragte den Kernel nach der Glyphe dieses Oktetts und schob den
// Zeiger um eins weiter. Fuer "Aufloesung" mit echtem Umlaut heisst das:
// 0xC3 und 0xB6 einzeln, zwei Glyphen, die keine Schrift hat, also zwei
// Leerraeume -- und der Text ist auch noch zu breit, weil zweimal eine
// Laufweite dazukam.
fn text_at(f: u64, px_: u64, x: u64, y: u64, p: u64, n: u64,
    color: u64) -> u64 {
    var cx: i64 = (x as i64) * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = n
        } else {
            if vorher != 0 {
                cx = cx + kern26(f, px_, vorher, c)
            }
            let at: u64 = gfind(f, px_, c)
            if at != 0xFFFFFFFFFFFFFFFF {
                draw_glyph(at, cx >> 6, y as i64, color)
                cx = cx + gc[(at + GC_ADV) as usize] as i64
            }
            vorher = c
            k = k + l
        }
    }
    return (cx >> 6) as u64
}

// Dieselbe Rechnung OHNE zu malen -- fuer die Anordnung, fuer das
// Mittigsetzen und fuer die Stelle, an der eine Einfuegemarke steht.
fn text_w(f: u64, px_: u64, p: u64, n: u64) -> u64 {
    var cx: i64 = 0
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = n
        } else {
            if vorher != 0 {
                cx = cx + kern26(f, px_, vorher, c)
            }
            let at: u64 = gfind(f, px_, c)
            if at != 0xFFFFFFFFFFFFFFFF {
                cx = cx + gc[(at + GC_ADV) as usize] as i64
            }
            vorher = c
            k = k + l
        }
    }
    return (cx >> 6) as u64
}

// ---------------------------------------------- RUNDE I18N: UMBRECHEN
//
// WER TEXT ABSCHNEIDET, MUSS AN EINER ZEICHENGRENZE ABSCHNEIDEN. Das
// klingt selbstverstaendlich und war es bis heute nicht: `wlib.fi`
// kuerzt eine zu lange Zeile, indem es die Laenge um eins verringert,
// bis sie passt (`while cl > 0 && text_w(...) > ...`). Ein Oktett
// weniger heisst bei einem Umlaut: die ERSTE Haelfte des Zeichens bleibt
// stehen. Das ist keine gekuerzte Zeichenkette mehr, das ist eine
// kaputte -- und `text_at` malt dafuer ein Ersatzzeichen.
//
// Diese beiden Funktionen sind die Antwort. `back` geht von `k` aus
// EIN Zeichen zurueck, `fit` sagt, wieviele OKTETTE hoechstens passen,
// ohne ein Zeichen zu zerteilen.

// Der Anfang des Zeichens VOR dem Oktett `k`. Sucht rueckwaerts das
// naechste Oktett, das keine Fortsetzung (10xxxxxx) ist -- hoechstens
// vier Schritte, denn laenger ist keine Folge.
fn back(p: u64, k: u64) -> u64 {
    if k == 0 {
        return 0
    }
    var i: u64 = k - 1
    var n: u64 = 0
    while n < 3 {
        if ((*((p + i) as *mut u8)) as u64 & 0xC0) != 0x80 {
            return i
        }
        if i == 0 {
            return 0
        }
        i = i - 1
        n = n + 1
    }
    return i
}

// Wieviele der `n` Oktette passen in `breite` Bildpunkte, ohne ein
// Zeichen zu zerschneiden? Gibt eine Laenge in OKTETTEN zurueck, die
// immer auf einer Zeichengrenze endet.
fn fit(f: u64, px_: u64, p: u64, n: u64, breite: u64) -> u64 {
    var cx: i64 = 0
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            return k
        }
        if vorher != 0 {
            cx = cx + kern26(f, px_, vorher, c)
        }
        let at: u64 = gfind(f, px_, c)
        if at != 0xFFFFFFFFFFFFFFFF {
            cx = cx + gc[(at + GC_ADV) as usize] as i64
        }
        if (cx >> 6) as u64 > breite {
            return k
        }
        vorher = c
        k = k + l
    }
    return n
}

// Wieviele ZEICHEN in `n` Oktetten stehen. Ein Textfeld zaehlt damit
// seine Einfuegemarke, statt Oktette zu zaehlen.
fn chars(p: u64, n: u64) -> u64 {
    return utf8.chars(p, n)
}

fn glyph_w(f: u64, px_: u64, c: u64) -> u64 {
    let at: u64 = gfind(f, px_, c)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return (gc[(at + GC_ADV) as usize] as i64 >> 6) as u64
}

// Der Aufsteiger der Schrift in Bildpunkten -- die Strecke von der
// Oberkante einer Zeile bis zur Grundlinie. Gemessen am Zeichen, das
// die Oberkante bestimmt, statt geraten: `M` reicht bis zur
// Versalhoehe, `l` und `k` bis zum Aufsteiger.
fn ascent_of(f: u64, px_: u64) -> u64 {
    let at: u64 = gfind(f, px_, 108)
    if at == 0xFFFFFFFFFFFFFFFF {
        return px_
    }
    return gc[(at + GC_T) as usize]
}

fn text_h(px_: u64) -> u64 {
    return px_ + px_ / 4
}

// Die Zellenbreite der Festbreitenschrift: die Laufweite von `0`,
// aufgerundet. Genau die Rechnung, mit der `wm.term_setup` sein Raster
// legt -- ein Dateimanager, der eine Spalte aus Ziffern setzt, will
// dieselbe.
fn mono_cell(px_: u64) -> u64 {
    let at: u64 = gfind(F_MONO, px_, 48)
    if at == 0xFFFFFFFFFFFFFFFF {
        return px_
    }
    return ((gc[(at + GC_ADV) as usize] as i64 + 63) >> 6) as u64
}

// ------------------------------------------------- hinueber ins Fenster

// EIN STREIFEN, EIN AUFRUF. `x` und `y` sind Fensterkoordinaten, die
// Quelle ist die Flaeche mit ihrer eigenen Zeilenlaenge.
fn push(h: u64, x: u64, y: u64, w: u64, hh: u64) -> u64 {
    if w == 0 || hh == 0 {
        return 0
    }
    let src: u64 = s_surf +% (y -% s_band) *% SURF_W *% 4 +% x *% 4
    return sys5(WIG_BLIT, h, (x << 16) | y, (w << 16) | hh, src, SURF_W)
}

fn push_rect(h: u64, x: u64, y: u64, w: u64, hh: u64) -> u64 {
    return push(h, x, y, w, hh)
}

fn cursor_shape(s: u64) {
    if s == s_shape {
        return
    }
    s_shape = s
    sys3w(WIG_CURSOR, s, 0, 0)
}

// ------------------------------------------------- die Zwischenablage
//
// Sie liegt im Kernel, weil sie per Definition das ist, was ZWEI
// Prozesse teilen. `noclip` ist die Gegenprobe: dieselbe Anwendung, nur
// dass Kopieren und Einfuegen nichts tun -- und die Messung, die zeigt,
// dass ein Text von einem Feld ins andere gewandert ist, MUSS dann
// einbrechen.

fn clip_put(p: u64, n: u64) -> u64 {
    if s_noclip != 0 {
        return 0
    }
    return sys3w(WIG_CLIPSET, p, n, 0)
}

fn clip_take(p: u64, max: u64) -> u64 {
    if s_noclip != 0 {
        return 0
    }
    let n: u64 = sys3w(WIG_CLIPGET, p, max, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn clip_len() -> u64 {
    if s_noclip != 0 {
        return 0
    }
    return sys3w(WIG_SCREEN, 5, 0, 0)
}

// ============================================== ROUND THEME: THE TOKENS
//
// THE COLOURS ARE NOT A LIST ANY MORE. Round K15 put eighteen colours
// with names in a file and let every widget pick one; that works right
// up to the moment somebody wants the same interface in light AND in
// dark, and then it is eighteen colours times two files times every
// scheme, kept in step by hand. What is here instead is the three-layer
// arrangement that design systems use, in the order the resolver runs:
//
//   1. PRIMITIVE   the raw ramps and nothing with a meaning. A neutral
//                  ramp of thirteen steps (neutral0 .. neutral1000) and
//                  four generated hue ramps of nine steps each (accent,
//                  danger, warning, success). They come out of a scheme
//                  file under /etc/schemas/.
//
//   2. SEMANTIC    twenty-three ROLES -- surface, surface-raised,
//                  surface-sunken, text-primary, text-secondary,
//                  text-disabled, border, border-strong, border-focus,
//                  accent, accent-hover, accent-pressed, on-accent,
//                  selection, danger, warning, success, shadow and the
//                  rest. `bind_neutrals` and `bind_accent` fill them,
//                  and they are the ONLY functions in the system that
//                  know whether it is light or dark.
//
//   3. COMPONENT   what a window frame, a title bar, a button, an entry
//                  field, a list and the taskbar actually draw with.
//                  Every component token is a SEMANTIC NAME:
//                  `comp_role` is a table from component to role, and
//                  there is no second way in. No drawing routine in
//                  this repository contains a colour.
//
// SO LIGHT AND DARK ARE TWO BINDINGS OF THE SAME NAMES. There is no
// second set of colours, and there is no `if dark` in any drawing code
// -- there are two branches in one function, `bind_neutrals`, and the
// high-contrast scheme adds a third.
//
// SWITCHING AT RUNTIME WITHOUT A HALF-DRAWN WINDOW. The resolved
// component table exists TWICE (`tok`, two banks). A rebuild fills the
// bank that is not in use and then flips ONE word, `live`. A window
// latches the live bank at the top of its paint (`theme_frame_begin`)
// and reads that bank until the paint is finished, so a rebuild that
// lands in the middle of a paint cannot colour half a window;
// `theme_frame_stale` afterwards tells the window it owes the screen
// one more pass. What this does NOT buy is the whole SCREEN at one
// instant: every program picks the change up on its own poll, and the
// gap that leaves is measured in docs/ROUNDTHEME.md rather than
// glossed over here.

const SCALE: u64 = 16777216
const RGB24: u64 = 0x00FFFFFF
const RGB_WHITE: u64 = 0x00FFFFFF
const RGB_BLACK: u64 = 0x00000000
const RGB_BAD: u64 = 0xFFFFFFFF
const DEC_BAD: u64 = 0xFFFFFFFF
// #000000 is a legal accent and 0 is also the "nothing chosen" marker.
// Two meanings on one word is how black stops working and nobody finds
// out why, so black is carried one bit above the 24 that a colour uses.
const ACCENT_BLACK: u64 = 0x01000000

// ---- layer 1
const NEUTRAL_STEPS: u64 = 13
const N_0: u64 = 0
const N_50: u64 = 1
const N_100: u64 = 2
const N_200: u64 = 3
const N_300: u64 = 4
const N_400: u64 = 5
const N_500: u64 = 6
const N_600: u64 = 7
const N_700: u64 = 8
const N_800: u64 = 9
const N_900: u64 = 10
const N_950: u64 = 11
const N_1000: u64 = 12

const RAMP_STEPS: u64 = 9
const A_400: u64 = 3
const A_600: u64 = 5

const R_ACCENT: u64 = 0
const R_DANGER: u64 = 1
const R_WARNING: u64 = 2
const R_SUCCESS: u64 = 3
const R_COUNT: u64 = 4

// ---- layer 2
const S_SURFACE: u64 = 0
const S_SURFACE_RAISED: u64 = 1
const S_SURFACE_SUNKEN: u64 = 2
const S_SURFACE_HOVER: u64 = 3
const S_SURFACE_PRESSED: u64 = 4
const S_TEXT_PRIMARY: u64 = 5
const S_TEXT_SECONDARY: u64 = 6
const S_TEXT_DISABLED: u64 = 7
const S_BORDER: u64 = 8
const S_BORDER_STRONG: u64 = 9
const S_BORDER_FOCUS: u64 = 10
const S_ACCENT: u64 = 11
const S_ACCENT_HOVER: u64 = 12
const S_ACCENT_PRESSED: u64 = 13
const S_ACCENT_DISABLED: u64 = 14
const S_ON_ACCENT: u64 = 15
const S_SELECTION: u64 = 16
const S_ON_SELECTION: u64 = 17
const S_OVERLAY: u64 = 18
const S_DANGER: u64 = 19
const S_WARNING: u64 = 20
const S_SUCCESS: u64 = 21
const S_SHADOW: u64 = 22
const S_COUNT: u64 = 23

// ---- layer 3
//
// The first eighteen numbers are the ones round K15 handed out, so no
// call site in `wlib.fi` has to be renumbered. The NAMES are new,
// because the old ones named a colour ("btnhi") and these name a part
// of a control.
const C_WINDOW_BG: u64 = 0
const C_WINDOW_TEXT: u64 = 1
const C_TEXT_MUTED: u64 = 2
const C_PANEL_BG: u64 = 3
const C_BUTTON_FACE: u64 = 4
const C_BUTTON_HOVER: u64 = 5
const C_BUTTON_PRESSED: u64 = 6
const C_BORDER: u64 = 7
const C_SELECT_BG: u64 = 8
const C_SELECT_TEXT: u64 = 9
const C_FOCUS_RING: u64 = 10
const C_INPUT_BG: u64 = 11
const C_HEADER_BG: u64 = 12
const C_SCROLL_TRACK: u64 = 13
const C_SCROLL_THUMB: u64 = 14
const C_ACCENT: u64 = 15
const C_DIALOG_BG: u64 = 16
const C_MENU_BG: u64 = 17
const C_TITLEBAR_BG: u64 = 18
const C_TITLEBAR_TEXT: u64 = 19
const C_TITLEBAR_OFF_BG: u64 = 20
const C_TITLEBAR_OFF_TEXT: u64 = 21
const C_WINDOW_FRAME: u64 = 22
const C_TASKBAR_BG: u64 = 23
const C_TASKBAR_TEXT: u64 = 24
const C_TASKBAR_ACTIVE: u64 = 25
const C_DESKTOP_TOP: u64 = 26
const C_DESKTOP_BOTTOM: u64 = 27
const C_BUTTON_TEXT: u64 = 28
const C_BUTTON_DISABLED_TEXT: u64 = 29
const C_INPUT_TEXT: u64 = 30
const C_INPUT_BORDER: u64 = 31
const C_LIST_BG: u64 = 32
const C_MENU_TEXT: u64 = 33
const C_SHADOW: u64 = 34
const C_DANGER: u64 = 35
const C_WARNING: u64 = 36
const C_SUCCESS: u64 = 37
const C_ON_ACCENT: u64 = 38
const C_ACCENT_HOVER: u64 = 39
const C_ACCENT_PRESSED: u64 = 40
const C_COUNT: u64 = 41

// The eighteen names of round K15, kept as ALIASES on the component
// numbers above so that every call written before this round still
// means what it meant. They are the keys of the legacy /etc/theme
// override file as well.
const T_BG: u64 = 0
const T_FG: u64 = 1
const T_DIM: u64 = 2
const T_PANEL: u64 = 3
const T_BTN: u64 = 4
const T_BTNHI: u64 = 5
const T_BTNDN: u64 = 6
const T_LINE: u64 = 7
const T_SEL: u64 = 8
const T_SELFG: u64 = 9
const T_FOCUS: u64 = 10
const T_ENTRY: u64 = 11
const T_HEAD: u64 = 12
const T_SCROLL: u64 = 13
const T_THUMB: u64 = 14
const T_ACCENT: u64 = 15
const T_DLG: u64 = 16
const T_MENU: u64 = 17
const T_COUNT: u64 = 18

const MODE_LIGHT: u64 = 0
const MODE_DARK: u64 = 1
const MODE_AUTO: u64 = 2

// ------------------------------------------------------------ the state
static mut neutral: [u64; 13] = [0 as u64; 13]
static mut ramps: [u64; 36] = [0 as u64; 36]
static mut sem: [u64; 23] = [0 as u64; 23]
static mut comp_role: [u64; 41] = [0 as u64; 41]
static mut tok: [u64; 82] = [0 as u64; 82]
static mut ovr_val: [u64; 41] = [0 as u64; 41]
static mut ovr_on: [u64; 41] = [0 as u64; 41]
static mut ovr_n: u64 = 0
static mut live: u64 = 0
static mut generation: u64 = 0
static mut paint_base: u64 = 0
static mut paint_gen: u64 = 0
static mut frame_open: u64 = 0
static mut conf_copy: [u8; 512] = [0 as u8; 512]
static mut conf_len: u64 = 0
static mut booted: u64 = 0

static mut sch_mode: u64 = 1
static mut sch_high: u64 = 0
static mut sch_accent: u64 = 0
static mut sch_danger: u64 = 0
static mut sch_warning: u64 = 0
static mut sch_success: u64 = 0
static mut sch_name: [u8; 32] = [0 as u8; 32]
static mut sch_file: [u8; 32] = [0 as u8; 32]
static mut sch_keys: u64 = 0
static mut kv_bad: u64 = 0

static mut set_mode: u64 = 2
static mut set_accent: u64 = 0
static mut set_light_min: u64 = 420
static mut set_dark_min: u64 = 1140
static mut tz_offset: u64 = 0

static mut cur_dark: u64 = 0
static mut acc_ok: u64 = 1
static mut acc_exact: u64 = 1
static mut acc_moved: u64 = 0
static mut acc_r_text: u64 = 0
static mut acc_r_ui: u64 = 0

static mut st_hover: u64 = 0
static mut st_pressed: u64 = 0
static mut st_on: u64 = 0

// ------------------------------------------- fixed point, sRGB and WCAG
//
// One scale for everything: 1.0 is 1 << 24. The product of two values
// in [0,1] fits in 48 bits, so nothing here needs a 128-bit type -- and
// nothing here needs a float, which matters, because this is a
// freestanding profile and there is no libm under it.

fn mulf(a: u64, b: u64) -> u64 {
    return (a * b) >> 24
}

// v to the power 1/5, Newton: r <- (4r + v/r^4) / 5.
fn fifth_root(v: u64) -> u64 {
    if v == 0 {
        return 0
    }
    var r: u64 = SCALE
    var k: u64 = 0
    while k < 60 {
        let r2: u64 = mulf(r, r)
        let r4: u64 = mulf(r2, r2)
        if r4 == 0 {
            k = 60
        } else {
            let q: u64 = (v << 24) / r4
            let nr: u64 = (4 * r + q) / 5
            if nr == r {
                k = 60
            } else {
                r = nr
                k = k + 1
            }
        }
    }
    return r
}

// One sRGB channel (0..255) to linear light, scaled by SCALE.
//
//     WCAG 2.x:  c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055)^2.4
//
// and x^2.4 == x^2 * (x^2)^(1/5) -- which is why a fifth root is the
// whole of the machinery. 0.03928 * 255 = 10.02, so the cut on the
// integer grid falls at c <= 10, and tools/theme/model.py cuts in
// exactly the same place: two implementations that round differently
// are not two implementations of the same thing.
fn lin_of(c: u64) -> u64 {
    let x: u64 = (c * SCALE) / 255
    if c <= 10 {
        return (x * 10000) / 129200
    }
    let t: u64 = ((x + (55 * SCALE) / 1000) * 1000) / 1055
    let t2: u64 = mulf(t, t)
    return mulf(t2, fifth_root(t2))
}

fn luminance(rgb: u64) -> u64 {
    let r: u64 = lin_of((rgb >> 16) & 255)
    let g: u64 = lin_of((rgb >> 8) & 255)
    let b: u64 = lin_of(rgb & 255)
    return (2126 * r + 7152 * g + 722 * b) / 10000
}

// (L1 + 0.05) / (L2 + 0.05), times 100. 452 reads as 4.52 to 1.
fn contrast(a: u64, b: u64) -> u64 {
    var la: u64 = luminance(a)
    var lb: u64 = luminance(b)
    if la < lb {
        let t: u64 = la
        la = lb
        lb = t
    }
    return ((la + SCALE / 20) * 100) / (lb + SCALE / 20)
}

// p percent of b into a, one sRGB channel at a time. Mixing in sRGB
// and not in linear light is a simplification and a visible one; what
// it costs and why it stays is in docs/ROUNDTHEME.md.
fn mix(a: u64, b: u64, p: u64) -> u64 {
    var out: u64 = 0
    var n: u64 = 0
    while n < 3 {
        let s: u64 = 16 - n * 8
        let ca: u64 = (a >> s) & 255
        let cb: u64 = (b >> s) & 255
        let cv: u64 = ((ca * (100 - p) + cb * p) / 100) & 255
        out = out | (cv << s)
        n = n + 1
    }
    return out
}

// -------------------------------------------------- layer 1: the ramps
//
// Steps 100..500 are the base mixed towards white, 700..900 towards
// black, and the base itself is step 600. The percentages are read off
// the Tailwind ramps that the palette file of the design skill is built
// on, so a ramp generated from #2563EB lands within a few units of
// blue-100 .. blue-900 -- which is the point: the ramp is DERIVED, so a
// user who types one colour gets nine that belong together.
fn ramp_build(slot: u64, base: u64) {
    let at: u64 = slot * RAMP_STEPS
    ramps[((at + 0)) as usize] = mix(base, RGB_WHITE, 88)
    ramps[((at + 1)) as usize] = mix(base, RGB_WHITE, 76)
    ramps[((at + 2)) as usize] = mix(base, RGB_WHITE, 60)
    ramps[((at + 3)) as usize] = mix(base, RGB_WHITE, 38)
    ramps[((at + 4)) as usize] = mix(base, RGB_WHITE, 18)
    ramps[((at + 5)) as usize] = base
    ramps[((at + 6)) as usize] = mix(base, RGB_BLACK, 16)
    ramps[((at + 7)) as usize] = mix(base, RGB_BLACK, 33)
    ramps[((at + 8)) as usize] = mix(base, RGB_BLACK, 50)
}

fn ramp_at(slot: u64, step: u64) -> u64 {
    return ramps[((slot * RAMP_STEPS + step)) as usize]
}

// The readable label for a surface: white, black or the darkest
// neutral, whichever reads best. This is not a way around a bad choice
// -- the bad choice is still reported -- it is the difference between
// "hard to read" and "invisible".
fn pick_on(bg: u64) -> u64 {
    var best: u64 = neutral[(N_0) as usize]
    var bestr: u64 = contrast(best, bg)
    var i: u64 = 0
    while i < 2 {
        var c: u64 = neutral[(N_1000) as usize]
        if i == 1 {
            c = neutral[(N_900) as usize]
        }
        let r: u64 = contrast(c, bg)
        if r > bestr {
            bestr = r
            best = c
        }
        i = i + 1
    }
    return best
}

// The hover and pressed states of the accent, DERIVED and not set.
//
// They used to be ramp steps, and the green accent of `night` is why
// they are not: on a green the readable label is BLACK, so walking the
// ramp darker to satisfy the surface rule walks the label rule off a
// cliff, and no step of a green ramp satisfies both at once. They are
// now moved in the direction that can only HELP the label -- if the
// label is light the states go darker, if the label is dark they go
// lighter -- so the label contrast of hover and pressed is at least
// that of the accent itself, by construction.
fn states_of(a: u64) {
    let on: u64 = pick_on(a)
    var towards: u64 = RGB_WHITE
    if luminance(on) > luminance(a) {
        towards = RGB_BLACK
    }
    st_hover = mix(a, towards, 12)
    st_pressed = mix(a, towards, 26)
    st_on = on
}

// ------------------------------------------------ layer 2: the binding
//
// The one function that knows about light and dark, and it does it
// three times: light, dark, and the high-contrast binding that
// `contrast=high` in a scheme file selects. In that third binding the
// border IS the text colour, secondary text is primary text, and the
// raised and sunken surfaces collapse onto the surface -- depth drawn
// as three close greys is depth a washed-out display eats.
fn bind_neutrals(dark: bool) {
    if !dark {
        if sch_high != 0 {
            sem[(S_SURFACE) as usize] = neutral[(N_0) as usize]
            sem[(S_SURFACE_RAISED) as usize] = neutral[(N_0) as usize]
            sem[(S_SURFACE_SUNKEN) as usize] = neutral[(N_0) as usize]
            sem[(S_SURFACE_HOVER) as usize] = neutral[(N_100) as usize]
            sem[(S_SURFACE_PRESSED) as usize] = neutral[(N_200) as usize]
            sem[(S_TEXT_PRIMARY) as usize] = neutral[(N_1000) as usize]
            sem[(S_TEXT_SECONDARY) as usize] = neutral[(N_1000) as usize]
            sem[(S_TEXT_DISABLED) as usize] = neutral[(N_500) as usize]
            sem[(S_BORDER) as usize] = neutral[(N_1000) as usize]
            sem[(S_BORDER_STRONG) as usize] = neutral[(N_1000) as usize]
            sem[(S_SHADOW) as usize] = neutral[(N_1000) as usize]
        } else {
            sem[(S_SURFACE) as usize] = neutral[(N_50) as usize]
            sem[(S_SURFACE_RAISED) as usize] = neutral[(N_0) as usize]
            sem[(S_SURFACE_SUNKEN) as usize] = neutral[(N_100) as usize]
            sem[(S_SURFACE_HOVER) as usize] = neutral[(N_100) as usize]
            sem[(S_SURFACE_PRESSED) as usize] = neutral[(N_200) as usize]
            sem[(S_TEXT_PRIMARY) as usize] = neutral[(N_900) as usize]
            // n600 and not n500: n500 on surface-sunken measures 4.34
            // to 1 and the bar is 4.5. The number picked the token.
            sem[(S_TEXT_SECONDARY) as usize] = neutral[(N_600) as usize]
            sem[(S_TEXT_DISABLED) as usize] = neutral[(N_400) as usize]
            sem[(S_BORDER) as usize] = neutral[(N_200) as usize]
            // n500 and not n400: a control boundary is a user interface
            // component (WCAG 1.4.11) and needs 3 to 1; n400 measures
            // 2.45 on this surface.
            sem[(S_BORDER_STRONG) as usize] = neutral[(N_500) as usize]
            sem[(S_SHADOW) as usize] = neutral[(N_950) as usize]
        }
    } else {
        if sch_high != 0 {
            sem[(S_SURFACE) as usize] = neutral[(N_1000) as usize]
            sem[(S_SURFACE_RAISED) as usize] = neutral[(N_1000) as usize]
            sem[(S_SURFACE_SUNKEN) as usize] = neutral[(N_1000) as usize]
            sem[(S_SURFACE_HOVER) as usize] = neutral[(N_800) as usize]
            sem[(S_SURFACE_PRESSED) as usize] = neutral[(N_700) as usize]
            sem[(S_TEXT_PRIMARY) as usize] = neutral[(N_0) as usize]
            sem[(S_TEXT_SECONDARY) as usize] = neutral[(N_0) as usize]
            sem[(S_TEXT_DISABLED) as usize] = neutral[(N_400) as usize]
            sem[(S_BORDER) as usize] = neutral[(N_0) as usize]
            sem[(S_BORDER_STRONG) as usize] = neutral[(N_0) as usize]
            sem[(S_SHADOW) as usize] = neutral[(N_1000) as usize]
        } else {
            sem[(S_SURFACE) as usize] = neutral[(N_900) as usize]
            sem[(S_SURFACE_RAISED) as usize] = neutral[(N_800) as usize]
            sem[(S_SURFACE_SUNKEN) as usize] = neutral[(N_950) as usize]
            sem[(S_SURFACE_HOVER) as usize] = neutral[(N_800) as usize]
            sem[(S_SURFACE_PRESSED) as usize] = neutral[(N_700) as usize]
            sem[(S_TEXT_PRIMARY) as usize] = neutral[(N_50) as usize]
            sem[(S_TEXT_SECONDARY) as usize] = neutral[(N_400) as usize]
            sem[(S_TEXT_DISABLED) as usize] = neutral[(N_600) as usize]
            sem[(S_BORDER) as usize] = neutral[(N_700) as usize]
            sem[(S_BORDER_STRONG) as usize] = neutral[(N_500) as usize]
            sem[(S_SHADOW) as usize] = neutral[(N_1000) as usize]
        }
    }
}

// The d-th candidate step around `start`: the preferred direction
// first, then the other one. RAMP_STEPS means "there is none".
fn cand_step(start: u64, up: bool, d: u64, second: bool) -> u64 {
    var forward: bool = up
    if second {
        if d == 0 {
            return RAMP_STEPS
        }
        forward = !up
    }
    if forward {
        if start + d < RAMP_STEPS {
            return start + d
        }
        return RAMP_STEPS
    }
    if start >= d {
        return start - d
    }
    return RAMP_STEPS
}

// The step of a generated ramp nearest to `start` that clears `need`
// against the surface; if none does, the step with the most contrast.
// The status colours go through here, and the high-contrast scheme in
// dark mode is why: at its own step danger measured 5.32 to 1 against
// a 7 to 1 bar.
fn fit_status(slot: u64, start: u64, up: bool, need: u64) -> u64 {
    let bg: u64 = sem[(S_SURFACE) as usize]
    var d: u64 = 0
    while d < RAMP_STEPS {
        var k: u64 = 0
        while k < 2 {
            let i: u64 = cand_step(start, up, d, k == 1)
            if i < RAMP_STEPS {
                if contrast(ramp_at(slot, i), bg) >= need {
                    return ramp_at(slot, i)
                }
            }
            k = k + 1
        }
        d = d + 1
    }
    var best: u64 = ramp_at(slot, 0)
    var bestr: u64 = contrast(best, bg)
    var i2: u64 = 1
    while i2 < RAMP_STEPS {
        let r: u64 = contrast(ramp_at(slot, i2), bg)
        if r > bestr {
            bestr = r
            best = ramp_at(slot, i2)
        }
        i2 = i2 + 1
    }
    return best
}

// THE ACCENT, AND THE TWO RULES THAT DECIDE WHETHER IT MAY STAY.
//
//   WCAG 1.4.3   text on the accent needs 4.5 to 1
//   WCAG 1.4.11  the accent is a user interface component against the
//                surface and needs 3 to 1
//
// The high-contrast scheme raises both to 7 and 4.5, which is the
// entire reason it exists. If the colour the user typed fails, the
// generated ramp is searched -- nearest step first, in the direction
// the mode prefers -- and the accent MOVES. It is not silently
// allowed, and it is not silently refused either: `acc_exact` and
// `acc_ok` come back out and the settings window prints them.
fn bind_accent(dark: bool) {
    var need_text: u64 = 450
    var need_ui: u64 = 300
    if sch_high != 0 {
        need_text = 700
        need_ui = 450
    }
    var start: u64 = A_600
    var up: bool = true
    if dark {
        start = A_400
        up = false
    }
    let bg: u64 = sem[(S_SURFACE) as usize]
    var idx: u64 = start
    var found: bool = false
    var d: u64 = 0
    while d < RAMP_STEPS && !found {
        var k: u64 = 0
        while k < 2 && !found {
            let i: u64 = cand_step(start, up, d, k == 1)
            if i < RAMP_STEPS {
                let a: u64 = ramp_at(R_ACCENT, i)
                states_of(a)
                if contrast(st_on, a) >= need_text
                    && contrast(a, bg) >= need_ui {
                    idx = i
                    found = true
                }
            }
            k = k + 1
        }
        d = d + 1
    }
    if !found {
        // Nothing on the ramp satisfies both rules. Take the step that
        // comes closest rather than the one that was asked for, and
        // keep the answer "no" -- the settings window has to be able to
        // say so instead of quietly drawing something unreadable.
        var bestscore: u64 = 0
        var i3: u64 = 0
        while i3 < RAMP_STEPS {
            let a3: u64 = ramp_at(R_ACCENT, i3)
            states_of(a3)
            var t: u64 = (contrast(st_on, a3) * 100) / need_text
            var u: u64 = (contrast(a3, bg) * 100) / need_ui
            if t > 100 {
                t = 100
            }
            if u > 100 {
                u = 100
            }
            if t + u > bestscore {
                bestscore = t + u
                idx = i3
            }
            i3 = i3 + 1
        }
    }
    acc_ok = 0
    if found {
        acc_ok = 1
    }
    acc_exact = 0
    if idx == start {
        acc_exact = 1
    }
    if idx > start {
        acc_moved = idx - start
    } else {
        acc_moved = start - idx
    }
    let accent: u64 = ramp_at(R_ACCENT, idx)
    states_of(accent)
    acc_r_text = contrast(st_on, accent)
    acc_r_ui = contrast(accent, bg)

    // THE FOCUS RING IS NOT THE ACCENT. It is the step of the accent
    // ramp that stands out most against the surface. Tying it to the
    // accent gave a 1.91 to 1 ring for the green scheme in light mode,
    // and a focus ring nobody can see is not a focus ring.
    var fbest: u64 = ramp_at(R_ACCENT, 0)
    var fr: u64 = contrast(fbest, bg)
    var i4: u64 = 1
    while i4 < RAMP_STEPS {
        let r4: u64 = contrast(ramp_at(R_ACCENT, i4), bg)
        if r4 > fr {
            fr = r4
            fbest = ramp_at(R_ACCENT, i4)
        }
        i4 = i4 + 1
    }

    sem[(S_ACCENT) as usize] = accent
    sem[(S_ACCENT_HOVER) as usize] = st_hover
    sem[(S_ACCENT_PRESSED) as usize] = st_pressed
    sem[(S_ACCENT_DISABLED) as usize] = mix(accent, bg, 65)
    sem[(S_ON_ACCENT) as usize] = st_on
    sem[(S_BORDER_FOCUS) as usize] = fbest
    sem[(S_SELECTION) as usize] = accent
    sem[(S_ON_SELECTION) as usize] = st_on
    sem[(S_OVERLAY) as usize] = sem[(S_SURFACE_RAISED) as usize]
    sem[(S_DANGER) as usize] = fit_status(R_DANGER, start, up, need_text)
    sem[(S_WARNING) as usize] = fit_status(R_WARNING, start, up, need_text)
    sem[(S_SUCCESS) as usize] = fit_status(R_SUCCESS, start, up, need_text)
}

// ------------------------------------------ layer 3: component to role
//
// THIS TABLE IS THE RULE "no component names a colour", written down.
// Every entry is a semantic index. Adding a component means adding a
// line here, not adding a colour somewhere.
fn comp_map_init() {
    comp_role[(C_WINDOW_BG) as usize] = S_SURFACE
    comp_role[(C_WINDOW_TEXT) as usize] = S_TEXT_PRIMARY
    comp_role[(C_TEXT_MUTED) as usize] = S_TEXT_SECONDARY
    comp_role[(C_PANEL_BG) as usize] = S_SURFACE_RAISED
    comp_role[(C_BUTTON_FACE) as usize] = S_SURFACE_RAISED
    comp_role[(C_BUTTON_HOVER) as usize] = S_SURFACE_HOVER
    comp_role[(C_BUTTON_PRESSED) as usize] = S_SURFACE_PRESSED
    comp_role[(C_BORDER) as usize] = S_BORDER
    comp_role[(C_SELECT_BG) as usize] = S_SELECTION
    comp_role[(C_SELECT_TEXT) as usize] = S_ON_SELECTION
    comp_role[(C_FOCUS_RING) as usize] = S_BORDER_FOCUS
    comp_role[(C_INPUT_BG) as usize] = S_SURFACE_SUNKEN
    comp_role[(C_HEADER_BG) as usize] = S_SURFACE_HOVER
    comp_role[(C_SCROLL_TRACK) as usize] = S_SURFACE_SUNKEN
    comp_role[(C_SCROLL_THUMB) as usize] = S_BORDER_STRONG
    comp_role[(C_ACCENT) as usize] = S_ACCENT
    comp_role[(C_DIALOG_BG) as usize] = S_OVERLAY
    comp_role[(C_MENU_BG) as usize] = S_OVERLAY
    comp_role[(C_TITLEBAR_BG) as usize] = S_ACCENT
    comp_role[(C_TITLEBAR_TEXT) as usize] = S_ON_ACCENT
    comp_role[(C_TITLEBAR_OFF_BG) as usize] = S_SURFACE_RAISED
    comp_role[(C_TITLEBAR_OFF_TEXT) as usize] = S_TEXT_SECONDARY
    comp_role[(C_WINDOW_FRAME) as usize] = S_BORDER_STRONG
    comp_role[(C_TASKBAR_BG) as usize] = S_SURFACE_RAISED
    comp_role[(C_TASKBAR_TEXT) as usize] = S_TEXT_PRIMARY
    comp_role[(C_TASKBAR_ACTIVE) as usize] = S_ACCENT
    comp_role[(C_DESKTOP_TOP) as usize] = S_SURFACE_SUNKEN
    comp_role[(C_DESKTOP_BOTTOM) as usize] = S_SURFACE
    comp_role[(C_BUTTON_TEXT) as usize] = S_TEXT_PRIMARY
    comp_role[(C_BUTTON_DISABLED_TEXT) as usize] = S_TEXT_DISABLED
    comp_role[(C_INPUT_TEXT) as usize] = S_TEXT_PRIMARY
    comp_role[(C_INPUT_BORDER) as usize] = S_BORDER_STRONG
    comp_role[(C_LIST_BG) as usize] = S_SURFACE_SUNKEN
    comp_role[(C_MENU_TEXT) as usize] = S_TEXT_PRIMARY
    comp_role[(C_SHADOW) as usize] = S_SHADOW
    comp_role[(C_DANGER) as usize] = S_DANGER
    comp_role[(C_WARNING) as usize] = S_WARNING
    comp_role[(C_SUCCESS) as usize] = S_SUCCESS
    comp_role[(C_ON_ACCENT) as usize] = S_ON_ACCENT
    comp_role[(C_ACCENT_HOVER) as usize] = S_ACCENT_HOVER
    comp_role[(C_ACCENT_PRESSED) as usize] = S_ACCENT_PRESSED
}

// FILL THE BANK THAT IS NOT IN USE, THEN FLIP ONE WORD. That is the
// whole of the tear-free switch on the window side.
fn publish() {
    var shadow: u64 = 1
    if live == 1 {
        shadow = 0
    }
    let at: u64 = shadow * C_COUNT
    var i: u64 = 0
    while i < C_COUNT {
        var v: u64 = sem[(comp_role[(i) as usize]) as usize]
        if ovr_on[(i) as usize] != 0 {
            v = ovr_val[(i) as usize]
        }
        tok[((at + i)) as usize] = v
        i = i + 1
    }
    live = shadow
    generation = generation + 1
    // A program that is NOT inside a paint reads the live bank at
    // once. A program that IS inside one keeps the bank it latched --
    // that is the entire promise, and moving `paint_base` here would
    // break it. It was broken exactly once, and the latch test said so
    // in one line: L_INNER came back dark inside a light frame.
    if frame_open == 0 {
        paint_base = live * C_COUNT
    }
}

// ----------------------------------------------------------- reading
//
// `theme(i)` reads the bank the CURRENT PAINT latched, not the live
// one. A window that started painting light finishes light.
fn theme(i: u64) -> u64 {
    if i >= C_COUNT {
        return 0
    }
    return tok[((paint_base + i)) as usize]
}

fn theme_live(i: u64) -> u64 {
    if i >= C_COUNT {
        return 0
    }
    return tok[((live * C_COUNT + i)) as usize]
}

fn theme_semantic(i: u64) -> u64 {
    if i >= S_COUNT {
        return 0
    }
    return sem[(i) as usize]
}

fn theme_neutral(i: u64) -> u64 {
    if i >= NEUTRAL_STEPS {
        return 0
    }
    return neutral[(i) as usize]
}

fn theme_ramp(slot: u64, step: u64) -> u64 {
    if slot >= R_COUNT || step >= RAMP_STEPS {
        return 0
    }
    return ramp_at(slot, step)
}

fn theme_role_of(i: u64) -> u64 {
    if i >= C_COUNT {
        return S_COUNT
    }
    return comp_role[(i) as usize]
}

fn theme_gen() -> u64 {
    return generation
}

// Latch the live bank for one paint and answer the generation it got.
fn theme_frame_begin() -> u64 {
    frame_open = 1
    paint_base = live * C_COUNT
    paint_gen = generation
    return paint_gen
}

// Close the paint and answer whether the theme moved while it ran.
// Closing matters: after it, `theme()` follows the live bank again.
fn theme_frame_end() -> bool {
    frame_open = 0
    let stale: bool = paint_gen != generation
    paint_base = live * C_COUNT
    return stale
}

// Did the theme move while that paint was running? Then the window
// owes the screen ONE more pass -- one, not a loop, because the next
// paint latches the new bank.
fn theme_frame_stale() -> bool {
    return paint_gen != generation
}

fn theme_dark() -> bool {
    return cur_dark != 0
}

fn theme_mode() -> u64 {
    return set_mode
}

fn theme_scheme_mode() -> u64 {
    return sch_mode
}

fn theme_high() -> bool {
    return sch_high != 0
}

fn theme_accent_ok() -> bool {
    return acc_ok != 0
}

fn theme_accent_exact() -> bool {
    return acc_exact != 0
}

fn theme_accent_moved() -> u64 {
    return acc_moved
}

fn theme_accent_ratio_text() -> u64 {
    return acc_r_text
}

fn theme_accent_ratio_ui() -> u64 {
    return acc_r_ui
}

fn theme_accent_wanted() -> u64 {
    if set_accent != 0 {
        if set_accent == ACCENT_BLACK {
            return 0
        }
        return set_accent
    }
    return sch_accent
}

fn theme_scheme_name() -> u64 {
    return (&sch_name[0 as usize]) as u64
}

fn theme_scheme_file() -> u64 {
    return (&sch_file[0 as usize]) as u64
}

fn theme_contrast(a: u64, b: u64) -> u64 {
    return contrast(a, b)
}

fn theme_luminance(c: u64) -> u64 {
    return luminance(c)
}

fn theme_linear(c: u64) -> u64 {
    if c > 255 {
        return 0
    }
    return lin_of(c)
}

fn theme_on(bg: u64) -> u64 {
    return pick_on(bg)
}

fn theme_light_start() -> u64 {
    return set_light_min
}

fn theme_dark_start() -> u64 {
    return set_dark_min
}

fn theme_tz_offset() -> u64 {
    return tz_offset
}

// ------------------------------------------------------------- names
//
// One blob and an index built by scanning it, instead of a function
// per name. The order MUST match the C_* and S_* numbers above; the
// test walks both lists and says so if it does not.
static mut comp_blob: [u8; 474] = "window-bg\0window-text\0text-muted\0panel-bg\0button-face\0button-hover\0button-pressed\0border\0select-bg\0select-text\0focus-ring\0input-bg\0header-bg\0scroll-track\0scroll-thumb\0accent\0dialog-bg\0menu-bg\0titlebar-bg\0titlebar-text\0titlebar-off-bg\0titlebar-off-text\0window-frame\0taskbar-bg\0taskbar-text\0taskbar-active\0desktop-top\0desktop-bottom\0button-text\0button-disabled-text\0input-text\0input-border\0list-bg\0menu-text\0shadow\0danger\0warning\0success\0on-accent\0accent-hover\0accent-pressed\0"
static mut sem_blob: [u8; 266] = "surface\0surface-raised\0surface-sunken\0surface-hover\0surface-pressed\0text-primary\0text-secondary\0text-disabled\0border\0border-strong\0border-focus\0accent\0accent-hover\0accent-pressed\0accent-disabled\0on-accent\0selection\0on-selection\0overlay\0danger\0warning\0success\0shadow\0"
static mut legacy_blob: [u8; 93] = "bg\0fg\0dim\0panel\0btn\0btnhi\0btndn\0line\0sel\0selfg\0focus\0entry\0head\0scroll\0thumb\0accent\0dlg\0menu\0"
static mut comp_at: [u64; 41] = [0 as u64; 41]
static mut sem_at: [u64; 23] = [0 as u64; 23]
static mut legacy_at: [u64; 18] = [0 as u64; 18]
static mut names_ok: u64 = 0

fn blob_index(blob: u64, out: u64, n: u64) {
    var p: u64 = blob
    var i: u64 = 0
    while i < n {
        __mmio_write64((out + i * 8) as *mut u64, p)
        while *((p) as *mut u8) != 0 as u8 {
            p = p + 1
        }
        p = p + 1
        i = i + 1
    }
}

fn names_init() {
    if names_ok != 0 {
        return
    }
    blob_index((&comp_blob[0 as usize]) as u64,
        (&comp_at[0 as usize]) as u64, C_COUNT)
    blob_index((&sem_blob[0 as usize]) as u64,
        (&sem_at[0 as usize]) as u64, S_COUNT)
    blob_index((&legacy_blob[0 as usize]) as u64,
        (&legacy_at[0 as usize]) as u64, T_COUNT)
    names_ok = 1
}

fn theme_name_at(i: u64) -> u64 {
    names_init()
    if i >= C_COUNT {
        return 0
    }
    return comp_at[(i) as usize]
}

fn theme_semantic_name_at(i: u64) -> u64 {
    names_init()
    if i >= S_COUNT {
        return 0
    }
    return sem_at[(i) as usize]
}

fn name_eq(p: u64, n: u64, q: u64) -> bool {
    var k: u64 = 0
    while k < n {
        let a: u64 = (*((p + k) as *mut u8)) as u64
        let b: u64 = (*((q + k) as *mut u8)) as u64
        if b == 0 || a != b {
            return false
        }
        k = k + 1
    }
    return (*((q + n) as *mut u8)) as u64 == 0
}

// A name to a component number. The new names first, then the eighteen
// short ones of round K15 -- a /etc/theme written before this round
// still says what it said.
fn theme_named(p: u64, n: u64) -> u64 {
    names_init()
    var i: u64 = 0
    while i < C_COUNT {
        if name_eq(p, n, comp_at[(i) as usize]) {
            return i
        }
        i = i + 1
    }
    var j: u64 = 0
    while j < T_COUNT {
        if name_eq(p, n, legacy_at[(j) as usize]) {
            return j
        }
        j = j + 1
    }
    return C_COUNT
}

// ----------------------------------------------------------- parsing
//
// A scheme file and the settings file have the same shape: key=value,
// one per line, `#` starts a comment, and a line that names nothing is
// COUNTED and not swallowed -- mistype a key and you want to be told,
// not to spend an evening looking for a colour.

fn hex4(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return 16
}

fn parse_hex(p: u64, n: u64) -> u64 {
    var v: u64 = 0
    var digits: u64 = 0
    var k: u64 = 0
    while k < n {
        let d: u64 = hex4((*((p + k) as *mut u8)) as u64)
        if d >= 16 {
            return RGB_BAD
        }
        v = (v << 4) | d
        digits = digits + 1
        k = k + 1
    }
    if digits != 6 {
        return RGB_BAD
    }
    return v
}

fn parse_dec(p: u64, n: u64) -> u64 {
    var v: u64 = 0
    var digits: u64 = 0
    var k: u64 = 0
    while k < n {
        let c: u64 = (*((p + k) as *mut u8)) as u64
        if c < 48 || c > 57 {
            return DEC_BAD
        }
        v = v * 10 + (c - 48)
        digits = digits + 1
        k = k + 1
    }
    if digits == 0 {
        return DEC_BAD
    }
    return v
}

// "07:30" -> 450 minutes. Anything else -> DEC_BAD.
fn parse_clock(p: u64, n: u64) -> u64 {
    var h: u64 = 0
    var m: u64 = 0
    var seen: u64 = 0
    var at: u64 = 0
    var k: u64 = 0
    while k < n {
        let c: u64 = (*((p + k) as *mut u8)) as u64
        if c == 58 {
            if at == 1 {
                return DEC_BAD
            }
            at = 1
            seen = 0
        } else if c >= 48 && c <= 57 {
            if at == 0 {
                h = h * 10 + (c - 48)
            } else {
                m = m * 10 + (c - 48)
            }
            seen = seen + 1
        } else {
            return DEC_BAD
        }
        k = k + 1
    }
    if at != 1 || seen == 0 || h > 23 || m > 59 {
        return DEC_BAD
    }
    return h * 60 + m
}

fn neutral_index(step: u64) -> u64 {
    if step == 0 {
        return N_0
    }
    if step == 50 {
        return N_50
    }
    if step == 100 {
        return N_100
    }
    if step == 200 {
        return N_200
    }
    if step == 300 {
        return N_300
    }
    if step == 400 {
        return N_400
    }
    if step == 500 {
        return N_500
    }
    if step == 600 {
        return N_600
    }
    if step == 700 {
        return N_700
    }
    if step == 800 {
        return N_800
    }
    if step == 900 {
        return N_900
    }
    if step == 950 {
        return N_950
    }
    if step == 1000 {
        return N_1000
    }
    return NEUTRAL_STEPS
}

fn copy_bounded(dst: u64, src: u64, n: u64, max: u64) {
    var k: u64 = 0
    while k < n && k + 1 < max {
        __mmio_write8((dst + k) as *mut u8, *((src + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((dst + k) as *mut u8, 0 as u8)
}

fn scheme_key(kp: u64, kn: u64, vp: u64, vn: u64) -> bool {
    var k_name: [u8; 5] = "name\0"
    var k_mode: [u8; 5] = "mode\0"
    var k_contrast: [u8; 9] = "contrast\0"
    var k_accent: [u8; 7] = "accent\0"
    var k_danger: [u8; 7] = "danger\0"
    var k_warning: [u8; 8] = "warning\0"
    var k_success: [u8; 8] = "success\0"
    var k_neutral: [u8; 8] = "neutral\0"
    var v_dark: [u8; 5] = "dark\0"
    var v_high: [u8; 5] = "high\0"

    if name_eq(kp, kn, (&k_name[0 as usize]) as u64) {
        copy_bounded((&sch_name[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    if name_eq(kp, kn, (&k_mode[0 as usize]) as u64) {
        sch_mode = MODE_LIGHT
        if name_eq(vp, vn, (&v_dark[0 as usize]) as u64) {
            sch_mode = MODE_DARK
        }
        return true
    }
    if name_eq(kp, kn, (&k_contrast[0 as usize]) as u64) {
        sch_high = 0
        if name_eq(vp, vn, (&v_high[0 as usize]) as u64) {
            sch_high = 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_accent[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == RGB_BAD {
            return false
        }
        sch_accent = v
        return true
    }
    if name_eq(kp, kn, (&k_danger[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == RGB_BAD {
            return false
        }
        sch_danger = v
        return true
    }
    if name_eq(kp, kn, (&k_warning[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == RGB_BAD {
            return false
        }
        sch_warning = v
        return true
    }
    if name_eq(kp, kn, (&k_success[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == RGB_BAD {
            return false
        }
        sch_success = v
        return true
    }
    // `neutral<step>`. The literal is exactly seven characters, so
    // comparing seven of them IS the prefix test -- `name_eq` insists
    // that the literal end there, and here it does.
    if kn > 7 {
        if name_eq(kp, 7, (&k_neutral[0 as usize]) as u64) {
            let step: u64 = parse_dec(kp + 7, kn - 7)
            if step == DEC_BAD {
                return false
            }
            let idx: u64 = neutral_index(step)
            if idx >= NEUTRAL_STEPS {
                return false
            }
            let v: u64 = parse_hex(vp, vn)
            if v == RGB_BAD {
                return false
            }
            neutral[(idx) as usize] = v
            return true
        }
    }
    return false
}

fn conf_key(kp: u64, kn: u64, vp: u64, vn: u64) -> bool {
    var k_scheme: [u8; 7] = "scheme\0"
    var k_mode: [u8; 5] = "mode\0"
    var k_accent: [u8; 7] = "accent\0"
    var k_ls: [u8; 12] = "light_start\0"
    var k_ds: [u8; 11] = "dark_start\0"
    var v_dark: [u8; 5] = "dark\0"
    var v_light: [u8; 6] = "light\0"

    if name_eq(kp, kn, (&k_scheme[0 as usize]) as u64) {
        copy_bounded((&sch_file[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    if name_eq(kp, kn, (&k_mode[0 as usize]) as u64) {
        set_mode = MODE_AUTO
        if name_eq(vp, vn, (&v_dark[0 as usize]) as u64) {
            set_mode = MODE_DARK
        }
        if name_eq(vp, vn, (&v_light[0 as usize]) as u64) {
            set_mode = MODE_LIGHT
        }
        return true
    }
    if name_eq(kp, kn, (&k_accent[0 as usize]) as u64) {
        if vn == 0 {
            set_accent = 0
            return true
        }
        let v: u64 = parse_hex(vp, vn)
        if v == RGB_BAD {
            return false
        }
        set_accent = v
        if v == 0 {
            set_accent = ACCENT_BLACK
        }
        return true
    }
    if name_eq(kp, kn, (&k_ls[0 as usize]) as u64) {
        let v: u64 = parse_clock(vp, vn)
        if v == DEC_BAD {
            return false
        }
        set_light_min = v
        return true
    }
    if name_eq(kp, kn, (&k_ds[0 as usize]) as u64) {
        let v: u64 = parse_clock(vp, vn)
        if v == DEC_BAD {
            return false
        }
        set_dark_min = v
        return true
    }
    return false
}

// which: 0 = a scheme file, 1 = the settings file, 2 = the legacy
// /etc/theme override file.
fn kv_read(path: u64, which: u64) -> u64 {
    var buf: [u8; 1536] = [0 as u8; 1536]
    let fd: u64 = io.open(path, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = io.read(fd, (&buf[0 as usize]) as u64, 1535)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return 0
    }
    return kv_scan((&buf[0 as usize]) as u64, n, which)
}

// DIE OKTETTE, DIE SCHON IM SPEICHER LIEGEN. `conf_changed` liest
// /etc/theme.conf, um zu VERGLEICHEN; ohne diese Trennung las
// `theme_reload` dieselbe Datei gleich danach ein zweites Mal, und auf
// einer Platte, die mit PIO angesprochen wird, ist ein Lesen die
// teuerste Zeile im ganzen Umschalten.
fn kv_scan(b: u64, n: u64, which: u64) -> u64 {
    var taken: u64 = 0
    var i: u64 = 0
    while i < n {
        var e: u64 = i
        while e < n && *((b + e) as *mut u8) != 10 as u8 {
            e = e + 1
        }
        var end: u64 = e
        if end > i {
            if *((b + end - 1) as *mut u8) == 13 as u8 {
                end = end - 1
            }
        }
        if end > i {
            if *((b + i) as *mut u8) != 35 as u8 {
                var g: u64 = i
                while g < end && *((b + g) as *mut u8) != 61 as u8 {
                    g = g + 1
                }
                if g < end {
                    var ve: u64 = g + 1
                    while ve < end && *((b + ve) as *mut u8) != 35 as u8 {
                        ve = ve + 1
                    }
                    while ve > g + 1
                        && *((b + ve - 1) as *mut u8) == 32 as u8 {
                        ve = ve - 1
                    }
                    var ok: bool = false
                    if which == 0 {
                        ok = scheme_key(b + i, g - i, b + g + 1,
                            ve - g - 1)
                    } else if which == 1 {
                        ok = conf_key(b + i, g - i, b + g + 1, ve - g - 1)
                    } else if which == 3 {
                        var k_off: [u8; 7] = "offset\0"
                        if name_eq(b + i, g - i,
                            (&k_off[0 as usize]) as u64) {
                            let v: u64 = parse_dec(b + g + 1, ve - g - 1)
                            if v != DEC_BAD && v <= 1440 {
                                tz_offset = v
                                ok = true
                            }
                        }
                    } else {
                        let idx: u64 = theme_named(b + i, g - i)
                        let v: u64 = parse_hex(b + g + 1, ve - g - 1)
                        if idx < C_COUNT && v != RGB_BAD {
                            ovr_val[(idx) as usize] = v
                            ovr_on[(idx) as usize] = 1
                            ovr_n = ovr_n + 1
                            ok = true
                        }
                    }
                    if ok {
                        taken = taken + 1
                    } else {
                        kv_bad = kv_bad + 1
                    }
                } else {
                    kv_bad = kv_bad + 1
                }
            }
        }
        i = e + 1
    }
    return taken
}

// ---------------------------------------------------- the local clock
//
// AUTOMATIC MEANS BY THE CLOCK, and the clock in this machine runs on
// UTC: round K9 gave it `sysinfo`, and this kernel cannot set the
// hardware clock at all. What a program in ring 3 can do is shift the
// DISPLAY, and the shift is the one number in /etc/time.conf:
//
//     offset=120
//
// Without the file it is UTC, and nothing here pretends otherwise.
fn timezone_read() {
    var p_new: [u8; 15] = "/etc/time.conf\0"
    var p_old: [u8; 15] = "/etc/zeit.conf\0"
    // The FILE and not sixty-four octets of it. The first attempt read
    // 63 bytes into a small buffer, and /etc/time.conf opens with two
    // lines of comment -- so the whole read was comment, `offset=` was
    // never reached, and the machine ran on UTC while the file said
    // otherwise. `kv_read` reads the file and skips comments, which is
    // what a parser is for.
    if kv_read((&p_new[0 as usize]) as u64, 3) > 0 {
        return
    }
    // The file was called /etc/zeit.conf before the names were
    // translated. Reading both is one line; a machine that loses its
    // timezone on an upgrade is not.
    let _o: u64 = kv_read((&p_old[0 as usize]) as u64, 3)
}

fn local_minutes() -> u64 {
    let h: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_HOUR, 0, 0)
    let m: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_MIN, 0, 0)
    if ulib.bad(h) || ulib.bad(m) {
        return 1441
    }
    return ((h * 60 + m) + tz_offset) % 1440
}

// Dark from dark_start until light_start, wrapping over midnight --
// 19:00 to 07:00 is the normal case and it is exactly the one a naive
// `a <= t && t < b` gets wrong.
fn auto_is_dark() -> bool {
    let t: u64 = local_minutes()
    if t > 1440 {
        return sch_mode == MODE_DARK
    }
    if set_dark_min > set_light_min {
        return t >= set_dark_min || t < set_light_min
    }
    return t >= set_dark_min && t < set_light_min
}

fn effective_dark() -> bool {
    if set_mode == MODE_LIGHT {
        return false
    }
    if set_mode == MODE_DARK {
        return true
    }
    return auto_is_dark()
}

fn theme_auto_dark() -> bool {
    return auto_is_dark()
}

// ---------------------------------------------------------- applying
//
// primitives -> semantics -> components -> publish. The one place the
// three layers are put together, and the only writer of `sem`.
fn theme_apply() {
    let dark: bool = effective_dark()
    cur_dark = 0
    if dark {
        cur_dark = 1
    }
    var acc: u64 = sch_accent
    if set_accent != 0 {
        acc = set_accent
        if set_accent == ACCENT_BLACK {
            acc = 0
        }
    }
    ramp_build(R_ACCENT, acc)
    ramp_build(R_DANGER, sch_danger)
    ramp_build(R_WARNING, sch_warning)
    ramp_build(R_SUCCESS, sch_success)
    bind_neutrals(dark)
    bind_accent(dark)
    publish()
}

// THE ONLY RAW COLOURS IN THE SYSTEM ARE THE NEXT NINETEEN LINES, and
// they are here because a machine whose /etc is empty still has to
// draw a window. They are the Slate ramp of assets/schemes/day.scheme;
// if that file is on the disk it overwrites every one of them.
// tests/theme/rawcolour.py counts colour literals everywhere else and
// the answer has to be nought.
fn primitives_builtin() {
    neutral[(N_0) as usize] = 0x00FFFFFF
    neutral[(N_50) as usize] = 0x00F8FAFC
    neutral[(N_100) as usize] = 0x00F1F5F9
    neutral[(N_200) as usize] = 0x00E2E8F0
    neutral[(N_300) as usize] = 0x00CBD5E1
    neutral[(N_400) as usize] = 0x0094A3B8
    neutral[(N_500) as usize] = 0x0064748B
    neutral[(N_600) as usize] = 0x00475569
    neutral[(N_700) as usize] = 0x00334155
    neutral[(N_800) as usize] = 0x001E293B
    neutral[(N_900) as usize] = 0x000F172A
    neutral[(N_950) as usize] = 0x00020617
    neutral[(N_1000) as usize] = 0x00000000
    sch_accent = 0x002563EB
    sch_danger = 0x00DC2626
    sch_warning = 0x00B45309
    sch_success = 0x0015803D
    sch_mode = MODE_DARK
    sch_high = 0
}

fn path_join(dir: u64, name: u64, out: u64, max: u64) {
    var at: u64 = 0
    var k: u64 = 0
    while *((dir + k) as *mut u8) != 0 as u8 && at + 1 < max {
        __mmio_write8((out + at) as *mut u8, *((dir + k) as *mut u8))
        at = at + 1
        k = k + 1
    }
    k = 0
    while *((name + k) as *mut u8) != 0 as u8 && at + 1 < max {
        __mmio_write8((out + at) as *mut u8, *((name + k) as *mut u8))
        at = at + 1
        k = k + 1
    }
    __mmio_write8((out + at) as *mut u8, 0 as u8)
}

// A checksum over the RESOLVED component table. Equality here means
// "the same forty-one values", which is the only question a program
// asking "must I repaint?" actually has.
fn theme_sum() -> u64 {
    var h: u64 = 1469598103934665603
    var i: u64 = 0
    while i < C_COUNT {
        h = (h ^ tok[((live * C_COUNT + i)) as usize]) *% 1099511628211
        i = i + 1
    }
    return h
}

// The whole chain from the disk: settings, scheme, legacy override,
// timezone, resolve. Answers the generation.
// `aus_kopie` sagt, ob /etc/theme.conf aus der Kopie genommen werden
// darf, die `conf_changed` gerade gelesen hat. Nur `theme_poll` darf
// ja sagen, und nur, weil es die Datei EBEN gelesen hat. Jeder andere
// bekommt einen frischen Lesevorgang.
//
// Die Unterscheidung ist keine Feinheit. Ohne sie loest ein Programm,
// das /etc/theme.conf SCHREIBT und sofort neu laedt -- und genau das
// tun das Einstellungsfenster und das Testprogramm --, die Datei auf,
// die es gerade ersetzt hat. Der Testlauf hat es gefunden: fuenf von
// zehn Schemalaeufen kamen mit den Farben des anderen Modus zurueck,
// und zwar immer genau EINEN Schritt hinterher.
fn reload_inner(aus_kopie: bool) -> u64 {
    var p_conf: [u8; 16] = "/etc/theme.conf\0"
    var p_dir: [u8; 14] = "/etc/schemas/\0"
    var p_theme: [u8; 11] = "/etc/theme\0"
    var path: [u8; 64] = [0 as u8; 64]
    kv_bad = 0
    ovr_n = 0
    var z: u64 = 0
    while z < C_COUNT {
        ovr_on[(z) as usize] = 0
        z = z + 1
    }
    primitives_builtin()
    comp_map_init()
    set_mode = MODE_AUTO
    set_accent = 0
    __mmio_write8(((&sch_file[0 as usize]) as u64) as *mut u8, 0 as u8)
    __mmio_write8(((&sch_name[0 as usize]) as u64) as *mut u8, 0 as u8)
    var nc: u64 = 0
    if aus_kopie && conf_len > 0 {
        nc = kv_scan((&conf_copy[0 as usize]) as u64, conf_len, 1)
    } else {
        nc = kv_read((&p_conf[0 as usize]) as u64, 1)
    }
    let _nc: u64 = nc
    // RUNDE A11Y: DER HOHE KONTRAST SCHLAEGT DIE WAHL DES BENUTZERS.
    //
    // Das ist eine Entscheidung und keine Bequemlichkeit. Wer den hohen
    // Kontrast einschaltet, tut das, weil er sonst nichts erkennt --
    // dann darf ein `scheme=midnight` in /etc/theme.conf ihn nicht
    // wieder wegnehmen. Das Schema selbst gab es schon
    // (assets/schemes/contrast.scheme, `contrast=high`); was fehlte,
    // war der systemweite Schalter davor.
    if s_high != 0 {
        var p_hc: [u8; 9] = "contrast\0"
        copy_bounded((&sch_file[0 as usize]) as u64,
            (&p_hc[0 as usize]) as u64, 8, 32)
    }
    if *(((&sch_file[0 as usize]) as u64) as *mut u8) != 0 as u8 {
        path_join((&p_dir[0 as usize]) as u64,
            (&sch_file[0 as usize]) as u64,
            (&path[0 as usize]) as u64, 64)
        sch_keys = kv_read((&path[0 as usize]) as u64, 0)
    } else {
        sch_keys = 0
    }
    // OHNE EINSTELLUNGSDATEI GILT DER MODUS DES SCHEMAS, nicht `auto`.
    //
    // Das ist nicht Geschmack, das hat der Testlauf entschieden. Ein
    // Abbild aus Runde K15 hat kein /etc/theme.conf, wohl aber ein
    // /etc/theme mit zwoelf DUNKLEN Flaechenfarben und ohne eine
    // Schriftfarbe. Mit `auto` haengt der Modus dann an der Uhr des
    // Rechners: bei Tag wurde die Schrift hell-auf-hell aufgeloest und
    // ueber die dunklen Flaechen der alten Datei gelegt. Im Bild sah
    // man ein Menue, dessen Text zu 60 Prozent verschwunden war, und
    // tools/k15/run.sh hat genau das gemeldet.
    //
    // `auto` ist eine ausdrueckliche Wahl und darf keine Voreinstellung
    // sein. Ohne Datei gilt, wofuer das Schema gezeichnet wurde.
    if nc == 0 {
        set_mode = sch_mode
    }
    // Die alte Ueberschreibungsdatei ZULETZT, damit eine Maschine aus
    // Runde K15 aussieht wie vorher. Sie ist das einzige im System, was
    // noch eine Farbe benennen darf -- und sie ist eine DATEI, kein Code.
    // RUNDE A11Y: MIT HOHEM KONTRAST BLEIBT AUCH DIE ALTE
    // UEBERSCHREIBUNGSDATEI DRAUSSEN.
    //
    // Gemessen und nicht vermutet: /etc/theme aus Runde K15 nennt
    // zwoelf DUNKLE Flaechenfarben und keine Schriftfarbe. Mit dem
    // Kontrastschema (hell, Schrift schwarz) kam daraus schwarze
    // Schrift auf dunklem Grund -- fg=0 auf bg=0x1C2028, ein
    // Kontrastverhaeltnis von 1,3 zu 1. Der Schalter, der Text lesbar
    // machen soll, machte ihn unlesbar.
    //
    // Also gilt dieselbe Regel wie eine Seite weiter oben: die
    // Barrierefreiheit schlaegt jede andere Farbquelle. Wer den hohen
    // Kontrast einschaltet, bekommt ihn -- ganz.
    if s_high == 0 {
        let _no: u64 = kv_read((&p_theme[0 as usize]) as u64, 2)
    }
    timezone_read()
    theme_apply()
    booted = 1
    let _c: bool = conf_changed()
    return generation
}

fn theme_reload() -> u64 {
    return reload_inner(false)
}

// HAT SICH /etc/theme.conf GEAENDERT? Ein Vergleich der Oktette und
// nicht ein Zeitstempel -- dieses Dateisystem fuehrt keinen, und die
// Groesse allein sagt nichts (`mode=dark` und `mode=auto` sind gleich
// lang).
fn conf_changed() -> bool {
    var p_conf: [u8; 16] = "/etc/theme.conf\0"
    var buf: [u8; 512] = [0 as u8; 512]
    var n: u64 = 0
    let fd: u64 = io.open((&p_conf[0 as usize]) as u64, 0)
    if !ulib.bad(fd) {
        let r: u64 = io.read(fd, (&buf[0 as usize]) as u64, 511)
        io.close(fd)
        if !ulib.bad(r) {
            n = r
        }
    }
    var same: bool = n == conf_len
    if same {
        var k: u64 = 0
        while k < n {
            if buf[(k) as usize] != conf_copy[(k) as usize] {
                same = false
                k = n
            } else {
                k = k + 1
            }
        }
    }
    if same {
        return false
    }
    var k2: u64 = 0
    while k2 < n {
        conf_copy[(k2) as usize] = buf[(k2) as usize]
        k2 = k2 + 1
    }
    conf_len = n
    return true
}

// WAS EIN PROGRAMM IN SEINER EREIGNISSCHLEIFE AUFRUFT.
//
// Der teure Weg ist der ganze Neuaufbau: drei Dateien lesen, vier
// Rampen bauen, die Kontrastsuche laufen lassen. Gemessen kostet das
// ein Vielfaches dessen, was das Aufloesen allein kostet, und fast
// alles davon ist die Platte -- die Zahlen stehen in
// docs/ROUNDTHEME.md. Ein Schreibtisch, der das zehnmal in der
// Sekunde tut, tut nichts anderes mehr.
//
// Also zwei billige Fragen zuerst:
//
//   1. Haben sich die Oktette von /etc/theme.conf geaendert? Das ist
//      EINE kleine Datei statt dreien und der einzige Weg, auf dem
//      eine Einstellung hereinkommt.
//   2. Steht der Modus auf `auto` und hat die UHR die Bindung
//      umgelegt? Das kostet zwei Systemaufrufe und keine Platte.
//
// WAS DAMIT NICHT ERKANNT WIRD, und es steht hier und nicht in einer
// Fussnote: eine Aenderung IN einer Schemadatei unter /etc/schemas/,
// waehrend dieses Schema ausgewaehlt ist. Wer eine Schemadatei
// bearbeitet, muss /etc/theme.conf anfassen -- oder das Programm neu
// starten. Ein Schema ist Inhalt und keine Einstellung.
fn theme_poll() -> bool {
    if conf_changed() {
        let before: u64 = theme_sum()
        let _g: u64 = reload_inner(true)
        return theme_sum() != before
    }
    if set_mode == MODE_AUTO {
        var want: u64 = 0
        if auto_is_dark() {
            want = 1
        }
        if want != cur_dark {
            let before: u64 = theme_sum()
            theme_apply()
            return theme_sum() != before
        }
    }
    return false
}

fn theme_set_mode(m: u64) {
    if m <= MODE_AUTO {
        set_mode = m
        theme_apply()
    }
}

fn theme_set_accent(rgb: u64) {
    set_accent = rgb & RGB24
    if set_accent == 0 {
        set_accent = ACCENT_BLACK
    }
    theme_apply()
}

fn theme_clear_accent() {
    set_accent = 0
    theme_apply()
}

fn theme_bad_keys() -> u64 {
    return kv_bad
}

fn theme_scheme_keys() -> u64 {
    return sch_keys
}

// WIE VIELE FARBEN DIE UEBERSCHREIBUNGSDATEI WIRKLICH GESETZT HAT.
//
// Das war die Bedeutung in Runde K15 und sie bleibt es. Diese Runde
// hatte sie kurz auf "wie viele Marken es gibt" umgedeutet, und
// tools/k15/run.sh hat das in einer Zeile gemeldet: erwartet 12,
// bekommen 41. Eine Funktion, deren Name gleich bleibt und deren
// Bedeutung sich aendert, ist schlimmer als eine umbenannte.
fn theme_count() -> u64 {
    return ovr_n
}

// Wie viele Komponentenmarken es gibt. Das ist die neue Frage und sie
// bekommt einen neuen Namen.
fn theme_token_count() -> u64 {
    return C_COUNT
}

fn theme_semantic_count() -> u64 {
    return S_COUNT
}

fn theme_override_count() -> u64 {
    return ovr_n
}

// ------------------------------------------ the round K15 entry points
//
// `theme_load` read eighteen colours out of /etc/theme and that was
// the whole theme. It still works, and it still means the same thing:
// the file OVERRIDES resolved tokens by name. What changed is that it
// is now the last step of a resolve and not the resolve itself, so a
// file that sets `bg` no longer decides what `text-primary` should be.
fn theme_load(path: u64) -> u64 {
    if booted == 0 {
        let _g: u64 = theme_reload()
    }
    // RUNDE A11Y: MIT HOHEM KONTRAST NIMMT DIESER WEG KEINE FARBE MEHR
    // AN. `wlib.begin` ruft diese Funktion mit /etc/theme -- der alten
    // Ueberschreibungsdatei aus Runde K15 --, und das war der zweite
    // Weg, auf dem zwoelf dunkle Flaechenfarben ueber ein helles
    // Kontrastschema kamen. GEMESSEN: fg=0 auf bg=0x1C2030, also
    // schwarz auf dunkelgrau, Verhaeltnis 1,3 zu 1. Der erste Weg
    // (`reload_inner`) war schon zu, dieser war es nicht -- und genau
    // deshalb steht hier eine zweite Zeile und keine Anmerkung.
    if s_high != 0 {
        return 0
    }
    ovr_n = 0
    var z: u64 = 0
    while z < C_COUNT {
        ovr_on[(z) as usize] = 0
        z = z + 1
    }
    let n: u64 = kv_read(path, 2)
    theme_apply()
    return n
}

// One token by hand, without a file -- the settings window shows a
// preview while a scheme is being picked and only writes on Apply.
fn theme_set(i: u64, v: u64) {
    if i < C_COUNT {
        ovr_val[(i) as usize] = v
        ovr_on[(i) as usize] = 1
        theme_apply()
    }
}

// ====================================================== RUNDE DESKTOP
//
// DREI AUFRUFE, EINE ZEILE JEDER. Sie stehen hier und nicht in
// `wlib.fi`, weil sie kein Widget kennen: eine Ebene, ein verborgenes
// Fenster und eine Fenstertafel sind Begriffe des SERVERS.

// Den eigenen Zustand setzen: Ebene, verborgen, Schmuck.
fn win_state(h: u64, was: u64, wert: u64) -> u64 {
    return sys3w(WM_STATE, h, was, wert)
}

// EINEN Satz aus der Fenstertafel holen. 1 = der Platz ist belegt,
// 0 = er ist frei, negativ = dieser Prozess ist keine Taskleiste.
fn win_list(platz: u64, aus: u64) -> u64 {
    return sys3w(WM_LIST, platz, aus, WL_BYTES)
}

// Ein FREMDES Fenster hervorholen oder wegtun. Erstes Argument ist
// seine Nummer aus WL_ID und kein Handle -- fuer fremde Fenster gibt
// es keines.
fn win_act(id: u64, was: u64) -> u64 {
    return sys3w(WM_ACT, id, was, 0)
}

// ---------------------------------------------------- RUNDE THEME
//
// DIE FENSTERDEKORATION AN DEN SERVER GEBEN.
//
// Rahmen und Titelleiste malt der Fensterserver -- er muss, er setzt
// das Bild zusammen --, und damit war die Titelleiste bis zu dieser
// Runde die einzige Flaeche der Oberflaeche, die kein Schema erreichte.
// Hier stehen die acht Farben, die er dafuer bekommt, und sie sind
// AUSSCHLIESSLICH Komponentenmarken: der Kernel bekommt kein Thema, er
// bekommt acht aufgeloeste Zahlen.
//
// Wer darf das? Wer eine Taskleiste IST (ein Fenster auf Ebene L_TOP).
// Duerfte es jede Anwendung, koennte jede Anwendung jede fremde
// Titelleiste faerben. Fuer alle anderen kommt -E_RIGHTS zurueck und
// diese Funktion antwortet 0 -- das ist kein Fehler, das ist die
// Rechtelage.
const DECO_SLOTS: u64 = 11

fn deco_one(slot: u64, colour: u64) -> u64 {
    if ulib.bad(sys3w(WM_DECO, slot, colour, 0)) {
        return 0
    }
    return 1
}

fn deco_push() -> u64 {
    var n: u64 = 0
    n = n + deco_one(0, theme_live(C_WINDOW_FRAME))
    n = n + deco_one(1, theme_live(C_TITLEBAR_OFF_BG))
    n = n + deco_one(2, theme_live(C_TITLEBAR_OFF_TEXT))
    n = n + deco_one(3, theme_live(C_ACCENT))
    n = n + deco_one(4, theme_live(C_TITLEBAR_BG))
    n = n + deco_one(5, theme_live(C_TITLEBAR_TEXT))
    n = n + deco_one(6, theme_live(C_DANGER))
    // Das Kreuz auf dem Schliessfeld bekommt die Farbe, die auf ROT
    // lesbar ist, und nicht die, die frueher dort stand. Dieselbe
    // Rechnung wie fuer die Schrift auf der Akzentfarbe.
    n = n + deco_one(7, theme_on(theme_live(C_DANGER)))
    // Der Grund unter allen Fenstern und die beiden Farben eines
    // Terminalfensters. Der Grund ist normalerweise vom Schreibtisch
    // verdeckt -- normalerweise: laeuft keiner, sieht man ihn, und
    // dann soll er nicht aus einem anderen Thema stammen.
    n = n + deco_one(8, theme_live(C_DESKTOP_BOTTOM))
    n = n + deco_one(9, theme_live(C_WINDOW_TEXT))
    n = n + deco_one(10, theme_live(C_INPUT_BG))
    return n
}

// ================== ADDENDUM TASKBAR: THE WORK AREA, SEEN FROM RING 3
//
// Six one-line calls. They exist so that no application has to know
// that a taskbar is 28 pixels high or which edge it is on -- it asks
// for the free rectangle and gets it. That is the whole point of a
// strut: the reservation is declared once and read everywhere.

// Reserve `size` pixels of screen edge `edge` for this window. Only a
// window on layer 0 or 2 may; everyone else gets a negative result.
// `size == 0` gives the edge back.
fn win_strut(h: u64, edge: u64, size: u64) -> u64 {
    return sys3w(WM_STRUT, h, edge, size)
}

// Change the size of this window. It cannot grow past the buffer it was
// created with; the server says so instead of pretending.
fn win_size(h: u64, w: u64, hh: u64) -> u64 {
    return sys3w(WM_SIZE, h, (w << 16) | hh, 0)
}

// Fill the work area -- and keep filling it when it changes.
fn win_max(h: u64, on: bool) -> u64 {
    var v: u64 = 0
    if on {
        v = 1
    }
    return sys3w(WM_STATE, h, WS_MAXIMIZED, v)
}

fn work_x(h: u64) -> u64 {
    return sys3w(WM_INFO, h, WI_WORKX, 0)
}

fn work_y(h: u64) -> u64 {
    return sys3w(WM_INFO, h, WI_WORKY, 0)
}

fn work_w(h: u64) -> u64 {
    return sys3w(WM_INFO, h, WI_WORKW, 0)
}

fn work_h(h: u64) -> u64 {
    return sys3w(WM_INFO, h, WI_WORKH, 0)
}

// THE NAME OF AN EDGE, and its opposite. /etc/taskbar.conf holds words
// and not numbers, because a configuration file that says `edge=2` is a
// file nobody can read without the source. The two directions of the
// translation stand next to each other here, in ONE place -- the
// taskbar reads and the settings application writes, and they must not
// disagree.
static mut e_names: [u8; 23] = "bottom\0top\0left\0right\0\0"

fn edge_name(e: u64) -> u64 {
    let b: u64 = (&e_names[0 as usize]) as u64
    var i: u64 = 0
    var k: u64 = 0
    while k < e && i < 24 {
        if __mmio_read8((b + i) as *mut u8) == 0 as u8 {
            k = k + 1
        }
        i = i + 1
    }
    return b + i
}

fn edge_by_name(p: u64) -> u64 {
    var e: u64 = 0
    while e < 4 {
        let q: u64 = edge_name(e)
        var i: u64 = 0
        var gleich: bool = true
        while __mmio_read8((q + i) as *mut u8) != 0 as u8 {
            if __mmio_read8((p + i) as *mut u8)
                != __mmio_read8((q + i) as *mut u8) {
                gleich = false
            }
            i = i + 1
        }
        if gleich && __mmio_read8((p + i) as *mut u8) == 0 as u8 {
            return e
        }
        e = e + 1
    }
    return 4 // no such edge -- the caller keeps what it had
}


// ---------------------------------------------------------- ROUND ICONS
//
// AN ICON IS A GLYPH.  Everything below goes through the same path as a
// letter -- `gfind` into the Ring 3 glyph cache, WIG_GLYPH into the
// kernel rasteriser, `draw_glyph` onto the surface -- and that is the
// whole point of the round.  What it buys, measured in docs/ICONS.md:
//
//   * ONE COLOUR, PASSED IN.  The glyph is a coverage field, so the
//     caller mixes it with whatever colour it likes.  Light theme and
//     dark theme need no second set of pictures; they pass a different
//     colour.  A bitmap icon cannot do that -- its colours are baked.
//   * ONE OUTLINE, ANY SIZE.  16, 20 and 24 pixels come out of the same
//     outline, rasterised once each and then cached.  A bitmap needs
//     one file per size.
//   * THE CACHE IS SHARED WITH TEXT.  An interface that draws forty
//     icons and eight hundred characters keeps them in the same 512
//     slots and pays one system call per (font, size, glyph).
//
// WHAT THE CALLER MUST NOT DO: write a code point here.  Every one of
// these takes `id`, and every `id` comes from `icons.fi` by name.
// `tools/icons/rawcp.py` counts the ones that do not and the count has
// to stay 0.

// Is there an icon font at all?  A system whose disk has no
// /lib/icons.ttf is a system without icons, not a broken one -- the
// caller draws its text and leaves the box empty.
fn icon_have() -> bool {
    return gfind(F_ICON, ICON_SMALL, icons.NETWORK_WIRED)
        != 0xFFFFFFFFFFFFFFFF
}

// The box an icon occupies at size `px_`: square, `px_` on a side.
//
// This holds because the icon font's ascent is its whole em (the
// builder prints it: upm 1000, ascent 1000, descent 0) and every glyph
// is one em wide.  So the em box sits entirely ABOVE the baseline, and
// an icon placed with its baseline at `y + px_` fills exactly
// `y .. y + px_`.  It is a property of the font, so it is asserted in
// `kernel/user/icont.fi` rather than assumed here.
fn icon_box(px_: u64) -> u64 {
    return px_
}

// The ink of an icon -- what it actually covers, which is smaller than
// the box.  Wanted by anyone centring an icon against text.
fn icon_ink_w(id: u64, px_: u64) -> u64 {
    let at: u64 = gfind(F_ICON, px_, id)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return gc[(at + GC_W) as usize]
}

fn icon_ink_h(id: u64, px_: u64) -> u64 {
    let at: u64 = gfind(F_ICON, px_, id)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return gc[(at + GC_H) as usize]
}

// ONE ICON, top left corner at (x, y), `px_` on a side, in `color`.
//
// `color` is a value the caller got from the theme (`theme(T_...)`),
// never a literal -- that is round THEME's rule and this round does not
// break it.  What this round adds is that the SAME call works in light
// and in dark: the glyph carries no colour of its own.
//
// Returns false when there is no such glyph, so that a caller can fall
// back to a label instead of silently drawing nothing.
fn icon_at(id: u64, x: u64, y: u64, px_: u64, color: u64) -> bool {
    let at: u64 = gfind(F_ICON, px_, id)
    if at == 0xFFFFFFFFFFFFFFFF {
        return false
    }
    if gc[(at + GC_W) as usize] == 0 || gc[(at + GC_H) as usize] == 0 {
        return false
    }
    draw_glyph(at, x as i64, (y + px_) as i64, color)
    return true
}

// ============================================ ROUND NETVIEW, addendum
//
// AN ICON WHOSE COLOURS COME FROM THE SCHEME.
//
// OSYM (`tools/k15/icon.py`) stores four octets per pixel: blue,
// green, red, coverage. Coverage 0 has always meant transparent and 255
// has always meant "these three octets are the colour". This round uses
// the numbers in between -- 1 to 5 -- to mean "ask the scheme": ink,
// dim, accent, warn, panel.
//
// WHY IN THE COVERAGE OCTET AND NOT IN A SECOND FILE FORMAT. Because
// every symbol that existed before this addendum carries 0 and 255 and
// therefore does not change by one octet; `tools/k15/run.sh` reads all
// five bundle symbols back pixel by pixel and would say so. A second
// format would have been a second reader, a second writer and a second
// place to be wrong.
//
// AND THIS IS WHAT MAKES ONE DRAWING RIGHT IN BOTH SCHEMES. A taskbar
// icon with 0xE8EEF4 written into it is a light icon; on a light scheme
// it is a white shape on a white bar, which is not an icon. A drawing
// that says `@ink` is whatever the running scheme calls its foreground,
// and the same file is right in both.
const ICON_ROLES: u64 = 5

fn icon_role(a: u64) -> u64 {
    if a == 1 {
        return theme(T_FG)
    }
    if a == 2 {
        return theme(T_DIM)
    }
    if a == 3 {
        return theme(T_ACCENT)
    }
    if a == 4 {
        return theme(T_FOCUS)
    }
    if a == 5 {
        return theme(T_PANEL)
    }
    return theme(T_FG)
}

// "OSYM", octet by octet -- read as one number it would depend on the
// byte order of the machine, and the header of a file does not.
fn icon_ok(p: u64) -> bool {
    if p == 0 {
        return false
    }
    if __mmio_read8((p) as *mut u8) != 79 as u8 {
        return false
    }
    if __mmio_read8((p + 1) as *mut u8) != 83 as u8 {
        return false
    }
    if __mmio_read8((p + 2) as *mut u8) != 89 as u8 {
        return false
    }
    return __mmio_read8((p + 3) as *mut u8) == 77 as u8
}

fn icon_w(p: u64) -> u64 {
    if !icon_ok(p) {
        return 0
    }
    return __mmio_read32((p + 4) as *mut u32) as u64
}

fn icon_h(p: u64) -> u64 {
    if !icon_ok(p) {
        return 0
    }
    return __mmio_read32((p + 8) as *mut u32) as u64
}

// The picture at x, y. Transparent pixels leave what is underneath
// alone -- so an icon on a taskbar button keeps the button's face, and
// a pixel checker that measures the face at the corners still finds it.
fn icon_draw(p: u64, x: u64, y: u64) -> bool {
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return false
    }
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let v: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            let a: u64 = (v >> 24) & 0xFF
            if a != 0 {
                if a == 255 {
                    px(x + c, y + r, v & RGB24)
                } else {
                    px(x + c, y + r, icon_role(a))
                }
            }
            c = c + 1
        }
        r = r + 1
    }
    return true
}
