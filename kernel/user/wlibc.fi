const WO_KEYS: u64 = 4
const WO_OPAC: u64 = 8
const WO_SHIFT: u64 = 8
const WO_KNOWN: u64 = 0xFF0F

fn win_opts(frameless: bool, keys: bool, opac: u64) -> u64 {
    var o: u64 = 0
    if frameless {
        o = o | WO_FRAMELESS
    }
    if keys {
        o = o | WO_KEYS
    }
    if opac <= 255 {
        o = o | WO_OPAC | (opac << WO_SHIFT)
    }
    return o
}

fn win_set_opac(h: u64, v: u64) -> u64 {
    return sys3w(WM_STATE, h, WS_OPAC, v)
}

fn win_backlum(h: u64, which: u64) -> u64 {
    return sys3w(WM_INFO, h, which, 0)
}

