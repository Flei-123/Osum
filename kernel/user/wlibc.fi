const WM_DECO: u64 = 2114
// ROUND PAINT.  The same number as `sys.WM_FORM`, and the same four
// slot numbers as `wm.FM_*`.  Written down a third time here because a
// library in ring 3 may not import the kernel; tools/paint/run.sh holds
// the three lists against each other.
const WM_FORM: u64 = 2115
// RUNDE GLAS: dreizehn Plaetze. Die Zahl stand hier auf 4, seit Runde
// PAINT sie geschrieben hat, und war schon vor dieser Runde falsch --
// SOFTUI und VSYNC haben fuenf Plaetze dazugelegt, ohne sie zu
// erhoehen. Sie wird nirgends als Schranke benutzt (der Server klemmt
// selbst), aber eine Zahl, die eine Liste zaehlt und sie nicht zaehlt,
// ist genau die Naht, an der die naechste Runde danebengreift.
const FORM_SLOTS: u64 = 13
const WF_RADIUS: u64 = 0
const WF_SHADOW: u64 = 1
const WF_SHADOW_R: u64 = 2
const WF_SHADOW_C: u64 = 3
// ROUND SOFTUI: four more, and still no notion of a shape on the other
// side.  The server learns that the flat shadow is twelve per cent and
// four pixels; it does not learn that there is a file called
// `modern.shape`.
const WF_SHADOW2: u64 = 4
const WF_SHADOW_R2: u64 = 5
const WF_GRAD: u64 = 6
const WF_CAPTION: u64 = 7
// RUNDE VSYNC: die Dauer einer Fensterbewegung in Millisekunden.  Sie
