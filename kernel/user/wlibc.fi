fn sys5(number: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, in("r10") a3, in("r8") a4,
        clobber("rcx"), clobber("r11"), clobber("memory"))
}

fn sys3w(number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

const AX_PUSH: u64 = 1910
const AX_READ: u64 = 1911
const AX_EVENT: u64 = 1912
const AX_PERM: u64 = 1913
const AX_INFO: u64 = 1914
const AX_SET: u64 = 1915
const AX_PRESS: u64 = 1916
const AXP_MINE: u64 = 0
const AXP_GRANT: u64 = 1
const AXP_REVOKE: u64 = 2
const AXP_COUNT: u64 = 3
const AXP_READ: u64 = 1
const AXP_ACT: u64 = 2
const AXI_COUNT: u64 = 0
const AXI_GEN: u64 = 1
const AXI_PUSHES: u64 = 2
const AXI_READS: u64 = 3
const AXI_DENIED: u64 = 4
const AXI_SECRETS: u64 = 5
const AXI_LEAKS: u64 = 6
const AXI_HIGH: u64 = 7
const AXI_MAG: u64 = 8
const AXI_STICKY: u64 = 9
const AXI_EVENTS: u64 = 10
const AXI_EVDROP: u64 = 11
const AXI_ON: u64 = 12
const AXI_FOREIGN: u64 = 13
const AXI_PRESSES: u64 = 14
const AXI_REFUSED: u64 = 15
const AXC_HIGH: u64 = 0
const AXC_MAG: u64 = 1
const AXC_STICKY: u64 = 2
const AXC_ON: u64 = 3
const AXC_DUMP: u64 = 99

const EV_AXPRESS: u64 = 8

const EV_WHEEL: u64 = 9

const EV_HWHEEL: u64 = 10

fn ax_info(field: u64) -> u64 {
    return sys3w(AX_INFO, field, 0, 0)
}

fn ax_set(field: u64, v: u64) -> u64 {
    return sys3w(AX_SET, field, v, 0)
}

fn ax_perm(op: u64, task: u64, bits: u64) -> u64 {
    return sys3w(AX_PERM, op, task, bits)
}

fn ax_begin() -> u64 {
    return sys3w(AX_PUSH, 0, 1, 0)
}

fn ax_send(ptr: u64, n: u64) -> u64 {
    return sys3w(AX_PUSH, ptr, n, 0)
}

fn ax_end() -> u64 {
    return sys3w(AX_PUSH, 0, 0, 0)
}

fn ax_read(nr: u64, dst: u64, len: u64) -> u64 {
    return sys3w(AX_READ, nr, dst, len)
}

fn ax_event(dst: u64, len: u64) -> u64 {
    return sys3w(AX_EVENT, dst, len, 0)
}

fn ax_press(nr: u64, gen: u64) -> u64 {
    return sys3w(AX_PRESS, nr, gen, 0)
}

fn ax_high() -> u64 {
    if ax_info(AXI_HIGH) == 1 {
        return 1
    }
    return 0
}

fn map_surface(bytes: u64) -> u64 {
    let no: u64 = 0 -% 1
    return asm("syscall", out("rax"), in("rax") SYS_MMAP, in("rdi") 0,
        in("rsi") bytes, in("rdx") PROT_RW, in("r10") MAP_ANON_PRIV,
        in("r8") no, in("r9") 0, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

static mut s_shfd: u64 = 0

fn shm_last_fd() -> u64 {
    return s_shfd
}

fn shm_close(fd: u64) {
    let _r: u64 = sys3w(SYS_CLOSE_FD, fd, 0, 0)
}

fn shm_unmap(p: u64, bytes: u64) {
    let _r: u64 = sys3w(SYS_MUNMAP, p, bytes, 0)
}

fn shm_buffer(bytes: u64) -> u64 {
    if bytes == 0 {
        return 0
    }
    let fd: u64 = sys3w(SYS_MEMFD_CREATE, 0, MFD_FRAMES, 0)
    if ulib.bad(fd) {
        return 0
    }
    if ulib.bad(sys3w(SYS_FTRUNCATE, fd, bytes, 0)) {
        shm_close(fd)
        return 0
    }
    let p: u64 = asm("syscall", out("rax"), in("rax") SYS_MMAP, in("rdi") 0,
        in("rsi") bytes, in("rdx") PROT_RW, in("r10") MAP_SHARED_FLAG,
        in("r8") fd, in("r9") 0, clobber("rcx"), clobber("r11"),
        clobber("memory"))
    if ulib.bad(p) || p == 0 {
        shm_close(fd)
        return 0
    }
    s_shfd = fd
    return p
}

fn win_setbuf(h: u64, fd: u64) -> bool {
    return !ulib.bad(sys3w(WM_SETBUF, h, fd, 0))
}

fn win_damage(h: u64, x: u64, y: u64, w: u64, hh: u64) -> u64 {
    return sys3w(WM_DAMAGE, h, (x << 16) | y, (w << 16) | hh)
}

fn win_shared(h: u64) -> bool {
    return sys3w(WM_INFO, h, WI_SHARED, 0) == 1
}

fn start(noclip: bool) -> bool {
    if s_ready != 0 {
        return true
    }
    s_scr_w = sys3w(WIG_SCREEN, 0, 0, 0)
    s_scr_h = sys3w(WIG_SCREEN, 1, 0, 0)
    if ulib.bad(s_scr_w) || s_scr_w == 0 || s_scr_w > SURF_W_MAX {
        return false
    }
    if ulib.bad(s_scr_h) || s_scr_h == 0 {
        return false
    }
    var rows: u64 = SURF_BUDGET / (s_scr_w *% 4)
    if rows == 0 {
        return false
    }
    if rows > s_scr_h {
        rows = s_scr_h
    }
    let p: u64 = map_surface(s_scr_w *% rows *% 4)
    if ulib.bad(p) || p == 0 {
        return false
    }
    s_surf = p
    s_scap = s_scr_w *% rows *% 4
    s_sw = s_scr_w
    s_srows = rows
    if noclip {
        s_noclip = 1
    }
    let _tg: u64 = theme_reload()
    s_ready = 1
    return true
}

fn ready() -> bool {
    return s_ready != 0
}

fn ui_scale() -> u64 {
    if s_scale == 0 {
        let v: u64 = sys3w(WIG_SCREEN, 6, 0, 0)
        if ulib.bad(v) || v == 0 || v > 4 {
            s_scale = 1
        } else {
            s_scale = v
        }
    }
    return s_scale
}

fn px_ui() -> u64 {
    return PX_UI0 * ui_scale()
}

fn px_mono() -> u64 {
    return PX_MONO0 * ui_scale()
}

fn icon_small() -> u64 {
    return ICON_SMALL0 * ui_scale()
}

fn icon_menu() -> u64 {
    return ICON_MENU0 * ui_scale()
}

fn icon_taskbar() -> u64 {
    return ICON_TASKBAR0 * ui_scale()
}

fn icon_large() -> u64 {
    return ICON_LARGE0 * ui_scale()
}

fn surface() -> u64 {
    return s_surf
}

fn surf_w() -> u64 {
    return s_sw
}

fn surf_rows() -> u64 {
    return s_srows
}

fn band_y() -> u64 {
    return s_band
}

fn screen_w() -> u64 {
    if s_ready != 0 {
        let _r: bool = screen_refresh()
    }
    return s_scr_w
}

fn screen_h() -> u64 {
    if s_ready != 0 {
        let _r: bool = screen_refresh()
    }
    return s_scr_h
}

fn screen_refresh() -> bool {
    let w: u64 = sys3w(WIG_SCREEN, 0, 0, 0)
    let h: u64 = sys3w(WIG_SCREEN, 1, 0, 0)
    if ulib.bad(w) || w == 0 || ulib.bad(h) || h == 0 {
        return false
    }
    if w == s_scr_w && h == s_scr_h {
        return false
    }
    s_scr_w = w
    s_scr_h = h
    band_remake()
    return true
}

fn band_remake() {
    if s_ready == 0 || s_pinned != 0 || s_scr_w == 0 || s_scr_w > SURF_W_MAX {
        return
    }
    var rows: u64 = SURF_BUDGET / (s_scr_w *% 4)
    if rows == 0 {
        return
    }
    if rows > s_scr_h {
        rows = s_scr_h
    }
    let need: u64 = s_scr_w *% rows *% 4
    if need > s_scap {
        let p: u64 = map_surface(SURF_BUDGET)
        if ulib.bad(p) || p == 0 {
            return
        }
        s_surf = p
        s_scap = SURF_BUDGET
    }
    s_sw = s_scr_w
    s_srows = rows
    s_band = 0
}

static mut s_hb_x: u64 = 0
static mut s_hb_y: u64 = 0
static mut s_hb_w: u64 = 0
static mut s_hb_h: u64 = 0

fn set_head_bounds(x: u64, y: u64, w: u64, h: u64) {
    s_hb_x = x
    s_hb_y = y
    s_hb_w = w
    s_hb_h = h
}

fn head_bx() -> u64 {
    return s_hb_x
}

fn head_by() -> u64 {
    return s_hb_y
}

fn head_bw() -> u64 {
    if s_hb_w == 0 {
        return screen_w()
    }
    return s_hb_w
}

fn head_bh() -> u64 {
    if s_hb_h == 0 {
        return screen_h()
    }
    return s_hb_h
}

fn head_count() -> u64 {
    let n: u64 = sys3w(WIG_SCREEN, WS_HEADS, 0, 0)
    if ulib.bad(n) || n == 0 {
        return 1
    }
    return n
}

fn head_field(hd: u64, field: u64) -> u64 {
    return sys3w(WIG_SCREEN, WS_HEAD, hd, field)
}

fn start_head_set(hd: u64) {
    let _r: u64 = sys3w(WIG_SCREEN, WS_STARTHEAD, 1, hd)
}

fn display_mode_raw() -> u64 {
    let r: u64 = sys3w(WIG_SCREEN, WS_DISPMODE, 0, 0)
    if ulib.bad(r) {
        return 0
    }
    return r
}

fn display_mode_mirrored() -> bool {
    return ((display_mode_raw() >> 8) & 1) != 0
}

fn display_mode_connected() -> u64 {
    return display_mode_raw() & 255
}

fn display_mode_set(mirror: bool) -> bool {
    var m: u64 = 0
    if mirror {
        m = 1
    }
    return !ulib.bad(sys3w(WIG_SCREEN, WS_DISPMODE, 1, m))
}

fn start_head_get() -> u64 {
    let r: u64 = sys3w(WIG_SCREEN, WS_STARTHEAD, 0, 0)
    if ulib.bad(r) {
        return 0
    }
    return r
}

fn head_scale(hd: u64) -> u64 {
    let v: u64 = head_field(hd, 5)
    if ulib.bad(v) || v < 100 || v > 300 {
        return 100
    }
    return v
}

fn head_present(hd: u64) -> bool {
    return head_field(hd, 4) == 1
}

fn mouse_x() -> u64 {
    return sys3w(WIG_SCREEN, 2, 0, 0)
}

fn mouse_y() -> u64 {
    return sys3w(WIG_SCREEN, 3, 0, 0)
}

fn mouse_btn() -> u64 {
    return sys3w(WIG_SCREEN, 4, 0, 0)
}

fn set_band(y: u64) {
    if s_pinned != 0 {
        return
    }
    s_band = y
}

fn surf_use(p: u64, rows: u64) {
    s_surf = p
    s_srows = rows
    s_band = 0
    s_pinned = 1
}

fn surf_wide(p: u64, w: u64, rows: u64) {
    s_surf = p
    s_sw = w
    s_srows = rows
    s_band = 0
    s_pinned = 1
}

fn clip_set(x0: u64, y0: u64, x1: u64, y1: u64) {
    s_cx0 = x0
    s_cy0 = y0
    s_cx1 = x1
    s_cy1 = y1
}

fn clip_x0() -> u64 {
    return s_cx0
}

fn clip_y0() -> u64 {
    return s_cy0
}

fn clip_x1() -> u64 {
    return s_cx1
}

fn clip_y1() -> u64 {
    return s_cy1
}

fn px(x: u64, y: u64, color: u64) {
    if x < s_cx0 || x >= s_cx1 || y < s_cy0 || y >= s_cy1 {
        return
    }
    if x >= s_sw || y < s_band {
        return
    }
    let r: u64 = y - s_band
    if r >= s_srows {
        return
    }
    __mmio_write32((s_surf +% (r *% s_sw +% x) *% 4) as *mut u32,
        color as u32)
}

const PLATE: u64 = 0x01000000
static mut s_panel: u64 = 0

fn plate(x: u64, y: u64, w: u64, h: u64) {
    if w == 0 || h == 0 {
        return
    }
    if win_alpha_fx() >= 100 || s_panel != 0 {
        return
    }
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let a: u64 = get(x + c, y + r)
            px(x + c, y + r, (a & 0xFFFFFF) | PLATE)
            c = c + 1
        }
        r = r + 1
    }
}

const INK_R: u64 = 2
fn plate_ink(x: u64, y: u64, w: u64, h: u64) {
    if w == 0 || h == 0 {
        return
    }
    if win_alpha_fx() >= 100 || s_panel != 0 {
        return
    }
    let bg: u64 = get(x, y) & 0xFFFFFF
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let a: u64 = get(x + c, y + r)
            if (a & 0xFFFFFF) != bg {
                var dy: u64 = 0
                while dy <= INK_R * 2 {
                    var dx: u64 = 0
                    while dx <= INK_R * 2 {

                        let qx: u64 = x + c + dx
                        let qy: u64 = y + r + dy
                        if qx >= INK_R && qy >= INK_R {
                            let q: u64 = get(qx - INK_R, qy - INK_R)
                            if (q >> 24) != 1 {
                                px(qx - INK_R, qy - INK_R, (q & 0xFFFFFF) | PLATE)
                            }
                        }
                        dx = dx + 1
                    }
                    dy = dy + 1
                }
            }
            c = c + 1
        }
        r = r + 1
    }
}

fn get(x: u64, y: u64) -> u64 {
    if x >= s_sw || y < s_band {
        return 0
    }
    let r: u64 = y - s_band
    if r >= s_srows {
        return 0
    }
    return __mmio_read32((s_surf +% (r *% s_sw +% x) *% 4)
        as *mut u32) as u64
}

fn blend(alt: u64, fresh: u64, a: u64) -> u64 {
    if a == 0 {
        return alt
    }
    if a >= 255 {
        return fresh
    }
    let ia: u64 = 255 - a

    let r: u64 = mix8((alt >> 16) & 0xFF, (fresh >> 16) & 0xFF, a, ia)
    let g: u64 = mix8((alt >> 8) & 0xFF, (fresh >> 8) & 0xFF, a, ia)
    let b: u64 = mix8(alt & 0xFF, fresh & 0xFF, a, ia)
    return (r << 16) | (g << 8) | b
}

fn mix8(dst: u64, src: u64, a: u64, ia: u64) -> u64 {
    return (src *% a +% dst *% ia +% 127) / 255
}

fn rect(x: u64, y: u64, w: u64, h: u64, color: u64) {
    if w == 0 || h == 0 {
        return
    }
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            px(x + c, y + r, color)
            c = c + 1
        }
        r = r + 1
    }
}

fn hline(x: u64, y: u64, w: u64, color: u64) {
    rect(x, y, w, 1, color)
}

fn vline(x: u64, y: u64, h: u64, color: u64) {
    rect(x, y, 1, h, color)
}

fn frame(x: u64, y: u64, w: u64, h: u64, color: u64) {
    if w < 2 || h < 2 {
        return
    }
    hline(x, y, w, color)
    hline(x, y + h - 1, w, color)
    vline(x, y, h, color)
    vline(x + w - 1, y, h, color)
}

fn frame3(x: u64, y: u64, w: u64, h: u64, bright: u64, dunkel: u64,
    ein: bool) {
    var o: u64 = bright
    var u: u64 = dunkel
    if ein {
        o = dunkel
        u = bright
    }
    if w < 2 || h < 2 {
        return
    }
    hline(x, y, w, o)
    vline(x, y, h, o)
    hline(x, y + h - 1, w, u)
    vline(x + w - 1, y, h, u)
}

const V_EINS: i64 = 64
const V_KAPPA: i64 = 35
const V_TEILE: i64 = 16
const V_MAXP: u64 = 96
const V_MAXK: u64 = 96

static mut vpx: [i64; 96] = [0 as i64; 96]
static mut vpy: [i64; 96] = [0 as i64; 96]
static mut vn: u64 = 0
static mut vkx0: [i64; 96] = [0 as i64; 96]
static mut vky0: [i64; 96] = [0 as i64; 96]
static mut vkx1: [i64; 96] = [0 as i64; 96]
static mut vky1: [i64; 96] = [0 as i64; 96]
static mut vkn: u64 = 0
static mut vstart: u64 = 0
static mut vcx: [i64; 96] = [0 as i64; 96]
static mut vcd: [i64; 96] = [0 as i64; 96]

fn vrdiv(a: i64, b: i64) -> i64 {
    if b == 0 {
        return 0
    }
    var za: i64 = a
    var nb: i64 = b
    if nb < 0 {
        za = 0 - za
        nb = 0 - nb
    }
    if za >= 0 {
        return (za + nb / 2) / nb
    }
    return 0 - ((0 - za) + nb / 2) / nb
}

fn v_new() {
    vn = 0
    vkn = 0
    vstart = 0
}

fn v_point(x: i64, y: i64) {
    if vn >= V_MAXP {
        return
    }
    vpx[(vn) as usize] = x
    vpy[(vn) as usize] = y
    vn = vn + 1
}

fn v_edge(ax: i64, ay: i64, bx: i64, by: i64) {
    if ay == by {
        return
    }
    if vkn >= V_MAXK {
        return
    }
    vkx0[(vkn) as usize] = ax
    vky0[(vkn) as usize] = ay
    vkx1[(vkn) as usize] = bx
    vky1[(vkn) as usize] = by
    vkn = vkn + 1
}

fn v_move_to(x: i64, y: i64) {
    vstart = vn
    v_point(x, y)
}

fn v_line(x: i64, y: i64) {
    v_point(x, y)
}

fn v_kubik(c1x: i64, c1y: i64, c2x: i64, c2y: i64, x: i64, y: i64) {
    if vn == 0 {
        v_move_to(x, y)
        return
    }
    let ax: i64 = vpx[((vn - 1)) as usize]
    let ay: i64 = vpy[((vn - 1)) as usize]
    let n: i64 = V_TEILE
    var i: i64 = 1
    while i <= n {
        let t: i64 = i
        let u: i64 = n - i
        let nnn: i64 = n * n * n
        v_point(vrdiv(u * u * u * ax + 3 * u * u * t * c1x
            + 3 * u * t * t * c2x + t * t * t * x, nnn),
            vrdiv(u * u * u * ay + 3 * u * u * t * c1y
            + 3 * u * t * t * c2y + t * t * t * y, nnn))
        i = i + 1
    }
}

fn v_arc(x0: i64, y0: i64, ex: i64, ey: i64, x1: i64, y1: i64) {
    v_kubik(x0 + vrdiv((ex - x0) * V_KAPPA, 64),
        y0 + vrdiv((ey - y0) * V_KAPPA, 64),
        x1 + vrdiv((ex - x1) * V_KAPPA, 64),
        y1 + vrdiv((ey - y1) * V_KAPPA, 64), x1, y1)
}

fn v_close_path() {
    if vn <= vstart + 1 {
        return
    }
    var i: u64 = vstart
    while i + 1 < vn {
        v_edge(vpx[(i) as usize], vpy[(i) as usize],
            vpx[((i + 1)) as usize], vpy[((i + 1)) as usize])
        i = i + 1
    }
    v_edge(vpx[((vn - 1)) as usize], vpy[((vn - 1)) as usize],
        vpx[(vstart) as usize], vpy[(vstart) as usize])
    vstart = vn
}

fn v_rundeck(x: i64, y: i64, w: i64, h: i64, r0: i64) {
    if w <= 0 || h <= 0 {
        return
    }
    var r: i64 = r0
    if r < 0 {
        r = 0
    }
    if r > w / 2 {
        r = w / 2
    }
    if r > h / 2 {
        r = h / 2
    }
    let x1: i64 = x + w
    let y1: i64 = y + h
    if r == 0 {
        v_move_to(x, y)
        v_line(x1, y)
        v_line(x1, y1)
        v_line(x, y1)
        v_close_path()
        return
    }
    v_move_to(x + r, y)
    v_line(x1 - r, y)
    v_arc(x1 - r, y, x1, y, x1, y + r)
    v_line(x1, y1 - r)
    v_arc(x1, y1 - r, x1, y1, x1 - r, y1)
    v_line(x + r, y1)
    v_arc(x + r, y1, x, y1, x, y1 - r)
    v_line(x, y + r)
    v_arc(x, y + r, x, y, x + r, y)
    v_close_path()
}

fn v_ellipse(cx: i64, cy: i64, rx: i64, ry: i64) {
    if rx <= 0 || ry <= 0 {
        return
    }
    v_move_to(cx, cy - ry)
    v_arc(cx, cy - ry, cx + rx, cy - ry, cx + rx, cy)
    v_arc(cx + rx, cy, cx + rx, cy + ry, cx, cy + ry)
    v_arc(cx, cy + ry, cx - rx, cy + ry, cx - rx, cy)
    v_arc(cx - rx, cy, cx - rx, cy - ry, cx, cy - ry)
    v_close_path()
}

fn v_cross_add(n: u64, x: i64, d: i64) -> u64 {
    if n >= V_MAXK {
        return n
    }
    var j: u64 = n
    while j > 0 {
        if vcx[((j - 1)) as usize] <= x {
            break
        }
        vcx[(j) as usize] = vcx[((j - 1)) as usize]
        vcd[(j) as usize] = vcd[((j - 1)) as usize]
        j = j - 1
    }
    vcx[(j) as usize] = x
    vcd[(j) as usize] = d
    return n + 1
}

fn v_fuellen(color: u64) {
    if vkn == 0 {
        return
    }
    var miny: i64 = vky0[(0) as usize]
    var maxy: i64 = miny
    var minx: i64 = vkx0[(0) as usize]
    var maxx: i64 = minx
    var i: u64 = 0
    while i < vkn {
        if vky0[(i) as usize] < miny { miny = vky0[(i) as usize] }
        if vky1[(i) as usize] < miny { miny = vky1[(i) as usize] }
        if vky0[(i) as usize] > maxy { maxy = vky0[(i) as usize] }
        if vky1[(i) as usize] > maxy { maxy = vky1[(i) as usize] }
        if vkx0[(i) as usize] < minx { minx = vkx0[(i) as usize] }
        if vkx1[(i) as usize] < minx { minx = vkx1[(i) as usize] }
        if vkx0[(i) as usize] > maxx { maxx = vkx0[(i) as usize] }
        if vkx1[(i) as usize] > maxx { maxx = vkx1[(i) as usize] }
        i = i + 1
    }
    let by0: i64 = miny >> 6
    let by1: i64 = (maxy + 63) >> 6
    let bx0: i64 = minx >> 6
    let bx1: i64 = (maxx + 63) >> 6
    let width: i64 = bx1 - bx0
    if width <= 0 || width > 4096 {
        return
    }
    var py: i64 = by0
    while py < by1 {
        var cov: [u8; 4096] = [0 as u8; 4096]
        var sub: i64 = 0
        while sub < 4 {
            let ys: i64 = py * 64 + 8 + sub * 16
            var n: u64 = 0
            i = 0
            while i < vkn {
                let ay: i64 = vky0[(i) as usize]
                let by: i64 = vky1[(i) as usize]
                var lo: i64 = ay
                var hi: i64 = by
                var dir: i64 = 1
                if ay > by {
                    lo = by
                    hi = ay
                    dir = 0 - 1
                }
                if ys >= lo && ys < hi {
                    let ax: i64 = vkx0[(i) as usize]
                    let bx: i64 = vkx1[(i) as usize]
                    n = v_cross_add(n, ax + vrdiv((bx - ax) * (ys - ay),
                        by - ay), dir)
                }
                i = i + 1
            }
            var wind: i64 = 0
            var begin: i64 = 0
            var j: u64 = 0
            while j < n {
                let xs: i64 = vcx[(j) as usize]
                let vorher: i64 = wind
                wind = wind + vcd[(j) as usize]
                if vorher == 0 && wind != 0 {
                    begin = xs
                }
                if vorher != 0 && wind == 0 {
                    var j0: i64 = (begin - 8 + 15) >> 4
                    var j1: i64 = (xs - 8 + 15) >> 4
                    if j0 < bx0 * 4 {
                        j0 = bx0 * 4
                    }
                    if j1 > bx1 * 4 {
                        j1 = bx1 * 4
                    }
                    var k: i64 = j0
                    while k < j1 {
                        let c: i64 = (k >> 2) - bx0
                        if c >= 0 && c < width {
                            cov[(c) as usize] = cov[(c) as usize] + 1 as u8
                        }
                        k = k + 1
                    }
                }
                j = j + 1
            }
            sub = sub + 1
        }
        if py >= 0 {
            var c: i64 = 0
            while c < width {
                let v: u64 = cov[(c) as usize] as u64
                if v > 0 {
                    var a: u64 = v
                    if a > 16 {
                        a = 16
                    }
                    let deck: u64 = (a * 255 + 8) / 16
                    let xx: i64 = bx0 + c
                    if xx >= 0 {
                        let ux: u64 = xx as u64
                        let uy: u64 = py as u64
                        px(ux, uy, blend(get(ux, uy), color, deck))
                    }
                }
                c = c + 1
            }
        }
        py = py + 1
    }
}

fn vrect(x: u64, y: u64, w: u64, h: u64, r: u64, color: u64) {
    if w == 0 || h == 0 {
        return
    }
    v_new()
    v_rundeck((x as i64) * V_EINS, (y as i64) * V_EINS,
        (w as i64) * V_EINS, (h as i64) * V_EINS, (r as i64) * V_EINS)
    v_fuellen(color)
}

fn vkreis(cx: u64, cy: u64, r: u64, color: u64) {
    if r == 0 {
        return
    }
    v_new()
    v_ellipse((cx as i64) * V_EINS, (cy as i64) * V_EINS,
        (r as i64) * V_EINS, (r as i64) * V_EINS)
    v_fuellen(color)
}

fn vring(cx: u64, cy: u64, r: u64, thick: u64, color: u64) {
    if r == 0 || thick == 0 || thick >= r {
        return
    }
    v_new()
    v_ellipse((cx as i64) * V_EINS, (cy as i64) * V_EINS,
        (r as i64) * V_EINS, (r as i64) * V_EINS)
    let ri: i64 = ((r - thick) as i64) * V_EINS
    let mx: i64 = (cx as i64) * V_EINS
    let my: i64 = (cy as i64) * V_EINS
    v_move_to(mx, my - ri)
    v_arc(mx, my - ri, mx - ri, my - ri, mx - ri, my)
    v_arc(mx - ri, my, mx - ri, my + ri, mx, my + ri)
    v_arc(mx, my + ri, mx + ri, my + ri, mx + ri, my)
    v_arc(mx + ri, my, mx + ri, my - ri, mx, my - ri)
    v_close_path()
    v_fuellen(color)
}

fn rrect(x: u64, y: u64, w: u64, h: u64, r0: u64, color: u64) {
    if w == 0 || h == 0 {
        return
    }
    var r: u64 = r0
    if r > RADIUS_MAX {
        r = RADIUS_MAX
    }
    if r * 2 > w {
        r = w / 2
    }
    if r * 2 > h {
        r = h / 2
    }
    if r == 0 {
        rect(x, y, w, h, color)
        return
    }

    rect(x, y + r, w, h - 2 * r, color)

    rect(x + r, y, w - 2 * r, r, color)
    rect(x + r, y + h - r, w - 2 * r, r, color)

    var dy: u64 = 0
    while dy < r {
        var dx: u64 = 0
        while dx < r {
            let cov: u64 = ecke.corner_cov(r - 1 - dx, r - 1 - dy, r)
            if cov != 0 {
                let x0: u64 = x + dx
                let y0: u64 = y + dy
                let x1: u64 = x + w - 1 - dx
                let y1: u64 = y + h - 1 - dy
                px(x0, y0, blend(get(x0, y0), color, cov))
                px(x1, y0, blend(get(x1, y0), color, cov))
                px(x0, y1, blend(get(x0, y1), color, cov))
                px(x1, y1, blend(get(x1, y1), color, cov))
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

fn rframe(x: u64, y: u64, w: u64, h: u64, r: u64, bw: u64, color: u64,
    inner: u64) {
    if w < 2 || h < 2 || bw == 0 {
        return
    }
    if r == 0 && bw == 1 {
        rect(x + 1, y + 1, w - 2, h - 2, inner)
        frame(x, y, w, h, color)
        return
    }
    var b: u64 = bw
    if b * 2 >= w || b * 2 >= h {
        b = 1
    }
    rrect(x, y, w, h, r, color)
    var ri: u64 = 0
    if r > b {
        ri = r - b
    }
    rrect(x + b, y + b, w - 2 * b, h - 2 * b, ri, inner)
}

fn rring(x: u64, y: u64, w: u64, h: u64, r0: u64, bw: u64, color: u64) {
    if w < 2 || h < 2 || bw == 0 {
        return
    }
    var r: u64 = r0
    if r > RADIUS_MAX {
        r = RADIUS_MAX
    }
    if r * 2 > w {
        r = w / 2
    }
    if r * 2 > h {
        r = h / 2
    }
    if r == 0 {
        var k: u64 = 0
        while k < bw && 2 * k < w && 2 * k < h {
            frame(x + k, y + k, w - 2 * k, h - 2 * k, color)
            k = k + 1
        }
        return
    }

    rect(x + r, y, w - 2 * r, bw, color)
    rect(x + r, y + h - bw, w - 2 * r, bw, color)
    rect(x, y + r, bw, h - 2 * r, color)
    rect(x + w - bw, y + r, bw, h - 2 * r, color)

    var ri: u64 = 0
    if r > bw {
        ri = r - bw
    }
    var dy: u64 = 0
    while dy < r {
        var dx: u64 = 0
        while dx < r {
            let a: u64 = ecke.corner_cov(r - 1 - dx, r - 1 - dy, r)
            var b: u64 = 0
            if ri > 0 {
                b = ecke.corner_cov(r - 1 - dx, r - 1 - dy, ri)
            }
            var cov: u64 = 0
            if a > b {
                cov = a - b
            }
            if cov != 0 {
                let x0: u64 = x + dx
                let y0: u64 = y + dy
                let x1: u64 = x + w - 1 - dx
                let y1: u64 = y + h - 1 - dy
                px(x0, y0, blend(get(x0, y0), color, cov))
                px(x1, y0, blend(get(x1, y0), color, cov))
                px(x0, y1, blend(get(x0, y1), color, cov))
                px(x1, y1, blend(get(x1, y1), color, cov))
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

fn sub(a: u64, b: u64) -> u64 {
    if b >= a {
        return 0
    }
    return a - b
}

fn drop_shadow(x: u64, y: u64, w: u64, h: u64, r: u64, strength: u64,
    reach: u64, color: u64) {
    if strength == 0 || reach == 0 || w == 0 || h == 0 {
        return
    }
    var i: u64 = reach
    while i > 0 {

        let a: u64 = strength * 255 / 100 * (reach + 1 - i) / (reach + 1)
        if a != 0 {

            let lx: u64 = sub(x, i)
            let missing_x: u64 = sub(i, x)
            let oy: u64 = y + 1
            var ly: u64 = 0
            if oy > i {
                ly = oy - i
            }
            let missing_y: u64 = sub(i, oy)
            shadow_edge(lx, ly, sub(w + 2 * i, missing_x),
                sub(h + 2 * i, missing_y), r + i, color, a)
        }
        i = i - 1
    }
}

fn shadow_edge(x: u64, y: u64, w: u64, h: u64, r0: u64, color: u64,
    a: u64) {
    if w < 2 || h < 2 || a == 0 {
        return
    }
    var r: u64 = r0
    if r > RADIUS_MAX {
        r = RADIUS_MAX
    }
    if r * 2 > w {
        r = w / 2
    }
    if r * 2 > h {
        r = h / 2
    }
    var c: u64 = r
    while c < w - r {
        let x0: u64 = x + c
        px(x0, y, blend(get(x0, y), color, a))
        px(x0, y + h - 1, blend(get(x0, y + h - 1), color, a))
        c = c + 1
    }
    var q: u64 = r
    while q < h - r {
        let y0: u64 = y + q
        px(x, y0, blend(get(x, y0), color, a))
        px(x + w - 1, y0, blend(get(x + w - 1, y0), color, a))
        q = q + 1
    }
    if r == 0 {
        return
    }
    var innen: u64 = 0
    if r > 1 {
        innen = r - 1
    }
    var dy: u64 = 0
    while dy < r {
        var dx: u64 = 0
        while dx < r {
            let aussen: u64 = ecke.corner_cov(r - 1 - dx, r - 1 - dy, r)
            var i2: u64 = 0
            if innen > 0 {
                i2 = ecke.corner_cov(r - 1 - dx, r - 1 - dy, innen)
            }
            var cov: u64 = 0
            if aussen > i2 {
                cov = aussen - i2
            }
            if cov != 0 {
                let d: u64 = cov * a / 255
                let x0: u64 = x + dx
                let y0: u64 = y + dy
                let x1: u64 = x + w - 1 - dx
                let y1: u64 = y + h - 1 - dy
                px(x0, y0, blend(get(x0, y0), color, d))
                px(x1, y0, blend(get(x1, y0), color, d))
                px(x0, y1, blend(get(x0, y1), color, d))
                px(x1, y1, blend(get(x1, y1), color, d))
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

fn divider(x: u64, y: u64, w: u64, color: u64) {
    let o: u64 = met[(M_DIVIDER) as usize]
    if o == 0 {
        return
    }
    if o >= 100 {
        hline(x, y, w, color)
        return
    }
    let a: u64 = o * 255 / 100
    var c: u64 = 0
    while c < w {
        px(x + c, y, blend(get(x + c, y), color, a))
        c = c + 1
    }
}

const GC_SLOTS: u64 = 512
const GC_KEY: u64 = 0
const GC_W: u64 = 1
const GC_H: u64 = 2
const GC_L: u64 = 3
const GC_T: u64 = 4
const GC_ADV: u64 = 5
const GC_DATA: u64 = 6
const GC_FIELDS: u64 = 8

static mut gc: [u64; 4096] = [0 as u64; 4096]
static mut gc_used: u64 = 0
static mut gc_calls: u64 = 0

static mut gc_fui: u64 = 0

struct GlyphSource {
    glyph: fn(u64, u64, u64, u64, u64) -> u64,
    kern: fn(u64, u64, u64, u64) -> i64,
}
static mut gs_on: u64 = 0
static mut gs_mem: [u64; 4] = [0; 4]

fn gsrc() -> *mut GlyphSource {
    return (&gs_mem[0 as usize]) as u64 as *mut GlyphSource
}

fn glyph_source(g: fn(u64, u64, u64, u64, u64) -> u64,
    k: fn(u64, u64, u64, u64) -> i64) {
    *gsrc() = GlyphSource { glyph: g, kern: k }
    var i: u64 = 0
    while i < GC_SLOTS * GC_FIELDS {
        gc[i as usize] = 0
        i = i + 1
    }
    gc_used = 0
    gs_on = 1
}

fn glyphs_fui() -> u64 {
    return gc_fui
}
static mut gbuf: [u8; 2048] = [0 as u8; 2048]

fn gkey(f: u64, px_: u64, c: u64) -> u64 {
    return (f << 32) | ((px_ & 0xFF) << 24) | (c & RGB24)
        | 0x8000000000000000
}

fn ghash(k: u64) -> u64 {
    var h: u64 = k *% 1099511628211
    h = h ^ (h >> 29)
    return h % GC_SLOTS
}

fn gfind(f: u64, px_: u64, c: u64) -> u64 {
    let k: u64 = gkey(f, px_, c)
    var i: u64 = ghash(k)
    var n: u64 = 0
    while n < GC_SLOTS {
        let at: u64 = i * GC_FIELDS
        if gc[(at + GC_KEY) as usize] == k {
            return at
        }
        if gc[(at + GC_KEY) as usize] == 0 {
            return gload(at, f, px_, c, k)
        }
        i = (i + 1) % GC_SLOTS
        n = n + 1
    }
    return 0xFFFFFFFFFFFFFFFF
}

const GMAX: u64 = 256
static mut g_arena: u64 = 0
static mut g_arena_rest: u64 = 0
const G_CHUNK: u64 = 65536

fn gmem(n: u64) -> u64 {
    let m: u64 = (n + 15) & ~15
    if m > G_CHUNK {
        return 0
    }
    if g_arena == 0 || g_arena_rest < m {
        let p: u64 = map_surface(G_CHUNK)
        if ulib.bad(p) || p == 0 {
            return 0
        }
        g_arena = p
        g_arena_rest = G_CHUNK
    }
    let r: u64 = g_arena
    g_arena = g_arena + m
    g_arena_rest = g_arena_rest - m
    return r
}

fn gload(at: u64, f: u64, px_: u64, c: u64, k: u64) -> u64 {

    var n: u64 = 0
    if gs_on != 0 {
        let g: fn(u64, u64, u64, u64, u64) -> u64 = (*gsrc()).glyph
        n = g(f, px_, c, (&gbuf[0 as usize]) as u64, 2048)
    }
    if n == 0 {
        n = sys5(WIG_GLYPH, f, px_, c, (&gbuf[0 as usize]) as u64, 2048)
    } else {
        gc_fui = gc_fui + 1
    }
    if ulib.bad(n) || n < 48 {
        return 0xFFFFFFFFFFFFFFFF
    }
    gc_calls = gc_calls + 1
    let b: u64 = (&gbuf[0 as usize]) as u64
    let gw: u64 = __mmio_read64((b + 0) as *mut u64)
    let gh: u64 = __mmio_read64((b + 8) as *mut u64)

    if gw > GMAX || gh > GMAX {
        return 0xFFFFFFFFFFFFFFFF
    }
    if gw != 0 && gh > (n - 48) / gw {
        return 0xFFFFFFFFFFFFFFFF
    }
    gc[(at + GC_KEY) as usize] = k
    gc[(at + GC_W) as usize] = gw
    gc[(at + GC_H) as usize] = gh
    gc[(at + GC_L) as usize] = __mmio_read64((b + 16) as *mut u64)
    gc[(at + GC_T) as usize] = __mmio_read64((b + 24) as *mut u64)
    gc[(at + GC_ADV) as usize] = __mmio_read64((b + 32) as *mut u64)
    gc[(at + GC_DATA) as usize] = 0
    if gw * gh > 0 {
        let p: u64 = gmem(gw * gh)
        if p != 0 {
            ulib.copy(p, b + 48, gw * gh)
            gc[(at + GC_DATA) as usize] = p
        } else {
            gc[(at + GC_W) as usize] = 0
            gc[(at + GC_H) as usize] = 0
        }
    }
    gc_used = gc_used + 1
    return at
}

fn kern26(f: u64, px_: u64, c1: u64, c2: u64) -> i64 {

    if gs_on != 0 {
        let k: fn(u64, u64, u64, u64) -> i64 = (*gsrc()).kern
        return k(f, px_, c1, c2)
    }
    return sys5(WIG_KERN, f, px_, c1, c2, 0) as i64
}

fn draw_glyph(at: u64, x: i64, y: i64, color: u64) {
    let gw: u64 = gc[(at + GC_W) as usize]
    let gh: u64 = gc[(at + GC_H) as usize]
    let data: u64 = gc[(at + GC_DATA) as usize]
    if gw == 0 || gh == 0 || data == 0 {
        return
    }
    let x0: i64 = x + gc[(at + GC_L) as usize] as i64
    let y0: i64 = y - gc[(at + GC_T) as usize] as i64
    var r: u64 = 0
    while r < gh {
        let py: i64 = y0 + r as i64
        if py >= 0 {
            var c: u64 = 0
            while c < gw {
                let pxx: i64 = x0 + c as i64
                if pxx >= 0 {
                    let a: u64 = (*((data + r * gw + c) as *mut u8)) as u64
                    if a != 0 {
                        let ux: u64 = pxx as u64
                        let uy: u64 = py as u64
                        px(ux, uy, blend(get(ux, uy), color, a))
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

fn text_at(f: u64, px_: u64, x: u64, y: u64, p: u64, n: u64,
    color: u64) -> u64 {
    var cx: i64 = (x as i64) * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = n
        } else {
            if vorher != 0 {
                cx = cx + kern26(f, px_, vorher, c)
            }
            let at: u64 = gfind(f, px_, c)
            if at != 0xFFFFFFFFFFFFFFFF {
                draw_glyph(at, cx >> 6, y as i64, color)
                cx = cx + gc[(at + GC_ADV) as usize] as i64
            }
            vorher = c
            k = k + l
        }
    }
    let ende: u64 = (cx >> 6) as u64
    if ende > x {
        let asc: u64 = ascent_of(f, px_)
        var py0: u64 = 0
        if y > asc + 1 {
            py0 = y - asc - 1
        }
        plate_ink(x, py0, ende - x + 1, text_h(px_) + 2)
    }
    return ende
}

fn pen_x(f: u64, px_: u64, p: u64, n: u64, k0: u64) -> u64 {
    var cx: i64 = 0
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            return (cx >> 6) as u64
        }
        if vorher != 0 {
            cx = cx + kern26(f, px_, vorher, c)
        }
        if k == k0 {
            return (cx >> 6) as u64
        }
        let at: u64 = gfind(f, px_, c)
        if at != 0xFFFFFFFFFFFFFFFF {
            cx = cx + gc[(at + GC_ADV) as usize] as i64
        }
        vorher = c
        k = k + l
    }
    return (cx >> 6) as u64
}

fn text_w(f: u64, px_: u64, p: u64, n: u64) -> u64 {
    var cx: i64 = 0
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = n
        } else {
            if vorher != 0 {
                cx = cx + kern26(f, px_, vorher, c)
            }
            let at: u64 = gfind(f, px_, c)
            if at != 0xFFFFFFFFFFFFFFFF {
                cx = cx + gc[(at + GC_ADV) as usize] as i64
            }
            vorher = c
            k = k + l
        }
    }
    return (cx >> 6) as u64
}

fn back(p: u64, k: u64) -> u64 {
    if k == 0 {
        return 0
    }
    var i: u64 = k - 1
    var n: u64 = 0
    while n < 3 {
        if ((*((p + i) as *mut u8)) as u64 & 0xC0) != 0x80 {
            return i
        }
        if i == 0 {
            return 0
        }
        i = i - 1
        n = n + 1
    }
    return i
}

fn fit(f: u64, px_: u64, p: u64, n: u64, width: u64) -> u64 {
    var cx: i64 = 0
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            return k
        }
        if vorher != 0 {
            cx = cx + kern26(f, px_, vorher, c)
        }
        let at: u64 = gfind(f, px_, c)
        if at != 0xFFFFFFFFFFFFFFFF {
            cx = cx + gc[(at + GC_ADV) as usize] as i64
        }
        if (cx >> 6) as u64 > width {
            return k
        }
        vorher = c
        k = k + l
    }
    return n
}

fn chars(p: u64, n: u64) -> u64 {
    return utf8.chars(p, n)
}

fn glyph_w(f: u64, px_: u64, c: u64) -> u64 {
    let at: u64 = gfind(f, px_, c)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return (gc[(at + GC_ADV) as usize] as i64 >> 6) as u64
}

static mut ibuf: [u8; 24576] = [0 as u8; 24576]
static mut ik_key: u64 = 0
static mut ik_l: i64 = 0
static mut ik_t: i64 = 0
static mut ik_w: u64 = 0
static mut ik_h: u64 = 0

fn ink_load(f: u64, px_: u64, c: u64) {
    let k: u64 = gkey(f, px_, c)
    if ik_key == k {
        return
    }
    ik_key = k
    ik_l = 0
    ik_t = 0
    ik_w = 0
    ik_h = 0
    var n: u64 = 0
    if gs_on != 0 {
        let g: fn(u64, u64, u64, u64, u64) -> u64 = (*gsrc()).glyph
        n = g(f, px_, c, (&ibuf[0 as usize]) as u64, 24576)
    }
    if n < 48 {
        let at: u64 = gfind(f, px_, c)
        if at != 0xFFFFFFFFFFFFFFFF {
            ik_l = gc[(at + GC_L) as usize] as i64
            ik_t = gc[(at + GC_T) as usize] as i64
            ik_w = gc[(at + GC_W) as usize]
            ik_h = gc[(at + GC_H) as usize]
        }
        return
    }
    let b: u64 = (&ibuf[0 as usize]) as u64
    let gw: u64 = __mmio_read64((b + 0) as *mut u64)
    let gh: u64 = __mmio_read64((b + 8) as *mut u64)
    if gw > GMAX || gh > GMAX {
        return
    }
    ik_w = gw
    ik_h = gh
    ik_l = __mmio_read64((b + 16) as *mut u64) as i64
    ik_t = __mmio_read64((b + 24) as *mut u64) as i64
}

fn ink_l(f: u64, px_: u64, c: u64) -> i64 {
    ink_load(f, px_, c)
    return ik_l
}

fn ink_t(f: u64, px_: u64, c: u64) -> i64 {
    ink_load(f, px_, c)
    return ik_t
}

fn ink_w(f: u64, px_: u64, c: u64) -> u64 {
    ink_load(f, px_, c)
    return ik_w
}

fn ink_h(f: u64, px_: u64, c: u64) -> u64 {
    ink_load(f, px_, c)
    return ik_h
}

fn ascent_of(f: u64, px_: u64) -> u64 {
    let at: u64 = gfind(f, px_, 108)
    if at == 0xFFFFFFFFFFFFFFFF {
        return px_
    }
    return gc[(at + GC_T) as usize]
}

fn text_h(px_: u64) -> u64 {
    return px_ + px_ / 4
}

fn mono_cell(px_: u64) -> u64 {
    let at: u64 = gfind(F_MONO, px_, 48)
    if at == 0xFFFFFFFFFFFFFFFF {
        return px_
    }
    return ((gc[(at + GC_ADV) as usize] as i64 + 63) >> 6) as u64
}

fn push(h: u64, x: u64, y: u64, w: u64, hh: u64) -> u64 {
    if w == 0 || hh == 0 {
        return 0
    }
    if y < s_band {
        return 0
    }
    let r: u64 = y -% s_band
    if r >= s_srows {
        return 0
    }
    var hn: u64 = hh
    if r +% hn > s_srows {
        hn = s_srows -% r
    }
    if hn == 0 {
        return 0
    }
    let src: u64 = s_surf +% r *% s_sw *% 4 +% x *% 4
    return sys5(WIG_BLIT, h, (x << 16) | y, (w << 16) | hn, src, s_sw)
}

fn push_rect(h: u64, x: u64, y: u64, w: u64, hh: u64) -> u64 {
    return push(h, x, y, w, hh)
}

fn cursor_scene_mode() {
    s_scene = 1
}

fn cursor_scene() -> bool {
    return s_scene != 0
}

fn cursor_shape(s: u64) {
    s_shape = s
    sys3w(WIG_CURSOR, s, 0, 0)
}

fn bus5(op: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    return xfer.bus5(op, a1, a2, a3, a4)
}

fn bus_da() -> bool {
    return xfer.available()
}

fn clip_put(p: u64, n: u64) -> u64 {
    return clip_put_typ(BT_TEXT, p, n)
}

fn clip_put_typ(typen: u64, p: u64, n: u64) -> u64 {
    if s_noclip != 0 {
        return 0
    }
    if !xfer.available() {
        var wn: u64 = n
        if wn > CLIP_WIG_MAX {
            wn = CLIP_WIG_MAX
        }
        return sys3w(WIG_CLIPSET, p, wn, 0)
    }
    let r: u64 = xfer.set(xfer.SEL_CLIPBOARD, typen, p, n)
    if ulib.bad(r) {
        return 0
    }
    return r
}

fn clip_take(p: u64, max: u64) -> u64 {
    return clip_hist_take(0, p, max)
}

fn clip_hist_take(back: u64, p: u64, max: u64) -> u64 {
    if s_noclip != 0 {
        return 0
    }
    if !xfer.available() {
        if back != 0 {
            return 0
        }
        let m: u64 = sys3w(WIG_CLIPGET, p, max, 0)
        if ulib.bad(m) {
            return 0
        }
        return m
    }
    let n: u64 = xfer.get_text(xfer.SEL_CLIPBOARD, back, p, max)
    if ulib.bad(n) {
        return 0
    }
    if n > max {
        return max
    }
    return n
}

fn clip_hist_count() -> u64 {
    return xfer.count(xfer.SEL_CLIPBOARD)
}

fn clip_hist_typ(back: u64) -> u64 {
    return xfer.types(xfer.SEL_CLIPBOARD, back)
}

fn clip_hist_owner(back: u64) -> u64 {
    return xfer.owner(xfer.SEL_CLIPBOARD, back)
}

fn drag_put(typen: u64, p: u64, n: u64) -> u64 {
    return xfer.drag_start(typen, p, n)
}

fn drag_take(p: u64, max: u64) -> u64 {
    return ulib.drag_take(p, max)
}

fn drag_an() -> bool {
    return xfer.drag_active()
}

fn drag_drop() -> u64 {
    return xfer.drag_end()
}

