// obwohl diese Datei die einzige ist, die je einen Formplatz schickt.
const WF_MOTION: u64 = 8
// RUNDE GLAS: die vier Zahlen fuer Durchsicht und Milchglas.  Dieselben
// Nummern wie `sys.WF_*` und `wm.FM_*`, und tools/themestore/run.sh
// haelt die drei Listen gegeneinander.  Die Deckkraft ist in PROZENT
