profile kernel

import ulib
import tools
import contactdb

export { u_start }

const EXIT_USAGE: u64 = 2
const EXIT_MISSING: u64 = 1

static mut S_USE: [u8; 57] = "usage: contacts list|add <name> <phone> [email]|find|del\0"
static mut S_ADD: [u8; 4] = "add\0"
static mut S_LIST: [u8; 5] = "list\0"
static mut S_FIND: [u8; 5] = "find\0"
static mut S_DEL: [u8; 4] = "del\0"
static mut S_NAME: [u8; 7] = " name=\0"
static mut S_PHONE: [u8; 8] = " phone=\0"
static mut S_EMAIL: [u8; 8] = " email=\0"
static mut S_ADDED: [u8; 8] = "added: \0"
static mut S_DELETED: [u8; 10] = "deleted: \0"
static mut S_NONE: [u8; 16] = "no such contact\0"
static mut S_FAILED: [u8; 14] = "cannot add it\0"
static mut S_SP: [u8; 2] = " \0"

fn show(i: u64) {
    tools.ob_num(i + 1)
    tools.ob_str((&S_NAME[0]) as u64)
    tools.ob_str(contactdb.name_of(i))
    tools.ob_str((&S_PHONE[0]) as u64)
    tools.ob_str(contactdb.phone_of(i))
    tools.ob_str((&S_EMAIL[0]) as u64)
    tools.ob_str(contactdb.email_of(i))
    tools.ob_nl()
}

fn u_start(args: u64) -> u64 {
    let n: u64 = ulib.arg_count(args)
    if n < 2 {
        ulib.esay_line((&S_USE[0]) as u64, 0)
        return EXIT_USAGE
    }
    contactdb.load()
    let w: u64 = ulib.arg_at(args, 1)
    if ulib.streq(w, (&S_LIST[0]) as u64) {
        var i: u64 = 0
        while i < contactdb.count() {
            show(i)
            i = i + 1
        }
        tools.ob_flush()
        return 0
    }
    if ulib.streq(w, (&S_ADD[0]) as u64) && n >= 4 {
        var email: u64 = (&S_SP[0]) as u64 + 1
        if n >= 5 {
            email = ulib.arg_at(args, 4)
        }
        if !contactdb.add(ulib.arg_at(args, 2), ulib.arg_at(args, 3), email) {
            ulib.esay_line((&S_FAILED[0]) as u64, 0)
            return EXIT_MISSING
        }
        tools.ob_str((&S_ADDED[0]) as u64)
        tools.ob_num(contactdb.count())
        tools.ob_nl()
        tools.ob_flush()
        return 0
    }
    if ulib.streq(w, (&S_FIND[0]) as u64) && n >= 3 {
        let i: u64 = contactdb.find(ulib.arg_at(args, 2))
        if i == contactdb.NONE {
            ulib.esay_line((&S_NONE[0]) as u64, 0)
            return EXIT_MISSING
        }
        show(i)
        tools.ob_flush()
        return 0
    }
    if ulib.streq(w, (&S_DEL[0]) as u64) && n >= 3 {
        let k: u64 = ulib.to_num(ulib.arg_at(args, 2))
        if k == 0 || !contactdb.drop(k - 1) {
            ulib.esay_line((&S_NONE[0]) as u64, 0)
            return EXIT_MISSING
        }
        tools.ob_str((&S_DELETED[0]) as u64)
        tools.ob_num(k)
        tools.ob_nl()
        tools.ob_flush()
        return 0
    }
    ulib.esay_line((&S_USE[0]) as u64, 0)
    return EXIT_USAGE
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
