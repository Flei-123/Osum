// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/k13t.fi -- Runde K13: der Selbsttest dieser Runde, in Ring 3.
//
// Wie `/bin/posix` fuer Runde K4 und `/bin/unix` fuer Runde K9: ein
// Programm, das die Zusagen dieser Runde VON INNEN prueft und jede als
// eine Zeile meldet, die der Wirt zurueckliest. Die Form ist
//
//     k13t: NAME=WERT
//
// und der Testlaeufer haelt jeden dieser Werte gegen eine Zahl, die er
// SELBST ausgerechnet hat -- bei den Hashwerten gegen Pythons `hashlib`,
// bei den Rechten gegen die Regel aus dem Handbuch.
//
// Es macht ABSICHTLICH nichts kaputt: es legt seine Dateien unter /t an
// und raeumt sie nicht weg, damit der Wirt hinterher IM ABBILD nachsehen
// kann, was wirklich auf der Platte steht.

profile kernel

import ulib
import tools
import pw

export { u_start }

fn line(name: u64, v: u64) {
    tools.ob_str(name)
    tools.ob_num(v)
    tools.ob_nl()
}

fn text(name: u64, v: u64) {
    tools.ob_str(name)
    tools.ob_str(v)
    tools.ob_nl()
}

// DIE WAISE. `k13t waise` spaltet ein Kind ab, das eine Sekunde lebt,
// und endet SOFORT -- ohne auf es zu warten. Damit ist das Kind
// elternlos, der Kern haengt es an den Prozess 1, und dort muss es
// eingesammelt werden. Ohne init bleibt es als Leiche stehen; genau das
// ist die Gegenprobe, und sie steht als Zahl in `init: orphans=` und in
// `k13: ... zombies=`.
fn waise() -> u64 {
    var s_kid: [u8; 12] = "k13t: kid=\0\0"
    let kid: u64 = ulib.sys(57, 0, 0, 0)
    if kid == 0 {
        ulib.sleep_ms(300)
        return 3
    }
    tools.ob_str((&s_kid[0]) as u64)
    tools.ob_num(kid)
    tools.ob_nl()
    tools.ob_flush()
    return 0
}

fn u_start(args: u64) -> u64 {
    var w_waise: [u8; 6] = "waise\0"
    if ulib.arg_count(args) > 1 {
        if ulib.streq(ulib.arg_at(args, 1), (&w_waise[0]) as u64) {
            return waise()
        }
    }
    var p_sha: [u8; 12] = "k13t: sha=\0\0"
    var p_hmac: [u8; 13] = "k13t: hmac=\0\0"
    var p_kdf: [u8; 12] = "k13t: kdf=\0\0"
    var p_rt: [u8; 16] = "k13t: rndtrip=\0\0"
    var p_wrong: [u8; 14] = "k13t: wrong=\0\0"
    var p_uid: [u8; 12] = "k13t: uid=\0\0"
    var p_euid: [u8; 13] = "k13t: euid=\0\0"
    var p_open: [u8; 15] = "k13t: openown=\0"
    var p_deny: [u8; 16] = "k13t: opendeny=\0"
    var p_wdeny: [u8; 14] = "k13t: wdeny=\0\0"
    var p_chm: [u8; 13] = "k13t: chmod=\0"
    var p_mode: [u8; 13] = "k13t: mode=\0\0"
    var p_umask: [u8; 14] = "k13t: umask=\0\0"
    var p_newm: [u8; 13] = "k13t: newm=\0\0"
    var p_acc: [u8; 15] = "k13t: access=\0\0"
    var p_done: [u8; 12] = "k13t: done\0\0"

    // ---------------------------------------------- 1. die Hashwerte
    //
    // Drei feste Eingaben, drei feste Ergebnisse. Der Wirt rechnet sie
    // mit Pythons `hashlib` nach -- das ist der einzige Weg, bei dem
    // "das ist SHA-256" keine Behauptung ist.
    var abc: [u8; 4] = "abc\0"
    var key: [u8; 4] = "key\0"
    var msg: [u8; 20] = "The quick brown fox\0"
    var salt: [u8; 9] = "saltsalt\0"
    var pass: [u8; 9] = "geheim12\0"
    var dig: [u8; 32] = [0 as u8; 32]
    var hex: [u8; 72] = [0 as u8; 72]

    pw.sha256((&abc[0]) as u64, 3, (&dig[0]) as u64)
    pw.hex_out((&dig[0]) as u64, 32, (&hex[0]) as u64)
    text((&p_sha[0]) as u64, (&hex[0]) as u64)

    pw.hmac256((&key[0]) as u64, 3, (&msg[0]) as u64, 19, (&dig[0]) as u64)
    pw.hex_out((&dig[0]) as u64, 32, (&hex[0]) as u64)
    text((&p_hmac[0]) as u64, (&hex[0]) as u64)

    pw.pbkdf2((&pass[0]) as u64, 8, (&salt[0]) as u64, 8, 2048,
        (&dig[0]) as u64)
    pw.hex_out((&dig[0]) as u64, 32, (&hex[0]) as u64)
    text((&p_kdf[0]) as u64, (&hex[0]) as u64)

    // Und der Rundlauf: ein Eintrag bauen und ihn wieder pruefen. Das
    // ist die Zusage, auf der `login` steht -- und die Gegenprobe
    // daneben ist ein FALSCHES Passwort, das abgelehnt werden MUSS.
    var rec: [u8; 128] = [0 as u8; 128]
    var falsch: [u8; 9] = "geheim13\0"
    var okv: u64 = 0
    if pw.make_hash((&pass[0]) as u64, (&rec[0]) as u64) {
        if pw.check_hash((&rec[0]) as u64, (&pass[0]) as u64) {
            okv = 1
        }
    }
    line((&p_rt[0]) as u64, okv)
    var wrong: u64 = 0
    if pw.check_hash((&rec[0]) as u64, (&falsch[0]) as u64) {
        wrong = 1
    }
    line((&p_wrong[0]) as u64, wrong)

    // ---------------------------------------------- 2. wer ich bin
    line((&p_uid[0]) as u64, ulib.sys(102, 0, 0, 0))
    line((&p_euid[0]) as u64, ulib.sys(107, 0, 0, 0))

    // ---------------------------------------------- 3. die Rechte
    //
    // Die Datei /t/eigen.txt gehoert dem, der dieses Programm startet.
    // Sie wird angelegt, auf 0o600 gesetzt, gelesen -- und dann auf
    // 0o000, wo derselbe Zugriff scheitern MUSS. Beides mit derselben
    // Kennung: der Unterschied sind ausschliesslich die Rechtebits.
    // Die beiden Dateien kommen von der Kommandozeile, damit derselbe
    // Selbsttest ZWEIMAL laufen kann -- einmal als root, einmal als
    // gewoehnlicher Benutzer -- und beide Male an denselben Namen
    // arbeitet. Genau der Unterschied zwischen den beiden Laeufen ist
    // die Messung dieser Runde.
    var f_own: [u8; 96] = [0 as u8; 96]
    var d_own: [u8; 13] = "/w/eigen.txt\0"
    if ulib.arg_count(args) > 1 {
        ulib.strncpy((&f_own[0]) as u64, ulib.arg_at(args, 1), 96)
    } else {
        ulib.strcpy((&f_own[0]) as u64, (&d_own[0]) as u64)
    }
    var inhalt: [u8; 6] = "hallo\0"
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&f_own[0]) as u64, ulib.O_MAKE, 0)
    if !ulib.bad(fd) {
        ulib.sys(ulib.SYS_WRITE, fd, (&inhalt[0]) as u64, 5)
        ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    }
    line((&p_chm[0]) as u64, ulib.sys(90, (&f_own[0]) as u64, 384, 0))
    let f1: u64 = ulib.sys(ulib.SYS_OPEN, (&f_own[0]) as u64, 0, 0)
    var ok1: u64 = 0
    if !ulib.bad(f1) {
        ok1 = 1
        ulib.sys(ulib.SYS_CLOSE, f1, 0, 0)
    }
    line((&p_open[0]) as u64, ok1)
    line((&p_mode[0]) as u64, mode_of((&f_own[0]) as u64))

    // access() fragt mit der ECHTEN Kennung: R_OK auf die eigene Datei.
    line((&p_acc[0]) as u64, ulib.sys(21, (&f_own[0]) as u64, 4, 0))

    // Jetzt zu: 0o000. Fuer root aendert das nichts (root darf lesen
    // und schreiben, immer) -- der Testlaeufer startet dieses Programm
    // deshalb ZWEIMAL, einmal als root und einmal als gewoehnlicher
    // Benutzer, und genau der Unterschied ist die Messung.
    ulib.sys(90, (&f_own[0]) as u64, 0, 0)
    let f2: u64 = ulib.sys(ulib.SYS_OPEN, (&f_own[0]) as u64, 0, 0)
    var ok2: u64 = 0
    if !ulib.bad(f2) {
        ok2 = 1
        ulib.sys(ulib.SYS_CLOSE, f2, 0, 0)
    }
    line((&p_deny[0]) as u64, ok2)
    ulib.sys(90, (&f_own[0]) as u64, 420, 0)

    // Eine FREMDE Datei: /etc/shadow gehoert root und traegt 0o600.
    var f_sh: [u8; 12] = "/etc/shadow\0"
    let f3: u64 = ulib.sys(ulib.SYS_OPEN, (&f_sh[0]) as u64, 0, 0)
    var ok3: u64 = 0
    if !ulib.bad(f3) {
        ok3 = 1
        ulib.sys(ulib.SYS_CLOSE, f3, 0, 0)
    }
    line((&p_wdeny[0]) as u64, ok3)

    // ---------------------------------------------- 4. die Maske
    //
    // umask 0o027, dann eine neue Datei: 0o666 & ~0o027 = 0o640.
    line((&p_umask[0]) as u64, ulib.sys(95, 23, 0, 0))
    var f_new: [u8; 96] = [0 as u8; 96]
    var d_new: [u8; 11] = "/w/neu.txt\0"
    if ulib.arg_count(args) > 2 {
        ulib.strncpy((&f_new[0]) as u64, ulib.arg_at(args, 2), 96)
    } else {
        ulib.strcpy((&f_new[0]) as u64, (&d_new[0]) as u64)
    }
    let fn2: u64 = ulib.sys(ulib.SYS_OPEN, (&f_new[0]) as u64, ulib.O_MAKE, 0)
    if !ulib.bad(fn2) {
        ulib.sys(ulib.SYS_CLOSE, fn2, 0, 0)
    }
    line((&p_newm[0]) as u64, mode_of((&f_new[0]) as u64))
    ulib.sys(95, 0, 0, 0)

    tools.ob_str((&p_done[0]) as u64)
    tools.ob_nl()
    tools.ob_flush()
    return 0
}

// Die Rechtebits einer Datei aus `stat`. Der Kern legt sie seit dieser
// Runde in `st_mode` ab -- die unteren zwoelf Bits.
fn mode_of(path: u64) -> u64 {
    var st: [u8; 144] = [0 as u8; 144]
    let r: u64 = ulib.sys(4, path, (&st[0]) as u64, 0)
    if ulib.bad(r) {
        return ulib.EOF
    }
    return ((*((&st[24]) as *mut u32)) as u64) & 4095
}
