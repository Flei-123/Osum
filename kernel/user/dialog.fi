profile kernel

import actwire
import consent
import trusttext
import product
import libc.octets

export {
    show, show_message, show_warning, show_error, confirm, consent_ask,
    KIND_MESSAGE, KIND_CONFIRM, SEV_INFO, SEV_WARNING, SEV_ERROR, SEV_CRITICAL,
    ANSWER_NONE, ANSWER_YES, ANSWER_NO,
}

const KIND_MESSAGE: u64 = 0
const KIND_CONFIRM: u64 = 1
const SEV_INFO: u64 = 0
const SEV_WARNING: u64 = 1
const SEV_ERROR: u64 = 2
const SEV_CRITICAL: u64 = 3

const ANSWER_NONE: u64 = consent.ANSWER_NONE
const ANSWER_YES: u64 = consent.ANSWER_YES
const ANSWER_NO: u64 = consent.ANSWER_NO

const RS: u64 = 30
const FIELD_YES: u64 = 1
const FIELD_NO: u64 = 3
const FIELD_HINT: u64 = 5
const FIELD_SEV: u64 = 1

static mut KINDS: [u8; 239] = "message\tOK\tOK\tSchließen\tClose\tNur echte Tastatur/Maus:  J = OK   N = Schließen\tReal keyboard/mouse only:  Y = OK   N = Close\nconfirm\tJa\tYes\tNein\tNo\tNur echte Tastatur/Maus:  J = Ja   N = Nein\tReal keyboard/mouse only:  Y = Yes   N = No\n\0"
static mut TITLE_SEP: [u8; 4] = " - \0"
static mut SEVERITIES: [u8; 90] = "info\t\t\nwarning\tWarnung: \tWarning: \nerror\tFehler: \tError: \ncritical\tKritisch: \tCritical: \n\0"

fn row_at(table: u64, index: u64) -> u64 {
    var at: u64 = 0
    var n: u64 = 0
    while octets.ld8(table, at) != 0 && n < index {
        while octets.ld8(table, at) != 10 && octets.ld8(table, at) != 0 {
            at = at + 1
        }
        if octets.ld8(table, at) == 10 {
            at = at + 1
        }
        n = n + 1
    }
    if octets.ld8(table, at) == 0 {
        return table
    }
    return table + at
}

fn field_of(row: u64, f: u64) -> u64 {
    var i: u64 = 0
    var k: u64 = 0
    while k < f {
        while octets.ld8(row, i) != 9 && octets.ld8(row, i) != 10 && octets.ld8(row, i) != 0 {
            i = i + 1
        }
        if octets.ld8(row, i) == 9 {
            i = i + 1
        }
        k = k + 1
    }
    return row + i
}

fn put_field(row: u64, f: u64) {
    var p: u64 = field_of(row, f)
    while octets.ld8(p, 0) != 9 && octets.ld8(p, 0) != 10 && octets.ld8(p, 0) != 0 {
        actwire.ob_ch(octets.ld8(p, 0))
        p = p + 1
    }
}

fn lang_field(base: u64) -> u64 {
    if trusttext.english() {
        return base + 1
    }
    return base
}

fn compose(kind: u64, sev: u64, title: u64, text: u64, details: u64) {
    let krow: u64 = row_at((&KINDS[0 as usize]) as u64, kind)
    let srow: u64 = row_at((&SEVERITIES[0 as usize]) as u64, sev)
    actwire.ob_reset()
    actwire.ob_str(product.product())
    actwire.ob_str((&TITLE_SEP[0 as usize]) as u64)
    put_field(srow, lang_field(FIELD_SEV))
    actwire.ob_str(title)
    actwire.ob_ch(RS)
    actwire.ob_str(text)
    actwire.ob_ch(RS)
    if details != 0 {
        actwire.ob_str(details)
    }
    actwire.ob_ch(RS)
    put_field(krow, lang_field(FIELD_YES))
    actwire.ob_ch(RS)
    put_field(krow, lang_field(FIELD_NO))
    actwire.ob_ch(RS)
    put_field(krow, lang_field(FIELD_HINT))
}

fn show(kind: u64, sev: u64, title: u64, text: u64, details: u64) -> u64 {
    compose(kind, sev, title, text, details)
    return consent.ask_built()
}

fn show_message(title: u64, text: u64) -> u64 {
    return show(KIND_MESSAGE, SEV_INFO, title, text, 0)
}

fn show_warning(title: u64, text: u64) -> u64 {
    return show(KIND_MESSAGE, SEV_WARNING, title, text, 0)
}

fn show_error(title: u64, text: u64) -> u64 {
    return show(KIND_MESSAGE, SEV_ERROR, title, text, 0)
}

fn confirm(title: u64, text: u64) -> bool {
    return show(KIND_CONFIRM, SEV_INFO, title, text, 0) == ANSWER_YES
}

fn consent_ask(client: u64, action: u64, args: u64, rights: u64) -> u64 {
    return consent.ask(client, action, args, rights)
}
