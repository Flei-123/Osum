// kernel/user/hallo3.fi -- RUNDE UPDATE: DIE FASSUNG, DIE NICHT LAEUFT.
//
// Die dritte Fassung des Probepakets, und die einzige, deren Aufgabe das
// SCHEITERN ist. Sie sagt, wer sie ist, und beendet sich mit einem
// Fehlercode. Damit hat der Testlauf ein Update, das sich einwandfrei
// installieren laesst -- richtig signiert, richtige Pruefsumme, richtige
// Generation -- und danach NICHT hochkommt. Das ist der Fall, gegen den
// der Erprobungszaehler in `kernel/ab.fi` gebaut ist, und ohne ein Paket
// wie dieses waere er eine Behauptung.
profile kernel
import ulib
export { u_start }
fn u_start(args: u64) -> u64 {
    var s: [u8; 33] = "paket-hallo fassung 3 SCHEITERT\n\0"
    ulib.say((&s[0 as usize]) as u64)
    return 1
}
