// The status line of the Wi-Fi page. With no driver the connection machine never leaves CS_OFF.
fn wifi_status(why: u64) {
    // no driver: the connection machine stays in Z_OFF, which shows as CS_OFF
    var key: u64 = (&k_wf_off[0 as usize]) as u64
    if netui.conn_class(0) != netui.CS_OFF {
        key = (&k_wf_nodrv[0 as usize]) as u64
    }
    if why != 0 {
        key = why
    }
    let _t: u64 = text_an((&l_wstat[0 as usize]) as u64, 0, msg.get(key))
}

// Connect: name 1..32, password 8..63 (the netui password machine), then the honest result.
fn wifi_connect() {
    let sl: u64 = ulib.length((&e_wssid[0 as usize]) as u64)
    if sl == 0 || sl > 32 {
        wifi_status((&k_wf_bad_ssid[0 as usize]) as u64)
        return
    }
    netui.pw_clear()
    var i: u64 = 0
    let pl: u64 = ulib.length((&e_wpw[0 as usize]) as u64)
    while i < pl {
        let _k: u64 = netui.pw_key(e_wpw[(i) as usize] as u64)
        i = i + 1
    }
    if !netui.pw_can_submit() {
        wifi_status((&k_wf_short[0 as usize]) as u64)
        return
    }
    wifi_status((&k_wf_nodrv[0 as usize]) as u64)
}

// Refresh: count the lines of /proc/usb (one per device the kernel found).
fn usbnet_refresh() {
    var buf: [u8; 1024] = [0 as u8; 1024]
    let n: u64 = file_read((&p_proc_usb[0 as usize]) as u64, (&buf[0 as usize]) as u64, 1024)
    var lines: u64 = 0
    var k: u64 = 0
    while k < n {
        if buf[(k) as usize] == 10 as u8 {
            lines = lines + 1
        }
        k = k + 1
    }
    if lines == 0 {
        let _t: u64 = text_an((&l_ustat[0 as usize]) as u64, 0, msg.get((&k_us_none[0 as usize]) as u64))
    } else {
        var at: u64 = text_an((&l_ustat[0 as usize]) as u64, 0, msg.get((&k_us_found[0 as usize]) as u64))
        l_ustat[(at) as usize] = (48 + lines % 10) as u8
        if lines >= 10 {
            l_ustat[(at) as usize] = (48 + (lines / 10) % 10) as u8
            l_ustat[(at + 1) as usize] = (48 + lines % 10) as u8
            at = at + 1
        }
        l_ustat[(at + 1) as usize] = 0 as u8
    }
}

