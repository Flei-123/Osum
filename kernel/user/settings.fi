    // ---- Konten (RUNDE KONTO)
    //
    // LINKS die Anmeldung, RECHTS die Konten, die es schon gibt. Kein
    // Feld dieser Seite ist eine Bedingung fuer irgendetwas: wer die
    // Seite nie oeffnet, hat ein vollstaendiges System.
    wlib.box_use(cleft)
    let _kt1: u64 = merke(wlib.label(msg.get((&k_k_titel[0 as usize]) as u64)),
        R_KONTO)
    let _kt2: u64 = merke(wlib.label(msg.get((&k_k_prov[0 as usize]) as u64)),
