    fuiscene.set_size(n_sy_bundo, 0, 28)
    let _n_sy_stat: usize = fuiscene.label(left, (&l_systat[0 as usize]) as u64)
}

// page R_RECHTE
fn page_rechte(left: usize, right: usize) {
    let _n_ri1: usize = fuiscene.label(left, msg.get((&k_ri_title[0 as usize]) as u64))
    let _n_ri_notew: usize = fuiscene.label(left, (&l_rinote[0 as usize]) as u64)
    let _n_ri_tab: usize = fuiscene.table_blob(left, K_RI_TAB, 0, 100, 6, (&b_rules[0 as usize]) as u64)
    fuiscene.table_row_height(K_RI_TAB, 22)
    colw_set(K_RI_TAB, (&c_rules[0 as usize]) as u64, 6)
    let n_ri_brev: usize = fuiscene.button(left, msg.get((&k_ri_revoke[0 as usize]) as u64), K_RI_BREV)
    fuiscene.set_size(n_ri_brev, 0, 28)
    let n_ri_bjar: usize = fuiscene.button(left, msg.get((&k_ri_jarvis[0 as usize]) as u64), K_RI_BJAR)
    fuiscene.set_size(n_ri_bjar, 0, 28)
    let _n_ri2: usize = fuiscene.label(left, msg.get((&k_ri_act[0 as usize]) as u64))
    let _n_ri_ctab: usize = fuiscene.table_blob(left, K_RI_CTAB, 0, 100, 6, (&b_cls[0 as usize]) as u64)
    fuiscene.table_row_height(K_RI_CTAB, 22)
    colw_set(K_RI_CTAB, (&c_cls[0 as usize]) as u64, 6)
    let n_ri_bblock: usize = fuiscene.button(left, msg.get((&k_ri_block[0 as usize]) as u64), K_RI_BBLOCK)
    fuiscene.set_size(n_ri_bblock, 0, 28)
    let _n_ri_stat: usize = fuiscene.label(left, (&l_ristat[0 as usize]) as u64)
}


// ============================================ ROUND LAP1 (L-001): page Maus
// The three values live in /etc/mouse.conf (schema keys mouse.speed|accel|
// natural, `store` lines); the kernel (ptrcfg.fi) reloads that file within
// about a second. The page writes through the action bus (settingsd stores
// the file); without a bus it writes the file itself.
static mut ms_speed: u64 = 100
static mut ms_accel: u64 = 0
static mut ms_nat: u64 = 0
static mut ms_ges: u64 = 0
static mut ms_fps: u64 = 0 // FPS-OV
static mut ms_conf: [u8; 16] = "/etc/mouse.conf\0"
static mut ms_buf: [u8; 128] = [0 as u8; 128]

fn mouse_clamp() {
    if ms_speed < 10 {
        ms_speed = 10
    }
    if ms_speed > 400 {
        ms_speed = 400
    }
    if ms_accel > 5 {
        ms_accel = 5
    }
    if ms_nat > 1 {
        ms_nat = 1
    }
    if ms_ges > 1 {
        ms_ges = 1
    }
    if ms_fps > 1 {
        ms_fps = 1
    }
}

// one key=value number out of the file text in ms_buf; def when missing
fn mouse_file_num(key: u64, def: u64) -> u64 {
    let at: u64 = ulib.find((&ms_buf[0 as usize]) as u64, key)
    if at == 0xFFFFFFFFFFFFFFFF {
        return def
    }
    return ulib.to_num(((&ms_buf[0 as usize]) as u64) + at + ulib.length(key))
}

fn mouse_load() {
    var k_speed: [u8; 7] = "speed=\0"
    var k_accel: [u8; 7] = "accel=\0"
    var k_nat: [u8; 9] = "natural=\0"
    var k_ges: [u8; 10] = "gestures=\0"
    var k_fps: [u8; 5] = "fps=\0"
    var t_true: [u8; 5] = "true\0"
    ms_speed = 100
    ms_accel = 0
    ms_nat = 0
    ms_ges = 0
    ms_fps = 0
    let fd: u64 = io.open((&ms_conf[0 as usize]) as u64, 0)
    if !ulib.bad(fd) {
        let n: u64 = io.read(fd, (&ms_buf[0 as usize]) as u64, 120)
        io.close(fd)
        if !ulib.bad(n) && n > 0 {
            __mmio_write8((((&ms_buf[0 as usize]) as u64) + n) as *mut u8, 0 as u8)
            ms_speed = mouse_file_num((&k_speed[0 as usize]) as u64, 100)
            ms_accel = mouse_file_num((&k_accel[0 as usize]) as u64, 0)
            let at: u64 = ulib.find((&ms_buf[0 as usize]) as u64, (&k_nat[0 as usize]) as u64)
            if at != 0xFFFFFFFFFFFFFFFF {
                let v: u64 = ((&ms_buf[0 as usize]) as u64) + at + 8
                if rb(v, 0) == 116 || rb(v, 0) == 49 {
                    ms_nat = 1
                }
            }
            let ag: u64 = ulib.find((&ms_buf[0 as usize]) as u64, (&k_ges[0 as usize]) as u64)
            if ag != 0xFFFFFFFFFFFFFFFF {
                let vg: u64 = ((&ms_buf[0 as usize]) as u64) + ag + 9
                if rb(vg, 0) == 116 || rb(vg, 0) == 49 {
                    ms_ges = 1
                }
            }
            let af: u64 = ulib.find((&ms_buf[0 as usize]) as u64, (&k_fps[0 as usize]) as u64)
            if af != 0xFFFFFFFFFFFFFFFF {
                let vf: u64 = ((&ms_buf[0 as usize]) as u64) + af + 4
                if rb(vf, 0) == 116 || rb(vf, 0) == 49 {
                    ms_fps = 1
                }
            }
        }
    }
    mouse_clamp()
}

fn mouse_file_write() -> bool {
    var h: [u8; 48] = "# /etc/mouse.conf -- written by settings\nspeed=\0"
    var a: [u8; 8] = "\naccel=\0"
    var n0: [u8; 16] = "\nnatural=false\n\0"
    var n1: [u8; 15] = "\nnatural=true\n\0"
    var g0: [u8; 16] = "gestures=false\n\0"
    var g1: [u8; 15] = "gestures=true\n\0"
    var f0: [u8; 11] = "fps=false\n\0"
    var f1: [u8; 10] = "fps=true\n\0"
    var z: [u8; 24] = [0 as u8; 24]
    let b: u64 = (&ms_buf[0 as usize]) as u64
    ulib.strcpy(b, (&h[0 as usize]) as u64)
    var d: u64 = ulib.digits(ms_speed, (&z[0 as usize]) as u64)
    z[(d) as usize] = 0 as u8
    ulib.strcat(b, (&z[0 as usize]) as u64)
    ulib.strcat(b, (&a[0 as usize]) as u64)
    d = ulib.digits(ms_accel, (&z[0 as usize]) as u64)
    z[(d) as usize] = 0 as u8
    ulib.strcat(b, (&z[0 as usize]) as u64)
    if ms_nat != 0 {
        ulib.strcat(b, (&n1[0 as usize]) as u64)
    } else {
        ulib.strcat(b, (&n0[0 as usize]) as u64)
    }
    if ms_ges != 0 {
        ulib.strcat(b, (&g1[0 as usize]) as u64)
    } else {
        ulib.strcat(b, (&g0[0 as usize]) as u64)
    }
    if ms_fps != 0 {
        ulib.strcat(b, (&f1[0 as usize]) as u64)
    } else {
        ulib.strcat(b, (&f0[0 as usize]) as u64)
    }
    let fd: u64 = io.create((&ms_conf[0 as usize]) as u64)
    if ulib.bad(fd) {
        return false
    }
    let len: u64 = ulib.length(b)
    let g: u64 = io.write_all(fd, b, len)
    io.close(fd)
    return !ulib.bad(g) && g >= len
}

// one key through the bus; false when there is no bus or it refused
fn mouse_bus_set(key: u64, value: u64) -> bool {
    var v_set: [u8; 18] = "call settings.set\0"
    var k_key: [u8; 4] = "key\0"
    var k_val: [u8; 6] = "value\0"
    var z: [u8; 24] = [0 as u8; 24]
    if !actcli.open() {
        return false
    }
    let n: u64 = ulib.digits(value, (&z[0 as usize]) as u64)
    z[(n) as usize] = 0 as u8
    actcli.req((&v_set[0 as usize]) as u64)
    actcli.arg((&k_key[0 as usize]) as u64, key)
    actcli.arg((&k_val[0 as usize]) as u64, (&z[0 as usize]) as u64)
    return actcli.send(300) == actcli.R_OK
}

fn mouse_say_state(ok: bool) {
    var s_ms: [u8; 23] = "settings: mouse speed=\0"
    var s_ac: [u8; 8] = " accel=\0"
    var s_na: [u8; 10] = " natural=\0"
    var s_ok: [u8; 5] = " ok=\0"
    var s_ge: [u8; 11] = " gestures=\0"
    var s_fp: [u8; 6] = " fps=\0"
    say((&s_ms[0 as usize]) as u64)
    sayn(ms_speed)
    say((&s_ac[0 as usize]) as u64)
    sayn(ms_accel)
    say((&s_na[0 as usize]) as u64)
    sayn(ms_nat)
    say((&s_ge[0 as usize]) as u64)
    sayn(ms_ges)
    say((&s_ok[0 as usize]) as u64)
    if ok {
        sayn(1)
    } else {
        sayn(0)
    }
    say((&s_fp[0 as usize]) as u64)
    sayn(ms_fps)
    nl()
}

// the status line under the page: saved, or why not
fn mouse_status(ok: bool) {
    if ok {
        let _a: u64 = text_an((&l_stat[0 as usize]) as u64, 0, msg.get((&k_ms_saved[0 as usize]) as u64))
    } else {
        let _b: u64 = text_an((&l_stat[0 as usize]) as u64, 0, msg.get((&k_ms_nobus[0 as usize]) as u64))
    }
}

fn mouse_store(which: u64) {
    var k_speed: [u8; 12] = "mouse.speed\0"
    var k_accel: [u8; 12] = "mouse.accel\0"
    var k_nat: [u8; 14] = "mouse.natural\0"
    var k_ges: [u8; 15] = "mouse.gestures\0"
    var k_fps: [u8; 10] = "debug.fps\0"
    var ok: bool = false
    if which == 0 {
        ok = mouse_bus_set((&k_speed[0 as usize]) as u64, ms_speed)
    } else if which == 1 {
        ok = mouse_bus_set((&k_accel[0 as usize]) as u64, ms_accel)
    } else if which == 2 {
        ok = mouse_bus_set((&k_nat[0 as usize]) as u64, ms_nat)
    } else if which == 3 {
        ok = mouse_bus_set((&k_ges[0 as usize]) as u64, ms_ges)
    } else {
        ok = mouse_bus_set((&k_fps[0 as usize]) as u64, ms_fps)
    }
    if !ok {
        ok = mouse_file_write()
    }
    mouse_status(ok)
    mouse_say_state(ok)
    melde_stand()
}

fn mouse_slider(id: u64) {
    if id == K_MS_SPD {
        ms_speed = slv(K_MS_SPD, 10, 400)
        mouse_clamp()
        mouse_store(0)
    } else {
        ms_accel = slv(K_MS_ACC, 0, 5)
        mouse_clamp()
        mouse_store(1)
    }
}

fn mouse_toggle() {
    if (fuiscene.value_of(K_MS_NAT) as u64) != 0 {
        ms_nat = 1
    } else {
        ms_nat = 0
    }
    mouse_store(2)
}

fn mouse_toggle_ges() {
    if (fuiscene.value_of(K_MS_GES) as u64) != 0 {
        ms_ges = 1
    } else {
        ms_ges = 0
    }
    mouse_store(3)
}

fn mouse_toggle_fps() {
    if (fuiscene.value_of(K_MS_FPS) as u64) != 0 {
        ms_fps = 1
    } else {
        ms_fps = 0
    }
    mouse_store(4)
}

// page R_MAUS
fn page_maus(left: usize, right: usize) {
    // the scene tree is capped at 128 nodes (scene.SCENE_MAX): the page header already says "Mouse", so no title label here
    let _n_ms2: usize = fuiscene.label(left, msg.get((&k_ms_note[0 as usize]) as u64))
    let r_spd: usize = fuiscene.row(left)
    let l_spd: usize = fuiscene.label(r_spd, msg.get((&k_ms_speed[0 as usize]) as u64))
    fuiscene.set_size(l_spd, fitw(150), 0)
    let _n_spd: usize = fuiscene.slider(r_spd, K_MS_SPD, 200, slv_init(K_MS_SPD, 10, 400, ms_speed))
    fuiscene.slider_readout(K_MS_SPD, 10, 400, true)
    let r_acc: usize = fuiscene.row(left)
    let l_acc: usize = fuiscene.label(r_acc, msg.get((&k_ms_accel[0 as usize]) as u64))
    fuiscene.set_size(l_acc, fitw(150), 0)
    let _n_acc: usize = fuiscene.slider(r_acc, K_MS_ACC, 200, slv_init(K_MS_ACC, 0, 5, ms_accel))
    fuiscene.slider_readout(K_MS_ACC, 0, 5, false)
    let _n_nat: usize = fuiscene.toggle(left, msg.get((&k_ms_nat[0 as usize]) as u64), K_MS_NAT, (ms_nat != 0))
    let _n_ges: usize = fuiscene.toggle(left, msg.get((&k_ms_ges[0 as usize]) as u64), K_MS_GES, (ms_ges != 0))
    let _n_fps: usize = fuiscene.toggle(left, msg.get((&k_ms_fps[0 as usize]) as u64), K_MS_FPS, (ms_fps != 0))
}

// ============================================ ROUND R783 (L-007c): page Energie
// The eight values live in /etc/power.conf (schema keys power.*, `store` lines); powerd re-reads the file. Left column =
// on battery, right column = on mains. Index 0 = battery, 1 = mains. Screen/standby are shown in minutes, stored in seconds.
static mut pw_lid: [u64; 2] = [0 as u64; 2]
static mut pw_prof: [u64; 2] = [0 as u64; 2]
static mut pw_scr: [u64; 2] = [0 as u64; 2]
static mut pw_sby: [u64; 2] = [0 as u64; 2]
static mut pw_bri: [u64; 2] = [101 as u64; 2]
static mut pw_conf: [u8; 16] = "/etc/power.conf\0"
static mut pw_buf: [u8; 512] = [0 as u8; 512]

// the value after "key=" in pw_buf (pointer), 0 when missing
fn pw_val(key: u64) -> u64 {
    let at: u64 = ulib.find((&pw_buf[0 as usize]) as u64, key)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return ((&pw_buf[0 as usize]) as u64) + at + ulib.length(key)
}

fn pw_num(key: u64, def: u64) -> u64 {
    let v: u64 = pw_val(key)
    if v == 0 {
        return def
    }
    let c: u64 = rb(v, 0)
    if c < 48 || c > 57 {
        return def
    }
    return ulib.to_num(v)
}

// sleep=0 hibernate=1 nothing=2 shutdown=3 (the order of the schema enum)
fn pw_lid_idx(key: u64, def: u64) -> u64 {
    let v: u64 = pw_val(key)
    if v == 0 {
        return def
    }
    let c: u64 = rb(v, 0)
    if c == 115 {
        if rb(v, 1) == 104 {
            return 3
        }
        return 0
    }
    if c == 104 {
        return 1
    }
    if c == 110 {
        return 2
    }
    return def
}

// save=0 balanced=1 performance=2
fn pw_prof_idx(key: u64, def: u64) -> u64 {
    let v: u64 = pw_val(key)
    if v == 0 {
        return def
    }
    let c: u64 = rb(v, 0)
    if c == 115 {
        return 0
    }
    if c == 98 {
        return 1
    }
    if c == 112 {
        return 2
    }
    return def
}

fn pw_clamp() {
    var i: u64 = 0
    while i < 2 {
        if pw_lid[(i) as usize] > 3 {
            pw_lid[(i) as usize] = 0
        }
        if pw_prof[(i) as usize] > 2 {
            pw_prof[(i) as usize] = 1
        }
        if pw_scr[(i) as usize] > 60 {
            pw_scr[(i) as usize] = 60
        }
        if pw_sby[(i) as usize] > 240 {
            pw_sby[(i) as usize] = 240
        }
        i = i + 1
    }
}

fn pw_sync_kval() {
    kval[(K_PW_LB) as usize] = pw_lid[0]
    kval[(K_PW_LA) as usize] = pw_lid[1]
    kval[(K_PW_PB) as usize] = pw_prof[0]
    kval[(K_PW_PA) as usize] = pw_prof[1]
}

fn pw_load() {
    var a: [u8; 9] = "lid_bat=\0"
    var b: [u8; 8] = "lid_ac=\0"
    var c: [u8; 12] = "screen_bat=\0"
    var d: [u8; 11] = "screen_ac=\0"
    var e: [u8; 13] = "standby_bat=\0"
    var f: [u8; 12] = "standby_ac=\0"
    var g: [u8; 13] = "profile_bat=\0"
    var h: [u8; 12] = "profile_ac=\0"
    var i: [u8; 12] = "bright_bat=\0"
    var j: [u8; 11] = "bright_ac=\0"
    pw_buf[0] = 0 as u8
    let fd: u64 = io.open((&pw_conf[0 as usize]) as u64, 0)
    if !ulib.bad(fd) {
        let n: u64 = io.read(fd, (&pw_buf[0 as usize]) as u64, 500)
        io.close(fd)
        if !ulib.bad(n) && n > 0 {
            __mmio_write8((((&pw_buf[0 as usize]) as u64) + n) as *mut u8, 0 as u8)
        }
    }
    pw_lid[0] = pw_lid_idx((&a[0 as usize]) as u64, 0)
    pw_lid[1] = pw_lid_idx((&b[0 as usize]) as u64, 0)
    pw_scr[0] = pw_num((&c[0 as usize]) as u64, 300) / 60
    pw_scr[1] = pw_num((&d[0 as usize]) as u64, 600) / 60
    pw_sby[0] = pw_num((&e[0 as usize]) as u64, 900) / 60
    pw_sby[1] = pw_num((&f[0 as usize]) as u64, 0) / 60
    pw_prof[0] = pw_prof_idx((&g[0 as usize]) as u64, 0)
    pw_prof[1] = pw_prof_idx((&h[0 as usize]) as u64, 1)
    pw_bri[0] = pw_num((&i[0 as usize]) as u64, 101)
    pw_bri[1] = pw_num((&j[0 as usize]) as u64, 101)
    pw_clamp()
    pw_sync_kval()
}

static mut pw_w_sleep: [u8; 6] = "sleep\0"
static mut pw_w_hib: [u8; 10] = "hibernate\0"
static mut pw_w_none: [u8; 8] = "nothing\0"
static mut pw_w_down: [u8; 9] = "shutdown\0"
static mut pw_w_save: [u8; 5] = "save\0"
static mut pw_w_bal: [u8; 9] = "balanced\0"
static mut pw_w_perf: [u8; 12] = "performance\0"
fn pw_lid_word(i: u64) -> u64 {
    if i == 1 {
        return (&pw_w_hib[0 as usize]) as u64
    }
    if i == 2 {
        return (&pw_w_none[0 as usize]) as u64
    }
    if i == 3 {
        return (&pw_w_down[0 as usize]) as u64
    }
    return (&pw_w_sleep[0 as usize]) as u64
}

fn pw_prof_word(i: u64) -> u64 {
    if i == 0 {
        return (&pw_w_save[0 as usize]) as u64
    }
    if i == 2 {
        return (&pw_w_perf[0 as usize]) as u64
    }
    return (&pw_w_bal[0 as usize]) as u64
}

fn pw_line(b: u64, key: u64, num: u64, word: u64) {
    var z: [u8; 24] = [0 as u8; 24]
    var eq: [u8; 2] = "=\0"
    var nl2: [u8; 2] = "\n\0"
    ulib.strcat(b, key)
    ulib.strcat(b, (&eq[0 as usize]) as u64)
    if word != 0 {
        ulib.strcat(b, word)
    } else {
        let d: u64 = ulib.digits(num, (&z[0 as usize]) as u64)
        z[(d) as usize] = 0 as u8
        ulib.strcat(b, (&z[0 as usize]) as u64)
    }
    ulib.strcat(b, (&nl2[0 as usize]) as u64)
}

fn pw_file_write() -> bool {
    var h: [u8; 46] = "# /etc/power.conf -- written by settings\n\0\0\0\0\0"
    var a: [u8; 8] = "lid_bat\0"
    var b: [u8; 7] = "lid_ac\0"
    var c: [u8; 11] = "screen_bat\0"
    var d: [u8; 10] = "screen_ac\0"
    var e: [u8; 12] = "standby_bat\0"
    var f: [u8; 11] = "standby_ac\0"
    var g: [u8; 12] = "profile_bat\0"
    var hh: [u8; 11] = "profile_ac\0"
    var i: [u8; 11] = "bright_bat\0"
    var j: [u8; 10] = "bright_ac\0"
    let bp: u64 = (&pw_buf[0 as usize]) as u64
    ulib.strcpy(bp, (&h[0 as usize]) as u64)
    pw_line(bp, (&a[0 as usize]) as u64, 0, pw_lid_word(pw_lid[0]))
    pw_line(bp, (&b[0 as usize]) as u64, 0, pw_lid_word(pw_lid[1]))
    pw_line(bp, (&c[0 as usize]) as u64, pw_scr[0] * 60, 0)
    pw_line(bp, (&d[0 as usize]) as u64, pw_scr[1] * 60, 0)
    pw_line(bp, (&e[0 as usize]) as u64, pw_sby[0] * 60, 0)
    pw_line(bp, (&f[0 as usize]) as u64, pw_sby[1] * 60, 0)
    pw_line(bp, (&g[0 as usize]) as u64, 0, pw_prof_word(pw_prof[0]))
    pw_line(bp, (&hh[0 as usize]) as u64, 0, pw_prof_word(pw_prof[1]))
    pw_line(bp, (&i[0 as usize]) as u64, pw_bri[0], 0)
    pw_line(bp, (&j[0 as usize]) as u64, pw_bri[1], 0)
    let fd: u64 = io.create((&pw_conf[0 as usize]) as u64)
    if ulib.bad(fd) {
        return false
    }
    let len: u64 = ulib.length(bp)
    let g2: u64 = io.write_all(fd, bp, len)
    io.close(fd)
    return !ulib.bad(g2) && g2 >= len
}

// one key through the bus (value as text); false when there is no bus or it refused
fn pw_bus_set(key: u64, value: u64) -> bool {
    var v_set: [u8; 18] = "call settings.set\0"
    var k_key: [u8; 4] = "key\0"
    var k_val: [u8; 6] = "value\0"
    if !actcli.open() {
        return false
    }
    actcli.req((&v_set[0 as usize]) as u64)
    actcli.arg((&k_key[0 as usize]) as u64, key)
    actcli.arg((&k_val[0 as usize]) as u64, value)
    return actcli.send(300) == actcli.R_OK
}

fn pw_bus_num(key: u64, v: u64) -> bool {
    var z: [u8; 24] = [0 as u8; 24]
    let d: u64 = ulib.digits(v, (&z[0 as usize]) as u64)
    z[(d) as usize] = 0 as u8
    return pw_bus_set(key, (&z[0 as usize]) as u64)
}

fn pw_say_state(ok: bool) {
    var s0: [u8; 17] = "settings: power \0"
    var s1: [u8; 6] = "lidb=\0"
    var s2: [u8; 7] = " lida=\0"
    var s3: [u8; 7] = " scrb=\0"
    var s4: [u8; 7] = " scra=\0"
    var s5: [u8; 7] = " sbyb=\0"
    var s6: [u8; 7] = " sbya=\0"
    var s7: [u8; 7] = " prfb=\0"
    var s8: [u8; 7] = " prfa=\0"
    var s9: [u8; 5] = " ok=\0"
    say((&s0[0 as usize]) as u64)
    say((&s1[0 as usize]) as u64)
    sayn(pw_lid[0])
    say((&s2[0 as usize]) as u64)
    sayn(pw_lid[1])
    say((&s3[0 as usize]) as u64)
    sayn(pw_scr[0])
    say((&s4[0 as usize]) as u64)
    sayn(pw_scr[1])
    say((&s5[0 as usize]) as u64)
    sayn(pw_sby[0])
    say((&s6[0 as usize]) as u64)
    sayn(pw_sby[1])
    say((&s7[0 as usize]) as u64)
    sayn(pw_prof[0])
    say((&s8[0 as usize]) as u64)
    sayn(pw_prof[1])
    say((&s9[0 as usize]) as u64)
    if ok {
        sayn(1)
    } else {
        sayn(0)
    }
    nl()
}

// which = 0 lid bat, 1 lid ac, 2 screen bat, 3 screen ac, 4 standby bat, 5 standby ac, 6 profile bat, 7 profile ac
fn pw_store(which: u64) {
    var k0: [u8; 20] = "power.lid.battery\0\0\0"
    var k1: [u8; 18] = "power.lid.mains\0\0\0"
    var k2: [u8; 22] = "power.screen.battery\0\0"
    var k3: [u8; 20] = "power.screen.mains\0\0"
    var k4: [u8; 23] = "power.standby.battery\0\0"
    var k5: [u8; 21] = "power.standby.mains\0\0"
    var k6: [u8; 22] = "power.profile.battery\0"
    var k7: [u8; 20] = "power.profile.mains\0"
    var ok: bool = false
    if which == 0 {
        ok = pw_bus_set((&k0[0 as usize]) as u64, pw_lid_word(pw_lid[0]))
    } else if which == 1 {
        ok = pw_bus_set((&k1[0 as usize]) as u64, pw_lid_word(pw_lid[1]))
    } else if which == 2 {
        ok = pw_bus_num((&k2[0 as usize]) as u64, pw_scr[0] * 60)
    } else if which == 3 {
        ok = pw_bus_num((&k3[0 as usize]) as u64, pw_scr[1] * 60)
    } else if which == 4 {
        ok = pw_bus_num((&k4[0 as usize]) as u64, pw_sby[0] * 60)
    } else if which == 5 {
        ok = pw_bus_num((&k5[0 as usize]) as u64, pw_sby[1] * 60)
    } else if which == 6 {
        ok = pw_bus_set((&k6[0 as usize]) as u64, pw_prof_word(pw_prof[0]))
    } else {
        ok = pw_bus_set((&k7[0 as usize]) as u64, pw_prof_word(pw_prof[1]))
    }
    if !ok {
        ok = pw_file_write()
    }
    if ok {
        let _a: u64 = text_an((&l_stat[0 as usize]) as u64, 0, msg.get((&k_pw_saved[0 as usize]) as u64))
    } else {
        let _b: u64 = text_an((&l_stat[0 as usize]) as u64, 0, msg.get((&k_pw_nobus[0 as usize]) as u64))
    }
    pw_say_state(ok)
    melde_stand()
}

fn pw_choice(id: u64) {
    if id == K_PW_LB {
        pw_lid[0] = kval[(K_PW_LB) as usize]
        pw_clamp()
        pw_store(0)
    } else if id == K_PW_LA {
        pw_lid[1] = kval[(K_PW_LA) as usize]
        pw_clamp()
        pw_store(1)
    } else if id == K_PW_PB {
        pw_prof[0] = kval[(K_PW_PB) as usize]
        pw_clamp()
        pw_store(6)
    } else {
        pw_prof[1] = kval[(K_PW_PA) as usize]
        pw_clamp()
        pw_store(7)
    }
}

fn pw_slider(id: u64) {
    if id == K_PW_SB {
        pw_scr[0] = slv(K_PW_SB, 0, 60)
        pw_clamp()
        pw_store(2)
    } else if id == K_PW_SA {
        pw_scr[1] = slv(K_PW_SA, 0, 60)
        pw_clamp()
        pw_store(3)
    } else if id == K_PW_YB {
        pw_sby[0] = slv(K_PW_YB, 0, 240)
        pw_clamp()
        pw_store(4)
    } else {
        pw_sby[1] = slv(K_PW_YA, 0, 240)
        pw_clamp()
        pw_store(5)
    }
}

fn page_energie_col(col: usize, head: u64, kl: u64, ks: u64, ky: u64, kp: u64, i: u64) {
    let _h: usize = fuiscene.label(col, head)
    let _l1: usize = fuiscene.label(col, msg.get((&k_pw_lid[0 as usize]) as u64))
    let _c1: usize = fuiscene.choice(col, chtext(kl, msg.get((&k_pw_lids[0 as usize]) as u64)), kl)
    let r_s: usize = fuiscene.row(col)
    let l_s: usize = fuiscene.label(r_s, msg.get((&k_pw_scr[0 as usize]) as u64))
    fuiscene.set_size(l_s, fitw(170), 0)
    let _n_s: usize = fuiscene.slider(r_s, ks, 150, slv_init(ks, 0, 60, pw_scr[(i) as usize]))
    fuiscene.slider_readout(ks, 0, 60, false)
    let r_y: usize = fuiscene.row(col)
    let l_y: usize = fuiscene.label(r_y, msg.get((&k_pw_sby[0 as usize]) as u64))
    fuiscene.set_size(l_y, fitw(170), 0)
    let _n_y: usize = fuiscene.slider(r_y, ky, 150, slv_init(ky, 0, 240, pw_sby[(i) as usize]))
    fuiscene.slider_readout(ky, 0, 240, false)
    let _l2: usize = fuiscene.label(col, msg.get((&k_pw_prof[0 as usize]) as u64))
    let _c2: usize = fuiscene.choice(col, chtext(kp, msg.get((&k_pw_profs[0 as usize]) as u64)), kp)
}

// page R_ENERGIE
fn page_energie(left: usize, right: usize) {
    let _n_p1: usize = fuiscene.label(left, msg.get((&k_pw_title[0 as usize]) as u64))
    let _n_p2: usize = fuiscene.label(left, msg.get((&k_pw_note[0 as usize]) as u64))
    page_energie_col(left, msg.get((&k_pw_bat[0 as usize]) as u64), K_PW_LB, K_PW_SB, K_PW_YB, K_PW_PB, 0)
    page_energie_col(right, msg.get((&k_pw_ac[0 as usize]) as u64), K_PW_LA, K_PW_SA, K_PW_YA, K_PW_PA, 1)
}


// ROUND MINT4 (E1): run /bin/sysinfo with its output going to /tmp/osum-report.txt
// (same descriptor dance as konto_lauf). Returns the exit code, 255 on exec failure.
fn info_export() -> u64 {
    var t_bin: [u8; 13] = "/bin/sysinfo\0"
    var t_tmp: [u8; 5] = "/tmp\0"
    var t_out: [u8; 23] = "/tmp/osum-report.txt\0\0\0"
    var argv: [u64; 1] = [0 as u64; 1]
    argv[(0) as usize] = (&t_bin[0 as usize]) as u64
    let _md: u64 = ulib.sys(ulib.SYS_MKDIR, (&t_tmp[0 as usize]) as u64, 448, 0)
    let s1: u64 = ulib.sys(ulib.SYS_DUP, 1, 0, 0)
    let afd: u64 = ulib.sys(ulib.SYS_OPEN, (&t_out[0 as usize]) as u64, ulib.O_MAKE, 384)
    if ulib.bad(afd) {
        if !ulib.bad(s1) {
            ulib.sys(ulib.SYS_CLOSE, s1, 0, 0)
        }
        return 254
    }
    ulib.sys(ulib.SYS_DUP2, afd, 1, 0)
    ulib.sys(ulib.SYS_CLOSE, afd, 0, 0)
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&t_bin[0 as usize]) as u64, (&argv[0 as usize]) as u64, 1)
    if !ulib.bad(s1) {
        ulib.sys(ulib.SYS_DUP2, s1, 1, 0)
        ulib.sys(ulib.SYS_CLOSE, s1, 0, 0)
    }
    if ulib.bad(pid) {
        return 255
    }
    return ulib.wait_code(pid)
}

// how many bytes the exported report has (first 4095 read; 0 = missing/empty)
fn info_size() -> u64 {
    var t_out: [u8; 23] = "/tmp/osum-report.txt\0\0\0"
    var buf: [u8; 4096] = [0 as u8; 4096]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&t_out[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&buf[0 as usize]) as u64, 4095)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

// ==========================================================================================================
// R_APPS -- THE APP INFO PAGE (W-AR6B, r919). One row per app (counters), a click opens the detail view.
//
// Data and actions go through /bin/apprights (list / set / stop) and /bin/opk (remove) as child processes whose
// stdout lands in a /tmp file (same pattern as info_export). The kernel table only accepts a change from an
// UNLABELLED caller (sys.fi do_rights), not from a certain uid, and /etc/apprights.conf is written the way Settings
// writes its other /etc/*.conf files -- so the smallest correct way is a plain child process of Settings, no new
// settingsd area. If the file cannot be written, the grant still holds for this session and the page says so.
// Only rights the manifest declared (ceiling = perm=) are switches; the rest is text. "Battery share" is the CPU
// share among all apps: there is no per-app power meter and the label says so.
// ==========================================================================================================
const AP_MAX: u64 = 16
const AP_NONE: u64 = 255
const AP_CEIL_NONE: u64 = 8192 // `apprights list`: no manifest ceiling registered
const AP_NRIGHTS: u64 = 13
const AP_BIT_NOTIFY: u64 = 4
const K_AP_LIST0: u64 = 400 // 400 .. 415: one button per app
const K_AP_BACK: u64 = 416
const K_AP_REF: u64 = 417
const K_AP_RIGHT0: u64 = 420 // 420 .. 432: one switch per right (bit number)
const K_AP_STOP: u64 = 440
const K_AP_UNINST: u64 = 441
const K_AP_CLEAR: u64 = 442
const K_AP_ENERGY: u64 = 443
const K_AP_PAUSE: u64 = 444

static mut ap_sel: u64 = 255
static mut ap_selname: [u8; 24] = [0 as u8; 24]
static mut ap_arm: u64 = 0 // "Uninstall" was clicked once
static mut ap_n: u64 = 0
static mut ap_name: [u8; 384] = [0 as u8; 384] // 16 x 24
static mut ap_mask: [u64; 16] = [0 as u64; 16]
static mut ap_ceil: [u64; 16] = [0 as u64; 16]
static mut ap_man: [u64; 16] = [0 as u64; 16] // 1 = the manifest ceiling is known
static mut ap_cpu: [u64; 16] = [0 as u64; 16]
static mut ap_wake: [u64; 16] = [0 as u64; 16]
static mut ap_tx: [u64; 16] = [0 as u64; 16]
static mut ap_rx: [u64; 16] = [0 as u64; 16]
static mut ap_data: [u64; 16] = [0 as u64; 16]
static mut ap_cpu_total: u64 = 0
static mut ap_raw: [u8; 2048] = [0 as u8; 2048]
static mut ap_line: [u8; 1536] = [0 as u8; 1536] // 16 x 96: the button texts of the list
static mut ap_txt: [u8; 2048] = [0 as u8; 2048] // 8 x 256: the lines of the detail view
static mut l_apstat: [u8; 160] = [0 as u8; 160]

fn ap_name_ptr(k: u64) -> u64 {
    return ((&ap_name[0 as usize]) as u64) + k * 24
}

// run `path` with argv (argc pointers); its stdout goes to /tmp/osum-apps.out; returns the exit code (254/255 = could not start)
fn ap_run(path: u64, argv: u64, argc: u64) -> u64 {
    var t_tmp: [u8; 5] = "/tmp\0"
    var t_out: [u8; 19] = "/tmp/osum-apps.out\0"
    let _md: u64 = ulib.sys(ulib.SYS_MKDIR, (&t_tmp[0 as usize]) as u64, 448, 0)
    let _ul: u64 = ulib.sys(ulib.SYS_UNLINK, (&t_out[0 as usize]) as u64, 0, 0)
    let s1: u64 = ulib.sys(ulib.SYS_DUP, 1, 0, 0)
    let afd: u64 = ulib.sys(ulib.SYS_OPEN, (&t_out[0 as usize]) as u64, ulib.O_MAKE, 384)
    if ulib.bad(afd) {
        if !ulib.bad(s1) {
            ulib.sys(ulib.SYS_CLOSE, s1, 0, 0)
        }
        return 254
    }
    ulib.sys(ulib.SYS_DUP2, afd, 1, 0)
    ulib.sys(ulib.SYS_CLOSE, afd, 0, 0)
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, path, argv, argc)
    if !ulib.bad(s1) {
        ulib.sys(ulib.SYS_DUP2, s1, 1, 0)
        ulib.sys(ulib.SYS_CLOSE, s1, 0, 0)
    }
    if ulib.bad(pid) {
        return 255
    }
    return ulib.wait_code(pid)
}

// the child's output into ap_raw; returns the length (0 = nothing)
fn ap_read() -> u64 {
    var t_out: [u8; 19] = "/tmp/osum-apps.out\0"
    let base: u64 = (&ap_raw[0 as usize]) as u64
    __mmio_write8(base as *mut u8, 0 as u8)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&t_out[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return 0
    }
    var tot: u64 = 0
    var go: bool = true
    while go && tot < 2040 {
        let n: u64 = ulib.sys(ulib.SYS_READ, fd, base + tot, 2040 - tot)
        if ulib.bad(n) || n == 0 {
            go = false
        } else {
            tot = tot + n
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    __mmio_write8((base + tot) as *mut u8, 0 as u8)
    return tot
}

// does ap_raw contain `pat` (zero-terminated)?
fn ap_raw_has(pat: u64) -> bool {
    let base: u64 = (&ap_raw[0 as usize]) as u64
    let pl: u64 = ulib.length(pat)
    var i: u64 = 0
    while rb(base, i) != 0 {
        var k: u64 = 0
        while k < pl && rb(base, i + k) == rb(pat, k) {
            k = k + 1
        }
        if k == pl {
            return true
        }
        i = i + 1
    }
    return false
}

fn ap_set_field(k: u64, f: u64, v: u64) {
    if f == 0 {
        ap_mask[(k) as usize] = v
    } else if f == 1 {
        if v >= AP_CEIL_NONE {
            ap_ceil[(k) as usize] = 0
            ap_man[(k) as usize] = 0
        } else {
            ap_ceil[(k) as usize] = v
            ap_man[(k) as usize] = 1
        }
    } else if f == 2 {
        ap_cpu[(k) as usize] = v
    } else if f == 3 {
        ap_wake[(k) as usize] = v
    } else if f == 4 {
        ap_tx[(k) as usize] = v
    } else if f == 5 {
        ap_rx[(k) as usize] = v
    } else {
        ap_data[(k) as usize] = v
    }
}

// one line of `apprights list` after the word "app ": name mask ceil cpu wakeups tx rx data=N
fn ap_parse_line(base: u64, start: u64, e: u64, k: u64) {
    var p: u64 = start
    var q: u64 = 0
    while p < e && rb(base, p) != 32 {
        if q < 19 {
            ap_name[(k * 24 + q) as usize] = rb(base, p) as u8
            q = q + 1
        }
        p = p + 1
    }
    ap_name[(k * 24 + q) as usize] = 0 as u8
    var f: u64 = 0
    while f < 7 && p < e {
        while p < e && rb(base, p) == 32 {
            p = p + 1
        }
        var v: u64 = 0
        if rb(base, p) == 100 {
            v = num_from(base + p + 5)
        } else {
            v = num_from(base + p)
        }
        ap_set_field(k, f, v)
        while p < e && rb(base, p) != 32 {
            p = p + 1
        }
        f = f + 1
    }
}

fn ap_pct(k: u64) -> u64 {
    if ap_cpu_total == 0 {
        return 0
    }
    return ap_cpu[(k) as usize] * 100 / ap_cpu_total
}

// the button text of row k: name, CPU share, network bytes
fn ap_fmt_line(k: u64) {
    var s_sep: [u8; 4] = " - \0"
    var s_pc: [u8; 2] = "%\0"
    var s_sl: [u8; 2] = "/\0"
    var s_sp: [u8; 2] = " \0"
    let d: u64 = ((&ap_line[0 as usize]) as u64) + k * 96
    var a: u64 = text_an(d, 0, ap_name_ptr(k))
    a = text_an(d, a, (&s_sep[0 as usize]) as u64)
    a = text_an(d, a, msg.get((&k_ap_lcpu[0 as usize]) as u64))
    a = text_an(d, a, (&s_sp[0 as usize]) as u64)
    a = num_at(d, a, ap_pct(k))
    a = text_an(d, a, (&s_pc[0 as usize]) as u64)
    a = text_an(d, a, (&s_sep[0 as usize]) as u64)
    a = text_an(d, a, msg.get((&k_ap_lnet[0 as usize]) as u64))
    a = text_an(d, a, (&s_sp[0 as usize]) as u64)
    a = num_at(d, a, ap_tx[(k) as usize])
    a = text_an(d, a, (&s_sl[0 as usize]) as u64)
    a = num_at(d, a, ap_rx[(k) as usize])
}

// (re)read the table; keeps the selected app by name
// does /apps/<name>.osp or /apps/<name>.prog exist?
fn ap_bundle_there(name: u64) -> bool {
    var t_osp: [u8; 5] = ".osp\0"
    var t_prog: [u8; 6] = ".prog\0"
    var path: [u8; 64] = [0 as u8; 64]
    var t_dir: [u8; 7] = "/apps/\0"
    ulib.strcpy((&path[0 as usize]) as u64, (&t_dir[0 as usize]) as u64)
    ulib.strcat((&path[0 as usize]) as u64, name)
    let n: u64 = ulib.length((&path[0 as usize]) as u64)
    if n > 50 {
        return true
    }
    ulib.strcat((&path[0 as usize]) as u64, (&t_osp[0 as usize]) as u64)
    if ulib.is_dir((&path[0 as usize]) as u64) {
        return true
    }
    __mmio_write8(((&path[0 as usize]) as u64 + n) as *mut u8, 0 as u8)
    ulib.strcat((&path[0 as usize]) as u64, (&t_prog[0 as usize]) as u64)
    return ulib.is_dir((&path[0 as usize]) as u64)
}

fn ap_load() {
    var t_bin: [u8; 15] = "/bin/apprights\0"
    var t_list: [u8; 5] = "list\0"
    var argv: [u64; 2] = [0 as u64; 2]
    argv[(0) as usize] = (&t_bin[0 as usize]) as u64
    argv[(1) as usize] = (&t_list[0 as usize]) as u64
    ap_n = 0
    ap_cpu_total = 0
    let _rc: u64 = ap_run((&t_bin[0 as usize]) as u64, (&argv[0 as usize]) as u64, 2)
    let n: u64 = ap_read()
    let base: u64 = (&ap_raw[0 as usize]) as u64
    var i: u64 = 0
    while i < n && ap_n < AP_MAX {
        var e: u64 = i
        while e < n && rb(base, e) != 10 {
            e = e + 1
        }
        if e > i + 4 && rb(base, i) == 97 && rb(base, i + 1) == 112 && rb(base, i + 2) == 112 && rb(base, i + 3) == 32 {
            ap_parse_line(base, i + 4, e, ap_n)
            // a row of the kernel table without a bundle in /apps is an uninstalled app: not listed
            if ap_bundle_there(ap_name_ptr(ap_n)) {
                ap_cpu_total = ap_cpu_total + ap_cpu[(ap_n) as usize]
                ap_n = ap_n + 1
            }
        }
        i = e + 1
    }
    var k: u64 = 0
    while k < ap_n {
        ap_fmt_line(k)
        k = k + 1
    }
    if ap_sel != AP_NONE {
        var found: u64 = AP_NONE
        k = 0
        while k < ap_n {
            if ulib.streq(ap_name_ptr(k), (&ap_selname[0 as usize]) as u64) {
                found = k
            }
            k = k + 1
        }
        ap_sel = found
        if found == AP_NONE {
            ap_arm = 0
        }
    }
}

// the lines of the detail view of app k
fn ap_prep_detail(k: u64) {
    var s_sp: [u8; 2] = " \0"
    var s_pc: [u8; 2] = "%\0"
    var s_sl: [u8; 4] = " / \0"
    let b: u64 = (&ap_txt[0 as usize]) as u64
    // 0 name
    let _a0: u64 = text_an(b, 0, ap_name_ptr(k))
    // 1 battery share (= CPU share)
    var a: u64 = text_an(b + 256, 0, msg.get((&k_ap_lbat[0 as usize]) as u64))
    a = text_an(b + 256, a, (&s_sp[0 as usize]) as u64)
    a = num_at(b + 256, a, ap_pct(k))
    a = text_an(b + 256, a, (&s_pc[0 as usize]) as u64)
    // 2 wakeups
    a = text_an(b + 512, 0, msg.get((&k_ap_lwake[0 as usize]) as u64))
    a = text_an(b + 512, a, (&s_sp[0 as usize]) as u64)
    a = num_at(b + 512, a, ap_wake[(k) as usize])
    // 3 network
    a = text_an(b + 768, 0, msg.get((&k_ap_lsent[0 as usize]) as u64))
    a = text_an(b + 768, a, (&s_sp[0 as usize]) as u64)
    a = num_at(b + 768, a, ap_tx[(k) as usize])
    a = text_an(b + 768, a, (&s_sl[0 as usize]) as u64)
    a = num_at(b + 768, a, ap_rx[(k) as usize])
    // 4 data folder
    if ap_data[(k) as usize] != 0 {
        let _a4: u64 = text_an(b + 1024, 0, msg.get((&k_ap_data1[0 as usize]) as u64))
    } else {
        let _a4b: u64 = text_an(b + 1024, 0, msg.get((&k_ap_data0[0 as usize]) as u64))
    }
    // 5 not declared (text only); without a manifest: the one-line explanation
    if ap_man[(k) as usize] == 0 {
        let _a5: u64 = text_an(b + 1280, 0, msg.get((&k_ap_noman[0 as usize]) as u64))
    } else {
        a = text_an(b + 1280, 0, msg.get((&k_ap_nodecl[0 as usize]) as u64))
        var bit: u64 = 0
        while bit < AP_NRIGHTS {
            if bit != AP_BIT_NOTIFY && (ap_ceil[(k) as usize] & (1 << bit)) == 0 {
                a = text_an(b + 1280, a, (&s_sp[0 as usize]) as u64)
                a = text_an(b + 1280, a, policy.name_of_bit(1 << bit))
            }
            bit = bit + 1
        }
    }
}

fn ap_toggle_state(k: u64, bit: u64) -> bool {
    return (ap_mask[(k) as usize] & (1 << bit)) != 0
}

// page R_APPS
fn page_apps(left: usize, right: usize) {
    let _t1: usize = fuiscene.label(left, msg.get((&k_ap_title[0 as usize]) as u64))
    let _t2: usize = fuiscene.label(left, msg.get((&k_ap_note[0 as usize]) as u64))
    if ap_sel == AP_NONE || ap_sel >= ap_n {
        if ap_n == 0 {
            let _t3: usize = fuiscene.label(left, msg.get((&k_ap_none[0 as usize]) as u64))
        }
        var ki: u64 = 0
        while ki < ap_n {
            let nbl: usize = fuiscene.button(left, (((&ap_line[0 as usize]) as u64) + ki * 96), K_AP_LIST0 + ki)
            fuiscene.set_size(nbl, 0, 28)
            ki = ki + 1
        }
        let nr: usize = fuiscene.button(left, msg.get((&k_ap_ref[0 as usize]) as u64), K_AP_REF)
        fuiscene.set_size(nr, 0, 28)
        let _ts: usize = fuiscene.label(left, (&l_apstat[0 as usize]) as u64)
        return
    }
    let k: u64 = ap_sel
    ap_prep_detail(k)
    let b: u64 = (&ap_txt[0 as usize]) as u64
    let nb: usize = fuiscene.button(left, msg.get((&k_ap_back[0 as usize]) as u64), K_AP_BACK)
    fuiscene.set_size(nb, 0, 28)
    let _l0: usize = fuiscene.label(left, b)
    let _l1: usize = fuiscene.label(left, b + 256)
    let _l2: usize = fuiscene.label(left, b + 512)
    let _l3: usize = fuiscene.label(left, b + 768)
    let _l4: usize = fuiscene.label(left, b + 1024)
    let _lr: usize = fuiscene.label(left, msg.get((&k_ap_rights[0 as usize]) as u64))
    var bit: u64 = 0
    while bit < AP_NRIGHTS {
        if bit != AP_BIT_NOTIFY && (ap_ceil[(k) as usize] & (1 << bit)) != 0 {
            let _sw: usize = fuiscene.toggle(left, policy.name_of_bit(1 << bit), K_AP_RIGHT0 + bit, ap_toggle_state(k, bit))
        }
        bit = bit + 1
    }
    let _l5: usize = fuiscene.label(left, b + 1280)
    // right card: notifications = the right `notify`, the actions, the not yet possible switches (greyed out)
    let nn: usize = fuiscene.toggle(right, msg.get((&k_ap_noti[0 as usize]) as u64), K_AP_RIGHT0 + AP_BIT_NOTIFY,
        ap_toggle_state(k, AP_BIT_NOTIFY))
    if (ap_ceil[(k) as usize] & (1 << AP_BIT_NOTIFY)) == 0 {
        fuiscene.set_enabled(nn, false)
    }
    let ns: usize = fuiscene.button(right, msg.get((&k_ap_stop[0 as usize]) as u64), K_AP_STOP)
    fuiscene.set_size(ns, 0, 28)
    var u_key: u64 = 0
    if ap_arm != 0 {
        u_key = (&k_ap_uninst2[0 as usize]) as u64
    } else {
        u_key = (&k_ap_uninst[0 as usize]) as u64
    }
    let nu: usize = fuiscene.button(right, msg.get(u_key), K_AP_UNINST)
    fuiscene.set_size(nu, 0, 28)
    let nc: usize = fuiscene.button(right, msg.get((&k_ap_clear[0 as usize]) as u64), K_AP_CLEAR)
    fuiscene.set_size(nc, 0, 28)
    // there is no clear-data action before AR-3 (no recursive remove, no /data/<app> yet): always greyed out
    fuiscene.set_enabled(nc, false)
    let _lc: usize = fuiscene.label(right, msg.get((&k_ap_clearnote[0 as usize]) as u64))
    let ne: usize = fuiscene.button(right, msg.get((&k_ap_energy[0 as usize]) as u64), K_AP_ENERGY)
    fuiscene.set_size(ne, 0, 28)
    fuiscene.set_enabled(ne, false)
    let np: usize = fuiscene.button(right, msg.get((&k_ap_pause[0 as usize]) as u64), K_AP_PAUSE)
    fuiscene.set_size(np, 0, 28)
    fuiscene.set_enabled(np, false)
    let _ts2: usize = fuiscene.label(right, (&l_apstat[0 as usize]) as u64)
}

fn ap_status(key: u64) {
    let _s: u64 = text_an((&l_apstat[0 as usize]) as u64, 0, msg.get(key))
}

fn ap_redraw() {
    fuiscene.refresh()
    rep_due = 1
}

// `apprights set <app> <rights of newmask>`; true = the kernel table now holds newmask
fn ap_set(k: u64, newmask: u64) {
    var s_set: [u8; 4] = "set\0"
    var t_bin: [u8; 15] = "/bin/apprights\0"
    var s_l1: [u8; 20] = "settings: apps set \0"
    var s_l2: [u8; 7] = " mask=\0"
    var s_l3: [u8; 5] = " rc=\0"
    var s_l4: [u8; 8] = " saved=\0"
    var argv: [u64; 20] = [0 as u64; 20]
    argv[(0) as usize] = (&t_bin[0 as usize]) as u64
    argv[(1) as usize] = (&s_set[0 as usize]) as u64
    argv[(2) as usize] = ap_name_ptr(k)
    var argc: u64 = 3
    var bit: u64 = 0
    while bit < AP_NRIGHTS {
        if (newmask & (1 << bit)) != 0 && argc < 19 {
            argv[(argc) as usize] = policy.name_of_bit(1 << bit)
            argc = argc + 1
        }
        bit = bit + 1
    }
    let rc: u64 = ap_run((&t_bin[0 as usize]) as u64, (&argv[0 as usize]) as u64, argc)
    let _n: u64 = ap_read()
    var saved: u64 = 1
    var s_ns: [u8; 10] = "not saved\0"
    if ap_raw_has((&s_ns[0 as usize]) as u64) {
        saved = 0
    }
    var name: [u8; 24] = [0 as u8; 24]
    let _c: u64 = text_an((&name[0 as usize]) as u64, 0, ap_name_ptr(k))
    ap_load()
    var now: u64 = 0
    var j: u64 = 0
    while j < ap_n {
        if ulib.streq(ap_name_ptr(j), (&name[0 as usize]) as u64) {
            now = ap_mask[(j) as usize]
        }
        j = j + 1
    }
    ulib.say((&s_l1[0 as usize]) as u64)
    ulib.say((&name[0 as usize]) as u64)
    ulib.say((&s_l2[0 as usize]) as u64)
    ulib.sayn(now)
    ulib.say((&s_l3[0 as usize]) as u64)
    ulib.sayn(rc)
    ulib.say((&s_l4[0 as usize]) as u64)
    ulib.sayn(saved)
    ulib.nl()
    if now != newmask {
        ap_status((&k_ap_fail[0 as usize]) as u64)
    } else if saved == 0 {
        ap_status((&k_ap_nosave[0 as usize]) as u64)
    } else {
        ap_status((&k_ap_ok[0 as usize]) as u64)
    }
}

// force stop: every task labelled app:<name> gets killed
fn ap_stop(k: u64) {
    var s_stop: [u8; 5] = "stop\0"
    var t_bin: [u8; 15] = "/bin/apprights\0"
    var s_l1: [u8; 21] = "settings: apps stop \0"
    var s_l2: [u8; 5] = " rc=\0"
    var s_l3: [u8; 9] = " killed=\0"
    var s_w: [u8; 16] = "apprights: stop\0"
    var argv: [u64; 3] = [0 as u64; 3]
    argv[(0) as usize] = (&t_bin[0 as usize]) as u64
    argv[(1) as usize] = (&s_stop[0 as usize]) as u64
    argv[(2) as usize] = ap_name_ptr(k)
    let rc: u64 = ap_run((&t_bin[0 as usize]) as u64, (&argv[0 as usize]) as u64, 3)
    let n: u64 = ap_read()
    var killed: u64 = 0
    if n > 16 {
        killed = num_from((&ap_raw[0 as usize]) as u64 + 16)
    }
    ulib.say((&s_l1[0 as usize]) as u64)
    ulib.say(ap_name_ptr(k))
    ulib.say((&s_l2[0 as usize]) as u64)
    ulib.sayn(rc)
    ulib.say((&s_l3[0 as usize]) as u64)
    ulib.sayn(killed)
    ulib.nl()
    if rc == 0 {
        ap_status((&k_ap_ok[0 as usize]) as u64)
    } else {
        ap_status((&k_ap_fail[0 as usize]) as u64)
    }
    ap_load()
}

// uninstall: `opk remove <app>` (it forgets the grants itself)
fn ap_uninstall(k: u64) {
    var s_rm: [u8; 7] = "remove\0"
    var t_bin: [u8; 9] = "/bin/opk\0"
    var s_l1: [u8; 26] = "settings: apps uninstall \0"
    var s_l2: [u8; 5] = " rc=\0"
    var argv: [u64; 3] = [0 as u64; 3]
    argv[(0) as usize] = (&t_bin[0 as usize]) as u64
    argv[(1) as usize] = (&s_rm[0 as usize]) as u64
    argv[(2) as usize] = ap_name_ptr(k)
    let rc: u64 = ap_run((&t_bin[0 as usize]) as u64, (&argv[0 as usize]) as u64, 3)
    ulib.say((&s_l1[0 as usize]) as u64)
    ulib.say(ap_name_ptr(k))
    ulib.say((&s_l2[0 as usize]) as u64)
    ulib.sayn(rc)
    ulib.nl()
    ap_sel = AP_NONE
    ap_arm = 0
    ap_load()
    if rc == 0 {
        ap_status((&k_ap_ok[0 as usize]) as u64)
    } else {
        ap_status((&k_ap_fail[0 as usize]) as u64)
    }
}

fn ap_click(id: u64) {
    var s_op: [u8; 21] = "settings: apps open \0"
    __mmio_write8((&l_apstat[0 as usize]) as u64 as *mut u8, 0 as u8)
    if id >= K_AP_LIST0 && id < K_AP_LIST0 + AP_MAX {
        let pk: u64 = id - K_AP_LIST0
        if pk < ap_n {
            ap_sel = pk
            ap_arm = 0
            let _c: u64 = text_an((&ap_selname[0 as usize]) as u64, 0, ap_name_ptr(pk))
            ulib.say((&s_op[0 as usize]) as u64)
            ulib.say(ap_name_ptr(pk))
            ulib.nl()
        }
    } else if id == K_AP_BACK {
        ap_sel = AP_NONE
        ap_arm = 0
        ap_load()
    } else if id == K_AP_REF {
        ap_load()
    } else if ap_sel != AP_NONE && ap_sel < ap_n {
        let k: u64 = ap_sel
        if id >= K_AP_RIGHT0 && id < K_AP_RIGHT0 + AP_NRIGHTS {
            let bit: u64 = id - K_AP_RIGHT0
            if (ap_ceil[(k) as usize] & (1 << bit)) == 0 {
                // above the ceiling: refused here (the kernel would refuse it too)
                var s_rf: [u8; 24] = "settings: apps refused \0"
                ulib.say((&s_rf[0 as usize]) as u64)
                ulib.say(ap_name_ptr(k))
                ulib.nl()
                ap_status((&k_ap_fail[0 as usize]) as u64)
            } else {
                ap_set(k, ap_mask[(k) as usize] ^ (1 << bit))
            }
            ap_arm = 0
        } else if id == K_AP_STOP {
            ap_arm = 0
            ap_stop(k)
        } else if id == K_AP_UNINST {
            if ap_arm == 0 {
                ap_arm = 1
            } else {
                ap_uninstall(k)
            }
        }
        // K_AP_CLEAR / K_AP_ENERGY / K_AP_PAUSE: greyed out, nothing to do
    }
    ap_redraw()
}

// the rectangles and report lines for the acceptance runs (tools/appinfo)
fn ap_rects() {
    var s_ls: [u8; 23] = "settings: apps list n=\0"
    var s_rw: [u8; 20] = "settings: apps row \0"
    var s_m: [u8; 7] = " mask=\0"
    var s_c: [u8; 7] = " ceil=\0"
    var s_p: [u8; 6] = " cpu=\0"
    var s_d: [u8; 23] = "settings: apps detail \0"
    var s_da: [u8; 7] = " data=\0"
    var s_ar: [u8; 6] = " arm=\0"
    if ap_sel == AP_NONE || ap_sel >= ap_n {
        ulib.say((&s_ls[0 as usize]) as u64)
        ulib.sayn(ap_n)
        ulib.nl()
        var ri: u64 = 0
        while ri < ap_n {
            var nm: [u8; 5] = "apl?\0"
            nm[(3) as usize] = (97 + ri) as u8
            rect_say((&nm[0 as usize]) as u64, K_AP_LIST0 + ri)
            ulib.say((&s_rw[0 as usize]) as u64)
            ulib.say(ap_name_ptr(ri))
            ulib.say((&s_m[0 as usize]) as u64)
            ulib.sayn(ap_mask[(ri) as usize])
            ulib.say((&s_c[0 as usize]) as u64)
            ulib.sayn(ap_ceil[(ri) as usize])
            ulib.say((&s_p[0 as usize]) as u64)
            ulib.sayn(ap_cpu[(ri) as usize])
            ulib.nl()
            ri = ri + 1
        }
        var n1: [u8; 5] = "apfr\0"
        rect_say((&n1[0 as usize]) as u64, K_AP_REF)
        return
    }
    let k: u64 = ap_sel
    ulib.say((&s_d[0 as usize]) as u64)
    ulib.say(ap_name_ptr(k))
    ulib.say((&s_m[0 as usize]) as u64)
    ulib.sayn(ap_mask[(k) as usize])
    ulib.say((&s_c[0 as usize]) as u64)
    ulib.sayn(ap_ceil[(k) as usize])
    ulib.say((&s_da[0 as usize]) as u64)
    ulib.sayn(ap_data[(k) as usize])
    ulib.say((&s_ar[0 as usize]) as u64)
    ulib.sayn(ap_arm)
    ulib.nl()
    var bit: u64 = 0
    while bit < AP_NRIGHTS {
        var nr: [u8; 5] = "apr?\0"
        nr[(3) as usize] = (97 + bit) as u8
        rect_say((&nr[0 as usize]) as u64, K_AP_RIGHT0 + bit)
        bit = bit + 1
    }
    var n2: [u8; 5] = "apbk\0"
    var n3: [u8; 5] = "apsp\0"
    var n4: [u8; 5] = "apun\0"
    var n5: [u8; 5] = "apcl\0"
    var n6: [u8; 5] = "apen\0"
    var n7: [u8; 5] = "appa\0"
    rect_say((&n2[0 as usize]) as u64, K_AP_BACK)
    rect_say((&n3[0 as usize]) as u64, K_AP_STOP)
    rect_say((&n4[0 as usize]) as u64, K_AP_UNINST)
    rect_say((&n5[0 as usize]) as u64, K_AP_CLEAR)
    rect_say((&n6[0 as usize]) as u64, K_AP_ENERGY)
    rect_say((&n7[0 as usize]) as u64, K_AP_PAUSE)
}

