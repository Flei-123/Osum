                        n = n + 1
                    }
                    if setaccount.opt_word((&cobuf[0 as usize]) as u64, 40,
                        (&v_co[0 as usize]) as u64,
                        (&setbase.e_kcode[0 as usize]) as u64) {
                        argv[(n) as usize] = (&cobuf[0 as usize]) as u64
                        n = n + 1
                    }
                    let rc: u64 = setaccount.account_run((&argv[0 as usize]) as u64, n,
                        (&setbase.e_kgeh[0 as usize]) as u64)
                    var g: u64 = 0
                    while g < 64 {
                        setbase.e_kgeh[(g) as usize] = 0 as u8
                        g = g + 1
                    }
                    fuiscene.entry_set(setbase.K_EKGEH, (&setbase.e_kgeh[0 as usize]) as u64)
                    var txt: [u8; 96] = [0 as u8; 96]
                    let hat: bool = setaccount.account_field((&kf_text[0 as usize]) as u64,
                        (&txt[0 as usize]) as u64, 96)
                    var at: u64 = 0
                    if rc == 0 {
                        at = setcore.text_an((&setbase.l_kstat[0 as usize]) as u64, 0,
                            msg.get((&k_m_kok[0 as usize]) as u64))
                    } else {
                        setbase.acct_more = 1
                        at = setcore.text_an((&setbase.l_kstat[0 as usize]) as u64, 0,
                            msg.get((&k_m_kbad[0 as usize]) as u64))
                    }
                    if hat {
                        let _t2: u64 = setcore.text_an((&setbase.l_kstat[0 as usize]) as u64,
                            at, (&txt[0 as usize]) as u64)
                    }
                    setaccount.accounts_read()
                    fuiscene.refresh()
                    setaccount.book_state()

                    setpages.report_state()
                } else if id == setbase.K_BKDEV || id == setbase.K_BKBOOK {

                    var d_an: [u8; 6] = "login\0"
                    var d_b0: [u8; 11] = "/bin/konto\0"
                    var d_ge: [u8; 9] = "--device\0"
                    var d_zw: [u8; 12] = "--continue=\0"
                    var dbuf: [u8; 48] = [0 as u8; 48]
                    var dzw: [u8; 140] = [0 as u8; 140]
                    var dargv: [u64; 8] = [0 as u64; 8]
                    var dv_anb: [u8; 12] = "--provider=\0"
                    var d_ta: [u8; 11] = "--exchange\0"
                    var dn: u64 = 0
                    var dopen: u64 = 0
                    while dv_anb[(dopen) as usize] != 0 as u8 {
                        dbuf[(dopen) as usize] = dv_anb[(dopen) as usize]
                        dopen = dopen + 1
                    }
                    var dz: u64 = 0
                    var dq: u64 = 0
                    while setbase.k_anbn[(dq) as usize] != 0 as u8 && dopen + 1 < 48 {
                        if setbase.k_anbn[(dq) as usize] == 10 as u8 {
                            dz = dz + 1
                        } else if dz == setbase.kval[(setbase.K_CKANB) as usize] {
                            dbuf[(dopen) as usize] = setbase.k_anbn[(dq) as usize]
                            dopen = dopen + 1
                        }
                        dq = dq + 1
                    }
                    dbuf[(dopen) as usize] = 0 as u8
                    let _dcm: bool = setaccount.conf_remember(
                        (&dbuf[(11) as usize]) as u64,
                        (&setbase.e_kziel[0 as usize]) as u64,
                        (&setbase.e_kname[0 as usize]) as u64)
                    dargv[(dn) as usize] = (&d_b0[0 as usize]) as u64
                    dn = dn + 1
                    dargv[(dn) as usize] = (&d_an[0 as usize]) as u64
                    dn = dn + 1
                    dargv[(dn) as usize] = (&dbuf[0 as usize]) as u64
                    dn = dn + 1
                    dargv[(dn) as usize] = (&d_ge[0 as usize]) as u64
                    dn = dn + 1
                    if setaccount.opt_word((&dzw[0 as usize]) as u64, 140,
                        (&d_zw[0 as usize]) as u64,
                        (&dev_zw[0 as usize]) as u64) {
                        dargv[(dn) as usize] = (&dzw[0 as usize]) as u64
                        dn = dn + 1
                    }
                    if id == setbase.K_BKBOOK {

                        dargv[(dn) as usize] = (&d_ta[0 as usize]) as u64
                        dn = dn + 1
                    }
                    let drc: u64 = setaccount.account_run((&dargv[0 as usize]) as u64, dn, 0)
                    var dtxt: [u8; 96] = [0 as u8; 96]
                    var dcode: [u8; 24] = [0 as u8; 24]
                    var durl: [u8; 100] = [0 as u8; 100]
                    let dhat: bool = setaccount.account_field((&kf_text[0 as usize]) as u64,
                        (&dtxt[0 as usize]) as u64, 96)
                    var dat: u64 = 0
                    if drc == 11 {

                        let _c1: bool = setaccount.account_field((&kf_code[0 as usize]) as u64,
                            (&dcode[0 as usize]) as u64, 24)
                        let _c2: bool = setaccount.account_field((&kf_url[0 as usize]) as u64,
                            (&durl[0 as usize]) as u64, 60)
                        if dev_zw[0] == 0 as u8 {
                            let _c3: bool = setaccount.account_field_any((&kf_zw[0 as usize]) as u64,
                                (&kf_zw_old[0 as usize]) as u64,
                                (&dev_zw[0 as usize]) as u64, 120)
                        }
                        dat = setcore.text_an((&setbase.l_kstat[0 as usize]) as u64, 0,
                            msg.get((&k_m_kcode[0 as usize]) as u64))
                        dat = setcore.text_an((&setbase.l_kstat[0 as usize]) as u64, dat,
                            (&dcode[0 as usize]) as u64)
                        let _sp: u64 = setcore.text_an((&setbase.l_kstat[0 as usize]) as u64, dat,
                            (&durl[0 as usize]) as u64)
                    } else {

                        var dg: u64 = 0
                        while dg < 120 {
                            dev_zw[(dg) as usize] = 0 as u8
                            dg = dg + 1
                        }
                        var dtau: [u8; 24] = [0 as u8; 24]
                        var dhin: [u8; 160] = [0 as u8; 160]
                        var dsw: bool = false
                        if id == setbase.K_BKBOOK {

                            dsw = setaccount.account_field((&kf_exchange[0 as usize]) as u64,
                                (&dtau[0 as usize]) as u64, 24)
                            if !dsw {
                                dsw = setaccount.account_field((&kf_tausch[0 as usize]) as u64,
                                    (&dtau[0 as usize]) as u64, 24)
                            }
                        }
                        if dsw {
                            let dh: bool = setaccount.account_field_any((&kf_hint[0 as usize]) as u64,
                                (&kf_hint_old[0 as usize]) as u64,
                                (&dhin[0 as usize]) as u64, 160)
                            var hp: u64 = 0
                            if dh {
                                hp = (&dhin[0 as usize]) as u64
                            }
                            dat = setcore.text_an((&setbase.l_kstat[0 as usize]) as u64, 0,
                                msg.get(setaccount.book_key((&dtau[0 as usize]) as u64, hp)))
                        } else if drc == 0 {
                            dat = setcore.text_an((&setbase.l_kstat[0 as usize]) as u64, 0,
                                msg.get((&k_m_kok[0 as usize]) as u64))
                        } else {
                            dat = setcore.text_an((&setbase.l_kstat[0 as usize]) as u64, 0,
                                msg.get((&k_m_kbad[0 as usize]) as u64))
                        }
                        if dhat && !dsw {
                            let _t3: u64 = setcore.text_an((&setbase.l_kstat[0 as usize]) as u64,
                                dat, (&dtxt[0 as usize]) as u64)
                        }
                    }
                    setaccount.accounts_read()
                    fuiscene.refresh()
                    setaccount.book_state()
                    setpages.report_state()
                } else if id == setbase.K_BKOUT {
                    var kbuf: [u8; 40] = [0 as u8; 40]
                    if setbase.k_n == 0 || !setaccount.account_id(fuiscene.table_sel(setbase.K_LKONTEN),
                        (&kbuf[0 as usize]) as u64, 40) {
                        let _s1: u64 = setcore.text_an((&setbase.l_kstat[0 as usize]) as u64,
                            0, msg.get((&k_m_ksel[0 as usize]) as u64))
                    } else {
                        var a_ab: [u8; 7] = "logout\0"
                        var a_ke2: [u8; 11] = "--identity\0"
                        var a_b1: [u8; 11] = "/bin/konto\0"
                        var argv2: [u64; 4] = [0 as u64; 4]
                        argv2[(0) as usize] = (&a_b1[0 as usize]) as u64
                        argv2[(1) as usize] = (&a_ab[0 as usize]) as u64
                        argv2[(2) as usize] = (&a_ke2[0 as usize]) as u64
                        argv2[(3) as usize] = (&kbuf[0 as usize]) as u64
                        let _rc2: u64 = setaccount.account_run(
                            (&argv2[0 as usize]) as u64, 4, 0)
                        let _s2: u64 = setcore.text_an((&setbase.l_kstat[0 as usize]) as u64,
                            0, msg.get((&k_m_kout[0 as usize]) as u64))
                        setaccount.accounts_read()
                        fuiscene.refresh()
                        setaccount.book_state()

                    }

                    setpages.report_state()
                } else if id == setbase.K_B8 {
                    var code: u64 = (&c_en[0 as usize]) as u64
                    if setbase.kval[(setbase.K_CL) as usize] == 1 {
                        code = (&c_de[0 as usize]) as u64
                    }
                    let kb_rc: u64 = ulib.sys(setbase.SYS_KBD, KB_SET,
                        setbase.kval[(setbase.K_CK2) as usize], 0)
                    if !ulib.bad(kb_rc) {
                        let _kb_saved: bool = kbdconf.save(setbase.kval[(setbase.K_CK2) as usize])
                    }
                    if setbuild.lang_write(code) {
                        let _sl: bool = msg.set_lang(code)
                        fuiscene.set_title(msg.get((&k_t_title[0 as usize]) as u64))
                        setsystem.state_read()
                        let al: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_langok[0 as usize]) as u64))
                        let _sm: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64,
                            al, code)
                    } else {
                        let _sn: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_langno[0 as usize]) as u64))
                    }
                    setpages.report_state()
                }
            }
            setaccount.push_entries()
            fuiscene.refresh()
            setbase.rep_due = 1
        }
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
