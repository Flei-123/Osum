fn u_start(args: u64) -> u64 {
    setaccount.dbg_setup(args)
    setarrange.args_scan(args)
    setaccount.widths_init()
    var s_bad: [u8; 24] = "settings: no surface\0\0\0\0"
    var s_rd: [u8; 19] = "settings: ready w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var t_theme: [u8; 11] = "/etc/theme\0"
    var t_schemas: [u8; 13] = "/etc/schemas\0"
    var t_wall: [u8; 15] = "/etc/wallpaper\0"
    var t_disp: [u8; 18] = "/etc/display.conf\0"
    var t_time: [u8; 15] = "/etc/time.conf\0"
    var t_net: [u8; 18] = "/etc/network.conf\0"
    var t_dhcp: [u8; 10] = "/bin/dhcp\0"
    var k_ndh: [u8; 9] = "net.dhcp\0"
    var k_true: [u8; 5] = "true\0"
    var k_m_ok: [u8; 22] = "settings.status.ready\0"
    var k_m_schema: [u8; 26] = "settings.status.scheme_ok\0"
    var k_m_schemano: [u8; 28] = "settings.status.scheme_fail\0"
    var k_m_image: [u8; 29] = "settings.status.wallpaper_ok\0"
    var k_m_bildno: [u8; 31] = "settings.status.wallpaper_fail\0"
    var k_m_modeok: [u8; 24] = "settings.status.mode_ok\0"
    var m_mal: [u8; 4] = " x \0"
    var k_m_modeno: [u8; 26] = "settings.status.mode_fail\0"
    var k_m_behalt: [u8; 21] = "settings.status.keep\0"
    var k_m_back: [u8; 23] = "settings.status.revert\0"
    var k_m_time: [u8; 29] = "settings.status.time_written\0"
    var k_m_net: [u8; 28] = "settings.status.net_written\0"
    var k_m_netzno: [u8; 24] = "settings.status.net_bad\0"
    var k_m_netzr: [u8; 27] = "settings.status.net_denied\0"
    var k_m_dhcp: [u8; 29] = "settings.status.dhcp_started\0"
    var k_m_kwok: [u8; 22] = "settings.status.pw_ok\0"
    var k_m_kwne: [u8; 28] = "settings.status.pw_mismatch\0"
    var k_m_kwku: [u8; 25] = "settings.status.pw_short\0"
    var k_m_kwno: [u8; 24] = "settings.status.pw_fail\0"
    var k_m_pinok: [u8; 23] = "settings.status.pin_ok\0"
    var k_m_pinfmt: [u8; 27] = "settings.status.pin_format\0"
    var k_m_pinno: [u8; 25] = "settings.status.pin_fail\0"
    var k_m_pinrm: [u8; 28] = "settings.status.pin_removed\0"
    var k_m_pinwr: [u8; 26] = "settings.status.pin_wrong\0"
    var k_m_pinlk: [u8; 27] = "settings.status.pin_locked\0"
    var k_m_pindis: [u8; 29] = "settings.status.pin_disabled\0"
    var k_m_nvok: [u8; 22] = "settings.status.nv_ok\0"
    var k_m_nvno: [u8; 26] = "settings.status.nv_denied\0"
    var k_m_fbok: [u8; 22] = "settings.status.fb_ok\0"
    var k_m_fbno: [u8; 26] = "settings.status.fb_denied\0"
    var k_modus: [u8; 7] = "modus=\0"
    var k_800: [u8; 9] = "800x600\n\0"
    var k_1024: [u8; 10] = "1024x768\n\0"
    var k_off: [u8; 8] = "offset=\0"
    var k_nl: [u8; 2] = "\n\0"
    var k_dh: [u8; 12] = "modus=dhcp\n\0"
    var k_fe: [u8; 15] = "modus=fest\nip=\0"
    var k_mk: [u8; 8] = "\nmaske=\0"
    var k_gw: [u8; 10] = "\ngateway=\0"
    var s_path: [u8; 41] = "                                        \0"

    var s_lg: [u8; 18] = "settings: lang=\0\0\0"
    var s_lgs: [u8; 8] = " src=\0\0\0"
    var s_lgk: [u8; 8] = " keys=\0\0"
    let mk: u64 = msg.init()
    let _sr: bool = setroute.init()
    navview.set_keys(setbase.K_NAVBACK, setbase.K_NAVFWD, K_NAVUP, setbase.K_CRUMB0)
    navview.set_related_key(K_REL0)
    setcore.say((&s_lg[0 as usize]) as u64)
    setcore.say(msg.lang())
    setcore.say((&s_lgs[0 as usize]) as u64)
    setcore.sayn(msg.lang_source())
    setcore.say((&s_lgk[0 as usize]) as u64)
    setcore.sayn(mk)
    setcore.nl()
    fuiscene.set_flags(false, false)
    if !fuiscene.begin() {
        setcore.say((&s_bad[0 as usize]) as u64)
        setcore.nl()
        return 1
    }
    let _t: u64 = wlibc.theme_reload()
    setcore.shape_say()
    let _n: u64 = setcore.schemas_read((&t_schemas[0 as usize]) as u64)
    setcore.contrast_show()
    let _h: u64 = setcore.text_an((&setbase.e_image[0 as usize]) as u64, 0,
        (&t_wall[0 as usize]) as u64)
    let _s: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0,
        msg.get((&k_m_ok[0 as usize]) as u64))
    setsystem.state_read()
    setbuild.tb_read()

    setcore.templates_read()
    setcore.template_con_show()
    setaccount.account_show()

    var bw: u64 = 760 + setbase.SIDE_W + 8

    let scr_w: u64 = wlibc.screen_w() / wlibc.ui_scale()
    let scr_h: u64 = wlibc.screen_h() / wlibc.ui_scale()
    if scr_w < bw + 40 {
        bw = scr_w - 40
    }

    var bh: u64 = 600
    if scr_h >= 700 {
        bh = 700
    }

    if scr_h < 600 && scr_h < bh + 50 {
        bh = scr_h - 50
        if bh < 300 {
            bh = 300
        }
    }
    fuiscene.set_dense(true)
    setbase.active_tab = setbase.start_page
    setroute.note_page(setbase.active_tab)

    if setbase.start_page != setbase.R_DARST {
        setbase.nav_detail = true
    }

    fuiapp.set_atomic(true)
    if !fuiscene.open(20, 3, bw, bh, msg.get((&k_t_title[0 as usize]) as u64), setbuild.build) {
        setcore.say((&s_bad[0 as usize]) as u64)
        setcore.nl()
        return 1
    }

    var win_app_name: [u8; 9] = "settings\0"
    fuiscene.set_app((&win_app_name[0 as usize]) as u64)
    setbase.w = fuiscene.win_id()
    setcore.say((&s_rd[0 as usize]) as u64)
    setcore.sayn(bw)
    setcore.say((&s_hh[0 as usize]) as u64)
    setcore.sayn(bh)
    setcore.nl()
    var s_hd: [u8; 17] = "settings: heads \0"
    setcore.say((&s_hd[0 as usize]) as u64)
    setcore.say((&setbase.l_heads[0 as usize]) as u64)
    setcore.nl()
    setbuild.init_values()
    setnet.mode_init()

    if setbase.start_page != setbase.R_DARST {
        setpages.bus_page(setbase.start_page)
    }
    if displaymode.current_mirror() {
        setbase.kval[(setbase.K_CHM) as usize] = 1
    } else {
        setbase.kval[(setbase.K_CHM) as usize] = 0
    }
    setcore.sr_load()

    if setcore.dget(setbase.DG_READY) == 1 {
        let _f1: u64 = setcore.num_at((&setbase.e_cw[0 as usize]) as u64, 0, setcore.dget(DG_PANELW))
        let _f2: u64 = setcore.num_at((&setbase.e_ch[0 as usize]) as u64, 0, setcore.dget(DG_PANELH))
        let _f3: u64 = setcore.num_at((&setbase.e_ct[0 as usize]) as u64, 0, setcore.dget(DG_BPP))
        setcore.save_read()
        fuiscene.table_prep(setbase.K_CS)
        fuiscene.table_set_sel(setbase.K_CS, setcore.dget(DG_CUR))
        setbase.kval[(setbase.K_CK) as usize] = setcore.dget(DG_SCALE)
        setbase.kval[(setbase.K_CD) as usize] = setcore.dget(DG_ROT) / 90
        setbase.kval[(setbase.K_CH) as usize] = setcore.level_from(setcore.dget(DG_BRIGHT), 0)
        setbase.kval[(setbase.K_CC) as usize] = setcore.level_from(setcore.dget(DG_CONTRAST), 0)
        setbase.kval[(setbase.K_CG) as usize] = setcore.level_from(setcore.dget(DG_GAMMA), 1)
        setbase.kval[(setbase.K_CQ) as usize] = setcore.level_from(setcore.dget(DG_SAT), 2)
        setaccount.push_entries()
    }

    fuiscene.refresh()
    let _p0: u64 = fuiscene.pump()
    setcore.template_say()
    var s_tl: [u8; 19] = "settings: tiles n=\0"
    var s_tl2: [u8; 8] = " shown=\0"
    var s_tl3: [u8; 8] = " acct=\0\0"
    setcore.say((&s_tl[0 as usize]) as u64)
    setcore.sayn(setbase.v_n)
    setcore.say((&s_tl2[0 as usize]) as u64)
    if setbase.v_n < setbase.TILES {
        setcore.sayn(setbase.v_n)
    } else {
        setcore.sayn(setbase.TILES)
    }
    setcore.say((&s_tl3[0 as usize]) as u64)
    if template.account_have() {
        setcore.sayn(1)
    } else {
        setcore.sayn(0)
    }
    setcore.nl()
    var n_edge: [u8; 5] = "edge\0"
    var n_size: [u8; 5] = "size\0"
    var n_ah: [u8; 9] = "autohide\0"
    var n_ot: [u8; 6] = "ontop\0"
    var n_ap: [u8; 6] = "apply\0"
    var n_win: [u8; 4] = "win\0"
    setcore.say((&setbase.mr_a[0 as usize]) as u64)
    setcore.say((&n_win[0 as usize]) as u64)
    setcore.say((&setbase.ms_b[0 as usize]) as u64)
    setcore.sayn(apphost.win_x(setbase.w))
    setcore.say((&setbase.ms_c[0 as usize]) as u64)
    setcore.sayn(apphost.win_y(setbase.w))
    setcore.say((&setbase.mr_w[0 as usize]) as u64)
    setcore.sayn(bw)
    setcore.say((&setbase.mr_h[0 as usize]) as u64)
    setcore.sayn(bh)
    setcore.say((&setbase.mr_ax[0 as usize]) as u64)
    setcore.sayn(apphost.win_cx(setbase.w))
    setcore.say((&setbase.mr_ay[0 as usize]) as u64)
    setcore.sayn(apphost.win_cy(setbase.w))
    setcore.nl()
    setcore.rect_say((&n_edge[0 as usize]) as u64, setbase.K_CE)
    setcore.rect_say((&n_size[0 as usize]) as u64, setbase.K_ET)
    setcore.rect_say((&n_ah[0 as usize]) as u64, setbase.K_KA)
    setcore.rect_say((&n_ot[0 as usize]) as u64, setbase.K_KO)
    setcore.rect_say((&n_ap[0 as usize]) as u64, K_B1)
    setbuild.tb_say()
    setpages.report_elements()
    setpages.report_fui()
    setpages.report_state()
    setbuild.rects_all()
    setpages.bus_rects()

    setsystem.net_live_build()
    fuiscene.refresh()

    var runden: u64 = 0
    var deadline_ahead: u64 = 0
    var arr_sig: u64 = setarrange.signature()
    var arr_ahead: u64 = 0
    var arr_said: bool = false
    fuiscene.set_raw(setarrange.raw)
    setarrange.sync_scale()

    var net_ahead: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    var ping_vor: u64 = net_ahead
    while fuiscene.alive() && runden < 1000000000000 {
        runden = runden + 1
        let arr_now: u64 = setarrange.clock_ms()
        if arr_now >= arr_ahead + 100 {
            arr_ahead = arr_now
            setarrange.hotplug_test(arr_now)
            let sig_now: u64 = setarrange.signature()
            if sig_now != arr_sig {
                arr_sig = sig_now
                setsystem.heads_reread()
                setarrange.sync_scale()
                fuiscene.refresh()
                setbase.rep_due = 1
                arr_said = false
            }
            if !arr_said && setbase.active_tab == setbase.R_SCREEN3 {
                arr_said = true
                setarrange.layout_say()
            }
        }
        if setbase.active_tab == setbase.R_NET || setbase.active_tab == setbase.R_NETDETAIL || setbase.active_tab == setbase.R_NETV {
            let now: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
            if now >= net_ahead + 100 {
                net_ahead = now
                setcore.throughput_measure()
                if now >= ping_vor + 500 {
                    ping_vor = now
                    setcore.ping_gateway()
                }
                let before: u64 = setsystem.net_sum()
                setsystem.net_live_build()

                if setsystem.net_sum() != before {
                    fuiscene.refresh()
                }
            }
        }
        if setbase.active_tab == setbase.R_WIFI {
            if setwifi.tick(ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)) {
                fuiscene.refresh()
                setbase.rep_due = 1
            }
        }
        if setbase.active_tab == setbase.R_BLUETOOTH {
            if setbt.tick(ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)) {
                fuiscene.refresh()
                setbase.rep_due = 1
            }
        }
        if setbase.active_tab == setbase.R_SCREEN {

            var pend_now: u64 = 0
            if setcore.dget(setbase.DG_PENDING) == 1 {
                pend_now = 1
            }
            let rest: u64 = setcore.remain_secs() * 2 + pend_now

            if pend_now == 1 {
                rv_kept = 0
            }
            if pend_vor == 1 && pend_now == 0 && rv_kept == 0 {
                let _rv: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0,
                    msg.get((&k_m_back[0 as usize]) as u64))
                setpages.report_state()
            }
            pend_vor = pend_now
            if rest != deadline_ahead {
                deadline_ahead = rest
                let _fl: bool = setcore.deadline_read()
                if rest < 2 {
                    setsystem.state_read()
                }
                fuiscene.refresh()
            }
        }
        let iw: u64 = setcore.tba_wirksam()
        if iw != tba_gez {
            tba_gez = iw
            setcore.tba_label_set()

            setcore.glas_say()
        }
        let rq: u64 = fuiscene.resized()
        if rq != re_sq {
            re_sq = rq
            setbase.rep_due = 1
        }
        let sw: u64 = apphost.theme_switches()
        if sw != th_sw {
            th_sw = sw
            fuiscene.refresh()
            setbase.rep_due = 1
            setcore.glas_say()
        }
        let po: u64 = fuiscene.pane_offset(0) + fuiscene.pane_offset(1) * 100000
        if po != pane_prev {
            pane_prev = po
            setbase.rep_due = 1
        }

        let sq: u64 = fuiscene.entry_text(setbase.K_SRCH)
        if sq != 0 && !ulib.streq(sq, (&srch_prev[0 as usize]) as u64) {
            let _c1: u64 = ulib.strncpy((&srch_prev[0 as usize]) as u64, sq, 44)
            let _c2: u64 = ulib.strncpy((&setbase.e_srch[0 as usize]) as u64, sq, 44)
            __mmio_write8(((&srch_prev[0 as usize]) as u64 + 44) as *mut u8, 0 as u8)
            __mmio_write8(((&setbase.e_srch[0 as usize]) as u64 + 44) as *mut u8, 0 as u8)
            fuiscene.refresh()
            setbase.rep_due = 1
        }

        let kseq: u64 = fuiscene.key_seq()
        if kseq != ks_prev {
            ks_prev = kseq
            let ka: u64 = fuiscene.key_any()
            let fkk: u64 = fuiscene.focus_key()
            if ka == hostkey.KEY_CTRL_F {
                fuiscene.focus(setbase.K_SRCH)
            } else if ka == hostkey.KEY_OLD_LEFT {
                setpages.nav_act(navview.ACT_BACK, 0)
            } else if ka == hostkey.KEY_OLD_RIGHT {
                setpages.nav_act(navview.ACT_FORWARD, 0)
            } else if ka == hostkey.KEY_OLD_UP {
                setpages.nav_act(navview.ACT_UP, 0)
            } else if ka == hostkey.KEY_ENTER && fkk == setbase.K_EB {
                path_enter = true
            } else if ka == hostkey.KEY_ESC && regio.read8_at((&setbase.e_srch[0 as usize]) as u64, 0) != 0 {
                fuiscene.entry_set(setbase.K_SRCH, (&setbase.e_srch[0 as usize]) as u64 + 47)
                fuiscene.focus(setsystem.tab_key(setbase.active_tab))
            } else if ka == hostkey.KEY_ESC && setpages.nav_page_only() {
                setbase.nav_detail = false
                fuiscene.refresh()
                setbase.rep_due = 1
            } else if (ka == hostkey.KEY_DOWN || ka == hostkey.KEY_UP) && setdevice.key_page(fkk) != setbase.NO_PAGE {
                let nx: u64 = setpages.nav_step(setdevice.key_page(fkk), ka == hostkey.KEY_DOWN)
                if nx != setdevice.key_page(fkk) {
                    let keep_detail: bool = setbase.nav_detail
                    setbuild.goto_page(nx)
                    setbase.nav_detail = keep_detail
                    fuiscene.build_now()
                    fuiscene.focus(setsystem.tab_key(nx))
                }
            }
        }
        var key: u64 = fuiscene.pump()
        var ls_now: u64 = 99999
        if setbase.active_tab == setbase.R_SCHEME {
            ls_now = fuiscene.table_sel(setbase.K_LS)
        }
        if setbase.active_tab == setbase.R_SCHEME && key == 0 && ((ls_prev != 99999 && ls_now != ls_prev) || path_enter) {
            key = K_B1
        }
        ls_prev = ls_now
        var wn_now: u64 = 99999
        if setbase.active_tab == setbase.R_WIFI {
            wn_now = fuiscene.table_sel(setbase.K_WNETS)
        }
        if setbase.active_tab == setbase.R_WIFI && key == 0 && wn_prev != 99999 && wn_now != wn_prev && wn_now < 16 {
            setwifi.set_pick(wn_now)
            fuiscene.refresh()
            setbase.rep_due = 1
        }
        wn_prev = wn_now
        path_enter = false

        if key >= setbase.K_SEG0 && key < setbase.K_SEG0 + 3 {
            setbase.kval[(setbase.K_CM) as usize] = key - setbase.K_SEG0
            key = K_B1
        } else if key >= setbase.K_SW0 && key < setbase.K_SW0 + 8 {
            setsystem.accent_pick(key - setbase.K_SW0)
            setaccount.push_entries()
            key = K_B1
        } else if key == setbase.K_ACCC {
            setbase.acc_open = !setbase.acc_open
            fuiscene.refresh()
            setbase.rep_due = 1
            key = 0
        } else if key == setbase.K_HUE || key == setbase.K_SATU || key == setbase.K_VALU {
            setsystem.accent_from_sliders()
            setaccount.push_entries()
            key = K_B1
        } else if key == setbase.K_BACK {
            setbase.nav_detail = false
            fuiscene.refresh()
            setbase.rep_due = 1
            key = 0
        } else if navview.action_of(key) != navview.ACT_NONE {
            setpages.nav_act(navview.action_of(key), key)
            key = 0
        } else if key == setbase.K_SRCH {
            if setbase.nav_n > 0 {
                var first: u64 = setpages.nav_step(99, true)
                if setroute.top_page() != setroute.NONE {
                    first = setroute.top_page()
                }
                setbuild.goto_page(first)
            }
            key = 0
        } else if key == setbase.K_WP0 {

            fuiscene.focus(setbase.K_EB)
            key = 0
        }
        if key == 0 {
            if setbase.rep_due != 0 {
                setbase.rep_due = 0
                if setbase.side_scroll {
                    let seln: usize = fuiscene.node_of_key(setsystem.tab_key(setbase.active_tab))
                    if seln != fuiscene.NONE && setpages.side_tab_hidden(seln) {
                        let _sh: bool = fuiscene.pane_show(1, seln)
                    }
                }
                setbuild.rects_all()
                setpages.bus_rects()
                setpages.report_state()
            }
        } else {
            setaccount.pull_entries()
            var kind: u64 = setbase.CLICK_BUTTON
            var id: u64 = key
            var idx: u64 = 0
            if key >= setbase.K_TAB0 && key < setbase.K_TAB0 + setbase.R_ANZ {
                kind = setbase.CLICK_TABS
                idx = key - setbase.K_TAB0
            } else if key >= setbase.K_PKGTAB0 && key < setbase.K_PKGTAB0 + setbase.PKG_MAX {
                kind = setbase.CLICK_TABS
                idx = setbase.R_ANZ + key - setbase.K_PKGTAB0
            } else if key >= setbase.K_PKGF0 && key < setbase.K_PKGF0 + 340 {
                kind = setbase.CLICK_PACKAGE
            } else if setaccount.is_choice(key) {
                kind = setbase.CLICK_CHOICE
                idx = 4096
            } else if setaccount.is_slider(key) {
                kind = setbase.CLICK_SLIDER
            } else if key == fuiscene.KEY_POPUP {
                kind = setbase.CLICK_MENUBAR
                id = setbase.ch_pend
                idx = fuiscene.menu_pick() - 1
            }
            if kind == setbase.CLICK_PACKAGE {
                setsystem.pkg_click(key - setbase.K_PKGF0)
            } else if kind == setbase.CLICK_TABS {
                if setpages.nav_mode() {
                    setbase.nav_detail = true
                }
                setpages.bus_page(idx)
                setsystem.show_tab(idx)
                setpages.report_state()
            } else if kind == setbase.CLICK_CHOICE {
                setaccount.ch_open(id)
            } else if kind == setbase.CLICK_MENUBAR {
                if setaccount.is_choice(id) {
                    setbase.kval[(id) as usize] = idx
                    if id == setbase.K_VSEL && idx < setbase.v_n {
                        setbase.v_sel = idx
                        setcore.template_con_show()
                    }
                    if id == setbase.K_CZ {
                        setbase.kval[(setbase.K_CZC) as usize] = 0
                    }
                    if id == setbase.K_CE {
                        setbase.tb_edge = idx
                        setbuild.tb_show_size()
                        fuiscene.entry_set(setbase.K_ET, (&setbase.e_tbs[0 as usize]) as u64)
                    }
                    setcore.menu_done(id, idx)
                    if id == setbase.K_HSC {
                        setarrange.scale_apply(idx)
                        arr_said = false
                    }
                    if id == setbase.K_SRON || id == setbase.K_SRAU {
                        setcore.sr_apply_live()
                    }
                    if id == setbase.K_CN {
                        if setbase.kval[(setbase.K_CN) as usize] == 0 {
                            setnet.apply()
                        } else {
                            setnet.prefill_live()
                        }
                        fuiscene.refresh()
                        setbase.rep_due = 1
                    }
                    if id == setbase.K_CE || id == setbase.K_CAL {
                        setbuild.tb_apply_live()
                    }
                    if id == setbase.K_ZS1 || id == setbase.K_ZS2 || id == setbase.K_ZS3 || id == setbase.K_BS1 || id == setbase.K_BS2 {
                        setbuild.effects_apply_live()
                    }
                    if id == setbase.K_TRN {
                        setcore.trn_apply(idx)
                    }
                    if id == setbase.K_PW_LB || id == setbase.K_PW_LA || id == setbase.K_PW_PB || id == setbase.K_PW_PA {
                        setpages.pw_choice(id)
                    }
                }
            } else if kind == setbase.CLICK_SLIDER && (id == setbase.K_PW_SB || id == setbase.K_PW_SA || id == setbase.K_PW_YB || id == setbase.K_PW_YA) {
                setpages.pw_slider(id)
            } else if kind == setbase.CLICK_SLIDER && (id == setbase.K_MS_SPD || id == setbase.K_MS_ACC) {
                setpages.mouse_slider(id)
            } else if kind == setbase.CLICK_SLIDER && id == setbase.K_SND_VOL {
                setdevice.sound_slider()
            } else if kind == setbase.CLICK_SLIDER && id == setbase.K_TP_SPD {
                setpages.tp_slider()
            } else if kind == setbase.CLICK_BUTTON && id >= setbase.K_TP_TAP && id <= setbase.K_TP_ON && id != setbase.K_TP_SPD {
                setpages.tp_toggle(id)
            } else if kind == setbase.CLICK_BUTTON && setbt.owns(id) {
                setbt.click(id)
                fuiscene.refresh()
                setbase.rep_due = 1
            } else if kind == setbase.CLICK_BUTTON && id == setbase.K_SND_MUTE {
                setdevice.sound_toggle_mute()
            } else if kind == setbase.CLICK_BUTTON && id == setbase.K_SND_MIC {
                setdevice.sound_toggle_mic()
            } else if kind == setbase.CLICK_BUTTON && id == setbase.K_MS_NAT {
                setpages.mouse_toggle()
            } else if kind == setbase.CLICK_BUTTON && id == setbase.K_MS_GES {
                setpages.mouse_toggle_ges()
            } else if kind == setbase.CLICK_BUTTON && id == setbase.K_DEV_FPS {
                setpages.dev_toggle_fps()
            } else if kind == setbase.CLICK_BUTTON && id == setbase.K_DEV_MON {
                setpages.dev_toggle_mon()
            } else if kind == setbase.CLICK_BUTTON && id == setbase.K_DEV_PG {
                setpages.dev_toggle_pg()
            } else if kind == setbase.CLICK_BUTTON && id == setbase.K_MS_OSK {
                setdevice.osk_toggle()
            } else if kind == setbase.CLICK_SLIDER {

                if id == setbase.K_SL_RAD {
                    wlibc.set_radius(setaccount.slv(setbase.K_SL_RAD, 0, 24))
                } else if id == setbase.K_SL_TBA {
                    wlibc.set_tb_alpha(setaccount.slv(setbase.K_SL_TBA, 0, 100))
                } else if id == setbase.K_SL_WA {
                    wlibc.set_win_alpha(setaccount.slv(setbase.K_SL_WA, 0, 100))
                } else if id == setbase.K_SL_BLUR {
