fn widths_init() {
    c_nprog[0 as usize] = 146
    c_nprog[1 as usize] = 94
    c_nprog[2 as usize] = 94
    c_nprog[3 as usize] = 94
    c_nconn[0 as usize] = 34
    c_nconn[1 as usize] = 162
    c_nconn[2 as usize] = 162
    c_nconn[3 as usize] = 70
    c_sys[0 as usize] = 180
    c_sys[1 as usize] = 90
    c_sys[2 as usize] = 80
    c_sys[3 as usize] = 370
    c_rules[0 as usize] = 40
    c_rules[1 as usize] = 60
    c_rules[2 as usize] = 130
    c_rules[3 as usize] = 230
    c_rules[4 as usize] = 80
    c_rules[5 as usize] = 180
    c_cls[0 as usize] = 170
    var k: u64 = 1
    while k < 6 {
        c_cls[k as usize] = 90
        k = k + 1
    }
    c_proto[0 as usize] = 70
    c_proto[1 as usize] = 120
    c_proto[2 as usize] = 70
    c_proto[3 as usize] = 205
    c_proto[4 as usize] = 110
    c_proto[5 as usize] = 135
}
