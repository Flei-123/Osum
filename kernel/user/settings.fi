// page R_KONTO -- r136: the page comes from the SETTINGS manifest kernel/user/settings.d/accounts.settings
// (docs/SETTINGS-MANIFEST.md). This function only renders; the keys of the manifest are bound to the
// controls the event loop knows by acct_bind() below. Same widgets, same order, same ids as before.
const MAN_ACCOUNTS: str = __include_str("settings.d/accounts.settings")
static mut man_state: u64 = 0 // 0 not read yet, 1 read, 2 rejected
static mut pid_accounts: [u8; 9] = "accounts\0"
// the key names of the accounts page, one per line; the line number is the binding number (acct_bind)
const AB_NAMES: str = __include_str("settings.d/accounts.bind")
const AB_NONE: u64 = 99

fn man_ready() -> bool {
    if man_state == 0 {
        let m: str = MAN_ACCOUNTS
        let n: u64 = manifest.load(m.p as u64, m.n as u64)
        if n == manifest.ERR {
            man_state = 2
        } else {
            man_state = 1
        }
    }
    return man_state == 1
}

// the binding number of a manifest key (0-terminated text), AB_NONE when this page does not know it
fn acct_bind(key: u64) -> u64 {
    let m: str = AB_NAMES
    let ix: u64 = manifest.names_index(m.p as u64, m.n as u64, key)
    if ix == manifest.NONE {
        return AB_NONE
    }
    return ix
}

// the control id of a binding number
fn acct_id(ix: u64) -> u64 {
    if ix == 0 { return K_CKANB }
    if ix == 1 { return K_EKZIEL }
    if ix == 2 { return K_EKNAME }
    if ix == 3 { return K_EKKEN }
    if ix == 4 { return K_EKCODE }
    if ix == 5 { return K_BKADD }
    if ix == 6 { return K_BKDEV }
    if ix == 7 { return K_BKBOOK }
    if ix == 8 { return K_LKONTEN }
    if ix == 9 { return K_BKOUT }
    if ix == 12 { return K_EKGEH }
    if ix == 13 { return K_EKBER }
    return 0
}

// the buffer behind a binding number: entry text, the list text, the live status line
fn acct_buf(ix: u64) -> u64 {
    if ix == 0 { return (&k_anbn[0 as usize]) as u64 }
    if ix == 1 { return (&e_kziel[0 as usize]) as u64 }
    if ix == 2 { return (&e_kname[0 as usize]) as u64 }
    if ix == 3 { return (&e_kken[0 as usize]) as u64 }
    if ix == 4 { return (&e_kcode[0 as usize]) as u64 }
    if ix == 8 { return (&k_liste[0 as usize]) as u64 }
    if ix == 10 { return (&l_kstat[0 as usize]) as u64 }
    if ix == 11 { return (&l_kbook[0 as usize]) as u64 }
    if ix == 12 { return (&e_kgeh[0 as usize]) as u64 }
    if ix == 13 { return (&e_kber[0 as usize]) as u64 }
    return 0
}

fn page_konto(left: usize, right: usize) {
    if !man_ready() {
        return
    }
    let pg: u64 = manifest.page_find((&pid_accounts[0 as usize]) as u64)
    if pg == manifest.NONE {
        return
    }
    var i: u64 = manifest.page_first(pg)
    let end: u64 = i + manifest.page_len(pg)
    while i < end {
        var parent: usize = left
        if manifest.item_col(i) == 1 {
            parent = right
        }
        let kind: u64 = manifest.item_kind(i)
        let lab: u64 = manifest.item_label(i)
        if kind == manifest.K_LABEL {
            let _n_l: usize = fuiscene.label(parent, msg.get(lab))
        } else if kind == manifest.K_NOTE {
            let _n_w: usize = fuiscene.label_wrap(parent, msg.get(lab), manifest.item_num(i))
        } else if kind == manifest.K_FIELD {
            let ix: u64 = acct_bind(manifest.item_key(i))
            let ty: u64 = manifest.item_type(i)
            let id: u64 = acct_id(ix)
            let buf: u64 = acct_buf(ix)
            if ix != AB_NONE {
                if ty == manifest.T_ACTION {
                    let n_b: usize = fuiscene.button(parent, msg.get(lab), id)
                    fuiscene.button_fit(n_b, msg.get(lab), fitw(160))
                } else if ty == manifest.T_STATUS {
                    let _n_s: usize = fuiscene.label(parent, buf)
                } else if ty == manifest.T_LIST {
                    if lab != 0 {
                        let _n_ll: usize = fuiscene.label(parent, msg.get(lab))
                    }
                    let _n_t: usize = fuiscene.table_list(parent, id, 0, 150, 1, buf)
                } else if ty == manifest.T_CHOICE {
                    if lab != 0 {
                        let _n_cl: usize = fuiscene.label(parent, msg.get(lab))
                    }
                    let n_c: usize = fuiscene.choice(parent, chtext(id, buf), id)
                    fuiscene.set_size(n_c, 0, 28)
                } else if ty == manifest.T_TEXT || ty == manifest.T_SECRET {
                    if lab != 0 {
                        let _n_el: usize = fuiscene.label(parent, msg.get(lab))
                    }
                    let n_e: usize = fuiscene.entry(parent, id, 0, buf)
                    fuiscene.set_size(n_e, 0, 28)
                    if ty == manifest.T_SECRET {
                        fuiscene.entry_secret(id, true)
                    }
                }
            }
        }
        i = i + 1
    }
}


// ====================================================================
// r149: THE PAGES OF PACKAGES. At the start the window reads /apps/<app>.prog/SETTINGS of every app that
// `apprights list` names (a file of more than 3072 octets is not read at all, a rejected one is skipped: the other
// pages stay) and appends it to the catalogue (manifest.add_pkg). Every page of a package gets a tab in the
// sidebar (its `group` names the category: system display network accounts personal time update about, anything
// else lands in "Apps") and is drawn from generic fields, no binding table:
//   label / note       text
//   field bool         switch; `read <action>` gives the value (reply field = the field key), `write <action>`
//                      is called with key=true|false when it is switched
//   field action       button; calls its `write <action>` without arguments
//   field status       one line "label: value", the value is the reply field of its `read <action>`
//   field text/secret  entry; Enter calls its `write <action>` with key=<text>
//   field choice/list  not drawn yet (the manifest has no item list)
// Every call goes through the action bus (rights, confirmation, audit are the broker's). A package may call only
// actions of its OWN namespace: `<app>.` is the prefix of every action a page of <app> names. A critical action
// answers with a question: the status line says so and the next click on the same control confirms it.
// ====================================================================
const PKG_MAX: u64 = 8
static mut pkg_base: u64 = 0
const K_PKGTAB0: u64 = 600 // 600 .. 607: the sidebar entries of the package pages
const K_PKGF0: u64 = 620 // + the catalogue item number (< 240): the controls of a package page
const NO_PAGE: u64 = 4294967295
const GROUP_NAMES: str = __include_str("settings.d/groups.names")
static mut pkg_state: u64 = 0 // 0 not read yet, 1 read
static mut pkg_n: u64 = 0
static mut pkg_pg: [u64; 8] = [0 as u64; 8] // catalogue page of package page n
static mut pkg_buf: [u8; 3080] = [0 as u8; 3080]
static mut pkg_val: [u64; 80] = [0 as u64; 80] // bool value per item of the shown page
static mut pkg_txt: [u8; 5120] = [0 as u8; 5120] // text value per item (64 each)
static mut pkg_dsp: [u8; 8000] = [0 as u8; 8000] // "label: value" per item (100 each)
static mut pkg_stat: [u8; 200] = [0 as u8; 200]
static mut pkg_pend: u64 = 0 // the number of a question waiting for the second click
static mut pkg_pend_item: u64 = 0
static mut pkg_empty: [u8; 2] = [0 as u8; 2]
static mut pkg_call: [u8; 64] = [0 as u8; 64]
static mut k_settings_catpkg: [u8; 16] = "settings.catpkg\0"
static mut k_pkg_ok: [u8; 16] = "settings.pkg.ok\0"
static mut k_pkg_ask: [u8; 17] = "settings.pkg.ask\0"
static mut k_pkg_err: [u8; 17] = "settings.pkg.err\0"
static mut k_pkg_nobus: [u8; 19] = "settings.pkg.nobus\0"
static mut k_pkg_deny: [u8; 18] = "settings.pkg.deny\0"

fn pages_all() -> u64 {
    return R_ANZ + pkg_n
}

// the key of the sidebar entry of page p
fn tab_key(p: u64) -> u64 {
    if p >= R_ANZ {
        return K_PKGTAB0 + p - R_ANZ
    }
    return K_TAB0 + p
}

// the page of a sidebar key, NO_PAGE when the key is none
fn key_page(k: u64) -> u64 {
    if k >= K_TAB0 && k < K_TAB0 + R_ANZ {
        return k - K_TAB0
    }
    if k >= K_PKGTAB0 && k < K_PKGTAB0 + pkg_n {
        return R_ANZ + k - K_PKGTAB0
    }
    return NO_PAGE
}

// the sidebar category of package page n: its `group` when that is a built-in category, else "Apps"
fn pkg_cat(n: u64) -> u64 {
    if n >= pkg_n {
        return NCAT
    }
    let g: str = GROUP_NAMES
    let ix: u64 = manifest.names_index(g.p as u64, g.n as u64, manifest.page_group(pkg_pg[(n) as usize]))
    if ix == manifest.NONE {
        return NCAT
    }
    return ix
}

fn pkg_two(n: u64) -> bool {
    if n >= pkg_n {
        return false
    }
    let pg: u64 = pkg_pg[(n) as usize]
    var i: u64 = manifest.page_first(pg)
    let end: u64 = i + manifest.page_len(pg)
    while i < end {
        if manifest.item_col(i) == 1 {
            return true
        }
        i = i + 1
    }
    return false
}

fn pkg_names() {
    var n: u64 = 0
    while n < pkg_n {
        let t: u64 = msg.get(manifest.page_title(pkg_pg[(n) as usize]))
        let dst: u64 = ((&tab_buf[0 as usize]) as u64) + (R_ANZ + n) * 40
        let o: u64 = ulib.strncpy(dst, t, 38)
        __mmio_write8((dst + o) as *mut u8, 0 as u8)
        n = n + 1
    }
}

// one package: /apps/<name>.prog/SETTINGS -> catalogue (rejected or too big: skipped)
fn pkg_try(name: u64) {
    var t_dir: [u8; 7] = "/apps/\0"
    var t_set: [u8; 15] = ".prog/SETTINGS\0"
    var path: [u8; 96] = [0 as u8; 96]
    let pp: u64 = (&path[0 as usize]) as u64
    if ulib.length(name) > 40 {
        return
    }
    ulib.strcpy(pp, (&t_dir[0 as usize]) as u64)
    ulib.strcat(pp, name)
    ulib.strcat(pp, (&t_set[0 as usize]) as u64)
    let n: u64 = file_read(pp, (&pkg_buf[0 as usize]) as u64, 3080)
    if n == 0 || n > 3072 {
        return
    }
    let pre: u64 = manifest.page_count()
    let _r: u64 = manifest.add_pkg((&pkg_buf[0 as usize]) as u64, n, name)
    let post: u64 = manifest.page_count()
    if post > pre && pre >= pkg_base {
        let _q: u64 = setroute.queue_package((&pkg_buf[0 as usize]) as u64, n, name, R_ANZ + pre - pkg_base, post - pre)
    }
}

// once, before the first window is built (after the built-in manifest, so it is app 0)
fn pkg_init() {
    if pkg_state != 0 {
        return
    }
    pkg_state = 1
    if !man_ready() {
        return
    }
    ap_load()
    pkg_base = manifest.page_count()
    var k: u64 = 0
    while k < ap_n {
        pkg_try(ap_name_ptr(k))
        k = k + 1
    }
    let np: u64 = manifest.page_count()
    var p: u64 = 0
    while p < np && pkg_n < PKG_MAX {
        if manifest.page_app(p) != 0 {
            pkg_pg[(pkg_n) as usize] = p
            pkg_n = pkg_n + 1
        }
        p = p + 1
    }
}

// the action may be called: it starts with "<app>."
fn pkg_prefix_ok(app: u64, act: u64) -> bool {
    if app == 0 || act == 0 {
        return false
    }
    var i: u64 = 0
    while rb(app, i) != 0 {
        if rb(act, i) != rb(app, i) {
            return false
        }
        i = i + 1
    }
    return rb(act, i) == 46
}

fn pkg_say(key: u64) {
    stat_set((&pkg_stat[0 as usize]) as u64, key, 0)
}

// "call <action>" into the request
fn pkg_req(act: u64) {
    let cp: u64 = (&pkg_call[0 as usize]) as u64
    var t_call: [u8; 6] = "call \0"
    let o: u64 = bx_put(cp, 0, 64, (&t_call[0 as usize]) as u64)
    let _o2: u64 = bx_put(cp, o, 64, act)
    actcli.req(cp)
}

fn pkg_true(c: u64) -> bool {
    return c == 116 || c == 84 || c == 49 || c == 121 || c == 89
}

// the values of the page the window just opened: defaults first, then every `read` action
fn pkg_enter(n: u64) {
    if n >= pkg_n {
        return
    }
    pkg_pend = 0
    __mmio_write8(((&pkg_stat[0 as usize]) as u64) as *mut u8, 0 as u8)
    pkg_read_page(n)
}

fn pkg_read_page(n: u64) {
    let pg: u64 = pkg_pg[(n) as usize]
    let app: u64 = manifest.app_at(manifest.page_app(pg))
    let first: u64 = manifest.page_first(pg)
    let len: u64 = manifest.page_len(pg)
    var i: u64 = first
    while i < first + len && i - first < 80 {
        let slot: u64 = i - first
        pkg_val[(slot) as usize] = 0
        __mmio_write8(((&pkg_txt[0 as usize]) as u64 + slot * 64) as *mut u8, 0 as u8)
        if manifest.item_kind(i) == manifest.K_FIELD {
            let df: u64 = manifest.item_def(i)
            if df != 0 {
                if manifest.item_type(i) == manifest.T_BOOL {
                    if pkg_true(rb(df, 0)) {
                        pkg_val[(slot) as usize] = 1
                    }
                } else {
                    let o: u64 = ulib.strncpy(((&pkg_txt[0 as usize]) as u64) + slot * 64, df, 62)
                    __mmio_write8(((&pkg_txt[0 as usize]) as u64 + slot * 64 + o) as *mut u8, 0 as u8)
                }
            }
            let rd: u64 = manifest.item_read(i)
            if rd != 0 && pkg_prefix_ok(app, rd) {
                pkg_req(rd)
                let rc: u64 = actcli.send(300)
                if rc == actcli.R_OK {
                    var v: [u8; 64] = [0 as u8; 64]
                    let vp: u64 = (&v[0 as usize]) as u64
                    if actcli.field(manifest.item_key(i), vp, 64) {
                        if manifest.item_type(i) == manifest.T_BOOL {
                            pkg_val[(slot) as usize] = 0
                            if pkg_true(rb(vp, 0)) {
                                pkg_val[(slot) as usize] = 1
                            }
                        } else {
                            let o2: u64 = ulib.strncpy(((&pkg_txt[0 as usize]) as u64) + slot * 64, vp, 62)
                            __mmio_write8(((&pkg_txt[0 as usize]) as u64 + slot * 64 + o2) as *mut u8, 0 as u8)
                        }
                    }
                } else if rc == actcli.R_NOBUS {
                    pkg_say((&k_pkg_nobus[0 as usize]) as u64)
                }
            }
        }
        i = i + 1
    }
}

// a click on the control of catalogue item `i` of the shown package page
fn pkg_click(i: u64) {
    if reiter < R_ANZ || reiter - R_ANZ >= pkg_n {
        return
    }
    let n: u64 = reiter - R_ANZ
    let pg: u64 = pkg_pg[(n) as usize]
    let first: u64 = manifest.page_first(pg)
    if i < first || i >= first + manifest.page_len(pg) || i - first >= 80 {
        return
    }
    let slot: u64 = i - first
    let ty: u64 = manifest.item_type(i)
    let wr: u64 = manifest.item_write(i)
    let app: u64 = manifest.app_at(manifest.page_app(pg))
    if wr == 0 || ty == manifest.T_STATUS {
        fuiscene.refresh()
        return
    }
    if !pkg_prefix_ok(app, wr) {
        pkg_say((&k_pkg_deny[0 as usize]) as u64)
        fuiscene.refresh()
        return
    }
    var rc: u64 = actcli.R_ERR
    if pkg_pend != 0 && pkg_pend_item == i {
        // the second click: the person at the device confirms the question
        var cf: [u8; 32] = [0 as u8; 32]
        var s_c: [u8; 9] = "confirm \0"
        let o: u64 = bx_put((&cf[0 as usize]) as u64, 0, 32, (&s_c[0 as usize]) as u64)
        let _o2: u64 = bx_num((&cf[0 as usize]) as u64, o, 32, pkg_pend)
        actcli.req((&cf[0 as usize]) as u64)
        pkg_pend = 0
        rc = actcli.send(300)
    } else {
        pkg_req(wr)
        if ty == manifest.T_BOOL {
            var t_t: [u8; 5] = "true\0"
            var t_f: [u8; 6] = "false\0"
            if fuiscene.value_of(K_PKGF0 + i) != 0 {
                actcli.arg(manifest.item_key(i), (&t_t[0 as usize]) as u64)
            } else {
                actcli.arg(manifest.item_key(i), (&t_f[0 as usize]) as u64)
            }
        } else if ty == manifest.T_TEXT || ty == manifest.T_SECRET {
            let tx: u64 = fuiscene.entry_text(K_PKGF0 + i)
            if tx != 0 {
                actcli.arg(manifest.item_key(i), tx)
            }
        }
        pkg_pend = 0
        rc = actcli.send(300)
    }
    if rc == actcli.R_OK {
        pkg_say((&k_pkg_ok[0 as usize]) as u64)
    } else if rc == actcli.R_CONFIRM {
        var ln: [u8; 160] = [0 as u8; 160]
        let lp: u64 = (&ln[0 as usize]) as u64
        let _l: bool = actcli.line(0, lp, 160)
        var j: u64 = 8
        var no: u64 = 0
        while rb(lp, j) >= 48 && rb(lp, j) <= 57 {
            no = no * 10 + rb(lp, j) - 48
            j = j + 1
        }
        pkg_pend = no
        pkg_pend_item = i
        pkg_say((&k_pkg_ask[0 as usize]) as u64)
    } else if rc == actcli.R_NOBUS {
        pkg_say((&k_pkg_nobus[0 as usize]) as u64)
    } else {
        pkg_say((&k_pkg_err[0 as usize]) as u64)
    }
    // what the switches show is what the app says now, not what was clicked
    pkg_read_page(n)
    let _slot: u64 = slot
    fuiscene.refresh()
    rep_due = 1
}

// the generic page: see the block comment above
fn page_pkg(left: usize, right: usize, n: u64) {
    if n >= pkg_n {
        return
    }
    let pg: u64 = pkg_pg[(n) as usize]
    let first: u64 = manifest.page_first(pg)
    let end: u64 = first + manifest.page_len(pg)
    var i: u64 = first
    var bools: u64 = 0
    while i < end && i - first < 80 {
        var parent: usize = left
        if manifest.item_col(i) == 1 {
            parent = right
        }
        let kind: u64 = manifest.item_kind(i)
        let lab: u64 = manifest.item_label(i)
        let slot: u64 = i - first
        let id: u64 = K_PKGF0 + i
        if kind == manifest.K_LABEL {
            let _nl: usize = fuiscene.label(parent, msg.get(lab))
        } else if kind == manifest.K_NOTE {
            let _nw: usize = fuiscene.label_wrap(parent, msg.get(lab), manifest.item_num(i))
        } else if kind == manifest.K_FIELD {
            let ty: u64 = manifest.item_type(i)
            var ltxt: u64 = (&pkg_empty[0 as usize]) as u64
            if lab != 0 {
                ltxt = msg.get(lab)
            }
            if ty == manifest.T_BOOL {
                if bools < 16 {
                    var on: bool = false
                    if pkg_val[(slot) as usize] != 0 {
                        on = true
                    }
                    let _nb: usize = fuiscene.toggle(parent, ltxt, id, on)
                    bools = bools + 1
                }
            } else if ty == manifest.T_ACTION {
                let n_b: usize = fuiscene.button(parent, ltxt, id)
                fuiscene.button_fit(n_b, ltxt, fitw(160))
            } else if ty == manifest.T_STATUS {
                let dp: u64 = ((&pkg_dsp[0 as usize]) as u64) + slot * 100
                var o: u64 = bx_put(dp, 0, 100, ltxt)
                if rb(((&pkg_txt[0 as usize]) as u64) + slot * 64, 0) != 0 {
                    var t_cs: [u8; 3] = ": \0"
                    o = bx_put(dp, o, 100, (&t_cs[0 as usize]) as u64)
                    let _o3: u64 = bx_put(dp, o, 100, ((&pkg_txt[0 as usize]) as u64) + slot * 64)
                }
                let _ns: usize = fuiscene.label(parent, dp)
            } else if ty == manifest.T_TEXT || ty == manifest.T_SECRET {
                if lab != 0 {
                    let _ne: usize = fuiscene.label(parent, ltxt)
                }
                let n_e: usize = fuiscene.entry(parent, id, 0, ((&pkg_txt[0 as usize]) as u64) + slot * 64)
                fuiscene.set_size(n_e, 0, 28)
                if ty == manifest.T_SECRET {
                    fuiscene.entry_secret(id, true)
                }
            }
        }
        i = i + 1
    }
    if rb((&pkg_stat[0 as usize]) as u64, 0) != 0 {
        let _nt: usize = fuiscene.label_muted(left, (&pkg_stat[0 as usize]) as u64)
    }
}

// A sum over the live texts of the network page: did anything change?
fn netz_sum() -> u64 {
    var sum: u64 = 7
    var i: u64 = 0
    while i < 64 {
        sum = (sum ^ (l_nzust[(i) as usize] as u64)) *% 1099511628211
        sum = (sum ^ (l_nrate[(i) as usize] as u64)) *% 1099511628211
        sum = (sum ^ (l_nrunter[(i) as usize] as u64)) *% 1099511628211
        sum = (sum ^ (l_nrauf[(i) as usize] as u64)) *% 1099511628211
        sum = (sum ^ (l_nsumme[(i) as usize] as u64)) *% 1099511628211
        sum = (sum ^ (l_nping[(i) as usize] as u64)) *% 1099511628211
        i = i + 1
    }
    i = 0
    while i < 400 {
        sum = (sum ^ (b_nprog[(i) as usize] as u64)) *% 1099511628211
        sum = (sum ^ (b_nconn[(i) as usize] as u64)) *% 1099511628211
        i = i + 1
    }
    return sum
}

// The tab names (15, '\n' between in the catalogue) into 40-octet slots.
// ================================================================
// REDESIGN (11.10.2026): Windows-11-style settings shell.
//
// Left: a search field and the pages grouped in eight categories
// (a tile per page, the SAME keys K_TAB0 + page as the old tab strip, so the
// event loop, the bus and the tests keep working). Right: a glass header
// with the page title and the page in its cards. The search filters the
// pages live (name, category and keywords from the catalogue).
// ================================================================
const K_SRCH: u64 = 98
const K_SEG0: u64 = 180 // 180 .. 182: light, dark, auto
const K_SW0: u64 = 183 // 183 .. 190: the eight accent swatches
const K_WP0: u64 = 191 // the wallpaper thumbnail
const K_HDR: u64 = 199 // the header canvas
const K_NAVBACK: u64 = 940
const K_NAVFWD: u64 = 941
const K_NAVUP: u64 = 942
const K_CRUMB0: u64 = 944
const K_REL0: u64 = 950
static mut nav_crumbs: u64 = 0
static mut ctl_n: u64 = 0
static mut ctl_pg: u64 = 0
const K_BACK: u64 = 197 // narrow mode: back from a page to the list
const SIDE_W: u64 = 232
const NCAT: u64 = 8
const SF_HOT: u64 = 2
const SF_FOCUS: u64 = 8

static mut k_settings_cats: [u8; 14] = "settings.cats\0"
static mut k_settings_search: [u8; 16] = "settings.search\0"
static mut k_settings_search_short: [u8; 22] = "settings.search.short\0"
static mut k_settings_back: [u8; 14] = "settings.back\0"
static mut k_settings_nohit: [u8; 15] = "settings.nohit\0"
static mut k_settings_nohit2: [u8; 16] = "settings.nohit2\0"
static mut k_settings_seg: [u8; 13] = "settings.seg\0"
static mut k_settings_sw: [u8; 12] = "settings.sw\0"
static mut k_settings_p_mode: [u8; 16] = "settings.p.mode\0"
static mut k_settings_p_mode2: [u8; 17] = "settings.p.mode2\0"
static mut k_settings_p_acc: [u8; 15] = "settings.p.acc\0"
static mut k_settings_p_acc2: [u8; 16] = "settings.p.acc2\0"
static mut k_settings_p_wp: [u8; 14] = "settings.p.wp\0"
static mut k_settings_p_wp2: [u8; 15] = "settings.p.wp2\0"
static mut k_settings_p_wp3: [u8; 15] = "settings.p.wp3\0"
static mut k_settings_p_more: [u8; 16] = "settings.p.more\0"
static mut k_settings_kw0: [u8; 13] = "settings.kw0\0"
static mut k_settings_kw1: [u8; 13] = "settings.kw1\0"
static mut k_settings_kw2: [u8; 13] = "settings.kw2\0"
static mut k_settings_kw3: [u8; 13] = "settings.kw3\0"
static mut k_settings_kw4: [u8; 13] = "settings.kw4\0"
static mut k_settings_kw5: [u8; 13] = "settings.kw5\0"
static mut k_settings_kw6: [u8; 13] = "settings.kw6\0"
static mut k_settings_kw7: [u8; 13] = "settings.kw7\0"
static mut k_settings_kw8: [u8; 13] = "settings.kw8\0"
static mut k_settings_kw9: [u8; 13] = "settings.kw9\0"
static mut k_settings_kw10: [u8; 14] = "settings.kw10\0"
static mut k_settings_kw11: [u8; 14] = "settings.kw11\0"
static mut k_settings_kw12: [u8; 14] = "settings.kw12\0"
static mut k_settings_kw13: [u8; 14] = "settings.kw13\0"
static mut k_settings_kw14: [u8; 14] = "settings.kw14\0"

static mut kwkey: [u8; 16] = "settings.kw\0\0\0\0\0"
static mut e_srch: [u8; 48] = [0 as u8; 48]
static mut srch_prev: [u8; 48] = [0 as u8; 48]
static mut srch_word: [u8; 48] = [0 as u8; 48]
static mut nav_vis: [u64; 40] = [0 as u64; 40] // R_ANZ built-in pages + up to PKG_MAX package pages (r149)
static mut nav_n: u64 = 0
static mut cat_buf: [u8; 320] = [0 as u8; 320]
static mut seg_buf: [u8; 120] = [0 as u8; 120]
static mut swn_buf: [u8; 320] = [0 as u8; 320]
static mut sw_hex: [u8; 64] = [0 as u8; 64]
static mut sw_sel: u64 = 99
static mut ks_prev: u64 = 0

// the eight accent colours (0xRRGGBB); the theme code shifts a colour that
// lacks contrast and says so (contrast_show)
fn sw_rgb(i: u64) -> u64 {
    if i == 0 {
        return 3108830
    } else if i == 1 {
        return 957095
    } else if i == 2 {
        return 3055195
    } else if i == 3 {
        return 14263296
    } else if i == 4 {
        return 15227148
    } else if i == 5 {
        return 14041157
    } else if i == 6 {
        return 14040223
    }
    return 8146395
}

fn lower_c(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

fn contains_ci(hay: u64, needle: u64) -> bool {
    let nl: u64 = ulib.length(needle)
    let hl: u64 = ulib.length(hay)
    if nl == 0 {
        return true
    }
    if nl > hl {
        return false
    }
    var i: u64 = 0
    while i + nl <= hl {
        var j: u64 = 0
        while j < nl && lower_c(rb(hay, i + j)) == lower_c(rb(needle, j)) {
            j = j + 1
        }
        if j == nl {
            return true
        }
        i = i + 1
    }
    return false
}

// the n-th line of `src` into slot n of `dst` (slots of `slot` octets)
fn split_lines(src: u64, dst: u64, slot: u64, n: u64) {
    var t: u64 = 0
    while t < n {
        __mmio_write8((dst + t * slot) as *mut u8, 0 as u8)
        t = t + 1
    }
    t = 0
    var o: u64 = 0
    var q: u64 = 0
    while t < n {
        let c: u64 = rb(src, q)
        if c == 0 || c == 10 {
            __mmio_write8((dst + t * slot + o) as *mut u8, 0 as u8)
            t = t + 1
            o = 0
            if c == 0 {
                return
            }
        } else if o + 1 < slot {
            __mmio_write8((dst + t * slot + o) as *mut u8, c as u8)
            o = o + 1
        }
        q = q + 1
    }
}

fn hex_put(dst: u64, v: u64) {
    var i: u64 = 0
    while i < 6 {
        let d: u64 = (v >> ((5 - i) * 4)) & 15
        var ch: u64 = 48 + d
        if d > 9 {
            ch = 87 + d
        }
        __mmio_write8((dst + i) as *mut u8, ch as u8)
        i = i + 1
    }
    __mmio_write8((dst + 6) as *mut u8, 0 as u8)
}

fn shell_texts() {
    split_lines(msg.get((&k_settings_cats[0 as usize]) as u64), (&cat_buf[0 as usize]) as u64, 40, NCAT)
    split_lines(msg.get((&k_settings_seg[0 as usize]) as u64), (&seg_buf[0 as usize]) as u64, 40, 3)
    split_lines(msg.get((&k_settings_sw[0 as usize]) as u64), (&swn_buf[0 as usize]) as u64, 40, 8)
    var i: u64 = 0
    while i < 8 {
        hex_put(((&sw_hex[0 as usize]) as u64) + i * 8, sw_rgb(i))
        i = i + 1
    }
}

// which category a page lives in (0 System, 1 Anzeige, 2 Netzwerk, 3 Konten,
// 4 Personalisierung, 5 Zeit & Sprache, 6 Update, 7 Info)
fn cat_of(p: u64) -> u64 {
    if p >= R_ANZ {
        return pkg_cat(p - R_ANZ)
    }
    if p == R_SYSTEM || p == R_BRUECKE || p == R_MAUS || p == R_ENERGIE || p == R_APPS {
        return 0
    } else if p == R_SCREEN || p == R_SCREEN2 {
        return 1
    } else if p == R_NETZ || p == R_NETV || p == R_WIFI || p == R_USBNET {
        return 2
    } else if p == R_BENUT || p == R_KONTO || p == R_SYNC || p == R_PASSW || p == R_PIN {
        return 3
    } else if p == R_DARST || p == R_VORL || p == R_TASKBAR || p == R_EFFECTS || p == R_SCHEME || p == R_ACCENT || p == R_VTRANS {
        return 4
    } else if p == R_TIME || p == R_SPRACHE {
        return 5
    } else if p == R_UPDATE {
        return 6
    }
    return 7
}

fn cat_name(c: u64) -> u64 {
    if c >= NCAT {
        return msg.get((&k_settings_catpkg[0 as usize]) as u64)
    }
    return ((&cat_buf[0 as usize]) as u64) + c * 40
}

fn page_name(p: u64) -> u64 {
    return ((&tab_buf[0 as usize]) as u64) + p * 40
}

// does page p match every word of the search text? (name, category, keywords)
fn page_matches(p: u64) -> bool {
    let q: u64 = (&e_srch[0 as usize]) as u64
    if rb(q, 0) == 0 {
        return true
    }
    if p < R_ANZ && setroute.ready() {
        return setroute.page_shown(p)
    }
    // the key "settings.kwNN"
    let kb: u64 = (&kwkey[0 as usize]) as u64
    if p >= 20 {
        __mmio_write8((kb + 11) as *mut u8, 50 as u8)
        __mmio_write8((kb + 12) as *mut u8, (48 + (p - 20)) as u8)
        __mmio_write8((kb + 13) as *mut u8, 0 as u8)
    } else if p >= 10 {
        __mmio_write8((kb + 11) as *mut u8, 49 as u8)
        __mmio_write8((kb + 12) as *mut u8, (48 + (p - 10)) as u8)
        __mmio_write8((kb + 13) as *mut u8, 0 as u8)
    } else {
        __mmio_write8((kb + 11) as *mut u8, (48 + p) as u8)
        __mmio_write8((kb + 12) as *mut u8, 0 as u8)
    }
    var kw: u64 = (&pkg_empty[0 as usize]) as u64
    if p < R_ANZ {
        kw = msg.get(kb)
    }
    let wb: u64 = (&srch_word[0 as usize]) as u64
    var i: u64 = 0
    while rb(q, i) != 0 {
        while rb(q, i) == 32 {
            i = i + 1
        }
        var n: u64 = 0
        while rb(q, i) != 0 && rb(q, i) != 32 && n + 1 < 48 {
            __mmio_write8((wb + n) as *mut u8, rb(q, i) as u8)
            n = n + 1
            i = i + 1
        }
        __mmio_write8((wb + n) as *mut u8, 0 as u8)
        if n > 0 {
            if !contains_ci(page_name(p), wb) && !contains_ci(cat_name(cat_of(p)), wb)
                && !contains_ci(kw, wb) {
                return false
            }
        }
    }
    return true
}

fn nav_compute() {
    nav_n = 0
    let _qp: u64 = setroute.query_pages((&e_srch[0 as usize]) as u64)
    var i: u64 = 0
    while i < pages_all() {
        if page_matches(i) {
            nav_vis[(i) as usize] = 1
            nav_n = nav_n + 1
        } else {
            nav_vis[(i) as usize] = 0
        }
        i = i + 1
    }
}

// the visible page after / before `cur` in sidebar order (categories, then
// page numbers); `cur` itself when there is none
fn nav_step(cur: u64, down: bool) -> u64 {
    var order: [u64; 32] = [0 as u64; 32]
    var n: u64 = 0
    var fo: u64 = 0
    while setroute.ready() && fo < setroute.flat_count() {
        let fp: u64 = setroute.flat_page(fo)
        if fp != setroute.NONE && nav_vis[(fp) as usize] != 0 && n < 32 {
            order[(n) as usize] = fp
            n = n + 1
        }
        fo = fo + 1
    }
    var c: u64 = 0
    while c < NCAT + 1 {
        var p: u64 = 0
        while p < pages_all() {
            if cat_of(p) == c && nav_vis[(p) as usize] != 0 && (p >= R_ANZ || !setroute.ready()) && n < 32 {
                order[(n) as usize] = p
                n = n + 1
            }
            p = p + 1
        }
        c = c + 1
    }
    var at: u64 = n
    var k: u64 = 0
    while k < n {
        if order[(k) as usize] == cur {
            at = k
        }
        k = k + 1
    }
    if n == 0 {
        return cur
    }
    if at == n {
        if down {
            return order[0 as usize]
        }
        return order[(n - 1) as usize]
    }
    if down && at + 1 < n {
        return order[(at + 1) as usize]
    }
    if !down && at > 0 {
        return order[(at - 1) as usize]
    }
    return cur
}

// ---- painting. The glass look is made HERE and nowhere else: swap this
// helper for the toolkit's glass/token API when it lands on main.
fn glass_plate(x: u64, y: u64, w: u64, h: u64, r: u64) {
    fuiscene.cv_round(x, y, w, h, r, fuiscene.R_SURFACE)
    fuiscene.cv_round_a(x, y, w, h, r, 16777215, 46)
    fuiscene.cv_ring(x, y, w, h, r, fuiscene.R_BORDER)
    // a soft top light line
    if w > 2 * r {
        fuiscene.cv_round_a(x + r, y + 1, w - 2 * r, 1, 0, 16777215, 90)
    }
}

// one painter for every tile of this window (the toolkit keeps ONE callback
// slot for tiles): ud = kind * 256 + argument
fn tile_cb(ud: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    let kind: u64 = ud / 256
    let arg: u64 = ud % 256
    let s: u64 = fuiscene.sp(1)
    if kind == 1 {
        // a page in the sidebar
        let pgn: u64 = arg % 64
        let subx: u64 = (arg / 64) * 14
        let sel: bool = pgn == reiter
        var tname: u64 = setroute.page_title(pgn)
        if tname == 0 {
            tname = page_name(pgn)
        }
        if sel {
            fuiscene.cv_round(x, y, w, h, 6 * s, fuiscene.R_FIELD)
            fuiscene.cv_ring(x, y, w, h, 6 * s, fuiscene.R_BORDER)
            fuiscene.cv_round(x + 3 * s, y + h / 2 - 8 * s, 3 * s, 16 * s, 2 * s, fuiscene.R_ACCENT)
        }
        if (st & SF_FOCUS) != 0 {
            fuiscene.cv_ring(x, y, w, h, 6 * s, fuiscene.R_ACCENT)
        }
        fuiscene.text_role(x + (18 + subx) * s, y + h / 2 + 5 * s, w - (24 + subx) * s, tname, 14 * s, sel, fuiscene.R_TEXT)
    } else if kind == 3 {
        // an accent swatch
        let d: u64 = w
        if sw_sel == arg {
            fuiscene.cv_ring_rgb(x, y, d, d, d / 2, 2 * s, 8355711)
            fuiscene.cv_ring(x, y, d, d, d / 2, fuiscene.R_TEXT)
        }
        fuiscene.cv_round_rgb(x + 4 * s, y + 4 * s, d - 8 * s, d - 8 * s, (d - 8 * s) / 2, sw_rgb(arg))
        if (st & SF_FOCUS) != 0 {
            fuiscene.cv_ring(x - 1, y - 1, d + 2, d + 2, d / 2 + 1, fuiscene.R_ACCENT)
        }
        if (st & SF_HOT) != 0 && sw_sel != arg {
            fuiscene.cv_ring(x + 2 * s, y + 2 * s, d - 4 * s, d - 4 * s, d / 2, fuiscene.R_BORDER)
        }
    } else if kind == 4 {
        // the wallpaper thumbnail: the system's current picture (a sea)
        fuiscene.cv_round_rgb(x, y, w, h, 8 * s, 797789)
        fuiscene.cv_round_a(x, y, w, h / 2, 8 * s, 6732799, 90)
        fuiscene.cv_round_a(x, y + h - 34 * s, w, 32 * s, 8 * s, 331845, 215)
        fuiscene.cv_ring(x, y, w, h, 8 * s, fuiscene.R_ACCENT)
        fuiscene.cv_ring(x + 1, y + 1, w - 2, h - 2, 8 * s, fuiscene.R_ACCENT)
        fuiscene.text_role(x + 8 * s, y + h - 8 * s, w - 12 * s, msg.get((&k_settings_p_wp3[0 as usize]) as u64), 12 * s, true, fuiscene.R_ONFILL)
    }
}

// a - b, never below 0
fn sat_sub_u(a: u64, b: u64) -> u64 {
    if a < b {
        return 0
    }
    return a - b
}

// width minus a margin, never below 0 (a header can be narrower than its margins while a pane resizes)
fn room_of(w: u64, m: u64) -> u64 {
    if w < m {
        return 0
    }
    return w - m
}

// the glass header: breadcrumb (category) and the page title
fn hdr_cb(x: u64, y: u64, w: u64, h: u64) {
    let s: u64 = fuiscene.sp(1)
    let rm: u64 = room_of(w, 40 * s)
    glass_plate(x, y, w, h, 10 * s)
    fuiscene.cv_round(x + 10 * s, y + h / 2 - 12 * s, 4 * s, 24 * s, 2 * s, fuiscene.R_ACCENT)
    if nav_n == 0 {
        fuiscene.text_role(x + 24 * s, y + h / 2 + 7 * s, rm, msg.get((&k_settings_nohit[0 as usize]) as u64), 20 * s, true, fuiscene.R_TEXT)
        return
    }
    fuiscene.text_role(x + 24 * s, y + 20 * s, rm, page_name(reiter), 18 * s, true, fuiscene.R_TEXT)
    fuiscene.text_role(x + 24 * s, y + 38 * s, rm, cat_name(cat_of(reiter)), 12 * s, false, fuiscene.R_MUTED)
}

fn goto_page(idx: u64) {
    if nav_mode() {
        nav_detail = true
    }
    bus_page(idx)
    zeige_reiter(idx)
    melde_stand()
}

// the section header of a card: a title and, under it, one line of help
fn card_head(card: usize, title: u64, help: u64) {
    let _t: usize = fuiscene.label(card, title)
    // a short window (the 800x600 gate screen: 576 usable points) drops the help line so that the
    // last control of a page (Apply) is not placed past the bottom edge of the window
    if !short_win() {
        let _h: usize = fuiscene.label_muted(card, help)
    }
}

// the window is too short for the help lines and the tall colour scheme list
fn short_win() -> bool {
    return fuiscene.height() < 640
}

// R1085: narrow windows (logical width < 900, e.g. a 1280x800 screen at scale 2). `cw_in` is then the inner width
// (points) of the narrower page column; 0 = a normal window, every width stays as designed.
static mut cw_in: u64 = 0

// one control of design width `w` in a column
fn fitw(w: u64) -> u64 {
    if cw_in == 0 || w <= cw_in {
        return w
    }
    return cw_in
}

// one of `n` controls in a row (gap `gap` between them) of design width `w`
fn fitn(w: u64, n: u64, gap: u64) -> u64 {
    if cw_in == 0 {
        return w
    }
    var m: u64 = 0
    if cw_in > gap * (n - 1) {
        m = (cw_in - gap * (n - 1)) / n
    }
    if m < 16 {
        m = 16
    }
    if w < m {
        return w
    }
    return m
}

// the label part of a slider row (design 150) and the slider (design 160)
fn slab_w() -> u64 {
    if cw_in == 0 {
        return 150
    }
    return cw_in * 2 / 5
}

fn slid_w() -> u64 {
    if cw_in == 0 {
        return 160
    }
    return cw_in - cw_in * 2 / 5 - 6
}

// the first control of a two-control row whose second keeps `rest` points
fn first_of(w: u64, rest: u64, gap: u64) -> u64 {
    if cw_in == 0 || w + rest + gap <= cw_in {
        return w
    }
    if cw_in < rest + gap + 60 {
        return 60
    }
    return cw_in - rest - gap
}

fn b2n(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

// the last scroll position of the page / list areas (a change makes the window report its rectangles again)
static mut pane_prev: u64 = 0

// Z1: NAVIGATION MODE. A window narrower than NAV_W logical points shows ONE of two views: the list of pages (the
// sidebar over the whole width) or the page (with a Back button); picking a page opens it, Back / Esc returns.
const NAV_W: u64 = 640
static mut nav_detail: bool = false

fn nav_mode() -> bool {
    return fuiscene.width() < NAV_W
}

// the list is the only view
fn nav_list_only() -> bool {
    return nav_mode() && !nav_detail
}

// the page is the only view
fn nav_page_only() -> bool {
    return nav_mode() && nav_detail
}

// the page area scrolls when the window is narrow or low (everything fits and stays as designed above)
fn page_scrolls() -> bool {
    return nav_mode() || fuiscene.height() < 500
}

// the sidebar width: the designed 232, narrower in a narrow window
fn side_w() -> u64 {
    if nav_list_only() {
        return fuiscene.width() - 16
    }
    if fuiscene.width() >= 900 {
        return SIDE_W
    }
    if fuiscene.width() < 700 {
        return 132
    }
    return 190
}

// the three colour-mode segments
fn personal_mode(left: usize) {
    card_head(left, msg.get((&k_settings_p_mode[0 as usize]) as u64), msg.get((&k_settings_p_mode2[0 as usize]) as u64))
    let _seg: usize = fuiscene.segmented(left, K_SEG0, (&seg_buf[0 as usize]) as u64, 40, 3, kval[(K_CM) as usize], fitn(92, 3, 2))
    if cw_in != 0 {
        fuiscene.set_gap(_seg, 2)
    }
}

// the eight accent swatches
fn personal_accent(left: usize) {
    card_head(left, msg.get((&k_settings_p_acc[0 as usize]) as u64), msg.get((&k_settings_p_acc2[0 as usize]) as u64))
    let rw: usize = fuiscene.row(left)
    fuiscene.set_gap(rw, 4)
    var j: u64 = 0
    while j < 8 {
        let _w: usize = fuiscene.ftile_quiet(rw, K_SW0 + j, ((&swn_buf[0 as usize]) as u64) + j * 40, fitn(30, 8, 4), fitn(30, 8, 4), 768 + j, tile_cb)
        j = j + 1
    }
}

fn personal_wall(right: usize) {
    card_head(right, msg.get((&k_settings_p_wp[0 as usize]) as u64), msg.get((&k_settings_p_wp2[0 as usize]) as u64))
    let rt: usize = fuiscene.row(right)
    // r1172: a short window (800x600 gate screen) shrinks the wallpaper tile 84 -> 40 so that the Darstellung page
    // (the longest one) ends inside the window
    var wp_h: u64 = 84
    if short_win() {
        wp_h = 40
    }
    let _t: usize = fuiscene.ftile_quiet(rt, K_WP0, msg.get((&k_settings_p_wp3[0 as usize]) as u64), fitw(150), wp_h, 1024, tile_cb)
}


fn tab_names() {
    tab_names_base()
    pkg_names()
}

fn tab_names_base() {
    let src: u64 = msg.get((&k_t_tabs[0 as usize]) as u64)
    var t: u64 = 0
    var o: u64 = 0
    var q: u64 = 0
    while t < R_ANZ {
        let c: u8 = __mmio_read8((src + q) as *mut u8)
        if c == 0 as u8 || c == 10 as u8 {
            tab_buf[((t * 40 + o)) as usize] = 0 as u8
            t = t + 1
            o = 0
            if c == 0 as u8 {
                while t < R_ANZ {
                    tab_buf[((t * 40)) as usize] = 0 as u8
                    t = t + 1
                }
                return
            }
        } else if o < 38 {
            tab_buf[((t * 40 + o)) as usize] = c
            o = o + 1
        }
        q = q + 1
    }
}

fn two_cols(r: u64) -> bool {
    return r == R_DARST || r == R_VORL || r == R_TASKBAR || r == R_EFFECTS || r == R_SCHEME || r == R_SCREEN || r == R_SCREEN2 || r == R_NETZ
        || r == R_KONTO || (r == R_APPS && ap_sel != AP_NONE) || (r >= R_ANZ && pkg_two(r - R_ANZ))
}

// The whole window: sidebar (search + pages by category) and the page in
// glass-header + cards, the status line below.
// the entry height at which the sidebar (search field, category heads, `nav_n` entries) still fits the window
fn side_fit(item_h: u64, compact: bool) -> u64 {
    var heads: u64 = 0
    var c: u64 = 0
    while c < NCAT + 1 {
        var p: u64 = 0
        var any: bool = false
        while p < pages_all() {
            if cat_of(p) == c && nav_vis[(p) as usize] != 0 && (p >= R_ANZ || !setroute.ready()) {
                any = true
            }
            p = p + 1
        }
        if any {
            heads = heads + 1
        }
        c = c + 1
    }
    var fg: u64 = 0
    while setroute.ready() && fg < setroute.flat_count() {
        if setroute.flat_page(fg) == setroute.NONE && setroute.group_shown(fg) {
            heads = heads + 1
        }
        fg = fg + 1
    }
    if nav_n == 0 {
        return item_h
    }
    var gap: u64 = 2
    if compact {
        gap = 0
    }
    // search field 30 + space 6 + status line and margins ~70 + about 20 per category head
    let used: u64 = 106 + heads * 20
    let h: u64 = fuiscene.height()
    if h <= used + nav_n * 18 {
        return 18
    }
    let fit: u64 = (h - used) / nav_n - gap
    if fit < item_h {
        if fit < 18 {
            return 18
        }
        return fit
    }
    return item_h
}

// visible height of a scrolling area: the window minus `used` points of other rows (0 = unknown, share the rest)
fn pane_h(used: u64) -> u64 {
    let h: u64 = fuiscene.height()
    if h < used + 60 {
        return 0
    }
    return h - used
}

fn side_routes(lst: usize, item_h: u64) {
    if !setroute.ready() {
        return
    }
    var fi: u64 = 0
    while fi < setroute.flat_count() {
        let pg: u64 = setroute.flat_page(fi)
        if pg == setroute.NONE {
            if setroute.group_shown(fi) {
                let _g: usize = fuiscene.label_muted(lst, setroute.flat_title(fi))
            }
        } else if nav_vis[(pg) as usize] != 0 {
            let sub: u64 = setroute.flat_depth(fi)
            let _t: usize = fuiscene.ftile_left(lst, tab_key(pg), setroute.flat_title(fi), 0, item_h, 256 + pg + 64 * sub, tile_cb)
        }
        fi = fi + 1
    }
}

fn nav_header(main: usize) {
    let hr: usize = fuiscene.row(main)
    fuiscene.set_gap(hr, 12)
    fuiscene.set_size(hr, 0, 52)
    let _tb: usize = navview.toolbar(hr)
    nav_crumbs = navview.crumbs_row(hr, setroute.current_uri(), setroute.current_uri_len())
}

fn nav_act(act: u64, key: u64) {
    var pg: u64 = setroute.NONE
    if act == navview.ACT_BACK {
        pg = setroute.go_back()
    } else if act == navview.ACT_FORWARD {
        pg = setroute.go_forward()
    } else if act == navview.ACT_UP {
        pg = setroute.go_up()
    } else if act == navview.ACT_CRUMB {
        pg = setroute.open_uri(setroute.current_uri(), navview.crumb_target_len(key))
    } else if act == navview.ACT_RELATED {
        pg = setroute.open_uri(navview.related_uri(key), navview.related_uri_len(key))
    }
    if pg != setroute.NONE && pg != reiter {
        bus_page(pg)
        zeige_reiter(pg)
    } else {
        fuiscene.refresh()
    }
    rep_due = 1
}

fn nav_state_say() {
    if !setroute.ready() {
        return
    }
    say(setroute.state_line(nav_crumbs))
    nl()
    var s_c: [u8; 25] = "settings: controls page=\0"
    var s_n: [u8; 4] = " n=\0"
    say((&s_c[0 as usize]) as u64)
    sayn(ctl_pg)
    say((&s_n[0 as usize]) as u64)
    sayn(ctl_n)
    nl()
}

fn build() {
    let col: usize = fuiscene.root()
    tab_names()
    shell_texts()
    nav_compute()
    let shell: usize = fuiscene.row_stretch(col)
    fuiscene.set_grow(shell, 1)
    fuiscene.set_gap(shell, 8)
    if page_scrolls() || nav_mode() {
        // the scrolling areas need a definite height to fill: the window minus the margins (16), the gap (8) and the
        // status line (24) -- a column does not stretch its children to the window by itself
        var sh_h: u64 = 0
        if fuiscene.height() > 48 + 100 {
            sh_h = fuiscene.height() - 48
        }
        fuiscene.set_size(shell, 0, sh_h)
    }
    if !nav_page_only() {
    let side: usize = fuiscene.column(shell)
    fuiscene.set_size(side, side_w(), 0)
    fuiscene.plate_node(side)
    // a short window (1280x800 and below): the sidebar must fit it, entries get smaller instead of
    // running out of the window (there is no scrolling)
    let compact: bool = fuiscene.height() < 810
    var item_h: u64 = 32
    if compact {
        item_h = 25
        if short_win() {
            // 15 entries of 25 end 3 points past a 576 point window
            item_h = 23
        }
        fuiscene.set_gap(side, 0)
    } else {
        fuiscene.set_gap(side, 2)
    }
    // W-AR6B: 19 pages. The sidebar has no scrolling, so the entries shrink until the whole list ends inside the window
    if nav_list_only() {
        // navigation mode: the list scrolls, so the entries keep a finger-friendly height
        item_h = 32
    } else {
        item_h = side_fit(item_h, compact)
    }
    let n_sr: usize = fuiscene.entry(side, K_SRCH, 0, (&e_srch[0 as usize]) as u64)
    fuiscene.set_size(n_sr, 0, 30)
    if side_w() < 160 {
        // a narrow sidebar: the short hint (the long one would be cut with "...")
        fuiscene.entry_hint(K_SRCH, msg.get((&k_settings_search_short[0 as usize]) as u64))
    } else {
        fuiscene.entry_hint(K_SRCH, msg.get((&k_settings_search[0 as usize]) as u64))
    }
    let _sp0: usize = fuiscene.space(side, 0, 6)
    var lst: usize = side
    if nav_list_only() {
        let pl: usize = fuiscene.pane_open(side, 1, 0, pane_h(106))
        if pl != fuiscene.NONE {
            lst = pl
            fuiscene.set_gap(lst, 2)
        }
    }
    side_routes(lst, item_h)
    var c: u64 = 0
    while c < NCAT + 1 {
        var any: bool = false
        var p0: u64 = 0
        while p0 < pages_all() {
            if cat_of(p0) == c && nav_vis[(p0) as usize] != 0 && (p0 >= R_ANZ || !setroute.ready()) {
                any = true
            }
            p0 = p0 + 1
        }
        if any {
            let _ch: usize = fuiscene.label_muted(lst, cat_name(c))
            var p: u64 = 0
            while p < pages_all() {
                if cat_of(p) == c && nav_vis[(p) as usize] != 0 && (p >= R_ANZ || !setroute.ready()) {
                    let _t: usize = fuiscene.ftile_left(lst, tab_key(p), page_name(p), 0, item_h, 256 + p, tile_cb)
                }
                p = p + 1
            }
        }
        c = c + 1
    }
    }
    if !nav_list_only() {
    let main: usize = fuiscene.column_w(shell, 1)
    fuiscene.set_gap(main, 8)
    if nav_page_only() {
        // navigation mode: a Back button in front of the header
        let hr: usize = fuiscene.row(main)
        fuiscene.set_gap(hr, 8)
        fuiscene.set_size(hr, 0, 52)
        let bk: usize = fuiscene.button(hr, msg.get((&k_settings_back[0 as usize]) as u64), K_BACK)
        fuiscene.set_size(bk, 84, 40)
        let hv: usize = fuiscene.canvas(hr, K_HDR, 0, 52, hdr_cb)
        fuiscene.set_grow(hv, 1)
    } else if setroute.ready() && nav_n > 0 && !nav_mode() {
        nav_header(main)
    } else {
        let _hd: usize = fuiscene.canvas(main, K_HDR, 0, 52, hdr_cb)
    }
    // a narrow or low window: the page scrolls inside a clipped area instead of running out of the window
    var host: usize = main
    if page_scrolls() {
        var pw: u64 = fuiscene.width() - 16
        if !nav_page_only() {
            pw = sat_sub_u(pw, side_w() + 8)
        }
        let pn: usize = fuiscene.pane_open(main, 0, pw, pane_h(112))
        if pn != fuiscene.NONE {
            host = pn
        }
    }
    var body: usize = host
    if nav_mode() {
        // one column: the second card of a two-column page comes under the first
        body = fuiscene.column(host)
    } else {
        body = fuiscene.row_stretch(host)
        if host == main {
            fuiscene.set_grow(body, 1)
        }
    }
    fuiscene.set_gap(body, 8)
    var tw: u64 = fuiscene.width() - 16
    if !nav_page_only() {
        tw = tw - side_w() - 8
    }
    if host != main {
        // the scroll bar's gutter
        tw = tw - 8
    }
    cw_in = 0
    fuiscene.set_toggle_room(0)
    let ctl_first: usize = fuiscene.node_count()
    let cl: usize = fuiscene.card(body)
    var cr: usize = cl
    karte_l = (cl as u64) + 1
    karte_r = 0
    if nav_n == 0 {
        fuiscene.set_size(cl, tw, 0)
        let _n1: usize = fuiscene.label(cl, msg.get((&k_settings_nohit[0 as usize]) as u64))
        let _n2: usize = fuiscene.label_muted(cl, msg.get((&k_settings_nohit2[0 as usize]) as u64))
    } else {
        if two_cols(reiter) {
            var lw: u64 = (tw - 8) * 9 / 20
            var rw: u64 = tw - 8 - lw
            if nav_mode() {
                // navigation mode: the two cards stand one under the other
                lw = tw
                rw = tw
                cw_in = tw - 20
            } else if fuiscene.width() < 900 {
                // narrow window: two columns of the same width
                lw = (tw - 8) / 2
                rw = tw - 8 - lw
                cw_in = lw - 20
            }
            fuiscene.set_size(cl, lw, 0)
            cr = fuiscene.card(body)
            karte_r = (cr as u64) + 1
            fuiscene.set_size(cr, rw, 0)
        } else {
            fuiscene.set_size(cl, tw, 0)
            if fuiscene.width() < 900 {
                cw_in = tw - 20
            }
        }
        if cw_in != 0 {
            fuiscene.set_toggle_room(cw_in)
        }
        if reiter == R_DARST {
            page_darst(cl, cr)
        } else if reiter == R_SCREEN {
            page_screen(cl, cr)
        } else if reiter == R_SCREEN2 {
            page_screen2(cl, cr)
        } else if reiter == R_SCHEME {
            page_scheme(cl, cr)
        } else if reiter == R_ACCENT {
            page_accent(cl, cr)
        } else if reiter == R_TASKBAR {
            page_taskbar(cl, cr)
        } else if reiter == R_EFFECTS {
            page_effects(cl, cr)
        } else if reiter == R_WIFI {
            page_wifi(cl, cr)
        } else if reiter == R_USBNET {
            page_usbnet(cl, cr)
        } else if reiter == R_TIME {
            page_time(cl, cr)
        } else if reiter == R_NETZ {
            page_netz(cl, cr)
        } else if reiter == R_BENUT {
            page_benut(cl, cr)
        } else if reiter == R_PASSW {
            page_passw(cl, cr)
        } else if reiter == R_PIN {
            page_pin(cl, cr)
        } else if reiter == R_VTRANS {
            page_vtrans(cl, cr)
        } else if reiter == R_NETV {
            page_netv(cl, cr)
        } else if reiter == R_SPRACHE {
            page_sprache(cl, cr)
        } else if reiter == R_VORL {
            page_vorl(cl, cr)
        } else if reiter == R_KONTO {
            page_konto(cl, cr)
        } else if reiter == R_SYNC {
            page_sync(cl, cr)
        } else if reiter == R_BRUECKE {
            page_bruecke(cl, cr)
        } else if reiter == R_SYSTEM {
            page_system(cl, cr)
        } else if reiter == R_RECHTE {
            page_rechte(cl, cr)
        } else if reiter == R_MAUS {
            page_maus(cl, cr)
        } else if reiter == R_ENERGIE {
            page_energie(cl, cr)
        } else if reiter == R_APPS {
            page_apps(cl, cr)
        } else if reiter == R_INFO {
            page_info(cl, cr)
        } else if reiter == R_PROTO {
            page_proto(cl, cr)
        } else if reiter >= R_ANZ {
            page_pkg(cl, cr, reiter - R_ANZ)
        } else {
            page_update(cl, cr)
        }
        if setroute.ready() {
            var rel_ok: u64 = 0
            if fuiscene.widgets_since(ctl_first) <= 8 {
                rel_ok = 1
            }
            navview.set_related_short_ok(rel_ok)
            let _rl: u64 = navview.related_rows(cr, setroute.current_uri(), setroute.current_uri_len())
        }
        ctl_n = fuiscene.widgets_since(ctl_first)
        ctl_pg = reiter
    }
    }
    let _st: usize = fuiscene.label(col, (&l_stat[0 as usize]) as u64)
}

// The values the controls start with (what the old code gave them when it
// created them) and the loads the pages need once.
fn init_values() {
    pkg_init()
    wifi_status(0)
    usbnet_refresh()
    var lidx: u64 = 0
    if __mmio_read8((msg.lang()) as *mut u8) == 100 as u8 {
        lidx = 1
    }
    var kidx: u64 = ulib.sys(SYS_KBD, KB_GET, 0, 0)
    if ulib.bad(kidx) {
        kidx = 0
    }
    sync_read()
    bridge_read()
    nv_read()
    provider_read()
    accounts_read()
    book_state()
    kval[(K_CM) as usize] = 2
    kval[(K_CSH) as usize] = wlibc.shape_id()
    kval[(K_TRN) as usize] = wlibc.transparency()
    kval[(K_ZS1) as usize] = zieh_stufe(wlibc.zieh_lift(), 40, 50)
    kval[(K_ZS2) as usize] = zieh_stufe(wlibc.zieh_tilt(), 50, 80)
    kval[(K_ZS3) as usize] = zieh_stufe(wlibc.zieh_swing(), 25, 45)
    kval[(K_BS1) as usize] = zieh_stufe(wlibc.blur_staerke(), 6, 12)
    kval[(K_BS2) as usize] = zieh_stufe(wlibc.blur_tint(), 18, 32)
    kval[(K_CE) as usize] = tb_edge
    kval[(K_CAL) as usize] = tb_align
    kval[(K_CK) as usize] = 0
    kval[(K_CD) as usize] = 0
    kval[(K_CH) as usize] = 2
    kval[(K_CC) as usize] = 2
    kval[(K_CG) as usize] = 2
    kval[(K_CQ) as usize] = 2
    zone_init()
    kval[(K_CN) as usize] = 1
    kval[(K_CSP) as usize] = sperre_stufe()
    kval[(K_CV) as usize] = 0
    kval[(K_CF) as usize] = nv.fallback()
    kval[(K_CL) as usize] = lidx
    kval[(K_CK2) as usize] = kidx
    kval[(K_CKANB) as usize] = 0
    pw_load()
    entries_init()
    // the program's names for the controls it reports and reads
    sy_tab = K_SY_TAB
    sy_ent = K_SY_ENT
    sy_bset = K_SY_BSET
    sy_bconf = K_SY_BCONF
    sy_bundo = K_SY_BUNDO
    ri_tab = K_RI_TAB
    ri_ctab = K_RI_CTAB
    ri_brev = K_RI_BREV
    ri_bjar = K_RI_BJAR
    ri_bblock = K_RI_BBLOCK
    pr_tab = K_PR_TAB
    pr_bref = K_PR_BREF
    up_bchk = K_UP_BCHK
    up_binst = K_UP_BINST
    up_bchan = K_UP_BCHAN
    up_bauto = K_UP_BAUTO
    up_brb = K_UP_BRB
    up_bconf = K_UP_BCONF
    su_bchk = K_SU_BCHK
    su_binst = K_SU_BINST
    ds_ch = K_CH
    ds_b2 = K_B2
    nz_cn = K_CN
    nz_b4 = K_B4
    nz_b4j = K_B4J
    br_aus_id = K_BR_AUS_ID
    tba_bereit = 1
    tba_label_setz()
}


fn u_start(args: u64) -> u64 {
    dbg_setup(args)
    widths_init()
    var s_bad: [u8; 24] = "settings: keine Flaeche\0"
    var s_rd: [u8; 19] = "settings: ready w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var t_theme: [u8; 11] = "/etc/theme\0"
    var t_schemas: [u8; 13] = "/etc/schemas\0"
    var t_wall: [u8; 15] = "/etc/wallpaper\0"
    var t_disp: [u8; 18] = "/etc/display.conf\0"
    var t_time: [u8; 15] = "/etc/time.conf\0"
    var t_net: [u8; 18] = "/etc/network.conf\0"
    var t_dhcp: [u8; 10] = "/bin/dhcp\0"
    var k_ndh: [u8; 9] = "net.dhcp\0"
    var k_true: [u8; 5] = "true\0"
    var k_m_ok: [u8; 22] = "settings.status.ready\0"
    var k_m_schema: [u8; 26] = "settings.status.scheme_ok\0"
    var k_m_schemano: [u8; 28] = "settings.status.scheme_fail\0"
    var k_m_bild: [u8; 29] = "settings.status.wallpaper_ok\0"
    var k_m_bildno: [u8; 31] = "settings.status.wallpaper_fail\0"
    var k_m_modeok: [u8; 24] = "settings.status.mode_ok\0"
    var m_mal: [u8; 4] = " x \0"
    var k_m_modeno: [u8; 26] = "settings.status.mode_fail\0"
    var k_m_behalt: [u8; 21] = "settings.status.keep\0"
    var k_m_zurueck: [u8; 23] = "settings.status.revert\0"
    var k_m_time: [u8; 29] = "settings.status.time_written\0"
    var k_m_net: [u8; 28] = "settings.status.net_written\0"
    var k_m_netzno: [u8; 24] = "settings.status.net_bad\0"
    var k_m_netzr: [u8; 27] = "settings.status.net_denied\0"
    var k_m_dhcp: [u8; 29] = "settings.status.dhcp_started\0"
    var k_m_kwok: [u8; 22] = "settings.status.pw_ok\0"
    var k_m_kwne: [u8; 28] = "settings.status.pw_mismatch\0"
    var k_m_kwku: [u8; 25] = "settings.status.pw_short\0"
    var k_m_kwno: [u8; 24] = "settings.status.pw_fail\0"
    var k_m_pinok: [u8; 23] = "settings.status.pin_ok\0"
    var k_m_pinfmt: [u8; 27] = "settings.status.pin_format\0"
    var k_m_pinno: [u8; 25] = "settings.status.pin_fail\0"
    var k_m_pinrm: [u8; 28] = "settings.status.pin_removed\0"
    var k_m_pinwr: [u8; 26] = "settings.status.pin_wrong\0"
    var k_m_pinlk: [u8; 27] = "settings.status.pin_locked\0"
    var k_m_pindis: [u8; 29] = "settings.status.pin_disabled\0"
    var k_m_nvok: [u8; 22] = "settings.status.nv_ok\0"
    var k_m_nvno: [u8; 26] = "settings.status.nv_denied\0"
    var k_m_fbok: [u8; 22] = "settings.status.fb_ok\0"
    var k_m_fbno: [u8; 26] = "settings.status.fb_denied\0"
    var k_modus: [u8; 7] = "modus=\0"
    var k_800: [u8; 9] = "800x600\n\0"
    var k_1024: [u8; 10] = "1024x768\n\0"
    var k_off: [u8; 8] = "offset=\0"
    var k_nl: [u8; 2] = "\n\0"
    var k_dh: [u8; 12] = "modus=dhcp\n\0"
    var k_fe: [u8; 15] = "modus=fest\nip=\0"
    var k_mk: [u8; 8] = "\nmaske=\0"
    var k_gw: [u8; 10] = "\ngateway=\0"
    var s_pfad: [u8; 41] = "                                        \0"

    // RUNDE I18N: DER KATALOG ALS ALLERERSTES, VOR JEDEM `msg.get`.
    // Die Widget-Bibliothek BEHAELT den Zeiger, den sie bekommt. Wer
    // den Katalog erst nach dem Bau der Oberflaeche startet, hat jedem
    // Bedienelement den Zeiger auf einen Platz gegeben, in dem damals
    // der SCHLUESSEL stand -- und auf dem Knopf steht dann bis in alle
    // Ewigkeit `settings.apply`.
    var s_lg: [u8; 18] = "settings: lang=\0\0\0"
    var s_lgs: [u8; 8] = " src=\0\0\0"
    var s_lgk: [u8; 8] = " keys=\0\0"
    let mk: u64 = msg.init()
    let _sr: bool = setroute.init()
    navview.set_keys(K_NAVBACK, K_NAVFWD, K_NAVUP, K_CRUMB0)
    navview.set_related_key(K_REL0)
    say((&s_lg[0 as usize]) as u64)
    say(msg.lang())
    say((&s_lgs[0 as usize]) as u64)
    sayn(msg.lang_source())
    say((&s_lgk[0 as usize]) as u64)
    sayn(mk)
    nl()
    fuiscene.set_flags(false, false)
    if !fuiscene.begin() {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    let _t: u64 = wlibc.theme_reload()
    shape_say()
    let _n: u64 = schemas_read((&t_schemas[0 as usize]) as u64)
    contrast_show()
    let _h: u64 = text_an((&e_bild[0 as usize]) as u64, 0,
        (&t_wall[0 as usize]) as u64)
    let _s: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
        msg.get((&k_m_ok[0 as usize]) as u64))
    state_read()
    tb_read()
    // ROUND THEMESTORE: the store is read BEFORE the widgets are made.
    // `wlib.list` counts the rows of the text it is given at the moment
    // it is given it, and `wlib.tile` keeps the pointer it is handed --
    // a list built over an empty buffer stays an empty list.
    templates_read()
    template_con_show()
    account_show()

    // THE WINDOW GREW WITH THE PAGE. 520 x 400 held the colour scheme
    // and the background picture; five more widgets did not fit, and a
    // widget that does not fit is not laid out badly here -- `wlib`
    // simply puts it outside the window, where nobody can click it.
    //
    // ROUND LOOK MADE THAT WARNING COME TRUE, measured it and left it
    // standing: the page wanted 674 pixels in a window with 542, and
    // `tools/desktop/run.sh` was made to FAIL on it rather than to
    // hide it. 132 pixels missing, and a red assertion that named them.
    //
    // ROUND THEMESTORE PAYS IT. Two things were wrong and only one of
    // them was the layout:
    //
    //  1. `ids` held 64 entries and this program registers 86 widgets,
    //     so widgets 65..86 -- the whole Netzzugriff and Sprache pages
    //     -- were NEVER hidden and were laid out on top of every other
    //     page. That is measured in section 5 of the round's runner.
    //  2. The Darstellung page really is too long for one column.
    //
    // So: FOUR BOXES INSTEAD OF ONE.
    //
    //     ctop   the tab bar, full width, at the top
    //     cleft  the left column of the two-column pages
    //     cright the right column
    //     cfull  every other page, full width
    //     cstat  the status line, pinned to the bottom
    //
    // `wlib` has no nested boxes and does not need them for this: a
    // widget remembers WHICH box it went into (`D_CT`), and `relayout`
    // resets every box and then places every visible widget in its own.
    // Two boxes side by side are two columns.
    //
    // The columns cannot be given a fixed y: the tab bar is 26 pixels
    // high under `classic` and 32 under `modern`, and that is a token
    // that changes at run time. So the tab bar is created first, its
    // rectangle is READ, and `wlib.box_at` puts the columns under it --
    // again after every `reshape`.
    // 700 WIDE AND NOT 560, AND THE NUMBER CAME OFF THE TAB BAR.
    // Eight tabs of German text measure 661 pixels; a 560-wide window
    // leaves 540 for them, so `tab_breite` would have to scale every
    // one of them down and clip the labels. 700 leaves 680 and nothing
    // is scaled. The screen is 800 and the taskbar takes 28 off the
    // bottom, so 50..750 by 3..569 is inside the work area with room
    // on both sides -- measured against `wm`'s own work rectangle and
    // not guessed.
    // RUNDE KONTO: 760 STATT 700, UND 20 STATT 50, WEIL EIN REITER
    // DAZUGEKOMMEN IST. Die Zahl 700 stand hier, weil acht deutsche
    // Reiter 661 Bildpunkte messen. "Konten" kommt dazu; passt die
    // Leiste nicht mehr, skaliert `tab_breite` jeden Reiter herunter
    // und schneidet Beschriftungen ab -- unsichtbar im Quelltext und
    // sichtbar nur auf einem Bildschirmfoto (das war der Befund von
    // Runde SOFTUI). 760 laesst 740 fuer die Leiste; der Schirm ist
    // 800 breit, also liegt 20..780 noch darin.
    //
    // RUNDE PRAESENZ: jetzt sind es ZEHN Reiter (KONTO 8, SYNC 9).
    // `tab_breite` rechnet alle anteilig kleiner und nie unter 24
    // Bildpunkte; keiner wird ausserhalb der Leiste gemalt. Die 760
    // bleiben, weil ein breiteres Fenster JEDES Bedienelement
    // verschieben und damit tools/i18n/run.sh reihenweise rot machen
    // wuerde (das war der Befund von Runde SYNC an dieser Stelle).
    //
    // DIE ZAHL WIRD NACHGEMESSEN und nicht geglaubt:
    // `tools/account/run.sh` Abschnitt 9 liest die Breite der Reiterleiste
    // aus dem laufenden Programm und wird rot, wenn sie ueber die
    // Fensterbreite hinausragt.
    var bw: u64 = 760 + SIDE_W + 8
    // the window is sized in design points: the screen too (device pixels / scale)
    let scr_w: u64 = wlibc.screen_w() / wlibc.ui_scale()
    let scr_h: u64 = wlibc.screen_h() / wlibc.ui_scale()
    if scr_w < bw + 40 {
        bw = scr_w - 40
    }
    // a tall screen gets a taller window (the pages are dense)
    var bh: u64 = 600
    if scr_h >= 700 {
        bh = 700
    }
    // a low screen: the window ends above the taskbar (40) and the top margin (3), never taller than the screen
    if scr_h < 600 && scr_h < bh + 50 {
        bh = scr_h - 50
        if bh < 300 {
            bh = 300
        }
    }
    fuiscene.set_dense(true)
    reiter = start_page
    setroute.note_page(reiter)
    // narrow window: a program asked to open on a page shows that page, not the list
    if start_page != R_DARST {
        nav_detail = true
    }
    // X2: paint into a private picture, so frame_end damages only what changed (a hover is a row, not the whole window)
    fuiapp.set_atomic(true)
    if !fuiscene.open(20, 3, bw, bh, msg.get((&k_t_titel[0 as usize]) as u64), build) {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    // The window tells the taskbar which bundle it belongs to (WM_APP); without it the button has no icon.
    var win_app_name: [u8; 9] = "settings\0"
    fuiscene.set_app((&win_app_name[0 as usize]) as u64)
    w = fuiscene.win_id()
    say((&s_rd[0 as usize]) as u64)
    sayn(bw)
    say((&s_hh[0 as usize]) as u64)
    sayn(bh)
    nl()
    init_values()
    // the page the program was asked to open on gets its data first
    if start_page != R_DARST {
        bus_page(start_page)
    }
    // RUNDE DISPLAY: the choices show WHAT IS SET, not the middle.
    if dget(DG_READY) == 1 {
        let _f1: u64 = num_at((&e_cw[0 as usize]) as u64, 0, dget(DG_PANELW))
        let _f2: u64 = num_at((&e_ch[0 as usize]) as u64, 0, dget(DG_PANELH))
        let _f3: u64 = num_at((&e_ct[0 as usize]) as u64, 0, dget(DG_BPP))
        save_read()
        fuiscene.table_prep(K_CS)
        fuiscene.table_set_sel(K_CS, dget(DG_CUR))
        kval[(K_CK) as usize] = dget(DG_SCALE)
        kval[(K_CD) as usize] = dget(DG_ROT) / 90
        kval[(K_CH) as usize] = stufe_von(dget(DG_BRIGHT), 0)
        kval[(K_CC) as usize] = stufe_von(dget(DG_CONTRAST), 0)
        kval[(K_CG) as usize] = stufe_von(dget(DG_GAMMA), 1)
        kval[(K_CQ) as usize] = stufe_von(dget(DG_SAT), 2)
        push_entries()
    }
    // the first picture, so that the controls have their places
    fuiscene.refresh()
    let _p0: u64 = fuiscene.pump()
    vorlage_say()
    var s_tl: [u8; 19] = "settings: tiles n=\0"
    var s_tl2: [u8; 8] = " shown=\0"
    var s_tl3: [u8; 8] = " acct=\0\0"
    say((&s_tl[0 as usize]) as u64)
    sayn(v_n)
    say((&s_tl2[0 as usize]) as u64)
    if v_n < TILES {
        sayn(v_n)
    } else {
        sayn(TILES)
    }
    say((&s_tl3[0 as usize]) as u64)
    if template.account_have() {
        sayn(1)
    } else {
        sayn(0)
    }
    nl()
    var n_edge: [u8; 5] = "edge\0"
    var n_size: [u8; 5] = "size\0"
    var n_ah: [u8; 9] = "autohide\0"
    var n_ot: [u8; 6] = "ontop\0"
    var n_ap: [u8; 6] = "apply\0"
    var n_win: [u8; 4] = "win\0"
    say((&mr_a[0 as usize]) as u64)
    say((&n_win[0 as usize]) as u64)
    say((&ms_b[0 as usize]) as u64)
    sayn(wlib.win_x(w))
    say((&ms_c[0 as usize]) as u64)
    sayn(wlib.win_y(w))
    say((&mr_w[0 as usize]) as u64)
    sayn(bw)
    say((&mr_h[0 as usize]) as u64)
    sayn(bh)
    nl()
    rect_say((&n_edge[0 as usize]) as u64, K_CE)
    rect_say((&n_size[0 as usize]) as u64, K_ET)
    rect_say((&n_ah[0 as usize]) as u64, K_KA)
    rect_say((&n_ot[0 as usize]) as u64, K_KO)
    rect_say((&n_ap[0 as usize]) as u64, K_B1)
    tb_say()
    melde_elemente()
    report_fui()
    melde_stand()
    rects_alle()
    bus_rects()

    // RUNDE O-NETZUI: the live display is filled once before it is first
    // painted
    netz_live_bauen()
    fuiscene.refresh()

    var runden: u64 = 0
    var frist_vor: u64 = 0
    // when the network page was measured last (ticks of 10 ms)
    var netz_vor: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    var ping_vor: u64 = netz_vor
    while fuiscene.alive() && runden < 1000000000000 {
        runden = runden + 1
        if reiter == R_NETZ {
            let jetzt: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
            if jetzt >= netz_vor + 100 {
                netz_vor = jetzt
                durchsatz_mess()
                if jetzt >= ping_vor + 500 {
                    ping_vor = jetzt
                    ping_gateway()
                }
                let before: u64 = netz_sum()
                netz_live_bauen()
                // describe the page again only when a number changed (a
                // repaint loop would flood the slow test machine)
                if netz_sum() != before {
                    fuiscene.refresh()
                }
            }
        }
        if reiter == R_SCREEN {
            // z10c bug: the key was the seconds left alone. The countdown hits 0 while the change is still pending, the idle task
            // reverts a moment later (pending 1 -> 0), the key stays 0 -> the page never redrew and kept "Keep? Back in 0 seconds"
            // for good. The key now carries the pending flag, so the revert changes it.
            var pend_now: u64 = 0
            if dget(DG_PENDING) == 1 {
                pend_now = 1
            }
            let rest: u64 = remain_secs() * 2 + pend_now
            // r1061: the kernel took the new mode back (the countdown ran out, pending 1 -> 0, nobody pressed Keep): the status line
            // said "Mode set, panel 800 x 600" for good. Now it says what happened, and names the screen as it is.
            if pend_now == 1 {
                rv_kept = 0
            }
            if pend_vor == 1 && pend_now == 0 && rv_kept == 0 {
                let _rv: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                    msg.get((&k_m_zurueck[0 as usize]) as u64))
                melde_stand()
            }
            pend_vor = pend_now
            if rest != frist_vor {
                frist_vor = rest
                let _fl: bool = deadline_read()
                if rest < 2 {
                    state_read()
                }
                fuiscene.refresh()
            }
        }
        let iw: u64 = tba_wirksam()
        if iw != tba_gez {
            tba_gez = iw
            tba_label_setz()
            // r368: and say so on the line the acceptance reads. The server
            // lifts the opacity only once it has mixed the bar; the page asks
            // every turn, so it learns the lifted number a moment after it came
            // up -- the report line that was written at start still said `ist=`
            // with the knob's value.
            glas_say()
        }
        let rq: u64 = fuiscene.resized()
        if rq != re_sq {
            re_sq = rq
            rep_due = 1
        }
        let sw: u64 = wlib.theme_switches()
        if sw != th_sw {
            th_sw = sw
            fuiscene.refresh()
            rep_due = 1
            glas_say()
        }
        let po: u64 = fuiscene.pane_offset(0) + fuiscene.pane_offset(1) * 100000
        if po != pane_prev {
            pane_prev = po
            rep_due = 1
        }
        // LIVE SEARCH: the text of the field is compared every turn
        let sq: u64 = fuiscene.entry_text(K_SRCH)
        if sq != 0 && !ulib.streq(sq, (&srch_prev[0 as usize]) as u64) {
            let _c1: u64 = ulib.strncpy((&srch_prev[0 as usize]) as u64, sq, 44)
            let _c2: u64 = ulib.strncpy((&e_srch[0 as usize]) as u64, sq, 44)
            __mmio_write8(((&srch_prev[0 as usize]) as u64 + 44) as *mut u8, 0 as u8)
            __mmio_write8(((&e_srch[0 as usize]) as u64 + 44) as *mut u8, 0 as u8)
            fuiscene.refresh()
            rep_due = 1
        }
        // KEYBOARD: Ctrl+F -> search, Esc -> clear the search, Up / Down in the sidebar
        let kseq: u64 = fuiscene.key_seq()
        if kseq != ks_prev {
            ks_prev = kseq
            let ka: u64 = fuiscene.key_any()
            let fkk: u64 = fuiscene.focus_key()
            if ka == wlib.KEY_CTRL_F {
                fuiscene.focus(K_SRCH)
            } else if ka == wlib.KEY_OLD_LEFT {
                nav_act(navview.ACT_BACK, 0)
            } else if ka == wlib.KEY_OLD_RIGHT {
                nav_act(navview.ACT_FORWARD, 0)
            } else if ka == wlib.KEY_OLD_UP {
                nav_act(navview.ACT_UP, 0)
            } else if ka == wlib.KEY_ESC && rb((&e_srch[0 as usize]) as u64, 0) != 0 {
                fuiscene.entry_set(K_SRCH, (&e_srch[0 as usize]) as u64 + 47)
                fuiscene.focus(tab_key(reiter))
            } else if ka == wlib.KEY_ESC && nav_page_only() {
                nav_detail = false
                fuiscene.refresh()
                rep_due = 1
            } else if (ka == wlib.KEY_DOWN || ka == wlib.KEY_UP) && key_page(fkk) != NO_PAGE {
                let nx: u64 = nav_step(key_page(fkk), ka == wlib.KEY_DOWN)
                if nx != key_page(fkk) {
                    let keep_detail: bool = nav_detail
                    goto_page(nx)
                    nav_detail = keep_detail
                    fuiscene.build_now()
                    fuiscene.focus(tab_key(nx))
                }
            }
        }
        var key: u64 = fuiscene.pump()
        // the new controls act through the old apply path
        if key >= K_SEG0 && key < K_SEG0 + 3 {
            kval[(K_CM) as usize] = key - K_SEG0
            key = K_B1
        } else if key >= K_SW0 && key < K_SW0 + 8 {
            sw_sel = key - K_SW0
            let _c3: u64 = ulib.strncpy((&e_akzent[0 as usize]) as u64, ((&sw_hex[0 as usize]) as u64) + sw_sel * 8, 12)
            push_entries()
            key = K_B1
        } else if key == K_BACK {
            nav_detail = false
            fuiscene.refresh()
            rep_due = 1
            key = 0
        } else if navview.action_of(key) != navview.ACT_NONE {
            nav_act(navview.action_of(key), key)
            key = 0
        } else if key == K_SRCH {
            if nav_n > 0 {
                var first: u64 = nav_step(99, true)
                if setroute.top_page() != setroute.NONE {
                    first = setroute.top_page()
                }
                goto_page(first)
            }
            key = 0
        } else if key == K_WP0 {
            // the picture is chosen by the path field below the tile (copied to the wallpaper file by Apply)
            fuiscene.focus(K_EB)
            key = 0
        }
        if key == 0 {
            if rep_due != 0 {
                rep_due = 0
                rects_alle()
                bus_rects()
                melde_stand()
            }
        } else {
            pull_entries()
            var kind: u64 = wlib.K_BUTTON
            var id: u64 = key
            var idx: u64 = 0
            if key >= K_TAB0 && key < K_TAB0 + R_ANZ {
                kind = wlib.K_TABS
                idx = key - K_TAB0
            } else if key >= K_PKGTAB0 && key < K_PKGTAB0 + PKG_MAX {
                kind = wlib.K_TABS
                idx = R_ANZ + key - K_PKGTAB0
            } else if key >= K_PKGF0 && key < K_PKGF0 + 240 {
                kind = 999
            } else if is_choice(key) {
                kind = wlib.K_CHOICE
                idx = 4096
            } else if is_slider(key) {
                kind = wlib.K_SLIDER
            } else if key >= K_TILE0 && key < K_TILE0 + TILES {
                kind = wlib.K_TILE
            } else if key == fuiscene.KEY_POPUP {
                kind = wlib.K_MENUBAR
                id = ch_pend
                idx = fuiscene.menu_pick() - 1
            }
            if kind == 999 {
                pkg_click(key - K_PKGF0)
            } else if kind == wlib.K_TABS {
                if nav_mode() {
                    nav_detail = true
                }
                bus_page(idx)
                zeige_reiter(idx)
                melde_stand()
            } else if kind == wlib.K_CHOICE {
                ch_open(id)
            } else if kind == wlib.K_MENUBAR {
                if is_choice(id) {
                    kval[(id) as usize] = idx
                    if id == K_CZ {
                        kval[(K_CZC) as usize] = 0 // a new region starts at its first city
                    }
                    if id == K_CE {
                        tb_edge = idx
                        tb_show_size()
                        fuiscene.entry_set(K_ET, (&e_tbs[0 as usize]) as u64)
                    }
                    menu_done(id, idx)
                    if id == K_CE || id == K_CAL {
                        tb_apply_live()
                    }
                    if id == K_ZS1 || id == K_ZS2 || id == K_ZS3 || id == K_BS1 || id == K_BS2 {
                        effects_apply_live()
                    }
                    if id == K_TRN {
                        trn_apply(idx)
                    }
                    if id == K_PW_LB || id == K_PW_LA || id == K_PW_PB || id == K_PW_PA {
                        pw_choice(id)
                    }
                }
            } else if kind == wlib.K_SLIDER && (id == K_PW_SB || id == K_PW_SA || id == K_PW_YB || id == K_PW_YA) {
                pw_slider(id)
            } else if kind == wlib.K_SLIDER && (id == K_MS_SPD || id == K_MS_ACC) {
                mouse_slider(id)
            } else if kind == wlib.K_BUTTON && id == K_MS_NAT {
                mouse_toggle()
            } else if kind == wlib.K_BUTTON && id == K_MS_GES {
                mouse_toggle_ges()
            } else if kind == wlib.K_BUTTON && id == K_MS_FPS {
                mouse_toggle_fps()
            } else if kind == wlib.K_SLIDER {
                // ================================== RUNDE GLAS
                //
                // SOFORT SICHTBAR, UND DANN ERST GESCHRIEBEN. Die
                // Setzer in `wlibc` klemmen den Wert, legen ihn in die
                // Marken und loesen den Satz neu auf -- damit stimmt
                // das Aussehen, bevor die Hand den Regler loslaesst.
                //
                // DANACH DIE DATEI, und zwar dieselbe eine Datei, die
                // auch der Knopf 'Uebernehmen' schreibt, mit denselben
                // vier anderen Angaben aus denselben vier Widgets. Ein
                // zweiter Schreiber, der nur die vier neuen Zeilen
                // kennte, haette beim ersten Reglerzug Schema, Modus,
                // Akzent und Formsatz aus der Datei geloescht.
                //
                // Ein Schreibvorgang je Reglermeldung ist vertretbar:
                // die Datei ist gut hundert Oktette gross, und der
                // Regler meldet sich beim Ziehen hoechstens so oft,
                // wie die Maus Punkte liefert. Der Preis dafuer ist,
                // dass eine Aenderung einen Neustart ueberlebt, auch
                // wenn danach niemand mehr 'Uebernehmen' drueckt.
                if id == K_SL_RAD {
                    wlibc.set_radius(slv(K_SL_RAD, 0, 24))
                } else if id == K_SL_TBA {
                    wlibc.set_tb_alpha(slv(K_SL_TBA, 0, 100))
                } else if id == K_SL_WA {
                    wlibc.set_win_alpha(slv(K_SL_WA, 0, 100))
                } else if id == K_SL_BLUR {
                    wlibc.set_tb_blur(slv(K_SL_BLUR, 0, 16))
                }
                if id == K_SL_RAD || id == K_SL_TBA || id == K_SL_WA
                    || id == K_SL_BLUR {
                    // DER REGLER ZEIGT, WAS WIRKLICH GILT. `wlibc`
                    // klemmt die Deckkraft nach unten, damit die
                    // Schrift der Leiste lesbar bleibt; wer den Regler
                    // darunter zieht, soll ihn dort stehen sehen, wo
                    // der Wert wirklich gelandet ist.
                    sl_set(K_SL_RAD, 0, 24, wlibc.radius())
                    sl_set(K_SL_TBA, 0, 100, wlibc.tb_alpha())
                    sl_set(K_SL_WA, 0, 100, wlibc.win_alpha())
                    sl_set(K_SL_BLUR, 0, 16, wlibc.tb_blur())
                    if fuiscene.table_sel(K_LS) < nschema {
                        // ZUSAMMENFUEHRUNG: DIE SECHS ZAHLEN DER
                        // RUNDEN ZIEH UND BLUR GEHEN MIT.
                        //
                        // Diese Datei wird GANZ geschrieben, nicht
                        // zeilenweise geaendert. Stuenden hier nur die
                        // vier alten Werte, loeschte ein Zug am
                        // Glasregler die Einstellungen des Aufhebens
                        // und des Acryls aus /etc/theme.conf -- und
                        // zwar still, denn auf dem Schirm blieben die
                        // Kaestchen stehen, bis jemand neu startet.
                        // Es sind dieselben Ausdruecke wie beim Knopf
                        // "Uebernehmen" weiter unten.
                        let _gw: bool = theme_conf_write(
                            (&snamen[0 as usize]) as u64
                                + fuiscene.table_sel(K_LS) * 32,
                            kval[(K_CM) as usize],
                            (&e_akzent[0 as usize]) as u64,
                            kval[(K_CSH) as usize],
                            zieh_wert_von(kval[(K_ZS1) as usize], 40, 50),
                            zieh_wert_von(kval[(K_ZS2) as usize], 50, 80),
                            zieh_wert_von(kval[(K_ZS3) as usize], 25, 45),
                            zieh_wert_von(kval[(K_BS1) as usize], 6, 12),
                            zieh_wert_von(kval[(K_BS2) as usize], 18, 32),
                            blur_noise_von(kval[(K_BS1) as usize]))
                    }
                    tba_label_setz()
                    glas_say()
                    // (described again)
                }
            } else if kind == wlib.K_TILE {
                // A TILE IS THE PRESET IT DRAWS. Clicking one selects
                // it; it does not apply it. Applying is a button, and
                // an appearance that changed because a picture was
                // touched would be a surprise and not a feature.
                var t: u64 = 0
                while t < TILES {
                    if K_TILE0 + t == id {
                        v_sel = t
                        template_con_show()
                        // (described again)
                        // (described again)
                    }
                    t = t + 1
                }
            } else if kind == wlib.K_BUTTON {
                if id == K_BV1 {
                    // ANWENDEN. One click, and the seven values land in
                    // the two files the system reads. Everything after
                    // that is the machinery rounds THEME and LOOK
                    // already built: `theme_reload` re-resolves and the
                    // taskbar's own poll picks up its file.
                    if v_sel < v_n && template.apply_at(v_sel) {
                        let _r1: u64 = wlibc.theme_reload()
                        // (described again)
                        // (described again)
                        // (described again)
                        tb_read()
                        kval[(K_CE) as usize] = tb_edge
                        kval[(K_CAL) as usize] = tb_align
                        shape_say()
                        contrast_show()
                        // (described again)
                        // (described again)
                        let _a1: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vok[0 as usize]) as u64))
                    } else {
                        let _a2: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vno[0 as usize]) as u64))
                    }
                    // (described again)
                    // (described again)
                    vorlage_say()
                    melde_stand()
                } else if id == K_BV2 {
                    // SPEICHERN: what is RUNNING, under the name in the
                    // field, into the local store. No account needed
                    // and none asked for.
                    var okv: bool = false
                    if e_vid[(0) as usize] != 0 as u8 {
                        okv = template.save_as((&e_vid[0 as usize]) as u64,
                            (&e_vid[0 as usize]) as u64)
                    }
                    if okv {
                        templates_read()
                        template_con_show()
                        // (described again)
                        let _a3: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vsave[0 as usize]) as u64))
                    } else {
                        let _a4: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vno[0 as usize]) as u64))
                    }
                    // (described again)
                    // (described again)
                    vorlage_say()
                    melde_stand()
                } else if id == K_BV3 {
                    var oke: bool = false
                    if e_vfile[(0) as usize] != 0 as u8 && v_sel < v_n {
                        oke = template.export_at(v_sel,
                            (&e_vfile[0 as usize]) as u64)
                    }
                    if oke {
                        let _a5: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vexp[0 as usize]) as u64))
                    } else {
                        let _a6: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vno[0 as usize]) as u64))
                    }
                    // (described again)
                    // (described again)
                    melde_stand()
                } else if id == K_BV4 {
                    var oki: bool = false
                    if e_vfile[(0) as usize] != 0 as u8
                        && e_vid[(0) as usize] != 0 as u8 {
                        oki = template.import_from((&e_vfile[0 as usize]) as u64,
                            (&e_vid[0 as usize]) as u64)
                    }
                    if oki {
                        templates_read()
                        template_con_show()
                        // (described again)
                        let _a7: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vimp[0 as usize]) as u64))
                    } else {
                        let _a8: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vno[0 as usize]) as u64))
                    }
                    // (described again)
                    // (described again)
                    vorlage_say()
                    melde_stand()
                } else if id == K_BV5 {
                    let nlk: u64 = template.link_all()
                    var a9: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                        msg.get((&k_m_vlink[0 as usize]) as u64))
                    a9 = num_at((&l_stat[0 as usize]) as u64, a9, nlk)
                    account_show()
                    // (described again)
                    // (described again)
                    // (described again)
                    melde_stand()
                } else if id == K_BV6 {
                    let nrs: u64 = template.restore_all()
                    templates_read()
                    template_con_show()
                    // (described again)
                    var aa: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                        msg.get((&k_m_vrest[0 as usize]) as u64))
                    aa = num_at((&l_stat[0 as usize]) as u64, aa, nrs)
                    // (described again)
                    // (described again)
                    vorlage_say()
                    melde_stand()
                } else if id == K_BR_AUS_ID {
                    // RUNDE BRUECKE: AUS.
                    //
                    // Zwei Dinge, und beide sofort wirksam:
                    //
                    //  1. `eingabe = nein` und `bildschirmfoto = nein`
                    //     in /etc/jarvis/rechte.conf. Der Helfer liest
                    //     die Datei VOR JEDEM Auftrag neu -- es
                    //     braucht keinen Neustart und kein Signal.
                    //  2. Einen offenen Tippschein wegnehmen
                    //     (TI_DROP). Ohne das duerfte jemand, der
                    //     gerade einen Schein hat, noch bis zu zwei
                    //     Minuten weitertippen -- "aus" hiesse dann
                    //     "gleich aus", und das ist bei einem
                    //     Fernzugriff die falsche Antwort.
                    //
                    // WAS DIESER KNOPF NICHT TUT: das Geraet
                    // ENTKOPPELN. Der Schluessel bleibt -- wer die
                    // Kopplung loeswerden will, sperrt das Geraet am
                    // Server. Ein Knopf, der beides taete, waere einer,
                    // nach dessen Druecken man ohne den Server nicht
                    // mehr zurueckkommt.
                    let _bd: u64 = ulib.sys(SYS_TIPP, TI_DROP, 0, 0)
                    if bridge_off() {
                        bridge_read()
                        // (described again)
                        // (described again)
                        // (described again)
                    }
                } else if id == K_B1 {
                    // RUNDE THEME: nicht mehr eine Datei kopieren,
                    // sondern /etc/theme.conf schreiben und den Satz
                    // neu aufloesen. Danach stehen die gemessenen
                    // Kontraste im Fenster -- vor dem naechsten Klick
                    // und nicht in einem Protokoll.
                    if fuiscene.table_sel(K_LS) < nschema {
                        if theme_conf_write(
                            (&snamen[0 as usize]) as u64
                                + fuiscene.table_sel(K_LS) * 32,
                            kval[(K_CM) as usize],
                            (&e_akzent[0 as usize]) as u64,
                            kval[(K_CSH) as usize],
                            zieh_wert_von(kval[(K_ZS1) as usize], 40, 50),
                            zieh_wert_von(kval[(K_ZS2) as usize], 50, 80),
                            zieh_wert_von(kval[(K_ZS3) as usize], 25, 45),
                            zieh_wert_von(kval[(K_BS1) as usize], 6, 12),
                            zieh_wert_von(kval[(K_BS2) as usize], 18, 32),
                            blur_noise_von(kval[(K_BS1) as usize])) {
                            let _r: u64 = wlibc.theme_reload()
                            // THE SHAPE CHANGES THE SIZE OF EVERY
                            // CONTROL, so the page has to be laid out
                            // again -- a repaint alone would draw 32-
                            // pixel buttons into 26-pixel rectangles.
                            // `wlib.relayout` re-runs the boxes with
                            // the new tokens and keeps every widget,
                            // every value and every text pointer.
                            // (described again)
                            // THE TAB BAR JUST CHANGED HEIGHT. The
                            // columns hang off it, so they move too --
                            // and then everything is laid out again.
                            // (described again)
                            // (described again)
                            shape_say()
                            contrast_show()
                            // (described again)
                            // (described again)
                            let a: u64 = text_an((&l_stat[0 as usize]) as u64,
                                0, msg.get((&k_m_schema[0 as usize]) as u64))
                            let _b: u64 = text_an((&l_stat[0 as usize])
                                as u64, a, (&snamen[0 as usize]) as u64
                                + fuiscene.table_sel(K_LS) * 32)
                        } else {
                            let _c: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, msg.get((&k_m_schemano[0 as usize]) as u64))
                        }
                    }
                    // das Bild -- nur, wenn die Quelle nicht schon das
                    // Ziel ist. Eine Datei auf sich selbst zu kopieren
                    // heisst hier: sie erst leeren und dann lesen.
                    if !ulib.streq((&e_bild[0 as usize]) as u64,
                        (&t_wall[0 as usize]) as u64) {
                        let n2: u64 = file_copy(
                            (&e_bild[0 as usize]) as u64,
                            (&t_wall[0 as usize]) as u64)
                        if n2 > 0 {
                            let a2: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, msg.get((&k_m_bild[0 as usize]) as u64))
                            let _d2b: u64 = num_at((&l_stat[0 as usize])
                                as u64, a2, n2)
                        } else {
                            let _e2b: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, msg.get((&k_m_bildno[0 as usize]) as u64))
                        }
                    }
                    melde_stand()
                } else if id == K_KA || id == K_KO || id == K_ET {
                    tb_apply_live()
                } else if id == K_KSH {
                    effects_apply_live()
                } else if id == K_B2 {
                    // RUNDE DISPLAY: UEBERNEHMEN HEISST JETZT
                    // UEBERNEHMEN. Vorher wurde eine Zeile in
                    // /etc/display.conf geschrieben und auf den naechsten
                    // Start vertroestet.
                    //
                    // Die Reihenfolge ist nicht beliebig: erst das
                    // Bild (Helligkeit, Kontrast, Gamma, Saettigung),
                    // dann die Drehung und die Skalierung, und ZULETZT
                    // die Aufloesung. Ein Moduswechsel raeumt den
                    // Zweitpuffer um; alles, was davor eingestellt
                    // wurde, gilt danach weiter, alles was danach kaeme,
                    // muesste ein zweites Mal gesetzt werden.
                    // AB-005c: brightness is display.brightness on the
                    // bus (percent = kernel points / 2; settingsd sets the
                    // kernel). Contrast, gamma, saturation, rotation and
                    // the mode are not in the schema and stay direct.
                    var k_br: [u8; 19] = "display.brightness\0"
                    let kb: u64 = level_bright(kval[(K_CH) as usize])
                    if bus_set_num((&k_br[0 as usize]) as u64, kb / 2)
                        == actcli.R_NOBUS {
                        let _p1: u64 = dset(DS_BRIGHT, kb)
                    }
                    let _p2: u64 = dset(DS_CONTRAST,
                        level_bright(kval[(K_CC) as usize]))
                    let _p3: u64 = dset(DS_GAMMA, stufe_gam(kval[(K_CG) as usize]))
                    let _p4: u64 = dset(DS_SAT, stufe_sat(kval[(K_CQ) as usize]))
