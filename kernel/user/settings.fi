// RUNDE LOOK (aus Runde I18N zurueckgeholt): die Tastaturbelegung.
// Eine Oberflaeche auf Deutsch mit einer amerikanischen Belegung waere
// eine halbe Antwort -- also steht die Belegung auf derselben Seite.
// DIE TASTATURBELEGUNG, UND ZWAR UNTER DER RICHTIGEN NUMMER.
//
// Hier stand 1780. Der Kern kennt den Aufruf als SYS_OSUM_KBD = 1703
// (kernel/sys.fi:1049), und tools/i18n/i18nt.fi ruft ihn seit Runde
// I18N unter 1703 auf. 1780 ist nicht belegt -- die Belegung der
// Tastatur liess sich in den Einstellungen also gar nicht umstellen,
// der Aufruf ging ins Leere.
//
// Aufgefallen ist es an einer ganz anderen Zusage: 1780 liegt im
// Bereich 1750..1799, den Runde K18 fuer die Energieaufrufe reserviert
// hat, und tools/k18/run.sh sucht nach Fremdvergaben darin. Auf
// mergeline hat das niemand gesehen, weil die Sprachseite bei der
// Zusammenfuehrung der siebzehn Zweige verlorengegangen war; Runde
// LOOK hat sie zurueckgeholt und die falsche Nummer mit ihr.
//
// Eine Zusage, die einen Fehler in einer FREMDEN Datei findet, ist
// genau das, wofuer eine Nummernvergabe da ist.
// RUNDE BRUECKE: der Aufruf, mit dem diese Seite nachsieht, ob gerade
// jemand von aussen tippt. NUR LESEN (TI_INFO) und einmal TI_DROP --
// diese Seite speist nichts ein.
const SYS_TIPP: u64 = 1843
const TI_INFO: u64 = 0
const TI_DROP: u64 = 2
const TQ_ARMED: u64 = 0
const TQ_TOTAL: u64 = 3
const TQ_DENIED: u64 = 4
const TQ_ARMS: u64 = 5

const SYS_KBD: u64 = 1703
const KB_GET: u64 = 0
const KB_SET: u64 = 1

const R_DARST: u64 = 0
const R_SCREEN: u64 = 1
const R_TIME: u64 = 2
const R_NETZ: u64 = 3
const R_BENUT: u64 = 4
// ROUND NETVIEW: der sechste Reiter. Er steht NEBEN "Netz" und nicht
// darin, und das ist Absicht: "Netz" ist die Anschrift DIESER MASCHINE,
// hier steht, welches Netz die einzelnen PROGRAMME sehen. Zwei Fragen,
// zwei Seiten.
const R_NETV: u64 = 5
// RUNDE LOOK: DER SIEBTE REITER, ZURUECKGEHOLT. Runde I18N hatte ihn
// gebaut (`R_SPRACHE = 5`); die Zusammenfuehrung der siebzehn Zweige
// hat die uebersetzte Fassung dieser Datei verloren -- die Fassung aus
// netview/theme/display gewann jeden Konflikt, und mit ihr fielen 64
// Katalogzugriffe und die ganze Sprachseite weg. Gemessen: `grep -c
// 'msg\.'` gab auf dem Zweig `i18n` 64 und auf `mergeline` 0.
//
// Er steht jetzt NACH "Netzzugriff" und nicht wieder auf Platz 5:
// die Nummern der anderen sechs Seiten bleiben damit, was sie sind,
// und kein Testlaeufer, der Reiter 5 anklickt, klickt auf etwas
// anderes als vorher.
const R_SPRACHE: u64 = 6
// ROUND THEMESTORE: THE EIGHTH TAB, and it goes at the END for exactly
// the reason round LOOK wrote down two constants above: every other
// page keeps its number, so a runner that clicks tab 5 still clicks
// what it clicked yesterday. A store of appearances belongs beside
// "Darstellung" and it is one tab further along instead; that is a
// worse menu and a better change.
const R_VORL: u64 = 7
// RUNDE KONTO: DER NEUNTE REITER, und er geht wieder ans ENDE -- aus
// demselben Grund, den Runde LOOK und Runde THEMESTORE zwei Konstanten
// weiter oben aufgeschrieben haben: jede andere Seite behaelt ihre
// Nummer, also klickt ein Testlaeufer, der Reiter 5 anklickt, weiter
// auf dasselbe wie gestern.
const R_KONTO: u64 = 8
// RUNDE SYNC: DER ZEHNTE REITER. Er stand auf dem Zweig `sync` auf 8,
// weil dort Runde KONTO nicht drin war -- BEIDE Runden haben sich
// unabhaengig die 8 genommen. RUNDE PRAESENZ loest das auf: KONTO
// behaelt die 8 (es kam zuerst und seine Messung liest die Nummer),
// SYNC rueckt auf 9. Hier steht NUR, was abgeglichen wird, wie der
// Stand ist, ob Konflikte offen sind und ob der Tresor auf ist.
// GEAENDERT WIRD HIER NICHTS: das Anlegen eines Kontos verlangt eine
// Passphrase, und eine Passphrase gehoert nicht in ein Fenster, das
// auch ohne sie aufgeht. Dafuer gibt es `sync neu` auf der
// Befehlszeile, und die Seite sagt das auch.
const R_SYNC: u64 = 9
// RUNDE BRUECKE: DER ELFTE REITER, und er geht ans ENDE -- aus dem
// Grund, den LOOK, THEMESTORE und KONTO schon aufgeschrieben haben:
// jede andere Seite behaelt ihre Nummer, also klickt ein Testlaeufer,
// der Reiter 5 anklickt, weiter auf dasselbe wie gestern.
//
// WARUM DIE BRUECKE UEBERHAUPT IN DIE EINSTELLUNGEN GEHOERT, und nicht
// nur auf die Befehlszeile: Justins Vorgabe zu dieser Runde sagt es
// ausdruecklich -- "Die Bruecke muss sich AUSSCHALTEN lassen, und zwar
// in den Einstellungen, nicht nur per Kommandozeile." Ein Fernzugriff,
// den man nur mit einem gemerkten Befehl abstellen kann, ist fuer die
// meisten Menschen nicht abstellbar.
//
// DIESE SEITE ZEIGT UND SCHALTET, sie koppelt nicht. Das Koppeln
// verlangt einen Code vom Server und gehoert zu `jarvisctl koppeln`
// -- eine Seite, die auch das koennte, waere die Stelle, an der ein
// Fremder mit einer Minute am offenen Rechner ein Geraet anmeldet.
// DIE ELEMENTTAFEL REICHT, UND DAS IST NACHGEZAEHLT: `grep -c
// 'merke(wlib\.'` gibt 163, die Tafel fasst 192. Das ist wichtig,
// weil `merke` bei einer vollen Tafel STILL nichts ablegt und ein
// nicht gemerktes Bedienelement dann auf JEDER Seite stehen bleibt --
// der Fehler, der Runde LOOK einen Tag gekostet hat (zwei Seiten
// uebereinander). Seit Runde KONTO sagt `merke` es wenigstens
// ("settings: elementtafel voll"); hier bleiben 29 Plaetze frei.
const R_BRUECKE: u64 = 10
// ROUND ACTION-BUS-3: TWO MORE PAGES, AT THE END for the reason the four
// constants above give -- every other page keeps its number.
//   11 System      every setting of the schema, through the action bus
//   12 App rights  what may which app (AB-006)
const R_SYSTEM: u64 = 11
const R_RECHTE: u64 = 12
// ROUND ROADMAP-7 (S-009): the audit log of the action bus as a page --
// newest first, what `act audit` gives the user
const R_PROTO: u64 = 13
// DAILY-DRIVER: the system update as a page -- state and buttons over the
// bus (settings.update.* of settingsd, which is root and runs `ota`)
const R_UPDATE: u64 = 14
// ROUND LAP1 (L-001): the page "Maus", at the END like every page before it.
const R_MAUS: u64 = 15
// ROUND R783 (L-007c): the page "Energie" (power: lid, screen off, standby, profile per source), at the END.
const R_ENERGIE: u64 = 16
// ROUND MINT4 (E1): the page "Info" (hardware report + export), at the END.
const R_INFO: u64 = 17
// SET-7: the page "Advanced display" (contrast, gamma, saturation, custom mode), at the END; package pages follow it.
const R_SCREEN2: u64 = 19
// SET-6: the pages "Taskbar" and "Window effects" (split off the Appearance page), at the END; package pages follow them.
const R_TASKBAR: u64 = 20
const R_EFFECTS: u64 = 21
// LW-5: the pages "Wi-Fi" and "USB network" (lib/netui), at the END; package pages follow them.
const R_WIFI: u64 = 22
const R_USBNET: u64 = 23
const R_SCHEME: u64 = 24
const R_ACCENT: u64 = 25
const R_PASSW: u64 = 26
const R_PIN: u64 = 27
const R_VTRANS: u64 = 28
const R_ANZ: u64 = 29
// W-AR6B (r919): the page "Apps" (per app: counters, rights, force stop, uninstall), at the END.
const R_APPS: u64 = 18

static mut w: u64 = 0
// 128 AND NOT 64, AND THAT IS A BUG FIX AND NOT ROOM FOR THIS ROUND.
//
// This program registered 86 widgets and `merke` kept the first 64.
// Every widget from number 65 on was therefore never handed to
// `wlib.show` -- so the Netzzugriff and Sprache pages were laid out on
// TOP of whichever page was showing, on every tab, since the merge
// that brought the seventh tab back. Nothing said so: a widget that is
// drawn where another page's widget also is looks like a page with too
// much on it, which is exactly what round LOOK diagnosed as "the page
// is 132 pixels too tall".
// RUNDE KONTO: DIE TAFEL WAR VOLL, UND SIE HAT ES NICHT GESAGT.
// `merke` legt still nichts ab, wenn `nid` das Ende erreicht -- ein
// Bedienelement ohne Eintrag wird von `zeige_reiter` nie versteckt
// und steht dann auf JEDER Seite. Genau so lag "Konten auf diesem
// Geraet" ueber der Vorschau der Vorlagen (tools/themestore).
// RUNDE SYNC wollte hier 160 (ihre neunte Seite bringt 14 Elemente);
// RUNDE PRAESENZ nimmt 192, weil jetzt BEIDE Seiten drin sind und die
// Praesenzleiste noch dazukommt. Der Abstand zur Grenze wird gemessen
// (`settings: elemente n=... max=...`), nicht geschaetzt.
// ROUND ACTION-BUS-3: 224. The two new pages bring sixteen widgets and
// the table held 179 of 192.
static mut ids: [u64; 224] = [0 as u64; 224]
static mut rtr: [u64; 224] = [0 as u64; 224] // zu welchem Reiter gehoert es
static mut nid: u64 = 0
static mut reiter: u64 = 0

// die Puffer der Oberflaeche
static mut schemas: [u8; 512] = [0 as u8; 512]
static mut snamen: [u8; 512] = [0 as u8; 512]
static mut nschema: u64 = 0
static mut e_bild: [u8; 96] = [0 as u8; 96]
static mut l_schirm: [u8; 64] = [0 as u8; 64]
static mut l_datum: [u8; 64] = [0 as u8; 64]
static mut l_ip: [u8; 64] = [0 as u8; 64]
static mut l_maske: [u8; 64] = [0 as u8; 64]
static mut l_gw: [u8; 64] = [0 as u8; 64]
static mut l_mac: [u8; 64] = [0 as u8; 64]
static mut l_wer: [u8; 64] = [0 as u8; 64]
static mut l_stat: [u8; 96] = [0 as u8; 96]
static mut e_ip: [u8; 24] = [0 as u8; 24]
static mut e_maske: [u8; 24] = [0 as u8; 24]
static mut e_gw: [u8; 24] = [0 as u8; 24]
// ================================================== RUNDE O-NETZUI
// DER LIVE-ZUSTAND DER VERBINDUNG, wie Windows und GNOME ihn zeigen.
//
// Bis hierher zeigte diese Seite die ANSCHRIFT dieser Maschine --
// Adresse, Maske, Gateway, Hardwareadresse -- und kein einziges Zeichen
// darueber, wie es der Verbindung GERADE geht. Justins Vorgabe zu
// dieser Runde sagt genau das: "solche sachen wie in windows oder linux
// wie aktuelle geschwindigkeit zum router und so soll ich in den
// settings sehen".
//
// DREI ZAHLEN, DIE MAN NICHT VERWECHSELN DARF, und die Seite haelt sie
// deshalb auseinander und beschriftet sie verschieden:
//
//   DURCHSATZ         wieviel gerade FLIESST (KiB/s). Gemessen, schwankt.
//   VERBINDUNGSRATE   wie schnell der ANSCHLUSS ausgehandelt ist
//                     (10/100/1000 Mbit/s). Fest, kommt aus der Karte,
//                     und ist UNBEKANNT, wenn die Karte sie nicht meldet.
//   ANTWORTZEIT       wie lange das Gateway braucht (ms). Gemessen.
//
// Windows wirft die ersten beiden in einem Fenster zusammen und nennt
// beide "Geschwindigkeit"; das ist die haeufigste Verwechslung im
// ganzen Netzwerkstatus, und sie kostet hier zwei Woerter mehr.
//
// DIE PUFFER SIND STATISCH, wie jeder andere Text dieser Datei: `wlib`
// BEHAELT den Zeiger auf den Text eines Bedienelements und kopiert ihn
// nicht -- ein Text aus dem Rahmen einer Funktion, die zurueckkehrt,
// waere ein Zeiger auf nichts, und firnc faengt genau das ab.
static mut l_nzust: [u8; 96] = [0 as u8; 96] // "Verbunden" / "Getrennt"
static mut l_nrate: [u8; 96] = [0 as u8; 96] // ausgehandelte Verbindungsrate
static mut l_nrunter: [u8; 64] = [0 as u8; 64] // Empfang, jetzt
static mut l_nrauf: [u8; 64] = [0 as u8; 64] // Senden, jetzt
static mut l_nsumme: [u8; 96] = [0 as u8; 96] // seit dem Start insgesamt
static mut l_nping: [u8; 96] = [0 as u8; 96] // Antwortzeit zum Gateway
static mut b_nprog: [u8; 1024] = [0 as u8; 1024] // Verbrauch je Programm
static mut b_nconn: [u8; 1536] = [0 as u8; 1536] // aktive Verbindungen

// DIE SPALTENBREITEN DER ZWEI TABELLEN. Auch sie sind statisch, und
// zwar aus demselben Grund: `wlib.table` behaelt den Zeiger.
//
// WARUM DIE ZAHLENSPALTEN SO BREIT SIND, und das ist kein
// Schoenheitsmass: "12,4 MiB/s" ist breiter als "9 KiB/s", und eine
// Spalte, die nur fuer den Ruhezustand reicht, laesst die Anzeige beim
// ersten Download springen oder schneidet sie ab. Gerechnet wird mit
// dem LAENGSTEN Text, den die Formatierung unten erzeugen kann
// ("1023,9 MiB/s", zwoelf Zeichen), und nicht mit dem, der gerade
// dasteht.
// GERECHNET, NICHT GESCHAETZT, und die Summe MUSS 428 sein.
//
// Die Tafeln stehen in der rechten Spalte: 760 - 300 = 460 Bildpunkte,
// minus zweimal 16 Einzug sind 428. Eine Tafel, deren Spalten zusammen
// breiter sind, schneidet ihre LETZTE Spalte ab -- und das ist hier die
// interessanteste (der Verbrauch bzw. das Programm).
//
// Beim ersten Anlauf standen hier 170+95+95+95 = 455 und
// 55+125+145+95+105 = 525. Beides zu breit, beides im Quelltext nicht
// zu sehen; `tools/netzui/run.sh` Abschnitt 7 rechnet es jetzt nach.
//
// Die Breiten tragen den laengsten Inhalt, den die Formatierung
// erzeugen kann (7,66 Bildpunkte je Zeichen, gemessen an `wlib: text
// ... tw=`):
//   "1023,9 GiB"            77 Punkte -> 94 reichen
//   "192.168.100.100:65535" 161 Punkte -> 162 reichen
//   ein Programmname (23)   176 Punkte -> die Namensspalte ist 146,
//                           laengere Namen kuerzt die Tafel selbst ab
// ROUND ACTION-BUS-3: COLUMN WIDTHS ARE u64, NOT TEXT. `wlib.table` reads
// its fourth argument as an array of u64 (wlib.column_wide); these two
// were strings, so every column was eight ASCII digits read as a number
// -- the first paint of a filled table overflowed (found with the two new
// tables, which crashed the window the same way). Filled in `widths_init`.
static mut c_nprog: [u64; 4] = [0 as u64; 4]
// Die Verbindungstafel hat VIER Spalten und nicht fuenf: fuer Art,
// beide Enden UND Programm UND Verbrauch reichen 428 Punkte nicht, ohne
// dass die Adressen abgeschnitten werden. Der Verbrauch je Verbindung
// steht in `/bin/netstat -p`; was diese Seite beantwortet, ist "wer
// redet gerade mit wem".
static mut c_nconn: [u64; 4] = [0 as u64; 4]

// DIE ABTASTUNG DES DURCHSATZES.
//
// Die Karte zaehlt OKTETTE, absolut und monoton steigend (NG_CARDTX,
// NG_CARDRX). Eine RATE entsteht daraus erst, wenn man zweimal liest
// und die Differenz durch die verstrichene Zeit teilt -- genau so, wie
// `/proc/net/dev` unter Linux gelesen wird. Diese vier Zahlen sind das
// Gedaechtnis dafuer.
static mut n_vor_tx: u64 = 0
static mut n_vor_rx: u64 = 0
static mut n_vor_t: u64 = 0 // in Ticks
static mut n_hat_vor: u64 = 0 // 0 = noch nie gemessen

// DIE GLAETTUNG. Vier Abtastungen im gleitenden Mittel.
//
// WARUM UEBERHAUPT GEGLAETTET WIRD: die Rohrate springt zwischen zwei
// Sekunden um ein Vielfaches, weil TCP in Schueben faehrt. Eine Anzeige,
// die diesen Schueben folgt, ist nicht praeziser -- sie ist nur
// unlesbar, und man kann ihr nicht ansehen, ob gerade 2 oder 20 MiB/s
// fliessen. Windows glaettet ueber rund zwei Sekunden, GNOME ueber
// etwa vier.
//
// WARUM NUR VIER UND NICHT SECHZEHN: ein langes Fenster laesst die
// Anzeige nach dem Ende eines Downloads noch sekundenlang einen
// Durchsatz zeigen, den es nicht mehr gibt. Vier Abtastungen zu einer
// Sekunde sind der Ausgleich -- ruhig genug zum Lesen, und nach vier
// Sekunden wieder ehrlich bei null.
