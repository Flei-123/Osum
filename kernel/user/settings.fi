// AB-005c: controls of the pages Bildschirm and Netz that gui.sh clicks
static mut ds_ch: u64 = 0
static mut ds_b2: u64 = 0
static mut nz_cn: u64 = 0
static mut nz_b4: u64 = 0
static mut nz_b4j: u64 = 0
static mut tb_id: u64 = 0
static mut sy_pkey: [u8; 40] = [0 as u8; 40]
static mut sy_stat: u64 = 0
