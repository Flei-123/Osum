// ==================================================== RUNDE GLAS
//
// VIER REGLER FUER VIER ZAHLEN, und kein fuenfter Ort, an dem sie
// stehen. Was diese vier Widgets verstellen, ist dasselbe, was in
// /etc/theme.conf steht und was `wlibc.radius()`, `wlibc.tb_alpha()`,
// `wlibc.win_alpha()` und `wlibc.tb_blur()` lesen -- die Regler sind
// nur die Hand am Wert, nicht seine Wohnung.
//
// Die Beschriftung steht IM Regler (`wlib.set_text` auf einem
// K_SLIDER) und nicht in einer eigenen Zeile darueber: der Regler malt
// seine Beschriftung links und die abgelesene Zahl rechts, und damit
// kostet eine Einstellung EINE Zeile statt zwei. Das ist hier keine
// Feinheit, sondern die Bedingung dafuer, dass die Seite weiter
// vollstaendig ins Fenster passt (Abschnitt 8 der Abnahme).
static mut k_g_rad: [u8; 23] = "settings.glass.radius\0\0"
static mut k_g_tba: [u8; 25] = "settings.glass.tbalpha\0\0\0"
static mut k_g_wa: [u8; 26] = "settings.glass.winalpha\0\0\0"
static mut k_g_blur: [u8; 21] = "settings.glass.blur\0\0"
// W-S: the master switch for all transparency effects (off / subtle / strong), one choice on the page Darstellung.
static mut k_c_trn: [u8; 24] = "settings.transp.choices\0"
static mut sl_rad: u64 = 0
static mut sl_tba: u64 = 0
static mut sl_wa: u64 = 0
static mut sl_blur: u64 = 0

// ============================================ RUNDE BELEG: DER MESSAUSGANG
// STEHT IM NORMALBETRIEB AUS.
//
// Justins Befund am Abbild vom 12.09.2026: im Terminalfenster standen
// Zeilen wie `explorer: krumm n=2 fold=0` und `bg=...`. Gezaehlt hat er
// auch: 160 `ulib.say` in taskbar.fi, 38 in explorer.fi.
//
// Die Regel dazu steht seit Runde LAUFZEIT in taskmgr.fi:
//
//   EIN MESSAUSGANG GEHOERT HINTER EINEN SCHALTER, UND DER SCHALTER
//   STEHT IM NORMALBETRIEB AUS. Ein Programm, das im Auslieferungs-
//   zustand misst, misst vor allem sich selbst.
//
// NICHT GELOESCHT, SONDERN GESCHALTET. Die Zaehler (`fui=`, `fuix=`,
// `rect id=`, `text ... base=`) waren mehrfach der Schluessel zur
// Fehlersuche -- sie muessen fuer die Abnahme da sein. Also EIN Schalter
// statt zweihundert geloeschter Zeilen.
//
// ZWEI WEGE, IHN EINZUSCHALTEN, und beide gab es schon:
//   /etc/uitrace   die Datei, mit der `wlib` seit Runde LOOK dasselbe
//                  tut -- die Pruefstaende legen sie ohnehin an
//   `debug`        als Wort auf der Programmzeile, fuer den Fall, dass
//                  einer allein gestartet wird
//
// OHNE BEIDES AENDERT SICH KEIN OKTETT gegenueber vorher -- das ist die
// Bedingung dafuer, dass kein bestehender Testlaeufer davon etwas merkt.
static mut s_dbg: u64 = 0
static mut start_page: u64 = 0

// Die drei Ausgaenge dieses Programms, an EINER Stelle geschaltet.
// `sayn` und `nl` stehen hier, damit kein Aufrufer `ulib.` direkt
// nimmt und damit am Schalter vorbeigeht.
fn dbg_on() -> bool {
    return s_dbg != 0
}

fn dbg_setup(args: u64) {
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_dbg = 1
    }
    var a_dbg: [u8; 6] = "debug\0"
    let argc: u64 = ulib.arg_count(args)
    var ai: u64 = 1
    while ai < argc {
        let a: u64 = ulib.arg_at(args, ai)
        if ulib.streq(a, (&a_dbg[0 as usize]) as u64) {
            s_dbg = 1
        }
        // ROUND ACTION-BUS-3: `settings page=12` opens on that page --
        // what a notification "an app wants a right" links to
        if rb(a, 0) == 112 && rb(a, 1) == 97 && rb(a, 2) == 103
            && rb(a, 3) == 101 && rb(a, 4) == 61 {
            let pg: u64 = ulib.to_num(a + 5)
            if pg < R_ANZ {
                start_page = pg
            }
        }
        ai = ai + 1
    }
}

fn say(p: u64) {
    if s_dbg == 0 {
        return
    }
    ulib.say(p)
}

fn sayn(v: u64) {
    if s_dbg == 0 {
        return
    }
    ulib.sayn(v)
}

fn nl() {
    if s_dbg == 0 {
        return
    }
    ulib.nl()
}

// ==================== ADDENDUM TASKBAR: /etc/taskbar.conf, THE READER
// AND THE WRITER ====================================================
//
// The very same five keys the bar itself reads and writes
// (kernel/user/taskbar.fi). They are parsed here a second time and not
// shared through a library, for the reason every other duplicated
// constant in this tree carries: ring 3 programs in this system do not
// link against each other, they agree on a FILE FORMAT. Five keys, one
// line each, values in words for the edge and in digits for the rest.
static mut tb_edge: u64 = 0
static mut tb_height: u64 = 28
static mut tb_width: u64 = 104
static mut tb_autohide: u64 = 0
static mut tb_ontop: u64 = 1
static mut tb_align: u64 = 0
static mut tb_buf: [u8; 1024] = [0 as u8; 1024]
static mut tb_old: [u8; 1024] = [0 as u8; 1024]

static mut tk_edge: [u8; 5] = "edge\0"
static mut tk_height: [u8; 7] = "height\0"
static mut tk_width: [u8; 6] = "width\0"
static mut tk_ah: [u8; 9] = "autohide\0"
static mut tk_ot: [u8; 6] = "ontop\0"
static mut tk_al: [u8; 6] = "align\0"
static mut tv_left: [u8; 5] = "left\0"
static mut tv_center: [u8; 7] = "center\0"
static mut tb_head: [u8; 60] = "# taskbar.conf -- written by /bin/taskbar and /bin/settings\0"

fn tb_key_is(p: u64, n: u64, k: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if __mmio_read8((k + i) as *mut u8) == 0 as u8 {
            return false
        }
        if __mmio_read8((p + i) as *mut u8)
            != __mmio_read8((k + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return __mmio_read8((k + n) as *mut u8) == 0 as u8
}

fn tb_clamp(v: u64, lo: u64, hi: u64) -> u64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn tb_vertical() -> bool {
    return tb_edge >= 2
}

fn tb_read() {
    var word: [u8; 24] = [0 as u8; 24]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_tbconf[0 as usize]) as u64,
        0, 0)
    if ulib.bad(fd) {
        tb_show_size()
        return
    }
    let b: u64 = (&tb_buf[0 as usize]) as u64
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, b, 255)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        tb_show_size()
        return
    }
    var i: u64 = 0
    while i < n {
        let ks: u64 = i
        var ke: u64 = i
        while ke < n && __mmio_read8((b + ke) as *mut u8) != 61 as u8
            && __mmio_read8((b + ke) as *mut u8) != 10 as u8 {
            ke = ke + 1
        }
        if ke < n && __mmio_read8((b + ke) as *mut u8) == 61 as u8 {
            let vs: u64 = ke + 1
            var ve: u64 = vs
            while ve < n && __mmio_read8((b + ve) as *mut u8) != 10 as u8
                && __mmio_read8((b + ve) as *mut u8) != 13 as u8 {
                ve = ve + 1
            }
            let wp: u64 = (&word[0 as usize]) as u64
            var k: u64 = 0
            var v: u64 = 0
            var digits: u64 = 0
            while vs + k < ve && k < 23 {
                let c: u64 = __mmio_read8((b + vs + k) as *mut u8) as u64
                __mmio_write8((wp + k) as *mut u8, c as u8)
                if c >= 48 && c <= 57 {
                    v = v * 10 + (c - 48)
                    digits = digits + 1
                }
                k = k + 1
            }
            __mmio_write8((wp + k) as *mut u8, 0 as u8)
            let kl: u64 = ke - ks
            if tb_key_is(b + ks, kl, (&tk_edge[0 as usize]) as u64) {
                let e: u64 = wlibc.edge_by_name(wp)
                if e < 4 {
                    tb_edge = e
                }
            } else if tb_key_is(b + ks, kl, (&tk_height[0 as usize]) as u64) {
                if digits > 0 {
                    tb_height = tb_clamp(v, 20, 40)
                }
            } else if tb_key_is(b + ks, kl, (&tk_width[0 as usize]) as u64) {
                if digits > 0 {
                    tb_width = tb_clamp(v, 56, 128)
                }
            } else if tb_key_is(b + ks, kl, (&tk_ah[0 as usize]) as u64) {
                if digits > 0 {
                    tb_autohide = v & 1
                }
            } else if tb_key_is(b + ks, kl, (&tk_ot[0 as usize]) as u64) {
                if digits > 0 {
                    tb_ontop = v & 1
                }
            } else if tb_key_is(b + ks, kl, (&tk_al[0 as usize]) as u64) {
                tb_align = 0
                if __mmio_read8((wp) as *mut u8) == 99 as u8 {
                    tb_align = 1
                }
            }
            i = ve + 1
        } else {
            i = ke + 1
        }
    }
    tb_show_size()
}

// ONE ENTRY FIELD FOR TWO NUMBERS, and it is not a shortcut: a
// horizontal bar and a vertical one have different thicknesses (28 is a
// good height and a useless width), so the file keeps both. The field
// shows the one that belongs to the edge currently chosen, and writing
// it changes only that one -- the other keeps its value.
fn tb_show_size() {
    let p: u64 = (&e_tbs[0 as usize]) as u64
    if tb_vertical() {
        let _a: u64 = num_at(p, 0, tb_width)
    } else {
        let _a: u64 = num_at(p, 0, tb_height)
    }
}

fn tb_set_size(p: u64) {
    var v: u64 = 0
    var digits: u64 = 0
    var i: u64 = 0
    while __mmio_read8((p + i) as *mut u8) != 0 as u8 && i < 8 {
        let c: u64 = __mmio_read8((p + i) as *mut u8) as u64
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
            digits = digits + 1
        }
        i = i + 1
    }
    if digits == 0 {
        return
    }
    if tb_vertical() {
        tb_width = tb_clamp(v, 56, 128)
    } else {
        tb_height = tb_clamp(v, 20, 40)
    }
}

fn tb_write() -> bool {
    let b: u64 = (&tb_buf[0 as usize]) as u64
    var at: u64 = text_an(b, 0, (&tb_head[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = text_an(b, at + 1, (&tk_edge[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    at = text_an(b, at + 1, wlibc.edge_name(tb_edge))
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = text_an(b, at + 1, (&tk_height[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    at = num_at(b, at + 1, tb_height)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = text_an(b, at + 1, (&tk_width[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    at = num_at(b, at + 1, tb_width)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = text_an(b, at + 1, (&tk_ah[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    at = num_at(b, at + 1, tb_autohide)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = text_an(b, at + 1, (&tk_ot[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    at = num_at(b, at + 1, tb_ontop)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = text_an(b, at + 1, (&tk_al[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    var alp: u64 = (&tv_left[0 as usize]) as u64
    if tb_align == 1 {
        alp = (&tv_center[0 as usize]) as u64
    }
    at = text_an(b, at + 1, alp)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    at = tb_keep(b, at)
    return file_write((&p_tbconf[0 as usize]) as u64, b, at)
}

// r387: WHAT SETTINGS DOES NOT OWN STAYS IN THE FILE. This writer used to
// write its six keys and nothing else -- one change of the edge or the height
// threw away the pinned programs, the labels, the clock and tray keys and every
// key of the Windows 11 layout. The lines of the old file whose key is not one
// of the six are copied behind them.
fn tb_keep(b: u64, at0: u64) -> u64 {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_tbconf[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return at0
    }
    let o: u64 = (&tb_old[0 as usize]) as u64
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, o, 1023)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return at0
    }
    var at: u64 = at0
    var i: u64 = 0
    while i < n {
        var le: u64 = i
        while le < n && __mmio_read8((o + le) as *mut u8) != 10 as u8 {
            le = le + 1
        }
        var ke: u64 = i
        while ke < le && __mmio_read8((o + ke) as *mut u8) != 61 as u8 {
            ke = ke + 1
        }
        if ke < le && __mmio_read8((o + i) as *mut u8) != 35 as u8 {
            let kl: u64 = ke - i
            let own: bool = tb_key_is(o + i, kl, (&tk_edge[0 as usize]) as u64)
                || tb_key_is(o + i, kl, (&tk_height[0 as usize]) as u64)
                || tb_key_is(o + i, kl, (&tk_width[0 as usize]) as u64)
                || tb_key_is(o + i, kl, (&tk_ah[0 as usize]) as u64)
                || tb_key_is(o + i, kl, (&tk_ot[0 as usize]) as u64)
                || tb_key_is(o + i, kl, (&tk_al[0 as usize]) as u64)
            if !own && at + (le - i) + 2 < 1000 {
                var k: u64 = i
                while k < le {
                    __mmio_write8((b + at) as *mut u8,
                        __mmio_read8((o + k) as *mut u8))
                    at = at + 1
                    k = k + 1
                }
                __mmio_write8((b + at) as *mut u8, 10 as u8)
                at = at + 1
            }
        }
        i = le + 1
    }
    return at
}

static mut ts_a: [u8; 24] = "settings: taskbar edge=\0"
static mut ts_b: [u8; 9] = " height=\0"
static mut ts_c: [u8; 8] = " width=\0"
static mut ts_d: [u8; 11] = " autohide=\0"
static mut ts_e: [u8; 8] = " ontop=\0"
static mut ts_f: [u8; 8] = " wrote=\0"
static mut ts_g: [u8; 8] = " align=\0"

// ROUND LOOK: WHICH FORM SET IS RUNNING, and how many of its keys were
// understood. Zero keys and no file used to look the same from
// outside; this line is what makes them different.
fn shape_say() {
    var a: [u8; 22] = "settings: shape file=\0"
    var b: [u8; 7] = " name=\0"
    var c: [u8; 6] = " id=\0\0"
    var d: [u8; 7] = " keys=\0"
    var e: [u8; 9] = " ctrl_h=\0"
    var f: [u8; 10] = " radiusb=\0"
    var g2: [u8; 9] = " shadow=\0"
    var h: [u8; 10] = " divider=\0"
    var i2: [u8; 7] = " gap=\0\0"
    var j: [u8; 7] = " row=\0\0"
    var k: [u8; 8] = " padx=\0\0"
    var l: [u8; 9] = " aapx=\0\0\0"
    var m: [u8; 6] = " bad=\0"
    say((&a[0 as usize]) as u64)
    say(wlibc.shape_file())
    say((&b[0 as usize]) as u64)
    say(wlibc.shape_name())
    say((&c[0 as usize]) as u64)
    sayn(wlibc.shape_id())
    say((&d[0 as usize]) as u64)
    sayn(wlibc.shape_keys())
    say((&e[0 as usize]) as u64)
    sayn(wlibc.metric(wlibc.M_CTRL_H))
    say((&f[0 as usize]) as u64)
    sayn(wlibc.metric(wlibc.M_RADIUS_BUTTON))
    say((&g2[0 as usize]) as u64)
    sayn(wlibc.metric(wlibc.M_SHADOW))
    say((&h[0 as usize]) as u64)
    sayn(wlibc.metric(wlibc.M_DIVIDER))
    say((&i2[0 as usize]) as u64)
    sayn(wlibc.metric(wlibc.M_GAP))
    say((&j[0 as usize]) as u64)
    sayn(wlibc.metric(wlibc.M_ROW))
    say((&k[0 as usize]) as u64)
    sayn(wlibc.metric(wlibc.M_PAD_X))
    say((&l[0 as usize]) as u64)
    sayn(wlibc.aa_pixels())
    // r545: the count the Settings window shows as "lines not understood"
    say((&m[0 as usize]) as u64)
    sayn(wlibc.theme_bad_keys())
    nl()
}

// RUNDE GLAS: WAS DIE VIER REGLER GERADE ZEIGEN -- und zwar aus
// `wlibc` gelesen und nicht aus dem Widget. Die Abnahme prueft an
// dieser Zeile zweierlei: dass die Reglerstellung und die laufende
// Darstellung dasselbe sagen, und dass eine Aenderung wirklich
// ankommt, ohne dass jemand neu gestartet hat.
fn glas_say() {
    var a: [u8; 24] = "settings: glas radius=\0\0"
    var b: [u8; 6] = " tba=\0"
    var c: [u8; 5] = " wa=\0"
    var d: [u8; 7] = " blur=\0"
    var e: [u8; 6] = " ist=\0"
    say((&a[0 as usize]) as u64)
    sayn(wlibc.radius())
    say((&b[0 as usize]) as u64)
    sayn(wlibc.tb_alpha())
    say((&c[0 as usize]) as u64)
    sayn(wlibc.win_alpha())
    say((&d[0 as usize]) as u64)
    sayn(wlibc.tb_blur())
    // RUNDE GLAS (NACHTRAG): und was davon WIRKLICH gemalt wird.
    // Steht hier eine groessere Zahl als bei `tba=`, hat die
    // Lesbarkeitsschranke des Fensterservers angehoben -- siehe
    // `tba_wirksam`.
    say((&e[0 as usize]) as u64)
    sayn(tba_wirksam())
    nl()
}

// ================================================ RUNDE GLAS (NACHTRAG)
//
// DER SCHLEIER WIRD SICHTBAR GEMACHT, STATT STILL ZU UEBERSCHREIBEN.
//
// Der Regler setzt `taskbar_alpha`; ueber einem Hintergrundbild, das
// der Leistenfarbe fern ist, hebt `wm.glass_mix` das Alpha wieder an,
// damit die Leistenschrift ihre 4,5:1 behaelt. GEMESSEN: Regler auf
// 40 Prozent ueber dem dunklen Musterbild -- gemalt wurden 83. Eine
// Aufnahme, die "Leiste bei 40 %" heisst und 83 zeigt, belegt nichts,
// und ein Regler, der 40 sagt und 83 bewirkt, ist eine Luege in der
// Oberflaeche. Also wird die wirksame Zahl gefragt (der Server fuehrt
// sie dort, wo er mischt) und neben den Regler geschrieben.
static mut tba_lbl: [u8; 80] = [0 as u8; 80]
static mut tba_zu: [u8; 10] = " (wirkt \0\0"
static mut tba_zu2: [u8; 2] = ")\0"

fn tba_wirksam() -> u64 {
    let h: u64 = fuiscene.handle()
    if h == 0 {
        return wlibc.tb_alpha()
    }
    let v: u64 = wlibc.win_info(h, wlibc.WI_TB_ALPHA_IST)
    if ulib.bad(v) || v == 0 || v > 100 {
        return wlibc.tb_alpha()
    }
    return v
}

// Die Beschriftung des Reglers: der Text aus der Sprachdatei, und
// dahinter -- NUR wenn der Server wirklich angehoben hat -- die
// wirksame Zahl. Zusammengesetzt mit denselben zwei Helfern, die die
// Rechteckzeile baut, damit es keine zweite Zahlenausgabe gibt.
static mut tba_bereit: u64 = 0
// Die wirksame Zahl, die zuletzt NEBEN dem Regler stand.
static mut tba_gez: u64 = 0

fn tba_label_setz() {
    if tba_bereit == 0 {
        return
    }
    let p: u64 = msg.get((&k_g_tba[0 as usize]) as u64)
    var at: u64 = rs_put(0, p)
    let ist: u64 = tba_wirksam()
    if ist > wlibc.tb_alpha() {
        at = rs_put(at, (&tba_zu[0 as usize]) as u64)
        at = rs_num(at, ist)
        at = rs_put(at, (&tba_zu2[0 as usize]) as u64)
    }
    let b: u64 = (&rs_buf[0 as usize]) as u64
    let z: u64 = (&tba_lbl[0 as usize]) as u64
    var i: u64 = 0
    while i < at && i < 79 {
        __mmio_write8((z + i) as *mut u8, __mmio_read8((b + i) as *mut u8))
        i = i + 1
    }
    __mmio_write8((z + i) as *mut u8, 0 as u8)
    fuiscene.refresh()
}

fn tb_say() {
    say((&ts_a[0 as usize]) as u64)
    say(wlibc.edge_name(tb_edge))
    say((&ts_b[0 as usize]) as u64)
    sayn(tb_height)
    say((&ts_c[0 as usize]) as u64)
    sayn(tb_width)
    say((&ts_d[0 as usize]) as u64)
    sayn(tb_autohide)
    say((&ts_g[0 as usize]) as u64)
    sayn(tb_align)
    say((&ts_e[0 as usize]) as u64)
    sayn(tb_ontop)
    say((&ts_f[0 as usize]) as u64)
    sayn(geschrieben)
    nl()
}

// (the element table of the old toolkit is gone: the page builders describe
// the window again whenever something changed)

// ====================================================== RUNDE 32
// WIE VIELE FLAECHEN DIESES FENSTERS VON fUi KOMMEN.
//
// Justin: "Der fui/fuix-Zaehler pro Ansicht, nicht nur fuer die Leiste.
// 97,8 % in der Taskleiste ist gut, ich will die Zahl fuer die anderen
// Fenster."
//
// Die Zaehler in fuib sind `static`, also PRO PROZESS -- die Zahl der
// Taskleiste sagt nichts ueber dieses Fenster. Also meldet es sie
// selbst, in derselben Form.
fn report_fui() {
    var s_f: [u8; 18] = "settings: fui ok=\0"
    var s_x: [u8; 5] = " no=\0"
    var s_g: [u8; 8] = " grund=\0"
    var at: u64 = rs_put(0, (&s_f[0 as usize]) as u64)
    at = rs_num(at, fuib.fui_painted())
    at = rs_put(at, (&s_x[0 as usize]) as u64)
    at = rs_num(at, fuib.fui_rejected())
    at = rs_put(at, (&s_g[0 as usize]) as u64)
    at = rs_num(at, fuib.fui_reasons())
    let b: u64 = (&rs_buf[0 as usize]) as u64
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(b, at)
}

// WIE VOLL DIE TAFEL IST -- eine eigene Zeile, damit keine bestehende
// Abnahme sich an einer laengeren gewohnten Zeile verschluckt.
fn melde_elemente() {
    var s_n: [u8; 22] = "settings: elemente n=\0"
    var s_m: [u8; 6] = " max=\0"
    var at: u64 = rs_put(0, (&s_n[0 as usize]) as u64)
    at = rs_num(at, nid)
    at = rs_put(at, (&s_m[0 as usize]) as u64)
    at = rs_num(at, 192)
    let b: u64 = (&rs_buf[0 as usize]) as u64
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(b, at)
}

fn text_an(p: u64, at: u64, q: u64) -> u64 {
    var k: u64 = 0
    while __mmio_read8((q + k) as *mut u8) != 0 as u8 {
        __mmio_write8((p + at + k) as *mut u8,
            __mmio_read8((q + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((p + at + k) as *mut u8, 0 as u8)
    return at + k
}

// Text -> Zahl. Es gibt hier bisher nur den Weg Zahl -> Text; Runde
// SYNC liest `/konto/ZAEHLER`, und das ist eine Zeile mit einer Zahl.
fn num_from(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while __mmio_read8((p + i) as *mut u8) >= 48 as u8
        && __mmio_read8((p + i) as *mut u8) <= 57 as u8 {
        v = v * 10 + ((__mmio_read8((p + i) as *mut u8) as u64) - 48)
        i = i + 1
    }
    return v
}

fn num_at(p: u64, at: u64, v: u64) -> u64 {
    if v == 0 {
        __mmio_write8((p + at) as *mut u8, 48 as u8)
        __mmio_write8((p + at + 1) as *mut u8, 0 as u8)
        return at + 1
    }
    var stellen: u64 = 0
    var t: u64 = v
    while t > 0 {
        stellen = stellen + 1
        t = t / 10
    }
    var k: u64 = stellen
    t = v
    while k > 0 {
        k = k - 1
        __mmio_write8((p + at + k) as *mut u8, (48 + (t % 10)) as u8)
        t = t / 10
    }
    __mmio_write8((p + at + stellen) as *mut u8, 0 as u8)
    return at + stellen
}

fn two_on(p: u64, at: u64, v: u64) -> u64 {
    __mmio_write8((p + at) as *mut u8, (48 + ((v / 10) % 10)) as u8)
    __mmio_write8((p + at + 1) as *mut u8, (48 + (v % 10)) as u8)
    __mmio_write8((p + at + 2) as *mut u8, 0 as u8)
    return at + 2
}

// Eine Adresse als vier Zahlen. `punkt` ist der Trenner, damit die
// Zeichenkette nur an einer Stelle gebaut wird.
fn ip_an(p: u64, at: u64, v: u64) -> u64 {
    var pt: [u8; 2] = ".\0"
    var a: u64 = num_at(p, at, (v >> 24) & 255)
    a = text_an(p, a, (&pt[0 as usize]) as u64)
    a = num_at(p, a, (v >> 16) & 255)
    a = text_an(p, a, (&pt[0 as usize]) as u64)
    a = num_at(p, a, (v >> 8) & 255)
    a = text_an(p, a, (&pt[0 as usize]) as u64)
    return num_at(p, a, v & 255)
}

// ================================================== RUNDE O-NETZUI
// DIE RECHNUNG HINTER DER ANZEIGE.
//
// Alles, was diese Seite an Zahlen zeigt, entsteht in den Funktionen
// unter diesem Kopf. Sie stehen absichtlich zusammen und nicht verteilt:
// `tools/netzui/run.sh` prueft genau sie, und ein Pruefstand, der ueber
// eine Datei verstreute Rechnungen einsammeln muss, prueft am Ende die
// Rechnung nicht mehr.

// EINE ZAHL MIT EINER NACHKOMMASTELLE, ohne Gleitkomma.
//
// Firn hat `f64`, und dieses Programm benutzt es nicht: `v / t` mit
// ganzen Zahlen ist exakt und `(v * 10 / t) % 10` ist die erste
// Nachkommastelle davon. Eine Gleitkommadivision fuer eine Anzeige mit
// einer Stelle waere die teurere Art, dasselbe Ergebnis zu bekommen.
fn zehntel_an(p: u64, at: u64, ganz: u64, zehntel: u64) -> u64 {
    var komma: [u8; 2] = ",\0"
    var a: u64 = num_at(p, at, ganz)
    a = text_an(p, a, (&komma[0 as usize]) as u64)
    return num_at(p, a, zehntel)
}

// OKTETTE JE SEKUNDE, in der Einheit, die ein Mensch liest.
//
// DIE EINHEIT WECHSELT MIT DER ZAHL, und die Grenze liegt bei 1024 und
// nicht bei 1000: was hier gezaehlt wird, sind Oktette, und Oktette
// zaehlt dieses System binaer -- KiB, MiB, GiB, wie `ls` und `df`
// desselben Baums. Das ist auch die Einheit, in der Linux' `ip -s link`
// und GNOMEs Netzwerkanzeige rechnen.
//
// UNTER 1024 GIBT ES KEINE NACHKOMMASTELLE: "512 B/s" ist genauer als
// "512,0 B/s" behauptet, und eine Stelle hinter dem Komma bei einer
// Zahl, die ohnehin auf das Oktett genau ist, ist Ziffernrauschen.
//
// DER LAENGSTE TEXT, DEN DIESE FUNKTION ERZEUGEN KANN, ist
// "1023,9 GiB/s" -- zwoelf Zeichen. Danach sind die Spalten oben
// bemessen. Das ist kein Schoenheitsmass: eine Spalte, die nur fuer
// "9 KiB/s" reicht, schneidet beim ersten Download ab.
fn rate_an(p: u64, at: u64, v: u64) -> u64 {
    var e_b: [u8; 5] = " B/s\0"
    var e_k: [u8; 7] = " KiB/s\0"
    var e_m: [u8; 7] = " MiB/s\0"
    var e_g: [u8; 7] = " GiB/s\0"
    if v < 1024 {
        let a: u64 = num_at(p, at, v)
        return text_an(p, a, (&e_b[0 as usize]) as u64)
    }
    if v < 1024 * 1024 {
        let a: u64 = zehntel_an(p, at, v / 1024, (v * 10 / 1024) % 10)
        return text_an(p, a, (&e_k[0 as usize]) as u64)
    }
    if v < 1024 * 1024 * 1024 {
        // DIE ZEHNTELSTELLE IN EINER DIVISION UND NICHT IN ZWEIEN.
        //
        // Hier stand `(v / 1024 * 10 / 1024) % 10`, und das ist in
        // rund vier von tausend Faellen um eins zu klein: die erste
        // Division schneidet ab, und was sie abschneidet, fehlt der
        // zweiten. Gemessen an 200 000 Zufallswerten: 780 Abweichungen,
        // alle um genau eine Zehntelstelle nach unten. Aufgefallen ist
        // es `tools/netzui/run.sh` an 13002343 Oktetten, die als
        // "12,3 MiB/s" herauskamen und 12,4 sind.
        //
        // `v * 10` laeuft nicht ueber: u64 traegt bis 1,8e18, und das
        // sind Exaoktette je Sekunde.
        let g: u64 = v / (1024 * 1024)
        let z: u64 = (v * 10 / (1024 * 1024)) % 10
        let a: u64 = zehntel_an(p, at, g, z)
        return text_an(p, a, (&e_m[0 as usize]) as u64)
    }
    // Dieselbe Berichtigung wie eine Stufe darueber.
    let g2: u64 = v / (1024 * 1024 * 1024)
    let z2: u64 = (v * 10 / (1024 * 1024 * 1024)) % 10
    let a2: u64 = zehntel_an(p, at, g2, z2)
    return text_an(p, a2, (&e_g[0 as usize]) as u64)
}

// DIESELBE EINHEITENSTAFFEL FUER EINE SUMME statt einer Rate -- ohne
// das "/s". Das ist die Spalte "insgesamt" und die Zeile unter den
// beiden Durchsatzzahlen.
fn menge_an(p: u64, at: u64, v: u64) -> u64 {
    var e_b: [u8; 3] = " B\0"
    var e_k: [u8; 5] = " KiB\0"
    var e_m: [u8; 5] = " MiB\0"
    var e_g: [u8; 5] = " GiB\0"
    if v < 1024 {
        let a: u64 = num_at(p, at, v)
        return text_an(p, a, (&e_b[0 as usize]) as u64)
    }
    if v < 1024 * 1024 {
        let a: u64 = zehntel_an(p, at, v / 1024, (v * 10 / 1024) % 10)
        return text_an(p, a, (&e_k[0 as usize]) as u64)
    }
    if v < 1024 * 1024 * 1024 {
        let a: u64 = zehntel_an(p, at, v / (1024 * 1024),
            (v * 10 / (1024 * 1024)) % 10)
        return text_an(p, a, (&e_m[0 as usize]) as u64)
    }
    let a2: u64 = zehntel_an(p, at, v / (1024 * 1024 * 1024),
        (v * 10 / (1024 * 1024 * 1024)) % 10)
    return text_an(p, a2, (&e_g[0 as usize]) as u64)
}

// DIE AUSGEHANDELTE VERBINDUNGSRATE ALS TEXT. 0 heisst UNBEKANNT, und
// dann steht das WORT da und keine Zahl -- das ist die eine Stelle
// dieser Runde, an der am meisten zu gewinnen waere, wenn man schummelte,
// und genau deshalb steht es hier so ausdruecklich.
//
// UEBER 1000 MBIT WIRD IN GBIT GESCHRIEBEN, weil "2,5 Gbit/s" die
// Aufschrift ist, die auf der Karte steht, und "2500 Mbit/s" nicht.
fn mbit_an(p: u64, at: u64, v: u64) -> u64 {
    var e_m: [u8; 8] = " Mbit/s\0"
    var e_g: [u8; 8] = " Gbit/s\0"
    if v == 0 {
        return text_an(p, at, msg.get((&k_n_unbek[0 as usize]) as u64))
    }
    if v < 1000 {
        let a: u64 = num_at(p, at, v)
        return text_an(p, a, (&e_m[0 as usize]) as u64)
    }
    if v % 1000 == 0 {
        let a: u64 = num_at(p, at, v / 1000)
        return text_an(p, a, (&e_g[0 as usize]) as u64)
    }
    let a2: u64 = zehntel_an(p, at, v / 1000, (v / 100) % 10)
    return text_an(p, a2, (&e_g[0 as usize]) as u64)
}

// EINE ABTASTUNG IN DAS GLEITENDE MITTEL, und das Mittel zurueck.
//
// Der Ringpuffer fuellt sich erst; solange er nicht voll ist, wird
// durch die Zahl der WIRKLICH vorhandenen Werte geteilt und nicht durch
// NGLATT. Sonst zeigte die Anzeige in den ersten drei Sekunden nach dem
// Oeffnen ein Viertel des wahren Durchsatzes -- ein Fehler, den man
// nicht sieht, weil die Zahl plausibel bleibt.
fn glatt_ein(tx: u64, rx: u64) {
    n_htx[(n_hi) as usize] = tx
    n_hrx[(n_hi) as usize] = rx
    n_hi = (n_hi + 1) % NGLATT
    if n_hn < NGLATT {
        n_hn = n_hn + 1
    }
}

fn glatt_tx() -> u64 {
    if n_hn == 0 {
        return 0
    }
    var sum: u64 = 0
    var i: u64 = 0
    while i < n_hn {
        sum = sum + n_htx[(i) as usize]
        i = i + 1
    }
    return sum / n_hn
}

fn glatt_rx() -> u64 {
    if n_hn == 0 {
        return 0
    }
    var sum: u64 = 0
    var i: u64 = 0
    while i < n_hn {
        sum = sum + n_hrx[(i) as usize]
        i = i + 1
    }
    return sum / n_hn
}

// DIE RATE AUS ZWEI ABSOLUTEN ZAEHLERSTAENDEN.
//
// `alt` und `neu` sind Oktette, `dt` sind Ticks zu 10 ms (100 Hz,
// `ulib.I_TICKS`). Die Rate ist Oktette je SEKUNDE, also
// (neu - alt) * 100 / dt.
//
// DREI FAELLE, DIE NULL ERGEBEN MUESSEN und nicht irgendetwas:
//   dt == 0    zweimal im selben Tick gefragt -- es ist keine Zeit
//              vergangen, also ist keine Rate messbar.
//   neu < alt  der Zaehler ist zurueckgesprungen (Karte neu aufgesetzt).
//              Eine Differenz auf u64 waere hier eine gigantische Zahl.
//   kein Vorwert  die erste Messung hat nichts, womit sie vergleichen
//              koennte.
fn rate_aus(alt: u64, neu: u64, dt: u64) -> u64 {
    if dt == 0 {
        return 0
    }
    if neu < alt {
        return 0
    }
    return (neu - alt) * 100 / dt
}

// DIE MESSUNG SELBST: die Kartenzaehler lesen, die Rate bilden, sie in
// das gleitende Mittel geben. Einmal je Sekunde aus der Hauptschleife.
fn durchsatz_mess() {
    let tx: u64 = ulib.sys(SYS_NETGET, NG_CARDTX, 0, 0)
    let rx: u64 = ulib.sys(SYS_NETGET, NG_CARDRX, 0, 0)
    let t: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    if ulib.bad(tx) || ulib.bad(rx) {
        // Kein Stapel -- keine Zahlen. Das gleitende Mittel bekommt
        // NULLEN und nicht den letzten Wert: eine Anzeige, die nach dem
        // Ziehen des Kabels den Durchsatz von vorher stehen laesst,
        // behauptet etwas ueber eine Leitung, die es nicht gibt.
        glatt_ein(0, 0)
        n_hat_vor = 0
        return
    }
    if n_hat_vor != 0 {
        let dt: u64 = t - n_vor_t
        glatt_ein(rate_aus(n_vor_tx, tx, dt), rate_aus(n_vor_rx, rx, dt))
    }
    n_vor_tx = tx
    n_vor_rx = rx
    n_vor_t = t
    n_hat_vor = 1
}

// ------------------------------------------------- die vier Zeilen oben

// DIE ZUSTANDSZEILE. Sie sagt in Worten, was `NG_STATE` in einer Zahl
// sagt, und sie sagt es in derselben Staffelung -- die vier Stufen
// stehen in `kernel/net/netview.fi` und werden hier nicht nachgerechnet.
//
// WARUM VIER WOERTER UND NICHT ZWEI: "verbunden/getrennt" waere die
// Aufteilung, die Windows in seinem alten Netzwerkstatus hatte, und sie
// wirft die zwei haeufigsten Faelle zusammen, in denen ein Mensch
// nachsieht -- Kabel steckt, aber keine Adresse (DHCP laeuft noch) und
// Adresse da, aber das Gateway antwortet nicht. Beide sehen in einer
// zweiwertigen Anzeige wie "verbunden" aus, und in beiden geht nichts.
fn zustand_zeile() {
    let d: u64 = (&l_nzust[0 as usize]) as u64
    let st: u64 = ulib.sys(SYS_NETGET, NG_STATE, 0, 0)
    var a: u64 = text_an(d, 0, msg.get((&k_n_h1[0 as usize]) as u64))
    if ulib.bad(st) || st == 0 {
        let _e: u64 = text_an(d, a, msg.get((&k_n_getr[0 as usize]) as u64))
        return
    }
    if st == 1 {
        let _e: u64 = text_an(d, a, msg.get((&k_n_noip[0 as usize]) as u64))
        return
    }
    if st == 2 {
        let _e: u64 = text_an(d, a, msg.get((&k_n_noweg[0 as usize]) as u64))
        return
    }
    let _e: u64 = text_an(d, a, msg.get((&k_n_verb[0 as usize]) as u64))
}

// DIE VERBINDUNGSRATE. Eine Zeile, und der halbe Aufwand dieser Runde
// steckt darin, dass sie die Wahrheit sagen kann.
fn rate_zeile() {
    let d: u64 = (&l_nrate[0 as usize]) as u64
    let a: u64 = text_an(d, 0, msg.get((&k_n_rate[0 as usize]) as u64))
    let v: u64 = ulib.sys(SYS_NETGET, NG_SPEED, 0, 0)
    if ulib.bad(v) {
        let _e: u64 = text_an(d, a, msg.get((&k_n_unbek[0 as usize]) as u64))
        return
    }
    let _e: u64 = mbit_an(d, a, v)
}

// DIE ZWEI DURCHSATZZEILEN und die Summe darunter.
fn durchsatz_zeilen() {
    let du: u64 = (&l_nrunter[0 as usize]) as u64
    var a: u64 = text_an(du, 0, msg.get((&k_n_ab[0 as usize]) as u64))
    let _e1: u64 = rate_an(du, a, glatt_rx())
    let uu: u64 = (&l_nrauf[0 as usize]) as u64
    a = text_an(uu, 0, msg.get((&k_n_auf[0 as usize]) as u64))
    let _e2: u64 = rate_an(uu, a, glatt_tx())
    // Die Summe seit dem Start der Maschine, aus denselben Zaehlern.
    let su: u64 = (&l_nsumme[0 as usize]) as u64
    var t: u64 = ulib.sys(SYS_NETGET, NG_CARDTX, 0, 0)
    var r: u64 = ulib.sys(SYS_NETGET, NG_CARDRX, 0, 0)
    if ulib.bad(t) {
        t = 0
    }
    if ulib.bad(r) {
        r = 0
    }
    var trenn: [u8; 4] = " / \0"
    a = text_an(su, 0, msg.get((&k_n_summe[0 as usize]) as u64))
    a = menge_an(su, a, r)
    a = text_an(su, a, (&trenn[0 as usize]) as u64)
    let _e3: u64 = menge_an(su, a, t)
}

// DIE ANTWORTZEIT ZUM GATEWAY als Text.
fn ping_zeile() {
    let d: u64 = (&l_nping[0 as usize]) as u64
    var e_ms: [u8; 4] = " ms\0"
    let a: u64 = text_an(d, 0, msg.get((&k_n_ping[0 as usize]) as u64))
    if n_ping_ms == PING_NIE {
        let _e: u64 = text_an(d, a, msg.get((&k_n_pingw[0 as usize]) as u64))
        return
    }
    if n_ping_ms == PING_WEG {
        let _e: u64 = text_an(d, a, msg.get((&k_n_pingn[0 as usize]) as u64))
        return
    }
    let b: u64 = num_at(d, a, n_ping_ms)
    let _e: u64 = text_an(d, b, (&e_ms[0 as usize]) as u64)
}

// ------------------------------------------- die Antwortzeit zum Router
//
// GEMESSEN UND NICHT GESCHAETZT, und zwar mit demselben Weg, den
// `/bin/ping` geht: ein ICMP-Echo an das Gateway ueber einen Ping-Socket
// (`libc.net.icmp_socket`, der Socket, den Linux seit 3.0 auch ohne
// Vorrechte hergibt), und die Zeit zwischen dem Absenden und der
// Antwort, aus `I_TICKS`.
//
// DIE AUFLOESUNG IST 10 MS UND DAS STEHT SO IN DER ANZEIGE. Die Uhr
// dieses Systems in Ring 3 tickt mit 100 Hz; eine Antwort in unter
// einer Zehntelsekunde kommt also als "0 ms" oder "10 ms" heraus und
// nicht als "0,4 ms". Das ist grob, und es ist die Wahrheit ueber das,
// was hier gemessen werden kann -- eine Zahl mit einer Nachkommastelle
// waere an dieser Stelle eine erfundene Genauigkeit. Dieselbe Grenze
// steht im Kopf von `kernel/user/ping.fi`.
//
// WARUM NICHT BEI JEDEM DURCHLAUF: ein Echo je Sekunde waere Verkehr,
// den diese Seite selbst erzeugt, und sie wuerde ihn in ihrer eigenen
// Durchsatzanzeige sehen. Gemessen wird alle fuenf Sekunden, und das
// sind 98 Oktette in fuenf Sekunden -- unter einem Zehntel dessen, was
// die Anzeige ueberhaupt aufloest.
//
// WARUM NICHT BLOCKIEREND GEWARTET WIRD: dieses Fenster hat eine
// Ereignisschleife, und eine Sekunde Warten auf ein Paket waere eine
// Sekunde, in der sich das Fenster nicht bewegen laesst. Gewartet wird
// hoechstens 40 Ticks (400 ms) in Schritten von 10 ms, und wer bis
// dahin nicht geantwortet hat, gilt als nicht erreichbar.
const PING_WARTE: u64 = 40 // Ticks, also 400 ms
const PING_ID: u64 = 4242

fn ping_gateway() {
    let gw: u64 = ulib.sys(SYS_NETGET, NG_GW, 0, 0)
    if ulib.bad(gw) || gw == 0 {
        n_ping_ms = PING_WEG
        return
    }
    let fd: u64 = net.icmp_socket()
    if net.failed(fd) {
        n_ping_ms = PING_WEG
        return
    }
    var m: [u8; 64] = [0 as u8; 64]
    // Ein Echo-Request: Typ 8, Code 0, Kennung, Folgenummer. Die
    // Pruefsumme setzt der Stapel, wie bei `/bin/ping` auch.
    m[(0) as usize] = 8 as u8
    m[(1) as usize] = 0 as u8
    m[(4) as usize] = ((PING_ID >> 8) & 255) as u8
    m[(5) as usize] = (PING_ID & 255) as u8
    m[(6) as usize] = 0 as u8
    m[(7) as usize] = 1 as u8
    let t0: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    let sent: u64 = net.sendto_ip(fd, (&m[0 as usize]) as u64, 16, gw, 0)
    if net.failed(sent) {
        let _c1: u64 = net.close(fd)
        n_ping_ms = PING_WEG
        return
    }
    var von: u64 = 0
    var warte: u64 = 0
    while warte < PING_WARTE {
        let got: u64 = net.recvfrom_ip(fd, (&m[0 as usize]) as u64, 64,
            (&von) as *mut u64)
        if !net.failed(got) && got > 0 {
            let t1: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
            let _c2: u64 = net.close(fd)
            // Ticks zu 10 ms -> Millisekunden.
            n_ping_ms = (t1 - t0) * 10
            return
        }
        ulib.sleep_ms(10)
        warte = warte + 1
    }
    let _c3: u64 = net.close(fd)
    n_ping_ms = PING_WEG
}

// ------------------------------------------------- Verbrauch je Programm
//
// DAS IST WINDOWS' "DATENNUTZUNG", und die Zahlen dafuer zaehlt
// `kernel/net/netmon.fi` seit Runde NETMON ohnehin schon. Diese Seite
// rechnet sie nicht nach -- sie fragt sie ab (`SYS_NETMON`, Art
// `NK_PROG`) und sortiert sie.
const NPROGZ: u64 = 24
const NSOCKZ: u64 = 16
static mut np_idx: [u64; 24] = [0 as u64; 24]
static mut np_sum: [u64; 24] = [0 as u64; 24]

fn nmq(kind: u64, index: u64, field: u64) -> u64 {
    let v: u64 = ulib.sys(ulib.SYS_NETMON, kind, index, field)
    if ulib.bad(v) {
        return 0
    }
    return v
}

// Der Name eines Programmplatzes, Oktett fuer Oktett.
fn np_name(i: u64, out: u64) {
    var k: u64 = 0
    var fertig: bool = false
    while k < 23 && !fertig {
        let c: u64 = nmq(ulib.NK_PNAME, i, k)
        __mmio_write8((out + k) as *mut u8, (c & 255) as u8)
        if c == 0 {
            fertig = true
        }
        k = k + 1
    }
    __mmio_write8((out + 23) as *mut u8, 0 as u8)
}

// ABSTEIGEND SORTIERT, und zwar mit einem Auswahlsortieren ueber
// hoechstens 24 Eintraege. Das sind im schlimmsten Fall 276 Vergleiche
// einmal je Sekunde; ein schnelleres Verfahren waere hier mehr Quelltext
// fuer eine Ersparnis, die man nicht messen kann.
//
// SORTIERT WIRD NACH DER SUMME BEIDER RICHTUNGEN, weil die Frage, die
// diese Tafel beantwortet, "wer verbraucht am meisten" lautet und nicht
// "wer laedt am meisten herunter".
fn prog_sortiere() -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < NPROGZ {
        if nmq(ulib.NK_PROG, i, ulib.NP_USED) != 0 {
            let sum: u64 = nmq(ulib.NK_PROG, i, ulib.NT_TXWIRE)
                + nmq(ulib.NK_PROG, i, ulib.NT_RXWIRE)
            if sum != 0 {
                np_idx[(n) as usize] = i
                np_sum[(n) as usize] = sum
                n = n + 1
            }
        }
        i = i + 1
    }
    var a: u64 = 0
    while a < n {
        var best: u64 = a
        var b: u64 = a + 1
        while b < n {
            if np_sum[(b) as usize] > np_sum[(best) as usize] {
                best = b
            }
            b = b + 1
        }
        if best != a {
            let ti: u64 = np_idx[(a) as usize]
            let ts: u64 = np_sum[(a) as usize]
            np_idx[(a) as usize] = np_idx[(best) as usize]
            np_sum[(a) as usize] = np_sum[(best) as usize]
            np_idx[(best) as usize] = ti
            np_sum[(best) as usize] = ts
        }
        a = a + 1
    }
    return n
}

fn prog_tafel() {
    let d: u64 = (&b_nprog[0 as usize]) as u64
    var nm: [u8; 24] = [0 as u8; 24]
    var tab: [u8; 2] = "\t\0"
    var nl2: [u8; 2] = "\n\0"
    var a: u64 = text_an(d, 0, msg.get((&k_n_kprog[0 as usize]) as u64))
    a = text_an(d, a, (&nl2[0 as usize]) as u64)
    let n: u64 = prog_sortiere()
    if n == 0 {
        a = text_an(d, a, msg.get((&k_n_leer[0 as usize]) as u64))
        let _e: u64 = text_an(d, a, (&nl2[0 as usize]) as u64)
        return
    }
    var i: u64 = 0
    // ACHT ZEILEN, weil die Tafel acht hoch ist. Mehr zu schreiben
    // kostet Puffer und zeigt nichts -- und der Puffer ist 1024 Oktette
    // gross, also wird hier gezaehlt statt gehofft.
    while i < n && i < 8 {
        let k: u64 = np_idx[(i) as usize]
        np_name(k, (&nm[0 as usize]) as u64)
        a = text_an(d, a, (&nm[0 as usize]) as u64)
        a = text_an(d, a, (&tab[0 as usize]) as u64)
        a = menge_an(d, a, nmq(ulib.NK_PROG, k, ulib.NT_RXWIRE))
        a = text_an(d, a, (&tab[0 as usize]) as u64)
        a = menge_an(d, a, nmq(ulib.NK_PROG, k, ulib.NT_TXWIRE))
        a = text_an(d, a, (&tab[0 as usize]) as u64)
        a = menge_an(d, a, np_sum[(i) as usize])
        a = text_an(d, a, (&nl2[0 as usize]) as u64)
        i = i + 1
    }
}

// ------------------------------------------------- die aktiven Verbindungen
//
// Das ist `netstat`, sichtbar gemacht: dieselbe Socket-Tafel, die
// `kernel/user/netstat.fi` druckt, nur in einem Fenster.
fn conn_tafel() {
    let d: u64 = (&b_nconn[0 as usize]) as u64
    var nm: [u8; 24] = [0 as u8; 24]
    var tab: [u8; 2] = "\t\0"
    var nl2: [u8; 2] = "\n\0"
    var t_tcp: [u8; 4] = "tcp\0"
    var t_udp: [u8; 4] = "udp\0"
    var t_icm: [u8; 5] = "icmp\0"
    var strich: [u8; 2] = "-\0"
    var dp: [u8; 2] = ":\0"
    var a: u64 = text_an(d, 0, msg.get((&k_n_kconn[0 as usize]) as u64))
    a = text_an(d, a, (&nl2[0 as usize]) as u64)
    var me: u64 = ulib.sys(SYS_NETGET, NG_IP, 0, 0)
    if ulib.bad(me) {
        me = 0
    }
    var gezeigt: u64 = 0
    var i: u64 = 0
    while i < NSOCKZ && gezeigt < 8 {
        if nmq(ulib.NK_SOCK, i, ulib.NS_USE) != 0 {
            let art: u64 = nmq(ulib.NK_SOCK, i, ulib.NS_KIND)
            if art == 1 {
                a = text_an(d, a, (&t_tcp[0 as usize]) as u64)
            } else if art == 2 {
                a = text_an(d, a, (&t_udp[0 as usize]) as u64)
            } else {
                a = text_an(d, a, (&t_icm[0 as usize]) as u64)
            }
            a = text_an(d, a, (&tab[0 as usize]) as u64)
            a = ip_an(d, a, me)
            a = text_an(d, a, (&dp[0 as usize]) as u64)
            a = num_at(d, a, nmq(ulib.NK_SOCK, i, ulib.NS_LPORT))
            a = text_an(d, a, (&tab[0 as usize]) as u64)
            let ra: u64 = nmq(ulib.NK_SOCK, i, ulib.NS_RADDR)
            if ra == 0 {
                a = text_an(d, a, (&strich[0 as usize]) as u64)
            } else {
                a = ip_an(d, a, ra)
                a = text_an(d, a, (&dp[0 as usize]) as u64)
                a = num_at(d, a, nmq(ulib.NK_SOCK, i, ulib.NS_RPORT))
            }
            a = text_an(d, a, (&tab[0 as usize]) as u64)
            // Der Besitzer: `NS_OWNER` ist der Aufgabenplatz PLUS EINS,
            // damit 0 "niemand" heissen kann.
            let ow: u64 = nmq(ulib.NK_SOCK, i, ulib.NS_OWNER)
            if ow == 0 {
                a = text_an(d, a, (&strich[0 as usize]) as u64)
            } else {
                var k: u64 = 0
                var fertig: bool = false
                while k < 23 && !fertig {
                    let c: u64 = nmq(ulib.NK_NAME, ow - 1, k)
                    nm[(k) as usize] = (c & 255) as u8
                    if c == 0 {
                        fertig = true
                    }
                    k = k + 1
                }
                nm[(23) as usize] = 0 as u8
                a = text_an(d, a, (&nm[0 as usize]) as u64)
            }
            a = text_an(d, a, (&nl2[0 as usize]) as u64)
            gezeigt = gezeigt + 1
        }
        i = i + 1
    }
    if gezeigt == 0 {
        a = text_an(d, a, msg.get((&k_n_leer[0 as usize]) as u64))
        let _e: u64 = text_an(d, a, (&nl2[0 as usize]) as u64)
    }
}

// ALLES, WAS DIE SEITE EINMAL JE SEKUNDE NEU BRAUCHT, an einer Stelle.
fn netz_live_bauen() {
    zustand_zeile()
    rate_zeile()
    durchsatz_zeilen()
    ping_zeile()
    prog_tafel()
    conn_tafel()
}

// "10.0.2.15" -> 0x0A00020F. Gibt 0, wenn es keine Adresse ist -- und
// zwar auch bei "10.0.2" und bei "10.0.2.300".
fn ip_read(p: u64) -> u64 {
    var v: u64 = 0
    var teil: u64 = 0
    var ziffern: u64 = 0
    var n: u64 = 0
    var k: u64 = 0
    var gut: bool = true
    while gut {
        let c: u64 = __mmio_read8((p + k) as *mut u8) as u64
        if c >= 48 && c <= 57 {
            teil = teil * 10 + (c - 48)
            ziffern = ziffern + 1
            if teil > 255 || ziffern > 3 {
                return 0
            }
        } else if c == 46 || c == 0 {
            if ziffern == 0 {
                return 0
            }
            v = (v << 8) | teil
            n = n + 1
            teil = 0
            ziffern = 0
            if c == 0 {
                gut = false
            }
        } else {
            return 0
        }
        k = k + 1
        if k > 20 {
            return 0
        }
    }
    if n != 4 {
        return 0
    }
    return v
}

// ---------------------------------------------------------- Dateien

fn file_read(pfad: u64, ziel: u64, max: u64) -> u64 {
    let fd: u64 = io.open(pfad, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = io.read_full(fd, ziel, max - 1)
    io.close(fd)
    if ulib.bad(n) {
        return 0
    }
    __mmio_write8((ziel + n) as *mut u8, 0 as u8)
    return n
}

fn file_write(pfad: u64, quelle: u64, n: u64) -> bool {
    let fd: u64 = io.create(pfad)
    if ulib.bad(fd) {
        return false
    }
    let g: u64 = io.write_all(fd, quelle, n)
    io.close(fd)
    if ulib.bad(g) || g < n {
        return false
    }
    geschrieben = geschrieben + 1
    return true
}

// EINE DATEI KOPIEREN, in Stuecken von 2048 Oktetten. Ein
// Hintergrundbild ist 170 Kilooktett und passt in keinen Puffer, den
// dieses Programm halten koennte.
fn file_copy(von: u64, move_to: u64) -> u64 {
    let a: u64 = io.open(von, 0)
    if ulib.bad(a) {
        return 0
    }
    let b: u64 = io.create(move_to)
    if ulib.bad(b) {
        io.close(a)
        return 0
    }
    var int: u64 = 0
    var weiter: bool = true
    while weiter {
        let n: u64 = io.read(a, (&puffer[0 as usize]) as u64, 2048)
        if ulib.bad(n) || n == 0 {
            weiter = false
        } else {
            let g: u64 = io.write_all(b, (&puffer[0 as usize]) as u64, n)
            if ulib.bad(g) || g < n {
                weiter = false
            } else {
                int = int + n
            }
        }
    }
    io.close(a)
    io.close(b)
    if int > 0 {
        geschrieben = geschrieben + 1
    }
    return int
}

// Die Schemata aus `/etc/schemas` einlesen: die Namen als ein Textblock
// fuer die Liste, und daneben dieselben Namen einzeln, damit der Pfad
// gebaut werden kann.
fn schemas_read(dir: u64) -> u64 {
    var recs: [u8; 1024] = [0 as u8; 1024]
    let fd: u64 = io.dir_open(dir)
    if ulib.bad(fd) {
        return 0
    }
    var bp: u64 = 0
    var np: u64 = 0
    var n: u64 = 0
    var weiter: bool = true
    while weiter {
        let got: u64 = io.dir_read(fd, (&recs[0 as usize]) as u64, 1024)
        if ulib.bad(got) || got == 0 {
            weiter = false
        } else {
            var at: u64 = 0
            while at < got {
                let rec: u64 = (&recs[0 as usize]) as u64 + at
                let nm: u64 = io.dir_name(rec)
                let first: u64 = __mmio_read8((nm) as *mut u8) as u64
                if first != 46 && n < 12 {
                    var k: u64 = 0
                    while __mmio_read8((nm + k) as *mut u8) != 0 as u8
                        && k < 30 {
                        schemas[((bp + k)) as usize] =
                            __mmio_read8((nm + k) as *mut u8)
                        snamen[((np + k)) as usize] =
                            __mmio_read8((nm + k) as *mut u8)
                        k = k + 1
                    }
                    bp = bp + k
                    schemas[(bp) as usize] = 10 as u8
                    bp = bp + 1
                    snamen[((np + k)) as usize] = 0 as u8
                    np = np + 32
                    n = n + 1
                }
                let rl: u64 = io.dir_reclen(rec)
                if rl == 0 {
                    at = got
                } else {
                    at = at + rl
                }
            }
        }
    }
    io.close(fd)
    if bp > 0 {
        schemas[((bp - 1)) as usize] = 0 as u8
    }
    schemas[(bp) as usize] = 0 as u8
    nschema = n
    return n
}

fn schema_path(i: u64, ziel: u64) -> bool {
    var s_dir: [u8; 14] = "/etc/schemas/\0"
    if i >= nschema {
        return false
    }
    let a: u64 = text_an(ziel, 0, (&s_dir[0 as usize]) as u64)
    let _b: u64 = text_an(ziel, a,
        (&snamen[0 as usize]) as u64 + i * 32)
    return true
}

// EIN KONTRASTVERHAELTNIS ALS TEXT. `theme_contrast` liefert es mit
// hundert malgenommen -- 493 heisst 4,93 zu 1 --, und ein Benutzer,
// dem man 493 hinschreibt, liest keine Zahl, sondern einen Fehler.
fn quote_an(p: u64, at: u64, v: u64) -> u64 {
    var a: u64 = num_at(p, at, v / 100)
    __mmio_write8((p + a) as *mut u8, 44 as u8)
    a = a + 1
    __mmio_write8((p + a) as *mut u8, (48 + ((v / 10) % 10)) as u8)
    a = a + 1
    __mmio_write8((p + a) as *mut u8, (48 + (v % 10)) as u8)
    a = a + 1
    __mmio_write8((p + a) as *mut u8, 0 as u8)
    return a
}

// WAS DER KONTRAST WIRKLICH IST, in zwei Zeilen unter der Farbe.
// Beide Zahlen kommen aus `wlibc` und werden hier nur gesetzt -- die
// Oberflaeche rechnet nichts nach, sonst gaebe es zwei Rechnungen und
// eines Tages zwei Ergebnisse.
fn contrast_show() {
    var k_m_t: [u8; 23] = "settings.contrast.text\0"
    var k_m_f: [u8; 21] = "settings.contrast.ui\0"
    var k_m_ok: [u8; 21] = "settings.contrast.ok\0"
    var k_m_no: [u8; 23] = "settings.contrast.fail\0"
    var k_m_v: [u8; 22] = "settings.accent.moved\0"
    var k_m_st: [u8; 22] = "settings.accent.steps\0"
    var k_m_ex: [u8; 22] = "settings.accent.exact\0"
    var k_m_bad: [u8; 21] = "settings.accent.none\0"
    let k: u64 = (&l_kon[0 as usize]) as u64
    var a: u64 = text_an(k, 0, msg.get((&k_m_t[0 as usize]) as u64))
    a = quote_an(k, a, wlibc.theme_accent_ratio_text())
    a = text_an(k, a, msg.get((&k_m_f[0 as usize]) as u64))
    a = quote_an(k, a, wlibc.theme_accent_ratio_ui())
    if wlibc.theme_accent_ok() {
        a = text_an(k, a, msg.get((&k_m_ok[0 as usize]) as u64))
    } else {
        a = text_an(k, a, msg.get((&k_m_no[0 as usize]) as u64))
    }
    let _a1: u64 = a
    // `l_kon2` bleibt gefuellt, weil `tools/themestore/run.sh` und
    // tools/i18n/ die Zeichenkette kennen -- sie wird nur nicht mehr
    // als eigenes Etikett gemalt.
    let k2: u64 = (&l_kon2[0 as usize]) as u64
    if wlibc.theme_accent_ok() {
        let _a2: u64 = text_an(k2, 0, msg.get((&k_m_ok[0 as usize]) as u64))
    } else {
        let _a3: u64 = text_an(k2, 0, msg.get((&k_m_no[0 as usize]) as u64))
    }
    var k_m_bk: [u8; 24] = "settings.status.badkeys\0"
    let w: u64 = (&l_warn[0 as usize]) as u64
    if wlibc.theme_bad_keys() > 0 {
        // EINE FALSCH GETIPPTE ZEILE WIRD NICHT VERSCHLUCKT. Wer
        // "2563e" statt "2563eb" eintraegt, bekommt sonst stumm die
        // Farbe des Schemas und sucht den Fehler bei sich.
        let c: u64 = text_an(w, 0, msg.get((&k_m_bk[0 as usize]) as u64))
        let _c2: u64 = num_at(w, c, wlibc.theme_bad_keys())
    } else if !wlibc.theme_accent_ok() {
        let _b0: u64 = text_an(w, 0, msg.get((&k_m_bad[0 as usize]) as u64))
    } else if wlibc.theme_accent_exact() {
        let _b1: u64 = text_an(w, 0, msg.get((&k_m_ex[0 as usize]) as u64))
    } else {
        var b: u64 = text_an(w, 0, msg.get((&k_m_v[0 as usize]) as u64))
        b = num_at(w, b, wlibc.theme_accent_moved())
        let _b2: u64 = text_an(w, b, msg.get((&k_m_st[0 as usize]) as u64))
    }
}

// /etc/theme.conf schreiben. DAS ist der Knopf: nicht eine Datei
// kopieren, sondern die vier Angaben hinlegen, aus denen der Satz
// gerechnet wird.
fn tb_apply_live() {
    tb_edge = kval[(K_CE) as usize]
    if (fuiscene.value_of(K_KA) as u64) != 0 {
        tb_autohide = 1
    } else {
        tb_autohide = 0
    }
    if (fuiscene.value_of(K_KO) as u64) != 0 {
        tb_ontop = 1
    } else {
        tb_ontop = 0
    }
    tb_align = kval[(K_CAL) as usize]
    tb_set_size((&e_tbs[0 as usize]) as u64)
    let _tw: bool = tb_write()
    tb_say()
    melde_stand()
}

fn effects_apply_live() {
    wlibc.set_shadow_on((fuiscene.value_of(K_KSH) as u64) != 0)
    if fuiscene.table_sel(K_LS) < nschema {
        let _tw: bool = theme_conf_write(
            (&snamen[0 as usize]) as u64 + fuiscene.table_sel(K_LS) * 32,
            kval[(K_CM) as usize],
            (&e_akzent[0 as usize]) as u64,
            kval[(K_CSH) as usize],
            zieh_wert_von(kval[(K_ZS1) as usize], 40, 50),
            zieh_wert_von(kval[(K_ZS2) as usize], 50, 80),
            zieh_wert_von(kval[(K_ZS3) as usize], 25, 45),
            zieh_wert_von(kval[(K_BS1) as usize], 6, 12),
            zieh_wert_von(kval[(K_BS2) as usize], 18, 32),
            blur_noise_von(kval[(K_BS1) as usize]))
    }
    let _r: u64 = wlibc.theme_reload()
    shape_say()
    contrast_show()
    melde_stand()
}

// W-S: the 'Transparency effects' choice: live at once (wlibc re-resolves and pushes the form marks), then the
// same one file as every other appearance setting. The line `transparency=` is also what the bus key
// display.transparency stores (etc/settings.schema), so a change from outside reaches this window by polling.
fn trn_apply(idx: u64) {
    wlibc.set_transparency(idx)
    if fuiscene.table_sel(K_LS) < nschema {
        let _tw: bool = theme_conf_write(
            (&snamen[0 as usize]) as u64 + fuiscene.table_sel(K_LS) * 32,
            kval[(K_CM) as usize],
            (&e_akzent[0 as usize]) as u64,
            kval[(K_CSH) as usize],
            zieh_wert_von(kval[(K_ZS1) as usize], 40, 50),
            zieh_wert_von(kval[(K_ZS2) as usize], 50, 80),
            zieh_wert_von(kval[(K_ZS3) as usize], 25, 45),
            zieh_wert_von(kval[(K_BS1) as usize], 6, 12),
            zieh_wert_von(kval[(K_BS2) as usize], 18, 32),
            blur_noise_von(kval[(K_BS1) as usize]))
    }
    glas_say()
}

fn theme_conf_write(schema: u64, modus: u64, akzent: u64,
    form: u64, z_lift: u64, z_tilt: u64, z_swing: u64,
    b_rad: u64, b_tint: u64, b_noise: u64) -> bool {
    var k_s: [u8; 8] = "scheme=\0"
    var k_m: [u8; 7] = "\nmode=\0"
    var k_a: [u8; 9] = "\naccent=\0"
    var k_l: [u8; 14] = "\nlight_start=\0"
    var k_d: [u8; 13] = "\ndark_start=\0"
    var k_nl: [u8; 2] = "\n\0"
    var k_shd: [u8; 9] = "\nshadow=\0"
    var k_trw: [u8; 15] = "\ntransparency=\0"
    var v_tr0: [u8; 4] = "off\0"
    var v_tr1: [u8; 7] = "subtle\0"
    var v_tr2: [u8; 7] = "strong\0"
    var v_on: [u8; 3] = "on\0"
    var v_off: [u8; 4] = "off\0"
    var v_l: [u8; 6] = "light\0"
    var v_d: [u8; 5] = "dark\0"
    var v_a: [u8; 5] = "auto\0"
    var t_conf: [u8; 16] = "/etc/theme.conf\0"
    let b: u64 = (&puffer[0 as usize]) as u64
    var at: u64 = text_an(b, 0, (&k_s[0 as usize]) as u64)
    at = text_an(b, at, schema)
    at = text_an(b, at, (&k_m[0 as usize]) as u64)
    if modus == 0 {
        at = text_an(b, at, (&v_l[0 as usize]) as u64)
    } else if modus == 1 {
        at = text_an(b, at, (&v_d[0 as usize]) as u64)
    } else {
        at = text_an(b, at, (&v_a[0 as usize]) as u64)
    }
    // ROUND LOOK: the shape, beside the scheme and the mode. One
    // file, three settings, one Apply -- and `theme_reload` picks all
    // three up in the same pass, so the change is live without a
    // restart the way the colour scheme already was.
    var k_f: [u8; 8] = "\nshape=\0"
    at = text_an(b, at, (&k_f[0 as usize]) as u64)
    if form == 1 {
        at = text_an(b, at, (&v_modern[0 as usize]) as u64)
    } else {
        at = text_an(b, at, (&v_classic[0 as usize]) as u64)
    }
    // ================================================== RUNDE ZIEH
    // Die drei Wirkungen des Aufhebens, als Zahlen in derselben
    // Datei. Sie stehen hier und nicht in der Formdatei, weil sie
    // eine Vorliebe des Menschen sind und den Formwechsel ueberleben
    // sollen -- dieselbe Trennung wie bei `accent=`.
    var k_zl: [u8; 7] = "\nlift=\0"
    var k_zt: [u8; 7] = "\ntilt=\0"
    var k_zs: [u8; 8] = "\nswing=\0"
    at = text_an(b, at, (&k_zl[0 as usize]) as u64)
    at = num_at(b, at, z_lift)
    at = text_an(b, at, (&k_zt[0 as usize]) as u64)
    at = num_at(b, at, z_tilt)
    at = text_an(b, at, (&k_zs[0 as usize]) as u64)
    at = num_at(b, at, z_swing)
    // ================================================== RUNDE BLUR
    // Und das Acryl, in derselben Datei und aus demselben Grund: wer
    // den Blur auf einer schwachen Maschine abgeschaltet hat, will ihn
    // nach einem Formwechsel nicht wieder anhaben.
    var k_br: [u8; 7] = "\nblur=\0"
    var k_bt: [u8; 12] = "\nblur_tint=\0"
    var k_bn: [u8; 13] = "\nblur_noise=\0"
    at = text_an(b, at, (&k_br[0 as usize]) as u64)
    at = num_at(b, at, b_rad)
    at = text_an(b, at, (&k_bt[0 as usize]) as u64)
    at = num_at(b, at, b_tint)
    at = text_an(b, at, (&k_bn[0 as usize]) as u64)
    at = num_at(b, at, b_noise)
    at = text_an(b, at, (&k_a[0 as usize]) as u64)
    at = text_an(b, at, akzent)
    at = text_an(b, at, (&k_l[0 as usize]) as u64)
    at = uhr_an(b, at, wlibc.theme_light_start())
    at = text_an(b, at, (&k_d[0 as usize]) as u64)
    at = uhr_an(b, at, wlibc.theme_dark_start())
    // RUNDE GLAS: die vier Zahlen, in derselben Datei und aus dem, was
    // gerade laeuft. Sie aus `wlibc` zu nehmen und nicht aus den
    // Reglern ist Absicht: geklemmt wird an EINER Stelle, und was hier
    // in die Datei geht, ist deshalb genau das, was der naechste Start
    // wieder einliest -- die Datei und der Bildschirm koennen nicht
    // auseinanderlaufen.
    var k_rd: [u8; 9] = "\nradius=\0"
    var k_ta: [u8; 16] = "\ntaskbar_alpha=\0"
    var k_wa: [u8; 15] = "\nwindow_alpha=\0"
    at = text_an(b, at, (&k_rd[0 as usize]) as u64)
    at = num_at(b, at, wlibc.radius())
    at = text_an(b, at, (&k_ta[0 as usize]) as u64)
    at = num_at(b, at, wlibc.tb_alpha())
    at = text_an(b, at, (&k_wa[0 as usize]) as u64)
    at = num_at(b, at, wlibc.win_alpha())
    // EINE ZEILE `taskbar_blur=` STEHT HIER NICHT MEHR. Der Radius des
    // Weichzeichners ist oben schon als `blur=` geschrieben worden
    // (aus `b_rad`), und `wlibc` liest genau diese Zeile. Zwei Zeilen
    // fuer dieselbe Zahl waeren zwei Orte, und beim Wiedereinlesen
    // gewaenne die letzte -- also die, die der Regler nicht gesetzt hat.
    // r402: the window shadow switch is kept (Apply used to drop the line, and a window
    // shadow that had been tried would be gone after the next click)
    at = text_an(b, at, (&k_shd[0 as usize]) as u64)
    if wlibc.shadow_an() {
        at = text_an(b, at, (&v_on[0 as usize]) as u64)
    } else {
        at = text_an(b, at, (&v_off[0 as usize]) as u64)
    }
    // W-S: the master switch of the transparency effects
    at = text_an(b, at, (&k_trw[0 as usize]) as u64)
    if wlibc.transparency() == wlibc.TRANS_OFF {
        at = text_an(b, at, (&v_tr0[0 as usize]) as u64)
    } else if wlibc.transparency() == wlibc.TRANS_STRONG {
        at = text_an(b, at, (&v_tr2[0 as usize]) as u64)
    } else {
        at = text_an(b, at, (&v_tr1[0 as usize]) as u64)
    }
    at = text_an(b, at, (&k_nl[0 as usize]) as u64)
    return file_write((&t_conf[0 as usize]) as u64, b, at)
}

// 450 -> "07:30". Die Datei traegt die Uhrzeit und nicht die Minuten,
// weil ein Mensch sie liest.
fn uhr_an(p: u64, at: u64, min: u64) -> u64 {
    let h: u64 = min / 60
    let m: u64 = min % 60
    __mmio_write8((p + at) as *mut u8, (48 + (h / 10)) as u8)
    __mmio_write8((p + at + 1) as *mut u8, (48 + (h % 10)) as u8)
    __mmio_write8((p + at + 2) as *mut u8, 58 as u8)
    __mmio_write8((p + at + 3) as *mut u8, (48 + (m / 10)) as u8)
    __mmio_write8((p + at + 4) as *mut u8, (48 + (m % 10)) as u8)
    __mmio_write8((p + at + 5) as *mut u8, 0 as u8)
    return at + 5
}

// ------------------------------------------------------ die Anzeigen

// ==================================================== RUNDE DISPLAY

fn dget(feld: u64) -> u64 {
    return ulib.sys(SYS_DISPGET, feld, 0, 0)
}

// Seconds left of the display-change confirmation. The syscall returns a negative errno (as a huge u64)
// when there is no display driver (VM): treat that as 0 instead of overflowing on `+ 999`.
fn remain_secs() -> u64 {
    let v: u64 = dget(DG_REMAIN)
    if v > 4000000000 {
        return 0
    }
    return (v + 999) / 1000
}

fn dset(feld: u64, wert: u64) -> u64 {
    return ulib.sys(SYS_DISPSET, feld, wert, 0)
}

// Die Stufen der vier Regler. Die Widget-Bibliothek hat keinen
// Schieberegler; sie hat eine Auswahl, die weiterschaltet. Sechs
// Stufen sind, was ein Bedienfeld ohne Schieber hergibt, und sie decken
// den Bereich ab, den die Tabelle ueberhaupt darstellen kann.
fn level_bright(i: u64) -> u64 {
    if i == 0 {
        return 40
    }
    if i == 1 {
        return 70
    }
    if i == 2 {
        return 100
    }
    if i == 3 {
        return 130
    }
    if i == 4 {
        return 160
    }
    return 200
}

fn stufe_gam(i: u64) -> u64 {
    if i == 0 {
        return 45
    }
    if i == 1 {
        return 70
    }
    if i == 2 {
        return 100
    }
    if i == 3 {
        return 140
    }
    if i == 4 {
        return 180
    }
    return 220
}

// ======================================================= RUNDE ZIEH
// DIE STUFE AUS DEM WERT, UND DER WERT AUS DER STUFE.
//
// Die Bibliothek hat keinen Schieberegler, sie hat eine Auswahl, die
// weiterschaltet (siehe `level_bright` daneben). Drei Stufen reichen
// hier: schwach, mittel, stark. `mitte` ist die mittlere Stufe, `hoch`
// die starke; die schwache ist die Haelfte der mittleren.
//
// Ist die Wirkung AUS (Wert 0), zeigt die Auswahl trotzdem eine Stufe
// -- naemlich die mittlere. Sonst stuende dort beim Wiedereinschalten
// "schwach", obwohl der Mensch das nie gewaehlt hat.
// ZUSAMMENFUEHRUNG BLUR+GLAS: VIER STUFEN STATT KAESTCHEN UND DREI.
//
// Die Seite Darstellung traegt seit dem Zusammenfuehren BEIDE
// Reglergruppen: die drei Wirkungen des Aufhebens und das Acryl (Runde
// ZIEH und BLUR) UND Rundung, Durchsicht und Milchglas (Runde GLAS).
// Zusammen waren das elf Zeilen mehr in der linken Spalte, und die
// Spalte ist 444 Bildpunkte hoch: gemessen im Abnahmelauf endete das
// letzte Bedienelement bei 904 statt bei 504, also 400 Bildpunkte
// ausserhalb seines Fensters (Abschnitt 8, 12 Widgets rot).
//
// Die Zeilen, die weichen, sind die KAESTCHEN. Ein Kaestchen "Effekt
// an" neben einer Stufenwahl "schwach/mittel/stark" ist zweimal
// dieselbe Aussage -- genau das, was die Formmarken dieses Systems
// ausdruecklich NICHT tun (`FM_SHADOW`, `FM_BLUR`, die drei der Runde
// ZIEH: 0 heisst aus, sonst ist die Zahl die Staerke). Die Oberflaeche
// sagt jetzt dasselbe: eine Wahl mit vier Stufen, und die erste heisst
// "aus". Vier Zeilen weniger, keine Einstellung weniger.
fn zieh_stufe(wert: u64, mitte: u64, hoch: u64) -> u64 {
    if wert == 0 {
        return 0
    }
    if wert >= hoch {
        return 3
    }
    if wert >= mitte {
        return 2
    }
    return 1
}

// RUNDE BLUR: das Rauschen hat KEINEN eigenen Regler.
//
// Und das ist Absicht. Das Korn ist der Unterschied zwischen Milchglas
// und Acryl, aber es ist kein Geschmacksregler: unter 2 sieht man es
// nicht, ueber 8 wird es Griesel. Ein Regler, dessen brauchbarer
// Bereich drei Stufen breit ist, ist ein Regler, an dem man nur etwas
// falsch machen kann. Er haengt deshalb am selben Kaestchen wie der
// Rest: Acryl an heisst Korn an.
fn blur_noise_von(stufe: u64) -> u64 {
    if stufe != 0 {
        return 3
    }
    return 0
}

// Der Rueckweg, und `an` ist jetzt die Stufe selbst: 0 = aus.
fn zieh_wert_von(stufe: u64, mitte: u64, hoch: u64) -> u64 {
    if stufe == 0 {
        return 0
    }
    if stufe == 1 {
        return mitte / 2
    }
    if stufe == 3 {
        return hoch
    }
    return mitte
}

fn stufe_sat(i: u64) -> u64 {
    if i == 0 {
        return 0
    }
    if i == 1 {
        return 50
    }
    if i == 2 {
        return 100
    }
    if i == 3 {
        return 150
    }
    return 200
}

// Die naechstliegende Stufe zu einem Wert, damit die Auswahl beim
// Oeffnen das ANZEIGT, was wirklich eingestellt ist, und nicht die
// Mitte behauptet.
fn stufe_von(v: u64, art: u64) -> u64 {
    var best: u64 = 0
    var bd: u64 = 100000
    var i: u64 = 0
    let n: u64 = 6
    while i < n {
        var w: u64 = 0
        if art == 0 {
            w = level_bright(i)
        } else if art == 1 {
            w = stufe_gam(i)
        } else {
            if i > 4 {
                w = 200
            } else {
                w = stufe_sat(i)
            }
        }
        var d: u64 = 0
        if w >= v {
            d = w - v
        } else {
            d = v - w
        }
        if d < bd {
            bd = d
            best = i
        }
        i = i + 1
    }
    return best
}

// DIE MODUSLISTE KOMMT AUS DEM KERNEL, EINE ZEILE JE MODUS. Sie steht
// nicht im Quelltext dieses Programms, und das ist der ganze Punkt: auf
// einer Maschine mit weniger Bildspeicher oder mit einer Karte, die
// weniger annimmt, ist sie kuerzer, und niemand muss dafuer etwas
// uebersetzen.
fn modes_read() {
    var t_x: [u8; 4] = " x \0"
    var t_n: [u8; 2] = "\n\0"
    var k_t_leer: [u8; 24] = "settings.display.nocard\0"
    d_n = 0
    if ulib.bad(dget(DG_READY)) || dget(DG_READY) == 0 {
        let _e: u64 = text_an((&d_modi[0 as usize]) as u64, 0,
            msg.get((&k_t_leer[0 as usize]) as u64))
        return
    }
    let n: u64 = dget(DG_COUNT)
    var a: u64 = 0
    var i: u64 = 0
    while i < n && i < 40 {
        let m: u64 = dget(DG_MODE + i)
        if !ulib.bad(m) {
            a = num_at((&d_modi[0 as usize]) as u64, a, (m >> 32) & 0xFFFF)
            a = text_an((&d_modi[0 as usize]) as u64, a,
                msg.get((&k_g_t_x[0 as usize]) as u64))
            a = num_at((&d_modi[0 as usize]) as u64, a, (m >> 16) & 0xFFFF)
            a = text_an((&d_modi[0 as usize]) as u64, a,
                (&t_n[0 as usize]) as u64)
            d_n = d_n + 1
        }
        i = i + 1
    }
    if a > 0 {
        d_modi[(a - 1) as usize] = 0 as u8
    }
}

// Was die Karte ueber sich sagt, und was der Monitor ueber sich sagt.
fn map_read() {
    var k_t_v: [u8; 22] = "settings.display.card\0"
    var k_t_k: [u8; 21] = "settings.display.kib\0"
    var k_t_e: [u8; 24] = "settings.display.native\0"
    var t_x: [u8; 4] = " x \0"
    var k_t_ne: [u8; 26] = "settings.display.edidless\0"
    var k_t_t: [u8; 23] = "settings.display.depth\0"
    var k_t_t2: [u8; 24] = "settings.display.depth2\0"
    var k_t_t3: [u8; 24] = "settings.display.depth3\0"
    var k_t_t4: [u8; 24] = "settings.display.depth4\0"
    let a0: u64 = text_an((&d_karte[0 as usize]) as u64, 0,
        msg.get((&k_t_v[0 as usize]) as u64))
    if ulib.bad(dget(DG_READY)) || dget(DG_READY) == 0 {
        var k_t_no: [u8; 26] = "settings.display.unprobed\0"
        let _q: u64 = text_an((&d_karte[0 as usize]) as u64, a0,
            msg.get((&k_t_no[0 as usize]) as u64))
        let _r: u64 = text_an((&d_tiefe[0 as usize]) as u64, 0,
            msg.get((&k_t_t4[0 as usize]) as u64))
        return
    }
    var a: u64 = num_at((&d_karte[0 as usize]) as u64, a0,
        dget(DG_VRAM) / 1024)
    a = text_an((&d_karte[0 as usize]) as u64, a, msg.get((&k_t_k[0 as usize]) as u64))
    if dget(DG_EDIDOK) == 1 {
        a = text_an((&d_karte[0 as usize]) as u64, a,
            msg.get((&k_t_e[0 as usize]) as u64))
        a = num_at((&d_karte[0 as usize]) as u64, a, dget(DG_NATW))
        a = text_an((&d_karte[0 as usize]) as u64, a,
            msg.get((&k_g_t_x[0 as usize]) as u64))
        a = num_at((&d_karte[0 as usize]) as u64, a, dget(DG_NATH))
    } else {
        a = text_an((&d_karte[0 as usize]) as u64, a,
            msg.get((&k_t_ne[0 as usize]) as u64))
    }
    let b: u64 = text_an((&d_tiefe[0 as usize]) as u64, 0,
        msg.get((&k_t_t[0 as usize]) as u64))
    let _c: u64 = text_an((&d_tiefe[0 as usize]) as u64, b,
        msg.get((&k_t_t3[0 as usize]) as u64))
}

// Die Zeile, die herunterzaehlt. Sie steht nur da, solange der Kernel
// wirklich eine Frist fuehrt.
fn deadline_read() -> bool {
    var k_t_f: [u8; 28] = "settings.display.countdown1\0"
    var k_t_g: [u8; 28] = "settings.display.countdown2\0"
    var k_t_s: [u8; 28] = "settings.display.countdown3\0"
    var t_leer: [u8; 2] = " \0"
    if dget(DG_PENDING) != 1 {
        let _z: u64 = text_an((&d_frist[0 as usize]) as u64, 0,
            msg.get((&k_g_t_leer[0 as usize]) as u64))
        return false
    }
    var a: u64 = text_an((&d_frist[0 as usize]) as u64, 0,
        msg.get((&k_t_f[0 as usize]) as u64))
    a = text_an((&d_frist[0 as usize]) as u64, a, msg.get((&k_t_g[0 as usize]) as u64))
    a = num_at((&d_frist[0 as usize]) as u64, a,
        remain_secs())
    let _e: u64 = text_an((&d_frist[0 as usize]) as u64, a,
        msg.get((&k_t_s[0 as usize]) as u64))
    return true
}

// RUNDE CUSTOMRES (MERGE-2 18): die Saetze von `grund_lesen` und
// `save_lesen`. Der Zweig hatte sie fest eingebaut; hier stehen nur
// noch die Schluessel, der Text steht in locale/de + locale/en.
static mut k_g_t_ok: [u8; 25] = "settings.display.cust.ok\0"
static mut k_g_t_regs: [u8; 28] = "settings.display.cust.width\0"
static mut k_g_t_acht: [u8; 28] = "settings.display.cust.mult8\0"
static mut k_g_t_vram: [u8; 27] = "settings.display.cust.vram\0"
static mut k_g_t_lim: [u8; 28] = "settings.display.cust.limit\0"
static mut k_g_t_kach: [u8; 28] = "settings.display.cust.slots\0"
static mut k_g_t_dep: [u8; 28] = "settings.display.cust.depth\0"
static mut k_g_t_bit: [u8; 27] = "settings.display.cust.bits\0"
static mut k_g_t_uns: [u8; 28] = "settings.display.cust.range\0"
static mut k_g_t_bis: [u8; 25] = "settings.display.cust.to\0"
static mut k_g_t_no: [u8; 28] = "settings.display.cust.nodrv\0"
static mut k_g_t_k: [u8; 27] = "settings.display.save.none\0"
static mut k_g_t_g: [u8; 25] = "settings.display.save.is\0"
static mut k_g_t_x: [u8; 24] = "settings.display.save.x\0"
static mut k_g_t_v: [u8; 26] = "settings.display.save.try\0"
static mut k_g_t_an: [u8; 30] = "settings.display.save.applied\0"
static mut k_g_t_aus: [u8; 33] = "settings.display.save.notapplied\0"
static mut k_g_t_von: [u8; 25] = "settings.display.cust.of\0"
static mut k_g_t_leer: [u8; 28] = "settings.display.cust.space\0"

// ================================================== RUNDE CUSTOMRES
//
// DEN GRUND IN EINEN SATZ. Jede Zahl darin kommt aus dem Kernel
// (DG_CUSTWHY, DG_CUSTNUM, DG_VRAM, DG_MAPLIMIT); dieses Programm
// rechnet keine davon nach. Eine Oberflaeche, die eine eigene Zahl
// hinschreibt, ist eine zweite Wahrheit.
fn reason_read(w: u64, h: u64) {

    let why: u64 = dget(DG_CUSTWHY)
    let num: u64 = dget(DG_CUSTNUM)
    if ulib.bad(why) {
        let _z: u64 = text_an((&d_grund[0 as usize]) as u64, 0,
            msg.get((&k_g_t_no[0 as usize]) as u64))
        return
    }
    var a: u64 = 0
    if why == 0 {
        a = text_an((&d_grund[0 as usize]) as u64, 0,
            msg.get((&k_g_t_ok[0 as usize]) as u64))
        let _b: u64 = num_at((&d_grund[0 as usize]) as u64, a, num)
        return
    }
    if why == 1 {
        a = text_an((&d_grund[0 as usize]) as u64, 0,
            msg.get((&k_g_t_regs[0 as usize]) as u64))
        a = num_at((&d_grund[0 as usize]) as u64, a, num)
        if (w & 7) != 0 {
            a = text_an((&d_grund[0 as usize]) as u64, a,
                msg.get((&k_g_t_acht[0 as usize]) as u64))
        }
        return
    }
    if why == 2 {
        a = text_an((&d_grund[0 as usize]) as u64, 0,
            msg.get((&k_g_t_vram[0 as usize]) as u64))
        a = num_at((&d_grund[0 as usize]) as u64, a, num)
        a = text_an((&d_grund[0 as usize]) as u64, a,
            msg.get((&k_g_t_von[0 as usize]) as u64))
        let _c: u64 = num_at((&d_grund[0 as usize]) as u64, a,
            dget(DG_VRAM))
        return
    }
    if why == 3 {
        a = text_an((&d_grund[0 as usize]) as u64, 0,
            msg.get((&k_g_t_lim[0 as usize]) as u64))
        a = num_at((&d_grund[0 as usize]) as u64, a, num)
        a = text_an((&d_grund[0 as usize]) as u64, a,
            msg.get((&k_g_t_von[0 as usize]) as u64))
        a = num_at((&d_grund[0 as usize]) as u64, a, dget(DG_MAPLIMIT))
        let _d: u64 = text_an((&d_grund[0 as usize]) as u64, a,
            msg.get((&k_g_t_kach[0 as usize]) as u64))
        return
    }
    if why == 4 {
        a = text_an((&d_grund[0 as usize]) as u64, 0,
            msg.get((&k_g_t_dep[0 as usize]) as u64))
        a = num_at((&d_grund[0 as usize]) as u64, a, num)
        let _e: u64 = text_an((&d_grund[0 as usize]) as u64, a,
            msg.get((&k_g_t_bit[0 as usize]) as u64))
        return
    }
    if why == 5 {
        a = text_an((&d_grund[0 as usize]) as u64, 0,
            msg.get((&k_g_t_uns[0 as usize]) as u64))
        a = num_at((&d_grund[0 as usize]) as u64, a, num)
        a = text_an((&d_grund[0 as usize]) as u64, a,
            msg.get((&k_g_t_leer[0 as usize]) as u64))
        a = num_at((&d_grund[0 as usize]) as u64, a, dget(DG_MINW))
        a = text_an((&d_grund[0 as usize]) as u64, a,
            msg.get((&k_g_t_bis[0 as usize]) as u64))
        let _f: u64 = num_at((&d_grund[0 as usize]) as u64, a,
            dget(DG_MAXW))
        return
    }
    let _g: u64 = text_an((&d_grund[0 as usize]) as u64, 0,
        msg.get((&k_g_t_no[0 as usize]) as u64))
}

// WAS AUF DER PLATTE STEHT, UND WIEVIELE STARTVERSUCHE ER NOCH HAT. Das
// ist die Zeile, ohne die der Zaehler ein Geheimnis waere: wer den
// Rechner dreimal ohne "Behalten" startet, bekommt seinen Modus nicht
// mehr -- und darf das vorher wissen.
fn save_read() {
    if dget(DG_SAVEOK) != 1 {
        let _z: u64 = text_an((&d_save[0 as usize]) as u64, 0,
            msg.get((&k_g_t_k[0 as usize]) as u64))
        return
    }
    var a: u64 = text_an((&d_save[0 as usize]) as u64, 0,
        msg.get((&k_g_t_g[0 as usize]) as u64))
    a = num_at((&d_save[0 as usize]) as u64, a, dget(DG_SAVEW))
    a = text_an((&d_save[0 as usize]) as u64, a, msg.get((&k_g_t_x[0 as usize]) as u64))
    a = num_at((&d_save[0 as usize]) as u64, a, dget(DG_SAVEH))
    a = text_an((&d_save[0 as usize]) as u64, a, msg.get((&k_g_t_v[0 as usize]) as u64))
    a = num_at((&d_save[0 as usize]) as u64, a, dget(DG_SAVETRY))
    a = text_an((&d_save[0 as usize]) as u64, a, msg.get((&k_g_t_von[0 as usize]) as u64))
    a = num_at((&d_save[0 as usize]) as u64, a, 3)
    if dget(DG_SAVEAPP) == 1 {
        let _b: u64 = text_an((&d_save[0 as usize]) as u64, a,
            msg.get((&k_g_t_an[0 as usize]) as u64))
    } else {
        let _c: u64 = text_an((&d_save[0 as usize]) as u64, a,
            msg.get((&k_g_t_aus[0 as usize]) as u64))
    }
}

// Eine Zahl aus einem Eingabefeld. Leere Eingabe ist 0 -- und 0 faellt
// in `check_custom` durch die Unsinnschranke, mit ihrer eigenen Zahl.
fn field_num(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    var fertig: bool = false
    while i < 12 && !fertig {
        let c: u64 = __mmio_read8((p + i) as *mut u8) as u64
        if c < 48 || c > 57 {
            fertig = true
        } else {
            v = v * 10 + (c - 48)
            i = i + 1
        }
    }
    return v
}

fn state_read() {
    var k_t_akt: [u8; 26] = "settings.label.resolution\0"
    var t_mal: [u8; 4] = " x \0"
    var k_t_dat: [u8; 21] = "settings.label.clock\0"
    var t_pkt: [u8; 2] = ".\0"
    var t_dp: [u8; 2] = ":\0"
    var k_t_ip: [u8; 23] = "settings.label.address\0"
    var k_t_mk: [u8; 20] = "settings.label.mask\0"
    var k_t_gw: [u8; 23] = "settings.label.gateway\0"
    var k_t_mac: [u8; 24] = "settings.label.hardware\0"
    var k_t_kn: [u8; 21] = "settings.label.nonet\0"
    var k_t_wer: [u8; 24] = "settings.label.loggedin\0"
    var k_t_uid: [u8; 19] = "settings.label.uid\0"
    var t_dd: [u8; 2] = "-\0"
    var a: u64 = text_an((&l_schirm[0 as usize]) as u64, 0,
        msg.get((&k_t_akt[0 as usize]) as u64))
    a = num_at((&l_schirm[0 as usize]) as u64, a, wlibc.screen_w())
    a = text_an((&l_schirm[0 as usize]) as u64, a,
        (&t_mal[0 as usize]) as u64)
    a = num_at((&l_schirm[0 as usize]) as u64, a, wlibc.screen_h())
    modes_read()
    map_read()
    let _f: bool = deadline_read()
    // Datum und Uhrzeit
    let d: u64 = (&l_datum[0 as usize]) as u64
    a = text_an(d, 0, msg.get((&k_t_dat[0 as usize]) as u64))
    a = num_at(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_YEAR, 0, 0))
    a = text_an(d, a, (&t_dd[0 as usize]) as u64)
    a = two_on(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_MONTH, 0, 0))
    a = text_an(d, a, (&t_dd[0 as usize]) as u64)
    a = two_on(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_DAY, 0, 0))
    a = text_an(d, a, (&t_mal[0 as usize]) as u64)
    a = two_on(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_HOUR, 0, 0))
    a = text_an(d, a, (&t_dp[0 as usize]) as u64)
    a = two_on(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_MIN, 0, 0))
    // das Netz
    let rd: u64 = ulib.sys(SYS_NETGET, NG_READY, 0, 0)
    let ip: u64 = (&l_ip[0 as usize]) as u64
    let mk: u64 = (&l_maske[0 as usize]) as u64
    let gw: u64 = (&l_gw[0 as usize]) as u64
    let mc: u64 = (&l_mac[0 as usize]) as u64
    if ulib.bad(rd) || rd == 0 {
        a = text_an(ip, 0, msg.get((&k_t_ip[0 as usize]) as u64))
        let _z: u64 = text_an(ip, a, msg.get((&k_t_kn[0 as usize]) as u64))
        a = text_an(mk, 0, msg.get((&k_t_mk[0 as usize]) as u64))
        let _y: u64 = text_an(mk, a, msg.get((&k_t_kn[0 as usize]) as u64))
        a = text_an(gw, 0, msg.get((&k_t_gw[0 as usize]) as u64))
        let _x: u64 = text_an(gw, a, msg.get((&k_t_kn[0 as usize]) as u64))
        a = text_an(mc, 0, msg.get((&k_t_mac[0 as usize]) as u64))
        let _w2: u64 = text_an(mc, a, msg.get((&k_t_kn[0 as usize]) as u64))
    } else {
        let v: u64 = ulib.sys(SYS_NETGET, NG_IP, 0, 0)
        let m: u64 = ulib.sys(SYS_NETGET, NG_MASK, 0, 0)
        let g: u64 = ulib.sys(SYS_NETGET, NG_GW, 0, 0)
        a = text_an(ip, 0, msg.get((&k_t_ip[0 as usize]) as u64))
        let _z: u64 = ip_an(ip, a, v)
        a = text_an(mk, 0, msg.get((&k_t_mk[0 as usize]) as u64))
        let _y: u64 = ip_an(mk, a, m)
        a = text_an(gw, 0, msg.get((&k_t_gw[0 as usize]) as u64))
        let _x: u64 = ip_an(gw, a, g)
        let m0: u64 = ulib.sys(SYS_NETGET, NG_MAC0, 0, 0)
        let m1: u64 = ulib.sys(SYS_NETGET, NG_MAC1, 0, 0)
        a = text_an(mc, 0, msg.get((&k_t_mac[0 as usize]) as u64))
        a = num_at(mc, a, (m0 >> 24) & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = num_at(mc, a, (m0 >> 16) & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = num_at(mc, a, (m0 >> 8) & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = num_at(mc, a, m0 & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = num_at(mc, a, (m1 >> 8) & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = num_at(mc, a, m1 & 255)
        let _e1: u64 = ip_an((&e_ip[0 as usize]) as u64, 0, v)
        let _e2: u64 = ip_an((&e_maske[0 as usize]) as u64, 0, m)
        let _e3: u64 = ip_an((&e_gw[0 as usize]) as u64, 0, g)
    }
    // wer davorsteht
    let uid: u64 = pw.session_uid()
    if !pw.name_of_uid(uid, (&name[0 as usize]) as u64, 64) {
        name[(0) as usize] = 63 as u8
        name[(1) as usize] = 0 as u8
    }
    a = text_an((&l_wer[0 as usize]) as u64, 0, msg.get((&k_t_wer[0 as usize]) as u64))
    a = text_an((&l_wer[0 as usize]) as u64, a, (&name[0 as usize]) as u64)
    a = text_an((&l_wer[0 as usize]) as u64, a, msg.get((&k_t_uid[0 as usize]) as u64))
    let _u: u64 = num_at((&l_wer[0 as usize]) as u64, a, uid)
    say((&sw_a[0 as usize]) as u64)
    sayn(uid)
    say((&sw_b[0 as usize]) as u64)
    say((&name[0 as usize]) as u64)
    nl()
}

static mut sw_a: [u8; 19] = "settings: who uid=\0"
static mut sw_b: [u8; 7] = " name=\0"

static mut ms_a: [u8; 23] = "settings: menu open i=\0"
static mut ms_b: [u8; 4] = " x=\0"
static mut ms_c: [u8; 4] = " y=\0"
static mut ms_d: [u8; 7] = " rows=\0"
static mut ms_g: [u8; 5] = " rh=\0"
static mut ms_e: [u8; 23] = "settings: menu took i=\0"
static mut ms_f: [u8; 6] = " row=\0"

// WHERE THE DROP-DOWN IS, INCLUDING HOW TALL A ROW IS.
//
// A runner that wants to click row 3 of this menu needs four numbers
// and used to have none of them: it clicked at coordinates somebody had
// read off a screenshot once. Round LOOK moved every control on this
// page (a shape chooser and an alignment chooser went in above), the
// coordinates hit the wrong widget, and six assertions failed while
// saying nothing about what had actually changed. The row height is
// `zeilen_hoehe() + 2`, which is what `wlib.menu_open` itself uses.
fn menu_say(i: u64, x: u64, y: u64, n: u64) {
    say((&ms_a[0 as usize]) as u64)
    sayn(i)
    say((&ms_b[0 as usize]) as u64)
    sayn(x)
    say((&ms_c[0 as usize]) as u64)
    sayn(y)
    say((&ms_d[0 as usize]) as u64)
    sayn(n)
    say((&ms_g[0 as usize]) as u64)
    sayn(30)
    nl()
}

fn menu_done(i: u64, r: u64) {
    say((&ms_e[0 as usize]) as u64)
    sayn(i)
    say((&ms_f[0 as usize]) as u64)
    sayn(r)
    nl()
}

// WHERE THE TASKBAR WIDGETS ARE, in window coordinates. Without this a
// runner cannot click them, and a setting that is only ever set from
// inside the program is not measured from the outside.
static mut mr_a: [u8; 21] = "settings: rect name=\0"
static mut mr_ax: [u8; 5] = " ax=\0"
static mut mr_ay: [u8; 5] = " ay=\0"
static mut mr_w: [u8; 4] = " w=\0"
static mut mr_h: [u8; 4] = " h=\0"

static mut rs_buf: [u8; 160] = [0 as u8; 160]

// Text in den Puffer, ohne die abschliessende Null.
fn rs_put(at: u64, p: u64) -> u64 {
    let b: u64 = (&rs_buf[0 as usize]) as u64
    var i: u64 = 0
    var a: u64 = at
    while __mmio_read8((p + i) as *mut u8) != 0 as u8 && a + 2 < 160 {
        __mmio_write8((b + a) as *mut u8, __mmio_read8((p + i) as *mut u8))
        a = a + 1
        i = i + 1
    }
    return a
}

// Eine Dezimalzahl in denselben Puffer.
fn rs_num(at: u64, v: u64) -> u64 {
    let b: u64 = (&rs_buf[0 as usize]) as u64
    var d: [u8; 24] = [0 as u8; 24]
    let dp: u64 = (&d[0 as usize]) as u64
    var n: u64 = 0
    var q: u64 = v
    if q == 0 {
        __mmio_write8(dp as *mut u8, 48 as u8)
        n = 1
    }
    while q > 0 && n < 24 {
        __mmio_write8((dp + n) as *mut u8, (48 + q % 10) as u8)
        q = q / 10
        n = n + 1
    }
    var a: u64 = at
    var i: u64 = n
    while i > 0 && a + 2 < 160 {
        i = i - 1
        __mmio_write8((b + a) as *mut u8, __mmio_read8((dp + i) as *mut u8))
        a = a + 1
    }
    return a
}

// EIN SCHREIBVORGANG UND NICHT ZEHN.
//
// Diese Zeile sagt einem Testlaeufer, WO er klicken muss -- seit dem
// Nachtrag zu LOOK rechnet tools/desktop/run.sh seine Klicks daraus
// aus, und tools/look/run.sh liest daraus, wo es die Ecke des
// Auswahlfelds nachmessen soll. Zusammengesetzt aus zehn Aufrufen kam
// sie auf der geteilten seriellen Leitung manchmal zerschnitten an:
//
//   settings: rect name= bg=1976635 t=Terminal -- sh
//
// und der Laeufer bekam fuer `modern` keine Geometrie, waehrend er
// fuer `classic` eine bekam. Ein Messwert, der bei jedem zweiten Lauf
// fehlt, ist schlimmer als gar keiner. Die Zeile wird jetzt in einem
// Puffer gebaut und dem Kern in EINEM `write` uebergeben -- dort ist
// die Serialisierung. Dieselbe Behandlung wie `wlib.say_painted`.
fn rect_say(name: u64, key: u64) {
    let i: usize = fuiscene.node_of_key(key)
    if i == fuiscene.NONE {
        return
    }
    rect_say_at(name, fuiscene.node_x(i), fuiscene.node_y(i),
        fuiscene.node_w(i), fuiscene.node_h(i))
}

// Z1: a node scrolled above/left of the canvas has a negative position (fuiscene.node_x/y then say 2^40):
// it is not reported (nobody can click it)
fn neg_pos(v: u64) -> bool {
    return v >= 549755813888
}

fn rect_say_at(name: u64, rx: u64, ry: u64, rw: u64, rh: u64) {
    if neg_pos(rx) || neg_pos(ry) {
        return
    }
    var at: u64 = rs_put(0, (&mr_a[0 as usize]) as u64)
    at = rs_put(at, name)
    at = rs_put(at, (&ms_b[0 as usize]) as u64)
    at = rs_num(at, rx)
    at = rs_put(at, (&ms_c[0 as usize]) as u64)
    at = rs_num(at, ry)
    at = rs_put(at, (&mr_w[0 as usize]) as u64)
    at = rs_num(at, rw)
    at = rs_put(at, (&mr_h[0 as usize]) as u64)
    at = rs_num(at, rh)
    // UND DIE LAGE AUF DEM SCHIRM, IN DEMSELBEN SATZ.
    //
    // Ein Laeufer, der klicken oder nachmessen will, braucht absolute
    // Koordinaten und musste sie bisher aus ZWEI Saetzen ausrechnen:
    // diesem und dem `name=win`. Zwei Saetze heisst zweimal die
    // Gelegenheit, dass die geteilte serielle Leitung einen davon
    // zerschneidet -- und genau das ist passiert, worauf die Messung
    // fuer `classic` gelang und fuer `modern` nicht. Ein Satz, der
    // alles enthaelt, was zu ihm gehoert, kann nur ganz oder gar nicht
    // ankommen. Der Ursprung ist Fenster + Rahmen (2) + Titel (22),
    // und das weiss dieses Programm selbst.
    at = rs_put(at, (&mr_ax[0 as usize]) as u64)
    at = rs_num(at, wlib.win_cx(w) + rx)
    at = rs_put(at, (&mr_ay[0 as usize]) as u64)
    at = rs_num(at, wlib.win_cy(w) + ry)
    let b: u64 = (&rs_buf[0 as usize]) as u64
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(b, at)
}

fn melde_stand() {
    var s_m: [u8; 24] = "settings: stand reiter=\0"
    var s_g: [u8; 14] = " geschrieben=\0"
    var s_s: [u8; 10] = " schemas=\0"
    var s_t: [u8; 10] = " status=[\0"
    var s_z: [u8; 2] = "]\0"
    say((&s_m[0 as usize]) as u64)
    sayn(reiter)
    say((&s_s[0 as usize]) as u64)
    sayn(nschema)
    say((&s_g[0 as usize]) as u64)
    sayn(geschrieben)
    say((&s_t[0 as usize]) as u64)
    say((&l_stat[0 as usize]) as u64)
    say((&s_z[0 as usize]) as u64)
    // r126: the Konten page says what it shows (status line + address book
    // line) so that a click test can read the result without a picture
    if reiter == R_KONTO {
        var s_k: [u8; 9] = " konto=[\0"
        var s_b: [u8; 8] = " book=[\0"
        say((&s_k[0 as usize]) as u64)
        say((&l_kstat[0 as usize]) as u64)
        say((&s_z[0 as usize]) as u64)
        say((&s_b[0 as usize]) as u64)
        say((&l_kbook[0 as usize]) as u64)
        say((&s_z[0 as usize]) as u64)
    }
    // r149: a package page says its status line too (the answer to the last click: asked, done, failed)
    if reiter >= R_ANZ {
        var s_p: [u8; 7] = " pkg=[\0"
        say((&s_p[0 as usize]) as u64)
        say((&pkg_stat[0 as usize]) as u64)
        say((&s_z[0 as usize]) as u64)
    }
    nl()
    nav_state_say()
}

// ==================================== ROUND THEMESTORE: reading in
//
// One scan, then one PROBE per preset. A probe is two file reads and
// two resolves (`wlibc.theme_probe`), so this is the expensive call in
// this program and it is made once, when the window opens and after
// anything changes the store. The cost is printed on the serial line
// rather than estimated in a comment.
fn tset(t: u64, f: u64, v: u64) {
    if t >= TILES || f >= wlib.TILE_FIELDS {
        return
    }
    tsp[((t * wlib.TILE_FIELDS + f)) as usize] = v
}

fn tspec_at(t: u64) -> u64 {
    return ((&tsp[0 as usize]) as u64) + t * wlib.TILE_FIELDS * 8
}

// WHERE THE COLUMNS START, MEASURED AND NOT ASSUMED.
//
// The tab bar's height is `ctrl_h` -- 26 under `classic`, 32 under
// `modern`. Read it off the widget that was just laid out; a constant
// here would put the columns under the tab bar in one appearance and
// through it in the other, and only a screenshot would ever say so.
fn columns_set(tb: u64, bw: u64, bh: u64) {
    // the scene tree lays the columns out itself
}

// WO DIE ZWEI KARTEN LIEGEN -- gesagt von dem Programm, das sie malt.
//
// Abschnitt 8 der Abnahme haelt jedes gemeldete Rechteck gegen die
// Karte, auf der es liegt. Die Karten aus der laufenden Nummer der
// Rechteckliste zu erraten (`wab`, `wac`) waere eine zweite Rechnung,
// die beim naechsten zusaetzlichen Bedienelement daneben liegt.
fn karten_say() {
    var a: [u8; 7] = "kartel\0"
    var c: [u8; 7] = "karter\0"
    // The cards are scene nodes (no keys): their rectangles come from the
    // nodes, after the layout. `karte_l`/`karte_r` are node index + 1, 0 = none.
    if karte_l != 0 {
        let i: usize = (karte_l - 1) as usize
        rect_say_at((&a[0 as usize]) as u64, fuiscene.node_x(i), fuiscene.node_y(i),
            fuiscene.node_w(i), fuiscene.node_h(i))
    }
    if karte_r != 0 {
        let i2: usize = (karte_r - 1) as usize
        rect_say_at((&c[0 as usize]) as u64, fuiscene.node_x(i2), fuiscene.node_y(i2),
            fuiscene.node_w(i2), fuiscene.node_h(i2))
    }
}

// One `wlib: tab i=<n> x= y= w= h= ax= ay= nq= nv= t=<whole name>` line per tab
// (the format wlib's tab bar used): nv = octets of the name, nq = how many of
// them fit the tab's width.
fn tabs_say() {
    var pre: [u8; 13] = "wlib: tab i=\0"
    var s_nq: [u8; 6] = " nq=\0\0"
    var s_nv: [u8; 6] = " nv=\0\0"
    var s_tt: [u8; 4] = " t=\0"
    var i: u64 = 0
    while i < R_ANZ {
        let n: usize = fuiscene.node_of_key(K_TAB0 + i)
        if n != fuiscene.NONE && !neg_pos(fuiscene.node_x(n)) && !neg_pos(fuiscene.node_y(n)) {
            let name: u64 = ((&tab_buf[0 as usize]) as u64) + i * 40
            let nv: u64 = ulib.length(name)
            var nq: u64 = nv
            let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), name, nv)
            if tw + 16 > fuiscene.node_w(n) && tw > 0 {
                nq = nv * (fuiscene.node_w(n) - 16) / tw
            }
            var at: u64 = rs_put(0, (&pre[0 as usize]) as u64)
            at = rs_num(at, i)
            at = rs_put(at, (&ms_b[0 as usize]) as u64)
            at = rs_num(at, fuiscene.node_x(n))
            at = rs_put(at, (&ms_c[0 as usize]) as u64)
            at = rs_num(at, fuiscene.node_y(n))
            at = rs_put(at, (&mr_w[0 as usize]) as u64)
            at = rs_num(at, fuiscene.node_w(n))
            at = rs_put(at, (&mr_h[0 as usize]) as u64)
            at = rs_num(at, fuiscene.node_h(n))
            at = rs_put(at, (&mr_ax[0 as usize]) as u64)
            at = rs_num(at, wlib.win_cx(w) + fuiscene.node_x(n))
            at = rs_put(at, (&mr_ay[0 as usize]) as u64)
            at = rs_num(at, wlib.win_cy(w) + fuiscene.node_y(n))
            at = rs_put(at, (&s_nq[0 as usize]) as u64)
            at = rs_num(at, nq)
            at = rs_put(at, (&s_nv[0 as usize]) as u64)
            at = rs_num(at, nv)
            at = rs_put(at, (&s_tt[0 as usize]) as u64)
            at = rs_put(at, name)
            let bb: u64 = (&rs_buf[0 as usize]) as u64
            __mmio_write8((bb + at) as *mut u8, 10 as u8)
            at = at + 1
            let _w: u64 = ulib.put(bb, at)
        }
        i = i + 1
    }
}

fn templates_read() {
    var nl: [u8; 2] = "\n\0"
    v_n = template.scan()
    var bp: u64 = 0
    var i: u64 = 0
    while i < v_n && i < TILES {
        // the list line
        bp = text_an((&v_liste[0 as usize]) as u64, bp, template.name_at(i))
        if i + 1 < v_n && i + 1 < TILES {
            bp = text_an((&v_liste[0 as usize]) as u64, bp,
                (&nl[0 as usize]) as u64)
        }
        // the tile: the RESOLVED tokens of this preset, out of the same
        // resolver the screen is painted from
        let _k: u64 = template.measure(i)
        tset(i, wlib.TL_SURFACE, wlibc.theme_probe_comp(wlibc.C_WINDOW_BG))
        tset(i, wlib.TL_RAISED, wlibc.theme_probe_comp(wlibc.C_PANEL_BG))
        tset(i, wlib.TL_ACCENT, wlibc.theme_probe_comp(wlibc.C_TITLEBAR_BG))
        tset(i, wlib.TL_ONACCENT,
            wlibc.theme_probe_comp(wlibc.C_TITLEBAR_TEXT))
        tset(i, wlib.TL_TEXT, wlibc.theme_probe_comp(wlibc.C_WINDOW_TEXT))
        tset(i, wlib.TL_FRAME, wlibc.theme_probe_comp(wlibc.C_WINDOW_FRAME))
        tset(i, wlib.TL_TASKBAR, wlibc.theme_probe_comp(wlibc.C_TASKBAR_BG))
        tset(i, wlib.TL_TBTEXT, wlibc.theme_probe_comp(wlibc.C_TASKBAR_TEXT))
        tset(i, wlib.TL_BUTTON, wlibc.theme_probe_comp(wlibc.C_BUTTON_FACE))
        tset(i, wlib.TL_DANGER, wlibc.theme_probe_comp(wlibc.C_DANGER))
        tset(i, wlib.TL_RADW,
            wlibc.theme_probe_metric(wlibc.M_RADIUS_WINDOW))
        tset(i, wlib.TL_RADB,
            wlibc.theme_probe_metric(wlibc.M_RADIUS_BUTTON))
        tset(i, wlib.TL_SHADOW, wlibc.theme_probe_metric(wlibc.M_SHADOW))
        tset(i, wlib.TL_EDGE, template.edge_at(i))
        tset(i, wlib.TL_ALIGN, template.align_at(i))
        tset(i, wlib.TL_NAME, template.name_at(i))
        tset(i, wlib.TL_LOW, template.low_at(i))
        i = i + 1
    }
    v_liste[(bp) as usize] = 0 as u8
    if v_sel >= v_n {
        v_sel = 0
    }
}

// x,y -> "4.61:1" and the word that goes with it. A number without the
// word is a number nobody reads; the word without the number is the
// sort of reassurance this repository does not print.
fn quote_kon(p: u64, at: u64, v: u64) -> u64 {
    var punkt: [u8; 2] = ".\0"
    var eins: [u8; 4] = ":1\0\0"
    var a: u64 = num_at(p, at, v / 100)
    a = text_an(p, a, (&punkt[0 as usize]) as u64)
    if v % 100 < 10 {
        var z: [u8; 2] = "0\0"
        a = text_an(p, a, (&z[0 as usize]) as u64)
    }
    a = num_at(p, a, v % 100)
    return text_an(p, a, (&eins[0 as usize]) as u64)
}

// ====================================================== RUNDE SYNC
//
// DIE SEITE LIEST NUR. Sie oeffnet drei Dateien des Kontos und eine des
// Systems und setzt daraus vier Zeilen zusammen. Sie schreibt nichts,
// sie fragt nach keiner Passphrase, und sie faellt nicht um, wenn es
// gar kein Konto gibt -- der Fall OHNE Konto ist der NORMALFALL und
// nicht der Fehlerfall.
//
//     /konto/KOPF          anbieter, ziel  (der Rest ist verschluesselt)
//     /konto/ZAEHLER       die hoechste Generation, die dieses Geraet sah
//     /konto/KONFLIKTE     ein Pfad je Zeile
//     /system/tresor.sit   da = Tresor offen, weg = zu
//
// `/konto` ist der verabredete Ort. Die Programme `sync` und `tresor`
// nehmen ihn als Argument -- ein Fenster hat aber keine Befehlszeile,
// auf der man ihn mitgeben koennte, also steht er hier fest. Das ist
// eine Verabredung und keine Einschraenkung: wer sein Konto woanders
// hat, benutzt die Befehlszeile, und die Seite sagt "kein Konto".
const Y_LESEMAX: u64 = 1024

fn sync_field(text: u64, name: u64, out: u64, max: u64) -> bool {
    // Eine Zeile "<name> <wert>" aus dem KOPF holen. Kein Katalog, kein
    // Satz -- ein Schluesselwort, das genau so in der Datei steht.
    var i: u64 = 0
    var zeilenanfang: bool = true
    while __mmio_read8((text + i) as *mut u8) != 0 as u8 {
        if zeilenanfang {
            var k: u64 = 0
            var passt: bool = true
            while __mmio_read8((name + k) as *mut u8) != 0 as u8 {
                if __mmio_read8((text + i + k) as *mut u8)
                    != __mmio_read8((name + k) as *mut u8) {
                    passt = false
                }
                k = k + 1
            }
            if passt && __mmio_read8((text + i + k) as *mut u8) == 32 as u8 {
                var q: u64 = i + k + 1
                var a: u64 = 0
                while a + 1 < max
                    && __mmio_read8((text + q) as *mut u8) != 0 as u8
                    && __mmio_read8((text + q) as *mut u8) != 10 as u8 {
                    __mmio_write8((out + a) as *mut u8,
                        __mmio_read8((text + q) as *mut u8))
                    a = a + 1
                    q = q + 1
                }
                __mmio_write8((out + a) as *mut u8, 0 as u8)
                return true
            }
        }
        zeilenanfang = __mmio_read8((text + i) as *mut u8) == 10 as u8
        i = i + 1
    }
    __mmio_write8((out) as *mut u8, 0 as u8)
    return false
}

// ====================================================================
// RUNDE BRUECKE: WAS AUF DER SEITE STEHT
// ====================================================================
//
// ZWEI QUELLEN, und sie sagen VERSCHIEDENE Dinge:
//
//   /etc/jarvis/rechte.conf  was der Helfer DUERFTE. Eine Datei, die
//                            dem Menschen gehoert und die der Helfer
//                            vor jedem Auftrag neu liest.
//   der Aufruf 1843          was gerade WIRKLICH passiert. Diese Zahl
//                            kommt aus dem KERN und nicht aus einem
//                            Programm, das behaupten koennte, es tue
//                            nichts.
//
// Die zweite ist die wichtigere. Ein Fernzugriff, der sich selbst
// bescheinigt, dass er gerade nichts tut, bescheinigt gar nichts.

// Steht `<name> = ja` in der Rechteliste? Dieselbe Regel wie
// `ja_ist` in kernel/app/jarvisd.fi: alles, was nicht ausdruecklich
// `ja` ist, gilt als nein. Gelesen wird mit `__mmio_read8`, wie
// ueberall sonst in dieser Datei.
fn conf_yes(text: u64, name: u64) -> bool {
    var i: u64 = 0
    var zeilenanfang: bool = true
    while __mmio_read8((text + i) as *mut u8) != 0 as u8 {
        if zeilenanfang {
            var k: u64 = 0
            var passt: bool = true
            while __mmio_read8((name + k) as *mut u8) != 0 as u8 {
                if __mmio_read8((text + i + k) as *mut u8)
                    != __mmio_read8((name + k) as *mut u8) {
                    passt = false
                }
                k = k + 1
            }
            if passt {
                // Leerzeichen, dann '=', dann Leerzeichen, dann "ja".
                var q: u64 = i + k
                while __mmio_read8((text + q) as *mut u8) == 32 as u8 {
                    q = q + 1
                }
                if __mmio_read8((text + q) as *mut u8) == 61 as u8 {
                    q = q + 1
                    while __mmio_read8((text + q) as *mut u8) == 32 as u8 {
                        q = q + 1
                    }
                    if __mmio_read8((text + q) as *mut u8) == 121 as u8
                        && __mmio_read8((text + q + 1) as *mut u8) == 101 as u8
                        && __mmio_read8((text + q + 2) as *mut u8) == 115 as u8 {
                        return true
                    }
                }
            }
        }
        zeilenanfang = __mmio_read8((text + i) as *mut u8) == 10 as u8
        i = i + 1
    }
    return false
}

// The bridge page texts live in the catalogue (settings.bridge.*).
static mut k_br_titel: [u8; 22] = "settings.bridge.title\0"
static mut k_br_aus: [u8; 20] = "settings.bridge.off\0"
static mut k_br_keine: [u8; 23] = "settings.bridge.nolist\0"
static mut k_br_da: [u8; 21] = "settings.bridge.list\0"
static mut k_br_foto_j: [u8; 26] = "settings.bridge.photo_yes\0"
static mut k_br_foto_n: [u8; 25] = "settings.bridge.photo_no\0"
static mut k_br_eing_j: [u8; 26] = "settings.bridge.input_yes\0"
static mut k_br_eing_n: [u8; 25] = "settings.bridge.input_no\0"
static mut k_br_tippt_j: [u8; 27] = "settings.bridge.typing_yes\0"
static mut k_br_tippt_n: [u8; 26] = "settings.bridge.typing_no\0"
static mut k_br_kein_k: [u8; 25] = "settings.bridge.nokernel\0"
static mut k_br_zahl1: [u8; 23] = "settings.bridge.count1\0"
static mut k_br_zahl2: [u8; 23] = "settings.bridge.count2\0"
static mut k_br_h1: [u8; 22] = "settings.bridge.hint1\0"
static mut k_br_h2: [u8; 22] = "settings.bridge.hint2\0"
static mut t_sp1: [u8; 2] = " \0"
static mut t_sp2: [u8; 3] = "  \0"

fn bridge_read() {
    var p_r: [u8; 29] = "/etc/jarvis/permissions.conf\0"
    var n_foto: [u8; 11] = "screenshot\0"
    var n_eing: [u8; 6] = "input\0"
    var puffer: [u8; 2048] = [0 as u8; 2048]
    let pp: u64 = (&puffer[0 as usize]) as u64
    let lt: u64 = (&l_br_titel[0 as usize]) as u64
    let ld: u64 = (&l_br_datei[0 as usize]) as u64
    let lst: u64 = (&l_br_stand[0 as usize]) as u64
    let lti: u64 = (&l_br_tippt[0 as usize]) as u64
    let lz: u64 = (&l_br_zahlen[0 as usize]) as u64
    let la: u64 = (&l_br_aus[0 as usize]) as u64
    let lh: u64 = (&l_br_hinw[0 as usize]) as u64
    let lh2: u64 = (&l_br_hinw2[0 as usize]) as u64


    let _t0: u64 = text_an(lt, 0, msg.get((&k_br_titel[0 as usize]) as u64))
    let _t1: u64 = text_an(la, 0, msg.get((&k_br_aus[0 as usize]) as u64))
    let _t2: u64 = text_an(lh, 0, msg.get((&k_br_h1[0 as usize]) as u64))
    let _t3: u64 = text_an(lh2, 0, msg.get((&k_br_h2[0 as usize]) as u64))

    // 1. Die Rechteliste.
    __mmio_write8((ld) as *mut u8, 0 as u8)
    __mmio_write8((lst) as *mut u8, 0 as u8)
    if file_read((&p_r[0 as usize]) as u64, pp, 2040) > 0 {
        let _d1: u64 = text_an(ld, 0, msg.get((&k_br_da[0 as usize]) as u64))
        var a: u64 = 0
        if conf_yes(pp, (&n_foto[0 as usize]) as u64) {
            a = text_an(lst, 0, msg.get((&k_br_foto_j[0 as usize]) as u64))
        } else {
            a = text_an(lst, 0, msg.get((&k_br_foto_n[0 as usize]) as u64))
        }
        if conf_yes(pp, (&n_eing[0 as usize]) as u64) {
            let a2: u64 = text_an(lst, a, (&t_sp2[0 as usize]) as u64)
            let _d2: u64 = text_an(lst, a2, msg.get((&k_br_eing_j[0 as usize]) as u64))
        } else {
            let a2: u64 = text_an(lst, a, (&t_sp2[0 as usize]) as u64)
            let _d3: u64 = text_an(lst, a2, msg.get((&k_br_eing_n[0 as usize]) as u64))
        }
    } else {
        let _d4: u64 = text_an(ld, 0, msg.get((&k_br_keine[0 as usize]) as u64))
    }

    // 2. Was der KERN sagt.
    let da: u64 = ulib.sys(SYS_TIPP, TI_INFO, TQ_ARMED, 0)
    __mmio_write8((lti) as *mut u8, 0 as u8)
    __mmio_write8((lz) as *mut u8, 0 as u8)
    if ulib.failed(da) {
        let _k1: u64 = text_an(lti, 0, msg.get((&k_br_kein_k[0 as usize]) as u64))
    } else {
        if da != 0 {
            let _k2: u64 = text_an(lti, 0, msg.get((&k_br_tippt_j[0 as usize]) as u64))
        } else {
            let _k3: u64 = text_an(lti, 0, msg.get((&k_br_tippt_n[0 as usize]) as u64))
        }
        var b: u64 = text_an(lz, 0, msg.get((&k_br_zahl1[0 as usize]) as u64))
        b = text_an(lz, b, (&t_sp1[0 as usize]) as u64)
        b = num_at(lz, b, ulib.sys(SYS_TIPP, TI_INFO, TQ_TOTAL, 0))
        b = text_an(lz, b, (&t_sp2[0 as usize]) as u64)
        b = text_an(lz, b, msg.get((&k_br_zahl2[0 as usize]) as u64))
        b = text_an(lz, b, (&t_sp1[0 as usize]) as u64)
        let _k4: u64 = num_at(lz, b, ulib.sys(SYS_TIPP, TI_INFO, TQ_DENIED, 0))
    }
}

// AUS. Schreibt die Rechteliste neu, mit `eingabe = nein` und
// `bildschirmfoto = nein`.
//
// ZEILENWEISE ERSETZEN UND NICHT NEU SCHREIBEN, und das ist der
// wichtige Teil: die Datei gehoert dem Menschen. Sie enthaelt seine
// Serveradresse, seine Pfadlisten und seine Kommentare. Ein Programm,
// das sie durch eine eigene Fassung ersetzt, hat sie nicht geaendert,
// sondern weggeworfen -- und der Mensch merkt es erst, wenn er das
// naechste Mal hineinsieht.
fn bridge_off() -> bool {
    var p_r: [u8; 29] = "/etc/jarvis/permissions.conf\0"
    var n_foto: [u8; 11] = "screenshot\0"
    var n_eing: [u8; 6] = "input\0"
    var alt: [u8; 2048] = [0 as u8; 2048]
    var neu: [u8; 2304] = [0 as u8; 2304]
    let ap: u64 = (&alt[0 as usize]) as u64
    let np: u64 = (&neu[0 as usize]) as u64
    if file_read((&p_r[0 as usize]) as u64, ap, 2040) == 0 {
        return false
    }
    var i: u64 = 0
    var o: u64 = 0
    var zeilenanfang: bool = true
    var hat_foto: bool = false
    var hat_eing: bool = false
    while __mmio_read8((ap + i) as *mut u8) != 0 as u8 && o < 2200 {
        if zeilenanfang && (line_begins(ap, i, (&n_foto[0 as usize]) as u64)
            || line_begins(ap, i, (&n_eing[0 as usize]) as u64)) {
            // Diese Zeile wird ERSETZT: Schluessel behalten, Wert auf
            // `nein`. Alles bis zum '=' bleibt stehen, damit die
            // Ausrichtung der Datei erhalten bleibt.
            if line_begins(ap, i, (&n_foto[0 as usize]) as u64) {
                hat_foto = true
            } else {
                hat_eing = true
            }
            while __mmio_read8((ap + i) as *mut u8) != 0 as u8
                && __mmio_read8((ap + i) as *mut u8) != 61 as u8 {
                __mmio_write8((np + o) as *mut u8,
                    __mmio_read8((ap + i) as *mut u8))
                o = o + 1
                i = i + 1
            }
            var s_nein: [u8; 5] = "= no\0"
            var k: u64 = 0
            while __mmio_read8(((&s_nein[0 as usize]) as u64 + k) as *mut u8) != 0 as u8 {
                __mmio_write8((np + o) as *mut u8,
                    __mmio_read8(((&s_nein[0 as usize]) as u64 + k) as *mut u8))
                o = o + 1
                k = k + 1
            }
            // Den Rest der alten Zeile ueberspringen.
            while __mmio_read8((ap + i) as *mut u8) != 0 as u8
                && __mmio_read8((ap + i) as *mut u8) != 10 as u8 {
                i = i + 1
            }
            zeilenanfang = false
            continue
        }
        __mmio_write8((np + o) as *mut u8, __mmio_read8((ap + i) as *mut u8))
        zeilenanfang = __mmio_read8((ap + i) as *mut u8) == 10 as u8
        o = o + 1
        i = i + 1
    }
    // FEHLTE EINE DER BEIDEN ZEILEN, kommt sie dazu. Eine Rechteliste
    // ohne `eingabe` heisst zwar schon nein (die Voreinstellung ist
    // nein), aber nach einem Druck auf "aus" soll dastehen, DASS es
    // aus ist -- sonst sieht der Mensch beim naechsten Blick eine
    // Datei, die von seinem Knopfdruck nichts weiss.
    if !hat_foto {
        var z1: [u8; 17] = "\nscreenshot = no\0"
        o = o + copy_until_null((&z1[0 as usize]) as u64, np + o)
    }
    if !hat_eing {
        var z2: [u8; 12] = "\ninput = no\0"
        o = o + copy_until_null((&z2[0 as usize]) as u64, np + o)
    }
    __mmio_write8((np + o) as *mut u8, 0 as u8)
    return file_write((&p_r[0 as usize]) as u64, np, o)
}

fn copy_until_null(von: u64, move_to: u64) -> u64 {
    var k: u64 = 0
    while __mmio_read8((von + k) as *mut u8) != 0 as u8 {
        __mmio_write8((move_to + k) as *mut u8, __mmio_read8((von + k) as *mut u8))
        k = k + 1
    }
    return k
}

// Beginnt bei `at` eine Zeile mit diesem Schluessel? Es reicht NICHT,
// dass der Name vorkommt: `eingabe` steht auch in `eingabe_alt`. Also
// muss danach ein Leerzeichen oder ein `=` folgen.
fn line_begins(text: u64, at: u64, name: u64) -> bool {
    var k: u64 = 0
    while __mmio_read8((name + k) as *mut u8) != 0 as u8 {
        if __mmio_read8((text + at + k) as *mut u8)
            != __mmio_read8((name + k) as *mut u8) {
            return false
        }
        k = k + 1
    }
    let c: u8 = __mmio_read8((text + at + k) as *mut u8)
    return c == 32 as u8 || c == 61 as u8 || c == 9 as u8
}

fn sync_read() {
    var p_kopf: [u8; 12] = "/konto/KOPF\0"
    var p_zaehl: [u8; 15] = "/konto/ZAEHLER\0"
    var p_konf: [u8; 17] = "/konto/KONFLIKTE\0"
    var p_sit: [u8; 19] = "/system/tresor.sit\0"
    var n_anb: [u8; 9] = "anbieter\0"
    var n_ziel: [u8; 5] = "ziel\0"
    var puffer: [u8; 1024] = [0 as u8; 1024]
    var wert: [u8; 128] = [0 as u8; 128]
    let pp: u64 = (&puffer[0 as usize]) as u64
    let wp: u64 = (&wert[0 as usize]) as u64
    let lp: u64 = (&l_yprov[0 as usize]) as u64
    let lz: u64 = (&l_yziel[0 as usize]) as u64
    let ls: u64 = (&l_ystand[0 as usize]) as u64
    let lt: u64 = (&l_ytres[0 as usize]) as u64
    y_konto = 0
    __mmio_write8((lp) as *mut u8, 0 as u8)
    __mmio_write8((lz) as *mut u8, 0 as u8)
    __mmio_write8((ls) as *mut u8, 0 as u8)
    if file_read((&p_kopf[0 as usize]) as u64, pp, Y_LESEMAX) > 0 {
        y_konto = 1
        var a: u64 = text_an(lp, 0, msg.get((&k_y_prov[0 as usize]) as u64))
        if sync_field(pp, (&n_anb[0 as usize]) as u64, wp, 128) {
            a = text_an(lp, a, wp)
        }
        var b: u64 = text_an(lz, 0, msg.get((&k_y_ziel[0 as usize]) as u64))
        if sync_field(pp, (&n_ziel[0 as usize]) as u64, wp, 128) {
            b = text_an(lz, b, wp)
        }
        var c: u64 = text_an(ls, 0, msg.get((&k_y_stand[0 as usize]) as u64))
        var gen: u64 = 0
        if file_read((&p_zaehl[0 as usize]) as u64, pp, Y_LESEMAX) > 0 {
            gen = num_from(pp)
        }
        let _c2: u64 = num_at(ls, c, gen)
    }
    // Der Tresor: die Sitzungsdatei ist da oder sie ist es nicht. Mehr
    // will diese Seite gar nicht wissen -- ob die Frist schon abgelaufen
    // ist, weiss `tresor` selbst, und die Seite luegen zu lassen waere
    // schlimmer als sie ungenau sein zu lassen.
    let t: u64 = text_an(lt, 0, msg.get((&k_y_tres[0 as usize]) as u64))
    if file_read((&p_sit[0 as usize]) as u64, pp, Y_LESEMAX) > 0 {
        let _t1: u64 = text_an(lt, t, msg.get((&k_y_auf[0 as usize]) as u64))
    } else {
        let _t2: u64 = text_an(lt, t, msg.get((&k_y_zu[0 as usize]) as u64))
    }
    // Die Konflikte, ein Pfad je Zeile -- genau das Format, das die
    // Listenanzeige erwartet.
    y_kn = 0
    let kb: u64 = (&y_konf[0 as usize]) as u64
    __mmio_write8((kb) as *mut u8, 0 as u8)
    if file_read((&p_konf[0 as usize]) as u64, pp, Y_LESEMAX) > 0 {
        var i: u64 = 0
        var o: u64 = 0
        while __mmio_read8((pp + i) as *mut u8) != 0 as u8 && o + 2 < 640 {
            let ch: u64 = __mmio_read8((pp + i) as *mut u8) as u64
            if ch == 10 {
                if o > 0 && __mmio_read8((kb + o - 1) as *mut u8) != 10 as u8 {
                    __mmio_write8((kb + o) as *mut u8, 10 as u8)
                    o = o + 1
                    y_kn = y_kn + 1
                }
            } else {
                __mmio_write8((kb + o) as *mut u8, ch as u8)
                o = o + 1
            }
            i = i + 1
        }
        if o > 0 && __mmio_read8((kb + o - 1) as *mut u8) != 10 as u8 {
            y_kn = y_kn + 1
        }
        __mmio_write8((kb + o) as *mut u8, 0 as u8)
    }
}

fn template_con_show() {
    let k: u64 = (&l_vkon[0 as usize]) as u64
    if v_n == 0 {
        __mmio_write8((k) as *mut u8, 0 as u8)
        return
    }
    let _m: u64 = template.measure(v_sel)
    var a: u64 = text_an(k, 0, template.name_at(v_sel))
    a = text_an(k, a, msg.get((&k_v_ok[0 as usize]) as u64))
    a = quote_kon(k, a, template.m_min())
    if template.low_at(v_sel) != 0 {
        let _b: u64 = text_an(k, a, msg.get((&k_v_low[0 as usize]) as u64))
    }
}

fn account_show() {
    let k: u64 = (&l_vkonto[0 as usize]) as u64
    if template.account_have() {
        let a: u64 = text_an(k, 0, msg.get((&k_v_acc[0 as usize]) as u64))
        let _b: u64 = text_an(k, a, template.account_dir())
    } else {
        let _c: u64 = text_an(k, 0, msg.get((&k_v_noacc[0 as usize]) as u64))
    }
}

// ONE LINE PER PRESET ON THE SERIAL PORT, so that a runner can check
// what the tiles are showing without reading pixels -- and then check
// the pixels against it.
fn vorlage_say() {
    var a: [u8; 18] = "settings: preset \0"
    var k1: [u8; 3] = "i=\0"
    var k2: [u8; 5] = " id=\0"
    var k3: [u8; 6] = " min=\0"
    var k4: [u8; 6] = " low=\0"
    var k5: [u8; 5] = " bg=\0"
    var k6: [u8; 6] = " txt=\0"
    var k7: [u8; 6] = " acc=\0"
    var k8: [u8; 6] = " sel=\0"
    var i: u64 = 0
    while i < v_n && i < TILES {
        let _m: u64 = template.measure(i)
        say((&a[0 as usize]) as u64)
        say((&k1[0 as usize]) as u64)
        sayn(i)
        say((&k2[0 as usize]) as u64)
        say(template.id_at(i))
        say((&k3[0 as usize]) as u64)
        sayn(template.m_min())
        say((&k4[0 as usize]) as u64)
        sayn(template.low_at(i))
        say((&k5[0 as usize]) as u64)
        sayn(tsp[((i * wlib.TILE_FIELDS + wlib.TL_SURFACE)) as usize])
        say((&k6[0 as usize]) as u64)
        sayn(tsp[((i * wlib.TILE_FIELDS + wlib.TL_TEXT)) as usize])
        say((&k7[0 as usize]) as u64)
        sayn(tsp[((i * wlib.TILE_FIELDS + wlib.TL_ACCENT)) as usize])
        say((&k8[0 as usize]) as u64)
        sayn(v_sel)
        nl()
        i = i + 1
    }
}

// ==================================================== RUNDE KONTO
//
// DIE OBERFLAECHE MACHT KEINE ANMELDUNG. Sie kann es gar nicht: dieses
// Programm ist `profile kernel` -- freistehend, ohne Halde --, und ein
// TLS-Aufzeichnungslayer braucht eine Halde (die Begruendung steht im
// Kopf von kernel/app/fetch.fi und gilt hier Wort fuer Wort). Also ruft
// sie `/bin/konto` auf, das `--profile=app` gebaut ist, und liest
// dessen Zeilen.
//
// DAS KENNWORT GEHT DURCH EIN ROHR. Nicht ueber `argv` (das steht in
// jeder Prozessliste), nicht ueber eine Datei (die stuende auf der
// Platte, und sei es nur fuer Millisekunden), nicht ueber eine
// Umgebungsvariable (die erbt jedes Kind weiter). `pipe`, hineinschreiben,
// Schreibende zumachen, Leseende auf Deskriptor 0 -- genau so, wie die
// Shell dieses Systems eine Roehre baut (kernel/user/sh.fi).
// ---------------------------------------------- RUNDE KONTO: die Adresse
//
// DIE SEITE MERKT SICH DIE ADRESSE, nicht das Konto. Was der Nutzer in
// "Serveradresse" und "Name im Zertifikat" eintraegt, gehoert zu einem
// ANBIETER und nicht zu einer Anmeldung -- also wandert es in
// `/etc/konten.conf`, eine Zeile je Anbieter, und steht beim naechsten
// Mal schon da. Zwei Gruende, und beide zaehlen:
//
//   1. Bequemlichkeit: eine Adresse tippt man einmal.
//   2. NOTWENDIGKEIT: `proc.MAX_ARGS` ist 8. Mit `--ziel=` und
//      `--name=` auf der Befehlszeile bliebe fuer Organisation und
//      zweiten Faktor kein Platz mehr, und es wuerde ausgerechnet dem
//      Nutzer um die Ohren fliegen, der beides braucht.
//
// IN DIESER DATEI STEHT KEIN GEHEIMNIS. Nur Adressen; das Kennwort geht
// durch das Rohr an `/bin/konto` und sonst nirgendwohin.
fn conf_remember(anbieter: u64, ziel: u64, zname: u64) -> bool {
    if *((ziel) as *mut u8) == 0 as u8 {
        return false
    }
    var alt: [u8; 1024] = [0 as u8; 1024]
    var neu: [u8; 1280] = [0 as u8; 1280]
    var pfad: [u8; 18] = "/etc/konten.conf\0\0"
    let n: u64 = file_read((&pfad[0 as usize]) as u64,
        (&alt[0 as usize]) as u64, 1024)
    var aus: u64 = 0
    // Alle Zeilen uebernehmen, AUSSER der dieses Anbieters -- die wird
    // ersetzt und nicht verdoppelt.
    var i: u64 = 0
    while i < n {
        var e: u64 = i
        while e < n && alt[(e) as usize] != 10 as u8 {
            e = e + 1
        }
        // Ist das die Zeile dieses Anbieters? Dann faellt sie weg und
        // wird unten neu geschrieben. Der Name muss GANZ passen und ein
        // Trenner muss folgen -- sonst wuerde `xoffi` auch `xoffi2`
        // treffen.
        var gleich: bool = true
        var k: u64 = 0
        while *((anbieter + k) as *mut u8) != 0 as u8 {
            if i + k >= e || alt[((i + k)) as usize]
                != *((anbieter + k) as *mut u8) {
                gleich = false
            }
            k = k + 1
        }
        if gleich {
            if i + k >= e {
                gleich = false
            } else if alt[((i + k)) as usize] != 32 as u8
                && alt[((i + k)) as usize] != 9 as u8 {
                gleich = false
            }
        }
        if !gleich && e > i {
            var c: u64 = i
            while c < e && aus + 1 < 1280 {
                neu[(aus) as usize] = alt[(c) as usize]
                aus = aus + 1
                c = c + 1
            }
            neu[(aus) as usize] = 10 as u8
            aus = aus + 1
        }
        i = e + 1
    }
    // und die eigene Zeile ans Ende
    var f_zi: [u8; 7] = " ziel=\0"
    var f_na: [u8; 7] = " name=\0"
    aus = anhaengen_c((&neu[0 as usize]) as u64, aus, 1280, anbieter)
    aus = anhaengen_c((&neu[0 as usize]) as u64, aus, 1280,
        (&f_zi[0 as usize]) as u64)
    aus = anhaengen_c((&neu[0 as usize]) as u64, aus, 1280, ziel)
    if *((zname) as *mut u8) != 0 as u8 {
        aus = anhaengen_c((&neu[0 as usize]) as u64, aus, 1280,
            (&f_na[0 as usize]) as u64)
        aus = anhaengen_c((&neu[0 as usize]) as u64, aus, 1280, zname)
    }
    if aus + 1 < 1280 {
        neu[(aus) as usize] = 10 as u8
        aus = aus + 1
    }
    return file_write((&pfad[0 as usize]) as u64,
        (&neu[0 as usize]) as u64, aus)
}

fn anhaengen_c(ziel: u64, at: u64, max: u64, was: u64) -> u64 {
    var a: u64 = at
    var i: u64 = 0
    while *((was + i) as *mut u8) != 0 as u8 && a + 1 < max {
        *((ziel + a) as *mut u8) = *((was + i) as *mut u8)
        a = a + 1
        i = i + 1
    }
    return a
}

// `--name=` und der Wert dahinter, in EINEM Wort. Leerer Wert -> es
// entsteht kein Wort, und der Aufruf bleibt kurz. Rueckgabe: ob das
// Wort entstanden ist.
fn opt_word(ziel: u64, max: u64, vorsatz: u64, wert: u64) -> bool {
    if *((wert) as *mut u8) == 0 as u8 {
        return false
    }
    var i: u64 = 0
    while *((vorsatz + i) as *mut u8) != 0 as u8 && i + 1 < max {
        *((ziel + i) as *mut u8) = *((vorsatz + i) as *mut u8)
        i = i + 1
    }
    var j: u64 = 0
    while *((wert + j) as *mut u8) != 0 as u8 && i + 1 < max {
        *((ziel + i) as *mut u8) = *((wert + j) as *mut u8)
        i = i + 1
        j = j + 1
    }
    *((ziel + i) as *mut u8) = 0 as u8
    return true
}

fn konto_lauf(argv: u64, argc: u64, geheim: u64) -> u64 {
    var t_bin: [u8; 11] = "/bin/konto\0"
    return prog_run((&t_bin[0 as usize]) as u64, argv, argc, geheim)
}

// Run `bin` with argv, its stdout into k_aus (same descriptor dance for
// every helper program this page asks something).
fn prog_run(bin: u64, argv: u64, argc: u64, geheim: u64) -> u64 {
    var t_tmp: [u8; 5] = "/tmp\0"
    var t_aus: [u8; 16] = "/tmp/konto.aus\0\0"
    var nlz: [u8; 2] = "\n\0"
    k_ausn = 0
    k_aus[(0) as usize] = 0 as u8
    let _md: u64 = ulib.sys(ulib.SYS_MKDIR, (&t_tmp[0 as usize]) as u64,
        448, 0)
    let s0: u64 = ulib.sys(ulib.SYS_DUP, 0, 0, 0)
    let s1: u64 = ulib.sys(ulib.SYS_DUP, 1, 0, 0)
    var fds: [u32; 2] = [0 as u32; 2]
    var haben_rohr: bool = false
    if geheim != 0 {
        if !ulib.bad(ulib.sys(SYS_PIPE, (&fds[0 as usize]) as u64, 0, 0)) {
            haben_rohr = true
            let wfd: u64 = fds[(1) as usize] as u64
            let n: u64 = ulib.length(geheim)
            if n > 0 {
                let _w1: u64 = ulib.sys(ulib.SYS_WRITE, wfd, geheim, n)
            }
            let _w2: u64 = ulib.sys(ulib.SYS_WRITE, wfd,
                (&nlz[0 as usize]) as u64, 1)
            ulib.sys(ulib.SYS_CLOSE, wfd, 0, 0)
            ulib.sys(ulib.SYS_DUP2, fds[(0) as usize] as u64, 0, 0)
        }
    }
    let afd: u64 = ulib.sys(ulib.SYS_OPEN, (&t_aus[0 as usize]) as u64,
        ulib.O_MAKE, 384)
    if !ulib.bad(afd) {
        ulib.sys(ulib.SYS_DUP2, afd, 1, 0)
        ulib.sys(ulib.SYS_CLOSE, afd, 0, 0)
    }
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, bin,
        argv, argc)
    if !ulib.bad(s0) {
        ulib.sys(ulib.SYS_DUP2, s0, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, s0, 0, 0)
    }
    if !ulib.bad(s1) {
        ulib.sys(ulib.SYS_DUP2, s1, 1, 0)
        ulib.sys(ulib.SYS_CLOSE, s1, 0, 0)
    }
    if haben_rohr {
        ulib.sys(ulib.SYS_CLOSE, fds[(0) as usize] as u64, 0, 0)
    }
    if ulib.bad(pid) {
        return 255
    }
    let code: u64 = ulib.wait_code(pid)
    let rfd: u64 = ulib.sys(ulib.SYS_OPEN, (&t_aus[0 as usize]) as u64,
        0, 0)
    if !ulib.bad(rfd) {
        let n: u64 = ulib.sys(ulib.SYS_READ, rfd,
            (&k_aus[0 as usize]) as u64, 4095)
        ulib.sys(ulib.SYS_CLOSE, rfd, 0, 0)
        if !ulib.bad(n) {
            k_ausn = n
            k_aus[(n) as usize] = 0 as u8
        }
    }
    return code
}

// Den Wert hinter `konto: <name> = ` aus der letzten Ausgabe holen.
fn account_field(name: u64, aus: u64, max: u64) -> bool {
    var kopf: [u8; 8] = "konto: \0"
    __mmio_write8((aus) as *mut u8, 0 as u8)
    var i: u64 = 0
    while i < k_ausn {
        var e: u64 = i
        while e < k_ausn && k_aus[(e) as usize] != 10 as u8 {
            e = e + 1
        }
        var p: u64 = i
        var passt: bool = true
        var q: u64 = 0
        while q < 7 {
            if p + q >= e || k_aus[((p + q)) as usize]
                != __mmio_read8(((&kopf[0 as usize]) as u64 + q) as *mut u8) {
                passt = false
                q = 7
            } else {
                q = q + 1
            }
        }
        if passt {
            p = p + 7
            var m: u64 = 0
            var gleich: bool = true
            while __mmio_read8((name + m) as *mut u8) != 0 as u8 {
                if p + m >= e || k_aus[((p + m)) as usize]
                    != __mmio_read8((name + m) as *mut u8) {
                    gleich = false
                }
                m = m + 1
            }
            if gleich && p + m + 3 <= e && k_aus[((p + m)) as usize] == 32 as u8
                && k_aus[((p + m + 1)) as usize] == 61 as u8 {
                var v: u64 = p + m + 3
                var k: u64 = 0
                while v < e && k + 1 < max {
                    __mmio_write8((aus + k) as *mut u8,
                        k_aus[(v) as usize])
                    k = k + 1
                    v = v + 1
                }
                __mmio_write8((aus + k) as *mut u8, 0 as u8)
                return true
            }
        }
        i = e + 1
    }
    return false
}

// Die Anbieter, die es WIRKLICH gibt -- gefragt wird `/bin/konto`, nicht
// dieser Quelltext. Ein Anbietername steht damit an genau einer Stelle
// im ganzen System (kernel/app/konto.fi), und ein vierter Ruecken
// erscheint hier von selbst.
fn provider_read() {
    var argv: [u64; 2] = [0 as u64; 2]
    var a0: [u8; 11] = "/bin/konto\0"
    var a1: [u8; 9] = "anbieter\0"
    argv[(0) as usize] = (&a0[0 as usize]) as u64
    argv[(1) as usize] = (&a1[0 as usize]) as u64
    let _c: u64 = konto_lauf((&argv[0 as usize]) as u64, 2, 0)
    var name: [u8; 14] = "anbieter_name\0"
    var kopf: [u8; 8] = "konto: \0"
    k_anb_n = 0
    var bp: u64 = 0
    var i: u64 = 0
    while i < k_ausn {
        var e: u64 = i
        while e < k_ausn && k_aus[(e) as usize] != 10 as u8 {
            e = e + 1
        }
        var passt: bool = true
        var q: u64 = 0
        while q < 7 {
            if i + q >= e || k_aus[((i + q)) as usize]
                != __mmio_read8(((&kopf[0 as usize]) as u64 + q) as *mut u8) {
                passt = false
                q = 7
            } else {
                q = q + 1
            }
        }
        if passt {
            var m: u64 = 0
            var gleich: bool = true
            while __mmio_read8(((&name[0 as usize]) as u64 + m) as *mut u8)
                != 0 as u8 {
                if i + 7 + m >= e || k_aus[((i + 7 + m)) as usize]
                    != __mmio_read8(((&name[0 as usize]) as u64 + m)
                        as *mut u8) {
                    gleich = false
                }
                m = m + 1
            }
            if gleich {
                var v: u64 = i + 7 + m + 3
                if k_anb_n > 0 && bp + 1 < 255 {
                    k_anbn[(bp) as usize] = 10 as u8
                    bp = bp + 1
                }
                while v < e && bp + 1 < 255 {
                    k_anbn[(bp) as usize] = k_aus[(v) as usize]
                    bp = bp + 1
                    v = v + 1
                }
                k_anb_n = k_anb_n + 1
            }
        }
        i = e + 1
    }
    k_anbn[(bp) as usize] = 0 as u8
}

// Die Kontenliste fuer das Listenfeld. GELESEN WIRD /etc/konten -- eine
// gewoehnliche Textdatei ohne ein einziges Geheimnis darin. Angezeigt
// wird "<anbieter>  <anzeige>", und die Kennung steht dahinter, weil
// der Abmeldeknopf sie braucht.
// Two NUL-terminated texts equal?
fn book_same(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while __mmio_read8((a + i) as *mut u8) != 0 as u8 {
        if __mmio_read8((a + i) as *mut u8) != __mmio_read8((b + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return __mmio_read8((b + i) as *mut u8) == 0 as u8
}

// The message KEY for the result of `konto anmelden ... --exchange`
// (the line `konto: exchange = <word>`, old `tausch`; the sign-in itself stands in every
// case, only the swap with the address book differs). Pure: the word and
// the hint text in, a catalogue key out -- the page never sees a provider.
//   ok -> .ok, offline (old: keinnetz) -> .offline, denied (old: abgelehnt) -> .refused (or .noscope when
//   the hint is the missing-scope one), anything else -> .failed
fn book_key(word: u64, hint: u64) -> u64 {
    var w_ok: [u8; 3] = "ok\0"
    var w_net: [u8; 8] = "offline\0"
    var w_ab: [u8; 7] = "denied\0"
    // the first spelling of these words (still accepted)
    var w_net_old: [u8; 9] = "keinnetz\0"
    var w_ab_old: [u8; 10] = "abgelehnt\0"
    if book_same(word, (&w_ok[0 as usize]) as u64) {
        return (&k_m_bok[0 as usize]) as u64
    }
    if book_same(word, (&w_net[0 as usize]) as u64)
        || book_same(word, (&w_net_old[0 as usize]) as u64) {
        return (&k_m_bnet[0 as usize]) as u64
    }
    if book_same(word, (&w_ab[0 as usize]) as u64)
        || book_same(word, (&w_ab_old[0 as usize]) as u64) {
        if hint != 0 && book_same(hint, msg.get((&k_m_nscope[0 as usize]) as u64)) {
            return (&k_m_bscope[0 as usize]) as u64
        }
        return (&k_m_bref[0 as usize]) as u64
    }
    return (&k_m_bfail[0 as usize]) as u64
}

// "Address book: connected / not connected". Asked of the helper program
// that owns the book (`hello` prints an `account` line only when a token
// of the right shape is stored; the token itself is never printed or read
// here). No network is touched.
fn book_state() {
    var b_bin: [u8; 16] = "/bin/socfleitec\0"
    var b_v1: [u8; 3] = "v1\0"
    var b_he: [u8; 6] = "hello\0"
    var bargv: [u64; 4] = [0 as u64; 4]
    bargv[0] = (&b_bin[0 as usize]) as u64
    bargv[1] = (&b_v1[0 as usize]) as u64
    bargv[2] = (&b_he[0 as usize]) as u64
    let rc: u64 = prog_run((&b_bin[0 as usize]) as u64, (&bargv[0 as usize]) as u64, 3, 0)
    var da: bool = false
    if rc == 0 {
        var i: u64 = 0
        while i + 8 <= k_ausn {
            if (i == 0 || k_aus[((i - 1)) as usize] == 10 as u8)
                && k_aus[(i) as usize] == 97 as u8 && k_aus[((i + 1)) as usize] == 99 as u8
                && k_aus[((i + 2)) as usize] == 99 as u8 && k_aus[((i + 3)) as usize] == 111 as u8
                && k_aus[((i + 4)) as usize] == 117 as u8 && k_aus[((i + 5)) as usize] == 110 as u8
                && k_aus[((i + 6)) as usize] == 116 as u8 && k_aus[((i + 7)) as usize] == 9 as u8 {
                da = true
            }
            i = i + 1
        }
    }
    var at: u64 = text_an((&l_kbook[0 as usize]) as u64, 0, msg.get((&k_k_bstat[0 as usize]) as u64))
    if da {
        let _x: u64 = text_an((&l_kbook[0 as usize]) as u64, at, msg.get((&k_k_bon[0 as usize]) as u64))
    } else {
        let _x: u64 = text_an((&l_kbook[0 as usize]) as u64, at, msg.get((&k_k_boff[0 as usize]) as u64))
    }
}

fn accounts_read() {
    var pfad: [u8; 12] = "/etc/konten\0"
    var roh: [u8; 1024] = [0 as u8; 1024]
    k_n = 0
    k_liste[(0) as usize] = 0 as u8
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&pfad[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&roh[0 as usize]) as u64,
        1023)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return
    }
    var bp: u64 = 0
    var i: u64 = 0
    while i < n {
        var e: u64 = i
        while e < n && roh[(e) as usize] != 10 as u8 {
            e = e + 1
        }
        if e > i {
            // Feld 1 (anbieter) und Feld 4 (anzeige) aus der Zeile
            var f: u64 = 0
            var a: u64 = i
            var von1: u64 = i
            var bis1: u64 = i
            var von4: u64 = i
            var bis4: u64 = i
            var k: u64 = i
            while k <= e {
                if k == e || roh[(k) as usize] == 9 as u8 {
                    if f == 1 {
                        von1 = a
                        bis1 = k
                    }
                    if f == 4 {
                        von4 = a
                        bis4 = k
                    }
                    f = f + 1
                    a = k + 1
                }
                k = k + 1
            }
            if k_n > 0 && bp + 1 < 1023 {
                k_liste[(bp) as usize] = 10 as u8
                bp = bp + 1
            }
            var v: u64 = von1
            while v < bis1 && bp + 1 < 1023 {
                k_liste[(bp) as usize] = roh[(v) as usize]
                bp = bp + 1
                v = v + 1
            }
            if bp + 2 < 1023 {
                k_liste[(bp) as usize] = 32 as u8
                k_liste[((bp + 1)) as usize] = 32 as u8
                bp = bp + 2
            }
            v = von4
            while v < bis4 && bp + 1 < 1023 {
                k_liste[(bp) as usize] = roh[(v) as usize]
                bp = bp + 1
                v = v + 1
            }
            k_n = k_n + 1
        }
        i = e + 1
    }
    k_liste[(bp) as usize] = 0 as u8
}

// Die Kennung des Kontos Nummer `k` aus /etc/konten (Feld 0).
fn konto_kennung(k: u64, aus: u64, max: u64) -> bool {
    var pfad: [u8; 12] = "/etc/konten\0"
    var roh: [u8; 1024] = [0 as u8; 1024]
    __mmio_write8((aus) as *mut u8, 0 as u8)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&pfad[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return false
    }
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&roh[0 as usize]) as u64,
        1023)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return false
    }
    var nr: u64 = 0
    var i: u64 = 0
    while i < n {
        var e: u64 = i
        while e < n && roh[(e) as usize] != 10 as u8 {
            e = e + 1
        }
        if e > i {
            if nr == k {
                var v: u64 = i
                var o: u64 = 0
                while v < e && roh[(v) as usize] != 9 as u8 && o + 1 < max {
                    __mmio_write8((aus + o) as *mut u8, roh[(v) as usize])
                    o = o + 1
                    v = v + 1
                }
                __mmio_write8((aus + o) as *mut u8, 0 as u8)
                return o > 0
            }
            nr = nr + 1
        }
        i = e + 1
    }
    return false
}

// ROUND ACTION-BUS-3: the two bus pages read the broker when shown
fn bus_page(r: u64) {
    if r == R_APPS {
        ap_sel = AP_NONE
        ap_arm = 0
        __mmio_write8((&l_apstat[0 as usize]) as u64 as *mut u8, 0 as u8)
        ap_load()
    }
    if r == R_ENERGIE {
        pw_load()
    }
    if r == R_MAUS {
        mouse_load()
    }
    if r == R_UPDATE {
        // the status line of the page starts empty (it is the one the
        // page System uses too and would show that page's last answer)
        __mmio_write8((&l_systat[0 as usize]) as u64 as *mut u8, 0 as u8)
        upd_show()
    }
    if r == R_PROTO {
        proto_load()
    }
    if r == R_SYSTEM {
        sys_load()
    }
    if r == R_RECHTE {
        rights_load()
    }
}

fn zeige_reiter(r: u64) {
    if r != reiter {
        fuiscene.pane_top(0)
    }
    reiter = r
    setroute.note_page(r)
    if r >= R_ANZ {
        pkg_enter(r - R_ANZ)
    }
    fuiscene.refresh()
    rep_due = 1
}

// ROUND ACTION-BUS-3: the controls of the two bus pages under names that
// do not move when a widget is added elsewhere (tools/actionbus/gui.sh
// clicks them)
fn nav_rects() {
    var n_b: [u8; 8] = "navback\0"
    var n_f: [u8; 7] = "navfwd\0"
    var n_u: [u8; 6] = "navup\0"
    var n_c: [u8; 10] = "navcrumb?\0"
    rect_say((&n_b[0 as usize]) as u64, K_NAVBACK)
    rect_say((&n_f[0 as usize]) as u64, K_NAVFWD)
    rect_say((&n_u[0 as usize]) as u64, K_NAVUP)
    var ci: u64 = 0
    while ci < navview.shown_count() {
        n_c[(8) as usize] = (97 + ci) as u8
        rect_say((&n_c[0 as usize]) as u64, K_CRUMB0 + ci)
        ci = ci + 1
    }
}

fn bus_rects() {
    nav_rects()
    // every tab as a rectangle too ("taba", "tabb", ...): a runner then
    // switches pages by clicking the tab, like a person, in ONE window
    var k: u64 = 0
    while k < R_ANZ {
        var nm: [u8; 6] = "tab??\0"
        if k < 26 {
            nm[(3) as usize] = (97 + k) as u8
            nm[(4) as usize] = 0 as u8
        } else {
            nm[(3) as usize] = (48 + k / 10) as u8
            nm[(4) as usize] = (48 + k % 10) as u8
        }
        rect_say((&nm[0 as usize]) as u64, K_TAB0 + k)
        k = k + 1
    }
    // package pages (/apps/<app>.prog/SETTINGS): the sidebar entries as "ptaba" .. "ptabh" (sidebar
    // order), and the controls of the page that shows as "pfaa" .. (two letters = catalogue item number)
    var pk: u64 = 0
    while pk < pkg_n && pk < 8 {
        var pn: [u8; 7] = "ptab?\0\0"
        pn[(4) as usize] = (97 + pk) as u8
        rect_say((&pn[0 as usize]) as u64, K_PKGTAB0 + pk)
        pk = pk + 1
    }
    if reiter >= R_ANZ && reiter - R_ANZ < pkg_n {
        let pg0: u64 = pkg_pg[(reiter - R_ANZ) as usize]
        let f0: u64 = manifest.page_first(pg0)
        var pi: u64 = f0
        while pi < f0 + manifest.page_len(pg0) && pi - f0 < 80 {
            if fuiscene.node_of_key(K_PKGF0 + pi) != fuiscene.NONE {
                var pfn: [u8; 5] = "pf??\0"
                pfn[(2) as usize] = (97 + (pi / 26) % 26) as u8
                pfn[(3) as usize] = (97 + pi % 26) as u8
                rect_say((&pfn[0 as usize]) as u64, K_PKGF0 + pi)
            }
            pi = pi + 1
        }
    }
    if reiter == R_SYSTEM {
        var n1: [u8; 5] = "stab\0"
        var n2: [u8; 5] = "sent\0"
        var n3: [u8; 5] = "sset\0"
        var n4: [u8; 6] = "sconf\0"
        var n5: [u8; 6] = "sundo\0"
        rect_say((&n1[0 as usize]) as u64, sy_tab)
        rect_say((&n2[0 as usize]) as u64, sy_ent)
        rect_say((&n3[0 as usize]) as u64, sy_bset)
        rect_say((&n4[0 as usize]) as u64, sy_bconf)
        rect_say((&n5[0 as usize]) as u64, sy_bundo)
        var s_rh: [u8; 16] = "settings: rowh=\0"
        let _p: u64 = ulib.put((&s_rh[0 as usize]) as u64, 15)
        ulib.sayn(fuiscene.table_row_h(sy_tab))
        ulib.nl()
    }
    if reiter == R_ENERGIE {
        var e1: [u8; 6] = "plidb\0"
        var e2: [u8; 6] = "plida\0"
        var e3: [u8; 6] = "pscrb\0"
        var e4: [u8; 6] = "pscra\0"
        var e5: [u8; 6] = "psbyb\0"
        var e6: [u8; 6] = "psbya\0"
        var e7: [u8; 7] = "pprofb\0"
        var e8: [u8; 7] = "pprofa\0"
        rect_say((&e1[0 as usize]) as u64, K_PW_LB)
        rect_say((&e2[0 as usize]) as u64, K_PW_LA)
        rect_say((&e3[0 as usize]) as u64, K_PW_SB)
        rect_say((&e4[0 as usize]) as u64, K_PW_SA)
        rect_say((&e5[0 as usize]) as u64, K_PW_YB)
        rect_say((&e6[0 as usize]) as u64, K_PW_YA)
        rect_say((&e7[0 as usize]) as u64, K_PW_PB)
        rect_say((&e8[0 as usize]) as u64, K_PW_PA)
    }
    if reiter == R_APPS {
        ap_rects()
    }
    if reiter == R_INFO {
        var i1: [u8; 6] = "ibexp\0"
        rect_say((&i1[0 as usize]) as u64, K_IN_BEXP)
    }
    if reiter == R_MAUS {
        var m1: [u8; 7] = "mspeed\0"
        var m2: [u8; 7] = "maccel\0"
        var m3: [u8; 5] = "mnat\0"
        var m4: [u8; 5] = "mges\0"
        var m5: [u8; 5] = "mfps\0"
        rect_say((&m1[0 as usize]) as u64, K_MS_SPD)
        rect_say((&m2[0 as usize]) as u64, K_MS_ACC)
        rect_say((&m3[0 as usize]) as u64, K_MS_NAT)
        rect_say((&m4[0 as usize]) as u64, K_MS_GES)
        rect_say((&m5[0 as usize]) as u64, K_MS_FPS)
    }
    if reiter == R_KONTO {
        // r126: the two device-flow buttons, so a runner can click them
        var o1: [u8; 5] = "kdev\0"
        var o2: [u8; 6] = "kbook\0"
        rect_say((&o1[0 as usize]) as u64, K_BKDEV)
        rect_say((&o2[0 as usize]) as u64, K_BKBOOK)
    }
    if reiter == R_SCREEN {
        var d1: [u8; 8] = "dbright\0"
        var d2: [u8; 7] = "dapply\0"
        rect_say((&d1[0 as usize]) as u64, ds_ch)
        rect_say((&d2[0 as usize]) as u64, ds_b2)
    }
    if reiter == R_NETZ {
        var q1: [u8; 6] = "nmode\0"
        var q2: [u8; 7] = "napply\0"
        var q3: [u8; 6] = "nconf\0"
        rect_say((&q1[0 as usize]) as u64, nz_cn)
        rect_say((&q2[0 as usize]) as u64, nz_b4)
        rect_say((&q3[0 as usize]) as u64, nz_b4j)
    }
    if reiter == R_UPDATE {
        var u1: [u8; 7] = "ucheck\0"
        var u2: [u8; 6] = "uinst\0"
        var u3: [u8; 6] = "uchan\0"
        var u4: [u8; 6] = "uauto\0"
        var u5: [u8; 6] = "uback\0"
        var u6: [u8; 6] = "uconf\0"
        rect_say((&u1[0 as usize]) as u64, up_bchk)
        rect_say((&u2[0 as usize]) as u64, up_binst)
        rect_say((&u3[0 as usize]) as u64, up_bchan)
        rect_say((&u4[0 as usize]) as u64, up_bauto)
        rect_say((&u5[0 as usize]) as u64, up_brb)
        rect_say((&u6[0 as usize]) as u64, up_bconf)
        var u7: [u8; 5] = "schk\0"
        var u8: [u8; 6] = "sinst\0"
        rect_say((&u7[0 as usize]) as u64, su_bchk)
        rect_say((&u8[0 as usize]) as u64, su_binst)
    }
    if reiter == R_RECHTE {
        var m1: [u8; 5] = "rtab\0"
        var m2: [u8; 6] = "rctab\0"
        var m3: [u8; 5] = "rrev\0"
        var m4: [u8; 5] = "rjar\0"
        var m5: [u8; 5] = "rblk\0"
        rect_say((&m1[0 as usize]) as u64, ri_tab)
        rect_say((&m2[0 as usize]) as u64, ri_ctab)
        rect_say((&m3[0 as usize]) as u64, ri_brev)
        rect_say((&m4[0 as usize]) as u64, ri_bjar)
        rect_say((&m5[0 as usize]) as u64, ri_bblock)
    }
}

// EVERY VISIBLE WIDGET REPORTS WHERE IT IS.
//
// `tools/desktop/run.sh` checks reported rectangles against the inner
// height of the window and fails on any that sticks out. Until this
// round FIVE widgets reported, so the check covered five of eighty-six
// -- and the page really was 132 pixels too long in a part nobody
// reported. Now every widget of the page that is showing reports.
//
// The names are letters only (`waa`, `wab`, ...) because that runner
// matches `name=[a-z]+`: a name with a digit in it would be skipped in
// silence, which is exactly the failure this is meant to end.
fn rects_alle() {
    var nm: [u8; 8] = [0 as u8; 8]
    nm[(0) as usize] = 119 as u8
    nm[(3) as usize] = 0 as u8
    // `waa` opens every batch of reports: it is the room of the tab bar (the
    // window's inner width without the 8 point margins). The acceptance runs cut
    // the report at the last `waa` and hold every tab against its width.
    var n_waa: [u8; 4] = "waa\0"
    let sk: u64 = fuiscene.scale()
    rect_say_at((&n_waa[0 as usize]) as u64, 8 * sk, 8 * sk,
        (fuiscene.width() - 16) * sk, 28 * sk)
    var k: u64 = 1
    while k < K_COUNT {
        // the sidebar entries are reported as `tab?` (bus_rects) and as tabs (tabs_say): fifteen equal
        // `w..` rectangles would be taken for the preview tiles by the acceptance runs
        let side_tab: bool = k >= K_TAB0 && k < K_TAB0 + R_ANZ
        if !side_tab && fuiscene.node_of_key(k) != fuiscene.NONE {
            nm[(1) as usize] = (97 + (k / 26)) as u8
            nm[(2) as usize] = (97 + (k % 26)) as u8
            rect_say((&nm[0 as usize]) as u64, k)
        }
        k = k + 1
    }
    // the rest of what the acceptance runs read: cards, tabs, buttons, radii,
    // every text (the formats wlib used, see tools/themestore/run.sh)
    var s_lay: [u8; 22] = "settings: layout nav=\0"
    var s_lay2: [u8; 9] = " detail=\0"
    var s_lay3: [u8; 9] = " scroll=\0"
    var s_lay4: [u8; 10] = " content=\0"
    var s_lay5: [u8; 7] = " view=\0"
    var s_lay6: [u8; 6] = " off=\0"
    say((&s_lay[0 as usize]) as u64)
    sayn(b2n(nav_mode()))
    say((&s_lay2[0 as usize]) as u64)
    sayn(b2n(nav_detail))
    say((&s_lay3[0 as usize]) as u64)
    sayn(b2n(page_scrolls()))
    // the pane of the page, or (list view) of the list
    var slot: u64 = 0
    if nav_list_only() {
        slot = 1
    }
    say((&s_lay4[0 as usize]) as u64)
    sayn(fuiscene.pane_content(slot))
    say((&s_lay5[0 as usize]) as u64)
    sayn(fuiscene.pane_view(slot))
    say((&s_lay6[0 as usize]) as u64)
    sayn(fuiscene.pane_offset(slot))
    nl()
    karten_say()
    tabs_say()
    fuiscene.say_knoepfe()
    fuiscene.say_radii()
    fuiscene.say_texts()
    glas_say()
}

// ================================ RUNDE ALLTAG: DIE SPERRE EINSTELLEN
//
// Fuenf Stufen und keine Eingabe einer Zahl: "nach wie vielen Minuten"
// ist eine Frage mit fuenf vernuenftigen Antworten, und ein Textfeld
// dafuer laedt nur dazu ein, 0 oder 100000 hineinzuschreiben.
fn sperre_sekunden(stufe: u64) -> u64 {
    return lockidle.secs_of(stufe)
}

// ROUND ACTION-BUS-3 (AB-005b): THE LOCK TIME IS `lock.idle` ON THE BUS.
// settingsd keeps it in /etc/sperre.conf (the schema's `store`), where
// idlelock reads it; this window reads and writes it through the bus,
// like a script or Jarvis would, and the change is journalled and can be
// undone. Only an image WITHOUT a broker (old test images) still reads
// and writes the file itself -- and says so on the serial line.
fn stufe_von_sek(sek: u64) -> u64 {
    return lockidle.level_of(sek)
}

fn sperre_stufe() -> u64 {
    var v_get: [u8; 18] = "call settings.get\0"
    var k_key: [u8; 4] = "key\0"
    var k_li: [u8; 10] = "lock.idle\0"
    var k_val: [u8; 6] = "value\0"
    var s_bus: [u8; 30] = "settings: lock via bus value=\0"
    if actcli.open() {
        actcli.req((&v_get[0 as usize]) as u64)
        actcli.arg((&k_key[0 as usize]) as u64, (&k_li[0 as usize]) as u64)
        if actcli.send(300) == actcli.R_OK {
            var v: [u8; 24] = [0 as u8; 24]
            if actcli.field((&k_val[0 as usize]) as u64, (&v[0 as usize]) as u64, 24) {
                say((&s_bus[0 as usize]) as u64)
                say((&v[0 as usize]) as u64)
                nl()
                return stufe_von_sek(ulib.to_num((&v[0 as usize]) as u64))
            }
        }
    }
    var s_file: [u8; 34] = "settings: lock via file (no bus)\n\0"
    say((&s_file[0 as usize]) as u64)
    return sperre_stufe_datei()
}

fn sperre_stufe_datei() -> u64 {
    var k: [u8; 10] = "leerlauf=\0"
    let fd: u64 = io.open((&sp_conf[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return 0
    }
    let b: u64 = (&sp_buf[0 as usize]) as u64
    let n: u64 = io.read(fd, b, 120)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return 0
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    let at: u64 = ulib.find(b, (&k[0 as usize]) as u64)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return stufe_von_sek(ulib.to_num(b + at + 9))
}

fn lock_write(sek: u64) -> bool {
    if actcli.open() {
        var v_set: [u8; 18] = "call settings.set\0"
        var k_key: [u8; 4] = "key\0"
        var k_li: [u8; 10] = "lock.idle\0"
        var k_val: [u8; 6] = "value\0"
        var z: [u8; 24] = [0 as u8; 24]
        let n: u64 = ulib.digits(sek, (&z[0 as usize]) as u64)
        z[(n) as usize] = 0 as u8
        actcli.req((&v_set[0 as usize]) as u64)
        actcli.arg((&k_key[0 as usize]) as u64, (&k_li[0 as usize]) as u64)
        actcli.arg((&k_val[0 as usize]) as u64, (&z[0 as usize]) as u64)
        let rc: u64 = actcli.send(300)
        var s1: [u8; 31] = "settings: lock set via bus rc=\0"
        say((&s1[0 as usize]) as u64)
        sayn(rc)
        nl()
        if rc != actcli.R_NOBUS {
            return rc == actcli.R_OK
        }
    }
    return lock_write_datei(sek)
}

fn lock_write_datei(sek: u64) -> bool {
    var kopf: [u8; 64] = "# /etc/sperre.conf -- written by the settings program\nleerlauf=\0"
    var nl2: [u8; 2] = "\n\0"
    var z: [u8; 24] = [0 as u8; 24]
    let b: u64 = (&sp_buf[0 as usize]) as u64
    ulib.strcpy(b, (&kopf[0 as usize]) as u64)
    let n: u64 = ulib.digits(sek, (&z[0 as usize]) as u64)
    z[(n) as usize] = 0 as u8
    ulib.strcat(b, (&z[0 as usize]) as u64)
    ulib.strcat(b, (&nl2[0 as usize]) as u64)
    let fd: u64 = io.create((&sp_conf[0 as usize]) as u64)
    if ulib.bad(fd) {
        return false
    }
    let len: u64 = ulib.length(b)
    let g: u64 = io.write_all(fd, b, len)
    io.close(fd)
    return !ulib.bad(g) && g >= len
}

// ======================================= ROUND ACTION-BUS-3 (AB-005b/006)
//
// TWO PAGES THAT KNOW NOTHING THEMSELVES. Both are built from the action
// bus and only from it (kernel/user/actcli.fi):
//
//   System      every setting of /etc/settings.schema, as settingsd
//               reports it (settings.list per area): key, value, risk,
//               text. "Set" is `settings.set` -- the broker checks type
//               and range, decides by the key, and a critical setting
//               (network, security, updates, privacy) comes back as a
//               question with a number that this page asks the person
//               in front of it, and only then answers `confirm <n>`.
//               "Undo" is the bus undo of the user's last change.
//   App rights  "what may which app": the broker's rules (`rights`) with
//               their end, the dry-run-first clients, and per client how
//               often it read, changed, was asked, was refused and
//               dry-ran. Revoke = `revoke <n>`, block = `block <c> *`.
//
// Without a broker the pages say so and change nothing -- a settings
// window that quietly wrote the files itself would be the second door
// the bus exists to close.

