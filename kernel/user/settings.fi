// Justins Wunsch war ausdruecklich, dass er damit SPIELEN kann: jede
// der drei Wirkungen EINZELN schaltbar plus Staerke regelbar. Deshalb
// drei Kaestchen und drei Stufenwahlen und nicht ein Schalter
// "Ziehanimation".
static mut k_z_head: [u8; 19] = "settings.zieh.head\0"
static mut k_z_lift: [u8; 19] = "settings.zieh.lift\0"
