static mut ctile: u64 = 0
// RUNDE GLAS: die vier Regler haben einen EIGENEN Kasten, und der
// haengt am UNTEREN Rand der rechten Spalte. Der Grund ist der Platz:
// die rechte Spalte fliesst von oben (Bild, dann der Taskleistenblock)
// und endet knapp ueber der Mitte; was darunter frei ist, sind rund
// hundert Bildpunkte. In denselben Fluss gehaengt waeren die Regler
// mit dem Abstand der Spalte (8) und der vollen Bedienhoehe gerechnet
// worden und unten aus dem Fenster gelaufen -- genau der Fehler, den
// Abschnitt 8 der Abnahme misst. Ein eigener Kasten mit Abstand 2 und
// fester Hoehe je Regler passt, und er passt nachrechenbar.
static mut cglas: u64 = 0
// ROUND ACTION-BUS-4: the row of the own-resolution fields and buttons on
// the page Bildschirm, a three-column grid at the foot of the right
// column (the page was 938 pixels tall in a 566 window: "Übernehmen" lay
// below the window edge and could not be clicked)
static mut cres: u64 = 0
const CRES_H: u64 = 60
// RUNDE GLAS (nachtrag): DIE ZWEI KARTEN, UND WARUM SIE JETZT EINEN
// NAMEN HABEN.
//
// Die Karten wurden angelegt, bevor `columns_set` die Spalten an ihre
// wirkliche Stelle setzt, und danach nie wieder angefasst. GEMESSEN
// auf der Seite Darstellung: die rechte Karte lag bei x=304..696 und
// y=44..436, die Bedienelemente darauf bei x=316..744 und y=72..510 --
// also ragten die vier Regler dieser Runde samt ihrer Zahlenanzeige
// rechts UND unten ueber ihre eigene Karte hinaus. Auf einem Bild
// sieht das aus wie ein Regler, der neben der Karte schwebt.
//
// Eine Karte ist der Untergrund ihrer Spalte, also gehoert ihr
// Rechteck dorthin, wo die Spalte steht -- und das weiss nur
// `columns_set`. Die Nummern hier sind der Weg dahin; Abschnitt 8 der
// Abnahme misst danach JEDES gemeldete Rechteck gegen die Karte, auf
// der es liegt.
static mut karte_l: u64 = 0
static mut karte_r: u64 = 0
static mut ckartl: u64 = 0
static mut ckartr: u64 = 0
// Der Stand des Marken-Wechselzaehlers, den die Schleife zuletzt
// gesehen hat. Siehe den Block vor `wlib.step`.
static mut th_sw: u64 = 0
// Derselbe Zweck fuer die GROESSE des Fensters: der zuletzt gesehene
// Stand von `wlib.resize_seq`. Siehe denselben Block.
static mut re_sq: u64 = 0
// Die Hoehe eines Reglers und der Abstand zwischen zweien, in
// Bildpunkten. Fest und nicht aus `M_CTRL_H` gerechnet, weil diese
// vier Zeilen in den Rest passen muessen, der uebrig bleibt -- und
// der ist bei jedem Formsatz derselbe. Gemessen: der Taskleistenblock
// der rechten Spalte endet auf `modern` bei 404, der Rumpf bei 502;
// 4*22+3*2 = 94 fangen bei 408 an und lassen vier Bildpunkte Luft.
// ZUSAMMENFUEHRUNG: 16 STATT 22. Ein Regler ist eine Rinne mit einem
// Griff und einer Beschriftung daneben -- er braucht die volle
// Bedienhoehe nicht, und seit die vier in der rechten Spalte FLIESSEN
// (statt an ihrem Fuss zu haengen), zaehlt dort jede Zeile.
// Die Breite der linken Spalte. Sie stand als Zahl in `columns_set`;
// seit der Kasten der Glasregler sich selbst an den Fluss der rechten
// Spalte haengt, braucht sie eine zweite Stelle -- also bekommt sie
// einen Namen statt einer zweiten 340.
const HALF: u64 = 340
const GLAS_H: u64 = 16
// ZUSAMMENFUEHRUNG: 0 STATT 2. Der Zeilenabstand INNERHALB des
// Reglerkastens. Vier Regler und drei Abstaende sind sechs Bildpunkte;
// genau die fehlten der rechten Spalte, seit sie beide Reglergruppen
// traegt. Die Regler stehen damit Zeile an Zeile -- was bei einem
// Regler richtig ist: seine Rinne ist duenn, und die Beschriftung
// daneben traegt den Abstand im Schriftbild.
const GLAS_GAP: u64 = 0
// ============= RUNDE GLAS (nachtrag): WIE HOCH EIN REGLER WIRKLICH IST
//
// `GLAS_H` ist die WUNSCHhoehe, mit der die vier Regler angelegt
// werden; `wlib` hebt sie auf die Bedienhoehe des Formsatzes an.
// GEMESSEN an den gemeldeten Rechtecken (`settings: rect name=waz..`):
// sie sind 24 hoch und nicht 22, also stand der Kasten der Regler zehn
// Bildpunkte tiefer als gerechnet -- und damit der unterste Regler
// unter der Karte, auf der er liegen soll. Der Kasten rechnet deshalb
// mit der Zahl, die im Bild steht.
const GLAS_ROW: u64 = 24
// Der Abstand zwischen der Unterkante der Karte und der Statuszeile.
// Er ist der ganze Punkt dieses Nachtrags: die Statuszeile stand
// bisher GENAU auf der unteren Kartenkante, also lief die Rahmenlinie
// der Karte mitten durch das Wort "bereit" (Bildpunktprobe in
// tools/themestore/shotcheck.py, `linie`).
// ZUSAMMENFUEHRUNG: 4 STATT 8. Der Abstand zwischen der Unterkante der
// Karte und der Fusszeile. Acht standen hier, weil die Seite den Platz
// hatte; seit sie BEIDE Reglergruppen traegt, fehlten der rechten
// Spalte genau zwei Bildpunkte, und vier Bildpunkte Luft trennen die
// Zeile von der Kartenkante immer noch sichtbar (gemessen an der
// Bildpunktprobe in tools/themestore/shotcheck.py, die diesen Abstand
// ueberhaupt erst gefunden hat).
const STAT_GAP: u64 = 4
