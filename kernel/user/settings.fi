    let st: u64 = merke(wlib.label((&l_stat[0 as usize]) as u64), R_ANZ)
    wlib.box_end()
    let _tb2: u64 = tb
    let _e0: u64 = eb
    // RUNDE DISPLAY: die Auswahlen zeigen, WAS EINGESTELLT IST, und
    // nicht die Mitte. Ein Bedienfeld, das beim Oeffnen luegt, ist
    // schlimmer als eins ohne Anzeige.
    if dget(DG_READY) == 1 {
        // RUNDE CUSTOMRES: die drei Eingabefelder zeigen, WAS GERADE
        // LAEUFT. Ein Feld, das leer aufgeht, laedt dazu ein, eine Zahl
        // zu raten; eines, in dem die laufende steht, zeigt zugleich das
        // Format.
        let _f1: u64 = num_at((&e_cw[0 as usize]) as u64, 0,
            dget(DG_PANELW))
        let _f2: u64 = num_at((&e_ch[0 as usize]) as u64, 0,
            dget(DG_PANELH))
        let _f3: u64 = num_at((&e_ct[0 as usize]) as u64, 0, dget(DG_BPP))
        save_read()
        wlib.set_value(cs, dget(DG_CUR))
        wlib.set_value(ck, dget(DG_SCALE))
        wlib.set_value(cd, dget(DG_ROT) / 90)
        wlib.set_value(ch, stufe_von(dget(DG_BRIGHT), 0))
        wlib.set_value(cc, stufe_von(dget(DG_CONTRAST), 0))
        wlib.set_value(cg, stufe_von(dget(DG_GAMMA), 1))
        wlib.set_value(cq, stufe_von(dget(DG_SAT), 2))
    }
    if v_n > 0 {
        wlib.set_value(tids[(0) as usize], 1)
    }
    zeige_reiter(R_DARST)
    wlib.draw_all()
    vorlage_say()
    var s_tl: [u8; 19] = "settings: tiles n=\0"
    var s_tl2: [u8; 8] = " shown=\0"
    var s_tl3: [u8; 8] = " acct=\0\0"
    say((&s_tl[0 as usize]) as u64)
    ulib.sayn(v_n)
    say((&s_tl2[0 as usize]) as u64)
    if v_n < TILES {
        ulib.sayn(v_n)
    } else {
        ulib.sayn(TILES)
    }
    say((&s_tl3[0 as usize]) as u64)
    if template.account_have() {
        ulib.sayn(1)
    } else {
        ulib.sayn(0)
    }
    ulib.nl()
    var n_edge: [u8; 5] = "edge\0"
    var n_size: [u8; 5] = "size\0"
    var n_ah: [u8; 9] = "autohide\0"
    var n_ot: [u8; 6] = "ontop\0"
    var n_ap: [u8; 6] = "apply\0"
    var n_win: [u8; 4] = "win\0"
    say((&mr_a[0 as usize]) as u64)
    say((&n_win[0 as usize]) as u64)
    say((&ms_b[0 as usize]) as u64)
    ulib.sayn(wlib.win_x(w))
    say((&ms_c[0 as usize]) as u64)
    ulib.sayn(wlib.win_y(w))
    say((&mr_w[0 as usize]) as u64)
    ulib.sayn(bw)
    say((&mr_h[0 as usize]) as u64)
    ulib.sayn(bh)
    ulib.nl()
    rect_say((&n_edge[0 as usize]) as u64, ce)
    rect_say((&n_size[0 as usize]) as u64, et)
    rect_say((&n_ah[0 as usize]) as u64, ka)
    rect_say((&n_ot[0 as usize]) as u64, ko)
    rect_say((&n_ap[0 as usize]) as u64, b1)
    tb_say()
    melde_elemente()
    report_fui()
    melde_stand()

    var runden: u64 = 0
    var frist_vor: u64 = 0
    while wlib.alive() && runden < 4000000 {
        runden = runden + 1
        // Die Frist herunterzaehlen -- aber nur, wenn sich die SEKUNDE
        // geaendert hat. Ein Text, der in jedem Schleifendurchlauf neu
        // gesetzt wird, macht das Fenster in jedem Durchlauf schmutzig
        // und den Fensterserver zum Dauerlaeufer.
        if reiter == R_SCREEN {
            let rest: u64 = (dget(DG_REMAIN) + 999) / 1000
            if rest != frist_vor {
                frist_vor = rest
                let _fl: bool = deadline_read()
                wlib.set_text(_sf, (&d_frist[0 as usize]) as u64)
                if rest == 0 {
                    state_read()
                    wlib.set_text(_sk, (&d_karte[0 as usize]) as u64)
                }
            }
        }
        let id: u64 = wlib.step()
        if id < wlib.MAXWD {
            let kind: u64 = wlib.fired_kind()
            if kind == wlib.K_TABS {
                zeige_reiter(wlib.fired_index())
                melde_stand()
            } else if kind == wlib.K_CHOICE {
                // A CHOICE THAT CANNOT BE CHANGED IS A PICTURE OF A
                // CHOICE. Round DESKTOP put four of them into this
                // program -- resolution, time zone, DHCP -- and none of
                // them ever opened: `wlib` fires K_CHOICE with the index
                // 0x1000 and leaves it to the application to open the
                // menu, and this application did not. It does now, and
                // the same four lines serve the taskbar edge.
                if wlib.fired_index() == 0x1000 {
                    var items: u64 = msg.get((&k_c_aufl[0 as usize]) as u64)
                    var cnt: u64 = 2
                    if id == cz {
                        items = msg.get((&k_c_zone[0 as usize]) as u64)
                        cnt = 3
                    } else if id == cn {
                        items = msg.get((&k_c_bez[0 as usize]) as u64)
                        cnt = 2
                    } else if id == ce {
                        items = msg.get((&k_c_tb[0 as usize]) as u64)
                        cnt = 4
                    } else if id == cv {
                        items = msg.get((&k_c_view[0 as usize]) as u64)
                        cnt = 4
                    } else if id == cal {
                        items = msg.get((&k_c_tbal[0 as usize]) as u64)
                        cnt = 2
                    } else if id == csh {
                        items = msg.get((&k_c_shape[0 as usize]) as u64)
                        cnt = 2
                    } else if id == cm {
                        items = msg.get((&k_c_mod[0 as usize]) as u64)
                        cnt = 3
                    } else if id == ckanb {
                        // RUNDE KONTO: die Anbieter kommen aus
                        // `/bin/konto anbieter`, nicht aus dem Katalog --
                        // ein Anbietername ist ein NAME und wird nicht
                        // uebersetzt (docs/I18N.md, erster Abschnitt).
                        items = (&k_anbn[0 as usize]) as u64
                        cnt = k_anb_n
                    }
                    let mx: u64 = wlib.win_x(w) + 2 + wlib.rect_x(id)
                    let my: u64 = wlib.win_y(w) + 22 + wlib.rect_y(id)
                        + wlib.rect_h(id)
                    let _mo: u64 = wlib.menu_open(id, mx, my, items, cnt)
                    menu_say(id, mx, my, cnt)
                }
            } else if kind == wlib.K_MENUBAR {
                // The library re-fires the chosen row at the widget that
                // opened the menu. That is the answer to the choice.
                if id == cs || id == cz || id == cn || id == ce
                    || id == cv || id == cal || id == csh || id == cm
                    || id == ckanb {
                    wlib.set_value(id, wlib.fired_index())
                    if id == ce {
                        tb_edge = wlib.fired_index()
                        tb_show_size()
                        wlib.set_text(et, (&e_tbs[0 as usize]) as u64)
                    }
                    wlib.dirty_all(w)
                    menu_done(id, wlib.fired_index())
                }
            } else if kind == wlib.K_TILE {
                // A TILE IS THE PRESET IT DRAWS. Clicking one selects
                // it; it does not apply it. Applying is a button, and
                // an appearance that changed because a picture was
                // touched would be a surprise and not a feature.
                var t: u64 = 0
                while t < TILES {
                    if tids[(t) as usize] == id {
                        var q: u64 = 0
                        while q < TILES {
                            wlib.set_value(tids[(q) as usize], 0)
                            q = q + 1
                        }
                        wlib.set_value(id, 1)
                        v_sel = t
                        template_con_show()
                        wlib.set_text(lvk, (&l_vkon[0 as usize]) as u64)
                        wlib.dirty_all(w)
                    }
                    t = t + 1
                }
            } else if kind == wlib.K_BUTTON {
                if id == bv1 {
                    // ANWENDEN. One click, and the seven values land in
                    // the two files the system reads. Everything after
                    // that is the machinery rounds THEME and LOOK
                    // already built: `theme_reload` re-resolves and the
                    // taskbar's own poll picks up its file.
                    if v_sel < v_n && template.apply_at(v_sel) {
                        let _r1: u64 = wlibc.theme_reload()
                        wlib.reshape()
                        columns_set(tb, bw, bh)
                        wlib.new_set()
                        tb_read()
                        wlib.set_value(ce, tb_edge)
                        wlib.set_value(cal, tb_align)
                        shape_say()
                        contrast_show()
                        wlib.set_text(lk, (&l_kon[0 as usize]) as u64)
                        wlib.set_text(lk2, (&l_kon2[0 as usize]) as u64)
                        wlib.set_text(lw, (&l_warn[0 as usize]) as u64)
                        let _a1: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vok[0 as usize]) as u64))
                    } else {
                        let _a2: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vno[0 as usize]) as u64))
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.dirty_all(w)
                    vorlage_say()
                    melde_stand()
                } else if id == bv2 {
                    // SPEICHERN: what is RUNNING, under the name in the
                    // field, into the local store. No account needed
                    // and none asked for.
                    var okv: bool = false
                    if e_vid[(0) as usize] != 0 as u8 {
                        okv = template.save_as((&e_vid[0 as usize]) as u64,
                            (&e_vid[0 as usize]) as u64)
                    }
                    if okv {
                        templates_read()
                        template_con_show()
                        wlib.set_text(lvk, (&l_vkon[0 as usize]) as u64)
                        let _a3: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vsave[0 as usize]) as u64))
                    } else {
                        let _a4: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vno[0 as usize]) as u64))
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.dirty_all(w)
                    vorlage_say()
                    melde_stand()
                } else if id == bv3 {
                    var oke: bool = false
                    if e_vfile[(0) as usize] != 0 as u8 && v_sel < v_n {
                        oke = template.export_at(v_sel,
                            (&e_vfile[0 as usize]) as u64)
                    }
                    if oke {
                        let _a5: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vexp[0 as usize]) as u64))
                    } else {
                        let _a6: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vno[0 as usize]) as u64))
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.dirty_all(w)
                    melde_stand()
                } else if id == bv4 {
                    var oki: bool = false
                    if e_vfile[(0) as usize] != 0 as u8
                        && e_vid[(0) as usize] != 0 as u8 {
                        oki = template.import_from((&e_vfile[0 as usize]) as u64,
                            (&e_vid[0 as usize]) as u64)
                    }
                    if oki {
                        templates_read()
                        template_con_show()
                        wlib.set_text(lvk, (&l_vkon[0 as usize]) as u64)
                        let _a7: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vimp[0 as usize]) as u64))
                    } else {
                        let _a8: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_vno[0 as usize]) as u64))
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.dirty_all(w)
                    vorlage_say()
                    melde_stand()
                } else if id == bv5 {
                    let nlk: u64 = template.link_all()
                    var a9: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                        msg.get((&k_m_vlink[0 as usize]) as u64))
                    a9 = num_at((&l_stat[0 as usize]) as u64, a9, nlk)
                    account_show()
                    wlib.set_text(lvc, (&l_vkonto[0 as usize]) as u64)
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.dirty_all(w)
                    melde_stand()
                } else if id == bv6 {
                    let nrs: u64 = template.restore_all()
                    templates_read()
                    template_con_show()
                    wlib.set_text(lvk, (&l_vkon[0 as usize]) as u64)
                    var aa: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                        msg.get((&k_m_vrest[0 as usize]) as u64))
                    aa = num_at((&l_stat[0 as usize]) as u64, aa, nrs)
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.dirty_all(w)
                    vorlage_say()
                    melde_stand()
                } else if id == br_aus_id {
                    // RUNDE BRUECKE: AUS.
                    //
                    // Zwei Dinge, und beide sofort wirksam:
                    //
                    //  1. `eingabe = nein` und `bildschirmfoto = nein`
                    //     in /etc/jarvis/rechte.conf. Der Helfer liest
                    //     die Datei VOR JEDEM Auftrag neu -- es
                    //     braucht keinen Neustart und kein Signal.
                    //  2. Einen offenen Tippschein wegnehmen
                    //     (TI_DROP). Ohne das duerfte jemand, der
                    //     gerade einen Schein hat, noch bis zu zwei
                    //     Minuten weitertippen -- "aus" hiesse dann
                    //     "gleich aus", und das ist bei einem
                    //     Fernzugriff die falsche Antwort.
                    //
                    // WAS DIESER KNOPF NICHT TUT: das Geraet
                    // ENTKOPPELN. Der Schluessel bleibt -- wer die
                    // Kopplung loeswerden will, sperrt das Geraet am
                    // Server. Ein Knopf, der beides taete, waere einer,
                    // nach dessen Druecken man ohne den Server nicht
                    // mehr zurueckkommt.
                    let _bd: u64 = ulib.sys(SYS_TIPP, TI_DROP, 0, 0)
                    if bridge_off() {
                        bridge_read()
                        wlib.set_text(br_stand_id,
                            (&l_br_stand[0 as usize]) as u64)
                        wlib.set_text(br_tippt_id,
                            (&l_br_tippt[0 as usize]) as u64)
                        wlib.dirty_all(w)
                    }
                } else if id == b1 {
                    // RUNDE THEME: nicht mehr eine Datei kopieren,
                    // sondern /etc/theme.conf schreiben und den Satz
                    // neu aufloesen. Danach stehen die gemessenen
                    // Kontraste im Fenster -- vor dem naechsten Klick
                    // und nicht in einem Protokoll.
                    if wlib.value(ls) < nschema {
                        if theme_conf_write(
                            (&snamen[0 as usize]) as u64
                                + wlib.value(ls) * 32,
                            wlib.value(cm),
                            (&e_akzent[0 as usize]) as u64,
                            wlib.value(csh)) {
                            let _r: u64 = wlibc.theme_reload()
                            // THE SHAPE CHANGES THE SIZE OF EVERY
                            // CONTROL, so the page has to be laid out
                            // again -- a repaint alone would draw 32-
                            // pixel buttons into 26-pixel rectangles.
                            // `wlib.relayout` re-runs the boxes with
                            // the new tokens and keeps every widget,
                            // every value and every text pointer.
                            wlib.reshape()
                            // THE TAB BAR JUST CHANGED HEIGHT. The
                            // columns hang off it, so they move too --
                            // and then everything is laid out again.
                            columns_set(tb, bw, bh)
                            wlib.new_set()
                            shape_say()
                            contrast_show()
                            wlib.set_text(lk, (&l_kon[0 as usize]) as u64)
                            wlib.set_text(lk2, (&l_kon2[0 as usize]) as u64)
                        wlib.set_text(lk2, (&l_kon2[0 as usize]) as u64)
                            wlib.set_text(lw, (&l_warn[0 as usize]) as u64)
                            let a: u64 = text_an((&l_stat[0 as usize]) as u64,
                                0, msg.get((&k_m_schema[0 as usize]) as u64))
                            let _b: u64 = text_an((&l_stat[0 as usize])
                                as u64, a, (&snamen[0 as usize]) as u64
                                + wlib.value(ls) * 32)
                        } else {
                            let _c: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, msg.get((&k_m_schemano[0 as usize]) as u64))
                        }
                    }
                    // das Bild -- nur, wenn die Quelle nicht schon das
                    // Ziel ist. Eine Datei auf sich selbst zu kopieren
                    // heisst hier: sie erst leeren und dann lesen.
                    if !ulib.streq((&e_bild[0 as usize]) as u64,
                        (&t_wall[0 as usize]) as u64) {
                        let n2: u64 = file_copy(
                            (&e_bild[0 as usize]) as u64,
                            (&t_wall[0 as usize]) as u64)
                        if n2 > 0 {
                            let a2: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, msg.get((&k_m_bild[0 as usize]) as u64))
                            let _d2b: u64 = num_at((&l_stat[0 as usize])
                                as u64, a2, n2)
                        } else {
                            let _e2b: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, msg.get((&k_m_bildno[0 as usize]) as u64))
                        }
                    }
                    // ADDENDUM TASKBAR: and the bar. Same button, same
                    // page, one more file -- and the bar picks the
                    // change up within half a second without a restart,
                    // because it re-reads /etc/taskbar.conf and does not
                    // wait for a message.
                    tb_edge = wlib.value(ce)
                    if wlib.value(ka) != 0 {
                        tb_autohide = 1
                    } else {
                        tb_autohide = 0
                    }
                    if wlib.value(ko) != 0 {
                        tb_ontop = 1
                    } else {
                        tb_ontop = 0
                    }
                    tb_align = wlib.value(cal)
                    tb_set_size(wlib.text_of(et))
                    let _tw: bool = tb_write()
                    tb_say()
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b2 {
                    // RUNDE DISPLAY: UEBERNEHMEN HEISST JETZT
                    // UEBERNEHMEN. Vorher wurde eine Zeile in
                    // /etc/display.conf geschrieben und auf den naechsten
                    // Start vertroestet.
                    //
                    // Die Reihenfolge ist nicht beliebig: erst das
                    // Bild (Helligkeit, Kontrast, Gamma, Saettigung),
                    // dann die Drehung und die Skalierung, und ZULETZT
                    // die Aufloesung. Ein Moduswechsel raeumt den
                    // Zweitpuffer um; alles, was davor eingestellt
                    // wurde, gilt danach weiter, alles was danach kaeme,
                    // muesste ein zweites Mal gesetzt werden.
                    let _p1: u64 = dset(DS_BRIGHT,
                        level_bright(wlib.value(ch)))
                    let _p2: u64 = dset(DS_CONTRAST,
                        level_bright(wlib.value(cc)))
                    let _p3: u64 = dset(DS_GAMMA, stufe_gam(wlib.value(cg)))
                    let _p4: u64 = dset(DS_SAT, stufe_sat(wlib.value(cq)))
                    let _p5: u64 = dset(DS_SCALE, wlib.value(ck))
                    let _p6: u64 = dset(DS_ROT, wlib.value(cd) * 90)
                    var a3: u64 = 0
                    let z: u64 = wlib.value(cs)
                    if z < d_n {
                        let m: u64 = dget(DG_MODE + z)
                        var rc: u64 = 0
                        if !ulib.bad(m) {
                            rc = dset(DS_MODE, (((m >> 32) & 0xFFFF) << 16)
                                | ((m >> 16) & 0xFFFF))
                        }
                        if ulib.bad(rc) {
                            a3 = text_an((&l_stat[0 as usize]) as u64, 0,
                                msg.get((&k_m_modeno[0 as usize]) as u64))
                        } else {
                            a3 = text_an((&l_stat[0 as usize]) as u64, 0,
                                msg.get((&k_m_modeok[0 as usize]) as u64))
                            a3 = num_at((&l_stat[0 as usize]) as u64, a3,
                                dget(DG_PANELW))
                            a3 = text_an((&l_stat[0 as usize]) as u64, a3,
                                (&m_mal[0 as usize]) as u64)
                            a3 = num_at((&l_stat[0 as usize]) as u64, a3,
                                dget(DG_PANELH))
                        }
                    } else {
                        a3 = text_an((&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_modeno[0 as usize]) as u64))
                    }
                    let _a3b: u64 = a3
                    state_read()
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.set_text(_sk, (&d_karte[0 as usize]) as u64)
                    wlib.set_text(_sf, (&d_frist[0 as usize]) as u64)
                    wlib.new_set()
                    melde_stand()
                } else if id == bce || id == bcp {
                    // ================== RUNDE CUSTOMRES
                    //
                    // DIE FREIE EINGABE. Zwei Knoepfe, ein Weg: `Nur
                    // pruefen` geht bis vor den Wechsel und fasst den
                    // Bildschirm nicht an, `Eigene setzen` geht durch.
                    // Beide bekommen DENSELBEN Grund und DIESELBE Zahl
                    // aus dem Kernel zurueck.
                    let cw: u64 = field_num(wlib.text_of(ecw))
                    let ch2: u64 = field_num(wlib.text_of(ech))
                    var cb: u64 = field_num(wlib.text_of(ect))
                    if cb == 0 {
                        cb = 32
                    }
                    var fld: u64 = DS_CUSTOM
                    if id == bcp {
                        fld = DS_CHECK
                    }
                    let _cr: u64 = dset(fld, (cw << 32) | (ch2 << 16) | cb)
                    reason_read(cw, ch2)
                    wlib.set_text(_cg, (&d_grund[0 as usize]) as u64)
                    state_read()
                    modes_read()
                    save_read()
                    wlib.set_text(_cs2, (&d_save[0 as usize]) as u64)
                    wlib.set_text(_sk, (&d_karte[0 as usize]) as u64)
                    let _cf2: bool = deadline_read()
                    wlib.set_text(_sf, (&d_frist[0 as usize]) as u64)
                    wlib.set_text(cs, (&d_modi[0 as usize]) as u64)
                    wlib.set_value(cs, dget(DG_CUR))
                    wlib.new_set()
                    melde_stand()
                } else if id == b2a {
                    // RUNDE CUSTOMRES: derselbe Knopf, eine Wirkung mehr
                    // -- der Kernel schreibt den Modus jetzt auch auf die
                    // Platte (kernel/dispsave.fi). Die Zeile darunter
                    // sagt danach, was dort steht und wieviele
                    // Startversuche er noch hat.
                    let _k1: u64 = dset(DS_CONFIRM, 0)
                    let _k2: bool = deadline_read()
                    wlib.set_text(_sf, (&d_frist[0 as usize]) as u64)
                    save_read()
                    wlib.set_text(_cs2, (&d_save[0 as usize]) as u64)
                    let _k3: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                        msg.get((&k_m_behalt[0 as usize]) as u64))
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b2b {
                    let _r1: u64 = dset(DS_REVERT, 0)
                    state_read()
                    wlib.set_text(_sf, (&d_frist[0 as usize]) as u64)
                    wlib.set_text(_sk, (&d_karte[0 as usize]) as u64)
                    let _r3: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                        msg.get((&k_m_zurueck[0 as usize]) as u64))
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.new_set()
                    melde_stand()
                } else if id == b3 {
                    var buf2: [u8; 32] = [0 as u8; 32]
                    var a4: u64 = text_an((&buf2[0 as usize]) as u64, 0,
                        (&k_off[0 as usize]) as u64)
                    a4 = num_at((&buf2[0 as usize]) as u64, a4,
                        wlib.value(cz) * 60)
                    a4 = text_an((&buf2[0 as usize]) as u64, a4,
                        (&k_nl[0 as usize]) as u64)
                    let _w4: bool = file_write(
                        (&t_time[0 as usize]) as u64,
                        (&buf2[0 as usize]) as u64, a4)
                    let _s6: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                        msg.get((&k_m_time[0 as usize]) as u64))
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b4 {
                    if wlib.value(cn) == 0 {
                        var buf3: [u8; 24] = [0 as u8; 24]
                        let a5: u64 = text_an((&buf3[0 as usize]) as u64, 0,
                            (&k_dh[0 as usize]) as u64)
                        let _w5: bool = file_write(
                            (&t_net[0 as usize]) as u64,
                            (&buf3[0 as usize]) as u64, a5)
                        // RUNDE TUERSCHLOSS: SYS_EXEC statt SYS_SPAWN --
                        // `t_dhcp` ist ein PFAD, keine Programmnummer.
                        let pid: u64 = ulib.sys(ulib.SYS_EXEC,
                            (&t_dhcp[0 as usize]) as u64, 0, 0)
                        let a6: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_dhcp[0 as usize]) as u64))
                        let _z7: u64 = num_at((&l_stat[0 as usize]) as u64,
                            a6, pid)
                    } else {
                        let vip: u64 = ip_read((&e_ip[0 as usize]) as u64)
                        let vmk: u64 = ip_read((&e_maske[0 as usize])
                            as u64)
                        let vgw: u64 = ip_read((&e_gw[0 as usize]) as u64)
                        if vip == 0 || vmk == 0 {
                            let _s8: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, msg.get((&k_m_netzno[0 as usize]) as u64))
                        } else {
                            let rc: u64 = ulib.sys(SYS_NETSET, vip, vmk, vgw)
                            if ulib.bad(rc) {
                                let _s9: u64 = text_an((&l_stat[0 as usize])
                                    as u64, 0, msg.get((&k_m_netzr[0 as usize]) as u64))
                            } else {
                                var buf4: [u8; 96] = [0 as u8; 96]
                                var a7: u64 = text_an((&buf4[0 as usize])
                                    as u64, 0, (&k_fe[0 as usize]) as u64)
                                a7 = ip_an((&buf4[0 as usize]) as u64, a7,
                                    vip)
                                a7 = text_an((&buf4[0 as usize]) as u64, a7,
                                    (&k_mk[0 as usize]) as u64)
                                a7 = ip_an((&buf4[0 as usize]) as u64, a7,
                                    vmk)
                                a7 = text_an((&buf4[0 as usize]) as u64, a7,
                                    (&k_gw[0 as usize]) as u64)
                                a7 = ip_an((&buf4[0 as usize]) as u64, a7,
                                    vgw)
                                a7 = text_an((&buf4[0 as usize]) as u64, a7,
                                    (&k_nl[0 as usize]) as u64)
                                let _wa: bool = file_write(
                                    (&t_net[0 as usize]) as u64,
                                    (&buf4[0 as usize]) as u64, a7)
                                let _sa: u64 = text_an((&l_stat[0 as usize])
                                    as u64, 0, msg.get((&k_m_net[0 as usize]) as u64))
                            }
                        }
                    }
                    state_read()
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == bsp {
                    // RUNDE ALLTAG: /etc/sperre.conf schreiben. Der
                    // Waechter (`lock -d`) liest sie beim naechsten
                    // Start; laeuft schon einer, gilt seine Zahl bis
                    // zum naechsten Mal -- das steht so in der Datei.
                    let sek: u64 = sperre_sekunden(wlib.value(csp))
                    if lock_write(sek) {
                        let _ss: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_sp[0 as usize]) as u64))
                    }
                } else if id == b5 {
                    if !ulib.streq((&e_pw1[0 as usize]) as u64,
                        (&e_pw2[0 as usize]) as u64) {
                        let _sb: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_kwne[0 as usize]) as u64))
                    } else if wlibc.chars((&e_pw1[0 as usize]) as u64,
                        ulib.length((&e_pw1[0 as usize]) as u64)) < 4 {
                        let _sc: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_kwku[0 as usize]) as u64))
                    } else {
                        var rec: [u8; 160] = [0 as u8; 160]
                        var gut: bool = pw.make_hash(
                            (&e_pw1[0 as usize]) as u64,
                            (&rec[0 as usize]) as u64)
                        if gut {
                            gut = pw.set_shadow((&name[0 as usize]) as u64,
                                (&rec[0 as usize]) as u64)
                        }
                        if gut {
                            geschrieben = geschrieben + 1
                            let ad: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, msg.get((&k_m_kwok[0 as usize]) as u64))
                            let _sd: u64 = text_an((&l_stat[0 as usize])
                                as u64, ad, (&name[0 as usize]) as u64)
                        } else {
                            let _se: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, msg.get((&k_m_kwno[0 as usize]) as u64))
                        }
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b6 {
                    // ==================================== ROUND NETVIEW
                    //
                    // Die Sicht eines LAUFENDEN Prozesses aendern. Der
                    // Kern entscheidet, ob das erlaubt ist
                    // (`netview.may_set`): enger machen darf jeder sich
                    // selbst, alles andere darf nur die Wurzel. Diese
                    // Seite fragt und schoent die Antwort nicht -- ein
                    // -EPERM steht als Satz in der Statuszeile und nicht
                    // als stilles Nichts.
                    let z: u64 = wlib.value(lv)
                    if z < nv_n {
                        let want: u64 = wlib.value(cv)
                        let r: u64 = nv.view_set(nv_pids[(z) as usize],
                            want)
                        if ulib.bad(r) {
                            let _f1: u64 = text_an(
                                (&l_stat[0 as usize]) as u64, 0,
                                msg.get((&k_m_nvno[0 as usize]) as u64))
                        } else {
                            let a6: u64 = text_an(
                                (&l_stat[0 as usize]) as u64, 0,
                                msg.get((&k_m_nvok[0 as usize]) as u64))
                            let _f2: u64 = num_at(
                                (&l_stat[0 as usize]) as u64, a6,
                                nv_pids[(z) as usize])
                        }
                        nv_read()
                        wlib.set_text(lv, (&nv_liste[0 as usize]) as u64)
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.dirty_all(w)
                    melde_stand()
                } else if id == b7 {
                    // ============ ZWEITER NACHTRAG: die Voreinstellung
                    //
                    // Sie setzt KEINEN laufenden Prozess um, und die
                    // Seite behauptet das auch nicht: die Liste
                    // darueber wird danach neu gelesen und zeigt
                    // dieselben Sichten wie vorher. Wer sehen will, dass
                    // es wirkt, startet ein Programm.
                    let f: u64 = wlib.value(cf)
                    if ulib.bad(nv.fallback_set(f)) {
                        let _g1: u64 = text_an(
                            (&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_fbno[0 as usize]) as u64))
                    } else {
                        var fw: [u8; 14] = [0 as u8; 14]
                        let a7: u64 = text_an(
                            (&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_fbok[0 as usize]) as u64))
                        let _n7: u64 = nv.fb_name(f, (&fw[0 as usize]) as u64)
                        let _g2: u64 = text_an(
                            (&l_stat[0 as usize]) as u64, a7,
                            (&fw[0 as usize]) as u64)
                        // UND IN DIE DATEI. Ohne das waere die
                        // Einstellung beim naechsten Start weg, und
                        // eine Einstellung, die sich selbst vergisst,
                        // ist schlimmer als keine.
                        let _fw: bool = nv.fallback_save(f)
                    }
                    nv_read()
                    wlib.set_text(lv, (&nv_liste[0 as usize]) as u64)
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.dirty_all(w)
                    melde_stand()
                } else if id == bkadd {
                    // ================================= RUNDE KONTO
                    //
                    // ANMELDEN. Der ganze Vorgang ist ein Aufruf von
                    // `/bin/konto anmelden` -- die Oberflaeche kennt
                    // weder einen Endpunkt noch ein Token noch einen
                    // Anbieter. Was sie kennt, sind FELDER.
                    // ACHT WOERTER, NICHT MEHR. `proc.MAX_ARGS` ist
                    // 8 (kernel/proc.fi), und `--bereich <wert>` sind
                    // ZWEI davon. Mit Zertifikatsname, Organisation und
                    // zweitem Faktor waeren es vierzehn -- der Aufruf
                    // wuerde abgewiesen, und zwar erst beim Nutzer, der
                    // eine Organisation eintraegt. Also die angehaengte
                    // Form: `--bereich=<wert>` ist EIN Wort. Genau
                    // deshalb kann `/bin/konto` beide Schreibweisen.
                    var a_an: [u8; 9] = "anmelden\0"
                    var a_b0: [u8; 11] = "/bin/konto\0"
                    var argv: [u64; 8] = [0 as u64; 8]
                    var n: u64 = 0
                    argv[(n) as usize] = (&a_b0[0 as usize]) as u64
                    n = n + 1
                    argv[(n) as usize] = (&a_an[0 as usize]) as u64
                    n = n + 1
                    // Der gewaehlte Anbieter ist die n-te Zeile der
                    // Liste, die `/bin/konto anbieter` geliefert hat.
                    var anbuf: [u8; 48] = [0 as u8; 48]
                    var vor_anb: [u8; 12] = "--anbieter=\0"
                    var o: u64 = 0
                    while vor_anb[(o) as usize] != 0 as u8 {
                        anbuf[(o) as usize] = vor_anb[(o) as usize]
                        o = o + 1
                    }
                    var zeile: u64 = wlib.value(ckanb)
                    var q: u64 = 0
                    var z: u64 = 0
                    while k_anbn[(q) as usize] != 0 as u8 && o + 1 < 48 {
                        if k_anbn[(q) as usize] == 10 as u8 {
                            z = z + 1
                        } else if z == zeile {
                            anbuf[(o) as usize] = k_anbn[(q) as usize]
                            o = o + 1
                        }
                        q = q + 1
                    }
                    anbuf[(o) as usize] = 0 as u8
                    argv[(n) as usize] = (&anbuf[0 as usize]) as u64
                    n = n + 1
                    // Die uebrigen Felder, jedes als EIN Wort
                    // `--name=<wert>`. Ein leeres Feld faellt weg.
                    // Die ADRESSE geht nicht auf die Befehlszeile --
                    // sie wird gemerkt (/etc/konten.conf) und von
                    // `/bin/konto` dort gelesen. Der Anbietername steht
                    // in `anbuf` hinter `--anbieter=`; gemerkt wird der
                    // Name selbst, also elf Zeichen weiter.
                    let _cm: bool = conf_remember(
                        (&anbuf[(11) as usize]) as u64,
                        (&e_kziel[0 as usize]) as u64,
                        (&e_kname[0 as usize]) as u64)
                    var kebuf: [u8; 80] = [0 as u8; 80]
                    var bebuf: [u8; 80] = [0 as u8; 80]
                    var cobuf: [u8; 40] = [0 as u8; 40]
                    var v_ke: [u8; 11] = "--kennung=\0"
                    var v_be: [u8; 11] = "--bereich=\0"
                    var v_co: [u8; 8] = "--code=\0"
                    if opt_word((&kebuf[0 as usize]) as u64, 80,
                        (&v_ke[0 as usize]) as u64,
                        (&e_kken[0 as usize]) as u64) {
                        argv[(n) as usize] = (&kebuf[0 as usize]) as u64
                        n = n + 1
                    }
                    if opt_word((&bebuf[0 as usize]) as u64, 80,
                        (&v_be[0 as usize]) as u64,
                        (&e_kber[0 as usize]) as u64) {
                        argv[(n) as usize] = (&bebuf[0 as usize]) as u64
                        n = n + 1
                    }
                    if opt_word((&cobuf[0 as usize]) as u64, 40,
                        (&v_co[0 as usize]) as u64,
                        (&e_kcode[0 as usize]) as u64) {
                        argv[(n) as usize] = (&cobuf[0 as usize]) as u64
                        n = n + 1
                    }
                    let rc: u64 = konto_lauf((&argv[0 as usize]) as u64, n,
                        (&e_kgeh[0 as usize]) as u64)
                    // DAS KENNWORT IST DURCH. Es wird sofort aus dem
                    // Feld genommen -- ein Eingabefeld, in dem nach dem
                    // Klick noch ein Passwort steht, ist ein Passwort
                    // auf dem Bildschirm.
                    var g: u64 = 0
                    while g < 64 {
                        e_kgeh[(g) as usize] = 0 as u8
                        g = g + 1
                    }
                    wlib.set_text(ekgeh, (&e_kgeh[0 as usize]) as u64)
                    var txt: [u8; 96] = [0 as u8; 96]
                    let hat: bool = account_field((&kf_text[0 as usize]) as u64,
                        (&txt[0 as usize]) as u64, 96)
                    var at: u64 = 0
                    if rc == 0 {
                        at = text_an((&l_kstat[0 as usize]) as u64, 0,
                            msg.get((&k_m_kok[0 as usize]) as u64))
                    } else {
                        at = text_an((&l_kstat[0 as usize]) as u64, 0,
                            msg.get((&k_m_kbad[0 as usize]) as u64))
                    }
                    if hat {
                        let _t2: u64 = text_an((&l_kstat[0 as usize]) as u64,
                            at, (&txt[0 as usize]) as u64)
                    }
                    accounts_read()
                    wlib.set_text(lkonten, (&k_liste[0 as usize]) as u64)
                    wlib.set_text(lkstat, (&l_kstat[0 as usize]) as u64)
                    wlib.dirty_all(w)
                    melde_stand()
                } else if id == bkout {
                    // ABMELDEN. Es wird nur abgemeldet, was AUSGEWAEHLT
                    // ist -- ein Knopf, der ohne Auswahl alles abmeldet,
                    // ist eine Falle.
                    var kbuf: [u8; 40] = [0 as u8; 40]
                    if k_n == 0 || !konto_kennung(wlib.value(lkonten),
                        (&kbuf[0 as usize]) as u64, 40) {
                        let _s1: u64 = text_an((&l_kstat[0 as usize]) as u64,
                            0, msg.get((&k_m_ksel[0 as usize]) as u64))
                    } else {
                        var a_ab: [u8; 9] = "abmelden\0"
                        var a_ke2: [u8; 10] = "--kennung\0"
                        var a_b1: [u8; 11] = "/bin/konto\0"
                        var argv2: [u64; 4] = [0 as u64; 4]
                        argv2[(0) as usize] = (&a_b1[0 as usize]) as u64
                        argv2[(1) as usize] = (&a_ab[0 as usize]) as u64
                        argv2[(2) as usize] = (&a_ke2[0 as usize]) as u64
                        argv2[(3) as usize] = (&kbuf[0 as usize]) as u64
                        let _rc2: u64 = konto_lauf(
                            (&argv2[0 as usize]) as u64, 4, 0)
                        let _s2: u64 = text_an((&l_kstat[0 as usize]) as u64,
                            0, msg.get((&k_m_kout[0 as usize]) as u64))
                        accounts_read()
                        wlib.set_text(lkonten, (&k_liste[0 as usize]) as u64)
                    }
                    wlib.set_text(lkstat, (&l_kstat[0 as usize]) as u64)
                    wlib.dirty_all(w)
                    melde_stand()
                } else if id == b8 {
                    // ================ RUNDE I18N, von Runde LOOK zurueck
                    //
                    // DIE SPRACHE UMSTELLEN, ZUR LAUFZEIT UND OHNE
                    // NEUSTART. Drei Schritte, und der dritte ist der,
                    // den man leicht vergisst:
                    //
                    //   1. Die Wahl SCHREIBEN, nach
                    //      /users/<name>/config/locale. Sie gehoert dem
                    //      BENUTZER -- deshalb nicht nach /etc/. Die
                    //      Vorgabe unter /etc/locale.conf, die Runde
                    //      LOOK eingefuehrt hat, wird hier NICHT
                    //      angefasst: eine Wahl schlaegt eine Vorgabe,
                    //      und ein Programm, das die Vorgabe der
                    //      Maschine ueberschreibt, weil ein Benutzer
                    //      etwas gewaehlt hat, hat die beiden
                    //      verwechselt.
                    //   2. Den Katalog UMSTELLEN. `msg.set_lang` fuellt
                    //      die festen Plaetze neu; die Zeiger, die jedes
                    //      Bedienelement dieses Fensters haelt, bleiben
                    //      dieselben Adressen. Genau dafuer sind die
                    //      Plaetze fest.
                    //   3. Die zusammengesetzten Beschriftungen NEU
                    //      BAUEN. "Adresse: 10.0.2.15" ist kein
                    //      Katalogtext, sondern ein Katalogtext PLUS
                    //      eine Zahl; das tut `stand_lesen`.
                    var code: u64 = (&c_en[0 as usize]) as u64
                    if wlib.value(cl) == 1 {
                        code = (&c_de[0 as usize]) as u64
                    }
                    let _kb: u64 = ulib.sys(SYS_KBD, KB_SET,
                        wlib.value(ck2), 0)
                    if msg.save_lang(code) {
                        let _sl: bool = msg.set_lang(code)
                        state_read()
                        let al: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_langok[0 as usize]) as u64))
                        let _sm: u64 = text_an((&l_stat[0 as usize]) as u64,
                            al, code)
                    } else {
                        let _sn: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_langno[0 as usize]) as u64))
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    // Jedes Bedienelement zeigt auf denselben Platz wie
                    // vorher -- nur steht dort jetzt ein anderer Text.
                    // Also reicht Neuzeichnen.
                    wlib.draw_all()
                    melde_stand()
                }
            }
        }
    }
    let _q1: u64 = lz
    let _q2: u64 = en1
    let _q3: u64 = en2
    let _q4: u64 = en3
    let _q5: u64 = ep1
    let _q6: u64 = ep2
    let _q7: u64 = (&s_pfad[0 as usize]) as u64
    return 0
}

// ====================================================== ROUND NETVIEW
//
// EINE ZEILE JE LAUFENDEM PROZESS: "<pid> <sicht>". Die Zahlen kommen
// aus der AUFGABENTAFEL (SYS_PSTAT) und die Sicht aus dem Kern
// (SYS_NETVGET) -- diese Seite fuehrt keine eigene Liste, weil eine
// zweite Liste eine zweite Gelegenheit waere, etwas anderes anzuzeigen
// als der Fall ist. Und genau das ist der Grundsatz der Runde: getaeuscht
// wird das Programm, nie der Mensch davor.
// DRITTER NACHTRAG: die Zeile wird nicht mehr hier geschrieben.
// `nv.fallback_save` tut es, fuer diese Seite, fuer `/bin/netview` und
// fuer die Schnelleinstellungen -- die FORM der Zeile stand vorher in
// zwei Dateien, und das war in `docs/NETVIEW.md` als Naht benannt.
// Diese Runde macht daraus eine Stelle statt drei.

fn nv_read() {
    var sp: [u8; 2] = " \0"
    var nl: [u8; 2] = "\n\0"
    var nm: [u8; 16] = [0 as u8; 16]
    var at: u64 = 0
    nv_n = 0
    var i: u64 = 0
    while i < 32 && at < 900 {
        let close_path: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_STATE, 0)
        if !ulib.bad(close_path) && close_path != 0 {
            if ulib.sys(ulib.SYS_PSTAT, i, ulib.P_KIND, 0) == 3 {
                let pid: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PID, 0)
                nv_pids[(nv_n) as usize] = pid
                at = num_at((&nv_liste[0 as usize]) as u64, at, pid)
                at = text_an((&nv_liste[0 as usize]) as u64, at,
                    (&sp[0 as usize]) as u64)
                let _n: u64 = nv.view_name(nv.view_of(pid),
                    (&nm[0 as usize]) as u64)
                at = text_an((&nv_liste[0 as usize]) as u64, at,
                    (&nm[0 as usize]) as u64)
                at = text_an((&nv_liste[0 as usize]) as u64, at,
                    (&nl[0 as usize]) as u64)
                nv_n = nv_n + 1
            }
        }
        i = i + 1
    }
}

// RUNDE 31: das `main`, das nie laeuft -- `user.ld` setzt den Einsprung
// auf `u_start`. Das Profil `app` verlangt es trotzdem; es ruft
// `u_start`, damit es nicht luegt.
fn main() -> i32 {
    return u_start(0) as i32
}
