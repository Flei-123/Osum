                    var oki: bool = false
                    if setbase.e_vfile[(0) as usize] != 0 as u8
                        && setbase.e_vid[(0) as usize] != 0 as u8 {
                        oki = template.import_from((&setbase.e_vfile[0 as usize]) as u64,
