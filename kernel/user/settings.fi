    // DIE BESTAETIGUNGSFRAGE. Zwei Knoepfe und eine Zeile, die
    // herunterzaehlt -- und sie stehen nur da, solange wirklich eine
    // Frist laeuft. Was sie WIRKLICH sicher macht, steht aber nicht
    // hier: der Kernel bringt den alten Modus auch dann zurueck, wenn
    // dieses Programm gar nicht mehr antwortet (`vmode.poll`). Ein
    // Sicherheitsnetz, das von dem Programm abhaengt, dessen Bildschirm
    // gerade schwarz ist, waere keines.
    let _sf: u64 = merke(wlib.label((&d_frist[0 as usize]) as u64), R_SCREEN)
