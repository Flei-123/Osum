    wlib.size(140, 26)
    let b7: u64 = merke(wlib.button(msg.get((&k_b_fbue[0 as usize]) as u64)), R_NETV)
    // ---- Sprache (RUNDE I18N, von Runde LOOK zurueckgeholt)
    let _p1: u64 = merke(wlib.label(msg.get((&k_lang[0 as usize]) as u64)),
        R_SPRACHE)
    var lidx: u64 = 0
    if __mmio_read8((msg.lang()) as *mut u8) == 100 as u8 {
        lidx = 1
    }
    let cl: u64 = merke(wlib.choice(msg.get((&k_clang[0 as usize]) as u64),
        lidx), R_SPRACHE)
    let _p2: u64 = merke(wlib.label(msg.get((&k_kbd[0 as usize]) as u64)),
        R_SPRACHE)
    var kidx: u64 = ulib.sys(SYS_KBD, KB_GET, 0, 0)
    if ulib.bad(kidx) {
