    let lkstat: u64 = merke(wlib.label((&l_kstat[0 as usize]) as u64), R_KONTO)
    // RUNDE MERGE8: GEHEIMNIS UND BEREICH STEHEN RECHTS.
    // Die linke Spalte dieser Seite trug siebzehn Bedienelemente und
    // endete bei 632 Bildpunkten -- das Fenster hat 542. Gemessen mit
    // `uitrace` (tools/themestore/run.sh, Abschnitt 8): drei Elemente
    // ragten hinaus. Zwei Beschriftungs-Feld-Paare (136 Bildpunkte)
    // wandern in die rechte Spalte, die nach der Liste noch Platz hat.
    // Danach endet links bei 496 und rechts bei 452.
    let _kt6: u64 = merke(wlib.label(msg.get((&k_k_geh[0 as usize]) as u64)),
