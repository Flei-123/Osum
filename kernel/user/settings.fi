                    // deshalb kann `/bin/konto` beide Schreibweisen.
                    var a_an: [u8; 9] = "anmelden\0"
                    var a_b0: [u8; 11] = "/bin/konto\0"
                    var argv: [u64; 8] = [0 as u64; 8]
                    var n: u64 = 0
                    argv[(n) as usize] = (&a_b0[0 as usize]) as u64
                    n = n + 1
                    argv[(n) as usize] = (&a_an[0 as usize]) as u64
                    n = n + 1
                    // Der gewaehlte Anbieter ist die n-te Zeile der
                    // Liste, die `/bin/konto anbieter` geliefert hat.
                    var anbuf: [u8; 48] = [0 as u8; 48]
                    var vor_anb: [u8; 12] = "--anbieter=\0"
                    var o: u64 = 0
                    while vor_anb[(o) as usize] != 0 as u8 {
                        anbuf[(o) as usize] = vor_anb[(o) as usize]
                        o = o + 1
                    }
                    var zeile: u64 = kval[(K_CKANB) as usize]
                    var q: u64 = 0
                    var z: u64 = 0
                    while k_anbn[(q) as usize] != 0 as u8 && o + 1 < 48 {
                        if k_anbn[(q) as usize] == 10 as u8 {
                            z = z + 1
                        } else if z == zeile {
                            anbuf[(o) as usize] = k_anbn[(q) as usize]
                            o = o + 1
                        }
                        q = q + 1
                    }
                    anbuf[(o) as usize] = 0 as u8
                    argv[(n) as usize] = (&anbuf[0 as usize]) as u64
                    n = n + 1
                    // Die uebrigen Felder, jedes als EIN Wort
                    // `--name=<wert>`. Ein leeres Feld faellt weg.
                    // Die ADRESSE geht nicht auf die Befehlszeile --
                    // sie wird gemerkt (/etc/konten.conf) und von
                    // `/bin/konto` dort gelesen. Der Anbietername steht
                    // in `anbuf` hinter `--anbieter=`; gemerkt wird der
                    // Name selbst, also elf Zeichen weiter.
                    let _cm: bool = conf_remember(
                        (&anbuf[(11) as usize]) as u64,
                        (&e_kziel[0 as usize]) as u64,
                        (&e_kname[0 as usize]) as u64)
                    var kebuf: [u8; 80] = [0 as u8; 80]
                    var bebuf: [u8; 80] = [0 as u8; 80]
                    var cobuf: [u8; 40] = [0 as u8; 40]
                    var v_ke: [u8; 11] = "--kennung=\0"
                    var v_be: [u8; 11] = "--bereich=\0"
                    var v_co: [u8; 8] = "--code=\0"
                    if opt_word((&kebuf[0 as usize]) as u64, 80,
                        (&v_ke[0 as usize]) as u64,
                        (&e_kken[0 as usize]) as u64) {
                        argv[(n) as usize] = (&kebuf[0 as usize]) as u64
                        n = n + 1
                    }
                    if opt_word((&bebuf[0 as usize]) as u64, 80,
                        (&v_be[0 as usize]) as u64,
                        (&e_kber[0 as usize]) as u64) {
                        argv[(n) as usize] = (&bebuf[0 as usize]) as u64
                        n = n + 1
                    }
                    if opt_word((&cobuf[0 as usize]) as u64, 40,
                        (&v_co[0 as usize]) as u64,
                        (&e_kcode[0 as usize]) as u64) {
                        argv[(n) as usize] = (&cobuf[0 as usize]) as u64
                        n = n + 1
                    }
                    let rc: u64 = konto_lauf((&argv[0 as usize]) as u64, n,
                        (&e_kgeh[0 as usize]) as u64)
                    // DAS KENNWORT IST DURCH. Es wird sofort aus dem
                    // Feld genommen -- ein Eingabefeld, in dem nach dem
                    // Klick noch ein Passwort steht, ist ein Passwort
                    // auf dem Bildschirm.
                    var g: u64 = 0
                    while g < 64 {
                        e_kgeh[(g) as usize] = 0 as u8
                        g = g + 1
                    }
                    fuiscene.entry_set(K_EKGEH, (&e_kgeh[0 as usize]) as u64)
                    var txt: [u8; 96] = [0 as u8; 96]
                    let hat: bool = account_field((&kf_text[0 as usize]) as u64,
                        (&txt[0 as usize]) as u64, 96)
                    var at: u64 = 0
                    if rc == 0 {
                        at = text_an((&l_kstat[0 as usize]) as u64, 0,
                            msg.get((&k_m_kok[0 as usize]) as u64))
                    } else {
                        at = text_an((&l_kstat[0 as usize]) as u64, 0,
                            msg.get((&k_m_kbad[0 as usize]) as u64))
                    }
                    if hat {
                        let _t2: u64 = text_an((&l_kstat[0 as usize]) as u64,
                            at, (&txt[0 as usize]) as u64)
                    }
                    accounts_read()
                    book_state()
                    // (described again)
                    // (described again)
                    // (described again)
                    melde_stand()
                } else if id == K_BKDEV || id == K_BKBOOK {
                    // SIGN IN WITH A CODE (device flow). First click: start,
                    // show code + URL. Next clicks: ask ONCE whether the
                    // human has confirmed. No password on this device; the
                    // provider comes from the choice, the address from
                    // /etc/konten.conf (the field is remembered like for
                    // the password sign-in).
                    var d_an: [u8; 9] = "anmelden\0"
                    var d_b0: [u8; 11] = "/bin/konto\0"
                    var d_ge: [u8; 9] = "--device\0"
                    var d_zw: [u8; 12] = "--continue=\0"
                    var dbuf: [u8; 48] = [0 as u8; 48]
                    var dzw: [u8; 140] = [0 as u8; 140]
                    var dargv: [u64; 8] = [0 as u64; 8]
                    var dv_anb: [u8; 12] = "--anbieter=\0"
                    var d_ta: [u8; 11] = "--exchange\0"
                    var dn: u64 = 0
                    var dopen: u64 = 0
                    while dv_anb[(dopen) as usize] != 0 as u8 {
                        dbuf[(dopen) as usize] = dv_anb[(dopen) as usize]
                        dopen = dopen + 1
                    }
                    var dz: u64 = 0
                    var dq: u64 = 0
                    while k_anbn[(dq) as usize] != 0 as u8 && dopen + 1 < 48 {
                        if k_anbn[(dq) as usize] == 10 as u8 {
                            dz = dz + 1
                        } else if dz == kval[(K_CKANB) as usize] {
                            dbuf[(dopen) as usize] = k_anbn[(dq) as usize]
                            dopen = dopen + 1
                        }
                        dq = dq + 1
                    }
                    dbuf[(dopen) as usize] = 0 as u8
                    let _dcm: bool = conf_remember(
                        (&dbuf[(11) as usize]) as u64,
                        (&e_kziel[0 as usize]) as u64,
                        (&e_kname[0 as usize]) as u64)
                    dargv[(dn) as usize] = (&d_b0[0 as usize]) as u64
                    dn = dn + 1
                    dargv[(dn) as usize] = (&d_an[0 as usize]) as u64
                    dn = dn + 1
                    dargv[(dn) as usize] = (&dbuf[0 as usize]) as u64
                    dn = dn + 1
                    dargv[(dn) as usize] = (&d_ge[0 as usize]) as u64
                    dn = dn + 1
                    if opt_word((&dzw[0 as usize]) as u64, 140,
                        (&d_zw[0 as usize]) as u64,
                        (&dev_zw[0 as usize]) as u64) {
                        dargv[(dn) as usize] = (&dzw[0 as usize]) as u64
                        dn = dn + 1
                    }
                    if id == K_BKBOOK {
                        // also hand the access token to the address book
                        // (the back end does it; a failed swap never
                        // undoes the sign-in)
                        dargv[(dn) as usize] = (&d_ta[0 as usize]) as u64
                        dn = dn + 1
                    }
                    let drc: u64 = konto_lauf((&dargv[0 as usize]) as u64, dn, 0)
                    var dtxt: [u8; 96] = [0 as u8; 96]
                    var dcode: [u8; 24] = [0 as u8; 24]
                    var durl: [u8; 100] = [0 as u8; 100]
                    let dhat: bool = account_field((&kf_text[0 as usize]) as u64,
                        (&dtxt[0 as usize]) as u64, 96)
                    var dat: u64 = 0
                    if drc == 11 {
                        // waiting for the human: keep the device code, show code + URL
                        let _c1: bool = account_field((&kf_code[0 as usize]) as u64,
                            (&dcode[0 as usize]) as u64, 24)
                        let _c2: bool = account_field((&kf_url[0 as usize]) as u64,
                            (&durl[0 as usize]) as u64, 60)
                        if dev_zw[0] == 0 as u8 {
                            let _c3: bool = account_field((&kf_zw[0 as usize]) as u64,
                                (&dev_zw[0 as usize]) as u64, 120)
                        }
                        dat = text_an((&l_kstat[0 as usize]) as u64, 0,
                            msg.get((&k_m_kcode[0 as usize]) as u64))
                        dat = text_an((&l_kstat[0 as usize]) as u64, dat,
                            (&dcode[0 as usize]) as u64)
                        let _sp: u64 = text_an((&l_kstat[0 as usize]) as u64, dat,
                            (&durl[0 as usize]) as u64)
                    } else {
                        // final answer (ok, denied, expired, error): the next click starts anew
                        var dg: u64 = 0
                        while dg < 120 {
                            dev_zw[(dg) as usize] = 0 as u8
                            dg = dg + 1
                        }
                        var dtau: [u8; 24] = [0 as u8; 24]
                        var dhin: [u8; 160] = [0 as u8; 160]
                        var dsw: bool = false
                        if id == K_BKBOOK {
                            // an `exchange` line (old: `tausch`) means the sign-in worked
                            dsw = account_field((&kf_exchange[0 as usize]) as u64,
                                (&dtau[0 as usize]) as u64, 24)
                            if !dsw {
                                dsw = account_field((&kf_tausch[0 as usize]) as u64,
                                    (&dtau[0 as usize]) as u64, 24)
                            }
                        }
                        if dsw {
                            let dh: bool = account_field((&kf_hint[0 as usize]) as u64,
                                (&dhin[0 as usize]) as u64, 160)
                            var hp: u64 = 0
                            if dh {
                                hp = (&dhin[0 as usize]) as u64
                            }
                            dat = text_an((&l_kstat[0 as usize]) as u64, 0,
                                msg.get(book_key((&dtau[0 as usize]) as u64, hp)))
                        } else if drc == 0 {
                            dat = text_an((&l_kstat[0 as usize]) as u64, 0,
                                msg.get((&k_m_kok[0 as usize]) as u64))
                        } else {
                            dat = text_an((&l_kstat[0 as usize]) as u64, 0,
                                msg.get((&k_m_kbad[0 as usize]) as u64))
                        }
                        if dhat && !dsw {
                            let _t3: u64 = text_an((&l_kstat[0 as usize]) as u64,
                                dat, (&dtxt[0 as usize]) as u64)
                        }
                    }
                    accounts_read()
                    book_state()
                    melde_stand()
                } else if id == K_BKOUT {
                    // ABMELDEN. Es wird nur abgemeldet, was AUSGEWAEHLT
                    // ist -- ein Knopf, der ohne Auswahl alles abmeldet,
                    // ist eine Falle.
                    var kbuf: [u8; 40] = [0 as u8; 40]
                    if k_n == 0 || !konto_kennung(fuiscene.table_sel(K_LKONTEN),
                        (&kbuf[0 as usize]) as u64, 40) {
                        let _s1: u64 = text_an((&l_kstat[0 as usize]) as u64,
                            0, msg.get((&k_m_ksel[0 as usize]) as u64))
                    } else {
                        var a_ab: [u8; 9] = "abmelden\0"
                        var a_ke2: [u8; 10] = "--kennung\0"
                        var a_b1: [u8; 11] = "/bin/konto\0"
                        var argv2: [u64; 4] = [0 as u64; 4]
                        argv2[(0) as usize] = (&a_b1[0 as usize]) as u64
                        argv2[(1) as usize] = (&a_ab[0 as usize]) as u64
                        argv2[(2) as usize] = (&a_ke2[0 as usize]) as u64
                        argv2[(3) as usize] = (&kbuf[0 as usize]) as u64
                        let _rc2: u64 = konto_lauf(
                            (&argv2[0 as usize]) as u64, 4, 0)
                        let _s2: u64 = text_an((&l_kstat[0 as usize]) as u64,
                            0, msg.get((&k_m_kout[0 as usize]) as u64))
                        accounts_read()
                        book_state()
                        // (described again)
                    }
                    // (described again)
                    // (described again)
                    melde_stand()
                } else if id == K_B8 {
                    // ================ RUNDE I18N, von Runde LOOK zurueck
                    //
                    // DIE SPRACHE UMSTELLEN, ZUR LAUFZEIT UND OHNE
                    // NEUSTART. Drei Schritte, und der dritte ist der,
                    // den man leicht vergisst:
                    //
                    //   1. Die Wahl SCHREIBEN, nach
                    //      /users/<name>/config/locale. Sie gehoert dem
                    //      BENUTZER -- deshalb nicht nach /etc/. Die
                    //      Vorgabe unter /etc/locale.conf, die Runde
                    //      LOOK eingefuehrt hat, wird hier NICHT
                    //      angefasst: eine Wahl schlaegt eine Vorgabe,
                    //      und ein Programm, das die Vorgabe der
                    //      Maschine ueberschreibt, weil ein Benutzer
                    //      etwas gewaehlt hat, hat die beiden
                    //      verwechselt.
                    //   2. Den Katalog UMSTELLEN. `msg.set_lang` fuellt
                    //      die festen Plaetze neu; die Zeiger, die jedes
                    //      Bedienelement dieses Fensters haelt, bleiben
                    //      dieselben Adressen. Genau dafuer sind die
                    //      Plaetze fest.
                    //   3. Die zusammengesetzten Beschriftungen NEU
                    //      BAUEN. "Adresse: 10.0.2.15" ist kein
                    //      Katalogtext, sondern ein Katalogtext PLUS
                    //      eine Zahl; das tut `stand_lesen`.
                    var code: u64 = (&c_en[0 as usize]) as u64
                    if kval[(K_CL) as usize] == 1 {
                        code = (&c_de[0 as usize]) as u64
                    }
                    let _kb: u64 = ulib.sys(SYS_KBD, KB_SET,
                        kval[(K_CK2) as usize], 0)
                    if lang_write(code) {
                        let _sl: bool = msg.set_lang(code)
                        state_read()
                        let al: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_langok[0 as usize]) as u64))
                        let _sm: u64 = text_an((&l_stat[0 as usize]) as u64,
                            al, code)
                    } else {
                        let _sn: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_langno[0 as usize]) as u64))
                    }
                    // (described again)
                    // Jedes Bedienelement zeigt auf denselben Platz wie
                    // vorher -- nur steht dort jetzt ein anderer Text.
                    // Also reicht Neuzeichnen.
                    // (described again)
                    melde_stand()
                }
            }
            push_entries()
            fuiscene.refresh()
            rep_due = 1
        }
    }
    return 0
}


// ====================================================== ROUND NETVIEW
//
// EINE ZEILE JE LAUFENDEM PROZESS: "<pid> <sicht>". Die Zahlen kommen
// aus der AUFGABENTAFEL (SYS_PSTAT) und die Sicht aus dem Kern
// (SYS_NETVGET) -- diese Seite fuehrt keine eigene Liste, weil eine
// zweite Liste eine zweite Gelegenheit waere, etwas anderes anzuzeigen
// als der Fall ist. Und genau das ist der Grundsatz der Runde: getaeuscht
// wird das Programm, nie der Mensch davor.
// DRITTER NACHTRAG: die Zeile wird nicht mehr hier geschrieben.
// `nv.fallback_save` tut es, fuer diese Seite, fuer `/bin/netview` und
// fuer die Schnelleinstellungen -- die FORM der Zeile stand vorher in
// zwei Dateien, und das war in `docs/NETVIEW.md` als Naht benannt.
// Diese Runde macht daraus eine Stelle statt drei.

fn nv_read() {
    var sp: [u8; 2] = " \0"
    var nl: [u8; 2] = "\n\0"
    var nm: [u8; 16] = [0 as u8; 16]
    var at: u64 = 0
    nv_n = 0
    var i: u64 = 0
    while i < 32 && at < 900 {
        let close_path: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_STATE, 0)
        if !ulib.bad(close_path) && close_path != 0 {
            if ulib.sys(ulib.SYS_PSTAT, i, ulib.P_KIND, 0) == 3 {
                let pid: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PID, 0)
                nv_pids[(nv_n) as usize] = pid
                at = num_at((&nv_liste[0 as usize]) as u64, at, pid)
                at = text_an((&nv_liste[0 as usize]) as u64, at,
                    (&sp[0 as usize]) as u64)
                let _n: u64 = nv.view_name(nv.view_of(pid),
                    (&nm[0 as usize]) as u64)
                at = text_an((&nv_liste[0 as usize]) as u64, at,
                    (&nm[0 as usize]) as u64)
                at = text_an((&nv_liste[0 as usize]) as u64, at,
                    (&nl[0 as usize]) as u64)
                nv_n = nv_n + 1
            }
        }
        i = i + 1
    }
}

// RUNDE ROTABSCHNITTE: DIESES `main` LAEUFT, UND ES MUSS DIE
// ARGUMENTE WEITERGEBEN.
//
// Der Kommentar, der hier stand, sagte "das `main`, das nie laeuft --
// `user.ld` springt nach `u_start`". Das stimmt fuer ein Programm, das
// mit `kernel/user/crt.s` gebunden ist; dessen `_start` ruft
// USER_ENTRY. Unter `profile app` stimmt es NICHT: dort bringt firnc
// sein eigenes `_start` mit (darum darf crt.o nicht dazu, siehe
// tools/look/shot.sh), und das endet in `call main` -- der Name steht
// fest in lib/firnc1/codegen.fi, `--defsym=USER_ENTRY` erreicht ihn
// nicht. Am gebauten ELF nachgesehen: Einsprung ist `_start`, sechs
// Befehle weiter steht `call <main>`; `_F0.u_start` wird von dort nie
// gerufen.
//
// `u_start(0)` warf damit den Argumentblock weg. Bei powermon waren
// das 54 rote Zusagen (siehe ROTABSCHNITTE 11/n).
//
// Der Block liegt an einer FESTEN Adresse: Runde K16 legte den
// Stapelzeiger darauf (kernel/elf.fi, `T_USTACK = proc.ARGS_BASE`),
// und firnc's `_start` macht `mov rsp, rdi`. Jede `elf: start`-Zeile
// dieses Systems druckt sie als `ustack=0x4007f000`.
fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
