// page R_SCREEN (SET-7: 7 controls -- mode list, scaling, rotation, brightness, apply, keep, back; the rest is on R_SCREEN2)
fn page_screen(left: usize, right: usize) {
    let _n_s1: usize = fuiscene.label(left, (&l_schirm[0 as usize]) as u64)
    let _n_sk: usize = fuiscene.label(left, (&d_karte[0 as usize]) as u64)
