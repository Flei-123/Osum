// ==================================== ROUND THEMESTORE: the preset tab
//
// TWELVE TILES AT MOST, and each of them owns seventeen words that
// `wlib.tile` reads and this file fills out of `wlibc.theme_probe`.
// The tile does not resolve anything and this file does not draw
// anything; that split is why a tile cannot go stale.
// TEN TILES, AND THE TEN IS A SUBTRACTION AND NOT A ROUND NUMBER.
// The window has 542 usable pixels; the tab bar and the status line
// take 92; a tile is `row + 10`, which is 34 under `modern`. Ten of
// them plus the heading and the gaps come to 404 of the 450 that are
// left. Eleven do not fit. A store with more than ten presets shows
// the first ten as tiles and all of them in `/bin/theme list` -- and
// says which is which rather than silently dropping the eleventh.
const TILES: u64 = 10
static mut tsp: [u64; 170] = [0 as u64; 170] // TILES * wlib.TILE_FIELDS
