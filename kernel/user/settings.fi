    let _n_s2b: usize = fuiscene.label(left, msg.get((&k_l_aufl2[0 as usize]) as u64))
    let _n_cs: usize = fuiscene.table_list(left, K_CS, 0, 110, 1, (&d_modi[0 as usize]) as u64)
    let _n_s5: usize = fuiscene.label(left, msg.get((&k_l_skal[0 as usize]) as u64))
    let n_ck: usize = fuiscene.choice(left, chtext(K_CK, msg.get((&k_c_skal[0 as usize]) as u64)), K_CK)
    fuiscene.set_size(n_ck, 0, 28)
    let _n_s6: usize = fuiscene.label(left, msg.get((&k_l_dreh[0 as usize]) as u64))
    let n_cd: usize = fuiscene.choice(left, chtext(K_CD, msg.get((&k_c_dreh[0 as usize]) as u64)), K_CD)
    fuiscene.set_size(n_cd, 0, 28)
    let _n_s7: usize = fuiscene.label(left, msg.get((&k_l_hell[0 as usize]) as u64))
    let n_ch: usize = fuiscene.choice(left, chtext(K_CH, msg.get((&k_c_hell[0 as usize]) as u64)), K_CH)
    fuiscene.set_size(n_ch, 0, 28)
