    // ---- Netzzugriff (ROUND NETVIEW)
    let _v1: u64 = merke(wlib.label(msg.get((&k_l_nv1[0 as usize]) as u64)), R_NETV)
    let _v2: u64 = merke(wlib.label(msg.get((&k_l_nv2[0 as usize]) as u64)), R_NETV)
    nv_read()
    wlib.size(0, 150)
    let lv: u64 = merke(wlib.list((&nv_liste[0 as usize]) as u64, 8), R_NETV)
    let _v3: u64 = merke(wlib.label(msg.get((&k_l_nv3[0 as usize]) as u64)), R_NETV)
    let cv: u64 = merke(wlib.choice(msg.get((&k_c_view[0 as usize]) as u64), 0), R_NETV)
    wlib.size(140, 26)
    let b6: u64 = merke(wlib.button(msg.get((&k_b_uber[0 as usize]) as u64)), R_NETV)
    // ---- ZWEITER NACHTRAG: die systemweite Voreinstellung
