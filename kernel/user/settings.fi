    //      erlaubt sie.
    //   2. TIPPT GERADE JEMAND? -- die Frage, die kein Fernzugriff
    //      selbst beantworten darf; sie geht an den KERN (TI_INFO).
    //   3. AUS. Der Knopf schreibt `eingabe = nein` und
    //      `bildschirmfoto = nein` in die Rechteliste und nimmt einen
    //      offenen Tippschein weg. Der Helfer liest die Datei VOR
    //      JEDEM Auftrag neu -- es wirkt also sofort, ohne Neustart.
    let _b1: u64 = merke(wlib.label((&l_br_titel[0 as usize]) as u64),
