fn bx_put(buf: u64, at: u64, max: u64, p: u64) -> u64 {
    var i: u64 = 0
    var o: u64 = at
    while rb(p, i) != 0 && o + 1 < max {
        __mmio_write8((buf + o) as *mut u8, __mmio_read8((p + i) as *mut u8))
        o = o + 1
        i = i + 1
    }
    __mmio_write8((buf + o) as *mut u8, 0 as u8)
    return o
}

fn bx_putn(buf: u64, at: u64, max: u64, p: u64, n: u64) -> u64 {
    var i: u64 = 0
    var o: u64 = at
    while i < n && o + 1 < max {
        __mmio_write8((buf + o) as *mut u8, __mmio_read8((p + i) as *mut u8))
        o = o + 1
        i = i + 1
    }
    __mmio_write8((buf + o) as *mut u8, 0 as u8)
    return o
}

fn bx_ch(buf: u64, at: u64, max: u64, c: u64) -> u64 {
    if at + 1 >= max {
        return at
    }
    __mmio_write8((buf + at) as *mut u8, c as u8)
    __mmio_write8((buf + at + 1) as *mut u8, 0 as u8)
    return at + 1
}

fn bx_num(buf: u64, at: u64, max: u64, v: u64) -> u64 {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = ulib.digits(v, (&z[0 as usize]) as u64)
    return bx_putn(buf, at, max, (&z[0 as usize]) as u64, n)
}

fn rb(p: u64, i: u64) -> u64 {
    return __mmio_read8((p + i) as *mut u8) as u64
}

// the status line of a page: a catalogue text and, if given, a detail
fn stat_set(buf: u64, key: u64, detail: u64) {
    var o: u64 = bx_put(buf, 0, 200, msg.get(key))
    if detail != 0 {
        o = bx_ch(buf, o, 200, 32)
        o = bx_put(buf, o, 200, detail)
    }
}

// ---------------------------------------------------------- System

static mut sy_areas: [u8; 54] = "display sound lock locale net update security privacy\0"

// one area of settings.list into the table; returns the new blob end
fn sys_area(area: u64, at0: u64) -> u64 {
    let bp: u64 = (&b_sys[0 as usize]) as u64
    var at: u64 = at0
    var v_list: [u8; 19] = "call settings.list\0"
    var k_area: [u8; 5] = "area\0"
    actcli.req((&v_list[0 as usize]) as u64)
    actcli.arg((&k_area[0 as usize]) as u64, area)
    if actcli.send(300) != actcli.R_OK {
        return at
    }
    let rp: u64 = actcli.reply()
    // the reply: ok, count=n, then per key three lines --
    //   <key>=<value>   <key>.type=<type> <range> <risk>   <key>.text=<t>
    var ln: [u8; 240] = [0 as u8; 240]
    let lp: u64 = (&ln[0 as usize]) as u64
    var k: u64 = 2
    while actcli.line(k, lp, 240) {
        let kp: u64 = (&sy_keys[0 as usize]) as u64 + sy_rows * 32
        // the key: up to '='
        var e: u64 = 0
        while rb(lp, e) != 0 && rb(lp, e) != 61 {
            e = e + 1
        }
        if sy_rows < 32 {
            let _kk: u64 = bx_putn(kp, 0, 32, lp, e)
            at = bx_putn(bp, at, 4096, lp, e)
            at = bx_ch(bp, at, 4096, 9)
            if rb(lp, e) == 61 {
                at = bx_put(bp, at, 4096, lp + e + 1)
            }
            at = bx_ch(bp, at, 4096, 9)
            // the risk: last word of the .type line
            var ty: [u8; 240] = [0 as u8; 240]
            let tp: u64 = (&ty[0 as usize]) as u64
            if actcli.line(k + 1, tp, 240) {
                var s: u64 = 0
                var j: u64 = 0
                while rb(tp, j) != 0 {
                    if rb(tp, j) == 32 {
                        s = j + 1
                    }
                    j = j + 1
                }
                // shown in the user's language; the broker's word stays
                // the key (unknown words pass through unchanged)
                if rb(tp, s) == 99 {
                    at = bx_put(bp, at, 4096,
                        msg.get((&k_sy_crit[0 as usize]) as u64))
                } else if rb(tp, s) == 104 {
                    at = bx_put(bp, at, 4096,
                        msg.get((&k_sy_harm[0 as usize]) as u64))
                } else {
                    at = bx_put(bp, at, 4096, tp + s)
                }
            }
            at = bx_ch(bp, at, 4096, 9)
            var tx: [u8; 240] = [0 as u8; 240]
            let xp: u64 = (&tx[0 as usize]) as u64
            if actcli.line(k + 2, xp, 240) {
                var q: u64 = 0
                while rb(xp, q) != 0 && rb(xp, q) != 61 {
                    q = q + 1
                }
                if rb(xp, q) == 61 {
                    // AB-005c: the meaning in the user's language --
                    // "settings.key.<key>" from the catalogue; a key the
                    // catalogue does not know shows the schema's English
                    var ck: [u8; 64] = [0 as u8; 64]
                    let cp: u64 = (&ck[0 as usize]) as u64
                    var s_pre: [u8; 14] = "settings.key.\0"
                    var o: u64 = bx_put(cp, 0, 64, (&s_pre[0 as usize]) as u64)
                    // "<key>.text": the key is everything before ".text"
                    var e: u64 = 0
                    if q > 5 {
                        e = q - 5
                    }
                    let _o2: u64 = bx_putn(cp + o, 0, 64 - o, xp, e)
                    let tr: u64 = msg.get(cp)
                    if tr != cp {
                        at = bx_put(bp, at, 4096, tr)
                    } else {
                        at = bx_put(bp, at, 4096, xp + q + 1)
                    }
                }
            }
            at = bx_ch(bp, at, 4096, 10)
            sy_rows = sy_rows + 1
        }
        k = k + 3
    }
    return at
}

fn sys_load() {
    let bp: u64 = (&b_sys[0 as usize]) as u64
    var at: u64 = bx_put(bp, 0, 4096, msg.get((&k_sy_head[0 as usize]) as u64))
    at = bx_ch(bp, at, 4096, 10)
    sy_rows = 0
    if !actcli.open() {
        at = bx_put(bp, at, 4096, msg.get((&k_sy_nobus[0 as usize]) as u64))
        at = bx_ch(bp, at, 4096, 10)
    } else {
        let ap: u64 = (&sy_areas[0 as usize]) as u64
        var w0: u64 = 0
        var i: u64 = 0
        var wd: [u8; 24] = [0 as u8; 24]
        let wp: u64 = (&wd[0 as usize]) as u64
        while true {
            let c: u64 = rb(ap, i)
            if c == 32 || c == 0 {
                let _w: u64 = bx_putn(wp, 0, 24, ap + w0, i - w0)
                at = sys_area(wp, at)
                w0 = i + 1
            }
            if c == 0 {
                break
            }
            i = i + 1
        }
        if sy_rows == 0 {
            at = bx_put(bp, at, 4096, msg.get((&k_sy_nobus[0 as usize]) as u64))
            at = bx_ch(bp, at, 4096, 10)
        }
    }
    var s1: [u8; 32] = "settings: bus page=system rows=\0"
    say((&s1[0 as usize]) as u64)
    sayn(sy_rows)
    nl()
}

// the key of the selected row; false = nothing selected
fn sys_key(out: u64) -> bool {
    if sy_rows == 0 {
        return false
    }
    // the header line is not a row: `value` counts the data rows
    let r: u64 = fuiscene.table_sel(sy_tab)
    if r >= sy_rows {
        return false
    }
    let _o: u64 = bx_put(out, 0, 32, (&sy_keys[0 as usize]) as u64 + r * 32)
    return true
}

fn sys_answer(rc: u64, key: u64) {
    let sp: u64 = (&l_systat[0 as usize]) as u64
    var ln: [u8; 160] = [0 as u8; 160]
    let lp: u64 = (&ln[0 as usize]) as u64
    let _l: bool = actcli.line(0, lp, 160)
    if rc == actcli.R_OK {
        stat_set(sp, (&k_sy_ok[0 as usize]) as u64, key)
    } else if rc == actcli.R_CONFIRM {
        // "confirm <no> <action>": the number is the second word
        var j: u64 = 8
        var no: u64 = 0
        while rb(lp, j) >= 48 && rb(lp, j) <= 57 {
            no = no * 10 + rb(lp, j) - 48
            j = j + 1
        }
        sy_pend = no
        // the key waits with its number: "Ja, ändern" names it again
        let _pk: u64 = bx_put((&sy_pkey[0 as usize]) as u64, 0, 40, key)
        stat_set(sp, (&k_sy_ask[0 as usize]) as u64, key)
    } else if rc == actcli.R_NOBUS {
        stat_set(sp, (&k_sy_nobus[0 as usize]) as u64, 0)
    } else if ulib.find(lp, (&k_sy_usedlg[0 as usize]) as u64) != 0xFFFFFFFFFFFFFFFF {
        // SETBROKER2: "Yes, change it" in this window is refused for a critical value; only the system's
        // own dialog (painted by the window server) can answer
        stat_set(sp, (&k_sy_ask[0 as usize]) as u64, key)
    } else {
        stat_set(sp, (&k_sy_err[0 as usize]) as u64, lp)
    }
    var s1: [u8; 25] = "settings: bus answer rc=\0"
    var s2: [u8; 8] = " line=[\0"
    var s3: [u8; 2] = "]\0"
    say((&s1[0 as usize]) as u64)
    sayn(rc)
    say((&s2[0 as usize]) as u64)
    say(lp)
    say((&s3[0 as usize]) as u64)
    nl()
}

fn sys_set() {
    var key: [u8; 32] = [0 as u8; 32]
    let kp: u64 = (&key[0 as usize]) as u64
    if !sys_key(kp) {
        stat_set((&l_systat[0 as usize]) as u64, (&k_sy_pick[0 as usize]) as u64, 0)
        return
    }
    var v_set: [u8; 18] = "call settings.set\0"
    var k_key: [u8; 4] = "key\0"
    var k_val: [u8; 6] = "value\0"
    actcli.req((&v_set[0 as usize]) as u64)
    actcli.arg((&k_key[0 as usize]) as u64, kp)
    actcli.arg((&k_val[0 as usize]) as u64, (&e_sval[0 as usize]) as u64)
    sy_pend = 0
    let rc: u64 = actcli.send(300)
    sys_answer(rc, kp)
}

// ROUND ACTION-BUS-4 (AB-005c): THE OTHER PAGES GO THROUGH THE BUS TOO.
// One key, one value, the same `settings.set` the page System sends --
// so the change is checked by the broker, journalled by settingsd and can
// be undone, whoever made it. A critical key comes back as a question;
// its number waits in `sy_pend` for "Yes, change it" (sys_confirm). The
// answer goes into l_systat; the caller copies it to its own status line.
// R_NOBUS: an image without a broker -- the caller does what it did
// before this round (writes its file / calls the kernel itself).
fn bus_set(key: u64, val: u64) -> u64 {
    if !actcli.open() {
        var s0: [u8; 36] = "settings: no bus, page writes self\n\0"
        say((&s0[0 as usize]) as u64)
        return actcli.R_NOBUS
    }
    var v_set: [u8; 18] = "call settings.set\0"
    var k_key: [u8; 4] = "key\0"
    var k_val: [u8; 6] = "value\0"
    actcli.req((&v_set[0 as usize]) as u64)
    actcli.arg((&k_key[0 as usize]) as u64, key)
    actcli.arg((&k_val[0 as usize]) as u64, val)
    sy_pend = 0
    let rc: u64 = actcli.send(300)
    var s1: [u8; 24] = "settings: page set key=\0"
    say((&s1[0 as usize]) as u64)
    say(key)
    nl()
    sys_answer(rc, key)
    return rc
}

// the language of the page Sprache: locale.language on the bus, which
// settingsd writes into the session person's own file. If what this
// window then reads as ITS user's choice is not the new code (no session
// known to the kernel, e.g. a test guest), it writes its own file as
// before -- the choice must never get lost between the two.
fn lang_write(code: u64) -> bool {
    var k_lg: [u8; 16] = "locale.language\0"
    let rc: u64 = bus_set((&k_lg[0 as usize]) as u64, code)
    if rc == actcli.R_NOBUS {
        return msg.save_lang(code)
    }
    if rc != actcli.R_OK {
        return false
    }
    var jetzt: [u8; 16] = [0 as u8; 16]
    let src: u64 = msg.read_lang((&jetzt[0 as usize]) as u64)
    if src == 1 && ulib.streq((&jetzt[0 as usize]) as u64, code) {
        var s1: [u8; 33] = "settings: language via bus, own\n\0"
        say((&s1[0 as usize]) as u64)
        return true
    }
    var s2: [u8; 40] = "settings: language via bus + own file\n\0\0"
    say((&s2[0 as usize]) as u64)
    return msg.save_lang(code)
}

fn bus_set_num(key: u64, v: u64) -> u64 {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = ulib.digits(v, (&z[0 as usize]) as u64)
    z[(n) as usize] = 0 as u8
    return bus_set(key, (&z[0 as usize]) as u64)
}

// ROUND SETBROKER2 (r1279): the FIXED address of the page Netz over the bus. SYS_NETSET is root-only and this
// window is not root: settingsd (root) takes it as settings.net.fixed -- critical, so it comes back as a
// question that only the trusted dialog answers. R_NOBUS: an image without a broker (the caller tries itself).
fn net_fixed_bus(ip: u64, mask: u64, gw: u64) -> u64 {
    var v_fix: [u8; 24] = "call settings.net.fixed\0"
    var k_ip: [u8; 3] = "ip\0"
    var k_mask: [u8; 5] = "mask\0"
    var k_gw: [u8; 3] = "gw\0"
    var k_nf: [u8; 10] = "net.fixed\0"
    if !actcli.open() {
        return actcli.R_NOBUS
    }
    actcli.req((&v_fix[0 as usize]) as u64)
    actcli.arg((&k_ip[0 as usize]) as u64, ip)
    actcli.arg((&k_mask[0 as usize]) as u64, mask)
    if rb(gw, 0) != 0 {
        actcli.arg((&k_gw[0 as usize]) as u64, gw)
    }
    sy_pend = 0
    let rc: u64 = actcli.send(300)
    var s1: [u8; 32] = "settings: page net fixed asked\n\0"
    say((&s1[0 as usize]) as u64)
    sys_answer(rc, (&k_nf[0 as usize]) as u64)
    return rc
}

fn sys_confirm() {
    if sy_pend == 0 {
        stat_set((&l_systat[0 as usize]) as u64, (&k_sy_pick[0 as usize]) as u64, 0)
        return
    }
    var cf: [u8; 32] = [0 as u8; 32]
    let cp: u64 = (&cf[0 as usize]) as u64
    var s_c: [u8; 9] = "confirm \0"
    var o: u64 = bx_put(cp, 0, 32, (&s_c[0 as usize]) as u64)
    o = bx_num(cp, o, 32, sy_pend)
    actcli.req(cp)
    sy_pend = 0
    let rc: u64 = actcli.send(300)
    sys_answer(rc, (&sy_pkey[0 as usize]) as u64)
}

fn sys_undo() {
    var s_u: [u8; 5] = "undo\0"
    actcli.req((&s_u[0 as usize]) as u64)
    let rc: u64 = actcli.send(300)
    if rc == actcli.R_OK {
        stat_set((&l_systat[0 as usize]) as u64, (&k_sy_undone[0 as usize]) as u64, 0)
        var s1: [u8; 38] = "settings: bus answer rc=0 line=[undo]\0"
        say((&s1[0 as usize]) as u64)
        nl()
    } else {
        var s_k: [u8; 1] = "\0"
        sys_answer(rc, (&s_k[0 as usize]) as u64)
    }
}

// ------------------------------------------------------ App rights

// one "rule N allow C G L tail" line into the rules table
fn ri_rule(lp: u64, at0: u64) -> u64 {
    let bp: u64 = (&b_rules[0 as usize]) as u64
    var at: u64 = at0
    var w: [u8; 48] = [0 as u8; 48]
    let wp: u64 = (&w[0 as usize]) as u64
    var i: u64 = 5 // after "rule "
    var col: u64 = 0
    var num: u64 = 0
    var deny: bool = false
    while col < 6 {
        var n: u64 = 0
        while rb(lp, i) != 0 && rb(lp, i) != 32 && n < 46 {
            __mmio_write8((wp + n) as *mut u8, rb(lp, i) as u8)
            n = n + 1
            i = i + 1
        }
        __mmio_write8((wp + n) as *mut u8, 0 as u8)
        if rb(lp, i) == 32 {
            i = i + 1
        }
        if col == 0 {
            num = ulib.to_num(wp)
            at = bx_put(bp, at, 2048, wp)
        } else if col == 1 {
            deny = rb(wp, 0) == 100
            at = bx_put(bp, at, 2048, wp)
        } else if col == 4 && deny {
            // a deny rule has no level: this word is already the end
            at = bx_ch(bp, at, 2048, 45)
            at = bx_ch(bp, at, 2048, 9)
            col = 5
        }
        if col == 2 || col == 3 || (col == 4 && !deny) {
            at = bx_put(bp, at, 2048, wp)
        }
        if col == 5 {
            // permanent | session | left=S
            if rb(wp, 0) == 112 {
                at = bx_put(bp, at, 2048, msg.get((&k_ri_perm[0 as usize]) as u64))
            } else if rb(wp, 0) == 108 {
                at = bx_put(bp, at, 2048, wp + 5)
                at = bx_put(bp, at, 2048, msg.get((&k_ri_left[0 as usize]) as u64))
            } else {
                at = bx_put(bp, at, 2048, msg.get((&k_ri_sess[0 as usize]) as u64))
            }
        } else {
            at = bx_ch(bp, at, 2048, 9)
        }
        col = col + 1
    }
    at = bx_ch(bp, at, 2048, 10)
    if ri_rows < 32 {
        ri_nums[(ri_rows) as usize] = num
        ri_rows = ri_rows + 1
    }
    return at
}

// "client C reads=a changes=b asked=c refused=d dry=e"
fn ri_client(lp: u64, at0: u64) -> u64 {
    let bp: u64 = (&b_cls[0 as usize]) as u64
    var at: u64 = at0
    var i: u64 = 7
    var n: u64 = 0
    let np: u64 = (&cl_names[0 as usize]) as u64 + cl_rows * 24
    while rb(lp, i) != 0 && rb(lp, i) != 32 {
        if n < 23 && cl_rows < 32 {
            __mmio_write8((np + n) as *mut u8, rb(lp, i) as u8)
            __mmio_write8((np + n + 1) as *mut u8, 0 as u8)
        }
        n = n + 1
        i = i + 1
    }
    at = bx_putn(bp, at, 2048, lp + 7, n)
    // the five numbers: every '=' starts one
    while rb(lp, i) != 0 {
        if rb(lp, i) == 61 {
            at = bx_ch(bp, at, 2048, 9)
            i = i + 1
            while rb(lp, i) >= 48 && rb(lp, i) <= 57 {
                at = bx_ch(bp, at, 2048, rb(lp, i))
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    at = bx_ch(bp, at, 2048, 10)
    if cl_rows < 32 {
        cl_rows = cl_rows + 1
    }
    return at
}

// ------------------------------------------------ Protokoll (S-009)
//
// `audit 40` over the bus -- the user only; the broker answers with two
// header lines (rotations=, auditmax=) and the log lines, oldest first.
// Shown NEWEST first, one row per line: time since boot, who, verb,
// target, decision, result (+ "(Probe)" for a dry run, "xN" for a line
// that counts several reads).
fn pr_field(lp: u64, key: u64, out: u64, max: u64) -> bool {
    let at: u64 = ulib.find(lp, key)
    if at == 0xFFFFFFFFFFFFFFFF {
        __mmio_write8(out as *mut u8, 0 as u8)
        return false
    }
    let kl: u64 = ulib.length(key)
    var i: u64 = 0
    while rb(lp, at + kl + i) != 0 && rb(lp, at + kl + i) != 32 && i + 1 < max {
        __mmio_write8((out + i) as *mut u8, rb(lp, at + kl + i) as u8)
        i = i + 1
    }
    __mmio_write8((out + i) as *mut u8, 0 as u8)
    return true
}

// a decision or result word in the user's language: "settings.log.w.<word>"
// from the catalogue; a word it does not know stays as the broker wrote it
fn pr_word(bp: u64, at: u64, wp: u64) -> u64 {
    var ck: [u8; 64] = [0 as u8; 64]
    let cp: u64 = (&ck[0 as usize]) as u64
    var s_pre: [u8; 16] = "settings.log.w.\0"
    let o: u64 = bx_put(cp, 0, 64, (&s_pre[0 as usize]) as u64)
    let _o2: u64 = bx_put(cp, o, 64, wp)
    let tr: u64 = msg.get(cp)
    if tr != cp {
        return bx_put(bp, at, 6144, tr)
    }
    return bx_put(bp, at, 6144, wp)
}

fn proto_row(lp: u64, at0: u64) -> u64 {
    let bp: u64 = (&b_proto[0 as usize]) as u64
    var at: u64 = at0
    var w: [u8; 48] = [0 as u8; 48]
    let wp: u64 = (&w[0 as usize]) as u64
    var f_t: [u8; 3] = "t=\0"
    var f_c: [u8; 8] = "client=\0"
    var f_v: [u8; 6] = "verb=\0"
    var f_a: [u8; 8] = "action=\0"
    var f_d: [u8; 10] = "decision=\0"
    var f_r: [u8; 8] = "result=\0"
    var f_n: [u8; 7] = "count=\0"
    var s_s: [u8; 3] = " s\0"
    var s_x: [u8; 3] = " x\0"
    // the time: ticks (10 ms) since boot, shown in seconds
    if pr_field(lp, (&f_t[0 as usize]) as u64, wp, 24) {
        at = bx_num(bp, at, 6144, ulib.to_num(wp) / 100)
        at = bx_put(bp, at, 6144, (&s_s[0 as usize]) as u64)
    }
    at = bx_ch(bp, at, 6144, 9)
    let _c: bool = pr_field(lp, (&f_c[0 as usize]) as u64, wp, 48)
    at = bx_put(bp, at, 6144, wp)
    at = bx_ch(bp, at, 6144, 9)
    let _v: bool = pr_field(lp, (&f_v[0 as usize]) as u64, wp, 48)
    at = bx_put(bp, at, 6144, wp)
    at = bx_ch(bp, at, 6144, 9)
    let _a: bool = pr_field(lp, (&f_a[0 as usize]) as u64, wp, 48)
    at = bx_put(bp, at, 6144, wp)
    at = bx_ch(bp, at, 6144, 9)
    let _d: bool = pr_field(lp, (&f_d[0 as usize]) as u64, wp, 48)
    at = pr_word(bp, at, wp)
    at = bx_ch(bp, at, 6144, 9)
    let _r: bool = pr_field(lp, (&f_r[0 as usize]) as u64, wp, 48)
    at = pr_word(bp, at, wp)
    if pr_field(lp, (&f_n[0 as usize]) as u64, wp, 24) {
        at = bx_put(bp, at, 6144, (&s_x[0 as usize]) as u64)
        at = bx_put(bp, at, 6144, wp)
    }
    return bx_ch(bp, at, 6144, 10)
}

fn proto_load() {
    let bp: u64 = (&b_proto[0 as usize]) as u64
    let sp: u64 = (&l_prostat[0 as usize]) as u64
    var at: u64 = bx_put(bp, 0, 6144, msg.get((&k_pr_head[0 as usize]) as u64))
    at = bx_ch(bp, at, 6144, 10)
    var s_a: [u8; 9] = "audit 40\0"
    actcli.req((&s_a[0 as usize]) as u64)
    let rc: u64 = actcli.send(300)
    var rows: u64 = 0
    var rot: u64 = 0
    if rc != actcli.R_OK {
        at = bx_put(bp, at, 6144, msg.get((&k_sy_nobus[0 as usize]) as u64))
        at = bx_ch(bp, at, 6144, 10)
    } else {
        var ln: [u8; 320] = [0 as u8; 320]
        let lp: u64 = (&ln[0 as usize]) as u64
        // how many reply lines there are
        var n: u64 = 1
        while actcli.line(n, lp, 320) {
            n = n + 1
        }
        // newest first: from the last line back to the first
        var k: u64 = n
        while k > 1 {
            k = k - 1
            if actcli.line(k, lp, 320) {
                if rb(lp, 0) == 116 && rb(lp, 1) == 61 { // "t="
                    at = proto_row(lp, at)
                    rows = rows + 1
                } else if rb(lp, 0) == 114 && rb(lp, 1) == 111 { // rotations=
                    rot = ulib.to_num(lp + 10)
                }
            }
        }
        if rows == 0 {
            at = bx_put(bp, at, 6144, msg.get((&k_pr_none[0 as usize]) as u64))
            at = bx_ch(bp, at, 6144, 10)
        }
    }
    var a2: u64 = bx_num(sp, 0, 120, rows)
    a2 = bx_ch(sp, a2, 120, 32)
    a2 = bx_put(sp, a2, 120, msg.get((&k_pr_rot[0 as usize]) as u64))
    a2 = bx_num(sp, a2, 120, rot)
    var s1: [u8; 25] = "settings: protocol rows=\0"
    var s2: [u8; 5] = " rc=\0"
    say((&s1[0 as usize]) as u64)
    sayn(rows)
    say((&s2[0 as usize]) as u64)
    sayn(rc)
    nl()
}

// ------------------------------------------------- Updates (DAILY-DRIVER)
//
// `settings.update.status` over the bus: here=, there=, time=, phase=,
// channel=, auto=, busy= -- from /system/ota.stand and /etc/ota.conf,
// read by settingsd (root). The buttons call settings.update.check /
// install / rollback (settingsd runs `ota` in a child and answers at
// once); install and rollback are critical, so the answer is a question
// and "Bestaetigen" (sys_confirm) sends the yes, like on the page System.
// Channel and automatic updates are `update.channel` / `update.auto`
// through the same settings.set (also critical). Nothing here updates by
// itself.
fn upd_val(lp: u64, key: u64, out: u64, max: u64) -> bool {
    let kl: u64 = ulib.length(key)
    var i: u64 = 0
    while i < kl {
        if rb(lp, i) != rb(key, i) {
            return false
        }
        i = i + 1
    }
    var o: u64 = 0
    while rb(lp, kl + o) != 0 && o + 1 < max {
        __mmio_write8((out + o) as *mut u8, rb(lp, kl + o) as u8)
        o = o + 1
    }
    __mmio_write8((out + o) as *mut u8, 0 as u8)
    return true
}

fn upd_load() {
    var k_here: [u8; 6] = "here=\0"
    var k_there: [u8; 7] = "there=\0"
    var k_time: [u8; 6] = "time=\0"
    var k_phase: [u8; 7] = "phase=\0"
    var k_chan: [u8; 9] = "channel=\0"
    var k_auto: [u8; 6] = "auto=\0"
    var k_busy: [u8; 6] = "busy=\0"
    var here: [u8; 24] = [0 as u8; 24]
    var there: [u8; 24] = [0 as u8; 24]
    var tm: [u8; 40] = [0 as u8; 40]
    var ph: [u8; 24] = [0 as u8; 24]
    var bz: [u8; 8] = [0 as u8; 8]
    var ln: [u8; 120] = [0 as u8; 120]
    let lp: u64 = (&ln[0 as usize]) as u64
    var s_st: [u8; 28] = "call settings.update.status\0"
    var s_sp: [u8; 4] = " | \0"
    ph[(0) as usize] = 0 as u8
    here[(0) as usize] = 48 as u8
    here[(1) as usize] = 0 as u8
    there[(0) as usize] = 48 as u8
    there[(1) as usize] = 0 as u8
    tm[(0) as usize] = 0 as u8
    up_busy = 0
    __mmio_write8((&up_chan[0 as usize]) as u64 as *mut u8, 0 as u8)
    __mmio_write8((&up_auto[0 as usize]) as u64 as *mut u8, 0 as u8)
    var got: bool = false
    if actcli.open() {
        actcli.req((&s_st[0 as usize]) as u64)
        if actcli.send(300) == actcli.R_OK {
            got = true
            var n: u64 = 1
            while actcli.line(n, lp, 120) {
                let _a: bool = upd_val(lp, (&k_here[0 as usize]) as u64, (&here[0 as usize]) as u64, 24)
                let _b: bool = upd_val(lp, (&k_there[0 as usize]) as u64, (&there[0 as usize]) as u64, 24)
                let _c: bool = upd_val(lp, (&k_time[0 as usize]) as u64, (&tm[0 as usize]) as u64, 40)
                let _d: bool = upd_val(lp, (&k_phase[0 as usize]) as u64, (&ph[0 as usize]) as u64, 24)
                let _e: bool = upd_val(lp, (&k_chan[0 as usize]) as u64, (&up_chan[0 as usize]) as u64, 16)
                let _f: bool = upd_val(lp, (&k_auto[0 as usize]) as u64, (&up_auto[0 as usize]) as u64, 16)
                var bb: [u8; 8] = [0 as u8; 8]
                if upd_val(lp, (&k_busy[0 as usize]) as u64, (&bb[0 as usize]) as u64, 8) {
                    up_busy = ulib.to_num((&bb[0 as usize]) as u64)
                }
                n = n + 1
            }
        }
    }
    let p1: u64 = (&l_upver[0 as usize]) as u64
    let p2: u64 = (&l_uplast[0 as usize]) as u64
    let p3: u64 = (&l_upphase[0 as usize]) as u64
    if !got {
        var o0: u64 = bx_put(p1, 0, 200, msg.get((&k_sy_nobus[0 as usize]) as u64))
        __mmio_write8((p2) as *mut u8, 0 as u8)
        __mmio_write8((p3) as *mut u8, 0 as u8)
        return
    }
    // line 1: version | channel | automatic
    var o: u64 = bx_put(p1, 0, 200, msg.get((&k_up_ver[0 as usize]) as u64))
    o = bx_put(p1, o, 200, (&here[0 as usize]) as u64)
    o = bx_put(p1, o, 200, (&s_sp[0 as usize]) as u64)
    o = bx_put(p1, o, 200, msg.get((&k_up_chan[0 as usize]) as u64))
    o = bx_put(p1, o, 200, (&up_chan[0 as usize]) as u64)
    o = bx_put(p1, o, 200, (&s_sp[0 as usize]) as u64)
    o = bx_put(p1, o, 200, msg.get((&k_up_auto[0 as usize]) as u64))
    var on: bool = ulib.streq((&up_auto[0 as usize]) as u64, (&s_true[0 as usize]) as u64)
        || ulib.streq((&up_auto[0 as usize]) as u64, (&s_ja[0 as usize]) as u64)
    if on {
        o = bx_put(p1, o, 200, msg.get((&k_up_on[0 as usize]) as u64))
    } else {
        o = bx_put(p1, o, 200, msg.get((&k_up_off[0 as usize]) as u64))
    }
    // line 2: last check | version on the server
    o = bx_put(p2, 0, 200, msg.get((&k_up_last[0 as usize]) as u64))
    if tm[0 as usize] == 0 as u8 {
        o = bx_put(p2, o, 200, msg.get((&k_up_never[0 as usize]) as u64))
    } else {
        o = bx_put(p2, o, 200, (&tm[0 as usize]) as u64)
    }
    if ulib.to_num((&there[0 as usize]) as u64) != 0 {
        o = bx_put(p2, o, 200, (&s_sp[0 as usize]) as u64)
        o = bx_put(p2, o, 200, msg.get((&k_up_srv[0 as usize]) as u64))
        o = bx_put(p2, o, 200, (&there[0 as usize]) as u64)
    }
    // line 3: what the device is doing
    var key: [u8; 48] = [0 as u8; 48]
    let kp: u64 = (&key[0 as usize]) as u64
    var kq: u64 = bx_put(kp, 0, 48, (&k_up_ph[0 as usize]) as u64)
    kq = bx_put(kp, kq, 48, (&ph[0 as usize]) as u64)
    o = bx_put(p3, 0, 200, msg.get(kp))
    if up_busy != 0 {
        o = bx_put(p3, o, 200, (&s_sp[0 as usize]) as u64)
        o = bx_put(p3, o, 200, msg.get((&k_up_busy[0 as usize]) as u64))
    }
    var s1: [u8; 28] = "settings: update page here=\0"
    say((&s1[0 as usize]) as u64)
    say((&here[0 as usize]) as u64)
    var s2: [u8; 8] = " phase=\0"
    say((&s2[0 as usize]) as u64)
    say((&ph[0 as usize]) as u64)
    var s3: [u8; 10] = " channel=\0"
    say((&s3[0 as usize]) as u64)
    say((&up_chan[0 as usize]) as u64)
    var s4: [u8; 7] = " busy=\0"
    say((&s4[0 as usize]) as u64)
    sayn(up_busy)
    nl()
}


// SYSTEM block of the page Updates: `settings.update.sysstatus` -> ver=, here=, there=, commit=,
// phase=, channel=, busy=, note= (changelog lines of the offered build)
fn sysupd_load() {
    var k_ver: [u8; 5] = "ver=\0"
    var k_here: [u8; 6] = "here=\0"
    var k_there: [u8; 7] = "there=\0"
    var k_commit: [u8; 8] = "commit=\0"
    var k_phase: [u8; 7] = "phase=\0"
    var k_chan: [u8; 9] = "channel=\0"
    var k_note: [u8; 6] = "note=\0"
    var s_sst: [u8; 31] = "call settings.update.sysstatus\0"
    var ver: [u8; 100] = [0 as u8; 100]
    var here: [u8; 24] = [0 as u8; 24]
    var there: [u8; 24] = [0 as u8; 24]
    var commit: [u8; 24] = [0 as u8; 24]
    var ph: [u8; 24] = [0 as u8; 24]
    var chan: [u8; 24] = [0 as u8; 24]
    var s_sp: [u8; 4] = " | \0"
    var ln: [u8; 120] = [0 as u8; 120]
    let lp: u64 = (&ln[0 as usize]) as u64
    var note: [u8; 100] = [0 as u8; 100]
    let nbuf: u64 = (&b_sunotes[0 as usize]) as u64
    __mmio_write8(nbuf as *mut u8, 0 as u8)
    var nat: u64 = 0
    var got: bool = false
    if actcli.open() {
        actcli.req((&s_sst[0 as usize]) as u64)
        if actcli.send(300) == actcli.R_OK {
            got = true
            var n: u64 = 1
            while actcli.line(n, lp, 120) {
                let _a: bool = upd_val(lp, (&k_ver[0 as usize]) as u64, (&ver[0 as usize]) as u64, 100)
                let _b: bool = upd_val(lp, (&k_here[0 as usize]) as u64, (&here[0 as usize]) as u64, 24)
                let _c: bool = upd_val(lp, (&k_there[0 as usize]) as u64, (&there[0 as usize]) as u64, 24)
                let _d: bool = upd_val(lp, (&k_commit[0 as usize]) as u64, (&commit[0 as usize]) as u64, 24)
                let _e: bool = upd_val(lp, (&k_phase[0 as usize]) as u64, (&ph[0 as usize]) as u64, 24)
                let _f: bool = upd_val(lp, (&k_chan[0 as usize]) as u64, (&chan[0 as usize]) as u64, 24)
                if upd_val(lp, (&k_note[0 as usize]) as u64, (&note[0 as usize]) as u64, 100) {
                    nat = bx_put(nbuf, nat, 1000, (&note[0 as usize]) as u64)
                    nat = bx_put(nbuf, nat, 1000, (&s_sp[0 as usize]) as u64)
                }
                n = n + 1
            }
        }
    }
    let p1: u64 = (&l_suver[0 as usize]) as u64
    let p2: u64 = (&l_suphase[0 as usize]) as u64
    if !got {
        var o0: u64 = bx_put(p1, 0, 200, msg.get((&k_sy_nobus[0 as usize]) as u64))
        __mmio_write8((p2) as *mut u8, 0 as u8)
        return
    }
    if nat >= 3 {
        nat = nat - 3
        __mmio_write8((nbuf + nat) as *mut u8, 0 as u8)
    }
    if nat == 0 {
        nat = bx_put(nbuf, 0, 1000, msg.get((&k_su_none[0 as usize]) as u64))
    }
    // line 1: what runs | build | channel
    var o: u64 = bx_put(p1, 0, 200, msg.get((&k_su_ver[0 as usize]) as u64))
    if ver[0 as usize] == 0 as u8 {
        o = bx_put(p1, o, 200, msg.get((&k_su_build[0 as usize]) as u64))
        o = bx_put(p1, o, 200, (&here[0 as usize]) as u64)
    } else {
        o = bx_put(p1, o, 200, (&ver[0 as usize]) as u64)
    }
    o = bx_put(p1, o, 200, (&s_sp[0 as usize]) as u64)
    o = bx_put(p1, o, 200, msg.get((&k_su_chan[0 as usize]) as u64))
    o = bx_put(p1, o, 200, (&chan[0 as usize]) as u64)
    // line 2: phase (+ the offered build)
    var key: [u8; 48] = [0 as u8; 48]
    let kp: u64 = (&key[0 as usize]) as u64
    var kq: u64 = bx_put(kp, 0, 48, (&k_su_ph[0 as usize]) as u64)
    kq = bx_put(kp, kq, 48, (&ph[0 as usize]) as u64)
    o = bx_put(p2, 0, 200, msg.get(kp))
    if ph[0 as usize] == 97 as u8 && ph[1 as usize] == 118 as u8 {
        // "available": name the offered build
        o = bx_put(p2, o, 200, (&s_sp[0 as usize]) as u64)
        o = bx_put(p2, o, 200, msg.get((&k_su_build[0 as usize]) as u64))
        o = bx_put(p2, o, 200, (&there[0 as usize]) as u64)
        o = bx_put(p2, o, 200, (&s_sp[0 as usize]) as u64)
        o = bx_put(p2, o, 200, (&commit[0 as usize]) as u64)
    }
    var s1: [u8; 30] = "settings: system update here=\0"
    say((&s1[0 as usize]) as u64)
    say((&here[0 as usize]) as u64)
    var s2: [u8; 8] = " phase=\0"
    say((&s2[0 as usize]) as u64)
    say((&ph[0 as usize]) as u64)
    var s3: [u8; 8] = " there=\0"
    say((&s3[0 as usize]) as u64)
    say((&there[0 as usize]) as u64)
    var s4: [u8; 8] = " notes=\0"
    say((&s4[0 as usize]) as u64)
    sayn(ulib.length(nbuf))
    nl()
}

// the three actions; critical ones come back as a question (sys_answer
// keeps its number in sy_pend)
fn upd_call(verb: u64, shown: u64) {
    sy_pend = 0
    if !actcli.open() {
        stat_set((&l_systat[0 as usize]) as u64, (&k_sy_nobus[0 as usize]) as u64, 0)
        return
    }
    actcli.req(verb)
    let rc: u64 = actcli.send(300)
    sys_answer(rc, shown)
}

// channel and automatic updates: the other value of the same setting
fn upd_toggle(which: u64) {
    var k_ch: [u8; 15] = "update.channel\0"
    var k_au: [u8; 12] = "update.auto\0"
    var v_stable: [u8; 7] = "stable\0"
    var v_test: [u8; 5] = "test\0"
    var v_true: [u8; 5] = "true\0"
    var v_false: [u8; 6] = "false\0"
    if which == 0 {
        if ulib.streq((&up_chan[0 as usize]) as u64, (&v_test[0 as usize]) as u64) {
            let _r: u64 = bus_set((&k_ch[0 as usize]) as u64, (&v_stable[0 as usize]) as u64)
        } else {
            let _r2: u64 = bus_set((&k_ch[0 as usize]) as u64, (&v_test[0 as usize]) as u64)
        }
    } else {
        if ulib.streq((&up_auto[0 as usize]) as u64, (&v_true[0 as usize]) as u64)
            || ulib.streq((&up_auto[0 as usize]) as u64, (&s_ja[0 as usize]) as u64) {
            let _r3: u64 = bus_set((&k_au[0 as usize]) as u64, (&v_false[0 as usize]) as u64)
        } else {
            let _r4: u64 = bus_set((&k_au[0 as usize]) as u64, (&v_true[0 as usize]) as u64)
        }
    }
}

fn upd_show() {
    upd_load()
    sysupd_load()
    fuiscene.refresh()
}

fn rights_load() {
    let bp: u64 = (&b_rules[0 as usize]) as u64
    let cp: u64 = (&b_cls[0 as usize]) as u64
    let np: u64 = (&l_rinote[0 as usize]) as u64
    var at: u64 = bx_put(bp, 0, 2048, msg.get((&k_ri_head[0 as usize]) as u64))
    at = bx_ch(bp, at, 2048, 10)
    var ac: u64 = bx_put(cp, 0, 2048, msg.get((&k_ri_chead[0 as usize]) as u64))
    ac = bx_ch(cp, ac, 2048, 10)
    var an: u64 = bx_put(np, 0, 200, msg.get((&k_ri_note[0 as usize]) as u64))
    ri_rows = 0
    cl_rows = 0
    var ndf: u64 = 0
    var s_r: [u8; 7] = "rights\0"
    actcli.req((&s_r[0 as usize]) as u64)
    let rc: u64 = actcli.send(300)
    if rc != actcli.R_OK {
        at = bx_put(bp, at, 2048, msg.get((&k_sy_nobus[0 as usize]) as u64))
        at = bx_ch(bp, at, 2048, 10)
    } else {
        var ln: [u8; 200] = [0 as u8; 200]
        let lp: u64 = (&ln[0 as usize]) as u64
        var k: u64 = 1
        while actcli.line(k, lp, 200) {
            if rb(lp, 0) == 114 && rb(lp, 1) == 117 { // rule
                at = ri_rule(lp, at)
            } else if rb(lp, 0) == 99 && rb(lp, 1) == 108 { // client
                ac = ri_client(lp, ac)
            } else if rb(lp, 0) == 100 && rb(lp, 1) == 114 { // dryfirst
                if ndf == 0 {
                    an = bx_ch(np, an, 200, 32)
                    an = bx_put(np, an, 200, msg.get((&k_ri_dfirst[0 as usize]) as u64))
                } else {
                    an = bx_ch(np, an, 200, 44)
                }
                an = bx_ch(np, an, 200, 32)
                an = bx_put(np, an, 200, lp + 9)
                ndf = ndf + 1
            }
            k = k + 1
        }
        if ri_rows == 0 {
            at = bx_put(bp, at, 2048, msg.get((&k_ri_none[0 as usize]) as u64))
            at = bx_ch(bp, at, 2048, 10)
        }
    }
    var s1: [u8; 24] = "settings: rights rules=\0"
    var s2: [u8; 10] = " clients=\0"
    var s3: [u8; 11] = " dryfirst=\0"
    var s4: [u8; 5] = " rc=\0"
    say((&s1[0 as usize]) as u64)
    sayn(ri_rows)
    say((&s2[0 as usize]) as u64)
    sayn(cl_rows)
    say((&s3[0 as usize]) as u64)
    sayn(ndf)
    say((&s4[0 as usize]) as u64)
    sayn(rc)
    nl()
}

fn ri_answer(rc: u64) {
    let sp: u64 = (&l_ristat[0 as usize]) as u64
    var ln: [u8; 160] = [0 as u8; 160]
    let lp: u64 = (&ln[0 as usize]) as u64
    let _l: bool = actcli.line(0, lp, 160)
    if rc == actcli.R_OK {
        var l2: [u8; 160] = [0 as u8; 160]
        let _l2: bool = actcli.line(1, (&l2[0 as usize]) as u64, 160)
        stat_set(sp, (&k_ri_done[0 as usize]) as u64, (&l2[0 as usize]) as u64)
    } else if rc == actcli.R_NOBUS {
        stat_set(sp, (&k_sy_nobus[0 as usize]) as u64, 0)
    } else {
        stat_set(sp, (&k_sy_err[0 as usize]) as u64, lp)
    }
    var s1: [u8; 28] = "settings: rights answer rc=\0"
    var s2: [u8; 8] = " line=[\0"
    var s3: [u8; 2] = "]\0"
    say((&s1[0 as usize]) as u64)
    sayn(rc)
    say((&s2[0 as usize]) as u64)
    say(lp)
    say((&s3[0 as usize]) as u64)
    nl()
}

fn ri_revoke() {
    let r: u64 = fuiscene.table_sel(ri_tab)
    if r >= ri_rows {
        stat_set((&l_ristat[0 as usize]) as u64, (&k_sy_pick[0 as usize]) as u64, 0)
        return
    }
    var cmd: [u8; 32] = [0 as u8; 32]
    let cp: u64 = (&cmd[0 as usize]) as u64
    var s_r: [u8; 8] = "revoke \0"
    var o: u64 = bx_put(cp, 0, 32, (&s_r[0 as usize]) as u64)
    o = bx_num(cp, o, 32, ri_nums[(r) as usize])
    actcli.req(cp)
    ri_answer(actcli.send(300))
}

fn ri_block() {
    let r: u64 = fuiscene.table_sel(ri_ctab)
    if r >= cl_rows {
        stat_set((&l_ristat[0 as usize]) as u64, (&k_sy_pick[0 as usize]) as u64, 0)
        return
    }
    var cmd: [u8; 48] = [0 as u8; 48]
    let cp: u64 = (&cmd[0 as usize]) as u64
    var s_b: [u8; 7] = "block \0"
    var s_st: [u8; 3] = " *\0"
    var o: u64 = bx_put(cp, 0, 48, (&s_b[0 as usize]) as u64)
    o = bx_put(cp, o, 48, (&cl_names[0 as usize]) as u64 + r * 24)
    o = bx_put(cp, o, 48, (&s_st[0 as usize]) as u64)
    actcli.req(cp)
    ri_answer(actcli.send(300))
}

// the grant a person most often wants to give: Jarvis may change the
// display settings for one hour (never the critical ones -- the broker
// refuses critical grants whatever this button says)
fn ri_jarvis() {
    var s_g: [u8; 43] = "grant jarvis settings.display.* write 3600\0"
    actcli.req((&s_g[0 as usize]) as u64)
    ri_answer(actcli.send(300))
}

// N-004: THE ZONE PICKER (region choice K_CZ + city choice K_CZC, 79 zones of lib/tz).
// The region choice is the old zone choice (key 64) with new items; the city list is
// built from lib/tz/zonedata.fi for the region picked. What the kernel has is shown:
// `/etc/time.conf` carries `zone=<city>`; it is used when the kernel's standard offset
// and rule agree with that city, otherwise the first city with that offset and rule.
const K_CZC: u64 = 99 // the city choice (free key below 110: ch_buf slots are key % 110)
static mut zc_items: [u8; 480] = [0 as u8; 480]
static mut zc_letters: [u8; 9] = "UEGALSFP\0" // the region letters in the order of the first choice
static mut zc_conf: [u8; 15] = "/etc/time.conf\0"
static mut zc_zbuf: [u8; 200] = [0 as u8; 200]

fn zc_letter(r: u64) -> u64 {
    if r >= 8 {
        return 85
    }
    return (zc_letters[(r) as usize]) as u64
}

fn zc_region_index(letter: u64) -> u64 {
    var r: u64 = 0
    while r < 8 {
        if zc_letter(r) == letter {
            return r
        }
        r = r + 1
    }
    return 0
}

// the cities of region `r`, '\n' between them (what chtext wants)
fn zc_list(r: u64) -> u64 {
    let reg: u64 = zc_letter(r)
    let n: u64 = tz.zone_count()
    var nm: [u8; 32] = [0 as u8; 32]
    var at: u64 = 0
    var i: u64 = 0
    while i < n && at < 440 {
        if tz.zone_region(i) == reg {
            let l: u64 = tz.zone_name(i, (&nm[0 as usize]) as u64)
            if at > 0 {
                zc_items[(at) as usize] = 10 as u8
                at = at + 1
            }
            var k: u64 = 0
            while k < l {
                zc_items[(at) as usize] = nm[(k) as usize]
                at = at + 1
                k = k + 1
            }
        }
        i = i + 1
    }
    zc_items[(at) as usize] = 0 as u8
    return (&zc_items[0 as usize]) as u64
}

// the zone the two choices stand on (a global index in lib/tz, or NONE_ZONE)
fn zc_zone() -> u64 {
    return tz.zone_in_region(zc_letter(kval[(K_CZ) as usize]), kval[(K_CZC) as usize])
}

// start state: the kernel's zone, the saved city name if it fits
fn zone_init() {
    kval[(K_CZ) as usize] = 0
    kval[(K_CZC) as usize] = 0
    let base: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TZBASE, 0, 0)
    let rule: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TZRULE, 0, 0)
    if ulib.bad(base) || ulib.bad(rule) {
        return
    }
    let bw: u64 = tz.to_wrapped(base, tz.west_bit(rule))
    let rl: u64 = tz.rule_of_arg(rule)
    var z: u64 = tz.NONE_ZONE
    let n: u64 = file_read((&zc_conf[0 as usize]) as u64, (&zc_zbuf[0 as usize]) as u64, 200)
    var i: u64 = 0
    while i + 5 < n {
        // "zone=" at the start of a line
        if zc_zbuf[(i) as usize] == 122 as u8 && zc_zbuf[((i + 1)) as usize] == 111 as u8
            && zc_zbuf[((i + 2)) as usize] == 110 as u8 && zc_zbuf[((i + 3)) as usize] == 101 as u8
            && zc_zbuf[((i + 4)) as usize] == 61 as u8 && (i == 0 || zc_zbuf[((i - 1)) as usize] == 10 as u8) {
            var nm: [u8; 32] = [0 as u8; 32]
            var k: u64 = 0
            while k < 31 && i + 5 + k < n && zc_zbuf[((i + 5 + k)) as usize] != 10 as u8 {
                nm[(k) as usize] = zc_zbuf[((i + 5 + k)) as usize]
                k = k + 1
            }
            z = tz.zone_by_name((&nm[0 as usize]) as u64)
            break
        }
        i = i + 1
    }
    if z == tz.NONE_ZONE || tz.zone_base(z) != bw || tz.zone_rule(z) != rl {
        z = tz.zone_find(bw, rl)
    }
    if z == tz.NONE_ZONE {
        return
    }
    let r: u64 = zc_region_index(tz.zone_region(z))
    kval[(K_CZ) as usize] = r
    var c: u64 = 0
    while tz.zone_in_region(zc_letter(r), c) != z && c < 40 {
        c = c + 1
    }
    kval[(K_CZC) as usize] = c
}

// ====================================================================
// FUI-ALL F-7: THE SETTINGS WINDOW ON fUi's SCENE TREE.
//
// The window is DESCRIBED (`build`): the tabs, then the page the user is on,
// in one or two cards, then the status line. Every control carries a KEY
// (the constants below); `fuiscene.pump` answers with the key of the control
// that was used, and the loop acts on it. The state that lives in the
// toolkit (choice values, slider positions, check boxes, selections, the
// text of the fields) is kept by key in fuiscene or in `kval`; the text of
// the fields is copied to and from the program's own buffers around every
// event (`pull_entries` / `push_entries`), so the logic of the pages still
// reads and writes its `e_*` buffers.
// ====================================================================
const K_TAB0: u64 = 500 // the sidebar tabs 500 .. 539 (40 keys; keys are scene ids, not array indexes; 150..169 was full at 20 pages)
const K_TILE0: u64 = 170 // the ten theme tiles 170 .. 179
const K_COUNT: u64 = 200
const K_LS: u64 = 1
const K_CM: u64 = 2
const K_CSH: u64 = 3
const K_ZS1: u64 = 4
const K_ZS2: u64 = 5
const K_ZS3: u64 = 6
const K_EA: u64 = 7
const K_B1: u64 = 8
const K_EB: u64 = 9
const K_BS1: u64 = 10
const K_BS2: u64 = 11
const K_CE: u64 = 12
const K_ET: u64 = 13
const K_KA: u64 = 14
const K_KO: u64 = 15
const K_KSH: u64 = 97 // r402: window shadows (check box)
const K_MS_SPD: u64 = 100 // L-001: pointer speed slider
const K_MS_ACC: u64 = 101 // L-001: acceleration slider
const K_MS_NAT: u64 = 102 // L-001: natural scrolling toggle
const K_MS_GES: u64 = 115 // r804: touchpad gestures toggle
const K_MS_FPS: u64 = 122 // FPS-OV: frame-rate overlay toggle (schema key debug.fps, /etc/mouse.conf fps=)
const K_PW_LB: u64 = 103 // R783: lid action on battery (choice)
const K_PW_LA: u64 = 104 // lid action on mains (choice)
const K_PW_PB: u64 = 105 // power profile on battery (choice)
const K_PW_PA: u64 = 106 // power profile on mains (choice)
const K_PW_SB: u64 = 107 // screen-off minutes on battery (slider)
const K_PW_SA: u64 = 108 // screen-off minutes on mains
const K_PW_YB: u64 = 109 // standby minutes on battery
const K_PW_YA: u64 = 114 // standby minutes on mains
const K_IN_BEXP: u64 = 116 // MINT4: Info page, export button
const K_CAL: u64 = 16
const K_SL_RAD: u64 = 17
const K_SL_TBA: u64 = 18
const K_SL_WA: u64 = 19
const K_SL_BLUR: u64 = 20
const K_BV1: u64 = 21
const K_EVN: u64 = 22
const K_BV2: u64 = 23
const K_EVF: u64 = 24
const K_BV3: u64 = 25
const K_BV4: u64 = 26
const K_BV5: u64 = 27
const K_BV6: u64 = 28
const K_YB: u64 = 29
const K_BR_AUS_ID: u64 = 30
const K_SY_TAB: u64 = 31
const K_SY_ENT: u64 = 32
const K_SY_BSET: u64 = 33
const K_SY_BCONF: u64 = 34
const K_SY_BUNDO: u64 = 35
const K_RI_TAB: u64 = 36
const K_RI_BREV: u64 = 37
const K_RI_BJAR: u64 = 38
const K_RI_CTAB: u64 = 39
const K_RI_BBLOCK: u64 = 40
const K_PR_TAB: u64 = 41
const K_PR_BREF: u64 = 42
const K_UP_BCHK: u64 = 43
const K_UP_BINST: u64 = 44
const K_UP_BCHAN: u64 = 45
const K_UP_BAUTO: u64 = 46
const K_UP_BRB: u64 = 47
const K_UP_BCONF: u64 = 48
const K_SU_BCHK: u64 = 119 // SYSTEM update block: check
const K_SU_BINST: u64 = 120 // ... install + restart
const K_SU_NOTES: u64 = 121 // ... the changelog list
const K_CS: u64 = 49
const K_CK: u64 = 50
const K_CD: u64 = 51
const K_CH: u64 = 52
const K_CC: u64 = 53
const K_CG: u64 = 54
const K_CQ: u64 = 55
const K_B2: u64 = 56
const K_B2A: u64 = 57
const K_B2B: u64 = 58
const K_ECW: u64 = 59
const K_ECH: u64 = 60
const K_ECT: u64 = 61
const K_BCE: u64 = 62
const K_BCP: u64 = 63
const K_CZ: u64 = 64
const K_B3: u64 = 65
const K_CN: u64 = 66
const K_EN1: u64 = 67
const K_EN2: u64 = 68
const K_EN3: u64 = 69
const K_TNP: u64 = 70
const K_TNC: u64 = 71
const K_B4: u64 = 72
const K_B4J: u64 = 73
// LW-5 (keys 130.. are free: 123..169)
const K_WSS: u64 = 130 // Wi-Fi: network name entry
const K_WPW: u64 = 131 // Wi-Fi: password entry
const K_WSC: u64 = 132 // Wi-Fi: scan
const K_WCO: u64 = 133 // Wi-Fi: connect (checks name + password, then says why nothing connects)
const K_URF: u64 = 134 // USB network: refresh
const K_EP1: u64 = 74
const K_EP2: u64 = 75
const K_B5: u64 = 76
const K_EPIN: u64 = 110 // r253: PIN entry
const K_BPIN: u64 = 111 // r253: set PIN
const K_BPINX: u64 = 112 // r253: remove PIN
const K_EPINO: u64 = 113 // r824: current PIN entry
const K_CSP: u64 = 77
const K_BSP: u64 = 78
const K_LV: u64 = 79
const K_CV: u64 = 80
const K_B6: u64 = 81
const K_CF: u64 = 82
const K_B7: u64 = 83
const K_CL: u64 = 84
const K_CK2: u64 = 85
const K_B8: u64 = 86
const K_CKANB: u64 = 87
const K_TRN: u64 = 118 // W-S: Transparency effects (choice slot 118 % 110 = 8 is free)
const K_EKZIEL: u64 = 88
const K_EKNAME: u64 = 89
const K_EKKEN: u64 = 90
const K_EKCODE: u64 = 91
const K_BKADD: u64 = 92
const K_LKONTEN: u64 = 93
const K_BKOUT: u64 = 94
const K_EKGEH: u64 = 95
const K_EKBER: u64 = 96
const K_BKDEV: u64 = 97 // 'Mit Code anmelden' (device flow, RFC 8628)
const K_BKBOOK: u64 = 117 // same flow + `--exchange`: also connect the address book

static mut kval: [u64; 200] = [0 as u64; 200] // the value of every choice
static mut ch_items: [u64; 200] = [0 as u64; 200] // its items (text, '\n' between)
static mut ch_buf: [u8; 4400] = [0 as u8; 4400] // the shown item of each
static mut it_buf: [u8; 480] = [0 as u8; 480] // the items of the open popup
static mut ch_pend: u64 = 0 // the choice whose popup is open
static mut tab_buf: [u8; 1480] = [0 as u8; 1480] // the 29 tab names + the names of up to 8 package pages, 40 each
static mut rep_due: u64 = 0 // the rectangles must be reported again
static mut en_key: [u64; 28] = [0 as u64; 28]
static mut en_buf: [u64; 28] = [0 as u64; 28]
static mut en_max: [u64; 28] = [0 as u64; 28]
static mut en_n: u64 = 0

fn is_choice(k: u64) -> bool {
    return k == K_TRN || k == K_CM || k == K_CSH || k == K_ZS1 || k == K_ZS2 || k == K_ZS3 || k == K_BS1 || k == K_BS2 || k == K_CE || k == K_CAL || k == K_CK || k == K_CD || k == K_CH || k == K_CC || k == K_CG || k == K_CQ || k == K_CZ || k == K_CZC || k == K_CN || k == K_CSP || k == K_CV || k == K_CF || k == K_CL || k == K_CK2 || k == K_CKANB
        || k == K_PW_LB || k == K_PW_LA || k == K_PW_PB || k == K_PW_PA
}

fn is_slider(k: u64) -> bool {
    return k == K_SL_RAD || k == K_SL_TBA || k == K_SL_WA || k == K_SL_BLUR
        || k == K_MS_SPD || k == K_MS_ACC
        || k == K_PW_SB || k == K_PW_SA || k == K_PW_YB || k == K_PW_YA
}

// The shown text of the choice `k`: item number kval[k] of `items`.
fn chtext(k: u64, items: u64) -> u64 {
    ch_items[(k) as usize] = items
    let slot: u64 = ((&ch_buf[0 as usize]) as u64) + (k % 110) * 40
    var p: u64 = items
    var i: u64 = 0
    while i < kval[(k) as usize] {
        while __mmio_read8(p as *mut u8) != 10 as u8
            && __mmio_read8(p as *mut u8) != 0 as u8 {
            p = p + 1
        }
        if __mmio_read8(p as *mut u8) == 10 as u8 {
            p = p + 1
        }
        i = i + 1
    }
    var n: u64 = 0
    while n < 38 {
        let c: u8 = __mmio_read8((p + n) as *mut u8)
        if c == 10 as u8 || c == 0 as u8 {
            break
        }
        __mmio_write8((slot + n) as *mut u8, c)
        n = n + 1
    }
    __mmio_write8((slot + n) as *mut u8, 0 as u8)
    return slot
}

// The items of a choice as a popup wants them (NUL between); how many.
fn items_nul(items: u64) -> u64 {
    var n: u64 = 1
    var q: u64 = 0
    while q < 470 {
        let c: u8 = __mmio_read8((items + q) as *mut u8)
        if c == 0 as u8 {
            break
        }
        if c == 10 as u8 {
            it_buf[(q) as usize] = 0 as u8
            n = n + 1
        } else {
            it_buf[(q) as usize] = c
        }
        q = q + 1
    }
    it_buf[(q) as usize] = 0 as u8
    it_buf[((q + 1)) as usize] = 0 as u8
    return n
}

// Open the popup of the choice `k` below it.
fn ch_open(k: u64) {
    let i: usize = fuiscene.node_of_key(k)
    if i == fuiscene.NONE {
        return
    }
    let n: u64 = items_nul(ch_items[(k) as usize])
    var pw: u64 = fuiscene.node_w(i)
    if pw < 160 {
        pw = 160
    }
    let mx: u64 = fuiscene.node_x(i)
    let my: u64 = fuiscene.node_y(i) + fuiscene.node_h(i) + 2
    fuiscene.menu_open(mx, my, pw, (&it_buf[0 as usize]) as u64, n)
    ch_pend = k
    menu_say(k, wlib.win_cx(w) + mx, wlib.win_cy(w) + my, n)
}

// The column widths of a table from the program's width array.
fn colw_set(key: u64, arr: u64, n: u64) {
    var c: u64 = 0
    while c < n {
        fuiscene.table_colw(key, c, __mmio_read64((arr + c * 8) as *mut u64))
        c = c + 1
    }
}

// Sliders run 0..1000 in fUi; the program's numbers run lo..hi.
fn slv_init(k: u64, lo: u64, hi: u64, v: u64) -> i64 {
    var x: u64 = v
    if x < lo {
        x = lo
    }
    if x > hi {
        x = hi
    }
    return (((x - lo) * 1000) / (hi - lo)) as i64
}

fn slv(k: u64, lo: u64, hi: u64) -> u64 {
    let v: u64 = fuiscene.value_of(k) as u64
    return lo + (v * (hi - lo) + 500) / 1000
}

fn sl_set(k: u64, lo: u64, hi: u64, v: u64) {
    fuiscene.set_value(k, slv_init(k, lo, hi, v))
}

// ------------------------------------------------ the text of the fields
fn en_add(key: u64, buf: u64, max: u64) {
    if en_n < 28 {
        en_key[(en_n) as usize] = key
        en_buf[(en_n) as usize] = buf
        en_max[(en_n) as usize] = max
        en_n = en_n + 1
    }
}

fn entries_init() {
    en_add(K_SRCH, (&e_srch[0 as usize]) as u64, 44)
    en_add(K_EA, (&e_akzent[0 as usize]) as u64, 12)
    en_add(K_EB, (&e_bild[0 as usize]) as u64, 90)
    en_add(K_ET, (&e_tbs[0 as usize]) as u64, 8)
    en_add(K_EVN, (&e_vid[0 as usize]) as u64, 24)
    en_add(K_EVF, (&e_vfile[0 as usize]) as u64, 90)
    en_add(K_SY_ENT, (&e_sval[0 as usize]) as u64, 64)
    en_add(K_ECW, (&e_cw[0 as usize]) as u64, 8)
    en_add(K_ECH, (&e_ch[0 as usize]) as u64, 8)
    en_add(K_ECT, (&e_ct[0 as usize]) as u64, 4)
    en_add(K_EN1, (&e_ip[0 as usize]) as u64, 20)
    en_add(K_EN2, (&e_maske[0 as usize]) as u64, 20)
    en_add(K_EN3, (&e_gw[0 as usize]) as u64, 20)
    en_add(K_EP1, (&e_pw1[0 as usize]) as u64, 60)
    en_add(K_WSS, (&e_wssid[0 as usize]) as u64, 33)
    en_add(K_WPW, (&e_wpw[0 as usize]) as u64, 64)
    en_add(K_EP2, (&e_pw2[0 as usize]) as u64, 60)
    en_add(K_EPIN, (&e_pin[0 as usize]) as u64, 14)
    en_add(K_EPINO, (&e_pinold[0 as usize]) as u64, 14)
    en_add(K_EKZIEL, (&e_kziel[0 as usize]) as u64, 90)
    en_add(K_EKNAME, (&e_kname[0 as usize]) as u64, 60)
    en_add(K_EKKEN, (&e_kken[0 as usize]) as u64, 60)
    en_add(K_EKCODE, (&e_kcode[0 as usize]) as u64, 20)
    en_add(K_EKGEH, (&e_kgeh[0 as usize]) as u64, 60)
    en_add(K_EKBER, (&e_kber[0 as usize]) as u64, 60)
    // the host starts with what the buffers hold
    var i: u64 = 0
    while i < en_n {
        fuiscene.entry_set(en_key[(i) as usize], en_buf[(i) as usize])
        i = i + 1
    }
}

// The fields into the program's buffers (before an event is acted on).
fn pull_entries() {
    var i: u64 = 0
    while i < en_n {
        let t: u64 = fuiscene.entry_text(en_key[(i) as usize])
        if t != 0 {
            let n: u64 = ulib.strncpy(en_buf[(i) as usize], t, en_max[(i) as usize])
            __mmio_write8((en_buf[(i) as usize] + n) as *mut u8, 0 as u8)
        }
        i = i + 1
    }
}

// What the logic changed in the buffers into the fields (a field that was
// not changed keeps its caret).
fn push_entries() {
    var i: u64 = 0
    while i < en_n {
        let t: u64 = fuiscene.entry_text(en_key[(i) as usize])
        if t == 0 || !ulib.streq(t, en_buf[(i) as usize]) {
            fuiscene.entry_set(en_key[(i) as usize], en_buf[(i) as usize])
        }
        i = i + 1
    }
}

// ------------------------------------------------ the theme tiles
fn tspv(t: u64, f: u64) -> u64 {
    return tsp[((t * wlib.TILE_FIELDS + f)) as usize]
}

// One tile: the preset's own colours -- its surface, a miniature task bar on
// ITS edge with the button, a miniature window -- and the name on the left.
// One `wlib: kachelbalken` line: a bar of a tile's miniature taskbar and the
// rectangle it has to lie in (`ein` = how far the tile's corner cuts in at the
// height of the bar's first row). The acceptance run holds the one against the
// other.
fn say_balken(x: u64, y: u64, w: u64, h: u64, kx: u64, ky: u64, kw: u64, kh: u64,
    ein: u64) {
    if !fuiscene.trace_on() {
        return
    }
    var a0: [u8; 22] = "wlib: kachelbalken x=\0"
    var a1: [u8; 4] = " y=\0"
    var a2: [u8; 4] = " w=\0"
    var a3: [u8; 4] = " h=\0"
    var a4: [u8; 5] = " kx=\0"
    var a5: [u8; 5] = " ky=\0"
    var a6: [u8; 5] = " kw=\0"
    var a7: [u8; 5] = " kh=\0"
    var a8: [u8; 6] = " ein=\0"
    var at: u64 = rs_put(0, (&a0[0 as usize]) as u64)
    at = rs_num(at, x)
    at = rs_put(at, (&a1[0 as usize]) as u64)
    at = rs_num(at, y)
    at = rs_put(at, (&a2[0 as usize]) as u64)
    at = rs_num(at, w)
    at = rs_put(at, (&a3[0 as usize]) as u64)
    at = rs_num(at, h)
    at = rs_put(at, (&a4[0 as usize]) as u64)
    at = rs_num(at, kx)
    at = rs_put(at, (&a5[0 as usize]) as u64)
    at = rs_num(at, ky)
    at = rs_put(at, (&a6[0 as usize]) as u64)
    at = rs_num(at, kw)
    at = rs_put(at, (&a7[0 as usize]) as u64)
    at = rs_num(at, kh)
    at = rs_put(at, (&a8[0 as usize]) as u64)
    at = rs_num(at, ein)
    let bb: u64 = (&rs_buf[0 as usize]) as u64
    __mmio_write8((bb + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(bb, at)
}

// How far a corner of radius `r` cuts in at depth 4: r - sqrt(r^2 - (r-4)^2),
// rounded up. 0 when the tile is square.
fn corner_in(r: u64) -> u64 {
    if r <= 4 {
        return r
    }
    var d: u64 = r - 4
    var s: u64 = 0
    while (s + 1) * (s + 1) <= r * r - d * d {
        s = s + 1
    }
    return r - s + 1
}

fn draw_tile(key: u64, x: u64, y: u64, w2: u64, h2: u64) {
    let t: u64 = key - K_TILE0
    if t >= v_n || w2 < 80 || h2 < 20 {
        return
    }
    // the tile's corner is the SHAPE's button radius (0 in `classic`)
    let tr: u64 = fuiscene.rb_px()
    var ri: u64 = 3
    var rj: u64 = 2
    if tr == 0 {
        ri = 0
        rj = 0
    }
    fuiscene.cv_round_rgb(x, y, w2, h2, tr, tspv(t, wlib.TL_SURFACE))
    if v_sel == t {
        fuiscene.cv_ring_rgb(x, y, w2, h2, tr, 3, wlibc.theme(wlibc.T_FOCUS))
    } else {
        fuiscene.cv_ring_rgb(x, y, w2, h2, tr, 1, tspv(t, wlib.TL_FRAME))
    }
    let pw: u64 = 92
    let px: u64 = x + w2 - pw - 8
    let py: u64 = y + 4
    let ph: u64 = h2 - 8
    fuiscene.cv_round_rgb(px, py, pw, ph, ri, tspv(t, wlib.TL_SURFACE))
    let e: u64 = tspv(t, wlib.TL_EDGE)
    let bar: u64 = 5
    var bx: u64 = px
    var by: u64 = py + ph - bar
    var bw2: u64 = pw
    var bh2: u64 = bar
    if e == 1 {
        by = py
    } else if e == 2 {
        by = py
        bw2 = bar
        bh2 = ph
    } else if e == 3 {
        bx = px + pw - bar
        by = py
        bw2 = bar
        bh2 = ph
    }
    fuiscene.cv_round_rgb(bx, by, bw2, bh2, 0, tspv(t, wlib.TL_TASKBAR))
    say_balken(bx, by, bw2, bh2, x, y, w2, h2, corner_in(tr))
    if e == 2 || e == 3 {
        fuiscene.cv_round_rgb(bx + 1, by + 3, bar - 2, 14, 0, tspv(t, wlib.TL_ACCENT))
        say_balken(bx + 1, by + 3, bar - 2, 14, x, y, w2, h2, corner_in(tr))
    } else {
        fuiscene.cv_round_rgb(bx + 3, by + 1, 14, bar - 2, 0, tspv(t, wlib.TL_ACCENT))
        say_balken(bx + 3, by + 1, 14, bar - 2, x, y, w2, h2, corner_in(tr))
    }
    var wx: u64 = px + 8
    var wy: u64 = py + 6
    if e == 1 {
        wy = py + 9
    }
    if e == 2 {
        wx = px + 12
    }
    let ww: u64 = 60
    let wh: u64 = ph - 12
    if wh >= 10 {
        fuiscene.cv_round_rgb(wx, wy, ww, wh, ri, tspv(t, wlib.TL_RAISED))
        fuiscene.cv_ring_rgb(wx, wy, ww, wh, ri, 1, tspv(t, wlib.TL_FRAME))
        fuiscene.cv_round_rgb(wx + 1, wy + 1, ww - 2, 7, rj, tspv(t, wlib.TL_ACCENT))
        fuiscene.cv_round_rgb(wx + 4, wy + 3, 22, 2, 0, tspv(t, wlib.TL_ONACCENT))
        fuiscene.cv_round_rgb(wx + 4, wy + 11, ww - 14, 2, 0, tspv(t, wlib.TL_TEXT))
    }
    var col: u64 = tspv(t, wlib.TL_TEXT)
    if tspv(t, wlib.TL_LOW) != 0 {
        col = tspv(t, wlib.TL_DANGER)
    }
    let tpx: u64 = wlibc.px_ui()
    fuiscene.cv_text_rgb(x + 10, y + h2 / 2 + 5, w2 - pw - 28, tspv(t, wlib.TL_NAME),
        tpx, false, col)
    say_kachel_text(x + 10, y + h2 / 2 + 5, tspv(t, wlib.TL_NAME), col,
        tspv(t, wlib.TL_SURFACE))
}

// The name on a tile, reported like wlib reported it: `wlib: text ... kind=12 ...
// nq= nv= t=` (the acceptance run checks every glyph against the preset's name).
fn say_kachel_text(x: u64, base: u64, name: u64, fg: u64, bg: u64) {
    if !fuiscene.trace_on() {
        return
    }
    var a0: [u8; 30] = "wlib: text win=0 kind=12 x=\0\0\0"
    var a1: [u8; 7] = " base=\0"
    var a2: [u8; 5] = " fg=\0"
    var a3: [u8; 5] = " bg=\0"
    var a4: [u8; 5] = " tw=\0"
    var a5: [u8; 5] = " ax=\0"
    var a6: [u8; 5] = " ay=\0"
    var a7: [u8; 5] = " nq=\0"
    var a8: [u8; 5] = " nv=\0"
    var a9: [u8; 4] = " t=\0"
    let n: u64 = ulib.length(name)
    var at: u64 = rs_put(0, (&a0[0 as usize]) as u64)
    at = rs_num(at, x)
    at = rs_put(at, (&a1[0 as usize]) as u64)
    at = rs_num(at, base)
    at = rs_put(at, (&a2[0 as usize]) as u64)
    at = rs_num(at, fg)
    at = rs_put(at, (&a3[0 as usize]) as u64)
    at = rs_num(at, bg)
    at = rs_put(at, (&a4[0 as usize]) as u64)
    at = rs_num(at, wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), name, n))
    at = rs_put(at, (&a5[0 as usize]) as u64)
    at = rs_num(at, wlib.win_cx(w))
    at = rs_put(at, (&a6[0 as usize]) as u64)
    at = rs_num(at, wlib.win_cy(w))
    at = rs_put(at, (&a7[0 as usize]) as u64)
    at = rs_num(at, n)
    at = rs_put(at, (&a8[0 as usize]) as u64)
    at = rs_num(at, n)
    at = rs_put(at, (&a9[0 as usize]) as u64)
    at = rs_put(at, name)
    let bb: u64 = (&rs_buf[0 as usize]) as u64
    __mmio_write8((bb + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(bb, at)
}

// height of the colour scheme list on the Darstellung page
fn ls_h() -> u64 {
    if short_win() {
        return 100
    }
    return 118
}

