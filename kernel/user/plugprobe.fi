// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/plugprobe.fi -- DER PRUEFLING DER SCHNITTSTELLE.
//
// Die beiden ECHTEN Plugins dieser Runde sind /bin/plugregel und
// /bin/pluguhr; die Gegenprobe gegen einen boesartigen Nachbarn ist
// /bin/plugboese. Dieses Programm ist das dritte Stueck: es geht die
// Schnittstelle EINMAL GANZ DURCH und sagt bei jedem Schritt, was der
// Kern geantwortet hat. Ohne es waere die Fassungsnummer, der
// Kuerzelweg und die Tempozahl nie an einem laufenden Kern gemessen,
// sondern nur beschrieben.
//
//   plugprobe        anmelden, Rechte pruefen, Kuerzel OHNE und MIT
//                    Gewaehrung belegen, ein Fenster auf- und zumachen,
//                    die Ereignisse abholen, PL_FRAMES/PL_LATUS vor und
//                    nach der Last lesen, sauber abmelden
//   plugprobe zkey   dasselbe, aber mit einem GEWOEHNLICHEN Buchstaben
//                    statt F12 -- nur damit laesst sich zeigen, dass das
//                    Fenster die belegte Taste NICHT mehr bekommt
//   plugprobe segv   anmelden und dann in die Null schreiben -- die
//                    Gegenprobe fuer `reap`: der Kern muss den Platz
//                    selber abholen, es kommt kein UNREG mehr
//   plugprobe hang   anmelden, abonnieren und NICHTS mehr abholen --
//                    die Gegenprobe fuer die Frist

profile kernel

import ulib
// Eine Zeile, ein Schreibruf -- sonst zerreisst der Kern die Meldung
// zwischen zwei Stuecken. Siehe kernel/user/zeile.fi.
import zeile

export { u_start }

const WM_PLUG_REG: u64 = 2117
const WM_PLUG_UNREG: u64 = 2118
const WM_PLUG_POLL: u64 = 2119
const WM_PLUG_INFO: u64 = 2121
const WM_PLUG_KEY: u64 = 2123
const WM_PLUG_GRANT: u64 = 2126

const PL_ABI: u64 = 0
const PL_PLUGS: u64 = 2
const PL_RIGHTS: u64 = 5
const PL_PENDING: u64 = 7
const PL_GRUND: u64 = 9
const PL_KICKS: u64 = 12
const PL_DENY: u64 = 13
const PL_FRAMES: u64 = 18
const PL_LATUS: u64 = 19

const WMP_ABI: u64 = 1
const R_ALL: u64 = 0xF1F
const KEY_F12: u64 = 0x8C

fn name_in(p: u64) {
    var s_nm: [u8; 6] = "probe\0"
    ulib.fill(p, 0, 16)
    ulib.strncpy(p, (&s_nm[0 as usize]) as u64, 15)
}

fn zahl(txt: u64, v: u64) {
    zeile.t(txt)
    zeile.n(v)
    zeile.nl()
}

fn u_start(args: u64) -> u64 {
    var name: [u8; 16] = [0 as u8; 16]
    var w_segv: [u8; 5] = "segv\0"
    var w_hang: [u8; 5] = "hang\0"
    var w_zkey: [u8; 5] = "zkey\0"
    var s_abi: [u8; 16] = "probe: abi=\0\0\0\0\0"
    var s_pl: [u8; 16] = "probe: platz=\0\0\0"
    var s_rc: [u8; 17] = "probe: rechte=\0\0\0"
    var s_k1: [u8; 21] = "probe: key ohne rc=\0\0"
    var s_k2: [u8; 20] = "probe: key mit rc=\0\0"
    var s_ev: [u8; 15] = "probe: ev typ=\0"
    var s_da: [u8; 8] = " dat=\0\0\0"
    var s_fr: [u8; 17] = "probe: frames=\0\0\0"
    var s_us: [u8; 14] = "probe: latus=\0"
    var s_en: [u8; 14] = "probe: ende\0\0\0"
    var s_sg: [u8; 22] = "probe: gleich stuerzt\0"
    var s_hg: [u8; 22] = "probe: haengt jetzt  \0"
    let p: u64 = (&name[0 as usize]) as u64
    name_in(p)

    zahl((&s_abi[0 as usize]) as u64, ulib.sys(WM_PLUG_INFO, 0, PL_ABI, 0))
    // Anmelden mit allen Ereignissen ausser E_STOP -- das kommt ohnehin.
    let platz: u64 = ulib.sys(WM_PLUG_REG, WMP_ABI, p, 0x7E)
    zahl((&s_pl[0 as usize]) as u64, platz)
    if ulib.bad(platz) {
        return 1
    }
    zahl((&s_rc[0 as usize]) as u64,
        ulib.sys(WM_PLUG_INFO, platz, PL_RIGHTS, 0))

    let n: u64 = ulib.arg_count(args)
    var modus: u64 = 0
    if n >= 2 {
        let a1: u64 = ulib.arg_at(args, 1)
        if ulib.streq(a1, (&w_segv[0 as usize]) as u64) {
            modus = 1
        }
        if ulib.streq(a1, (&w_hang[0 as usize]) as u64) {
            modus = 2
        }
        if ulib.streq(a1, (&w_zkey[0 as usize]) as u64) {
            modus = 3
        }
    }

    if modus == 1 {
        zeile.t((&s_sg[0 as usize]) as u64)
        zeile.nl()
        // DER ABSTURZ. Kein exit, kein unreg -- genau so, wie ein
        // fehlerhaftes Plugin endet.
        let z: u64 = 0
        *((z) as *mut u64) = 1
        return 0
    }
    if modus == 2 {
        // ERST ETWAS ZU TUN VERSCHAFFEN, dann nicht mehr abholen: die
        // Frist greift nach dem Befund "gerufen worden und nicht
        // gekommen". Ein Plugin, das nichts abonniert hat und dem
        // nichts liegt, ist still und nicht traege.
        var t2: [u8; 8] = "haenger\0"
        let h2: u64 = ulib.sys4(2100, (80 << 16) | 80, (160 << 16) | 100,
            (&t2[0 as usize]) as u64, 0)
        zeile.t((&s_hg[0 as usize]) as u64)
        zeile.n(h2)
        zeile.nl()
        // ZWEI SCHLEIFEN, weil eine mit einer sehr grossen Zahl im
        // ersten Anlauf sofort zurueckkam (gemessen: `kernprobe -> 0`
        // stand da, bevor die Frist ueberhaupt laufen konnte).
        // NICHT ABHOLEN, ABER RECHNEN. Zwei Anlaeufe mit einer reinen
        // Zaehlschleife kamen sofort zurueck -- der Uebersetzer warf
        // sie weg. Ein Aufruf, den er nicht wegwerfen darf, haelt den
        // Prozess ohne jeden Kunstgriff beschaeftigt; fuer die Frist
        // zaehlt ohnehin nur eines: er holt seine Ereignisse nicht ab.
        var a: u64 = 0
        while a < 2000000 {
            let _pid: u64 = ulib.sys(ulib.SYS_GETPID, 0, 0, 0)
            a = a + 1
        }
        return 0
    }

    // DIE RECHTEPROBE. Ohne Gewaehrung darf das Kuerzel NICHT belegt
    // werden; der Rueckgabewert ist negativ UND PL_DENY steigt.
    let d0: u64 = ulib.sys(WM_PLUG_INFO, 0, PL_DENY, 0)
    zahl((&s_k1[0 as usize]) as u64, ulib.sys(WM_PLUG_KEY, KEY_F12, 0, 0))
    zahl((&s_rc[0 as usize]) as u64, ulib.sys(WM_PLUG_INFO, 0, PL_DENY, 0) - d0)
    // Und mit Gewaehrung geht dasselbe. (Der Ruf ist root vorbehalten;
    // in diesem Lauf ist die Shell root.)
    let g: u64 = ulib.sys(WM_PLUG_GRANT, p, R_ALL, 0)
    zahl((&s_rc[0 as usize]) as u64, g)
    // MODUS `zkey`: ein GEWOEHNLICHER Buchstabe statt F12. Nur mit ihm
    // laesst sich zeigen, dass das Fenster (und das Terminal darin) die
    // Taste NICHT mehr bekommt -- F12 laeuft ueber den Kuerzelring und
    // ginge ohnehin an kein Fenster.
    var taste: u64 = KEY_F12
    if modus == 3 {
        taste = 0x7A
    }
    zahl((&s_k2[0 as usize]) as u64, ulib.sys(WM_PLUG_KEY, taste, 0, 0))

    zahl((&s_fr[0 as usize]) as u64, ulib.sys(WM_PLUG_INFO, 0, PL_FRAMES, 0))
    zahl((&s_us[0 as usize]) as u64, ulib.sys(WM_PLUG_INFO, 0, PL_LATUS, 0))

    // EIN FENSTER AUF UND WIEDER ZU, damit es ueberhaupt etwas zu
    // melden gibt: E_WIN_OPEN, E_FOCUS, bei Kachelbetrieb E_TILE, und
    // beim Schliessen E_WIN_CLOSE. Ein Ereignisweg, den nie ein
    // Ereignis durchlaufen hat, ist nicht gemessen.
    var titel: [u8; 8] = "probe\0\0\0"
    let h: u64 = ulib.sys4(2100, (60 << 16) | 60, (200 << 16) | 120,
        (&titel[0 as usize]) as u64, 0)
    zahl((&s_rc[0 as usize]) as u64, h)

    var ev: [u64; 2] = [0; 2]
    let ep: u64 = (&ev[0 as usize]) as u64
    var runde: u64 = 0
    while runde < 60 {
        var w: u64 = 0
        while w < 8 && ulib.sys(WM_PLUG_POLL, ep, 0, 0) == 1 {
            zeile.t((&s_ev[0 as usize]) as u64)
            zeile.u(ev[0 as usize])
            zeile.t((&s_da[0 as usize]) as u64)
            zeile.u(ev[1 as usize])
            zeile.nl()
            w = w + 1
        }
        let _z: u64 = ulib.sleep_ms(100)
        runde = runde + 1
        if runde == 20 && !ulib.bad(h) {
            let _c: u64 = ulib.sys(2107, h, 0, 0)
        }
    }
    zahl((&s_fr[0 as usize]) as u64, ulib.sys(WM_PLUG_INFO, 0, PL_FRAMES, 0))
    zahl((&s_us[0 as usize]) as u64, ulib.sys(WM_PLUG_INFO, 0, PL_LATUS, 0))
    zahl((&s_en[0 as usize]) as u64, ulib.sys(WM_PLUG_UNREG, 0, 0, 0))
    return 0
}
