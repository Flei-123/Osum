
profile kernel

import libc.memcopy
import ulib
import libc.kcall
import libc.clockapi
import lineout

export { u_start }

const WM_PLUG_REG: u64 = 2117
const WM_PLUG_UNREG: u64 = 2118
const WM_PLUG_POLL: u64 = 2119
const WM_PLUG_INFO: u64 = 2121
const WM_PLUG_KEY: u64 = 2123
const WM_PLUG_GRANT: u64 = 2126

const PL_ABI: u64 = 0
const PL_PLUGS: u64 = 2
const PL_RIGHTS: u64 = 5
const PL_PENDING: u64 = 7
const PL_REASON: u64 = 9
const PL_KICKS: u64 = 12
const PL_DENY: u64 = 13
const PL_FRAMES: u64 = 18
const PL_LATUS: u64 = 19

const WMP_ABI: u64 = 1
const R_ALL: u64 = 0xF1F
const KEY_F12: u64 = 0x8C

fn name_in(p: u64) {
    var s_nm: [u8; 6] = "probe\0"
    memcopy.fill(p, 0, 16)
    ulib.strncpy(p, (&s_nm[0 as usize]) as u64, 15)
}

fn num(txt: u64, v: u64) {
    lineout.add_text(txt)
    lineout.add_num(v)
    lineout.end_line()
}

fn u_start(args: u64) -> u64 {
    var name: [u8; 16] = [0 as u8; 16]
    var w_segv: [u8; 5] = "segv\0"
    var w_hang: [u8; 5] = "hang\0"
    var w_zkey: [u8; 5] = "zkey\0"
    var s_abi: [u8; 16] = "probe: abi=\0\0\0\0\0"
    var s_pl: [u8; 16] = "probe: slot=\0\0\0\0"
    var s_rc: [u8; 17] = "probe: rechte=\0\0\0"
    var s_k1: [u8; 24] = "probe: key without rc=\0\0"
    var s_k2: [u8; 20] = "probe: key mit rc=\0\0"
    var s_ev: [u8; 15] = "probe: ev typ=\0"
    var s_da: [u8; 8] = " dat=\0\0\0"
    var s_fr: [u8; 17] = "probe: frames=\0\0\0"
    var s_us: [u8; 14] = "probe: latus=\0"
    var s_en: [u8; 14] = "probe: ende\0\0\0"
    var s_sg: [u8; 22] = "probe: gleich stuerzt\0"
    var s_hg: [u8; 19] = "probe: hangs now  \0"
    let p: u64 = (&name[0 as usize]) as u64
    name_in(p)

    num((&s_abi[0 as usize]) as u64, ulib.sys(WM_PLUG_INFO, 0, PL_ABI, 0))
    let space: u64 = ulib.sys(WM_PLUG_REG, WMP_ABI, p, 0x7E)
    num((&s_pl[0 as usize]) as u64, space)
    if ulib.bad(space) {
        return 1
    }
    num((&s_rc[0 as usize]) as u64,
        ulib.sys(WM_PLUG_INFO, space, PL_RIGHTS, 0))

    let n: u64 = ulib.arg_count(args)
    var modus: u64 = 0
    if n >= 2 {
        let a1: u64 = ulib.arg_at(args, 1)
        if ulib.streq(a1, (&w_segv[0 as usize]) as u64) {
            modus = 1
        }
        if ulib.streq(a1, (&w_hang[0 as usize]) as u64) {
            modus = 2
        }
        if ulib.streq(a1, (&w_zkey[0 as usize]) as u64) {
            modus = 3
        }
    }

    if modus == 1 {
        lineout.add_text((&s_sg[0 as usize]) as u64)
        lineout.end_line()
        let z: u64 = 0
        *((z) as *mut u64) = 1
        return 0
    }
    if modus == 2 {
        var t2: [u8; 8] = "hänger\0"
        let h2: u64 = kcall.sys4(2100, (80 << 16) | 80, (160 << 16) | 100,
            (&t2[0 as usize]) as u64, 0)
        lineout.add_text((&s_hg[0 as usize]) as u64)
        lineout.add_num(h2)
        lineout.end_line()
        var a: u64 = 0
        while a < 2000000 {
            let _pid: u64 = ulib.sys(ulib.SYS_GETPID, 0, 0, 0)
            a = a + 1
        }
        return 0
    }

    let d0: u64 = ulib.sys(WM_PLUG_INFO, 0, PL_DENY, 0)
    num((&s_k1[0 as usize]) as u64, ulib.sys(WM_PLUG_KEY, KEY_F12, 0, 0))
    num((&s_rc[0 as usize]) as u64, ulib.sys(WM_PLUG_INFO, 0, PL_DENY, 0) - d0)
    let g: u64 = ulib.sys(WM_PLUG_GRANT, p, R_ALL, 0)
    num((&s_rc[0 as usize]) as u64, g)
    var key: u64 = KEY_F12
    if modus == 3 {
        key = 0x7A
    }
    num((&s_k2[0 as usize]) as u64, ulib.sys(WM_PLUG_KEY, key, 0, 0))

    num((&s_fr[0 as usize]) as u64, ulib.sys(WM_PLUG_INFO, 0, PL_FRAMES, 0))
    num((&s_us[0 as usize]) as u64, ulib.sys(WM_PLUG_INFO, 0, PL_LATUS, 0))

    var title: [u8; 8] = "probe\0\0\0"
    let h: u64 = kcall.sys4(2100, (60 << 16) | 60, (200 << 16) | 120,
        (&title[0 as usize]) as u64, 0)
    num((&s_rc[0 as usize]) as u64, h)

    var ev: [u64; 2] = [0; 2]
    let ep: u64 = (&ev[0 as usize]) as u64
    var runde: u64 = 0
    while runde < 60 {
        var w: u64 = 0
        while w < 8 && ulib.sys(WM_PLUG_POLL, ep, 0, 0) == 1 {
            lineout.add_text((&s_ev[0 as usize]) as u64)
            lineout.add_unum(ev[0 as usize])
            lineout.add_text((&s_da[0 as usize]) as u64)
            lineout.add_unum(ev[1 as usize])
            lineout.end_line()
            w = w + 1
        }
        let _z: u64 = clockapi.sleep_ms(100)
        runde = runde + 1
        if runde == 20 && !ulib.bad(h) {
            let _c: u64 = ulib.sys(2107, h, 0, 0)
        }
    }
    num((&s_fr[0 as usize]) as u64, ulib.sys(WM_PLUG_INFO, 0, PL_FRAMES, 0))
    num((&s_us[0 as usize]) as u64, ulib.sys(WM_PLUG_INFO, 0, PL_LATUS, 0))
    num((&s_en[0 as usize]) as u64, ulib.sys(WM_PLUG_UNREG, 0, 0, 0))
    return 0
}
