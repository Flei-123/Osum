profile kernel

import ulib
import libc.io
import xrpath

export { trim }

const LOG_CAP_BYTES: u64 = 262144
const TRUNCATE_FLAGS: u64 = 1 | 512
const LOG_MODE: u64 = 420


fn trim() -> bool {
    let size: u64 = io.size_of(xrpath.p_log())
    if ulib.bad(size) || size < LOG_CAP_BYTES {
        return false
    }
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, xrpath.p_log(), TRUNCATE_FLAGS, LOG_MODE)
    if ulib.bad(fd) {
        return false
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return true
}
