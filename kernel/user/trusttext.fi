profile kernel

import ulib
import actwire
import product
import libc.octets

export { build }

const NONE: u64 = 0xFFFFFFFF
const RS: u64 = 30
const ARG_MAX: u64 = 3
const RIGHTS_MAX: u64 = 3

static mut REG: [u8; 1039] = "system.elevate\t'{name}' will mit Administratorrechten laufen\t'{name}' wants to run with administrator rights\nstore.install\tDer Store will '{name}' installieren\tThe Store wants to install '{name}'\nstore.update\tDer Store will '{name}' aktualisieren\tThe Store wants to update '{name}'\nstore.remove\tDer Store will '{name}' entfernen\tThe Store wants to remove '{name}'\nsettings.update.install\tEine neue Programmversion laden und bereitstellen\tDownload and stage a new program version\nsettings.update.sysinstall\tEin neues System laden und neu starten\tDownload a new system and restart\nsettings.update.rollback\tZur vorherigen Version zurück (nach Neustart)\tGo back to the previous version (after restart)\nsettings.net.fixed\tFeste Netzwerkadresse {ip} setzen\tSet the fixed network address {ip}\nsettings.set\tDie Einstellung {key} auf '{value}' setzen\tSet the setting {key} to '{value}'\nsettings.*\tDie Einstellung {key} auf '{value}' setzen\tSet the setting {key} to '{value}'\n*\t{client} will '{action}' ausführen\t{client} wants to run '{action}'\n\0"
static mut T_TIT_DE: [u8; 29] = " - Bestätigung (vom System)\0"
static mut T_TIT_EN: [u8; 34] = " - Confirmation (from the system)\0"
static mut T_YES_DE: [u8; 13] = "[J] Erlauben\0"
static mut T_YES_EN: [u8; 10] = "[Y] Allow\0"
static mut T_NO_DE: [u8; 13] = "[N] Ablehnen\0"
static mut T_NO_EN: [u8; 9] = "[N] Deny\0"
static mut T_HNT_DE: [u8; 68] = "Nur echte Tastatur/Maus:  J = erlauben   N = ablehnen   D = Details\0"
static mut T_HNT_EN: [u8; 62] = "Real keyboard/mouse only:  Y = allow   N = deny   D = details\0"
static mut META: [u8; 321] = "system.elevate\tadmin\t{product} (Systemprogramm)\t{product} (system programme)\nstore.*\tinstall,net\tStore (signierter Katalog)\tStore (signed catalog)\nsettings.update.*\tinstall,net\t{product} (signierte Aktualisierung)\t{product} (signed update)\nsettings.*\tsettings\t{product} (Systemeinstellungen)\t{product} (system settings)\n\0"
static mut RIGHTS: [u8; 256] = "admin\tDas System für alle Benutzer ändern\tChange the system for all users\ninstall\tProgramme installieren oder entfernen\tInstall or remove programmes\nnet\tAufs Netzwerk zugreifen\tUse the network\nsettings\tSystemeinstellungen ändern\tChange system settings\n\0"
static mut T_PUB_DE: [u8; 14] = "Herausgeber: \0"
static mut T_PUB_EN: [u8; 12] = "Publisher: \0"
static mut T_DET_DE: [u8; 36] = "Details (Anfrage, Aktion, Absender)\0"
static mut T_DET_EN: [u8; 34] = "Details (request, action, sender)\0"
static mut T_REQ_DE: [u8; 13] = "Anfrage Nr. \0"
static mut T_REQ_EN: [u8; 13] = "Request no. \0"
static mut T_EXP_DE: [u8; 30] = " - verfaellt nach 60 Sekunden\0"
static mut T_EXP_EN: [u8; 28] = " - expires after 60 seconds\0"
static mut T_ACT_DE: [u8; 9] = "Aktion: \0"
static mut T_ACT_EN: [u8; 9] = "Action: \0"
static mut T_LVL_DE: [u8; 11] = "   Stufe: \0"
static mut T_LVL_EN: [u8; 11] = "   Level: \0"
static mut T_FRM_DE: [u8; 6] = "Von: \0"
static mut T_FRM_EN: [u8; 7] = "From: \0"
static mut T_IND: [u8; 3] = "  \0"
static mut P_LOCALE: [u8; 17] = "/etc/locale.conf\0"
static mut K_LANG: [u8; 5] = "lang\0"
static mut L_EN: [u8; 3] = "en\0"

fn english() -> bool {
    var v: [u8; 16] = [0 as u8; 16]
    let vp: u64 = (&v[0 as usize]) as u64
    if !actwire.kvfile_get((&P_LOCALE[0 as usize]) as u64, (&K_LANG[0 as usize]) as u64, vp, 16) {
        return false
    }
    return actwire.str_eq(vp, (&L_EN[0 as usize]) as u64) || (octets.ld8(vp, 0) == 101 && octets.ld8(vp, 1) == 110)
}

fn pick(en: bool, de: u64, e: u64) -> u64 {
    if en {
        return e
    }
    return de
}

fn put(en: bool, de: u64, e: u64) {
    actwire.ob_str(pick(en, de, e))
}

fn name_eq(line: u64, name: u64) -> bool {
    var i: u64 = 0
    while octets.ld8(line, i) != 9 && octets.ld8(line, i) != 0 {
        if octets.ld8(line, i) == 42 {
            return true
        }
        if octets.ld8(line, i) != octets.ld8(name, i) {
            return false
        }
        i = i + 1
    }
    return octets.ld8(name, i) == 0
}

fn find_in(r: u64, action: u64) -> u64 {
    var at: u64 = 0
    while octets.ld8(r, at) != 0 {
        if name_eq(r + at, action) {
            return at
        }
        while octets.ld8(r, at) != 10 && octets.ld8(r, at) != 0 {
            at = at + 1
        }
        if octets.ld8(r, at) == 10 {
            at = at + 1
        }
    }
    return NONE
}

fn field_in(r: u64, at: u64, f: u64) -> u64 {
    var i: u64 = at
    var k: u64 = 0
    while k < f {
        while octets.ld8(r, i) != 9 && octets.ld8(r, i) != 0 {
            i = i + 1
        }
        i = i + 1
        k = k + 1
    }
    return i
}

fn emit_key(m: u64, client: u64, action: u64, key: u64) {
    var v: [u8; 64] = [0 as u8; 64]
    let vp: u64 = (&v[0 as usize]) as u64
    var s_client: [u8; 7] = "client\0"
    var s_action: [u8; 7] = "action\0"
    var s_product: [u8; 8] = "product\0"
    if actwire.str_eq(key, (&s_client[0 as usize]) as u64) {
        actwire.ob_str(client)
    } else if actwire.str_eq(key, (&s_action[0 as usize]) as u64) {
        actwire.ob_str(action)
    } else if actwire.str_eq(key, (&s_product[0 as usize]) as u64) {
        actwire.ob_str(product.product())
    } else if actwire.kv_find(m, key, vp, 64) {
        actwire.ob_str(vp)
    }
}

fn emit_phrase(r: u64, m: u64, client: u64, action: u64, pos: u64) {
    var i: u64 = pos
    while octets.ld8(r, i) != 9 && octets.ld8(r, i) != 10 && octets.ld8(r, i) != 0 {
        let c: u64 = octets.ld8(r, i)
        if c == 123 {
            var key: [u8; 24] = [0 as u8; 24]
            var n: u64 = 0
            i = i + 1
            while octets.ld8(r, i) != 125 && octets.ld8(r, i) != 0 && n < 23 {
                octets.st8((&key[0 as usize]) as u64, n, octets.ld8(r, i))
                n = n + 1
                i = i + 1
            }
            octets.st8((&key[0 as usize]) as u64, n, 0)
            emit_key(m, client, action, (&key[0 as usize]) as u64)
            if octets.ld8(r, i) == 125 {
                i = i + 1
            }
        } else {
            actwire.ob_ch(c)
            i = i + 1
        }
    }
}

fn emit_args(m: u64, en: bool) {
    var at: u64 = actwire.line_end(m, 0)
    var n: u64 = 0
    while octets.ld8(m, at) != 0 && n < ARG_MAX {
        if octets.ld8(m, at) == 10 {
            at = at + 1
        }
        let e: u64 = actwire.line_end(m, at)
        if e > at && octets.ld8(m, at) != 64 && !skip_key(m + at) {
            actwire.ob_ch(10)
            actwire.ob_str((&T_IND[0 as usize]) as u64)
            var j: u64 = at
            while j < e && j < at + 50 {
                actwire.ob_ch(octets.ld8(m, j))
                j = j + 1
            }
            n = n + 1
        }
        at = e
    }
}

fn reg() -> u64 {
    return (&REG[0 as usize]) as u64
}

fn meta() -> u64 {
    return (&META[0 as usize]) as u64
}

fn rights_tab() -> u64 {
    return (&RIGHTS[0 as usize]) as u64
}

fn emit_publisher(m: u64, client: u64, action: u64, en: bool) {
    let at: u64 = find_in(meta(), action)
    if at == NONE {
        return
    }
    actwire.ob_ch(10)
    put(en, (&T_PUB_DE[0 as usize]) as u64, (&T_PUB_EN[0 as usize]) as u64)
    emit_phrase(meta(), m, client, action, field_in(meta(), at, pick(en, 2, 3)))
}

fn emit_right(id: u64, idn: u64, en: bool) {
    let r: u64 = rights_tab()
    var at: u64 = 0
    while octets.ld8(r, at) != 0 {
        var k: u64 = 0
        while k < idn && octets.ld8(r, at + k) == octets.ld8(id, k) {
            k = k + 1
        }
        if k == idn && octets.ld8(r, at + k) == 9 {
            actwire.ob_ch(10)
            actwire.ob_str((&T_IND[0 as usize]) as u64)
            actwire.ob_ch(45)
            actwire.ob_ch(32)
            emit_phrase(r, 0, 0, 0, field_in(r, at, pick(en, 1, 2)))
            return
        }
        while octets.ld8(r, at) != 10 && octets.ld8(r, at) != 0 {
            at = at + 1
        }
        if octets.ld8(r, at) == 10 {
            at = at + 1
        }
    }
    actwire.ob_ch(10)
    actwire.ob_str((&T_IND[0 as usize]) as u64)
    actwire.ob_ch(45)
    actwire.ob_ch(32)
    var j: u64 = 0
    while j < idn {
        actwire.ob_ch(octets.ld8(id, j))
        j = j + 1
    }
}

fn emit_rights(m: u64, action: u64, en: bool) {
    var list: [u8; 64] = [0 as u8; 64]
    let lp: u64 = (&list[0 as usize]) as u64
    var s_rights: [u8; 7] = "rights\0"
    var have: bool = actwire.kv_find(m, (&s_rights[0 as usize]) as u64, lp, 64)
    if !have {
        let at: u64 = find_in(meta(), action)
        if at == NONE {
            return
        }
        var i: u64 = field_in(meta(), at, 1)
        var n: u64 = 0
        while octets.ld8(meta(), i) != 9 && octets.ld8(meta(), i) != 10 && octets.ld8(meta(), i) != 0 && n < 63 {
            octets.st8(lp, n, octets.ld8(meta(), i))
            n = n + 1
            i = i + 1
        }
        octets.st8(lp, n, 0)
    }
    var a: u64 = 0
    var shown: u64 = 0
    while octets.ld8(lp, a) != 0 && shown < RIGHTS_MAX {
        var e: u64 = a
        while octets.ld8(lp, e) != 44 && octets.ld8(lp, e) != 0 {
            e = e + 1
        }
        if e > a {
            emit_right(lp + a, e - a, en)
            shown = shown + 1
        }
        a = e
        if octets.ld8(lp, a) == 44 {
            a = a + 1
        }
    }
}

fn skip_key(line: u64) -> bool {
    var s_rights: [u8; 8] = "rights=\0"
    var i: u64 = 0
    while octets.ld8((&s_rights[0 as usize]) as u64, i) != 0 {
        if octets.ld8(line, i) != octets.ld8((&s_rights[0 as usize]) as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn build(m: u64, no: u64, client: u64, action: u64, level: u64, desc: u64) {
    let en: bool = english()
    let line: u64 = find_in(reg(), action)
    actwire.ob_reset()
    actwire.ob_str(product.product())
    put(en, (&T_TIT_DE[0 as usize]) as u64, (&T_TIT_EN[0 as usize]) as u64)
    actwire.ob_ch(RS)
    if line != NONE {
        emit_phrase(reg(), m, client, action, field_in(reg(), line, pick(en, 1, 2)))
    }
    if line != NONE && octets.ld8(reg(), line) == 42 && desc != 0 && octets.ld8(desc, 0) != 0 {
        actwire.ob_ch(10)
        actwire.ob_str(desc)
    }
    emit_publisher(m, client, action, en)
    emit_rights(m, action, en)
    actwire.ob_ch(RS)
    put(en, (&T_DET_DE[0 as usize]) as u64, (&T_DET_EN[0 as usize]) as u64)
    actwire.ob_ch(10)
    put(en, (&T_REQ_DE[0 as usize]) as u64, (&T_REQ_EN[0 as usize]) as u64)
    actwire.ob_num(no)
    put(en, (&T_EXP_DE[0 as usize]) as u64, (&T_EXP_EN[0 as usize]) as u64)
    actwire.ob_ch(10)
    put(en, (&T_ACT_DE[0 as usize]) as u64, (&T_ACT_EN[0 as usize]) as u64)
    actwire.ob_str(action)
    put(en, (&T_LVL_DE[0 as usize]) as u64, (&T_LVL_EN[0 as usize]) as u64)
    actwire.ob_str(level)
    actwire.ob_ch(10)
    put(en, (&T_FRM_DE[0 as usize]) as u64, (&T_FRM_EN[0 as usize]) as u64)
    actwire.ob_str(client)
    emit_args(m, en)
    actwire.ob_ch(RS)
    put(en, (&T_YES_DE[0 as usize]) as u64, (&T_YES_EN[0 as usize]) as u64)
    actwire.ob_ch(RS)
    put(en, (&T_NO_DE[0 as usize]) as u64, (&T_NO_EN[0 as usize]) as u64)
    actwire.ob_ch(RS)
    put(en, (&T_HNT_DE[0 as usize]) as u64, (&T_HNT_EN[0 as usize]) as u64)
}
