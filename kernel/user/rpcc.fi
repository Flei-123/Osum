// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/rpcc.fi -- the test client of tools/rpc/run.sh.
//
//   rpcc                      the whole battery against rpc.a and rpc.b
//   rpcc stress <svc> <n>     n echo calls with unique payloads
//   rpcc one <svc> <text>     one call, prints the status and the data
//
// The battery prints "T<nn> ok" or "T<nn> FAIL <detail>" per check; the
// numbers are the table in docs/RPC.md / tools/rpc/run.sh.
profile kernel

import ulib
import actwire
import rpc

export { u_start }

static mut out: [u8; 4200] = [0 as u8; 4200]
static mut req: [u8; 3300] = [0 as u8; 3300]
static mut n_pass: u64 = 0
static mut n_fail: u64 = 0

fn say(p: u64) {
    actwire.out(p)
}

fn chk(n: u64, good: bool, detail: u64) {
    var t: [u8; 2] = "T\0"
    var z: [u8; 2] = "0\0"
    var s_ok: [u8; 5] = " ok\n\0"
    var s_bad: [u8; 7] = " FAIL \0"
    say((&t[0 as usize]) as u64)
    if n < 10 {
        say((&z[0 as usize]) as u64)
    }
    ulib.sayu(n)
    if good {
        say((&s_ok[0 as usize]) as u64)
        n_pass = n_pass + 1
    } else {
        say((&s_bad[0 as usize]) as u64)
        ulib.sayu(detail)
        ulib.nl()
        n_fail = n_fail + 1
    }
}

fn battery() -> u64 {
    let o: u64 = (&out[0 as usize]) as u64
    let q: u64 = (&req[0 as usize]) as u64
    var sa: [u8; 6] = "rpc.a\0"
    var sb: [u8; 6] = "rpc.b\0"
    var sn: [u8; 9] = "rpc.none\0"
    let a: u64 = (&sa[0 as usize]) as u64
    let b: u64 = (&sb[0 as usize]) as u64
    let none: u64 = (&sn[0 as usize]) as u64

    // T01 sync echo
    var m_echo: [u8; 11] = "echo hello\0"
    var w_hello: [u8; 6] = "hello\0"
    var c: u64 = rpc.call(a, (&m_echo[0 as usize]) as u64, 10, o, 4200, 2000)
    chk(1, c == 0 && rpc.last_len() == 5
        && actwire.str_eq(o, (&w_hello[0 as usize]) as u64), c)

    // T02 an error of the service with its text
    var m_fail: [u8; 5] = "fail\0"
    var w_boom: [u8; 5] = "boom\0"
    c = rpc.call(a, (&m_fail[0 as usize]) as u64, 4, o, 4200, 2000)
    chk(2, c == 7 && actwire.str_eq(o, (&w_boom[0 as usize]) as u64), c)

    // T03 unknown verb
    var m_bogus: [u8; 6] = "bogus\0"
    c = rpc.call(a, (&m_bogus[0 as usize]) as u64, 5, o, 4200, 2000)
    chk(3, c == rpc.E_NOMETHOD, c)

    // T04 no such service
    c = rpc.call(none, (&m_echo[0 as usize]) as u64, 10, o, 4200, 2000)
    chk(4, c == rpc.E_NOSVC, c)

    // T05 timeout: the answer needs 800 ms, we give 200
    var m_slow8: [u8; 9] = "slow 800\0"
    let t0: u64 = actwire.ticks()
    c = rpc.call(a, (&m_slow8[0 as usize]) as u64, 8, o, 4200, 200)
    let dt: u64 = actwire.ticks() - t0
    chk(5, c == rpc.E_TIMEOUT && dt >= 19 && dt <= 45, c * 1000 + dt)

    // T06 the late answer is dropped (counted) and does not poison the
    // next call
    let late0: u64 = rpc.stat(3)
    let t1: u64 = actwire.ticks()
    while rpc.stat(3) == late0 && actwire.ticks() - t1 < 200 {
        rpc.pump(100)
    }
    var m_after: [u8; 11] = "echo after\0"
    var w_after: [u8; 6] = "after\0"
    c = rpc.call(a, (&m_after[0 as usize]) as u64, 10, o, 4200, 2000)
    chk(6, rpc.stat(3) == late0 + 1 && c == 0
        && actwire.str_eq(o, (&w_after[0 as usize]) as u64), rpc.stat(3) - late0)

    // T07 async: the slow call to a is issued FIRST, the fast one to b
    // second; the fast one is done while the slow one still waits
    var m_slow4: [u8; 9] = "slow 400\0"
    var m_fast: [u8; 10] = "echo fast\0"
    let id1: u64 = rpc.call_async(a, (&m_slow4[0 as usize]) as u64, 8, 3000)
    let id2: u64 = rpc.call_async(b, (&m_fast[0 as usize]) as u64, 9, 3000)
    while id2 != 0 && rpc.state_of(id2) == 1 {
        rpc.pump(100)
    }
    let st1: u64 = rpc.state_of(id1)
    var w_fast: [u8; 5] = "fast\0"
    let c2: u64 = rpc.take(id2, o, 4200)
    let ok2: bool = c2 == 0 && actwire.str_eq(o, (&w_fast[0 as usize]) as u64)
    while id1 != 0 && rpc.state_of(id1) == 1 {
        rpc.pump(100)
    }
    var w_done: [u8; 10] = "slow done\0"
    let c1: u64 = rpc.take(id1, o, 4200)
    chk(7, id1 != 0 && id2 != 0 && st1 == 1 && ok2 && c1 == 0
        && actwire.str_eq(o, (&w_done[0 as usize]) as u64), st1 * 100 + c1)

    // T08 the kernel's pid is what the service sees
    var m_who: [u8; 4] = "who\0"
    var w_pid: [u8; 5] = "pid=\0"
    var me: [u8; 24] = [0 as u8; 24]
    let mp: u64 = (&me[0 as usize]) as u64
    var k: u64 = 0
    while actwire.ld8((&w_pid[0 as usize]) as u64, k) != 0 {
        actwire.st8(mp, k, actwire.ld8((&w_pid[0 as usize]) as u64, k))
        k = k + 1
    }
    k = k + ulib.digits(ulib.sys(ulib.SYS_GETPID, 0, 0, 0), mp + k)
    c = rpc.call(a, (&m_who[0 as usize]) as u64, 3, o, 4200, 2000)
    chk(8, c == 0 && actwire.str_eq(o, mp), c)

    // T09 big reply (3000 octets, 54 frames)
    var m_big3: [u8; 9] = "big 3000\0"
    c = rpc.call(a, (&m_big3[0 as usize]) as u64, 8, o, 4200, 2000)
    chk(9, c == 0 && rpc.last_len() == 3000 && actwire.ld8(o, 0) == 120
        && actwire.ld8(o, 1500) == 120 && actwire.ld8(o, 2999) == 120
        && actwire.ld8(o, 3000) == 0, rpc.last_len())

    // T10 reply over the limit: an honest E_TOOBIG, not a hang
    var m_big5: [u8; 9] = "big 5000\0"
    c = rpc.call(a, (&m_big5[0 as usize]) as u64, 8, o, 4200, 2000)
    chk(10, c == rpc.E_TOOBIG, c)

    // T11 request over the limit
    k = 0
    while k < 5 {
        actwire.st8(q, k, actwire.ld8((&m_echo[0 as usize]) as u64, k))
        k = k + 1
    }
    while k < 3000 {
        actwire.st8(q, k, 121)
        k = k + 1
    }
    c = rpc.call(a, q, 3000, o, 4200, 2000)
    chk(11, c == rpc.E_TOOBIG, c)

    // T12 eight calls in flight, the ninth is refused, all eight arrive
    var m_s1: [u8; 9] = "slow 100\0"
    var ids: [u64; 8] = [0 as u64; 8]
    var i: u64 = 0
    var all8: bool = true
    while i < 8 {
        ids[i as usize] = rpc.call_async(a, (&m_s1[0 as usize]) as u64, 8, 5000)
        if ids[i as usize] == 0 {
            all8 = false
        }
        i = i + 1
    }
    let nine: u64 = rpc.call_async(a, (&m_s1[0 as usize]) as u64, 8, 5000)
    let e9: u64 = rpc.last_error()
    var good8: u64 = 0
    i = 0
    while i < 8 {
        while rpc.state_of(ids[i as usize]) == 1 {
            rpc.pump(100)
        }
        if rpc.take(ids[i as usize], o, 4200) == 0 {
            good8 = good8 + 1
        }
        i = i + 1
    }
    chk(12, all8 && nine == 0 && e9 == rpc.E_NOSLOT && good8 == 8, good8)

    // T13 cancel: the entry is gone at once, the answer counts as late
    var m_s3: [u8; 9] = "slow 300\0"
    let idc: u64 = rpc.call_async(a, (&m_s3[0 as usize]) as u64, 8, 5000)
    let cc: u64 = rpc.cancel(idc)
    let after: u64 = rpc.state_of(idc)
    let tk: u64 = rpc.take(idc, o, 4200)
    let l1: u64 = rpc.stat(3)
    let t2: u64 = actwire.ticks()
    while rpc.stat(3) == l1 && actwire.ticks() - t2 < 150 {
        rpc.pump(100)
    }
    chk(13, idc != 0 && cc == 0 && after == 0 && tk == rpc.E_BADID
        && rpc.stat(3) == l1 + 1, rpc.stat(3) - l1)

    // T14 the service dies in the middle of a call. The kernel frees a
    // dead task's bus names only when the task is REAPED (bus.forget_task
    // from proc.reap); here nobody waits for it, so the name stays and
    // the honest answer is E_TIMEOUT at the deadline. If the name is gone
    // (reaped) the answer is E_GONE within one slice. Either way: an
    // error at the right time, never a hang, never a wrong answer.
    var m_die: [u8; 4] = "die\0"
    let t3: u64 = actwire.ticks()
    c = rpc.call(b, (&m_die[0 as usize]) as u64, 3, o, 4200, 1000)
    let d3: u64 = actwire.ticks() - t3
    chk(14, (c == rpc.E_GONE && d3 < 30) || (c == rpc.E_TIMEOUT && d3 >= 99 && d3 <= 115),
        c * 1000 + d3)

    // T15 afterwards: no service (reaped) or no answer (zombie keeps the name)
    c = rpc.call(b, (&m_echo[0 as usize]) as u64, 10, o, 4200, 500)
    chk(15, c == rpc.E_NOSVC || c == rpc.E_TIMEOUT, c)

    // T16 latency: 1000 echo calls, every answer checked
    let t4: u64 = actwire.ticks()
    var okn: u64 = 0
    i = 0
    while i < 1000 {
        c = rpc.call(a, (&m_echo[0 as usize]) as u64, 10, o, 4200, 2000)
        if c == 0 && actwire.ld8(o, 0) == 104 {
            okn = okn + 1
        }
        i = i + 1
    }
    let d4: u64 = actwire.ticks() - t4
    var s_lat: [u8; 15] = "LAT calls=1000\0"
    var s_tk: [u8; 8] = " ticks=\0"
    say((&s_lat[0 as usize]) as u64)
    say((&s_tk[0 as usize]) as u64)
    ulib.sayu(d4)
    ulib.nl()
    chk(16, okn == 1000, okn)
    return 0
}

fn stress(svc: u64, n: u64) -> u64 {
    let o: u64 = (&out[0 as usize]) as u64
    let q: u64 = (&req[0 as usize]) as u64
    var pre: [u8; 6] = "echo \0"
    var okn: u64 = 0
    var i: u64 = 0
    let me: u64 = ulib.sys(ulib.SYS_GETPID, 0, 0, 0)
    while i < n {
        var k: u64 = 0
        while k < 5 {
            actwire.st8(q, k, actwire.ld8((&pre[0 as usize]) as u64, k))
            k = k + 1
        }
        k = k + ulib.digits(me, q + k)
        actwire.st8(q, k, 45)
        k = k + 1
        k = k + ulib.digits(i, q + k)
        actwire.st8(q, k, 0)
        let c: u64 = rpc.call(svc, q, k, o, 4200, 5000)
        if c == 0 && rpc.last_len() == k - 5 && actwire.str_eq(o, q + 5) {
            okn = okn + 1
        }
        i = i + 1
    }
    var s_st: [u8; 8] = "STRESS \0"
    var s_of: [u8; 5] = " of \0"
    var s_ok: [u8; 5] = " ok\n\0"
    say((&s_st[0 as usize]) as u64)
    ulib.sayu(okn)
    say((&s_of[0 as usize]) as u64)
    ulib.sayu(n)
    say((&s_ok[0 as usize]) as u64)
    if okn == n {
        return 0
    }
    return 1
}

fn one(svc: u64, text: u64) -> u64 {
    let o: u64 = (&out[0 as usize]) as u64
    let c: u64 = rpc.call(svc, text, actwire.slen(text), o, 4200, 3000)
    var s_c: [u8; 6] = "code \0"
    say((&s_c[0 as usize]) as u64)
    ulib.sayu(c)
    ulib.nl()
    actwire.out(o)
    ulib.nl()
    return c
}

fn u_start(args: u64) -> u64 {
    var c_stress: [u8; 7] = "stress\0"
    var c_one: [u8; 4] = "one\0"
    if ulib.arg_count(args) >= 4 && actwire.str_eq(ulib.arg_at(args, 1),
        (&c_stress[0 as usize]) as u64) {
        return stress(ulib.arg_at(args, 2), ulib.to_num(ulib.arg_at(args, 3)))
    }
    if ulib.arg_count(args) >= 4 && actwire.str_eq(ulib.arg_at(args, 1),
        (&c_one[0 as usize]) as u64) {
        return one(ulib.arg_at(args, 2), ulib.arg_at(args, 3))
    }
    battery()
    var s_r: [u8; 7] = "RPCC: \0"
    var s_p: [u8; 10] = " passed, \0"
    var s_f: [u8; 9] = " failed\n\0"
    say((&s_r[0 as usize]) as u64)
    ulib.sayu(n_pass)
    say((&s_p[0 as usize]) as u64)
    ulib.sayu(n_fail)
    say((&s_f[0 as usize]) as u64)
    if n_fail == 0 {
        return 0
    }
    return 1
}
