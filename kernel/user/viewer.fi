
profile app

import libc.memcopy
import ulib
import libc.text
import lineout
import libc.io
import tools
import wlibc
import fuiapp
import fuiscene
import image
import jpeg
import gif
import xfer
import urilist
import jenc
import libc.pathname

export { u_start }

const PIXCAP: u64 = 4210688
const DATCAP: u64 = 786432
const MINIW: u64 = 64
const MININ: u64 = 12
const MAXD: u64 = 64
const ROHCAP: u64 = 65536
const KOMPCAP: u64 = 98304
const JPEG_Q: u64 = 90

static mut pix: u64 = 0
static mut dat: u64 = 0
static mut mini: u64 = 0
static mut datn: u64 = 0
static mut bw: u64 = 0
static mut bh: u64 = 0
static mut art: u64 = 0
static mut n_frames: u64 = 0
static mut roh: u64 = 0
static mut komp: u64 = 0

static mut folder: [u8; 256] = [0 as u8; 256]
static mut names: [u8; 4096] = [0 as u8; 4096]
static mut nd: u64 = 0
static mut akt: u64 = 0
static mut vollp: [u8; 512] = [0 as u8; 512]
static mut header: [u8; 256] = [0 as u8; 256]
static mut mini_da: [u64; 12] = [0; 12]

static mut w_image: u64 = 0
static mut w_header: u64 = 0
static mut w_zoom: u64 = 0
static mut w_vor: u64 = 0
static mut w_zur: u64 = 0
static mut w_fit: u64 = 0
static mut w_eins: u64 = 0
static mut w_rotate: u64 = 0
static mut w_mini: u64 = 0
static mut w_png: u64 = 0
static mut w_jpg: u64 = 0
static mut w_mid: [u64; 12] = [0; 12]
static mut modus: u64 = 0
static mut c_mini: u64 = 0
static mut c_image: u64 = 0
static mut c_bar: u64 = 0

static mut T_TITLE: [u8; 15] = "Bildbetrachter\0"
static mut T_APP: [u8; 7] = "viewer\0"
static mut T_VOR: [u8; 2] = ">\0"
static mut T_ZUR: [u8; 2] = "<\0"
static mut T_FIT: [u8; 4] = "Fit\0"
static mut T_EINS: [u8; 4] = "1:1\0"
static mut T_ROTATE: [u8; 7] = "Rotate\0"
static mut T_MINI: [u8; 11] = "Thumbnails\0"
static mut T_EINZ: [u8; 13] = "Single image\0"
static mut T_KEIN: [u8; 9] = "no image\0"
static mut S_X: [u8; 5] = " × \0"
static mut S_SP: [u8; 3] = "  \0"
static mut S_PROZ: [u8; 2] = "%\0"
static mut A_PNG: [u8; 4] = "png\0"
static mut A_BMP: [u8; 4] = "bmp\0"
static mut A_JPG: [u8; 5] = "jpeg\0"
static mut A_GIF: [u8; 4] = "gif\0"
static mut T_PNG: [u8; 4] = "PNG\0"
static mut T_JPG: [u8; 5] = "JPEG\0"

fn say(p: u64) {
    lineout.add_text(p)
}

fn nptr(i: u64) -> u64 {
    return (&names[(0) as usize]) as u64 + i * 64
}

fn map(n: u64) -> u64 {
    let p: u64 = wlibc.map_surface(n)
    if ulib.bad(p) {
        return 0
    }
    return p
}

fn kleiner(a: u64, b: u64) -> bool {
    return ulib.cmp(a, b) == 1
}

fn ist_bildname(n: u64) -> bool {
    var e_png: [u8; 4] = "png\0"
    var e_bmp: [u8; 4] = "bmp\0"
    var e_jpg: [u8; 4] = "jpg\0"
    var e_jpeg: [u8; 5] = "jpeg\0"
    var e_gif: [u8; 4] = "gif\0"
    let len: u64 = text.length(n)
    var punkt: u64 = 0
    var i: u64 = 0
    while i < len {
        if *((n + i) as *mut u8) == 46 as u8 {
            punkt = i + 1
        }
        i = i + 1
    }
    if punkt == 0 {
        return false
    }
    var kl: [u8; 16] = [0 as u8; 16]
    var k: u64 = 0
    while punkt + k < len && k < 15 {
        var c: u64 = (*((n + punkt + k) as *mut u8)) as u64
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        __mmio_write8(((&kl[(0) as usize]) as u64 + k) as *mut u8, c as u8)
        k = k + 1
    }
    __mmio_write8(((&kl[(0) as usize]) as u64 + k) as *mut u8, 0 as u8)
    let p: u64 = (&kl[(0) as usize]) as u64
    return ulib.streq(p, (&e_png[(0) as usize]) as u64)
        || ulib.streq(p, (&e_bmp[(0) as usize]) as u64)
        || ulib.streq(p, (&e_jpg[(0) as usize]) as u64)
        || ulib.streq(p, (&e_jpeg[(0) as usize]) as u64)
        || ulib.streq(p, (&e_gif[(0) as usize]) as u64)
}

fn folder_read(pfadp: u64) {
    var punkt: [u8; 2] = ".\0"
    nd = 0
    let base: u64 = pathname.base_name(pfadp)
    var n: u64 = base - pfadp
    if n > 1 {
        n = n - 1
    }
    if n == 0 {
        ulib.strcpy((&folder[(0) as usize]) as u64,
            (&punkt[(0) as usize]) as u64)
    } else {
        memcopy.copy((&folder[(0) as usize]) as u64, pfadp, n)
        __mmio_write8(((&folder[(0) as usize]) as u64 + n) as *mut u8,
            0 as u8)
    }
    let fd: u64 = io.dir_open((&folder[(0) as usize]) as u64)
    if ulib.bad(fd) {
        return
    }
    var buf: [u8; 1024] = [0 as u8; 1024]
    var next: bool = true
    while next {
        let g: u64 = io.dir_read(fd, (&buf[(0) as usize]) as u64, 1024)
        if ulib.bad(g) || g == 0 {
            next = false
        } else {
            var at: u64 = 0
            while at < g {
                let rec: u64 = (&buf[(0) as usize]) as u64 + at
                let nm: u64 = io.dir_name(rec)
                if ist_bildname(nm) && nd < MAXD {
                    ulib.strncpy(nptr(nd), nm, 60)
                    nd = nd + 1
                }
                at = at + io.dir_reclen(rec)
            }
        }
    }
    io.close(fd)
    var i: u64 = 1
    while i < nd {
        var j: u64 = i
        while j > 0 && kleiner(nptr(j), nptr(j - 1)) {
            var t: [u8; 64] = [0 as u8; 64]
            ulib.strncpy((&t[(0) as usize]) as u64, nptr(j), 62)
            ulib.strncpy(nptr(j), nptr(j - 1), 62)
            ulib.strncpy(nptr(j - 1), (&t[(0) as usize]) as u64, 62)
            j = j - 1
        }
        i = i + 1
    }
    akt = 0
    var k: u64 = 0
    while k < nd {
        if ulib.streq(nptr(k), base) {
            akt = k
        }
        k = k + 1
    }
}

fn full(i: u64) -> u64 {
    let v: u64 = (&vollp[(0) as usize]) as u64
    tools.join(v, (&folder[(0) as usize]) as u64, nptr(i))
    return v
}

fn file_read(pfadp: u64) -> u64 {
    let fd: u64 = tools.openr(pfadp)
    if ulib.bad(fd) {
        return 0
    }
    var n: u64 = 0
    var next: bool = true
    while next {
        let g: u64 = io.read(fd, dat + n, DATCAP - n)
        if ulib.bad(g) || g == 0 {
            next = false
        } else {
            n = n + g
            if n >= DATCAP {
                next = false
            }
        }
    }
    io.close(fd)
    return n
}

fn load(pfadp: u64) -> bool {
    art = 0
    bw = 0
    bh = 0
    n_frames = 0
    let n: u64 = file_read(pfadp)
    if n == 0 {
        return false
    }
    return decode(n)
}

fn decode(n: u64) -> bool {
    art = 0
    bw = 0
    bh = 0
    n_frames = 0
    datn = n
    if image.ist_png(dat, n) {
        art = 1
        if !image.png_read(dat, n, pix, PIXCAP) {
            art = 0
            return false
        }
        bw = image.width()
        bh = image.height()
        return true
    }
    if image.ist_bmp(dat, n) {
        art = 2
        if !image.bmp_read(dat, n, pix, PIXCAP) {
            art = 0
            return false
        }
        bw = image.width()
        bh = image.height()
        return true
    }
    if jpeg.ist_jpeg(dat, n) {
        art = 3
        if !jpeg.jpeg_read(dat, n, pix, PIXCAP) {
            art = 0
            return false
        }
        bw = jpeg.width()
        bh = jpeg.height()
        return true
    }
    if gif.ist_gif(dat, n) {
        art = 4
        if !gif.gif_read(dat, n, pix, PIXCAP) {
            art = 0
            return false
        }
        bw = gif.width()
        bh = gif.height()
        n_frames = gif.frames()
        return true
    }
    return false
}

fn target_path(dst: u64, source: u64, endung: u64) {
    ulib.strncpy(dst, source, 400)
    let len: u64 = text.length(dst)
    var punkt: u64 = len
    var i: u64 = 0
    while i < len {
        if *((dst + i) as *mut u8) == 46 as u8 {
            punkt = i
        }
        i = i + 1
    }
    __mmio_write8((dst + punkt) as *mut u8, 0 as u8)
    ulib.strcat(dst, endung)
}

fn save_png(pfadp: u64) -> bool {
    if art == 0 || bw == 0 || bh == 0 {
        return false
    }
    if roh == 0 || komp == 0 {
        return false
    }
    let fd: u64 = tools.openw(pfadp)
    if ulib.bad(fd) {
        return false
    }
    let ok: bool = image.png_file(fd, pix, bw, bh, roh, ROHCAP, komp,
        KOMPCAP)
    io.close(fd)
    return ok
}

fn save_jpeg(pfadp: u64) -> bool {
    if art == 0 || bw == 0 || bh == 0 {
        return false
    }
    if komp == 0 {
        return false
    }
    let n: u64 = jenc.encode(pix, bw, bh, JPEG_Q, komp, KOMPCAP)
    if n == 0 {
        return false
    }
    let fd: u64 = tools.openw(pfadp)
    if ulib.bad(fd) {
        return false
    }
    let g: u64 = io.write_all(fd, komp, n)
    io.close(fd)
    return g == n
}

static mut clip_tmp: [u8; 22] = "/tmp/viewer-clip.png\0\0"

fn clip_provider(sel: u64, mime: u64) -> u64 {
    var n: u64 = 0
    var tmp_dir: [u8; 5] = "/tmp\0"
    let _m: u64 = ulib.sys(ulib.SYS_MKDIR, (&tmp_dir[(0) as usize]) as u64, 0, 0)
    if save_png((&clip_tmp[(0) as usize]) as u64) {
        n = file_read((&clip_tmp[(0) as usize]) as u64)
    }
    let _u: u64 = ulib.sys(ulib.SYS_UNLINK, (&clip_tmp[(0) as usize]) as u64, 0, 0)
    let _f: u64 = xfer.fill(sel, mime, dat, n)
    var s_f: [u8; 21] = "viewer: clip filled \0"
    say((&s_f[(0) as usize]) as u64)
    lineout.add_unum(n)
    lineout.end_line()
    return 0
}

fn clip_copy() {
    var s_c: [u8; 21] = "viewer: clip offer \0\0"
    var s_no: [u8; 19] = "viewer: clip empty\0"
    if art == 0 {
        say((&s_no[(0) as usize]) as u64)
        lineout.end_line()
        return
    }
    xfer.provide(xfer.SEL_CLIPBOARD, clip_provider)
    let r: u64 = xfer.offer(xfer.SEL_CLIPBOARD, xfer.MIME_PNG)
    say((&s_c[(0) as usize]) as u64)
    lineout.add_unum(r)
    lineout.end_line()
}

fn clip_paste() {
    var s_p: [u8; 20] = "viewer: clip paste \0"
    var s_no: [u8; 24] = "viewer: clip paste none\0"
    var s_w: [u8; 4] = " w=\0"
    var s_h: [u8; 4] = " h=\0"
    let kinds: u64 = xfer.types(xfer.SEL_CLIPBOARD, 0)
    var ok: bool = false
    if (kinds & xfer.MIME_PNG) != 0 {
        let n: u64 = xfer.get(xfer.SEL_CLIPBOARD, 0, xfer.MIME_PNG, dat, DATCAP)
        if !ulib.bad(n) && n <= DATCAP && n > 0 {
            ok = decode(n)
        }
    } else if (kinds & (xfer.MIME_URIS | xfer.MIME_PATH)) != 0 {
        let n: u64 = xfer.get_files(xfer.SEL_CLIPBOARD, 0, (&vollp[(0) as usize]) as u64, 480)
        var one: [u8; 400] = [0 as u8; 400]
        if !ulib.bad(n) && urilist.list_next((&vollp[(0) as usize]) as u64, n, 0, (&one[(0) as usize]) as u64, 400) != 0 {
            ok = load((&one[(0) as usize]) as u64)
        }
    }
    if !ok {
        say((&s_no[(0) as usize]) as u64)
        lineout.end_line()
        return
    }
    nd = 0
    show()
    say((&s_p[(0) as usize]) as u64)
    lineout.add_unum(datn)
    say((&s_w[(0) as usize]) as u64)
    lineout.add_unum(bw)
    say((&s_h[(0) as usize]) as u64)
    lineout.add_unum(bh)
    lineout.end_line()
}

fn artname() -> u64 {
    if art == 1 {
        return (&A_PNG[(0) as usize]) as u64
    }
    if art == 2 {
        return (&A_BMP[(0) as usize]) as u64
    }
    if art == 3 {
        return (&A_JPG[(0) as usize]) as u64
    }
    if art == 4 {
        return (&A_GIF[(0) as usize]) as u64
    }
    return (&T_KEIN[(0) as usize]) as u64
}

fn reason() -> u64 {
    if art == 0 {
        if gif.err() != 0 {
            return gif.fehlertext()
        }
        if jpeg.err() != 0 {
            return jpeg.fehlertext()
        }
        return image.fehlertext()
    }
    return artname()
}

fn num_at(p: u64, v: u64) {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = text.digits(v, (&z[(0) as usize]) as u64, true)
    z[(n) as usize] = 0 as u8
    ulib.strcat(p, (&z[(0) as usize]) as u64)
}

fn header_build() {
    let k: u64 = (&header[(0) as usize]) as u64
    if nd == 0 {
        ulib.strcpy(k, (&T_KEIN[(0) as usize]) as u64)
        return
    }
    ulib.strncpy(k, nptr(akt), 60)
    ulib.strcat(k, (&S_SP[(0) as usize]) as u64)
    ulib.strcat(k, reason())
    if art != 0 {
        ulib.strcat(k, (&S_SP[(0) as usize]) as u64)
        num_at(k, bw)
        ulib.strcat(k, (&S_X[(0) as usize]) as u64)
        num_at(k, bh)
        ulib.strcat(k, (&S_SP[(0) as usize]) as u64)
        num_at(k, fuiscene.image_zoom(K_IMG))
        ulib.strcat(k, (&S_PROZ[(0) as usize]) as u64)
        if art == 4 && n_frames > 1 {
            var s_bf: [u8; 5] = "  1/\0"
            ulib.strcat(k, (&s_bf[(0) as usize]) as u64)
            num_at(k, n_frames)
        }
    }
    ulib.strcat(k, (&S_SP[(0) as usize]) as u64)
    num_at(k, akt + 1)
    ulib.strcat(k, (&S_X[(0) as usize]) as u64)
    num_at(k, nd)
}

fn mini_make(slot: u64) {
    let target: u64 = mini + slot * MINIW * MINIW * 4
    var i: u64 = 0
    while i < MINIW * MINIW {
        __mmio_write32((target + i * 4) as *mut u32, 0 as u32)
        i = i + 1
    }
    if bw == 0 || bh == 0 {
        return
    }
    var f: u64 = bw
    if bh > f {
        f = bh
    }
    var y: u64 = 0
    while y < MINIW {
        var x: u64 = 0
        while x < MINIW {
            let sx: u64 = x * f / MINIW
            let sy: u64 = y * f / MINIW
            if sx < bw && sy < bh {
                let c: u64 = (__mmio_read32((pix + (sy * bw + sx) * 4)
                    as *mut u32)) as u64
                __mmio_write32((target + (y * MINIW + x) * 4) as *mut u32,
                    c as u32)
            }
            x = x + 1
        }
        y = y + 1
    }
}

const K_IMG: u64 = 1
const K_ZUR: u64 = 2
const K_VOR: u64 = 3
const K_FIT: u64 = 4
const K_EINS: u64 = 5
const K_ROTATE: u64 = 6
const K_MINI: u64 = 7
const K_PNG: u64 = 8
const K_JPG: u64 = 9
const K_ZOOM: u64 = 10
const K_MID0: u64 = 100

fn zoom_to_slider(z: u64) -> i64 {
    var v: u64 = z
    if v < 10 {
        v = 10
    }
    if v > 800 {
        v = 800
    }
    return ((v - 10) * 1000 / 790) as i64
}

fn slider_to_zoom(v: i64) -> u64 {
    return 10 + (v as u64) * 790 / 1000
}

fn head_set() {
    header_build()
    fuiscene.refresh()
}

fn show() {
    fuiscene.image_set(K_IMG, pix, bw, bh)
    if art == 0 {
        fuiscene.image_set(K_IMG, 0, 0, 0)
    }
    fuiscene.image_fit(K_IMG)
    fuiscene.set_value(K_ZOOM, zoom_to_slider(fuiscene.image_zoom(K_IMG)))
    head_set()
}

fn open(i: u64) {
    if nd == 0 {
        return
    }
    akt = i % nd
    let _r: bool = load(full(akt))
    show()
}

fn mini_build() {
    var i: u64 = 0
    while i < MININ {
        mini_da[(i) as usize] = 0
        if i < nd {
            if load(full(i)) {
                mini_make(i)
                mini_da[(i) as usize] = 1
            }
        }
        fuiscene.image_set(K_MID0 + i,
            mini + i * MINIW * MINIW * 4, MINIW, MINIW)
        if mini_da[(i) as usize] == 0 {
            fuiscene.image_set(K_MID0 + i, 0, 0, 0)
        }
        fuiscene.image_set_zoom(K_MID0 + i, 100)
        i = i + 1
    }
    let _r: bool = load(full(akt))
    show()
}

fn build() {
    let col: usize = fuiscene.root()
    let _k: usize = fuiscene.label(col, (&header[(0) as usize]) as u64)
    if modus == 0 {
        let _b: usize = fuiscene.image(col, K_IMG, 704, 468)
    } else {
        var r: u64 = 0
        while r < 2 {
            let line_: usize = fuiscene.row(col)
            fuiscene.set_gap(line_, 8)
            var c: u64 = 0
            while c < 6 {
                let ki: u64 = K_MID0 + r * 6 + c
                let _m: usize = fuiscene.image(line_, ki, MINIW + 4, MINIW + 4)
                fuiscene.image_click(ki, true)
                c = c + 1
            }
            r = r + 1
        }
        let _sp: usize = fuiscene.space(col, 4, 468 - 2 * (MINIW + 4) - 8)
    }
    let bar: usize = fuiscene.row(col)
    fuiscene.set_gap(bar, 4)
    let b1: usize = fuiscene.button(bar, (&T_ZUR[(0) as usize]) as u64, K_ZUR)
    fuiscene.set_size(b1, 36, 36)
    fuiscene.compact(b1)
    let b2: usize = fuiscene.button(bar, (&T_VOR[(0) as usize]) as u64, K_VOR)
    fuiscene.set_size(b2, 36, 36)
    fuiscene.compact(b2)
    let b3: usize = fuiscene.button(bar, (&T_FIT[(0) as usize]) as u64, K_FIT)
    fuiscene.set_size(b3, 96, 36)
    fuiscene.compact(b3)
    let b4: usize = fuiscene.button(bar, (&T_EINS[(0) as usize]) as u64, K_EINS)
    fuiscene.set_size(b4, 56, 36)
    fuiscene.compact(b4)
    let b5: usize = fuiscene.button(bar, (&T_ROTATE[(0) as usize]) as u64, K_ROTATE)
    fuiscene.set_size(b5, 80, 36)
    fuiscene.compact(b5)
    var mt: u64 = (&T_MINI[(0) as usize]) as u64
    if modus == 1 {
        mt = (&T_EINZ[(0) as usize]) as u64
    }
    let b6: usize = fuiscene.button(bar, mt, K_MINI)
    fuiscene.set_size(b6, 112, 36)
    fuiscene.compact(b6)
    let b7: usize = fuiscene.button(bar, (&T_PNG[(0) as usize]) as u64, K_PNG)
    fuiscene.set_size(b7, 64, 36)
    fuiscene.compact(b7)
    let b8: usize = fuiscene.button(bar, (&T_JPG[(0) as usize]) as u64, K_JPG)
    fuiscene.set_size(b8, 72, 36)
    fuiscene.compact(b8)
    let sl: usize = fuiscene.slider(bar, K_ZOOM, 120, 100)
    fuiscene.set_size(sl, 120, 36)
}

fn u_gui(pfadp: u64) -> u64 {
    var s_bad: [u8; 19] = "viewer: no surface\0"
    var s_mem: [u8; 22] = "viewer: out of memory\0"
    var s_go: [u8; 14] = "viewer: ready\0"
    var s_geom: [u8; 16] = "viewer: geom w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_image: [u8; 15] = "viewer: image \0"
    pix = map(PIXCAP)
    dat = map(DATCAP)
    mini = map(MININ * MINIW * MINIW * 4)
    roh = map(ROHCAP)
    komp = map(KOMPCAP)
    if pix == 0 || dat == 0 || mini == 0 {
        say((&s_mem[(0) as usize]) as u64)
        lineout.end_line()
        return 1
    }
    folder_read(pfadp)
    let bwin: u64 = 720
    let bhin: u64 = 560
    ulib.strcpy((&header[(0) as usize]) as u64, (&T_KEIN[(0) as usize]) as u64)
    fuiapp.set_atomic(true)
    if !fuiscene.open(60, 50, bwin, bhin, (&T_TITLE[(0) as usize]) as u64,
        build) {
        say((&s_bad[(0) as usize]) as u64)
        lineout.end_line()
        return 1
    }
    fuiscene.set_app((&T_APP[(0) as usize]) as u64)
    let _k0: u64 = fuiscene.pump()
    open(akt)
    say((&s_geom[(0) as usize]) as u64)
    lineout.add_num(bwin)
    say((&s_h[(0) as usize]) as u64)
    lineout.add_num(bhin)
    lineout.end_line()
    say((&s_image[(0) as usize]) as u64)
    say((&header[(0) as usize]) as u64)
    lineout.end_line()
    let _k1: u64 = fuiscene.pump()
    var s_nm: [u8; 7] = "viewer\0"
    fuiscene.say_rects((&s_nm[(0) as usize]) as u64)
    fuiscene.say_texts()
    say((&s_go[(0) as usize]) as u64)
    lineout.end_line()

    var runden: u64 = 0
    var seen_free: u64 = fuiscene.key_free_seq()
    while fuiscene.alive() && runden < 40000000 {
        runden = runden + 1
        let id: u64 = fuiscene.pump()
        if fuiscene.key_free_seq() != seen_free {
            seen_free = fuiscene.key_free_seq()
            let kf: u64 = fuiscene.key_free()
            if kf == 3 {
                clip_copy()
            } else if kf == 22 {
                clip_paste()
            }
        }
        if id == K_ZOOM {
            fuiscene.image_set_zoom(K_IMG, slider_to_zoom(fuiscene.value_of(K_ZOOM)))
            head_set()
        } else if id >= K_MID0 && id < K_MID0 + MININ {
            let k: u64 = id - K_MID0
            if k < nd {
                modus = 0
                fuiscene.refresh()
                fuiscene.build_now()
                open(k)
            }
        } else if id == K_VOR {
            open(akt + 1)
        } else if id == K_ZUR {
            if akt == 0 {
                open(nd - 1)
            } else {
                open(akt - 1)
            }
        } else if id == K_FIT {
            fuiscene.image_fit(K_IMG)
            fuiscene.set_value(K_ZOOM, zoom_to_slider(fuiscene.image_zoom(K_IMG)))
            head_set()
        } else if id == K_EINS {
            fuiscene.image_set_zoom(K_IMG, 100)
            fuiscene.set_value(K_ZOOM, zoom_to_slider(100))
            head_set()
        } else if id == K_ROTATE {
            fuiscene.image_rotate(K_IMG, 1)
            fuiscene.image_fit(K_IMG)
            fuiscene.set_value(K_ZOOM, zoom_to_slider(fuiscene.image_zoom(K_IMG)))
            head_set()
        } else if id == K_PNG {
            var e_p: [u8; 5] = ".png\0"
            var s_sv: [u8; 13] = "viewer: save\0"
            var s_no: [u8; 16] = "viewer: save no\0"
            target_path((&vollp[(0) as usize]) as u64, full(akt),
                (&e_p[(0) as usize]) as u64)
            if save_png((&vollp[(0) as usize]) as u64) {
                say((&s_sv[(0) as usize]) as u64)
            } else {
                say((&s_no[(0) as usize]) as u64)
            }
            say((&vollp[(0) as usize]) as u64)
            lineout.end_line()
        } else if id == K_JPG {
            var e_j: [u8; 5] = ".jpg\0"
            var s_sv2: [u8; 13] = "viewer: save\0"
            var s_no2: [u8; 16] = "viewer: save no\0"
            target_path((&vollp[(0) as usize]) as u64, full(akt),
                (&e_j[(0) as usize]) as u64)
            if save_jpeg((&vollp[(0) as usize]) as u64) {
                say((&s_sv2[(0) as usize]) as u64)
            } else {
                say((&s_no2[(0) as usize]) as u64)
            }
            say((&vollp[(0) as usize]) as u64)
            lineout.end_line()
        } else if id == K_MINI {
            if modus == 0 {
                modus = 1
                fuiscene.refresh()
                fuiscene.build_now()
                mini_build()
            } else {
                modus = 0
                fuiscene.refresh()
                fuiscene.build_now()
                show()
            }
        }
    }
    xfer.flush()
    return 0
}

static mut hexz: [u8; 17] = "0123456789abcdef\0"

fn hex6(v: u64) {
    var t: [u8; 8] = [0 as u8; 8]
    var k: u64 = 6
    var x: u64 = v
    while k > 0 {
        k = k - 1
        __mmio_write8(((&t[(0) as usize]) as u64 + k) as *mut u8,
            *(((&hexz[(0) as usize]) as u64 + (x & 15)) as *mut u8))
        x = x >> 4
    }
    __mmio_write8(((&t[(0) as usize]) as u64 + 6) as *mut u8, 0 as u8)
    say((&t[(0) as usize]) as u64)
}

fn point_say(x: u64, y: u64) {
    var s_p: [u8; 2] = " \0"
    say((&s_p[(0) as usize]) as u64)
    lineout.add_num(x)
    var s_k: [u8; 2] = ",\0"
    say((&s_k[(0) as usize]) as u64)
    lineout.add_num(y)
    var s_g: [u8; 2] = "=\0"
    say((&s_g[(0) as usize]) as u64)
    let c: u64 = (__mmio_read32((pix + (y * bw + x) * 4) as *mut u32))
        as u64
    hex6(c & 0xFFFFFF)
}

fn u_info(pfadp: u64) -> u64 {
    var s_art: [u8; 13] = "viewer: art=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_sum: [u8; 13] = "viewer: sum \0"
    var s_px: [u8; 11] = "viewer: px\0"
    var s_no: [u8; 21] = "viewer: geht nicht: \0"
    var s_mem: [u8; 22] = "viewer: out of memory\0"
    pix = map(PIXCAP)
    dat = map(DATCAP)
    if pix == 0 || dat == 0 {
        say((&s_mem[(0) as usize]) as u64)
        lineout.end_line()
        return 1
    }
    var s_file: [u8; 14] = "viewer: file \0"
    say((&s_file[(0) as usize]) as u64)
    say(pathname.base_name(pfadp))
    lineout.end_line()
    if !load(pfadp) {
        say((&s_no[(0) as usize]) as u64)
        say(reason())
        lineout.end_line()
        return 1
    }
    say((&s_art[(0) as usize]) as u64)
    say(artname())
    say((&s_w[(0) as usize]) as u64)
    lineout.add_num(bw)
    say((&s_h[(0) as usize]) as u64)
    lineout.add_num(bh)
    if art == 4 {
        var s_f: [u8; 9] = " bilder=\0"
        say((&s_f[(0) as usize]) as u64)
        lineout.add_num(n_frames)
    }
    lineout.end_line()
    var sr: u64 = 0
    var sg: u64 = 0
    var sb: u64 = 0
    var i: u64 = 0
    while i < bw * bh {
        let c: u64 = (__mmio_read32((pix + i * 4) as *mut u32)) as u64
        sr = sr + ((c >> 16) & 255)
        sg = sg + ((c >> 8) & 255)
        sb = sb + (c & 255)
        i = i + 1
    }
    say((&s_sum[(0) as usize]) as u64)
    lineout.add_num(sr)
    say((&s_w[(0) as usize]) as u64)
    lineout.add_num(sg)
    say((&s_h[(0) as usize]) as u64)
    lineout.add_num(sb)
    lineout.end_line()
    say((&s_px[(0) as usize]) as u64)
    point_say(0, 0)
    point_say(bw - 1, 0)
    point_say(0, bh - 1)
    point_say(bw - 1, bh - 1)
    point_say(bw / 2, bh / 2)
    lineout.end_line()
    return 0
}

fn ends_with(p: u64, e: u64) -> bool {
    let lp: u64 = text.length(p)
    let le: u64 = text.length(e)
    if le > lp {
        return false
    }
    var i: u64 = 0
    while i < le {
        var a: u64 = (*((p + lp - le + i) as *mut u8)) as u64
        let b: u64 = (*((e + i) as *mut u8)) as u64
        if a >= 65 && a <= 90 {
            a = a + 32
        }
        if a != b {
            return false
        }
        i = i + 1
    }
    return true
}

fn u_save(zielp: u64, quellp: u64) -> u64 {
    var s_mem: [u8; 22] = "viewer: out of memory\0"
    var s_no: [u8; 21] = "viewer: geht nicht: \0"
    var s_ok: [u8; 13] = "viewer: save\0"
    var s_bad: [u8; 24] = "viewer: save no, target\0"
    var s_w: [u8; 4] = " w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_n: [u8; 4] = " n=\0"
    var e_png: [u8; 5] = ".png\0"
    var e_jpg: [u8; 5] = ".jpg\0"
    var e_jpeg: [u8; 6] = ".jpeg\0"
    pix = map(PIXCAP)
    dat = map(DATCAP)
    roh = map(ROHCAP)
    komp = map(KOMPCAP)
    if pix == 0 || dat == 0 || roh == 0 || komp == 0 {
        say((&s_mem[(0) as usize]) as u64)
        lineout.end_line()
        return 1
    }
    if !load(quellp) {
        say((&s_no[(0) as usize]) as u64)
        say(reason())
        lineout.end_line()
        return 1
    }
    var gut: bool = false
    var wiejpeg: bool = false
    if ends_with(zielp, (&e_png[(0) as usize]) as u64) {
        gut = save_png(zielp)
    } else if ends_with(zielp, (&e_jpg[(0) as usize]) as u64)
        || ends_with(zielp, (&e_jpeg[(0) as usize]) as u64) {
        wiejpeg = true
        gut = save_jpeg(zielp)
    } else {
        say((&s_bad[(0) as usize]) as u64)
        lineout.end_line()
        return 2
    }
    if !gut {
        say((&s_bad[(0) as usize]) as u64)
        lineout.end_line()
        return 1
    }
    say((&s_ok[(0) as usize]) as u64)
    var s_sp: [u8; 2] = " \0"
    say((&s_sp[(0) as usize]) as u64)
    say(pathname.base_name(zielp))
    say((&s_sp[(0) as usize]) as u64)
    say(artname())
    say((&s_w[(0) as usize]) as u64)
    lineout.add_num(bw)
    say((&s_h[(0) as usize]) as u64)
    lineout.add_num(bh)
    if wiejpeg {
        say((&s_n[(0) as usize]) as u64)
        lineout.add_num(JPEG_Q)
    }
    lineout.end_line()
    return 0
}

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 38] = "viewer: viewer [-i|-s <ziel>] <datei>\0"
    var s_i: [u8; 3] = "-i\0"
    var s_s: [u8; 3] = "-s\0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.esay_line((&s_use[(0) as usize]) as u64, 0)
        return 2
    }
    if ulib.streq(ulib.arg_at(args, 1), (&s_i[(0) as usize]) as u64) {
        if argc < 3 {
            ulib.esay_line((&s_use[(0) as usize]) as u64, 0)
            return 2
        }
        return u_info(ulib.arg_at(args, 2))
    }
    if ulib.streq(ulib.arg_at(args, 1), (&s_s[(0) as usize]) as u64) {
        if argc < 4 {
            ulib.esay_line((&s_use[(0) as usize]) as u64, 0)
            return 2
        }
        return u_save(ulib.arg_at(args, 2), ulib.arg_at(args, 3))
    }
    return u_gui(ulib.arg_at(args, 1))
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
