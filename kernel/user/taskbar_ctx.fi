// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/taskbar_ctx.fi -- THE TASK BAR'S CONTEXT MENU (split out of taskbar.fi; menus come from kernel/user/ctxreg.fi).
//
// WHAT LIVES HERE. The life cycle of the bar's right-click menu: which context is open (empty bar, pinned program, window
// button), the scene popup menu (uikit/uipopmenu), its event pump, and the registration of the bar's built-in rows in the registry.
// WHAT STAYS IN taskbar.fi. Everything that needs the bar's data: starting a pinned program, minimising a window, pinning a
// button. `step` only says WHICH action was chosen (and `picked_ctx` / `picked_arg` say for what); taskbar.fi carries it out.
//
// Window buttons offer MINIMISE (WA_HIDE) and PIN; there is no "close" because the kernel has no WA_CLOSE for foreign windows
// (kernel/sys.fi WM_ACT) and a row that does nothing would be a lie.

profile app

import fuiapp.hosthead
import ulib
import uikit.uipopmenu
import msg
import ctxreg
import uikit.menuicons
import jumplist
import taskbar.tbbase
import icons
import fuiapp.apphost
import lineout

export {
    ACT_TASKMGR, ACT_SETTINGS, ACT_DISPLAY, ACT_TASKBAR_SETTINGS, NONE, DISMISSED,
    init, open_pin, open_button, open_empty, is_open, rows, step, picked_ctx, picked_arg, picked_app, run_common
}

const ACT_TASKMGR: u64 = 10
const ACT_SETTINGS: u64 = 11
const ACT_DISPLAY: u64 = 12
const ACT_TASKBAR_SETTINGS: u64 = 13
const NONE: u64 = 0xFFFFFFFFFFFFFFFF
const DISMISSED: u64 = 0xFFFFFFFFFFFFFFFE

static mut c_open: u64 = 0
static mut c_ctx: u64 = 0
static mut c_arg: u64 = 0
static mut c_inited: u64 = 0
static mut c_rows: u64 = 0
static mut c_app: [u8; 24] = [0 as u8; 24]
static mut s_jump: [u8; 21] = "taskbar: jumplist n=\0"
static mut s_jx: [u8; 4] = " x=\0"
static mut s_jy: [u8; 4] = " y=\0"
static mut s_jw: [u8; 4] = " w=\0"
static mut s_jh: [u8; 4] = " h=\0"

// catalogue keys of the rows
static mut k_tm: [u8; 17] = "ctx.task_manager\0"
static mut k_disp: [u8; 12] = "ctx.display\0"
static mut k_tbset: [u8; 21] = "ctx.taskbar_settings\0"
static mut k_set: [u8; 13] = "ctx.settings\0"

static mut p_settings: [u8; 14] = "/bin/settings\0"
static mut a_settings: [u8; 9] = "settings\0"
static mut a_page1: [u8; 7] = "page=1\0"
static mut a_page20: [u8; 8] = "page=20\0"
static mut p_taskmgr: [u8; 14] = "/bin/taskmgr\0\0"

// Register the bar's rows once (the registry would ignore a second call anyway).
fn init() {
    if c_inited != 0 {
        return
    }
    c_inited = 1
    ctxreg.addi(ctxreg.CTX_TASKBAR, (&k_tm[0 as usize]) as u64, ACT_TASKMGR, 0, menuicons.TASK_MANAGER, 0)
    ctxreg.addi(ctxreg.CTX_TASKBAR, (&k_tbset[0 as usize]) as u64, ACT_TASKBAR_SETTINGS, 0, menuicons.SETTINGS, 0)
}

fn anchor_y() -> u64 {
    if tbbase.vertical == 0 && tbbase.bar_y * 2 > tbbase.sh {
        return tbbase.bar_y
    }
    return hosthead.mouse_y()
}

fn open_ctx(ctx: u64, arg: u64) -> bool {
    init()
    if c_open != 0 {
        let _d: u64 = step()
    }
    let n: u64 = ctxreg.build(ctx, 0)
    if n == 0 {
        return false
    }
    if !uipopmenu.open(hosthead.mouse_x(), anchor_y(), ctxreg.text_nul(), n) {
        return false
    }
    c_ctx = ctx
    c_arg = arg
    c_open = 1
    c_rows = n
    return true
}

fn open_jump(ctx: u64, arg: u64, app: u64, pinned: bool, running: bool) -> bool {
    init()
    if c_open != 0 {
        let _d: u64 = step()
    }
    let _s: u64 = ulib.strncpy((&c_app[0 as usize]) as u64, app, 23)
    c_app[23 as usize] = 0 as u8
    let n: u64 = jumplist.fill(ctx, (&c_app[0 as usize]) as u64, pinned, running)
    if n == 0 {
        return false
    }
    uipopmenu.set_head(jumplist.header_label((&c_app[0 as usize]) as u64), apphost.ICON_TAG | icons.VAULT_APP)
    if !uipopmenu.open(hosthead.mouse_x(), anchor_y(), ctxreg.text_nul(), n) {
        return false
    }
    c_ctx = ctx
    c_arg = arg
    c_open = 1
    c_rows = n
    log_jump(n)
    return true
}

fn log_jump(n: u64) {
    let _a: u64 = lineout.add_text((&s_jump[0 as usize]) as u64)
    lineout.add_num(n)
    let _b: u64 = lineout.add_text((&s_jx[0 as usize]) as u64)
    lineout.add_num(uipopmenu.x())
    let _c: u64 = lineout.add_text((&s_jy[0 as usize]) as u64)
    lineout.add_num(uipopmenu.y())
    let _d: u64 = lineout.add_text((&s_jw[0 as usize]) as u64)
    lineout.add_num(uipopmenu.w())
    let _e: u64 = lineout.add_text((&s_jh[0 as usize]) as u64)
    lineout.add_num(uipopmenu.h())
    lineout.end_line()
}

// pg = 0-based index of the pin
fn open_pin(pg: u64, app: u64, running: bool) -> bool {
    return open_jump(ctxreg.CTX_TASKBAR_PIN, pg, app, true, running)
}

// m = 1-based index of the window button
fn open_button(m: u64, app: u64, pinned: bool) -> bool {
    return open_jump(ctxreg.CTX_WINDOW_BTN, m, app, pinned, true)
}

fn picked_app() -> u64 {
    return (&c_app[0 as usize]) as u64
}

// right click on the empty part of the bar
fn open_empty() -> bool {
    return open_ctx(ctxreg.CTX_TASKBAR, 0)
}

fn rows() -> u64 {
    return c_rows
}

fn is_open() -> bool {
    return c_open != 0
}

fn picked_ctx() -> u64 {
    return c_ctx
}

fn picked_arg() -> u64 {
    return c_arg
}

// Once per round while the menu is open. NONE = still waiting, DISMISSED = closed without a choice, else the action id.
fn step() -> u64 {
    if c_open == 0 {
        return NONE
    }
    let r: u64 = uipopmenu.step()
    if r == uipopmenu.NONE {
        return NONE
    }
    c_open = 0
    if r == uipopmenu.DISMISSED {
        return DISMISSED
    }
    let a: u64 = ctxreg.act_at(r)
    if a == ctxreg.NONE {
        return DISMISSED
    }
    return a
}

fn open_settings(page_arg: u64) {
    var argv: [u64; 4] = [0 as u64; 4]
    argv[0 as usize] = (&a_settings[0 as usize]) as u64
    var argc: u64 = 1
    if page_arg != 0 {
        argv[1 as usize] = page_arg
        argc = 2
    }
    let _pid: u64 = ulib.sys(ulib.SYS_EXEC, (&p_settings[0 as usize]) as u64, (&argv[0 as usize]) as u64, argc)
}

// The actions that need nothing of the bar's data: start a program (task manager, settings, display, manifest entries).
// True = it was one of those.
fn run_common(act: u64) -> bool {
    if act == ACT_TASKMGR {
        let _p: u64 = ulib.spawn_app((&p_taskmgr[0 as usize]) as u64, 0, 0)
        return true
    }
    if act == ACT_SETTINGS {
        open_settings(0)
        return true
    }
    if act == ACT_DISPLAY {
        open_settings((&a_page1[0 as usize]) as u64)
        return true
    }
    if act == ACT_TASKBAR_SETTINGS {
        open_settings((&a_page20[0 as usize]) as u64)
        return true
    }
    if ctxreg.is_ext(act) {
        let _e: u64 = ctxreg.run_ext(act)
        return true
    }
    return false
}
