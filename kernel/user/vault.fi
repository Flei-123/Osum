
profile kernel

import ulib
import libc.text
import libc.io
import libc.errno
import crypto.sha256
import sync.chain
import kbund
import libc.octets

export { u_start }

const PATHMAX: u64 = 256
const NAMEMAX: u64 = 22
const WERTMAX: u64 = 512
const SYS_GETRANDOM: u64 = 318

static mut z_vault: [u8; 256] = [0 as u8; 256]
static mut sitkey: [u8; 32] = [0 as u8; 32]
static mut tkey: [u8; 32] = [0 as u8; 32]
static mut puf: [u8; 1024] = [0 as u8; 1024]
static mut puf2: [u8; 1024] = [0 as u8; 1024]
static mut hexb: [u8; 512] = [0 as u8; 512]

fn emit(t: u64) {
    ulib.say(t)
    ulib.nl()
}

fn say_kt(t: u64, v: u64) {
    ulib.say(t)
    ulib.say(v)
    ulib.nl()
}

fn say_kv(t: u64, v: u64) {
    ulib.say(t)
    ulib.sayn(v)
    ulib.nl()
}

fn tdatei(name: u64) -> u64 {
    return kbund.path2((&z_vault[0]) as u64, name)
}

static mut sitp: [u8; 19] = "/system/tresor.sit\0"

fn sitpfad() -> u64 {
    return (&sitp[0]) as u64
}

fn text_read(path: u64, out: u64, max: u64, len: *mut u64) -> bool {
    let fd: u64 = io.open(path, 0)
    if ulib.bad(fd) {
        *len = 0
        return false
    }
    let n: u64 = io.read_full(fd, out, max)
    io.close(fd)
    if ulib.bad(n) {
        *len = 0
        return false
    }
    *len = n
    return true
}

fn text_write(path: u64, p: u64, n: u64) -> bool {
    let fd: u64 = io.create(path)
    if ulib.bad(fd) {
        return false
    }
    let ok: bool = !ulib.bad(io.write_all(fd, p, n))
    io.fsync(fd)
    io.close(fd)
    return ok
}

fn sitkey_get(make: bool) -> bool {
    var l: u64 = 0
    if text_read(sitpfad(), (&sitkey[0]) as u64, 32, &l) {
        if l == 32 {
            return true
        }
    }
    if !make {
        return false
    }
    if ulib.bad(ulib.sys(SYS_GETRANDOM, (&sitkey[0]) as u64, 32, 0)) {
        return false
    }
    if !text_write(sitpfad(), (&sitkey[0]) as u64, 32) {
        return false
    }
    return true
}

static mut session_old: [u8; 8] = "SITZUNG\0"

static mut session_new: [u8; 8] = "SESSION\0"

fn session_unlink_all() {
    io.unlink(tdatei((&session_new[0]) as u64))
    io.unlink(tdatei((&session_old[0]) as u64))
}

fn session_write(bis: u64) -> bool {
    var nonce: [u8; 24] = [0 as u8; 24]
    if ulib.bad(ulib.sys(SYS_GETRANDOM, (&nonce[0]) as u64, 24, 0)) {
        return false
    }
    var siegel: [u8; 48] = [0 as u8; 48]
    chain.envelope_write((&sitkey[0]) as u64, (&nonce[0]) as u64,
        (&tkey[0]) as u64, (&siegel[0]) as u64)
    let bp: u64 = (&puf[0]) as u64
    var at: u64 = kbund.num_out(bp, bis)
    octets.st8(bp, at, 32)
    at = at + 1
    kbund.hex_out((&nonce[0]) as u64, 24, bp + at)
    at = at + 48
    octets.st8(bp, at, 32)
    at = at + 1
    kbund.hex_out((&siegel[0]) as u64, 48, bp + at)
    at = at + 96
    octets.st8(bp, at, 10)
    at = at + 1
    io.unlink(tdatei((&session_old[0]) as u64))
    return text_write(tdatei((&session_new[0]) as u64), bp, at)
}

fn session_read() -> u64 {
    var l: u64 = 0
    if !text_read(tdatei((&session_new[0]) as u64), (&puf[0]) as u64, 1000, &l)
        && !text_read(tdatei((&session_old[0]) as u64), (&puf[0]) as u64, 1000, &l) {
        return 0
    }
    let bp: u64 = (&puf[0]) as u64
    let bis: u64 = kbund.num_in(bp)
    var at: u64 = 0
    while at < l && octets.ld8(bp, at) != 32 {
        at = at + 1
    }
    at = at + 1
    var nonce: [u8; 24] = [0 as u8; 24]
    var siegel: [u8; 48] = [0 as u8; 48]
    if !kbund.hex_in(bp + at, 24, (&nonce[0]) as u64) {
        return 0
    }
    at = at + 49
    if !kbund.hex_in(bp + at, 48, (&siegel[0]) as u64) {
        return 0
    }
    if io.now_sec() > bis {
        session_unlink_all()
        return 2
    }
    if !sitkey_get(false) {
        return 3
    }
    if !chain.envelope_read((&sitkey[0]) as u64, (&nonce[0]) as u64,
        (&siegel[0]) as u64, (&tkey[0]) as u64) {
        return 3
    }
    return 1
}

fn gname(name: u64, out: u64) -> bool {
    var before: [u8; 3] = "G-\0"
    if text.length(name) > NAMEMAX {
        return false
    }
    ulib.strcpy(out, (&before[0]) as u64)
    ulib.strcat(out, name)
    return true
}

fn place(name: u64, value: u64) -> bool {
    var gn: [u8; 32] = [0 as u8; 32]
    if !gname(name, (&gn[0]) as u64) {
        return false
    }
    let wl: u64 = text.length(value)
    if wl == 0 || wl > WERTMAX {
        return false
    }
    var nonce: [u8; 24] = [0 as u8; 24]
    if ulib.bad(ulib.sys(SYS_GETRANDOM, (&nonce[0]) as u64, 24, 0)) {
        return false
    }
    let n: u64 = chain.secret_seal((&tkey[0]) as u64, (&nonce[0]) as u64,
        name, text.length(name), value, wl, (&puf2[0]) as u64)
    if n == 0 {
        return false
    }
    let bp: u64 = (&puf[0]) as u64
    kbund.hex_out((&nonce[0]) as u64, 24, bp)
    var at: u64 = 48
    octets.st8(bp, at, 32)
    at = at + 1
    kbund.hex_out((&puf2[0]) as u64, n, bp + at)
    at = at + n * 2
    octets.st8(bp, at, 10)
    at = at + 1
    return text_write(tdatei((&gn[0]) as u64), bp, at)
}

fn give(name: u64) -> bool {
    var gn: [u8; 32] = [0 as u8; 32]
    if !gname(name, (&gn[0]) as u64) {
        return false
    }
    var l: u64 = 0
    if !text_read(tdatei((&gn[0]) as u64), (&puf[0]) as u64, 1000, &l) {
        return false
    }
    let bp: u64 = (&puf[0]) as u64
    var nonce: [u8; 24] = [0 as u8; 24]
    if !kbund.hex_in(bp, 24, (&nonce[0]) as u64) {
        return false
    }
    var at: u64 = 49
    var hn: u64 = 0
    while at + hn < l && octets.ld8(bp, at + hn) != 10 && octets.ld8(bp, at + hn) != 0 {
        hn = hn + 1
    }
    if hn % 2 != 0 || hn / 2 > 900 {
        return false
    }
    if !kbund.hex_in(bp + at, hn / 2, (&puf2[0]) as u64) {
        return false
    }
    var got: u64 = 0
    var klar: [u8; 600] = [0 as u8; 600]
    if !chain.secret_open((&tkey[0]) as u64, (&nonce[0]) as u64,
        name, text.length(name), (&puf2[0]) as u64, hn / 2,
        (&klar[0]) as u64, &got) {
        return false
    }
    io.write_all(1, (&klar[0]) as u64, got)
    var nl: [u8; 2] = "\n\0"
    io.write_all(1, (&nl[0]) as u64, 1)
    var i: u64 = 0
    while i < got {
        octets.st8((&klar[0]) as u64, i, 0)
        i = i + 1
    }
    return true
}

fn list() {
    var dot: [u8; 2] = ".\0"
    var dotdot: [u8; 3] = "..\0"
    var db: [u8; 1024] = [0 as u8; 1024]
    let fd: u64 = io.dir_open((&z_vault[0]) as u64)
    if ulib.bad(fd) {
        return
    }
    var next: bool = true
    while next {
        let n: u64 = io.dir_read(fd, (&db[0]) as u64, 1024)
        if n == 0 || ulib.bad(n) {
            next = false
            continue
        }
        var at: u64 = 0
        while at < n {
            let rec: u64 = (&db[0]) as u64 + at
            let nm: u64 = io.dir_name(rec)
            at = at + io.dir_reclen(rec)
            if ulib.streq(nm, (&dot[0]) as u64) {
                continue
            }
            if ulib.streq(nm, (&dotdot[0]) as u64) {
                continue
            }
            if octets.ld8(nm, 0) == 71 && octets.ld8(nm, 1) == 45 {
                emit(nm + 2)
            }
        }
    }
    io.close(fd)
}

fn hilfe() {
    var h1: [u8; 34] = "vault new    <account> <v> <pass>\0"
    var h2: [u8; 44] = "vault open   <account> <v> <pass> <timeout>\0"
    var h3: [u8; 17] = "vault close  <v>\0"
    var h4: [u8; 32] = "vault put    <v> <name> <value>\0"
    var h5: [u8; 24] = "vault get    <v> <name>\0"
    var h6: [u8; 17] = "vault list   <v>\0"
    emit((&h1[0]) as u64)
    emit((&h2[0]) as u64)
    emit((&h3[0]) as u64)
    emit((&h4[0]) as u64)
    emit((&h5[0]) as u64)
    emit((&h6[0]) as u64)
}

fn u_start(args: u64) -> u64 {
    var c_new: [u8; 4] = "new\0"
    var c_auf: [u8; 5] = "open\0"
    var c_zu: [u8; 6] = "close\0"
    var c_put: [u8; 4] = "put\0"
    var c_get: [u8; 4] = "get\0"
    var c_list: [u8; 5] = "list\0"
    var t_pass: [u8; 42] = "vault: wrong passphrase -- nothing opened\0"
    var t_auf: [u8; 13] = "vault: open \0"
    var t_zu: [u8; 14] = "vault: closed\0"
    var t_deadline: [u8; 31] = "vault: the timeout has expired\0"
    var t_kein: [u8; 23] = "vault: no open session\0"
    var t_recht: [u8; 41] = "vault: no right on the session key -- no\0"
    var t_ok: [u8; 14] = "vault: stored\0"
    var t_bad: [u8; 29] = "vault: no such secret (or it\0"
    var t_bad2: [u8; 36] = "is not genuine) -- nothing returned\0"

    let n: u64 = ulib.arg_count(args)
    if n < 3 {
        hilfe()
        return 1
    }
    let a1: u64 = ulib.arg_at(args, 1)

    if ulib.streq(a1, (&c_new[0]) as u64) || ulib.streq(a1, (&c_auf[0]) as u64) {
        if n < 5 {
            hilfe()
            return 1
        }
        let account: u64 = ulib.arg_at(args, 2)
        ulib.strncpy((&z_vault[0]) as u64, ulib.arg_at(args, 3), PATHMAX)
        let pw: u64 = ulib.arg_at(args, 4)
        var deadline: u64 = 300
        if n >= 6 {
            deadline = kbund.num_in(ulib.arg_at(args, 5))
        }
        if !kbund.kb_open(account, pw, text.length(pw)) {
            emit((&t_pass[0]) as u64)
            return 2
        }
        var i: u64 = 0
        while i < 32 {
            octets.st8((&tkey[0]) as u64, i, octets.ld8(kbund.kb_key(chain.K_VAULT), i))
            i = i + 1
        }
        kbund.kb_close()
        io.make_dir((&z_vault[0]) as u64)
        if !sitkey_get(true) {
            emit((&t_recht[0]) as u64)
            return 3
        }
        if !session_write(io.now_sec() + deadline) {
            return 3
        }
        say_kv((&t_auf[0]) as u64, deadline)
        return 0
    }

    ulib.strncpy((&z_vault[0]) as u64, ulib.arg_at(args, 2), PATHMAX)

    if ulib.streq(a1, (&c_zu[0]) as u64) {
        session_unlink_all()
        emit((&t_zu[0]) as u64)
        return 0
    }

    if ulib.streq(a1, (&c_list[0]) as u64) {
        list()
        return 0
    }

    let st: u64 = session_read()
    if st == 2 {
        emit((&t_deadline[0]) as u64)
        return 4
    }
    if st == 3 {
        emit((&t_recht[0]) as u64)
        return 5
    }
    if st == 0 {
        emit((&t_kein[0]) as u64)
        return 6
    }

    if ulib.streq(a1, (&c_put[0]) as u64) {
        if n < 5 {
            hilfe()
            return 1
        }
        if !place(ulib.arg_at(args, 3), ulib.arg_at(args, 4)) {
            return 7
        }
        emit((&t_ok[0]) as u64)
        return 0
    }

    if ulib.streq(a1, (&c_get[0]) as u64) {
        if n < 4 {
            hilfe()
            return 1
        }
        if !give(ulib.arg_at(args, 3)) {
            emit((&t_bad[0]) as u64)
            emit((&t_bad2[0]) as u64)
            return 8
        }
        return 0
    }

    hilfe()
    return 1
}
