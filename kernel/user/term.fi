// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/term.fi -- ONE MORE TERMINAL WINDOW.
//
// Until 27.09.2026 OrientOS had exactly one terminal: the console window
// the kernel opens at boot. "Terminal" in the start menu started /bin/sh,
// which attached to that same console -- a second prompt in the old
// window, no new window. With a program running in the foreground
// (Justin's `jarvisd -v` on the Dell 9020) there was nowhere left to
// type.
//
// This program asks the kernel for a new terminal window with its own
// tty (SYS_OSUM_TERMNEW, kernel/sys/sys.fi `do_termnew`), which becomes
// our controlling terminal, and then replaces itself with /bin/sh. The
// shell and everything it starts inherit the tty. Closing the window
// ends the input; the shell says "bye" and exits.
//
// If the kernel cannot open a window (no desktop, all slots taken) the
// shell still starts -- on the console, exactly as before.
//
// r543 (Dell, 11.10.2026): CONSOLE APPS GET THEIR OWN WINDOW TOO. The
// "Editor" bundle starts /bin/edit, a program for a tty. Started from the
// start menu it had no tty of its own and wrote into the boot terminal
// window ("edit New file" on top of the shell). A bundle of such a program
// (`console.txt`, tools/k15/bundle.py) is now a SCRIPT whose first line is
// `#!/bin/term -c/bin/edit`: the kernel runs `/bin/term -c/bin/edit
// /apps/editor.osp/start [args]`, term opens the window and runs the
// program named after `-c` instead of the shell. argv[2] is the script's own
// path (shebang rule) and is NOT passed on; the rest is.

profile kernel

import ulib

export { u_start }

const SYS_OSUM_TERMNEW: u64 = 1103
const SYS_EXECVE: u64 = 59
const SYS_EXIT: u64 = 60
const ENOSYS_NEG: u64 = 0xFFFFFFFFFFFFFFDA // -38: no window server, the console is all there is

fn u_start(args: u64) -> u64 {
    var e_win: [u8; 40] = "term: no new window, using the console\0\0"
    var e_full: [u8; 49] = "term: no free terminal slot, close a terminal\0\0\0\0"
    var path: [u8; 8] = "/bin/sh\0"
    // LCSH: on images where /bin/sh is busybox the Osum shell is /bin/osh; try it first, /bin/sh stays the fallback
    var path_osh: [u8; 9] = "/bin/osh\0"
    var a0: [u8; 3] = "sh\0"
    var argv: [u64; 8] = [0; 8]
    var prog: u64 = (&path[0]) as u64
    var nargs: u64 = 1
    argv[0] = (&a0[0]) as u64
    // `-c<program>`: run that program instead of the shell (console app bundles)
    let argc: u64 = ulib.arg_count(args)
    if argc > 1 {
        let a1: u64 = ulib.arg_at(args, 1)
        if *(a1 as *mut u8) == 45 && *((a1 + 1) as *mut u8) == 99 && *((a1 + 2) as *mut u8) != 0 {
            prog = a1 + 2
            argv[0] = prog
            // argv[2] is the script path (shebang): skipped; the rest is forwarded
            var k: u64 = 3
            while k < argc && nargs < 6 {
                argv[(nargs) as usize] = ulib.arg_at(args, k)
                nargs = nargs + 1
                k = k + 1
            }
        }
    }
    let r: u64 = ulib.sys(SYS_OSUM_TERMNEW, 0, 0, 0)
    if ulib.bad(r) {
        if r != ENOSYS_NEG {
            // slots used up: a second shell on the console would just fight the first window for its keys
            ulib.say((&e_full[0]) as u64)
            ulib.nl()
            // r530: a real error window ("No terminal free"), shown by /bin/termfull; if that cannot start either, we just end
            var fpath: [u8; 14] = "/bin/termfull\0"
            var fa0: [u8; 9] = "termfull\0"
            var fargv: [u64; 2] = [0; 2]
            fargv[0] = (&fa0[0]) as u64
            fargv[1] = 0
            ulib.sys(SYS_EXECVE, (&fpath[0]) as u64, (&fargv[0]) as u64, 0)
            ulib.sys(SYS_EXIT, 1, 0, 0)
            return 1
        }
        ulib.say((&e_win[0]) as u64)
        ulib.nl()
    }
    argv[(nargs) as usize] = 0
    if prog == (&path[0]) as u64 {
        ulib.sys(SYS_EXECVE, (&path_osh[0]) as u64, (&argv[0]) as u64, 0)
    }
    ulib.sys(SYS_EXECVE, prog, (&argv[0]) as u64, 0)
    return 127
}
