// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/sed.fi -- Runde K11: der Strom-Editor.
//
// `sed [-n] SKRIPT [DATEI...]`, `-e SKRIPT` mehrfach. Ein Skript sind
// Befehle, getrennt durch `;` oder Zeilenumbruch, jeder mit einer
// Adresse davor:
//
//     (keine)     jede Zeile
//     N           die N-te Zeile
//     $           die letzte
//     /TEXT/      jede Zeile, in der TEXT steht
//     A,B         von A bis B, beide Formen mischbar
//     davor ein ! kehrt die Adresse um
//
// Die Befehle sind `s`, `d`, `p`, `q` und `=`.
//
// WAS EIN MUSTER HIER IST: eine TEILZEICHENKETTE, mit `^` und `$` als
// Ankern. Kein regulaerer Ausdruck -- eine Ausdrucksmaschine ist eine
// Runde fuer sich, und `grep` dieses Userlands sucht seit Runde K6
// genauso. Ein `sed`, das eine Maschine BEHAUPTET und nur eine
// Teilzeichenkette kann, waere die schlimmere Loesung: dann liest jemand
// `s/[0-9]*//` und bekommt etwas, das aussieht, als habe es geklappt.
//
// In der Ersetzung stehen `&` fuer den Fund und `\&`, `\n`, `\t`, `\\`
// fuer sich selbst. `s///g` ersetzt alle, `s///N` den N-ten Fund.

profile kernel

import ulib
import tools

export { u_start }

const MAX_CMD: u64 = 8
const LINE: u64 = 1024
const TEXTS: u64 = 1024

const A_NONE: u64 = 0
const A_LINE: u64 = 1
const A_LAST: u64 = 2
const A_PAT: u64 = 3

static mut c_kind: [u64; 8] = [0 as u64; 8]
static mut c_a1k: [u64; 8] = [0 as u64; 8]
static mut c_a1v: [u64; 8] = [0 as u64; 8]
static mut c_a2k: [u64; 8] = [0 as u64; 8]
static mut c_a2v: [u64; 8] = [0 as u64; 8]
static mut c_neg: [u64; 8] = [0 as u64; 8]
static mut c_active: [u64; 8] = [0 as u64; 8]
static mut c_find: [u64; 8] = [0 as u64; 8]
static mut c_repl: [u64; 8] = [0 as u64; 8]
static mut c_which: [u64; 8] = [0 as u64; 8] // 0 = der erste, 0xFF.. = alle
static mut ncmd: u64 = 0

static mut texts: [u8; 1024] = [0 as u8; 1024]
static mut tat: u64 = 0

static mut line: [u8; 1024] = [0 as u8; 1024]
static mut work: [u8; 1024] = [0 as u8; 1024]
static mut ctx: [u8; 528] = [0 as u8; 528]
static mut quiet: bool = false
static mut lineno: u64 = 0
static mut is_last: bool = false
static mut stop: bool = false

// Ein Stueck Text in den gemeinsamen Speicher; gibt seine Adresse.
fn keep(p: u64, n: u64) -> u64 {
    if tat + n + 1 >= TEXTS {
        return 0
    }
    let at: u64 = tat
    var i: u64 = 0
    while i < n {
        texts[(at + i) as usize] = *((p + i) as *mut u8)
        i = i + 1
    }
    texts[(at + n) as usize] = 0 as u8
    tat = at + n + 1
    return (&texts[(at) as usize]) as u64
}

// Fluchtzeichen aufloesen und das Ergebnis ablegen. `stop_at` ist der
// Trenner, `end` bekommt die Stelle dahinter.
fn keep_escaped(p: u64, from: u64, stop_at: u64, end: u64) -> u64 {
    var buf: [u8; 256] = [0 as u8; 256]
    var i: u64 = from
    var n: u64 = 0
    var going: bool = true
    while going {
        let c: u64 = (*((p + i) as *mut u8)) as u64
        if c == 0 {
            going = false
        } else if c == stop_at {
            going = false
            i = i + 1
        } else if c == 92 {
            let d: u64 = (*((p + i + 1) as *mut u8)) as u64
            i = i + 2
            var v: u64 = d
            if d == 110 {
                v = 10
            } else if d == 116 {
                v = 9
            }
            if n + 1 < 256 {
                buf[(n) as usize] = v as u8
                n = n + 1
            }
        } else {
            i = i + 1
            if n + 1 < 256 {
                buf[(n) as usize] = c as u8
                n = n + 1
            }
        }
    }
    __mmio_write64((end) as *mut u64, i)
    return keep((&buf[0 as usize]) as u64, n)
}

// Eine Adresse ab `i`. Gibt die Art zurueck, der Wert kommt in `out`.
fn addr(p: u64, i: u64, out: u64, end: u64) -> u64 {
    let c: u64 = (*((p + i) as *mut u8)) as u64
    if tools.is_digit(c) {
        let v: u64 = tools.dec_at(p, i, end)
        __mmio_write64((out) as *mut u64, v)
        return A_LINE
    }
    if c == 36 {
        __mmio_write64((end) as *mut u64, i + 1)
        return A_LAST
    }
    if c == 47 {
        var e: [u64; 1] = [0 as u64; 1]
        let t: u64 = keep_escaped(p, i + 1, 47, (&e[0 as usize]) as u64)
        __mmio_write64((out) as *mut u64, t)
        __mmio_write64((end) as *mut u64, e[0 as usize])
        return A_PAT
    }
    __mmio_write64((end) as *mut u64, i)
    return A_NONE
}

// Ein ganzes Skript zerlegen.
fn parse(p: u64) -> bool {
    var i: u64 = 0
    var going: bool = true
    while going {
        while *((p + i) as *mut u8) == 32 as u8
        || *((p + i) as *mut u8) == 10 as u8
        || *((p + i) as *mut u8) == 59 as u8 {
            i = i + 1
        }
        if *((p + i) as *mut u8) == 0 as u8 {
            going = false
        } else if ncmd >= MAX_CMD {
            return false
        } else {
            var e: [u64; 1] = [0 as u64; 1]
            var v: [u64; 1] = [0 as u64; 1]
            let k1: u64 = addr(p, i, (&v[0 as usize]) as u64,
                (&e[0 as usize]) as u64)
            c_a1k[(ncmd) as usize] = k1
            c_a1v[(ncmd) as usize] = v[0 as usize]
            i = e[0 as usize]
            c_a2k[(ncmd) as usize] = A_NONE
            if k1 != A_NONE && *((p + i) as *mut u8) == 44 as u8 {
                let k2: u64 = addr(p, i + 1, (&v[0 as usize]) as u64,
                    (&e[0 as usize]) as u64)
                c_a2k[(ncmd) as usize] = k2
                c_a2v[(ncmd) as usize] = v[0 as usize]
                i = e[0 as usize]
            }
            c_neg[(ncmd) as usize] = 0
            if *((p + i) as *mut u8) == 33 as u8 {
                c_neg[(ncmd) as usize] = 1
                i = i + 1
            }
            let cmd: u64 = (*((p + i) as *mut u8)) as u64
            c_kind[(ncmd) as usize] = cmd
            i = i + 1
            if cmd == 115 {
                let delim: u64 = (*((p + i) as *mut u8)) as u64
                if delim == 0 {
                    return false
                }
                c_find[(ncmd) as usize] = keep_escaped(p, i + 1, delim,
                    (&e[0 as usize]) as u64)
                i = e[0 as usize]
                c_repl[(ncmd) as usize] = keep_escaped(p, i, delim,
                    (&e[0 as usize]) as u64)
                i = e[0 as usize]
                c_which[(ncmd) as usize] = 1
                var flags: bool = true
                while flags {
                    let f: u64 = (*((p + i) as *mut u8)) as u64
                    if f == 103 {
                        c_which[(ncmd) as usize] = 0
                        i = i + 1
                    } else if tools.is_digit(f) {
                        c_which[(ncmd) as usize] = tools.dec_at(p, i,
                            (&e[0 as usize]) as u64)
                        i = e[0 as usize]
                    } else {
                        flags = false
                    }
                }
            } else if cmd != 100 && cmd != 112 && cmd != 113 && cmd != 61 {
                return false
            }
            c_active[(ncmd) as usize] = 0
            ncmd = ncmd + 1
        }
    }
    return true
}

// Steht `pat` in `s`? `^` und `$` sind Anker. Gibt die Fundstelle oder
// EOF; `mlen` bekommt die Laenge des Fundes.
fn look(s: u64, n: u64, pat: u64, from: u64, mlen: u64) -> u64 {
    var p: u64 = pat
    var anchor_start: bool = false
    var anchor_end: bool = false
    if *((p) as *mut u8) == 94 as u8 {
        anchor_start = true
        p = p + 1
    }
    var len: u64 = ulib.length(p)
    if len > 0 && *((p + len - 1) as *mut u8) == 36 as u8 {
        anchor_end = true
        len = len - 1
    }
    __mmio_write64((mlen) as *mut u64, len)
    if len > n {
        return ulib.EOF
    }
    if anchor_start {
        if from != 0 {
            return ulib.EOF
        }
        if tools.same_bytes(s, p, len) && (!anchor_end || len == n) {
            return 0
        }
        return ulib.EOF
    }
    if anchor_end {
        if n < len || from > n - len {
            return ulib.EOF
        }
        if tools.same_bytes(s + n - len, p, len) {
            return n - len
        }
        return ulib.EOF
    }
    if len == 0 {
        if from <= n {
            return from
        }
        return ulib.EOF
    }
    var i: u64 = from
    while i + len <= n {
        if tools.same_bytes(s + i, p, len) {
            return i
        }
        i = i + 1
    }
    return ulib.EOF
}

fn hit(s: u64, n: u64, pat: u64) -> bool {
    var m: [u64; 1] = [0 as u64; 1]
    return look(s, n, pat, 0, (&m[0 as usize]) as u64) != ulib.EOF
}

// Gilt Befehl `k` fuer die Zeile, die gerade dasteht?
fn selected(k: u64, n: u64) -> bool {
    var yes: bool = false
    let k1: u64 = c_a1k[(k) as usize]
    if k1 == A_NONE {
        yes = true
    } else if c_a2k[(k) as usize] == A_NONE {
        yes = one_addr(k1, c_a1v[(k) as usize], n)
    } else if c_active[(k) as usize] == 1 {
        yes = true
        if one_addr(c_a2k[(k) as usize], c_a2v[(k) as usize], n) {
            c_active[(k) as usize] = 0
        }
    } else if one_addr(k1, c_a1v[(k) as usize], n) {
        yes = true
        c_active[(k) as usize] = 1
        // Eine Bereichsende-Zahl, die nicht groesser ist als der Anfang,
        // schliesst den Bereich sofort -- so wie bei GNU.
        if c_a2k[(k) as usize] == A_LINE && c_a2v[(k) as usize] <= lineno {
            c_active[(k) as usize] = 0
        }
    }
    if c_neg[(k) as usize] == 1 {
        return !yes
    }
    return yes
}

fn one_addr(kind: u64, v: u64, n: u64) -> bool {
    if kind == A_LINE {
        return lineno == v
    }
    if kind == A_LAST {
        return is_last
    }
    if kind == A_PAT {
        return hit((&line[0 as usize]) as u64, n, v)
    }
    return false
}

// `s`, in `work` gebaut und zurueckkopiert. Gibt die neue Laenge.
fn substitute(k: u64, n: u64) -> u64 {
    let pat: u64 = c_find[(k) as usize]
    let rep: u64 = c_repl[(k) as usize]
    let which: u64 = c_which[(k) as usize]
    var out: u64 = 0
    var at: u64 = 0
    var seen: u64 = 0
    var m: [u64; 1] = [0 as u64; 1]
    var going: bool = true
    while going {
        let f: u64 = look((&line[0 as usize]) as u64, n, pat, at,
            (&m[0 as usize]) as u64)
        if f == ulib.EOF {
            going = false
        } else {
            seen = seen + 1
            let ml: u64 = m[0 as usize]
            if which == 0 || seen == which {
                var i: u64 = at
                while i < f && out + 1 < LINE {
                    work[(out) as usize] = line[(i) as usize]
                    out = out + 1
                    i = i + 1
                }
                var r: u64 = 0
                while *((rep + r) as *mut u8) != 0 as u8 && out + 1 < LINE {
                    if *((rep + r) as *mut u8) == 38 as u8 {
                        var q: u64 = 0
                        while q < ml && out + 1 < LINE {
                            work[(out) as usize] = line[(f + q) as usize]
                            out = out + 1
                            q = q + 1
                        }
                    } else {
                        work[(out) as usize] = *((rep + r) as *mut u8)
                        out = out + 1
                    }
                    r = r + 1
                }
                at = f + ml
                if ml == 0 {
                    if at < n && out + 1 < LINE {
                        work[(out) as usize] = line[(at) as usize]
                        out = out + 1
                    }
                    at = at + 1
                }
                if which != 0 {
                    going = false
                }
            } else {
                var i: u64 = at
                let upto: u64 = f + ml
                while i < upto && out + 1 < LINE {
                    work[(out) as usize] = line[(i) as usize]
                    out = out + 1
                    i = i + 1
                }
                at = upto
                if ml == 0 {
                    at = at + 1
                }
            }
            if at > n {
                going = false
            }
        }
    }
    if seen == 0 || (which != 0 && seen < which) {
        return n
    }
    var i: u64 = at
    while i < n && out + 1 < LINE {
        work[(out) as usize] = line[(i) as usize]
        out = out + 1
        i = i + 1
    }
    i = 0
    while i < out {
        line[(i) as usize] = work[(i) as usize]
        i = i + 1
    }
    line[(out) as usize] = 0 as u8
    return out
}

// Eine Zeile durch alle Befehle.
fn run_line(n0: u64) {
    var n: u64 = n0
    var deleted: bool = false
    var k: u64 = 0
    while k < ncmd && !deleted {
        if selected(k, n) {
            let c: u64 = c_kind[(k) as usize]
            if c == 115 {
                n = substitute(k, n)
            } else if c == 100 {
                deleted = true
            } else if c == 112 {
                tools.ob_put((&line[0 as usize]) as u64, n)
                tools.ob_nl()
            } else if c == 61 {
                tools.ob_num(lineno)
                tools.ob_nl()
            } else if c == 113 {
                stop = true
                k = ncmd
            }
        }
        k = k + 1
    }
    if !deleted && !quiet {
        tools.ob_put((&line[0 as usize]) as u64, n)
        tools.ob_nl()
    }
}

// Eine Datei. Die letzte Zeile muss VORHER bekannt sein (`$`), also
// wird immer eine Zeile im Voraus gelesen.
fn stream(fd: u64) {
    ulib.rd_init((&ctx[0 as usize]) as u64)
    var next: [u8; 1024] = [0 as u8; 1024]
    var have: bool = false
    var nlen: u64 = 0
    let n0: u64 = ulib.rd_line(fd, (&ctx[0 as usize]) as u64,
        (&next[0 as usize]) as u64, LINE)
    if !ulib.bad(n0) {
        have = true
        nlen = n0
    }
    while have && !stop {
        var i: u64 = 0
        while i <= nlen {
            line[(i) as usize] = next[(i) as usize]
            i = i + 1
        }
        let cur: u64 = nlen
        let n1: u64 = ulib.rd_line(fd, (&ctx[0 as usize]) as u64,
            (&next[0 as usize]) as u64, LINE)
        if ulib.bad(n1) {
            have = false
            is_last = true
        } else {
            nlen = n1
            is_last = false
        }
        lineno = lineno + 1
        run_line(cur)
        if !is_last {
            have = true
        }
    }
}

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 26] = "sed: needs a script\0\0\0\0\0\0\0"
    var s_bad: [u8; 24] = "sed: cannot read that\0\0\0"
    var s_open: [u8; 19] = "sed: cannot open \0\0"
    var o_n: [u8; 3] = "-n\0"
    var o_e: [u8; 3] = "-e\0"
    let argc: u64 = ulib.arg_count(args)
    var at: u64 = 1
    var got: bool = false
    var reading: bool = true
    while reading && at < argc {
        let a: u64 = ulib.arg_at(args, at)
        if ulib.streq(a, (&o_n[0 as usize]) as u64) {
            quiet = true
            at = at + 1
        } else if ulib.streq(a, (&o_e[0 as usize]) as u64) && at + 1 < argc {
            if !parse(ulib.arg_at(args, at + 1)) {
                ulib.esay_line((&s_bad[0 as usize]) as u64, 0)
                return 1
            }
            got = true
            at = at + 2
        } else {
            reading = false
        }
    }
    if !got {
        if at >= argc {
            ulib.esay_line((&s_use[0 as usize]) as u64, 0)
            return 1
        }
        if !parse(ulib.arg_at(args, at)) {
            ulib.esay_line((&s_bad[0 as usize]) as u64, 0)
            return 1
        }
        at = at + 1
    }
    var code: u64 = 0
    if at >= argc {
        stream(ulib.IN)
    } else {
        while at < argc && !stop {
            let p: u64 = ulib.arg_at(args, at)
            let fd: u64 = tools.openr(p)
            if ulib.bad(fd) || ulib.is_dir(p) {
                // EIN VERZEICHNIS IST KEINE EINGABE. `open` auf einem
                // Verzeichnis gelingt in diesem Kernel; erst `read`
                // antwortet mit -EISDIR, und ein `sed`, das daraufhin
                // still nichts ausgibt, sagt "in Ordnung" zu etwas, das
                // es nicht ist. GNU meldet hier einen Fehler, und dieses
                // auch.
                ulib.esay_line((&s_open[0 as usize]) as u64, p)
                code = 2
                if !ulib.bad(fd) {
                    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
                }
            } else {
                stream(fd)
                ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
            }
            at = at + 1
        }
    }
    tools.ob_flush()
    return code
}
