
profile kernel

import ulib
import libc.text
import libc.clockapi
import libc.io
import libc.errno
import libc.kcall

export { u_start }

const ALT_MAX: u64 = 2134016

static mut buf: [u8; 4096] = [0 as u8; 4096]
static mut st: [u8; 144] = [0 as u8; 144]
static mut st2: [u8; 144] = [0 as u8; 144]
static mut lang: [u8; 300] = [0 as u8; 300]
static mut path: [u8; 400] = [0 as u8; 400]
static mut ents: [u8; 4096] = [0 as u8; 4096]
static mut target: [u8; 300] = [0 as u8; 300]

fn emit(name: u64, value: u64) {
    var s_header: [u8; 7] = "ofs3: \0"
    var s_gl: [u8; 4] = " = \0"
    ulib.say((&s_header[0 as usize]) as u64)
    ulib.say(name)
    ulib.say((&s_gl[0 as usize]) as u64)
    ulib.sayu(value)
    ulib.nl()
}

fn soll(pos: u64) -> u64 {
    return (pos * 2654435761) % 251
}

fn u_start(args: u64) -> u64 {
    var n_big: [u8; 12] = "grossdatei\0\0"  // DRAHT: wire field
    var n_read1: [u8; 8] = "read1\0\0\0"
    var n_read2: [u8; 8] = "read2\0\0\0"
    var n_read3: [u8; 8] = "read3\0\0\0"
    var n_namelen: [u8; 9] = "namelen\0\0"
    var n_nameok: [u8; 8] = "nameok\0\0"
    var n_dentlen: [u8; 9] = "dentlen\0\0"
    var n_ctime: [u8; 7] = "ctime\0\0"
    var n_mtime0: [u8; 8] = "mtime0\0\0"
    var n_mtime1: [u8; 8] = "mtime1\0\0"
    var n_linkok: [u8; 8] = "linkok\0\0"
    var n_linklen: [u8; 9] = "linklen\0\0"
    var n_linklstat: [u8; 11] = "linklstat\0\0"
    var n_linkstat: [u8; 10] = "linkstat\0\0"
    var n_linkread: [u8; 10] = "linkread\0\0"
    var n_ino1: [u8; 6] = "ino1\0\0"
    var n_ino2: [u8; 6] = "ino2\0\0"
    var n_viele: [u8; 7] = "viele\0\0"
    var n_ende: [u8; 6] = "ende\0\0"

    var p_big: [u8; 12] = "/tmp/gross\0\0"
    let fd: u64 = io.create((&p_big[0 as usize]) as u64)
    var geschrieben: u64 = 0
    if !errno.failed(fd) {
        let will: u64 = ALT_MAX + 262144
        var pos: u64 = 0
        var next: bool = true
        while pos < will && next {
            var k: u64 = 0
            while k < 4096 {
                buf[(k) as usize] = soll(pos + k) as u8
                k = k + 1
            }
            var n: u64 = 4096
            if pos + n > will {
                n = will - pos
            }
            let w: u64 = io.write(fd, (&buf[0 as usize]) as u64, n)
            if errno.failed(w) || w != n {
                next = false
            } else {
                pos = pos + n
            }
        }
        geschrieben = pos
        io.close(fd)
    }
    emit((&n_big[0 as usize]) as u64, geschrieben)

    var t1: u64 = 0
    var t2: u64 = 0
    var t3: u64 = 0
    let rd: u64 = io.open((&p_big[0 as usize]) as u64, 0)
    if !errno.failed(rd) {
        t1 = probe(rd, 0)
        t2 = probe(rd, ALT_MAX + 1000)
        t3 = probe(rd, geschrieben - 512)
        io.close(rd)
    }
    emit((&n_read1[0 as usize]) as u64, t1)
    emit((&n_read2[0 as usize]) as u64, t2)
    emit((&n_read3[0 as usize]) as u64, t3)

    var i: u64 = 0
    while i < 255 {
        lang[(i) as usize] = (97 + (i % 26)) as u8
        i = i + 1
    }
    lang[(255) as usize] = 0 as u8
    var p_tmp: [u8; 6] = "/tmp/\0"
    ulib.strcpy((&path[0 as usize]) as u64, (&p_tmp[0 as usize]) as u64)
    ulib.strcat((&path[0 as usize]) as u64, (&lang[0 as usize]) as u64)
    emit((&n_namelen[0 as usize]) as u64,
        text.length((&lang[0 as usize]) as u64))
    var nameok: u64 = 0
    let lf: u64 = io.create((&path[0 as usize]) as u64)
    if !errno.failed(lf) {
        var text: [u8; 12] = "langer name\0"
        io.write(lf, (&text[0 as usize]) as u64, 11)
        io.close(lf)
        if io.size_of((&path[0 as usize]) as u64) == 11 {
            nameok = 1
        }
    }
    emit((&n_nameok[0 as usize]) as u64, nameok)

    var dentlen: u64 = 0
    var p_tmpd: [u8; 5] = "/tmp\0"
    let dd: u64 = io.dir_open((&p_tmpd[0 as usize]) as u64)
    if !errno.failed(dd) {
        var going: bool = true
        while going {
            let n: u64 = io.dir_read(dd, (&ents[0 as usize]) as u64, 4096)
            if n == 0 || errno.failed(n) {
                going = false
            } else {
                var at: u64 = 0
                while at < n {
                    let rec: u64 = (&ents[0 as usize]) as u64 + at
                    let l: u64 = text.length(io.dir_name(rec))
                    if l > dentlen {
                        dentlen = l
                    }
                    at = at + io.dir_reclen(rec)
                }
            }
        }
        io.close(dd)
    }
    emit((&n_dentlen[0 as usize]) as u64, dentlen)

    var p_time: [u8; 11] = "/tmp/zeit\0\0"
    var ctime: u64 = 0
    var mtime0: u64 = 0
    var mtime1: u64 = 0
    let zf: u64 = io.create((&p_time[0 as usize]) as u64)
    if !errno.failed(zf) {
        var a: [u8; 2] = "a\0"
        io.write(zf, (&a[0 as usize]) as u64, 1)
        io.close(zf)
    }
    if !errno.failed(io.stat_into((&p_time[0 as usize]) as u64,
        (&st[0 as usize]) as u64)) {
        ctime = io.stat_ctime((&st[0 as usize]) as u64)
        mtime0 = io.stat_mtime((&st[0 as usize]) as u64)
    }
    emit((&n_ctime[0 as usize]) as u64, ctime)
    emit((&n_mtime0[0 as usize]) as u64, mtime0)
    clockapi.sleep_ms(2100)
    let zf2: u64 = io.open((&p_time[0 as usize]) as u64, kcall.O_WRONLY)
    if !errno.failed(zf2) {
        var b: [u8; 2] = "b\0"
        io.write(zf2, (&b[0 as usize]) as u64, 1)
        io.close(zf2)
    }
    if !errno.failed(io.stat_into((&p_time[0 as usize]) as u64,
        (&st[0 as usize]) as u64)) {
        mtime1 = io.stat_mtime((&st[0 as usize]) as u64)
    }
    emit((&n_mtime1[0 as usize]) as u64, mtime1)

    var p_link: [u8; 11] = "/tmp/zeig\0\0"
    var linkok: u64 = 0
    if !errno.failed(io.symlink((&p_time[0 as usize]) as u64,
        (&p_link[0 as usize]) as u64)) {
        linkok = 1
    }
    emit((&n_linkok[0 as usize]) as u64, linkok)
    let ln: u64 = io.readlink((&p_link[0 as usize]) as u64,
        (&target[0 as usize]) as u64, 299)
    var linklen: u64 = 0
    if !errno.failed(ln) {
        linklen = ln
    }
    emit((&n_linklen[0 as usize]) as u64, linklen)
    var lst: u64 = 0
    if !errno.failed(io.lstat_into((&p_link[0 as usize]) as u64,
        (&st[0 as usize]) as u64)) {
        if io.is_link_mode(io.stat_mode_of((&st[0 as usize]) as u64)) {
            lst = 1
        }
    }
    emit((&n_linklstat[0 as usize]) as u64, lst)
    var sst: u64 = 0
    if !errno.failed(io.stat_into((&p_link[0 as usize]) as u64,
        (&st2[0 as usize]) as u64)) {
        if !io.is_link_mode(io.stat_mode_of((&st2[0 as usize]) as u64)) {
            sst = 1
        }
    }
    emit((&n_linkstat[0 as usize]) as u64, sst)
    var gelesen: u64 = 0
    let lr: u64 = io.open((&p_link[0 as usize]) as u64, 0)
    if !errno.failed(lr) {
        let n: u64 = io.read(lr, (&buf[0 as usize]) as u64, 16)
        if !errno.failed(n) {
            gelesen = n
        }
        io.close(lr)
    }
    emit((&n_linkread[0 as usize]) as u64, gelesen)

    var p_a: [u8; 11] = "/tmp/name\0\0"
    var p_b: [u8; 12] = "/tmp/name2\0\0"
    var ino1: u64 = 0
    var ino2: u64 = 0
    let af: u64 = io.create((&p_a[0 as usize]) as u64)
    if !errno.failed(af) {
        io.write(af, (&lang[0 as usize]) as u64, 255)
        io.close(af)
    }
    if !errno.failed(io.stat_into((&p_a[0 as usize]) as u64,
        (&st[0 as usize]) as u64)) {
        ino1 = __mmio_read64(((&st[0 as usize]) as u64 + io.ST_INO)
            as *mut u64)
    }
    let rr: u64 = ulib.sys(ulib.SYS_RENAME, (&p_a[0 as usize]) as u64,
        (&p_b[0 as usize]) as u64, 0)
    var n_rr: [u8; 8] = "rename\0\0"
    emit((&n_rr[0 as usize]) as u64, rr)
    if !errno.failed(io.stat_into((&p_b[0 as usize]) as u64,
        (&st[0 as usize]) as u64)) {
        ino2 = __mmio_read64(((&st[0 as usize]) as u64 + io.ST_INO)
            as *mut u64)
    }
    emit((&n_ino1[0 as usize]) as u64, ino1)
    emit((&n_ino2[0 as usize]) as u64, ino2)

    var p_v: [u8; 11] = "/tmp/v000\0\0"
    var gemacht: u64 = 0
    var k2: u64 = 0
    while k2 < 120 {
        p_v[(6) as usize] = (48 + (k2 / 100)) as u8
        p_v[(7) as usize] = (48 + ((k2 / 10) % 10)) as u8
        p_v[(8) as usize] = (48 + (k2 % 10)) as u8
        let f2: u64 = io.create((&p_v[0 as usize]) as u64)
        if !errno.failed(f2) {
            io.close(f2)
            gemacht = gemacht + 1
        }
        k2 = k2 + 1
    }
    emit((&n_viele[0 as usize]) as u64, gemacht)
    emit((&n_ende[0 as usize]) as u64, 1)
    return 0
}

fn probe(fd: u64, pos: u64) -> u64 {
    if errno.failed(io.seek(fd, pos, 0)) {
        return 0
    }
    let n: u64 = io.read(fd, (&buf[0 as usize]) as u64, 512)
    if errno.failed(n) {
        return 0
    }
    var gut: u64 = 0
    var i: u64 = 0
    while i < n {
        if (buf[(i) as usize]) as u64 == soll(pos + i) {
            gut = gut + 1
        }
        i = i + 1
    }
    return gut
}
