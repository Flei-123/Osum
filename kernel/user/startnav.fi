profile kernel

export { next_key, DIR_UP, DIR_DOWN, DIR_LEFT, DIR_RIGHT, DIR_NONE, NONE }

const DIR_UP: u64 = 0
const DIR_DOWN: u64 = 1
const DIR_LEFT: u64 = 2
const DIR_RIGHT: u64 = 3
const DIR_NONE: u64 = 4

const NONE: u64 = 0

const PIN_COLS: u64 = 6
const REC_COLS: u64 = 2
const PIN_HALF: u64 = 3

fn pin_move(key: u64, dir: u64, pin_n: u64, rec_n: u64, entry: u64, pin_base: u64, rec_base: u64) -> u64 {
    let i: u64 = key - pin_base
    let col: u64 = i % PIN_COLS
    if dir == DIR_RIGHT && col + 1 < PIN_COLS && i + 1 < pin_n {
        return pin_base + i + 1
    }
    if dir == DIR_LEFT && col > 0 {
        return pin_base + i - 1
    }
    if dir == DIR_DOWN && i + PIN_COLS < pin_n {
        return pin_base + i + PIN_COLS
    }
    if dir == DIR_DOWN && rec_n > 0 {
        var rj: u64 = col / PIN_HALF
        if rj >= rec_n {
            rj = rec_n - 1
        }
        return rec_base + rj
    }
    if dir == DIR_UP && i >= PIN_COLS {
        return pin_base + i - PIN_COLS
    }
    if dir == DIR_UP {
        return entry
    }
    return NONE
}

fn rec_move(key: u64, dir: u64, pin_n: u64, rec_n: u64, entry: u64, pin_base: u64, rec_base: u64) -> u64 {
    let j: u64 = key - rec_base
    let col: u64 = j % REC_COLS
    if dir == DIR_RIGHT && col + 1 < REC_COLS && j + 1 < rec_n {
        return rec_base + j + 1
    }
    if dir == DIR_LEFT && col > 0 {
        return rec_base + j - 1
    }
    if dir == DIR_DOWN && j + REC_COLS < rec_n {
        return rec_base + j + REC_COLS
    }
    if dir == DIR_UP && j >= REC_COLS {
        return rec_base + j - REC_COLS
    }
    if dir == DIR_UP && pin_n > 0 {
        var last: u64 = ((pin_n - 1) / PIN_COLS) * PIN_COLS + col * PIN_HALF
        if last >= pin_n {
            last = pin_n - 1
        }
        return pin_base + last
    }
    if dir == DIR_UP {
        return entry
    }
    return NONE
}

fn next_key(key: u64, dir: u64, pin_n: u64, rec_n: u64, entry: u64, pin_base: u64, rec_base: u64) -> u64 {
    if key == entry && dir == DIR_DOWN {
        if pin_n > 0 {
            return pin_base
        }
        if rec_n > 0 {
            return rec_base
        }
        return NONE
    }
    if key >= pin_base && key < pin_base + pin_n {
        return pin_move(key, dir, pin_n, rec_n, entry, pin_base, rec_base)
    }
    if key >= rec_base && key < rec_base + rec_n {
        return rec_move(key, dir, pin_n, rec_n, entry, pin_base, rec_base)
    }
    return NONE
}
