// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/lock.fi -- Runde ALLTAG: DER SPERRBILDSCHIRM.
//
//   lock          sperren und die Kennwortfrage zeigen
//   lock -d       der Waechter: sperrt nach Leerlauf
//   lock -s       sagen, wie es steht (fuer die Abnahme)
//
// WAS HIER STEHT UND WAS IM KERN STEHT, und die Aufteilung ist der Kern
// der Sache:
//
//   Im KERN (kernel/wm.fi, kernel/sys.fi, kernel/kgui.fi): DASS
//   gesperrt ist, WER aufsperren darf, dass kein anderes Fenster eine
//   Taste bekommt, und dass dieses Programm NEU GESTARTET wird, wenn es
//   verschwindet, waehrend die Sperre steht.
//
//   HIER: das Fenster, die Kennwortfrage und die Pruefung gegen
//   /etc/shadow (PBKDF2-HMAC-SHA256, `pw.check_hash`, dieselbe
//   Funktion, die die Anmeldung nimmt).
//
// DER AUSFALLZUSTAND IST DAMIT DER RICHTIGE: stuerzt dieses Programm ab
// oder schiesst es jemand ab, bleibt die Sperre stehen -- der Kern
// startet es wieder. Ein Absturz kann sperren, aber niemals aufsperren.
// Genau das ist die Zusage, die diese Runde messen muss.
//
// DAS FENSTER ist bildschirmfuellend, ohne Rahmen, auf der obersten
// Ebene (`wlib.window_plain` mit `L_TOP`). Das ist KEINE Sicherheit --
// die Sicherheit sitzt im Fensterserver, der waehrend der Sperre nichts
// mehr an fremde Fenster gibt --, sondern nur die Ansicht.

// RUNDE GRUNDLINIE: profile app -- dieses Programm malt mit `wlib`, und
// `wlib` malt seit Runde 31 mit fUi. fUi rechnet in `f64` und benutzt
// `std.rt`; beides ist unter `profile kernel` gesperrt:
//
//     error: the module 'std.rt' belongs to the standard library and
//     is not available in profile 'kernel'
//
// Die sieben Programme des Schreibtischs (desktop, taskbar, settings,
// launcher, explorer, widgetdemo, taskmgr) stehen seit Runde 31 bzw.
// ABBILD auf `app`. Diese elf hier sind dabei uebersehen worden -- sie
// haben nie jemand gebaut ausser `fas` in K16, und dort fielen sie unter
// dem Sammelbefund "fas scheitert an" nicht auf.
profile app

import ulib
import libc.io
import wlibc
import wlib
import pw
import fuiapp
import fui.widget
import fui.render
import fui.textbuf
import fui.icon
import fui.painter
import fui.theme

export { u_start }

const SYS_SPERRE: u64 = 1870
const OP_STATE: u64 = 0
const OP_AN: u64 = 1
const OP_OPEN: u64 = 2
const OP_IDLE: u64 = 3
const OP_ICH: u64 = 4
const OP_FAIL: u64 = 5
const OP_NUM: u64 = 6
// RUNDE ANMELDUNG: wem die gesperrte Sitzung gehoert.
const OP_WER: u64 = 8

static mut kenn: [u8; 128] = [0 as u8; 128]
static mut name: [u8; 64] = [0 as u8; 64]
static mut haben: [u8; 192] = [0 as u8; 192]
static mut kopf: [u8; 192] = [0 as u8; 192]

static mut w_kenn: u64 = 0
static mut w_kopf: u64 = 0
static mut w_auf: u64 = 0
static mut w_wer: u64 = 0
static mut w_win: u64 = 0

static mut T_TITEL: [u8; 9] = "Gesperrt\0"
static mut T_APP: [u8; 5] = "lock\0"
static mut T_FRAGE: [u8; 44] = "Kennwort eingeben und Eingabetaste drücken\0"
static mut T_FALSCH: [u8; 26] = "Das Kennwort stimmt nicht\0"
static mut T_AUF: [u8; 11] = "Entsperren\0"
static mut T_KEIN: [u8; 48] = "Kein Kennwort gesetzt -- Eingabetaste entsperrt\0"
static mut T_CONF: [u8; 17] = "/etc/sperre.conf\0"
static mut K_LEER: [u8; 10] = "leerlauf=\0"
static mut T_ROOT: [u8; 5] = "root\0"

fn sy(op: u64, arg: u64) -> u64 {
    return ulib.sys(SYS_SPERRE, op, arg, 0)
}

fn say(p: u64) {
    ulib.say(p)
}

// Wer angemeldet ist. Ohne /etc/passwd bleibt es bei "root" -- dann
// gibt es auch kein Kennwort, und das sagt der Sperrbildschirm auch.
fn whoami() {
    let n: u64 = (&name[(0) as usize]) as u64
    ulib.strcpy(n, (&T_ROOT[(0) as usize]) as u64)
    // ============================================ RUNDE ANMELDUNG
    // DIE SITZUNG ZUERST, DIE EIGENE KENNUNG NUR HILFSWEISE.
    //
    // Hier stand nur `getuid`, und das ist die Kennung DIESES
    // Programms -- der Kern startet es, also 0, also root. Gemessen:
    // nach der Anmeldung als justin liess sich der Schirm mit dem
    // ROOT-Kennwort aufsperren und mit justins nicht.
    //
    // `OP_WER` sagt, wem die SITZUNG gehoert (glogin traegt es ein).
    // Gibt es keine (0), bleibt es bei `getuid` -- ein System ohne
    // Anmeldung sperrt weiter gegen den, der den Sperrer ausfuehrt.
    var uid: u64 = sy(OP_WER, 0)
    if ulib.bad(uid) || uid == 0 {
        uid = ulib.sys(107, 0, 0, 0) // getuid
    }
    if !ulib.bad(uid) {
        var t: [u8; 64] = [0 as u8; 64]
        if pw.name_of_uid(uid, (&t[(0) as usize]) as u64, 60) {
            ulib.strncpy(n, (&t[(0) as usize]) as u64, 60)
        }
    }
}

fn hat_kennwort() -> bool {
    return pw.shadow_of((&name[(0) as usize]) as u64,
        (&haben[(0) as usize]) as u64, 180)
}

// DIE PRUEFUNG. Sie steht in `pw.check_hash` und nicht hier: ein
// zweiter Vergleich waere ein zweiter Ort, an dem er falsch sein kann.
fn stimmt() -> bool {
    if !hat_kennwort() {
        return true
    }
    return pw.check_hash((&haben[(0) as usize]) as u64,
        (&kenn[(0) as usize]) as u64)
}

fn leeren() {
    var i: u64 = 0
    while i < 128 {
        kenn[(i) as usize] = 0 as u8
        i = i + 1
    }
    f_caret = 0
    if !f_fui {
        wlib.set_text(w_kenn, (&kenn[(0) as usize]) as u64)
    }
}

fn versuchen() -> bool {
    var s_ok: [u8; 20] = "sperre: aufgesperrt\0"
    var s_no: [u8; 37] = "sperre: falsches Kennwort, bleibt zu\0"
    if !stimmt() {
        let _f: u64 = sy(OP_FAIL, 0)
        leeren()
        ulib.strcpy((&kopf[(0) as usize]) as u64,
            (&T_FALSCH[(0) as usize]) as u64)
        if !f_fui {
            wlib.set_text(w_kopf, (&kopf[(0) as usize]) as u64)
        }
        say((&s_no[(0) as usize]) as u64)
        ulib.nl()
        return false
    }
    if ulib.bad(sy(OP_OPEN, 0)) {
        // Das kann nur passieren, wenn dieser Prozess NICHT der
        // eingetragene Sperrer ist -- dann darf er es auch nicht.
        return false
    }
    say((&s_ok[(0) as usize]) as u64)
    ulib.nl()
    return true
}

// ============================================ FUI-ALL STAGE 2
// THE LOCK SCREEN ON fUi DIRECTLY.
//
// Until here this screen was a wlib form (label, label, password,
// button). Now it is fUi's: one canvas over the whole screen
// (kernel/user/fuiapp.fi), and on it fUi's own label, text field and
// button widgets, fUi's text buffer in SECRET mode (fUi refuses copy and
// cut of it) and fUi's Lucide eye. wlib only supplies the window, the
// pixels and the events. If fUi cannot take the canvas the old wlib form
// comes up instead (`u_gui_wlib`) -- a lock screen that does not appear
// is worse than one in the old look.
//
// The mask: fUi's field paints its buffer as it is, so the bullets are a
// SECOND buffer (render.secret_mask, one U+2022 per character) with the
// caret mapped onto it; the eye paints the real buffer instead.
const F_FIELD: u64 = 1
const F_BUTTON: u64 = 2
const COL_W: u64 = 420
const FIELD_H: u64 = 36
const BTN_W: u64 = 140

static mut v_mask: [u8; 400] = [0 as u8; 400]
static mut f_focus: u64 = 1
static mut f_eye: bool = false
static mut f_caret_on: bool = true
static mut f_blink_t: u64 = 0

fn draw_label_at(c: *mut render.Ctx, x: u64, y: u64, w: u64, p: u64) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x as f64, y as f64, w as f64, 24.0)
    widget.w_set_text(&e, p, ulib.length(p) as usize)
    render.draw_widget(c, &e)
}

// The buffer as fUi's TextBuf, over `kenn` itself (no copy).
fn tb_of(t: *mut textbuf.TextBuf) {
    textbuf.tb_init(t, (&kenn[(0) as usize]) as u64, 120)
    textbuf.tb_set_len(t, ulib.length((&kenn[(0) as usize]) as u64) as usize)
    textbuf.tb_set_range(t, f_caret, f_caret)
    textbuf.tb_set_secret(t, true)
}

static mut f_caret: usize = 0
// true while the fUi screen is up: the wlib widgets below do not exist.
static mut f_fui: bool = false
static mut s_begun: bool = false

fn geometry(bw: u64, bh: u64, x: *mut u64, y: *mut u64) {
    // On the 4-pixel grid (tools/design/messen.py checks it).
    *x = ((bw - COL_W) / 2) / 4 * 4
    *y = (bh / 3) / 4 * 4
}

// A slanted line, stepped with small squares (fUi's own icon.stroke is
// not exported).
fn slash(z: *mut painter.Painter, x0: f64, y0: f64, x1: f64, y1: f64,
    col: u32) {
    var i: i64 = 0
    while i <= 40 {
        let t: f64 = (i as f64) / 40.0
        painter.surface(z, x0 + (x1 - x0) * t - 0.75,
            y0 + (y1 - y0) * t - 0.75, 1.5, 1.5, col)
        i = i + 1
    }
}

// One trace line per element, in the format of wlib.say_rects, so the
// layout checks (tools/design/messen.py) see the fUi screen like any
// other: `lock: rect id=N kind=K x= y= w= h=`.
fn say_one(id: u64, kind: u64, x: u64, y: u64, w: u64, h: u64) {
    var s_r: [u8; 15] = "lock: rect id=\0"
    var s_k: [u8; 7] = " kind=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_h: [u8; 4] = " h=\0"
    say((&s_r[(0) as usize]) as u64)
    ulib.sayn(id)
    say((&s_k[(0) as usize]) as u64)
    ulib.sayn(kind)
    say((&s_x[(0) as usize]) as u64)
    ulib.sayn(x)
    say((&s_y[(0) as usize]) as u64)
    ulib.sayn(y)
    say((&s_w[(0) as usize]) as u64)
    ulib.sayn(w)
    say((&s_h[(0) as usize]) as u64)
    ulib.sayn(h)
    ulib.nl()
}

fn say_rects_fui() {
    if !wlib.trace() {
        return
    }
    var x: u64 = 0
    var y: u64 = 0
    geometry(fuiapp.width(), fuiapp.height(), &x, &y)
    say_one(1, 1, x, y, COL_W, 24)
    say_one(2, 1, x, y + 28, COL_W, 24)
    say_one(3, 4, x, y + 60, COL_W, FIELD_H)
    say_one(4, 2, x, y + 108, BTN_W, FIELD_H)
}

fn paint_fui() {
    let c: *mut render.Ctx = fuiapp.ctx()
    let bw: u64 = fuiapp.width()
    let bh: u64 = fuiapp.height()
    var x: u64 = 0
    var y: u64 = 0
    geometry(bw, bh, &x, &y)
    fuiapp.frame_begin()
    draw_label_at(c, x, y, COL_W, (&name[(0) as usize]) as u64)
    draw_label_at(c, x, y + 28, COL_W, (&kopf[(0) as usize]) as u64)

    // The field: fUi's text box, its content either the mask or (eye
    // open) the buffer itself.
    var fe: widget.Widget = widget.widget_new(widget.KIND_TEXTBOX)
    widget.w_place(&fe, x as f64, (y + 60) as f64, COL_W as f64,
        FIELD_H as f64)
    widget.w_set_secret(&fe, true)
    widget.w_set_focus(&fe, f_focus == F_FIELD)
    var tb: textbuf.TextBuf = textbuf.tb_new()
    tb_of(&tb)
    if f_eye {
        render.draw_field(c, &fe, &tb, 0.0, f_caret_on, 0, 0)
    } else {
        let kp: u64 = (&kenn[(0) as usize]) as u64
        let mp: u64 = (&v_mask[(0) as usize]) as u64
        let mn: usize = render.secret_mask(kp, ulib.length(kp) as usize, mp, 396)
        var mv: textbuf.TextBuf = textbuf.tb_new()
        textbuf.tb_init(&mv, mp, 396)
        textbuf.tb_set_len(&mv, mn)
        textbuf.tb_set_range(&mv, mask_at(f_caret), mask_at(f_caret))
        render.draw_field(c, &fe, &mv, 0.0, f_caret_on, 0, 0)
    }
    // The eye: a square at the right end of the field, drawn with fUi's
    // painter (an almond ring and a pupil; struck through while the text
    // shows). fUi's Lucide set (fui.icons) cannot be imported next to
    // OrientOS's own `icons` module -- two modules of one name.
    let col: u32 = (*theme.theme_colors(fuiapp.theme())).text | 4278190080 as u32
    let z: *mut painter.Painter = render.ctx_painter(c)
    let ex: f64 = (x + COL_W - FIELD_H) as f64
    let ey: f64 = (y + 60) as f64
    painter.round_ring(z, ex + 8.0, ey + 12.0, 20.0, 12.0, 6.0, 1.5, col)
    icon.dot(z, ex + 15.0, ey + 15.0, 6.0, col)
    if f_eye {
        slash(z, ex + 8.0, ey + 26.0, ex + 28.0, ey + 10.0, col)
    }

    var be: widget.Widget = widget.widget_new(widget.KIND_BUTTON)
    widget.w_place(&be, x as f64, (y + 108) as f64, BTN_W as f64,
        FIELD_H as f64)
    widget.w_set_text(&be, (&T_AUF[(0) as usize]) as u64, 10)
    widget.w_set_focus(&be, f_focus == F_BUTTON)
    render.draw_widget(c, &be)
    fuiapp.frame_end()
}

// Octets of the mask before the caret: three per character before it.
fn mask_at(caret: usize) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < caret {
        let b: u8 = kenn[i]
        if (b & 0xC0 as u8) != 0x80 as u8 {
            n = n + 3
        }
        i = i + 1
    }
    return n
}

fn key_fui(k: u64) -> bool {
    if k == wlib.KEY_TAB || k == wlib.KEY_BTAB {
        if f_focus == F_FIELD {
            f_focus = F_BUTTON
        } else {
            f_focus = F_FIELD
        }
        return false
    }
    if f_focus == F_BUTTON {
        return k == wlib.KEY_ENTER || k == 32
    }
    if k == wlib.KEY_ENTER {
        return true
    }
    var tb: textbuf.TextBuf = textbuf.tb_new()
    tb_of(&tb)
    if k == wlib.KEY_LEFT {
        textbuf.tb_left(&tb, false)
    } else if k == wlib.KEY_RIGHT {
        textbuf.tb_right(&tb, false)
    } else if k == wlib.KEY_HOME {
        textbuf.tb_home(&tb, false)
    } else if k == wlib.KEY_END {
        textbuf.tb_end(&tb, false)
    } else if k == wlib.KEY_BS || k == 127 {
        let _b: bool = textbuf.tb_backspace(&tb)
    } else if k == wlib.KEY_DEL {
        let _d: bool = textbuf.tb_delete_fwd(&tb)
    } else if k >= 32 && k < 256 && k != 127 {
        var ch: [u8; 1] = [k as u8; 1]
        let _i: bool = textbuf.tb_insert(&tb, (&ch[0 as usize]) as u64, 1)
    }
    // Copy/cut are fUi's and refused on a secret buffer -- there is no
    // clipboard path here at all.
    kenn[textbuf.tb_len(&tb)] = 0 as u8
    f_caret = textbuf.tb_caret(&tb)
    return false
}

fn leeren_fui() {
    var i: u64 = 0
    while i < 128 {
        kenn[(i) as usize] = 0 as u8
        i = i + 1
    }
    f_caret = 0
}

fn click_fui(px: u64, py: u64) -> bool {
    var x: u64 = 0
    var y: u64 = 0
    geometry(fuiapp.width(), fuiapp.height(), &x, &y)
    if py >= y + 60 && py < y + 60 + FIELD_H && px >= x && px < x + COL_W {
        if px >= x + COL_W - FIELD_H {
            f_eye = !f_eye
        }
        f_focus = F_FIELD
        return false
    }
    if py >= y + 108 && py < y + 108 + FIELD_H && px >= x && px < x + BTN_W {
        f_focus = F_BUTTON
        return true
    }
    return false
}

fn u_gui() -> u64 {
    var s_bad: [u8; 20] = "lock: keine Flaeche\0"
    var s_go: [u8; 15] = "sperre: bereit\0"
    var s_geom: [u8; 16] = "sperre: geom w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_pid: [u8; 21] = "sperre: sperrer pid=\0"
    var s_fui: [u8; 19] = "sperre: fUi direkt\0"
    if !wlib.begin(false, true) {
        say((&s_bad[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    s_begun = true
    // ERST SPERREN, DANN MALEN (see u_gui_wlib).
    let _a: u64 = sy(OP_AN, 0)
    let _i: u64 = sy(OP_ICH, 0)
    whoami()
    let bw: u64 = wlibc.screen_w()
    let bh: u64 = wlibc.screen_h()
    if !fuiapp.open_plain(0, 0, bw, bh, (&T_TITEL[(0) as usize]) as u64,
        wlibc.L_TOP) {
        if fuiapp.win() < wlib.MAXWN {
            wlib.close(fuiapp.win())
        }
        return u_gui_wlib()
    }
    w_win = fuiapp.win()
    f_fui = true
    let _ap: u64 = wlib.window_app(w_win, (&T_APP[(0) as usize]) as u64)
    if hat_kennwort() {
        ulib.strcpy((&kopf[(0) as usize]) as u64,
            (&T_FRAGE[(0) as usize]) as u64)
    } else {
        ulib.strcpy((&kopf[(0) as usize]) as u64,
            (&T_KEIN[(0) as usize]) as u64)
    }
    say((&s_fui[(0) as usize]) as u64)
    ulib.nl()
    say((&s_geom[(0) as usize]) as u64)
    ulib.sayn(bw)
    say((&s_h[(0) as usize]) as u64)
    ulib.sayn(bh)
    ulib.nl()
    say((&s_pid[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 4))
    ulib.nl()
    f_blink_t = fuiapp.now_ms()
    paint_fui()
    say_rects_fui()
    say((&s_go[(0) as usize]) as u64)
    ulib.nl()

    var offen: bool = false
    var ev: fuiapp.Ev = fuiapp.ev_new()
    while wlib.alive() && !offen {
        var neu: bool = false
        while fuiapp.next(&ev) {
            var los: bool = false
            if ev.kind == fuiapp.EV_KEY {
                los = key_fui(ev.key)
                neu = true
            } else if ev.kind == fuiapp.EV_DOWN {
                los = click_fui(ev.x, ev.y)
                neu = true
            }
            if los {
                offen = versuchen()
                if !offen {
                    leeren_fui()
                    f_focus = F_FIELD
                }
            }
            f_caret_on = true
            f_blink_t = fuiapp.now_ms()
        }
        // The caret blinks at 530 ms, like wlib's (and Windows').
        let t: u64 = fuiapp.now_ms()
        if t >= f_blink_t + 530 && wlib.blink_enabled() {
            f_blink_t = t
            f_caret_on = !f_caret_on
            neu = true
        }
        if neu && !offen {
            paint_fui()
        }
        if !wlib.alive() && sy(OP_STATE, 0) == 1 {
            return 1
        }
    }
    wlib.close(w_win)
    wlib.draw_all()
    return 0
}

fn u_gui_wlib() -> u64 {
    var s_bad: [u8; 20] = "lock: keine Flaeche\0"
    var s_go: [u8; 15] = "sperre: bereit\0"
    var s_geom: [u8; 16] = "sperre: geom w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_pid: [u8; 21] = "sperre: sperrer pid=\0"
    if !s_begun && !wlib.begin(false, true) {
        say((&s_bad[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    s_begun = true
    // ERST SPERREN, DANN MALEN. Andersherum gaebe es einen Augenblick,
    // in dem ein Fenster mit der Kennwortfrage dasteht und die Tastatur
    // noch der Sitzung darunter gehoert.
    let _a: u64 = sy(OP_AN, 0)
    let _i: u64 = sy(OP_ICH, 0)
    whoami()
    let bw: u64 = wlibc.screen_w()
    let bh: u64 = wlibc.screen_h()
    let w: u64 = wlib.window_plain(0, 0, bw, bh,
        (&T_TITEL[(0) as usize]) as u64, wlibc.L_TOP)
    if w >= wlib.MAXWN {
        say((&s_bad[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    w_win = w
    let _ap: u64 = wlib.window_app(w, (&T_APP[(0) as usize]) as u64)
    let rand: u64 = wlib.inset()
    let luft: u64 = wlib.inset() / 2
    let breite: u64 = 420
    let links: u64 = (bw - breite) / 2
    let oben: u64 = bh / 3

    wlib.box_v(w, links, oben, breite, 200, rand, luft)
    w_wer = wlib.label((&name[(0) as usize]) as u64)
    if hat_kennwort() {
        ulib.strcpy((&kopf[(0) as usize]) as u64,
            (&T_FRAGE[(0) as usize]) as u64)
    } else {
        ulib.strcpy((&kopf[(0) as usize]) as u64,
            (&T_KEIN[(0) as usize]) as u64)
    }
    w_kopf = wlib.label((&kopf[(0) as usize]) as u64)
    wlib.size(breite - rand * 2, 0)
    // ROUND LOGIN-2: the system's password field (dots, eye, no copy).
    w_kenn = wlib.password((&kenn[(0) as usize]) as u64, 120)
    // RUNDE ANMELDUNG: DAS KENNWORT STEHT NICHT AUF DEM SCHIRM.
    //
    // Bis hierher malte `paint_entry` den Puffer, wie er ist -- das
    // Kennwort stand im Klartext im Sperrbildschirm. Das ist kein
    // Schoenheitsfehler: wer den Schirm sieht (Schulter, Kamera, ein
    // Foto der Abnahme), liest es mit. Die Verdeckung sitzt in der
    // BIBLIOTHEK und nicht hier, damit jedes Kennwortfeld dieses
    // Systems sie bekommt und nicht nur dieses eine.
    wlib.size(140, 0)
    w_auf = wlib.button((&T_AUF[(0) as usize]) as u64)
    wlib.box_end()

    wlib.set_focus(w_kenn)
    say((&s_geom[(0) as usize]) as u64)
    ulib.sayn(bw)
    say((&s_h[(0) as usize]) as u64)
    ulib.sayn(bh)
    ulib.nl()
    say((&s_pid[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 4))
    ulib.nl()
    var s_nm: [u8; 5] = "lock\0"
    wlib.say_rects((&s_nm[(0) as usize]) as u64)
    wlib.draw_all()
    say((&s_go[(0) as usize]) as u64)
    ulib.nl()

    var runden: u64 = 0
    var offen: bool = false
    // 24.09.2026: NO ROUND LIMIT. The loop yields when idle and ran out
    // of its 40 000 000 rounds after a few minutes; the screen ended,
    // the kernel's lock watch started /bin/lock in its place, and what
    // had been typed was gone ("everything refreshes", Dell 9020).
    while wlib.alive() && !offen {
        runden = runden + 1
        let id: u64 = wlib.step()
        if id < wlib.MAXWD {
            let kind: u64 = wlib.fired_kind()
            if (kind == wlib.K_ENTRY && id == w_kenn)
                || (kind == wlib.K_BUTTON && id == w_auf) {
                offen = versuchen()
            }
        }
        // DAS FENSTER LAESST SICH NICHT SCHLIESSEN. `wlib.alive` wird
        // falsch, wenn der Server ein Schliessereignis schickt -- hier
        // wird es nicht angenommen, solange die Sperre steht.
        if !wlib.alive() && sy(OP_STATE, 0) == 1 {
            return 1
        }
    }
    // ============================================== RUNDE ANMELDUNG
    // AUFGESPERRT HEISST: DAS FENSTER IST WEG.
    //
    // Die Schleife endete mit `offen`, und das Fenster blieb stehen --
    // gemessen am Lauf vom 13.09.: nach "sperre: aufgesperrt" stand
    // `wm: fen i=5 id=13 ... lay=2` weiter in der Liste und malte
    // weiter (`malen=36`). Auf dem Schirm war die Sperre also noch da,
    // obwohl sie im Kern schon offen war; das Foto nach dem Entsperren
    // und das davor unterschieden sich in 94 von 64000 Stichproben.
    //
    // Ein Sperrbildschirm, der nach dem richtigen Kennwort liegen
    // bleibt, ist von einem, der es nicht angenommen hat, nicht zu
    // unterscheiden.
    wlib.close(w_win)
    wlib.draw_all()
    return 0
}

// ------------------------------------------------------- der Waechter

fn leerlauf_grenze() -> u64 {
    // Sekunden aus /etc/sperre.conf; 0 heisst: nie von selbst.
    var buf: [u8; 512] = [0 as u8; 512]
    let fd: u64 = io.open((&T_CONF[(0) as usize]) as u64, 0)
    if ulib.bad(fd) {
        return 0
    }
    let b: u64 = (&buf[(0) as usize]) as u64
    let n: u64 = io.read(fd, b, 500)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return 0
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    let at: u64 = ulib.find(b, (&K_LEER[(0) as usize]) as u64)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return ulib.to_num(b + at + ulib.length((&K_LEER[(0) as usize]) as u64))
}

fn u_wache(einmal: bool) -> u64 {
    var s_start: [u8; 28] = "sperre: Waechter, Leerlauf \0"
    var s_s: [u8; 3] = " s\0"
    var s_aus: [u8; 34] = "sperre: Waechter aus (leerlauf=0)\0"
    var s_an: [u8; 36] = "sperre: Leerlauf abgelaufen, sperre\0"
    let grenze: u64 = leerlauf_grenze()
    if grenze == 0 {
        say((&s_aus[(0) as usize]) as u64)
        ulib.nl()
        return 0
    }
    say((&s_start[(0) as usize]) as u64)
    ulib.sayn(grenze)
    say((&s_s[(0) as usize]) as u64)
    ulib.nl()
    var runden: u64 = 0
    while runden < 4000000 {
        runden = runden + 1
        let _s: u64 = ulib.sleep_ms(250)
        if sy(OP_STATE, 0) == 0 {
            let idle: u64 = sy(OP_IDLE, 0)
            if !ulib.bad(idle) && idle >= grenze * 1000 {
                say((&s_an[(0) as usize]) as u64)
                ulib.nl()
                let _a: u64 = sy(OP_AN, 0)
                if einmal {
                    runden = 4000000
                }
            }
        }
    }
    return 0
}

fn u_say() -> u64 {
    var s_1: [u8; 12] = "sperre: an=\0"
    var s_2: [u8; 13] = " sperrungen=\0"
    var s_3: [u8; 16] = " aufsperrungen=\0"
    var s_4: [u8; 15] = " fehlversuche=\0"
    var s_5: [u8; 12] = " neustarts=\0"
    var s_6: [u8; 6] = " pid=\0"
    var s_7: [u8; 14] = " leerlauf_ms=\0"
    say((&s_1[(0) as usize]) as u64)
    ulib.sayn(sy(OP_STATE, 0))
    say((&s_2[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 0))
    say((&s_3[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 1))
    say((&s_4[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 2))
    say((&s_5[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 3))
    say((&s_6[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 4))
    say((&s_7[(0) as usize]) as u64)
    ulib.sayn(sy(OP_IDLE, 0))
    ulib.nl()
    return 0
}

fn u_start(args: u64) -> u64 {
    var s_d: [u8; 3] = "-d\0"
    var s_s: [u8; 3] = "-s\0"
    var s_an: [u8; 4] = "-an\0"
    var s_ab: [u8; 9] = "-absturz\0"
    let argc: u64 = ulib.arg_count(args)
    if argc >= 2 {
        let a: u64 = ulib.arg_at(args, 1)
        if ulib.streq(a, (&s_d[(0) as usize]) as u64) {
            var einmal: bool = false
            if argc >= 3 {
                var s_e: [u8; 7] = "einmal\0"
                einmal = ulib.streq(ulib.arg_at(args, 2),
                    (&s_e[(0) as usize]) as u64)
            }
            return u_wache(einmal)
        }
        if ulib.streq(a, (&s_s[(0) as usize]) as u64) {
            return u_say()
        }
        // DIE GEGENPROBE ZUM AUSFALLZUSTAND, und sie gehoert in das
        // Programm, das sie betrifft: sperren, sich eintragen, das
        // sagen -- und dann mit voller Absicht sterben. Was DANACH
        // passiert, ist die Zusage: der Kern startet den Sperrer neu
        // und die Sperre bleibt stehen. Ein Absturz darf sperren, aber
        // niemals aufsperren.
        if ulib.streq(a, (&s_ab[(0) as usize]) as u64) {
            let _x: u64 = sy(OP_AN, 0)
            let _y: u64 = sy(OP_ICH, 0)
            var s_boom: [u8; 41] = "sperre: Sperrer stirbt jetzt mit Absicht\0"
            say((&s_boom[(0) as usize]) as u64)
            ulib.nl()
            let _z: u64 = u_say()
            __mmio_write8((0) as *mut u8, 1 as u8)
            return 0
        }
        if ulib.streq(a, (&s_an[(0) as usize]) as u64) {
            // Nur sperren, ohne Fenster -- der Kern startet dann den
            // Sperrer. Das ist der Weg, den die Abnahme nimmt, um den
            // Ausfallzustand zu pruefen.
            let _r: u64 = sy(OP_AN, 0)
            return u_say()
        }
    }
    return u_gui()
}

// RUNDE ROTABSCHNITTE: DIESES `main` LAEUFT, UND ES MUSS DIE
// ARGUMENTE WEITERGEBEN.
//
// Der Kommentar, der hier stand, sagte "das `main`, das nie laeuft --
// `user.ld` springt nach `u_start`". Das stimmt fuer ein Programm, das
// mit `kernel/user/crt.s` gebunden ist; dessen `_start` ruft
// USER_ENTRY. Unter `profile app` stimmt es NICHT: dort bringt firnc
// sein eigenes `_start` mit (darum darf crt.o nicht dazu, siehe
// tools/look/shot.sh), und das endet in `call main` -- der Name steht
// fest in lib/firnc1/codegen.fi, `--defsym=USER_ENTRY` erreicht ihn
// nicht. Am gebauten ELF nachgesehen: Einsprung ist `_start`, sechs
// Befehle weiter steht `call <main>`; `_F0.u_start` wird von dort nie
// gerufen.
//
// `u_start(0)` warf damit den Argumentblock weg. Bei powermon waren
// das 54 rote Zusagen (siehe ROTABSCHNITTE 11/n).
//
// Der Block liegt an einer FESTEN Adresse: Runde K16 legte den
// Stapelzeiger darauf (kernel/elf.fi, `T_USTACK = proc.ARGS_BASE`),
// und firnc's `_start` macht `mov rsp, rdi`. Jede `elf: start`-Zeile
// dieses Systems druckt sie als `ustack=0x4007f000`.
fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
