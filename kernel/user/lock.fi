// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/lock.fi -- Runde ALLTAG: DER SPERRBILDSCHIRM.
//
//   lock          sperren und die Kennwortfrage zeigen
//   lock -d       der Waechter: sperrt nach Leerlauf
//   lock -s       sagen, wie es steht (fuer die Abnahme)
//
// WAS HIER STEHT UND WAS IM KERN STEHT, und die Aufteilung ist der Kern
// der Sache:
//
//   Im KERN (kernel/wm.fi, kernel/sys.fi, kernel/kgui.fi): DASS
//   gesperrt ist, WER aufsperren darf, dass kein anderes Fenster eine
//   Taste bekommt, und dass dieses Programm NEU GESTARTET wird, wenn es
//   verschwindet, waehrend die Sperre steht.
//
//   HIER: das Fenster, die Kennwortfrage und die Pruefung gegen
//   /etc/shadow (PBKDF2-HMAC-SHA256, `pw.check_hash`, dieselbe
//   Funktion, die die Anmeldung nimmt).
//
// DER AUSFALLZUSTAND IST DAMIT DER RICHTIGE: stuerzt dieses Programm ab
// oder schiesst es jemand ab, bleibt die Sperre stehen -- der Kern
// startet es wieder. Ein Absturz kann sperren, aber niemals aufsperren.
// Genau das ist die Zusage, die diese Runde messen muss.
//
// DAS FENSTER ist bildschirmfuellend, ohne Rahmen, auf der obersten
// Ebene (`fuiscene.open_plain` mit `L_TOP`; seit r372 ist es ein Szenenbaum
// von fUi, keine Leinwand und kein wlib-Formular mehr). Das ist KEINE Sicherheit --
// die Sicherheit sitzt im Fensterserver, der waehrend der Sperre nichts
// mehr an fremde Fenster gibt --, sondern nur die Ansicht.

// RUNDE GRUNDLINIE: profile app -- dieses Programm malt mit `wlib`, und
// `wlib` malt seit Runde 31 mit fUi. fUi rechnet in `f64` und benutzt
// `std.rt`; beides ist unter `profile kernel` gesperrt:
//
//     error: the module 'std.rt' belongs to the standard library and
//     is not available in profile 'kernel'
//
// Die sieben Programme des Schreibtischs (desktop, taskbar, settings,
// launcher, explorer, widgetdemo, taskmgr) stehen seit Runde 31 bzw.
// ABBILD auf `app`. Diese elf hier sind dabei uebersehen worden -- sie
// haben nie jemand gebaut ausser `fas` in K16, und dort fielen sie unter
// dem Sammelbefund "fas scheitert an" nicht auf.
profile app

import ulib
import libc.io
import wlibc
import wlib
import pw
import fuiapp
import fuiscene
import icons
import signin
import backdrop

export { u_start }

const SYS_SPERRE: u64 = 1870
const OP_STATE: u64 = 0
const OP_AN: u64 = 1
const OP_OPEN: u64 = 2
const OP_IDLE: u64 = 3
const OP_ICH: u64 = 4
const OP_FAIL: u64 = 5
const OP_NUM: u64 = 6
// RUNDE ANMELDUNG: wem die gesperrte Sitzung gehoert.
const OP_WER: u64 = 8

static mut kenn: [u8; 128] = [0 as u8; 128]
static mut name: [u8; 64] = [0 as u8; 64]
static mut haben: [u8; 192] = [0 as u8; 192]
static mut kopf: [u8; 192] = [0 as u8; 192]


static mut T_TITEL: [u8; 9] = "Gesperrt\0"
static mut T_APP: [u8; 5] = "lock\0"
static mut T_FRAGE: [u8; 18] = "Kennwort eingeben\0"
static mut T_FALSCH: [u8; 26] = "Das Kennwort stimmt nicht\0"
static mut T_AUF: [u8; 11] = "Entsperren\0"
static mut T_KEIN: [u8; 48] = "Kein Kennwort gesetzt -- Eingabetaste entsperrt\0"
static mut T_CONF: [u8; 17] = "/etc/sperre.conf\0"
static mut K_LEER: [u8; 10] = "leerlauf=\0"
static mut T_ROOT: [u8; 5] = "root\0"

fn sy(op: u64, arg: u64) -> u64 {
    return ulib.sys(SYS_SPERRE, op, arg, 0)
}

fn say(p: u64) {
    ulib.say(p)
}

// Wer angemeldet ist. Ohne /etc/passwd bleibt es bei "root" -- dann
// gibt es auch kein Kennwort, und das sagt der Sperrbildschirm auch.
fn whoami() {
    let n: u64 = (&name[(0) as usize]) as u64
    ulib.strcpy(n, (&T_ROOT[(0) as usize]) as u64)
    // ============================================ RUNDE ANMELDUNG
    // DIE SITZUNG ZUERST, DIE EIGENE KENNUNG NUR HILFSWEISE.
    //
    // Hier stand nur `getuid`, und das ist die Kennung DIESES
    // Programms -- der Kern startet es, also 0, also root. Gemessen:
    // nach der Anmeldung als justin liess sich der Schirm mit dem
    // ROOT-Kennwort aufsperren und mit justins nicht.
    //
    // `OP_WER` sagt, wem die SITZUNG gehoert (glogin traegt es ein).
    // Gibt es keine (0), bleibt es bei `getuid` -- ein System ohne
    // Anmeldung sperrt weiter gegen den, der den Sperrer ausfuehrt.
    var uid: u64 = sy(OP_WER, 0)
    if ulib.bad(uid) || uid == 0 {
        uid = ulib.sys(107, 0, 0, 0) // getuid
    }
    if !ulib.bad(uid) {
        var t: [u8; 64] = [0 as u8; 64]
        if pw.name_of_uid(uid, (&t[(0) as usize]) as u64, 60) {
            ulib.strncpy(n, (&t[(0) as usize]) as u64, 60)
        }
    }
}

fn hat_kennwort() -> bool {
    return pw.shadow_of((&name[(0) as usize]) as u64,
        (&haben[(0) as usize]) as u64, 180)
}

// DIE PRUEFUNG. Sie steht in `pw.check_hash` und nicht hier: ein
// zweiter Vergleich waere ein zweiter Ort, an dem er falsch sein kann.
fn stimmt() -> bool {
    if !hat_kennwort() {
        return true
    }
    return pw.check_hash((&haben[(0) as usize]) as u64,
        (&kenn[(0) as usize]) as u64)
}

// ============================================ FUI-ALL: THE SCENE TREE
// THE LOCK SCREEN IS A SCENE TREE OF fUi (r372).
//
// Before: a canvas over the whole screen, painted by hand (label, text box,
// button, eye -- no tree, no accessibility node per widget). Now the screen is
// described like every other program of the system (`fuiscene`): a column of
// two labels, the password field (fUi's secret mode), the eye and the main
// button. The host paints, lays out, handles the keyboard focus (Tab, Enter)
// and exports the nodes to the accessibility tree.
//
// What did NOT change: the lock itself is the kernel's; this program only
// asks for the password (`pw.check_hash`, one function for the whole system)
// and tells the kernel to open. A crash locks, it never unlocks.
const K_KENN: u64 = 1
const K_EYE: u64 = 2
const K_GO: u64 = 3

static mut f_eye: bool = false
static mut s_bw: u64 = 0
static mut s_bh: u64 = 0

// The password is taken out of the field into `kenn` for the check only,
// and wiped from both after it.
fn leeren() {
    var i: u64 = 0
    while i < 128 {
        kenn[(i) as usize] = 0 as u8
        i = i + 1
    }
    fuiscene.entry_set(K_KENN, (&kenn[(0) as usize]) as u64)
}

fn versuchen() -> bool {
    var s_ok: [u8; 20] = "sperre: aufgesperrt\0"
    var s_no: [u8; 37] = "sperre: falsches Kennwort, bleibt zu\0"
    let _c: u64 = ulib.strncpy((&kenn[(0) as usize]) as u64,
        fuiscene.entry_text(K_KENN), 120)
    if !stimmt() {
        let _f: u64 = sy(OP_FAIL, 0)
        leeren()
        ulib.strcpy((&kopf[(0) as usize]) as u64,
            (&T_FALSCH[(0) as usize]) as u64)
        fuiscene.refresh()
        say((&s_no[(0) as usize]) as u64)
        ulib.nl()
        return false
    }
    if ulib.bad(sy(OP_OPEN, 0)) {
        // Only a process that is NOT the registered locker can get here --
        // and that one must not open it.
        return false
    }
    say((&s_ok[(0) as usize]) as u64)
    ulib.nl()
    return true
}

// The eye: the face is the host's (plate, hover, focus ring), the picture is
// fUi's eye of the system's password fields (`fuiapp.eye`).
fn eye_paint(ud: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    fuiapp.eye(x, y, h, f_eye, fuiapp.ink())
}

// ===================================================== r383: THE LOOK
// The layout of the Windows 11 sign-in screen on the wallpaper; what lock and
// glogin paint the same way is in signin.fi. Here: the wrappers (the host's
// canvases take a painter without arguments), the power button, the network.
const K_POWER: u64 = 4
const K_SLEEP: u64 = 5
const K_OFF: u64 = 6
const SYS_REBOOT: u64 = 169
const RB_POWEROFF: u64 = 0x4321FEDC

static mut f_pm: bool = false
static mut net_t: u64 = 0
static mut ini: [u8; 4] = [0 as u8; 4]
static mut T_STROM: [u8; 8] = "Ein/Aus\0"
static mut T_SCHLAF: [u8; 15] = "Energie sparen\0"
static mut T_AUS: [u8; 15] = "Herunterfahren\0"
static mut T_HINT: [u8; 42] = "Kennwort vergessen? Administrator fragen.\0"
static mut netz_st: u64 = 99

fn initial_set() {
    signin.initial_of((&name[(0) as usize]) as u64, (&ini[(0) as usize]) as u64)
}

fn p_avatar(x: u64, y: u64, w: u64, h: u64) {
    signin.paint_avatar(x, y, w, h, (&ini[(0) as usize]) as u64)
}

fn p_name(x: u64, y: u64, w: u64, h: u64) {
    signin.paint_name(x, y, w, h, (&name[(0) as usize]) as u64)
}

fn p_status(x: u64, y: u64, w: u64, h: u64) {
    signin.paint_status(x, y, w, h, (&kopf[(0) as usize]) as u64)
}

fn p_hint(x: u64, y: u64, w: u64, h: u64) {
    signin.paint_hint(x, y, w, h, (&T_HINT[(0) as usize]) as u64)
}

fn p_chip(x: u64, y: u64, w: u64, h: u64) {
    signin.paint_chip(x, y, w, h, (&ini[(0) as usize]) as u64, (&name[(0) as usize]) as u64)
}

fn p_net(x: u64, y: u64, w: u64, h: u64) {
    signin.paint_net(x, y, w, h, netz_st)
}

// ONE painter for all the tiles of the window (the host keeps one): `ud`
// says which (1 the eye, 2 the unlock arrow, 3 the power button).
fn tile_paint(ud: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    if ud == 1 {
        fuiapp.eye(x, y, h, f_eye, fuiapp.ink())
    } else if ud == 2 {
        signin.glyph_tile(icons.ARROW_RIGHT, x, y, w, h, fuiapp.ink() as u64)
        if st & 8 != 0 {
            fuiapp.halo_in(x, y, w, h)
        }
    } else {
        signin.glyph_tile(icons.POWER, x, y, w, h, fuiapp.ink() as u64)
    }
}

fn net_update() -> bool {
    var st: u64 = ulib.sys(signin.SYS_NETGET, signin.NG_STATE, 0, 0)
    if ulib.bad(st) {
        st = 9
    }
    if st == netz_st {
        return false
    }
    netz_st = st
    return true
}

// Power off: the polite way through init (/run/svc.cmd, as the Start menu
// does it), then the kernel's own call. The lock program runs as root.
fn strom_aus() {
    var p_cmd: [u8; 13] = "/run/svc.cmd\0"
    var c_aus: [u8; 10] = "shutdown\n\0"
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_cmd[(0) as usize]) as u64, 577, 0)
    if !ulib.bad(fd) {
        ulib.sys(ulib.SYS_WRITE, fd, (&c_aus[(0) as usize]) as u64, 9)
        ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
        let _w: u64 = ulib.sleep_ms(500)
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.sys(SYS_REBOOT, RB_POWEROFF, 0, 0)
}

fn build() {
    let r: usize = fuiscene.root()
    let pad: u64 = 8
    let g: u64 = 8
    // the avatar's top edge at 30 % of the height
    var top: u64 = 4
    let want: u64 = s_bh * 30 / 100
    if want > pad + g + 4 {
        top = (want - pad - g) / 4 * 4
    }
    var left: u64 = 4
    let wantx: u64 = (s_bw - fuiscene.sp(signin.COL_W)) / 2
    if wantx > pad + 4 {
        left = (wantx - pad) / 4 * 4
    }
    let _t: usize = fuiscene.space(r, 4, top)
    let rw: usize = fuiscene.row(r)
    fuiscene.set_gap(rw, 0)
    let _l: usize = fuiscene.space(rw, left, 4)
    let col: usize = fuiscene.column(rw)
    fuiscene.set_size(col, fuiscene.sp(signin.COL_W), 0)
    fuiscene.set_gap(col, 0)
    let _av: usize = fuiscene.canvas(col, 0, fuiscene.sp(signin.COL_W), fuiscene.sp(signin.AV_D), p_avatar)
    let _s1: usize = fuiscene.space(col, 4, fuiscene.sp(signin.GAP_N))
    let _nn: usize = fuiscene.canvas(col, 0, fuiscene.sp(signin.COL_W), fuiscene.sp(36), p_name)
    let _st: usize = fuiscene.canvas(col, 0, fuiscene.sp(signin.COL_W), fuiscene.sp(32), p_status)
    let _s2: usize = fuiscene.space(col, 4, fuiscene.sp(12))
    let fr: usize = fuiscene.row(col)
    fuiscene.set_gap(fr, 4)
    let _e: usize = fuiscene.entry(fr, K_KENN, fuiscene.sp(signin.COL_W - 2 * signin.FIELD_H - 8), 0)
    fuiscene.entry_secret(K_KENN, !f_eye)
    fuiscene.ax_name(K_KENN, (&T_KENNW[(0) as usize]) as u64)
    let _y: usize = fuiscene.tile(fr, K_EYE, (&T_AUGE[(0) as usize]) as u64,
        fuiscene.sp(signin.FIELD_H), fuiscene.sp(signin.FIELD_H), f_eye, 1, tile_paint)
    let _gb: usize = fuiscene.tile(fr, K_GO, (&T_AUF[(0) as usize]) as u64,
        fuiscene.sp(signin.FIELD_H), fuiscene.sp(signin.FIELD_H), true, 2, tile_paint)
    let _s3: usize = fuiscene.space(col, 4, fuiscene.sp(16))
    let _h: usize = fuiscene.canvas(col, 0, fuiscene.sp(signin.COL_W), fuiscene.sp(24), p_hint)
    // ---- the bottom strip. NOT in the bottom 56 points: that strip belongs
    // to the task bar's window, which exists (unpainted) behind this screen.
    var qa_h: u64 = fuiscene.sp(signin.FIELD_H)
    if f_pm {
        qa_h = qa_h + fuiscene.sp(96) + 4
    }
    let col_h: u64 = fuiscene.sp(signin.AV_D + signin.GAP_N + 36 + 32 + 12 + signin.FIELD_H + 16 + 24)
    var rest: u64 = 4
    let sum: u64 = 2 * pad + 4 * g + top + col_h + qa_h + fuiscene.sp(56 + 8)
    if s_bh > sum + 4 {
        rest = s_bh - sum
    }
    let _gs: usize = fuiscene.space(r, 4, rest)
    let bt: usize = fuiscene.row(r)
    fuiscene.set_gap(bt, 0)
    let _m0: usize = fuiscene.space(bt, fuiscene.sp(24), 4)
    let _chip: usize = fuiscene.canvas(bt, 0, fuiscene.sp(240), fuiscene.sp(signin.FIELD_H), p_chip)
    let cw: u64 = fuiscene.sp(44 + 2 * signin.FIELD_H)
    var mid: u64 = 4
    let fixed: u64 = fuiscene.sp(24 + 240 + 24) + cw + pad * 2
    if s_bw > fixed + 4 {
        mid = s_bw - fixed
    }
    let _m1: usize = fuiscene.space(bt, mid, 4)
    let qa: usize = fuiscene.column(bt)
    fuiscene.set_size(qa, cw, 0)
    fuiscene.set_gap(qa, 4)
    if f_pm {
        let c2: usize = fuiscene.card(qa)
        fuiscene.set_pad(c2, 8)
        fuiscene.set_gap(c2, 4)
        let _b1: usize = fuiscene.button(c2, (&T_SCHLAF[(0) as usize]) as u64, K_SLEEP)
        let _b2: usize = fuiscene.button(c2, (&T_AUS[(0) as usize]) as u64, K_OFF)
    }
    let bar: usize = fuiscene.row(qa)
    fuiscene.set_gap(bar, 0)
    let _d: usize = fuiscene.canvas(bar, 0, fuiscene.sp(44), fuiscene.sp(signin.FIELD_H), signin.paint_deu)
    let _n: usize = fuiscene.canvas(bar, 0, fuiscene.sp(signin.FIELD_H), fuiscene.sp(signin.FIELD_H), p_net)
    let _p: usize = fuiscene.tile(bar, K_POWER, (&T_STROM[(0) as usize]) as u64,
        fuiscene.sp(signin.FIELD_H), fuiscene.sp(signin.FIELD_H), f_pm, 3, tile_paint)
    let _bs: usize = fuiscene.space(r, 4, fuiscene.sp(56 + 8))
}

static mut T_AUGE: [u8; 18] = "Kennwort anzeigen\0"
static mut T_KENNW: [u8; 9] = "Kennwort\0"

fn u_gui() -> u64 {
    var s_bad: [u8; 20] = "lock: keine Flaeche\0"
    var s_go: [u8; 15] = "sperre: bereit\0"
    var s_geom: [u8; 16] = "sperre: geom w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_pid: [u8; 21] = "sperre: sperrer pid=\0"
    var s_fui: [u8; 23] = "sperre: fUi Szenenbaum\0"
    // `noclip`: the screen-filling window of the locker (as wlib.begin had it)
    fuiscene.set_flags(false, true)
    if !fuiscene.begin() {
        say((&s_bad[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    // LOCK FIRST, THEN PAINT: the other way round there would be a moment
    // in which the password question stands and the keyboard still belongs
    // to the session below.
    let _a: u64 = sy(OP_AN, 0)
    let _i: u64 = sy(OP_ICH, 0)
    whoami()
    initial_set()
    s_bw = wlibc.screen_w()
    s_bh = wlibc.screen_h()
    if hat_kennwort() {
        ulib.strcpy((&kopf[(0) as usize]) as u64,
            (&T_FRAGE[(0) as usize]) as u64)
    } else {
        ulib.strcpy((&kopf[(0) as usize]) as u64,
            (&T_KEIN[(0) as usize]) as u64)
    }
    if !fuiscene.open_plain(0, 0, s_bw, s_bh, (&T_TITEL[(0) as usize]) as u64,
        wlibc.L_TOP, build) {
        say((&s_bad[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    fuiscene.set_app((&T_APP[(0) as usize]) as u64)
    var p_wall: [u8; 15] = "/etc/wallpaper\0"
    if !backdrop.load((&p_wall[(0) as usize]) as u64, 3, 256) {
        backdrop.flat(0x2A4468, 0x0B1424)
    }
    let _nu: bool = net_update()
    fuiscene.refresh()
    say((&s_fui[(0) as usize]) as u64)
    ulib.nl()
    say((&s_geom[(0) as usize]) as u64)
    ulib.sayn(s_bw)
    say((&s_h[(0) as usize]) as u64)
    ulib.sayn(s_bh)
    ulib.nl()
    say((&s_pid[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 4))
    ulib.nl()

    var offen: bool = false
    var first: bool = true
    // NO ROUND LIMIT (24.09.2026): the loop sleeps when idle; a limit made
    // the screen end, the kernel restarted it, and what was typed was gone.
    while fuiscene.alive() && !offen {
        let key: u64 = fuiscene.pump()
        if first {
            first = false
            fuiscene.focus(K_KENN)
            var s_nm: [u8; 5] = "lock\0"
            fuiscene.say_rects((&s_nm[(0) as usize]) as u64)
            fuiscene.say_texts()
            say((&s_go[(0) as usize]) as u64)
            ulib.nl()
        }
        if key == K_KENN || key == K_GO {
            offen = versuchen()
            if !offen {
                fuiscene.focus(K_KENN)
            }
        } else if key == K_EYE {
            f_eye = !f_eye
            fuiscene.refresh()
        } else if key == K_POWER {
            f_pm = !f_pm
            fuiscene.refresh()
        } else if key == K_SLEEP {
            f_pm = false
            fuiscene.refresh()
            let _s: u64 = sy(11, 0)
        } else if key == K_OFF {
            strom_aus()
        }
        let tnow: u64 = fuiapp.now_ms()
        if tnow > net_t + 1000 {
            net_t = tnow
            if net_update() {
                fuiscene.refresh()
            }
        }
        // THE WINDOW CANNOT BE CLOSED: `alive` turns false when the server
        // sends a close event; while the lock stands the program ends with 1
        // and the kernel starts it again.
        if !fuiscene.alive() && sy(OP_STATE, 0) == 1 {
            return 1
        }
    }
    leeren()
    // OPEN MEANS: THE WINDOW IS GONE (measured 13.09.: after "aufgesperrt"
    // the window kept standing and painting; a lock screen that stays after
    // the right password is indistinguishable from one that refused it).
    wlib.close(fuiscene.win_id())
    wlib.draw_all()
    return 0
}

// ------------------------------------------------------- der Waechter

fn leerlauf_grenze() -> u64 {
    // Sekunden aus /etc/sperre.conf; 0 heisst: nie von selbst.
    var buf: [u8; 512] = [0 as u8; 512]
    let fd: u64 = io.open((&T_CONF[(0) as usize]) as u64, 0)
    if ulib.bad(fd) {
        return 0
    }
    let b: u64 = (&buf[(0) as usize]) as u64
    let n: u64 = io.read(fd, b, 500)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return 0
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    let at: u64 = ulib.find(b, (&K_LEER[(0) as usize]) as u64)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return ulib.to_num(b + at + ulib.length((&K_LEER[(0) as usize]) as u64))
}

fn u_wache(einmal: bool) -> u64 {
    var s_start: [u8; 28] = "sperre: Waechter, Leerlauf \0"
    var s_s: [u8; 3] = " s\0"
    var s_aus: [u8; 34] = "sperre: Waechter aus (leerlauf=0)\0"
    var s_an: [u8; 36] = "sperre: Leerlauf abgelaufen, sperre\0"
    let grenze: u64 = leerlauf_grenze()
    if grenze == 0 {
        say((&s_aus[(0) as usize]) as u64)
        ulib.nl()
        return 0
    }
    say((&s_start[(0) as usize]) as u64)
    ulib.sayn(grenze)
    say((&s_s[(0) as usize]) as u64)
    ulib.nl()
    var runden: u64 = 0
    while runden < 4000000 {
        runden = runden + 1
        let _s: u64 = ulib.sleep_ms(250)
        if sy(OP_STATE, 0) == 0 {
            let idle: u64 = sy(OP_IDLE, 0)
            if !ulib.bad(idle) && idle >= grenze * 1000 {
                say((&s_an[(0) as usize]) as u64)
                ulib.nl()
                let _a: u64 = sy(OP_AN, 0)
                if einmal {
                    runden = 4000000
                }
            }
        }
    }
    return 0
}

fn u_say() -> u64 {
    var s_1: [u8; 12] = "sperre: an=\0"
    var s_2: [u8; 13] = " sperrungen=\0"
    var s_3: [u8; 16] = " aufsperrungen=\0"
    var s_4: [u8; 15] = " fehlversuche=\0"
    var s_5: [u8; 12] = " neustarts=\0"
    var s_6: [u8; 6] = " pid=\0"
    var s_7: [u8; 14] = " leerlauf_ms=\0"
    say((&s_1[(0) as usize]) as u64)
    ulib.sayn(sy(OP_STATE, 0))
    say((&s_2[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 0))
    say((&s_3[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 1))
    say((&s_4[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 2))
    say((&s_5[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 3))
    say((&s_6[(0) as usize]) as u64)
    ulib.sayn(sy(OP_NUM, 4))
    say((&s_7[(0) as usize]) as u64)
    ulib.sayn(sy(OP_IDLE, 0))
    ulib.nl()
    return 0
}

fn u_start(args: u64) -> u64 {
    var s_d: [u8; 3] = "-d\0"
    var s_s: [u8; 3] = "-s\0"
    var s_an: [u8; 4] = "-an\0"
    var s_ab: [u8; 9] = "-absturz\0"
    let argc: u64 = ulib.arg_count(args)
    if argc >= 2 {
        let a: u64 = ulib.arg_at(args, 1)
        if ulib.streq(a, (&s_d[(0) as usize]) as u64) {
            var einmal: bool = false
            if argc >= 3 {
                var s_e: [u8; 7] = "einmal\0"
                einmal = ulib.streq(ulib.arg_at(args, 2),
                    (&s_e[(0) as usize]) as u64)
            }
            return u_wache(einmal)
        }
        if ulib.streq(a, (&s_s[(0) as usize]) as u64) {
            return u_say()
        }
        // DIE GEGENPROBE ZUM AUSFALLZUSTAND, und sie gehoert in das
        // Programm, das sie betrifft: sperren, sich eintragen, das
        // sagen -- und dann mit voller Absicht sterben. Was DANACH
        // passiert, ist die Zusage: der Kern startet den Sperrer neu
        // und die Sperre bleibt stehen. Ein Absturz darf sperren, aber
        // niemals aufsperren.
        if ulib.streq(a, (&s_ab[(0) as usize]) as u64) {
            let _x: u64 = sy(OP_AN, 0)
            let _y: u64 = sy(OP_ICH, 0)
            var s_boom: [u8; 41] = "sperre: Sperrer stirbt jetzt mit Absicht\0"
            say((&s_boom[(0) as usize]) as u64)
            ulib.nl()
            let _z: u64 = u_say()
            __mmio_write8((0) as *mut u8, 1 as u8)
            return 0
        }
        if ulib.streq(a, (&s_an[(0) as usize]) as u64) {
            // Nur sperren, ohne Fenster -- der Kern startet dann den
            // Sperrer. Das ist der Weg, den die Abnahme nimmt, um den
            // Ausfallzustand zu pruefen.
            let _r: u64 = sy(OP_AN, 0)
            return u_say()
        }
    }
    return u_gui()
}

// RUNDE ROTABSCHNITTE: DIESES `main` LAEUFT, UND ES MUSS DIE
// ARGUMENTE WEITERGEBEN.
//
// Der Kommentar, der hier stand, sagte "das `main`, das nie laeuft --
// `user.ld` springt nach `u_start`". Das stimmt fuer ein Programm, das
// mit `kernel/user/crt.s` gebunden ist; dessen `_start` ruft
// USER_ENTRY. Unter `profile app` stimmt es NICHT: dort bringt firnc
// sein eigenes `_start` mit (darum darf crt.o nicht dazu, siehe
// tools/look/shot.sh), und das endet in `call main` -- der Name steht
// fest in lib/firnc1/codegen.fi, `--defsym=USER_ENTRY` erreicht ihn
// nicht. Am gebauten ELF nachgesehen: Einsprung ist `_start`, sechs
// Befehle weiter steht `call <main>`; `_F0.u_start` wird von dort nie
// gerufen.
//
// `u_start(0)` warf damit den Argumentblock weg. Bei powermon waren
// das 54 rote Zusagen (siehe ROTABSCHNITTE 11/n).
//
// Der Block liegt an einer FESTEN Adresse: Runde K16 legte den
// Stapelzeiger darauf (kernel/elf.fi, `T_USTACK = proc.ARGS_BASE`),
// und firnc's `_start` macht `mov rsp, rdi`. Jede `elf: start`-Zeile
// dieses Systems druckt sie als `ustack=0x4007f000`.
fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
