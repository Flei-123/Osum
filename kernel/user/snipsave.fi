profile app

import ulib
import libc.io
import tools
import wlibc
import xfer
import image
import msg
import snipgrab

export { next_path, save_png, clipboard_put, toast }

static mut path_buf: [u8; 256] = [0 as u8; 256]
static mut clip_buf: [u8; 288] = [0 as u8; 288]
static mut toast_buf: [u8; 320] = [0 as u8; 320]

fn num_cat(p: u64, v: u64) {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = ulib.digits(v, (&z[0 as usize]) as u64)
    z[n as usize] = 0 as u8
    ulib.strcat(p, (&z[0 as usize]) as u64)
}

fn next_path() -> u64 {
    var root: [u8; 8] = "/bilder\0"
    var dir: [u8; 20] = "/bilder/Screenshots\0"
    var stem: [u8; 32] = "/bilder/Screenshots/Screenshot-\0"
    var ext: [u8; 5] = ".png\0"
    let p: u64 = (&path_buf[0 as usize]) as u64
    let _a: u64 = io.make_dir((&root[0 as usize]) as u64)
    let _b: u64 = io.make_dir((&dir[0 as usize]) as u64)
    var i: u64 = 1
    while i < 10000 {
        ulib.strcpy(p, (&stem[0 as usize]) as u64)
        num_cat(p, i)
        ulib.strcat(p, (&ext[0 as usize]) as u64)
        let fd: u64 = io.open(p, 0)
        if ulib.bad(fd) {
            return p
        }
        io.close(fd)
        i = i + 1
    }
    return p
}

fn save_png(path: u64, px: u64, w: u64, h: u64) -> bool {
    let fd: u64 = tools.openw(path)
    if ulib.bad(fd) {
        return false
    }
    let ok: bool = image.png_file(fd, px, w, h, snipgrab.roh(), snipgrab.ROHCAP, snipgrab.komp(), snipgrab.KOMPCAP)
    io.close(fd)
    return ok
}

fn clipboard_put(path: u64) {
    var tag: [u8; 6] = "bild:\0"
    var say_typ: [u8; 17] = "snipt: clip typ=\0"
    let c: u64 = (&clip_buf[0 as usize]) as u64
    if !ulib.bad(xfer.set_file(xfer.SEL_CLIPBOARD, xfer.MIME_PNG, path)) {
        ulib.say((&say_typ[0 as usize]) as u64)
        ulib.sayn(wlibc.clip_hist_typ(0))
        ulib.nl()
        return
    }
    ulib.strcpy(c, (&tag[0 as usize]) as u64)
    ulib.strcat(c, path)
    let _r: u64 = wlibc.clip_put_typ(wlibc.BT_IMAGE | wlibc.BT_TEXT, c, ulib.length(c))
    ulib.say((&say_typ[0 as usize]) as u64)
    ulib.sayn(wlibc.clip_hist_typ(0))
    ulib.nl()
}

fn toast(path: u64) {
    var key: [u8; 11] = "snip.toast\0"
    var sep: [u8; 3] = ": \0"
    var said: [u8; 15] = "snipt: toast: \0"
    let t: u64 = (&toast_buf[0 as usize]) as u64
    ulib.strcpy(t, msg.get((&key[0 as usize]) as u64))
    ulib.strcat(t, (&sep[0 as usize]) as u64)
    ulib.strcat(t, path)
    let _r: u64 = ulib.noti_post(1, t, ulib.length(t))
    ulib.say((&said[0 as usize]) as u64)
    ulib.say(t)
    ulib.nl()
}
