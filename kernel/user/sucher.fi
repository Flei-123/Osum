fn say(p: u64) {
    let _s: u64 = ulib.say(p)
}

fn kv(name: u64, v: u64) {
    say(name)
    ulib.sayn(v)
}

fn tlen(p: u64) -> u64 {
    return ulib.length(p)
}

fn rd(p: u64, i: u64) -> u64 {
    return __mmio_read8((p + i) as *mut u8) as u64
}

fn wr(p: u64, i: u64, v: u64) {
    __mmio_write8((p + i) as *mut u8, v as u8)
}

fn now_ns() -> u64 {
    return nidx.mono_us() *% 1000
}

fn now_us() -> u64 {
    return nidx.mono_us()
}

// ================================================ DIE FALTUNG
//
// Gross wird klein, und zwar AUCH bei den Buchstaben mit Zeichen darauf.
// Siehe den Kopf dieser Datei; hier steht nur noch die Rechnung.
fn fold(src: u64, n: u64, dst: u64, max: u64) -> u64 {
    var i: u64 = 0
    var o: u64 = 0
    while i < n && o + 3 < max {
        let c: u64 = rd(src, i)
        if c == 0 {
            i = n
        } else if c >= 65 && c <= 90 {
            wr(dst, o, c + 32)
            o = o + 1
            i = i + 1
        } else if c == 0xC3 && i + 1 < n {
            o = o + latin1(rd(src, i + 1), dst + o)
            i = i + 2
        } else {
            wr(dst, o, c)
            o = o + 1
            i = i + 1
        }
    }
    wr(dst, o, 0)
    return o
}

// EIN BUCHSTABE MIT ZEICHEN WIRD ZU DEM BUCHSTABEN DARUNTER, und die
// deutschen werden zu ZWEIEN. Hier ist die Tafel, und hier ist die
// Begruendung fuer jede der drei Zeilen, die man anders haette machen
// koennen:
//
//   ae, oe, ue, ss STATT a, o, u, s. Das ist die deutsche Umschrift
//   (DIN 5007-2, dieselbe, die im Reisepass steht), und sie ist die
//   einzige, die BEIDE Richtungen kann: wer "Groesse" tippt, findet
//   "Groesse" mit Umlaut, und wer "gro" tippt, findet es auch -- denn
//   das gefaltete Wort faengt mit g-r-o an. Mit "o" allein waere die
//   erste Haelfte weg.
//
//   ALLE ANDEREN werden EIN Buchstabe: e mit Akzent -> e, n mit Tilde
//   -> n, c mit Haken -> c. Die deutsche Verdopplung ist eine deutsche
//   Regel und keine allgemeine; sie auf ein franzoesisches e zu legen,
//   waere aus "Cafe" ein "Cafee" und damit ein Wort, das niemand tippt.
//
//   0xC3 0x9F IST NICHT DAS GROSSE VON 0xC3 0xBF. In diesem Block ist
//   das kleine ueberall 0x20 ueber dem grossen -- ausser hier: 0x9F ist
//   das scharfe s (U+00DF), 0xBF ist das y mit zwei Punkten (U+00FF).
//   Wer die Regel blind anwendet, faltet das scharfe s auf ein y. Das
//   ist genau der Fehler, den diese Zeile verhindert, und er waere in
//   keinem Bild zu sehen gewesen.
//
// WAS DIESE TAFEL NICHT KANN: alles jenseits von U+00FF -- das
// tschechische c mit Haken, das polnische l mit Strich, das
// tuerkische i ohne Punkt. Die kommen als 0xC4/0xC5 und gehen
// UNVERAENDERT durch; sie finden sich selbst und sonst nichts. Eine
// halbe Tabelle waere schlimmer als eine, deren Grenze aufgeschrieben
// ist.
fn latin1(b: u64, dst: u64) -> u64 {
    // das scharfe s, vor der Regel
    if b == 0x9F {
        wr(dst, 0, 115)
        wr(dst, 1, 115)
        return 2
    }
    // Mal- und Geteiltzeichen sind keine Buchstaben.
    if b == 0x97 || b == 0xB7 {
        wr(dst, 0, 0xC3)
        wr(dst, 1, b)
        return 2
    }
    var k: u64 = b
    if k >= 0x80 && k < 0xA0 {
        k = k + 0x20
    }
    if k < 0xA0 || k > 0xBF {
        wr(dst, 0, 0xC3)
        wr(dst, 1, b)
        return 2
    }
    // die vier deutschen: ae, oe, ue -- und ein zweites ae fuer die
    // Ligatur, die im selben Block liegt
    if k == 0xA4 || k == 0xA6 {
        wr(dst, 0, 97)
        wr(dst, 1, 101)
        return 2
    }
    if k == 0xB6 {
        wr(dst, 0, 111)
        wr(dst, 1, 101)
        return 2
    }
    if k == 0xBC {
        wr(dst, 0, 117)
        wr(dst, 1, 101)
        return 2
    }
    // das Dorn, zwei Buchstaben in jeder Umschrift
    if k == 0xBE {
        wr(dst, 0, 116)
        wr(dst, 1, 104)
        return 2
    }
    var g: u64 = 0
    if k <= 0xA5 {
        g = 97 // a
    } else if k == 0xA7 {
        g = 99 // c
    } else if k <= 0xAB {
        g = 101 // e
    } else if k <= 0xAF {
        g = 105 // i
    } else if k == 0xB0 {
        g = 100 // d
    } else if k == 0xB1 {
        g = 110 // n
    } else if k <= 0xB5 {
        g = 111 // o
    } else if k == 0xB8 {
        g = 111 // o mit Strich
    } else if k <= 0xBB {
        g = 117 // u
    } else {
        g = 121 // y
    }
    wr(dst, 0, g)
    return 1
}

// Ist das Oktett davor ein Trennzeichen? Dann faengt hier ein Wort an.
// Ein Fortsetzungsoktett (>= 0x80) ist KEINES -- mitten in einem Umlaut
// faengt kein Wort an.
fn ist_trenner(c: u64) -> bool {
    return c == 32 || c == 9 || c == 45 || c == 95 || c == 46 || c == 47
        || c == 44 || c == 58 || c == 40 || c == 91
}

// Wo steht `nadel` in `heu`? NICHTS, wenn nirgends. Beide sind schon
// gefaltet -- die Faltung passiert einmal je Zeichenkette und nicht
// einmal je Vergleich.
fn stelle(heu: u64, hn: u64, nadel: u64, nn2: u64) -> u64 {
    if nn2 == 0 {
        return 0
    }
    if nn2 > hn {
        return NICHTS
    }
    var i: u64 = 0
    while i + nn2 <= hn {
        var k: u64 = 0
        var gleich: bool = true
        while k < nn2 {
            if rd(heu, i + k) != rd(nadel, k) {
                gleich = false
                k = nn2
            } else {
                k = k + 1
            }
        }
        if gleich {
            return i
        }
        i = i + 1
    }
    return NICHTS
}

// DER RANG EINES NAMENS. Die eine Funktion, in der die Ordnung dieser
// Runde steht.
fn rang(p: u64, n: u64) -> u64 {
    let hp: u64 = (&hf[0 as usize]) as u64
    let hn: u64 = fold(p, n, hp, FMAX)
    if qfn == 0 {
        return RK_START
    }
    let qp: u64 = (&qf[0 as usize]) as u64
    if hn == qfn {
        if stelle(hp, hn, qp, qfn) == 0 {
            return RK_EXACT
        }
    }
    let at: u64 = stelle(hp, hn, qp, qfn)
    if at == NICHTS {
        return RK_NONE
    }
    if at == 0 {
        return RK_START
    }
    if ist_trenner(rd(hp, at - 1)) {
        return RK_START
    }
    return RK_MID
}

// ================================================== FUER DEN LAEUFER
//
// DIESELBE RECHNUNG, VON AUSSEN AUFRUFBAR. Die Ordnung dieser Runde ist
// ihr eigentlicher Wert, und eine Ordnung, die man nur an einem
// Bildschirmfoto ablesen kann, ist schlecht gemessen: ein Foto sagt,
// WAS oben steht, aber nicht, WARUM. `/bin/sucht` ruft diese beiden
// und schreibt die Zahlen auf die Standardausgabe -- derselbe Gedanke
// wie `/bin/locate` fuer den Namensindex.
//
// Es sind KEINE zweiten Fassungen der Rechnung. Es sind Zeiger auf die
// erste; genau deshalb misst der Laeufer, was das Fenster tut.
fn probe(query: u64, name: u64) -> u64 {
    let qp: u64 = (&q[0 as usize]) as u64
    qn = 0
    var k: u64 = 0
    while rd(query, k) != 0 && qn + 1 < QMAX {
        wr(qp, qn, rd(query, k))
        qn = qn + 1
        k = k + 1
    }
    wr(qp, qn, 0)
    qfn = fold(qp, qn, (&qf[0 as usize]) as u64, QMAX)
    return rang(name, tlen(name))
}

fn falten(src: u64, dst: u64, max: u64) -> u64 {
    return fold(src, tlen(src), dst, max)
}

// Steht die Eingabe irgendwo in dieser Zeichenkette? Fuer Beschreibung
// und Schluesselwoerter, wo der Rang nicht zaehlt -- nur ob ueberhaupt.
fn drin(p: u64) -> bool {
    if qfn == 0 {
        return true
    }
    let hp: u64 = (&hf[0 as usize]) as u64
    let hn: u64 = fold(p, tlen(p), hp, FMAX)
    return stelle(hp, hn, (&qf[0 as usize]) as u64, qfn) != NICHTS
}

// Ein Name aus dem Index ist 24 Oktette und muss keine Null am Ende
// haben. Hier bekommt er eine.
fn name24(i: u64) -> u64 {
    let q2: u64 = nidx.name_at(i)
    let d: u64 = (&nbuf[0 as usize]) as u64
    var k: u64 = 0
    while k < nidx.NAMEN {
        let c: u64 = rd(q2, k)
        wr(d, k, c)
        if c == 0 {
            k = nidx.NAMEN
        } else {
            k = k + 1
        }
    }
    wr(d, nidx.NAMEN, 0)
    return d
}

// ============================================= DAS HEIMATVERZEICHNIS
//
// WELCHES ES IST. `/etc/passwd`, das Feld hinter der fuenften Doppelpunkt-
// Trennung, fuer die eigene Kennung. Gibt es keine Zeile dafuer oder kein
// solches Verzeichnis, wird die WURZEL genommen -- und das wird GEMELDET.
// Ein Filter, der still auf alles zurueckfaellt, ist ein Filter, von dem
// niemand weiss, dass er nicht greift.
fn heim_finden() {
    let uid: u64 = ulib.sys(107, 0, 0, 0)
    let hp: u64 = (&heim[0 as usize]) as u64
    wr(hp, 0, 0)
    let fd: u64 = io.open((&p_passwd[0 as usize]) as u64, 0)
    if !ulib.bad(fd) {
        let b: u64 = (&zbuf[0 as usize]) as u64
        let n: u64 = io.read(fd, b, 500)
        let _c: u64 = io.close(fd)
        if !ulib.bad(n) && n != 0 {
            var i: u64 = 0
            while i < n {
                // eine Zeile: name:x:uid:gid:info:heim:shell
                var e: u64 = i
                while e < n && rd(b, e) != 10 {
                    e = e + 1
                }
                var feld: u64 = 0
                var fs: u64 = i
                var k: u64 = i
                var u2: u64 = 0
                var ziffern: u64 = 0
                while k <= e {
                    if k == e || rd(b, k) == 58 {
                        if feld == 2 {
                            u2 = 0
                            ziffern = 0
                            var z: u64 = fs
                            while z < k {
                                let c2: u64 = rd(b, z)
                                if c2 >= 48 && c2 <= 57 {
                                    u2 = u2 * 10 + (c2 - 48)
                                    ziffern = ziffern + 1
                                }
                                z = z + 1
                            }
                        }
                        if feld == 5 && ziffern != 0 && u2 == uid {
                            var o: u64 = 0
                            var z2: u64 = fs
                            while z2 < k && o < 90 {
                                wr(hp, o, rd(b, z2))
                                o = o + 1
                                z2 = z2 + 1
                            }
                            wr(hp, o, 0)
                        }
                        feld = feld + 1
                        fs = k + 1
                    }
                    k = k + 1
                }
                i = e + 1
            }
        }
    }
    if rd(hp, 0) == 0 {
        ulib.strncpy(hp, (&p_wurzel[0 as usize]) as u64, 90)
    }
    heim_n = tlen(hp)
    heim_ino = nidx.ino_of_path(hp)
}

// WAS UNTER DEM HEIMATVERZEICHNIS LIEGT, einmal ausgerechnet.
//
// Die Kette nach oben, mit Merkzettel: `unter[i]` ist 2, solange die
// Frage offen ist. Ein Eintrag, dessen Elternteil schon beantwortet ist,
// kostet einen Schritt; der Rest kostet die Tiefe. Eine Wache gegen
// einen Baum, dessen Eltern im Kreis zeigen -- ein Index, der haengt,
// ist schlimmer als einer, der irrt.
fn heim_markieren() -> u64 {
    let n: u64 = nidx.count()
    var i: u64 = 0
    while i < n {
        unter[(i) as usize] = 2 as u8
        i = i + 1
    }
    // Die Wurzel als Heimat heisst: alles zaehlt.
    if heim_ino == 0 || heim_n <= 1 {
        i = 0
        while i < n {
            unter[(i) as usize] = 1 as u8
            i = i + 1
        }
        return n
    }
    var ja: u64 = 0
    i = 0
    while i < n {
        if unter[(i) as usize] == 2 as u8 {
            // die Kette hinauf sammeln
            var kette: [u64; 20] = [0 as u64; 20]
            var tief: u64 = 0
            var wo: u64 = i
            var ergebnis: u64 = 0
            var weiter: bool = true
            while weiter && tief < 20 {
                if nidx.ino_at(wo) == heim_ino {
                    ergebnis = 1
                    weiter = false
                } else if unter[(wo) as usize] != 2 as u8 {
                    ergebnis = unter[(wo) as usize] as u64
                    weiter = false
                } else {
                    kette[(tief) as usize] = wo
                    tief = tief + 1
                    let el: u64 = nidx.parent_at(wo)
                    if el == 0 {
                        weiter = false
                    } else {
                        let s2: u64 = nidx.slot_of_ino(el)
                        if s2 >= n {
                            weiter = false
                        } else {
                            wo = s2
                        }
                    }
                }
            }
            var t2: u64 = 0
            while t2 < tief {
                unter[(kette[(t2) as usize]) as usize] = ergebnis as u8
                t2 = t2 + 1
            }
        }
        if unter[(i) as usize] == 1 as u8 {
            ja = ja + 1
        }
        i = i + 1
    }
    return ja
}

// ============================================== DIE EINSTELLUNGSSEITEN
//
// Aus dem Katalog, nicht aus dem Quelltext. `settings.tabs` ist eine
// Zeile je Reiter, und dasselbe liest das Programm, das sie zeigt.
fn seiten_lesen() {
    var k_tabs: [u8; 14] = "settings.tabs\0"
    let p: u64 = msg.get((&k_tabs[0 as usize]) as u64)
    let d: u64 = (&setbuf[0 as usize]) as u64
    setn = 0
    var o: u64 = 0
    var i: u64 = 0
    var anfang: u64 = 0
    let n: u64 = tlen(p)
    while i <= n && setn < SETMAX {
        if i == n || rd(p, i) == 10 {
            if i > anfang {
                setp[(setn) as usize] = d + o
                var z: u64 = anfang
                while z < i && o < 250 {
                    wr(d, o, rd(p, z))
                    o = o + 1
                    z = z + 1
                }
                wr(d, o, 0)
                o = o + 1
                setn = setn + 1
            }
            anfang = i + 1
        }
        i = i + 1
    }
}

fn seite_name(i: u64) -> u64 {
    if i >= setn {
        return (&t_title[0 as usize]) as u64
    }
    return setp[(i) as usize]
}

// ================================================ WAS ZULETZT LIEF
//
// Eine Datei, drei Felder je Zeile: wie oft, wann zuletzt, welcher
// Befehl. Sie liegt in /etc und nicht im Benutzerverzeichnis, weil
// dieser Zweig noch keine Benutzerverzeichnisse anlegt; sobald die Runde
// MULTIUSER drin ist, ist das eine Zeile (`heim` steht schon da).
// Solange steht es hier, damit es niemand fuer mehr haelt, als es ist.
fn zahlen_lesen() {
    var i: u64 = 0
    while i < 16 {
        zahl[(i) as usize] = 0
        zletzt[(i) as usize] = 0
        i = i + 1
    }
    zseq = 0
    let fd: u64 = io.open((&p_zahl[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return
    }
    let b: u64 = (&zbuf[0 as usize]) as u64
    let n: u64 = io.read(fd, b, 500)
    let _c: u64 = io.close(fd)
    if ulib.bad(n) || n == 0 {
        return
    }
    var at: u64 = 0
    while at < n {
        var e: u64 = at
        while e < n && rd(b, e) != 10 {
            e = e + 1
        }
        // <zahl> <seq> <befehl>
        var k: u64 = at
        var wieoft: u64 = 0
        while k < e && rd(b, k) >= 48 && rd(b, k) <= 57 {
            wieoft = wieoft * 10 + (rd(b, k) - 48)
            k = k + 1
        }
        while k < e && rd(b, k) == 32 {
            k = k + 1
        }
        var wann: u64 = 0
        while k < e && rd(b, k) >= 48 && rd(b, k) <= 57 {
            wann = wann * 10 + (rd(b, k) - 48)
            k = k + 1
        }
        while k < e && rd(b, k) == 32 {
            k = k + 1
        }
        if k < e {
            // den Befehl in `nbuf` ausleihen und gegen das Verzeichnis
            // halten
            let d: u64 = (&hf[0 as usize]) as u64
            var o: u64 = 0
            while k < e && o < 150 {
                wr(d, o, rd(b, k))
                o = o + 1
                k = k + 1
            }
            wr(d, o, 0)
            var a2: u64 = 0
            while a2 < appdir.count() {
                if ulib.streq(appdir.exec_of(a2), d) {
                    zahl[(a2) as usize] = wieoft
                    zletzt[(a2) as usize] = wann
                    if wann > zseq {
                        zseq = wann
                    }
                    a2 = appdir.count()
                } else {
                    a2 = a2 + 1
                }
            }
        }
        at = e + 1
    }
}

fn zahlen_schreiben() {
    let fd: u64 = io.create((&p_zahl[0 as usize]) as u64)
    if ulib.bad(fd) {
        return
    }
    var i: u64 = 0
    while i < appdir.count() && i < 16 {
        if zahl[(i) as usize] != 0 {
            let b: u64 = (&zbuf[0 as usize]) as u64
            var o: u64 = 0
            o = o + zahl_in(b + o, zahl[(i) as usize])
            wr(b, o, 32)
            o = o + 1
            o = o + zahl_in(b + o, zletzt[(i) as usize])
            wr(b, o, 32)
            o = o + 1
            let ex: u64 = appdir.exec_of(i)
            var k: u64 = 0
            while rd(ex, k) != 0 && o < 400 {
                wr(b, o, rd(ex, k))
                o = o + 1
                k = k + 1
            }
            wr(b, o, 10)
            o = o + 1
            let _w: u64 = io.write_all(fd, b, o)
        }
        i = i + 1
    }
    let _c: u64 = io.close(fd)
}

// Eine Zahl als Text, ohne Bibliothek -- `ulib.sayn` schreibt auf die
// serielle Leitung und nicht in einen Puffer.
fn zahl_in(p: u64, v: u64) -> u64 {
    if v == 0 {
        wr(p, 0, 48)
        return 1
    }
    var ziffern: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    while x != 0 && n < 24 {
        ziffern[(n) as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    var k: u64 = 0
    while k < n {
        wr(p, k, ziffern[((n - 1 - k)) as usize] as u64)
        k = k + 1
    }
    return n
}

// ==================================================== DIE SUCHE SELBST

fn nimm(src: u64, ix: u64, rk: u64) {
    if nh >= MAXH {
        return
    }
    h_src[(nh) as usize] = src as u8
    h_ix[(nh) as usize] = ix
    h_rk[(nh) as usize] = rk as u8
    h_key[(nh) as usize] = rk * 4 + src
    nh = nh + 1
}

// EINFUEGESORTIERUNG, und sie ist STABIL. Das ist keine Nebensache: bei
// gleichem Schluessel bleibt die Reihenfolge, in der gesammelt wurde --
// Programme in Verzeichnisordnung, Dateien in Indexordnung. Ein
// instabiles Verfahren wuerde dieselbe Suche zweimal verschieden
// beantworten, und niemand koennte sagen, warum.
fn sortieren() {
    var i: u64 = 1
    while i < nh {
        let ks: u64 = h_key[(i) as usize]
        let qs: u64 = h_src[(i) as usize] as u64
        let rs: u64 = h_rk[(i) as usize] as u64
        let is2: u64 = h_ix[(i) as usize]
        var k: u64 = i
        while k > 0 && h_key[((k - 1)) as usize] > ks {
            h_key[(k) as usize] = h_key[((k - 1)) as usize]
            h_src[(k) as usize] = h_src[((k - 1)) as usize]
            h_rk[(k) as usize] = h_rk[((k - 1)) as usize]
            h_ix[(k) as usize] = h_ix[((k - 1)) as usize]
            k = k - 1
        }
        h_key[(k) as usize] = ks
        h_src[(k) as usize] = qs as u8
        h_rk[(k) as usize] = rs as u8
        h_ix[(k) as usize] = is2
        i = i + 1
    }
}

// OHNE EINGABE: die haeufigsten Programme, bei Gleichstand das zuletzt
// benutzte. Der Schluessel wird so gedreht, dass die STEIGENDE Sortierung
// oben von selbst richtig steht.
fn zuletzt_sammeln() {
    var i: u64 = 0
    while i < appdir.count() && nh < MAXH {
        var k: u64 = 0
        if i < 16 {
            let c: u64 = zahl[(i) as usize]
            var cc: u64 = c
            if cc > 4000 {
                cc = 4000
            }
            var ll: u64 = zletzt[(i) as usize]
            if ll > 4000 {
                ll = 4000
            }
            k = (4000 - cc) * 8192 + (4000 - ll)
        } else {
            k = 4000 * 8192 + 4000
        }
        h_src[(nh) as usize] = S_APP as u8
        h_ix[(nh) as usize] = i
        h_rk[(nh) as usize] = RK_START as u8
        h_key[(nh) as usize] = k
        nh = nh + 1
        n_app = n_app + 1
        i = i + 1
    }
}

fn suchen() {
    let t_a: u64 = now_us()
    nh = 0
    n_app = 0
    n_file = 0
    n_set = 0
    qfn = fold((&q[0 as usize]) as u64, qn, (&qf[0 as usize]) as u64, QMAX)
    if qfn == 0 {
        zuletzt_sammeln()
        sortieren()
        find_us = now_us() -% t_a
        return
    }
    // 1. die Programme
    var i: u64 = 0
    while i < appdir.count() && nh < MAXH {
        var rk: u64 = rang(appdir.name_of(i), tlen(appdir.name_of(i)))
        if rk == RK_NONE {
            if drin(appdir.info_of(i)) || drin(appdir.keys_of(i)) {
                rk = RK_OTHER
            }
        }
        if rk != RK_NONE {
            nimm(S_APP, i, rk)
            n_app = n_app + 1
        }
        i = i + 1
    }
    // 2. die Dateien im Heimatverzeichnis
    if idx_ok != 0 {
        var k: u64 = 0
        let n: u64 = nidx.count()
        while k < n && nh < MAXH {
            if unter[(k) as usize] == 1 as u8 && !nidx.is_dir_at(k) {
                let p: u64 = name24(k)
                let rk2: u64 = rang(p, tlen(p))
                if rk2 != RK_NONE && rk2 != RK_OTHER {
                    nimm(S_FILE, k, rk2)
                    n_file = n_file + 1
                }
            }
            k = k + 1
        }
    }
    // 3. die Einstellungsseiten
    var s2: u64 = 0
    while s2 < setn && nh < MAXH {
        let p2: u64 = seite_name(s2)
        let rk3: u64 = rang(p2, tlen(p2))
        if rk3 != RK_NONE && rk3 != RK_OTHER {
            nimm(S_SET, s2, rk3)
            n_set = n_set + 1
        }
        s2 = s2 + 1
    }
    sortieren()
    find_us = now_us() -% t_a
}

// ---------------------------------------------- was in einer Zeile steht

fn zeile_titel(i: u64) -> u64 {
    let s2: u64 = h_src[(i) as usize] as u64
    if s2 == S_APP {
        return appdir.name_of(h_ix[(i) as usize])
    }
    if s2 == S_FILE {
        return name24(h_ix[(i) as usize])
    }
    return seite_name(h_ix[(i) as usize])
}

fn zeile_unter(i: u64) -> u64 {
    let s2: u64 = h_src[(i) as usize] as u64
    if s2 == S_APP {
        return appdir.info_of(h_ix[(i) as usize])
    }
    if s2 == S_FILE {
        let _p: u64 = nidx.path_of(h_ix[(i) as usize],
            (&pfad[0 as usize]) as u64, 250)
        return (&pfad[0 as usize]) as u64
    }
    return msg.get((&k_set[0 as usize]) as u64)
}

// ABGESCHNITTEN WIRD EINMAL, UND GEMELDET WIRD DAS ABGESCHNITTENE.
// Ein Fenster, das die lange Beschriftung meldet und die kurze malt,
// besteht jeden Vergleich zwischen Meldung und Bild -- und beweist
// nichts. Das ist die Lehre der Runde DESKTOP, hier zum wiederholten
// Mal angewandt.
fn kurz(p: u64, breite: u64) -> u64 {
    let n: u64 = wlibc.fit(wlibc.F_UI, wlibc.PX_UI, p, tlen(p), breite)
    let d: u64 = (&cut[0 as usize]) as u64
    var k: u64 = 0
    while k < n && k < 90 {
        wr(d, k, rd(p, k))
        k = k + 1
    }
    wr(d, k, 0)
    return d
}

fn row_y(r: u64) -> u64 {
    return LY + r * ROWH
}

// ------------------------------------------------------------- malen

fn zeile_malen(r: u64, y0: u64, hh: u64, report: bool) {
    let i: u64 = top_ + r
    if i >= nh {
        return
    }
    let ry: u64 = row_y(r)
    if ry + ROWH <= y0 || ry >= y0 + hh {
        return
    }
    let mine: bool = report && ry >= y0 && ry < y0 + hh
    var fg: u64 = wlibc.theme(wlibc.C_MENU_TEXT)
    var dim: u64 = wlibc.theme(wlibc.C_TEXT_MUTED)
    var bg: u64 = wlibc.theme(wlibc.C_MENU_BG)
    let ist_sel: bool = i == sel
    if ist_sel {
        bg = wlibc.theme(wlibc.C_SELECT_BG)
        fg = wlibc.theme(wlibc.C_SELECT_TEXT)
        dim = wlibc.theme(wlibc.C_SELECT_TEXT)
        wlibc.rrect(PAD - 6, ry + 1, W - 2 * (PAD - 6), ROWH - 2,
            wlibc.metric(wlibc.M_RADIUS_BUTTON), bg)
    }
    let ix: u64 = PAD + 2
    let iy: u64 = ry + (ROWH - IC) / 2
    let s2: u64 = h_src[(i) as usize] as u64
    if s2 == S_APP {
        let sy: u64 = appdir.symbol_load(h_ix[(i) as usize])
        if wlibc.icon_ok(sy) {
            let _d: bool = wlibc.icon_draw(sy, ix, iy)
        } else {
            kachel(ix, iy, sy, appdir.name_of(h_ix[(i) as usize]))
        }
    } else if s2 == S_FILE {
        kachel(ix, iy, wlibc.theme(wlibc.C_TEXT_MUTED), name24(h_ix[(i) as usize]))
    } else {
        kachel(ix, iy, wlibc.theme(wlibc.C_ACCENT), seite_name(h_ix[(i) as usize]))
    }
    let tx: u64 = ix + IC + 12
    let breit: u64 = W - tx - PAD - 4
    let tb: u64 = ry + 6 + asc
    let ub: u64 = ry + ROWH - 7
    let t1: u64 = kurz(zeile_titel(i), breit)
    let _e1: u64 = wlibc.text_at(wlibc.F_UI, wlibc.PX_UI, tx, tb, t1,
        tlen(t1), fg)
    var titel_kopie: [u8; 96] = [0 as u8; 96]
    let tk: u64 = (&titel_kopie[0 as usize]) as u64
    let _cp: u64 = ulib.strncpy(tk, t1, 94)
    let t2: u64 = kurz(zeile_unter(i), breit)
    let _e2: u64 = wlibc.text_at(wlibc.F_UI, wlibc.PX_UI, tx, ub, t2,
        tlen(t2), dim)
    if mine {
        say((&s_ze[0 as usize]) as u64)
        ulib.sayn(i)
        kv((&s_sq[0 as usize]) as u64, s2)
        kv((&s_rk[0 as usize]) as u64, h_rk[(i) as usize] as u64)
        kv((&s_x[0 as usize]) as u64, px_ + tx)
        kv((&s_bs[0 as usize]) as u64, py_ + tb)
        kv((&s_ix2[0 as usize]) as u64, px_ + ix)
        kv((&s_iy[0 as usize]) as u64, py_ + iy)
        if ist_sel {
            kv((&s_se[0 as usize]) as u64, 1)
        } else {
            kv((&s_se[0 as usize]) as u64, 0)
        }
        say((&s_tx[0 as usize]) as u64)
        say(tk)
        say((&s_sb[0 as usize]) as u64)
        say(t2)
        say((&s_zu[0 as usize]) as u64)
        ulib.nl()
    }
}

// EIN PLAETTCHEN MIT DEM ERSTEN BUCHSTABEN, wenn ein Buendel kein Bild
// mitbringt. Dasselbe, was die Widget-Bibliothek in einer Liste tut --
// hier noch einmal, weil dieses Fenster keine Widgets benutzt (es hat
// keine, es hat eine Zeichnung).
fn kachel(x: u64, y: u64, farbe: u64, name: u64) {
    wlibc.rrect(x, y, IC, IC, wlibc.metric(wlibc.M_RADIUS_INPUT) / 2,
        farbe)
    if name == 0 {
        return
    }
    let c: u64 = rd(name, 0)
    if c == 0 {
        return
    }
    var eins: [u8; 5] = [0 as u8; 5]
    let p: u64 = (&eins[0 as usize]) as u64
    var n: u64 = 1
    if c >= 0xC0 {
        n = 2
    }
    var k: u64 = 0
    while k < n {
        wr(p, k, rd(name, k))
        k = k + 1
    }
    wr(p, n, 0)
    let bw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.PX_UI, p, n)
    var lx: u64 = x
    if IC > bw {
        lx = x + (IC - bw) / 2
    }
    let _t: u64 = wlibc.text_at(wlibc.F_UI, wlibc.PX_UI, lx,
        y + (IC + asc) / 2 - 1, p, n, wlibc.theme(wlibc.C_ON_ACCENT))
}

fn band_malen(y0: u64, hh: u64, report: bool) {
    let m0: u64 = now_us()
    wlibc.set_band(y0)
    wlibc.clip_set(0, y0, W, y0 + hh)
    wlibc.rect(0, y0, W, hh, wlibc.theme(wlibc.C_MENU_BG))
    let m1: u64 = now_us()
    // EIN RAHMEN UM DAS GANZE, mit demselben Radius, den der
    // Fensterserver aussen malt. Ohne ihn stehen Pop-up und Schreibtisch
    // in einem dunklen Schema ohne Kante nebeneinander.
    wlibc.rring(0, 0, W, H, wlibc.metric(wlibc.M_RADIUS_PANEL),
        wlibc.metric(wlibc.M_BORDER), wlibc.theme(wlibc.C_BORDER))
    let m2: u64 = now_us()
    // das Eingabefeld
    if PAD + EH > y0 && PAD < y0 + hh {
        let ew: u64 = W - 2 * PAD
        wlibc.rrect(PAD, PAD, ew, EH, wlibc.metric(wlibc.M_RADIUS_INPUT),
            wlibc.theme(wlibc.C_INPUT_BG))
        wlibc.rring(PAD, PAD, ew, EH, wlibc.metric(wlibc.M_RADIUS_INPUT),
            wlibc.metric(wlibc.M_FOCUS), wlibc.theme(wlibc.C_FOCUS_RING))
        let bx: u64 = PAD + 12
        let bb: u64 = PAD + (EH + asc) / 2 - 1
        if qn == 0 {
            let ph: u64 = msg.get((&k_ph[0 as usize]) as u64)
            let _p: u64 = wlibc.text_at(wlibc.F_UI, wlibc.PX_UI, bx, bb,
                ph, tlen(ph), wlibc.theme(wlibc.C_TEXT_MUTED))
        } else {
            let _p2: u64 = wlibc.text_at(wlibc.F_UI, wlibc.PX_UI, bx, bb,
                (&q[0 as usize]) as u64, qn,
                wlibc.theme(wlibc.C_INPUT_TEXT))
        }
        // DER BALKEN. Er steht hinter dem Getippten und ist zwei
        // Bildpunkte breit -- das ist die Zahl, die `M_FOCUS` fuer den
        // Satz `modern` hat, und aus demselben Grund: er ist das
        // einzige hier, worauf sich jemand ohne Maus verlaesst.
        let cw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.PX_UI,
            (&q[0 as usize]) as u64, qn)
        wlibc.rect(bx + cw + 1, PAD + 8, 2, EH - 16,
            wlibc.theme(wlibc.C_ACCENT))
    }
    var r: u64 = 0
    while r < ROWS {
        zeile_malen(r, y0, hh, report)
        r = r + 1
    }
    // NICHTS GEFUNDEN -- und das steht da, statt dass die Liste leer
    // bleibt. Eine leere Flaeche sagt nicht, ob gesucht wurde.
    if nh == 0 {
        let ry: u64 = row_y(0)
        if ry + ROWH > y0 && ry < y0 + hh {
            let p3: u64 = msg.get((&k_none[0 as usize]) as u64)
            let _n: u64 = wlibc.text_at(wlibc.F_UI, wlibc.PX_UI,
                PAD + 2, ry + 6 + asc, p3, tlen(p3),
                wlibc.theme(wlibc.C_TEXT_MUTED))
        }
    }
    let m3: u64 = now_us()
    let _p: u64 = wlibc.push(w_h, 0, y0, W, hh)
    let m4: u64 = now_us()
    t_fill = t_fill +% (m1 -% m0)
    t_ring = t_ring +% (m2 -% m1)
    t_rows = t_rows +% (m3 -% m2)
    t_push = t_push +% (m4 -% m3)
}

fn malen(report: bool) {
    if open_ == 0 {
        return
    }
    var y: u64 = 0
    while y < H {
        var hh: u64 = BAND
        if y + hh > H {
            hh = H - y
        }
        band_malen(y, hh, report)
        y = y + hh
    }
    let _f: u64 = wlibc.sys3w(wlibc.WM_FLUSH, w_h, 0, 0)
}

// -------------------------------------------------------- das Fenster

fn init() -> bool {
    asc = wlibc.ascent_of(wlibc.F_UI, wlibc.PX_UI)
    let h: u64 = wlibc.sys5(wlibc.WM_CREATE, 0, (W << 16) | H,
        (&t_title[0 as usize]) as u64, 0, 0)
    if ulib.bad(h) || h == 0 {
        return false
    }
    w_h = h
    // OHNE SCHMUCK, ABER SCHWEBEND. Die beiden sind seit dieser Runde
    // zweierlei (`wm.F_FLOAT`): keine Titelleiste, aber der Schatten und
    // der Eckenradius aus den Form-Token. Ein Suchfeld mit Titelleiste
    // waere eine Anwendung; dies ist eine Frage.
    let _d: u64 = wlibc.win_state(h, wlibc.WS_DECO, 0)
    let _fl: u64 = wlibc.win_state(h, wlibc.WS_FLOAT, 1)
    // L_NORMAL UND NICHT L_TOP, aus dem Grund, den `qs.fi` gemessen hat:
    // der Fensterserver gibt die Tastatur NUR einem Fenster auf der
    // normalen Ebene. Ein Suchfeld, in das man nicht tippen kann, waere
    // kein Suchfeld -- und das hier lebt vom Tippen.
    let _l: u64 = wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_NORMAL)
    let _v: u64 = wlibc.win_state(h, wlibc.WS_HIDDEN, 1)
    w_id = wlibc.sys3w(wlibc.WM_INFO, h, wlibc.WI_ID, 0)
    say((&s_ini[0 as usize]) as u64)
    kv((&s_w[0 as usize]) as u64, W)
    kv((&s_h[0 as usize]) as u64, H)
    kv((&s_id[0 as usize]) as u64, w_id)
    ulib.nl()
    seiten_lesen()
    return true
}

// DER INDEX. Er wird EINMAL gebaut, wenn die Leiste steht, und danach
// nur noch nachgezogen. Warum nicht beim ersten Oeffnen: dann waere das
// erste Oeffnen genau um die Bauzeit langsamer, und das erste Oeffnen
// ist das, an das sich ein Mensch erinnert.
//
// UND DIE GEGENPROBE STEHT DANEBEN: derselbe Suchbegriff einmal ueber
// den Index und einmal ueber den Baumdurchlauf, beide Zeiten gemeldet.
// Ohne diese zweite Zahl waere "ein Index ist schneller" eine
// Behauptung.
fn index_bauen(gegenprobe: u64) {
    // ERST DAS ANWENDUNGSVERZEICHNIS. Es ist die erste Quelle der
    // Rangfolge, und ohne es faende dieses Fenster kein einziges
    // Programm -- gemessen im ersten Lauf: `apps=0`, und das Feld war
    // vollkommen still dabei. Deshalb wird die Zahl gemeldet.
    let na: u64 = appdir.load((&p_apps[0 as usize]) as u64, false)
    say((&s_ad[0 as usize]) as u64)
    ulib.sayn(na)
    ulib.nl()
    let t_a: u64 = now_us()
    idx_n = nidx.build()
    idx_us = now_us() -% t_a
    heim_finden()
    let u2: u64 = heim_markieren()
    idx_ok = 1
    say((&s_ix[0 as usize]) as u64)
    ulib.sayn(idx_n)
    kv((&s_us[0 as usize]) as u64, idx_us)
    say((&s_hm[0 as usize]) as u64)
    say((&heim[0 as usize]) as u64)
    say((&s_zu[0 as usize]) as u64)
    kv((&s_in[0 as usize]) as u64, heim_ino)
    kv((&s_un[0 as usize]) as u64, u2)
    ulib.nl()
    if gegenprobe != 0 {
        var wort: [u8; 4] = "e\0\0\0"
        var tw2: [u8; 6144] = [0 as u8; 6144]
        let t_b: u64 = now_us()
        baum_n = nidx.walk_find((&wort[0 as usize]) as u64,
            (&tw2[0 as usize]) as u64, 256)
        baum_us = now_us() -% t_b
        say((&s_bw[0 as usize]) as u64)
        ulib.sayn(baum_us)
        kv((&s_bn[0 as usize]) as u64, baum_n)
        ulib.nl()
    }
    zahlen_lesen()
}

fn win_id() -> u64 {
    return w_id
}

fn is_open() -> bool {
    return open_ != 0
}

fn opens() -> u64 {
    return opens_
}

fn treffer() -> u64 {
    return nh
}

fn gewaehlt() -> u64 {
    return sel
}

fn index_n() -> u64 {
    return idx_n
}

fn index_us() -> u64 {
    return idx_us
}

fn such_us() -> u64 {
    return find_us
}

// WO DIE ARBEITSFLAECHE IST. Die Leiste sagt es, wie sie es `qs` sagt --
// das Pop-up steht in der MITTE davon und nicht in der Mitte des
// Schirms: ein Fenster, das den Schirm fuer die Flaeche haelt, sitzt bei
// einer Leiste am oberen Rand um deren halbe Hoehe zu tief.
fn anchor(wx: u64, wy: u64, ww: u64, wh: u64) {
    a_x = wx
    a_y = wy
    a_w = ww
    a_h = wh
    place()
}

fn place() {
    var x: u64 = a_x
    var y: u64 = a_y
    if a_w > W {
        x = a_x + (a_w - W) / 2
    }
    if a_h > H {
        y = a_y + (a_h - H) / 2
    }
    px_ = x
    py_ = y
    if open_ != 0 {
        let _m: u64 = wlibc.sys3w(wlibc.WM_MOVE, w_h, (px_ << 16) | py_, 0)
    }
}

fn hit(x: u64, y: u64) -> bool {
    if open_ == 0 {
        return false
    }
    return x >= px_ && x < px_ + W && y >= py_ && y < py_ + H
}

fn melde_suche() {
    say((&s_qu[0 as usize]) as u64)
    say((&q[0 as usize]) as u64)
    kv((&s_qn[0 as usize]) as u64, qn)
    kv((&s_qc[0 as usize]) as u64, wlibc.chars((&q[0 as usize]) as u64, qn))
    kv((&s_tr[0 as usize]) as u64, nh)
    kv((&s_ap[0 as usize]) as u64, n_app)
    kv((&s_da[0 as usize]) as u64, n_file)
    kv((&s_ei[0 as usize]) as u64, n_set)
    kv((&s_us[0 as usize]) as u64, find_us)
    ulib.nl()
}

fn open_at(when: u64) {
    if open_ != 0 {
        return
    }
    t0 = when
    qn = 0
    wr((&q[0 as usize]) as u64, 0, 0)
    sel = 0
    top_ = 0
    esc_wait = 0
    // NACHZIEHEN, NICHT NEU BAUEN. Was sich seit dem letzten Mal am
    // Dateibaum geaendert hat, steht im Journal des Kerns; hat der Ring
    // etwas verworfen, sagt `lost_seen` das, und DANN wird neu gebaut.
    if idx_ok != 0 {
        let gezogen: u64 = nidx.poll()
        if nidx.lost_seen() != 0 {
            idx_n = nidx.build()
            let _u: u64 = heim_markieren()
        } else if gezogen != 0 {
            let _u2: u64 = heim_markieren()
        }
    }
    suchen()
    place()
    let _m: u64 = wlibc.sys3w(wlibc.WM_MOVE, w_h, (px_ << 16) | py_, 0)
    let _v: u64 = wlibc.win_state(w_h, wlibc.WS_HIDDEN, 0)
    open_ = 1
    opens_ = opens_ + 1
    let t_up: u64 = now_ns()
    // GEMALT, NICHT GEMELDET, UND DIE UHR HAELT HIER AN. Dieselbe Falle
    // wie in `qs.fi`: `malen(true)` schreibt ein Dutzend Zeilen mit
    // 115200 Baud, und stuende das INNERHALB der Messung, maesse die
    // Zahl die serielle Leitung. Gemessen wird, worauf ein Mensch
    // wartet: verschieben, zeigen, zeichnen.
    t_fill = 0
    t_ring = 0
    t_rows = 0
    t_push = 0
    malen(false)
    let t_done: u64 = now_ns()
    let _a: u64 = wlibc.win_act(w_id, wlibc.WA_RAISE)
    say((&s_op[0 as usize]) as u64)
    kv((&s_x[0 as usize]) as u64, px_)
    kv((&s_y[0 as usize]) as u64, py_)
    kv((&s_w[0 as usize]) as u64, W)
    kv((&s_h[0 as usize]) as u64, H)
    var d1: u64 = 0
    if t0 != 0 && t_up > t0 {
        d1 = (t_up -% t0) / 1000
    }
    kv((&s_up[0 as usize]) as u64, d1)
    var d: u64 = 0
    if t0 != 0 && t_done > t0 {
        d = (t_done -% t0) / 1000
    }
    kv((&s_us[0 as usize]) as u64, d)
    kv((&s_tf[0 as usize]) as u64, t_fill)
    kv((&s_tg[0 as usize]) as u64, t_ring)
    kv((&s_tz[0 as usize]) as u64, t_rows)
    kv((&s_tp[0 as usize]) as u64, t_push)
    ulib.nl()
    melde_suche()
    malen(true)
}

fn shut(why: u64) {
    if open_ == 0 {
        return
    }
    open_ = 0
    t0 = 0
    esc_wait = 0
    let _v: u64 = wlibc.win_state(w_h, wlibc.WS_HIDDEN, 1)
    say((&s_cl[0 as usize]) as u64)
    say(why)
    ulib.nl()
}

fn toggle() {
    if open_ != 0 {
        shut((&s_key[0 as usize]) as u64)
    } else {
        open_at(now_ns())
    }
}

// ------------------------------------------------------- die Tastatur

fn sicht_richten() {
    if sel >= nh {
        if nh == 0 {
            sel = 0
        } else {
            sel = nh - 1
        }
    }
    if sel < top_ {
        top_ = sel
    }
    if sel >= top_ + ROWS {
        top_ = sel + 1 - ROWS
    }
}

fn hoch() {
    if nh == 0 {
        return
    }
    if sel == 0 {
        sel = nh - 1
    } else {
        sel = sel - 1
    }
    sicht_richten()
}

fn runter() {
    if nh == 0 {
        return
    }
    sel = sel + 1
    if sel >= nh {
        sel = 0
    }
    sicht_richten()
}

// EIN OKTETT ANHAENGEN. Der Kern schickt UTF-8, ein Umlaut kommt also in
// ZWEI Ereignissen -- beide werden angehaengt, und `text_at` setzt sie
// beim Malen wieder zusammen. Gesucht wird auf den gefalteten Oktetten,
// und die Faltung kennt die zwei Oktette.
fn tippen(c: u64) {
    if qn + 1 >= QMAX {
        return
    }
    wr((&q[0 as usize]) as u64, qn, c)
    qn = qn + 1
    wr((&q[0 as usize]) as u64, qn, 0)
    sel = 0
    top_ = 0
    suchen()
    sicht_richten()
}

// EIN ZEICHEN ZURUECK UND NICHT EIN OKTETT. Ein halber Umlaut im
// Suchfeld waere ein Zeichen, das es nicht gibt -- und die Faltung
// bekaeme ein Oktett 0xC3 ohne das zweite.
fn loeschen() {
    if qn == 0 {
        return
    }
    var k: u64 = qn - 1
    while k > 0 && (rd((&q[0 as usize]) as u64, k) & 0xC0) == 0x80 {
        k = k - 1
    }
    qn = k
    wr((&q[0 as usize]) as u64, qn, 0)
    sel = 0
    top_ = 0
    suchen()
    sicht_richten()
}

fn starten() {
    if sel >= nh {
        return
    }
    let s2: u64 = h_src[(sel) as usize] as u64
    let ix: u64 = h_ix[(sel) as usize]
    if s2 == S_FILE {
        // EINE DATEI IST KEIN PROGRAMM. Was ein Doppelklick auf sie tun
        // soll, entscheidet nicht dieses Fenster -- es sagt, welche es
        // ist. Genau dieselbe Grenze zieht `/bin/launcher`.
        let _p: u64 = nidx.path_of(ix, (&pfad[0 as usize]) as u64, 250)
        say((&s_df[0 as usize]) as u64)
        say((&pfad[0 as usize]) as u64)
        say((&s_zu[0 as usize]) as u64)
        ulib.nl()
        shut((&s_run[0 as usize]) as u64)
        return
    }
    if s2 == S_SET {
        // DIE SEITE ALS ARGUMENT. `/bin/settings 6` macht die
        // Sprachseite auf -- ein Treffer "Sprache", der die
        // Einstellungen auf der Darstellungsseite oeffnet, waere ein
        // halber Treffer.
        var argv: [u64; 3] = [0 as u64; 3]
        let np: u64 = (&nummer[0 as usize]) as u64
        let nl: u64 = zahl_in(np, ix)
        wr(np, nl, 0)
        argv[(0) as usize] = (&p_set[0 as usize]) as u64
        argv[(1) as usize] = np
        let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&p_set[0 as usize]) as u64,
            (&argv[0 as usize]) as u64, 2)
        say((&s_st[0 as usize]) as u64)
        say(seite_name(ix))
        kv((&s_nr[0 as usize]) as u64, ix)
        kv((&s_pi[0 as usize]) as u64, pid)
        ulib.nl()
        shut((&s_run[0 as usize]) as u64)
        return
    }
    var arg: [u8; 160] = [0 as u8; 160]
    let _cp: u64 = ulib.strncpy((&arg[0 as usize]) as u64,
        appdir.exec_of(ix), 150)
    let pid: u64 = ulib.sys(ulib.SYS_SPAWN, (&arg[0 as usize]) as u64, 0, 0)
    if ix < 16 {
        zahl[(ix) as usize] = zahl[(ix) as usize] + 1
        zseq = zseq + 1
        zletzt[(ix) as usize] = zseq
        zahlen_schreiben()
        say((&s_zh[0 as usize]) as u64)
        say(appdir.name_of(ix))
        kv((&s_zn[0 as usize]) as u64, zahl[(ix) as usize])
        ulib.nl()
    }
    say((&s_go[0 as usize]) as u64)
    say((&arg[0 as usize]) as u64)
    kv((&s_pi[0 as usize]) as u64, pid)
    ulib.nl()
    shut((&s_run[0 as usize]) as u64)
}

// EINE TASTE. Die Fluchtfolgen der Pfeiltasten sind der Grund, warum
// das ein kleiner Automat ist und keine Kette von Vergleichen:
//
//   * die Pfeiltaste NACH OBEN ist das Oktett 14, seit Runde K6, und
//     daran haengt Abschnitt 11 von tools/userland/run.sh.
//   * alle anderen Pfeiltasten kommen als ESC [ <Buchstabe>, also in
//     DREI Ereignissen.
//   * die Fluchttaste ist ebenfalls 27.
//
// Die letzten beiden lassen sich beim ersten Oktett nicht auseinander-
// halten. Also wird gewartet: kommt als naechstes eine eckige Klammer,
// war es eine Folge; kommt in demselben Abholen nichts mehr, war es die
// Fluchttaste. Das kostet im schlimmsten Fall EINEN Durchlauf der
// Leiste (25 ms) -- und es kostet ihn nur der, der die Fluchttaste als
// letzte Taste vor einer Pause drueckt.
fn taste(c: u64) -> bool {
    if esc_wait == 1 {
        if c == 91 {
            esc_wait = 2
            return false
        }
        esc_wait = 0
        shut((&s_esc[0 as usize]) as u64)
        return true
    }
    if esc_wait == 2 {
        esc_wait = 0
        if c == 66 {
            runter()
            return true
        }
        if c == 65 {
            hoch()
            return true
        }
        // Alles andere in einer Folge (links, rechts, Anfang, Ende,
        // Seite) waehlt nicht aus und tippt auch nicht.
        return true
    }
    if c == 27 {
        esc_wait = 1
        return false
    }
    if c == 10 || c == 13 {
        starten()
        return true
    }
    if c == 8 || c == 127 {
        loeschen()
        return true
    }
    if c == 14 {
        hoch()
        return true
    }
    if c == 9 {
        runter()
        return true
    }
    if c >= 32 && c != 127 {
        tippen(c)
        return true
    }
    return false
}

// ----------------------------------------------------------- der Blick
//
// Einmal je Durchlauf der Leiste. Solange das Fenster zu ist, kostet es
// EINEN Systemaufruf: den Blick auf den Riegel.
fn step() -> bool {
    var changed: bool = false
    let seq: u64 = nv.hotkey_seq()
    if seq != hk_last {
        let was: u64 = hk_last
        hk_last = seq
        if was != 0 || seq == 1 {
            // NUR DAS TIPPEN AUF DIE TASTE SELBST. `nv.HK_TAP` liegt
            // ueber Unicode; ein Buchstabe kann diese Zahl nicht sein,
            // und Super+A geht weiter an die Schnelleinstellungen.
            if nv.hotkey_key() == nv.HK_TAP {
                if open_ != 0 {
                    shut((&s_key[0 as usize]) as u64)
                } else {
                    open_at(nv.hotkey_ns())
                }
                changed = true
            }
        }
    }
    if open_ == 0 {
        return changed
    }
    var n: u64 = 0
    var etwas: bool = false
    while n < 32 && wlibc.sys3w(wlibc.WM_EVENT, w_h,
        (&ev[0 as usize]) as u64, 0) == 1 {
        let b: u64 = (&ev[0 as usize]) as u64
        let typ: u64 = __mmio_read64((b) as *mut u64)
        let d: u64 = __mmio_read64((b + 8) as *mut u64)
        if typ == wlibc.EV_KEY {
            // DAS ZEICHEN STEHT IN DEN BITS 32..47 UND NICHT BEI 0.
            // Ein Ereigniswort traegt drei Zahlen; `qs.fi` hat zwei
            // Laeufe gebraucht, um das herauszufinden, und es steht
            // dort aufgeschrieben. Hier steht es zum zweiten Mal, weil
            // die naechste Runde sonst dieselben zwei Laeufe braucht.
            if taste((d >> 32) & 0xFFFF) {
                etwas = true
            }
        } else if typ == wlibc.EV_DOWN {
            klick((d >> 32) & 0xFFFF, (d >> 16) & 0xFFFF)
            etwas = true
        } else if typ == wlibc.EV_CLOSE {
            shut((&s_esc[0 as usize]) as u64)
            return true
        }
        n = n + 1
    }
    // DIE FLUCHTTASTE, EINEN DURCHLAUF SPAETER. Kam nach der 27 nichts
    // mehr, war es keine Folge.
    if esc_wait == 1 && n == 0 && open_ != 0 {
        esc_wait = 0
        shut((&s_esc[0 as usize]) as u64)
        return true
    }
    if open_ == 0 {
        return changed || etwas
    }
    if etwas {
        melde_suche()
        malen(true)
        changed = true
    }
    // EIN DRUCK DANEBEN. Der Fensterserver erzaehlt einem Fenster vom
    // Zeiger nur, solange der Zeiger DRIN ist -- ein Druck woanders
    // erzeugt also kein Ereignis von uns. Nur die FLANKE zaehlt.
    let btn: u64 = wlibc.mouse_btn() & 1
    if btn != 0 && btn_last == 0 {
        if !hit(wlibc.mouse_x(), wlibc.mouse_y()) {
            shut((&s_out[0 as usize]) as u64)
            changed = true
        }
    }
    btn_last = btn
    return changed
}

// EIN KLICK IN DIE LISTE. Die Maus darf mit; sie muss nicht.
fn klick(sx: u64, sy: u64) {
    if sy < py_ + LY {
        return
    }
    let r: u64 = (sy - py_ - LY) / ROWH
    if r >= ROWS {
        return
    }
    if top_ + r >= nh {
        return
    }
    if sel == top_ + r {
        starten()
        return
    }
    sel = top_ + r
    sicht_richten()
}
