// WOHIN DIE ZEIT BEIM MALEN GEHT. Vier Zahlen statt einer -- die erste
// Messung sagte nur 'das Malen hat 158 ms gedauert', und daraus folgt
// kein einziger naechster Schritt. Aufgeteilt sagt sie, welcher.
static mut t_fill: u64 = 0
static mut t_ring: u64 = 0
static mut t_rows: u64 = 0
static mut t_push: u64 = 0

static mut hf: [u8; 160] = [0 as u8; 160]
