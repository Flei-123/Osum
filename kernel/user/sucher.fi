// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/sucher.fi -- RUNDE SUPERSEARCH: DAS SUCHFELD AUF DIE TASTE.
//
// Man tippt auf die Windows-Taste, und mitten auf dem Schirm steht ein
// Feld mit dem Balken darin. Man tippt weiter, und darunter stehen die
// Treffer. Pfeil, Eingabetaste, fertig. Fluchttaste, und es ist weg.
//
// ------------------------------------------------------------------
// WORAUF DIESE RUNDE AUFBAUT, statt daneben.
//
// `kernel/kbd.fi` hatte die Super-Taste schon, samt einem RIEGEL statt
// eines Ereignisses, und die Begruendung steht woertlich dort: "A hotkey
// has no window -- that is what makes it global." Das ist richtig und
// bleibt. Diese Runde fuegt EINEN Fall hinzu -- die Taste ALLEIN,
// gedrueckt und losgelassen, ohne dass dazwischen etwas anderes kam --
// und benutzt denselben Zaehler, dieselbe Uhr, denselben Riegel.
//
// `kernel/user/qs.fi` (Runde NETVIEW) ist die Bauform: ein Fenster, das
// der Taskleiste gehoert, beim Start angelegt und VERSTECKT gehalten.
// Aufmachen ist `WS_HIDDEN 0` plus Verschieben plus Malen -- kein
// Programmstart. Das ist kein Detail: gemessen wird die Zeit vom
// Tastendruck bis zum stehenden Fenster, und ein fork+exec haette diese
// Zahl in eine andere Groessenordnung gehoben. Deshalb steht dieses
// Fenster HIER und nicht als eigenes Programm neben `/bin/launcher`.
//
// `/bin/launcher` bleibt, was es ist: dasselbe Verzeichnis, derselbe
// Namensindex, aber ein Fenster mit Titelleiste, das man aus der Leiste
// startet und stehen laesst. Das hier ist die Frage, die man stellt und
// wieder wegtut.
//
// ------------------------------------------------------------------
// DIE RANGFOLGE IST DER EIGENTLICHE WERT EINER SUCHE.
//
// Eine Suche, die alles findet, ist keine. Was diese hier tut, in genau
// dieser Ordnung, und beides zusammen ist EINE Zahl (`rk * 4 + quelle`):
//
//   WIE GUT der Name passt -- und das schlaegt alles andere:
//     0  GENAU. Der gefaltete Name IST die gefaltete Eingabe.
//     1  AM WORTANFANG. Am Anfang des Namens oder hinter einem
//        Trennzeichen (Leerraum, Strich, Unterstrich, Punkt, Schraeg-
//        strich, Komma).
//     2  MITTENDRIN.
//     3  GAR NICHT IM NAMEN, aber in der Beschreibung oder in den
//        Schluesselwoertern eines Buendels. "folder" findet den
//        Datei-Explorer so, und nur so.
//
//   WOHER der Treffer kommt, bei gleichem Rang:
//     0  ein installiertes Programm (aus den .osp-Buendeln)
//     1  eine Datei im Heimatverzeichnis (aus dem Namensindex)
//     2  eine Seite der Einstellungen
//
// Ein genau passender Dateiname schlaegt also ein Programm, auf das der
// Begriff nur mittendrin passt -- "ein exakter Name schlaegt alles" --,
// und bei gleichem Rang stehen die Programme vorn.
//
// ------------------------------------------------------------------
// UMLAUTE. EIN UMLAUT SIND ZWEI OKTETTE, UND DAS IST DER GANZE FEHLER,
// DEN MAN HIER MACHEN KANN.
//
// Die Suche in `appdir.fi` und `nidx.fi` faltet mit einer Funktion, die
// 65..90 um 32 erhoeht und sonst nichts. Das ist ASCII, und in UTF-8 ist
// ein "O mit zwei Punkten" 0xC3 0x96, ein "o mit zwei Punkten" 0xC3 0xB6
// -- das zweite Oktett liegt weit oberhalb von 90, also gelten die
// beiden dort als verschiedene Zeichen. "GROESSE" mit Umlaut findet man
// damit nicht, wenn man es klein tippt.
//
// `fold` hier faltet deshalb BEIDES:
//   * 'A'..'Z'                    -> +32, wie bisher
//   * 0xC3 0x80..0x9E (ohne 0x97) -> 0xC3 (b + 0x20)
//
// Der zweite Fall ist genau der lateinische Zusatzblock: 0xC3 0x80..0x9E
// sind U+00C0..U+00DE (die grossen mit Zeichen), 0xC3 0xA0..0xBE sind
// U+00E0..U+00FE (die kleinen), und der Abstand ist ueberall 0x20. 0x97
// ist das Malzeichen und kein Buchstabe -- es faellt heraus, sonst
// wuerde daraus das Geteiltzeichen.
//
// Und die Suche nach "gro" findet "Groesse" mit Umlaut ohnehin, weil
// "gro" drei ASCII-Oktette sind und das gefaltete Wort mit genau diesen
// drei anfaengt. Beides wird gemessen, nicht behauptet.
//
// ------------------------------------------------------------------
// OHNE MAUS. Alles hier geht ueber die Tastatur, und das ist keine
// Zugabe: das Fenster wird von einer TASTE aufgemacht, und wer eine
// Maus haette, haette auch die Leiste anklicken koennen. Die Maus darf
// mit, sie muss aber nichts.

profile kernel

import ulib
import libc.io
import wlibc
import nv
import appdir
import nidx
import msg

export {
    init, step, toggle, is_open, hit, win_id, anchor, index_bauen, W, H,
    probe, falten, RK_EXACT, RK_START, RK_MID, RK_OTHER, RK_NONE,
    S_APP, S_FILE, S_SET,
    opens, treffer, gewaehlt, index_n, index_us, such_us
}

// ------------------------------------------------------------ die Form
//
// DIE ZAHLEN STEHEN HIER UND WERDEN GEMELDET, damit ein Pruefer draussen
// dieselbe Rechnung machen kann wie der Zeichner drinnen. Das ist die
// Regel, an der die Runde NETVIEW zwei echte Fehler gefunden hat -- eine
// Beschriftung vier Bildpunkte neben ihrer Kachel, zwei Textzeilen auf
// derselben Bildzeile. Im Quelltext sieht man beides nicht.
const PAD: u64 = 16
const EH: u64 = 36 // das Eingabefeld
const GAP: u64 = 12
const ROWH: u64 = 36 // eine Zeile der Trefferliste
const ROWS: u64 = 8
const IC: u64 = 16 // das Programmsymbol, in seiner Zielgroesse
const W: u64 = 560
const H: u64 = PAD + EH + GAP + ROWS * ROWH + PAD // 368
const LY: u64 = PAD + EH + GAP // wo die Liste anfaengt: 64
const BAND: u64 = 64 // Zeilen der Malflaeche auf einmal

const MAXH: u64 = 40 // so viele Treffer werden ueberhaupt gesammelt
const QMAX: u64 = 48 // Oktette im Suchfeld
const FMAX: u64 = 160 // Platz fuer einen gefalteten Namen
const NMAX: u64 = 26 // ein Name aus dem Index, plus Null

const S_APP: u64 = 0
const S_FILE: u64 = 1
const S_SET: u64 = 2

const RK_EXACT: u64 = 0
const RK_START: u64 = 1
const RK_MID: u64 = 2
const RK_OTHER: u64 = 3
const RK_NONE: u64 = 9

const NICHTS: u64 = 0xFFFFFFFF

// WIE VIELE DATEINAMEN AUS DEM INDEX ANGESEHEN WERDEN. Der Index kann
// Tausende liefern; gezeigt werden acht. Gesammelt werden trotzdem alle,
// die durch den Heimatfilter kommen, bis MAXH voll ist -- die Ordnung
// entscheidet danach, welche acht das sind, und nicht die Reihenfolge im
// Index.
const SETMAX: u64 = 8

// ----------------------------------------------------------- der Stand

