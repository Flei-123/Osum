// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/desktop.fi -- Runde DESKTOP: /bin/desktop.
//
// DAS FENSTER, DAS GANZ HINTEN LIEGT. Es ist so gross wie der
// Bildschirm, es hat keinen Rahmen und keine Titelleiste, und es kommt
// NIE nach vorn -- auch dann nicht, wenn man daraufklickt.
//
// WARUM DAS BIS ZU DIESER RUNDE NICHT GING, und es steht so im Logbuch
// K15: der Fensterserver konnte ein Fenster HEBEN und sonst nichts. Es
// gab keine Moeglichkeit, eines nach hinten zu stellen; ein
// Hintergrundbild waere ein Fenster gewesen, das beim ersten Klick vor
// allen anderen liegt. Die Loesung steht im SERVER (`kernel/wm.fi`,
// L_DESK/L_NORMAL/L_TOP) und nicht hier als Trick -- ein Programm, das
// sich alle 100 Millisekunden selbst nach hinten sortiert, ist keine
// Loesung, sondern ein Flackern.
//
// WAS ER MALT, und in dieser Reihenfolge:
//
//   1. EIN BILD, wenn `/etc/wallpaper` da ist und mit "OSYM" anfaengt
//      -- dasselbe Format wie die Programmsymbole (`tools/k15/icon.py`,
//      zwoelf Oktette Kopf, danach B,G,R,A je Bildpunkt). Es wird auf
//      den Bildschirm GESTRECKT, mit dem naechsten Nachbarn.
//   2. SONST EINEN VERLAUF zwischen zwei Farben des Schemas. Die beiden
//      Farben und die Rechnung stehen unten; `tools/desktop/run.sh`
//      rechnet einzelne Bildpunkte damit nach, statt "sieht dunkel aus"
//      zu messen.
//
// WARUM DAS BILD KLEIN SEIN MUSS. Ein Prozess hat in diesem System
// 832 Kilooktett fuer Halde und Abbildungen (`kernel/sys.fi`), und
// 253 davon liegen schon in der Zeichenflaeche der Widget-Bibliothek.
// 800 x 600 x 4 sind 1 875 Kilooktett und passen nicht -- nicht
// annaehernd. Also ist die Quelle hoechstens BILD_MAX_W x BILD_MAX_H
// gross und wird gestreckt. Das ist eine ehrliche Grenze und keine
// Ausrede: sie steht als Konstante da, und wer sie hebt, hebt sie an
// einer Stelle.

// ================================================ RUNDE 31: profile app
//
// Der Schreibtisch ist eine Wurzeldatei, und seine Bedienelemente
// kommen ab dieser Runde aus fUi (wlib -> fuib -> lib/fui). fUi rechnet
// in `f64` und benutzt `std.rt`; beides ist unter `profile kernel`
// gesperrt (SPEC.md:125). Die Module darunter -- wlib, wlibc, msg --
// bleiben `kernel`; nur die Wurzel wechselt.
profile app

import ulib
import libc.io
// RUNDE 31: `import libc.mem` IST HIER WEG, UND ZWAR NICHT AUS LAUNE.
//
// Firn benennt ein Modul nach dem LETZTEN Teil seines Pfades. `libc.mem`
// heisst also `mem` -- und `paint/canvas.fi`, das fUi zum Malen braucht,
// importiert `html.mem`, das AUCH `mem` heisst. Beide gleichzeitig, und
// der Name ist doppelt belegt:
//
//   error: module 'mem' has no element 'heap_alloc'
//          --> paint/canvas.fi:121
//
// Der einzige Aufruf war `mem.alloc(bytes)` fuer den Bildpuffer des
// Hintergrundbildes. `wlibc.map_surface` tut genau dasselbe -- ein
// anonymes `mmap` -- und wlibc ist hier ohnehin importiert. Also ein
// Aufruf weniger statt eines Modulkonflikts.
import wlibc
import wlib
import msg
import modul

export { u_start }

// RUNDE I18N: DER EINZIGE ANZEIGETEXT DIESES PROGRAMMS.
//
// Er stand hier bis heute als "Schreibtisch" im Quelltext. Jetzt steht
// hier nur noch sein SCHLUESSEL -- englisch, wie jeder Name in diesem
// System --, und der Text kommt aus /usr/share/locale/<code>/messages.
static mut k_title: [u8; 14] = "desktop.title\0"


// Die Grenze der Quelle. 240 x 180 x 4 = 172 800 Oktette.
const IMAGE_MAX_W: u64 = 240
const IMAGE_MAX_H: u64 = 180

static mut w_h: u64 = 0 // das Handle des Fensters
static mut sw: u64 = 0
static mut sh: u64 = 0
static mut image: u64 = 0 // die Bildpunkte, oder 0
static mut bw: u64 = 0
static mut bh: u64 = 0
static mut c_oben: u64 = 0
static mut c_unten: u64 = 0
static mut kopf: [u8; 16] = [0 as u8; 16]
static mut ev: [u8; 16] = [0 as u8; 16]

// ============================================ RUNDE BELEG: DER MESSAUSGANG
// STEHT IM NORMALBETRIEB AUS.
//
// Justins Befund am Abbild vom 12.09.2026: im Terminalfenster standen
// Zeilen wie `explorer: krumm n=2 fold=0` und `bg=...`. Gezaehlt hat er
// auch: 160 `ulib.say` in taskbar.fi, 38 in explorer.fi.
//
// Die Regel dazu steht seit Runde LAUFZEIT in taskmgr.fi:
//
//   EIN MESSAUSGANG GEHOERT HINTER EINEN SCHALTER, UND DER SCHALTER
//   STEHT IM NORMALBETRIEB AUS. Ein Programm, das im Auslieferungs-
//   zustand misst, misst vor allem sich selbst.
//
// NICHT GELOESCHT, SONDERN GESCHALTET. Die Zaehler (`fui=`, `fuix=`,
// `rect id=`, `text ... base=`) waren mehrfach der Schluessel zur
// Fehlersuche -- sie muessen fuer die Abnahme da sein. Also EIN Schalter
// statt zweihundert geloeschter Zeilen.
//
// ZWEI WEGE, IHN EINZUSCHALTEN, und beide gab es schon:
//   /etc/uitrace   die Datei, mit der `wlib` seit Runde LOOK dasselbe
//                  tut -- die Pruefstaende legen sie ohnehin an
//   `debug`        als Wort auf der Programmzeile, fuer den Fall, dass
//                  einer allein gestartet wird
//
// OHNE BEIDES AENDERT SICH KEIN OKTETT gegenueber vorher -- das ist die
// Bedingung dafuer, dass kein bestehender Testlaeufer davon etwas merkt.
static mut s_dbg: u64 = 0

// Die drei Ausgaenge dieses Programms, an EINER Stelle geschaltet.
// `sayn` und `nl` stehen hier, damit kein Aufrufer `ulib.` direkt
// nimmt und damit am Schalter vorbeigeht.
fn dbg_on() -> bool {
    return s_dbg != 0
}

fn dbg_setup(args: u64) {
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_dbg = 1
    }
    var a_dbg: [u8; 6] = "debug\0"
    let argc: u64 = ulib.arg_count(args)
    var ai: u64 = 1
    while ai < argc {
        if ulib.streq(ulib.arg_at(args, ai), (&a_dbg[0 as usize]) as u64) {
            s_dbg = 1
        }
        ai = ai + 1
    }
}

fn say(p: u64) {
    if s_dbg == 0 {
        return
    }
    ulib.say(p)
}

fn sayn(v: u64) {
    if s_dbg == 0 {
        return
    }
    ulib.sayn(v)
}

fn nl() {
    if s_dbg == 0 {
        return
    }
    ulib.nl()
}

fn u32_at(p: u64) -> u64 {
    return (__mmio_read8((p) as *mut u8) as u64)
        | ((__mmio_read8((p + 1) as *mut u8) as u64) << 8)
        | ((__mmio_read8((p + 2) as *mut u8) as u64) << 16)
        | ((__mmio_read8((p + 3) as *mut u8) as u64) << 24)
}

// DIE FARBE AN EINER STELLE -- und sie ist EINE Funktion, weil der
// Laeufer draussen genau diese Rechnung nachrechnet. Waere sie an zwei
// Stellen im Quelltext (einmal beim Malen, einmal beim Melden), waere
// die Messung eine Tautologie.
fn color_at(x: u64, y: u64) -> u64 {
    if image != 0 && bw != 0 && bh != 0 {
        var qx: u64 = 0
        var qy: u64 = 0
        if sw > 1 {
            qx = x * bw / sw
        }
        if sh > 1 {
            qy = y * bh / sh
        }
        if qx >= bw {
            qx = bw - 1
        }
        if qy >= bh {
            qy = bh - 1
        }
        let at: u64 = image + (qy * bw + qx) * 4
        let b: u64 = __mmio_read8((at) as *mut u8) as u64
        let g: u64 = __mmio_read8((at + 1) as *mut u8) as u64
        let r: u64 = __mmio_read8((at + 2) as *mut u8) as u64
        return (r << 16) | (g << 8) | b
    }
    // Der Verlauf: linear von oben nach unten, je Kanal, mit
    // Abrundung -- dieselbe ganzzahlige Division wie im Laeufer.
    if sh < 2 {
        return c_oben
    }
    let t: u64 = y * 255 / (sh - 1)
    let r: u64 = (((c_oben >> 16) & 255) * (255 - t)
        + ((c_unten >> 16) & 255) * t) / 255
    let g: u64 = (((c_oben >> 8) & 255) * (255 - t)
        + ((c_unten >> 8) & 255) * t) / 255
    let b: u64 = ((c_oben & 255) * (255 - t) + (c_unten & 255) * t) / 255
    return (r << 16) | (g << 8) | b
}

// Das Bild laden. Gibt true, wenn wirklich Bildpunkte da sind.
fn image_load(pfad: u64) -> bool {
    let fd: u64 = io.open(pfad, 0)
    if ulib.bad(fd) {
        return false
    }
    let k: u64 = (&kopf[0 as usize]) as u64
    let n: u64 = io.read_full(fd, k, 12)
    if ulib.bad(n) || n < 12 {
        io.close(fd)
        return false
    }
    if kopf[(0) as usize] != 79 as u8 || kopf[(1) as usize] != 83 as u8 {
        io.close(fd)
        return false
    }
    if kopf[(2) as usize] != 89 as u8 || kopf[(3) as usize] != 77 as u8 {
        io.close(fd)
        return false
    }
    let iw: u64 = u32_at(k + 4)
    let ih: u64 = u32_at(k + 8)
    if iw == 0 || ih == 0 || iw > IMAGE_MAX_W || ih > IMAGE_MAX_H {
        io.close(fd)
        return false
    }
    let bytes: u64 = iw * ih * 4
    let p: u64 = wlibc.map_surface(bytes)
    if p == 0 {
        io.close(fd)
        return false
    }
    let g: u64 = io.read_full(fd, p, bytes)
    io.close(fd)
    if ulib.bad(g) || g < bytes {
        return false
    }
    image = p
    bw = iw
    bh = ih
    return true
}

// EINEN STREIFEN MALEN UND HINUEBERSCHIEBEN. Genau der Weg, den die
// Widget-Bibliothek geht (`kernel/user/wlibc.fi`): die Flaeche ist 800
// mal 81 Bildpunkte gross, ein Fenster von 800 mal 600 passt nicht in
// den Speicher eines Prozesses, also wird es in Streifen gemalt.
fn streifen(y0: u64, hoehe: u64) {
    wlibc.set_band(y0)
    wlibc.clip_set(0, y0, sw, y0 + hoehe)
    var y: u64 = y0
    while y < y0 + hoehe {
        var x: u64 = 0
        while x < sw {
            wlib.draw_point(x, y, color_at(x, y))
            x = x + 1
        }
        y = y + 1
    }
    let _n: u64 = wlibc.push(w_h, 0, y0, sw, hoehe)
}

fn all_paint() {
    var y: u64 = 0
    while y < sh {
        var hoehe: u64 = wlibc.surf_rows()
        if y + hoehe > sh {
            hoehe = sh - y
        }
        streifen(y, hoehe)
        y = y + hoehe
    }
}

// ====================================== RUNDE MODULE: DIE KAESTCHEN
//
// Justins Auftrag, 22.09.2026: "man soll das alles einstellen koennen
// also so wie in einem minecraft client die ganzen module hin und
// herschieben etc".
//
// Die Tafel, das Ziehen, das Einrasten und die Datei stehen in
// `kernel/user/modul.fi`; hier steht nur, WANN gemalt wird -- und das
// ist der Teil, an dem die Bilder je Sekunde haengen.
//
// DER FLECK IST DER GANZE TRICK. `all_paint` malt 800x600 Bildpunkte
// einzeln (480 000 Aufrufe von `color_at`); das je Modul und Bild zu
// tun, waere der sichere Weg, eine Uhr teurer zu machen als den
// ganzen Schreibtisch. `fleck` malt GENAU das Rechteck eines Moduls
// neu -- bei 120x32 sind das 3 840 Punkte, ein Hundertstel davon --
// und schiebt auch nur dieses Rechteck hinaus.
//
// GEMALT WIRD MIT `color_at`, also mit derselben Rechnung wie das
// grosse Bild. Ein zweiter Weg waere eine zweite Umsetzung desselben
// Hintergrunds -- und man saehe nach dem naechsten Hintergrundbild,
// dass unter den Modulen ein Rechteck in der falschen Farbe steht.
//
// DIE STREIFEN. Die Malflaeche des Servers traegt nicht den ganzen
// Schirm, sondern `wlibc.surf_rows()` Zeilen (kernel/user/desktop.fi,
// `all_paint` geht deshalb in Streifen). Ein Fleck, der ueber eine
// Streifengrenze laeuft, muss in BEIDEN Streifen gemalt und zweimal
// hinausgeschoben werden; genau das tut die aeussere Schleife.
fn fleck(x: u64, y: u64, w: u64, h: u64) {
    if w == 0 || h == 0 {
        return
    }
    let x0: u64 = x
    var x1: u64 = x + w
    var y1: u64 = y + h
    if x1 > sw {
        x1 = sw
    }
    if y1 > sh {
        y1 = sh
    }
    if x0 >= x1 || y >= y1 {
        return
    }
    var yy: u64 = y
    while yy < y1 {
        wlibc.set_band(yy)
        let rows: u64 = wlibc.surf_rows()
        var bis: u64 = y1
        if rows > 0 {
            let bandende: u64 = (yy / rows) * rows + rows
            if bis > bandende {
                bis = bandende
            }
        }
        if bis <= yy {
            return
        }
        wlibc.clip_set(x0, yy, x1, bis)
        var py: u64 = yy
        while py < bis {
            var px: u64 = x0
            while px < x1 {
                wlib.draw_point(px, py, color_at(px, py))
                px = px + 1
            }
            py = py + 1
        }
        let _n: u64 = wlibc.push(w_h, x0, yy, x1 - x0, bis - yy)
        yy = bis
    }
}

// WELCHES MODUL GERADE EINEN RAHMEN TRAEGT (die Hand liegt darauf oder
// es wird gezogen). 99 = keines.
static mut modul_zeigt: u64 = 99

// Ein Modul malen: erst den Hintergrund an seiner Stelle, dann das
// Kaestchen darueber, und beides streifenweise -- aus demselben
// Grund wie in `fleck`.
fn modul_malen(i: u64) {
    if !modul.an(i) {
        return
    }
    let x: u64 = modul.x_von(i)
    let y: u64 = modul.y_von(i)
    let w: u64 = modul.breite(i)
    let h: u64 = modul.hoehe(i)
    fleck(x, y, w, h)
    var yy: u64 = y
    var y1: u64 = y + h
    if y1 > sh {
        y1 = sh
    }
    while yy < y1 {
        wlibc.set_band(yy)
        let rows: u64 = wlibc.surf_rows()
        var bis: u64 = y1
        if rows > 0 {
            let bandende: u64 = (yy / rows) * rows + rows
            if bis > bandende {
                bis = bandende
            }
        }
        if bis <= yy {
            return
        }
        wlibc.clip_set(x, yy, x + w, bis)
        modul.malen(i)
        if modul_zeigt == i {
            modul.rahmen_malen(i)
        }
        let _n: u64 = wlibc.push(w_h, x, yy, w, bis - yy)
        yy = bis
    }
}

fn module_malen() {
    var i: u64 = 0
    while i < modul.ANZ {
        modul_malen(i)
        i = i + 1
    }
}

// ============================================ DIE BELEGZEILEN
//
// Ein Testlaeufer soll die Lage eines Moduls NACHLESEN koennen und
// nicht im Bild raten muessen -- dieselbe Regel, nach der der
// Schreibtisch seine fuenf Stuetzstellen meldet und die Taskleiste
// ihren Startknopf. Gemeldet wird, was die Tafel WIRKLICH haelt:
// Anker und Abstand, und daneben die daraus gerechneten Bildpunkte.
static mut m_s1: [u8; 16] = "desktop: modul \0"
static mut m_s2: [u8; 7] = " name=\0"
static mut m_s3: [u8; 5] = " an=\0"
static mut m_s4: [u8; 8] = " anker=\0"
static mut m_s5: [u8; 5] = " dx=\0"
static mut m_s6: [u8; 5] = " dy=\0"
static mut m_s7: [u8; 4] = " x=\0"
static mut m_s8: [u8; 4] = " y=\0"
static mut m_s9: [u8; 4] = " w=\0"
static mut m_s10: [u8; 4] = " h=\0"
static mut m_s11: [u8; 7] = " text=\0"

fn modul_say(i: u64) {
    say((&m_s1[0 as usize]) as u64)
    sayn(i)
    say((&m_s2[0 as usize]) as u64)
    say(modul.name_von(i))
    say((&m_s3[0 as usize]) as u64)
    var a: u64 = 0
    if modul.an(i) {
        a = 1
    }
    sayn(a)
    say((&m_s4[0 as usize]) as u64)
    sayn(modul.anker_von(i))
    say((&m_s5[0 as usize]) as u64)
    sayn(modul.dx_von(i))
    say((&m_s6[0 as usize]) as u64)
    sayn(modul.dy_von(i))
    say((&m_s7[0 as usize]) as u64)
    sayn(modul.x_von(i))
    say((&m_s8[0 as usize]) as u64)
    sayn(modul.y_von(i))
    say((&m_s9[0 as usize]) as u64)
    sayn(modul.breite(i))
    say((&m_s10[0 as usize]) as u64)
    sayn(modul.hoehe(i))
    say((&m_s11[0 as usize]) as u64)
    say(modul.text_von(i))
    nl()
}

fn module_say() {
    var i: u64 = 0
    while i < modul.ANZ {
        modul_say(i)
        i = i + 1
    }
}

// ====================================== RUNDE WMPLUGIN: DER AUTOSTART
//
// WAS HIER GELOEST WIRD. Fenstererweiterungen sind in diesem System
// Ring-3-Prozesse (kernel/wmplug.fi). Zwei Schritte gehoeren zu jedem:
// die Rechte gewaehren (`wmplug enable <name>`, das ist WM_PLUG_GRANT
// und geht nur als root) und das Programm starten. Bis zu dieser Runde
// erledigte das ein eigenes Hilfsprogramm (/bin/uhrstart), das nichts
// anderes tat -- eine benannte Abkuerzung, die hier ihr Ende findet:
// jetzt steht die Liste in einer DATEI, und der Schreibtisch liest sie.
//
// DAS FORMAT IST EINE ZEILE JE ERWEITERUNG:
//
//     uhr runden=30          # Name, dahinter Woerter FUER DAS PLUGIN
//     regel demo
//
// Der Name geht an `wmplug enable`, das die Rechte und die Frist aus
// /etc/wmplug.conf holt und das Programm aus `prog=` startet; die
// restlichen Woerter reicht es an das Plugin durch. Alles hinter `#`
// ist Bemerkung.
//
// WARUM DER SCHREIBTISCH UND NICHT DER KERN: der Kern liest keine
// Dateien und macht keine Namenspolitik (dieselbe Regel wie bei der
// Gewaehrungstafel). Und warum nicht die Leiste: der Schreibtisch ist
// das erste Programm der Sitzung, das sicher als Wurzel laeuft.
//
// FEHLT DIE DATEI, PASSIERT NICHTS -- ein Schreibtisch ohne
// Erweiterungen ist der Normalfall und keine Stoerung.
fn autostart() {
    var pfad: [u8; 24] = "/etc/wmplug.autostart\0\0\0"
    var p_wm: [u8; 13] = "/bin/wmplug\0\0"
    var a_wm: [u8; 7] = "wmplug\0"
    var a_en: [u8; 7] = "enable\0"
    var s_kl: [u8; 34] = "desktop: autostart keine Liste\0\0\0\0"
    var s_st: [u8; 21] = "desktop: autostart [\0"
    var s_rc: [u8; 8] = "] pid=\0\0"
    var puffer: [u8; 1024] = [0 as u8; 1024]
    var zeile: [u8; 128] = [0 as u8; 128]
    var wort: [u8; 4096] = [0 as u8; 4096]
    var argv: [u64; 8] = [0 as u64; 8]

    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&pfad[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        ulib.say((&s_kl[0 as usize]) as u64)
        ulib.nl()
        return
    }
    // ERST DIE SITZUNG, DANN DIE ERWEITERUNGEN. Zwei Sekunden, und die
    // Zahl ist gemessen: `desk` startet nach dem Schreibtisch noch
    // Leiste und Starter, und ein SYS_EXEC laedt das ganze Abbild IM
    // Systemaufruf (1,4 Megaoktett, `elf: start ... pages=432`).
    // Waehrenddessen kommt kein anderer Prozess dran -- ein Plugin, das
    // sich vorher angemeldet hat, holt in dieser Zeit NICHTS ab, und
    // der Kehrbesen des Kerns hat recht, wenn er es hinauswirft
    // (gemessen: `wmplug: unreg uhr grund=2 holte=1`). Das ist keine
    // Schwaeche der Frist, sondern der Preis eines synchronen
    // Programmstarts; die Erweiterung wartet, bis er vorbei ist.
    ulib.sleep_ms(2000)
    let buf: u64 = (&puffer[0 as usize]) as u64
    var len: u64 = 0
    var weiter: bool = true
    while weiter && len < 1000 {
        let got: u64 = ulib.sys(ulib.SYS_READ, fd, buf + len, 1000 - len)
        if ulib.bad(got) || got == 0 {
            weiter = false
        } else {
            len = len + got
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)

    let zp: u64 = (&zeile[0 as usize]) as u64
    let wp: u64 = (&wort[0 as usize]) as u64
    var i: u64 = 0
    while i < len {
        // Eine Zeile herausschneiden, Bemerkungen fallen dabei weg.
        var n: u64 = 0
        var kommentar: bool = false
        while i < len && (__mmio_read8((buf + i) as *mut u8)) as u64 != 10 {
            let c: u64 = (__mmio_read8((buf + i) as *mut u8)) as u64
            if c == 35 {
                kommentar = true
            }
            if !kommentar && n + 1 < 128 && c != 13 && c != 9 {
                __mmio_write8((zp + n) as *mut u8, c as u8)
                n = n + 1
            }
            i = i + 1
        }
        i = i + 1
        __mmio_write8((zp + n) as *mut u8, 0 as u8)
        if n != 0 {
            // DIE WOERTER LIEGEN EINZELN UND HINTEREINANDER im Puffer:
            // `SYS_EXEC` bekommt Zeiger, und ein Zeiger auf einen
            // Puffer, den das naechste Wort gleich wieder ueberschreibt,
            // zeigt beim Aufruf auf das falsche Wort. Ein Fehler, den
            // man erst am Plugin sieht.
            var argc: u64 = 2
            argv[(0) as usize] = (&a_wm[0 as usize]) as u64
            argv[(1) as usize] = (&a_en[0 as usize]) as u64
            var at: u64 = 0
            var noch: bool = true
            var off: u64 = 0
            while noch && argc < 8 {
                let na: u64 = ulib.word(zp, at, wp + off, 64)
                if na == at {
                    noch = false
                } else {
                    at = na
                    if (__mmio_read8((wp + off) as *mut u8)) as u64 != 0 {
                        argv[(argc) as usize] = wp + off
                        argc = argc + 1
                        off = off + 64
                    }
                }
            }
            if argc > 2 {
                let rc: u64 = ulib.sys(ulib.SYS_EXEC,
                    (&p_wm[0 as usize]) as u64,
                    (&argv[0 as usize]) as u64, argc)
                ulib.say((&s_st[0 as usize]) as u64)
                ulib.say(zp)
                ulib.say((&s_rc[0 as usize]) as u64)
                ulib.sayn(rc)
                ulib.nl()
                // DEM AUFGERUFENEN ZEIT LASSEN. `wmplug enable` gewaehrt
                // die Rechte und startet danach das Plugin; zwei Zeilen
                // der Liste gleichzeitig zu starten hiesse, zwei
                // SYS_EXEC ineinanderzuschieben. Gewartet wird in
                // RING 3 -- der Kern kennt diese Liste nicht.
                ulib.sleep_ms(400)
            }
        }
    }
}

fn u_start(args: u64) -> u64 {
    dbg_setup(args)
    var s_nb: [u8; 7] = "nobild\0"
    var s_bad: [u8; 23] = "desktop: keine Flaeche\0"
    var s_nol: [u8; 44] = "desktop: keine Ebene 0 -- nicht die Wurzel?\0"
    var s_rd: [u8; 16] = "desktop: ready \0"
    var s_w: [u8; 3] = "w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_l: [u8; 8] = " layer=\0"
    var s_d: [u8; 7] = " deco=\0"
    var s_bi: [u8; 17] = "desktop: bild w=\0"
    var s_bh: [u8; 4] = " h=\0"
    var s_bq: [u8; 10] = " quelle=[\0"
    var s_zu: [u8; 2] = "]\0"
    var s_vl: [u8; 23] = "desktop: verlauf oben=\0"
    var s_un: [u8; 8] = " unten=\0"
    var s_pt: [u8; 18] = "desktop: punkt x=\0"
    var s_py: [u8; 4] = " y=\0"
    var s_pc: [u8; 4] = " c=\0"
    var s_wall: [u8; 15] = "/etc/wallpaper\0"
    var s_th: [u8; 11] = "/etc/theme\0"
    var s_ne: [u8; 21] = "desktop: neu schema=\0"
    var s_mod: [u8; 24] = "desktop: module datei=\0\0"
    var s_bm: [u8; 26] = "desktop: module bearbeit=\0"

    let _mk: u64 = msg.init()
    var ohne_bild: bool = false
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        if ulib.streq(ulib.arg_at(args, a), (&s_nb[0 as usize]) as u64) {
            ohne_bild = true
        }
        a = a + 1
    }
    if !wlibc.start(false) {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    var schema: u64 = wlibc.theme_reload()
    let _s0: u64 = schema
    sw = wlibc.screen_w()
    sh = wlibc.screen_h()
    // DAS FENSTER IST DER GANZE BILDSCHIRM. Ohne Schmuck heisst: das
    // aeussere Rechteck IST die Malflaeche, es geht kein Rahmen ab.
    let h: u64 = wlibc.sys5(wlibc.WM_CREATE, 0, (sw << 16) | sh,
        msg.get((&k_title[0 as usize]) as u64), 0, 0)
    if ulib.bad(h) || h == 0 {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    w_h = h
    if ulib.bad(wlibc.win_state(h, wlibc.WS_DECO, 0)) {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    // UND JETZT NACH GANZ HINTEN. Schlaegt das fehl, hoert dieses
    // Programm auf -- ein Schreibtisch, der vor den Fenstern liegt,
    // ist schlimmer als keiner.
    if ulib.bad(wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_DESK)) {
        // RUNDE ANMELDUNG: DIESE ZEILE STEHT IMMER AUF DER LEITUNG,
        // auch ohne /etc/uitrace.
        //
        // Sie hat eine ganze Abnahme gekostet: der Schreibtisch starb
        // hier (E_RIGHTS, weil Ebene 0 der Wurzel vorbehalten war),
        // und weil `say` hinter dem Messschalter steht, stand im
        // Bericht KEIN Wort davon -- nur ein leerer Schirm und eine
        // wiederverwendete Prozessnummer. Ein Abbruchgrund ist keine
        // Messung, sondern die Auskunft, warum nichts da ist; er
        // gehoert nicht hinter einen Schalter.
        ulib.say((&s_nol[0 as usize]) as u64)
        ulib.nl()
        let _c: u64 = wlibc.sys3w(wlibc.WM_CLOSE, h, 0, 0)
        return 1
    }
    // RUNDE THEME: der Verlauf hat jetzt EIGENE Marken. Vorher lieh
    // sich der Schreibtisch die Farbe der Werkzeugleiste und die des
    // Fensterhintergrunds -- und aenderte sich mit, sobald eine von
    // beiden sich aus einem anderen Grund aenderte.
    c_oben = wlibc.theme(wlibc.C_DESKTOP_TOP)
    c_unten = wlibc.theme(wlibc.C_DESKTOP_BOTTOM)
    var mit_bild: bool = false
    if !ohne_bild {
        mit_bild = image_load((&s_wall[0 as usize]) as u64)
    }
    all_paint()

    say((&s_rd[0 as usize]) as u64)
    say((&s_w[0 as usize]) as u64)
    sayn(sw)
    say((&s_h[0 as usize]) as u64)
    sayn(sh)
    say((&s_l[0 as usize]) as u64)
    sayn(wlibc.sys3w(wlibc.WM_INFO, h, wlibc.WI_LAYER, 0))
    say((&s_d[0 as usize]) as u64)
    sayn(0)
    nl()
    if mit_bild {
        say((&s_bi[0 as usize]) as u64)
        sayn(bw)
        say((&s_bh[0 as usize]) as u64)
        sayn(bh)
        say((&s_bq[0 as usize]) as u64)
        say((&s_wall[0 as usize]) as u64)
        say((&s_zu[0 as usize]) as u64)
        nl()
    } else {
        say((&s_vl[0 as usize]) as u64)
        sayn(c_oben)
        say((&s_un[0 as usize]) as u64)
        sayn(c_unten)
        nl()
    }
    autostart()

    // ==================================================== RUNDE MODULE
    // DIE REIHENFOLGE IST HIER WICHTIG UND NICHT BELIEBIG.
    //
    //   1. `schirm_setzen` -- ohne Breite und Hoehe laesst sich kein
    //      Anker in Bildpunkte rechnen (x_von/y_von teilen durch sie).
    //   2. `vorgabe` -- die Lage, die gilt, wenn es keine Datei gibt.
    //   3. `laden` -- was der Nutzer beim letzten Mal gezogen hat.
    //      Fehlt die Datei, bleibt die Vorgabe stehen; das ist der
    //      erste Start und keine Stoerung.
    //   4. `messen` NACH dem Laden -- die Groesse kommt aus der
    //      Schrift und nicht aus der Datei. Eine gespeicherte Breite
    //      waere nach einem Schriftwechsel falsch, und der Text stuende
    //      ueber den Rand.
    modul.schirm_setzen(sw, sh)
    modul.vorgabe()
    let m_datei: bool = modul.laden()
    modul.messen()
    let _mw: bool = modul.werte_holen()
    modul.texte_bauen()
    module_malen()
    say((&s_mod[0 as usize]) as u64)
    var m_d: u64 = 0
    if m_datei {
        m_d = 1
    }
    sayn(m_d)
    nl()
    module_say()

    // FUENF STUETZSTELLEN, und der Laeufer haelt sie gegen das Bild.
    // Sie stehen bewusst NICHT alle in einer Zeile: eine Stuetzstelle,
    // die zufaellig stimmt, faellt neben vier anderen auf.
    var k: u64 = 0
    while k < 5 {
        let px_: u64 = sw * (2 * k + 1) / 10
        let py_: u64 = sh * (2 * k + 1) / 10
        say((&s_pt[0 as usize]) as u64)
        sayn(px_)
        say((&s_py[0 as usize]) as u64)
        sayn(py_)
        say((&s_pc[0 as usize]) as u64)
        sayn(color_at(px_, py_))
        nl()
        k = k + 1
    }

    // DIE SCHLEIFE. Sie holt Ereignisse ab (sonst laeuft der Ring des
    // Servers ueber) und sieht ab und zu nach, ob sich das Farbschema
    // geaendert hat -- die Einstellungen schreiben `/etc/theme`, und
    // ein Schreibtisch, der dafuer einen Neustart braucht, ist keiner.
    var sum: u64 = wlibc.theme_sum()
    var runde: u64 = 0
    var lebt: bool = true
    while lebt {
        var n: u64 = 0
        while n < 32 && wlibc.sys3w(wlibc.WM_EVENT, h,
            (&ev[0 as usize]) as u64, 0) == 1 {
            let typ: u64 = __mmio_read64(((&ev[0 as usize]) as u64)
                as *mut u64)
            let dd: u64 = __mmio_read64((((&ev[0 as usize]) as u64) + 8)
                as *mut u64)
            let e_x: u64 = (dd >> 32) & 0xFFFF
            let e_y: u64 = (dd >> 16) & 0xFFFF
            if typ == wlibc.EV_CLOSE {
                lebt = false
            } else if typ == wlibc.EV_DOWN {
                // ======================================== RUNDE MODULE
                //
                // DER RECHTE KNOPF AUF EINEM MODUL SCHALTET DEN
                // BEARBEITUNGSMODUS -- UND ZWAR AUS EINEM GEMESSENEN
                // GRUND UND NICHT AUS GESCHMACK.
                //
                // Geplant war F9. F9 kommt hier NIE an: der
                // Schreibtisch liegt auf `L_DESK`, und der
                // Fensterserver gibt einem Fenster dieser Ebene den
                // Fokus mit Absicht nicht (kernel/ui/wm.fi, `on_down`:
                // "ein Schreibtisch, der den Fokus an sich zieht, macht
                // jeden Tastendruck danach wirkungslos"). GEMESSEN:
                // `sendkey f9` ueber den QEMU-Monitor, 54 Befehle
                // angekommen, und in der seriellen Ausgabe steht keine
                // einzige `module bearbeit=`-Zeile.
                //
                // Die sauberen Wege dahin waeren zwei, und beide
                // gehoeren NICHT in diese Runde: `F_KEYS` setzen hiesse
                // den Fokus dauerhaft zu nehmen (genau das, was der
                // Server verhindert), und ein globales Kuerzel gibt es
                // schon -- `WM_PLUG_KEY` im Plugin-Register --, aber
                // dafuer muesste sich der Schreibtisch als Erweiterung
                // anmelden und das Recht R_ACT_KEY bekommen. Das ist
                // eine eigene Runde wert und nicht ein Seitenhieb in
                // dieser.
                //
                // Die Maus reicht vollkommen: ein Minecraft-Client
                // macht sein Modulfenster auch mit einem Klick auf.
                // Die TASTE bleibt in /etc/module.conf stehen (`taste=`)
                // -- sie ist schon gelesen, geschrieben und einstellbar,
                // sie wartet nur auf den Weg, auf dem sie ankommt.
                let knopf: u64 = dd & 0xFFFF
                if (knopf & 2) != 0 {
                    let tr0: u64 = modul.treffer(e_x, e_y)
                    if tr0 < modul.ANZ {
                        let war0: bool = modul.bearbeiten()
                        modul.bearbeiten_setzen(!war0)
                        if war0 {
                            modul_zeigt = 99
                            if modul.schmutzig() {
                                let _s3: bool = modul.sichern()
                            }
                        } else {
                            modul_zeigt = tr0
                        }
                        say((&s_bm[0 as usize]) as u64)
                        var b0: u64 = 0
                        if modul.bearbeiten() {
                            b0 = 1
                        }
                        sayn(b0)
                        nl()
                        module_malen()
                    }
                } else if modul.bearbeiten() {
                    // ANFASSEN. Nur im Bearbeitungsmodus -- sonst
                    // faengt der Schreibtisch Klicks ab, die dem
                    // Nutzer gehoeren.
                    let tr: u64 = modul.treffer(e_x, e_y)
                    if tr < modul.ANZ {
                        if modul.ziehen_start(tr, e_x, e_y) {
                            modul_zeigt = tr
                            modul_malen(tr)
                        }
                    }
                }
            } else if typ == wlibc.EV_MOVE {
                if modul.bearbeiten() {
                    if modul.zieht() {
                        // DIE ALTE STELLE MERKEN, BEVOR SIE SICH
                        // AENDERT. Ohne das bleibt beim Ziehen eine
                        // Spur des Kaestchens stehen -- der Fleck
                        // wuerde an der NEUEN Stelle gewischt und die
                        // alte nie.
                        let gz: u64 = modul.gezogen()
                        let ox: u64 = modul.x_von(gz)
                        let oy: u64 = modul.y_von(gz)
                        let ow: u64 = modul.breite(gz)
                        let oh: u64 = modul.hoehe(gz)
                        if modul.ziehen_zu(e_x, e_y) {
                            fleck(ox, oy, ow, oh)
                            modul_malen(gz)
                        }
                    } else {
                        // Die Hand liegt auf einem Modul: Rahmen an,
                        // und den alten Rahmen weg.
                        let tr2: u64 = modul.treffer(e_x, e_y)
                        var nz: u64 = 99
                        if tr2 < modul.ANZ {
                            nz = tr2
                        }
                        if nz != modul_zeigt {
                            let vorher: u64 = modul_zeigt
                            modul_zeigt = nz
                            if vorher < modul.ANZ {
                                modul_malen(vorher)
                            }
                            if nz < modul.ANZ {
                                modul_malen(nz)
                            }
                        }
                    }
                }
            } else if typ == wlibc.EV_UP {
                if modul.zieht() {
                    let fertig: u64 = modul.ziehen_ende()
                    if fertig < modul.ANZ {
                        modul_malen(fertig)
                        modul_say(fertig)
                    }
                    // SOFORT SICHERN. Ein Nutzer, der ein Kaestchen
                    // hinzieht und den Rechner ausschaltet, hat es
                    // verschoben -- nicht "vielleicht".
                    let _sv: bool = modul.sichern()
                }
            } else if typ == wlibc.EV_KEY {
                // ========================== RUNDE ECHTHARDWARE-3
                // AUCH HIER FIELEN TASTEN AUF DEN BODEN.
                //
                // Dieselbe Stelle wie in `taskbar.fi`: die Schleife
                // holt jedes Ereignis ab (und nimmt es damit aus dem
                // Ring des Servers) und sah nur nach `EV_CLOSE`. Der
                // Schreibtisch bekommt den Fokus zwar nicht von
                // selbst (wm.fi: nur L_NORMAL oder F_KEYS), aber
                // `wm.on_key` schickt bei `nofocus` an JEDES Fenster
                // -- und dann war die Taste hier zu Ende.
                let taste: u64 = (dd >> 32) & 0xFFFF
                // ======================================== RUNDE MODULE
                // F9 SCHALTET DEN BEARBEITUNGSMODUS.
                //
                // Die Taste steht in /etc/module.conf als `taste=`, ist
                // also aenderbar (Justins Wunsch: "man sollte die
                // keybinds auch in den settings aendern koennen").
                // Vorgabe ist F9.
                if taste == modul.taste() && taste != 0 {
                    let war: bool = modul.bearbeiten()
                    modul.bearbeiten_setzen(!war)
                    if war {
                        modul_zeigt = 99
                        // Beim Verlassen sichern, falls noch etwas
                        // offen war.
                        if modul.schmutzig() {
                            let _s2: bool = modul.sichern()
                        }
                    }
                    say((&s_bm[0 as usize]) as u64)
                    var bb: u64 = 0
                    if modul.bearbeiten() {
                        bb = 1
                    }
                    sayn(bb)
                    nl()
                    module_malen()
                } else {
                    wlib.feed_key(taste)
                }
            }
            n = n + 1
        }
        runde = runde + 1
        // ==================================================== RUNDE MODULE
        // EINMAL JE SEKUNDE, UND NUR WENN SICH EINE ZAHL GEAENDERT HAT.
        //
        // Die Schleife dreht alle 25 ms; 40 Runden sind eine Sekunde.
        // `werte_holen` gibt nur dann true, wenn sich Minute, Speicher
        // oder Last WIRKLICH bewegt haben -- ein Modul, das sich jede
        // Sekunde neu malt, um dieselbe Minute zu zeigen, kostet
        // Bilder je Sekunde fuer nichts.
        if (runde % 40) == 0 && !modul.zieht() {
            if modul.werte_holen() {
                modul.texte_bauen()
                module_malen()
            }
        }
        if (runde % 10) == 0 {
            if wlibc.theme_poll() {
                sum = wlibc.theme_sum()
                schema = wlibc.theme_scheme_keys()
                c_oben = wlibc.theme(wlibc.C_DESKTOP_TOP)
                c_unten = wlibc.theme(wlibc.C_DESKTOP_BOTTOM)
                all_paint()
                // Das Schema hat gewechselt: die Module tragen seine
                // Farben, und `all_paint` hat sie gerade uebermalt.
                modul.messen()
                module_malen()
                say((&s_ne[0 as usize]) as u64)
                sayn(schema)
                nl()
            }
        }
        ulib.sleep_ms(25)
    }
    return 0
}

// RUNDE ROTABSCHNITTE: DIESES `main` LAEUFT, UND ES MUSS DIE
// ARGUMENTE WEITERGEBEN.
//
// Der Kommentar, der hier stand, sagte "das `main`, das nie laeuft --
// `user.ld` springt nach `u_start`". Das stimmt fuer ein Programm, das
// mit `kernel/user/crt.s` gebunden ist; dessen `_start` ruft
// USER_ENTRY. Unter `profile app` stimmt es NICHT: dort bringt firnc
// sein eigenes `_start` mit (darum darf crt.o nicht dazu, siehe
// tools/look/shot.sh), und das endet in `call main` -- der Name steht
// fest in lib/firnc1/codegen.fi, `--defsym=USER_ENTRY` erreicht ihn
// nicht. Am gebauten ELF nachgesehen: Einsprung ist `_start`, sechs
// Befehle weiter steht `call <main>`; `_F0.u_start` wird von dort nie
// gerufen.
//
// `u_start(0)` warf damit den Argumentblock weg. Bei powermon waren
// das 54 rote Zusagen (siehe ROTABSCHNITTE 11/n).
//
// Der Block liegt an einer FESTEN Adresse: Runde K16 legte den
// Stapelzeiger darauf (kernel/elf.fi, `T_USTACK = proc.ARGS_BASE`),
// und firnc's `_start` macht `mov rsp, rdi`. Jede `elf: start`-Zeile
// dieses Systems druckt sie als `ustack=0x4007f000`.
fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
