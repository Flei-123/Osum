export { u_start }

static mut k_title: [u8; 14] = "desktop.title\0"

const IMAGE_MAX_W: u64 = 480
const IMAGE_MAX_H: u64 = 300

static mut w_h: u64 = 0
static mut w_shared: u64 = 0 // COMPOSITOR r486: 1 = the window paints from a shared buffer (no WIG_BLIT)
static mut w_shp: u64 = 0 // r1004: the shared buffer of the window (kept to remake it after a resolution change)
static mut w_shb: u64 = 0
static mut sw: u64 = 0
static mut sh: u64 = 0
static mut image_bytes: u64 = 0 // size of the mapping behind `image`
static mut head: [u8; 16] = [0 as u8; 16]
static mut ev: [u8; 16] = [0 as u8; 16]

static mut s_dbg: u64 = 0

fn dbg_on() -> bool {
    return s_dbg != 0
}

fn dbg_setup(args: u64) {
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_dbg = 1
    }
    var a_dbg: [u8; 6] = "debug\0"
    let argc: u64 = ulib.arg_count(args)
    var ai: u64 = 1
    while ai < argc {
        if ulib.streq(ulib.arg_at(args, ai), (&a_dbg[0 as usize]) as u64) {
            s_dbg = 1
        }
        ai = ai + 1
    }
}

fn say(p: u64) {
    if s_dbg == 0 {
        return
    }
    lineout.add_text(p)
}

fn sayn(v: u64) {
    if s_dbg == 0 {
        return
    }
    lineout.add_num(v)
}

fn nl() {
    if s_dbg == 0 {
        return
    }
    lineout.end_line()
}

fn u32_at(p: u64) -> u64 {
    return (__mmio_read8((p) as *mut u8) as u64)
        | ((__mmio_read8((p + 1) as *mut u8) as u64) << 8)
        | ((__mmio_read8((p + 2) as *mut u8) as u64) << 16)
        | ((__mmio_read8((p + 3) as *mut u8) as u64) << 24)
}

fn image_load(path: u64) -> bool {
    let fd: u64 = io.open(path, 0)
    if ulib.bad(fd) {
        return false
    }
    let k: u64 = (&head[0 as usize]) as u64
    let n: u64 = io.read_full(fd, k, 12)
    if ulib.bad(n) || n < 12 {
        io.close(fd)
        return false
    }
    if head[(0) as usize] != 79 as u8 || head[(1) as usize] != 83 as u8 {
        io.close(fd)
        return false
    }
    if head[(2) as usize] != 89 as u8 || head[(3) as usize] != 77 as u8 {
        io.close(fd)
        return false
    }
    let iw: u64 = u32_at(k + 4)
    let ih: u64 = u32_at(k + 8)
    if iw == 0 || ih == 0 || iw > IMAGE_MAX_W || ih > IMAGE_MAX_H {
        io.close(fd)
        return false
    }
    let bytes: u64 = iw * ih * 4
    // reload (desktop context menu): a picture that fits into the old mapping reuses it -- a process has no unmap for these
    var p: u64 = 0
    if uiwallpaper.image_ptr() != 0 && bytes <= image_bytes {
        p = uiwallpaper.image_ptr()
    } else {
        p = hosthead.map_surface(bytes)
        image_bytes = bytes
    }
    if p == 0 {
        io.close(fd)
        return false
    }
    let g: u64 = io.read_full(fd, p, bytes)
    io.close(fd)
    if ulib.bad(g) || g < bytes {
        return false
    }
    uiwallpaper.set_image(p, iw, ih)
    return true
}

// COMPOSITOR r486: the painted rectangle reaches the window server. Shared buffer: name the damage, nothing is copied. Otherwise the old
// way (WIG_BLIT of a band).
fn flush(x: u64, y: u64, w: u64, h: u64) {
    if w_shared != 0 {
        let _d: u64 = hostwin.win_damage(w_h, x, y, w, h)
        return
    }
    let _n: u64 = wlibc.push(w_h, x, y, w, h)
}

fn streifen(y0: u64, height: u64) {
    hosthead.set_band(y0)
    uidraw.clip_set(0, y0, sw, y0 + height)
    uiwallpaper.paint(0, y0, sw, y0 + height)
    flush(0, y0, sw, height)
}

fn all_paint() {
    var y: u64 = 0
    while y < sh {
        var height: u64 = hosthead.surf_rows()
        if y + height > sh {
            height = sh - y
        }
        streifen(y, height)
        y = y + height
    }
}

// ====================================== RUNDE MODULE: DIE KAESTCHEN
fn fleck(x: u64, y: u64, w: u64, h: u64) {
    if w == 0 || h == 0 {
        return
    }
    let x0: u64 = x
    var x1: u64 = x + w
    var y1: u64 = y + h
    if x1 > sw {
        x1 = sw
    }
    if y1 > sh {
        y1 = sh
    }
    if x0 >= x1 || y >= y1 {
        return
    }
    var yy: u64 = y
    while yy < y1 {
        hosthead.set_band(yy)
        let rows: u64 = hosthead.surf_rows()
        var bis: u64 = y1
        if rows > 0 {
            let bandende: u64 = (yy / rows) * rows + rows
            if bis > bandende {
                bis = bandende
            }
        }
        if bis <= yy {
            return
        }
        uidraw.clip_set(x0, yy, x1, bis)
        uiwallpaper.paint(x0, yy, x1, bis)
        flush(x0, yy, x1 - x0, bis - yy)
        yy = bis
    }
}

static mut widget_shown: u64 = 99

fn widget_paint(i: u64) {
    if !widgetboard.an(i) {
        return
    }
    let x: u64 = widgetboard.x_von(i)
    let y: u64 = widgetboard.y_von(i)
    let w: u64 = widgetboard.width(i)
    let h: u64 = widgetboard.height(i)
    fleck(x, y, w, h)
    var yy: u64 = y
    var y1: u64 = y + h
    if y1 > sh {
        y1 = sh
    }
    while yy < y1 {
        hosthead.set_band(yy)
        let rows: u64 = hosthead.surf_rows()
        var bis: u64 = y1
        if rows > 0 {
            let bandende: u64 = (yy / rows) * rows + rows
            if bis > bandende {
                bis = bandende
            }
        }
        if bis <= yy {
            return
        }
        uidraw.clip_set(x, yy, x + w, bis)
        widgetboard.paint(i)
        if widget_shown == i {
            widgetboard.paint_frame(i)
        }
        flush(x, yy, w, bis - yy)
        yy = bis
    }
}

fn widgets_paint() {
    var i: u64 = 0
    while i < widgetboard.ANZ {
        widget_paint(i)
        i = i + 1
    }
}

// ============================================ DIE BELEGZEILEN
static mut m_s1: [u8; 17] = "desktop: module \0"
static mut m_s2: [u8; 7] = " name=\0"
static mut m_s3: [u8; 5] = " an=\0"
static mut m_s4: [u8; 9] = " anchor=\0"
static mut m_s5: [u8; 5] = " dx=\0"
static mut m_s6: [u8; 5] = " dy=\0"
static mut m_s7: [u8; 4] = " x=\0"
static mut m_s8: [u8; 4] = " y=\0"
static mut m_s9: [u8; 4] = " w=\0"
static mut m_s10: [u8; 4] = " h=\0"
static mut m_s11: [u8; 7] = " text=\0"

fn widget_say(i: u64) {
    say((&m_s1[0 as usize]) as u64)
    sayn(i)
    say((&m_s2[0 as usize]) as u64)
    say(widgetboard.name_von(i))
    say((&m_s3[0 as usize]) as u64)
    var a: u64 = 0
    if widgetboard.an(i) {
        a = 1
    }
    sayn(a)
    say((&m_s4[0 as usize]) as u64)
    sayn(widgetboard.anker_von(i))
    say((&m_s5[0 as usize]) as u64)
    sayn(widgetboard.dx_von(i))
    say((&m_s6[0 as usize]) as u64)
    sayn(widgetboard.dy_von(i))
    say((&m_s7[0 as usize]) as u64)
    sayn(widgetboard.x_von(i))
    say((&m_s8[0 as usize]) as u64)
    sayn(widgetboard.y_von(i))
    say((&m_s9[0 as usize]) as u64)
    sayn(widgetboard.width(i))
    say((&m_s10[0 as usize]) as u64)
    sayn(widgetboard.height(i))
    say((&m_s11[0 as usize]) as u64)
    say(widgetboard.text_von(i))
    nl()
}

fn module_say() {
    var i: u64 = 0
    while i < widgetboard.ANZ {
        widget_say(i)
        i = i + 1
    }
}

// ====================================== RUNDE WMPLUGIN: DER AUTOSTART
fn is_hotkey_line(zp: u64) -> bool {
    var w: [u8; 7] = "hotkey\0"
    var i: u64 = 0
    while i < 6 {
        if (__mmio_read8((zp + i) as *mut u8)) as u64 != (w[(i) as usize]) as u64 {
            return false
        }
        i = i + 1
    }
    let c: u64 = (__mmio_read8((zp + 6) as *mut u8)) as u64
    return c == 0 || c == 32
}

fn autostart() {
    var path: [u8; 24] = "/etc/wmplug.autostart\0\0\0"
    var p_wm: [u8; 13] = "/bin/wmplug\0\0"
    var a_wm: [u8; 7] = "wmplug\0"
    var a_en: [u8; 7] = "enable\0"
    var p_hk: [u8; 18] = "/etc/hotkeys.conf\0"
    var s_kl: [u8; 34] = "desktop: autostart has no list\0\0\0\0"
    var s_st: [u8; 21] = "desktop: autostart [\0"
    var s_rc: [u8; 8] = "] pid=\0\0"
    var buffer: [u8; 1024] = [0 as u8; 1024]
    var line: [u8; 128] = [0 as u8; 128]
    var cur_word: [u8; 4096] = [0 as u8; 4096]
    var argv: [u64; 8] = [0 as u64; 8]

    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&path[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        lineout.add_text((&s_kl[0 as usize]) as u64)
        lineout.end_line()
        return
    }
    clockapi.sleep_ms(2000)
    let buf: u64 = (&buffer[0 as usize]) as u64
    var len: u64 = 0
    var keep_going: bool = true
    while keep_going && len < 1000 {
        let got: u64 = ulib.sys(ulib.SYS_READ, fd, buf + len, 1000 - len)
        if ulib.bad(got) || got == 0 {
            keep_going = false
        } else {
            len = len + got
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)

    let zp: u64 = (&line[0 as usize]) as u64
    let wp: u64 = (&cur_word[0 as usize]) as u64
    var i: u64 = 0
    while i < len {
        var n: u64 = 0
        var kommentar: bool = false
        while i < len && (__mmio_read8((buf + i) as *mut u8)) as u64 != 10 {
            let c: u64 = (__mmio_read8((buf + i) as *mut u8)) as u64
            if c == 35 {
                kommentar = true
            }
            if !kommentar && n + 1 < 128 && c != 13 && c != 9 {
                __mmio_write8((zp + n) as *mut u8, c as u8)
                n = n + 1
            }
            i = i + 1
        }
        i = i + 1
        __mmio_write8((zp + n) as *mut u8, 0 as u8)
        if n != 0 {
            var argc: u64 = 2
            argv[(0) as usize] = (&a_wm[0 as usize]) as u64
            argv[(1) as usize] = (&a_en[0 as usize]) as u64
            var at: u64 = 0
            var noch: bool = true
            var off: u64 = 0
            while noch && argc < 8 {
                let na: u64 = ulib.word(zp, at, wp + off, 64)
                if na == at {
                    noch = false
                } else {
                    at = na
                    if (__mmio_read8((wp + off) as *mut u8)) as u64 != 0 {
                        argv[(argc) as usize] = wp + off
                        argc = argc + 1
                        off = off + 64
                    }
                }
            }
            // r921: the global hotkey helper starts ONLY when /etc/hotkeys.conf exists (no file = no shortcuts = no process)
            var skip: bool = false
            if is_hotkey_line(zp) {
                let hf: u64 = ulib.sys(ulib.SYS_OPEN, (&p_hk[0 as usize]) as u64, 0, 0)
                if ulib.bad(hf) {
                    skip = true
                } else {
                    ulib.sys(ulib.SYS_CLOSE, hf, 0, 0)
                }
            }
            if argc > 2 && !skip {
                let rc: u64 = ulib.sys(ulib.SYS_EXEC,
                    (&p_wm[0 as usize]) as u64,
                    (&argv[0 as usize]) as u64, argc)
                lineout.add_text((&s_st[0 as usize]) as u64)
                lineout.add_text(zp)
                lineout.add_text((&s_rc[0 as usize]) as u64)
                lineout.add_num(rc)
                lineout.end_line()
                clockapi.sleep_ms(400)
            }
        }
    }
}

// MINT E3: the welcome window. Only when /etc/welcome.conf EXISTS (the installer
// writes it with show=ja; images and sticks without the file start unchanged and
// pay no program load). `/bin/welcome -a` reads the switch itself and exits at
// once when it says show=nein.
fn welcome_start() {
    var p_cf: [u8; 18] = "/etc/welcome.conf\0"
    var p_w: [u8; 13] = "/bin/welcome\0"
    var a_w: [u8; 8] = "welcome\0"
    var a_a: [u8; 3] = "-a\0"
    var argv: [u64; 2] = [0 as u64; 2]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_cf[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    argv[(0) as usize] = (&a_w[0 as usize]) as u64
    argv[(1) as usize] = (&a_a[0 as usize]) as u64
    let _rc: u64 = ulib.sys(ulib.SYS_EXEC, (&p_w[0 as usize]) as u64, (&argv[0 as usize]) as u64, 2)
}

// r1004: THE HOST / SETTINGS CHANGED THE RESOLUTION. The wallpaper window is as big as the screen was; a window never grows past its
// buffer, so a new window with a new shared buffer is made, put at the back, painted, and only then the old one goes. False = nothing
// changed (no shared buffer to remake, or the server refused): the old window stays and the check tries again.
// ------------------------------------------------------------------ context menu (right click on the bare desktop)
// Four rows, rows from the registry (ctxreg.fi, context CTX_DESKTOP): display settings, change background, settings, reload.
static mut k_cd: [u8; 12] = "ctx.display\0"
static mut k_cb: [u8; 20] = "ctx.desk_background\0"
static mut k_cs: [u8; 13] = "ctx.settings\0"
static mut k_cr: [u8; 17] = "ctx.desk_refresh\0"
static mut ctx_regd: u64 = 0
static mut ctx_open: u64 = 0
static mut p_settings: [u8; 14] = "/bin/settings\0"
static mut a_settings: [u8; 9] = "settings\0"
static mut a_page0: [u8; 7] = "page=0\0"
static mut a_page1: [u8; 7] = "page=1\0"
static mut p_wall: [u8; 15] = "/etc/wallpaper\0"
static mut s_ctxo: [u8; 22] = "desktop: context open\0"
static mut s_ctxp: [u8; 23] = "desktop: context pick=\0"
static mut s_ctxx: [u8; 4] = " x=\0"
static mut s_ctxy: [u8; 4] = " y=\0"
static mut s_ctxw: [u8; 4] = " w=\0"
static mut s_ctxh: [u8; 4] = " h=\0"

fn settings_open(page: u64) {
    var argv: [u64; 4] = [0 as u64; 4]
    argv[0 as usize] = (&a_settings[0 as usize]) as u64
    var argc: u64 = 1
    if page == 0 {
        argv[1 as usize] = (&a_page0[0 as usize]) as u64
        argc = 2
    } else if page == 1 {
        argv[1 as usize] = (&a_page1[0 as usize]) as u64
        argc = 2
    }
    let _pid: u64 = ulib.sys(ulib.SYS_EXEC, (&p_settings[0 as usize]) as u64,
        (&argv[0 as usize]) as u64, argc)
}

fn wallpaper_reload() {
    if !image_load((&p_wall[0 as usize]) as u64) {
        uiwallpaper.clear_image()
    }
    all_paint()
    widgets_paint()
}

static mut k_host: [u8; 5] = "dskh\0"

fn host_build() {
}

fn popup_host_start() {
    if !fuiscene.open_plain(0, 0, 64, 32, (&k_host[0 as usize]) as u64, hostwinp.L_MENU, host_build) {
        return
    }
    let _h: u64 = hostwin.win_state(fuiscene.handle(), hostwinp.WS_HIDDEN, 1)
    let _pm: bool = uipopmenu.init()
}

fn ctx_register() {
    if ctx_regd != 0 {
        return
    }
    ctx_regd = 1
    ctxreg.add(ctxreg.CTX_DESKTOP, (&k_cd[0 as usize]) as u64, 0, 0)
    ctxreg.add(ctxreg.CTX_DESKTOP, (&k_cb[0 as usize]) as u64, 1, 0)
    ctxreg.add(ctxreg.CTX_DESKTOP, (&k_cs[0 as usize]) as u64, 2, 0)
    ctxreg.add(ctxreg.CTX_DESKTOP, (&k_cr[0 as usize]) as u64, 3, 0)
}

fn ctx_show() {
    if ctx_open != 0 {
        ctx_step()
    }
    if ctx_open != 0 {
        return
    }
    ctx_register()
    let nrow: u64 = ctxreg.build(ctxreg.CTX_DESKTOP, 0)
    if !uipopmenu.open(hosthead.mouse_x(), hosthead.mouse_y(), ctxreg.text_nul(), nrow) {
        return
    }
    ctx_open = 1
    say((&s_ctxo[0 as usize]) as u64)
    say((&s_ctxx[0 as usize]) as u64)
    sayn(uipopmenu.x())
    say((&s_ctxy[0 as usize]) as u64)
    sayn(uipopmenu.y())
    say((&s_ctxw[0 as usize]) as u64)
    sayn(uipopmenu.w())
    say((&s_ctxh[0 as usize]) as u64)
    sayn(uipopmenu.h())
    nl()
}

fn ctx_step() {
    let r: u64 = uipopmenu.step()
    if r == uipopmenu.NONE {
        return
    }
    ctx_open = 0
    if r == uipopmenu.DISMISSED {
        all_paint()
        return
    }
    let act: u64 = ctxreg.act_at(r)
    if act == ctxreg.NONE {
        return
    }
    say((&s_ctxp[0 as usize]) as u64)
    sayn(r)
    nl()
    if ctxreg.is_ext(act) {
        let _e: u64 = ctxreg.run_ext(act)
    } else if act == 0 {
        settings_open(1)
    } else if act == 1 {
        settings_open(0)
    } else if act == 2 {
        settings_open(99)
    } else {
        wallpaper_reload()
    }
}

fn desk_rebuild() -> bool {
    var s_rb: [u8; 20] = "desktop: rebuilt w=\0"
    var s_rh: [u8; 4] = " h=\0"
    if w_shared == 0 {
        return false
    }
    let nw: u64 = hosthead.screen_w()
    let nh: u64 = hosthead.screen_h()
    let shb: u64 = nw * nh * 4
    let shp: u64 = hostwin.shm_buffer(shb)
    if shp == 0 {
        return false
    }
    let fd1: u64 = hostwin.shm_last_fd() + 1
    let nhnd: u64 = wlibc.sys5(hostwinp.WM_CREATE, 0, (nw << 16) | nh,
        msg.get((&k_title[0 as usize]) as u64), 0, fd1)
    hostwin.shm_close(fd1 - 1)
    if ulib.bad(nhnd) || nhnd == 0 {
        hostwin.shm_unmap(shp, shb)
        return false
    }
    if !hostwin.win_shared(nhnd) || ulib.bad(hostwin.win_state(nhnd, hostwinp.WS_DECO, 0))
        || ulib.bad(hostwin.win_state(nhnd, hostwinp.WS_LAYER, hostwinp.L_DESK)) {
        let _c0: u64 = wlibc.sys3w(hostwinp.WM_CLOSE, nhnd, 0, 0)
        hostwin.shm_unmap(shp, shb)
        return false
    }
    let _c1: u64 = wlibc.sys3w(hostwinp.WM_CLOSE, w_h, 0, 0)
    hostwin.shm_unmap(w_shp, w_shb)
    w_h = nhnd
    w_shp = shp
    w_shb = shb
    sw = nw
    sh = nh
    uiwallpaper.set_screen(sw, sh)
    hosthead.surf_wide(shp, nw, nh)
    all_paint()
    widgetboard.set_screen(sw, sh)
    widgetboard.messen()
    widgets_paint()
    say((&s_rb[0 as usize]) as u64)
    sayn(sw)
    say((&s_rh[0 as usize]) as u64)
    sayn(sh)
    nl()
    return true
}

fn u_start(args: u64) -> u64 {
    dbg_setup(args)
    let _kbd_applied: u64 = kbdconf.apply()
    var s_nb: [u8; 7] = "nobild\0"
    var s_as: [u8; 10] = "autostart\0"
    var s_bad: [u8; 20] = "desktop: no surface\0"
    var s_nol: [u8; 37] = "desktop: no layer 0 -- not the root?\0"
    var s_rd: [u8; 16] = "desktop: ready \0"
    var s_w: [u8; 3] = "w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_l: [u8; 8] = " layer=\0"
    var s_d: [u8; 7] = " deco=\0"
    var s_bi: [u8; 18] = "desktop: image w=\0"
    var s_bh: [u8; 4] = " h=\0"
    var s_bq: [u8; 10] = " source=[\0"
    var s_zu: [u8; 2] = "]\0"
    var s_vl: [u8; 23] = "desktop: gradient top=\0"
    var s_un: [u8; 9] = " bottom=\0"
    var s_pt: [u8; 18] = "desktop: punkt x=\0"
    var s_py: [u8; 4] = " y=\0"
    var s_pc: [u8; 4] = " c=\0"
    var s_wall: [u8; 15] = "/etc/wallpaper\0"
    var s_th: [u8; 11] = "/etc/theme\0"
    var s_ne: [u8; 21] = "desktop: new scheme=\0"
    var s_mod: [u8; 23] = "desktop: module file=\0\0"
    var s_bm: [u8; 26] = "desktop: module bearbeit=\0"

    let _mk: u64 = msg.init()
    var without_image: bool = false
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        if ulib.streq(ulib.arg_at(args, a), (&s_nb[0 as usize]) as u64) {
            without_image = true
        }
        a = a + 1
    }
    // W-IMG2: `desktop autostart` = only the autostart list, no window. glogin starts it while it is still ROOT (before it drops to the
    // person), because `wmplug enable` (WM_PLUG_GRANT) is root-only and the desktop of a signed-in person is not.
    if argc > 1 && ulib.streq(ulib.arg_at(args, 1), (&s_as[0 as usize]) as u64) {
        autostart()
        return 0
    }
    if !hoststart.start(false) {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    // ROUND FUI-TEXT: the type of this program is set by fUi.
    let _ft: bool = fuiglyph.install()
    var schema: u64 = thload.theme_reload()
    let _s0: u64 = schema
    sw = hosthead.screen_w()
    sh = hosthead.screen_h()
    uiwallpaper.set_screen(sw, sh)
    let shb: u64 = sw * sh * 4
    let shp: u64 = hostwin.shm_buffer(shb)
    var shfd1: u64 = 0
    if shp != 0 {
        shfd1 = hostwin.shm_last_fd() + 1
    }
    let h: u64 = wlibc.sys5(hostwinp.WM_CREATE, 0, (sw << 16) | sh,
        msg.get((&k_title[0 as usize]) as u64), 0, shfd1)
    if shfd1 != 0 {
        hostwin.shm_close(shfd1 - 1)
    }
    if ulib.bad(h) || h == 0 {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    w_h = h
    if shp != 0 {
        if hostwin.win_shared(h) {
            hosthead.surf_use(shp, sh)
            w_shared = 1
            w_shp = shp
            w_shb = shb
        } else {
            hostwin.shm_unmap(shp, shb)
        }
    }
    if ulib.bad(hostwin.win_state(h, hostwinp.WS_DECO, 0)) {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    if ulib.bad(hostwin.win_state(h, hostwinp.WS_LAYER, hostwinp.L_DESK)) {
        lineout.add_text((&s_nol[0 as usize]) as u64)
        lineout.end_line()
        let _c: u64 = wlibc.sys3w(hostwinp.WM_CLOSE, h, 0, 0)
        return 1
    }
    popup_host_start()
    uiwallpaper.set_colors(uitheme.theme(uitheme.C_DESKTOP_TOP), uitheme.theme(uitheme.C_DESKTOP_BOTTOM))
    var with_image: bool = false
    if !without_image {
        with_image = image_load((&s_wall[0 as usize]) as u64)
    }
    // r399: what the smooth wallpaper costs -- one full repaint, in ticks of 10 ms (a
    // repaint happens at start and when the theme or the picture changes, never per frame)
    let t_0: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    all_paint()
    let t_1: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    var s_pp: [u8; 27] = "desktop: paint ticks=\0\0\0\0\0\0"
    say((&s_pp[0 as usize]) as u64)
    sayn(t_1 - t_0)
    nl()
    say((&s_rd[0 as usize]) as u64)
    say((&s_w[0 as usize]) as u64)
    sayn(sw)
    say((&s_h[0 as usize]) as u64)
    sayn(sh)
    say((&s_l[0 as usize]) as u64)
    sayn(wlibc.sys3w(hostwinp.WM_INFO, h, hostwinp.WI_LAYER, 0))
    say((&s_d[0 as usize]) as u64)
    sayn(0)
    nl()
    var s_sh: [u8; 17] = "desktop: shared=\0"
    say((&s_sh[0 as usize]) as u64)
    sayn(w_shared)
    nl()
    if with_image {
        say((&s_bi[0 as usize]) as u64)
        sayn(uiwallpaper.image_w())
        say((&s_bh[0 as usize]) as u64)
        sayn(uiwallpaper.image_h())
        say((&s_bq[0 as usize]) as u64)
        say((&s_wall[0 as usize]) as u64)
        say((&s_zu[0 as usize]) as u64)
        nl()
    } else {
        say((&s_vl[0 as usize]) as u64)
        sayn(uiwallpaper.top())
        say((&s_un[0 as usize]) as u64)
        sayn(uiwallpaper.bottom())
        nl()
    }
    // root desktop (no sign-in, tests): run the list here; a signed-in person's desktop cannot grant, glogin ran the list as root before
    if ulib.sys(102, 0, 0, 0) == 0 {
        autostart()
    }
    welcome_start()

    widgetboard.set_screen(sw, sh)
    widgetboard.vorgabe()
    let m_file: bool = widgetboard.load()
    widgetboard.messen()
    let _mw: bool = widgetboard.fetch_values()
    widgetboard.build_texts()
    widgets_paint()
    say((&s_mod[0 as usize]) as u64)
    var m_d: u64 = 0
    if m_file {
        m_d = 1
    }
    sayn(m_d)
    nl()
    module_say()

    var k: u64 = 0
    while k < 5 {
        let px_: u64 = sw * (2 * k + 1) / 10
        let py_: u64 = sh * (2 * k + 1) / 10
        say((&s_pt[0 as usize]) as u64)
        sayn(px_)
        say((&s_py[0 as usize]) as u64)
        sayn(py_)
        say((&s_pc[0 as usize]) as u64)
        sayn(uiwallpaper.color_at(px_, py_))
        nl()
        k = k + 1
    }

    var sum: u64 = thapply.theme_sum()
    var runde: u64 = 0
    var lebt: bool = true
    while lebt {
        var n: u64 = 0
        while n < 32 && wlibc.sys3w(hostwinp.WM_EVENT, w_h,
            (&ev[0 as usize]) as u64, 0) == 1 {
            let typ: u64 = __mmio_read64(((&ev[0 as usize]) as u64)
                as *mut u64)
            let dd: u64 = __mmio_read64((((&ev[0 as usize]) as u64) + 8)
                as *mut u64)
            let e_x: u64 = (dd >> 32) & 0xFFFF
            let e_y: u64 = (dd >> 16) & 0xFFFF
            if typ == wlibc.EV_CLOSE {
                lebt = false
            } else if typ == wlibc.EV_DOWN {
                // ======================================== RUNDE MODULE
                let button: u64 = dd & 0xFFFF
                if (button & 2) != 0 {
                    let tr0: u64 = widgetboard.treffer(e_x, e_y)
                    if tr0 < widgetboard.ANZ {
                        let war0: bool = widgetboard.bearbeiten()
                        widgetboard.set_editing(!war0)
                        if war0 {
                            widget_shown = 99
                            if widgetboard.dirty() {
                                let _s3: bool = widgetboard.save()
                            }
                        } else {
                            widget_shown = tr0
                        }
                        say((&s_bm[0 as usize]) as u64)
                        var b0: u64 = 0
                        if widgetboard.bearbeiten() {
                            b0 = 1
                        }
                        sayn(b0)
                        nl()
                        widgets_paint()
                    } else {
                        ctx_show()
                    }
                } else if widgetboard.bearbeiten() {
                    let tr: u64 = widgetboard.treffer(e_x, e_y)
                    if tr < widgetboard.ANZ {
                        if widgetboard.ziehen_start(tr, e_x, e_y) {
                            widget_shown = tr
                            widget_paint(tr)
                        }
                    }
                }
            } else if typ == wlibc.EV_MOVE {
                if widgetboard.bearbeiten() {
                    if widgetboard.zieht() {
                        let gz: u64 = widgetboard.gezogen()
                        let ox: u64 = widgetboard.x_von(gz)
                        let oy: u64 = widgetboard.y_von(gz)
                        let ow: u64 = widgetboard.width(gz)
                        let oh: u64 = widgetboard.height(gz)
                        if widgetboard.ziehen_zu(e_x, e_y) {
                            fleck(ox, oy, ow, oh)
                            widget_paint(gz)
                        }
                    } else {
                        let tr2: u64 = widgetboard.treffer(e_x, e_y)
                        var nz: u64 = 99
                        if tr2 < widgetboard.ANZ {
                            nz = tr2
                        }
                        if nz != widget_shown {
                            let vorher: u64 = widget_shown
                            widget_shown = nz
                            if vorher < widgetboard.ANZ {
                                widget_paint(vorher)
                            }
                            if nz < widgetboard.ANZ {
                                widget_paint(nz)
                            }
                        }
                    }
                }
            } else if typ == wlibc.EV_UP {
                if widgetboard.zieht() {
                    let fertig: u64 = widgetboard.ziehen_ende()
                    if fertig < widgetboard.ANZ {
                        widget_paint(fertig)
                        widget_say(fertig)
                    }
                    let _sv: bool = widgetboard.save()
                }
            } else if typ == wlibc.EV_KEY {
                let key: u64 = (dd >> 32) & 0xFFFF
                // ======================================== RUNDE MODULE
                // F9 SCHALTET DEN BEARBEITUNGSMODUS.
                if key == widgetboard.key() && key != 0 {
                    let war: bool = widgetboard.bearbeiten()
                    widgetboard.set_editing(!war)
                    if war {
                        widget_shown = 99
                        if widgetboard.dirty() {
                            let _s2: bool = widgetboard.save()
                        }
                    }
                    say((&s_bm[0 as usize]) as u64)
                    var bb: u64 = 0
                    if widgetboard.bearbeiten() {
                        bb = 1
                    }
                    sayn(bb)
                    nl()
                    widgets_paint()
                }
            }
            n = n + 1
        }
        if ctx_open != 0 {
            ctx_step()
        }
        runde = runde + 1
        if (runde % 40) == 0 && !widgetboard.zieht() {
            if widgetboard.fetch_values() {
                widgetboard.build_texts()
                widgets_paint()
            }
        }
        if (runde % 10) == 5 && !widgetboard.zieht() {
            let _sr: bool = hosthead.screen_refresh()
            if hosthead.screen_w() != sw || hosthead.screen_h() != sh {
                let _rb: bool = desk_rebuild()
            }
        }
        if (runde % 10) == 0 {
            if thload.theme_poll() {
                sum = thapply.theme_sum()
                schema = thload.theme_scheme_keys()
                uiwallpaper.set_colors(uitheme.theme(uitheme.C_DESKTOP_TOP), uitheme.theme(uitheme.C_DESKTOP_BOTTOM))
                all_paint()
                widgetboard.messen()
                widgets_paint()
                say((&s_ne[0 as usize]) as u64)
                sayn(schema)
                nl()
            }
        }
        clockapi.sleep_ms(25)
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
