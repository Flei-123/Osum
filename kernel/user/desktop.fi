// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/desktop.fi -- Runde DESKTOP: /bin/desktop.
//
// DAS FENSTER, DAS GANZ HINTEN LIEGT. Es ist so gross wie der
// Bildschirm, es hat keinen Rahmen und keine Titelleiste, und es kommt
// NIE nach vorn -- auch dann nicht, wenn man daraufklickt.
//
// WARUM DAS BIS ZU DIESER RUNDE NICHT GING, und es steht so im Logbuch
// K15: der Fensterserver konnte ein Fenster HEBEN und sonst nichts. Es
// gab keine Moeglichkeit, eines nach hinten zu stellen; ein
// Hintergrundbild waere ein Fenster gewesen, das beim ersten Klick vor
// allen anderen liegt. Die Loesung steht im SERVER (`kernel/wm.fi`,
// L_DESK/L_NORMAL/L_TOP) und nicht hier als Trick -- ein Programm, das
// sich alle 100 Millisekunden selbst nach hinten sortiert, ist keine
// Loesung, sondern ein Flackern.
//
// WAS ER MALT, und in dieser Reihenfolge:
//
//   1. EIN BILD, wenn `/etc/wallpaper` da ist und mit "OSYM" anfaengt
//      -- dasselbe Format wie die Programmsymbole (`tools/k15/icon.py`,
//      zwoelf Oktette Kopf, danach B,G,R,A je Bildpunkt). Es wird auf
//      den Bildschirm GESTRECKT, mit dem naechsten Nachbarn.
//   2. SONST EINEN VERLAUF zwischen zwei Farben des Schemas. Die beiden
//      Farben und die Rechnung stehen unten; `tools/desktop/run.sh`
//      rechnet einzelne Bildpunkte damit nach, statt "sieht dunkel aus"
//      zu messen.
//
// WARUM DAS BILD KLEIN SEIN MUSS. Ein Prozess hat in diesem System
// 832 Kilooktett fuer Halde und Abbildungen (`kernel/sys.fi`), und
// 253 davon liegen schon in der Zeichenflaeche der Widget-Bibliothek.
// 800 x 600 x 4 sind 1 875 Kilooktett und passen nicht -- nicht
// annaehernd. Also ist die Quelle hoechstens BILD_MAX_W x BILD_MAX_H
// gross und wird gestreckt. Das ist eine ehrliche Grenze und keine
// Ausrede: sie steht als Konstante da, und wer sie hebt, hebt sie an
// einer Stelle.

// ================================================ RUNDE 31: profile app
//
// Der Schreibtisch ist eine Wurzeldatei, und seine Bedienelemente
// kommen ab dieser Runde aus fUi (wlib -> fuib -> lib/fui). fUi rechnet
// in `f64` und benutzt `std.rt`; beides ist unter `profile kernel`
// gesperrt (SPEC.md:125). Die Module darunter -- wlib, wlibc, msg --
// bleiben `kernel`; nur die Wurzel wechselt.
profile app

import ulib
import libc.io
// RUNDE 31: `import libc.mem` IST HIER WEG, UND ZWAR NICHT AUS LAUNE.
//
// Firn benennt ein Modul nach dem LETZTEN Teil seines Pfades. `libc.mem`
// heisst also `mem` -- und `paint/canvas.fi`, das fUi zum Malen braucht,
// importiert `html.mem`, das AUCH `mem` heisst. Beide gleichzeitig, und
// der Name ist doppelt belegt:
//
//   error: module 'mem' has no element 'heap_alloc'
//          --> paint/canvas.fi:121
//
// Der einzige Aufruf war `mem.alloc(bytes)` fuer den Bildpuffer des
// Hintergrundbildes. `wlibc.map_surface` tut genau dasselbe -- ein
// anonymes `mmap` -- und wlibc ist hier ohnehin importiert. Also ein
// Aufruf weniger statt eines Modulkonflikts.
import wlibc
import wlib
import msg

export { u_start }

// RUNDE I18N: DER EINZIGE ANZEIGETEXT DIESES PROGRAMMS.
//
// Er stand hier bis heute als "Schreibtisch" im Quelltext. Jetzt steht
// hier nur noch sein SCHLUESSEL -- englisch, wie jeder Name in diesem
// System --, und der Text kommt aus /usr/share/locale/<code>/messages.
static mut k_title: [u8; 14] = "desktop.title\0"


// Die Grenze der Quelle. 240 x 180 x 4 = 172 800 Oktette.
const IMAGE_MAX_W: u64 = 240
const IMAGE_MAX_H: u64 = 180

static mut w_h: u64 = 0 // das Handle des Fensters
static mut sw: u64 = 0
static mut sh: u64 = 0
static mut image: u64 = 0 // die Bildpunkte, oder 0
static mut bw: u64 = 0
static mut bh: u64 = 0
static mut c_oben: u64 = 0
static mut c_unten: u64 = 0
static mut kopf: [u8; 16] = [0 as u8; 16]
static mut ev: [u8; 16] = [0 as u8; 16]

// ============================================ RUNDE BELEG: DER MESSAUSGANG
// STEHT IM NORMALBETRIEB AUS.
//
// Justins Befund am Abbild vom 12.09.2026: im Terminalfenster standen
// Zeilen wie `explorer: krumm n=2 fold=0` und `bg=...`. Gezaehlt hat er
// auch: 160 `ulib.say` in taskbar.fi, 38 in explorer.fi.
//
// Die Regel dazu steht seit Runde LAUFZEIT in taskmgr.fi:
//
//   EIN MESSAUSGANG GEHOERT HINTER EINEN SCHALTER, UND DER SCHALTER
//   STEHT IM NORMALBETRIEB AUS. Ein Programm, das im Auslieferungs-
//   zustand misst, misst vor allem sich selbst.
//
// NICHT GELOESCHT, SONDERN GESCHALTET. Die Zaehler (`fui=`, `fuix=`,
// `rect id=`, `text ... base=`) waren mehrfach der Schluessel zur
// Fehlersuche -- sie muessen fuer die Abnahme da sein. Also EIN Schalter
// statt zweihundert geloeschter Zeilen.
//
// ZWEI WEGE, IHN EINZUSCHALTEN, und beide gab es schon:
//   /etc/uitrace   die Datei, mit der `wlib` seit Runde LOOK dasselbe
//                  tut -- die Pruefstaende legen sie ohnehin an
//   `debug`        als Wort auf der Programmzeile, fuer den Fall, dass
//                  einer allein gestartet wird
//
// OHNE BEIDES AENDERT SICH KEIN OKTETT gegenueber vorher -- das ist die
// Bedingung dafuer, dass kein bestehender Testlaeufer davon etwas merkt.
static mut s_dbg: u64 = 0

// Die drei Ausgaenge dieses Programms, an EINER Stelle geschaltet.
// `sayn` und `nl` stehen hier, damit kein Aufrufer `ulib.` direkt
// nimmt und damit am Schalter vorbeigeht.
fn dbg_on() -> bool {
    return s_dbg != 0
}

fn dbg_setup(args: u64) {
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_dbg = 1
    }
    var a_dbg: [u8; 6] = "debug\0"
    let argc: u64 = ulib.arg_count(args)
    var ai: u64 = 1
    while ai < argc {
        if ulib.streq(ulib.arg_at(args, ai), (&a_dbg[0 as usize]) as u64) {
            s_dbg = 1
        }
        ai = ai + 1
    }
}

fn say(p: u64) {
    if s_dbg == 0 {
        return
    }
    ulib.say(p)
}

fn sayn(v: u64) {
    if s_dbg == 0 {
        return
    }
    ulib.sayn(v)
}

fn nl() {
    if s_dbg == 0 {
        return
    }
    ulib.nl()
}

fn u32_at(p: u64) -> u64 {
    return (__mmio_read8((p) as *mut u8) as u64)
        | ((__mmio_read8((p + 1) as *mut u8) as u64) << 8)
        | ((__mmio_read8((p + 2) as *mut u8) as u64) << 16)
        | ((__mmio_read8((p + 3) as *mut u8) as u64) << 24)
}

// DIE FARBE AN EINER STELLE -- und sie ist EINE Funktion, weil der
// Laeufer draussen genau diese Rechnung nachrechnet. Waere sie an zwei
// Stellen im Quelltext (einmal beim Malen, einmal beim Melden), waere
// die Messung eine Tautologie.
fn color_at(x: u64, y: u64) -> u64 {
    if image != 0 && bw != 0 && bh != 0 {
        var qx: u64 = 0
        var qy: u64 = 0
        if sw > 1 {
            qx = x * bw / sw
        }
        if sh > 1 {
            qy = y * bh / sh
        }
        if qx >= bw {
            qx = bw - 1
        }
        if qy >= bh {
            qy = bh - 1
        }
        let at: u64 = image + (qy * bw + qx) * 4
        let b: u64 = __mmio_read8((at) as *mut u8) as u64
        let g: u64 = __mmio_read8((at + 1) as *mut u8) as u64
        let r: u64 = __mmio_read8((at + 2) as *mut u8) as u64
        return (r << 16) | (g << 8) | b
    }
    // Der Verlauf: linear von oben nach unten, je Kanal, mit
    // Abrundung -- dieselbe ganzzahlige Division wie im Laeufer.
    if sh < 2 {
        return c_oben
    }
    let t: u64 = y * 255 / (sh - 1)
    let r: u64 = (((c_oben >> 16) & 255) * (255 - t)
        + ((c_unten >> 16) & 255) * t) / 255
    let g: u64 = (((c_oben >> 8) & 255) * (255 - t)
        + ((c_unten >> 8) & 255) * t) / 255
    let b: u64 = ((c_oben & 255) * (255 - t) + (c_unten & 255) * t) / 255
    return (r << 16) | (g << 8) | b
}

// Das Bild laden. Gibt true, wenn wirklich Bildpunkte da sind.
fn image_load(pfad: u64) -> bool {
    let fd: u64 = io.open(pfad, 0)
    if ulib.bad(fd) {
        return false
    }
    let k: u64 = (&kopf[0 as usize]) as u64
    let n: u64 = io.read_full(fd, k, 12)
    if ulib.bad(n) || n < 12 {
        io.close(fd)
        return false
    }
    if kopf[(0) as usize] != 79 as u8 || kopf[(1) as usize] != 83 as u8 {
        io.close(fd)
        return false
    }
    if kopf[(2) as usize] != 89 as u8 || kopf[(3) as usize] != 77 as u8 {
        io.close(fd)
        return false
    }
    let iw: u64 = u32_at(k + 4)
    let ih: u64 = u32_at(k + 8)
    if iw == 0 || ih == 0 || iw > IMAGE_MAX_W || ih > IMAGE_MAX_H {
        io.close(fd)
        return false
    }
    let bytes: u64 = iw * ih * 4
    let p: u64 = wlibc.map_surface(bytes)
    if p == 0 {
        io.close(fd)
        return false
    }
    let g: u64 = io.read_full(fd, p, bytes)
    io.close(fd)
    if ulib.bad(g) || g < bytes {
        return false
    }
    image = p
    bw = iw
    bh = ih
    return true
}

// EINEN STREIFEN MALEN UND HINUEBERSCHIEBEN. Genau der Weg, den die
// Widget-Bibliothek geht (`kernel/user/wlibc.fi`): die Flaeche ist 800
// mal 81 Bildpunkte gross, ein Fenster von 800 mal 600 passt nicht in
// den Speicher eines Prozesses, also wird es in Streifen gemalt.
fn streifen(y0: u64, hoehe: u64) {
    wlibc.set_band(y0)
    wlibc.clip_set(0, y0, sw, y0 + hoehe)
    var y: u64 = y0
    while y < y0 + hoehe {
        var x: u64 = 0
        while x < sw {
            wlib.draw_point(x, y, color_at(x, y))
            x = x + 1
        }
        y = y + 1
    }
    let _n: u64 = wlibc.push(w_h, 0, y0, sw, hoehe)
}

fn all_paint() {
    var y: u64 = 0
    while y < sh {
        var hoehe: u64 = wlibc.surf_rows()
        if y + hoehe > sh {
            hoehe = sh - y
        }
        streifen(y, hoehe)
        y = y + hoehe
    }
}

fn u_start(args: u64) -> u64 {
    dbg_setup(args)
    var s_nb: [u8; 7] = "nobild\0"
    var s_bad: [u8; 23] = "desktop: keine Flaeche\0"
    var s_nol: [u8; 44] = "desktop: keine Ebene 0 -- nicht die Wurzel?\0"
    var s_rd: [u8; 16] = "desktop: ready \0"
    var s_w: [u8; 3] = "w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_l: [u8; 8] = " layer=\0"
    var s_d: [u8; 7] = " deco=\0"
    var s_bi: [u8; 17] = "desktop: bild w=\0"
    var s_bh: [u8; 4] = " h=\0"
    var s_bq: [u8; 10] = " quelle=[\0"
    var s_zu: [u8; 2] = "]\0"
    var s_vl: [u8; 23] = "desktop: verlauf oben=\0"
    var s_un: [u8; 8] = " unten=\0"
    var s_pt: [u8; 18] = "desktop: punkt x=\0"
    var s_py: [u8; 4] = " y=\0"
    var s_pc: [u8; 4] = " c=\0"
    var s_wall: [u8; 15] = "/etc/wallpaper\0"
    var s_th: [u8; 11] = "/etc/theme\0"
    var s_ne: [u8; 21] = "desktop: neu schema=\0"

    let _mk: u64 = msg.init()
    var ohne_bild: bool = false
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        if ulib.streq(ulib.arg_at(args, a), (&s_nb[0 as usize]) as u64) {
            ohne_bild = true
        }
        a = a + 1
    }
    if !wlibc.start(false) {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    var schema: u64 = wlibc.theme_reload()
    let _s0: u64 = schema
    sw = wlibc.screen_w()
    sh = wlibc.screen_h()
    // DAS FENSTER IST DER GANZE BILDSCHIRM. Ohne Schmuck heisst: das
    // aeussere Rechteck IST die Malflaeche, es geht kein Rahmen ab.
    let h: u64 = wlibc.sys5(wlibc.WM_CREATE, 0, (sw << 16) | sh,
        msg.get((&k_title[0 as usize]) as u64), 0, 0)
    if ulib.bad(h) || h == 0 {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    w_h = h
    if ulib.bad(wlibc.win_state(h, wlibc.WS_DECO, 0)) {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    // UND JETZT NACH GANZ HINTEN. Schlaegt das fehl, hoert dieses
    // Programm auf -- ein Schreibtisch, der vor den Fenstern liegt,
    // ist schlimmer als keiner.
    if ulib.bad(wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_DESK)) {
        say((&s_nol[0 as usize]) as u64)
        nl()
        let _c: u64 = wlibc.sys3w(wlibc.WM_CLOSE, h, 0, 0)
        return 1
    }
    // RUNDE THEME: der Verlauf hat jetzt EIGENE Marken. Vorher lieh
    // sich der Schreibtisch die Farbe der Werkzeugleiste und die des
    // Fensterhintergrunds -- und aenderte sich mit, sobald eine von
    // beiden sich aus einem anderen Grund aenderte.
    c_oben = wlibc.theme(wlibc.C_DESKTOP_TOP)
    c_unten = wlibc.theme(wlibc.C_DESKTOP_BOTTOM)
    var mit_bild: bool = false
    if !ohne_bild {
        mit_bild = image_load((&s_wall[0 as usize]) as u64)
    }
    all_paint()

    say((&s_rd[0 as usize]) as u64)
    say((&s_w[0 as usize]) as u64)
    sayn(sw)
    say((&s_h[0 as usize]) as u64)
    sayn(sh)
    say((&s_l[0 as usize]) as u64)
    sayn(wlibc.sys3w(wlibc.WM_INFO, h, wlibc.WI_LAYER, 0))
    say((&s_d[0 as usize]) as u64)
    sayn(0)
    nl()
    if mit_bild {
        say((&s_bi[0 as usize]) as u64)
        sayn(bw)
        say((&s_bh[0 as usize]) as u64)
        sayn(bh)
        say((&s_bq[0 as usize]) as u64)
        say((&s_wall[0 as usize]) as u64)
        say((&s_zu[0 as usize]) as u64)
        nl()
    } else {
        say((&s_vl[0 as usize]) as u64)
        sayn(c_oben)
        say((&s_un[0 as usize]) as u64)
        sayn(c_unten)
        nl()
    }
    // FUENF STUETZSTELLEN, und der Laeufer haelt sie gegen das Bild.
    // Sie stehen bewusst NICHT alle in einer Zeile: eine Stuetzstelle,
    // die zufaellig stimmt, faellt neben vier anderen auf.
    var k: u64 = 0
    while k < 5 {
        let px_: u64 = sw * (2 * k + 1) / 10
        let py_: u64 = sh * (2 * k + 1) / 10
        say((&s_pt[0 as usize]) as u64)
        sayn(px_)
        say((&s_py[0 as usize]) as u64)
        sayn(py_)
        say((&s_pc[0 as usize]) as u64)
        sayn(color_at(px_, py_))
        nl()
        k = k + 1
    }

    // DIE SCHLEIFE. Sie holt Ereignisse ab (sonst laeuft der Ring des
    // Servers ueber) und sieht ab und zu nach, ob sich das Farbschema
    // geaendert hat -- die Einstellungen schreiben `/etc/theme`, und
    // ein Schreibtisch, der dafuer einen Neustart braucht, ist keiner.
    var sum: u64 = wlibc.theme_sum()
    var runde: u64 = 0
    var lebt: bool = true
    while lebt {
        var n: u64 = 0
        while n < 32 && wlibc.sys3w(wlibc.WM_EVENT, h,
            (&ev[0 as usize]) as u64, 0) == 1 {
            let typ: u64 = __mmio_read64(((&ev[0 as usize]) as u64)
                as *mut u64)
            let dd: u64 = __mmio_read64((((&ev[0 as usize]) as u64) + 8)
                as *mut u64)
            if typ == wlibc.EV_CLOSE {
                lebt = false
            } else if typ == wlibc.EV_KEY {
                // ========================== RUNDE ECHTHARDWARE-3
                // AUCH HIER FIELEN TASTEN AUF DEN BODEN.
                //
                // Dieselbe Stelle wie in `taskbar.fi`: die Schleife
                // holt jedes Ereignis ab (und nimmt es damit aus dem
                // Ring des Servers) und sah nur nach `EV_CLOSE`. Der
                // Schreibtisch bekommt den Fokus zwar nicht von
                // selbst (wm.fi: nur L_NORMAL oder F_KEYS), aber
                // `wm.on_key` schickt bei `nofocus` an JEDES Fenster
                // -- und dann war die Taste hier zu Ende.
                wlib.feed_key((dd >> 32) & 0xFFFF)
            }
            n = n + 1
        }
        runde = runde + 1
        if (runde % 10) == 0 {
            if wlibc.theme_poll() {
                sum = wlibc.theme_sum()
                schema = wlibc.theme_scheme_keys()
                c_oben = wlibc.theme(wlibc.C_DESKTOP_TOP)
                c_unten = wlibc.theme(wlibc.C_DESKTOP_BOTTOM)
                all_paint()
                say((&s_ne[0 as usize]) as u64)
                sayn(schema)
                nl()
            }
        }
        ulib.sleep_ms(25)
    }
    return 0
}

// RUNDE 31: das `main`, das nie laeuft -- `user.ld` springt nach
// `u_start`. Das Profil `app` verlangt es trotzdem. Es ruft `u_start`,
// damit es nicht luegt.
fn main() -> i32 {
    return u_start(0) as i32
}
