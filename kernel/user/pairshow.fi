profile kernel

import ulib
import libc.io
import libc.errno

export { load, code, seconds_left, show_big, MODE_NONE, MODE_WAITING, MODE_CONFIRM, MODE_OK }

const MODE_NONE: u64 = 0
const MODE_WAITING: u64 = 1
const MODE_CONFIRM: u64 = 2
const MODE_OK: u64 = 3

static mut STATE_PATH: [u8; 18] = "/var/jarvis/state\0"
static mut GLYPHS: [u8; 151] = "111101101101111010110010010111111001111100111111001111001111101101111001001111100111001111111100111101111111001001001001111101111101111111101111001111\0"
static mut RAW: [u8; 128] = [0 as u8; 128]
static mut CODE: [u8; 24] = [0 as u8; 24]
static mut LEFT: u64 = 0

fn starts(at: u64, w: u64) -> bool {
    var i: u64 = 0
    while *((w + i) as *mut u8) != 0 as u8 {
        if *((at + i) as *mut u8) != *((w + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

fn raw_at(i: u64) -> u8 {
    return RAW[i as usize]
}

fn load() -> u64 {
    CODE[0 as usize] = 0 as u8
    LEFT = 0
    let fd: u64 = io.open((&STATE_PATH[0 as usize]) as u64, 0)
    if errno.failed(fd) {
        return MODE_NONE
    }
    let n: u64 = io.read(fd, (&RAW[0 as usize]) as u64, 120)
    io.close(fd)
    if errno.failed(n) || n == 0 {
        return MODE_NONE
    }
    RAW[n as usize] = 0 as u8
    var w_wait: [u8; 18] = "pairing: waiting \0"
    var w_conf: [u8; 18] = "pairing: confirm \0"
    var w_ok: [u8; 12] = "pairing: ok\0"
    let base: u64 = (&RAW[0 as usize]) as u64
    var mode: u64 = MODE_NONE
    if starts(base, (&w_wait[0 as usize]) as u64) {
        mode = MODE_WAITING
    } else if starts(base, (&w_conf[0 as usize]) as u64) {
        mode = MODE_CONFIRM
    } else if starts(base, (&w_ok[0 as usize]) as u64) {
        return MODE_OK
    } else {
        return MODE_NONE
    }
    var i: u64 = 17
    var k: u64 = 0
    while i < n && raw_at(i) > 32 as u8 && k < 20 {
        CODE[k as usize] = raw_at(i)
        k = k + 1
        i = i + 1
    }
    CODE[k as usize] = 0 as u8
    if k == 0 {
        return MODE_NONE
    }
    if i < n && raw_at(i) == 32 as u8 {
        i = i + 1
        var v: u64 = 0
        while i < n && raw_at(i) >= 48 as u8 && raw_at(i) <= 57 as u8 {
            v = v * 10 + (raw_at(i) as u64 - 48)
            i = i + 1
        }
        LEFT = v
    }
    return mode
}

fn code() -> u64 {
    return (&CODE[0 as usize]) as u64
}

fn seconds_left() -> u64 {
    return LEFT
}

fn show_big() {
    var row: u64 = 0
    while row < 5 {
        var i: u64 = 0
        var pad: [u8; 3] = "  \0"
        var blk: [u8; 3] = "##\0"
        ulib.say((&pad[0 as usize]) as u64)
        while CODE[i as usize] != 0 as u8 {
            let d: u64 = CODE[i as usize] as u64
            if d >= 48 && d <= 57 {
                var c: u64 = 0
                while c < 3 {
                    if GLYPHS[((d - 48) * 15 + row * 3 + c) as usize] == 49 as u8 {
                        ulib.say((&blk[0 as usize]) as u64)
                    } else {
                        ulib.say((&pad[0 as usize]) as u64)
                    }
                    c = c + 1
                }
                ulib.say((&pad[0 as usize]) as u64)
            }
            i = i + 1
        }
        ulib.nl()
        row = row + 1
    }
}
