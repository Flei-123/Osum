export { u_start }

// ----------------------------------------------------------- die Texte
static mut W_TITLE: [u8; 7] = "Editor\0"
static mut W_APP: [u8; 6] = "nedit\0"
static mut M_BAR: [u8; 15] = "nedit.menu.bar\0"
static mut M_FILE: [u8; 16] = "nedit.menu.file\0"
static mut M_BEARB: [u8; 16] = "nedit.menu.edit\0"
static mut M_FIND: [u8; 18] = "nedit.menu.search\0"

static mut T_NEW: [u8; 15] = "nedit.untitled\0"
static mut T_OPEN: [u8; 15] = "nedit.ask.open\0"
static mut T_SAVE: [u8; 15] = "nedit.ask.save\0"
static mut T_FIND: [u8; 15] = "nedit.ask.find\0"
static mut T_REPLACE: [u8; 22] = "Ersetzen durch was?\0\0\0"
static mut T_GOTO: [u8; 18] = "Gehe zu Zeile:\0\0\0\0"
static mut T_ASK: [u8; 18] = "nedit.ask.discard\0"
static mut T_DROP: [u8; 15] = "nedit.err.read\0"
static mut T_WRITE: [u8; 16] = "nedit.err.write\0"
static mut T_NICHTDA: [u8; 15] = "nedit.notfound\0"

static mut s_stat: [u8; 160] = [0 as u8; 160]
static mut s_title: [u8; 96] = [0 as u8; 96]

const MAXTAB: u64 = 8
const TB_PATH: u64 = 0
const TB_PUF: u64 = 1
const TB_N: u64 = 2 // wie viele Oktette
const TB_CAP: u64 = 3
const TB_DIRTY: u64 = 4 // veraendert
const TB_LANG: u64 = 5 // welche Sprache
const TB_CY: u64 = 6
const TB_CX: u64 = 7
const TB_EOL: u64 = 8
const TB_W: u64 = 9

static mut tb: [u64; 72] = [0 as u64; 72] // MAXTAB * TB_W
static mut ntab: u64 = 0
static mut cur: u64 = 0

static mut tabtext: [u8; 640] = [0 as u8; 640]
static mut pfade: [u8; 1024] = [0 as u8; 1024]

const IOMAX: u64 = 1048576
static mut iobuf: u64 = 0

// Was die Dialoge eintippen lassen.
static mut dlgbuf: [u8; 256] = [0 as u8; 256]
static mut suchtext: [u8; 128] = [0 as u8; 128]
static mut ersetztext: [u8; 128] = [0 as u8; 128]
static mut Z_SUCH: [u8; 6] = "summe\0"
static mut Z_ERS: [u8; 7] = "TOTAL\0\0"
static mut Z_GESICHERT: [u8; 17] = "nedit: gesichert\0"
static mut Z_NICHT: [u8; 21] = "nedit: NICHT geschr.\0"

static mut w_main: u64 = 0
static mut w_bar: u64 = 0
static mut w_tabs: u64 = 0
static mut w_text: u64 = 0
static mut w_stat: u64 = 0
static mut w_path: u64 = 0
static mut bw: u64 = 980
static mut bh: u64 = 700
static mut c_top: u64 = 0
static mut c_text: u64 = 0
static mut c_bottom: u64 = 0
static mut dlgart: u64 = 0

fn tget(t: u64, f: u64) -> u64 {
    if t >= MAXTAB {
        return 0
    }
    return tb[(t * TB_W + f) as usize]
}

fn tset(t: u64, f: u64, v: u64) {
    if t >= MAXTAB {
        return
    }
    tb[(t * TB_W + f) as usize] = v
}

fn path_of(t: u64) -> u64 {
    return ((&pfade[0 as usize]) as u64) + t * 128
}

// ======================================================= DIE DATEIEN
fn file_read(path: u64) -> u64 {
    var st: [u8; 144] = [0 as u8; 144]
    if ulib.bad(io.stat_into(path, (&st[0 as usize]) as u64)) {
        return 0xFFFFFFFFFFFFFFFF
    }
    let gr: u64 = io.stat_size((&st[0 as usize]) as u64)
    if gr >= IOMAX {
        return 0xFFFFFFFFFFFFFFFF
    }
    let fd: u64 = io.open(path, 0)
    if ulib.bad(fd) {
        return 0xFFFFFFFFFFFFFFFF
    }
    let n: u64 = io.read_full(fd, iobuf, gr)
    let _c: u64 = io.close(fd)
    if ulib.bad(n) {
        return 0xFFFFFFFFFFFFFFFF
    }
    return n
}

fn file_write(path: u64, n: u64) -> bool {
    let fd: u64 = io.create(path)
    if ulib.bad(fd) {
        return false
    }
    let g: u64 = io.write_all(fd, iobuf, n)
    let _c: u64 = io.close(fd)
    return !ulib.bad(g) && g == n
}

fn lang_von(path: u64) -> u64 {
    if path == 0 {
        return fuied.LANG_NONE
    }
    let n: u64 = ulib.length(path)
    if n < 3 {
        return fuied.LANG_NONE
    }
    let a: u64 = __mmio_read8((path + n - 3) as *mut u8) as u64
    let b: u64 = __mmio_read8((path + n - 2) as *mut u8) as u64
    let c: u64 = __mmio_read8((path + n - 1) as *mut u8) as u64
    if a == 46 && (b | 32) == 102 && (c | 32) == 105 {
        return fuied.LANG_FIRN // .fi
    }
    if a == 46 && (b | 32) == 115 && (c | 32) == 104 {
        return fuied.LANG_SH // .sh
    }
    return fuied.LANG_NONE
}

// ======================================================== DIE REITER
fn tabs_set() {
    let p: u64 = (&tabtext[0 as usize]) as u64
    var at: u64 = 0
    var t: u64 = 0
    while t < ntab && at < 600 {
        if tget(t, TB_DIRTY) != 0 {
            __mmio_write8((p + at) as *mut u8, 42 as u8) // '*'
            at = at + 1
        }
        let nam: u64 = name_von(t)
        var i: u64 = 0
        while __mmio_read8((nam + i) as *mut u8) as u64 != 0 && at < 600 {
            __mmio_write8((p + at) as *mut u8,
                __mmio_read8((nam + i) as *mut u8))
            at = at + 1
            i = i + 1
        }
        if t + 1 < ntab && at < 600 {
            __mmio_write8((p + at) as *mut u8, 10 as u8)
            at = at + 1
        }
        t = t + 1
    }
    __mmio_write8((p + at) as *mut u8, 0 as u8)
    rfr()
}

fn name_von(t: u64) -> u64 {
    let p: u64 = tget(t, TB_PATH)
    if p == 0 {
        return msg.get((&T_NEW[0 as usize]) as u64)
    }
    return ulib.base_name(p)
}

fn tab_show(fresh: u64) {
    if fresh >= ntab {
        return
    }
    if fresh != cur {
        tab_save_to_buffer(cur)
    }
    cur = fresh
    let puf: u64 = tget(cur, TB_PUF)
    if puf != 0 {
        fuied.ta_text_set(w_text, puf, tget(cur, TB_N))
    } else {
        fuied.ta_leeren(w_text)
    }
    fuied.ta_lang(w_text, tget(cur, TB_LANG))
    fuied.ta_eol_set(w_text, tget(cur, TB_EOL))
    if tget(cur, TB_DIRTY) != 0 {
        fuied.ta_gehe(w_text, tget(cur, TB_CY), tget(cur, TB_CX))
    } else {
        fuied.ta_gehe(w_text, tget(cur, TB_CY), tget(cur, TB_CX))
    }
    tabs_set()
    status_set()
    title_set()
}

fn tab_save_to_buffer(t: u64) {
    if t >= ntab {
        return
    }
    let n: u64 = fuied.ta_text_get(w_text, iobuf, IOMAX - 1)
    if tget(t, TB_CAP) < n + 1 {
        var cap: u64 = (n + 4096) & 0xFFFFFFFFFFFFF000
        let p: u64 = wlibc.map_surface(cap)
        if ulib.bad(p) || p == 0 {
            return
        }
        tset(t, TB_PUF, p)
        tset(t, TB_CAP, cap)
    }
    let dst: u64 = tget(t, TB_PUF)
    var i: u64 = 0
    while i < n {
        __mmio_write8((dst + i) as *mut u8, __mmio_read8((iobuf + i) as *mut u8))
        i = i + 1
    }
    tset(t, TB_N, n)
    tset(t, TB_CY, fuied.ta_zeile(w_text) - 1)
    tset(t, TB_CX, 0)
    if fuied.ta_geaendert(w_text) {
        tset(t, TB_DIRTY, 1)
    }
}

fn tab_new(path: u64) -> u64 {
    if ntab >= MAXTAB {
        return 0xFFFFFFFFFFFFFFFF
    }
    let t: u64 = ntab
    ntab = ntab + 1
    tset(t, TB_PUF, 0)
    tset(t, TB_N, 0)
    tset(t, TB_CAP, 0)
    tset(t, TB_DIRTY, 0)
    tset(t, TB_CY, 0)
    tset(t, TB_CX, 0)
    tset(t, TB_EOL, 0)
    if path == 0 {
        tset(t, TB_PATH, 0)
        tset(t, TB_LANG, fuied.LANG_NONE)
    } else {
        ulib.strncpy(path_of(t), path, 127)
        tset(t, TB_PATH, path_of(t))
        tset(t, TB_LANG, lang_von(path_of(t)))
    }
    return t
}

fn open_file(path: u64) -> bool {
    let n: u64 = file_read(path)
    if n == 0xFFFFFFFFFFFFFFFF {
        let _h: u64 = dlg_hinweis((&W_TITLE[0 as usize]) as u64,
            msg.get((&T_DROP[0 as usize]) as u64))
        return false
    }
    var t: u64 = 0xFFFFFFFFFFFFFFFF
    if ntab == 1 && tget(0, TB_PATH) == 0 && tget(0, TB_DIRTY) == 0
        && tget(0, TB_N) == 0 {
        t = 0
        ulib.strncpy(path_of(0), path, 127)
        tset(0, TB_PATH, path_of(0))
        tset(0, TB_LANG, lang_von(path_of(0)))
    } else {
        t = tab_new(path)
        if t == 0xFFFFFFFFFFFFFFFF {
            return false
        }
    }
    if tget(t, TB_CAP) < n + 1 {
        let cap: u64 = (n + 4096) & 0xFFFFFFFFFFFFF000
        let p: u64 = wlibc.map_surface(cap)
        if ulib.bad(p) || p == 0 {
            return false
        }
        tset(t, TB_PUF, p)
        tset(t, TB_CAP, cap)
    }
    let dst: u64 = tget(t, TB_PUF)
    var i: u64 = 0
    while i < n {
        __mmio_write8((dst + i) as *mut u8, __mmio_read8((iobuf + i) as *mut u8))
        i = i + 1
    }
    tset(t, TB_N, n)
    tset(t, TB_DIRTY, 0)
    tset(t, TB_CY, 0)
    tset(t, TB_CX, 0)
    cur = t
    tab_show(t)
    return true
}

fn save(t: u64) -> bool {
    if t >= ntab {
        return false
    }
    if tget(t, TB_PATH) == 0 {
        dlgart = 2
        __mmio_write8(((&dlgbuf[0 as usize]) as u64) as *mut u8, 0 as u8)
        let _d: u64 = dlg_entry((&W_TITLE[0 as usize]) as u64,
            msg.get((&T_SAVE[0 as usize]) as u64), (&dlgbuf[0 as usize]) as u64)
        return false
    }
    let n: u64 = fuied.ta_text_get(w_text, iobuf, IOMAX - 1)
    if !file_write(tget(t, TB_PATH), n) {
        let _h: u64 = dlg_hinweis((&W_TITLE[0 as usize]) as u64,
            msg.get((&T_WRITE[0 as usize]) as u64))
        return false
    }
    tset(t, TB_DIRTY, 0)
    fuied.ta_sauber(w_text)
    tabs_set()
    title_set()
    return true
}

// ===================================================== DIE STATUSZEILE
static mut ST_Z: [u8; 8] = "Zeile \0\0"
static mut ST_S: [u8; 10] = ", Spalte \0"
static mut ST_UTF: [u8; 12] = "   UTF-8   \0"
static mut ST_LF: [u8; 3] = "LF\0"
static mut ST_CRLF: [u8; 5] = "CRLF\0"
static mut ST_MOD: [u8; 15] = "nedit.modified\0"
static mut ST_LINES: [u8; 11] = "   Zeilen \0"

fn number_at(p: u64, at: u64, v: u64) -> u64 {
    var ziffern: [u8; 20] = [0 as u8; 20]
    var n: u64 = 0
    var q: u64 = v
    if q == 0 {
        __mmio_write8((p + at) as *mut u8, 48 as u8)
        return at + 1
    }
    while q > 0 && n < 20 {
        ziffern[(n) as usize] = (48 + q % 10) as u8
        q = q / 10
        n = n + 1
    }
    var k: u64 = 0
    while k < n {
        __mmio_write8((p + at + k) as *mut u8, ziffern[(n - 1 - k) as usize])
        k = k + 1
    }
    return at + n
}

fn text_an(p: u64, at: u64, q: u64) -> u64 {
    var i: u64 = 0
    var a: u64 = at
    while __mmio_read8((q + i) as *mut u8) as u64 != 0 && a < 150 {
        __mmio_write8((p + a) as *mut u8, __mmio_read8((q + i) as *mut u8))
        a = a + 1
        i = i + 1
    }
    return a
}

fn status_set() {
    let p: u64 = (&s_stat[0 as usize]) as u64
    var at: u64 = 0
    at = text_an(p, at, (&ST_Z[0 as usize]) as u64)
    at = number_at(p, at, fuied.ta_zeile(w_text))
    at = text_an(p, at, (&ST_S[0 as usize]) as u64)
    at = number_at(p, at, fuied.ta_spalte(w_text))
    at = text_an(p, at, (&ST_LINES[0 as usize]) as u64)
    at = number_at(p, at, fuied.ta_zeilen(w_text))
    at = text_an(p, at, (&ST_UTF[0 as usize]) as u64)
    if fuied.ta_eol(w_text) == 1 {
        at = text_an(p, at, (&ST_CRLF[0 as usize]) as u64)
    } else {
        at = text_an(p, at, (&ST_LF[0 as usize]) as u64)
    }
    if fuied.ta_geaendert(w_text) {
        at = text_an(p, at, msg.get((&ST_MOD[0 as usize]) as u64))
    }
    __mmio_write8((p + at) as *mut u8, 0 as u8)
    rfr()
}

fn title_set() {
    let p: u64 = (&s_title[0 as usize]) as u64
    var at: u64 = 0
    if cur < ntab && tget(cur, TB_PATH) != 0 {
        at = text_an(p, at, tget(cur, TB_PATH))
    } else {
        at = text_an(p, at, msg.get((&T_NEW[0 as usize]) as u64))
    }
    __mmio_write8((p + at) as *mut u8, 0 as u8)
    rfr()
}

fn find_from(vony: u64, vonx: u64) -> bool {
    let nadel: u64 = (&suchtext[0 as usize]) as u64
    let m: u64 = ulib.length(nadel)
    if m == 0 {
        return false
    }
    let lines: u64 = fuied.ta_zeilen(w_text)
    var y: u64 = vony
    var x: u64 = vonx
    while y < lines {
        let p: u64 = fuied.ta_zeile_p(w_text, y)
        let n: u64 = fuied.ta_zeile_n(w_text, y)
        if p != 0 && n >= m {
            var i: u64 = x
            while i + m <= n {
                var k: u64 = 0
                while k < m && __mmio_read8((p + i + k) as *mut u8)
                    == __mmio_read8((nadel + k) as *mut u8) {
                    k = k + 1
                }
                if k == m {
                    fuied.ta_waehle(w_text, y, i, y, i + m)
                    status_set()
                    return true
                }
                i = i + 1
            }
        }
        y = y + 1
        x = 0
    }
    return false
}

fn find_now() -> bool {
    let y: u64 = fuied.ta_zeile(w_text) - 1
    let x: u64 = fuied.ta_spalte(w_text)
    if find_from(y, x) {
        return true
    }
    if find_from(0, 0) {
        return true
    }
    let _h: u64 = dlg_hinweis((&W_TITLE[0 as usize]) as u64,
        msg.get((&T_NICHTDA[0 as usize]) as u64))
    return false
}

fn replace_now() {
    if !fuied.ta_hat_auswahl(w_text) {
        if !find_now() {
            return
        }
    }
    let e: u64 = (&ersetztext[0 as usize]) as u64
    fuied.ta_einfuegen(w_text, e, ulib.length(e))
    if cur < ntab {
        tset(cur, TB_DIRTY, 1)
    }
    tabs_set()
    status_set()
    let _w: bool = find_now()
}

// ====================================================== DIE MENUEPUNKTE
fn menu_file(n: u64) {
    if n == 0 {
        // Neu
        let t: u64 = tab_new(0)
        if t != 0xFFFFFFFFFFFFFFFF {
            tab_save_to_buffer(cur)
            cur = t
            tab_show(t)
        }
    } else if n == 1 {
        // Oeffnen
        dlgart = 1
        __mmio_write8(((&dlgbuf[0 as usize]) as u64) as *mut u8, 0 as u8)
        let _d: u64 = dlg_entry((&W_TITLE[0 as usize]) as u64,
            msg.get((&T_OPEN[0 as usize]) as u64), (&dlgbuf[0 as usize]) as u64)
    } else if n == 2 {
        let _s: bool = save(cur)
    } else if n == 3 {
        dlgart = 2
        __mmio_write8(((&dlgbuf[0 as usize]) as u64) as *mut u8, 0 as u8)
        let _d: u64 = dlg_entry((&W_TITLE[0 as usize]) as u64,
            msg.get((&T_SAVE[0 as usize]) as u64), (&dlgbuf[0 as usize]) as u64)
    } else if n == 4 {
        close_tab()
    } else if n == 5 {
        beenden()
    }
}

fn close_tab() {
    if cur >= ntab {
        return
    }
    if tget(cur, TB_DIRTY) != 0 || fuied.ta_geaendert(w_text) {
        dlgart = 6
        let _d: u64 = dlg_ask((&W_TITLE[0 as usize]) as u64,
            msg.get((&T_ASK[0 as usize]) as u64))
        return
    }
    close_confirmed()
}

fn close_confirmed() {
    if ntab <= 1 {
        tset(0, TB_PATH, 0)
        tset(0, TB_PUF, 0)
        tset(0, TB_N, 0)
        tset(0, TB_DIRTY, 0)
        tset(0, TB_LANG, fuied.LANG_NONE)
        cur = 0
        fuied.ta_leeren(w_text)
        fuied.ta_lang(w_text, fuied.LANG_NONE)
        tabs_set()
        status_set()
        title_set()
        return
    }
    var t: u64 = cur
    while t + 1 < ntab {
        tb[(t * TB_W + TB_PATH) as usize] = tb[((t + 1) * TB_W + TB_PATH) as usize]
        tb[(t * TB_W + TB_PUF) as usize] = tb[((t + 1) * TB_W + TB_PUF) as usize]
        tb[(t * TB_W + TB_N) as usize] = tb[((t + 1) * TB_W + TB_N) as usize]
        tb[(t * TB_W + TB_CAP) as usize] = tb[((t + 1) * TB_W + TB_CAP) as usize]
        tb[(t * TB_W + TB_DIRTY) as usize] = tb[((t + 1) * TB_W + TB_DIRTY) as usize]
        tb[(t * TB_W + TB_LANG) as usize] = tb[((t + 1) * TB_W + TB_LANG) as usize]
        tb[(t * TB_W + TB_CY) as usize] = tb[((t + 1) * TB_W + TB_CY) as usize]
        tb[(t * TB_W + TB_CX) as usize] = tb[((t + 1) * TB_W + TB_CX) as usize]
        tb[(t * TB_W + TB_EOL) as usize] = tb[((t + 1) * TB_W + TB_EOL) as usize]
        ulib.strncpy(path_of(t), path_of(t + 1), 127)
        if tb[(t * TB_W + TB_PATH) as usize] != 0 {
            tb[(t * TB_W + TB_PATH) as usize] = path_of(t)
        }
        t = t + 1
    }
    ntab = ntab - 1
    if cur >= ntab {
        cur = ntab - 1
    }
    tab_show(cur)
}

fn beenden() {
    var open: bool = false
    if fuied.ta_geaendert(w_text) {
        open = true
    }
    var t: u64 = 0
    while t < ntab {
        if tget(t, TB_DIRTY) != 0 {
            open = true
        }
        t = t + 1
    }
    if open {
        dlgart = 7
        let _d: u64 = dlg_ask((&W_TITLE[0 as usize]) as u64,
            msg.get((&T_ASK[0 as usize]) as u64))
        return
    }
    fuiscene.quit()
}

fn menu_edit(n: u64) {
    fuiscene.focus(K_ED)
    if n == 0 {
        fuied.ed_key(w_text, 26) // Strg+Z
    } else if n == 1 {
        fuied.ed_key(w_text, 25) // Strg+Y
    } else if n == 2 {
        fuied.ed_key(w_text, 24) // Strg+X
    } else if n == 3 {
        fuied.ed_key(w_text, 3) // Strg+C
    } else if n == 4 {
        fuied.ed_key(w_text, 22) // Strg+V
    }
    if cur < ntab && fuied.ta_geaendert(w_text) {
        tset(cur, TB_DIRTY, 1)
    }
    tabs_set()
    status_set()
}

fn menu_find(n: u64) {
    if n == 0 {
        dlgart = 3
        __mmio_write8(((&dlgbuf[0 as usize]) as u64) as *mut u8, 0 as u8)
        let _d: u64 = dlg_entry((&W_TITLE[0 as usize]) as u64,
            msg.get((&T_FIND[0 as usize]) as u64), (&dlgbuf[0 as usize]) as u64)
    } else if n == 1 {
        dlgart = 4
        __mmio_write8(((&dlgbuf[0 as usize]) as u64) as *mut u8, 0 as u8)
        let _d: u64 = dlg_entry((&W_TITLE[0 as usize]) as u64,
            msg.get((&T_FIND[0 as usize]) as u64), (&dlgbuf[0 as usize]) as u64)
    } else if n == 2 {
        dlgart = 5
        __mmio_write8(((&dlgbuf[0 as usize]) as u64) as *mut u8, 0 as u8)
        let _d: u64 = dlg_entry((&W_TITLE[0 as usize]) as u64,
            (&T_GOTO[0 as usize]) as u64, (&dlgbuf[0 as usize]) as u64)
    }
}

fn dialog_fertig(ok: bool) {
    let art: u64 = dlgart
    dlgart = 0
    if art == 6 {
        if ok {
            close_confirmed()
        }
        return
    }
    if art == 7 {
        if ok {
            fuiscene.quit()
        }
        return
    }
    if !ok {
        return
    }
    let p: u64 = fuiscene.dialog_entry_text()
    if p == 0 || ulib.length(p) == 0 {
        return
    }
    if art == 1 {
        let _o: bool = open_file(p)
    } else if art == 2 {
        if cur < ntab {
            ulib.strncpy(path_of(cur), p, 127)
            tset(cur, TB_PATH, path_of(cur))
            tset(cur, TB_LANG, lang_von(path_of(cur)))
            fuied.ta_lang(w_text, tget(cur, TB_LANG))
            let _s: bool = save(cur)
            tabs_set()
            title_set()
        }
    } else if art == 3 {
        ulib.strncpy((&suchtext[0 as usize]) as u64, p, 126)
        let _f: bool = find_now()
    } else if art == 4 {
        ulib.strncpy((&suchtext[0 as usize]) as u64, p, 126)
        dlgart = 8
        __mmio_write8(((&dlgbuf[0 as usize]) as u64) as *mut u8, 0 as u8)
        let _d: u64 = dlg_entry((&W_TITLE[0 as usize]) as u64,
            (&T_REPLACE[0 as usize]) as u64, (&dlgbuf[0 as usize]) as u64)
    } else if art == 8 {
        ulib.strncpy((&ersetztext[0 as usize]) as u64, p, 126)
        replace_now()
    } else if art == 5 {
        let z: u64 = ulib.to_num(p)
        if z > 0 {
            fuied.ta_gehe(w_text, z - 1, 0)
            status_set()
        }
    }
}

static mut MS_A: [u8; 16] = "nedit: tippen n␀"
static mut MS_B: [u8; 9] = " ticks ␀␀"
static mut MS_C: [u8; 10] = " us_je ␀␀␀"
static mut MS_D: [u8; 10] = " zeilen ␀␀"

fn messen(n: u64) {
    let mitte: u64 = fuied.ta_zeilen(w_text) / 2
    fuied.ta_gehe(w_text, mitte, 0)
    let t0: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    var k: u64 = 0
    while k < n {
        fuied.ed_key(w_text, 97 + (k % 26))
        k = k + 1
    }
    let t1: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    let dt: u64 = t1 - t0
    lineout.add_text((&MS_A[0 as usize]) as u64)
    lineout.add_num(n)
    lineout.add_text((&MS_B[0 as usize]) as u64)
    lineout.add_num(dt)
    lineout.add_text((&MS_C[0 as usize]) as u64)
    if n != 0 {
        lineout.add_num(dt * 10000 / n)
    }
    lineout.add_text((&MS_D[0 as usize]) as u64)
    lineout.add_num(fuied.ta_zeilen(w_text))
    lineout.end_line()
}

static mut MR_A: [u8; 17] = "nedit: rollen n␀␀"

fn messen_rollen(n: u64, mit_anstrich: bool) {
    fuied.ta_gehe(w_text, 0, 0)
    let t0: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    var k: u64 = 0
    while k < n {
        fuied.ed_key(w_text, 0x108) // KEY_PGDN
        if mit_anstrich {
            fuiscene.touch()
            let _s: u64 = fuiscene.pump()
        }
        k = k + 1
    }
    let t1: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    let dt: u64 = t1 - t0
    lineout.add_text((&MR_A[0 as usize]) as u64)
    lineout.add_num(n)
    lineout.add_text((&MS_B[0 as usize]) as u64)
    lineout.add_num(dt)
    lineout.add_text((&MS_C[0 as usize]) as u64)
    if n != 0 {
        lineout.add_num(dt * 10000 / n)
    }
    lineout.add_text((&MS_D[0 as usize]) as u64)
    lineout.add_num(fuied.ta_zeile(w_text))
    lineout.end_line()
}

// ========================================================= DIE SCHLEIFE
fn u_start(args: u64) -> u64 {
    let _mi: u64 = msg.init()
    var s_go: [u8; 13] = "nedit: ready\0"
    var s_bad2: [u8; 21] = "nedit: out of memory\0"
    iobuf = wlibc.map_surface(IOMAX)
    if ulib.bad(iobuf) || iobuf == 0 {
        lineout.add_text((&s_bad2[0 as usize]) as u64)
        lineout.end_line()
        return 1
    }
    if !aufbauen() {
        return 1
    }
    let _t0: u64 = tab_new(0)
    cur = 0
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    var measure: u64 = 0
    var messr: u64 = 0
    var messrn: u64 = 0
    var show: u64 = 0
    var s_m: [u8; 8] = "messen=\0"
    var s_r: [u8; 8] = "rollen=\0"
    var s_rn: [u8; 9] = "rollnur=\0"
    var s_z: [u8; 6] = "zeig=\0"
    while a < argc && ntab < MAXTAB {
        let p: u64 = ulib.arg_at(args, a)
        if p != 0 && ulib.length(p) != 0 {
            if ulib.strneq(p, (&s_m[0 as usize]) as u64, 7) {
                measure = ulib.to_num(p + 7)
            } else if ulib.strneq(p, (&s_r[0 as usize]) as u64, 7) {
                messr = ulib.to_num(p + 7)
            } else if ulib.strneq(p, (&s_rn[0 as usize]) as u64, 8) {
                messrn = ulib.to_num(p + 8)
            } else if ulib.strneq(p, (&s_z[0 as usize]) as u64, 5) {
                show = ulib.to_num(p + 5)
            } else {
                let _o: bool = open_file(p)
            }
        }
        a = a + 1
    }
    tab_show(cur)
    tabs_set()
    status_set()
    title_set()
    lineout.add_text((&s_go[0 as usize]) as u64)
    lineout.end_line()
    say_state()
    if messr != 0 {
        messen_rollen(messr, true)
    }
    if messrn != 0 {
        messen_rollen(messrn, false)
    }
    if measure != 0 {
        messen(measure)
        say_state()
    }
    if show == 1 {
        fuied.ta_gehe(w_text, 3, 0)
        var z: u64 = 0
        while z < 18 {
            fuied.ed_key_mod(w_text, 0x104, 2) // Umschalt + Pfeil rechts
            z = z + 1
        }
        fuied.ed_key_mod(w_text, 0x102, 2) // Umschalt + Pfeil runter
    } else if show == 2 {
        ulib.strncpy((&suchtext[0 as usize]) as u64,
            (&Z_SUCH[0 as usize]) as u64, 126)
        let _f: bool = find_now()
    } else if show == 3 {
        ulib.strncpy((&suchtext[0 as usize]) as u64,
            (&Z_SUCH[0 as usize]) as u64, 126)
        ulib.strncpy((&ersetztext[0 as usize]) as u64,
            (&Z_ERS[0 as usize]) as u64, 126)
        replace_now()
    } else if show == 5 {
        ulib.strncpy((&suchtext[0 as usize]) as u64,
            (&Z_SUCH[0 as usize]) as u64, 126)
        ulib.strncpy((&ersetztext[0 as usize]) as u64,
            (&Z_ERS[0 as usize]) as u64, 126)
        replace_now()
        if save(cur) {
            lineout.add_text((&Z_GESICHERT[0 as usize]) as u64)
        } else {
            lineout.add_text((&Z_NICHT[0 as usize]) as u64)
        }
        lineout.end_line()
    } else if show == 4 {
        if ntab > 1 {
            tab_show(1)
        }
        fuied.ta_gehe(w_text, 2600, 0)
    }
    if show != 0 {
        status_set()
        tabs_set()
        say_state()
    }

    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        if key != 0 {
            behandeln(key)
        }
        if s_open != 0 && !fuiscene.menu_is_open() && key != fuiscene.KEY_POPUP {
            s_open = 0
        }
        let z: u64 = fuied.ta_zeile(w_text)
        let sp: u64 = fuied.ta_spalte(w_text)
        if z != last_z || sp != last_s
            || fuied.ta_geaendert(w_text) != last_d {
            last_z = z
            last_s = sp
            last_d = fuied.ta_geaendert(w_text)
            if last_d && cur < ntab && tget(cur, TB_DIRTY) == 0 {
                tset(cur, TB_DIRTY, 1)
                tabs_set()
            }
            status_set()
        }
    }
    say_state()
    return 0
}

static mut last_z: u64 = 0
static mut last_s: u64 = 0
static mut last_d: bool = false
static mut last_r: u64 = 0

// ================================================ WAS DER PRUEFSTAND LIEST
static mut SG_A: [u8; 15] = "nedit: reiter \0"
static mut SG_B: [u8; 9] = " zeilen \0"
static mut SG_C: [u8; 9] = " zeile \0\0"
static mut SG_D: [u8; 9] = " spalte \0"
static mut SG_E: [u8; 8] = " modif \0"

fn say_state() {
    lineout.add_text((&SG_A[0 as usize]) as u64)
    lineout.add_num(ntab)
    lineout.add_text((&SG_B[0 as usize]) as u64)
    lineout.add_num(fuied.ta_zeilen(w_text))
    lineout.add_text((&SG_C[0 as usize]) as u64)
    lineout.add_num(fuied.ta_zeile(w_text))
    lineout.add_text((&SG_D[0 as usize]) as u64)
    lineout.add_num(fuied.ta_spalte(w_text))
    lineout.add_text((&SG_E[0 as usize]) as u64)
    var d: u64 = 0
    if fuied.ta_geaendert(w_text) {
        d = 1
    }
    lineout.add_num(d)
    lineout.end_line()
}

// ==================================================== RUNDE 31: profile app
fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}

const K_ED: u64 = 10
const K_MB: u64 = 20
const K_TB: u64 = 30

static mut s_up: bool = false
static mut s_open: u64 = 0
static mut s_mit: [u8; 160] = [0 as u8; 160]
static mut s_pm: [u8; 400] = [0 as u8; 400]
static mut s_tl: [u8; 640] = [0 as u8; 640]
static mut t_ok: [u8; 3] = "OK\0"
static mut t_ab: [u8; 13] = "store.cancel\0"

fn rfr() {
    if s_up {
        fuiscene.refresh()
    }
}

fn dlg_entry(title: u64, label: u64, initial: u64) -> u64 {
    fuiscene.dialog_entry(title, label, initial, ((&t_ok[0 as usize]) as u64), (msg.get((&t_ab[0 as usize]) as u64)))
    return 0
}

fn dlg_ask(title: u64, text: u64) -> u64 {
    fuiscene.dialog_open(title, text, ((&t_ok[0 as usize]) as u64), (msg.get((&t_ab[0 as usize]) as u64)))
    return 0
}

fn dlg_hinweis(title: u64, text: u64) -> u64 {
    fuiscene.dialog_open(title, text, ((&t_ok[0 as usize]) as u64), 0)
    return 0
}

// Lines of a text -> items one after the other, each ended by a NUL.
fn split_items(src: u64, dst: u64, max: u64) -> u64 {
    var n: u64 = 0
    var at: u64 = 0
    var k: u64 = 0
    var last_nl: bool = true
    while __mmio_read8((src + k) as *mut u8) != 0 as u8 && at + 2 < max {
        let c: u8 = __mmio_read8((src + k) as *mut u8)
        if c == 10 as u8 {
            __mmio_write8((dst + at) as *mut u8, 0 as u8)
            n = n + 1
            last_nl = true
        } else {
            __mmio_write8((dst + at) as *mut u8, c)
            last_nl = false
        }
        at = at + 1
        k = k + 1
    }
    if !last_nl {
        n = n + 1
    }
    __mmio_write8((dst + at) as *mut u8, 0 as u8)
    __mmio_write8((dst + at + 1) as *mut u8, 0 as u8)
    return n
}

fn item_at(p: u64, j: u64) -> u64 {
    var q: u64 = p
    var k: u64 = 0
    while k < j {
        q = q + ulib.length(q) + 1
        k = k + 1
    }
    return q
}

fn text_w(p: u64) -> u64 {
    return wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, ulib.length(p)) / fuiscene.scale()
}

// The height of the text area for a window of height `h`.
fn ed_height(h: u64) -> u64 {
    // r442: padding 16, three gaps of 8, tabs 36, the command bar 32, status 24 -- two rows above the text
    let fix: u64 = 16 + 24 + 36 + 32 + 24
    if h > fix + 100 {
        return h - fix
    }
    return 100
}

// ---- r442: the command bar of the editor. The actions are those of the three menus (file, edit, search),
// listed in the order of their importance; the last one opens the file menu for everything else
// (save as, close, quit). The words are the labels of the menus (the tooltip and the accessibility name).
const K_CB: u64 = 40
const K_OVF: u64 = 60
static mut cb_f: [u8; 400] = [0 as u8; 400]
static mut cb_e: [u8; 400] = [0 as u8; 400]
static mut cb_s: [u8; 400] = [0 as u8; 400]

fn bar_room() -> u64 {
    // the path label keeps 220 points
    if bw > 16 + 220 + 8 {
        return bw - 16 - 220 - 8
    }
    return 0
}

fn cmd_room() {
    let _f: u64 = split_items((msg.get((&M_FILE[0 as usize]) as u64)), ((&cb_f[0 as usize]) as u64), 390)
    let _e: u64 = split_items((msg.get((&M_BEARB[0 as usize]) as u64)), ((&cb_e[0 as usize]) as u64), 390)
    let _s: u64 = split_items((msg.get((&M_FIND[0 as usize]) as u64)), ((&cb_s[0 as usize]) as u64), 390)
    fuiscene.cmd_begin()
    fuiscene.cmd_item(icons.CMD_NEW_FILE, K_CB, item_at(((&cb_f[0 as usize]) as u64), 0), 0, 0)
    fuiscene.cmd_item(icons.CMD_OPEN, K_CB + 1, item_at(((&cb_f[0 as usize]) as u64), 1), 0, 0)
    fuiscene.cmd_item(icons.CMD_SAVE, K_CB + 2, item_at(((&cb_f[0 as usize]) as u64), 2), 0, 0)
    fuiscene.cmd_item(icons.CMD_UNDO, K_CB + 3, item_at(((&cb_e[0 as usize]) as u64), 0), 0, 1)
    fuiscene.cmd_item(icons.CMD_REDO, K_CB + 4, item_at(((&cb_e[0 as usize]) as u64), 1), 0, 0)
    fuiscene.cmd_item(icons.CMD_CUT, K_CB + 5, item_at(((&cb_e[0 as usize]) as u64), 2), 0, 1)
    fuiscene.cmd_item(icons.CMD_COPY, K_CB + 6, item_at(((&cb_e[0 as usize]) as u64), 3), 0, 0)
    fuiscene.cmd_item(icons.CMD_PASTE, K_CB + 7, item_at(((&cb_e[0 as usize]) as u64), 4), 0, 0)
    fuiscene.cmd_item(icons.SEARCH, K_CB + 8, item_at(((&cb_s[0 as usize]) as u64), 0), 0, 1)
    fuiscene.cmd_item(icons.MENU, K_MB, item_at(((&cb_f[0 as usize]) as u64), 5), 0, 1)
}

fn build() {
    bw = fuiscene.width()
    bh = fuiscene.height()
    let col: usize = fuiscene.root()
    // ---- the tabs, one label each
    let tr: usize = fuiscene.row(col)
    fuiscene.set_gap(tr, 4)
    let nt: u64 = split_items(((&tabtext[0 as usize]) as u64), ((&s_tl[0 as usize]) as u64), 630)
    var tw: u64 = 200
    if nt > 0 && bw > 16 {
        let part: u64 = (bw - 16) / nt
        if part < tw {
            tw = part
        }
    }
    tw = tw / 4 * 4
    var i: u64 = 0
    while i < nt && i < MAXTAB {
        let tb2: usize = fuiscene.tab(tr, item_at(((&s_tl[0 as usize]) as u64), i), K_TB + i, i == cur)
        fuiscene.set_size(tb2, tw, 36)
        i = i + 1
    }
    // ---- the command bar (r442): icons, the word is the tooltip; the path of the file at its right
    let br: usize = fuiscene.row(col)
    fuiscene.set_gap(br, 4)
    cmd_room()
    let _vis: u64 = fuiscene.cmd_end(br, bar_room(), K_OVF)
    let _pf: usize = fuiscene.label(br, ((&s_title[0 as usize]) as u64))
    // ---- the text
    let _ed: usize = fuiscene.editor(col, K_ED, bw - 16, ed_height(bh))
    // ---- the status line
    let _st: usize = fuiscene.label(col, ((&s_stat[0 as usize]) as u64))
}

fn aufbauen() -> bool {
    var s_bad: [u8; 22] = "nedit: no surface\0\0\0\0\0"
    if !fuiscene.begin() {
        lineout.add_text((&s_bad[0 as usize]) as u64)
        lineout.end_line()
        return false
    }
    w_text = fuiscene.editor_prep(K_ED)
    if w_text >= fuied.TA_MAX {
        lineout.add_text((&s_bad[0 as usize]) as u64)
        lineout.end_line()
        return false
    }
    fuied.ed_size(w_text, bw - 16, ed_height(bh))
    if !fuiscene.open(60, 40, bw, bh, ((&W_TITLE[0 as usize]) as u64), build) {
        lineout.add_text((&s_bad[0 as usize]) as u64)
        lineout.end_line()
        return false
    }
    s_up = true
    fuiscene.set_app(((&W_APP[0 as usize]) as u64))
    fuiscene.drop_accept(true) // W-DND: a file dragged here from another window opens in a tab
    fuiscene.focus(K_ED)
    return true
}

// What the loop does with one answer of `pump`.
fn behandeln(key: u64) {
    if key == fuiscene.KEY_DROP {
        // W-DND: a path dragged from another window (Explorer) opens in a tab of the RUNNING editor
        var zp: [u8; 192] = [0 as u8; 192]
        if ulib.drag_an() && ulib.drag_type_path() != 0 {
            let zn: u64 = ulib.drag_take((&zp[0 as usize]) as u64, 190)
            if zn > 0 {
                zp[(zn) as usize] = 0 as u8
                var s_dd: [u8; 12] = "nedit: drop\0"
                lineout.add_text((&s_dd[0 as usize]) as u64)
                lineout.end_line()
                let _o: bool = open_file((&zp[0 as usize]) as u64)
                tabs_set()
                status_set()
                title_set()
            }
            let _c: u64 = ulib.drag_drop()
        }
        fuiscene.focus(K_ED)
        return
    }
    if key == fuiscene.KEY_DIALOG {
        let res: u64 = fuiscene.dialog_result()
        if dlgart != 0 {
            dialog_fertig(res == 1)
            tabs_set()
            status_set()
            title_set()
        }
        fuiscene.focus(K_ED)
        return
    }
    if key == fuiscene.KEY_POPUP {
        let pick: u64 = fuiscene.menu_pick()
        if pick >= 1 {
            let idx: u64 = pick - 1
            if s_open == 1 {
                menu_file(idx)
            } else if s_open == 2 {
                menu_edit(idx)
            } else if s_open == 3 {
                menu_find(idx)
            } else if s_open == 9 {
                // the overflow menu of the command bar: the same action as the button of that line
                let hk: u64 = fuiscene.cmd_hidden_key(idx)
                s_open = 0
                if hk != 0 {
                    behandeln(hk)
                }
            }
            tabs_set()
            status_set()
            title_set()
        }
        s_open = 0
        return
    }
    if key >= K_CB && key < K_CB + 9 {
        let ci: u64 = key - K_CB
        if ci < 3 {
            menu_file(ci)
        } else if ci < 8 {
            menu_edit(ci - 3)
        } else {
            menu_find(0)
        }
        tabs_set()
        status_set()
        title_set()
        return
    }
    if key == K_OVF {
        let on: usize = fuiscene.node_of_key(key)
        var ox: u64 = 8
        var oy: u64 = 40
        if on != fuiscene.NONE {
            ox = fuiscene.node_x(on)
            oy = fuiscene.node_y(on) + fuiscene.node_h(on)
        }
        let hl: u64 = fuiscene.cmd_hidden_labels()
        let hn: u64 = split_items(hl, ((&s_pm[0 as usize]) as u64), 390)
        var hw: u64 = 140
        var hj: u64 = 0
        while hj < hn {
            let tw3: u64 = text_w(item_at(((&s_pm[0 as usize]) as u64), hj)) + 32
            if tw3 > hw {
                hw = tw3
            }
            hj = hj + 1
        }
        s_open = 9
        fuiscene.menu_open(ox, oy, (hw + 3) / 4 * 4, ((&s_pm[0 as usize]) as u64), hn)
        return
    }
    if key >= K_MB && key < K_MB + 3 {
        let m: u64 = key - K_MB
        var items: u64 = (msg.get((&M_FILE[0 as usize]) as u64))
        if m == 1 {
            items = (msg.get((&M_BEARB[0 as usize]) as u64))
        } else if m == 2 {
            items = (msg.get((&M_FIND[0 as usize]) as u64))
        }
        let n: usize = fuiscene.node_of_key(key)
        var x: u64 = 8
        var y: u64 = 40
        if n != fuiscene.NONE {
            x = fuiscene.node_x(n)
            y = fuiscene.node_y(n) + fuiscene.node_h(n)
        }
        let cnt: u64 = split_items(items, ((&s_pm[0 as usize]) as u64), 390)
        var wm: u64 = 140
        var j: u64 = 0
        while j < cnt {
            let tw2: u64 = text_w(item_at(((&s_pm[0 as usize]) as u64), j)) + 32
            if tw2 > wm {
                wm = tw2
            }
            j = j + 1
        }
        s_open = m + 1
        fuiscene.menu_open(x, y, (wm + 3) / 4 * 4, ((&s_pm[0 as usize]) as u64), cnt)
        return
    }
    if key >= K_TB && key < K_TB + MAXTAB {
        tab_show(key - K_TB)
        return
    }
}
