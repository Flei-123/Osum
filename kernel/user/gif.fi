
profile app

import ulib

export {
    gif_read, ist_gif, width, height, err, fehlertext,
    frames, delay_ms, bedarf,
    G_OK, G_FORM, G_TRUNC, G_BIG, G_LZW
}

const G_OK: u64 = 0
const G_FORM: u64 = 1
const G_TRUNC: u64 = 2
const G_BIG: u64 = 3
const G_LZW: u64 = 4

static mut g_w: u64 = 0
static mut g_h: u64 = 0
static mut g_err: u64 = 0
static mut g_frames: u64 = 0
static mut g_delay: u64 = 0

static mut gct: [u8; 1024] = [0 as u8; 1024]
static mut lct: [u8; 1024] = [0 as u8; 1024]

static mut lz_prefix: [u16; 4096] = [0 as u16; 4096]
static mut lz_suffix: [u8; 4096] = [0 as u8; 4096]
static mut lz_stack: [u8; 4096] = [0 as u8; 4096]

static mut src: u64 = 0
static mut srcn: u64 = 0
static mut at: u64 = 0
static mut canvas: u64 = 0
static mut tidx: u64 = 0x1000 // durchsichtiger Index, >255 = keiner

fn width() -> u64 {
    return g_w
}

fn height() -> u64 {
    return g_h
}

fn err() -> u64 {
    return g_err
}

fn frames() -> u64 {
    return g_frames
}

fn delay_ms() -> u64 {
    return g_delay
}

static mut t_ok: [u8; 11] = "in Ordnung\0"
static mut t_form: [u8; 24] = "kein gültiges GIF-Bild\0"
static mut t_trunc: [u8; 26] = "das GIF ist abgeschnitten\0"
static mut t_big: [u8; 40] = "das Bild ist zu groß für den Speicher\0"
static mut t_lzw: [u8; 35] = "der GIF-Datenstrom ist beschädigt\0"

fn fehlertext() -> u64 {
    if g_err == G_FORM {
        return (&t_form[(0) as usize]) as u64
    }
    if g_err == G_TRUNC {
        return (&t_trunc[(0) as usize]) as u64
    }
    if g_err == G_BIG {
        return (&t_big[(0) as usize]) as u64
    }
    if g_err == G_LZW {
        return (&t_lzw[(0) as usize]) as u64
    }
    return (&t_ok[(0) as usize]) as u64
}

fn bedarf(w: u64, h: u64) -> u64 {
    return w * h * 4
}

fn ld8(p: u64, off: u64) -> u64 {
    return (*((p + off) as *mut u8)) as u64
}

fn o8(off: u64) -> u64 {
    if off >= srcn {
        return 0
    }
    return (*((src + off) as *mut u8)) as u64
}

fn o16(off: u64) -> u64 {
    return o8(off) | (o8(off + 1) << 8)
}

fn ist_gif(p: u64, n: u64) -> bool {
    if n < 13 {
        return false
    }
    if ld8(p, 0) != 71 || ld8(p, 1) != 73 || ld8(p, 2) != 70 {
        return false
    }
    if ld8(p, 3) != 56 {
        return false
    }
    let v: u64 = ld8(p, 4)
    if v != 55 && v != 57 {
        return false
    }
    return ld8(p, 5) == 97
}

fn read_pal(dst: u64, off: u64, n: u64) {
    var i: u64 = 0
    while i < n && i < 256 {
        let r: u64 = o8(off + i * 3)
        let g: u64 = o8(off + i * 3 + 1)
        let b: u64 = o8(off + i * 3 + 2)
        __mmio_write32((dst + i * 4) as *mut u32,
            (0xFF000000 | (r << 16) | (g << 8) | b) as u32)
        i = i + 1
    }
}

fn skip_blocks(from: u64) -> u64 {
    var q: u64 = from
    while q < srcn {
        let len: u64 = o8(q)
        if len == 0 {
            return q + 1
        }
        q = q + 1 + len
    }
    return srcn
}

fn count_frames() -> u64 {
    var q: u64 = at
    var c: u64 = 0
    while q < srcn {
        let b: u64 = o8(q)
        if b == 44 {
            c = c + 1
            if q + 10 > srcn {
                return c
            }
            let fl: u64 = o8(q + 9)
            q = q + 10
            if (fl & 128) != 0 {
                q = q + (1 << ((fl & 7) + 1)) * 3
            }
            if q >= srcn {
                return c
            }
            q = q + 1 // die Mindestcodebreite
            q = skip_blocks(q)
        } else if b == 33 {
            if q + 2 > srcn {
                return c
            }
            q = skip_blocks(q + 2)
        } else if b == 59 {
            return c
        } else {
            q = q + 1
        }
    }
    return c
}

// ---------------------------------------------------------------- LZW

static mut blk_at: u64 = 0
static mut blk_left: u64 = 0
static mut acc: u64 = 0
static mut accn: u64 = 0
static mut lz_bad: bool = false

fn nextbyte() -> i64 {
    while blk_left == 0 {
        if blk_at >= srcn {
            return 0 - 1
        }
        let len: u64 = o8(blk_at)
        blk_at = blk_at + 1
        if len == 0 {
            return 0 - 1
        }
        blk_left = len
    }
    if blk_at >= srcn {
        return 0 - 1
    }
    let b: u64 = o8(blk_at)
    blk_at = blk_at + 1
    blk_left = blk_left - 1
    return b as i64
}

fn getcode(nbits: u64) -> i64 {
    while accn < nbits {
        let b: i64 = nextbyte()
        if b < 0 {
            return 0 - 1
        }
        acc = acc | ((b as u64) << accn)
        accn = accn + 8
    }
    let v: u64 = acc & ((1 << nbits) - 1)
    acc = acc >> nbits
    accn = accn - nbits
    return v as i64
}

fn il_start(p: u64) -> u64 {
    if p == 0 {
        return 0
    }
    if p == 1 {
        return 4
    }
    if p == 2 {
        return 2
    }
    return 1
}

fn il_step(p: u64) -> u64 {
    if p == 0 {
        return 8
    }
    if p == 1 {
        return 8
    }
    if p == 2 {
        return 4
    }
    return 2
}

fn put_px(pal: u64, idx: u64, x: u64, y: u64) {
    if x >= g_w || y >= g_h {
        return
    }
    if idx == tidx {
        return
    }
    __mmio_write32((canvas + (y * g_w + x) * 4) as *mut u32,
        (__mmio_read32((pal + idx * 4) as *mut u32)) as u32)
}

fn lzw(from: u64, minbits: u64, pal: u64, fx: u64, fy: u64, fw: u64,
    fh: u64, ilace: u64) -> u64 {
    blk_at = from
    blk_left = 0
    acc = 0
    accn = 0
    let clear: u64 = 1 << minbits
    let stop: u64 = clear + 1
    var nbits: u64 = minbits + 1
    var next: u64 = clear + 2
    var old: i64 = 0 - 1
    var first: u64 = 0
    var px: u64 = 0
    var py: u64 = 0
    var pass: u64 = 0
    var going: bool = true
    while going {
        let code: i64 = getcode(nbits)
        if code < 0 {
            going = false
        } else if (code as u64) == clear {
            nbits = minbits + 1
            next = clear + 2
            old = 0 - 1
        } else if (code as u64) == stop {
            going = false
        } else {
            var sp: u64 = 0
            var c: u64 = code as u64
            if c >= next {
                if old < 0 {
                    lz_bad = true
                    going = false
                    c = 0
                } else {
                    lz_stack[(sp) as usize] = first as u8
                    sp = sp + 1
                    c = old as u64
                }
            }
            if going {
                var guard: u64 = 0
                while c >= clear + 2 && guard < 4096 {
                    lz_stack[(sp) as usize] = lz_suffix[(c) as usize]
                    sp = sp + 1
                    c = lz_prefix[(c) as usize] as u64
                    guard = guard + 1
                }
                if guard >= 4096 {
                    lz_bad = true
                    going = false
                } else {
                    first = c
                    lz_stack[(sp) as usize] = c as u8
                    sp = sp + 1
                    while sp > 0 {
                        sp = sp - 1
                        let idx: u64 = lz_stack[(sp) as usize] as u64
                        if py < fh {
                            put_px(pal, idx, fx + px, fy + py)
                        }
                        px = px + 1
                        if px >= fw {
                            px = 0
                            if ilace != 0 {
                                py = py + il_step(pass)
                                while py >= fh && pass < 3 {
                                    pass = pass + 1
                                    py = il_start(pass)
                                }
                            } else {
                                py = py + 1
                            }
                        }
                    }
                    if old >= 0 && next < 4096 {
                        lz_prefix[(next) as usize] = old as u16
                        lz_suffix[(next) as usize] = first as u8
                        next = next + 1
                        if next == (1 << nbits) && nbits < 12 {
                            nbits = nbits + 1
                        }
                    }
                    old = code
                }
            }
        }
    }
    var q: u64 = blk_at
    if blk_left > 0 {
        q = q + blk_left
    }
    return skip_blocks(q)
}

// ------------------------------------------------------- die Teilbilder

fn fill_rect(x: u64, y: u64, w: u64, h: u64) {
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            if x + c < g_w && y + r < g_h {
                __mmio_write32((canvas + ((y + r) * g_w + x + c) * 4)
                    as *mut u32, 0 as u32)
            }
            c = c + 1
        }
        r = r + 1
    }
}

fn draw_frame(disposal: u64) -> bool {
    if at + 10 > srcn {
        g_err = G_TRUNC
        return false
    }
    let fx: u64 = o16(at + 1)
    let fy: u64 = o16(at + 3)
    let fw: u64 = o16(at + 5)
    let fh: u64 = o16(at + 7)
    let fl: u64 = o8(at + 9)
    var q: u64 = at + 10
    var pal: u64 = (&gct[(0) as usize]) as u64
    if (fl & 128) != 0 {
        let n: u64 = 1 << ((fl & 7) + 1)
        if q + n * 3 > srcn {
            g_err = G_TRUNC
            return false
        }
        read_pal((&lct[(0) as usize]) as u64, q, n)
        pal = (&lct[(0) as usize]) as u64
        q = q + n * 3
    }
    let ilace: u64 = (fl >> 6) & 1
    if q >= srcn {
        g_err = G_TRUNC
        return false
    }
    let minbits: u64 = o8(q)
    q = q + 1
    if minbits < 2 || minbits > 11 {
        g_err = G_FORM
        return false
    }
    at = lzw(q, minbits, pal, fx, fy, fw, fh, ilace)
    g_frames = g_frames + 1
    if disposal == 2 || disposal == 3 {
        fill_rect(fx, fy, fw, fh)
    }
    return true
}

fn gif_read(p: u64, n: u64, out: u64, outcap: u64) -> bool {
    src = p
    srcn = n
    g_err = G_FORM
    g_w = 0
    g_h = 0
    g_frames = 0
    g_delay = 100
    tidx = 0x1000
    lz_bad = false
    if !ist_gif(p, n) {
        return false
    }
    g_w = o16(6)
    g_h = o16(8)
    if g_w == 0 || g_h == 0 {
        g_err = G_FORM
        return false
    }
    if bedarf(g_w, g_h) > outcap {
        g_err = G_BIG
        return false
    }
    canvas = out
    let flags: u64 = o8(10)
    at = 13
    var i: u64 = 0
    while i < g_w * g_h {
        __mmio_write32((canvas + i * 4) as *mut u32, 0 as u32)
        i = i + 1
    }
    var k: u64 = 0
    while k < 256 {
        __mmio_write32(((&gct[(0) as usize]) as u64 + k * 4) as *mut u32,
            0xFF000000 as u32)
        __mmio_write32(((&lct[(0) as usize]) as u64 + k * 4) as *mut u32,
            0xFF000000 as u32)
        k = k + 1
    }
    if (flags & 128) != 0 {
        let gn: u64 = 1 << ((flags & 7) + 1)
        if at + gn * 3 > n {
            g_err = G_TRUNC
            return false
        }
        read_pal((&gct[(0) as usize]) as u64, at, gn)
        at = at + gn * 3
    }
    let total: u64 = count_frames()
    if total == 0 {
        g_err = G_FORM
        return false
    }
    var disposal: u64 = 0
    var fertig: bool = false
    while !fertig && at < srcn {
        let b: u64 = o8(at)
        if b == 33 {
            // Ein Erweiterungsblock.
            if at + 2 > srcn {
                g_err = G_TRUNC
                return false
            }
            let kind: u64 = o8(at + 1)
            if kind == 249 && at + 7 <= srcn {
                // Der Grafiksteuerblock: Entsorgung, Durchsichtigkeit,
                // Anzeigedauer (in Hundertstelsekunden).
                let fl: u64 = o8(at + 3)
                g_delay = o16(at + 4) * 10
                if g_delay == 0 {
                    g_delay = 100
                }
                if (fl & 1) != 0 {
                    tidx = o8(at + 6)
                } else {
                    tidx = 0x1000
                }
                disposal = (fl >> 2) & 7
            }
            at = skip_blocks(at + 2)
        } else if b == 44 {
            if !draw_frame(disposal) {
                return false
            }
            fertig = true
        } else if b == 59 {
            fertig = true
        } else {
            at = at + 1
        }
    }
    if g_frames == 0 {
        g_err = G_FORM
        return false
    }
    if lz_bad {
        g_err = G_LZW
        return false
    }
    g_frames = total
    g_err = G_OK
    return true
}
