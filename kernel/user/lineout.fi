profile kernel

import ulib

export { add_text, add_num, end_line }

const CAP: u64 = 480

static mut line_buf: [u8; 512] = [0 as u8; 512]
static mut line_used: u64 = 0

fn flush() {
    if line_used > 0 {
        ulib.put((&line_buf[0 as usize]) as u64, line_used)
        line_used = 0
    }
}

fn push_byte(c: u8) {
    if line_used >= CAP {
        flush()
    }
    line_buf[(line_used) as usize] = c
    line_used = line_used + 1
}

fn add_text(p: u64) {
    var k: u64 = 0
    while true {
        let c: u8 = __mmio_read8((p + k) as *mut u8)
        if c == 0 {
            return
        }
        push_byte(c)
        k = k + 1
    }
}

fn add_num(v: u64) {
    var digits: [u8; 26] = [0 as u8; 26]
    let n: u64 = ulib.digits(v, (&digits[0 as usize]) as u64)
    var k: u64 = 0
    while k < n {
        push_byte(digits[(k) as usize])
        k = k + 1
    }
}

fn end_line() {
    push_byte(10 as u8)
    flush()
}
