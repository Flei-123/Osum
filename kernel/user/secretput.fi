profile kernel

import ulib
import actwire
import libc.text

export { handles, put }

const MIN_LEN: u64 = 8
const MAX_LEN: u64 = 32
const SYS_CHMOD: u64 = 90
const MODE_PRIVATE: u64 = 384
const NOT_FOUND: u64 = 0xFFFFFFFFFFFFFFFF
static mut K_FIXEDPW: [u8; 15] = "remote.fixedpw\0"
static mut SPACE: [u8; 2] = " \0"

fn handles(key: u64) -> bool {
    return actwire.str_eq(key, (&K_FIXEDPW[0 as usize]) as u64)
}

fn acceptable(v: u64) -> bool {
    let n: u64 = text.length(v)
    if n < MIN_LEN || n > MAX_LEN {
        return false
    }
    return ulib.find(v, (&SPACE[0 as usize]) as u64) == NOT_FOUND
}

fn put(path: u64, field: u64, v: u64) -> bool {
    if !acceptable(v) {
        return false
    }
    if !actwire.kvfile_set(path, field, v) {
        return false
    }
    return !ulib.bad(ulib.sys(SYS_CHMOD, path, MODE_PRIVATE, 0))
}
