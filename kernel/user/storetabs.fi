profile kernel

import store.registry

export {
    begin, push, tab_of, visible, show_installed, set_show_installed,
    plan_start, plan_total, plan_name, plan_step, plan_next, plan_active, plan_clear, plan_needs,
    VIEW_ALL, VIEW_APPS, VIEW_SYSTEM, VIEW_RUNTIME,
    NONE,
}

const NONE: u64 = 0xFFFFFFFFFFFFFFFF
const VIEW_ALL: u64 = 0
const VIEW_APPS: u64 = 1
const VIEW_SYSTEM: u64 = 6
const VIEW_RUNTIME: u64 = 7
const ITEM_MAX: u64 = 64
const STEP_MAX: u64 = 16
const NAME_W: u64 = 24

static mut t_tab: [u8; 64] = [0 as u8; 64]
static mut t_show_installed: bool = false
static mut q_name: [u8; 384] = [0 as u8; 384]
static mut q_n: u64 = 0
static mut q_at: u64 = 0

fn copy_name(dst: u64, src: u64) {
    var i: u64 = 0
    while (*((src + i) as *mut u8)) != 0 as u8 && i + 1 < NAME_W {
        *((dst + i) as *mut u8) = *((src + i) as *mut u8)
        i = i + 1
    }
    *((dst + i) as *mut u8) = 0 as u8
}

fn begin() {
    registry.reg_clear()
}

fn push(name: u64, installed_version: u64, requires: u64, kind: u64, bundled: bool) {
    let i: u64 = registry.reg_add(name, installed_version, requires)
    if i != registry.NONE && i < ITEM_MAX {
        t_tab[i as usize] = registry.kind_tab(kind, bundled) as u8
    }
}

fn tab_of(i: u64) -> u64 {
    if i >= ITEM_MAX {
        return registry.TAB_APPS
    }
    return t_tab[i as usize] as u64
}

fn view_tab(view: u64) -> u64 {
    if view == VIEW_SYSTEM {
        return registry.TAB_SYSTEM
    }
    if view == VIEW_RUNTIME {
        return registry.TAB_RUNTIME
    }
    return registry.TAB_APPS
}

fn is_tab_view(view: u64) -> bool {
    return view == VIEW_ALL || view == VIEW_APPS || view == VIEW_SYSTEM || view == VIEW_RUNTIME
}

fn visible(view: u64, i: u64, installed: bool, searching: bool) -> bool {
    if searching {
        return true
    }
    if !is_tab_view(view) {
        return true
    }
    let show: bool = t_show_installed || view == VIEW_ALL
    return registry.tab_shown(view_tab(view), tab_of(i), installed, show, false)
}

fn show_installed() -> bool {
    return t_show_installed
}

fn set_show_installed(on: bool) {
    t_show_installed = on
}

fn plan_start(item: u64) -> u64 {
    q_n = 0
    q_at = 0
    let n: u64 = registry.plan_build(item)
    var k: u64 = 0
    while k < n && k < STEP_MAX {
        copy_name((&q_name[0 as usize]) as u64 + k * NAME_W, registry.reg_name(registry.plan_at(k)))
        k = k + 1
    }
    q_n = k
    return q_n
}

fn plan_total() -> u64 {
    return q_n
}

fn plan_name(k: u64) -> u64 {
    return (&q_name[0 as usize]) as u64 + k * NAME_W
}

fn plan_step() -> u64 {
    return q_at
}

fn plan_active() -> bool {
    return q_n > 1 && q_at < q_n
}

fn plan_next() -> u64 {
    if q_at >= q_n {
        return NONE
    }
    q_at = q_at + 1
    return plan_name(q_at - 1)
}

fn plan_clear() {
    q_n = 0
    q_at = 0
}

fn plan_needs() -> u64 {
    if q_n < 2 {
        return 0
    }
    return q_n - 1
}
