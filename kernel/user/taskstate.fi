profile kernel

export { name_at, COUNT }

const COUNT: u64 = 10

static mut NAMES: [u8; 80] = "free   \0ready  \0run    \0sleep  \0wait   \0zombie \0new    \0stop   \0poll   \0reap   \0"

fn name_at(state: u64) -> u64 {
    var s: u64 = state
    if s >= COUNT {
        s = 0
    }
    return (&NAMES[0 as usize]) as u64 + s * 8
}
