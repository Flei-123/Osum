profile kernel

import fuiapp.hostwinp
import svcclip
import uitheme.thload
import ulib
import wlibc.wcbase
import wlibc.wcpaint

fn start(noclip: bool) -> bool {
    if wcbase.s_ready != 0 {
        return true
    }
    wcbase.s_scr_w = wcpaint.sys3w(wcbase.WIG_SCREEN, 0, 0, 0)
    wcbase.s_scr_h = wcpaint.sys3w(wcbase.WIG_SCREEN, 1, 0, 0)
    if ulib.bad(wcbase.s_scr_w) || wcbase.s_scr_w == 0 || wcbase.s_scr_w > wcbase.SURF_W_MAX {
        return false
    }
    if ulib.bad(wcbase.s_scr_h) || wcbase.s_scr_h == 0 {
        return false
    }
    var rows: u64 = wcbase.SURF_BUDGET / (wcbase.s_scr_w *% 4)
    if rows == 0 {
        return false
    }
    if rows > wcbase.s_scr_h {
        rows = wcbase.s_scr_h
    }
    let p: u64 = wcpaint.map_surface(wcbase.s_scr_w *% rows *% 4)
    if ulib.bad(p) || p == 0 {
        return false
    }
    wcbase.s_surf = p
    wcbase.s_scap = wcbase.s_scr_w *% rows *% 4
    wcbase.s_sw = wcbase.s_scr_w
    wcbase.s_srows = rows
    if noclip {
        svcclip.set_noclip()
    }
    let _tg: u64 = thload.theme_reload()
    wcbase.s_ready = 1
    return true
}

fn set_head_bounds(x: u64, y: u64, w: u64, h: u64) {
    wcbase.s_hb_x = x
    wcbase.s_hb_y = y
    wcbase.s_hb_w = w
    wcbase.s_hb_h = h
}

fn start_head_set(hd: u64) {
    let _r: u64 = wcpaint.sys3w(wcbase.WIG_SCREEN, hostwinp.WS_STARTHEAD, 1, hd)
}

fn start_head_get() -> u64 {
    let r: u64 = wcpaint.sys3w(wcbase.WIG_SCREEN, hostwinp.WS_STARTHEAD, 0, 0)
    if ulib.bad(r) {
        return 0
    }
    return r
}

fn set_band(y: u64) {
    if wcbase.s_pinned != 0 {
        return
    }
    wcbase.s_band = y
}
