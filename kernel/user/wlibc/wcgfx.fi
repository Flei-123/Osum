const WM_MOVE: u64 = 2106

const WM_SETBUF: u64 = 2140

const WM_DAMAGE: u64 = 2141

const WI_SHARED: u64 = 30

const WM_STATE: u64 = 2109

const WM_LIST: u64 = 2110

const WM_ACT: u64 = 2111

const WM_MINRECT: u64 = 2127

const WM_STRUT: u64 = 2112

const WM_SIZE: u64 = 2113

const WS_MAXIMIZED: u64 = 3

const WS_OPAC: u64 = 7

const WO_FRAMELESS: u64 = 2

const WO_KEYS: u64 = 4

const WO_OPAC: u64 = 8

const WO_SHIFT: u64 = 8

fn win_opts(frameless: bool, keys: bool, opac: u64) -> u64 {
    var o: u64 = 0
    if frameless {
        o = o | WO_FRAMELESS
    }
    if keys {
        o = o | WO_KEYS
    }
    if opac <= 255 {
        o = o | WO_OPAC | (opac << WO_SHIFT)
    }
    return o
}

fn win_set_opac(h: u64, v: u64) -> u64 {
    return wcpaint.sys3w(WM_STATE, h, WS_OPAC, v)
}

fn win_backlum(h: u64, which: u64) -> u64 {
    return wcpaint.sys3w(wcbase.WM_INFO, h, which, 0)
}

const WL_BYTES: u64 = 128

const WM_APP: u64 = 2116
const WM_TITLE: u64 = 2145

fn win_setbuf(h: u64, fd: u64) -> bool {
    return !ulib.bad(wcpaint.sys3w(WM_SETBUF, h, fd, 0))
}

fn win_damage(h: u64, x: u64, y: u64, w: u64, hh: u64) -> u64 {
    return wcpaint.sys3w(WM_DAMAGE, h, (x << 16) | y, (w << 16) | hh)
}

fn win_shared(h: u64) -> bool {
    return wcpaint.sys3w(wcbase.WM_INFO, h, WI_SHARED, 0) == 1
}

const PLATE: u64 = 0x01000000

static mut s_panel: u64 = 0

fn plate(x: u64, y: u64, w: u64, h: u64) {
    if w == 0 || h == 0 {
        return
    }
    if win_alpha_fx() >= 100 || s_panel != 0 {
        return
    }
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let a: u64 = wcpaint.get(x + c, y + r)
            wcpaint.px(x + c, y + r, (a & 0xFFFFFF) | PLATE)
            c = c + 1
        }
        r = r + 1
    }
}

const INK_R: u64 = 2

fn plate_ink(x: u64, y: u64, w: u64, h: u64) {
    if w == 0 || h == 0 {
        return
    }
    if win_alpha_fx() >= 100 || s_panel != 0 {
        return
    }
    let bg: u64 = wcpaint.get(x, y) & 0xFFFFFF
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let a: u64 = wcpaint.get(x + c, y + r)
            if (a & 0xFFFFFF) != bg {
                var dy: u64 = 0
                while dy <= INK_R * 2 {
                    var dx: u64 = 0
                    while dx <= INK_R * 2 {

                        let qx: u64 = x + c + dx
                        let qy: u64 = y + r + dy
                        if qx >= INK_R && qy >= INK_R {
                            let q: u64 = wcpaint.get(qx - INK_R, qy - INK_R)
                            if (q >> 24) != 1 {
                                wcpaint.px(qx - INK_R, qy - INK_R, (q & 0xFFFFFF) | PLATE)
                            }
                        }
                        dx = dx + 1
                    }
                    dy = dy + 1
                }
            }
            c = c + 1
        }
        r = r + 1
    }
}

fn text_at(f: u64, px_: u64, x: u64, y: u64, p: u64, n: u64,
    color: u64) -> u64 {
    var cx: i64 = (x as i64) * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = n
        } else {
            if vorher != 0 {
                cx = cx + wcpaint.kern26(f, px_, vorher, c)
            }
            let at: u64 = wcpaint.gfind(f, px_, c)
            if at != 0xFFFFFFFFFFFFFFFF {
                wcpaint.draw_glyph(at, cx >> 6, y as i64, color)
                cx = cx + wcbase.gc[(at + wcbase.GC_ADV) as usize] as i64
            }
            vorher = c
            k = k + l
        }
    }
    let ende: u64 = (cx >> 6) as u64
    if ende > x {
        let asc: u64 = wcpaint.ascent_of(f, px_)
        var py0: u64 = 0
        if y > asc + 1 {
            py0 = y - asc - 1
        }
        plate_ink(x, py0, ende - x + 1, text_h(px_) + 2)
    }
    return ende
}

fn text_w(f: u64, px_: u64, p: u64, n: u64) -> u64 {
    var cx: i64 = 0
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = n
        } else {
            if vorher != 0 {
                cx = cx + wcpaint.kern26(f, px_, vorher, c)
            }
            let at: u64 = wcpaint.gfind(f, px_, c)
            if at != 0xFFFFFFFFFFFFFFFF {
                cx = cx + wcbase.gc[(at + wcbase.GC_ADV) as usize] as i64
            }
            vorher = c
            k = k + l
        }
    }
    return (cx >> 6) as u64
}

fn text_h(px_: u64) -> u64 {
    return px_ + px_ / 4
}

const N_50: u64 = 1

const N_100: u64 = 2

const N_200: u64 = 3

const N_300: u64 = 4

const N_400: u64 = 5

const N_500: u64 = 6

const N_600: u64 = 7

const N_700: u64 = 8

const N_800: u64 = 9

const N_950: u64 = 11

const A_400: u64 = 3

const A_600: u64 = 5

const S_TEXT_DISABLED: u64 = wcbase.S_TEXT_DISABLED

const S_BORDER: u64 = wcbase.S_BORDER

const S_BORDER_STRONG: u64 = wcbase.S_BORDER_STRONG

const S_BORDER_FOCUS: u64 = wcbase.S_BORDER_FOCUS

const S_ACCENT_DISABLED: u64 = wcbase.S_ACCENT_DISABLED

const S_SHADOW: u64 = wcbase.S_SHADOW

const C_BUTTON_FACE: u64 = 4

const C_BUTTON_HOVER: u64 = 5

const C_BUTTON_PRESSED: u64 = 6

const C_SELECT_BG: u64 = 8

const C_SELECT_TEXT: u64 = 9

const C_FOCUS_RING: u64 = 10

const C_HEADER_BG: u64 = 12

const C_SCROLL_TRACK: u64 = 13

const C_SCROLL_THUMB: u64 = 14

const C_DIALOG_BG: u64 = 16

const C_MENU_BG: u64 = 17

const C_TASKBAR_BG: u64 = 23

const C_TASKBAR_TEXT: u64 = 24

const C_TASKBAR_ACTIVE: u64 = 25

const C_DESKTOP_TOP: u64 = 26

const C_BUTTON_TEXT: u64 = 28

const C_BUTTON_DISABLED_TEXT: u64 = 29

const C_INPUT_TEXT: u64 = 30

const C_INPUT_BORDER: u64 = 31

const C_LIST_BG: u64 = 32

const C_MENU_TEXT: u64 = 33

const C_WARNING: u64 = 36

const C_SUCCESS: u64 = 37

const C_ON_ACCENT: u64 = 38

const C_ACCENT_HOVER: u64 = 39

const C_ACCENT_PRESSED: u64 = 40

const M_RADIUS_PANEL: u64 = 1

const M_RADIUS_INPUT: u64 = 3

const M_BORDER: u64 = 4

const M_PAD_X: u64 = 5

const M_PAD_Y: u64 = 6

const M_GAP: u64 = 7

const M_ROW: u64 = 8

const M_CTRL_H: u64 = 9

const M_FOCUS: u64 = 13

const M_SP_XS: u64 = 14

const M_SP_S: u64 = 15

const M_SP_M: u64 = 16

const M_SP_L: u64 = 17

const M_FONT: u64 = 23

const M_MOTION: u64 = 24

const TY_CAPTION: u64 = 0

const TY_TITLE: u64 = 3

const TY_DISPLAY: u64 = 4

const EL_FLAT: u64 = 0

const EL_RAISED: u64 = 1

const EL_OVERLAY: u64 = 2

const EL_MODAL: u64 = 3

const EL_WINDOW: u64 = 4

const GRID: u64 = 4

const HIT_MIN: u64 = 32

const MO_FAST: u64 = 0

const MO_SLOW: u64 = 2

const SHAPE_CLASSIC: u64 = 0

const MODE_LIGHT: u64 = 0

const MODE_DARK: u64 = 1

const HOVER_PCT_LIGHT: u64 = 6

const HOVER_PCT_DARK: u64 = 8

fn bind_neutrals(dark: bool) {
    if !dark {
        if wcbase.sch_high != 0 {
            wcbase.sem[(wcbase.S_SURFACE) as usize] = wcbase.neutral[(wcbase.N_0) as usize]
            wcbase.sem[(wcbase.S_SURFACE_RAISED) as usize] = wcbase.neutral[(wcbase.N_0) as usize]
            wcbase.sem[(wcbase.S_SURFACE_SUNKEN) as usize] = wcbase.neutral[(wcbase.N_0) as usize]
            wcbase.sem[(wcbase.S_SURFACE_HOVER) as usize] = wcbase.neutral[(N_100) as usize]
            wcbase.sem[(wcbase.S_SURFACE_PRESSED) as usize] = wcbase.neutral[(N_200) as usize]
            wcbase.sem[(wcbase.S_CONTROL) as usize] = wcbase.neutral[(N_100) as usize]
            wcbase.sem[(wcbase.S_CONTROL_HOVER) as usize] = wcbase.neutral[(N_200) as usize]
            wcbase.sem[(wcbase.S_CONTROL_PRESSED) as usize] = wcbase.neutral[(N_300) as usize]
            wcbase.sem[(wcbase.S_FIELD) as usize] = wcbase.neutral[(N_100) as usize]
            wcbase.sem[(wcbase.S_TEXT_PRIMARY) as usize] = wcbase.neutral[(wcbase.N_1000) as usize]
            wcbase.sem[(wcbase.S_TEXT_SECONDARY) as usize] = wcbase.neutral[(wcbase.N_1000) as usize]
            wcbase.sem[(S_TEXT_DISABLED) as usize] = wcbase.neutral[(N_500) as usize]
            wcbase.sem[(S_BORDER) as usize] = wcbase.neutral[(wcbase.N_1000) as usize]
            wcbase.sem[(S_BORDER_STRONG) as usize] = wcbase.neutral[(wcbase.N_1000) as usize]
            wcbase.sem[(S_SHADOW) as usize] = wcbase.neutral[(wcbase.N_1000) as usize]
        } else {
            wcbase.sem[(wcbase.S_SURFACE) as usize] = wcbase.neutral[(N_50) as usize]
            wcbase.sem[(wcbase.S_SURFACE_RAISED) as usize] = wcbase.neutral[(wcbase.N_0) as usize]
            wcbase.sem[(wcbase.S_SURFACE_SUNKEN) as usize] = wcbase.neutral[(N_200) as usize]
            wcbase.sem[(wcbase.S_SURFACE_HOVER) as usize] = wcbase.neutral[(N_100) as usize]
            wcbase.sem[(wcbase.S_SURFACE_PRESSED) as usize] = wcbase.neutral[(N_200) as usize]

            wcbase.sem[(wcbase.S_CONTROL) as usize] = wcbase.neutral[(N_200) as usize]

            wcbase.sem[(wcbase.S_CONTROL_HOVER) as usize] = wcpaint.mix(wcbase.neutral[(N_200) as usize], wcbase.neutral[(wcbase.N_900) as usize], HOVER_PCT_LIGHT)
            wcbase.sem[(wcbase.S_CONTROL_PRESSED) as usize] = wcbase.neutral[(N_400) as usize]
            wcbase.sem[(wcbase.S_FIELD) as usize] = wcbase.neutral[(N_100) as usize]
            wcbase.sem[(wcbase.S_TEXT_PRIMARY) as usize] = wcbase.neutral[(wcbase.N_900) as usize]

            wcbase.sem[(wcbase.S_TEXT_SECONDARY) as usize] = wcbase.neutral[(N_600) as usize]
            wcbase.sem[(S_TEXT_DISABLED) as usize] = wcbase.neutral[(N_400) as usize]

            wcbase.sem[(S_BORDER) as usize] = wcbase.neutral[(N_300) as usize]

            wcbase.sem[(S_BORDER_STRONG) as usize] = wcbase.neutral[(N_500) as usize]
            wcbase.sem[(S_SHADOW) as usize] = wcbase.neutral[(N_950) as usize]
        }
    } else {
        if wcbase.sch_high != 0 {
            wcbase.sem[(wcbase.S_SURFACE) as usize] = wcbase.neutral[(wcbase.N_1000) as usize]
            wcbase.sem[(wcbase.S_SURFACE_RAISED) as usize] = wcbase.neutral[(wcbase.N_1000) as usize]
            wcbase.sem[(wcbase.S_SURFACE_SUNKEN) as usize] = wcbase.neutral[(wcbase.N_1000) as usize]
            wcbase.sem[(wcbase.S_SURFACE_HOVER) as usize] = wcbase.neutral[(N_800) as usize]
            wcbase.sem[(wcbase.S_SURFACE_PRESSED) as usize] = wcbase.neutral[(N_700) as usize]
            wcbase.sem[(wcbase.S_CONTROL) as usize] = wcbase.neutral[(N_800) as usize]
            wcbase.sem[(wcbase.S_CONTROL_HOVER) as usize] = wcbase.neutral[(N_700) as usize]
            wcbase.sem[(wcbase.S_CONTROL_PRESSED) as usize] = wcbase.neutral[(N_600) as usize]
            wcbase.sem[(wcbase.S_FIELD) as usize] = wcbase.neutral[(N_800) as usize]
            wcbase.sem[(wcbase.S_TEXT_PRIMARY) as usize] = wcbase.neutral[(wcbase.N_0) as usize]
            wcbase.sem[(wcbase.S_TEXT_SECONDARY) as usize] = wcbase.neutral[(wcbase.N_0) as usize]
            wcbase.sem[(S_TEXT_DISABLED) as usize] = wcbase.neutral[(N_400) as usize]
            wcbase.sem[(S_BORDER) as usize] = wcbase.neutral[(wcbase.N_0) as usize]
            wcbase.sem[(S_BORDER_STRONG) as usize] = wcbase.neutral[(wcbase.N_0) as usize]
            wcbase.sem[(S_SHADOW) as usize] = wcbase.neutral[(wcbase.N_1000) as usize]
        } else {
            wcbase.sem[(wcbase.S_SURFACE) as usize] = wcbase.neutral[(wcbase.N_900) as usize]
            wcbase.sem[(wcbase.S_SURFACE_RAISED) as usize] = wcbase.neutral[(N_800) as usize]
            wcbase.sem[(wcbase.S_SURFACE_SUNKEN) as usize] = wcbase.neutral[(wcbase.N_1000) as usize]

            wcbase.sem[(wcbase.S_SURFACE_HOVER) as usize] = wcpaint.mix(wcbase.neutral[(N_800) as usize], wcbase.neutral[(wcbase.N_0) as usize], HOVER_PCT_DARK)
            wcbase.sem[(wcbase.S_SURFACE_PRESSED) as usize] = wcbase.neutral[(N_600) as usize]

            wcbase.sem[(wcbase.S_CONTROL) as usize] = wcbase.neutral[(N_700) as usize]
            wcbase.sem[(wcbase.S_CONTROL_HOVER) as usize] = wcpaint.mix(wcbase.neutral[(N_700) as usize], wcbase.neutral[(wcbase.N_0) as usize], HOVER_PCT_DARK)
            wcbase.sem[(wcbase.S_CONTROL_PRESSED) as usize] = wcbase.neutral[(N_500) as usize]
            wcbase.sem[(wcbase.S_FIELD) as usize] = wcbase.neutral[(N_950) as usize]
            wcbase.sem[(wcbase.S_TEXT_PRIMARY) as usize] = wcbase.neutral[(N_50) as usize]

            wcbase.sem[(wcbase.S_TEXT_SECONDARY) as usize] = wcbase.neutral[(N_300) as usize]
            wcbase.sem[(S_TEXT_DISABLED) as usize] = wcbase.neutral[(N_600) as usize]
            wcbase.sem[(S_BORDER) as usize] = wcbase.neutral[(N_700) as usize]
            wcbase.sem[(S_BORDER_STRONG) as usize] = wcbase.neutral[(N_500) as usize]
            wcbase.sem[(S_SHADOW) as usize] = wcbase.neutral[(wcbase.N_1000) as usize]
        }
    }
    if dark && wcpal.active() {
        wcpal.bind_surfaces()
    }
}

fn bind_accent(dark: bool) {
    var need_text: u64 = 450
    var need_ui: u64 = 300
    if wcbase.sch_high != 0 {
        need_text = 700
        need_ui = 450
    }
    var start: u64 = A_600
    var up: bool = true
    if dark {
        start = A_400
        up = false
    }
    let bg: u64 = wcbase.sem[(wcbase.S_SURFACE) as usize]
    var idx: u64 = start
    var found: bool = false
    var d: u64 = 0
    while d < wcbase.RAMP_STEPS && !found {
        var k: u64 = 0
        while k < 2 && !found {
            let i: u64 = wcpaint.cand_step(start, up, d, k == 1)
            if i < wcbase.RAMP_STEPS {
                let a: u64 = wcpaint.ramp_at(wcbase.R_ACCENT, i)
                wcpaint.states_of(a)
                if wcpaint.contrast(wcbase.st_on, a) >= need_text
                    && wcpaint.contrast(a, bg) >= need_ui {
                    idx = i
                    found = true
                }
            }
            k = k + 1
        }
        d = d + 1
    }
    if !found {

        var bestscore: u64 = 0
        var i3: u64 = 0
        while i3 < wcbase.RAMP_STEPS {
            let a3: u64 = wcpaint.ramp_at(wcbase.R_ACCENT, i3)
            wcpaint.states_of(a3)
            var t: u64 = (wcpaint.contrast(wcbase.st_on, a3) * 100) / need_text
            var u: u64 = (wcpaint.contrast(a3, bg) * 100) / need_ui
            if t > 100 {
                t = 100
            }
            if u > 100 {
                u = 100
            }
            if t + u > bestscore {
                bestscore = t + u
                idx = i3
            }
            i3 = i3 + 1
        }
    }
    wcbase.acc_ok = 0
    if found {
        wcbase.acc_ok = 1
    }
    wcbase.acc_exact = 0
    if idx == start {
        wcbase.acc_exact = 1
    }
    if idx > start {
        wcbase.acc_moved = idx - start
    } else {
        wcbase.acc_moved = start - idx
    }
    let accent: u64 = wcpaint.ramp_at(wcbase.R_ACCENT, idx)
    wcpaint.states_of(accent)
    wcbase.acc_r_text = wcpaint.contrast(wcbase.st_on, accent)
    wcbase.acc_r_ui = wcpaint.contrast(accent, bg)

    var fbest: u64 = wcpaint.ramp_at(wcbase.R_ACCENT, 0)
    var fr: u64 = wcpaint.contrast(fbest, bg)
    var i4: u64 = 1
    while i4 < wcbase.RAMP_STEPS {
        let r4: u64 = wcpaint.contrast(wcpaint.ramp_at(wcbase.R_ACCENT, i4), bg)
        if r4 > fr {
            fr = r4
            fbest = wcpaint.ramp_at(wcbase.R_ACCENT, i4)
        }
        i4 = i4 + 1
    }

    wcbase.sem[(wcbase.S_ACCENT) as usize] = accent
    wcbase.sem[(wcbase.S_ACCENT_HOVER) as usize] = wcbase.st_hover
    wcbase.sem[(wcbase.S_ACCENT_PRESSED) as usize] = wcbase.st_pressed
    wcbase.sem[(S_ACCENT_DISABLED) as usize] = wcpaint.mix(accent, bg, 65)
    wcbase.sem[(wcbase.S_ON_ACCENT) as usize] = wcbase.st_on
    wcbase.sem[(S_BORDER_FOCUS) as usize] = fbest
    wcbase.sem[(wcbase.S_SELECTION) as usize] = accent
    wcbase.sem[(wcbase.S_ON_SELECTION) as usize] = wcbase.st_on

    if wcbase.sch_high == 0 {
        wcbase.sem[(wcbase.S_SELECTION) as usize] = wcpaint.mix(wcbase.sem[(wcbase.S_SURFACE_RAISED) as usize], accent, 22)
        wcbase.sem[(wcbase.S_ON_SELECTION) as usize] = wcbase.sem[(wcbase.S_TEXT_PRIMARY) as usize]
    }
    wcbase.sem[(wcbase.S_OVERLAY) as usize] = wcbase.sem[(wcbase.S_SURFACE_RAISED) as usize]
    wcbase.sem[(wcbase.S_DANGER) as usize] = wcpaint.fit_status(wcbase.R_DANGER, start, up, need_text)
    wcbase.sem[(wcbase.S_WARNING) as usize] = wcpaint.fit_status(wcbase.R_WARNING, start, up, need_text)
    wcbase.sem[(wcbase.S_SUCCESS) as usize] = wcpaint.fit_status(wcbase.R_SUCCESS, start, up, need_text)
    if dark && wcpal.active() {
        if wcbase.set_accent == 0 {
            wcpal.bind_accent()
        }
        wcpal.bind_status()
    }
}

fn comp_map_init() {
    wcbase.comp_role[(wcbase.C_WINDOW_BG) as usize] = wcbase.S_SURFACE
    wcbase.comp_role[(wcbase.C_WINDOW_TEXT) as usize] = wcbase.S_TEXT_PRIMARY
    wcbase.comp_role[(wcbase.C_TEXT_MUTED) as usize] = wcbase.S_TEXT_SECONDARY
    wcbase.comp_role[(wcbase.C_PANEL_BG) as usize] = wcbase.S_SURFACE_RAISED
    wcbase.comp_role[(C_BUTTON_FACE) as usize] = wcbase.S_CONTROL
    wcbase.comp_role[(C_BUTTON_HOVER) as usize] = wcbase.S_CONTROL_HOVER
    wcbase.comp_role[(C_BUTTON_PRESSED) as usize] = wcbase.S_CONTROL_PRESSED
    wcbase.comp_role[(wcbase.C_BORDER) as usize] = S_BORDER
    wcbase.comp_role[(C_SELECT_BG) as usize] = wcbase.S_SELECTION
    wcbase.comp_role[(C_SELECT_TEXT) as usize] = wcbase.S_ON_SELECTION
    wcbase.comp_role[(C_FOCUS_RING) as usize] = S_BORDER_FOCUS
    wcbase.comp_role[(wcbase.C_INPUT_BG) as usize] = wcbase.S_FIELD
    wcbase.comp_role[(C_HEADER_BG) as usize] = wcbase.S_SURFACE_HOVER
    wcbase.comp_role[(C_SCROLL_TRACK) as usize] = wcbase.S_SURFACE_SUNKEN
    wcbase.comp_role[(C_SCROLL_THUMB) as usize] = S_BORDER_STRONG
    wcbase.comp_role[(wcbase.C_ACCENT) as usize] = wcbase.S_ACCENT
    wcbase.comp_role[(C_DIALOG_BG) as usize] = wcbase.S_OVERLAY
    wcbase.comp_role[(C_MENU_BG) as usize] = wcbase.S_OVERLAY
    wcbase.comp_role[(wcbase.C_TITLEBAR_BG) as usize] = wcbase.S_ACCENT
    wcbase.comp_role[(wcbase.C_TITLEBAR_TEXT) as usize] = wcbase.S_ON_ACCENT
    wcbase.comp_role[(wcbase.C_TITLEBAR_OFF_BG) as usize] = wcbase.S_SURFACE_RAISED
    wcbase.comp_role[(wcbase.C_TITLEBAR_OFF_TEXT) as usize] = wcbase.S_TEXT_SECONDARY
    wcbase.comp_role[(wcbase.C_WINDOW_FRAME) as usize] = S_BORDER_STRONG
    wcbase.comp_role[(C_TASKBAR_BG) as usize] = wcbase.S_SURFACE_RAISED
    wcbase.comp_role[(C_TASKBAR_TEXT) as usize] = wcbase.S_TEXT_PRIMARY
    wcbase.comp_role[(C_TASKBAR_ACTIVE) as usize] = wcbase.S_ACCENT
    wcbase.comp_role[(C_DESKTOP_TOP) as usize] = wcbase.S_SURFACE_SUNKEN
    wcbase.comp_role[(wcbase.C_DESKTOP_BOTTOM) as usize] = wcbase.S_SURFACE
    wcbase.comp_role[(C_BUTTON_TEXT) as usize] = wcbase.S_TEXT_PRIMARY
    wcbase.comp_role[(C_BUTTON_DISABLED_TEXT) as usize] = S_TEXT_DISABLED
    wcbase.comp_role[(C_INPUT_TEXT) as usize] = wcbase.S_TEXT_PRIMARY
    wcbase.comp_role[(C_INPUT_BORDER) as usize] = S_BORDER_STRONG
    wcbase.comp_role[(C_LIST_BG) as usize] = wcbase.S_FIELD
    wcbase.comp_role[(C_MENU_TEXT) as usize] = wcbase.S_TEXT_PRIMARY
    wcbase.comp_role[(wcbase.C_SHADOW) as usize] = S_SHADOW
    wcbase.comp_role[(wcbase.C_DANGER) as usize] = wcbase.S_DANGER
    wcbase.comp_role[(C_WARNING) as usize] = wcbase.S_WARNING
    wcbase.comp_role[(C_SUCCESS) as usize] = wcbase.S_SUCCESS
    wcbase.comp_role[(C_ON_ACCENT) as usize] = wcbase.S_ON_ACCENT
    wcbase.comp_role[(C_ACCENT_HOVER) as usize] = wcbase.S_ACCENT_HOVER
    wcbase.comp_role[(C_ACCENT_PRESSED) as usize] = wcbase.S_ACCENT_PRESSED
}

fn publish() {
    var shadow: u64 = 1
    if wcbase.live == 1 {
        shadow = 0
    }
    let at: u64 = shadow * wcbase.C_COUNT
    var i: u64 = 0
    while i < wcbase.C_COUNT {
        var v: u64 = wcbase.sem[(wcbase.comp_role[(i) as usize]) as usize]
        if wcbase.ovr_on[(i) as usize] != 0 {
            v = wcbase.ovr_val[(i) as usize]
        }
        wcbase.tok[((at + i)) as usize] = v
        i = i + 1
    }
    wcbase.live = shadow
    wcbase.generation = wcbase.generation + 1

    if wcbase.frame_open == 0 {
        wcbase.paint_base = wcbase.live * wcbase.C_COUNT
    }
}

static mut comp_blob: [u8; 474] = "window-bg\0window-text\0text-muted\0panel-bg\0button-face\0button-hover\0button-pressed\0border\0select-bg\0select-text\0focus-ring\0input-bg\0header-bg\0scroll-track\0scroll-thumb\0accent\0dialog-bg\0menu-bg\0titlebar-bg\0titlebar-text\0titlebar-off-bg\0titlebar-off-text\0window-frame\0taskbar-bg\0taskbar-text\0taskbar-active\0desktop-top\0desktop-bottom\0button-text\0button-disabled-text\0input-text\0input-border\0list-bg\0menu-text\0shadow\0danger\0warning\0success\0on-accent\0accent-hover\0accent-pressed\0"

static mut sem_blob: [u8; 310] = "surface\0surface-raised\0surface-sunken\0surface-hover\0surface-pressed\0text-primary\0text-secondary\0text-disabled\0border\0border-strong\0border-focus\0accent\0accent-hover\0accent-pressed\0accent-disabled\0on-accent\0selection\0on-selection\0overlay\0danger\0warning\0success\0shadow\0control\0control-hover\0control-pressed\0field\0"

static mut legacy_blob: [u8; 93] = "bg\0fg\0dim\0panel\0btn\0btnhi\0btndn\0line\0sel\0selfg\0focus\0entry\0head\0scroll\0thumb\0accent\0dlg\0menu\0"

static mut names_ok: u64 = 0

fn blob_index(blob: u64, out: u64, n: u64) {
    var p: u64 = blob
    var i: u64 = 0
    while i < n {
        __mmio_write64((out + i * 8) as *mut u64, p)
        while *((p) as *mut u8) != 0 as u8 {
            p = p + 1
        }
        p = p + 1
        i = i + 1
    }
}

fn names_init() {
    if names_ok != 0 {
        return
    }
    blob_index((&comp_blob[0 as usize]) as u64,
        (&wcbase.comp_at[0 as usize]) as u64, wcbase.C_COUNT)
    blob_index((&sem_blob[0 as usize]) as u64,
        (&wcbase.sem_at[0 as usize]) as u64, wcbase.S_COUNT)
    blob_index((&legacy_blob[0 as usize]) as u64,
        (&wcbase.legacy_at[0 as usize]) as u64, wcbase.T_COUNT)
    names_ok = 1
}

fn name_eq(p: u64, n: u64, q: u64) -> bool {
    var k: u64 = 0
    while k < n {
        let a: u64 = (*((p + k) as *mut u8)) as u64
        let b: u64 = (*((q + k) as *mut u8)) as u64
        if b == 0 || a != b {
            return false
        }
        k = k + 1
    }
    return (*((q + n) as *mut u8)) as u64 == 0
}

fn hex4(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return 16
}

fn parse_hex(p: u64, n: u64) -> u64 {
    var v: u64 = 0
    var digits: u64 = 0
    var k: u64 = 0
    while k < n {
        let d: u64 = hex4((*((p + k) as *mut u8)) as u64)
        if d >= 16 {
            return wcbase.RGB_BAD
        }
        v = (v << 4) | d
        digits = digits + 1
        k = k + 1
    }
    if digits != 6 {
        return wcbase.RGB_BAD
    }
    return v
}

fn parse_dec(p: u64, n: u64) -> u64 {
    var v: u64 = 0
    var digits: u64 = 0
    var k: u64 = 0
    while k < n {
        let c: u64 = (*((p + k) as *mut u8)) as u64
        if c < 48 || c > 57 {
            return wcbase.DEC_BAD
        }
        v = v * 10 + (c - 48)
        digits = digits + 1
        k = k + 1
    }
    if digits == 0 {
        return wcbase.DEC_BAD
    }
    return v
}

fn parse_clock(p: u64, n: u64) -> u64 {
    var h: u64 = 0
    var m: u64 = 0
    var seen: u64 = 0
    var at: u64 = 0
    var k: u64 = 0
    while k < n {
        let c: u64 = (*((p + k) as *mut u8)) as u64
        if c == 58 {
            if at == 1 {
                return wcbase.DEC_BAD
            }
            at = 1
            seen = 0
        } else if c >= 48 && c <= 57 {
            if at == 0 {
                h = h * 10 + (c - 48)
            } else {
                m = m * 10 + (c - 48)
            }
            seen = seen + 1
        } else {
            return wcbase.DEC_BAD
        }
        k = k + 1
    }
    if at != 1 || seen == 0 || h > 23 || m > 59 {
        return wcbase.DEC_BAD
    }
    return h * 60 + m
}

fn neutral_index(step: u64) -> u64 {
    if step == 0 {
        return wcbase.N_0
    }
    if step == 50 {
        return N_50
    }
    if step == 100 {
        return N_100
    }
    if step == 200 {
        return N_200
    }
    if step == 300 {
        return N_300
    }
    if step == 400 {
        return N_400
    }
    if step == 500 {
        return N_500
    }
    if step == 600 {
        return N_600
    }
    if step == 700 {
        return N_700
    }
    if step == 800 {
        return N_800
    }
    if step == 900 {
        return wcbase.N_900
    }
    if step == 950 {
        return N_950
    }
    if step == 1000 {
        return wcbase.N_1000
    }
    return wcbase.NEUTRAL_STEPS
}

fn copy_bounded(dst: u64, src: u64, n: u64, max: u64) {
    var k: u64 = 0
    while k < n && k + 1 < max {
        __mmio_write8((dst + k) as *mut u8, *((src + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((dst + k) as *mut u8, 0 as u8)
}

fn scheme_key(kp: u64, kn: u64, vp: u64, vn: u64) -> bool {
    var k_name: [u8; 5] = "name\0"
    var k_mode: [u8; 5] = "mode\0"
    var k_shadow: [u8; 7] = "shadow\0"
    var k_contrast: [u8; 9] = "contrast\0"
    var k_palette: [u8; 8] = "palette\0"
    var k_accent: [u8; 7] = "accent\0"
    var k_danger: [u8; 7] = "danger\0"
    var k_warning: [u8; 8] = "warning\0"
    var k_success: [u8; 8] = "success\0"
    var k_neutral: [u8; 8] = "neutral\0"
    var v_dark: [u8; 5] = "dark\0"
    var v_high: [u8; 5] = "high\0"
    var v_own: [u8; 4] = "own\0"

    if name_eq(kp, kn, (&k_name[0 as usize]) as u64) {
        copy_bounded((&wcbase.sch_name[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    if name_eq(kp, kn, (&k_shadow[0 as usize]) as u64) {
        var v_on: [u8; 3] = "on\0"
        var v_eins: [u8; 2] = "1\0"
        wcbase.set_shadow = wcbase.SHDW_OFF
        if name_eq(vp, vn, (&v_on[0 as usize]) as u64)
            || name_eq(vp, vn, (&v_eins[0 as usize]) as u64) {
            wcbase.set_shadow = wcbase.SHDW_AN
        }
        return true
    }
    if name_eq(kp, kn, (&k_mode[0 as usize]) as u64) {
        wcbase.sch_mode = MODE_LIGHT
        if name_eq(vp, vn, (&v_dark[0 as usize]) as u64) {
            wcbase.sch_mode = MODE_DARK
        }
        return true
    }
    if name_eq(kp, kn, (&k_palette[0 as usize]) as u64) {
        wcbase.sch_pal = 1
        if name_eq(vp, vn, (&v_own[0 as usize]) as u64) {
            wcbase.sch_pal = 0
        }
        return true
    }
    if name_eq(kp, kn, (&k_contrast[0 as usize]) as u64) {
        wcbase.sch_high = 0
        if name_eq(vp, vn, (&v_high[0 as usize]) as u64) {
            wcbase.sch_high = 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_accent[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == wcbase.RGB_BAD {
            return false
        }
        wcbase.sch_accent = v
        return true
    }
    if name_eq(kp, kn, (&k_danger[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == wcbase.RGB_BAD {
            return false
        }
        wcbase.sch_danger = v
        return true
    }
    if name_eq(kp, kn, (&k_warning[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == wcbase.RGB_BAD {
            return false
        }
        wcbase.sch_warning = v
        return true
    }
    if name_eq(kp, kn, (&k_success[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == wcbase.RGB_BAD {
            return false
        }
        wcbase.sch_success = v
        return true
    }

    if kn > 7 {
        if name_eq(kp, 7, (&k_neutral[0 as usize]) as u64) {
            let step: u64 = parse_dec(kp + 7, kn - 7)
            if step == wcbase.DEC_BAD {
                return false
            }
            let idx: u64 = neutral_index(step)
            if idx >= wcbase.NEUTRAL_STEPS {
                return false
            }
            let v: u64 = parse_hex(vp, vn)
            if v == wcbase.RGB_BAD {
                return false
            }
            wcbase.neutral[(idx) as usize] = v
            return true
        }
    }
    return false
}

fn conf_key(kp: u64, kn: u64, vp: u64, vn: u64) -> bool {
    var k_scheme: [u8; 7] = "scheme\0"
    var k_dscheme: [u8; 12] = "dark_scheme\0"
    var k_shape: [u8; 6] = "shape\0"
    var k_mode: [u8; 5] = "mode\0"
    var k_accent: [u8; 7] = "accent\0"
    var k_ls: [u8; 12] = "light_start\0"
    var k_ds: [u8; 11] = "dark_start\0"

    var k_shd: [u8; 7] = "shadow\0"
    if name_eq(kp, kn, (&k_shd[0 as usize]) as u64) {
        var v_on2: [u8; 3] = "on\0"
        var v_eins2: [u8; 2] = "1\0"
        wcbase.set_shadow = wcbase.SHDW_OFF
        if name_eq(vp, vn, (&v_on2[0 as usize]) as u64)
            || name_eq(vp, vn, (&v_eins2[0 as usize]) as u64) {
            wcbase.set_shadow = wcbase.SHDW_AN
        }
        return true
    }
    var k_lift: [u8; 5] = "lift\0"
    var k_tilt: [u8; 5] = "tilt\0"
    var k_swing: [u8; 6] = "swing\0"
    var k_blur: [u8; 5] = "blur\0"
    var k_trans: [u8; 13] = "transparency\0"
    var v_toff: [u8; 4] = "off\0"
    var v_tsub: [u8; 7] = "subtle\0"
    var v_tstr: [u8; 7] = "strong\0"
    var k_btint: [u8; 10] = "blur_tint\0"
    var k_bnoise: [u8; 11] = "blur_noise\0"
    var k_rad: [u8; 7] = "radius\0"
    var k_tba: [u8; 14] = "taskbar_alpha\0"
    var k_wa: [u8; 13] = "window_alpha\0"
    var k_aaold: [u8; 7] = "aa_old\0"
    var v_dark: [u8; 5] = "dark\0"
    var v_light: [u8; 6] = "light\0"

    if name_eq(kp, kn, (&k_scheme[0 as usize]) as u64) {
        copy_bounded((&wcbase.sch_file[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    if name_eq(kp, kn, (&k_dscheme[0 as usize]) as u64) {
        copy_bounded((&wcbase.sch_dark_file[0 as usize]) as u64, vp, vn, 32)
        return true
    }

    if name_eq(kp, kn, (&k_shape[0 as usize]) as u64) {
        copy_bounded((&wcbase.shp_file[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    if name_eq(kp, kn, (&k_mode[0 as usize]) as u64) {
        wcbase.set_mode = wcbase.MODE_AUTO
        if name_eq(vp, vn, (&v_dark[0 as usize]) as u64) {
            wcbase.set_mode = MODE_DARK
        }
        if name_eq(vp, vn, (&v_light[0 as usize]) as u64) {
            wcbase.set_mode = MODE_LIGHT
        }
        return true
    }
    if name_eq(kp, kn, (&k_lift[0 as usize]) as u64) {
        let v: u64 = parse_dec(vp, vn)
        if v != wcbase.DEC_BAD && v <= 120 {
            wcbase.ovr_lift = v + 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_tilt[0 as usize]) as u64) {
        let v: u64 = parse_dec(vp, vn)
        if v != wcbase.DEC_BAD && v <= 100 {
            wcbase.ovr_tilt = v + 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_swing[0 as usize]) as u64) {
        let v: u64 = parse_dec(vp, vn)
        if v != wcbase.DEC_BAD && v <= 100 {
            wcbase.ovr_swing = v + 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_trans[0 as usize]) as u64) {
        if name_eq(vp, vn, (&v_toff[0 as usize]) as u64) {
            wcbase.fx_mode = TRANS_OFF
        } else if name_eq(vp, vn, (&v_tsub[0 as usize]) as u64) {
            wcbase.fx_mode = wcbase.TRANS_SUBTLE
        } else if name_eq(vp, vn, (&v_tstr[0 as usize]) as u64) {
            wcbase.fx_mode = wcbase.TRANS_STRONG
        }
        return true
    }
    if name_eq(kp, kn, (&k_blur[0 as usize]) as u64) {
        let v: u64 = parse_dec(vp, vn)
        if v != wcbase.DEC_BAD && v <= 16 {
            wcbase.ovr_blur = v + 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_btint[0 as usize]) as u64) {
        let v: u64 = parse_dec(vp, vn)
        if v != wcbase.DEC_BAD && v <= 100 {
            wcbase.ovr_btint = v + 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_bnoise[0 as usize]) as u64) {
        let v: u64 = parse_dec(vp, vn)
        if v != wcbase.DEC_BAD && v <= 16 {
            wcbase.ovr_bnoise = v + 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_accent[0 as usize]) as u64) {
        if vn == 0 {
            wcbase.set_accent = 0
            return true
        }
        let v: u64 = parse_hex(vp, vn)
        if v == wcbase.RGB_BAD {
            return false
        }
        wcbase.set_accent = v
        if v == 0 {
            wcbase.set_accent = wcbase.ACCENT_BLACK
        }
        return true
    }
    if name_eq(kp, kn, (&k_ls[0 as usize]) as u64) {
        let v: u64 = parse_clock(vp, vn)
        if v == wcbase.DEC_BAD {
            return false
        }
        wcbase.set_light_min = v
        return true
    }
    if name_eq(kp, kn, (&k_ds[0 as usize]) as u64) {
        let v: u64 = parse_clock(vp, vn)
        if v == wcbase.DEC_BAD {
            return false
        }
        wcbase.set_dark_min = v
        return true
    }
    if name_eq(kp, kn, (&k_rad[0 as usize]) as u64) {
        let r: u64 = parse_dec(vp, vn)
        if r == wcbase.DEC_BAD {
            return false
        }
        wcbase.usr_radius = cap(r, wcbase.RADIUS_MAX)
        glas_metrics()
        return true
    }
    if name_eq(kp, kn, (&k_tba[0 as usize]) as u64) {
        let a: u64 = parse_dec(vp, vn)
        if a == wcbase.DEC_BAD {
            return false
        }
        wcbase.usr_tba = clamp_alpha(a)
        glas_metrics()
        return true
    }
    if name_eq(kp, kn, (&k_wa[0 as usize]) as u64) {
        let a2: u64 = parse_dec(vp, vn)
        if a2 == wcbase.DEC_BAD {
            return false
        }
        wcbase.usr_wa = clamp_alpha(a2)
        glas_metrics()
        return true
    }

    if name_eq(kp, kn, (&k_aaold[0 as usize]) as u64) {
        let ao: u64 = parse_dec(vp, vn)
        if ao == wcbase.DEC_BAD {
            return false
        }
        wcbase.aa_old_rim = ao != 0
        return true
    }
    return false
}

fn local_minutes() -> u64 {
    let h: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_HOUR, 0, 0)
    let m: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_MIN, 0, 0)
    if ulib.bad(h) || ulib.bad(m) {
        return 1441
    }
    return ((h * 60 + m) + wcbase.tz_offset) % 1440
}

fn auto_is_dark() -> bool {
    let t: u64 = local_minutes()
    if t > 1440 {
        return wcbase.sch_mode == MODE_DARK
    }
    if wcbase.set_dark_min > wcbase.set_light_min {
        return t >= wcbase.set_dark_min || t < wcbase.set_light_min
    }
    return t >= wcbase.set_dark_min && t < wcbase.set_light_min
}

fn effective_dark() -> bool {
    if wcbase.set_mode == MODE_LIGHT {
        return false
    }
    if wcbase.set_mode == MODE_DARK {
        return true
    }
    return auto_is_dark()
}

fn primitives_builtin() {
    wcpal.primitives_builtin()
    wcbase.sch_mode = MODE_DARK
    wcbase.sch_high = 0
    wcbase.sch_pal = 1
}

fn path_join(dir: u64, name: u64, out: u64, max: u64) {
    var at: u64 = 0
    var k: u64 = 0
    while *((dir + k) as *mut u8) != 0 as u8 && at + 1 < max {
        __mmio_write8((out + at) as *mut u8, *((dir + k) as *mut u8))
        at = at + 1
        k = k + 1
    }
    k = 0
    while *((name + k) as *mut u8) != 0 as u8 && at + 1 < max {
        __mmio_write8((out + at) as *mut u8, *((name + k) as *mut u8))
        at = at + 1
        k = k + 1
    }
    __mmio_write8((out + at) as *mut u8, 0 as u8)
}

fn metrics_classic() {
    wcbase.met[(wcbase.M_RADIUS_WINDOW) as usize] = 0
    wcbase.met[(M_RADIUS_PANEL) as usize] = 0
    wcbase.met[(wcbase.M_RADIUS_BUTTON) as usize] = 0
    wcbase.met[(M_RADIUS_INPUT) as usize] = 0
    wcbase.met[(M_BORDER) as usize] = 1
    wcbase.met[(M_PAD_X) as usize] = 12
    wcbase.met[(M_PAD_Y) as usize] = 4
    wcbase.met[(M_GAP) as usize] = 8
    wcbase.met[(M_ROW) as usize] = 20
    wcbase.met[(M_CTRL_H) as usize] = 26
    wcbase.met[(wcbase.M_SHADOW) as usize] = 0
    wcbase.met[(wcbase.M_SHADOW_R) as usize] = 0
    wcbase.met[(wcbase.M_DIVIDER) as usize] = 100
    wcbase.met[(M_FOCUS) as usize] = 1

    wcbase.met[(M_SP_XS) as usize] = 2
    wcbase.met[(M_SP_S) as usize] = 6
    wcbase.met[(M_SP_M) as usize] = 10
    wcbase.met[(M_SP_L) as usize] = 12
    wcbase.met[(wcbase.M_GRAD) as usize] = 0
    wcbase.met[(wcbase.M_TONE) as usize] = 100
    wcbase.met[(wcbase.M_SHADOW2) as usize] = 0
    wcbase.met[(wcbase.M_SHADOW_R2) as usize] = 0
    wcbase.met[(wcbase.M_CAPTION) as usize] = 0
    wcbase.met[(wcbase.M_TITLE_BAR) as usize] = 0
    wcbase.met[(wcbase.M_CAP_W) as usize] = 0
    wcbase.met[(wcbase.M_FRAME) as usize] = 0
    wcbase.met[(wcbase.M_TERM_PAD) as usize] = 0
    wcbase.met[(M_FONT) as usize] = uiscale.PX_UI0
    wcbase.met[(M_MOTION) as usize] = 0
    wcbase.met[(wcbase.M_LIFT) as usize] = 0
    wcbase.met[(wcbase.M_TILT) as usize] = 0
    wcbase.met[(wcbase.M_SWING) as usize] = 0
    wcbase.met[(wcbase.M_BLUR) as usize] = 0
    wcbase.met[(wcbase.M_BLURTINT) as usize] = 0
    wcbase.met[(wcbase.M_BLURNOISE) as usize] = 0
    wcbase.met[(wcbase.M_TB_ALPHA) as usize] = 100
    wcbase.met[(wcbase.M_WIN_ALPHA) as usize] = 100
    wcbase.shp_id = SHAPE_CLASSIC
}

const ALPHA_MIN: u64 = 20

fn clamp_alpha(v: u64) -> u64 {
    if v > 100 {
        return 100
    }
    if v < ALPHA_MIN {
        return ALPHA_MIN
    }
    return v
}

fn glas_metrics() {
    if wcbase.usr_radius != wcbase.RAD_NONE {
        let r: u64 = cap(wcbase.usr_radius, wcbase.RADIUS_MAX)
        wcbase.met[(wcbase.M_RADIUS_WINDOW) as usize] = r
        wcbase.met[(M_RADIUS_PANEL) as usize] = r
        wcbase.met[(wcbase.M_RADIUS_BUTTON) as usize] = r
        wcbase.met[(M_RADIUS_INPUT) as usize] = r
    }
    wcbase.met[(wcbase.M_TB_ALPHA) as usize] = clamp_alpha(wcbase.usr_tba)
    wcbase.met[(wcbase.M_WIN_ALPHA) as usize] = clamp_alpha(wcbase.usr_wa)
}

fn radius() -> u64 {
    return cap(wcbase.met[(wcbase.M_RADIUS_WINDOW) as usize], wcbase.RADIUS_MAX)
}

fn aa_old() -> bool {
    return wcbase.aa_old_rim
}

fn win_round(w: u64, h: u64) -> u64 {
    var r: u64 = radius()
    if r * 2 > w {
        r = w / 2
    }
    if r * 2 > h {
        r = h / 2
    }
    return r
}

fn win_alpha() -> u64 {
    return wcbase.met[(wcbase.M_WIN_ALPHA) as usize]
}

const TRANS_OFF: u64 = 0

const FX_SUBTLE_BLUR: u64 = 12

const FX_SUBTLE_TINT: u64 = 58

const FX_SUBTLE_RIM: u64 = 28

fn transparency() -> u64 {
    return wcbase.fx_mode
}

fn fx_rim() -> u64 {
    if wcbase.fx_mode == wcbase.TRANS_SUBTLE {
        return FX_SUBTLE_RIM
    }
    return 0
}

fn win_alpha_fx() -> u64 {
    return fx_alpha(wcbase.met[(wcbase.M_WIN_ALPHA) as usize], wcbase.FX_SUBTLE_WIN)
}

fn fx_blur(raw: u64) -> u64 {
    if wcbase.fx_mode == TRANS_OFF {
        return 0
    }
    if wcbase.fx_mode == wcbase.TRANS_SUBTLE {
        return FX_SUBTLE_BLUR
    }
    return raw
}

fn fx_tint(raw: u64) -> u64 {
    if wcbase.fx_mode == TRANS_OFF {
        return 0
    }
    if wcbase.fx_mode == wcbase.TRANS_SUBTLE {
        return FX_SUBTLE_TINT
    }
    return raw
}

fn fx_noise(raw: u64) -> u64 {
    if wcbase.fx_mode == wcbase.TRANS_STRONG {
        return raw
    }
    return 0
}

fn fx_alpha(raw: u64, subtle: u64) -> u64 {
    if wcbase.fx_mode == TRANS_OFF {
        return 100
    }
    if wcbase.fx_mode == wcbase.TRANS_SUBTLE {
        return subtle
    }
    return raw
}

fn type_base() -> u64 {
    let v: u64 = wcbase.met[(M_FONT) as usize]
    if v == 0 {
        return uiscale.PX_UI0 * uiscale.ui_scale()
    }
    return v * uiscale.ui_scale()
}

fn type_px(rolle: u64) -> u64 {
    let b: u64 = type_base()
    let k: u64 = uiscale.ui_scale()
    if rolle == TY_CAPTION {
        if b <= 13 * k {
            return b
        }
        return b - 3 * k
    }
    if rolle == TY_TITLE {
        return b + 3 * k
    }
    if rolle == TY_DISPLAY {
        return b + 9 * k
    }
    return b
}

fn type_lh(rolle: u64) -> u64 {
    let px: u64 = type_px(rolle)
    return snap_up(px * 4 / 3)
}

fn elev_strength(level: u64) -> u64 {
    let s: u64 = wcbase.met[(wcbase.M_SHADOW) as usize]
    if s == 0 || level == EL_FLAT {
        return 0
    }
    if level == EL_RAISED {
        return s / 2
    }
    if level == EL_OVERLAY {
        return s * 3 / 4
    }
    return s
}

fn elev_reach(level: u64) -> u64 {
    let r: u64 = metric(wcbase.M_SHADOW_R)
    if r == 0 || level == EL_FLAT {
        return 0
    }
    if level == EL_RAISED {
        var h: u64 = r / 2
        if h == 0 {
            h = 1
        }
        return h
    }
    if level == EL_OVERLAY {
        var q: u64 = r * 3 / 4
        if q == 0 {
            q = 1
        }
        return q
    }
    return r
}

fn elev_radius(level: u64) -> u64 {
    if level == EL_WINDOW {
        return metric(wcbase.M_RADIUS_WINDOW)
    }
    if level == EL_MODAL {
        return metric(M_RADIUS_PANEL)
    }
    if level == EL_OVERLAY {
        return metric(M_RADIUS_PANEL)
    }
    if level == EL_RAISED {
        return metric(M_RADIUS_PANEL)
    }
    return 0
}

fn grid() -> u64 {
    return GRID * uiscale.ui_scale()
}

fn snap(v: u64) -> u64 {
    let g: u64 = grid()
    if g == 0 {
        return v
    }
    return (v + g / 2) / g * g
}

fn snap_up(v: u64) -> u64 {
    let g: u64 = grid()
    if g == 0 {
        return v
    }
    return (v + g - 1) / g * g
}

fn hit_min() -> u64 {
    return HIT_MIN * uiscale.ui_scale()
}

fn motion(level: u64) -> u64 {
    let m: u64 = wcbase.met[(M_MOTION) as usize]
    if m == 0 {
        return 0
    }
    if level == MO_FAST {
        return m * 3 / 4
    }
    if level == MO_SLOW {
        return m * 5 / 4
    }
    return m
}

fn metric_is_len(i: u64) -> bool {
    if i == wcbase.M_SHADOW || i == wcbase.M_SHADOW2 || i == wcbase.M_DIVIDER {
        return false
    }
    if i == wcbase.M_TONE || i == wcbase.M_GRAD {
        return false
    }
    if i == wcbase.M_TB_ALPHA || i == wcbase.M_WIN_ALPHA || i == wcbase.M_BLUR {
        return false
    }
    return true
}

fn metric(i: u64) -> u64 {
    if i >= wcbase.M_COUNT {
        return 0
    }
    let v: u64 = wcbase.met[(i) as usize]
    if v != 0 && metric_is_len(i) {
        return v * uiscale.ui_scale()
    }
    return v
}

fn shape_name() -> u64 {
    return (&wcbase.shp_name[0 as usize]) as u64
}

fn shape_file() -> u64 {
    return (&wcbase.shp_file[0 as usize]) as u64
}

fn shape_keys() -> u64 {
    return wcbase.shp_keys
}

fn shape_id() -> u64 {
    return wcbase.shp_id
}

fn shape_key(kp: u64, kn: u64, vp: u64, vn: u64) -> bool {
    var k_name: [u8; 5] = "name␀"
    var k_rw: [u8; 14] = "radius_window␀"
    var k_rp: [u8; 13] = "radius_panel␀"
    var k_rb: [u8; 14] = "radius_button␀"
    var k_ri: [u8; 13] = "radius_input␀"
    var k_bo: [u8; 7] = "border␀"
    var k_px: [u8; 6] = "pad_x␀"
    var k_py: [u8; 6] = "pad_y␀"
    var k_ga: [u8; 4] = "gap␀"
    var k_ro: [u8; 4] = "row␀"
    var k_ch: [u8; 7] = "ctrl_h␀"
    var k_sh: [u8; 7] = "shadow␀"
    var k_sr: [u8; 9] = "shadow_r␀"
    var k_dv: [u8; 8] = "divider␀"
    var k_fo: [u8; 6] = "focus␀"
    var k_xs: [u8; 11] = "spacing_xs␀"
    var k_ss: [u8; 10] = "spacing_s␀"
    var k_sm: [u8; 10] = "spacing_m␀"
    var k_sl: [u8; 10] = "spacing_l␀"
    var k_gr: [u8; 5] = "grad␀"
    var k_to: [u8; 5] = "tone␀"
    var k_s2: [u8; 11] = "shadow_off␀"
    var k_r2: [u8; 13] = "shadow_off_r␀"
    var k_cp: [u8; 8] = "caption␀"
    var k_tb: [u8; 10] = "title_bar\0"
    var k_cw: [u8; 6] = "cap_w\0"
    var k_fr: [u8; 6] = "frame\0"
    var k_tp: [u8; 9] = "term_pad\0"
    var k_ft: [u8; 5] = "font␀"
    var k_mo: [u8; 7] = "motion␀"
    var k_li: [u8; 5] = "lift␀"
    var k_ti: [u8; 5] = "tilt␀"
    var k_sw: [u8; 6] = "swing␀"
    var k_bl: [u8; 5] = "blur␀"
    var k_bt: [u8; 10] = "blur_tint␀"
    var k_bn: [u8; 11] = "blur_noise␀"
    if name_eq(kp, kn, (&k_name[0 as usize]) as u64) {
        copy_bounded((&wcbase.shp_name[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    let v: u64 = parse_dec(vp, vn)
    if v == wcbase.DEC_BAD {
        return false
    }
    if name_eq(kp, kn, (&k_rw[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_RADIUS_WINDOW) as usize] = cap(v, wcbase.RADIUS_MAX)
        return true
    }
    if name_eq(kp, kn, (&k_rp[0 as usize]) as u64) {
        wcbase.met[(M_RADIUS_PANEL) as usize] = cap(v, wcbase.RADIUS_MAX)
        return true
    }
    if name_eq(kp, kn, (&k_rb[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_RADIUS_BUTTON) as usize] = cap(v, wcbase.RADIUS_MAX)
        return true
    }
    if name_eq(kp, kn, (&k_ri[0 as usize]) as u64) {
        wcbase.met[(M_RADIUS_INPUT) as usize] = cap(v, wcbase.RADIUS_MAX)
        return true
    }
    if name_eq(kp, kn, (&k_bo[0 as usize]) as u64) {
        wcbase.met[(M_BORDER) as usize] = cap(v, 4)
        return true
    }
    if name_eq(kp, kn, (&k_px[0 as usize]) as u64) {
        wcbase.met[(M_PAD_X) as usize] = cap(v, 32)
        return true
    }
    if name_eq(kp, kn, (&k_py[0 as usize]) as u64) {
        wcbase.met[(M_PAD_Y) as usize] = cap(v, 32)
        return true
    }
    if name_eq(kp, kn, (&k_ga[0 as usize]) as u64) {
        wcbase.met[(M_GAP) as usize] = cap(v, 32)
        return true
    }
    if name_eq(kp, kn, (&k_ro[0 as usize]) as u64) {
        wcbase.met[(M_ROW) as usize] = cap(v, 48)
        return true
    }
    if name_eq(kp, kn, (&k_ch[0 as usize]) as u64) {
        wcbase.met[(M_CTRL_H) as usize] = cap(v, 48)
        return true
    }
    if name_eq(kp, kn, (&k_sh[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_SHADOW) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_sr[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_SHADOW_R) as usize] = cap(v, 16)
        return true
    }
    if name_eq(kp, kn, (&k_dv[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_DIVIDER) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_fo[0 as usize]) as u64) {
        wcbase.met[(M_FOCUS) as usize] = cap(v, 4)
        return true
    }
    if name_eq(kp, kn, (&k_xs[0 as usize]) as u64) {
        wcbase.met[(M_SP_XS) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_ss[0 as usize]) as u64) {
        wcbase.met[(M_SP_S) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_sm[0 as usize]) as u64) {
        wcbase.met[(M_SP_M) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_sl[0 as usize]) as u64) {
        wcbase.met[(M_SP_L) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_gr[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_GRAD) as usize] = cap(v, 24)
        return true
    }
    if name_eq(kp, kn, (&k_to[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_TONE) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_s2[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_SHADOW2) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_r2[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_SHADOW_R2) as usize] = cap(v, 16)
        return true
    }
    if name_eq(kp, kn, (&k_cp[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_CAPTION) as usize] = cap(v, 1)
        return true
    }

    if name_eq(kp, kn, (&k_tb[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_TITLE_BAR) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_cw[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_CAP_W) as usize] = cap(v, 120)
        return true
    }
    if name_eq(kp, kn, (&k_fr[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_FRAME) as usize] = cap(v, 4)
        return true
    }
    if name_eq(kp, kn, (&k_tp[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_TERM_PAD) as usize] = cap(v, 24)
        return true
    }
    if name_eq(kp, kn, (&k_ft[0 as usize]) as u64) {
        var f: u64 = cap(v, 32)
        if f < 10 {
            f = 10
        }
        wcbase.met[(M_FONT) as usize] = f
        return true
    }
    if name_eq(kp, kn, (&k_mo[0 as usize]) as u64) {
        wcbase.met[(M_MOTION) as usize] = cap(v, 400)
        return true
    }
    if name_eq(kp, kn, (&k_li[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_LIFT) as usize] = cap(v, 120)
        return true
    }
    if name_eq(kp, kn, (&k_ti[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_TILT) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_sw[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_SWING) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_bl[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_BLUR) as usize] = cap(v, 16)
        return true
    }
    if name_eq(kp, kn, (&k_bt[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_BLURTINT) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_bn[0 as usize]) as u64) {
        wcbase.met[(wcbase.M_BLURNOISE) as usize] = cap(v, 16)
        return true
    }
    return false
}

fn space(i: u64) -> u64 {
    if i > 3 {
        return 0
    }
    return metric(M_SP_XS + i)
}

fn shade(c: u64, d: u64) -> u64 {
    var r: u64 = (c >> 16) & 255
    var g: u64 = (c >> 8) & 255
    var b: u64 = c & 255
    if r > d {
        r = r - d
    } else {
        r = 0
    }
    if g > d {
        g = g - d
    } else {
        g = 0
    }
    if b > d {
        b = b - d
    } else {
        b = 0
    }
    return (r << 16) | (g << 8) | b
}

fn grad_room(c: u64, want: u64) -> u64 {
    var m: u64 = (c >> 16) & 255
    let g: u64 = (c >> 8) & 255
    let b: u64 = c & 255
    if g < m {
        m = g
    }
    if b < m {
        m = b
    }
    if want > m {
        return m
    }
    return want
}

fn cap(v: u64, hi: u64) -> u64 {
    if v > hi {
        return hi
    }
    return v
}

static mut flaky_left: u64 = 0

static mut flaky_seen: u64 = 0

fn conf_flaky() -> bool {
    if flaky_seen == 0 {
        flaky_seen = 1
        var p_fl: [u8; 16] = "/etc/themeflaky\0"
        var b_fl: [u8; 4] = [0 as u8; 4]
        let fd_fl: u64 = io.open((&p_fl[0 as usize]) as u64, 0)
        if !ulib.bad(fd_fl) {
            let r_fl: u64 = io.read(fd_fl, (&b_fl[0 as usize]) as u64, 1)
            io.close(fd_fl)
            if !ulib.bad(r_fl) && r_fl == 1 && b_fl[0] >= 48 && b_fl[0] <= 57 {
                flaky_left = (b_fl[0] as u64) - 48
            }
        }
    }
    if flaky_left > 0 {
        flaky_left = flaky_left - 1
        return true
    }
    return false
}

fn conf_read_into(dst: u64) -> u64 {
    if conf_flaky() {
        return 0
    }
    var p_conf: [u8; 16] = "/etc/theme.conf\0"
    let fd: u64 = io.open((&p_conf[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return 0
    }
    var n: u64 = 0
    var more: bool = true
    while more && n < 4095 {
        let r: u64 = io.read(fd, dst + n, 4095 - n)
        if ulib.bad(r) || r == 0 {
            more = false
        } else {
            n = n + r
        }
    }
    io.close(fd)
    return n
}

fn conf_fetch() -> u64 {
    var n: u64 = 0
    var tries: u64 = 0
    while tries < 3 {
        n = conf_read_into((&wcbase.conf_copy[0 as usize]) as u64)
        if n > 0 {
            tries = 3
        } else {
            tries = tries + 1
        }
    }
    wcbase.conf_len = n
    return n
}

fn conf_changed() -> bool {
    var buf: [u8; 4096] = [0 as u8; 4096]
    let n: u64 = conf_read_into((&buf[0 as usize]) as u64)
    var same: bool = n == wcbase.conf_len
    if same {
        var k: u64 = 0
        while k < n {
            if buf[(k) as usize] != wcbase.conf_copy[(k) as usize] {
                same = false
                k = n
            } else {
                k = k + 1
            }
        }
    }
    if same {
        return false
    }
    var k2: u64 = 0
    while k2 < n {
        wcbase.conf_copy[(k2) as usize] = buf[(k2) as usize]
        k2 = k2 + 1
    }
    wcbase.conf_len = n
    return true
}

const CONF_POLL_TICKS: u64 = 50

static mut conf_poll_at: u64 = 0xFFFFFFFFFFFF

fn conf_due() -> bool {
    let now: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    if ulib.bad(now) {
        return true
    }
    if conf_poll_at != 0xFFFFFFFFFFFF && now >= conf_poll_at && now - conf_poll_at < CONF_POLL_TICKS {
        return false
    }
    conf_poll_at = now
    return true
}

fn win_state(h: u64, was: u64, value: u64) -> u64 {
    return wcpaint.sys3w(WM_STATE, h, was, value)
}

fn win_list(cur_space: u64, aus: u64) -> u64 {
    return wcpaint.sys3w(WM_LIST, cur_space, aus, WL_BYTES)
}

fn win_app(h: u64, name: u64) -> u64 {
    return wcpaint.sys3w(WM_APP, h, name, text.length(name) + 1)
}

fn win_title(h: u64, text: u64) -> u64 {
    return wcpaint.sys3w(WM_TITLE, h, text, text.length(text) + 1)
}

fn win_act(id: u64, was: u64) -> u64 {
    return wcpaint.sys3w(WM_ACT, id, was, 0)
}

fn win_minrect(id: u64, x: u64, y: u64, w: u64, h: u64) -> u64 {
    return wcpaint.sys3w(WM_MINRECT, id,
        (x & 0xFFFFFFFF) | ((y & 0xFFFFFFFF) << 32),
        (w & 0xFFFFFFFF) | ((h & 0xFFFFFFFF) << 32))
}

fn win_strut(h: u64, edge: u64, size: u64) -> u64 {
    let rc: u64 = wcpaint.sys3w(WM_STRUT, h, edge, size)
    if !ulib.bad(rc) {
        s_panel = 1
    }
    return rc
}

fn win_move(h: u64, x: u64, y: u64) -> u64 {
    return wcpaint.sys3w(WM_MOVE, h, (x << 16) | y, 0)
}

fn win_size(h: u64, w: u64, hh: u64) -> u64 {
    return wcpaint.sys3w(WM_SIZE, h, (w << 16) | hh, 0)
}

fn win_max(h: u64, on: bool) -> u64 {
    var v: u64 = 0
    if on {
        v = 1
    }
    return wcpaint.sys3w(WM_STATE, h, WS_MAXIMIZED, v)
}

fn win_info(h: u64, field: u64) -> u64 {
    return wcpaint.sys3w(wcbase.WM_INFO, h, field, 0)
}
