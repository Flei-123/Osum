fn theme_name_at(i: u64) -> u64 {
    wcgfx.names_init()
    if i >= wcbase.C_COUNT {
        return 0
    }
    return wcbase.comp_at[(i) as usize]
}

fn theme_semantic_name_at(i: u64) -> u64 {
    wcgfx.names_init()
    if i >= wcbase.S_COUNT {
        return 0
    }
    return wcbase.sem_at[(i) as usize]
}

fn theme_named(p: u64, n: u64) -> u64 {
    wcgfx.names_init()
    var i: u64 = 0
    while i < wcbase.C_COUNT {
        if wcgfx.name_eq(p, n, wcbase.comp_at[(i) as usize]) {
            return i
        }
        i = i + 1
    }
    var j: u64 = 0
    while j < wcbase.T_COUNT {
        if wcgfx.name_eq(p, n, wcbase.legacy_at[(j) as usize]) {
            return j
        }
        j = j + 1
    }
    return wcbase.C_COUNT
}

fn set_shadow_on(on: bool) {
    if on {
        wcbase.set_shadow = wcbase.SHDW_AN
    } else {
        wcbase.set_shadow = wcbase.SHDW_OFF
    }
    let _n: u64 = form_push()
}

fn kv_read(path: u64, which: u64) -> u64 {
    var buf: [u8; 4096] = [0 as u8; 4096]
    let fd: u64 = io.open(path, 0)
    if ulib.bad(fd) {
        return 0
    }
    let b: u64 = (&buf[0 as usize]) as u64
    var taken: u64 = 0
    var rest: u64 = 0
    var onward: bool = true
    while onward {
        let n: u64 = io.read(fd, b + rest, 4095 - rest)
        if ulib.bad(n) || n == 0 {
            onward = false
        } else {
            let have: u64 = rest + n
            var cut: u64 = have
            while cut > 0 && *((b + cut - 1) as *mut u8) != 10 as u8 {
                cut = cut - 1
            }
            if cut == 0 {
                taken = taken + kv_scan(b, have, which)
                rest = 0
            } else {
                taken = taken + kv_scan(b, cut, which)
                var k: u64 = 0
                while cut + k < have {
                    *((b + k) as *mut u8) =
                        *((b + cut + k) as *mut u8)
                    k = k + 1
                }
                rest = have - cut
            }
        }
    }
    io.close(fd)
    if rest > 0 {
        taken = taken + kv_scan(b, rest, which)
    }
    return taken
}

fn kv_scan(b: u64, n: u64, which: u64) -> u64 {
    var taken: u64 = 0
    var i: u64 = 0
    while i < n {
        var e: u64 = i
        while e < n && *((b + e) as *mut u8) != 10 as u8 {
            e = e + 1
        }
        var end: u64 = e
        if end > i {
            if *((b + end - 1) as *mut u8) == 13 as u8 {
                end = end - 1
            }
        }
        if end > i {
            if *((b + i) as *mut u8) != 35 as u8 {
                var g: u64 = i
                while g < end && *((b + g) as *mut u8) != 61 as u8 {
                    g = g + 1
                }
                if g < end {
                    var ve: u64 = g + 1
                    while ve < end && *((b + ve) as *mut u8) != 35 as u8 {
                        ve = ve + 1
                    }
                    while ve > g + 1
                        && *((b + ve - 1) as *mut u8) == 32 as u8 {
                        ve = ve - 1
                    }
                    var ok: bool = false
                    if which == 0 {
                        ok = wcgfx.scheme_key(b + i, g - i, b + g + 1,
                            ve - g - 1)
                    } else if which == 1 {
                        ok = wcgfx.conf_key(b + i, g - i, b + g + 1, ve - g - 1)
                    } else if which == 4 {
                        ok = wcgfx.shape_key(b + i, g - i, b + g + 1,
                            ve - g - 1)
                    } else if which == 3 {
                        var k_off: [u8; 7] = "offset\0"
                        var k_rule: [u8; 5] = "rule\0"
                        var k_zone: [u8; 5] = "zone\0"
                        var v_eu: [u8; 3] = "eu\0"
                        var v_none: [u8; 5] = "none\0"
                        if wcgfx.name_eq(b + i, g - i,
                            (&k_off[0 as usize]) as u64) {

                            var west: u64 = 0
                            if ve > g + 1 && *((b + g + 1) as *mut u8) == 45 as u8 {
                                west = 1
                            }
                            let v: u64 = wcgfx.parse_dec(b + g + 1 + west, ve - g - 1 - west)
                            if v != wcbase.DEC_BAD && v <= 1440 {
                                if west == 0 {
                                    wcbase.tz_offset = v
                                }
                                ok = true
                            }
                        } else if wcgfx.name_eq(b + i, g - i,
                            (&k_rule[0 as usize]) as u64) {

                            var v_us: [u8; 3] = "us\0"
                            var v_au: [u8; 3] = "au\0"
                            var v_nz: [u8; 3] = "nz\0"
                            if wcgfx.name_eq(b + g + 1, ve - g - 1,
                                (&v_eu[0 as usize]) as u64)
                                || wcgfx.name_eq(b + g + 1, ve - g - 1,
                                (&v_none[0 as usize]) as u64)
                                || wcgfx.name_eq(b + g + 1, ve - g - 1, (&v_us[0 as usize]) as u64)
                                || wcgfx.name_eq(b + g + 1, ve - g - 1, (&v_au[0 as usize]) as u64)
                                || wcgfx.name_eq(b + g + 1, ve - g - 1, (&v_nz[0 as usize]) as u64) {
                                ok = true
                            }
                        } else if wcgfx.name_eq(b + i, g - i, (&k_zone[0 as usize]) as u64) {

                            ok = true
                        }
                    } else {
                        let idx: u64 = theme_named(b + i, g - i)
                        let v: u64 = wcgfx.parse_hex(b + g + 1, ve - g - 1)
                        if idx < wcbase.C_COUNT && v != wcbase.RGB_BAD {
                            wcbase.ovr_val[(idx) as usize] = v
                            wcbase.ovr_on[(idx) as usize] = 1
                            ovr_n = ovr_n + 1
                            ok = true
                        }
                    }
                    if ok {
                        taken = taken + 1
                    } else {
                        kv_bad = kv_bad + 1
                    }
                } else {
                    kv_bad = kv_bad + 1
                }
            }
        }
        i = e + 1
    }
    return taken
}

fn timezone_read() {
    var p_new: [u8; 15] = "/etc/time.conf\0"
    var p_old: [u8; 15] = "/etc/zeit.conf\0"

    if kv_read((&p_new[0 as usize]) as u64, 3) > 0 {
        return
    }

    let _o: u64 = kv_read((&p_old[0 as usize]) as u64, 3)
}

fn theme_auto_dark() -> bool {
    return wcgfx.auto_is_dark()
}

fn theme_apply() {
    let dark: bool = wcgfx.effective_dark()
    cur_dark = 0
    if dark {
        cur_dark = 1
    }
    var acc: u64 = wcbase.sch_accent
    if wcbase.set_accent != 0 {
        acc = wcbase.set_accent
        if wcbase.set_accent == wcbase.ACCENT_BLACK {
            acc = 0
        }
    }
    wcpaint.ramp_build(wcbase.R_ACCENT, acc)
    wcpaint.ramp_build(wcbase.R_DANGER, wcbase.sch_danger)
    wcpaint.ramp_build(wcbase.R_WARNING, wcbase.sch_warning)
    wcpaint.ramp_build(wcbase.R_SUCCESS, wcbase.sch_success)
    wcgfx.bind_neutrals(dark)
    wcgfx.bind_accent(dark)
    wcgfx.publish()
}

const BLUR_MAX: u64 = 16

fn set_aa_old(on: bool) {
    wcbase.aa_old_rim = on
}

fn tb_alpha() -> u64 {
    return wcbase.met[(wcbase.M_TB_ALPHA) as usize]
}

fn tb_blur() -> u64 {
    return blur_staerke()
}

fn set_radius(r: u64) {
    wcbase.usr_radius = wcgfx.cap(r, wcbase.RADIUS_MAX)
    wcgfx.glas_metrics()
    theme_apply()
}

fn set_tb_alpha(a: u64) {
    wcbase.usr_tba = wcgfx.clamp_alpha(a)
    wcgfx.glas_metrics()
    theme_apply()
}

fn set_win_alpha(a: u64) {
    wcbase.usr_wa = wcgfx.clamp_alpha(a)
    wcgfx.glas_metrics()
    theme_apply()
}

const FX_SUBTLE_TB: u64 = 82

fn set_transparency(m: u64) {
    if m > wcbase.TRANS_STRONG {
        return
    }
    wcbase.fx_mode = m
    theme_apply()
}

fn tb_alpha_fx() -> u64 {
    return wcgfx.fx_alpha(wcbase.met[(wcbase.M_TB_ALPHA) as usize], FX_SUBTLE_TB)
}

fn set_tb_blur(b: u64) {
    wcbase.ovr_blur = wcgfx.cap(b, BLUR_MAX) + 1
    wcgfx.glas_metrics()
    theme_apply()
}

fn theme_sum() -> u64 {
    var h: u64 = 1469598103934665603
    var i: u64 = 0
    while i < wcbase.C_COUNT {
        h = (h ^ wcbase.tok[((wcbase.live * wcbase.C_COUNT + i)) as usize]) *% 1099511628211
        i = i + 1
    }
    h = (h ^ wcbase.met[(wcbase.M_RADIUS_WINDOW) as usize]) *% 1099511628211
    h = (h ^ wcbase.met[(wcbase.M_TB_ALPHA) as usize]) *% 1099511628211
    h = (h ^ wcbase.met[(wcbase.M_WIN_ALPHA) as usize]) *% 1099511628211
    h = (h ^ wcbase.met[(wcbase.M_BLUR) as usize]) *% 1099511628211
    h = (h ^ wcbase.fx_mode) *% 1099511628211
    return h
}

fn reload_inner(aus_kopie: bool) -> u64 {
    var p_conf: [u8; 16] = "/etc/theme.conf\0"
    var p_dir: [u8; 14] = "/etc/schemas/\0"
    var p_shapes: [u8; 13] = "/etc/shapes/\0"
    var p_theme: [u8; 11] = "/etc/theme\0"
    var path: [u8; 64] = [0 as u8; 64]
    kv_bad = 0
    ovr_n = 0
    var z: u64 = 0
    while z < wcbase.C_COUNT {
        wcbase.ovr_on[(z) as usize] = 0
        z = z + 1
    }
    wcgfx.primitives_builtin()
    wcgfx.comp_map_init()
    wcgfx.metrics_classic()
    __mmio_write8(((&wcbase.shp_file[0 as usize]) as u64) as *mut u8, 0 as u8)
    __mmio_write8(((&wcbase.shp_name[0 as usize]) as u64) as *mut u8, 0 as u8)
    corner.aa_reset()
    wcbase.set_mode = wcbase.MODE_AUTO
    wcbase.set_accent = 0
    wcbase.usr_radius = wcbase.RAD_NONE
    wcbase.usr_tba = 100
    wcbase.usr_wa = 100
    wcbase.fx_mode = wcbase.TRANS_SUBTLE
    __mmio_write8(((&wcbase.sch_file[0 as usize]) as u64) as *mut u8, 0 as u8)
    __mmio_write8(((&wcbase.sch_dark_file[0 as usize]) as u64) as *mut u8, 0 as u8)
    __mmio_write8(((&wcbase.sch_name[0 as usize]) as u64) as *mut u8, 0 as u8)
    var nc: u64 = 0
    if aus_kopie && wcbase.conf_len > 0 {
        nc = kv_scan((&wcbase.conf_copy[0 as usize]) as u64, wcbase.conf_len, 1)
    } else {

        if wcgfx.conf_fetch() > 0 {
            nc = kv_scan((&wcbase.conf_copy[0 as usize]) as u64, wcbase.conf_len, 1)
        }
    }
    let _nc: u64 = nc

    hc_seen = wcpaint.ax_high()
    if hc_seen != 0 {
        var p_hc: [u8; 9] = "contrast\0"
        wcgfx.copy_bounded((&wcbase.sch_file[0 as usize]) as u64,
            (&p_hc[0 as usize]) as u64, 8, 32)
        __mmio_write8(((&wcbase.sch_dark_file[0 as usize]) as u64) as *mut u8,
            0 as u8)
    }
    if nc == 0 {
        wcbase.set_mode = wcbase.sch_mode
    }
    timezone_read()
    var pick: u64 = (&wcbase.sch_file[0 as usize]) as u64
    if *(((&wcbase.sch_dark_file[0 as usize]) as u64) as *mut u8) != 0 as u8
        && wcgfx.effective_dark() {
        pick = (&wcbase.sch_dark_file[0 as usize]) as u64
    }
    if *((pick) as *mut u8) != 0 as u8 {
        wcgfx.path_join((&p_dir[0 as usize]) as u64, pick,
            (&path[0 as usize]) as u64, 64)
        sch_keys = kv_read((&path[0 as usize]) as u64, 0)
    } else {
        sch_keys = 0
    }

    if *(((&wcbase.shp_file[0 as usize]) as u64) as *mut u8) != 0 as u8 {
        wcgfx.path_join((&p_shapes[0 as usize]) as u64,
            (&wcbase.shp_file[0 as usize]) as u64,
            (&path[0 as usize]) as u64, 64)
        wcbase.shp_keys = kv_read((&path[0 as usize]) as u64, 4)
        if wcbase.shp_keys == 0 {
            wcgfx.metrics_classic()
        } else if wcbase.met[(wcbase.M_RADIUS_BUTTON) as usize] != 0
            || wcbase.met[(wcbase.M_SHADOW) as usize] != 0 {
            wcbase.shp_id = SHAPE_MODERN
        }
    } else {
        wcbase.shp_keys = 0
    }
    wcgfx.glas_metrics()

    if hc_seen == 0 {
        let _no: u64 = kv_read((&p_theme[0 as usize]) as u64, 2)
    }
    theme_apply()
    booted = 1
    return wcbase.generation
}

fn theme_reload() -> u64 {
    return reload_inner(false)
}

fn theme_probe(scheme: u64, mode: u64, shape: u64, accent: u64) -> u64 {
    var p_dir: [u8; 14] = "/etc/schemas/\0"
    var p_shapes: [u8; 13] = "/etc/shapes/\0"
    var path: [u8; 64] = [0 as u8; 64]
    wcpaint.pairs_init()
    wcgfx.comp_map_init()
    kv_bad = 0
    wcgfx.primitives_builtin()
    wcgfx.metrics_classic()
    var n: u64 = 0
    while *((scheme + n) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    wcgfx.copy_bounded((&wcbase.sch_file[0 as usize]) as u64, scheme, n, 32)
    wcgfx.path_join((&p_dir[0 as usize]) as u64, (&wcbase.sch_file[0 as usize]) as u64,
        (&path[0 as usize]) as u64, 64)
    let keys: u64 = kv_read((&path[0 as usize]) as u64, 0)

    var m: u64 = 0
    while *((shape + m) as *mut u8) != 0 as u8 {
        m = m + 1
    }
    if m > 0 {
        wcgfx.copy_bounded((&wcbase.shp_file[0 as usize]) as u64, shape, m, 32)
        wcgfx.path_join((&p_shapes[0 as usize]) as u64,
            (&wcbase.shp_file[0 as usize]) as u64,
            (&path[0 as usize]) as u64, 64)
        let sk: u64 = kv_read((&path[0 as usize]) as u64, 4)
        if sk == 0 {
            wcgfx.metrics_classic()
        } else if wcbase.met[(wcbase.M_RADIUS_BUTTON) as usize] != 0
            || wcbase.met[(wcbase.M_SHADOW) as usize] != 0 {
            wcbase.shp_id = SHAPE_MODERN
        }
    }
    wcgfx.glas_metrics()
    wcbase.set_mode = mode
    wcbase.set_accent = accent
    if accent != 0 && (accent & wcbase.RGB24) == 0 {
        wcbase.set_accent = wcbase.ACCENT_BLACK
    }

    theme_apply()
    var i: u64 = 0
    while i < wcbase.C_COUNT {
        prb_comp[(i) as usize] = wcbase.sem[(wcbase.comp_role[(i) as usize]) as usize]
        i = i + 1
    }
    var j: u64 = 0
    while j < wcbase.M_COUNT {
        prb_met[(j) as usize] = wcbase.met[(j) as usize]
        j = j + 1
    }
    prb_high = wcbase.sch_high
    prb_ok = 0
    if wcbase.acc_ok != 0 {
        prb_ok = 1
    }
    prb_moved = wcbase.acc_moved
    prb_txt = wcpaint.contrast(wcbase.sem[(wcbase.S_TEXT_PRIMARY) as usize],
        wcbase.sem[(wcbase.S_SURFACE) as usize])
    var k: u64 = 0
    var least: u64 = 0xFFFFFFFFFFFFFFFF
    var wat: u64 = 0
    while k < PAIR_COUNT {
        let r: u64 = wcpaint.contrast(wcbase.sem[(wcbase.pair_fg[(k) as usize]) as usize],
            wcbase.sem[(wcbase.pair_bg[(k) as usize]) as usize])
        prb_pair[(k) as usize] = r
        if r < least {
            least = r
            wat = k
        }
        k = k + 1
    }
    prb_min = least
    prb_worst = wat

    let _g: u64 = reload_inner(false)
    return keys
}

fn theme_probe_comp(i: u64) -> u64 {
    if i >= wcbase.C_COUNT {
        return 0
    }
    return prb_comp[(i) as usize]
}

fn theme_probe_metric(i: u64) -> u64 {
    if i >= wcbase.M_COUNT {
        return 0
    }
    return prb_met[(i) as usize]
}

fn theme_probe_txt() -> u64 {
    return prb_txt
}

fn theme_probe_min() -> u64 {
    return prb_min
}

fn theme_probe_worst() -> u64 {
    return prb_worst
}

fn theme_probe_ok() -> bool {
    return prb_ok != 0
}

fn theme_probe_moved() -> u64 {
    return prb_moved
}

fn theme_probe_high() -> bool {
    return prb_high != 0
}

fn theme_probe_pairs() -> u64 {
    return PAIR_COUNT
}

fn theme_probe_pair(i: u64) -> u64 {
    if i >= PAIR_COUNT {
        return 0
    }
    return prb_pair[(i) as usize]
}

fn theme_probe_pair_fg(i: u64) -> u64 {
    wcpaint.pairs_init()
    if i >= PAIR_COUNT {
        return 0
    }
    return wcbase.pair_fg[(i) as usize]
}

fn theme_probe_pair_bg(i: u64) -> u64 {
    wcpaint.pairs_init()
    if i >= PAIR_COUNT {
        return 0
    }
    return wcbase.pair_bg[(i) as usize]
}

fn theme_poll() -> bool {

    if wcpaint.ax_high() != hc_seen {
        let before_hc: u64 = theme_sum()
        let _gh: u64 = reload_inner(true)
        return theme_sum() != before_hc
    }
    if wcgfx.conf_due() && wcgfx.conf_changed() {
        let before: u64 = theme_sum()
        let _g: u64 = reload_inner(true)
        return theme_sum() != before
    }
    if wcbase.set_mode == wcbase.MODE_AUTO {
        var want: u64 = 0
        if wcgfx.auto_is_dark() {
            want = 1
        }
        if want != cur_dark {
            let before: u64 = theme_sum()
            theme_apply()
            return theme_sum() != before
        }
    }
    return false
}

fn theme_set_mode(m: u64) {
    if m <= wcbase.MODE_AUTO {
        wcbase.set_mode = m
        theme_apply()
    }
}

fn theme_set_accent(rgb: u64) {
    wcbase.set_accent = rgb & wcbase.RGB24
    if wcbase.set_accent == 0 {
        wcbase.set_accent = wcbase.ACCENT_BLACK
    }
    theme_apply()
}

fn theme_clear_accent() {
    wcbase.set_accent = 0
    theme_apply()
}

fn theme_bad_keys() -> u64 {
    return kv_bad
}

fn theme_scheme_keys() -> u64 {
    return sch_keys
}

fn theme_count() -> u64 {
    return ovr_n
}

fn theme_token_count() -> u64 {
    return wcbase.C_COUNT
}

fn theme_semantic_count() -> u64 {
    return wcbase.S_COUNT
}

fn theme_override_count() -> u64 {
    return ovr_n
}

fn theme_load(path: u64) -> u64 {
    if booted == 0 {
        let _g: u64 = theme_reload()
    }
    ovr_n = 0
    var z: u64 = 0
    while z < wcbase.C_COUNT {
        wcbase.ovr_on[(z) as usize] = 0
        z = z + 1
    }

    if hc_seen != 0 {
        theme_apply()
        return 0
    }
    let n: u64 = kv_read(path, 2)
    theme_apply()
    return n
}

fn theme_set(i: u64, v: u64) {
    if i < wcbase.C_COUNT {
        wcbase.ovr_val[(i) as usize] = v
        wcbase.ovr_on[(i) as usize] = 1
        theme_apply()
    }
}

fn deco_one(slot: u64, colour: u64) -> u64 {
    if ulib.bad(wcpaint.sys3w(WM_DECO, slot, colour, 0)) {
        return 0
    }
    return 1
}

fn form_one(slot: u64, value: u64) -> u64 {
    if ulib.bad(wcpaint.sys3w(WM_FORM, slot, value, 0)) {
        return 0
    }
    return 1
}

