    return wcpaint.drag_value(wcbase.ovr_lift, wcbase.M_LIFT)
}

fn zieh_tilt() -> u64 {
    return wcpaint.drag_value(wcbase.ovr_tilt, wcbase.M_TILT)
}

fn zieh_swing() -> u64 {
