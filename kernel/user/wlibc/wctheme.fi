    return wcpaint.sys3w(wcbase.WM_INFO, h, WI_WORKX, 0)
}

fn work_y(h: u64) -> u64 {
    return wcpaint.sys3w(wcbase.WM_INFO, h, WI_WORKY, 0)
}

fn work_w(h: u64) -> u64 {
    return wcpaint.sys3w(wcbase.WM_INFO, h, WI_WORKW, 0)
}

fn work_h(h: u64) -> u64 {
    return wcpaint.sys3w(wcbase.WM_INFO, h, WI_WORKH, 0)
}

static mut e_names: [u8; 23] = "bottom\0top\0left\0right\0\0"

fn edge_name(e: u64) -> u64 {
    let b: u64 = (&e_names[0 as usize]) as u64
    var i: u64 = 0
    var k: u64 = 0
    while k < e && i < 24 {
        if __mmio_read8((b + i) as *mut u8) == 0 as u8 {
            k = k + 1
        }
        i = i + 1
    }
    return b + i
}

fn edge_by_name(p: u64) -> u64 {
    var e: u64 = 0
    while e < 4 {
        let q: u64 = edge_name(e)
        var i: u64 = 0
        var equal: bool = true
        while __mmio_read8((q + i) as *mut u8) != 0 as u8 {
            if __mmio_read8((p + i) as *mut u8)
                != __mmio_read8((q + i) as *mut u8) {
                equal = false
            }
            i = i + 1
        }
        if equal && __mmio_read8((p + i) as *mut u8) == 0 as u8 {
            return e
        }
        e = e + 1
    }
    return 4
}

fn icon_have() -> bool {
    return wcpaint.gfind(F_ICON, icon_small(), icons.NETWORK_WIRED)
        != 0xFFFFFFFFFFFFFFFF
}

fn icon_box(px_: u64) -> u64 {
    return px_
}

fn icon_ink_w(id: u64, px_: u64) -> u64 {
    let at: u64 = wcpaint.gfind(F_ICON, px_, id)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return wcbase.gc[(at + wcbase.GC_W) as usize]
}

fn icon_ink_h(id: u64, px_: u64) -> u64 {
    let at: u64 = wcpaint.gfind(F_ICON, px_, id)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return wcbase.gc[(at + wcbase.GC_H) as usize]
}

fn icon_at(id: u64, x: u64, y: u64, px_: u64, color: u64) -> bool {
    let at: u64 = wcpaint.gfind(F_ICON, px_, id)
    if at == 0xFFFFFFFFFFFFFFFF {
        return false
    }
    if wcbase.gc[(at + wcbase.GC_W) as usize] == 0 || wcbase.gc[(at + wcbase.GC_H) as usize] == 0 {
        return false
    }
    wcpaint.draw_glyph(at, x as i64, (y + px_) as i64, color)
    return true
}

fn icon_mid(id: u64, x: u64, y: u64, h: u64, px_: u64, color: u64) -> bool {
    let at: u64 = wcpaint.gfind(F_ICON, px_, id)
    if at == 0xFFFFFFFFFFFFFFFF {
        return false
    }
    let gw: u64 = wcbase.gc[(at + wcbase.GC_W) as usize]
    let gh: u64 = wcbase.gc[(at + wcbase.GC_H) as usize]
    if gw == 0 || gh == 0 {
        return false
    }
    var top: u64 = y
    if h > gh {
        top = y + (h - gh) / 2
    }
    wcpaint.draw_glyph(at, x as i64, (top + wcbase.gc[(at + wcbase.GC_T) as usize]) as i64,
        color)
    return true
}

fn icon_mid_ink(id: u64, x: u64, y: u64, bw: u64, h: u64, px_: u64, color: u64) -> bool {
    let at: u64 = wcpaint.gfind(F_ICON, px_, id)
    if at == 0xFFFFFFFFFFFFFFFF {
        return false
    }
    let gw: u64 = wcbase.gc[(at + wcbase.GC_W) as usize]
    let gh: u64 = wcbase.gc[(at + wcbase.GC_H) as usize]
    let data: u64 = wcbase.gc[(at + wcbase.GC_DATA) as usize]
    if gw == 0 || gh == 0 || data == 0 {
        return false
    }
    var r0: u64 = gh
    var r1: u64 = 0
    var c0: u64 = gw
    var c1: u64 = 0
    var r: u64 = 0
    while r < gh {
        var c: u64 = 0
        while c < gw {
            if (*((data + r * gw + c) as *mut u8)) as u64 >= 64 {
                if r < r0 {
                    r0 = r
                }
                if r > r1 {
                    r1 = r
                }
                if c < c0 {
                    c0 = c
                }
                if c > c1 {
                    c1 = c
                }
            }
            c = c + 1
        }
        r = r + 1
    }
    if r1 < r0 || c1 < c0 {
        return false
    }
    let inkh: u64 = r1 - r0 + 1
    let inkw: u64 = c1 - c0 + 1
    var wy: u64 = y
    if h > inkh {
        wy = y + (h - inkh) / 2
    }
    var wx: u64 = x
    if bw > inkw {
        wx = x + (bw - inkw) / 2
    }

    let xd: i64 = wx as i64 - wcbase.gc[(at + wcbase.GC_L) as usize] as i64 - c0 as i64
    let yd: i64 = wy as i64 + wcbase.gc[(at + wcbase.GC_T) as usize] as i64 - r0 as i64
    wcpaint.draw_glyph(at, xd, yd, color)
    return true
}

fn icon_role(a: u64) -> u64 {
    if a == 1 {
        return theme(T_FG)
    }
    if a == 2 {
        return theme(T_DIM)
    }
    if a == 3 {
        return theme(T_ACCENT)
    }
    if a == 4 {
        return theme(T_FOCUS)
    }
    if a == 5 {
        return theme(T_PANEL)
    }
    return theme(T_FG)
}

fn icon_ok(p: u64) -> bool {
    if p == 0 {
        return false
    }
    if __mmio_read8((p) as *mut u8) != 79 as u8 {
        return false
    }
    if __mmio_read8((p + 1) as *mut u8) != 83 as u8 {
        return false
    }
    if __mmio_read8((p + 2) as *mut u8) != 89 as u8 {
        return false
    }
    return __mmio_read8((p + 3) as *mut u8) == 77 as u8
}

fn icon_w(p: u64) -> u64 {
    if !icon_ok(p) {
        return 0
    }
    return __mmio_read32((p + 4) as *mut u32) as u64
}

fn icon_h(p: u64) -> u64 {
    if !icon_ok(p) {
        return 0
    }
    return __mmio_read32((p + 8) as *mut u32) as u64
}

fn icon_draw(p: u64, x: u64, y: u64) -> bool {
    return icon_draw_sc(p, x, y, wcpaint.ui_scale())
}

fn icon_draw_w(p: u64) -> u64 {
    return icon_w(p) * wcpaint.ui_scale()
}

fn icon_draw_h(p: u64) -> u64 {
    return icon_h(p) * wcpaint.ui_scale()
}

fn icon_ink_top(p: u64) -> u64 {
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return 0
    }
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let v: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            if ((v >> 24) & 0xFF) != 0 {
                return r * wcpaint.ui_scale()
            }
            c = c + 1
        }
        r = r + 1
    }
    return 0
}

fn icon_ink_hgt(p: u64) -> u64 {
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return 0
    }
    var erst: u64 = h
    var letzt: u64 = 0
    var gab: bool = false
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let v: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            if ((v >> 24) & 0xFF) != 0 {
                if !gab {
                    erst = r
                    gab = true
                }
                letzt = r
                c = w
            } else {
                c = c + 1
            }
        }
        r = r + 1
    }
    if !gab {
        return 0
    }
    return (letzt - erst + 1) * wcpaint.ui_scale()
}

fn icon_ink_lft(p: u64) -> u64 {
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return 0
    }
    var c: u64 = 0
    while c < w {
        var r: u64 = 0
        while r < h {
            let v: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            if ((v >> 24) & 0xFF) != 0 {
                return c * wcpaint.ui_scale()
            }
            r = r + 1
        }
        c = c + 1
    }
    return 0
}

fn icon_ink_wid(p: u64) -> u64 {
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return 0
    }
    var erst: u64 = w
    var letzt: u64 = 0
    var gab: bool = false
    var c: u64 = 0
    while c < w {
        var r: u64 = 0
        while r < h {
            let v: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            if ((v >> 24) & 0xFF) != 0 {
                if !gab {
                    erst = c
                    gab = true
                }
                letzt = c
                r = h
            } else {
                r = r + 1
            }
        }
        c = c + 1
    }
    if !gab {
        return 0
    }
    return (letzt - erst + 1) * wcpaint.ui_scale()
}

fn icon_draw_sc(p: u64, x: u64, y: u64, sc: u64) -> bool {
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return false
    }
    var s: u64 = sc
    if s == 0 {
        s = 1
    }
    if s > 8 {
        s = 8
    }
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let v: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            let a: u64 = (v >> 24) & 0xFF
            if a != 0 {
                var f: u64 = v & wcbase.RGB24
                if a != 255 {
                    f = icon_role(a)
                }
                var dy: u64 = 0
                while dy < s {
                    var dx: u64 = 0
                    while dx < s {
                        wcpaint.px(x + c * s + dx, y + r * s + dy, f)
                        dx = dx + 1
                    }
                    dy = dy + 1
                }
            }
            c = c + 1
        }
        r = r + 1
    }
    return true
}

fn app_icon(name: u64, out: u64) -> bool {
    if name == 0 || out == 0 {
        return false
    }
    appicon.init_tile(out, appicon.color_of(name))
    let c0: u64 = appicon.letter_cp(name, 0)
    if c0 == 0 {
        return true
    }
    let c1: u64 = appicon.letter_cp(name, 1)
    var size: u64 = 19
    if c1 != 0 {
        size = 14
    }
    var a0: u64 = wcpaint.gfind(F_BOLD, size, c0)
    var a1: u64 = 0xFFFFFFFFFFFFFFFF
    if c1 != 0 {
        a1 = wcpaint.gfind(F_BOLD, size, c1)
    }
    if a0 == 0xFFFFFFFFFFFFFFFF || wcbase.gc[(a0 + wcbase.GC_W) as usize] == 0 {
        a0 = wcpaint.gfind(F_UI, size, c0)
        if c1 != 0 {
            a1 = wcpaint.gfind(F_UI, size, c1)
        }
    }
    if a0 == 0xFFFFFFFFFFFFFFFF {
        return true
    }
    var w0: u64 = wcbase.gc[(a0 + wcbase.GC_W) as usize]
    var w1: u64 = 0
    var top: u64 = wcbase.gc[(a0 + wcbase.GC_T) as usize]
    var gap: u64 = 0
    if a1 != 0xFFFFFFFFFFFFFFFF {
        w1 = wcbase.gc[(a1 + wcbase.GC_W) as usize]
        if wcbase.gc[(a1 + wcbase.GC_T) as usize] > top {
            top = wcbase.gc[(a1 + wcbase.GC_T) as usize]
        }
        gap = 1
    }
    let total: u64 = w0 + gap + w1
    if total > 28 || top > 28 {
        return true
    }
    let base: u64 = (appicon.SIZE + top) / 2
    let x0: u64 = (appicon.SIZE - total) / 2
    if wcbase.gc[(a0 + wcbase.GC_T) as usize] <= base {
        appicon.blend_cover(out, x0, base - wcbase.gc[(a0 + wcbase.GC_T) as usize], w0, wcbase.gc[(a0 + wcbase.GC_H) as usize],
            wcbase.gc[(a0 + wcbase.GC_DATA) as usize])
    }
    if w1 != 0 && wcbase.gc[(a1 + wcbase.GC_T) as usize] <= base {
        appicon.blend_cover(out, x0 + w0 + gap, base - wcbase.gc[(a1 + wcbase.GC_T) as usize], w1, wcbase.gc[(a1 + wcbase.GC_H) as usize],
            wcbase.gc[(a1 + wcbase.GC_DATA) as usize])
    }
    return true
}

fn icon_vec(p: u64) -> bool {
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    return w >= 32 && h >= 32 && w <= 128 && h <= 128
}

fn icon_draw_fit(p: u64, x: u64, y: u64, size: u64) -> bool {
    if !icon_vec(p) || size == 0 {
        return false
    }
    let w: u64 = icon_w(p)
    let h: u64 = icon_h(p)
    var dy: u64 = 0
    while dy < size {
        let y0s: u64 = dy * h
        let y1s: u64 = (dy + 1) * h
        let sya: u64 = y0s / size
        let syb: u64 = (y1s + size - 1) / size
        var dx: u64 = 0
        while dx < size {
            let x0s: u64 = dx * w
            let x1s: u64 = (dx + 1) * w
            let sxa: u64 = x0s / size
            let sxb: u64 = (x1s + size - 1) / size
            var sa: u64 = 0
            var sr: u64 = 0
            var sg: u64 = 0
            var sb: u64 = 0
            var sy: u64 = sya
            while sy < syb && sy < h {
                var lo: u64 = sy * size
                if lo < y0s {
                    lo = y0s
                }
                var hi: u64 = (sy + 1) * size
                if hi > y1s {
                    hi = y1s
                }
                var sx: u64 = sxa
                while sx < sxb && sx < w {
                    var xl: u64 = sx * size
                    if xl < x0s {
                        xl = x0s
                    }
                    var xh: u64 = (sx + 1) * size
                    if xh > x1s {
                        xh = x1s
                    }
                    if hi > lo && xh > xl {
                        let wgt: u64 = (hi - lo) * (xh - xl)
                        let v: u64 = __mmio_read32((p + 12 + (sy * w + sx) * 4)
                            as *mut u32) as u64
                        let a: u64 = (v >> 24) & 0xFF
                        let wa: u64 = wgt * a
                        sa = sa + wa
                        sb = sb + wa * (v & 255)
                        sg = sg + wa * ((v >> 8) & 255)
                        sr = sr + wa * ((v >> 16) & 255)
                    }
                    sx = sx + 1
                }
                sy = sy + 1
            }
            let alpha: u64 = sa / (w * h)
            if alpha != 0 && sa != 0 {
                let rr: u64 = sr / sa
                let gg: u64 = sg / sa
                let bb: u64 = sb / sa
                let col: u64 = (rr << 16) | (gg << 8) | bb
                wcpaint.px(x + dx, y + dy, wcpaint.blend(wcpaint.get(x + dx, y + dy), col, alpha))
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
    return true
}
