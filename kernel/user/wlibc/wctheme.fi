}

fn blur_noise() -> u64 {
    return wcpaint.drag_value(wcbase.ovr_bnoise, wcbase.M_BLURNOISE)
}

fn form_push() -> u64 {
    var n: u64 = 0
    n = n + form_one(WF_RADIUS, wcbase.met[(wcbase.M_RADIUS_WINDOW) as usize])
    n = n + form_one(WF_SHADOW, wcpaint.shadow_value(wcbase.met[(wcbase.M_SHADOW) as usize]))
    n = n + form_one(WF_SHADOW_R, wcbase.met[(wcbase.M_SHADOW_R) as usize])

    n = n + form_one(WF_SHADOW_C, theme_live(wcbase.C_SHADOW))

    n = n + form_one(WF_SHADOW2, wcpaint.shadow_value(wcbase.met[(wcbase.M_SHADOW2) as usize]))
    n = n + form_one(WF_SHADOW_R2, wcbase.met[(wcbase.M_SHADOW_R2) as usize])
    n = n + form_one(WF_GRAD, wcbase.met[(wcbase.M_GRAD) as usize])
    n = n + form_one(WF_CAPTION, wcbase.met[(wcbase.M_CAPTION) as usize])
    n = n + form_one(WF_TITLE_BAR, wcbase.met[(wcbase.M_TITLE_BAR) as usize])
    n = n + form_one(WF_CAP_W, wcbase.met[(wcbase.M_CAP_W) as usize])
    n = n + form_one(WF_FRAME, wcbase.met[(wcbase.M_FRAME) as usize])
    n = n + form_one(WF_TERM_PAD, wcbase.met[(wcbase.M_TERM_PAD) as usize])
    n = n + form_one(WF_LIFT, wcpaint.drag_value(wcbase.ovr_lift, wcbase.M_LIFT))
    n = n + form_one(WF_TILT, wcpaint.drag_value(wcbase.ovr_tilt, wcbase.M_TILT))
    n = n + form_one(WF_SWING, wcpaint.drag_value(wcbase.ovr_swing, wcbase.M_SWING))
    n = n + form_one(WF_BLUR, wcgfx.fx_blur(wcpaint.drag_value(wcbase.ovr_blur, wcbase.M_BLUR)))
    n = n + form_one(WF_BLURTINT, wcgfx.fx_tint(wcpaint.drag_value(wcbase.ovr_btint, wcbase.M_BLURTINT)))
    n = n + form_one(WF_BLURNOISE, wcgfx.fx_noise(wcpaint.drag_value(wcbase.ovr_bnoise, wcbase.M_BLURNOISE)))
    n = n + form_one(WF_BLURRIM, wcgfx.fx_rim())
    n = n + form_one(WF_TB_ALPHA, wcgfx.fx_alpha(wcbase.met[(wcbase.M_TB_ALPHA) as usize], FX_SUBTLE_TB))
    n = n + form_one(WF_WIN_ALPHA, wcgfx.fx_alpha(wcbase.met[(wcbase.M_WIN_ALPHA) as usize], wcbase.FX_SUBTLE_WIN))
    n = n + form_one(WF_GLASS_KEY, theme_live(wcbase.C_PANEL_BG))
    return n
}

fn ansi_push() -> u64 {
    var n: u64 = 0
    n = n + deco_one(11, theme_live(wcbase.C_INPUT_BG))
    n = n + deco_one(12, theme_semantic(wcbase.S_DANGER))
    n = n + deco_one(13, theme_semantic(wcbase.S_SUCCESS))
    n = n + deco_one(14, theme_semantic(wcbase.S_WARNING))
    n = n + deco_one(15, theme_semantic(wcbase.S_BORDER_FOCUS))
    n = n + deco_one(16, theme_live(wcbase.C_WINDOW_TEXT))
    n = n + deco_one(17, theme_live(wcbase.C_TEXT_MUTED))
    n = n + deco_one(18, theme_live(wcbase.C_WINDOW_TEXT))
    return n
}

fn deco_push() -> u64 {
    var n: u64 = ansi_push()
    if wcbase.met[(wcbase.M_TONE) as usize] < 50 {

        n = n + deco_one(0, theme_live(wcbase.C_BORDER))
        n = n + deco_one(1, theme_live(wcbase.C_WINDOW_BG))
        n = n + deco_one(2, theme_live(wcbase.C_TEXT_MUTED))
        n = n + deco_one(3, theme_live(wcbase.C_BORDER))
        n = n + deco_one(4, theme_live(wcbase.C_PANEL_BG))
        n = n + deco_one(5, theme_live(wcbase.C_WINDOW_TEXT))
        n = n + deco_one(6, theme_live(wcbase.C_DANGER))
        n = n + deco_one(7, theme_on(theme_live(wcbase.C_DANGER)))
        n = n + deco_one(8, theme_live(wcbase.C_DESKTOP_BOTTOM))
        n = n + deco_one(9, theme_live(wcbase.C_WINDOW_TEXT))
        n = n + deco_one(10, theme_live(wcbase.C_INPUT_BG))
        return n
    }
    n = n + deco_one(0, theme_live(wcbase.C_WINDOW_FRAME))
    n = n + deco_one(1, theme_live(wcbase.C_TITLEBAR_OFF_BG))
    n = n + deco_one(2, theme_live(wcbase.C_TITLEBAR_OFF_TEXT))
    n = n + deco_one(3, theme_live(wcbase.C_ACCENT))
    n = n + deco_one(4, theme_live(wcbase.C_TITLEBAR_BG))
    n = n + deco_one(5, theme_live(wcbase.C_TITLEBAR_TEXT))
    n = n + deco_one(6, theme_live(wcbase.C_DANGER))
    n = n + deco_one(7, theme_on(theme_live(wcbase.C_DANGER)))
    n = n + deco_one(8, theme_live(wcbase.C_DESKTOP_BOTTOM))
    n = n + deco_one(9, theme_live(wcbase.C_WINDOW_TEXT))
    n = n + deco_one(10, theme_live(wcbase.C_INPUT_BG))
    return n
}

fn win_scale_pct(h: u64) -> u64 {
    let v: u64 = wcpaint.sys3w(wcbase.WM_INFO, h, WI_SCALEPCT, 0)
    if ulib.bad(v) || v < 100 || v > 400 {
        return wcpaint.ui_scale() * 100
    }
    return v
}

