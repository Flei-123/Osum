const WF_RADIUS: u64 = 0

const WF_SHADOW: u64 = 1

const WF_SHADOW_R: u64 = 2

const WF_SHADOW_C: u64 = 3

const WF_SHADOW2: u64 = 4

const WF_SHADOW_R2: u64 = 5

const WF_GRAD: u64 = 6

const WF_CAPTION: u64 = 7

const WF_LIFT: u64 = 9

const WF_TILT: u64 = 10

const WF_SWING: u64 = 11

const WF_BLUR: u64 = 12

const WF_BLURTINT: u64 = 13

const WF_BLURNOISE: u64 = 14

const WF_TB_ALPHA: u64 = 15

const WF_WIN_ALPHA: u64 = 16

const WF_GLASS_KEY: u64 = 17

const WF_TITLE_BAR: u64 = 18

const WF_CAP_W: u64 = 19

const WF_FRAME: u64 = 20

const WF_BLURRIM: u64 = 21

const WF_TERM_PAD: u64 = 22

fn start(noclip: bool) -> bool {
    if wcbase.s_ready != 0 {
        return true
    }
    wcbase.s_scr_w = wcpaint.sys3w(wcbase.WIG_SCREEN, 0, 0, 0)
    wcbase.s_scr_h = wcpaint.sys3w(wcbase.WIG_SCREEN, 1, 0, 0)
    if ulib.bad(wcbase.s_scr_w) || wcbase.s_scr_w == 0 || wcbase.s_scr_w > wcbase.SURF_W_MAX {
        return false
    }
    if ulib.bad(wcbase.s_scr_h) || wcbase.s_scr_h == 0 {
        return false
    }
    var rows: u64 = wcbase.SURF_BUDGET / (wcbase.s_scr_w *% 4)
    if rows == 0 {
        return false
    }
    if rows > wcbase.s_scr_h {
        rows = wcbase.s_scr_h
    }
    let p: u64 = wcpaint.map_surface(wcbase.s_scr_w *% rows *% 4)
    if ulib.bad(p) || p == 0 {
        return false
    }
    wcbase.s_surf = p
    wcbase.s_scap = wcbase.s_scr_w *% rows *% 4
    wcbase.s_sw = wcbase.s_scr_w
    wcbase.s_srows = rows
    if noclip {
        svcclip.set_noclip()
    }
    let _tg: u64 = theme_reload()
    wcbase.s_ready = 1
    return true
}

fn set_head_bounds(x: u64, y: u64, w: u64, h: u64) {
    wcbase.s_hb_x = x
    wcbase.s_hb_y = y
    wcbase.s_hb_w = w
    wcbase.s_hb_h = h
}

fn start_head_set(hd: u64) {
    let _r: u64 = wcpaint.sys3w(wcbase.WIG_SCREEN, hostwinp.WS_STARTHEAD, 1, hd)
}

fn start_head_get() -> u64 {
    let r: u64 = wcpaint.sys3w(wcbase.WIG_SCREEN, hostwinp.WS_STARTHEAD, 0, 0)
    if ulib.bad(r) {
        return 0
    }
    return r
}

fn set_band(y: u64) {
    if wcbase.s_pinned != 0 {
        return
    }
    wcbase.s_band = y
}

const R_COUNT: u64 = 4

const T_FG: u64 = uitheme.T_FG

const T_DIM: u64 = uitheme.T_DIM

const T_PANEL: u64 = uitheme.T_PANEL

const T_SEL: u64 = uitheme.T_SEL

const T_SELFG: u64 = uitheme.T_SELFG

const T_FOCUS: u64 = uitheme.T_FOCUS

const T_ACCENT: u64 = uitheme.T_ACCENT

const SHAPE_MODERN: u64 = 1

static mut ovr_n: u64 = 0

static mut paint_gen: u64 = 0

static mut booted: u64 = 0

static mut hc_seen: u64 = 0

static mut sch_keys: u64 = 0

static mut kv_bad: u64 = 0

static mut cur_dark: u64 = 0

static mut prb_comp: [u64; 41] = [0 as u64; 41]

static mut prb_met: [u64; 37] = [0 as u64; 37]

static mut prb_pair: [u64; 21] = [0 as u64; 21]

static mut prb_txt: u64 = 0

static mut prb_min: u64 = 0

static mut prb_worst: u64 = 0

static mut prb_ok: u64 = 1

static mut prb_moved: u64 = 0

static mut prb_high: u64 = 0

const PAIR_COUNT: u64 = 21

fn theme(i: u64) -> u64 {
    return uitheme.theme(i)
}

fn theme_selfg() -> u64 {
    let bg: u64 = theme(T_SEL)
    let fg: u64 = theme(T_SELFG)
    if wcpaint.contrast(fg, bg) >= 450 {
        return fg
    }
    let w: u64 = wcbase.RGB_WHITE
    let b: u64 = wcbase.RGB_BLACK
    if wcpaint.contrast(w, bg) >= wcpaint.contrast(b, bg) {
        return w
    }
    return b
}

fn theme_selfg_contrast() -> u64 {
    return wcpaint.contrast(theme_selfg(), theme(T_SEL))
}

fn theme_live(i: u64) -> u64 {
    if i >= wcbase.C_COUNT {
        return 0
    }
    return wcbase.tok[((wcbase.live * wcbase.C_COUNT + i)) as usize]
}

fn theme_semantic(i: u64) -> u64 {
    if i >= wcbase.S_COUNT {
        return 0
    }
    return wcbase.sem[(i) as usize]
}

fn theme_neutral(i: u64) -> u64 {
    if i >= wcbase.NEUTRAL_STEPS {
        return 0
    }
    return wcbase.neutral[(i) as usize]
}

fn theme_ramp(slot: u64, step: u64) -> u64 {
    if slot >= R_COUNT || step >= wcbase.RAMP_STEPS {
        return 0
    }
    return wcpaint.ramp_at(slot, step)
}

fn theme_role_of(i: u64) -> u64 {
    if i >= wcbase.C_COUNT {
        return wcbase.S_COUNT
    }
    return wcbase.comp_role[(i) as usize]
}

fn theme_gen() -> u64 {
    return wcbase.generation
}

fn theme_frame_begin() -> u64 {
    wcbase.frame_open = 1
    wcbase.paint_base = wcbase.live * wcbase.C_COUNT
    paint_gen = wcbase.generation
    return paint_gen
}

fn theme_frame_end() -> bool {
    wcbase.frame_open = 0
    let stale: bool = paint_gen != wcbase.generation
    wcbase.paint_base = wcbase.live * wcbase.C_COUNT
    return stale
}

fn theme_frame_stale() -> bool {
    return paint_gen != wcbase.generation
}

fn theme_dark() -> bool {
    return cur_dark != 0
}

fn theme_mode() -> u64 {
    return wcbase.set_mode
}

fn theme_scheme_mode() -> u64 {
    return wcbase.sch_mode
}

fn theme_high() -> bool {
    return wcbase.sch_high != 0
}

fn theme_accent_ok() -> bool {
    return wcbase.acc_ok != 0
}

fn theme_accent_exact() -> bool {
    return wcbase.acc_exact != 0
}

fn theme_accent_moved() -> u64 {
    return wcbase.acc_moved
}

fn theme_accent_ratio_text() -> u64 {
    return wcbase.acc_r_text
}

fn theme_accent_ratio_ui() -> u64 {
    return wcbase.acc_r_ui
}

fn theme_accent_own() -> u64 {
    if wcbase.set_accent == wcbase.ACCENT_BLACK {
        return wcbase.ACCENT_BLACK
    }
    return wcbase.set_accent
}

fn theme_accent_wanted() -> u64 {
    if wcbase.set_accent != 0 {
        if wcbase.set_accent == wcbase.ACCENT_BLACK {
            return 0
        }
        return wcbase.set_accent
    }
    return wcbase.sch_accent
}

fn theme_scheme_name() -> u64 {
    return (&wcbase.sch_name[0 as usize]) as u64
}

fn theme_scheme_file() -> u64 {
    return (&wcbase.sch_file[0 as usize]) as u64
}

fn theme_contrast(a: u64, b: u64) -> u64 {
    return wcpaint.contrast(a, b)
}

fn theme_luminance(c: u64) -> u64 {
    return wcpaint.luminance(c)
}

fn theme_linear(c: u64) -> u64 {
    if c > 255 {
        return 0
    }
    return wcpaint.lin_of(c)
}

fn theme_on(bg: u64) -> u64 {
    return wcpaint.pick_on(bg)
}

fn theme_light_start() -> u64 {
