profile kernel

import ulib
import actwire

export { u_start }

const MAX_S: u64 = 4
const SB: u64 = 336
const O_USED: u64 = 0
const O_STATE: u64 = 1
const O_PREV: u64 = 2
const O_NEXT: u64 = 3
const O_CMD: u64 = 4
const O_OWNER: u64 = 16
const O_APP: u64 = 48
const O_TITLE: u64 = 80
const O_ARTIST: u64 = 176
const O_COVER: u64 = 240
const O_TICK: u64 = 320
const OWNER_W: u64 = 32
const APP_W: u64 = 32
const TITLE_W: u64 = 96
const ARTIST_W: u64 = 64
const COVER_W: u64 = 80
const COVER_MAX: u64 = 65536
const ST_STOPPED: u64 = 0
const ST_PLAYING: u64 = 1
const ST_PAUSED: u64 = 2

static mut L0: [u8; 8] = "playing\0"
static mut L1: [u8; 7] = "paused\0"
static mut L2: [u8; 8] = "stopped\0"
static mut L3: [u8; 6] = "user:\0"
static mut L4: [u8; 3] = "ok\0"
static mut L5: [u8; 1] = "\0"
static mut L6: [u8; 8] = "@client\0"
static mut L7: [u8; 5] = "user\0"
static mut L8: [u8; 6] = "pong\n\0"
static mut L9: [u8; 8] = "a.media\0"
static mut L10: [u8; 26] = "mediad: a.media is taken\n\0"
static mut L11: [u8; 11] = "orient.bus\0"
static mut L12: [u8; 28] = "mediad: no orient.bus here\n\0"
static mut L13: [u8; 13] = "hello media\n\0"
static mut L14: [u8; 25] = "mediad: serving a.media\n\0"
static mut L15: [u8; 28] = "mediad: orient-bus is gone\n\0"
static mut L16: [u8; 6] = "serve\0"
static mut L17: [u8; 29] = "usage: mediad serve [ticks]\n\0"
static mut L18: [u8; 8] = "playing\0"
static mut L19: [u8; 7] = "paused\0"
static mut L20: [u8; 8] = "stopped\0"
static mut L21: [u8; 5] = "play\0"
static mut L22: [u8; 6] = "pause\0"
static mut L23: [u8; 7] = "toggle\0"
static mut L24: [u8; 5] = "next\0"
static mut L25: [u8; 5] = "prev\0"
static mut L26: [u8; 5] = "stop\0"
static mut L27: [u8; 5] = "user\0"
static mut L28: [u8; 6] = "user:\0"
static mut L29: [u8; 5] = "app:\0"
static mut L30: [u8; 7] = "owner=\0"
static mut L31: [u8; 5] = "app=\0"
static mut L32: [u8; 7] = "title=\0"
static mut L33: [u8; 8] = "artist=\0"
static mut L34: [u8; 7] = "cover=\0"
static mut L35: [u8; 7] = "state=\0"
static mut L36: [u8; 10] = "can_prev=\0"
static mut L37: [u8; 10] = "can_next=\0"
static mut L38: [u8; 4] = "app\0"
static mut L39: [u8; 6] = "title\0"
static mut L40: [u8; 7] = "artist\0"
static mut L41: [u8; 6] = "cover\0"
static mut L42: [u8; 6] = "state\0"
static mut L43: [u8; 41] = "err bad_arg title and state are required\0"
static mut L44: [u8; 13] = "err too_long\0"
static mut L45: [u8; 14] = "err bad_cover\0"
static mut L46: [u8; 9] = "err full\0"
static mut L47: [u8; 9] = "can_prev\0"
static mut L48: [u8; 9] = "can_next\0"
static mut L49: [u8; 15] = "err no_session\0"
static mut L50: [u8; 7] = "count=\0"
static mut L51: [u8; 4] = "cmd\0"
static mut L52: [u8; 16] = "err bad_arg cmd\0"
static mut L53: [u8; 6] = "owner\0"
static mut L54: [u8; 14] = "err not_owner\0"
static mut L55: [u8; 5] = "cmd=\0"
static mut L56: [u8; 11] = "published=\0"
static mut L57: [u8; 9] = "refused=\0"
static mut L58: [u8; 10] = "commands=\0"
static mut L59: [u8; 5] = "ping\0"
static mut L60: [u8; 14] = "media.publish\0"
static mut L61: [u8; 10] = "media.end\0"
static mut L62: [u8; 14] = "media.current\0"
static mut L63: [u8; 14] = "media.control\0"
static mut L64: [u8; 11] = "media.poll\0"
static mut L65: [u8; 11] = "media.stat\0"
static mut L66: [u8; 19] = "err unknown_action\0"
static mut sess: [u8; 1344] = [0 as u8; 1344]
static mut svc_bus: u64 = 0xFFFFFFFF
static mut stat_publish: u64 = 0
static mut stat_refused: u64 = 0
static mut stat_commands: u64 = 0

fn se(i: u64) -> u64 {
    return (&sess[0 as usize]) as u64 + i * SB
}

fn eq(a: u64, b: u64) -> bool {
    return actwire.str_eq(a, b)
}

fn has_prefix(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while actwire.ld8(b, i) != 0 {
        if actwire.ld8(a, i) != actwire.ld8(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn get(msg: u64, key: u64, out: u64, max: u64) -> bool {
    return actwire.kv_find(msg, key, out, max)
}

fn kv(k: u64, v: u64) {
    actwire.ob_str(k)
    actwire.ob_str(v)
    actwire.ob_ch(10)
}

fn kvn(k: u64, v: u64) {
    actwire.ob_str(k)
    actwire.ob_num(v)
    actwire.ob_ch(10)
}

fn fail(code: u64) {
    actwire.ob_reset()
    actwire.ob_line(code)
    stat_refused = stat_refused + 1
}

fn find_owner(owner: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_S {
        if actwire.ld8(se(i), O_USED) != 0 && actwire.str_eq(se(i) + O_OWNER, owner) {
            return i
        }
        i = i + 1
    }
    return actwire.NONE
}

fn free_slot() -> u64 {
    var i: u64 = 0
    while i < MAX_S {
        if actwire.ld8(se(i), O_USED) == 0 {
            return i
        }
        i = i + 1
    }
    return actwire.NONE
}

fn clear_slot(i: u64) {
    var k: u64 = 0
    while k < SB {
        actwire.st8(se(i), k, 0)
        k = k + 1
    }
}

fn active() -> u64 {
    var best: u64 = actwire.NONE
    var best_rank: u64 = 0
    var i: u64 = 0
    while i < MAX_S {
        if actwire.ld8(se(i), O_USED) != 0 {
            var rank: u64 = actwire.ld64(se(i), O_TICK) + 1
            if actwire.ld8(se(i), O_STATE) == ST_PLAYING {
                rank = rank + 0x100000000
            }
            if rank > best_rank {
                best_rank = rank
                best = i
            }
        }
        i = i + 1
    }
    return best
}

fn state_code(w: u64) -> u64 {
    if eq(w, (&L18[0 as usize]) as u64) {
        return ST_PLAYING
    }
    if eq(w, (&L19[0 as usize]) as u64) {
        return ST_PAUSED
    }
    if eq(w, (&L20[0 as usize]) as u64) {
        return ST_STOPPED
    }
    return actwire.NONE
}

fn state_word(c: u64) -> u64 {
    if c == ST_PLAYING {
        return (&L0[0 as usize]) as u64
    }
    if c == ST_PAUSED {
        return (&L1[0 as usize]) as u64
    }
    return (&L2[0 as usize]) as u64
}

fn cmd_ok(w: u64) -> bool {
    return eq(w, (&L21[0 as usize]) as u64) || eq(w, (&L22[0 as usize]) as u64) || eq(w, (&L23[0 as usize]) as u64) || eq(w, (&L24[0 as usize]) as u64)
        || eq(w, (&L25[0 as usize]) as u64) || eq(w, (&L26[0 as usize]) as u64)
}

fn owner_key(client: u64, app: u64, out: u64) {
    if eq(client, (&L27[0 as usize]) as u64) {
        var n: u64 = 0
        var pre: u64 = (&L3[0 as usize]) as u64
        while actwire.ld8(pre, n) != 0 {
            actwire.st8(out, n, actwire.ld8(pre, n))
            n = n + 1
        }
        var j: u64 = 0
        while actwire.ld8(app, j) != 0 && n + 1 < OWNER_W {
            actwire.st8(out, n, actwire.ld8(app, j))
            n = n + 1
            j = j + 1
        }
        actwire.st8(out, n, 0)
        return
    }
    ulib.strncpy(out, client, OWNER_W)
}

fn display_app(owner: u64, app: u64, out: u64) {
    if actwire.slen(app) > 0 && has_prefix(owner, (&L28[0 as usize]) as u64) {
        ulib.strncpy(out, app, APP_W)
        return
    }
    if has_prefix(owner, (&L29[0 as usize]) as u64) {
        ulib.strncpy(out, owner + 4, APP_W)
        return
    }
    ulib.strncpy(out, owner, APP_W)
}

fn clean_cover(path: u64) -> bool {
    if actwire.slen(path) == 0 {
        return true
    }
    if actwire.ld8(path, 0) != 47 || actwire.slen(path) >= COVER_W {
        return false
    }
    var i: u64 = 0
    while actwire.ld8(path, i) != 0 {
        if actwire.ld8(path, i) == 46 && actwire.ld8(path, i + 1) == 46 {
            return false
        }
        i = i + 1
    }
    let sz: u64 = ulib.size_of(path)
    return !ulib.bad(sz) && sz <= COVER_MAX
}

fn report(i: u64) {
    let s: u64 = se(i)
    kv((&L30[0 as usize]) as u64, s + O_OWNER)
    kv((&L31[0 as usize]) as u64, s + O_APP)
    kv((&L32[0 as usize]) as u64, s + O_TITLE)
    kv((&L33[0 as usize]) as u64, s + O_ARTIST)
    kv((&L34[0 as usize]) as u64, s + O_COVER)
    kv((&L35[0 as usize]) as u64, state_word(actwire.ld8(s, O_STATE)))
    kvn((&L36[0 as usize]) as u64, actwire.ld8(s, O_PREV))
    kvn((&L37[0 as usize]) as u64, actwire.ld8(s, O_NEXT))
}

fn do_publish(msg: u64, client: u64) {
    var app: [u8; 40] = [0 as u8; 40]
    var title: [u8; 128] = [0 as u8; 128]
    var artist: [u8; 96] = [0 as u8; 96]
    var cover: [u8; 128] = [0 as u8; 128]
    var stw: [u8; 16] = [0 as u8; 16]
    var num: [u8; 8] = [0 as u8; 8]
    var owner: [u8; 40] = [0 as u8; 40]
    let ap: u64 = (&app[0 as usize]) as u64
    let tp: u64 = (&title[0 as usize]) as u64
    let rp: u64 = (&artist[0 as usize]) as u64
    let cp: u64 = (&cover[0 as usize]) as u64
    let sp: u64 = (&stw[0 as usize]) as u64
    let np: u64 = (&num[0 as usize]) as u64
    let op: u64 = (&owner[0 as usize]) as u64
    get(msg, (&L38[0 as usize]) as u64, ap, 40)
    get(msg, (&L39[0 as usize]) as u64, tp, 128)
    get(msg, (&L40[0 as usize]) as u64, rp, 96)
    get(msg, (&L41[0 as usize]) as u64, cp, 128)
    get(msg, (&L42[0 as usize]) as u64, sp, 16)
    let code: u64 = state_code(sp)
    if actwire.slen(tp) == 0 || code == actwire.NONE {
        fail((&L43[0 as usize]) as u64)
        return
    }
    if actwire.slen(tp) >= TITLE_W || actwire.slen(rp) >= ARTIST_W {
        fail((&L44[0 as usize]) as u64)
        return
    }
    if !clean_cover(cp) {
        fail((&L45[0 as usize]) as u64)
        return
    }
    owner_key(client, ap, op)
    var i: u64 = find_owner(op)
    if i == actwire.NONE {
        i = free_slot()
        if i == actwire.NONE {
            fail((&L46[0 as usize]) as u64)
            return
        }
        clear_slot(i)
        actwire.st8(se(i), O_USED, 1)
        ulib.strncpy(se(i) + O_OWNER, op, OWNER_W)
        display_app(op, ap, se(i) + O_APP)
        actwire.st8(se(i), O_PREV, 1)
        actwire.st8(se(i), O_NEXT, 1)
    }
    let s: u64 = se(i)
    ulib.strncpy(s + O_TITLE, tp, TITLE_W)
    ulib.strncpy(s + O_ARTIST, rp, ARTIST_W)
    ulib.strncpy(s + O_COVER, cp, COVER_W)
    actwire.st8(s, O_STATE, code)
    if get(msg, (&L47[0 as usize]) as u64, np, 8) {
        actwire.st8(s, O_PREV, ulib.to_num(np) & 1)
    }
    if get(msg, (&L48[0 as usize]) as u64, np, 8) {
        actwire.st8(s, O_NEXT, ulib.to_num(np) & 1)
    }
    actwire.st64(s, O_TICK, actwire.ticks())
    stat_publish = stat_publish + 1
    actwire.ob_reset()
    actwire.ob_line((&L4[0 as usize]) as u64)
    kv((&L30[0 as usize]) as u64, s + O_OWNER)
}

fn do_end(client: u64, msg: u64) {
    var app: [u8; 40] = [0 as u8; 40]
    var owner: [u8; 40] = [0 as u8; 40]
    get(msg, (&L38[0 as usize]) as u64, (&app[0 as usize]) as u64, 40)
    owner_key(client, (&app[0 as usize]) as u64, (&owner[0 as usize]) as u64)
    let i: u64 = find_owner((&owner[0 as usize]) as u64)
    if i == actwire.NONE {
        fail((&L49[0 as usize]) as u64)
        return
    }
    clear_slot(i)
    actwire.ob_reset()
    actwire.ob_line((&L4[0 as usize]) as u64)
}

fn do_current() {
    actwire.ob_reset()
    actwire.ob_line((&L4[0 as usize]) as u64)
    var n: u64 = 0
    var i: u64 = 0
    while i < MAX_S {
        if actwire.ld8(se(i), O_USED) != 0 {
            n = n + 1
        }
        i = i + 1
    }
    kvn((&L50[0 as usize]) as u64, n)
    let a: u64 = active()
    if a != actwire.NONE {
        report(a)
    }
}

fn do_control(msg: u64, client: u64) {
    var cmd: [u8; 16] = [0 as u8; 16]
    var target: [u8; 40] = [0 as u8; 40]
    let cp: u64 = (&cmd[0 as usize]) as u64
    let tp: u64 = (&target[0 as usize]) as u64
    get(msg, (&L51[0 as usize]) as u64, cp, 16)
    if !cmd_ok(cp) {
        fail((&L52[0 as usize]) as u64)
        return
    }
    var i: u64 = actwire.NONE
    if get(msg, (&L53[0 as usize]) as u64, tp, 40) && actwire.slen(tp) > 0 {
        i = find_owner(tp)
    } else {
        i = active()
    }
    if i == actwire.NONE {
        fail((&L49[0 as usize]) as u64)
        return
    }
    if has_prefix(client, (&L29[0 as usize]) as u64) && !actwire.str_eq(client, se(i) + O_OWNER) {
        fail((&L54[0 as usize]) as u64)
        return
    }
    ulib.strncpy(se(i) + O_CMD, cp, 12)
    stat_commands = stat_commands + 1
    actwire.ob_reset()
    actwire.ob_line((&L4[0 as usize]) as u64)
    kv((&L30[0 as usize]) as u64, se(i) + O_OWNER)
    kv((&L55[0 as usize]) as u64, cp)
}

fn do_poll(msg: u64, client: u64) {
    var app: [u8; 40] = [0 as u8; 40]
    var owner: [u8; 40] = [0 as u8; 40]
    get(msg, (&L38[0 as usize]) as u64, (&app[0 as usize]) as u64, 40)
    owner_key(client, (&app[0 as usize]) as u64, (&owner[0 as usize]) as u64)
    let i: u64 = find_owner((&owner[0 as usize]) as u64)
    if i == actwire.NONE {
        fail((&L49[0 as usize]) as u64)
        return
    }
    actwire.ob_reset()
    actwire.ob_line((&L4[0 as usize]) as u64)
    let c: u64 = se(i) + O_CMD
    if actwire.ld8(c, 0) != 0 {
        kv((&L55[0 as usize]) as u64, c)
        actwire.st8(c, 0, 0)
    } else {
        kv((&L55[0 as usize]) as u64, (&L5[0 as usize]) as u64)
    }
}

fn do_stat() {
    actwire.ob_reset()
    actwire.ob_line((&L4[0 as usize]) as u64)
    kvn((&L56[0 as usize]) as u64, stat_publish)
    kvn((&L57[0 as usize]) as u64, stat_refused)
    kvn((&L58[0 as usize]) as u64, stat_commands)
}

fn handle(msg: u64) {
    var verb: [u8; 16] = [0 as u8; 16]
    var name: [u8; 40] = [0 as u8; 40]
    var client: [u8; 40] = [0 as u8; 40]
    let vp: u64 = (&verb[0 as usize]) as u64
    let np: u64 = (&name[0 as usize]) as u64
    let cl: u64 = (&client[0 as usize]) as u64
    let nx: u64 = actwire.word_copy(msg, 0, vp, 16)
    actwire.word_copy(msg, nx, np, 40)
    if !actwire.kv_find(msg, (&L6[0 as usize]) as u64, cl, 40) {
        ulib.strncpy(cl, (&L7[0 as usize]) as u64, 40)
    }
    if eq(vp, (&L59[0 as usize]) as u64) {
        actwire.ob_reset()
        actwire.ob_str((&L8[0 as usize]) as u64)
        return
    }
    if eq(np, (&L60[0 as usize]) as u64) {
        do_publish(msg, cl)
    } else if eq(np, (&L61[0 as usize]) as u64) {
        do_end(cl, msg)
    } else if eq(np, (&L62[0 as usize]) as u64) {
        do_current()
    } else if eq(np, (&L63[0 as usize]) as u64) {
        do_control(msg, cl)
    } else if eq(np, (&L64[0 as usize]) as u64) {
        do_poll(msg, cl)
    } else if eq(np, (&L65[0 as usize]) as u64) {
        do_stat()
    } else {
        fail((&L66[0 as usize]) as u64)
    }
}

fn serve(limit: u64) -> u64 {
    let me: u64 = actwire.bus_reg((&L9[0 as usize]) as u64, actwire.A_ROOT)
    if ulib.bad(me) {
        actwire.out((&L10[0 as usize]) as u64)
        return 1
    }
    let t0: u64 = actwire.ticks()
    svc_bus = actwire.bus_find((&L11[0 as usize]) as u64)
    while ulib.bad(svc_bus) && actwire.ticks() - t0 < 500 {
        actwire.yield_now()
        svc_bus = actwire.bus_find((&L11[0 as usize]) as u64)
    }
    if ulib.bad(svc_bus) {
        actwire.out((&L12[0 as usize]) as u64)
        return 1
    }
    actwire.send_msg(svc_bus, actwire.K_REQ, actwire.rnd() & 0xFFFFFFFF, (&L13[0 as usize]) as u64, 12)
    actwire.out((&L14[0 as usize]) as u64)
    var fr: [u8; 64] = [0 as u8; 64]
    var meta: [u64; 6] = [0 as u64; 6]
    let fp: u64 = (&fr[0 as usize]) as u64
    let mp: u64 = (&meta[0 as usize]) as u64
    let t1: u64 = actwire.ticks()
    var last_check: u64 = t1
    while limit == 0 || actwire.ticks() - t1 < limit {
        let n: u64 = actwire.bus_wait(fp, mp, 100)
        if !ulib.bad(n) && n > 0 {
            let s: u64 = actwire.asm_feed(fp, mp)
            if s != actwire.NONE {
                if actwire.asm_kind(s) == actwire.K_REQ {
                    let id: u64 = actwire.asm_id(s)
                    handle(actwire.asm_buf(s))
                    actwire.send_msg(svc_bus, actwire.K_REP, id, actwire.ob_ptr(), actwire.ob_len())
                }
                actwire.asm_free(s)
            }
        } else if actwire.ticks() - last_check > 100 {
            last_check = actwire.ticks()
            if ulib.bad(actwire.bus_find((&L11[0 as usize]) as u64)) {
                actwire.out((&L15[0 as usize]) as u64)
                return 0
            }
        }
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    if ulib.arg_count(args) >= 2 && actwire.str_eq(ulib.arg_at(args, 1), (&L16[0 as usize]) as u64) {
        var lim: u64 = 0
        if ulib.arg_count(args) >= 3 {
            lim = ulib.to_num(ulib.arg_at(args, 2))
        }
        return serve(lim)
    }
    actwire.out((&L17[0 as usize]) as u64)
    return 1
}
