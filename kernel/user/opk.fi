// ------------------------------------------------------ Kleinigkeiten

fn g8(p: u64) -> u64 {
    return (*((p) as *mut u8)) as u64
}

fn p8(p: u64, v: u64) {
    __mmio_write8((p) as *mut u8, v as u8)
}

fn g64(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 8 {
        v = v | (g8(p + i) << (i * 8))
        i = i + 1
    }
    return v
}

fn g16(p: u64) -> u64 {
    return g8(p) | (g8(p + 1) << 8)
}

fn len(p: u64) -> u64 {
    var n: u64 = 0
    while g8(p + n) != 0 {
        n = n + 1
    }
    return n
}

fn path2(out: u64, a: u64, b: u64) {
    ulib.strcpy(out, a)
    ulib.strcat(out, b)
}

fn slash(out: u64) {
    var s: [u8; 2] = "/\0"
    ulib.strcat(out, (&s[0 as usize]) as u64)
}

fn num_at(out: u64, v: u64) {
    var b: [u8; 24] = [0 as u8; 24]
    ulib.digits(v, (&b[0 as usize]) as u64)
    ulib.strcat(out, (&b[0 as usize]) as u64)
}

fn sagn(t: u64, v: u64) {
    ulib.say(t)
    ulib.sayu(v)
    ulib.nl()
}

fn err(t: u64, was: u64) -> u64 {
    ulib.eput(t)
    if was != 0 {
        ulib.eput(was)
    }
    var nl: [u8; 2] = "\n\0"
    ulib.eput((&nl[0 as usize]) as u64)
    return 1
}

// -------------------------------------------------------- Dateien

fn file_read(path: u64, buffer: u64, max: u64) -> u64 {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, 0, 0)
    if ulib.bad(fd) {
        return 0xFFFFFFFFFFFFFFFF
    }
    var n: u64 = 0
    var keep_going: bool = true
    while keep_going {
        let r: u64 = ulib.sys(ulib.SYS_READ, fd, buffer + n, max - n)
        if ulib.bad(r) || r == 0 {
            keep_going = false
        } else {
            n = n + r
            if n >= max {
                keep_going = false
            }
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return n
}

fn file_write(path: u64, buffer: u64, len: u64) -> bool {
    ulib.sys(ulib.SYS_UNLINK, path, 0, 0)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, ulib.O_MAKE, 0)
    if ulib.bad(fd) {
        return false
    }
    var n: u64 = 0
    while n < len {
        let w: u64 = ulib.sys(ulib.SYS_WRITE, fd, buffer + n, len - n)
        if ulib.bad(w) || w == 0 {
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
            return false
        }
        n = n + w
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return true
}

fn commit_write(path: u64, buffer: u64, len: u64) -> bool {
    var fd: u64 = ulib.sys(ulib.SYS_OPEN, path, ulib.O_RDWR, 0)
    if ulib.bad(fd) {
        fd = ulib.sys(ulib.SYS_OPEN, path, ulib.O_MAKE, 0)
        if ulib.bad(fd) {
            return false
        }
    }
    ulib.sys(ulib.SYS_SEEK, fd, 0, ulib.SEEK_SET)
    var n: u64 = 0
    while n < len {
        let w: u64 = ulib.sys(ulib.SYS_WRITE, fd, buffer + n, len - n)
        if ulib.bad(w) || w == 0 {
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
            return false
        }
        n = n + w
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return true
}

fn da(path: u64) -> bool {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, 0, 0)
    if ulib.bad(fd) {
        return false
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return true
}

fn mkdir(path: u64) {
    ulib.sys(ulib.SYS_MKDIR, path, 0, 0)
}

fn remove(path: u64) {
    var ents: [u8; 2048] = [0 as u8; 2048]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, 0, 0)
    if ulib.bad(fd) {
        ulib.sys(ulib.SYS_UNLINK, path, 0, 0)
        return
    }
    let n: u64 = ulib.sys(217, fd, (&ents[0 as usize]) as u64, 2048)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if !ulib.bad(n) && n > 0 {
        var at: u64 = 0
        while at + 19 < n {
            let rl: u64 = g16((&ents[0 as usize]) as u64 + at + 16)
            if rl == 0 {
                at = n
            } else {
                let nm: u64 = (&ents[0 as usize]) as u64 + at + 19
                var punkt: [u8; 2] = ".\0"
                var punkt2: [u8; 3] = "..\0"
                if !ulib.streq(nm, (&punkt[0 as usize]) as u64)
                    && !ulib.streq(nm, (&punkt2[0 as usize]) as u64) {
                    var kind: [u8; 256] = [0 as u8; 256]
                    ulib.strcpy((&kind[0 as usize]) as u64, path)
                    slash((&kind[0 as usize]) as u64)
                    ulib.strcat((&kind[0 as usize]) as u64, nm)
                    remove((&kind[0 as usize]) as u64)
                }
                at = at + rl
            }
        }
    }
    // a directory goes with RMDIR (UNLINK leaves it behind, empty); a plain file with UNLINK
    ulib.sys(ulib.SYS_RMDIR, path, 0, 0)
    ulib.sys(ulib.SYS_UNLINK, path, 0, 0)
}

// ---------------------------------------------------- die Metadaten
fn meta_value(meta: u64, mlen: u64, schl: u64, out: u64, max: u64) -> bool {
    let sl: u64 = len(schl)
    var i: u64 = 0
    while i < mlen {
        // Zeilenanfang?
        if i == 0 || g8(meta + i - 1) == 10 {
            if i + sl <= mlen && ulib.strneq(meta + i, schl, sl) {
                var k: u64 = 0
                var j: u64 = i + sl
                while j < mlen && g8(meta + j) != 10 && k + 1 < max {
                    p8(out + k, g8(meta + j))
                    k = k + 1
                    j = j + 1
                }
                p8(out + k, 0)
                return true
            }
        }
        i = i + 1
    }
    return false
}

// --------------------------------------------------------- der PLAN

fn plan_lines(plan: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while g8(plan + i) != 0 {
        if g8(plan + i) == 10 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn plan_line(plan: u64, k: u64, name: u64, hash: u64) -> bool {
    var line: u64 = 0
    var i: u64 = 0
    while line < k && g8(plan + i) != 0 {
        if g8(plan + i) == 10 {
            line = line + 1
        }
        i = i + 1
    }
    if g8(plan + i) == 0 {
        return false
    }
    var j: u64 = 0
    while g8(plan + i) != 9 && g8(plan + i) != 10 && g8(plan + i) != 0 {
        if name != 0 {
            p8(name + j, g8(plan + i))
        }
        j = j + 1
        i = i + 1
    }
    if name != 0 {
        p8(name + j, 0)
    }
    if g8(plan + i) != 9 {
        return false
    }
    i = i + 1
    j = 0
    while g8(plan + i) != 10 && g8(plan + i) != 0 {
        if hash != 0 {
            p8(hash + j, g8(plan + i))
        }
        j = j + 1
        i = i + 1
    }
    if hash != 0 {
        p8(hash + j, 0)
    }
    return true
}

fn plan_hash(plan: u64, name: u64, out: u64) -> bool {
    var nm: [u8; 64] = [0 as u8; 64]
    let n: u64 = plan_lines(plan)
    var k: u64 = 0
    while k < n {
        if plan_line(plan, k, (&nm[0 as usize]) as u64, out) {
            if ulib.streq((&nm[0 as usize]) as u64, name) {
                return true
            }
        }
        k = k + 1
    }
    return false
}

fn plan_set(plan: u64, name: u64, hash: u64) {
    var nm: [u8; 64] = [0 as u8; 64]
    var hs: [u8; 72] = [0 as u8; 72]
    let out: u64 = (&PLAN2[0 as usize]) as u64
    p8(out, 0)
    let n: u64 = plan_lines(plan)
    var k: u64 = 0
    var gesetzt: bool = false
    while k < n {
        if plan_line(plan, k, (&nm[0 as usize]) as u64,
            (&hs[0 as usize]) as u64) {
            let c: u64 = ulib.cmp((&nm[0 as usize]) as u64, name)
            if c == 0 {
                k = k
            } else {
                if c > 0 && !gesetzt && hash != 0 {
                    line_at(out, name, hash)
                    gesetzt = true
                }
                line_at(out, (&nm[0 as usize]) as u64,
                    (&hs[0 as usize]) as u64)
            }
        }
        k = k + 1
    }
    if !gesetzt && hash != 0 {
        line_at(out, name, hash)
    }
    ulib.strcpy(plan, out)
}

fn line_at(out: u64, name: u64, hash: u64) {
    var tab: [u8; 2] = "\t\0"
    var nl: [u8; 2] = "\n\0"
    ulib.strcat(out, name)
    ulib.strcat(out, (&tab[0 as usize]) as u64)
    ulib.strcat(out, hash)
    ulib.strcat(out, (&nl[0 as usize]) as u64)
}

// ----------------------------------------------------- Generationen

fn gen_path(out: u64, n: u64, file: u64) {
    ulib.strcpy(out, (&P_GENS[0 as usize]) as u64)
    slash(out)
    num_at(out, n)
    if file != 0 {
        slash(out)
        ulib.strcat(out, file)
    }
}

fn current() -> u64 {
    var b: [u8; 32] = [0 as u8; 32]
    let n: u64 = file_read((&P_AKT[0 as usize]) as u64,
        (&b[0 as usize]) as u64, 31)
    if n == 0 || n == 0xFFFFFFFFFFFFFFFF {
        return 0xFFFFFFFFFFFFFFFF
    }
    p8((&b[0 as usize]) as u64 + n, 0)
    return ulib.to_num((&b[0 as usize]) as u64)
}

fn current_set(n: u64) -> bool {
    var b: [u8; 16] = [0 as u8; 16]
    var v: u64 = n
    var i: u64 = 8
    while i > 0 {
        i = i - 1
        b[i as usize] = (48 + (v % 10)) as u8
        v = v / 10
    }
    b[8 as usize] = 10 as u8
    b[9 as usize] = 0 as u8
    return commit_write((&P_AKT[0 as usize]) as u64,
        (&b[0 as usize]) as u64, 9)
}

// ------------------------------------------------- DIE ERPROBUNG
//     gen=00000007 vor=00000006 v=01 ok=0\n
fn erp_build(b: u64, gen: u64, before: u64, v: u64, ok: u64) {
    var muster: [u8; 37] = "gen=00000000 vor=00000000 v=00 ok=0\n\0"
    var i: u64 = 0
    while i < 36 {
        p8(b + i, muster[i as usize] as u64)
        i = i + 1
    }
    erp_num(b, 4, 8, gen)
    erp_num(b, 17, 8, before)
    erp_num(b, 28, 2, v)
    erp_num(b, 34, 1, ok)
}

fn erp_num(b: u64, off: u64, n: u64, v: u64) {
    var rest: u64 = v
    var i: u64 = n
    while i > 0 {
        i = i - 1
        p8(b + off + i, 48 + (rest % 10))
        rest = rest / 10
    }
}

fn erp_ziffern(b: u64, off: u64, n: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < n {
        let c: u64 = g8(b + off + i)
        if c < 48 || c > 57 {
            return 0xFFFFFFFFFFFFFFFF
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

fn erp_write(gen: u64, before: u64, v: u64, ok: u64) -> bool {
    var b: [u8; 40] = [0 as u8; 40]
    erp_build((&b[0 as usize]) as u64, gen, before, v, ok)
    return commit_write((&P_ERP[0 as usize]) as u64,
        (&b[0 as usize]) as u64, 36)
}

fn erp_read(gen: *mut u64, before: *mut u64, v: *mut u64, ok: *mut u64)
    -> bool {
    var b: [u8; 40] = [0 as u8; 40]
    let n: u64 = file_read((&P_ERP[0 as usize]) as u64,
        (&b[0 as usize]) as u64, 36)
    if n != 36 {
        return false
    }
    let p: u64 = (&b[0 as usize]) as u64
    *gen = erp_ziffern(p, 4, 8)
    *before = erp_ziffern(p, 17, 8)
    *v = erp_ziffern(p, 28, 2)
    *ok = erp_ziffern(p, 34, 1)
    if *gen == 0xFFFFFFFFFFFFFFFF || *before == 0xFFFFFFFFFFFFFFFF {
        return false
    }
    if *v == 0xFFFFFFFFFFFFFFFF || *ok == 0xFFFFFFFFFFFFFFFF {
        return false
    }
    return true
}

fn gen_hoechste() -> u64 {
    var ents: [u8; 4096] = [0 as u8; 4096]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&P_GENS[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return 0xFFFFFFFFFFFFFFFF
    }
    let n: u64 = ulib.sys(217, fd, (&ents[0 as usize]) as u64, 4096)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return 0xFFFFFFFFFFFFFFFF
    }
    var up: u64 = 0xFFFFFFFFFFFFFFFF
    var at: u64 = 0
    while at + 19 < n {
        let rl: u64 = g16((&ents[0 as usize]) as u64 + at + 16)
        if rl == 0 {
            at = n
        } else {
            let nm: u64 = (&ents[0 as usize]) as u64 + at + 19
            if g8(nm) >= 48 && g8(nm) <= 57 {
                let v: u64 = ulib.to_num(nm)
                if up == 0xFFFFFFFFFFFFFFFF || v > up {
                    up = v
                }
            }
            at = at + rl
        }
    }
    return up
}

fn plan_read(n: u64, out: u64) -> bool {
    gen_path((&PATH[0 as usize]) as u64, n, (&N_PLAN[0 as usize]) as u64)
    let r: u64 = file_read((&PATH[0 as usize]) as u64, out, 8000)
    if r == 0xFFFFFFFFFFFFFFFF {
        p8(out, 0)
        return false
    }
    p8(out + r, 0)
    return true
}

fn plan_write(n: u64, plan: u64, reason: u64) -> bool {
    gen_path((&PATH[0 as usize]) as u64, n, 0)
    mkdir((&PATH[0 as usize]) as u64)
    gen_path((&PATH[0 as usize]) as u64, n, (&N_PLAN[0 as usize]) as u64)
    if !file_write((&PATH[0 as usize]) as u64, plan, len(plan)) {
        return false
    }
    gen_path((&PATH[0 as usize]) as u64, n, (&N_REASON[0 as usize]) as u64)
    var z: [u8; 128] = [0 as u8; 128]
    ulib.strncpy((&z[0 as usize]) as u64, reason, 120)
    var nl: [u8; 2] = "\n\0"
    ulib.strcat((&z[0 as usize]) as u64, (&nl[0 as usize]) as u64)
    return file_write((&PATH[0 as usize]) as u64,
        (&z[0 as usize]) as u64, len((&z[0 as usize]) as u64))
}

// ------------------------------------------------------------- Store

fn store_path(out: u64, hex: u64, file: u64) {
    ulib.strcpy(out, (&P_STORE[0 as usize]) as u64)
    slash(out)
    var k: [u8; 32] = [0 as u8; 32]
    ulib.strncpy((&k[0 as usize]) as u64, hex, SHORT + 1)
    ulib.strcat(out, (&k[0 as usize]) as u64)
    if file != 0 {
        slash(out)
        ulib.strcat(out, file)
    }
}

fn archive_unpack(data: u64, dlen: u64, target: u64) -> bool {
    var i: u64 = 0
    while i < dlen {
        if i + 5 > dlen {
            return false
        }
        let typ: u64 = g8(data + i)
        let modus: u64 = g16(data + i + 1)
        let nl: u64 = g16(data + i + 3)
        i = i + 5
        if i + nl + 8 > dlen {
            return false
        }
        var nm: [u8; 128] = [0 as u8; 128]
        var k: u64 = 0
        while k < nl && k < 127 {
            nm[k as usize] = g8(data + i + k) as u8
            k = k + 1
        }
        nm[k as usize] = 0 as u8
        i = i + nl
        let il: u64 = g64(data + i)
        i = i + 8
        if i + il > dlen {
            return false
        }
        ulib.strcpy((&PATH2[0 as usize]) as u64, target)
        slash((&PATH2[0 as usize]) as u64)
        ulib.strcat((&PATH2[0 as usize]) as u64, (&nm[0 as usize]) as u64)
        if typ == 100 {
            mkdir((&PATH2[0 as usize]) as u64)
        } else {
            if !file_write((&PATH2[0 as usize]) as u64, data + i, il) {
                return false
            }
            ulib.sys(90, (&PATH2[0 as usize]) as u64, modus, 0)
        }
        i = i + il
    }
    return true
}

// ------------------------------------------------------- die Sicht
fn verweisen(source: u64, target: u64) -> u64 {
    var ents: [u8; 2048] = [0 as u8; 2048]
    var gemacht: u64 = 0
    mkdir(target)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, source, 0, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = ulib.sys(217, fd, (&ents[0 as usize]) as u64, 2048)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return 0
    }
    var at: u64 = 0
    while at + 19 < n {
        let rl: u64 = g16((&ents[0 as usize]) as u64 + at + 16)
        if rl == 0 {
            at = n
        } else {
            let nm: u64 = (&ents[0 as usize]) as u64 + at + 19
            var punkt: [u8; 2] = ".\0"
            var punkt2: [u8; 3] = "..\0"
            if !ulib.streq(nm, (&punkt[0 as usize]) as u64)
                && !ulib.streq(nm, (&punkt2[0 as usize]) as u64)
                && !ulib.streq(nm, (&N_PACKAGE[0 as usize]) as u64)
                && !ulib.streq(nm, (&N_SYSTEM[0 as usize]) as u64) {
                var q: [u8; 256] = [0 as u8; 256]
                var z: [u8; 256] = [0 as u8; 256]
                ulib.strcpy((&q[0 as usize]) as u64, source)
                slash((&q[0 as usize]) as u64)
                ulib.strcat((&q[0 as usize]) as u64, nm)
                ulib.strcpy((&z[0 as usize]) as u64, target)
                slash((&z[0 as usize]) as u64)
                ulib.strcat((&z[0 as usize]) as u64, nm)
                if ulib.is_dir((&q[0 as usize]) as u64) {
                    gemacht = gemacht + verweisen((&q[0 as usize]) as u64,
                        (&z[0 as usize]) as u64)
                } else {
                    let r: u64 = ulib.sys(ulib.SYS_LINK,
                        (&q[0 as usize]) as u64, (&z[0 as usize]) as u64, 0)
                    if !ulib.bad(r) {
                        gemacht = gemacht + 1
                    }
                }
            }
            at = at + rl
        }
    }
    return gemacht
}

fn bundle_is_image(bundle: u64) -> bool {
    var marker: [u8; 256] = [0 as u8; 256]
    ulib.strcpy((&marker[0 as usize]) as u64, bundle)
    slash((&marker[0 as usize]) as u64)
    ulib.strcat((&marker[0 as usize]) as u64, (&N_SYSTEM[0 as usize]) as u64)
    return da((&marker[0 as usize]) as u64)
}

fn name_is_bundle(nm: u64) -> bool {
    let n: u64 = len(nm)
    if n < 5 {
        return false
    }
    return ulib.streq(nm + n - 4, (&N_OSP[0 as usize]) as u64)
}

fn apps_clear() {
    var ents: [u8; 2048] = [0 as u8; 2048]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&P_APPS[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let n: u64 = ulib.sys(217, fd, (&ents[0 as usize]) as u64, 2048)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return
    }
    var at: u64 = 0
    while at + 19 < n {
        let rl: u64 = g16((&ents[0 as usize]) as u64 + at + 16)
        if rl == 0 {
            at = n
        } else {
            let nm: u64 = (&ents[0 as usize]) as u64 + at + 19
            if name_is_bundle(nm) {
                var path: [u8; 256] = [0 as u8; 256]
                ulib.strcpy((&path[0 as usize]) as u64, (&P_APPS[0 as usize]) as u64)
                slash((&path[0 as usize]) as u64)
                ulib.strcat((&path[0 as usize]) as u64, nm)
                if !bundle_is_image((&path[0 as usize]) as u64) {
                    remove((&path[0 as usize]) as u64)
                }
            }
            at = at + rl
        }
    }
}

fn apps_build(gen: u64) -> u64 {
    var nm: [u8; 64] = [0 as u8; 64]
    var hs: [u8; 72] = [0 as u8; 72]
    let plan: u64 = (&PLAN[0 as usize]) as u64
    if !plan_read(gen, plan) {
        err((&E_PLAN[0 as usize]) as u64, 0)
        return 0xFFFFFFFFFFFFFFFF
    }
    apps_clear()
    mkdir((&P_APPS[0 as usize]) as u64)
    var verweise: u64 = 0
    let n: u64 = plan_lines(plan)
    var k: u64 = 0
    while k < n {
        if plan_line(plan, k, (&nm[0 as usize]) as u64,
            (&hs[0 as usize]) as u64) {
            store_path((&PATH[0 as usize]) as u64, (&hs[0 as usize]) as u64, 0)
            if !ulib.is_dir((&PATH[0 as usize]) as u64) {
                err((&E_STORE[0 as usize]) as u64, (&nm[0 as usize]) as u64)
                return 0xFFFFFFFFFFFFFFFF
            }
            var z: [u8; 128] = [0 as u8; 128]
            ulib.strcpy((&z[0 as usize]) as u64, (&P_APPS[0 as usize]) as u64)
            slash((&z[0 as usize]) as u64)
            ulib.strcat((&z[0 as usize]) as u64, (&nm[0 as usize]) as u64)
            ulib.strcat((&z[0 as usize]) as u64, (&N_OSP[0 as usize]) as u64)
            if bundle_is_image((&z[0 as usize]) as u64) {
                remove((&z[0 as usize]) as u64)
            }
            verweise = verweise + verweisen((&PATH[0 as usize]) as u64,
                (&z[0 as usize]) as u64)
        }
        k = k + 1
    }
    bus_reload()
    return verweise
}

// ROUND ACTION-BUS-4 (AB-018): /apps is new -- tell the broker, so an
// installed app is callable at once and a removed one is gone, without a
// restart. No broker (an image without one, a test guest): nothing to do.
fn bus_reload() {
    if !actcli.open() {
        return
    }
    var v: [u8; 7] = "reload\0"
    actcli.req((&v[0 as usize]) as u64)
    let rc: u64 = actcli.send(300)
    var s1: [u8; 30] = "opk: bus catalogue reload rc=\0"
    ulib.say((&s1[0 as usize]) as u64)
    ulib.sayu(rc)
    ulib.nl()
}

fn toepfe(name: u64, create: bool) {
    mkdir((&P_USERS[0 as usize]) as u64)
    mkdir((&P_ROOT[0 as usize]) as u64)
    var i: u64 = 0
    while i < 3 {
        var t: u64 = (&T_CONF[0 as usize]) as u64
        if i == 1 {
            t = (&T_STATE[0 as usize]) as u64
        }
        if i == 2 {
            t = (&T_CACHE[0 as usize]) as u64
        }
        ulib.strcpy((&PATH[0 as usize]) as u64, (&P_ROOT[0 as usize]) as u64)
        slash((&PATH[0 as usize]) as u64)
        ulib.strcat((&PATH[0 as usize]) as u64, t)
        mkdir((&PATH[0 as usize]) as u64)
        slash((&PATH[0 as usize]) as u64)
        ulib.strcat((&PATH[0 as usize]) as u64, name)
        if create {
            mkdir((&PATH[0 as usize]) as u64)
        } else {
            remove((&PATH[0 as usize]) as u64)
        }
        i = i + 1
    }
}

// ------------------------------------------------- DIE SIGNATUR

fn key_get() -> bool {
    let n: u64 = file_read((&P_KEY[0 as usize]) as u64,
        (&KEY[0 as usize]) as u64, 32)
    if n == 0xFFFFFFFFFFFFFFFF || n == 0 {
        err((&E_NOKEY[0 as usize]) as u64, 0)
        return false
    }
    if n != 32 {
        err((&E_KEYLEN[0 as usize]) as u64, 0)
        return false
    }
    return true
}

fn signature_get(path: u64, endung: u64) -> bool {
    ulib.strcpy((&SIGP[0 as usize]) as u64, path)
    if endung != 0 {
        ulib.strcat((&SIGP[0 as usize]) as u64, endung)
    }
    let n: u64 = file_read((&SIGP[0 as usize]) as u64,
        (&SIG[0 as usize]) as u64, 64)
    if n == 0xFFFFFFFFFFFFFFFF || n == 0 {
        err((&E_NOSIG[0 as usize]) as u64, (&SIGP[0 as usize]) as u64)
        return false
    }
    if n != 64 {
        err((&E_SIGLEN[0 as usize]) as u64, (&SIGP[0 as usize]) as u64)
        return false
    }
    return true
}

fn signature_valid(msg: u64, len: u64) -> bool {
    var c: ed25519.Ctx = ed25519.ctx_new()
    if !ed25519.ctx_init(&c) {
        err((&E_CTX[0 as usize]) as u64, 0)
        return false
    }
    if ed25519.ed25519_verify(&c, (&KEY[0 as usize]) as u64, msg,
        len as usize, (&SIG[0 as usize]) as u64) {
        return true
    }
    let n: u64 = file_read((&P_ERS[0 as usize]) as u64,
        (&ERS[0 as usize]) as u64, 32)
    if n != 32 {
        return false
    }
    ers_da = true
    return ed25519.ed25519_verify(&c, (&ERS[0 as usize]) as u64, msg,
        len as usize, (&SIG[0 as usize]) as u64)
}

fn package_signature(path: u64, len: u64) -> bool {
    if !key_get() {
        return false
    }
    if !signature_get(path, (&N_SIG[0 as usize]) as u64) {
        return false
    }
    if !signature_valid((&PKT[0 as usize]) as u64, len) {
        err((&E_SIG[0 as usize]) as u64, path)
        return false
    }
    ulib.say((&S_SIGOK[0 as usize]) as u64)
    ulib.say(path)
    ulib.nl()
    return true
}

fn packet_check(len: u64) -> u64 {
    let p: u64 = (&PKT[0 as usize]) as u64
    if len < HEADER {
        err((&E_KENN[0 as usize]) as u64, 0)
        return 0
    }
    var kenn: [u8; 9] = "OPKG0001\0"
    if !ulib.strneq(p, (&kenn[0 as usize]) as u64, 8) {
        err((&E_KENN[0 as usize]) as u64, 0)
        return 0
    }
    let ml: u64 = g64(p + 8)
    let dl: u64 = g64(p + 16)
    if HEADER + ml + dl != len {
        err((&E_LAENG[0 as usize]) as u64, 0)
        return 0
    }
    sha.sha256(p + HEADER, ml + dl, (&HASH[0 as usize]) as u64)
    var i: u64 = 0
    while i < 32 {
        if g8((&HASH[0 as usize]) as u64 + i) != g8(p + 24 + i) {
            err((&E_HASH[0 as usize]) as u64, 0)
            return 0
        }
        i = i + 1
    }
    sha.hex_out((&HASH[0 as usize]) as u64, 32, (&HEX[0 as usize]) as u64)
    if !meta_value(p + HEADER, ml, (&M_NAME[0 as usize]) as u64,
        (&NAME[0 as usize]) as u64, 63) {
        err((&E_NONAME[0 as usize]) as u64, 0)
        return 0
    }
    return ml
}

fn store_write(ml: u64, len: u64) -> bool {
    let p: u64 = (&PKT[0 as usize]) as u64
    let dl: u64 = len - HEADER - ml
    store_path((&PATH[0 as usize]) as u64, (&HEX[0 as usize]) as u64, 0)
    if ulib.is_dir((&PATH[0 as usize]) as u64) {
        store_path((&PATH2[0 as usize]) as u64, (&HEX[0 as usize]) as u64,
            (&N_PACKAGE[0 as usize]) as u64)
        var alt: [u8; 4096] = [0 as u8; 4096]
        let n: u64 = file_read((&PATH2[0 as usize]) as u64,
            (&alt[0 as usize]) as u64, 4095)
        if n != ml || !ulib.strneq((&alt[0 as usize]) as u64, p + HEADER, ml) {
            err((&E_KOLL[0 as usize]) as u64, (&HEX[0 as usize]) as u64)
            return false
        }
        return true
    }
    mkdir((&P_STORE[0 as usize]) as u64)
    remove((&P_PART[0 as usize]) as u64)
    mkdir((&P_PART[0 as usize]) as u64)
    if !archive_unpack(p + HEADER + ml, dl, (&P_PART[0 as usize]) as u64) {
        err((&E_ARCH[0 as usize]) as u64, 0)
        return false
    }
    ulib.strcpy((&PATH2[0 as usize]) as u64, (&P_PART[0 as usize]) as u64)
    slash((&PATH2[0 as usize]) as u64)
    ulib.strcat((&PATH2[0 as usize]) as u64, (&N_PACKAGE[0 as usize]) as u64)
    if !file_write((&PATH2[0 as usize]) as u64, p + HEADER, ml) {
        err((&E_ARCH[0 as usize]) as u64, (&PATH2[0 as usize]) as u64)
        return false
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    let r: u64 = ulib.sys(ulib.SYS_RENAME, (&P_PART[0 as usize]) as u64,
        (&PATH[0 as usize]) as u64, 0)
    if ulib.bad(r) {
        err((&E_REN[0 as usize]) as u64, (&PATH[0 as usize]) as u64)
        ulib.sayn(r)
        ulib.nl()
        return false
    }
    return true
}

fn umschalten(name: u64, hash: u64, reason: u64) -> u64 {
    let plan: u64 = (&PLAN[0 as usize]) as u64
    let now: u64 = current()
    if now == 0xFFFFFFFFFFFFFFFF {
        p8(plan, 0)
    } else {
        plan_read(now, plan)
    }
    plan_set(plan, name, hash)
    var fresh: u64 = 0
    let up: u64 = gen_hoechste()
    if up != 0xFFFFFFFFFFFFFFFF {
        fresh = up + 1
    }
    mkdir((&P_SYS[0 as usize]) as u64)
    mkdir((&P_GENS[0 as usize]) as u64)
    if !plan_write(fresh, plan, reason) {
        err((&E_PLAN[0 as usize]) as u64, 0)
        return 0xFFFFFFFFFFFFFFFF
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    // ------------------------------------------------ DER UMSCHLAG
    if !current_set(fresh) {
        err((&E_AKT[0 as usize]) as u64, 0)
        return 0xFFFFFFFFFFFFFFFF
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    var vorher: u64 = fresh
    if now != 0xFFFFFFFFFFFFFFFF {
        vorher = now
    }
    if !erp_write(fresh, vorher, 0, 0) {
        err((&E_ERPW[0 as usize]) as u64, 0)
        return 0xFFFFFFFFFFFFFFFF
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.say((&S_ERP[0 as usize]) as u64)
    ulib.sayu(fresh)
    ulib.say((&S_VOR[0 as usize]) as u64)
    ulib.sayu(vorher)
    ulib.nl()
    if apps_build(fresh) == 0xFFFFFFFFFFFFFFFF {
        return 0xFFFFFFFFFFFFFFFF
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    return fresh
}

// ------------------------------------------------- r105: dependencies
//
// A package may carry `deps=a,b` in its (signed, hashed) metadata: names of
// packages that must already be in the CURRENT generation. Names only, no
// version ranges -- a name is one slot in the PLAN, so "the newest one" is
// the only version there is. Install is strict (`opk install <file>` refuses
// when a dependency is missing, nothing is written); `opk update <name>
// --source <dir>` resolves: it installs the missing ones from the same
// signed source first (each through the full signature + hash chain), depth
// limited so a cycle ends in an error instead of a loop. Remove refuses
// while another installed package still names the package in its `deps=`.

// Next comma/space separated token of `list` from `at` into `out` (max 63).
// Returns the position after the token, or all-ones when none is left.
fn dep_token(list: u64, at: u64, out: u64) -> u64 {
    var i: u64 = at
    while g8(list + i) == 44 || g8(list + i) == 32 {
        i = i + 1
    }
    if g8(list + i) == 0 {
        return 0xFFFFFFFFFFFFFFFF
    }
    var k: u64 = 0
    while g8(list + i) != 0 && g8(list + i) != 44 && g8(list + i) != 32 {
        if k < 63 {
            p8(out + k, g8(list + i))
            k = k + 1
        }
        i = i + 1
    }
    p8(out + k, 0)
    return i
}

// First dependency of the package in PKT (metadata length `ml`) that is not
// in the current generation -> copied to `miss`. false = all present.
fn dep_first_missing(ml: u64, miss: u64) -> bool {
    var dv: [u8; 256] = [0 as u8; 256]
    if !meta_value((&PKT[0 as usize]) as u64 + HEADER, ml,
        (&M_DEPS[0 as usize]) as u64, (&dv[0 as usize]) as u64, 255) {
        return false
    }
    let plan: u64 = (&PLAN[0 as usize]) as u64
    let now: u64 = current()
    if now == 0xFFFFFFFFFFFFFFFF {
        p8(plan, 0)
    } else {
        plan_read(now, plan)
    }
    var tok: [u8; 64] = [0 as u8; 64]
    var hs: [u8; 72] = [0 as u8; 72]
    var at: u64 = 0
    var found: bool = false
    var more: bool = true
    while more {
        at = dep_token((&dv[0 as usize]) as u64, at, (&tok[0 as usize]) as u64)
        if at == 0xFFFFFFFFFFFFFFFF {
            more = false
        } else if !ulib.streq((&tok[0 as usize]) as u64, (&NAME[0 as usize]) as u64)
            && !plan_hash(plan, (&tok[0 as usize]) as u64, (&hs[0 as usize]) as u64) {
            ulib.strcpy(miss, (&tok[0 as usize]) as u64)
            found = true
            more = false
        }
    }
    return found
}

// Is some OTHER installed package depending on `name`? -> its name in `who`.
// Reads the current PLAN (caller has it in PLAN already).
fn dep_required_by(name: u64, who: u64) -> bool {
    let plan: u64 = (&PLAN[0 as usize]) as u64
    let n: u64 = plan_lines(plan)
    var nm: [u8; 64] = [0 as u8; 64]
    var h2: [u8; 72] = [0 as u8; 72]
    var meta: [u8; 4096] = [0 as u8; 4096]
    var dv: [u8; 256] = [0 as u8; 256]
    var tok: [u8; 64] = [0 as u8; 64]
    var k: u64 = 0
    var hit: bool = false
    while k < n && !hit {
        if plan_line(plan, k, (&nm[0 as usize]) as u64, (&h2[0 as usize]) as u64)
            && !ulib.streq((&nm[0 as usize]) as u64, name) {
            store_path((&PATH2[0 as usize]) as u64, (&h2[0 as usize]) as u64,
                (&N_PACKAGE[0 as usize]) as u64)
            let m: u64 = file_read((&PATH2[0 as usize]) as u64,
                (&meta[0 as usize]) as u64, 4095)
            if m != 0xFFFFFFFFFFFFFFFF && m != 0
                && meta_value((&meta[0 as usize]) as u64, m,
                    (&M_DEPS[0 as usize]) as u64, (&dv[0 as usize]) as u64, 255) {
                var at: u64 = 0
                var more: bool = true
                while more {
                    at = dep_token((&dv[0 as usize]) as u64, at, (&tok[0 as usize]) as u64)
                    if at == 0xFFFFFFFFFFFFFFFF {
                        more = false
                    } else if ulib.streq((&tok[0 as usize]) as u64, name) {
                        ulib.strcpy(who, (&nm[0 as usize]) as u64)
                        hit = true
                        more = false
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// ------------------------------------------------------- die Befehle

fn cmd_list() -> u64 {
    var nm: [u8; 64] = [0 as u8; 64]
    var hs: [u8; 72] = [0 as u8; 72]
    let g: u64 = current()
    if g == 0xFFFFFFFFFFFFFFFF {
        ulib.say((&S_EMPTY[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    let plan: u64 = (&PLAN[0 as usize]) as u64
    plan_read(g, plan)
    let n: u64 = plan_lines(plan)
    sagn((&S_GEN[0 as usize]) as u64, g)
    if n == 0 {
        ulib.say((&S_EMPTY[0 as usize]) as u64)
        ulib.nl()
    }
    var k: u64 = 0
    while k < n {
        if plan_line(plan, k, (&nm[0 as usize]) as u64,
            (&hs[0 as usize]) as u64) {
            ulib.say((&S_TAB[0 as usize]) as u64)
            ulib.say((&nm[0 as usize]) as u64)
            ulib.say((&S_PFEIL[0 as usize]) as u64)
            var kz: [u8; 16] = [0 as u8; 16]
            ulib.strncpy((&kz[0 as usize]) as u64, (&hs[0 as usize]) as u64, 13)
            ulib.say((&kz[0 as usize]) as u64)
            ulib.nl()
        }
        k = k + 1
    }
    return 0
}

fn cmd_generationen() -> u64 {
    let now: u64 = current()
    let up: u64 = gen_hoechste()
    if up == 0xFFFFFFFFFFFFFFFF {
        ulib.say((&S_EMPTY[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    var i: u64 = 0
    while i <= up {
        gen_path((&PATH[0 as usize]) as u64, i, (&N_PLAN[0 as usize]) as u64)
        if da((&PATH[0 as usize]) as u64) {
            ulib.say((&S_GEN[0 as usize]) as u64)
            ulib.sayu(i)
            gen_path((&PATH[0 as usize]) as u64, i,
                (&N_REASON[0 as usize]) as u64)
            var gr: [u8; 128] = [0 as u8; 128]
            let n: u64 = file_read((&PATH[0 as usize]) as u64,
                (&gr[0 as usize]) as u64, 120)
            if n != 0xFFFFFFFFFFFFFFFF && n > 0 {
                var k: u64 = n
                if k > 0 && gr[(k - 1) as usize] == 10 as u8 {
                    k = k - 1
                }
                gr[k as usize] = 0 as u8
                ulib.say((&S_PFEIL[0 as usize]) as u64)
                ulib.say((&gr[0 as usize]) as u64)
            }
            if i == now {
                ulib.say((&S_ACTIVE[0 as usize]) as u64)
            }
            ulib.nl()
        }
        i = i + 1
    }
    return 0
}

// W-AR3: the app-rights helper after a package came in or went out. Best effort: an image without /bin/apprights
// (or a caller that may not touch the table) simply skips it. `install` = `apprights load` (ceilings from the new
// INFO, then the non-sensitive rights of the signed plan are granted once); `remove` = `apprights forget <name>`.
fn rights_hook(install: bool, name: u64) {
    var p_bin: [u8; 16] = "/bin/apprights\0\0"
    var a_load: [u8; 5] = "load\0"
    var a_forget: [u8; 7] = "forget\0"
    var av: [u64; 4] = [0 as u64; 4]
    av[0] = (&p_bin[0]) as u64
    var argc: u64 = 2
    if install {
        av[1] = (&a_load[0]) as u64
    } else {
        av[1] = (&a_forget[0]) as u64
        av[2] = name
        argc = 3
    }
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&p_bin[0]) as u64, (&av[0]) as u64, argc)
    if ulib.bad(pid) {
        return
    }
    let _rc: u64 = ulib.wait_code(pid)
}

fn cmd_installieren(file: u64, reason: u64) -> u64 {
    let len: u64 = file_read(file, (&PKT[0 as usize]) as u64, PKT_MAX)
    if len == 0xFFFFFFFFFFFFFFFF {
        return err((&E_OPEN[0 as usize]) as u64, file)
    }
    if len >= PKT_MAX {
        return err((&E_BIG[0 as usize]) as u64, 0)
    }
    if !package_signature(file, len) {
        return 1
    }
    let ml: u64 = packet_check(len)
    if ml == 0 {
        return 1
    }
    var miss: [u8; 64] = [0 as u8; 64]
    if dep_first_missing(ml, (&miss[0 as usize]) as u64) {
        return err((&E_DEPMISS[0 as usize]) as u64, (&miss[0 as usize]) as u64)
    }
    if !store_write(ml, len) {
        return err((&E_SCHRB[0 as usize]) as u64, (&HEX[0 as usize]) as u64)
    }
    toepfe((&NAME[0 as usize]) as u64, true)
    let g: u64 = umschalten((&NAME[0 as usize]) as u64,
        (&HEX[0 as usize]) as u64, reason)
    if g == 0xFFFFFFFFFFFFFFFF {
        return err((&E_UMSCH[0 as usize]) as u64, 0)
    }
    rights_hook(true, 0)
    ulib.say((&S_INST[0 as usize]) as u64)
    ulib.say((&NAME[0 as usize]) as u64)
    ulib.say((&S_PFEIL[0 as usize]) as u64)
    ulib.sayu(g)
    ulib.nl()
    return 0
}

fn cmd_entfernen(name: u64, reason: u64) -> u64 {
    var hs: [u8; 72] = [0 as u8; 72]
    let now: u64 = current()
    if now == 0xFFFFFFFFFFFFFFFF {
        return err((&E_KEIN[0 as usize]) as u64, name)
    }
    let plan: u64 = (&PLAN[0 as usize]) as u64
    plan_read(now, plan)
    if !plan_hash(plan, name, (&hs[0 as usize]) as u64) {
        return err((&E_KEIN[0 as usize]) as u64, name)
    }
    var who: [u8; 64] = [0 as u8; 64]
    if dep_required_by(name, (&who[0 as usize]) as u64) {
        return err((&E_DEPREQ[0 as usize]) as u64, (&who[0 as usize]) as u64)
    }
    let g: u64 = umschalten(name, 0, reason)
    if g == 0xFFFFFFFFFFFFFFFF {
        return 1
    }
    toepfe(name, false)
    rights_hook(false, name)
    ulib.say((&S_ENTF[0 as usize]) as u64)
    ulib.say(name)
    ulib.say((&S_PFEIL[0 as usize]) as u64)
    ulib.sayu(g)
    ulib.nl()
    return 0
}

fn cmd_back(n: u64) -> u64 {
    gen_path((&PATH[0 as usize]) as u64, n, (&N_PLAN[0 as usize]) as u64)
    if !da((&PATH[0 as usize]) as u64) {
        return err((&E_NOGEN[0 as usize]) as u64, 0)
    }
    if !current_set(n) {
        return 1
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    if !erp_write(n, n, 0, 1) {
        return err((&E_ERPW[0 as usize]) as u64, 0)
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    if apps_build(n) == 0xFFFFFFFFFFFFFFFF {
        return 1
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.say((&S_ZUR[0 as usize]) as u64)
    ulib.sayu(n)
    ulib.nl()
    return 0
}

fn cmd_erprobung(was: u64) -> u64 {
    var gen: u64 = 0
    var before: u64 = 0
    var v: u64 = 0
    var ok: u64 = 0
    if !erp_read(&gen, &before, &v, &ok) {
        let g: u64 = current()
        ulib.say((&S_ERPKEIN[0 as usize]) as u64)
        ulib.sayu(g)
        var close_path: [u8; 2] = ")\0"
        ulib.say((&close_path[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    if was != 0 && ulib.streq(was, (&A_OK[0 as usize]) as u64) {
        if !erp_write(gen, before, v, 1) {
            return err((&E_ERPW[0 as usize]) as u64, 0)
        }
        ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
        ulib.say((&S_ERPOK[0 as usize]) as u64)
        ulib.sayu(gen)
        ulib.nl()
        return 0
    }
    ulib.say((&S_ERPST[0 as usize]) as u64)
    ulib.sayu(gen)
    ulib.say((&S_VOR[0 as usize]) as u64)
    ulib.sayu(before)
    ulib.say((&S_VERS[0 as usize]) as u64)
    ulib.sayu(v)
    if ok != 0 {
        ulib.say((&S_BEST[0 as usize]) as u64)
    } else {
        ulib.say((&S_OPEN[0 as usize]) as u64)
    }
    ulib.nl()
    return 0
}

fn cmd_richten() -> u64 {
    let g: u64 = current()
    if g == 0xFFFFFFFFFFFFFFFF {
        return err((&E_NOGEN[0 as usize]) as u64, 0)
    }
    let v: u64 = apps_build(g)
    if v == 0xFFFFFFFFFFFFFFFF {
        return 1
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.say((&S_RICHT[0 as usize]) as u64)
    ulib.sayu(v)
    ulib.nl()
    return 0
}

fn cmd_check() -> u64 {
    var nm: [u8; 64] = [0 as u8; 64]
    var hs: [u8; 72] = [0 as u8; 72]
    let up: u64 = gen_hoechste()
    if up == 0xFFFFFFFFFFFFFFFF {
        return err((&E_NOGEN[0 as usize]) as u64, 0)
    }
    var missing: u64 = 0
    var seen: u64 = 0
    var i: u64 = 0
    while i <= up {
        let plan: u64 = (&PLAN[0 as usize]) as u64
        if plan_read(i, plan) {
            let n: u64 = plan_lines(plan)
            var k: u64 = 0
            while k < n {
                if plan_line(plan, k, (&nm[0 as usize]) as u64,
                    (&hs[0 as usize]) as u64) {
                    seen = seen + 1
                    store_path((&PATH[0 as usize]) as u64,
                        (&hs[0 as usize]) as u64, (&N_PACKAGE[0 as usize]) as u64)
                    if !da((&PATH[0 as usize]) as u64) {
                        missing = missing + 1
                        err((&E_STORE[0 as usize]) as u64,
                            (&nm[0 as usize]) as u64)
                    }
                }
                k = k + 1
            }
        }
        i = i + 1
    }
    ulib.say((&S_OK[0 as usize]) as u64)
    ulib.sayu(seen)
    ulib.say((&S_PFEIL[0 as usize]) as u64)
    ulib.sayu(missing)
    ulib.nl()
    if missing != 0 {
        return 1
    }
    return 0
}

// ---------------------------------------------------- aktualisieren
fn index_line(name: u64, hash: u64, file: u64) -> bool {
    let idx: u64 = (&IDX[0 as usize]) as u64
    var i: u64 = 0
    while g8(idx + i) != 0 {
        // Zeilenanfang
        var j: u64 = i
        var field: u64 = 0
        var nm: [u8; 64] = [0 as u8; 64]
        var k: u64 = 0
        while g8(idx + j) != 10 && g8(idx + j) != 0 && k < 63
            && g8(idx + j) != 9 {
            nm[k as usize] = g8(idx + j) as u8
            k = k + 1
            j = j + 1
        }
        nm[k as usize] = 0 as u8
        if ulib.streq((&nm[0 as usize]) as u64, name) && g8(idx + j) == 9 {
            j = j + 1
            while g8(idx + j) != 9 && g8(idx + j) != 10 && g8(idx + j) != 0 {
                j = j + 1
            }
            if g8(idx + j) != 9 {
                return false
            }
            j = j + 1
            k = 0
            while g8(idx + j) != 9 && g8(idx + j) != 10 && g8(idx + j) != 0
                && k < 71 {
                p8(hash + k, g8(idx + j))
                k = k + 1
                j = j + 1
            }
            p8(hash + k, 0)
            if g8(idx + j) != 9 {
                return false
            }
            j = j + 1
            while g8(idx + j) != 9 && g8(idx + j) != 10 && g8(idx + j) != 0 {
                j = j + 1
            }
            if g8(idx + j) != 9 {
                return false
            }
            j = j + 1
            k = 0
            while g8(idx + j) != 10 && g8(idx + j) != 0 && g8(idx + j) != 9
                && k < 127 {
                p8(file + k, g8(idx + j))
                k = k + 1
                j = j + 1
            }
            p8(file + k, 0)
            return true
        }
        while g8(idx + i) != 10 && g8(idx + i) != 0 {
            i = i + 1
        }
        if g8(idx + i) == 10 {
            i = i + 1
        }
    }
    return false
}

// r178: a dependency's package file is not in the source directory (the store
// fetches files one by one). Leave a note for the caller -- `file=<name>` in
// `<source>/NEED` -- and exit 4, so it can fetch that file and call again.
fn need_write(source: u64, file: u64) {
    var pf: [u8; 256] = [0 as u8; 256]
    var buf: [u8; 192] = [0 as u8; 192]
    ulib.strcpy((&pf[0 as usize]) as u64, source)
    slash((&pf[0 as usize]) as u64)
    ulib.strcat((&pf[0 as usize]) as u64, (&N_NEED[0 as usize]) as u64)
    ulib.strcpy((&buf[0 as usize]) as u64, (&M_FILE[0 as usize]) as u64)
    ulib.strcat((&buf[0 as usize]) as u64, file)
    ulib.strcat((&buf[0 as usize]) as u64, (&NLZ[0 as usize]) as u64)
    file_write((&pf[0 as usize]) as u64, (&buf[0 as usize]) as u64, len((&buf[0 as usize]) as u64))
}

fn cmd_aktualisieren(name: u64, source: u64, reason: u64) -> u64 {
    return aktu(name, source, reason, 0)
}

fn aktu(name: u64, source: u64, reason: u64, depth: u64) -> u64 {
    var hs: [u8; 72] = [0 as u8; 72]
    var dt: [u8; 128] = [0 as u8; 128]
    ulib.strcpy((&PATH[0 as usize]) as u64, source)
    slash((&PATH[0 as usize]) as u64)
    ulib.strcat((&PATH[0 as usize]) as u64, (&N_INDEX[0 as usize]) as u64)
    let n: u64 = file_read((&PATH[0 as usize]) as u64,
        (&IDX[0 as usize]) as u64, 8000)
    if n == 0xFFFFFFFFFFFFFFFF || n == 0 {
        return err((&E_INDEX[0 as usize]) as u64, source)
    }
    p8((&IDX[0 as usize]) as u64 + n, 0)
    if !key_get() {
        return 1
    }
    ulib.strcpy((&PATH2[0 as usize]) as u64, source)
    slash((&PATH2[0 as usize]) as u64)
    ulib.strcat((&PATH2[0 as usize]) as u64, (&N_ISIG[0 as usize]) as u64)
    if !signature_get((&PATH2[0 as usize]) as u64, 0) {
        return 1
    }
    if !signature_valid((&IDX[0 as usize]) as u64, n) {
        return err((&E_ISIG[0 as usize]) as u64, source)
    }
    ulib.say((&S_SIGOK[0 as usize]) as u64)
    ulib.say((&PATH2[0 as usize]) as u64)
    ulib.nl()
    if !index_line(name, (&hs[0 as usize]) as u64, (&dt[0 as usize]) as u64) {
        return err((&E_NIX[0 as usize]) as u64, name)
    }
    ulib.strcpy((&PATH[0 as usize]) as u64, source)
    slash((&PATH[0 as usize]) as u64)
    ulib.strcat((&PATH[0 as usize]) as u64, (&dt[0 as usize]) as u64)
    let len: u64 = file_read((&PATH[0 as usize]) as u64,
        (&PKT[0 as usize]) as u64, PKT_MAX)
    if len == 0xFFFFFFFFFFFFFFFF {
        err((&E_OPEN[0 as usize]) as u64, (&PATH[0 as usize]) as u64)
        if depth > 0 {
            need_write(source, (&dt[0 as usize]) as u64)
            return 4
        }
        return 1
    }
    if !package_signature((&PATH[0 as usize]) as u64, len) {
        return 1
    }
    let ml: u64 = packet_check(len)
    if ml == 0 {
        return 1
    }
    if !ulib.streq((&HEX[0 as usize]) as u64, (&hs[0 as usize]) as u64) {
        return err((&E_HASHQ[0 as usize]) as u64, name)
    }
    if !ulib.streq((&NAME[0 as usize]) as u64, name) {
        return err((&E_NIX[0 as usize]) as u64, name)
    }
    // r105: install missing dependencies first, each from the same signed
    // source, then start over for this package (the buffers are reused).
    var miss: [u8; 64] = [0 as u8; 64]
    if dep_first_missing(ml, (&miss[0 as usize]) as u64) {
        if depth >= 8 {
            return err((&E_DEPDEEP[0 as usize]) as u64, name)
        }
        ulib.say((&S_DEPINST[0 as usize]) as u64)
        ulib.say((&miss[0 as usize]) as u64)
        ulib.nl()
        let r: u64 = aktu((&miss[0 as usize]) as u64, source, reason, depth + 1)
        if r != 0 {
            return r
        }
        return aktu(name, source, reason, depth)
    }
    if !store_write(ml, len) {
        return 1
    }
    toepfe((&NAME[0 as usize]) as u64, true)
    let g: u64 = umschalten((&NAME[0 as usize]) as u64,
        (&HEX[0 as usize]) as u64, reason)
    if g == 0xFFFFFFFFFFFFFFFF {
        return 1
    }
    rights_hook(true, 0)
    ulib.say((&S_INST[0 as usize]) as u64)
    ulib.say((&NAME[0 as usize]) as u64)
    ulib.say((&S_PFEIL[0 as usize]) as u64)
    ulib.sayu(g)
    ulib.nl()
    return 0
}

// ------------------------------------------------------------ der Katalog
//     name TAB fassung TAB groesse TAB datei TAB inst TAB aktuell
static mut A_X86: [u8; 7] = "x86_64\0"

fn idx_field(line: u64, k: u64, out: u64, max: u64) -> bool {
    var i: u64 = line
    var f: u64 = 0
    while f < k {
        while g8(i) != 9 && g8(i) != 10 && g8(i) != 0 {
            i = i + 1
        }
        if g8(i) != 9 {
            return false
        }
        i = i + 1
        f = f + 1
    }
    var n: u64 = 0
    while g8(i) != 9 && g8(i) != 10 && g8(i) != 0 && n + 1 < max {
        p8(out + n, g8(i))
        n = n + 1
        i = i + 1
    }
    p8(out + n, 0)
    return true
}

fn kat_put(at: u64, t: u64) -> u64 {
    var a: u64 = at
    var i: u64 = 0
    while g8(t + i) != 0 && a < 8100 {
        p8((&KAT[0 as usize]) as u64 + a, g8(t + i))
        a = a + 1
        i = i + 1
    }
    return a
}

fn kat_ch(at: u64, c: u64) -> u64 {
    if at < 8100 {
        p8((&KAT[0 as usize]) as u64 + at, c)
        return at + 1
    }
    return at
}

fn cmd_catalog(source: u64, output: u64) -> u64 {
    ulib.strcpy((&PATH[0 as usize]) as u64, source)
    slash((&PATH[0 as usize]) as u64)
    ulib.strcat((&PATH[0 as usize]) as u64, (&N_INDEX[0 as usize]) as u64)
    let n: u64 = file_read((&PATH[0 as usize]) as u64,
        (&IDX[0 as usize]) as u64, 8000)
    if n == 0xFFFFFFFFFFFFFFFF || n == 0 {
        return err((&E_INDEX[0 as usize]) as u64, source)
    }
    p8((&IDX[0 as usize]) as u64 + n, 0)
    if !key_get() {
        return 1
    }
    ulib.strcpy((&PATH2[0 as usize]) as u64, source)
    slash((&PATH2[0 as usize]) as u64)
    ulib.strcat((&PATH2[0 as usize]) as u64, (&N_ISIG[0 as usize]) as u64)
    if !signature_get((&PATH2[0 as usize]) as u64, 0) {
        return 1
    }
    if !signature_valid((&IDX[0 as usize]) as u64, n) {
        return err((&E_ISIG[0 as usize]) as u64, source)
    }
    // what is installed now
    let plan: u64 = (&PLAN[0 as usize]) as u64
    p8(plan, 0)
    let g: u64 = current()
    if g != 0xFFFFFFFFFFFFFFFF {
        plan_read(g, plan)
    }
    let idx: u64 = (&IDX[0 as usize]) as u64
    var at: u64 = 0
    var i: u64 = 0
    while g8(idx + i) != 0 {
        var nm: [u8; 64] = [0 as u8; 64]
        var fa: [u8; 24] = [0 as u8; 24]
        var hs: [u8; 72] = [0 as u8; 72]
        var gr: [u8; 24] = [0 as u8; 24]
        var dt: [u8; 128] = [0 as u8; 128]
        var ar: [u8; 24] = [0 as u8; 24]
        var ih: [u8; 72] = [0 as u8; 72]
        let z: u64 = idx + i
        if idx_field(z, 0, (&nm[0 as usize]) as u64, 64) && g8((&nm[0 as usize]) as u64) != 0
            && idx_field(z, 1, (&fa[0 as usize]) as u64, 24)
            && idx_field(z, 2, (&hs[0 as usize]) as u64, 72)
            && idx_field(z, 3, (&gr[0 as usize]) as u64, 24)
            && idx_field(z, 4, (&dt[0 as usize]) as u64, 128) {
            var fits: bool = true
            if idx_field(z, 5, (&ar[0 as usize]) as u64, 24) && g8((&ar[0 as usize]) as u64) != 0 {
                fits = ulib.streq((&ar[0 as usize]) as u64, (&A_X86[0 as usize]) as u64)
            }
            if fits {
                at = kat_put(at, (&nm[0 as usize]) as u64)
                at = kat_ch(at, 9)
                at = kat_put(at, (&fa[0 as usize]) as u64)
                at = kat_ch(at, 9)
                at = kat_put(at, (&gr[0 as usize]) as u64)
                at = kat_ch(at, 9)
                at = kat_put(at, (&dt[0 as usize]) as u64)
                at = kat_ch(at, 9)
                var inst: u64 = 48
                var akt: u64 = 48
                if plan_hash(plan, (&nm[0 as usize]) as u64, (&ih[0 as usize]) as u64) {
                    inst = 49
                    if ulib.streq((&ih[0 as usize]) as u64, (&hs[0 as usize]) as u64) {
                        akt = 49
                    }
                }
                at = kat_ch(at, inst)
                at = kat_ch(at, 9)
                at = kat_ch(at, akt)
                at = kat_ch(at, 10)
            }
        }
        while g8(idx + i) != 10 && g8(idx + i) != 0 {
            i = i + 1
        }
        if g8(idx + i) == 10 {
            i = i + 1
        }
    }
    if !commit_write(output, (&KAT[0 as usize]) as u64, at) {
        return err((&E_OPEN[0 as usize]) as u64, output)
    }
    ulib.say((&S_SIGOK[0 as usize]) as u64)
    ulib.say((&PATH2[0 as usize]) as u64)
    ulib.nl()
    return 0
}

// ------------------------------------------------------------ das Ganze

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.say((&S_USE1[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE2[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE3[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE4[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE5[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE6[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE7[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE8[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE9[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE10[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE11[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE12[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    let cmd: u64 = ulib.arg_at(args, 1)
    var source: u64 = 0
    var out_path: u64 = 0
    var key_path: u64 = 0
    var reason: u64 = (&S_FRESH[0 as usize]) as u64
    var i: u64 = 2
    while i < argc {
        let a: u64 = ulib.arg_at(args, i)
        if ulib.streq(a, (&O_SOURCE[0 as usize]) as u64) && i + 1 < argc {
            i = i + 1
            source = ulib.arg_at(args, i)
        } else if ulib.streq(a, (&O_OUT[0 as usize]) as u64) && i + 1 < argc {
            i = i + 1
            out_path = ulib.arg_at(args, i)
        } else if ulib.streq(a, (&O_KEY[0 as usize]) as u64) && i + 1 < argc {
            i = i + 1
            key_path = ulib.arg_at(args, i)
        } else if ulib.streq(a, (&O_REASON[0 as usize]) as u64) && i + 1 < argc {
            i = i + 1
            reason = ulib.arg_at(args, i)
        }
        i = i + 1
    }
    if ulib.streq(cmd, (&C_LIST[0 as usize]) as u64) {
        return cmd_list()
    }
    if ulib.streq(cmd, (&C_GEN[0 as usize]) as u64) {
        return cmd_generationen()
    }
    if ulib.streq(cmd, (&C_RICHT[0 as usize]) as u64) {
        return cmd_richten()
    }
    if ulib.streq(cmd, (&C_CHECK[0 as usize]) as u64)
        || ulib.streq(cmd, (&C_CHECK_U[0 as usize]) as u64) {
        return cmd_check()
    }
    if ulib.streq(cmd, (&C_ERP[0 as usize]) as u64) {
        var wa: u64 = 0
        if argc >= 3 {
            wa = ulib.arg_at(args, 2)
        }
        return cmd_erprobung(wa)
    }
    if argc < 3 {
        return err((&E_ARG[0 as usize]) as u64, 0)
    }
    let a2: u64 = ulib.arg_at(args, 2)
    if ulib.streq(cmd, (&C_BUILD[0 as usize]) as u64) {
        if out_path == 0 {
            return err((&E_ARG[0 as usize]) as u64, 0)
        }
        return opkpack.build(a2, out_path)
    }
    if ulib.streq(cmd, (&C_SHOW[0 as usize]) as u64) {
        return opkinspect.show(a2, (&PKT[0 as usize]) as u64, 8388608)
    }
    if ulib.streq(cmd, (&C_SRC[0 as usize]) as u64) {
        return opksign.make_source(a2, key_path, (&PKT[0 as usize]) as u64, 8388608)
    }
    if ulib.streq(cmd, (&C_SIGN[0 as usize]) as u64) {
        if key_path == 0 {
            return err((&E_ARG[0 as usize]) as u64, 0)
        }
        return opksign.sign_package(a2, key_path, (&PKT[0 as usize]) as u64, 8388608)
    }
    if ulib.streq(cmd, (&C_KAT[0 as usize]) as u64) {
        if argc < 4 {
            return err((&E_ARG[0 as usize]) as u64, 0)
        }
        return cmd_catalog(a2, ulib.arg_at(args, 3))
    }
    if ulib.streq(cmd, (&C_INST[0 as usize]) as u64) {
        return cmd_installieren(a2, reason)
    }
    if ulib.streq(cmd, (&C_ENTF[0 as usize]) as u64) {
        return cmd_entfernen(a2, reason)
    }
    if ulib.streq(cmd, (&C_ZUR[0 as usize]) as u64)
        || ulib.streq(cmd, (&C_ZUR_U[0 as usize]) as u64) {
        return cmd_back(ulib.to_num(a2))
    }
    if ulib.streq(cmd, (&C_AKTU[0 as usize]) as u64) {
        if source == 0 {
            return err((&E_ARG[0 as usize]) as u64, 0)
        }
        return cmd_aktualisieren(a2, source, reason)
    }
    return err((&E_ARG[0 as usize]) as u64, cmd)
}
