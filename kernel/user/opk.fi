// --------------------------------------------------------- die Puffer
//
// EIN PAKET WIRD GANZ GELESEN. Das ist die Grenze dieses Programms, und
// sie steht hier als Zahl statt als Ueberraschung: was groesser ist,
// wird abgelehnt und nicht halb installiert. Der Grund ist die
// Pruefsumme -- sie geht ueber Metadaten UND Daten, und ein Paket, das
// man in Stuecken schreibt und erst danach pruefen kann, waere ein
// Paket, das man vor der Pruefung schon auf der Platte hat.
const PKT_MAX: u64 = 393216
static mut PKT: [u8; 393216] = [0 as u8; 393216]
static mut PLAN: [u8; 8192] = [0 as u8; 8192]
static mut PLAN2: [u8; 8192] = [0 as u8; 8192]
static mut IDX: [u8; 8192] = [0 as u8; 8192]
static mut PFAD: [u8; 256] = [0 as u8; 256]
static mut PFAD2: [u8; 256] = [0 as u8; 256]
static mut HASH: [u8; 32] = [0 as u8; 32]
static mut HEX: [u8; 72] = [0 as u8; 72]
static mut NAME: [u8; 64] = [0 as u8; 64]
static mut ZEILE: [u8; 256] = [0 as u8; 256]
static mut SIG: [u8; 64] = [0 as u8; 64]
static mut KEY: [u8; 32] = [0 as u8; 32]
static mut SIGP: [u8; 320] = [0 as u8; 320]

const KOPF: u64 = 64
const KURZ: u64 = 20

// ------------------------------------------------------ Kleinigkeiten

fn g8(p: u64) -> u64 {
    return (*((p) as *mut u8)) as u64
}

fn p8(p: u64, v: u64) {
    __mmio_write8((p) as *mut u8, v as u8)
}

fn g64(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 8 {
        v = v | (g8(p + i) << (i * 8))
        i = i + 1
    }
    return v
}

fn g16(p: u64) -> u64 {
    return g8(p) | (g8(p + 1) << 8)
}

fn laenge(p: u64) -> u64 {
    var n: u64 = 0
    while g8(p + n) != 0 {
        n = n + 1
    }
    return n
}

// Pfade bauen: `out = a + b`. Es gibt keinen zweiten Weg in dieser
// Datei, einen Pfad zusammenzusetzen -- ein zweiter waere die Stelle,
// an der der Schraegstrich einmal fehlt.
fn pfad2(out: u64, a: u64, b: u64) {
    ulib.strcpy(out, a)
    ulib.strcat(out, b)
}

fn slash(out: u64) {
    var s: [u8; 2] = "/\0"
    ulib.strcat(out, (&s[0 as usize]) as u64)
}

fn zahl_an(out: u64, v: u64) {
    var b: [u8; 24] = [0 as u8; 24]
    ulib.digits(v, (&b[0 as usize]) as u64)
    ulib.strcat(out, (&b[0 as usize]) as u64)
}

fn sagn(t: u64, v: u64) {
    ulib.say(t)
    ulib.sayu(v)
    ulib.nl()
}

fn fehler(t: u64, was: u64) -> u64 {
    ulib.eput(t)
    if was != 0 {
        ulib.eput(was)
    }
    var nl: [u8; 2] = "\n\0"
    ulib.eput((&nl[0 as usize]) as u64)
    return 1
}

// -------------------------------------------------------- Dateien

fn datei_lesen(pfad: u64, puffer: u64, max: u64) -> u64 {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, pfad, 0, 0)
    if ulib.bad(fd) {
        return 0xFFFFFFFFFFFFFFFF
    }
    var n: u64 = 0
    var weiter: bool = true
    while weiter {
        let r: u64 = ulib.sys(ulib.SYS_READ, fd, puffer + n, max - n)
        if ulib.bad(r) || r == 0 {
            weiter = false
        } else {
            n = n + r
            if n >= max {
                weiter = false
            }
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return n
}

fn datei_schreiben(pfad: u64, puffer: u64, len: u64) -> bool {
    ulib.sys(ulib.SYS_UNLINK, pfad, 0, 0)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, pfad, ulib.O_MAKE, 0)
    if ulib.bad(fd) {
        return false
    }
    var n: u64 = 0
    while n < len {
        let w: u64 = ulib.sys(ulib.SYS_WRITE, fd, puffer + n, len - n)
        if ulib.bad(w) || w == 0 {
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
            return false
        }
        n = n + w
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return true
}

// EINE DATEI MIT FESTER LAENGE UEBERSCHREIBEN, ohne sie vorher
// wegzunehmen. Das ist der Kern der Atomarzusage: derselbe Inode,
// dieselbe Groesse, EIN Datenblock. `O_MAKE` wuerde die Datei leeren
// und damit erst die Groesse auf null setzen -- genau der Zustand, den
// ein Stromausfall dann sichtbar liesse.
fn fest_schreiben(pfad: u64, puffer: u64, len: u64) -> bool {
    var fd: u64 = ulib.sys(ulib.SYS_OPEN, pfad, ulib.O_RDWR, 0)
    if ulib.bad(fd) {
        fd = ulib.sys(ulib.SYS_OPEN, pfad, ulib.O_MAKE, 0)
        if ulib.bad(fd) {
            return false
        }
    }
    ulib.sys(ulib.SYS_SEEK, fd, 0, ulib.SEEK_SET)
    var n: u64 = 0
    while n < len {
        let w: u64 = ulib.sys(ulib.SYS_WRITE, fd, puffer + n, len - n)
        if ulib.bad(w) || w == 0 {
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
            return false
        }
        n = n + w
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return true
}

fn da(pfad: u64) -> bool {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, pfad, 0, 0)
    if ulib.bad(fd) {
        return false
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return true
}

fn mkdir(pfad: u64) {
    ulib.sys(ulib.SYS_MKDIR, pfad, 0, 0)
}

// Einen Baum wegraeumen. Verzeichnisse gehen erst, wenn sie leer sind --
// also erst die Kinder. Die Tiefe ist zwei (`daten/` und darunter), und
// mehr laesst das Format nicht zu.
fn weg(pfad: u64) {
    var ents: [u8; 2048] = [0 as u8; 2048]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, pfad, 0, 0)
    if ulib.bad(fd) {
        ulib.sys(ulib.SYS_UNLINK, pfad, 0, 0)
        return
    }
    let n: u64 = ulib.sys(217, fd, (&ents[0 as usize]) as u64, 2048)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if !ulib.bad(n) && n > 0 {
        var at: u64 = 0
        while at + 19 < n {
            let rl: u64 = g16((&ents[0 as usize]) as u64 + at + 16)
            if rl == 0 {
                at = n
            } else {
                let nm: u64 = (&ents[0 as usize]) as u64 + at + 19
                var punkt: [u8; 2] = ".\0"
                var punkt2: [u8; 3] = "..\0"
                if !ulib.streq(nm, (&punkt[0 as usize]) as u64)
                    && !ulib.streq(nm, (&punkt2[0 as usize]) as u64) {
                    var kind: [u8; 256] = [0 as u8; 256]
                    ulib.strcpy((&kind[0 as usize]) as u64, pfad)
                    slash((&kind[0 as usize]) as u64)
                    ulib.strcat((&kind[0 as usize]) as u64, nm)
                    weg((&kind[0 as usize]) as u64)
                }
                at = at + rl
            }
        }
    }
    ulib.sys(ulib.SYS_UNLINK, pfad, 0, 0)
}

// ---------------------------------------------------- die Metadaten
//
// `schluessel=wert`, eine Zeile je Feld. Gelesen wird aus dem Puffer und
// nicht aus einer Kopie: die Metadaten stehen im Paket, und das Paket
// steht schon im Speicher.
fn meta_wert(meta: u64, mlen: u64, schl: u64, out: u64, max: u64) -> bool {
    let sl: u64 = laenge(schl)
    var i: u64 = 0
    while i < mlen {
        // Zeilenanfang?
        if i == 0 || g8(meta + i - 1) == 10 {
            if i + sl <= mlen && ulib.strneq(meta + i, schl, sl) {
                var k: u64 = 0
                var j: u64 = i + sl
                while j < mlen && g8(meta + j) != 10 && k + 1 < max {
                    p8(out + k, g8(meta + j))
                    k = k + 1
                    j = j + 1
                }
                p8(out + k, 0)
                return true
            }
        }
        i = i + 1
    }
    return false
}

// --------------------------------------------------------- der PLAN
//
// Er IST der Zustand des Systems: Text, sortiert, `name<TAB>hash` je
// Zeile. Diese Datei haelt ihn genauso -- als Text, und nicht als
// Tabelle im Speicher, aus der man ihn wieder herstellen muesste.

fn plan_zeilen(plan: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while g8(plan + i) != 0 {
        if g8(plan + i) == 10 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Name und Hash der k-ten Zeile. `name` und `hash` duerfen 0 sein.
fn plan_zeile(plan: u64, k: u64, name: u64, hash: u64) -> bool {
    var zeile: u64 = 0
    var i: u64 = 0
    while zeile < k && g8(plan + i) != 0 {
        if g8(plan + i) == 10 {
            zeile = zeile + 1
        }
        i = i + 1
    }
    if g8(plan + i) == 0 {
        return false
    }
    var j: u64 = 0
    while g8(plan + i) != 9 && g8(plan + i) != 10 && g8(plan + i) != 0 {
        if name != 0 {
            p8(name + j, g8(plan + i))
        }
        j = j + 1
        i = i + 1
    }
    if name != 0 {
        p8(name + j, 0)
    }
    if g8(plan + i) != 9 {
        return false
    }
    i = i + 1
    j = 0
    while g8(plan + i) != 10 && g8(plan + i) != 0 {
        if hash != 0 {
            p8(hash + j, g8(plan + i))
        }
        j = j + 1
        i = i + 1
    }
    if hash != 0 {
        p8(hash + j, 0)
    }
    return true
}

fn plan_hash(plan: u64, name: u64, out: u64) -> bool {
    var nm: [u8; 64] = [0 as u8; 64]
    let n: u64 = plan_zeilen(plan)
    var k: u64 = 0
    while k < n {
        if plan_zeile(plan, k, (&nm[0 as usize]) as u64, out) {
            if ulib.streq((&nm[0 as usize]) as u64, name) {
                return true
            }
        }
        k = k + 1
    }
    return false
}

// Eine Zeile in den PLAN legen, sortiert, und eine vorhandene mit
// demselben Namen ERSETZEN. Das ist das ganze Nachziehen: eine neue
// Fassung ist derselbe Name mit einem anderen Hash.
fn plan_setzen(plan: u64, name: u64, hash: u64) {
    var nm: [u8; 64] = [0 as u8; 64]
    var hs: [u8; 72] = [0 as u8; 72]
    let out: u64 = (&PLAN2[0 as usize]) as u64
    p8(out, 0)
    let n: u64 = plan_zeilen(plan)
    var k: u64 = 0
    var gesetzt: bool = false
    while k < n {
        if plan_zeile(plan, k, (&nm[0 as usize]) as u64,
            (&hs[0 as usize]) as u64) {
            let c: u64 = ulib.cmp((&nm[0 as usize]) as u64, name)
            if c == 0 {
                // derselbe Name: die alte Zeile faellt weg
                k = k
            } else {
                if c > 0 && !gesetzt && hash != 0 {
                    zeile_an(out, name, hash)
                    gesetzt = true
                }
                zeile_an(out, (&nm[0 as usize]) as u64,
                    (&hs[0 as usize]) as u64)
            }
        }
        k = k + 1
    }
    if !gesetzt && hash != 0 {
        zeile_an(out, name, hash)
    }
    ulib.strcpy(plan, out)
}

fn zeile_an(out: u64, name: u64, hash: u64) {
    var tab: [u8; 2] = "\t\0"
    var nl: [u8; 2] = "\n\0"
    ulib.strcat(out, name)
    ulib.strcat(out, (&tab[0 as usize]) as u64)
    ulib.strcat(out, hash)
    ulib.strcat(out, (&nl[0 as usize]) as u64)
}

// ----------------------------------------------------- Generationen

fn gen_pfad(out: u64, n: u64, datei: u64) {
    ulib.strcpy(out, (&P_GENS[0 as usize]) as u64)
    slash(out)
    zahl_an(out, n)
    if datei != 0 {
        slash(out)
        ulib.strcat(out, datei)
    }
}

fn aktuell() -> u64 {
    var b: [u8; 32] = [0 as u8; 32]
    let n: u64 = datei_lesen((&P_AKT[0 as usize]) as u64,
        (&b[0 as usize]) as u64, 31)
    if n == 0 || n == 0xFFFFFFFFFFFFFFFF {
        return 0xFFFFFFFFFFFFFFFF
    }
    p8((&b[0 as usize]) as u64 + n, 0)
    return ulib.to_num((&b[0 as usize]) as u64)
}

// ACHT ZIFFERN UND EIN ZEILENENDE. Siehe den Kopf dieser Datei: die
// feste Breite ist der Grund, warum das Umschalten ein einziger
// Sektorschreibvorgang ist.
fn aktuell_setzen(n: u64) -> bool {
    var b: [u8; 16] = [0 as u8; 16]
    var v: u64 = n
    var i: u64 = 8
    while i > 0 {
        i = i - 1
        b[i as usize] = (48 + (v % 10)) as u8
        v = v / 10
    }
    b[8 as usize] = 10 as u8
    b[9 as usize] = 0 as u8
    return fest_schreiben((&P_AKT[0 as usize]) as u64,
        (&b[0 as usize]) as u64, 9)
}

// ------------------------------------------------- DIE ERPROBUNG
//
// RUNDE UPDATE. `/system/ERPROBUNG` ist die andere Haelfte von
// `kernel/ab.fi`: der Kern zaehlt die Startversuche hoch und faellt
// zurueck, dieses Programm SCHREIBT den Eintrag beim Umschalten und
// setzt den Erfolgsvermerk, wenn ein Start durchgelaufen ist.
//
// GENAU 36 OKTETTE, feste Breite, aus demselben Grund wie AKTUELL:
//
//     gen=00000007 vor=00000006 v=01 ok=0\n
//
// Wer das Format aendert, aendert `kernel/ab.fi` mit -- es gibt keine
// dritte Stelle, die es liest.
fn erp_bauen(b: u64, gen: u64, vor: u64, v: u64, ok: u64) {
    var muster: [u8; 37] = "gen=00000000 vor=00000000 v=00 ok=0\n\0"
    var i: u64 = 0
    while i < 36 {
        p8(b + i, muster[i as usize] as u64)
        i = i + 1
    }
    erp_zahl(b, 4, 8, gen)
    erp_zahl(b, 17, 8, vor)
    erp_zahl(b, 28, 2, v)
    erp_zahl(b, 34, 1, ok)
}

fn erp_zahl(b: u64, off: u64, n: u64, v: u64) {
    var rest: u64 = v
    var i: u64 = n
    while i > 0 {
        i = i - 1
        p8(b + off + i, 48 + (rest % 10))
        rest = rest / 10
    }
}

fn erp_ziffern(b: u64, off: u64, n: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < n {
        let c: u64 = g8(b + off + i)
        if c < 48 || c > 57 {
            return 0xFFFFFFFFFFFFFFFF
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

fn erp_schreiben(gen: u64, vor: u64, v: u64, ok: u64) -> bool {
    var b: [u8; 40] = [0 as u8; 40]
    erp_bauen((&b[0 as usize]) as u64, gen, vor, v, ok)
    return fest_schreiben((&P_ERP[0 as usize]) as u64,
        (&b[0 as usize]) as u64, 36)
}

// Liest die vier Zahlen. `false` heisst: es gibt keine oder sie ist
// unlesbar -- und dann wird sie NICHT ueberschrieben, sondern gemeldet.
fn erp_lesen(gen: *mut u64, vor: *mut u64, v: *mut u64, ok: *mut u64)
    -> bool {
    var b: [u8; 40] = [0 as u8; 40]
    let n: u64 = datei_lesen((&P_ERP[0 as usize]) as u64,
        (&b[0 as usize]) as u64, 36)
    if n != 36 {
        return false
    }
    let p: u64 = (&b[0 as usize]) as u64
    *gen = erp_ziffern(p, 4, 8)
    *vor = erp_ziffern(p, 17, 8)
    *v = erp_ziffern(p, 28, 2)
    *ok = erp_ziffern(p, 34, 1)
    if *gen == 0xFFFFFFFFFFFFFFFF || *vor == 0xFFFFFFFFFFFFFFFF {
        return false
    }
    if *v == 0xFFFFFFFFFFFFFFFF || *ok == 0xFFFFFFFFFFFFFFFF {
        return false
    }
    return true
}

fn gen_hoechste() -> u64 {
    var ents: [u8; 4096] = [0 as u8; 4096]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&P_GENS[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return 0xFFFFFFFFFFFFFFFF
    }
    let n: u64 = ulib.sys(217, fd, (&ents[0 as usize]) as u64, 4096)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return 0xFFFFFFFFFFFFFFFF
    }
    var hoch: u64 = 0xFFFFFFFFFFFFFFFF
    var at: u64 = 0
    while at + 19 < n {
        let rl: u64 = g16((&ents[0 as usize]) as u64 + at + 16)
        if rl == 0 {
            at = n
        } else {
            let nm: u64 = (&ents[0 as usize]) as u64 + at + 19
            if g8(nm) >= 48 && g8(nm) <= 57 {
                let v: u64 = ulib.to_num(nm)
                if hoch == 0xFFFFFFFFFFFFFFFF || v > hoch {
                    hoch = v
                }
            }
            at = at + rl
        }
    }
    return hoch
}

fn plan_lesen(n: u64, out: u64) -> bool {
    gen_pfad((&PFAD[0 as usize]) as u64, n, (&N_PLAN[0 as usize]) as u64)
    let r: u64 = datei_lesen((&PFAD[0 as usize]) as u64, out, 8000)
    if r == 0xFFFFFFFFFFFFFFFF {
        p8(out, 0)
        return false
    }
    p8(out + r, 0)
    return true
}

fn plan_schreiben(n: u64, plan: u64, grund: u64) -> bool {
    gen_pfad((&PFAD[0 as usize]) as u64, n, 0)
    mkdir((&PFAD[0 as usize]) as u64)
    gen_pfad((&PFAD[0 as usize]) as u64, n, (&N_PLAN[0 as usize]) as u64)
    if !datei_schreiben((&PFAD[0 as usize]) as u64, plan, laenge(plan)) {
        return false
    }
    gen_pfad((&PFAD[0 as usize]) as u64, n, (&N_GRUND[0 as usize]) as u64)
    var z: [u8; 128] = [0 as u8; 128]
    ulib.strncpy((&z[0 as usize]) as u64, grund, 120)
    var nl: [u8; 2] = "\n\0"
    ulib.strcat((&z[0 as usize]) as u64, (&nl[0 as usize]) as u64)
    return datei_schreiben((&PFAD[0 as usize]) as u64,
        (&z[0 as usize]) as u64, laenge((&z[0 as usize]) as u64))
}

// ------------------------------------------------------------- Store

fn store_pfad(out: u64, hex: u64, datei: u64) {
    ulib.strcpy(out, (&P_STORE[0 as usize]) as u64)
    slash(out)
    var k: [u8; 32] = [0 as u8; 32]
    ulib.strncpy((&k[0 as usize]) as u64, hex, KURZ + 1)
    ulib.strcat(out, (&k[0 as usize]) as u64)
    if datei != 0 {
        slash(out)
        ulib.strcat(out, datei)
    }
}

// Das Archiv auspacken. Ein Eintrag: Art, Modus, Namenslaenge, Name,
// Inhaltslaenge, Inhalt -- sortiert ueber die OKTETTE des Namens, also
// steht ein Verzeichnis immer vor dem, was darin liegt.
fn archiv_aus(daten: u64, dlen: u64, ziel: u64) -> bool {
    var i: u64 = 0
    while i < dlen {
        if i + 5 > dlen {
            return false
        }
        let typ: u64 = g8(daten + i)
        let modus: u64 = g16(daten + i + 1)
        let nl: u64 = g16(daten + i + 3)
        i = i + 5
        if i + nl + 8 > dlen {
            return false
        }
        var nm: [u8; 128] = [0 as u8; 128]
        var k: u64 = 0
        while k < nl && k < 127 {
            nm[k as usize] = g8(daten + i + k) as u8
            k = k + 1
        }
        nm[k as usize] = 0 as u8
        i = i + nl
        let il: u64 = g64(daten + i)
        i = i + 8
        if i + il > dlen {
            return false
        }
        ulib.strcpy((&PFAD2[0 as usize]) as u64, ziel)
        slash((&PFAD2[0 as usize]) as u64)
        ulib.strcat((&PFAD2[0 as usize]) as u64, (&nm[0 as usize]) as u64)
        if typ == 100 {
            mkdir((&PFAD2[0 as usize]) as u64)
        } else {
            if !datei_schreiben((&PFAD2[0 as usize]) as u64, daten + i, il) {
                return false
            }
            ulib.sys(90, (&PFAD2[0 as usize]) as u64, modus, 0)
        }
        i = i + il
    }
    return true
}

// ------------------------------------------------------- die Sicht
//
// `/apps` wird VOLLSTAENDIG neu gebaut und nie fortgeschrieben. Der
// Grund steht in PAKETE.md: ein Zustand, den man nachzieht, haengt von
// seiner Geschichte ab -- dann waere „Generation 7" nicht dasselbe wie
// „Generation 7, auf dem anderen Weg erreicht".
fn verweisen(quelle: u64, ziel: u64) -> u64 {
    var ents: [u8; 2048] = [0 as u8; 2048]
    var gemacht: u64 = 0
    mkdir(ziel)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, quelle, 0, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = ulib.sys(217, fd, (&ents[0 as usize]) as u64, 2048)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return 0
    }
    var at: u64 = 0
    while at + 19 < n {
        let rl: u64 = g16((&ents[0 as usize]) as u64 + at + 16)
        if rl == 0 {
            at = n
        } else {
            let nm: u64 = (&ents[0 as usize]) as u64 + at + 19
            var punkt: [u8; 2] = ".\0"
            var punkt2: [u8; 3] = "..\0"
            if !ulib.streq(nm, (&punkt[0 as usize]) as u64)
                && !ulib.streq(nm, (&punkt2[0 as usize]) as u64)
                && !ulib.streq(nm, (&N_PAKET[0 as usize]) as u64) {
                var q: [u8; 256] = [0 as u8; 256]
                var z: [u8; 256] = [0 as u8; 256]
                ulib.strcpy((&q[0 as usize]) as u64, quelle)
                slash((&q[0 as usize]) as u64)
                ulib.strcat((&q[0 as usize]) as u64, nm)
                ulib.strcpy((&z[0 as usize]) as u64, ziel)
                slash((&z[0 as usize]) as u64)
                ulib.strcat((&z[0 as usize]) as u64, nm)
                if ulib.is_dir((&q[0 as usize]) as u64) {
                    gemacht = gemacht + verweisen((&q[0 as usize]) as u64,
                        (&z[0 as usize]) as u64)
                } else {
                    // DER ZWEITE NAME. Kein Kopieren: die Oktette liegen
                    // EINMAL da, und `link` (Aufruf 86) ist genau dafuer
                    // in dieser Runde entstanden.
                    let r: u64 = ulib.sys(ulib.SYS_LINK,
                        (&q[0 as usize]) as u64, (&z[0 as usize]) as u64, 0)
                    if !ulib.bad(r) {
                        gemacht = gemacht + 1
                    }
                }
            }
            at = at + rl
        }
    }
    return gemacht
}

fn apps_bauen(gen: u64) -> u64 {
    var nm: [u8; 64] = [0 as u8; 64]
    var hs: [u8; 72] = [0 as u8; 72]
    let plan: u64 = (&PLAN[0 as usize]) as u64
    if !plan_lesen(gen, plan) {
        fehler((&E_PLAN[0 as usize]) as u64, 0)
        return 0xFFFFFFFFFFFFFFFF
    }
    weg((&P_APPS[0 as usize]) as u64)
    mkdir((&P_APPS[0 as usize]) as u64)
    var verweise: u64 = 0
    let n: u64 = plan_zeilen(plan)
    var k: u64 = 0
    while k < n {
        if plan_zeile(plan, k, (&nm[0 as usize]) as u64,
            (&hs[0 as usize]) as u64) {
            store_pfad((&PFAD[0 as usize]) as u64, (&hs[0 as usize]) as u64, 0)
            if !ulib.is_dir((&PFAD[0 as usize]) as u64) {
                fehler((&E_STORE[0 as usize]) as u64, (&nm[0 as usize]) as u64)
                return 0xFFFFFFFFFFFFFFFF
            }
            var z: [u8; 128] = [0 as u8; 128]
            ulib.strcpy((&z[0 as usize]) as u64, (&P_APPS[0 as usize]) as u64)
            slash((&z[0 as usize]) as u64)
            ulib.strcat((&z[0 as usize]) as u64, (&nm[0 as usize]) as u64)
            ulib.strcat((&z[0 as usize]) as u64, (&N_OSP[0 as usize]) as u64)
            verweise = verweise + verweisen((&PFAD[0 as usize]) as u64,
                (&z[0 as usize]) as u64)
        }
        k = k + 1
    }
    return verweise
}

// Die drei Toepfe. Sie gehoeren dem NUTZER und nicht dem Paket -- und
// deshalb loescht `entfernen` sie und `zurueck` bringt sie nicht wieder
// (PAKETE.md, Abschnitt 5).
fn toepfe(name: u64, anlegen: bool) {
    mkdir((&P_USERS[0 as usize]) as u64)
    mkdir((&P_ROOT[0 as usize]) as u64)
    var i: u64 = 0
    while i < 3 {
        var t: u64 = (&T_CONF[0 as usize]) as u64
        if i == 1 {
            t = (&T_STATE[0 as usize]) as u64
        }
        if i == 2 {
            t = (&T_CACHE[0 as usize]) as u64
        }
        ulib.strcpy((&PFAD[0 as usize]) as u64, (&P_ROOT[0 as usize]) as u64)
        slash((&PFAD[0 as usize]) as u64)
        ulib.strcat((&PFAD[0 as usize]) as u64, t)
        mkdir((&PFAD[0 as usize]) as u64)
        slash((&PFAD[0 as usize]) as u64)
        ulib.strcat((&PFAD[0 as usize]) as u64, name)
        if anlegen {
            mkdir((&PFAD[0 as usize]) as u64)
        } else {
            weg((&PFAD[0 as usize]) as u64)
        }
        i = i + 1
    }
}

// ------------------------------------------------- DIE SIGNATUR
//
// RUNDE UPDATE, UND ES IST DER PUNKT DIESER RUNDE. Bis hierher hat
// dieses Programm eine Pruefsumme gerechnet: sie faengt eine kaputte
// Uebertragung und sonst nichts. Wer die Oktette AENDERN kann, aendert
// die Pruefsumme mit -- sie steht im selben Kopf. Ein Update-Weg, der
// nur eine Pruefsumme kennt, gehoert jedem, der die Verbindung umleitet.
//
// DESHALB: JEDES PAKET WIRD SIGNIERT INSTALLIERT ODER GAR NICHT.
//
//   * Der vertraute Schluessel liegt in `/system/schluessel.pub`, 32
//     rohe Oktette, ein oeffentlicher Ed25519-Schluessel. FEHLT ER,
//     WIRD NICHTS INSTALLIERT. Es gibt keinen Schalter, der das
//     abschaltet -- eine Ausnahme, die man in einem Notfall setzt, ist
//     die Ausnahme, die ein Angreifer benutzt.
//   * Neben `x.opk` liegt `x.opk.sig`, 64 rohe Oktette: die
//     Ed25519-Signatur ueber ALLE Oktette des Pakets, Kopf eingeschlossen.
//     Nicht ueber die Pruefsumme im Kopf -- dann waere der Kopf selbst
//     ungedeckt und Laengenfelder liessen sich austauschen.
//   * Bei `aktualisieren` wird ZUSAETZLICH `INDEX.sig` gegen denselben
//     Schluessel geprueft, bevor eine Zeile des INDEX geglaubt wird.
//     Damit haengt die ganze Kette an EINEM Schluessel: INDEX ->
//     Streuwert -> Paketoktette, und jedes Glied wird gerechnet.
//
// Die Rechnung selbst steht in `lib/crypto/ed25519.fi` und ist gegen die
// 1024 offiziellen Vektoren von RFC 8032 und gegen libsodium gemessen
// (`tools/update/vectors.py`).

// Den vertrauten Schluessel holen. `false` heisst: es wird nichts
// installiert, und der Grund steht auf der Fehlerausgabe.
fn schluessel_holen() -> bool {
    let n: u64 = datei_lesen((&P_KEY[0 as usize]) as u64,
        (&KEY[0 as usize]) as u64, 32)
    if n == 0xFFFFFFFFFFFFFFFF || n == 0 {
        fehler((&E_NOKEY[0 as usize]) as u64, 0)
        return false
    }
    if n != 32 {
        fehler((&E_KEYLEN[0 as usize]) as u64, 0)
        return false
    }
    return true
}

// Eine Signaturdatei lesen. `pfad` ist die Datei, `endung` das, was
// daran gehaengt wird (".sig") -- oder 0, wenn `pfad` schon die
// Signaturdatei IST.
fn signatur_holen(pfad: u64, endung: u64) -> bool {
    ulib.strcpy((&SIGP[0 as usize]) as u64, pfad)
    if endung != 0 {
        ulib.strcat((&SIGP[0 as usize]) as u64, endung)
    }
    let n: u64 = datei_lesen((&SIGP[0 as usize]) as u64,
        (&SIG[0 as usize]) as u64, 64)
    if n == 0xFFFFFFFFFFFFFFFF || n == 0 {
        fehler((&E_NOSIG[0 as usize]) as u64, (&SIGP[0 as usize]) as u64)
        return false
    }
    if n != 64 {
        fehler((&E_SIGLEN[0 as usize]) as u64, (&SIGP[0 as usize]) as u64)
        return false
    }
    return true
}

// Die Rechnung. `msg`/`len` sind die Oktette, ueber die signiert wurde.
fn signatur_gilt(msg: u64, len: u64) -> bool {
    var c: ed25519.Ctx = ed25519.ctx_new()
    if !ed25519.ctx_init(&c) {
        fehler((&E_CTX[0 as usize]) as u64, 0)
        return false
    }
    return ed25519.ed25519_verify(&c, (&KEY[0 as usize]) as u64, msg,
        len as usize, (&SIG[0 as usize]) as u64)
}

// Der ganze Weg fuer eine Paketdatei: Schluessel, Signaturdatei,
// Rechnung. Ein `false` heisst IMMER: nicht installieren.
fn paket_signatur(pfad: u64, len: u64) -> bool {
    if !schluessel_holen() {
        return false
    }
    if !signatur_holen(pfad, (&N_SIG[0 as usize]) as u64) {
        return false
    }
    if !signatur_gilt((&PKT[0 as usize]) as u64, len) {
        fehler((&E_SIG[0 as usize]) as u64, pfad)
        return false
    }
    ulib.say((&S_SIGOK[0 as usize]) as u64)
    ulib.say(pfad)
    ulib.nl()
    return true
}

// ------------------------------------------- ein Paket in den Store
//
// Rueckgabe: 0 = Fehler, sonst die Laenge der Metadaten. Der Hexname
// steht danach in HEX, der Name in NAME.
fn paket_pruefen(len: u64) -> u64 {
    let p: u64 = (&PKT[0 as usize]) as u64
    if len < KOPF {
        fehler((&E_KENN[0 as usize]) as u64, 0)
        return 0
    }
    var kenn: [u8; 9] = "OPKG0001\0"
    if !ulib.strneq(p, (&kenn[0 as usize]) as u64, 8) {
        fehler((&E_KENN[0 as usize]) as u64, 0)
        return 0
    }
    let ml: u64 = g64(p + 8)
    let dl: u64 = g64(p + 16)
    if KOPF + ml + dl != len {
        fehler((&E_LAENG[0 as usize]) as u64, 0)
        return 0
    }
    // DIE PRUEFUNG IST HIER UND NUR HIER, genau wie in `opk.py`: jeder
    // Weg ins System geht durch diese Funktion.
    sha.sha256(p + KOPF, ml + dl, (&HASH[0 as usize]) as u64)
    var i: u64 = 0
    while i < 32 {
        if g8((&HASH[0 as usize]) as u64 + i) != g8(p + 24 + i) {
            fehler((&E_HASH[0 as usize]) as u64, 0)
            return 0
        }
        i = i + 1
    }
    sha.hex_out((&HASH[0 as usize]) as u64, 32, (&HEX[0 as usize]) as u64)
    if !meta_wert(p + KOPF, ml, (&M_NAME[0 as usize]) as u64,
        (&NAME[0 as usize]) as u64, 63) {
        fehler((&E_NONAME[0 as usize]) as u64, 0)
        return 0
    }
    return ml
}

fn store_schreiben(ml: u64, len: u64) -> bool {
    let p: u64 = (&PKT[0 as usize]) as u64
    let dl: u64 = len - KOPF - ml
    store_pfad((&PFAD[0 as usize]) as u64, (&HEX[0 as usize]) as u64, 0)
    if ulib.is_dir((&PFAD[0 as usize]) as u64) {
        // Schon da. Gleicher Hash heisst gleicher Inhalt -- aber der
        // KURZE Name sind nur achtzig Bit, und deshalb wird das PAKET
        // des vorhandenen Eintrags gegen unseres gehalten.
        store_pfad((&PFAD2[0 as usize]) as u64, (&HEX[0 as usize]) as u64,
            (&N_PAKET[0 as usize]) as u64)
        var alt: [u8; 4096] = [0 as u8; 4096]
        let n: u64 = datei_lesen((&PFAD2[0 as usize]) as u64,
            (&alt[0 as usize]) as u64, 4095)
        if n != ml || !ulib.strneq((&alt[0 as usize]) as u64, p + KOPF, ml) {
            fehler((&E_KOLL[0 as usize]) as u64, (&HEX[0 as usize]) as u64)
            return false
        }
        return true
    }
    mkdir((&P_STORE[0 as usize]) as u64)
    weg((&P_TEIL[0 as usize]) as u64)
    mkdir((&P_TEIL[0 as usize]) as u64)
    if !archiv_aus(p + KOPF + ml, dl, (&P_TEIL[0 as usize]) as u64) {
        fehler((&E_ARCH[0 as usize]) as u64, 0)
        return false
    }
    ulib.strcpy((&PFAD2[0 as usize]) as u64, (&P_TEIL[0 as usize]) as u64)
    slash((&PFAD2[0 as usize]) as u64)
    ulib.strcat((&PFAD2[0 as usize]) as u64, (&N_PAKET[0 as usize]) as u64)
    if !datei_schreiben((&PFAD2[0 as usize]) as u64, p + KOPF, ml) {
        fehler((&E_ARCH[0 as usize]) as u64, (&PFAD2[0 as usize]) as u64)
        return false
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    // DER LETZTE SCHRITT IST EIN EINZIGES UMBENENNEN.
    let r: u64 = ulib.sys(ulib.SYS_RENAME, (&P_TEIL[0 as usize]) as u64,
        (&PFAD[0 as usize]) as u64, 0)
    if ulib.bad(r) {
        fehler((&E_REN[0 as usize]) as u64, (&PFAD[0 as usize]) as u64)
        ulib.sayn(r)
        ulib.nl()
        return false
    }
    return true
}

// Eine neue Generation aus dem laufenden Plan, mit `name` gesetzt oder
// entfernt, und der Umschlag darauf.
fn umschalten(name: u64, hash: u64, grund: u64) -> u64 {
    let plan: u64 = (&PLAN[0 as usize]) as u64
    let jetzt: u64 = aktuell()
    if jetzt == 0xFFFFFFFFFFFFFFFF {
        p8(plan, 0)
    } else {
        plan_lesen(jetzt, plan)
    }
    plan_setzen(plan, name, hash)
    var neu: u64 = 0
    let hoch: u64 = gen_hoechste()
    if hoch != 0xFFFFFFFFFFFFFFFF {
        neu = hoch + 1
    }
    mkdir((&P_SYS[0 as usize]) as u64)
    mkdir((&P_GENS[0 as usize]) as u64)
    if !plan_schreiben(neu, plan, grund) {
        fehler((&E_PLAN[0 as usize]) as u64, 0)
        return 0xFFFFFFFFFFFFFFFF
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    // ------------------------------------------------ DER UMSCHLAG
    if !aktuell_setzen(neu) {
        fehler((&E_AKT[0 as usize]) as u64, 0)
        return 0xFFFFFFFFFFFFFFFF
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    // RUNDE UPDATE: DIE NEUE GENERATION IST IN ERPROBUNG. Von hier an
    // zaehlt `kernel/ab.fi` bei jedem Start mit, und bleibt der
    // Erfolgsvermerk aus, faellt der Kern von selbst auf `jetzt`
    // zurueck. Gibt es noch keine vorige Generation, ist sie ihre
    // eigene -- es gaebe nichts, wohin man zurueckfiele.
    var vorher: u64 = neu
    if jetzt != 0xFFFFFFFFFFFFFFFF {
        vorher = jetzt
    }
    if !erp_schreiben(neu, vorher, 0, 0) {
        fehler((&E_ERPW[0 as usize]) as u64, 0)
        return 0xFFFFFFFFFFFFFFFF
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.say((&S_ERP[0 as usize]) as u64)
    ulib.sayu(neu)
    ulib.say((&S_VOR[0 as usize]) as u64)
    ulib.sayu(vorher)
    ulib.nl()
    if apps_bauen(neu) == 0xFFFFFFFFFFFFFFFF {
        return 0xFFFFFFFFFFFFFFFF
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    return neu
}

// ------------------------------------------------------- die Befehle

fn cmd_liste() -> u64 {
    var nm: [u8; 64] = [0 as u8; 64]
    var hs: [u8; 72] = [0 as u8; 72]
    let g: u64 = aktuell()
    if g == 0xFFFFFFFFFFFFFFFF {
        ulib.say((&S_LEER[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    let plan: u64 = (&PLAN[0 as usize]) as u64
    plan_lesen(g, plan)
    let n: u64 = plan_zeilen(plan)
    sagn((&S_GEN[0 as usize]) as u64, g)
    if n == 0 {
        ulib.say((&S_LEER[0 as usize]) as u64)
        ulib.nl()
    }
    var k: u64 = 0
    while k < n {
        if plan_zeile(plan, k, (&nm[0 as usize]) as u64,
            (&hs[0 as usize]) as u64) {
            ulib.say((&S_TAB[0 as usize]) as u64)
            ulib.say((&nm[0 as usize]) as u64)
            ulib.say((&S_PFEIL[0 as usize]) as u64)
            var kz: [u8; 16] = [0 as u8; 16]
            ulib.strncpy((&kz[0 as usize]) as u64, (&hs[0 as usize]) as u64, 13)
            ulib.say((&kz[0 as usize]) as u64)
            ulib.nl()
        }
        k = k + 1
    }
    return 0
}

fn cmd_generationen() -> u64 {
    let jetzt: u64 = aktuell()
    let hoch: u64 = gen_hoechste()
    if hoch == 0xFFFFFFFFFFFFFFFF {
        ulib.say((&S_LEER[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    var i: u64 = 0
    while i <= hoch {
        gen_pfad((&PFAD[0 as usize]) as u64, i, (&N_PLAN[0 as usize]) as u64)
        if da((&PFAD[0 as usize]) as u64) {
            ulib.say((&S_GEN[0 as usize]) as u64)
            ulib.sayu(i)
            gen_pfad((&PFAD[0 as usize]) as u64, i,
                (&N_GRUND[0 as usize]) as u64)
            var gr: [u8; 128] = [0 as u8; 128]
            let n: u64 = datei_lesen((&PFAD[0 as usize]) as u64,
                (&gr[0 as usize]) as u64, 120)
            if n != 0xFFFFFFFFFFFFFFFF && n > 0 {
                var k: u64 = n
                if k > 0 && gr[(k - 1) as usize] == 10 as u8 {
                    k = k - 1
                }
                gr[k as usize] = 0 as u8
                ulib.say((&S_PFEIL[0 as usize]) as u64)
                ulib.say((&gr[0 as usize]) as u64)
            }
            if i == jetzt {
                ulib.say((&S_AKTIV[0 as usize]) as u64)
            }
            ulib.nl()
        }
        i = i + 1
    }
    return 0
}

fn cmd_installieren(datei: u64, grund: u64) -> u64 {
    let len: u64 = datei_lesen(datei, (&PKT[0 as usize]) as u64, PKT_MAX)
    if len == 0xFFFFFFFFFFFFFFFF {
        return fehler((&E_OPEN[0 as usize]) as u64, datei)
    }
    if len >= PKT_MAX {
        return fehler((&E_GROSS[0 as usize]) as u64, 0)
    }
    // DIE SIGNATUR ZUERST, vor der Pruefsumme und weit vor dem ersten
    // Schreibzugriff: was hier durchfaellt, hat das System nie beruehrt.
    if !paket_signatur(datei, len) {
        return 1
    }
    let ml: u64 = paket_pruefen(len)
    if ml == 0 {
        return 1
    }
    if !store_schreiben(ml, len) {
        return fehler((&E_SCHRB[0 as usize]) as u64, (&HEX[0 as usize]) as u64)
    }
    toepfe((&NAME[0 as usize]) as u64, true)
    let g: u64 = umschalten((&NAME[0 as usize]) as u64,
        (&HEX[0 as usize]) as u64, grund)
    if g == 0xFFFFFFFFFFFFFFFF {
        return fehler((&E_UMSCH[0 as usize]) as u64, 0)
    }
    ulib.say((&S_INST[0 as usize]) as u64)
    ulib.say((&NAME[0 as usize]) as u64)
    ulib.say((&S_PFEIL[0 as usize]) as u64)
    ulib.sayu(g)
    ulib.nl()
    return 0
}

fn cmd_entfernen(name: u64, grund: u64) -> u64 {
    var hs: [u8; 72] = [0 as u8; 72]
    let jetzt: u64 = aktuell()
    if jetzt == 0xFFFFFFFFFFFFFFFF {
        return fehler((&E_KEIN[0 as usize]) as u64, name)
    }
    let plan: u64 = (&PLAN[0 as usize]) as u64
    plan_lesen(jetzt, plan)
    if !plan_hash(plan, name, (&hs[0 as usize]) as u64) {
        return fehler((&E_KEIN[0 as usize]) as u64, name)
    }
    let g: u64 = umschalten(name, 0, grund)
    if g == 0xFFFFFFFFFFFFFFFF {
        return 1
    }
    toepfe(name, false)
    ulib.say((&S_ENTF[0 as usize]) as u64)
    ulib.say(name)
    ulib.say((&S_PFEIL[0 as usize]) as u64)
    ulib.sayu(g)
    ulib.nl()
    return 0
}

fn cmd_zurueck(n: u64) -> u64 {
    gen_pfad((&PFAD[0 as usize]) as u64, n, (&N_PLAN[0 as usize]) as u64)
    if !da((&PFAD[0 as usize]) as u64) {
        return fehler((&E_NOGEN[0 as usize]) as u64, 0)
    }
    if !aktuell_setzen(n) {
        return 1
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    // Ein Rueckfall VON HAND ist per Definition bestaetigt: da sitzt
    // jemand davor. Ohne diese Zeile bliebe der Zaehler der
    // fehlgeschlagenen Generation stehen und der Kern faellt beim
    // naechsten Start noch einmal zurueck -- auf dieselbe Stelle.
    if !erp_schreiben(n, n, 0, 1) {
        return fehler((&E_ERPW[0 as usize]) as u64, 0)
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    if apps_bauen(n) == 0xFFFFFFFFFFFFFFFF {
        return 1
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.say((&S_ZUR[0 as usize]) as u64)
    ulib.sayu(n)
    ulib.nl()
    return 0
}

// `opk erprobung`     -- was steht an
// `opk erprobung ok`  -- DER ERFOLGSVERMERK. Ohne ihn faellt der Kern
//                        nach GRENZE Startversuchen von selbst zurueck.
fn cmd_erprobung(was: u64) -> u64 {
    var gen: u64 = 0
    var vor: u64 = 0
    var v: u64 = 0
    var ok: u64 = 0
    if !erp_lesen(&gen, &vor, &v, &ok) {
        let g: u64 = aktuell()
        ulib.say((&S_ERPKEIN[0 as usize]) as u64)
        ulib.sayu(g)
        var zu: [u8; 2] = ")\0"
        ulib.say((&zu[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    if was != 0 && ulib.streq(was, (&A_OK[0 as usize]) as u64) {
        if !erp_schreiben(gen, vor, v, 1) {
            return fehler((&E_ERPW[0 as usize]) as u64, 0)
        }
        ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
        ulib.say((&S_ERPOK[0 as usize]) as u64)
        ulib.sayu(gen)
        ulib.nl()
        return 0
    }
    ulib.say((&S_ERPST[0 as usize]) as u64)
    ulib.sayu(gen)
    ulib.say((&S_VOR[0 as usize]) as u64)
    ulib.sayu(vor)
    ulib.say((&S_VERS[0 as usize]) as u64)
    ulib.sayu(v)
    if ok != 0 {
        ulib.say((&S_BEST[0 as usize]) as u64)
    } else {
        ulib.say((&S_OFFEN[0 as usize]) as u64)
    }
    ulib.nl()
    return 0
}

fn cmd_richten() -> u64 {
    let g: u64 = aktuell()
    if g == 0xFFFFFFFFFFFFFFFF {
        return fehler((&E_NOGEN[0 as usize]) as u64, 0)
    }
    let v: u64 = apps_bauen(g)
    if v == 0xFFFFFFFFFFFFFFFF {
        return 1
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.say((&S_RICHT[0 as usize]) as u64)
    ulib.sayu(v)
    ulib.nl()
    return 0
}

// `pruefen` beantwortet GENAU zwei Fragen, und benennt sie: hat jeder
// Hash, den irgendeine Generation nennt, einen Store-Eintrag, und
// stimmt `/apps` mit dem PLAN der laufenden Generation ueberein.
//
// WAS ES NICHT TUT: den vollen Inhaltshash eines Store-Eintrags
// nachrechnen. Dafuer muesste dieses Programm das Archiv aus dem
// Verzeichnisbaum wieder zusammenbauen -- deterministisch, in derselben
// Reihenfolge wie `opk.py`. Das ist eine eigene Runde; `opk.py pruefen`
// auf dem Wirt kann es, und der Laeufer benutzt genau das dafuer.
fn cmd_pruefen() -> u64 {
    var nm: [u8; 64] = [0 as u8; 64]
    var hs: [u8; 72] = [0 as u8; 72]
    let hoch: u64 = gen_hoechste()
    if hoch == 0xFFFFFFFFFFFFFFFF {
        return fehler((&E_NOGEN[0 as usize]) as u64, 0)
    }
    var fehlt: u64 = 0
    var gesehen: u64 = 0
    var i: u64 = 0
    while i <= hoch {
        let plan: u64 = (&PLAN[0 as usize]) as u64
        if plan_lesen(i, plan) {
            let n: u64 = plan_zeilen(plan)
            var k: u64 = 0
            while k < n {
                if plan_zeile(plan, k, (&nm[0 as usize]) as u64,
                    (&hs[0 as usize]) as u64) {
                    gesehen = gesehen + 1
                    store_pfad((&PFAD[0 as usize]) as u64,
                        (&hs[0 as usize]) as u64, (&N_PAKET[0 as usize]) as u64)
                    if !da((&PFAD[0 as usize]) as u64) {
                        fehlt = fehlt + 1
                        fehler((&E_STORE[0 as usize]) as u64,
                            (&nm[0 as usize]) as u64)
                    }
                }
                k = k + 1
            }
        }
        i = i + 1
    }
    ulib.say((&S_OK[0 as usize]) as u64)
    ulib.sayu(gesehen)
    ulib.say((&S_PFEIL[0 as usize]) as u64)
    ulib.sayu(fehlt)
    ulib.nl()
    if fehlt != 0 {
        return 1
    }
    return 0
}

// ---------------------------------------------------- aktualisieren
//
// Die Quelle ist ein Verzeichnis mit den `.opkg`-Dateien, einem `INDEX`
// (`name TAB fassung TAB hash TAB groesse TAB datei`) und `INDEX.sig`.
//
// WAS HIER GEPRUEFT WIRD: dass das Paket, das die Quelle liefert, GENAU
// den Hash hat, den der INDEX ihm zuschreibt. Das ist ein echtes Glied
// der Kette aus PAKETE.md, Abschnitt 4 -- es faengt ein ausgetauschtes
// Paket.
//
// WAS HIER NICHT GEPRUEFT WIRD, und es steht auch in docs/ROUNDINSTALL.md:
// die Ed25519-Signatur ueber den INDEX. Damit faengt dieses Programm
// einen ausgetauschten INDEX NICHT. Ed25519 in Firn ist eine eigene
// Runde; wer die Kette ganz will, prueft die Quelle heute auf dem Wirt
// (`opk.py quelle`) und reicht sie geprueft herein.
fn index_zeile(name: u64, hash: u64, datei: u64) -> bool {
    let idx: u64 = (&IDX[0 as usize]) as u64
    var i: u64 = 0
    while g8(idx + i) != 0 {
        // Zeilenanfang
        var j: u64 = i
        var feld: u64 = 0
        var nm: [u8; 64] = [0 as u8; 64]
        var k: u64 = 0
        while g8(idx + j) != 10 && g8(idx + j) != 0 && k < 63
            && g8(idx + j) != 9 {
            nm[k as usize] = g8(idx + j) as u8
            k = k + 1
            j = j + 1
        }
        nm[k as usize] = 0 as u8
        if ulib.streq((&nm[0 as usize]) as u64, name) && g8(idx + j) == 9 {
            // Feld 2 (fassung) ueberspringen, Feld 3 ist der Hash.
            j = j + 1
            while g8(idx + j) != 9 && g8(idx + j) != 10 && g8(idx + j) != 0 {
                j = j + 1
            }
            if g8(idx + j) != 9 {
                return false
            }
            j = j + 1
            k = 0
            while g8(idx + j) != 9 && g8(idx + j) != 10 && g8(idx + j) != 0
                && k < 71 {
                p8(hash + k, g8(idx + j))
                k = k + 1
                j = j + 1
            }
            p8(hash + k, 0)
            if g8(idx + j) != 9 {
                return false
            }
            // Feld 4 (groesse) ueberspringen, Feld 5 ist der Dateiname.
            j = j + 1
            while g8(idx + j) != 9 && g8(idx + j) != 10 && g8(idx + j) != 0 {
                j = j + 1
            }
            if g8(idx + j) != 9 {
                return false
            }
            j = j + 1
            k = 0
            while g8(idx + j) != 10 && g8(idx + j) != 0 && k < 127 {
                p8(datei + k, g8(idx + j))
                k = k + 1
                j = j + 1
            }
            p8(datei + k, 0)
            return true
        }
        // zur naechsten Zeile
        while g8(idx + i) != 10 && g8(idx + i) != 0 {
            i = i + 1
        }
        if g8(idx + i) == 10 {
            i = i + 1
        }
    }
    return false
}

fn cmd_aktualisieren(name: u64, quelle: u64, grund: u64) -> u64 {
    var hs: [u8; 72] = [0 as u8; 72]
    var dt: [u8; 128] = [0 as u8; 128]
    ulib.strcpy((&PFAD[0 as usize]) as u64, quelle)
    slash((&PFAD[0 as usize]) as u64)
    ulib.strcat((&PFAD[0 as usize]) as u64, (&N_INDEX[0 as usize]) as u64)
    let n: u64 = datei_lesen((&PFAD[0 as usize]) as u64,
        (&IDX[0 as usize]) as u64, 8000)
    if n == 0xFFFFFFFFFFFFFFFF || n == 0 {
        return fehler((&E_INDEX[0 as usize]) as u64, quelle)
    }
    p8((&IDX[0 as usize]) as u64 + n, 0)
    // DIE SIGNATUR UEBER DEN INDEX. Ohne sie ist der INDEX nur eine
    // Textdatei, die jeder schreiben kann, der die Quelle stellt -- und
    // der Streuwertvergleich weiter unten prueft dann ein Paket gegen
    // einen Streuwert, den derselbe Angreifer eingetragen hat.
    if !schluessel_holen() {
        return 1
    }
    ulib.strcpy((&PFAD2[0 as usize]) as u64, quelle)
    slash((&PFAD2[0 as usize]) as u64)
    ulib.strcat((&PFAD2[0 as usize]) as u64, (&N_ISIG[0 as usize]) as u64)
    if !signatur_holen((&PFAD2[0 as usize]) as u64, 0) {
        return 1
    }
    if !signatur_gilt((&IDX[0 as usize]) as u64, n) {
        return fehler((&E_ISIG[0 as usize]) as u64, quelle)
    }
    ulib.say((&S_SIGOK[0 as usize]) as u64)
    ulib.say((&PFAD2[0 as usize]) as u64)
    ulib.nl()
    if !index_zeile(name, (&hs[0 as usize]) as u64, (&dt[0 as usize]) as u64) {
        return fehler((&E_NIX[0 as usize]) as u64, name)
    }
    ulib.strcpy((&PFAD[0 as usize]) as u64, quelle)
    slash((&PFAD[0 as usize]) as u64)
    ulib.strcat((&PFAD[0 as usize]) as u64, (&dt[0 as usize]) as u64)
    let len: u64 = datei_lesen((&PFAD[0 as usize]) as u64,
        (&PKT[0 as usize]) as u64, PKT_MAX)
    if len == 0xFFFFFFFFFFFFFFFF {
        return fehler((&E_OPEN[0 as usize]) as u64,
            (&PFAD[0 as usize]) as u64)
    }
    if !paket_signatur((&PFAD[0 as usize]) as u64, len) {
        return 1
    }
    let ml: u64 = paket_pruefen(len)
    if ml == 0 {
        return 1
    }
    // DAS GLIED DER KETTE: der Hash aus dem INDEX gegen den, der ueber
    // die Oktette des Pakets gerechnet wurde.
    if !ulib.streq((&HEX[0 as usize]) as u64, (&hs[0 as usize]) as u64) {
        return fehler((&E_HASHQ[0 as usize]) as u64, name)
    }
    if !ulib.streq((&NAME[0 as usize]) as u64, name) {
        return fehler((&E_NIX[0 as usize]) as u64, name)
    }
    if !store_schreiben(ml, len) {
        return 1
    }
    toepfe((&NAME[0 as usize]) as u64, true)
    let g: u64 = umschalten((&NAME[0 as usize]) as u64,
        (&HEX[0 as usize]) as u64, grund)
    if g == 0xFFFFFFFFFFFFFFFF {
        return 1
    }
    ulib.say((&S_INST[0 as usize]) as u64)
    ulib.say((&NAME[0 as usize]) as u64)
    ulib.say((&S_PFEIL[0 as usize]) as u64)
    ulib.sayu(g)
    ulib.nl()
    return 0
}

// ------------------------------------------------------------ das Ganze

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.say((&S_USE1[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE2[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE3[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE4[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE5[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE6[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE7[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&S_USE8[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    let cmd: u64 = ulib.arg_at(args, 1)
    var quelle: u64 = 0
    var grund: u64 = (&S_NEU[0 as usize]) as u64
    var i: u64 = 2
    while i < argc {
        let a: u64 = ulib.arg_at(args, i)
        if ulib.streq(a, (&O_QUELLE[0 as usize]) as u64) && i + 1 < argc {
            i = i + 1
            quelle = ulib.arg_at(args, i)
        } else if ulib.streq(a, (&O_GRUND[0 as usize]) as u64) && i + 1 < argc {
            i = i + 1
            grund = ulib.arg_at(args, i)
        }
        i = i + 1
    }
    if ulib.streq(cmd, (&C_LISTE[0 as usize]) as u64) {
        return cmd_liste()
    }
    if ulib.streq(cmd, (&C_GEN[0 as usize]) as u64) {
        return cmd_generationen()
    }
    if ulib.streq(cmd, (&C_RICHT[0 as usize]) as u64) {
        return cmd_richten()
    }
    if ulib.streq(cmd, (&C_PRUEF[0 as usize]) as u64) {
        return cmd_pruefen()
    }
    if ulib.streq(cmd, (&C_ERP[0 as usize]) as u64) {
        var wa: u64 = 0
        if argc >= 3 {
            wa = ulib.arg_at(args, 2)
        }
        return cmd_erprobung(wa)
    }
    if argc < 3 {
        return fehler((&E_ARG[0 as usize]) as u64, 0)
    }
    let a2: u64 = ulib.arg_at(args, 2)
    if ulib.streq(cmd, (&C_INST[0 as usize]) as u64) {
        return cmd_installieren(a2, grund)
    }
    if ulib.streq(cmd, (&C_ENTF[0 as usize]) as u64) {
        return cmd_entfernen(a2, grund)
    }
    if ulib.streq(cmd, (&C_ZUR[0 as usize]) as u64) {
        return cmd_zurueck(ulib.to_num(a2))
    }
    if ulib.streq(cmd, (&C_AKTU[0 as usize]) as u64) {
        if quelle == 0 {
            return fehler((&E_ARG[0 as usize]) as u64, 0)
        }
        return cmd_aktualisieren(a2, quelle, grund)
    }
    return fehler((&E_ARG[0 as usize]) as u64, cmd)
}
