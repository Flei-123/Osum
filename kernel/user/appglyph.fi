profile kernel

import ulib
import fuiscene
import icons
import appicon

export { paint, glyph_of, color_of, register }

const MAX: usize = 32

static mut n_reg: u64 = 0
static mut r_name: [u64; 32] = [0; 32]
static mut r_glyph: [u64; 32] = [0; 32]
static mut r_rgb: [u64; 32] = [0; 32]
static mut seeded: bool = false
static mut b_one: [u8; 2] = [0 as u8; 2]

static mut P_EXPLORER: [u8; 9] = "explorer\0"
static mut P_TERMINAL: [u8; 9] = "terminal\0"
static mut P_TERM2: [u8; 6] = "term2\0"
static mut P_EDIT: [u8; 5] = "edit\0"
static mut P_EDITOR: [u8; 7] = "editor\0"
static mut P_NEDIT: [u8; 6] = "nedit\0"
static mut P_PDF: [u8; 8] = "pdfview\0"
static mut P_PAINT: [u8; 6] = "paint\0"
static mut P_TASKMGR: [u8; 8] = "taskmgr\0"
static mut P_STORAGE: [u8; 8] = "storage\0"
static mut P_DISKS: [u8; 6] = "disks\0"
static mut P_TRASH: [u8; 9] = "trashbin\0"
static mut P_SETTINGS: [u8; 9] = "settings\0"
static mut P_NETMON: [u8; 7] = "netmon\0"
static mut P_PHOTOS: [u8; 7] = "photos\0"
static mut P_IMGVIEW: [u8; 8] = "imgview\0"
static mut P_STORE: [u8; 6] = "store\0"
static mut P_FIREFOX: [u8; 8] = "firefox\0"
static mut P_CERTUS: [u8; 7] = "certus\0"

fn register(name: u64, glyph: u64, rgb: u64) {
    if n_reg >= MAX as u64 {
        return
    }
    r_name[n_reg as usize] = name
    r_glyph[n_reg as usize] = glyph
    r_rgb[n_reg as usize] = rgb
    n_reg = n_reg + 1
}

fn seed() {
    if seeded {
        return
    }
    seeded = true
    register((&P_EXPLORER[0 as usize]) as u64, icons.FILE_FOLDER, 0xE8A92A)
    register((&P_TERMINAL[0 as usize]) as u64, icons.FILE_PROGRAM, 0x2A2A2A)
    register((&P_TERM2[0 as usize]) as u64, icons.FILE_PROGRAM, 0x2A2A2A)
    register((&P_EDIT[0 as usize]) as u64, icons.CMD_RENAME, 0x1F86D8)
    register((&P_EDITOR[0 as usize]) as u64, icons.CMD_RENAME, 0x1F86D8)
    register((&P_NEDIT[0 as usize]) as u64, icons.CMD_NEW_FILE, 0x7348B2)
    register((&P_PDF[0 as usize]) as u64, icons.FILE_TEXT, 0xDB4437)
    register((&P_PAINT[0 as usize]) as u64, icons.FILE_IMAGE, 0xE56E3C)
    register((&P_TASKMGR[0 as usize]) as u64, icons.PAGE_ACTIVITY, 0x1E9A42)
    register((&P_STORAGE[0 as usize]) as u64, icons.FILE_DRIVE, 0x229BA3)
    register((&P_DISKS[0 as usize]) as u64, icons.FILE_DRIVE, 0x229BA3)
    register((&P_TRASH[0 as usize]) as u64, icons.TRASH, 0x7C8793)
    register((&P_SETTINGS[0 as usize]) as u64, icons.SETTINGS, 0x5B6B7F)
    register((&P_NETMON[0 as usize]) as u64, icons.PAGE_WIFI, 0x2D7FD3)
    register((&P_PHOTOS[0 as usize]) as u64, icons.FILE_IMAGE, 0xC239B3)
    register((&P_IMGVIEW[0 as usize]) as u64, icons.FILE_IMAGE, 0xC239B3)
    register((&P_STORE[0 as usize]) as u64, icons.START, 0x0F6CBD)
    register((&P_FIREFOX[0 as usize]) as u64, icons.SEARCH, 0xEF5B3A)
    register((&P_CERTUS[0 as usize]) as u64, icons.SEARCH, 0x5D7CF6)
}

fn find(name: u64) -> u64 {
    seed()
    var k: u64 = 0
    while k < n_reg {
        if ulib.streq(r_name[k as usize], name) {
            return k
        }
        k = k + 1
    }
    return n_reg
}

fn glyph_of(name: u64) -> u64 {
    let k: u64 = find(name)
    if k < n_reg {
        return r_glyph[k as usize]
    }
    return 0
}

fn color_of(name: u64) -> u64 {
    let k: u64 = find(name)
    if k < n_reg {
        return r_rgb[k as usize]
    }
    return appicon.color_of(name)
}

fn paint(name: u64, x: u64, y: u64, size: u64) {
    let rgb: u64 = color_of(name)
    let r: u64 = size * 12 / 40
    fuiscene.cv_round_rgb(x, y, size, size, r, rgb)
    let g: u64 = glyph_of(name)
    if g != 0 {
        let gs: u64 = size * 11 / 20
        fuiscene.cv_glyph(g, x + (size - gs) / 2, y + (size - gs) / 2, gs, 0xFFFFFF)
        return
    }
    var c: u64 = (*(name as *mut u8)) as u64
    if c >= 97 && c <= 122 {
        c = c - 32
    }
    b_one[0 as usize] = c as u8
    b_one[1 as usize] = 0 as u8
    let px: u64 = size / 2
    let one: u64 = (&b_one[0 as usize]) as u64
    let tw: u64 = fuiscene.text_width(one, px)
    fuiscene.cv_text_rgb(x + (size - tw) / 2, y + size / 2 + px / 3, size, one, px, true, 0xFFFFFF)
}
