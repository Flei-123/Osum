profile kernel

import ulib
import handler

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_usage: [u8; 21] = "usage: open <target>\0"
    var s_none: [u8; 22] = "open: no handler for \0"
    var s_fail: [u8; 13] = "open: failed\0"
    if ulib.arg_count(args) < 2 {
        ulib.say((&s_usage[0 as usize]) as u64)
        ulib.nl()
        return 2
    }
    let target: u64 = ulib.arg_at(args, 1)
    let pid: u64 = handler.open_target(target)
    if pid == handler.NO_HANDLER {
        ulib.say((&s_none[0 as usize]) as u64)
        ulib.say(target)
        ulib.nl()
        return 3
    }
    if ulib.bad(pid) {
        ulib.say((&s_fail[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
