// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/notifc.fi -- THE NOTIFICATION CENTRE (the bell of the bar opens it).
//
// The kernel bus keeps the last 16 notifications (`wlibc.noti_*`); the bar shows the
// unread count on the bell and a toast for each new one. This card lists them (newest
// first, at most NC_MAXR rows) and has a "Clear all" button. It is window 5 of the bar's
// scene host (after the quick settings, tooltip, toast and task view), created hidden
// and resized to the real list when it opens, like `taskview.fi`.
//
// "Clear" does not delete anything in the kernel (the ring has no such call): it marks
// every entry as read (`noti_take` sets the seen flag, so the bell goes away) and
// remembers `noti_total()` as a base line; only entries posted after that are listed.
//
//   init()           once, after the scene host knows the bar's own window
//   anchor(...)      the work area of the bar (where the card goes)
//   toggle()         the click on the bell
//   step()           once per turn of the bar's loop; true when something changed
//   is_open(), hit()
//
// Each row may carry a second button: Eject (a stick that was plugged in) or View report
// (a crash). A click on the toast runs the same action as the row's main button.
// Serial lines (read by tools/features/run.sh):
//   notifc: eject row=<i> path=<p> rc=<n>
//   notifc: toast act path=<p>
//   notifc: open n=<rows> x= y= w= h=
//   notifc: row <i> prio=<p> text=<text>
//   notifc: clear n=<entries marked read>
//   notifc: shut <why>

profile kernel

import ulib
import wlibc
import wlib
import notetext
import msg
import fuiscene

export { init, anchor, toggle, step, is_open, hit, shown, set_bell, act_newest }

const NC_MAXR: u64 = 8
const ROW_BYTES: u64 = 96
const KEY_CLEAR: u64 = 300
const KEY_ROW: u64 = 310
const ARG_BYTES: u64 = 24
const ACT_NONE: u64 = 0
const ACT_FOLDER: u64 = 1
const SEC_NONE: u64 = 0
const SEC_EJECT: u64 = 1
const SEC_REPORT: u64 = 2
const KEY_SEC: u64 = 330
const SEC_W: u64 = 96
const RC_BUSY: u64 = 16
const CARD_W: u64 = 400 // design points
const ROW_H: u64 = 28
const HEAD_H: u64 = 24
const BTN_H: u64 = 32
const GAPP: u64 = 4
const PADP: u64 = 10
const MARGIN: u64 = 12

static mut nc_win: u64 = 0xFFFFFFFFFFFFFFFF
static mut nc_h: u64 = 0
static mut nc_id: u64 = 0
static mut open_: u64 = 0
static mut n_rows: u64 = 0
static mut base_: u64 = 0 // noti_total() at the last "Clear all"
static mut seen_total: u64 = 0 // noti_total() when the list was last built
static mut row_txt: [u8; 768] = [0 as u8; 768] // NC_MAXR x ROW_BYTES
static mut row_pri: [u64; 8] = [0 as u64; 8]
static mut row_cnt: [u64; 8] = [0 as u64; 8]
static mut row_act: [u64; 8] = [0 as u64; 8]
static mut row_sec: [u64; 8] = [0 as u64; 8]
static mut row_arg: [u8; 192] = [0 as u8; 192]
static mut toast_arg: [u8; 24] = [0 as u8; 24]
static mut raw_buf: [u8; 96] = [0 as u8; 96]
static mut hum_buf: [u8; 96] = [0 as u8; 96]
static mut p_explorer: [u8; 14] = "/bin/explorer\0"
static mut p_crashdir: [u8; 11] = "/var/crash\0"
static mut s_act: [u8; 17] = "notifc: act row=\0"
static mut s_actp: [u8; 7] = " path=\0"
static mut s_grp: [u8; 4] = " (x\0"
static mut s_ej: [u8; 19] = "notifc: eject row=\0"
static mut s_rc: [u8; 5] = " rc=\0"
static mut s_toast: [u8; 19] = "notifc: toast act \0"
static mut k_sec_eject: [u8; 16] = "notif.act.eject\0"
static mut k_sec_report: [u8; 17] = "notif.act.report\0"
static mut k_eject_busy: [u8; 16] = "note.eject.busy\0"
static mut k_eject_fail: [u8; 16] = "note.eject.fail\0"
static mut px_: u64 = 0
static mut py_: u64 = 0
// the bell's rectangle on the bar (a press on it is the toggle's business, never an "outside" press)
static mut bell_x: u64 = 0
static mut bell_y: u64 = 0
static mut bell_w: u64 = 0
static mut bell_h: u64 = 0
static mut a_edge: u64 = 0
static mut a_x: u64 = 0
static mut a_y: u64 = 0
static mut a_w: u64 = 0
static mut a_h: u64 = 0
static mut btn_last: u64 = 0
static mut key_last: u64 = 0

static mut t_title: [u8; 14] = "Notifications\0"
static mut t_none: [u8; 17] = "No notifications\0"
static mut t_clear: [u8; 10] = "Clear all\0"
static mut s_open: [u8; 16] = "notifc: open n=\0"
static mut s_xy: [u8; 4] = " x=\0"
static mut s_yy: [u8; 4] = " y=\0"
static mut s_ww: [u8; 4] = " w=\0"
static mut s_hh: [u8; 4] = " h=\0"
static mut s_row: [u8; 13] = "notifc: row \0"
static mut s_pr: [u8; 7] = " prio=\0"
static mut s_tx: [u8; 7] = " text=\0"
static mut s_clr: [u8; 17] = "notifc: clear n=\0"
static mut s_shut: [u8; 14] = "notifc: shut \0"
static mut s_esc: [u8; 4] = "esc\0"
static mut s_out: [u8; 8] = "outside\0"
static mut s_bell: [u8; 5] = "bell\0"

fn sk() -> u64 {
    return wlibc.ui_scale()
}

fn say(p: u64) {
    let _s: u64 = ulib.say(p)
}

fn sayn(v: u64) {
    ulib.sayn(v)
}

fn nl() {
    ulib.nl()
}

// the card in design points
fn card_h() -> u64 {
    var rows: u64 = n_rows
    if rows == 0 {
        rows = 1
    }
    var h: u64 = PADP + HEAD_H + GAPP + rows * (ROW_H + GAPP) + PADP
    if n_rows != 0 {
        h = h + BTN_H + GAPP
    }
    return h
}

fn sec_label(kind: u64) -> u64 {
    if kind == SEC_EJECT {
        return msg.get((&k_sec_eject[0 as usize]) as u64)
    }
    return msg.get((&k_sec_report[0 as usize]) as u64)
}

fn build() {
    let r: usize = fuiscene.root()
    fuiscene.set_gap(r, GAPP)
    let hd: usize = fuiscene.label(r, (&t_title[0 as usize]) as u64)
    fuiscene.set_size(hd, CARD_W - 2 * PADP, HEAD_H)
    if n_rows == 0 {
        let nn: usize = fuiscene.label_muted(r, (&t_none[0 as usize]) as u64)
        fuiscene.set_size(nn, CARD_W - 2 * PADP, ROW_H)
        return
    }
    var i: u64 = 0
    while i < n_rows {
        var host: usize = r
        var main_w: u64 = CARD_W - 2 * PADP
        if row_sec[i as usize] != SEC_NONE {
            host = fuiscene.row(r)
            fuiscene.set_gap(host, GAPP)
            fuiscene.set_size(host, CARD_W - 2 * PADP, ROW_H)
            main_w = main_w - SEC_W - GAPP
        }
        if row_act[i as usize] != ACT_NONE {
            let rb: usize = fuiscene.button(host, (&row_txt[0 as usize]) as u64 + i * ROW_BYTES, KEY_ROW + i)
            fuiscene.set_size(rb, main_w, ROW_H)
        } else {
            let l: usize = fuiscene.label(host, (&row_txt[0 as usize]) as u64 + i * ROW_BYTES)
            fuiscene.set_size(l, main_w, ROW_H)
        }
        if row_sec[i as usize] != SEC_NONE {
            let sb: usize = fuiscene.button(host, sec_label(row_sec[i as usize]), KEY_SEC + i)
            fuiscene.set_size(sb, SEC_W, ROW_H)
        }
        i = i + 1
    }
    let b: usize = fuiscene.button(r, (&t_clear[0 as usize]) as u64, KEY_CLEAR)
    fuiscene.set_size(b, CARD_W - 2 * PADP, BTN_H)
}

// How many entries are listed: the ring holds at most 16, and only those posted since
// the last "Clear all" count.
fn visible() -> u64 {
    var n: u64 = wlibc.noti_count()
    let tot: u64 = wlibc.noti_total()
    var since: u64 = 0
    if tot > base_ {
        since = tot - base_
    }
    if since < n {
        n = since
    }
    return n
}

fn rd8(p: u64, i: u64) -> u64 {
    return __mmio_read8((p + i) as *mut u8) as u64
}

fn is_media(raw: u64, n: u64) -> bool {
    return n > 5 && rd8(raw, 0) == 117 && rd8(raw, 1) == 115 && rd8(raw, 2) == 98 && rd8(raw, 4) == 32
}

fn is_crash(raw: u64, n: u64) -> bool {
    return n > 6 && rd8(raw, 0) == 99 && rd8(raw, 1) == 114 && rd8(raw, 5) == 32
}

fn classify(raw: u64, n: u64, dst: u64) -> u64 {
    if is_media(raw, n) {
        var k: u64 = 0
        var more: bool = true
        while more && k + 5 < n && k + 1 < ARG_BYTES {
            let c: u64 = rd8(raw, 5 + k)
            if c == 32 || c == 0 {
                more = false
            } else {
                __mmio_write8((dst + k) as *mut u8, c as u8)
                k = k + 1
            }
        }
        __mmio_write8((dst + k) as *mut u8, 0 as u8)
        if k > 0 && rd8(raw, 3) != 45 {
            return ACT_FOLDER
        }
        return ACT_NONE
    }
    if is_crash(raw, n) {
        var k: u64 = 0
        while k < 10 {
            __mmio_write8((dst + k) as *mut u8, rd8((&p_crashdir[0 as usize]) as u64, k) as u8)
            k = k + 1
        }
        __mmio_write8((dst + 10) as *mut u8, 0 as u8)
        return ACT_FOLDER
    }
    return ACT_NONE
}

fn secondary(raw: u64, n: u64, act: u64) -> u64 {
    if act != ACT_FOLDER {
        return SEC_NONE
    }
    if is_media(raw, n) && rd8(raw, 3) == 43 {
        return SEC_EJECT
    }
    if is_crash(raw, n) {
        return SEC_REPORT
    }
    return SEC_NONE
}

fn same_text(a: u64, b: u64) -> bool {
    var k: u64 = 0
    while k < ROW_BYTES - 2 {
        let ca: u64 = __mmio_read8((a + k) as *mut u8) as u64
        if ca != __mmio_read8((b + k) as *mut u8) as u64 {
            return false
        }
        if ca == 0 {
            return true
        }
        k = k + 1
    }
    return true
}

fn append_count(p: u64, cnt: u64) {
    var n: u64 = 0
    while n < ROW_BYTES - 12 && __mmio_read8((p + n) as *mut u8) as u64 != 0 {
        n = n + 1
    }
    var k: u64 = 0
    while k < 3 {
        __mmio_write8((p + n + k) as *mut u8, __mmio_read8(((&s_grp[0 as usize]) as u64 + k) as *mut u8))
        k = k + 1
    }
    n = n + 3
    var div: u64 = 100
    while div > 1 && cnt / div == 0 {
        div = div / 10
    }
    while div > 0 {
        __mmio_write8((p + n) as *mut u8, (48 + (cnt / div) % 10) as u8)
        n = n + 1
        div = div / 10
    }
    __mmio_write8((p + n) as *mut u8, 41 as u8)
    __mmio_write8((p + n + 1) as *mut u8, 0 as u8)
}

// Read the newest entries WITHOUT marking them read (`noti_peek`): looking at the list
// is not the same as having dealt with it, the bell keeps its count until "Clear all".
// Neighbouring entries that read the same are one row with a count.
fn read_rows() {
    let raw_n: u64 = visible()
    seen_total = wlibc.noti_total()
    n_rows = 0
    var i: u64 = 0
    while i < raw_n {
        let raw: u64 = (&raw_buf[0 as usize]) as u64
        var n: u64 = wlibc.noti_peek(i, raw, ROW_BYTES - 4)
        if n > ROW_BYTES - 4 {
            n = ROW_BYTES - 4
        }
        __mmio_write8((raw + n) as *mut u8, 0 as u8)
        let pr: u64 = wlibc.noti_prio(i)
        let slot: u64 = n_rows
        let hum: u64 = (&hum_buf[0 as usize]) as u64
        var k: u64 = 0
        while k <= n {
            __mmio_write8((hum + k) as *mut u8, __mmio_read8((raw + k) as *mut u8))
            k = k + 1
        }
        let _hn: u64 = notetext.humanize(hum, n, ROW_BYTES - 4)
        if n_rows > 0 && same_text(hum, (&row_txt[0 as usize]) as u64 + (n_rows - 1) * ROW_BYTES + 2)
            && row_pri[(n_rows - 1) as usize] == pr {
            row_cnt[(n_rows - 1) as usize] = row_cnt[(n_rows - 1) as usize] + 1
        } else if n_rows < NC_MAXR {
            let p: u64 = (&row_txt[0 as usize]) as u64 + slot * ROW_BYTES
            k = 0
            while k < ROW_BYTES - 2 {
                let c: u64 = __mmio_read8((hum + k) as *mut u8) as u64
                __mmio_write8((p + 2 + k) as *mut u8, c as u8)
                if c == 0 {
                    k = ROW_BYTES
                } else {
                    k = k + 1
                }
            }
            row_pri[slot as usize] = pr
            row_cnt[slot as usize] = 1
            if pr >= 2 {
                __mmio_write8(p as *mut u8, 33 as u8)
            } else {
                __mmio_write8(p as *mut u8, 45 as u8)
            }
            __mmio_write8((p + 1) as *mut u8, 32 as u8)
            let act: u64 = classify(raw, n, (&row_arg[0 as usize]) as u64 + slot * ARG_BYTES)
            row_act[slot as usize] = act
            row_sec[slot as usize] = secondary(raw, n, act)
            n_rows = n_rows + 1
        }
        i = i + 1
    }
    var r: u64 = 0
    while r < n_rows {
        if row_cnt[r as usize] > 1 {
            append_count((&row_txt[0 as usize]) as u64 + r * ROW_BYTES + 2, row_cnt[r as usize])
        }
        r = r + 1
    }
}

fn spawn_explorer(path: u64) {
    var av: [u64; 2] = [0 as u64; 2]
    av[0 as usize] = (&p_explorer[0 as usize]) as u64
    av[1 as usize] = path
    let _pid: u64 = ulib.spawn_app((&p_explorer[0 as usize]) as u64, (&av[0 as usize]) as u64, 2)
}

fn act_row(i: u64) {
    if i >= n_rows || row_act[i as usize] != ACT_FOLDER {
        return
    }
    let path: u64 = (&row_arg[0 as usize]) as u64 + i * ARG_BYTES
    say((&s_act[0 as usize]) as u64)
    sayn(i)
    say((&s_actp[0 as usize]) as u64)
    say(path)
    nl()
    spawn_explorer(path)
}

fn act_newest() -> bool {
    let raw: u64 = (&raw_buf[0 as usize]) as u64
    var n: u64 = wlibc.noti_peek(0, raw, ROW_BYTES - 4)
    if n > ROW_BYTES - 4 {
        n = ROW_BYTES - 4
    }
    __mmio_write8((raw + n) as *mut u8, 0 as u8)
    let path: u64 = (&toast_arg[0 as usize]) as u64
    if n == 0 || classify(raw, n, path) != ACT_FOLDER {
        return false
    }
    say((&s_toast[0 as usize]) as u64)
    say((&s_actp[0 as usize]) as u64 + 1)
    say(path)
    nl()
    spawn_explorer(path)
    return true
}

fn carrier_of(path: u64) -> u64 {
    var i: u64 = 0
    while i < ulib.WX_MAX {
        var pf: [u8; 24] = [0 as u8; 24]
        var n: u64 = 0
        while n < 23 {
            let c: u64 = ulib.sys(ulib.SYS_WECHSEL, ulib.WX_PATHCH, i, n)
            pf[n as usize] = c as u8
            if c == 0 {
                n = 23
            } else {
                n = n + 1
            }
        }
        pf[23] = 0 as u8
        if ulib.streq((&pf[0 as usize]) as u64, path) {
            return i
        }
        i = i + 1
    }
    return ulib.WX_MAX
}

fn eject_row(i: u64) {
    if i >= n_rows || row_sec[i as usize] != SEC_EJECT {
        return
    }
    let path: u64 = (&row_arg[0 as usize]) as u64 + i * ARG_BYTES
    let tr: u64 = carrier_of(path)
    var rc: u64 = 0xFFFF
    if tr < ulib.WX_MAX {
        rc = ulib.sys(ulib.SYS_WECHSEL, ulib.WX_EJECT, tr, 0)
    }
    say((&s_ej[0 as usize]) as u64)
    sayn(i)
    say((&s_actp[0 as usize]) as u64)
    say(path)
    say((&s_rc[0 as usize]) as u64)
    sayn(rc)
    nl()
    if rc == 0 {
        return
    }
    var key: u64 = (&k_eject_fail[0 as usize]) as u64
    if rc == RC_BUSY {
        key = (&k_eject_busy[0 as usize]) as u64
    }
    let t: u64 = msg.get(key)
    let _r: u64 = ulib.noti_post(2, t, ulib.length(t))
}

fn init() -> bool {
    nc_win = fuiscene.win_open_plain(0, 0, CARD_W * sk(), (PADP * 2 + HEAD_H + GAPP
        + NC_MAXR * (ROW_H + GAPP) + BTN_H + GAPP) * sk(), (&t_title[0 as usize]) as u64,
        wlibc.L_MENU, build)
    if nc_win == fuiscene.BADWIN {
        nc_win = 0xFFFFFFFFFFFFFFFF
        return false
    }
    let _s: bool = fuiscene.win_select(nc_win)
    fuiscene.keys_always(true)
    nc_h = fuiscene.handle()
    let _v: u64 = wlibc.win_state(nc_h, wlibc.WS_HIDDEN, 1)
    let _u: bool = fuiscene.win_select(0)
    nc_id = wlibc.sys3w(wlibc.WM_INFO, nc_h, wlibc.WI_ID, 0)
    return true
}

// The work area of the bar: the card goes in the corner of it, on the side of the bar.
fn anchor(edge: u64, wx: u64, wy: u64, ww: u64, wh: u64) {
    a_edge = edge
    a_x = wx
    a_y = wy
    a_w = ww
    a_h = wh
}

fn set_bell(x: u64, y: u64, w: u64, h: u64) {
    bell_x = x
    bell_y = y
    bell_w = w
    bell_h = h
}

fn on_bell(x: u64, y: u64) -> bool {
    return bell_w != 0 && x >= bell_x && x < bell_x + bell_w && y >= bell_y
        && y < bell_y + bell_h
}

fn is_open() -> bool {
    return open_ != 0
}

// How many rows the card shows right now (0 while it is shut).
fn shown() -> u64 {
    if open_ == 0 {
        return 0
    }
    return n_rows
}

fn hit(x: u64, y: u64) -> bool {
    if open_ == 0 {
        return false
    }
    return x >= px_ && x < px_ + CARD_W * sk() && y >= py_
        && y < py_ + card_h() * sk()
}

fn paint_now() {
    var n: u64 = 0
    while n < 3 {
        let _k: u64 = fuiscene.pump_aux(nc_win)
        n = n + 1
    }
}

fn place() {
    let w: u64 = CARD_W * sk()
    let h: u64 = card_h() * sk()
    let mg: u64 = MARGIN * sk()
    var x: u64 = a_x
    var y: u64 = a_y
    if a_w > w + 2 * mg {
        x = a_x + a_w - w - mg
    }
    if a_h > h + 2 * mg {
        y = a_y + a_h - h - mg
    }
    if a_edge == wlibc.WE_TOP {
        y = a_y + mg
    }
    if a_edge == wlibc.WE_LEFT {
        x = a_x + mg
    }
    px_ = x
    py_ = y
}

// rebuild the tree from the rows and paint it (open, clear, a new notification)
fn reload() {
    read_rows()
    let w: u64 = CARD_W * sk()
    let h: u64 = card_h() * sk()
    place()
    let _s: bool = fuiscene.win_select(nc_win)
    let _z: bool = fuiscene.win_size(w, h)
    fuiscene.refresh()
    fuiscene.touch()
    key_last = fuiscene.key_seq()
    let _u: bool = fuiscene.win_select(0)
    // always move: open_now() builds the card BEFORE it shows it, and a card that was
    // never moved stays where win_open_plain put it (not in the picture)
    let _m: u64 = wlibc.sys3w(wlibc.WM_MOVE, nc_h, (px_ << 16) | py_, 0)
    paint_now()
}

fn report_rows() {
    say((&s_open[0 as usize]) as u64)
    sayn(n_rows)
    say((&s_xy[0 as usize]) as u64)
    sayn(px_)
    say((&s_yy[0 as usize]) as u64)
    sayn(py_)
    say((&s_ww[0 as usize]) as u64)
    sayn(CARD_W * sk())
    say((&s_hh[0 as usize]) as u64)
    sayn(card_h() * sk())
    nl()
    var i: u64 = 0
    while i < n_rows {
        say((&s_row[0 as usize]) as u64)
        sayn(i)
        say((&s_pr[0 as usize]) as u64)
        sayn(row_pri[i as usize])
        say((&s_tx[0 as usize]) as u64)
        say((&row_txt[0 as usize]) as u64 + i * ROW_BYTES + 2)
        nl()
        i = i + 1
    }
}

fn open_now() {
    if open_ != 0 || nc_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    reload()
    let _v: u64 = wlibc.win_state(nc_h, wlibc.WS_HIDDEN, 0)
    open_ = 1
    btn_last = wlibc.mouse_btn() & 1
    let _a: u64 = wlibc.win_act(nc_id, wlibc.WA_RAISE)
    let _k: u64 = wlibc.win_state(nc_h, wlibc.WS_KEYS, 1)
    report_rows()
}

fn shut(why: u64) {
    if open_ == 0 {
        return
    }
    open_ = 0
    let _v: u64 = wlibc.win_state(nc_h, wlibc.WS_HIDDEN, 1)
    say((&s_shut[0 as usize]) as u64)
    say(why)
    nl()
}

fn toggle() {
    if open_ != 0 {
        shut((&s_bell[0 as usize]) as u64)
    } else {
        open_now()
    }
}

// Mark everything read (the bell goes away) and start the list afresh.
fn clear_all() {
    var buf: [u8; 8] = [0 as u8; 8]
    let cnt: u64 = wlibc.noti_count()
    var i: u64 = 0
    while i < cnt {
        let _n: u64 = wlibc.noti_take(i, (&buf[0 as usize]) as u64, 1)
        i = i + 1
    }
    base_ = wlibc.noti_total()
    say((&s_clr[0 as usize]) as u64)
    sayn(cnt)
    nl()
    reload()
    report_rows()
}

fn step() -> bool {
    if open_ == 0 {
        return false
    }
    // the events of the window ring go to the canvas of the tree
    let _st: u64 = wlib.step()
    let key: u64 = fuiscene.pump_aux(nc_win)
    if key == KEY_CLEAR {
        clear_all()
        return true
    }
    if key >= KEY_ROW && key < KEY_ROW + NC_MAXR {
        act_row(key - KEY_ROW)
        shut((&s_bell[0 as usize]) as u64)
        return true
    }
    if key >= KEY_SEC && key < KEY_SEC + NC_MAXR {
        let i: u64 = key - KEY_SEC
        if i < n_rows && row_sec[i as usize] == SEC_EJECT {
            eject_row(i)
        } else {
            act_row(i)
            shut((&s_bell[0 as usize]) as u64)
        }
        return true
    }
    if open_ == 0 {
        return true
    }
    let _s: bool = fuiscene.win_select(nc_win)
    let lk: u64 = fuiscene.last_key()
    let ks: u64 = fuiscene.key_seq()
    let _u: bool = fuiscene.win_select(0)
    if ks != key_last {
        key_last = ks
        if lk == 27 {
            shut((&s_esc[0 as usize]) as u64)
            return true
        }
        // Enter clears the list as well (the button may not hold the focus when the card opens)
        if lk == 13 && n_rows != 0 {
            clear_all()
            return true
        }
    }
    // a press outside the card closes it (polled from the pointer: a press outside a
    // window raises no event belonging to it)
    let btn: u64 = wlibc.mouse_btn() & 1
    if btn != 0 && btn_last == 0 {
        if !hit(wlibc.mouse_x(), wlibc.mouse_y())
            && !on_bell(wlibc.mouse_x(), wlibc.mouse_y()) {
            shut((&s_out[0 as usize]) as u64)
            btn_last = btn
            return true
        }
    }
    btn_last = btn
    // a notification arrived while the card stands: the list grows
    if wlibc.noti_total() != seen_total {
        reload()
        report_rows()
        return true
    }
    return false
}
