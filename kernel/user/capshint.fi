profile app

import ulib
import msg
import fuiapp
import signin

export { poll, bits, caps_on, num_on, paint, BIT_CAPS, BIT_NUM, BIT_SCROLL }

const BIT_CAPS: u64 = 1
const BIT_NUM: u64 = 2
const BIT_SCROLL: u64 = 4
const RAW_MAX: u64 = 64
const MIN_LEN: u64 = 21
const OFF_CAPS: u64 = 5
const OFF_NUM: u64 = 11
const OFF_SCROLL: u64 = 20
const DIGIT_ONE: u64 = 49

static mut s_path: [u8; 16] = "/proc/kbdlocks\0\0"
static mut s_key_caps: [u8; 12] = "kbd.caps.on\0"
static mut s_raw: [u8; 64] = [0 as u8; 64]
static mut s_bits: u64 = 0
static mut s_next: u64 = 0
static mut s_valid: bool = false

fn read_raw() -> u64 {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&s_path[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return 0
    }
    let got: u64 = ulib.sys(ulib.SYS_READ, fd, (&s_raw[0 as usize]) as u64, RAW_MAX - 1)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(got) {
        return 0
    }
    return got
}

fn digit_set(offset: u64, bit: u64) -> u64 {
    if s_raw[offset as usize] as u64 == DIGIT_ONE {
        return bit
    }
    return 0
}

fn poll(gap_ms: u64) -> bool {
    let now: u64 = fuiapp.now_ms()
    if now < s_next {
        return false
    }
    s_next = now + gap_ms
    if read_raw() < MIN_LEN {
        return false
    }
    let fresh: u64 = digit_set(OFF_CAPS, BIT_CAPS) | digit_set(OFF_NUM, BIT_NUM) | digit_set(OFF_SCROLL, BIT_SCROLL)
    if s_valid && fresh == s_bits {
        return false
    }
    s_valid = true
    s_bits = fresh
    return true
}

fn bits() -> u64 {
    return s_bits
}

fn caps_on() -> bool {
    return (s_bits & BIT_CAPS) != 0
}

fn num_on() -> bool {
    return (s_bits & BIT_NUM) != 0
}

fn paint(x: u64, y: u64, w: u64, h: u64) {
    if !caps_on() {
        return
    }
    signin.paint_hint(x, y, w, h, msg.get((&s_key_caps[0 as usize]) as u64))
}
