// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import ulib
import tools
import dbgio

export { u_start }

static mut BUF: [u8; 1024] = [0 as u8; 1024]

fn dump(window: u64, off: u64, count: u64) -> u64 {
    var s_name: [u8; 8] = "regdump\0"
    let r: u64 = dbgio.call(dbgio.OP_MMIOREAD, window, off, (&BUF[0 as usize]) as u64, count)
    if ulib.bad(r) {
        dbgio.put_error((&s_name[0 as usize]) as u64, r)
        return 1
    }
    dbgio.put_dwords(window >> 16, off, (&BUF[0 as usize]) as u64, r)
    tools.ob_flush()
    return 0
}

fn write_value(window: u64, off: u64, value: u64) -> u64 {
    var s_name: [u8; 8] = "regdump\0"
    var s_ok: [u8; 9] = "written\0\0"
    let r: u64 = dbgio.call(dbgio.OP_MMIOWRITE, window, off, value, dbgio.WRITE_MAGIC)
    if ulib.bad(r) {
        dbgio.put_error((&s_name[0 as usize]) as u64, r)
        return 1
    }
    tools.ob_str((&s_ok[0 as usize]) as u64)
    tools.ob_nl()
    tools.ob_flush()
    return 0
}

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 93] = "usage: regdump <bb:dd.f> <bar> <off> [count] | regdump --write <bb:dd.f> <bar> <off> <value>\0"
    var f_write: [u8; 8] = "--write\0"
    let a0: u64 = dbgio.positional(args, 0)
    let a1: u64 = dbgio.positional(args, 1)
    let a2: u64 = dbgio.positional(args, 2)
    if a0 == 0 || a1 == 0 || a2 == 0 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 2
    }
    let bdf: u64 = dbgio.parse_bdf(a0)
    let bar: u64 = ulib.to_num(a1)
    let off: u64 = dbgio.parse_hex(a2)
    if bdf == dbgio.BAD || off == dbgio.BAD || bar > 5 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 2
    }
    let window: u64 = bdf | (bar << 16)
    let a3: u64 = dbgio.positional(args, 3)
    if dbgio.has_flag(args, (&f_write[0 as usize]) as u64) {
        if a3 == 0 {
            ulib.esay_line((&s_use[0 as usize]) as u64, 0)
            return 2
        }
        let value: u64 = dbgio.parse_hex(a3)
        if value == dbgio.BAD {
            ulib.esay_line((&s_use[0 as usize]) as u64, 0)
            return 2
        }
        return write_value(window, off, value)
    }
    var count: u64 = 4
    if a3 != 0 {
        count = ulib.to_num(a3)
    }
    return dump(window, off, count)
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
