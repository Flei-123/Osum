// SPDX-License-Identifier: MIT
// kernel/user/wlibkey.fi -- widget library, topic module: THE KEYBOARD.
//
// Split out of wlib.fi (mechanical, no behaviour change): the key
// numbers (KEY_*), the escape-sequence decoder (`decode`) and the
// modifier of the last decoded key. wlib.fi imports this module; its
// public names (KEY_*, key_mod, key_shift, key_ctrl, set_keymod) are
// declared there again as aliases / one-line forwards, because Firn has
// no re-export and every caller says `wlib.KEY_TAB` / `wlib.key_shift()`.
//
// Pure state machine: it needs nothing from wlib.fi (so there is no
// import cycle). The escape state `s_esc` is read and cleared by
// wlib.esc_spuelen, hence exported.

profile kernel

export {
    decode, set_keymod, key_mod, key_shift, key_ctrl, s_esc, s_keymod,
    KEY_TAB, KEY_ENTER, KEY_BS, KEY_ESC,
    KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT,
    KEY_HOME, KEY_END, KEY_PGUP, KEY_PGDN,
    KEY_DEL, KEY_SDEL, KEY_BTAB, KEY_F1,
    KEY_F2, KEY_F3, KEY_F4, KEY_F5,
    KEY_F6, KEY_F7, KEY_F8, KEY_F9,
    KEY_F10, KEY_OLD_ENTER, KEY_OLD_LEFT, KEY_OLD_RIGHT,
    KEY_OLD_UP, KEY_OLD_P, KEY_CTRL_H, KEY_CTRL_N, KEY_CTRL_SHIFT_N,
    KEY_CTRL_A, KEY_CTRL_C, KEY_CTRL_F, KEY_CTRL_L,
    KEY_CTRL_T, KEY_CTRL_V, KEY_CTRL_X, KEY_CTRL_Z
}

const KEY_TAB: u64 = 9
const KEY_ENTER: u64 = 13
const KEY_BS: u64 = 8
const KEY_ESC: u64 = 27
const KEY_UP: u64 = 0x101
const KEY_DOWN: u64 = 0x102
const KEY_LEFT: u64 = 0x103
const KEY_RIGHT: u64 = 0x104
const KEY_HOME: u64 = 0x105
const KEY_END: u64 = 0x106
const KEY_PGUP: u64 = 0x107
const KEY_PGDN: u64 = 0x108
const KEY_DEL: u64 = 0x109
// ROUND ALLTAG: SHIFT+DEL IS A DIFFERENT KEY. The file manager
// moves to the trash on Del and deletes for good on Shift+Del;
// without a number of its own the two could not be told apart.
// For this the kernel sends `ESC [ 3 ; 2 ~` (kernel/kbd.fi, `arrow`).
const KEY_SDEL: u64 = 0x10A
// 24.09.2026: Shift+Tab, `ESC [ Z` from kernel/drv/hid/kbd.fi -- the focus
// goes backwards.
const KEY_BTAB: u64 = 0x10B

// ================================================== ROUND EXPLORER-2
//
// THE KEYS A FILE MANAGER NEEDS, which this system did not have
// until this round. They live here and not in the
// file manager, because a key that only ONE program knows would have to be
// reinvented for every second program.
//
// Where they come from is written in `kernel/kbd.fi`: the F keys as
// `ESC [ 11..21 ~`, Alt+Enter and the Alt arrows as
// `ESC [ n ; 3 ~`, Ctrl+H and Ctrl+N as `ESC [ 30..31 ; 5 ~`.
const KEY_F1: u64 = 0x110
const KEY_F2: u64 = 0x111
const KEY_F3: u64 = 0x112
const KEY_F4: u64 = 0x113
const KEY_F5: u64 = 0x114
const KEY_F6: u64 = 0x115
const KEY_F7: u64 = 0x116
const KEY_F8: u64 = 0x117
const KEY_F9: u64 = 0x118
const KEY_F10: u64 = 0x119
// Alt + something.
const KEY_OLD_ENTER: u64 = 0x120
const KEY_OLD_LEFT: u64 = 0x121
const KEY_OLD_RIGHT: u64 = 0x122
const KEY_OLD_UP: u64 = 0x123
const KEY_OLD_P: u64 = 0x124
// The two control shortcuts that would be ambiguous as an octet.
const KEY_CTRL_H: u64 = 0x130
const KEY_CTRL_N: u64 = 0x131
const KEY_CTRL_SHIFT_N: u64 = 0x132
// ROUND EXPLORER-2, SECOND PASS: THE REMAINING CTRL SHORTCUTS
// GET NAMES. `kernel/kbd.fi` maps Ctrl+letter to 1..26
// (the lower five bits, line ~505) -- measured on this system's
// keyboard. A program that writes `if key == 3` does not say
// that it means Ctrl+C; that is why the seven a
// file manager needs are listed here by name. Ctrl+H and Ctrl+N are missing from
// this row on purpose: they would arrive as 8 (backspace) and 14
// (arrow up) and therefore go above as a sequence of their own.
const KEY_CTRL_A: u64 = 1
const KEY_CTRL_C: u64 = 3
const KEY_CTRL_F: u64 = 6
const KEY_CTRL_L: u64 = 12
const KEY_CTRL_T: u64 = 20
const KEY_CTRL_V: u64 = 22
const KEY_CTRL_X: u64 = 24
const KEY_CTRL_Z: u64 = 26

// -------------------------------------------- decoder state

// ROUND ALLTAG: the number and the modifier of an escape sequence
// `ESC [ n ; m ~`. Before, the number lived in the state itself
// (`s_esc = 3 + digit`) and there was no more than one digit.
static mut s_num: u64 = 0
static mut s_mod: u64 = 0
// ROUND GUI-EDITOR: the modifier of the most recently decoded key.
static mut s_keymod: u64 = 0
// Escape-sequence state of `decode` (0 = idle).
static mut s_esc: u64 = 0 // state of the escape sequence

// ------------------------------------------------- the keyboard

// THE ESCAPE SEQUENCES. The line discipline of this system sends
// arrow keys as `ESC [ D` and page keys as `ESC [ 5 ~` -- the way
// a VT100 does it and the way `kernel/kbd.fi` builds it. One event
// carries ONE octet, so the state machine lives here.
//
// ONE EXCEPTION, and it is older than this round: the arrow-up
// key arrives as ONE octet 14. `kernel/kbd.fi` says why.
fn decode(c: u64) -> u64 {
    if s_esc == 0 {
        if c == 27 {
            s_esc = 1
            return 0
        }
        if c == 14 {
            return KEY_UP
        }
        // ROUND ALLTAG: THE ENTER KEY ARRIVES AS A LINE FEED.
        //
        // `KEY_ENTER` is 13, the keyboard of this system delivers 10
        // (kernel/kbd.fi, US table). So in EVERY window the
        // Enter key did nothing -- no button, no dialog, no
        // text field. Measured on a dialog that could not be closed with
        // `sendkey ret`. Here the one becomes the other,
        // at the one place that all keys
        // pass through.
        if c == 10 {
            s_keymod = 0
            return KEY_ENTER
        }
        s_keymod = 0
        return c
    }
    if s_esc == 1 {
        if c == 91 {
            s_esc = 2
            return 0
        }
        // ============================================ ROUND EXPLORER-2
        //
        // A SINGLE ESCAPE KEY MUST NOT SWALLOW THE NEXT ONE.
        //
        // This used to be only `s_esc = 0; return KEY_ESC`, and with it the
        // octet `c` was LOST. On a real terminal that is
        // rarely seen; here it is the rule, because the escape arrives
        // as a SINGLE octet (kernel/kbd.fi, scan code 1) and the
        // next special key itself starts with an escape.
        //
        // MEASURED on 09.09.2026: the acceptance script says
        // `key esc` (close a menu) and right after it
        // `key alt-ret` (properties). Both were on the wire
        // -- `key: ^[` and `key: ^[[^[` --, but only the escape reached
        // the window: the second escape was read as "no [",
        // returned a SECOND escape, and the rest of the sequence
        // (`[ 27 ; 3 ~`) ran into nothing as text. Alt+Enter was
        // thus the only key of this round that never arrived -- and
        // it was not its fault.
        //
        // If `c` is an escape itself, we start the sequence AFRESH
        // instead of discarding it: that is exactly the case "two escapes
        // in a row", and the second belongs to the next key.
        if c == 27 {
            return KEY_ESC
        }
        s_esc = 0
        return KEY_ESC
    }
    if s_esc == 2 {
        if c >= 48 && c <= 57 {
            s_num = c - 48
            s_mod = 0
            s_esc = 3
            return 0
        }
        s_esc = 0
        // WITHOUT digits in front: no modifier. `s_keymod` belongs to the
        // key that is being completed here, and must therefore be
        // cleared here and not at the next key press.
        s_keymod = 0
        return letter_key(c)
    }
    // `ESC [ n ~` and `ESC [ n ; m ~`. The modifier m is the xterm one:
    // 2 = Shift, 3 = Alt, 5 = Control, each plus one.
    if s_esc == 3 {
        if c >= 48 && c <= 57 {
            s_num = s_num * 10 + (c - 48)
            return 0
        }
        if c == 59 {
            s_esc = 4
            return 0
        }
        s_esc = 0
        if c != 126 {
            // ROUND GUI-EDITOR: `ESC [ 1 A` -- a digit and then a
            // LETTER. Up to here this fell through to `return 0`, i.e. to
            // a swallowed key.
            s_keymod = 0
            return letter_key(c)
        }
        return tilde(s_num, 0)
    }
    if c >= 48 && c <= 57 {
        s_mod = s_mod * 10 + (c - 48)
        return 0
    }
    s_esc = 0
    if c != 126 {
        // ==================================== ROUND GUI-EDITOR
        //
        // `ESC [ 1 ; 2 D` -- SHIFT + ARROW LEFT.
        //
        // This used to be `return 0`: a sequence that does not end in `~`
        // was an unknown sequence and was discarded. That is exactly
        // the long form of the arrow keys, and it is the reason
        // why this system had no selection with Shift
        // until this round.
        //
        // The modifier is NOT folded into the key number:
        // `KEY_LEFT` stays `KEY_LEFT`, so that every existing
        // program keeps recognising the key. Whoever needs the difference
        // asks `key_mod()`.
        s_keymod = s_mod
        return letter_key(c)
    }
    s_keymod = s_mod
    return tilde(s_num, s_mod)
}

// ROUND GUI-EDITOR: the six keys with a LETTER as the final byte.
// They are listed here once, instead of at the three places where an
// escape sequence can end.
fn letter_key(c: u64) -> u64 {
    if c == 65 {
        return KEY_UP
    }
    if c == 66 {
        return KEY_DOWN
    }
    if c == 67 {
        return KEY_RIGHT
    }
    if c == 68 {
        return KEY_LEFT
    }
    if c == 72 {
        return KEY_HOME
    }
    if c == 70 {
        return KEY_END
    }
    if c == 90 {
        return KEY_BTAB
    }
    return 0
}

// ==================================================== ROUND GUI-EDITOR
//
// WHICH MODIFIERS WERE HELD WITH THE LAST KEY.
//
// The number is the xterm one, unchanged from what was on the wire:
// 2 = Shift, 3 = Alt, 5 = Ctrl, 6 = Ctrl+Shift. 0 means
// "none" -- that is the normal case and the short form of the sequence.
//
// WHY NOT IN THE KEY NUMBER: `KEY_LEFT` is `KEY_LEFT` in twenty-three
// programs. A Shift+Left that had a DIFFERENT number
// would be an unknown key for each of them; this way it stays
// the same key, and only whoever asks sees the difference.
// The modifier of the NEXT key, set by a program that feeds a key itself
// (the editor's measuring runs) instead of through the key path.
fn set_keymod(m: u64) {
    s_keymod = m
}

fn key_mod() -> u64 {
    return s_keymod
}

fn key_shift() -> bool {
    return s_keymod == 2 || s_keymod == 4 || s_keymod == 6 || s_keymod == 8
}

fn key_ctrl() -> bool {
    return s_keymod >= 5
}

fn tilde(n: u64, m: u64) -> u64 {
    // ROUND EXPLORER-2: the F keys and the combinations. They come
    // BEFORE the old numbers, because they have numbers of their own and cover none
    // of the old ones -- the order here is for readability only.
    if n >= 11 && n <= 15 {
        return KEY_F1 + (n - 11)
    }
    if n >= 17 && n <= 21 {
        // The gap at 16 is xterm's, not ours: F6 is 17.
        if m == 3 {
            // `ESC [ 20..22 ; 3 ~` are the Alt arrows, and they have
            // the same numbers as F9/F10 -- the modifier separates
            // them, just as it separates Del from Shift+Del
            // for Del.
            if n == 20 {
                return KEY_OLD_LEFT
            }
            if n == 21 {
                return KEY_OLD_RIGHT
            }
        }
        return KEY_F6 + (n - 17)
    }
    if n == 22 && m == 3 {
        return KEY_OLD_UP
    }
    if n == 80 && m == 3 {
        return KEY_OLD_P
    }
    if n == 27 && m == 3 {
        return KEY_OLD_ENTER
    }
    if n == 30 && m == 5 {
        return KEY_CTRL_H
    }
    if n == 31 && m == 5 {
        return KEY_CTRL_N
    }
    if n == 31 && m == 6 {
        return KEY_CTRL_SHIFT_N
    }
    if n == 5 {
        return KEY_PGUP
    }
    if n == 6 {
        return KEY_PGDN
    }
    if n == 3 {
        if m == 2 {
            return KEY_SDEL
        }
        return KEY_DEL
    }
    if n == 1 {
        return KEY_HOME
    }
    if n == 4 {
        return KEY_END
    }
    return 0
}
