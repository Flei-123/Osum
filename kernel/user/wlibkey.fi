// SPDX-License-Identifier: MIT
// kernel/user/wlibkey.fi -- widget library, topic module: THE KEYBOARD.
//
// Split out of wlib.fi (mechanical, no behaviour change): the key
// numbers (KEY_*), the escape-sequence decoder (`decode`) and the
// modifier of the last decoded key. wlib.fi imports this module; its
// public names (KEY_*, key_mod, key_shift, key_ctrl, set_keymod) are
// declared there again as aliases / one-line forwards, because Firn has
// no re-export and every caller says `wlib.KEY_TAB` / `wlib.key_shift()`.
//
// Pure state machine: it needs nothing from wlib.fi (so there is no
// import cycle). The escape state `s_esc` is read and cleared by
// wlib.esc_spuelen, hence exported.

profile kernel

export {
    decode, set_keymod, key_mod, key_shift, key_ctrl, s_esc, s_keymod,
    KEY_TAB, KEY_ENTER, KEY_BS, KEY_ESC,
    KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT,
    KEY_HOME, KEY_END, KEY_PGUP, KEY_PGDN,
    KEY_DEL, KEY_SDEL, KEY_BTAB, KEY_F1,
    KEY_F2, KEY_F3, KEY_F4, KEY_F5,
    KEY_F6, KEY_F7, KEY_F8, KEY_F9,
    KEY_F10, KEY_OLD_ENTER, KEY_OLD_LEFT, KEY_OLD_RIGHT,
    KEY_OLD_UP, KEY_OLD_P, KEY_CTRL_H, KEY_CTRL_N,
    KEY_CTRL_A, KEY_CTRL_C, KEY_CTRL_F, KEY_CTRL_L,
    KEY_CTRL_T, KEY_CTRL_V, KEY_CTRL_X, KEY_CTRL_Z
}


const KEY_TAB: u64 = 9
const KEY_ENTER: u64 = 13
const KEY_BS: u64 = 8
const KEY_ESC: u64 = 27
const KEY_UP: u64 = 0x101
const KEY_DOWN: u64 = 0x102
const KEY_LEFT: u64 = 0x103
const KEY_RIGHT: u64 = 0x104
const KEY_HOME: u64 = 0x105
const KEY_END: u64 = 0x106
const KEY_PGUP: u64 = 0x107
const KEY_PGDN: u64 = 0x108
const KEY_DEL: u64 = 0x109
// RUNDE ALLTAG: UMSCHALT+ENTF IST EINE ANDERE TASTE. Der Dateimanager
// legt bei Entf in den Papierkorb und loescht bei Umschalt+Entf
// endgueltig; ohne eine eigene Nummer waere das nicht zu unterscheiden.
// Der Kern schickt dafuer `ESC [ 3 ; 2 ~` (kernel/kbd.fi, `arrow`).
const KEY_SDEL: u64 = 0x10A
// 24.09.2026: Shift+Tab, `ESC [ Z` from kernel/drv/hid/kbd.fi -- the focus
// goes backwards.
const KEY_BTAB: u64 = 0x10B

// ================================================== RUNDE EXPLORER-2
//
// DIE TASTEN, DIE EIN DATEIMANAGER BRAUCHT, und die dieses System bis
// zu dieser Runde nicht hatte. Sie stehen hier und nicht im
// Dateimanager, weil eine Taste, die nur EIN Programm kennt, fuer
// jedes zweite neu erfunden werden muesste.
//
// Wo sie herkommen, steht in `kernel/kbd.fi`: die F-Tasten als
// `ESC [ 11..21 ~`, Alt+Eingabe und die Alt-Pfeile als
// `ESC [ n ; 3 ~`, Strg+H und Strg+N als `ESC [ 30..31 ; 5 ~`.
const KEY_F1: u64 = 0x110
const KEY_F2: u64 = 0x111
const KEY_F3: u64 = 0x112
const KEY_F4: u64 = 0x113
const KEY_F5: u64 = 0x114
const KEY_F6: u64 = 0x115
const KEY_F7: u64 = 0x116
const KEY_F8: u64 = 0x117
const KEY_F9: u64 = 0x118
const KEY_F10: u64 = 0x119
// Alt + etwas.
const KEY_OLD_ENTER: u64 = 0x120
const KEY_OLD_LEFT: u64 = 0x121
const KEY_OLD_RIGHT: u64 = 0x122
const KEY_OLD_UP: u64 = 0x123
const KEY_OLD_P: u64 = 0x124
// Die zwei Steuerungskuerzel, die als Oktett mehrdeutig waeren.
const KEY_CTRL_H: u64 = 0x130
const KEY_CTRL_N: u64 = 0x131
// RUNDE EXPLORER-2, ZWEITER DURCHGANG: DIE UEBRIGEN STRG-KUERZEL
// HABEN NAMEN. `kernel/kbd.fi` bildet Strg+Buchstabe auf 1..26 ab
// (die unteren fuenf Bit, Zeile ~505) -- gemessen an der Tastatur
// dieses Systems. Ein Programm, das `if taste == 3` schreibt, sagt
// nicht, dass es Strg+C meint; deshalb stehen die sieben, die ein
// Dateimanager braucht, hier mit Namen. Strg+H und Strg+N fehlen in
// dieser Reihe mit Absicht: sie kaemen als 8 (Rueckschritt) und 14
// (Pfeil hoch) an und gehen deshalb oben als eigene Folge.
const KEY_CTRL_A: u64 = 1
const KEY_CTRL_C: u64 = 3
const KEY_CTRL_F: u64 = 6
const KEY_CTRL_L: u64 = 12
const KEY_CTRL_T: u64 = 20
const KEY_CTRL_V: u64 = 22
const KEY_CTRL_X: u64 = 24
const KEY_CTRL_Z: u64 = 26

// -------------------------------------------- decoder state

// RUNDE ALLTAG: die Zahl und der Modifikator einer Fluchtfolge
// `ESC [ n ; m ~`. Vorher stand die Zahl im Zustand selbst
// (`s_esc = 3 + Ziffer`) und mehr als eine Ziffer gab es nicht.
static mut s_num: u64 = 0
static mut s_mod: u64 = 0
// RUNDE GUI-EDITOR: der Modifikator der zuletzt entschluesselten Taste.
static mut s_keymod: u64 = 0
// Escape-sequence state of `decode` (0 = idle).
static mut s_esc: u64 = 0 // Zustand der Fluchtfolge

// ------------------------------------------------- die Tastatur

// DIE FLUCHTFOLGEN. Die Zeilendisziplin dieses Systems schickt
// Pfeiltasten als `ESC [ D` und Seitentasten als `ESC [ 5 ~` -- so, wie
// ein VT100 es tut und wie `kernel/kbd.fi` es aufsetzt. Ein Ereignis
// traegt EIN Oktett, also steht die Zustandsmaschine hier.
//
// EINE AUSNAHME, und sie ist aelter als diese Runde: die Pfeiltaste
// nach oben kommt als EIN Oktett 14. `kernel/kbd.fi` sagt warum.
fn decode(c: u64) -> u64 {
    if s_esc == 0 {
        if c == 27 {
            s_esc = 1
            return 0
        }
        if c == 14 {
            return KEY_UP
        }
        // RUNDE ALLTAG: DIE EINGABETASTE KOMMT ALS ZEILENVORSCHUB.
        //
        // `KEY_ENTER` ist 13, die Tastatur dieses Systems liefert 10
        // (kernel/kbd.fi, us-Tabelle). Damit hat in JEDEM Fenster die
        // Eingabetaste nichts getan -- kein Knopf, kein Dialog, kein
        // Textfeld. Gemessen an einem Dialog, der sich mit
        // `sendkey ret` nicht schliessen liess. Hier wird aus dem
        // einen das andere, an der einen Stelle, an der alle Tasten
        // vorbeikommen.
        if c == 10 {
            s_keymod = 0
            return KEY_ENTER
        }
        s_keymod = 0
        return c
    }
    if s_esc == 1 {
        if c == 91 {
            s_esc = 2
            return 0
        }
        // ============================================ RUNDE EXPLORER-2
        //
        // EINE EINZELNE FLUCHTTASTE DARF DIE NAECHSTE NICHT FRESSEN.
        //
        // Hier stand nur `s_esc = 0; return KEY_ESC`, und damit ging
        // das Oktett `c` VERLOREN. Bei einem echten Terminal ist das
        // selten zu sehen; hier ist es die Regel, denn die Flucht kommt
        // als EINZELNES Oktett (kernel/kbd.fi, Abtastcode 1) und die
        // naechste Sondertaste faengt selbst mit einer Flucht an.
        //
        // GEMESSEN am 09.09.2026: im Drehbuch der Abnahme steht
        // `taste esc` (ein Menue zumachen) und gleich danach
        // `taste alt-ret` (Eigenschaften). Auf der Leitung stand beides
        // -- `key: ^[` und `key: ^[[^[` --, im Fenster kam nur die
        // Flucht an: die zweite Flucht wurde als "kein [" gelesen,
        // gab eine ZWEITE Flucht zurueck, und der Rest der Folge
        // (`[ 27 ; 3 ~`) lief als Text ins Leere. Alt+Eingabe war
        // damit die einzige Taste dieser Runde, die nie ankam -- und
        // es lag nicht an ihr.
        //
        // Ist `c` selbst eine Flucht, fangen wir die Folge NEU an,
        // statt sie wegzuwerfen: das ist genau der Fall "zwei Fluchten
        // hintereinander", und die zweite gehoert zur naechsten Taste.
        if c == 27 {
            return KEY_ESC
        }
        s_esc = 0
        return KEY_ESC
    }
    if s_esc == 2 {
        if c >= 48 && c <= 57 {
            s_num = c - 48
            s_mod = 0
            s_esc = 3
            return 0
        }
        s_esc = 0
        // OHNE Ziffern davor: kein Modifikator. `s_keymod` gehoert zur
        // Taste, die hier gerade fertig wird, und muss deshalb hier
        // geloescht werden und nicht beim naechsten Tastendruck.
        s_keymod = 0
        return letter_key(c)
    }
    // `ESC [ n ~` und `ESC [ n ; m ~`. Der Modifikator m ist der von
    // xterm: 2 = Umschalt, 3 = Alt, 5 = Steuerung, jeweils plus eins.
    if s_esc == 3 {
        if c >= 48 && c <= 57 {
            s_num = s_num * 10 + (c - 48)
            return 0
        }
        if c == 59 {
            s_esc = 4
            return 0
        }
        s_esc = 0
        if c != 126 {
            // RUNDE GUI-EDITOR: `ESC [ 1 A` -- eine Ziffer und dann ein
            // BUCHSTABE. Bis hierher fiel das auf `return 0`, also auf
            // eine verschluckte Taste.
            s_keymod = 0
            return letter_key(c)
        }
        return tilde(s_num, 0)
    }
    if c >= 48 && c <= 57 {
        s_mod = s_mod * 10 + (c - 48)
        return 0
    }
    s_esc = 0
    if c != 126 {
        // ==================================== RUNDE GUI-EDITOR
        //
        // `ESC [ 1 ; 2 D` -- UMSCHALT + PFEIL LINKS.
        //
        // Hier stand `return 0`: eine Folge, die nicht auf `~` endet,
        // war eine unbekannte Folge und wurde weggeworfen. Genau das
        // ist die lange Form der Pfeiltasten, und sie ist der Grund,
        // warum dieses System bis zu dieser Runde keine Auswahl mit
        // Umschalt kannte.
        //
        // Der Modifikator wird NICHT in die Tastennummer gerechnet:
        // `KEY_LEFT` bleibt `KEY_LEFT`, damit jedes bestehende
        // Programm die Taste weiter erkennt. Wer den Unterschied
        // braucht, fragt `key_mod()`.
        s_keymod = s_mod
        return letter_key(c)
    }
    s_keymod = s_mod
    return tilde(s_num, s_mod)
}

// RUNDE GUI-EDITOR: die sechs Tasten mit einem BUCHSTABEN als Finale.
// Sie stehen hier einmal, statt an den drei Stellen, an denen eine
// Fluchtfolge enden kann.
fn letter_key(c: u64) -> u64 {
    if c == 65 {
        return KEY_UP
    }
    if c == 66 {
        return KEY_DOWN
    }
    if c == 67 {
        return KEY_RIGHT
    }
    if c == 68 {
        return KEY_LEFT
    }
    if c == 72 {
        return KEY_HOME
    }
    if c == 70 {
        return KEY_END
    }
    if c == 90 {
        return KEY_BTAB
    }
    return 0
}

// ==================================================== RUNDE GUI-EDITOR
//
// WELCHE MODIFIKATOREN BEI DER LETZTEN TASTE LAGEN.
//
// Die Zahl ist die von xterm, unveraendert so, wie sie auf der Leitung
// stand: 2 = Umschalt, 3 = Alt, 5 = Strg, 6 = Strg+Umschalt. 0 heisst
// "keiner" -- das ist der Normalfall und die kurze Form der Folge.
//
// WARUM NICHT IN DER TASTENNUMMER: `KEY_LEFT` ist in dreiundzwanzig
// Programmen `KEY_LEFT`. Ein Umschalt+Links, das eine ANDERE Nummer
// haette, waere fuer jedes davon eine unbekannte Taste; so bleibt es
// dieselbe Taste, und nur wer fragt, sieht den Unterschied.
// The modifier of the NEXT key, set by a program that feeds a key itself
// (the editor's measuring runs) instead of through the key path.
fn set_keymod(m: u64) {
    s_keymod = m
}

fn key_mod() -> u64 {
    return s_keymod
}

fn key_shift() -> bool {
    return s_keymod == 2 || s_keymod == 4 || s_keymod == 6 || s_keymod == 8
}

fn key_ctrl() -> bool {
    return s_keymod >= 5
}

fn tilde(n: u64, m: u64) -> u64 {
    // RUNDE EXPLORER-2: die F-Tasten und die Kombinationen. Sie stehen
    // VOR den alten Nummern, weil sie eigene Nummern haben und keine
    // der alten ueberdecken -- die Reihenfolge ist hier nur Lesbarkeit.
    if n >= 11 && n <= 15 {
        return KEY_F1 + (n - 11)
    }
    if n >= 17 && n <= 21 {
        // Die Luecke bei 16 ist xterms, nicht unsere: F6 ist 17.
        if m == 3 {
            // `ESC [ 20..22 ; 3 ~` sind die Alt-Pfeile, und die haben
            // dieselben Nummern wie F9/F10 -- der Modifikator trennt
            // sie, so wie er bei Entf zwischen Entf und Umschalt+Entf
            // trennt.
            if n == 20 {
                return KEY_OLD_LEFT
            }
            if n == 21 {
                return KEY_OLD_RIGHT
            }
        }
        return KEY_F6 + (n - 17)
    }
    if n == 22 && m == 3 {
        return KEY_OLD_UP
    }
    if n == 80 && m == 3 {
        return KEY_OLD_P
    }
    if n == 27 && m == 3 {
        return KEY_OLD_ENTER
    }
    if n == 30 && m == 5 {
        return KEY_CTRL_H
    }
    if n == 31 && m == 5 {
        return KEY_CTRL_N
    }
    if n == 5 {
        return KEY_PGUP
    }
    if n == 6 {
        return KEY_PGDN
    }
    if n == 3 {
        if m == 2 {
            return KEY_SDEL
        }
        return KEY_DEL
    }
    if n == 1 {
        return KEY_HOME
    }
    if n == 4 {
        return KEY_END
    }
    return 0
}

