
profile kernel

import ulib
import libc.kcall
import tools

export { u_start }

static mut S_1: [u8; 25] = "nothing is mounted\0\0\0\0\0\0\0"
static mut S_OLD: [u8; 31] = "/dev/hda on / type ofs (rw)\0\0\0\0"
static mut S_2: [u8; 10] = "  blocks \0"
static mut S_3: [u8; 9] = "  free \0\0"
static mut S_4: [u8; 11] = "  inodes \0\0"
static mut S_ON: [u8; 5] = " on \0"
static mut S_TYPE: [u8; 7] = " type \0"
static mut S_RW: [u8; 6] = " (rw)\0"
static mut S_RO: [u8; 6] = " (ro)\0"
static mut S_OPEN: [u8; 10] = "  opens=\0\0"
static mut S_5: [u8; 25] = "mount: cannot mount /\0\0\0\0"
static mut S_ERR: [u8; 25] = "mount: cannot mount\0\0\0\0\0\0"
static mut S_USE: [u8; 40] = "usage: mount [SOURCE TARGET TYPE [-r]]\0\0"
static mut T_OFS: [u8; 5] = "ofs\0\0"
static mut T_PROC: [u8; 5] = "proc\0"
static mut T_DEV: [u8; 6] = "devfs\0"
static mut T_FAT: [u8; 5] = "vfat\0"
static mut T_UNK: [u8; 5] = "none\0"
static mut D_RAM: [u8; 10] = "/dev/ram0\0"
static mut D_HDA: [u8; 9] = "/dev/hda\0"
static mut D_HDB: [u8; 9] = "/dev/hdb\0"
static mut D_NVME: [u8; 11] = "/dev/nvme0\0"
static mut O_R: [u8; 3] = "-r\0"

fn type_name(t: u64) -> u64 {
    if t == 1 {
        return (&T_OFS[0 as usize]) as u64
    }
    if t == 2 {
        return (&T_PROC[0 as usize]) as u64
    }
    if t == 3 {
        return (&T_DEV[0 as usize]) as u64
    }
    if t == 4 {
        return (&T_FAT[0 as usize]) as u64
    }
    return (&T_UNK[0 as usize]) as u64
}

fn dev_name(t: u64, d: u64) -> u64 {
    if t == 2 {
        return (&T_PROC[0 as usize]) as u64
    }
    if t == 3 {
        return (&T_DEV[0 as usize]) as u64
    }
    if d == 0 {
        return (&D_RAM[0 as usize]) as u64
    }
    if d == 1 {
        return (&D_HDA[0 as usize]) as u64
    }
    if d == 2 {
        return (&D_NVME[0 as usize]) as u64
    }
    if d == 3 {
        return (&D_HDB[0 as usize]) as u64
    }
    return (&T_UNK[0 as usize]) as u64
}

fn nums() {
    tools.ob_str((&S_2[0 as usize]) as u64)
    tools.ob_num(ulib.sys(ulib.SYS_SYSINFO, ulib.I_BLOCKS, 0, 0))
    tools.ob_str((&S_3[0 as usize]) as u64)
    tools.ob_num(ulib.sys(ulib.SYS_SYSINFO, ulib.I_BFREE, 0, 0))
    tools.ob_str((&S_4[0 as usize]) as u64)
    tools.ob_num(ulib.sys(ulib.SYS_SYSINFO, ulib.I_IUSED, 0, 0))
    tools.ob_nl()
}

fn show(index: u64) {
    var path: [u8; 40] = [0 as u8; 40]
    let n: u64 = ulib.sys(ulib.SYS_MNTSTAT, index, ulib.MS_PATHLEN, 0)
    var i: u64 = 0
    while i < n && i < 39 {
        path[i as usize] = ulib.sys(ulib.SYS_MNTSTAT, index,
            ulib.MS_PATHCH + i, 0) as u8
        i = i + 1
    }
    path[i as usize] = 0 as u8
    let t: u64 = ulib.sys(ulib.SYS_MNTSTAT, index, ulib.MS_TYPE, 0)
    let d: u64 = ulib.sys(ulib.SYS_MNTSTAT, index, ulib.MS_DEV, 0)
    tools.ob_str(dev_name(t, d))
    tools.ob_str((&S_ON[0 as usize]) as u64)
    tools.ob_str((&path[0 as usize]) as u64)
    tools.ob_str((&S_TYPE[0 as usize]) as u64)
    tools.ob_str(type_name(t))
    if (ulib.sys(ulib.SYS_MNTSTAT, index, ulib.MS_FLAGS, 0)
        & ulib.MNT_RDONLY) != 0 {
        tools.ob_str((&S_RO[0 as usize]) as u64)
    } else {
        tools.ob_str((&S_RW[0 as usize]) as u64)
    }
    tools.ob_str((&S_OPEN[0 as usize]) as u64)
    tools.ob_num(ulib.sys(ulib.SYS_MNTSTAT, index, ulib.MS_OPENS, 0))
    tools.ob_nl()
}

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc >= 4 {
        var flags: u64 = 0
        if argc >= 5 {
            if ulib.streq(ulib.arg_at(args, 4), (&O_R[0 as usize]) as u64) {
                flags = ulib.MNT_RDONLY
            }
        }
        let r: u64 = kcall.sys4(ulib.SYS_VMOUNT, ulib.arg_at(args, 1),
            ulib.arg_at(args, 2), ulib.arg_at(args, 3), flags)
        if ulib.bad(r) {
            ulib.esay_line((&S_ERR[0 as usize]) as u64, 0)
            return 1
        }
        return 0
    }
    if argc == 3 {
        ulib.esay_line((&S_USE[0 as usize]) as u64, 0)
        return 1
    }
    if argc == 2 {
        let r: u64 = ulib.sys(ulib.SYS_MOUNT, 1, 0, 0)
        if ulib.bad(r) {
            ulib.esay_line((&S_5[0 as usize]) as u64, 0)
            return 1
        }
        return 0
    }
    let n: u64 = ulib.sys(ulib.SYS_MNTSTAT, 0, ulib.MS_COUNT, 0)
    if ulib.bad(n) || n == 0 {
        if ulib.sys(ulib.SYS_MOUNT, 0, 0, 0) != 1 {
            tools.ob_str((&S_1[0 as usize]) as u64)
            tools.ob_nl()
            tools.ob_flush()
            return 1
        }
        tools.ob_str((&S_OLD[0 as usize]) as u64)
        tools.ob_nl()
        nums()
        tools.ob_flush()
        return 0
    }
    var i: u64 = 0
    while i < 8 {
        if ulib.sys(ulib.SYS_MNTSTAT, i, ulib.MS_USED, 0) == 1 {
            show(i)
        }
        i = i + 1
    }
    nums()
    tools.ob_flush()
    return 0
}
