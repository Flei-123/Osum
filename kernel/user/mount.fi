// kernel/user/mount.fi -- Runde K11: was eingehaengt ist.
//
// Ohne Argumente sagt es, was da ist -- in der Form, die `mount` auf
// jedem Unix schreibt, nur ohne die Erfindungen: dieses System hat EINE
// Platte und EIN Dateisystem, und die Zahlen dahinter kommen aus
// SYS_OSUM_SYSINFO, also aus dem Superblock und nicht aus der Luft.
//
// `mount /` haengt wieder ein, was `umount` ausgehaengt hat. Das ist
// keine Attrappe: ausgehaengt findet `ls /` wirklich nichts mehr.

profile kernel

import ulib
import tools

export { u_start }

// Die Zeichenketten dieses Programms liegen in `.rodata` und nicht
// auf dem Stapel: ein `var s: [u8; n] = "..."` in einer Funktion
// wird bei jedem Aufruf Oktett fuer Oktett neu gefuellt. Erzeugt
// von tools/k11/hebe.py.
static S_0: [u8; 31] = "/dev/hda on / type ofs (rw)\0\0\0\0"
static S_1: [u8; 25] = "nothing is mounted\0\0\0\0\0\0\0"
static S_2: [u8; 10] = "  blocks \0"
static S_3: [u8; 9] = "  free \0\0"
static S_4: [u8; 11] = "  inodes \0\0"
static S_5: [u8; 25] = "mount: cannot mount /\0\0\0\0"


fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc > 1 {
        let r: u64 = ulib.sys(ulib.SYS_MOUNT, 1, 0, 0)
        if ulib.bad(r) {
            ulib.esay_line((&S_5[0 as usize]) as u64, 0)
            return 1
        }
        return 0
    }
    if ulib.sys(ulib.SYS_MOUNT, 0, 0, 0) != 1 {
        tools.ob_str((&S_1[0 as usize]) as u64)
        tools.ob_nl()
        tools.ob_flush()
        return 1
    }
    tools.ob_str((&S_0[0 as usize]) as u64)
    tools.ob_nl()
    tools.ob_str((&S_2[0 as usize]) as u64)
    tools.ob_num(ulib.sys(ulib.SYS_SYSINFO, ulib.I_BLOCKS, 0, 0))
    tools.ob_str((&S_3[0 as usize]) as u64)
    tools.ob_num(ulib.sys(ulib.SYS_SYSINFO, ulib.I_BFREE, 0, 0))
    tools.ob_str((&S_4[0 as usize]) as u64)
    tools.ob_num(ulib.sys(ulib.SYS_SYSINFO, ulib.I_IUSED, 0, 0))
    tools.ob_nl()
    tools.ob_flush()
    return 0
}
