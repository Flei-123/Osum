// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/dirname.fi -- Runde K11: alles ausser dem letzten Teil.
//
// POSIX: ohne Schraegstrich ist die Antwort `.`, mit genau einem am
// Anfang ist sie `/`, und nachfolgende Schraegstriche zaehlen nicht.

profile kernel

import ulib
import tools

export { u_start }

static mut buf: [u8; 256] = [0 as u8; 256]

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 25] = "dirname: needs a path\0\0\0\0"
    var s_dot: [u8; 2] = ".\0"
    var s_root: [u8; 2] = "/\0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    ulib.strncpy((&buf[0 as usize]) as u64, ulib.arg_at(args, 1), 256)
    var n: u64 = ulib.length((&buf[0 as usize]) as u64)
    while n > 1 && buf[(n - 1) as usize] == 47 as u8 {
        n = n - 1
    }
    var cut: u64 = ulib.EOF
    var i: u64 = n
    while i > 0 {
        i = i - 1
        if buf[(i) as usize] == 47 as u8 && cut == ulib.EOF {
            cut = i
        }
    }
    if cut == ulib.EOF {
        tools.ob_str((&s_dot[0 as usize]) as u64)
    } else if cut == 0 {
        tools.ob_str((&s_root[0 as usize]) as u64)
    } else {
        var k: u64 = cut
        while k > 1 && buf[(k - 1) as usize] == 47 as u8 {
            k = k - 1
        }
        tools.ob_put((&buf[0 as usize]) as u64, k)
    }
    tools.ob_nl()
    tools.ob_flush()
    return 0
}
