
profile kernel

import ulib

import libc.clockapi
export { u_start }

const SYS_REBOOT: u64 = 169
const RB_POWEROFF: u64 = 0x4321FEDC
const RB_RESTART: u64 = 0x01234567

static mut P_CMD: [u8; 13] = "/run/svc.cmd\0"
static mut S_DOWN: [u8; 10] = "shutdown\n\0"
static mut S_BOOT: [u8; 8] = "reboot\n\0"
static mut E_CMD: [u8; 48] = "shutdown: /run/svc.cmd nicht schreibbar (root?)\0"
static mut E_SLOW: [u8; 56] = "shutdown: init does not answer -- powering off myself\0\0\0"
static mut E_NOOFF: [u8; 39] = "shutdown: the kernel did not power off\0"
static mut O_R: [u8; 3] = "-r\0"
static mut O_H: [u8; 3] = "-h\0"
static mut O_F: [u8; 3] = "-f\0"

fn tell(what: u64) -> bool {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&P_CMD[0 as usize]) as u64, 577, 0)
    if ulib.bad(fd) {
        return false
    }
    ulib.sys(ulib.SYS_WRITE, fd, what, ulib.length(what))
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return true
}

fn self(new: bool) -> u64 {
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    if new {
        ulib.sys(SYS_REBOOT, RB_RESTART, 0, 0)
    } else {
        ulib.sys(SYS_REBOOT, RB_POWEROFF, 0, 0)
    }
    ulib.esay_line((&E_NOOFF[0 as usize]) as u64, 0)
    return 1
}

fn u_start(args: u64) -> u64 {
    var new: bool = false
    var without: bool = false
    let n: u64 = ulib.arg_count(args)
    var i: u64 = 1
    while i < n {
        let a: u64 = ulib.arg_at(args, i)
        if ulib.streq(a, (&O_R[0 as usize]) as u64) {
            new = true
        }
        if ulib.streq(a, (&O_F[0 as usize]) as u64) {
            without = true
        }
        i = i + 1
    }
    if without {
        return self(new)
    }
    var was: u64 = (&S_DOWN[0 as usize]) as u64
    if new {
        was = (&S_BOOT[0 as usize]) as u64
    }
    if !tell(was) {
        ulib.esay_line((&E_CMD[0 as usize]) as u64, 0)
        return self(new)
    }
    var k: u64 = 0
    while k < 60 {
        clockapi.sleep_ms(50)
        k = k + 1
    }
    ulib.esay_line((&E_SLOW[0 as usize]) as u64, 0)
    return self(new)
}
