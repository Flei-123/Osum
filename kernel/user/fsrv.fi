
profile kernel

import ulib
import libc.io
import libc.errno

export { u_start }

const ROLL: u64 = 4096

static mut buf: [u8; 4096] = [0 as u8; 4096];
static mut num: [u8; 32] = [0 as u8; 32];
static mut file_path: [u8; 32] = [0 as u8; 32];
static mut st: [u8; 160] = [0 as u8; 160];
static mut ents: [u8; 4096] = [0 as u8; 4096];

fn muster(g: u64, k: u64) -> u64 {
    return ((g *% 2654435761) +% (k *% 40503)) % 251;
}

fn say_2(name: u64, value: u64) {
    var s_header: [u8; 7] = "fsrv: \0";
    var s_gl: [u8; 4] = " = \0";
    ulib.say((&s_header[0 as usize]) as u64);
    ulib.say(name);
    ulib.say((&s_gl[0 as usize]) as u64);
    ulib.sayu(value);
    ulib.nl();
}

fn set_num(v: u64) -> u64 {
    if v == 0 {
        num[(0) as usize] = 48 as u8;
        num[(1) as usize] = 0 as u8;
        return 1;
    }
    var place: u64 = 0;
    var y: u64 = v;
    while y > 0 {
        place = place + 1;
        y = y / 10;
    }
    let n: u64 = place;
    var x: u64 = v;
    while place > 0 {
        num[(place - 1) as usize] = (48 + (x % 10)) as u8;
        x = x / 10;
        place = place - 1;
    }
    num[(n) as usize] = 0 as u8;
    return n;
}

fn build_path(g: u64) {
    var p_f: [u8; 4] = "/d/\0";
    ulib.strcpy((&file_path[0 as usize]) as u64, (&p_f[0 as usize]) as u64);
    set_num(g);
    ulib.strcat((&file_path[0 as usize]) as u64, (&num[0 as usize]) as u64);
}

fn check_file(g: u64) -> u64 {
    build_path(g);
    let fd: u64 = io.open((&file_path[0 as usize]) as u64, 0);
    if errno.failed(fd) {
        return 0;
    }
    let soll: u64 = 512 + (g * 617) % 1536;
    let n: u64 = io.read_full(fd, (&buf[0 as usize]) as u64, 4096);
    io.close(fd);
    if errno.failed(n) {
        return 3;
    }
    if n == 0 {
        return 1;
    }
    if n != soll {
        return 3;
    }
    var i: u64 = 0;
    while i < n {
        if (buf[(i) as usize] as u64) != muster(g + 1000000, i) {
            return 3;
        }
        i = i + 1;
    }
    if !errno.failed(io.stat_into((&file_path[0 as usize]) as u64,
        (&st[0 as usize]) as u64)) {
        let m: u64 = io.stat_mode_of((&st[0 as usize]) as u64) & 4095;
        if m != 384 + (g % 8) {
            return 4;
        }
    }
    return 2;
}

static mut last_gen: u64 = 0;
static mut last_len: u64 = 0;

// EINE ROLLDATEI. Rueckgabe 1 = in Ordnung.
fn check_roll(file_path: u64, c: u64) -> u64 {
    let rf: u64 = io.open(file_path, 0);
    if errno.failed(rf) {
        if c == 0 {
            return 1;
        }
        return 0;
    }
    let n: u64 = io.read_full(rf, (&buf[0 as usize]) as u64, ROLL);
    io.close(rf);
    var len: u64 = 0;
    if !errno.failed(n) {
        len = n;
    }
    last_len = len;
    if len == 0 {
        if c == 0 {
            return 1;
        }
        return 0;
    }
    if len != ROLL {
        return 0;
    }
    var g: u64 = 0;
    var i: u64 = 0;
    while i < 8 {
        g = g | ((buf[(i) as usize] as u64) << (i * 8));
        i = i + 1;
    }
    last_gen = g;
    if g == 0 {
        return 0;
    }
    if g < c {
        return 0;
    }
    i = 8;
    while i < ROLL {
        if (buf[(i) as usize] as u64) != muster(g, i) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn u_start(args: u64) -> u64 {
    var n_count: [u8; 7] = "count\0\0";
    var n_rollgen: [u8; 9] = "rollgen\0\0";
    var n_rolllen: [u8; 9] = "rolllen\0\0";
    var n_rollok: [u8; 8] = "rollok\0\0";
    var n_rollok2: [u8; 9] = "rollok2\0\0";
    var n_ganz: [u8; 6] = "ganz\0\0";
    var n_mode: [u8; 6] = "mode\0\0";
    var n_next: [u8; 6] = "next\0\0";
    var n_next2: [u8; 7] = "next2\0\0";
    var n_dents: [u8; 7] = "dents\0\0";
    var n_schaeden: [u8; 10] = "schaeden\0\0";
    var p_roll: [u8; 8] = "/d/roll\0";
    var p_roll2: [u8; 9] = "/d/roll2\0";
    var p_count: [u8; 9] = "/d/count\0";
    var p_d: [u8; 3] = "/d\0";

    var schaeden: u64 = 0;

    // ------------------------------------------------------- der Zaehler
    var c: u64 = 0;
    let cf: u64 = io.open((&p_count[0 as usize]) as u64, 0);
    if !errno.failed(cf) {
        let n: u64 = io.read(cf, (&buf[0 as usize]) as u64, 31);
        io.close(cf);
        if !errno.failed(n) {
            var i: u64 = 0;
            while i < n {
                let ch: u64 = buf[(i) as usize] as u64;
                if ch >= 48 && ch <= 57 {
                    c = c * 10 + (ch - 48);
                } else {
                    i = n;
                }
                i = i + 1;
            }
        }
    }
    say_2((&n_count[0 as usize]) as u64, c);

    // ----------------------------------------------------- die Rolldateien
    let r1: u64 = check_roll((&p_roll[0 as usize]) as u64, c);
    let r2: u64 = check_roll((&p_roll2[0 as usize]) as u64, c);
    say_2((&n_rollgen[0 as usize]) as u64, last_gen);
    say_2((&n_rolllen[0 as usize]) as u64, last_len);
    say_2((&n_rollok[0 as usize]) as u64, r1);
    say_2((&n_rollok2[0 as usize]) as u64, r2);
    if r1 == 0 {
        schaeden = schaeden + 1;
    }
    if r2 == 0 {
        schaeden = schaeden + 1;
    }

    var int: u64 = 0;
    var modefehler: u64 = 0;
    var g2: u64 = 1;
    while g2 <= c {
        let z: u64 = check_file(g2);
        if z == 2 {
            int = int + 1;
        } else {
            if z == 4 {
                modefehler = modefehler + 1;
            }
            schaeden = schaeden + 1;
        }
        g2 = g2 + 1;
    }
    say_2((&n_ganz[0 as usize]) as u64, int);
    say_2((&n_mode[0 as usize]) as u64, modefehler);

    let z1: u64 = check_file(c + 1);
    say_2((&n_next[0 as usize]) as u64, z1);
    if z1 == 3 {
        schaeden = schaeden + 1;
    }
    let z2: u64 = check_file(c + 2);
    say_2((&n_next2[0 as usize]) as u64, z2);
    if z2 != 0 {
        schaeden = schaeden + 1;
    }

    var dents: u64 = 0;
    let dd: u64 = io.dir_open((&p_d[0 as usize]) as u64);
    if errno.failed(dd) {
        schaeden = schaeden + 1;
    } else {
        var going: bool = true;
        while going {
            let n: u64 = io.dir_read(dd, (&ents[0 as usize]) as u64, 4096);
            if n == 0 || errno.failed(n) {
                going = false;
            } else {
                var at: u64 = 0;
                while at < n {
                    dents = dents + 1;
                    at = at + io.dir_reclen((&ents[0 as usize]) as u64 + at);
                }
            }
        }
        io.close(dd);
    }
    say_2((&n_dents[0 as usize]) as u64, dents);

    say_2((&n_schaeden[0 as usize]) as u64, schaeden);
    return 0;
}
