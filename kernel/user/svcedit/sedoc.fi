profile app

import fuied
import libc.octets

export {
    set_slot, slot, doc_name_ptr, has_name, set_name, clear_name,
    load, clear, snapshot, text_ptr, mark_clean, dirty, text_len,
    TEXT_CAP, NAME_CAP,
}

const TEXT_CAP: u64 = 65536
const NAME_CAP: u64 = 96

static mut text_buf: [u8; 65600] = [0 as u8; 65600]
static mut name_buf: [u8; 96] = [0 as u8; 96]
static mut editor_slot: u64 = 0

fn set_slot(value: u64) {
    editor_slot = value
}

fn slot() -> u64 {
    return editor_slot
}

fn doc_name_ptr() -> u64 {
    return (&name_buf[0 as usize]) as u64
}

fn has_name() -> bool {
    return octets.ld8(doc_name_ptr(), 0) != 0
}

fn clear_name() {
    octets.zero(doc_name_ptr(), NAME_CAP)
}

fn set_name(p: u64, n: u64) {
    clear_name()
    var take: u64 = n
    if take >= NAME_CAP {
        take = NAME_CAP - 1
    }
    octets.copy(doc_name_ptr(), p, take)
}

fn load(p: u64, n: u64) {
    fuied.ta_text_set(editor_slot, p, n)
    fuied.ta_goto(editor_slot, 0, 0)
    fuied.ta_clean(editor_slot)
}

fn clear() {
    fuied.ta_clear_all(editor_slot)
    fuied.ta_clean(editor_slot)
    clear_name()
}

fn text_ptr() -> u64 {
    return (&text_buf[0 as usize]) as u64
}

fn snapshot() -> u64 {
    return fuied.ta_text_get(editor_slot, text_ptr(), TEXT_CAP)
}

fn mark_clean() {
    fuied.ta_clean(editor_slot)
}

fn dirty() -> bool {
    return fuied.ta_geaendert(editor_slot)
}

fn text_len() -> u64 {
    return snapshot()
}
