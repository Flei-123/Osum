profile app

import msg

export {
    app, window_title, default_name, accept, recent_key,
    untitled, line_word, column_word, lines_word, modified_word,
    cmd_new, cmd_open, cmd_save, discard_title, discard_text, open_title, save_title,
}

static mut APP: [u8; 8] = "svcedit\0"
static mut TITLE: [u8; 7] = "Editor\0"
static mut DEFAULT_NAME: [u8; 13] = "untitled.txt\0"
static mut ACCEPT: [u8; 9] = ".txt,.md\0"
static mut RECENT_KEY: [u8; 7] = "recent\0"
static mut K_UNTITLED: [u8; 15] = "nedit.untitled\0"
static mut K_LINE: [u8; 18] = "nedit.status.line\0"
static mut K_COLUMN: [u8; 20] = "nedit.status.column\0"
static mut K_LINES: [u8; 19] = "nedit.status.lines\0"
static mut K_MODIFIED: [u8; 15] = "nedit.modified\0"
static mut K_NEW: [u8; 16] = "svcedit.cmd.new\0"
static mut K_OPEN: [u8; 17] = "svcedit.cmd.open\0"
static mut K_SAVE: [u8; 17] = "svcedit.cmd.save\0"
static mut K_DISCARD_TITLE: [u8; 22] = "svcedit.discard.title\0"
static mut K_DISCARD_TEXT: [u8; 21] = "svcedit.discard.text\0"
static mut K_OPEN_TITLE: [u8; 19] = "svcedit.open.title\0"
static mut K_SAVE_TITLE: [u8; 19] = "svcedit.save.title\0"

fn app() -> u64 {
    return (&APP[0 as usize]) as u64
}

fn window_title() -> u64 {
    return (&TITLE[0 as usize]) as u64
}

fn default_name() -> u64 {
    return (&DEFAULT_NAME[0 as usize]) as u64
}

fn accept() -> u64 {
    return (&ACCEPT[0 as usize]) as u64
}

fn recent_key() -> u64 {
    return (&RECENT_KEY[0 as usize]) as u64
}

fn untitled() -> u64 {
    return msg.get((&K_UNTITLED[0 as usize]) as u64)
}

fn line_word() -> u64 {
    return msg.get((&K_LINE[0 as usize]) as u64)
}

fn column_word() -> u64 {
    return msg.get((&K_COLUMN[0 as usize]) as u64)
}

fn lines_word() -> u64 {
    return msg.get((&K_LINES[0 as usize]) as u64)
}

fn modified_word() -> u64 {
    return msg.get((&K_MODIFIED[0 as usize]) as u64)
}

fn cmd_new() -> u64 {
    return msg.get((&K_NEW[0 as usize]) as u64)
}

fn cmd_open() -> u64 {
    return msg.get((&K_OPEN[0 as usize]) as u64)
}

fn cmd_save() -> u64 {
    return msg.get((&K_SAVE[0 as usize]) as u64)
}

fn discard_title() -> u64 {
    return msg.get((&K_DISCARD_TITLE[0 as usize]) as u64)
}

fn discard_text() -> u64 {
    return msg.get((&K_DISCARD_TEXT[0 as usize]) as u64)
}

fn open_title() -> u64 {
    return msg.get((&K_OPEN_TITLE[0 as usize]) as u64)
}

fn save_title() -> u64 {
    return msg.get((&K_SAVE_TITLE[0 as usize]) as u64)
}
