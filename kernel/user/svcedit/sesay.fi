profile app

import lineout
import libc.text
import svcedit.sedoc

export { ready, state, created, opened, saved, confirmed, recent, no_surface, shortcut }

static mut READY: [u8; 15] = "svcedit: ready\0"
static mut STATE: [u8; 21] = "svcedit: state name=\0"
static mut LEN: [u8; 6] = " len=\0"
static mut DIRTY: [u8; 8] = " dirty=\0"
static mut NEW: [u8; 13] = "svcedit: new\0"
static mut OPEN: [u8; 20] = "svcedit: open name=\0"
static mut SAVED: [u8; 21] = "svcedit: saved name=\0"
static mut STATUS: [u8; 9] = " status=\0"
static mut CONFIRM: [u8; 25] = "svcedit: confirm status=\0"
static mut ANSWER: [u8; 9] = " answer=\0"
static mut RECENT: [u8; 17] = "svcedit: recent=\0"
static mut NO_SURFACE: [u8; 20] = "svcedit: no surface\0"
static mut DASH: [u8; 2] = "-\0"
static mut SHORTCUT: [u8; 23] = "svcedit: shortcut key=\0"

fn put(buf: u64) {
    lineout.add_text(buf)
}

fn name_or_dash(p: u64) -> u64 {
    if p == 0 || text.length(p) == 0 {
        return (&DASH[0 as usize]) as u64
    }
    return p
}

fn ready() {
    put((&READY[0 as usize]) as u64)
    lineout.end_line()
}

fn state() {
    put((&STATE[0 as usize]) as u64)
    put(name_or_dash(sedoc.name_ptr()))
    put((&LEN[0 as usize]) as u64)
    lineout.add_num(sedoc.text_len())
    put((&DIRTY[0 as usize]) as u64)
    var flag: u64 = 0
    if sedoc.dirty() {
        flag = 1
    }
    lineout.add_num(flag)
    lineout.end_line()
}

fn created() {
    put((&NEW[0 as usize]) as u64)
    lineout.end_line()
}

fn opened(name: u64, status: u64, n: u64) {
    put((&OPEN[0 as usize]) as u64)
    put(name_or_dash(name))
    put((&STATUS[0 as usize]) as u64)
    lineout.add_num(status)
    put((&LEN[0 as usize]) as u64)
    lineout.add_num(n)
    lineout.end_line()
}

fn saved(name: u64, status: u64, n: u64) {
    put((&SAVED[0 as usize]) as u64)
    put(name_or_dash(name))
    put((&STATUS[0 as usize]) as u64)
    lineout.add_num(status)
    put((&LEN[0 as usize]) as u64)
    lineout.add_num(n)
    lineout.end_line()
}

fn confirmed(status: u64, answer: u64) {
    put((&CONFIRM[0 as usize]) as u64)
    lineout.add_num(status)
    put((&ANSWER[0 as usize]) as u64)
    lineout.add_num(answer)
    lineout.end_line()
}

fn recent(name: u64) {
    put((&RECENT[0 as usize]) as u64)
    put(name_or_dash(name))
    lineout.end_line()
}

fn no_surface() {
    put((&NO_SURFACE[0 as usize]) as u64)
    lineout.end_line()
}

fn shortcut(key: u64) {
    put((&SHORTCUT[0 as usize]) as u64)
    lineout.add_num(key)
    lineout.end_line()
}
