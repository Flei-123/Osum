// SPDX-License-Identifier: GPL-2.0-only
profile app

import fuied
import libc.octets
import libc.text
import svcedit.sedoc
import svcedit.sestr

export { compose, status_ptr, title_ptr, changed }

const STATUS_CAP: u64 = 160
const TITLE_CAP: u64 = 96
const SPACE: u64 = 32
const COMMA: u64 = 44

static mut status_buf: [u8; 160] = [0 as u8; 160]
static mut title_buf: [u8; 96] = [0 as u8; 96]
static mut seen_line: u64 = 0
static mut seen_column: u64 = 0
static mut seen_lines: u64 = 0
static mut seen_dirty: bool = false
static mut seen_named: bool = false

fn status_ptr() -> u64 {
    return (&status_buf[0 as usize]) as u64
}

fn title_ptr() -> u64 {
    return (&title_buf[0 as usize]) as u64
}

fn put_text(buf: u64, at: u64, src: u64) -> u64 {
    let n: u64 = text.length(src)
    if at + n >= STATUS_CAP {
        return at
    }
    octets.copy(buf + at, src, n)
    return at + n
}

fn put_char(buf: u64, at: u64, ch: u64) -> u64 {
    octets.st8(buf, at, ch)
    return at + 1
}

fn put_number(buf: u64, at: u64, value: u64) -> u64 {
    var digits: [u8; 26] = [0 as u8; 26]
    let ptr: u64 = (&digits[0 as usize]) as u64
    let n: u64 = text.digits(value, ptr, false)
    octets.copy(buf + at, ptr, n)
    return at + n
}

fn compose_status(slot: u64) {
    let buf: u64 = status_ptr()
    var at: u64 = put_text(buf, 0, sestr.line_word())
    at = put_char(buf, at, SPACE)
    at = put_number(buf, at, fuied.ta_line_of(slot))
    at = put_char(buf, at, COMMA)
    at = put_char(buf, at, SPACE)
    at = put_text(buf, at, sestr.column_word())
    at = put_char(buf, at, SPACE)
    at = put_number(buf, at, fuied.ta_column(slot))
    at = put_char(buf, at, SPACE)
    at = put_text(buf, at, sestr.lines_word())
    at = put_char(buf, at, SPACE)
    at = put_number(buf, at, fuied.ta_lines(slot))
    if sedoc.dirty() {
        at = put_text(buf, at, sestr.modified_word())
    }
    octets.st8(buf, at, 0)
}

fn compose_title() {
    octets.zero(title_ptr(), TITLE_CAP)
    var shown: u64 = sestr.untitled()
    if sedoc.has_name() {
        shown = sedoc.name_ptr()
    }
    var n: u64 = text.length(shown)
    if n >= TITLE_CAP {
        n = TITLE_CAP - 1
    }
    octets.copy(title_ptr(), shown, n)
}

fn changed() -> bool {
    let slot: u64 = sedoc.slot()
    return fuied.ta_line_of(slot) != seen_line || fuied.ta_column(slot) != seen_column
        || fuied.ta_lines(slot) != seen_lines || sedoc.dirty() != seen_dirty
        || sedoc.has_name() != seen_named
}

fn compose() {
    let slot: u64 = sedoc.slot()
    seen_line = fuied.ta_line_of(slot)
    seen_column = fuied.ta_column(slot)
    seen_lines = fuied.ta_lines(slot)
    seen_dirty = sedoc.dirty()
    seen_named = sedoc.has_name()
    compose_status(slot)
    compose_title()
}
