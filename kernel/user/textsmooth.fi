profile app

import libc.io
import ulib
import fui.painter

export { apply }

const CONF_BYTES: u64 = 64
const NOT_FOUND: u64 = 0xFFFFFFFFFFFFFFFF

static mut CONF_PATH: [u8; 21] = "/etc/textsmooth.conf\0"
static mut MODE_GREY: [u8; 5] = "grey\0"
static mut applied: bool = false
static mut conf_buf: [u8; 65] = [0 as u8; 65]

fn grey_requested() -> bool {
    let fd: u64 = io.open((&CONF_PATH[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return false
    }
    let got: u64 = io.read_full(fd, (&conf_buf[0 as usize]) as u64, CONF_BYTES)
    io.close(fd)
    if ulib.bad(got) {
        return false
    }
    conf_buf[got as usize] = 0 as u8
    return ulib.find((&conf_buf[0 as usize]) as u64, (&MODE_GREY[0 as usize]) as u64) != NOT_FOUND
}

fn apply() {
    if applied {
        return
    }
    applied = true
    painter.painter_set_lcd_flip(true)
    painter.painter_set_lcd(!grey_requested())
}
