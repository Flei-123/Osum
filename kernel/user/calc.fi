// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/rechner.fi -- Runde ALLTAG: DER TASCHENRECHNER.
//
// Er kann zweierlei sein, und beides aus EINER Datei:
//
//   rechner                 macht ein Fenster auf (wlib, sonst nichts)
//   rechner -e "2+3*4"      rechnet und schreibt das Ergebnis hin
//
// Der zweite Weg ist nicht bequem, sondern die MESSUNG: die Abnahme
// dieser Runde schickt dreissig Ausdruecke durch `-e` und haelt jede
// Antwort gegen Python. Ein Rechner, dessen Richtigkeit nur ein Mensch
// im Bild bestaetigt hat, ist ein Rechner mit unbekannten Fehlern.
//
// DIE SPRACHE, die er versteht -- und zwar so, wie Python sie auch
// versteht, sonst waere der Vergleich keiner:
//
//   + - * /        wie ueblich, Punkt vor Strich
//   %              Rest (math.fmod, wie Python fuer positive Zahlen)
//   ^              Potenz, RECHTS gebunden: 2^3^2 = 2^9
//   -x             Vorzeichen bindet SCHWAECHER als ^: -2^2 = -4
//   n!             Fakultaet, nur ganze Zahlen von 0 bis 170
//   ( )            Klammern
//   pi e ans       Konstanten; `ans` ist das letzte Ergebnis
//   sqrt abs sin cos tan asin acos atan ln log log2 exp
//   floor ceil round cbrt          -- ein Argument
//   pow min max hypot atan2 fmod   -- zwei, mit Komma
//
// `log` ist der Zehnerlogarithmus (wie auf jedem Taschenrechner),
// `ln` der natuerliche.
//
// WINKEL: die Bibliothek rechnet in Bogenmass. Der Haken "Grad" im
// Fenster schaltet Ein- und Ausgabe der Winkelfunktionen auf Grad um;
// auf der Konsole bleibt es bei Bogenmass, ausser `-deg` steht dabei.
//
// DIE OBERFLAECHE kommt ausschliesslich aus wlib: eine Menueleiste,
// Reiter, ein Textfeld fuer den Ausdruck, eine Beschriftung fuer das
// Ergebnis und drei Kaesten voll Knoepfe. Keine einzige Zeichenroutine
// wird von hier aus gerufen, kein Bildpunkt und keine Farbe steht in
// dieser Datei -- was gemalt wird, malt wlib, und wo es steht, rechnen
// die Layoutkaesten aus.

// RUNDE GRUNDLINIE: profile app -- dieses Programm malt mit `wlib`, und
// `wlib` malt seit Runde 31 mit fUi. fUi rechnet in `f64` und benutzt
// `std.rt`; beides ist unter `profile kernel` gesperrt:
//
//     error: the module 'std.rt' belongs to the standard library and
//     is not available in profile 'kernel'
//
// Die sieben Programme des Schreibtischs (desktop, taskbar, settings,
// launcher, explorer, widgetdemo, taskmgr) stehen seit Runde 31 bzw.
// ABBILD auf `app`. Diese elf hier sind dabei uebersehen worden -- sie
// haben nie jemand gebaut ausser `fas` in K16, und dort fielen sie unter
// dem Sammelbefund "fas scheitert an" nicht auf.
profile app

import ulib
import std.math
import wlibc
import wlib
import fuiscene

export { u_start }

// ============================ DER AUSDRUCK

const MAXEX: u64 = 230

static mut ex: [u8; 256] = [0 as u8; 256]
static mut res: [u8; 128] = [0 as u8; 128]
static mut idb: [u8; 24] = [0 as u8; 24]
static mut uval: [u8; 64] = [0 as u8; 64]
static mut ures: [u8; 96] = [0 as u8; 96]

static mut srcp: u64 = 0
static mut pos: u64 = 0
static mut err: u64 = 0
static mut deg: bool = false
static mut ans: f64 = 0.0

// Die Namen, in der Reihenfolge, in der `apply` sie kennt. Alles ab 16
// nimmt zwei Argumente -- daran entscheidet der Zerteiler, ob er ein
// Komma verlangt.
static mut FN: [u8; 103] = "sqrt\0abs\0sin\0cos\0tan\0asin\0acos\0atan\0ln\0log\0log2\0exp\0floor\0ceil\0round\0cbrt\0pow\0min\0max\0hypot\0atan2\0fmod\0"
static mut CN: [u8; 9] = "pi\0e\0ans\0"

const NFN: u64 = 22
const TWO: u64 = 16
const NCN: u64 = 3

fn ptr(p: u64) -> u64 {
    return p
}

// Der i-te Text in einem Block aus null-getrennten Texten.
fn nth(blob: u64, i: u64) -> u64 {
    var at: u64 = 0
    var k: u64 = 0
    while k < i {
        while *((blob + at) as *mut u8) != 0 as u8 {
            at = at + 1
        }
        at = at + 1
        k = k + 1
    }
    return blob + at
}

fn idx_of(blob: u64, name: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < n {
        if ulib.streq(nth(blob, i), name) {
            return i
        }
        i = i + 1
    }
    return n
}

fn cur() -> u64 {
    return (*((srcp + pos) as *mut u8)) as u64
}

fn at_k(k: u64) -> u64 {
    return (*((srcp + pos + k) as *mut u8)) as u64
}

fn ws() {
    while cur() == 32 || cur() == 9 {
        pos = pos + 1
    }
}

fn is_dig(c: u64) -> bool {
    return c >= 48 && c <= 57
}

fn is_alpha(c: u64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
}

#[allow_fp]
fn pow10(k: i64) -> f64 {
    var r: f64 = 1.0
    var n: i64 = k
    while n > 0 {
        r = r * 10.0
        n = n - 1
    }
    while n < 0 {
        r = r / 10.0
        n = n + 1
    }
    return r
}

#[allow_fp]
fn p_num() -> f64 {
    var v: f64 = 0.0
    while is_dig(cur()) {
        v = v * 10.0 + ((cur() - 48) as f64)
        pos = pos + 1
    }
    if cur() == 46 {
        pos = pos + 1
        var sk: f64 = 0.1
        while is_dig(cur()) {
            v = v + ((cur() - 48) as f64) * sk
            sk = sk / 10.0
            pos = pos + 1
        }
    }
    if cur() == 101 || cur() == 69 {
        var k: u64 = 1
        var neg: bool = false
        if at_k(1) == 43 {
            k = 2
        } else if at_k(1) == 45 {
            k = 2
            neg = true
        }
        if is_dig(at_k(k)) {
            pos = pos + k
            var e: i64 = 0
            while is_dig(cur()) {
                e = e * 10 + ((cur() - 48) as i64)
                pos = pos + 1
            }
            if neg {
                e = 0 - e
            }
            v = v * pow10(e)
        }
    }
    return v
}

// Ein Name, kleingeschrieben zurueckgegeben.
fn p_ident() -> u64 {
    let b: u64 = (&idb[(0) as usize]) as u64
    var n: u64 = 0
    while is_alpha(cur()) || is_dig(cur()) {
        if n < 20 {
            var c: u64 = cur()
            if c >= 65 && c <= 90 {
                c = c + 32
            }
            __mmio_write8((b + n) as *mut u8, c as u8)
            n = n + 1
        }
        pos = pos + 1
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    return b
}

#[allow_fp]
fn f_asin(x: f64) -> f64 {
    if x > 1.0 || x < 0.0 - 1.0 {
        err = 2
        return 0.0
    }
    if x == 1.0 {
        return math.PI() / 2.0
    }
    if x == 0.0 - 1.0 {
        return 0.0 - math.PI() / 2.0
    }
    return math.atan(x / math.sqrt(1.0 - x * x))
}

#[allow_fp]
fn f_cbrt(x: f64) -> f64 {
    if x == 0.0 {
        return 0.0
    }
    if x < 0.0 {
        return 0.0 - math.powf(0.0 - x, 1.0 / 3.0)
    }
    return math.powf(x, 1.0 / 3.0)
}

#[allow_fp]
fn f_fact(x: f64) -> f64 {
    let n: f64 = math.round(x)
    if math.fabs(x - n) > 0.000000001 || n < 0.0 || n > 170.0 {
        err = 2
        return 0.0
    }
    var r: f64 = 1.0
    var k: u64 = 2
    let m: u64 = n as u64
    while k <= m {
        r = r * (k as f64)
        k = k + 1
    }
    return r
}

// Potenz. Eine negative Basis mit ganzzahligem Exponenten geht ueber
// `powi` -- `exp(e*ln b)` waere dort NaN, und (-8)^(1/3) ist auch in
// Python ein Fehler, also bleibt es einer.
#[allow_fp]
fn f_pow(b: f64, e: f64) -> f64 {
    if b < 0.0 {
        let r: f64 = math.round(e)
        if math.fabs(e - r) < 0.000000001 {
            return math.powi(b, r as i64)
        }
        err = 2
        return 0.0
    }
    if b == 0.0 && e < 0.0 {
        err = 2
        return 0.0
    }
    let r2: f64 = math.round(e)
    if math.fabs(e - r2) < 0.000000001 && math.fabs(e) < 1000.0 {
        return math.powi(b, r2 as i64)
    }
    return math.powf(b, e)
}

#[allow_fp]
fn apply(fi: u64, a: f64, b: f64) -> f64 {
    let r2d: f64 = 180.0 / math.PI()
    var x: f64 = a
    if fi == 2 || fi == 3 || fi == 4 {
        if deg {
            x = a / r2d
        }
        if fi == 2 {
            return math.sin(x)
        }
        if fi == 3 {
            return math.cos(x)
        }
        return math.tan(x)
    }
    if fi == 5 || fi == 6 || fi == 7 {
        var w: f64 = 0.0
        if fi == 5 {
            w = f_asin(a)
        } else if fi == 6 {
            w = math.PI() / 2.0 - f_asin(a)
        } else {
            w = math.atan(a)
        }
        if deg {
            w = w * r2d
        }
        return w
    }
    if fi == 0 {
        if a < 0.0 {
            err = 2
            return 0.0
        }
        return math.sqrt(a)
    }
    if fi == 1 {
        return math.fabs(a)
    }
    if fi == 8 {
        if a <= 0.0 {
            err = 2
            return 0.0
        }
        return math.ln(a)
    }
    if fi == 9 {
        if a <= 0.0 {
            err = 2
            return 0.0
        }
        return math.log10(a)
    }
    if fi == 10 {
        if a <= 0.0 {
            err = 2
            return 0.0
        }
        return math.log2(a)
    }
    if fi == 11 {
        return math.exp(a)
    }
    if fi == 12 {
        return math.floor(a)
    }
    if fi == 13 {
        return math.ceil(a)
    }
    if fi == 14 {
        return math.round(a)
    }
    if fi == 15 {
        return f_cbrt(a)
    }
    if fi == 16 {
        return f_pow(a, b)
    }
    if fi == 17 {
        return math.fmin(a, b)
    }
    if fi == 18 {
        return math.fmax(a, b)
    }
    if fi == 19 {
        return math.hypot(a, b)
    }
    if fi == 20 {
        var w2: f64 = math.atan2(a, b)
        if deg {
            w2 = w2 * r2d
        }
        return w2
    }
    if fi == 21 {
        if b == 0.0 {
            err = 2
            return 0.0
        }
        return math.fmod(a, b)
    }
    err = 1
    return 0.0
}

#[allow_fp]
fn p_atom() -> f64 {
    ws()
    let c: u64 = cur()
    if c == 40 {
        pos = pos + 1
        let v: f64 = p_expr()
        ws()
        if cur() == 41 {
            pos = pos + 1
        } else {
            err = 1
        }
        return v
    }
    if is_dig(c) || c == 46 {
        return p_num()
    }
    if is_alpha(c) {
        let nm: u64 = p_ident()
        let fi: u64 = idx_of((&FN[(0) as usize]) as u64, nm, NFN)
        ws()
        if cur() == 40 {
            if fi >= NFN {
                err = 1
                return 0.0
            }
            pos = pos + 1
            let a: f64 = p_expr()
            var b: f64 = 0.0
            if fi >= TWO {
                ws()
                if cur() == 44 {
                    pos = pos + 1
                    b = p_expr()
                } else {
                    err = 1
                }
            }
            ws()
            if cur() == 41 {
                pos = pos + 1
            } else {
                err = 1
            }
            return apply(fi, a, b)
        }
        let ci: u64 = idx_of((&CN[(0) as usize]) as u64, nm, NCN)
        if ci == 0 {
            return math.PI()
        }
        if ci == 1 {
            return math.E()
        }
        if ci == 2 {
            return ans
        }
        err = 1
        return 0.0
    }
    err = 1
    return 0.0
}

#[allow_fp]
fn p_post() -> f64 {
    var v: f64 = p_atom()
    ws()
    while cur() == 33 && err == 0 {
        pos = pos + 1
        v = f_fact(v)
        ws()
    }
    return v
}

#[allow_fp]
fn p_pow() -> f64 {
    let a: f64 = p_post()
    ws()
    if cur() == 94 {
        pos = pos + 1
        let b: f64 = p_unary()
        return f_pow(a, b)
    }
    return a
}

#[allow_fp]
fn p_unary() -> f64 {
    ws()
    if cur() == 45 {
        pos = pos + 1
        return 0.0 - p_unary()
    }
    if cur() == 43 {
        pos = pos + 1
        return p_unary()
    }
    return p_pow()
}

#[allow_fp]
fn p_term() -> f64 {
    var v: f64 = p_unary()
    var weiter: bool = true
    while weiter && err == 0 {
        ws()
        let c: u64 = cur()
        if c == 42 {
            pos = pos + 1
            v = v * p_unary()
        } else if c == 47 {
            pos = pos + 1
            let d: f64 = p_unary()
            if d == 0.0 {
                err = 2
                return 0.0
            }
            v = v / d
        } else if c == 37 {
            pos = pos + 1
            let m: f64 = p_unary()
            if m == 0.0 {
                err = 2
                return 0.0
            }
            v = math.fmod(v, m)
        } else {
            weiter = false
        }
    }
    return v
}

#[allow_fp]
fn p_expr() -> f64 {
    var v: f64 = p_term()
    var weiter: bool = true
    while weiter && err == 0 {
        ws()
        let c: u64 = cur()
        if c == 43 {
            pos = pos + 1
            v = v + p_term()
        } else if c == 45 {
            pos = pos + 1
            v = v - p_term()
        } else {
            weiter = false
        }
    }
    return v
}

// Der ganze Ausdruck. Was hinten stehenbleibt, ist ein Fehler -- sonst
// waere "2+3 quatsch" eine 5.
#[allow_fp]
fn eval(p: u64) -> f64 {
    srcp = p
    pos = 0
    err = 0
    if *((p) as *mut u8) == 0 as u8 {
        err = 1
        return 0.0
    }
    let v: f64 = p_expr()
    ws()
    if cur() != 0 {
        err = 1
    }
    if math.is_nan(v) || math.is_infinite(v) {
        err = 2
    }
    return v
}

// ============================ DIE ZAHL ALS TEXT

fn put_c(out: u64, at: u64, c: u64) -> u64 {
    __mmio_write8((out + at) as *mut u8, c as u8)
    return at + 1
}

fn put_u(out: u64, at: u64, v: u64) -> u64 {
    if v == 0 {
        return put_c(out, at, 48)
    }
    var t: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    while x > 0 {
        t[(n) as usize] = ((x % 10) + 48) as u8
        x = x / 10
        n = n + 1
    }
    var k: u64 = at
    while n > 0 {
        n = n - 1
        k = put_c(out, k, t[(n) as usize] as u64)
    }
    return k
}

// Nachkommastellen ausgeben und hinten die Nullen wegnehmen.
fn put_frac(out: u64, at: u64, frac: u64, stellen: u64) -> u64 {
    if stellen == 0 || frac == 0 {
        return at
    }
    var t: [u8; 24] = [0 as u8; 24]
    var x: u64 = frac
    var i: u64 = stellen
    while i > 0 {
        i = i - 1
        t[(i) as usize] = ((x % 10) + 48) as u8
        x = x / 10
    }
    var n: u64 = stellen
    while n > 0 && t[((n - 1)) as usize] == 48 as u8 {
        n = n - 1
    }
    if n == 0 {
        return at
    }
    var k: u64 = put_c(out, at, 46)
    i = 0
    while i < n {
        k = put_c(out, k, t[(i) as usize] as u64)
        i = i + 1
    }
    return k
}

// ZWOELF geltende Ziffern. Mehr waeren gelogen (der Zerteiler selbst
// rechnet mit 53 Bit, und `exp`/`ln` sind Naeherungen), weniger waeren
// aergerlich.
#[allow_fp]
fn fmt(x: f64, out: u64) {
    var s_nan: [u8; 4] = "nan\0"
    var s_inf: [u8; 4] = "inf\0"
    var at: u64 = 0
    if math.is_nan(x) {
        ulib.strcpy(out, (&s_nan[(0) as usize]) as u64)
        return
    }
    var v: f64 = x
    if v < 0.0 {
        at = put_c(out, at, 45)
        v = 0.0 - v
    }
    if math.is_infinite(v) {
        ulib.strcpy(out + at, (&s_inf[(0) as usize]) as u64)
        return
    }
    if v == 0.0 {
        at = put_c(out, at, 48)
        __mmio_write8((out + at) as *mut u8, 0 as u8)
        return
    }
    var e: i64 = math.floor(math.log10(v)) as i64
    // `log10` ist eine Naeherung: bei 1000 kann 2.9999... herauskommen.
    // Also nachsehen, statt zu glauben.
    if v / pow10(e) >= 10.0 {
        e = e + 1
    }
    if v / pow10(e) < 1.0 {
        e = e - 1
    }
    if e < 0 - 5 || e > 15 {
        let m: f64 = v / pow10(e)
        let sk: f64 = math.round(m * pow10(11))
        var gz: u64 = (sk / pow10(11)) as u64
        var fr: u64 = (sk - (gz as f64) * pow10(11)) as u64
        if gz >= 10 {
            gz = 1
            fr = 0
            e = e + 1
        }
        at = put_u(out, at, gz)
        at = put_frac(out, at, fr, 11)
        at = put_c(out, at, 101)
        if e < 0 {
            at = put_c(out, at, 45)
            at = put_u(out, at, (0 - e) as u64)
        } else {
            at = put_c(out, at, 43)
            at = put_u(out, at, e as u64)
        }
        __mmio_write8((out + at) as *mut u8, 0 as u8)
        return
    }
    var dec: i64 = 11 - e
    if dec < 0 {
        dec = 0
    }
    let skal: f64 = math.round(v * pow10(dec))
    let divisor: f64 = pow10(dec)
    var int: u64 = (skal / divisor) as u64
    var rest: u64 = (skal - (int as f64) * divisor) as u64
    at = put_u(out, at, int)
    at = put_frac(out, at, rest, dec as u64)
    __mmio_write8((out + at) as *mut u8, 0 as u8)
}

// ============================ EINHEITEN

const UKAT: u64 = 5
const UMAX: u64 = 8

static mut ufac: [f64; 40] = [0.0; 40]
static mut ucnt: [u64; 5] = [0; 5]

static mut U_KAT: [u8; 35] = "Länge\nMasse\nTemperatur\nZeit\nDaten\0"
static mut U_L: [u8; 20] = "m\nkm\ncm\nmm\nmi\nft\nin\0"
static mut U_M: [u8; 13] = "kg\ng\nt\nlb\noz\0"
static mut U_T: [u8; 10] = "°C\n°F\nK\0"
static mut U_Z: [u8; 10] = "s\nmin\nh\nd\0"
static mut U_D: [u8; 14] = "B\nKiB\nMiB\nGiB\0"

fn u_list(k: u64) -> u64 {
    if k == 0 {
        return (&U_L[(0) as usize]) as u64
    }
    if k == 1 {
        return (&U_M[(0) as usize]) as u64
    }
    if k == 2 {
        return (&U_T[(0) as usize]) as u64
    }
    if k == 3 {
        return (&U_Z[(0) as usize]) as u64
    }
    return (&U_D[(0) as usize]) as u64
}

#[allow_fp]
fn u_setup() {
    ucnt[(0) as usize] = 7
    ufac[(0) as usize] = 1.0
    ufac[(1) as usize] = 1000.0
    ufac[(2) as usize] = 0.01
    ufac[(3) as usize] = 0.001
    ufac[(4) as usize] = 1609.344
    ufac[(5) as usize] = 0.3048
    ufac[(6) as usize] = 0.0254
    ucnt[(1) as usize] = 5
    ufac[(8) as usize] = 1.0
    ufac[(9) as usize] = 0.001
    ufac[(10) as usize] = 1000.0
    ufac[(11) as usize] = 0.45359237
    ufac[(12) as usize] = 0.028349523125
    ucnt[(2) as usize] = 3
    ucnt[(3) as usize] = 4
    ufac[(24) as usize] = 1.0
    ufac[(25) as usize] = 60.0
    ufac[(26) as usize] = 3600.0
    ufac[(27) as usize] = 86400.0
    ucnt[(4) as usize] = 4
    ufac[(32) as usize] = 1.0
    ufac[(33) as usize] = 1024.0
    ufac[(34) as usize] = 1048576.0
    ufac[(35) as usize] = 1073741824.0
}

// Temperatur ist kein Faktor, sondern eine Gerade. Deshalb steht sie
// hier fuer sich: erst nach Kelvin, dann von Kelvin weg.
#[allow_fp]
fn t_to_k(i: u64, v: f64) -> f64 {
    if i == 0 {
        return v + 273.15
    }
    if i == 1 {
        return (v - 32.0) * 5.0 / 9.0 + 273.15
    }
    return v
}

#[allow_fp]
fn k_to_t(i: u64, v: f64) -> f64 {
    if i == 0 {
        return v - 273.15
    }
    if i == 1 {
        return (v - 273.15) * 9.0 / 5.0 + 32.0
    }
    return v
}

#[allow_fp]
fn umrechnen(kat: u64, von: u64, move_to: u64, v: f64) -> f64 {
    if kat == 2 {
        return k_to_t(move_to, t_to_k(von, v))
    }
    let a: f64 = ufac[((kat * UMAX + von)) as usize]
    let b: f64 = ufac[((kat * UMAX + move_to)) as usize]
    if b == 0.0 {
        return 0.0
    }
    return v * a / b
}

// ============================ DAS FENSTER

const T_REASON: u64 = 0
const T_WISS: u64 = 1
const T_EINH: u64 = 2

static mut W_T: [u8; 8] = "Rechner\0"
static mut W_APP: [u8; 8] = "rechner\0"
static mut M0: [u8; 6] = "Datei\0"
static mut M1: [u8; 8] = "Ansicht\0"
static mut M2: [u8; 6] = "Hilfe\0"
static mut MS0: [u8; 18] = "Löschen\0Beenden\0\0"
static mut MS1: [u8; 16] = "Bogenmaß\0Grad\0\0"
static mut MS2: [u8; 7] = "Über\0\0"
static mut TB0: [u8; 6] = "Grund\0"
static mut TB1: [u8; 17] = "Wissenschaftlich\0"
static mut TB2: [u8; 10] = "Einheiten\0"
static mut T_GLEICH: [u8; 2] = "=\0"
static mut T_UB: [u8; 10] = "Umrechnen\0"
static mut T_HINT: [u8; 40] = "Ausdruck eingeben, Eingabetaste rechnet\0"
static mut T_FEHL: [u8; 19] = "Fehler im Ausdruck\0"
static mut T_FEHL2: [u8; 16] = "nicht rechenbar\0"
static mut T_UEBER: [u8; 27] = "Rechner 1.0 -- Osum ALLTAG\0"
static mut T_LEER: [u8; 2] = " \0"

// Zwanzig Knoepfe, vier je Zeile, und daneben steht, was jeder
// einfuegt. `C` und `<-` stehen fuer sich; ihr Eintrag ist leer.
static mut P_TXT: [u8; 57] = "C\0(\0)\0<-\0 7\0 8\0 9\0 /\0 4\0 5\0 6\0 *\0 1\0 2\0 3\0 -\0 0\0 .\0 %\0 +\0"
static mut P_PROZ: [u8; 5] = "/100\0"
static mut S_TXT: [u8; 46] = "sqrt\0x^2\0x^y\0n!\0sin\0cos\0tan\0pi\0ln\0log\0exp\0ans\0"
static mut S_INS: [u8; 49] = "sqrt(\0^2\0^\0!\0sin(\0cos(\0tan(\0pi\0ln(\0log(\0exp(\0ans\0"

const NPAD: u64 = 20
const NSCI: u64 = 12

static mut pid: [u64; 20] = [0; 20]
static mut sid: [u64; 12] = [0; 12]

static mut tab: u64 = 0
// Keys of the nodes the program wants to hear from (fuiscene).
const K_M_DATEI: u64 = 10
const K_M_ANS: u64 = 11
const K_M_HILFE: u64 = 12
const K_TAB: u64 = 20
const K_UKAT: u64 = 30
const K_UVON: u64 = 31
const K_UNACH: u64 = 32
const K_EQ: u64 = 1
const K_UB: u64 = 2
const K_EX: u64 = 100
const K_UV: u64 = 101
const K_SCI: u64 = 200
const K_PAD: u64 = 300

// What the wlib widgets used to hold.
static mut u_kat: u64 = 0
static mut u_von: u64 = 0
static mut u_nach: u64 = 1
static mut pop_for: u64 = 0
static mut pop_blob: [u8; 96] = [0 as u8; 96]
static mut bw: u64 = 0
static mut bh: u64 = 0

fn say(p: u64) {
    ulib.say(p)
}

fn ex_len() -> u64 {
    return ulib.length((&ex[(0) as usize]) as u64)
}

// Die Aufschrift eines Knopfes ist zugleich das, was er einfuegt --
// bis auf die Leerzeichen davor, die nur die Ziffern vom Trennzeichen
// des Blocks fernhalten.
fn without_air(p: u64) -> u64 {
    var q: u64 = p
    while *((q) as *mut u8) == 32 as u8 {
        q = q + 1
    }
    return q
}

fn ex_anhaengen(p: u64) {
    let b: u64 = (&ex[(0) as usize]) as u64
    var n: u64 = ex_len()
    var k: u64 = 0
    while *((p + k) as *mut u8) != 0 as u8 && n < MAXEX {
        __mmio_write8((b + n) as *mut u8, *((p + k) as *mut u8))
        n = n + 1
        k = k + 1
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    fuiscene.entry_set(K_EX, b)
}

fn ex_leeren() {
    __mmio_write8(((&ex[(0) as usize]) as u64) as *mut u8, 0 as u8)
    fuiscene.entry_set(K_EX, (&ex[(0) as usize]) as u64)
}

fn ex_back() {
    let b: u64 = (&ex[(0) as usize]) as u64
    var n: u64 = ex_len()
    if n == 0 {
        return
    }
    n = n - 1
    // Ein UTF-8-Folgeoktett ist kein Zeichen; weiter zurueck.
    while n > 0 && ((*((b + n) as *mut u8)) as u64) >= 128
        && ((*((b + n) as *mut u8)) as u64) < 192 {
        n = n - 1
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    fuiscene.entry_set(K_EX, b)
}

#[allow_fp]
fn compute() {
    let r: u64 = (&res[(0) as usize]) as u64
    ulib.strcpy((&ex[(0) as usize]) as u64, fuiscene.entry_text(K_EX))
    let v: f64 = eval((&ex[(0) as usize]) as u64)
    if err == 1 {
        ulib.strcpy(r, (&T_FEHL[(0) as usize]) as u64)
    } else if err != 0 {
        ulib.strcpy(r, (&T_FEHL2[(0) as usize]) as u64)
    } else {
        ans = v
        fmt(v, r)
    }
    fuiscene.refresh()
    say(r)
    ulib.nl()
}

#[allow_fp]
fn u_compute() {
    let r: u64 = (&ures[(0) as usize]) as u64
    ulib.strcpy((&uval[(0) as usize]) as u64, fuiscene.entry_text(K_UV))
    let v: f64 = eval((&uval[(0) as usize]) as u64)
    if err != 0 {
        ulib.strcpy(r, (&T_FEHL[(0) as usize]) as u64)
    } else {
        fmt(umrechnen(u_kat, u_von, u_nach, v), r)
    }
    fuiscene.refresh()
    say(r)
    ulib.nl()
}

// ---- the window, described for fUi's scene tree (fuiscene) ------------
//
// FUI-ALL stage 2: the Rechner no longer builds wlib widgets. It
// describes a tree (menu bar, tabs, a field, rows of buttons) and fuiscene
// paints and drives it with fUi's own widgets. The state that wlib
// widgets used to hold (which tab, which unit) is a few numbers here.

// A NUL-separated copy of a newline-separated list (the unit lists are
// stored with newlines); returns how many entries it has.
fn nl_to_nul(src: u64, dst: u64) -> u64 {
    var n: u64 = 1
    var k: u64 = 0
    while *((src + k) as *mut u8) != 0 as u8 && k < 90 {
        var c: u8 = *((src + k) as *mut u8)
        if c == 10 as u8 {
            c = 0 as u8
            n = n + 1
        }
        __mmio_write8((dst + k) as *mut u8, c)
        k = k + 1
    }
    __mmio_write8((dst + k) as *mut u8, 0 as u8)
    __mmio_write8((dst + k + 1) as *mut u8, 0 as u8)
    return n
}

// The i-th line of a newline-separated list, as a NUL-terminated text in
// `dst` (at most 38 octets).
fn line_of(src: u64, i: u64, dst: u64) {
    var at: u64 = 0
    var k: u64 = 0
    while k < i && *((src + at) as *mut u8) != 0 as u8 {
        if *((src + at) as *mut u8) == 10 as u8 {
            k = k + 1
        }
        at = at + 1
    }
    var n: u64 = 0
    while *((src + at) as *mut u8) != 0 as u8 && *((src + at) as *mut u8) != 10 as u8 && n < 38 {
        __mmio_write8((dst + n) as *mut u8, *((src + at) as *mut u8))
        n = n + 1
        at = at + 1
    }
    __mmio_write8((dst + n) as *mut u8, 0 as u8)
}

static mut lb_kat: [u8; 40] = [0 as u8; 40]
static mut lb_von: [u8; 40] = [0 as u8; 40]
static mut lb_nach: [u8; 40] = [0 as u8; 40]

fn kat_wechsel() {
    u_von = 0
    u_nach = 1
    if ucnt[(u_kat) as usize] < 2 {
        u_nach = 0
    }
}

// One row of equally wide buttons; the key of a button is `base + index`.
fn grid_row(parent: usize, base: u64, first: u64, n: u64, texts: u64,
    air: bool) {
    let r: usize = fuiscene.row(parent)
    fuiscene.set_gap(r, 8)
    var i: u64 = 0
    while i < n {
        var t: u64 = nth(texts, first + i)
        if air {
            t = without_air(t)
        }
        let b: usize = fuiscene.button(r, t, base + first + i)
        fuiscene.set_size(b, (bw - 16 - 8 * (n - 1)) / n, 32)
        i = i + 1
    }
}

fn build() {
    let col: usize = fuiscene.root()
    let bar: usize = fuiscene.row(col)
    let m1: usize = fuiscene.button(bar, (&M0[(0) as usize]) as u64, K_M_DATEI)
    fuiscene.flat(m1)
    fuiscene.set_size(m1, 76, 36)
    let m2: usize = fuiscene.button(bar, (&M1[(0) as usize]) as u64, K_M_ANS)
    fuiscene.flat(m2)
    fuiscene.set_size(m2, 92, 36)
    let m3: usize = fuiscene.button(bar, (&M2[(0) as usize]) as u64, K_M_HILFE)
    fuiscene.flat(m3)
    fuiscene.set_size(m3, 68, 36)
    let tr: usize = fuiscene.row(col)
    let t0: usize = fuiscene.tab(tr, (&TB0[(0) as usize]) as u64, K_TAB, tab == 0)
    fuiscene.set_size(t0, 96, 36)
    let t1: usize = fuiscene.tab(tr, (&TB1[(0) as usize]) as u64, K_TAB + 1,
        tab == 1)
    fuiscene.set_size(t1, bw - 16 - 192, 36)
    let t2: usize = fuiscene.tab(tr, (&TB2[(0) as usize]) as u64, K_TAB + 2,
        tab == 2)
    fuiscene.set_size(t2, 96, 36)
    if tab != T_EINH {
        let _e: usize = fuiscene.entry(col, K_EX, bw - 16, 0)
        let _l: usize = fuiscene.label(col, (&res[(0) as usize]) as u64)
        if tab == T_WISS {
            var r: u64 = 0
            while r < 3 {
                grid_row(col, K_SCI, r * 4, 4, (&S_TXT[(0) as usize]) as u64,
                    false)
                r = r + 1
            }
        }
        var r2: u64 = 0
        while r2 < 5 {
            grid_row(col, K_PAD, r2 * 4, 4, (&P_TXT[(0) as usize]) as u64,
                true)
            r2 = r2 + 1
        }
        let eq: usize = fuiscene.button_main(col, (&T_GLEICH[(0) as usize]) as u64,
            K_EQ)
        fuiscene.set_size(eq, 0, 32)
    } else {
        line_of((&U_KAT[(0) as usize]) as u64, u_kat, (&lb_kat[(0) as usize]) as u64)
        line_of(u_list(u_kat), u_von, (&lb_von[(0) as usize]) as u64)
        line_of(u_list(u_kat), u_nach, (&lb_nach[(0) as usize]) as u64)
        let kb: usize = fuiscene.button(col, (&lb_kat[(0) as usize]) as u64, K_UKAT)
        fuiscene.set_size(kb, 0, 32)
        let _e: usize = fuiscene.entry(col, K_UV, bw - 16, 0)
        let ur: usize = fuiscene.row(col)
        fuiscene.set_gap(ur, 8)
        let vb: usize = fuiscene.button(ur, (&lb_von[(0) as usize]) as u64, K_UVON)
        fuiscene.set_size(vb, (bw - 16 - 8) / 2, 32)
        let nb: usize = fuiscene.button(ur, (&lb_nach[(0) as usize]) as u64, K_UNACH)
        fuiscene.set_size(nb, (bw - 16 - 8) / 2, 32)
        let ub: usize = fuiscene.button_main(col, (&T_UB[(0) as usize]) as u64, K_UB)
        fuiscene.set_size(ub, 0, 32)
        let _r: usize = fuiscene.label(col, (&ures[(0) as usize]) as u64)
    }
}

// Open a popup under the node with key `key`; `blob` has `n` NUL-separated
// entries; `who` says what the answer means.
fn popup(key: u64, blob: u64, n: u64, who: u64) {
    let i: usize = fuiscene.node_of_key(key)
    pop_for = who
    fuiscene.menu_open(fuiscene.node_x(i), fuiscene.node_y(i) + fuiscene.node_h(i) + 2,
        170, blob, n)
}

fn on_popup(pick: u64) {
    if pick == 0 {
        return
    }
    let k: u64 = pick - 1
    if pop_for == K_M_DATEI {
        if k == 0 {
            ex_leeren()
        } else {
            fuiscene.quit()
        }
    } else if pop_for == K_M_ANS {
        deg = k == 1
    } else if pop_for == K_M_HILFE {
        ulib.strcpy((&res[(0) as usize]) as u64, (&T_UEBER[(0) as usize]) as u64)
        fuiscene.refresh()
    } else if pop_for == K_UKAT {
        u_kat = k
        kat_wechsel()
        fuiscene.refresh()
    } else if pop_for == K_UVON {
        u_von = k
        fuiscene.refresh()
    } else if pop_for == K_UNACH {
        u_nach = k
        fuiscene.refresh()
    }
}

fn on_key(key: u64) {
    if key == K_EQ || key == K_EX {
        compute()
    } else if key == K_UB || key == K_UV {
        u_compute()
    } else if key >= K_TAB && key < K_TAB + 3 {
        tab = key - K_TAB
        fuiscene.refresh()
    } else if key == K_M_DATEI {
        popup(key, (&MS0[(0) as usize]) as u64, 2, key)
    } else if key == K_M_ANS {
        popup(key, (&MS1[(0) as usize]) as u64, 2, key)
    } else if key == K_M_HILFE {
        popup(key, (&MS2[(0) as usize]) as u64, 1, key)
    } else if key == K_UKAT {
        let n: u64 = nl_to_nul((&U_KAT[(0) as usize]) as u64,
            (&pop_blob[(0) as usize]) as u64)
        popup(key, (&pop_blob[(0) as usize]) as u64, n, key)
    } else if key == K_UVON || key == K_UNACH {
        let n: u64 = nl_to_nul(u_list(u_kat), (&pop_blob[(0) as usize]) as u64)
        popup(key, (&pop_blob[(0) as usize]) as u64, n, key)
    } else if key >= K_PAD && key < K_PAD + NPAD {
        let k: u64 = key - K_PAD
        if k == 0 {
            ex_leeren()
        } else if k == 3 {
            ex_back()
        } else if k == 18 {
            ex_anhaengen((&P_PROZ[(0) as usize]) as u64)
        } else {
            ex_anhaengen(without_air(nth((&P_TXT[(0) as usize]) as u64, k)))
        }
    } else if key >= K_SCI && key < K_SCI + NSCI {
        ex_anhaengen(nth((&S_INS[(0) as usize]) as u64, key - K_SCI))
    }
}

fn u_gui() -> u64 {
    var s_bad: [u8; 23] = "rechner: keine Flaeche\0"
    var s_go: [u8; 15] = "rechner: ready\0"
    var s_geom: [u8; 17] = "rechner: geom w=\0"
    var s_h: [u8; 4] = " h=\0"
    u_setup()
    ulib.strcpy((&res[(0) as usize]) as u64, (&T_HINT[(0) as usize]) as u64)
    ulib.strcpy((&ures[(0) as usize]) as u64, (&T_LEER[(0) as usize]) as u64)
    bw = 376
    bh = 430
    if !fuiscene.open(80, 60, bw, bh, (&W_T[(0) as usize]) as u64, build) {
        say((&s_bad[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    var first: bool = true
    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        if first {
            first = false
            say((&s_geom[(0) as usize]) as u64)
            ulib.sayn(bw)
            say((&s_h[(0) as usize]) as u64)
            ulib.sayn(bh)
            ulib.nl()
            var s_nm: [u8; 8] = "rechner\0"
            fuiscene.say_rects((&s_nm[(0) as usize]) as u64)
            fuiscene.say_texts()
            say((&s_go[(0) as usize]) as u64)
            ulib.nl()
        }
        if key == fuiscene.KEY_POPUP {
            on_popup(fuiscene.menu_pick())
        } else if key != 0 {
            on_key(key)
        }
    }
    return 0
}

// ============================ DIE KONSOLE

#[allow_fp]
fn u_start(args: u64) -> u64 {
    var s_e: [u8; 3] = "-e\0"
    var s_deg: [u8; 5] = "-deg\0"
    var s_use: [u8; 35] = "rechner: rechner -e \"2+3*4\" [-deg]\0"
    let argc: u64 = ulib.arg_count(args)
    var ausdruck: u64 = 0
    var a: u64 = 1
    while a < argc {
        let p: u64 = ulib.arg_at(args, a)
        if ulib.streq(p, (&s_e[(0) as usize]) as u64) {
            if a + 1 < argc {
                ausdruck = ulib.arg_at(args, a + 1)
                a = a + 1
            }
        } else if ulib.streq(p, (&s_deg[(0) as usize]) as u64) {
            deg = true
        }
        a = a + 1
    }
    if argc > 1 && ausdruck == 0 {
        say((&s_use[(0) as usize]) as u64)
        ulib.nl()
        return 2
    }
    if ausdruck == 0 {
        return u_gui()
    }
    let r: u64 = (&res[(0) as usize]) as u64
    let v: f64 = eval(ausdruck)
    if err == 1 {
        say((&T_FEHL[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    if err != 0 {
        say((&T_FEHL2[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    fmt(v, r)
    say(r)
    ulib.nl()
    return 0
}

// RUNDE ROTABSCHNITTE: DIESES `main` LAEUFT, UND ES MUSS DIE
// ARGUMENTE WEITERGEBEN.
//
// Der Kommentar, der hier stand, sagte "das `main`, das nie laeuft --
// `user.ld` springt nach `u_start`". Das stimmt fuer ein Programm, das
// mit `kernel/user/crt.s` gebunden ist; dessen `_start` ruft
// USER_ENTRY. Unter `profile app` stimmt es NICHT: dort bringt firnc
// sein eigenes `_start` mit (darum darf crt.o nicht dazu, siehe
// tools/look/shot.sh), und das endet in `call main` -- der Name steht
// fest in lib/firnc1/codegen.fi, `--defsym=USER_ENTRY` erreicht ihn
// nicht. Am gebauten ELF nachgesehen: Einsprung ist `_start`, sechs
// Befehle weiter steht `call <main>`; `_F0.u_start` wird von dort nie
// gerufen.
//
// `u_start(0)` warf damit den Argumentblock weg. Bei powermon waren
// das 54 rote Zusagen (siehe ROTABSCHNITTE 11/n).
//
// Der Block liegt an einer FESTEN Adresse: Runde K16 legte den
// Stapelzeiger darauf (kernel/elf.fi, `T_USTACK = proc.ARGS_BASE`),
// und firnc's `_start` macht `mov rsp, rdi`. Jede `elf: start`-Zeile
// dieses Systems druckt sie als `ustack=0x4007f000`.
fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
