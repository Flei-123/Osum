profile app

import ulib
import lineout
import msg
import busy
import fuiscene
import libc.text
import services.dlgproto
import services.dlgreply
import services.svcrules
import dialogd.dlgpicker

export { u_start }

const ARGS_MIN: u64 = 5
const WIN_X: u64 = 200
const WIN_Y: u64 = 160
const WIN_W: u64 = 380
const WIN_H: u64 = 200
const KEY_CAP: u64 = 48
const PATH_CAP: u64 = 160

static mut key_buf: [u8; 48] = [0 as u8; 48]
static mut path_buf: [u8; 160] = [0 as u8; 160]
static mut staged_buf: [u8; 160] = [0 as u8; 160]
static mut EMPTY: [u8; 1] = "\0"
static mut s_usage: [u8; 15] = "dialogd: usage\0"
static mut s_done: [u8; 22] = "dialogd: done answer=\0"
static mut s_name: [u8; 7] = " name=\0"
static mut s_len: [u8; 6] = " len=\0"

fn empty() -> u64 {
    return (&EMPTY[0 as usize]) as u64
}

fn build() {
    let _col: usize = fuiscene.root()
}

fn show(mode: u64, title: u64, body: u64) -> u64 {
    if !fuiscene.open(WIN_X, WIN_Y, WIN_W, WIN_H, title, build) {
        return dlgproto.ANSWER_FAILED
    }
    var answer: u64 = dlgproto.ANSWER_CANCEL
    if mode == dlgproto.MODE_MESSAGE {
        busy.alert(title, body)
        answer = dlgproto.ANSWER_OK
    } else if busy.confirm(title, body) {
        answer = dlgproto.ANSWER_OK
    }
    fuiscene.close()
    return answer
}

fn app_path(app: u64, key: u64, key_len: u64, out: u64) -> bool {
    return svcrules.store_path(app, text.length(app), key, key_len, out, PATH_CAP) != 0
}

fn input_path(app: u64, id: u64, out: u64) -> bool {
    let key: u64 = (&key_buf[0 as usize]) as u64
    let key_len: u64 = dlgproto.input_key(id, key, KEY_CAP)
    return key_len != 0 && app_path(app, key, key_len, out)
}

fn write_reply(app: u64, id: u64, answer: u64, name: u64, with_content: bool) -> bool {
    var content_len: u64 = 0
    if with_content {
        content_len = dlgpicker.content_len()
    }
    return dlgreply.write(app, id, answer, name, dlgpicker.content_ptr(), content_len)
}

fn report(answer: u64, name: u64) {
    lineout.add_text((&s_done[0 as usize]) as u64)
    lineout.add_num(answer)
    lineout.add_text((&s_name[0 as usize]) as u64)
    lineout.add_text(name)
    lineout.add_text((&s_len[0 as usize]) as u64)
    lineout.add_num(dlgpicker.content_len())
    lineout.end_line()
}

fn run_picker(mode: u64, app: u64, id: u64, title: u64, extra: u64) -> u64 {
    if mode == dlgproto.MODE_OPEN {
        return dlgpicker.run(mode, title, 0, extra, 0)
    }
    let p: u64 = (&staged_buf[0 as usize]) as u64
    if !input_path(app, id, p) {
        return dlgproto.ANSWER_FAILED
    }
    return dlgpicker.run(mode, title, extra, empty(), p)
}

fn u_start(args: u64) -> u64 {
    if ulib.arg_count(args) < ARGS_MIN {
        ulib.esay_line((&s_usage[0 as usize]) as u64, 0)
        return 2
    }
    let id: u64 = ulib.to_num(ulib.arg_at(args, 1))
    let mode: u64 = dlgproto.mode_of(ulib.arg_at(args, 2))
    let app: u64 = ulib.arg_at(args, 3)
    let title: u64 = ulib.arg_at(args, 4)
    var extra: u64 = empty()
    if ulib.arg_count(args) > ARGS_MIN {
        extra = ulib.arg_at(args, ARGS_MIN)
    }
    if mode == dlgproto.MODE_NONE || !svcrules.valid_name(app, text.length(app)) {
        ulib.esay_line((&s_usage[0 as usize]) as u64, 0)
        return 2
    }
    let _mi: u64 = msg.init()
    var answer: u64 = 0
    var name: u64 = empty()
    if mode == dlgproto.MODE_MESSAGE || mode == dlgproto.MODE_CONFIRM {
        answer = show(mode, title, extra)
    } else {
        answer = run_picker(mode, app, id, title, extra)
        name = dlgpicker.chosen_name()
    }
    let wrote: bool = write_reply(app, id, answer, name, mode == dlgproto.MODE_OPEN)
    report(answer, name)
    if !wrote {
        return 1
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
