
profile app

import ulib
import lineout
import libc.io
import trash
import fuiscene
import msg
import libc.pathname

export { u_start }

static mut blob: [u8; 20480] = [0 as u8; 20480]
static mut bp: u64 = 0
static mut header: [u8; 160] = [0 as u8; 160]
static mut columns: [u64; 4] = [0; 4]
static mut root: [u8; 2] = "/\0"

static mut T_TITLE: [u8; 15] = "trashbin.title\0"
static mut T_APP: [u8; 9] = "trashbin\0"
static mut T_ZUR: [u8; 17] = "Wiederherstellen\0"
static mut T_ENT: [u8; 15] = "trashbin.purge\0"
static mut T_EMPTY: [u8; 15] = "trashbin.empty\0"
static mut T_NEW: [u8; 16] = "trashbin.reload\0"
static mut T_VON: [u8; 17] = "trashbin.entries\0"
static mut T_VON2: [u8; 12] = "trashbin.of\0"
static mut T_MIB: [u8; 5] = " MiB\0"
static mut T_LEERTXT: [u8; 17] = "trashbin.isempty\0"

fn say(p: u64) {
    lineout.add_text(p)
}

fn put(c: u64) {
    if bp + 2 < 20480 {
        __mmio_write8(((&blob[(0) as usize]) as u64 + bp) as *mut u8,
            c as u8)
        bp = bp + 1
    }
}

fn puts(p: u64) {
    var i: u64 = 0
    while *((p + i) as *mut u8) != 0 as u8 {
        put((*((p + i) as *mut u8)) as u64)
        i = i + 1
    }
}

fn putn(v: u64) {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = ulib.digits(v, (&z[(0) as usize]) as u64)
    var i: u64 = 0
    while i < n {
        put(z[(i) as usize] as u64)
        i = i + 1
    }
}

fn end() {
    __mmio_write8(((&blob[(0) as usize]) as u64 + bp) as *mut u8, 0 as u8)
}

fn place(path: u64, out: u64, max: u64) {
    let base: u64 = pathname.base_name(path)
    var n: u64 = base - path
    if n > 1 {
        n = n - 1
    }
    if n + 1 > max {
        n = max - 1
    }
    ulib.copy(out, path, n)
    __mmio_write8((out + n) as *mut u8, 0 as u8)
}

const K_TAB: u64 = 1
const K_ZUR: u64 = 2
const K_ENT: u64 = 3
const K_EMPTY: u64 = 4
const K_NEW: u64 = 5

static mut cell: [u8; 160] = [0 as u8; 160]
static mut T_C0: [u8; 5] = "Name\0"
static mut T_C1: [u8; 8] = "Kam aus\0"
static mut T_C2: [u8; 21] = "trashbin.col.deleted\0"
static mut T_C3: [u8; 17] = "storage.col.size\0"

fn zelle(row: u64, col: u64) -> u64 {
    let c: u64 = (&cell[(0) as usize]) as u64
    if row == fuiscene.HEAD_ROW {
        if col == 0 {
            return (&T_C0[(0) as usize]) as u64
        }
        if col == 1 {
            return (&T_C1[(0) as usize]) as u64
        }
        if col == 2 {
            return msg.get((&T_C2[(0) as usize]) as u64)
        }
        return msg.get((&T_C3[(0) as usize]) as u64)
    }
    if row >= trash.count() {
        __mmio_write8(c as *mut u8, 0 as u8)
        return c
    }
    if col == 0 {
        return trash.name_von(row)
    }
    if col == 1 {
        place(trash.path_from(row), c, 120)
        return c
    }
    if col == 2 {
        return trash.time_text(trash.time_from(row))
    }
    let n: u64 = ulib.digits(trash.size_from(row), c)
    __mmio_write8((c + n) as *mut u8, 0 as u8)
    return c
}

fn header_build() {
    let k: u64 = (&header[(0) as usize]) as u64
    var z: [u8; 24] = [0 as u8; 24]
    if trash.count() == 0 {
        ulib.strcpy(k, msg.get((&T_LEERTXT[(0) as usize]) as u64))
        return
    }
    var n: u64 = ulib.digits(trash.count(), (&z[(0) as usize]) as u64)
    z[(n) as usize] = 0 as u8
    ulib.strcpy(k, (&z[(0) as usize]) as u64)
    ulib.strcat(k, msg.get((&T_VON[(0) as usize]) as u64))
    n = ulib.digits((trash.sum() + 1048575) / 1048576,
        (&z[(0) as usize]) as u64)
    z[(n) as usize] = 0 as u8
    ulib.strcat(k, (&z[(0) as usize]) as u64)
    ulib.strcat(k, msg.get((&T_VON2[(0) as usize]) as u64))
    n = ulib.digits(trash.limit() / 1048576, (&z[(0) as usize]) as u64)
    z[(n) as usize] = 0 as u8
    ulib.strcat(k, (&z[(0) as usize]) as u64)
    ulib.strcat(k, (&T_MIB[(0) as usize]) as u64)
}

fn new_read() {
    let _n: u64 = trash.load((&root[(0) as usize]) as u64)
    header_build()
    fuiscene.table_set_rows(K_TAB, trash.count())
    fuiscene.table_set_sel(K_TAB, 0)
    fuiscene.refresh()
}

fn gewaehlt() -> u64 {
    let z: u64 = fuiscene.table_sel(K_TAB)
    if z >= trash.count() {
        return 0xFFFFFFFFFFFFFFFF
    }
    return z
}

fn build() {
    let col: usize = fuiscene.root()
    let _k: usize = fuiscene.label(col, (&header[(0) as usize]) as u64)
    let t: usize = fuiscene.table(col, K_TAB, 604, 260, 4, true, trash.count(), zelle)
    let _t: usize = t
    let bar: usize = fuiscene.row(col)
    fuiscene.set_gap(bar, 8)
    let b1: usize = fuiscene.button(bar, (&T_ZUR[(0) as usize]) as u64, K_ZUR)
    fuiscene.set_size(b1, 152, 36)
    let b2: usize = fuiscene.button(bar, msg.get((&T_ENT[(0) as usize]) as u64), K_ENT)
    fuiscene.set_size(b2, 160, 36)
    let b3: usize = fuiscene.button(bar, msg.get((&T_EMPTY[(0) as usize]) as u64), K_EMPTY)
    fuiscene.set_size(b3, 92, 36)
    let b4: usize = fuiscene.button(bar, msg.get((&T_NEW[(0) as usize]) as u64), K_NEW)
    fuiscene.set_size(b4, 112, 36)
}

fn u_gui() -> u64 {
    var s_bad: [u8; 23] = "trashbin: no surface\0\0\0"
    var s_go: [u8; 16] = "trashbin: ready\0"
    var s_geom: [u8; 18] = "trashbin: geom w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_n: [u8; 20] = "trashbin: entries \0\0"
    let bw: u64 = 620
    let bh: u64 = 360
    let _n0: u64 = trash.load((&root[(0) as usize]) as u64)
    header_build()
    if !fuiscene.open(70, 70, bw, bh, msg.get((&T_TITLE[(0) as usize]) as u64), build) {
        say((&s_bad[(0) as usize]) as u64)
        lineout.end_line()
        return 1
    }
    var win_app_name: [u8; 9] = "trashbin\0"
    fuiscene.set_app((&win_app_name[0 as usize]) as u64)
    var first: bool = true
    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        if first {
            first = false
            fuiscene.table_colw(K_TAB, 0, 160)
            fuiscene.table_colw(K_TAB, 1, 200)
            fuiscene.table_colw(K_TAB, 2, 140)
            fuiscene.table_colw(K_TAB, 3, 84)
            say((&s_geom[(0) as usize]) as u64)
            lineout.add_num(bw)
            say((&s_h[(0) as usize]) as u64)
            lineout.add_num(bh)
            lineout.end_line()
            say((&s_n[(0) as usize]) as u64)
            lineout.add_num(trash.count())
            lineout.end_line()
            var s_nm: [u8; 9] = "trashbin\0"
            fuiscene.say_rects((&s_nm[(0) as usize]) as u64)
            fuiscene.say_texts()
            say((&s_go[(0) as usize]) as u64)
            lineout.end_line()
        }
        if key == K_NEW {
            new_read()
        } else if key == K_EMPTY {
            let _g: u64 = trash.clear((&root[(0) as usize]) as u64)
            new_read()
        } else if key == K_ZUR {
            let z: u64 = gewaehlt()
            if z != 0xFFFFFFFFFFFFFFFF {
                let _r: u64 = trash.back((&root[(0) as usize]) as u64, trash.id_von(z))
            }
            new_read()
        } else if key == K_ENT {
            let z2: u64 = gewaehlt()
            if z2 != 0xFFFFFFFFFFFFFFFF {
                let _e: bool = trash.entfernen((&root[(0) as usize]) as u64, trash.id_von(z2))
            }
            new_read()
        }
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    let _mi: u64 = msg.init()
    var c_list: [u8; 5] = "list\0"
    var c_put: [u8; 4] = "put\0"
    var c_rest: [u8; 8] = "restore\0"
    var c_listing: [u8; 6] = "liste\0"
    var c_gone: [u8; 4] = "weg\0"
    var c_zur: [u8; 8] = "zurueck\0"
    var c_zur_x: [u8; 8] = "zurück\0"
    var c_zur_u: [u8; 17] = "trashbin.restore\0"
    var c_remove: [u8; 7] = "remove\0"
    var c_empty: [u8; 6] = "empty\0"
    var c_ent: [u8; 10] = "entfernen\0"
    var c_clear: [u8; 7] = "leeren\0"
    var c_aus: [u8; 12] = "ausloeschen\0"
    var c_aus_x: [u8; 12] = "auslöschen\0"
    var c_aus_u: [u8; 14] = "trashbin.wipe\0"
    var s_use: [u8; 64] = "trashbin: list | put <file> | restore <n> | remove <n> | empty\0\0"
    var s_nr: [u8; 18] = "trashbin: number \0"
    var s_empty: [u8; 16] = "trashbin: empty\0"
    var s_gone: [u8; 20] = "trashbin: removed \0\0"
    var s_sp: [u8; 3] = "  \0"
    var s_kein: [u8; 22] = "trashbin: failed: \0\0\0\0"
    var s_zurok: [u8; 20] = "trashbin: restored \0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        return u_gui()
    }
    let cmd: u64 = ulib.arg_at(args, 1)
    let wz: u64 = (&root[(0) as usize]) as u64
    if ulib.streq(cmd, (&c_list[(0) as usize]) as u64) || ulib.streq(cmd, (&c_listing[(0) as usize]) as u64) {
        let n: u64 = trash.load(wz)
        if n == 0 {
            say((&s_empty[(0) as usize]) as u64)
            lineout.end_line()
            return 0
        }
        var i: u64 = 0
        while i < n {
            say((&s_nr[(0) as usize]) as u64)
            lineout.add_num(trash.id_von(i))
            say((&s_sp[(0) as usize]) as u64)
            say(trash.path_from(i))
            say((&s_sp[(0) as usize]) as u64)
            lineout.add_num(trash.size_from(i))
            say((&s_sp[(0) as usize]) as u64)
            say(trash.time_text(trash.time_from(i)))
            lineout.end_line()
            i = i + 1
        }
        return 0
    }
    if (ulib.streq(cmd, (&c_put[(0) as usize]) as u64) || ulib.streq(cmd, (&c_gone[(0) as usize]) as u64)) && argc >= 3 {
        let p: u64 = ulib.arg_at(args, 2)
        let id: u64 = trash.hinein(p)
        if id == 0 {
            ulib.esay_line((&s_kein[(0) as usize]) as u64, p)
            return 1
        }
        say((&s_nr[(0) as usize]) as u64)
        lineout.add_num(id)
        lineout.end_line()
        return 0
    }
    if (ulib.streq(cmd, (&c_rest[(0) as usize]) as u64) || ulib.streq(cmd, (&c_zur[(0) as usize]) as u64) || ulib.streq(cmd, (&c_zur_x[(0) as usize]) as u64) || ulib.streq(cmd, msg.get((&c_zur_u[(0) as usize]) as u64))) && argc >= 3 {
        let id2: u64 = ulib.to_num(ulib.arg_at(args, 2))
        let r: u64 = trash.back(wz, id2)
        if r != 0 {
            ulib.esay_line((&s_kein[(0) as usize]) as u64,
                ulib.arg_at(args, 2))
            return 1
        }
        say((&s_zurok[(0) as usize]) as u64)
        lineout.add_num(id2)
        lineout.end_line()
        return 0
    }
    if (ulib.streq(cmd, (&c_remove[(0) as usize]) as u64) || ulib.streq(cmd, (&c_ent[(0) as usize]) as u64)) && argc >= 3 {
        let id3: u64 = ulib.to_num(ulib.arg_at(args, 2))
        if !trash.entfernen(wz, id3) {
            ulib.esay_line((&s_kein[(0) as usize]) as u64,
                ulib.arg_at(args, 2))
            return 1
        }
        say((&s_gone[(0) as usize]) as u64)
        lineout.add_num(id3)
        lineout.end_line()
        return 0
    }
    if (ulib.streq(cmd, (&c_aus[(0) as usize]) as u64) || ulib.streq(cmd, (&c_aus_x[(0) as usize]) as u64) || ulib.streq(cmd, msg.get((&c_aus_u[(0) as usize]) as u64))) && argc >= 3 {
        if !trash.delete_recursive(ulib.arg_at(args, 2), 0) {
            ulib.esay_line((&s_kein[(0) as usize]) as u64,
                ulib.arg_at(args, 2))
            return 1
        }
        say((&s_gone[(0) as usize]) as u64)
        say(ulib.arg_at(args, 2))
        lineout.end_line()
        return 0
    }
    if ulib.streq(cmd, (&c_empty[(0) as usize]) as u64) || ulib.streq(cmd, (&c_clear[(0) as usize]) as u64) {
        let g: u64 = trash.clear(wz)
        say((&s_gone[(0) as usize]) as u64)
        lineout.add_num(g)
        lineout.end_line()
        return 0
    }
    ulib.esay_line((&s_use[(0) as usize]) as u64, 0)
    return 2
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
