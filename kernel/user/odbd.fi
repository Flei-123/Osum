// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/odbd.fi -- ODB debug agent (docs/ODB.md, wire protocol v1).
//
//     odbd            serve the protocol on /dev/odb0 (raw COM2) until killed
//
// Debug images only (tools/usbimg/build.sh ODB=1). Needs /etc/odb.token (>= 16
// octets); without it every `auth` is refused. Single file on purpose: frame
// codec, TLV, HMAC auth and commands. String constants and their accessor
// functions below are generated (one NUL-terminated array per text).
profile kernel

import ulib
import libc.kcall
import libc.errno
import libc.io
import libc.proc
import libc.text
import sha

export { u_start }

