// ------------------------------------------------------------ bytes

fn rd8(p: u64) -> u64 {
    return __mmio_read8(p as *mut u8) as u64
}

fn wr8(p: u64, v: u64) {
    __mmio_write8(p as *mut u8, (v & 255) as u8)
}

fn rd16(p: u64) -> u64 {
    return rd8(p) | (rd8(p + 1) << 8)
}

fn rd32(p: u64) -> u64 {
    return rd8(p) | (rd8(p + 1) << 8) | (rd8(p + 2) << 16) | (rd8(p + 3) << 24)
}

fn rd64(p: u64) -> u64 {
    return rd32(p) | (rd32(p + 4) << 32)
}

fn wr16(p: u64, v: u64) {
    wr8(p, v)
    wr8(p + 1, v >> 8)
}

fn wr32(p: u64, v: u64) {
    wr8(p, v)
    wr8(p + 1, v >> 8)
    wr8(p + 2, v >> 16)
    wr8(p + 3, v >> 24)
}

fn wr64(p: u64, v: u64) {
    wr32(p, v)
    wr32(p + 4, v >> 32)
}

fn addr_rb() -> u64 {
    return (&rb[0 as usize]) as u64
}

fn addr_tb() -> u64 {
    return (&tb[0 as usize]) as u64
}

fn addr_pb() -> u64 {
    return (&pb[0 as usize]) as u64
}

fn addr_req() -> u64 {
    return (&reqbuf[0 as usize]) as u64
}

fn addr_io() -> u64 {
    return (&iobuf[0 as usize]) as u64
}

fn addr_tmp() -> u64 {
    return (&tmp[0 as usize]) as u64
}

fn addr_path() -> u64 {
    return (&pathb[0 as usize]) as u64
}

fn addr_hex() -> u64 {
    return (&hexb[0 as usize]) as u64
}

fn addr_dig() -> u64 {
    return (&dig[0 as usize]) as u64
}

fn copy_bytes(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        wr8(dst + i, rd8(src + i))
        i = i + 1
    }
}

fn mono_ms() -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    kcall.sys2(SYS_CLOCK_GETTIME, 1, (&ts[0 as usize]) as u64)
    return (ts[0 as usize] *% 1000) +% (ts[1 as usize] / 1000000)
}

// ------------------------------------------------------------ crc32

fn crc_init() {
    if crc_ready == 1 {
        return
    }
    var n: u64 = 0
    while n < 256 {
        var c: u64 = n
        var k: u64 = 0
        while k < 8 {
            if (c & 1) != 0 {
                c = 0xEDB88320 ^ (c >> 1)
            } else {
                c = c >> 1
            }
            k = k + 1
        }
        crct[n as usize] = c
        n = n + 1
    }
    crc_ready = 1
}

// running state in, running state out (init 0xFFFFFFFF, final xor by the caller)
fn crc_run(c0: u64, p: u64, n: u64) -> u64 {
    var c: u64 = c0
    var i: u64 = 0
    while i < n {
        c = crct[((c ^ rd8(p + i)) & 255) as usize] ^ (c >> 8)
        i = i + 1
    }
    return c
}

fn crc32(p: u64, n: u64) -> u64 {
    return crc_run(0xFFFFFFFF, p, n) ^ 0xFFFFFFFF
}

// ------------------------------------------------------------ frames out

fn dev_write_all(p: u64, n: u64) -> bool {
    var done: u64 = 0
    var spins: u64 = 0
    while done < n {
        let r: u64 = io.write(dev, p + done, n - done)
        if errno.failed(r) {
            return false
        }
        if r == 0 {
            spins = spins + 1
            if spins > 100000 {
                return false
            }
        } else {
            done = done + r
        }
    }
    return true
}

fn send_frame(typ: u64, flags: u64, id: u64, p: u64, n: u64) -> bool {
    let t: u64 = addr_tb()
    wr8(t, 0x4F)
    wr8(t + 1, 0x44)
    wr8(t + 2, 0x42)
    wr8(t + 3, 0x31)
    wr8(t + 4, 1)
    wr8(t + 5, typ)
    wr16(t + 6, flags)
    wr32(t + 8, id)
    wr32(t + 12, n)
    copy_bytes(t + HDRLEN, p, n)
    wr32(t + HDRLEN + n, crc32(t, HDRLEN + n))
    return dev_write_all(t, HDRLEN + n + 4)
}

// ------------------------------------------------------------ payload build

fn p_reset() {
    pl = 0
}

fn p_key(key: u64, vlen: u64) -> u64 {
    let kl: u64 = text.length(key)
    let b: u64 = addr_pb()
    wr8(b + pl, kl)
    copy_bytes(b + pl + 1, key, kl)
    wr16(b + pl + 1 + kl, vlen)
    let at: u64 = b + pl + 3 + kl
    pl = pl + 3 + kl + vlen
    return at
}

fn p_bytes(key: u64, v: u64, n: u64) {
    if pl + 300 + n > 60000 {
        return
    }
    let at: u64 = p_key(key, n)
    copy_bytes(at, v, n)
}

fn p_str(key: u64, v: u64) {
    p_bytes(key, v, text.length(v))
}

fn p_num(key: u64, v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    let n: u64 = text.digits(v, (&d[0 as usize]) as u64, false)
    p_bytes(key, (&d[0 as usize]) as u64, n)
}

fn send_final(typ: u64, id: u64) -> bool {
    lastid = id
    lasttype = typ
    lastlen = 0
    if pl <= 4096 {
        copy_bytes((&lastbuf[0 as usize]) as u64, addr_pb(), pl)
        lastlen = pl
    }
    return send_frame(typ, 0, id, addr_pb(), pl)
}

fn reply_ok(id: u64) {
    send_final(T_RESP, id)
}

fn reply_err(id: u64, code: u64, msg: u64) {
    p_reset()
    p_str(s_code(), code)
    p_str(s_msg(), msg)
    send_final(T_ERR, id)
}

// ------------------------------------------------------------ frames in

static mut g_last_rx: u64 = 0
static mut g_empty_since: u64 = 0
static mut g_dropped: u64 = 0
static mut g_crcbad: u64 = 0
fn drop_bytes(n: u64) {
    if n >= rlen {
        rlen = 0
        return
    }
    let b: u64 = addr_rb()
    var i: u64 = 0
    while i < rlen - n {
        wr8(b + i, rd8(b + n + i))
        i = i + 1
    }
    rlen = rlen - n
}

fn magic_ok(avail: u64) -> bool {
    let b: u64 = addr_rb()
    if avail > 0 && rd8(b) != 0x4F {
        return false
    }
    if avail > 1 && rd8(b + 1) != 0x44 {
        return false
    }
    if avail > 2 && rd8(b + 2) != 0x42 {
        return false
    }
    if avail > 3 && rd8(b + 3) != 0x31 {
        return false
    }
    return true
}

// Length of a complete valid frame at rb[0], 0 when more octets are needed.
fn have_frame() -> u64 {
    let b: u64 = addr_rb()
    var going: bool = true
    var result: u64 = 0
    while going {
        var avail: u64 = rlen
        if avail > 4 {
            avail = 4
        }
        if avail > 0 && !magic_ok(avail) {
            g_dropped = g_dropped + 1
            drop_bytes(1)
        } else if rlen < HDRLEN {
            going = false
        } else {
            let len: u64 = rd32(b + 12)
            if rd8(b + 4) != 1 || len > MAXP {
                drop_bytes(1)
            } else if rlen < HDRLEN + len + 4 {
                going = false
            } else if crc32(b, HDRLEN + len) != rd32(b + HDRLEN + len) {
                g_crcbad = g_crcbad + 1
                drop_bytes(1)
            } else {
                result = HDRLEN + len + 4
                going = false
            }
        }
    }
    return result
}

// Pull what the line has into rb. Returns octets added.
fn fill() -> u64 {
    if rlen >= RBSIZE - 4096 {
        return 0
    }
    let n: u64 = io.read(dev, addr_rb() + rlen, 4096)
    if errno.failed(n) {
        return 0
    }
    rlen = rlen + n
    if n > 0 {
        g_last_rx = mono_ms()
        g_empty_since = 0
    }
    return n
}

// A frame that was cut off by the peer (host closed the line mid-frame) would block everything behind it
// for ever: after 250 ms without a byte the head of the buffer is dropped one octet at a time (resync).
fn stale_check() {
    if rlen == 0 {
        g_empty_since = 0
        return
    }
    let now: u64 = mono_ms()
    if g_empty_since == 0 {
        // First empty poll since the last byte: the silence starts HERE, not at the last byte. The agent can be busy
        // for much longer than 250 ms between two polls (a 32 KiB disk write under host load) while the rest of
        // a good frame is still on its way.
        g_empty_since = now
        return
    }
    if now -% g_empty_since > 250 {
        g_dropped = g_dropped + 1
        drop_bytes(1)
        g_empty_since = now
    }
}

// Wait up to `ms` for a complete frame. Returns its total length or 0.
fn wait_frame(ms: u64) -> u64 {
    let t0: u64 = mono_ms()
    var going: bool = true
    var result: u64 = 0
    while going {
        let n: u64 = have_frame()
        if n != 0 {
            result = n
            going = false
        } else {
            let got: u64 = fill()
            if got == 0 {
                stale_check()
                if mono_ms() -% t0 >= ms {
                    going = false
                } else {
                    ulib.sys(ulib.SYS_YIELD, 0, 0, 0)
                }
            }
        }
    }
    return result
}

// ------------------------------------------------------------ TLV in

// Value pointer of `key` in the TLV block, NONE-length in g_vlen = absent (returns 0).
fn tget(tp: u64, tl: u64, key: u64) -> u64 {
    return tget_at(tp, tl, key, 0)
}

// The `skip`-th (0 based) occurrence of a repeated key; g_vlen = NONE when there are fewer.
fn tget_at(tp: u64, tl: u64, key: u64, skip: u64) -> u64 {
    var seen: u64 = 0
    let kl: u64 = text.length(key)
    var off: u64 = 0
    g_vlen = NONE
    while off + 3 <= tl {
        let kn: u64 = rd8(tp + off)
        if off + 3 + kn > tl {
            return 0
        }
        let vl: u64 = rd16(tp + off + 1 + kn)
        if off + 3 + kn + vl > tl {
            return 0
        }
        if kn == kl {
            var same: bool = true
            var i: u64 = 0
            while i < kn {
                if rd8(tp + off + 1 + i) != rd8(key + i) {
                    same = false
                }
                i = i + 1
            }
            if same {
                if seen == skip {
                    g_vlen = vl
                    return tp + off + 3 + kn
                }
                seen = seen + 1
            }
        }
        off = off + 3 + kn + vl
    }
    return 0
}

// Value as NUL-terminated copy in out (max octets incl. NUL); false when absent.
fn tget_str(tp: u64, tl: u64, key: u64, out: u64, max: u64) -> bool {
    let v: u64 = tget(tp, tl, key)
    if g_vlen == NONE {
        return false
    }
    var n: u64 = g_vlen
    if n + 1 > max {
        n = max - 1
    }
    copy_bytes(out, v, n)
    wr8(out + n, 0)
    return true
}

fn tget_num(tp: u64, tl: u64, key: u64, dflt: u64) -> u64 {
    let v: u64 = tget(tp, tl, key)
    if g_vlen == NONE {
        return dflt
    }
    var n: u64 = 0
    var i: u64 = 0
    while i < g_vlen {
        let c: u64 = rd8(v + i)
        if c >= 48 && c <= 57 {
            n = n * 10 + (c - 48)
        }
        i = i + 1
    }
    return n
}

fn same_str(a: u64, alen: u64, b: u64) -> bool {
    if alen != text.length(b) {
        return false
    }
    var i: u64 = 0
    while i < alen {
        if rd8(a + i) != rd8(b + i) {
            return false
        }
        i = i + 1
    }
    return true
}

// ------------------------------------------------------------ hashes

fn hexdump(src: u64, n: u64, out: u64) {
    var i: u64 = 0
    while i < n {
        let v: u64 = rd8(src + i)
        let h: u64 = v >> 4
        let l: u64 = v & 15
        if h < 10 {
            wr8(out + 2 * i, 48 + h)
        } else {
            wr8(out + 2 * i, 87 + h)
        }
        if l < 10 {
            wr8(out + 2 * i + 1, 48 + l)
        } else {
            wr8(out + 2 * i + 1, 87 + l)
        }
        i = i + 1
    }
    wr8(out + 2 * n, 0)
}

// HMAC-SHA256(key, msg) -> out[32]
fn hmac(key: u64, klen: u64, msg: u64, mlen: u64, out: u64) {
    let kp: u64 = (&kpad[0 as usize]) as u64
    var i: u64 = 0
    while i < 64 {
        wr8(kp + i, 0)
        i = i + 1
    }
    if klen > 64 {
        sha.begin()
        sha.update(key, klen)
        sha.finish(kp)
    } else {
        copy_bytes(kp, key, klen)
    }
    i = 0
    while i < 64 {
        wr8(kp + i, rd8(kp + i) ^ 0x36)
        i = i + 1
    }
    sha.begin()
    sha.update(kp, 64)
    sha.update(msg, mlen)
    sha.finish((&inner[0 as usize]) as u64)
    i = 0
    while i < 64 {
        wr8(kp + i, rd8(kp + i) ^ 0x36 ^ 0x5C)
        i = i + 1
    }
    sha.begin()
    sha.update(kp, 64)
    sha.update((&inner[0 as usize]) as u64, 32)
    sha.finish(out)
}

// sha256 + crc32 of a whole file; g_size, g_crc set; digest in dig. false = cannot open.
fn hash_file(path: u64) -> bool {
    let fd: u64 = io.open(path, 0)
    if errno.failed(fd) {
        return false
    }
    sha.begin()
    var c: u64 = 0xFFFFFFFF
    var total: u64 = 0
    var going: bool = true
    while going {
        let n: u64 = io.read(fd, addr_io(), 32768)
        if errno.failed(n) || n == 0 {
            going = false
        } else {
            sha.update(addr_io(), n)
            c = crc_run(c, addr_io(), n)
            total = total + n
        }
    }
    io.close(fd)
    sha.finish(addr_dig())
    g_crc = c ^ 0xFFFFFFFF
    g_size = total
    return true
}

// ------------------------------------------------------------ config

// True when /etc/odb.conf exists and has a line `enable=1`.
fn conf_enabled() -> bool {
    let fd: u64 = io.open(s_confpath(), 0)
    if errno.failed(fd) {
        return false
    }
    let n: u64 = io.read(fd, addr_tmp(), 1024)
    io.close(fd)
    if errno.failed(n) {
        return false
    }
    var i: u64 = 0
    while i + 8 <= n {
        var j: u64 = 0
        while j < 8 && rd8(addr_tmp() + i + j) == rd8(s_enable1() + j) {
            j = j + 1
        }
        if j == 8 && (i == 0 || rd8(addr_tmp() + i - 1) == 10) {
            return true
        }
        i = i + 1
    }
    return false
}

fn load_token() {
    toklen = 0
    let fd: u64 = io.open(s_tokpath(), 0)
    if errno.failed(fd) {
        return
    }
    let n: u64 = io.read(fd, (&tok[0 as usize]) as u64, 255)
    io.close(fd)
    if errno.failed(n) {
        return
    }
    var m: u64 = n
    while m > 0 && rd8((&tok[0 as usize]) as u64 + m - 1) <= 32 {
        m = m - 1
    }
    if m >= 16 {
        toklen = m
    }
}

fn new_nonce() {
    ulib.sys(SYS_GETRANDOM, (&nonce[0 as usize]) as u64, 16, 0)
    var i: u64 = 0
    var z: u64 = 0
    while i < 16 {
        z = z | rd8((&nonce[0 as usize]) as u64 + i)
        i = i + 1
    }
    if z == 0 {
        wr8((&nonce[0 as usize]) as u64, mono_ms())
    }
}

// ------------------------------------------------------------ commands

fn cmd_hello(id: u64, tp: u64, tl: u64) {
    let v: u64 = tget_num(tp, tl, s_ver(), 0)
    if v != 1 {
        p_reset()
        p_str(s_code(), s_ever())
        p_str(s_msg(), s_unsup_ver())
        p_str(s_supported(), s_one())
        send_final(T_ERR, id)
        return
    }
    new_nonce()
    authed = 0
    hexdump((&nonce[0 as usize]) as u64, 16, addr_hex())
    p_reset()
    p_num(s_ver(), 1)
    p_str(s_agent(), s_odbd())
    p_num(s_agentver(), 1)
    p_str(s_os(), s_orientos())
    p_str(s_features(), s_featlist())
    p_num(s_maxchunk(), CHUNK)
    p_num(s_window(), WINDOW)
    p_num(s_maxpayload(), MAXP)
    p_str(s_auth(), s_token())
    p_str(s_nonce(), addr_hex())
    send_final(T_RESP, id)
}

fn cmd_auth(id: u64, tp: u64, tl: u64) {
    let mac: u64 = tget(tp, tl, s_mac())
    if toklen == 0 || g_vlen != 64 {
        fails = fails + 1
        ulib.sleep_ms(1000)
        reply_err(id, s_eauth(), s_badmac())
        return
    }
    // msg = "ODB1-auth" || nonce
    let m: u64 = addr_tmp()
    copy_bytes(m, s_authtag(), 9)
    copy_bytes(m + 9, (&nonce[0 as usize]) as u64, 16)
    hmac((&tok[0 as usize]) as u64, toklen, m, 25, addr_dig())
    hexdump(addr_dig(), 32, addr_hex())
    var diff: u64 = 0
    var i: u64 = 0
    while i < 64 {
        diff = diff | (rd8(addr_hex() + i) ^ rd8(mac + i))
        i = i + 1
    }
    if diff != 0 {
        fails = fails + 1
        var d: u64 = 1000
        var k: u64 = 1
        while k < fails && d < 30000 {
            d = d * 2
            k = k + 1
        }
        if d > 30000 {
            d = 30000
        }
        ulib.sleep_ms(d)
        reply_err(id, s_eauth(), s_badmac())
        return
    }
    fails = 0
    authed = 1
    p_reset()
    p_num(s_ok(), 1)
    send_final(T_RESP, id)
}

fn cmd_info(id: u64, tp: u64, tl: u64) {
    let win: u64 = tget_num(tp, tl, s_idle_ms(), 0)
    let ncpu: u64 = ulib.sys(ulib.SYS_CPUSTAT, 0, ulib.CS_COUNT, 0)
    var t0: [u64; 16] = [0 as u64; 16]
    var i0: [u64; 16] = [0 as u64; 16]
    var c: u64 = 0
    while c < ncpu && c < 16 {
        t0[c as usize] = ulib.sys(ulib.SYS_CPUSTAT, c, ulib.CS_TICKS, 0)
        i0[c as usize] = ulib.sys(ulib.SYS_CPUSTAT, c, ulib.CS_IDLE, 0)
        c = c + 1
    }
    if win > 0 {
        if win > 30000 {
            ulib.sleep_ms(30000)
        } else {
            ulib.sleep_ms(win)
        }
    }
    p_reset()
    p_str(s_os(), s_orientos())
    p_num(s_kernel(), ulib.sys(ulib.SYS_SYSINFO, ulib.I_VERSION, 0, 0))
    p_num(s_uptime_ms(), ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0) * 10)
    p_num(s_cpus(), ncpu)
    p_num(s_mem_total_kb(), ulib.sys(ulib.SYS_SYSINFO, ulib.I_FRAMES_ALL, 0, 0) * 4)
    p_num(s_mem_free_kb(), ulib.sys(ulib.SYS_SYSINFO, ulib.I_FRAMES_FREE, 0, 0) * 4)
    var sum_t: u64 = 0
    var sum_i: u64 = 0
    c = 0
    while c < ncpu && c < 16 {
        let t1: u64 = ulib.sys(ulib.SYS_CPUSTAT, c, ulib.CS_TICKS, 0)
        let i1: u64 = ulib.sys(ulib.SYS_CPUSTAT, c, ulib.CS_IDLE, 0)
        var dt: u64 = t1 -% t0[c as usize]
        var di: u64 = i1 -% i0[c as usize]
        if win == 0 {
            dt = t1
            di = i1
        }
        var pct: u64 = 0
        if dt > 0 {
            if di > dt {
                di = dt
            }
            pct = di * 100 / dt
        }
        sum_t = sum_t + dt
        sum_i = sum_i + di
        // idle_core=<n>:<pct>
        var d: [u8; 24] = [0 as u8; 24]
        var n: u64 = text.digits(c, (&d[0 as usize]) as u64, false)
        wr8((&d[0 as usize]) as u64 + n, 58)
        n = n + 1 + text.digits(pct, (&d[0 as usize]) as u64 + n + 1, false)
        p_bytes(s_idle_core(), (&d[0 as usize]) as u64, n)
        c = c + 1
    }
    var allpct: u64 = 0
    if sum_t > 0 {
        allpct = sum_i * 100 / sum_t
    }
    p_num(s_idle_pct(), allpct)
    p_num(s_procs(), ulib.sys(ulib.SYS_SYSINFO, ulib.I_TASKS, 0, 0))
    send_final(T_RESP, id)
}

// ---- exec

fn send_data(stream: u64, p: u64, n: u64, id: u64) {
    let b: u64 = addr_pb()
    // use a local frame build so pb (the pending RESP) is not touched
    let t: u64 = addr_tb()
    wr8(t, 0x4F)
    wr8(t + 1, 0x44)
    wr8(t + 2, 0x42)
    wr8(t + 3, 0x31)
    wr8(t + 4, 1)
    wr8(t + 5, T_DATA)
    wr16(t + 6, 0)
    wr32(t + 8, id)
    wr32(t + 12, n + 1)
    wr8(t + HDRLEN, stream)
    copy_bytes(t + HDRLEN + 1, p, n)
    wr32(t + HDRLEN + 1 + n, crc32(t, HDRLEN + 1 + n))
    dev_write_all(t, HDRLEN + 1 + n + 4)
    if b == 0 {
        return
    }
}

fn send_end(stream: u64, id: u64) {
    var one: [u8; 1] = [0 as u8; 1]
    one[0 as usize] = stream as u8
    send_frame(T_END, 0, id, (&one[0 as usize]) as u64, 1)
}

// look for a CANCEL for `id` without blocking
fn check_cancel(id: u64) {
    fill()
    var n: u64 = have_frame()
    while n != 0 {
        let b: u64 = addr_rb()
        if rd8(b + 5) == T_CANCEL && rd32(b + 8) == id {
            cancelled = 1
        } else if rd8(b + 5) == T_PING {
            send_frame(T_PONG, 0, rd32(b + 8), b + HDRLEN, rd32(b + 12))
        }
        drop_bytes(n)
        n = have_frame()
    }
}

fn pump_pipe(fd: u64, stream: u64, id: u64) -> u64 {
    let n: u64 = io.read(fd, addr_io(), 8192)
    if errno.failed(n) || n == 0 {
        return 0
    }
    send_data(stream, addr_io(), n, id)
    return n
}

fn has_slash(p: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if rd8(p + i) == 47 {
            return true
        }
        i = i + 1
    }
    return false
}

fn cmd_exec(id: u64, tp: u64, tl: u64) {
    // `arg` (repeated): argv without a shell. Program names without a slash are looked up in /bin/.
    var nargs: u64 = 0
    var apos: u64 = 0
    var more: bool = true
    while more && nargs < 16 {
        let av: u64 = tget_at(tp, tl, s_arg(), nargs)
        if g_vlen == NONE {
            more = false
        } else {
            var need: u64 = g_vlen + 1
            var isbin: bool = false
            if nargs == 0 && !has_slash(av, g_vlen) {
                need = need + 5
                isbin = true
            }
            if apos + need > 2048 {
                reply_err(id, s_earg(), s_needcmd())
                return
            }
            let base: u64 = (&argb[0 as usize]) as u64
            argv_ptrs[nargs as usize] = base + apos
            if isbin {
                copy_bytes(base + apos, s_bindir(), 5)
                apos = apos + 5
            }
            copy_bytes(base + apos, av, g_vlen)
            wr8(base + apos + g_vlen, 0)
            apos = apos + g_vlen + 1
            nargs = nargs + 1
        }
    }
    argv_ptrs[nargs as usize] = 0
    if nargs == 0 {
        if !tget_str(tp, tl, s_cmd(), (&cmdb[0 as usize]) as u64, 2048) {
            reply_err(id, s_earg(), s_needcmd())
            return
        }
    }
    let timeout: u64 = tget_num(tp, tl, s_timeout_ms(), 0)
    let want_in: u64 = tget_num(tp, tl, s_stdin(), 0)
    var have_in: bool = false
    if want_in == 1 {
        // stdin is buffered into a file before the child starts
        let sf: u64 = io.create(s_stdinpath())
        if errno.failed(sf) {
            reply_err(id, s_eio(), s_nostdin())
            return
        }
        var ending: bool = false
        while !ending {
            let n: u64 = wait_frame(10000)
            if n == 0 {
                io.close(sf)
                reply_err(id, s_etimeout(), s_stdinwait())
                return
            }
            let b: u64 = addr_rb()
            let ty: u64 = rd8(b + 5)
            let fl: u64 = rd32(b + 12)
            if rd32(b + 8) == id && ty == T_DATA && fl >= 1 && rd8(b + HDRLEN) == 0 {
                io.write_all(sf, b + HDRLEN + 1, fl - 1)
            } else if rd32(b + 8) == id && ty == T_END && rd8(b + HDRLEN) == 0 {
                ending = true
            } else if ty == T_CANCEL {
                ending = true
            }
            drop_bytes(n)
        }
        io.close(sf)
        have_in = true
    }
    // The command string is written to a script file and run as `sh FILE`: the OrientOS sh has no -c.
    if nargs == 0 {
        let cf: u64 = io.create(s_cmdpath())
        if errno.failed(cf) {
            reply_err(id, s_eio(), s_cantcreate())
            return
        }
        var clen: u64 = 0
        while clen < 2047 && rd8((&cmdb[0 as usize]) as u64 + clen) != 0 {
            clen = clen + 1
        }
        wr8((&cmdb[0 as usize]) as u64 + clen, 10)
        io.write_all(cf, (&cmdb[0 as usize]) as u64, clen + 1)
        io.close(cf)
    }
    var pi: [u64; 1] = [0 as u64; 1]
    var po: [u64; 1] = [0 as u64; 1]
    var pe: [u64; 1] = [0 as u64; 1]
    io.pipe((&po[0 as usize]) as u64)
    io.pipe((&pe[0 as usize]) as u64)
    pi[0 as usize] = 0
    let outr: u64 = po[0 as usize] & 0xFFFFFFFF
    let outw: u64 = (po[0 as usize] >> 32) & 0xFFFFFFFF
    let errr: u64 = pe[0 as usize] & 0xFFFFFFFF
    let errw: u64 = (pe[0 as usize] >> 32) & 0xFFFFFFFF
    let t0: u64 = mono_ms()
    let kid: u64 = proc.split()
    if errno.failed(kid) {
        reply_err(id, s_einternal(), s_nofork())
        return
    }
    if kid == 0 {
        if have_in {
            let f: u64 = io.open(s_stdinpath(), 0)
            if !errno.failed(f) {
                io.dup2(f, 0)
                io.close(f)
            }
        } else {
            let f2: u64 = io.open(s_devnull(), 0)
            if !errno.failed(f2) {
                io.dup2(f2, 0)
                io.close(f2)
            }
        }
        io.dup2(outw, 1)
        io.dup2(errw, 2)
        io.close(outr)
        io.close(outw)
        io.close(errr)
        io.close(errw)
        if nargs > 0 {
            ulib.sys(59, argv_ptrs[0 as usize], (&argv_ptrs[0 as usize]) as u64, 0)
            proc.leave(127)
        }
        var argv: [u64; 4] = [0 as u64; 4]
        argv[0 as usize] = s_binsh()
        argv[1 as usize] = s_cmdpath()
        argv[2 as usize] = 0
        ulib.sys(59, s_binsh(), (&argv[0 as usize]) as u64, 0)
        proc.leave(127)
    }
    io.close(outw)
    io.close(errw)
    cancelled = 0
    var status: [u64; 1] = [0 as u64; 1]
    var done: bool = false
    var exited: bool = false
    var killed: u64 = 0
    var out_open: bool = true
    var err_open: bool = true
    var quiet_after_exit: u64 = 0
    while !done {
        // Read only what poll says is there: a blocking read on a pipe a detached grandchild still holds would freeze
        // the agent (no cancel, no timeout, no other request).
        let f: u64 = (&pfds[0 as usize]) as u64
        var nf: u64 = 0
        var out_slot: u64 = 99
        var err_slot: u64 = 99
        if out_open {
            io.poll_set(f, nf, outr, io.POLLIN)
            out_slot = nf
            nf = nf + 1
        }
        if err_open {
            io.poll_set(f, nf, errr, io.POLLIN)
            err_slot = nf
            nf = nf + 1
        }
        var got_any: bool = false
        if nf > 0 {
            io.poll(f, nf, 20)
            if out_open && io.poll_ready(f, out_slot, io.POLLIN | io.POLLHUP | io.POLLERR) {
                let n: u64 = pump_pipe(outr, 1, id)
                if n == 0 {
                    out_open = false
                } else {
                    got_any = true
                }
            }
            if err_open && io.poll_ready(f, err_slot, io.POLLIN | io.POLLHUP | io.POLLERR) {
                let n2: u64 = pump_pipe(errr, 2, id)
                if n2 == 0 {
                    err_open = false
                } else {
                    got_any = true
                }
            }
        } else {
            ulib.sleep_ms(20)
        }
        if !exited {
            let w: u64 = kcall.sys4(SYS_WAIT4, kid, (&status[0 as usize]) as u64, WNOHANG, 0)
            if w == kid {
                exited = true
            }
            check_cancel(id)
            if cancelled == 1 && killed == 0 {
                ulib.sys(ulib.SYS_KILL, kid, 9, 0)
                killed = 1
            }
            if timeout > 0 && mono_ms() -% t0 > timeout && killed == 0 {
                ulib.sys(ulib.SYS_KILL, kid, 9, 0)
                killed = 2
            }
        } else if got_any {
            quiet_after_exit = 0
        } else {
            // the shell is gone but a detached child keeps the pipes open: 300 ms of silence ends the command
            quiet_after_exit = quiet_after_exit + 1
            if quiet_after_exit > 15 {
                out_open = false
                err_open = false
            }
        }
        if exited && !out_open && !err_open {
            done = true
        }
    }
    io.close(outr)
    io.close(errr)
    if have_in {
        io.unlink(s_stdinpath())
    }
    send_end(1, id)
    send_end(2, id)
    if killed == 1 {
        reply_err(id, s_ecancel(), s_cancelled())
        return
    }
    if killed == 2 {
        reply_err(id, s_etimeout(), s_killedtimeout())
        return
    }
    p_reset()
    p_num(s_exit(), (status[0 as usize] >> 8) & 255)
    p_num(s_signal(), status[0 as usize] & 127)
    p_num(s_time_ms(), mono_ms() -% t0)
    send_final(T_RESP, id)
}

// ---- push / pull

fn send_ack(id: u64, next: u64) {
    var a: [u8; 9] = [0 as u8; 9]
    wr8((&a[0 as usize]) as u64, 3)
    wr64((&a[0 as usize]) as u64 + 1, next)
    send_frame(T_ACK, 0, id, (&a[0 as usize]) as u64, 9)
}

fn cmd_push(id: u64, tp: u64, tl: u64) {
    if !tget_str(tp, tl, s_path(), addr_path(), 600) {
        reply_err(id, s_earg(), s_needpath())
        return
    }
    let want_size: u64 = tget_num(tp, tl, s_size(), NONE)
    var wantsha: [u8; 65] = [0 as u8; 65]
    let have_sha: bool = tget_str(tp, tl, s_sha256(), (&wantsha[0 as usize]) as u64, 65)
    let fd: u64 = io.create(addr_path())
    if errno.failed(fd) {
        reply_err(id, s_enoent(), s_cantcreate())
        return
    }
    var next: u64 = 0
    var acked: u64 = 0
    var ending: bool = false
    var failed: u64 = 0
    while !ending {
        let n: u64 = wait_frame(10000)
        if n == 0 {
            failed = 1
            ending = true
        } else {
            let b: u64 = addr_rb()
            let ty: u64 = rd8(b + 5)
            let fid: u64 = rd32(b + 8)
            let plen: u64 = rd32(b + 12)
            if ty == T_DATA && fid == id && plen >= 9 && rd8(b + HDRLEN) == 3 {
                let off: u64 = rd64(b + HDRLEN + 1)
                let cnt: u64 = plen - 9
                if off == next {
                    let w: u64 = io.write_all(fd, b + HDRLEN + 9, cnt)
                    if errno.failed(w) {
                        failed = 2
                        ending = true
                    } else {
                        next = next + cnt
                        // ACK every in-order frame (20 octets): at the UART's ~17 KiB/s one 30 KB frame took longer
                        // than the host's 2 s ack timer, which then rewound the stream for nothing.
                        send_ack(id, next)
                        acked = next
                    }
                } else {
                    send_ack(id, next)
                    acked = next
                }
            } else if ty == T_END && fid == id && plen >= 1 && rd8(b + HDRLEN) == 3 {
                ending = true
            } else if ty == T_PING {
                send_frame(T_PONG, 0, fid, b + HDRLEN, plen)
            } else if ty == T_CANCEL && fid == id {
                failed = 3
                ending = true
            } else if ty == T_REQ {
                // a new session started: the host that was pushing is gone. Leave the REQ in the buffer for the main loop.
                failed = 4
                ending = true
            }
            if failed != 4 {
                drop_bytes(n)
            }
        }
    }
    io.close(fd)
    if failed == 4 {
        return
    }
    if failed == 1 {
        reply_err(id, s_etimeout(), s_pushwait())
        return
    }
    if failed == 3 {
        reply_err(id, s_ecancel(), s_cancelled())
        return
    }
    if failed != 0 {
        reply_err(id, s_eio(), s_writefail())
        return
    }
    send_ack(id, next)
    if !hash_file(addr_path()) {
        reply_err(id, s_eio(), s_readback())
        return
    }
    hexdump(addr_dig(), 32, addr_hex())
    if want_size != NONE && want_size != g_size {
        reply_err(id, s_ecrc(), s_sizemismatch())
        return
    }
    if have_sha && !same_str((&wantsha[0 as usize]) as u64, 64, addr_hex()) {
        reply_err(id, s_ecrc(), s_shamismatch())
        return
    }
    p_reset()
    p_num(s_size(), g_size)
    p_str(s_sha256(), addr_hex())
    p_num(s_crc32(), g_crc)
    send_final(T_RESP, id)
}

fn send_file_chunk(id: u64, fd: u64, off: u64, size: u64) -> u64 {
    var n: u64 = size - off
    if n > CHUNK {
        n = CHUNK
    }
    io.seek(fd, off, 0)
    let got: u64 = io.read(fd, addr_io() + 9, n)
    if errno.failed(got) || got == 0 {
        return 0
    }
    // payload: 3 | off u64 | bytes  -- built in tb through send_frame, copy first
    wr8(addr_io(), 3)
    wr64(addr_io() + 1, off)
    send_frame(T_DATA, 0, id, addr_io(), 9 + got)
    return got
}

fn cmd_pull(id: u64, tp: u64, tl: u64) {
    if !tget_str(tp, tl, s_path(), addr_path(), 600) {
        reply_err(id, s_earg(), s_needpath())
        return
    }
    if !hash_file(addr_path()) {
        reply_err(id, s_enoent(), s_cantopen())
        return
    }
    let size: u64 = g_size
    let crcv: u64 = g_crc
    hexdump(addr_dig(), 32, addr_hex())
    var sha_hex: [u8; 65] = [0 as u8; 65]
    copy_bytes((&sha_hex[0 as usize]) as u64, addr_hex(), 65)
    let fd: u64 = io.open(addr_path(), 0)
    if errno.failed(fd) {
        reply_err(id, s_enoent(), s_cantopen())
        return
    }
    var sent: u64 = tget_num(tp, tl, s_offset(), 0)
    var acked: u64 = sent
    var tries: u64 = 0
    var failed: u64 = 0
    while acked < size && failed == 0 {
        // fill the window
        while sent < size && sent - acked < WINDOW {
            let n: u64 = send_file_chunk(id, fd, sent, size)
            if n == 0 {
                failed = 1
                sent = size
            } else {
                sent = sent + n
            }
        }
        if failed == 0 {
            let f: u64 = wait_frame(2000)
            if f == 0 {
                tries = tries + 1
                if tries > 5 {
                    failed = 2
                } else {
                    sent = acked
                }
            } else {
                let b: u64 = addr_rb()
                let ty: u64 = rd8(b + 5)
                if ty == T_ACK && rd32(b + 8) == id && rd32(b + 12) >= 9 {
                    let nx: u64 = rd64(b + HDRLEN + 1)
                    tries = 0
                    if nx > acked {
                        acked = nx
                    }
                    if nx < sent {
                        sent = nx
                    }
                    if acked > sent {
                        sent = acked
                    }
                } else if ty == T_CANCEL && rd32(b + 8) == id {
                    failed = 3
                } else if ty == T_REQ {
                    failed = 4 // the host is gone and a new session starts: leave its REQ for the main loop
                } else if ty == T_PING {
                    send_frame(T_PONG, 0, rd32(b + 8), b + HDRLEN, rd32(b + 12))
                }
                if failed != 4 {
                    drop_bytes(f)
                }
            }
        }
    }
    io.close(fd)
    if failed == 4 {
        return
    }
    if failed == 2 {
        reply_err(id, s_etimeout(), s_pullwait())
        return
    }
    if failed == 3 {
        reply_err(id, s_ecancel(), s_cancelled())
        return
    }
    if failed != 0 {
        reply_err(id, s_eio(), s_readfail())
        return
    }
    var one: [u8; 1] = [0 as u8; 1]
    one[0 as usize] = 3
    send_frame(T_END, 0, id, (&one[0 as usize]) as u64, 1)
    p_reset()
    p_num(s_size(), size)
    p_str(s_sha256(), (&sha_hex[0 as usize]) as u64)
    p_num(s_crc32(), crcv)
    send_final(T_RESP, id)
}

// ---- ps / logs / power

fn cmd_ps(id: u64, tp: u64, tl: u64) {
    var line: [u8; 160] = [0 as u8; 160]
    var count: u64 = 0
    var i: u64 = 0
    while i < 64 {
        let st: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_STATE, 0)
        if st != 0 && !ulib.bad(st) {
            let l: u64 = (&line[0 as usize]) as u64
            var n: u64 = text.digits(ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PID, 0), l, false)
            wr8(l + n, 9)
            n = n + 1
            n = n + text.digits(ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PPID, 0), l + n, false)
            wr8(l + n, 9)
            n = n + 1
            n = n + text.digits(st, l + n, false)
            wr8(l + n, 9)
            n = n + 1
            n = n + text.digits(ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PAGES, 0) * 4, l + n, false)
            wr8(l + n, 9)
            n = n + 1
            var k: u64 = 0
            while k < 2 {
                let w: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_NAME0 + k, 0)
                var j: u64 = 0
                while j < 8 {
                    let ch: u64 = (w >> (8 * j)) & 255
                    if ch >= 32 && ch < 127 {
                        wr8(l + n, ch)
                        n = n + 1
                    }
                    j = j + 1
                }
                k = k + 1
            }
            wr8(l + n, 10)
            n = n + 1
            send_data(1, l, n, id)
            count = count + 1
        }
        i = i + 1
    }
    send_end(1, id)
    p_reset()
    p_num(s_count(), count)
    send_final(T_RESP, id)
}

fn cmd_kill(id: u64, tp: u64, tl: u64) {
    let pid: u64 = tget_num(tp, tl, s_pid(), 0)
    let sig: u64 = tget_num(tp, tl, s_sig(), 15)
    if pid == 0 {
        reply_err(id, s_earg(), s_needpid())
        return
    }
    let r: u64 = ulib.sys(ulib.SYS_KILL, pid, sig, 0)
    if ulib.bad(r) {
        reply_err(id, s_enoent(), s_nosuchpid())
        return
    }
    p_reset()
    p_num(s_ok(), 1)
    send_final(T_RESP, id)
}

fn klog_count_lines(fd: u64) -> u64 {
    io.seek(fd, 0, 0)
    var lines: u64 = 0
    var going: bool = true
    var total: u64 = 0
    while going {
        let n: u64 = io.read(fd, addr_io(), 8192)
        if errno.failed(n) || n == 0 || total > 4000000 {
            going = false
        } else {
            var i: u64 = 0
            while i < n {
                if rd8(addr_io() + i) == 10 {
                    lines = lines + 1
                }
                i = i + 1
            }
            total = total + n
        }
    }
    return lines
}

fn cmd_logs(id: u64, tp: u64, tl: u64) {
    let fd: u64 = io.open(s_devklog(), 0)
    if errno.failed(fd) {
        reply_err(id, s_enoent(), s_noklog())
        return
    }
    // tail: skip everything but the last `lines` lines (the ring is a few hundred lines, two passes are cheap)
    let want: u64 = tget_num(tp, tl, s_lines(), 200)
    let all: u64 = klog_count_lines(fd)
    var skip: u64 = 0
    if all > want {
        skip = all - want
    }
    io.seek(fd, 0, 0)
    var total: u64 = 0
    var going: bool = true
    var seen: u64 = 0
    while going {
        let n: u64 = io.read(fd, addr_io(), 8192)
        if errno.failed(n) || n == 0 || total > 4000000 {
            going = false
        } else {
            var start: u64 = 0
            if seen < skip {
                var i: u64 = 0
                while i < n && seen < skip {
                    if rd8(addr_io() + i) == 10 {
                        seen = seen + 1
                        start = i + 1
                    }
                    i = i + 1
                }
                if seen < skip {
                    start = n
                }
            }
            if start < n {
                send_data(5, addr_io() + start, n - start, id)
                total = total + (n - start)
            }
        }
    }
    io.close(fd)
    send_end(5, id)
    p_reset()
    p_num(s_bytes(), total)
    p_num(s_lines(), all - skip)
    send_final(T_RESP, id)
}

// ---- power

fn cmd_power(id: u64, tp: u64, tl: u64, reboot: bool) {
    p_reset()
    p_num(s_ok(), 1)
    send_final(T_RESP, id)
    ulib.sleep_ms(200)
    let kid: u64 = proc.split()
    if kid == 0 {
        var argv: [u64; 3] = [0 as u64; 3]
        if reboot {
            argv[0 as usize] = s_binreboot()
            argv[1 as usize] = s_dashf()
            ulib.sys(59, s_binreboot(), (&argv[0 as usize]) as u64, 0)
        } else {
            argv[0 as usize] = s_binshutdown()
            argv[1 as usize] = 0
            ulib.sys(59, s_binshutdown(), (&argv[0 as usize]) as u64, 0)
        }
        proc.leave(127)
    }
}

// ------------------------------------------------------------ dispatch

fn allowed(name: u64) -> bool {
    return true
}

fn handle_req(id: u64, flags: u64, n: u64) {
    // payload copy: nested receives would overwrite rb
    let b: u64 = addr_rb()
    let plen: u64 = rd32(b + 12)
    if plen > REQMAX || plen < 1 {
        reply_err(id, s_elimit(), s_toobig())
        return
    }
    copy_bytes(addr_req(), b + HDRLEN, plen)
    drop_bytes(n)
    let q: u64 = addr_req()
    let cl: u64 = rd8(q)
    if 1 + cl > plen {
        reply_err(id, s_eproto(), s_badreq())
        return
    }
    let tp: u64 = q + 1 + cl
    let tl: u64 = plen - 1 - cl
    let cmd: u64 = q + 1
    if id == lastid && (flags & F_RETRY) != 0 {
        // idempotent retry: answer from the cache, never run twice
        send_frame(lasttype, 0, id, (&lastbuf[0 as usize]) as u64, lastlen)
        return
    }
    if same_str(cmd, cl, s_hello()) {
        cmd_hello(id, tp, tl)
    } else if same_str(cmd, cl, s_auth_cmd()) {
        cmd_auth(id, tp, tl)
    } else if same_str(cmd, cl, s_ping()) {
        p_reset()
        p_num(s_ok(), 1)
        send_final(T_RESP, id)
    } else if authed == 0 {
        reply_err(id, s_eauth(), s_notauth())
    } else if same_str(cmd, cl, s_info()) {
        cmd_info(id, tp, tl)
    } else if same_str(cmd, cl, s_exec()) {
        cmd_exec(id, tp, tl)
    } else if same_str(cmd, cl, s_push()) {
        cmd_push(id, tp, tl)
    } else if same_str(cmd, cl, s_pull()) {
        cmd_pull(id, tp, tl)
    } else if same_str(cmd, cl, s_ps()) {
        cmd_ps(id, tp, tl)
    } else if same_str(cmd, cl, s_kill()) {
        cmd_kill(id, tp, tl)
    } else if same_str(cmd, cl, s_logs()) {
        cmd_logs(id, tp, tl)
    } else if same_str(cmd, cl, s_reboot()) {
        cmd_power(id, tp, tl, true)
    } else if same_str(cmd, cl, s_shutdown()) {
        cmd_power(id, tp, tl, false)
    } else {
        reply_err(id, s_eunsup(), s_unknowncmd())
    }
}

fn u_start(args: u64) -> u64 {
    crc_init()
    if !conf_enabled() {
        ulib.say(s_disabled())
        ulib.nl()
        return 0
    }
    dev = io.open(s_devodb(), 2)
    if errno.failed(dev) {
        ulib.say(s_nodev())
        ulib.nl()
        return 1
    }
    load_token()
    ulib.say(s_ready())
    ulib.nl()
    var idle: u64 = 0
    while true {
        let n: u64 = have_frame()
        if n == 0 {
            let got: u64 = fill()
            if got == 0 {
                stale_check()
                idle = idle + 1
                if mono_ms() -% g_last_rx > QUIET_MS && rlen == 0 {
                    // Nothing for QUIET_MS: poll slowly so the agent costs next to no CPU. The host sends a wake
                    // preamble (zero octets + pause) before a frame after silence, see docs/ODB.md.
                    ulib.sleep_ms(SLEEPY_MS)
                } else if idle > 200 {
                    ulib.sys(ulib.SYS_YIELD, 0, 0, 0)
                    idle = 0
                }
            } else {
                idle = 0
            }
        } else {
            let b: u64 = addr_rb()
            let ty: u64 = rd8(b + 5)
            let id: u64 = rd32(b + 8)
            let fl: u64 = rd16(b + 6)
            if ty == T_REQ {
                handle_req(id, fl, n)
                g_last_rx = mono_ms()
            } else if ty == T_PING {
                send_frame(T_PONG, 0, id, b + HDRLEN, rd32(b + 12))
                drop_bytes(n)
            } else if ty == T_PONG || ty == T_DATA || ty == T_END || ty == T_ACK || ty == T_CANCEL {
                drop_bytes(n)
            } else {
                reply_err(id, s_eunsup(), s_unknowntype())
                drop_bytes(n)
            }
        }
    }
    return 0
}
