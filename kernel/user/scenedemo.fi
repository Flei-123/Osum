// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/scenedemo.fi -- the smallest program on fUi's scene tree
// (FUI-ALL F-1): a label, a button that counts, a second label.
profile app

import ulib
import wlib
import fuiapp
import fuiscene
import fui.scene

export { u_start }

static mut t_title: [u8; 12] = "Szenenbaum\0\0"
static mut t_head: [u8; 16] = "Klicks zaehlen:\0"
static mut t_btn: [u8; 8] = "Klick!\0\0"
static mut t_cnt: [u8; 16] = "Klicks: 0\0\0\0\0\0\0\0"
static mut n: u64 = 0
static mut t_dbg0: [u8; 16] = "scene: start\0\0\0\0"
static mut t_dbg: [u8; 16] = "scene: nodes=\0\0\0"
static mut t_dbg2: [u8; 16] = "scene: paints=\0\0"
static mut t_dbg3: [u8; 4] = " x \0"

fn say(p: u64) {
    let _r: u64 = ulib.say(p)
}

fn u_start(args: u64) -> u64 {
    let _s0: u64 = ulib.say((&t_dbg0[0 as usize]) as u64)
    ulib.nl()
    let _s6: u64 = ulib.say((&t_dbg3[0 as usize]) as u64)
    ulib.sayn((scene.node_widget(fuiscene.scene_ptr(), 1) as u64) - (scene.node_widget(fuiscene.scene_ptr(), 0) as u64))
    ulib.nl()
    if !fuiscene.open(60, 60, 320, 200, (&t_title[0 as usize]) as u64) {
        say((&t_head[0 as usize]) as u64)
        return 1
    }
    let _s5: u64 = ulib.say((&t_dbg0[0 as usize]) as u64)
    ulib.nl()
    let col: usize = fuiscene.root()
    let l1: usize = fuiscene.label(col, (&t_head[0 as usize]) as u64)
    let b: usize = fuiscene.button(col, (&t_btn[0 as usize]) as u64)
    let l2: usize = fuiscene.label(col, (&t_cnt[0 as usize]) as u64)
    let _s1: u64 = ulib.say((&t_dbg[0 as usize]) as u64)
    ulib.sayn(fuiscene.node_count() as u64)
    ulib.nl()
    var first: bool = true
    while fuiscene.alive() {
        let hit: usize = fuiscene.pump()
        if first {
            first = false
            let _s2: u64 = ulib.say((&t_dbg2[0 as usize]) as u64)
            ulib.sayn(fuiscene.painted())
            let _s3: u64 = ulib.say((&t_dbg3[0 as usize]) as u64)
            ulib.sayn(fuiscene.node_w(b))
            let _s4: u64 = ulib.say((&t_dbg3[0 as usize]) as u64)
            ulib.sayn(fuiscene.node_h(b))
            ulib.nl()
        }
        if hit == b {
            n = n + 1
            t_cnt[8 as usize] = (48 + n % 10) as u8
            fuiscene.set_text(l2, (&t_cnt[0 as usize]) as u64)
        }
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
