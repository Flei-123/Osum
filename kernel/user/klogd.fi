profile kernel

import ulib
import libc.kcall
import libc.clockapi

export { u_start }

const POLL_MS: u64 = 250
const SAVE_EVERY_POLLS: u64 = 4
const FLUSH_EVERY_POLLS: u64 = 20

fn u_start(args: u64) -> u64 {
    var seen_warns: u64 = kcall.sys4(ulib.SYS_KLOG, ulib.KL_WARNS, 0, 0, 0)
    var tick: u64 = 0
    kcall.sys4(ulib.SYS_KLOG, ulib.KL_SAVE, 1, 0, 0)
    while true {
        clockapi.sleep_ms(POLL_MS)
        tick = tick + 1
        let warns: u64 = kcall.sys4(ulib.SYS_KLOG, ulib.KL_WARNS, 0, 0, 0)
        if warns != seen_warns {
            seen_warns = warns
            kcall.sys4(ulib.SYS_KLOG, ulib.KL_SAVE, 1, 0, 0)
        } else if tick % FLUSH_EVERY_POLLS == 0 {
            kcall.sys4(ulib.SYS_KLOG, ulib.KL_SAVE, 1, 0, 0)
        } else if tick % SAVE_EVERY_POLLS == 0 {
            kcall.sys4(ulib.SYS_KLOG, ulib.KL_SAVE, 0, 0, 0)
        }
    }
    return 0
}
