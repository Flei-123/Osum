// kernel/user/wget.fi -- round K8: a page over HTTP, from ring 3.
//
// The twenty-fifth program on the disk, and the one that puts the whole
// round in one line: a process opens a TCP connection to a machine that
// is not this one, writes a request, reads the answer and prints it.
// Between that program and the wire lie the socket calls of round K8,
// the POSIX layer of round K4, the TCP state machine of round K3, the
// virtio ring of round K8 and the PCI scan of round K2 -- and every one
// of them has to be right for a single octet to come out.
//
//     wget [-q] [-O file] http://a.b.c.d[:port]/path
//     wget [-q] a.b.c.d [port] [path]
//
// `-q` prints only the status line and the number of octets of the body;
// `-O` writes the body to a file instead of to the output.
//
// THERE IS NO NAME RESOLUTION IN THIS SYSTEM. Osum has no resolver, no
// `/etc/resolv.conf` and no UDP client for port 53. An address is four
// numbers, and a URL with a name in it is REFUSED with a clear sentence
// rather than answered with something wrong. That is a missing piece and
// it is named here instead of hidden.
//
// HTTP/1.0 AND `Connection: close`, on purpose: the end of the body is
// then the end of the connection, and this program needs neither
// `Content-Length` nor chunked transfer encoding to know when it is
// done. What it does parse is the status line, because that is the one
// thing a caller has to be able to check.

profile kernel

import ulib
import libc.net

export { u_start }

const CAP: u64 = 2048

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 47] = "usage: wget [-q] [-O file] http://a.b.c.d/path\0"
    var s_name: [u8; 56] = "wget: no name resolution in this system, use an address\0"
    var s_nosock: [u8; 25] = "wget: no socket, errno \0\0"
    var s_noconn: [u8; 24] = "wget: cannot connect: \0\0"
    var s_conn: [u8; 22] = "wget: connected to \0\0\0"
    var s_colon: [u8; 2] = ":\0"
    var s_body: [u8; 14] = "wget: octets \0"
    var s_status: [u8; 14] = "wget: status \0"
    var s_nofile: [u8; 24] = "wget: cannot write to \0\0"
    var s_q: [u8; 3] = "-q\0"
    var s_o: [u8; 3] = "-O\0"
    var s_scheme: [u8; 8] = "http://\0"
    var host: [u8; 32] = [0 as u8; 32]
    var path: [u8; 128] = [0 as u8; 128]
    var req: [u8; 256] = [0 as u8; 256]
    var buf: [u8; 2048] = [0 as u8; 2048]
    var addr: [u8; 24] = [0 as u8; 24]

    var quiet: bool = false
    var outname: u64 = 0
    var url: u64 = 0
    var extra1: u64 = 0
    var extra2: u64 = 0
    let argc: u64 = ulib.arg_count(args)
    var i: u64 = 1
    while i < argc {
        let a: u64 = ulib.arg_at(args, i)
        if ulib.streq(a, (&s_q[0]) as u64) {
            quiet = true
            i = i + 1
        } else if ulib.streq(a, (&s_o[0]) as u64) && i + 1 < argc {
            outname = ulib.arg_at(args, i + 1)
            i = i + 2
        } else if url == 0 {
            url = a
            i = i + 1
        } else if extra1 == 0 {
            extra1 = a
            i = i + 1
        } else {
            extra2 = a
            i = i + 1
        }
    }
    if url == 0 {
        ulib.esay_line((&s_use[0]) as u64, 0)
        return 1
    }

    // Either `http://host[:port]/path` or the three parts one by one.
    var at: u64 = url
    if starts(url, (&s_scheme[0]) as u64, 7) {
        at = url + 7
    }
    var port: u64 = 80
    var n: u64 = 0
    while ulib.length(at) > n && !is_one_of(byte_at(at, n), 58, 47) {
        if n < 31 {
            host[n as usize] = byte_at(at, n) as u8
        }
        n = n + 1
    }
    host[31] = 0 as u8
    if n < 31 {
        host[n as usize] = 0 as u8
    }
    if byte_at(at, n) == 58 {
        n = n + 1
        port = 0
        while byte_at(at, n) >= 48 && byte_at(at, n) <= 57 {
            port = port * 10 + (byte_at(at, n) - 48)
            n = n + 1
        }
    }
    var pn: u64 = 0
    while byte_at(at, n) != 0 && pn < 126 {
        path[pn as usize] = byte_at(at, n) as u8
        pn = pn + 1
        n = n + 1
    }
    if pn == 0 {
        path[0] = 47 as u8 // '/'
        pn = 1
    }
    path[pn as usize] = 0 as u8

    // The two-and-three-argument form: `wget 10.9.0.1 8000 /x`.
    if extra1 != 0 {
        port = ulib.to_num(extra1)
    }
    if extra2 != 0 {
        pn = 0
        while byte_at(extra2, pn) != 0 && pn < 126 {
            path[pn as usize] = byte_at(extra2, pn) as u8
            pn = pn + 1
        }
        path[pn as usize] = 0 as u8
    }

    let peer: u64 = net.parse_ip((&host[0]) as u64)
    if peer == 0 {
        ulib.esay_line((&s_name[0]) as u64, 0)
        return 1
    }

    let fd: u64 = net.tcp_socket()
    if ulib.bad(fd) {
        ulib.say((&s_nosock[0]) as u64)
        ulib.sayn(fd)
        ulib.nl()
        return 1
    }
    let c: u64 = net.connect_to(fd, peer, port)
    if ulib.bad(c) {
        ulib.say((&s_noconn[0]) as u64)
        ulib.sayn(c)
        ulib.nl()
        net.close(fd)
        return 1
    }
    if !quiet {
        ulib.say((&s_conn[0]) as u64)
        ulib.put((&addr[0]) as u64, net.ip_text(peer, (&addr[0]) as u64))
        ulib.say((&s_colon[0]) as u64)
        ulib.sayu(port)
        ulib.nl()
    }

    // GET <path> HTTP/1.0\r\nHost: <host>\r\nConnection: close\r\n\r\n
    var rn: u64 = 0
    rn = add_text(&req[0], rn, 71) // G
    rn = add_text(&req[0], rn, 69) // E
    rn = add_text(&req[0], rn, 84) // T
    rn = add_text(&req[0], rn, 32)
    rn = add_str(&req[0], rn, (&path[0]) as u64)
    var s_ver: [u8; 12] = " HTTP/1.0\r\n\0"
    var s_host: [u8; 7] = "Host: \0"
    var s_end: [u8; 25] = "\r\nConnection: close\r\n\r\n\0\0"
    rn = add_str(&req[0], rn, (&s_ver[0]) as u64)
    rn = add_str(&req[0], rn, (&s_host[0]) as u64)
    rn = add_str(&req[0], rn, (&host[0]) as u64)
    rn = add_str(&req[0], rn, (&s_end[0]) as u64)
    let w: u64 = net.send_all(fd, (&req[0]) as u64, rn)
    if ulib.bad(w) {
        net.close(fd)
        return 1
    }

    var out: u64 = ulib.OUT
    if outname != 0 {
        out = ulib.sys(ulib.SYS_OPEN, outname, ulib.O_MAKE, 0)
        if ulib.bad(out) {
            ulib.esay_line((&s_nofile[0]) as u64, outname)
            net.close(fd)
            return 1
        }
    }

    // Read to the end of the connection. The header is separated from
    // the body by an empty line, and the split is done on the fly so
    // that nothing has to be held in memory that a program with 2 KiB of
    // buffer cannot hold.
    var total: u64 = 0
    var body: u64 = 0
    var head_done: bool = false
    var nl_run: u64 = 0
    var status: u64 = 0
    var status_seen: bool = false
    var status_pos: u64 = 0
    var going: bool = true
    while going {
        let r: u64 = net.recv_some(fd, (&buf[0]) as u64, CAP)
        if ulib.bad(r) || r == 0 {
            going = false
        } else {
            total = total + r
            var k: u64 = 0
            while k < r {
                let ch: u64 = buf[k as usize] as u64
                if !head_done {
                    // "HTTP/1.1 200 OK" -- the three digits after the
                    // first blank are the only part a caller can act on.
                    if !status_seen {
                        if ch == 32 {
                            status_pos = status_pos + 1
                        } else if status_pos == 1 && ch >= 48 && ch <= 57 {
                            status = status * 10 + (ch - 48)
                            if status >= 100 {
                                status_seen = true
                            }
                        }
                    }
                    if ch == 10 {
                        nl_run = nl_run + 1
                        if nl_run >= 2 {
                            head_done = true
                        }
                    } else if ch != 13 {
                        nl_run = 0
                    }
                } else {
                    body = body + 1
                    if out != 0 || !quiet {
                        ulib.sys(ulib.SYS_WRITE, out,
                            (&buf[k as usize]) as u64, 1)
                    }
                }
                k = k + 1
            }
        }
    }
    if outname != 0 {
        ulib.sys(ulib.SYS_CLOSE, out, 0, 0)
    }
    net.close(fd)
    ulib.say((&s_status[0]) as u64)
    ulib.sayu(status)
    ulib.nl()
    ulib.say((&s_body[0]) as u64)
    ulib.sayu(body)
    ulib.nl()
    if status >= 200 && status < 400 {
        return 0
    }
    return 1
}

fn byte_at(p: u64, i: u64) -> u64 {
    return (*((p + i) as *mut u8)) as u64
}

fn is_one_of(c: u64, a: u64, b: u64) -> bool {
    return c == a || c == b || c == 0
}

fn starts(p: u64, q: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if byte_at(p, i) != byte_at(q, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn add_text(dst: *mut u8, at: u64, c: u64) -> u64 {
    __mmio_write8(((dst as u64) + at) as *mut u8, (c & 0xFF) as u8)
    return at + 1
}

fn add_str(dst: *mut u8, at: u64, src: u64) -> u64 {
    var i: u64 = 0
    var n: u64 = at
    while byte_at(src, i) != 0 {
        __mmio_write8(((dst as u64) + n) as *mut u8, byte_at(src, i) as u8)
        n = n + 1
        i = i + 1
    }
    return n
}
