profile kernel

import ulib

export { put, put_n }

fn put(d: u64, at: u64, s: u64) -> u64 {
    let n: u64 = ulib.length(s)
    var i: u64 = 0
    while i < n {
        *((d + at + i) as *mut u8) = *((s + i) as *mut u8)
        i = i + 1
    }
    *((d + at + n) as *mut u8) = 0 as u8
    return at + n
}

fn put_n(d: u64, at: u64, v: u64) -> u64 {
    let n: u64 = ulib.digits(v, d + at)
    *((d + at + n) as *mut u8) = 0 as u8
    return at + n
}
