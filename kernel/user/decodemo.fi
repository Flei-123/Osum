profile app

import fuiapp.hostwinp
import ulib
import lineout
import fuiapp
import fuiscene
import wlibc

export { u_start }

static mut t_title: [u8; 10] = "Deco demo\0"
static mut t_label: [u8; 12] = "Frame check\0"
static mut t_ready: [u8; 16] = "decodemo: ready\0"
static mut t_bare: [u8; 15] = "decodemo: bare\0"
static mut t_win: [u8; 17] = "decodemo: win x=\0"
static mut t_y: [u8; 4] = " y=\0"
static mut t_inx: [u8; 6] = " inx=\0"
static mut t_iny: [u8; 6] = " iny=\0"
static mut t_done: [u8; 15] = "decodemo: done\0"

static mut APP_BUNDLE_NAME: [u8; 9] = "decodemo\0"

fn say(p: u64) {
    let _r: u64 = lineout.add_text(p)
}

fn mark(label: u64) {
    say(label)
    lineout.end_line()
}

fn build() {
    let col: usize = fuiscene.root()
    let _l: usize = fuiscene.label(col, (&t_label[0 as usize]) as u64)
}

fn hold(ms: u64) {
    let t0: u64 = fuiapp.now_ms()
    while fuiscene.alive() && fuiapp.now_ms() < t0 + ms {
        let _k: u64 = fuiscene.pump()
    }
}

fn report_geometry() {
    let h: u64 = fuiscene.handle()
    say((&t_win[0 as usize]) as u64)
    lineout.add_num(wlibc.win_info(h, hostwinp.WI_X))
    say((&t_y[0 as usize]) as u64)
    lineout.add_num(wlibc.win_info(h, hostwinp.WI_Y))
    say((&t_inx[0 as usize]) as u64)
    lineout.add_num(wlibc.win_info(h, hostwinp.WI_INX))
    say((&t_iny[0 as usize]) as u64)
    lineout.add_num(wlibc.win_info(h, hostwinp.WI_INY))
    lineout.end_line()
    fuiscene.say_texts()
}

fn u_start(args: u64) -> u64 {
    if !fuiscene.open(60, 60, 420, 260, (&t_title[0 as usize]) as u64, build) {
        return 1
    }
    fuiscene.set_app((&APP_BUNDLE_NAME[0 as usize]) as u64)
    hold(1500)
    mark((&t_ready[0 as usize]) as u64)
    report_geometry()
    let _d: u64 = wlibc.win_state(fuiscene.handle(), hostwinp.WS_DECO, 0)
    hold(500)
    fuiscene.refresh()
    hold(1500)
    mark((&t_bare[0 as usize]) as u64)
    report_geometry()
    fuiscene.refresh()
    hold(1500)
    mark((&t_done[0 as usize]) as u64)
    fuiscene.quit()
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
