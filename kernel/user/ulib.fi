const IN: u64 = 0
const OUT: u64 = 1
const ERR: u64 = 2

fn sys(number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    return kcall.sys3(number, a0, a1, a2)
}

fn say(p: u64) -> u64 {
    return io.write_text(OUT, p)
}

fn put(p: u64, n: u64) -> u64 {
    return io.write_all(OUT, p, n)
}

fn nl() {
    var s: [u8; 2] = "\n\0"
    say((&s[0]) as u64)
}

fn sayn(v: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    let n: u64 = text.digits(v, (&buf[0]) as u64, true)
    put((&buf[0]) as u64, n)
}

fn sayu(v: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    let n: u64 = text.digits(v, (&buf[0]) as u64, false)
    put((&buf[0]) as u64, n)
}

fn say_line(p: u64, v: u64) {
    say(p)
    sayn(v)
    nl()
}

fn streq(a: u64, b: u64) -> bool {
    return text.equal(a, b)
}

fn word(line: u64, at: u64, out: u64, max: u64) -> u64 {
    var i: u64 = at
    while *((line + i) as *mut u8) == 32 as u8 {
        i = i + 1
    }
    var n: u64 = 0
    while *((line + i) as *mut u8) != 0 as u8 {
        if *((line + i) as *mut u8) == 32 as u8 {
            __mmio_write8((out + n) as *mut u8, 0 as u8)
            return i
        }
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, *((line + i) as *mut u8))
            n = n + 1
        }
        i = i + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return i
}

fn arg_count(args: u64) -> u64 {
    if args == 0 {
        return 0
    }
    return *((args) as *mut u64)
}

fn arg_at(args: u64, i: u64) -> u64 {
    if i >= arg_count(args) {
        return 0
    }
    return *((args + 8 + i * 8) as *mut u64)
}

fn spawn_user(path: u64, argv: u64, argc: u64) -> u64 {
    let r: u64 = sys(SYS_EXECAS, path, argv, argc)
    if errno.is_error(r) && errno.negated(r) == errno.E_NOSYS {
        return sys(SYS_EXEC, path, argv, argc)
    }
    return r
}

fn spawn_priv(path: u64, argv: u64, argc: u64) -> u64 {
    let r: u64 = sys(SYS_EXECAS, path, argv, argc + 65536)
    if errno.is_error(r) && errno.negated(r) == errno.E_NOSYS {
        return sys(SYS_EXEC, path, argv, argc)
    }
    return r
}

const SYS_SESSION_OP2: u64 = 1870

fn session_owner() -> u64 {
    let r: u64 = sys(SYS_SESSION_OP2, 8, 0, 0)
    if errno.is_error(r) {
        return 0
    }
    return r
}

fn app_token(path: u64, out: u64) -> bool {
    var start: u64 = 0
    var apps: [u8; 7] = "/apps/\0"
    var bin: [u8; 6] = "/bin/\0"
    var k: u64 = 0
    var is_apps: bool = true
    var is_bin: bool = true
    while k < 6 {
        if *((path + k) as *mut u8) != apps[(k) as usize] {
            is_apps = false
        }
        k = k + 1
    }
    k = 0
    while k < 5 {
        if *((path + k) as *mut u8) != bin[(k) as usize] {
            is_bin = false
        }
        k = k + 1
    }
    if is_apps {
        start = 6
    } else if is_bin {
        start = 5
    } else {
        return false
    }
    var n: u64 = 0
    while n < 31 {
        let c: u8 = *((path + start + n) as *mut u8)
        if c == 0 as u8 || c == 46 as u8 || c == 47 as u8 {
            break
        }
        __mmio_write8((out + n) as *mut u8, c)
        n = n + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return n > 0
}

fn needs_root(path: u64) -> bool {
    var tok: [u8; 32] = [0 as u8; 32]
    var n0: [u8; 9] = "settings\0"
    var n1: [u8; 10] = "installer\0"
    var n4: [u8; 8] = "diskctl\0"
    var n5: [u8; 7] = "drvctl\0"
    if !app_token(path, (&tok[0 as usize]) as u64) {
        return false
    }
    let t: u64 = (&tok[0 as usize]) as u64
    return streq(t, (&n1[0 as usize]) as u64)
        || streq(t, (&n4[0 as usize]) as u64) || streq(t, (&n5[0 as usize]) as u64)
}

fn spawn_app(path: u64, argv: u64, argc: u64) -> u64 {
    if session_owner() == 0 || !needs_root(path) {
        return spawn_user(path, argv, argc)
    }
    var el: [u8; 13] = "/bin/elevate\0"
    var av: [u64; 8] = [0 as u64; 8]
    av[0 as usize] = (&el[0 as usize]) as u64
    av[1 as usize] = path
    var n: u64 = 2
    var i: u64 = 1
    while i < argc && n < 8 {
        av[(n) as usize] = *((argv + i * 8) as *mut u64)
        n = n + 1
        i = i + 1
    }
    return spawn_priv((&el[0 as usize]) as u64, (&av[0 as usize]) as u64, n)
}

fn mem_total_frames() -> u64 {
    let usable: u64 = sys(SYS_SYSINFO, I_MEM_USABLE, 0, 0)
    if usable == 0 || bad(usable) {
        return sys(SYS_SYSINFO, I_FRAMES_ALL, 0, 0)
    }
    return usable
}

fn bad(v: u64) -> bool {
    return errno.is_error(v)
}

fn eput(p: u64) -> u64 {
    return io.write_text(ERR, p)
}

fn esay_line(p: u64, q: u64) {
    eput(p)
    if q != 0 {
        eput(q)
    }
    var nlc: [u8; 2] = "\n\0"
    eput((&nlc[0]) as u64)
}

fn strcpy(dst: u64, src: u64) -> u64 {
    let n: u64 = text.length(src)
    memcopy.copy(dst, src, n)
    __mmio_write8((dst + n) as *mut u8, 0 as u8)
    return n
}

fn strncpy(dst: u64, src: u64, max: u64) -> u64 {
    var n: u64 = 0
    if src == 0 {
        __mmio_write8(dst as *mut u8, 0 as u8)
        return 0
    }
    while n + 1 < max && *((src + n) as *mut u8) != 0 as u8 {
        __mmio_write8((dst + n) as *mut u8, *((src + n) as *mut u8))
        n = n + 1
    }
    __mmio_write8((dst + n) as *mut u8, 0 as u8)
    return n
}

fn strcat(dst: u64, src: u64) -> u64 {
    let at: u64 = text.length(dst)
    return at + strcpy(dst + at, src)
}

fn strneq(a: u64, b: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        let x: u64 = (*((a + i) as *mut u8)) as u64
        if x != (*((b + i) as *mut u8)) as u64 {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return true
}

fn find(hay: u64, needle: u64) -> u64 {
    let n: u64 = text.length(needle)
    let h: u64 = text.length(hay)
    if n == 0 {
        return 0
    }
    if n > h {
        return EOF
    }
    var i: u64 = 0
    while i + n <= h {
        if strneq(hay + i, needle, n) {
            return i
        }
        i = i + 1
    }
    return EOF
}

fn to_num(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while *((p + i) as *mut u8) >= 48 as u8 && *((p + i) as *mut u8) <= 57 as u8 {
        if v < 1000000000000000000 {
            v = v * 10 + ((*((p + i) as *mut u8)) as u64 - 48)
        }
        i = i + 1
    }
    return v
}

fn cmp(a: u64, b: u64) -> u64 {
    var i: u64 = 0
    while i < 4096 {
        let x: u64 = (*((a + i) as *mut u8)) as u64
        let y: u64 = (*((b + i) as *mut u8)) as u64
        if x != y {
            if x < y {
                return 1
            }
            return 2
        }
        if x == 0 {
            return 0
        }
        i = i + 1
    }
    return 0
}

fn pad(v: u64, w: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    let n: u64 = text.digits(v, (&buf[0]) as u64, true)
    var sp: [u8; 2] = " \0"
    var i: u64 = n
    while i < w {
        say((&sp[0]) as u64)
        i = i + 1
    }
    put((&buf[0]) as u64, n)
}

fn is_dir(path: u64) -> bool {
    let m: u64 = io.stat_mode(path)
    if errno.failed(m) {
        return false
    }
    return io.is_dir_mode(m)
}

fn ignore_children() {
    var sa: [u64; 4] = [0 as u64; 4]
    sa[0] = 1
    let _r: u64 = kcall.sys4(13, 17, (&sa[0]) as u64, 0, 8)
}

fn wait_code(pid: u64) -> u64 {
    var status: [u64; 1] = [0 as u64; 1]
    let r: u64 = errno.check(kcall.sys4(60 + 1, pid, (&status[0]) as u64,
            0, 0))
    if errno.failed(r) {
        return r
    }
    return (status[0] >> 8) & 255
}

const RD_SIZE: u64 = 528

fn rd_init(ctx: u64) {
    __mmio_write64((ctx) as *mut u64, 0)
    __mmio_write64((ctx + 8) as *mut u64, 0)
}

fn rd_byte(fd: u64, ctx: u64) -> u64 {
    var len: u64 = *((ctx) as *mut u64)
    var pos: u64 = *((ctx + 8) as *mut u64)
    if pos >= len {
        let n: u64 = io.read(fd, ctx + 16, 512)
        if n == 0 || errno.failed(n) {
            return 256
        }
        __mmio_write64((ctx) as *mut u64, n)
        __mmio_write64((ctx + 8) as *mut u64, 0)
        len = n
        pos = 0
    }
    let c: u64 = (*((ctx + 16 + pos) as *mut u8)) as u64
    __mmio_write64((ctx + 8) as *mut u64, pos + 1)
    return c
}

fn rd_line(fd: u64, ctx: u64, out: u64, max: u64) -> u64 {
    var c: u64 = rd_byte(fd, ctx)
    if c == 256 {
        return EOF
    }
    var n: u64 = 0
    while c != 256 && c != 10 {
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, c as u8)
            n = n + 1
        }
        c = rd_byte(fd, ctx)
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return n
}

fn env_count(args: u64) -> u64 {
    if args == 0 {
        return 0
    }
    return *((args + ENV_OFF) as *mut u64)
}

fn env_at(args: u64, i: u64) -> u64 {
    if i >= env_count(args) {
        return 0
    }
    return *((args + ENV_OFF + 8 + i * 8) as *mut u64)
}

fn env_get(args: u64, name: u64) -> u64 {
    let n: u64 = text.length(name)
    var i: u64 = 0
    while i < env_count(args) {
        let e: u64 = env_at(args, i)
        if strneq(e, name, n) && *((e + n) as *mut u8) == 61 as u8 {
            return e + n + 1
        }
        i = i + 1
    }
    return 0
}

fn set_env(buf: u64, len: u64) -> u64 {
    return sys(SYS_SETENV, buf, len, 0)
}

const SYS_BUS: u64 = 1960

const BT_TEXT: u64 = 1
const BT_PATH: u64 = 2
const BT_HTML: u64 = 4
const BT_IMAGE: u64 = 8
const BT_FILES: u64 = 16

fn bus5(op: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    return xfer.bus5(op, a1, a2, a3, a4)
}

fn bus_da() -> bool {
    return xfer.available()
}

fn clip_put(typen: u64, p: u64, n: u64) -> u64 {
    let r: u64 = xfer.set(xfer.SEL_CLIPBOARD, typen, p, n)
    if bad(r) {
        return r
    }
    return 0
}

const CLIP_AGAIN: u64 = 0xFFFFFFFFFFFFFFFA
const LAZY_POLLS: u64 = 40
const LAZY_POLL_MS: u64 = 10

fn clip_offer(typen: u64) -> u64 {
    return xfer.offer(xfer.SEL_CLIPBOARD, typen)
}

fn clip_fill(p: u64, n: u64) -> u64 {
    let r: u64 = xfer.fill(xfer.SEL_CLIPBOARD, 1 << xfer.mime_index(xfer.types(xfer.SEL_CLIPBOARD, 0)), p, n)
    if bad(r) {
        return r
    }
    return 0
}

fn clip_pending() -> bool {
    return (xfer.flags(xfer.SEL_CLIPBOARD, 0) & 1) != 0
}

fn clip_wanted() -> bool {
    return (xfer.flags(xfer.SEL_CLIPBOARD, 0) & 3) == 3
}

fn clip_take(p: u64, max: u64) -> u64 {
    return clip_hist_take(0, p, max)
}

fn clip_hist_take(back: u64, p: u64, max: u64) -> u64 {
    let n: u64 = xfer.get_text(xfer.SEL_CLIPBOARD, back, p, max)
    if bad(n) {
        return 0
    }
    if n > max {
        return max
    }
    return n
}

fn clip_count() -> u64 {
    return xfer.count(xfer.SEL_CLIPBOARD)
}

fn clip_typ(back: u64) -> u64 {
    return xfer.types(xfer.SEL_CLIPBOARD, back)
}

fn clip_owner(back: u64) -> u64 {
    return xfer.owner(xfer.SEL_CLIPBOARD, back)
}

fn drag_take(p: u64, max: u64) -> u64 {
    let mime: u64 = xfer.negotiate(xfer.SEL_DRAG, 0, 0xFFFFFFFFFFFFFFFF)
    if mime == 0 {
        return 0
    }
    let n: u64 = xfer.drag_get(mime, p, max)
    if bad(n) {
        return 0
    }
    if n > max {
        return max
    }
    return n
}

fn drag_type_path() -> u64 {
    return xfer.drag_types() & BT_PATH
}

fn drag_an() -> bool {
    return xfer.drag_active()
}

fn drag_drop() -> u64 {
    return xfer.drag_end()
}

fn noti_post(dringlich: u64, p: u64, n: u64) -> u64 {
    return bus5(19, dringlich, p, n, 0)
}

fn noti_count() -> u64 {
    let n: u64 = bus5(21, 0, 0, 0, 0)
    if bad(n) {
        return 0
    }
    return n
}

fn noti_new() -> u64 {
    let n: u64 = bus5(21, 1, 0, 0, 0)
    if bad(n) {
        return 0
    }
    return n
}

fn noti_take(back: u64, p: u64, max: u64) -> u64 {
    let n: u64 = bus5(20, back, p, max, 0)
    if bad(n) {
        return 0
    }
    return n
}
