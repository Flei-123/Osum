// SPDX-License-Identifier: GPL-2.0-only
// _dev_plugreg.fi -- ZEITWEILIGER STUMMEL DES MODULS `verwaltung`,
// gehoert NICHT zur Auslieferung und wird am Ende der Runde geloescht.
//
// Wofuer er da ist: /bin/wmplug soll an einem WIRKLICH angemeldeten
// Plugin gemessen werden (list/info/enable/disable), und die beiden
// echten Plugins dieser Runde gehoeren anderen Modulen. Dieser Stummel
// meldet sich an, bleibt eine Weile stehen und sagt bei jedem Takt, was
// der Kern ueber SEINE Rechte denkt -- so laesst sich nachrechnen, dass
// `wmplug enable`/`disable` wirklich am Zustand wirkt und nicht nur
// einen Rueckgabewert erzeugt.
//
// DER NAME STEHT IN EINEM PUFFER VON SECHZEHN OKTETTEN, und das ist der
// Punkt: WM_PLUG_REG kopiert fuenfzehn Oktette, egal wie kurz der Name
// ist. Wer hier ein `[u8; 4]` hinlegt, schickt seinen halben Stapel als
// Namen mit.

profile kernel

import ulib

export { u_start }

const WM_PLUG_REG: u64 = 2117
const WM_PLUG_INFO: u64 = 2121
const PL_RIGHTS: u64 = 5
const WMP_ABI: u64 = 1

fn u_start(args: u64) -> u64 {
    var name: [u8; 16] = [0 as u8; 16]
    var s_nm: [u8; 4] = "uhr\0"
    var s_reg: [u8; 25] = "devreg: angemeldet platz\0"
    var s_re: [u8; 10] = " rechte=\0\0"
    var s_no: [u8; 24] = "devreg: kein Platz: rc=\0"
    let p: u64 = (&name[0 as usize]) as u64
    ulib.fill(p, 0, 16)
    ulib.strncpy(p, (&s_nm[0 as usize]) as u64, 15)
    let platz: u64 = ulib.sys(WM_PLUG_REG, WMP_ABI, p, 0x8E)
    if ulib.bad(platz) {
        ulib.say((&s_no[0 as usize]) as u64)
        ulib.sayn(platz)
        ulib.nl()
        return 1
    }
    ulib.say((&s_reg[0 as usize]) as u64)
    ulib.sayu(platz)
    ulib.nl()
    var n: u64 = 0
    while n < 40 {
        ulib.say((&s_reg[0 as usize]) as u64)
        ulib.sayu(platz)
        ulib.say((&s_re[0 as usize]) as u64)
        ulib.sayu(ulib.sys(WM_PLUG_INFO, platz, PL_RIGHTS, 0))
        ulib.nl()
        let _z: u64 = ulib.sleep_ms(200)
        n = n + 1
    }
    return 0
}
