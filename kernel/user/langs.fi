profile app

import ulib

export { scan, count, code_at, name_at, index_of, names_blob }

const MAX: u64 = 32
const CODE_MAX: u64 = 4
const NAME_MAX: u64 = 32
const HEAD_READ: u64 = 160

static mut codes: [u8; 128] = [0 as u8; 128]
static mut names: [u8; 1056] = [0 as u8; 1056]
static mut blob: [u8; 1100] = [0 as u8; 1100]
static mut total: u64 = 0
static mut path: [u8; 30] = "/usr/share/locale/xx/messages\0"

fn count() -> u64 {
    return total
}

fn code_at(i: u64) -> u64 {
    return (&codes[(i * CODE_MAX) as usize]) as u64
}

fn name_at(i: u64) -> u64 {
    return (&names[(i * NAME_MAX) as usize]) as u64
}

fn names_blob() -> u64 {
    return (&blob[0 as usize]) as u64
}

fn index_of(code: u64) -> u64 {
    var i: u64 = 0
    while i < total {
        if ulib.streq(code_at(i), code) {
            return i
        }
        i = i + 1
    }
    return 0
}

fn read_name(slot: u64, a: u8, b: u8) {
    var head: [u8; 168] = [0 as u8; 168]
    let dst: u64 = name_at(slot)
    var o: u64 = 0
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&path[0 as usize]) as u64, 0, 0)
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&head[0 as usize]) as u64, HEAD_READ)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if !ulib.bad(n) && n > 12 && head[0 as usize] == 108 as u8 && head[4 as usize] == 46 as u8 {
        var i: u64 = 12
        while i < n && head[(i) as usize] != 10 as u8 && head[(i) as usize] != 13 as u8 && o + 1 < NAME_MAX {
            *((dst + o) as *mut u8) = head[(i) as usize]
            o = o + 1
            i = i + 1
        }
    }
    if o == 0 {
        *(dst as *mut u8) = a - 32
        *((dst + 1) as *mut u8) = b
        o = 2
    }
    *((dst + o) as *mut u8) = 0 as u8
}

fn scan() -> u64 {
    total = 0
    var a: u64 = 97
    while a <= 122 {
        var b: u64 = 97
        while b <= 122 {
            path[18 as usize] = a as u8
            path[19 as usize] = b as u8
            let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&path[0 as usize]) as u64, 0, 0)
            if !ulib.bad(fd) {
                ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
                if total < MAX {
                    let c: u64 = code_at(total)
                    *(c as *mut u8) = a as u8
                    *((c + 1) as *mut u8) = b as u8
                    *((c + 2) as *mut u8) = 0 as u8
                    read_name(total, a as u8, b as u8)
                    total = total + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
    var o: u64 = 0
    var k: u64 = 0
    while k < total {
        let nm: u64 = name_at(k)
        var j: u64 = 0
        while *((nm + j) as *mut u8) != 0 as u8 && o + 2 < 1100 {
            blob[(o) as usize] = *((nm + j) as *mut u8)
            o = o + 1
            j = j + 1
        }
        blob[(o) as usize] = 10 as u8
        o = o + 1
        k = k + 1
    }
    blob[(o) as usize] = 0 as u8
    return total
}
