profile kernel

export { NONE, note, back, forward, can_back, can_forward, size, position }

const NONE: u64 = 4294967295
const CAP: u64 = 16

static mut h_page: [u64; 16] = [0 as u64; 16]
static mut h_len: u64 = 0
static mut h_pos: u64 = 0

fn note(p: u64) {
    if h_len != 0 && h_page[h_pos as usize] == p {
        return
    }
    if h_len != 0 {
        h_len = h_pos + 1
    }
    if h_len == CAP {
        var i: u64 = 1
        while i < CAP {
            h_page[(i - 1) as usize] = h_page[i as usize]
            i = i + 1
        }
        h_len = CAP - 1
    }
    h_page[h_len as usize] = p
    h_pos = h_len
    h_len = h_len + 1
}

fn can_back() -> bool {
    return h_len != 0 && h_pos > 0
}

fn can_forward() -> bool {
    return h_len != 0 && h_pos + 1 < h_len
}

fn back() -> u64 {
    if !can_back() {
        return NONE
    }
    h_pos = h_pos - 1
    return h_page[h_pos as usize]
}

fn forward() -> u64 {
    if !can_forward() {
        return NONE
    }
    h_pos = h_pos + 1
    return h_page[h_pos as usize]
}

fn size() -> u64 {
    return h_len
}

fn position() -> u64 {
    return h_pos
}
