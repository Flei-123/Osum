// kernel/user/_dev_dlgprobe.fi -- ZEITWEILIGE PROBE fuer expdlg.fi.
//
// Diese Datei gehoert NICHT zum Erzeugnis. Sie ruft die Auskuenfte des
// Moduls `expdlg` auf einer echten Maschine auf (QEMU, echtes OFS),
// damit die Zahlen der Belegzeilen gemessen und nicht behauptet sind.
// Nach der Abnahme darf sie weg.

profile kernel

import ulib
import libc.io
import msg
import expmodell
import expdlg

export { u_start }

fn u_start(args: u64) -> u64 {
    let _a: u64 = args
    var p_dir: [u8; 3] = "/d\0"
    var n_dir: [u8; 2] = "d\0"
    var p_file: [u8; 12] = "/d/eins.txt\0"
    var n_file: [u8; 9] = "eins.txt\0"
    var p_png: [u8; 12] = "/d/bild.png\0"
    var p_neu: [u8; 11] = "/d/neu.txt\0"
    var inhalt: [u8; 6] = "hallo\0"
    var s_rc: [u8; 22] = "probe: neue_datei rc=\0"
    var s_t: [u8; 16] = "probe: text=<<<\0"
    var s_e: [u8; 10] = ">>>ende\0\0\0"
    let _z: u64 = expmodell.zeit_lade()
    let _m: u64 = msg.init()
    let _1: u64 = expdlg.eig_bauen((&p_dir[0 as usize]) as u64,
        (&n_dir[0 as usize]) as u64, 1)
    ulib.say((&s_t[0 as usize]) as u64)
    ulib.nl()
    ulib.say(expdlg.eig_ptr())
    ulib.say((&s_e[0 as usize]) as u64)
    ulib.nl()
    let _2: u64 = expdlg.eig_bauen((&p_file[0 as usize]) as u64,
        (&n_file[0 as usize]) as u64, 1)
    ulib.say((&s_t[0 as usize]) as u64)
    ulib.nl()
    ulib.say(expdlg.eig_ptr())
    ulib.say((&s_e[0 as usize]) as u64)
    ulib.nl()
    let _3: u64 = expdlg.oeffnenmit_bauen()
    ulib.say(expdlg.oeffnenmit_ptr())
    ulib.nl()
    let rc: u64 = expdlg.neue_datei((&p_neu[0 as usize]) as u64,
        (&inhalt[0 as usize]) as u64)
    ulib.say((&s_rc[0 as usize]) as u64)
    ulib.sayn(rc)
    ulib.nl()
    var n_neu: [u8; 8] = "neu.txt\0"
    let _6: u64 = expdlg.eig_bauen((&p_neu[0 as usize]) as u64,
        (&n_neu[0 as usize]) as u64, 1)
    ulib.say((&s_t[0 as usize]) as u64)
    ulib.nl()
    ulib.say(expdlg.eig_ptr())
    ulib.say((&s_e[0 as usize]) as u64)
    ulib.nl()
    var i: u64 = 0
    while i < expdlg.oeffnenmit_zahl() {
        ulib.say(expdlg.oeffnenmit_name(i))
        ulib.say((&s_e[0 as usize]) as u64)
        ulib.say(expdlg.oeffnenmit_exec(i))
        ulib.nl()
        i = i + 1
    }
    var s_now: [u8; 14] = "probe: now=\0\0\0"
    var s_mt: [u8; 14] = "probe: mt=\0\0\0\0"
    var sb: [u8; 144] = [0 as u8; 144]
    ulib.say((&s_now[0 as usize]) as u64)
    ulib.sayn(io.now_sec())
    ulib.nl()
    let _s: u64 = io.stat_into((&p_neu[0 as usize]) as u64,
        (&sb[0 as usize]) as u64)
    ulib.say((&s_mt[0 as usize]) as u64)
    ulib.sayn(io.stat_mtime((&sb[0 as usize]) as u64))
    ulib.nl()
    var zt: [u8; 32] = [0 as u8; 32]
    var s_zt: [u8; 14] = "probe: zeit=\0\0"
    let _zz: u64 = expmodell.zeit_text(io.now_sec(),
        (&zt[0 as usize]) as u64)
    ulib.say((&s_zt[0 as usize]) as u64)
    ulib.say((&zt[0 as usize]) as u64)
    ulib.nl()
    let _4: u64 = expdlg.mini_laden((&p_png[0 as usize]) as u64)
    let _5: u64 = expdlg.mini_slot_laden((&p_png[0 as usize]) as u64, 3)
    expdlg.melde()
    return 0
}
