// SPDX-License-Identifier: GPL-2.0-only

profile kernel

import ulib
import instkern

export {
    read_table, entry_count, p_start, p_end, p_typ, p_name_ch, p_fve, gap_largest, MIN_ROOT,
    T_UNKNOWN, T_ESP, T_DATA, T_LINUX, T_OSUM, T_MSR, T_RECOVERY,
    find_gap, gap_start, gap_end,
    find_esp, esp_big_enough, ESP_MIN,
    write_beside, free_index, osum_target, delete_entry, p_nr,
    gpt_verify, sect_total,
    D_NONE, D_NO_GPT, D_BROKEN, D_FULL, D_TOO_LITTLE, D_NO_ESP, D_ESP_TOO_SMALL,
    D_WRITE, D_READ, D_HSIZE, D_HCRC, D_ESIZE, D_COUNT, D_TCRC,
    reason_code, detail_got, detail_want
}

const D_NONE: u64 = 0
const D_NO_GPT: u64 = 1
const D_BROKEN: u64 = 2
const D_FULL: u64 = 3
const D_TOO_LITTLE: u64 = 4
const D_NO_ESP: u64 = 5
const D_ESP_TOO_SMALL: u64 = 6
const D_WRITE: u64 = 7
const D_READ: u64 = 8
const D_HSIZE: u64 = 9
const D_HCRC: u64 = 10
const D_ESIZE: u64 = 11
const D_COUNT: u64 = 12
const D_TCRC: u64 = 13

static mut st_reason: u64 = 0
static mut st_got: u64 = 0
static mut st_want: u64 = 0
static mut st_gpt_ok: u64 = 0

fn detail_got() -> u64 {
    return st_got
}

fn detail_want() -> u64 {
    return st_want
}

fn fail(reason: u64, got: u64, want: u64) -> u64 {
    st_reason = reason
    st_got = got
    st_want = want
    return 0
}

fn reason_code() -> u64 {
    return st_reason
}

const T_UNKNOWN: u64 = 0
const T_ESP: u64 = 1
const T_DATA: u64 = 2
const T_LINUX: u64 = 3
const T_OSUM: u64 = 4
const T_MSR: u64 = 5
const T_RECOVERY: u64 = 6

const MAXE: u64 = 16
const BS: u64 = 512
const ENTSECT: u64 = 32
const ENTRIES: u64 = 128
const ENTSIZE: u64 = 128

const ESP_MIN: u64 = 32768

const MIN_ROOT: u64 = 65536

static mut e_start: [u64; 16] = [0 as u64; 16]
static mut e_end: [u64; 16] = [0 as u64; 16]
static mut e_typ: [u64; 16] = [0 as u64; 16]
static mut e_fve: [u64; 16] = [0 as u64; 16]
static mut l_max: u64 = 0
static mut e_slot: [u64; 16] = [0 as u64; 16]
static mut e_name: [u8; 576] = [0 as u8; 576]
static mut e_count: u64 = 0

static mut l_start: u64 = 0
static mut l_end: u64 = 0

static mut g_first_usable: u64 = 0
static mut g_last_usable: u64 = 0
static mut g_table: u64 = 0
static mut g_count: u64 = 0
static mut g_esize: u64 = 0
static mut g_sectors: u64 = 0

static mut SE: [u8; 512] = [0 as u8; 512]

fn sect_total() -> u64 {
    return g_sectors
}

fn entry_count() -> u64 {
    return e_count
}

fn p_start(i: u64) -> u64 {
    if i >= e_count {
        return 0
    }
    return e_start[(i) as usize]
}

fn p_end(i: u64) -> u64 {
    if i >= e_count {
        return 0
    }
    return e_end[(i) as usize]
}

fn p_fve(i: u64) -> bool {
    if i >= e_count {
        return false
    }
    return e_fve[(i) as usize] != 0
}

fn gap_largest() -> u64 {
    return l_max
}

fn p_typ(i: u64) -> u64 {
    if i >= e_count {
        return T_UNKNOWN
    }
    return e_typ[(i) as usize]
}

fn p_name_ch(i: u64, k: u64) -> u64 {
    if i >= e_count || k >= 36 {
        return 0
    }
    return (*(((&e_name[0 as usize]) as u64 + i * 36 + k) as *mut u8)) as u64
}

fn gap_start() -> u64 {
    return l_start
}

fn gap_end() -> u64 {
    return l_end
}

fn g8(at: u64) -> u64 {
    return (*((at) as *mut u8)) as u64
}

fn p8(at: u64, v: u64) {
    __mmio_write8((at) as *mut u8, v as u8)
}

fn g32(at: u64) -> u64 {
    return g8(at) | (g8(at + 1) << 8) | (g8(at + 2) << 16) | (g8(at + 3) << 24)
}

fn g64(at: u64) -> u64 {
    return g32(at) | (g32(at + 4) << 32)
}

fn p32(at: u64, v: u64) {
    p8(at, v & 255)
    p8(at + 1, (v >> 8) & 255)
    p8(at + 2, (v >> 16) & 255)
    p8(at + 3, (v >> 24) & 255)
}

fn p64(at: u64, v: u64) {
    p32(at, v & 0xFFFFFFFF)
    p32(at + 4, (v >> 32) & 0xFFFFFFFF)
}

fn p16(at: u64, v: u64) {
    p8(at, v & 255)
    p8(at + 1, (v >> 8) & 255)
}

fn crc_feed(seed: u64, p: u64, len: u64) -> u64 {
    var crc: u64 = seed
    var i: u64 = 0
    while i < len {
        crc = crc ^ g8(p + i)
        var k: u64 = 0
        while k < 8 {
            let mask: u64 = 0 -% (crc & 1)
            crc = (crc >> 1) ^ (0xEDB88320 & mask)
            k = k + 1
        }
        i = i + 1
    }
    return crc
}

fn crc_of(p: u64, len: u64) -> u64 {
    return (crc_feed(0xFFFFFFFF, p, len) ^ 0xFFFFFFFF) & 0xFFFFFFFF
}

fn zero_16(p: u64) -> bool {
    var i: u64 = 0
    while i < 16 {
        if g8(p + i) != 0 {
            return false
        }
        i = i + 1
    }
    return true
}

fn sig_ok(p: u64) -> bool {

    if g8(p + 0) != 69 { return false }
    if g8(p + 1) != 70 { return false }
    if g8(p + 2) != 73 { return false }
    if g8(p + 3) != 32 { return false }
    if g8(p + 4) != 80 { return false }
    if g8(p + 5) != 65 { return false }
    if g8(p + 6) != 82 { return false }
    if g8(p + 7) != 84 { return false }
    return true
}

fn head_crc(p: u64, size: u64) -> u64 {
    let save: u64 = g32(p + 16)
    p32(p + 16, 0)
    let got: u64 = crc_of(p, size)
    p32(p + 16, save)
    return got
}

fn guid_equal(p: u64, q: u64) -> bool {
    var i: u64 = 0
    while i < 16 {
        if g8(p + i) != g8(q + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn type_of(p: u64) -> u64 {

    var esp: [u8; 16] = [0 as u8; 16]
    esp[0 as usize] = 0x28 as u8
    esp[1 as usize] = 0x73 as u8
    esp[2 as usize] = 0x2A as u8
    esp[3 as usize] = 0xC1 as u8
    esp[4 as usize] = 0x1F as u8
    esp[5 as usize] = 0xF8 as u8
    esp[6 as usize] = 0xD2 as u8
    esp[7 as usize] = 0x11 as u8
    esp[8 as usize] = 0xBA as u8
    esp[9 as usize] = 0x4B as u8
    esp[10 as usize] = 0x00 as u8
    esp[11 as usize] = 0xA0 as u8
    esp[12 as usize] = 0xC9 as u8
    esp[13 as usize] = 0x3E as u8
    esp[14 as usize] = 0xC9 as u8
    esp[15 as usize] = 0x3B as u8
    if guid_equal(p, (&esp[0]) as u64) {
        return T_ESP
    }

    var bas: [u8; 16] = [0 as u8; 16]
    bas[0 as usize] = 0xA2 as u8
    bas[1 as usize] = 0xA0 as u8
    bas[2 as usize] = 0xD0 as u8
    bas[3 as usize] = 0xEB as u8
    bas[4 as usize] = 0xE5 as u8
    bas[5 as usize] = 0xB9 as u8
    bas[6 as usize] = 0x33 as u8
    bas[7 as usize] = 0x44 as u8
    bas[8 as usize] = 0x87 as u8
    bas[9 as usize] = 0xC0 as u8
    bas[10 as usize] = 0x68 as u8
    bas[11 as usize] = 0xB6 as u8
    bas[12 as usize] = 0xB7 as u8
    bas[13 as usize] = 0x26 as u8
    bas[14 as usize] = 0x99 as u8
    bas[15 as usize] = 0xC7 as u8
    if guid_equal(p, (&bas[0]) as u64) {
        return T_DATA
    }

    var lin: [u8; 16] = [0 as u8; 16]
    lin[0 as usize] = 0xAF as u8
    lin[1 as usize] = 0x3D as u8
    lin[2 as usize] = 0xC6 as u8
    lin[3 as usize] = 0x0F as u8
    lin[4 as usize] = 0x83 as u8
    lin[5 as usize] = 0x84 as u8
    lin[6 as usize] = 0x72 as u8
    lin[7 as usize] = 0x47 as u8
    lin[8 as usize] = 0x8E as u8
    lin[9 as usize] = 0x79 as u8
    lin[10 as usize] = 0x3D as u8
    lin[11 as usize] = 0x69 as u8
    lin[12 as usize] = 0xD8 as u8
    lin[13 as usize] = 0x47 as u8
    lin[14 as usize] = 0x7D as u8
    lin[15 as usize] = 0xE4 as u8
    if guid_equal(p, (&lin[0]) as u64) {
        return T_LINUX
    }

    var ofs: [u8; 16] = [0 as u8; 16]
    ofs[0 as usize] = 0x4D as u8
    ofs[1 as usize] = 0x55 as u8
    ofs[2 as usize] = 0x53 as u8
    ofs[3 as usize] = 0x4F as u8
    ofs[4 as usize] = 0x46 as u8
    ofs[5 as usize] = 0x4F as u8
    ofs[6 as usize] = 0x01 as u8
    ofs[7 as usize] = 0x53 as u8
    ofs[8 as usize] = 0x8E as u8
    ofs[9 as usize] = 0x75 as u8
    ofs[10 as usize] = 0x6D as u8
    ofs[11 as usize] = 0x6F as u8
    ofs[12 as usize] = 0x72 as u8
    ofs[13 as usize] = 0x69 as u8
    ofs[14 as usize] = 0x4F as u8
    ofs[15 as usize] = 0x53 as u8
    if guid_equal(p, (&ofs[0]) as u64) {
        return T_OSUM
    }
    if g64(p) == 0x4DB80B5CE3C9E316 && g64(p + 8) == 0xAE1502F02DF97D81 {
        return T_MSR
    }
    if g64(p) == 0x4D4006D1DE94BBA4 && g64(p + 8) == 0xACD67901D5BF6AA1 {
        return T_RECOVERY
    }
    return T_UNKNOWN
}

fn read_table_raw(fd: u64, sect_count: u64) -> u64 {
    st_reason = D_NONE
    e_count = 0
    l_start = 0
    l_end = 0
    g_sectors = sect_count
    let p: u64 = (&SE[0 as usize]) as u64

    if !instkern.read_at(fd, 1, p, BS) {
        return fail(D_READ, 1, 0)
    }
    if !sig_ok(p) {
        st_reason = D_NO_GPT
        return 0
    }
    let hsize: u64 = g32(p + 12)
    if hsize < 92 || hsize > BS {
        return fail(D_HSIZE, hsize, 92)
    }
    let hcrc: u64 = head_crc(p, hsize)
    if hcrc != g32(p + 16) {
        return fail(D_HCRC, g32(p + 16), hcrc)
    }
    g_first_usable = g64(p + 40)
    g_last_usable = g64(p + 48)
    g_table = g64(p + 72)
    g_count = g32(p + 80)
    g_esize = g32(p + 84)
    let tcrc: u64 = g32(p + 88)
    if g_esize < 128 || g_esize > BS {
        return fail(D_ESIZE, g_esize, 128)
    }
    if g_count == 0 || g_count > 128 {
        return fail(D_COUNT, g_count, 128)
    }

    let total_size: u64 = g_count * g_esize
    var c: u64 = 0xFFFFFFFF
    var done: u64 = 0
    var lba: u64 = g_table
    while done < total_size {
        if !instkern.read_at(fd, lba, p, BS) {
            return fail(D_READ, lba, 0)
        }
        var chunk: u64 = BS
        if total_size - done < BS {
            chunk = total_size - done
        }
        c = crc_feed(c, p, chunk)
        done = done + chunk
        lba = lba + 1
    }
    let tgot: u64 = (c ^ 0xFFFFFFFF) & 0xFFFFFFFF
    if tgot != tcrc {
        return fail(D_TCRC, tcrc, tgot)
    }

    let per_block: u64 = BS / g_esize
    var idx: u64 = 0
    while idx < g_count && e_count < MAXE {
        let insek: u64 = idx % per_block
        if insek == 0 {
            if !instkern.read_at(fd, g_table + idx / per_block, p, BS) {
                return fail(D_READ, g_table + idx / per_block, 0)
            }
        }
        let e: u64 = p + insek * g_esize
        if !zero_16(e) {
            let from_pos: u64 = g64(e + 32)
            let to_pos: u64 = g64(e + 40)
            if to_pos >= from_pos {
                e_start[(e_count) as usize] = from_pos
                e_end[(e_count) as usize] = to_pos
                e_typ[(e_count) as usize] = type_of(e)
                e_slot[(e_count) as usize] = idx

                var k: u64 = 0
                while k < 35 {
                    let ch: u64 = g8(e + 56 + k * 2) | (g8(e + 57 + k * 2) << 8)
                    var out: u64 = ch
                    if ch > 126 {
                        out = 46
                    }
                    if ch == 0 {
                        out = 0
                    }
                    p8((&e_name[0 as usize]) as u64 + e_count * 36 + k, out)
                    if ch == 0 {
                        k = 35
                    } else {
                        k = k + 1
                    }
                }
                p8((&e_name[0 as usize]) as u64 + e_count * 36 + 35, 0)
                e_count = e_count + 1
            }
        }
        idx = idx + 1
    }
    return e_count
}

fn mark_fve(fd: u64) {
    let p: u64 = (&SE[0 as usize]) as u64
    var i: u64 = 0
    while i < e_count {
        e_fve[(i) as usize] = 0
        if e_typ[(i) as usize] == T_DATA {
            if instkern.read_at(fd, e_start[(i) as usize], p, BS) {
                if g64(p + 3) == 0x2D53462D4556462D {
                    e_fve[(i) as usize] = 1
                }
            }
        }
        i = i + 1
    }
}

fn read_table(fd: u64, sect_count: u64) -> u64 {
    st_gpt_ok = 0
    let n: u64 = read_table_raw(fd, sect_count)
    if st_reason == D_NONE {
        st_gpt_ok = 1
        mark_fve(fd)
    }
    return n
}

fn gpt_verify() -> bool {
    return st_gpt_ok == 1
}

fn find_gap(min_size: u64) -> bool {
    l_start = 0
    l_end = 0
    l_max = 0
    var best: u64 = 0

    var k: u64 = 0
    while k <= e_count {
        var from_pos: u64 = g_first_usable
        if k > 0 {
            from_pos = e_end[(k - 1) as usize] + 1
        }

        let rest: u64 = from_pos % instkern.ALIGNMENT
        if rest != 0 {
            from_pos = from_pos + (instkern.ALIGNMENT - rest)
        }
        if from_pos < g_first_usable {
            from_pos = g_first_usable
        }

        var to_pos: u64 = g_last_usable
        var i: u64 = 0
        while i < e_count {
            let s: u64 = e_start[(i) as usize]
            let en: u64 = e_end[(i) as usize]

            if en >= from_pos {
                if s <= from_pos {

                    to_pos = 0
                    i = e_count
                } else {
                    if s - 1 < to_pos {
                        to_pos = s - 1
                    }
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        }
        if to_pos > from_pos {
            let gap_size: u64 = to_pos - from_pos + 1
            if gap_size > l_max {
                l_max = gap_size
            }
            if gap_size >= min_size && gap_size > best {
                best = gap_size
                l_start = from_pos
                l_end = to_pos
            }
        }
        k = k + 1
    }
    if best == 0 {
        st_reason = D_TOO_LITTLE
        return false
    }
    return true
}

fn find_esp() -> u64 {
    var i: u64 = 0
    while i < e_count {
        if e_typ[(i) as usize] == T_ESP {
            return i
        }
        i = i + 1
    }
    st_reason = D_NO_ESP
    return MAXE
}

fn esp_big_enough(i: u64) -> bool {
    if i >= e_count {
        return false
    }
    let gap_size: u64 = e_end[(i) as usize] - e_start[(i) as usize] + 1
    if gap_size < ESP_MIN {
        st_reason = D_ESP_TOO_SMALL
        return false
    }
    return true
}

fn free_index(fd: u64) -> u64 {
    var slot: u64 = 0
    while slot < g_count {
        var used: bool = false
        var i: u64 = 0
        while i < e_count {
            if e_slot[(i) as usize] == slot {
                used = true
            }
            i = i + 1
        }
        if !used {
            return slot
        }
        slot = slot + 1
    }
    st_reason = D_FULL
    return ENTRIES
}

fn write_beside(fd: u64, from_pos: u64, to_pos: u64) -> u64 {
    st_reason = D_NONE
    let p: u64 = (&SE[0 as usize]) as u64

    if from_pos < g_first_usable || to_pos > g_last_usable || to_pos <= from_pos {
        st_reason = D_TOO_LITTLE
        return 0
    }

    var i: u64 = 0
    while i < e_count {
        let s: u64 = e_start[(i) as usize]
        let en: u64 = e_end[(i) as usize]
        if from_pos <= en && to_pos >= s {
            st_reason = D_TOO_LITTLE
            return 0
        }
        i = i + 1
    }
    let slot: u64 = free_index(fd)
    if slot >= g_count {
        st_reason = D_FULL
        return 0
    }

    let per_block: u64 = BS / g_esize
    let sector_nr: u64 = slot / per_block
    let insek: u64 = slot % per_block
    if !instkern.read_at(fd, g_table + sector_nr, p, BS) {
        st_reason = D_READ
        return 0
    }
    let e: u64 = p + insek * g_esize

    if !zero_16(e) {
        st_reason = D_FULL
        return 0
    }

    p8(e + 0, 0x4D)
    p8(e + 1, 0x55)
    p8(e + 2, 0x53)
    p8(e + 3, 0x4F)
    p8(e + 4, 0x46)
    p8(e + 5, 0x4F)
    p8(e + 6, 0x01)
    p8(e + 7, 0x53)
    p8(e + 8, 0x8E)
    p8(e + 9, 0x75)
    p8(e + 10, 0x6D)
    p8(e + 11, 0x6F)
    p8(e + 12, 0x72)
    p8(e + 13, 0x69)
    p8(e + 14, 0x4F)
    p8(e + 15, 0x53)

    p8(e + 16, 0x4D)
    p8(e + 17, 0x55)
    p8(e + 18, 0x53)
    p8(e + 19, 0x4F)
    p8(e + 20, 0x46)
    p8(e + 21, 0x4F)
    p8(e + 22, 0x40 | (slot & 15))
    p8(e + 23, 0x53)
    p32(e + 24, 0x53464F00 | (slot & 255))
    p32(e + 28, from_pos & 0xFFFFFFFF)
    p64(e + 32, from_pos)
    p64(e + 40, to_pos)
    p64(e + 48, 0)

    var nk: u64 = 0
    while nk < 36 {
        p16(e + 56 + nk * 2, 0)
        nk = nk + 1
    }
    p16(e + 56, 79)
    p16(e + 58, 83)
    p16(e + 60, 85)
    p16(e + 62, 77)

    let backup_table: u64 = g_sectors - 1 - ENTSECT
    if !instkern.write_at(fd, backup_table + sector_nr, p, BS) {
        st_reason = D_WRITE
        return 0
    }
    if !instkern.write_at(fd, g_table + sector_nr, p, BS) {
        st_reason = D_WRITE
        return 0
    }

    if !seal_table(fd, p) {
        return 0
    }
    return slot + 1
}

fn seal_table(fd: u64, p: u64) -> bool {

    let total_size: u64 = g_count * g_esize
    var c: u64 = 0xFFFFFFFF
    var done: u64 = 0
    var lba: u64 = g_table
    while done < total_size {
        if !instkern.read_at(fd, lba, p, BS) {
            st_reason = D_READ
            return false
        }
        var chunk: u64 = BS
        if total_size - done < BS {
            chunk = total_size - done
        }
        c = crc_feed(c, p, chunk)
        done = done + chunk
        lba = lba + 1
    }
    let tcrc: u64 = (c ^ 0xFFFFFFFF) & 0xFFFFFFFF

    if !instkern.read_at(fd, 1, p, BS) {
        st_reason = D_READ
        return false
    }
    let hsize: u64 = g32(p + 12)
    p32(p + 88, tcrc)
    p32(p + 16, 0)
    p32(p + 16, crc_of(p, hsize))
    if !instkern.write_at(fd, 1, p, BS) {
        st_reason = D_WRITE
        return false
    }
    if !instkern.read_at(fd, g_sectors - 1, p, BS) {
        st_reason = D_READ
        return false
    }
    let hsize2: u64 = g32(p + 12)
    p32(p + 88, tcrc)
    p32(p + 16, 0)
    p32(p + 16, crc_of(p, hsize2))
    if !instkern.write_at(fd, g_sectors - 1, p, BS) {
        st_reason = D_WRITE
        return false
    }
    return true
}

fn osum_target(i: u64) -> bool {
    if i >= e_count {
        return false
    }
    if e_typ[(i) as usize] != T_OSUM {
        return false
    }
    return e_end[(i) as usize] - e_start[(i) as usize] + 1 >= MIN_ROOT
}

fn delete_entry(fd: u64, i: u64) -> bool {
    st_reason = D_NONE
    if i >= e_count || e_typ[(i) as usize] != T_OSUM {
        st_reason = D_TOO_LITTLE
        return false
    }
    let p: u64 = (&SE[0 as usize]) as u64
    let slot: u64 = e_slot[(i) as usize]
    let per_block: u64 = BS / g_esize
    let sector_nr: u64 = slot / per_block
    let insek: u64 = slot % per_block
    if !instkern.read_at(fd, g_table + sector_nr, p, BS) {
        st_reason = D_READ
        return false
    }
    let e: u64 = p + insek * g_esize
    if type_of(e) != T_OSUM || g64(e + 32) != e_start[(i) as usize] {
        st_reason = D_TOO_LITTLE
        return false
    }
    var k: u64 = 0
    while k < g_esize {
        p8(e + k, 0)
        k = k + 1
    }
    let backup_table: u64 = g_sectors - 1 - ENTSECT
    if !instkern.write_at(fd, backup_table + sector_nr, p, BS) {
        st_reason = D_WRITE
        return false
    }
    if !instkern.write_at(fd, g_table + sector_nr, p, BS) {
        st_reason = D_WRITE
        return false
    }
    return seal_table(fd, p)
}

fn p_nr(i: u64) -> u64 {
    if i >= e_count {
        return 0
    }
    return e_slot[(i) as usize] + 1
}
