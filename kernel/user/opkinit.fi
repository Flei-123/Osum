profile kernel

import ulib

export { rescan }

const OPEN_WRITE_TRUNC: u64 = 577

static mut P_CMD: [u8; 13] = "/run/svc.cmd\0"
static mut P_VERB: [u8; 8] = "rescan\n\0"

fn rescan() {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&P_CMD[0]) as u64, OPEN_WRITE_TRUNC, 0)
    if ulib.bad(fd) {
        return
    }
    ulib.sys(ulib.SYS_WRITE, fd, (&P_VERB[0]) as u64, 7)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
}
