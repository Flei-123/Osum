// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/wmd.fi -- docs/COMPOSITOR.md stage S4: `wmd`, THE SHADOW COMPOSITOR (an OBSERVER, it never touches the screen); since S6a it composes the window
// shadows and since S6b the frame, title bar, caption buttons and title text of plain framed windows itself, and judges them.
//
// The plan (docs/COMPOSITOR.md section 3) moves the compositor out of the kernel into a ring-3 program. Before anything is switched, this
// program does the work IN PARALLEL and compares: it reads the window table page (WM_TABLE: who stands where, in which order) and the
// buffers of the shared windows (WM_BUFFD: the very frames the clients paint into), composes the client areas into an off-screen
// picture with the library `fui.comp` (the same row loops `wm.fi` calls), reads the picture the kernel put on the screen (/dev/fb) and
// counts the pixels that differ. The oracle is `wm.fi`, which exists.
//
// WHAT IT COMPOSES, honestly: the CLIENT AREAS of the windows the table marks PLAIN (the server paints them as a plain copy: no
// opening motion, no lift, no blur, no glass, no translucency), in the order of the table (layer, then z). Everything the server draws
// around and over a window is stage S6: the shadow (S6a) and the frame, title bar, caption buttons and title text (S6b) are composed here
// now; blur, glass and the pointer are not. So a pixel counts for the comparison only when
//   * it lies in the outer rectangle of a plain framed window whose chrome is composed here (S6b), or else in the client area of a plain
//     window, 16 points inside the edge (rounded corners), and
//   * no window above it is anything but a plain window further up, with 48 points around its outer rectangle given up for shadows, and
//   * it is not near the pointer.
// `compared` says how many pixels that was; `differ` how many of them were not the same. The screen has to hold still while we look:
// the table and the picture are read twice and a cycle where something moved is thrown away (`unstable`).
//
// S5 (`wmd present`, at the end of this file): the same program, started with the argument `present`, is THE COMPOSITOR that shows the frames:
// the kernel hands every finished rectangle over, this program calls CP_PRESENT, the kernel's watchdog takes over when it hangs or dies.
//
// Every cycle prints one line:  wmd: cycle <n> windows=<n> plain=<n> compared=<px> differ=<px> compose_us=<us> first=<x>,<y>
// and `wmd: summary ...` at the end. Integer only, no heap: the program runs in the kernel profile.

profile kernel

import ulib
import libc.io
import wlibc
import fui.comp
import fui.core
import ecke
import utf8

export { u_start }

const WM_TABLE: u64 = 2142
const WM_BUFFD: u64 = 2143
const SYS_MMAP: u64 = 9
const SYS_MUNMAP: u64 = 11
const SYS_DISPGET: u64 = 1810
const DG_PITCH: u64 = 30
const DG_BPP: u64 = 31
const PROT_R: u64 = 1
const MAP_SH: u64 = 1

const MAXPX: u64 = 1024000 // 1280 x 800
const MAXWIN: u64 = 32
const MARGIN: u64 = 16 // inside the client area: rounded corners
const CAPBAND: u64 = 56 // the caption strip of a window that paints its own title bar, with the server's buttons on it
const SHADOW: u64 = 48 // around the outer rectangle of a window that is not composed here
const PTR_W: u64 = 40
const PTR_H: u64 = 48

// the off-screen picture, the mask of the pixels it is allowed to be judged on, two reads of the screen
static mut sb: [u32; 1024000] = [0 as u32; 1024000]
static mut mask: [u8; 1024000] = [0 as u8; 1024000]
// the two reads of the screen live in shared memory (4 MiB each): the program image (11 MiB) cannot hold all four pictures
static mut p_fba: u64 = 0
static mut p_fbb: u64 = 0
static mut rowbuf: [u8; 8192] = [0 as u8; 8192]
// a copy of the table (header 16 words + 32 rows of 12) taken twice
static mut tab1: [u64; 400] = [0 as u64; 400]
static mut tab2: [u64; 400] = [0 as u64; 400]
// the mapped buffers of the shared windows: window id, address, width, height
static mut mp_id: [u64; 32] = [0 as u64; 32]
static mut mp_ptr: [u64; 32] = [0 as u64; 32]
static mut mp_w: [u64; 32] = [0 as u64; 32]
static mut mp_h: [u64; 32] = [0 as u64; 32]
static mut order: [u64; 32] = [0 as u64; 32]
static mut khz: u64 = 0
static mut scr_w: u64 = 0
static mut scr_h: u64 = 0
static mut pitch: u64 = 0
static mut bpp: u64 = 4

// S6a: the window shadow, the same numbers and the same integer arithmetic as `shadow_build` / `shadow_mask` in wm.fi. The corner square holds two
// banks (focused window, other windows) of SH_SIDE x SH_SIDE octets, the straight edges two strips of SH_MAX octets.
const SH_SIDE: u64 = 40
const SH_MAX: u64 = 16
static mut sh_corner: [u8; 3200] = [0 as u8; 3200]
static mut sh_edge: [u8; 32] = [0 as u8; 32]
static mut sh_side: u64 = 0
static mut sh_k8: u64 = 0 // the table words 8 and 9 the tables were built from (0 = never)
static mut sh_k9: u64 = 0
static mut sh_px: u64 = 0 // pixels the shadow blended in this cycle
// the rectangle the kernel repaints when a window is damaged (`damage_win_ex`: the outer rectangle grown by the larger reach, one point more at the
// right and bottom): the kernel paints the shadow only inside it, so only inside it can the shadow be judged
static mut sh_cx0: i64 = 0
static mut sh_cy0: i64 = 0
static mut sh_cx1: i64 = 0
static mut sh_cy1: i64 = 0
static mut geo_done: u64 = 0 // key of the focused window's geometry last printed as a shadow-geo line
static mut sh_win: u64 = 0 // windows whose shadow was composed in this cycle
static mut o_noshadow: u64 = 0 // counter-proof: judge the shadow ring but do NOT compose it (the judge must then see differences)

static mut s_w: [u8; 6] = "wmd: \0"
static mut s_dev: [u8; 8] = "/dev/fb\0"

fn tsc() -> u64 {
    return asm("rdtsc\nshl rdx, 32\nor rax, rdx", out("rax"))
}

fn us_of(cycles: u64) -> u64 {
    if khz == 0 {
        return 0
    }
    return cycles * 1000 / khz
}

fn calibrate() {
    var t: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    let edge: u64 = t
    while t == edge {
        t = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    }
    let c0: u64 = tsc()
    let t0: u64 = t
    while t < t0 + 10 {
        t = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    }
    let c1: u64 = tsc()
    khz = (c1 - c0) / 100
}

fn mmap_fd(fd: u64, bytes: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") SYS_MMAP, in("rdi") 0,
        in("rsi") bytes, in("rdx") PROT_R, in("r10") MAP_SH,
        in("r8") fd, in("r9") 0, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

fn say_kv(name: u64, v: u64) {
    ulib.say(name)
    ulib.sayu(v)
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

// copy the table page into `dst` (400 words); true when the sequence number was even and the same before and after the copy
fn snap(t: u64, dst: u64) -> bool {
    let s0: u64 = __mmio_read64((t + 8) as *mut u64)
    if (s0 & 1) != 0 {
        return false
    }
    var i: u64 = 0
    while i < 400 {
        __mmio_write64((dst + i * 8) as *mut u64, __mmio_read64((t + i * 8) as *mut u64))
        i = i + 1
    }
    return __mmio_read64((t + 8) as *mut u64) == s0
}

fn same_tab() -> bool {
    var i: u64 = 0
    while i < 400 {
        // word 1 is the sequence number (it rises every frame), word 5 the frame counter: the rest must be equal
        if i != 1 && i != 5 {
            if tab1[i as usize] != tab2[i as usize] {
                return false
            }
        }
        i = i + 1
    }
    return true
}

// read the screen into `dst` (scr_h rows of scr_w pixels, 4 octets each)
fn read_screen(dst: u64) -> bool {
    let fd: u64 = io.open((&s_dev[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return false
    }
    let rp: u64 = (&rowbuf[0 as usize]) as u64
    var y: u64 = 0
    var good: bool = true
    while y < scr_h && good {
        if ulib.bad(io.seek(fd, y * pitch, 0)) {
            good = false
        } else {
            let n: u64 = scr_w * bpp
            if ulib.bad(io.read_full(fd, rp, n)) {
                good = false
            } else {
                if bpp == 4 {
                    // the card holds B G R x; a pixel is 0x00RRGGBB in a 32-bit word on this little-endian machine: the same octets
                    var x: u64 = 0
                    while x < scr_w {
                        __mmio_write32((dst + (y * scr_w + x) * 4) as *mut u32, (__mmio_read32((rp + x * 4) as *mut u32) & 0xFFFFFF) as u32)
                        x = x + 1
                    }
                } else {
                    good = false
                }
            }
        }
        y = y + 1
    }
    io.close(fd)
    return good
}

// the buffer of window `id` (slot k of the cache), mapped read-only; remapped when the size changed. 0 = none.
fn buffer_of(k: u64, id: u64, w: u64, h: u64) -> u64 {
    if mp_id[k as usize] == id && mp_w[k as usize] == w && mp_h[k as usize] == h && mp_ptr[k as usize] != 0 {
        return mp_ptr[k as usize]
    }
    if mp_ptr[k as usize] != 0 {
        let _u: u64 = ulib.sys(SYS_MUNMAP, mp_ptr[k as usize], mp_w[k as usize] * mp_h[k as usize] * 4, 0)
        mp_ptr[k as usize] = 0
    }
    mp_id[k as usize] = id
    mp_w[k as usize] = w
    mp_h[k as usize] = h
    let fd: u64 = wlibc.sys3w(WM_BUFFD, id, 0, 0)
    if ulib.bad(fd) {
        return 0
    }
    let p: u64 = mmap_fd(fd, w * h * 4)
    wlibc.shm_close(fd)
    if ulib.bad(p) || p == 0 {
        return 0
    }
    mp_ptr[k as usize] = p
    return p
}

// `n` octets of `v` at `p` (rep stosb)
fn fill8(p: u64, v: u64, n: u64) {
    if n == 0 {
        return
    }
    asm("cld\nrep stosb", in("rdi") p, in("rax") v, in("rcx") n,
        clobber("rdi"), clobber("rcx"), clobber("memory"))
}

fn mask_rect(x0: i64, y0: i64, x1: i64, y1: i64, v: u64) {
    let cx0: i64 = imax(x0, 0)
    let cy0: i64 = imax(y0, 0)
    let cx1: i64 = imin(x1, scr_w as i64)
    let cy1: i64 = imin(y1, scr_h as i64)
    if cx1 <= cx0 || cy1 <= cy0 {
        return
    }
    var y: i64 = cy0
    while y < cy1 {
        fill8((&mask[0 as usize]) as u64 + y as u64 * scr_w + cx0 as u64, v, (cx1 - cx0) as u64)
        y = y + 1
    }
}

fn clear_mask_rect(x0: i64, y0: i64, x1: i64, y1: i64) {
    mask_rect(x0, y0, x1, y1, 0)
}

fn set_mask_rect(x0: i64, y0: i64, x1: i64, y1: i64) {
    mask_rect(x0, y0, x1, y1, 1)
}

// ---------------------------------------------------------------------------------------------------------------------------
// S6a -- THE WINDOW SHADOW IN RING 3
//
// `shadow_ramp` / `shadow_build` / `shadow_mask` of kernel/ui/wm.fi, line by line in the same integers. The table page (words 8 and 9) carries
// the numbers the kernel builds its mask from.

fn isqrt(n: u64) -> u64 {
    if n < 2 {
        return n
    }
    var x: u64 = n
    var y: u64 = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

fn sh_ramp(strength: u64, reach: u64, d16: u64) -> u64 {
    let full: u64 = reach * 16 + 16
    if d16 == 0 || d16 >= full {
        return 0
    }
    return strength * 255 / 100 * (full - d16) / full
}

// build the tables from the table page words (only when they changed)
fn sh_build(w8: u64, w9: u64) {
    if sh_k8 == w8 && sh_k9 == w9 && sh_side != 0 {
        return
    }
    let a1: u64 = w8 & 0xFF
    var r1: u64 = (w8 >> 8) & 0xFF
    let a2: u64 = (w8 >> 16) & 0xFF
    var r2: u64 = (w8 >> 24) & 0xFF
    let r: u64 = (w8 >> 32) & 0xFF
    if r1 > SH_MAX {
        r1 = SH_MAX
    }
    if r2 > SH_MAX {
        r2 = SH_MAX
    }
    var rmax: u64 = r1
    if r2 > rmax {
        rmax = r2
    }
    var side: u64 = r + rmax
    if side > SH_SIDE {
        side = SH_SIDE
    }
    var k: u64 = 0
    while k < SH_MAX {
        var v1: u64 = 0
        var v2: u64 = 0
        if k < r1 {
            v1 = sh_ramp(a1, r1, (k + 1) * 16)
        }
        if k < r2 {
            v2 = sh_ramp(a2, r2, (k + 1) * 16)
        }
        sh_edge[k as usize] = v1 as u8
        sh_edge[(SH_MAX + k) as usize] = v2 as u8
        k = k + 1
    }
    let bank: u64 = SH_SIDE * SH_SIDE
    var j: u64 = 0
    while j < side {
        var ii: u64 = 0
        while ii < side {
            let dx: u64 = side - ii
            let dy: u64 = side - j
            let dist16: u64 = isqrt((dx * dx + dy * dy) * 256)
            var d16: u64 = 0
            if dist16 > r * 16 {
                d16 = dist16 - r * 16
            }
            let o: u64 = j * SH_SIDE + ii
            sh_corner[o as usize] = sh_ramp(a1, r1, d16) as u8
            sh_corner[(bank + o) as usize] = sh_ramp(a2, r2, d16) as u8
            ii = ii + 1
        }
        j = j + 1
    }
    sh_side = side
    sh_k8 = w8
    sh_k9 = w9
}

// `color` over the picture pixel at (x, y) with the opacity `a`; a pixel the client left clear or translucent is not touched (the server paints
// something else there, it is not judged either). The result keeps alpha 255.
fn sh_mix(x: i64, y: i64, color: u64, a: u64) {
    if a == 0 || x < sh_cx0 || y < sh_cy0 || x >= sh_cx1 || y >= sh_cy1 || x < 0 || y < 0 || x >= scr_w as i64 || y >= scr_h as i64 {
        return
    }
    let p: u64 = (&sb[0 as usize]) as u64 + (y as u64 * scr_w + x as u64) * 4
    let old: u64 = __mmio_read32(p as *mut u32) as u64
    // (a terminal's pixels come from the kernel's own painter, which leaves the alpha octet clear: it is opaque by the window's kind, mask value 2)
    if (old >> 24) != 255 && mask[(y as u64 * scr_w + x as u64) as usize] != 2 {
        return
    }
    var v: u64 = color
    if a < 255 {
        v = comp.blend(old & 16777215, color, a)
    }
    __mmio_write32(p as *mut u32, (v | 4278190080) as u32)
    sh_px = sh_px + 1
}

// a run of `n` pixels from (x, y) to the right, the opacity read from the octets at `m` (step +1 or -1)
fn sh_run_mask(x: i64, y: i64, n: i64, color: u64, m0: u64, step: i64) {
    var m: u64 = m0
    var k: i64 = 0
    while k < n {
        sh_mix(x + k, y, color, (sh_corner_at(m)))
        if step < 0 {
            m = m - 1
        } else {
            m = m + 1
        }
        k = k + 1
    }
}

fn sh_corner_at(m: u64) -> u64 {
    return rd8(m)
}

fn sh_run_edge(x: i64, y: i64, n: i64, color: u64, a: u64) {
    if a == 0 {
        return
    }
    var k: i64 = 0
    while k < n {
        sh_mix(x + k, y, color, a)
        k = k + 1
    }
}

// the shadow of one window: outer rectangle (wx, wy, ow, oh), reach and bank as the kernel chose them (bank 0 = the focused window)
fn sh_window(wx: i64, wy: i64, ow: i64, oh: i64, reach: u64, bank: u64, color: u64, r: u64) {
    let side: u64 = sh_side
    if side == 0 || reach == 0 {
        return
    }
    let base: u64 = (&sh_corner[0 as usize]) as u64 + bank * SH_SIDE * SH_SIDE
    let ebase: u64 = (&sh_edge[0 as usize]) as u64 + bank * SH_MAX
    let sy: i64 = wy + 1
    let si: i64 = side as i64
    let ri: i64 = r as i64
    let rc: i64 = reach as i64
    let lx: i64 = wx - rc
    let rx: i64 = wx + ow - ri
    let mx: i64 = wx + ri
    let mw: i64 = ow - 2 * ri
    let my: i64 = sy + ri
    let mh: i64 = oh - 2 * ri
    var j: i64 = 0
    while j < si {
        let y: i64 = sy - rc + j
        let m: u64 = base + (j * SH_SIDE as i64) as u64
        sh_run_mask(lx, y, si, color, m, 1)
        sh_run_mask(rx, y, si, color, m + (side - 1), 0 - 1)
        if j < rc && mw > 0 {
            sh_run_edge(mx, y, mw, color, rd8(ebase + (rc - 1 - j) as u64))
        }
        j = j + 1
    }
    j = 0
    while j < si {
        let y: i64 = sy + oh + rc - 1 - j
        let m: u64 = base + (j * SH_SIDE as i64) as u64
        sh_run_mask(lx, y, si, color, m, 1)
        sh_run_mask(rx, y, si, color, m + (side - 1), 0 - 1)
        if j < rc && mw > 0 {
            sh_run_edge(mx, y, mw, color, rd8(ebase + (rc - 1 - j) as u64))
        }
        j = j + 1
    }
    if mh > 0 && rc > 0 {
        var q: i64 = 0
        while q < mh {
            let y: i64 = my + q
            sh_run_mask(wx - rc, y, rc, color, ebase + (reach - 1), 0 - 1)
            sh_run_mask(wx + ow, y, rc, color, ebase, 1)
            q = q + 1
        }
    }
}

// ---------------------------------------------------------------------------------------------------------------------------
// S6b -- THE FRAME, THE TITLE BAR, THE CAPTION BUTTONS AND THE TITLE TEXT IN RING 3
//
// `paint_win` / `paint_title` / `paint_caption` / `cap_face` / `cap_glyph` / `title_text` of kernel/ui/wm.fi, step by step with the same integers.
// The numbers (colours, measures, hover state, titles) come over the CHROME PAGE (WM_TABLE with argument 1, root only; the layout is in the header of
// `chrome_object` in wm.fi). The glyph bitmaps of the title come from the kernel's rasteriser (WIG_GLYPH / WIG_KERN, the very bitmaps `title_text`
// draws), the caption symbols from `fui.core` (the same source as the kernel's `cg_mal`).
//
// A pixel is "composed" when its alpha octet in `sb` is 255. A translucent pixel (corner smoothing, glass) can only be blended over a composed pixel: over
// the wallpaper (not composed here) it stays as it is and is not judged, as in S6a.

const CHR_MAGIC: u64 = 0x52484357
const CHR_TITLE: u64 = 32
const CHR_MARK: u64 = 192
const CHR_WORDS: u64 = 224
const CAP_N: u64 = 3
const CAP_MIN: u64 = 0
const CAP_MAX: u64 = 1
const CAP_CLOSE: u64 = 2
const F_MAXIMIZED: u64 = 4
const F_CAPCLIENT: u64 = 64
const CG_SIDE: u64 = 40 // 10 * the largest scale (4)
const CG_CELL: u64 = 6400 // 40 * 40 * 4 octets: fUi writes four octets per pixel
const GL_BUF: u64 = 8192

static mut chr1: [u64; 224] = [0 as u64; 224]
static mut chr2: [u64; 224] = [0 as u64; 224]
static mut p_chr: u64 = 0 // the mapped chrome page
static mut ch_have: u64 = 0 // 1 = this cycle has a consistent chrome page
static mut ch_px: u64 = 0 // pixels the chrome wrote in this cycle (frame, title bar, buttons, text)
static mut ch_win: u64 = 0 // windows whose chrome was composed in this cycle
static mut ch_txt: u64 = 0 // title text pixels in this cycle
static mut ch_cap: u64 = 0 // caption symbol pixels in this cycle
static mut o_nochrome: u64 = 0 // counter-proof: judge the chrome but do NOT compose it
static mut gl_buf: [u8; 8192] = [0 as u8; 8192]
static mut cg_deck: [u8; 25600] = [0 as u8; 25600]
static mut cg_gut: [u64; 4] = [0 as u64; 4]
static mut cg_gr: u64 = 0
static mut geo_chr: [u64; 32] = [0 as u64; 32] // key of each window's chrome geometry last printed

fn fill32(p: u64, v: u64, n: u64) {
    if n == 0 {
        return
    }
    asm("cld\nrep stosd", in("rdi") p, in("rax") v, in("rcx") n, clobber("rdi"), clobber("rcx"), clobber("memory"))
}

// copy the chrome page into `dst` (224 words); true when the table's sequence number was even and the same before and after (the chrome page is
// written inside the same odd/even bracket as the table)
fn chr_snap(t: u64, dst: u64) -> bool {
    if p_chr == 0 {
        return false
    }
    let s0: u64 = __mmio_read64((t + 8) as *mut u64)
    if (s0 & 1) != 0 {
        return false
    }
    var i: u64 = 0
    while i < CHR_WORDS {
        __mmio_write64((dst + i * 8) as *mut u64, __mmio_read64((p_chr + i * 8) as *mut u64))
        i = i + 1
    }
    if __mmio_read64((t + 8) as *mut u64) != s0 {
        return false
    }
    // magic, valid
    return (__mmio_read64(dst as *mut u64) & 0xFFFFFFFF) == CHR_MAGIC && __mmio_read64((dst + 16) as *mut u64) == (1 as u64)
}

fn same_chr() -> bool {
    var i: u64 = 0
    while i < CHR_WORDS {
        if i != 1 && chr1[i as usize] != chr2[i as usize] {
            return false
        }
        i = i + 1
    }
    return true
}

// a pixel of the picture, written opaque (the kernel's `fb.pixel`)
fn ch_set(x: i64, y: i64, color: u64) {
    if x < 0 || y < 0 || x >= scr_w as i64 || y >= scr_h as i64 {
        return
    }
    let p: u64 = (&sb[0 as usize]) as u64 + (y as u64 * scr_w + x as u64) * 4
    __mmio_write32(p as *mut u32, (color | 4278190080) as u32)
    ch_px = ch_px + 1
}

// a pixel with an opacity (the kernel's `fb.pixel_a`): over a composed pixel only
fn ch_mix(x: i64, y: i64, color: u64, a: u64) {
    if a == 0 || x < 0 || y < 0 || x >= scr_w as i64 || y >= scr_h as i64 {
        return
    }
    if a >= 255 {
        ch_set(x, y, color)
        return
    }
    let p: u64 = (&sb[0 as usize]) as u64 + (y as u64 * scr_w + x as u64) * 4
    let old: u64 = __mmio_read32(p as *mut u32) as u64
    if (old >> 24) != 255 {
        return
    }
    __mmio_write32(p as *mut u32, (comp.blend(old & 16777215, color, a) | 4278190080) as u32)
    ch_px = ch_px + 1
}

// the kernel's `fill_clip`
fn ch_fill(x: i64, y: i64, w: i64, h: i64, color: u64, a: u64) {
    if w <= 0 || h <= 0 || a == 0 {
        return
    }
    let x0: i64 = imax(x, 0)
    let y0: i64 = imax(y, 0)
    let x1: i64 = imin(x + w, scr_w as i64)
    let y1: i64 = imin(y + h, scr_h as i64)
    if x1 <= x0 || y1 <= y0 {
        return
    }
    var yy: i64 = y0
    while yy < y1 {
        if a >= 255 {
            fill32((&sb[0 as usize]) as u64 + (yy as u64 * scr_w + x0 as u64) * 4, color | 4278190080, (x1 - x0) as u64)
            ch_px = ch_px + (x1 - x0) as u64
        } else {
            var xx: i64 = x0
            while xx < x1 {
                ch_mix(xx, yy, color, a)
                xx = xx + 1
            }
        }
        yy = yy + 1
    }
}

// the kernel's `fill_round`: a rectangle with rounded, smoothed corners
fn ch_round(x: i64, y: i64, w: i64, h: i64, r0: u64, color: u64, a: u64) {
    if w <= 0 || h <= 0 || a == 0 {
        return
    }
    var r: u64 = r0
    if r * 2 > w as u64 {
        r = (w / 2) as u64
    }
    if r * 2 > h as u64 {
        r = (h / 2) as u64
    }
    if r == 0 {
        ch_fill(x, y, w, h, color, a)
        return
    }
    let ri: i64 = r as i64
    ch_fill(x, y + ri, w, h - 2 * ri, color, a)
    ch_fill(x + ri, y, w - 2 * ri, ri, color, a)
    ch_fill(x + ri, y + h - ri, w - 2 * ri, ri, color, a)
    var dy: u64 = 0
    while dy < r {
        var dx: u64 = 0
        while dx < r {
            var cov: u64 = ecke.corner_cov(r - 1 - dx, r - 1 - dy, r)
            if a < 255 {
                cov = cov * a / 255
            }
            if cov != 0 {
                let x0: i64 = x + dx as i64
                let y0: i64 = y + dy as i64
                let x1: i64 = x + w - 1 - dx as i64
                let y1: i64 = y + h - 1 - dy as i64
                ch_mix(x0, y0, color, cov)
                ch_mix(x1, y0, color, cov)
                ch_mix(x0, y1, color, cov)
                ch_mix(x1, y1, color, cov)
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

// the kernel's `shade24`, `grad_room`, `mix24` (colours as 0xRRGGBB)
fn ch_shade(c: u64, d: u64) -> u64 {
    var r: u64 = (c >> 16) & 255
    var g: u64 = (c >> 8) & 255
    var b: u64 = c & 255
    if r > d {
        r = r - d
    } else {
        r = 0
    }
    if g > d {
        g = g - d
    } else {
        g = 0
    }
    if b > d {
        b = b - d
    } else {
        b = 0
    }
    return (r << 16) | (g << 8) | b
}

fn ch_room(c: u64, want: u64) -> u64 {
    var m: u64 = (c >> 16) & 255
    let g: u64 = (c >> 8) & 255
    let b: u64 = c & 255
    if g < m {
        m = g
    }
    if b < m {
        m = b
    }
    if want > m {
        return m
    }
    return want
}

fn ch_mix24(a: u64, b: u64, per: u64) -> u64 {
    let r: u64 = (((a >> 16) & 255) * (100 - per) + ((b >> 16) & 255) * per) / 100
    let g: u64 = (((a >> 8) & 255) * (100 - per) + ((b >> 8) & 255) * per) / 100
    let bl: u64 = ((a & 255) * (100 - per) + (b & 255) * per) / 100
    return (r << 16) | (g << 8) | bl
}

// `paint_title`: the title bar (round at the top, with a gradient when the theme has one)
fn ch_title_bar(wx: i64, wy: i64, ow: i64, focused: bool) {
    let wal: u64 = chr1[21]
    let bo: i64 = chr1[17] as i64
    let x0: i64 = wx + bo
    let y0: i64 = wy + bo
    let tw: i64 = ow - 2 * bo
    let th: i64 = chr1[18] as i64 - 1 - bo
    if tw <= 0 || th <= 0 {
        return
    }
    var tr: u64 = 0
    let rw: u64 = chr1[14]
    if rw > chr1[17] {
        tr = rw - chr1[17]
    }
    if tr as i64 > th {
        tr = th as u64
    }
    var titel: u64 = chr1[7]
    if focused {
        titel = chr1[10]
    }
    let grad: u64 = chr1[15]
    var d: u64 = 0
    if grad != 0 {
        d = ch_room(titel, grad)
    }
    if d == 0 {
        ch_round(x0, y0, tw, th, tr, titel, wal)
        if tr != 0 {
            ch_fill(x0, y0 + tr as i64, tw, th - tr as i64, titel, wal)
        }
        return
    }
    ch_round(x0, y0, tw, th, tr, ch_shade(titel, d), wal)
    var j: i64 = tr as i64
    while j < th {
        let rest: u64 = d * (th - 1 - j) as u64 / (th - 1) as u64
        ch_fill(x0, y0 + j, tw, 1, ch_shade(titel, rest), wal)
        j = j + 1
    }
}

// `cap_face`: the face of one caption button (only the close button follows the window's round corner)
fn ch_cap_face(x: i64, y: i64, h: i64, tr: u64, color: u64, right: bool) {
    let wal: u64 = chr1[21]
    let w: i64 = chr1[19] as i64
    if !right || tr == 0 {
        ch_fill(x, y, w, h, color, wal)
        return
    }
    let r: i64 = tr as i64
    ch_round(x, y, w, h, tr, color, wal)
    ch_fill(x, y, w - r, r, color, wal)
    ch_fill(x, y + r, w, h - r, color, wal)
}

// `cg_bau` / `cg_mal`: the symbol as a coverage map (one octet per pixel), once per size. fUi's own forms, as in the kernel.
fn cg_make(slot: u64, n: u64, maximized: bool, dd: u64, sbw: u64) -> bool {
    if slot >= 4 || dd == 0 || dd > CG_SIDE {
        return false
    }
    if cg_gr == dd && cg_gut[slot as usize] != 0 {
        return true
    }
    if cg_gr != dd {
        var k: u64 = 0
        while k < 4 {
            cg_gut[k as usize] = 0
            k = k + 1
        }
        cg_gr = dd
    }
    let basis: u64 = ((&cg_deck[0 as usize]) as u64) + slot * CG_CELL
    var z: core.Target = core.target_new(basis, dd as usize, dd as usize, (dd * 4) as usize)
    core.fill_rect(&z, 0 as usize, 0 as usize, dd as usize, dd as usize, 0 as u32)
    let white: u32 = 0xFFFFFF as u32
    if n == CAP_MIN {
        core.cap_minimize(&z, 0 as usize, 0 as usize, dd as usize, sbw as usize, white)
    } else if n == CAP_MAX {
        if maximized {
            core.cap_restore(&z, 0 as usize, 0 as usize, dd as usize, sbw as usize, white)
        } else {
            core.cap_maximize(&z, 0 as usize, 0 as usize, dd as usize, sbw as usize, white)
        }
    } else {
        core.cap_close(&z, 0 as usize, 0 as usize, dd as usize, sbw as usize, white)
    }
    // four octets per pixel down to one (in place: pixel k lies at k * 4 and goes to k)
    var k2: u64 = 0
    while k2 < dd * dd {
        var v: u8 = 0 as u8
        if cg_deck[(slot * CG_CELL + k2 * 4) as usize] != 0 as u8 {
            v = 255 as u8
        }
        cg_deck[(slot * CG_CELL + k2) as usize] = v
        k2 = k2 + 1
    }
    cg_gut[slot as usize] = 1
    return true
}

// `cap_glyph`: the symbol at (x, y), every covered pixel in the colour `color`
fn ch_cap_glyph(n: u64, x: i64, y: i64, color: u64, maximized: bool) {
    let sk: u64 = chr1[20]
    let dd: u64 = 10 * sk
    if sk == 0 || dd > CG_SIDE {
        return
    }
    var slot: u64 = n
    if n == CAP_MAX && maximized {
        slot = 3
    }
    if !cg_make(slot, n, maximized, dd, sk) {
        return
    }
    var ry: u64 = 0
    while ry < dd {
        var rx: u64 = 0
        while rx < dd {
            if cg_deck[(slot * CG_CELL + ry * dd + rx) as usize] != 0 as u8 {
                ch_set(x + rx as i64, y + ry as i64, color)
                ch_cap = ch_cap + 1
            }
            rx = rx + 1
        }
        ry = ry + 1
    }
}

// `paint_caption`: the three buttons at the right end of the title bar. `hov` = the hovered button coded (slot * 4 + n) + 1, `held` = pressed
fn ch_caption(wx: i64, wy: i64, ow: i64, focused: bool, slot: u64, maximized: bool) {
    let bo: i64 = chr1[17] as i64
    let cwid: i64 = chr1[19] as i64
    let bx: i64 = wx + ow - bo - CAP_N as i64 * cwid
    let by: i64 = wy + bo
    let h: i64 = chr1[18] as i64 - 1 - bo
    if h <= 0 {
        return
    }
    var tr: u64 = 0
    let rw: u64 = chr1[14]
    if rw > chr1[17] {
        tr = rw - chr1[17]
    }
    var titel: u64 = chr1[7]
    var schrift: u64 = chr1[8]
    if focused {
        titel = chr1[10]
        schrift = chr1[11]
    }
    let hov: u64 = chr1[22]
    let dwn: u64 = chr1[23]
    var n: u64 = 0
    while n < CAP_N {
        let x: i64 = bx + n as i64 * cwid
        var mark: u64 = schrift
        if hov != 0 && hov - 1 == slot * 4 + n {
            let held: bool = dwn == hov
            if n == CAP_CLOSE {
                var rot: u64 = chr1[12]
                if held {
                    rot = ch_mix24(chr1[12], 0, 14)
                }
                ch_cap_face(x, by, h, tr, rot, true)
                mark = chr1[13]
            } else {
                var pc: u64 = 12
                if held {
                    pc = 22
                }
                ch_cap_face(x, by, h, tr, ch_mix24(titel, schrift, pc), false)
            }
        }
        let zg: i64 = 10 * chr1[20] as i64
        ch_cap_glyph(n, x + (cwid - zg) / 2, by + (h - zg) / 2, mark, maximized)
        n = n + 1
    }
}

// `title_text`: the title of the window, glyph by glyph (the kernel's bitmaps and kerning), blended over the bar
fn ch_title_text(tp: u64, x: i64, y: i64, color: u64, limit: i64, px: u64) {
    var cx: i64 = x * 64
    var before: u64 = 0
    var k: u64 = 0
    let gb: u64 = (&gl_buf[0 as usize]) as u64
    while k < 31 {
        let v: u64 = utf8.next(tp, 31, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = 31
        } else {
            if before != 0 {
                cx = cx + wlibc.sys5(wlibc.WIG_KERN, 0, px, before, c, 0) as i64
            }
            let n: u64 = wlibc.sys5(wlibc.WIG_GLYPH, 0, px, c, gb, GL_BUF)
            if !ulib.bad(n) && n >= 48 {
                let gw: u64 = rd64(gb)
                let gh: u64 = rd64(gb + 8)
                let gl: i64 = rd64(gb + 16) as i64
                let gt: i64 = rd64(gb + 24) as i64
                let adv: i64 = rd64(gb + 32) as i64
                if gw > 256 || gh > 256 || gw * gh + 48 > n {
                    return
                }
                if (cx >> 6) + gw as i64 > limit - 4 {
                    return
                }
                var r: u64 = 0
                while r < gh {
                    var cc: u64 = 0
                    while cc < gw {
                        let a: u64 = rd8(gb + 48 + r * gw + cc)
                        if a != 0 {
                            let sx: i64 = (cx >> 6) + gl + cc as i64
                            let sy: i64 = y - gt + r as i64
                            if sx >= 0 && sy >= 0 && sx < scr_w as i64 && sy < scr_h as i64 {
                                let p: u64 = (&sb[0 as usize]) as u64 + (sy as u64 * scr_w + sx as u64) * 4
                                let old: u64 = __mmio_read32(p as *mut u32) as u64
                                if (old >> 24) == 255 {
                                    __mmio_write32(p as *mut u32, (comp.blend(old & 16777215, color, a) | 4278190080) as u32)
                                    ch_px = ch_px + 1
                                    ch_txt = ch_txt + 1
                                }
                            }
                        }
                        cc = cc + 1
                    }
                    r = r + 1
                }
                cx = cx + adv
            }
            before = c
            k = k + l
        }
    }
}

// the geometry of every composed window's chrome, whenever it changes, for the gate (tools/comp/chrome.sh checks the PICTURE against it: the bar,
// the buttons and the title ink must stand where these numbers say, in the kernel's own screenshot). One line per window and geometry:
//   wmd: chrome-geo <focused> <own strip> x y ow oh border title_h cap_w scale radius title frame text padding gradient close
fn chrome_geo(k: u64, x: i64, y: i64, ow: i64, oh: i64, focused: bool, capc: bool) {
    let gk: u64 = (x as u64 & 0xFFFF) | ((y as u64 & 0xFFFF) << 16) | ((ow as u64 & 0xFFFF) << 32) | ((oh as u64 & 0xFFFF) << 48)
        ^ (if focused { 0x5555 as u64 } else { 0 as u64 })
    if k >= 32 || geo_chr[k as usize] == gk {
        return
    }
    geo_chr[k as usize] = gk
    var l: [u8; 17] = "wmd: chrome-geo \0"
    var sp: [u8; 2] = " \0"
    ulib.say((&l[0 as usize]) as u64)
    var f: u64 = 0
    if focused {
        f = 1
    }
    var c: u64 = 0
    if capc {
        c = 1
    }
    ulib.sayu(f)
    ulib.say((&sp[0 as usize]) as u64)
    ulib.sayu(c)
    ulib.say((&sp[0 as usize]) as u64)
    ulib.sayu(x as u64)
    ulib.say((&sp[0 as usize]) as u64)
    ulib.sayu(y as u64)
    ulib.say((&sp[0 as usize]) as u64)
    ulib.sayu(ow as u64)
    ulib.say((&sp[0 as usize]) as u64)
    ulib.sayu(oh as u64)
    var w: u64 = 17
    while w <= 20 {
        ulib.say((&sp[0 as usize]) as u64)
        ulib.sayu(chr1[w as usize])
        w = w + 1
    }
    var tc: u64 = chr1[7]
    var fc: u64 = chr1[6]
    var xc: u64 = chr1[8]
    if focused {
        tc = chr1[10]
        fc = chr1[9]
        xc = chr1[11]
    }
    ulib.say((&sp[0 as usize]) as u64)
    ulib.sayu(chr1[14])
    ulib.say((&sp[0 as usize]) as u64)
    ulib.sayu(tc)
    ulib.say((&sp[0 as usize]) as u64)
    ulib.sayu(fc)
    ulib.say((&sp[0 as usize]) as u64)
    ulib.sayu(xc)
    ulib.say((&sp[0 as usize]) as u64)
    ulib.sayu(chr1[26])
    ulib.say((&sp[0 as usize]) as u64)
    ulib.sayu(chr1[15])
    ulib.say((&sp[0 as usize]) as u64)
    ulib.sayu(chr1[12])
    ulib.nl()
}

// the whole chrome of one framed window, in the order of `paint_win`: frame, title bar, buttons, title (a window that paints its own strip gets its
// buttons after the client area: `ch_strip_buttons`)
fn ch_window(row: u64, wx: i64, wy: i64, ow: i64, oh: i64, focused: bool, slot: u64, flags: u64) {
    let maximized: bool = (flags & F_MAXIMIZED) != 0
    let capc: bool = (flags & F_CAPCLIENT) != 0
    var rahmen: u64 = chr1[6]
    var schrift: u64 = chr1[8]
    if focused {
        rahmen = chr1[9]
        schrift = chr1[11]
    }
    ch_round(wx, wy, ow, oh, chr1[14], rahmen, chr1[21])
    if capc {
        return
    }
    ch_title_bar(wx, wy, ow, focused)
    ch_caption(wx, wy, ow, focused, slot, maximized)
    let bo: i64 = chr1[17] as i64
    let limit: i64 = wx + ow - bo - CAP_N as i64 * chr1[19] as i64
    let tp: u64 = (&chr1[0 as usize]) as u64 + (CHR_TITLE + row * 4) * 8
    ch_title_text(tp, wx + bo + chr1[26] as i64, wy + chr1[27] as i64, schrift, limit, chr1[25])
    ch_win = ch_win + 1
}

fn ch_strip_buttons(wx: i64, wy: i64, ow: i64, focused: bool, slot: u64, flags: u64) {
    ch_caption(wx, wy, ow, focused, slot, (flags & F_MAXIMIZED) != 0)
    ch_win = ch_win + 1
}

// One cycle. Returns 0 = judged, 1 = the screen or the table moved (thrown away), 2 = could not look. Fills the counters.
static mut c_win: u64 = 0
static mut c_plain: u64 = 0
// r486: terminal windows (kind 1, painted by the kernel into a kernel-made shared buffer) composed in this cycle, and the judged pixels / differences that lie on them
static mut c_term: u64 = 0
static mut c_term_cmp: u64 = 0
static mut c_term_diff: u64 = 0
static mut c_cmp: u64 = 0
static mut c_diff: u64 = 0
static mut c_us: u64 = 0
static mut c_fx: u64 = 0
static mut c_fy: u64 = 0
static mut smp: [u64; 64] = [0 as u64; 64] // sample of 16 differing pixels: x, y, screen, ours
static mut smp_n: u64 = 0
static mut c_na: u64 = 0 // judged-area pixels the client left clear or translucent (not compared)
static mut c_bx0: u64 = 0
static mut c_by0: u64 = 0
static mut c_bx1: u64 = 0
static mut c_by1: u64 = 0
static mut c_lt: u64 = 0 // differing pixels where the screen is lighter than ours
static mut c_sv: u64 = 0 // the screen's pixel and ours at the first difference (for the log)
static mut c_bv: u64 = 0

fn cycle(t: u64) -> u64 {
    let t1: u64 = (&tab1[0 as usize]) as u64
    let t2: u64 = (&tab2[0 as usize]) as u64
    if !snap(t, t1) {
        return 1
    }
    // S6b: the chrome page of the same table sequence (colours, measures, hover, titles); without a consistent one the chrome is left alone
    ch_have = 0
    if chr_snap(t, (&chr1[0 as usize]) as u64) {
        ch_have = 1
    }
    // the screen, the first time
    if !read_screen(p_fba) {
        return 2
    }
    let px0: u64 = wlibc.mouse_x()
    let py0: u64 = wlibc.mouse_y()

    // 1. compose the plain client areas into the off-screen picture, in the order of the table (layer, then z), and keep the mask
    let tc0: u64 = tsc()
    let n: u64 = tab1[2]
    c_win = n
    var i: u64 = 0
    while i < n && i < MAXWIN {
        order[i as usize] = i
        i = i + 1
    }
    // insertion sort by layer, then z (row word 6: z | layer << 16 | kind << 24)
    var a: u64 = 1
    while a < n && a < MAXWIN {
        var b: u64 = a
        while b > 0 {
            let ka: u64 = tab1[(16 + order[(b - 1) as usize] * 12 + 6) as usize]
            let kb: u64 = tab1[(16 + order[b as usize] * 12 + 6) as usize]
            let la: u64 = (ka >> 16) & 0xFF
            let lb: u64 = (kb >> 16) & 0xFF
            var swap: bool = false
            if la > lb {
                swap = true
            } else if la == lb && (ka & 0xFFFF) > (kb & 0xFFFF) {
                swap = true
            }
            if swap {
                let tmp: u64 = order[(b - 1) as usize]
                order[(b - 1) as usize] = order[b as usize]
                order[b as usize] = tmp
                b = b - 1
            } else {
                b = 0
            }
        }
        a = a + 1
    }
    fill8((&mask[0 as usize]) as u64, 0, scr_w * scr_h)
    c_plain = 0
    c_term = 0
    sh_px = 0
    sh_win = 0
    ch_px = 0
    ch_win = 0
    ch_txt = 0
    ch_cap = 0
    var oi: u64 = 0
    while oi < n && oi < MAXWIN {
        let k: u64 = order[oi as usize]
        let r: u64 = 16 + k * 12
        let id: u64 = tab1[r as usize] & 0xFFFFFFFF
        let x: i64 = tab1[(r + 2) as usize] as i64
        let y: i64 = tab1[(r + 3) as usize] as i64
        let w: u64 = tab1[(r + 4) as usize]
        let h: u64 = tab1[(r + 5) as usize]
        let inx: u64 = tab1[(r + 8) as usize] & 0xFFFFFFFF
        let iny: u64 = tab1[(r + 8) as usize] >> 32
        let shm: u64 = tab1[(r + 9) as usize]
        let plain: u64 = (tab1[(r + 11) as usize] >> 32) & 1
        let ow: i64 = (w + 2 * inx) as i64
        let oh: i64 = (h + iny + inx) as i64
        // whatever stands here is covered by this window (and by its shadow): nothing below it can be judged
        // a hidden window (the start menu, the search, the toast ... waiting at 0,0) puts nothing on the screen: it neither covers nor paints
        let hidden: u64 = tab1[(r + 7) as usize] & 1
        // S6a: a plain framed window whose shadow numbers are on the table page: the shadow is composed here, so only the window itself is
        // taken out of the judged area (frame and title bar are not composed yet); everything else keeps the 48 points of margin
        let shadowed: u64 = (tab1[(r + 11) as usize] >> 33) & 1
        var sh_ok: bool = false
        if hidden == 0 && plain == 1 && shadowed == 1 && (tab1[9] & (1 << 32)) != 0 && (tab1[9] & (1 << 33)) == 0 {
            sh_ok = true
        }
        if hidden == 0 {
            if sh_ok {
                // the damage rectangle of the kernel: what lies outside it keeps whatever an earlier repaint left there (the shadow is only
                // painted inside the rectangle), so the ring outside is not judged; inside it, only the window itself is taken out
                var rr: i64 = ((tab1[8] >> 8) & 0xFF) as i64
                let rr2: i64 = ((tab1[8] >> 24) & 0xFF) as i64
                if rr2 > rr {
                    rr = rr2
                }
                if rr > SH_MAX as i64 {
                    rr = SH_MAX as i64
                }
                sh_cx0 = imax(x - rr, 0)
                sh_cy0 = imax(y - rr, 0)
                sh_cx1 = x + ow + rr + 1
                sh_cy1 = y + oh + rr + 1
                let ex: i64 = SHADOW as i64
                clear_mask_rect(x - ex, y - ex, x + ow + ex, sh_cy0)
                clear_mask_rect(x - ex, sh_cy1, x + ow + ex, y + oh + ex)
                clear_mask_rect(x - ex, sh_cy0, sh_cx0, sh_cy1)
                clear_mask_rect(sh_cx1, sh_cy0, x + ow + ex, sh_cy1)
                clear_mask_rect(x, y, x + ow, y + oh)
            } else {
                clear_mask_rect(x - SHADOW as i64, y - SHADOW as i64, x + ow + SHADOW as i64, y + oh + SHADOW as i64)
            }
        }
        if sh_ok {
            sh_build(tab1[8], tab1[9])
            var bank: u64 = 1
            var reach: u64 = (tab1[8] >> 24) & 0xFF
            var strength: u64 = (tab1[8] >> 16) & 0xFF
            if id == tab1[4] {
                bank = 0
                reach = (tab1[8] >> 8) & 0xFF
                strength = tab1[8] & 0xFF
            }
            if reach > SH_MAX {
                reach = SH_MAX
            }
            if strength != 0 && o_noshadow == 0 {
                sh_win = sh_win + 1
                sh_window(x, y, ow, oh, reach, bank, tab1[9] & 16777215, (tab1[8] >> 32) & 0xFF)
                // the geometry of the focused window's shadow, whenever it changes, for the gate (tools/comp/shadow.sh checks the picture just below it)
                let gk: u64 = (x as u64 & 0xFFFF) | ((y as u64 & 0xFFFF) << 16) | ((ow as u64 & 0xFFFF) << 32) | ((oh as u64 & 0xFFFF) << 48)
                if bank == 0 && geo_done != gk && o_noshadow == 0 {
                    geo_done = gk
                    var gl: [u8; 17] = "wmd: shadow-geo \0"
                    var gs: [u8; 2] = " \0"
                    ulib.say((&gl[0 as usize]) as u64)
                    ulib.sayu(x as u64)
                    ulib.say((&gs[0 as usize]) as u64)
                    ulib.sayu(y as u64)
                    ulib.say((&gs[0 as usize]) as u64)
                    ulib.sayu(ow as u64)
                    ulib.say((&gs[0 as usize]) as u64)
                    ulib.sayu(oh as u64)
                    ulib.say((&gs[0 as usize]) as u64)
                    ulib.sayu(reach)
                    ulib.nl()
                }
            }
        }
        var p: u64 = 0
        if hidden == 0 && plain == 1 && shm != 0 {
            p = buffer_of(k, id, w, h)
        }
        if p != 0 && w > 2 * MARGIN && h > 2 * MARGIN {
            c_plain = c_plain + 1
            let cx: i64 = x + inx as i64
            let cy: i64 = y + iny as i64
            let flags: u64 = tab1[(r + 7) as usize]
            // S6b: the frame, the title bar, the buttons and the title of a framed window are composed here too (when the chrome page is consistent
            // and the window is one this code knows how to paint: modern buttons, a title font, no network mark, the screen not locked)
            var chok: bool = false
            if sh_ok && ch_have == 1 && chr1[16] != 0 && chr1[29] == 1 && chr1[3] == 0xFF0000 && chr1[4] == 0xFF00 && chr1[5] == 0xFF
                && chr1[20] >= 1 && chr1[20] <= 4 && chr1[(CHR_MARK + k) as usize] == 0 && (tab1[7] & 1) == 0 {
                chok = true
            }
            let rad: u64 = chr1[14]
            let focused: bool = id == tab1[4]
            let capc: bool = (flags & F_CAPCLIENT) != 0
            if chok {
                if o_nochrome == 0 {
                    ch_window(k, x, y, ow, oh, focused, tab1[r as usize] >> 32, flags)
                } else {
                    // counter-proof: a hole in a colour no theme has, so the judge MUST see the frame it does not compose
                    ch_fill(x, y, ow, oh, 0xFF00FF, 255)
                }
            }
            // the rows of the client area that lie on the screen, copied with the library's row loop (the bottom corners, and the top ones of a window
            // with its own strip, keep what the rounded frame left there: the same skip as the kernel's)
            var ry: u64 = 0
            while ry < h {
                let sy: i64 = cy + ry as i64
                if sy >= 0 && sy < scr_h as i64 {
                    var lo: i64 = 0
                    var hi: i64 = w as i64
                    if chok && rad > 0 {
                        let dyb: i64 = y + oh - 1 - sy
                        if dyb >= 0 && dyb < rad as i64 {
                            let sk: i64 = ecke.corner_skip(rad, dyb as u64) as i64
                            if sk > 0 {
                                lo = imax(lo, sk)
                                hi = imin(hi, w as i64 - sk)
                            }
                        }
                        if capc && sy - y < rad as i64 {
                            let skt: i64 = ecke.corner_skip(rad, (sy - y) as u64) as i64
                            if skt > 0 {
                                lo = imax(lo, skt)
                                hi = imin(hi, w as i64 - skt)
                            }
                        }
                    }
                    lo = imax(lo, 0 - cx)
                    hi = imin(hi, scr_w as i64 - cx)
                    if hi > lo {
                        comp.copy_row((&sb[0 as usize]) as u64 + (sy as u64 * scr_w + (cx + lo) as u64) * 4, p + (ry * w + lo as u64) * 4, (hi - lo) as u64)
                    }
                }
                ry = ry + 1
            }
            if chok && capc && o_nochrome == 0 {
                ch_strip_buttons(x, y, ow, focused, tab1[r as usize] >> 32, flags)
            }
            // a client that paints its own title strip (flag 64) has the server's caption buttons drawn over it: that band is not judged
            // (unless the chrome is composed here)
            var top: i64 = MARGIN as i64
            if (flags & F_CAPCLIENT) != 0 && !chok {
                top = CAPBAND as i64
            }
            if chok {
                // the whole outer rectangle is judged: pixels over the wallpaper-less corners are skipped by the "not opaque" rule
                mask_rect(x, y, x + ow, y + oh, 1)
                chrome_geo(k, x, y, ow, oh, focused, capc)
            }
            // r486: a terminal window (kind 1) marks its pixels with 2, so the judge can say how much of what it compared was terminal
            var mv: u64 = 1
            if ((tab1[(r + 6) as usize] >> 24) & 0xFF) == 1 {
                mv = 2
                c_term = c_term + 1
            }
            mask_rect(cx + MARGIN as i64, cy + top, cx + w as i64 - MARGIN as i64, cy + h as i64 - MARGIN as i64, mv)
        }
        oi = oi + 1
    }
    c_us = us_of(tsc() - tc0)
    // not near the pointer
    clear_mask_rect(px0 as i64 - 8, py0 as i64 - 8, px0 as i64 + PTR_W as i64, py0 as i64 + PTR_H as i64)

    // 2. the screen, the second time, and the table: nothing may have moved
    if !read_screen(p_fbb) {
        return 2
    }
    if !snap(t, t2) || !same_tab() {
        return 1
    }
    if tab1[5] != tab2[5] {
        return 1
    }
    if ch_have == 1 {
        if !chr_snap(t, (&chr2[0 as usize]) as u64) || !same_chr() {
            return 1
        }
    }
    // 3. compare, where the mask says the pixel can be judged and the screen held still
    c_cmp = 0
    c_term_cmp = 0
    c_term_diff = 0
    c_diff = 0
    c_fx = 0
    c_fy = 0
    c_na = 0
    smp_n = 0
    var yy: u64 = 0
    var moved: u64 = 0
    while yy < scr_h {
        var xx: u64 = 0
        while xx < scr_w {
            let at: u64 = yy * scr_w + xx
            if mask[at as usize] != 0 {
                if mask[at as usize] != 2 && (sb[at as usize] >> 24 as u32) != 255 as u32 {
                    // a pixel the client left clear or translucent: the server paints what lies behind it (wallpaper, blur), not ours
                    c_na = c_na + 1
                } else if __mmio_read32((p_fba + at * 4) as *mut u32) != __mmio_read32((p_fbb + at * 4) as *mut u32) {
                    moved = moved + 1
                } else {
                    c_cmp = c_cmp + 1
                    if mask[at as usize] == 2 {
                        c_term_cmp = c_term_cmp + 1
                    }
                    if __mmio_read32((p_fba + at * 4) as *mut u32) != (sb[at as usize] & 16777215 as u32) {
                        if mask[at as usize] == 2 {
                            c_term_diff = c_term_diff + 1
                        }
                        if c_diff == 0 {
                            c_fx = xx
                            c_fy = yy
                            c_sv = __mmio_read32((p_fba + at * 4) as *mut u32) as u64
                            c_bv = sb[at as usize] as u64
                        }
                        if smp_n < 16 && c_diff % 97 == 0 {
                            smp[(smp_n * 4) as usize] = xx
                            smp[(smp_n * 4 + 1) as usize] = yy
                            smp[(smp_n * 4 + 2) as usize] = __mmio_read32((p_fba + at * 4) as *mut u32) as u64
                            smp[(smp_n * 4 + 3) as usize] = sb[at as usize] as u64
                            smp_n = smp_n + 1
                        }
                        if c_diff == 0 {
                            c_bx0 = xx
                            c_bx1 = xx
                            c_by0 = yy
                            c_lt = 0
                        }
                        if xx < c_bx0 {
                            c_bx0 = xx
                        }
                        if xx > c_bx1 {
                            c_bx1 = xx
                        }
                        c_by1 = yy
                        if __mmio_read32((p_fba + at * 4) as *mut u32) > (sb[at as usize] & 16777215 as u32) {
                            c_lt = c_lt + 1
                        }
                        c_diff = c_diff + 1
                    }
                }
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
    if moved != 0 && c_cmp == 0 {
        return 1
    }
    return 0
}

fn run_observe(args: u64) -> u64 {
    var n_cycle: [u8; 12] = "wmd: cycle \0"
    var n_win: [u8; 10] = " windows=\0"
    var n_pl: [u8; 8] = " plain=\0"
    var n_cmp: [u8; 11] = " compared=\0"
    var n_df: [u8; 9] = " differ=\0"
    var n_us: [u8; 13] = " compose_us=\0"
    var n_first: [u8; 8] = " first=\0"
    var n_row: [u8; 10] = "wmd: row \0"
    var n_sp: [u8; 2] = " \0"
    var n_smp: [u8; 13] = "wmd: sample \0"
    var n_na: [u8; 12] = " notopaque=\0"
    var n_sv: [u8; 5] = " sv=\0"
    var n_bv: [u8; 5] = " bv=\0"
    var n_un: [u8; 15] = "wmd: unstable \0"
    var n_sum: [u8; 14] = "wmd: summary \0"
    var n_cyc: [u8; 8] = "cycles=\0"
    var n_good: [u8; 7] = " good=\0"
    var n_tot: [u8; 11] = " compared=\0"
    var n_dif: [u8; 9] = " differ=\0"
    var n_max: [u8; 13] = " compose_us=\0"
    var n_ready: [u8; 19] = "wmd: ready screen=\0"
    var n_nofb: [u8; 15] = "wmd: no screen\0"
    var n_notab: [u8; 14] = "wmd: no table\0"
    var n_x: [u8; 2] = "x\0"
    var n_c: [u8; 2] = ",\0"
    var n_chw: [u8; 9] = " chrome=\0"
    var n_chp: [u8; 11] = " chromepx=\0"
    var n_tx: [u8; 10] = " titlepx=\0"
    var n_cp: [u8; 9] = " capspx=\0"
    var n_hv: [u8; 8] = " hover=\0"
    var l_nochr: [u8; 10] = "nochrome=\0"
    var n_shw: [u8; 9] = " shadow=\0"
    var n_shp: [u8; 11] = " shadowpx=\0"
    var n_trm: [u8; 7] = " term=\0"
    var n_trp: [u8; 9] = " termpx=\0"
    var n_trd: [u8; 11] = " termdiff=\0"
    var l_nosh: [u8; 10] = "noshadow=\0"
    var n_bb: [u8; 7] = " bbox=\0"
    var n_lt: [u8; 8] = " light=\0"

    wlibc.start(false)
    o_noshadow = arg_num(args, (&l_nosh[0 as usize]) as u64, 0)
    o_nochrome = arg_num(args, (&l_nochr[0 as usize]) as u64, 0)
    p_fba = wlibc.shm_buffer(MAXPX * 4)
    p_fbb = wlibc.shm_buffer(MAXPX * 4)
    scr_w = wlibc.screen_w()
    scr_h = wlibc.screen_h()
    pitch = ulib.sys(SYS_DISPGET, DG_PITCH, 0, 0)
    let rawbpp: u64 = ulib.sys(SYS_DISPGET, DG_BPP, 0, 0)
    bpp = 0
    if !ulib.bad(rawbpp) {
        bpp = rawbpp / 8
    }
    if ulib.bad(pitch) || pitch == 0 {
        pitch = scr_w * 4
    }
    if ulib.bad(bpp) || bpp == 0 {
        bpp = 4
    }
    if p_fba == 0 || p_fbb == 0 {
        ulib.say((&n_nofb[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    if scr_w == 0 || scr_h == 0 || scr_w * scr_h > MAXPX || scr_w * bpp > 8192 || bpp != 4 {
        ulib.say((&n_nofb[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    calibrate()
    let tfd: u64 = wlibc.sys3w(WM_TABLE, 0, 0, 0)
    if ulib.bad(tfd) {
        ulib.say((&n_notab[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    let t: u64 = mmap_fd(tfd, 4096)
    if ulib.bad(t) || t == 0 {
        ulib.say((&n_notab[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    // S6b: the chrome page (root only); without it the program judges as before
    let cfd: u64 = wlibc.sys3w(WM_TABLE, 1, 0, 0)
    if !ulib.bad(cfd) {
        let cm: u64 = mmap_fd(cfd, 4096)
        if !ulib.bad(cm) && cm != 0 {
            p_chr = cm
        }
        wlibc.shm_close(cfd)
    }
    ulib.say((&n_ready[0 as usize]) as u64)
    ulib.sayu(scr_w)
    ulib.say((&n_x[0 as usize]) as u64)
    ulib.sayu(scr_h)
    ulib.nl()

    var cycles: u64 = 0
    var good: u64 = 0
    var tot: u64 = 0
    var dif: u64 = 0
    var maxus: u64 = 0
    var tries: u64 = 0
    // every ~1.5 s for as long as the harness lets us live
    while tries < 160 {
        tries = tries + 1
        let rc: u64 = cycle(t)
        if rc == 0 {
            cycles = cycles + 1
            ulib.say((&n_cycle[0 as usize]) as u64)
            ulib.sayu(cycles)
            ulib.say((&n_win[0 as usize]) as u64)
            ulib.sayu(c_win)
            ulib.say((&n_pl[0 as usize]) as u64)
            ulib.sayu(c_plain)
            ulib.say((&n_cmp[0 as usize]) as u64)
            ulib.sayu(c_cmp)
            ulib.say((&n_df[0 as usize]) as u64)
            ulib.sayu(c_diff)
            ulib.say((&n_na[0 as usize]) as u64)
            ulib.sayu(c_na)
            ulib.say((&n_us[0 as usize]) as u64)
            ulib.sayu(c_us)
            ulib.say((&n_shw[0 as usize]) as u64)
            ulib.sayu(sh_win)
            ulib.say((&n_shp[0 as usize]) as u64)
            ulib.sayu(sh_px)
            ulib.say((&n_trm[0 as usize]) as u64)
            ulib.sayu(c_term)
            ulib.say((&n_trp[0 as usize]) as u64)
            ulib.sayu(c_term_cmp)
            ulib.say((&n_trd[0 as usize]) as u64)
            ulib.sayu(c_term_diff)
            ulib.say((&n_chw[0 as usize]) as u64)
            ulib.sayu(ch_win)
            ulib.say((&n_chp[0 as usize]) as u64)
            ulib.sayu(ch_px)
            ulib.say((&n_tx[0 as usize]) as u64)
            ulib.sayu(ch_txt)
            ulib.say((&n_cp[0 as usize]) as u64)
            ulib.sayu(ch_cap)
            ulib.say((&n_hv[0 as usize]) as u64)
            ulib.sayu(chr1[22])
            if c_diff != 0 {
                ulib.say((&n_first[0 as usize]) as u64)
                ulib.sayu(c_fx)
                ulib.say((&n_c[0 as usize]) as u64)
                ulib.sayu(c_fy)
                ulib.say((&n_sv[0 as usize]) as u64)
                ulib.sayu(c_sv)
                ulib.say((&n_bv[0 as usize]) as u64)
                ulib.sayu(c_bv)
                ulib.say((&n_bb[0 as usize]) as u64)
                ulib.sayu(c_bx0)
                ulib.say((&n_c[0 as usize]) as u64)
                ulib.sayu(c_by0)
                ulib.say((&n_c[0 as usize]) as u64)
                ulib.sayu(c_bx1)
                ulib.say((&n_c[0 as usize]) as u64)
                ulib.sayu(c_by1)
                ulib.say((&n_lt[0 as usize]) as u64)
                ulib.sayu(c_lt)
            }
            ulib.nl()
            if cycles == 3 && smp_n > 0 {
                var si3: u64 = 0
                while si3 < smp_n {
                    ulib.say((&n_smp[0 as usize]) as u64)
                    ulib.sayu(smp[(si3 * 4) as usize])
                    ulib.say((&n_c[0 as usize]) as u64)
                    ulib.sayu(smp[(si3 * 4 + 1) as usize])
                    ulib.say((&n_sv[0 as usize]) as u64)
                    ulib.sayu(smp[(si3 * 4 + 2) as usize])
                    ulib.say((&n_bv[0 as usize]) as u64)
                    ulib.sayu(smp[(si3 * 4 + 3) as usize])
                    ulib.nl()
                    si3 = si3 + 1
                }
            }
            if cycles == 40 {
                var rk: u64 = 0
                while rk < c_win && rk < MAXWIN {
                    ulib.say((&n_row[0 as usize]) as u64)
                    var wk: u64 = 0
                    while wk < 12 {
                        ulib.sayu(tab1[(16 + rk * 12 + wk) as usize])
                        ulib.say((&n_sp[0 as usize]) as u64)
                        wk = wk + 1
                    }
                    ulib.nl()
                    rk = rk + 1
                }
            }
            if cycles == 40 && smp_n > 0 {
                var si: u64 = 0
                while si < smp_n {
                    ulib.say((&n_smp[0 as usize]) as u64)
                    ulib.sayu(smp[(si * 4) as usize])
                    ulib.say((&n_c[0 as usize]) as u64)
                    ulib.sayu(smp[(si * 4 + 1) as usize])
                    ulib.say((&n_sv[0 as usize]) as u64)
                    ulib.sayu(smp[(si * 4 + 2) as usize])
                    ulib.say((&n_bv[0 as usize]) as u64)
                    ulib.sayu(smp[(si * 4 + 3) as usize])
                    ulib.nl()
                    si = si + 1
                }
            }
            if c_cmp > 0 && c_diff == 0 {
                good = good + 1
            }
            tot = tot + c_cmp
            dif = dif + c_diff
            if c_us > maxus {
                maxus = c_us
            }
        } else {
            ulib.say((&n_un[0 as usize]) as u64)
            ulib.sayu(rc)
            ulib.nl()
        }
        if cycles >= 70 {
            tries = 160
        } else {
            let _s: u64 = ulib.sleep_ms(1500)
        }
    }
    ulib.say((&n_sum[0 as usize]) as u64)
    ulib.say((&n_cyc[0 as usize]) as u64)
    ulib.sayu(cycles)
    ulib.say((&n_good[0 as usize]) as u64)
    ulib.sayu(good)
    ulib.say((&n_tot[0 as usize]) as u64)
    ulib.sayu(tot)
    ulib.say((&n_dif[0 as usize]) as u64)
    ulib.sayu(dif)
    ulib.say((&n_max[0 as usize]) as u64)
    ulib.sayu(maxus)
    ulib.nl()
    var k: u64 = 0
    while k < 60 {
        let _z: u64 = ulib.sleep_ms(1000)
        k = k + 1
    }
    return 0
}

// ---------------------------------------------------------------------------------------------------------------------------
// S5 -- `wmd present`: THE COMPOSITOR THAT SHOWS THE FRAMES (docs/COMPOSITOR.md section 4)
//
// The kernel still paints the picture; with this program attached (WM_COMP / CP_ATTACH) it does not push a finished rectangle to the card but
// hands it over and wakes us. We sleep in CP_WAIT (wake driven: the same wake-up `poll` uses), then CP_PRESENT shows the rectangle. The kernel keeps
// a watchdog: a rectangle that waits longer than 50 ms is shown by the kernel (a miss), three misses in a row or our death detach us and the kernel
// presents every frame itself again. We also read the input copy ring (pointer moves, button changes, shortcut keys) the kernel writes while the screen
// is not locked and no trusted dialog is up.
//
// Test hooks (arguments, `wigapp=/bin/wmd,present,slow=80`): `slow=<ms>` sleeps before every present (a compositor that is too slow),
// `hangon=<n>` stops presenting for good after the n-th button press (a hang: alive, silent), `dieon=<n>` exits at the n-th button press (a crash).
// Every second it prints:  wmd: present frames= shown= px= ev= move= btn= key= keycode= lost= busy= errors=

const WM_COMP: u64 = 2144
const CP_ATTACH: u64 = 0
const CP_WAIT: u64 = 1
const CP_PRESENT: u64 = 2
const CP_PAGE: u64 = 3
const CPR_AT: u64 = 16
const CPR_N: u64 = 64

fn rd8(p: u64) -> u64 {
    return __mmio_read8(p as *mut u8) as u64
}

fn rd64(p: u64) -> u64 {
    return __mmio_read64(p as *mut u64)
}

// does the zero-terminated string at `p` start with the zero-terminated `lit`?
fn has_prefix(p: u64, lit: u64) -> bool {
    var i: u64 = 0
    while rd8(lit + i) != 0 {
        if rd8(p + i) != rd8(lit + i) {
            return false
        }
        i = i + 1
    }
    return true
}

// the number after `lit` ("slow=") in one of the arguments, or `def`
fn arg_num(args: u64, lit: u64, def: u64) -> u64 {
    var len: u64 = 0
    while rd8(lit + len) != 0 {
        len = len + 1
    }
    var i: u64 = 1
    let n: u64 = ulib.arg_count(args)
    while i < n {
        let a: u64 = ulib.arg_at(args, i)
        if has_prefix(a, lit) {
            return ulib.to_num(a + len)
        }
        i = i + 1
    }
    return def
}

static mut pr_frames: u64 = 0
static mut pr_shown: u64 = 0
static mut pr_px: u64 = 0
static mut pr_ev: u64 = 0
static mut pr_move: u64 = 0
static mut pr_btn: u64 = 0
static mut pr_key: u64 = 0
static mut pr_code: u64 = 0
static mut pr_lost: u64 = 0
static mut pr_busy: u64 = 0
static mut pr_err: u64 = 0
static mut pr_att: u64 = 1

fn pr_report() {
    var n_p: [u8; 21] = "wmd: present frames=\0"
    var n_s: [u8; 8] = " shown=\0"
    var n_x: [u8; 5] = " px=\0"
    var n_e: [u8; 5] = " ev=\0"
    var n_m: [u8; 7] = " move=\0"
    var n_b: [u8; 6] = " btn=\0"
    var n_k: [u8; 6] = " key=\0"
    var n_c: [u8; 10] = " keycode=\0"
    var n_l: [u8; 7] = " lost=\0"
    var n_y: [u8; 7] = " busy=\0"
    var n_r: [u8; 9] = " errors=\0"
    var n_a: [u8; 7] = " atts=\0"
    ulib.say((&n_p[0 as usize]) as u64)
    ulib.sayu(pr_frames)
    ulib.say((&n_s[0 as usize]) as u64)
    ulib.sayu(pr_shown)
    ulib.say((&n_x[0 as usize]) as u64)
    ulib.sayu(pr_px)
    ulib.say((&n_e[0 as usize]) as u64)
    ulib.sayu(pr_ev)
    ulib.say((&n_m[0 as usize]) as u64)
    ulib.sayu(pr_move)
    ulib.say((&n_b[0 as usize]) as u64)
    ulib.sayu(pr_btn)
    ulib.say((&n_k[0 as usize]) as u64)
    ulib.sayu(pr_key)
    ulib.say((&n_c[0 as usize]) as u64)
    ulib.sayu(pr_code)
    ulib.say((&n_l[0 as usize]) as u64)
    ulib.sayu(pr_lost)
    ulib.say((&n_y[0 as usize]) as u64)
    ulib.sayu(pr_busy)
    ulib.say((&n_r[0 as usize]) as u64)
    ulib.sayu(pr_err)
    ulib.say((&n_a[0 as usize]) as u64)
    ulib.sayu(pr_att)
    ulib.nl()
}

fn run_present(args: u64) -> u64 {
    var l_slow: [u8; 6] = "slow=\0"
    var l_hang: [u8; 8] = "hangon=\0"
    var l_die: [u8; 7] = "dieon=\0"
    var n_att: [u8; 14] = "wmd: attached\0"
    var n_ref: [u8; 20] = "wmd: attach refused\0"
    var n_nop: [u8; 13] = "wmd: no page\0"
    var n_hang: [u8; 17] = "wmd: hanging now\0"
    var n_dying: [u8; 15] = "wmd: dying now\0"
    var n_wer: [u8; 17] = "wmd: wait failed\0"
    var n_rea: [u8; 16] = "wmd: reattached\0"
    var l_rea: [u8; 10] = "reattach=\0"
    wlibc.start(false)
    let slow: u64 = arg_num(args, (&l_slow[0 as usize]) as u64, 0)
    let hangon: u64 = arg_num(args, (&l_hang[0 as usize]) as u64, 0)
    let dieon: u64 = arg_num(args, (&l_die[0 as usize]) as u64, 0)
    let reattach_ms: u64 = arg_num(args, (&l_rea[0 as usize]) as u64, 500)
    let r: u64 = ulib.sys(WM_COMP, CP_ATTACH, 0, 0)
    if ulib.bad(r) {
        ulib.say((&n_ref[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    let pfd: u64 = ulib.sys(WM_COMP, CP_PAGE, 0, 0)
    var page: u64 = 0
    if !ulib.bad(pfd) {
        page = mmap_fd(pfd, 4096)
        if ulib.bad(page) {
            page = 0
        }
    }
    if page == 0 {
        ulib.say((&n_nop[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    ulib.say((&n_att[0 as usize]) as u64)
    ulib.nl()
    var seen: u64 = 0
    var tail: u64 = 0
    var presses: u64 = 0
    var held: u64 = 0
    var hanging: bool = false
    var last_say: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    var dirty_say: bool = false
    while true {
        if hanging {
            // alive and silent: no wait, no present
            let _s: u64 = ulib.sleep_ms(200)
        } else {
            var f: u64 = ulib.sys(WM_COMP, CP_WAIT, seen, 100)
            if ulib.bad(f) {
                // detached by the kernel (the watchdog took the screen back): the kernel shows the frames now. Wait a little so that the
                // start-up storm is over, then attach again (a new compositor re-attaches to the table and the buffers, section 3, point 5).
                ulib.say((&n_wer[0 as usize]) as u64)
                ulib.nl()
                pr_report()
                let _w: u64 = ulib.sleep_ms(reattach_ms)
                let r2: u64 = ulib.sys(WM_COMP, CP_ATTACH, 0, 0)
                if ulib.bad(r2) {
                    pr_err = pr_err + 1
                } else {
                    pr_att = pr_att + 1
                    ulib.say((&n_rea[0 as usize]) as u64)
                    ulib.nl()
                }
                seen = 0
                f = 0
            }
            if f != seen {
                if slow != 0 {
                    let _z: u64 = ulib.sleep_ms(slow)
                }
                seen = f
                pr_frames = pr_frames + 1
                var px: u64 = ulib.sys(WM_COMP, CP_PRESENT, 0, 0)
                var tries: u64 = 0
                while ulib.bad(px) && tries < 8 {
                    // busy: the compose lock did not come free in time (its holder may have been preempted): give the CPU away, once more
                    pr_busy = pr_busy + 1
                    let _y: u64 = ulib.sleep_ms(1)
                    px = ulib.sys(WM_COMP, CP_PRESENT, 0, 0)
                    tries = tries + 1
                }
                if ulib.bad(px) {
                    pr_err = pr_err + 1
                    px = 0
                }
                if px != 0 {
                    pr_shown = pr_shown + 1
                    pr_px = pr_px + px
                }
                dirty_say = true
            }
        }
        // the input copy ring
        let head: u64 = rd64(page + 16)
        if head > tail + CPR_N {
            pr_lost = pr_lost + (head - CPR_N - tail)
            tail = head - CPR_N
        }
        while tail < head {
            let at: u64 = page + (CPR_AT + (tail % CPR_N) * 4) * 8
            let w0: u64 = rd64(at)
            if (w0 >> 32) != tail + 1 {
                pr_lost = pr_lost + 1
            } else {
                let typ: u64 = w0 & 0xFF
                let btn: u64 = (w0 >> 16) & 0xFF
                pr_ev = pr_ev + 1
                if typ == 1 {
                    pr_move = pr_move + 1
                } else if typ == 2 {
                    pr_btn = pr_btn + 1
                    if (btn & 1) != 0 && (held & 1) == 0 {
                        presses = presses + 1
                        if hangon != 0 && presses == hangon {
                            ulib.say((&n_hang[0 as usize]) as u64)
                            ulib.nl()
                            pr_report()
                            hanging = true
                        }
                        if dieon != 0 && presses == dieon {
                            ulib.say((&n_dying[0 as usize]) as u64)
                            ulib.nl()
                            pr_report()
                            return 0
                        }
                    }
                    held = btn
                } else if typ == 3 {
                    pr_key = pr_key + 1
                    if rd64(at + 16) != 0 {
                        pr_code = pr_code + 1
                    }
                }
                dirty_say = true
            }
            tail = tail + 1
        }
        let now: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
        if dirty_say && now >= last_say + 100 {
            pr_report()
            last_say = now
            dirty_say = false
        }
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var l_present: [u8; 8] = "present\0"
    if ulib.arg_count(args) > 1 && has_prefix(ulib.arg_at(args, 1), (&l_present[0 as usize]) as u64) {
        return run_present(args)
    }
    return run_observe(args)
}
