// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/standby.fi -- K-004b: `/bin/standby`, suspend to RAM.
//
// Writes the buffers out first (a machine in S3 that loses power is a
// machine that was switched off), then asks the kernel for S3 with
// reboot(RB_SUSPEND). The call RETURNS when the machine wakes up --
// the program is still running then, and it says so.
//
// Answers of the kernel (kernel/sys/sys.fi, do_reboot):
//     0        slept and came back
//     -EBUSY   more than one processor online (K-004c)
//     -ENOMEM  no memory for the save area
//     -ENOSYS  the machine offers no S3, or it did not go to sleep
//     -EPERM   not root

profile kernel

import ulib

export { u_start }

const SYS_REBOOT: u64 = 169
const RB_SUSPEND: u64 = 0x53335333

static mut S_GO: [u8; 30] = "standby: schlafe (S3) ...\n\0\0\0\0"
static mut S_BACK: [u8; 24] = "standby: zurueck, rc=\0\0\0"
static mut S_FAIL: [u8; 35] = "standby: kein Standby moeglich rc=\0"

fn u_start(args: u64) -> u64 {
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.say((&S_GO[0 as usize]) as u64)
    let rc: u64 = ulib.sys(SYS_REBOOT, RB_SUSPEND, 0, 0)
    if rc == 0 {
        ulib.say_line((&S_BACK[0 as usize]) as u64, rc)
        return 0
    }
    ulib.say_line((&S_FAIL[0 as usize]) as u64, rc)
    return 1
}
