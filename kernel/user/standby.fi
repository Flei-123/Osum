
profile kernel

import ulib

import libc.clockapi
export { u_start }

const SYS_REBOOT: u64 = 169
const RB_SUSPEND: u64 = 0x53335333

static mut S_WISH: [u8; 26] = "standby: wunsch gestellt\n\0"
static mut S_ANS: [u8; 16] = "standby: reply=\0"
static mut O_WISH: [u8; 7] = "--wish\0"
static mut O_RTC: [u8; 6] = "--rtc\0"
static mut S_RTC_USAGE: [u8; 33] = "standby: --rtc needs 1..3600 sec\0"
static mut S_RTC_ARM: [u8; 26] = "standby: rtc wake in sec=\0"
const RTC_MAX_SECS: u64 = 3600
const RTC_BAD: u64 = 0xFFFFFFFF
const SYS_LOCK: u64 = 1870
static mut S_GO: [u8; 30] = "standby: schlafe (S3) ...\n\0\0\0\0"
static mut S_BACK: [u8; 24] = "standby: zurueck, rc=\0\0\0"
static mut S_FAIL: [u8; 35] = "standby: kein Standby moeglich rc=\0"

fn wish() -> u64 {
    ulib.sys(SYS_LOCK, 11, 0, 0)
    ulib.say((&S_WISH[0 as usize]) as u64)
    var k: u64 = 0
    while k < 1200 {
        let rc: u64 = ulib.sys(SYS_LOCK, 12, 0, 0)
        if !ulib.bad(rc) && rc != 0 {
            ulib.say((&S_ANS[0 as usize]) as u64)
            ulib.sayu(rc)
            ulib.nl()
            if rc == 1 {
                return 0
            }
            return 1
        }
        clockapi.sleep_ms(50)
        k = k + 1
    }
    return 2
}

fn wake_secs(args: u64) -> u64 {
    if !(ulib.arg_count(args) > 1 && ulib.streq(ulib.arg_at(args, 1), (&O_RTC[0 as usize]) as u64)) {
        return 0
    }
    if ulib.arg_count(args) < 3 {
        return RTC_BAD
    }
    let secs: u64 = ulib.to_num(ulib.arg_at(args, 2))
    if secs == 0 || secs > RTC_MAX_SECS {
        return RTC_BAD
    }
    return secs
}

fn u_start(args: u64) -> u64 {
    let secs: u64 = wake_secs(args)
    if secs == RTC_BAD {
        ulib.say((&S_RTC_USAGE[0 as usize]) as u64)
        ulib.nl()
        return 2
    }
    if ulib.arg_count(args) > 1 && ulib.streq(ulib.arg_at(args, 1), (&O_WISH[0 as usize]) as u64) {
        return wish()
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    if secs != 0 {
        ulib.say_line((&S_RTC_ARM[0 as usize]) as u64, secs)
    }
    ulib.say((&S_GO[0 as usize]) as u64)
    let rc: u64 = ulib.sys(SYS_REBOOT, RB_SUSPEND, secs, 0)
    if rc == 0 {
        ulib.say_line((&S_BACK[0 as usize]) as u64, rc)
        return 0
    }
    ulib.say_line((&S_FAIL[0 as usize]) as u64, rc)
    return 1
}
