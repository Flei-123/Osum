// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import ulib

export { product, slug, vendor, web, core_name, feed, reload }

const RAW_MAX: u64 = 512
const NAME_MAX: u64 = 40
const URL_MAX: u64 = 100

static mut raw: [u8; 512] = [0 as u8; 512]
static mut v_product: [u8; 40] = [0 as u8; 40]
static mut v_slug: [u8; 40] = [0 as u8; 40]
static mut v_vendor: [u8; 40] = [0 as u8; 40]
static mut v_web: [u8; 100] = [0 as u8; 100]
static mut v_core: [u8; 40] = [0 as u8; 40]
static mut v_feed: [u8; 100] = [0 as u8; 100]
static mut loaded: bool = false

fn read_proc() -> u64 {
    var path: [u8; 12] = "/proc/brand\0"
    ulib.fill((&raw[0 as usize]) as u64, 0, RAW_MAX)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&path[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return 0
    }
    var at: u64 = 1
    var going: bool = true
    while going && at < RAW_MAX - 1 {
        let got: u64 = ulib.sys(ulib.SYS_READ, fd, (&raw[0 as usize]) as u64 + at, RAW_MAX - 1 - at)
        if got == 0 || ulib.bad(got) {
            going = false
        } else {
            at = at + got
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return at
}

fn take(key: u64, dst: u64, cap: u64) {
    ulib.fill(dst, 0, cap)
    let pos: u64 = ulib.find((&raw[0 as usize]) as u64, key)
    if pos == ulib.EOF {
        return
    }
    var i: u64 = pos + ulib.length(key)
    var n: u64 = 0
    var b: u64 = (*(((&raw[0 as usize]) as u64 + i) as *mut u8)) as u64
    while b != 0 && b != 10 && n + 1 < cap {
        __mmio_write8((dst + n) as *mut u8, b as u8)
        n = n + 1
        i = i + 1
        b = (*(((&raw[0 as usize]) as u64 + i) as *mut u8)) as u64
    }
}

fn reload() {
    var k_product: [u8; 10] = "\nproduct=\0"
    var k_slug: [u8; 7] = "\nslug=\0"
    var k_vendor: [u8; 9] = "\nvendor=\0"
    var k_web: [u8; 6] = "\nweb=\0"
    var k_core: [u8; 7] = "\ncore=\0"
    var k_feed: [u8; 7] = "\nfeed=\0"
    read_proc()
    __mmio_write8(((&raw[0 as usize]) as u64) as *mut u8, 10 as u8)
    take((&k_product[0 as usize]) as u64, (&v_product[0 as usize]) as u64, NAME_MAX)
    take((&k_slug[0 as usize]) as u64, (&v_slug[0 as usize]) as u64, NAME_MAX)
    take((&k_vendor[0 as usize]) as u64, (&v_vendor[0 as usize]) as u64, NAME_MAX)
    take((&k_web[0 as usize]) as u64, (&v_web[0 as usize]) as u64, URL_MAX)
    take((&k_core[0 as usize]) as u64, (&v_core[0 as usize]) as u64, NAME_MAX)
    take((&k_feed[0 as usize]) as u64, (&v_feed[0 as usize]) as u64, URL_MAX)
    loaded = true
}

fn ensure() {
    if !loaded {
        reload()
    }
}

fn product() -> u64 {
    ensure()
    return (&v_product[0 as usize]) as u64
}

fn slug() -> u64 {
    ensure()
    return (&v_slug[0 as usize]) as u64
}

fn vendor() -> u64 {
    ensure()
    return (&v_vendor[0 as usize]) as u64
}

fn web() -> u64 {
    ensure()
    return (&v_web[0 as usize]) as u64
}

fn core_name() -> u64 {
    ensure()
    return (&v_core[0 as usize]) as u64
}

fn feed() -> u64 {
    ensure()
    return (&v_feed[0 as usize]) as u64
}
