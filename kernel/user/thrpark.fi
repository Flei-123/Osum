profile app

import ulib
import libc.threads
import lineout

export { u_start }

const THREADS: u64 = 6
const PARK_MS: u64 = 1000
const MAX_ARGS: u64 = 8

static mut s_ready: [u8; 23] = "thrpark: threads up n=\0"

fn park(arg: u64) -> u64 {
    var going: bool = true
    while going {
        threads.sleep_ms(PARK_MS)
    }
    return arg
}

fn start_child(args: u64) {
    let n: u64 = ulib.arg_count(args)
    if n < 2 || n > MAX_ARGS {
        return
    }
    var av: [u64; 8] = [0 as u64; 8]
    var k: u64 = 1
    while k < n {
        av[(k - 1) as usize] = ulib.arg_at(args, k)
        k = k + 1
    }
    let _pid: u64 = ulib.spawn_app(av[0], (&av[0]) as u64, n - 1)
}

fn u_start(args: u64) -> u64 {
    var made: u64 = 0
    var i: u64 = 0
    while i < THREADS {
        if threads.spawn(park, i) != 0 {
            made = made + 1
        }
        i = i + 1
    }
    lineout.add_text((&s_ready[0]) as u64)
    lineout.add_num(made)
    lineout.end_line()
    start_child(args)
    return park(0)
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
