// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/id.fi -- Runde K13: wer bin ich, in Zahlen und in Namen.
//
//     id            uid=0(root) gid=0(root) euid=0(root) egid=0(root)
//     id -u         0
//     id -un        root
//     id NAME       die Kennungen aus /etc/passwd zu diesem Namen
//
// Die Namen kommen aus /etc/passwd. Steht dort keiner, wird KEINER
// erfunden -- dann bleibt die Zahl allein stehen, so wie bei jedem
// anderen Unix auch.

profile kernel

import ulib
import tools
import pw
import grp

export { u_start }

const SYS_GETUID: u64 = 102
const SYS_GETGID: u64 = 104
const SYS_GETEUID: u64 = 107
const SYS_GETEGID: u64 = 108
// RUNDE MULTIUSER: die echte Linux-Nummer, nachgewiesen frei.
const SYS_GETGROUPS: u64 = 115

fn part(label: u64, v: u64, wantname: bool) {
    var nm: [u8; 64] = [0 as u8; 64]
    var op: [u8; 2] = "(\0"
    var cl: [u8; 2] = ")\0"
    tools.ob_str(label)
    tools.ob_num(v)
    if wantname {
        if pw.name_of_uid(v, (&nm[0]) as u64, 64) {
            tools.ob_str((&op[0]) as u64)
            tools.ob_str((&nm[0]) as u64)
            tools.ob_str((&cl[0]) as u64)
        }
    }
}

fn u_start(args: u64) -> u64 {
    var l_uid: [u8; 5] = "uid=\0"
    var l_gid: [u8; 6] = " gid=\0"
    var l_eu: [u8; 7] = " euid=\0"
    var l_eg: [u8; 7] = " egid=\0"
    var o_u: [u8; 3] = "-u\0"
    var o_g: [u8; 3] = "-g\0"
    var o_n: [u8; 4] = "-un\0"
    var o_gn: [u8; 4] = "-gn\0"
    var e_no: [u8; 22] = "id: no such user: \0\0\0\0"
    var nm: [u8; 64] = [0 as u8; 64]

    var uid: u64 = ulib.sys(SYS_GETUID, 0, 0, 0)
    var gid: u64 = ulib.sys(SYS_GETGID, 0, 0, 0)
    var euid: u64 = ulib.sys(SYS_GETEUID, 0, 0, 0)
    var egid: u64 = ulib.sys(SYS_GETEGID, 0, 0, 0)

    var i: u64 = 1
    var only: u64 = 0 // 1 = -u, 2 = -g
    var byname: bool = false
    let n: u64 = ulib.arg_count(args)
    while i < n {
        let a: u64 = ulib.arg_at(args, i)
        if ulib.streq(a, (&o_u[0]) as u64) {
            only = 1
        } else {
            if ulib.streq(a, (&o_g[0]) as u64) {
                only = 2
            } else {
                if ulib.streq(a, (&o_n[0]) as u64) {
                    only = 1
                    byname = true
                } else {
                    if ulib.streq(a, (&o_gn[0]) as u64) {
                        only = 2
                        byname = true
                    } else {
                        // Ein Name: die Kennungen aus /etc/passwd.
                        let u: u64 = pw.uid_of_name(a)
                        if u == ulib.EOF {
                            ulib.esay_line((&e_no[0]) as u64, a)
                            return 1
                        }
                        uid = u
                        euid = u
                        gid = pw.gid_of_name(a)
                        egid = gid
                    }
                }
            }
        }
        i = i + 1
    }

    if only != 0 {
        var v: u64 = uid
        if only == 2 {
            v = gid
        }
        if byname {
            if pw.name_of_uid(v, (&nm[0]) as u64, 64) {
                tools.ob_str((&nm[0]) as u64)
            } else {
                tools.ob_num(v)
            }
        } else {
            tools.ob_num(v)
        }
        tools.ob_nl()
        tools.ob_flush()
        return 0
    }

    part((&l_uid[0]) as u64, uid, true)
    part((&l_gid[0]) as u64, gid, false)
    part((&l_eu[0]) as u64, euid, true)
    part((&l_eg[0]) as u64, egid, false)
    // RUNDE MULTIUSER: die Zusatzgruppen, so wie `id` sie auf jedem
    // Unix schreibt. Sie stehen NUR da, wenn es welche gibt -- eine
    // leere Liste als " groups=" hinzuschreiben waere eine Zeile, die
    // aussieht wie eine Antwort und keine ist. Und damit bleibt die
    // Ausgabe fuer jeden Prozess ohne Zusatzgruppen Oktett fuer Oktett
    // die von K13; 1585 Zusagen haengen an ihr.
    var g: [u64; 16] = [0 as u64; 16]
    let ng: u64 = ulib.sys(SYS_GETGROUPS, 16, (&g[0]) as u64, 0)
    if !ulib.bad(ng) && ng > 0 {
        var l_gr: [u8; 9] = " groups=\0"
        var komma: [u8; 2] = ",\0"
        tools.ob_str((&l_gr[0]) as u64)
        var k: u64 = 0
        while k < ng && k < 16 {
            if k > 0 {
                tools.ob_str((&komma[0]) as u64)
            }
            tools.ob_num(g[k as usize])
            var gn: [u8; 64] = [0 as u8; 64]
            if grp.group_name_of(g[k as usize], (&gn[0]) as u64, 64) {
                var op: [u8; 2] = "(\0"
                var cl: [u8; 2] = ")\0"
                tools.ob_str((&op[0]) as u64)
                tools.ob_str((&gn[0]) as u64)
                tools.ob_str((&cl[0]) as u64)
            }
            k = k + 1
        }
    }
    tools.ob_nl()
    tools.ob_flush()
    return 0
}
