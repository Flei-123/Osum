
profile kernel

import ulib
import libc.io
import libc.errno

export { u_start }

static mut buf: [u8; 512] = [0 as u8; 512];
static mut ents: [u8; 4096] = [0 as u8; 4096];
static mut last: [u8; 300] = [0 as u8; 300];
static mut file_path: [u8; 64] = [0 as u8; 64];

fn say_2(name: u64, value: u64) {
    var s_header: [u8; 9] = "fsrlim: \0";
    var s_gl: [u8; 4] = " = \0";
    ulib.say((&s_header[0 as usize]) as u64);
    ulib.say(name);
    ulib.say((&s_gl[0 as usize]) as u64);
    ulib.sayu(value);
    ulib.nl();
}

fn write_at(fd: u64, pos: u64) -> u64 {
    if errno.failed(io.seek(fd, pos, 0)) {
        return 0;
    }
    buf[(0) as usize] = 88 as u8;
    let n: u64 = io.write(fd, (&buf[0 as usize]) as u64, 1);
    if errno.failed(n) {
        return 0;
    }
    if n != 1 {
        return 0;
    }
    return 1;
}

fn geometrie() {
    var n_bs: [u8; 4] = "bs\0\0";
    var n_blocks: [u8; 8] = "blocks\0\0";
    var n_bfree: [u8; 7] = "bfree\0\0";
    var n_inodes: [u8; 8] = "inodes\0\0";
    var n_iused: [u8; 7] = "iused\0\0";
    say_2((&n_bs[0 as usize]) as u64,
        ulib.sys(ulib.SYS_SYSINFO, ulib.I_BSIZE, 0, 0));
    say_2((&n_blocks[0 as usize]) as u64,
        ulib.sys(ulib.SYS_SYSINFO, ulib.I_BLOCKS, 0, 0));
    say_2((&n_bfree[0 as usize]) as u64,
        ulib.sys(ulib.SYS_SYSINFO, ulib.I_BFREE, 0, 0));
    say_2((&n_inodes[0 as usize]) as u64,
        ulib.sys(ulib.SYS_SYSINFO, ulib.I_INODES, 0, 0));
    say_2((&n_iused[0 as usize]) as u64,
        ulib.sys(ulib.SYS_SYSINFO, ulib.I_IUSED, 0, 0));
}

fn does_file() {
    var n_maxidx: [u8; 8] = "maxidx\0\0";
    var n_maxfile: [u8; 9] = "maxfile\0\0";
    var n_about: [u8; 7] = "over\0\0\0";
    var maxidx: u64 = 0;
    var about: u64 = 0;
    var p_g: [u8; 12] = "/tmp/lim.d\0\0";
    let fd: u64 = io.create((&p_g[0 as usize]) as u64);
    if !errno.failed(fd) {
        var lo: u64 = 0;
        var hi: u64 = 33554432;
        if write_at(fd, 0) != 1 {
            hi = 0;
        }
        while lo + 1 < hi {
            let mid: u64 = lo + (hi - lo) / 2;
            if write_at(fd, mid * 512) == 1 {
                lo = mid;
            } else {
                hi = mid;
            }
        }
        maxidx = lo;
        about = write_at(fd, (lo + 1) * 512);
        io.close(fd);
    }
    say_2((&n_maxidx[0 as usize]) as u64, maxidx);
    say_2((&n_maxfile[0 as usize]) as u64, (maxidx + 1) * 512);
    say_2((&n_about[0 as usize]) as u64, about);
    io.unlink((&p_g[0 as usize]) as u64);
}

fn read_num(p: u64) -> u64 {
    var v: u64 = 0;
    var i: u64 = 0;
    var c: u64 = __mmio_read8((p + i) as *mut u8) as u64;
    while c >= 48 && c <= 57 {
        v = v * 10 + (c - 48);
        i = i + 1;
        c = __mmio_read8((p + i) as *mut u8) as u64;
    }
    return v;
}

fn time_ms() -> u64 {
    return ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0);
}

fn tut_viele(bis: u64) {
    var n_files: [u8; 7] = "files\0\0";
    var n_ferr: [u8; 6] = "ferr\0\0";
    var n_t250: [u8; 6] = "t250\0\0";
    var n_t500: [u8; 6] = "t500\0\0";
    var n_t1000: [u8; 7] = "t1000\0\0";
    var n_t1500: [u8; 7] = "t1500\0\0";
    var n_t2000: [u8; 7] = "t2000\0\0";
    var p_d: [u8; 6] = "/viel\0";
    io.make_dir((&p_d[0 as usize]) as u64);
    let t0: u64 = time_ms();
    var t250: u64 = 0;
    var t500: u64 = 0;
    var t1000: u64 = 0;
    var t2000: u64 = 0;
    var gemacht: u64 = 0;
    var ferr: u64 = 0;
    var k: u64 = 0;
    var next: bool = true;
    while next && k < bis {
        var p_f: [u8; 14] = "/viel/f00000\0\0";
        p_f[(7) as usize] = (48 + (k / 10000) % 10) as u8;
        p_f[(8) as usize] = (48 + (k / 1000) % 10) as u8;
        p_f[(9) as usize] = (48 + (k / 100) % 10) as u8;
        p_f[(10) as usize] = (48 + (k / 10) % 10) as u8;
        p_f[(11) as usize] = (48 + k % 10) as u8;
        let f: u64 = io.create((&p_f[0 as usize]) as u64);
        if errno.failed(f) {
            ferr = errno.negated(f);
            next = false;
        } else {
            io.close(f);
            gemacht = gemacht + 1;
            if gemacht == 250 {
                t250 = time_ms() - t0;
                say_2((&n_t250[0 as usize]) as u64, t250);
            }
            if gemacht == 500 {
                t500 = time_ms() - t0;
                say_2((&n_t500[0 as usize]) as u64, t500);
            }
            if gemacht == 1000 {
                t1000 = time_ms() - t0;
                say_2((&n_t1000[0 as usize]) as u64, t1000);
            }
            if gemacht == 1500 {
                say_2((&n_t1500[0 as usize]) as u64, time_ms() - t0);
            }
            if gemacht >= bis {
                t2000 = time_ms() - t0;
                next = false;
            }
        }
        k = k + 1;
    }
    say_2((&n_files[0 as usize]) as u64, gemacht);
    say_2((&n_ferr[0 as usize]) as u64, ferr);
    say_2((&n_t250[0 as usize]) as u64, t250);
    say_2((&n_t500[0 as usize]) as u64, t500);
    say_2((&n_t1000[0 as usize]) as u64, t1000);
    say_2((&n_t2000[0 as usize]) as u64, t2000);
}

fn does_big() {
    var n_dents: [u8; 7] = "dents\0\0";
    var n_dlast: [u8; 7] = "dlast\0\0";
    var dents: u64 = 0;
    var dlast: u64 = 0;
    var p_gr: [u8; 7] = "/gross\0";
    let dd: u64 = io.dir_open((&p_gr[0 as usize]) as u64);
    if !errno.failed(dd) {
        var going: bool = true;
        while going {
            let n: u64 = io.dir_read(dd, (&ents[0 as usize]) as u64, 4096);
            if n == 0 || errno.failed(n) {
                going = false;
            } else {
                var at: u64 = 0;
                while at < n {
                    let rec: u64 = (&ents[0 as usize]) as u64 + at;
                    ulib.strcpy((&last[0 as usize]) as u64,
                        io.dir_name(rec));
                    dents = dents + 1;
                    at = at + io.dir_reclen(rec);
                }
            }
        }
        io.close(dd);
        ulib.strcpy((&file_path[0 as usize]) as u64, (&p_gr[0 as usize]) as u64);
        var s_slash: [u8; 2] = "/\0";
        ulib.strcat((&file_path[0 as usize]) as u64, (&s_slash[0 as usize]) as u64);
        ulib.strcat((&file_path[0 as usize]) as u64, (&last[0 as usize]) as u64);
        let lf: u64 = io.open((&file_path[0 as usize]) as u64, 0);
        if !errno.failed(lf) {
            dlast = 1;
            io.close(lf);
        }
    }
    say_2((&n_dents[0 as usize]) as u64, dents);
    say_2((&n_dlast[0 as usize]) as u64, dlast);
}

fn does_wide() {
    var n_wide: [u8; 6] = "wide\0\0";
    var n_wgr: [u8; 6] = "wgr\0\0\0";
    var p_w: [u8; 11] = "/tmp/weit\0\0";
    var ok: u64 = 0;
    let fd: u64 = io.create((&p_w[0 as usize]) as u64);
    if !errno.failed(fd) {
        var i: u64 = 0;
        while i < 512 {
            buf[(i) as usize] = (65 + (i % 26)) as u8;
            i = i + 1;
        }
        if io.write(fd, (&buf[0 as usize]) as u64, 512) == 512 {
            ok = 1;
        }
        io.close(fd);
    }
    say_2((&n_wide[0 as usize]) as u64, ok);
    say_2((&n_wgr[0 as usize]) as u64,
        io.size_of((&p_w[0 as usize]) as u64));
}

fn u_start(args: u64) -> u64 {
    var n_ende: [u8; 6] = "ende\0\0";
    var w_file: [u8; 6] = "datei\0";
    var w_file_new: [u8; 5] = "file\0";
    var w_viele: [u8; 6] = "viele\0";
    var w_many_new: [u8; 5] = "many\0";
    var w_big: [u8; 6] = "gross\0";
    var w_big_u: [u8; 6] = "groß\0";
    var w_wide: [u8; 5] = "weit\0";
    var w_wide_new: [u8; 5] = "wide\0";
    geometrie();
    let argc: u64 = ulib.arg_count(args);
    var i: u64 = 1;
    while i < argc {
        let a: u64 = ulib.arg_at(args, i);
        if ulib.streq(a, (&w_file[0 as usize]) as u64) || ulib.streq(a, (&w_file_new[0 as usize]) as u64) {
            does_file();
        }
        if ulib.streq(a, (&w_viele[0 as usize]) as u64) || ulib.streq(a, (&w_many_new[0 as usize]) as u64) {
            var bis: u64 = 2000;
            if i + 1 < argc {
                bis = read_num(ulib.arg_at(args, i + 1));
                if bis == 0 {
                    bis = 2000;
                }
            }
            tut_viele(bis);
        }
        if ulib.streq(a, (&w_big[0 as usize]) as u64)
            || ulib.streq(a, (&w_big_u[0 as usize]) as u64) {
            does_big();
        }
        if ulib.streq(a, (&w_wide[0 as usize]) as u64) || ulib.streq(a, (&w_wide_new[0 as usize]) as u64) {
            does_wide();
        }
        i = i + 1;
    }
    say_2((&n_ende[0 as usize]) as u64, 1);
    return 0;
}
