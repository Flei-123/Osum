fn sk() -> u64 {
    return wlibc.ui_scale()
}

fn say(p: u64) {
    let _s: u64 = ulib.say(p)
}

fn sayn(v: u64) {
    ulib.sayn(v)
}

fn nl() {
    ulib.nl()
}

fn mg(key: u64) -> u64 {
    return msg.get(key)
}

fn ptr_of(b: u64) -> u64 {
    return b
}

// ------------------------------------------------------------------ glyph drawing
//
// Everything below paints into the canvas of the current window through fUi's painter. `s` is the
// side of the square the glyph lives in, in pixels; the strokes are about s/11 wide.

fn zp() -> *mut painter.Painter {
    return render.ctx_painter(fuiapp.ctx())
}

// a colour word as wlibc hands it out (red in the high octet) -> the painter's ARGB
fn argb(rgb: u64, alpha: u64) -> u32 {
    let c: u32 = (((rgb & 255) << 16) | (rgb & 65280) | ((rgb >> 16) & 255)) as u32
    return c | ((alpha & 255) << 24) as u32
}

fn plate(x: f64, y: f64, w: f64, h: f64, r: f64, col: u32) {
    painter.round_rect(zp(), x, y, w, h, r, col)
}

fn ringp(x: f64, y: f64, w: f64, h: f64, r: f64, t: f64, col: u32) {
    painter.round_ring(zp(), x, y, w, h, r, t, col)
}

fn line(x0: f64, y0: f64, x1: f64, y1: f64, st: f64, col: u32) {
    var dx: f64 = x1 - x0
    var dy: f64 = y1 - y0
    var lang: f64 = dx
    if lang < 0.0 {
        lang = 0.0 - lang
    }
    var ady: f64 = dy
    if ady < 0.0 {
        ady = 0.0 - ady
    }
    if ady > lang {
        lang = ady
    }
    var n: i64 = (lang * 2.0) as i64
    if n < 1 {
        n = 1
    }
    var sw: f64 = st
    if sw < 1.0 {
        sw = 1.0
    }
    let hh: f64 = sw / 2.0
    var i: i64 = 0
    while i <= n {
        let t: f64 = (i as f64) / (n as f64)
        painter.surface(zp(), x0 + dx * t - hh, y0 + dy * t - hh, sw, sw, col)
        i = i + 1
    }
}

fn stw(s: f64) -> f64 {
    var w: f64 = s / 11.0
    if w < 1.5 {
        w = 1.5
    }
    return w
}

// the "!" badge: a filled disc in the bottom right corner with a bar and a dot
fn badge(x: f64, y: f64, s: f64, fill: u32, ink: u32) {
    let d: f64 = s * 0.46
    let bx: f64 = x + s - d
    let by: f64 = y + s - d
    plate(bx, by, d, d, d / 2.0, fill)
    plate(bx + d * 0.43, by + d * 0.2, d * 0.14, d * 0.38, d * 0.07, ink)
    plate(bx + d * 0.42, by + d * 0.68, d * 0.16, d * 0.16, d * 0.08, ink)
}

// the diagonal "off" slash
fn slash(x: f64, y: f64, s: f64, col: u32) {
    line(x + s * 0.14, y + s * 0.14, x + s * 0.86, y + s * 0.86, stw(s) * 1.1, col)
}

// ETHERNET: a plug body (ring) with three pins and a cable stub.
// state: 3 online, 2 no route (badge), 1 no address (badge), 0 no carrier (slash)
fn net_glyph(x: u64, y: u64, size: u64, state: u64, fg: u64, warn: u64, bg: u64) {
    let s: f64 = size as f64
    let fx: f64 = x as f64
    let fy: f64 = y as f64
    let col: u32 = argb(fg, 255)
    let t: f64 = stw(s)
    ringp(fx + s * 0.12, fy + s * 0.2, s * 0.76, s * 0.5, s * 0.1, t, col)
    plate(fx + s * 0.26, fy + s * 0.34, t, s * 0.2, 0.5, col)
    plate(fx + s * 0.5 - t / 2.0, fy + s * 0.34, t, s * 0.2, 0.5, col)
    plate(fx + s * 0.74 - t, fy + s * 0.34, t, s * 0.2, 0.5, col)
    plate(fx + s * 0.5 - t / 2.0, fy + s * 0.7, t, s * 0.18, 0.5, col)
    plate(fx + s * 0.32, fy + s * 0.86, s * 0.36, t, 0.5, col)
    if state == 0 {
        // the slash is cut into the picture with the background colour first, so it reads on the glyph
        line(fx + s * 0.14, fy + s * 0.14 + t, fx + s * 0.86, fy + s * 0.86 + t, t * 2.6, argb(bg, 255))
        slash(fx, fy, s, argb(warn, 255))
    }
    if state == 1 || state == 2 {
        badge(fx, fy, s, argb(warn, 255), argb(bg, 255))
    }
}

// WLAN: four rising bars; `level` 0..4 of them are filled, the others dim. 0 also gets the slash.
fn wlan_glyph(x: u64, y: u64, size: u64, level: u64, fg: u64, warn: u64) {
    let s: f64 = size as f64
    let fx: f64 = x as f64
    let fy: f64 = y as f64
    var k: u64 = 0
    while k < 4 {
        let h: f64 = s * (0.22 + 0.19 * (k as f64))
        var a: u64 = 70
        if k < level {
            a = 255
        }
        plate(fx + s * (0.1 + 0.2 * (k as f64)), fy + s * 0.9 - h, s * 0.15, h, s * 0.05, argb(fg, a))
        k = k + 1
    }
    if level == 0 {
        slash(fx, fy, s, argb(warn, 255))
    }
}

// SPEAKER: cone + box, up to two waves; muted = a cross instead of the waves
fn speaker_glyph(x: u64, y: u64, size: u64, level: u64, muted: u64, fg: u64) {
    let s: f64 = size as f64
    let fx: f64 = x as f64
    let fy: f64 = y as f64
    let col: u32 = argb(fg, 255)
    let t: f64 = stw(s)
    plate(fx + s * 0.1, fy + s * 0.38, s * 0.16, s * 0.24, s * 0.03, col)
    // the cone: slices of growing height
    var i: u64 = 0
    while i < 7 {
        let u: f64 = (i as f64) / 6.0
        let h: f64 = s * (0.24 + 0.4 * u)
        plate(fx + s * (0.24 + 0.05 * (i as f64)), fy + s * 0.5 - h / 2.0, s * 0.06, h, 0.0, col)
        i = i + 1
    }
    if muted != 0 {
        line(fx + s * 0.68, fy + s * 0.38, fx + s * 0.9, fy + s * 0.62, t, col)
        line(fx + s * 0.9, fy + s * 0.38, fx + s * 0.68, fy + s * 0.62, t, col)
        return
    }
    if level >= 1 {
        line(fx + s * 0.7, fy + s * 0.4, fx + s * 0.75, fy + s * 0.5, t, col)
        line(fx + s * 0.75, fy + s * 0.5, fx + s * 0.7, fy + s * 0.6, t, col)
    }
    if level >= 2 {
        line(fx + s * 0.78, fy + s * 0.3, fx + s * 0.86, fy + s * 0.5, t, col)
        line(fx + s * 0.86, fy + s * 0.5, fx + s * 0.78, fy + s * 0.7, t, col)
    }
}

// MICROPHONE: capsule, holder (a U of strokes), stem and foot; muted = slash
fn mic_glyph(x: u64, y: u64, size: u64, muted: u64, fg: u64, warn: u64) {
    let s: f64 = size as f64
    let fx: f64 = x as f64
    let fy: f64 = y as f64
    let col: u32 = argb(fg, 255)
    let t: f64 = stw(s)
    plate(fx + s * 0.38, fy + s * 0.08, s * 0.24, s * 0.44, s * 0.12, col)
    line(fx + s * 0.26, fy + s * 0.42, fx + s * 0.26, fy + s * 0.52, t, col)
    line(fx + s * 0.26, fy + s * 0.52, fx + s * 0.34, fy + s * 0.64, t, col)
    line(fx + s * 0.34, fy + s * 0.64, fx + s * 0.5, fy + s * 0.7, t, col)
    line(fx + s * 0.5, fy + s * 0.7, fx + s * 0.66, fy + s * 0.64, t, col)
    line(fx + s * 0.66, fy + s * 0.64, fx + s * 0.74, fy + s * 0.52, t, col)
    line(fx + s * 0.74, fy + s * 0.52, fx + s * 0.74, fy + s * 0.42, t, col)
    line(fx + s * 0.5, fy + s * 0.7, fx + s * 0.5, fy + s * 0.88, t, col)
    line(fx + s * 0.36, fy + s * 0.88, fx + s * 0.64, fy + s * 0.88, t, col)
    if muted != 0 {
        slash(fx, fy, s, argb(warn, 255))
    }
}

// CHEVRON: up (dir 0) or down (dir 1)
fn chevron_glyph(x: u64, y: u64, size: u64, dir: u64, fg: u64) {
    let s: f64 = size as f64
    let fx: f64 = x as f64
    let fy: f64 = y as f64
    let col: u32 = argb(fg, 255)
    let t: f64 = stw(s)
    if dir == 0 {
        // W-MERGEB: the two strokes are symmetric about the middle of the box (0.37 .. 0.63), so the ink centre is the box centre (tools/midline)
        line(fx + s * 0.22, fy + s * 0.63, fx + s * 0.5, fy + s * 0.37, t, col)
        line(fx + s * 0.5, fy + s * 0.37, fx + s * 0.78, fy + s * 0.63, t, col)
    } else {
        line(fx + s * 0.22, fy + s * 0.37, fx + s * 0.5, fy + s * 0.63, t, col)
        line(fx + s * 0.5, fy + s * 0.63, fx + s * 0.78, fy + s * 0.37, t, col)
    }
}

// Wi-Fi exists in this system only when a driver says so. None does (roadmap N-005): Ethernet.
fn net_kind() -> u64 {
    return NK_ETH
}

fn speaker_level() -> u64 {
    if snd_vol == 0 {
        return 0
    }
    if snd_vol < 40 {
        return 1
    }
    return 2
}

// the first letter of an owner on a plate: the glyph of a program that brings no picture
fn letter_glyph(x: u64, y: u64, size: u64, owner: u64) {
    let s: f64 = size as f64
    plate(x as f64, y as f64, s, s, s * 0.22, argb(wlibc.theme(wlibc.T_ACCENT), 70))
    ringp(x as f64, y as f64, s, s, s * 0.22, 1.0, argb(wlibc.theme(wlibc.T_ACCENT), 255))
    var up: u8 = __mmio_read8(owner as *mut u8)
    if up >= 97 as u8 && up <= 122 as u8 {
        up = up - 32 as u8
    }
    __mmio_write8((&owner_b[0 as usize]) as *mut u8, up)
    __mmio_write8(((&owner_b[0 as usize]) as u64 + 1) as *mut u8, 0 as u8)
    let px: u64 = wlibc.px_ui()
    let base: u64 = y + (size + wlibc.ascent_of(wlibc.F_UI, px)) / 2
    fuiscene.cv_text_rgb(x + size / 3, base, size, (&owner_b[0 as usize]) as u64, px, true,
        wlibc.theme(wlibc.T_FG))
}

fn warn_rgb() -> u64 {
    return 0xE5484D
}

fn paint_net(x: u64, y: u64, size: u64) {
    if net_kind() == NK_WLAN {
        wlan_glyph(x, y, size, 4, wlibc.theme(wlibc.T_FG), warn_rgb())
        return
    }
    net_glyph(x, y, size, net_st, wlibc.theme(wlibc.T_FG), warn_rgb(), wlibc.theme(wlibc.T_MENU))
}

// one function for every canvas of the window: the node's key says which glyph
fn draw_cv(key: u64, x: u64, y: u64, w: u64, h: u64) {
    var size: u64 = w
    if h < size {
        size = h
    }
    let ox: u64 = x + (w - size) / 2
    let oy: u64 = y + (h - size) / 2
    let fg: u64 = wlibc.theme(wlibc.T_FG)
    if key == CK_NET {
        paint_net(ox, oy, size)
    } else if key == CK_SND {
        speaker_glyph(ox, oy, size, speaker_level(), snd_mute, fg)
    } else if key == CK_MIC {
        mic_glyph(ox, oy, size, mic_muted, fg, warn_rgb())
    } else if key >= CK_ITEM && key < CK_ITEM + MAXROWS {
        let id: u64 = row_id[(key - CK_ITEM) as usize]
        let ic: u64 = tray.tray_icon(&tr, id)
        let ow: u64 = tray.tray_owner(&tr, id)
        if ic == 1 {
            paint_net(ox, oy, size)
        } else if ic == 2 {
            speaker_glyph(ox, oy, size, speaker_level(), snd_mute, fg)
        } else if ic == 3 {
            mic_glyph(ox, oy, size, mic_muted, fg, warn_rgb())
        } else {
            letter_glyph(ox, oy, size, ow)
        }
    } else if key == CK_PAIR {
        letter_glyph(ox, oy, size, (&n_pair[0 as usize]) as u64)
    } else if key == CK_SHEET {
        sheet(x, y, w, h)
    }
}

// the glyph sheet (test aid, `sheet` line in /etc/tray.items): every state of every glyph
fn sheet(x: u64, y: u64, w: u64, h: u64) {
    let fg: u64 = wlibc.theme(wlibc.T_FG)
    let bg: u64 = wlibc.theme(wlibc.T_MENU)
    let cell: u64 = 32 * sk()
    let gap: u64 = 8 * sk()
    var i: u64 = 0
    while i < 4 {
        net_glyph(x + i * (cell + gap), y, cell, i, fg, warn_rgb(), bg)
        i = i + 1
    }
    i = 0
    while i < 5 {
        wlan_glyph(x + i * (cell + gap), y + cell + gap, cell, i, fg, warn_rgb())
        i = i + 1
    }
    speaker_glyph(x, y + 2 * (cell + gap), cell, 0, 0, fg)
    speaker_glyph(x + (cell + gap), y + 2 * (cell + gap), cell, 1, 0, fg)
    speaker_glyph(x + 2 * (cell + gap), y + 2 * (cell + gap), cell, 2, 0, fg)
    speaker_glyph(x + 3 * (cell + gap), y + 2 * (cell + gap), cell, 2, 1, fg)
    mic_glyph(x + 4 * (cell + gap), y + 2 * (cell + gap), cell, 0, fg, warn_rgb())
    mic_glyph(x + 5 * (cell + gap), y + 2 * (cell + gap), cell, 1, fg, warn_rgb())
    chevron_glyph(x + 5 * (cell + gap), y, cell, 0, fg)
    chevron_glyph(x + 5 * (cell + gap), y + cell + gap, cell, 1, fg)
}

// ------------------------------------------------------------------ the model

fn cstr_eq(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while __mmio_read8((a + i) as *mut u8) == __mmio_read8((b + i) as *mut u8) {
        if __mmio_read8((a + i) as *mut u8) == 0 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

fn add_system() {
    let sys: u64 = (&t_sys[0 as usize]) as u64
    let _n: u64 = tray.tray_register(&tr, sys, 1, mg((&k_net[0 as usize]) as u64), true)
    let _s: u64 = tray.tray_register(&tr, sys, 2, mg((&k_snd[0 as usize]) as u64), true)
    let _m: u64 = tray.tray_register(&tr, sys, 3, mg((&k_micuse[0 as usize]) as u64), true)
}

fn to_num(p: u64, n: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < n {
        let c: u64 = __mmio_read8((p + i) as *mut u8) as u64
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
        }
        i = i + 1
    }
    return v
}

// Reads /etc/tray.items (see the header) and adds the owners the model does not know yet.
fn read_items() {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_items[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let b: u64 = (&conf[0 as usize]) as u64
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, b, 1023)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    var i: u64 = 0
    while i < n {
        // one line: field 0 up to '|', field 1 up to '|', field 2 to the end of the line
        var e: u64 = i
        while e < n && __mmio_read8((b + e) as *mut u8) != 10 as u8 {
            e = e + 1
        }
        var f1: u64 = i
        while f1 < e && __mmio_read8((b + f1) as *mut u8) != 124 as u8 {
            f1 = f1 + 1
        }
        var f2: u64 = f1 + 1
        while f2 < e && __mmio_read8((b + f2) as *mut u8) != 124 as u8 {
            f2 = f2 + 1
        }
        let l0: u64 = f1 - i
        if l0 == 5 && __mmio_read8((b + i) as *mut u8) == 115 as u8 && f1 == e {
            want_sheet = 1 // "sheet"
        } else if l0 == 3 && __mmio_read8((b + i) as *mut u8) == 109 as u8 && f1 < e {
            // mic|users|muted
            mic_stub = 1
            mic_users = to_num(b + f1 + 1, f2 - f1 - 1)
            if f2 < e {
                mic_muted = to_num(b + f2 + 1, e - f2 - 1)
            }
        } else if l0 > 0 && l0 < 23 && f1 < e && f2 <= e {
            var k: u64 = 0
            while k < l0 {
                __mmio_write8(((&owner_b[0 as usize]) as u64 + k) as *mut u8, __mmio_read8((b + i + k) as *mut u8))
                k = k + 1
            }
            __mmio_write8(((&owner_b[0 as usize]) as u64 + l0) as *mut u8, 0 as u8)
            var tl: u64 = 0
            if f2 < e {
                tl = e - f2 - 1
            }
            if tl > 62 {
                tl = 62
            }
            k = 0
            while k < tl {
                __mmio_write8(((&tip_b[0 as usize]) as u64 + k) as *mut u8, __mmio_read8((b + f2 + 1 + k) as *mut u8))
                k = k + 1
            }
            __mmio_write8(((&tip_b[0 as usize]) as u64 + tl) as *mut u8, 0 as u8)
            let ow: u64 = (&owner_b[0 as usize]) as u64
            if tray.tray_place_of_owner(&tr, ow) == 0 {
                let ic: u64 = to_num(b + f1 + 1, f2 - f1 - 1)
                let id: u64 = tray.tray_register(&tr, ow, ic, (&tip_b[0 as usize]) as u64, false)
                if id != 0 {
                    tray.tray_default_menu(&tr, id)
                }
            }
        }
        i = e + 1
    }
}

// ------------------------------------------------------------------ the tree

fn read_audio() {
    snd_da = 0
    if ulib.sys(SYS_AUDGET, A_READY, 0, 0) == 1 {
        snd_da = 1
        snd_vol = ulib.sys(SYS_AUDGET, A_VOLUME, 0, 0)
        snd_mute = ulib.sys(SYS_AUDGET, A_MUTED, 0, 0)
        if snd_vol > 100 {
            snd_vol = 100
        }
    }
    // the microphone: real numbers from the kernel capture path (SYS_OSUM_AUDREAD, W-TRAY6)
    mic_da = 0
    if mic_stub == 0 && ulib.sys(SYS_AUDGET, A_CAPREADY, 0, 0) == 1 {
        mic_da = 1
        mic_users = ulib.sys(SYS_AUDGET, A_CAPUSERS, 0, 0)
        mic_muted = ulib.sys(SYS_AUDGET, A_CAPMUTE, 0, 0)
        mic_who = ulib.sys(SYS_AUDGET, A_CAPWHO0, 0, 0)
        if ulib.bad(mic_who) {
            mic_who = 0
        }
    }
}

fn net_text() -> u64 {
    if net_da == 0 {
        return mg((&k_nonet[0 as usize]) as u64)
    }
    if net_st == 0 {
        return mg((&t_net[0 as usize]) as u64)
    }
    if net_st == 1 {
        return mg((&t_net1[0 as usize]) as u64)
    }
    if net_st == 2 {
        return mg((&t_net2[0 as usize]) as u64)
    }
    return mg((&t_net3[0 as usize]) as u64)
}

fn num_into(at: u64, v: u64) -> u64 {
    var tmp: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        tmp[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        tmp[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    var k: u64 = 0
    while k < n {
        __mmio_write8(((&txt[0 as usize]) as u64 + at + k) as *mut u8, tmp[(n - 1 - k) as usize])
        k = k + 1
    }
    __mmio_write8(((&txt[0 as usize]) as u64 + at + n) as *mut u8, 0 as u8)
    return at + n
}

fn mic_text() {
    if mic_muted != 0 {
        let _a: u64 = ulib.strncpy((&txt[0 as usize]) as u64, mg((&k_micmuted[0 as usize]) as u64), 100)
        return
    }
    var at: u64 = ulib.strncpy((&txt[0 as usize]) as u64, mg((&k_micuse[0 as usize]) as u64), 90)
    __mmio_write8(((&txt[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
    at = at + 1
    at = num_into(at, mic_users)
    // one reader: say WHO (a camera/mic light that does not name the program is not worth much)
    if mic_users == 1 && mic_who != 0 && mic_stub == 0 {
        let n0: u64 = ulib.sys(ulib.SYS_PSTAT, mic_who, ulib.P_NAME0, 0)
        let n1: u64 = ulib.sys(ulib.SYS_PSTAT, mic_who, ulib.P_NAME1, 0)
        if !ulib.bad(n0) && (n0 & 255) != 0 && at < 90 {
            __mmio_write8(((&txt[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
            __mmio_write8(((&txt[0 as usize]) as u64 + at + 1) as *mut u8, 40 as u8)
            at = at + 2
            var k: u64 = 0
            while k < 16 {
                var c: u64 = 0
                if k < 8 {
                    c = (n0 >> (k * 8)) & 255
                } else {
                    c = (n1 >> ((k - 8) * 8)) & 255
                }
                if c != 0 {
                    __mmio_write8(((&txt[0 as usize]) as u64 + at) as *mut u8, c as u8)
                    at = at + 1
                    k = k + 1
                } else {
                    k = 16
                }
            }
            __mmio_write8(((&txt[0 as usize]) as u64 + at) as *mut u8, 41 as u8)
            __mmio_write8(((&txt[0 as usize]) as u64 + at + 1) as *mut u8, 0 as u8)
        }
    }
}

fn pair_shown() -> bool {
    return pair_mode == pairshow.MODE_WAITING || pair_mode == pairshow.MODE_CONFIRM
}

fn pair_signature() -> u64 {
    var h: u64 = pair_mode * 1000003 + pair_left
    if pair_shown() {
        let c: u64 = pairshow.code()
        var i: u64 = 0
        while *((c + i) as *mut u8) != 0 as u8 && i < 20 {
            h = h * 31 + (*((c + i) as *mut u8)) as u64
            i = i + 1
        }
    }
    return h
}

fn read_pair() {
    pair_mode = pairshow.load()
    pair_left = 0
    if pair_mode == pairshow.MODE_WAITING {
        pair_left = pairshow.seconds_left()
    }
    pair_sig = pair_signature()
}

fn say_pair() {
    say((&s_pair[0 as usize]) as u64)
    sayn(pair_mode)
    if pair_shown() {
        say((&s_pcode[0 as usize]) as u64)
        say(pairshow.code())
    }
    nl()
}

fn pair_text() -> u64 {
    var key: u64 = (&k_pairw[0 as usize]) as u64
    if pair_mode == pairshow.MODE_CONFIRM {
        key = (&k_pairc[0 as usize]) as u64
    }
    var at: u64 = ulib.strncpy((&pair_b[0 as usize]) as u64, mg(key), 60)
    __mmio_write8(((&pair_b[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
    at = at + 1
    at = at + ulib.strncpy((&pair_b[0 as usize]) as u64 + at, pairshow.code(), 20)
    if pair_mode == pairshow.MODE_WAITING {
        __mmio_write8(((&pair_b[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
        __mmio_write8(((&pair_b[0 as usize]) as u64 + at + 1) as *mut u8, 40 as u8)
        at = at + 2
        var tmp: [u8; 24] = [0 as u8; 24]
        var n: u64 = 0
        var x: u64 = pair_left
        if x == 0 {
            tmp[0] = 48 as u8
            n = 1
        }
        while x > 0 {
            tmp[n as usize] = (48 + x % 10) as u8
            x = x / 10
            n = n + 1
        }
        var k: u64 = 0
        while k < n {
            __mmio_write8(((&pair_b[0 as usize]) as u64 + at + k) as *mut u8, tmp[(n - 1 - k) as usize])
            k = k + 1
        }
        at = at + n
        __mmio_write8(((&pair_b[0 as usize]) as u64 + at) as *mut u8, 115 as u8)
        __mmio_write8(((&pair_b[0 as usize]) as u64 + at + 1) as *mut u8, 41 as u8)
        __mmio_write8(((&pair_b[0 as usize]) as u64 + at + 2) as *mut u8, 0 as u8)
    } else {
        __mmio_write8(((&pair_b[0 as usize]) as u64 + at) as *mut u8, 0 as u8)
    }
    return (&pair_b[0 as usize]) as u64
}

fn rows_count() -> u64 {
    var n: u64 = tray.tray_count(&tr, tray.PLACE_OVERFLOW) as u64
    if n > MAXROWS {
        n = MAXROWS
    }
    return n
}

fn grid_rows() -> u64 {
    return (n_rows + GRID_COLS - 1) / GRID_COLS
}

fn tile_cb(ud: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    let _s: u64 = st
    var size: u64 = CELL_ICON * sk()
    if size > w {
        size = w
    }
    if size > h {
        size = h
    }
    draw_cv(ud, x + (w - size) / 2, y + (h - size) / 2, size, size)
    if tile_say != 0 && ud >= CK_ITEM && ud < CK_ITEM + MAXROWS {
        say((&s_tile[0 as usize]) as u64)
        sayn(ud - CK_ITEM)
        say((&s_xy[0 as usize]) as u64)
        sayn(x)
        say((&s_yy[0 as usize]) as u64)
        sayn(y)
        say((&s_ww[0 as usize]) as u64)
        sayn(w)
        say((&s_hh[0 as usize]) as u64)
        sayn(h)
        nl()
    }
}

fn mic_shown() -> bool {
    return mic_da != 0 || mic_users != 0 || mic_muted != 0
}

fn read_rows() {
    n_rows = rows_count()
    var i: u64 = 0
    while i < n_rows {
        row_id[i as usize] = tray.tray_at(&tr, tray.PLACE_OVERFLOW, i as usize)
        i = i + 1
    }
}

// the height of the card in design points (what `build` lays out)
fn card_h() -> u64 {
    var h: u64 = 2 * PADP
    if mode == M_MENU {
        let id: u64 = menu_item
        let m: u64 = tray.tray_menu_count(&tr, id) as u64
        return h + (m + 4) * (ROW_H + GAPP)
    }
    h = h + ROW_H + GAPP // network
    h = h + ROW_H + GAPP // sound: mute button + slider on one row
    if mic_shown() {
        h = h + ROW_H + GAPP
    }
    if pair_shown() {
        h = h + ROW_H + GAPP
    }
    if osk_on != 0 {
        h = h + ROW_H + GAPP
    }
    h = h + 22 + GAPP // the "more" caption
    if n_rows == 0 {
        h = h + 22 + GAPP
    } else {
        h = h + grid_rows() * (CELL + GAPP)
    }
    if want_sheet != 0 {
        h = h + 3 * 40 + 10
    }
    return h
}

fn build_menu(r: usize) {
    let id: u64 = menu_item
    let cap: usize = fuiscene.label(r, tray.tray_tooltip(&tr, id))
    let _c: usize = cap
    let m: u64 = tray.tray_menu_count(&tr, id) as u64
    var j: u64 = 0
    while j < m {
        let b: usize = fuiscene.button(r, mg(tray.tray_menu_label(&tr, id, j as usize)), K_ENT + j)
        fuiscene.set_size(b, CARD_W - 2 * PADP, ROW_H)
        if (tray.tray_menu_flags(&tr, id, j as usize) & tray.MF_DISABLED) != 0 {
            fuiscene.set_enabled(b, false)
        }
        j = j + 1
    }
    let bu: usize = fuiscene.button(r, mg((&k_up[0 as usize]) as u64), K_UP)
    fuiscene.set_size(bu, CARD_W - 2 * PADP, ROW_H)
    let bh: usize = fuiscene.button(r, mg((&k_hide[0 as usize]) as u64), K_HIDE)
    fuiscene.set_size(bh, CARD_W - 2 * PADP, ROW_H)
    let bb: usize = fuiscene.button(r, mg((&k_back[0 as usize]) as u64), K_BACK)
    fuiscene.set_size(bb, CARD_W - 2 * PADP, ROW_H)
}

fn build() {
    let r: usize = fuiscene.root()
    fuiscene.set_gap(r, GAPP)
    if mode == M_MENU {
        build_menu(r)
        return
    }
    // network
    let rn: usize = fuiscene.row(r)
    fuiscene.set_gap(rn, GAPP + 2)
    let _gn: usize = fuiscene.canvas2(rn, CK_NET, ROW_H - 4, ROW_H - 4, draw_cv)
    let _ln: usize = fuiscene.label(rn, net_text())
    // sound
    let rs: usize = fuiscene.row(r)
    fuiscene.set_gap(rs, GAPP + 2)
    if snd_da != 0 {
        let _gs: usize = fuiscene.canvas2(rs, CK_SND, ROW_H - 4, ROW_H - 4, draw_cv)
        var mk: u64 = (&k_mute[0 as usize]) as u64
        if snd_mute != 0 {
            mk = (&k_unmute[0 as usize]) as u64
        }
        let _bm: usize = fuiscene.button(rs, mg(mk), K_MUTE)
        let _sl: usize = fuiscene.slider(rs, K_VOL, 120, (snd_vol * 10) as i64)
    } else {
        let _gs: usize = fuiscene.canvas2(rs, CK_SND, ROW_H - 4, ROW_H - 4, draw_cv)
        let _ls: usize = fuiscene.label(rs, mg((&k_nosnd[0 as usize]) as u64))
    }
    // microphone (STUB source)
    if mic_shown() {
        let rm: usize = fuiscene.row(r)
        fuiscene.set_gap(rm, GAPP + 2)
        let _gm: usize = fuiscene.canvas2(rm, CK_MIC, ROW_H - 4, ROW_H - 4, draw_cv)
        mic_text()
        let _lm: usize = fuiscene.label(rm, (&txt[0 as usize]) as u64)
        if mic_da != 0 {
            var mmk: u64 = (&k_mute[0 as usize]) as u64
            if mic_muted != 0 {
                mmk = (&k_unmute[0 as usize]) as u64
            }
            let _bmm: usize = fuiscene.button(rm, mg(mmk), K_MICMUTE)
        }
    }
    if pair_shown() {
        let rp: usize = fuiscene.row(r)
        fuiscene.set_gap(rp, GAPP + 2)
        let _gp: usize = fuiscene.canvas2(rp, CK_PAIR, ROW_H - 4, ROW_H - 4, draw_cv)
        let _lp: usize = fuiscene.label(rp, pair_text())
    }
    if osk_on != 0 {
        let ro: usize = fuiscene.row(r)
        fuiscene.set_gap(ro, GAPP + 2)
        let _lo: usize = fuiscene.label(ro, mg((&k_osk[0 as usize]) as u64))
        let _bo: usize = fuiscene.button(ro, mg((&k_oskgo[0 as usize]) as u64), K_OSK)
    }
    // overflow
    let _lc: usize = fuiscene.label_muted(r, mg((&k_more[0 as usize]) as u64))
    if n_rows == 0 {
        let _ln2: usize = fuiscene.label(r, mg((&k_none[0 as usize]) as u64))
    }
    var i: u64 = 0
    while i < n_rows {
        let ri: usize = fuiscene.row(r)
        fuiscene.set_gap(ri, GAPP)
        var c: u64 = 0
        while c < GRID_COLS && i < n_rows {
            let id: u64 = row_id[i as usize]
            let _t: usize = fuiscene.tile(ri, K_ITEM + i, tray.tray_tooltip(&tr, id), CELL, CELL, false, CK_ITEM + i, tile_cb)
            i = i + 1
            c = c + 1
        }
    }
    if want_sheet != 0 {
        let _sh: usize = fuiscene.canvas2(r, CK_SHEET, CARD_W - 2 * PADP, 3 * 40 + 2, draw_cv)
    }
}

// ------------------------------------------------------------------ the life

fn init() -> bool {
    tr = tray.tray_new()
    if !tray.tray_ok(&tr) {
        say((&s_nop[0 as usize]) as u64)
        nl()
        return false
    }
    add_system()
    read_items()
    tp_win = fuiscene.win_open_plain(0, 0, CARD_W * sk(), MAXH * sk(), (&t_title[0 as usize]) as u64,
        wlibc.L_MENU, build)
    if tp_win == fuiscene.BADWIN {
        tp_win = NONE
        return false
    }
    let _s: bool = fuiscene.win_select(tp_win)
    fuiscene.keys_always(true)
    tp_h = fuiscene.handle()
    let _v: u64 = wlibc.win_state(tp_h, wlibc.WS_HIDDEN, 1)
    let _u: bool = fuiscene.win_select(0)
    tp_id = wlibc.sys3w(wlibc.WM_INFO, tp_h, wlibc.WI_ID, 0)
    return true
}

fn is_open() -> bool {
    return open_ != 0
}

fn hit(x: u64, y: u64) -> bool {
    if open_ == 0 {
        return false
    }
    return x >= px_ && x < px_ + pw_ && y >= py_ && y < py_ + ph_
}

fn paint_now() {
    var n: u64 = 0
    while n < 3 {
        let _k: u64 = fuiscene.pump_aux(tp_win)
        n = n + 1
    }
}

// size + place the card (above the chevron, right edge kept on the screen) and repaint
fn relayout() {
    read_rows()
    pw_ = CARD_W * sk()
    ph_ = card_h() * sk()
    if ph_ > MAXH * sk() {
        ph_ = MAXH * sk()
    }
    // r828: stay inside the head of the bar that owns the chevron (the whole screen on one head)
    let sw: u64 = wlibc.head_bx() + wlibc.head_bw()
    px_ = wlibc.head_bx()
    if ax_ + aw_ > pw_ + px_ {
        px_ = ax_ + aw_ - pw_
    }
    if px_ + pw_ > sw && sw > pw_ {
        px_ = sw - pw_
    }
    py_ = 0
    if ay_ > ph_ + 8 * sk() {
        py_ = ay_ - ph_ - 8 * sk()
    }
    let _s: bool = fuiscene.win_select(tp_win)
    let _z: bool = fuiscene.win_size(pw_, ph_)
    fuiscene.refresh()
    fuiscene.touch()
    key_last = fuiscene.key_seq()
    let _u: bool = fuiscene.win_select(0)
    paint_now()
    let _m: u64 = wlibc.sys3w(wlibc.WM_MOVE, tp_h, (px_ << 16) | py_, 0)
}

fn say_osk_rect() {
    if osk_on == 0 {
        return
    }
    let _s: bool = fuiscene.win_select(tp_win)
    let g: u64 = fuiscene.key_geom(K_OSK)
    let _u: bool = fuiscene.win_select(0)
    if g == 0 {
        return
    }
    say((&s_rect[0 as usize]) as u64)
    say((&n_osk[0 as usize]) as u64)
    say((&s_xy[0 as usize]) as u64)
    sayn(px_ + (g >> 48))
    say((&s_yy[0 as usize]) as u64)
    sayn(py_ + ((g >> 32) & 65535))
    say((&s_ww[0 as usize]) as u64)
    sayn((g >> 16) & 65535)
    say((&s_hh[0 as usize]) as u64)
    sayn(g & 65535)
    nl()
}

fn open_now() {
    if open_ != 0 || tp_win == NONE {
        return
    }
    read_items()
    read_audio()
    read_pair()
    pair_next = fuiapp.now_ms() + PAIR_POLL_MS
    osk_on = 0
    if osktray.shown() {
        osk_on = 1
    }
    mode = M_LIST
    tile_say = 1
    relayout()
    tile_say = 0
    let _v: u64 = wlibc.win_state(tp_h, wlibc.WS_HIDDEN, 0)
    open_ = 1
    btn_last = wlibc.mouse_btn() & 7
    focus_seen = 0
    let _a: u64 = wlibc.win_act(tp_id, wlibc.WA_RAISE)
    let _k: u64 = wlibc.win_state(tp_h, wlibc.WS_KEYS, 1)
    let _fs: bool = fuiscene.win_select(tp_win)
    fuiscene.focus_canvas()
    let _fu: bool = fuiscene.win_select(0)
    say((&s_open[0 as usize]) as u64)
    sayn(n_rows)
    say((&s_xy[0 as usize]) as u64)
    sayn(px_)
    say((&s_yy[0 as usize]) as u64)
    sayn(py_)
    say((&s_ww[0 as usize]) as u64)
    sayn(pw_)
    say((&s_hh[0 as usize]) as u64)
    sayn(ph_)
    nl()
    say_osk_rect()
    say_pair()
    var i: u64 = 0
    while i < n_rows {
        let id: u64 = row_id[i as usize]
        say((&s_item[0 as usize]) as u64)
        sayn(i)
        say((&s_id[0 as usize]) as u64)
        sayn(id)
        say((&s_ow[0 as usize]) as u64)
        say(tray.tray_owner(&tr, id))
        say((&s_tip[0 as usize]) as u64)
        say(tray.tray_tooltip(&tr, id))
        nl()
        i = i + 1
    }
}

fn shut(why: u64) {
    if open_ == 0 {
        return
    }
    open_ = 0
    let _v: u64 = wlibc.win_state(tp_h, wlibc.WS_HIDDEN, 1)
    say_shut_line(why)
}

fn byte_at(p: u64, i: u64) -> u8 {
    return __mmio_read8((p + i) as *mut u8)
}

fn say_shut_line(why: u64) {
    var line: [u8; 64] = [0 as u8; 64]
    var n: u64 = 0
    let head: u64 = (&s_shut[0 as usize]) as u64
    while n < 14 {
        line[n as usize] = byte_at(head, n)
        n = n + 1
    }
    var i: u64 = 0
    while i < 40 && byte_at(why, i) != 0 as u8 {
        line[n as usize] = byte_at(why, i)
        n = n + 1
        i = i + 1
    }
    line[n as usize] = 10
    n = n + 1
    let _w: u64 = ulib.put((&line[0]) as u64, n)
}

fn shut_now() {
    shut((&s_toggle[0 as usize]) as u64)
}

// the chevron: the bar tells where it sits (pixels) and what the network is doing
fn toggle(ax: u64, ay: u64, aw: u64, ah: u64, has_net: u64, net_state: u64) {
    ax_ = ax
    ay_ = ay
    aw_ = aw
    ah_ = ah
    net_da = has_net
    net_st = net_state
    if open_ != 0 {
        shut((&s_toggle[0 as usize]) as u64)
    } else {
        open_now()
    }
}

// the context menu of an item / back to the list
fn open_menu(id: u64) {
    menu_item = id
    mode = M_MENU
    say((&s_menu[0 as usize]) as u64)
    sayn(id)
    nl()
    relayout()
}

fn back_to_list() {
    mode = M_LIST
    relayout()
}

fn pos_of(id: u64) -> u64 {
    var k: u64 = 0
    while k < 32 {
        let at: u64 = tray.tray_at(&tr, tray.PLACE_OVERFLOW, k as usize)
        if at == 0 {
            return 0
        }
        if at == id {
            return k
        }
        k = k + 1
    }
    return 0
}

fn on_key(key: u64) -> bool {
    if key == K_OSK {
        let pid: u64 = osktray.launch()
        say((&s_oskpid[0 as usize]) as u64)
        sayn(pid)
        nl()
        shut((&s_oskwhy[0 as usize]) as u64)
        return true
    }
    if key == K_MICMUTE {
        var nm: u64 = 1
        if mic_muted != 0 {
            nm = 0
        }
        let rcm: u64 = ulib.sys(SYS_AUDSET, AS_CAPMUTE, nm, 0)
        say((&s_micmute[0 as usize]) as u64)
        sayn(nm)
        say((&s_rc[0 as usize]) as u64)
        sayn(rcm)
        nl()
        read_audio()
        relayout()
        return true
    }
    if key == K_MUTE {
        var fresh: u64 = 1
        if snd_mute != 0 {
            fresh = 0
        }
        let rc: u64 = ulib.sys(SYS_AUDSET, AS_MUTE, fresh, 0)
        say((&s_mute[0 as usize]) as u64)
        sayn(fresh)
        say((&s_rc[0 as usize]) as u64)
        sayn(rc)
        nl()
        read_audio()
        relayout()
        return true
    }
    if key == K_VOL {
        let _s: bool = fuiscene.win_select(tp_win)
        let v: u64 = (fuiscene.value_of(K_VOL) as u64) / 10
        let _u: bool = fuiscene.win_select(0)
        let rc: u64 = ulib.sys(SYS_AUDSET, AS_VOLUME, v, 0)
        if v > 0 && snd_mute != 0 {
            let _m: u64 = ulib.sys(SYS_AUDSET, AS_MUTE, 0, 0)
        }
        snd_vol = v
        if v > 0 {
            snd_mute = 0
        }
        say((&s_vol[0 as usize]) as u64)
        sayn(v)
        say((&s_rc[0 as usize]) as u64)
        sayn(rc)
        nl()
        return true
    }
    if key >= K_ITEM && key < K_ITEM + n_rows {
        let id: u64 = row_id[(key - K_ITEM) as usize]
        let _c: bool = tray.tray_click(&tr, id, tray.BTN_LEFT)
        say((&s_click[0 as usize]) as u64)
        sayn(id)
        say((&s_ow[0 as usize]) as u64)
        say(tray.tray_owner(&tr, id))
        nl()
        shut((&s_clk[0 as usize]) as u64)
        return true
    }
    if key == fuiscene.KEY_RCLICK && mode == M_LIST {
        let _s: bool = fuiscene.win_select(tp_win)
        let rk: u64 = fuiscene.key_at(fuiscene.right_x(), fuiscene.right_y())
        let _u: bool = fuiscene.win_select(0)
        if rk >= K_ITEM && rk < K_ITEM + n_rows {
            open_menu(row_id[(rk - K_ITEM) as usize])
            return true
        }
        return false
    }
    if key >= K_MENU && key < K_MENU + n_rows {
        open_menu(row_id[(key - K_MENU) as usize])
        return true
    }
    if key >= K_ENT && key < K_ENT + 8 {
        let j: u64 = key - K_ENT
        let act: u64 = tray.tray_menu_action(&tr, menu_item, j as usize)
        let _p: bool = tray.tray_pick(&tr, menu_item, j as usize)
        say((&s_pick[0 as usize]) as u64)
        sayn(menu_item)
        say((&s_act[0 as usize]) as u64)
        sayn(act)
        nl()
        shut((&s_pk[0 as usize]) as u64)
        return true
    }
    if key == K_UP {
        let p: u64 = pos_of(menu_item)
        if p > 0 {
            let _m: bool = tray.tray_move(&tr, menu_item, tray.PLACE_OVERFLOW, (p - 1) as usize)
        }
        back_to_list()
        return true
    }
    if key == K_HIDE {
        let _m: bool = tray.tray_move(&tr, menu_item, tray.PLACE_HIDDEN, 0)
        back_to_list()
        return true
    }
    if key == K_BACK {
        back_to_list()
        return true
    }
    return false
}

fn has_focus() -> bool {
    return wlibc.sys3w(wlibc.WM_INFO, tp_h, wlibc.WI_FOCUS, 0) == 1
}

fn step() -> bool {
    if open_ == 0 {
        return false
    }
    let _st: u64 = wlib.step()
    let key: u64 = fuiscene.pump_aux(tp_win)
    if key != 0 && on_key(key) {
        return true
    }
    if open_ == 0 {
        return true
    }
    let _s: bool = fuiscene.win_select(tp_win)
    let lk: u64 = fuiscene.last_key()
    let ks: u64 = fuiscene.key_seq()
    let _u: bool = fuiscene.win_select(0)
    if ks != key_last {
        key_last = ks
        if lk == 27 {
            if mode == M_MENU {
                back_to_list()
                return true
            }
            shut((&s_esc[0 as usize]) as u64)
            return true
        }
    }
    // a press outside the card closes it -- except on the chevron, which is the bar's own toggle
    if has_focus() {
        focus_seen = 1
    } else if focus_seen != 0 {
        shut((&s_foc[0 as usize]) as u64)
        return true
    }
    let btn: u64 = wlibc.mouse_btn() & 7
    if (btn & ~btn_last) != 0 {
        let mx: u64 = wlibc.mouse_x()
        let my: u64 = wlibc.mouse_y()
        let on_anchor: bool = mx >= ax_ && mx < ax_ + aw_ && my >= ay_ && my < ay_ + ah_
        if !hit(mx, my) && !on_anchor {
            shut((&s_out[0 as usize]) as u64)
            btn_last = btn
            return true
        }
    }
    btn_last = btn
    if mode == M_LIST {
        let now: u64 = fuiapp.now_ms()
        if now >= pair_next {
            pair_next = now + PAIR_POLL_MS
            let old: u64 = pair_sig
            read_pair()
            if pair_sig != old {
                say_pair()
                relayout()
            }
        }
    }
    return false
}
