// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import ulib
import tools
import dbgio

export { u_start }

static mut LIST: [u8; 1024] = [0 as u8; 1024]
static mut INFO: [u8; 176] = [0 as u8; 176]
static mut DRV: [u8; 256] = [0 as u8; 256]

fn q(i: u64) -> u64 {
    return *(((&INFO[0 as usize]) as u64 + i * 8) as *mut u64)
}

fn show_bars() {
    var s_bar: [u8; 7] = "  bar\0\0"
    var s_addr: [u8; 7] = " addr=\0"
    var s_size: [u8; 7] = " size=\0"
    var s_flags: [u8; 8] = " flags=\0"
    var n: u64 = 0
    while n < 6 {
        let size: u64 = q(5 + n * 3)
        if size != 0 {
            tools.ob_str((&s_bar[0 as usize]) as u64)
            tools.ob_num(n)
            tools.ob_str((&s_addr[0 as usize]) as u64)
            dbgio.put_hex(q(4 + n * 3), 16)
            tools.ob_str((&s_size[0 as usize]) as u64)
            dbgio.put_hex(size, 8)
            tools.ob_str((&s_flags[0 as usize]) as u64)
            tools.ob_num(q(6 + n * 3))
            tools.ob_nl()
        }
        n = n + 1
    }
}

fn show_one(bdf: u64, verbose: bool) -> u64 {
    var s_class: [u8; 8] = " class=\0"
    var s_hdr: [u8; 6] = " hdr=\0"
    var s_drv: [u8; 6] = " drv=\0"
    var s_name: [u8; 7] = "lspci\0\0"
    let r: u64 = dbgio.call(dbgio.OP_INFO, bdf, (&INFO[0 as usize]) as u64, 0, 0)
    if ulib.bad(r) {
        dbgio.put_error((&s_name[0 as usize]) as u64, r)
        return 1
    }
    dbgio.put_bdf(bdf)
    tools.ob_byte(32)
    dbgio.put_hex(q(0), 4)
    tools.ob_byte(58)
    dbgio.put_hex(q(1), 4)
    tools.ob_str((&s_class[0 as usize]) as u64)
    dbgio.put_hex(q(2), 6)
    tools.ob_str((&s_hdr[0 as usize]) as u64)
    dbgio.put_hex(q(3), 2)
    tools.ob_str((&s_drv[0 as usize]) as u64)
    let d: u64 = dbgio.call(dbgio.OP_DRIVER, bdf, (&DRV[0 as usize]) as u64, 0, 0)
    if ulib.bad(d) {
        tools.ob_byte(63)
    } else {
        tools.ob_str((&DRV[0 as usize]) as u64)
    }
    tools.ob_nl()
    if verbose {
        show_bars()
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var f_v: [u8; 3] = "-v\0"
    var s_name: [u8; 7] = "lspci\0\0"
    var s_bad: [u8; 24] = "lspci: bad address\0\0\0\0\0\0"
    let verbose: bool = dbgio.has_flag(args, (&f_v[0 as usize]) as u64)
    let which: u64 = dbgio.positional(args, 0)
    var code: u64 = 0
    if which != 0 {
        let bdf: u64 = dbgio.parse_bdf(which)
        if bdf == dbgio.BAD {
            ulib.esay_line((&s_bad[0 as usize]) as u64, 0)
            return 2
        }
        code = show_one(bdf, verbose)
    } else {
        let n: u64 = dbgio.call(dbgio.OP_LIST, (&LIST[0 as usize]) as u64, 0, 0, 0)
        if ulib.bad(n) {
            dbgio.put_error((&s_name[0 as usize]) as u64, n)
            return 1
        }
        var i: u64 = 0
        while i < n {
            show_one(*(((&LIST[0 as usize]) as u64 + i * 8) as *mut u64), verbose)
            i = i + 1
        }
    }
    tools.ob_flush()
    return code
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
