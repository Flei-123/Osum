import ulib
import h264
import mp4
import sha

const ANNEXB_CAP: u64 = 1048576
const ARGB_CAP: u64 = 3686400

const STEP_NONE: u64 = 0
const STEP_FRAME: u64 = 1
const STEP_END: u64 = 2
const STEP_ERROR: u64 = 3

static mut annexb: [u8; 1048576] = [0 as u8; 1048576]
static mut argb: [u8; 3686400] = [0 as u8; 3686400]
static mut digest: [u8; 32] = [0 as u8; 32]
static mut hex: [u8; 72] = [0 as u8; 72]

static mut m_open: bool = false
static mut m_next: u64 = 0
static mut m_cur: u64 = 0
static mut m_headers: u64 = 0

fn media_open(path: u64) -> bool {
    if m_open {
        mp4.mp4_close()
        m_open = false
    }
    if !mp4.mp4_open(path) { return false }
    if !mp4.mp4_has(mp4.TRK_VIDEO) {
        mp4.mp4_close()
        return false
    }
    m_headers = mp4.mp4_headers_annexb((&annexb[(0) as usize]) as u64, ANNEXB_CAP)
    if m_headers == 0 {
        mp4.mp4_close()
        return false
    }
    m_open = true
    return media_restart(0)
}

fn media_close() {
    if m_open {
        mp4.mp4_close()
        m_open = false
    }
}

fn media_restart(at: u64) -> bool {
    h264.h264_open((&annexb[(0) as usize]) as u64, m_headers)
    let _h: bool = h264.h264_next()
    if h264.h264_err() != 0 { return false }
    m_next = at
    m_cur = at
    return true
}

fn media_width() -> u64 { return h264.h264_width() }

fn media_height() -> u64 { return h264.h264_height() }

fn media_items() -> u64 { return mp4.mp4_items(mp4.TRK_VIDEO) }

fn media_duration_ms() -> u64 { return mp4.mp4_duration_ms(mp4.TRK_VIDEO) }

fn media_cur() -> u64 { return m_cur }

fn media_cur_ms() -> u64 { return mp4.mp4_item_ms(mp4.TRK_VIDEO, m_cur) }

fn media_item_ms(i: u64) -> u64 { return mp4.mp4_item_ms(mp4.TRK_VIDEO, i) }

fn media_err() -> u64 { return h264.h264_err() }

fn media_step() -> u64 {
    let n: u64 = mp4.mp4_items(mp4.TRK_VIDEO)
    if m_next >= n { return STEP_END }
    let buf: u64 = (&annexb[(0) as usize]) as u64
    let len: u64 = mp4.mp4_sample_annexb(m_next, buf, ANNEXB_CAP)
    if len == 0 { return STEP_ERROR }
    h264.h264_continue(buf, len)
    let got: bool = h264.h264_next()
    if h264.h264_err() != 0 { return STEP_ERROR }
    m_cur = m_next
    m_next = m_next + 1
    if got { return STEP_FRAME }
    return STEP_NONE
}

fn media_index_at(ms: u64) -> u64 {
    let n: u64 = mp4.mp4_items(mp4.TRK_VIDEO)
    var i: u64 = 0
    var best: u64 = 0
    while i < n {
        if mp4.mp4_item_ms(mp4.TRK_VIDEO, i) > ms { break }
        best = i
        i = i + 1
    }
    return best
}

fn media_key_before(i: u64) -> u64 {
    var k: u64 = i
    while k > 0 {
        if mp4.mp4_item_key(mp4.TRK_VIDEO, k) { return k }
        k = k - 1
    }
    return 0
}

fn media_seek_to(target: u64) -> bool {
    let key: u64 = media_key_before(target)
    if !media_restart(key) { return false }
    var guard: u64 = 0
    while guard <= target - key + 2 {
        let r: u64 = media_step()
        if r == STEP_ERROR || r == STEP_END { return false }
        if r == STEP_FRAME && m_cur >= target { return true }
        guard = guard + 1
    }
    return false
}

fn media_convert() -> u64 {
    let out: u64 = (&argb[(0) as usize]) as u64
    if !h264.h264_to_rgb(h264.h264_cur_slot(), out, ARGB_CAP) { return 0 }
    return out
}

fn media_argb_hash(out: u64) -> u64 {
    sha.begin()
    sha.update(out, media_width() * media_height() * 4)
    sha.finish((&digest[(0) as usize]) as u64)
    sha.hex_out((&digest[(0) as usize]) as u64, 32, (&hex[(0) as usize]) as u64)
    return (&hex[(0) as usize]) as u64
}
