import ulib
import libc.kcall
import libc.octets
import mp4
import mp3
import audio.aacplay

const SYS_AUDGET: u64 = 1850
const SYS_AUDSET: u64 = 1851
const SYS_AUDOPEN: u64 = 1853
const SYS_AUDSEND: u64 = 1854

const A_READY: u64 = 0
const A_RATE: u64 = 1
const A_PLAYED: u64 = 5
const A_REMAIN: u64 = 25

const AS_CLOSE: u64 = 8

const BUF_CAP: u64 = 524288
const CHUNK_FRAMES: u64 = 1024
const AHEAD_MS: u64 = 250
const FEED_ROUNDS: u64 = 8
const MP3_PREROLL: u64 = 2
const MP3_SKIP_LIMIT: u64 = 3
const AAC_PREROLL: u64 = 2
const AAC_IN_CAP: u64 = 16384
const ASC_CAP: u64 = 64
const SIGN_FLIP_SAMPLE: u64 = 1
const LEAD_LOUD: u64 = 1000
const LEAD_GIVE_UP: u64 = 20000

static mut a_buf: [u8; 524288] = [0 as u8; 524288]
static mut a_out: [u8; 4096] = [0 as u8; 4096]
static mut aac_in: [u8; 16384] = [0 as u8; 16384]
static mut aac_asc: [u8; 64] = [0 as u8; 64]

static mut a_active: bool = false
static mut a_disabled: bool = false
static mut a_started: bool = false
static mut a_ended: bool = false
static mut a_stream: u64 = 0
static mut a_item: u64 = 0
static mut a_pos: u64 = 0
static mut a_len: u64 = 0
static mut a_base_ms: u64 = 0
static mut a_sent: u64 = 0
static mut a_played0: u64 = 0
static mut a_dev_rate: u64 = 0
static mut a_stat_frames: u64 = 0
static mut a_stat_cross: u64 = 0
static mut a_stat_peak: u64 = 0
static mut a_stat_sum: u64 = 0
static mut a_stat_neg: bool = false
static mut a_lead: u64 = 0
static mut a_lead_done: bool = false
static mut a_gapless: bool = true
static mut aac_dec: u64 = 0
static mut aac_ready: bool = false
static mut aac_errors: u64 = 0

fn audio_disable() { a_disabled = true }

fn audio_no_gapless() { a_gapless = false }

fn audio_stat_lead() -> u64 { return a_lead }

fn aac_prepare() -> bool {
    if aac_ready { return true }
    let asc_n: u64 = mp4.mp4_aac_config((&aac_asc[(0) as usize]) as u64)
    if asc_n == 0 { return false }
    aac_dec = aacplay.aacplay_open((&aac_asc[(0) as usize]) as u64, asc_n as usize)
    aac_ready = aac_dec != 0
    return aac_ready
}

fn is_aac() -> bool { return mp4.mp4_audio_codec() == mp4.AC_AAC }

fn a_channels() -> u64 {
    if is_aac() && aac_ready { return aacplay.aacplay_channels(aac_dec) }
    return mp4.mp4_channels()
}

fn a_rate() -> u64 {
    if is_aac() && aac_ready { return aacplay.aacplay_hz(aac_dec) }
    return mp4.mp4_rate()
}

fn codec_supported(codec: u64) -> bool {
    return codec == mp4.AC_PCM_LE || codec == mp4.AC_MP3 || codec == mp4.AC_AAC
}

fn audio_available() -> bool {
    if a_disabled { return false }
    if !mp4.mp4_has(mp4.TRK_AUDIO) { return false }
    let codec: u64 = mp4.mp4_audio_codec()
    if !codec_supported(codec) { return false }
    if codec == mp4.AC_AAC {
        if !aac_prepare() { return false }
    } else if mp4.mp4_bits() != 16 {
        return false
    }
    let ch: u64 = a_channels()
    if ch != 1 && ch != 2 { return false }
    return ulib.sys(SYS_AUDGET, A_READY, 0, 0) == 1
}

fn audio_active() -> bool { return a_active }

fn s16_at(p: u64) -> i64 {
    let v: u64 = (__mmio_read8(p as *mut u8) as u64) | ((__mmio_read8((p + 1) as *mut u8) as u64) << 8)
    if v >= 32768 { return (v as i64) - 65536 }
    return v as i64
}

fn stat_frame(frames: u64) {
    let bpf: u64 = a_channels() * 2
    let src: u64 = (&a_buf[(0) as usize]) as u64
    var f: u64 = 0
    while f < frames {
        let v: i64 = s16_at(src + f * bpf)
        var mag: u64 = v as u64
        if v < 0 { mag = (0 - v) as u64 }
        if mag > a_stat_peak { a_stat_peak = mag }
        a_stat_sum = a_stat_sum + mag
        let neg: bool = v < 0
        if neg != a_stat_neg { a_stat_cross = a_stat_cross + SIGN_FLIP_SAMPLE }
        a_stat_neg = neg
        f = f + 1
    }
    a_stat_frames = a_stat_frames + frames
}

fn mp3_decode_item(i: u64) -> u64 {
    let n: u64 = mp4.mp4_sample_raw(mp4.TRK_AUDIO, i, mp3.mp3_inbuf(), mp3.MAXIN)
    if n == 0 { return 0 }
    return mp3.mp3_decode(n)
}

fn mp3_load(i: u64) -> bool {
    var k: u64 = i
    var tries: u64 = 0
    while tries < MP3_SKIP_LIMIT && k < mp4.mp4_items(mp4.TRK_AUDIO) {
        let frames: u64 = mp3_decode_item(k)
        if frames > 0 {
            let bytes: u64 = frames * mp4.mp4_channels() * 2
            octets.copy((&a_buf[(0) as usize]) as u64, mp3.mp3_pcm(), bytes)
            a_item = k
            a_pos = 0
            a_len = bytes
            stat_frame(frames)
            return true
        }
        k = k + 1
        tries = tries + 1
    }
    return false
}

fn mp3_preroll(idx: u64) {
    mp3.mp3_reset()
    var k: u64 = 0
    if idx > MP3_PREROLL { k = idx - MP3_PREROLL }
    while k < idx {
        let _d: u64 = mp3_decode_item(k)
        k = k + 1
    }
}

fn aac_decode_item(i: u64) -> u64 {
    let n: u64 = mp4.mp4_sample_raw(mp4.TRK_AUDIO, i, (&aac_in[(0) as usize]) as u64, AAC_IN_CAP)
    if n == 0 { return 0 }
    let frames: u64 = aacplay.aacplay_decode(aac_dec, (&aac_in[(0) as usize]) as u64, n as usize, (&a_buf[(0) as usize]) as u64)
    if frames == 0 {
        aac_errors = aac_errors + 1
        return aacplay.FRAME_SAMPLES
    }
    return frames
}

fn aac_load(i: u64) -> bool {
    let frames: u64 = aac_decode_item(i)
    if frames == 0 { return false }
    a_item = i
    a_pos = 0
    a_len = frames * a_channels() * 2
    stat_frame(frames)
    return true
}

fn aac_preroll(idx: u64) {
    aacplay.aacplay_reset(aac_dec)
    var k: u64 = 0
    if idx > AAC_PREROLL { k = idx - AAC_PREROLL }
    while k < idx {
        let _d: u64 = aac_decode_item(k)
        k = k + 1
    }
}

fn audio_load(i: u64) -> bool {
    let codec: u64 = mp4.mp4_audio_codec()
    if codec == mp4.AC_MP3 { return mp3_load(i) }
    if codec == mp4.AC_AAC { return aac_load(i) }
    let n: u64 = mp4.mp4_sample_raw(mp4.TRK_AUDIO, i, (&a_buf[(0) as usize]) as u64, BUF_CAP)
    if n == 0 { return false }
    a_item = i
    a_pos = 0
    a_len = n
    return true
}

fn audio_stat_frames() -> u64 { return a_stat_frames }

fn audio_stat_cross() -> u64 { return a_stat_cross }

fn audio_stat_peak() -> u64 { return a_stat_peak }

fn audio_stat_sum() -> u64 { return a_stat_sum }

fn audio_stat_errors() -> u64 { return mp3.mp3_errors() + mp3.mp3_skipped() + aac_errors }

fn audio_item_at(ms: u64) -> u64 {
    let n: u64 = mp4.mp4_items(mp4.TRK_AUDIO)
    var i: u64 = 0
    var best: u64 = 0
    while i < n {
        if mp4.mp4_item_ms(mp4.TRK_AUDIO, i) > ms { break }
        best = i
        i = i + 1
    }
    return best
}

fn decoder_delay_samples() -> u64 {
    if mp4.mp4_audio_codec() != mp4.AC_MP3 || !a_gapless { return 0 }
    return mp4.mp4_audio_delay()
}

fn skip_whole_items(skip_in: u64, bpf: u64) -> u64 {
    var skip: u64 = skip_in
    while skip * bpf >= a_len {
        let held: u64 = a_len / bpf
        if !audio_load(a_item + 1) { return 0 }
        skip = skip - held
    }
    return skip
}

fn audio_start(ms: u64) -> bool {
    audio_stop()
    if !audio_available() { return false }
    let id: u64 = ulib.sys(SYS_AUDOPEN, a_rate(), 0, 0)
    if ulib.bad(id) { return false }
    a_stream = id
    let delay: u64 = decoder_delay_samples()
    let delay_ms: u64 = delay * 1000 / a_rate()
    let target_ms: u64 = ms + delay_ms
    let idx: u64 = audio_item_at(target_ms)
    if mp4.mp4_audio_codec() == mp4.AC_MP3 { mp3_preroll(idx) }
    if is_aac() { aac_preroll(idx) }
    if !audio_load(idx) {
        ulib.sys(SYS_AUDSET, AS_CLOSE, a_stream, 0)
        return false
    }
    let bpf: u64 = a_channels() * 2
    var skip: u64 = 0
    let first_ms: u64 = mp4.mp4_item_ms(mp4.TRK_AUDIO, a_item)
    if target_ms > first_ms { skip = (target_ms - first_ms) * a_rate() / 1000 }
    skip = skip_whole_items(skip, bpf)
    let item_ms: u64 = mp4.mp4_item_ms(mp4.TRK_AUDIO, a_item)
    a_pos = skip * bpf
    a_base_ms = item_ms + skip * 1000 / a_rate()
    if a_base_ms > delay_ms { a_base_ms = a_base_ms - delay_ms } else { a_base_ms = 0 }
    a_sent = 0
    a_lead = 0
    a_lead_done = false
    a_started = false
    a_ended = false
    a_dev_rate = ulib.sys(SYS_AUDGET, A_RATE, 0, 0)
    if a_dev_rate == 0 { a_dev_rate = a_rate() }
    a_active = true
    return true
}

fn audio_stop() {
    if a_active {
        ulib.sys(SYS_AUDSET, AS_CLOSE, a_stream, 0)
        a_active = false
    }
}

fn remaining_ms() -> u64 {
    return ulib.sys(SYS_AUDGET, A_REMAIN, 0, 0) * 1000 / a_dev_rate
}

fn track_lead(n: u64) {
    if a_lead_done { return }
    let src: u64 = (&a_out[(0) as usize]) as u64
    var f: u64 = 0
    while f < n {
        var mag: u64 = 0
        let v: i64 = s16_at(src + f * 4)
        if v < 0 { mag = (0 - v) as u64 } else { mag = v as u64 }
        if mag >= LEAD_LOUD || a_lead >= LEAD_GIVE_UP {
            a_lead_done = true
            return
        }
        a_lead = a_lead + 1
        f = f + 1
    }
}

fn convert_chunk(n: u64) {
    let src: u64 = (&a_buf[(0) as usize]) as u64 + a_pos
    let dst: u64 = (&a_out[(0) as usize]) as u64
    if a_channels() == 2 {
        var k: u64 = 0
        while k < n * 4 {
            __mmio_write8((dst + k) as *mut u8, __mmio_read8((src + k) as *mut u8))
            k = k + 1
        }
        return
    }
    var f: u64 = 0
    while f < n {
        let lo: u8 = __mmio_read8((src + f * 2) as *mut u8)
        let hi: u8 = __mmio_read8((src + f * 2 + 1) as *mut u8)
        __mmio_write8((dst + f * 4) as *mut u8, lo)
        __mmio_write8((dst + f * 4 + 1) as *mut u8, hi)
        __mmio_write8((dst + f * 4 + 2) as *mut u8, lo)
        __mmio_write8((dst + f * 4 + 3) as *mut u8, hi)
        f = f + 1
    }
}

fn audio_feed() {
    if !a_active { return }
    var round: u64 = 0
    while round < FEED_ROUNDS {
        round = round + 1
        if a_started && remaining_ms() >= AHEAD_MS { return }
        if a_pos >= a_len {
            if !audio_load(a_item + 1) {
                a_ended = true
                return
            }
        }
        let bpf: u64 = a_channels() * 2
        var n: u64 = (a_len - a_pos) / bpf
        if n > CHUNK_FRAMES { n = CHUNK_FRAMES }
        if n == 0 {
            a_pos = a_len
            continue
        }
        convert_chunk(n)
        track_lead(n)
        let got: u64 = kcall.sys4(SYS_AUDSEND, a_stream, (&a_out[(0) as usize]) as u64, n, 0)
        if ulib.bad(got) { return }
        a_pos = a_pos + got * bpf
        a_sent = a_sent + got
        if got > 0 && !a_started {
            a_started = true
            a_played0 = ulib.sys(SYS_AUDGET, A_PLAYED, 0, 0)
        }
        if got < n { return }
    }
}

fn audio_clock_ms() -> u64 {
    if !a_started { return a_base_ms }
    let played: u64 = ulib.sys(SYS_AUDGET, A_PLAYED, 0, 0)
    if played < a_played0 { return a_base_ms }
    return a_base_ms + (played - a_played0) * 1000 / a_dev_rate
}

fn audio_done() -> bool {
    return a_active && a_ended && ulib.sys(SYS_AUDGET, A_REMAIN, 0, 0) == 0
}
