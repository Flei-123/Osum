// kernel/user/ps.fi -- round K6: the task table, from ring 3.
//
// A program may not read a kernel variable, so it asks: SYS_PSTAT(index,
// field) is one number out of one slot, and `ps` walks the table with it.
// There is no buffer and no pointer into the kernel anywhere in this --
// which is why a `ps` that lies is a `ps` the kernel lied to.
//
// The columns are what a task record really holds (`kernel/
// sched.fi`): who it is, who made it, what it is doing, what kind of task
// it is, how long its turn is and how many of them it has had.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var head: [u8; 41] = "  PID PPID STATE   KIND   PRIO TICKS NET\0"
    // ROUND NETVIEW: the four views as four words. Written out here
    // rather than fetched from `kernel/user/nv.fi`: `ps` is one of the
    // twenty-eight programs on the drive, `tools/userland/run.sh`
    // measures the userland against the 2 097 152 octets of that drive,
    // and linking a module for one system call cost more than the four
    // words do.
    // FOUR SLOTS OF NINE OCTETS IN ONE ARRAY, and the view is the
    // index. Four separate words and a chain of four branches cost this
    // program 4 368 octets in firnc1, and the userland has 1 000 octets
    // of room left against the drive -- that is measured in
    // `tools/userland/run.sh` and it is why this is arithmetic and not
    // an `if`.
    var vw: [u8; 36] = "real\0\0\0\0\0filtered\0faked\0\0\0\0none\0\0\0\0\0"
    var s_sp: [u8; 2] = " \0"
    var st_ready: [u8; 8] = "ready  \0"
    var st_run: [u8; 8] = "run    \0"
    var st_sleep: [u8; 8] = "sleep  \0"
    var st_wait: [u8; 8] = "wait   \0"
    var st_zomb: [u8; 8] = "zombie \0"
    var st_new: [u8; 8] = "new    \0"
    var k_boot: [u8; 8] = "boot   \0"
    var k_idle: [u8; 8] = "idle   \0"
    var k_work: [u8; 8] = "worker \0"
    var k_user: [u8; 8] = "user   \0"

    ulib.say((&head[0 as usize]) as u64)
    ulib.nl()
    var i: u64 = 0
    var shown: u64 = 0
    while i < 32 {
        let st: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_STATE, 0)
        if !ulib.bad(st) && st != 0 {
            let pid: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PID, 0)
            ulib.pad(pid, 5)
            ulib.pad(ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PPID, 0), 5)
            ulib.say((&s_sp[0 as usize]) as u64)
            if st == 1 {
                ulib.say((&st_ready[0 as usize]) as u64)
            } else if st == 2 {
                ulib.say((&st_run[0 as usize]) as u64)
            } else if st == 3 {
                ulib.say((&st_sleep[0 as usize]) as u64)
            } else if st == 4 {
                ulib.say((&st_wait[0 as usize]) as u64)
            } else if st == 5 {
                ulib.say((&st_zomb[0 as usize]) as u64)
            } else {
                ulib.say((&st_new[0 as usize]) as u64)
            }
            let kind: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_KIND, 0)
            if kind == 0 {
                ulib.say((&k_boot[0 as usize]) as u64)
            } else if kind == 1 {
                ulib.say((&k_idle[0 as usize]) as u64)
            } else if kind == 2 {
                ulib.say((&k_work[0 as usize]) as u64)
            } else {
                ulib.say((&k_user[0 as usize]) as u64)
            }
            ulib.pad(ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PRIO, 0), 4)
            ulib.pad(ulib.sys(ulib.SYS_PSTAT, i, ulib.P_TICKS, 0), 6)
            // ROUND NETVIEW: WHICH NETWORK THIS PROCESS SEES. It stands
            // in `ps` and not only in a settings window, because the
            // rule of that round is that the PROGRAM is deceived and
            // never the person -- and the place a person looks first is
            // here.
            ulib.say((&s_sp[0 as usize]) as u64)
            var v: u64 = ulib.sys(ulib.SYS_NETVGET, pid, ulib.NV_MODE, 0)
            if v > ulib.V_NONE {
                v = ulib.V_REAL
            }
            ulib.say((&vw[0 as usize]) as u64 + v * 9)
            ulib.nl()
            shown = shown + 1
        }
        i = i + 1
    }
    if shown == 0 {
        return 1
    }
    return 0
}
