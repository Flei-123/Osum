fn eject_click(tree: u64, tab: u64, stat: u64, fpfad: u64) {
    var s_a: [u8; 17] = "explorer: eject \0"
    var s_rc: [u8; 5] = " rc=\0"
    if expbase.place_choice >= exporte.places_num()
        || !exporte.place_is_carrier(expbase.place_choice) {
        expwork.stat_set(msg.get((&k_ausnone[0 as usize]) as u64))
        expwork.say((&s_a[0 as usize]) as u64)
        expwork.sayn(999)
        expwork.nl()
        return
    }
    let target: u64 = exporte.place_path(expbase.place_choice)
    if target == 0 {
        return
    }
    var i: u64 = 0
    var tr: u64 = ulib.WX_MAX
    while i < ulib.WX_MAX {
        var pf: [u8; 24] = [0 as u8; 24]
        var n: u64 = 0
        while n < 23 {
            let c: u64 = ulib.sys(ulib.SYS_WECHSEL, ulib.WX_PATHCH, i, n)
            pf[n as usize] = c as u8
            if c == 0 {
                n = 23
            } else {
                n = n + 1
            }
        }
        pf[23] = 0 as u8
        if ulib.streq((&pf[0 as usize]) as u64, target) {
            tr = i
            i = ulib.WX_MAX
        } else {
            i = i + 1
        }
    }
    if tr >= ulib.WX_MAX {
        expwork.stat_set(msg.get((&k_ausnone[0 as usize]) as u64))
        return
    }
    let rc: u64 = ulib.sys(ulib.SYS_WECHSEL, ulib.WX_EJECT, tr, 0)
    expwork.say((&s_a[0 as usize]) as u64)
    expwork.say(target)
    expwork.kv((&s_rc[0 as usize]) as u64, rc)
    expwork.nl()
    if rc == 0 {
        expwork.stat_set(msg.get((&k_ausok[0 as usize]) as u64))
        expbase.place_choice = 0xFFFFFFFFFFFFFFFF
        places_show()
        if text.length((&expbase.dir_path[0 as usize]) as u64) >= text.length(target)
            && expwork.compare_start((&expbase.dir_path[0 as usize]) as u64, target) {
            expbase.dir_path[0] = 47 as u8
            expbase.dir_path[1] = 0 as u8
            expwork.hist_push((&expbase.dir_path[0 as usize]) as u64)
        }
        new_read(tree, tab, stat, fpfad)
        return
    }
    if rc == 16 {
        expwork.stat_set(msg.get((&k_ausbusy[0 as usize]) as u64))
        return
    }
    expwork.stat_set(msg.get((&k_ausfail[0 as usize]) as u64))
}

fn place_walk(line: u64, tree: u64, tab: u64, stat: u64, fpfad: u64) {
    var s_g: [u8; 21] = "explorer: ortsprung \0"
    if line >= exporte.places_num() {
        return
    }
    if exporte.place_is_header(line) {
        return
    }
    if exporte.place_is_overview(line) {
        // r458: the overview of all drives with their fill bars
        expbase.vmodus = 3
        new_read(tree, tab, stat, fpfad)
        expwork.say((&expbase.s_ovw[0 as usize]) as u64)
        expwork.sayn(expbase.entry_count)
        expwork.nl()
        return
    }
    if exporte.place_is_tool(line) {
        // "Disk management": a program of its own (docs/DISKS.md); the file manager never edits a table
        var dprog: [u8; 12] = "/bin/disks\0\0"
        let dpid: u64 = ulib.sys(ulib.SYS_EXEC, (&dprog[0 as usize]) as u64, 0, 0)
        expwork.say((&expbase.s_dmgmt[0 as usize]) as u64)
        expwork.sayn(dpid)
        expwork.nl()
        expwork.nav_sync_sel()
        return
    }
    let target: u64 = exporte.place_path(line)
    if target == 0 || (*((target) as *mut u8)) == 0 as u8 {
        return
    }
    expbase.vmodus = 0
    ulib.strncpy((&expbase.dir_path[0 as usize]) as u64, target, 126)
    expwork.hist_push((&expbase.dir_path[0 as usize]) as u64)
    new_read(tree, tab, stat, fpfad)
    expwork.say((&s_g[0 as usize]) as u64)
    expwork.say((&expbase.dir_path[0 as usize]) as u64)
    expwork.nl()
}

static mut k_konftit: [u8; 24] = "explorer.conflict.title\0"

static mut k_konfbtn: [u8; 26] = "explorer.conflict.buttons\0"

static mut k_konfask: [u8; 22] = "explorer.conflict.ask\0"

static mut kfl_alt: [u8; 256] = [0 as u8; 256]

static mut kfl_fresh: [u8; 128] = [0 as u8; 128]

fn conflict_show(besitzer: u64) -> bool {
    var s_k: [u8; 20] = "explorer: konflikt \0"
    if !expakt.conflict_present() {
        return false
    }
    let _b: u64 = besitzer
    let _d: u64 = expwork.dlg_choice(msg.get((&k_konftit[0 as usize]) as u64),
        msg.get((&k_konfask[0 as usize]) as u64),
        msg.get((&k_konfbtn[0 as usize]) as u64), 4)
    say_dlgrect()
    expwork.say((&s_k[0 as usize]) as u64)
    expwork.say(expakt.conflict_path())
    expwork.nl()
    return true
}

fn paste_do(besitzer: u64, tree: u64, tab: u64, stat: u64,
    fpfad: u64, fresh: bool) -> u64 {
    var s_p: [u8; 17] = "explorer: paste \0"
    var s_n: [u8; 3] = "n=\0"
    var s_rc: [u8; 4] = "rc=\0"
    expbase.kfl_op = 1
    if fresh {
        let _l: u64 = expakt.load_from_bus()
    }
    let rc: u64 = expakt.paste((&expbase.dir_path[0 as usize]) as u64)
    expwork.say((&s_p[0 as usize]) as u64)
    expwork.kv((&s_n[0 as usize]) as u64, expakt.clipboard_num())
    expwork.kv((&s_rc[0 as usize]) as u64, rc)
    expwork.nl()
    new_read(tree, tab, stat, fpfad)
    if conflict_show(besitzer) {
        return 9
    }
    let _f: bool = expwork.error_show(rc)
    return 0
}

fn rename_do(besitzer: u64, alt: u64, fresh: u64, tree: u64, tab: u64,
    stat: u64, fpfad: u64) -> u64 {
    ulib.strncpy((&kfl_alt[0 as usize]) as u64, alt, 250)
    ulib.strncpy((&kfl_fresh[0 as usize]) as u64, fresh, 120)
    expbase.kfl_op = 2
    let rc: u64 = expakt.rename_entry((&kfl_alt[0 as usize]) as u64,
        (&kfl_fresh[0 as usize]) as u64)
    new_read(tree, tab, stat, fpfad)
    if conflict_show(besitzer) {
        return 9
    }
    let _f: bool = expwork.error_show(rc)
    return 0
}

fn conflict_reply(choice: u64, besitzer: u64, tree: u64, tab: u64,
    stat: u64, fpfad: u64) -> u64 {
    expakt.conflict_reply(choice)
    if choice == expakt.K_ABBRUCH {
        return 0
    }
    if expbase.kfl_op == 2 {
        return rename_do(besitzer, (&kfl_alt[0 as usize]) as u64,
            (&kfl_fresh[0 as usize]) as u64, tree, tab, stat, fpfad)
    }
    return paste_do(besitzer, tree, tab, stat, fpfad, false)
}

fn open(line: u64, tree: u64, tab: u64, stat: u64, fpfad: u64,
    mark: u64) {
    if line >= expwork.m_count() {
        return
    }
    let e: u64 = expwork.m_ord(line)
    // RUNDE EXPLORER-2, Befund 15-unterordner.png: DER DOPPELKLICK
    // GING INS LEERE.
    let name: u64 = expwork.m_name(e)
    // r458: IN THE OVERVIEW a row is a drive: go there
    if expbase.vmodus == 3 {
        expbase.vmodus = 0
        ulib.strncpy((&expbase.dir_path[0 as usize]) as u64, name, 126)
        expwork.hist_push((&expbase.dir_path[0 as usize]) as u64)
        new_read(tree, tab, stat, fpfad)
        return
    }
    if expbase.vmodus == 2 {
        if expwork.m_art(e) != 0 {
            var sl2: [u8; 2] = "/\0"
            ulib.strcat((&expbase.vunter[0 as usize]) as u64,
                (&sl2[0 as usize]) as u64)
            ulib.strcat((&expbase.vunter[0 as usize]) as u64, name)
            expwork.show_place(fpfad)
            new_read(tree, tab, stat, fpfad)
        }
        return
    }
    if expbase.vmodus == 1 {
        expbase.vmodus = 2
        ulib.strncpy((&expbase.vsicher[0 as usize]) as u64, name, 60)
        expbase.vunter[(0) as usize] = 0 as u8
        expwork.show_place(fpfad)
        new_read(tree, tab, stat, fpfad)
        return
    }
    if expwork.m_art(e) != 0 {
        let full: u64 = expwork.join((&expbase.dir_path[0 as usize]) as u64, name)
        if expvault.is_vault_dir(full) {
            var s_vault: [u8; 15] = " vault pid=\0\0\0\0"
            let vault_pid: u64 = expvault.launch()
            expwork.say(mark)
            expwork.say(full)
            expwork.say((&s_vault[0 as usize]) as u64)
            expwork.sayn(vault_pid)
            expwork.nl()
            return
        }
        ulib.strncpy((&expbase.dir_path[0 as usize]) as u64, full, 126)
        if bstore.is_store((&expbase.dir_path[0 as usize]) as u64) {
            expbase.vmodus = 1
            ulib.strncpy((&expbase.vspeicher[0 as usize]) as u64,
                (&expbase.dir_path[0 as usize]) as u64, 120)
        }
        expwork.hist_push((&expbase.dir_path[0 as usize]) as u64)
        new_read(tree, tab, stat, fpfad)
        return
    }
    var full: u64 = expwork.join((&expbase.dir_path[0 as usize]) as u64, name)
    if expsmb.is_url((&expbase.dir_path[0 as usize]) as u64) {
        let fetched: u64 = expsmb.fetch(full)
        if fetched == 0 {
            smb_prompt()
            return
        }
        full = fetched
    }
    var arg: [u8; 200] = [0 as u8; 200]
    ulib.strncpy((&arg[0 as usize]) as u64, full, 190)
    let path_len: u64 = text.length(full)
    var opened_pid: u64 = handler.open_target((&arg[0 as usize]) as u64)
    if opened_pid == handler.NO_HANDLER {
        opened_pid = 0xFFFFFFFFFFFFFFFF
    }
    // Editor merge (16.10.2026): text and source files open in the windowed Editor (/bin/nedit <file>).
    if ulib.bad(opened_pid) {
        if expwork.is_text_file(full, path_len) {
            var txtprog: [u8; 11] = "/bin/nedit\0"
            var txtname: [u8; 6] = "nedit\0"
            var txtargv: [u64; 2] = [0 as u64; 2]
            txtargv[0 as usize] = (&txtname[0 as usize]) as u64
            txtargv[1 as usize] = (&arg[0 as usize]) as u64
            opened_pid = ulib.sys(ulib.SYS_EXEC, (&txtprog[0 as usize]) as u64,
                (&txtargv[0 as usize]) as u64, 2)
        }
    }
    var pid: u64 = opened_pid
    if ulib.bad(opened_pid) {
        pid = ulib.sys(ulib.SYS_EXEC, (&arg[0 as usize]) as u64, 0, 0)
    }
    expwork.say(mark)
    expwork.say(full)
    var sp: [u8; 8] = " pid=\0\0\0"
    expwork.say((&sp[0 as usize]) as u64)
    expwork.sayn(pid)
    expwork.nl()
}

fn save(target: u64, tree: u64, tab: u64, stat: u64, fpfad: u64) {
    var s_fertig: [u8; 12] = "  -- fertig\0"
    var s_error: [u8; 20] = "  -- FEHLGESCHLAGEN\0"
    var d: [u8; 24] = [0 as u8; 24]
    var nam: [u8; 32] = [0 as u8; 32]

    if expwork.in_own_tree(target) {
        expwork.dlg_ask(msg.get((&expbase.k_t_bak[0 as usize]) as u64),
            msg.get((&k_t_self2[0 as usize]) as u64))
        expwork.say_backup(target, (&t_snap[0 as usize]) as u64, 2)
        return
    }
    ulib.strcpy((&nam[0 as usize]) as u64, (&t_snap[0 as usize]) as u64)
    let k: u64 = text.digits(expwork.next_number(target), (&d[0 as usize]) as u64, true)
    var i: u64 = 0
    let l0: u64 = text.length((&nam[0 as usize]) as u64)
    while i < k {
        nam[((l0 + i)) as usize] = *(((&d[0 as usize]) as u64 + i) as *mut u8)
        i = i + 1
    }
    nam[((l0 + k)) as usize] = 0 as u8

    fuiscene.dialog_busy(msg.get((&expbase.k_t_bak[0 as usize]) as u64),
        msg.get((&k_t_lauft[0 as usize]) as u64))
    plabel = 1
    fuiscene.repaint_now()
    let rc: u64 = bstore.save((&expbase.t_bquelle[0 as usize]) as u64, target,
        (&nam[0 as usize]) as u64, 0, (&expbase.t_bquelle[0 as usize]) as u64,
        progress_state)
    plabel = 0xFFFFFFFFFFFFFFFF
    expwork.build_progress()
    var lp: u64 = text.length((&expbase.pbuf[0 as usize]) as u64)
    var q: u64 = 0
    var txt: u64 = (&s_fertig[0 as usize]) as u64
    if rc != 0 {
        txt = (&s_error[0 as usize]) as u64
    }
    while (*((txt + q) as *mut u8)) != 0 as u8 && lp < 126 {
        expbase.pbuf[(lp) as usize] = *((txt + q) as *mut u8)
        lp = lp + 1
        q = q + 1
    }
    expbase.pbuf[(lp) as usize] = 0 as u8
    fuiscene.dialog_open(msg.get((&expbase.k_t_bak[0 as usize]) as u64),
        (&expbase.pbuf[0 as usize]) as u64, msg.get((&expbase.t_ok[0 as usize]) as u64), 0)
    expwork.say_backup(target, (&nam[0 as usize]) as u64, rc)
    new_read(tree, tab, stat, fpfad)
}

fn tree_walk(line: u64, tree: u64, tab: u64, stat: u64, fpfad: u64) {
    if line == 0 {
        if expbase.vmodus == 2 {
            if expbase.vunter[(0) as usize] != 0 as u8 {
                expwork.eltern_v((&expbase.vunter[0 as usize]) as u64)
            } else {
                expbase.vmodus = 1
            }
            expwork.show_place(fpfad)
            new_read(tree, tab, stat, fpfad)
            return
        }
        if expbase.vmodus == 3 {
            // up from the overview: back to the folder we came from
            expbase.vmodus = 0
            new_read(tree, tab, stat, fpfad)
            return
        }
        if expbase.vmodus == 1 {
            expbase.vmodus = 0
        }
        expwork.eltern((&expbase.dir_path[0 as usize]) as u64)
        expwork.hist_push((&expbase.dir_path[0 as usize]) as u64)
        new_read(tree, tab, stat, fpfad)
        return
    }
    if expbase.vmodus != 0 {
        return
    }
    var seen: u64 = 0
    var i: u64 = 0
    while i < expwork.m_count() {
        let e: u64 = expwork.m_ord(i)
        if expwork.m_art(e) != 0 {
            seen = seen + 1
            if seen == line {
                let full: u64 = expwork.join((&expbase.dir_path[0 as usize]) as u64, expwork.m_name(e))
                ulib.strncpy((&expbase.dir_path[0 as usize]) as u64, full, 126)
                expwork.hist_push((&expbase.dir_path[0 as usize]) as u64)
                new_read(tree, tab, stat, fpfad)
                i = expwork.m_count()
            }
        }
        i = i + 1
    }
}

fn zip_starten(full: u64, packen: bool, tree: u64, tab: u64, stat: u64,
    fpfad: u64) {
    var tool: [u8; 9] = "/bin/zip\0"
    var o_c: [u8; 3] = "-c\0"
    var o_x: [u8; 3] = "-x\0"
    var target: [u8; 200] = [0 as u8; 200]
    var endung: [u8; 5] = ".zip\0"
    var s_go: [u8; 20] = "explorer: zip pid=\0\0"
    var argv: [u64; 4] = [0 as u64; 4]
    argv[0 as usize] = (&tool[0 as usize]) as u64
    if packen {
        ulib.strncpy((&target[0 as usize]) as u64, full, 190)
        ulib.strcat((&target[0 as usize]) as u64,
            (&endung[0 as usize]) as u64)
        argv[1 as usize] = (&o_c[0 as usize]) as u64
        argv[2 as usize] = (&target[0 as usize]) as u64
        argv[3 as usize] = full
    } else {
        argv[1 as usize] = (&o_x[0 as usize]) as u64
        argv[2 as usize] = full
        argv[3 as usize] = (&expbase.dir_path[0 as usize]) as u64
    }
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&tool[0 as usize]) as u64,
        (&argv[0 as usize]) as u64, 4)
    expwork.say((&s_go[0 as usize]) as u64)
    expwork.sayn(pid)
    expwork.nl()
    if !ulib.bad(pid) && pid != 0 {
        let _w: u64 = ulib.wait_code(pid)
    }
    new_read(tree, tab, stat, fpfad)
}

static mut bm_lbl: [u8; 1100] = [0 as u8; 1100] // labels, one per line

static mut k_noacts: [u8; 22] = "explorer.actions.none\0"

// Ask the bus for the entries of the selected row and open the sub menu.
// Returns the menu number (14) or 0 when nothing could be opened.
fn actions_menu() -> u64 {
    var s_lf: [u8; 17] = "list --menu file\0"
    var s_ld: [u8; 16] = "list --menu dir\0"
    var s_sp: [u8; 2] = " \0"
    var s_nl: [u8; 2] = "\n\0"
    let z: u64 = expwork.cur_row()
    expbase.bm_n = 0
    if z >= expwork.m_count() {
        return 0
    }
    let e: u64 = expwork.m_ord(z)
    ulib.strncpy((&expbase.bm_path[0 as usize]) as u64, expwork.full_from(z), 190)
    var at: u64 = 0
    if expwork.m_art(e) != 0 {
        at = expwork.bm_cat((&expbase.bm_line[0 as usize]) as u64, 0, (&s_ld[0 as usize]) as u64, 290)
    } else {
        at = expwork.bm_cat((&expbase.bm_line[0 as usize]) as u64, 0, (&s_lf[0 as usize]) as u64, 290)
    }
    at = expwork.bm_cat((&expbase.bm_line[0 as usize]) as u64, at, (&s_sp[0 as usize]) as u64, 290)
    at = expwork.bm_cat((&expbase.bm_line[0 as usize]) as u64, at, expwork.m_name(e), 290)
    var la: u64 = 0
    __mmio_write8(((&bm_lbl[0 as usize]) as u64) as *mut u8, 0 as u8)
    if actcli.open() {
        actcli.req((&expbase.bm_line[0 as usize]) as u64)
        if actcli.send(300) == actcli.R_OK {
            var k: u64 = 1
            while expbase.bm_n < 8 && actcli.line(k, (&expbase.bm_tmp[0 as usize]) as u64, 230) {
                // action TAB label TAB level
                let t: u64 = (&expbase.bm_tmp[0 as usize]) as u64
                var a: u64 = 0
                var nm: u64 = (&expbase.bm_names[0 as usize]) as u64 + expbase.bm_n * 64
                while __mmio_read8((t + a) as *mut u8) != 0 as u8
                    && __mmio_read8((t + a) as *mut u8) != 9 as u8 && a < 62 {
                    __mmio_write8((nm + a) as *mut u8, __mmio_read8((t + a) as *mut u8))
                    a = a + 1
                }
                __mmio_write8((nm + a) as *mut u8, 0 as u8)
                if __mmio_read8((t + a) as *mut u8) == 9 as u8 {
                    a = a + 1
                }
                var lb: [u8; 80] = [0 as u8; 80]
                var b: u64 = 0
                while __mmio_read8((t + a) as *mut u8) != 0 as u8
                    && __mmio_read8((t + a) as *mut u8) != 9 as u8 && b < 78 {
                    lb[b as usize] = __mmio_read8((t + a) as *mut u8)
                    a = a + 1
                    b = b + 1
                }
                if la + 80 < 1090 {
                    la = expwork.bm_cat((&bm_lbl[0 as usize]) as u64, la,
                        (&lb[0 as usize]) as u64, 1090)
                    la = expwork.bm_cat((&bm_lbl[0 as usize]) as u64, la,
                        (&s_nl[0 as usize]) as u64, 1090)
                    expbase.bm_n = expbase.bm_n + 1
                }
                k = k + 1
            }
        }
    }
    if expbase.bm_n == 0 {
        // nobody offers anything for this entry: say so instead of nothing
        la = expwork.bm_cat((&bm_lbl[0 as usize]) as u64, 0,
            msg.get((&k_noacts[0 as usize]) as u64), 1090)
    }
    let _n: u64 = popup_at(fuiscene.menu_x(), fuiscene.menu_y(),
        (&bm_lbl[0 as usize]) as u64)
    return 14
}

fn undo_do(tree: u64, tab: u64, stat: u64, fpfad: u64) -> u64 {
    var s_u: [u8; 16] = "explorer: undo \0"
    var s_a: [u8; 5] = "art=\0"
    var s_rc: [u8; 4] = "rc=\0"
    let art0: u64 = expakt.undo_art()
    let rc: u64 = expakt.undo_last()
    new_read(tree, tab, stat, fpfad)
    expwork.say((&s_u[0 as usize]) as u64)
    expwork.kv((&s_a[0 as usize]) as u64, art0)
    expwork.kv((&s_rc[0 as usize]) as u64, rc)
    expwork.nl()
    let _f: bool = expwork.error_show(rc)
    return 0
}

fn save_ask(tab: u64, tree: u64, stat: u64, fpfad: u64) -> u64 {
    ulib.strncpy((&expbase.pziel[0 as usize]) as u64, (&expbase.dir_path[0 as usize]) as u64,
        120)
    let z2: u64 = expwork.cur_row()
    if z2 < expwork.m_count() {
        let e2: u64 = expwork.m_ord(z2)
        if expwork.m_art(e2) != 0 {
            ulib.strncpy((&expbase.pziel[0 as usize]) as u64,
                expwork.join((&expbase.dir_path[0 as usize]) as u64, expwork.m_name(e2)), 120)
        }
    }
    if bstore.is_store((&expbase.pziel[0 as usize]) as u64) {
        save((&expbase.pziel[0 as usize]) as u64, tree, tab, stat, fpfad)
        return 0
    }
    let _d: u64 = expwork.dlg_ask(msg.get((&expbase.k_t_bak[0 as usize]) as u64),
        msg.get((&k_t_bfrage[0 as usize]) as u64))
    return 4
}

fn goto_to(idx: u64, tree: u64, tab: u64, stat: u64, fpfad: u64) -> u64 {
    var t_home: [u8; 8] = "/home\0\0\0"
    var t_data: [u8; 8] = "/data\0\0\0"
    var s_g: [u8; 18] = "explorer: gehezu \0"
    if idx == 0 {
        hist_back(tree, tab, stat, fpfad)
    } else if idx == 1 {
        hist_forward(tree, tab, stat, fpfad)
    } else if idx == 2 {
        expwork.eltern((&expbase.dir_path[0 as usize]) as u64)
        expwork.hist_push((&expbase.dir_path[0 as usize]) as u64)
        new_read(tree, tab, stat, fpfad)
    } else if idx == 3 {
        var wohin: u64 = (&t_data[0 as usize]) as u64
        if ulib.is_dir((&t_home[0 as usize]) as u64) {
            wohin = (&t_home[0 as usize]) as u64
        }
        expbase.vmodus = 0
        ulib.strncpy((&expbase.dir_path[0 as usize]) as u64, wohin, 126)
        expwork.hist_push((&expbase.dir_path[0 as usize]) as u64)
        new_read(tree, tab, stat, fpfad)
    } else if idx == 4 {
        let k: u64 = trash.trash_from((&expbase.dir_path[0 as usize]) as u64)
        if k != 0 {
            expbase.vmodus = 0
            ulib.strncpy((&expbase.dir_path[0 as usize]) as u64, k, 126)
            expwork.hist_push((&expbase.dir_path[0 as usize]) as u64)
            new_read(tree, tab, stat, fpfad)
        }
    }
    expwork.say((&s_g[0 as usize]) as u64)
    expwork.sayn(idx)
    var sp: [u8; 2] = " \0"
    expwork.say((&sp[0 as usize]) as u64)
    expwork.say((&expbase.dir_path[0 as usize]) as u64)
    expwork.nl()
    return 0
}

