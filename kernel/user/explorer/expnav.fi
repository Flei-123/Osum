    expwork.kv(((&s_dy[0 as usize]) as u64), fuiscene.dialog_btn_y())
    expwork.kv(((&s_dw[0 as usize]) as u64), fuiscene.dialog_btn_w())
    expwork.kv(((&s_dh[0 as usize]) as u64), fuiscene.dialog_btn_h())
    expwork.nl()
}

static mut s_cbar: [u8; 18] = "explorer: cmdbar \0"

