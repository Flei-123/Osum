// A click (or Enter) on a row of the pane.
fn nav_click(tree: u64, tab: u64, stat: u64, fpfad: u64) {
    let row: u64 = fuiscene.table_sel(expbase.K_PLACES)
    if row >= expbase.nav_n {
        return
    }
    let t: u64 = expbase.nav_refs[(row) as usize]
    if t < expbase.NAV_UP {
        expbase.place_choice = t
        place_walk(t, tree, tab, stat, fpfad)
    } else if t == expbase.NAV_UP {
        tree_walk(0, tree, tab, stat, fpfad)
    } else if t >= expbase.NAV_SUB {
        tree_walk(t - expbase.NAV_SUB + 1, tree, tab, stat, fpfad)
    }
}

fn tab_new(tree: u64, tab: u64, stat: u64, fpfad: u64) {
    if expbase.tab_n >= expbase.TAB_MAX {
        var s_voll: [u8; 22] = "explorer: reiter voll\0"
        expwork.say((&s_voll[0 as usize]) as u64)
        expwork.nl()
        return
    }
    expwork.tab_remember()
    var i: u64 = expbase.tab_n
    while i > expbase.tab_at + 1 {
        ulib.strncpy(expwork.tab_p(i), expwork.tab_p(i - 1), expbase.TAB_WIDTH - 1)
        i = i - 1
    }
    ulib.strncpy(expwork.tab_p(expbase.tab_at + 1), (&expbase.dir_path[0 as usize]) as u64,
        expbase.TAB_WIDTH - 1)
    expbase.tab_n = expbase.tab_n + 1
    expbase.tab_at = expbase.tab_at + 1
    expwork.tab_text_build()
    new_read(tree, tab, stat, fpfad)
}

fn tab_close_do(tree: u64, tab: u64, stat: u64, fpfad: u64) {
    if expbase.tab_n <= 1 {
        var s_letzt: [u8; 23] = "explorer: reiter letzt\0"
        expwork.say((&s_letzt[0 as usize]) as u64)
        expwork.nl()
        return
    }
    var i: u64 = expbase.tab_at
    while i + 1 < expbase.tab_n {
        ulib.strncpy(expwork.tab_p(i), expwork.tab_p(i + 1), expbase.TAB_WIDTH - 1)
        i = i + 1
    }
    expbase.tab_n = expbase.tab_n - 1
    if expbase.tab_at >= expbase.tab_n {
        expbase.tab_at = expbase.tab_n - 1
    }
    ulib.strncpy((&expbase.dir_path[0 as usize]) as u64, expwork.tab_p(expbase.tab_at), 126)
    expwork.tab_text_build()
    new_read(tree, tab, stat, fpfad)
}

fn tab_switch(nr: u64, tree: u64, tab: u64, stat: u64, fpfad: u64) {
    if nr >= expbase.tab_n || nr == expbase.tab_at {
        return
    }
    expwork.tab_remember()
    expbase.tab_at = nr
    ulib.strncpy((&expbase.dir_path[0 as usize]) as u64, expwork.tab_p(expbase.tab_at), 126)
    expwork.tab_text_build()
    expwork.hist_push((&expbase.dir_path[0 as usize]) as u64)
    new_read(tree, tab, stat, fpfad)
}

fn hist_back(tree: u64, tab: u64, stat: u64, fpfad: u64) {
    if folder.step_back((&expbase.dir_path[0 as usize]) as u64, 127) {
        new_read(tree, tab, stat, fpfad)
    }
}

fn hist_forward(tree: u64, tab: u64, stat: u64, fpfad: u64) {
    if folder.step_forward((&expbase.dir_path[0 as usize]) as u64, 127) {
        new_read(tree, tab, stat, fpfad)
    }
}

