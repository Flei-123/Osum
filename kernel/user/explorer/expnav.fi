static mut s_pm: [u8; 1100] = [0 as u8; 1100]

static mut s_rl: [u8; 320] = [0 as u8; 320]

static mut n_stat: usize = 4294967295

static mut t_plus: [u8; 2] = "+\0"

static mut k_tabzu: [u8; 19] = "explorer.tab.close\0"

static mut s_rpt: [u8; 19] = "explorer: rect id=\0"

static mut s_rkind: [u8; 7] = " kind=\0"

