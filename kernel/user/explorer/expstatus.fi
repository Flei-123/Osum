profile app

import fui.navnum
import fuiscene
import libc.octets
import libc.text
import msg
import explorer.expbase
import explorer.expwork

const LINE_MAX: u64 = 90
const SEL_BUF_LEN: u64 = 96
const NUMBER_LEN: usize = 24
const SIZE_OPEN: u64 = 40
const SIZE_CLOSE: u64 = 41
const SPACE: u64 = 32

static mut k_items: [u8; 21] = "explorer.count.items\0"

static mut k_item1: [u8; 21] = "explorer.count.item1\0"

static mut k_drives: [u8; 23] = "explorer.count.drives\0\0"

static mut k_drive1: [u8; 23] = "explorer.count.drive1\0\0"

static mut k_sel_items: [u8; 22] = "explorer.status.items\0"

static mut k_sel_item1: [u8; 22] = "explorer.status.item1\0"

static mut separator: [u8; 4] = " | \0"

static mut sel_buf: [u8; 96] = [0 as u8; 96]

fn line_ptr() -> u64 {
    return (&expbase.lauf[0 as usize]) as u64
}

fn put_text(dst: u64, at: u64, src: u64) -> u64 {
    var pos: u64 = at
    var k: u64 = 0
    while octets.ld8(src, k) != 0 && pos < LINE_MAX {
        octets.st8(dst, pos, octets.ld8(src, k))
        pos = pos + 1
        k = k + 1
    }
    octets.st8(dst, pos, 0)
    return pos
}

fn put_number(dst: u64, at: u64, value: u64) -> u64 {
    var digits: [u8; 24] = [0 as u8; 24]
    let _n: u64 = text.digits(value, (&digits[0 as usize]) as u64, true)
    return put_text(dst, at, (&digits[0 as usize]) as u64)
}

fn put_counted(dst: u64, at: u64, value: u64, one_key: u64, many_key: u64) -> u64 {
    let pos: u64 = put_number(dst, at, value)
    if value == 1 {
        return put_text(dst, pos, msg.get(one_key))
    }
    return put_text(dst, pos, msg.get(many_key))
}

fn build_status() {
    if expbase.vmodus == 4 {
        octets.st8(line_ptr(), 0, 0)
        return
    }
    if expbase.vmodus == 3 {
        let _d: u64 = put_counted(line_ptr(), 0, expbase.entry_count,
            (&k_drive1[0 as usize]) as u64, (&k_drives[0 as usize]) as u64)
        return
    }
    let _n: u64 = put_counted(line_ptr(), 0, expwork.m_count(),
        (&k_item1[0 as usize]) as u64, (&k_items[0 as usize]) as u64)
}

fn selected_bytes(key: u64) -> u64 {
    var bytes: u64 = 0
    var i: u64 = 0
    let n: u64 = expwork.m_count()
    while i < n {
        let e: u64 = expwork.m_ord(i)
        if fuiscene.table_sel_has(key, i) && expwork.m_art(e) == 0 {
            bytes = bytes + expwork.m_size(e)
        }
        i = i + 1
    }
    return bytes
}

fn put_size(dst: u64, at: u64, bytes: u64) -> u64 {
    var size: [u8; 24] = [0 as u8; 24]
    octets.st8(dst, at, SPACE)
    octets.st8(dst, at + 1, SIZE_OPEN)
    let _s: usize = navnum.size_text(bytes, (&size[0 as usize]) as u64, NUMBER_LEN)
    let pos: u64 = put_text(dst, at + 2, (&size[0 as usize]) as u64)
    octets.st8(dst, pos, SIZE_CLOSE)
    octets.st8(dst, pos + 1, 0)
    return pos + 1
}

fn status_selection() {
    let key: u64 = expwork.cur_key()
    let marked: u64 = fuiscene.table_sel_num(key)
    if marked == 0 || expbase.vmodus != 0 {
        expbase.stat_msg = 0
        return
    }
    let dst: u64 = (&sel_buf[0 as usize]) as u64
    var pos: u64 = put_text(dst, 0, line_ptr())
    pos = put_text(dst, pos, (&separator[0 as usize]) as u64)
    pos = put_counted(dst, pos, marked,
        (&k_sel_item1[0 as usize]) as u64, (&k_sel_items[0 as usize]) as u64)
    let bytes: u64 = selected_bytes(key)
    if bytes > 0 {
        let _p: u64 = put_size(dst, pos, bytes)
    }
    expbase.stat_msg = dst
}
