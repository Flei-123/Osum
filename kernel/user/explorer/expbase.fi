// ===== D1: ACTIONS FROM THE ACTION BUS IN THE CONTEXT MENU ============
//
// Every program declares in its ACTIONS manifest which verbs want to be
// in a file's context menu (`menu file|dir|any "label"`, optional
// `menuext img iso`). The file manager asks the broker --
// `list --menu file <name>` -- and shows the answer as a sub menu
// (menu number 14). A pick is `call <action> path=<full path>` through
// the same broker: levels, confirmation, audit log and undo apply as
// for every other caller. Contract for the app: a menu action takes ONE
// string argument named `path`.
static mut bm_names: [u8; 512] = [0 as u8; 512] // 8 x 64: action names

static mut bm_n: u64 = 0

static mut bm_path: [u8; 200] = [0 as u8; 200]

static mut bm_line: [u8; 300] = [0 as u8; 300]

static mut bm_tmp: [u8; 240] = [0 as u8; 240]

