static mut t_title: [u8; 64] = [0 as u8; 64]

static mut t_appdir: [u8; 8] = "/apps\0\0\0"

static mut t_own: [u8; 27] = "/apps/explorer.osp/start\0\0\0"

// Item context menu rows (registry context CTX_EXPLORER_ITEM): catalogue key per row; the action id of a row is its index
// in the old 15-line menu, so `ctx_wahl` is unchanged.
static mut kc_0: [u8; 18] = "explorer.ctx.open\0"

static mut kc_1: [u8; 23] = "explorer.ctx.open_with\0"

static mut kc_2: [u8; 17] = "explorer.ctx.cut\0"

static mut kc_3: [u8; 18] = "explorer.ctx.copy\0"

static mut kc_4: [u8; 19] = "explorer.ctx.paste\0"

static mut kc_5: [u8; 20] = "explorer.ctx.rename\0"

static mut kc_6: [u8; 20] = "explorer.ctx.delete\0"

static mut kc_7: [u8; 25] = "explorer.ctx.delete_perm\0"

static mut kc_8: [u8; 24] = "explorer.ctx.new_folder\0"

static mut kc_9: [u8; 22] = "explorer.ctx.new_file\0"

static mut kc_10: [u8; 18] = "explorer.ctx.pack\0"

static mut kc_11: [u8; 20] = "explorer.ctx.unpack\0"

static mut kc_12: [u8; 21] = "explorer.ctx.network\0"

static mut kc_13: [u8; 24] = "explorer.ctx.properties\0"

static mut kc_14: [u8; 21] = "explorer.ctx.actions\0"

static mut k_mfile: [u8; 19] = "explorer.menu.file\0"

static mut k_mnew: [u8; 18] = "explorer.menu.new\0"

static mut k_msort: [u8; 19] = "explorer.menu.sort\0"

static mut k_mshow: [u8; 19] = "explorer.menu.show\0"

static mut k_newdir: [u8; 19] = "explorer.newfolder\0"

// ROUND NETVIEW: the four views, and they keep their English names here
// because they are the names `/bin/netview` takes and the names `ps`
// prints. A word that means the same thing must not have two spellings.
static mut t_views: [u8; 25] = "real\nfiltered\nfaked\nnone\0"

static mut k_t_pop: [u8; 24] = "explorer.context.backup\0"

static mut k_t_popd: [u8; 24] = "explorer.context.drive\0\0"

static mut k_t_popb: [u8; 25] = "explorer.context.restore\0"

static mut k_t_popg: [u8; 20] = "explorer.context.bg\0"

static mut s_cbg: [u8; 19] = "explorer: ctxbg n=\0"

static mut dlg_gemeldet: bool = false

static mut noti_stand: u64 = 0xFFFFFFFFFFFFFFFF

static mut rs_seen: u64 = 0

static mut s_lz1: [u8; 2] = " \0"

// ================================== RUNDE EXPLORER-2: DIE KUERZEL
const T_STRG_A: u64 = 1

const T_STRG_C: u64 = 3

const T_STRG_F: u64 = 6

const T_STRG_L: u64 = 12

const T_STRG_V: u64 = 22

const T_STRG_X: u64 = 24

const T_STRG_Z: u64 = 26

const T_STRG_T: u64 = 20

const T_STRG_W: u64 = 23

static mut k_medit: [u8; 19] = "explorer.menu.edit\0"

static mut k_mgo: [u8; 17] = "explorer.menu.go\0"

// ====================================== DER TASTENBLOCK (Punkt 7)
fn key_block(key_code: u64, tree: u64, tab: u64, stat: u64,
    fpfad: u64) -> u64 {
    var s_t: [u8; 15] = "explorer: key \0"
    var s_n: [u8; 3] = "n=\0"
    var s_rc: [u8; 4] = "rc=\0"
    var s_art: [u8; 5] = "art=\0"
    var s_an: [u8; 4] = "an=\0"
    if key_code == T_STRG_C || key_code == T_STRG_X {
        let n: u64 = expwork.select_list(tab)
        var schnitt: bool = false
        if key_code == T_STRG_X {
            schnitt = true
        }
        let rc: u64 = expakt.copy_remember(schnitt)
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.say((&s_lz1[0 as usize]) as u64)
        expwork.kv((&s_n[0 as usize]) as u64, n)
        expwork.kv((&s_rc[0 as usize]) as u64, rc)
        expwork.nl()
        let _f: bool = expwork.error_show(rc)
        return 0
    }
    if key_code == T_STRG_V {
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.say((&s_lz1[0 as usize]) as u64)
        expwork.kv((&s_n[0 as usize]) as u64, expakt.clipboard_num())
        expwork.nl()
        return expnav.paste_do(tab, tree, tab, stat, fpfad, true)
    }
    if key_code == T_STRG_A {
        fuiscene.table_sel_all(expwork.cur_key())
        expwork.rfr()
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.say((&s_lz1[0 as usize]) as u64)
        expwork.kv((&s_n[0 as usize]) as u64, fuiscene.table_sel_num(expwork.cur_key()))
        expwork.nl()
        return 0
    }
    if key_code == T_STRG_Z {
        let undo_kind: u64 = expakt.undo_art()
        let rc: u64 = expakt.undo_last()
        expnav.new_read(tree, tab, stat, fpfad)
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.say((&s_lz1[0 as usize]) as u64)
        expwork.kv((&s_art[0 as usize]) as u64, undo_kind)
        expwork.kv((&s_rc[0 as usize]) as u64, rc)
        expwork.nl()
        let _f: bool = expwork.error_show(rc)
        return 0
    }
    if key_code == hostkey.KEY_F2 {
        let z: u64 = expwork.cur_row()
        if z >= expwork.m_count() {
            return 0
        }
        ulib.strncpy((&expbase.dlgpuffer[0 as usize]) as u64, expwork.m_name(expwork.m_ord(z)), 120)
        let _d: u64 = expwork.dlg_entry(msg.get((&expbase.k_rename[0 as usize]) as u64),
            msg.get((&expbase.k_name[0 as usize]) as u64),
            (&expbase.dlgpuffer[0 as usize]) as u64)
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.say(expwork.m_name(expwork.m_ord(z)))
        expwork.nl()
        return 1
    }
    if key_code == hostkey.KEY_OLD_ENTER {
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.nl()
        return expnav.props_show(tab, tab) << 8
    }
    if key_code == hostkey.KEY_F5 {
        expnav.places_show()
        expnav.new_read(tree, tab, stat, fpfad)
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.nl()
        return 0
    }
    if key_code == hostkey.KEY_OLD_UP || key_code == hostkey.KEY_BS {
        expwork.eltern((&expbase.dir_path[0 as usize]) as u64)
        expwork.hist_push((&expbase.dir_path[0 as usize]) as u64)
        expnav.new_read(tree, tab, stat, fpfad)
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.say((&s_lz1[0 as usize]) as u64)
        expwork.say((&expbase.dir_path[0 as usize]) as u64)
        expwork.nl()
        return 0
    }
    if key_code == hostkey.KEY_OLD_LEFT {
        expnav.hist_back(tree, tab, stat, fpfad)
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.say((&s_lz1[0 as usize]) as u64)
        expwork.kv((&s_n[0 as usize]) as u64, folder.position() + 1)
        expwork.nl()
        return 0
    }
    if key_code == hostkey.KEY_OLD_RIGHT {
        expnav.hist_forward(tree, tab, stat, fpfad)
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.say((&s_lz1[0 as usize]) as u64)
        expwork.kv((&s_n[0 as usize]) as u64, folder.position() + 1)
        expwork.nl()
        return 0
    }
    if key_code == hostkey.KEY_CTRL_H {
        expmodell.set_hidden(!expmodell.versteckt())
        expnav.new_read(tree, tab, stat, fpfad)
        var an: u64 = 0
        if expmodell.versteckt() {
            an = 1
        }
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.say((&s_lz1[0 as usize]) as u64)
        expwork.kv((&s_an[0 as usize]) as u64, an)
        expwork.nl()
        return 0
    }
    if key_code == T_STRG_F {
        // r442: Ctrl+F goes to the search field of the address row (it filters while typing)
        fuiscene.focus(expbase.K_SEARCH)
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.nl()
        return 0
    }
    if key_code == hostkey.KEY_CTRL_N {
        expwork.window_open()
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.nl()
        return 0
    }
    if key_code == hostkey.KEY_CTRL_SHIFT_N {
        let _d: u64 = expwork.dlg_entry(msg.get((&k_newdir[0 as usize]) as u64),
            msg.get((&expbase.k_name[0 as usize]) as u64), 0)
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.nl()
        return 2
    }
    if key_code == hostkey.KEY_DEL || key_code == hostkey.KEY_SDEL {
        let n: u64 = expwork.select_list(tab)
        if n == 0 {
            return 0
        }
        let wait: u64 = expwork.delete_ask(tab, key_code == hostkey.KEY_SDEL)
        expwork.say((&s_t[0 as usize]) as u64)
        expwork.sayn(key_code)
        expwork.say((&s_lz1[0 as usize]) as u64)
        expwork.kv((&s_n[0 as usize]) as u64, n)
        expwork.nl()
        return wait
    }
    return 0
}

// ======================================================= RUNDE CLIP-2
fn ablegen(line: u64, tree: u64, tab: u64, stat: u64, fpfad: u64) -> u64 {
    var s_dr: [u8; 13] = "expl: drop \0\0"
    var s_z: [u8; 3] = "z=\0"
    var s_rc: [u8; 4] = "rc=\0"
    var s_q: [u8; 4] = " q=\0"
    if expbase.vmodus != 0 {
        return 0
    }
    var zp: [u8; 200] = [0 as u8; 200]
    if !ulib.drag_an() {
        return 0
    }
    if ulib.drag_type_path() == 0 {
        return 0
    }
    let zn: u64 = ulib.drag_take((&zp[0 as usize]) as u64, 198)
    if zn == 0 {
        return 0
    }
    zp[(zn) as usize] = 0 as u8
    var target: [u8; 200] = [0 as u8; 200]
    ulib.strncpy((&target[0 as usize]) as u64, (&expbase.dir_path[0 as usize]) as u64,
        198)
    if line < expwork.m_count() {
        let e: u64 = expwork.m_ord(line)
        if expwork.m_art(e) != 0 {
            ulib.strncpy((&target[0 as usize]) as u64,
                expwork.join((&expbase.dir_path[0 as usize]) as u64, expwork.m_name(e)), 198)
        }
    }
    var qdir: [u8; 200] = [0 as u8; 200]
    ulib.strncpy((&qdir[0 as usize]) as u64, (&zp[0 as usize]) as u64, 198)
    expwork.eltern((&qdir[0 as usize]) as u64)
    expwork.say((&s_dr[0 as usize]) as u64)
    expwork.say((&zp[0 as usize]) as u64)
    expwork.say((&s_q[0 as usize]) as u64)
    expwork.say((&target[0 as usize]) as u64)
    if ulib.streq((&qdir[0 as usize]) as u64, (&target[0 as usize]) as u64) {
        var s_gl: [u8; 6] = " same\0"
        expwork.say((&s_gl[0 as usize]) as u64)
        expwork.nl()
        let _c: u64 = ulib.drag_drop()
        return 0
    }
    drag_list((&zp[0 as usize]) as u64)
    expwork.nl()
    expakt.stage(true)
    expbase.kfl_op = 1
    let rc: u64 = expakt.paste((&target[0 as usize]) as u64)
    var s_de: [u8; 13] = "expl: drop* \0"
    expwork.say((&s_de[0 as usize]) as u64)
    expwork.kv((&s_rc[0 as usize]) as u64, rc)
    expwork.kv((&s_z[0 as usize]) as u64, line)
    expwork.nl()
    let _c2: u64 = ulib.drag_drop()
    expnav.new_read(tree, tab, stat, fpfad)
    if expnav.conflict_show(tab) {
        return 9
    }
    let _f: bool = expwork.error_show(rc)
    return 0
}

// ====================================================== RUNDE ALLTAG
fn ablegen_ort(ort: u64, tree: u64, tab: u64, stat: u64, fpfad: u64) -> u64 {
    if expbase.vmodus != 0 {
        return 0
    }
    if ort >= exporte.places_num() {
        return 0
    }
    if !exporte.place_droppable(ort) {
        var s_no: [u8; 20] = "expl: ort nimmt nix\0"
        expwork.say((&s_no[0 as usize]) as u64)
        expwork.nl()
        return 0
    }
    var zp: [u8; 200] = [0 as u8; 200]
    if !ulib.drag_an() {
        return 0
    }
    if ulib.drag_type_path() == 0 {
        return 0
    }
    let zn: u64 = ulib.drag_take((&zp[0 as usize]) as u64, 198)
    if zn == 0 {
        return 0
    }
    zp[(zn) as usize] = 0 as u8
    var s_do: [u8; 15] = "expl: droport \0"
    expwork.say((&s_do[0 as usize]) as u64)
    expwork.say((&zp[0 as usize]) as u64)
    // ------------------------------------------------- der Papierkorb
    if exporte.place_is_trash(ort) {
        var s_tr: [u8; 9] = " -> korb\0"
        expwork.say((&s_tr[0 as usize]) as u64)
        expwork.nl()
        let rc: u64 = drag_basket((&zp[0 as usize]) as u64)
        let _c: u64 = ulib.drag_drop()
        expnav.new_read(tree, tab, stat, fpfad)
        let _f: bool = expwork.error_show(rc)
        return 0
    }
    // ------------------------------------------------- jeder andere Ort
    var target: [u8; 200] = [0 as u8; 200]
    ulib.strncpy((&target[0 as usize]) as u64, exporte.place_path(ort), 198)
    var s_pf: [u8; 5] = " -> \0"
    expwork.say((&s_pf[0 as usize]) as u64)
    expwork.say((&target[0 as usize]) as u64)
    expwork.nl()
    return drop_path((&zp[0 as usize]) as u64, (&target[0 as usize]) as u64,
        tree, tab, stat, fpfad)
}

fn drop_path(source: u64, target: u64, tree: u64, tab: u64, stat: u64,
    fpfad: u64) -> u64 {
    var qdir: [u8; 200] = [0 as u8; 200]
    ulib.strncpy((&qdir[0 as usize]) as u64, source, 198)
    expwork.eltern((&qdir[0 as usize]) as u64)
    if ulib.streq((&qdir[0 as usize]) as u64, target) {
        var s_gl: [u8; 17] = "expl: place same\0"
        expwork.say((&s_gl[0 as usize]) as u64)
        expwork.nl()
        let _c: u64 = ulib.drag_drop()
        return 0
    }
    drag_list(source)
    expakt.stage(true)
    expbase.kfl_op = 1
    let rc: u64 = expakt.paste(target)
    var s_de: [u8; 18] = "expl: droport rc=\0"
    expwork.say((&s_de[0 as usize]) as u64)
    expwork.sayn(rc)
    expwork.nl()
    let _c2: u64 = ulib.drag_drop()
    expnav.new_read(tree, tab, stat, fpfad)
    if expnav.conflict_show(tab) {
        return 9
    }
    let _f: bool = expwork.error_show(rc)
    return 0
}

// ================================ RUNDE EXPLORER-2: DIE MENUEPUNKTE
fn menu_choice(welches: u64, idx: u64, tab: u64, tree: u64, stat: u64,
    fpfad: u64) -> u64 {
    if welches == 1 {
        return ctx_choice(idx, tab, tree, stat, fpfad)
    }
    if welches == 19 {
        // explorer.context.bg (right click on the empty part of the list): the same actions as the menus,
        // 0 New folder, 1 New file, 2 Paste, 3 Select all, 4 Refresh, 5 List, 6 Icons, 7 Large icons
        if idx == 0 { return menu_choice(2, 0, tab, tree, stat, fpfad) }
        if idx == 1 { return menu_choice(2, 1, tab, tree, stat, fpfad) }
        if idx == 2 { return menu_choice(6, 2, tab, tree, stat, fpfad) }
        if idx == 3 { return menu_choice(6, 3, tab, tree, stat, fpfad) }
        if idx == 4 { return menu_choice(2, 4, tab, tree, stat, fpfad) }
        if idx == 5 { return menu_choice(3, 0, tab, tree, stat, fpfad) }
        if idx == 6 { return menu_choice(3, 1, tab, tree, stat, fpfad) }
        return menu_choice(3, 10, tab, tree, stat, fpfad)
    }
    if welches == 2 {
        if idx == 0 {
            let _d: u64 = expwork.dlg_entry(
                msg.get((&k_newdir[0 as usize]) as u64),
                msg.get((&expbase.k_name[0 as usize]) as u64), 0)
            return 2
        }
        if idx == 1 {
            return expwork.new_file_ask()
        }
        if idx == 2 {
            return expnav.openwith_show(tab) << 8
        }
        if idx == 3 {
            return expnav.props_show(tab, tab) << 8
        }
        if idx == 4 {
            expnav.new_read(tree, tab, stat, fpfad)
            return 0
        }
        if idx == 5 {
            fuiscene.quit()
        }
        return 0
    }
    if welches == 3 {
        if idx >= 8 && idx <= 10 {
            expnav.view_size_set(idx - 8)
            return 0
        }
        if idx == 0 || idx == 1 {
            expnav.view_set(idx, tab, tree, stat, fpfad)
            return 0
        }
        if idx >= 2 && idx <= 5 {
            expbase.sortby = idx - 2
            expbase.sortrev = 0
        } else if idx == 6 {
            expbase.sortrev = 1 - expbase.sortrev
        } else if idx == 7 {
            expmodell.set_hidden(!expmodell.versteckt())
            expnav.new_read(tree, tab, stat, fpfad)
            return 0
        }
        expwork.say_sorting()
        expnav.view_refresh(tree, tab)
        return 0
    }
    if welches == 15 {
        // explorer.menu.new: 0 Folder, 1 File
        if idx == 0 {
            return menu_choice(2, 0, tab, tree, stat, fpfad)
        }
        return menu_choice(2, 1, tab, tree, stat, fpfad)
    }
    if welches == 17 {
        // explorer.menu.sort: 0 Name, 1 Size, 2 Time, 3 Type, 4 Reversed
        if idx == 4 {
            expbase.sortrev = 1 - expbase.sortrev
        } else {
            var sk: u64 = idx
            if idx == 3 {
                sk = 4
            }
            if expbase.sortby != sk {
                expbase.sortrev = 0
            }
            expbase.sortby = sk
        }
        expwork.say_sorting()
        expnav.view_refresh(tree, tab)
        return 0
    }
    if welches == 18 {
        // explorer.menu.show: 0 List, 1 Icons, 2 Preview pane, 3 Hidden files
        if idx == 0 || idx == 1 {
            return menu_choice(3, idx, tab, tree, stat, fpfad)
        }
        if idx == 3 {
            return menu_choice(3, 7, tab, tree, stat, fpfad)
        }
        if idx >= 4 && idx <= 6 {
            expnav.view_size_set(idx - 4)
            return 0
        }
        return expnav.preview_toggle(tree, tab, stat, fpfad)
    }
    if welches == 14 {
        // D1: the actions of other programs (bus), see actions_menu
        return expwork.actions_run(idx)
    }
    if welches == 13 {
        // explorer.context.drive: 0 Open, 1 Eject, 2 Disk management
        if idx == 0 {
            expnav.nav_click(tree, tab, stat, fpfad)
        } else if idx == 1 {
            expnav.eject_click(tree, tab, stat, fpfad)
        } else if idx == 2 {
            var dprog2: [u8; 12] = "/bin/disks\0\0"
            let dpid2: u64 = ulib.sys(ulib.SYS_EXEC, (&dprog2[0 as usize]) as u64, 0, 0)
            expwork.say((&expbase.s_dmgmt[0 as usize]) as u64)
            expwork.sayn(dpid2)
            expwork.nl()
        }
        return 0
    }
    if welches == 4 {
        // explorer.context.restore: 0 Oeffnen, 1 Zurueckholen.
        if idx == 0 {
            expnav.open(expwork.cur_row(), tree, tab, stat, fpfad,
                msg.get((&expbase.k_t_bak[0 as usize]) as u64))
            return 0
        }
        expwork.zurueckholen(tree, tab, stat, fpfad)
        return 0
    }
    if welches == 5 {
        expwork.netview_starten(idx, tab)
        return 0
    }
    if welches == 6 {
        // explorer.menu.edit: 0 Ausschneiden, 1 Kopieren, 2 Einfuegen,
        // 3 Alles auswaehlen, 4 Rueckgaengig.
        if idx == 0 || idx == 1 {
            return expwork.clipboard_do(tab, idx == 0)
        }
        if idx == 2 {
            return expnav.paste_do(tab, tree, tab, stat, fpfad, true)
        }
        if idx == 3 {
            fuiscene.table_sel_all(expwork.cur_key())
            expwork.rfr()
            expnav.say_selection(tab)
            return 0
        }
        return expnav.undo_do(tree, tab, stat, fpfad)
    }
    if welches == 7 {
        // explorer.menu.go: 0 Zurueck, 1 Vorwaerts, 2 Hinauf,
        // 3 Zuhause, 4 Papierkorb.
        return expnav.goto_to(idx, tree, tab, stat, fpfad)
    }
    if welches == 10 {
        let z: u64 = expwork.cur_row()
        if z < expwork.m_count() {
            let rc: u64 = expdlg.openwith_start(idx, expwork.full_from(z))
            if ulib.bad(rc) {
                let _f: bool = expwork.error_show(rc)
            }
        }
        return 0
    }
    if welches == 11 {
        // explorer.context.backup: 0 Oeffnen, 1 Umbenennen, 2 Loeschen,
        // 3 Neuer Ordner, 4 Backup hierhin sichern.
        if idx == 0 {
            expnav.tree_walk(expwork.tree_row(), tree, tab, stat, fpfad)
            return 0
        }
        if idx == 1 {
            return expwork.rename_ask(tab)
        }
        if idx == 2 {
            return expwork.delete_ask(tab, false)
        }
        if idx == 3 {
            let _d: u64 = expwork.dlg_entry(
                msg.get((&k_newdir[0 as usize]) as u64),
                msg.get((&expbase.k_name[0 as usize]) as u64), 0)
            return 2
        }
        return expnav.save_ask(tab, tree, stat, fpfad)
    }
    return 0
}

fn ctx_choice(idx: u64, tab: u64, tree: u64, stat: u64, fpfad: u64) -> u64 {
    if idx == 0 { // Oeffnen
        var empty: [u8; 4] = "\0\0\0\0"
        expnav.open(expwork.cur_row(), tree, tab, stat, fpfad,
            (&empty[0 as usize]) as u64)
        return 0
    }
    if idx == 1 { // Oeffnen mit
        return expnav.openwith_show(tab) << 8
    }
    if idx == 2 || idx == 3 { // Ausschneiden, Kopieren
        return expwork.clipboard_do(tab, idx == 2)
    }
    if idx == 4 { // Einfuegen
        return expnav.paste_do(tab, tree, tab, stat, fpfad, true)
    }
    if idx == 5 { // Umbenennen
        return expwork.rename_ask(tab)
    }
    if idx == 6 {
        return expwork.delete_ask(tab, false)
    }
    if idx == 7 { // Endgueltig loeschen
        return expwork.delete_ask(tab, true)
    }
    if idx == 8 { // Neuer Ordner
        let _d: u64 = expwork.dlg_entry(msg.get((&k_newdir[0 as usize]) as u64),
            msg.get((&expbase.k_name[0 as usize]) as u64), 0)
        return 2
    }
    if idx == 9 { // Neue Datei
        return expwork.new_file_ask()
    }
    if idx == 10 || idx == 11 { // Packen (ZIP), Entpacken
        let z: u64 = expwork.cur_row()
        if z < expwork.m_count() {
            expnav.zip_starten(expwork.full_from(z), idx == 10, tree, tab, stat, fpfad)
        }
        return 0
    }
    if idx == 12 {
        let _m: u64 = expnav.popup_at(fuiscene.menu_x(), fuiscene.menu_y(),
            (&t_views[0 as usize]) as u64)
        return 5 << 8
    }
    if idx == 13 { // Eigenschaften
        return expnav.props_show(tab, tab) << 8
    }
    if idx == 14 { // D1: actions of other programs, asked from the bus
        return expnav.actions_menu() << 8
    }
    return 0
}

fn vollziehen(was: u64, tab: u64, tree: u64, stat: u64,
    fpfad: u64) -> u64 {
    var danach: u64 = 0
    if was == 0 {
        return 0
    }
    var rc: u64 = 0
    var getan: u64 = 0
    if was == expsmb.WAIT_USER || was == expsmb.WAIT_PASS {
        let next: u64 = expsmb.on_confirm(was)
        if next != 0 {
            return next
        }
        expnav.new_read(tree, tab, stat, fpfad)
        return expbase.s_wartet
    }
    if was == 4 {
        expnav.save((&expbase.pziel[0 as usize]) as u64, tree, tab, stat, fpfad)
        return 0
    }
    if was == 9 {
        return expnav.conflict_reply(s_pick, tab, tree, tab, stat,
            fpfad)
    }
    if was == 2 {
        let full: u64 = expwork.join((&expbase.dir_path[0 as usize]) as u64, fuiscene.dialog_entry_text())
        rc = io.make_dir(full)
        if ulib.bad(rc) {
            getan = 0
        } else {
            rc = 0
            getan = 1
        }
    } else if was == 7 {
        let full: u64 = expwork.join((&expbase.dir_path[0 as usize]) as u64, fuiscene.dialog_entry_text())
        rc = expdlg.new_file(full, 0)
        if rc == 0 {
            getan = 1
        }
    } else if was == 6 {
        ulib.strncpy((&expbase.fbuf[0 as usize]) as u64, fuiscene.dialog_entry_text(), 60)
        if (expbase.fbuf[(0) as usize]) == 0 as u8 {
            expmodell.set_filter(0)
        } else {
            expmodell.set_filter((&expbase.fbuf[0 as usize]) as u64)
        }
    } else if was == 3 || was == 5 {
        var i: u64 = 0
        while i < expakt.list_num() {
            var r2: u64 = 0
            if was == 3 {
                r2 = expakt.in_trash(expakt.list_at(i))
            } else {
                r2 = expakt.endgueltig(expakt.list_at(i))
            }
            if r2 != 0 {
                rc = r2
            } else {
                getan = getan + 1
            }
            i = i + 1
        }
    } else if was == 13 {
        // D3: the rule was typed -> plan it; a conflict is an error window, a good plan asks once
        // with the first changes before anything is renamed.
        rc = expakt.mass_prepare(fuiscene.dialog_entry_text())
        if rc == 0 {
            let _p: u64 = expwork.dlg_ask(msg.get((&expbase.k_rename[0 as usize]) as u64), expakt.mass_preview())
            danach = 14
        }
    } else if was == 14 {
        rc = expakt.mass_apply()
        if rc == 0 {
            getan = expakt.mass_count()
        }
    } else if was == 1 {
        let z: u64 = expwork.first_select(tab)
        if z < expwork.m_count() {
            danach = expnav.rename_do(tab, expwork.full_from(z), fuiscene.dialog_entry_text(),
                tree, tab, stat, fpfad)
            rc = expakt.last_rc()
            if rc == 0 {
                getan = 1
            }
        }
    }
    expwork.say_tat(was, getan, rc)
    expnav.new_read(tree, tab, stat, fpfad)
    if rc != 0 && danach == 0 {
        let _f: bool = expwork.error_show(rc)
    }
    return danach
}

const K_STAT: u64 = 15

const BW0: u64 = 860

const BH0: u64 = 580

const NONE_ROW: u64 = 4294967295

static mut s_open: u64 = 0

static mut s_pick: u64 = 0

static mut s_multidrag: bool = false

static mut t_nm: [u8; 9] = "explorer\0"

static mut s_bad2: [u8; 24] = "explorer: no surface\0\0\0\0"

static mut s_fui: [u8; 18] = "explorer: fui ok=\0"

static mut s_fuin: [u8; 5] = " no=\0"

static mut s_geo2: [u8; 16] = "explorer: geom \0"

static mut s_gx: [u8; 3] = "x=\0"

static mut s_gy: [u8; 3] = "y=\0"

static mut s_gw: [u8; 3] = "w=\0"

static mut s_gh: [u8; 3] = "h=\0"

static mut s_go2: [u8; 16] = "explorer: ready\0"

static mut s_dc: [u8; 17] = "explorer: drops \0"

static mut s_title: [u8; 17] = "explorer: name [\0"

static mut s_zu: [u8; 8] = "] aus [\0"

static mut s_end: [u8; 2] = "]\0"

static mut s_start: [u8; 17] = "explorer: start \0"

static mut pv_row_seen: u64 = 4294967295

static mut s_nostrip: [u8; 25] = "explorer: no title strip\0"

// ------------------------------------------------------------ the events

// r442: the header columns are Name, Date modified, Type, Size; the sort keys of the model are
// 0 name, 1 size, 2 time, 3 rights, 4 type.
fn header_key(col: u64) -> u64 {
    if col == 1 {
        return 2
    }
    if col == 2 {
        return 4
    }
    if col == 3 {
        return 1
    }
    return 0
}

fn sort_header(col0: u64, tree: u64, tab: u64) {
    let col: u64 = header_key(col0)
    if expbase.sortby == col {
        expbase.sortrev = 1 - expbase.sortrev
    } else {
        expbase.sortby = col
        expbase.sortrev = 0
    }
    expnav.view_refresh(tree, tab)
    expwork.say(((&s_op[0 as usize]) as u64))
    expwork.kv(((&s_rows_w[0 as usize]) as u64), expbase.sortby)
    expwork.kv(((&s_rows_hh[0 as usize]) as u64), expbase.sortrev)
    expwork.nl()
    expwork.say_sorting()
}

static mut s_colres: [u8; 21] = "explorer: colresize \0"

static mut s_colres_a: [u8; 3] = "a=\0"

static mut s_colres_b: [u8; 3] = "b=\0"

static mut s_colres_c: [u8; 3] = "c=\0"

static mut s_colres_d: [u8; 3] = "d=\0"

static mut s_op: [u8; 14] = "explorer: op \0"

static mut s_rows_w: [u8; 3] = "w=\0"

static mut s_rows_hh: [u8; 3] = "h=\0"

static mut s_cxreg: [u8; 20] = "explorer: ctxreg n=\0"

static mut s_cxext: [u8; 25] = "explorer: ctx ext start \0"

static mut cx_done: u64 = 0

// The rows of the item context menu come from the registry (kernel/user/ctxreg.fi): the 15 built-in rows (action id = row
// number of the old fixed menu) plus every `explorer|label|program` line of /etc/ctxmenu.conf.
fn ctx_item_rows() -> u64 {
    if cx_done == 0 {
        cx_done = 1
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_0[0 as usize]) as u64, 0, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_1[0 as usize]) as u64, 1, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_2[0 as usize]) as u64, 2, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_3[0 as usize]) as u64, 3, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_4[0 as usize]) as u64, 4, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_5[0 as usize]) as u64, 5, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_6[0 as usize]) as u64, 6, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_7[0 as usize]) as u64, 7, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_8[0 as usize]) as u64, 8, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_9[0 as usize]) as u64, 9, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_10[0 as usize]) as u64, 10, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_11[0 as usize]) as u64, 11, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_12[0 as usize]) as u64, 12, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_13[0 as usize]) as u64, 13, 0)
    ctxreg.add(ctxreg.CTX_EXPLORER_ITEM, (&kc_14[0 as usize]) as u64, 14, 0)
    }
    return ctxreg.build(ctxreg.CTX_EXPLORER_ITEM, 0)
}

// A pick in the item menu: the registry maps the row to an action id. Manifest entries start their program here
// (returns true); a built-in action id goes on to `ctx_wahl` (returns false, `act` is the id).
fn ctx_item_ext(pick0: u64) -> bool {
    let act: u64 = ctxreg.act_at(pick0)
    if ctxreg.is_ext(act) {
        expwork.say((&s_cxext[0 as usize]) as u64)
        expwork.sayn(act)
        expwork.nl()
        let _p: u64 = ctxreg.run_ext(act)
        return true
    }
    return false
}

fn rechtsklick() {
    let rx: u64 = fuiscene.right_x()
    let ry: u64 = fuiscene.right_y()
    let ck: u64 = fuiscene.key_at(rx, ry)
    if ck == expbase.K_TAB || ck == expbase.K_SYM {
        let row: u64 = fuiscene.table_row_at(ck, rx, ry)
        if row != fuiscene.HEAD_ROW {
            // the row under the pointer is the object, unless it already
            // belongs to the marked ones
            if !fuiscene.table_sel_has(ck, row) {
                fuiscene.table_sel_none(ck)
                fuiscene.table_sel_set(ck, row, true)
            }
            fuiscene.table_set_sel(ck, row)
        }
        if expbase.vmodus == 0 && fuiscene.table_below_rows(ck, rx, ry) {
            // the empty part of the list: a menu for the folder itself
            let _nb: u64 = expnav.popup_at(rx, ry, msg.get(((&k_t_popg[0 as usize]) as u64)))
            s_open = 19
            expwork.say(((&s_cbg[0 as usize]) as u64))
            expwork.sayn(_nb)
            expwork.nl()
        } else if expbase.vmodus != 0 {
            let _n: u64 = expnav.popup_at(rx, ry, msg.get(((&k_t_popb[0 as usize]) as u64)))
            s_open = 4
        } else {
            let nr: u64 = ctx_item_rows()
            let _n: u64 = expnav.popup_at(rx, ry, ctxreg.text())
            expwork.say((&s_cxreg[0 as usize]) as u64)
            expwork.sayn(nr)
            expwork.nl()
            s_open = 1
        }
    } else if ck == expbase.K_PLACES {
        // r450: a right click on a place of the navigation pane: open it, eject it (a drive), or open the disk manager
        let nrow: u64 = fuiscene.table_row_at(ck, rx, ry)
        if nrow != fuiscene.HEAD_ROW && nrow < expbase.nav_n && expbase.nav_refs[(nrow) as usize] < expbase.NAV_UP {
            let pl: u64 = expbase.nav_refs[(nrow) as usize]
            if !exporte.place_is_header(pl) && !exporte.place_is_tool(pl) {
                expbase.place_choice = pl
                fuiscene.table_set_sel(ck, nrow)
                let _n3: u64 = expnav.popup_at(rx, ry, msg.get(((&k_t_popd[0 as usize]) as u64)))
                s_open = 13
            }
        }
    } else if ck == expbase.K_TREE {
        let row2: u64 = fuiscene.table_row_at(ck, rx, ry)
        if row2 != fuiscene.HEAD_ROW {
            fuiscene.table_set_sel(ck, row2)
        }
        let _n2: u64 = expnav.popup_at(rx, ry, msg.get(((&k_t_pop[0 as usize]) as u64)))
        s_open = 11
    }
}

// A drag begins on a row: the path goes on the drag place, a label hangs at
// the pointer.
fn ziehen_los() {
    let row: u64 = fuiscene.drag_row()
    if expbase.vmodus != 0 || row >= expwork.m_count() {
        return
    }
    // dragging one of several marked rows takes all of them
    s_multidrag = false
    if fuiscene.table_sel_num(expwork.cur_key()) > 1 && fuiscene.table_sel_has(expwork.cur_key(), row) {
        s_multidrag = true
    }
    expwork.ziehen(row)
    expwork.drag_target_on(row, K_STAT)
    fuiscene.drag_shield(expwork.m_name(expwork.m_ord(row)))
}

// Something came down on the window.
fn abgelegt(tree: u64, tab: u64, stat: u64, fpfad: u64) {
    let dk: u64 = fuiscene.drop_key()
    let dr: u64 = fuiscene.drop_row()
    let dx: u64 = fuiscene.drop_x()
    let dy: u64 = fuiscene.drop_y()
    var s_drop: [u8; 20] = "expl: dropziel id=\0\0"
    var s_dr2: [u8; 4] = " r=\0"
    expwork.say((&s_drop[0 as usize]) as u64)
    expwork.sayn(dk)
    expwork.say((&s_dr2[0 as usize]) as u64)
    expwork.sayn(dr)
    expwork.nl()
    // a drop on the bar of tabs switches to that tab
    var onbar: bool = false
    if expbase.n_rrow != fuiscene.NONE {
        if dx >= fuiscene.node_x(expbase.n_rrow) && dx < fuiscene.node_x(expbase.n_rrow) + fuiscene.node_w(expbase.n_rrow)
            && dy >= fuiscene.node_y(expbase.n_rrow)
            && dy < fuiscene.node_y(expbase.n_rrow) + fuiscene.node_h(expbase.n_rrow) {
            onbar = true
        }
    }
    if onbar {
        expnav.tab_switch(expnav.tab_below(dx, dy), tree, tab, stat, fpfad)
    } else if dk == expbase.K_PLACES {
        expbase.s_wartet = ablegen_ort(dr, tree, tab, stat, fpfad)
        expwork.drag_target_off()
    } else if dk == expbase.K_TAB || dk == expbase.K_SYM {
        expbase.s_wartet = ablegen(dr, tree, tab, stat, fpfad)
        expwork.drag_target_off()
    } else if dk == expbase.K_TREE {
        expbase.s_wartet = ablegen(NONE_ROW, tree, tab, stat, fpfad)
        expwork.drag_target_off()
    } else {
        expwork.drag_target_off()
    }
    s_multidrag = false
}

// One activated node. `key` is what `pump` answered.
fn behandeln(key: u64) {
    let tree: u64 = expbase.K_TREE
    let tab: u64 = expbase.K_TAB
    let stat: u64 = K_STAT
    let fpfad: u64 = expbase.K_PATH
    if key == fuiscene.KEY_DIALOG {
        let res: u64 = fuiscene.dialog_result()
        let esc: bool = fuiscene.dialog_cancelled()
        let was: u64 = expbase.s_wartet
        expbase.s_wartet = 0
        dlg_gemeldet = false
        var bestaetigt: bool = false
        if was == 9 {
            if !esc && res >= 1 {
                s_pick = res - 1
                bestaetigt = true
            }
        } else if res == 1 {
            bestaetigt = true
        }
        if bestaetigt {
            expbase.s_wartet = vollziehen(was, tab, tree, stat, fpfad)
        }
        expwork.rfr()
        return
    }
    if key == fuiscene.KEY_POPUP {
        let pick: u64 = fuiscene.menu_pick()
        if s_open == 12 {
            // the overflow menu of the command bar: the picked line runs the same action as its button
            s_open = 0
            if pick >= 1 {
                let hk: u64 = fuiscene.cmd_hidden_key(pick - 1)
                if hk != 0 {
                    behandeln(hk)
                }
            }
            return
        }
        if pick >= 1 && s_open == 1 && ctx_item_ext(pick - 1) {
            s_open = 0
            return
        }
        if pick >= 1 {
            let mr: u64 = menu_choice(s_open, pick - 1, tab, tree, stat, fpfad)
            expbase.s_wartet = mr & 255
            s_open = mr >> 8
        } else {
            s_open = 0
        }
        return
    }
    if key == fuiscene.KEY_RCLICK {
        if expbase.vmodus == 0 || expbase.vmodus == 1 || expbase.vmodus == 2 {
            rechtsklick()
        }
        return
    }
    if key == fuiscene.KEY_DRAG {
        if expbase.vmodus == 0 {
            ziehen_los()
        }
        return
    }
    if key == fuiscene.KEY_DROP {
        abgelegt(tree, tab, stat, fpfad)
        return
    }
    if key == expbase.K_OVF {
        let on: usize = fuiscene.node_of_key(key)
        var ox: u64 = 8
        var oy: u64 = 40
        if on != fuiscene.NONE {
            ox = fuiscene.node_x(on)
            oy = fuiscene.node_y(on) + fuiscene.node_h(on)
        }
        let _no: u64 = expnav.popup_at(ox, oy, fuiscene.cmd_hidden_labels())
        s_open = 12
        return
    }
    if key >= expbase.K_MB && key < expbase.K_MB + 4 {
        var m: u64 = key - expbase.K_MB
        let n: usize = fuiscene.node_of_key(key)
        var x: u64 = 8
        var y: u64 = 40
        if n != fuiscene.NONE {
            x = fuiscene.node_x(n)
            y = fuiscene.node_y(n) + fuiscene.node_h(n)
        }
        var mtxt: u64 = msg.get(((&k_mfile[0 as usize]) as u64))
        s_open = 2
        if m == 1 {
            mtxt = msg.get(((&k_medit[0 as usize]) as u64))
            s_open = 6
        } else if m == 2 {
            mtxt = msg.get(((&k_mshow[0 as usize]) as u64))
            s_open = 18
        } else if m == 3 {
            mtxt = msg.get(((&k_mgo[0 as usize]) as u64))
            s_open = 7
        }
        let _n: u64 = expnav.popup_at(x, y, mtxt)
        return
    }
    if key == expbase.K_SORT || key == expbase.K_CMD {
        // W4b: Sort and New open a small menu under their button
        let n2: usize = fuiscene.node_of_key(key)
        var x2: u64 = 8
        var y2: u64 = 40
        if n2 != fuiscene.NONE {
            x2 = fuiscene.node_x(n2)
            y2 = fuiscene.node_y(n2) + fuiscene.node_h(n2)
        }
        var mt2: u64 = msg.get(((&k_msort[0 as usize]) as u64))
        s_open = 17
        if key == expbase.K_CMD {
            mt2 = msg.get(((&k_mnew[0 as usize]) as u64))
            s_open = 15
        }
        let _n2: u64 = expnav.popup_at(x2, y2, mt2)
        return
    }
    if key >= expbase.K_CMD && key < expbase.K_CMD + 6 {
        // r402: the command bar -- the same actions the menus ran, by the same functions
        var cr: u64 = 0
        let ci: u64 = key - expbase.K_CMD
        if ci == 0 {
            cr = menu_choice(2, 0, tab, tree, stat, fpfad)
        } else if ci == 1 {
            cr = menu_choice(6, 0, tab, tree, stat, fpfad)
        } else if ci == 2 {
            cr = menu_choice(6, 1, tab, tree, stat, fpfad)
        } else if ci == 3 {
            cr = menu_choice(6, 2, tab, tree, stat, fpfad)
        } else if ci == 4 {
            cr = expwork.rename_ask(tab)
        } else {
            cr = expwork.delete_ask(tab, false)
        }
        expbase.s_wartet = cr & 255
        s_open = cr >> 8
    } else if key == expbase.K_BSTART {
        expwork.launcher_open()
    } else if key == expbase.K_BAUF {
        expwork.eltern(((&expbase.dir_path[0 as usize]) as u64))
        expwork.hist_push(((&expbase.dir_path[0 as usize]) as u64))
        expnav.new_read(tree, tab, stat, fpfad)
    } else if key == expbase.K_BZUR {
        expnav.hist_back(tree, tab, stat, fpfad)
    } else if key == expbase.K_BVOR {
        expnav.hist_forward(tree, tab, stat, fpfad)
    } else if key == expbase.K_BNEU {
        expnav.places_show()
        expnav.new_read(tree, tab, stat, fpfad)
    } else if key == expbase.K_BAUS {
        expnav.eject_click(tree, tab, stat, fpfad)
    } else if key >= expbase.K_CRUMB && key < expbase.K_CRUMB + 12 {
        let _kk: bool = expnav.crumb_click(key, tree, tab, stat, fpfad)
    } else if key == expbase.K_PATH {
        ulib.strncpy(((&expbase.dir_path[0 as usize]) as u64), fuiscene.entry_text(expbase.K_PATH), 126)
        expwork.hist_push(((&expbase.dir_path[0 as usize]) as u64))
        expnav.new_read(tree, tab, stat, fpfad)
    } else if key == expbase.K_PLACES {
        expnav.nav_click(tree, tab, stat, fpfad)
    } else if key == expbase.K_TREE {
        expnav.tree_walk(fuiscene.table_sel(expbase.K_TREE), tree, tab, stat, fpfad)
    } else if key == expbase.K_TAB || key == expbase.K_SYM {
        var hc: u64 = 4294967295
        if key == expbase.K_TAB {
            hc = fuiscene.table_head_col()
        }
        if hc != 4294967295 {
            sort_header(hc, tree, tab)
        } else {
            expnav.open(expwork.cur_row(), tree, tab, stat, fpfad, ((&s_start[0 as usize]) as u64))
        }
    } else if key >= expbase.K_RT && key < expbase.K_RT + 8 {
        expnav.tab_switch(key - expbase.K_RT, tree, tab, stat, fpfad)
    } else if key >= expbase.K_RX && key < expbase.K_RX + 8 {
        expnav.tab_close_nr(key - expbase.K_RX, tree, tab, stat, fpfad)
    } else if key == expbase.K_RPLUS {
        expnav.tab_new(tree, tab, stat, fpfad)
    }
}

fn first_message() {
    expnav.say_strip_info()
    let tree: u64 = expbase.K_TREE
    let tab: u64 = expbase.K_TAB
    let stat: u64 = K_STAT
    let fpfad: u64 = expbase.K_PATH
    expwork.say(((&s_fui[0 as usize]) as u64))
    expwork.sayn(fuib.fui_painted())
    expwork.say(((&s_fuin[0 as usize]) as u64))
    expwork.sayn(fuib.fui_rejected())
    expwork.nl()
    expnav.say_rects(0, 0, 0, 0, fpfad, tree, tab, stat)
    expwork.say(((&s_go2[0 as usize]) as u64))
    expwork.nl()
}

fn u_start(args: u64) -> u64 {
    expwork.dbg_setup(args)
    var s_no: [u8; 8] = "nohit\0\0\0"
    var s_nc: [u8; 8] = "noclip\0\0"
    var s_pc: [u8; 10] = "computer\0\0"
    var s_hid: [u8; 7] = "hidden\0"
    var s_nov: [u8; 7] = "noview\0"
    var no_view: bool = false
    var go_computer: bool = false
    var nohit: bool = false
    var noclip: bool = false
    let _mk: u64 = msg.init()
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        let p: u64 = ulib.arg_at(args, a)
        if ulib.streq(p, (&s_no[0 as usize]) as u64) {
            nohit = true
        }
        if ulib.streq(p, (&s_nc[0 as usize]) as u64) {
            noclip = true
        }
        // r458: `explorer computer` starts in the overview of the drives
        if ulib.streq(p, (&s_pc[0 as usize]) as u64) {
            go_computer = true
        }
        // W4: `explorer / hidden` starts with the hidden entries shown (the gate's counter-proof for the root filter)
        if ulib.streq(p, (&s_nov[0 as usize]) as u64) {
            no_view = true
        }
        if ulib.streq(p, (&s_hid[0 as usize]) as u64) {
            expmodell.set_hidden(true)
        }
        a = a + 1
    }
    fuiscene.set_flags(nohit, noclip)
    fuiscene.set_nohit(nohit)
    if !fuiscene.begin() {
        expwork.say(((&s_bad2[0 as usize]) as u64))
        expwork.nl()
        return 1
    }
    // Where we start: /data when there is one, else the root, or the folder
    // that was handed over (`explorer /w`).
    var start: [u8; 8] = "/data\0\0\0"
    if ulib.is_dir((&start[0 as usize]) as u64) {
        ulib.strcpy(((&expbase.dir_path[0 as usize]) as u64), (&start[0 as usize]) as u64)
    }
    var sa: u64 = 1
    while sa < argc {
        let sp: u64 = ulib.arg_at(args, sa)
        if __mmio_read8(sp as *mut u8) as u64 == 47 && text.length(sp) < 120
            && ulib.is_dir(sp) {
            ulib.strcpy(((&expbase.dir_path[0 as usize]) as u64), sp)
            sa = argc
        }
        sa = sa + 1
    }
    // The display name comes from the data (/apps/explorer.osp/INFO).
    let na: u64 = appdir.load(((&t_appdir[0 as usize]) as u64), false)
    var source: u64 = 0
    var k2: u64 = 0
    while k2 < na {
        if ulib.streq(appdir.exec_of(k2), ((&t_own[0 as usize]) as u64)) {
            ulib.strncpy(((&t_title[0 as usize]) as u64), appdir.name_of(k2), 62)
            source = appdir.file_of(k2)
            k2 = na
        } else {
            k2 = k2 + 1
        }
    }
    if (t_title[0 as usize]) == 0 as u8 {
        ulib.strncpy(((&t_title[0 as usize]) as u64), ulib.arg_at(args, 0), 62)
    }
    expwork.say(((&s_title[0 as usize]) as u64))
    expwork.say(((&t_title[0 as usize]) as u64))
    expwork.say(((&s_zu[0 as usize]) as u64))
    if source != 0 {
        expwork.say(source)
    }
    expwork.say(((&s_end[0 as usize]) as u64))
    expwork.nl()

    if !no_view {
        expview.attach()
        var s_ld: [u8; 5] = "load\0"
        let lrc: u64 = expview.load()
        expwork.say_view_store((&s_ld[0 as usize]) as u64, lrc)
        expwork.nl()
        if lrc != svcrules.OK {
            let _seed: u64 = expview.save()
        }
    }
    // The first tab: the folder we start in.
    ulib.strncpy(expwork.tab_p(0), ((&expbase.dir_path[0 as usize]) as u64), expbase.TAB_WIDTH - 1)
    expbase.tab_n = 1
    expbase.tab_at = 0
    expnav.tabellen_einrichten()
    expwork.hist_push(((&expbase.dir_path[0 as usize]) as u64))
    expnav.new_read(expbase.K_TREE, expbase.K_TAB, K_STAT, expbase.K_PATH)
    let _zo: u64 = expmodell.time_load()
    expmodell.report()
    let _no: u64 = exporte.places_make()
    if go_computer {
        expbase.vmodus = 3
        expnav.new_read(expbase.K_TREE, expbase.K_TAB, K_STAT, expbase.K_PATH)
        expwork.say((&expbase.s_ovw[0 as usize]) as u64)
        expwork.sayn(expbase.entry_count)
        expwork.nl()
    }
    let _nk: u64 = exporte.crumb_make(((&expbase.dir_path[0 as usize]) as u64))
    expakt.report()
    expdlg.report()
    expnav.places_show()
    expnav.crumb_show()

    let bx: u64 = 70
    let by: u64 = 70
    fuiapp.set_atomic(true)
    if !fuiscene.open(bx, by, BW0, BH0, ((&t_title[0 as usize]) as u64), expnav.build) {
        expwork.say(((&s_bad2[0 as usize]) as u64))
        expwork.nl()
        return 1
    }
    expbase.s_up = true
    // r454: the tabs live in the title bar: the server grows the buffer by the strip, the tree gets a strip row
    if !fuiscene.caption_strip(true) {
        expwork.say(((&s_nostrip[0 as usize]) as u64))
        expwork.nl()
    }
    fuiscene.strip_drag_node(expbase.K_STRIPDRAG)
    if fuiscene.strip_on() {
        // the runners read this: the drawing area of this window starts at the top of the title bar
        expwork.say(((&expbase.s_strip[0 as usize]) as u64))
        expwork.sayn(fuiscene.strip_h())
        expwork.say(((&expbase.s_stripc[0 as usize]) as u64))
        expwork.sayn(fuiscene.strip_caps_w())
        expwork.nl()
    }
    fuiscene.set_app(((&t_nm[0 as usize]) as u64))
    fuiscene.raise()
    // This window takes drops (of its own rows and of other windows).
    fuiscene.drop_accept(true)
    expwork.say(((&s_geo2[0 as usize]) as u64))
    expwork.kv(((&s_gx[0 as usize]) as u64), bx)
    expwork.kv(((&s_gy[0 as usize]) as u64), by)
    expwork.kv(((&s_gw[0 as usize]) as u64), BW0)
    expwork.kv(((&s_gh[0 as usize]) as u64), BH0)
    expwork.nl()

    var first: bool = true
    var strip_sig: u64 = expbase.tab_n * 16 + expbase.tab_at
    var strip_pend: u64 = 0
    var runden: u64 = 0
    var keys: u64 = fuiscene.key_free_seq()
    var frame_count: u64 = fuiscene.table_frames()
    var cur_drop_count: u64 = apphost.drop_count()
    while fuiscene.alive() && runden < 4000000000 {
        runden = runden + 1
        let key: u64 = fuiscene.pump()
        if first && fuiscene.painted() > 0 {
            first = false
            fuiscene.focus(expbase.K_TAB)
            expwork.nav_sync_sel()
            first_message()
        }
        // The menu is gone (Esc, a click elsewhere) without a choice.
        if s_open != 0 && !fuiscene.menu_is_open() && key != fuiscene.KEY_POPUP {
            s_open = 0
        }
        if key != 0 {
            behandeln(key)
        }
        if fuiscene.strip_on() {
            let ssig: u64 = expbase.tab_n * 16 + expbase.tab_at
            if ssig != strip_sig {
                strip_sig = ssig
                strip_pend = fuiscene.painted() + 1
            }
            if strip_pend != 0 && fuiscene.painted() >= strip_pend {
                strip_pend = 0
                expnav.say_strip_rects()
            }
        }
        if fuiscene.table_resize_seq() != rs_seen {
            // W4b: a column edge was dragged: keep the four widths over rebuilds
            rs_seen = fuiscene.table_resize_seq()
            var uc: u64 = 0
            while uc < 4 {
                expbase.ucol[(uc) as usize] = fuiscene.table_colw_get(expbase.K_TAB, uc)
                uc = uc + 1
            }
            expbase.cols_user = 1
            expwork.cm_store()
            expbase.cm_say = 1
            expwork.columns_set(expbase.g_binh)
            expwork.say(((&s_colres[0 as usize]) as u64))
            expwork.kv(((&s_colres_a[0 as usize]) as u64), expbase.ucol[(0) as usize])
            expwork.kv(((&s_colres_b[0 as usize]) as u64), expbase.ucol[(1) as usize])
            expwork.kv(((&s_colres_c[0 as usize]) as u64), expbase.ucol[(2) as usize])
            expwork.kv(((&s_colres_d[0 as usize]) as u64), expbase.ucol[(3) as usize])
            expwork.nl()
            expwork.rfr()
        }
        // X5: while the preview pane is open it follows the cursor row (a plain click does not mark rows)
        if expbase.prev_on != 0 && expwork.cur_row() != pv_row_seen {
            pv_row_seen = expwork.cur_row()
            expwork.rfr()
        }
        if fuiscene.table_frames() != frame_count {
            frame_count = fuiscene.table_frames()
            expnav.say_selection(expbase.K_TAB)
            expwork.status_selection()
            expwork.rfr()
        }
        expnav.search_poll()
        if apphost.drop_count() != cur_drop_count {
            cur_drop_count = apphost.drop_count()
            expwork.say(((&s_dc[0 as usize]) as u64))
            expwork.sayn(cur_drop_count)
            expwork.nl()
        }
        // Something happened on the bus (a stick in, a stick out).
        let nn: u64 = apphost.noti_new()
        if nn != noti_stand {
            let cur_first: bool = noti_stand == 0xFFFFFFFFFFFFFFFF
            noti_stand = nn
            if !cur_first {
                let vorher: u64 = exporte.places_num()
                expnav.places_show()
                if exporte.places_num() != vorher {
                    expwork.rfr()
                }
            }
        }
        // The keys nobody took (not a text field): the shortcuts.
        if fuiscene.key_free_seq() != keys {
            keys = fuiscene.key_free_seq()
            let key_code: u64 = fuiscene.key_free()
            // while the path field has the keyboard only its own shortcuts
            var frei: bool = true
            if fuiscene.focus_key() == expbase.K_PATH && key_code != T_STRG_L
                && key_code != T_STRG_T && key_code != T_STRG_W
                && key_code != hostkey.KEY_F5 && key_code != hostkey.KEY_ESC {
                frei = false
            }
            if frei && expbase.vmodus == 0 && !fuiscene.dialog_is_open() && s_open == 0 {
                if key_code == hostkey.KEY_ESC {
                    if expbase.pfadfeld_an {
                        expnav.crumb_toggle(expbase.K_PATH)
                    }
                } else if key_code == T_STRG_L {
                    expnav.crumb_toggle(expbase.K_PATH)
                } else if key_code == T_STRG_T {
                    expnav.tab_new(expbase.K_TREE, expbase.K_TAB, K_STAT, expbase.K_PATH)
                } else if key_code == T_STRG_W {
                    expnav.tab_close_do(expbase.K_TREE, expbase.K_TAB, K_STAT, expbase.K_PATH)
                } else if key_code == hostkey.KEY_OLD_P {
                    let _pv: u64 = expnav.preview_toggle(expbase.K_TREE, expbase.K_TAB, K_STAT, expbase.K_PATH)
                } else {
                    let r: u64 = key_block(key_code, expbase.K_TREE, expbase.K_TAB, K_STAT, expbase.K_PATH)
                    expbase.s_wartet = r & 255
                    if (r >> 8) != 0 {
                        s_open = r >> 8
                    }
                }
            }
        }
        let granted: u64 = expconfirm.take()
        if granted != 0 {
            expbase.s_wartet = vollziehen(granted, expbase.K_TAB, expbase.K_TREE, K_STAT, expbase.K_PATH)
            expwork.rfr()
        }
        if fuiscene.dialog_is_open() && !dlg_gemeldet {
            expnav.say_dlgrect()
            dlg_gemeldet = true
        }
    }
    return 0
}

// A drag of one of several marked rows takes all of them.
fn drag_list(zp: u64) {
    if s_multidrag {
        let _n: u64 = expwork.select_list(expbase.K_TAB)
    } else {
        expakt.list_clear()
        let _a: bool = expakt.list_add(zp)
    }
}

fn drag_basket(zp: u64) -> u64 {
    if !s_multidrag {
        return expakt.in_trash(zp)
    }
    let _n: u64 = expwork.select_list(expbase.K_TAB)
    var rc: u64 = 0
    var i: u64 = 0
    while i < expakt.list_num() {
        let r2: u64 = expakt.in_trash(expakt.list_at(i))
        if r2 != 0 {
            rc = r2
        }
        i = i + 1
    }
    return rc
}
