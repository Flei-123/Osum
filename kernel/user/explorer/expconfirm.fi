profile app

import libc.octets
import lineout
import msg
import services.dlgproto
import services.svcosum
import services.svcrules
import explorer.expbase

export { ask, grant, take, VERDICT_GO, VERDICT_NO, VERDICT_NO_BACKEND }

const APP_LEN: u64 = 8
const RESULT_CAP: u64 = 8
const VERDICT_NO: u64 = 0
const VERDICT_GO: u64 = 1
const VERDICT_NO_BACKEND: u64 = 2

static mut APP: [u8; 9] = "explorer\0"
static mut CONFIRM_LINE: [u8; 33] = "explorer: confirm delete status=\0"
static mut WAIT: [u8; 7] = " wait=\0"
static mut ANSWER: [u8; 9] = " answer=\0"
static mut GO: [u8; 5] = " go=\0"
static mut result_buf: [u8; 8] = [0 as u8; 8]
static mut granted_wait: u64 = 0

fn reply_ptr() -> u64 {
    return (&result_buf[0 as usize]) as u64
}

fn say_field(name: u64, value: u64) {
    if expbase.s_dbg == 0 {
        return
    }
    lineout.add_text(name)
    lineout.add_num(value)
}

fn verdict_of(status: u64, answer: u64) -> u64 {
    if status == svcrules.NO_BACKEND {
        return VERDICT_NO_BACKEND
    }
    if status == svcrules.OK && answer == dlgproto.ANSWER_OK {
        return VERDICT_GO
    }
    return VERDICT_NO
}

fn ask(title_key: u64, text_key: u64, wait: u64) -> u64 {
    octets.zero(reply_ptr(), RESULT_CAP)
    let _bound: u64 = svcosum.set_app((&APP[0 as usize]) as u64, APP_LEN)
    let status: u64 = svcosum.confirm(msg.get(title_key), msg.get(text_key), reply_ptr())
    let answer: u64 = octets.le32(reply_ptr())
    let verdict: u64 = verdict_of(status, answer)
    say_field((&CONFIRM_LINE[0 as usize]) as u64, status)
    say_field((&WAIT[0 as usize]) as u64, wait)
    say_field((&ANSWER[0 as usize]) as u64, answer)
    say_field((&GO[0 as usize]) as u64, verdict)
    if expbase.s_dbg != 0 {
        lineout.end_line()
    }
    return verdict
}

fn grant(wait: u64) {
    granted_wait = wait
}

fn take() -> u64 {
    let wait: u64 = granted_wait
    granted_wait = 0
    return wait
}
