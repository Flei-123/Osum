fn rename_ask(tab: u64) -> u64 {
    // D3: two or more marked rows -> one rule for all of them (mass rename, code 13)
    if select_list(tab) >= 2 {
        ulib.strncpy((&expbase.dlgpuffer[0 as usize]) as u64, (&t_massdef[0 as usize]) as u64, 120)
        let _m: u64 = dlg_entry(msg.get((&expbase.k_rename[0 as usize]) as u64),
            msg.get((&k_massren[0 as usize]) as u64),
            (&expbase.dlgpuffer[0 as usize]) as u64)
        return 13
    }
    let z: u64 = first_select(tab)
    if z >= m_count() {
        return 0
    }
    fuiscene.table_set_sel(cur_key(), z)
    ulib.strncpy((&expbase.dlgpuffer[0 as usize]) as u64, m_name(m_ord(z)), 120)
    let _d: u64 = dlg_entry(msg.get((&expbase.k_rename[0 as usize]) as u64),
        msg.get((&expbase.k_name[0 as usize]) as u64),
        (&expbase.dlgpuffer[0 as usize]) as u64)
    return 1
}

fn delete_ask(tab: u64, endgueltig: bool) -> u64 {
    let n: u64 = select_list(tab)
    if n == 0 {
        return 0
    }
    var ask: u64 = msg.get((&expbase.k_del[0 as usize]) as u64)
    if endgueltig {
        ask = msg.get((&expbase.k_delperm[0 as usize]) as u64)
    }
    let _d: u64 = dlg_ask(msg.get((&expbase.k_deltit[0 as usize]) as u64),
        ask)
    if endgueltig {
        return 5
    }
    return 3
}

