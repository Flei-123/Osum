    let e: u64 = m_ord(line)
    let full: u64 = join((&expbase.dir_path[0 as usize]) as u64, m_name(e))
    let n: u64 = text.length(full)
    let _d: u64 = wlib.drag_put(wlib.CT_PATH | wlib.CT_TEXT, full, n)
    var s_zg: [u8; 12] = "expl: zieh \0"
    say((&s_zg[0 as usize]) as u64)
    say(full)
    nl()
}

