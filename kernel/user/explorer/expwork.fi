    }
    ulib.strncpy((&vpfad[0 as usize]) as u64,
        (&expbase.vspeicher[0 as usize]) as u64, 120)
    ulib.strcat((&vpfad[0 as usize]) as u64, (&sl[0 as usize]) as u64)
    ulib.strcat((&vpfad[0 as usize]) as u64, (&expbase.vsicher[0 as usize]) as u64)
    ulib.strcat((&vpfad[0 as usize]) as u64, (&expbase.vunter[0 as usize]) as u64)
    path_set((&vpfad[0 as usize]) as u64)
}

fn build_progress() {
    var k_s_d: [u8; 24] = "explorer.progress.files\0"
    var k_s_b: [u8; 24] = "explorer.progress.bytes\0"
    var k_s_n: [u8; 22] = "explorer.progress.new\0"
    var d: [u8; 24] = [0 as u8; 24]
    var lp: u64 = 0
    lp = pfeld(lp, msg.get((&k_s_d[0 as usize]) as u64), (&d[0 as usize]) as u64,
        bstore.files_of())
    lp = pfeld(lp, msg.get((&k_s_b[0 as usize]) as u64), (&d[0 as usize]) as u64,
        bstore.read_of())
    lp = pfeld(lp, msg.get((&k_s_n[0 as usize]) as u64), (&d[0 as usize]) as u64,
        bstore.written_of())
    expbase.pbuf[(lp) as usize] = 0 as u8
}

fn pfeld(lp0: u64, txt: u64, d: u64, value: u64) -> u64 {
    var lp: u64 = lp0
    var k: u64 = 0
    while (*((txt + k) as *mut u8)) != 0 as u8 && lp < 120 {
        expbase.pbuf[(lp) as usize] = *((txt + k) as *mut u8)
        lp = lp + 1
        k = k + 1
    }
    let n: u64 = text.digits(value, d, true)
    var i: u64 = 0
    while i < n && lp < 120 {
        expbase.pbuf[(lp) as usize] = *((d + i) as *mut u8)
        lp = lp + 1
        i = i + 1
    }
    return lp
}

fn in_own_tree(target: u64) -> bool {
    let q: u64 = text.length((&expbase.t_bquelle[0 as usize]) as u64)
    if !ulib.strneq(target, (&expbase.t_bquelle[0 as usize]) as u64, q) {
        return false
    }
    let c: u64 = (*((target + q) as *mut u8)) as u64
    return c == 0 || c == 47
}

fn next_number(target: u64) -> u64 {
    var namebuf: [u8; 64] = [0 as u8; 64]
    let fd: u64 = bstore.snaps_open(target)
    if ulib.bad(fd) {
        return 1
    }
    var n: u64 = 0
    var next: bool = true
    while next {
        if !bstore.snaps_next(fd, (&namebuf[0 as usize]) as u64, 60) {
            next = false
        } else {
            n = n + 1
        }
    }
    io.close(fd)
    return n + 1
}

