fn say_tat(was: u64, getan: u64, rc: u64) {
    if expbase.s_dbg == 0 {
        return
    }
    var b: [u8; 96] = [0 as u8; 96]
    var s_tat: [u8; 16] = "explorer: tat \0\0"
    var s_n: [u8; 4] = " n=\0"
    var s_rc: [u8; 8] = " rc=\0\0\0\0"
    let p: u64 = (&b[0 as usize]) as u64
    var at: u64 = ulib.strcpy(p, (&s_tat[0 as usize]) as u64)
    at = at + text.digits(was, p + at, true)
    at = at + ulib.strcpy(p + at, (&s_n[0 as usize]) as u64)
    at = at + text.digits(getan, p + at, true)
    at = at + ulib.strcpy(p + at, (&s_rc[0 as usize]) as u64)
    at = at + text.digits(rc, p + at, true)
    b[(at) as usize] = 10 as u8
    lineout.add_bytes(p, at + 1)
}

static mut s_cb: [u8; 200] = [0 as u8; 200]

static mut t_ab: [u8; 14] = "dialog.cancel\0"

// ------------------------------------------------------------ helpers

fn rfr() {
    if expbase.s_up {
        fuiscene.refresh()
    }
}

fn cur_key() -> u64 {
    if expbase.symansicht == 1 {
        return expbase.K_SYM
    }
    return expbase.K_TAB
}

fn cur_row() -> u64 {
    return fuiscene.table_sel(cur_key())
}

fn tree_row() -> u64 {
    return fuiscene.table_sel(expbase.K_TREE)
}

// The status line shows a message instead of the counts until the next read.
fn stat_set(p: u64) {
    expbase.stat_msg = p
    rfr()
}

// The path field holds a new text (the field keeps what the user typed, so
// every change of the place has to be written into it).
fn path_set(p: u64) {
    if expbase.s_up {
        fuiscene.entry_set(expbase.K_PATH, p)
    }
}

fn text_w(p: u64) -> u64 {
    return fuiscene.dp(wlibc.text_w(wlibc.F_UI, fuiscene.ui_px(), p, text.length(p)))
}

// A catalogue text with one line per item -> items one after the other,
// each ended by a NUL (what the popup menu of the scene host takes).
fn split_items(src: u64, dst: u64, max: u64) -> u64 {
    var n: u64 = 0
    var at: u64 = 0
    var k: u64 = 0
    var last_nl: bool = true
    while __mmio_read8((src + k) as *mut u8) != 0 as u8 && at + 2 < max {
        let c: u8 = __mmio_read8((src + k) as *mut u8)
        if c == 10 as u8 {
            __mmio_write8((dst + at) as *mut u8, 0 as u8)
            n = n + 1
            last_nl = true
        } else {
            __mmio_write8((dst + at) as *mut u8, c)
            last_nl = false
        }
        at = at + 1
        k = k + 1
    }
    if !last_nl {
        n = n + 1
    }
    __mmio_write8((dst + at) as *mut u8, 0 as u8)
    __mmio_write8((dst + at + 1) as *mut u8, 0 as u8)
    return n
}

fn item_at(p: u64, j: u64) -> u64 {
    var q: u64 = p
    var k: u64 = 0
    while k < j {
        q = q + text.length(q) + 1
        k = k + 1
    }
    return q
}

// Where a popup that nobody pointed at goes: into the file list.
fn where_x() -> u64 {
    let n: usize = fuiscene.node_of_key(cur_key())
    if n == fuiscene.NONE {
        return 40
    }
    return fuiscene.node_x(n) + 24
}

fn where_y() -> u64 {
    let n: usize = fuiscene.node_of_key(cur_key())
    if n == fuiscene.NONE {
        return 80
    }
    return fuiscene.node_y(n) + 40
}

// ------------------------------------------------------------ the dialogs

fn dlg_entry(title: u64, label: u64, initial: u64) -> u64 {
    fuiscene.dialog_entry(title, label, initial, msg.get((&expbase.t_ok[0 as usize]) as u64), msg.get((&t_ab[0 as usize]) as u64))
    return 0
}

fn dlg_ask(title: u64, text: u64) -> u64 {
    fuiscene.dialog_open(title, text, msg.get((&expbase.t_ok[0 as usize]) as u64), msg.get((&t_ab[0 as usize]) as u64))
    return 0
}

fn dlg_hinweis(title: u64, text: u64) -> u64 {
    fuiscene.dialog_open(title, text, msg.get((&expbase.t_ok[0 as usize]) as u64), 0)
    return 0
}

fn dlg_choice(title: u64, text: u64, btns: u64, n: u64) -> u64 {
    let _n: u64 = split_items(btns, ((&s_cb[0 as usize]) as u64), 190)
    fuiscene.dialog_choice(title, text, ((&s_cb[0 as usize]) as u64), n)
    return 0
}

fn pv_skip_ws(p: u64, n: u64, at: u64) -> u64 {
    var i: u64 = at
    var go: bool = true
    while go && i < n {
        let c: u64 = (__mmio_read8((p + i) as *mut u8)) as u64
        if c == 35 {
            // a comment runs to the end of the line
            while i < n && (__mmio_read8((p + i) as *mut u8)) != 10 as u8 {
                i = i + 1
            }
        } else if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            go = false
        }
    }
    return i
}

// Reads one decimal number at `at`; the number goes to pv_num, the new position is returned.
static mut pv_num: u64 = 0

fn pv_read_num(p: u64, n: u64, at: u64) -> u64 {
    var i: u64 = pv_skip_ws(p, n, at)
    var v: u64 = 0
    var any: u64 = 0
    while i < n {
        let c: u64 = (__mmio_read8((p + i) as *mut u8)) as u64
        if c < 48 || c > 57 {
            break
        }
        if v < 100000 {
            v = v * 10 + (c - 48)
        }
        any = 1
        i = i + 1
    }
    pv_num = v
    if any == 0 {
        return 0
    }
    return i
}

// Binary PPM (P6) and PGM (P5) with maxval 255 -> 0xAARRGGBB. Sets pv_w/pv_h; false when not such a file.
fn ppm_read(src: u64, n: u64, out: u64, cap: u64) -> bool {
    if n < 9 || (__mmio_read8(src as *mut u8)) != 80 as u8 {
        return false
    }
    let t: u64 = (__mmio_read8((src + 1) as *mut u8)) as u64
    if t != 54 && t != 53 {
        return false
    }
    var at: u64 = pv_read_num(src, n, 2)
    if at == 0 {
        return false
    }
    let w: u64 = pv_num
    at = pv_read_num(src, n, at)
    if at == 0 {
        return false
    }
    let h: u64 = pv_num
    at = pv_read_num(src, n, at)
    if at == 0 || pv_num != 255 || w == 0 || h == 0 {
        return false
    }
    // exactly one blank separates the header from the data
    at = at + 1
    var ch: u64 = 3
    if t == 53 {
        ch = 1
    }
    if w * h * 4 > cap || at + w * h * ch > n {
        return false
    }
    var i: u64 = 0
    while i < w * h {
        var r: u64 = 0
        var g: u64 = 0
        var b: u64 = 0
        if ch == 3 {
            r = (__mmio_read8((src + at + i * 3) as *mut u8)) as u64
            g = (__mmio_read8((src + at + i * 3 + 1) as *mut u8)) as u64
            b = (__mmio_read8((src + at + i * 3 + 2) as *mut u8)) as u64
        } else {
            r = (__mmio_read8((src + at + i) as *mut u8)) as u64
            g = r
            b = r
        }
        __mmio_write32((out + i * 4) as *mut u32, (4278190080 | (r << 16) | (g << 8) | b) as u32)
        i = i + 1
    }
    expbase.pv_w = w
    expbase.pv_h = h
    return true
}

fn tab_text_build() {
    rfr()
    say(((&s_tab_t[0 as usize]) as u64))
    sayn(expbase.tab_n)
    say(((&s_tab_a[0 as usize]) as u64))
    sayn(expbase.tab_at)
    nl()
}

static mut s_tab_t: [u8; 18] = "explorer: reiter \0"

static mut s_tab_a: [u8; 4] = " a=\0"
