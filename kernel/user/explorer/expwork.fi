fn report_time() {
    var s_z: [u8; 16] = "explorer: zeit \0"
    var s_m: [u8; 7] = "mtime=\0"
    var s_e: [u8; 8] = "with_n=\0"
    var s_v: [u8; 9] = "total_n=\0"
    var s_o: [u8; 7] = "tzoff=\0"
    if expbase.vmodus != 0 {
        return
    }
    var mit: u64 = 0
    var first: u64 = 0
    var i: u64 = 0
    let n: u64 = m_count()
    while i < n {
        let t: u64 = expmodell.mtime_at(expmodell.ord_at(i))
        if t != 0 {
            mit = mit + 1
            if first == 0 {
                first = t
            }
        }
        i = i + 1
    }
    say((&s_z[0 as usize]) as u64)
    kv((&s_m[0 as usize]) as u64, first)
    kv((&s_e[0 as usize]) as u64, mit)
    kv((&s_v[0 as usize]) as u64, n)
    kv((&s_o[0 as usize]) as u64, expmodell.time_offset())
    nl()
}

