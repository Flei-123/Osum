// True when the last characters of `full` (length `nl`) equal the lower-case, NUL-terminated `ext` (".txt\0").
// Letters are compared case-insensitively (bit 32); only lower-case letters, digits and '.' are valid in `ext`.
fn tail_is(full: u64, nl: u64, ext: u64) -> bool {
    let el: u64 = text.length(ext)
    if nl <= el {
        return false
    }
    var i: u64 = 0
    while i < el {
        let c: u64 = (*((full + nl - el + i) as *mut u8)) as u64 | 32
        let w: u64 = (*((ext + i) as *mut u8)) as u64
        if c != w {
            return false
        }
        i = i + 1
    }
    return true
}

// File association for the merged Editor (/bin/nedit): plain-text and source file extensions (Notepad-like).
fn is_text_file(full: u64, nl: u64) -> bool {
    var exts: [u8; 97] = ".txt\0.md\0.log\0.conf\0.cfg\0.ini\0.json\0.csv\0.xml\0.html\0.css\0.js\0.py\0.fi\0.sh\0.c\0.h\0.toml\0.yaml\0.yml\0\0"
    var p: u64 = (&exts[0 as usize]) as u64
    while (*(p as *mut u8)) as u64 != 0 {
        if tail_is(full, nl, p) {
            return true
        }
        p = p + text.length(p) + 1
    }
    return false
}

fn eltern_v(p: u64) {
    var n: u64 = text.length(p)
    while n > 0 && (*((p + n - 1) as *mut u8)) != 47 as u8 {
        n = n - 1
    }
    if n > 0 {
        n = n - 1
    }
    __mmio_write8((p + n) as *mut u8, 0 as u8)
}

fn show_place(fpfad: u64) {
