        return
    }
    let e: u64 = m_ord(z)
    if m_art(e) != 0 {
        return
    }
    ulib.strncpy((&voll2[0 as usize]) as u64,
        join((&expbase.dir_path[0 as usize]) as u64, m_name(e)), 190)
    var word: u64 = (&v0[0 as usize]) as u64
    if idx == 1 {
        word = (&v1[0 as usize]) as u64
    } else if idx == 2 {
        word = (&v2[0 as usize]) as u64
    } else if idx == 3 {
