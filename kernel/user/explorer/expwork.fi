fn zurueckholen(tree: u64, tab: u64, stat: u64, fpfad: u64) {
    var z1: [u8; 19] = "explorer: restore \0"
    var z2: [u8; 5] = " rc=\0"
    var rc: u64 = 1
    if expbase.vmodus == 1 {
        let z: u64 = cur_row()
        if z < m_count() {
            let e: u64 = m_ord(z)
            ulib.strncpy((&expbase.pziel[0 as usize]) as u64,
                (&t_bwohin[0 as usize]) as u64, 120)
            rc = bstore.restore((&expbase.vspeicher[0 as usize]) as u64, nptr(e),
                (&expbase.pziel[0 as usize]) as u64, 0)
        }
    } else if expbase.vmodus == 2 {
        let z: u64 = cur_row()
        if z < m_count() {
            let e: u64 = m_ord(z)
            let full: u64 = in_sicherung(e)
            let wohin: u64 = join((&t_bwohin[0 as usize]) as u64, nptr(e))
            ulib.strncpy((&expbase.pziel[0 as usize]) as u64, wohin, 120)
            rc = bstore.get((&expbase.vspeicher[0 as usize]) as u64,
                (&expbase.vsicher[0 as usize]) as u64, full,
                (&expbase.pziel[0 as usize]) as u64)
        }
    }
    say((&z1[0 as usize]) as u64)
    say((&expbase.pziel[0 as usize]) as u64)
    say((&z2[0 as usize]) as u64)
    sayn(rc)
    nl()
}

// append `src` to `dst` at `at` (at most `max` bytes in all); the new end
fn bm_cat(dst: u64, at: u64, src: u64, max: u64) -> u64 {
    var o: u64 = at
    var i: u64 = 0
    while __mmio_read8((src + i) as *mut u8) != 0 as u8 && o + 1 < max {
        __mmio_write8((dst + o) as *mut u8,
            __mmio_read8((src + i) as *mut u8))
        o = o + 1
        i = i + 1
    }
    __mmio_write8((dst + o) as *mut u8, 0 as u8)
    return o
}

// A pick of the sub menu: `call <action> path=<full path>`.
fn actions_run(idx: u64) -> u64 {
    var s_call: [u8; 6] = "call \0"
    var k_path: [u8; 5] = "path\0"
    var s_ac: [u8; 18] = "explorer: action \0"
    var s_rc: [u8; 5] = " rc=\0"
    if idx >= expbase.bm_n {
        return 0
    }
    let nm: u64 = (&expbase.bm_names[0 as usize]) as u64 + idx * 64
    var at: u64 = bm_cat((&expbase.bm_line[0 as usize]) as u64, 0,
        (&s_call[0 as usize]) as u64, 290)
    at = bm_cat((&expbase.bm_line[0 as usize]) as u64, at, nm, 290)
    if !actcli.open() {
        return 0
    }
    actcli.req((&expbase.bm_line[0 as usize]) as u64)
    actcli.arg((&k_path[0 as usize]) as u64, (&expbase.bm_path[0 as usize]) as u64)
    let rc: u64 = actcli.send(600)
    say((&s_ac[0 as usize]) as u64)
    say(nm)
    say((&s_rc[0 as usize]) as u64)
    sayn(rc)
    if rc != actcli.R_OK {
        // the status line of the reply says why (denied, parked, no provider ...)
        var s_why: [u8; 8] = " reply=\0"
        if actcli.line(0, (&expbase.bm_tmp[0 as usize]) as u64, 120) {
            say((&s_why[0 as usize]) as u64)
            say((&expbase.bm_tmp[0 as usize]) as u64)
        }
    }
    nl()
    return 0
}

