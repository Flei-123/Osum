fn first_select(tab: u64) -> u64 {
    var z: u64 = 0
    let int: u64 = m_count()
    while z < int {
        if fuiscene.table_sel_has(cur_key(), z) {
            return z
        }
        z = z + 1
    }
    return cur_row()
}

