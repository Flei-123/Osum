profile app

import fuiscene
import exporte
import explorer.expbase

export { build, place_for_key, owns_key, KEY_BASE }

const KEY_BASE: u64 = 300
const MAX_TILES: u64 = 24
const TILE_W: u64 = 132
const TILE_H: u64 = 112
const TILE_GAP: u64 = 8
const ICON_PX: u64 = 48
const ICON_TOP: u64 = 14
const LABEL_PX: u64 = 13
const LABEL_GAP: u64 = 10

static mut tile_place: [u64; 24] = [0 as u64; 24]
static mut tile_count: u64 = 0

fn owns_key(key: u64) -> bool {
    return key >= KEY_BASE && key < KEY_BASE + tile_count
}

fn place_for_key(key: u64) -> u64 {
    return tile_place[(key - KEY_BASE) as usize]
}

fn listed(place: u64) -> bool {
    if place == 0 {
        return false
    }
    if exporte.place_is_header(place) || exporte.place_is_tool(place) {
        return false
    }
    return true
}

fn per_row(pane_w: u64) -> u64 {
    let unit: u64 = fuiscene.sp(TILE_W + TILE_GAP)
    if pane_w < unit * 2 {
        return 1
    }
    return pane_w / unit
}

fn paint_tile(place: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    let word: u64 = *((exporte.places_icons() + place * 8) as *mut u64)
    let size: u64 = fuiscene.sp(ICON_PX)
    fuiscene.icon_at(word, x + (w - size) / 2, y + fuiscene.sp(ICON_TOP), size, 0)
    let name: u64 = exporte.place_text(place)
    let px: u64 = fuiscene.sp(LABEL_PX)
    let tw: u64 = fuiscene.text_width(name, px)
    var tx: u64 = x
    if w > tw {
        tx = x + (w - tw) / 2
    }
    fuiscene.text_role(tx, y + fuiscene.sp(ICON_TOP + LABEL_GAP) + size + px, w, name, px, false, fuiscene.R_TEXT)
}

fn build(parent: usize, pane_w: u64) {
    tile_count = 0
    let column: usize = fuiscene.column_w(parent, 0)
    fuiscene.set_gap(column, TILE_GAP)
    let limit: u64 = per_row(pane_w)
    var row: usize = column
    var in_row: u64 = 0
    var place: u64 = 1
    while place < exporte.places_num() && tile_count < MAX_TILES {
        if listed(place) {
            if in_row == 0 {
                row = fuiscene.row(column)
                fuiscene.set_gap(row, TILE_GAP)
            }
            tile_place[tile_count as usize] = place
            let _tile: usize = fuiscene.ftile(row, KEY_BASE + tile_count, exporte.place_text(place), TILE_W, TILE_H, place, paint_tile)
            tile_count = tile_count + 1
            in_row = in_row + 1
            if in_row == limit {
                in_row = 0
            }
        }
        place = place + 1
    }
}
