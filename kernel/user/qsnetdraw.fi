profile app

import fuiscene
import uitheme
import icons
import uikit.uiscale

export {
    paint_switch, paint_signal, paint_plate, paint_accent_bar, SWITCH_W0, SWITCH_H0, SIGNAL_AREA0, SIGNAL_H0
}

const SWITCH_W0: u64 = 40
const SWITCH_H0: u64 = 20
const KNOB_INSET0: u64 = 3
const BAR_W0: u64 = 3
const BAR_GAP0: u64 = 2
const BAR_STEP0: u64 = 3
const BAR_MIN_H0: u64 = 4
const BAR_COUNT: u64 = 4
const LOCK_SIZE0: u64 = 12
const ACCENT_BAR_W0: u64 = 3
const ACCENT_BAR_INSET0: u64 = 10
const SIGNAL_H0: u64 = 13
const SIGNAL_AREA0: u64 = 38

fn paint_switch(x: u64, y: u64, w: u64, h: u64, on: bool, hot: bool) {
    let sc: u64 = uiscale.ui_scale()
    let sw: u64 = SWITCH_W0 * sc
    let sh: u64 = SWITCH_H0 * sc
    let sx: u64 = x + (w - sw) / 2
    let sy: u64 = y + (h - sh) / 2
    let kd: u64 = sh - 2 * KNOB_INSET0 * sc
    let ky: u64 = sy + KNOB_INSET0 * sc
    if on {
        fuiscene.cv_round_rgb(sx, sy, sw, sh, sh / 2, uitheme.theme(uitheme.T_ACCENT))
        fuiscene.cv_round_rgb(sx + sw - KNOB_INSET0 * sc - kd, ky, kd, kd, kd / 2, uitheme.theme(uitheme.T_SELFG))
        return
    }
    var edge: u64 = uitheme.theme(uitheme.T_DIM)
    if hot {
        edge = uitheme.theme(uitheme.T_FG)
    }
    fuiscene.cv_ring_rgb(sx, sy, sw, sh, sh / 2, sc, edge)
    fuiscene.cv_round_rgb(sx + KNOB_INSET0 * sc, ky, kd, kd, kd / 2, edge)
}

fn paint_signal(x: u64, y: u64, h: u64, lit: u64, secure: bool, fg: u64, dim: u64) {
    let sc: u64 = uiscale.ui_scale()
    let tall: u64 = (BAR_MIN_H0 + (BAR_COUNT - 1) * BAR_STEP0) * sc
    let by: u64 = y + (h - tall) / 2
    var i: u64 = 0
    while i < BAR_COUNT {
        let bh: u64 = (BAR_MIN_H0 + i * BAR_STEP0) * sc
        var rgb: u64 = dim
        if i < lit {
            rgb = fg
        }
        fuiscene.cv_round_rgb(x + i * (BAR_W0 + BAR_GAP0) * sc, by + tall - bh, BAR_W0 * sc, bh, 1, rgb)
        i = i + 1
    }
    if secure {
        let ls: u64 = LOCK_SIZE0 * sc
        let lx: u64 = x + BAR_COUNT * (BAR_W0 + BAR_GAP0) * sc + 2 * sc
        fuiscene.cv_glyph(icons.NET_LOCK, lx, y + (h - ls) / 2, ls, fg)
    }
}

fn paint_plate(x: u64, y: u64, w: u64, h: u64, st: u64, on: bool) -> u64 {
    var fg: u64 = uitheme.theme(uitheme.T_FG)
    if on {
        fuiscene.cv_round_rgb(x, y, w, h, fuiscene.rb_px(), uitheme.theme(uitheme.T_ACCENT))
        fg = uitheme.theme(uitheme.T_SELFG)
    } else if (st & fuiscene.TS_DOWN) != 0 {
        fuiscene.cv_round_rgb(x, y, w, h, fuiscene.rb_px(), uitheme.theme(uitheme.T_BTNDN))
    } else if (st & fuiscene.TS_HOT) != 0 {
        fuiscene.cv_round_rgb(x, y, w, h, fuiscene.rb_px(), uitheme.theme(uitheme.T_BTNHI))
    }
    if (st & fuiscene.TS_FOCUS) != 0 {
        fuiscene.cv_ring_rgb(x, y, w, h, fuiscene.rb_px(), 2, uitheme.theme(uitheme.T_FOCUS))
    }
    return fg
}

fn paint_accent_bar(x: u64, y: u64, h: u64) {
    let sc: u64 = uiscale.ui_scale()
    let inset: u64 = ACCENT_BAR_INSET0 * sc
    if h <= 2 * inset {
        return
    }
    fuiscene.cv_round_rgb(x, y + inset, ACCENT_BAR_W0 * sc, h - 2 * inset, ACCENT_BAR_W0 * sc / 2,
        uitheme.theme(uitheme.T_ACCENT))
}
