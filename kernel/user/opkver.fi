profile kernel

import opkio
import libc.regio

export { split_req, compare, at_least, VER_LESS, VER_EQUAL, VER_GREATER }

const VER_LESS: u64 = 0
const VER_EQUAL: u64 = 1
const VER_GREATER: u64 = 2
const CH_DOT: u64 = 46
const CH_GT: u64 = 62
const CH_EQ: u64 = 61
const CH_ZERO: u64 = 48
const CH_NINE: u64 = 57
const NAME_CAP: u64 = 63
const VER_CAP: u64 = 31
const MAX_PARTS: u64 = 6
const PART_LIMIT: u64 = 100000000

fn split_req(tok: u64, name: u64, ver: u64) {
    var i: u64 = 0
    var n: u64 = 0
    while opkio.g8(tok + i) != 0 && opkio.g8(tok + i) != CH_GT {
        if n < NAME_CAP {
            regio.write8(name + n, opkio.g8(tok + i))
            n = n + 1
        }
        i = i + 1
    }
    regio.write8(name + n, 0)
    regio.write8(ver, 0)
    if opkio.g8(tok + i) == CH_GT && opkio.g8(tok + i + 1) == CH_EQ {
        var k: u64 = 0
        var j: u64 = i + 2
        while opkio.g8(tok + j) != 0 && k < VER_CAP {
            regio.write8(ver + k, opkio.g8(tok + j))
            k = k + 1
            j = j + 1
        }
        regio.write8(ver + k, 0)
    }
}

fn part(p: u64, index: u64) -> u64 {
    var at: u64 = 0
    var k: u64 = 0
    while k < index {
        while opkio.g8(p + at) != 0 && opkio.g8(p + at) != CH_DOT {
            at = at + 1
        }
        if opkio.g8(p + at) == 0 {
            return 0
        }
        at = at + 1
        k = k + 1
    }
    var v: u64 = 0
    while opkio.g8(p + at) >= CH_ZERO && opkio.g8(p + at) <= CH_NINE {
        if v < PART_LIMIT {
            v = v * 10 + (opkio.g8(p + at) - CH_ZERO)
        }
        at = at + 1
    }
    return v
}

fn compare(a: u64, b: u64) -> u64 {
    var k: u64 = 0
    while k < MAX_PARTS {
        let x: u64 = part(a, k)
        let y: u64 = part(b, k)
        if x < y {
            return VER_LESS
        }
        if x > y {
            return VER_GREATER
        }
        k = k + 1
    }
    return VER_EQUAL
}

fn at_least(have: u64, min: u64) -> bool {
    if opkio.g8(min) == 0 {
        return true
    }
    return compare(have, min) != VER_LESS
}
