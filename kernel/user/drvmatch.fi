profile kernel

import ulib
import drvpkg

export { score, better }

const SCORE_PCI_SUB: u64 = 40
const SCORE_PCI: u64 = 30
const SCORE_CLASS_PROG: u64 = 20
const SCORE_CLASS: u64 = 15
const SCORE_EXACT: u64 = 10

fn lower(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

fn same_n(a: u64, b: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if lower(drvpkg.byte_at(a + i)) != lower(drvpkg.byte_at(b + i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn space_at(p: u64) -> u64 {
    var i: u64 = 0
    while drvpkg.byte_at(p + i) != 0 {
        if drvpkg.byte_at(p + i) == 32 {
            return i
        }
        i = i + 1
    }
    return 0xFFFFFFFF
}

fn score(line: u64, qkind: u64, qid: u64) -> u64 {
    var k_pci: [u8; 4] = "pci\0"
    var k_class: [u8; 9] = "pciclass\0"
    let sp: u64 = space_at(line)
    if sp == 0xFFFFFFFF || sp != ulib.length(qkind) || !same_n(line, qkind, sp) {
        return 0
    }
    let lid: u64 = line + sp + 1
    let ll: u64 = ulib.length(lid)
    let ql: u64 = ulib.length(qid)
    if ulib.streq(qkind, (&k_pci[0 as usize]) as u64) {
        if ll == 9 && ql >= 9 && same_n(lid, qid, 9) && (ql == 9 || ql == 19) {
            return SCORE_PCI
        }
        if ll == 19 && ql == 19 && same_n(lid, qid, 19) {
            return SCORE_PCI_SUB
        }
        return 0
    }
    if ulib.streq(qkind, (&k_class[0 as usize]) as u64) {
        if ll == 4 && ql >= 4 && same_n(lid, qid, 4) && (ql == 4 || ql == 7) {
            return SCORE_CLASS
        }
        if ll == 7 && ql == 7 && same_n(lid, qid, 7) {
            return SCORE_CLASS_PROG
        }
        return 0
    }
    if ll == ql && same_n(lid, qid, ll) {
        return SCORE_EXACT
    }
    return 0
}

fn better(spec: u64, rank: u64, ver: u64, bspec: u64, brank: u64, bver: u64) -> bool {
    if spec != bspec {
        return spec > bspec
    }
    if rank != brank {
        return rank > brank
    }
    return ver > bver
}
