profile kernel

import ulib
import tools
import libc.errno

export {
    call, dword_at, put_hex, put_bytes, put_dwords, put_bdf, put_error, parse_hex, parse_bdf, positional, has_flag, byte_at,
    SYS_DBG, OP_LIST, OP_INFO, OP_CFGREAD, OP_CFGWRITE, OP_MMIOREAD, OP_MMIOWRITE, OP_DRIVER,
    OP_PRPHREAD, OP_WLAN_RELOAD, OP_WLAN_STATE, OP_WLAN_KNOB_NAME, OP_WLAN_KNOB_STATE, OP_WLAN_SCAN, OP_WLAN_REJOIN, WRITE_MAGIC, BAD
}

const SYS_DBG: u64 = 1880
const OP_LIST: u64 = 1
const OP_INFO: u64 = 2
const OP_CFGREAD: u64 = 3
const OP_CFGWRITE: u64 = 4
const OP_MMIOREAD: u64 = 5
const OP_MMIOWRITE: u64 = 6
const OP_DRIVER: u64 = 7
const OP_PRPHREAD: u64 = 8
const OP_WLAN_RELOAD: u64 = 9
const OP_WLAN_STATE: u64 = 10
const OP_WLAN_KNOB_NAME: u64 = 11
const OP_WLAN_KNOB_STATE: u64 = 12
const OP_WLAN_SCAN: u64 = 13
const OP_WLAN_REJOIN: u64 = 14
const WRITE_MAGIC: u64 = 0x57524954
const BAD: u64 = 0xFFFFFFFFFFFFFFFF

fn call(op: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") SYS_DBG, in("rdi") op,
        in("rsi") a1, in("rdx") a2, in("r10") a3, in("r8") a4,
        clobber("rcx"), clobber("r11"), clobber("memory"))
}

fn byte_at(p: u64) -> u64 {
    return (*(p as *mut u8)) as u64
}

fn dword_at(p: u64) -> u64 {
    return (*(p as *mut u32)) as u64
}

fn hex_digit(v: u64) -> u64 {
    if v < 10 {
        return 48 + v
    }
    return 87 + v
}

fn put_hex(v: u64, digits: u64) {
    var i: u64 = digits
    while i > 0 {
        i = i - 1
        tools.ob_byte(hex_digit((v >> (i * 4)) & 15))
    }
}

fn put_bdf(bdf: u64) {
    put_hex((bdf >> 8) & 0xFF, 2)
    tools.ob_byte(58)
    put_hex((bdf >> 3) & 0x1F, 2)
    tools.ob_byte(46)
    put_hex(bdf & 7, 1)
}

fn put_error(prog: u64, rc: u64) {
    var s_err: [u8; 9] = ": error \0"
    var s_perm: [u8; 19] = " permission denied\0"
    var s_nxio: [u8; 25] = " no such device or space\0"
    var s_busy: [u8; 6] = " busy\0"
    var s_nodev: [u8; 16] = " no such device\0"
    var s_inval: [u8; 18] = " invalid argument\0"
    var s_io: [u8; 10] = " io error\0"
    let n: u64 = errno.negated(rc)
    tools.ob_str(prog)
    tools.ob_str((&s_err[0 as usize]) as u64)
    tools.ob_num(n)
    if n == errno.E_PERM {
        tools.ob_str((&s_perm[0 as usize]) as u64)
    } else if n == errno.E_NXIO {
        tools.ob_str((&s_nxio[0 as usize]) as u64)
    } else if n == errno.E_BUSY {
        tools.ob_str((&s_busy[0 as usize]) as u64)
    } else if n == errno.E_NODEV {
        tools.ob_str((&s_nodev[0 as usize]) as u64)
    } else if n == errno.E_INVAL {
        tools.ob_str((&s_inval[0 as usize]) as u64)
    } else if n == errno.E_IO {
        tools.ob_str((&s_io[0 as usize]) as u64)
    }
    tools.ob_nl()
    tools.ob_flush()
}

fn hex_value(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return BAD
}

fn parse_hex_at(p: u64, at: u64, end: u64) -> u64 {
    var i: u64 = at
    var v: u64 = 0
    var n: u64 = 0
    while i < end {
        let d: u64 = hex_value(byte_at(p + i))
        if d == BAD || n >= 16 {
            return BAD
        }
        v = (v << 4) | d
        n = n + 1
        i = i + 1
    }
    if n == 0 {
        return BAD
    }
    return v
}

fn parse_hex(p: u64) -> u64 {
    var at: u64 = 0
    if byte_at(p) == 48 && (byte_at(p + 1) == 120 || byte_at(p + 1) == 88) {
        at = 2
    }
    return parse_hex_at(p, at, ulib.length(p))
}

fn find_char(p: u64, c: u64) -> u64 {
    var i: u64 = 0
    while byte_at(p + i) != 0 {
        if byte_at(p + i) == c {
            return i
        }
        i = i + 1
    }
    return BAD
}

fn parse_bdf(p: u64) -> u64 {
    let colon: u64 = find_char(p, 58)
    let dot: u64 = find_char(p, 46)
    let end: u64 = ulib.length(p)
    if colon == BAD || dot == BAD || dot < colon || dot + 2 != end {
        return BAD
    }
    let bus: u64 = parse_hex_at(p, 0, colon)
    let dev: u64 = parse_hex_at(p, colon + 1, dot)
    let fun: u64 = parse_hex_at(p, dot + 1, end)
    if bus == BAD || dev == BAD || fun == BAD || bus > 255 || dev > 31 || fun > 7 {
        return BAD
    }
    return (bus << 8) | (dev << 3) | fun
}

fn is_flag(p: u64) -> bool {
    return byte_at(p) == 45 && byte_at(p + 1) != 0
}

fn positional(args: u64, n: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    var seen: u64 = 0
    var k: u64 = 1
    while k < argc {
        let a: u64 = ulib.arg_at(args, k)
        if !is_flag(a) {
            if seen == n {
                return a
            }
            seen = seen + 1
        }
        k = k + 1
    }
    return 0
}

fn has_flag(args: u64, name: u64) -> bool {
    let argc: u64 = ulib.arg_count(args)
    var k: u64 = 1
    while k < argc {
        if ulib.streq(ulib.arg_at(args, k), name) {
            return true
        }
        k = k + 1
    }
    return false
}

fn put_bytes(buf: u64, base: u64, len: u64) {
    var i: u64 = 0
    while i < len {
        if (i & 15) == 0 {
            if i != 0 {
                tools.ob_nl()
            }
            put_hex(base + i, 2)
            tools.ob_byte(58)
        }
        tools.ob_byte(32)
        put_hex(byte_at(buf + i), 2)
        i = i + 1
    }
    tools.ob_nl()
}

fn put_dwords(bar: u64, base: u64, buf: u64, count: u64) {
    var s_bar: [u8; 4] = "bar\0"
    var s_plus: [u8; 2] = "+\0"
    var i: u64 = 0
    while i < count {
        if (i & 3) == 0 {
            if i != 0 {
                tools.ob_nl()
            }
            tools.ob_str((&s_bar[0 as usize]) as u64)
            tools.ob_num(bar)
            tools.ob_str((&s_plus[0 as usize]) as u64)
            put_hex(base + i * 4, 8)
            tools.ob_byte(58)
        }
        tools.ob_byte(32)
        put_hex(dword_at(buf + i * 4), 8)
        i = i + 1
    }
    tools.ob_nl()
}
