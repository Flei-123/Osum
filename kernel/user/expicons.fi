profile kernel

import ulib
import symvar
import appreg

export { slot, pick, folder_for, folder_pick, FOLDER, DESKTOP, DOCUMENTS, DOWNLOADS, PICTURES, MUSIC, VIDEOS, DRIVE, USB, HOME, PIN, QUICKACCESS, GALLERY }

const FOLDER: u64 = 0
const DESKTOP: u64 = 1
const DOCUMENTS: u64 = 2
const DOWNLOADS: u64 = 3
const PICTURES: u64 = 4
const MUSIC: u64 = 5
const VIDEOS: u64 = 6
const DRIVE: u64 = 7
const USB: u64 = 8
const HOME: u64 = 9
const PIN: u64 = 10
const QUICKACCESS: u64 = 11
const GALLERY: u64 = 12
const COUNT: u64 = 13
const STATE_NEW: u8 = 0
const STATE_OK: u8 = 1
const STATE_MISSING: u8 = 2

static mut s_data: [u8; 583700] = [0 as u8; 583700]
static mut s_state: [u8; 13] = [0 as u8; 13]
static mut s_id: [u8; 24] = [0 as u8; 24]
static mut p_prefix: [u8; 5] = "fxi-\0"
static mut p_folder: [u8; 7] = "folder\0"
static mut p_desktop: [u8; 8] = "desktop\0"
static mut p_documents: [u8; 10] = "documents\0"
static mut p_downloads: [u8; 10] = "downloads\0"
static mut p_pictures: [u8; 9] = "pictures\0"
static mut p_music: [u8; 6] = "music\0"
static mut p_videos: [u8; 7] = "videos\0"
static mut p_drive: [u8; 6] = "drive\0"
static mut p_usb: [u8; 4] = "usb\0"
static mut p_home: [u8; 5] = "home\0"
static mut p_pin: [u8; 4] = "pin\0"
static mut p_quickaccess: [u8; 12] = "quickaccess\0"
static mut p_gallery: [u8; 8] = "gallery\0"

fn name_ptr(i: u64) -> u64 {
    if i == FOLDER {
        return (&p_folder[0 as usize]) as u64
    }
    if i == DESKTOP {
        return (&p_desktop[0 as usize]) as u64
    }
    if i == DOCUMENTS {
        return (&p_documents[0 as usize]) as u64
    }
    if i == DOWNLOADS {
        return (&p_downloads[0 as usize]) as u64
    }
    if i == PICTURES {
        return (&p_pictures[0 as usize]) as u64
    }
    if i == MUSIC {
        return (&p_music[0 as usize]) as u64
    }
    if i == VIDEOS {
        return (&p_videos[0 as usize]) as u64
    }
    if i == DRIVE {
        return (&p_drive[0 as usize]) as u64
    }
    if i == USB {
        return (&p_usb[0 as usize]) as u64
    }
    if i == HOME {
        return (&p_home[0 as usize]) as u64
    }
    if i == PIN {
        return (&p_pin[0 as usize]) as u64
    }
    if i == QUICKACCESS {
        return (&p_quickaccess[0 as usize]) as u64
    }
    if i == GALLERY {
        return (&p_gallery[0 as usize]) as u64
    }
    return 0
}

fn slot_ptr(i: u64) -> u64 {
    return (&s_data[0 as usize]) as u64 + i * symvar.SLOT_BYTES
}

fn load(i: u64) -> bool {
    ulib.strcpy((&s_id[0 as usize]) as u64, (&p_prefix[0 as usize]) as u64)
    ulib.strcat((&s_id[0 as usize]) as u64, name_ptr(i))
    let got: u64 = appreg.symbol_for((&s_id[0 as usize]) as u64, slot_ptr(i))
    if !symvar.joined_ok(slot_ptr(i), got) {
        return false
    }
    symvar.register(slot_ptr(i), got)
    return true
}

fn slot(i: u64) -> u64 {
    if i >= COUNT {
        return 0
    }
    if s_state[i as usize] == STATE_NEW {
        if load(i) {
            s_state[i as usize] = STATE_OK
        } else {
            s_state[i as usize] = STATE_MISSING
        }
    }
    if s_state[i as usize] == STATE_OK {
        return slot_ptr(i)
    }
    return 0
}

fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

fn name_is(name: u64, want: u64) -> bool {
    var k: u64 = 0
    while true {
        let a: u8 = lower(__mmio_read8((name + k) as *mut u8))
        let b: u8 = __mmio_read8((want + k) as *mut u8)
        if a != b {
            return false
        }
        if a == 0 as u8 {
            return true
        }
        k = k + 1
    }
    return false
}

static mut p_german_desktop: [u8; 13] = "schreibtisch\0"
static mut p_german_documents: [u8; 10] = "dokumente\0"
static mut p_german_pictures: [u8; 7] = "bilder\0"
static mut p_german_music: [u8; 6] = "musik\0"

fn folder_index(name: u64) -> u64 {
    if name_is(name, (&p_desktop[0 as usize]) as u64) || name_is(name, (&p_german_desktop[0 as usize]) as u64) {
        return DESKTOP
    }
    if name_is(name, (&p_documents[0 as usize]) as u64) || name_is(name, (&p_german_documents[0 as usize]) as u64) {
        return DOCUMENTS
    }
    if name_is(name, (&p_downloads[0 as usize]) as u64) {
        return DOWNLOADS
    }
    if name_is(name, (&p_pictures[0 as usize]) as u64) || name_is(name, (&p_german_pictures[0 as usize]) as u64) {
        return PICTURES
    }
    if name_is(name, (&p_music[0 as usize]) as u64) || name_is(name, (&p_german_music[0 as usize]) as u64) {
        return MUSIC
    }
    if name_is(name, (&p_videos[0 as usize]) as u64) {
        return VIDEOS
    }
    return FOLDER
}

fn folder_for(name: u64) -> u64 {
    return slot(folder_index(name))
}

fn pick(i: u64, fallback: u64) -> u64 {
    let s: u64 = slot(i)
    if s != 0 {
        return s
    }
    return fallback
}

fn folder_pick(name: u64, fallback: u64) -> u64 {
    let s: u64 = folder_for(name)
    if s != 0 {
        return s
    }
    return fallback
}
