profile kernel

import codec.h264b

export { poc_reset, poc_decode, poc_note_reference }

static mut prev_msb: i64 = 0
static mut prev_lsb: i64 = 0
static mut cur_msb: i64 = 0
static mut cur_lsb: i64 = 0

fn poc_reset() {
    prev_msb = 0
    prev_lsb = 0
    cur_msb = 0
    cur_lsb = 0
}

fn poc_decode(idr: bool, lsb: u64, log2_max_lsb: u64, delta_bottom: i64) -> i64 {
    if idr {
        prev_msb = 0
        prev_lsb = 0
    }
    let max_lsb: i64 = (1 << log2_max_lsb) as i64
    cur_lsb = lsb as i64
    cur_msb = h264b.poc_msb(prev_msb, prev_lsb, cur_lsb, max_lsb)
    var poc: i64 = cur_msb + cur_lsb
    if delta_bottom < 0 { poc = poc + delta_bottom }
    return poc
}

fn poc_note_reference() {
    prev_msb = cur_msb
    prev_lsb = cur_lsb
}
