profile kernel

export { NO_SLOT, dpb_reset, dpb_hold, dpb_busy, dpb_count, dpb_pop, dpb_tag }

const NO_SLOT: u64 = 0xFFFFFFFF
const DPB_MAX: u64 = 8

static mut waiting: [u8; 8] = [0 as u8; 8]
static mut epoch_of: [u64; 8] = [0; 8]
static mut poc_of: [i64; 8] = [0; 8]
static mut tag_of: [u64; 8] = [0; 8]

fn dpb_reset() {
    var i: u64 = 0
    while i < DPB_MAX {
        waiting[(i) as usize] = 0 as u8
        i = i + 1
    }
}

fn dpb_hold(slot: u64, epoch: u64, poc: i64, tag: u64) {
    waiting[(slot) as usize] = 1 as u8
    epoch_of[(slot) as usize] = epoch
    poc_of[(slot) as usize] = poc
    tag_of[(slot) as usize] = tag
}

fn dpb_busy(slot: u64) -> bool {
    return waiting[(slot) as usize] != (0 as u8)
}

fn dpb_count() -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < DPB_MAX {
        if waiting[(i) as usize] != (0 as u8) { n = n + 1 }
        i = i + 1
    }
    return n
}

fn before(a: u64, b: u64) -> bool {
    if epoch_of[(a) as usize] != epoch_of[(b) as usize] {
        return epoch_of[(a) as usize] < epoch_of[(b) as usize]
    }
    return poc_of[(a) as usize] < poc_of[(b) as usize]
}

fn dpb_pop(reorder: u64, cur_epoch: u64) -> u64 {
    var best: u64 = NO_SLOT
    var i: u64 = 0
    while i < DPB_MAX {
        if waiting[(i) as usize] != (0 as u8) {
            if best == NO_SLOT || before(i, best) { best = i }
        }
        i = i + 1
    }
    if best == NO_SLOT { return NO_SLOT }
    if dpb_count() <= reorder && epoch_of[(best) as usize] >= cur_epoch { return NO_SLOT }
    waiting[(best) as usize] = 0 as u8
    return best
}

fn dpb_tag(slot: u64) -> u64 { return tag_of[(slot) as usize] }
