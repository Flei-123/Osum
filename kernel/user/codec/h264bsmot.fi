profile kernel

export { bsmot_set, bsmot_strength, BSMOT_NONE }

const BSMOT_NONE: u64 = 0xFFFF
const MV_LIMIT: i64 = 4

static mut side_pic: [u64; 4] = [0; 4]
static mut side_mvx: [i64; 4] = [0; 4]
static mut side_mvy: [i64; 4] = [0; 4]

fn bsmot_set(side: u64, pic0: u64, pic1: u64, mvx0: i64, mvy0: i64, mvx1: i64, mvy1: i64) {
    let k: u64 = side * 2
    side_pic[(k) as usize] = pic0
    side_pic[((k + 1)) as usize] = pic1
    side_mvx[(k) as usize] = mvx0
    side_mvy[(k) as usize] = mvy0
    side_mvx[((k + 1)) as usize] = mvx1
    side_mvy[((k + 1)) as usize] = mvy1
}

fn far_pair(lp: u64, lq: u64) -> bool {
    var dx: i64 = side_mvx[(lp) as usize] - side_mvx[((2 + lq)) as usize]
    var dy: i64 = side_mvy[(lp) as usize] - side_mvy[((2 + lq)) as usize]
    if dx < 0 { dx = 0 - dx }
    if dy < 0 { dy = 0 - dy }
    return dx >= MV_LIMIT || dy >= MV_LIMIT
}

fn count_refs(a: u64, b: u64) -> u64 {
    var n: u64 = 0
    if a != BSMOT_NONE { n = n + 1 }
    if b != BSMOT_NONE { n = n + 1 }
    return n
}

fn single_strength(p0: u64, p1: u64, q0: u64, q1: u64) -> u64 {
    var lp: u64 = 0
    var pp: u64 = p0
    if p0 == BSMOT_NONE { lp = 1; pp = p1 }
    var lq: u64 = 0
    var qq: u64 = q0
    if q0 == BSMOT_NONE { lq = 1; qq = q1 }
    if pp != qq { return 1 }
    if far_pair(lp, lq) { return 1 }
    return 0
}

fn bsmot_strength() -> u64 {
    let p0: u64 = side_pic[(0) as usize]
    let p1: u64 = side_pic[(1) as usize]
    let q0: u64 = side_pic[(2) as usize]
    let q1: u64 = side_pic[(3) as usize]
    let np: u64 = count_refs(p0, p1)
    if np != count_refs(q0, q1) { return 1 }
    if np == 0 { return 0 }
    if np == 1 { return single_strength(p0, p1, q0, q1) }
    let straight: bool = p0 == q0 && p1 == q1
    let crossed: bool = p0 == q1 && p1 == q0
    if !straight && !crossed { return 1 }
    if p0 != p1 {
        if straight {
            if far_pair(0, 0) || far_pair(1, 1) { return 1 }
        } else {
            if far_pair(0, 1) || far_pair(1, 0) { return 1 }
        }
        return 0
    }
    let straight_far: bool = far_pair(0, 0) || far_pair(1, 1)
    let crossed_far: bool = far_pair(0, 1) || far_pair(1, 0)
    if straight_far && crossed_far { return 1 }
    return 0
}
