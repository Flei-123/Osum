profile kernel

export { col_set, col_zero_at, col_flag, min_positive }

const COL_PER_SLOT: u64 = 57600
const MV_NEAR: i64 = 1

static mut slot_col: [u8; 403200] = [0 as u8; 403200]

fn near_zero(vx: i64, vy: i64) -> bool {
    return vx >= 0 - MV_NEAR && vx <= MV_NEAR && vy >= 0 - MV_NEAR && vy <= MV_NEAR
}

fn col_flag(ref_idx: i64, vx: i64, vy: i64) -> bool {
    return ref_idx == 0 && near_zero(vx, vy)
}

fn col_set(slot: u64, i: u64, z: bool) {
    if z { slot_col[((slot * COL_PER_SLOT + i)) as usize] = 1 as u8 }
    else { slot_col[((slot * COL_PER_SLOT + i)) as usize] = 0 as u8 }
}

fn col_zero_at(slot: u64, mb: u64, bx: u64, by: u64, inference8x8: bool) -> bool {
    var cx: u64 = bx
    var cy: u64 = by
    if inference8x8 {
        cx = (bx >> 1) * 3
        cy = (by >> 1) * 3
    }
    return slot_col[((slot * COL_PER_SLOT + mb * 16 + cy * 4 + cx)) as usize] != (0 as u8)
}

fn min_positive(a: i64, b: i64) -> i64 {
    if a >= 0 && b >= 0 {
        if a < b { return a }
        return b
    }
    if a > b { return a }
    return b
}
