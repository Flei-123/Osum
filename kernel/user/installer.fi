static mut m_args: [u8; 18] = "installer: argc=\0\0"
static mut m_wo: [u8; 16] = "installer: bei=\0"
static mut m_esp: [u8; 16] = "installer: esp=\0"
// RUNDE DUALBOOT. Wie alle Mitschnitte: auf der seriellen Leitung, nie
// auf dem Schirm, und deshalb als Literal und nicht im Katalog.
static mut m_d_weg: [u8; 16] = "installer: weg=\0"
static mut m_d_tafel: [u8; 18] = "installer: tafel=\0"
static mut m_d_part: [u8; 17] = "installer: part \0"
static mut m_d_frei: [u8; 17] = "installer: frei \0"
static mut m_d_espi: [u8; 21] = "installer: fremdesp=\0"
static mut m_d_neu: [u8; 20] = "installer: neuepart\0"
static mut m_d_nein: [u8; 21] = "installer: NEBENNEIN\0"
static mut m_d_dir: [u8; 17] = "installer: dir=\0\0"
static mut m_d_menue: [u8; 19] = "installer: menue=\0\0"

// Die Schalter dieses Programms.
static mut m_luft: [u8; 2] = " \0"
static mut a_nohit: [u8; 6] = "nohit\0"
static mut a_zeig: [u8; 5] = "zeig\0"
static mut a_ja: [u8; 8] = "sofort\0\0"
// NUR FUER DEN LAEUFER: die ZWEITE Platte der Liste nehmen. Ein Mensch
// klickt die Zeile an -- das ist derselbe Weg durch denselben Code, nur
// ohne Maus. Gebraucht wird er fuer tools/install/zweiplatten.sh, den
// Lauf, der prueft, dass eine Installation auf die zweite Platte die
// erste nicht anfasst.
static mut a_zwei: [u8; 8] = "zweite\0\0"
// NUR FUER DEN LAEUFER: den Reiter "daneben" waehlen. Ein Mensch klickt
// den Reiter an -- das ist derselbe Weg durch denselben Code, nur ohne
// Maus. Gebraucht wird er fuer tools/dual/abnahme.sh.
static mut a_neben: [u8; 8] = "daneben\0"

// ------------------------------------------------------- Kleinigkeiten

fn ptr(p: u64) -> u64 {
    return p
}

fn say(p: u64) {
    ulib.say(p)
}

// Ein Leerzeichen auf die serielle Leitung. `ulib.put` schreibt einen
// PUFFER und kein Zeichen -- das ist der Unterschied, an dem der erste
// Uebersetzungslauf dieser Datei gescheitert ist.
fn luft() {
    ulib.say(ptr((&m_luft[0 as usize]) as u64))
}

fn nptr(i: u64) -> u64 {
    return (&p_name[0 as usize]) as u64 + i * 16
}

// Eine Zahl in Mebioktetten, damit in der Spalte "Groesse" eine Zahl
// steht, die ein Mensch liest. Sektoren zu 512 Oktetten: /2048.
fn mib_of(sekt: u64) -> u64 {
    return sekt / 2048
}

// ---------------------------------------------------- Texte zusammenbauen
//
// Ein eigener kleiner Schreiber statt `sprintf`: die Sprache hat keinen,
// und ein Puffer, der an einer Stelle waechst, ist leichter zu pruefen
// als einer, der an fuenf Stellen beschrieben wird.

static mut bp: u64 = 0
static mut bziel: u64 = 0
static mut bmax: u64 = 0

fn b_start(ziel: u64, max: u64) {
    bziel = ziel
    bmax = max
    bp = 0
    ulib.fill(ziel, 0, max)
}

fn b_c(c: u64) {
    if bp + 1 < bmax {
        __mmio_write8((bziel + bp) as *mut u8, c as u8)
        bp = bp + 1
    }
}

fn b_s(p: u64) {
    var i: u64 = 0
    while (*((p + i) as *mut u8)) as u64 != 0 {
        b_c((*((p + i) as *mut u8)) as u64)
        i = i + 1
    }
}

fn b_n(v: u64) {
    if v >= 10 {
        b_n(v / 10)
    }
    b_c(48 + (v % 10))
}

fn b_ende() {
    if bp < bmax {
        __mmio_write8((bziel + bp) as *mut u8, 0 as u8)
    }
}

// ------------------------------------------------------ die Platten finden
//
// WAS EINE PLATTE HIER IST: eine Datei unter /dev/, die sich oeffnen
// laesst und eine Groesse hat. Mehr braucht es nicht -- seit K14 ist
// `/dev/hda` ein Blockgeraet mit `lseek`, und `size_of` liefert die
// Groesse ueber `SEEK_END`. Das ist dieselbe Quelle, aus der
// `install.fi` seine Zahl nimmt.
//
// WAS SCHON DARAUFLIEGT: die Zahl der Partitionen. Sie wird hier NICHT
// selbst aus der Tafel gelesen -- das taete `part.fi` im Kern schon,
// und ein zweiter GPT-Leser in Ring 3 waere die zweite Stelle, an der
// dieselbe Beschreibung steht. Gelesen wird der Schutz-MBR: steht dort
// eine gueltige Signatur, war die Platte nicht leer. Das ist weniger
// Auskunft als eine volle Partitionsliste und dafuer eine, die nicht
// luegen kann.
fn ist_leer(dev: u64) -> bool {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, dev, 0, 0)
    if ulib.bad(fd) {
        return true
    }
    var leer: bool = true
    if instkern.lese(fd, 0, (&tblob[0 as usize]) as u64, 512) {
        let p: u64 = (&tblob[0 as usize]) as u64
        let s1: u64 = (*((p + 510) as *mut u8)) as u64
        let s2: u64 = (*((p + 511) as *mut u8)) as u64
        if s1 == 0x55 && s2 == 0xAA {
            leer = false
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return leer
}

fn platte_dazu(dev: u64) {
    if p_anz >= MAXP {
        return
    }
    let n: u64 = ulib.size_of(dev)
    if ulib.bad(n) || n == 0 {
        return
    }
    // ============================ EINE GROESSE IST NOCH KEINE PLATTE
    //
    // GEMESSEN, nicht vermutet: auf einer Maschine ohne NVMe-Regler
    // sagt die serielle Leitung "nvme: skipped" -- und `/dev/nvme0`
    // meldet TROTZDEM eine Groesse (65536 Sektoren). Der Grund steht
    // in `kernel/devfs.fi`: A_SIZE gibt `blk.blocks_on(...) * BS`
    // zurueck, und das ist die Zahl, die der Blockschicht
    // eingetragen ist -- nicht die Antwort eines Geraets.
    //
    // Eine Platte, die es nicht gibt, in der Liste anzubieten, ist bei
    // diesem Programm kein Schoenheitsfehler: sie waere anklickbar,
    // und was dann passiert, ist eine Installation ins Leere. In der
    // Abnahme dieser Runde hat genau dieser Geistereintrag ausserdem
    // die Zahl der gefundenen Platten von 1 auf 2 gehoben und damit
    // die Vorauswahl verhindert.
    //
    // Also wird GELESEN. Ein Geraet, dessen erster Sektor sich nicht
    // lesen laesst, steht nicht in der Liste -- das ist dieselbe
    // Auskunft, die auch `install.fi` bekommt, wenn es anfaengt zu
    // arbeiten, nur eben vorher.
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, dev, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let geht: bool = instkern.lese(fd, 0, (&tblob[0 as usize]) as u64, 512)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if !geht {
        return
    }
    ulib.strcpy(nptr(p_anz), dev)
    p_sekt[(p_anz) as usize] = n / instkern.BS
    if ist_leer(dev) {
        p_parts[(p_anz) as usize] = 0
    } else {
        p_parts[(p_anz) as usize] = 1
    }
    say(ptr((&m_disk[0 as usize]) as u64))
    say(dev)
    luft()
    ulib.sayu(p_sekt[(p_anz) as usize])
    ulib.nl()
    p_anz = p_anz + 1
}

fn platten_suchen() {
    p_anz = 0
    platte_dazu(ptr((&d_hda[0 as usize]) as u64))
    platte_dazu(ptr((&d_hdb[0 as usize]) as u64))
    platte_dazu(ptr((&d_nvme[0 as usize]) as u64))
}

// ---------------------------------------------------- die Tabelle bauen
//
// Eine Zeile je Platte: Geraet, Modell, Groesse, was darauf ist.
//
// DAS "MODELL" IST HIER DIE ART DES ANSCHLUSSES und nicht die
// Typenbezeichnung aus IDENTIFY. Der Grund ist Ehrlichkeit: dieses
// Programm hat den IDENTIFY-Block nicht, und eine erfundene
// Modellbezeichnung waere schlimmer als keine. Was es weiss, ist, ueber
// welchen Treiber das Geraet kommt -- und das steht im Namen.
fn tabelle_bauen() {
    b_start((&tblob[0 as usize]) as u64, 1024)
    // ============================================ DIE KOPFZEILE ZUERST
    //
    // ZEILE 0 DES BLOCKS IST DIE BESCHRIFTUNG -- das ist keine
    // Verzierung, sondern das Modell von `wlib.table`: `paint_table`
    // liest `row_at(text, 0)` als Kopf und rechnet die Spaltenbreiten
    // daraus.
    //
    // Fehlt sie, faellt `row_at` auf 0 zurueck, `row_len(0)` liest an
    // Adresse null, und das Programm STIRBT. Genau das ist in dieser
    // Runde passiert und stand so auf der Leitung:
    //
    //     user fault: pid=4 vector=14 err=0x5 cr2=0x0
    //                 rip=0x4012a925   (= wlib.row_len)
    //
    // Im Fenster war davon nichts zu sehen ausser einer leeren
    // Flaeche -- der Fensterserver malt den Rahmen, und der Prozess
    // dahinter war schon tot. Ein Fehler, den nur das Foto und die
    // serielle Leitung zusammen zeigen.
    b_s(msg.get(ptr((&k_cols[0 as usize]) as u64)))
    b_c(10)
    var i: u64 = 0
    while i < p_anz {
        b_s(nptr(i))
        b_c(9)
        // Die Art: aus dem Namen abgeleitet, nicht erfunden.
        let nm: u64 = nptr(i)
        if (*((nm + 5) as *mut u8)) as u64 == 110 {
            b_c(78) // 'N'
            b_c(86) // 'V'
            b_c(77) // 'M'
            b_c(101) // 'e'
        } else {
            b_c(65) // 'A'
            b_c(84) // 'T'
            b_c(65) // 'A'
        }
        b_c(9)
        b_n(mib_of(p_sekt[(i) as usize]))
        b_c(32)
        b_c(77) // 'M'
        b_c(105) // 'i'
        b_c(66) // 'B'
        b_c(9)
        if p_parts[(i) as usize] == 0 {
            b_s(msg.get(ptr((&k_empty[0 as usize]) as u64)))
        } else {
            b_s(msg.get(ptr((&k_parts[0 as usize]) as u64)))
        }
        b_c(10)
        i = i + 1
    }
    b_ende()
}

// ================================================== RUNDE DUALBOOT
//
// DIE TAFEL DER GEWAEHLTEN PLATTE LESEN UND ZEIGEN.
//
// Das ist Stueck 1 des Auftrags: SEHEN, was da ist. Gelesen wird mit
// `dualkern.tafel_lesen`, und das prueft BEIDE Pruefsummen, bevor es
// einen Eintrag glaubt -- genau wie `part.fi` im Kern. Eine Tafel,
// deren CRC nicht stimmt, wird hier nicht angezeigt und erst recht
// nicht ergaenzt.
//
// Danach steht fest, ob der Weg "daneben" auf dieser Platte ueberhaupt
// offen ist. Drei Dinge muessen zusammenkommen:
//
//   1. eine gueltige GPT,
//   2. ein freier Bereich, der gross genug ist,
//   3. eine vorhandene EFI-Systempartition, die gross genug ist.
//
// Fehlt eines davon, sagt das Fenster WELCHES -- und bietet den Weg
// "ganze Platte" an, statt zu tricksen.
fn tafel_holen(dev: u64) {
    d_gelesen = 0
    d_moeglich = 0
    d_frei_von = 0
    d_frei_bis = 0
    d_esp_idx = 0xFFFFFFFFFFFFFFFF
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, dev, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let sekt: u64 = ulib.size_of(dev) / instkern.BS
    let n: u64 = dualkern.tafel_lesen(fd, sekt)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    say(ptr((&m_d_tafel[0 as usize]) as u64))
    ulib.sayu(n)
    luft()
    ulib.sayu(dualkern.grund())
    ulib.nl()
    d_gelesen = 1
    if !dualkern.gpt_pruefen() {
        return
    }
    // Jede gefundene Partition auf die Leitung -- damit eine Messung
    // sieht, WAS gelesen wurde, und nicht nur, dass gelesen wurde.
    var i: u64 = 0
    while i < n {
        say(ptr((&m_d_part[0 as usize]) as u64))
        ulib.sayu(i + 1)
        luft()
        ulib.sayu(dualkern.p_start(i))
        luft()
        ulib.sayu(dualkern.p_ende(i))
        luft()
        ulib.sayu(dualkern.p_typ(i))
        ulib.nl()
        i = i + 1
    }
    // Der freie Platz.
    if dualkern.luecke_suchen(65536) {
        d_frei_von = dualkern.luecke_start()
        d_frei_bis = dualkern.luecke_ende()
        say(ptr((&m_d_frei[0 as usize]) as u64))
        ulib.sayu(d_frei_von)
        luft()
        ulib.sayu(d_frei_bis)
        ulib.nl()
    } else {
        return
    }
    // Die fremde EFI-Partition.
    let e: u64 = dualkern.esp_finden()
    if e >= dualkern.anz() {
        return
    }
    if !dualkern.esp_gross_genug(e) {
        return
    }
    d_esp_idx = e
    say(ptr((&m_d_espi[0 as usize]) as u64))
    ulib.sayu(e + 1)
    ulib.nl()
    d_moeglich = 1
}

// Der Name einer Art, aus dem Katalog.
fn art_text(t: u64) -> u64 {
    if t == dualkern.T_ESP {
        return msg.get(ptr((&k_a_esp[0 as usize]) as u64))
    }
    if t == dualkern.T_DATEN {
        return msg.get(ptr((&k_a_daten[0 as usize]) as u64))
    }
    if t == dualkern.T_LINUX {
        return msg.get(ptr((&k_a_linux[0 as usize]) as u64))
    }
    if t == dualkern.T_OSUM {
        return msg.get(ptr((&k_a_osum[0 as usize]) as u64))
    }
    return msg.get(ptr((&k_a_unb[0 as usize]) as u64))
}

// DIE PARTITIONSANSICHT. Eine Zeile je vorhandener Partition, und
// dahinter EINE Zeile fuer den freien Platz -- der ist das, worum es
// auf diesem Reiter geht, und er muss zu sehen sein.
fn ptabelle_bauen() {
    b_start((&pblob[0 as usize]) as u64, 1024)
    b_s(msg.get(ptr((&k_d_cols[0 as usize]) as u64)))
    b_c(10)
    if d_gelesen == 0 || !dualkern.gpt_pruefen() {
        b_ende()
        return
    }
    let n: u64 = dualkern.anz()
    var i: u64 = 0
    while i < n {
        b_n(i + 1)
        b_c(9)
        b_n(dualkern.p_start(i))
        b_c(9)
        b_n((dualkern.p_ende(i) - dualkern.p_start(i) + 1) / 2048)
        b_c(32)
        b_c(77) // 'M'
        b_c(105) // 'i'
        b_c(66) // 'B'
        b_c(9)
        b_s(art_text(dualkern.p_typ(i)))
        b_c(9)
        // Der Name aus der Tafel, Zeichen fuer Zeichen.
        var k: u64 = 0
        var weiter: bool = true
        while k < 35 && weiter {
            let ch: u64 = dualkern.p_name_ch(i, k)
            if ch == 0 {
                weiter = false
            } else {
                b_c(ch)
                k = k + 1
            }
        }
        b_c(10)
        i = i + 1
    }
    // DER FREIE PLATZ als eigene Zeile. Ohne ihn zeigt die Ansicht,
    // was belegt ist, und verschweigt ausgerechnet das, wonach der
    // Mensch auf diesem Reiter sucht.
    if d_frei_bis > d_frei_von {
        b_c(45) // '-'
        b_c(9)
        b_n(d_frei_von)
        b_c(9)
        b_n((d_frei_bis - d_frei_von + 1) / 2048)
        b_c(32)
        b_c(77)
        b_c(105)
        b_c(66)
        b_c(9)
        b_s(msg.get(ptr((&k_a_frei[0 as usize]) as u64)))
        b_c(9)
        b_c(10)
    }
    b_ende()
}

// Die beiden Zeilen unter der Partitionsansicht: was mit dem freien
// Platz passiert, und welche EFI-Partition mitbenutzt wird.
fn dzeilen_bauen() {
    b_start((&freizeile[0 as usize]) as u64, 200)
    if d_gelesen == 0 {
        b_ende()
    } else if !dualkern.gpt_pruefen() {
        let g: u64 = dualkern.grund()
        if g == dualkern.D_KEINEGPT {
            b_s(msg.get(ptr((&k_d_gkeine[0 as usize]) as u64)))
        } else {
            b_s(msg.get(ptr((&k_d_gkaputt[0 as usize]) as u64)))
        }
        b_c(32)
        b_s(msg.get(ptr((&k_d_espweg[0 as usize]) as u64)))
        b_ende()
    } else if d_frei_bis <= d_frei_von {
        b_s(msg.get(ptr((&k_d_fkein[0 as usize]) as u64)))
        b_c(32)
        b_s(msg.get(ptr((&k_d_fmehr[0 as usize]) as u64)))
        b_ende()
    } else {
        b_s(msg.get(ptr((&k_d_frei[0 as usize]) as u64)))
        b_c(32)
        b_n((d_frei_bis - d_frei_von + 1) / 2048)
        b_c(32)
        b_c(77)
        b_c(105)
        b_c(66)
        b_ende()
    }

    b_start((&espzeile[0 as usize]) as u64, 200)
    if d_gelesen == 0 || !dualkern.gpt_pruefen() {
        b_ende()
    } else if d_esp_idx >= dualkern.anz() {
        let g: u64 = dualkern.grund()
        if g == dualkern.D_ESPKLEIN {
            b_s(msg.get(ptr((&k_d_espkl[0 as usize]) as u64)))
        } else {
            b_s(msg.get(ptr((&k_d_espk[0 as usize]) as u64)))
        }
        b_c(32)
        b_s(msg.get(ptr((&k_d_espweg[0 as usize]) as u64)))
        b_ende()
    } else {
        b_s(msg.get(ptr((&k_d_espg[0 as usize]) as u64)))
        b_c(32)
        b_n(d_esp_idx + 1)
        b_c(32)
        b_c(45)
        b_c(45)
        b_c(32)
        b_s(msg.get(ptr((&k_d_nkeep[0 as usize]) as u64)))
        b_ende()
    }
}

// DARF DER KNOPF UEBERHAUPT AN SEIN?
//
// Auf dem Reiter "ganze Platte" reicht eine gewaehlte Platte. Auf dem
// Reiter "daneben" muessen ausserdem die drei Bedingungen erfuellt
// sein, die `tafel_holen` geprueft hat -- sonst ist der Knopf aus, und
// die Zeile darueber sagt, woran es liegt. Ein Knopf, der eine
// Fehlermeldung ausloest, die man vorher haette anzeigen koennen, ist
// eine Falle.
fn weg_moeglich() -> bool {
    if gewaehlt >= p_anz {
        return false
    }
    if welcher_weg == 1 {
        return d_moeglich == 1
    }
    return true
}

// Die Aufschrift des Knopfes. Sie sagt, was gleich passiert -- und auf
// den beiden Reitern passiert etwas Verschiedenes.
fn weg_knopftext() -> u64 {
    if welcher_weg == 1 {
        return msg.get(ptr((&k_d_go[0 as usize]) as u64))
    }
    return msg.get(ptr((&k_go[0 as usize]) as u64))
}

// Die Beschriftung der beiden Reiter. Zwei Woerter, durch einen
// Tabulator getrennt -- so liest `wlib.tabs` sie.
fn reiter_bauen() {
    b_start((&tabtext[0 as usize]) as u64, 80)
    b_s(msg.get(ptr((&k_d_tganz[0 as usize]) as u64)))
    b_c(9)
    b_s(msg.get(ptr((&k_d_tneben[0 as usize]) as u64)))
    b_ende()
}

// Die Statuszeile unter der Tabelle.
fn status_bauen() {
    b_start((&zeile[0 as usize]) as u64, 200)
    if p_anz == 0 {
        b_s(msg.get(ptr((&k_none[0 as usize]) as u64)))
    } else if laeuft != 0 {
        b_s(msg.get(ptr((&k_busy[0 as usize]) as u64)))
    } else if fertig != 0 {
        b_s(msg.get(ptr((&k_done[0 as usize]) as u64)))
        b_c(32)
        b_s(msg.get(ptr((&k_donehint[0 as usize]) as u64)))
    } else if gewaehlt >= p_anz {
        b_s(msg.get(ptr((&k_pick[0 as usize]) as u64)))
    } else {
        b_s(msg.get(ptr((&k_sel[0 as usize]) as u64)))
        b_c(32)
        b_s(nptr(gewaehlt))
        b_c(32)
        b_c(45)
        b_c(45)
        b_c(32)
        // DER WARNSATZ HAENGT AM WEG. "Alle Daten werden geloescht" ist
        // auf dem Reiter "daneben" schlicht FALSCH -- und eine falsche
        // Warnung ist schlimmer als keine: wer sie einmal als Unsinn
        // erkannt hat, liest die naechste nicht mehr.
        if welcher_weg == 1 {
            b_s(msg.get(ptr((&k_d_nhead[0 as usize]) as u64)))
        } else {
            b_s(msg.get(ptr((&k_warn[0 as usize]) as u64)))
        }
    }
    b_ende()
}

// Die Schrittzeile. Sie zeigt, WO die Maschine steht -- und beim
// Kopieren zusaetzlich, wie weit.
fn schritt_bauen() {
    b_start((&schrittzeile[0 as usize]) as u64, 200)
    let s: u64 = st_zeige
    if s == 0 {
        b_ende()
        return
    }
    b_n(s)
    b_c(47) // '/'
    b_n(instkern.schritt_von() - 1)
    b_c(32)
    if s == instkern.S_GPT {
        b_s(msg.get(ptr((&k_s_gpt[0 as usize]) as u64)))
    } else if s == instkern.S_ESP {
        b_s(msg.get(ptr((&k_s_esp[0 as usize]) as u64)))
    } else if s == instkern.S_KOPIE {
        b_s(msg.get(ptr((&k_s_copy[0 as usize]) as u64)))
        b_c(32)
        b_n(instkern.fortschritt() / 10)
        b_c(37) // '%'
    } else if s == instkern.S_WACHSEN {
        b_s(msg.get(ptr((&k_s_grow[0 as usize]) as u64)))
    } else if s == instkern.S_BOOT {
        b_s(msg.get(ptr((&k_s_boot[0 as usize]) as u64)))
    } else {
        b_s(msg.get(ptr((&k_done[0 as usize]) as u64)))
    }
    b_ende()
}

// ==================================================== DIE INSTALLATION
//
// Sie laeuft in EINEM Zug und nicht haeppchenweise zwischen zwei
// Ereignissen der Oberflaeche. Das ist eine bewusste Entscheidung und
// keine Bequemlichkeit:
//
//   Eine halb geschriebene Partitionstafel ist ein kaputter
//   Datentraeger. Wer das Schreiben in die Ereignisschleife haengt,
//   damit das Fenster waehrenddessen "reagiert", macht genau das
//   moeglich -- ein Klick auf "Schliessen" mitten zwischen GPT und
//   Wurzel, und die Platte startet nie wieder.
//
// Was das kostet, ist Ehrlichkeit wert: waehrend der Minuten, die das
// Kopieren dauert, nimmt dieses Fenster keine Klicks an. Deshalb steht
// vorher "bitte nicht ausschalten" da, und deshalb wird die Schrittzeile
// zwischen den Abschnitten gemalt -- nicht, damit es huebsch aussieht,
// sondern damit sichtbar ist, dass es noch lebt.
fn installieren(dev: u64, wstat: u64, wschritt: u64) -> bool {
    let zfd: u64 = ulib.sys(ulib.SYS_OPEN, dev, ulib.O_RDWR, 0)
    if ulib.bad(zfd) {
        return false
    }
    let qfd: u64 = ulib.sys(ulib.SYS_OPEN,
        ptr((&d_quelle[0 as usize]) as u64), 0, 0)
    if ulib.bad(qfd) {
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        return false
    }
    let sekt: u64 = ulib.size_of(dev) / instkern.BS
    let qsekt: u64 = ulib.size_of(ptr((&d_quelle[0 as usize]) as u64))
        / instkern.BS
    let espsek: u64 = instkern.ESP_STD

    if !instkern.plan_passt(sekt, espsek) {
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }
    if instkern.quelle_pruefen(qfd) == 0 {
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }

    // ---- 1. die Partitionstafel
    melde_schritt(wschritt, instkern.S_GPT)
    if !instkern.gpt_schreiben(zfd, sekt, espsek) {
        wo(1)
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }

    // ---- 2. die EFI-Partition
    melde_schritt(wschritt, instkern.S_ESP)
    if !instkern.fat32_create(zfd, instkern.plan_esp_start(), espsek) {
        wo(2)
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }

    // ---- 3. das System kopieren. Der lange Teil.
    melde_schritt(wschritt, instkern.S_KOPIE)
    if !instkern.wurzel_kopieren(zfd, qfd, espsek, qsekt) {
        wo(3)
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }

    // ---- 4. das Dateisystem auf die Partition vergroessern
    melde_schritt(wschritt, instkern.S_WACHSEN)
    let ofs_start: u64 = instkern.plan_ofs_start(espsek)
    let ofs_bloecke: u64 = instkern.plan_ofs_ende(sekt) - ofs_start + 1
    if instkern.wachsen(zfd, ofs_start, ofs_bloecke) == 0 {
        wo(4)
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)

    // ---- 5. der Bootlader auf die EFI-Partition
    melde_schritt(wschritt, instkern.S_BOOT)
    esp_name(dev)
    // Der gebaute Name auf der Leitung -- damit eine Messung sieht,
    // WELCHE Partition eingehaengt wird, und nicht nur, dass eine
    // eingehaengt wurde.
    say(ptr((&m_esp[0 as usize]) as u64))
    say(ptr((&d_esp[0 as usize]) as u64))
    ulib.nl()
    if !bootlader() {
        wo(5)
        return false
    }
    return true
}

// ================================================== RUNDE DUALBOOT
//
// DIE INSTALLATION NEBEN EIN VORHANDENES SYSTEM.
//
// Sie unterscheidet sich vom Weg "ganze Platte" in genau drei Punkten,
// und jeder davon ist der Grund, warum es diese Runde gibt:
//
//   1. STATT `gpt_schreiben` wird `neben_schreiben` gerufen. Die
//      vorhandene Tafel wird ERGAENZT, nicht ersetzt.
//   2. ES WIRD KEINE EFI-PARTITION ANGELEGT. Die vorhandene wird
//      mitbenutzt.
//   3. DAS BOOTMENUE bekommt einen zweiten Eintrag.
//
// Was GLEICH bleibt, bleibt mit Absicht gleich: das Kopieren der
// Wurzel und das Wachsenlassen sind dieselben Aufrufe in `instkern`.
// Eine zweite Umsetzung davon waere die zweite Stelle, an der
// dasselbe steht.
fn installieren_daneben(dev: u64, wstat: u64, wschritt: u64) -> bool {
    // ---- die Quelle zuerst. Ein Installationsprogramm, das erst eine
    // Tafel aendert und dann merkt, dass es nichts zu kopieren hat,
    // hat eine fremde Platte fuer nichts angefasst.
    let qfd: u64 = ulib.sys(ulib.SYS_OPEN,
        ptr((&d_quelle[0 as usize]) as u64), 0, 0)
    if ulib.bad(qfd) {
        wo(70)
        return false
    }
    if instkern.quelle_pruefen(qfd) == 0 {
        wo(71)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }
    let qsekt: u64 = ulib.size_of(ptr((&d_quelle[0 as usize]) as u64))
        / instkern.BS

    let zfd: u64 = ulib.sys(ulib.SYS_OPEN, dev, ulib.O_RDWR, 0)
    if ulib.bad(zfd) {
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        wo(72)
        return false
    }
    let sekt: u64 = ulib.size_of(dev) / instkern.BS

    // ---- DIE TAFEL NOCH EINMAL LESEN, unmittelbar vor dem Schreiben.
    //
    // Sie wurde beim Anklicken der Platte schon gelesen; das war aber
    // ein anderer Augenblick. Zwischen Ansicht und Knopfdruck kann ein
    // Wechseldatentraeger getauscht worden sein. Wer auf eine Tafel
    // schreibt, die er vor einer Minute gesehen hat, schreibt auf gut
    // Glueck.
    let n: u64 = dualkern.tafel_lesen(zfd, sekt)
    if n == 0 || !dualkern.gpt_pruefen() {
        wo(73)
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }
    if !dualkern.luecke_suchen(65536) {
        wo(74)
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }
    let von: u64 = dualkern.luecke_start()
    let bis: u64 = dualkern.luecke_ende()
    let espi: u64 = dualkern.esp_finden()
    if espi >= dualkern.anz() {
        wo(75)
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }
    if !dualkern.esp_gross_genug(espi) {
        wo(76)
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }
    // PASST DIE WURZEL UEBERHAUPT? Der freie Bereich muss das
    // aufnehmen, was kopiert werden soll. Sonst bricht es HIER ab --
    // vor dem ersten Schreibzugriff auf die fremde Tafel.
    if bis - von + 1 < qsekt {
        wo(77)
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }

    // ---- 1. den Eintrag in die fremde Tafel. AB HIER WIRD GESCHRIEBEN.
    melde_schritt(wschritt, instkern.S_GPT)
    let nr: u64 = dualkern.neben_schreiben(zfd, von, bis)
    if nr == 0 {
        wo(78)
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }
    d_neue_nr = nr
    say(ptr((&m_d_neu[0 as usize]) as u64))
    luft()
    ulib.sayu(nr)
    luft()
    ulib.sayu(von)
    luft()
    ulib.sayu(bis)
    ulib.nl()

    // ---- 2. das System kopieren. Der lange Teil.
    melde_schritt(wschritt, instkern.S_KOPIE)
    if !instkern.wurzel_kopieren_ab(zfd, qfd, von, qsekt) {
        wo(79)
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }

    // ---- 3. das Dateisystem auf den ganzen Bereich vergroessern.
    melde_schritt(wschritt, instkern.S_WACHSEN)
    if instkern.wachsen(zfd, von, bis - von + 1) == 0 {
        wo(80)
        ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)
        return false
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, zfd, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, qfd, 0, 0)

    // ---- 4. die Dateien in die FREMDE EFI-Partition, und das Menue.
    melde_schritt(wschritt, instkern.S_BOOT)
    // Der Name der fremden EFI-Partition: das Geraet plus ihre Nummer
    // aus der Tafel. NICHT "1" -- auf einer Platte mit Windows ist die
    // ESP zwar meist die erste, aber "meist" ist keine Zusage.
    esp_name_nr(dev, espi + 1)
    say(ptr((&m_esp[0 as usize]) as u64))
    say(ptr((&d_esp[0 as usize]) as u64))
    ulib.nl()
    if !bootlader_dual() {
        return false
    }
    return true
}

// AN WELCHER STELLE ES ABGEBROCHEN IST. `fehler_bei()` sagt, WAS
// schiefging (lesen, schreiben, kein OFS); diese Zahl sagt, WO. Ohne
// sie ist "installer: FEHLER 2" eine Auskunft, mit der niemand etwas
// anfangen kann -- gemessen in dieser Runde, wo die Installation
// vollstaendig auf der Platte stand und trotzdem als Fehler endete.
fn wo(n: u64) {
    say(ptr((&m_wo[0 as usize]) as u64))
    ulib.sayu(n)
    ulib.nl()
}

fn melde_schritt(wschritt: u64, nr: u64) {
    st_zeige = nr
    schritt_bauen()
    wlib.set_text(wschritt, (&schrittzeile[0 as usize]) as u64)
    wlib.draw_all()
    say(ptr((&m_step[0 as usize]) as u64))
    ulib.sayu(nr)
    luft()
    ulib.sayu(instkern.fortschritt())
    ulib.nl()
}

// Der Bootlader. AB HIER SIND ES GEWOEHNLICHE DATEIEN: die
// EFI-Partition wird eingehaengt, und was dann passiert, ist `mkdir`
// und `cp` -- der FAT32-Schreiber aus K14 macht die Arbeit.
static mut p_efi: [u8; 6] = "/efi\0\0"
static mut p_efi_efi: [u8; 10] = "/efi/EFI\0\0"
static mut p_efi_boot: [u8; 16] = "/efi/EFI/BOOT\0\0\0"
static mut p_efi_lim: [u8; 20] = "/efi/limine.conf\0\0\0\0"
static mut p_efi_kern: [u8; 16] = "/efi/osum.mb\0\0\0\0"
static mut p_efi_ldr: [u8; 28] = "/efi/EFI/BOOT/BOOTX64.EFI\0\0\0"
static mut p_src_lim: [u8; 20] = "/boot/limine.conf\0\0\0"
static mut p_src_kern: [u8; 16] = "/boot/osum.mb\0\0\0"
static mut p_src_ldr: [u8; 20] = "/boot/BOOTX64.EFI\0\0\0"
static mut t_vfat: [u8; 6] = "vfat\0\0"
// Der Name der EFI-Partition. Er wird GEBAUT und steht nicht fest:
// wer auf /dev/hdb installiert, braucht /dev/hdb1, und ein fest
// verdrahtetes /dev/hda1 haette dort GPT und Wurzel richtig
// geschrieben und danach die EFI-Partition einer FREMDEN Platte
// beschrieben. Das ist kein Schoenheitsfehler, sondern Datenverlust
// auf einem Datentraeger, den der Benutzer gar nicht genannt hat.
//
// Der Kern loest den Namen selbst auf: `source_dev` in kernel/sys.fi
// nimmt den Geraetenamen und die Ziffer dahinter als Partitionsnummer
// -- `/dev/hdb1` ist die erste Partition von `/dev/hdb`, genau wie
// `/dev/hda1` die von `/dev/hda`. Hier wird also nur die Ziffer
// angehaengt.
static mut d_esp: [u8; 24] = [0 as u8; 24]

// Der Inhalt der Startdatei. `vfs` ist Pflicht (sonst kein /dev),
// `gfx wm wig desk ...` ist der Schreibtisch, und `modfs` steht
// ABSICHTLICH nicht darin -- siehe oben.
static mut lim_text: [u8; 160] = "timeout: 3\n\n/OrientOS\n    protocol: multiboot1\n    path: boot():/osum.mb\n    cmdline: osum vfs gfx wm wig desk wmshell wmdauer herz tz=120 nosched noproc nofs\n\0"

fn startdatei() -> bool {
    ulib.sys(ulib.SYS_UNLINK, ptr((&p_efi_lim[0 as usize]) as u64), 0, 0)
    let f: u64 = ulib.sys(ulib.SYS_OPEN,
        ptr((&p_efi_lim[0 as usize]) as u64), ulib.O_MAKE, 0)
    if ulib.bad(f) {
        return false
    }
    let n: u64 = ulib.length(ptr((&lim_text[0 as usize]) as u64))
    let w: u64 = ulib.sys(ulib.SYS_WRITE, f,
        ptr((&lim_text[0 as usize]) as u64), n)
    ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
    if ulib.bad(w) || w != n {
        return false
    }
    return true
}

// DER NAME EINER BELIEBIGEN PARTITION DES GERAETS (Runde DUALBOOT).
//
// `esp_name` haengt immer eine 1 an -- richtig fuer den Weg "ganze
// Platte", wo dieses Programm die EFI-Partition selbst als erste
// angelegt hat. Auf einer fremden Platte ist die ESP aber die
// Partition, die in der TAFEL steht, und das kann die dritte sein.
//
// Mehr als neun Partitionen kann dieser Weg nicht benennen: `source_dev`
// in kernel/sys.fi liest GENAU EINE Ziffer hinter dem Geraetenamen.
// Wer eine Platte mit zehn Partitionen hat, bekommt hier die falsche --
// deshalb wird oben abgebrochen, statt zu raten.
fn esp_name_nr(dev: u64, nr: u64) {
    ulib.strcpy(ptr((&d_esp[0 as usize]) as u64), dev)
    let n: u64 = ulib.length(ptr((&d_esp[0 as usize]) as u64))
    if n + 2 < 24 && nr >= 1 && nr <= 9 {
        __mmio_write8((ptr((&d_esp[0 as usize]) as u64) + n) as *mut u8,
            (48 + nr) as u8)
        __mmio_write8((ptr((&d_esp[0 as usize]) as u64) + n + 1) as *mut u8,
            0 as u8)
    }
}

fn esp_name(dev: u64) {
    ulib.strcpy(ptr((&d_esp[0 as usize]) as u64), dev)
    let n: u64 = ulib.length(ptr((&d_esp[0 as usize]) as u64))
    if n + 2 < 24 {
        __mmio_write8((ptr((&d_esp[0 as usize]) as u64) + n) as *mut u8, 49 as u8)
        __mmio_write8((ptr((&d_esp[0 as usize]) as u64) + n + 1) as *mut u8, 0 as u8)
    }
}

// ================================================== RUNDE DUALBOOT
//
// DIE DATEIEN IN DIE FREMDE EFI-PARTITION LEGEN -- UND ZWAR SO, DASS
// NICHTS VERLORENGEHT.
//
// DAS IST DIE STELLE, AN DER EIN SCHLECHTES INSTALLATIONSPROGRAMM
// FREMDE BOOTLADER LOESCHT. Der bequeme Weg waere, die ESP neu zu
// formatieren -- danach startet OrientOS, und Windows ist weg, ohne
// dass eine einzige Fehlermeldung gefallen waere.
//
// Also: die vorhandene EFI-Partition wird EINGEHAENGT und benutzt.
// OrientOS legt seine Dateien in ein EIGENES Unterverzeichnis:
//
//     /EFI/orientos/osum.mb        der Kern
//     /EFI/orientos/BOOTX64.EFI    der Bootlader
//
// Angefasst wird ausserdem GENAU EINE Datei ausserhalb davon: die
// Startdatei des Bootladers (/limine.conf). Sie MUSS geaendert werden,
// denn sie ist es, die das Menue beschreibt -- und ein Bootmenue, das
// nur OrientOS anbietet, waere fuer einen Dual-Boot-Rechner genauso
// falsch wie eine geloeschte ESP.
//
// \EFI\Microsoft\Boot\bootmgfw.efi wird GELESEN und nie
// geschrieben.
static mut p_efi_os: [u8; 20] = "/efi/EFI/orientos\0\0\0"
static mut p_efi_oskern: [u8; 28] = "/efi/EFI/orientos/osum.mb\0\0\0"
static mut p_efi_osldr: [u8; 32] = "/efi/EFI/orientos/BOOTX64.EFI\0\0\0"
// Wo der fremde Bootmanager liegt. Die Schreibweise ist die von
// Windows, und sie wird nur GEPRUEFT, nie beschrieben.
static mut p_fremd_bm: [u8; 40] = "/efi/EFI/Microsoft/Boot/bootmgfw.efi\0\0\0\0"

// DIE STARTDATEI FUER ZWEI SYSTEME.
//
// Sie steht hier in zwei Stuecken, weil der zweite Eintrag nur dann
// geschrieben wird, wenn der fremde Bootmanager wirklich da ist. Ein
// Menueeintrag, der auf eine Datei zeigt, die es nicht gibt, ist
// schlimmer als kein Eintrag: er sieht aus wie ein Weg zurueck ins
// alte System und endet in einer Fehlermeldung des Bootladers.
//
// `efi_chainload` ist das Protokoll, mit dem Limine die Steuerung an
// eine fremde EFI-Anwendung uebergibt. GEMESSEN (Runde DUALBOOT, mit
// einer eigens gebauten UEFI-Anwendung an der Stelle von bootmgfw.efi):
// der fremde Bootmanager meldet sich danach auf der seriellen Leitung
// und auf dem Schirm. Der Weg ueber die UEFI-Bootreihenfolge (NVRAM)
// waere die Alternative gewesen -- er braucht aber einen Dienst, den
// dieses System nicht hat, und er haengt an einem Speicher, den
// Hauptplatinen beim Zuruecksetzen leeren. Der Kettenstart steht in
// einer Datei auf der Platte und ueberlebt das.
static mut lim_dual1: [u8; 174] = "timeout: 10\n\n/OrientOS\n    protocol: multiboot1\n    path: boot():/EFI/orientos/osum.mb\n    cmdline: osum vfs gfx wm wig desk wmshell wmdauer herz tz=120 nosched noproc nofs\n\0"
static mut lim_dual2: [u8; 102] = "\n/Windows Boot Manager\n    protocol: efi_chainload\n    path: boot():/EFI/Microsoft/Boot/bootmgfw.efi\n\0"

// Gibt es die Datei? Geoeffnet und sofort wieder zu -- mehr will diese
// Frage nicht wissen.
fn datei_da(pfad: u64) -> bool {
    let f: u64 = ulib.sys(ulib.SYS_OPEN, pfad, 0, 0)
    if ulib.bad(f) {
        return false
    }
    ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
    return true
}

// Die Startdatei fuer den Doppelstart schreiben. Rueckgabe: 2, wenn
// beide Eintraege darin stehen, 1 bei nur OrientOS, 0 bei Fehler.
fn startdatei_dual() -> u64 {
    let fremd: bool = datei_da(ptr((&p_fremd_bm[0 as usize]) as u64))
    ulib.sys(ulib.SYS_UNLINK, ptr((&p_efi_lim[0 as usize]) as u64), 0, 0)
    let f: u64 = ulib.sys(ulib.SYS_OPEN,
        ptr((&p_efi_lim[0 as usize]) as u64), ulib.O_MAKE, 0)
    if ulib.bad(f) {
        return 0
    }
    let n1: u64 = ulib.length(ptr((&lim_dual1[0 as usize]) as u64))
    let w1: u64 = ulib.sys(ulib.SYS_WRITE, f,
        ptr((&lim_dual1[0 as usize]) as u64), n1)
    if ulib.bad(w1) || w1 != n1 {
        ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
        return 0
    }
    var wieviele: u64 = 1
    if fremd {
        let n2: u64 = ulib.length(ptr((&lim_dual2[0 as usize]) as u64))
        let w2: u64 = ulib.sys(ulib.SYS_WRITE, f,
            ptr((&lim_dual2[0 as usize]) as u64), n2)
        if ulib.bad(w2) || w2 != n2 {
            ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
            return 0
        }
        wieviele = 2
    }
    ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
    return wieviele
}

// Der Bootlader fuer den Weg "daneben". Er haengt die FREMDE
// EFI-Partition ein und legt darin ein eigenes Verzeichnis an.
fn bootlader_dual() -> bool {
    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi[0 as usize]) as u64), 0, 0)
    let m: u64 = ulib.sys4(ulib.SYS_VMOUNT,
        ptr((&d_esp[0 as usize]) as u64),
        ptr((&p_efi[0 as usize]) as u64),
        ptr((&t_vfat[0 as usize]) as u64), 0)
    if ulib.bad(m) {
        wo(60)
        return false
    }
    // DAS EIGENE VERZEICHNIS. /EFI gibt es auf einer fremden ESP schon;
    // `mkdir` darauf schlaegt fehl, und das ist richtig so -- es wird
    // nicht geprueft, weil ein vorhandenes Verzeichnis kein Fehler ist.
    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi_efi[0 as usize]) as u64), 0, 0)
    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi_os[0 as usize]) as u64), 0, 0)
    // Und /EFI/BOOT: dort erwartet die Firmware den Bootlader, wenn sie
    // keinen Eintrag in ihrer Reihenfolge hat.
    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi_boot[0 as usize]) as u64), 0, 0)
    var gut: bool = true
    if !instkern.kopiere(ptr((&p_src_kern[0 as usize]) as u64),
        ptr((&p_efi_oskern[0 as usize]) as u64)) {
        wo(61)
        gut = false
    }
    if gut && !instkern.kopiere(ptr((&p_src_ldr[0 as usize]) as u64),
        ptr((&p_efi_osldr[0 as usize]) as u64)) {
        wo(62)
        gut = false
    }
    // Der Bootlader an die Stelle, an der die Firmware ihn findet.
    // DAS UEBERSCHREIBT /EFI/BOOT/BOOTX64.EFI -- und das ist der eine
    // Schreibzugriff ausserhalb des eigenen Verzeichnisses, der sich
    // nicht vermeiden laesst, wenn OrientOS ohne Eintrag in der
    // UEFI-Reihenfolge starten soll. Windows startet NICHT von dort
    // (es haengt an \EFI\Microsoft\Boot\bootmgfw.efi), also kostet
    // es dort nichts; und der neue Lader bietet Windows im Menue an.
    if gut && !instkern.kopiere(ptr((&p_src_ldr[0 as usize]) as u64),
        ptr((&p_efi_ldr[0 as usize]) as u64)) {
        wo(63)
        gut = false
    }
    if gut {
        let wieviele: u64 = startdatei_dual()
        say(ptr((&m_d_menue[0 as usize]) as u64))
        ulib.sayu(wieviele)
        ulib.nl()
        if wieviele == 0 {
            wo(64)
            gut = false
        }
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.sys(ulib.SYS_UMOUNT2, ptr((&p_efi[0 as usize]) as u64), 0, 0)
    return gut
}

fn bootlader() -> bool {
    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi[0 as usize]) as u64), 0, 0)
    let m: u64 = ulib.sys4(ulib.SYS_VMOUNT,
        ptr((&d_esp[0 as usize]) as u64),
        ptr((&p_efi[0 as usize]) as u64),
        ptr((&t_vfat[0 as usize]) as u64), 0)
    if ulib.bad(m) {
        wo(50)
        return false
    }
    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi_efi[0 as usize]) as u64), 0, 0)
    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi_boot[0 as usize]) as u64), 0, 0)
    var gut: bool = true
    if !instkern.kopiere(ptr((&p_src_ldr[0 as usize]) as u64),
        ptr((&p_efi_ldr[0 as usize]) as u64)) {
        wo(51)
        gut = false
    }
    if gut && !instkern.kopiere(ptr((&p_src_kern[0 as usize]) as u64),
        ptr((&p_efi_kern[0 as usize]) as u64)) {
        wo(52)
        gut = false
    }
    // ============================== DIE STARTDATEI WIRD GESCHRIEBEN
    //
    // UND NICHT KOPIERT, und das ist der Fehler, an dem diese Runde
    // zuletzt gehangen hat.
    //
    // Die Vorlage (`install.fi`) kopiert `/boot/limine.conf` von der
    // Quelle auf die EFI-Partition. Auf dem USB-Abbild GIBT ES DIESE
    // DATEI NICHT: `tools/usbimg/build.sh` legt unter /boot/ nur
    // `osum.mb` und `BOOTX64.EFI` ab (Zeile 767), die limine.conf
    // entsteht erst spaeter und geht direkt in die EFI-Partition des
    // STICKS. Der Kopierversuch schlug deshalb still fehl -- die
    // Installation lag vollstaendig auf der Platte und meldete
    // trotzdem "FEHLER 2".
    //
    // UND SELBST WENN SIE DA WAERE, WAERE SIE DIE FALSCHE. Die
    // Startdatei des Sticks traegt `module_path: boot():/root.img` --
    // die Wurzel kommt dort als Boot-Modul in den Arbeitsspeicher.
    // Genau das soll nach der Installation NICHT mehr passieren: die
    // Wurzel liegt jetzt auf der Partition, und `modfs` in der
    // Kommandozeile wuerde den Kern anweisen, sie weiter aus dem
    // Speicher zu nehmen. Eine kopierte Startdatei haette also eine
    // Platte ergeben, die bootet und trotzdem nichts behaelt -- der
    // schlimmste denkbare Ausgang dieser Runde, weil er wie ein
    // Erfolg aussieht.
    //
    // Also schreibt der Installer sie selbst, mit genau der
    // Kommandozeile, die zu dem passt, was er gerade angelegt hat:
    // kein `modfs`, kein `module_path`.
    if gut && !startdatei() {
        wo(53)
        gut = false
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.sys(ulib.SYS_UMOUNT2, ptr((&p_efi[0 as usize]) as u64), 0, 0)
    return gut
}

// ------------------------------------------------------------ Schalter

fn arg_hat(args: u64, was: u64) -> bool {
    let n: u64 = ulib.arg_count(args)
    var i: u64 = 1
    while i < n {
        if ulib.streq(ulib.arg_at(args, i), was) {
            return true
        }
        i = i + 1
    }
    return false
}

// --------------------------------------------------------------- das Ganze

fn u_start(args: u64) -> u64 {
    // WAS AN ARGUMENTEN ANGEKOMMEN IST -- ALS ERSTES, vor allem
    // anderen. Ein Schalter, der nicht wirkt, hat zwei moegliche
    // Gruende: er kam nicht an, oder er wurde nicht gelesen. Diese
    // Zeilen trennen die beiden, und sie stehen VOR `wlib.begin()`,
    // damit sie auch dann etwas sagen, wenn es gar keine Flaeche gibt.
    say(ptr((&m_args[0 as usize]) as u64))
    ulib.sayu(ulib.arg_count(args))
    var ai: u64 = 0
    while ai < ulib.arg_count(args) {
        luft()
        say(ulib.arg_at(args, ai))
        ai = ai + 1
    }
    ulib.nl()
    let nohit: bool = arg_hat(args, ptr((&a_nohit[0 as usize]) as u64))
    // `zeig` malt das Fenster und geht wieder -- fuer den Bildbeweis.
    let nurzeig: bool = arg_hat(args, ptr((&a_zeig[0 as usize]) as u64))
    // `sofort` ueberspringt die beiden Fragen. NUR fuer den Testlaeufer:
    // ein Mensch bekommt sie immer, und deshalb heisst der Schalter
    // nicht "--ja" wie auf der Kommandozeile, sondern anders -- damit
    // niemand ihn aus Gewohnheit tippt.
    let sofort: bool = arg_hat(args, ptr((&a_ja[0 as usize]) as u64))
    let zweite: bool = arg_hat(args, ptr((&a_zwei[0 as usize]) as u64))
    let daneben: bool = arg_hat(args, ptr((&a_neben[0 as usize]) as u64))

    if !wlib.begin(nohit, false) {
        say(ptr((&m_nowm[0 as usize]) as u64))
        ulib.nl()
        return 1
    }
    // DER KATALOG ZUERST, vor jedem Bedienelement: `wlib` behaelt den
    // Zeiger auf den Text eines Knopfes, und ein Knopf, der vor dem
    // Katalog entsteht, traegt den Schluessel statt des Wortes.
    let _mk: u64 = msg.init()

    if daneben {
        welcher_weg = 1
    }
    platten_suchen()
    if p_anz == 1 {
        gewaehlt = 0
        tafel_holen(nptr(0))
    }
    tabelle_bauen()
    reiter_bauen()
    ptabelle_bauen()
    dzeilen_bauen()
    status_bauen()

    let w: u64 = wlib.window(wlibc.snap(40), wlibc.snap(40),
        wlibc.snap_up(BW), wlibc.snap_up(BH),
        msg.get(ptr((&k_title[0 as usize]) as u64)))
    if w >= wlib.MAXWN {
        say(ptr((&m_nowm[0 as usize]) as u64))
        ulib.nl()
        return 1
    }
    let _wa: u64 = wlib.window_app(w, ptr((&m_self[0 as usize]) as u64))

    let pad: u64 = wlibc.space(2)
    let gap: u64 = wlibc.space(1)
    let bw: u64 = wlib.win_w(w)
    let bh: u64 = wlib.win_h(w)
    let kh: u64 = wlibc.metric(wlibc.M_CTRL_H)

    // ============================================ DIE ANORDNUNG
    //
    // EINE senkrechte Schachtel ueber das ganze Fenster, und die
    // Bibliothek verteilt darin. Die erste Fassung dieser Datei hat
    // stattdessen VIER Schachteln mit ausgerechneten Y-Werten
    // nebeneinandergesetzt -- und das Ergebnis war ein Fenster, in dem
    // ausser dem Titelbalken NICHTS stand: 94,6 % einfarbige Flaeche,
    // gemessen mit `pruef/bildpruef.py`. Im Quelltext war das nicht zu
    // sehen; erst das Foto hat es gezeigt.
    //
    // Deshalb hier derselbe Aufbau wie im Aufgabenverwalter: EIN
    // `box_v` mit Rand und Abstand, die Widgets der Reihe nach hinein,
    // `size` nur dort, wo eine Hoehe nicht die Vorgabe ist.
    let tbh: u64 = wlibc.snap_up(160)
    let pbh: u64 = wlibc.snap_up(140)
    wlib.box_v(w, 0, 0, bw, bh, pad, gap)
    let lhead: u64 = wlib.label(msg.get(ptr((&k_head[0 as usize]) as u64)))
    wlib.size(0, tbh)
    let ttab: u64 = wlib.table((&tblob[0 as usize]) as u64, 5, NCOL,
        (&tspalten[0 as usize]) as u64)
    // ============================== DIE ZWEI WEGE ALS REITER
    //
    // Sie stehen UNTER der Plattenliste und nicht darueber: erst wird
    // eine Platte gewaehlt, dann entschieden, was mit ihr geschehen
    // soll. Umgekehrt muesste der Mensch ueber etwas entscheiden, das
    // er noch nicht benannt hat.
    let treiter: u64 = wlib.tabs((&tabtext[0 as usize]) as u64)
    // Die Partitionsansicht des zweiten Weges.
    wlib.size(0, pbh)
    let ptab: u64 = wlib.table((&pblob[0 as usize]) as u64, 5, PCOL,
        (&pspalten[0 as usize]) as u64)
    let lfrei: u64 = wlib.label((&freizeile[0 as usize]) as u64)
    let lesp: u64 = wlib.label((&espzeile[0 as usize]) as u64)
    let lstat: u64 = wlib.label((&zeile[0 as usize]) as u64)
    let lschritt: u64 = wlib.label((&schrittzeile[0 as usize]) as u64)
    wlib.box_end()

    // Die Partitionsansicht gehoert dem zweiten Reiter -- am Anfang
    // steht der erste, also ist sie zu.
    wlib.show(ptab, false)
    wlib.show(lfrei, false)
    wlib.show(lesp, false)

    // EIN KLICK GENUEGT. Eine Platte waehlt man einmal aus; ein
    // Doppelklick waere hier die Regel eines Dateimanagers am falschen
    // Ort.
    wlib.list_einklick(ttab, true)

    // DIE KNOPFREIHE STEHT RECHTS UNTEN -- dieselbe Stelle, an der
    // `wlib.dlg_new` seit Runde K15 die Antwortknoepfe hinsetzt.
    let t_such: u64 = msg.get(ptr((&k_refresh[0 as usize]) as u64))
    let t_go: u64 = msg.get(ptr((&k_go[0 as usize]) as u64))
    let w_such: u64 = wlibc.snap_up(
        wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), t_such, ulib.length(t_such))
        + 2 * wlibc.metric(wlibc.M_PAD_X))
    let w_go: u64 = wlibc.snap_up(
        wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), t_go, ulib.length(t_go))
        + 2 * wlibc.metric(wlibc.M_PAD_X))
    let reihe: u64 = w_such + gap + w_go
    wlib.box_h(w, bw - pad - reihe, bh - pad - kh, reihe, kh, 0, gap)
    wlib.size(w_such, kh)
    let bsuch: u64 = wlib.button(t_such)
    wlib.size(w_go, kh)
    let bgo: u64 = wlib.button(t_go)
    wlib.box_end()

    // Der Knopf ist aus, solange nichts gewaehlt ist. Ein Knopf, der
    // nichts tut, wenn man ihn drueckt, ist schlimmer als einer, der
    // erkennbar nicht bereit ist.
    wlib.enable(bgo, weg_moeglich())
    wlib.set_text(bgo, weg_knopftext())
    if welcher_weg == 1 {
        wlib.set_value(treiter, 1)
        wlib.show(ptab, true)
        wlib.show(lfrei, true)
        wlib.show(lesp, true)
        wlib.show(ttab, true)
    }

    wlib.draw_all()
    say(ptr((&m_ready[0 as usize]) as u64))
    ulib.sayu(p_anz)
    ulib.nl()
    // WAS DIE BIBLIOTHEK WIRKLICH HINGESTELLT HAT. Ein Fenster, das
    // leer aussieht, kann zweierlei heissen: die Widgets sind nicht da,
    // oder sie stehen ausserhalb. Diese Zeile unterscheidet die beiden
    // Faelle, und sie hat in dieser Runde genau das getan.
    wlib.say_rects(ptr((&m_self[0 as usize]) as u64))

    if nurzeig {
        return 0
    }

    // Der Testlaeufer darf ohne Fragen durch -- ein Mensch nie.
    //
    // UND ER NIMMT DIE ERSTE PLATTE, nicht "die einzige". Die
    // Vorauswahl oben greift nur bei genau einer gefundenen Platte --
    // das ist fuer einen Menschen richtig (bei zweien soll er
    // waehlen), fuer den Laeufer aber eine Bedingung, die er nicht in
    // der Hand hat: taucht ein zweites Geraet auf, tut der Lauf
    // stillschweigend nichts und die Abnahme meldet "keine Schritte".
    // Genau das ist in dieser Runde passiert.
    if sofort {
        if gewaehlt >= p_anz && p_anz > 0 {
            gewaehlt = 0
        }
        // `zweite` schlaegt die Vorauswahl: der Lauf mit zwei Platten
        // will ausdruecklich die, die NICHT die erste ist.
        if zweite && p_anz > 1 {
            gewaehlt = 1
        }
        if gewaehlt < p_anz {
            // Die Tafel gehoert zu DIESER Platte -- die Vorauswahl oben
            // hat sie nur dann gelesen, wenn es genau eine Platte gab.
            tafel_holen(nptr(gewaehlt))
            ptabelle_bauen()
            dzeilen_bauen()
            wlib.set_text(ptab, (&pblob[0 as usize]) as u64)
            wlib.set_text(lfrei, (&freizeile[0 as usize]) as u64)
            wlib.set_text(lesp, (&espzeile[0 as usize]) as u64)
            wlib.draw_all()
            // AUF DEM WEG "DANEBEN" WIRD NUR LOSGELEGT, WENN ES GEHT.
            // Sonst bliebe der Lauf haengen und die Abnahme meldete
            // "keine Schritte", statt den Abbruchgrund zu zeigen.
            if welcher_weg == 1 && d_moeglich == 0 {
                say(ptr((&m_d_nein[0 as usize]) as u64))
                luft()
                ulib.sayu(dualkern.grund())
                ulib.nl()
                return 0
            }
            frage = 2
        }
    }

    var runden: u64 = 0
    while wlib.alive() && runden < 4000000 {
        runden = runden + 1

        // Die zweite Frage ist beantwortet: jetzt wird geschrieben.
        if frage == 2 && laeuft == 0 && fertig == 0 {
            laeuft = 1
            status_bauen()
            wlib.set_text(lstat, (&zeile[0 as usize]) as u64)
            wlib.enable(bgo, false)
            wlib.enable(bsuch, false)
            wlib.draw_all()
            say(ptr((&m_go[0 as usize]) as u64))
            ulib.nl()

            // WELCHER WEG. Das ist die eine Verzweigung, um die es
            // in dieser Runde geht -- alles davor ist Anzeige, alles
            // dahinter ist dieselbe Meldung.
            var gut: bool = false
            if welcher_weg == 1 {
                gut = installieren_daneben(nptr(gewaehlt), lstat, lschritt)
            } else {
                gut = installieren(nptr(gewaehlt), lstat, lschritt)
            }
            laeuft = 0
            if gut {
                fertig = 1
                say(ptr((&m_ok[0 as usize]) as u64))
            } else {
                fertig = 2
                say(ptr((&m_fail[0 as usize]) as u64))
                luft()
                ulib.sayu(instkern.fehler_bei())
            }
            ulib.nl()
            if fertig == 2 {
                b_start((&zeile[0 as usize]) as u64, 200)
                b_s(msg.get(ptr((&k_fail[0 as usize]) as u64)))
                b_ende()
            } else {
                status_bauen()
            }
            wlib.set_text(lstat, (&zeile[0 as usize]) as u64)
            schritt_bauen()
            wlib.set_text(lschritt, (&schrittzeile[0 as usize]) as u64)
            wlib.enable(bsuch, true)
            wlib.draw_all()
            frage = 0
            if sofort {
                return 0
            }
        }

        let id: u64 = wlib.step()
        if id < wlib.MAXWD {
            let kind: u64 = wlib.fired_kind()
            let idx: u64 = wlib.fired_index()
            if kind == wlib.K_BUTTON {
                if id == bsuch {
                    platten_suchen()
                    gewaehlt = 0xFFFFFFFFFFFFFFFF
                    fertig = 0
                    tabelle_bauen()
                    wlib.set_text(ttab, (&tblob[0 as usize]) as u64)
                    status_bauen()
                    wlib.set_text(lstat, (&zeile[0 as usize]) as u64)
                    wlib.enable(bgo, false)
                    wlib.draw_all()
                } else if id == bgo && weg_moeglich() && laeuft == 0 {
                    if welcher_weg == 1 {
                        // AUF DEM WEG "DANEBEN" GENUEGT EINE FRAGE.
                        //
                        // Die zweite Frage des anderen Weges gibt es,
                        // weil dort eine ganze Platte geloescht wird --
                        // die folgenreichste Sache, die dieses System
                        // auf Knopfdruck tut. Hier wird NICHTS
                        // geloescht; die vorhandenen Partitionen
                        // bleiben, und das steht auch in der Frage.
                        // Zwei Warnungen vor einem harmlosen Schritt
                        // sind keine Vorsicht, sondern Gewoehnung --
                        // und Gewoehnung ist genau das, was die zweite
                        // Frage auf dem anderen Reiter wertlos machen
                        // wuerde.
                        frage = 2
                        wlib.dlg_ask(
                            msg.get(ptr((&k_d_askt[0 as usize]) as u64)),
                            msg.get(ptr((&k_d_askx[0 as usize]) as u64)))
                        say(ptr((&m_ask[0 as usize]) as u64))
                        ulib.sayu(9)
                        ulib.nl()
                    } else {
                        // DIE ERSTE FRAGE.
                        frage = 1
                        wlib.dlg_ask(
                            msg.get(ptr((&k_ask1t[0 as usize]) as u64)),
                            msg.get(ptr((&k_ask1x[0 as usize]) as u64)))
                        say(ptr((&m_ask[0 as usize]) as u64))
                        ulib.sayu(1)
                        ulib.nl()
                    }
                }
            } else if kind == wlib.K_TABLE && id == ttab {
                if idx < p_anz {
                    gewaehlt = idx
                    say(ptr((&m_pick[0 as usize]) as u64))
                    luft()
                    say(nptr(gewaehlt))
                    ulib.nl()
                    // DIE TAFEL DIESER PLATTE LESEN. Erst jetzt -- vorher
                    // ist nicht klar, um welche Platte es geht, und ein
                    // Programm, das beim Start jede Platte durchliest,
                    // haelt den Menschen auf.
                    tafel_holen(nptr(gewaehlt))
                    ptabelle_bauen()
                    dzeilen_bauen()
                    wlib.set_text(ptab, (&pblob[0 as usize]) as u64)
                    wlib.set_text(lfrei, (&freizeile[0 as usize]) as u64)
                    wlib.set_text(lesp, (&espzeile[0 as usize]) as u64)
                    status_bauen()
                    wlib.set_text(lstat, (&zeile[0 as usize]) as u64)
                    wlib.enable(bgo, weg_moeglich())
                    wlib.draw_all()
                }
            } else if kind == wlib.K_TABS && id == treiter {
                // DER WEG WIRD GEWECHSELT.
                welcher_weg = idx
                say(ptr((&m_d_weg[0 as usize]) as u64))
                ulib.sayu(welcher_weg)
                ulib.nl()
                wlib.show(ptab, welcher_weg == 1)
                wlib.show(lfrei, welcher_weg == 1)
                wlib.show(lesp, welcher_weg == 1)
                wlib.set_text(bgo, weg_knopftext())
                status_bauen()
                wlib.set_text(lstat, (&zeile[0 as usize]) as u64)
                wlib.enable(bgo, weg_moeglich())
                wlib.draw_all()
            }
        }

        // Die Antwort auf eine der beiden Fragen.
        if wlib.dlg_state() > 1 {
            let ja: bool = wlib.dlg_state() == 2
            wlib.dlg_close()
            if ja && frage == 1 {
                // DIE ZWEITE FRAGE. Sie kommt erst, wenn die erste mit
                // Ja beantwortet ist -- und sie sagt, dass es jetzt
                // unwiderruflich wird.
                frage = 2
                wlib.dlg_ask(
                    msg.get(ptr((&k_ask2t[0 as usize]) as u64)),
                    msg.get(ptr((&k_ask2x[0 as usize]) as u64)))
                say(ptr((&m_ask[0 as usize]) as u64))
                ulib.sayu(2)
                ulib.nl()
                // Die zweite Frage steht jetzt; ihre Antwort kommt in
                // einer der naechsten Runden. `frage` bleibt auf 2 und
                // wird oben erst dann ausgewertet, wenn der Dialog
                // wirklich zu ist.
                wlib.draw_all()
                // Warten, bis sie beantwortet ist.
                var warte: u64 = 0
                var zusage: bool = false
                while wlib.alive() && warte < 4000000 {
                    warte = warte + 1
                    let _x: u64 = wlib.step()
                    if wlib.dlg_state() > 1 {
                        zusage = wlib.dlg_state() == 2
                        wlib.dlg_close()
                        wlib.draw_all()
                        warte = 4000000
                    }
                }
                if !zusage {
                    frage = 0
                    wlib.draw_all()
                }
            } else if !ja {
                frage = 0
                wlib.draw_all()
            }
        }
    }
    return 0
}

// ==================================================================
// DAS `main`, DAS SEHR WOHL LAEUFT -- UND DER SCHALTER, DER DESHALB NIE
// ANKAM
// ==================================================================
//
// In jedem Programm dieses Baums mit `profile app` steht an dieser
// Stelle derselbe Dreizeiler, und darueber derselbe Satz: "das `main`,
// das nie laeuft -- `user.ld` springt nach `u_start`".
//
// DER SATZ STIMMT FUER `profile kernel` UND NICHT FUER `profile app`.
// Nachgemessen an der fertigen Datei:
//
//     401000e8: xor  %rbp,%rbp
//     401000eb: mov  %rsp,%rdi      <- der Argumentblock
//     401000ee: and  $-16,%rsp
//     401000f2: call 0x40102d4a     <- und das ist `main`, nicht u_start
//
// Unter `app` bindet der Uebersetzer sein EIGENES `_start` ein (es gibt
// kein crt.o daneben, siehe tools/usbimg/build.sh), und dieses `_start`
// ruft `main`. `--defsym=USER_ENTRY=...u_start` steht zwar in der
// Binderzeile, aber es wird von diesem Weg gar nicht benutzt.
//
// Damit reicht `u_start(0)` den Block NICHT weiter, sondern eine Null --
// und `ulib.arg_count(0)` ist 0. Jeder Schalter, den ein
// app-Programm auf der Kommandozeile bekommt, ist an dieser Zeile
// verlorengegangen. GEMESSEN in dieser Runde: mit
// `wigapp=/bin/installer,zeig` stand auf der Leitung
//
//     installer: argc=0
//
// obwohl der Kern den Block gebaut und `elf.spawn` ihn uebergeben hat
// (kernel/kgui.fi zaehlt `wg_argc` korrekt hoch, kernel/elf.fi
// `write_args` schreibt ihn nach ARGS_BASE).
//
// DIE STELLE IST HIER UND NICHT IM KERN. Der Kern tut das Richtige;
// falsch ist die Null in dieser Zeile. `rdi` ist in Firn nicht zu
// lesen, aber der Block liegt an einer FESTEN Adresse --
// `proc.ARGS_BASE` in kernel/proc.fi, und die Startmeldung jedes
// Prozesses nennt sie mit (`ustack=0x4007f000`). Also wird sie hier
// benannt und nicht erraten.
//
// DAS BETRIFFT NICHT NUR DIESES PROGRAMM. Dieselben drei Zeilen stehen
// in desktop, taskbar, settings, launcher, explorer, widgetdemo,
// taskmgr, calc, certus und speicher -- ihre Schalter (`nohit`,
// `noclip`, `nokeys`, `noidx`) kommen genauso wenig an. Das hier ist
// die Reparatur fuer DIESE Datei; der Rest gehoert in eine eigene
// Runde, weil an den Gegenproben Testlaeufer haengen, die heute gruen
// sind, ohne dass der Schalter je gewirkt haette.
const ARGS_BASE: u64 = 0x4007F000

fn main() -> i32 {
    return u_start(ARGS_BASE) as i32
}
