fn ptr(p: u64) -> u64 {
    return p
}

fn say(p: u64) {
    ulib.say(p)
}

fn say_space() {
    ulib.say(ptr((&m_space[0 as usize]) as u64))
}

fn nptr(i: u64) -> u64 {
    return (&p_name[0 as usize]) as u64 + i * 16
}

fn mib_of(sect_count: u64) -> u64 {
    return sect_count / 2048
}

static mut bp: u64 = 0
static mut b_target: u64 = 0
static mut bmax: u64 = 0

fn b_start(dest_buf: u64, max: u64) {
    b_target = dest_buf
    bmax = max
    bp = 0
    ulib.fill(dest_buf, 0, max)
}

fn b_c(c: u64) {
    if bp + 1 < bmax {
        __mmio_write8((b_target + bp) as *mut u8, c as u8)
        bp = bp + 1
    }
}

fn b_s(p: u64) {
    var i: u64 = 0
    while (*((p + i) as *mut u8)) as u64 != 0 {
        b_c((*((p + i) as *mut u8)) as u64)
        i = i + 1
    }
}

fn b_n(v: u64) {
    if v >= 10 {
        b_n(v / 10)
    }
    b_c(48 + (v % 10))
}

fn b_end() {
    if bp < bmax {
        __mmio_write8((b_target + bp) as *mut u8, 0 as u8)
    }
}

fn is_empty(dev: u64) -> bool {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, dev, 0, 0)
    if ulib.bad(fd) {
        return true
    }
    var empty: bool = true
    if instkern.read_at(fd, 0, (&tblob[0 as usize]) as u64, 512) {
        let p: u64 = (&tblob[0 as usize]) as u64
        let s1: u64 = (*((p + 510) as *mut u8)) as u64
        let s2: u64 = (*((p + 511) as *mut u8)) as u64
        if s1 == 0x55 && s2 == 0xAA {
            empty = false
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return empty
}

fn add_disk(dev: u64) {
    if p_count >= MAXP {
        return
    }
    let n: u64 = ulib.size_of(dev)
    if ulib.bad(n) || n == 0 {
        return
    }

    let fd: u64 = ulib.sys(ulib.SYS_OPEN, dev, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let readable: bool = instkern.read_at(fd, 0, (&tblob[0 as usize]) as u64, 512)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if !readable {
        return
    }
    ulib.strcpy(nptr(p_count), dev)
    p_sect[(p_count) as usize] = n / instkern.BS
    if is_empty(dev) {
        p_parts[(p_count) as usize] = 0
    } else {
        p_parts[(p_count) as usize] = 1
    }
    say(ptr((&m_disk[0 as usize]) as u64))
    say(dev)
    say_space()
    ulib.sayu(p_sect[(p_count) as usize])
    ulib.nl()
    p_count = p_count + 1
}

static mut hw_buf: [u8; 1536] = [0 as u8; 1536]
static mut hw_n: u64 = 0
static mut k_hw_proc: [u8; 11] = "/proc/hwid\0"
static mut k_hw_nvme: [u8; 13] = "nvme_model: \0"
static mut k_hw_ahci: [u8; 13] = "ahci_model: \0"

fn rb(p: u64) -> u64 {
    return (*(p as *mut u8)) as u64
}

fn hw_read() {
    hw_n = 0
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&k_hw_proc[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let b: u64 = (&hw_buf[0 as usize]) as u64
    let r: u64 = ulib.sys(ulib.SYS_READ, fd, b, 1500)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(r) || r == 0 {
        return
    }
    __mmio_write8((b + r) as *mut u8, 0 as u8)
    hw_n = r
}

fn hw_wert(key: u64) -> u64 {
    let b: u64 = (&hw_buf[0 as usize]) as u64
    var i: u64 = 0
    while i < hw_n {
        var line_buf: bool = i == 0
        if i > 0 && rb(b + i - 1) == 10 {
            line_buf = true
        }
        if line_buf {
            var k: u64 = 0
            var bytes_equal: bool = true
            while bytes_equal && rb(key + k) != 0 {
                if i + k >= hw_n || rb(b + i + k) != rb(key + k) {
                    bytes_equal = false
                }
                k = k + 1
            }
            if bytes_equal {
                let v: u64 = b + i + k
                if rb(v) != 10 && rb(v) != 0 {
                    return v
                }
                return 0
            }
        }
        i = i + 1
    }
    return 0
}

fn model_of(nm: u64) -> u64 {
    if rb(nm + 5) == 110 {
        return hw_wert((&k_hw_nvme[0 as usize]) as u64)
    }
    if rb(nm + 5) == 115 {
        return hw_wert((&k_hw_ahci[0 as usize]) as u64)
    }
    return 0
}

fn model_out(v: u64) {
    var i: u64 = 0
    while i < 28 && rb(v + i) >= 32 && rb(v + i) < 127 {
        b_c(rb(v + i))
        i = i + 1
    }
}

fn scan_disks() {
    p_count = 0

    let _up: u64 = ulib.sys(1601, 0, 0, 0)
    hw_read()
    add_disk(ptr((&d_hda[0 as usize]) as u64))
    add_disk(ptr((&d_hdb[0 as usize]) as u64))
    add_disk(ptr((&d_nvme[0 as usize]) as u64))
    add_disk(ptr((&d_sda[0 as usize]) as u64))
}

fn build_table() {
    b_start((&tblob[0 as usize]) as u64, 1024)

    b_s(msg.get(ptr((&k_cols[0 as usize]) as u64)))
    b_c(10)
    var i: u64 = 0
    while i < p_count {
        b_s(nptr(i))
        b_c(9)

        let nm: u64 = nptr(i)
        let mo: u64 = model_of(nm)
        if mo != 0 {
            model_out(mo)
        } else if (*((nm + 5) as *mut u8)) as u64 == 110 {
            b_c(78)
            b_c(86)
            b_c(77)
            b_c(101)
        } else {
            b_c(65)
            b_c(84)
            b_c(65)
        }
        b_c(9)
        b_n(mib_of(p_sect[(i) as usize]))
        b_c(32)
        b_c(77)
        b_c(105)
        b_c(66)
        b_c(9)
        if p_parts[(i) as usize] == 0 {
            b_s(msg.get(ptr((&k_empty[0 as usize]) as u64)))
        } else {
            b_s(msg.get(ptr((&k_parts[0 as usize]) as u64)))
        }
        b_c(10)
        i = i + 1
    }
    b_end()
}

fn fetch_table(dev: u64) {
    d_read = 0
    d_possible = 0
    d_shrink = 0
    d_free_from = 0
    d_free_to = 0
    d_esp_idx = 0xFFFFFFFFFFFFFFFF
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, dev, ulib.O_RDWR, 0)
    if ulib.bad(fd) {
        return
    }
    let sect_count: u64 = ulib.size_of(dev) / instkern.BS
    shrinkflow.bind(fd, sect_count, dev)
    let fixed: u64 = shrinkflow.recover_pending()
    say(ptr((&m_sh_state[0 as usize]) as u64))
    ulib.sayu(fixed)
    ulib.nl()
    fetch_table_fd(fd, sect_count)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
}

fn fetch_table_fd(fd: u64, sect_count: u64) {
    let n: u64 = dualkern.read_table(fd, sect_count)
    say(ptr((&m_d_table[0 as usize]) as u64))
    ulib.sayu(n)
    say_space()
    ulib.sayu(dualkern.reason_code())
    say_space()
    ulib.sayu(dualkern.detail_got())
    say_space()
    ulib.sayu(dualkern.detail_want())
    ulib.nl()
    d_read = 1
    if !dualkern.gpt_verify() {
        return
    }

    var i: u64 = 0
    while i < n {
        say(ptr((&m_d_part[0 as usize]) as u64))
        ulib.sayu(i + 1)
        say_space()
        ulib.sayu(dualkern.p_start(i))
        say_space()
        ulib.sayu(dualkern.p_end(i))
        say_space()
        ulib.sayu(dualkern.p_typ(i))
        ulib.nl()
        i = i + 1
    }
    let e: u64 = dualkern.find_esp()
    var esp_ok: bool = false
    if e < dualkern.entry_count() && dualkern.esp_big_enough(e) {
        esp_ok = true
        d_esp_idx = e
        say(ptr((&m_d_espi[0 as usize]) as u64))
        ulib.sayu(e + 1)
        ulib.nl()
    }
    var gap: bool = false
    if dualkern.find_gap(65536) {
        gap = true
        d_free_from = dualkern.gap_start()
        d_free_to = dualkern.gap_end()
        say(ptr((&m_d_free[0 as usize]) as u64))
        ulib.sayu(d_free_from)
        say_space()
        ulib.sayu(d_free_to)
        ulib.nl()
    } else {
        d_shrink = shrinkflow.scan()
        say(ptr((&m_sh_state[0 as usize]) as u64))
        ulib.sayu(100 + d_shrink)
        say_space()
        ulib.sayu(shrinkflow.refusal())
        say_space()
        ulib.sayu(shrinkflow.offer_free())
        ulib.nl()
    }
    d_gap_max = dualkern.gap_largest()
    if !esp_ok {
        return
    }
    if gap {
        d_possible = 1
    } else if d_shrink == shrinkflow.S_OFFER {
        d_possible = 2
    }
}

fn shrink_ask_text() {
    b_start((&shrinktext[0 as usize]) as u64, 400)
    b_s(msg.get(shrinkflow.key_ask_text()))
    b_c(32)
    b_n(shrinkflow.free_target(shrinkflow.offer_free()) / 2048)
    b_c(32)
    b_c(77)
    b_c(105)
    b_c(66)
    b_end()
}

fn shrink_show() {
    build_status()
    fuiscene.refresh()
    fuiscene.repaint_now()
}

fn shrink_tick(phase: u64, pct: u64) -> u64 {
    let all: u64 = shrinkflow.overall_pct(phase, pct)
    if all == d_shrink_pct && d_shrink_run != 0 {
        return 0
    }
    d_shrink_pct = all
    d_shrink_run = 1
    shrink_show()
    if all % 10 == 0 || all == 100 {
        say(ptr((&m_sh_prog[0 as usize]) as u64))
        ulib.sayu(all)
        ulib.nl()
    }
    return 0
}

fn shrink_now(dev: u64) -> bool {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, dev, ulib.O_RDWR, 0)
    if ulib.bad(fd) {
        d_shrink_fail = codes.E_IO
        return false
    }
    let sect_count: u64 = ulib.size_of(dev) / instkern.BS
    shrinkflow.bind(fd, sect_count, dev)
    shrinkflow.recover_pending()
    var r: u64 = codes.E_NO_SPACE
    if shrinkflow.scan() == shrinkflow.S_OFFER {
        d_shrink_pct = 0
        d_shrink_run = 1
        shrink_show()
        r = shrinkflow.run_shrink(shrinkflow.free_target(shrinkflow.offer_free()), shrink_tick)
        d_shrink_run = 0
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    say(ptr((&m_sh_state[0 as usize]) as u64))
    ulib.sayu(200 + r)
    ulib.nl()
    d_shrink_fail = r
    fetch_table(dev)
    return r == codes.E_OK
}

fn view_dump() {
    say(ptr((&m_view_rows[0 as usize]) as u64))
    if d_read == 0 || !dualkern.gpt_verify() {
        ulib.sayu(0)
    } else {
        ulib.sayu(dualkern.entry_count())
    }
    ulib.nl()
    say(ptr((&m_view_free[0 as usize]) as u64))
    say((&free_row[0 as usize]) as u64)
    ulib.nl()
    say(ptr((&m_view_stat[0 as usize]) as u64))
    say((&stat_row[0 as usize]) as u64)
    ulib.nl()
    say(ptr((&m_view_beside[0 as usize]) as u64))
    ulib.sayu(d_possible)
    ulib.nl()
    say(ptr((&m_view_reuse[0 as usize]) as u64))
    if reuse_ok() {
        ulib.sayu(1)
    } else {
        ulib.sayu(0)
    }
    ulib.nl()
    say(ptr((&m_view_art[0 as usize]) as u64))
    if d_read != 0 && dualkern.gpt_verify() {
        var ai: u64 = 0
        while ai < dualkern.entry_count() {
            if dualkern.p_fve(ai) {
                say(msg.get(ptr((&k_a_bl[0 as usize]) as u64)))
            } else {
                say(kind_text(dualkern.p_typ(ai)))
            }
            say(ptr((&m_view_semi[0 as usize]) as u64))
            ai = ai + 1
        }
    }
    ulib.nl()
    say(ptr((&m_view_esp[0 as usize]) as u64))
    say((&esp_row[0 as usize]) as u64)
    ulib.nl()
}

fn rebuild_view() {
    sel_part = 0xFFFFFFFFFFFFFFFF
    build_ptable()
    build_dual_rows()
    view_dump()
    fuiscene.table_set_blob(K_PTAB, (&pblob[0 as usize]) as u64)
    build_status()
    fuiscene.refresh()
}

fn kind_text(t: u64) -> u64 {
    if t == dualkern.T_MSR {
        return msg.get(ptr((&k_a_msr[0 as usize]) as u64))
    }
    if t == dualkern.T_RECOVERY {
        return msg.get(ptr((&k_a_rec[0 as usize]) as u64))
    }
    if t == dualkern.T_ESP {
        return msg.get(ptr((&k_a_esp[0 as usize]) as u64))
    }
    if t == dualkern.T_DATA {
        return msg.get(ptr((&k_a_data[0 as usize]) as u64))
    }
    if t == dualkern.T_LINUX {
        return msg.get(ptr((&k_a_linux[0 as usize]) as u64))
    }
    if t == dualkern.T_OSUM {
        return msg.get(ptr((&k_a_osum[0 as usize]) as u64))
    }
    return msg.get(ptr((&k_a_unknown[0 as usize]) as u64))
}

fn build_ptable() {
    b_start((&pblob[0 as usize]) as u64, 1024)
    b_s(msg.get(ptr((&k_d_cols[0 as usize]) as u64)))
    b_c(10)
    if d_read == 0 || !dualkern.gpt_verify() {
        b_end()
        return
    }
    let n: u64 = dualkern.entry_count()
    var i: u64 = 0
    while i < n {
        b_n(i + 1)
        b_c(9)
        b_n(dualkern.p_start(i))
        b_c(9)
        b_n((dualkern.p_end(i) - dualkern.p_start(i) + 1) / 2048)
        b_c(32)
        b_c(77)
        b_c(105)
        b_c(66)
        b_c(9)
        if dualkern.p_fve(i) {
            b_s(msg.get(ptr((&k_a_bl[0 as usize]) as u64)))
        } else {
            b_s(kind_text(dualkern.p_typ(i)))
        }
        b_c(9)

        var k: u64 = 0
        var keep_going: bool = true
        while k < 35 && keep_going {
            let ch: u64 = dualkern.p_name_ch(i, k)
            if ch == 0 {
                keep_going = false
            } else {
                b_c(ch)
                k = k + 1
            }
        }
        b_c(10)
        i = i + 1
    }

    if d_free_to > d_free_from {
        b_c(45)
        b_c(9)
        b_n(d_free_from)
        b_c(9)
        b_n((d_free_to - d_free_from + 1) / 2048)
        b_c(32)
        b_c(77)
        b_c(105)
        b_c(66)
        b_c(9)
        b_s(msg.get(ptr((&k_a_free[0 as usize]) as u64)))
        b_c(9)
        b_c(10)
    }
    b_end()
}

fn b_sizes() {
    b_c(32)
    b_s(msg.get(ptr((&k_d_f_found[0 as usize]) as u64)))
    b_c(32)
    b_n(d_gap_max / 2048)
    b_c(32)
    b_c(77)
    b_c(105)
    b_c(66)
    b_c(44)
    b_c(32)
    b_s(msg.get(ptr((&k_d_f_needed[0 as usize]) as u64)))
    b_c(32)
    b_n(dualkern.MIN_ROOT / 2048)
    b_c(32)
    b_c(77)
    b_c(105)
    b_c(66)
}

fn build_dual_rows() {
    b_start((&free_row[0 as usize]) as u64, 200)
    if d_read == 0 {
        b_end()
    } else if !dualkern.gpt_verify() {
        let g: u64 = dualkern.reason_code()
        b_s(msg.get(gpt_reason_key(g)))
        if g != dualkern.D_NO_GPT {
            b_c(32)
            b_s(msg.get(ptr((&k_d_gdetail[0 as usize]) as u64)))
            b_c(32)
            b_n(dualkern.detail_got())
            b_c(47)
            b_n(dualkern.detail_want())
        }
        b_c(32)
        b_s(msg.get(ptr((&k_d_esp_gone[0 as usize]) as u64)))
        b_end()
    } else if d_free_to <= d_free_from && d_shrink_fail != 0 {
        b_s(msg.get(shrinkflow.key_fail()))
        b_c(32)
        b_s(msg.get(shrinkflow.refusal_key(d_shrink_fail)))
        b_end()
    } else if d_free_to <= d_free_from && d_shrink == shrinkflow.S_OFFER {
        b_s(msg.get(ptr((&k_d_f_none[0 as usize]) as u64)))
        b_c(32)
        b_s(msg.get(shrinkflow.key_offer()))
        b_c(32)
        b_n(shrinkflow.offer_free() / 2048)
        b_c(32)
        b_c(77)
        b_c(105)
        b_c(66)
        b_end()
    } else if d_free_to <= d_free_from && d_shrink == shrinkflow.S_REFUSED {
        b_s(msg.get(ptr((&k_d_f_none[0 as usize]) as u64)))
        b_sizes()
        b_end()
    } else if d_free_to <= d_free_from {
        b_s(msg.get(ptr((&k_d_f_none[0 as usize]) as u64)))
        b_sizes()
        b_c(32)
        b_s(msg.get(ptr((&k_d_f_more[0 as usize]) as u64)))
        b_end()
    } else {
        b_s(msg.get(ptr((&k_d_free[0 as usize]) as u64)))
        b_c(32)
        b_n((d_free_to - d_free_from + 1) / 2048)
        b_c(32)
        b_c(77)
        b_c(105)
        b_c(66)
        b_end()
    }

    b_start((&stat_row[0 as usize]) as u64, 200)
    if d_read != 0 && dualkern.gpt_verify() && d_free_to <= d_free_from
        && d_shrink_fail == 0 && d_shrink == shrinkflow.S_REFUSED {
        b_s(msg.get(shrinkflow.refusal_key(shrinkflow.refusal())))
    }
    b_end()

    b_start((&esp_row[0 as usize]) as u64, 200)
    if d_read == 0 || !dualkern.gpt_verify() {
        b_end()
    } else if d_esp_idx >= dualkern.entry_count() {
        let g: u64 = dualkern.reason_code()
        if g == dualkern.D_ESP_TOO_SMALL {
            b_s(msg.get(ptr((&k_d_esp_small[0 as usize]) as u64)))
        } else {
            b_s(msg.get(ptr((&k_d_esp_none[0 as usize]) as u64)))
        }
        b_c(32)
        b_s(msg.get(ptr((&k_d_esp_gone[0 as usize]) as u64)))
        b_end()
    } else {
        b_s(msg.get(ptr((&k_d_esp_found[0 as usize]) as u64)))
        b_c(32)
        b_n(d_esp_idx + 1)
        b_c(32)
        b_c(45)
        b_c(45)
        b_c(32)
        b_s(msg.get(ptr((&k_d_nkeep[0 as usize]) as u64)))
        b_end()
    }
}

fn acct_name() -> u64 {
    return fuiscene.entry_text(K_ACCT_NAME)
}

fn acct_pw1() -> u64 {
    return fuiscene.entry_text(K_ACCT_PW1)
}

fn acct_pw2() -> u64 {
    return fuiscene.entry_text(K_ACCT_PW2)
}

fn account_stage() -> u64 {
    if acct_name() == 0 || acct_pw1() == 0 || acct_pw2() == 0 {
        return 0
    }
    if !instkonto.name_ok(acct_name()) {
        return 0
    }
    if !instkonto.pass_ok(acct_pw1()) {
        return 1
    }
    if !ulib.streq(acct_pw1(), acct_pw2()) {
        return 2
    }
    return 3
}

fn account_valid() -> bool {
    if account_on == 0 {
        return true
    }
    return account_stage() == 3
}

fn build_account_line() {
    b_start((&a_line[0 as usize]) as u64, 200)
    let st: u64 = account_stage()
    if account_noroot != 0 {
        b_s(msg.get(ptr((&k_a_hroot[0 as usize]) as u64)))
    } else if st == 0 {
        b_s(msg.get(ptr((&k_a_hname[0 as usize]) as u64)))
    } else if st == 1 {
        b_s(msg.get(ptr((&k_a_hpw[0 as usize]) as u64)))
    } else if st == 2 {
        b_s(msg.get(ptr((&k_a_hsame[0 as usize]) as u64)))
    } else {
        b_s(msg.get(ptr((&k_a_hok[0 as usize]) as u64)))
    }
    b_end()
}

fn account_write() -> bool {
    if account_on == 0 {
        return true
    }
    say(ptr((&m_account[0 as usize]) as u64))
    ulib.nl()
    let succeeded: bool = instkonto.anlegen(acct_name(), acct_name(), acct_pw1())
    if !succeeded {
        report_at(90 + instkonto.grund())
    }
    fuiscene.entry_set(K_ACCT_PW1, (&a_empty[0 as usize]) as u64)
    fuiscene.entry_set(K_ACCT_PW2, (&a_empty[0 as usize]) as u64)
    return succeeded
}
static mut a_empty: [u8; 4] = [0 as u8; 4]

fn crypt_on() -> bool {
    return which_way == 0 && fuiscene.value_of(K_CRYPT) != 0
}

fn cp1() -> u64 {
    return fuiscene.entry_text(K_CPW1)
}

fn cp2() -> u64 {
    return fuiscene.entry_text(K_CPW2)
}

fn crypt_ascii(p: u64) -> bool {
    let n: u64 = ulib.length(p)
    var i: u64 = 0
    while i < n {
        let v: u8 = *((p + i) as *mut u8)
        if (v as u64) < 32 || (v as u64) > 126 {
            return false
        }
        i = i + 1
    }
    return true
}

fn crypt_stage() -> u64 {
    if !crypt_on() {
        return 0
    }
    if cp1() == 0 || ulib.length(cp1()) < 8 || ulib.length(cp1()) > 100 {
        return 1
    }
    if !crypt_ascii(cp1()) {
        return 4
    }
    if cp2() == 0 || !ulib.streq(cp1(), cp2()) {
        return 2
    }
    return 3
}

fn crypt_valid() -> bool {
    if !crypt_on() {
        return true
    }
    return crypt_stage() == 3
}

fn build_crypt_line() {
    b_start((&crypt_line[0 as usize]) as u64, 200)
    let st: u64 = crypt_stage()
    if st == 1 {
        b_s(msg.get(ptr((&k_c_hshort[0 as usize]) as u64)))
    } else if st == 4 {
        b_s(msg.get(ptr((&k_c_hkey[0 as usize]) as u64)))
    } else if st == 2 {
        b_s(msg.get(ptr((&k_c_hsame[0 as usize]) as u64)))
    } else if st == 3 {
        b_s(msg.get(ptr((&k_c_hok[0 as usize]) as u64)))
    }
    b_end()
}

fn crypt_wipe() {
    fuiscene.entry_set(K_CPW1, (&a_empty[0 as usize]) as u64)
    fuiscene.entry_set(K_CPW2, (&a_empty[0 as usize]) as u64)
}

fn arg_value(args: u64, pre: u64, out: u64, max: u64) -> bool {
    let n: u64 = ulib.arg_count(args)
    let pl: u64 = ulib.length(pre)
    var i: u64 = 1
    while i < n {
        let a: u64 = ulib.arg_at(args, i)
        var k: u64 = 0
        var bytes_equal: bool = true
        while k < pl {
            if (*((a + k) as *mut u8)) as u64 != (*((pre + k) as *mut u8)) as u64 {
                bytes_equal = false
                k = pl
            } else {
                k = k + 1
            }
        }
        if bytes_equal && ulib.length(a) > pl {
            ulib.strncpy(out, a + pl, max)
            return true
        }
        i = i + 1
    }
    return false
}

fn way_possible() -> bool {
    if chosen >= p_count {
        return false
    }
    if !account_valid() {
        return false
    }
    if !crypt_valid() {
        return false
    }
    if which_way == 1 {
        return d_possible >= 1
    }
    if which_way == 2 {
        return reuse_ok()
    }
    return true
}

fn auto_pick() {
    var i: u64 = 0
    while i < dualkern.entry_count() && d_read != 0 {
        if dualkern.osum_target(i) {
            sel_pick(i)
            return
        }
        i = i + 1
    }
}

fn reuse_ok() -> bool {
    if d_read == 0 || !dualkern.gpt_verify() {
        return false
    }
    if d_esp_idx >= dualkern.entry_count() {
        return false
    }
    return dualkern.osum_target(sel_part)
}

fn sel_is_osum() -> bool {
    if d_read == 0 || !dualkern.gpt_verify() {
        return false
    }
    return sel_part < dualkern.entry_count() && dualkern.p_typ(sel_part) == dualkern.T_OSUM
}

fn sel_pick(idx: u64) {
    sel_part = 0xFFFFFFFFFFFFFFFF
    if d_read != 0 && dualkern.gpt_verify() && idx < dualkern.entry_count() {
        sel_part = idx
        sel_start = dualkern.p_start(idx)
        sel_end = dualkern.p_end(idx)
        say(ptr((&m_re_sel[0 as usize]) as u64))
        ulib.sayu(idx + 1)
        ulib.nl()
    }
}

fn sel_ask_text() {
    b_start((&askbuf[0 as usize]) as u64, 240)
    b_s(msg.get(ptr((&k_re_ask_a[0 as usize]) as u64)))
    var k: u64 = 0
    var more: bool = true
    while k < 35 && more {
        let ch: u64 = dualkern.p_name_ch(sel_part, k)
        if ch == 0 {
            more = false
        } else {
            b_c(ch)
            k = k + 1
        }
    }
    b_c(32)
    b_c(40)
    b_n((sel_end - sel_start + 1) / 2048)
    b_c(32)
    b_c(77)
    b_c(105)
    b_c(66)
    b_c(41)
    b_c(32)
    b_s(msg.get(ptr((&k_re_ask_b[0 as usize]) as u64)))
    b_end()
}

fn way_button_text() -> u64 {
    if which_way == 2 {
        return msg.get(ptr((&k_re_go[0 as usize]) as u64))
    }
    if which_way == 1 && d_possible == 2 {
        return msg.get(shrinkflow.key_go())
    }
    if which_way == 1 {
        return msg.get(ptr((&k_d_go[0 as usize]) as u64))
    }
    return msg.get(ptr((&k_go[0 as usize]) as u64))
}

fn build_tabs() {
    b_start((&tabtext[0 as usize]) as u64, 80)
    b_s(msg.get(ptr((&k_d_t_whole[0 as usize]) as u64)))
    b_c(9)
    b_s(msg.get(ptr((&k_d_t_beside[0 as usize]) as u64)))
    b_end()
}

fn build_status() {
    b_start((&line_buf[0 as usize]) as u64, 200)
    if p_count == 0 {
        b_s(msg.get(ptr((&k_none[0 as usize]) as u64)))
    } else if d_shrink_run != 0 {
        b_s(msg.get(shrinkflow.key_busy()))
    } else if running != 0 {
        b_s(msg.get(ptr((&k_busy[0 as usize]) as u64)))
    } else if finished != 0 {
        b_s(msg.get(ptr((&k_done[0 as usize]) as u64)))
        b_c(32)
        b_s(msg.get(ptr((&k_donehint[0 as usize]) as u64)))
    } else if chosen >= p_count {
        b_s(msg.get(ptr((&k_pick[0 as usize]) as u64)))

        b_c(32)
        b_s(msg.get(ptr((&k_priv[0 as usize]) as u64)))
    } else {
        b_s(msg.get(ptr((&k_sel[0 as usize]) as u64)))
        b_c(32)
        b_s(nptr(chosen))
        b_c(32)
        b_c(45)
        b_c(45)
        b_c(32)

        if which_way == 2 {
            b_s(msg.get(ptr((&k_re_head[0 as usize]) as u64)))
            if !reuse_ok() {
                b_c(32)
                b_s(msg.get(ptr((&k_re_none[0 as usize]) as u64)))
            }
        } else if which_way == 1 {
            b_s(msg.get(ptr((&k_d_nhead[0 as usize]) as u64)))
        } else {
            b_s(msg.get(ptr((&k_warn[0 as usize]) as u64)))
        }
    }
    b_end()
}

fn build_step() {
    b_start((&step_row[0 as usize]) as u64, 200)
    let s: u64 = st_show
    if s == 0 {
        b_end()
        return
    }
    b_n(s)
    b_c(47)
    b_n(instkern.step_count() - 1)
    b_c(32)
    if s == instkern.S_GPT {
        b_s(msg.get(ptr((&k_s_gpt[0 as usize]) as u64)))
    } else if s == instkern.S_ESP {
        b_s(msg.get(ptr((&k_s_esp[0 as usize]) as u64)))
    } else if s == instkern.S_COPY {
        b_s(msg.get(ptr((&k_s_copy[0 as usize]) as u64)))
        b_c(32)
        b_n(instkern.progress_permille() / 10)
        b_c(37)
    } else if s == instkern.S_GROW {
        b_s(msg.get(ptr((&k_s_grow[0 as usize]) as u64)))
    } else if s == instkern.S_BOOT {
        b_s(msg.get(ptr((&k_s_boot[0 as usize]) as u64)))
    } else {
        b_s(msg.get(ptr((&k_done[0 as usize]) as u64)))
    }
    b_end()
}

fn run_install(dev: u64, wstat: u64, w_step: u64) -> bool {
    if wunlock.protected(dev) {
        return false
    }
    if !wunlock.unlock(dev) {
        return false
    }
    let ok: bool = run_install_raw(dev, wstat, w_step)
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    wunlock.relock()
    return ok
}

fn run_install_raw(dev: u64, wstat: u64, w_step: u64) -> bool {
    let dst_fd: u64 = ulib.sys(ulib.SYS_OPEN, dev, ulib.O_RDWR, 0)
    if ulib.bad(dst_fd) {
        return false
    }
    let src_fd: u64 = ulib.sys(ulib.SYS_OPEN,
        ptr((&d_source[0 as usize]) as u64), 0, 0)
    if ulib.bad(src_fd) {
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        return false
    }
    let sect_count: u64 = ulib.size_of(dev) / instkern.BS
    let src_sect: u64 = ulib.size_of(ptr((&d_source[0 as usize]) as u64))
        / instkern.BS
    let esp_sector: u64 = instkern.ESP_DEFAULT

    if !instkern.plan_fits(sect_count, esp_sector) {
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }
    if instkern.check_source(src_fd) == 0 {
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }

    if !account_write() {
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }

    report_step(w_step, instkern.S_GPT)
    instrun.start_clock()

    instkern.bios_load()
    if !instkern.gpt_write(dst_fd, sect_count, esp_sector) {
        report_at(1)
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }

    let _lg: bool = instlog.open(dst_fd, sect_count, instkern.plan_esp_start())

    report_step(w_step, instkern.S_ESP)
    if !instkern.fat32_create(dst_fd, instkern.plan_esp_start(), esp_sector) {
        report_at(2)
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }

    report_step(w_step, instkern.S_COPY)
    let ofs_start: u64 = instkern.plan_ofs_start(esp_sector)
    let ofs_blocks: u64 = instkern.plan_ofs_end(sect_count) - ofs_start + 1

    var cry_off: u64 = 0
    if crypt_on() {
        if !instkern.crypt_begin(dst_fd, ofs_start, ofs_blocks, cp1(), ulib.length(cp1())) {
            report_at(3)
            crypt_wipe()
            ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
            ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
            return false
        }
        say(ptr((&m_crypt[0 as usize]) as u64))
        ulib.nl()
        cry_off = instkern.crypt_off()
    }
    if !instrun.copy_pumped(dst_fd, src_fd, ofs_start + cry_off, src_sect) {
        busy.close()
        report_at(3)
        instkern.crypt_end()
        crypt_wipe()
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }

    report_step(w_step, instkern.S_GROW)
    if instrun.grow_pumped(dst_fd, ofs_start + cry_off, ofs_blocks - cry_off) == 0 {
        busy.close()
        report_at(4)
        instkern.crypt_end()
        crypt_wipe()
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }
    instkern.crypt_end()
    crypt_wipe()
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    instlog.close()
    ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)

    report_step(w_step, instkern.S_BOOT)
    instrun.show_boot()
    esp_name(dev)

    say(ptr((&m_esp[0 as usize]) as u64))
    say(ptr((&d_esp[0 as usize]) as u64))
    ulib.nl()
    if !bootloader() {
        busy.close()
        report_at(5)
        return false
    }
    busy.close()
    return true
}

fn install_beside(dev: u64, wstat: u64, w_step: u64) -> bool {
    if wunlock.protected(dev) {
        return false
    }
    if !wunlock.unlock(dev) {
        return false
    }
    let ok: bool = install_beside_raw(dev, wstat, w_step)
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    wunlock.relock()
    return ok
}

fn install_beside_raw(dev: u64, wstat: u64, w_step: u64) -> bool {

    let src_fd: u64 = ulib.sys(ulib.SYS_OPEN,
        ptr((&d_source[0 as usize]) as u64), 0, 0)
    if ulib.bad(src_fd) {
        report_at(70)
        return false
    }
    if instkern.check_source(src_fd) == 0 {
        report_at(71)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }
    let src_sect: u64 = ulib.size_of(ptr((&d_source[0 as usize]) as u64))
        / instkern.BS

    if !account_write() {
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }

    let dst_fd: u64 = ulib.sys(ulib.SYS_OPEN, dev, ulib.O_RDWR, 0)
    if ulib.bad(dst_fd) {
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        report_at(72)
        return false
    }
    let sect_count: u64 = ulib.size_of(dev) / instkern.BS

    let n: u64 = dualkern.read_table(dst_fd, sect_count)
    if n == 0 || !dualkern.gpt_verify() {
        report_at(73)
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }
    if !dualkern.find_gap(65536) {
        report_at(74)
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }
    let from_pos: u64 = dualkern.gap_start()
    let to_pos: u64 = dualkern.gap_end()
    let espi: u64 = dualkern.find_esp()
    if espi >= dualkern.entry_count() {
        report_at(75)
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }
    if !dualkern.esp_big_enough(espi) {
        report_at(76)
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }

    if to_pos - from_pos + 1 < src_sect {
        report_at(77)
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }

    report_step(w_step, instkern.S_GPT)
    let nr: u64 = dualkern.write_beside(dst_fd, from_pos, to_pos)
    if nr == 0 {
        report_at(78)
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }
    d_new_nr = nr
    let _lg: bool = instlog.open(dst_fd, sect_count, first_start())
    say(ptr((&m_d_new[0 as usize]) as u64))
    say_space()
    ulib.sayu(nr)
    say_space()
    ulib.sayu(from_pos)
    say_space()
    ulib.sayu(to_pos)
    ulib.nl()

    report_step(w_step, instkern.S_COPY)
    if !instrun.copy_pumped(dst_fd, src_fd, from_pos, src_sect) {
        busy.close()
        report_at(79)
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }

    report_step(w_step, instkern.S_GROW)
    if instrun.grow_pumped(dst_fd, from_pos, to_pos - from_pos + 1) == 0 {
        busy.close()
        report_at(80)
        ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    instlog.close()
    ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)

    report_step(w_step, instkern.S_BOOT)
    instrun.show_boot()

    esp_name_nr(dev, espi + 1)
    say(ptr((&m_esp[0 as usize]) as u64))
    say(ptr((&d_esp[0 as usize]) as u64))
    ulib.nl()
    if !bootloader_dual() {
        busy.close()
        return false
    }
    busy.close()
    return true
}

fn first_start() -> u64 {
    var lo: u64 = 0xFFFFFFFFFFFFFFFF
    var i: u64 = 0
    while i < dualkern.entry_count() {
        if dualkern.p_start(i) < lo {
            lo = dualkern.p_start(i)
        }
        i = i + 1
    }
    return lo
}

fn install_osum(dev: u64, wstat: u64, w_step: u64) -> bool {
    if wunlock.protected(dev) {
        return false
    }
    if !wunlock.unlock(dev) {
        return false
    }
    instrun.start_clock()
    let ok: bool = install_osum_raw(dev, wstat, w_step)
    instlog.close()
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    wunlock.relock()
    return ok
}

fn find_target() -> u64 {
    var i: u64 = 0
    while i < dualkern.entry_count() {
        if dualkern.p_start(i) == sel_start && dualkern.p_end(i) == sel_end && dualkern.osum_target(i) {
            return i
        }
        i = i + 1
    }
    return 0xFFFFFFFFFFFFFFFF
}

fn close_two(a: u64, b: u64) {
    ulib.sys(ulib.SYS_CLOSE, a, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, b, 0, 0)
}

fn install_osum_raw(dev: u64, wstat: u64, w_step: u64) -> bool {
    let src_fd: u64 = ulib.sys(ulib.SYS_OPEN, ptr((&d_source[0 as usize]) as u64), 0, 0)
    if ulib.bad(src_fd) {
        report_at(70)
        return false
    }
    if instkern.check_source(src_fd) == 0 {
        report_at(71)
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }
    let src_sect: u64 = ulib.size_of(ptr((&d_source[0 as usize]) as u64)) / instkern.BS
    if !account_write() {
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        return false
    }
    let dst_fd: u64 = ulib.sys(ulib.SYS_OPEN, dev, ulib.O_RDWR, 0)
    if ulib.bad(dst_fd) {
        ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)
        report_at(72)
        return false
    }
    let sect_count: u64 = ulib.size_of(dev) / instkern.BS
    let n: u64 = dualkern.read_table(dst_fd, sect_count)
    if n == 0 || !dualkern.gpt_verify() {
        report_at(73)
        close_two(dst_fd, src_fd)
        return false
    }
    let ti: u64 = find_target()
    if ti >= dualkern.entry_count() {
        report_at(81)
        close_two(dst_fd, src_fd)
        return false
    }
    let espi: u64 = dualkern.find_esp()
    if espi >= dualkern.entry_count() || !dualkern.esp_big_enough(espi) {
        report_at(75)
        close_two(dst_fd, src_fd)
        return false
    }
    let from_pos: u64 = dualkern.p_start(ti)
    let to_pos: u64 = dualkern.p_end(ti)
    if to_pos - from_pos + 1 < src_sect {
        report_at(77)
        close_two(dst_fd, src_fd)
        return false
    }
    report_step(w_step, instkern.S_GPT)
    d_new_nr = dualkern.p_nr(ti)
    let _lg: bool = instlog.open(dst_fd, sect_count, first_start())
    say(ptr((&m_d_new[0 as usize]) as u64))
    say_space()
    ulib.sayu(d_new_nr)
    say_space()
    ulib.sayu(from_pos)
    say_space()
    ulib.sayu(to_pos)
    ulib.nl()
    report_step(w_step, instkern.S_COPY)
    if !instrun.copy_pumped(dst_fd, src_fd, from_pos, src_sect) {
        busy.close()
        report_at(79)
        close_two(dst_fd, src_fd)
        return false
    }
    report_step(w_step, instkern.S_GROW)
    if instrun.grow_pumped(dst_fd, from_pos, to_pos - from_pos + 1) == 0 {
        busy.close()
        report_at(80)
        close_two(dst_fd, src_fd)
        return false
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    instlog.close()
    close_two(dst_fd, src_fd)
    report_step(w_step, instkern.S_BOOT)
    instrun.show_boot()
    esp_name_nr(dev, dualkern.p_nr(espi))
    say(ptr((&m_esp[0 as usize]) as u64))
    say(ptr((&d_esp[0 as usize]) as u64))
    ulib.nl()
    let ok: bool = bootloader_dual()
    busy.close()
    return ok
}

fn delete_leftover(dev: u64) -> bool {
    if wunlock.protected(dev) {
        return false
    }
    if !wunlock.unlock(dev) {
        return false
    }
    say(ptr((&m_re_del[0 as usize]) as u64))
    ulib.nl()
    var ok: bool = false
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, dev, ulib.O_RDWR, 0)
    if !ulib.bad(fd) {
        let sect_count: u64 = ulib.size_of(dev) / instkern.BS
        if dualkern.read_table(fd, sect_count) != 0 && dualkern.gpt_verify() {
            let ti: u64 = find_target_any()
            if ti < dualkern.entry_count() {
                ok = dualkern.delete_entry(fd, ti)
            }
        }
        ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    }
    wunlock.relock()
    fetch_table(dev)
    return ok
}

fn find_target_any() -> u64 {
    var i: u64 = 0
    while i < dualkern.entry_count() {
        if dualkern.p_start(i) == sel_start && dualkern.p_end(i) == sel_end && dualkern.p_typ(i) == dualkern.T_OSUM {
            return i
        }
        i = i + 1
    }
    return 0xFFFFFFFFFFFFFFFF
}

fn report_at(n: u64) {
    say(ptr((&m_at[0 as usize]) as u64))
    ulib.sayu(n)
    ulib.nl()
}

fn report_step(w_step: u64, nr: u64) {
    st_show = nr
    build_step()
    fuiscene.repaint_now()
    say(ptr((&m_step[0 as usize]) as u64))
    ulib.sayu(nr)
    say_space()
    ulib.sayu(instkern.progress_permille())
    ulib.nl()
}

static mut p_efi: [u8; 6] = "/efi\0\0"
static mut p_efi_efi: [u8; 10] = "/efi/EFI\0\0"
static mut p_efi_boot: [u8; 16] = "/efi/EFI/BOOT\0\0\0"
static mut p_efi_lim: [u8; 20] = "/efi/limine.conf\0\0\0\0"
static mut p_efi_kern: [u8; 16] = "/efi/osum.mb\0\0\0\0"
static mut p_src_bios: [u8; 24] = "/boot/limine-bios.sys\0\0\0"
static mut p_efi_bios: [u8; 24] = "/efi/limine-bios.sys\0\0\0\0"
static mut m_bios_yes: [u8; 24] = "installer: bios stages\0\0"
static mut m_bios_sys: [u8; 30] = "installer: no limine-bios.sys\0"
static mut p_efi_ldr: [u8; 28] = "/efi/EFI/BOOT/BOOTX64.EFI\0\0\0"
static mut p_src_lim: [u8; 20] = "/boot/limine.conf\0\0\0"
static mut p_src_kern: [u8; 16] = "/boot/osum.mb\0\0\0"
static mut p_src_ldr: [u8; 20] = "/boot/BOOTX64.EFI\0\0\0"
static mut t_vfat: [u8; 6] = "vfat\0\0"

static mut d_esp: [u8; 24] = [0 as u8; 24]

static mut lim_text: [u8; 310] = "timeout: 5\ndefault_entry: 1\n\n/OrientOS\n    protocol: multiboot1\n    path: boot():/osum.mb\n    cmdline: osum vfs gfx disp audio wm wig desk wmshell nobootterm wmdauer absturzhalt nopuls tz=60 tzrule=eu usb hidgen nic nip=169.254.10.1/16 nsvc=0 nwait=0 dhcp jarvis nosched noproc nofs anmeldung absturzneustart\n\0"

fn start_file() -> bool {
    ulib.sys(ulib.SYS_UNLINK, ptr((&p_efi_lim[0 as usize]) as u64), 0, 0)
    let f: u64 = ulib.sys(ulib.SYS_OPEN,
        ptr((&p_efi_lim[0 as usize]) as u64), ulib.O_MAKE, 0)
    if ulib.bad(f) {
        return false
    }
    let n: u64 = ulib.length(ptr((&lim_text[0 as usize]) as u64))
    let w: u64 = ulib.sys(ulib.SYS_WRITE, f,
        ptr((&lim_text[0 as usize]) as u64), n)
    ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
    if ulib.bad(w) || w != n {
        return false
    }
    return true
}

fn esp_name_nr(dev: u64, nr: u64) {
    ulib.strcpy(ptr((&d_esp[0 as usize]) as u64), dev)
    let n: u64 = ulib.length(ptr((&d_esp[0 as usize]) as u64))
    if n + 2 < 24 && nr >= 1 && nr <= 9 {
        __mmio_write8((ptr((&d_esp[0 as usize]) as u64) + n) as *mut u8,
            (48 + nr) as u8)
        __mmio_write8((ptr((&d_esp[0 as usize]) as u64) + n + 1) as *mut u8,
            0 as u8)
    }
}

fn esp_name(dev: u64) {
    ulib.strcpy(ptr((&d_esp[0 as usize]) as u64), dev)
    let n: u64 = ulib.length(ptr((&d_esp[0 as usize]) as u64))
    if n + 2 < 24 {
        __mmio_write8((ptr((&d_esp[0 as usize]) as u64) + n) as *mut u8, 49 as u8)
        __mmio_write8((ptr((&d_esp[0 as usize]) as u64) + n + 1) as *mut u8, 0 as u8)
    }
}

static mut p_efi_os: [u8; 20] = "/efi/EFI/orientos\0\0\0"
static mut p_efi_oskern: [u8; 28] = "/efi/EFI/orientos/osum.mb\0\0\0"
static mut p_efi_osldr: [u8; 32] = "/efi/EFI/orientos/BOOTX64.EFI\0\0\0"

static mut p_foreign_bm: [u8; 40] = "/efi/EFI/Microsoft/Boot/bootmgfw.efi\0\0\0\0"

static mut lim_dual1: [u8; 323] = "timeout: 5\ndefault_entry: 1\n\n/OrientOS\n    protocol: multiboot1\n    path: boot():/EFI/orientos/osum.mb\n    cmdline: osum vfs gfx disp audio wm wig desk wmshell nobootterm wmdauer absturzhalt nopuls tz=60 tzrule=eu usb hidgen nic nip=169.254.10.1/16 nsvc=0 nwait=0 dhcp jarvis nosched noproc nofs anmeldung absturzneustart\n\0"
static mut lim_dual2: [u8; 102] = "\n/Windows Boot Manager\n    protocol: efi_chainload\n    path: boot():/EFI/Microsoft/Boot/bootmgfw.efi\n\0"

fn file_exists(path: u64) -> bool {
    let f: u64 = ulib.sys(ulib.SYS_OPEN, path, 0, 0)
    if ulib.bad(f) {
        return false
    }
    ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
    return true
}

fn start_file_dual() -> u64 {
    let foreign: bool = file_exists(ptr((&p_foreign_bm[0 as usize]) as u64))
    ulib.sys(ulib.SYS_UNLINK, ptr((&p_efi_lim[0 as usize]) as u64), 0, 0)
    let f: u64 = ulib.sys(ulib.SYS_OPEN,
        ptr((&p_efi_lim[0 as usize]) as u64), ulib.O_MAKE, 0)
    if ulib.bad(f) {
        return 0
    }
    let n1: u64 = ulib.length(ptr((&lim_dual1[0 as usize]) as u64))
    let w1: u64 = ulib.sys(ulib.SYS_WRITE, f,
        ptr((&lim_dual1[0 as usize]) as u64), n1)
    if ulib.bad(w1) || w1 != n1 {
        ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
        return 0
    }
    var how_many: u64 = 1
    if foreign {
        let n2: u64 = ulib.length(ptr((&lim_dual2[0 as usize]) as u64))
        let w2: u64 = ulib.sys(ulib.SYS_WRITE, f,
            ptr((&lim_dual2[0 as usize]) as u64), n2)
        if ulib.bad(w2) || w2 != n2 {
            ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
            return 0
        }
        how_many = 2
    }
    ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
    return how_many
}

fn bootloader_dual() -> bool {
    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi[0 as usize]) as u64), 0, 0)
    let m: u64 = ulib.sys4(ulib.SYS_VMOUNT,
        ptr((&d_esp[0 as usize]) as u64),
        ptr((&p_efi[0 as usize]) as u64),
        ptr((&t_vfat[0 as usize]) as u64), 0)
    if ulib.bad(m) {
        report_at(60)
        return false
    }

    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi_efi[0 as usize]) as u64), 0, 0)
    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi_os[0 as usize]) as u64), 0, 0)

    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi_boot[0 as usize]) as u64), 0, 0)
    var succeeded: bool = true
    if !instkern.copy_file(instkern.kernel_source(),
        ptr((&p_efi_oskern[0 as usize]) as u64)) {
        report_at(61)
        succeeded = false
    }
    if succeeded && !instkern.copy_file(ptr((&p_src_ldr[0 as usize]) as u64),
        ptr((&p_efi_osldr[0 as usize]) as u64)) {
        report_at(62)
        succeeded = false
    }

    if succeeded && !instkern.copy_file(ptr((&p_src_ldr[0 as usize]) as u64),
        ptr((&p_efi_ldr[0 as usize]) as u64)) {
        report_at(63)
        succeeded = false
    }
    if succeeded {
        let how_many: u64 = start_file_dual()
        say(ptr((&m_d_menu[0 as usize]) as u64))
        ulib.sayu(how_many)
        ulib.nl()
        if how_many == 0 {
            report_at(64)
            succeeded = false
        }
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.sys(ulib.SYS_UMOUNT2, ptr((&p_efi[0 as usize]) as u64), 0, 0)
    return succeeded
}

fn bootloader() -> bool {
    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi[0 as usize]) as u64), 0, 0)
    let m: u64 = ulib.sys4(ulib.SYS_VMOUNT,
        ptr((&d_esp[0 as usize]) as u64),
        ptr((&p_efi[0 as usize]) as u64),
        ptr((&t_vfat[0 as usize]) as u64), 0)
    if ulib.bad(m) {
        report_at(50)
        return false
    }
    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi_efi[0 as usize]) as u64), 0, 0)
    ulib.sys(ulib.SYS_MKDIR, ptr((&p_efi_boot[0 as usize]) as u64), 0, 0)
    var succeeded: bool = true
    if !instkern.copy_file(ptr((&p_src_ldr[0 as usize]) as u64),
        ptr((&p_efi_ldr[0 as usize]) as u64)) {
        report_at(51)
        succeeded = false
    }
    if succeeded && !instkern.copy_file(instkern.kernel_source(),
        ptr((&p_efi_kern[0 as usize]) as u64)) {
        report_at(52)
        succeeded = false
    }

    if succeeded && instkern.bios_present() {
        if instkern.copy_file(ptr((&p_src_bios[0 as usize]) as u64),
            ptr((&p_efi_bios[0 as usize]) as u64)) {
            say(ptr((&m_bios_yes[0 as usize]) as u64))
            ulib.nl()
        } else {
            say(ptr((&m_bios_sys[0 as usize]) as u64))
            ulib.nl()
        }
    }

    if succeeded && !start_file() {
        report_at(53)
        succeeded = false
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.sys(ulib.SYS_UMOUNT2, ptr((&p_efi[0 as usize]) as u64), 0, 0)
    return succeeded
}

fn arg_has(args: u64, was: u64) -> bool {
    let n: u64 = ulib.arg_count(args)
    var i: u64 = 1
    while i < n {
        if ulib.streq(ulib.arg_at(args, i), was) {
            return true
        }
        i = i + 1
    }
    return false
}

const K_TTAB: u64 = 1
const K_TAB0: u64 = 10
const K_TAB1: u64 = 11
const K_TAB2: u64 = 12
const K_DEL: u64 = 13
const K_PTAB: u64 = 3
const K_SEARCH: u64 = 4
const K_GO: u64 = 5

static mut k_dlg_yes: [u8; 11] = "dialog.yes\0"
static mut k_dlg_no: [u8; 10] = "dialog.no\0"

fn build() {
    let col: usize = fuiscene.root()
    let _h: usize = fuiscene.label(col, msg.get(ptr((&k_head[0 as usize]) as u64)))
    let _t: usize = fuiscene.table_blob(col, K_TTAB, BW - 16, 112, NCOL,
        (&tblob[0 as usize]) as u64)

    let tabs: usize = fuiscene.row(col)
    let _r0: usize = fuiscene.tab(tabs, msg.get(ptr((&k_d_t_whole[0 as usize]) as u64)),
        K_TAB0, which_way == 0)
    let _r1: usize = fuiscene.tab(tabs, msg.get(ptr((&k_d_t_beside[0 as usize]) as u64)),
        K_TAB1, which_way == 1)
    let _r2: usize = fuiscene.tab(tabs, msg.get(ptr((&k_re_tab[0 as usize]) as u64)),
        K_TAB2, which_way == 2)
    if which_way >= 1 {
        let _p: usize = fuiscene.table_blob(col, K_PTAB, BW - 16, 152, PCOL,
            (&pblob[0 as usize]) as u64)
        let _f: usize = fuiscene.label(col, (&free_row[0 as usize]) as u64)
        let _st: usize = fuiscene.label(col, (&stat_row[0 as usize]) as u64)
        let _e: usize = fuiscene.label(col, (&esp_row[0 as usize]) as u64)
    }
    let _s: usize = fuiscene.label(col, (&line_buf[0 as usize]) as u64)
    if d_shrink_run != 0 {
        let _sp: usize = fuiscene.progress(col, BW - 16, d_shrink_pct)
    }
    let _c: usize = fuiscene.label(col, (&step_row[0 as usize]) as u64)

    if account_on != 0 {
        let lw: u64 = 220
        let fw: u64 = BW - 16 - lw - 8
        let r1: usize = fuiscene.row(col)
        fuiscene.set_gap(r1, 8)
        let l1: usize = fuiscene.label(r1, msg.get(ptr((&k_a_name[0 as usize]) as u64)))
        fuiscene.set_size(l1, lw, 24)
        let _e1: usize = fuiscene.entry(r1, K_ACCT_NAME, fw, 0)
        let r2: usize = fuiscene.row(col)
        fuiscene.set_gap(r2, 8)
        let l2: usize = fuiscene.label(r2, msg.get(ptr((&k_a_pw1[0 as usize]) as u64)))
        fuiscene.set_size(l2, lw, 24)
        let _e2: usize = fuiscene.entry(r2, K_ACCT_PW1, fw, 0)
        let r3: usize = fuiscene.row(col)
        fuiscene.set_gap(r3, 8)
        let l3: usize = fuiscene.label(r3, msg.get(ptr((&k_a_pw2[0 as usize]) as u64)))
        fuiscene.set_size(l3, lw, 24)
        let _e3: usize = fuiscene.entry(r3, K_ACCT_PW2, fw, 0)
        fuiscene.entry_secret(K_ACCT_PW1, true)
        fuiscene.entry_secret(K_ACCT_PW2, true)
    }
    if which_way == 0 {
        let _cc: usize = fuiscene.check(col, msg.get(ptr((&k_c_check[0 as usize]) as u64)),
            K_CRYPT, fuiscene.value_of(K_CRYPT) != 0)
        if fuiscene.value_of(K_CRYPT) != 0 {
            let clw: u64 = 220
            let cfw: u64 = BW - 16 - clw - 8
            let cr1: usize = fuiscene.row(col)
            fuiscene.set_gap(cr1, 8)
            let cl1: usize = fuiscene.label(cr1, msg.get(ptr((&k_c_pw1[0 as usize]) as u64)))
            fuiscene.set_size(cl1, clw, 24)
            let _ce1: usize = fuiscene.entry(cr1, K_CPW1, cfw, 0)
            let cr2: usize = fuiscene.row(col)
            fuiscene.set_gap(cr2, 8)
            let cl2: usize = fuiscene.label(cr2, msg.get(ptr((&k_c_pw2[0 as usize]) as u64)))
            fuiscene.set_size(cl2, clw, 24)
            let _ce2: usize = fuiscene.entry(cr2, K_CPW2, cfw, 0)
            fuiscene.entry_secret(K_CPW1, true)
            fuiscene.entry_secret(K_CPW2, true)
            let _ch: usize = fuiscene.label(col, (&crypt_line[0 as usize]) as u64)
        }
    }
    let _kh: usize = fuiscene.label(col, (&a_line[0 as usize]) as u64)

    let t_search: u64 = msg.get(ptr((&k_refresh[0 as usize]) as u64))
    let t_go: u64 = way_button_text()
    var w_search: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), t_search,
        ulib.length(t_search)) + 40
    w_search = (w_search + 3) / 4 * 4
    var w_go: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), t_go,
        ulib.length(t_go)) + 40
    w_go = (w_go + 3) / 4 * 4
    let t_del: u64 = msg.get(ptr((&k_re_del[0 as usize]) as u64))
    var w_del: u64 = 0
    if which_way == 2 {
        w_del = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), t_del, ulib.length(t_del)) + 40
        w_del = (w_del + 3) / 4 * 4 + 8
    }
    let bar: usize = fuiscene.row(col)
    fuiscene.set_gap(bar, 8)
    let _sp: usize = fuiscene.space(bar, BW - 16 - w_search - w_go - w_del - 16, 4)
    if which_way == 2 {
        let bd: usize = fuiscene.button(bar, t_del, K_DEL)
        fuiscene.set_size(bd, w_del - 8, 36)
        fuiscene.set_enabled(bd, running == 0 && sel_is_osum())
    }
    let bs: usize = fuiscene.button(bar, t_search, K_SEARCH)
    fuiscene.set_size(bs, w_search, 36)

    let bg: usize = fuiscene.button_main(bar, t_go, K_GO)
    fuiscene.set_size(bg, w_go, 36)
    fuiscene.set_enabled(bs, running == 0)
    fuiscene.set_enabled(bg, running == 0 && way_possible())
}

fn show_choice() {
    if chosen < p_count {
        fuiscene.table_set_sel(K_TTAB, chosen)
    } else {
        fuiscene.table_set_sel(K_TTAB, fuiscene.HEAD_ROW)
    }
}

fn u_start(args: u64) -> u64 {

    say(ptr((&m_args[0 as usize]) as u64))
    ulib.sayu(ulib.arg_count(args))
    var ai: u64 = 0
    while ai < ulib.arg_count(args) {
        say_space()
        say(ulib.arg_at(args, ai))
        ai = ai + 1
    }
    ulib.nl()
    let nohit: bool = arg_has(args, ptr((&a_nohit[0 as usize]) as u64))

    let show_only: bool = arg_has(args, ptr((&a_show[0 as usize]) as u64))

    let immediately: bool = arg_has(args, ptr((&a_now[0 as usize]) as u64))
    let second: bool = arg_has(args, ptr((&a_second[0 as usize]) as u64))
    let beside: bool = arg_has(args, ptr((&a_beside[0 as usize]) as u64))
    let reuse: bool = arg_has(args, ptr((&a_reuse[0 as usize]) as u64))

    if immediately {
        if arg_value(args, ptr((&a_acct_name[0 as usize]) as u64), (&a_name[0 as usize]) as u64, 63)
            && arg_value(args, ptr((&a_kpw[0 as usize]) as u64), (&a_pw1[0 as usize]) as u64, 127) {
            account_on = 1
        } else {
            account_on = 0
        }
    } else if ulib.sys(107, 0, 0, 0) != 0 {
        account_on = 0
        account_noroot = 1
    }
    fuiscene.set_nohit(nohit)

    let _mk: u64 = msg.init()

    if beside {
        which_way = 1
    }
    if reuse {
        which_way = 2
    }
    scan_disks()
    if p_count == 1 {
        chosen = 0
        fetch_table(nptr(0))
        if reuse {
            auto_pick()
        }
    }
    build_table()
    build_tabs()
    build_ptable()
    build_dual_rows()
    build_status()

    t_columns[(0) as usize] = 120
    t_columns[(1) as usize] = 260
    t_columns[(2) as usize] = 100
    t_columns[(3) as usize] = 200
    p_columns[(0) as usize] = 48
    p_columns[(1) as usize] = 120
    p_columns[(2) as usize] = 120
    p_columns[(3) as usize] = 180
    p_columns[(4) as usize] = 232

    if !fuiscene.open(40, 40, BW, BH, msg.get(ptr((&k_title[0 as usize]) as u64)),
        build) {
        say(ptr((&m_nowm[0 as usize]) as u64))
        ulib.nl()
        return 1
    }
    fuiscene.set_app(ptr((&m_self[0 as usize]) as u64))

    if immediately && arg_value(args, ptr((&a_cpw[0 as usize]) as u64), (&a_cpwv[0 as usize]) as u64, 127) {

        let _k1: u64 = fuiscene.pump()
        fuiscene.set_value(K_CRYPT, 1)
        let _kc: u64 = fuiscene.pump()
        fuiscene.entry_set(K_CPW1, (&a_cpwv[0 as usize]) as u64)
        fuiscene.entry_set(K_CPW2, (&a_cpwv[0 as usize]) as u64)
        ulib.fill((&a_cpwv[0 as usize]) as u64, 0, 128)
    }
    if account_on != 0 && immediately {
        fuiscene.entry_set(K_ACCT_NAME, (&a_name[0 as usize]) as u64)
        fuiscene.entry_set(K_ACCT_PW1, (&a_pw1[0 as usize]) as u64)
        fuiscene.entry_set(K_ACCT_PW2, (&a_pw1[0 as usize]) as u64)
        ulib.fill((&a_pw1[0 as usize]) as u64, 0, 128)
    }
    build_account_line()

    let _k0: u64 = fuiscene.pump()
    var ci: u64 = 0
    while ci < NCOL {
        fuiscene.table_colw(K_TTAB, ci, t_columns[(ci) as usize])
        ci = ci + 1
    }
    var cj: u64 = 0
    while cj < PCOL {
        fuiscene.table_colw(K_PTAB, cj, p_columns[(cj) as usize])
        cj = cj + 1
    }
    fuiscene.table_single(K_TTAB, true)
    show_choice()
    fuiscene.refresh()
    view_dump()

    say(ptr((&m_ready[0 as usize]) as u64))
    ulib.sayu(p_count)
    ulib.nl()

    let _k1: u64 = fuiscene.pump()
    fuiscene.say_rects(ptr((&m_self[0 as usize]) as u64))

    if show_only {
        return 0
    }

    var start_now: bool = false
    if immediately {
        if chosen >= p_count && p_count > 0 {
            chosen = 0
        }

        if second && p_count > 1 {
            chosen = 1
        }
        if chosen < p_count {

            fetch_table(nptr(chosen))
            if reuse {
                auto_pick()
            }
            build_ptable()
            build_dual_rows()
            fuiscene.table_set_blob(K_PTAB, (&pblob[0 as usize]) as u64)
            show_choice()
            fuiscene.refresh()
            let _k2: u64 = fuiscene.pump()

            if which_way == 1 && d_possible == 2 {
                let _sh: bool = shrink_now(nptr(chosen))
                rebuild_view()
                let _k3: u64 = fuiscene.pump()
            }
            if which_way == 2 && !reuse_ok() {
                say(ptr((&m_d_no[0 as usize]) as u64))
                ulib.nl()
                return 0
            }
            if which_way == 2 && arg_has(args, ptr((&a_rmleft[0 as usize]) as u64)) {
                var del_ok: u64 = 0
                if delete_leftover(nptr(chosen)) {
                    del_ok = 1
                }
                rebuild_view()
                say(ptr((&m_deleted[0 as usize]) as u64))
                ulib.sayu(del_ok)
                ulib.nl()
                return 0
            }
            if which_way == 1 && d_possible != 1 {
                say(ptr((&m_d_no[0 as usize]) as u64))
                say_space()
                ulib.sayu(dualkern.reason_code())
                ulib.nl()
                return 0
            }
            question = 2
            start_now = true
        }
    }

    var rounds: u64 = 0
    while fuiscene.alive() && rounds < 1000000000000 {
        rounds = rounds + 1

        if start_now && running == 0 && finished == 0 {
            start_now = false
            running = 1
            build_status()
            fuiscene.refresh()
            fuiscene.repaint_now()
            say(ptr((&m_go[0 as usize]) as u64))
            ulib.nl()

            var succeeded: bool = false
            if which_way == 2 {
                succeeded = install_osum(nptr(chosen), 0, 0)
            } else if which_way == 1 {
                succeeded = install_beside(nptr(chosen), 0, 0)
            } else {
                succeeded = run_install(nptr(chosen), 0, 0)
            }
            running = 0
            if succeeded {
                finished = 1
                say(ptr((&m_ok[0 as usize]) as u64))

                say_space()
                ulib.sayu(instkern.rewritten())
            } else {
                finished = 2
                say(ptr((&m_fail[0 as usize]) as u64))
                say_space()
                ulib.sayu(instkern.error_at())
            }
            ulib.nl()
            if finished == 2 {
                b_start((&line_buf[0 as usize]) as u64, 200)
                b_s(msg.get(ptr((&k_fail[0 as usize]) as u64)))
                b_end()
            } else {
                build_status()
            }
            build_step()
            fuiscene.refresh()
            question = 0
            if immediately {
                return 0
            }
        }

        let id: u64 = fuiscene.pump()

        if running == 0 && finished == 0 && account_on != 0 {
            let ks: u64 = account_stage()
            if ks != account_ks {
                account_ks = ks
                say(ptr((&m_account_state[0 as usize]) as u64))
                ulib.sayu(ks)
                say(ptr((&m_account_go[0 as usize]) as u64))
                if way_possible() {
                    ulib.sayu(1)
                } else {
                    ulib.sayu(0)
                }
                ulib.nl()
                build_account_line()
                fuiscene.refresh()
            }
        }
        if running == 0 && finished == 0 {
            var cs: u64 = crypt_stage()
            if fuiscene.value_of(K_CRYPT) != 0 {
                cs = cs + 10
            }
            if cs != crypt_ks {
                crypt_ks = cs
                build_crypt_line()
                fuiscene.refresh()
            }
        }
        if id == K_SEARCH {
            scan_disks()
            chosen = 0xFFFFFFFFFFFFFFFF
            finished = 0
            build_table()
            fuiscene.table_set_blob(K_TTAB, (&tblob[0 as usize]) as u64)
            build_status()
            show_choice()
            fuiscene.refresh()
        } else if id == K_PTAB {
            sel_pick(fuiscene.table_sel(K_PTAB))
            build_status()
            fuiscene.refresh()
        } else if id == K_DEL && sel_is_osum() && running == 0 {
            question = 5
            sel_ask_text()
            fuiscene.dialog_open(
                msg.get(ptr((&k_re_del_t[0 as usize]) as u64)),
                (&askbuf[0 as usize]) as u64,
                msg.get(ptr((&k_dlg_yes[0 as usize]) as u64)),
                msg.get(ptr((&k_dlg_no[0 as usize]) as u64)))
        } else if id == K_GO && way_possible() && running == 0 {
            if which_way == 2 {
                question = 4
                sel_ask_text()
                fuiscene.dialog_open(
                    msg.get(ptr((&k_re_ask_t[0 as usize]) as u64)),
                    (&askbuf[0 as usize]) as u64,
                    msg.get(ptr((&k_dlg_yes[0 as usize]) as u64)),
                    msg.get(ptr((&k_dlg_no[0 as usize]) as u64)))
                say(ptr((&m_ask[0 as usize]) as u64))
                ulib.sayu(4)
                ulib.nl()
            } else if which_way == 1 && d_possible == 2 {
                question = 3
                d_shrink_fail = 0
                shrink_ask_text()
                fuiscene.dialog_open(
                    msg.get(shrinkflow.key_ask_title()),
                    (&shrinktext[0 as usize]) as u64,
                    msg.get(ptr((&k_dlg_yes[0 as usize]) as u64)),
                    msg.get(ptr((&k_dlg_no[0 as usize]) as u64)))
                say(ptr((&m_ask[0 as usize]) as u64))
                ulib.sayu(3)
                ulib.nl()
            } else if which_way == 1 {

                question = 2
                fuiscene.dialog_open(
                    msg.get(ptr((&k_d_askt[0 as usize]) as u64)),
                    msg.get(ptr((&k_d_askx[0 as usize]) as u64)),
                    msg.get(ptr((&k_dlg_yes[0 as usize]) as u64)),
                    msg.get(ptr((&k_dlg_no[0 as usize]) as u64)))
                say(ptr((&m_ask[0 as usize]) as u64))
                ulib.sayu(9)
                ulib.nl()
            } else {

                question = 1
                fuiscene.dialog_open(
                    msg.get(ptr((&k_ask1t[0 as usize]) as u64)),
                    msg.get(ptr((&k_ask1x[0 as usize]) as u64)),
                    msg.get(ptr((&k_dlg_yes[0 as usize]) as u64)),
                    msg.get(ptr((&k_dlg_no[0 as usize]) as u64)))
                say(ptr((&m_ask[0 as usize]) as u64))
                ulib.sayu(1)
                ulib.nl()
            }
        } else if id == K_TTAB {
            let idx: u64 = fuiscene.table_sel(K_TTAB)
            if idx < p_count {
                chosen = idx
                say(ptr((&m_pick[0 as usize]) as u64))
                say_space()
                say(nptr(chosen))
                ulib.nl()

                d_shrink_fail = 0
                sel_part = 0xFFFFFFFFFFFFFFFF
                fetch_table(nptr(chosen))
                build_ptable()
                build_dual_rows()
                fuiscene.table_set_blob(K_PTAB, (&pblob[0 as usize]) as u64)
                build_status()
                fuiscene.refresh()
            }
        } else if id == K_TAB0 || id == K_TAB1 || id == K_TAB2 {

            which_way = id - K_TAB0
            say(ptr((&m_d_gone[0 as usize]) as u64))
            ulib.sayu(which_way)
            ulib.nl()
            build_status()
            fuiscene.refresh()
        } else if id == fuiscene.KEY_DIALOG {

            let confirmed: bool = fuiscene.dialog_result() == 1
            if confirmed && question == 3 {
                question = 0
                let done: bool = shrink_now(nptr(chosen))
                rebuild_view()
                if done && d_possible == 1 {
                    question = 2
                    fuiscene.dialog_open(
                        msg.get(ptr((&k_d_askt[0 as usize]) as u64)),
                        msg.get(ptr((&k_d_askx[0 as usize]) as u64)),
                        msg.get(ptr((&k_dlg_yes[0 as usize]) as u64)),
                        msg.get(ptr((&k_dlg_no[0 as usize]) as u64)))
                    say(ptr((&m_ask[0 as usize]) as u64))
                    ulib.sayu(9)
                    ulib.nl()
                }
            } else if confirmed && question == 1 {

                question = 2
                fuiscene.dialog_open(
                    msg.get(ptr((&k_ask2t[0 as usize]) as u64)),
                    msg.get(ptr((&k_ask2x[0 as usize]) as u64)),
                    msg.get(ptr((&k_dlg_yes[0 as usize]) as u64)),
                    msg.get(ptr((&k_dlg_no[0 as usize]) as u64)))
                say(ptr((&m_ask[0 as usize]) as u64))
                ulib.sayu(2)
                ulib.nl()
            } else if confirmed && question == 4 {
                start_now = true
                question = 2
            } else if confirmed && question == 5 {
                question = 0
                delete_leftover(nptr(chosen))
                rebuild_view()
            } else if confirmed && question == 2 {

                start_now = true
            } else {
                question = 0
            }
        }
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
