fn gpt_reason_key(g: u64) -> u64 {
    if g == dualkern.D_NO_GPT {
        return ptr((&k_d_g_none[0 as usize]) as u64)
    }
    if g == dualkern.D_READ {
        return ptr((&k_d_g_read[0 as usize]) as u64)
    }
    if g == dualkern.D_HSIZE {
        return ptr((&k_d_ghsize[0 as usize]) as u64)
    }
    if g == dualkern.D_HCRC {
        return ptr((&k_d_ghcrc[0 as usize]) as u64)
    }
    if g == dualkern.D_ESIZE {
        return ptr((&k_d_gesize[0 as usize]) as u64)
    }
    if g == dualkern.D_COUNT {
        return ptr((&k_d_gcount[0 as usize]) as u64)
    }
    if g == dualkern.D_TCRC {
        return ptr((&k_d_gtcrc[0 as usize]) as u64)
    }
    return ptr((&k_d_g_broken[0 as usize]) as u64)
}
