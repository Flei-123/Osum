// RUNDE DUALBOOT: die Texte des zweiten Weges.
static mut k_d_head: [u8; 11] = "dual.head\0\0"
static mut k_d_cols: [u8; 11] = "dual.cols\0\0"
static mut k_d_tganz: [u8; 15] = "dual.tab.ganz\0\0"
