// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/installer.fi -- RUNDE INSTALLER (P-001): DER WEG VON DER
// VORFUEHRUNG IN DEN ALLTAG.
//
// ==================================================================
// WAS HIER GELOEST WIRD, UND WARUM ES DER WICHTIGSTE OFFENE PUNKT WAR
// ==================================================================
//
// OrientOS startet heute von einem Stick und laeuft aus dem
// Arbeitsspeicher. Das ist fuer eine Vorfuehrung genau richtig und fuer
// alles andere unbrauchbar: was man anlegt, ist nach dem Ausschalten
// weg. `/root/osum-roadmap/OFFEN.md` fuehrt das als `P-001` mit
// Prioritaet 1 -- "Installation auf Platte -- der Stick laeuft aus dem
// RAM, nichts bleibt" -- und der Befund daneben sagt auch, woran es
// lag:
//
//     `install.fi` schreibt GPT/EFI, aber es gibt KEINEN bedienbaren
//     Installationsweg aus der Oberflaeche.
//
// Die Maschine war also da und gemessen (Runde INSTALL, 70 Zusagen,
// docs/ROUNDINSTALL.md); was fehlte, war die Tuer. `install /dev/hda
// --ja` ist kein Weg fuer einen Menschen, der gerade einen Stick
// gebootet hat -- er muesste wissen, dass es das Programm gibt, wie die
// Zielplatte heisst, und dass ein vergessenes `--ja` nichts tut,
// waehrend ein falsch getipptes Geraet seine Daten kostet.
//
// ==================================================================
// DIE ENTSCHEIDUNG: DIE MASCHINE WIRD GETEILT, NICHT NACHGEBAUT
// ==================================================================
//
// Der bequeme Weg waere gewesen, hier ein Fenster zu bauen und die
// Schreibarbeit ein zweites Mal zu tippen. Dann gaebe es ZWEI Stellen,
// an denen eine GPT-Pruefsumme gerechnet wird, und die zweite waere
// die, die beim naechsten Formatwechsel vergessen wird -- genau das,
// was `tools/check-ui.sh` fuer Bedienelemente verbietet, nur eine
// Etage tiefer.
//
// Deshalb steht die Maschine seit dieser Runde in
// `kernel/user/instkern.fi` und hat GENAU ZWEI Aufrufer: die
// Kommandozeile (`install.fi`, unveraendert in dem, was sie tut) und
// dieses Fenster. Ein Fehler an der Partitionstafel ist damit an EINER
// Stelle zu beheben.
//
// ==================================================================
// WAS ES ZEIGT UND WARUM GENAU DAS
// ==================================================================
//
//   1. DIE PLATTEN, MIT DEM, WAS SCHON DARAUF IST. Nicht nur
//      "/dev/hda": auch die Groesse und -- das ist der Punkt -- ob
//      schon Partitionen daraufliegen. Wer eine Platte ueberschreibt,
//      muss vorher sehen koennen, dass sie nicht leer war. Die Zahlen
//      kommen aus `part.fi` ueber `/dev/`, also aus derselben Quelle,
//      aus der auch der Kern beim Start seine Wurzel sucht.
//
//   2. ZWEI FRAGEN, NICHT EINE. Eine Installation loescht eine ganze
//      Platte; das ist die folgenreichste Sache, die dieses System auf
//      Knopfdruck tut. Die erste Frage nennt das Geraet, die zweite
//      sagt, dass es jetzt unwiderruflich wird. Zwei Dialoge sind
//      laestig -- eine geloeschte Platte ist schlimmer.
//
//   3. WO ES STEHT, WAEHREND ES LAEUFT. Das Kopieren dauert Minuten
//      (die 32768 Sektoren gehen oktettweise durch den FAT32-Schreiber),
//      und ein Fenster, das minutenlang nichts sagt, ist von einem
//      abgestuerzten nicht zu unterscheiden. `instkern` zaehlt deshalb
//      mit, und hier wird daraus ein Balken und eine Schrittzeile.
//
//   4. FEHLER IM KLARTEXT. `instkern` gibt einen GRUND als Zahl
//      zurueck, und hier wird daraus ein Satz aus dem Katalog. Kein
//      stiller Abbruch: wenn etwas schiefgeht, steht es im Fenster und
//      nicht nur auf einer seriellen Leitung, die niemand sieht.
//
// ==================================================================
// DIE REGEL DIESER DATEI: ES MALT NICHTS SELBST
// ==================================================================
//
// Jedes Bedienelement kommt aus `wlib`, und `wlib` malt seit Runde 31
// mit fUi. `tools/check-ui.sh` rechnet das nach und wird rot, sobald
// hier ein rohes Mal-Primitiv der Bibliothek steht. Das ist Justins
// Vorgabe vom 11.09.2026 und der Grund, warum dieses Fenster aussieht
// wie die anderen.
//
// (Der Name des Primitivs steht hier bewusst NICHT ausgeschrieben:
// die Pruefung liest die Datei mit `grep -a` und unterscheidet
// Kommentar nicht von Quelltext -- eine Erwaehnung im Kommentar
// faellt ihr also genauso auf. Das ist kein Fehler der Pruefung,
// sondern der Preis dafuer, dass sie nicht umgangen werden kann.)
//
// `profile app`, wie jedes Programm mit Oberflaeche: fUi rechnet in
// f64 und benutzt `std.rt`, beides ist unter `profile kernel` gesperrt.

profile app

import ulib
import wlibc
import wlib
import msg
import instkern
import dualkern

export { u_start }

// ------------------------------------------------------------- Zahlen

// Wieviele Platten die Liste traegt. Vier reichen fuer jede Maschine,
// auf die dieses System heute passt (hda, hdb, nvme0, ram0); wer mehr
// hat, sieht die ersten vier und die Zeile darunter sagt es.
const MAXP: u64 = 4
// Die Spalten der Tabelle: Geraet, Modell, Groesse, Belegung.
const NCOL: u64 = 4
// RUNDE DUALBOOT: die Spalten der Partitionsansicht -- Nr, Anfang,
// Groesse, Art, Name.
const PCOL: u64 = 5

// Das Fenster. Die Zahlen liegen auf dem Viererraster der Runde
// OBERFLAECHE -- `tools/design/messen.py` zaehlt genau sie.
const BW: u64 = 720
const BH: u64 = 560

// Die Schritte, die der Balken abbildet. Sie sind dieselben Zahlen wie
// in `instkern` (S_GPT..S_FERTIG) und stehen hier NICHT noch einmal als
// Literal: sie werden von dort gelesen.

// ------------------------------------------------------------ Zustand

// Je Platte: der Geraetename, die Sektorzahl, die Zahl der gefundenen
// Partitionen.
static mut p_name: [u8; 64] = [0 as u8; 64] // MAXP * 16
static mut p_sekt: [u64; 4] = [0 as u64; 4]
static mut p_parts: [u64; 4] = [0 as u64; 4]
static mut p_anz: u64 = 0

// Die Zeilen der Tabelle, als EIN Text: Spalten durch Tabulator,
// Zeilen durch Zeilenumbruch. Das ist das Modell von `wlib.table` --
// kein zweites daneben.
static mut tblob: [u8; 1024] = [0 as u8; 1024]
static mut tspalten: [u64; 4] = [0 as u64; 4]
// Die Beschriftung der beiden Reiter, durch Tabulator getrennt -- das
// Modell von `wlib.tabs`.
static mut tabtext: [u8; 80] = [0 as u8; 80]

// Die Statuszeile und die Schrittzeile.
static mut zeile: [u8; 200] = [0 as u8; 200]
static mut schrittzeile: [u8; 200] = [0 as u8; 200]

// ================================================== RUNDE DUALBOOT
//
// DER ZWEITE WEG. Bis hierher konnte dieses Fenster genau eines: eine
// Platte LEEREN und neu beschreiben. Wer OrientOS neben Windows wollte,
// brauchte eine zweite Platte.
//
// Jetzt gibt es zwei Reiter, und sie stehen fuer zwei verschiedene
// Berufe:
//
//   Reiter 0  GANZE PLATTE -- der alte Weg, unveraendert. Die Tafel
//             wird neu geschrieben, alles darauf ist danach weg.
//   Reiter 1  DANEBEN -- die vorhandene Tafel wird ERGAENZT. Die
//             fremden Partitionen bleiben, die fremde EFI-Partition
//             wird MITBENUTZT, und am Ende bietet das Bootmenue beide
//             Systeme an.
//
// WAS DIE ANSICHT ZEIGT, und warum sie zuerst kommt: ohne zu sehen,
// was auf der Platte liegt, ist jede Entscheidung darueber, wohin
// OrientOS soll, geraten. Die Tafel wird mit `dualkern.tafel_lesen`
// gelesen -- mit beiden Pruefsummen, wie `part.fi` es im Kern tut.
static mut welcher_weg: u64 = 0 // 0 = ganze Platte, 1 = daneben
// Die Zeilen der Partitionstabelle, wieder als EIN Text.
static mut pblob: [u8; 1024] = [0 as u8; 1024]
static mut pspalten: [u64; 5] = [0 as u64; 5]
static mut freizeile: [u8; 200] = [0 as u8; 200]
static mut espzeile: [u8; 200] = [0 as u8; 200]
// Was die Tafel hergegeben hat. 0 = noch nicht gelesen.
static mut d_gelesen: u64 = 0
static mut d_frei_von: u64 = 0
static mut d_frei_bis: u64 = 0
static mut d_esp_idx: u64 = 0xFFFFFFFFFFFFFFFF
static mut d_moeglich: u64 = 0 // 1 = "daneben" geht auf dieser Platte
static mut d_neue_nr: u64 = 0  // die Nummer der angelegten Partition

// Welche Platte ist gewaehlt (Index in p_*), und wie weit ist die
// Installation.
static mut gewaehlt: u64 = 0xFFFFFFFFFFFFFFFF
static mut laeuft: u64 = 0
static mut fertig: u64 = 0
static mut frage: u64 = 0 // 1 = erste Frage offen, 2 = zweite
// WELCHER SCHRITT GERADE ANGESAGT IST. NICHT `instkern.schritt_nr()`:
// das steht erst dann auf einer Nummer, wenn die Maschine den
// Abschnitt schon BEGONNEN hat -- fuer eine Anzeige ist das zu spaet,
// und auf der Leitung fehlten deshalb die Schritte 2, 4 und 5,
// obwohl alle fuenf gelaufen sind.
static mut st_zeige: u64 = 0

// Die Geraete, die ueberhaupt in Frage kommen. `ram0` steht bewusst
// NICHT darin: es ist die Quelle, aus der kopiert wird.
static mut d_hda: [u8; 10] = "/dev/hda\0\0"
static mut d_hdb: [u8; 10] = "/dev/hdb\0\0"
static mut d_nvme: [u8; 12] = "/dev/nvme0\0\0"
static mut d_quelle: [u8; 10] = "/dev/ram0\0"

// Die Schluessel. KEIN deutscher Text im Quelltext -- Runde I18N, und
