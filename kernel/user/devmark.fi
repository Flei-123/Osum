profile kernel

import ulib
import libc.io
import libc.octets

export { is_fresh, STALE_AFTER_S }

const STALE_AFTER_S: u64 = 60

static mut MARK_BUF: [u8; 32] = [0 as u8; 32]

fn is_fresh(path: u64) -> bool {
    let fd: u64 = io.open(path, 0)
    if ulib.bad(fd) {
        return false
    }
    let base: u64 = (&MARK_BUF[0 as usize]) as u64
    let n: u64 = io.read_full(fd, base, 24)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return false
    }
    var written: u64 = 0
    var i: u64 = 0
    while i < n && octets.ld8(base, i) >= 48 && octets.ld8(base, i) <= 57 {
        written = written * 10 + (octets.ld8(base, i) - 48)
        i = i + 1
    }
    if i == 0 {
        return false
    }
    let now: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_UPTIME, 0, 0) / 1000
    if ulib.bad(now) || written > now {
        return false
    }
    return now - written <= STALE_AFTER_S
}
