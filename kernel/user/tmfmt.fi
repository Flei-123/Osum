// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import ulib

export { put_str, put_num, put_pm, put_size, put_rate, put_bytes, put_time }

static mut u_comma: [u8; 2] = ",\0"
static mut u_kib: [u8; 5] = " KiB\0"
static mut u_mib: [u8; 5] = " MiB\0"
static mut u_bps: [u8; 5] = " B/s\0"
static mut u_byte: [u8; 3] = " B\0"
static mut u_ps: [u8; 3] = "/s\0"
static mut u_h: [u8; 4] = " h \0"
static mut u_m: [u8; 4] = " m \0"
static mut u_s: [u8; 3] = " s\0"

fn put_str(d: u64, at: u64, s: u64) -> u64 {
    let n: u64 = ulib.length(s)
    var i: u64 = 0
    while i < n {
        __mmio_write8((d + at + i) as *mut u8, __mmio_read8((s + i) as *mut u8))
        i = i + 1
    }
    __mmio_write8((d + at + n) as *mut u8, 0 as u8)
    return at + n
}

fn put_num(d: u64, at: u64, v: u64) -> u64 {
    let n: u64 = ulib.digits(v, d + at)
    __mmio_write8((d + at + n) as *mut u8, 0 as u8)
    return at + n
}

fn put_pm(d: u64, at: u64, v: u64) -> u64 {
    var a: u64 = at
    a = put_num(d, a, v / 10)
    a = put_str(d, a, (&u_comma[0]) as u64)
    a = put_num(d, a, v % 10)
    return a
}

fn put_size(d: u64, at: u64, kib: u64) -> u64 {
    var a: u64 = at
    if kib < 1024 {
        a = put_num(d, a, kib)
        return put_str(d, a, (&u_kib[0]) as u64)
    }
    let mib: u64 = kib / 1024
    let zehntel: u64 = (kib % 1024) * 10 / 1024
    a = put_num(d, a, mib)
    a = put_str(d, a, (&u_comma[0]) as u64)
    a = put_num(d, a, zehntel)
    return put_str(d, a, (&u_mib[0]) as u64)
}

fn put_rate(d: u64, at: u64, bps: u64) -> u64 {
    var a: u64 = at
    if bps < 1024 {
        a = put_num(d, a, bps)
        return put_str(d, a, (&u_bps[0]) as u64)
    }
    a = put_size(d, a, bps / 1024)
    return put_str(d, a, (&u_ps[0]) as u64)
}

fn put_bytes(d: u64, at: u64, n: u64) -> u64 {
    var a: u64 = at
    if n < 1024 {
        a = put_num(d, a, n)
        return put_str(d, a, (&u_byte[0]) as u64)
    }
    return put_size(d, a, n / 1024)
}

fn put_time(d: u64, at: u64, ms: u64) -> u64 {
    let secs: u64 = ms / 1000
    var a: u64 = at
    a = put_num(d, a, secs / 3600)
    a = put_str(d, a, (&u_h[0]) as u64)
    a = put_num(d, a, (secs / 60) % 60)
    a = put_str(d, a, (&u_m[0]) as u64)
    a = put_num(d, a, secs % 60)
    return put_str(d, a, (&u_s[0]) as u64)
}
