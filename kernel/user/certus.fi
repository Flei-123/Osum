// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/certus.fi -- CERTUS ALS PLATZHALTER, fuer die Runde
// ANHEFTEN und fuer NICHTS SONST.
//
// WAS DAS HIER IST UND WAS ES NICHT IST -- die Ehrlichkeit gehoert an
// den Anfang der Datei und nicht in eine Fussnote:
//
// DAS IST NICHT DER BROWSER. Der echte Certus ist der Browser aus dem
// Firn-Baum (JavaScript, Raster, TLS, ~105 000 Zeilen); er wird mit
// `kernel/user/certus/bau.sh` gebaut, ist gebunden und gestrippt
// 6 493 760 Oktette gross und laeuft auf Osum als gewoehnliches
// Ring-3-Programm (STATUS-CERTUS.md, Runde CERTUS-AUF-OSUM).
//
// WARUM ER IM PRUEFSTAND TROTZDEM NICHT MITFAEHRT: die Platte der
// Aufnahme ist 10 485 760 Oktette gross. Ein Browser von 6,5 MiB
// darauf laesst fuer Kern, elf Programme, Schriften und Buendel keinen
// Platz -- die Aufnahme baut also eine Platte, die es so auf keinem
// Rechner gibt, und misst dann sich selbst.
//
// WOFUER DIESER PLATZHALTER DA IST: die Leiste soll BELEGEN, dass ein
// angehefteter Knopf ein Programm WIRKLICH startet -- nicht, dass er
// einen Browser rendert. Dafuer braucht es ein Programm unter
// /bin/certus, das ein Fenster mit `app=certus` aufmacht; genau daran
// erkennt die Leiste, dass ihr Anhefter jetzt laeuft, und setzt die
// Laufanzeige darunter. Alles, was diese Datei mehr taete, waere
// Beiwerk fuer eine Messung, die es nicht misst.
//
// WER DEN ECHTEN WILL: `progs=` um `certus` erweitern und /bin/certus
// aus `kernel/user/certus/bau.sh` nehmen statt aus dieser Datei. Die
// Leiste merkt den Unterschied nicht -- sie fragt nach `WL_APP`, und
// der steht in beiden Faellen auf "certus".

profile kernel

import ulib
import wlibc
import wlib

export { u_start }

static mut T_TITEL: [u8; 8] = "Certus\0\0"
static mut T_APP: [u8; 8] = "certus\0\0"
// Der Satz im Fenster sagt dasselbe wie der Kopf dieser Datei, damit
// niemand vor dem Bild steht und den Platzhalter fuer den Browser haelt.
static mut T_ZEILE1: [u8; 41] = "Certus -- Platzhalter der Runde ANHEFTEN\0"
static mut T_ZEILE2: [u8; 45] = "Der Browser selbst wird separat gebaut:\0\0\0\0\0\0"
static mut T_ZEILE3: [u8; 44] = "kernel/user/certus/bau.sh (6,5 MiB)\0\0\0\0\0\0\0\0\0"

fn say(p: u64) {
    ulib.say(p)
}

fn u_start(args: u64) -> u64 {
    var s_bad: [u8; 22] = "certus: keine Flaeche\0"
    var s_go: [u8; 15] = "certus: ready\0\0"
    let _a0: u64 = args
    if !wlib.begin(false, false) {
        say((&s_bad[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    let bw: u64 = 640
    let bh: u64 = 400
    let w: u64 = wlib.window(120, 120, bw, bh, (&T_TITEL[(0) as usize]) as u64)
    if w >= wlib.MAXWN {
        say((&s_bad[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    // DER NAME DES BUENDELS. Daran -- und nicht am Titel -- erkennt die
    // Leiste, dass dieses Fenster zum Anhefter `certus` gehoert.
    let _a: u64 = wlib.window_app(w, (&T_APP[(0) as usize]) as u64)
    let rand: u64 = wlib.inset()
    let luft: u64 = wlib.inset() / 2
    wlib.box_v(w, 0, 0, bw, bh, rand, luft)
    let _l1: u64 = wlib.label((&T_ZEILE1[(0) as usize]) as u64)
    let _l2: u64 = wlib.label((&T_ZEILE2[(0) as usize]) as u64)
    let _l3: u64 = wlib.label((&T_ZEILE3[(0) as usize]) as u64)
    wlib.box_end()
    wlib.draw_all()
    say((&s_go[(0) as usize]) as u64)
    ulib.nl()
    // Dieselbe Schleife wie in `papierkorb.fi`: die Zaehlerschranke
    // steht dort, damit ein Pruefstand nicht ewig laeuft.
    var runden: u64 = 0
    while wlib.alive() && runden < 40000000 {
        runden = runden + 1
        let id: u64 = wlib.step()
        let _u: u64 = id
    }
    return 0
}
