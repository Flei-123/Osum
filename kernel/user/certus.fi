profile app

import ulib
import lineout
import fuiscene

export { u_start }

static mut T_TITLE: [u8; 7] = "Certus\0"
static mut T_APP: [u8; 7] = "certus\0"
static mut T_LINE1: [u8; 19] = "Certus placeholder\0"
static mut T_LINE2: [u8; 29] = "The real browser is built by\0"
static mut T_LINE3: [u8; 23] = "tools/certus/ensure.sh\0"

fn say(p: u64) {
    lineout.add_text(p)
}

fn build() {
    let r: usize = fuiscene.root()
    let _l1: usize = fuiscene.label(r, (&T_LINE1[(0) as usize]) as u64)
    let _l2: usize = fuiscene.label(r, (&T_LINE2[(0) as usize]) as u64)
    let _l3: usize = fuiscene.label(r, (&T_LINE3[(0) as usize]) as u64)
}

fn u_start(args: u64) -> u64 {
    var s_bad: [u8; 19] = "certus: no surface\0"
    var s_go: [u8; 15] = "certus: ready\0\0"
    var s_open: [u8; 14] = "certus: open \0"
    if ulib.arg_count(args) >= 2 {
        say((&s_open[(0) as usize]) as u64)
        say(ulib.arg_at(args, 1))
        lineout.end_line()
    }
    if !fuiscene.open(120, 120, 640, 400, (&T_TITLE[(0) as usize]) as u64, build) {
        say((&s_bad[(0) as usize]) as u64)
        lineout.end_line()
        return 1
    }
    fuiscene.set_app((&T_APP[(0) as usize]) as u64)
    var first: bool = true
    while fuiscene.alive() {
        let _k: u64 = fuiscene.pump()
        if first {
            first = false
            say((&s_go[(0) as usize]) as u64)
            lineout.end_line()
        }
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
