profile kernel

import ulib
import libc.text
import drvpkg
import hwprof.hwp_devs

export {
    category, category_name, label, needs_driver, hex_value,
    C_OTHER, C_STORAGE, C_GPU, C_WLAN, C_ETH, C_AUDIO, C_INPUT, C_USBCTL, C_BT, C_CAMERA, C_SERIAL, C_PLATFORM, C_INFRA
}

const C_OTHER: u64 = 0
const C_STORAGE: u64 = 1
const C_GPU: u64 = 2
const C_WLAN: u64 = 3
const C_ETH: u64 = 4
const C_AUDIO: u64 = 5
const C_INPUT: u64 = 6
const C_USBCTL: u64 = 7
const C_BT: u64 = 8
const C_CAMERA: u64 = 9
const C_SERIAL: u64 = 10
const C_PLATFORM: u64 = 11
const C_INFRA: u64 = 12

static mut NAMES: [u8; 90] = "other\0storage\0gpu\0wlan\0eth\0audio\0input\0usb-ctl\0bluetooth\0camera\0serial-bus\0platform\0infra\0"

static mut LABELS: [u8; 1145] = "pci 8086:a0f0 Intel Wi-Fi 6 AX201 (CNVi)\npci 8086:24fd Intel Wireless 8265\npci 8086:9a49 Intel Iris Xe Graphics (Tiger Lake)\npci 8086:5916 Intel HD Graphics 620\npci 8086:9d71 Intel HD Audio (Sunrise Point)\npci 8086:a0c8 Intel Smart Sound Audio (Tiger Lake)\npci 8086:a0e0 Intel Management Engine Interface\npci 8086:a0ed Intel USB xHCI (Tiger Lake)\npci 8086:9a0b Intel Volume Management Device (VMD)\npci 8086:a0e8 Intel LPSS I2C (Tiger Lake)\npci 8086:a0e9 Intel LPSS I2C (Tiger Lake)\npci 8086:a0ea Intel LPSS I2C (Tiger Lake)\npci 8086:a0eb Intel LPSS I2C (Tiger Lake)\npci 8086:9d60 Intel LPSS I2C (Sunrise Point)\npci 8086:9d61 Intel LPSS I2C (Sunrise Point)\npci 8086:9d62 Intel LPSS I2C (Sunrise Point)\npci 10ec:8125 Realtek RTL8125 2.5G Ethernet\nusb 1a86:5394 WCH CH336 USB Ethernet\nusb 8087:0a2b Intel Bluetooth\nacpi MSHW0084 Microsoft Surface Aggregator (keyboard, touchpad)\nacpi MSHW0040 Microsoft Surface integration\nacpi MSHW0184 Microsoft Surface integration\nacpi PNP0C50 HID over I2C device\nacpi PNP0303 PS/2 keyboard\nacpi PNP0F13 PS/2 mouse\nacpi PNP0C09 Embedded controller\nacpi PNP0C0A Battery\nacpi ACPI0003 AC adapter\nacpi PNP0C0D Lid\n\0"

fn hex_value(p: u64, n: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < n {
        let c: u64 = text.lower(drvpkg.byte_at(p + i))
        if c >= 48 && c <= 57 {
            v = v * 16 + (c - 48)
        } else if c >= 97 && c <= 102 {
            v = v * 16 + (c - 87)
        } else {
            return v
        }
        i = i + 1
    }
    return v
}

static mut KW_w_pci: [u8; 4] = "pci\0"
static mut KW_w_usb: [u8; 4] = "usb\0"
static mut KW_w_acpi: [u8; 5] = "acpi\0"

fn kind_word(kind: u64) -> u64 {
    if kind == hwp_devs.KIND_PCI {
        return (&KW_w_pci[0 as usize]) as u64
    }
    if kind == hwp_devs.KIND_USB {
        return (&KW_w_usb[0 as usize]) as u64
    }
    return (&KW_w_acpi[0 as usize]) as u64
}

fn label(kind: u64, id: u64) -> u64 {
    let word: u64 = kind_word(kind)
    let wl: u64 = text.length(word)
    let il: u64 = text.length(id)
    let base: u64 = (&LABELS[0 as usize]) as u64
    var at: u64 = 0
    while drvpkg.byte_at(base + at) != 0 {
        var end: u64 = at
        while drvpkg.byte_at(base + end) != 10 && drvpkg.byte_at(base + end) != 0 {
            end = end + 1
        }
        let line: u64 = base + at
        if ulib.strneq(line, word, wl) && drvpkg.byte_at(line + wl) == 32
            && same_nocase(line + wl + 1, id, il) && drvpkg.byte_at(line + wl + 1 + il) == 32 {
            return line + wl + il + 2
        }
        at = end + 1
    }
    return 0
}

fn same_nocase(a: u64, b: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if text.lower(drvpkg.byte_at(a + i)) != text.lower(drvpkg.byte_at(b + i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn category_name(c: u64) -> u64 {
    var at: u64 = 0
    var k: u64 = 0
    let base: u64 = (&NAMES[0 as usize]) as u64
    while k < c {
        while drvpkg.byte_at(base + at) != 0 {
            at = at + 1
        }
        at = at + 1
        k = k + 1
    }
    return base + at
}

fn pci_category(cls: u64) -> u64 {
    let major: u64 = hex_value(cls, 2)
    let full: u64 = hex_value(cls, 4)
    if major == 1 {
        return C_STORAGE
    }
    if major == 3 {
        return C_GPU
    }
    if full == 0x0280 {
        return C_WLAN
    }
    if major == 2 {
        return C_ETH
    }
    if major == 4 && full != 0x0480 {
        return C_AUDIO
    }
    if full == 0x0c03 {
        return C_USBCTL
    }
    if full == 0x0c80 || full == 0x0700 {
        return C_SERIAL
    }
    if major == 6 || full == 0x0c05 {
        return C_INFRA
    }
    return C_OTHER
}

fn usb_category(cls: u64) -> u64 {
    let c: u64 = hex_value(cls, 2)
    if c == 9 {
        return C_INFRA
    }
    if c == 3 {
        return C_INPUT
    }
    if c == 14 {
        return C_CAMERA
    }
    if c == 224 {
        return C_BT
    }
    if c == 8 {
        return C_STORAGE
    }
    return C_OTHER
}

fn acpi_category(hid: u64) -> u64 {
    var p_surface: [u8; 6] = "MSHW0\0"
    var p_pnp0a: [u8; 6] = "PNP0A\0"
    var p_res: [u8; 8] = "PNP0C02\0"
    var p_i2c: [u8; 8] = "PNP0C50\0"
    var p_kbd: [u8; 8] = "PNP0303\0"
    var p_mouse: [u8; 8] = "PNP0F13\0"
    if ulib.strneq(hid, (&p_surface[0 as usize]) as u64, 5) || ulib.streq(hid, (&p_i2c[0 as usize]) as u64) {
        return C_INPUT
    }
    if ulib.streq(hid, (&p_kbd[0 as usize]) as u64) || ulib.streq(hid, (&p_mouse[0 as usize]) as u64)
        || label(hwp_devs.KIND_ACPI, hid) != 0 {
        return C_PLATFORM
    }
    if ulib.strneq(hid, (&p_pnp0a[0 as usize]) as u64, 5) || ulib.streq(hid, (&p_res[0 as usize]) as u64) {
        return C_INFRA
    }
    return C_OTHER
}

fn category(i: u64) -> u64 {
    let kind: u64 = hwp_devs.kind_of(i)
    if kind == hwp_devs.KIND_PCI {
        return pci_category(hwp_devs.class_of(i))
    }
    if kind == hwp_devs.KIND_USB {
        return usb_category(hwp_devs.class_of(i))
    }
    return acpi_category(hwp_devs.id_of(i))
}

fn needs_driver(c: u64) -> bool {
    return c != C_OTHER && c != C_INFRA && c != C_PLATFORM
}
