profile kernel

import libc.text

export { reset, put_str, put_ch, put_num, put_nl, put_span, text_ptr, text_len }

const CAPACITY: u64 = 24576

static mut BUF: [u8; 24576] = [0 as u8; 24576]
static mut used: u64 = 0

fn reset() {
    used = 0
    BUF[0 as usize] = 0 as u8
}

fn put_ch(c: u64) {
    if used + 1 >= CAPACITY {
        return
    }
    BUF[used as usize] = c as u8
    used = used + 1
    BUF[used as usize] = 0 as u8
}

fn put_span(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        put_ch((*((p + i) as *mut u8)) as u64)
        i = i + 1
    }
}

fn put_str(p: u64) {
    put_span(p, text.length(p))
}

fn put_num(v: u64) {
    var digits: [u8; 26] = [0 as u8; 26]
    let n: u64 = text.digits(v, (&digits[0 as usize]) as u64, false)
    put_span((&digits[0 as usize]) as u64, n)
}

fn put_nl() {
    put_ch(10)
}

fn text_ptr() -> u64 {
    return (&BUF[0 as usize]) as u64
}

fn text_len() -> u64 {
    return used
}
