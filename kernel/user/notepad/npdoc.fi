profile app

import fuied

export {
    pad_set_slot, pad_slot, pad_load, pad_blank, pad_snapshot, pad_text_ptr,
    pad_mark_clean, pad_is_dirty, pad_row, pad_set_row, PAD_TEXT_CAP,
    PAD_K_EDITOR, PAD_K_LIST,
}

const PAD_TEXT_CAP: u64 = 65536
const PAD_K_EDITOR: u64 = 10
const PAD_K_LIST: u64 = 11

static mut text_buf: [u8; 65600] = [0 as u8; 65600]
static mut editor_slot: u64 = 0
static mut current_row: u64 = 0

fn pad_set_slot(value: u64) {
    editor_slot = value
}

fn pad_slot() -> u64 {
    return editor_slot
}

fn pad_row() -> u64 {
    return current_row
}

fn pad_set_row(row: u64) {
    current_row = row
}

fn pad_text_ptr() -> u64 {
    return (&text_buf[0 as usize]) as u64
}

fn pad_load(p: u64, n: u64) {
    fuied.ta_text_set(editor_slot, p, n)
    fuied.ta_goto(editor_slot, 0, 0)
    fuied.ta_clean(editor_slot)
}

fn pad_blank() {
    fuied.ta_clear_all(editor_slot)
    fuied.ta_clean(editor_slot)
}

fn pad_snapshot() -> u64 {
    return fuied.ta_text_get(editor_slot, pad_text_ptr(), PAD_TEXT_CAP)
}

fn pad_mark_clean() {
    fuied.ta_clean(editor_slot)
}

fn pad_is_dirty() -> bool {
    return fuied.ta_geaendert(editor_slot)
}
