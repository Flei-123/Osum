profile app

import libc.octets
import libc.text
import services.svcosum
import npstr

export { pad_note_read, pad_note_write, pad_note_drop }

const KEY_CAP: u64 = 64

static mut key_buf: [u8; 64] = [0 as u8; 64]

fn key_ptr() -> u64 {
    return (&key_buf[0 as usize]) as u64
}

fn build_key(id: u64) -> u64 {
    octets.zero(key_ptr(), KEY_CAP)
    let prefix: u64 = npstr.pad_note_prefix()
    let n: u64 = text.length(prefix)
    octets.copy(key_ptr(), prefix, n)
    return n + text.digits(id, key_ptr() + n, false)
}

fn pad_note_read(id: u64, out: u64, max: u64, len_out: u64) -> u64 {
    let key_len: u64 = build_key(id)
    return svcosum.store_get(key_ptr(), key_len, out, max, len_out)
}

fn pad_note_write(id: u64, p: u64, n: u64) -> u64 {
    let key_len: u64 = build_key(id)
    return svcosum.store_set(key_ptr(), key_len, p, n)
}

fn pad_note_drop(id: u64) -> u64 {
    let key_len: u64 = build_key(id)
    return svcosum.store_remove(key_ptr(), key_len)
}
