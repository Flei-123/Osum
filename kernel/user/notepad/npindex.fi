profile app

import libc.octets
import libc.text
import services.svcosum
import services.svcrules
import npstr
import npnote

export {
    pad_index_load, pad_index_add, pad_index_drop, pad_index_retitle,
    pad_index_id, pad_index_rows, pad_index_blob, pad_index_next_id, pad_index_title,
    PAD_INDEX_MAX,
}

const PAD_INDEX_MAX: u64 = 32
const TITLE_CAP: u64 = 48
const WIRE_CAP: u64 = 4096
const NEWLINE: u64 = 10
const CARRIAGE: u64 = 13
const ZERO_DIGIT: u64 = 48
const CONT_MASK: u64 = 192
const CONT_BITS: u64 = 128
const RESULT_BYTES: u64 = 8

static mut idx_ids: [u64; 32] = [0 as u64; 32]
static mut idx_titles: [u8; 1536] = [0 as u8; 1536]
static mut idx_blob: [u8; 1664] = [0 as u8; 1664]
static mut idx_wire: [u8; 4096] = [0 as u8; 4096]
static mut idx_result: [u8; 8] = [0 as u8; 8]
static mut idx_rows: u64 = 0

fn wire_ptr() -> u64 {
    return (&idx_wire[0 as usize]) as u64
}

fn result_ptr() -> u64 {
    return (&idx_result[0 as usize]) as u64
}

fn pad_index_blob() -> u64 {
    return (&idx_blob[0 as usize]) as u64
}

fn pad_index_rows() -> u64 {
    return idx_rows
}

fn pad_index_id(row: u64) -> u64 {
    if row >= idx_rows {
        return 0
    }
    return idx_ids[(row) as usize]
}

fn pad_index_title(row: u64) -> u64 {
    return (&idx_titles[0 as usize]) as u64 + row * TITLE_CAP
}

fn rebuild_blob() {
    var at: u64 = 0
    var row: u64 = 0
    while row < idx_rows {
        let n: u64 = text.length(pad_index_title(row))
        octets.copy(pad_index_blob() + at, pad_index_title(row), n)
        octets.st8(pad_index_blob(), at + n, NEWLINE)
        at = at + n + 1
        row = row + 1
    }
    octets.st8(pad_index_blob(), at, 0)
}

fn fit_title(p: u64, n: u64) -> u64 {
    var take: u64 = n
    if take > TITLE_CAP - 1 {
        take = TITLE_CAP - 1
    }
    while take > 0 && take < n && (octets.ld8(p, take) & CONT_MASK) == CONT_BITS {
        take = take - 1
    }
    return take
}

fn line_end(p: u64, n: u64) -> u64 {
    var at: u64 = 0
    while at < n {
        let c: u64 = octets.ld8(p, at)
        if c == NEWLINE || c == CARRIAGE {
            return at
        }
        at = at + 1
    }
    return n
}

fn put_title(row: u64, p: u64, n: u64) {
    let slot: u64 = pad_index_title(row)
    octets.zero(slot, TITLE_CAP)
    let take: u64 = fit_title(p, n)
    if take == 0 {
        octets.copy(slot, npstr.pad_untitled(), fit_title(npstr.pad_untitled(), text.length(npstr.pad_untitled())))
        return
    }
    octets.copy(slot, p, take)
}

fn pad_index_retitle(row: u64, p: u64, n: u64) {
    if row >= idx_rows {
        return
    }
    put_title(row, p, line_end(p, n))
    rebuild_blob()
}

fn pad_index_next_id() -> u64 {
    var best: u64 = 0
    var row: u64 = 0
    while row < idx_rows {
        if idx_ids[(row) as usize] > best {
            best = idx_ids[(row) as usize]
        }
        row = row + 1
    }
    return best + 1
}

fn pad_index_add(id: u64) -> u64 {
    if idx_rows >= PAD_INDEX_MAX {
        return PAD_INDEX_MAX
    }
    let row: u64 = idx_rows
    idx_ids[(row) as usize] = id
    idx_rows = idx_rows + 1
    put_title(row, 0, 0)
    rebuild_blob()
    return row
}

fn pad_index_drop(row: u64) {
    if row >= idx_rows {
        return
    }
    var at: u64 = row
    while at + 1 < idx_rows {
        idx_ids[(at) as usize] = idx_ids[(at + 1) as usize]
        octets.copy(pad_index_title(at), pad_index_title(at + 1), TITLE_CAP)
        at = at + 1
    }
    idx_rows = idx_rows - 1
    octets.zero(pad_index_title(idx_rows), TITLE_CAP)
    idx_ids[(idx_rows) as usize] = 0
    rebuild_blob()
}

fn insert_sorted(id: u64) {
    var at: u64 = idx_rows
    while at > 0 && idx_ids[(at - 1) as usize] > id {
        idx_ids[(at) as usize] = idx_ids[(at - 1) as usize]
        at = at - 1
    }
    idx_ids[(at) as usize] = id
    idx_rows = idx_rows + 1
}

fn has_prefix(at: u64, prefix: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if octets.ld8(wire_ptr(), at + i) != octets.ld8(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn parse_key(at: u64, end: u64) -> u64 {
    let prefix: u64 = npstr.pad_note_prefix()
    let prefix_len: u64 = text.length(prefix)
    if at + prefix_len >= end || !has_prefix(at, prefix, prefix_len) {
        return 0
    }
    var id: u64 = 0
    var i: u64 = at + prefix_len
    while i < end {
        let c: u64 = octets.ld8(wire_ptr(), i)
        if !text.is_digit(c) {
            return 0
        }
        id = id * 10 + c - ZERO_DIGIT
        i = i + 1
    }
    return id
}

fn collect_ids(n: u64) {
    var at: u64 = 0
    while at < n {
        var end: u64 = at
        while end < n && octets.ld8(wire_ptr(), end) != NEWLINE {
            end = end + 1
        }
        let id: u64 = parse_key(at, end)
        if id > 0 && idx_rows < PAD_INDEX_MAX {
            insert_sorted(id)
        }
        at = end + 1
    }
}

fn load_titles(buf: u64, cap: u64) {
    var row: u64 = 0
    while row < idx_rows {
        octets.zero(result_ptr(), RESULT_BYTES)
        let status: u64 = npnote.pad_note_read(idx_ids[(row) as usize], buf, cap, result_ptr())
        if status == svcrules.OK {
            let n: u64 = octets.le32(result_ptr())
            put_title(row, buf, line_end(buf, n))
        } else {
            put_title(row, 0, 0)
        }
        row = row + 1
    }
}

fn pad_index_load(buf: u64, cap: u64) -> u64 {
    idx_rows = 0
    octets.zero(wire_ptr(), WIRE_CAP)
    octets.zero(result_ptr(), RESULT_BYTES)
    let status: u64 = svcosum.store_keys(wire_ptr(), WIRE_CAP, result_ptr())
    if status == svcrules.OK {
        collect_ids(octets.le32(result_ptr()))
        load_titles(buf, cap)
    }
    rebuild_blob()
    return status
}
