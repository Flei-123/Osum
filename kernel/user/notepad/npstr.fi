profile app

import msg

export {
    pad_app, pad_window_title, pad_index_key, pad_note_prefix, pad_untitled,
    pad_cmd_new, pad_cmd_save, pad_cmd_delete, pad_delete_title, pad_delete_text,
    pad_word_note, pad_word_of, pad_word_modified,
}

static mut APP: [u8; 8] = "notepad\0"
static mut INDEX_KEY: [u8; 6] = "index\0"
static mut NOTE_PREFIX: [u8; 6] = "note-\0"
static mut K_TITLE: [u8; 14] = "notepad.title\0"
static mut K_UNTITLED: [u8; 17] = "notepad.untitled\0"
static mut K_NEW: [u8; 16] = "notepad.cmd.new\0"
static mut K_SAVE: [u8; 17] = "notepad.cmd.save\0"
static mut K_DELETE: [u8; 19] = "notepad.cmd.delete\0"
static mut K_DELETE_TITLE: [u8; 21] = "notepad.delete.title\0"
static mut K_DELETE_TEXT: [u8; 20] = "notepad.delete.text\0"
static mut K_NOTE: [u8; 20] = "notepad.status.note\0"
static mut K_OF: [u8; 18] = "notepad.status.of\0"
static mut K_MODIFIED: [u8; 15] = "nedit.modified\0"

fn pad_app() -> u64 {
    return (&APP[0 as usize]) as u64
}

fn pad_index_key() -> u64 {
    return (&INDEX_KEY[0 as usize]) as u64
}

fn pad_note_prefix() -> u64 {
    return (&NOTE_PREFIX[0 as usize]) as u64
}

fn pad_window_title() -> u64 {
    return msg.get((&K_TITLE[0 as usize]) as u64)
}

fn pad_untitled() -> u64 {
    return msg.get((&K_UNTITLED[0 as usize]) as u64)
}

fn pad_cmd_new() -> u64 {
    return msg.get((&K_NEW[0 as usize]) as u64)
}

fn pad_cmd_save() -> u64 {
    return msg.get((&K_SAVE[0 as usize]) as u64)
}

fn pad_cmd_delete() -> u64 {
    return msg.get((&K_DELETE[0 as usize]) as u64)
}

fn pad_delete_title() -> u64 {
    return msg.get((&K_DELETE_TITLE[0 as usize]) as u64)
}

fn pad_delete_text() -> u64 {
    return msg.get((&K_DELETE_TEXT[0 as usize]) as u64)
}

fn pad_word_note() -> u64 {
    return msg.get((&K_NOTE[0 as usize]) as u64)
}

fn pad_word_of() -> u64 {
    return msg.get((&K_OF[0 as usize]) as u64)
}

fn pad_word_modified() -> u64 {
    return msg.get((&K_MODIFIED[0 as usize]) as u64)
}
