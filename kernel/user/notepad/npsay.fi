profile app

import lineout
import libc.text

export {
    pad_say_ready, pad_say_list, pad_say_state, pad_say_saved, pad_say_new, pad_say_select,
    pad_say_delete, pad_say_shortcut, pad_say_no_surface,
}

static mut READY: [u8; 21] = "notepad: ready rows=\0"
static mut STATE: [u8; 20] = "notepad: state row=\0"
static mut SAVED: [u8; 19] = "notepad: saved id=\0"
static mut NEW: [u8; 17] = "notepad: new id=\0"
static mut SELECT: [u8; 21] = "notepad: select row=\0"
static mut DELETE: [u8; 24] = "notepad: delete status=\0"
static mut SHORTCUT: [u8; 23] = "notepad: shortcut key=\0"
static mut NO_SURFACE: [u8; 20] = "notepad: no surface\0"
static mut LIST: [u8; 20] = "notepad: list rowh=\0"
static mut SCALE: [u8; 8] = " scale=\0"
static mut ID: [u8; 5] = " id=\0"
static mut LEN: [u8; 6] = " len=\0"
static mut ROWS: [u8; 7] = " rows=\0"
static mut DIRTY: [u8; 8] = " dirty=\0"
static mut STATUS: [u8; 9] = " status=\0"
static mut ANSWER: [u8; 9] = " answer=\0"
static mut TITLE: [u8; 8] = " title=\0"

fn put(buf: u64) {
    lineout.add_text(buf)
}

fn put_field(name: u64, value: u64) {
    put(name)
    lineout.add_num(value)
}

fn pad_say_ready(rows: u64) {
    put((&READY[0 as usize]) as u64)
    lineout.add_num(rows)
    lineout.end_line()
}

fn pad_say_list(row_h: u64, scale_milli: u64) {
    put((&LIST[0 as usize]) as u64)
    lineout.add_num(row_h)
    put_field((&SCALE[0 as usize]) as u64, scale_milli)
    lineout.end_line()
}

fn pad_say_state(row: u64, id: u64, n: u64, dirty: bool) {
    put((&STATE[0 as usize]) as u64)
    lineout.add_num(row)
    put_field((&ID[0 as usize]) as u64, id)
    put_field((&LEN[0 as usize]) as u64, n)
    var flag: u64 = 0
    if dirty {
        flag = 1
    }
    put_field((&DIRTY[0 as usize]) as u64, flag)
    lineout.end_line()
}

fn pad_say_saved(id: u64, status: u64, n: u64, title: u64) {
    put((&SAVED[0 as usize]) as u64)
    lineout.add_num(id)
    put_field((&STATUS[0 as usize]) as u64, status)
    put_field((&LEN[0 as usize]) as u64, n)
    put((&TITLE[0 as usize]) as u64)
    put(title)
    lineout.end_line()
}

fn pad_say_new(id: u64, rows: u64) {
    put((&NEW[0 as usize]) as u64)
    lineout.add_num(id)
    put_field((&ROWS[0 as usize]) as u64, rows)
    lineout.end_line()
}

fn pad_say_select(row: u64, id: u64, n: u64) {
    put((&SELECT[0 as usize]) as u64)
    lineout.add_num(row)
    put_field((&ID[0 as usize]) as u64, id)
    put_field((&LEN[0 as usize]) as u64, n)
    lineout.end_line()
}

fn pad_say_delete(status: u64, answer: u64, rows: u64) {
    put((&DELETE[0 as usize]) as u64)
    lineout.add_num(status)
    put_field((&ANSWER[0 as usize]) as u64, answer)
    put_field((&ROWS[0 as usize]) as u64, rows)
    lineout.end_line()
}

fn pad_say_shortcut(key: u64) {
    put((&SHORTCUT[0 as usize]) as u64)
    lineout.add_num(key)
    lineout.end_line()
}

fn pad_say_no_surface() {
    put((&NO_SURFACE[0 as usize]) as u64)
    lineout.end_line()
}
