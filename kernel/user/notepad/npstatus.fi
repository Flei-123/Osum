profile app

import libc.octets
import libc.text
import npstr
import npdoc
import npindex

export { pad_status_compose, pad_status_ptr, pad_status_changed }

const STATUS_CAP: u64 = 160
const SPACE: u64 = 32

static mut status_buf: [u8; 160] = [0 as u8; 160]
static mut seen_row: u64 = 0
static mut seen_rows: u64 = 0
static mut seen_dirty: bool = false

fn pad_status_ptr() -> u64 {
    return (&status_buf[0 as usize]) as u64
}

fn put_word(at: u64, src: u64) -> u64 {
    let n: u64 = text.length(src)
    if at + n >= STATUS_CAP {
        return at
    }
    octets.copy(pad_status_ptr() + at, src, n)
    return at + n
}

fn put_space(at: u64) -> u64 {
    octets.st8(pad_status_ptr(), at, SPACE)
    return at + 1
}

fn put_count(at: u64, value: u64) -> u64 {
    var digits: [u8; 26] = [0 as u8; 26]
    let ptr: u64 = (&digits[0 as usize]) as u64
    let n: u64 = text.digits(value, ptr, false)
    octets.copy(pad_status_ptr() + at, ptr, n)
    return at + n
}

fn pad_status_compose() {
    seen_row = npdoc.pad_row()
    seen_rows = npindex.pad_index_rows()
    seen_dirty = npdoc.pad_is_dirty()
    var at: u64 = put_word(0, npstr.pad_word_note())
    at = put_space(at)
    at = put_count(at, seen_row + 1)
    at = put_space(at)
    at = put_word(at, npstr.pad_word_of())
    at = put_space(at)
    at = put_count(at, seen_rows)
    if seen_dirty {
        at = put_word(at, npstr.pad_word_modified())
    }
    octets.st8(pad_status_ptr(), at, 0)
}

fn pad_status_changed() -> bool {
    return npdoc.pad_row() != seen_row || npindex.pad_index_rows() != seen_rows
        || npdoc.pad_is_dirty() != seen_dirty
}
