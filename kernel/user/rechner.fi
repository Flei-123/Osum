// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/rechner.fi -- Runde ALLTAG: DER TASCHENRECHNER.
//
// Er kann zweierlei sein, und beides aus EINER Datei:
//
//   rechner                 macht ein Fenster auf (wlib, sonst nichts)
//   rechner -e "2+3*4"      rechnet und schreibt das Ergebnis hin
//
// Der zweite Weg ist nicht bequem, sondern die MESSUNG: die Abnahme
// dieser Runde schickt dreissig Ausdruecke durch `-e` und haelt jede
// Antwort gegen Python. Ein Rechner, dessen Richtigkeit nur ein Mensch
// im Bild bestaetigt hat, ist ein Rechner mit unbekannten Fehlern.
//
// DIE SPRACHE, die er versteht -- und zwar so, wie Python sie auch
// versteht, sonst waere der Vergleich keiner:
//
//   + - * /        wie ueblich, Punkt vor Strich
//   %              Rest (math.fmod, wie Python fuer positive Zahlen)
//   ^              Potenz, RECHTS gebunden: 2^3^2 = 2^9
//   -x             Vorzeichen bindet SCHWAECHER als ^: -2^2 = -4
//   n!             Fakultaet, nur ganze Zahlen von 0 bis 170
//   ( )            Klammern
//   pi e ans       Konstanten; `ans` ist das letzte Ergebnis
//   sqrt abs sin cos tan asin acos atan ln log log2 exp
//   floor ceil round cbrt          -- ein Argument
//   pow min max hypot atan2 fmod   -- zwei, mit Komma
//
// `log` ist der Zehnerlogarithmus (wie auf jedem Taschenrechner),
// `ln` der natuerliche.
//
// WINKEL: die Bibliothek rechnet in Bogenmass. Der Haken "Grad" im
// Fenster schaltet Ein- und Ausgabe der Winkelfunktionen auf Grad um;
// auf der Konsole bleibt es bei Bogenmass, ausser `-deg` steht dabei.
//
// DIE OBERFLAECHE kommt ausschliesslich aus wlib: eine Menueleiste,
// Reiter, ein Textfeld fuer den Ausdruck, eine Beschriftung fuer das
// Ergebnis und drei Kaesten voll Knoepfe. Keine einzige Zeichenroutine
// wird von hier aus gerufen, kein Bildpunkt und keine Farbe steht in
// dieser Datei -- was gemalt wird, malt wlib, und wo es steht, rechnen
// die Layoutkaesten aus.

profile kernel

import ulib
import std.math
import wlibc
import wlib

export { u_start }

// ============================ DER AUSDRUCK

const MAXEX: u64 = 230

static mut ex: [u8; 256] = [0 as u8; 256]
static mut res: [u8; 128] = [0 as u8; 128]
static mut idb: [u8; 24] = [0 as u8; 24]
static mut uval: [u8; 64] = [0 as u8; 64]
static mut ures: [u8; 96] = [0 as u8; 96]

static mut srcp: u64 = 0
static mut pos: u64 = 0
static mut err: u64 = 0
static mut deg: bool = false
static mut ans: f64 = 0.0

// Die Namen, in der Reihenfolge, in der `apply` sie kennt. Alles ab 16
// nimmt zwei Argumente -- daran entscheidet der Zerteiler, ob er ein
// Komma verlangt.
static mut FN: [u8; 103] = "sqrt\0abs\0sin\0cos\0tan\0asin\0acos\0atan\0ln\0log\0log2\0exp\0floor\0ceil\0round\0cbrt\0pow\0min\0max\0hypot\0atan2\0fmod\0"
static mut CN: [u8; 9] = "pi\0e\0ans\0"

const NFN: u64 = 22
const ZWEI: u64 = 16
const NCN: u64 = 3

fn ptr(p: u64) -> u64 {
    return p
}

// Der i-te Text in einem Block aus null-getrennten Texten.
fn nth(blob: u64, i: u64) -> u64 {
    var at: u64 = 0
    var k: u64 = 0
    while k < i {
        while *((blob + at) as *mut u8) != 0 as u8 {
            at = at + 1
        }
        at = at + 1
        k = k + 1
    }
    return blob + at
}

fn idx_of(blob: u64, name: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < n {
        if ulib.streq(nth(blob, i), name) {
            return i
        }
        i = i + 1
    }
    return n
}

fn cur() -> u64 {
    return (*((srcp + pos) as *mut u8)) as u64
}

fn at_k(k: u64) -> u64 {
    return (*((srcp + pos + k) as *mut u8)) as u64
}

fn ws() {
    while cur() == 32 || cur() == 9 {
        pos = pos + 1
    }
}

fn is_dig(c: u64) -> bool {
    return c >= 48 && c <= 57
}

fn is_alpha(c: u64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
}

#[allow_fp]
fn pow10(k: i64) -> f64 {
    var r: f64 = 1.0
    var n: i64 = k
    while n > 0 {
        r = r * 10.0
        n = n - 1
    }
    while n < 0 {
        r = r / 10.0
        n = n + 1
    }
    return r
}

#[allow_fp]
fn p_num() -> f64 {
    var v: f64 = 0.0
    while is_dig(cur()) {
        v = v * 10.0 + ((cur() - 48) as f64)
        pos = pos + 1
    }
    if cur() == 46 {
        pos = pos + 1
        var sk: f64 = 0.1
        while is_dig(cur()) {
            v = v + ((cur() - 48) as f64) * sk
            sk = sk / 10.0
            pos = pos + 1
        }
    }
    if cur() == 101 || cur() == 69 {
        var k: u64 = 1
        var neg: bool = false
        if at_k(1) == 43 {
            k = 2
        } else if at_k(1) == 45 {
            k = 2
            neg = true
        }
        if is_dig(at_k(k)) {
            pos = pos + k
            var e: i64 = 0
            while is_dig(cur()) {
                e = e * 10 + ((cur() - 48) as i64)
                pos = pos + 1
            }
            if neg {
                e = 0 - e
            }
            v = v * pow10(e)
        }
    }
    return v
}

// Ein Name, kleingeschrieben zurueckgegeben.
fn p_ident() -> u64 {
    let b: u64 = (&idb[(0) as usize]) as u64
    var n: u64 = 0
    while is_alpha(cur()) || is_dig(cur()) {
        if n < 20 {
            var c: u64 = cur()
            if c >= 65 && c <= 90 {
                c = c + 32
            }
            __mmio_write8((b + n) as *mut u8, c as u8)
            n = n + 1
        }
        pos = pos + 1
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    return b
}

#[allow_fp]
fn f_asin(x: f64) -> f64 {
    if x > 1.0 || x < 0.0 - 1.0 {
        err = 2
        return 0.0
    }
    if x == 1.0 {
        return math.PI() / 2.0
    }
    if x == 0.0 - 1.0 {
        return 0.0 - math.PI() / 2.0
    }
    return math.atan(x / math.sqrt(1.0 - x * x))
}

#[allow_fp]
fn f_cbrt(x: f64) -> f64 {
    if x == 0.0 {
        return 0.0
    }
    if x < 0.0 {
        return 0.0 - math.powf(0.0 - x, 1.0 / 3.0)
    }
    return math.powf(x, 1.0 / 3.0)
}

#[allow_fp]
fn f_fact(x: f64) -> f64 {
    let n: f64 = math.round(x)
    if math.fabs(x - n) > 0.000000001 || n < 0.0 || n > 170.0 {
        err = 2
        return 0.0
    }
    var r: f64 = 1.0
    var k: u64 = 2
    let m: u64 = n as u64
    while k <= m {
        r = r * (k as f64)
        k = k + 1
    }
    return r
}

// Potenz. Eine negative Basis mit ganzzahligem Exponenten geht ueber
// `powi` -- `exp(e*ln b)` waere dort NaN, und (-8)^(1/3) ist auch in
// Python ein Fehler, also bleibt es einer.
#[allow_fp]
fn f_pow(b: f64, e: f64) -> f64 {
    if b < 0.0 {
        let r: f64 = math.round(e)
        if math.fabs(e - r) < 0.000000001 {
            return math.powi(b, r as i64)
        }
        err = 2
        return 0.0
    }
    if b == 0.0 && e < 0.0 {
        err = 2
        return 0.0
    }
    let r2: f64 = math.round(e)
    if math.fabs(e - r2) < 0.000000001 && math.fabs(e) < 1000.0 {
        return math.powi(b, r2 as i64)
    }
    return math.powf(b, e)
}

#[allow_fp]
fn apply(fi: u64, a: f64, b: f64) -> f64 {
    let r2d: f64 = 180.0 / math.PI()
    var x: f64 = a
    if fi == 2 || fi == 3 || fi == 4 {
        if deg {
            x = a / r2d
        }
        if fi == 2 {
            return math.sin(x)
        }
        if fi == 3 {
            return math.cos(x)
        }
        return math.tan(x)
    }
    if fi == 5 || fi == 6 || fi == 7 {
        var w: f64 = 0.0
        if fi == 5 {
            w = f_asin(a)
        } else if fi == 6 {
            w = math.PI() / 2.0 - f_asin(a)
        } else {
            w = math.atan(a)
        }
        if deg {
            w = w * r2d
        }
        return w
    }
    if fi == 0 {
        if a < 0.0 {
            err = 2
            return 0.0
        }
        return math.sqrt(a)
    }
    if fi == 1 {
        return math.fabs(a)
    }
    if fi == 8 {
        if a <= 0.0 {
            err = 2
            return 0.0
        }
        return math.ln(a)
    }
    if fi == 9 {
        if a <= 0.0 {
            err = 2
            return 0.0
        }
        return math.log10(a)
    }
    if fi == 10 {
        if a <= 0.0 {
            err = 2
            return 0.0
        }
        return math.log2(a)
    }
    if fi == 11 {
        return math.exp(a)
    }
    if fi == 12 {
        return math.floor(a)
    }
    if fi == 13 {
        return math.ceil(a)
    }
    if fi == 14 {
        return math.round(a)
    }
    if fi == 15 {
        return f_cbrt(a)
    }
    if fi == 16 {
        return f_pow(a, b)
    }
    if fi == 17 {
        return math.fmin(a, b)
    }
    if fi == 18 {
        return math.fmax(a, b)
    }
    if fi == 19 {
        return math.hypot(a, b)
    }
    if fi == 20 {
        var w2: f64 = math.atan2(a, b)
        if deg {
            w2 = w2 * r2d
        }
        return w2
    }
    if fi == 21 {
        if b == 0.0 {
            err = 2
            return 0.0
        }
        return math.fmod(a, b)
    }
    err = 1
    return 0.0
}

#[allow_fp]
fn p_atom() -> f64 {
    ws()
    let c: u64 = cur()
    if c == 40 {
        pos = pos + 1
        let v: f64 = p_expr()
        ws()
        if cur() == 41 {
            pos = pos + 1
        } else {
            err = 1
        }
        return v
    }
    if is_dig(c) || c == 46 {
        return p_num()
    }
    if is_alpha(c) {
        let nm: u64 = p_ident()
        let fi: u64 = idx_of((&FN[(0) as usize]) as u64, nm, NFN)
        ws()
        if cur() == 40 {
            if fi >= NFN {
                err = 1
                return 0.0
            }
            pos = pos + 1
            let a: f64 = p_expr()
            var b: f64 = 0.0
            if fi >= ZWEI {
                ws()
                if cur() == 44 {
                    pos = pos + 1
                    b = p_expr()
                } else {
                    err = 1
                }
            }
            ws()
            if cur() == 41 {
                pos = pos + 1
            } else {
                err = 1
            }
            return apply(fi, a, b)
        }
        let ci: u64 = idx_of((&CN[(0) as usize]) as u64, nm, NCN)
        if ci == 0 {
            return math.PI()
        }
        if ci == 1 {
            return math.E()
        }
        if ci == 2 {
            return ans
        }
        err = 1
        return 0.0
    }
    err = 1
    return 0.0
}

#[allow_fp]
fn p_post() -> f64 {
    var v: f64 = p_atom()
    ws()
    while cur() == 33 && err == 0 {
        pos = pos + 1
        v = f_fact(v)
        ws()
    }
    return v
}

#[allow_fp]
fn p_pow() -> f64 {
    let a: f64 = p_post()
    ws()
    if cur() == 94 {
        pos = pos + 1
        let b: f64 = p_unary()
        return f_pow(a, b)
    }
    return a
}

#[allow_fp]
fn p_unary() -> f64 {
    ws()
    if cur() == 45 {
        pos = pos + 1
        return 0.0 - p_unary()
    }
    if cur() == 43 {
        pos = pos + 1
        return p_unary()
    }
    return p_pow()
}

#[allow_fp]
fn p_term() -> f64 {
    var v: f64 = p_unary()
    var weiter: bool = true
    while weiter && err == 0 {
        ws()
        let c: u64 = cur()
        if c == 42 {
            pos = pos + 1
            v = v * p_unary()
        } else if c == 47 {
            pos = pos + 1
            let d: f64 = p_unary()
            if d == 0.0 {
                err = 2
                return 0.0
            }
            v = v / d
        } else if c == 37 {
            pos = pos + 1
            let m: f64 = p_unary()
            if m == 0.0 {
                err = 2
                return 0.0
            }
            v = math.fmod(v, m)
        } else {
            weiter = false
        }
    }
    return v
}

#[allow_fp]
fn p_expr() -> f64 {
    var v: f64 = p_term()
    var weiter: bool = true
    while weiter && err == 0 {
        ws()
        let c: u64 = cur()
        if c == 43 {
            pos = pos + 1
            v = v + p_term()
        } else if c == 45 {
            pos = pos + 1
            v = v - p_term()
        } else {
            weiter = false
        }
    }
    return v
}

// Der ganze Ausdruck. Was hinten stehenbleibt, ist ein Fehler -- sonst
// waere "2+3 quatsch" eine 5.
#[allow_fp]
fn eval(p: u64) -> f64 {
    srcp = p
    pos = 0
    err = 0
    if *((p) as *mut u8) == 0 as u8 {
        err = 1
        return 0.0
    }
    let v: f64 = p_expr()
    ws()
    if cur() != 0 {
        err = 1
    }
    if math.is_nan(v) || math.is_infinite(v) {
        err = 2
    }
    return v
}

// ============================ DIE ZAHL ALS TEXT

fn put_c(out: u64, at: u64, c: u64) -> u64 {
    __mmio_write8((out + at) as *mut u8, c as u8)
    return at + 1
}

fn put_u(out: u64, at: u64, v: u64) -> u64 {
    if v == 0 {
        return put_c(out, at, 48)
    }
    var t: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    while x > 0 {
        t[(n) as usize] = ((x % 10) + 48) as u8
        x = x / 10
        n = n + 1
    }
    var k: u64 = at
    while n > 0 {
        n = n - 1
        k = put_c(out, k, t[(n) as usize] as u64)
    }
    return k
}

// Nachkommastellen ausgeben und hinten die Nullen wegnehmen.
fn put_frac(out: u64, at: u64, frac: u64, stellen: u64) -> u64 {
    if stellen == 0 || frac == 0 {
        return at
    }
    var t: [u8; 24] = [0 as u8; 24]
    var x: u64 = frac
    var i: u64 = stellen
    while i > 0 {
        i = i - 1
        t[(i) as usize] = ((x % 10) + 48) as u8
        x = x / 10
    }
    var n: u64 = stellen
    while n > 0 && t[((n - 1)) as usize] == 48 as u8 {
        n = n - 1
    }
    if n == 0 {
        return at
    }
    var k: u64 = put_c(out, at, 46)
    i = 0
    while i < n {
        k = put_c(out, k, t[(i) as usize] as u64)
        i = i + 1
    }
    return k
}

// ZWOELF geltende Ziffern. Mehr waeren gelogen (der Zerteiler selbst
// rechnet mit 53 Bit, und `exp`/`ln` sind Naeherungen), weniger waeren
// aergerlich.
#[allow_fp]
fn fmt(x: f64, out: u64) {
    var s_nan: [u8; 4] = "nan\0"
    var s_inf: [u8; 4] = "inf\0"
    var at: u64 = 0
    if math.is_nan(x) {
        ulib.strcpy(out, (&s_nan[(0) as usize]) as u64)
        return
    }
    var v: f64 = x
    if v < 0.0 {
        at = put_c(out, at, 45)
        v = 0.0 - v
    }
    if math.is_infinite(v) {
        ulib.strcpy(out + at, (&s_inf[(0) as usize]) as u64)
        return
    }
    if v == 0.0 {
        at = put_c(out, at, 48)
        __mmio_write8((out + at) as *mut u8, 0 as u8)
        return
    }
    var e: i64 = math.floor(math.log10(v)) as i64
    // `log10` ist eine Naeherung: bei 1000 kann 2.9999... herauskommen.
    // Also nachsehen, statt zu glauben.
    if v / pow10(e) >= 10.0 {
        e = e + 1
    }
    if v / pow10(e) < 1.0 {
        e = e - 1
    }
    if e < 0 - 5 || e > 15 {
        let m: f64 = v / pow10(e)
        let sk: f64 = math.round(m * pow10(11))
        var gz: u64 = (sk / pow10(11)) as u64
        var fr: u64 = (sk - (gz as f64) * pow10(11)) as u64
        if gz >= 10 {
            gz = 1
            fr = 0
            e = e + 1
        }
        at = put_u(out, at, gz)
        at = put_frac(out, at, fr, 11)
        at = put_c(out, at, 101)
        if e < 0 {
            at = put_c(out, at, 45)
            at = put_u(out, at, (0 - e) as u64)
        } else {
            at = put_c(out, at, 43)
            at = put_u(out, at, e as u64)
        }
        __mmio_write8((out + at) as *mut u8, 0 as u8)
        return
    }
    var dec: i64 = 11 - e
    if dec < 0 {
        dec = 0
    }
    let skal: f64 = math.round(v * pow10(dec))
    let teiler: f64 = pow10(dec)
    var ganz: u64 = (skal / teiler) as u64
    var rest: u64 = (skal - (ganz as f64) * teiler) as u64
    at = put_u(out, at, ganz)
    at = put_frac(out, at, rest, dec as u64)
    __mmio_write8((out + at) as *mut u8, 0 as u8)
}

// ============================ EINHEITEN

const UKAT: u64 = 5
const UMAX: u64 = 8

static mut ufac: [f64; 40] = [0.0; 40]
static mut ucnt: [u64; 5] = [0; 5]

static mut U_KAT: [u8; 35] = "Länge\nMasse\nTemperatur\nZeit\nDaten\0"
static mut U_L: [u8; 20] = "m\nkm\ncm\nmm\nmi\nft\nin\0"
static mut U_M: [u8; 13] = "kg\ng\nt\nlb\noz\0"
static mut U_T: [u8; 10] = "°C\n°F\nK\0"
static mut U_Z: [u8; 10] = "s\nmin\nh\nd\0"
static mut U_D: [u8; 14] = "B\nKiB\nMiB\nGiB\0"

fn u_liste(k: u64) -> u64 {
    if k == 0 {
        return (&U_L[(0) as usize]) as u64
    }
    if k == 1 {
        return (&U_M[(0) as usize]) as u64
    }
    if k == 2 {
        return (&U_T[(0) as usize]) as u64
    }
    if k == 3 {
        return (&U_Z[(0) as usize]) as u64
    }
    return (&U_D[(0) as usize]) as u64
}

#[allow_fp]
fn u_setup() {
    ucnt[(0) as usize] = 7
    ufac[(0) as usize] = 1.0
    ufac[(1) as usize] = 1000.0
    ufac[(2) as usize] = 0.01
    ufac[(3) as usize] = 0.001
    ufac[(4) as usize] = 1609.344
    ufac[(5) as usize] = 0.3048
    ufac[(6) as usize] = 0.0254
    ucnt[(1) as usize] = 5
    ufac[(8) as usize] = 1.0
    ufac[(9) as usize] = 0.001
    ufac[(10) as usize] = 1000.0
    ufac[(11) as usize] = 0.45359237
    ufac[(12) as usize] = 0.028349523125
    ucnt[(2) as usize] = 3
    ucnt[(3) as usize] = 4
    ufac[(24) as usize] = 1.0
    ufac[(25) as usize] = 60.0
    ufac[(26) as usize] = 3600.0
    ufac[(27) as usize] = 86400.0
    ucnt[(4) as usize] = 4
    ufac[(32) as usize] = 1.0
    ufac[(33) as usize] = 1024.0
    ufac[(34) as usize] = 1048576.0
    ufac[(35) as usize] = 1073741824.0
}

// Temperatur ist kein Faktor, sondern eine Gerade. Deshalb steht sie
// hier fuer sich: erst nach Kelvin, dann von Kelvin weg.
#[allow_fp]
fn t_nach_k(i: u64, v: f64) -> f64 {
    if i == 0 {
        return v + 273.15
    }
    if i == 1 {
        return (v - 32.0) * 5.0 / 9.0 + 273.15
    }
    return v
}

#[allow_fp]
fn k_nach_t(i: u64, v: f64) -> f64 {
    if i == 0 {
        return v - 273.15
    }
    if i == 1 {
        return (v - 273.15) * 9.0 / 5.0 + 32.0
    }
    return v
}

#[allow_fp]
fn umrechnen(kat: u64, von: u64, nach: u64, v: f64) -> f64 {
    if kat == 2 {
        return k_nach_t(nach, t_nach_k(von, v))
    }
    let a: f64 = ufac[((kat * UMAX + von)) as usize]
    let b: f64 = ufac[((kat * UMAX + nach)) as usize]
    if b == 0.0 {
        return 0.0
    }
    return v * a / b
}

// ============================ DAS FENSTER

const T_GRUND: u64 = 0
const T_WISS: u64 = 1
const T_EINH: u64 = 2

static mut W_T: [u8; 8] = "Rechner\0"
static mut W_APP: [u8; 8] = "rechner\0"
static mut M_BAR: [u8; 20] = "Datei\nAnsicht\nHilfe\0"
static mut M_DATEI: [u8; 17] = "Löschen\nBeenden\0"
static mut M_ANS: [u8; 15] = "Bogenmaß\nGrad\0"
static mut M_HILFE: [u8; 6] = "Über\0"
static mut T_REITER: [u8; 33] = "Grund\nWissenschaftlich\nEinheiten\0"
static mut T_GLEICH: [u8; 2] = "=\0"
static mut T_UB: [u8; 10] = "Umrechnen\0"
static mut T_HINT: [u8; 40] = "Ausdruck eingeben, Eingabetaste rechnet\0"
static mut T_FEHL: [u8; 19] = "Fehler im Ausdruck\0"
static mut T_FEHL2: [u8; 16] = "nicht rechenbar\0"
static mut T_UEBER: [u8; 27] = "Rechner 1.0 -- Osum ALLTAG\0"
static mut T_LEER: [u8; 2] = " \0"

// Zwanzig Knoepfe, vier je Zeile, und daneben steht, was jeder
// einfuegt. `C` und `<-` stehen fuer sich; ihr Eintrag ist leer.
static mut P_TXT: [u8; 57] = "C\0(\0)\0<-\0 7\0 8\0 9\0 /\0 4\0 5\0 6\0 *\0 1\0 2\0 3\0 -\0 0\0 .\0 %\0 +\0"
static mut P_PROZ: [u8; 5] = "/100\0"
static mut S_TXT: [u8; 46] = "sqrt\0x^2\0x^y\0n!\0sin\0cos\0tan\0pi\0ln\0log\0exp\0ans\0"
static mut S_INS: [u8; 49] = "sqrt(\0^2\0^\0!\0sin(\0cos(\0tan(\0pi\0ln(\0log(\0exp(\0ans\0"

const NPAD: u64 = 20
const NSCI: u64 = 12

static mut pid: [u64; 20] = [0; 20]
static mut sid: [u64; 12] = [0; 12]

static mut tab: u64 = 0
static mut w_ent: u64 = 0
static mut w_res: u64 = 0
static mut w_tabs: u64 = 0
static mut w_bar: u64 = 0
static mut w_eq: u64 = 0
static mut w_ukat: u64 = 0
static mut w_uv: u64 = 0
static mut w_uvon: u64 = 0
static mut w_unach: u64 = 0
static mut w_ures: u64 = 0
static mut w_ub: u64 = 0
static mut c_top: u64 = 0
static mut c_pad: u64 = 0
static mut c_sci: u64 = 0
static mut c_eq: u64 = 0
static mut c_uni: u64 = 0
static mut c_ur: u64 = 0
static mut bw: u64 = 0
static mut bh: u64 = 0

fn say(p: u64) {
    ulib.say(p)
}

fn ex_len() -> u64 {
    return ulib.length((&ex[(0) as usize]) as u64)
}

// Die Aufschrift eines Knopfes ist zugleich das, was er einfuegt --
// bis auf die Leerzeichen davor, die nur die Ziffern vom Trennzeichen
// des Blocks fernhalten.
fn ohne_luft(p: u64) -> u64 {
    var q: u64 = p
    while *((q) as *mut u8) == 32 as u8 {
        q = q + 1
    }
    return q
}

fn ex_anhaengen(p: u64) {
    let b: u64 = (&ex[(0) as usize]) as u64
    var n: u64 = ex_len()
    var k: u64 = 0
    while *((p + k) as *mut u8) != 0 as u8 && n < MAXEX {
        __mmio_write8((b + n) as *mut u8, *((p + k) as *mut u8))
        n = n + 1
        k = k + 1
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    wlib.set_text(w_ent, b)
}

fn ex_leeren() {
    __mmio_write8(((&ex[(0) as usize]) as u64) as *mut u8, 0 as u8)
    wlib.set_text(w_ent, (&ex[(0) as usize]) as u64)
}

fn ex_zurueck() {
    let b: u64 = (&ex[(0) as usize]) as u64
    var n: u64 = ex_len()
    if n == 0 {
        return
    }
    n = n - 1
    // Ein UTF-8-Folgeoktett ist kein Zeichen; weiter zurueck.
    while n > 0 && ((*((b + n) as *mut u8)) as u64) >= 128
        && ((*((b + n) as *mut u8)) as u64) < 192 {
        n = n - 1
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    wlib.set_text(w_ent, b)
}

#[allow_fp]
fn rechnen() {
    let r: u64 = (&res[(0) as usize]) as u64
    let v: f64 = eval((&ex[(0) as usize]) as u64)
    if err == 1 {
        ulib.strcpy(r, (&T_FEHL[(0) as usize]) as u64)
    } else if err != 0 {
        ulib.strcpy(r, (&T_FEHL2[(0) as usize]) as u64)
    } else {
        ans = v
        fmt(v, r)
    }
    wlib.set_text(w_res, r)
    say(r)
    ulib.nl()
}

#[allow_fp]
fn u_rechnen() {
    let r: u64 = (&ures[(0) as usize]) as u64
    let v: f64 = eval((&uval[(0) as usize]) as u64)
    if err != 0 {
        ulib.strcpy(r, (&T_FEHL[(0) as usize]) as u64)
    } else {
        fmt(umrechnen(wlib.value(w_ukat), wlib.value(w_uvon),
            wlib.value(w_unach), v), r)
    }
    wlib.set_text(w_ures, r)
    say(r)
    ulib.nl()
}

// Die Kaesten je Reiter dorthin legen, wo der sichtbare Teil anfaengt.
// Kein Kasten kennt eine feste Zeile: der Anfang ist die Unterkante des
// Kopfes, und die rechnet wlib aus.
fn r4(v: u64) -> u64 {
    return v & 0xFFFFFFFFFFFFFFFC
}

fn anordnen() {
    let rand: u64 = wlib.inset()
    let luft: u64 = wlib.inset() / 2
    let zh: u64 = wlib.zeilen_hoehe()
    let kh: u64 = wlibc.metric(wlibc.M_CTRL_H) + luft
    let innen: u64 = bw - rand * 2
    var y: u64 = r4(wlib.rect_y(w_res) + wlib.rect_h(w_res)
        + luft * 2 + 3)
    let sh: u64 = r4(kh * 3 + luft * 2)
    let ph: u64 = r4(kh * 5 + luft * 4)
    if tab == T_WISS {
        wlib.box_at(c_sci, rand, y, innen, sh)
        y = y + sh + luft * 2
    } else {
        wlib.box_at(c_sci, rand, y, innen, 0)
    }
    if tab == T_EINH {
        wlib.box_at(c_uni, rand, y, innen, kh * 3 + luft * 2)
        wlib.box_at(c_ur, rand, y + kh * 3 + luft * 4, innen, zh + kh)
        wlib.box_at(c_pad, rand, y, 0, 0)
        wlib.box_at(c_eq, rand, y, 0, 0)
    } else {
        wlib.box_at(c_pad, rand, y, innen, ph)
        wlib.box_at(c_eq, rand, y + ph + luft, innen, kh)
        wlib.box_at(c_uni, rand, y, 0, 0)
        wlib.box_at(c_ur, rand, y, 0, 0)
    }
    var i: u64 = 0
    while i < NPAD {
        wlib.show(pid[(i) as usize], tab != T_EINH)
        i = i + 1
    }
    i = 0
    while i < NSCI {
        wlib.show(sid[(i) as usize], tab == T_WISS)
        i = i + 1
    }
    wlib.show(w_eq, tab != T_EINH)
    wlib.show(w_ukat, tab == T_EINH)
    wlib.show(w_uv, tab == T_EINH)
    wlib.show(w_uvon, tab == T_EINH)
    wlib.show(w_unach, tab == T_EINH)
    wlib.show(w_ures, tab == T_EINH)
    wlib.show(w_ub, tab == T_EINH)
    wlib.neu_setzen()
}

fn kat_wechsel() {
    let k: u64 = wlib.value(w_ukat)
    wlib.set_text(w_uvon, u_liste(k))
    wlib.set_text(w_unach, u_liste(k))
    wlib.set_value(w_uvon, 0)
    var z: u64 = 1
    if ucnt[(k) as usize] < 2 {
        z = 0
    }
    wlib.set_value(w_unach, z)
}

fn menue_datei() {
    wlib.menu_open(w_bar, wlib.win_x(0) + wlib.inset(),
        wlib.win_y(0) + wlib.rect_y(w_bar) + wlib.rect_h(w_bar),
        (&M_DATEI[(0) as usize]) as u64, 2)
}

fn u_gui() -> u64 {
    var s_bad: [u8; 23] = "rechner: keine Flaeche\0"
    var s_go: [u8; 15] = "rechner: ready\0"
    var s_geom: [u8; 17] = "rechner: geom w=\0"
    var s_h: [u8; 4] = " h=\0"
    if !wlib.begin(false, false) {
        say((&s_bad[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    u_setup()
    bw = 340
    bh = 430
    let w: u64 = wlib.window(80, 60, bw, bh, (&W_T[(0) as usize]) as u64)
    if w >= wlib.MAXWN {
        say((&s_bad[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    let _a: u64 = wlib.window_app(w, (&W_APP[(0) as usize]) as u64)
    let rand: u64 = wlib.inset()
    let luft: u64 = wlib.inset() / 2

    c_top = wlib.box_v(w, 0, 0, bw, bh, rand, luft)
    w_bar = wlib.menubar((&M_BAR[(0) as usize]) as u64)
    w_tabs = wlib.tabs((&T_REITER[(0) as usize]) as u64)
    ulib.strcpy((&ex[(0) as usize]) as u64, (&T_LEER[(0) as usize]) as u64)
    __mmio_write8(((&ex[(0) as usize]) as u64) as *mut u8, 0 as u8)
    w_ent = wlib.entry((&ex[(0) as usize]) as u64, MAXEX)
    ulib.strcpy((&res[(0) as usize]) as u64, (&T_HINT[(0) as usize]) as u64)
    w_res = wlib.label((&res[(0) as usize]) as u64)
    wlib.box_end()

    let innen: u64 = bw - rand * 2
    c_sci = wlib.box_grid(w, rand, 0, innen, 0, 0, luft, 4)
    var i: u64 = 0
    while i < NSCI {
        wlib.size(0, 0)
        sid[(i) as usize] = wlib.button(nth((&S_TXT[(0) as usize]) as u64, i))
        i = i + 1
    }
    wlib.box_end()

    c_pad = wlib.box_grid(w, rand, 0, innen, 0, 0, luft, 4)
    i = 0
    while i < NPAD {
        wlib.size(0, 0)
        pid[(i) as usize] = wlib.button(nth((&P_TXT[(0) as usize]) as u64, i))
        i = i + 1
    }
    wlib.box_end()

    c_eq = wlib.box_h(w, rand, 0, innen, 0, 0, 0)
    wlib.size(innen, 0)
    w_eq = wlib.button((&T_GLEICH[(0) as usize]) as u64)
    wlib.box_end()

    c_uni = wlib.box_grid(w, rand, 0, innen, 0, 0, luft, 2)
    wlib.size(0, wlib.ctrl_thin())
    w_ukat = wlib.choice((&U_KAT[(0) as usize]) as u64, 0)
    wlib.size(0, wlib.ctrl_thin())
    w_uv = wlib.entry((&uval[(0) as usize]) as u64, 60)
    wlib.size(0, wlib.ctrl_thin())
    w_uvon = wlib.choice(u_liste(0), 0)
    wlib.size(0, wlib.ctrl_thin())
    w_unach = wlib.choice(u_liste(0), 1)
    wlib.box_end()

    c_ur = wlib.box_v(w, rand, 0, innen, 0, 0, luft)
    wlib.size(innen, 0)
    w_ub = wlib.button((&T_UB[(0) as usize]) as u64)
    ulib.strcpy((&ures[(0) as usize]) as u64, (&T_LEER[(0) as usize]) as u64)
    w_ures = wlib.label((&ures[(0) as usize]) as u64)
    wlib.box_end()

    anordnen()
    wlib.set_focus(w_ent)
    // ERST SAGEN, DANN MALEN. Der Pruefer schneidet den Mitschnitt an
    // dieser Zeile ab; stuende sie nach `draw_all`, laege jeder Text
    // dieses Fensters davor und er saehe keinen einzigen.
    say((&s_geom[(0) as usize]) as u64)
    ulib.sayn(bw)
    say((&s_h[(0) as usize]) as u64)
    ulib.sayn(bh)
    ulib.nl()
    var s_nm: [u8; 8] = "rechner\0"
    wlib.say_rects((&s_nm[(0) as usize]) as u64)
    wlib.draw_all()
    say((&s_go[(0) as usize]) as u64)
    ulib.nl()

    var runden: u64 = 0
    while wlib.alive() && runden < 40000000 {
        runden = runden + 1
        let id: u64 = wlib.step()
        if id < wlib.MAXWD {
            let kind: u64 = wlib.fired_kind()
            let idx: u64 = wlib.fired_index()
            if kind == wlib.K_TABS {
                tab = idx
                anordnen()
            } else if kind == wlib.K_ENTRY {
                if id == w_ent {
                    rechnen()
                } else if id == w_uv {
                    u_rechnen()
                }
            } else if kind == wlib.K_CHOICE {
                if id == w_ukat {
                    kat_wechsel()
                }
            } else if kind == wlib.K_MENUBAR {
                if id == w_bar {
                    if idx >= 0x1000 {
                        let welches: u64 = idx - 0x1000
                        if welches == 0 {
                            menue_datei()
                        } else if welches == 1 {
                            wlib.menu_open(w_bar, wlibc.mouse_x(),
                                wlibc.mouse_y(),
                                (&M_ANS[(0) as usize]) as u64, 2)
                        } else {
                            wlib.menu_open(w_bar, wlibc.mouse_x(),
                                wlibc.mouse_y(),
                                (&M_HILFE[(0) as usize]) as u64, 1)
                        }
                    } else if idx == 0 {
                        ex_leeren()
                    } else if idx == 1 {
                        wlib.quit()
                    }
                }
            } else if kind == wlib.K_BUTTON {
                if id == w_eq {
                    rechnen()
                } else if id == w_ub {
                    u_rechnen()
                } else {
                    var k: u64 = 0
                    while k < NPAD {
                        if pid[(k) as usize] == id {
                            if k == 0 {
                                ex_leeren()
                            } else if k == 3 {
                                ex_zurueck()
                            } else if k == 18 {
                                ex_anhaengen((&P_PROZ[(0) as usize]) as u64)
                            } else {
                                ex_anhaengen(ohne_luft(nth(
                                    (&P_TXT[(0) as usize]) as u64, k)))
                            }
                        }
                        k = k + 1
                    }
                    k = 0
                    while k < NSCI {
                        if sid[(k) as usize] == id {
                            ex_anhaengen(nth(
                                (&S_INS[(0) as usize]) as u64, k))
                        }
                        k = k + 1
                    }
                }
            }
        }
    }
    return 0
}

// ============================ DIE KONSOLE

#[allow_fp]
fn u_start(args: u64) -> u64 {
    var s_e: [u8; 3] = "-e\0"
    var s_deg: [u8; 5] = "-deg\0"
    var s_use: [u8; 35] = "rechner: rechner -e \"2+3*4\" [-deg]\0"
    let argc: u64 = ulib.arg_count(args)
    var ausdruck: u64 = 0
    var a: u64 = 1
    while a < argc {
        let p: u64 = ulib.arg_at(args, a)
        if ulib.streq(p, (&s_e[(0) as usize]) as u64) {
            if a + 1 < argc {
                ausdruck = ulib.arg_at(args, a + 1)
                a = a + 1
            }
        } else if ulib.streq(p, (&s_deg[(0) as usize]) as u64) {
            deg = true
        }
        a = a + 1
    }
    if argc > 1 && ausdruck == 0 {
        say((&s_use[(0) as usize]) as u64)
        ulib.nl()
        return 2
    }
    if ausdruck == 0 {
        return u_gui()
    }
    let r: u64 = (&res[(0) as usize]) as u64
    let v: f64 = eval(ausdruck)
    if err == 1 {
        say((&T_FEHL[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    if err != 0 {
        say((&T_FEHL2[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    fmt(v, r)
    say(r)
    ulib.nl()
    return 0
}
