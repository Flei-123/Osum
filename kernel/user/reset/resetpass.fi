profile kernel

import libc.errno
import libc.fileops
import libc.io

export { take }

const NEWLINE: u64 = 10
const WIPE_CHUNK: u64 = 128

fn cut_line(buf: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < n {
        if __mmio_read8((buf + i) as *mut u8) as u64 <= NEWLINE {
            break
        }
        i = i + 1
    }
    __mmio_write8((buf + i) as *mut u8, 0 as u8)
    return i
}

fn wipe(path: u64, n: u64) {
    var zeros: [u8; 128] = [0 as u8; 128]
    var len: u64 = n
    if len > WIPE_CHUNK {
        len = WIPE_CHUNK
    }
    let _w: u64 = fileops.write_file(path, (&zeros[0]) as u64, len)
}

fn take(path: u64, out: u64, cap: u64) -> bool {
    let n: u64 = fileops.read_all(path, out, cap - 1)
    if errno.failed(n) {
        return false
    }
    wipe(path, n)
    let _u: u64 = io.unlink(path)
    return cut_line(out, n) > 0
}
