profile kernel

import ulib
import libc.io
import libc.errno
import libc.text
import libc.octets

export { remove_tree, remove_children, join_path, is_dot_name, DIR_BATCH }

const MAX_DEPTH: u64 = 8
const PATH_MAX: u64 = 256
const DIR_BATCH: u64 = 512
const MAX_PASSES: u64 = 64
const DOT: u64 = 46
const SLASH: u64 = 47

fn is_dot_name(name: u64) -> bool {
    if octets.ld8(name, 0) != DOT {
        return false
    }
    let second: u64 = octets.ld8(name, 1)
    if second == 0 {
        return true
    }
    return second == DOT && octets.ld8(name, 2) == 0
}

fn join_path(out: u64, base: u64, name: u64) -> bool {
    let base_len: u64 = text.length(base)
    if base_len + text.length(name) + 2 >= PATH_MAX {
        return false
    }
    ulib.strcpy(out, base)
    var at: u64 = base_len
    if base_len == 0 || octets.ld8(base, base_len - 1) != SLASH {
        octets.st8(out, at, SLASH)
        at = at + 1
    }
    ulib.strcpy(out + at, name)
    return true
}

fn sweep_pass(dir: u64, depth: u64) -> u64 {
    var entries: [u8; 512] = [0 as u8; 512]
    var child: [u8; 256] = [0 as u8; 256]
    let fd: u64 = io.dir_open(dir)
    if errno.failed(fd) {
        return 0
    }
    let got: u64 = io.dir_read(fd, (&entries[0]) as u64, DIR_BATCH)
    if errno.failed(got) || got == 0 {
        io.close(fd)
        return 0
    }
    var removed: u64 = 0
    var at: u64 = 0
    while at < got {
        let rec: u64 = (&entries[0]) as u64 + at
        let name: u64 = io.dir_name(rec)
        if !is_dot_name(name) && join_path((&child[0]) as u64, dir, name) {
            if io.dir_kind(rec) == io.DT_DIR {
                if depth < MAX_DEPTH && remove_children((&child[0]) as u64, depth + 1)
                    && !errno.failed(io.remove_dir((&child[0]) as u64)) {
                    removed = removed + 1
                }
            } else if !errno.failed(io.unlink((&child[0]) as u64)) {
                removed = removed + 1
            }
        }
        at = at + io.dir_reclen(rec)
    }
    io.close(fd)
    return removed
}

fn remove_children(dir: u64, depth: u64) -> bool {
    var pass: u64 = 0
    var progressed: bool = true
    while progressed && pass < MAX_PASSES {
        progressed = sweep_pass(dir, depth) > 0
        pass = pass + 1
    }
    return remaining(dir) == 0
}

fn remaining(dir: u64) -> u64 {
    var entries: [u8; 512] = [0 as u8; 512]
    let fd: u64 = io.dir_open(dir)
    if errno.failed(fd) {
        return 0
    }
    let got: u64 = io.dir_read(fd, (&entries[0]) as u64, DIR_BATCH)
    var count: u64 = 0
    if !errno.failed(got) {
        var at: u64 = 0
        while at < got {
            if !is_dot_name(io.dir_name((&entries[0]) as u64 + at)) {
                count = count + 1
            }
            at = at + io.dir_reclen((&entries[0]) as u64 + at)
        }
    }
    io.close(fd)
    return count
}

fn remove_tree(path: u64) -> bool {
    if !remove_children(path, 0) {
        return false
    }
    return !errno.failed(io.remove_dir(path))
}
