profile app

import fuiscene
import libc.octets

export { show, choose, pick, is_open, close, count }

const ITEMS_MAX: u64 = 480
const ROWS_MAX: u64 = 24

static mut item_buf: [u8; 512] = [0 as u8; 512]
static mut item_count: u64 = 0

fn load(spec: u64) -> u64 {
    let b: u64 = (&item_buf[0 as usize]) as u64
    var n: u64 = 0
    var rows: u64 = 0
    var i: u64 = 0
    var started: bool = false
    while octets.ld8(spec, i) != 0 && n < ITEMS_MAX && rows < ROWS_MAX {
        let c: u64 = octets.ld8(spec, i)
        if c == 10 {
            if started {
                octets.st8(b, n, 0)
                n = n + 1
                rows = rows + 1
                started = false
            }
        } else {
            octets.st8(b, n, c)
            n = n + 1
            started = true
        }
        i = i + 1
    }
    if started {
        octets.st8(b, n, 0)
        rows = rows + 1
    }
    item_count = rows
    return rows
}

fn count() -> u64 {
    return item_count
}

fn show(x: u64, y: u64, w: u64, items: u64) -> bool {
    let n: u64 = load(items)
    if n == 0 || !fuiscene.alive() {
        return false
    }
    fuiscene.menu_open(x, y, w, (&item_buf[0 as usize]) as u64, n)
    return true
}

fn pick() -> u64 {
    return fuiscene.menu_pick()
}

fn is_open() -> bool {
    return fuiscene.menu_is_open()
}

fn close() {
    fuiscene.menu_close()
}

fn choose(x: u64, y: u64, w: u64, items: u64) -> u64 {
    if !show(x, y, w, items) {
        return 0
    }
    var res: u64 = 0
    while fuiscene.alive() && fuiscene.menu_is_open() {
        let k: u64 = fuiscene.pump()
        if k == fuiscene.KEY_POPUP {
            res = fuiscene.menu_pick()
            break
        }
    }
    if res == 0 {
        res = fuiscene.menu_pick()
    }
    return res
}
