// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/basename.fi -- Runde K11: der letzte Teil eines Pfades.
//
// POSIX, und die Sonderfaelle sind der ganze Inhalt: nachfolgende
// Schraegstriche fallen weg, `/` bleibt `/`, und ein zweites Argument
// ist eine Endung, die abgeschnitten wird -- aber nur, wenn danach etwas
// stehen bleibt (`basename x.c .c` ist `x`, `basename .c .c` ist `.c`).

profile kernel

import ulib
import tools

export { u_start }

static mut buf: [u8; 256] = [0 as u8; 256]

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 26] = "basename: needs a path\0\0\0\0"
    var s_root: [u8; 2] = "/\0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    ulib.strncpy((&buf[0 as usize]) as u64, ulib.arg_at(args, 1), 256)
    var n: u64 = ulib.length((&buf[0 as usize]) as u64)
    // Nachfolgende Schraegstriche weg -- aber `/` selbst ist `/`.
    while n > 1 && buf[(n - 1) as usize] == 47 as u8 {
        n = n - 1
        buf[(n) as usize] = 0 as u8
    }
    if n == 1 && buf[0 as usize] == 47 as u8 {
        tools.ob_str((&s_root[0 as usize]) as u64)
        tools.ob_nl()
        tools.ob_flush()
        return 0
    }
    var start: u64 = 0
    var i: u64 = n
    while i > 0 {
        i = i - 1
        if buf[(i) as usize] == 47 as u8 {
            start = i + 1
            i = 0
        }
    }
    var len: u64 = n - start
    if argc > 2 {
        let suf: u64 = ulib.arg_at(args, 2)
        let sl: u64 = ulib.length(suf)
        if sl > 0 && sl < len
        && tools.same_bytes((&buf[(start + len - sl) as usize]) as u64, suf, sl) {
            len = len - sl
        }
    }
    tools.ob_put((&buf[(start) as usize]) as u64, len)
    tools.ob_nl()
    tools.ob_flush()
    return 0
}
