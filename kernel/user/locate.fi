// kernel/user/locate.fi -- Runde K15, zweiter Nachtrag: /bin/locate.
//
// DER NAMENSINDEX AUF DER BEFEHLSZEILE -- und derselbe Index, den das
// Fenster mit dem Suchfeld benutzt (`kernel/user/nidx.fi`). Er ist hier,
// weil eine Zahl, die nur eine Oberflaeche behauptet, schwer nachzurechnen
// ist: dieses Programm schreibt auf die Standardausgabe, und der
// Testlaeufer liest sie Zeile fuer Zeile.
//
//     locate <wort>            im Index suchen und die Pfade zeigen
//     locate -b <wort>         BAUMDURCHLAUF statt Index (die Gegenprobe)
//     locate -m <wort>         MESSEN: beide Wege, beide Zeiten, beide
//                              Trefferlisten -- und der Vergleich
//     locate -j <wort>         wie -m, aber vorher eine Datei anlegen,
//                              umbenennen und loeschen: der Index muss
//                              das aus dem Journal wissen, OHNE neu zu
//                              bauen
//     locate -n <wort>         GEGENPROBE zu -j: dasselbe, aber das
//                              Journal wird NICHT abgeholt. Der Index
//                              weiss dann nichts von der neuen Datei.
//
// WAS HIER GEMESSEN WIRD UND WAS NICHT. Gemessen wird die Zeit fuer den
// Aufbau (wie viele Namen, wie viele Systemaufrufe, wie viele
// Mikrosekunden) und die Zeit fuer eine Suche darin. Die beiden sind
// nicht dieselbe Groessenordnung, und das ist die ganze Aussage: der
// Aufbau ist einmal, die Suche ist bei jedem Tastendruck.
//
// DIE GEGENPROBE IST NICHT "DER INDEX IST SCHNELLER". Das waere leicht
// und nichts wert -- ein Index, der nichts findet, ist unendlich
// schnell. Die Gegenprobe ist: DIESELBEN TREFFER. Beide Wege liefern
// ihre Namen, beide Listen werden sortiert und Oktett fuer Oktett
// verglichen, und erst wenn sie gleich sind, sagt die Zeit etwas.

profile kernel

import ulib
import libc.io
import nidx

export { u_start }

const MAXT: u64 = 256

static mut ti: [u64; 256] = [0 as u64; 256] // Treffer des Index
static mut tw: [u8; 6144] = [0 as u8; 6144] // Treffer des Baumes, 256 * 24
static mut ni_: [u8; 6144] = [0 as u8; 6144] // dieselben aus dem Index
static mut pfad: [u8; 320] = [0 as u8; 320]

fn say(p: u64) {
    ulib.say(p)
}

fn kv(name: u64, v: u64) {
    var sp: [u8; 2] = " \0"
    say(name)
    ulib.sayn(v)
    say((&sp[0 as usize]) as u64)
}

// Die Namensliste sortieren -- Einfuegen, weil sie hoechstens 256 lang
// ist und der Vergleich danach der eigentliche Punkt ist.
fn sortiere(feld: u64, n: u64) {
    var i: u64 = 1
    while i < n {
        var k: u64 = i
        while k > 0 && kleiner(feld + k * nidx.NAMEN,
            feld + (k - 1) * nidx.NAMEN) {
            tausche(feld + k * nidx.NAMEN, feld + (k - 1) * nidx.NAMEN)
            k = k - 1
        }
        i = i + 1
    }
}

fn kleiner(a: u64, b: u64) -> bool {
    var k: u64 = 0
    while k < nidx.NAMEN {
        let x: u64 = __mmio_read8((a + k) as *mut u8) as u64
        let y: u64 = __mmio_read8((b + k) as *mut u8) as u64
        if x != y {
            return x < y
        }
        if x == 0 {
            return false
        }
        k = k + 1
    }
    return false
}

fn tausche(a: u64, b: u64) {
    var k: u64 = 0
    while k < nidx.NAMEN {
        let x: u8 = __mmio_read8((a + k) as *mut u8)
        __mmio_write8((a + k) as *mut u8, __mmio_read8((b + k) as *mut u8))
        __mmio_write8((b + k) as *mut u8, x)
        k = k + 1
    }
}

fn feld_gleich(a: u64, b: u64, n: u64) -> u64 {
    var falsch: u64 = 0
    var i: u64 = 0
    while i < n {
        var k: u64 = 0
        var gleich: bool = true
        while k < nidx.NAMEN {
            if __mmio_read8((a + i * nidx.NAMEN + k) as *mut u8)
                != __mmio_read8((b + i * nidx.NAMEN + k) as *mut u8) {
                gleich = false
                k = nidx.NAMEN
            } else {
                k = k + 1
            }
        }
        if !gleich {
            falsch = falsch + 1
        }
        i = i + 1
    }
    return falsch
}

// Die Namen der Index-Treffer in ein Feld, damit sie sich mit denen des
// Baumdurchlaufs vergleichen lassen.
fn namen_aus_index(n: u64) {
    var i: u64 = 0
    while i < n {
        let q: u64 = nidx.name_at(ti[(i) as usize])
        var k: u64 = 0
        while k < nidx.NAMEN {
            ni_[((i * nidx.NAMEN + k)) as usize] =
                __mmio_read8((q + k) as *mut u8)
            k = k + 1
        }
        i = i + 1
    }
}

fn zeige(n: u64) {
    var s_h: [u8; 16] = "locate: pfad \0\0\0"
    var i: u64 = 0
    while i < n && i < 20 {
        nidx.path_of(ti[(i) as usize], (&pfad[0 as usize]) as u64, 300)
        say((&s_h[0 as usize]) as u64)
        say((&pfad[0 as usize]) as u64)
        ulib.nl()
        i = i + 1
    }
}

// Der Aufbau, mit seinen Zahlen. Getrennt, weil ihn `-m`, `-j` und `-n`
// alle brauchen.
fn bauen() {
    var s_b: [u8; 20] = "locate: bauen n=\0\0\0\0"
    var s_r: [u8; 12] = " saetze=\0\0\0\0"
    var s_c: [u8; 12] = " aufrufe=\0\0\0"
    var s_u: [u8; 8] = " us=\0\0\0\0"
    var s_t: [u8; 12] = " abgeschn=\0\0"
    let t0: u64 = nidx.mono_us()
    let n: u64 = nidx.build()
    let us: u64 = nidx.mono_us() -% t0
    say((&s_b[0 as usize]) as u64)
    ulib.sayn(n)
    kv((&s_r[0 as usize]) as u64, nidx.records())
    kv((&s_c[0 as usize]) as u64, nidx.calls())
    kv((&s_u[0 as usize]) as u64, us)
    kv((&s_t[0 as usize]) as u64, nidx.truncated())
    ulib.nl()
}

// EINE SUCHE IM INDEX, mit Zeit. Zehnmal, weil eine einzelne Suche
// unter der Koernung der Uhr liegen kann -- und dann waere "0 us" keine
// Messung, sondern das Ende des Lineals. Die Zahl daneben ist die Summe
// der zehn; geteilt wird draussen, wo man beide sieht.
fn suche_index(wort: u64) -> u64 {
    var s_s: [u8; 20] = "locate: index [\0\0\0\0\0"
    var s_t: [u8; 14] = "] treffer=\0\0\0\0"
    var s_u: [u8; 10] = " us10=\0\0\0\0"
    var s_g: [u8; 10] = " gesamt=\0\0"
    let t0: u64 = nidx.mono_us()
    var n: u64 = 0
    var r: u64 = 0
    while r < 10 {
        n = nidx.find(wort, (&ti[0 as usize]) as u64, MAXT)
        r = r + 1
    }
    let us: u64 = nidx.mono_us() -% t0
    say((&s_s[0 as usize]) as u64)
    say(wort)
    say((&s_t[0 as usize]) as u64)
    ulib.sayn(n)
    kv((&s_u[0 as usize]) as u64, us)
    kv((&s_g[0 as usize]) as u64, nidx.count())
    ulib.nl()
    return n
}

fn suche_baum(wort: u64) -> u64 {
    var s_s: [u8; 20] = "locate: baum [\0\0\0\0\0\0"
    var s_t: [u8; 14] = "] treffer=\0\0\0\0"
    var s_u: [u8; 8] = " us=\0\0\0\0"
    var s_g: [u8; 10] = " gesehen=\0"
    let t0: u64 = nidx.mono_us()
    let n: u64 = nidx.walk_find(wort, (&tw[0 as usize]) as u64, MAXT)
    let us: u64 = nidx.mono_us() -% t0
    say((&s_s[0 as usize]) as u64)
    say(wort)
    say((&s_t[0 as usize]) as u64)
    ulib.sayn(n)
    kv((&s_u[0 as usize]) as u64, us)
    kv((&s_g[0 as usize]) as u64, nidx.walk_seen())
    ulib.nl()
    return n
}

fn vergleiche(a: u64, b: u64) {
    var s_v: [u8; 28] = "locate: vergleich index=\0\0\0\0"
    var s_b: [u8; 8] = " baum=\0\0"
    var s_f: [u8; 12] = " ungleich=\0\0"
    var falsch: u64 = 0
    if a != b {
        falsch = 999
    } else {
        namen_aus_index(a)
        sortiere((&ni_[0 as usize]) as u64, a)
        sortiere((&tw[0 as usize]) as u64, b)
        falsch = feld_gleich((&ni_[0 as usize]) as u64,
            (&tw[0 as usize]) as u64, a)
    }
    say((&s_v[0 as usize]) as u64)
    ulib.sayn(a)
    kv((&s_b[0 as usize]) as u64, b)
    kv((&s_f[0 as usize]) as u64, falsch)
    ulib.nl()
}

// ANLEGEN, UMBENENNEN, LOESCHEN -- und der Index darf davon wissen, ohne
// neu zu bauen. Umbenannt wird durch Kopieren und Loeschen, weil dieser
// Kernel kein `rename` hat; fuer den Namensindex ist das ohnehin
// dasselbe: ein Name vergeht, ein anderer entsteht.
fn journalprobe(mit_journal: bool) {
    var p1: [u8; 31] = "/data/zwiebelkuchen.txt\0\0\0\0\0\0\0\0"
    var p2: [u8; 31] = "/data/apfelstrudel.txt\0\0\0\0\0\0\0\0\0"
    var s_a: [u8; 24] = "locate: journal seq=\0\0\0\0"
    var s_l: [u8; 10] = " lost=\0\0\0\0"
    var s_n: [u8; 12] = " gezogen=\0\0\0"
    var s_c: [u8; 10] = " namen=\0\0\0"
    var s_s: [u8; 12] = " schritt=\0\0\0"
    var schritt: u64 = 0
    var gezogen: u64 = 0
    // 1. anlegen
    let fd: u64 = io.create((&p1[0 as usize]) as u64)
    if !ulib.bad(fd) {
        io.close(fd)
        schritt = schritt + 1
    }
    if mit_journal {
        gezogen = gezogen + nidx.poll()
    }
    melde((&s_a[0 as usize]) as u64, (&s_l[0 as usize]) as u64,
        (&s_n[0 as usize]) as u64, (&s_c[0 as usize]) as u64,
        (&s_s[0 as usize]) as u64, gezogen, schritt)
    // 2. umbenennen (kopieren und loeschen)
    let fd2: u64 = io.create((&p2[0 as usize]) as u64)
    if !ulib.bad(fd2) {
        io.close(fd2)
        schritt = schritt + 1
    }
    io.unlink((&p1[0 as usize]) as u64)
    schritt = schritt + 1
    if mit_journal {
        gezogen = gezogen + nidx.poll()
    }
    melde((&s_a[0 as usize]) as u64, (&s_l[0 as usize]) as u64,
        (&s_n[0 as usize]) as u64, (&s_c[0 as usize]) as u64,
        (&s_s[0 as usize]) as u64, gezogen, schritt)
    // 3. loeschen
    io.unlink((&p2[0 as usize]) as u64)
    schritt = schritt + 1
    if mit_journal {
        gezogen = gezogen + nidx.poll()
    }
    melde((&s_a[0 as usize]) as u64, (&s_l[0 as usize]) as u64,
        (&s_n[0 as usize]) as u64, (&s_c[0 as usize]) as u64,
        (&s_s[0 as usize]) as u64, gezogen, schritt)
}

fn melde(a: u64, l: u64, n: u64, c: u64, s: u64, gezogen: u64,
    schritt: u64) {
    var w1: [u8; 12] = "zwiebel\0\0\0\0\0"
    var w2: [u8; 12] = "apfel\0\0\0\0\0\0\0"
    var s_a: [u8; 12] = " zwiebel=\0\0\0"
    var s_b: [u8; 10] = " apfel=\0\0\0"
    say(a)
    ulib.sayn(nidx.seq_now())
    kv(l, nidx.lost_seen())
    kv(n, gezogen)
    kv(c, nidx.count())
    kv(s, schritt)
    // WAS DER INDEX JETZT FINDET, und das ist die eigentliche Zusage:
    // eine Zahl von Namen kann zufaellig stimmen, ein Name nicht. Nach
    // dem Anlegen muss "zwiebel" da sein, nach dem Umbenennen "apfel"
    // statt "zwiebel", nach dem Loeschen keines von beiden.
    kv((&s_a[0 as usize]) as u64,
        nidx.find((&w1[0 as usize]) as u64, (&ti[0 as usize]) as u64, MAXT))
    kv((&s_b[0 as usize]) as u64,
        nidx.find((&w2[0 as usize]) as u64, (&ti[0 as usize]) as u64, MAXT))
    ulib.nl()
}

fn u_start(args: u64) -> u64 {
    var o_b: [u8; 4] = "-b\0\0"
    var o_m: [u8; 4] = "-m\0\0"
    var o_j: [u8; 4] = "-j\0\0"
    var o_n: [u8; 4] = "-n\0\0"
    var s_hilf: [u8; 44] = "locate: <wort> | -b | -m | -j | -n <wort>\0\0\0"
    var wort: u64 = 0
    var modus: u64 = 0 // 0 = Index, 1 = Baum, 2 = beide, 3 = Journal
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        let p: u64 = ulib.arg_at(args, a)
        if ulib.streq(p, (&o_b[0 as usize]) as u64) {
            modus = 1
        } else if ulib.streq(p, (&o_m[0 as usize]) as u64) {
            modus = 2
        } else if ulib.streq(p, (&o_j[0 as usize]) as u64) {
            modus = 3
        } else if ulib.streq(p, (&o_n[0 as usize]) as u64) {
            modus = 4
        } else {
            wort = p
        }
        a = a + 1
    }
    if wort == 0 {
        say((&s_hilf[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    if modus == 1 {
        suche_baum(wort)
        return 0
    }
    bauen()
    if modus == 3 || modus == 4 {
        journalprobe(modus == 3)
    }
    let ni: u64 = suche_index(wort)
    zeige(ni)
    if modus >= 2 {
        let nb: u64 = suche_baum(wort)
        vergleiche(ni, nb)
    }
    return 0
}
