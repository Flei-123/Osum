// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/elevate.fi -- ROUND SESSUID3: /bin/elevate, the consent door to root.
//
//   elevate <path> [args...]    ask "allow <programme> to change the system?"; on Allow start <path> as root
//
// The start menu and the bar run as root but start everything for the signed-in person as that person
// (ulib.spawn_user). The few programmes that change the system for everybody (see ulib.needs_root) are
// started as `elevate <path>` instead, with the root identity (ulib.spawn_priv, kernel syscall 1005 mode 1).
// Nothing runs as root before the person pressed Allow. Cancel (or closing the window) starts nothing.
// Without a session (login screen, images without sign-in) there is nobody to ask: start at once.

profile app

import ulib
import fuiscene
import msg

export { u_start }

const K_ALLOW: u64 = 1
const K_DENY: u64 = 2

static mut k_title: [u8; 14] = "elevate.title\0"
static mut k_text: [u8; 13] = "elevate.text\0"
static mut k_allow: [u8; 14] = "elevate.allow\0"
static mut k_deny: [u8; 13] = "elevate.deny\0"

// the programme path and its arguments (kept for the Allow click)
static mut target: [u8; 160] = [0 as u8; 160]
static mut t_args: [u64; 8] = [0 as u64; 8]
static mut t_argc: u64 = 0

fn say(p: u64) {
    ulib.say(p)
}

fn build() {
    let col: usize = fuiscene.root()
    let _h: usize = fuiscene.label(col, msg.get((&k_title[0 as usize]) as u64))
    let t: usize = fuiscene.label_wrap(col, msg.get((&k_text[0 as usize]) as u64), 12)
    fuiscene.set_size(t, 0, 0)
    let _p: usize = fuiscene.label(col, (&target[0 as usize]) as u64)
    let bar: usize = fuiscene.row(col)
    fuiscene.set_gap(bar, 8)
    let b1: usize = fuiscene.button_main(bar, msg.get((&k_allow[0 as usize]) as u64), K_ALLOW)
    fuiscene.set_noshrink(b1)
    fuiscene.set_size(b1, 140, 36)
    let b2: usize = fuiscene.button(bar, msg.get((&k_deny[0 as usize]) as u64), K_DENY)
    fuiscene.set_noshrink(b2)
    fuiscene.set_size(b2, 120, 36)
}

// start the target as root (ulib.spawn_priv); returns the pid or an error value
fn run_target() -> u64 {
    var s_ok: [u8; 17] = "elevate: start \0\0"
    var s_p: [u8; 8] = " pid=\0\0\0"
    var av: [u64; 8] = [0 as u64; 8]
    var i: u64 = 0
    while i < t_argc {
        av[(i) as usize] = t_args[(i) as usize]
        i = i + 1
    }
    let pid: u64 = ulib.spawn_priv(t_args[0 as usize], (&av[0 as usize]) as u64, t_argc)
    say((&s_ok[0 as usize]) as u64)
    say(t_args[0 as usize])
    say((&s_p[0 as usize]) as u64)
    ulib.sayu(pid)
    ulib.nl()
    return pid
}

fn u_gui() -> u64 {
    var s_bad: [u8; 23] = "elevate: no surface\0\0\0\0"
    var s_go: [u8; 16] = "elevate: ready\0\0"
    var s_al: [u8; 17] = "elevate: allowed\0"
    var s_dn: [u8; 17] = "elevate: denied\0\0"
    var s_nm: [u8; 8] = "elevate\0"
    let _mi: u64 = msg.init()
    if !fuiscene.open(200, 160, 460, 220, msg.get((&k_title[0 as usize]) as u64), build) {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    var first: bool = true
    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        if first {
            first = false
            fuiscene.say_rects((&s_nm[0 as usize]) as u64)
            say((&s_go[0 as usize]) as u64)
            ulib.nl()
        }
        if key == K_ALLOW {
            say((&s_al[0 as usize]) as u64)
            ulib.nl()
            let _p: u64 = run_target()
            fuiscene.quit()
        } else if key == K_DENY {
            say((&s_dn[0 as usize]) as u64)
            ulib.nl()
            fuiscene.quit()
        }
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 33] = "usage: elevate <path> [args...]\0\0"
    var s_no: [u8; 26] = "elevate: no session, run\0\0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 || argc > 9 {
        say((&s_use[0 as usize]) as u64)
        ulib.nl()
        return 2
    }
    ulib.strncpy((&target[0 as usize]) as u64, ulib.arg_at(args, 1), 150)
    var i: u64 = 1
    while i < argc {
        t_args[(i - 1) as usize] = ulib.arg_at(args, i)
        i = i + 1
    }
    t_argc = argc - 1
    // the programme sees its own path as argv[0]; the kernel gets the same path
    if ulib.session_owner() == 0 {
        say((&s_no[0 as usize]) as u64)
        ulib.nl()
        let pid: u64 = run_target()
        if ulib.bad(pid) {
            return 1
        }
        return 0
    }
    return u_gui()
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
