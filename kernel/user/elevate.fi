profile kernel

import ulib
import lineout
import consent
import libc.octets

export { u_start }

static mut target: [u8; 160] = [0 as u8; 160]
static mut base: [u8; 40] = [0 as u8; 40]
static mut args_text: [u8; 200] = [0 as u8; 200]
static mut t_args: [u64; 8] = [0 as u64; 8]
static mut t_argc: u64 = 0

static mut s_action: [u8; 15] = "system.elevate\0"
static mut s_name: [u8; 6] = "name=\0"
static mut s_path: [u8; 7] = "\npath=\0"

fn say(p: u64) {
    lineout.add_text(p)
}

fn append(dst: u64, at: u64, src: u64, max: u64) -> u64 {
    var n: u64 = at
    var i: u64 = 0
    while octets.ld8(src, i) != 0 && n + 1 < max {
        octets.st8(dst, n, octets.ld8(src, i))
        n = n + 1
        i = i + 1
    }
    octets.st8(dst, n, 0)
    return n
}

fn basename_of(path: u64) {
    var last: u64 = 0
    var i: u64 = 0
    while octets.ld8(path, i) != 0 {
        if octets.ld8(path, i) == 47 {
            last = i + 1
        }
        i = i + 1
    }
    let b: u64 = (&base[0 as usize]) as u64
    var n: u64 = 0
    while octets.ld8(path, last + n) != 0 && n < 39 {
        octets.st8(b, n, octets.ld8(path, last + n))
        n = n + 1
    }
    octets.st8(b, n, 0)
}

fn describe() {
    let a: u64 = (&args_text[0 as usize]) as u64
    var n: u64 = append(a, 0, (&s_name[0 as usize]) as u64, 200)
    n = append(a, n, (&base[0 as usize]) as u64, 200)
    n = append(a, n, (&s_path[0 as usize]) as u64, 200)
    let _e: u64 = append(a, n, (&target[0 as usize]) as u64, 200)
}

fn run_target() -> u64 {
    var s_ok: [u8; 17] = "elevate: start \0\0"
    var s_p: [u8; 8] = " pid=\0\0\0"
    var av: [u64; 8] = [0 as u64; 8]
    var i: u64 = 0
    while i < t_argc {
        av[(i) as usize] = t_args[(i) as usize]
        i = i + 1
    }
    let pid: u64 = ulib.spawn_priv(t_args[0 as usize], (&av[0 as usize]) as u64, t_argc)
    say((&s_ok[0 as usize]) as u64)
    say(t_args[0 as usize])
    say((&s_p[0 as usize]) as u64)
    lineout.add_unum(pid)
    lineout.end_line()
    return pid
}

fn ask_person() -> u64 {
    var s_go: [u8; 16] = "elevate: ready\0\0"
    var s_al: [u8; 17] = "elevate: allowed\0"
    var s_dn: [u8; 17] = "elevate: denied\0\0"
    var s_bad: [u8; 24] = "elevate: no dialog\0\0\0\0\0\0"
    describe()
    say((&s_go[0 as usize]) as u64)
    lineout.end_line()
    let answer: u64 = consent.ask((&base[0 as usize]) as u64, (&s_action[0 as usize]) as u64,
        (&args_text[0 as usize]) as u64, 0)
    if answer == consent.ANSWER_YES {
        say((&s_al[0 as usize]) as u64)
        lineout.end_line()
        let pid: u64 = run_target()
        if ulib.bad(pid) {
            return 1
        }
        return 0
    }
    if answer == consent.ANSWER_NO {
        say((&s_dn[0 as usize]) as u64)
        lineout.end_line()
        return 0
    }
    say((&s_bad[0 as usize]) as u64)
    lineout.end_line()
    return 1
}

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 33] = "usage: elevate <path> [args...]\0\0"
    var s_no: [u8; 26] = "elevate: no session, run\0\0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 || argc > 9 {
        say((&s_use[0 as usize]) as u64)
        lineout.end_line()
        return 2
    }
    ulib.strncpy((&target[0 as usize]) as u64, ulib.arg_at(args, 1), 150)
    basename_of((&target[0 as usize]) as u64)
    var i: u64 = 1
    while i < argc {
        t_args[(i - 1) as usize] = ulib.arg_at(args, i)
        i = i + 1
    }
    t_argc = argc - 1
    if ulib.session_owner() == 0 {
        say((&s_no[0 as usize]) as u64)
        lineout.end_line()
        let pid: u64 = run_target()
        if ulib.bad(pid) {
            return 1
        }
        return 0
    }
    return ask_person()
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
