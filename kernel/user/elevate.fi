profile kernel

import ulib
import lineout
import consent
import appreg
import actwire
import libc.octets

export { u_start }

static mut target: [u8; 160] = [0 as u8; 160]
static mut base: [u8; 40] = [0 as u8; 40]
static mut args_text: [u8; 260] = [0 as u8; 260]
static mut bundle: [u8; 160] = [0 as u8; 160]
static mut publisher: [u8; 40] = [0 as u8; 40]
static mut t_args: [u64; 8] = [0 as u64; 8]
static mut t_argc: u64 = 0

static mut s_action: [u8; 15] = "system.elevate\0"
static mut s_name: [u8; 6] = "name=\0"
static mut s_path: [u8; 7] = "\npath=\0"
static mut s_publisher: [u8; 12] = "\npublisher=\0"
static mut s_apps: [u8; 7] = "/apps/\0"
static mut s_osp: [u8; 5] = ".osp\0"
static mut s_info: [u8; 6] = "/INFO\0"
static mut s_author: [u8; 7] = "author\0"
static mut s_remember: [u8; 12] = "\nremember=1\0"
static mut s_allow_file: [u8; 19] = "/etc/elevate.allow\0"
static mut s_one: [u8; 2] = "1\0"
static mut s_rememberable_a: [u8; 8] = "firefox\0"
static mut s_rememberable_b: [u8; 4] = "xfx\0"
const ALLOW_VALUE_CAP: u64 = 4

fn say(p: u64) {
    lineout.add_text(p)
}

fn append(dst: u64, at: u64, src: u64, max: u64) -> u64 {
    var n: u64 = at
    var i: u64 = 0
    while octets.ld8(src, i) != 0 && n + 1 < max {
        octets.st8(dst, n, octets.ld8(src, i))
        n = n + 1
        i = i + 1
    }
    octets.st8(dst, n, 0)
    return n
}

fn basename_of(path: u64) {
    var last: u64 = 0
    var i: u64 = 0
    while octets.ld8(path, i) != 0 {
        if octets.ld8(path, i) == 47 {
            last = i + 1
        }
        i = i + 1
    }
    let b: u64 = (&base[0 as usize]) as u64
    var n: u64 = 0
    while octets.ld8(path, last + n) != 0 && n < 39 {
        octets.st8(b, n, octets.ld8(path, last + n))
        n = n + 1
    }
    octets.st8(b, n, 0)
}

fn rememberable() -> bool {
    let b: u64 = (&base[0 as usize]) as u64
    return ulib.streq(b, (&s_rememberable_a[0 as usize]) as u64) || ulib.streq(b, (&s_rememberable_b[0 as usize]) as u64)
}

fn remembered() -> bool {
    var v: [u8; 4] = [0 as u8; 4]
    if !rememberable() {
        return false
    }
    if !actwire.kvfile_get((&s_allow_file[0 as usize]) as u64, (&base[0 as usize]) as u64, (&v[0 as usize]) as u64, ALLOW_VALUE_CAP) {
        return false
    }
    return ulib.streq((&v[0 as usize]) as u64, (&s_one[0 as usize]) as u64)
}

fn remember_now() {
    if rememberable() {
        let _s: bool = actwire.kvfile_set((&s_allow_file[0 as usize]) as u64, (&base[0 as usize]) as u64, (&s_one[0 as usize]) as u64)
    }
}

fn starts_with_apps() -> bool {
    var i: u64 = 0
    while octets.ld8((&s_apps[0 as usize]) as u64, i) != 0 {
        if octets.ld8((&target[0 as usize]) as u64, i) != octets.ld8((&s_apps[0 as usize]) as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn osp_end() -> u64 {
    let t: u64 = (&target[0 as usize]) as u64
    var i: u64 = 0
    while octets.ld8(t, i) != 0 {
        if octets.ld8(t, i) == 46 && octets.ld8(t, i + 1) == 111 && octets.ld8(t, i + 2) == 115 && octets.ld8(t, i + 3) == 112 && octets.ld8(t, i + 4) == 47 {
            return i + 4
        }
        i = i + 1
    }
    return 0
}

fn locate_bundle() {
    let b: u64 = (&bundle[0 as usize]) as u64
    let end: u64 = osp_end()
    if starts_with_apps() && end > 0 && end < 150 {
        var i: u64 = 0
        while i < end {
            octets.st8(b, i, octets.ld8((&target[0 as usize]) as u64, i))
            i = i + 1
        }
        octets.st8(b, end, 0)
        return
    }
    var n: u64 = append(b, 0, (&s_apps[0 as usize]) as u64, 160)
    n = append(b, n, (&base[0 as usize]) as u64, 160)
    let _o: u64 = append(b, n, (&s_osp[0 as usize]) as u64, 160)
}

fn read_publisher() {
    var info: [u8; 176] = [0 as u8; 176]
    let ip: u64 = (&info[0 as usize]) as u64
    octets.st8((&publisher[0 as usize]) as u64, 0, 0)
    let n: u64 = append(ip, 0, (&bundle[0 as usize]) as u64, 176)
    let _i: u64 = append(ip, n, (&s_info[0 as usize]) as u64, 176)
    let _g: bool = actwire.kvfile_get(ip, (&s_author[0 as usize]) as u64, (&publisher[0 as usize]) as u64, 40)
}

fn prepare_icon() {
    var id: [u8; 24] = [0 as u8; 24]
    if appreg.id_from_path((&bundle[0 as usize]) as u64, (&id[0 as usize]) as u64) {
        consent.load_icon((&id[0 as usize]) as u64)
    }
}

fn describe() {
    let a: u64 = (&args_text[0 as usize]) as u64
    var n: u64 = append(a, 0, (&s_name[0 as usize]) as u64, 260)
    n = append(a, n, (&base[0 as usize]) as u64, 260)
    if octets.ld8((&publisher[0 as usize]) as u64, 0) != 0 {
        n = append(a, n, (&s_publisher[0 as usize]) as u64, 260)
        n = append(a, n, (&publisher[0 as usize]) as u64, 260)
    }
    if rememberable() {
        n = append(a, n, (&s_remember[0 as usize]) as u64, 260)
    }
    n = append(a, n, (&s_path[0 as usize]) as u64, 260)
    let _p: u64 = append(a, n, (&target[0 as usize]) as u64, 260)
}

fn run_target() -> u64 {
    var s_ok: [u8; 17] = "elevate: start \0\0"
    var s_p: [u8; 8] = " pid=\0\0\0"
    var av: [u64; 8] = [0 as u64; 8]
    var i: u64 = 0
    while i < t_argc {
        av[(i) as usize] = t_args[(i) as usize]
        i = i + 1
    }
    let pid: u64 = ulib.spawn_priv(t_args[0 as usize], (&av[0 as usize]) as u64, t_argc)
    say((&s_ok[0 as usize]) as u64)
    say(t_args[0 as usize])
    say((&s_p[0 as usize]) as u64)
    lineout.add_unum(pid)
    lineout.end_line()
    return pid
}

fn ask_person() -> u64 {
    var s_go: [u8; 16] = "elevate: ready\0\0"
    var s_al: [u8; 17] = "elevate: allowed\0"
    var s_dn: [u8; 17] = "elevate: denied\0\0"
    var s_bad: [u8; 24] = "elevate: no dialog\0\0\0\0\0\0"
    if remembered() {
        say((&s_al[0 as usize]) as u64)
        lineout.end_line()
        if ulib.bad(run_target()) {
            return 1
        }
        return 0
    }
    locate_bundle()
    read_publisher()
    prepare_icon()
    describe()
    say((&s_go[0 as usize]) as u64)
    lineout.end_line()
    let answer: u64 = consent.ask((&base[0 as usize]) as u64, (&s_action[0 as usize]) as u64,
        (&args_text[0 as usize]) as u64, 0)
    if answer == consent.ANSWER_YES || answer == consent.ANSWER_YES_REMEMBER {
        if answer == consent.ANSWER_YES_REMEMBER {
            remember_now()
        }
        say((&s_al[0 as usize]) as u64)
        lineout.end_line()
        let pid: u64 = run_target()
        if ulib.bad(pid) {
            return 1
        }
        return 0
    }
    if answer == consent.ANSWER_NO {
        say((&s_dn[0 as usize]) as u64)
        lineout.end_line()
        return 0
    }
    say((&s_bad[0 as usize]) as u64)
    lineout.end_line()
    return 1
}

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 33] = "usage: elevate <path> [args...]\0\0"
    var s_no: [u8; 26] = "elevate: no session, run\0\0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 || argc > 9 {
        say((&s_use[0 as usize]) as u64)
        lineout.end_line()
        return 2
    }
    ulib.strncpy((&target[0 as usize]) as u64, ulib.arg_at(args, 1), 150)
    basename_of((&target[0 as usize]) as u64)
    var i: u64 = 1
    while i < argc {
        t_args[(i - 1) as usize] = ulib.arg_at(args, i)
        i = i + 1
    }
    t_argc = argc - 1
    if ulib.session_owner() == 0 {
        say((&s_no[0 as usize]) as u64)
        lineout.end_line()
        let pid: u64 = run_target()
        if ulib.bad(pid) {
            return 1
        }
        return 0
    }
    return ask_person()
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
