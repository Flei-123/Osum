// kernel/user/firun.fi -- RUNDE K16: EINE `.fi` OEFFNEN HEISST,
// SIE ZU UEBERSETZEN UND ZU STARTEN.
//
// Das ist das Programm, das in der Tabelle `Dateiart -> womit oeffnen`
// (`kernel/ftype.fi`) fuer die Endung `.fi` eingetragen ist. Ein
// Doppelklick auf `hallo.fi` im Dateiverwalter von Runde K15 wird zu
// `SYS_OSUM_FOPEN`, und der Kern startet daraufhin genau dieses Programm
// mit dem Pfad als erstem Argument.
//
// DREI SCHRITTE, UND JEDER KANN SCHEITERN:
//
//   1. `/bin/firnc quelle.fi`  -> `quelle.s`
//   2. `/bin/fas quelle.s -o quelle`
//   3. `quelle` starten
//
// WAS DER NUTZER SIEHT, WENN ES SCHIEFGEHT -- und das ist der Punkt, an
// dem sich ein brauchbares Werkzeug von einem unbrauchbaren
// unterscheidet: die Fehlermeldung des UEBERSETZERS, wortwoertlich.
// `firnc` schreibt sie auf Deskriptor 2, dieses Programm faengt sie NICHT
// ab und leitet sie NICHT um -- Deskriptor 2 des Kindes ist Deskriptor 2
// dieses Programms, und der gehoert dem, der geklickt hat. Umgelenkt wird
// nur Deskriptor 1, und zwar in die `.s`-Datei, denn dort schreibt
// `firnc` seine Ausgabe hin, wenn man ihm kein `-o` gibt.
//
// Und der Rueckgabewert sagt die Wahrheit:
//
//     0    das Programm ist gelaufen und war selbst zufrieden
//     >0   der Wert, den das uebersetzte Programm zurueckgegeben hat
//     70   der Uebersetzer hat abgelehnt (`firun: ...` dazu)
//     71   der Assembler hat abgelehnt
//     72   das fertige Programm liess sich nicht starten
//
// Ein Doppelklick auf eine `.fi`, die NICHT uebersetzt, endet also mit 70
// und einer lesbaren Meldung -- und nicht mit einem stillen Nichts.
// `tools/k16/run.sh` misst genau diesen Fall.

profile kernel

import ulib

export { u_start }

const E_UEBERSETZER: u64 = 70
const E_ASSEMBLER: u64 = 71
const E_START: u64 = 72

// Ein Kind starten und auf es warten. `argv` ist ein Feld von Zeigern.
fn lauf(pfad: u64, argv: u64, argc: u64) -> u64 {
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, pfad, argv, argc)
    if ulib.bad(pid) {
        return 0 -% 1
    }
    return ulib.wait_code(pid)
}

fn meldung(a: u64, b: u64) {
    ulib.eput(a)
    if b != 0 {
        ulib.eput(b)
    }
    var nl: [u8; 2] = "\n\0"
    ulib.eput((&nl[0]) as u64)
}

// WAS DER UEBERSETZER SAGT, WENN ER NEIN SAGT -- UND WAS ER NICHT SAGT.
//
// Gemessen am 26.08.2026, und es ist eine echte Grenze dieses Systems:
// `firnc1` -- der in Firn geschriebene Uebersetzer, der auf Osum laeuft
// -- schreibt bei einem Fehler NICHTS. Nicht auf Deskriptor 1, nicht auf
// Deskriptor 2. Er gibt einen Code zurueck, und das ist alles.
// (`firnc0`, der in Rust geschriebene, schreibt eine vollstaendige
// Meldung mit Zeile, Spalte und unterstrichenem Wort -- aber der laeuft
// hier nicht.)
//
// Ein Doppelklick, nach dem nichts passiert und nichts dasteht, ist
// genau das, was diese Runde vermeiden soll. Also wird der Code
// UEBERSETZT: die Liste steht im Kopf von `bin/firnc1.fi` im Firn-Repo,
// und sie steht hier ein zweites Mal, damit ein Mensch etwas zu lesen
// hat. Das sagt nicht, WO der Fehler ist -- es sagt, WELCHER ART er ist,
// und das ist mehr als nichts und weniger als genug. So steht es auch in
// docs/ROUNDK16.md.
fn sag_grund(rc: u64) {
    var k: [u8; 39] = "firun: der Uebersetzer lehnt ab, Code \0"
    ulib.eput((&k[0]) as u64)
    ulib.eput(zahl(rc))
    var t: [u8; 5] = " -- \0"
    ulib.eput((&t[0]) as u64)
    var e1: [u8; 30] = "im Quelltext steht ein Fehler\0"
    var e2: [u8; 34] = "eine Datei liess sich nicht lesen\0"
    var e3: [u8; 43] = "das ist nicht die Kernsprache dieser Stufe\0"
    var e4: [u8; 25] = "hier braucht es comptime\0"
    var e5: [u8; 22] = "hier braucht es defer\0"
    var e6: [u8; 53] = "der Codeerzeuger kann dieses FIR nicht (Gleitkomma?)\0"
    var e9: [u8; 33] = "ein Grund, den firun nicht kennt\0"
    if rc == 1 {
        ulib.eput((&e1[0]) as u64)
    } else {
        if rc == 2 {
            ulib.eput((&e2[0]) as u64)
        } else {
            if rc == 3 {
                ulib.eput((&e3[0]) as u64)
            } else {
                if rc == 4 {
                    ulib.eput((&e4[0]) as u64)
                } else {
                    if rc == 5 {
                        ulib.eput((&e5[0]) as u64)
                    } else {
                        if rc == 6 {
                            ulib.eput((&e6[0]) as u64)
                        } else {
                            ulib.eput((&e9[0]) as u64)
                        }
                    }
                }
            }
        }
    }
    var nl: [u8; 2] = "\n\0"
    ulib.eput((&nl[0]) as u64)
}

static mut zbuf: [u8; 24] = [0 as u8; 24]

fn zahl(v: u64) -> u64 {
    var i: u64 = 23
    zbuf[23] = 0 as u8
    if v == 0 {
        i = 22
        zbuf[22] = 48 as u8
    }
    var x: u64 = v
    while x > 0 {
        i = i - 1
        zbuf[i as usize] = (48 + x % 10) as u8
        x = x / 10
    }
    return (&zbuf[0]) as u64 + i
}

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        var u: [u8; 32] = "Aufruf: firun quelle.fi [args]\n\0"
        ulib.eput((&u[0]) as u64)
        return 2
    }
    let quelle: u64 = ulib.arg_at(args, 1)

    // Aus `x.fi` werden `x.s` und `x`. Endet der Name nicht auf `.fi`,
    // wird einfach angehaengt -- das ist ehrlicher, als zu raten.
    var s_pfad: [u8; 128] = [0 as u8; 128]
    var p_pfad: [u8; 128] = [0 as u8; 128]
    let n: u64 = ulib.length(quelle)
    if n + 4 >= 128 {
        var t: [u8; 29] = "firun: der Pfad ist zu lang\n\0"
        ulib.eput((&t[0]) as u64)
        return 2
    }
    // Endung abschneiden, wenn sie `.fi` ist.
    var stamm: u64 = n
    if n > 3 {
        var c0: u64 = 0
        var c1: u64 = 0
        var c2: u64 = 0
        c0 = byte_at(quelle, n - 3)
        c1 = byte_at(quelle, n - 2)
        c2 = byte_at(quelle, n - 1)
        if c0 == 46 && c1 == 102 && c2 == 105 {
            stamm = n - 3
        }
    }
    ulib.copy((&p_pfad[0]) as u64, quelle, stamm)
    p_pfad[stamm as usize] = 0 as u8
    ulib.copy((&s_pfad[0]) as u64, quelle, stamm)
    s_pfad[stamm as usize] = 46 as u8
    s_pfad[(stamm + 1) as usize] = 115 as u8
    s_pfad[(stamm + 2) as usize] = 0 as u8

    // ---- 1. uebersetzen. Deskriptor 1 zeigt dabei in die `.s`.
    var n_firnc: [u8; 11] = "/bin/firnc\0"
    var argv1: [u64; 4] = [0; 4]
    argv1[0] = (&n_firnc[0]) as u64
    argv1[1] = quelle
    let aus: u64 = ulib.sys(ulib.SYS_OPEN, (&s_pfad[0]) as u64,
        ulib.O_MAKE, 0)
    if ulib.bad(aus) {
        var t2: [u8; 41] = "firun: die Zwischendatei geht nicht auf\n\0"
        ulib.eput((&t2[0]) as u64)
        return E_UEBERSETZER
    }
    let alt: u64 = ulib.sys(ulib.SYS_DUP, ulib.OUT, 0, 0)
    ulib.sys(ulib.SYS_DUP2, aus, ulib.OUT, 0)
    let rc1: u64 = lauf((&n_firnc[0]) as u64, (&argv1[0]) as u64, 2)
    ulib.sys(ulib.SYS_DUP2, alt, ulib.OUT, 0)
    ulib.sys(ulib.SYS_CLOSE, alt, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, aus, 0, 0)
    if rc1 != 0 {
        sag_grund(rc1)
        return E_UEBERSETZER
    }

    // ---- 2. binden
    var n_fas: [u8; 9] = "/bin/fas\0"
    var n_o: [u8; 3] = "-o\0"
    var argv2: [u64; 6] = [0; 6]
    argv2[0] = (&n_fas[0]) as u64
    argv2[1] = (&s_pfad[0]) as u64
    argv2[2] = (&n_o[0]) as u64
    argv2[3] = (&p_pfad[0]) as u64
    let rc2: u64 = lauf((&n_fas[0]) as u64, (&argv2[0]) as u64, 4)
    if rc2 != 0 {
        var t4: [u8; 31] = "firun: der Assembler sagt nein\0"
        meldung((&t4[0]) as u64, 0)
        return E_ASSEMBLER
    }

    // ---- 3. starten, mit den uebrigen Argumenten
    var argv3: [u64; 8] = [0; 8]
    argv3[0] = (&p_pfad[0]) as u64
    var k: u64 = 2
    var m: u64 = 1
    while k < argc && m < 7 {
        argv3[m as usize] = ulib.arg_at(args, k)
        m = m + 1
        k = k + 1
    }
    let rc3: u64 = lauf((&p_pfad[0]) as u64, (&argv3[0]) as u64, m)
    if rc3 == (0 -% 1) {
        var t5: [u8; 38] = "firun: das Programm liess sich nicht \0"
        var t6: [u8; 9] = "starten\n\0"
        ulib.eput((&t5[0]) as u64)
        ulib.eput((&t6[0]) as u64)
        return E_START
    }
    return rc3
}

fn byte_at(p: u64, i: u64) -> u64 {
    return __mmio_read8((p + i) as *mut u8) as u64
}
