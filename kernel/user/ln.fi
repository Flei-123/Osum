// kernel/user/ln.fi -- Runde OFS3: ein Name, der auf einen anderen zeigt.
//
//     ln -s ZIEL NAME     einen symbolischen Verweis anlegen
//     ln ZIEL NAME        dasselbe -- siehe unten, warum
//
// ZWEI ARTEN VON VERWEIS GIBT ES IN UNIX, und dieses System hat bis jetzt
// nur die eine gehabt, ohne ein Programm dafuer:
//
//   DER HARTE VERWEIS ist ein ZWEITER EINTRAG mit DERSELBEN Inodenummer.
//   OFS kann das seit Runde 62, und `tools/osum/mkfs.py` legt so
//   `/bin/files` neben `/bin/explorer`. Was fehlt, ist ein SYSTEMAUFRUF
//   dafuer -- `link(2)` gibt es in diesem Kernel nicht, und deshalb kann
//   dieses Programm ihn auch nicht rufen. Es gibt dann `ln: -s fehlt`
//   aus, statt heimlich etwas anderes zu tun.
//
//   DER SYMBOLISCHE VERWEIS ist eine eigene Inode der Art `T_LINK`, deren
//   INHALT ein Pfad ist. Den gibt es seit dieser Runde, und `ln -s` ist
//   das Programm dazu.
//
// WARUM `ln ZIEL NAME` OHNE `-s` TROTZDEM EINEN SYMBOLISCHEN MACHT:
// weil es die einzige Art Verweis ist, die dieses System von Ring 3 aus
// anlegen kann, und weil ein `ln`, das ohne Schalter gar nichts tut, in
// jedem Skript stolpert. Es SAGT es aber -- auf die Fehlerausgabe, damit
// niemand glaubt, er haette einen harten bekommen.

profile kernel

import ulib
import libc.io
import libc.errno

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 34] = "ln: needs a target and a name\0\0\0\0\0"
    var s_err: [u8; 26] = "ln: cannot make the link \0"
    var s_hint: [u8; 46] = "ln: no hard links here, making a soft one\0\0\0\0\0"
    var o_s: [u8; 3] = "-s\0"

    let argc: u64 = ulib.arg_count(args)
    var soft: bool = false
    var ziel: u64 = 0
    var name: u64 = 0
    var i: u64 = 1
    while i < argc {
        let a: u64 = ulib.arg_at(args, i)
        if ulib.streq(a, (&o_s[0 as usize]) as u64) {
            soft = true
        } else if ziel == 0 {
            ziel = a
        } else if name == 0 {
            name = a
        }
        i = i + 1
    }
    if ziel == 0 || name == 0 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    if !soft {
        ulib.esay_line((&s_hint[0 as usize]) as u64, name)
    }
    if errno.failed(io.symlink(ziel, name)) {
        ulib.esay_line((&s_err[0 as usize]) as u64, name)
        return 1
    }
    return 0
}
