
profile kernel

import ulib
import libc.io
import utf8

export {
    init, set_lang, save_lang, lang, get, changed,
    keys_total, translated, unknown, truncated, user_path,
    read_lang, lang_source, sys_path, use_uid,
    LANG_MAX, SLOTS, VALW, KEYW
}

const SLOTS: u64 = 2048
const KEYW: u64 = 48
const VALW: u64 = 192
const LANG_MAX: u64 = 8
const FILE_MAX: u64 = 114688

static mut kbuf: [u8; 98304] = [0 as u8; 98304]
static mut vbuf: [u8; 393216] = [0 as u8; 393216]
static mut khash: [u64; 2048] = [0 as u64; 2048]
static mut nkeys: u64 = 0

static mut fbuf: [u8; 114688] = [0 as u8; 114688]
static mut cur: [u8; 8] = [0 as u8; 8]
static mut n_trans: u64 = 0
static mut n_unknown: u64 = 0
static mut n_trunc: u64 = 0
static mut ready: bool = false
static mut init_tried: bool = false
static mut src: u64 = 0

fn kat(i: u64) -> u64 {
    return (&kbuf[0 as usize]) as u64 +% i *% KEYW
}

fn vat(i: u64) -> u64 {
    return (&vbuf[0 as usize]) as u64 +% i *% VALW
}

fn rd(p: u64, i: u64) -> u64 {
    return (__mmio_read8((p +% i) as *mut u8)) as u64
}

fn wr(p: u64, i: u64, v: u64) {
    __mmio_write8((p +% i) as *mut u8, v as u8)
}

fn slen(p: u64) -> u64 {
    var n: u64 = 0
    while rd(p, n) != 0 {
        n = n + 1
    }
    return n
}

fn hash_of(p: u64, n: u64) -> u64 {
    var h: u64 = 14695981039346656037
    var i: u64 = 0
    while i < n {
        h = (h ^ rd(p, i)) *% 1099511628211
        i = i + 1
    }
    return h
}

fn same(a: u64, b: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if rd(a, i) != rd(b, i) {
            return false
        }
        i = i + 1
    }
    return rd(b, n) == 0
}

fn find(key: u64, n: u64) -> u64 {
    let h: u64 = hash_of(key, n)
    var i: u64 = 0
    while i < nkeys {
        if khash[(i) as usize] == h {
            if same(key, kat(i), n) {
                return i
            }
        }
        i = i + 1
    }
    return SLOTS
}

fn get(key: u64) -> u64 {
    if !ready && !init_tried {
        init_tried = true
        let _n: u64 = init()
    }
    let i: u64 = find(key, slen(key))
    if i >= SLOTS {
        return key
    }
    return vat(i)
}

fn keys_total() -> u64 {
    return nkeys
}

fn translated() -> u64 {
    return n_trans
}

fn unknown() -> u64 {
    return n_unknown
}

fn truncated() -> u64 {
    return n_trunc
}

fn lang() -> u64 {
    return (&cur[0 as usize]) as u64
}

fn slurp(path: u64) -> u64 {
    let fd: u64 = io.open(path, 0)
    if ulib.bad(fd) {
        return 0
    }
    var n: u64 = 0
    while n < FILE_MAX {
        let got: u64 = io.read(fd, (&fbuf[0 as usize]) as u64 +% n,
            FILE_MAX - n)
        if ulib.bad(got) || got == 0 {
            io.close(fd)
            return n
        }
        n = n + got
    }
    io.close(fd)
    return n
}

fn cat_path(code: u64, out: u64) {
    var a: [u8; 20] = "/usr/share/locale/\0\0"
    var b: [u8; 12] = "/messages\0\0\0"
    var at: u64 = 0
    var i: u64 = 0
    while rd((&a[0 as usize]) as u64, i) != 0 {
        wr(out, at, rd((&a[0 as usize]) as u64, i))
        at = at + 1
        i = i + 1
    }
    i = 0
    while rd(code, i) != 0 && i < LANG_MAX {
        wr(out, at, rd(code, i))
        at = at + 1
        i = i + 1
    }
    i = 0
    while rd((&b[0 as usize]) as u64, i) != 0 {
        wr(out, at, rd((&b[0 as usize]) as u64, i))
        at = at + 1
        i = i + 1
    }
    wr(out, at, 0)
}

fn put_value(slot: u64, von: u64, bis: u64) {
    let z: u64 = vat(slot)
    var at: u64 = 0
    var i: u64 = von
    while i < bis && at + 1 < VALW {
        var c: u64 = rd((&fbuf[0 as usize]) as u64, i)
        if c == 92 && i + 1 < bis {
            let d: u64 = rd((&fbuf[0 as usize]) as u64, i + 1)
            if d == 110 {
                c = 10
                i = i + 1
            } else if d == 116 {
                c = 9
                i = i + 1
            } else if d == 92 {
                c = 92
                i = i + 1
            }
        }
        wr(z, at, c)
        at = at + 1
        i = i + 1
    }
    if i < bis {
        n_trunc = n_trunc + 1
        while at > 0 && (rd(z, at - 1) & 0xC0) == 0x80 {
            at = at - 1
        }
        if at > 0 {
            at = at - 1
        }
    }
    wr(z, at, 0)
}

fn parse(n: u64, define: bool) -> u64 {
    let b: u64 = (&fbuf[0 as usize]) as u64
    var gesetzt: u64 = 0
    var i: u64 = 0
    while i < n {
        var e: u64 = i
        while e < n && rd(b, e) != 10 {
            e = e + 1
        }
        if e > i && rd(b, i) != 35 {
            var g: u64 = i
            while g < e && rd(b, g) != 61 {
                g = g + 1
            }
            if g < e {
                var ka: u64 = i
                var kz: u64 = g
                while ka < kz && rd(b, ka) == 32 {
                    ka = ka + 1
                }
                while kz > ka && rd(b, kz - 1) == 32 {
                    kz = kz - 1
                }
                var va: u64 = g + 1
                if va < e && rd(b, va) == 32 {
                    va = va + 1
                }
                if kz > ka && kz - ka < KEYW {
                    let slot: u64 = find(b + ka, kz - ka)
                    if slot < SLOTS {
                        put_value(slot, va, e)
                        gesetzt = gesetzt + 1
                    } else if define {
                        if nkeys < SLOTS {
                            let new: u64 = nkeys
                            var k: u64 = 0
                            while k < kz - ka {
                                wr(kat(new), k, rd(b, ka + k))
                                k = k + 1
                            }
                            wr(kat(new), kz - ka, 0)
                            khash[(new) as usize] = hash_of(b + ka, kz - ka)
                            nkeys = nkeys + 1
                            put_value(new, va, e)
                            gesetzt = gesetzt + 1
                        }
                    } else {
                        n_unknown = n_unknown + 1
                    }
                }
            }
        }
        i = e + 1
    }
    return gesetzt
}

static mut uid_for: u64 = 0

fn use_uid(u: u64) {
    uid_for = u
}

fn user_path(out: u64) -> bool {
    var a: [u8; 8] = "/users/\0"
    var b: [u8; 16] = "/config/locale\0\0"
    var name: [u8; 40] = [0 as u8; 40]
    var wer: u64 = uid_for
    if wer == 0 {
        wer = ulib.sys(102, 0, 0, 0)
    }
    if !name_of_uid(wer, (&name[0 as usize]) as u64, 40) {
        return false
    }
    var at: u64 = 0
    var i: u64 = 0
    while rd((&a[0 as usize]) as u64, i) != 0 {
        wr(out, at, rd((&a[0 as usize]) as u64, i))
        at = at + 1
        i = i + 1
    }
    i = 0
    while rd((&name[0 as usize]) as u64, i) != 0 {
        wr(out, at, rd((&name[0 as usize]) as u64, i))
        at = at + 1
        i = i + 1
    }
    i = 0
    while rd((&b[0 as usize]) as u64, i) != 0 {
        wr(out, at, rd((&b[0 as usize]) as u64, i))
        at = at + 1
        i = i + 1
    }
    wr(out, at, 0)
    return true
}

fn name_of_uid(uid: u64, out: u64, max: u64) -> bool {
    var path: [u8; 12] = "/etc/passwd\0"
    var line: [u8; 128] = [0 as u8; 128]
    let fd: u64 = io.open((&path[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return false
    }
    var buf: [u8; 1024] = [0 as u8; 1024]
    let n: u64 = io.read(fd, (&buf[0 as usize]) as u64, 1023)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return false
    }
    let b: u64 = (&buf[0 as usize]) as u64
    var i: u64 = 0
    while i < n {
        var e: u64 = i
        while e < n && rd(b, e) != 10 {
            e = e + 1
        }
        var k: u64 = i
        var an: u64 = 0
        while k < e && rd(b, k) != 58 && an + 1 < max {
            wr((&line[0 as usize]) as u64, an, rd(b, k))
            an = an + 1
            k = k + 1
        }
        wr((&line[0 as usize]) as u64, an, 0)
        var felder: u64 = 0
        var q: u64 = i
        while q < e && felder < 2 {
            if rd(b, q) == 58 {
                felder = felder + 1
            }
            q = q + 1
        }
        var v: u64 = 0
        var digits: u64 = 0
        while q < e && rd(b, q) >= 48 && rd(b, q) <= 57 {
            v = v * 10 + (rd(b, q) - 48)
            digits = digits + 1
            q = q + 1
        }
        if digits > 0 && v == uid && an > 0 {
            var z: u64 = 0
            while z <= an {
                wr(out, z, rd((&line[0 as usize]) as u64, z))
                z = z + 1
            }
            return true
        }
        i = e + 1
    }
    return false
}

fn read_user_lang(out: u64) -> bool {
    var path: [u8; 96] = [0 as u8; 96]
    if !user_path((&path[0 as usize]) as u64) {
        return false
    }
    let fd: u64 = io.open((&path[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return false
    }
    var roh: [u8; 16] = [0 as u8; 16]
    let n: u64 = io.read(fd, (&roh[0 as usize]) as u64, 15)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return false
    }
    var at: u64 = 0
    while at < n && at + 1 < LANG_MAX {
        let c: u64 = rd((&roh[0 as usize]) as u64, at)
        if c < 97 || c > 122 {
            wr(out, at, 0)
            return at > 0
        }
        wr(out, at, c)
        at = at + 1
    }
    wr(out, at, 0)
    return at > 0
}

fn sys_path(out: u64) -> bool {
    var a: [u8; 20] = "/etc/locale.conf\0\0\0\0"
    var i: u64 = 0
    while rd((&a[0 as usize]) as u64, i) != 0 {
        wr(out, i, rd((&a[0 as usize]) as u64, i))
        i = i + 1
    }
    wr(out, i, 0)
    return true
}

fn read_sys_lang(out: u64) -> bool {
    var path: [u8; 24] = [0 as u8; 24]
    let _p: bool = sys_path((&path[0 as usize]) as u64)
    let fd: u64 = io.open((&path[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return false
    }
    var roh: [u8; 256] = [0 as u8; 256]
    let n: u64 = io.read(fd, (&roh[0 as usize]) as u64, 255)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return false
    }
    let b: u64 = (&roh[0 as usize]) as u64
    var i: u64 = 0
    while i < n {
        var e: u64 = i
        while e < n && rd(b, e) != 10 {
            e = e + 1
        }
        var t: u64 = i
        while t < e && (rd(b, t) == 32 || rd(b, t) == 9) {
            t = t + 1
        }
        if t < e && rd(b, t) != 35 {
            if rd(b, t) == 108 && rd(b, t + 1) == 97
               && rd(b, t + 2) == 110 && rd(b, t + 3) == 103 {
                var q: u64 = t + 4
                while q < e && (rd(b, q) == 32 || rd(b, q) == 9) {
                    q = q + 1
                }
                if q < e && rd(b, q) == 61 {
                    q = q + 1
                    while q < e && (rd(b, q) == 32 || rd(b, q) == 9) {
                        q = q + 1
                    }
                    var at: u64 = 0
                    var lauf: bool = true
                    while lauf && q < e && at + 1 < LANG_MAX {
                        let c: u64 = rd(b, q)
                        if c < 97 || c > 122 {
                            lauf = false
                        } else {
                            wr(out, at, c)
                            at = at + 1
                            q = q + 1
                        }
                    }
                    wr(out, at, 0)
                    return at > 0
                }
            }
        }
        i = e + 1
    }
    return false
}

fn read_lang(out: u64) -> u64 {
    if read_user_lang(out) {
        return 1
    }
    if read_sys_lang(out) {
        return 2
    }
    wr(out, 0, 101)
    wr(out, 1, 110)
    wr(out, 2, 0)
    return 0
}

fn lang_source() -> u64 {
    return src
}

fn save_lang(code: u64) -> bool {
    var path: [u8; 96] = [0 as u8; 96]
    if !user_path((&path[0 as usize]) as u64) {
        return false
    }
    let p: u64 = (&path[0 as usize]) as u64
    make_upto(p, 3)
    make_upto(p, 2)
    make_upto(p, 1)
    let fd: u64 = io.open(p, ulib.O_MAKE)
    if ulib.bad(fd) {
        return false
    }
    var line: [u8; 16] = [0 as u8; 16]
    var n: u64 = 0
    while rd(code, n) != 0 && n + 1 < LANG_MAX {
        wr((&line[0 as usize]) as u64, n, rd(code, n))
        n = n + 1
    }
    wr((&line[0 as usize]) as u64, n, 10)
    n = n + 1
    let w: u64 = io.write(fd, (&line[0 as usize]) as u64, n)
    io.close(fd)
    return !ulib.bad(w)
}

fn make_upto(p: u64, tiefe: u64) {
    let n: u64 = slen(p)
    var i: u64 = n
    var seen: u64 = 0
    while i > 0 {
        i = i - 1
        if rd(p, i) == 47 {
            seen = seen + 1
            if seen == tiefe {
                let alt: u64 = rd(p, i)
                wr(p, i, 0)
                io.make_dir(p)
                wr(p, i, alt)
                return
            }
        }
    }
}

fn set_lang(code: u64) -> bool {
    if !ready {
        return false
    }
    n_trans = 0
    n_unknown = 0
    var en: [u8; 4] = "en\0\0"
    var path: [u8; 64] = [0 as u8; 64]
    cat_path((&en[0 as usize]) as u64, (&path[0 as usize]) as u64)
    let ne: u64 = slurp((&path[0 as usize]) as u64)
    if ne > 0 {
        parse(ne, false)
    }
    var i: u64 = 0
    while i + 1 < LANG_MAX {
        wr((&cur[0 as usize]) as u64, i, rd(code, i))
        if rd(code, i) == 0 {
            i = LANG_MAX
        } else {
            i = i + 1
        }
    }
    wr((&cur[0 as usize]) as u64, LANG_MAX - 1, 0)
    if rd(code, 0) == 101 && rd(code, 1) == 110 && rd(code, 2) == 0 {
        return true
    }
    cat_path(code, (&path[0 as usize]) as u64)
    let n: u64 = slurp((&path[0 as usize]) as u64)
    if n == 0 {
        return false
    }
    n_trans = parse(n, false)
    return true
}

fn init() -> u64 {
    nkeys = 0
    n_trans = 0
    n_unknown = 0
    n_trunc = 0
    var en: [u8; 4] = "en\0\0"
    var path: [u8; 64] = [0 as u8; 64]
    cat_path((&en[0 as usize]) as u64, (&path[0 as usize]) as u64)
    let n: u64 = slurp((&path[0 as usize]) as u64)
    if n == 0 {
        return 0
    }
    parse(n, true)
    ready = true
    wr((&cur[0 as usize]) as u64, 0, 101)
    wr((&cur[0 as usize]) as u64, 1, 110)
    wr((&cur[0 as usize]) as u64, 2, 0)
    var gewaehlt: [u8; 8] = [0 as u8; 8]
    src = read_lang((&gewaehlt[0 as usize]) as u64)
    if src != 0 {
        if !set_lang((&gewaehlt[0 as usize]) as u64) {
            src = 0
        }
    }
    return nkeys
}

fn changed() -> bool {
    if !ready {
        return false
    }
    var new: [u8; 8] = [0 as u8; 8]
    let q: u64 = read_lang((&new[0 as usize]) as u64)
    if same((&new[0 as usize]) as u64, (&cur[0 as usize]) as u64,
        slen((&new[0 as usize]) as u64)) {
        src = q
        return false
    }
    if !set_lang((&new[0 as usize]) as u64) {
        return false
    }
    src = q
    return true
}
