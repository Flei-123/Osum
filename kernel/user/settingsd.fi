// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/settingsd.fi -- AB-005: THE SYSTEM SETTINGS ON THE ACTION BUS
// (docs/ACTION-BUS.md section 6).
//
// A provider like any other app: it registers `a.settings` (A_ROOT, so
// the kernel lets only the broker through), says `hello settings`, and
// answers the actions its manifest (/etc/actions.d/settings.actions)
// declares:
//
//   settings.list [area]        every setting: value, type, range, risk, text
//   settings.get key            one value
//   settings.set key value      change it -- the broker has ALREADY checked
//                               type and range against the schema and the
//                               rights by the KEY (settings.<key>), so a
//                               grant can be per area, and a critical key
//                               always needed a human yes
//   settings.history            the last changes: number, who, old, new
//   settings.revert key change  put back what change <n> replaced
//
// Every change is journalled BEFORE it is made (/var/log/settings.journal:
// number, time, client, key, old, new); no journal line, no change. Undo
// works twice over: the bus undo (`act undo`: the manifest says
// `undo settings.set`, this provider hands back key + old value) and
// `settings.revert` for any change still in the history.
//
// Where a value lives: /etc/settings.db (key=value), or -- for a key with
// `store <file> <field>` in the schema -- the configuration file the
// program that uses it already reads. The settings window, a script and
// Jarvis all change the same thing through the same door.
//
//   settingsd serve [ticks]

profile kernel

import ulib
import libc.io
import actwire
import setschema
import msg

export { u_start }

static mut svc_bus: u64 = 0xFFFFFFFF
static mut evt_no: u64 = 1
static mut P_SCHEMA: [u8; 21] = "/etc/settings.schema\0"
static mut P_DB: [u8; 17] = "/etc/settings.db\0"
static mut P_JOURNAL: [u8; 26] = "/var/log/settings.journal\0"

const CH_MAX: u64 = 32
const CH_B: u64 = 192
const CH_NO: u64 = 0
const CH_KEY: u64 = 8 // 32 octets
const CH_OLD: u64 = 40 // 64
const CH_NEW: u64 = 104 // 64
const CH_CLIENT: u64 = 168 // 24
static mut changes: [u8; 6144] = [0 as u8; 6144]
static mut ch_next: u64 = 1

static mut lastmsg: u64 = 0

fn ch(i: u64) -> u64 {
    return (&changes[0 as usize]) as u64 + i * CH_B
}

fn ld8(p: u64, i: u64) -> u64 {
    return actwire.ld8(p, i)
}

fn st8(p: u64, i: u64, v: u64) {
    actwire.st8(p, i, v)
}

fn say(p: u64) {
    actwire.out(p)
}

fn nl() {
    var s: [u8; 2] = "\n\0"
    say((&s[0 as usize]) as u64)
}

fn copyz(dst: u64, src: u64, max: u64) {
    var i: u64 = 0
    while i + 1 < max && ld8(src, i) != 0 {
        st8(dst, i, ld8(src, i))
        i = i + 1
    }
    st8(dst, i, 0)
}

// ------------------------------------------------ values

// ROUND ACTION-BUS-3: display.brightness LIVES IN THE KERNEL. The screen
// tab has always set it with SYS_DISPSET (1811, field 3); the kernel's
// scale is 40..200 with 100 = unchanged, the schema's is 0..100 percent,
// so 50 % is the picture as it comes and every step is two kernel
// points (never below the kernel's 40). With no display (a test guest
// without a screen) the value stays in /etc/settings.db as before.
static mut K_BRIGHT: [u8; 19] = "display.brightness\0"

// ROUND ACTION-BUS-4 (AB-005c): three more keys have their real home
// outside /etc/settings.db, and the bus now reads and writes THERE, so a
// value read over the bus is the value that is in effect:
//   sound.volume, sound.mute  the sound card (SYS_AUDGET 1850 / AUDSET
//                             1851: field 4 volume, 21 muted / 0 volume,
//                             2 mute) -- the same calls the taskbar and
//                             /bin/play make. Without a sound card they
//                             stay in the database as before.
//   locale.language           the CHOICE of the person whose session it
//                             is: /users/<name>/config/locale, the file
//                             msg.fi reads first (a language belongs to
//                             the user, not to the machine). Written as
//                             that person, i.e. handed back with chown.
//                             No session (a server, a test guest): the
//                             database.
static mut K_VOL: [u8; 13] = "sound.volume\0"
static mut K_MUTE: [u8; 11] = "sound.mute\0"
static mut K_LANG: [u8; 16] = "locale.language\0"

// net.dhcp is `modus=dhcp|fest` in /etc/network.conf, the file /bin/dhcp
// and the page Netz share. true writes modus=dhcp and starts /bin/dhcp
// (what the page did itself before); false is only possible where a
// fixed address is already written (ip=...) -- the bus has no key for the
// address, so switching to "fixed" without one would leave the device
// without any, and that is refused instead.
static mut K_DHCP: [u8; 9] = "net.dhcp\0"
static mut P_NET: [u8; 18] = "/etc/network.conf\0"
static mut F_MODUS: [u8; 6] = "modus\0"

fn dhcp_get(out: u64) -> bool {
    var m: [u8; 16] = [0 as u8; 16]
    if !actwire.kvfile_get((&P_NET[0 as usize]) as u64, (&F_MODUS[0 as usize]) as u64, (&m[0 as usize]) as u64, 16) {
        return false
    }
    var t: [u8; 6] = "true\0\0"
    var f: [u8; 6] = "false\0"
    if ld8((&m[0 as usize]) as u64, 0) == 100 { // "dhcp"
        copyz(out, (&t[0 as usize]) as u64, 64)
    } else {
        copyz(out, (&f[0 as usize]) as u64, 64)
    }
    return true
}

fn dhcp_put(v: u64) -> bool {
    if is_true(v) {
        var w: [u8; 5] = "dhcp\0"
        if !actwire.kvfile_set((&P_NET[0 as usize]) as u64, (&F_MODUS[0 as usize]) as u64, (&w[0 as usize]) as u64) {
            return false
        }
        var bin: [u8; 10] = "/bin/dhcp\0"
        let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&bin[0 as usize]) as u64, 0, 0)
        var s1: [u8; 29] = "settingsd: dhcp started pid=\0"
        say((&s1[0 as usize]) as u64)
        actwire.outnum(pid)
        nl()
        return true
    }
    var ip: [u8; 24] = [0 as u8; 24]
    var f_ip: [u8; 3] = "ip\0"
    if !actwire.kvfile_get((&P_NET[0 as usize]) as u64, (&f_ip[0 as usize]) as u64, (&ip[0 as usize]) as u64, 24) {
        var s2: [u8; 44] = "settingsd: net.dhcp=false refused, no ip=\n\0\0"
        say((&s2[0 as usize]) as u64)
        return false
    }
    var fe: [u8; 5] = "fest\0"
    return actwire.kvfile_set((&P_NET[0 as usize]) as u64, (&F_MODUS[0 as usize]) as u64, (&fe[0 as usize]) as u64)
}

fn is_key(i: u64, k: u64) -> bool {
    return actwire.str_eq(setschema.key(i), k)
}

fn audio_ready() -> bool {
    return ulib.sys(1850, 0, 0, 0) == 1
}

fn put_num(out: u64, v: u64) {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = ulib.digits(v, (&z[0 as usize]) as u64)
    z[(n) as usize] = 0 as u8
    copyz(out, (&z[0 as usize]) as u64, 64)
}

fn is_true(v: u64) -> bool {
    return ld8(v, 0) == 116 || ld8(v, 0) == 49 // "true" / "1"
}

// the session's uid, or 0 when nobody is signed in (or root is)
fn lang_uid() -> u64 {
    let u: u64 = actwire.session_uid()
    if u == 0 || u >= 0xFFFFFFFF {
        return 0
    }
    return u
}

fn lang_get(out: u64) -> bool {
    let u: u64 = lang_uid()
    if u == 0 {
        return false
    }
    msg.use_uid(u)
    var c: [u8; 16] = [0 as u8; 16]
    let src: u64 = msg.read_lang((&c[0 as usize]) as u64)
    msg.use_uid(0)
    if src == 0 {
        return false
    }
    copyz(out, (&c[0 as usize]) as u64, 64)
    return true
}

fn lang_put(v: u64) -> bool {
    let u: u64 = lang_uid()
    msg.use_uid(u)
    let ok: bool = msg.save_lang(v)
    var pfad: [u8; 96] = [0 as u8; 96]
    let hat: bool = msg.user_path((&pfad[0 as usize]) as u64)
    msg.use_uid(0)
    if ok && hat {
        // the image gives every account uid = gid (tools/usbimg/build.sh)
        let c: u64 = ulib.sys(92, (&pfad[0 as usize]) as u64, u, u) // chown
        var s0: [u8; 21] = "settingsd: chown rc=\0"
        say((&s0[0 as usize]) as u64)
        actwire.outnum(c)
        nl()
    }
    var s1: [u8; 29] = "settingsd: language for uid=\0"
    say((&s1[0 as usize]) as u64)
    actwire.outnum(u)
    var s2: [u8; 5] = " ok=\0"
    say((&s2[0 as usize]) as u64)
    if ok {
        actwire.outnum(1)
    } else {
        actwire.outnum(0)
    }
    nl()
    return ok
}

fn is_bright(i: u64) -> bool {
    return actwire.str_eq(setschema.key(i), (&K_BRIGHT[0 as usize]) as u64)
}

fn disp_ready() -> bool {
    let r: u64 = ulib.sys(1810, 0, 0, 0) // SYS_DISPGET, DG_READY
    return !ulib.bad(r) && r == 1
}

fn value_of(i: u64, out: u64) {
    var found: bool = false
    if audio_ready() && is_key(i, (&K_VOL[0 as usize]) as u64) {
        let v: u64 = ulib.sys(1850, 4, 0, 0)
        if !ulib.bad(v) {
            put_num(out, v)
            return
        }
    }
    if audio_ready() && is_key(i, (&K_MUTE[0 as usize]) as u64) {
        var t: [u8; 6] = "true\0\0"
        var f: [u8; 6] = "false\0"
        if ulib.sys(1850, 21, 0, 0) == 1 {
            copyz(out, (&t[0 as usize]) as u64, 64)
        } else {
            copyz(out, (&f[0 as usize]) as u64, 64)
        }
        return
    }
    if is_key(i, (&K_LANG[0 as usize]) as u64) && lang_get(out) {
        return
    }
    if is_key(i, (&K_DHCP[0 as usize]) as u64) && dhcp_get(out) {
        return
    }
    if is_bright(i) && disp_ready() {
        let k: u64 = ulib.sys(1810, 16, 0, 0) // DG_BRIGHT
        if !ulib.bad(k) {
            var z: [u8; 24] = [0 as u8; 24]
            let n: u64 = ulib.digits(k / 2, (&z[0 as usize]) as u64)
            z[(n) as usize] = 0 as u8
            copyz(out, (&z[0 as usize]) as u64, 64)
            return
        }
    }
    if setschema.has_store(i) {
        found = actwire.kvfile_get(setschema.store_file(i), setschema.store_field(i), out, 64)
    } else {
        found = actwire.kvfile_get((&P_DB[0 as usize]) as u64, setschema.key(i), out, 64)
    }
    if !found {
        copyz(out, setschema.default_of(i), 64)
    }
}

fn value_put(i: u64, v: u64) -> bool {
    if is_bright(i) && disp_ready() {
        var k: u64 = ulib.to_num(v) * 2
        if k < 40 {
            k = 40
        }
        let r: u64 = ulib.sys(1811, 3, k, 0) // SYS_DISPSET, DS_BRIGHT
        var s1: [u8; 33] = "settingsd: display brightness k=\0"
        say((&s1[0 as usize]) as u64)
        actwire.outnum(k)
        var s2: [u8; 5] = " rc=\0"
        say((&s2[0 as usize]) as u64)
        actwire.outnum(r)
        nl()
        if ulib.bad(r) {
            return false
        }
    }
    if audio_ready() && is_key(i, (&K_VOL[0 as usize]) as u64) {
        let r: u64 = ulib.sys(1851, 0, ulib.to_num(v), 0)
        var s3: [u8; 30] = "settingsd: sound card volume=\0"
        say((&s3[0 as usize]) as u64)
        say(v)
        var s4: [u8; 5] = " rc=\0"
        say((&s4[0 as usize]) as u64)
        actwire.outnum(r)
        nl()
        return !ulib.bad(r)
    }
    if audio_ready() && is_key(i, (&K_MUTE[0 as usize]) as u64) {
        var m: u64 = 0
        if is_true(v) {
            m = 1
        }
        let r: u64 = ulib.sys(1851, 2, m, 0)
        return !ulib.bad(r)
    }
    if is_key(i, (&K_LANG[0 as usize]) as u64) && lang_uid() != 0 {
        return lang_put(v)
    }
    if is_key(i, (&K_DHCP[0 as usize]) as u64) {
        return dhcp_put(v)
    }
    if setschema.has_store(i) {
        return actwire.kvfile_set(setschema.store_file(i), setschema.store_field(i), v)
    }
    return actwire.kvfile_set((&P_DB[0 as usize]) as u64, setschema.key(i), v)
}

// ------------------------------------------------ the journal

fn journal(no: u64, client: u64, k: u64, old: u64, new: u64, verb: u64) -> bool {
    var s_n: [u8; 3] = "n=\0"
    var s_t: [u8; 4] = " t=\0"
    var s_v: [u8; 7] = " verb=\0"
    var s_c: [u8; 9] = " client=\0"
    var s_k: [u8; 6] = " key=\0"
    var s_o: [u8; 6] = " old=\0"
    var s_w: [u8; 6] = " new=\0"
    actwire.ob_reset()
    actwire.ob_str((&s_n[0 as usize]) as u64)
    actwire.ob_num(no)
    actwire.ob_str((&s_t[0 as usize]) as u64)
    actwire.ob_num(actwire.ticks())
    actwire.ob_str((&s_v[0 as usize]) as u64)
    actwire.ob_str(verb)
    actwire.ob_str((&s_c[0 as usize]) as u64)
    actwire.ob_str(client)
    actwire.ob_str((&s_k[0 as usize]) as u64)
    actwire.ob_str(k)
    actwire.ob_str((&s_o[0 as usize]) as u64)
    actwire.ob_str(old)
    actwire.ob_str((&s_w[0 as usize]) as u64)
    actwire.ob_str(new)
    actwire.ob_ch(10)
    let r: u64 = actwire.append_file((&P_JOURNAL[0 as usize]) as u64,
        actwire.ob_ptr(), actwire.ob_len())
    return !ulib.bad(r)
}

fn remember(no: u64, client: u64, k: u64, old: u64, new: u64) {
    let c: u64 = ch((no - 1) % CH_MAX)
    actwire.st64(c, CH_NO, no)
    copyz(c + CH_KEY, k, 32)
    copyz(c + CH_OLD, old, 64)
    copyz(c + CH_NEW, new, 64)
    copyz(c + CH_CLIENT, client, 24)
}

fn event(k: u64, v: u64, client: u64) {
    var s_ev: [u8; 28] = "event settings.changed\nkey=\0"
    var s_v: [u8; 8] = "\nvalue=\0"
    var s_c: [u8; 9] = "\nclient=\0"
    actwire.ob_reset()
    actwire.ob_str((&s_ev[0 as usize]) as u64)
    actwire.ob_str(k)
    actwire.ob_str((&s_v[0 as usize]) as u64)
    actwire.ob_str(v)
    actwire.ob_str((&s_c[0 as usize]) as u64)
    actwire.ob_str(client)
    actwire.ob_ch(10)
    actwire.send_msg(svc_bus, actwire.K_EVT, evt_no, actwire.ob_ptr(),
        actwire.ob_len())
    evt_no = evt_no + 1
}

// ------------------------------------------------ the calls
//
// The reply is built in `obuf2` (the actwire output buffer is also used
// by the journal and the event, so a reply is assembled at the end).

static mut rbuf: [u8; 8192] = [0 as u8; 8192]
static mut rlen: u64 = 0

fn r_reset() {
    rlen = 0
    st8((&rbuf[0 as usize]) as u64, 0, 0)
}

fn r_str(p: u64) {
    let n: u64 = actwire.slen(p)
    var i: u64 = 0
    while i < n && rlen + 1 < 8190 {
        st8((&rbuf[0 as usize]) as u64, rlen, ld8(p, i))
        rlen = rlen + 1
        i = i + 1
    }
    st8((&rbuf[0 as usize]) as u64, rlen, 0)
}

fn r_ch(c: u64) {
    if rlen + 1 < 8190 {
        st8((&rbuf[0 as usize]) as u64, rlen, c)
        rlen = rlen + 1
        st8((&rbuf[0 as usize]) as u64, rlen, 0)
    }
}

fn r_num(v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    var t: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        r_ch(48)
        return
    }
    while x > 0 {
        st8((&t[0 as usize]) as u64, n, 48 + x % 10)
        x = x / 10
        n = n + 1
    }
    var i: u64 = 0
    while i < n {
        st8((&d[0 as usize]) as u64, i, ld8((&t[0 as usize]) as u64, n - 1 - i))
        i = i + 1
    }
    st8((&d[0 as usize]) as u64, n, 0)
    r_str((&d[0 as usize]) as u64)
}

fn r_err(code: u64, detail: u64) {
    var s_e: [u8; 5] = "err \0"
    r_reset()
    r_str((&s_e[0 as usize]) as u64)
    r_str(code)
    if detail != 0 {
        r_ch(32)
        r_str(detail)
    }
    r_ch(10)
}

fn do_list(msg: u64) {
    var k_area: [u8; 5] = "area\0"
    var area: [u8; 32] = [0 as u8; 32]
    let arp: u64 = (&area[0 as usize]) as u64
    actwire.kv_find(msg, (&k_area[0 as usize]) as u64, arp, 32)
    var s_ok: [u8; 4] = "ok\n\0"
    var s_cnt: [u8; 7] = "count=\0"
    var s_ty: [u8; 7] = ".type=\0"
    var s_tx: [u8; 7] = ".text=\0"
    var n: u64 = 0
    var i: u64 = 0
    while i < setschema.count() {
        if setschema.in_area(i, arp) {
            n = n + 1
        }
        i = i + 1
    }
    r_reset()
    r_str((&s_ok[0 as usize]) as u64)
    r_str((&s_cnt[0 as usize]) as u64)
    r_num(n)
    r_ch(10)
    var v: [u8; 64] = [0 as u8; 64]
    var rg: [u8; 208] = [0 as u8; 208]
    i = 0
    while i < setschema.count() {
        if setschema.in_area(i, arp) {
            value_of(i, (&v[0 as usize]) as u64)
            r_str(setschema.key(i))
            r_ch(61)
            r_str((&v[0 as usize]) as u64)
            r_ch(10)
            r_str(setschema.key(i))
            r_str((&s_ty[0 as usize]) as u64)
            r_str(setschema.type_name(setschema.typ(i)))
            r_ch(32)
            setschema.range_text(i, (&rg[0 as usize]) as u64)
            r_str((&rg[0 as usize]) as u64)
            r_ch(32)
            r_str(setschema.risk_name(setschema.risk(i)))
            r_ch(10)
            r_str(setschema.key(i))
            r_str((&s_tx[0 as usize]) as u64)
            r_str(setschema.desc(i))
            r_ch(10)
        }
        i = i + 1
    }
}

// set / revert share the change itself. Returns true if something changed.
fn change(i: u64, v: u64, client: u64, dry: bool, verb: u64) -> bool {
    var old: [u8; 64] = [0 as u8; 64]
    let op: u64 = (&old[0 as usize]) as u64
    value_of(i, op)
    var s_ok: [u8; 4] = "ok\n\0"
    var s_old: [u8; 5] = "old=\0"
    var s_new: [u8; 5] = "new=\0"
    if dry {
        var s_d: [u8; 16] = "ok\ndry=1\nwould=\0"
        var s_fr: [u8; 7] = " from \0"
        var s_to: [u8; 5] = " to \0"
        r_reset()
        r_str((&s_d[0 as usize]) as u64)
        r_str(setschema.key(i))
        r_str((&s_fr[0 as usize]) as u64)
        r_str(op)
        r_str((&s_to[0 as usize]) as u64)
        r_str(v)
        r_ch(10)
        return false
    }
    if actwire.str_eq(op, v) {
        var s_un: [u8; 12] = "unchanged=1\0"
        r_reset()
        r_str((&s_ok[0 as usize]) as u64)
        r_str((&s_old[0 as usize]) as u64)
        r_str(op)
        r_ch(10)
        r_str((&s_un[0 as usize]) as u64)
        r_ch(10)
        return false
    }
    let no: u64 = ch_next
    // write-ahead: the journal first, then the value
    if !journal(no, client, setschema.key(i), op, v, verb) {
        var e: [u8; 20] = "journal_unavailable\0"
        r_err((&e[0 as usize]) as u64, setschema.key(i))
        return false
    }
    if !value_put(i, v) {
        var e2: [u8; 13] = "store_failed\0"
        r_err((&e2[0 as usize]) as u64, setschema.key(i))
        return false
    }
    ch_next = ch_next + 1
    remember(no, client, setschema.key(i), op, v)
    var s_c: [u8; 8] = "change=\0"
    var s_u: [u8; 11] = "@undo key=\0"
    var s_uv: [u8; 8] = " value=\0"
    r_reset()
    r_str((&s_ok[0 as usize]) as u64)
    r_str((&s_old[0 as usize]) as u64)
    r_str(op)
    r_ch(10)
    r_str((&s_new[0 as usize]) as u64)
    r_str(v)
    r_ch(10)
    r_str((&s_c[0 as usize]) as u64)
    r_num(no)
    r_ch(10)
    // the inverse: settings.set (fixed by the manifest) with the old value
    r_str((&s_u[0 as usize]) as u64)
    r_str(setschema.key(i))
    r_str((&s_uv[0 as usize]) as u64)
    r_str(op)
    r_ch(10)
    event(setschema.key(i), v, client)
    return true
}

fn do_history() {
    var s_ok: [u8; 4] = "ok\n\0"
    var s_cnt: [u8; 7] = "count=\0"
    var s_ch: [u8; 8] = "change.\0"
    var s_ar: [u8; 5] = " -> \0"
    var s_by: [u8; 5] = " by \0"
    var first: u64 = 1
    if ch_next > CH_MAX {
        first = ch_next - CH_MAX
    }
    r_reset()
    r_str((&s_ok[0 as usize]) as u64)
    r_str((&s_cnt[0 as usize]) as u64)
    r_num(ch_next - first)
    r_ch(10)
    var no: u64 = first
    while no < ch_next {
        let c: u64 = ch((no - 1) % CH_MAX)
        r_str((&s_ch[0 as usize]) as u64)
        r_num(no)
        r_ch(61)
        r_str(c + CH_KEY)
        r_ch(32)
        r_str(c + CH_OLD)
        r_str((&s_ar[0 as usize]) as u64)
        r_str(c + CH_NEW)
        r_str((&s_by[0 as usize]) as u64)
        r_str(c + CH_CLIENT)
        r_ch(10)
        no = no + 1
    }
}

// ===================================================== update.* (DAILY-DRIVER)
//
// The system update as four actions of this root provider (manifest:
// /etc/actions.d/settings.actions). The user's settings window cannot run
// `ota` -- installing needs root -- so it asks here, and the broker has
// already decided the rights: `update.status` is a read, `update.check` a
// write, `update.install` and `update.rollback` are critical (always the
// user's yes). Nothing here updates by itself; `/bin/ota` does the work
// (signature, hash, rollback guard, trial counter) in a child process that
// is NOT waited for -- a download takes minutes -- and is reaped in the
// serve loop. One child at a time: a second request meanwhile is `busy`.
static mut u_pid: u64 = 0
static mut u_argv: [u64; 4] = [0 as u64; 4]
static mut U_ARG0: [u8; 4] = "ota\0"
static mut C_SUCH: [u8; 7] = "search\0"
static mut C_EIN: [u8; 6] = "apply\0"
static mut C_ZUR: [u8; 9] = "rollback\0"
static mut P_OTA: [u8; 9] = "/bin/ota\0"
static mut P_STAND: [u8; 18] = "/system/ota.stand\0"
static mut P_OCONF: [u8; 14] = "/etc/ota.conf\0"

fn upd_alive() -> bool {
    if u_pid == 0 {
        return false
    }
    var i: u64 = 0
    while i < 32 {
        let st: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_STATE, 0)
        if !ulib.bad(st) && st != 0 {
            if ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PID, 0) == u_pid {
                if st == 5 {
                    // finished: collect it so the process table does not fill
                    ulib.wait_code(u_pid)
                    u_pid = 0
                    return false
                }
                return true
            }
        }
        i = i + 1
    }
    u_pid = 0
    return false
}

fn upd_run(sub: u64, extra: u64) -> bool {
    u_argv[0 as usize] = (&U_ARG0[0 as usize]) as u64
    u_argv[1 as usize] = sub
    var argc: u64 = 2
    if extra != 0 {
        u_argv[2 as usize] = extra
        argc = 3
    }
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&P_OTA[0 as usize]) as u64,
        (&u_argv[0 as usize]) as u64, argc)
    if ulib.bad(pid) {
        return false
    }
    u_pid = pid
    return true
}

fn do_update_status() {
    var s_ok: [u8; 4] = "ok\n\0"
    var f_dort: [u8; 5] = "dort\0"
    var f_hier: [u8; 5] = "hier\0"
    var f_zeit: [u8; 5] = "zeit\0"
    var f_phase: [u8; 6] = "phase\0"
    var f_kanal: [u8; 6] = "kanal\0"
    var f_auto: [u8; 5] = "auto\0"
    var k_there: [u8; 7] = "there=\0"
    var k_here: [u8; 6] = "here=\0"
    var k_time: [u8; 6] = "time=\0"
    var k_phase: [u8; 7] = "phase=\0"
    var k_chan: [u8; 9] = "channel=\0"
    var k_auto: [u8; 6] = "auto=\0"
    var k_busy: [u8; 6] = "busy=\0"
    var d_chan: [u8; 7] = "stable\0"
    var d_ruhe: [u8; 5] = "ruhe\0"
    var v: [u8; 64] = [0 as u8; 64]
    let vp: u64 = (&v[0 as usize]) as u64
    r_reset()
    r_str((&s_ok[0 as usize]) as u64)
    r_str((&k_here[0 as usize]) as u64)
    if !actwire.kvfile_get((&P_STAND[0 as usize]) as u64, (&f_hier[0 as usize]) as u64, vp, 64) {
        st8(vp, 0, 48)
        st8(vp, 1, 0)
    }
    r_str(vp)
    r_ch(10)
    r_str((&k_there[0 as usize]) as u64)
    if !actwire.kvfile_get((&P_STAND[0 as usize]) as u64, (&f_dort[0 as usize]) as u64, vp, 64) {
        st8(vp, 0, 48)
        st8(vp, 1, 0)
    }
    r_str(vp)
    r_ch(10)
    r_str((&k_time[0 as usize]) as u64)
    // "2026-10-02 14:30" holds a space: the key=value reader stops at it,
    // so the date and the time are two reads of the same line
    actwire.kvfile_get((&P_STAND[0 as usize]) as u64, (&f_zeit[0 as usize]) as u64, vp, 64)
    r_str(vp)
    r_ch(10)
    r_str((&k_phase[0 as usize]) as u64)
    if !actwire.kvfile_get((&P_STAND[0 as usize]) as u64, (&f_phase[0 as usize]) as u64, vp, 64) {
        copyz(vp, (&d_ruhe[0 as usize]) as u64, 64)
    }
    r_str(vp)
    r_ch(10)
    r_str((&k_chan[0 as usize]) as u64)
    if !actwire.kvfile_get((&P_OCONF[0 as usize]) as u64, (&f_kanal[0 as usize]) as u64, vp, 64) {
        copyz(vp, (&d_chan[0 as usize]) as u64, 64)
    }
    r_str(vp)
    r_ch(10)
    r_str((&k_auto[0 as usize]) as u64)
    if !actwire.kvfile_get((&P_OCONF[0 as usize]) as u64, (&f_auto[0 as usize]) as u64, vp, 64) {
        var d_f: [u8; 5] = "true\0"
        copyz(vp, (&d_f[0 as usize]) as u64, 64)
    }
    r_str(vp)
    r_ch(10)
    r_str((&k_busy[0 as usize]) as u64)
    if upd_alive() {
        r_ch(49)
    } else {
        r_ch(48)
    }
    r_ch(10)
}

// check | install | rollback: start `ota` and answer at once
fn do_update_run(name: u64, dry: bool) {
    var a_chk: [u8; 22] = "settings.update.check\0"
    var a_ins: [u8; 24] = "settings.update.install\0"
    var s_ok: [u8; 4] = "ok\n\0"
    var s_would: [u8; 7] = "would=\0"
    var s_start: [u8; 9] = "started=\0"
    var e_busy: [u8; 5] = "busy\0"
    var e_fail: [u8; 12] = "exec_failed\0"
    var sub: u64 = (&C_ZUR[0 as usize]) as u64
    if actwire.str_eq(name, (&a_chk[0 as usize]) as u64) {
        sub = (&C_SUCH[0 as usize]) as u64
    } else if actwire.str_eq(name, (&a_ins[0 as usize]) as u64) {
        sub = (&C_EIN[0 as usize]) as u64
    }
    if upd_alive() {
        r_err((&e_busy[0 as usize]) as u64, 0)
        return
    }
    r_reset()
    r_str((&s_ok[0 as usize]) as u64)
    if dry {
        r_str((&s_would[0 as usize]) as u64)
        r_str(sub)
        r_ch(10)
        return
    }
    if !upd_run(sub, 0) {
        r_err((&e_fail[0 as usize]) as u64, 0)
        return
    }
    r_str((&s_start[0 as usize]) as u64)
    r_str(sub)
    r_ch(10)
}

fn handle(msg: u64) -> bool {
    var verb: [u8; 16] = [0 as u8; 16]
    var name: [u8; 40] = [0 as u8; 40]
    let vp: u64 = (&verb[0 as usize]) as u64
    let np: u64 = (&name[0 as usize]) as u64
    let nx: u64 = actwire.word_copy(msg, 0, vp, 16)
    actwire.word_copy(msg, nx, np, 40)
    var k_dry: [u8; 5] = "@dry\0"
    var k_cl: [u8; 8] = "@client\0"
    var k_key: [u8; 4] = "key\0"
    var k_val: [u8; 6] = "value\0"
    var k_chg: [u8; 7] = "change\0"
    var dv: [u8; 4] = [0 as u8; 4]
    let dry: bool = actwire.kv_find(msg, (&k_dry[0 as usize]) as u64,
        (&dv[0 as usize]) as u64, 4)
    var client: [u8; 24] = [0 as u8; 24]
    let cp: u64 = (&client[0 as usize]) as u64
    actwire.kv_find(msg, (&k_cl[0 as usize]) as u64, cp, 24)
    var kb: [u8; 32] = [0 as u8; 32]
    let kp: u64 = (&kb[0 as usize]) as u64
    actwire.kv_find(msg, (&k_key[0 as usize]) as u64, kp, 32)
    var vb: [u8; 200] = [0 as u8; 200]
    let valp: u64 = (&vb[0 as usize]) as u64

    var k_ping: [u8; 5] = "ping\0"
    var a_list: [u8; 14] = "settings.list\0"
    var a_get: [u8; 13] = "settings.get\0"
    var a_set: [u8; 13] = "settings.set\0"
    var a_hist: [u8; 17] = "settings.history\0"
    var a_rev: [u8; 16] = "settings.revert\0"
    var e_key: [u8; 16] = "unknown_setting\0"
    var e_val: [u8; 10] = "bad_value\0"
    var s_ok: [u8; 4] = "ok\n\0"
    var s_val: [u8; 7] = "value=\0"

    if actwire.str_eq(vp, (&k_ping[0 as usize]) as u64) {
        var s_pong: [u8; 6] = "pong\n\0"
        r_reset()
        r_str((&s_pong[0 as usize]) as u64)
        return false
    }
    if actwire.str_eq(np, (&a_list[0 as usize]) as u64) {
        do_list(msg)
        return false
    }
    if actwire.str_eq(np, (&a_hist[0 as usize]) as u64) {
        do_history()
        return false
    }
    var a_ust: [u8; 23] = "settings.update.status\0"
    var a_uch: [u8; 22] = "settings.update.check\0"
    var a_uin: [u8; 24] = "settings.update.install\0"
    var a_uro: [u8; 25] = "settings.update.rollback\0"
    if actwire.str_eq(np, (&a_ust[0 as usize]) as u64) {
        do_update_status()
        return false
    }
    if actwire.str_eq(np, (&a_uch[0 as usize]) as u64)
        || actwire.str_eq(np, (&a_uin[0 as usize]) as u64)
        || actwire.str_eq(np, (&a_uro[0 as usize]) as u64) {
        do_update_run(np, dry)
        return false
    }
    let i: u64 = setschema.find(kp)
    if i == setschema.NONE {
        r_err((&e_key[0 as usize]) as u64, kp)
        return false
    }
    if actwire.str_eq(np, (&a_get[0 as usize]) as u64) {
        var v: [u8; 64] = [0 as u8; 64]
        value_of(i, (&v[0 as usize]) as u64)
        r_reset()
        r_str((&s_ok[0 as usize]) as u64)
        r_str((&s_val[0 as usize]) as u64)
        r_str((&v[0 as usize]) as u64)
        r_ch(10)
        return false
    }
    if actwire.str_eq(np, (&a_set[0 as usize]) as u64) {
        actwire.kv_find(msg, (&k_val[0 as usize]) as u64, valp, 200)
        // the broker checked it; checked again, because a provider that
        // trusts a single check is one bug away from a broken setting
        var why: [u8; 80] = [0 as u8; 80]
        if !setschema.validate(i, valp, (&why[0 as usize]) as u64) {
            r_err((&e_val[0 as usize]) as u64, (&why[0 as usize]) as u64)
            return false
        }
        var s_set: [u8; 4] = "set\0"
        return change(i, valp, cp, dry, (&s_set[0 as usize]) as u64)
    }
    if actwire.str_eq(np, (&a_rev[0 as usize]) as u64) {
        var cb: [u8; 24] = [0 as u8; 24]
        actwire.kv_find(msg, (&k_chg[0 as usize]) as u64, (&cb[0 as usize]) as u64, 24)
        let no: u64 = ulib.to_num((&cb[0 as usize]) as u64)
        var e_no: [u8; 15] = "no_such_change\0"
        var e_since: [u8; 14] = "changed_since\0"
        if no == 0 || no >= ch_next || no + CH_MAX < ch_next {
            r_err((&e_no[0 as usize]) as u64, (&cb[0 as usize]) as u64)
            return false
        }
        let c: u64 = ch((no - 1) % CH_MAX)
        if !actwire.str_eq(c + CH_KEY, kp) {
            r_err((&e_no[0 as usize]) as u64, (&cb[0 as usize]) as u64)
            return false
        }
        var cur: [u8; 64] = [0 as u8; 64]
        value_of(i, (&cur[0 as usize]) as u64)
        if !actwire.str_eq((&cur[0 as usize]) as u64, c + CH_NEW) {
            // somebody changed it again since: putting the old value back
            // would silently throw that away
            r_err((&e_since[0 as usize]) as u64, kp)
            return false
        }
        var old: [u8; 64] = [0 as u8; 64]
        copyz((&old[0 as usize]) as u64, c + CH_OLD, 64)
        var s_rev: [u8; 7] = "revert\0"
        return change(i, (&old[0 as usize]) as u64, cp, dry,
            (&s_rev[0 as usize]) as u64)
    }
    var e3: [u8; 15] = "unknown_action\0"
    r_err((&e3[0 as usize]) as u64, np)
    return false
}

fn serve(limit: u64) -> u64 {
    if setschema.load((&P_SCHEMA[0 as usize]) as u64) == setschema.NONE {
        var e0: [u8; 45] = "settingsd: no usable /etc/settings.schema\n\0\0\0"
        say((&e0[0 as usize]) as u64)
        return 1
    }
    var n_me: [u8; 11] = "a.settings\0"
    let me: u64 = actwire.bus_reg((&n_me[0 as usize]) as u64, actwire.A_ROOT)
    if ulib.bad(me) {
        var e: [u8; 29] = "settingsd: a.settings taken\n\0"
        say((&e[0 as usize]) as u64)
        return 1
    }
    var n_bus: [u8; 11] = "orient.bus\0"
    let t0: u64 = actwire.ticks()
    svc_bus = actwire.bus_find((&n_bus[0 as usize]) as u64)
    while ulib.bad(svc_bus) && actwire.ticks() - t0 < 500 {
        ulib.sleep_ms(10)
        svc_bus = actwire.bus_find((&n_bus[0 as usize]) as u64)
    }
    if ulib.bad(svc_bus) {
        var e2: [u8; 31] = "settingsd: no orient.bus here\n\0"
        say((&e2[0 as usize]) as u64)
        return 1
    }
    var s_hello: [u8; 16] = "hello settings\n\0"
    actwire.send_msg(svc_bus, actwire.K_REQ, actwire.rnd() & 0xFFFFFFFF,
        (&s_hello[0 as usize]) as u64, 15)
    var s_ready: [u8; 25] = "settingsd: ready keys=\0\0\0"
    say((&s_ready[0 as usize]) as u64)
    actwire.outnum(setschema.count())
    nl()

    var fr: [u8; 64] = [0 as u8; 64]
    var meta: [u64; 6] = [0 as u64; 6]
    let fp: u64 = (&fr[0 as usize]) as u64
    let mp: u64 = (&meta[0 as usize]) as u64
    let t1: u64 = actwire.ticks()
    var last_check: u64 = t1
    lastmsg = t1
    while limit == 0 || actwire.ticks() - t1 < limit {
        let n: u64 = actwire.bus_wait(fp, mp, 100) // AB-002: blocks
        if !ulib.bad(n) && n > 0 {
            lastmsg = actwire.ticks()
            let s: u64 = actwire.asm_feed(fp, mp)
            if s != actwire.NONE {
                if actwire.asm_kind(s) == actwire.K_REQ {
                    let id: u64 = actwire.asm_id(s)
                    handle(actwire.asm_buf(s))
                    actwire.send_msg(svc_bus, actwire.K_REP, id,
                        (&rbuf[0 as usize]) as u64, rlen)
                }
                actwire.asm_free(s)
            }
        } else {
            if u_pid != 0 {
                upd_alive()
            }
            if actwire.ticks() - last_check > 100 {
                last_check = actwire.ticks()
                if ulib.bad(actwire.bus_find((&n_bus[0 as usize]) as u64)) {
                    var s_by: [u8; 31] = "settingsd: orient-bus is gone\n\0"
                    say((&s_by[0 as usize]) as u64)
                    return 0
                }
            }
        }
    }
    return 0
}

// `settingsd check <schema>`: the schema as this system understands it
fn check(path: u64) -> u64 {
    let n: u64 = setschema.load(path)
    var s1: [u8; 27] = "settingsd: schema ok keys=\0"
    var s2: [u8; 26] = "settingsd: schema FAILED\n\0"
    if n == setschema.NONE {
        say((&s2[0 as usize]) as u64)
        return 1
    }
    say((&s1[0 as usize]) as u64)
    actwire.outnum(n)
    nl()
    return 0
}

fn u_start(args: u64) -> u64 {
    var h: [u8; 51] = "usage: settingsd serve [ticks] | check <schema>\n\0\0\0"
    var c_serve: [u8; 6] = "serve\0"
    var c_check: [u8; 6] = "check\0"
    let argc: u64 = ulib.arg_count(args)
    if argc >= 2 && actwire.str_eq(ulib.arg_at(args, 1), (&c_serve[0 as usize]) as u64) {
        var lim: u64 = 0
        if argc >= 3 {
            lim = ulib.to_num(ulib.arg_at(args, 2))
        }
        return serve(lim)
    }
    if argc >= 3 && actwire.str_eq(ulib.arg_at(args, 1), (&c_check[0 as usize]) as u64) {
        return check(ulib.arg_at(args, 2))
    }
    say((&h[0 as usize]) as u64)
    return 1
}
