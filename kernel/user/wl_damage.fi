profile kernel

export { reset, add, force_full, take_region }

const SLOTS: u64 = 2048
const NO_DAMAGE: u64 = 0
const FULL_DAMAGE: u64 = 0xFFFFFFFFFFFFFFFF
const COORD_MAX: i64 = 0xFFFF
const FULL_EVERY: u64 = 240
const NO_REGION: u64 = 0

static mut pending: [u64; 2048] = [0 as u64; 2048]
static mut seen_geometry: [u64; 2048] = [0 as u64; 2048]
static mut sticky_full: [u64; 2048] = [0 as u64; 2048]
static mut since_full: [u64; 2048] = [0 as u64; 2048]

fn s32(v: u64) -> i64 {
    var x: i64 = (v & 0xFFFFFFFF) as i64
    if x >= 2147483648 {
        x = x - 4294967296
    }
    return x
}

fn clamp(v: i64) -> i64 {
    if v < 0 {
        return 0
    }
    if v > COORD_MAX {
        return COORD_MAX
    }
    return v
}

fn pack(x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    return (x0 << 48) | (y0 << 32) | (x1 << 16) | y1
}

fn reset(slot: u64) {
    if slot >= SLOTS {
        return
    }
    pending[slot as usize] = NO_DAMAGE
    seen_geometry[slot as usize] = 0
    sticky_full[slot as usize] = 0
    since_full[slot as usize] = 0
}

fn force_full(slot: u64) {
    if slot >= SLOTS {
        return
    }
    sticky_full[slot as usize] = 1
}

fn add(slot: u64, x: u64, y: u64, w: u64, h: u64) {
    if slot >= SLOTS {
        return
    }
    let sx: i64 = s32(x)
    let sy: i64 = s32(y)
    let sw: i64 = s32(w)
    let sh: i64 = s32(h)
    if sw <= 0 || sh <= 0 {
        return
    }
    let x0: u64 = clamp(sx) as u64
    let y0: u64 = clamp(sy) as u64
    let x1: u64 = clamp(sx + sw) as u64
    let y1: u64 = clamp(sy + sh) as u64
    if x1 <= x0 || y1 <= y0 {
        return
    }
    let old: u64 = pending[slot as usize]
    if old == FULL_DAMAGE {
        return
    }
    if old == NO_DAMAGE {
        pending[slot as usize] = pack(x0, y0, x1, y1)
        return
    }
    let ox0: u64 = old >> 48
    let oy0: u64 = (old >> 32) & 0xFFFF
    let ox1: u64 = (old >> 16) & 0xFFFF
    let oy1: u64 = old & 0xFFFF
    var nx0: u64 = x0
    var ny0: u64 = y0
    var nx1: u64 = x1
    var ny1: u64 = y1
    if ox0 < nx0 {
        nx0 = ox0
    }
    if oy0 < ny0 {
        ny0 = oy0
    }
    if ox1 > nx1 {
        nx1 = ox1
    }
    if oy1 > ny1 {
        ny1 = oy1
    }
    pending[slot as usize] = pack(nx0, ny0, nx1, ny1)
}

fn take_region(slot: u64, gx: u64, gy: u64, gw: u64, gh: u64, must_full: bool) -> u64 {
    if slot >= SLOTS {
        return pack(0, 0, gw, gh)
    }
    let geometry: u64 = pack(gx & 0xFFFF, gy & 0xFFFF, gw & 0xFFFF, gh & 0xFFFF)
    let dmg: u64 = pending[slot as usize]
    pending[slot as usize] = NO_DAMAGE
    var full: bool = must_full || dmg == NO_DAMAGE || dmg == FULL_DAMAGE
    if sticky_full[slot as usize] != 0 || seen_geometry[slot as usize] != geometry {
        full = true
    }
    since_full[slot as usize] = since_full[slot as usize] + 1
    if since_full[slot as usize] >= FULL_EVERY {
        full = true
    }
    seen_geometry[slot as usize] = geometry
    if full {
        since_full[slot as usize] = 0
        return pack(0, 0, gw, gh)
    }
    var x0: u64 = dmg >> 48
    var y0: u64 = (dmg >> 32) & 0xFFFF
    var x1: u64 = (dmg >> 16) & 0xFFFF
    var y1: u64 = dmg & 0xFFFF
    if x0 < gx {
        x0 = gx
    }
    if y0 < gy {
        y0 = gy
    }
    if x1 > gx + gw {
        x1 = gx + gw
    }
    if y1 > gy + gh {
        y1 = gy + gh
    }
    if x1 <= x0 || y1 <= y0 {
        return NO_REGION
    }
    return pack(x0 - gx, y0 - gy, x1 - gx, y1 - gy)
}
