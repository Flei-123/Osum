
profile app

import ulib
import libc.io
import lineout
import fuiscene
import nv
import libc.octets

export { u_start }

const MAXT: u64 = 32
const MAXP: u64 = 24
const MAXS: u64 = 16
const SPARK: u64 = 32
const HIST: u64 = 12000

static mut b_prog: [u8; 3072] = [0 as u8; 3072]
static mut b_conn: [u8; 2048] = [0 as u8; 2048]
static mut b_cli: [u8; 1024] = [0 as u8; 1024]
static mut l_rate: [u8; 96] = [0 as u8; 96]
static mut l_graph: [u8; 64] = [0 as u8; 64]
static mut l_share: [u8; 128] = [0 as u8; 128]
static mut samples: [u64; 32] = [0 as u64; 32]
static mut prev_p: [u64; 24] = [0 as u64; 24]
static mut day_v: [u64; 24] = [0 as u64; 24]
static mut mon_v: [u64; 24] = [0 as u64; 24]
static mut h_buf: [u8; 12000] = [0 as u8; 12000]

static mut t_win: [u8; 8] = "Network\0"
static mut t_tabs: [u8; 29] = "Programs\nConnections\nSharing\0"
static mut c_prog: [u8; 16] = "180\t70\t70\t70\t90\0"
static mut c_conn: [u8; 21] = "50\t150\t150\t100\t45\t90\0"
static mut c_cli: [u8; 14] = "150\t120\t90\t90\0"
static mut b_real: [u8; 5] = "real\0"
static mut b_filt: [u8; 9] = "filtered\0"
static mut b_fake: [u8; 6] = "faked\0"
static mut b_none: [u8; 5] = "none\0"
static mut b_roll: [u8; 14] = "write history\0"
static mut b_shon: [u8; 15] = "sharing on/off\0"

static mut APP_BUNDLE_NAME: [u8; 7] = "netmon\0"

fn q(kind: u64, index: u64, field: u64) -> u64 {
    let v: u64 = ulib.sys(ulib.SYS_NETMON, kind, index, field)
    if ulib.bad(v) {
        return 0
    }
    return v
}

fn put(dst: u64, at: u64, c: u64) -> u64 {
    __mmio_write8((dst + at) as *mut u8, (c & 0xFF) as u8)
    return at + 1
}

fn put_num(dst: u64, at: u64, v: u64) -> u64 {
    if v >= 10 {
        let hi: u64 = put_num(dst, at, v / 10)
        return put(dst, hi, 48 + v % 10)
    }
    return put(dst, at, 48 + v)
}

fn put_str(dst: u64, at: u64, s: u64) -> u64 {
    var i: u64 = 0
    var k: u64 = at
    while octets.ld8(s, i) != 0 {
        k = put(dst, k, octets.ld8(s, i))
        i = i + 1
    }
    return k
}

fn put_size(dst: u64, at: u64, v: u64) -> u64 {
    var suf: [u8; 5] = "kMGT\0"
    if v < 1024 {
        return put_num(dst, at, v)
    }
    var s: u64 = 0
    var x: u64 = v
    while x >= 1024 * 1024 && s < 3 {
        x = x / 1024
        s = s + 1
    }
    var k: u64 = put_num(dst, at, x / 1024)
    k = put(dst, k, 46)
    k = put(dst, k, 48 + ((x % 1024) * 10) / 1024)
    return put(dst, k, suf[s as usize] as u64)
}

fn put_ip(dst: u64, at: u64, a: u64) -> u64 {
    var k: u64 = put_num(dst, at, (a >> 24) & 0xFF)
    k = put(dst, put_num(dst, put(dst, k, 46), (a >> 16) & 0xFF), 46)
    k = put_num(dst, k, (a >> 8) & 0xFF)
    return put_num(dst, put(dst, k, 46), a & 0xFF)
}

fn prog_name(i: u64, out: u64) -> u64 {
    var k: u64 = 0
    while k < 23 {
        let c: u64 = q(ulib.NK_PNAME, i, k)
        __mmio_write8((out + k) as *mut u8, (c & 0xFF) as u8)
        if c == 0 {
            k = 23
        } else {
            k = k + 1
        }
    }
    __mmio_write8((out + 23) as *mut u8, 0 as u8)
    return out
}

fn task_name(t: u64, out: u64) -> u64 {
    var k: u64 = 0
    while k < 23 {
        let c: u64 = q(ulib.NK_NAME, t, k)
        __mmio_write8((out + k) as *mut u8, (c & 0xFF) as u8)
        if c == 0 {
            k = 23
        } else {
            k = k + 1
        }
    }
    __mmio_write8((out + 23) as *mut u8, 0 as u8)
    return out
}

fn same_name(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while i < 24 {
        let x: u64 = octets.ld8(a, i)
        if x != octets.ld8(b, i) {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return true
}

fn hist_load() {
    var path: [u8; 15] = "/var/net/usage\0"
    var today: [u8; 16] = [0 as u8; 16]
    var thismo: [u8; 16] = [0 as u8; 16]
    var nam: [u8; 24] = [0 as u8; 24]
    var per: [u8; 16] = [0 as u8; 16]
    var pn: [u8; 24] = [0 as u8; 24]
    var i: u64 = 0
    while i < MAXP {
        day_v[i as usize] = 0
        mon_v[i as usize] = 0
        i = i + 1
    }
    period_now((&today[0]) as u64, true)
    period_now((&thismo[0]) as u64, false)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&path[0]) as u64, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let got: u64 = io.read_full(fd, (&h_buf[0]) as u64, HIST - 1)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(got) {
        return
    }
    h_buf[got as usize] = 0 as u8
    var at: u64 = 0
    while at < got {
        var e: u64 = at
        while e < got && h_buf[e as usize] != 10 as u8 {
            e = e + 1
        }
        h_buf[e as usize] = 0 as u8
        if h_buf[at as usize] != 35 as u8 && e > at {
            let line: u64 = (&h_buf[0]) as u64 + at
            var p2: u64 = field(line, 0, (&per[0]) as u64, 16)
            p2 = field(line, p2, (&nam[0]) as u64, 24)
            var v: [u8; 24] = [0 as u8; 24]
            p2 = field(line, p2, (&v[0]) as u64, 24)
            let sent: u64 = ulib.to_num((&v[0]) as u64)
            p2 = field(line, p2, (&v[0]) as u64, 24)
            let recvd: u64 = ulib.to_num((&v[0]) as u64)
            p2 = field(line, p2, (&v[0]) as u64, 24)
            let wo: u64 = ulib.to_num((&v[0]) as u64)
            p2 = field(line, p2, (&v[0]) as u64, 24)
            let wi: u64 = ulib.to_num((&v[0]) as u64)
            let total: u64 = wo + wi
            var k: u64 = 0
            while k < MAXP {
                if q(ulib.NK_PROG, k, ulib.NP_USED) != 0 {
                    prog_name(k, (&pn[0]) as u64)
                    if same_name((&pn[0]) as u64, (&nam[0]) as u64) {
                        if streq_s((&per[0]) as u64, (&today[0]) as u64) {
                            day_v[k as usize] = day_v[k as usize] + total
                        } else if streq_s((&per[0]) as u64,
                            (&thismo[0]) as u64) {
                            mon_v[k as usize] = mon_v[k as usize] + total
                        }
                    }
                }
                k = k + 1
            }
        }
        at = e + 1
    }
}

fn streq_s(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while true {
        let x: u64 = octets.ld8(a, i)
        if x != octets.ld8(b, i) {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn field(p: u64, at: u64, out: u64, max: u64) -> u64 {
    var i: u64 = at
    while octets.ld8(p, i) == 32 {
        i = i + 1
    }
    var k: u64 = 0
    while octets.ld8(p, i) != 0 && octets.ld8(p, i) != 32 && k < max - 1 {
        __mmio_write8((out + k) as *mut u8, octets.ld8(p, i) as u8)
        i = i + 1
        k = k + 1
    }
    __mmio_write8((out + k) as *mut u8, 0 as u8)
    return i
}

fn two(v: u64, out: u64, at: u64) -> u64 {
    __mmio_write8((out + at) as *mut u8, (48 + (v / 10) % 10) as u8)
    __mmio_write8((out + at + 1) as *mut u8, (48 + v % 10) as u8)
    return at + 2
}

fn period_now(out: u64, day: bool) {
    var at: u64 = put_num(out, 0,
        ulib.sys(ulib.SYS_SYSINFO, ulib.I_YEAR, 0, 0))
    at = two(ulib.sys(ulib.SYS_SYSINFO, ulib.I_MONTH, 0, 0), out,
        put(out, at, 45))
    if day {
        at = two(ulib.sys(ulib.SYS_SYSINFO, ulib.I_DAY, 0, 0), out,
            put(out, at, 45))
    }
    __mmio_write8((out + at) as *mut u8, 0 as u8)
}

fn view_word(v: u64, dst: u64, at: u64) -> u64 {
    var w: [u8; 36] = "real\0\0\0\0\0filtered\0faked\0\0\0\0none\0\0\0\0\0"
    var x: u64 = v
    if x > 3 {
        x = 0
    }
    return put_str(dst, at, (&w[0]) as u64 + x * 9)
}

fn build_programs(dt: u64) -> u64 {
    var head: [u8; 34] = "Program\tNow/s\tToday\tMonth\tNetwork\0"
    var nm: [u8; 24] = [0 as u8; 24]
    var tn: [u8; 24] = [0 as u8; 24]
    var at: u64 = put_str((&b_prog[0]) as u64, 0, (&head[0]) as u64)
    at = put((&b_prog[0]) as u64, at, 10)
    var total: u64 = 0
    var i: u64 = 0
    while i < MAXP {
        if q(ulib.NK_PROG, i, ulib.NP_USED) != 0 {
            let wire: u64 = q(ulib.NK_PROG, i, ulib.NT_TXWIRE)
                + q(ulib.NK_PROG, i, ulib.NT_RXWIRE)
            if wire != 0 {
                var rate: u64 = 0
                if wire > prev_p[i as usize] && dt > 0 {
                    rate = (wire - prev_p[i as usize]) * 100 / dt
                }
                total = total + rate
                prev_p[i as usize] = wire
                prog_name(i, (&nm[0]) as u64)
                at = put_str((&b_prog[0]) as u64, at, (&nm[0]) as u64)
                at = put((&b_prog[0]) as u64, at, 9)
                at = put_size((&b_prog[0]) as u64, at, rate)
                at = put((&b_prog[0]) as u64, at, 9)
                at = put_size((&b_prog[0]) as u64, at, day_v[i as usize])
                at = put((&b_prog[0]) as u64, at, 9)
                at = put_size((&b_prog[0]) as u64, at, mon_v[i as usize])
                at = put((&b_prog[0]) as u64, at, 9)
                var shown: bool = false
                var t: u64 = 0
                while t < MAXT {
                    if q(ulib.NK_TASK, t, ulib.NT_ALIVE) != 0 && !shown {
                        task_name(t, (&tn[0]) as u64)
                        if same_name((&tn[0]) as u64, (&nm[0]) as u64) {
                            at = view_word(q(ulib.NK_TASK, t,
                                ulib.NT_VIEW), (&b_prog[0]) as u64, at)
                            shown = true
                        }
                    }
                    t = t + 1
                }
                if !shown {
                    at = put((&b_prog[0]) as u64, at, 45)
                }
                at = put((&b_prog[0]) as u64, at, 10)
            }
        }
        i = i + 1
    }
    __mmio_write8(((&b_prog[0]) as u64 + at) as *mut u8, 0 as u8)
    return total
}

fn slot_of_row(row: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < MAXP {
        if q(ulib.NK_PROG, i, ulib.NP_USED) != 0 {
            if q(ulib.NK_PROG, i, ulib.NT_TXWIRE)
                + q(ulib.NK_PROG, i, ulib.NT_RXWIRE) != 0 {
                if n == row {
                    return i
                }
                n = n + 1
            }
        }
        i = i + 1
    }
    return MAXP
}

fn build_connections() {
    var head: [u8; 37] = "Proto\tLocal\tRemote\tState\tAge\tProgram\0"
    var st: [u8; 132] = "CLOSED\0\0\0\0\0\0LISTEN\0\0\0\0\0\0SYN_SENT\0\0\0\0SYN_RCVD\0\0\0\0ESTABLISHED\0FIN_WAIT_1\0\0FIN_WAIT_2\0\0CLOSE_WAIT\0\0CLOSING\0\0\0\0\0LAST_ACK\0\0\0\0TIME_WAIT\0\0\0"
    var tcp: [u8; 5] = "tcp\0\0"
    var udp: [u8; 5] = "udp\0\0"
    var icm: [u8; 5] = "icmp\0"
    var dash: [u8; 2] = "-\0"
    var nm: [u8; 24] = [0 as u8; 24]
    let d: u64 = (&b_conn[0]) as u64
    var at: u64 = put_str(d, 0, (&head[0]) as u64)
    at = put(d, at, 10)
    let me: u64 = ulib.sys(1300, 1, 0, 0)
    var i: u64 = 0
    while i < MAXS {
        if q(ulib.NK_SOCK, i, ulib.NS_USE) != 0 {
            let kind: u64 = q(ulib.NK_SOCK, i, ulib.NS_KIND)
            if kind == 1 {
                at = put_str(d, at, (&tcp[0]) as u64)
            } else if kind == 2 {
                at = put_str(d, at, (&udp[0]) as u64)
            } else {
                at = put_str(d, at, (&icm[0]) as u64)
            }
            at = put(d, at, 9)
            var mine: u64 = me
            if ulib.bad(mine) {
                mine = 0
            }
            at = put(d, put_num(d, put(d, put_ip(d, at, mine), 58),
                q(ulib.NK_SOCK, i, ulib.NS_LPORT)), 9)
            let ra: u64 = q(ulib.NK_SOCK, i, ulib.NS_RADDR)
            if ra == 0 {
                at = put_str(d, at, (&dash[0]) as u64)
            } else {
                at = put_num(d, put(d, put_ip(d, at, ra), 58),
                    q(ulib.NK_SOCK, i, ulib.NS_RPORT))
            }
            at = put(d, at, 9)
            if kind == 1 {
                var s2: u64 = q(ulib.NK_SOCK, i, ulib.NS_TCPSTATE)
                if s2 > 10 {
                    s2 = 0
                }
                at = put_str(d, at, (&st[0]) as u64 + s2 * 12)
            } else {
                at = put_str(d, at, (&dash[0]) as u64)
            }
            at = put(d, at, 9)
            at = put_num(d, at, q(ulib.NK_SOCK, i, ulib.NS_AGE) / 100)
            at = put(d, at, 9)
            let ow: u64 = q(ulib.NK_SOCK, i, ulib.NS_OWNER)
            if ow == 0 {
                at = put_str(d, at, (&dash[0]) as u64)
            } else {
                task_name(ow - 1, (&nm[0]) as u64)
                at = put_str(d, at, (&nm[0]) as u64)
            }
            at = put(d, at, 10)
        }
        i = i + 1
    }
    __mmio_write8((d + at) as *mut u8, 0 as u8)
}

fn build_clients() {
    var head: [u8; 29] = "Device\tAddress\tSent\tReceived\0"
    var none: [u8; 21] = "sharing is off\t-\t-\t-\0"
    let d: u64 = (&b_cli[0]) as u64
    var at: u64 = put_str(d, 0, (&head[0]) as u64)
    at = put(d, at, 10)
    let on: u64 = ulib.sys(ulib.SYS_SHARE, ulib.SH_ON, 0, 0)
    if ulib.bad(on) || on == 0 {
        at = put_str(d, at, (&none[0]) as u64)
        at = put(d, at, 10)
        __mmio_write8((d + at) as *mut u8, 0 as u8)
        return
    }
    let n: u64 = ulib.sys(ulib.SYS_SHARE, ulib.SH_NCLIENT, 0, 0)
    var i: u64 = 0
    while i < n && i < 16 {
        if ulib.sys(ulib.SYS_SHARE, ulib.SH_CLIENT, i, 0) != 0 {
            let mac: u64 = ulib.sys(ulib.SYS_SHARE, ulib.SH_CMAC, i, 0)
            var k: u64 = 0
            while k < 6 {
                if k > 0 {
                    at = put(d, at, 58)
                }
                at = put_hex2(d, at, (mac >> (k * 8)) & 0xFF)
                k = k + 1
            }
            at = put(d, at, 9)
            at = put_ip(d, at, ulib.sys(ulib.SYS_SHARE, ulib.SH_CIP, i, 0))
            at = put(d, at, 9)
            at = put_size(d, at, ulib.sys(ulib.SYS_SHARE, ulib.SH_CIN, i, 0))
            at = put(d, at, 9)
            at = put_size(d, at, ulib.sys(ulib.SYS_SHARE, ulib.SH_COUT, i, 0))
            at = put(d, at, 10)
        }
        i = i + 1
    }
    __mmio_write8((d + at) as *mut u8, 0 as u8)
}

fn put_hex2(d: u64, at: u64, v: u64) -> u64 {
    var k: u64 = at
    var i: u64 = 0
    while i < 2 {
        let x: u64 = (v >> ((1 - i) * 4)) & 0xF
        if x < 10 {
            k = put(d, k, 48 + x)
        } else {
            k = put(d, k, 87 + x)
        }
        i = i + 1
    }
    return k
}

fn build_graph(rate: u64) {
    var ramp: [u8; 9] = " .:-=+*#\0"
    var i: u64 = 0
    while i + 1 < SPARK {
        samples[i as usize] = samples[(i + 1) as usize]
        i = i + 1
    }
    samples[(SPARK - 1) as usize] = rate
    var top: u64 = 1
    i = 0
    while i < SPARK {
        if samples[i as usize] > top {
            top = samples[i as usize]
        }
        i = i + 1
    }
    let d: u64 = (&l_graph[0]) as u64
    i = 0
    while i < SPARK {
        var lv: u64 = samples[i as usize] * 7 / top
        if lv > 7 {
            lv = 7
        }
        __mmio_write8((d + i) as *mut u8, ramp[lv as usize])
        i = i + 1
    }
    __mmio_write8((d + SPARK) as *mut u8, 0 as u8)
}

fn build_rate(rate: u64) {
    var pre: [u8; 12] = "total now: \0"
    var suf: [u8; 12] = "/s   peak: \0"
    var end: [u8; 4] = "/s\0\0"
    let d: u64 = (&l_rate[0]) as u64
    var at: u64 = put_str(d, 0, (&pre[0]) as u64)
    at = put_size(d, at, rate)
    at = put_str(d, at, (&suf[0]) as u64)
    var top: u64 = 0
    var i: u64 = 0
    while i < SPARK {
        if samples[i as usize] > top {
            top = samples[i as usize]
        }
        i = i + 1
    }
    at = put_size(d, at, top)
    at = put_str(d, at, (&end[0]) as u64)
    __mmio_write8((d + at) as *mut u8, 0 as u8)
}

fn build_share_line() {
    var off: [u8; 61] = "sharing is off -- no second network card, or not switched on\0"
    var pre: [u8; 14] = "shared side: \0"
    var mid: [u8; 12] = "   pool: \0\0\0"
    var dsh: [u8; 2] = "-\0"
    let d: u64 = (&l_share[0]) as u64
    let on: u64 = ulib.sys(ulib.SYS_SHARE, ulib.SH_ON, 0, 0)
    if ulib.bad(on) || on == 0 {
        ulib.strcpy(d, (&off[0]) as u64)
        return
    }
    var at: u64 = put_str(d, 0, (&pre[0]) as u64)
    at = put_ip(d, at, ulib.sys(ulib.SYS_SHARE, ulib.SH_IP, 0, 0))
    at = put_str(d, at, (&mid[0]) as u64)
    at = put_ip(d, at, ulib.sys(ulib.SYS_SHARE, ulib.SH_P0, 0, 0))
    at = put_str(d, at, (&dsh[0]) as u64)
    at = put_ip(d, at, ulib.sys(ulib.SYS_SHARE, ulib.SH_P1, 0, 0))
    __mmio_write8((d + at) as *mut u8, 0 as u8)
}

const K_TAB: u64 = 20
const K_TP: u64 = 30
const K_TC: u64 = 31
const K_TL: u64 = 32
const K_B: u64 = 40
static mut cur_tab: u64 = 0
static mut sel_prog: u64 = 0
static mut t_tab0: [u8; 9] = "Programs\0"
static mut t_tab1: [u8; 12] = "Connections\0"
static mut t_tab2: [u8; 8] = "Sharing\0"

fn set_cols(key: u64, spec: u64) {
    var col: u64 = 0
    var v: u64 = 0
    var i: u64 = 0
    while octets.ld8(spec, i) != 0 {
        let c: u64 = octets.ld8(spec, i)
        if c == 9 {
            fuiscene.table_colw(key, col, v)
            col = col + 1
            v = 0
        } else if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
        }
        i = i + 1
    }
    fuiscene.table_colw(key, col, v)
}

fn build() {
    let col: usize = fuiscene.root()
    let tr: usize = fuiscene.row(col)
    let a: usize = fuiscene.tab(tr, (&t_tab0[0]) as u64, K_TAB, cur_tab == 0)
    fuiscene.set_size(a, 120, 36)
    let b: usize = fuiscene.tab(tr, (&t_tab1[0]) as u64, K_TAB + 1, cur_tab == 1)
    fuiscene.set_size(b, 128, 36)
    let c: usize = fuiscene.tab(tr, (&t_tab2[0]) as u64, K_TAB + 2, cur_tab == 2)
    fuiscene.set_size(c, 100, 36)
    let _lr: usize = fuiscene.label(col, (&l_rate[0]) as u64)
    let _lg: usize = fuiscene.label(col, (&l_graph[0]) as u64)
    if cur_tab == 0 {
        let _t: usize = fuiscene.table_blob(col, K_TP, 600, 208, 5, (&b_prog[0]) as u64)
    } else if cur_tab == 1 {
        let _t: usize = fuiscene.table_blob(col, K_TC, 600, 208, 6, (&b_conn[0]) as u64)
    } else {
        let _ls: usize = fuiscene.label(col, (&l_share[0]) as u64)
        let _t: usize = fuiscene.table_blob(col, K_TL, 600, 180, 4, (&b_cli[0]) as u64)
    }
    let bar: usize = fuiscene.row(col)
    fuiscene.set_gap(bar, 8)
    let k1: usize = fuiscene.button(bar, (&b_real[0]) as u64, K_B)
    fuiscene.set_size(k1, 80, 36)
    let k2: usize = fuiscene.button(bar, (&b_filt[0]) as u64, K_B + 1)
    fuiscene.set_size(k2, 92, 36)
    let k3: usize = fuiscene.button(bar, (&b_fake[0]) as u64, K_B + 2)
    fuiscene.set_size(k3, 80, 36)
    let k4: usize = fuiscene.button(bar, (&b_none[0]) as u64, K_B + 3)
    fuiscene.set_size(k4, 80, 36)
    let k5: usize = fuiscene.button(bar, (&b_roll[0]) as u64, K_B + 4)
    fuiscene.set_size(k5, 120, 36)
    let k6: usize = fuiscene.button(bar, (&b_shon[0]) as u64, K_B + 5)
    fuiscene.set_size(k6, 120, 36)
}

fn checksum() -> u64 {
    var h: u64 = 5381
    var k: u64 = 0
    while k < 5 {
        var p: u64 = (&b_prog[0]) as u64
        if k == 1 {
            p = (&b_conn[0]) as u64
        } else if k == 2 {
            p = (&b_cli[0]) as u64
        } else if k == 3 {
            p = (&l_rate[0]) as u64
        } else if k == 4 {
            p = (&l_graph[0]) as u64
        }
        var i: u64 = 0
        while octets.ld8(p, i) != 0 {
            h = (h *% 33) +% octets.ld8(p, i)
            i = i + 1
        }
        k = k + 1
    }
    return h
}

fn cur_table_key() -> u64 {
    if cur_tab == 0 {
        return K_TP
    }
    if cur_tab == 1 {
        return K_TC
    }
    return K_TL
}

fn u_start(args: u64) -> u64 {
    var s_bad: [u8; 25] = "netmon: no window server\0"

    hist_load()
    let dummy: u64 = build_programs(0)
    build_connections()
    build_clients()
    build_graph(0)
    build_rate(0)
    build_share_line()

    let bw: u64 = 620
    let bh: u64 = 430
    if !fuiscene.open(110, 40, bw, bh, (&t_win[0]) as u64, build) {
        lineout.add_text((&s_bad[0]) as u64)
        lineout.end_line()
        return 1
    }
    fuiscene.set_app((&APP_BUNDLE_NAME[0 as usize]) as u64)

    var rounds: u64 = 0
    var last: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    let limit: u64 = arg_rounds(args)
    var first: bool = true
    var last_sum: u64 = 0
    while fuiscene.alive() && rounds < limit {
        rounds = rounds + 1
        let key: u64 = fuiscene.pump()
        if first {
            first = false
            set_cols(K_TP, (&c_prog[0]) as u64)
            set_cols(K_TC, (&c_conn[0]) as u64)
            set_cols(K_TL, (&c_cli[0]) as u64)
        }
        if key >= K_TAB && key < K_TAB + 3 {
            cur_tab = key - K_TAB
            fuiscene.refresh()
        } else if key >= K_B && key < K_B + 6 {
            let id: u64 = key - K_B
            if id < 4 {
                set_view_of_row(fuiscene.table_sel(K_TP), id)
            } else if id == 4 {
                roll_history()
                hist_load()
            } else {
                let on: u64 = ulib.sys(ulib.SYS_SHARE, ulib.SH_ON, 0, 0)
                var v: u64 = 1
                if !ulib.bad(on) && on != 0 {
                    v = 0
                }
                ulib.sys(ulib.SYS_SHARE, ulib.SH_SET, v, 0)
                build_share_line()
                build_clients()
                fuiscene.refresh()
            }
        }
        let now: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
        if now >= last + 50 {
            let rate: u64 = build_programs(now - last)
            last = now
            build_connections()
            build_clients()
            build_graph(rate)
            build_rate(rate)
            let sum: u64 = checksum()
            if sum != last_sum {
                last_sum = sum
                fuiscene.table_set_blob(K_TP, (&b_prog[0]) as u64)
                fuiscene.table_set_blob(K_TC, (&b_conn[0]) as u64)
                fuiscene.table_set_blob(K_TL, (&b_cli[0]) as u64)
                fuiscene.refresh()
            }
        }
    }
    say_state(0, 0, 0)
    return 0
}

fn arg_rounds(args: u64) -> u64 {
    var o_n: [u8; 4] = "-n\0\0"
    let argc: u64 = ulib.arg_count(args)
    var i: u64 = 1
    while i < argc {
        if ulib.streq(ulib.arg_at(args, i), (&o_n[0]) as u64)
            && i + 1 < argc {
            return ulib.to_num(ulib.arg_at(args, i + 1))
        }
        i = i + 1
    }
    return 4000000
}

fn set_view_of_row(row: u64, want: u64) {
    var nm: [u8; 24] = [0 as u8; 24]
    var tn: [u8; 24] = [0 as u8; 24]
    let slot: u64 = slot_of_row(row)
    if slot >= MAXP {
        return
    }
    prog_name(slot, (&nm[0]) as u64)
    var t: u64 = 0
    while t < MAXT {
        if q(ulib.NK_TASK, t, ulib.NT_ALIVE) != 0 {
            task_name(t, (&tn[0]) as u64)
            if same_name((&tn[0]) as u64, (&nm[0]) as u64) {
                let pid: u64 = q(ulib.NK_TASK, t, ulib.NT_PID)
                let r: u64 = nv.view_set(pid, want)
                say_set(pid, want, r)
            }
        }
        t = t + 1
    }
}

fn roll_history() {
    var path: [u8; 13] = "/bin/netstat\0"
    var opt: [u8; 4] = "-w\0\0"
    var argv: [u64; 3] = [0 as u64; 3]
    argv[0] = (&path[0]) as u64
    argv[1] = (&opt[0]) as u64
    argv[2] = 0
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&path[0]) as u64,
        (&argv[0]) as u64, 2)
    if !ulib.bad(pid) {
        ulib.wait_code(pid)
    }
}

fn say_set(pid: u64, want: u64, r: u64) {
    var a: [u8; 17] = "netmon: set pid=\0"
    var b: [u8; 7] = " view=\0"
    var c: [u8; 7] = " rc=\0\0\0"
    lineout.add_text((&a[0]) as u64)
    lineout.add_num(pid)
    lineout.add_text((&b[0]) as u64)
    lineout.add_num(want)
    lineout.add_text((&c[0]) as u64)
    lineout.add_num(r)
    lineout.end_line()
}

fn say_state(tp: u64, tc: u64, tl: u64) {
    var a: [u8; 23] = "netmon: rows programs=\0"
    var b: [u8; 14] = " connections=\0"
    var c: [u8; 11] = " clients=\0\0"
    lineout.add_text((&a[0]) as u64)
    lineout.add_num(rows_of((&b_prog[0]) as u64))
    lineout.add_text((&b[0]) as u64)
    lineout.add_num(rows_of((&b_conn[0]) as u64))
    lineout.add_text((&c[0]) as u64)
    lineout.add_num(rows_of((&b_cli[0]) as u64))
    lineout.end_line()
    var d: [u8; 14] = "netmon: rate \0"
    lineout.add_text((&d[0]) as u64)
    lineout.add_text((&l_rate[0]) as u64)
    lineout.end_line()
    var e: [u8; 15] = "netmon: graph \0"
    lineout.add_text((&e[0]) as u64)
    lineout.add_text((&l_graph[0]) as u64)
    lineout.end_line()
    var f: [u8; 15] = "netmon: share \0"
    lineout.add_text((&f[0]) as u64)
    lineout.add_text((&l_share[0]) as u64)
    lineout.end_line()
    let _a: u64 = tp
    let _b: u64 = tc
    let _c: u64 = tl
}

fn rows_of(p: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while octets.ld8(p, i) != 0 {
        if octets.ld8(p, i) == 10 {
            n = n + 1
        }
        i = i + 1
    }
    if n > 0 {
        return n - 1
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
