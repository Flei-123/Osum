// SPDX-License-Identifier: GPL-2.0-only

profile kernel

import ulib
import instkern
import wunlock

export { u_start }

static mut S_USE: [u8; 57] = "install TARGET [--quelle DEVICE] [--esp SECTORS] [--ja]\0\0"
static mut S_DISKS: [u8; 22] = "Disks of this machine\0"
static mut S_TARGET: [u8; 9] = "target \0\0"
static mut S_SOURCE: [u8; 9] = "source \0\0"
static mut S_NOOPEN: [u8; 22] = "install: no access to\0"
static mut S_TOO_SMALL: [u8; 25] = "install: disk too small\0\0"
static mut S_PROBE: [u8; 28] = "install: source is not OFS\0\0"
static mut S_DRY_RUN: [u8; 37] = "install: dry run, nothing is written\0"
static mut S_SECTORS: [u8; 11] = "  sectors=\0"
static mut S_ESP: [u8; 8] = "  esp=\0\0"
static mut S_ROOT: [u8; 8] = "  root=\0"
static mut S_AT: [u8; 6] = " at \0\0"
static mut S_GPT: [u8; 18] = "install: gpt ok\0\0\0"
static mut S_FAT: [u8; 20] = "install: fat32 ok\0\0\0"
static mut S_COPIED: [u8; 19] = "install: copied=\0\0\0"
static mut S_GROW: [u8; 18] = "install: grown=\0\0\0"
static mut S_DONE: [u8; 18] = "install: done\0\0\0\0\0"
static mut S_ERROR_AT: [u8; 22] = "install: ERROR at \0\0\0\0"
static mut S_WRITE: [u8; 8] = "write\0\0\0"
static mut S_READ: [u8; 6] = "read\0\0"
static mut S_MNT: [u8; 6] = "mount\0"
static mut S_MKD: [u8; 6] = "mkdir\0"
static mut S_COPY: [u8; 5] = "copy\0"
static mut S_MAP_BLOCKS: [u8; 30] = "install: too few map blocks\0\0\0"

static mut D_HDA: [u8; 10] = "/dev/hda\0\0"
static mut D_HDB: [u8; 10] = "/dev/hdb\0\0"
static mut D_RAM0: [u8; 10] = "/dev/ram0\0"
static mut D_NVME: [u8; 12] = "/dev/nvme0\0\0"

static mut O_YES: [u8; 6] = "--ja\0\0"
static mut O_SOURCE: [u8; 10] = "--quelle\0\0"
static mut O_ESP: [u8; 8] = "--esp\0\0\0"
static mut O_CRYPT: [u8; 10] = "--crypt\0\0\0"
static mut S_CRYPT: [u8; 21] = "install: encrypted\0\0\0"

static mut P_EFI: [u8; 6] = "/efi\0\0"
static mut P_EFI_EFI: [u8; 10] = "/efi/EFI\0\0"
static mut P_EFI_BOOT: [u8; 16] = "/efi/EFI/BOOT\0\0\0"
static mut P_EFI_LIM: [u8; 20] = "/efi/limine.conf\0\0\0\0"
static mut P_EFI_KERN: [u8; 16] = "/efi/osum.mb\0\0\0\0"
static mut P_EFI_LDR: [u8; 28] = "/efi/EFI/BOOT/BOOTX64.EFI\0\0\0"
static mut P_SRC_LIM: [u8; 20] = "/boot/limine.conf\0\0\0"
static mut P_SRC_KERN: [u8; 16] = "/boot/osum.mb\0\0\0"
static mut P_SRC_LDR: [u8; 20] = "/boot/BOOTX64.EFI\0\0\0"
static mut T_VFAT: [u8; 6] = "vfat\0\0"
static mut D_HDA1: [u8; 10] = "/dev/hda1\0"

const BS: u64 = 512

const ESP_DEFAULT: u64 = 70000

fn err(was: u64) -> u64 {
    ulib.say((&S_ERROR_AT[0 as usize]) as u64)
    ulib.say(was)
    ulib.nl()
    wunlock.relock()
    return 1
}

fn line(txt: u64, v: u64) {
    ulib.say(txt)
    ulib.sayu(v)
    ulib.nl()
}

fn disk_show(name: u64) {
    let n: u64 = ulib.size_of(name)
    if ulib.bad(n) {
        return
    }
    ulib.say(name)
    ulib.say((&S_SECTORS[0 as usize]) as u64)
    ulib.sayu(n / BS)
    ulib.nl()
}

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.say((&S_DISKS[0 as usize]) as u64)
        ulib.nl()
        disk_show((&D_HDA[0 as usize]) as u64)
        disk_show((&D_HDB[0 as usize]) as u64)
        disk_show((&D_RAM0[0 as usize]) as u64)
        disk_show((&D_NVME[0 as usize]) as u64)
        ulib.say((&S_USE[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    let dest_buf: u64 = ulib.arg_at(args, 1)
    var source: u64 = (&D_RAM0[0 as usize]) as u64
    var esp_sector: u64 = ESP_DEFAULT
    var yes: bool = false
    var cpw: u64 = 0
    var i: u64 = 2
    while i < argc {
        let a: u64 = ulib.arg_at(args, i)
        if ulib.streq(a, (&O_YES[0 as usize]) as u64) {
            yes = true
        } else if ulib.streq(a, (&O_SOURCE[0 as usize]) as u64) && i + 1 < argc {
            i = i + 1
            source = ulib.arg_at(args, i)
        } else if ulib.streq(a, (&O_ESP[0 as usize]) as u64) && i + 1 < argc {
            i = i + 1
            esp_sector = ulib.to_num(ulib.arg_at(args, i))
        } else if ulib.streq(a, (&O_CRYPT[0 as usize]) as u64) && i + 1 < argc {

            i = i + 1
            cpw = ulib.arg_at(args, i)
        }
        i = i + 1
    }

    if yes && wunlock.protected(dest_buf) {
        wunlock.refuse(dest_buf)
        return 1
    }

    let dst_fd: u64 = ulib.sys(ulib.SYS_OPEN, dest_buf, ulib.O_RDWR, 0)
    if ulib.bad(dst_fd) {
        ulib.esay_line((&S_NOOPEN[0 as usize]) as u64, dest_buf)
        return 1
    }
    let src_fd: u64 = ulib.sys(ulib.SYS_OPEN, source, 0, 0)
    if ulib.bad(src_fd) {
        ulib.esay_line((&S_NOOPEN[0 as usize]) as u64, source)
        return 1
    }
    let sect_count: u64 = ulib.size_of(dest_buf) / BS
    let src_sect: u64 = ulib.size_of(source) / BS

    let last_block: u64 = instkern.plan_ofs_end(sect_count)
    let esp_start: u64 = instkern.plan_esp_start()
    if !instkern.plan_fits(sect_count, esp_sector) {
        ulib.say((&S_TOO_SMALL[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    let esp_end: u64 = instkern.plan_esp_end(esp_sector)
    let ofs_start: u64 = instkern.plan_ofs_start(esp_sector)
    let ofs_end: u64 = last_block
    let ofs_blocks: u64 = ofs_end - ofs_start + 1

    ulib.say((&S_TARGET[0 as usize]) as u64)
    ulib.say(dest_buf)
    ulib.say((&S_SECTORS[0 as usize]) as u64)
    ulib.sayu(sect_count)
    ulib.nl()
    ulib.say((&S_SOURCE[0 as usize]) as u64)
    ulib.say(source)
    ulib.say((&S_SECTORS[0 as usize]) as u64)
    ulib.sayu(src_sect)
    ulib.nl()
    ulib.say((&S_ESP[0 as usize]) as u64)
    ulib.sayu(esp_sector)
    ulib.say((&S_AT[0 as usize]) as u64)
    ulib.sayu(esp_start)
    ulib.nl()
    ulib.say((&S_ROOT[0 as usize]) as u64)
    ulib.sayu(ofs_blocks)
    ulib.say((&S_AT[0 as usize]) as u64)
    ulib.sayu(ofs_start)
    ulib.nl()

    let src_map_blocks: u64 = instkern.check_source(src_fd)
    if src_map_blocks == 0 {
        if instkern.error_at() == instkern.F_NO_OFS {
            ulib.say((&S_PROBE[0 as usize]) as u64)
            ulib.nl()
            return 1
        }
        return err((&S_READ[0 as usize]) as u64)
    }
    if !yes {
        ulib.say((&S_DRY_RUN[0 as usize]) as u64)
        ulib.nl()
        return 0
    }

    if !wunlock.confirm_unlock(dst_fd, dest_buf, args, argc) {
        return 1
    }

    if !instkern.gpt_write(dst_fd, sect_count, esp_sector) {
        return err((&S_WRITE[0 as usize]) as u64)
    }
    ulib.say((&S_GPT[0 as usize]) as u64)
    ulib.nl()

    if !instkern.fat32_create(dst_fd, esp_start, esp_sector) {
        return err((&S_WRITE[0 as usize]) as u64)
    }
    ulib.say((&S_FAT[0 as usize]) as u64)
    ulib.nl()

    if src_map_blocks * BS * 8 < ofs_blocks && src_map_blocks * BS * 8 < src_sect {
        ulib.say((&S_MAP_BLOCKS[0 as usize]) as u64)
        ulib.nl()
    }
    if cpw != 0 {
        if !instkern.crypt_begin(dst_fd, ofs_start, ofs_blocks, cpw, ulib.length(cpw)) {
            return err((&S_WRITE[0 as usize]) as u64)
        }
        ulib.say((&S_CRYPT[0 as usize]) as u64)
        ulib.nl()
    }
    let cry_off: u64 = instkern.crypt_off()
    if !instkern.copy_root_from(dst_fd, src_fd, ofs_start + cry_off, src_sect) {
        if instkern.error_at() == instkern.F_READ {
            return err((&S_READ[0 as usize]) as u64)
        }
        return err((&S_WRITE[0 as usize]) as u64)
    }
    line((&S_COPIED[0 as usize]) as u64, src_sect)

    let new_size: u64 = instkern.grow(dst_fd, ofs_start + cry_off, ofs_blocks - cry_off)
    if new_size == 0 {
        return err((&S_WRITE[0 as usize]) as u64)
    }
    line((&S_GROW[0 as usize]) as u64, new_size)
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)

    ulib.sys(ulib.SYS_MKDIR, (&P_EFI[0 as usize]) as u64, 0, 0)
    let m: u64 = ulib.sys4(ulib.SYS_VMOUNT, (&D_HDA1[0 as usize]) as u64,
        (&P_EFI[0 as usize]) as u64, (&T_VFAT[0 as usize]) as u64, 0)
    if ulib.bad(m) {
        return err((&S_MNT[0 as usize]) as u64)
    }
    let r1: u64 = ulib.sys(ulib.SYS_MKDIR, (&P_EFI_EFI[0 as usize]) as u64, 0, 0)
    if ulib.bad(r1) {
        ulib.sayn(r1)
        ulib.nl()
        return err((&S_MKD[0 as usize]) as u64)
    }
    let r2: u64 = ulib.sys(ulib.SYS_MKDIR, (&P_EFI_BOOT[0 as usize]) as u64, 0, 0)
    if ulib.bad(r2) {
        ulib.sayn(r2)
        ulib.nl()
        return err((&S_MKD[0 as usize]) as u64)
    }
    if !instkern.copy_file((&P_SRC_LDR[0 as usize]) as u64,
        (&P_EFI_LDR[0 as usize]) as u64) {
        return err((&S_COPY[0 as usize]) as u64)
    }
    if !instkern.copy_file(instkern.kernel_source(),
        (&P_EFI_KERN[0 as usize]) as u64) {
        return err((&S_COPY[0 as usize]) as u64)
    }
    if !instkern.copy_file((&P_SRC_LIM[0 as usize]) as u64,
        (&P_EFI_LIM[0 as usize]) as u64) {
        return err((&S_COPY[0 as usize]) as u64)
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.sys(ulib.SYS_UMOUNT2, (&P_EFI[0 as usize]) as u64, 0, 0)
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    wunlock.relock()
    ulib.say((&S_DONE[0 as usize]) as u64)
    ulib.nl()
    return 0
}
