profile kernel

export { p_conf, p_pw, p_info, p_state, p_home, p_ld, p_lib, p_host, p_log, n_taskbar, p_pkg_dir }

static mut P_CONF: [u8; 18] = "/etc/xremote.conf\0"
static mut P_PW: [u8; 16] = "/run/xremote.pw\0"
static mut P_INFO: [u8; 18] = "/run/xremote.info\0"
static mut P_STATE: [u8; 19] = "/run/xremote.state\0"
static mut P_HOME: [u8; 13] = "/run/xremote\0"
static mut P_LD: [u8; 42] = "/apps/xremote.osp/lib/ld-musl-x86_64.so.1\0"
static mut P_LIB: [u8; 22] = "/apps/xremote.osp/lib\0"
static mut P_HOST: [u8; 38] = "/apps/xremote.osp/bin/freeviewer-host\0"
static mut P_LOG: [u8; 21] = "/var/log/xremote.log\0"
static mut P_PKG: [u8; 18] = "/apps/xremote.osp\0"
static mut N_TASKBAR: [u8; 8] = "taskbar\0"

fn p_conf() -> u64 {
    return (&P_CONF[0 as usize]) as u64
}

fn p_pw() -> u64 {
    return (&P_PW[0 as usize]) as u64
}

fn p_info() -> u64 {
    return (&P_INFO[0 as usize]) as u64
}

fn p_state() -> u64 {
    return (&P_STATE[0 as usize]) as u64
}

fn p_home() -> u64 {
    return (&P_HOME[0 as usize]) as u64
}

fn p_ld() -> u64 {
    return (&P_LD[0 as usize]) as u64
}

fn p_lib() -> u64 {
    return (&P_LIB[0 as usize]) as u64
}

fn p_host() -> u64 {
    return (&P_HOST[0 as usize]) as u64
}

fn p_log() -> u64 {
    return (&P_LOG[0 as usize]) as u64
}

fn p_pkg_dir() -> u64 {
    return (&P_PKG[0 as usize]) as u64
}

fn n_taskbar() -> u64 {
    return (&N_TASKBAR[0 as usize]) as u64
}
