profile kernel

import ulib
import pw
import instaccount
import reset.resetrun

export { u_start }

const E_USAGE: u64 = 2
const PASS_MAX: u64 = 128

static mut a_ja: [u8; 5] = "--ja\0"
static mut a_name: [u8; 7] = "--name\0"
static mut a_confirm: [u8; 10] = "--confirm\0"
static mut a_reboot: [u8; 9] = "--reboot\0"
static mut w_settings: [u8; 9] = "settings\0"
static mut w_system: [u8; 7] = "system\0"
static mut w_reset: [u8; 6] = "RESET\0"
static mut p_reboot: [u8; 12] = "/bin/reboot\0"
static mut n_reboot: [u8; 7] = "reboot\0"
static mut s_use: [u8; 96] = "usage: resetsys settings [--ja] | resetsys system --name NAME --confirm RESET [--ja] [--reboot]\0"
static mut s_dry: [u8; 39] = "resetsys: dry run, nothing was changed\0"
static mut s_unconfirmed: [u8; 41] = "resetsys: not confirmed, nothing changed\0"
static mut s_ok: [u8; 13] = "resetsys: ok\0"
static mut s_err: [u8; 17] = "resetsys: error \0"
static mut s_prompt: [u8; 11] = "password: \0"
static mut pass_buf: [u8; 128] = [0 as u8; 128]

fn has_flag(args: u64, flag: u64) -> bool {
    var i: u64 = 1
    while i < ulib.arg_count(args) {
        if ulib.streq(ulib.arg_at(args, i), flag) {
            return true
        }
        i = i + 1
    }
    return false
}

fn value_of(args: u64, flag: u64) -> u64 {
    var i: u64 = 1
    while i + 1 < ulib.arg_count(args) {
        if ulib.streq(ulib.arg_at(args, i), flag) {
            return ulib.arg_at(args, i + 1)
        }
        i = i + 1
    }
    return 0
}

fn finish(rc: u64, reboot: bool) -> u64 {
    if rc != resetrun.OK {
        ulib.say((&s_err[0]) as u64)
        ulib.sayu(rc)
        ulib.nl()
        return rc
    }
    ulib.say((&s_ok[0]) as u64)
    ulib.nl()
    if reboot {
        var argv: [u64; 2] = [0 as u64; 2]
        argv[0] = (&n_reboot[0]) as u64
        ulib.sys(ulib.SYS_EXEC, (&p_reboot[0]) as u64, (&argv[0]) as u64, 1)
    }
    return resetrun.OK
}

fn run_system_cmd(args: u64) -> u64 {
    let name: u64 = value_of(args, (&a_name[0]) as u64)
    let confirm: u64 = value_of(args, (&a_confirm[0]) as u64)
    if name == 0 || confirm == 0 || !ulib.streq(confirm, (&w_reset[0]) as u64) {
        ulib.say((&s_unconfirmed[0]) as u64)
        ulib.nl()
        return resetrun.E_NOT_CONFIRMED
    }
    if !has_flag(args, (&a_ja[0]) as u64) {
        ulib.say((&s_dry[0]) as u64)
        ulib.nl()
        return resetrun.OK
    }
    pw.read_pass((&s_prompt[0]) as u64, (&pass_buf[0]) as u64, PASS_MAX)
    return finish(resetrun.run_system(name, (&pass_buf[0]) as u64), has_flag(args, (&a_reboot[0]) as u64))
}

fn u_start(args: u64) -> u64 {
    if ulib.arg_count(args) < 2 {
        ulib.say((&s_use[0]) as u64)
        ulib.nl()
        return E_USAGE
    }
    let verb: u64 = ulib.arg_at(args, 1)
    if ulib.streq(verb, (&w_settings[0]) as u64) {
        if !has_flag(args, (&a_ja[0]) as u64) {
            ulib.say((&s_dry[0]) as u64)
            ulib.nl()
            return resetrun.OK
        }
        return finish(resetrun.run_settings(), false)
    }
    if ulib.streq(verb, (&w_system[0]) as u64) {
        return run_system_cmd(args)
    }
    ulib.say((&s_use[0]) as u64)
    ulib.nl()
    return E_USAGE
}
