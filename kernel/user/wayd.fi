
profile kernel

import ulib
import libc.text
import lineout
import product
import libc.io
import libc.kcall
import wlproto
import utf8
import wl_msg
import wl_input
import wl_data
import wl_frame
import libc.clockapi

export { u_start }

const SYS_READ: u64 = 0
const SYS_WRITE: u64 = 1
const SYS_CLOSE: u64 = 3
const SYS_MUNMAP: u64 = 11
const SYS_POLL: u64 = 7
const SYS_MMAP: u64 = 9
const SYS_SOCKET: u64 = 41
const SYS_ACCEPT: u64 = 43
const SYS_ACCEPT4: u64 = 288
const SYS_SENDMSG: u64 = 46
const SYS_RECVMSG: u64 = 47
const SYS_BIND: u64 = 49
const SYS_LISTEN: u64 = 50
const SYS_UNLINK: u64 = 87
const SYS_NANOSLEEP: u64 = 35

const AF_UNIX: u64 = 1
const SOCK_STREAM: u64 = 1
const PROT_READ: u64 = 1
const PROT_WRITE: u64 = 2
const MAP_SHARED: u64 = 1
const MSG_DONTWAIT: u64 = 64

const WM_CREATE: u64 = 2100
const WM_FILL: u64 = 2101
const WM_EVENT: u64 = 2103
const WM_INFO: u64 = 2104
const WIG_SCREEN: u64 = 1805
const WM_FLUSH: u64 = 2105
const WM_CLOSE: u64 = 2107
const WM_APP: u64 = 2116

const EMPTY_MAX: u64 = 20000

const MAX_CLIENTS: u64 = 4
const MAX_OBJ: u64 = 64
const IN_CAP: u64 = 8192
const OUT_CAP: u64 = 8192

const ID_DISPLAY: u64 = 1

const O_ID: u64 = 0
const O_IFACE: u64 = 1
const O_A: u64 = 2
const O_B: u64 = 3
const O_C: u64 = 4
const O_D: u64 = 5
const O_E: u64 = 6
const O_F: u64 = 7
const O_FIELDS: u64 = 8

static mut objs: [u64; 2048] = [0 as u64; 2048]

static mut c_used: [u64; 4] = [0 as u64; 4]
static mut c_fd: [u64; 4] = [0 as u64; 4]
static mut c_inlen: [u64; 4] = [0 as u64; 4]
static mut c_nextid: [u64; 4] = [0 as u64; 4]
static mut inbuf: [u8; 32768] = [0 as u8; 32768]
static mut outbuf: [u8; 32768] = [0 as u8; 32768]
static mut c_outlen: [u64; 4] = [0 as u64; 4]

static mut n_conn: u64 = 0
static mut n_msgs: u64 = 0
static mut n_bad: u64 = 0
static mut n_wins: u64 = 0
static mut n_commits: u64 = 0
static mut n_fds: u64 = 0

static mut c_kfoc: [u64; 4] = [0 as u64; 4]
static mut c_pfoc: [u64; 4] = [0 as u64; 4]
static mut c_title: [u8; 128] = [0 as u8; 128]
static mut c_appid: [u8; 96] = [0 as u8; 96]
static mut evb: [u64; 2] = [0 as u64; 2]
static mut n_keys: u64 = 0
static mut n_ptr: u64 = 0

fn out_base(c: u64) -> u64 {
    return (&outbuf[(c * OUT_CAP) as usize]) as u64
}

fn in_addr(i: u64) -> u64 {
    return (&inbuf[0 as usize]) as u64 + i
}

fn obj_base(c: u64, i: u64) -> u64 {
    return (c * MAX_OBJ + i) * O_FIELDS
}

fn obj_find(c: u64, id: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_OBJ {
        if objs[(obj_base(c, i) + O_ID) as usize] == id {
            return i
        }
        i = i + 1
    }
    return MAX_OBJ
}

fn obj_new(c: u64, id: u64, iface: u64) -> u64 {
    if obj_find(c, id) < MAX_OBJ {
        return MAX_OBJ
    }
    var i: u64 = 0
    while i < MAX_OBJ {
        let b: u64 = obj_base(c, i)
        if objs[(b + O_ID) as usize] == 0 {
            objs[(b + O_ID) as usize] = id
            objs[(b + O_IFACE) as usize] = iface
            objs[(b + O_A) as usize] = 0
            objs[(b + O_B) as usize] = 0
            objs[(b + O_C) as usize] = 0
            objs[(b + O_D) as usize] = 0
            objs[(b + O_E) as usize] = 0
            objs[(b + O_F) as usize] = 0
            return i
        }
        i = i + 1
    }
    return MAX_OBJ
}

fn obj_iface(c: u64, id: u64) -> u64 {
    let i: u64 = obj_find(c, id)
    if i >= MAX_OBJ {
        return wlproto.IF_NONE
    }
    return objs[(obj_base(c, i) + O_IFACE) as usize]
}

fn obj_get(c: u64, id: u64, f: u64) -> u64 {
    let i: u64 = obj_find(c, id)
    if i >= MAX_OBJ {
        return 0
    }
    return objs[(obj_base(c, i) + f) as usize]
}

fn obj_set(c: u64, id: u64, f: u64, v: u64) {
    let i: u64 = obj_find(c, id)
    if i < MAX_OBJ {
        objs[(obj_base(c, i) + f) as usize] = v
    }
}

fn obj_drop(c: u64, id: u64) {
    let i: u64 = obj_find(c, id)
    if i < MAX_OBJ {
        objs[(obj_base(c, i) + O_ID) as usize] = 0
    }
}

fn map_users(c: u64, base: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < MAX_OBJ {
        let b: u64 = obj_base(c, i)
        if objs[(b + O_ID) as usize] != 0 {
            let f: u64 = objs[(b + O_IFACE) as usize]
            if f == wlproto.IF_WL_SHM_POOL && objs[(b + O_A) as usize] == base {
                n = n + 1
            }
            if f == wlproto.IF_WL_BUFFER && objs[(b + O_E) as usize] == base {
                n = n + 1
            }
        }
        i = i + 1
    }
    return n
}

fn map_release(c: u64, base: u64, size: u64) {
    if base != 0 && size != 0 && map_users(c, base) == 0 {
        ulib.sys(SYS_MUNMAP, base, size, 0)
    }
}

fn objs_release(c: u64) {
    var i: u64 = 0
    while i < MAX_OBJ {
        let b: u64 = obj_base(c, i)
        if objs[(b + O_ID) as usize] != 0 {
            let f: u64 = objs[(b + O_IFACE) as usize]
            if f == wlproto.IF_WL_SHM_POOL {
                if objs[(b + O_C) as usize] != 0 {
                    ulib.sys(SYS_CLOSE, objs[(b + O_C) as usize], 0, 0)
                    objs[(b + O_C) as usize] = 0
                }
                if objs[(b + O_A) as usize] != 0 {
                    ulib.sys(SYS_MUNMAP, objs[(b + O_A) as usize], objs[(b + O_B) as usize], 0)
                    objs[(b + O_A) as usize] = 0
                }
            }
        }
        i = i + 1
    }
    i = 0
    while i < MAX_OBJ {
        let b: u64 = obj_base(c, i)
        if objs[(b + O_ID) as usize] != 0 && objs[(b + O_IFACE) as usize] == wlproto.IF_WL_BUFFER && objs[(b + O_E) as usize] != 0 {
            let base: u64 = objs[(b + O_E) as usize]
            let size: u64 = objs[(b + O_F) as usize]
            var j: u64 = i
            while j < MAX_OBJ {
                let bj: u64 = obj_base(c, j)
                if objs[(bj + O_ID) as usize] != 0 && objs[(bj + O_IFACE) as usize] == wlproto.IF_WL_BUFFER && objs[(bj + O_E) as usize] == base {
                    objs[(bj + O_E) as usize] = 0
                }
                j = j + 1
            }
            ulib.sys(SYS_MUNMAP, base, size, 0)
        }
        i = i + 1
    }
}

fn rd32(p: u64) -> u64 {
    return (inbuf[p as usize] as u64)
        | ((inbuf[(p + 1) as usize] as u64) << 8)
        | ((inbuf[(p + 2) as usize] as u64) << 16)
        | ((inbuf[(p + 3) as usize] as u64) << 24)
}

fn wr32(p: u64, v: u64) {
    outbuf[p as usize] = (v & 255) as u8
    outbuf[(p + 1) as usize] = ((v >> 8) & 255) as u8
    outbuf[(p + 2) as usize] = ((v >> 16) & 255) as u8
    outbuf[(p + 3) as usize] = ((v >> 24) & 255) as u8
}

static mut ev_pos: u64 = 0

fn ev_begin(c: u64, id: u64, op: u64) -> u64 {
    let p: u64 = c * OUT_CAP + c_outlen[c as usize]
    wr32(p, id)
    wr32(p + 4, op)
    ev_pos = 8
    return p
}

fn ev_arg(c: u64, p: u64, n: u64, v: u64) {
    wr32(p + ev_pos, v)
    ev_pos = ev_pos + 4
}

fn ev_end(c: u64, p: u64, nargs: u64) {
    let len: u64 = ev_pos
    let op: u64 = (outbuf[(p + 4) as usize] as u64)
        | ((outbuf[(p + 5) as usize] as u64) << 8)
    wr32(p + 4, (op & 0xFFFF) | (len << 16))
    c_outlen[c as usize] = c_outlen[c as usize] + len
}

fn ev_str(c: u64, p: u64, n: u64, iface: u64) -> u64 {
    let l: u64 = wlproto.name_len(iface)
    wr32(p + ev_pos, l + 1)
    ev_pos = ev_pos + 4
    var k: u64 = 0
    while k < l {
        outbuf[(p + ev_pos + k) as usize] = wlproto.name_at(iface, k) as u8
        k = k + 1
    }
    let ganz: u64 = (l + 4) & 0xFFFFFFFFFFFFFFFC
    var f: u64 = l
    while f < ganz {
        outbuf[(p + ev_pos + f) as usize] = 0 as u8
        f = f + 1
    }
    ev_pos = ev_pos + ganz
    return 0
}

static mut err_op: u64 = 0
static mut err_x: u64 = 0
static mut err_y: u64 = 0
static mut err_z: u64 = 0
static mut emsg: [u8; 96] = [0 as u8; 96]
static mut emsg_n: u64 = 0

fn emsg_put(ch: u64) {
    if emsg_n < 90 {
        emsg[emsg_n as usize] = ch as u8
        emsg_n = emsg_n + 1
    }
}

fn emsg_num(v: u64) {
    var div: u64 = 1
    while v / div >= 10 {
        div = div * 10
    }
    var rest: u64 = v
    while div > 0 {
        emsg_put(48 + rest / div)
        rest = rest % div
        div = div / 10
    }
}

fn err_note(x: u64, y: u64, z: u64) {
    err_x = x
    err_y = y
    err_z = z
}

fn send_error(c: u64, id: u64, code: u64) {
    emsg_n = 0
    let iface: u64 = obj_iface(c, id)
    var t_er: [u8; 4] = "err\0"
    trace_line((&t_er[0 as usize]) as u64, c, id, iface, err_op * 100 + code)
    if iface < wlproto.IF_COUNT {
        let l: u64 = wlproto.name_len(iface)
        var k: u64 = 0
        while k < l {
            emsg_put(wlproto.name_at(iface, k))
            k = k + 1
        }
    } else {
        emsg_put(63)
    }
    emsg_put(46)
    emsg_put(111)
    emsg_put(112)
    emsg_num(err_op)
    emsg_put(32)
    emsg_put(99)
    emsg_put(111)
    emsg_put(100)
    emsg_put(101)
    emsg_put(32)
    emsg_num(code)
    if err_x != 0 || err_y != 0 || err_z != 0 {
        emsg_put(32)
        emsg_num(err_x)
        emsg_put(47)
        emsg_num(err_y)
        emsg_put(47)
        emsg_num(err_z)
        err_x = 0
        err_y = 0
        err_z = 0
    }
    let p: u64 = ev_begin(c, ID_DISPLAY, 0)
    ev_arg(c, p, 0, id)
    ev_arg(c, p, 1, code)
    wr32(p + ev_pos, emsg_n + 1)
    ev_pos = ev_pos + 4
    var q: u64 = 0
    while q < emsg_n {
        outbuf[(p + ev_pos + q) as usize] = emsg[q as usize]
        q = q + 1
    }
    let ganz: u64 = (emsg_n + 4) & 0xFFFFFFFFFFFFFFFC
    var f: u64 = emsg_n
    while f < ganz {
        outbuf[(p + ev_pos + f) as usize] = 0 as u8
        f = f + 1
    }
    ev_pos = ev_pos + ganz
    ev_end(c, p, 3)
    n_bad = n_bad + 1
}

fn send_delete_id(c: u64, id: u64) {
    let p: u64 = ev_begin(c, ID_DISPLAY, 1)
    ev_arg(c, p, 0, id)
    ev_end(c, p, 1)
}

fn on_display(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_WL_DISPLAY_SYNC {
        let cb: u64 = rd32(argp)
        let p: u64 = ev_begin(c, cb, 0)
        ev_arg(c, p, 0, 0)
        ev_end(c, p, 1)
        send_delete_id(c, cb)
        return
    }
    if op == wlproto.RQ_WL_DISPLAY_GET_REGISTRY {
        let rid: u64 = rd32(argp)
        if obj_new(c, rid, wlproto.IF_WL_REGISTRY) >= MAX_OBJ {
            send_error(c, id, 0)
            return
        }
        announce(c, rid, wlproto.IF_WL_COMPOSITOR)
        announce(c, rid, wlproto.IF_WL_SHM)
        announce(c, rid, wlproto.IF_WL_SEAT)
        announce(c, rid, wlproto.IF_WL_OUTPUT)
        announce(c, rid, wlproto.IF_XDG_WM_BASE)
        announce(c, rid, wlproto.IF_WL_DATA_DEVICE_MANAGER)
        announce(c, rid, wlproto.IF_WL_SUBCOMPOSITOR)
        announce(c, rid, wlproto.IF_WP_VIEWPORTER)
        announce(c, rid, wlproto.IF_ZXDG_DECORATION_MANAGER_V1)
        return
    }
    send_error(c, id, 1)
}

fn announce(c: u64, rid: u64, iface: u64) {
    let p: u64 = ev_begin(c, rid, 0)
    ev_arg(c, p, 0, iface)
    ev_str(c, p, 1, iface)
    ev_arg(c, p, 2, wlproto.version_of(iface))
    ev_end(c, p, 3)
}

fn on_registry(c: u64, id: u64, op: u64, argp: u64) {
    if op != wlproto.RQ_WL_REGISTRY_BIND {
        send_error(c, id, 1)
        return
    }
    let name: u64 = rd32(argp)
    let slen: u64 = rd32(argp + 4)
    let skip: u64 = (slen + 3) & 0xFFFFFFFC
    let nid: u64 = rd32(argp + 4 + 4 + skip + 4)
    var t_bd: [u8; 5] = "bind\0"
    trace_line((&t_bd[0 as usize]) as u64, c, name, rd32(argp + 8 + skip), nid)
    if name >= wlproto.IF_COUNT {
        send_error(c, id, 0)
        return
    }
    if obj_new(c, nid, name) >= MAX_OBJ {
        send_error(c, id, 0)
        return
    }
    if name == wlproto.IF_WL_SHM {
        let p0: u64 = ev_begin(c, nid, 0)
        ev_arg(c, p0, 0, 0)
        ev_end(c, p0, 1)
        let p1: u64 = ev_begin(c, nid, 0)
        ev_arg(c, p1, 0, 1)
        ev_end(c, p1, 1)
    }
    if name == wlproto.IF_WL_SEAT {
        let sver: u64 = rd32(argp + 8 + skip)
        wl_input.seat_bound(c, sver)
        let p: u64 = ev_begin(c, nid, 0)
        ev_arg(c, p, 0, 3)
        ev_end(c, p, 1)
        if sver >= 2 {
            var snm: [u8; 6] = "seat0\0"
            c_outlen[c as usize] = wl_msg.begin(out_base(c), c_outlen[c as usize], nid, wlproto.EV_WL_SEAT_NAME)
            wl_msg.text((&snm[0 as usize]) as u64, 5)
            c_outlen[c as usize] = wl_msg.end()
        }
    }
    if name == wlproto.IF_WL_OUTPUT {
        var w: u64 = ulib.sys(WIG_SCREEN, 0, 0, 0)
        var h: u64 = ulib.sys(WIG_SCREEN, 1, 0, 0)
        if w == 0 || w > 16384 || h == 0 || h > 16384 {
            w = 1024
            h = 768
        }
        var omd: [u8; 5] = "wayd\0"
        c_outlen[c as usize] = wl_msg.begin(out_base(c), c_outlen[c as usize], nid, wlproto.EV_WL_OUTPUT_GEOMETRY)
        wl_msg.arg(0)
        wl_msg.arg(0)
        wl_msg.arg(300)
        wl_msg.arg(200)
        wl_msg.arg(0)
        wl_msg.text(product.product(), text.length(product.product()))
        wl_msg.text((&omd[0 as usize]) as u64, 4)
        wl_msg.arg(0)
        c_outlen[c as usize] = wl_msg.end()
        let pm: u64 = ev_begin(c, nid, 1)
        ev_arg(c, pm, 0, 3)
        ev_arg(c, pm, 1, w)
        ev_arg(c, pm, 2, h)
        ev_arg(c, pm, 3, 60000)
        ev_end(c, pm, 4)
        if rd32(argp + 8 + skip) >= 2 {
            let ps: u64 = ev_begin(c, nid, 3)
            ev_arg(c, ps, 0, 1)
            ev_end(c, ps, 1)
            let pd: u64 = ev_begin(c, nid, 2)
            ev_end(c, pd, 0)
        }
    }
}

fn on_compositor(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_WL_COMPOSITOR_CREATE_SURFACE {
        let sid: u64 = rd32(argp)
        if obj_new(c, sid, wlproto.IF_WL_SURFACE) >= MAX_OBJ {
            send_error(c, id, 0)
        }
        return
    }
    if op == wlproto.RQ_WL_COMPOSITOR_CREATE_REGION {
        let rid: u64 = rd32(argp)
        obj_new(c, rid, wlproto.IF_WL_REGION)
        return
    }
    send_error(c, id, 1)
}

fn on_shm(c: u64, id: u64, op: u64, argp: u64, fd: u64) {
    if op != wlproto.RQ_WL_SHM_CREATE_POOL {
        send_error(c, id, 1)
        return
    }
    let pid: u64 = rd32(argp)
    let size: u64 = rd32(argp + 4)
    if fd == 0 || size == 0 {
        send_error(c, id, 2)
        return
    }
    let addr: u64 = kcall.map_fd(size, PROT_READ | PROT_WRITE,
        MAP_SHARED, fd, 0)
    if addr == 0 || addr > 0xFFFFFFFFFFFF0000 {
        ulib.sys(SYS_CLOSE, fd, 0, 0)
        send_error(c, id, 2)
        return
    }
    if obj_new(c, pid, wlproto.IF_WL_SHM_POOL) >= MAX_OBJ {
        ulib.sys(SYS_MUNMAP, addr, size, 0)
        ulib.sys(SYS_CLOSE, fd, 0, 0)
        send_error(c, id, 0)
        return
    }
    obj_set(c, pid, O_A, addr)
    obj_set(c, pid, O_B, size)
    obj_set(c, pid, O_C, fd)
    n_fds = n_fds + 1
}

fn on_shm_pool(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_WL_SHM_POOL_CREATE_BUFFER {
        let bid: u64 = rd32(argp)
        let off: u64 = rd32(argp + 4)
        let w: u64 = rd32(argp + 8)
        let h: u64 = rd32(argp + 12)
        let stride: u64 = rd32(argp + 16)
        let format: u64 = rd32(argp + 20)
        let base: u64 = obj_get(c, id, O_A)
        let size: u64 = obj_get(c, id, O_B)
        if base == 0 {
            send_error(c, id, 2)
            return
        }
        if format > 1 {
            send_error(c, id, 0)
            return
        }
        if h == 0 || w == 0 || stride < w * 4 {
            send_error(c, id, 1)
            return
        }
        if h > 4096 || stride > 65536 {
            send_error(c, id, 1)
            return
        }
        if w == 0 || w > 16384 || w * 4 > stride {
            send_error(c, id, 1)
            return
        }
        if off > size || (h * stride) > (size - off) {
            err_note(off, size, h * stride)
            send_error(c, id, 1)
            return
        }
        if obj_new(c, bid, wlproto.IF_WL_BUFFER) >= MAX_OBJ {
            send_error(c, id, 0)
            return
        }
        obj_set(c, bid, O_A, base + off)
        obj_set(c, bid, O_B, w)
        obj_set(c, bid, O_C, h)
        obj_set(c, bid, O_D, stride)
        obj_set(c, bid, O_E, base)
        obj_set(c, bid, O_F, size)
        return
    }
    if op == wlproto.RQ_WL_SHM_POOL_DESTROY {
        let pbase: u64 = obj_get(c, id, O_A)
        let psize: u64 = obj_get(c, id, O_B)
        let pfd: u64 = obj_get(c, id, O_C)
        obj_drop(c, id)
        if pfd != 0 {
            ulib.sys(SYS_CLOSE, pfd, 0, 0)
        }
        map_release(c, pbase, psize)
        return
    }
    if op == wlproto.RQ_WL_SHM_POOL_RESIZE {
        let nsize: u64 = rd32(argp)
        let osize: u64 = obj_get(c, id, O_B)
        let fd: u64 = obj_get(c, id, O_C)
        if nsize <= osize {
            if nsize < osize {
                err_note(nsize, osize, 0)
                send_error(c, id, 2)
            }
            return
        }
        let naddr: u64 = kcall.map_fd(nsize, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0)
        if naddr == 0 || naddr > 0xFFFFFFFFFFFF0000 {
            err_note(nsize, osize, 0)
            send_error(c, id, 2)
            return
        }
        let oaddr: u64 = obj_get(c, id, O_A)
        obj_set(c, id, O_A, naddr)
        obj_set(c, id, O_B, nsize)
        map_release(c, oaddr, osize)
        return
    }
    send_error(c, id, 1)
}

static mut dbg_line: [u8; 160] = [0 as u8; 160]
static mut dbg_pos: u64 = 0

fn dbg_s(p: u64) {
    var k: u64 = 0
    while __mmio_read8((p + k) as *mut u8) != 0 as u8 && dbg_pos < 150 {
        dbg_line[dbg_pos as usize] = __mmio_read8((p + k) as *mut u8)
        dbg_pos = dbg_pos + 1
        k = k + 1
    }
}

fn dbg_u(v: u64) {
    var tmp: [u8; 20] = [0 as u8; 20]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        tmp[0 as usize] = 48 as u8
        n = 1
    }
    while x != 0 {
        tmp[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    while n != 0 && dbg_pos < 150 {
        n = n - 1
        dbg_line[dbg_pos as usize] = tmp[n as usize]
        dbg_pos = dbg_pos + 1
    }
}

static mut trace_on: bool = false

fn trace_line(tag: u64, a: u64, b: u64, c: u64, d: u64) {
    if !trace_on {
        return
    }
    var sp: [u8; 2] = " \0"
    var pre: [u8; 12] = "wayd-trace \0"
    dbg_pos = 0
    dbg_s((&pre[0 as usize]) as u64)
    dbg_s(tag)
    dbg_s((&sp[0 as usize]) as u64)
    dbg_u(a)
    dbg_s((&sp[0 as usize]) as u64)
    dbg_u(b)
    dbg_s((&sp[0 as usize]) as u64)
    dbg_u(c)
    dbg_s((&sp[0 as usize]) as u64)
    dbg_u(d)
    dbg_line[dbg_pos as usize] = 10 as u8
    dbg_pos = dbg_pos + 1
    ulib.sys(SYS_WRITE, 1, (&dbg_line[0 as usize]) as u64, dbg_pos)
}

fn dbg_win(c: u64, win: u64) {
    var a: [u8; 16] = "wayd: window c=\0"
    var b: [u8; 4] = " x=\0"
    var d: [u8; 4] = " y=\0"
    var e: [u8; 6] = " inx=\0"
    var f: [u8; 6] = " iny=\0"
    var g: [u8; 4] = " w=\0"
    var h: [u8; 4] = " h=\0"
    dbg_pos = 0
    dbg_s((&a[0 as usize]) as u64)
    dbg_u(c)
    dbg_s((&b[0 as usize]) as u64)
    dbg_u(ulib.sys(WM_INFO, win, 2, 0))
    dbg_s((&d[0 as usize]) as u64)
    dbg_u(ulib.sys(WM_INFO, win, 3, 0))
    dbg_s((&e[0 as usize]) as u64)
    dbg_u(ulib.sys(WM_INFO, win, 16, 0))
    dbg_s((&f[0 as usize]) as u64)
    dbg_u(ulib.sys(WM_INFO, win, 17, 0))
    dbg_s((&g[0 as usize]) as u64)
    dbg_u(ulib.sys(WM_INFO, win, 0, 0))
    dbg_s((&h[0 as usize]) as u64)
    dbg_u(ulib.sys(WM_INFO, win, 1, 0))
    dbg_line[dbg_pos as usize] = 10 as u8
    dbg_pos = dbg_pos + 1
    ulib.sys(SYS_WRITE, 1, (&dbg_line[0 as usize]) as u64, dbg_pos)
}

fn surface_commit(c: u64, sid: u64) {
    if obj_get(c, sid, O_E) != 0 {
        sub_commit(c, sid)
        return
    }
    let bid: u64 = obj_get(c, sid, O_B)
    if bid == 0 {
        return
    }
    let src: u64 = obj_get(c, bid, O_A)
    let w: u64 = obj_get(c, bid, O_B)
    let h: u64 = obj_get(c, bid, O_C)
    let stride: u64 = obj_get(c, bid, O_D)
    if src == 0 || w == 0 || h == 0 {
        return
    }
    var win: u64 = obj_get(c, sid, O_A)
    if win == 0 {
        let xy: u64 = ((60 + c * 220) << 16) | (60 + c * 40)
        let wh: u64 = (w << 16) | h
        var versuch: u64 = 0
        while versuch < 600 && (win == 0
            || win > 0xFFFFFFFFFFFF0000) {
            var tp: u64 = 0
            if c_title[(c * 32) as usize] != 0 as u8 {
                tp = (&c_title[0 as usize]) as u64 + c * 32
            }
            win = kcall.sys4(WM_CREATE, xy, wh, tp, 0)
            if win == 0 || win > 0xFFFFFFFFFFFF0000 {
                ulib.sys(ulib.SYS_YIELD, 0, 0, 0)
                versuch = versuch + 1
            }
        }
        if win == 0 || win > 0xFFFFFFFFFFFF0000 {
            var s_wc: [u8; 14] = "wayd: kein wm\0"
            lineout.add_text((&s_wc[0 as usize]) as u64)
            lineout.end_line()
            return
        }
        obj_set(c, sid, O_A, win)
        n_wins = n_wins + 1
        dbg_win(c, win)
        let ap: u64 = (&c_appid[0 as usize]) as u64 + c * 24
        if c_appid[(c * 24) as usize] != 0 as u8 {
            var al: u64 = 0
            while al < 23 && c_appid[(c * 24 + al) as usize] != 0 as u8 {
                al = al + 1
            }
            ulib.sys(WM_APP, win, ap, al)
        }
    }
    var y: u64 = 0
    while y < h {
        var x: u64 = 0
        while x < w {
            let px: u64 = rd32_at(src + y * stride + x * 4) & 0xFFFFFF
            var run: u64 = 1
            while x + run < w
                && (rd32_at(src + y * stride + (x + run) * 4)
                    & 0xFFFFFF) == px {
                run = run + 1
            }
            fill_colour(win, x, y, run, px)
            x = x + run
        }
        y = y + 1
    }
    sub_paint_all(c, sid, win)
    ulib.sys(WM_FLUSH, win, 0, 0)
    n_commits = n_commits + 1
    let p: u64 = ev_begin(c, bid, 0)
    ev_end(c, p, 0)
    obj_set(c, sid, O_B, 0)
    obj_set(c, sid, O_D, 1)
}

fn fill_colour(win: u64, x: u64, y: u64, run: u64, colour: u64) {
    kcall.sys4(WM_FILL, win, (x << 16) | y, (run << 16) | 1, colour)
}

fn rd32_at(p: u64) -> u64 {
    return (__mmio_read32(p as *mut u32)) as u64
}

fn s32(v: u64) -> i64 {
    var x: i64 = (v & 0xFFFFFFFF) as i64
    if x >= 2147483648 {
        x = x - 4294967296
    }
    return x
}

fn blit_sub(win: u64, src: u64, w: u64, h: u64, stride: u64, ox: i64, oy: i64, cw: u64, ch: u64) {
    var y: u64 = 0
    while y < h {
        let dy: i64 = oy + (y as i64)
        if dy >= 0 && (dy as u64) < ch {
            var x: u64 = 0
            while x < w {
                let dx: i64 = ox + (x as i64)
                let raw: u64 = rd32_at(src + y * stride + x * 4)
                if dx >= 0 && (dx as u64) < cw && (raw >> 24) != 0 {
                    let px: u64 = raw & 0xFFFFFF
                    var run: u64 = 1
                    while x + run < w && (dx + (run as i64)) < (cw as i64)
                        && (rd32_at(src + y * stride + (x + run) * 4) & 0xFFFFFF) == px
                        && (rd32_at(src + y * stride + (x + run) * 4) >> 24) != 0 {
                        run = run + 1
                    }
                    fill_colour(win, dx as u64, dy as u64, run, px)
                    x = x + run
                } else {
                    x = x + 1
                }
            }
        }
        y = y + 1
    }
}

fn sub_obj_of(c: u64, child: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_OBJ {
        let b: u64 = obj_base(c, i)
        if objs[(b + O_ID) as usize] != 0 && objs[(b + O_IFACE) as usize] == wlproto.IF_WL_SUBSURFACE
            && objs[(b + O_A) as usize] == child {
            return objs[(b + O_ID) as usize]
        }
        i = i + 1
    }
    return 0
}

fn root_window(c: u64, sid: u64) -> u64 {
    var cur: u64 = sid
    var hops: u64 = 0
    while hops < 8 {
        let par: u64 = obj_get(c, cur, O_E)
        if par == 0 {
            return obj_get(c, cur, O_A)
        }
        cur = par
        hops = hops + 1
    }
    return 0
}

fn sub_abs(c: u64, sid: u64, want_y: u64) -> i64 {
    var cur: u64 = sid
    var sum: i64 = 0
    var hops: u64 = 0
    while hops < 8 && obj_get(c, cur, O_E) != 0 {
        let so: u64 = sub_obj_of(c, cur)
        if so == 0 {
            return sum
        }
        if want_y != 0 {
            sum = sum + s32(obj_get(c, so, O_D))
        } else {
            sum = sum + s32(obj_get(c, so, O_C))
        }
        cur = obj_get(c, cur, O_E)
        hops = hops + 1
    }
    return sum
}

fn sub_paint(c: u64, child: u64, win: u64) {
    let bid: u64 = obj_get(c, child, O_F)
    if bid == 0 || win == 0 || win > 0xFFFFFFFFFFFF0000 {
        return
    }
    let src: u64 = obj_get(c, bid, O_A)
    let w: u64 = obj_get(c, bid, O_B)
    let h: u64 = obj_get(c, bid, O_C)
    let stride: u64 = obj_get(c, bid, O_D)
    if src == 0 || w == 0 || h == 0 {
        return
    }
    let cw: u64 = ulib.sys(WM_INFO, win, 0, 0)
    let ch: u64 = ulib.sys(WM_INFO, win, 1, 0)
    blit_sub(win, src, w, h, stride, sub_abs(c, child, 0), sub_abs(c, child, 1), cw, ch)
}

fn sub_paint_all(c: u64, par: u64, win: u64) {
    var i: u64 = 0
    while i < MAX_OBJ {
        let b: u64 = obj_base(c, i)
        if objs[(b + O_ID) as usize] != 0 && objs[(b + O_IFACE) as usize] == wlproto.IF_WL_SUBSURFACE
            && objs[(b + O_B) as usize] == par {
            let ch: u64 = objs[(b + O_A) as usize]
            sub_paint(c, ch, win)
            sub_paint_all(c, ch, win)
        }
        i = i + 1
    }
}

fn sub_commit(c: u64, sid: u64) {
    let bid: u64 = obj_get(c, sid, O_B)
    if bid == 0 {
        return
    }
    let old: u64 = obj_get(c, sid, O_F)
    if old != 0 && old != bid {
        let p: u64 = ev_begin(c, old, 0)
        ev_end(c, p, 0)
    }
    obj_set(c, sid, O_F, bid)
    obj_set(c, sid, O_B, 0)
    obj_set(c, sid, O_D, 1)
    let win: u64 = root_window(c, sid)
    if win != 0 {
        sub_paint(c, sid, win)
        ulib.sys(WM_FLUSH, win, 0, 0)
        n_commits = n_commits + 1
    }
}

fn on_subcompositor(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_WL_SUBCOMPOSITOR_DESTROY {
        obj_drop(c, id)
        return
    }
    if op == wlproto.RQ_WL_SUBCOMPOSITOR_GET_SUBSURFACE {
        let nid: u64 = rd32(argp)
        let child: u64 = rd32(argp + 4)
        let par: u64 = rd32(argp + 8)
        if obj_iface(c, child) != wlproto.IF_WL_SURFACE || obj_iface(c, par) != wlproto.IF_WL_SURFACE
            || child == par || obj_get(c, child, O_E) != 0 || obj_get(c, child, O_A) != 0
            || obj_get(c, child, O_C) != 0 {
            send_error(c, id, wlproto.ERR_WL_SUBCOMPOSITOR_BAD_SURFACE)
            return
        }
        if obj_new(c, nid, wlproto.IF_WL_SUBSURFACE) >= MAX_OBJ {
            send_error(c, id, 0)
            return
        }
        obj_set(c, nid, O_A, child)
        obj_set(c, nid, O_B, par)
        obj_set(c, child, O_E, par)
        return
    }
    send_error(c, id, 1)
}

fn on_subsurface(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_WL_SUBSURFACE_SET_POSITION {
        obj_set(c, id, O_C, rd32(argp))
        obj_set(c, id, O_D, rd32(argp + 4))
        return
    }
    if op == wlproto.RQ_WL_SUBSURFACE_DESTROY {
        let child: u64 = obj_get(c, id, O_A)
        if obj_iface(c, child) == wlproto.IF_WL_SURFACE {
            obj_set(c, child, O_E, 0)
        }
        obj_drop(c, id)
        return
    }
}

fn on_viewporter(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_WP_VIEWPORTER_DESTROY {
        obj_drop(c, id)
        return
    }
    if op == wlproto.RQ_WP_VIEWPORTER_GET_VIEWPORT {
        let nid: u64 = rd32(argp)
        let surf: u64 = rd32(argp + 4)
        if obj_iface(c, surf) != wlproto.IF_WL_SURFACE {
            send_error(c, id, wlproto.ERR_WP_VIEWPORT_NO_SURFACE)
            return
        }
        if obj_new(c, nid, wlproto.IF_WP_VIEWPORT) >= MAX_OBJ {
            send_error(c, id, 0)
            return
        }
        return
    }
    send_error(c, id, 1)
}

fn on_viewport(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_WP_VIEWPORT_DESTROY {
        obj_drop(c, id)
    }
}

fn deco_configure(c: u64, id: u64) {
    let p: u64 = ev_begin(c, id, wlproto.EV_ZXDG_TOPLEVEL_DECORATION_V1_CONFIGURE)
    ev_arg(c, p, 0, 2)
    ev_end(c, p, 1)
}

fn on_deco_manager(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_ZXDG_DECORATION_MANAGER_V1_DESTROY {
        obj_drop(c, id)
        return
    }
    if op == wlproto.RQ_ZXDG_DECORATION_MANAGER_V1_GET_TOPLEVEL_DECORATION {
        let nid: u64 = rd32(argp)
        let top: u64 = rd32(argp + 4)
        if obj_iface(c, top) != wlproto.IF_XDG_TOPLEVEL {
            send_error(c, id, 0)
            return
        }
        if obj_new(c, nid, wlproto.IF_ZXDG_TOPLEVEL_DECORATION_V1) >= MAX_OBJ {
            send_error(c, id, 0)
            return
        }
        deco_configure(c, nid)
        return
    }
    send_error(c, id, 1)
}

fn on_deco(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_ZXDG_TOPLEVEL_DECORATION_V1_DESTROY {
        obj_drop(c, id)
        return
    }
    deco_configure(c, id)
}

fn send_frame_done(c: u64, cb: u64) {
    let p: u64 = ev_begin(c, cb, 0)
    ev_arg(c, p, 0, wl_frame.due_time())
    ev_end(c, p, 1)
    send_delete_id(c, cb)
}

fn release_frame_callbacks() {
    if !wl_frame.open_gate() {
        return
    }
    var c: u64 = 0
    while c < MAX_CLIENTS {
        if c_used[c as usize] != 0 {
            var cb: u64 = wl_frame.take_due(c)
            while cb != 0 {
                send_frame_done(c, cb)
                cb = wl_frame.take_due(c)
            }
        }
        c = c + 1
    }
}

fn on_surface(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_WL_SURFACE_ATTACH {
        obj_set(c, id, O_B, rd32(argp))
        return
    }
    if op == wlproto.RQ_WL_SURFACE_DAMAGE {
        return
    }
    if op == wlproto.RQ_WL_SURFACE_COMMIT {
        surface_commit(c, id)
        wl_frame.commit(c, id)
        return
    }
    if op == wlproto.RQ_WL_SURFACE_FRAME {
        let cb: u64 = rd32(argp)
        if !wl_frame.request(c, id, cb) {
            send_frame_done(c, cb)
        }
        return
    }
    if op == wlproto.RQ_WL_SURFACE_DESTROY {
        wl_frame.drop_surface(c, id)
        let held: u64 = obj_get(c, id, O_F)
        if held != 0 {
            let ph: u64 = ev_begin(c, held, 0)
            ev_end(c, ph, 0)
        }
        let win: u64 = obj_get(c, id, O_A)
        if win != 0 {
            ulib.sys(WM_CLOSE, win, 0, 0)
        }
        wl_input.surf_drop(c, id)
        obj_drop(c, id)
        return
    }
}

fn on_xdg_wm_base(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_XDG_WM_BASE_GET_XDG_SURFACE {
        let xid: u64 = rd32(argp)
        let sid: u64 = rd32(argp + 4)
        if obj_new(c, xid, wlproto.IF_XDG_SURFACE) >= MAX_OBJ {
            send_error(c, id, 0)
            return
        }
        obj_set(c, xid, O_A, sid)
        obj_set(c, sid, O_C, xid)
        return
    }
    if op == wlproto.RQ_XDG_WM_BASE_PONG {
        return
    }
    if op == wlproto.RQ_XDG_WM_BASE_DESTROY {
        obj_drop(c, id)
        return
    }
    if op == wlproto.RQ_XDG_WM_BASE_CREATE_POSITIONER {
        obj_new(c, rd32(argp), wlproto.IF_NONE)
        return
    }
    send_error(c, id, 1)
}

static mut next_serial: u64 = 1
static mut dbg: u64 = 1

fn on_xdg_surface(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_XDG_SURFACE_GET_TOPLEVEL {
        let tid: u64 = rd32(argp)
        if obj_new(c, tid, wlproto.IF_XDG_TOPLEVEL) >= MAX_OBJ {
            send_error(c, id, 0)
            return
        }
        obj_set(c, tid, O_A, id)
        obj_set(c, id, O_B, tid)
        let pt: u64 = ev_begin(c, tid, 0)
        ev_arg(c, pt, 0, 0)
        ev_arg(c, pt, 1, 0)
        ev_arg(c, pt, 2, 0)
        ev_end(c, pt, 3)
        let ps: u64 = ev_begin(c, id, 0)
        ev_arg(c, ps, 0, next_serial)
        ev_end(c, ps, 1)
        next_serial = next_serial + 1
        return
    }
    if op == wlproto.RQ_XDG_SURFACE_ACK_CONFIGURE {
        return
    }
    if op == wlproto.RQ_XDG_SURFACE_SET_WINDOW_GEOMETRY {
        return
    }
    if op == wlproto.RQ_XDG_SURFACE_DESTROY {
        obj_drop(c, id)
        return
    }
    send_error(c, id, 1)
}

fn on_xdg_toplevel(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_XDG_TOPLEVEL_DESTROY {
        obj_drop(c, id)
        return
    }
    if op == wlproto.RQ_XDG_TOPLEVEL_SET_TITLE {
        str_arg(argp, (&c_title[0 as usize]) as u64 + c * 32, 32)
        return
    }
    if op == wlproto.RQ_XDG_TOPLEVEL_SET_APP_ID {
        str_arg(argp, (&c_appid[0 as usize]) as u64 + c * 24, 24)
        return
    }
}

fn dispatch(c: u64, at: u64, len: u64, fd: u64) -> bool {
    let base: u64 = c * IN_CAP
    let id: u64 = rd32(base + at)
    let w1: u64 = rd32(base + at + 4)
    let op: u64 = w1 & 0xFFFF
    let argp: u64 = base + at + 8
    let iface: u64 = obj_iface(c, id)
    if iface >= wlproto.IF_COUNT {
        send_error(c, id, 0)
        return false
    }
    if op >= wlproto.req_count(iface) {
        send_error(c, id, 1)
        return false
    }
    n_msgs = n_msgs + 1
    var t_rq: [u8; 3] = "rq\0"
    trace_line((&t_rq[0 as usize]) as u64, c, id, iface, op)
    if iface == wlproto.IF_WL_DISPLAY {
        on_display(c, id, op, argp)
    } else if iface == wlproto.IF_WL_REGISTRY {
        on_registry(c, id, op, argp)
    } else if iface == wlproto.IF_WL_COMPOSITOR {
        on_compositor(c, id, op, argp)
    } else if iface == wlproto.IF_WL_SHM {
        on_shm(c, id, op, argp, fd)
    } else if iface == wlproto.IF_WL_SHM_POOL {
        on_shm_pool(c, id, op, argp)
    } else if iface == wlproto.IF_WL_SURFACE {
        on_surface(c, id, op, argp)
    } else if iface == wlproto.IF_WL_SUBCOMPOSITOR {
        on_subcompositor(c, id, op, argp)
    } else if iface == wlproto.IF_WL_SUBSURFACE {
        on_subsurface(c, id, op, argp)
    } else if iface == wlproto.IF_WP_VIEWPORTER {
        on_viewporter(c, id, op, argp)
    } else if iface == wlproto.IF_WP_VIEWPORT {
        on_viewport(c, id, op, argp)
    } else if iface == wlproto.IF_ZXDG_DECORATION_MANAGER_V1 {
        on_deco_manager(c, id, op, argp)
    } else if iface == wlproto.IF_ZXDG_TOPLEVEL_DECORATION_V1 {
        on_deco(c, id, op, argp)
    } else if iface == wlproto.IF_XDG_WM_BASE {
        on_xdg_wm_base(c, id, op, argp)
    } else if iface == wlproto.IF_XDG_SURFACE {
        on_xdg_surface(c, id, op, argp)
    } else if iface == wlproto.IF_XDG_TOPLEVEL {
        on_xdg_toplevel(c, id, op, argp)
    } else if iface == wlproto.IF_WL_BUFFER {
        if op == 0 {
            let ebase: u64 = obj_get(c, id, O_E)
            let esize: u64 = obj_get(c, id, O_F)
            obj_drop(c, id)
            map_release(c, ebase, esize)
        }
    } else if iface == wlproto.IF_WL_SEAT {
        on_seat(c, id, op, argp)
    } else if iface == wlproto.IF_WL_KEYBOARD {
        if op == wlproto.RQ_WL_KEYBOARD_RELEASE {
            wl_input.keyboard_gone(c, id)
            obj_drop(c, id)
        }
    } else if iface == wlproto.IF_WL_POINTER {
        if op == wlproto.RQ_WL_POINTER_RELEASE {
            wl_input.pointer_gone(c, id)
            obj_drop(c, id)
        }
    } else if iface == wlproto.IF_WL_DATA_DEVICE_MANAGER {
        wl_data.on_manager(c, id, op, in_addr(argp))
        data_sync()
    } else if iface == wlproto.IF_WL_DATA_DEVICE {
        wl_data.on_device(c, id, op, in_addr(argp))
        data_sync()
        if op == wlproto.RQ_WL_DATA_DEVICE_RELEASE {
            obj_drop(c, id)
        }
    } else if iface == wlproto.IF_WL_DATA_SOURCE {
        wl_data.on_source(c, id, op, in_addr(argp))
        data_sync()
        if op == wlproto.RQ_WL_DATA_SOURCE_DESTROY {
            obj_drop(c, id)
        }
    } else if iface == wlproto.IF_WL_DATA_OFFER {
        wl_data.on_offer(c, id, op, in_addr(argp), fd)
        data_sync()
        if op == wlproto.RQ_WL_DATA_OFFER_DESTROY {
            obj_drop(c, id)
        }
    }
    return true
}

fn data_sync() {
    var i: u64 = 0
    while i < wl_data.nq_count() {
        obj_new(wl_data.nq_client(i), wl_data.nq_id(i), wl_data.nq_iface(i))
        i = i + 1
    }
    wl_data.nq_clear()
    i = 0
    while i < wl_data.fm_count() {
        send_fd_msg(wl_data.fm_client(i), wl_data.fm_ptr(i), wl_data.fm_len(i), wl_data.fm_fd(i))
        ulib.sys(SYS_CLOSE, wl_data.fm_fd(i), 0, 0)
        i = i + 1
    }
    wl_data.fm_clear()
}

fn on_seat(c: u64, id: u64, op: u64, argp: u64) {
    if op == wlproto.RQ_WL_SEAT_GET_POINTER {
        let nid: u64 = rd32(argp)
        if obj_new(c, nid, wlproto.IF_WL_POINTER) >= MAX_OBJ {
            send_error(c, id, 0)
            return
        }
        if !wl_input.pointer_new(c, nid) {
            obj_drop(c, nid)
            send_error(c, id, 0)
            return
        }
        c_pfoc[c as usize] = 0
        return
    }
    if op == wlproto.RQ_WL_SEAT_GET_KEYBOARD {
        let nid: u64 = rd32(argp)
        if obj_new(c, nid, wlproto.IF_WL_KEYBOARD) >= MAX_OBJ {
            send_error(c, id, 0)
            return
        }
        if !wl_input.keyboard_new(c, nid) {
            obj_drop(c, nid)
            send_error(c, id, 0)
            return
        }
        c_kfoc[c as usize] = 0
        send_keymap(c, nid)
        c_outlen[c as usize] = wl_input.keyboard_ready(c, out_base(c), c_outlen[c as usize])
        var so: u64 = 0
        while so < MAX_OBJ {
            let sb: u64 = obj_base(c, so)
            if objs[(sb + O_ID) as usize] != 0 && objs[(sb + O_IFACE) as usize] == wlproto.IF_WL_SURFACE {
                let sid: u64 = objs[(sb + O_ID) as usize]
                c_outlen[c as usize] = wl_input.sync_focus(c, sid, objs[(sb + O_A) as usize],
                    out_base(c), c_outlen[c as usize])
            }
            so = so + 1
        }
        return
    }
    if op == wlproto.RQ_WL_SEAT_GET_TOUCH {
        obj_new(c, rd32(argp), wlproto.IF_NONE)
        return
    }
}

fn str_arg(argp: u64, out: u64, max: u64) {
    let l: u64 = rd32(argp)
    var k: u64 = 0
    while k + 1 < l && k + 1 < max {
        __mmio_write8((out + k) as *mut u8, inbuf[(argp + 4 + k) as usize])
        k = k + 1
    }
    __mmio_write8((out + k) as *mut u8, 0 as u8)
}

static mut n_trace_ev: u64 = 0

fn trace_ev(c: u64, typ: u64, a: u64) {
    if !trace_on || n_trace_ev >= 120 {
        return
    }
    n_trace_ev = n_trace_ev + 1
    var t: [u8; 12] = "wayd: ev c=\0"
    lineout.add_text((&t[0 as usize]) as u64)
    lineout.add_unum(c)
    var t2: [u8; 6] = " typ=\0"
    lineout.add_text((&t2[0 as usize]) as u64)
    lineout.add_unum(typ)
    var t3: [u8; 4] = " a=\0"
    lineout.add_text((&t3[0 as usize]) as u64)
    lineout.add_unum(a)
    var t4: [u8; 5] = " en=\0"
    lineout.add_text((&t4[0 as usize]) as u64)
    lineout.add_unum(wl_input.n_enters)
    var t5: [u8; 5] = " ks=\0"
    lineout.add_text((&t5[0 as usize]) as u64)
    lineout.add_unum(wl_input.n_keys_sent)
    var t6: [u8; 5] = " ps=\0"
    lineout.add_text((&t6[0 as usize]) as u64)
    lineout.add_unum(wl_input.n_ptr_sent)
    var t7: [u8; 5] = " ax=\0"
    lineout.add_text((&t7[0 as usize]) as u64)
    lineout.add_unum(wl_input.n_axis_sent)
    lineout.end_line()
}

fn pump_input() {
    var c: u64 = 0
    while c < MAX_CLIENTS {
        if c_used[c as usize] != 0 {
            if c_outlen[c as usize] + 1024 < OUT_CAP {
                c_outlen[c as usize] = wl_input.esc_flush(c, out_base(c), c_outlen[c as usize])
            }
            var o: u64 = 0
            while o < MAX_OBJ {
                let b: u64 = obj_base(c, o)
                if objs[(b + O_ID) as usize] != 0
                    && objs[(b + O_IFACE) as usize] == wlproto.IF_WL_SURFACE {
                    let sid: u64 = objs[(b + O_ID) as usize]
                    let win: u64 = obj_get(c, sid, O_A)
                    var n: u64 = 0
                    while win != 0 && n < 16 && c_outlen[c as usize] + 1024 < OUT_CAP
                        && ulib.sys(WM_EVENT, win,
                            (&evb[0 as usize]) as u64, 0) == 1 {
                        let typ: u64 = evb[0 as usize]
                        let d: u64 = evb[1 as usize]
                        let ea: u64 = (d >> 32) & 0xFFFF
                        let eb: u64 = (d >> 16) & 0xFFFF
                        let ec: u64 = d & 0xFFFF
                        let ob: u64 = out_base(c)
                        let ol: u64 = c_outlen[c as usize]
                        trace_ev(c, typ, ec)
                        if typ == 1 {
                            c_outlen[c as usize] = wl_input.on_key(c, sid, ea, ob, ol)
                            n_keys = n_keys + 1
                        } else if typ == 2 || typ == 3 || typ == 4 {
                            c_outlen[c as usize] = wl_input.on_ptr(c, sid, typ, ea, eb, ec, ob, ol)
                            n_ptr = n_ptr + 1
                        } else if typ == 9 || typ == 10 {
                            c_outlen[c as usize] = wl_input.on_axis(c, sid, typ == 10, ea, eb, ec, ob, ol)
                            n_ptr = n_ptr + 1
                        } else if typ == 6 {
                            c_outlen[c as usize] = wl_input.on_focus(c, sid, ec == 1, ob, ol)
                        } else if typ == 5 {
                            let xs: u64 = obj_get(c, sid, O_C)
                            if xs != 0 {
                                let tl: u64 = obj_get(c, xs, O_B)
                                if tl != 0 {
                                    let p: u64 = ev_begin(c, tl, 1)
                                    ev_end(c, p, 0)
                                    var s1: [u8; 25] = "wayd: close to toplevel\n\0"
                                    lineout.add_text((&s1[0 as usize]) as u64)
                                }
                            }
                        }
                        n = n + 1
                    }
                    if win != 0 && c_outlen[c as usize] + 1024 < OUT_CAP && ulib.sys(1870, 0, 0, 0) != 1 {
                        c_outlen[c as usize] = wl_input.ptr_check(c, sid, win, out_base(c), c_outlen[c as usize])
                    }
                }
                o = o + 1
            }
        }
        c = c + 1
    }
}

static mut mh: [u64; 8] = [0 as u64; 8]
static mut iov: [u64; 2] = [0 as u64; 2]
static mut cmsg: [u64; 16] = [0 as u64; 16]

static mut fdq_v: [u64; 32] = [0 as u64; 32]
static mut fdq_n: [u64; 4] = [0 as u64; 4]

fn fdq_fill(c: u64) {
    if mh[5 as usize] < 20 {
        return
    }
    let lvl: u64 = cmsg[1 as usize] & 0xFFFFFFFF
    let typ: u64 = (cmsg[1 as usize] >> 32) & 0xFFFFFFFF
    if lvl != 1 || typ != 1 {
        return
    }
    let nfd: u64 = (mh[5 as usize] - 16) / 4
    var k: u64 = 0
    while k < nfd && k < 24 {
        let w: u64 = cmsg[(2 + k / 2) as usize]
        var fd: u64 = w & 0xFFFFFFFF
        if (k & 1) != 0 {
            fd = (w >> 32) & 0xFFFFFFFF
        }
        if fdq_n[c as usize] < 8 {
            fdq_v[(c * 8 + fdq_n[c as usize]) as usize] = fd
            fdq_n[c as usize] = fdq_n[c as usize] + 1
        } else {
            ulib.sys(SYS_CLOSE, fd, 0, 0)
        }
        k = k + 1
    }
}

fn fdq_pop(c: u64) -> u64 {
    if fdq_n[c as usize] == 0 {
        return 0
    }
    let v: u64 = fdq_v[(c * 8) as usize]
    var k: u64 = 1
    while k < fdq_n[c as usize] {
        fdq_v[(c * 8 + k - 1) as usize] = fdq_v[(c * 8 + k) as usize]
        k = k + 1
    }
    fdq_n[c as usize] = fdq_n[c as usize] - 1
    return v
}

fn fdq_drop(c: u64) {
    while fdq_n[c as usize] != 0 {
        ulib.sys(SYS_CLOSE, fdq_pop(c), 0, 0)
    }
}

fn client_cleanup(c: u64) {
    objs_release(c)
    wl_data.client_gone(c)
    wl_input.client_init(c)
    fdq_drop(c)
}

fn recv_into(c: u64) -> u64 {
    let base: u64 = c * IN_CAP
    let have: u64 = c_inlen[c as usize]
    if have >= IN_CAP - 256 {
        return 0
    }
    if c_outlen[c as usize] + 2048 > OUT_CAP {
        return 0
    }
    iov[0 as usize] = (&inbuf[(base + have) as usize]) as u64
    iov[1 as usize] = IN_CAP - have
    cmsg[0 as usize] = 0
    cmsg[1 as usize] = 0
    cmsg[2 as usize] = 0
    cmsg[3 as usize] = 0
    mh[0 as usize] = 0
    mh[1 as usize] = 0
    mh[2 as usize] = (&iov[0 as usize]) as u64
    mh[3 as usize] = 1
    mh[4 as usize] = (&cmsg[0 as usize]) as u64
    mh[5 as usize] = 128
    mh[6 as usize] = 0
    let n: u64 = ulib.sys(SYS_RECVMSG, c_fd[c as usize],
        (&mh[0 as usize]) as u64, MSG_DONTWAIT)
    if n > 0xFFFFFFFFFFFF0000 {
        return 0
    }
    if n == 0 {
        c_used[c as usize] = 0
        ulib.sys(SYS_CLOSE, c_fd[c as usize], 0, 0)
        client_cleanup(c)
        var t_bye: [u8; 4] = "eof\0"
        trace_line((&t_bye[0 as usize]) as u64, c, 0, 0, 0)
        var s_bye: [u8; 22] = "wayd: Client gegangen\0"
        lineout.add_text((&s_bye[0 as usize]) as u64)
        lineout.end_line()
        return 0
    }
    c_inlen[c as usize] = have + n
    return n
}

fn flush_out(c: u64) {
    let n: u64 = c_outlen[c as usize]
    if n == 0 {
        return
    }
    iov[0 as usize] = (&outbuf[(c * OUT_CAP) as usize]) as u64
    iov[1 as usize] = n
    mh[0 as usize] = 0
    mh[1 as usize] = 0
    mh[2 as usize] = (&iov[0 as usize]) as u64
    mh[3 as usize] = 1
    mh[4 as usize] = 0
    mh[5 as usize] = 0
    mh[6 as usize] = 0
    let sr: u64 = ulib.sys(SYS_SENDMSG, c_fd[c as usize],
        (&mh[0 as usize]) as u64, MSG_DONTWAIT)
    var t_tx: [u8; 3] = "tx\0"
    trace_line((&t_tx[0 as usize]) as u64, c, n, sr, 0)
    if sr > 0xFFFFFFFFFFFF0000 {
        if sr != 0 -% 11 {
            c_outlen[c as usize] = 0
        }
        return
    }
    if sr >= n {
        c_outlen[c as usize] = 0
        return
    }
    var k: u64 = 0
    while k < n - sr {
        outbuf[(c * OUT_CAP + k) as usize] = outbuf[(c * OUT_CAP + sr + k) as usize]
        k = k + 1
    }
    c_outlen[c as usize] = n - sr
}

fn send_fd_msg(c: u64, ptr: u64, len: u64, fd: u64) {
    if c >= MAX_CLIENTS || c_used[c as usize] == 0 || fd == 0 {
        return
    }
    flush_out(c)
    if c_outlen[c as usize] != 0 {
        return
    }
    iov[0 as usize] = ptr
    iov[1 as usize] = len
    cmsg[0 as usize] = 20
    cmsg[1 as usize] = 1 | (1 << 32)
    cmsg[2 as usize] = fd
    mh[0 as usize] = 0
    mh[1 as usize] = 0
    mh[2 as usize] = (&iov[0 as usize]) as u64
    mh[3 as usize] = 1
    mh[4 as usize] = (&cmsg[0 as usize]) as u64
    mh[5 as usize] = 24
    mh[6 as usize] = 0
    ulib.sys(SYS_SENDMSG, c_fd[c as usize], (&mh[0 as usize]) as u64, MSG_DONTWAIT)
}

fn send_keymap(c: u64, kid: u64) {
    let len: u64 = wl_input.keymap_msg(kid)
    let fd: u64 = wl_input.keymap_fd()
    send_fd_msg(c, wl_input.keymap_ptr(), len, fd)
}

fn drain(c: u64, fd: u64) {
    let base: u64 = c * IN_CAP
    var at: u64 = 0
    var live: bool = true
    var next: bool = true
    var usedfd: u64 = fd
    while live && next && at + 8 <= c_inlen[c as usize] {
        let w1: u64 = rd32(base + at + 4)
        let len: u64 = (w1 >> 16) & 0xFFFF
        if len < 8 {
            send_error(c, 0, 0)
            live = false
        } else if at + len > c_inlen[c as usize] {
            next = false
        } else {
            let id0: u64 = rd32(base + at)
            let op0: u64 = rd32(base + at + 4) & 0xFFFF
            let if0: u64 = obj_iface(c, id0)
            err_op = op0
            var mit: u64 = 0
            if if0 < wlproto.IF_COUNT && wlproto.req_has_fd(if0, op0) {
                mit = fdq_pop(c)
            }
            live = dispatch(c, at, len, mit)
            at = at + len
        }
    }
    if at > 0 {
        var k: u64 = 0
        let rest: u64 = c_inlen[c as usize] - at
        while k < rest {
            inbuf[(base + k) as usize] = inbuf[(base + at + k) as usize]
            k = k + 1
        }
        c_inlen[c as usize] = rest
    }
    if !live {
        c_used[c as usize] = 0
        ulib.sys(SYS_CLOSE, c_fd[c as usize], 0, 0)
        client_cleanup(c)
    }
}

static mut sa: [u8; 112] = [0 as u8; 112]

fn set_sockpath(p: u64) -> u64 {
    sa[0 as usize] = 1
    sa[1 as usize] = 0
    var n: u64 = 0
    while n < 100 {
        let ch: u64 = (__mmio_read8((p + n) as *mut u8)) as u64
        if ch == 0 {
            n = 100
        } else {
            sa[(2 + n) as usize] = ch as u8
            n = n + 1
        }
    }
    var l: u64 = 0
    while l < 100 && sa[(2 + l) as usize] != 0 {
        l = l + 1
    }
    return 2 + l + 1
}

static mut deflt: [u8; 15] = "/tmp/wayland-0\0"

fn num_from(p: u64) -> u64 {
    var v: u64 = 0
    var n: u64 = 0
    while n < 10 {
        let ch: u64 = (__mmio_read8((p + n) as *mut u8)) as u64
        if ch < 48 || ch > 57 {
            n = 10
        } else {
            v = v * 10 + (ch - 48)
            n = n + 1
        }
    }
    return v
}

static mut pfds: [u64; 8] = [0 as u64; 8]

fn client_has_win(c: u64) -> bool {
    var o: u64 = 0
    while o < MAX_OBJ {
        let b: u64 = obj_base(c, o)
        if objs[(b + O_ID) as usize] != 0 && objs[(b + O_IFACE) as usize] == wlproto.IF_WL_SURFACE
            && objs[(b + O_A) as usize] != 0 {
            return true
        }
        o = o + 1
    }
    return false
}

fn idle_wait(ls: u64) {
    var n: u64 = 1
    pfds[0 as usize] = ls | (1 << 32)
    var busy: bool = wl_data.busy()
    var c: u64 = 0
    while c < MAX_CLIENTS {
        if c_used[c as usize] != 0 {
            if n < 8 {
                pfds[n as usize] = c_fd[c as usize] | (1 << 32)
                n = n + 1
            }
            if client_has_win(c) || c_outlen[c as usize] != 0 {
                busy = true
            }
        }
        c = c + 1
    }
    var tmo: u64 = 200
    if busy {
        tmo = 10
    }
    ulib.sys(SYS_POLL, (&pfds[0 as usize]) as u64, n, tmo)
}

fn u_start(args: u64) -> u64 {
    var s_start: [u8; 16] = "wayd: ready on \0"
    var s_fail: [u8; 24] = "wayd: socket geht nicht\0"
    var s_bindf: [u8; 22] = "wayd: bind geht nicht\0"
    var s_conn: [u8; 16] = "wayd: verbunden\0"
    var s_sum: [u8; 12] = "wayd: msgs=\0"
    var s_win: [u8; 7] = " wins=\0"
    var s_com: [u8; 10] = " commits=\0"
    var s_fd: [u8; 6] = " fds=\0"
    var s_bad: [u8; 6] = " bad=\0"

    var lbl: [u8; 15] = "compat:wayland\0"
    ulib.sys(1990, 1, (&lbl[0 as usize]) as u64, 14)
    var path: u64 = (&deflt[0 as usize]) as u64
    if ulib.arg_count(args) > 1 {
        path = ulib.arg_at(args, 1)
    }
    var empty: u64 = 0
    var empty_max: u64 = EMPTY_MAX
    if ulib.arg_count(args) > 3 {
        let l3: u64 = num_from(ulib.arg_at(args, 3))
        if l3 != 0 {
            empty_max = l3
        }
    }
    if ulib.arg_count(args) > 4 {
        trace_on = true
    }
    var runden: u64 = 2000
    if ulib.arg_count(args) > 2 {
        let two: u64 = num_from(ulib.arg_at(args, 2))
        if two >= 16 {
            runden = two
        }
    }

    var ls: u64 = 0
    var geerbt: bool = false
    if ulib.arg_count(args) > 2 {
        let fdarg: u64 = num_from(ulib.arg_at(args, 2))
        if fdarg > 2 && fdarg < 16 {
            ls = fdarg
            geerbt = true
        }
    }
    if !geerbt {
        ulib.sys(SYS_UNLINK, path, 0, 0)
        let alen: u64 = set_sockpath(path)
        ls = ulib.sys(SYS_SOCKET, AF_UNIX, SOCK_STREAM, 0)
        if ls > 0xFFFFFFFFFFFF0000 {
            lineout.add_text((&s_fail[0 as usize]) as u64)
            lineout.end_line()
            return 1
        }
        let br: u64 = kcall.sys4(SYS_BIND, ls,
            (&sa[0 as usize]) as u64, alen, 0)
        if br > 0xFFFFFFFFFFFF0000 {
            lineout.add_text((&s_bindf[0 as usize]) as u64)
            lineout.end_line()
            return 1
        }
        ulib.sys(SYS_LISTEN, ls, 4, 0)
    }
    lineout.add_text((&s_start[0 as usize]) as u64)
    lineout.add_text(path)
    lineout.end_line()

    var i: u64 = 0
    while i < MAX_CLIENTS {
        c_used[i as usize] = 0
        i = i + 1
    }
    wl_data.init_bridge()
    wl_input.layout_changed()

    var n: u64 = 0
    var limit: u64 = runden
    if geerbt {
        limit = 0xFFFFFFFFFFFFFFF
    }
    while n < limit {
        let nf: u64 = kcall.sys4(SYS_ACCEPT4, ls, 0, 0, 2048)
        if nf < 0xFFFFFFFFFFFF0000 {
            var slot: u64 = MAX_CLIENTS
            var k: u64 = 0
            while k < MAX_CLIENTS {
                if c_used[k as usize] == 0 && slot >= MAX_CLIENTS {
                    slot = k
                }
                k = k + 1
            }
            if slot < MAX_CLIENTS {
                c_used[slot as usize] = 1
                c_fd[slot as usize] = nf
                c_inlen[slot as usize] = 0
                c_outlen[slot as usize] = 0
                c_nextid[slot as usize] = 0xFF000000
                c_kfoc[slot as usize] = 0
                c_pfoc[slot as usize] = 0
                wl_input.client_init(slot)
                wl_data.client_init(slot)
                wl_frame.client_init(slot)
                fdq_n[slot as usize] = 0
                c_title[(slot * 32) as usize] = 0 as u8
                c_appid[(slot * 24) as usize] = 0 as u8
                var o: u64 = 0
                while o < MAX_OBJ {
                    objs[(obj_base(slot, o) + O_ID) as usize] = 0
                    o = o + 1
                }
                obj_new(slot, ID_DISPLAY, wlproto.IF_WL_DISPLAY)
                var t_ac: [u8; 7] = "accept\0"
                trace_line((&t_ac[0 as usize]) as u64, slot, nf, 0, 0)
                n_conn = n_conn + 1
                lineout.add_text((&s_conn[0 as usize]) as u64)
                lineout.end_line()
            } else {
                ulib.sys(SYS_CLOSE, nf, 0, 0)
            }
        }

        pump_input()
        wl_data.tick()
        release_frame_callbacks()
        if wl_input.layout_changed() {
            var kc: u64 = 0
            while kc < MAX_CLIENTS {
                if c_used[kc as usize] != 0 && wl_input.keyboard_count(kc) != 0 {
                    var kj: u64 = 0
                    while kj < wl_input.keyboard_count(kc) {
                        send_keymap(kc, wl_input.keyboard_at(kc, kj))
                        kj = kj + 1
                    }
                }
                kc = kc + 1
            }
        }
        var c: u64 = 0
        while c < MAX_CLIENTS {
            if c_used[c as usize] != 0 {
                let got: u64 = recv_into(c)
                if got > 0 {
                    fdq_fill(c)
                    drain(c, 0)
                }
                if c_used[c as usize] != 0 {
                    if c_outlen[c as usize] + 2048 < OUT_CAP {
                        c_outlen[c as usize] = wl_data.emit(c, out_base(c), c_outlen[c as usize])
                    }
                    flush_out(c)
                }
            }
            c = c + 1
        }
        data_sync()
        if geerbt {
            var open: u64 = 0
            var q: u64 = 0
            while q < MAX_CLIENTS {
                if c_used[q as usize] != 0 {
                    open = open + 1
                }
                q = q + 1
            }
            if open == 0 && n_conn != 0 {
                if empty == 0 {
                    empty = clockapi.ticks() + 1
                }
                if clockapi.ticks() + 1 - empty >= empty_max / 20 {
                    var s_idle: [u8; 28] = "wayd: no client left -- end\0"
                    lineout.add_text((&s_idle[0 as usize]) as u64)
                    lineout.end_line()
                    n = limit
                }
            } else {
                empty = 0
            }
        }
        idle_wait(ls)
        n = n + 1
    }

    lineout.add_text((&s_sum[0 as usize]) as u64)
    lineout.add_unum(n_msgs)
    lineout.add_text((&s_win[0 as usize]) as u64)
    lineout.add_unum(n_wins)
    lineout.add_text((&s_com[0 as usize]) as u64)
    lineout.add_unum(n_commits)
    lineout.add_text((&s_fd[0 as usize]) as u64)
    lineout.add_unum(n_fds)
    lineout.add_text((&s_bad[0 as usize]) as u64)
    lineout.add_unum(n_bad)
    lineout.end_line()
    return 0
}
