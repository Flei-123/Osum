profile kernel

import ulib
import libc.io
import msg
import search.learn

export { record, bonus, pinned, suggest, token_at, reset_all, set_enabled, is_enabled, now_hours }

const SYS_CLOCK_GETTIME: u64 = 228
const CLOCK_REALTIME: u64 = 0
const SECONDS_PER_HOUR: u64 = 3600

static mut file_name: [u8; 11] = "startlearn\0"
static mut path_buf: [u8; 128] = [0 as u8; 128]
static mut file_buf: [u8; 4096] = [0 as u8; 4096]
static mut loaded: bool = false
static mut path_ok: bool = false

fn now_hours() -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    let rc: u64 = ulib.sys(SYS_CLOCK_GETTIME, CLOCK_REALTIME, (&ts[0 as usize]) as u64, 0)
    if ulib.bad(rc) {
        return 0
    }
    return ts[0 as usize] / SECONDS_PER_HOUR
}

fn ensure_loaded() {
    if loaded {
        return
    }
    loaded = true
    learn.reset()
    path_ok = msg.user_file((&file_name[0 as usize]) as u64, (&path_buf[0 as usize]) as u64)
    if !path_ok {
        return
    }
    let fd: u64 = io.open((&path_buf[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return
    }
    let got: u64 = io.read(fd, (&file_buf[0 as usize]) as u64, learn.MAX_FILE)
    io.close(fd)
    if ulib.bad(got) {
        return
    }
    learn.parse((&file_buf[0 as usize]) as u64, got)
}

fn save() {
    if !path_ok {
        return
    }
    let n: u64 = learn.serialize((&file_buf[0 as usize]) as u64, learn.MAX_FILE)
    let fd: u64 = io.open((&path_buf[0 as usize]) as u64, ulib.O_MAKE)
    if ulib.bad(fd) {
        return
    }
    let _w: u64 = io.write_all(fd, (&file_buf[0 as usize]) as u64, n)
    io.close(fd)
}

fn record(query: u64, token: u64) {
    ensure_loaded()
    learn.record(query, token, now_hours())
    save()
}

fn bonus(token: u64) -> u64 {
    ensure_loaded()
    return learn.usage_bonus(token, now_hours())
}

fn pinned(query: u64, token: u64) -> bool {
    ensure_loaded()
    return learn.is_pinned(query, token, now_hours())
}

fn suggest(out: u64, max: u64) -> u64 {
    ensure_loaded()
    return learn.top_usage(out, max, now_hours())
}

fn token_at(i: u64) -> u64 {
    return learn.usage_token(i)
}

fn is_enabled() -> bool {
    ensure_loaded()
    return learn.enabled()
}

fn set_enabled(on: bool) {
    ensure_loaded()
    learn.set_enabled(on)
    save()
}

fn reset_all() {
    ensure_loaded()
    learn.reset()
    save()
}
