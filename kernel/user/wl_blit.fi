profile kernel

export { blit }

const WM_BLIT: u64 = 2147
const BYTES_PER_PIXEL: u64 = 4

fn blit(win: u64, x: u64, y: u64, w: u64, h: u64, src: u64, stride: u64) -> u64 {
    let origin: u64 = src + y * stride + x * BYTES_PER_PIXEL
    return asm("syscall", out("rax"), in("rax") WM_BLIT, in("rdi") win,
        in("rsi") (x << 16) | y, in("rdx") (w << 16) | h, in("r10") origin,
        in("r8") stride, clobber("rcx"), clobber("r11"), clobber("memory"))
}
