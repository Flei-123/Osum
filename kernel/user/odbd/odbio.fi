// ------------------------------------------------------------ constants

const MAXP: u64 = 65536

const RBSIZE: u64 = 140000

const T_ERR: u64 = 5

const SYS_GETRANDOM: u64 = 318

const SYS_CLOCK_GETTIME: u64 = 228

const SYS_WAIT4: u64 = 61

const SYS_IOCTL_N: u64 = 16

const SYS_OSUM_PTY_N: u64 = 1100

const TIOCSWINSZ_N: u64 = 0x5414

const WNOHANG: u64 = 1

// ------------------------------------------------------------ state

static mut rb: [u8; 140000] = [0 as u8; 140000]

static mut tb: [u8; 65700] = [0 as u8; 65700]

static mut pb: [u8; 65700] = [0 as u8; 65700]

static mut pl: u64 = 0

static mut reqbuf: [u8; 8192] = [0 as u8; 8192]

static mut crct: [u64; 256] = [0 as u64; 256]

static mut crc_ready: u64 = 0

static mut tok: [u8; 256] = [0 as u8; 256]

static mut toklen: u64 = 0

static mut nonce: [u8; 16] = [0 as u8; 16]

static mut fails: u64 = 0

static mut tmp: [u8; 1024] = [0 as u8; 1024]

static mut procb: [u8; 256] = [0 as u8; 256]

static mut pathb: [u8; 600] = [0 as u8; 600]

static mut cmdb: [u8; 2048] = [0 as u8; 2048]

static mut argb: [u8; 2048] = [0 as u8; 2048]

static mut argv_ptrs: [u64; 17] = [0 as u64; 17]

static mut iobuf: [u8; 32768] = [0 as u8; 32768]

static mut hexb: [u8; 80] = [0 as u8; 80]

static mut dig: [u8; 32] = [0 as u8; 32]

static mut inner: [u8; 32] = [0 as u8; 32]

static mut kpad: [u8; 64] = [0 as u8; 64]

static mut pfds: [u8; 64] = [0 as u8; 64]

// ------------------------------------------------------------ bytes

fn rd16(p: u64) -> u64 {
    return regio.read8(p) | (regio.read8(p + 1) << 8)
}

fn rd32(p: u64) -> u64 {
    return regio.read8(p) | (regio.read8(p + 1) << 8) | (regio.read8(p + 2) << 16) | (regio.read8(p + 3) << 24)
}

fn rd64(p: u64) -> u64 {
    return rd32(p) | (rd32(p + 4) << 32)
}

fn wr16(p: u64, v: u64) {
    regio.write8(p, v)
    regio.write8(p + 1, v >> 8)
}

fn wr32(p: u64, v: u64) {
    regio.write8(p, v)
    regio.write8(p + 1, v >> 8)
    regio.write8(p + 2, v >> 16)
    regio.write8(p + 3, v >> 24)
}

fn wr64(p: u64, v: u64) {
    wr32(p, v)
    wr32(p + 4, v >> 32)
}

fn addr_rb() -> u64 {
    return (&rb[0 as usize]) as u64
}

fn addr_tb() -> u64 {
    return (&tb[0 as usize]) as u64
}

fn addr_pb() -> u64 {
    return (&pb[0 as usize]) as u64
}

fn addr_req() -> u64 {
    return (&reqbuf[0 as usize]) as u64
}

fn addr_io() -> u64 {
    return (&iobuf[0 as usize]) as u64
}

fn addr_tmp() -> u64 {
    return (&tmp[0 as usize]) as u64
}

fn addr_path() -> u64 {
    return (&pathb[0 as usize]) as u64
}

fn addr_hex() -> u64 {
    return (&hexb[0 as usize]) as u64
}

fn addr_dig() -> u64 {
    return (&dig[0 as usize]) as u64
}

fn copy_bytes(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        regio.write8(dst + i, regio.read8(src + i))
        i = i + 1
    }
}

fn mono_ms() -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    kcall.sys2(SYS_CLOCK_GETTIME, 1, (&ts[0 as usize]) as u64)
    return (ts[0 as usize] *% 1000) +% (ts[1 as usize] / 1000000)
}

// ------------------------------------------------------------ crc32

fn crc_init() {
    if crc_ready == 1 {
        return
    }
    var n: u64 = 0
    while n < 256 {
        var c: u64 = n
        var k: u64 = 0
        while k < 8 {
            if (c & 1) != 0 {
                c = 0xEDB88320 ^ (c >> 1)
            } else {
                c = c >> 1
            }
            k = k + 1
        }
        crct[n as usize] = c
        n = n + 1
    }
    crc_ready = 1
}

// running state in, running state out (init 0xFFFFFFFF, final xor by the caller)
fn crc_run(c0: u64, p: u64, n: u64) -> u64 {
    var c: u64 = c0
    var i: u64 = 0
    while i < n {
        c = crct[((c ^ regio.read8(p + i)) & 255) as usize] ^ (c >> 8)
        i = i + 1
    }
    return c
}

fn crc32(p: u64, n: u64) -> u64 {
    return crc_run(0xFFFFFFFF, p, n) ^ 0xFFFFFFFF
}

// ------------------------------------------------------------ frames out

fn dev_write_all(p: u64, n: u64) -> bool {
    var done: u64 = 0
    var stalled_since: u64 = 0
    while done < n {
        let r: u64 = io.write(odbbase.dev, p + done, n - done)
        if errno.failed(r) {
            return false
        }
        if r == 0 {
            // The line does not drain (host closed the pipe / stopped reading). Give up after 3 s without progress
            // instead of spinning for ever: the frame is lost, the host's resync and retry cope with it.
            let now: u64 = mono_ms()
            if stalled_since == 0 {
                stalled_since = now
            } else if now -% stalled_since > 3000 {
                return false
            }
            clockapi.sleep_ms(10)   // THR stuck: do not re-enter the port-polling spin at once (every port read is a VM exit)
        } else {
            done = done + r
            stalled_since = 0
        }
    }
    return true
}

fn send_frame(typ: u64, flags: u64, id: u64, p: u64, n: u64) -> bool {
    let t: u64 = addr_tb()
    regio.write8(t, 0x4F)
    regio.write8(t + 1, 0x44)
    regio.write8(t + 2, 0x42)
    regio.write8(t + 3, 0x31)
    regio.write8(t + 4, 1)
    regio.write8(t + 5, typ)
    wr16(t + 6, flags)
    wr32(t + 8, id)
    wr32(t + 12, n)
    copy_bytes(t + odbbase.HDRLEN, p, n)
    wr32(t + odbbase.HDRLEN + n, crc32(t, odbbase.HDRLEN + n))
    return dev_write_all(t, odbbase.HDRLEN + n + 4)
}

// ------------------------------------------------------------ payload build

fn p_reset() {
    pl = 0
}

fn p_key(key: u64, vlen: u64) -> u64 {
    let kl: u64 = text.length(key)
    let b: u64 = addr_pb()
    regio.write8(b + pl, kl)
    copy_bytes(b + pl + 1, key, kl)
    wr16(b + pl + 1 + kl, vlen)
    let at: u64 = b + pl + 3 + kl
    pl = pl + 3 + kl + vlen
    return at
}

fn p_bytes(key: u64, v: u64, n: u64) {
    if pl + 300 + n > 60000 {
        return
    }
    let at: u64 = p_key(key, n)
    copy_bytes(at, v, n)
}

fn p_str(key: u64, v: u64) {
    p_bytes(key, v, text.length(v))
}

fn p_num(key: u64, v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    let n: u64 = text.digits(v, (&d[0 as usize]) as u64, false)
    p_bytes(key, (&d[0 as usize]) as u64, n)
}

fn send_final(typ: u64, id: u64) -> bool {
    odbbase.lastid = id
    odbbase.lasttype = typ
    odbbase.lastlen = 0
    if pl <= 4096 {
        copy_bytes((&odbbase.lastbuf[0 as usize]) as u64, addr_pb(), pl)
        odbbase.lastlen = pl
    }
    return send_frame(typ, 0, id, addr_pb(), pl)
}

fn reply_ok(id: u64) {
    send_final(odbbase.T_RESP, id)
}

fn reply_err(id: u64, code: u64, msg: u64) {
    p_reset()
    p_str(s_code(), code)
    p_str(s_msg(), msg)
    send_final(T_ERR, id)
}

static mut g_empty_since: u64 = 0

static mut g_dropped: u64 = 0

static mut g_crcbad: u64 = 0

fn drop_bytes(n: u64) {
    if n >= odbbase.rlen {
        odbbase.rlen = 0
        return
    }
    let b: u64 = addr_rb()
    var i: u64 = 0
    while i < odbbase.rlen - n {
        regio.write8(b + i, regio.read8(b + n + i))
        i = i + 1
    }
    odbbase.rlen = odbbase.rlen - n
}

fn magic_ok(avail: u64) -> bool {
    let b: u64 = addr_rb()
    if avail > 0 && regio.read8(b) != 0x4F {
        return false
    }
    if avail > 1 && regio.read8(b + 1) != 0x44 {
        return false
    }
    if avail > 2 && regio.read8(b + 2) != 0x42 {
        return false
    }
    if avail > 3 && regio.read8(b + 3) != 0x31 {
        return false
    }
    return true
}

// Length of a complete valid frame at rb[0], 0 when more octets are needed.
fn have_frame() -> u64 {
    let b: u64 = addr_rb()
    var going: bool = true
    var result: u64 = 0
    while going {
        var avail: u64 = odbbase.rlen
        if avail > 4 {
            avail = 4
        }
        if avail > 0 && !magic_ok(avail) {
            g_dropped = g_dropped + 1
            drop_bytes(1)
        } else if odbbase.rlen < odbbase.HDRLEN {
            going = false
        } else {
            let len: u64 = rd32(b + 12)
            if regio.read8(b + 4) != 1 || len > MAXP {
                drop_bytes(1)
            } else if odbbase.rlen < odbbase.HDRLEN + len + 4 {
                going = false
            } else if crc32(b, odbbase.HDRLEN + len) != rd32(b + odbbase.HDRLEN + len) {
                g_crcbad = g_crcbad + 1
                drop_bytes(1)
            } else {
                result = odbbase.HDRLEN + len + 4
                going = false
            }
        }
    }
    return result
}

// Pull what the line has into rb. Returns octets added.
fn fill() -> u64 {
    if odbbase.rlen >= RBSIZE - 4096 {
        return 0
    }
    let n: u64 = io.read(odbbase.dev, addr_rb() + odbbase.rlen, 4096)
    if errno.failed(n) {
        return 0
    }
    odbbase.rlen = odbbase.rlen + n
    if n > 0 {
        odbbase.g_last_rx = mono_ms()
        g_empty_since = 0
    }
    return n
}

// A frame that was cut off by the peer (host closed the line mid-frame) would block everything behind it
// for ever: after 250 ms without a byte the head of the buffer is dropped one octet at a time (resync).
fn stale_check() {
    if odbbase.rlen == 0 {
        g_empty_since = 0
        return
    }
    let now: u64 = mono_ms()
    if g_empty_since == 0 {
        // First empty poll since the last byte: the silence starts HERE, not at the last byte. The agent can be busy
        // for much longer than 250 ms between two polls (a 32 KiB disk write under host load) while the rest of
        // a good frame is still on its way.
        g_empty_since = now
        return
    }
    if now -% g_empty_since > 250 {
        g_dropped = g_dropped + 1
        drop_bytes(1)
        g_empty_since = now
    }
}

// Wait up to `ms` for a complete frame. Returns its total length or 0.
fn wait_frame(ms: u64) -> u64 {
    let t0: u64 = mono_ms()
    var going: bool = true
    var result: u64 = 0
    while going {
        let n: u64 = have_frame()
        if n != 0 {
            result = n
            going = false
        } else {
            let got: u64 = fill()
            if got == 0 {
                stale_check()
                if mono_ms() -% t0 >= ms {
                    going = false
                } else {
                    ulib.sys(ulib.SYS_YIELD, 0, 0, 0)
                }
            }
        }
    }
    return result
}

// ------------------------------------------------------------ TLV in

// Value pointer of `key` in the TLV block, NONE-length in g_vlen = absent (returns 0).
fn tget(tp: u64, tl: u64, key: u64) -> u64 {
    return tget_at(tp, tl, key, 0)
}

// The `skip`-th (0 based) occurrence of a repeated key; g_vlen = NONE when there are fewer.
fn tget_at(tp: u64, tl: u64, key: u64, skip: u64) -> u64 {
    var seen: u64 = 0
    let kl: u64 = text.length(key)
    var off: u64 = 0
    odbbase.g_vlen = odbbase.NONE
    while off + 3 <= tl {
        let kn: u64 = regio.read8(tp + off)
        if off + 3 + kn > tl {
            return 0
        }
        let vl: u64 = rd16(tp + off + 1 + kn)
        if off + 3 + kn + vl > tl {
            return 0
        }
        if kn == kl {
            var same: bool = true
            var i: u64 = 0
            while i < kn {
                if regio.read8(tp + off + 1 + i) != regio.read8(key + i) {
                    same = false
                }
                i = i + 1
            }
            if same {
                if seen == skip {
                    odbbase.g_vlen = vl
                    return tp + off + 3 + kn
                }
                seen = seen + 1
            }
        }
        off = off + 3 + kn + vl
    }
    return 0
}

// Value as NUL-terminated copy in out (max octets incl. NUL); false when absent.
fn tget_str(tp: u64, tl: u64, key: u64, out: u64, max: u64) -> bool {
    let v: u64 = tget(tp, tl, key)
    if odbbase.g_vlen == odbbase.NONE {
        return false
    }
    var n: u64 = odbbase.g_vlen
    if n + 1 > max {
        n = max - 1
    }
    copy_bytes(out, v, n)
    regio.write8(out + n, 0)
    return true
}

fn tget_num(tp: u64, tl: u64, key: u64, dflt: u64) -> u64 {
    let v: u64 = tget(tp, tl, key)
    if odbbase.g_vlen == odbbase.NONE {
        return dflt
    }
    var n: u64 = 0
    var i: u64 = 0
    while i < odbbase.g_vlen {
        let c: u64 = regio.read8(v + i)
        if c >= 48 && c <= 57 {
            n = n * 10 + (c - 48)
        }
        i = i + 1
    }
    return n
}

fn same_str(a: u64, alen: u64, b: u64) -> bool {
    if alen != text.length(b) {
        return false
    }
    var i: u64 = 0
    while i < alen {
        if regio.read8(a + i) != regio.read8(b + i) {
            return false
        }
        i = i + 1
    }
    return true
}

// ------------------------------------------------------------ hashes

fn hexdump(src: u64, n: u64, out: u64) {
    var i: u64 = 0
    while i < n {
        let v: u64 = regio.read8(src + i)
        let h: u64 = v >> 4
        let l: u64 = v & 15
        if h < 10 {
            regio.write8(out + 2 * i, 48 + h)
        } else {
            regio.write8(out + 2 * i, 87 + h)
        }
        if l < 10 {
            regio.write8(out + 2 * i + 1, 48 + l)
        } else {
            regio.write8(out + 2 * i + 1, 87 + l)
        }
        i = i + 1
    }
    regio.write8(out + 2 * n, 0)
}

// HMAC-SHA256(key, msg) -> out[32]
fn hmac(key: u64, klen: u64, msg: u64, mlen: u64, out: u64) {
    let kp: u64 = (&kpad[0 as usize]) as u64
    var i: u64 = 0
    while i < 64 {
        regio.write8(kp + i, 0)
        i = i + 1
    }
    if klen > 64 {
        sha.begin()
        sha.update(key, klen)
        sha.finish(kp)
    } else {
        copy_bytes(kp, key, klen)
    }
    i = 0
    while i < 64 {
        regio.write8(kp + i, regio.read8(kp + i) ^ 0x36)
        i = i + 1
    }
    sha.begin()
    sha.update(kp, 64)
    sha.update(msg, mlen)
    sha.finish((&inner[0 as usize]) as u64)
    i = 0
    while i < 64 {
        regio.write8(kp + i, regio.read8(kp + i) ^ 0x36 ^ 0x5C)
        i = i + 1
    }
    sha.begin()
    sha.update(kp, 64)
    sha.update((&inner[0 as usize]) as u64, 32)
    sha.finish(out)
}

// sha256 + crc32 of a whole file; g_size, g_crc set; digest in dig. false = cannot open.
fn hash_file(path: u64) -> bool {
    let fd: u64 = io.open(path, 0)
    if errno.failed(fd) {
        return false
    }
    sha.begin()
    var c: u64 = 0xFFFFFFFF
    var total: u64 = 0
    var going: bool = true
    while going {
        let n: u64 = io.read(fd, addr_io(), 32768)
        if errno.failed(n) || n == 0 {
            going = false
        } else {
            sha.update(addr_io(), n)
            c = crc_run(c, addr_io(), n)
            total = total + n
        }
    }
    io.close(fd)
    sha.finish(addr_dig())
    odbbase.g_crc = c ^ 0xFFFFFFFF
    odbbase.g_size = total
    return true
}

// ------------------------------------------------------------ config

// True when /etc/odb.conf exists and has a line `enable=1`.
// /proc/odb (kernel -> agent): "odb=<0|1>\nrx_overruns=<n>\n". Returns the octets read (0 = no such file).
fn procodb_read() -> u64 {
    let fd: u64 = io.open(s_procodb(), 0)
    if errno.failed(fd) {
        return 0
    }
    let n: u64 = io.read(fd, (&procb[0 as usize]) as u64, 255)
    io.close(fd)
    if errno.failed(n) {
        return 0
    }
    regio.write8((&procb[0 as usize]) as u64 + n, 0)
    return n
}

// Value of "<key><digits>" at the start of a line of /proc/odb, NONE when the line is absent.
fn procodb_num(n: u64, key: u64) -> u64 {
    let kl: u64 = text.length(key)
    let b: u64 = (&procb[0 as usize]) as u64
    var i: u64 = 0
    while i + kl <= n {
        var j: u64 = 0
        while j < kl && regio.read8(b + i + j) == regio.read8(key + j) {
            j = j + 1
        }
        if j == kl && (i == 0 || regio.read8(b + i - 1) == 10) {
            var v: u64 = 0
            var k: u64 = i + kl
            while k < n && regio.read8(b + k) >= 48 && regio.read8(b + k) <= 57 {
                v = v * 10 + regio.read8(b + k) - 48
                k = k + 1
            }
            return v
        }
        i = i + 1
    }
    return odbbase.NONE
}

// `odb=1` on the kernel command line (r1155): the agent is enabled without /etc/odb.conf.
fn cmdline_odb() -> bool {
    let n: u64 = procodb_read()
    if n == 0 {
        return false
    }
    return procodb_num(n, s_odbone()) != odbbase.NONE
}

fn conf_enabled() -> bool {
    if cmdline_odb() {
        return true
    }
    let fd: u64 = io.open(s_confpath(), 0)
    if errno.failed(fd) {
        return false
    }
    let n: u64 = io.read(fd, addr_tmp(), 1024)
    io.close(fd)
    if errno.failed(n) {
        return false
    }
    var i: u64 = 0
    while i + 8 <= n {
        var j: u64 = 0
        while j < 8 && regio.read8(addr_tmp() + i + j) == regio.read8(s_enable1() + j) {
            j = j + 1
        }
        if j == 8 && (i == 0 || regio.read8(addr_tmp() + i - 1) == 10) {
            return true
        }
        i = i + 1
    }
    return false
}

fn load_token() {
    toklen = 0
    let fd: u64 = io.open(s_tokpath(), 0)
    if errno.failed(fd) {
        return
    }
    let n: u64 = io.read(fd, (&tok[0 as usize]) as u64, 255)
    io.close(fd)
    if errno.failed(n) {
        return
    }
    var m: u64 = n
    while m > 0 && regio.read8((&tok[0 as usize]) as u64 + m - 1) <= 32 {
        m = m - 1
    }
    if m >= 16 {
        toklen = m
    }
}

fn new_nonce() {
    ulib.sys(SYS_GETRANDOM, (&nonce[0 as usize]) as u64, 16, 0)
    var i: u64 = 0
    var z: u64 = 0
    while i < 16 {
        z = z | regio.read8((&nonce[0 as usize]) as u64 + i)
        i = i + 1
    }
    if z == 0 {
        regio.write8((&nonce[0 as usize]) as u64, mono_ms())
    }
}

// ------------------------------------------------------------ commands

fn cmd_hello(id: u64, tp: u64, tl: u64) {
    let v: u64 = tget_num(tp, tl, s_ver(), 0)
    if v != 1 {
        p_reset()
        p_str(s_code(), s_ever())
        p_str(s_msg(), s_unsup_ver())
        p_str(s_supported(), s_one())
        send_final(T_ERR, id)
        return
    }
    new_nonce()
    odbbase.authed = 0
    hexdump((&nonce[0 as usize]) as u64, 16, addr_hex())
    p_reset()
    p_num(s_ver(), 1)
    p_str(s_agent(), s_odbd())
    p_num(s_agentver(), 1)
    p_str(s_os(), product.product())
    p_str(s_features(), s_featlist())
    p_num(s_maxchunk(), odbbase.CHUNK)
    p_num(s_window(), odbbase.WINDOW)
    p_num(s_maxpayload(), MAXP)
    p_str(s_auth(), s_token())
    p_str(s_nonce(), addr_hex())
    send_final(odbbase.T_RESP, id)
}

fn cmd_auth(id: u64, tp: u64, tl: u64) {
    let mac: u64 = tget(tp, tl, s_mac())
    if toklen == 0 || odbbase.g_vlen != 64 {
        fails = fails + 1
        clockapi.sleep_ms(1000)
        reply_err(id, s_eauth(), s_badmac())
        return
    }
    // msg = "ODB1-auth" || nonce
    let m: u64 = addr_tmp()
    copy_bytes(m, s_authtag(), 9)
    copy_bytes(m + 9, (&nonce[0 as usize]) as u64, 16)
    hmac((&tok[0 as usize]) as u64, toklen, m, 25, addr_dig())
    hexdump(addr_dig(), 32, addr_hex())
    var diff: u64 = 0
    var i: u64 = 0
    while i < 64 {
        diff = diff | (regio.read8(addr_hex() + i) ^ regio.read8(mac + i))
        i = i + 1
    }
    if diff != 0 {
        fails = fails + 1
        var d: u64 = 1000
        var k: u64 = 1
        while k < fails && d < 30000 {
            d = d * 2
            k = k + 1
        }
        if d > 30000 {
            d = 30000
        }
        clockapi.sleep_ms(d)
        reply_err(id, s_eauth(), s_badmac())
        return
    }
    fails = 0
    odbbase.authed = 1
    p_reset()
    p_num(s_ok(), 1)
    send_final(odbbase.T_RESP, id)
}

fn cmd_info(id: u64, tp: u64, tl: u64) {
    let win: u64 = tget_num(tp, tl, s_idle_ms(), 0)
    let ncpu: u64 = ulib.sys(ulib.SYS_CPUSTAT, 0, ulib.CS_COUNT, 0)
    var t0: [u64; 16] = [0 as u64; 16]
    var i0: [u64; 16] = [0 as u64; 16]
    var c: u64 = 0
    while c < ncpu && c < 16 {
        t0[c as usize] = ulib.sys(ulib.SYS_CPUSTAT, c, ulib.CS_TICKS, 0)
        i0[c as usize] = ulib.sys(ulib.SYS_CPUSTAT, c, ulib.CS_IDLE, 0)
        c = c + 1
    }
    if win > 0 {
        if win > 30000 {
            clockapi.sleep_ms(30000)
        } else {
            clockapi.sleep_ms(win)
        }
    }
    p_reset()
    p_str(s_os(), product.product())
    p_num(s_kernel(), ulib.sys(ulib.SYS_SYSINFO, ulib.I_VERSION, 0, 0))
    p_num(s_uptime_ms(), ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0) * 10)
    p_num(s_cpus(), ncpu)
    p_num(s_mem_total_kb(), ulib.mem_total_frames() * 4)
    p_num(s_mem_free_kb(), ulib.sys(ulib.SYS_SYSINFO, ulib.I_FRAMES_FREE, 0, 0) * 4)
    var sum_t: u64 = 0
    var sum_i: u64 = 0
    c = 0
    while c < ncpu && c < 16 {
        let t1: u64 = ulib.sys(ulib.SYS_CPUSTAT, c, ulib.CS_TICKS, 0)
        let i1: u64 = ulib.sys(ulib.SYS_CPUSTAT, c, ulib.CS_IDLE, 0)
        var dt: u64 = t1 -% t0[c as usize]
        var di: u64 = i1 -% i0[c as usize]
        if win == 0 {
            dt = t1
            di = i1
        }
        var pct: u64 = 0
        if dt > 0 {
            if di > dt {
                di = dt
            }
            pct = di * 100 / dt
        }
        sum_t = sum_t + dt
        sum_i = sum_i + di
        // idle_core=<n>:<pct>
        var d: [u8; 24] = [0 as u8; 24]
        var n: u64 = text.digits(c, (&d[0 as usize]) as u64, false)
        regio.write8((&d[0 as usize]) as u64 + n, 58)
        n = n + 1 + text.digits(pct, (&d[0 as usize]) as u64 + n + 1, false)
        p_bytes(s_idle_core(), (&d[0 as usize]) as u64, n)
        c = c + 1
    }
    var allpct: u64 = 0
    if sum_t > 0 {
        allpct = sum_i * 100 / sum_t
    }
    p_num(s_idle_pct(), allpct)
    p_num(s_procs(), ulib.sys(ulib.SYS_SYSINFO, ulib.I_TASKS, 0, 0))
    let pn: u64 = procodb_read()
    if pn > 0 {
        let ov: u64 = procodb_num(pn, s_rxov())
        if ov != odbbase.NONE {
            p_num(s_uartov(), ov)
        }
    }
    send_final(odbbase.T_RESP, id)
}

// ---- exec

fn send_data(stream: u64, p: u64, n: u64, id: u64) -> bool {
    // use a local frame build so pb (the pending RESP) is not touched
    let t: u64 = addr_tb()
    regio.write8(t, 0x4F)
    regio.write8(t + 1, 0x44)
    regio.write8(t + 2, 0x42)
    regio.write8(t + 3, 0x31)
    regio.write8(t + 4, 1)
    regio.write8(t + 5, odbbase.T_DATA)
    wr16(t + 6, 0)
    wr32(t + 8, id)
    wr32(t + 12, n + 1)
    regio.write8(t + odbbase.HDRLEN, stream)
    copy_bytes(t + odbbase.HDRLEN + 1, p, n)
    wr32(t + odbbase.HDRLEN + 1 + n, crc32(t, odbbase.HDRLEN + 1 + n))
    return dev_write_all(t, odbbase.HDRLEN + 1 + n + 4)
}

fn send_end(stream: u64, id: u64) {
    var one: [u8; 1] = [0 as u8; 1]
    one[0 as usize] = stream as u8
    send_frame(odbbase.T_END, 0, id, (&one[0 as usize]) as u64, 1)
}

// look for a CANCEL for `id` without blocking
fn check_cancel(id: u64) {
    fill()
    var n: u64 = have_frame()
    while n != 0 {
        let b: u64 = addr_rb()
        if regio.read8(b + 5) == odbbase.T_CANCEL && rd32(b + 8) == id {
            odbbase.cancelled = 1
        } else if regio.read8(b + 5) == odbbase.T_PING {
            send_frame(odbbase.T_PONG, 0, rd32(b + 8), b + odbbase.HDRLEN, rd32(b + 12))
        }
        drop_bytes(n)
        n = have_frame()
    }
}

fn pump_pipe(fd: u64, stream: u64, id: u64) -> u64 {
    let n: u64 = io.read(fd, addr_io(), 8192)
    if errno.failed(n) || n == 0 {
        return 0
    }
    send_data(stream, addr_io(), n, id)
    return n
}

fn has_slash(p: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if regio.read8(p + i) == 47 {
            return true
        }
        i = i + 1
    }
    return false
}

fn cmd_exec(id: u64, tp: u64, tl: u64) {
    // `arg` (repeated): argv without a shell. Program names without a slash are looked up in /bin/.
    var nargs: u64 = 0
    var apos: u64 = 0
    var more: bool = true
    while more && nargs < 16 {
        let av: u64 = tget_at(tp, tl, s_arg(), nargs)
        if odbbase.g_vlen == odbbase.NONE {
            more = false
        } else {
            var need: u64 = odbbase.g_vlen + 1
            var isbin: bool = false
            if nargs == 0 && !has_slash(av, odbbase.g_vlen) {
                need = need + 5
                isbin = true
            }
            if apos + need > 2048 {
                reply_err(id, s_earg(), s_needcmd())
                return
            }
            let base: u64 = (&argb[0 as usize]) as u64
            argv_ptrs[nargs as usize] = base + apos
            if isbin {
                copy_bytes(base + apos, s_bindir(), 5)
                apos = apos + 5
            }
            copy_bytes(base + apos, av, odbbase.g_vlen)
            regio.write8(base + apos + odbbase.g_vlen, 0)
            apos = apos + odbbase.g_vlen + 1
            nargs = nargs + 1
        }
    }
    argv_ptrs[nargs as usize] = 0
    if nargs == 0 {
        if !tget_str(tp, tl, s_cmd(), (&cmdb[0 as usize]) as u64, 2048) {
            reply_err(id, s_earg(), s_needcmd())
            return
        }
    }
    let timeout: u64 = tget_num(tp, tl, s_timeout_ms(), 0)
    let want_in: u64 = tget_num(tp, tl, s_stdin(), 0)
    var have_in: bool = false
    if want_in == 1 {
        // stdin is buffered into a file before the child starts
        let sf: u64 = io.create(s_stdinpath())
        if errno.failed(sf) {
            reply_err(id, s_eio(), s_nostdin())
            return
        }
        var ending: bool = false
        while !ending {
            let n: u64 = wait_frame(10000)
            if n == 0 {
                io.close(sf)
                reply_err(id, s_etimeout(), s_stdinwait())
                return
            }
            let b: u64 = addr_rb()
            let ty: u64 = regio.read8(b + 5)
            let fl: u64 = rd32(b + 12)
            if rd32(b + 8) == id && ty == odbbase.T_DATA && fl >= 1 && regio.read8(b + odbbase.HDRLEN) == 0 {
                io.write_all(sf, b + odbbase.HDRLEN + 1, fl - 1)
            } else if rd32(b + 8) == id && ty == odbbase.T_END && regio.read8(b + odbbase.HDRLEN) == 0 {
                ending = true
            } else if ty == odbbase.T_CANCEL {
                ending = true
            }
            drop_bytes(n)
        }
        io.close(sf)
        have_in = true
    }
    // The command string is written to a script file and run as `sh FILE`: the OrientOS sh has no -c.
    if nargs == 0 {
        let cf: u64 = io.create(s_cmdpath())
        if errno.failed(cf) {
            reply_err(id, s_eio(), s_cantcreate())
            return
        }
        var clen: u64 = 0
        while clen < 2047 && regio.read8((&cmdb[0 as usize]) as u64 + clen) != 0 {
            clen = clen + 1
        }
        regio.write8((&cmdb[0 as usize]) as u64 + clen, 10)
        io.write_all(cf, (&cmdb[0 as usize]) as u64, clen + 1)
        io.close(cf)
    }
    var pi: [u64; 1] = [0 as u64; 1]
    var po: [u64; 1] = [0 as u64; 1]
    var pe: [u64; 1] = [0 as u64; 1]
    io.pipe((&po[0 as usize]) as u64)
    io.pipe((&pe[0 as usize]) as u64)
    pi[0 as usize] = 0
    let outr: u64 = po[0 as usize] & 0xFFFFFFFF
    let outw: u64 = (po[0 as usize] >> 32) & 0xFFFFFFFF
    let errr: u64 = pe[0 as usize] & 0xFFFFFFFF
    let errw: u64 = (pe[0 as usize] >> 32) & 0xFFFFFFFF
    let t0: u64 = mono_ms()
    let kid: u64 = proc.split()
    if errno.failed(kid) {
        reply_err(id, s_einternal(), s_nofork())
        return
    }
    if kid == 0 {
        if have_in {
            let f: u64 = io.open(s_stdinpath(), 0)
            if !errno.failed(f) {
                io.dup2(f, 0)
                io.close(f)
            }
        } else {
            let f2: u64 = io.open(s_devnull(), 0)
            if !errno.failed(f2) {
                io.dup2(f2, 0)
                io.close(f2)
            }
        }
        io.dup2(outw, 1)
        io.dup2(errw, 2)
        io.close(outr)
        io.close(outw)
        io.close(errr)
        io.close(errw)
        if nargs > 0 {
            ulib.sys(59, argv_ptrs[0 as usize], (&argv_ptrs[0 as usize]) as u64, 0)
            proc.leave(127)
        }
        var argv: [u64; 4] = [0 as u64; 4]
        argv[0 as usize] = s_binsh()
        argv[1 as usize] = s_cmdpath()
        argv[2 as usize] = 0
        ulib.sys(59, s_binsh(), (&argv[0 as usize]) as u64, 0)
        proc.leave(127)
    }
    io.close(outw)
    io.close(errw)
    odbbase.cancelled = 0
    var status: [u64; 1] = [0 as u64; 1]
    var done: bool = false
    var exited: bool = false
    var killed: u64 = 0
    var out_open: bool = true
    var err_open: bool = true
    var quiet_after_exit: u64 = 0
    while !done {
        // Read only what poll says is there: a blocking read on a pipe a detached grandchild still holds would freeze
        // the agent (no cancel, no timeout, no other request).
        let f: u64 = (&pfds[0 as usize]) as u64
        var nf: u64 = 0
        var out_slot: u64 = 99
        var err_slot: u64 = 99
        if out_open {
            io.poll_set(f, nf, outr, io.POLLIN)
            out_slot = nf
            nf = nf + 1
        }
        if err_open {
            io.poll_set(f, nf, errr, io.POLLIN)
            err_slot = nf
            nf = nf + 1
        }
        var got_any: bool = false
        if nf > 0 {
            io.poll(f, nf, 20)
            if out_open && io.poll_ready(f, out_slot, io.POLLIN | io.POLLHUP | io.POLLERR) {
                let n: u64 = pump_pipe(outr, 1, id)
                if n == 0 {
                    out_open = false
                } else {
                    got_any = true
                }
            }
            if err_open && io.poll_ready(f, err_slot, io.POLLIN | io.POLLHUP | io.POLLERR) {
                let n2: u64 = pump_pipe(errr, 2, id)
                if n2 == 0 {
                    err_open = false
                } else {
                    got_any = true
                }
            }
        } else {
            clockapi.sleep_ms(20)
        }
        if !exited {
            let w: u64 = kcall.sys4(SYS_WAIT4, kid, (&status[0 as usize]) as u64, WNOHANG, 0)
            if w == kid {
                exited = true
            }
            check_cancel(id)
            if odbbase.cancelled == 1 && killed == 0 {
                ulib.sys(ulib.SYS_KILL, kid, 9, 0)
                killed = 1
            }
            if timeout > 0 && mono_ms() -% t0 > timeout && killed == 0 {
                ulib.sys(ulib.SYS_KILL, kid, 9, 0)
                killed = 2
            }
        } else if got_any {
            quiet_after_exit = 0
        } else {
            // the shell is gone but a detached child keeps the pipes open: 300 ms of silence ends the command
            quiet_after_exit = quiet_after_exit + 1
            if quiet_after_exit > 15 {
                out_open = false
                err_open = false
            }
        }
        if exited && !out_open && !err_open {
            done = true
        }
    }
    io.close(outr)
    io.close(errr)
    if have_in {
        io.unlink(s_stdinpath())
    }
    send_end(1, id)
    send_end(2, id)
    if killed == 1 {
        reply_err(id, s_ecancel(), s_cancelled())
        return
    }
    if killed == 2 {
        reply_err(id, s_etimeout(), s_killedtimeout())
        return
    }
    p_reset()
    p_num(s_exit(), (status[0 as usize] >> 8) & 255)
    p_num(s_signal(), status[0 as usize] & 127)
    p_num(s_time_ms(), mono_ms() -% t0)
    send_final(odbbase.T_RESP, id)
}

// ---- shell (pty)

fn set_winsz(master: u64, cols: u64, rows: u64) {
    var ws: [u8; 8] = [0 as u8; 8]
    let w: u64 = (&ws[0 as usize]) as u64
    wr16(w, rows)
    wr16(w + 2, cols)
    ulib.sys(SYS_IOCTL_N, master, TIOCSWINSZ_N, w)
}

// A REQ that arrives while a shell runs: `resize cols= rows=` is applied, everything else is EBUSY. A repeat of the shell
// REQ itself (RETRY) is ignored.
fn shell_side_req(sid: u64, fid: u64, master: u64) {
    if fid == sid {
        return
    }
    let b: u64 = addr_rb()
    let plen: u64 = rd32(b + 12)
    let cl: u64 = regio.read8(b + odbbase.HDRLEN)
    if plen < 1 || 1 + cl > plen {
        reply_err(fid, s_eproto(), s_badreq())
        return
    }
    if same_str(b + odbbase.HDRLEN + 1, cl, s_resize()) {
        let tp: u64 = b + odbbase.HDRLEN + 1 + cl
        let tl: u64 = plen - 1 - cl
        let c: u64 = tget_num(tp, tl, s_cols(), 0)
        let r: u64 = tget_num(tp, tl, s_rows(), 0)
        if c > 0 && r > 0 {
            set_winsz(master, c, r)
        }
        p_reset()
        p_num(s_ok(), 1)
        send_final(odbbase.T_RESP, fid)
        return
    }
    reply_err(fid, s_ebusy(), s_shellbusy())
}

// Frames for a running shell: stdin DATA -> pty master, END(stdin) -> ^D, CANCEL -> cancelled, PING -> PONG.
fn shell_frames(id: u64, master: u64) {
    fill()
    var n: u64 = have_frame()
    while n != 0 {
        let b: u64 = addr_rb()
        let ty: u64 = regio.read8(b + 5)
        let fid: u64 = rd32(b + 8)
        let plen: u64 = rd32(b + 12)
        if ty == odbbase.T_CANCEL && fid == id {
            odbbase.cancelled = 1
        } else if ty == odbbase.T_PING {
            send_frame(odbbase.T_PONG, 0, fid, b + odbbase.HDRLEN, plen)
        } else if ty == odbbase.T_DATA && fid == id && plen >= 2 && regio.read8(b + odbbase.HDRLEN) == 0 {
            io.write_all(master, b + odbbase.HDRLEN + 1, plen - 1)
        } else if ty == odbbase.T_END && fid == id && plen >= 1 && regio.read8(b + odbbase.HDRLEN) == 0 {
            var eof: [u8; 1] = [4 as u8; 1]
            io.write_all(master, (&eof[0 as usize]) as u64, 1)
        } else if ty == odbbase.T_REQ {
            shell_side_req(id, fid, master)
        }
        drop_bytes(n)
        n = have_frame()
    }
}

fn cmd_shell(id: u64, tp: u64, tl: u64) {
    let cols: u64 = tget_num(tp, tl, s_cols(), 80)
    let rows: u64 = tget_num(tp, tl, s_rows(), 24)
    var have_cmd: bool = false
    if tget_str(tp, tl, s_cmd(), (&cmdb[0 as usize]) as u64, 2048) {
        have_cmd = true
        // the OrientOS sh has no -c: the command goes to a script file
        let cf: u64 = io.create(s_cmdpath())
        if errno.failed(cf) {
            reply_err(id, s_eio(), s_cantcreate())
            return
        }
        var clen: u64 = 0
        while clen < 2047 && regio.read8((&cmdb[0 as usize]) as u64 + clen) != 0 {
            clen = clen + 1
        }
        regio.write8((&cmdb[0 as usize]) as u64 + clen, 10)
        io.write_all(cf, (&cmdb[0 as usize]) as u64, clen + 1)
        io.close(cf)
    }
    var pf: [u64; 1] = [0 as u64; 1]
    let pr: u64 = kcall.sys1(SYS_OSUM_PTY_N, (&pf[0 as usize]) as u64)
    if errno.is_error(pr) {
        reply_err(id, s_einternal(), s_nopty())
        return
    }
    let master: u64 = pf[0 as usize] & 0xFFFFFFFF
    let slave: u64 = (pf[0 as usize] >> 32) & 0xFFFFFFFF
    set_winsz(master, cols, rows)
    let t0: u64 = mono_ms()
    let kid: u64 = proc.split()
    if errno.failed(kid) {
        io.close(master)
        io.close(slave)
        reply_err(id, s_einternal(), s_nofork())
        return
    }
    if kid == 0 {
        io.dup2(slave, 0)
        io.dup2(slave, 1)
        io.dup2(slave, 2)
        io.close(slave)
        io.close(master)
        var argv: [u64; 4] = [0 as u64; 4]
        argv[0 as usize] = s_binsh()
        if have_cmd {
            argv[1 as usize] = s_cmdpath()
        }
        ulib.sys(59, s_binsh(), (&argv[0 as usize]) as u64, 0)
        proc.leave(127)
    }
    io.close(slave)
    odbbase.cancelled = 0
    var status: [u64; 1] = [0 as u64; 1]
    var exited: bool = false
    var out_open: bool = true
    var killed: u64 = 0
    var quiet: u64 = 0
    while out_open {
        let f: u64 = (&pfds[0 as usize]) as u64
        io.poll_set(f, 0, master, io.POLLIN)
        io.poll(f, 1, 20)
        var got_any: bool = false
        if io.poll_ready(f, 0, io.POLLIN | io.POLLHUP | io.POLLERR) {
            let n: u64 = pump_pipe(master, 1, id)
            if n == 0 {
                out_open = false
            } else {
                got_any = true
            }
        }
        if !exited {
            let w: u64 = kcall.sys4(SYS_WAIT4, kid, (&status[0 as usize]) as u64, WNOHANG, 0)
            if w == kid {
                exited = true
            }
            shell_frames(id, master)
            if odbbase.cancelled == 1 && killed == 0 {
                ulib.sys(ulib.SYS_KILL, kid, 9, 0)
                killed = 1
            }
        } else if got_any {
            quiet = 0
        } else {
            // shell gone: drain what is left, 300 ms of silence ends the session
            quiet = quiet + 1
            if quiet > 15 {
                out_open = false
            }
        }
    }
    io.close(master)
    if have_cmd {
        io.unlink(s_cmdpath())
    }
    send_end(1, id)
    if killed == 1 {
        reply_err(id, s_ecancel(), s_cancelled())
        return
    }
    p_reset()
    p_num(s_exit(), (status[0 as usize] >> 8) & 255)
    p_num(s_signal(), status[0 as usize] & 127)
    p_num(s_time_ms(), mono_ms() -% t0)
    send_final(odbbase.T_RESP, id)
}

// ---- push / pull

fn send_ack(id: u64, next: u64) {
    var a: [u8; 9] = [0 as u8; 9]
    regio.write8((&a[0 as usize]) as u64, 3)
    wr64((&a[0 as usize]) as u64 + 1, next)
    send_frame(odbbase.T_ACK, 0, id, (&a[0 as usize]) as u64, 9)
}
