profile kernel

const HDRLEN: u64 = 16

const CHUNK: u64 = 8192   // small frames: an ACK comes often enough that the host's 2 s rewind timer never fires at ~17 KiB/s

const WINDOW: u64 = 8192   // == CHUNK: one frame in flight both ways (VBox uart2 has no flow control; the agent loses the head of the next frame while it writes/reads one)

const T_REQ: u64 = 1

const T_RESP: u64 = 2

const T_DATA: u64 = 3

const T_END: u64 = 4

const T_PING: u64 = 6

const T_PONG: u64 = 7

const T_CANCEL: u64 = 8

const T_ACK: u64 = 9

const NONE: u64 = 0xFFFFFFFF

static mut rlen: u64 = 0

static mut lastbuf: [u8; 4096] = [0 as u8; 4096]

static mut lastlen: u64 = 0

static mut lasttype: u64 = 0

static mut lastid: u64 = 0

static mut dev: u64 = 0

static mut authed: u64 = 0

static mut g_vlen: u64 = 0

static mut g_crc: u64 = 0

static mut g_size: u64 = 0

static mut cancelled: u64 = 0

// ------------------------------------------------------------ frames in

static mut g_last_rx: u64 = 0
