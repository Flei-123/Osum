// kernel/user/busydemo.fi -- exercises kernel/user/busy.fi for tools/busy/run.sh.
profile app

import ulib
import fuiapp
import fuiscene
import busy

export { u_start }

static mut t_title: [u8; 10] = "Busy demo\0"
static mut t_wait: [u8; 12] = "Please wait\0"
static mut t_copy: [u8; 14] = "Copying files\0"
static mut t_atitle: [u8; 6] = "Alert\0"
static mut t_atext: [u8; 20] = "Something happened.\0"
static mut t_ctext: [u8; 11] = "Delete it?\0"
static mut t_ready: [u8; 16] = "busydemo: ready\0"
static mut t_spinner: [u8; 18] = "busydemo: spinner\0"
static mut t_pct: [u8; 15] = "busydemo: pct=\0"
static mut t_indet: [u8; 16] = "busydemo: indet\0"
static mut t_cwait: [u8; 22] = "busydemo: cancel-wait\0"
static mut t_cdone: [u8; 21] = "busydemo: cancelled=\0"
static mut t_run: [u8; 15] = "busydemo: run \0"
static mut t_steps: [u8; 8] = " steps=\0"
static mut t_rcwait: [u8; 26] = "busydemo: run-cancel-wait\0"
static mut t_await: [u8; 21] = "busydemo: alert-wait\0"
static mut t_aclosed: [u8; 23] = "busydemo: alert-closed\0"
static mut t_cfwait: [u8; 23] = "busydemo: confirm-wait\0"
static mut t_cf: [u8; 19] = "busydemo: confirm=\0"
static mut t_geom: [u8; 18] = "busydemo: geom w=\0"
static mut t_geomh: [u8; 4] = " h=\0"
static mut t_geoms: [u8; 4] = " s=\0"
static mut t_done: [u8; 15] = "busydemo: done\0"
static mut t_ok: [u8; 6] = "ok r=\0"
static mut t_to: [u8; 11] = "timeout r=\0"
static mut t_ca: [u8; 10] = "cancel r=\0"

static mut g_steps: u64 = 0
static mut g_phase: u64 = 0

fn say(p: u64) {
    let _r: u64 = ulib.say(p)
}

fn build() {
    let col: usize = fuiscene.root()
    let _l: usize = fuiscene.label(col, (&t_title[0 as usize]) as u64)
}

fn hold(ms: u64) {
    let t0: u64 = fuiapp.now_ms()
    while fuiscene.alive() && fuiapp.now_ms() < t0 + ms {
        let _c: bool = busy.tick()
    }
}

fn mark_n(label: u64, v: u64) {
    say(label)
    ulib.sayn(v)
    ulib.nl()
}

fn mark(label: u64) {
    say(label)
    ulib.nl()
}

fn step_count(ud: u64) -> u64 {
    g_steps = g_steps + 1
    let _s: u64 = ulib.sleep_ms(20)
    if g_steps >= 25 {
        return busy.STEP_DONE
    }
    busy.report((g_steps * 4) as i64)
    return busy.STEP_MORE
}

fn step_forever(ud: u64) -> u64 {
    g_steps = g_steps + 1
    let _s: u64 = ulib.sleep_ms(20)
    return busy.STEP_MORE
}

fn run_report(kind: u64, r: u64) {
    say((&t_run[0 as usize]) as u64)
    say(kind)
    ulib.sayn(r)
    say((&t_steps[0 as usize]) as u64)
    ulib.sayn(g_steps)
    ulib.nl()
}

fn pct_phase(pct: i64) {
    let _c: bool = busy.progress((&t_title[0 as usize]) as u64, (&t_copy[0 as usize]) as u64, pct, false)
    mark_n((&t_pct[0 as usize]) as u64, pct as u64)
    hold(3500)
}

fn u_start(args: u64) -> u64 {
    if !fuiscene.open(60, 60, 640, 420, (&t_title[0 as usize]) as u64, build) {
        return 1
    }
    hold(600)
    mark((&t_ready[0 as usize]) as u64)
    busy.spinner((&t_title[0 as usize]) as u64, (&t_wait[0 as usize]) as u64, false)
    say((&t_geom[0 as usize]) as u64)
    ulib.sayn(fuiscene.dialog_w())
    say((&t_geomh[0 as usize]) as u64)
    ulib.sayn(fuiscene.dialog_h())
    say((&t_geoms[0 as usize]) as u64)
    ulib.sayn(fuiscene.scale())
    ulib.nl()
    mark((&t_spinner[0 as usize]) as u64)
    hold(6000)
    busy.close()
    pct_phase(0)
    pct_phase(30)
    pct_phase(70)
    pct_phase(100)
    busy.close()
    let _c1: bool = busy.progress((&t_title[0 as usize]) as u64, (&t_copy[0 as usize]) as u64, busy.PCT_INDETERMINATE, false)
    mark((&t_indet[0 as usize]) as u64)
    hold(6000)
    busy.close()
    let _c2: bool = busy.progress((&t_title[0 as usize]) as u64, (&t_copy[0 as usize]) as u64, 50, true)
    mark((&t_cwait[0 as usize]) as u64)
    var waited: u64 = 0
    while fuiscene.alive() && !busy.cancelled() && waited < 15000 {
        let _c3: bool = busy.tick()
        waited = waited + 10
        let _s: u64 = ulib.sleep_ms(10)
    }
    mark_n((&t_cdone[0 as usize]) as u64, busy.cancelled() as u64)
    busy.close()
    g_steps = 0
    let r1: u64 = busy.run((&t_title[0 as usize]) as u64, (&t_wait[0 as usize]) as u64, step_count, 0, 0, false)
    run_report((&t_ok[0 as usize]) as u64, r1)
    g_steps = 0
    let r2: u64 = busy.run((&t_title[0 as usize]) as u64, (&t_wait[0 as usize]) as u64, step_forever, 0, 600, false)
    run_report((&t_to[0 as usize]) as u64, r2)
    g_steps = 0
    mark((&t_rcwait[0 as usize]) as u64)
    let r3: u64 = busy.run((&t_title[0 as usize]) as u64, (&t_wait[0 as usize]) as u64, step_forever, 0, 20000, true)
    run_report((&t_ca[0 as usize]) as u64, r3)
    mark((&t_await[0 as usize]) as u64)
    busy.alert((&t_atitle[0 as usize]) as u64, (&t_atext[0 as usize]) as u64)
    mark((&t_aclosed[0 as usize]) as u64)
    mark((&t_cfwait[0 as usize]) as u64)
    let yes: bool = busy.confirm((&t_atitle[0 as usize]) as u64, (&t_ctext[0 as usize]) as u64)
    var yn: u64 = 0
    if yes {
        yn = 1
    }
    mark_n((&t_cf[0 as usize]) as u64, yn)
    mark((&t_done[0 as usize]) as u64)
    fuiscene.quit()
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
