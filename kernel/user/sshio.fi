profile kernel

import ssh.session

export { recv_some, recv_exact }

const RECV_MS: u64 = 30000
const TIMEOUTS_MAX: u64 = 4

fn recv_some(out: u64, cap: u64) -> u64 {
    var idle: u64 = 0
    while idle < TIMEOUTS_MAX {
        let r: u64 = session.chan_recv(out, cap, RECV_MS, session.NO_FD)
        if r != session.TIMEOUT {
            if r == session.FAILED {
                return 0
            }
            return r
        }
        idle = idle + 1
    }
    return 0
}

fn recv_exact(out: u64, n: u64) -> bool {
    var got: u64 = 0
    while got < n {
        let r: u64 = recv_some(out + got, n - got)
        if r == 0 {
            return false
        }
        got = got + r
    }
    return true
}
