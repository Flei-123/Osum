profile kernel

export { COUNT, C_NAME, C_STATE, C_CPU, C_MEM, C_DISK, C_NET, C_GPU, layout, width, numeric, ranked }

const COUNT: u64 = 7
const C_NAME: u64 = 0
const C_STATE: u64 = 1
const C_CPU: u64 = 2
const C_MEM: u64 = 3
const C_DISK: u64 = 4
const C_NET: u64 = 5
const C_GPU: u64 = 6

static mut fixed_w: [u64; 7] = [0 as u64; 7]
static mut cur_w: [u64; 7] = [0 as u64; 7]

fn layout(total: u64) {
    fixed_w[(C_STATE) as usize] = 104
    fixed_w[(C_CPU) as usize] = 84
    fixed_w[(C_MEM) as usize] = 108
    fixed_w[(C_DISK) as usize] = 84
    fixed_w[(C_NET) as usize] = 92
    fixed_w[(C_GPU) as usize] = 76
    var rest: u64 = 0
    var c: u64 = 1
    while c < COUNT {
        rest = rest + fixed_w[(c) as usize]
        c = c + 1
    }
    var name_w: u64 = 160
    if total > rest + 2 + 160 {
        name_w = (total - rest - 2) / 4 * 4
    }
    cur_w[(C_NAME) as usize] = name_w
    c = 1
    while c < COUNT {
        cur_w[(c) as usize] = fixed_w[(c) as usize]
        c = c + 1
    }
}

fn width(c: u64) -> u64 {
    if c >= COUNT {
        return 0
    }
    return cur_w[(c) as usize]
}

fn numeric(c: u64) -> bool {
    return c >= C_CPU
}

fn ranked(c: u64) -> bool {
    return c <= C_MEM
}
