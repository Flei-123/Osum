profile app

import ulib
import libc.io
import libc.octets
import autostartsrc
import autostart.model

export { prepare, allowed, start_packages }

const MAX_ARGS: u64 = 2

static mut MARKER: [u8; 26] = "/run/autostart.pkg.done\0\0\0"
static mut argv: [u64; 2] = [0 as u64; 2]

fn prepare() {
    let _n: u64 = autostartsrc.load()
}

fn allowed(name: u64) -> bool {
    return model.should_start(name, octets.cstr_len(name))
}

fn marker_present() -> bool {
    let fd: u64 = io.open((&MARKER[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return false
    }
    io.close(fd)
    return true
}

fn mark_done() {
    let fd: u64 = io.create((&MARKER[0 as usize]) as u64)
    if !ulib.bad(fd) {
        io.close(fd)
    }
}

fn start_one(i: u64) -> bool {
    let path: u64 = autostartsrc.package_start(i)
    if path == 0 {
        return false
    }
    argv[0 as usize] = path
    argv[1 as usize] = 0
    return !ulib.bad(ulib.spawn_app(path, (&argv[0 as usize]) as u64, 1))
}

fn start_packages() -> u64 {
    if marker_present() {
        return 0
    }
    mark_done()
    prepare()
    var started: u64 = 0
    var i: u64 = 0
    while i < model.count() {
        if model.kind(i) == model.KIND_PACKAGE && model.enabled(i) && start_one(i) {
            started = started + 1
        }
        i = i + 1
    }
    return started
}
