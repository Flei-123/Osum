//     name:x:gid:mitglied,mitglied,mitglied

profile kernel

import ulib
import libc.text
import pw

export { groups_of_name, group_name_of, gid_of_group, initgroups }

static mut grbuf: [u8; 4096] = [0 as u8; 4096]

fn load_group() -> u64 {
    var p: [u8; 11] = "/etc/group\0"
    return pw.read_all((&p[0]) as u64, (&grbuf[0]) as u64, 4096)
}

fn in_members(list: u64, name: u64) -> bool {
    let nl: u64 = text.length(name)
    var at: u64 = 0
    var going: bool = true
    while going {
        if *((list + at) as *mut u8) == 0 as u8 {
            going = false
        } else {
            var e: u64 = at
            while *((list + e) as *mut u8) != 0 as u8
                && *((list + e) as *mut u8) != 44 as u8 {
                e = e + 1
            }
            if e - at == nl {
                if ulib.strneq(list + at, name, nl) {
                    return true
                }
            }
            if *((list + e) as *mut u8) == 0 as u8 {
                going = false
            } else {
                at = e + 1
            }
        }
    }
    return false
}

fn groups_of_name(name: u64, out: u64, max: u64) -> u64 {
    if load_group() == ulib.EOF {
        return 0
    }
    var line: [u8; 256] = [0 as u8; 256]
    var f: [u8; 192] = [0 as u8; 192]
    var n: u64 = 0
    var i: u64 = 0
    let cnt: u64 = pw.lines_of((&grbuf[0]) as u64)
    while i < cnt {
        if pw.line_at((&grbuf[0]) as u64, i, (&line[0]) as u64, 256)
            != ulib.EOF {
            if pw.field((&line[0]) as u64, 3, (&f[0]) as u64, 192) {
                if in_members((&f[0]) as u64, name) {
                    var g: [u8; 32] = [0 as u8; 32]
                    if pw.field((&line[0]) as u64, 2, (&g[0]) as u64, 32) {
                        if n < max {
                            __mmio_write64((out + n * 8) as *mut u64,
                                ulib.to_num((&g[0]) as u64))
                            n = n + 1
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return n
}

fn group_name_of(gid: u64, out: u64, max: u64) -> bool {
    if load_group() == ulib.EOF {
        return false
    }
    var line: [u8; 256] = [0 as u8; 256]
    var f: [u8; 64] = [0 as u8; 64]
    var i: u64 = 0
    let cnt: u64 = pw.lines_of((&grbuf[0]) as u64)
    while i < cnt {
        if pw.line_at((&grbuf[0]) as u64, i, (&line[0]) as u64, 256)
            != ulib.EOF {
            if pw.field((&line[0]) as u64, 2, (&f[0]) as u64, 64) {
                if ulib.to_num((&f[0]) as u64) == gid {
                    return pw.field((&line[0]) as u64, 0, out, max)
                }
            }
        }
        i = i + 1
    }
    return false
}

fn gid_of_group(name: u64) -> u64 {
    if load_group() == ulib.EOF {
        return ulib.EOF
    }
    var line: [u8; 256] = [0 as u8; 256]
    var f: [u8; 64] = [0 as u8; 64]
    var i: u64 = 0
    let cnt: u64 = pw.lines_of((&grbuf[0]) as u64)
    while i < cnt {
        if pw.line_at((&grbuf[0]) as u64, i, (&line[0]) as u64, 256)
            != ulib.EOF {
            if pw.field((&line[0]) as u64, 0, (&f[0]) as u64, 64) {
                if ulib.streq((&f[0]) as u64, name) {
                    var g: [u8; 32] = [0 as u8; 32]
                    if pw.field((&line[0]) as u64, 2, (&g[0]) as u64, 32) {
                        return ulib.to_num((&g[0]) as u64)
                    }
                }
            }
        }
        i = i + 1
    }
    return ulib.EOF
}

fn initgroups(name: u64) -> u64 {
    var g: [u64; 16] = [0 as u64; 16]
    let n: u64 = groups_of_name(name, (&g[0]) as u64, 16)
    return ulib.sys(116, n, (&g[0]) as u64, 0)
}
