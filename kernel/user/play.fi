
profile kernel

import libc.memcopy
import ulib
import libc.text
import libc.kcall
import libc.clockapi
import media
import mp3
import playsess

export { u_start }

const SYS_AUDGET: u64 = 1850
const SYS_AUDSET: u64 = 1851
const SYS_AUDWRITE: u64 = 1852
const SYS_AUDOPEN: u64 = 1853
const SYS_AUDSEND: u64 = 1854

const A_READY: u64 = 0
const A_RATE: u64 = 1
const A_CHANNELS: u64 = 2
const A_BITS: u64 = 3
const A_PLAYED: u64 = 5
const A_WRITTEN: u64 = 6
const A_UNDERRUNS: u64 = 7
const A_LATENCY: u64 = 8
const A_WHY: u64 = 16
const A_BACKEND: u64 = 15
const A_REMAIN: u64 = 25
const A_STREAMS: u64 = 30
const A_MIXED: u64 = 31
const A_CLIPS: u64 = 32
const A_SYSSOUNDS: u64 = 49
const A_LOST: u64 = 42
const A_ZEROED: u64 = 43
const A_GAPMAX: u64 = 50
const A_SYSUS: u64 = 51
const A_WALLUS: u64 = 52
const A_CALLS: u64 = 53
const A_MINFILL: u64 = 48
const A_LOCKSPIN: u64 = 47

const AS_OPEN: u64 = 1
const AS_DRAIN: u64 = 3
const AS_STOP: u64 = 4
const AS_RATE: u64 = 7
const AS_CLOSE: u64 = 8
const AS_END: u64 = 9
const AS_PUMP: u64 = 11
const AS_WAITSPACE: u64 = 15
const AS_VOLUME: u64 = 0
const AS_SVOL: u64 = 10
const AS_SOUND: u64 = 12

const CHUNK: u64 = 1024

const BUF_FRAMES: u64 = 1152
static mut buf: [u8; 4608] = [0 as u8; 4608]
const RAWSZ: u64 = 65536

const SYS_CLOCK_GETTIME: u64 = 228
const CLOCK_MONOTONIC: u64 = 1

fn now_us() -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    if ulib.bad(ulib.sys(SYS_CLOCK_GETTIME, CLOCK_MONOTONIC,
        (&ts[0]) as u64, 0)) {
        return 0
    }
    return ts[0 as usize] *% 1000000 +% (ts[1 as usize] / 1000)
}
static mut raw: [u8; 65536] = [0 as u8; 65536]
static mut rawlen: u64 = 0
static mut rawpos: u64 = 0
static mut wfd: u64 = 0

static mut w_rate: u64 = 0
static mut w_ch: u64 = 0
static mut w_bits: u64 = 0
static mut w_off: u64 = 0
static mut w_len: u64 = 0

fn tag4(at: u64, a: u64, b: u64, c: u64, d: u64) -> bool {
    return media.src_byte(at) == a && media.src_byte(at + 1) == b
        && media.src_byte(at + 2) == c && media.src_byte(at + 3) == d
}

fn wav_probe() -> bool {
    if media.src_size() < 44 {
        return false
    }
    return tag4(0, 82, 73, 70, 70) && tag4(8, 87, 65, 86, 69)
}

fn wav_open() -> bool {
    w_rate = 0
    w_ch = 0
    w_bits = 0
    w_off = 0
    w_len = 0
    var at: u64 = 12
    let ende: u64 = media.src_size()
    while at + 8 <= ende {
        let len: u64 = media.le32(at + 4)
        if tag4(at, 102, 109, 116, 32) {
            w_ch = media.le16(at + 10)
            w_rate = media.le32(at + 12)
            w_bits = media.le16(at + 22)
        }
        if tag4(at, 100, 97, 116, 97) {
            w_off = at + 8
            w_len = len
            if w_off + w_len > ende {
                w_len = ende - w_off
            }
        }
        at = at + 8 + len + (len & 1)
    }
    return w_rate > 0 && w_ch > 0 && w_bits == 16 && w_len > 0
}

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 40] = "Verwendung: play [-i] [-1] <datei>\0\0\0\0\0\0"
    var s_noopen: [u8; 25] = "play: file not readable\0\0"
    var s_nofmt: [u8; 40] = "play: weder WAV (16 Bit) noch MP3\0\0\0\0\0\0\0"
    var s_nodev: [u8; 36] = "play: no sound device, reason \0\0\0\0\0\0"
    var s_kind: [u8; 8] = "  art: \0"
    var s_wav: [u8; 4] = "wav\0"
    var s_mp3: [u8; 4] = "mp3\0"
    var s_rate: [u8; 9] = "  rate: \0"
    var s_ch: [u8; 12] = "  kanaele: \0"
    var s_ms: [u8; 13] = "  duration: \0"
    var s_msu: [u8; 4] = " ms\0"
    var s_dr: [u8; 15] = "  geraetrate: \0"  // DRAHT: wire field
    var s_fr: [u8; 12] = "  frames: \0\0"
    var s_pl: [u8; 13] = "  gespielt: \0"
    var s_un: [u8; 14] = "  aussetzer: \0"
    var s_lat: [u8; 14] = "  latenz_us: \0"
    var s_bk: [u8; 13] = "  treiber: \0\0"
    var s_id: [u8; 11] = "  stream: \0"
    var s_sv: [u8; 14] = "  stromvol: \0\0"
    var s_mv: [u8; 14] = "  mastervol: \0"
    var s_v1: [u8; 46] = "play: -v only works through the mixer, not -1\0"
    var s_mx: [u8; 13] = "  gemischt: \0"
    var s_cl: [u8; 13] = "  begrenzt: \0"
    var s_kl: [u8; 14] = "  klick gab: \0"
    var s_sk: [u8; 18] = "  systemklaenge: \0"  // DRAHT: wire field
    var opt_i: [u8; 3] = "-i\0"
    var opt_1: [u8; 3] = "-1\0"
    var opt_w: [u8; 3] = "-w\0"
    var opt_v: [u8; 3] = "-v\0"
    var opt_k: [u8; 3] = "-k\0"
    var opt_m: [u8; 3] = "-m\0"

    let argc: u64 = ulib.arg_count(args)
    var only_info: bool = false
    var einstrom: bool = false
    var wdh: u64 = 1
    var svol: u64 = 101
    var mvol: u64 = 101
    var klick_bei: u64 = 0
    var k: u64 = 1
    while k < argc {
        let a: u64 = ulib.arg_at(args, k)
        if ulib.streq(a, (&opt_i[0 as usize]) as u64) {
            only_info = true
            k = k + 1
        } else if ulib.streq(a, (&opt_1[0 as usize]) as u64) {
            einstrom = true
            k = k + 1
        } else if ulib.streq(a, (&opt_w[0 as usize]) as u64)
            && k + 1 < argc {
            wdh = ulib.to_num(ulib.arg_at(args, k + 1))
            if wdh == 0 {
                wdh = 1
            }
            k = k + 2
        } else if ulib.streq(a, (&opt_v[0 as usize]) as u64)
            && k + 1 < argc {
            svol = ulib.to_num(ulib.arg_at(args, k + 1))
            k = k + 2
        } else if ulib.streq(a, (&opt_m[0 as usize]) as u64)
            && k + 1 < argc {
            mvol = ulib.to_num(ulib.arg_at(args, k + 1))
            k = k + 2
        } else if ulib.streq(a, (&opt_k[0 as usize]) as u64)
            && k + 1 < argc {
            klick_bei = ulib.to_num(ulib.arg_at(args, k + 1))
            k = k + 2
        } else {
            k = argc
        }
    }
    var path: u64 = 0
    var j: u64 = 1
    while j < argc {
        let a: u64 = ulib.arg_at(args, j)
        if ulib.streq(a, (&opt_w[0 as usize]) as u64)
            || ulib.streq(a, (&opt_v[0 as usize]) as u64)
            || ulib.streq(a, (&opt_m[0 as usize]) as u64)
            || ulib.streq(a, (&opt_k[0 as usize]) as u64) {
            j = j + 1
        } else if !ulib.streq(a, (&opt_i[0 as usize]) as u64)
            && !ulib.streq(a, (&opt_1[0 as usize]) as u64) {
            if path == 0 {
                path = a
            }
        }
        j = j + 1
    }
    if path == 0 {
        ulib.say((&s_use[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    if !media.src_open(path) {
        ulib.esay_line((&s_noopen[0 as usize]) as u64, 0)
        return 1
    }

    var ist_wav: bool = false
    var rate: u64 = 0
    var nch: u64 = 0
    var dur: u64 = 0
    var frame: u64 = 0
    if wav_probe() && wav_open() {
        ist_wav = true
        rate = w_rate
        nch = w_ch
        frame = w_len / (2 * w_ch)
        if rate > 0 {
            dur = (frame * 1000) / rate
        }
        ulib.say((&s_kind[0 as usize]) as u64)
        ulib.say((&s_wav[0 as usize]) as u64)
        ulib.nl()
    } else if mp3.mp3_probe() && mp3.mp3_open() {
        rate = mp3.mp3_rate()
        nch = mp3.mp3_channels()
        dur = mp3.mp3_dur_ms()
        if rate > 0 {
            frame = (dur * rate) / 1000
        }
        ulib.say((&s_kind[0 as usize]) as u64)
        ulib.say((&s_mp3[0 as usize]) as u64)
        ulib.nl()
    } else {
        ulib.esay_line((&s_nofmt[0 as usize]) as u64, 0)
        media.src_close()
        return 1
    }
    ulib.say((&s_rate[0 as usize]) as u64)
    ulib.sayu(rate)
    ulib.nl()
    ulib.say((&s_ch[0 as usize]) as u64)
    ulib.sayu(nch)
    ulib.nl()
    ulib.say((&s_ms[0 as usize]) as u64)
    ulib.sayu(dur)
    ulib.say((&s_msu[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&s_fr[0 as usize]) as u64)
    ulib.sayu(frame)
    ulib.nl()
    if only_info {
        media.src_close()
        return 0
    }

    if ulib.sys(SYS_AUDGET, A_READY, 0, 0) != 1 {
        ulib.esay_line((&s_nodev[0 as usize]) as u64,
            ulib.sys(SYS_AUDGET, A_WHY, 0, 0))
        media.src_close()
        return 1
    }

    var stream: u64 = 0
    if einstrom {
        ulib.sys(SYS_AUDSET, AS_RATE, rate, 0)
        if ulib.bad(ulib.sys(SYS_AUDSET, AS_OPEN, 1, 0)) {
            var s_busy: [u8; 31] = "play: device is busy (-1)\0\0\0\0\0\0"
            ulib.esay_line((&s_busy[0 as usize]) as u64, 0)
            media.src_close()
            return 1
        }
    } else {
        let id: u64 = ulib.sys(SYS_AUDOPEN, rate, 0, 0)
        if ulib.bad(id) {
            var s_full: [u8; 35] = "play: no stream free (four open)\0\0\0"
            ulib.esay_line((&s_full[0 as usize]) as u64, 0)
            media.src_close()
            return 1
        }
        stream = id
        var zbuf: [u8; 32] = [0 as u8; 32]
        let zb: u64 = (&zbuf[0 as usize]) as u64
        var za: u64 = ulib.strncpy(zb, (&s_id[0 as usize]) as u64, 24)
        za = za + text.digits(stream, zb + za, true)
        zbuf[za as usize] = 10 as u8
        zbuf[(za + 1) as usize] = 0 as u8
        ulib.say(zb)
    }
    if svol <= 100 {
        if einstrom {
            ulib.esay_line((&s_v1[0 as usize]) as u64, 0)
        } else {
            ulib.sys(SYS_AUDSET, AS_SVOL, (stream << 8) | svol, 0)
            ulib.say((&s_sv[0 as usize]) as u64)
            ulib.sayu(svol)
            ulib.nl()
        }
    }
    if mvol <= 100 {
        ulib.sys(SYS_AUDSET, AS_VOLUME, mvol, 0)
        ulib.say((&s_mv[0 as usize]) as u64)
        ulib.sayu(mvol)
        ulib.nl()
    }
    let grate: u64 = ulib.sys(SYS_AUDGET, A_RATE, 0, 0)
    ulib.say((&s_dr[0 as usize]) as u64)
    ulib.sayu(grate)
    ulib.nl()

    if ist_wav {
        wfd = ulib.sys(ulib.SYS_OPEN, path, 0, 0)
        if ulib.bad(wfd) {
            ulib.esay_line((&s_noopen[0 as usize]) as u64, 0)
            media.src_close()
            return 1
        }
        ulib.sys(ulib.SYS_SEEK, wfd, w_off, 0)
    }

    var sent: u64 = 0
    var lauf: bool = true
    var source: u64 = w_off
    var rest: u64 = w_len
    var schub: u64 = 0
    var runden_uebrig: u64 = wdh
    var us_read: u64 = 0
    var us_compute: u64 = 0
    var us_auf: u64 = 0
    var us_wait: u64 = 0
    var us_send: u64 = 0
    var us_start: u64 = now_us()
    var wart: u64 = 0
    playsess.begin(path)
    while lauf {
        if playsess.step() == playsess.STOP {
            lauf = false
        }
        let t_a: u64 = now_us()
        var n: u64 = 0
        let dst: u64 = (&buf[0 as usize]) as u64
        if ist_wav {
            var m: u64 = CHUNK
            let da: u64 = rest / (2 * nch)
            if m > da {
                m = da
            }
            if m > 0 {
                let roh0: u64 = (&raw[0 as usize]) as u64
                var will: u64 = m * 2 * nch
                if rawpos + will > rawlen {
                    let uebrig: u64 = rawlen -% rawpos
                    if uebrig > 0 {
                        memcopy.copy(roh0, roh0 + rawpos, uebrig)
                    }
                    let t_r: u64 = now_us()
                    let new: u64 = ulib.sys(ulib.SYS_READ, wfd,
                        roh0 + uebrig, RAWSZ - uebrig)
                    us_read = us_read +% (now_us() -% t_r)
                    if ulib.bad(new) {
                        rawlen = uebrig
                    } else {
                        rawlen = uebrig + new
                    }
                    rawpos = 0
                }
                let roh: u64 = roh0 + rawpos
                var hab: u64 = will
                if rawpos + will > rawlen {
                    hab = rawlen -% rawpos
                }
                if hab == 0 {
                    rest = 0
                    lauf = false
                    m = 0
                } else {
                    rawpos = rawpos + hab
                    m = hab / (2 * nch)
                    if nch == 2 {
                        memcopy.copy(dst, roh, m * 4)
                    } else {
                        mono_to_stereo(roh, dst, m)
                    }
                    source = source + m * 2 * nch
                    rest = rest - m * 2 * nch
                    n = m
                }
            }
        } else {
            let ns: u64 = mp3.mp3_next()
            if ns > 0 {
                var m2: u64 = ns
                if m2 > BUF_FRAMES {
                    m2 = BUF_FRAMES
                }
                let p: u64 = mp3.mp3_pcm()
                if mp3.mp3_channels() == 2 {
                    memcopy.copy(dst, p, m2 * 4)
                } else {
                    mono_to_stereo(p, dst, m2)
                }
                n = m2
            } else {
                if mp3.mp3_at_end() {
                    n = 0
                    lauf = false
                }
            }
        }
        us_auf = us_auf +% (now_us() -% t_a)
        let t_s: u64 = now_us()
        var ab: u64 = 0
        while ab < n {
            var got: u64 = 0
            if einstrom {
                got = ulib.sys(SYS_AUDWRITE, dst + ab * 4, n - ab, 0)
            } else {
                got = kcall.sys4(SYS_AUDSEND, stream, dst + ab * 4, n - ab, 0)
            }
            if ulib.bad(got) {
                ab = n
                lauf = false
            } else {
                ab = ab + got
                sent = sent + got
                if got == 0 {
                    let remaining: u64 = n -% ab
                    var v: u64 = remaining / 16
                    if v > 255 {
                        v = 255
                    }
                    if v == 0 {
                        v = 1
                    }
                    var kenn: u64 = stream + 1
                    if einstrom {
                        kenn = 0
                    }
                    wart = wart + 1
                    let t_w: u64 = now_us()
                    ulib.sys(SYS_AUDSET, AS_WAITSPACE,
                        (kenn << 8) | v, 0)
                    us_wait = us_wait +% (now_us() -% t_w)
                }
            }
        }
        ulib.sys(ulib.SYS_YIELD, 0, 0, 0)
        us_send = us_send +% (now_us() -% t_s)
        schub = schub + 1
        if klick_bei > 0 && schub == klick_bei {
            let r: u64 = ulib.sys(SYS_AUDSET, AS_SOUND, 1, 0)
            ulib.say((&s_kl[0 as usize]) as u64)
            ulib.sayu(r)
            ulib.nl()
        }
        if ist_wav && rest == 0 {
            if runden_uebrig > 1 {
                runden_uebrig = runden_uebrig -% 1
                rest = w_len
                source = w_off
                rawpos = 0
                rawlen = 0
                ulib.sys(ulib.SYS_SEEK, wfd, w_off, 0)
            } else {
                lauf = false
            }
        }
    }

    if einstrom {
        ulib.sys(SYS_AUDSET, AS_DRAIN, 0, 0)
    } else {
        ulib.sys(SYS_AUDSET, AS_END, stream, 0)
    }
    var runde: u64 = 0
    var fertig: bool = false
    while !fertig && runde < 2000 {
        ulib.sys(SYS_AUDSET, AS_PUMP, 0, 0)
        let r: u64 = ulib.sys(SYS_AUDGET, A_REMAIN, 0, 0)
        if r == 0 {
            fertig = true
        } else {
            clockapi.sleep_ms(2)
        }
        runde = runde + 1
    }
    playsess.finish()
    let gespielt: u64 = ulib.sys(SYS_AUDGET, A_PLAYED, 0, 0)
    let underruns: u64 = ulib.sys(SYS_AUDGET, A_UNDERRUNS, 0, 0)
    let lat: u64 = ulib.sys(SYS_AUDGET, A_LATENCY, 0, 0)
    let bk: u64 = ulib.sys(SYS_AUDGET, A_BACKEND, 0, 0)
    let gm: u64 = ulib.sys(SYS_AUDGET, A_MIXED, 0, 0)
    if einstrom {
        ulib.sys(SYS_AUDSET, AS_STOP, 0, 0)
        ulib.sys(SYS_AUDSET, AS_OPEN, 0, 0)
    } else {
        ulib.sys(SYS_AUDSET, AS_CLOSE, stream, 0)
    }
    if ist_wav {
        ulib.sys(ulib.SYS_CLOSE, wfd, 0, 0)
    }
    media.src_close()

    ulib.say((&s_pl[0 as usize]) as u64)
    ulib.sayu(sent)
    ulib.nl()
    ulib.say((&s_un[0 as usize]) as u64)
    ulib.sayu(underruns)
    ulib.nl()
    ulib.say((&s_lat[0 as usize]) as u64)
    ulib.sayu(lat)
    ulib.nl()
    ulib.say((&s_bk[0 as usize]) as u64)
    ulib.sayu(bk)
    ulib.nl()
    ulib.say((&s_cl[0 as usize]) as u64)
    ulib.sayu(ulib.sys(SYS_AUDGET, A_CLIPS, 0, 0))
    ulib.nl()
    ulib.say((&s_sk[0 as usize]) as u64)
    ulib.sayu(ulib.sys(SYS_AUDGET, A_SYSSOUNDS, 0, 0))
    ulib.nl()
    ulib.say((&s_mx[0 as usize]) as u64)
    ulib.sayu(gm)
    ulib.nl()
    var s_me: [u8; 14] = "  mp3errors: \0"
    var s_ms2: [u8; 14] = "  mp3frames: \0"
    if !ist_wav {
        ulib.say((&s_me[0 as usize]) as u64)
        ulib.sayu(mp3.mp3_errors())
        ulib.nl()
        ulib.say((&s_ms2[0 as usize]) as u64)
        ulib.sayu(mp3.mp3_skipped())
        ulib.nl()
    }
    var s_wa: [u8; 12] = "  wartete: \0"
    var s_tk: [u8; 12] = "  marken: \0\0"
    ulib.say((&s_wa[0 as usize]) as u64)
    ulib.sayu(wart)
    ulib.nl()
    ulib.say((&s_tk[0 as usize]) as u64)
    ulib.sayu(runde)
    ulib.nl()
    var s_lo: [u8; 10] = "  lost: \0\0"
    var s_zo: [u8; 13] = "  genullt: \0\0"
    var s_gp: [u8; 11] = "  gap_us: \0"
    var s_sy: [u8; 13] = "  kern_us: \0\0"
    var s_wl: [u8; 13] = "  wand_us: \0\0"
    var s_ca: [u8; 12] = "  schuebe: \0"
    var s_mf: [u8; 14] = "  minvorrat: \0"
    var s_ls: [u8; 14] = "  drehungen: \0"
    var s_r1: [u8; 13] = "  read_us: \0\0"
    var s_r2: [u8; 15] = "  compute_us: \0"
    var s_r3: [u8; 12] = "  send_us: \0"
    var s_r4: [u8; 14] = "  ring3_us: \0\0"
    var s_r5: [u8; 17] = "  aufbereit_us: \0"
    var s_r6: [u8; 12] = "  wait_us: \0"
    ulib.say((&s_lo[0 as usize]) as u64)
    ulib.sayu(ulib.sys(SYS_AUDGET, A_LOST, 0, 0))
    ulib.nl()
    ulib.say((&s_zo[0 as usize]) as u64)
    ulib.sayu(ulib.sys(SYS_AUDGET, A_ZEROED, 0, 0))
    ulib.nl()
    ulib.say((&s_gp[0 as usize]) as u64)
    ulib.sayu(ulib.sys(SYS_AUDGET, A_GAPMAX, 0, 0))
    ulib.nl()
    ulib.say((&s_sy[0 as usize]) as u64)
    ulib.sayu(ulib.sys(SYS_AUDGET, A_SYSUS, 0, 0))
    ulib.nl()
    ulib.say((&s_wl[0 as usize]) as u64)
    ulib.sayu(ulib.sys(SYS_AUDGET, A_WALLUS, 0, 0))
    ulib.nl()
    ulib.say((&s_ca[0 as usize]) as u64)
    ulib.sayu(ulib.sys(SYS_AUDGET, A_CALLS, 0, 0))
    ulib.nl()
    ulib.say((&s_mf[0 as usize]) as u64)
    ulib.sayu(ulib.sys(SYS_AUDGET, A_MINFILL, 0, 0))
    ulib.nl()
    ulib.say((&s_ls[0 as usize]) as u64)
    ulib.sayu(ulib.sys(SYS_AUDGET, A_LOCKSPIN, 0, 0))
    ulib.nl()
    us_compute = (now_us() -% us_start) -% us_read -% us_send
    ulib.say((&s_r1[0 as usize]) as u64)
    ulib.sayu(us_read)
    ulib.nl()
    ulib.say((&s_r2[0 as usize]) as u64)
    ulib.sayu(us_compute)
    ulib.nl()
    ulib.say((&s_r3[0 as usize]) as u64)
    ulib.sayu(us_send)
    ulib.nl()
    ulib.say((&s_r4[0 as usize]) as u64)
    ulib.sayu(now_us() -% us_start)
    ulib.nl()
    ulib.say((&s_r5[0 as usize]) as u64)
    ulib.sayu(us_auf)
    ulib.nl()
    ulib.say((&s_r6[0 as usize]) as u64)
    ulib.sayu(us_wait)
    ulib.nl()
    let gp: u64 = gespielt
    if gp == 0 {
        return 0
    }
    return 0
}

fn mono_to_stereo(src: u64, dst: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        let lo: u64 = __mmio_read8((src + i * 2) as *mut u8) as u64
        let hi: u64 = __mmio_read8((src + i * 2 + 1) as *mut u8) as u64
        __mmio_write8((dst + i * 4) as *mut u8, lo as u8)
        __mmio_write8((dst + i * 4 + 1) as *mut u8, hi as u8)
        __mmio_write8((dst + i * 4 + 2) as *mut u8, lo as u8)
        __mmio_write8((dst + i * 4 + 3) as *mut u8, hi as u8)
        i = i + 1
    }
}
