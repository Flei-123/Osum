profile kernel

import ulib
import libc.octets
import libc.regio

export {
    NONE, index_of, last_index_of, contains, ends_with,
    parse_dec, parse_oct, has_prefix
}

const NONE: u64 = 0xFFFFFFFFFFFFFFFF

fn index_of(p: u64, ch: u64) -> u64 {
    var i: u64 = 0
    while octets.ld8(p, i) != 0 {
        if octets.ld8(p, i) == ch {
            return i
        }
        i = i + 1
    }
    return NONE
}

fn last_index_of(p: u64, ch: u64) -> u64 {
    var i: u64 = 0
    var found: u64 = NONE
    while octets.ld8(p, i) != 0 {
        if octets.ld8(p, i) == ch {
            found = i
        }
        i = i + 1
    }
    return found
}

fn contains(hay: u64, needle: u64) -> bool {
    return ulib.find(hay, needle) != ulib.EOF
}

fn ends_with(p: u64, ch: u64) -> bool {
    let n: u64 = ulib.length(p)
    if n == 0 {
        return false
    }
    return octets.ld8(p, n - 1) == ch
}

fn has_prefix(p: u64, prefix: u64) -> bool {
    return ulib.strneq(p, prefix, ulib.length(prefix))
}

fn parse_radix(p: u64, radix: u64, out_ok: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    var ok: u64 = 1
    if octets.ld8(p, 0) == 0 {
        ok = 0
    }
    while octets.ld8(p, i) != 0 {
        let c: u64 = octets.ld8(p, i)
        if c >= 48 && c < 48 + radix {
            v = v * radix + (c - 48)
        } else {
            ok = 0
        }
        i = i + 1
    }
    __mmio_write64(out_ok as *mut u64, ok)
    return v
}

fn parse_dec(p: u64, out_ok: u64) -> u64 {
    return parse_radix(p, 10, out_ok)
}

fn parse_oct(p: u64, out_ok: u64) -> u64 {
    return parse_radix(p, 8, out_ok)
}
