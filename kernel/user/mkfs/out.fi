profile kernel

import ulib

import libc.text
export {
    text, num, oct, newline, etext, etext_num, die, fail,
    err_too_small, err_disk_full, err_inode_outside, err_no_inode, err_file_too_big,
    err_name_too_long, err_names_no_file, err_no_directory, err_no_symlinks, err_already_there,
    err_no_such_file, err_root_not_one, err_unknown_command, err_needs_hostfile,
    err_cannot_read, err_cannot_write, err_bad_number, err_unknown_placeholder, err_brand_file,
    err_out_of_memory, err_bad_spec, note_v3_upgrade, no_magic, no_such_path, where_missing, usage
}

static mut s_nl: [u8; 2] = "\n\0"
static mut s_too_small_1: [u8; 17] = "mkfs: a disk of \0"
static mut s_too_small_2: [u8; 26] = " blocks is too small for \0"
static mut s_too_small_3: [u8; 32] = " inodes (the table alone takes \0"
static mut s_close: [u8; 2] = ")\0"
static mut s_disk_full: [u8; 23] = "mkfs: the disk is full\0"
static mut s_outside_1: [u8; 13] = "mkfs: inode \0"
static mut s_outside_2: [u8; 24] = " is outside the table (\0"
static mut s_no_inode_1: [u8; 22] = "mkfs: no inode left (\0"
static mut s_no_inode_2: [u8; 15] = " in the table)\0"
static mut s_big_1: [u8; 23] = "mkfs: a file may hold \0"
static mut s_big_2: [u8; 25] = " octets in this format (\0"
static mut s_big_3: [u8; 17] = " direct blocks, \0"
static mut s_big_4: [u8; 31] = " through the indirect one and \0"
static mut s_big_5: [u8; 65] = " through the double indirect one, see fs.fi); this one is bigger\0"
static mut s_long_1: [u8; 17] = "mkfs: the name '\0"
static mut s_long_2: [u8; 16] = "' is too long (\0"
static mut s_long_3: [u8; 22] = " characters, at most \0"
static mut s_long_4: [u8; 14] = " in revision \0"
static mut s_quote_1: [u8; 8] = "mkfs: '\0"
static mut s_no_file: [u8; 16] = "' names no file\0"
static mut s_no_dir: [u8; 19] = "' has no directory\0"
static mut s_no_symlinks: [u8; 53] = "mkfs: symbolic links exist from revision 3 on (--v3)\0"
static mut s_there: [u8; 19] = "' is already there\0"
static mut s_missing: [u8; 17] = "' does not exist\0"
static mut s_root: [u8; 38] = "mkfs: the root did not become inode 1\0"
static mut s_unknown_cmd: [u8; 24] = "mkfs: unknown command '\0"
static mut s_needs: [u8; 26] = "' needs <path>=<hostfile>\0"
static mut s_cannot_read: [u8; 19] = "mkfs: cannot read \0"
static mut s_cannot_write: [u8; 20] = "mkfs: cannot write \0"
static mut s_bad_number: [u8; 21] = "mkfs: bad number in \0"
static mut s_placeholder_1: [u8; 8] = "marke: \0"
static mut s_placeholder_2: [u8; 25] = ": unknown placeholder {{\0"
static mut s_placeholder_3: [u8; 3] = "}}\0"
static mut s_brand_file: [u8; 28] = "mkfs: unreadable brand map \0"
static mut s_oom: [u8; 20] = "mkfs: out of memory\0"
static mut s_bad_spec: [u8; 16] = "mkfs: bad spec \0"
static mut s_upgrade_1: [u8; 7] = "mkfs: \0"
static mut s_upgrade_2: [u8; 41] = " is bigger than a format-2 file may be (\0"
static mut s_upgrade_3: [u8; 28] = " octets): building format 3\0"
static mut s_no_magic: [u8; 18] = "no OSUM-OFS magic\0"
static mut s_no_path_1: [u8; 21] = "mkfs: no such path '\0"
static mut s_no_path_2: [u8; 2] = "'\0"
static mut s_where_missing: [u8; 21] = "mkfs: no such path: \0"
static mut s_usage_1: [u8; 149] = "usage: mkfs build <image> <blocks> [--v1] [--v3] [--inodes=<n>] [--time=<t>] [--reserve=<n>] [--karten=<n>] [--journal] [--brand=<map>] [<spec> ...]\0"
static mut s_usage_2: [u8; 55] = "       mkfs list|meta|times|cat|where <image> [<path>]\0"

fn text(p: u64) {
    ulib.say(p)
}

fn num(v: u64) {
    ulib.sayu(v)
}

fn newline() {
    ulib.say((&s_nl[0 as usize]) as u64)
}

fn oct(v: u64) {
    var buf: [u8; 28] = [0 as u8; 28]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        buf[0 as usize] = 48 as u8
        n = 1
    }
    var rev: [u8; 28] = [0 as u8; 28]
    var k: u64 = 0
    while x != 0 {
        rev[k as usize] = (48 + (x & 7)) as u8
        x = x >> 3
        k = k + 1
    }
    while k > 0 {
        k = k - 1
        buf[n as usize] = rev[k as usize]
        n = n + 1
    }
    ulib.put((&buf[0 as usize]) as u64, n)
}

fn etext(p: u64) {
    ulib.eput(p)
}

fn etext_num(v: u64) {
    var buf: [u8; 28] = [0 as u8; 28]
    let n: u64 = text.digits(v, (&buf[0 as usize]) as u64, true)
    buf[n as usize] = 0 as u8
    ulib.eput((&buf[0 as usize]) as u64)
}

fn die() {
    ulib.eput((&s_nl[0 as usize]) as u64)
    ulib.sys(ulib.SYS_EXIT, 1, 0, 0)
}

fn fail(msg: u64) {
    etext(msg)
    die()
}

fn err_too_small(blocks: u64, inodes: u64, table: u64) {
    etext((&s_too_small_1[0 as usize]) as u64)
    etext_num(blocks)
    etext((&s_too_small_2[0 as usize]) as u64)
    etext_num(inodes)
    etext((&s_too_small_3[0 as usize]) as u64)
    etext_num(table)
    etext((&s_close[0 as usize]) as u64)
    die()
}

fn err_disk_full() {
    fail((&s_disk_full[0 as usize]) as u64)
}

fn err_inode_outside(ino: u64, total: u64) {
    etext((&s_outside_1[0 as usize]) as u64)
    etext_num(ino)
    etext((&s_outside_2[0 as usize]) as u64)
    etext_num(total)
    etext((&s_close[0 as usize]) as u64)
    die()
}

fn err_no_inode(count: u64) {
    etext((&s_no_inode_1[0 as usize]) as u64)
    etext_num(count)
    etext((&s_no_inode_2[0 as usize]) as u64)
    die()
}

fn err_file_too_big(max: u64, directs: u64, per: u64, per2: u64) {
    etext((&s_big_1[0 as usize]) as u64)
    etext_num(max)
    etext((&s_big_2[0 as usize]) as u64)
    etext_num(directs)
    etext((&s_big_3[0 as usize]) as u64)
    etext_num(per)
    etext((&s_big_4[0 as usize]) as u64)
    etext_num(per2)
    etext((&s_big_5[0 as usize]) as u64)
    die()
}

fn err_name_too_long(name: u64, length: u64, max: u64, version: u64) {
    etext((&s_long_1[0 as usize]) as u64)
    etext(name)
    etext((&s_long_2[0 as usize]) as u64)
    etext_num(length)
    etext((&s_long_3[0 as usize]) as u64)
    etext_num(max)
    etext((&s_long_4[0 as usize]) as u64)
    etext_num(version)
    etext((&s_close[0 as usize]) as u64)
    die()
}

fn quoted(path: u64, tail: u64) {
    etext((&s_quote_1[0 as usize]) as u64)
    etext(path)
    etext(tail)
    die()
}

fn err_names_no_file(path: u64) {
    quoted(path, (&s_no_file[0 as usize]) as u64)
}

fn err_no_directory(path: u64) {
    quoted(path, (&s_no_dir[0 as usize]) as u64)
}

fn err_already_there(path: u64) {
    quoted(path, (&s_there[0 as usize]) as u64)
}

fn err_no_such_file(path: u64) {
    quoted(path, (&s_missing[0 as usize]) as u64)
}

fn err_needs_hostfile(spec: u64) {
    quoted(spec, (&s_needs[0 as usize]) as u64)
}

fn err_no_symlinks() {
    fail((&s_no_symlinks[0 as usize]) as u64)
}

fn err_root_not_one() {
    fail((&s_root[0 as usize]) as u64)
}

fn err_unknown_command(name: u64) {
    etext((&s_unknown_cmd[0 as usize]) as u64)
    etext(name)
    etext((&s_no_path_2[0 as usize]) as u64)
    ulib.eput((&s_nl[0 as usize]) as u64)
    ulib.sys(ulib.SYS_EXIT, 2, 0, 0)
}

fn err_cannot_read(path: u64) {
    etext((&s_cannot_read[0 as usize]) as u64)
    etext(path)
    die()
}

fn err_cannot_write(path: u64) {
    etext((&s_cannot_write[0 as usize]) as u64)
    etext(path)
    die()
}

fn err_bad_number(arg: u64) {
    etext((&s_bad_number[0 as usize]) as u64)
    etext(arg)
    die()
}

fn err_bad_spec(spec: u64) {
    etext((&s_bad_spec[0 as usize]) as u64)
    etext(spec)
    die()
}

fn err_unknown_placeholder(host: u64, name: u64) {
    etext((&s_placeholder_1[0 as usize]) as u64)
    etext(host)
    etext((&s_placeholder_2[0 as usize]) as u64)
    etext(name)
    etext((&s_placeholder_3[0 as usize]) as u64)
    die()
}

fn err_brand_file(path: u64) {
    etext((&s_brand_file[0 as usize]) as u64)
    etext(path)
    die()
}

fn err_out_of_memory() {
    fail((&s_oom[0 as usize]) as u64)
}

fn note_v3_upgrade(src: u64, v2max: u64) {
    etext((&s_upgrade_1[0 as usize]) as u64)
    etext(src)
    etext((&s_upgrade_2[0 as usize]) as u64)
    etext_num(v2max)
    etext((&s_upgrade_3[0 as usize]) as u64)
    ulib.eput((&s_nl[0 as usize]) as u64)
}

fn no_magic() {
    text((&s_no_magic[0 as usize]) as u64)
    newline()
}

fn no_such_path(path: u64) {
    text((&s_no_path_1[0 as usize]) as u64)
    text(path)
    text((&s_no_path_2[0 as usize]) as u64)
    newline()
}

fn where_missing(path: u64) {
    text((&s_where_missing[0 as usize]) as u64)
    text(path)
    newline()
}

fn usage() {
    text((&s_usage_1[0 as usize]) as u64)
    newline()
    text((&s_usage_2[0 as usize]) as u64)
    newline()
}
