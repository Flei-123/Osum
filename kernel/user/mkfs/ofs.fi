// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import ulib
import libc.mem
import mkfs.out

export {
    BS, OFS_V1, OFS_V2, OFS_V3, T_FREE, T_FILE, T_DIR, T_LINK,
    I_TYPE, I_SIZE, I_NLINK, I_MODE, I_UID, I_GID, I_CTIME, I_MTIME, I_ATIME,
    SB_MAGIC, SB_BLOCKS, SB_INODES, SB_BITMAP, SB_ITABLE, SB_DATA, SB_ROOT, SB_VERSION,
    SB_BMBLOCKS, SB_ISIZE, SB_DIRENT, SB_NAMELEN, SB_XVER, SB_XBLOCKS, SB_XBMSTART,
    SB_XITSTART, SB_XINODES,
    MAGIC, NAME_MAX,
    derive, create, attach, format, reserve, free_blocks, used_inodes, max_file,
    image_ptr, image_blocks, image_used_blocks, version, blocks, inodes, bmblocks,
    isize, dirent_size, namelen, data_start, jstart, journal, xblocks, xbm, xit, xin, root_ino,
    g64, p64, iget, iset, inode_alloc, file_block, write_at, read_at,
    dir_entries, entry, dir_find, dir_add, resolve, parent_of, set_meta, get_meta,
    get_times, set_times, symlink, mkdir, link, addfile,
    set_root, set_version, set_layout, set_extended, set_blocks
}

const BS: u64 = 512
const MAGIC: u64 = 0x4F53554D2D4F4653
const INODE_SIZE: u64 = 128
const INODES_PER_BLOCK: u64 = 4
const DIRENT_V2: u64 = 32
const NAME_V2: u64 = 24
const DIRECT: u64 = 8
const DIRECT_V1: u64 = 11
const INODE_SIZE_V3: u64 = 256
const IPB_V3: u64 = 2
const DIRENT_V3: u64 = 264
const NAME_V3: u64 = 256
const BITS_PER_BLOCK: u64 = 4096
const NAME_MAX: u64 = 256
const J_BLOCKS: u64 = 522
const OFS_V1: u64 = 1
const OFS_V2: u64 = 2
const OFS_V3: u64 = 3
const T_FREE: u64 = 0
const T_FILE: u64 = 1
const T_DIR: u64 = 2
const T_LINK: u64 = 3
const I_TYPE: u64 = 0
const I_SIZE: u64 = 8
const I_NLINK: u64 = 16
const I_DIRECT: u64 = 24
const I_INDIRECT: u64 = 112
const I_DINDIRECT: u64 = 120
const I_TINDIRECT: u64 = 128
const I_CTIME: u64 = 136
const I_MTIME: u64 = 144
const I_ATIME: u64 = 152
const I_QINDIRECT: u64 = 160
const I_MODE: u64 = 88
const I_UID: u64 = 96
const I_GID: u64 = 104
const SB_MAGIC: u64 = 0
const SB_BSIZE: u64 = 8
const SB_BLOCKS: u64 = 16
const SB_INODES: u64 = 24
const SB_BITMAP: u64 = 32
const SB_ITABLE: u64 = 40
const SB_DATA: u64 = 48
const SB_ROOT: u64 = 56
const SB_VERSION: u64 = 64
const SB_BMBLOCKS: u64 = 72
const SB_ISIZE: u64 = 80
const SB_DIRENT: u64 = 88
const SB_NAMELEN: u64 = 96
const SB_JSTART: u64 = 104
const SB_JBLOCKS: u64 = 112
const SB_XVER: u64 = 120
const SB_XBLOCKS: u64 = 128
const SB_XBMSTART: u64 = 136
const SB_XITSTART: u64 = 144
const SB_XINODES: u64 = 152

static mut img: u64 = 0
static mut n_blocks: u64 = 0
static mut n_version: u64 = 0
static mut n_inodes: u64 = 0
static mut n_isize: u64 = 0
static mut n_ipb: u64 = 0
static mut n_dirent: u64 = 0
static mut n_namelen: u64 = 0
static mut n_bmblocks: u64 = 0
static mut n_bmstart: u64 = 0
static mut n_itable: u64 = 0
static mut n_itab_blocks: u64 = 0
static mut n_journal: u64 = 0
static mut n_jstart: u64 = 0
static mut n_data_start: u64 = 0
static mut n_hint: u64 = 0
static mut n_elapsed: u64 = 0
static mut n_root: u64 = 1
static mut n_next_ino: u64 = 1
static mut n_xblocks: u64 = 0
static mut n_xbm: u64 = 0
static mut n_xit: u64 = 0
static mut n_xin: u64 = 0
static mut high_block: u64 = 0
static mut rec_buf: [u8; 272] = [0 as u8; 272]
static mut name_buf: [u8; 272] = [0 as u8; 272]
static mut part_buf: [u8; 272] = [0 as u8; 272]

fn image_ptr() -> u64 { return img }
fn image_blocks() -> u64 { return n_blocks }
fn version() -> u64 { return n_version }
fn blocks() -> u64 { return n_blocks }
fn inodes() -> u64 { return n_inodes }
fn bmblocks() -> u64 { return n_bmblocks }
fn isize() -> u64 { return n_isize }
fn dirent_size() -> u64 { return n_dirent }
fn namelen() -> u64 { return n_namelen }
fn data_start() -> u64 { return n_data_start }
fn jstart() -> u64 { return n_jstart }
fn journal() -> u64 { return n_journal }
fn xblocks() -> u64 { return n_xblocks }
fn xbm() -> u64 { return n_xbm }
fn xit() -> u64 { return n_xit }
fn xin() -> u64 { return n_xin }
fn root_ino() -> u64 { return n_root }

fn image_used_blocks() -> u64 {
    var used: u64 = n_data_start
    if high_block + 1 > used {
        used = high_block + 1
    }
    if used > n_blocks {
        used = n_blocks
    }
    return used
}

fn set_root(v: u64) { n_root = v }
fn set_version(v: u64) { n_version = v }
fn set_blocks(v: u64) { n_blocks = v }

fn set_layout(bmstart: u64, bm: u64, itable: u64, isz: u64, dirent: u64, namelen_v: u64, data: u64) {
    n_bmstart = bmstart
    n_bmblocks = bm
    n_itable = itable
    n_isize = isz
    n_ipb = BS / isz
    n_dirent = dirent
    n_namelen = namelen_v
    n_data_start = data
}

fn set_extended(xb: u64, xbm_v: u64, xit_v: u64, xin_v: u64) {
    n_xblocks = xb
    n_xbm = xbm_v
    n_xit = xit_v
    n_xin = xin_v
}

fn g8(at: u64) -> u64 {
    return (*((img + at) as *mut u8)) as u64
}

fn p8(at: u64, v: u64) {
    __mmio_write8((img + at) as *mut u8, v as u8)
}

fn g64(at: u64) -> u64 {
    return __mmio_read64((img + at) as *mut u64)
}

fn p64(at: u64, v: u64) {
    __mmio_write64((img + at) as *mut u64, v)
}

fn derive(blocks_v: u64, version_v: u64, inodes_v: u64, elapsed: u64, karten: u64, journal_v: u64) {
    n_inodes = inodes_v
    n_version = version_v
    n_elapsed = elapsed
    if version_v >= OFS_V3 {
        n_isize = INODE_SIZE_V3
        n_ipb = IPB_V3
        n_dirent = DIRENT_V3
        n_namelen = NAME_V3
    } else {
        n_isize = INODE_SIZE
        n_ipb = INODES_PER_BLOCK
        n_dirent = DIRENT_V2
        n_namelen = NAME_V2
    }
    var bm: u64 = (blocks_v + BITS_PER_BLOCK - 1) / BITS_PER_BLOCK
    if bm < 1 {
        bm = 1
    }
    if karten > bm {
        bm = karten
    }
    n_bmblocks = bm
    n_bmstart = 1
    n_itable = n_bmstart + n_bmblocks
    n_itab_blocks = (inodes_v + n_ipb - 1) / n_ipb
    n_journal = 0
    n_jstart = 0
    if journal_v != 0 {
        n_journal = J_BLOCKS
        n_jstart = n_itable + n_itab_blocks
    }
    n_data_start = n_itable + n_itab_blocks + n_journal
    if blocks_v < n_data_start + 8 {
        out.err_too_small(blocks_v, inodes_v, n_itab_blocks)
    }
    n_blocks = blocks_v
    n_hint = n_data_start
    n_root = 1
    n_next_ino = 1
    n_xblocks = 0
    n_xbm = 0
    n_xit = 0
    n_xin = 0
    high_block = 0
}

fn create() {
    let p: u64 = mem.map_pages(n_blocks * BS)
    if ulib.bad(p) {
        out.err_out_of_memory()
    }
    img = p
}

fn attach(p: u64) {
    img = p
}

fn bm_at(b: u64) -> u64 {
    let cover: u64 = n_bmblocks * BITS_PER_BLOCK
    if n_xblocks != 0 && b >= cover {
        let x: u64 = b - cover
        return (n_xbm + x / BITS_PER_BLOCK) * BS + (x % BITS_PER_BLOCK) / 8
    }
    return (n_bmstart + b / BITS_PER_BLOCK) * BS + (b % BITS_PER_BLOCK) / 8
}

fn bit_set(b: u64) {
    let at: u64 = bm_at(b)
    p8(at, g8(at) | (1 << (b % 8)))
}

fn bit_get(b: u64) -> u64 {
    return (g8(bm_at(b)) >> (b % 8)) & 1
}

fn take_block(b: u64) -> u64 {
    bit_set(b)
    n_hint = b
    if b > high_block {
        high_block = b
    }
    return b
}

fn block_alloc() -> u64 {
    var b: u64 = n_hint
    if b < n_data_start {
        b = n_data_start
    }
    while b < n_blocks {
        if bit_get(b) == 0 {
            return take_block(b)
        }
        b = b + 1
    }
    b = n_data_start
    while b < n_hint {
        if bit_get(b) == 0 {
            return take_block(b)
        }
        b = b + 1
    }
    out.err_disk_full()
    return 0
}

fn reserve(n: u64) -> u64 {
    var b: u64 = n_data_start
    var stop: u64 = n_data_start + n
    if stop > n_blocks {
        stop = n_blocks
    }
    while b < stop && (b % 8) != 0 {
        bit_set(b)
        b = b + 1
    }
    while b + 8 <= stop {
        p8(bm_at(b), 255)
        b = b + 8
    }
    while b < stop {
        bit_set(b)
        b = b + 1
    }
    n_hint = stop
    return stop - n_data_start
}

fn popcount8(v: u64) -> u64 {
    var n: u64 = 0
    var x: u64 = v
    while x != 0 {
        n = n + (x & 1)
        x = x >> 1
    }
    return n
}

fn free_blocks() -> u64 {
    var free: u64 = 0
    var b: u64 = 0
    while b < n_blocks {
        let rest: u64 = n_blocks - b
        if (b % 8) == 0 && rest >= 8 {
            let o: u64 = g8(bm_at(b))
            if o == 0 {
                free = free + 8
            } else {
                if o != 255 {
                    free = free + 8 - popcount8(o)
                }
            }
            b = b + 8
        } else {
            if bit_get(b) == 0 {
                free = free + 1
            }
            b = b + 1
        }
    }
    return free
}

fn inode_at(ino: u64) -> u64 {
    if ino < 1 || ino > n_inodes + n_xin {
        out.err_inode_outside(ino, n_inodes + n_xin)
    }
    if ino > n_inodes {
        let slot: u64 = ino - 1 - n_inodes
        return (n_xit + slot / n_ipb) * BS + (slot % n_ipb) * n_isize
    }
    return (n_itable + (ino - 1) / n_ipb) * BS + ((ino - 1) % n_ipb) * n_isize
}

fn iget(ino: u64, field: u64) -> u64 {
    return g64(inode_at(ino) + field)
}

fn iset(ino: u64, field: u64, v: u64) {
    p64(inode_at(ino) + field, v)
}

fn inode_alloc(kind: u64) -> u64 {
    var ino: u64 = n_next_ino
    while ino <= n_inodes {
        if iget(ino, I_TYPE) == T_FREE {
            let at: u64 = inode_at(ino)
            ulib.fill(img + at, 0, n_isize)
            iset(ino, I_TYPE, kind)
            iset(ino, I_NLINK, 1)
            if n_version >= OFS_V2 {
                iset(ino, I_MODE, 493)
            }
            if n_version >= OFS_V3 {
                iset(ino, I_CTIME, n_elapsed)
                iset(ino, I_MTIME, n_elapsed)
                iset(ino, I_ATIME, n_elapsed)
            }
            n_next_ino = ino + 1
            return ino
        }
        ino = ino + 1
    }
    out.err_no_inode(n_inodes)
    return 0
}

fn used_inodes() -> u64 {
    var n: u64 = 0
    var i: u64 = 1
    while i <= n_inodes + n_xin {
        if iget(i, I_TYPE) != T_FREE {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn directs() -> u64 {
    if n_version >= OFS_V2 {
        return DIRECT
    }
    return DIRECT_V1
}

fn max_file() -> u64 {
    let per: u64 = BS / 8
    var n: u64 = directs() + per + per * per
    if n_version >= OFS_V3 {
        n = n + per * per * per + per * per * per * per
    }
    return n * BS
}

fn level(block: u64, k: u64, grow: u64) -> u64 {
    let b: u64 = g64(block * BS + k * 8)
    if b != 0 || grow == 0 {
        return b
    }
    let nb: u64 = block_alloc()
    p64(block * BS + k * 8, nb)
    return nb
}

fn root_block(ino: u64, field: u64, grow: u64) -> u64 {
    var l1: u64 = iget(ino, field)
    if l1 == 0 {
        if grow == 0 {
            return 0
        }
        l1 = block_alloc()
        iset(ino, field, l1)
    }
    return l1
}

fn single_block(ino: u64, k: u64, grow: u64) -> u64 {
    let l1: u64 = root_block(ino, I_INDIRECT, grow)
    if l1 == 0 {
        return 0
    }
    return level(l1, k, grow)
}

fn double_block(ino: u64, d: u64, grow: u64) -> u64 {
    let per: u64 = BS / 8
    let l1: u64 = root_block(ino, I_DINDIRECT, grow)
    if l1 == 0 {
        return 0
    }
    let l2: u64 = level(l1, d / per, grow)
    if l2 == 0 {
        return 0
    }
    return level(l2, d % per, grow)
}

fn triple_block(ino: u64, t: u64, grow: u64) -> u64 {
    let per: u64 = BS / 8
    let l1: u64 = root_block(ino, I_TINDIRECT, grow)
    if l1 == 0 {
        return 0
    }
    let l2: u64 = level(l1, t / (per * per), grow)
    if l2 == 0 {
        return 0
    }
    let l3: u64 = level(l2, (t / per) % per, grow)
    if l3 == 0 {
        return 0
    }
    return level(l3, t % per, grow)
}

fn quad_block(ino: u64, q: u64, grow: u64) -> u64 {
    let per: u64 = BS / 8
    let l1: u64 = root_block(ino, I_QINDIRECT, grow)
    if l1 == 0 {
        return 0
    }
    let l2: u64 = level(l1, q / (per * per * per), grow)
    if l2 == 0 {
        return 0
    }
    let l3: u64 = level(l2, (q / (per * per)) % per, grow)
    if l3 == 0 {
        return 0
    }
    let l4: u64 = level(l3, (q / per) % per, grow)
    if l4 == 0 {
        return 0
    }
    return level(l4, q % per, grow)
}

fn file_block(ino: u64, index: u64, grow: u64) -> u64 {
    let per: u64 = BS / 8
    let dn: u64 = directs()
    if index < dn {
        let b: u64 = iget(ino, I_DIRECT + index * 8)
        if b != 0 || grow == 0 {
            return b
        }
        let nb: u64 = block_alloc()
        iset(ino, I_DIRECT + index * 8, nb)
        return nb
    }
    let k: u64 = index - dn
    if k < per {
        return single_block(ino, k, grow)
    }
    let d: u64 = k - per
    if d < per * per {
        return double_block(ino, d, grow)
    }
    if n_version >= OFS_V3 {
        let t: u64 = d - per * per
        if t < per * per * per {
            return triple_block(ino, t, grow)
        }
        let q: u64 = t - per * per * per
        if q < per * per * per * per {
            return quad_block(ino, q, grow)
        }
    }
    out.err_file_too_big(max_file(), dn, per, per * per)
    return 0
}

fn write_at(ino: u64, off: u64, data: u64, n: u64) -> u64 {
    var done: u64 = 0
    while done < n {
        let pos: u64 = off + done
        let inb: u64 = pos % BS
        var chunk: u64 = BS - inb
        if n - done < chunk {
            chunk = n - done
        }
        let b: u64 = file_block(ino, pos / BS, 1)
        ulib.copy(img + b * BS + inb, data + done, chunk)
        done = done + chunk
    }
    if done != 0 && off + done > iget(ino, I_SIZE) {
        iset(ino, I_SIZE, off + done)
    }
    return done
}

fn read_at(ino: u64, off: u64, length: u64, dst: u64) -> u64 {
    let size: u64 = iget(ino, I_SIZE)
    var want: u64 = 0
    if off < size {
        want = size - off
        if length < want {
            want = length
        }
    }
    var done: u64 = 0
    while done < want {
        let pos: u64 = off + done
        let inb: u64 = pos % BS
        var chunk: u64 = BS - inb
        if want - done < chunk {
            chunk = want - done
        }
        let b: u64 = file_block(ino, pos / BS, 0)
        if b != 0 {
            ulib.copy(dst + done, img + b * BS + inb, chunk)
        } else {
            ulib.fill(dst + done, 0, chunk)
        }
        done = done + chunk
    }
    return want
}

fn dir_entries(ino: u64) -> u64 {
    return iget(ino, I_SIZE) / n_dirent
}

fn entry(dirino: u64, i: u64, name_out: u64) -> u64 {
    let got: u64 = read_at(dirino, i * n_dirent, n_dirent, (&rec_buf[0 as usize]) as u64)
    if got < n_dirent {
        __mmio_write8(name_out as *mut u8, 0 as u8)
        return 0
    }
    let ino: u64 = __mmio_read64((&rec_buf[0 as usize]) as u64 as *mut u64)
    var k: u64 = 0
    var more: bool = true
    while more && k < n_dirent - 8 {
        let c: u8 = rec_buf[(8 + k) as usize]
        __mmio_write8((name_out + k) as *mut u8, c)
        if c == 0 as u8 {
            more = false
        } else {
            k = k + 1
        }
    }
    __mmio_write8((name_out + k) as *mut u8, 0 as u8)
    return ino
}

fn dir_find(dirino: u64, name: u64) -> u64 {
    let n: u64 = dir_entries(dirino)
    var found: u64 = 0
    var i: u64 = 0
    while i < n && found == 0 {
        let ino: u64 = entry(dirino, i, (&name_buf[0 as usize]) as u64)
        if ino != 0 && ulib.streq((&name_buf[0 as usize]) as u64, name) {
            found = ino
        }
        i = i + 1
    }
    return found
}

fn dir_add(dirino: u64, name: u64, ino: u64) {
    let nl: u64 = ulib.length(name)
    if nl > n_namelen - 1 {
        out.err_name_too_long(name, nl, n_namelen - 1, n_version)
    }
    let slot: u64 = dir_entries(dirino)
    ulib.fill((&rec_buf[0 as usize]) as u64, 0, n_dirent)
    __mmio_write64((&rec_buf[0 as usize]) as u64 as *mut u64, ino)
    ulib.copy((&rec_buf[0 as usize]) as u64 + 8, name, nl)
    write_at(dirino, slot * n_dirent, (&rec_buf[0 as usize]) as u64, n_dirent)
}

fn dir_init(ino: u64, parent: u64) {
    var dot: [u8; 2] = ".\0"
    var dotdot: [u8; 3] = "..\0"
    dir_add(ino, (&dot[0 as usize]) as u64, ino)
    dir_add(ino, (&dotdot[0 as usize]) as u64, parent)
}

fn next_part(path: u64, at: u64, out_buf: u64) -> u64 {
    var i: u64 = at
    while (*((path + i) as *mut u8)) == 47 as u8 {
        i = i + 1
    }
    if (*((path + i) as *mut u8)) == 0 as u8 {
        return 0 -% 1
    }
    var k: u64 = 0
    while (*((path + i) as *mut u8)) != 47 as u8 && (*((path + i) as *mut u8)) != 0 as u8 {
        if k < 260 {
            __mmio_write8((out_buf + k) as *mut u8, *((path + i) as *mut u8))
            k = k + 1
        }
        i = i + 1
    }
    __mmio_write8((out_buf + k) as *mut u8, 0 as u8)
    return i
}

fn resolve_n(path: u64, limit: u64) -> u64 {
    var ino: u64 = n_root
    var at: u64 = 0
    var count: u64 = 0
    var live: bool = true
    while live && count < limit {
        let nx: u64 = next_part(path, at, (&part_buf[0 as usize]) as u64)
        if nx == 0 -% 1 {
            live = false
        } else {
            at = nx
            count = count + 1
            if iget(ino, I_TYPE) != T_DIR {
                return 0
            }
            ino = dir_find(ino, (&part_buf[0 as usize]) as u64)
            if ino == 0 {
                return 0
            }
        }
    }
    return ino
}

fn resolve(path: u64) -> u64 {
    return resolve_n(path, 1000000)
}

fn count_parts(path: u64) -> u64 {
    var at: u64 = 0
    var count: u64 = 0
    var live: bool = true
    while live {
        let nx: u64 = next_part(path, at, (&part_buf[0 as usize]) as u64)
        if nx == 0 -% 1 {
            live = false
        } else {
            at = nx
            count = count + 1
        }
    }
    return count
}

fn parent_of(path: u64, name_out: u64) -> u64 {
    let total: u64 = count_parts(path)
    if total == 0 {
        out.err_names_no_file(path)
    }
    var at: u64 = 0
    var i: u64 = 0
    while i < total {
        at = next_part(path, at, name_out)
        i = i + 1
    }
    let dirino: u64 = resolve_n(path, total - 1)
    if dirino == 0 {
        out.err_no_directory(path)
    }
    return dirino
}

fn set_meta(ino: u64, mode: u64, uid: u64, gid: u64) {
    if n_version < OFS_V2 {
        return
    }
    iset(ino, I_MODE, mode & 4095)
    iset(ino, I_UID, uid)
    iset(ino, I_GID, gid)
}

fn get_meta(ino: u64, out_mode: u64, out_uid: u64, out_gid: u64) {
    if n_version < OFS_V2 {
        __mmio_write64(out_mode as *mut u64, 493)
        __mmio_write64(out_uid as *mut u64, 0)
        __mmio_write64(out_gid as *mut u64, 0)
        return
    }
    __mmio_write64(out_mode as *mut u64, iget(ino, I_MODE) & 4095)
    __mmio_write64(out_uid as *mut u64, iget(ino, I_UID))
    __mmio_write64(out_gid as *mut u64, iget(ino, I_GID))
}

fn get_times(ino: u64, out_c: u64, out_m: u64, out_a: u64) {
    if n_version < OFS_V3 {
        __mmio_write64(out_c as *mut u64, 0)
        __mmio_write64(out_m as *mut u64, 0)
        __mmio_write64(out_a as *mut u64, 0)
        return
    }
    __mmio_write64(out_c as *mut u64, iget(ino, I_CTIME))
    __mmio_write64(out_m as *mut u64, iget(ino, I_MTIME))
    __mmio_write64(out_a as *mut u64, iget(ino, I_ATIME))
}

fn set_times(ino: u64, c: u64, m: u64, a: u64) {
    if n_version < OFS_V3 {
        return
    }
    iset(ino, I_CTIME, c)
    iset(ino, I_MTIME, m)
    iset(ino, I_ATIME, a)
}

fn symlink(path: u64, target: u64) -> u64 {
    if n_version < OFS_V3 {
        out.err_no_links()
    }
    var leaf: [u8; 272] = [0 as u8; 272]
    let dirino: u64 = parent_of(path, (&leaf[0 as usize]) as u64)
    if dir_find(dirino, (&leaf[0 as usize]) as u64) != 0 {
        out.err_already_there(path)
    }
    let ino: u64 = inode_alloc(T_LINK)
    write_at(ino, 0, target, ulib.length(target))
    dir_add(dirino, (&leaf[0 as usize]) as u64, ino)
    set_meta(ino, 511, 0, 0)
    return ino
}

fn mkdir(path: u64, mode: u64, uid: u64, gid: u64) -> u64 {
    var leaf: [u8; 272] = [0 as u8; 272]
    let dirino: u64 = parent_of(path, (&leaf[0 as usize]) as u64)
    let there: u64 = dir_find(dirino, (&leaf[0 as usize]) as u64)
    if there != 0 {
        set_meta(there, mode, uid, gid)
        return there
    }
    let ino: u64 = inode_alloc(T_DIR)
    dir_init(ino, dirino)
    dir_add(dirino, (&leaf[0 as usize]) as u64, ino)
    set_meta(ino, mode, uid, gid)
    return ino
}

fn link(newpath: u64, oldpath: u64) -> u64 {
    let ino: u64 = resolve(oldpath)
    if ino == 0 {
        out.err_no_such_file(oldpath)
    }
    var leaf: [u8; 272] = [0 as u8; 272]
    let dirino: u64 = parent_of(newpath, (&leaf[0 as usize]) as u64)
    if dir_find(dirino, (&leaf[0 as usize]) as u64) != 0 {
        out.err_already_there(newpath)
    }
    dir_add(dirino, (&leaf[0 as usize]) as u64, ino)
    iset(ino, I_NLINK, iget(ino, I_NLINK) + 1)
    return ino
}

fn addfile(path: u64, data: u64, n: u64, mode: u64, uid: u64, gid: u64) -> u64 {
    var leaf: [u8; 272] = [0 as u8; 272]
    let dirino: u64 = parent_of(path, (&leaf[0 as usize]) as u64)
    if dir_find(dirino, (&leaf[0 as usize]) as u64) != 0 {
        out.err_already_there(path)
    }
    let ino: u64 = inode_alloc(T_FILE)
    if n != 0 {
        write_at(ino, 0, data, n)
    }
    dir_add(dirino, (&leaf[0 as usize]) as u64, ino)
    set_meta(ino, mode, uid, gid)
    return ino
}

fn format() {
    p64(SB_MAGIC, MAGIC)
    p64(SB_BSIZE, BS)
    p64(SB_BLOCKS, n_blocks)
    p64(SB_INODES, n_inodes)
    p64(SB_BITMAP, n_bmstart)
    p64(SB_ITABLE, n_itable)
    p64(SB_DATA, n_data_start)
    p64(SB_ROOT, 1)
    p64(SB_VERSION, n_version)
    if n_version >= OFS_V3 {
        p64(SB_BMBLOCKS, n_bmblocks)
        p64(SB_ISIZE, n_isize)
        p64(SB_DIRENT, n_dirent)
        p64(SB_NAMELEN, n_namelen)
    }
    if n_journal != 0 {
        p64(SB_JSTART, n_jstart)
        p64(SB_JBLOCKS, n_journal)
    }
    if n_version < OFS_V3 && n_bmblocks > 1 {
        p64(SB_BMBLOCKS, n_bmblocks)
    }
    var b: u64 = 0
    while b < n_data_start {
        bit_set(b)
        b = b + 1
    }
    b = n_blocks
    while b < n_bmblocks * BITS_PER_BLOCK {
        bit_set(b)
        b = b + 1
    }
    n_root = 1
    let ino: u64 = inode_alloc(T_DIR)
    if ino != 1 {
        out.err_root_not_one()
    }
    dir_init(1, 1)
    set_meta(1, 493, 0, 0)
}
