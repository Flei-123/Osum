profile kernel

import ulib
import libc.io
import libc.mem
import mkfs.out

export { read_whole, write_whole, write_stdout, last_size }

static mut size_out: u64 = 0

fn last_size() -> u64 { return size_out }

fn read_whole(path: u64, slack: u64) -> u64 {
    let n: u64 = io.size_of(path)
    if ulib.bad(n) {
        out.err_cannot_read(path)
    }
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, 0, 0)
    if ulib.bad(fd) {
        out.err_cannot_read(path)
    }
    let buf: u64 = mem.map_pages(n + slack + 1)
    if ulib.bad(buf) {
        out.err_out_of_memory()
    }
    var at: u64 = 0
    while at < n {
        let r: u64 = ulib.sys(ulib.SYS_READ, fd, buf + at, n - at)
        if ulib.bad(r) || r == 0 {
            at = n
        } else {
            at = at + r
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    size_out = n
    return buf
}

fn write_fd(fd: u64, buf: u64, n: u64) -> bool {
    var at: u64 = 0
    var ok: bool = true
    while at < n && ok {
        var chunk: u64 = n - at
        if chunk > 1048576 {
            chunk = 1048576
        }
        let r: u64 = ulib.sys(ulib.SYS_WRITE, fd, buf + at, chunk)
        if ulib.bad(r) || r == 0 {
            ok = false
        } else {
            at = at + r
        }
    }
    return ok
}

fn write_whole(path: u64, buf: u64, n: u64) {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, ulib.O_MAKE, 420)
    if ulib.bad(fd) {
        out.err_cannot_write(path)
    }
    if !write_fd(fd, buf, n) {
        out.err_cannot_write(path)
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
}

fn write_stdout(buf: u64, n: u64) {
    write_fd(1, buf, n)
}
