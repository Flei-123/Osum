profile kernel

import ulib
import libc.io
import mkfs.ofs
import mkfs.hostio
import mkfs.out
import libc.regio

export { load }

fn or_default(v: u64, d: u64) -> u64 {
    if v == 0 {
        return d
    }
    return v
}

fn load(path: u64) -> bool {
    let size: u64 = io.size_of(path)
    if ulib.bad(size) || size < ofs.BS {
        return false
    }
    let raw: u64 = hostio.read_whole(path, 65536)
    if regio.read64_at(raw, ofs.SB_MAGIC) != ofs.MAGIC {
        return false
    }
    let ext: bool = regio.read64_at(raw, ofs.SB_XVER) != 0
    let version: u64 = or_default(regio.read64_at(raw, ofs.SB_VERSION), ofs.OFS_V2)
    let inodes: u64 = or_default(regio.read64_at(raw, ofs.SB_INODES), 128)
    let bmb: u64 = or_default(regio.read64_at(raw, ofs.SB_BMBLOCKS), 1)
    if ext {
        var blocks: u64 = regio.read64_at(raw, ofs.SB_BLOCKS)
        if regio.read64_at(raw, ofs.SB_DATA) + 8 > blocks {
            blocks = regio.read64_at(raw, ofs.SB_DATA) + 8
        }
        ofs.derive(blocks, version, inodes, 0, bmb, 0)
        ofs.attach(raw)
        var isz: u64 = ofs.isize()
        var dsz: u64 = ofs.dirent_size()
        var nsz: u64 = ofs.namelen()
        if version >= ofs.OFS_V3 {
            isz = regio.read64_at(raw, ofs.SB_ISIZE)
            dsz = regio.read64_at(raw, ofs.SB_DIRENT)
            nsz = regio.read64_at(raw, ofs.SB_NAMELEN)
        }
        ofs.set_layout(or_default(regio.read64_at(raw, ofs.SB_BITMAP), 1), bmb, regio.read64_at(raw, ofs.SB_ITABLE), isz, dsz, nsz, regio.read64_at(raw, ofs.SB_DATA))
        ofs.set_root(regio.read64_at(raw, ofs.SB_ROOT))
        ofs.set_extended(regio.read64_at(raw, ofs.SB_XBLOCKS), regio.read64_at(raw, ofs.SB_XBMSTART), regio.read64_at(raw, ofs.SB_XITSTART), regio.read64_at(raw, ofs.SB_XINODES))
        ofs.set_blocks(regio.read64_at(raw, ofs.SB_XBLOCKS))
        return true
    }
    var ipb: u64 = 4
    if version >= ofs.OFS_V3 {
        ipb = ofs.BS / or_default(regio.read64_at(raw, ofs.SB_ISIZE), 128)
    }
    let needed: u64 = 1 + bmb + (inodes + ipb - 1) / ipb + 8
    var blocks2: u64 = size / ofs.BS
    if needed > blocks2 {
        blocks2 = needed
    }
    ofs.derive(blocks2, version, inodes, 0, bmb, 0)
    ofs.attach(raw)
    if version < ofs.OFS_V3 && bmb > 1 {
        ofs.set_layout(1, bmb, regio.read64_at(raw, ofs.SB_ITABLE), ofs.isize(), ofs.dirent_size(), ofs.namelen(), regio.read64_at(raw, ofs.SB_DATA))
    }
    if version >= ofs.OFS_V3 {
        ofs.set_layout(or_default(regio.read64_at(raw, ofs.SB_BITMAP), 1), bmb, regio.read64_at(raw, ofs.SB_ITABLE), regio.read64_at(raw, ofs.SB_ISIZE), regio.read64_at(raw, ofs.SB_DIRENT), regio.read64_at(raw, ofs.SB_NAMELEN), regio.read64_at(raw, ofs.SB_DATA))
    }
    ofs.set_root(regio.read64_at(raw, ofs.SB_ROOT))
    ofs.set_version(or_default(regio.read64_at(raw, ofs.SB_VERSION), ofs.OFS_V1))
    return true
}
