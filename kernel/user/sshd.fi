static mut T_CMDPRE: [u8; 11] = "/run/sshd-\0"
static mut T_CMDSUF: [u8; 4] = ".sh\0"

static mut L_LISTEN: [u8; 20] = "sshd: listening on \0"
static mut L_FP: [u8; 26] = "sshd: host key SHA256:\0\0\0\0"
static mut L_ALGS: [u8; 62] =
    "sshd: curve25519-sha256 + ssh-ed25519 + chacha20-poly1305\0\0\0\0\0"
static mut L_ACCEPT: [u8; 20] = "sshd: accepted from\0"
static mut L_KEXOK: [u8; 20] = "sshd: kex complete\n\0"
static mut L_STRICT: [u8; 26] = "sshd: strict kex agreed\n\0\0"
static mut L_AUTHOK: [u8; 16] = "sshd: auth ok: \0"
static mut L_AUTHBAD: [u8; 20] = "sshd: auth refused \0"
static mut L_PKOK: [u8; 26] = "sshd: publickey accepted\n\0"
static mut L_PWOK: [u8; 25] = "sshd: password accepted\n\0"
static mut L_EXEC: [u8; 15] = "sshd: exec -- \0"
static mut L_SHELL: [u8; 21] = "sshd: shell started\n\0"
