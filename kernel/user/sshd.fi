static mut T_ENV: [u8; 4] = "env\0"
static mut T_WINCH: [u8; 14] = "window-change\0"
static mut T_EXITSTATUS: [u8; 12] = "exit-status\0"
static mut T_SH: [u8; 8] = "/bin/sh\0"
static mut T_SLASH: [u8; 2] = "/\0"
static mut T_SSHDIR: [u8; 6] = "/.ssh\0"
static mut T_AKPATH: [u8; 22] = "/.ssh/authorized_keys\0"
static mut T_ETCSSH: [u8; 9] = "/etc/ssh\0"
