static mut T_CURVE: [u8; 18] = "curve25519-sha256\0"
static mut T_CURVE2: [u8; 29] = "curve25519-sha256@libssh.org\0"
static mut T_HOSTALG: [u8; 12] = "ssh-ed25519\0"
static mut T_CIPHER: [u8; 30] = "chacha20-poly1305@openssh.com\0"
static mut T_MACS: [u8; 14] = "hmac-sha2-256\0"
static mut T_NONE: [u8; 5] = "none\0"
static mut T_EMPTY: [u8; 1] = "\0"
static mut T_USERAUTH: [u8; 13] = "ssh-userauth\0"
static mut T_CONNECTION: [u8; 15] = "ssh-connection\0"
static mut T_PUBKEY: [u8; 10] = "publickey\0"
static mut T_PASSWORD: [u8; 9] = "password\0"
static mut T_METHODS: [u8; 19] = "publickey,password\0"
static mut T_SESSION: [u8; 8] = "session\0"
static mut T_SHELL: [u8; 6] = "shell\0"
static mut T_EXEC: [u8; 5] = "exec\0"
