const MAX_TRIES: u64 = 6
const HS_MS: u64 = 20000
const WINDOW: u64 = 1048576
const MAXPKT: u64 = 32768

const NEED_MORE: u64 = 0xFFFFFFFFFFFFFFFF
const BROKEN: u64 = 0xFFFFFFFFFFFFFFFE

const SYS_SETUID: u64 = 105
const SYS_SETGID: u64 = 106
const SYS_EXECVE: u64 = 59
const SYS_GETRANDOM: u64 = 318
const SYS_OSUM_PTY: u64 = 1100
const SYS_CHMOD: u64 = 90
