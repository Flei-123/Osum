// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/fuib.fi -- DIE BRUECKE: wlibs BEDIENELEMENTE KOMMEN AB
// JETZT AUS fUi.
//
// ====================================================== WARUM SIE EXISTIERT
//
// Justin, 11.09.2026, woertlich: "wenn fui alles kann bitte bau es
// ueberall ein. ich will nicht dass jemand es selber hardcodiert oder
// eine eigene library verwendet, das ergibt nur chaos, wenns ein bug
// gibt brauchen wir nur einmal die lib aendern."
//
// Genau dieses Chaos stand im Baum: fUi (7963 Zeilen, lib/fui, ueber
// den festgenagelten Commit in JEDEM Baum derselbe) malt einen Knopf,
// und wlib.fi malt DENSELBEN Knopf ein zweites Mal, 1168 Zeilen weiter
// unten -- paint_button, paint_slider, paint_check, paint_entry,
// paint_list, paint_table, paint_tabs, paint_tile, mal_tafel,
// mal_balken. Zwei Umsetzungen einer Optik heisst: zwei Orte fuer
// jeden Fehler, und der zweite wird vergessen.
//
// ============================================ WARUM ES EINE BRUECKE IST
//                                              UND NICHT EIN NEUBAU
//
// Gemessen in diesem Baum, nicht angenommen: von wlibs 7246 Zeilen sind
// nur 1168 Bedienelemente und Malschicht. Die anderen 6078 sind etwas
// ANDERES als eine Widget-Bibliothek:
//
//   on_down 272 Zeilen, taste_verarbeiten 199, on_move 163, step 132
//        -- die Ereignisschleife und die Tastatur,
//   begin/window/window_app/new_win/place/dirty/paint_all
//        -- der Fensterserver und die Schmutzrechtecke,
//   box_v/box_h/box_grid/box_at  -- das Kastenlayout,
//   dlg_new 99/dlg_wahl 84       -- die Dialoge,
//   anim_*, theme_watch, sel_*, K_LEINWAND (fuer Certus).
//
// Dahinter haengen 23 Programme mit ueber 1300 Aufrufstellen --
// settings.fi allein 363. fUi ist IMMEDIATE MODE (malt ein Widget je
// Bild), wlib ist RETAINED MODE (haelt eine Widgetliste). Das sind
// zwei Architekturen; wer sie in einem Schritt tauscht, fasst 23
// Programme gleichzeitig an und kann am Ende nichts davon messen.
//
// Also die Naht dort, wo die beiden sich WIRKLICH ueberschneiden:
// `wlib.paint_one` -- die EINE Stelle, an der wlib entscheidet, welches
// Element gemalt wird. Sie ruft ab jetzt hierher, und hier malt fUi.
// Die Programme merken nichts, die Fensterverwaltung bleibt, und es
// gibt trotzdem nur noch EINE Umsetzung jedes Bedienelements.
//
// ============================================== WIE fUi AUF DIE FLAECHE KOMMT
//
// Ohne zweiten Puffer und ohne Kopie. `wlibc.surface()` gibt die
// Fensterflaeche des Servers her: w * h * 4 Oktette, ein 32-Bit-Punkt
// je Stelle, zeilenweise -- `wlibc.px` schreibt an (r * w + x) * 4.
// `paint.canvas.Canvas` ist dasselbe: `px: *mut u8`, w * h * 4, RGBA.
// Also zeigt die Leinwand DIREKT auf die Flaeche des Servers
// (`canvas_on_surface`), und fUi malt dort, wo wlibc malen wuerde.
//
// Das ist gemessen und nicht gehofft: /tmp/mix2/wrap.fi hat genau das
// getan und liess sich zu einer Ring-3-ELF binden.
//
// ================================================== DAS FARBSCHEMA GEWINNT
//
// fUi bringt eigene Farben mit (theme.colors_light/colors_dark). Die
// werden hier NICHT benutzt. Das System hat ein Schema -- /etc/theme.conf,
// fuenf Schemata, hell/dunkel/automatisch, Akzentfarbe -- und es liegt
// in `wlibc.theme(T_*)`. `theme_from_osum` schreibt genau diese Werte
// in fUis Farbtafel. Damit schlaegt ein Wechsel des Schemas durch, ohne
// dass hier eine Farbe steht, und ein dunkles System hat kein weisses
// Fenster.
profile app

import ulib
import wlibc
import paint.canvas
import font.metrics
import fuiglyph
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.wave2
import fui.uiimage
import fui.transform

export {
    ready, draw, draw_area_on, theme_new,
    // FUI-ALL stage 3: fUi's password mask.
    secret_mask,
    // RUNDE 31: DIE ZAEHLER. Ohne sie ist "fUi malt jetzt" eine
    // Behauptung: `mal` hat einen Rueckfall auf wlibs alten Weg, und
    // ein Bild sieht in beiden Faellen aehnlich aus. Diese zwei Zahlen
    // sagen, WELCHER Weg gelaufen ist -- gemalt und abgelehnt.
    fui_painted, fui_rejected, fui_reasons,
    // RUNDE 31: die MALSCHICHT. wlibs `mal_tafel`/`mal_flaeche`/
    // `mal_balken` geben ihre Farbe SELBST vor (das Kontrollzentrum
    // waehlt sie sorgfaeltig) -- fUi soll sie malen, nicht ersetzen.
    tafel, area, ring, tip_place,
    // RUNDE GLAS: der Anstoss fuer ein neues Bild. `wlib.paint_all`
    // ruft ihn, damit die zwei Wege dieser Bruecke im selben Takt
    // melden wie wlibs Widgettypen.
    radius_bild,
    // Fuer wlib: die Zustaende, die ein Element haben kann.
    Z_NORMAL, Z_HOVER, Z_PRESSED, Z_OFF, Z_FOCUS,
    // Die Sorten, die diese Bruecke malen kann.
    S_BUTTON, S_LABEL, S_CHECK, S_ENTRY, S_SLIDER, S_TILE,
    S_CARD, S_SEP, S_TABS, S_MENUBAR, S_CHOICE, S_SCROLL,
    S_PROGRESS,
    // ROUND FUI-ALL stage 1: wlib's paint primitives, drawn by fUi.
    rect, hline, vline, dot, frame, frame3, rrect, rring, rframe, shadow,
    fui_prims, icon, picture,
    // FUI-ALL stage 2: a program's own fUi canvas (see fuiapp.fi).
    app_bind, app_ctx, app_canvas, app_theme,
}

const Z_NORMAL: u64 = 0
const Z_HOVER: u64 = 1
const Z_PRESSED: u64 = 2
const Z_OFF: u64 = 3
const Z_FOCUS: u64 = 4

const S_BUTTON: u64 = 0
const S_LABEL: u64 = 1
const S_CHECK: u64 = 2
const S_ENTRY: u64 = 3
const S_SLIDER: u64 = 4
const S_TILE: u64 = 5
const S_CARD: u64 = 6
const S_SEP: u64 = 7
const S_TABS: u64 = 8
const S_MENUBAR: u64 = 9
const S_CHOICE: u64 = 10
const S_SCROLL: u64 = 11
const S_PROGRESS: u64 = 12

// Der Zustand dieser Bruecke. Er wird EINMAL aufgebaut und dann bei
// jedem Anstrich benutzt -- eine Leinwand je Bild waere eine
// Speicheranforderung je Bild.
// ANMERKUNG ZU DEN `static`s: Firn schreibt den Anfangswert eines
// `static` in die Objektdatei, also MUSS er ein Literal sein -- es
// laeuft kein Code vor `main`, der ihn ausrechnen koennte (SPEC
// 14.1.statics). `canvas_new()` und `theme_new()` sind Aufrufe, also
// hier nicht erlaubt.
//
// Die Strukturen liegen deshalb als WORTFELDER da und werden in
// `bereit()` einmal richtig gefuellt. Das ist dieselbe Bauweise, die
// wlib fuer seine Fenstertafel benutzt: ein Feld Woerter, ein Zeiger
// darauf, und die Struktur liegt darin. Reichlich bemessen, damit ein
// Zuwachs in der Bibliothek hier nicht still daneben schreibt --
// geprueft wird das trotzdem, siehe `bereit`.
// Firn will bei der Laenge eines Feldes eine ZAHL sehen, keinen
// benannten Wert -- deshalb stehen die 128/64/128 hier ausgeschrieben
// und die Namen daneben nur als Erklaerung.
//   s_cvm  128 Woerter = 1024 Oktette  fuer paint.canvas.Canvas
//   s_pzm  256 Woerter = 2048 Oktette  fuer fui.painter.Painter
//          (FUI-ALL: Painter is 648 octets since the Firn pin of stage 0;
//          at 64 words `ready()` refused it and EVERY program silently
//          painted with wlibc again -- measured: prims=0, fui=0.)
//   s_thm  128 Woerter = 1024 Oktette  fuer fui.theme.Theme
// Ob das reicht, wird in `bereit()` GEMESSEN und nicht geglaubt.
const CV_BYTES: usize = 1024
const PZ_BYTES: usize = 2048
const TH_BYTES: usize = 1024

static mut s_auf: u64 = 0
static mut s_said_big: u64 = 0
static mut m_big: [u8; 46] = "fuib: wlibc fallback, fUi struct grew: cv/pz=\0"
static mut m_sp: [u8; 2] = " \0"
static mut s_cvm: [u64; 128] = [0; 128]
static mut s_pzm: [u64; 256] = [0; 256]
static mut s_thm: [u64; 128] = [0; 128]
// render.Ctx carries a function pointer (the animation hook) since the
// Firn pin of round FUI-ALL, and a static cannot be initialised with one.
// So it lives in raw words, filled by render.ctx_new in `bereit()`.
static mut s_ctxm: [u64; 8] = [0; 8]
fn ctx() -> *mut render.Ctx { return (&s_ctxm[0 as usize]) as u64 as *mut render.Ctx }
static mut s_fm: u64 = 0
static mut s_n_ok: u64 = 0
static mut s_n_no: u64 = 0
// RUNDE 32: WARUM wurde abgelehnt? `fuix` allein sagt es nicht, und
// ohne den Grund kann man nicht entscheiden, ob der Rueckfall noch
// gebraucht wird. Vier Gruende, vier Zaehler.
static mut s_no_bereit: u64 = 0
static mut s_no_leer: u64 = 0
static mut s_no_band: u64 = 0
static mut s_no_art: u64 = 0
// ====================================================== RUNDE GLAS
// WELCHER RADIUS AUF WELCHEM WEG -- UND WARUM DAS GEMESSEN WIRD.
//
// `tafel` hat zwei Ausgaenge: den Vektorzeichner (`painter.round_rect`)
// und, wenn es keine Fensterflaeche gibt, `wlibc.rrect`. Beide bekommen
// DENSELBEN `r` -- das steht seit Runde 32 so da, aber es stand
// nirgends auf der Leitung. Eine Zusage "der Radius kommt ueberall an",
// bei der ein Weg heimlich eckig malen koennte, ist keine Zusage,
// sondern eine Hoffnung.
//
// Gemeldet wird der GEDECKELTE Wert (halbe kuerzere Seite), weil genau
// der im Bild steht, und je Bild nur EINMAL je Wert und Weg: eine Seite
// malt hunderte Tafeln mit drei verschiedenen Radien, und drei Zeilen
// sagen darueber alles, was hundert Zeilen auch sagen.
static mut s_rreden: u64 = 0
static mut s_rvek: [u64; 8] = [0; 8]
static mut s_rrct: [u64; 8] = [0; 8]
static mut s_nvek: u64 = 0
static mut s_nrct: u64 = 0
static mut fr_a: [u8; 15] = "fuib: tafel r=\0"
static mut fr_v: [u8; 12] = " weg=vektor\0"
static mut fr_r: [u8; 11] = " weg=rrect\0"

fn radius_bild(reden: bool) {
    if reden {
        s_rreden = 1
    } else {
        s_rreden = 0
    }
    s_nvek = 0
    s_nrct = 0
}

// Der Wert, den `rrect` und `round_rect` wirklich malen: beide deckeln
// auf die halbe kuerzere Seite, und MR_GRIFF schickt absichtlich
// 0xFFFF ("so rund wie moeglich").
fn radius_eff(r: u64, w: u64, h: u64) -> u64 {
    var kurz: u64 = w
    if h < kurz {
        kurz = h
    }
    if r > kurz / 2 {
        return kurz / 2
    }
    return r
}

fn say_tafel(r: u64, vektor: bool) {
    if s_rreden == 0 {
        return
    }
    var n: u64 = s_nrct
    if vektor {
        n = s_nvek
    }
    var k: u64 = 0
    while k < n {
        var alt: u64 = s_rrct[k as usize]
        if vektor {
            alt = s_rvek[k as usize]
        }
        if alt == r {
            return
        }
        k = k + 1
    }
    if n >= 8 {
        return
    }
    if vektor {
        s_rvek[n as usize] = r
        s_nvek = n + 1
    } else {
        s_rrct[n as usize] = r
        s_nrct = n + 1
    }
    ulib.say((&fr_a[0 as usize]) as u64)
    ulib.sayn(r)
    if vektor {
        ulib.say((&fr_v[0 as usize]) as u64)
    } else {
        ulib.say((&fr_r[0 as usize]) as u64)
    }
    ulib.nl()
}

fn fui_painted() -> u64 {
    return s_n_ok
}

fn fui_rejected() -> u64 {
    return s_n_no
}

// Die Gruende, in einer Zahl: bereit*1000000 + leer*10000 + band*100 + art.
// Eine Zahl, weil die Taskleiste sie in EINER Zeile meldet.
fn fui_reasons() -> u64 {
    return s_no_bereit * 1000000 + s_no_leer * 10000
        + s_no_band * 100 + s_no_art
}

fn cv() -> *mut canvas.Canvas {
    return ((&s_cvm[0 as usize]) as u64) as *mut canvas.Canvas
}

fn pz() -> *mut painter.Painter {
    return ((&s_pzm[0 as usize]) as u64) as *mut painter.Painter
}

fn th() -> *mut theme.Theme {
    return ((&s_thm[0 as usize]) as u64) as *mut theme.Theme
}

// ------------------------------------------------------------------
// DIE LEINWAND ZEIGT AUF DIE FENSTERFLAECHE.
//
// `canvas_init` wuerde einen eigenen Puffer anfordern; das ist hier
// genau falsch -- die Bildpunkte gehoeren dem Fensterserver. Die
// Felder werden deshalb direkt gesetzt. Es gibt in `paint.canvas`
// kein `canvas_wrap`, und eines dort einzubauen waere eine Aenderung
// an der gemeinsamen Bibliothek fuer einen Fall, den nur Osum hat.
// ------------------------------------------------------------------
// ==================================================================
// RUNDE 32: DIE KANALREIHENFOLGE. DER FEHLER, DEN RUNDE 31 EINGEBAUT
// UND DIE HELLIGKEITSMESSUNG NICHT GESEHEN HAT.
//
// Justin hat die Belege selbst nachgemessen, nach FARBTON und nicht
// nach Helligkeit, und damit den Fehler gefunden:
//
//   dunkel-05-kontrollzentrum.png
//     Panel und Taskleiste   RGB( 59, 41, 30)   braun
//     dieselbe Farbe woanders RGB( 30, 41, 59)  neutral-dunkelblau
//
// Zweimal dieselbe Farbe im SELBEN Bild, einmal richtig und einmal mit
// vertauschtem R und B. `night.scheme` sagt `neutral800=1e293b`, also
// ist RGB(30,41,59) richtig und RGB(59,41,30) die Umkehrung.
//
// WARUM: die beiden Seiten legen einen Bildpunkt VERSCHIEDEN ab.
//
//   wlibc.px schreibt EIN u32 (`__mmio_write32`), und wlibc baut die
//   Farbe als (r << 16) | (g << 8) | b. Auf x86 liegt ein u32 mit dem
//   niedrigsten Oktett zuerst -- im Speicher steht also B, G, R, A.
//
//   paint/canvas.fi legt VIER OKTETTE ab, und zwar in dieser Reihe:
//       st8(p,   (v >> 16) & 255)   // R
//       st8(p+1, (v >>  8) & 255)   // G
//       st8(p+2,  v        & 255)   // B
//       st8(p+3, (v >> 24) & 255)   // A
//   also R, G, B, A.
//
// Beide Wege malen in DENSELBEN Speicher (die Bruecke laesst die
// Leinwand ja mit Absicht direkt auf `wlibc.surface()` zeigen). Wer
// die Oktette der Leinwand als BGRA liest, sieht R und B getauscht.
//
// Nachgerechnet fuer 0x1E293B: canvas legt 30,41,59 ab; als BGRA
// gelesen ist das B=30 G=41 R=59, also RGB(59,41,30) -- genau der
// gemessene Braunton.
//
// WARUM ES IM HELLMODUS NICHT AUFFIEL: |R-B| ist bei Weiss 0, bei
// f8fafc 4, bei f1f5f9 8. Grautoene sind unter der Umkehr fast
// unveraendert, und die Abnahme hat nur die HELLIGKEIT gemessen --
// Braun ist dunkler als Weiss, also war sie gruen. Erst eine
// gesaettigte Dunkelfarbe zeigt es.
//
// WO DER FEHLER BEHOBEN WIRD, UND WO NICHT:
//
//   NICHT in paint/canvas.fi. Das ist die GEMEINSAME Bibliothek (Certus
//   malt damit seine Seiten, der fUi-Pruefstand seine PNG). Dort ist
//   R,G,B,A richtig -- ein PNG erwartet genau das. Wer sie umbaut,
//   dreht jedes andere Bild falsch.
//
//   SONDERN HIER, an der Naht. Diese Bruecke ist die einzige Stelle,
//   an der eine wlibc-Farbe in fUis Maler geht, also ist sie die
//   einzige Stelle, an der umgerechnet werden muss -- genau einmal,
//   fuer jede Farbe, die hinuebergeht.
fn swap_rb(c: u64) -> u32 {
    // Swap R and B, leave G and A alone. That makes canvas.fi lay the
    // octets down in the order the framebuffer expects.
    let r: u64 = (c >> 16) & 255
    let g: u64 = (c >> 8) & 255
    let b: u64 = c & 255
    return ((b << 16) | (g << 8) | r) as u32
}

fn canvas_on_surface(c: *mut canvas.Canvas, px: u64, w: usize, h: usize) {
    (*c).px = px as *mut u8
    (*c).w = w
    (*c).h = h
    (*c).cap = w * h * 4
    (*c).depth = 0
    (*c).mode = canvas.BLEND_NORMAL
    (*c).cx0[0] = 0.0
    (*c).cy0[0] = 0.0
    (*c).cx1[0] = w as f64
    (*c).cy1[0] = h as f64
    (*c).cmask[0] = 0
    (*c).ok = 1
}

// ------------------------------------------------------------------
// DAS SCHEMA DES SYSTEMS IN fUis FARBTAFEL.
//
// Jede Rolle, die fUi kennt, bekommt den Wert, den das System dafuer
// fuehrt. Wo Osum keine eigene Rolle hat, wird die naechstliegende
// genommen und das steht daneben -- geraten wird nichts.
// ------------------------------------------------------------------
fn theme_new() {
    let dunkel: bool = wlibc.theme_dark()
    theme.theme_set_dark(th(), dunkel)
    let f: *mut theme.Colors = theme.theme_colors(th())
    (*f).base = swap_rb(wlibc.theme(wlibc.T_BG))
    (*f).surface = swap_rb(wlibc.theme(wlibc.T_PANEL))
    // Eine Karte und ein Menue stehen naeher am Auge als die Flaeche.
    (*f).surface_raised = swap_rb(wlibc.theme(wlibc.T_MENU))
    (*f).button = swap_rb(wlibc.theme(wlibc.T_BTN))
    (*f).button_hover = swap_rb(wlibc.theme(wlibc.T_BTNHI))
    (*f).button_active = swap_rb(wlibc.theme(wlibc.T_BTNDN))
    (*f).field = swap_rb(wlibc.theme(wlibc.T_ENTRY))
    // Osum kennt kein eigenes "Feld hat den Fokus": der Fokusring
    // macht das sichtbar, die Flaeche bleibt.
    (*f).field_focus = swap_rb(wlibc.theme(wlibc.T_ENTRY))
    (*f).border_col = swap_rb(wlibc.theme(wlibc.T_LINE))
    (*f).separator = swap_rb(wlibc.theme(wlibc.T_LINE))
    (*f).text = swap_rb(wlibc.theme(wlibc.T_FG))
    (*f).text_muted = swap_rb(wlibc.theme(wlibc.T_DIM))
    (*f).text_disabled = swap_rb(wlibc.theme(wlibc.T_DIM))
    (*f).accent = swap_rb(wlibc.theme(wlibc.T_ACCENT))
    (*f).selection = swap_rb(wlibc.theme(wlibc.T_SEL))
    (*f).selection_text = swap_rb(wlibc.theme(wlibc.T_SELFG))
    (*f).text_on_accent = swap_rb(wlibc.theme(wlibc.T_SELFG))
    (*f).dark = dunkel
    // Die Form: Osum fuehrt die Radien in seinen Metriken, und
    // `classic` heisst Radius 0. Dieselbe Zahl, nicht eine zweite.
    let fo: *mut theme.Shape = theme.theme_shape(th())
    (*fo).r_button = wlibc.metric(wlibc.M_RADIUS_BUTTON) as usize
    (*fo).r_panel = wlibc.metric(wlibc.M_RADIUS_PANEL) as usize
    (*fo).r_window = wlibc.metric(wlibc.M_RADIUS_WINDOW) as usize
    (*fo).r_field = wlibc.metric(wlibc.M_RADIUS_INPUT) as usize
    (*fo).border_w = wlibc.metric(wlibc.M_BORDER) as usize
}

// ------------------------------------------------------------------
// EINMAL AUFBAUEN. Danach ist `bereit` wahr und `mal` kann malen.
//
// Die Schrift ist die des Systems, nicht die der Bibliothek: Osum
// rastert seine Glyphen selbst (wlibc), und fUis Maler braucht eine
// eigene Schrift nur fuer den Text, den er selbst setzt. Findet er
// keine, malt er die Flaechen und ueberlaesst den Text der
// aufrufenden Seite -- genau so, wie wlib den Text heute schon selbst
// setzt (`put_text`, damit Umlaute und Kuerzung gleich bleiben).
// ------------------------------------------------------------------
fn ready() -> bool {
    if s_auf != 0 {
        return true
    }
    let sp: u64 = wlibc.surface()
    if sp == 0 {
        return false
    }
    let w: usize = wlibc.surf_w() as usize
    let h: usize = wlibc.surf_rows() as usize
    if w == 0 || h == 0 {
        return false
    }
    // DIE WORTFELDER MUESSEN GROSS GENUG SEIN. Wuechse eine der
    // Strukturen in der Bibliothek ueber ihr Feld hinaus, schriebe
    // `painter_init` daneben -- in `s_thm` oder ins Nichts. Das waere
    // ein Fehler, der irgendwo ANDERS auftaucht. Also einmal messen,
    // und zwar an der Struktur selbst und nicht an einer getippten
    // Zahl: der Abstand zweier Felder eines Feldes IST ihre Groesse.
    var mcv: [canvas.Canvas; 2] = [canvas.canvas_new(); 2]
    let ncv: usize = ((&mcv[1]) as u64 - (&mcv[0]) as u64) as usize
    var mpz: [painter.Painter; 2] = [painter.painter_new(); 2]
    let npz: usize = ((&mpz[1]) as u64 - (&mpz[0]) as u64) as usize
    var mth: [theme.Theme; 2] = [theme.theme_new(false); 2]
    let nth: usize = ((&mth[1]) as u64 - (&mth[0]) as u64) as usize
    var mcx: [render.Ctx; 2] = [render.ctx_new(&mth[0], &mpz[0]); 2]
    let ncx: usize = ((&mcx[1]) as u64 - (&mcx[0]) as u64) as usize
    if ncv > CV_BYTES || npz > PZ_BYTES || nth > TH_BYTES || ncx > 64 {
        // Say it, once: a silent refusal here made every program paint
        // with wlibc again for a whole stage without anybody seeing it.
        if s_said_big == 0 {
            s_said_big = 1
            ulib.say((&m_big[0 as usize]) as u64)
            ulib.sayn(ncv as u64)
            ulib.say((&m_sp[0 as usize]) as u64)
            ulib.sayn(npz as u64)
            ulib.say((&m_sp[0 as usize]) as u64)
            ulib.sayn(nth as u64)
            ulib.say((&m_sp[0 as usize]) as u64)
            ulib.sayn(ncx as u64)
            ulib.nl()
        }
        return false
    }
    canvas_on_surface(cv(), sp, w, h)
    // ==================================== RUNDE FUI-VENDOR-BILD
    // DER RASTERVORRAT MUSS DIE HOECHSTE FLAECHE FASSEN, DIE fUi HIER
    // MALT -- SONST MALT ES SIE STILL GAR NICHT.
    //
    // Hier stand 64, ohne Begruendung. `painter.raster_window` gibt
    // `false` zurueck, sobald die gewuenschte Flaeche hoeher ist als
    // dieser Vorrat, und `round_rect` kehrt daraufhin WORTLOS zurueck
    // (der Kopf von `run_draw` beschreibt dieselbe Falle fuer Text:
    // "the gradient looked broken; in truth nothing was drawn at all").
    //
    // GEMESSEN, 13.09.2026: die Kachel des Kontrollzentrums wurde in
    // dieser Runde von 49 auf 67 Bildpunkte hoch (zweizeilige
    // Beschriftung). 67 + 2 Punkte Luft > 64, also fiel die Fuellung
    // aus. Im Bild blieben von der eingeschalteten Kachel 13 Zeilen
    // Akzentfarbe statt 67 -- der Rest kam aus dem Rueckfall. Der
    // Quelltext sah dabei voellig richtig aus; nur das Bild zeigte es.
    //
    // ==================================== RUNDE GEISTERBALKEN
    // DER VORRAT FOLGT DER FLAECHE, NICHT EINER GETIPPTEN ZAHL.
    //
    // Hier stand 96, mit der Begruendung "mehr als `wlibc.SURF_ROWS`
    // (81)". Die Begruendung stimmte nicht: eine Konstante SURF_ROWS
    // gibt es in diesem Baum nicht. `wlibc.surf_rows()` ist GERECHNET
    // -- SURF_BUDGET (1 MiB) geteilt durch Schirmbreite*4 -- und
    // liefert 204 Zeilen bei 1280, 136 bei 1920, 76 bei 3440. Die 96
    // war also je nach Schirm zu gross ODER ZU KLEIN, und zu klein
    // heisst bei `raster_window`: `false`, und `round_rect` kehrt
    // WORTLOS zurueck.
    //
    // `h` ist genau die Zahl, die zaehlt: so viele Zeilen traegt die
    // Zeichenflaeche, und mehr kann auf ihr gar nicht entstehen --
    // `wlibc.px` verwirft alles dahinter. Plus 3, weil `raster_window`
    // mit `luft = 1.0` oben und unten je einen Punkt dazunimmt und
    // dann noch aufrundet ((by-ay) as usize + 1).
    //
    // Warum das jetzt WICHTIG ist: seit Runde GEISTERBALKEN malt das
    // Kontrollzentrum eine Kachel in EINEM Stueck (die Bandgrenzen
    // liegen auf Elementkanten, qs.fi `band_ende`). Vorher kam nie
    // eine Form ueber 64 Zeilen hier an, weil das Band sie zerschnitt
    // -- deshalb ist der Vorrat bisher nie aufgefallen. Jetzt kommen
    // 136 Zeilen am Stueck, und ein zu kleiner Vorrat waere derselbe
    // stille Fehlschlag wie damals, nur an anderer Stelle.
    let vorrat: usize = h + 3
    if !painter.painter_init(pz(), cv(), w, vorrat) {
        return false
    }
    painter.painter_set_font(pz(), s_fm)
    *th() = theme.theme_new(wlibc.theme_dark())
    theme_new()
    *ctx() = render.ctx_new(th(), pz())
    s_auf = 1
    return true
}

// Die Flaeche kann sich aendern (Fenstergroesse, Aufloesung, Band).
// Dann zeigt die Leinwand auf den falschen Speicher, und das waere ein
// Schreiben daneben -- also bei jedem Anstrich nachziehen.
fn draw_area_on() {
    let sp: u64 = wlibc.surface()
    if sp == 0 {
        return
    }
    let w: usize = wlibc.surf_w() as usize
    let h: usize = wlibc.surf_rows() as usize
    if ((*cv()).px as u64) != sp || (*cv()).w != w || (*cv()).h != h {
        canvas_on_surface(cv(), sp, w, h)
    }
}

// ------------------------------------------------------------------
// EINE TAFEL MIT VORGEGEBENER FARBE -- fUis Maler, wlibs Farbe.
//
// `mal_tafel` bekommt Fuellung und Rand vom Aufrufer; das Kontroll-
// zentrum rechnet seine Kachelfarben aus dem Schema und dem Zustand
// selbst. fUi soll hier also nicht die Farbe BESTIMMEN, sondern die
// FLAECHE malen -- dieselbe Kurve, derselbe Radius, ein Rasterer.
// Genau das ist `painter.round_rect`/`round_ring`.
// ====================================================== RUNDE 32
// DER RUECKFALL LIEGT JETZT HIER UND NICHT BEI JEDEM AUFRUFER.
//
// Justin: "wlib.fi ist auf 7355 Zeilen GEWACHSEN statt geschrumpft --
// am Ende dieser Runde muss es deutlich kleiner sein. Sag die Zahl."
//
// Der Zuwachs war der Rueckfall: jede der 26 Stellen in wlib trug ein
//
//     if !fuib.tafel(...) { <der alte Weg mit wlibc> }
//
// also drei bis sechs zusaetzliche Zeilen. Sechsundzwanzig Mal.
//
// GEMESSEN, warum das weg kann (der Zaehler `fuig` aus dieser Runde):
// in einem vollen Lauf gab es VIER Ablehnungen, alle vier "leeres
// Rechteck" (w oder h ist 0), und NULL "nicht bereit". Und ein leeres
// Rechteck malt auch der alte Weg nicht: `wlibc.rect` prueft in seiner
// zweiten Zeile `if w == 0 || h == 0 { return }`, und rrect, rframe,
// rring, vrect, vkreis und divider tun dasselbe. Der Rueckfall fuer
// diesen Fall war also nachweislich toter Code.
//
// Bleibt der Fall, in dem es KEINE Fensterflaeche gibt (`bereit` ist
// falsch). Der ist in den Messungen nie eingetreten, aber er ist
// moeglich -- und ein Element, das dann gar nicht erscheint, waere
// schlimmer als ein eckiges. Also malt die Bruecke in diesem Fall
// SELBST mit wlibc, hier, an einer Stelle. Damit gibt `tafel` immer
// `true` zurueck und der Aufrufer braucht kein `if` mehr.
fn tafel(x: u64, y: u64, w: u64, h: u64, r: u64, fuellung: u64,
    rand: u64, randbreite: u64) -> bool {
    if !ready() {
        s_n_no = s_n_no + 1
        s_no_bereit = s_no_bereit + 1
        // Der alte Weg, EINMAL, statt sechsundzwanzigmal in wlib.
        say_tafel(radius_eff(r, w, h), false)
        if rand == 0 || randbreite == 0 {
            wlibc.rrect(x, y, w, h, r, fuellung)
        } else {
            wlibc.rframe(x, y, w, h, r, randbreite, rand, fuellung)
        }
        return true
    }
    if w == 0 || h == 0 {
        s_n_no = s_n_no + 1
        s_no_leer = s_no_leer + 1
        return false
    }
    clip_sync()
    // ================================================== RUNDE 32
    // EIN RECHTECK, DAS OBEN AUS DEM BAND HERAUSRAGT, WIRD BESCHNITTEN
    // UND NICHT ABGELEHNT.
    //
    // GEMESSEN (fuig=41400, der Zaehler aus dieser Runde): von 18
    // Ablehnungen in einem vollen Lauf waren VIERZEHN `y < band_y`.
    // Das Band ist der waagerechte Streifen, den der Fensterserver
    // gerade neu malen laesst (`wlibc.set_band`); ein Element, das
    // hoeher beginnt, ist kein Fehler -- es ist teilweise sichtbar.
    // `wlibc.px` verwirft dann einfach die Punkte darueber.
    //
    // Vorher gab die Bruecke in diesem Fall auf, und der alte Weg
    // malte -- also malten pro Lauf vierzehn Flaechen NICHT mit fUi,
    // ohne dass man es im Bild sah. Jetzt wird der obere Teil
    // abgeschnitten und der Rest von fUi gemalt.
    let b: u64 = wlibc.band_y()
    var yy: u64 = y
    var hh: u64 = h
    if yy < b {
        let weg: u64 = b - yy
        if weg >= hh {
            // Ganz oberhalb des Bandes: nichts zu malen, und das ist
            // KEIN Rueckfall -- der alte Weg haette auch nichts
            // gemalt. Also als Erfolg zaehlen, sonst zaehlt der
            // Zaehler eine Ablehnung, die keine ist.
            s_n_ok = s_n_ok + 1
            return true
        }
        hh = hh - weg
        yy = b
    }
    let fy: f64 = (yy - b) as f64
    // `rrect` deckelt den Radius auf die halbe kuerzere Seite, und
    // MR_GRIFF schickt absichtlich 0xFFFF ("so rund wie moeglich").
    // Dieselbe Deckelung hier, sonst malt fUi eine Ecke, wo wlib eine
    // Kapsel gemalt haette.
    // Der Radius richtet sich nach der ECHTEN Groesse des Elements
    // (h), nicht nach dem beschnittenen Teil (hh): eine Kachel, die
    // halb im Band liegt, hat oben denselben Rundungsradius wie eine
    // ganz sichtbare. Wuerde hier `hh` stehen, wechselte die Rundung
    // mit dem Band -- und das Band haengt daran, was der Server gerade
    // neu malen laesst.
    var rr: u64 = r
    var short: u64 = w
    if h < short {
        short = h
    }
    if rr > short / 2 {
        rr = short / 2
    }
    say_tafel(rr, true)
    painter.round_rect(pz(), x as f64, fy, w as f64, hh as f64,
        rr as f64, swap_rb(fuellung))
    if rand != 0 && randbreite != 0 {
        painter.round_ring(pz(), x as f64, fy, w as f64, hh as f64,
            rr as f64, randbreite as f64, swap_rb(rand))
    }
    s_n_ok = s_n_ok + 1
    return true
}

// Eine Flaeche ohne Radius und ohne Rand -- `mal_flaeche`.
// ============================================= RUNDE BELEG: DIE BLASE
// WEICHT AUS, UND ZWAR IN fUi GERECHNET.
//
// Justins Befund am Abbild: die Blase "no network" klebte rechts unten
// bei der Uhr. Gemessen an dunkel-05-kontrollzentrum.png: Blase
// x 1140..1215 y 730..753, Leiste ab y 760, Uhr x 1166..1269. Sie
// verdeckte die Uhr nicht, stand aber in derselben Spalte, und ihre
// Unterkante beruehrte die Leiste.
//
// Die Rechnung dazu steht in fUi (`wave2.tooltip_place`) und NICHT hier
// und auch nicht in der Leiste -- sonst hat jeder Aufrufer seine eigene
// Antwort auf dieselben drei Fragen (faellt sie vom Schirm, verdeckt sie
// ihre eigene Leiste, verdeckt sie etwas Lesbares).
//
// Diese Bruecke rechnet nur um: Osum rechnet in ganzen Bildpunkten, fUi
// in f64.
fn tip_place(sx: u64, sy: u64, bw: u64, bh: u64,
    sw: u64, sh: u64, ay0: u64, ay1: u64, ax0: u64, ax1: u64,
    gap: u64, ox: *mut u64, oy: *mut u64) {
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    wave2.tooltip_place(sx as f64, sy as f64, bw as f64, bh as f64,
        sw as f64, sh as f64, ay0 as f64, ay1 as f64,
        ax0 as f64, ax1 as f64, gap as f64, &fx, &fy)
    if fx < 0.0 {
        fx = 0.0
    }
    if fy < 0.0 {
        fy = 0.0
    }
    *ox = fx as u64
    *oy = fy as u64
}

fn area(x: u64, y: u64, w: u64, h: u64, farbe: u64) -> bool {
    return tafel(x, y, w, h, 0, farbe, 0, 0)
}

// Nur der Rand -- der Fokusring.
fn ring(x: u64, y: u64, w: u64, h: u64, r: u64, breite: u64,
    farbe: u64) -> bool {
    if !ready() {
        s_n_no = s_n_no + 1
        s_no_bereit = s_no_bereit + 1
        wlibc.rring(x, y, w, h, r, breite, farbe)
        return true
    }
    if w == 0 || h == 0 || breite == 0 {
        s_n_no = s_n_no + 1
        s_no_leer = s_no_leer + 1
        return false
    }
    clip_sync()
    // Wie in `tafel`: oben aus dem Band herausragen ist kein Fehler.
    // Ein RING wird allerdings nicht beschnitten, sondern ganz
    // weggelassen, wenn seine Oberkante fehlt -- ein halber Ring ist
    // eine Linie, und die sieht aus wie ein Fehler. Der alte Weg
    // (`wlibc.rring`) wuerde hier denselben oberen Teil verlieren.
    let b: u64 = wlibc.band_y()
    if y < b {
        if b - y >= h {
            s_n_ok = s_n_ok + 1
            return true
        }
        s_n_no = s_n_no + 1
        s_no_band = s_no_band + 1
        return false
    }
    painter.round_ring(pz(), x as f64, (y - b) as f64, w as f64,
        h as f64, r as f64, breite as f64, swap_rb(farbe))
    s_n_ok = s_n_ok + 1
    return true
}

fn state_set(e: *mut widget.Widget, z: u64) {
    if z == Z_HOVER {
        widget.w_set_hover(e, true)
    } else if z == Z_PRESSED {
        widget.w_set_active(e, true)
    } else if z == Z_OFF {
        widget.w_set_disabled(e, true)
    } else if z == Z_FOCUS {
        widget.w_set_focus(e, true)
    }
}

fn art_von(sorte: u64) -> u32 {
    if sorte == S_BUTTON {
        return widget.KIND_BUTTON
    }
    if sorte == S_LABEL {
        return widget.KIND_LABEL
    }
    if sorte == S_CHECK {
        return widget.KIND_CHECKBOX
    }
    if sorte == S_ENTRY {
        return widget.KIND_TEXTBOX
    }
    if sorte == S_SLIDER {
        return widget.KIND_SLIDER
    }
    if sorte == S_TILE {
        return widget.KIND_TOGGLE
    }
    if sorte == S_CARD {
        return widget.KIND_CARD
    }
    if sorte == S_SEP {
        return widget.KIND_SEPARATOR
    }
    if sorte == S_TABS {
        return widget.KIND_TAB
    }
    if sorte == S_MENUBAR {
        return widget.KIND_MENU
    }
    if sorte == S_CHOICE {
        return widget.KIND_DROPDOWN
    }
    if sorte == S_SCROLL {
        return widget.KIND_SCROLLBAR
    }
    if sorte == S_PROGRESS {
        return widget.KIND_PROGRESS
    }
    return widget.KIND_NONE
}

// ------------------------------------------------------------------
// EIN ELEMENT MALEN. Das ist alles, was wlib von hier braucht.
//
// `wert` ist der Wert von Regler, Fortschritt und Umschalter; bei den
// uebrigen Sorten wird er nicht gelesen. Der TEXT wird hier NICHT
// gemalt: Osum setzt seinen Text selbst (Umlaute, Kuerzung, die
// Symbolschrift, `say_painted` fuer die Pruefstaende), und zwei
// Schriftsetzer auf einer Flaeche waeren zwei Ergebnisse.
// ------------------------------------------------------------------
fn draw(sorte: u64, x: u64, y: u64, w: u64, h: u64, z: u64,
    wert: u64) -> bool {
    if !ready() {
        s_n_no = s_n_no + 1
        s_no_bereit = s_no_bereit + 1
        return false
    }
    if w == 0 || h == 0 {
        s_n_no = s_n_no + 1
        s_no_leer = s_no_leer + 1
        return false
    }
    clip_sync()
    let art: u32 = art_von(sorte)
    if art == widget.KIND_NONE {
        s_n_no = s_n_no + 1
        s_no_art = s_no_art + 1
        return false
    }
    var e: widget.Widget = widget.widget_new(art)
    // Das Band: wlibc malt in Fensterkoordinaten, die Flaeche des
    // Servers beginnt bei `band_y`. Dieselbe Rechnung wie wlibc.px.
    let b: u64 = wlibc.band_y()
    if y < b {
        s_n_no = s_n_no + 1
        s_no_band = s_no_band + 1
        return false
    }
    widget.w_place(&e, x as f64, (y - b) as f64, w as f64, h as f64)
    state_set(&e, z)
    widget.w_set_value(&e, wert as i64)
    wave2.draw_any(ctx(), &e)
    s_n_ok = s_n_ok + 1
    return true
}

// ====================================================================
// ROUND FUI-ALL, STAGE 1: THE PAINT LAYER OF wlib, ALL OF IT IN fUi.
//
// Up to here wlib still painted part of its controls itself, through
// wlibc's pixel loop (`rect`, `frame`, `hline`, `rrect`, `rring`,
// `rframe`, `drop_shadow`, `px`: about ninety call sites, counted
// 30.09.2026). These are the same primitives, drawn by fUi's painter on
// the same surface, so that wlib has no painting code of its own left
// and a fix in fUi reaches every OrientOS program.
//
// Two things the older bridge calls (`tafel`, `ring`) did not do and
// these do:
//   * they honour wlibc's clip rectangle (`wlibc.clip_set`), which lists,
//     tables and the editor set around their scrolled content;
//   * they take the band offset as a float, so a shape that starts above
//     the band is clipped by the canvas instead of being dropped.
// When the bridge is not ready (no surface yet) each call falls back to
// the wlibc primitive of the same name, so nothing is ever left unpainted.
// ====================================================================

static mut s_n_prim: u64 = 0

// wlibc's RADIUS_MAX (not exported there); a change there has to be made here too.
const W_RADIUS_MAX: u64 = 24

// wlibc's clip, in canvas coordinates (canvas row 0 = band row 0).
fn clip_sync() {
    draw_area_on()
    let c: *mut canvas.Canvas = cv()
    let b: u64 = wlibc.band_y()
    let w: u64 = (*c).w as u64
    let h: u64 = (*c).h as u64
    var x0: u64 = wlibc.clip_x0()
    var x1: u64 = wlibc.clip_x1()
    if x1 > w {
        x1 = w
    }
    if x0 > x1 {
        x0 = x1
    }
    var y0: u64 = 0
    if wlibc.clip_y0() > b {
        y0 = wlibc.clip_y0() - b
    }
    var y1: u64 = 0
    if wlibc.clip_y1() > b {
        y1 = wlibc.clip_y1() - b
    }
    if y1 > h {
        y1 = h
    }
    if y0 > y1 {
        y0 = y1
    }
    (*c).depth = 0
    (*c).cx0[0] = x0 as f64
    (*c).cy0[0] = y0 as f64
    (*c).cx1[0] = x1 as f64
    (*c).cy1[0] = y1 as f64
}

fn fy(y: u64) -> f64 {
    return (y as f64) - (wlibc.band_y() as f64)
}

// A wlibc colour with an alpha of `a` (0..255) in fUi's channel order.
fn argb(c: u64, a: u64) -> u32 {
    return (((a & 255) << 24) as u32) | swap_rb(c)
}

fn rect(x: u64, y: u64, w: u64, h: u64, c: u64) {
    if w == 0 || h == 0 {
        return
    }
    if !ready() {
        wlibc.rect(x, y, w, h, c)
        return
    }
    clip_sync()
    painter.surface(pz(), x as f64, fy(y), w as f64, h as f64, swap_rb(c))
    s_n_prim = s_n_prim + 1
}

fn hline(x: u64, y: u64, w: u64, c: u64) {
    rect(x, y, w, 1, c)
}

fn vline(x: u64, y: u64, h: u64, c: u64) {
    rect(x, y, 1, h, c)
}

fn dot(x: u64, y: u64, c: u64) {
    rect(x, y, 1, 1, c)
}

fn frame(x: u64, y: u64, w: u64, h: u64, c: u64) {
    if w < 2 || h < 2 {
        return
    }
    rect(x, y, w, 1, c)
    rect(x, y + h - 1, w, 1, c)
    rect(x, y, 1, h, c)
    rect(x + w - 1, y, 1, h, c)
}

// The 3D edge of the classic look: light top/left, dark bottom/right,
// swapped when pressed -- the same order of strokes as wlibc.frame3.
fn frame3(x: u64, y: u64, w: u64, h: u64, light: u64, dark: u64,
    pressed: bool) {
    if w < 2 || h < 2 {
        return
    }
    var o: u64 = light
    var u: u64 = dark
    if pressed {
        o = dark
        u = light
    }
    rect(x, y, w, 1, o)
    rect(x, y, 1, h, o)
    rect(x, y + h - 1, w, 1, u)
    rect(x + w - 1, y, 1, h, u)
}

// Radius as wlibc caps it: RADIUS_MAX, then half the shorter side.
fn cap_r(r0: u64, w: u64, h: u64) -> u64 {
    var r: u64 = r0
    if r > W_RADIUS_MAX {
        r = W_RADIUS_MAX
    }
    if r * 2 > w {
        r = w / 2
    }
    if r * 2 > h {
        r = h / 2
    }
    return r
}

fn rrect(x: u64, y: u64, w: u64, h: u64, r: u64, c: u64) {
    if w == 0 || h == 0 {
        return
    }
    if !ready() {
        wlibc.rrect(x, y, w, h, r, c)
        return
    }
    clip_sync()
    let rr: u64 = cap_r(r, w, h)
    if rr == 0 {
        painter.surface(pz(), x as f64, fy(y), w as f64, h as f64, swap_rb(c))
    } else {
        painter.round_rect(pz(), x as f64, fy(y), w as f64, h as f64,
            rr as f64, swap_rb(c))
    }
    s_n_prim = s_n_prim + 1
}

fn rring(x: u64, y: u64, w: u64, h: u64, r: u64, bw: u64, c: u64) {
    if w < 2 || h < 2 || bw == 0 {
        return
    }
    if !ready() {
        wlibc.rring(x, y, w, h, r, bw, c)
        return
    }
    let rr: u64 = cap_r(r, w, h)
    if rr == 0 {
        var k: u64 = 0
        while k < bw && 2 * k + 2 <= w && 2 * k + 2 <= h {
            frame(x + k, y + k, w - 2 * k, h - 2 * k, c)
            k = k + 1
        }
        return
    }
    clip_sync()
    painter.round_ring(pz(), x as f64, fy(y), w as f64, h as f64,
        rr as f64, bw as f64, swap_rb(c))
    s_n_prim = s_n_prim + 1
}

// Border `c` of width `bw` around an inner fill -- two filled shapes, as
// wlibc.rframe paints it (the inner radius shrinks by the border).
fn rframe(x: u64, y: u64, w: u64, h: u64, r: u64, bw: u64, c: u64,
    inner: u64) {
    if w < 2 || h < 2 || bw == 0 {
        return
    }
    if r == 0 && bw == 1 {
        rect(x + 1, y + 1, w - 2, h - 2, inner)
        frame(x, y, w, h, c)
        return
    }
    var b: u64 = bw
    if b * 2 >= w || b * 2 >= h {
        b = 1
    }
    rrect(x, y, w, h, r, c)
    var ri: u64 = 0
    if r > b {
        ri = r - b
    }
    rrect(x + b, y + b, w - 2 * b, h - 2 * b, ri, inner)
}

// A shadow below a rounded box: `reach` one-pixel rings, the outermost
// the weakest, shifted down by one -- wlibc.drop_shadow's shape, painted
// as translucent rings by fUi instead of a get/blend/put per pixel.
fn shadow(x: u64, y: u64, w: u64, h: u64, r: u64, strength: u64,
    reach: u64, c: u64) {
    if strength == 0 || reach == 0 || w == 0 || h == 0 {
        return
    }
    if !ready() {
        wlibc.drop_shadow(x, y, w, h, r, strength, reach, c)
        return
    }
    clip_sync()
    var i: u64 = reach
    while i > 0 {
        let a: u64 = strength * 255 / 100 * (reach + 1 - i) / (reach + 1)
        if a != 0 {
            let fx: f64 = (x as f64) - (i as f64)
            let fyy: f64 = fy(y + 1) - (i as f64)
            let ww: u64 = w + 2 * i
            let hh: u64 = h + 2 * i
            painter.round_ring(pz(), fx, fyy, ww as f64, hh as f64,
                cap_r(r + i, ww, hh) as f64, 1.0, argb(c, a))
        }
        i = i - 1
    }
    s_n_prim = s_n_prim + 1
}

// How many primitives fUi painted for wlib (the counter of stage 1).
fn fui_prims() -> u64 {
    return s_n_prim
}

// ====================================================================
// ROUND FUI-ALL, STAGE 1b: PICTURES, DRAWN BY fUi.
//
// The last two places where wlib still set pixels itself were the icon
// cell of a list row and the image widget (viewer: zoom, pan, quarter
// turns). Both hold pixels as 0xAARRGGBB words -- read by fUi's Image
// with R and B swapped, which is exactly the channel order the bridge
// hands the painter everywhere else (`swap_rb`), so no copy is made.
//
//   * `icon`: 1:1, no scaling -- the sampler lands on pixel centres and
//     reproduces the source exactly; alpha 0 leaves the row colour.
//   * `picture`: unturned it is `uiimage.image_draw_rect` (box filter
//     when shrinking, bilinear when growing -- no stairs); a quarter turn
//     goes through `transform.tf_draw_image` with the turn as a matrix.
// Both honour wlibc's clip; without a surface they return false and the
// caller keeps its old loop.
// ====================================================================

fn icon(px: u64, w: u64, h: u64, stride: u64, x: u64, y: u64) -> bool {
    if px == 0 || w == 0 || h == 0 || !ready() {
        return false
    }
    clip_sync()
    var im: uiimage.Image = uiimage.image_wrap(px, w as usize, h as usize,
        stride as usize)
    uiimage.image_draw_rect(pz(), &im, x as f64, fy(y), w as f64,
        h as f64, 0 as u32)
    s_n_prim = s_n_prim + 1
    return true
}

// `iw` x `ih` pixels at `px`, turned by `turn` quarters clockwise, into
// the box (`ox`, `oy`) of `zw` x `zh` (the turned size, zoomed). `ox`/`oy`
// may lie left of or above the widget (panned): they are signed.
fn picture(px: u64, iw: u64, ih: u64, turn: u64, ox: i64, oy: i64,
    zw: u64, zh: u64) -> bool {
    if px == 0 || iw == 0 || ih == 0 || zw == 0 || zh == 0 || !ready() {
        return false
    }
    clip_sync()
    var im: uiimage.Image = uiimage.image_wrap(px, iw as usize,
        ih as usize, 0)
    let fx: f64 = ox as f64
    let fyy: f64 = (oy as f64) - (wlibc.band_y() as f64)
    let q: u64 = turn & 3
    if q == 0 {
        uiimage.image_draw_rect(pz(), &im, fx, fyy, zw as f64, zh as f64,
            0 as u32)
    } else {
        // turned size before zoom: quarter 1/3 swap the sides
        var bw: f64 = iw as f64
        var bh: f64 = ih as f64
        if q == 1 || q == 3 {
            bw = ih as f64
            bh = iw as f64
        }
        var xf: transform.Xform = transform.xf_new()
        transform.xf_translate(&xf, fx, fyy)
        transform.xf_scale(&xf, (zw as f64) / bw, (zh as f64) / bh, 0.0, 0.0)
        if q == 1 {
            transform.xf_translate(&xf, ih as f64, 0.0)
        } else if q == 2 {
            transform.xf_translate(&xf, iw as f64, ih as f64)
        } else {
            transform.xf_translate(&xf, 0.0, iw as f64)
        }
        transform.xf_rotate(&xf, (q * 90) as f64)
        transform.tf_draw_image(pz(), &xf, &im, 0.0, 0.0, iw as f64,
            ih as f64, 1.0)
    }
    s_n_prim = s_n_prim + 1
    return true
}

// FUI-ALL stage 3: the dots of a password field are fUi's mask -- one
// U+2022 per CHARACTER (lead octets only), exactly what fUi's own secret
// field shows. Returns the octets written to `out` (at most `cap`).
fn secret_mask(p: u64, n: u64, out: u64, cap: u64) -> u64 {
    return render.secret_mask(p, n as usize, out, cap as usize) as u64
}

// ====================================================================
// FUI-ALL STAGE 2: A PROGRAM THAT PAINTS WITH fUi ITSELF.
//
// Up to here fUi only painted what wlib asked for, primitive by primitive
// on wlib's band. A program on fUi DIRECTLY owns its pixels: one wlib
// canvas widget (`wlib.canvas`, the same widget Certus paints its page
// into) whose buffer the program hands to fUi. This is the second canvas
// of the bridge -- same theme (the system scheme, R and B swapped, so the
// octets land in the framebuffer's order), same fonts, its own painter
// and render context, bound to the program's buffer instead of wlib's
// surface. `kernel/user/fuiapp.fi` wraps window, buffer and events.
// ====================================================================
static mut s_app_ok: u64 = 0
static mut s_acvm: [u64; 128] = [0; 128]
static mut s_apzm: [u64; 256] = [0; 256]
static mut s_actxm: [u64; 8] = [0; 8]

fn app_canvas() -> *mut canvas.Canvas {
    return ((&s_acvm[0 as usize]) as u64) as *mut canvas.Canvas
}

fn app_pz() -> *mut painter.Painter {
    return ((&s_apzm[0 as usize]) as u64) as *mut painter.Painter
}

fn app_ctx() -> *mut render.Ctx {
    return ((&s_actxm[0 as usize]) as u64) as *mut render.Ctx
}

fn app_theme() -> *mut theme.Theme {
    return th()
}

// Bind fUi to `px` (w*h words, B,G,R,0 like the surface). The theme and
// fonts come from `ready()`, so the window must have been painted once.
// A new buffer (resize) rebinds the canvas; the painter keeps its raster
// store as long as the height does not grow.
fn app_bind(px: u64, w: u64, h: u64) -> bool {
    if px == 0 || w == 0 || h == 0 || !ready() {
        return false
    }
    canvas_on_surface(app_canvas(), px, w as usize, h as usize)
    if s_app_ok == 0 || s_app_ok < h {
        if !painter.painter_init(app_pz(), app_canvas(), w as usize,
            (h + 3) as usize) {
            return false
        }
        painter.painter_set_font(app_pz(), fuiglyph.fontset(fuiglyph.ROLE_UI))
        *app_ctx() = render.ctx_new(th(), app_pz())
        s_app_ok = h
    }
    return true
}
