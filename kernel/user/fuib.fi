// ====================================================== WARUM SIE EXISTIERT
// ================================================== DAS FARBSCHEMA GEWINNT
profile app

import fuiapp.hosthead
import uikit.uidraw
import uikit.uiscale
import uitheme.thquery
import ulib
import lineout
import uitheme
import paint.canvas
import font.metrics
import fuiglyph
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.textcurve
import fui.render
import fui.wave2
import fui.uiimage
import fui.transform

export {
    ready, draw, draw_area_on, theme_new, theme_sync, main,
    // FUI-ALL stage 3: fUi's password mask.
    secret_mask,
    fui_painted, fui_rejected, fui_reasons,
    board, area, ring, tip_place,
    radius_image,
    Z_NORMAL, Z_HOVER, Z_PRESSED, Z_OFF, Z_FOCUS,
    S_BUTTON, S_LABEL, S_CHECK, S_ENTRY, S_SLIDER, S_TILE,
    S_CARD, S_SEP, S_TABS, S_MENUBAR, S_CHOICE, S_SCROLL,
    S_PROGRESS,
    // ROUND FUI-ALL stage 1: wlib's paint primitives, drawn by fUi.
    rect, hline, vline, dot, frame, frame3, rrect, rring, rframe, shadow,
    fui_prims, icon, picture,
    // FUI-ALL stage 2: a program's own fUi canvas (see fuiapp.fi).
    app_bind, app_ctx, app_canvas, app_theme,
}

const Z_NORMAL: u64 = 0
const Z_HOVER: u64 = 1
const Z_PRESSED: u64 = 2
const Z_OFF: u64 = 3
const Z_FOCUS: u64 = 4

const S_BUTTON: u64 = 0
const S_LABEL: u64 = 1
const S_CHECK: u64 = 2
const S_ENTRY: u64 = 3
const S_SLIDER: u64 = 4
const S_TILE: u64 = 5
const S_CARD: u64 = 6
const S_SEP: u64 = 7
const S_TABS: u64 = 8
const S_MENUBAR: u64 = 9
const S_CHOICE: u64 = 10
const S_SCROLL: u64 = 11
const S_PROGRESS: u64 = 12

const CV_BYTES: usize = 1024
const PZ_BYTES: usize = 4096
const TH_BYTES: usize = 1024

static mut s_auf: u64 = 0
static mut s_theme_gen: u64 = 0
static mut s_said_big: u64 = 0
static mut m_big: [u8; 46] = "fuib: wlibc fallback, fUi struct grew: cv/pz=\0"
static mut m_sp: [u8; 2] = " \0"
static mut s_cvm: [u64; 128] = [0; 128]
static mut s_pzm: [u64; 512] = [0; 512]
static mut s_thm: [u64; 128] = [0; 128]
// render.Ctx carries a function pointer (the animation hook) since the
// Firn pin of round FUI-ALL, and a static cannot be initialised with one.
// So it lives in raw words, filled by render.ctx_new in `bereit()`.
static mut s_ctxm: [u64; 8] = [0; 8]
fn ctx() -> *mut render.Ctx { return (&s_ctxm[0 as usize]) as u64 as *mut render.Ctx }
static mut s_fm: u64 = 0
static mut s_n_ok: u64 = 0
static mut s_n_no: u64 = 0
static mut s_no_ready: u64 = 0
static mut s_no_empty: u64 = 0
static mut s_no_band: u64 = 0
static mut s_no_art: u64 = 0
static mut s_rreden: u64 = 0
static mut s_rvek: [u64; 8] = [0; 8]
static mut s_rrct: [u64; 8] = [0; 8]
static mut s_nvek: u64 = 0
static mut s_nrct: u64 = 0
static mut fr_a: [u8; 15] = "fuib: table r=\0"
static mut fr_v: [u8; 13] = " path=vector\0"
static mut fr_r: [u8; 12] = " path=rrect\0"

fn radius_image(reden: bool) {
    if reden {
        s_rreden = 1
    } else {
        s_rreden = 0
    }
    s_nvek = 0
    s_nrct = 0
}

fn radius_eff(r: u64, w: u64, h: u64) -> u64 {
    var short_2: u64 = w
    if h < short_2 {
        short_2 = h
    }
    if r > short_2 / 2 {
        return short_2 / 2
    }
    return r
}

fn say_board(r: u64, vektor: bool) {
    if s_rreden == 0 {
        return
    }
    var n: u64 = s_nrct
    if vektor {
        n = s_nvek
    }
    var k: u64 = 0
    while k < n {
        var alt: u64 = s_rrct[k as usize]
        if vektor {
            alt = s_rvek[k as usize]
        }
        if alt == r {
            return
        }
        k = k + 1
    }
    if n >= 8 {
        return
    }
    if vektor {
        s_rvek[n as usize] = r
        s_nvek = n + 1
    } else {
        s_rrct[n as usize] = r
        s_nrct = n + 1
    }
    lineout.add_text((&fr_a[0 as usize]) as u64)
    lineout.add_num(r)
    if vektor {
        lineout.add_text((&fr_v[0 as usize]) as u64)
    } else {
        lineout.add_text((&fr_r[0 as usize]) as u64)
    }
    lineout.end_line()
}

fn fui_painted() -> u64 {
    return s_n_ok
}

fn fui_rejected() -> u64 {
    return s_n_no
}

fn fui_reasons() -> u64 {
    return s_no_ready * 1000000 + s_no_empty * 10000
        + s_no_band * 100 + s_no_art
}

fn cv() -> *mut canvas.Canvas {
    return ((&s_cvm[0 as usize]) as u64) as *mut canvas.Canvas
}

fn pz() -> *mut painter.Painter {
    return ((&s_pzm[0 as usize]) as u64) as *mut painter.Painter
}

fn th() -> *mut theme.Theme {
    return ((&s_thm[0 as usize]) as u64) as *mut theme.Theme
}

//   dunkel-05-kontrollzentrum.png
//     Panel und Taskleiste   RGB( 59, 41, 30)   braun
//     dieselbe Farbe woanders RGB( 30, 41, 59)  neutral-dunkelblau
fn swap_rb(c: u64) -> u32 {
    // Swap R and B, leave G and A alone. That makes canvas.fi lay the
    // octets down in the order the framebuffer expects.
    let r: u64 = (c >> 16) & 255
    let g: u64 = (c >> 8) & 255
    let b: u64 = c & 255
    return ((b << 16) | (g << 8) | r) as u32
}

fn canvas_on_surface(c: *mut canvas.Canvas, px: u64, w: usize, h: usize) {
    (*c).px = px as *mut u8
    (*c).w = w
    (*c).h = h
    (*c).cap = w * h * 4
    (*c).depth = 0
    (*c).mode = canvas.BLEND_NORMAL
    (*c).cx0[0] = 0.0
    (*c).cy0[0] = 0.0
    (*c).cx1[0] = w as f64
    (*c).cy1[0] = h as f64
    (*c).cmask[0] = 0
    (*c).ok = 1
}

fn theme_sync() -> bool {
    if s_auf == 0 || thquery.theme_gen() == s_theme_gen {
        return false
    }
    theme_new()
    return true
}

fn theme_new() {
    s_theme_gen = thquery.theme_gen()
    let dunkel: bool = thquery.theme_dark()
    theme.theme_set_dark(th(), dunkel)
    let f: *mut theme.Colors = theme.theme_colors(th())
    (*f).base = swap_rb(uitheme.theme(uitheme.T_BG))
    (*f).surface = swap_rb(uitheme.theme(uitheme.T_PANEL))
    (*f).surface_raised = swap_rb(uitheme.theme(uitheme.T_MENU))
    (*f).button = swap_rb(uitheme.theme(uitheme.T_BTN))
    (*f).button_hover = swap_rb(uitheme.theme(uitheme.T_BTNHI))
    (*f).button_active = swap_rb(uitheme.theme(uitheme.T_BTNDN))
    (*f).field = swap_rb(uitheme.theme(uitheme.T_ENTRY))
    (*f).field_focus = swap_rb(uitheme.theme(uitheme.T_ENTRY))
    (*f).border_col = swap_rb(uitheme.theme(uitheme.T_LINE))
    (*f).separator = swap_rb(uitheme.theme(uitheme.T_LINE))
    (*f).text = swap_rb(uitheme.theme(uitheme.T_FG))
    (*f).text_muted = swap_rb(uitheme.theme(uitheme.T_DIM))
    (*f).text_disabled = swap_rb(uitheme.theme(uitheme.T_DIM))
    (*f).accent = swap_rb(uitheme.theme(uitheme.T_ACCENT))
    (*f).selection = swap_rb(uitheme.theme(uitheme.T_SEL))
    (*f).selection_text = swap_rb(uitheme.theme(uitheme.T_SELFG))
    // r399: the text ON THE ACCENT is the on-accent role, no longer the selection text (a
    // selection is a tint now and keeps the normal text colour)
    (*f).text_on_accent = swap_rb(uitheme.theme(uitheme.C_TITLEBAR_TEXT))
    (*f).dark = dunkel
    let fo: *mut theme.Shape = theme.theme_shape(th())
    (*fo).r_button = uitheme.metric(uitheme.M_RADIUS_BUTTON) as usize
    (*fo).r_panel = uitheme.metric(uitheme.M_RADIUS_PANEL) as usize
    (*fo).r_window = uitheme.metric(uitheme.M_RADIUS_WINDOW) as usize
    (*fo).r_field = uitheme.metric(uitheme.M_RADIUS_INPUT) as usize
    (*fo).border_w = uitheme.metric(uitheme.M_BORDER) as usize
    // r399 (design audit): THE SPACING TOKENS COME FROM THE SAME FILE AS THE RADII.
    // The shape file (osum.shape / classic.shape / modern.shape) has always carried
    // pad_x, pad_y, gap, the four-point spacing, ctrl_h and row, but fUi's theme
    // kept its own copy (the same numbers by chance: 16/8/12, 32, 28) -- so a
    // change in the shape file moved the wlib widgets and not the scene programs.
    // wlibc's metrics are already multiplied by the interface scale; fUi's theme
    // holds unscaled points (it scales itself, `theme_set_scale`).
    var us: u64 = uiscale.ui_scale()
    if us == 0 {
        us = 1
    }
    let px: u64 = uitheme.metric(uitheme.M_PAD_X) / us
    if px != 0 {
        (*fo).pad_x = px as usize
    }
    let py: u64 = uitheme.metric(uitheme.M_PAD_Y) / us
    if py != 0 {
        (*fo).pad_y = py as usize
    }
    let gp: u64 = uitheme.metric(uitheme.M_GAP) / us
    if gp != 0 {
        (*fo).gap = gp as usize
    }
}

fn ready() -> bool {
    if s_auf != 0 {
        return true
    }
    let sp: u64 = hosthead.surface()
    if sp == 0 {
        return false
    }
    let w: usize = hosthead.surf_w() as usize
    let h: usize = hosthead.surf_rows() as usize
    if w == 0 || h == 0 {
        return false
    }
    var mcv: [canvas.Canvas; 2] = [canvas.canvas_new(); 2]
    let ncv: usize = ((&mcv[1]) as u64 - (&mcv[0]) as u64) as usize
    var mpz: [painter.Painter; 2] = [painter.painter_new(); 2]
    let npz: usize = ((&mpz[1]) as u64 - (&mpz[0]) as u64) as usize
    var mth: [theme.Theme; 2] = [theme.theme_new(false); 2]
    let nth: usize = ((&mth[1]) as u64 - (&mth[0]) as u64) as usize
    var mcx: [render.Ctx; 2] = [render.ctx_new(&mth[0], &mpz[0]); 2]
    let ncx: usize = ((&mcx[1]) as u64 - (&mcx[0]) as u64) as usize
    if ncv > CV_BYTES || npz > PZ_BYTES || nth > TH_BYTES || ncx > 64 {
        // Say it, once: a silent refusal here made every program paint
        // with wlibc again for a whole stage without anybody seeing it.
        if s_said_big == 0 {
            s_said_big = 1
            lineout.add_text((&m_big[0 as usize]) as u64)
            lineout.add_num(ncv as u64)
            lineout.add_text((&m_sp[0 as usize]) as u64)
            lineout.add_num(npz as u64)
            lineout.add_text((&m_sp[0 as usize]) as u64)
            lineout.add_num(nth as u64)
            lineout.add_text((&m_sp[0 as usize]) as u64)
            lineout.add_num(ncx as u64)
            lineout.end_line()
        }
        return false
    }
    canvas_on_surface(cv(), sp, w, h)
    let vorrat: usize = h + 3
    if !painter.painter_init(pz(), cv(), w, vorrat) {
        return false
    }
    // Text coverage stays LINEAR, like every other Osum text (fuiglyph,
    // the window server, tools/ttf/fuiraster.py, the k15 reference).
    // Since the pin 031ec5a4d fUi bends the coverage by default (Skia
    // preblend, gamma 1.8, contrast 0.5; lib/fui/textcurve.fi): light text
    // on a dark row came out ~15 levels brighter at the edges and 23 k15
    // explorer text checks went red. (0, 0) switches the curve off.
    textcurve.tc_set(0.0, 0.0)
    painter.painter_set_font(pz(), s_fm)
    *th() = theme.theme_new(thquery.theme_dark())
    theme_new()
    *ctx() = render.ctx_new(th(), pz())
    s_auf = 1
    return true
}

fn draw_area_on() {
    let sp: u64 = hosthead.surface()
    if sp == 0 {
        return
    }
    let w: usize = hosthead.surf_w() as usize
    let h: usize = hosthead.surf_rows() as usize
    if ((*cv()).px as u64) != sp || (*cv()).w != w || (*cv()).h != h {
        canvas_on_surface(cv(), sp, w, h)
    }
}

fn board(x: u64, y: u64, w: u64, h: u64, r: u64, fuellung: u64,
    margin: u64, randbreite: u64) -> bool {
    if !ready() {
        s_n_no = s_n_no + 1
        s_no_ready = s_no_ready + 1
        say_board(radius_eff(r, w, h), false)
        if margin == 0 || randbreite == 0 {
            uidraw.rrect(x, y, w, h, r, fuellung)
        } else {
            uidraw.rframe(x, y, w, h, r, randbreite, margin, fuellung)
        }
        return true
    }
    if w == 0 || h == 0 {
        s_n_no = s_n_no + 1
        s_no_empty = s_no_empty + 1
        return false
    }
    clip_sync()
    let b: u64 = hosthead.band_y()
    var yy: u64 = y
    var hh: u64 = h
    if yy < b {
        let gone: u64 = b - yy
        if gone >= hh {
            s_n_ok = s_n_ok + 1
            return true
        }
        hh = hh - gone
        yy = b
    }
    let fy: f64 = (yy - b) as f64
    var rr: u64 = r
    var short: u64 = w
    if h < short {
        short = h
    }
    if rr > short / 2 {
        rr = short / 2
    }
    say_board(rr, true)
    painter.round_rect(pz(), x as f64, fy, w as f64, hh as f64,
        rr as f64, swap_rb(fuellung))
    if margin != 0 && randbreite != 0 {
        painter.round_ring(pz(), x as f64, fy, w as f64, hh as f64,
            rr as f64, randbreite as f64, swap_rb(margin))
    }
    s_n_ok = s_n_ok + 1
    return true
}

fn tip_place(sx: u64, sy: u64, bw: u64, bh: u64,
    sw: u64, sh: u64, ay0: u64, ay1: u64, ax0: u64, ax1: u64,
    gap: u64, ox: *mut u64, oy: *mut u64) {
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    wave2.tooltip_place(sx as f64, sy as f64, bw as f64, bh as f64,
        sw as f64, sh as f64, ay0 as f64, ay1 as f64,
        ax0 as f64, ax1 as f64, gap as f64, &fx, &fy)
    if fx < 0.0 {
        fx = 0.0
    }
    if fy < 0.0 {
        fy = 0.0
    }
    *ox = fx as u64
    *oy = fy as u64
}

fn area(x: u64, y: u64, w: u64, h: u64, color: u64) -> bool {
    return board(x, y, w, h, 0, color, 0, 0)
}

fn ring(x: u64, y: u64, w: u64, h: u64, r: u64, width: u64,
    color: u64) -> bool {
    if !ready() {
        s_n_no = s_n_no + 1
        s_no_ready = s_no_ready + 1
        uidraw.rring(x, y, w, h, r, width, color)
        return true
    }
    if w == 0 || h == 0 || width == 0 {
        s_n_no = s_n_no + 1
        s_no_empty = s_no_empty + 1
        return false
    }
    clip_sync()
    let b: u64 = hosthead.band_y()
    if y < b {
        if b - y >= h {
            s_n_ok = s_n_ok + 1
            return true
        }
        s_n_no = s_n_no + 1
        s_no_band = s_no_band + 1
        return false
    }
    painter.round_ring(pz(), x as f64, (y - b) as f64, w as f64,
        h as f64, r as f64, width as f64, swap_rb(color))
    s_n_ok = s_n_ok + 1
    return true
}

fn state_set(e: *mut widget.Widget, z: u64) {
    if z == Z_HOVER {
        widget.w_set_hover(e, true)
    } else if z == Z_PRESSED {
        widget.w_set_active(e, true)
    } else if z == Z_OFF {
        widget.w_set_disabled(e, true)
    } else if z == Z_FOCUS {
        widget.w_set_focus(e, true)
    }
}

fn art_von(sorte: u64) -> u32 {
    if sorte == S_BUTTON {
        return widget.KIND_BUTTON
    }
    if sorte == S_LABEL {
        return widget.KIND_LABEL
    }
    if sorte == S_CHECK {
        return widget.KIND_CHECKBOX
    }
    if sorte == S_ENTRY {
        return widget.KIND_TEXTBOX
    }
    if sorte == S_SLIDER {
        return widget.KIND_SLIDER
    }
    if sorte == S_TILE {
        return widget.KIND_TOGGLE
    }
    if sorte == S_CARD {
        return widget.KIND_CARD
    }
    if sorte == S_SEP {
        return widget.KIND_SEPARATOR
    }
    if sorte == S_TABS {
        return widget.KIND_TAB
    }
    if sorte == S_MENUBAR {
        return widget.KIND_MENU
    }
    if sorte == S_CHOICE {
        return widget.KIND_DROPDOWN
    }
    if sorte == S_SCROLL {
        return widget.KIND_SCROLLBAR
    }
    if sorte == S_PROGRESS {
        return widget.KIND_PROGRESS
    }
    return widget.KIND_NONE
}

static mut s_main: u64 = 0

fn main(on: bool) {
    s_main = 0
    if on {
        s_main = 1
    }
}

fn draw(sorte: u64, x: u64, y: u64, w: u64, h: u64, z: u64,
    value: u64) -> bool {
    if !ready() {
        s_n_no = s_n_no + 1
        s_no_ready = s_no_ready + 1
        return false
    }
    if w == 0 || h == 0 {
        s_n_no = s_n_no + 1
        s_no_empty = s_no_empty + 1
        return false
    }
    clip_sync()
    let art: u32 = art_von(sorte)
    if art == widget.KIND_NONE {
        s_n_no = s_n_no + 1
        s_no_art = s_no_art + 1
        return false
    }
    var e: widget.Widget = widget.widget_new(art)
    let b: u64 = hosthead.band_y()
    if y < b {
        s_n_no = s_n_no + 1
        s_no_band = s_no_band + 1
        return false
    }
    widget.w_place(&e, x as f64, (y - b) as f64, w as f64, h as f64)
    state_set(&e, z)
    widget.w_set_value(&e, value as i64)
    if s_main != 0 && sorte == S_BUTTON {
        // The main button: STATE_SELECTED is the accent fill in fUi's own
        // rules. Pressed gets the accent's pressed step.
        let f: *mut theme.Colors = theme.theme_colors(th())
        let b2: u32 = (*f).button_active
        widget.w_set_selected(&e, true)
        (*f).button_active = swap_rb(uitheme.theme(uitheme.C_ACCENT_PRESSED))
        wave2.draw_any(ctx(), &e)
        (*f).button_active = b2
    } else {
        wave2.draw_any(ctx(), &e)
    }
    s_n_ok = s_n_ok + 1
    return true
}

// ====================================================================
// ROUND FUI-ALL, STAGE 1: THE PAINT LAYER OF wlib, ALL OF IT IN fUi.
//
// Up to here wlib still painted part of its controls itself, through
// wlibc's pixel loop (`rect`, `frame`, `hline`, `rrect`, `rring`,
// `rframe`, `drop_shadow`, `px`: about ninety call sites, counted
// 30.09.2026). These are the same primitives, drawn by fUi's painter on
// the same surface, so that wlib has no painting code of its own left
// and a fix in fUi reaches every OrientOS program.
//
// Two things the older bridge calls (`tafel`, `ring`) did not do and
// these do:
//   * they honour wlibc's clip rectangle (`uidraw.clip_set`), which lists,
//     tables and the editor set around their scrolled content;
//   * they take the band offset as a float, so a shape that starts above
//     the band is clipped by the canvas instead of being dropped.
// When the bridge is not ready (no surface yet) each call falls back to
// the wlibc primitive of the same name, so nothing is ever left unpainted.
// ====================================================================

static mut s_n_prim: u64 = 0

// wlibc's RADIUS_MAX (not exported there); a change there has to be made here too.
const W_RADIUS_MAX: u64 = 24

// wlibc's clip, in canvas coordinates (canvas row 0 = band row 0).
fn clip_sync() {
    draw_area_on()
    let c: *mut canvas.Canvas = cv()
    let b: u64 = hosthead.band_y()
    let w: u64 = (*c).w as u64
    let h: u64 = (*c).h as u64
    var x0: u64 = uidraw.clip_x0()
    var x1: u64 = uidraw.clip_x1()
    if x1 > w {
        x1 = w
    }
    if x0 > x1 {
        x0 = x1
    }
    var y0: u64 = 0
    if uidraw.clip_y0() > b {
        y0 = uidraw.clip_y0() - b
    }
    var y1: u64 = 0
    if uidraw.clip_y1() > b {
        y1 = uidraw.clip_y1() - b
    }
    if y1 > h {
        y1 = h
    }
    if y0 > y1 {
        y0 = y1
    }
    (*c).depth = 0
    (*c).cx0[0] = x0 as f64
    (*c).cy0[0] = y0 as f64
    (*c).cx1[0] = x1 as f64
    (*c).cy1[0] = y1 as f64
}

fn fy(y: u64) -> f64 {
    return (y as f64) - (hosthead.band_y() as f64)
}

// A wlibc colour with an alpha of `a` (0..255) in fUi's channel order.
fn argb(c: u64, a: u64) -> u32 {
    return (((a & 255) << 24) as u32) | swap_rb(c)
}

fn rect(x: u64, y: u64, w: u64, h: u64, c: u64) {
    if w == 0 || h == 0 {
        return
    }
    if !ready() {
        uidraw.rect(x, y, w, h, c)
        return
    }
    clip_sync()
    painter.surface(pz(), x as f64, fy(y), w as f64, h as f64, swap_rb(c))
    s_n_prim = s_n_prim + 1
}

fn hline(x: u64, y: u64, w: u64, c: u64) {
    rect(x, y, w, 1, c)
}

fn vline(x: u64, y: u64, h: u64, c: u64) {
    rect(x, y, 1, h, c)
}

fn dot(x: u64, y: u64, c: u64) {
    rect(x, y, 1, 1, c)
}

fn frame(x: u64, y: u64, w: u64, h: u64, c: u64) {
    if w < 2 || h < 2 {
        return
    }
    rect(x, y, w, 1, c)
    rect(x, y + h - 1, w, 1, c)
    rect(x, y, 1, h, c)
    rect(x + w - 1, y, 1, h, c)
}

// The 3D edge of the classic look: light top/left, dark bottom/right,
// swapped when pressed -- the same order of strokes as uidraw.frame3.
fn frame3(x: u64, y: u64, w: u64, h: u64, light: u64, dark: u64,
    pressed: bool) {
    if w < 2 || h < 2 {
        return
    }
    var o: u64 = light
    var u: u64 = dark
    if pressed {
        o = dark
        u = light
    }
    rect(x, y, w, 1, o)
    rect(x, y, 1, h, o)
    rect(x, y + h - 1, w, 1, u)
    rect(x + w - 1, y, 1, h, u)
}

// Radius as wlibc caps it: RADIUS_MAX, then half the shorter side.
fn cap_r(r0: u64, w: u64, h: u64) -> u64 {
    var r: u64 = r0
    if r > W_RADIUS_MAX {
        r = W_RADIUS_MAX
    }
    if r * 2 > w {
        r = w / 2
    }
    if r * 2 > h {
        r = h / 2
    }
    return r
}

fn rrect(x: u64, y: u64, w: u64, h: u64, r: u64, c: u64) {
    if w == 0 || h == 0 {
        return
    }
    if !ready() {
        uidraw.rrect(x, y, w, h, r, c)
        return
    }
    clip_sync()
    let rr: u64 = cap_r(r, w, h)
    if rr == 0 {
        painter.surface(pz(), x as f64, fy(y), w as f64, h as f64, swap_rb(c))
    } else {
        painter.round_rect(pz(), x as f64, fy(y), w as f64, h as f64,
            rr as f64, swap_rb(c))
    }
    s_n_prim = s_n_prim + 1
}

fn rring(x: u64, y: u64, w: u64, h: u64, r: u64, bw: u64, c: u64) {
    if w < 2 || h < 2 || bw == 0 {
        return
    }
    if !ready() {
        uidraw.rring(x, y, w, h, r, bw, c)
        return
    }
    let rr: u64 = cap_r(r, w, h)
    if rr == 0 {
        var k: u64 = 0
        while k < bw && 2 * k + 2 <= w && 2 * k + 2 <= h {
            frame(x + k, y + k, w - 2 * k, h - 2 * k, c)
            k = k + 1
        }
        return
    }
    clip_sync()
    painter.round_ring(pz(), x as f64, fy(y), w as f64, h as f64,
        rr as f64, bw as f64, swap_rb(c))
    s_n_prim = s_n_prim + 1
}

// Border `c` of width `bw` around an inner fill -- two filled shapes, as
// uidraw.rframe paints it (the inner radius shrinks by the border).
fn rframe(x: u64, y: u64, w: u64, h: u64, r: u64, bw: u64, c: u64,
    inner: u64) {
    if w < 2 || h < 2 || bw == 0 {
        return
    }
    if r == 0 && bw == 1 {
        rect(x + 1, y + 1, w - 2, h - 2, inner)
        frame(x, y, w, h, c)
        return
    }
    var b: u64 = bw
    if b * 2 >= w || b * 2 >= h {
        b = 1
    }
    rrect(x, y, w, h, r, c)
    var ri: u64 = 0
    if r > b {
        ri = r - b
    }
    rrect(x + b, y + b, w - 2 * b, h - 2 * b, ri, inner)
}

// A shadow below a rounded box: `reach` one-pixel rings, the outermost
// the weakest, shifted down by one -- uidraw.drop_shadow's shape, painted
// as translucent rings by fUi instead of a get/blend/put per pixel.
fn shadow(x: u64, y: u64, w: u64, h: u64, r: u64, strength: u64,
    reach: u64, c: u64) {
    if strength == 0 || reach == 0 || w == 0 || h == 0 {
        return
    }
    if !ready() {
        uidraw.drop_shadow(x, y, w, h, r, strength, reach, c)
        return
    }
    clip_sync()
    var i: u64 = reach
    while i > 0 {
        let a: u64 = strength * 255 / 100 * (reach + 1 - i) / (reach + 1)
        if a != 0 {
            let fx: f64 = (x as f64) - (i as f64)
            let fyy: f64 = fy(y + 1) - (i as f64)
            let ww: u64 = w + 2 * i
            let hh: u64 = h + 2 * i
            painter.round_ring(pz(), fx, fyy, ww as f64, hh as f64,
                cap_r(r + i, ww, hh) as f64, 1.0, argb(c, a))
        }
        i = i - 1
    }
    s_n_prim = s_n_prim + 1
}

// How many primitives fUi painted for wlib (the counter of stage 1).
fn fui_prims() -> u64 {
    return s_n_prim
}

// ====================================================================
// ROUND FUI-ALL, STAGE 1b: PICTURES, DRAWN BY fUi.
//
// The last two places where wlib still set pixels itself were the icon
// cell of a list row and the image widget (viewer: zoom, pan, quarter
// turns). Both hold pixels as 0xAARRGGBB words -- read by fUi's Image
// with R and B swapped, which is exactly the channel order the bridge
// hands the painter everywhere else (`swap_rb`), so no copy is made.
//
//   * `icon`: 1:1, no scaling -- the sampler lands on pixel centres and
//     reproduces the source exactly; alpha 0 leaves the row colour.
//   * `picture`: unturned it is `uiimage.image_draw_rect` (box filter
//     when shrinking, bilinear when growing -- no stairs); a quarter turn
//     goes through `transform.tf_draw_image` with the turn as a matrix.
// Both honour wlibc's clip; without a surface they return false and the
// caller keeps its old loop.
// ====================================================================

fn icon(px: u64, w: u64, h: u64, stride: u64, x: u64, y: u64) -> bool {
    if px == 0 || w == 0 || h == 0 || !ready() {
        return false
    }
    clip_sync()
    var im: uiimage.Image = uiimage.image_wrap(px, w as usize, h as usize,
        stride as usize)
    uiimage.image_draw_rect(pz(), &im, x as f64, fy(y), w as f64,
        h as f64, 0 as u32)
    s_n_prim = s_n_prim + 1
    return true
}

// `iw` x `ih` pixels at `px`, turned by `turn` quarters clockwise, into
// the box (`ox`, `oy`) of `zw` x `zh` (the turned size, zoomed). `ox`/`oy`
// may lie left of or above the widget (panned): they are signed.
fn picture(px: u64, iw: u64, ih: u64, turn: u64, ox: i64, oy: i64,
    zw: u64, zh: u64) -> bool {
    if px == 0 || iw == 0 || ih == 0 || zw == 0 || zh == 0 || !ready() {
        return false
    }
    clip_sync()
    var im: uiimage.Image = uiimage.image_wrap(px, iw as usize,
        ih as usize, 0)
    let fx: f64 = ox as f64
    let fyy: f64 = (oy as f64) - (hosthead.band_y() as f64)
    let q: u64 = turn & 3
    if q == 0 {
        uiimage.image_draw_rect(pz(), &im, fx, fyy, zw as f64, zh as f64,
            0 as u32)
    } else {
        // turned size before zoom: quarter 1/3 swap the sides
        var bw: f64 = iw as f64
        var bh: f64 = ih as f64
        if q == 1 || q == 3 {
            bw = ih as f64
            bh = iw as f64
        }
        var xf: transform.Xform = transform.xf_new()
        transform.xf_translate(&xf, fx, fyy)
        transform.xf_scale(&xf, (zw as f64) / bw, (zh as f64) / bh, 0.0, 0.0)
        if q == 1 {
            transform.xf_translate(&xf, ih as f64, 0.0)
        } else if q == 2 {
            transform.xf_translate(&xf, iw as f64, ih as f64)
        } else {
            transform.xf_translate(&xf, 0.0, iw as f64)
        }
        transform.xf_rotate(&xf, (q * 90) as f64)
        transform.tf_draw_image(pz(), &xf, &im, 0.0, 0.0, iw as f64,
            ih as f64, 1.0)
    }
    s_n_prim = s_n_prim + 1
    return true
}

// FUI-ALL stage 3: the dots of a password field are fUi's mask -- one
// U+2022 per CHARACTER (lead octets only), exactly what fUi's own secret
// field shows. Returns the octets written to `out` (at most `cap`).
fn secret_mask(p: u64, n: u64, out: u64, cap: u64) -> u64 {
    return render.secret_mask(p, n as usize, out, cap as usize) as u64
}

// ====================================================================
// FUI-ALL STAGE 2: A PROGRAM THAT PAINTS WITH fUi ITSELF.
//
// Up to here fUi only painted what wlib asked for, primitive by primitive
// on wlib's band. A program on fUi DIRECTLY owns its pixels: one wlib
// canvas widget (`wlib.canvas`, the same widget Certus paints its page
// into) whose buffer the program hands to fUi. This is the second canvas
// of the bridge -- same theme (the system scheme, R and B swapped, so the
// octets land in the framebuffer's order), same fonts, its own painter
// and render context, bound to the program's buffer instead of wlib's
// surface. `kernel/user/fuiapp.fi` wraps window, buffer and events.
// ====================================================================
static mut s_app_ok: u64 = 0
static mut s_app_w: u64 = 0
static mut s_acvm: [u64; 128] = [0; 128]
static mut s_apzm: [u64; 512] = [0; 512]
static mut s_actxm: [u64; 8] = [0; 8]

fn app_canvas() -> *mut canvas.Canvas {
    return ((&s_acvm[0 as usize]) as u64) as *mut canvas.Canvas
}

fn app_pz() -> *mut painter.Painter {
    return ((&s_apzm[0 as usize]) as u64) as *mut painter.Painter
}

fn app_ctx() -> *mut render.Ctx {
    return ((&s_actxm[0 as usize]) as u64) as *mut render.Ctx
}

fn app_theme() -> *mut theme.Theme {
    return th()
}

// Bind fUi to `px` (w*h words, B,G,R,0 like the surface). The theme and
// fonts come from `ready()`, so the window must have been painted once.
// A new buffer (resize) rebinds the canvas; the painter keeps its raster
// store as long as the height does not grow.
fn app_bind(px: u64, w: u64, h: u64) -> bool {
    if px == 0 || w == 0 || h == 0 || !ready() {
        return false
    }
    canvas_on_surface(app_canvas(), px, w as usize, h as usize)
    // The raster window of a shape is one column wider than the shape
    // (painter.raster_window: `(bx - ax) + 1`), so a panel as wide as
    // the canvas needs `w + 1` columns -- with exactly `w` it was not
    // painted at all (FUI-ALL known defect, 02.10.2026). Two spare ones.
    if s_app_ok == 0 || s_app_ok < h || s_app_w < w {
        var pw: u64 = w
        var ph: u64 = h
        if s_app_w > pw {
            pw = s_app_w
        }
        if s_app_ok > ph {
            ph = s_app_ok
        }
        painter.painter_free(app_pz())
        s_app_ok = 0
        s_app_w = 0
        if !painter.painter_init(app_pz(), app_canvas(), (pw + 2) as usize,
            (ph + 3) as usize) {
            return false
        }
        painter.painter_set_font(app_pz(), fuiglyph.fontset(fuiglyph.ROLE_UI))
        *app_ctx() = render.ctx_new(th(), app_pz())
        s_app_ok = ph
        s_app_w = pw
    }
    return true
}
