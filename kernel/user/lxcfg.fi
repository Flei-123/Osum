profile kernel

import ulib
import libc.text
import xfxio

export { load, runtime, exec_argc, exec_argv, env_count, env_at, proc_name, check_path, MAX_ARGS, MAX_ENV }

const CFG_MAX: u64 = 1024
const MAX_ARGS: u64 = 8
const MAX_ENV: u64 = 8
const NEWLINE: u64 = 10
const SPACE: u64 = 32
const EQUALS: u64 = 61
static mut cfg: [u8; 1024] = [0 as u8; 1024]
static mut cfg_path: [u8; 96] = [0 as u8; 96]
static mut argv_list: [u64; 8] = [0 as u64; 8]
static mut env_list: [u64; 8] = [0 as u64; 8]
static mut argc: u64 = 0
static mut envc: u64 = 0
static mut is_runtime: bool = false
static mut proc_value: u64 = 0
static mut check_value: u64 = 0
static mut k_exec: [u8; 6] = "exec=\0"
static mut k_env: [u8; 5] = "env=\0"
static mut k_kind: [u8; 6] = "kind=\0"
static mut k_proc: [u8; 6] = "proc=\0"
static mut k_check: [u8; 7] = "check=\0"
static mut v_runtime: [u8; 8] = "runtime\0"
static mut s_apps: [u8; 7] = "/apps/\0"
static mut s_file: [u8; 12] = ".osp/lx.app\0"

fn starts_with(at: u64, key: u64) -> bool {
    return ulib.strneq((&cfg[0 as usize]) as u64 + at, key, text.length(key))
}

fn split_args(at: u64) {
    var p: u64 = at
    argc = 0
    while cfg[p as usize] != 0 as u8 && argc < MAX_ARGS {
        argv_list[argc as usize] = (&cfg[0 as usize]) as u64 + p
        argc = argc + 1
        while cfg[p as usize] != 0 as u8 && cfg[p as usize] != SPACE as u8 {
            p = p + 1
        }
        if cfg[p as usize] == SPACE as u8 {
            cfg[p as usize] = 0 as u8
            p = p + 1
        }
    }
}

fn take_line(at: u64) {
    if starts_with(at, (&k_exec[0 as usize]) as u64) {
        split_args(at + text.length((&k_exec[0 as usize]) as u64))
    } else if starts_with(at, (&k_env[0 as usize]) as u64) && envc < MAX_ENV {
        env_list[envc as usize] = (&cfg[0 as usize]) as u64 + at + text.length((&k_env[0 as usize]) as u64)
        envc = envc + 1
    } else if starts_with(at, (&k_kind[0 as usize]) as u64) {
        is_runtime = ulib.streq((&cfg[0 as usize]) as u64 + at + text.length((&k_kind[0 as usize]) as u64), (&v_runtime[0 as usize]) as u64)
    } else if starts_with(at, (&k_proc[0 as usize]) as u64) {
        proc_value = (&cfg[0 as usize]) as u64 + at + text.length((&k_proc[0 as usize]) as u64)
    } else if starts_with(at, (&k_check[0 as usize]) as u64) {
        check_value = (&cfg[0 as usize]) as u64 + at + text.length((&k_check[0 as usize]) as u64)
    }
}

fn parse(len: u64) {
    var i: u64 = 0
    var line_start: u64 = 0
    while i <= len {
        if i == len || cfg[i as usize] == NEWLINE as u8 {
            cfg[i as usize] = 0 as u8
            if i > line_start {
                take_line(line_start)
            }
            line_start = i + 1
        }
        i = i + 1
    }
}

fn load(name: u64) -> bool {
    argc = 0
    envc = 0
    is_runtime = false
    proc_value = 0
    check_value = 0
    ulib.strcpy((&cfg_path[0 as usize]) as u64, (&s_apps[0 as usize]) as u64)
    ulib.strcat((&cfg_path[0 as usize]) as u64, name)
    ulib.strcat((&cfg_path[0 as usize]) as u64, (&s_file[0 as usize]) as u64)
    let len: u64 = xfxio.read_text((&cfg_path[0 as usize]) as u64, (&cfg[0 as usize]) as u64, CFG_MAX)
    if len == ulib.EOF || len == 0 {
        return false
    }
    parse(len)
    return check_value != 0 && proc_value != 0 && (is_runtime || argc > 0)
}

fn runtime() -> bool {
    return is_runtime
}

fn exec_argc() -> u64 {
    return argc
}

fn exec_argv(i: u64) -> u64 {
    return argv_list[i as usize]
}

fn env_count() -> u64 {
    return envc
}

fn env_at(i: u64) -> u64 {
    return env_list[i as usize]
}

fn proc_name() -> u64 {
    return proc_value
}

fn check_path() -> u64 {
    return check_value
}
