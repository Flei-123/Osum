profile app

import ulib
import deepindex

export { open_first }

const MAX_HITS: u64 = 8

static mut hits: [u64; 8] = [0 as u64; 8]

fn open_first(term: u64, skip_exec: u64) -> bool {
    if term == 0 || __mmio_read8(term as *mut u8) as u64 == 0 {
        return false
    }
    let n: u64 = deepindex.query(term, (&hits[0 as usize]) as u64, MAX_HITS)
    var i: u64 = 0
    while i < n {
        let link: u64 = hits[i as usize] - deepindex.LINK_BASE
        if skip_exec == 0 || !ulib.streq(deepindex.exec_at(link), skip_exec) {
            return !ulib.bad(deepindex.open_at(link))
        }
        i = i + 1
    }
    return false
}
