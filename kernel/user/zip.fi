
profile kernel

import ulib
import libc.io
import tools
import flate
import libc.octets

export { u_start }

const ARCH_CAP: u64 = 786432
const FILE_CAP: u64 = 262144
const COMP_CAP: u64 = 278528
const MAXE: u64 = 256
const NAMEC: u64 = 112

static mut arch: [u8; 786432] = [0 as u8; 786432]
static mut fbuf: [u8; 262144] = [0 as u8; 262144]
static mut cbuf: [u8; 278528] = [0 as u8; 278528]
static mut hdr: [u8; 128] = [0 as u8; 128]
static mut names: [u8; 28672] = [0 as u8; 28672]
static mut e_off: [u64; 256] = [0; 256]
static mut e_crc: [u64; 256] = [0; 256]
static mut e_csz: [u64; 256] = [0; 256]
static mut e_usz: [u64; 256] = [0; 256]
static mut e_dir: [u64; 256] = [0; 256]
static mut e_verf: [u64; 256] = [0; 256]
static mut ne: u64 = 0
static mut afd: u64 = 0
static mut apos: u64 = 0
static mut store_only: bool = false
static mut verbose: bool = true
static mut path: [u8; 512] = [0 as u8; 512]
static mut target: [u8; 512] = [0 as u8; 512]

fn say(p: u64) {
    ulib.say(p)
}

fn nl() {
    ulib.nl()
}

fn name_at(i: u64) -> u64 {
    return (&names[(0) as usize]) as u64 + i * NAMEC
}

fn st8(p: u64, at: u64, v: u64) {
    __mmio_write8((p + at) as *mut u8, (v & 255) as u8)
}

fn st16(p: u64, at: u64, v: u64) {
    st8(p, at, v)
    st8(p, at + 1, v >> 8)
}

fn st32(p: u64, at: u64, v: u64) {
    st16(p, at, v)
    st16(p, at + 2, v >> 16)
}

fn off(p: u64, n: u64) -> bool {
    let g: u64 = io.write_all(afd, p, n)
    if ulib.bad(g) || g < n {
        return false
    }
    apos = apos + n
    return true
}

fn header_local(i: u64, nlen: u64) -> bool {
    let h: u64 = (&hdr[(0) as usize]) as u64
    ulib.fill(h, 0, 30)
    st32(h, 0, 0x04034B50)
    st16(h, 4, 20)
    st16(h, 6, 0)
    st16(h, 8, e_verf[(i) as usize])
    st16(h, 10, 0)
    st16(h, 12, 0)
    st32(h, 14, e_crc[(i) as usize])
    st32(h, 18, e_csz[(i) as usize])
    st32(h, 22, e_usz[(i) as usize])
    st16(h, 26, nlen)
    st16(h, 28, 0)
    return off(h, 30)
}

fn header_center(i: u64, nlen: u64) -> bool {
    let h: u64 = (&hdr[(0) as usize]) as u64
    ulib.fill(h, 0, 46)
    st32(h, 0, 0x02014B50)
    st16(h, 4, 20)
    st16(h, 6, 20)
    st16(h, 8, 0)
    st16(h, 10, e_verf[(i) as usize])
    st32(h, 16, e_crc[(i) as usize])
    st32(h, 20, e_csz[(i) as usize])
    st32(h, 24, e_usz[(i) as usize])
    st16(h, 28, nlen)
    if e_dir[(i) as usize] != 0 {
        st32(h, 38, 0x41FF0010)
    } else {
        st32(h, 38, 0x81A40000)
    }
    st32(h, 42, e_off[(i) as usize])
    return off(h, 46)
}

fn end(vz_off: u64, vz_len: u64) -> bool {
    let h: u64 = (&hdr[(0) as usize]) as u64
    ulib.fill(h, 0, 22)
    st32(h, 0, 0x06054B50)
    st16(h, 8, ne)
    st16(h, 10, ne)
    st32(h, 12, vz_len)
    st32(h, 16, vz_off)
    return off(h, 22)
}

fn read_int(path_p: u64) -> u64 {
    let fd: u64 = tools.openr(path_p)
    if ulib.bad(fd) {
        return 0xFFFFFFFFFFFFFFFF
    }
    var n: u64 = 0
    var next: bool = true
    while next {
        let g: u64 = io.read(fd, (&fbuf[(0) as usize]) as u64 + n,
            FILE_CAP - n)
        if ulib.bad(g) || g == 0 {
            next = false
        } else {
            n = n + g
            if n >= FILE_CAP {
                next = false
            }
        }
    }
    io.close(fd)
    return n
}

fn entry(fs_path: u64, name: u64, ist_dir: bool) -> bool {
    var s_big: [u8; 22] = "zip: too many entries\0"
    var s_lang: [u8; 20] = "zip: Name zu lang: \0"
    var s_read: [u8; 19] = "zip: cannot read: \0"
    var s_gr: [u8; 30] = "zip: too big (over 256 KiB): \0"
    if ne >= MAXE {
        say((&s_big[(0) as usize]) as u64)
        nl()
        return false
    }
    let nlen: u64 = ulib.length(name)
    if nlen >= NAMEC {
        ulib.esay_line((&s_lang[(0) as usize]) as u64, name)
        return false
    }
    ulib.strncpy(name_at(ne), name, NAMEC)
    var roh: u64 = 0
    if !ist_dir {
        let g: u64 = read_int(fs_path)
        if g == 0xFFFFFFFFFFFFFFFF {
            ulib.esay_line((&s_read[(0) as usize]) as u64, fs_path)
            return false
        }
        if g >= FILE_CAP {
            ulib.esay_line((&s_gr[(0) as usize]) as u64, fs_path)
            return false
        }
        roh = g
    }
    e_dir[(ne) as usize] = 0
    if ist_dir {
        e_dir[(ne) as usize] = 1
    }
    e_usz[(ne) as usize] = roh
    e_crc[(ne) as usize] = flate.crc32((&fbuf[(0) as usize]) as u64, roh)
    e_off[(ne) as usize] = apos
    var clen: u64 = roh
    var data: u64 = (&fbuf[(0) as usize]) as u64
    e_verf[(ne) as usize] = 0
    if roh > 0 && !store_only {
        var raus: u64 = 0
        let rc: u64 = flate.deflate((&fbuf[(0) as usize]) as u64, roh,
            (&cbuf[(0) as usize]) as u64, COMP_CAP,
            (&raus) as u64)
        if rc == flate.E_OK && raus < roh {
            clen = raus
            data = (&cbuf[(0) as usize]) as u64
            e_verf[(ne) as usize] = 8
        }
    }
    e_csz[(ne) as usize] = clen
    if !header_local(ne, nlen) {
        return false
    }
    if !off(name, nlen) {
        return false
    }
    if clen > 0 && !off(data, clen) {
        return false
    }
    if verbose {
        say(name)
        nl()
    }
    ne = ne + 1
    return true
}

fn point(name: u64) -> bool {
    if *((name) as *mut u8) != 46 as u8 {
        return false
    }
    if *((name + 1) as *mut u8) == 0 as u8 {
        return true
    }
    return *((name + 1) as *mut u8) == 46 as u8
        && *((name + 2) as *mut u8) == 0 as u8
}

fn begehen(fs_path: u64, name: u64, tiefe: u64) -> bool {
    var s_tief: [u8; 29] = "zip: zu tief verschachtelt: \0"
    var slash: [u8; 2] = "/\0"
    if tiefe > 12 {
        ulib.esay_line((&s_tief[(0) as usize]) as u64, fs_path)
        return false
    }
    var dname: [u8; 128] = [0 as u8; 128]
    var kind: [u8; 512] = [0 as u8; 512]
    var kname: [u8; 128] = [0 as u8; 128]
    ulib.strncpy((&dname[(0) as usize]) as u64, name, 120)
    ulib.strcat((&dname[(0) as usize]) as u64, (&slash[(0) as usize]) as u64)
    if !entry(fs_path, (&dname[(0) as usize]) as u64, true) {
        return false
    }
    let fd: u64 = io.dir_open(fs_path)
    if ulib.bad(fd) {
        return false
    }
    var buf: [u8; 1024] = [0 as u8; 1024]
    var gut: bool = true
    var next: bool = true
    while next {
        let n: u64 = io.dir_read(fd, (&buf[(0) as usize]) as u64, 1024)
        if ulib.bad(n) || n == 0 {
            next = false
        } else {
            var at: u64 = 0
            while at < n {
                let rec: u64 = (&buf[(0) as usize]) as u64 + at
                let nm: u64 = io.dir_name(rec)
                if !point(nm) {
                    tools.join((&kind[(0) as usize]) as u64, fs_path, nm)
                    ulib.strncpy((&kname[(0) as usize]) as u64,
                        (&dname[(0) as usize]) as u64, 120)
                    ulib.strcat((&kname[(0) as usize]) as u64, nm)
                    if ulib.is_dir((&kind[(0) as usize]) as u64) {
                        if !begehen((&kind[(0) as usize]) as u64,
                            (&kname[(0) as usize]) as u64, tiefe + 1) {
                            gut = false
                        }
                    } else {
                        if !entry((&kind[(0) as usize]) as u64,
                            (&kname[(0) as usize]) as u64, false) {
                            gut = false
                        }
                    }
                }
                at = at + io.dir_reclen(rec)
            }
        }
    }
    io.close(fd)
    return gut
}

fn packen(archive: u64, args: u64, ab: u64, argc: u64) -> u64 {
    var s_auf: [u8; 20] = "zip: cannot write: \0"
    var s_empty: [u8; 22] = "zip: nichts zu packen\0"
    afd = tools.openw(archive)
    if ulib.bad(afd) {
        ulib.esay_line((&s_auf[(0) as usize]) as u64, archive)
        return 1
    }
    apos = 0
    ne = 0
    var gut: bool = true
    var a: u64 = ab
    while a < argc {
        let p: u64 = ulib.arg_at(args, a)
        let base: u64 = ulib.base_name(p)
        if ulib.is_dir(p) {
            if !begehen(p, base, 0) {
                gut = false
            }
        } else {
            if !entry(p, base, false) {
                gut = false
            }
        }
        a = a + 1
    }
    if ne == 0 {
        say((&s_empty[(0) as usize]) as u64)
        nl()
        io.close(afd)
        return 1
    }
    let vz: u64 = apos
    var i: u64 = 0
    while i < ne && gut {
        let nlen: u64 = ulib.length(name_at(i))
        if !header_center(i, nlen) {
            gut = false
        } else if !off(name_at(i), nlen) {
            gut = false
        }
        i = i + 1
    }
    if gut {
        gut = end(vz, apos - vz)
    }
    io.close(afd)
    if !gut {
        return 1
    }
    var s_fertig: [u8; 14] = "zip: entries \0"
    var s_okt: [u8; 10] = " Oktette \0"
    say((&s_fertig[(0) as usize]) as u64)
    ulib.sayn(ne)
    say((&s_okt[(0) as usize]) as u64)
    ulib.sayn(apos)
    nl()
    return 0
}

static mut alen: u64 = 0

fn archive_read(path_p: u64) -> bool {
    let fd: u64 = tools.openr(path_p)
    if ulib.bad(fd) {
        return false
    }
    alen = 0
    var next: bool = true
    while next {
        let g: u64 = io.read(fd, (&arch[(0) as usize]) as u64 + alen,
            ARCH_CAP - alen)
        if ulib.bad(g) || g == 0 {
            next = false
        } else {
            alen = alen + g
            if alen >= ARCH_CAP {
                next = false
            }
        }
    }
    io.close(fd)
    return alen > 22
}

fn eocd_find() -> u64 {
    let a: u64 = (&arch[(0) as usize]) as u64
    var at: u64 = alen - 22
    var gefunden: u64 = 0xFFFFFFFFFFFFFFFF
    var schritte: u64 = 0
    while schritte < 65558 && gefunden == 0xFFFFFFFFFFFFFFFF {
        if octets.ld32(a, at) == 0x06054B50 {
            gefunden = at
        }
        if at == 0 {
            schritte = 65558
        } else {
            at = at - 1
            schritte = schritte + 1
        }
    }
    return gefunden
}

fn dirs_make(p: u64) {
    var i: u64 = 1
    while *((p + i) as *mut u8) != 0 as u8 {
        if *((p + i) as *mut u8) == 47 as u8 {
            __mmio_write8((p + i) as *mut u8, 0 as u8)
            let _r: u64 = io.make_dir(p)
            __mmio_write8((p + i) as *mut u8, 47 as u8)
        }
        i = i + 1
    }
}

fn ist_boese(name: u64) -> bool {
    if *((name) as *mut u8) == 47 as u8 {
        return true
    }
    var i: u64 = 0
    while *((name + i) as *mut u8) != 0 as u8 {
        if *((name + i) as *mut u8) == 46 as u8
            && *((name + i + 1) as *mut u8) == 46 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

fn entpacken(archive: u64, zielp: u64, only_list: bool) -> u64 {
    var s_auf: [u8; 19] = "zip: cannot read: \0"
    var s_kein: [u8; 40] = "zip: not a ZIP archive (no end block): \0"
    var s_verf: [u8; 32] = "zip: unbekanntes Verfahren bei \0"
    var s_crypt: [u8; 35] = "zip: encrypted, I cannot do that: \0"
    var s_boese: [u8; 31] = "zip: dangerous name, skipped: \0"
    var s_crc: [u8; 24] = "zip: checksum wrong at \0"
    var s_schr: [u8; 20] = "zip: cannot write: \0"
    var s_gr: [u8; 21] = "zip: entry too big: \0"
    var s_n: [u8; 14] = "zip: entries \0"
    var s_ok: [u8; 11] = " entpackt \0"
    var slash: [u8; 2] = "/\0"
    if !archive_read(archive) {
        ulib.esay_line((&s_auf[(0) as usize]) as u64, archive)
        return 1
    }
    let a: u64 = (&arch[(0) as usize]) as u64
    let eo: u64 = eocd_find()
    if eo == 0xFFFFFFFFFFFFFFFF {
        ulib.esay_line((&s_kein[(0) as usize]) as u64, archive)
        return 1
    }
    let anz: u64 = octets.ld16(a, eo + 10)
    var vz: u64 = octets.ld32(a, eo + 16)
    var err: u64 = 0
    var getan: u64 = 0
    var i: u64 = 0
    while i < anz && vz + 46 <= alen {
        if octets.ld32(a, vz) != 0x02014B50 {
            i = anz
        } else {
            let flags: u64 = octets.ld16(a, vz + 8)
            let verf: u64 = octets.ld16(a, vz + 10)
            let crc: u64 = octets.ld32(a, vz + 16)
            let csz: u64 = octets.ld32(a, vz + 20)
            let usz: u64 = octets.ld32(a, vz + 24)
            let nlen: u64 = octets.ld16(a, vz + 28)
            let elen: u64 = octets.ld16(a, vz + 30)
            let klen: u64 = octets.ld16(a, vz + 32)
            let lo: u64 = octets.ld32(a, vz + 42)
            let nm: u64 = a + vz + 46
            var name: [u8; 256] = [0 as u8; 256]
            var n2: u64 = nlen
            if n2 > 250 {
                n2 = 250
            }
            ulib.copy((&name[(0) as usize]) as u64, nm, n2)
            __mmio_write8(((&name[(0) as usize]) as u64 + n2) as *mut u8,
                0 as u8)
            let ist_dir: bool = n2 > 0
                && *((&name[((n2 - 1)) as usize]) as u64 as *mut u8)
                    == 47 as u8
            if only_list {
                say((&name[(0) as usize]) as u64)
                var sp: [u8; 3] = "  \0"
                say((&sp[(0) as usize]) as u64)
                ulib.sayn(usz)
                nl()
                getan = getan + 1
            } else if (flags & 1) != 0 {
                ulib.esay_line((&s_crypt[(0) as usize]) as u64,
                    (&name[(0) as usize]) as u64)
                err = err + 1
            } else if ist_boese((&name[(0) as usize]) as u64) {
                ulib.esay_line((&s_boese[(0) as usize]) as u64,
                    (&name[(0) as usize]) as u64)
                err = err + 1
            } else if verf != 0 && verf != 8 {
                ulib.esay_line((&s_verf[(0) as usize]) as u64,
                    (&name[(0) as usize]) as u64)
                err = err + 1
            } else if usz > FILE_CAP {
                ulib.esay_line((&s_gr[(0) as usize]) as u64,
                    (&name[(0) as usize]) as u64)
                err = err + 1
            } else {
                let z: u64 = (&target[(0) as usize]) as u64
                ulib.strncpy(z, zielp, 400)
                if ulib.length(z) > 0
                    && *((z + ulib.length(z) - 1) as *mut u8) != 47 as u8 {
                    ulib.strcat(z, (&slash[(0) as usize]) as u64)
                }
                ulib.strcat(z, (&name[(0) as usize]) as u64)
                dirs_make(z)
                if ist_dir {
                    let _r: u64 = io.make_dir(z)
                    getan = getan + 1
                } else {
                    let lnl: u64 = octets.ld16(a, lo + 26)
                    let lel: u64 = octets.ld16(a, lo + 28)
                    let data: u64 = lo + 30 + lnl + lel
                    var raus: u64 = 0
                    var ok: bool = true
                    if verf == 0 {
                        ulib.copy((&fbuf[(0) as usize]) as u64, a + data,
                            csz)
                        raus = csz
                    } else {
                        let rc: u64 = flate.inflate(a + data, csz,
                            (&fbuf[(0) as usize]) as u64, FILE_CAP,
                            (&raus) as u64)
                        if rc != flate.E_OK {
                            ok = false
                        }
                    }
                    if ok && flate.crc32((&fbuf[(0) as usize]) as u64, raus)
                        != crc {
                        ok = false
                        ulib.esay_line((&s_crc[(0) as usize]) as u64,
                            (&name[(0) as usize]) as u64)
                    }
                    if !ok {
                        err = err + 1
                    } else {
                        let fd: u64 = tools.openw(z)
                        if ulib.bad(fd) {
                            ulib.esay_line((&s_schr[(0) as usize]) as u64, z)
                            err = err + 1
                        } else {
                            let g: u64 = io.write_all(fd,
                                (&fbuf[(0) as usize]) as u64, raus)
                            io.close(fd)
                            if ulib.bad(g) || g < raus {
                                ulib.esay_line((&s_schr[(0) as usize]) as u64,
                                    z)
                                err = err + 1
                            } else {
                                getan = getan + 1
                                if verbose {
                                    say((&name[(0) as usize]) as u64)
                                    nl()
                                }
                            }
                        }
                    }
                }
            }
            vz = vz + 46 + nlen + elen + klen
        }
        i = i + 1
    }
    say((&s_n[(0) as usize]) as u64)
    ulib.sayn(anz)
    say((&s_ok[(0) as usize]) as u64)
    ulib.sayn(getan)
    nl()
    if err != 0 {
        return 1
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 50] = "zip: zip -c|-x|-t archiv.zip [dateien|zielordner]\0"
    var s_hier: [u8; 2] = ".\0"
    let argc: u64 = ulib.arg_count(args)
    var modus: u64 = 0
    var at: u64 = 1
    if at < argc {
        let a: u64 = ulib.arg_at(args, at)
        var i: u64 = 0
        if *((a) as *mut u8) == 45 as u8 {
            i = 1
        }
        while *((a + i) as *mut u8) != 0 as u8 {
            let c: u64 = (*((a + i) as *mut u8)) as u64
            if c == 99 || c == 120 || c == 116 {
                modus = c
            } else if c == 48 {
                store_only = true
            } else if c == 113 {
                verbose = false
            }
            i = i + 1
        }
        at = at + 1
    }
    if modus == 0 || at >= argc {
        ulib.esay_line((&s_use[(0) as usize]) as u64, 0)
        return 2
    }
    let archive: u64 = ulib.arg_at(args, at)
    at = at + 1
    if modus == 99 {
        if at >= argc {
            ulib.esay_line((&s_use[(0) as usize]) as u64, 0)
            return 2
        }
        return packen(archive, args, at, argc)
    }
    var z: u64 = (&s_hier[(0) as usize]) as u64
    if at < argc {
        z = ulib.arg_at(args, at)
    }
    return entpacken(archive, z, modus == 116)
}
