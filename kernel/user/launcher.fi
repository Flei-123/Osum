// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/launcher.fi -- Runde K15, Nachtrag: DER STARTER.
//
// Ein Fenster mit einem Suchfeld. Man tippt, und waehrend man tippt
// wird die Liste kuerzer; man drueckt die Eingabetaste oder klickt
// doppelt, und das Programm laeuft.
//
// GESUCHT WIRD IN DREI FELDERN: Anzeigename, Beschreibung UND
// SCHLUESSELWOERTER (`kernel/user/appdir.fi`). Das dritte ist der Grund
// fuer die ganze Sache. "Datei-Explorer" findet man mit "datei" und mit
// "explorer" -- das kann jeder Namensvergleich. Mit "folder", "files",
// "manager" oder "verzeichnis" findet man ihn NUR ueber die
// Schluesselwoerter, denn keines dieser Woerter steht im Namen oder in
// der Beschreibung. Genau das misst `tools/k15/run.sh`, und genau
// deshalb gibt es das Argument `nokeys`: dieselbe Suche ohne das Feld,
// und dann findet "folder" nichts. Eine Suche, die immer etwas findet,
// ist keine Suche.
//
// WAS ER MELDET, damit man ihn von aussen nachrechnen kann: wie viele
// Programme das Verzeichnis hat, welchen Suchbegriff er gerade hat, wie
// viele Treffer, und je Treffer Name und Befehl.

// ================================================ RUNDE 31: profile app
//
// Die Wurzeldatei tragt das Profil (compiler/src/prof.rs), und die
// Bedienelemente dieses Programms kommen ab dieser Runde aus fUi
// (wlib -> fuib -> lib/fui). fUi rechnet Geometrie in `f64` und
// benutzt `std.rt`; unter `profile kernel` ist beides gesperrt
// (SPEC.md:125: "Floating point | kernel: only with #[allow_fp] |
// app: free").
//
// Die Module darunter bleiben `kernel` -- gemessen: nur die WURZEL muss
// wechseln. Gebunden wird dafuer OHNE crt.o, weil firnc unter `app`
// seinen eigenen `_start` mitbringt (tools/look/shot.sh liest das
// Profil und laesst crt.o dann weg).
profile app

import ulib
import libc.io
import wlibc
import wlib
import msg
import appdir
import nidx
import pw
import nv

export { u_start }

// RUNDE K16, Syscall 1901: eine Datei oeffnen heisst, das Programm zu
// starten, das die Tabelle im Kern fuer ihre Art fuehrt.
const SYS_FOPEN: u64 = 1901

// ======================================== RUNDE ECHTHARDWARE-4
// DIE EIGENE FENSTERNUMMER, damit `starten` zumachen kann.
//
// `starten` ist eine freie Funktion (sie wird aus drei Stellen der
// Schleife gerufen) und kannte das Fenster nicht. Ein Startmenue,
// das nach dem Start des Programms offen stehen bleibt, ist genau
// das, was Justin auf jedem Belegbild gesehen hat.
static mut g_win: u64 = 0
static mut g_offen: bool = false
// ======================================== RUNDE ECHTHARDWARE-4
// EINE GNADENFRIST NACH DEM AUFGEHEN.
//
// GEMESSEN an menue-2560/serial.txt: nach `klickauf start` stand
// `taskbar: startmenue auf` und `wm: fokus id=11` -- und rund
// achtzig Zeilen spaeter war das Menue wieder zu, ohne dass jemand
// daneben geklickt haette. Der Klick, der das Menue AUFMACHT, geht
// durch die Leiste, und in dem Augenblick wandert der Fokus kurz
// woandershin. Die Regel "Fokus weg heisst zu" hat das als Klick
// daneben gelesen.
//
// Also zaehlt die Regel erst ein halbes Sekundenmass nach dem
// Aufgehen. Ein Mensch, der daneben klickt, braucht laenger als
// 300 Millisekunden dafuer; ein Klick, der das Menue gerade erst
// geoeffnet hat, ist in dieser Zeit laengst vorbei.
static mut g_gnade: u64 = 0
// Der Stand des Tastenzaehlers, den diese Schleife schon gesehen hat.
static mut g_kseq: u64 = 0
const GNADE_TICKS: u64 = 30 // 300 ms bei 100 Hz
static mut suchfeld: [u8; 64] = [0 as u8; 64]
static mut liste: [u8; 1024] = [0 as u8; 1024]
// EIN PLATZ JE ZEILE DER LISTE, und die Liste traegt Programme UND
// Dateien: bis zu MAXAPP Programme und bis zu DMAX Dateien. Das Feld war
// erst 16 lang und damit zu kurz -- das haette bei 16 Programmen und
// einem Dateitreffer neben das Feld geschrieben.
static mut farben: [u64; 32] = [0 as u64; 32]
static mut treffer: [u64; 16] = [0 as u64; 16]
static mut ntreffer: u64 = 0
// AUCH SEIN EIGENER NAME STEHT IN DEN DATEN. Er nimmt sich nicht aus:
// der Titel kommt aus dem Eintrag, dessen `exec` auf dieses Programm
// zeigt -- genauso wie beim Datei-Explorer. Ohne Eintrag steht der
// Aufrufname da und nichts Schoeneres.
static mut t_titel: [u8; 64] = [0 as u8; 64]
static mut t_selbst: [u8; 25] = "/apps/launcher.osp/start\0"
static mut k_prompt: [u8; 16] = "launcher.prompt\0"
// Die Aufschrift des Knopfes, nicht der Name des Programms: der
// steht in den Daten. "Ausfuehren" und nicht noch einmal
// "Starten" -- das Fenster heisst schon so.
static mut k_run: [u8; 13] = "launcher.run\0"
static mut t_dir: [u8; 8] = "/apps\0\0\0"
// WIE VIELE DATEITREFFER UNTER DIE PROGRAMME PASSEN. Der Index kann
// Tausende liefern; ein Fenster kann sieben Zeilen zeigen, und wer nach
// "e" sucht, will nicht 3000 Zeilen sehen, sondern die ersten paar und
// die Zahl daneben.
// RUNDE FUI-WIN11: wie viele TREFFER das Feld zeigt. Eine Zahl und
// nicht zwei -- die Fensterhoehe und die Liste rechnen beide damit.
const LIST_ROWS: u64 = 6
const DMAX: u64 = 12
static mut dtreffer: [u64; 12] = [0 as u64; 12]
static mut ndatei: u64 = 0
static mut dgesamt: u64 = 0
static mut napp: u64 = 0
static mut idxn: u64 = 0
static mut idxus: u64 = 0
static mut ohne_index: bool = false
static mut pfad: [u8; 256] = [0 as u8; 256]

// ============================================ RUNDE BELEG: DER MESSAUSGANG
// STEHT IM NORMALBETRIEB AUS.
//
// Justins Befund am Abbild vom 12.09.2026: im Terminalfenster standen
// Zeilen wie `explorer: krumm n=2 fold=0` und `bg=...`. Gezaehlt hat er
// auch: 160 `ulib.say` in taskbar.fi, 38 in explorer.fi.
//
// Die Regel dazu steht seit Runde LAUFZEIT in taskmgr.fi:
//
//   EIN MESSAUSGANG GEHOERT HINTER EINEN SCHALTER, UND DER SCHALTER
//   STEHT IM NORMALBETRIEB AUS. Ein Programm, das im Auslieferungs-
//   zustand misst, misst vor allem sich selbst.
//
// NICHT GELOESCHT, SONDERN GESCHALTET. Die Zaehler (`fui=`, `fuix=`,
// `rect id=`, `text ... base=`) waren mehrfach der Schluessel zur
// Fehlersuche -- sie muessen fuer die Abnahme da sein. Also EIN Schalter
// statt zweihundert geloeschter Zeilen.
//
// ZWEI WEGE, IHN EINZUSCHALTEN, und beide gab es schon:
//   /etc/uitrace   die Datei, mit der `wlib` seit Runde LOOK dasselbe
//                  tut -- die Pruefstaende legen sie ohnehin an
//   `debug`        als Wort auf der Programmzeile, fuer den Fall, dass
//                  einer allein gestartet wird
//
// OHNE BEIDES AENDERT SICH KEIN OKTETT gegenueber vorher -- das ist die
// Bedingung dafuer, dass kein bestehender Testlaeufer davon etwas merkt.
static mut s_dbg: u64 = 0

// Die drei Ausgaenge dieses Programms, an EINER Stelle geschaltet.
// `sayn` und `nl` stehen hier, damit kein Aufrufer `ulib.` direkt
// nimmt und damit am Schalter vorbeigeht.
fn dbg_on() -> bool {
    return s_dbg != 0
}

fn dbg_setup(args: u64) {
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_dbg = 1
    }
    var a_dbg: [u8; 6] = "debug\0"
    let argc: u64 = ulib.arg_count(args)
    var ai: u64 = 1
    while ai < argc {
        if ulib.streq(ulib.arg_at(args, ai), (&a_dbg[0 as usize]) as u64) {
            s_dbg = 1
        }
        ai = ai + 1
    }
}

fn say(p: u64) {
    if s_dbg == 0 {
        return
    }
    ulib.say(p)
}

fn sayn(v: u64) {
    if s_dbg == 0 {
        return
    }
    ulib.sayn(v)
}

fn nl() {
    if s_dbg == 0 {
        return
    }
    ulib.nl()
}

fn kv(name: u64, v: u64) {
    var sp: [u8; 2] = " \0"
    say(name)
    sayn(v)
    say((&sp[0 as usize]) as u64)
}

// Die Trefferliste neu bauen: ein Textblock fuer das Listen-Widget, ein
// Feld aus Farben fuer die Symbole. Und dieselbe Auskunft auf die
// serielle Leitung, damit der Laeufer draussen nachrechnen kann, was
// drinnen ausgewaehlt wurde.
fn new_find(ls: u64) {
    var s_s: [u8; 25] = "launcher: suche [\0\0\0\0\0\0\0\0"
    var s_t: [u8; 16] = "] treffer=\0\0\0\0\0\0"
    var s_e: [u8; 21] = "launcher: treffer \0\0\0"
    var si: [u8; 4] = "i=\0\0"
    var sn: [u8; 8] = "name=[\0\0"
    var sx: [u8; 10] = "] exec=[\0\0"
    var sz: [u8; 4] = "]\0\0\0"
    napp = appdir.search((&suchfeld[0 as usize]) as u64,
        (&treffer[0 as usize]) as u64, 16)
    ntreffer = napp
    var lp: u64 = 0
    var k: u64 = 0
    while k < ntreffer && k < 16 {
        let a: u64 = treffer[(k) as usize]
        farben[(k) as usize] = appdir.icon_load(a)
        let nm: u64 = appdir.name_of(a)
        var j: u64 = 0
        while (*((nm + j) as *mut u8)) != 0 as u8 && lp < 1000 {
            liste[(lp) as usize] = *((nm + j) as *mut u8)
            lp = lp + 1
            j = j + 1
        }
        // ================================= RUNDE FUI-WIN11
        // EIN TABULATOR STATT ZWEIER STRICHE.
        //
        // Justins Kritik: "Beschreibung steht in DERSELBEN Zeile
        // hinter --". Windows setzt den Namen in Zeile 1 und die
        // Beschreibung gedaempft in Zeile 2. Die Liste kann das seit
        // dieser Runde (`wlib.list_zwei`), und der Schnitt zwischen
        // beiden Haelften ist der TABULATOR -- ein Zeichen, das in
        // keinem Programmnamen und in keinem Dateinamen vorkommt.
        //
        // Der Zeilenumbruch bleibt der Trenner zwischen EINTRAEGEN:
        // wuerde die zweite Haelfte eine eigene Zeile des Blocks,
        // waere jeder Eintrag zwei Eintraege und Auswahl, Rollen und
        // Doppelklick zaehlten doppelt.
        if lp < 1000 {
            liste[(lp) as usize] = 9 as u8
            lp = lp + 1
        }
        let inf: u64 = appdir.info_of(a)
        j = 0
        while (*((inf + j) as *mut u8)) != 0 as u8 && lp < 1000 {
            liste[(lp) as usize] = *((inf + j) as *mut u8)
            lp = lp + 1
            j = j + 1
        }
        liste[(lp) as usize] = 10 as u8
        lp = lp + 1
        k = k + 1
    }
    // UND DARUNTER DIE DATEIEN. Erst die Programme, dann die Treffer aus
    // dem Namensindex -- das ist die Reihenfolge, die der Auftrag
    // verlangt, und sie ist auch die richtige: wer "editor" tippt, meint
    // in neun von zehn Faellen das Programm und nicht eine Datei, die so
    // heisst.
    ndatei = 0
    dgesamt = 0
    if !ohne_index && ulib.length((&suchfeld[0 as usize]) as u64) != 0 {
        dgesamt = nidx.find((&suchfeld[0 as usize]) as u64,
            (&dtreffer[0 as usize]) as u64, DMAX)
        ndatei = dgesamt
        if napp + ndatei > 32 {
            ndatei = 32 - napp
        }
        var d: u64 = 0
        while d < ndatei && lp < 900 {
            let t: u64 = dtreffer[(d) as usize]
            nidx.path_of(t, (&pfad[0 as usize]) as u64, 250)
            // Die Kachel eines Datei-Treffers traegt keine eigene
            // Farbe. Vor Runde THEME stand hier ein grauer Wert, der in
            // einem hellen Thema falsch war und in keinem Schema
            // vorkam; jetzt ist es die Marke fuer gedaempften Text.
            farben[((napp + d)) as usize] =
                wlibc.theme(wlibc.C_TEXT_MUTED)
            // ================================= RUNDE ECHTHARDWARE-4
            // KLARNAME UND NICHT DER ROHE PFAD.
            //
            // Hier wurde der VOLLE Pfad in die Zeile geschrieben, und
            // genau das steht auf Justins Bildern aus ECHTHARDWARE-3:
            // wer "edi" tippt, sieht `/apps/editor.osp` statt
            // "editor.osp". Ein Pfad ist eine Ortsangabe fuer die
            // Maschine, kein Name fuer einen Menschen -- und in einer
            // Liste, die daneben "Editor  --  Write and change text"
            // zeigt, faellt er auf wie ein Fremdkoerper.
            //
            // Die Zeile hat jetzt DIESELBE FORM wie die eines
            // Programms: Name, zwei Striche, Beschreibung. Der Name ist
            // der Dateiname (`nidx.name_at`), die Beschreibung der
            // Ordner, in dem die Datei liegt -- das ist die Auskunft,
            // die man beim Suchen wirklich braucht ("welche der drei
            // gleichnamigen ist es"), und sie ist kuerzer als der Pfad.
            //
            // DER VOLLE PFAD GEHT NICHT VERLOREN: er steht weiter auf
            // der seriellen Leitung (`launcher: datei ... name=[...]`),
            // wo der Laeufer ihn nachrechnet, und `starten()` oeffnet
            // ohnehin ueber `nidx.path_of` und nicht ueber diesen Text.
            let dnm: u64 = nidx.name_at(t)
            var j2: u64 = 0
            while (*((dnm + j2) as *mut u8)) != 0 as u8 && lp < 900 {
                liste[(lp) as usize] = *((dnm + j2) as *mut u8)
                lp = lp + 1
                j2 = j2 + 1
            }
            // RUNDE FUI-WIN11: derselbe Tabulator wie bei den
            // Programmen -- eine Dateizeile hat dieselbe Form wie eine
            // Programmzeile, Name oben, Ordner darunter.
            if lp < 900 {
                liste[(lp) as usize] = 9 as u8
                lp = lp + 1
            }
            // Der Ordner: der Pfad ohne den letzten Namensteil. Steht
            // die Datei im Wurzelverzeichnis, bleibt der Schraegstrich
            // allein stehen -- und das ist richtig so.
            var schnitt: u64 = 0
            var j3: u64 = 0
            while (*(((&pfad[0 as usize]) as u64 + j3) as *mut u8))
                != 0 as u8 {
                if (*(((&pfad[0 as usize]) as u64 + j3) as *mut u8))
                    == 47 as u8 {
                    schnitt = j3
                }
                j3 = j3 + 1
            }
            if schnitt == 0 {
                schnitt = 1
            }
            j3 = 0
            while j3 < schnitt && lp < 980 {
                liste[(lp) as usize] =
                    *(((&pfad[0 as usize]) as u64 + j3) as *mut u8)
                lp = lp + 1
                j3 = j3 + 1
            }
            liste[(lp) as usize] = 10 as u8
            lp = lp + 1
            d = d + 1
        }
        ntreffer = napp + ndatei
    }
    liste[(lp) as usize] = 0 as u8
    wlib.set_text(ls, (&liste[0 as usize]) as u64)
    wlib.list_icons(ls, (&farben[0 as usize]) as u64)
    say((&s_s[0 as usize]) as u64)
    say((&suchfeld[0 as usize]) as u64)
    say((&s_t[0 as usize]) as u64)
    sayn(ntreffer)
    var s_ap: [u8; 8] = " apps=\0\0"
    var s_da: [u8; 12] = "  dateien=\0\0"
    kv((&s_ap[0 as usize]) as u64, napp)
    kv((&s_da[0 as usize]) as u64, ndatei)
    nl()
    var d2: u64 = 0
    while d2 < ndatei {
        var s_df: [u8; 21] = "launcher: datei \0\0\0\0\0"
        nidx.path_of(dtreffer[(d2) as usize], (&pfad[0 as usize]) as u64,
            250)
        say((&s_df[0 as usize]) as u64)
        kv((&si[0 as usize]) as u64, napp + d2)
        say((&sn[0 as usize]) as u64)
        say((&pfad[0 as usize]) as u64)
        say((&sz[0 as usize]) as u64)
        nl()
        d2 = d2 + 1
    }
    // ===================================================== RUNDE ECHTHARDWARE-1
    //
    // `napp` UND NICHT `ntreffer` -- SONST LIEST DIESE SCHLEIFE UEBER
    // DAS FELD HINAUS.
    //
    // `treffer` hat 16 Plaetze und traegt nur die PROGRAMME
    // (`appdir.search(..., 16)`). `ntreffer` ist aber `napp + ndatei`
    // und darf bis 32 gehen -- die Dateitreffer stehen in `dtreffer`,
    // einem ganz anderen Feld. Wer hier bis `ntreffer` zaehlt, greift
    // ab dem 17. Eintrag ins Leere:
    //
    //   panic: index out of bounds in '[u64; 16]'
    //          at kernel/user/launcher.fi:199
    //
    // Gemessen in dieser Runde, sobald zum ersten Mal wirklich getippt
    // werden konnte: "edi" liefert Programme UND Dateien, und der
    // Starter starb an seiner eigenen Meldeschleife. Vorher fiel es
    // nicht auf, weil ohne Tastatureingabe die Dateisuche gar nicht
    // lief (sie braucht ein nichtleeres Suchfeld).
    //
    // Die Dateien werden acht Zeilen weiter oben schon eigens gemeldet
    // (`launcher: datei`), hier gehoeren nur die Programme hin.
    k = 0
    while k < napp && k < 16 {
        let a: u64 = treffer[(k) as usize]
        say((&s_e[0 as usize]) as u64)
        kv((&si[0 as usize]) as u64, k)
        say((&sn[0 as usize]) as u64)
        say(appdir.name_of(a))
        say((&sx[0 as usize]) as u64)
        say(appdir.exec_of(a))
        say((&sz[0 as usize]) as u64)
        nl()
        k = k + 1
    }
}

fn starten(zeile: u64) {
    var s_go: [u8; 21] = "launcher: start \0\0\0\0\0"
    var s_p: [u8; 8] = " pid=\0\0\0"
    var arg: [u8; 160] = [0 as u8; 160]
    if zeile >= ntreffer {
        return
    }
    if zeile >= napp {
        // EINE DATEI IST KEIN PROGRAMM -- ABER SIE WEISS SEIT RUNDE K16,
        // WOMIT MAN SIE OEFFNET. Bis dahin sagte der Starter nur, welche
        // Datei gemeint ist; jetzt fragt er den Kern (`fopen`, 1901), und
        // der schlaegt in der Tabelle "Dateiart -> womit oeffnen" nach,
        // erkennt die Art am INHALT oder an der Endung und startet das
        // eingetragene Programm mit dem Pfad als Argument. Der Starter
        // kennt dabei keine einzige Endung; das ist der ganze Sinn der
        // Tabelle im Kern.
        //
        // RUNDE MERGE-2: der Text von k-merge2, weil der Code darunter
        // seiner ist (SYS_FOPEN). Nur der Name in der Meldung ist der
        // dieses Zweiges -- das Programm heisst hier `launcher`, und die
        // uebrigen Meldungen derselben Datei sagen ebenfalls "launcher:".
        var s_df: [u8; 25] = "launcher: oeffne datei [\0"
        var s_zu2: [u8; 4] = "]\0\0\0"
        var s_op: [u8; 8] = " pid=\0\0\0"
        var argv0: [u64; 4] = [0; 4]
        nidx.path_of(dtreffer[((zeile - napp)) as usize],
            (&pfad[0 as usize]) as u64, 250)
        let fpid: u64 = ulib.sys(SYS_FOPEN, (&pfad[0 as usize]) as u64,
            (&argv0[0 as usize]) as u64, 0)
        say((&s_df[0 as usize]) as u64)
        say((&pfad[0 as usize]) as u64)
        say((&s_zu2[0 as usize]) as u64)
        say((&s_op[0 as usize]) as u64)
        sayn(fpid)
        nl()
        return
    }
    let a: u64 = treffer[(zeile) as usize]
    ulib.strncpy((&arg[0 as usize]) as u64, appdir.exec_of(a), 150)
    // ================================================ ROUND NETVIEW
    //
    // WHICH NETWORK THIS PROGRAM STARTS WITH. The two places it can be
    // written and the order between them are in `appdir.view_for`; here
    // there is only the consequence. A view that is not `real` is put
    // on by starting `/bin/netview` INSTEAD -- the same tool the shell
    // and the file manager use, with the same rule behind it, so this
    // program needs no privilege and no knowledge of how a view is set.
    var who: [u8; 64] = [0 as u8; 64]
    var v0: [u8; 5] = "real\0"
    var v1: [u8; 9] = "filtered\0"
    var v2: [u8; 6] = "faked\0"
    var v3: [u8; 5] = "none\0"
    var tool: [u8; 13] = "/bin/netview\0"
    var s_nv: [u8; 19] = "launcher: netview \0"
    var argv: [u64; 3] = [0 as u64; 3]
    if !pw.name_of_uid(ulib.sys(107, 0, 0, 0), (&who[0 as usize]) as u64, 64) {
        who[0 as usize] = 0 as u8
    }
    let v: u64 = appdir.view_for((&who[0 as usize]) as u64, a,
        appdir.name_of(a))
    var pid: u64 = 0
    if v == ulib.V_REAL {
        // RUNDE TUERSCHLOSS: SYS_SPAWN (1000) nimmt eine NUMMER aus
        // uprog.fi (`if prog == 0 || prog > 16 { return -EINVAL }`),
        // KEINEN Pfad. Ein Zeiger ist immer > 16, also kam hier bei
        // JEDEM App-Start -22 zurueck und nichts lief je an. Der Weg
        // mit Pfad ist SYS_EXEC (1001) -- derselbe, auf den die Leiste
        // in Runde BLECHKERN umgestellt wurde (taskbar.fi:3563 ff.).
        pid = ulib.sys(ulib.SYS_EXEC, (&arg[0 as usize]) as u64, 0, 0)
    } else {
        var word: u64 = (&v0[0 as usize]) as u64
        if v == ulib.V_FILTERED {
            word = (&v1[0 as usize]) as u64
        } else if v == ulib.V_FAKED {
            word = (&v2[0 as usize]) as u64
        } else if v == ulib.V_NONE {
            word = (&v3[0 as usize]) as u64
        }
        argv[0 as usize] = (&tool[0 as usize]) as u64
        argv[1 as usize] = word
        argv[2 as usize] = (&arg[0 as usize]) as u64
        pid = ulib.sys(ulib.SYS_EXEC, (&tool[0 as usize]) as u64,
            (&argv[0 as usize]) as u64, 3)
        say((&s_nv[0 as usize]) as u64)
        say(word)
        nl()
    }
    say((&s_go[0 as usize]) as u64)
    say((&arg[0 as usize]) as u64)
    say((&s_p[0 as usize]) as u64)
    sayn(pid)
    nl()
    // ==================================== RUNDE ECHTHARDWARE-4
    // NACH DEM START GEHT DAS MENUE ZU. So macht es jedes System,
    // und ohne das steht die Trefferliste vor dem Programm, das
    // gerade aufgeht.
    zumachen()
}

// EINE STELLE, an der das Menue zugeht -- gerufen von Escape, vom
// Fokusverlust und vom Programmstart. Drei Wege, ein Zustand.
fn zumachen() {
    var s_zu: [u8; 21] = "launcher: zugemacht\0\0"
    if !g_offen {
        return
    }
    let _h: u64 = wlib.win_hide(g_win, true)
    g_offen = false
    say((&s_zu[0 as usize]) as u64)
    nl()
}

// ============================================== RUNDE STARTKNOPF
// WO DAS MENUE AUFGEHT.
//
// Gelesen wird dieselbe Datei, die die Leiste liest. Ohne sie (oder
// ohne den Schluessel) bleibt es bei `left` -- das ist die Vorgabe der
// Leiste, also ist es hier dieselbe.
static mut lp_conf: [u8; 20] = "/etc/taskbar.conf\0\0\0"
static mut lk_align: [u8; 6] = "align\0"
static mut lw_center: [u8; 7] = "center\0"
static mut lk_height: [u8; 7] = "height\0"
static mut l_align: u64 = 0 // 0 = links, 1 = mittig
static mut l_bar: u64 = 40 // Hoehe der Leiste

fn conf_read() {
    var buf: [u8; 256] = [0 as u8; 256]
    var wort: [u8; 24] = [0 as u8; 24]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&lp_conf[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let b: u64 = (&buf[0 as usize]) as u64
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, b, 255)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return
    }
    var i: u64 = 0
    while i < n {
        let ks: u64 = i
        var ke: u64 = i
        while ke < n && __mmio_read8((b + ke) as *mut u8) != 61 as u8
            && __mmio_read8((b + ke) as *mut u8) != 10 as u8 {
            ke = ke + 1
        }
        if ke < n && __mmio_read8((b + ke) as *mut u8) == 61 as u8 {
            let vs: u64 = ke + 1
            var ve: u64 = vs
            while ve < n && __mmio_read8((b + ve) as *mut u8) != 10 as u8
                && __mmio_read8((b + ve) as *mut u8) != 13 as u8 {
                ve = ve + 1
            }
            let wp: u64 = (&wort[0 as usize]) as u64
            var k: u64 = 0
            var v: u64 = 0
            var ziffern: u64 = 0
            while vs + k < ve && k < 23 {
                let c: u64 = __mmio_read8((b + vs + k) as *mut u8) as u64
                __mmio_write8((wp + k) as *mut u8, c as u8)
                if c >= 48 && c <= 57 {
                    v = v * 10 + (c - 48)
                    ziffern = ziffern + 1
                }
                k = k + 1
            }
            __mmio_write8((wp + k) as *mut u8, 0 as u8)
            if schluessel_ist(b + ks, ke - ks, (&lk_align[0 as usize]) as u64) {
                if ulib.streq(wp, (&lw_center[0 as usize]) as u64) {
                    l_align = 1
                }
            } else if schluessel_ist(b + ks, ke - ks,
                (&lk_height[0 as usize]) as u64) {
                if ziffern > 0 && v > 0 && v < 400 {
                    l_bar = v
                }
            }
            i = ve + 1
        } else {
            i = ke + 1
        }
    }
}

fn schluessel_ist(p: u64, n: u64, name: u64) -> bool {
    var i: u64 = 0
    while i < n {
        let c: u64 = __mmio_read8((p + i) as *mut u8) as u64
        let d: u64 = __mmio_read8((name + i) as *mut u8) as u64
        if d == 0 || c != d {
            return false
        }
        i = i + 1
    }
    return __mmio_read8((name + n) as *mut u8) == 0 as u8
}

// Waagerecht: an der Kante des Startknopfes (links) oder mittig ueber
// ihm. Der Startknopf steht bei `pad()+1` bzw. mittig im freien Lauf --
// die Leiste rechnet dasselbe, und wenn beide dieselbe Datei lesen,
// stehen sie an derselben Stelle.
fn anker_x(bw: u64) -> u64 {
    let sw: u64 = wlibc.screen_w()
    if l_align == 1 {
        if sw > bw {
            return (sw - bw) / 2
        }
        return 0
    }
    return 8
}

// Senkrecht: unmittelbar ueber der Leiste, und nie ueber den oberen
// Rand der Arbeitsflaeche hinaus (dort liegt das reservierte Band).
// ================================================ RUNDE MERGE-11: R5
// DIE LEISTENHOEHE AUS DER DATEI IST NICHT DIE LEISTENHOEHE AUF DEM
// SCHIRM.
//
// Justin: "search programs overlapped mit der taskbar und das soll
// nicht sein, sondern wie bei windows drueber sein."
//
// GEMESSEN auf dem Abbild d832136 bei 3440x1440:
//   taskbar: conf edge=0 ename=bottom height=80   <- auf dem Schirm
//   /etc/taskbar.conf                height=40    <- in der Datei
//   launcher: geom x=8 y=792 w=880 h=600
//   Unterkante 792 + 600 = 1392
//   Leisten-Oberkante   1440 - 80 = 1360
//   -> das Menue ragt 32 Bildpunkte IN die Leiste
//
// DIE LEISTE VERVIELFACHT ihre Masse mit `wlibc.ui_scale()` (siehe
// taskbar.fi, `btn_h`, `gl_w`): aus `height=40` in der Datei werden
// bei Vervielfachung 2 achtzig Bildpunkte. Dieses Feld hat die 40 roh
// genommen -- und lag damit um genau eine Vervielfachung daneben.
//
// Der alte Kommentar hier sagte, die Arbeitsflaeche brauche ein
// Fenster. Das stimmt so nicht: `wm.work_y` liest einen GLOBALEN Wert
// (wm.fi:3176), und `sysgui.fi:874` gibt ihn heraus, ohne das
// Fensterfeld anzusehen. Die Angabe ist also schon vor dem ersten
// eigenen Fenster zu haben -- und sie ist die RICHTIGE Quelle, weil
// der Fensterserver dort JEDE Reservierung abzieht, nicht nur die der
// Leiste.
//
// DESHALB: zuerst die Arbeitsflaeche fragen. Antwortet sie (Hoehe > 0
// und kleiner als der Schirm), endet das Menue acht Bildpunkte ueber
// ihrer Unterkante -- das ist der sichtbare Abstand, den Justin aus
// Windows kennt. Antwortet sie nicht, bleibt der alte Weg, aber MIT
// Vervielfachung.
const AIR: u64 = 8

fn anker_y(bh: u64) -> u64 {
    // NACHGEMESSEN: `work_y(0)` geht NICHT. `sysgui.fi:790` weist
    // jedes Fensterfeld >= MAX_WIN ab, BEVOR es den Zweig fuer die
    // Arbeitsflaeche erreicht -- ein Handle 0 also auch. Der alte
    // Kommentar an dieser Stelle hatte recht, und mein erster Versuch
    // lieferte weiter y=792 (32 Bildpunkte in der Leiste).
    //
    // Also zweistufig: HIER die vervielfachte Leistenhoehe, damit das
    // Fenster gleich an der richtigen Stelle ANGELEGT wird, und nach
    // dem Anlegen rueckt `an_arbeitsflaeche()` es auf den Wert, den
    // der Fensterserver wirklich fuehrt.
    let sh2: u64 = wlibc.screen_h()
    let bar: u64 = l_bar * wlibc.ui_scale()
    if sh2 > bar {
        let unten: u64 = sh2 - bar
        if unten > bh + AIR {
            return unten - bh - AIR
        }
    }
    return 0
}

// Das Fenster auf die Arbeitsflaeche ruecken -- acht Bildpunkte ueber
// deren Unterkante, so wie es Justin aus Windows kennt. Antwortet der
// Server nicht (Hoehe 0 oder groesser als der Schirm), bleibt das
// Fenster stehen, wo es angelegt wurde.
fn an_arbeitsflaeche(w: u64, bw: u64, bh: u64) {
    let hh: u64 = wlib.handle(w)
    if hh == 0 {
        return
    }
    let wy: u64 = wlibc.work_y(hh)
    let wh2: u64 = wlibc.work_h(hh)
    let sh2: u64 = wlibc.screen_h()
    if wh2 == 0 || wy + wh2 > sh2 {
        return
    }
    let unten: u64 = wy + wh2
    var y: u64 = wy
    if unten > bh + AIR {
        y = unten - bh - AIR
    }
    let _m: u64 = wlibc.win_move(hh, anker_x(bw), y)
}

// ==================================================== RUNDE ENERGIE
//
// AUSSCHALTEN, NEUSTART UND ABMELDEN AUS DER OBERFLAECHE.
//
// Punkt P-003 der Offenliste: bis zu dieser Runde ging das Ausschalten
// dieses Systems NUR ueber `/bin/shutdown` auf der Befehlszeile. Ein
// Rechner, den man nur mit einem getippten Befehl ausmachen kann, ist
// kein Alltagssystem -- und das Startmenue ist die Stelle, an der jedes
// andere System diesen Knopf hat.
//
// WAS HIER NEU IST UND WAS NICHT. Neu ist AUSSCHLIESSLICH die
// Oberflaeche: ein Knopf, ein Menue, eine Rueckfrage. Das SAUBERE
// HERUNTERFAHREN gab es schon vollstaendig und es wird hier nicht
// nachgebaut -- eine zweite Abschaltroutine neben `init.shutdown` waere
// genau die zweite Wahrheit, gegen die der Kopf von check-ui.sh
// argumentiert. Der Weg ist derselbe, den `/bin/shutdown` seit Runde
// INIT geht:
//
//     eine Zeile nach /run/svc.cmd  ->  init (Prozess 1) liest sie
//       -> SIGTERM an jeden Dienst, zwei Sekunden Frist
//       -> SIGKILL an die Reste
//       -> sync
//       -> umount_all
//       -> ACPI S5 (kernel/power.fi: acpi_off / acpi_reset)
//
// DIESE REIHENFOLGE IST DER GANZE PUNKT. Ein Ausschalten, das die
// Platte im Flug abschneidet, ist schlimmer als keines; `sync` und
// `umount` stehen deshalb VOR dem S5 und nicht daneben. Belegt wird
// das nicht durch diese Erklaerung, sondern durch die serielle
// Ausgabe eines echten Laufs (docs/RUNDE-ENERGIE.md).
//
// WARUM NICHT `SYS_EXEC /bin/shutdown`? Das waere ein Prozess mehr fuer
// eine Zeile Text, und er koennte fehlschlagen (kein /bin, kein
// Speicher), ohne dass dieses Programm erfaehrt, warum. Die Zeile
// selbst zu schreiben ist ein `open`/`write`/`close` -- und der
// Rueckgabewert sagt sofort, ob es gegriffen hat.
//
// ABMELDEN, EHRLICH GESAGT: dieses System hat noch keine Anmeldung (der
// Schreibtisch laeuft als `root`, P-002). Ein Punkt "Abmelden", der eine
// Sitzung beendet, die es nicht gibt, waere eine Behauptung. Was er
// WIRKLICH tut, steht deshalb in seiner eigenen Funktion und in
// docs/RUNDE-ENERGIE.md: er startet den SCHREIBTISCH neu. Sobald es
// eine Anmeldung gibt, ist hier eine Zeile zu aendern.

// Die Zeilen, die init versteht. `/bin/shutdown` schreibt exakt diese
// (kernel/user/shutdown.fi) -- dieselben Woerter, damit es genau einen
// Satz Befehle gibt und nicht zwei.
static mut pw_cmd: [u8; 13] = "/run/svc.cmd\0"
static mut pw_down: [u8; 10] = "shutdown\n\0"
static mut pw_boot: [u8; 8] = "reboot\n\0"

// Die Schluessel des Katalogs. Der Menuetext ist EINE ZEILE JE EINTRAG
// (`\n` im Katalog); `wlib.menu_open` schneidet daran.
static mut k_pmenu: [u8; 11] = "power.menu\0"
static mut k_ptitel: [u8; 12] = "power.title\0"
static mut k_pitem: [u8; 11] = "power.item\0"
static mut k_offt: [u8; 21] = "power.ask.off.title\0\0"
static mut k_offq: [u8; 15] = "power.ask.off\0\0"
static mut k_rebt: [u8; 24] = "power.ask.reboot.title\0\0"
static mut k_rebq: [u8; 18] = "power.ask.reboot\0\0"
static mut k_boff: [u8; 15] = "power.btn.off\0\0"
static mut k_breb: [u8; 18] = "power.btn.reboot\0\0"
static mut k_bcan: [u8; 18] = "power.btn.cancel\0\0"

// WIE VIELE EINTRAEGE DAS MENUE HAT. Diese Zahl und der Katalog muessen
// zusammenpassen: `menu_open` bekommt sie von aussen, und wer hier eine
// Zeile ergaenzt, ohne die Zahl zu erhoehen, bekommt ein Menue, das
// seinen letzten Eintrag verschweigt (genau der Fehler, der in Runde
// LOOK an 11-menue-gehezu.png gemessen wurde: drei von sechs).
const POWER_N: u64 = 3
const PW_AUS: u64 = 0
const PW_NEU: u64 = 1
const PW_AB: u64 = 2

// Was die Rueckfrage gerade fragt: 0 keine, 1 ausschalten, 2 neustart.
static mut pw_block: [u8; 64] = [0 as u8; 64]
static mut pw_frage: u64 = 0
// Ist das Energiemenue offen? (Das Menue gehoert `wlib`, aber nur
// dieses Programm weiss, dass ES das aufgemacht hat -- das Startmenue
// hat auch ein Kontextmenue-freies Leben.)
static mut pw_menue: u64 = 0

static mut s_pmauf: [u8; 24] = "launcher: energie auf\0\0\0"
static mut s_pmwahl: [u8; 25] = "launcher: energie wahl=\0\0"
static mut s_pmfrage: [u8; 26] = "launcher: energie frage=\0\0"
static mut s_pmtat: [u8; 24] = "launcher: energie tat \0\0"
static mut s_pmab: [u8; 26] = "launcher: energie abbruch\0"
static mut s_pmerr: [u8; 30] = "launcher: energie FEHLER cmd\0\0"

// DIE ZEILE AN init. `577` ist O_WRONLY|O_CREAT|O_TRUNC -- dieselben
// Zahlen wie in shutdown.fi; was vorher in der Datei stand, ist
// erledigt oder verworfen.
//
// Kehrt `false` zurueck, wenn die Datei nicht schreibbar ist. Das ist
// KEIN theoretischer Fall: laeuft kein init (der Notweg `initsh`
// startet die Shell unmittelbar), gibt es /run/svc.cmd gar nicht.
// Dann sagt es der Aufrufer dem Menschen, statt stumm nichts zu tun --
// Pflichtpunkt 8.
fn pw_sag(was: u64) -> bool {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&pw_cmd[0 as usize]) as u64,
        577, 0)
    if ulib.bad(fd) {
        return false
    }
    ulib.sys(ulib.SYS_WRITE, fd, was, ulib.length(was))
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return true
}

// ABMELDEN, SOLANGE ES KEINE ANMELDUNG GIBT.
//
// Der Schreibtisch wird neu gestartet: alles, was der Mensch offen
// hatte, ist danach zu, und er steht wieder vor einem frischen
// Schreibtisch. Das ist das, was von "abmelden" ohne Sitzungsverwaltung
// uebrig bleibt, und es wird hier auch so GENANNT statt als
// Sitzungsende ausgegeben.
//
// Zweig `anmeldung` (Lauf 2 dieser Umsteige-Runde) baut die echte
// Anmeldung. Sobald sie da ist, gehoert hier der Weg ueber sie hinein
// und nicht dieser Neustart -- eine Zeile, und die Stelle ist diese.
static mut pw_desk: [u8; 13] = "/bin/desktop\0"

fn pw_abmelden() -> bool {
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&pw_desk[0 as usize]) as u64,
        0, 0)
    return !ulib.bad(pid)
}


// DAS MENUE AUFKLAPPEN. Es geht am Energieknopf auf und klappt nach
// OBEN -- unter dem Knopf ist die Leiste, und dort ist nie Platz;
// `wlib.menu_open` dreht von selbst um, sobald es unten nicht passt.
//
// Der TITEL kommt aus dem Katalog: `wlib` traegt seinen eigenen
// englischen Ersatztext ("Menu"), weil die Bibliothek in dreizehn
// Programmen steckt und keinen Katalog laden darf (siehe den Kopf von
// `menu_open`). Ein Programm, das einen hat, reicht ihn mit
// `set_menu_title` hinunter -- genau dafuer gibt es die Funktion.
fn pw_menue_auf(mx: u64, my: u64) {
    if pw_menue != 0 {
        return
    }
    wlib.set_menu_title(msg.get((&k_ptitel[0 as usize]) as u64))
    let mw: u64 = wlib.menu_open(0, mx, my,
        msg.get((&k_pmenu[0 as usize]) as u64), POWER_N)
    if mw >= wlib.MAXWN {
        return
    }
    pw_menue = 1
    say((&s_pmauf[0 as usize]) as u64)
    nl()
}

// DIE RUECKFRAGE. Ausschalten und Neustart sind nicht umkehrbar -- wer
// sie aus Versehen trifft, verliert, was offen war. Also fragt das
// System nach, und zwar mit dem GEFAEHRLICHEN Wort auf dem Knopf
// ("Ausschalten") statt mit "OK": ein Knopf soll sagen, was er tut.
//
// TASTATUR: `wlib` fuehrt in einem Dialog Tabulator, Eingabe und
// Flucht (wlib.fi, `on_key` -> `dlg_*`). Eingabe loest den Knopf aus,
// auf dem der Fokus steht, Flucht bricht ab (EV_CLOSE -> dl_state 3).
// Diese Runde musste dafuer nichts bauen; sie musste es nur BENUTZEN
// und danach messen, dass es wirklich so ist.
fn pw_frage_auf(was: u64) {
    if pw_frage != 0 {
        return
    }
    var titel: u64 = msg.get((&k_offt[0 as usize]) as u64)
    var text: u64 = msg.get((&k_offq[0 as usize]) as u64)
    var ja: u64 = msg.get((&k_boff[0 as usize]) as u64)
    if was == 2 {
        titel = msg.get((&k_rebt[0 as usize]) as u64)
        text = msg.get((&k_rebq[0 as usize]) as u64)
        ja = msg.get((&k_breb[0 as usize]) as u64)
    }
    // Die beiden Beschriftungen als EIN Block mit Zeilenenden --
    // `wlib.dlg_wahl` liest ihn mit `row_at`, genau wie das Menue.
    // Der ABBRUCH steht LINKS und die Tat rechts; `dlg_wahl` legt den
    // Fokus auf den ersten Knopf, und der erste soll der harmlose sein.
    let cancel: u64 = msg.get((&k_bcan[0 as usize]) as u64)
    let bp: u64 = (&pw_block[0 as usize]) as u64
    var p: u64 = 0
    p = p + ulib.strncpy(bp + p, cancel, 30)
    __mmio_write8((bp + p) as *mut u8, 10 as u8)
    p = p + 1
    p = p + ulib.strncpy(bp + p, ja, 30)
    __mmio_write8((bp + p) as *mut u8, 0 as u8)
    // Der Block muss den Aufruf UEBERLEBEN: `dlg_wahl` kopiert die
    // Beschriftungen zwar in seinen eigenen Puffer (dw_buf), aber der
    // Titel und die Frage bleiben Zeiger -- und die zeigen in den
    // Katalog, der fest liegt. Der Block hier liegt deshalb ebenfalls
    // statisch und nicht im Rahmen dieser Funktion.
    let dw: u64 = wlib.dlg_wahl(titel, text,
        (&pw_block[0 as usize]) as u64, 2)
    if dw >= wlib.MAXWN {
        return
    }
    pw_frage = was
    say((&s_pmfrage[0 as usize]) as u64)
    sayn(was)
    nl()
}

// DIE TAT. Erst hier verlaesst etwas dieses Programm.
fn pw_tun(was: u64) {
    var ok: bool = false
    if was == 1 {
        ok = pw_sag((&pw_down[0 as usize]) as u64)
    } else if was == 2 {
        ok = pw_sag((&pw_boot[0 as usize]) as u64)
    }
    say((&s_pmtat[0 as usize]) as u64)
    sayn(was)
    nl()
    if !ok {
        // LAEUFT KEIN init, GIBT ES /run/svc.cmd NICHT -- und dann
        // darf das nicht stumm bleiben. Der Mensch hat einen Knopf
        // gedrueckt; er muss erfahren, dass nichts geschah.
        say((&s_pmerr[0 as usize]) as u64)
        nl()
        let _d: u64 = wlib.dlg_hinweis(
            msg.get((&k_ptitel[0 as usize]) as u64),
            msg.get((&k_offt[0 as usize]) as u64))
    }
}

fn u_start(args: u64) -> u64 {
    dbg_setup(args)
    var s_no: [u8; 8] = "nohit\0\0\0"
    var s_nc: [u8; 8] = "noclip\0\0"
    var s_nk: [u8; 8] = "nokeys\0\0"
    var s_ni: [u8; 8] = "noidx\0\0\0"
    // RUNDE ECHTHARDWARE-4: `versteckt` -- der Starter legt sein
    // Fenster an, malt es einmal und MINIMIERT es sofort.
    var s_vs: [u8; 11] = "versteckt\0\0"
    var versteckt: bool = false
    var s_bad: [u8; 25] = "launcher: keine Flaeche\0\0"
    var s_n: [u8; 21] = "launcher: apps=\0\0\0\0\0\0"
    var s_go: [u8; 21] = "launcher: ready\0\0\0\0\0\0"
    // Die Zeile, an der die Abnahme sieht, dass der Starter WIRKLICH
    // unsichtbar hochgekommen ist -- ein Bild allein koennte auch
    // heissen, dass er gar nicht erst startete.
    var s_vers: [u8; 21] = "launcher: versteckt\0\0"
    var s_geo: [u8; 21] = "launcher: geom \0\0\0\0\0\0"
    var sx: [u8; 4] = "x=\0\0"
    var sy: [u8; 4] = "y=\0\0"
    var sw: [u8; 4] = "w=\0\0"
    var sh: [u8; 4] = "h=\0\0"
    var s_vor: [u8; 25] = "launcher: vorgabe [\0\0\0\0\0\0"
    var s_zu: [u8; 4] = "]\0\0\0"

    // RUNDE I18N: DER KATALOG ZUERST. Er muss stehen, bevor das erste
    // Bedienelement angelegt wird -- `wlib` BEHAELT den Zeiger auf
    // seinen Text, und ein Zeiger auf einen Platz, den es noch nicht
    // gibt, ist ein Zeiger auf nichts.
    let _mk: u64 = msg.init()
    var nohit: bool = false
    var noclip: bool = false
    var nokeys: bool = false
    var vorgabe: u64 = 0
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        let p: u64 = ulib.arg_at(args, a)
        if ulib.streq(p, (&s_no[0 as usize]) as u64) {
            nohit = true
        } else if ulib.streq(p, (&s_nc[0 as usize]) as u64) {
            noclip = true
        } else if ulib.streq(p, (&s_nk[0 as usize]) as u64) {
            nokeys = true
        } else if ulib.streq(p, (&s_vs[0 as usize]) as u64) {
            // RUNDE ECHTHARDWARE-4: MIT DIESEM WORT KOMMT DER STARTER
            // UNSICHTBAR HOCH. Siehe der Block bei `wlib.win_hide`
            // weiter unten -- das ist der Normalfall beim Systemstart.
            versteckt = true
        } else if ulib.streq(p, (&s_ni[0 as usize]) as u64) {
            // GEGENPROBE: derselbe Starter ohne Namensindex. Dann findet
            // "blau" das Programm nicht (es heisst nicht so) und die
            // Datei auch nicht (es gibt keinen Index), also nichts.
            ohne_index = true
        } else {
            // Alles andere ist ein Suchbegriff. So laesst sich die Suche
            // auch OHNE Tastatur messen -- und mit Tastatur sowieso.
            vorgabe = p
        }
        a = a + 1
    }
    if !wlib.begin(nohit, noclip) {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    let n: u64 = appdir.load((&t_dir[0 as usize]) as u64, nokeys)
    say((&s_n[0 as usize]) as u64)
    sayn(n)
    nl()
    // DER NAMENSINDEX. Einmal gebaut, danach im Speicher -- und die Zeit
    // dafuer steht auf der seriellen Leitung, damit sie niemand raten
    // muss.
    var s_ix: [u8; 21] = "launcher: index n=\0\0\0"
    var s_us: [u8; 8] = "  us=\0\0\0"
    if !ohne_index {
        let t0: u64 = nidx.mono_us()
        idxn = nidx.build()
        idxus = nidx.mono_us() -% t0
    }
    say((&s_ix[0 as usize]) as u64)
    sayn(idxn)
    say((&s_us[0 as usize]) as u64)
    sayn(idxus)
    nl()
    var s_titel: [u8; 25] = "launcher: name [\0\0\0\0\0\0\0\0\0"
    var s_end: [u8; 4] = "]\0\0\0"
    var k3: u64 = 0
    while k3 < n {
        if ulib.streq(appdir.exec_of(k3), (&t_selbst[0 as usize]) as u64) {
            ulib.strncpy((&t_titel[0 as usize]) as u64,
                appdir.name_of(k3), 62)
            k3 = n
        } else {
            k3 = k3 + 1
        }
    }
    if (t_titel[0 as usize]) == 0 as u8 {
        ulib.strncpy((&t_titel[0 as usize]) as u64, ulib.arg_at(args, 0),
            62)
    }
    say((&s_titel[0 as usize]) as u64)
    say((&t_titel[0 as usize]) as u64)
    say((&s_end[0 as usize]) as u64)
    nl()
    if vorgabe != 0 {
        ulib.strncpy((&suchfeld[0 as usize]) as u64, vorgabe, 62)
        say((&s_vor[0 as usize]) as u64)
        say((&suchfeld[0 as usize]) as u64)
        say((&s_zu[0 as usize]) as u64)
        nl()
    }

    // ===================================================== RUNDE ECHTHARDWARE-1
    //
    // 440 MAL 300 WAREN BILDPUNKTE UND SIND JETZT EIN VERHAELTNIS.
    //
    // Justins Foto vom 09.09. zeigt den Knopf unten rechts als
    // "Ausfuehre" -- rechts abgeschnitten. Die Ursache ist dieselbe wie
    // beim Kontrollzentrum: sein Monitor laeuft mit
    // `wlibc.ui_scale() == 2`, die Schrift ist damit 30 statt 15
    // Bildpunkte hoch, und dieses Fenster war 440 Bildpunkte breit --
    // eine Zahl, die bei Schrifthoehe 15 gewaehlt wurde. Der Kasten
    // fuer den Knopf war zusaetzlich mit `118 x 30` und `size(110, 28)`
    // festgenagelt; "Ausfuehren" braucht bei 30er Schrift deutlich mehr
    // als 110 Bildpunkte, und `wlib` schneidet, was nicht passt.
    //
    // Ab hier haengt jedes Mass an der Vervielfachung, und der Knopf
    // bekommt gar keine feste Breite mehr: `wlib.button` rechnet sich
    // aus Textbreite plus Polsterung selbst aus, wie breit er sein
    // muss. Ein Knopf, dem man seine Breite vorschreibt, ist ein Knopf,
    // der in der naechsten Sprache wieder abgeschnitten ist.
    let sk: u64 = wlibc.ui_scale()
    let bw: u64 = 440 * sk
    // ================================================ RUNDE FUI-WIN11
    // DIE HOEHE FOLGT DER LISTE UND IST KEINE FESTE ZAHL MEHR.
    //
    // Die Treffer stehen ab dieser Runde ZWEIZEILIG (Name oben,
    // Beschreibung darunter) -- eine Zeile ist damit rund doppelt so
    // hoch wie vorher. Bliebe `bh` bei 300, passten statt sieben
    // Treffern nur noch drei ins selbe Feld, und der Rest waere stumm
    // abgeschnitten.
    //
    // Also wird gerechnet, was wirklich hineinmuss: das Suchfeld
    // (82), die Liste, und die Knopfzeile darunter (56). Die
    // Zeilenhoehe ist dieselbe Rechnung wie in `wlib.row_h_of` --
    // zwei Textzeilen plus die Luft, die eine einzeilige Zeile hat.
    let zh1: u64 = wlibc.metric(wlibc.M_ROW)
    let th1: u64 = wlibc.text_h(wlibc.px_ui())
    var zh2: u64 = 2 * zh1
    if zh1 > th1 {
        zh2 = 2 * th1 + (zh1 - th1)
    }
    let lh: u64 = LIST_ROWS * zh2 + 4
    let bh: u64 = 82 * sk + lh + 56 * sk
    // ============================================== RUNDE STARTKNOPF
    // KEIN FENSTER MIT TITELLEISTE, SONDERN EIN FELD AN DER LEISTE.
    //
    // Justins Hauptkritik am Starter: er ist ein Fenster mit Rahmen und
    // rotem Kreuz, taucht in der Fensterliste auf und steht irgendwo im
    // Bild. Ein Startmenue ist nichts davon -- es geht ueber dem
    // Schreibtisch auf, unten an der Leiste verankert, und ist wieder
    // weg, wenn man daneben klickt.
    //
    // STUFE 1 dieser Runde: kein Schmuck, oberste Ebene, VERANKERT AN
    // DER ECHTEN LAGE DES STARTKNOPFES -- und die kommt nicht aus einer
    // festen Zahl, sondern aus der Ausrichtung der Leiste
    // (`/etc/taskbar.conf`, `align=`). Steht die Leiste links, geht das
    // Menue unten links bündig auf; steht sie mittig, waagerecht
    // mittig ueber dem Startknopf. Dieselbe Datei, dieselbe Regel --
    // eine zweite Stelle, die entscheidet, wo der Startknopf ist, waere
    // die zweite Wahrheit darueber.
    //
    // Die Arbeitsflaeche (`work_*`) und nicht der Schirm ist der
    // Rahmen: unter der Leiste (und unter dem reservierten Band der
    // Messtafel) hat das Menue nichts verloren.
    conf_read()
    let anker: u64 = anker_x(bw)
    let ay: u64 = anker_y(bh)
    // RUNDE ECHTHARDWARE-3: das Startmenue liegt auf SEINER eigenen
    // Ebene -- ueber der Taskleiste (sonst deckt die Leiste es zu),
    // aber UNTER Klappmenues und Blasen.
    let w: u64 = wlib.window_plain(anker, ay, bw, bh,
        (&t_titel[0 as usize]) as u64, wlibc.L_MENUE)
    // RUNDE PAINT: welchem Buendel dieses Fenster gehoert --
    // damit die Taskleiste sein Symbol findet.
    var a_app: [u8; 9] = "launcher\0"
    g_win = w
    let _ap: u64 = wlib.window_app(w, (&a_app[0 as usize]) as u64)
    // ============================================ RUNDE MERGE-11: R5
    // JETZT erst steht das Fenster, und JETZT beantwortet der
    // Fensterserver die Frage nach der Arbeitsflaeche. Sie ist die
    // bessere Quelle als jede eigene Rechnung: dort ist JEDE
    // Reservierung abgezogen, nicht nur die der Leiste (auch das
    // reservierte Band der Messtafel oben).
    an_arbeitsflaeche(w, bw, bh)
    // ===================================================== RUNDE ECHTHARDWARE-1
    //
    // "ICH WILL DIE TASTATUR" -- UND OHNE DIESE ZEILE KAM NIE EINE AN.
    //
    // Justins Befund vom 09.09.: im Startmenue laesst sich nichts
    // tippen, das Suchfeld bleibt leer, obwohl die Tastatur erkannt
    // ist (TAS 23 FAIL 0) und der Kern jede Taste meldet (`key: e`).
    // Zwischen Kern und Feld liegt genau eine Regel:
    //
    //   wm.on_mouse:  if wg(state, i, W_LAYER) == L_NORMAL {
    //                     set_focus(state, i)   }
    //
    // Dieses Fenster liegt auf L_TOP -- es MUSS dort liegen, sonst
    // verschwindet das Menue hinter Fenstern. Damit war es aber von
    // jedem Fokus ausgeschlossen, und `wm.on_key` gibt die Taste nur
    // an den Fokus. Die Tasten kamen also bis in den Fensterserver und
    // fielen dort auf den Boden.
    //
    // Die Regel bleibt richtig (eine Taskleiste, die den Fokus zieht,
    // macht jeden Tastendruck danach wirkungslos) -- also sagt dieses
    // Fenster ausdruecklich, dass es eine Ausnahme ist.
    let _k: u64 = wlib.win_keys(w, true)
    if w >= wlib.MAXWN {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    // ===================================================== RUNDE TUERSCHLOSS
    //
    // HIER STANDEN `bx` UND `by`, UND DAS WAREN DIE FALSCHEN ZAHLEN.
    //
    // `bx=190 by=110` sind seit Runde STARTKNOPF tot: das Fenster wird
    // eine Handvoll Zeilen darueber mit `anker_x(bw)` / `anker_y(bh)`
    // angelegt, weil das Menue an der Leiste haengt und nicht in der
    // Bildmitte. Die MELDUNG hat weiter die alten Festwerte gesagt.
    //
    // Das ist keine Schoenheitsfrage, sondern eine falsche Messung: wer
    // sich auf diese Zeile verlaesst, um einen Eintrag anzuklicken --
    // ein Testlaeufer, ein Mensch mit einem Skript --, klickt 340
    // Bildpunkte daneben ins Leere und misst danach "der Start geht
    // nicht". Genau das ist in dieser Runde zweimal passiert, bevor die
    // echte Lage aus den Fensterberichten des Servers kam (id=11 und
    // id=12 bei x=8 y=452, waehrend hier x=190 y=110 stand).
    //
    // Eine Meldung ueber eine Lage, die das Programm selbst nicht
    // benutzt, ist schlimmer als keine.
    say((&s_geo[0 as usize]) as u64)
    kv((&sx[0 as usize]) as u64, anker)
    kv((&sy[0 as usize]) as u64, ay)
    kv((&sw[0 as usize]) as u64, bw)
    kv((&sh[0 as usize]) as u64, bh)
    nl()

    wlib.box_v(w, 0, 0, bw, 84 * sk, 12 * sk, 8 * sk)
    let lb: u64 = wlib.label(msg.get((&k_prompt[0 as usize]) as u64))
    wlib.size(0, 26 * sk)
    let fe: u64 = wlib.entry((&suchfeld[0 as usize]) as u64, 62)
    wlib.box_end()

    // RUNDE FUI-WIN11: der Kasten ist so hoch wie die Liste, die
    // hineinkommt -- dieselbe Rechnung wie oben bei `bh`.
    wlib.box_v(w, 12 * sk, 82 * sk, bw - 24 * sk, lh + 4 * sk, 0, 0)
    wlib.size(0, lh)
    let ls: u64 = wlib.list((&liste[0 as usize]) as u64, LIST_ROWS)
    // ============================================== RUNDE STARTKNOPF
    // EIN KLICK GENUEGT.
    //
    // Justin klickt einen Eintrag an, und nichts geschieht. Die
    // Trefferflaeche stimmt und die Auswahl WIRD gesetzt -- eine Liste
    // loeste bis hierher nur beim DOPPELKLICK aus (`wlib.fi`,
    // `s_lastclick`). Fuer einen Dateimanager ist das richtig: dort
    // waehlt man oft und oeffnet selten. Fuer ein STARTMENUE ist es
    // falsch, denn dort ist der einzige Zweck eines Klicks, das
    // Programm zu starten -- und kein System der Welt verlangt dafuer
    // zwei Klicks.
    //
    // Die Regel haengt deshalb an DIESER Liste und nicht in der
    // Bibliothek; der Explorer behaelt seinen Doppelklick.
    wlib.list_einklick(ls, true)
    // ============================================== RUNDE FUI-WIN11
    // ZWEI ZEILEN JE TREFFER: NAME OBEN, BESCHREIBUNG DARUNTER.
    //
    // Justins Kritik: die Beschreibung stand in DERSELBEN Zeile hinter
    // "--". Windows setzt den Namen in Zeile 1 und die Beschreibung
    // gedaempft in Zeile 2; genau das macht die Liste jetzt. Der
    // Schnitt ist der Tabulator, den `new_find` setzt.
    //
    // ES GILT NUR FUER DIESE LISTE. `wlib.list` wird von sechs
    // Programmen benutzt; die Zeilenhoehe der anderen bleibt, wie sie
    // war (`list_zwei` ist abwaehlbar und standardmaessig aus).
    wlib.list_zwei(ls, true)
    wlib.box_end()

    // DER KNOPF BEKOMMT KEINE FESTE BREITE MEHR -- er misst sich
    // selbst. Der Kasten ist so breit wie der Inhalt des Fensters und
    // rechtsbuendig; damit steht der Knopf rechts unten und ist in
    // JEDER Sprache und bei jeder Vervielfachung ganz zu lesen.
    // DER KNOPF MISST SICH SELBST, UND DER KASTEN IST GENAU SO
    // BREIT WIE ER.
    //
    // Der erste Versuch dieser Runde stellte ein leeres Schild mit
    // Wunschbreite 0 davor, damit es "den Rest nimmt". Das ist genau
    // falsch herum: `wlib.add` liest eine Wunschbreite von 0 als
    // "nimm deine NATUERLICHE Breite" (Zeile 1497), und die eines
    // leeren Schildes ist null. Gemessen hat das ein schwarzes Band
    // ueber die ganze Fensterbreite ergeben -- ein Kasten, in dem
    // nichts steht, wird nicht uebermalt.
    //
    // Also andersherum und ohne jede Wette: die Breite des Knopfes
    // wird AUSGERECHNET (Text + zweimal Polsterung, dieselbe Rechnung
    // wie in `wlib.button`), und der Kasten bekommt genau diese
    // Breite, rechtsbuendig gesetzt. Nichts bleibt leer, nichts wird
    // geraten, und in einer anderen Sprache wird der Knopf einfach
    // breiter.
    let kh: u64 = wlibc.metric(wlibc.M_CTRL_H)
    let ktxt: u64 = msg.get((&k_run[0 as usize]) as u64)
    let kbr: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), ktxt,
        ulib.length(ktxt)) + 2 * wlibc.metric(wlibc.M_PAD_X)
    let ky: u64 = bh - kh - 12 * sk
    var kx: u64 = 12 * sk
    if bw > kbr + 12 * sk {
        kx = bw - kbr - 12 * sk
    }
    wlib.box_h(w, kx, ky, kbr, kh, 0, 0)
    let bt: u64 = wlib.button(ktxt)
    wlib.box_end()

    // ================================================ RUNDE ENERGIE
    // DER ENERGIEKNOPF, UNTEN LINKS.
    //
    // Er steht in DERSELBEN Zeile wie "Ausfuehren" und am anderen Ende
    // -- links unten, wo ihn Windows, Zorin und GNOME haben. Die
    // Rechnung ist dieselbe wie beim Knopf rechts und aus demselben
    // Grund (Runde ECHTHARDWARE-1): der Knopf MISST SICH SELBST aus
    // Text plus Polsterung. Eine feste Breite waere in der naechsten
    // Sprache wieder abgeschnitten -- "Ausschalten" ist laenger als
    // "Power", und bei `uiscale=2` ist alles doppelt so breit.
    //
    // Warum ein KNOPF und kein Symbol: dieses System hat eine
    // Symbolschrift (`wlib.draw_icon`), aber ein Symbol ohne Text ist
    // genau die Sorte Raterei, die Justin am Kontrollzentrum kritisiert
    // hat. Der Text sagt, was geschieht.
    let ptxt: u64 = msg.get((&k_pitem[0 as usize]) as u64)
    let pbr: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), ptxt,
        ulib.length(ptxt)) + 2 * wlibc.metric(wlibc.M_PAD_X)
    wlib.box_h(w, 12 * sk, ky, pbr, kh, 0, 0)
    let pb: u64 = wlib.button(ptxt)
    wlib.box_end()

    wlib.set_focus(fe)
    new_find(ls)
    wlib.draw_all()
    say_rects(lb, fe, ls, bt)
    // ============================================ RUNDE ECHTHARDWARE-4
    // DER SCHREIBTISCH IST LEER, BIS JEMAND SUPER DRUECKT.
    //
    // Justin an ALLEN 44 Bildern aus ECHTHARDWARE-3: "Search programs"
    // klebt unten links am Schreibtisch, auf jedem einzelnen Bild, in
    // hell wie dunkel, bei 1280 wie bei 2560. Er will es wie bei
    // Windows: unsichtbar, bis die Super-Taste kommt oder das Logo
    // angeklickt wird.
    //
    // DIE URSACHE WAR DER SYSTEMSTART UND NICHT DIESES FENSTER.
    // `kgui.desk_start` startet `/bin/launcher` mit, damit das Menue
    // beim ersten Super-Druck SOFORT da ist (ein Programmstart kostet
    // sonst eine knappe Sekunde, und ein Startmenue, das erst denkt,
    // fuehlt sich kaputt an). Das ist richtig -- nur darf das Fenster
    // dann nicht SICHTBAR herumstehen.
    //
    // ALSO: anlegen, EINMAL malen (damit alle Masse, Rechtecke und
    // Meldungen stehen, an denen die Abnahme misst), und sofort
    // minimieren. `WA_TOGGLE` aus der Leiste holt es danach in
    // Nullzeit zurueck -- derselbe Weg, den der zweite Super-Druck
    // schon immer genommen hat.
    //
    // Ohne `versteckt` aendert sich nichts: wer den Starter von Hand
    // aufruft, will ihn sehen.
    if versteckt {
        let _vh: u64 = wlib.win_hide(w, true)
        g_offen = false
        say((&s_vers[0 as usize]) as u64)
        nl()
    } else {
        g_offen = true
    }
    say((&s_go[0 as usize]) as u64)
    nl()

    var vorher: u64 = ulib.length((&suchfeld[0 as usize]) as u64)
    var runden: u64 = 0
    while wlib.alive() && runden < 4000000 {
        runden = runden + 1
        let id: u64 = wlib.step()
        if id < wlib.MAXWD {
            let kind: u64 = wlib.fired_kind()
            let idx: u64 = wlib.fired_index()
            if kind == wlib.K_ENTRY && id == fe {
                starten(wlib.value(ls))
            } else if kind == wlib.K_LIST && id == ls {
                starten(idx)
            } else if kind == wlib.K_BUTTON && id == bt {
                starten(wlib.value(ls))
            } else if kind == wlib.K_BUTTON && id == pb {
                // ============================ RUNDE ENERGIE
                // Der Knopf klappt das Menue auf -- ueber sich
                // selbst, nicht am Mauszeiger. Ein Menue, das am
                // Zeiger aufgeht, steht bei Tastaturbedienung
                // irgendwo; der Knopf steht immer da, wo er steht.
                //
                // `menu_open` rechnet die Bildschirmlage selbst um,
                // wenn unten kein Platz ist -- und unter diesem
                // Knopf ist die Leiste, also klappt es nach oben.
                pw_menue_auf(anker + 12 * sk, ay + ky)
            } else if kind == wlib.K_MENUBAR && pw_menue != 0 {
                // DIE WAHL AUS DEM ENERGIEMENUE. `wlib.step` legt
                // das Ergebnis eines Menues als K_MENUBAR-Ereignis
                // auf den Besitzer (wlib.fi, am Ende von `step`) --
                // `idx` ist der Eintrag, `0xFFFF` waere Abbruch,
                // aber den filtert wlib schon vorher heraus.
                pw_menue = 0
                say((&s_pmwahl[0 as usize]) as u64)
                sayn(idx)
                nl()
                if idx == PW_AUS {
                    pw_frage_auf(1)
                } else if idx == PW_NEU {
                    pw_frage_auf(2)
                } else if idx == PW_AB {
                    // ABMELDEN FRAGT NICHT NACH. Es ist der einzige
                    // der drei Punkte, der nichts Unwiederbringliches
                    // tut -- der Schreibtisch kommt sofort zurueck.
                    let _ab: bool = pw_abmelden()
                    zumachen()
                }
            }
        }
        // ==================================================== RUNDE ENERGIE
        // DIE ANTWORT DER RUECKFRAGE, EINMAL JE UMLAUF ABGEHOLT.
        //
        // `dlg_state` ist 1, solange sie offen ist, 2 nach einem
        // Knopf und 3 nach Flucht/Kreuz. Welcher Knopf es war, sagt
        // `dlg_wahl_at` -- 0 ist der erste, und der erste ist hier
        // ABBRECHEN (siehe `pw_frage_auf`).
        //
        // WARUM DAS HIER STEHT UND NICHT IM `if id < MAXWD` DARUEBER:
        // die Knoepfe eines Dialogs feuern zwar, aber `wlib.step`
        // FAENGT ihr Feuern ab und verwandelt es in `dl_state`
        // (wlib.fi, "Der Dialog: die beiden Knoepfe sind seine
        // Antwort") -- beim Aufrufer kommt kein Ereignis an. Wer hier
        // auf ein Ereignis wartet, wartet fuer immer.
        if pw_frage != 0 {
            let ds: u64 = wlib.dlg_state()
            if ds == 2 {
                let welcher: u64 = wlib.dlg_wahl_at()
                let was: u64 = pw_frage
                pw_frage = 0
                wlib.dlg_close()
                if welcher == 1 {
                    pw_tun(was)
                } else {
                    say((&s_pmab[0 as usize]) as u64)
                    nl()
                }
            } else if ds == 3 {
                // FLUCHT ODER KREUZ: nichts geschieht, und das wird
                // gesagt. Ein Abbruch, der stumm ist, sieht aus wie
                // ein Knopf, der nicht reagiert hat.
                pw_frage = 0
                wlib.dlg_close()
                say((&s_pmab[0 as usize]) as u64)
                nl()
            }
        }
        // ============================================ RUNDE STARTKNOPF
        // ESCAPE SCHLIESST DAS MENUE.
        //
        // Ein Feld ohne Titelleiste hat kein Kreuz -- also braucht es
        // einen anderen Weg hinaus, und der ist auf jedem System
        // derselbe. (Der zweite Druck auf Super geht ueber die
        // Taskleiste; die kennt das Fenster und schaltet es um.)
        // ======================================== RUNDE ECHTHARDWARE-4
        // ESCAPE SCHLIESST, ES BEENDET NICHT.
        //
        // Hier stand `return 0` -- der Starter war danach WEG, und der
        // naechste Super-Druck musste ihn neu starten (`SYS_EXEC` in
        // `taskbar.startmenue_um`, weil `launcher_fenster()` nichts
        // mehr findet). Das kostet nicht nur Zeit; es ist auch der
        // Grund, warum sich in frueheren Runden Starter gestapelt
        // haben.
        //
        // Ein Startmenue ist ein Fenster, das man ZUMACHT. Also wird
        // es minimiert und die Schleife laeuft weiter -- genau der
        // Zustand, den `versteckt` beim Systemstart herstellt.
        // ==================================== RUNDE ECHTHARDWARE-4
        // EINE TASTE ZAEHLT EINMAL, NICHT IN JEDER RUNDE.
        //
        // GEMESSEN an menue-2560/serial.txt: das Menue ging per Super
        // auf und mit Escape zu -- richtig. Beim NAECHSTEN Aufmachen
        // (Klick aufs Logo) war es sofort wieder zu, ohne dass jemand
        // etwas gedrueckt haette. `key_last()` ist die ZULETZT
        // gedrueckte Taste und bleibt es fuer immer; die Bedingung
        // hier war also ab dem ersten Escape in JEDER Schleifenrunde
        // wahr. wlib fuehrt fuer genau diesen Fall einen Zaehler
        // (`key_seq`, siehe die Anmerkung dort: "zweimal Entf ist
        // zweimal dieselbe Zahl").
        // ==================================================== RUNDE ENERGIE
        // SOLANGE MENUE ODER RUECKFRAGE OFFEN SIND, GEHOERT DIE
        // FLUCHTTASTE IHNEN UND NICHT DEM STARTMENUE.
        //
        // Sonst waere die Reihenfolge falsch herum: Escape im
        // Ausschalt-Dialog haette das GANZE Startmenue zugemacht und
        // den Dialog als verwaistes Fenster stehen lassen. `wlib`
        // fuehrt die Flucht im Dialog selbst (dl_state 3), und das
        // Ergebnis holt der Block oben ab -- hier muss sie nur
        // durchgelassen werden.
        let ks: u64 = wlib.key_seq()
        if ks != g_kseq && wlib.key_last() == wlib.KEY_ESC
            && pw_frage == 0 && pw_menue == 0 {
            g_kseq = ks
            zumachen()
            // Das Suchfeld wird geleert: wer das Menue neu aufmacht,
            // faengt bei der vollen Liste an und nicht bei der
            // Trefferliste von vorhin.
            suchfeld[0 as usize] = 0 as u8
            wlib.set_text(fe, (&suchfeld[0 as usize]) as u64)
            vorher = 0
            new_find(ls)
        }
        // WAEHREND MAN TIPPT wird die Liste kuerzer. Das Textfeld meldet
        // keinen Tastendruck (es meldet die Eingabetaste), also wird
        // hier nachgesehen, ob sich der Inhalt geaendert hat -- eine
        // Zeile, und sie ist der Unterschied zwischen einem Suchfeld und
        // einem Eingabefeld mit einem Knopf daneben.
        // ==================================== RUNDE ECHTHARDWARE-4
        // KLICK DANEBEN UND FOKUSVERLUST SCHLIESSEN EBENFALLS.
        //
        // Ein Klick auf ein fremdes Fenster kommt hier nie an -- er
        // geht an das fremde Fenster. Sichtbar ist nur die Folge:
        // der Eingabefokus ist woanders (`wlib.win_fokus`). Das ist
        // dieselbe Bedingung wie "Fokusverlust", also braucht es
        // dafuer auch nur diese eine Abfrage.
        //
        // `g_offen` muss dazu wissen, dass das Fenster GERADE offen
        // ist: waehrend es verborgen liegt, hat es selbstredend auch
        // keinen Fokus, und ohne diese Bedingung schriebe der Starter
        // dann in jeder Runde eine Zeile.
        g_kseq = ks
        let nun: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
        if g_offen && !wlib.win_fokus(w) {
            // Diagnose: WANN der Fokus wegging und ob die Gnadenfrist
            // noch lief. Ohne diese Zeile ist "das Menue ging von
            // selbst zu" nicht von "jemand hat daneben geklickt" zu
            // unterscheiden.
            var s_bl: [u8; 23] = "launcher: fokus weg t=\0"
            var s_bg: [u8; 9] = " gnade=\0\0"
            say((&s_bl[0 as usize]) as u64)
            sayn(nun)
            say((&s_bg[0 as usize]) as u64)
            sayn(g_gnade)
            nl()
        }
        // ==================================================== RUNDE ENERGIE
        // EIN EIGENES FENSTER DES PROGRAMMS IST KEIN "KLICK DANEBEN".
        //
        // Das Energiemenue und die Rueckfrage sind eigene Fenster und
        // ziehen den Fokus zwangslaeufig vom Startmenue ab. Ohne diese
        // Bedingung haette die Regel "Fokus weg heisst zu" das
        // Startmenue in dem Augenblick zugeklappt, in dem die
        // Rueckfrage aufging -- und die Frage stuende allein auf dem
        // Schreibtisch. Gemessen genau so, bevor diese zwei Worte
        // dazukamen.
        if g_offen && nun >= g_gnade && !wlib.win_fokus(w)
            && pw_frage == 0 && pw_menue == 0 {
            zumachen()
        }
        // Umgekehrt: die Leiste holt das Fenster mit WA_TOGGLE zurueck,
        // ohne dass dieses Programm davon erfaehrt. Der Fokus ist dann
        // wieder hier -- daran merkt es, dass es offen ist.
        if !g_offen && wlib.win_fokus(w) {
            g_offen = true
            g_gnade = nun + GNADE_TICKS
            // ==================================== RUNDE ECHTHARDWARE-5
            // BEIM AUFGEHEN: FARBEN NACHSEHEN, ALLES NEU MALEN,
            // UND DER CURSOR GEHOERT INS SUCHFELD.
            //
            // Justins Befund A: das Suchfenster steht im Dunkelmodus
            // WEISS da, und er kann darin nichts anklicken und nichts
            // tippen.
            //
            // OFFEN GESAGT: im Nachbau ist das nicht aufgetreten --
            // weder hell noch dunkel, weder beim Umschalten mit
            // offenem Menue noch beim Neuaufmachen danach; getippt,
            // gefiltert und gestartet wird jedes Mal (gemessen an
            // `launcher: suche [term] treffer=3` und `launcher: start
            // ... pid=7`). Was hier steht, behebt also nicht einen
            // gemessenen Fehler, sondern SCHLIESST DIE LUECKE, durch
            // die er entstehen KANN -- und die ist real:
            //
            // Das Fenster wird von der LEISTE mit `WA_TOGGLE` wieder
            // sichtbar gemacht. Dieses Programm erfaehrt davon nichts;
            // es merkt es erst hier, am Fokus. Zwischen dem Sichtbar-
            // werden und dem naechsten Anstrich liegt der alte Inhalt
            // auf dem Schirm -- mit den Farben, die beim letzten Malen
            // galten. Hat jemand in der Zwischenzeit das Thema
            // gewechselt, ist das genau das weisse Fenster im dunklen
            // Schreibtisch. `theme_now()` fragt SOFORT nach (statt auf
            // den 250-ms-Takt von `theme_watch` zu warten), `dirty_all`
            // sorgt fuer den vollen Anstrich.
            //
            // Und der Eingabefokus: ein Suchfeld, das aufgeht, muss
            // den Cursor haben. Ohne `set_focus` landet jede Taste bei
            // dem Bedienelement, das zuletzt dran war -- beim
            // Startknopf etwa, und dann tippt man ins Leere. Das ist
            // die zweite Haelfte von Justins Befund, und sie ist hier
            // beantwortet, egal woher der Zustand kam.
            let _tn: bool = wlib.theme_now()
            wlib.set_focus(fe)
            wlib.dirty_all(w)
            wlib.draw_all()
        }
        let jetzt: u64 = ulib.length((&suchfeld[0 as usize]) as u64)
        if jetzt != vorher {
            vorher = jetzt
            new_find(ls)
        }
    }
    return 0
}

fn say_rects(lb: u64, fe: u64, ls: u64, bt: u64) {
    say_rect(lb)
    say_rect(fe)
    say_rect(ls)
    say_rect(bt)
    var a: [u8; 21] = "launcher: rows \0\0\0\0\0\0"
    var sx: [u8; 4] = "x=\0\0"
    var sb: [u8; 8] = "base=\0\0\0"
    var sh: [u8; 4] = "zh=\0"
    var sf: [u8; 4] = "fg=\0"
    var sg: [u8; 4] = "bg=\0"
    var ss: [u8; 6] = "sel=\0\0"
    var sc: [u8; 8] = "selfg=\0\0"
    var si: [u8; 6] = "ix=\0\0\0"
    var sj: [u8; 6] = "iy=\0\0\0"
    say((&a[0 as usize]) as u64)
    kv((&sx[0 as usize]) as u64, wlib.row_x(ls))
    kv((&sb[0 as usize]) as u64, wlib.row_base(ls, 0))
    kv((&sh[0 as usize]) as u64, wlib.row_h())
    kv((&sf[0 as usize]) as u64, wlibc.theme(wlibc.T_FG))
    kv((&sg[0 as usize]) as u64, wlibc.theme(wlibc.T_ENTRY))
    kv((&ss[0 as usize]) as u64, wlibc.theme(wlibc.T_SEL))
    kv((&sc[0 as usize]) as u64, wlibc.theme(wlibc.T_SELFG))
    kv((&si[0 as usize]) as u64, wlib.icon_x(ls))
    kv((&sj[0 as usize]) as u64, wlib.icon_y(ls, 0))
    var sl: [u8; 6] = "lx=\0\0\0"
    var sm: [u8; 6] = "lb=\0\0\0"
    kv((&sl[0 as usize]) as u64,
        wlib.icon_letter_x(ls, appdir.name_of(0)))
    kv((&sm[0 as usize]) as u64, wlib.icon_letter_base(ls, 0))
    nl()
}

fn say_rect(i: u64) {
    var a: [u8; 21] = "launcher: rect \0\0\0\0\0\0"
    var si: [u8; 4] = "id=\0"
    var sk: [u8; 8] = "kind=\0\0\0"
    var sx: [u8; 4] = "x=\0\0"
    var sy: [u8; 4] = "y=\0\0"
    var sw: [u8; 4] = "w=\0\0"
    var sh: [u8; 4] = "h=\0\0"
    say((&a[0 as usize]) as u64)
    kv((&si[0 as usize]) as u64, i)
    kv((&sk[0 as usize]) as u64, wlib.kind_of(i))
    kv((&sx[0 as usize]) as u64, wlib.rect_x(i))
    kv((&sy[0 as usize]) as u64, wlib.rect_y(i))
    kv((&sw[0 as usize]) as u64, wlib.rect_w(i))
    kv((&sh[0 as usize]) as u64, wlib.rect_h(i))
    nl()
}

// RUNDE 31: das `main`, das nie laeuft -- `user.ld` setzt den Einsprung
// auf `u_start`. Das Profil `app` verlangt es trotzdem; es ruft
// `u_start`, damit es nicht luegt.
fn main() -> i32 {
    return u_start(0) as i32
}
