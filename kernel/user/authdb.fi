profile kernel

import ulib
import pw
import msg

export { V_OK, V_WRONG, V_UNREADABLE, verdict_of, unreadable_text, report_unreadable }

const V_OK: u64 = 0
const V_WRONG: u64 = 1
const V_UNREADABLE: u64 = 2
const SYS_PRCTL: u64 = 157
const PR_FAULT: u64 = 0x4F535702
const FAULT_ACCOUNTS: u64 = 1

static mut K_DBERR: [u8; 16] = "signin.dberror\0\0"
static mut T_DBERR: [u8; 64] = "Account files cannot be read. The password was not checked.\0\0\0\0\0"
static mut S_LOG: [u8; 36] = ": account files unreadable, errno=\0\0"

fn verdict_of(state: u64) -> u64 {
    if state == pw.DB_UNREADABLE {
        return V_UNREADABLE
    }
    if state == pw.DB_OK {
        return V_OK
    }
    return V_WRONG
}

fn unreadable_text() -> u64 {
    let k: u64 = (&K_DBERR[0 as usize]) as u64
    let t: u64 = msg.get(k)
    if t == k {
        return (&T_DBERR[0 as usize]) as u64
    }
    return t
}

fn report_unreadable(app: u64) {
    let e: u64 = pw.db_errno()
    ulib.say(app)
    ulib.say((&S_LOG[0 as usize]) as u64)
    ulib.sayn(e)
    ulib.nl()
    let _r: u64 = ulib.sys(SYS_PRCTL, PR_FAULT, (FAULT_ACCOUNTS << 16) | (e & 0xFFFF), 0)
}
