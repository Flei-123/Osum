profile kernel

import ulib
import lineout
import libc.io
import libc.errno
import libc.text
import libc.octets
import libc.kcall
import services.svcrules
import services.svcqueue
import services.svcosum

export { u_start }

const NAME_BUF: u64 = 128
const VALUE_BUF: u64 = 4096
const SEED_FILE_COUNT: u64 = 2

static mut name_buf: [u8; 128] = [0 as u8; 128]
static mut value_buf: [u8; 4096] = [0 as u8; 4096]
static mut head_buf: [u8; 28] = [0 as u8; 28]
static mut out_buf: [u8; 8] = [0 as u8; 8]
static mut APP_NAME: [u8; 11] = "dialogdemo\0"
static mut SEED_KEY: [u8; 5] = "seed\0"
static mut SEED_VALUE: [u8; 2] = "x\0"
static mut NOTE_PATH: [u8; 17] = "/data/ddnote.txt\0"
static mut NOTE_BODY: [u8; 14] = "note-body-123\0"
static mut SKIP_PATH: [u8; 17] = "/data/ddskip.bin\0"
static mut SKIP_BODY: [u8; 5] = "skip\0"
static mut OUT_PATH: [u8; 16] = "/data/ddout.txt\0"
static mut GONE_PATH: [u8; 17] = "/data/ddgone.txt\0"
static mut t_title: [u8; 11] = "Demo title\0"
static mut t_text: [u8; 20] = "Something happened.\0"
static mut t_accept: [u8; 4] = "txt\0"
static mut t_out_name: [u8; 10] = "ddout.txt\0"
static mut t_gone_name: [u8; 11] = "ddgone.txt\0"
static mut t_payload: [u8; 17] = "saved-payload-77\0"
static mut l_caps: [u8; 18] = "dialogdemo: caps=\0"
static mut l_msg_wait: [u8; 21] = "dialogdemo: msg-wait\0"
static mut l_msg: [u8; 16] = "dialogdemo: msg\0"
static mut l_yes_wait: [u8; 29] = "dialogdemo: confirm-yes-wait\0"
static mut l_yes: [u8; 24] = "dialogdemo: confirm-yes\0"
static mut l_no_wait: [u8; 28] = "dialogdemo: confirm-no-wait\0"
static mut l_no: [u8; 23] = "dialogdemo: confirm-no\0"
static mut l_open_wait: [u8; 22] = "dialogdemo: open-wait\0"
static mut l_open: [u8; 17] = "dialogdemo: open\0"
static mut l_ocancel_wait: [u8; 29] = "dialogdemo: open-cancel-wait\0"
static mut l_ocancel: [u8; 24] = "dialogdemo: open-cancel\0"
static mut l_save_wait: [u8; 22] = "dialogdemo: save-wait\0"
static mut l_save: [u8; 17] = "dialogdemo: save\0"
static mut l_scancel_wait: [u8; 29] = "dialogdemo: save-cancel-wait\0"
static mut l_scancel: [u8; 24] = "dialogdemo: save-cancel\0"
static mut l_rec: [u8; 16] = "dialogdemo: rec\0"
static mut l_file: [u8; 17] = "dialogdemo: file\0"
static mut l_done: [u8; 17] = "dialogdemo: done\0"
static mut s_status: [u8; 9] = " status=\0"
static mut s_ans: [u8; 6] = " ans=\0"
static mut s_op: [u8; 5] = " op=\0"
static mut s_name: [u8; 7] = " name=\0"
static mut s_len: [u8; 6] = " len=\0"
static mut s_val: [u8; 6] = " val=\0"

fn say(p: u64) {
    let _n: u64 = lineout.add_text(p)
}

fn num(label: u64, v: u64) {
    say(label)
    lineout.add_num(v)
}

fn mark(p: u64) {
    say(p)
    lineout.end_line()
}

fn write_file(path: u64, body: u64, n: u64) {
    let fd: u64 = io.create(path)
    if errno.failed(fd) {
        return
    }
    let _w: u64 = io.write_all(fd, body, n)
    let _c: u64 = io.close(fd)
}

fn seed() {
    let app: u64 = (&APP_NAME[0 as usize]) as u64
    let _a: u64 = svcosum.set_app(app, text.length(app))
    let _s: u64 = svcosum.store_set((&SEED_KEY[0 as usize]) as u64, 4, (&SEED_VALUE[0 as usize]) as u64, 1)
    write_file((&NOTE_PATH[0 as usize]) as u64, (&NOTE_BODY[0 as usize]) as u64, 13)
    write_file((&SKIP_PATH[0 as usize]) as u64, (&SKIP_BODY[0 as usize]) as u64, 4)
}

fn report_status(label: u64, status: u64) {
    say(label)
    say((&s_status[0 as usize]) as u64)
    say(svcrules.status_name(status))
}

fn report_answer(label: u64, status: u64) {
    report_status(label, status)
    num((&s_ans[0 as usize]) as u64, octets.le32((&out_buf[0 as usize]) as u64))
    lineout.end_line()
}

fn drain_queue() {
    let head: u64 = (&head_buf[0 as usize]) as u64
    let name: u64 = (&name_buf[0 as usize]) as u64
    let value: u64 = (&value_buf[0 as usize]) as u64
    while svcosum.pending() > 0 {
        octets.zero(name, NAME_BUF)
        octets.zero(value, VALUE_BUF)
        if !svcosum.poll(head, name, NAME_BUF - 1, value, VALUE_BUF - 1) {
            return
        }
        say((&l_rec[0 as usize]) as u64)
        num((&s_op[0 as usize]) as u64, octets.le32(head + 8))
        say((&s_status[0 as usize]) as u64)
        say(svcrules.status_name(octets.le32(head + 12)))
        say((&s_name[0 as usize]) as u64)
        say(name)
        num((&s_len[0 as usize]) as u64, octets.le32(head + 24))
        say((&s_val[0 as usize]) as u64)
        say(value)
        lineout.end_line()
    }
}

fn read_back(path: u64) {
    octets.zero((&value_buf[0 as usize]) as u64, VALUE_BUF)
    say((&l_file[0 as usize]) as u64)
    let size: u64 = io.size_of(path)
    if errno.failed(size) {
        say((&s_len[0 as usize]) as u64)
        lineout.add_num(0)
        lineout.end_line()
        return
    }
    let fd: u64 = io.open(path, kcall.O_RDONLY)
    if errno.failed(fd) {
        lineout.end_line()
        return
    }
    let _r: u64 = io.read_full(fd, (&value_buf[0 as usize]) as u64, size)
    let _c: u64 = io.close(fd)
    num((&s_len[0 as usize]) as u64, size)
    say((&s_val[0 as usize]) as u64)
    say((&value_buf[0 as usize]) as u64)
    lineout.end_line()
}

fn ask_message() {
    mark((&l_msg_wait[0 as usize]) as u64)
    let st: u64 = svcosum.message(0, (&t_title[0 as usize]) as u64, (&t_text[0 as usize]) as u64, 0, (&out_buf[0 as usize]) as u64)
    report_answer((&l_msg[0 as usize]) as u64, st)
}

fn ask_confirm(wait: u64, label: u64) {
    mark(wait)
    octets.st32((&out_buf[0 as usize]) as u64, 0, 9)
    let st: u64 = svcosum.confirm((&t_title[0 as usize]) as u64, (&t_text[0 as usize]) as u64, (&out_buf[0 as usize]) as u64)
    report_answer(label, st)
}

fn ask_open(wait: u64, label: u64) {
    mark(wait)
    let st: u64 = svcosum.file_open((&t_title[0 as usize]) as u64, (&t_accept[0 as usize]) as u64, (&out_buf[0 as usize]) as u64)
    report_status(label, st)
    lineout.end_line()
    drain_queue()
}

fn ask_save(wait: u64, label: u64, name: u64, path: u64) {
    mark(wait)
    let st: u64 = svcosum.file_save((&t_title[0 as usize]) as u64, name, (&t_payload[0 as usize]) as u64, 16, (&out_buf[0 as usize]) as u64)
    report_status(label, st)
    lineout.end_line()
    drain_queue()
    read_back(path)
}

fn u_start(args: u64) -> u64 {
    seed()
    say((&l_caps[0 as usize]) as u64)
    lineout.add_num(svcosum.caps())
    lineout.end_line()
    ask_message()
    ask_confirm((&l_yes_wait[0 as usize]) as u64, (&l_yes[0 as usize]) as u64)
    ask_confirm((&l_no_wait[0 as usize]) as u64, (&l_no[0 as usize]) as u64)
    ask_open((&l_open_wait[0 as usize]) as u64, (&l_open[0 as usize]) as u64)
    ask_open((&l_ocancel_wait[0 as usize]) as u64, (&l_ocancel[0 as usize]) as u64)
    ask_save((&l_save_wait[0 as usize]) as u64, (&l_save[0 as usize]) as u64, (&t_out_name[0 as usize]) as u64, (&OUT_PATH[0 as usize]) as u64)
    ask_save((&l_scancel_wait[0 as usize]) as u64, (&l_scancel[0 as usize]) as u64, (&t_gone_name[0 as usize]) as u64, (&GONE_PATH[0 as usize]) as u64)
    mark((&l_done[0 as usize]) as u64)
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
