import icons
import libc.regio
import libc.text

export { glyph_of }

const NONE: u64 = 0xFFFFFFFFFFFFFFFF
const SYMBOL_PREFIX: u64 = 7
const WORD_COUNT: usize = 27
const WORDS: str = "personalization display monitors network input accounts time-language apps privacy updates system scheme accent taskbar themes sound power about bluetooth pin cloud language permissions pointer history password wifi "

static mut glyphs: [u64; 27] = [0 as u64; 27]
static mut seeded: bool = false

fn seed() {
    if seeded {
        return
    }
    seeded = true
    glyphs[0 as usize] = icons.SETTINGS_PERSONALIZATION
    glyphs[1 as usize] = icons.SETTINGS_DISPLAY
    glyphs[2 as usize] = icons.SETTINGS_DISPLAY
    glyphs[3 as usize] = icons.SETTINGS_NETWORK
    glyphs[4 as usize] = icons.SETTINGS_INPUT
    glyphs[5 as usize] = icons.SETTINGS_ACCOUNTS
    glyphs[6 as usize] = icons.SETTINGS_TIME
    glyphs[7 as usize] = icons.SETTINGS_APPS
    glyphs[8 as usize] = icons.SETTINGS_PRIVACY
    glyphs[9 as usize] = icons.SETTINGS_UPDATES
    glyphs[10 as usize] = icons.SETTINGS_SYSTEM
    glyphs[11 as usize] = icons.SETTINGS_SCHEME
    glyphs[12 as usize] = icons.SETTINGS_ACCENT
    glyphs[13 as usize] = icons.SETTINGS_TASKBAR
    glyphs[14 as usize] = icons.SETTINGS_THEMES
    glyphs[15 as usize] = icons.SETTINGS_SOUND
    glyphs[16 as usize] = icons.SETTINGS_POWER
    glyphs[17 as usize] = icons.SETTINGS_ABOUT
    glyphs[18 as usize] = icons.SETTINGS_BLUETOOTH
    glyphs[19 as usize] = icons.SETTINGS_PIN
    glyphs[20 as usize] = icons.SETTINGS_CLOUD
    glyphs[21 as usize] = icons.SETTINGS_LANGUAGE
    glyphs[22 as usize] = icons.SETTINGS_PERMISSIONS
    glyphs[23 as usize] = icons.SETTINGS_POINTER
    glyphs[24 as usize] = icons.SETTINGS_HISTORY
    glyphs[25 as usize] = icons.SETTINGS_PASSWORD
    glyphs[26 as usize] = icons.SETTINGS_WIFI
}

fn word_end(base: u64, from: u64, total: u64) -> u64 {
    var e: u64 = from
    while e < total && regio.read8_at(base, e) != 32 {
        e = e + 1
    }
    return e
}

fn word_index(name: u64) -> u64 {
    let len: u64 = text.length(name)
    if len <= SYMBOL_PREFIX {
        return NONE
    }
    let want: u64 = name + SYMBOL_PREFIX
    let want_len: u64 = len - SYMBOL_PREFIX
    let words: str = WORDS
    let base: u64 = words.p as u64
    let total: u64 = words.n as u64
    var at: u64 = 0
    var index: u64 = 0
    while at < total {
        let end: u64 = word_end(base, at, total)
        if end - at == want_len && text.equal_n(base + at, want, want_len) {
            return index
        }
        index = index + 1
        at = end + 1
    }
    return NONE
}

fn glyph_of(name: u64) -> u64 {
    if name == 0 {
        return 0
    }
    seed()
    let index: u64 = word_index(name)
    if index >= WORD_COUNT as u64 {
        return 0
    }
    return glyphs[index as usize]
}
