// SPDX-License-Identifier: GPL-2.0-only
profile kernel

export { UNKNOWN, clear, update, disk_total, disk_rate, net_known, net_rate, net_tx, net_rx, threads, uid, prio, disk_read, disk_write }

const UNKNOWN: u64 = 4611686018427387904
const N: u64 = 128

static mut s_pid: [u64; 128] = [0 as u64; 128]
static mut s_dr: [u64; 128] = [0 as u64; 128]
static mut s_dw: [u64; 128] = [0 as u64; 128]
static mut s_tx: [u64; 128] = [0 as u64; 128]
static mut s_rx: [u64; 128] = [0 as u64; 128]
static mut s_nok: [u64; 128] = [0 as u64; 128]
static mut s_drate: [u64; 128] = [0 as u64; 128]
static mut s_nrate: [u64; 128] = [0 as u64; 128]
static mut s_thr: [u64; 128] = [0 as u64; 128]
static mut s_uid: [u64; 128] = [0 as u64; 128]
static mut s_prio: [u64; 128] = [0 as u64; 128]

fn delta(now: u64, before: u64) -> u64 {
    if now < before {
        return 0
    }
    return now - before
}

fn per_second(bytes: u64, dt_ms: u64) -> u64 {
    if dt_ms == 0 {
        return 0
    }
    return bytes * 1000 / dt_ms
}

fn clear(slot: u64) {
    if slot >= N {
        return
    }
    s_pid[(slot) as usize] = 0
    s_dr[(slot) as usize] = 0
    s_dw[(slot) as usize] = 0
    s_tx[(slot) as usize] = 0
    s_rx[(slot) as usize] = 0
    s_nok[(slot) as usize] = 0
    s_drate[(slot) as usize] = 0
    s_nrate[(slot) as usize] = 0
    s_thr[(slot) as usize] = 0
    s_uid[(slot) as usize] = 0
    s_prio[(slot) as usize] = 0
}

fn update(slot: u64, pid: u64, dr: u64, dw: u64, tx: u64, rx: u64, nok: u64, thr: u64, uid_v: u64, prio_v: u64, dt_ms: u64) {
    if slot >= N {
        return
    }
    let i: usize = slot as usize
    let same: bool = s_pid[i] == pid
    var dd: u64 = 0
    var nn: u64 = 0
    if same {
        dd = delta(dr, s_dr[i]) + delta(dw, s_dw[i])
        if nok != 0 && s_nok[i] != 0 {
            nn = delta(tx, s_tx[i]) + delta(rx, s_rx[i])
        }
    }
    s_drate[i] = per_second(dd, dt_ms)
    s_nrate[i] = per_second(nn, dt_ms)
    s_pid[i] = pid
    s_dr[i] = dr
    s_dw[i] = dw
    s_tx[i] = tx
    s_rx[i] = rx
    s_nok[i] = nok
    s_thr[i] = thr
    s_uid[i] = uid_v
    s_prio[i] = prio_v
}

fn disk_total(slot: u64) -> u64 {
    if slot >= N {
        return 0
    }
    return s_dr[(slot) as usize] + s_dw[(slot) as usize]
}

fn disk_read(slot: u64) -> u64 {
    if slot >= N {
        return 0
    }
    return s_dr[(slot) as usize]
}

fn disk_write(slot: u64) -> u64 {
    if slot >= N {
        return 0
    }
    return s_dw[(slot) as usize]
}

fn disk_rate(slot: u64) -> u64 {
    if slot >= N {
        return 0
    }
    return s_drate[(slot) as usize]
}

fn net_known(slot: u64) -> bool {
    if slot >= N {
        return false
    }
    return s_nok[(slot) as usize] != 0
}

fn net_rate(slot: u64) -> u64 {
    if slot >= N || s_nok[(slot) as usize] == 0 {
        return 0
    }
    return s_nrate[(slot) as usize]
}

fn net_tx(slot: u64) -> u64 {
    if slot >= N || s_nok[(slot) as usize] == 0 {
        return UNKNOWN
    }
    return s_tx[(slot) as usize]
}

fn net_rx(slot: u64) -> u64 {
    if slot >= N || s_nok[(slot) as usize] == 0 {
        return UNKNOWN
    }
    return s_rx[(slot) as usize]
}

fn threads(slot: u64) -> u64 {
    if slot >= N {
        return 0
    }
    return s_thr[(slot) as usize]
}

fn uid(slot: u64) -> u64 {
    if slot >= N {
        return 0
    }
    return s_uid[(slot) as usize]
}

fn prio(slot: u64) -> u64 {
    if slot >= N {
        return 0
    }
    return s_prio[(slot) as usize]
}
