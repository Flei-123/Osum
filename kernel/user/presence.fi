
profile kernel

import ulib
import lineout
import libc.io
import libc.octets
import libc.clockapi

export { u_start }

const BUS_REG_OP: u64 = 1
const BUS_FIND_OP: u64 = 2
const BUS_SEND_OP: u64 = 3
const BUS_RECV_OP: u64 = 4
const BUS_SUB_OP: u64 = 5
const BUS_PUB_OP: u64 = 6

fn bus_reg(name: u64, n: u64, access: u64) -> u64 {
    return ulib.bus5(BUS_REG_OP, name, n, access, 0)
}

fn bus_find(name: u64, n: u64) -> u64 {
    return ulib.bus5(BUS_FIND_OP, name, n, 0, 0)
}

fn bus_send(svc: u64, p: u64, n: u64) -> u64 {
    return ulib.bus5(BUS_SEND_OP, svc, p, n, 0)
}

fn bus_recv(p: u64, max: u64, head: u64) -> u64 {
    return ulib.bus5(BUS_RECV_OP, p, max, head, 0)
}

fn bus_sub(svc: u64) -> u64 {
    return ulib.bus5(BUS_SUB_OP, svc, 0, 0, 0)
}

fn bus_pub(svc: u64, p: u64, n: u64) -> u64 {
    return ulib.bus5(BUS_PUB_OP, svc, p, n, 0)
}

const SVC_NAMELEN: u64 = 8
const A_SAMEUID: u64 = 1

const P_SET: u64 = 1
const P_FOKUS: u64 = 2
const P_GONE: u64 = 3
const P_DA: u64 = 4
const P_SICHT: u64 = 5
const P_ASK: u64 = 6
const P_EVENT: u64 = 7

const Z_DA: u64 = 0
const Z_GONE: u64 = 1
const Z_BESCH: u64 = 2
const Z_UNSICHT: u64 = 3

const R_ART: u64 = 0
const R_STATE: u64 = 1
const R_APPLEN: u64 = 2
const R_TXTLEN: u64 = 3
const R_APP: u64 = 4
const R_APPMAX: u64 = 16
const R_TXT: u64 = 20
const R_TXTMAX: u64 = 44
const R_BYTES: u64 = 64

static mut z_state: u64 = 0
static mut z_app: [u8; 16] = [0 as u8; 16]
static mut z_applen: u64 = 0
static mut z_txt: [u8; 44] = [0 as u8; 44]
static mut z_txtlen: u64 = 0
static mut z_unsicht: u64 = 0
static mut z_seit: u64 = 0
static mut z_gekuerzt: u64 = 0
const KEIN_DIENST: u64 = 0xFFFFFFFF
static mut z_dienst: u64 = 0xFFFFFFFF

static mut e_apps: [u8; 512] = [0 as u8; 512]
static mut e_len: u64 = 0

static mut svcname: [u8; 9] = "praesenz\0"

fn conf_read() {
    e_len = 0
    var path: [u8; 19] = "/etc/praesenz.conf\0"
    var buf: [u8; 1024] = [0 as u8; 1024]
    let fd: u64 = io.open((&path[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return
    }
    let n: u64 = io.read(fd, (&buf[0 as usize]) as u64, 1023)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return
    }
    let bp: u64 = (&buf[0 as usize]) as u64
    var i: u64 = 0
    while i < n {
        var za: bool = false
        if i == 0 {
            za = true
        } else {
            if octets.ld8(bp, i - 1) == 10 {
                za = true
            }
        }
        if za && i + 5 <= n {
            if octets.ld8(bp, i) == 116 && octets.ld8(bp, i + 1) == 101
                && octets.ld8(bp, i + 2) == 120 && octets.ld8(bp, i + 3) == 116
                && octets.ld8(bp, i + 4) == 32 {
                var j: u64 = i + 5
                while j < n && octets.ld8(bp, j) != 10 && e_len < 511 {
                    e_apps[e_len as usize] = octets.ld8(bp, j) as u8
                    e_len = e_len + 1
                    j = j + 1
                }
                if e_len < 511 {
                    e_apps[e_len as usize] = 32 as u8
                    e_len = e_len + 1
                }
            }
        }
        i = i + 1
    }
}

fn may_text(app: u64, alen: u64) -> bool {
    if alen == 0 || e_len == 0 {
        return false
    }
    var i: u64 = 0
    while i < e_len {
        var wa: bool = false
        if i == 0 {
            wa = true
        } else {
            if e_apps[(i - 1) as usize] == 32 as u8 {
                wa = true
            }
        }
        if wa {
            var k: u64 = 0
            var equal: bool = true
            while k < alen {
                if i + k >= e_len {
                    equal = false
                    k = alen
                } else {
                    if (e_apps[(i + k) as usize] as u64) != octets.ld8(app, k) {
                        equal = false
                        k = alen
                    } else {
                        k = k + 1
                    }
                }
            }
            if equal {
                if i + alen >= e_len {
                    return true
                }
                if e_apps[(i + alen) as usize] == 32 as u8 {
                    return true
                }
            }
        }
        i = i + 1
    }
    return false
}

fn frame_build(out: u64, art: u64) {
    var i: u64 = 0
    while i < R_BYTES {
        octets.st8(out, i, 0)
        i = i + 1
    }
    octets.st8(out, R_ART, art)
    if z_unsicht != 0 {
        octets.st8(out, R_STATE, Z_UNSICHT)
        return
    }
    octets.st8(out, R_STATE, z_state)
    octets.st8(out, R_APPLEN, z_applen)
    octets.st8(out, R_TXTLEN, z_txtlen)
    i = 0
    while i < z_applen {
        octets.st8(out, R_APP + i, z_app[i as usize] as u64)
        i = i + 1
    }
    i = 0
    while i < z_txtlen {
        octets.st8(out, R_TXT + i, z_txt[i as usize] as u64)
        i = i + 1
    }
}

fn set(app: u64, alen0: u64, txt: u64, tlen0: u64, mit_text: bool) {
    var alen: u64 = alen0
    if alen > R_APPMAX {
        alen = R_APPMAX
    }
    var changed: bool = alen != z_applen
    if !changed {
        var i: u64 = 0
        while i < alen {
            if (z_app[i as usize] as u64) != octets.ld8(app, i) {
                changed = true
                i = alen
            } else {
                i = i + 1
            }
        }
    }
    var k: u64 = 0
    while k < alen {
        z_app[k as usize] = octets.ld8(app, k) as u8
        k = k + 1
    }
    z_applen = alen
    if changed {
        z_seit = clockapi.ticks()
    }
    z_txtlen = 0
    if mit_text && may_text(app, alen) {
        var tl: u64 = tlen0
        if tl > R_TXTMAX {
            tl = R_TXTMAX
            z_gekuerzt = z_gekuerzt + 1
        }
        k = 0
        while k < tl {
            z_txt[k as usize] = octets.ld8(txt, k) as u8
            k = k + 1
        }
        z_txtlen = tl
    }
}

fn verteilen() -> u64 {
    if z_dienst == KEIN_DIENST {
        return 0
    }
    var frame: [u8; 64] = [0 as u8; 64]
    frame_build((&frame[0 as usize]) as u64, P_EVENT)
    let n: u64 = bus_pub(z_dienst, (&frame[0 as usize]) as u64, R_BYTES)
    if ulib.bad(n) {
        return 0
    }
    return n
}

static mut n_da: [u8; 3] = "da\0"
static mut n_gone: [u8; 9] = "abwesend\0"
static mut n_besch: [u8; 13] = "beschaeftigt\0"
static mut n_unsicht: [u8; 11] = "unsichtbar\0"

fn state_name(z: u64) -> u64 {
    if z == Z_GONE {
        return (&n_gone[0 as usize]) as u64
    }
    if z == Z_BESCH {
        return (&n_besch[0 as usize]) as u64
    }
    if z == Z_UNSICHT {
        return (&n_unsicht[0 as usize]) as u64
    }
    return (&n_da[0 as usize]) as u64
}

fn show() {
    var t1: [u8; 17] = "presence: state=\0"
    lineout.add_text((&t1[0 as usize]) as u64)
    if z_unsicht != 0 {
        lineout.add_text(state_name(Z_UNSICHT))
    } else {
        lineout.add_text(state_name(z_state))
    }
    var t2: [u8; 6] = " app=\0"
    lineout.add_text((&t2[0 as usize]) as u64)
    if z_applen > 0 {
        lineout.add_bytes((&z_app[0 as usize]) as u64, z_applen)
    }
    var t3: [u8; 7] = " text=\0"
    lineout.add_text((&t3[0 as usize]) as u64)
    if z_unsicht == 0 && z_txtlen > 0 {
        lineout.add_bytes((&z_txt[0 as usize]) as u64, z_txtlen)
    }
    var t4: [u8; 8] = " since=\0"
    lineout.add_text((&t4[0 as usize]) as u64)
    lineout.add_num(z_seit)
    var t5: [u8; 10] = " trimmed=\0"
    lineout.add_text((&t5[0 as usize]) as u64)
    lineout.add_num(z_gekuerzt)
    lineout.end_line()
}

fn dienst(deadline: u64) -> u64 {
    conf_read()
    z_dienst = bus_reg((&svcname[0 as usize]) as u64, SVC_NAMELEN,
        A_SAMEUID)
    if ulib.bad(z_dienst) {
        var e: [u8; 38] = "presence: the bus refuses the service\0"
        lineout.add_text((&e[0 as usize]) as u64)
        lineout.end_line()
        return 1
    }
    var m1: [u8; 26] = "presence: service number=\0"
    lineout.add_text((&m1[0 as usize]) as u64)
    lineout.add_num(z_dienst)
    lineout.end_line()

    let start: u64 = clockapi.ticks()
    var buffer: [u8; 64] = [0 as u8; 64]
    var header: [u64; 6] = [0 as u64; 6]
    let pp: u64 = (&buffer[0 as usize]) as u64
    var lauf: bool = true
    while lauf {
        let n: u64 = bus_recv(pp, R_BYTES, (&header[0 as usize]) as u64)
        if !ulib.bad(n) && n > 0 {
            let art: u64 = octets.ld8(pp, R_ART)
            if art == P_SET || art == P_FOKUS {
                set(pp + R_APP, octets.ld8(pp, R_APPLEN),
                    pp + R_TXT, octets.ld8(pp, R_TXTLEN), art == P_SET)
                if z_state == Z_GONE {
                    z_state = Z_DA
                }
                verteilen()
            }
            if art == P_GONE {
                z_state = Z_GONE
                verteilen()
            }
            if art == P_DA {
                z_state = Z_DA
                verteilen()
            }
            if art == P_SICHT {
                z_unsicht = octets.ld8(pp, R_STATE)
                verteilen()
            }
            if art == P_ASK {
                verteilen()
            }
        } else {
            ulib.sys(ulib.SYS_YIELD, 0, 0, 0)
        }
        if deadline != 0 {
            if clockapi.ticks() - start >= deadline {
                lauf = false
            }
        }
    }
    return 0
}

fn schicken(art: u64, app: u64, txt: u64, sicht: u64) -> u64 {
    let svc: u64 = bus_find((&svcname[0 as usize]) as u64, SVC_NAMELEN)
    if ulib.bad(svc) {
        var e: [u8; 21] = "presence: no service\0"
        lineout.add_text((&e[0 as usize]) as u64)
        lineout.end_line()
        return 1
    }
    var frame: [u8; 64] = [0 as u8; 64]
    let rp: u64 = (&frame[0 as usize]) as u64
    var i: u64 = 0
    while i < R_BYTES {
        octets.st8(rp, i, 0)
        i = i + 1
    }
    octets.st8(rp, R_ART, art)
    octets.st8(rp, R_STATE, sicht)
    if app != 0 {
        var al: u64 = octets.cstr_len(app)
        if al > R_APPMAX {
            al = R_APPMAX
        }
        octets.st8(rp, R_APPLEN, al)
        i = 0
        while i < al {
            octets.st8(rp, R_APP + i, octets.ld8(app, i))
            i = i + 1
        }
    }
    if txt != 0 {
        var tl: u64 = octets.cstr_len(txt)
        if tl > R_TXTMAX {
            tl = R_TXTMAX
        }
        octets.st8(rp, R_TXTLEN, tl)
        i = 0
        while i < tl {
            octets.st8(rp, R_TXT + i, octets.ld8(txt, i))
            i = i + 1
        }
    }
    let r: u64 = bus_send(svc, rp, R_BYTES)
    if ulib.bad(r) {
        var e2: [u8; 26] = "presence: the bus says no\0"
        lineout.add_text((&e2[0 as usize]) as u64)
        lineout.end_line()
        return 1
    }
    return 0
}

fn ask() -> u64 {
    let svc: u64 = bus_find((&svcname[0 as usize]) as u64, SVC_NAMELEN)
    if ulib.bad(svc) {
        var e: [u8; 21] = "presence: no service\0"
        lineout.add_text((&e[0 as usize]) as u64)
        lineout.end_line()
        return 1
    }
    if ulib.bad(bus_sub(svc)) {
        var e2: [u8; 31] = "presence: subscription refused\0"
        lineout.add_text((&e2[0 as usize]) as u64)
        lineout.end_line()
        return 1
    }
    var frame: [u8; 64] = [0 as u8; 64]
    let rp: u64 = (&frame[0 as usize]) as u64
    var i: u64 = 0
    while i < R_BYTES {
        octets.st8(rp, i, 0)
        i = i + 1
    }
    octets.st8(rp, R_ART, P_ASK)
    if ulib.bad(bus_send(svc, rp, R_BYTES)) {
        var e3: [u8; 26] = "presence: the bus says no\0"
        lineout.add_text((&e3[0 as usize]) as u64)
        lineout.end_line()
        return 1
    }
    var buffer: [u8; 64] = [0 as u8; 64]
    var header: [u64; 6] = [0 as u64; 6]
    let pp: u64 = (&buffer[0 as usize]) as u64
    let t0: u64 = clockapi.ticks()
    while clockapi.ticks() - t0 < 200 {
        let n: u64 = bus_recv(pp, R_BYTES, (&header[0 as usize]) as u64)
        if !ulib.bad(n) && n > 0 {
            if octets.ld8(pp, R_ART) == P_EVENT {
                z_state = octets.ld8(pp, R_STATE)
                z_unsicht = 0
                if z_state == Z_UNSICHT {
                    z_unsicht = 1
                }
                z_applen = octets.ld8(pp, R_APPLEN)
                z_txtlen = octets.ld8(pp, R_TXTLEN)
                var k: u64 = 0
                while k < z_applen {
                    z_app[k as usize] = octets.ld8(pp, R_APP + k) as u8
                    k = k + 1
                }
                k = 0
                while k < z_txtlen {
                    z_txt[k as usize] = octets.ld8(pp, R_TXT + k) as u8
                    k = k + 1
                }
                show()
                return 0
            }
        }
        ulib.sys(ulib.SYS_YIELD, 0, 0, 0)
    }
    var e4: [u8; 32] = "presence: the service is silent\0"
    lineout.add_text((&e4[0 as usize]) as u64)
    lineout.end_line()
    return 1
}

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        var h1: [u8; 44] = "presence service [ms]          the service\n\0"
        var h2: [u8; 43] = "presence set <app> <text>      set status\n\0"
        var h3: [u8; 41] = "presence focus <app>           in <app>\n\0"
        var h4: [u8; 44] = "presence away | back           away / back\n\0"
        var h5: [u8; 47] = "presence invisible <on|off>    nobody sees me\n\0"
        var h6: [u8; 42] = "presence show                  the state\n\0"
        lineout.add_text((&h1[0 as usize]) as u64)
        lineout.add_text((&h2[0 as usize]) as u64)
        lineout.add_text((&h3[0 as usize]) as u64)
        lineout.add_text((&h4[0 as usize]) as u64)
        lineout.add_text((&h5[0 as usize]) as u64)
        lineout.add_text((&h6[0 as usize]) as u64)
        return 1
    }
    let cmd: u64 = ulib.arg_at(args, 1)
    var c_dienst: [u8; 8] = "service\0"
    var c_show: [u8; 5] = "show\0"
    var c_set: [u8; 4] = "set\0"
    var c_fokus: [u8; 6] = "focus\0"
    var c_remove: [u8; 5] = "away\0"
    var c_da: [u8; 5] = "back\0"
    var c_unsicht: [u8; 10] = "invisible\0"
    var c_an: [u8; 3] = "on\0"

    if ulib.streq(cmd, (&c_dienst[0 as usize]) as u64) {
        var deadline: u64 = 0
        if argc >= 3 {
            deadline = ulib.to_num(ulib.arg_at(args, 2))
        }
        return dienst(deadline)
    }
    if ulib.streq(cmd, (&c_show[0 as usize]) as u64) {
        conf_read()
        return ask()
    }
    if ulib.streq(cmd, (&c_set[0 as usize]) as u64) {
        var app: u64 = 0
        var txt: u64 = 0
        if argc >= 3 {
            app = ulib.arg_at(args, 2)
        }
        if argc >= 4 {
            txt = ulib.arg_at(args, 3)
        }
        return schicken(P_SET, app, txt, 0)
    }
    if ulib.streq(cmd, (&c_fokus[0 as usize]) as u64) {
        var app2: u64 = 0
        if argc >= 3 {
            app2 = ulib.arg_at(args, 2)
        }
        return schicken(P_FOKUS, app2, 0, 0)
    }
    if ulib.streq(cmd, (&c_remove[0 as usize]) as u64) {
        return schicken(P_GONE, 0, 0, 0)
    }
    if ulib.streq(cmd, (&c_da[0 as usize]) as u64) {
        return schicken(P_DA, 0, 0, 0)
    }
    if ulib.streq(cmd, (&c_unsicht[0 as usize]) as u64) {
        var an: u64 = 0
        if argc >= 3 {
            if ulib.streq(ulib.arg_at(args, 2), (&c_an[0 as usize]) as u64) {
                an = 1
            }
        }
        return schicken(P_SICHT, 0, 0, an)
    }
    var e3: [u8; 26] = "presence: unknown command\0"
    lineout.add_text((&e3[0 as usize]) as u64)
    lineout.end_line()
    return 1
}
