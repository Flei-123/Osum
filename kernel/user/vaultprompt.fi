profile app

import ulib
import lineout
import actwire
import wlib
import icons
import fuiscene
import msg

export { u_start }

const EXIT_ALLOW: u64 = 0
const EXIT_DENY: u64 = 1
const EXIT_TIMEOUT: u64 = 2
const EXIT_NO_UI: u64 = 3
const EXIT_USAGE: u64 = 4
const K_ALLOW: u64 = 1
const K_DENY: u64 = 2
const K_ROWS: u64 = 3
const MARGIN: u64 = 28
const ROW_H: u64 = 40
const CTL_H: u64 = 36
const ROWS: u64 = 3
const BLOB_CAP: u64 = 480
const TICKS_PER_SEC: u64 = 100
const WIN_X: u64 = 200
const WIN_Y: u64 = 140
const WIN_W: u64 = 440
const WIN_H: u64 = 340

static mut k_title: [u8; 18] = "vaultprompt.title\0"
static mut k_head: [u8; 17] = "vaultprompt.head\0"
static mut k_note: [u8; 17] = "vaultprompt.note\0"
static mut k_site: [u8; 17] = "vaultprompt.site\0"
static mut k_user: [u8; 17] = "vaultprompt.user\0"
static mut k_from: [u8; 17] = "vaultprompt.from\0"
static mut k_self: [u8; 17] = "vaultprompt.self\0"
static mut k_hint: [u8; 17] = "vaultprompt.hint\0"
static mut k_allow: [u8; 18] = "vaultprompt.allow\0"
static mut k_deny: [u8; 17] = "vaultprompt.deny\0"

static mut blob: [u8; 488] = [0 as u8; 488]
static mut row_icons: [u64; 4] = [0 as u64; 4]
static mut a_origin: u64 = 0
static mut a_user: u64 = 0
static mut a_from: u64 = 0

fn say(p: u64) {
    lineout.add_text(p)
}

fn put_char(at: u64, c: u8) -> u64 {
    if at + 2 < BLOB_CAP {
        blob[(at) as usize] = c
        return at + 1
    }
    return at
}

fn put_text(at: u64, p: u64) -> u64 {
    var o: u64 = at
    var i: u64 = 0
    while *((p + i) as *mut u8) != 0 as u8 {
        var c: u8 = *((p + i) as *mut u8)
        if c < 32 as u8 {
            c = 63 as u8
        }
        o = put_char(o, c)
        i = i + 1
    }
    return o
}

fn put_row(at: u64, value: u64, label: u64) -> u64 {
    var o: u64 = put_text(at, value)
    o = put_char(o, 9 as u8)
    o = put_text(o, label)
    return put_char(o, 10 as u8)
}

fn build_rows() {
    var o: u64 = put_row(0, a_origin, msg.get((&k_site[0 as usize]) as u64))
    o = put_row(o, a_user, msg.get((&k_user[0 as usize]) as u64))
    var from: u64 = a_from
    if *((from) as *mut u8) == 45 as u8 && *((from + 1) as *mut u8) == 0 as u8 {
        from = msg.get((&k_self[0 as usize]) as u64)
    }
    o = put_row(o, from, msg.get((&k_from[0 as usize]) as u64))
    blob[(o) as usize] = 0 as u8
    row_icons[0 as usize] = wlib.icon_id(icons.VAULT_APP)
    row_icons[1 as usize] = wlib.icon_id(icons.VAULT_USER)
    row_icons[2 as usize] = wlib.icon_id(icons.VAULT_KEY)
}

fn build() {
    build_rows()
    let col: usize = fuiscene.root()
    fuiscene.set_pad(col, MARGIN)
    fuiscene.set_gap(col, 4)
    let w: u64 = fuiscene.width() - 2 * MARGIN
    let head: usize = fuiscene.row(col)
    fuiscene.set_size(head, w, 32)
    let h1: usize = fuiscene.label_heading(head, msg.get((&k_head[0 as usize]) as u64))
    fuiscene.set_grow(h1, 1)
    let _n: usize = fuiscene.label_muted(col, msg.get((&k_note[0 as usize]) as u64))
    let body: usize = fuiscene.column(col)
    fuiscene.set_gap(body, 12)
    fuiscene.set_grow(body, 1)
    let _t: usize = fuiscene.table_list(body, K_ROWS, w, ROWS * ROW_H + 2, 2, (&blob[0 as usize]) as u64)
    fuiscene.table_single(K_ROWS, true)
    fuiscene.table_click_only(K_ROWS, true)
    fuiscene.table_row_height(K_ROWS, ROW_H)
    fuiscene.table_icons(K_ROWS, (&row_icons[0 as usize]) as u64)
    fuiscene.table_set_sel(K_ROWS, 4294967295)
    fuiscene.table_exact(K_ROWS, true)
    fuiscene.table_font(K_ROWS, 14, 13, 18)
    fuiscene.table_align_right(K_ROWS, 1, true)
    fuiscene.table_colw(K_ROWS, 0, w - 110)
    fuiscene.table_colw(K_ROWS, 1, 110)
    let _h: usize = fuiscene.label_muted(body, msg.get((&k_hint[0 as usize]) as u64))
    let bar: usize = fuiscene.row(col)
    fuiscene.set_size(bar, w, CTL_H)
    fuiscene.set_gap(bar, 8)
    let b1: usize = fuiscene.button_main(bar, msg.get((&k_allow[0 as usize]) as u64), K_ALLOW)
    fuiscene.set_noshrink(b1)
    fuiscene.set_size(b1, 140, CTL_H)
    let b2: usize = fuiscene.button(bar, msg.get((&k_deny[0 as usize]) as u64), K_DENY)
    fuiscene.set_noshrink(b2)
    fuiscene.set_size(b2, 120, CTL_H)
}

fn num_arg(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while actwire.ld8(p, i) >= 48 && actwire.ld8(p, i) <= 57 && v < 100000 {
        v = v * 10 + (actwire.ld8(p, i) - 48)
        i = i + 1
    }
    return v
}

fn run(secs: u64) -> u64 {
    var s_bad: [u8; 24] = "vaultprompt: no surface\0"
    var s_go: [u8; 19] = "vaultprompt: ready\0"
    var s_al: [u8; 20] = "vaultprompt: allow\0\0"
    var s_dn: [u8; 19] = "vaultprompt: deny\0\0"
    var s_to: [u8; 22] = "vaultprompt: timeout\0\0"
    var s_nm: [u8; 12] = "vaultprompt\0"
    var s_app: [u8; 12] = "vaultprompt\0"
    let _mi: u64 = msg.init()
    if !fuiscene.open(WIN_X, WIN_Y, WIN_W, WIN_H, msg.get((&k_title[0 as usize]) as u64), build) {
        say((&s_bad[0 as usize]) as u64)
        lineout.end_line()
        return EXIT_NO_UI
    }
    fuiscene.set_app((&s_app[0 as usize]) as u64)
    let t0: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    var first: bool = true
    var spin: u64 = 0
    var code: u64 = EXIT_DENY
    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        if first {
            first = false
            fuiscene.say_rects((&s_nm[0 as usize]) as u64)
            say((&s_go[0 as usize]) as u64)
            lineout.end_line()
        }
        if key == K_ALLOW {
            say((&s_al[0 as usize]) as u64)
            lineout.end_line()
            code = EXIT_ALLOW
            fuiscene.quit()
        } else if key == K_DENY {
            say((&s_dn[0 as usize]) as u64)
            lineout.end_line()
            code = EXIT_DENY
            fuiscene.quit()
        }
        spin = spin + 1
        if (spin % 16) == 0 && secs > 0 {
            let now: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
            if now >= t0 && now - t0 >= secs * TICKS_PER_SEC {
                say((&s_to[0 as usize]) as u64)
                lineout.end_line()
                code = EXIT_TIMEOUT
                fuiscene.quit()
            }
        }
    }
    return code
}

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 58] = "usage: vaultprompt reveal <origin> <user> <from> <secs>\n\0\0"
    var a_rev: [u8; 7] = "reveal\0"
    if ulib.arg_count(args) != 6 || !ulib.streq(ulib.arg_at(args, 1), (&a_rev[0 as usize]) as u64) {
        say((&s_use[0 as usize]) as u64)
        return EXIT_USAGE
    }
    a_origin = ulib.arg_at(args, 2)
    a_user = ulib.arg_at(args, 3)
    a_from = ulib.arg_at(args, 4)
    return run(num_arg(ulib.arg_at(args, 5)))
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
