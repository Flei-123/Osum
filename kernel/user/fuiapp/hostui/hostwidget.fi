    at = hoststate.tr_put(b, at, (&bky[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, ky)
    at = hoststate.tr_put(b, at, (&bkw[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, kw)
    at = hoststate.tr_put(b, at, (&bkh[0 as usize]) as u64)
