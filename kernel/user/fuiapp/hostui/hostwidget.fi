}

fn say_tab(w: u64, k: u64, x: u64, y: u64, tw: u64, th: u64, q: u64,
    nq: u64, nv: u64) {
    var a: [u8; 13] = "wlib: tab i=\0"
    var bx: [u8; 4] = " x=\0"
    var by: [u8; 4] = " y=\0"
    var bw2: [u8; 4] = " w=\0"
    var bh2: [u8; 4] = " h=\0"
    var bax: [u8; 5] = " ax=\0"
    var bay: [u8; 5] = " ay=\0"
    if hostbase.s_trace == 0 {
        return
    }
    lineout.add_text((&a[0 as usize]) as u64)
    lineout.add_num(k)
    lineout.add_text((&bx[0 as usize]) as u64)
    lineout.add_num(x)
    lineout.add_text((&by[0 as usize]) as u64)
    lineout.add_num(y)
    lineout.add_text((&bw2[0 as usize]) as u64)
    lineout.add_num(tw)
    lineout.add_text((&bh2[0 as usize]) as u64)
    lineout.add_num(th)

    lineout.add_text((&bax[0 as usize]) as u64)
    lineout.add_num(hoststate.org_x(w) + x)
    lineout.add_text((&bay[0 as usize]) as u64)
    lineout.add_num(hoststate.org_y(w) + y)
    lineout.add_text((&hostbase.tr_q[0 as usize]) as u64)
    lineout.add_num(nq)
    lineout.add_text((&hostbase.tr_v[0 as usize]) as u64)
    lineout.add_num(nv)
    lineout.add_text((&hostbase.tr_t[0 as usize]) as u64)
    let b: u64 = (&hostbase.tr_buf[0 as usize]) as u64
    var c: u64 = 0
    while c < nv && c + 2 < 320 {
        __mmio_write8((b + c) as *mut u8, __mmio_read8((q + c) as *mut u8))
        c = c + 1
    }
    __mmio_write8((b + c) as *mut u8, 10 as u8)
    let _wt: u64 = lineout.add_bytes(b, c + 1)
}

fn paint_sep(i: u64) {
    uidraw.divider(hoststate.g(i, hostbase.D_X), hoststate.g(i, hostbase.D_Y) + hoststate.g(i, hostbase.D_H) / 2, hoststate.g(i, hostbase.D_W),
        thquery.theme(uitheme.T_LINE))
}

fn paint_card(i: u64) {
    let r: u64 = draw_radius(MR_PANEL)
    if r == 0 && uitheme.metric(uitheme.M_DIVIDER) >= 50 {
        return
    }
    let x: u64 = hoststate.g(i, hostbase.D_X)
    let y: u64 = hoststate.g(i, hostbase.D_Y)
    let w: u64 = hoststate.g(i, hostbase.D_W)
    let h: u64 = hoststate.g(i, hostbase.D_H)
    if w < 8 || h < 8 {
        return
    }
    say_radius(RT_CARD, MR_PANEL, r, w, h)
    fuib.shadow(x, y, w, h, r, uitheme.metric(uitheme.M_SHADOW2),
        uitheme.metric(uitheme.M_SHADOW_R2), thquery.theme(uitheme.C_SHADOW))
    let _fb18: bool = fuib.board(x, y, w, h, r, thquery.theme(uitheme.C_PANEL_BG), 0, 0)
}

fn paint_image(i: u64) {
    let x: u64 = hoststate.g(i, hostbase.D_X)
    let y: u64 = hoststate.g(i, hostbase.D_Y)
    let w: u64 = hoststate.g(i, hostbase.D_W)
    let h: u64 = hoststate.g(i, hostbase.D_H)
    fuib.rect(x, y, w, h, thquery.theme(uitheme.T_ENTRY))
    let p: u64 = hoststate.g(i, hostbase.D_E)
    let iw: u64 = hoststate.g(i, hostbase.D_F)
    let ih: u64 = hoststate.g(i, hostbase.D_G)
    if p == 0 || iw == 0 || ih == 0 || w < 4 || h < 4 {
        fuib.frame(x, y, w, h, thquery.theme(uitheme.T_LINE))
        return
    }
    let z: u64 = hoststate.g(i, hostbase.D_ZOOM)
    let rotation: u64 = hoststate.g(i, hostbase.D_ROTATION)
    let bw: u64 = hoststate.image_bw(i)
    let bh: u64 = hoststate.image_bh(i)
    let zw: u64 = bw * z / 100
    let zh: u64 = bh * z / 100
    var ox: u64 = x
    if zw < w {
        ox = x + (w - zw) / 2
    }
    var oy: u64 = y
    if zh < h {
        oy = y + (h - zh) / 2
    }
    ox = ox +% hoststate.g(i, hostbase.D_PX)
    oy = oy +% hoststate.g(i, hostbase.D_PY)
    let a_x0: u64 = uidraw.clip_x0()
    let a_y0: u64 = uidraw.clip_y0()
    let a_x1: u64 = uidraw.clip_x1()
    let a_y1: u64 = uidraw.clip_y1()
    uidraw.clip_set(x, y, x + w, y + h)

    if !fuib.picture(p, iw, ih, rotation, ox as i64, oy as i64, zw, zh) {
    var sy: u64 = 0
    while sy < h {
        let py: u64 = y + sy
        let dy: u64 = py -% oy
        if dy < zh {
            let qy: u64 = dy * 100 / z
            var sx: u64 = 0
            while sx < w {
                let px: u64 = x + sx
                let dx: u64 = px -% ox
                if dx < zw {
                    let qx: u64 = dx * 100 / z
                    var bx: u64 = qx
                    var by: u64 = qy
                    if rotation == 1 {
                        bx = qy
                        by = ih - 1 - qx
                    } else if rotation == 2 {
                        bx = iw - 1 - qx
                        by = ih - 1 - qy
                    } else if rotation == 3 {
                        bx = iw - 1 - qy
                        by = qx
                    }
                    if bx < iw && by < ih {
                        let f: u64 = (__mmio_read32((p + (by * iw + bx) * 4)
                            as *mut u32)) as u64
                        let a: u64 = f >> 24
                        if a == 255 {
                            uidraw.px(px, py, f & uitheme.RGB24)
                        } else if a > 0 {
                            uidraw.px(px, py, uidraw.blend(uidraw.get(px, py),
                                f & uitheme.RGB24, a))
                        }
                    }
                }
                sx = sx + 1
            }
        }
        sy = sy + 1
    }
    }
    if hoststate.g(i, hostbase.D_WZ) == 1 && hostbase.s_aus_da != 0 {
        let ox2: u64 = hoststate.image_ox(i)
        let oy2: u64 = hoststate.image_oy(i)
        let ax: u64 = ox2 + hoststate.img_out_x0() * z / 100
        let ay: u64 = oy2 + hoststate.img_out_y0() * z / 100
        let aw: u64 = (hoststate.img_out_x1() - hoststate.img_out_x0() + 1) * z / 100
        let ah: u64 = (hoststate.img_out_y1() - hoststate.img_out_y0() + 1) * z / 100
        fuib.frame(ax, ay, aw, ah, thquery.theme(uitheme.T_ACCENT))
        if aw > 2 && ah > 2 {
            fuib.frame(ax + 1, ay + 1, aw - 2, ah - 2,
                thquery.theme(uitheme.T_ACCENT))
        }
    }
    uidraw.clip_set(a_x0, a_y0, a_x1, a_y1)
    fuib.frame(x, y, w, h, thquery.theme(uitheme.T_LINE))
    focus_ring(i)
}

fn zug_name_von(i: u64, r: u64) -> u64 {
    if i >= hostbase.MAXWD || r >= hostbase.MAXWD {
        return 0
    }
    var zr: u64 = r
    if hoststate.g(i, hostbase.D_KIND) == hostbase.K_TABLE {
        zr = r + 1
    }
    let q: u64 = hoststate.row_at(hoststate.g(i, hostbase.D_TEXT), zr)
    if q == 0 {
        return 0
    }
    var ende: u64 = hoststate.row_len(q)
    var t: u64 = 0
    var gefunden: bool = false
    while t < ende && !gefunden {
        if (*((q + t) as *mut u8)) == 9 as u8 {
            gefunden = true
        } else {
            t = t + 1
        }
    }
    if t < ende {
        ende = t
    }
    if ende > 94 {
        ende = 94
    }
    var n: u64 = 0
    while n < ende {
        zugname[(n) as usize] = *((q + n) as *mut u8)
        n = n + 1
    }
    zugname[(n) as usize] = 0 as u8
    return (&zugname[0 as usize]) as u64
}

fn run_width(p: u64) -> u64 {
    if p == 0 {
        return 96
    }
    let tw: u64 = uitext.text_w(uitext.F_UI, uiscale.px_ui(), p, hoststate.tlen(p))
    var b: u64 = tw + 20
    if b < 48 {
        b = 48
    }
    if b > 320 {
        b = 320
    }
    return b
}

fn zug_bilder() -> u64 {
    return hostbase.s_zugauf
}

fn zug_laeuft() -> bool {
    return hostbase.s_zugwin != 0
}

fn anklickbar(i: u64) -> bool {
    if i >= hostbase.MAXWD {
        return false
    }
    if (hoststate.g(i, hostbase.D_FLAGS) & (hostbase.F_OFF | hostbase.F_HIDE)) != 0 {
        return false
    }
    let k: u64 = hoststate.g(i, hostbase.D_KIND)

    return k == hostbase.K_LIST || k == hostbase.K_TABS || k == hostbase.K_MENUBAR
        || k == hostbase.K_TABLE || k == hostbase.K_TILE
}

fn hit_at(w: u64, x: u64, y: u64) -> u64 {
    if hostbase.s_nohit != 0 {
        return hostbase.MAXWD
    }
    var i: u64 = 0
    while i < hostbase.nwd {
        if hoststate.g(i, hostbase.D_WIN) == w && (hoststate.g(i, hostbase.D_FLAGS) & (hostbase.F_HIDE | hostbase.F_OFF)) == 0
            && !only_decoration(hoststate.g(i, hostbase.D_KIND)) {
            if x >= hoststate.g(i, hostbase.D_X) && x < hoststate.g(i, hostbase.D_X) + hoststate.g(i, hostbase.D_W) {
                if y >= hoststate.g(i, hostbase.D_Y) && y < hoststate.g(i, hostbase.D_Y) + hoststate.g(i, hostbase.D_H) {
                    return i
                }
            }
        }
        i = i + 1
    }
    return hostbase.MAXWD
}

fn only_decoration(k: u64) -> bool {
    return k == hostbase.K_CARD || k == hostbase.K_SEP
}

fn ease(curve: u64, t: u64) -> u64 {
    var p: u64 = t
    if p > 1000 {
        p = 1000
    }
    if curve == hostbase.EASE_OUT {
        let inv: u64 = 1000 - p
        return 1000 - inv * inv / 1000
    }
    if curve == EASE_IN_OUT {
        if p < 500 {
            return 2 * p * p / 1000
        }
        let inv2: u64 = 1000 - p
        return 1000 - 2 * inv2 * inv2 / 1000
    }
    return p
}

fn tg(i: u64, f: u64) -> u64 {
    return tw[(i * TW_FIELDS + f) as usize]
}

fn tset(i: u64, f: u64, v: u64) {
    tw[(i * TW_FIELDS + f) as usize] = v
}

fn motion_off() -> bool {
    return uitheme.motion(uitheme.MO_NORMAL) == 0
}

fn anim_start(was: u64, w: u64, wd: u64, level: u64, curve: u64) -> u64 {
    var i: u64 = 0
    var free: u64 = TW_MAX
    while i < tw_n {
        if tg(i, TW_STATE) != TW_FREE && tg(i, TW_WHAT) == was
            && tg(i, TW_WIN) == w && tg(i, TW_WD) == wd {
            free = i
            i = tw_n
        } else {
            i = i + 1
        }
    }
    if free == TW_MAX {
        var k: u64 = 0
        while k < TW_MAX && tg(k, TW_STATE) != TW_FREE {
            k = k + 1
        }
        if k >= TW_MAX {
            return TW_MAX
        }
        free = k
        if free >= tw_n {
            tw_n = free + 1
        }
    }
    let ms: u64 = uitheme.motion(level)
    var d: u64 = ms / MS_PRO_TICK
    if d == 0 {
        d = 1
    }
    tset(free, TW_STATE, TW_LAEUFT)
    tset(free, TW_T0, clockapi.ticks())
    tset(free, TW_DUR, d)
    tset(free, TW_CURVE, curve)
    tset(free, TW_WHAT, was)
    tset(free, TW_WIN, w)
    tset(free, TW_WD, wd)
    tset(free, TW_P, 0)
    tw_starts = tw_starts + 1
    if ms == 0 {
        tset(free, TW_P, 1000)
        tset(free, TW_STATE, TW_FERTIG)
    }
    return free
}

fn anim_at(was: u64, w: u64, wd: u64) -> u64 {
    var i: u64 = 0
    while i < tw_n {
        if tg(i, TW_STATE) != TW_FREE && tg(i, TW_WHAT) == was
            && tg(i, TW_WIN) == w && tg(i, TW_WD) == wd {
            return ease(tg(i, TW_CURVE), tg(i, TW_P))
        }
        i = i + 1
    }
    return 1000
}

fn anim_laeuft(was: u64, w: u64, wd: u64) -> bool {
    var i: u64 = 0
    while i < tw_n {
        if tg(i, TW_STATE) == TW_LAEUFT && tg(i, TW_WHAT) == was
            && tg(i, TW_WIN) == w && tg(i, TW_WD) == wd {
            return true
        }
        i = i + 1
    }
    return false
}

fn anim_stop(was: u64, w: u64, wd: u64) {
    var i: u64 = 0
    while i < tw_n {
        if tg(i, TW_STATE) != TW_FREE && tg(i, TW_WHAT) == was
            && tg(i, TW_WIN) == w && tg(i, TW_WD) == wd {
            tset(i, TW_STATE, TW_FREE)
        }
        i = i + 1
    }
}

fn say_anim(was: u64, wd: u64, p: u64, dur: u64) {
    if hostbase.s_trace == 0 {
        return
    }
    let b: u64 = (&hostbase.tr_buf[0 as usize]) as u64
    var at: u64 = hoststate.tr_put(b, 0, (&at_word[0 as usize]) as u64)
    at = hoststate.tr_put(b, at, (&an_was[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, was)
    at = hoststate.tr_put(b, at, (&an_wd[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, wd)
    at = hoststate.tr_put(b, at, (&an_p[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, p)
    at = hoststate.tr_put(b, at, (&an_dur[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, dur)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = lineout.add_bytes(b, at)
}

fn anim_tick() -> u64 {
    if tw_n == 0 {
        return 0
    }
    let now: u64 = clockapi.ticks()
    var active: u64 = 0
    var i: u64 = 0
    while i < tw_n {
        let st: u64 = tg(i, TW_STATE)
        if st == TW_LAEUFT {
            var p: u64 = 1000
            let d: u64 = tg(i, TW_DUR)
            let t0: u64 = tg(i, TW_T0)
            if now > t0 {
                let v: u64 = now - t0
                if v < d {
                    p = v * 1000 / d
                }
            } else {
                p = 0
            }
            if p != tg(i, TW_P) {
                tset(i, TW_P, p)
                let w: u64 = tg(i, TW_WIN)
                let wd: u64 = tg(i, TW_WD)
                if wd < hostbase.MAXWD && wd < hostbase.nwd {
                    hoststate.dirty_wd(wd)
                } else {
                    hoststate.dirty_all(w)
                }
                tw_frames = tw_frames + 1
                say_anim(tg(i, TW_WHAT), wd, p, d)
            }
            if p >= 1000 {
                tset(i, TW_STATE, TW_FERTIG)
            } else {
                active = active + 1
            }
        } else if st == TW_FERTIG {
            tset(i, TW_STATE, TW_FREE)
        }
        i = i + 1
    }
    while tw_n > 0 && tg(tw_n - 1, TW_STATE) == TW_FREE {
        tw_n = tw_n - 1
    }
    return active
}

fn anim_starts() -> u64 {
    return tw_starts
}

fn anim_frames() -> u64 {
    return tw_frames
}

const MR_PANEL: u64 = 1

fn draw_radius(rolle: u64) -> u64 {
    if rolle == hostbase.MR_GRIFF {
        return 0xFFFF
    }
    if rolle == MR_PANEL {
        return uitheme.metric(uitheme.M_RADIUS_PANEL)
    }
    if rolle == hostbase.MR_BUTTON {
        return uitheme.metric(uitheme.M_RADIUS_BUTTON)
    }
    if rolle == hostbase.MR_FIELD {
        return uitheme.metric(uitheme.M_RADIUS_INPUT)
    }
    return 0
}

const RT_BUTTON: u64 = 0

const RT_CARD: u64 = 3

const RT_KACHEL: u64 = 6

const RT_TYPEN: u64 = 14

static mut rt_button: [u8; 7] = "button\0"

static mut rt_field: [u8; 6] = "field\0"

static mut rt_list: [u8; 5] = "list\0"

static mut rt_card: [u8; 5] = "card\0"

static mut rt_menu: [u8; 5] = "menu\0"

static mut rt_tab: [u8; 4] = "tab\0"

static mut rt_kachel: [u8; 5] = "tile\0"

static mut rt_bahn: [u8; 6] = "track\0"

static mut rt_griff: [u8; 7] = "handle\0"

static mut rt_panel: [u8; 6] = "panel\0"

static mut rt_haken: [u8; 6] = "check\0"

static mut rt_select: [u8; 7] = "select\0"

static mut rt_table: [u8; 6] = "table\0"

static mut rt_bar: [u8; 4] = "bar\0"

fn radius_typ_name(typ: u64) -> u64 {
    if typ == RT_BUTTON {
        return (&rt_button[0 as usize]) as u64
    }
    if typ == hostbase.RT_FIELD {
        return (&rt_field[0 as usize]) as u64
    }
    if typ == hostbase.RT_LIST {
        return (&rt_list[0 as usize]) as u64
    }
    if typ == RT_CARD {
        return (&rt_card[0 as usize]) as u64
    }
    if typ == hostbase.RT_MENU {
        return (&rt_menu[0 as usize]) as u64
    }
    if typ == hostbase.RT_TAB {
        return (&rt_tab[0 as usize]) as u64
    }
    if typ == RT_KACHEL {
        return (&rt_kachel[0 as usize]) as u64
    }
    if typ == hostbase.RT_BAHN {
        return (&rt_bahn[0 as usize]) as u64
    }
    if typ == hostbase.RT_GRIFF {
        return (&rt_griff[0 as usize]) as u64
    }
    if typ == hostbase.RT_PANEL {
        return (&rt_panel[0 as usize]) as u64
    }
    if typ == hostbase.RT_HAKEN {
        return (&rt_haken[0 as usize]) as u64
    }
    if typ == hostbase.RT_SELECT {
        return (&rt_select[0 as usize]) as u64
    }
    if typ == hostbase.RT_TABLE {
        return (&rt_table[0 as usize]) as u64
    }
    return (&rt_bar[0 as usize]) as u64
}

static mut s_rgesagt: [u64; 14] = [0 as u64; 14]

static mut s_rzeilen: u64 = 0

static mut rr_a: [u8; 20] = "wlib: radius rolle=\0"

static mut rr_r: [u8; 5] = " r=\0\0"

static mut rr_t: [u8; 7] = " typ=\0\0"

static mut s_rreden: u64 = 0

fn radius_reden() -> bool {
    if hostbase.s_trace != 0 {
        return true
    }
    if s_rreden == 0 {
        s_rreden = 2
        var p_tr: [u8; 14] = "/etc/uitrace\0\0"
        let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
        if !ulib.bad(fdt) {
            io.close(fdt)
            s_rreden = 1
            fuib.radius_image(true)
        }
    }
    return s_rreden == 1
}

fn radius_apply() {
    var t: u64 = 0
    while t < RT_TYPEN {
        s_rgesagt[t as usize] = 0
        t = t + 1
    }
    s_rzeilen = 0
    fuib.radius_image(radius_reden())
}

fn say_radius(typ: u64, rolle: u64, r: u64, w: u64, h: u64) {
    if !radius_reden() || typ >= RT_TYPEN || s_rzeilen >= 64 {
        return
    }
    if s_rgesagt[typ as usize] == rolle + 1 {
        return
    }
    s_rgesagt[typ as usize] = rolle + 1
    s_rzeilen = s_rzeilen + 1
    var short_side: u64 = w
    if h < short_side {
        short_side = h
    }
    var eff: u64 = r
    if eff > short_side / 2 {
        eff = short_side / 2
    }
    lineout.add_text((&rr_a[0 as usize]) as u64)
    lineout.add_num(rolle)
    lineout.add_text((&rr_r[0 as usize]) as u64)
    lineout.add_num(eff)
    lineout.add_text((&rr_t[0 as usize]) as u64)
    lineout.add_text(radius_typ_name(typ))
    lineout.end_line()
}

fn typ_radius(typ: u64, rolle: u64, w: u64, h: u64) -> u64 {
    let r: u64 = draw_radius(rolle)
    say_radius(typ, rolle, r, w, h)
    return r
}
