const GR_A: u64 = 2

const GR_B: u64 = 3

const D_CT: u64 = 15

const D_ICONS: u64 = 16

const D_SELN: u64 = 26

const D_ANKER: u64 = 27

static mut zugname: [u8; 96] = [0 as u8; 96]

const TW_MAX: u64 = 16

const TW_FREE: u64 = 0

const TW_LAEUFT: u64 = 1

const TW_FERTIG: u64 = 2

const TW_STATE: u64 = 0

const TW_T0: u64 = 1

const TW_DUR: u64 = 2

const TW_CURVE: u64 = 3

const TW_WHAT: u64 = 4

const TW_WIN: u64 = 5

const TW_WD: u64 = 6

const TW_P: u64 = 7

const TW_FIELDS: u64 = 8

const EASE_IN_OUT: u64 = 2

const MS_PRO_TICK: u64 = 10

static mut tw: [u64; 128] = [0 as u64; 128]

static mut tw_n: u64 = 0

static mut tw_starts: u64 = 0

static mut tw_frames: u64 = 0

fn win_cap_strip(w: u64, on: bool) -> bool {
    if w >= hostbase.MAXWN || hoststate.ng(w, hostbase.N_H) == 0 {
        return false
    }
    var v: u64 = 0
    if on {
        v = 1
    }
    let h: u64 = hoststate.ng(w, hostbase.N_H)
    if ulib.bad(hostwin.win_state(h, hostwinp.WS_CAPSTRIP, v)) {
        return false
    }
    let nw: u64 = hostwin.win_info(h, hostwinp.WI_W)
    let nh: u64 = hostwin.win_info(h, hostwinp.WI_H)
    if !ulib.bad(nw) && !ulib.bad(nh) {
        note_resize(w, nw, nh)
    }
    return true
}

fn win_cap_w(w: u64) -> u64 {
    if w >= hostbase.MAXWN || hoststate.ng(w, hostbase.N_H) == 0 {
        return 0
    }
    return hostwin.win_info(hoststate.ng(w, hostbase.N_H), hostwinp.WI_CAPW)
}

static mut at_word: [u8; 12] = "wlib: anim \0"

static mut an_was: [u8; 5] = "was=\0"

static mut an_p: [u8; 4] = " p=\0"

static mut an_dur: [u8; 6] = " dur=\0"

static mut an_wd: [u8; 5] = " wd=\0"

fn place(i: u64) {
    let c: u64 = hoststate.g(i, D_CT)
    if c >= hostbase.MAXCT {
        return
    }
    let innen: u64 = hoststate.sub(hoststate.cg(c, hostbase.C_W), 2 * hoststate.cg(c, hostbase.C_PAD))
    let kind: u64 = hoststate.cg(c, hostbase.C_KIND)
    var pw: u64 = hoststate.g(i, hostbase.D_PW)
    var ph: u64 = hoststate.g(i, hostbase.D_PH)
    if ph == 0 {
        ph = 24
    }
    ph = hoststate.r4auf(ph)
    if kind == 1 {
        hoststate.s(i, hostbase.D_X, hoststate.cg(c, hostbase.C_CX))
        hoststate.s(i, hostbase.D_Y, hoststate.cg(c, hostbase.C_CY))
        var bw: u64 = hoststate.r4ab(innen)
        if pw != 0 && hoststate.r4auf(pw) < bw {
            bw = hoststate.r4auf(pw)
        }
        hoststate.s(i, hostbase.D_W, bw)
        var ph2: u64 = ph
        if hoststate.g(i, hostbase.D_KIND) == hostbase.K_TABS {
            ph2 = hoststate.r4auf(tab_h_at(i, bw))
        } else if hoststate.g(i, hostbase.D_KIND) == hostbase.K_LABEL
            && (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_UMBRUCH) != 0 {
            ph2 = hoststate.r4auf(hoststate.label_h_at(i, bw))
        }
        hoststate.s(i, hostbase.D_H, ph2)
        hoststate.cs(c, hostbase.C_CY, hoststate.cg(c, hostbase.C_CY) + ph2 + hoststate.cg(c, hostbase.C_GAP))
    } else if kind == 2 {
        let rest: u64 = hoststate.sub(hoststate.cg(c, hostbase.C_X) + hoststate.cg(c, hostbase.C_W) - hoststate.cg(c, hostbase.C_PAD),
            hoststate.cg(c, hostbase.C_CX))
        var bw2: u64 = hoststate.r4auf(pw)
        if pw == 0 || bw2 > hoststate.r4ab(rest) {
            bw2 = hoststate.r4ab(rest)
        }
        hoststate.s(i, hostbase.D_X, hoststate.cg(c, hostbase.C_CX))
        hoststate.s(i, hostbase.D_Y, hoststate.cg(c, hostbase.C_CY))
        hoststate.s(i, hostbase.D_W, bw2)
        var bh2: u64 = ph
        let up: u64 = hoststate.sub(hoststate.cg(c, hostbase.C_H), 2 * hoststate.cg(c, hostbase.C_PAD))
        if hoststate.g(i, hostbase.D_PH) == 0 && up > 0 {
            bh2 = hoststate.r4ab(up)
        }
        hoststate.s(i, hostbase.D_H, bh2)
        hoststate.cs(c, hostbase.C_CX, hoststate.cg(c, hostbase.C_CX) + bw2 + hoststate.cg(c, hostbase.C_GAP))
    } else {
        let cols: u64 = hoststate.cg(c, hostbase.C_COLS)
        var zw: u64 = 40
        if cols > 0 {
            zw = hoststate.sub(innen + hoststate.cg(c, hostbase.C_GAP), 0) / cols
            if zw > hoststate.cg(c, hostbase.C_GAP) {
                zw = zw - hoststate.cg(c, hostbase.C_GAP)
            }
            zw = hoststate.r4ab(zw)
        }
        hoststate.s(i, hostbase.D_X, hoststate.cg(c, hostbase.C_CX))
        hoststate.s(i, hostbase.D_Y, hoststate.cg(c, hostbase.C_CY))
        hoststate.s(i, hostbase.D_W, zw)
        hoststate.s(i, hostbase.D_H, ph)
        if ph > hoststate.cg(c, hostbase.C_ROWH) {
            hoststate.cs(c, hostbase.C_ROWH, ph)
        }
        hoststate.cs(c, hostbase.C_COL, hoststate.cg(c, hostbase.C_COL) + 1)
        if hoststate.cg(c, hostbase.C_COL) >= cols {
            hoststate.cs(c, hostbase.C_COL, 0)
            hoststate.cs(c, hostbase.C_CX, hoststate.cg(c, hostbase.C_X) + hoststate.cg(c, hostbase.C_PAD))
            hoststate.cs(c, hostbase.C_CY, hoststate.cg(c, hostbase.C_CY) + hoststate.cg(c, hostbase.C_ROWH) + hoststate.cg(c, hostbase.C_GAP))
            hoststate.cs(c, hostbase.C_ROWH, 0)
        } else {
            hoststate.cs(c, hostbase.C_CX, hoststate.cg(c, hostbase.C_CX) + zw + hoststate.cg(c, hostbase.C_GAP))
        }
    }
    if hostbase.want_gap != 0 {
        if kind == 2 {
            hoststate.cs(c, hostbase.C_CX, hoststate.cg(c, hostbase.C_CX) + hostbase.want_gap)
        } else {
            hoststate.cs(c, hostbase.C_CY, hoststate.cg(c, hostbase.C_CY) + hostbase.want_gap)
        }
        hostbase.want_gap = 0
    }
}

fn note_resize(w: u64, nw: u64, nh: u64) {
    if w >= hostbase.MAXWN || hoststate.ng(w, hostbase.N_H) == 0 {
        return
    }
    hoststate.ns(w, hostbase.N_W, nw)
    hoststate.ns(w, hostbase.N_HH, nh)
    relayout()
    hoststate.dirty_all(w)
    hostbase.s_reseq = hostbase.s_reseq + 1
}

fn relayout() {
    var c: u64 = 0
    while c < hostbase.nct {
        let w: u64 = hoststate.cg(c, hostbase.C_WIN)
        if hoststate.cg(c, hostbase.C_W) == 0 {
            hoststate.cs(c, hostbase.C_W, hoststate.ng(w, hostbase.N_W))
        }
        hoststate.reset_box(c)
        c = c + 1
    }
    var i: u64 = 0
    while i < hostbase.nwd {
        if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_HIDE) == 0 {
            place(i)
        }
        i = i + 1
    }
}

fn reshape() {
    var i: u64 = 0
    while i < hostbase.nwd {
        let k: u64 = hoststate.g(i, hostbase.D_KIND)
        if k == hostbase.K_BUTTON {
            hoststate.s(i, hostbase.D_H, uitheme.metric(uitheme.M_CTRL_H))
            let t: u64 = hoststate.g(i, hostbase.D_TEXT)
            let want: u64 = uitext.text_w(uitext.F_UI, uiscale.px_ui(), t, hoststate.tlen(t))
                + uitheme.metric(uitheme.M_PAD_X) * 2

            if hoststate.g(i, hostbase.D_W) < want {
                hoststate.s(i, hostbase.D_W, want)
            }
        } else if k == hostbase.K_TABS {
            hoststate.s(i, hostbase.D_H, uitheme.metric(uitheme.M_CTRL_H))
        } else if k == hostbase.K_ENTRY || k == hostbase.K_CHOICE {
            hoststate.s(i, hostbase.D_H, hoststate.ctrl_thin())
        } else if k == hostbase.K_CHECK || k == hostbase.K_MENUBAR || k == hostbase.K_SLIDER {
            hoststate.s(i, hostbase.D_H, hoststate.ctrl_small())
        } else if k == hostbase.K_SEP {
            hoststate.s(i, hostbase.D_H, hoststate.sep_h())
        } else if k == hostbase.K_SCROLL {
            hoststate.s(i, hostbase.D_W, hoststate.scroll_w())
        } else if k == hostbase.K_TILE {
            hoststate.s(i, hostbase.D_H, hoststate.tile_h())
        }
        i = i + 1
    }
    relayout()
}

static mut s_vollwarn: [u8; 42] = "wlib: WIDGETTAFEL VOLL -- MAXWD erreicht\n\0"

fn add(kind: u64, txt: u64, pw: u64, ph: u64, fokus: bool) -> u64 {
    if hostbase.nwd >= hostbase.MAXWD {
        let _vw: u64 = lineout.add_text((&s_vollwarn[0 as usize]) as u64)
        return 0
    }
    let i: u64 = hostbase.nwd
    hostbase.nwd = hostbase.nwd + 1
    hoststate.s(i, hostbase.D_KIND, kind)
    hoststate.s(i, hostbase.D_TEXT, txt)
    hoststate.s(i, hostbase.D_WIN, hostbase.wncur)
    hoststate.s(i, D_CT, hostbase.ctcur)
    hoststate.s(i, hostbase.D_PW, hostbase.want_w)
    hoststate.s(i, hostbase.D_PH, hostbase.want_h)
    if hostbase.want_w == 0 {
        hoststate.s(i, hostbase.D_PW, pw)
    }
    if hostbase.want_h == 0 {
        hoststate.s(i, hostbase.D_PH, ph)
    }
    hostbase.want_w = 0
    hostbase.want_h = 0
    var fl: u64 = hostbase.want_flags
    hostbase.want_flags = 0
    if fokus {
        fl = fl | hostbase.F_FOCUSABLE
    }
    hoststate.s(i, hostbase.D_FLAGS, fl)
    place(i)
    if hostbase.s_focus == 0 && fokus {
        hostbase.s_focus = i + 1
    }
    return i
}

fn label(txt: u64) -> u64 {
    return add(hostbase.K_LABEL, txt, 0, uitext.text_h(uiscale.px_ui()), false)
}

fn card() -> u64 {
    return add(hostbase.K_CARD, 0, 0, 0, false)
}

fn graph(spec: u64) -> u64 {
    let i: u64 = add(hostbase.K_GRAPH, 0, 0, 0, false)
    hoststate.s(i, hostbase.D_A, spec)
    return i
}

fn canvas(px: u64, bw: u64, bh: u64) -> u64 {
    let i: u64 = add(hostbase.K_CANVAS, px, bw, bh, true)
    hoststate.s(i, hostbase.D_A, bw)
    hoststate.s(i, hostbase.D_B, bh)
    hoststate.s(i, hostbase.D_C, bw)
    return i
}

fn paint_graph(i: u64) {
    let x: u64 = hoststate.g(i, hostbase.D_X)
    let y: u64 = hoststate.g(i, hostbase.D_Y)
    let bw: u64 = hoststate.g(i, hostbase.D_W)
    let bh: u64 = hoststate.g(i, hostbase.D_H)
    if bw < 8 || bh < 8 {
        return
    }
    let r: u64 = typ_radius(hostbase.RT_PANEL, MR_PANEL, bw, bh)
    fuib.rrect(x, y, bw, bh, r,
        thquery.theme_semantic(uitheme.S_SURFACE_SUNKEN))
    fuib.rring(x, y, bw, bh, r, 1, thquery.theme_semantic(uitheme.S_BORDER))
    var q: u64 = 1
    while q < 4 {
        fuib.hline(x + 1, y + bh * q / 4, hoststate.sub(bw, 2),
            thquery.theme_semantic(uitheme.S_BORDER))
        q = q + 1
    }
    hoststate.paint_curve(i, hoststate.gspec(i, GR_B), thquery.theme_semantic(uitheme.S_SUCCESS),
        false)
    hoststate.paint_curve(i, hoststate.gspec(i, GR_A), thquery.theme_semantic(uitheme.S_ACCENT),
        true)
}

fn button(txt: u64) -> u64 {
    let pad: u64 = uitheme.metric(uitheme.M_PAD_X)
    let w: u64 = uitext.text_w(uitext.F_UI, uiscale.px_ui(), txt, hoststate.tlen(txt))
        + pad * 2
    return add(hostbase.K_BUTTON, txt, w, uitheme.metric(uitheme.M_CTRL_H), true)
}

fn icon_button(cp: u64, txt: u64) -> u64 {
    let h: u64 = uitheme.metric(uitheme.M_CTRL_H)
    let i: u64 = add(hostbase.K_BUTTON, txt, h, h, true)
    if i < hostbase.MAXWD {
        hoststate.s(i, hostbase.D_BICON, cp)
    }
    return i
}

fn check(txt: u64, on: bool) -> u64 {
    let i: u64 = add(hostbase.K_CHECK, txt, 0, hoststate.ctrl_small(), true)
    if on {
        hoststate.s(i, hostbase.D_VAL, 1)
    }
    return i
}

fn entry(buf: u64, max: u64) -> u64 {
    let i: u64 = add(hostbase.K_ENTRY, buf, 0, hoststate.ctrl_thin(), true)
    hoststate.s(i, hostbase.D_D, max)
    hoststate.s(i, hostbase.D_B, hoststate.tlen(buf))
    hoststate.s(i, hostbase.D_C, hoststate.tlen(buf))
    return i
}

fn list(blob: u64, rows: u64) -> u64 {
    let i: u64 = add(hostbase.K_LIST, blob, 0, rows * hoststate.lines_height() + 4, true)
    hoststate.s(i, hostbase.D_VAL, 0)
    hoststate.s(i, hostbase.D_A, 0)
    hoststate.count_rows(i)
    return i
}

fn table(blob: u64, rows: u64, cols: u64, breiten: u64) -> u64 {
    let i: u64 = add(hostbase.K_TABLE, blob, 0,
        rows * hoststate.lines_height() + hoststate.lines_height() + 4, true)
    hoststate.s(i, hostbase.D_C, cols)
    hoststate.s(i, hostbase.D_D, breiten)
    hoststate.s(i, hostbase.D_VAL, 0)
    hoststate.s(i, hostbase.D_A, 0)
    hoststate.count_rows(i)
    return i
}

fn tabs(txt: u64) -> u64 {
    return add(hostbase.K_TABS, txt, 0, uitheme.metric(uitheme.M_CTRL_H), true)
}

fn menubar(txt: u64) -> u64 {
    return add(hostbase.K_MENUBAR, txt, 0, hoststate.ctrl_small(), false)
}

fn choice(txt: u64, sel: u64) -> u64 {
    let i: u64 = add(hostbase.K_CHOICE, txt, 0, hoststate.ctrl_thin(), true)
    hoststate.s(i, hostbase.D_VAL, sel)
    return i
}

fn image(p: u64, w: u64, h: u64) -> u64 {
    let i: u64 = add(hostbase.K_IMAGE, 0, 0, 0, true)
    hoststate.s(i, hostbase.D_E, p)
    hoststate.s(i, hostbase.D_F, w)
    hoststate.s(i, hostbase.D_G, h)
    hoststate.s(i, hostbase.D_ZOOM, 100)
    hoststate.s(i, hostbase.D_PX, 0)
    hoststate.s(i, hostbase.D_PY, 0)
    hoststate.s(i, hostbase.D_ROTATION, 0)
    return i
}

fn slider(min: u64, max: u64, cur_value: u64) -> u64 {
    let i: u64 = add(hostbase.K_SLIDER, 0, 0, hoststate.ctrl_small(), true)
    hoststate.s(i, hostbase.D_E, min)
    hoststate.s(i, hostbase.D_F, max)
    if max <= min {
        hoststate.s(i, hostbase.D_F, min + 1)
    }
    hoststate.s(i, hostbase.D_VAL, cur_value)
    return i
}

fn sep() -> u64 {
    return add(hostbase.K_SEP, 0, 0, hoststate.sep_h(), false)
}

const TP_W: u64 = 92

const TP_BAR: u64 = 5

const TP_BTN: u64 = 14

const TP_WX: u64 = 8

const TP_WY: u64 = 6

const TP_WW: u64 = 60

const TP_TITLE: u64 = 7

const TP_LINE: u64 = 2

const TP_MARK: u64 = 22

const TP_EIN: u64 = 4

const TL_SURFACE: u64 = 0

const TL_RAISED: u64 = 1

const TL_ACCENT: u64 = 2

const TL_ONACCENT: u64 = 3

const TL_TEXT: u64 = 4

const TL_FRAME: u64 = 5

const TL_TASKBAR: u64 = 6

const TL_BUTTON: u64 = 8

const TL_RADW: u64 = 9

const TL_RADB: u64 = 10

const TL_SHADOW: u64 = 11

const TL_EDGE: u64 = 12

const TL_ALIGN: u64 = 13

const TL_NAME: u64 = 14

const TL_LOW: u64 = 15

const TL_DANGER: u64 = 16

fn tile(spec: u64) -> u64 {
    let i: u64 = add(hostbase.K_TILE, 0, 0, hoststate.tile_h(), true)
    hoststate.s(i, hostbase.D_A, spec)
    return i
}

fn paint_tile(i: u64) {
    let x: u64 = hoststate.g(i, hostbase.D_X)
    let y: u64 = hoststate.g(i, hostbase.D_Y)
    let w: u64 = hoststate.g(i, hostbase.D_W)
    let h: u64 = hoststate.g(i, hostbase.D_H)
    if w < 40 || h < 20 {
        return
    }

    let rk: u64 = typ_radius(RT_KACHEL, MR_PANEL, w, h)
    var ein: u64 = rk
    if ein < TP_EIN {
        ein = TP_EIN
    }
    let pw: u64 = TP_W
    var px: u64 = hoststate.sub(x + hoststate.sub(w, pw), ein)
    if px < x + ein {
        px = x + ein
    }
    let ph: u64 = hoststate.sub(h, 8)
    let py: u64 = y + 4
    let sel: bool = hoststate.g(i, hostbase.D_VAL) != 0
    fuib.rrect(x, y, w, h, rk, hoststate.tspec(i, TL_SURFACE))
    if sel {
        let fw: u64 = uitheme.metric(uitheme.M_FOCUS) + 1
        if !fuib.ring(x, y, w, h, rk, fw, thquery.theme(uitheme.T_FOCUS)) {
            fuib.rring(x, y, w, h, rk, fw, thquery.theme(uitheme.T_FOCUS))
        }
    } else {
        fuib.rring(x, y, w, h, rk, 1,
            hoststate.tspec(i, TL_FRAME))
    }

    let e: u64 = hoststate.tspec(i, TL_EDGE)
    let bar: u64 = TP_BAR
    var bx: u64 = px
    var by: u64 = py
    var bw2: u64 = pw
    var bh2: u64 = bar
    if e == 1 {
        by = py
    } else if e == 2 {
        bw2 = bar
        bh2 = ph
    } else if e == 3 {
        bx = px + pw - bar
        bw2 = bar
        bh2 = ph
    } else {
        by = py + ph - bar
    }

    fuib.rect(px, py, pw, ph, hoststate.tspec(i, TL_SURFACE))
    fuib.rect(bx, by, bw2, bh2, hoststate.tspec(i, TL_TASKBAR))
    say_bar(hoststate.g(i, hostbase.D_WIN), bx, by, bw2, bh2, x, y, w, h, ein)

    let blen: u64 = TP_BTN
    if e == 2 || e == 3 {
        var byy: u64 = by + 3
        if hoststate.tspec(i, TL_ALIGN) == 1 {
            byy = by + hoststate.sub(bh2, blen) / 2
        }
        fuib.rect(bx + 1, byy, hoststate.sub(bar, TP_LINE), blen, hoststate.tspec(i, TL_ACCENT))
        say_bar(hoststate.g(i, hostbase.D_WIN), bx + 1, byy, hoststate.sub(bar, TP_LINE), blen,
            x, y, w, h, ein)
    } else {
        var bxx: u64 = bx + 3
        if hoststate.tspec(i, TL_ALIGN) == 1 {
            bxx = bx + hoststate.sub(bw2, blen) / 2
        }
        fuib.rect(bxx, by + 1, blen, hoststate.sub(bar, TP_LINE), hoststate.tspec(i, TL_ACCENT))
        say_bar(hoststate.g(i, hostbase.D_WIN), bxx, by + 1, blen, hoststate.sub(bar, TP_LINE),
            x, y, w, h, ein)
    }

    var wx: u64 = px + TP_WX
    var wy: u64 = py + TP_WY
    if e == 1 {
        wy = py + TP_WY + 3
    }
    if e == 2 {
        wx = px + TP_WX + 4
    }
    let ww: u64 = TP_WW
    let wh: u64 = hoststate.sub(ph, TP_WY * 2)
    if wh < 10 {
        return
    }
    fuib.shadow(wx, wy, ww, wh, hoststate.tspec(i, TL_RADW),
        hoststate.tspec(i, TL_SHADOW), 3, hoststate.tspec(i, TL_TEXT))
    fuib.rframe(wx, wy, ww, wh, hoststate.tspec(i, TL_RADW), 1,
        hoststate.tspec(i, TL_FRAME), hoststate.tspec(i, TL_RAISED))

    let th: u64 = TP_TITLE
    fuib.rrect(wx + 1, wy + 1, ww - 2, th, hoststate.tspec(i, TL_RADW),
        hoststate.tspec(i, TL_ACCENT))
    fuib.rect(wx + 1, wy + th - 2, ww - 2, TP_LINE + 1, hoststate.tspec(i, TL_ACCENT))
    fuib.rect(wx + 4, wy + 3, TP_MARK, TP_LINE, hoststate.tspec(i, TL_ONACCENT))

    fuib.rect(wx + 4, wy + th + 4, ww - TP_BTN, TP_LINE, hoststate.tspec(i, TL_TEXT))
    let byb: u64 = wy + wh - TP_TITLE - 3
    if byb > wy + th + 6 {
        fuib.rframe(wx + 4, byb, TP_MARK + 2, TP_TITLE + 1, hoststate.tspec(i, TL_RADB), 1,
            hoststate.tspec(i, TL_FRAME), hoststate.tspec(i, TL_BUTTON))
    }

    let nm: u64 = hoststate.tspec(i, TL_NAME)
    let asc: u64 = uitext.ascent_of(uitext.F_UI, uiscale.px_ui())
    let tw: u64 = hoststate.sub(hoststate.sub(px, x), 12)
    var col: u64 = hoststate.tspec(i, TL_TEXT)
    if hoststate.tspec(i, TL_LOW) != 0 {
        col = hoststate.tspec(i, TL_DANGER)
    }

    let base: u64 = y + hoststate.sub(h, uitext.text_h(uiscale.px_ui())) / 2 + asc
    let _p: u64 = hoststate.put_text(uitext.F_UI, uiscale.px_ui(), x + 8,
        base, tw, nm, hoststate.tlen(nm), col, 0)
    hoststate.say_painted(hoststate.g(i, hostbase.D_WIN), hostbase.K_TILE, base, col,
        hoststate.tspec(i, TL_SURFACE), nm, hoststate.tlen(nm))
}

fn scrollarea(rows: u64, sicht: u64) -> u64 {
    let i: u64 = add(hostbase.K_SCROLL, 0, hoststate.scroll_w(), 0, false)
    hoststate.s(i, hostbase.D_A, rows)
    hoststate.s(i, hostbase.D_B, sicht)
    return i
}

fn new_set() {
    relayout()
    var w: u64 = 0
    while w < hostbase.nwn {
        if hoststate.ng(w, hostbase.N_H) != 0 {
            hoststate.dirty_all(w)
        }
        w = w + 1
    }
}

fn focus_ring(i: u64) {
    focus_ring_at(i, hoststate.g(i, hostbase.D_X), hoststate.g(i, hostbase.D_Y), hoststate.g(i, hostbase.D_W), hoststate.g(i, hostbase.D_H))
}

fn focus_ring_at(i: u64, rx: u64, ry: u64, rw: u64, rh: u64) {
    if hostbase.s_focus != i + 1 || rw == 0 || rh == 0 {
        return
    }
    if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_MAIN) != 0 && rx >= 3 && ry >= 3 {
        if fuib.ring(rx - 3, ry - 3, rw + 6, rh + 6, draw_radius(hostbase.MR_BUTTON) + 3,
            uitheme.metric(uitheme.M_FOCUS), thquery.theme(uitheme.T_FG)) {
            return
        }
    }
    if fuib.ring(rx, ry, rw, rh, draw_radius(hostbase.MR_BUTTON),
        uitheme.metric(uitheme.M_FOCUS), thquery.theme(uitheme.T_FOCUS)) {
        return
    }
    fuib.rring(rx, ry, rw, rh, draw_radius(hostbase.MR_BUTTON),
        uitheme.metric(uitheme.M_FOCUS), thquery.theme(uitheme.T_FOCUS))
}

fn paint_scroll(x: u64, y: u64, h: u64, top: u64, sicht: u64,
    int: u64) {
    let _fb3: bool = fuib.area(x, y, hoststate.scroll_w(), h, thquery.theme(uitheme.T_SCROLL))
    if int == 0 || sicht >= int {
        return
    }
    var th: u64 = h * sicht / int
    if th < 12 {
        th = 12
    }
    if th > h {
        th = h
    }
    var ty: u64 = 0
    if int > sicht {
        ty = (h - th) * top / (int - sicht)
    }
    let _fb4: bool = fuib.board(x + 2, y + ty, hoststate.thumb_w(), th,
        typ_radius(hostbase.RT_GRIFF, hostbase.MR_GRIFF, hoststate.thumb_w(), th),
        thquery.theme(uitheme.T_THUMB), 0, 0)
}

fn paint_button(i: u64) {
    let x: u64 = hoststate.g(i, hostbase.D_X)
    let y: u64 = hoststate.g(i, hostbase.D_Y)
    let bw: u64 = hoststate.g(i, hostbase.D_W)
    let bh: u64 = hoststate.g(i, hostbase.D_H)
    var area: u64 = thquery.theme(uitheme.T_BTN)
    if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_PRESSED) != 0 {
        area = thquery.theme(uitheme.T_BTNDN)
    } else if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_HOVER) != 0 {
        area = thquery.theme(uitheme.T_BTNHI)
    }

    if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_MAIN) != 0 {
        area = thquery.theme(uitheme.C_ACCENT)
        if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_PRESSED) != 0 {
            area = thquery.theme(uitheme.C_ACCENT_PRESSED)
        } else if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_HOVER) != 0 {
            area = thquery.theme(uitheme.C_ACCENT_HOVER)
        }
    }

    let rb: u64 = typ_radius(RT_BUTTON, hostbase.MR_BUTTON, bw, bh)
    var gerahmt: bool = false
    fuib.main((hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_MAIN) != 0)
    let fui_ok: bool = fuib.draw(fuib.S_BUTTON, x, y, bw, bh, hoststate.fui_state(i), 0)
    fuib.main(false)
    if fui_ok {
    } else {
    if rb == 0 {
        fuib.rect(x, y, bw, bh, area)
        fuib.frame3(x, y, bw, bh, thquery.theme(uitheme.T_BTNHI),
            thquery.theme(uitheme.T_LINE), (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_PRESSED) != 0)
    } else {

        fuib.rrect(x, y, bw, bh, rb, thquery.theme(uitheme.T_LINE))
        var bo: u64 = uitheme.metric(uitheme.M_BORDER)
        if 2 * bo >= bw || 2 * bo >= bh {
            bo = 0
        }
        var ri: u64 = 0
        if rb > bo {
            ri = rb - bo
        }
        fuib.rrect(x + bo, y + bo, bw - 2 * bo, bh - 2 * bo,
            ri, area)
    }
    gerahmt = true
    }
    if !gerahmt {
        var kb: u64 = uitheme.metric(uitheme.M_BORDER)
        if kb == 0 {
            kb = 1
        }
        let _edge: bool = fuib.ring(x, y, bw, bh, rb, kb,
            thquery.theme(uitheme.T_LINE))
    }
    say_button(hoststate.g(i, hostbase.D_WIN), x, y, bw, bh, rb)
    var color: u64 = thquery.theme(uitheme.T_FG)
    if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_MAIN) != 0 {
        color = thquery.theme(uitheme.C_ON_ACCENT)
    }
    if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_OFF) != 0 {
        color = thquery.theme(uitheme.T_DIM)
    }
    let baseline: u64 = y + (bh + uitext.ascent_of(uitext.F_UI, uiscale.px_ui())) / 2
    let sym: u64 = hoststate.g(i, hostbase.D_BICON)
    if sym != 0 {
        let k: u64 = uiicon.icon_small()
        let _ok: bool = uiicon.icon_at(sym, x + (bw - k) / 2,
            y + (bh - k) / 2, k, color)
    } else {
        hoststate.put_text(uitext.F_UI, uiscale.px_ui(), x, baseline, bw, hoststate.g(i, hostbase.D_TEXT),
            hoststate.tlen(hoststate.g(i, hostbase.D_TEXT)), color, 1)
    }
    hoststate.say_painted(hoststate.g(i, hostbase.D_WIN), hostbase.K_BUTTON, baseline, color, area,
        hoststate.g(i, hostbase.D_TEXT), hoststate.tlen(hoststate.g(i, hostbase.D_TEXT)))
    focus_ring(i)
}

fn wrap_split(f: u64, pxs: u64, p: u64, n: u64, limit: u64) -> u64 {
    let k: u64 = fit_n(f, pxs, p, n, limit)
    if k == 0 || k >= n {
        return n
    }
    var b: u64 = k
    while b > 0 {
        if __mmio_read8((p + b) as *mut u8) == 32 as u8 {
            return b
        }
        b = b - 1
    }
    return k
}

fn paint_label(i: u64) {
    let zh: u64 = uitext.text_h(uiscale.px_ui())
    let asc: u64 = uitext.ascent_of(uitext.F_UI, uiscale.px_ui())
    let baseline: u64 = hoststate.g(i, hostbase.D_Y) + asc
    let voll: u64 = hoststate.g(i, hostbase.D_TEXT)
    let vn: u64 = hoststate.tlen(voll)
    let bw: u64 = hoststate.g(i, hostbase.D_W)
    if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_UMBRUCH) != 0 && vn > 0
        && uitext.text_w(uitext.F_UI, uiscale.px_ui(), voll, vn) > bw {
        let n1: u64 = wrap_split(uitext.F_UI, uiscale.px_ui(), voll, vn, bw)
        hoststate.put_text(uitext.F_UI, uiscale.px_ui(), hoststate.g(i, hostbase.D_X), baseline, bw,
            voll, n1, thquery.theme(uitheme.T_FG), 0)
        hoststate.say_painted(hoststate.g(i, hostbase.D_WIN), hostbase.K_LABEL, baseline, thquery.theme(uitheme.T_FG),
            hoststate.bg_of(hoststate.g(i, hostbase.D_WIN)), voll, n1)
        var st: u64 = n1
        if st < vn && __mmio_read8((voll + st) as *mut u8) == 32 as u8 {
            st = st + 1
        }
        var q2: u64 = voll + st
        var n2: u64 = hoststate.sub(vn, st)
        let el2: u64 = elide(uitext.F_UI, uiscale.px_ui(), q2, n2, bw)
        var nq2: u64 = n2
        if el2 != 0 {
            q2 = (&hostbase.el_buf[0 as usize]) as u64
            n2 = el2
            nq2 = hoststate.sub(el2, 3)
        }
        hoststate.put_text(uitext.F_UI, uiscale.px_ui(), hoststate.g(i, hostbase.D_X), baseline + zh, bw,
            q2, n2, thquery.theme(uitheme.T_FG), 0)
        hoststate.say_painted_n(hoststate.g(i, hostbase.D_WIN), hostbase.K_LABEL, baseline + zh,
            thquery.theme(uitheme.T_FG), hoststate.bg_of(hoststate.g(i, hostbase.D_WIN)), q2, n2, nq2,
            hoststate.sub(vn, st))
        return
    }
    var q: u64 = voll
    var qn: u64 = vn
    let el: u64 = elide(uitext.F_UI, uiscale.px_ui(), q, qn, bw)
    var nq: u64 = qn
    if el != 0 {
        q = (&hostbase.el_buf[0 as usize]) as u64
        qn = el
        nq = hoststate.sub(el, 3)
    }
    hoststate.put_text(uitext.F_UI, uiscale.px_ui(), hoststate.g(i, hostbase.D_X), baseline, bw,
        q, qn, thquery.theme(uitheme.T_FG), 0)
    hoststate.say_painted_n(hoststate.g(i, hostbase.D_WIN), hostbase.K_LABEL, baseline, thquery.theme(uitheme.T_FG),
        hoststate.bg_of(hoststate.g(i, hostbase.D_WIN)), q, qn, nq, vn)
}

fn password(buf: u64, max: u64) -> u64 {
    let i: u64 = entry(buf, max)
    if i < hostbase.MAXWD {
        hoststate.s(i, hostbase.D_FLAGS, hoststate.g(i, hostbase.D_FLAGS) | hostbase.F_SECRET | hostbase.F_PASSWORD)
    }
    return i
}

fn password_show(i: u64, on: bool) {
    if i >= hostbase.nwd || (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_PASSWORD) == 0 {
        return
    }
    if on {
        hoststate.s(i, hostbase.D_FLAGS, hoststate.g(i, hostbase.D_FLAGS) & ~hostbase.F_SECRET)
    } else {
        hoststate.s(i, hostbase.D_FLAGS, hoststate.g(i, hostbase.D_FLAGS) | hostbase.F_SECRET)
    }
    hoststate.dirty_wd(i)
    if hostbase.s_trace != 0 {
        var s_e: [u8; 14] = "wlib: eye id=\0"
        var s_v: [u8; 8] = " shown=\0"
        hostbase.tl_at = 0
        hoststate.tl_s((&s_e[0 as usize]) as u64)
        hoststate.tl_n(i)
        hoststate.tl_s((&s_v[0 as usize]) as u64)
        var v: u64 = 0
        if on {
            v = 1
        }
        hoststate.tl_n(v)
        var s_l: [u8; 6] = " len=\0"
        hoststate.tl_s((&s_l[0 as usize]) as u64)
        hoststate.tl_n(hoststate.tlen(hoststate.g(i, hostbase.D_TEXT)))
        hoststate.say_pid()
        hoststate.tl_end()
    }
}

fn eye_w(i: u64) -> u64 {
    if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_PASSWORD) == 0 {
        return 0
    }
    return hoststate.g(i, hostbase.D_H)
}

fn eye_hit(i: u64, x: u64) -> bool {
    let ew: u64 = eye_w(i)
    if ew == 0 {
        return false
    }
    return x + ew >= hoststate.g(i, hostbase.D_X) + hoststate.g(i, hostbase.D_W)
}

static mut s_eye_last: u64 = 0xFFFFFFFFFFFFFFFF

fn paint_eye(i: u64) {
    let ew: u64 = eye_w(i)
    if ew == 0 {
        return
    }
    let x: u64 = hoststate.g(i, hostbase.D_X) + hoststate.g(i, hostbase.D_W) - ew
    let y: u64 = hoststate.g(i, hostbase.D_Y)

    var id: u64 = icons.EYE
    if hoststate.password_shown(i) {
        id = icons.EYE_OFF
    }
    let px_: u64 = uiicon.icon_small()
    var ox: u64 = 0
    let iw: u64 = uiicon.icon_ink_w(id, px_)
    if ew > iw {
        ox = (ew - iw) / 2
    }
    let _e: bool = uiicon.icon_mid(id, x + ox, y, hoststate.g(i, hostbase.D_H), px_,
        thquery.theme(uitheme.T_FG))
    var sv: u64 = 0
    if hoststate.password_shown(i) {
        sv = 1
    }

    let key: u64 = (x << 32) | (y << 1) | sv
    if hostbase.s_trace != 0 && key != s_eye_last {
        s_eye_last = key
        var s_e: [u8; 17] = "wlib: eyerect x=\0"
        var s_y: [u8; 4] = " y=\0"
        var s_w: [u8; 4] = " w=\0"
        var s_s: [u8; 8] = " shown=\0"
        hostbase.tl_at = 0
        hoststate.tl_s((&s_e[0 as usize]) as u64)
        hoststate.tl_n(x)
        hoststate.tl_s((&s_y[0 as usize]) as u64)
        hoststate.tl_n(y)
        hoststate.tl_s((&s_w[0 as usize]) as u64)
        hoststate.tl_n(ew)
        hoststate.tl_s((&s_s[0 as usize]) as u64)
        hoststate.tl_n(sv)
        hoststate.say_pid()
        hoststate.tl_end()
    }
}

fn list_icons(i: u64, p: u64) {
    hoststate.s(i, hostbase.D_D, p)
    hoststate.dirty_wd(i)
}

const ICON_TAG: u64 = 9223372036854775808

fn icon_tint(word: u64, rgb: u64) -> u64 {
    return word | 72057594037927936 | ((rgb & 16777215) << 32)
}

fn icon_id(c: u64) -> u64 {
    return ICON_TAG | c
}

fn row_icons(i: u64, p: u64) {
    hoststate.s(i, D_ICONS, p)
    hoststate.dirty_wd(i)
}

fn sel_an(i: u64, field: u64, lines: u64) {
    if i >= hostbase.MAXWD {
        return
    }
    hoststate.s(i, hostbase.D_SELP, field)
    hoststate.s(i, D_SELN, lines)
    hoststate.s(i, D_ANKER, 0)
    hoststate.dirty_wd(i)
}

fn sel_hat(i: u64, z: u64) -> bool {
    let p: u64 = hoststate.g(i, hostbase.D_SELP)
    if p == 0 || z >= hoststate.g(i, D_SELN) {
        return false
    }
    let byte: u64 = __mmio_read8((p + z / 8) as *mut u8) as u64
    return (byte & (1 << (z % 8))) != 0
}

fn sel_set(i: u64, z: u64, an: bool) {
    let p: u64 = hoststate.g(i, hostbase.D_SELP)
    if p == 0 || z >= hoststate.g(i, D_SELN) {
        return
    }
    let at: u64 = p + z / 8
    var byte: u64 = __mmio_read8((at) as *mut u8) as u64
    let bit: u64 = 1 << (z % 8)
    if an {
        byte = byte | bit
    } else {
        byte = byte & ~bit
    }
    __mmio_write8((at) as *mut u8, byte as u8)
    hoststate.dirty_wd(i)
}

fn sel_clear(i: u64) {
    let p: u64 = hoststate.g(i, hostbase.D_SELP)
    if p == 0 {
        return
    }
    var k: u64 = 0
    let n: u64 = (hoststate.g(i, D_SELN) + 7) / 8
    while k < n {
        __mmio_write8((p + k) as *mut u8, 0 as u8)
        k = k + 1
    }
    hoststate.dirty_wd(i)
}

fn sel_all(i: u64) {
    let p: u64 = hoststate.g(i, hostbase.D_SELP)
    if p == 0 {
        return
    }
    var int: u64 = hoststate.g(i, hostbase.D_A)
    if hoststate.g(i, hostbase.D_KIND) == hostbase.K_TABLE {
        int = hoststate.sub(int, 1)
    }
    if int > hoststate.g(i, D_SELN) {
        int = hoststate.g(i, D_SELN)
    }
    sel_clear(i)
    var z: u64 = 0
    while z < int {
        sel_set(i, z, true)
        z = z + 1
    }
    hoststate.dirty_wd(i)
}

fn sel_bereich(i: u64, bis: u64) {
    if hoststate.g(i, hostbase.D_SELP) == 0 {
        return
    }
    var von: u64 = hoststate.g(i, D_ANKER)
    var b: u64 = bis
    if von > b {
        let t: u64 = von
        von = b
        b = t
    }
    sel_clear(i)
    var z: u64 = von
    while z <= b {
        sel_set(i, z, true)
        z = z + 1
    }
    hoststate.dirty_wd(i)
}

fn sel_anker(i: u64, z: u64) {
    hoststate.s(i, D_ANKER, z)
}

fn sel_anker_von(i: u64) -> u64 {
    if i >= hostbase.MAXWD {
        return 0
    }
    return hoststate.g(i, D_ANKER)
}

fn sel_frame() -> u64 {
    return hostbase.s_frame
}

fn drop_an(an: bool) {
    if an {
        hostbase.s_dropan = 1
    } else {
        hostbase.s_dropan = 0
    }
}

fn drop_count() -> u64 {
    return hostbase.s_drops
}

fn drag_starts() -> u64 {
    return hostbase.s_drags
}

fn drop_x() -> u64 {
    return hostbase.s_dropx
}

fn drop_y() -> u64 {
    return hostbase.s_dropy
}

fn sel_num(i: u64) -> u64 {
    if hoststate.g(i, hostbase.D_SELP) == 0 {
        return 0
    }
    var n: u64 = 0
    var z: u64 = 0
    while z < hoststate.g(i, D_SELN) {
        if sel_hat(i, z) {
            n = n + 1
        }
        z = z + 1
    }
    return n
}

fn icon_at_row(i: u64, z: u64) -> u64 {
    let p: u64 = hoststate.g(i, D_ICONS)
    if p == 0 {
        return 0
    }
    let w: u64 = __mmio_read64((p + z * 8) as *mut u64)
    if (w & ICON_TAG) == 0 {
        return 0
    }
    return w & 65535
}

const U_LO: u64 = 0x40100000

const U_HI: u64 = 0x52C00000

fn is_image_pub(p: u64) -> bool {
    return is_image(p)
}

fn is_image(p: u64) -> bool {
    if p < U_LO || p >= U_HI {
        return false
    }
    if __mmio_read8((p) as *mut u8) != 79 as u8 {
        return false
    }
    if __mmio_read8((p + 1) as *mut u8) != 83 as u8 {
        return false
    }
    if __mmio_read8((p + 2) as *mut u8) != 89 as u8 {
        return false
    }
    return __mmio_read8((p + 3) as *mut u8) == 77 as u8
}

fn image_w(p: u64) -> u64 {
    return __mmio_read32((p + 4) as *mut u32) as u64
}

fn image_h(p: u64) -> u64 {
    return __mmio_read32((p + 8) as *mut u32) as u64
}

fn image_paint(p: u64, x: u64, y: u64, kw: u64, kh: u64) {
    let w: u64 = image_w(p)
    let h: u64 = image_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return
    }

    var cw: u64 = w
    if kw < cw {
        cw = kw
    }
    var ch: u64 = h
    if kh < ch {
        ch = kh
    }
    if fuib.icon(p + 12, cw, ch, w * 4, x, y) {
        return
    }
    var r: u64 = 0
    while r < h && r < kh {
        var c: u64 = 0
        while c < w && c < kw {
            let f: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            if (f >> 24) != 0 {
                uidraw.px(x + c, y + r, f & uitheme.RGB24)
            }
            c = c + 1
        }
        r = r + 1
    }
}

fn table_in(i: u64) -> u64 {
    if hoststate.g(i, hostbase.D_KIND) == hostbase.K_TABLE && hoststate.g(i, D_ICONS) != 0 {
        return uiicon.icon_small() + 4 * uiscale.ui_scale()
    }
    return 0
}

fn list_in(i: u64) -> u64 {
    if hoststate.g(i, hostbase.D_KIND) == hostbase.K_LIST
        && (hoststate.g(i, hostbase.D_D) != 0 || hoststate.g(i, D_ICONS) != 0) {
        return uiicon.icon_small() + 6 * uiscale.ui_scale()
    }
    return 0
}

fn fit_n(f: u64, pxs: u64, p: u64, n: u64, limit: u64) -> u64 {
    var k: u64 = n
    while k > 0 {
        while k > 0
            && (__mmio_read8((p + k) as *mut u8) & 192 as u8) == 128 as u8 {
            k = k - 1
        }
        if uitext.text_w(f, pxs, p, k) <= limit {
            return k
        }
        if k == 0 {
            return 0
        }
        k = k - 1
    }
    return 0
}

fn elide(f: u64, pxs: u64, p: u64, n: u64, limit: u64) -> u64 {
    if n == 0 || uitext.text_w(f, pxs, p, n) <= limit {
        return 0
    }
    var dots: [u8; 4] = "...\0"
    let dw: u64 = uitext.text_w(f, pxs, (&dots[0 as usize]) as u64, 3)
    let k: u64 = fit_n(f, pxs, p, n, hoststate.sub(limit, dw))
    var a: u64 = 0
    while a < k && a < 188 {
        __mmio_write8(((&hostbase.el_buf[0 as usize]) as u64 + a) as *mut u8,
            __mmio_read8((p + a) as *mut u8))
        a = a + 1
    }
    var d: u64 = 0
    while d < 3 {
        __mmio_write8(((&hostbase.el_buf[0 as usize]) as u64 + a) as *mut u8,
            46 as u8)
        a = a + 1
        d = d + 1
    }
    __mmio_write8(((&hostbase.el_buf[0 as usize]) as u64 + a) as *mut u8, 0 as u8)
    return a
}

fn column_wide(i: u64, c: u64) -> u64 {
    let p: u64 = hoststate.g(i, hostbase.D_D)
    if p == 0 {
        return 100
    }
    return __mmio_read64((p + c * 8) as *mut u64)
}

static mut tbc_key: u64 = 0

static mut tbc_n: u64 = 0

static mut tbc_sum: u64 = 0

static mut tbc_nat: [u64; 16] = [0 as u64; 16]

fn tab_fill(i: u64) {
    let q0: u64 = hoststate.g(i, hostbase.D_TEXT)
    let key: u64 = q0 ^ (hoststate.g(i, hostbase.D_W) * 7919) ^ (uiscale.px_ui() * 104729)
        ^ (hoststate.tlen(q0) * 131) ^ (i + 1)
    if key == tbc_key && tbc_key != 0 {
        return
    }
    tbc_key = key
    tbc_sum = 0
    tbc_n = 0
    var k: u64 = 0
    while k < hostbase.TABS_MAX {
        let q: u64 = hoststate.row_at(q0, k)
        if q == 0 {
            tbc_nat[(k) as usize] = 0
            k = k + 1
        } else {
            let b: u64 = uitext.text_w(uitext.F_UI, uiscale.px_ui(), q,
                hoststate.row_len(q)) + 20
            tbc_nat[(k) as usize] = b
            tbc_sum = tbc_sum + b
            tbc_n = tbc_n + 1
            k = k + 1
        }
    }
}

fn tab_natur(i: u64, k: u64) -> u64 {
    if k >= hostbase.TABS_MAX {
        return 0
    }
    tab_fill(i)
    return tbc_nat[(k) as usize]
}

fn tab_sum(i: u64) -> u64 {
    tab_fill(i)
    return tbc_sum
}

fn tab_n(i: u64) -> u64 {
    tab_fill(i)
    return tbc_n
}

fn tab_rows_at(i: u64, space: u64) -> u64 {
    if space == 0 || tab_sum(i) <= space || tab_n(i) < 2 {
        return 1
    }
    return 2
}

fn tab_rows(i: u64) -> u64 {
    return tab_rows_at(i, hoststate.g(i, hostbase.D_W))
}

fn tab_split(i: u64) -> u64 {
    let n: u64 = tab_n(i)
    if n < 2 {
        return n
    }
    let ges: u64 = tab_sum(i)
    var acc: u64 = 0
    var k: u64 = 0
    while k < n {
        acc = acc + tab_natur(i, k)
        if acc * 2 >= ges {
            if k + 1 >= n {
                return n - 1
            }
            return k + 1
        }
        k = k + 1
    }
    return n - 1
}

fn tab_row(i: u64, k: u64) -> u64 {
    if tab_rows(i) < 2 || k < tab_split(i) {
        return 0
    }
    return 1
}

fn tab_row_first(i: u64, r: u64) -> u64 {
    if r == 0 {
        return 0
    }
    return tab_split(i)
}

fn tab_row_sum(i: u64, r: u64) -> u64 {
    let n: u64 = tab_n(i)
    var k: u64 = tab_row_first(i, r)
    var t: u64 = 0
    while k < n && tab_row(i, k) == r {
        t = t + tab_natur(i, k)
        k = k + 1
    }
    return t
}

fn tab_width(i: u64, k: u64) -> u64 {
    let b: u64 = tab_natur(i, k)
    if b == 0 {
        return 0
    }
    let int: u64 = tab_row_sum(i, tab_row(i, k))
    let space: u64 = hoststate.g(i, hostbase.D_W)
    if int <= space || int == 0 {
        return b
    }

    var sk: u64 = b * space / int
    if sk < 24 {
        sk = 24
    }
    return sk
}

fn tab_rowh_at(i: u64, space: u64) -> u64 {
    if tab_rows_at(i, space) < 2 {
        return uitheme.metric(uitheme.M_CTRL_H)
    }
    return hoststate.r4auf(uitext.text_h(uiscale.px_ui()) + 4)
}

fn tab_rowh(i: u64) -> u64 {
    return tab_rowh_at(i, hoststate.g(i, hostbase.D_W))
}

fn tab_h_at(i: u64, space: u64) -> u64 {
    return tab_rowh_at(i, space) * tab_rows_at(i, space)
}

fn tab_y(i: u64, k: u64) -> u64 {
    return hoststate.g(i, hostbase.D_Y) + tab_row(i, k) * tab_rowh(i)
}

fn menubar_x(i: u64, k: u64) -> u64 {
    if i >= hostbase.MAXWD || hoststate.g(i, hostbase.D_KIND) != hostbase.K_MENUBAR {
        return 0
    }
    var tx: u64 = hoststate.g(i, hostbase.D_X) + 4
    var t: u64 = 0
    while t < k && t < 8 {
        let q: u64 = hoststate.row_at(hoststate.g(i, hostbase.D_TEXT), t)
        if q == 0 {
            return tx
        }
        tx = tx + uitext.text_w(uitext.F_UI, uiscale.px_ui(), q,
            hoststate.row_len(q)) + 16
        t = t + 1
    }
    return tx
}

fn tab_x(i: u64, k: u64) -> u64 {
    var x: u64 = hoststate.g(i, hostbase.D_X)
    var t: u64 = tab_row_first(i, tab_row(i, k))
    while t < k && t < hostbase.TABS_MAX {
        x = x + tab_width(i, t)
        t = t + 1
    }
    return x
}

fn tab_w(i: u64, k: u64) -> u64 {
    return tab_width(i, k)
}

fn say_button(w: u64, x: u64, y: u64, bw: u64, bh: u64, r: u64) {
    var a: [u8; 16] = "wlib: button x=\0"
    var by: [u8; 4] = " y=\0"
    var bw2: [u8; 4] = " w=\0"
    var bh2: [u8; 4] = " h=\0"
    var br: [u8; 4] = " r=\0"
    var bax: [u8; 5] = " ax=\0"
    var bay: [u8; 5] = " ay=\0"
    var nl2: [u8; 2] = "\n\0"
    if hostbase.s_trace == 0 {
        return
    }
    let b: u64 = (&hostbase.tr_buf[0 as usize]) as u64
    var at: u64 = hoststate.tr_put(b, 0, (&a[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, x)
    at = hoststate.tr_put(b, at, (&by[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, y)
    at = hoststate.tr_put(b, at, (&bw2[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, bw)
    at = hoststate.tr_put(b, at, (&bh2[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, bh)
    at = hoststate.tr_put(b, at, (&br[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, r)
    at = hoststate.tr_put(b, at, (&bax[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, hoststate.org_x(w) + x)
    at = hoststate.tr_put(b, at, (&bay[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, hoststate.org_y(w) + y)
    at = hoststate.tr_put(b, at, (&nl2[0 as usize]) as u64)
    let _p: u64 = lineout.add_bytes(b, at)
}

