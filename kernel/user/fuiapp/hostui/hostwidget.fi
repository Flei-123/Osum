    var bh2: [u8; 4] = " h=\0"
    var bkx: [u8; 5] = " kx=\0"
    var bky: [u8; 5] = " ky=\0"
    var bkw: [u8; 5] = " kw=\0"
    var bkh: [u8; 5] = " kh=\0"
    var bei: [u8; 6] = " ein=\0"
    var nl2: [u8; 2] = "\n\0"
    if hostbase.s_trace == 0 {
        return
    }
    let b: u64 = (&hostbase.tr_buf[0 as usize]) as u64
    var at: u64 = hoststate.tr_put(b, 0, (&a[0 as usize]) as u64)
