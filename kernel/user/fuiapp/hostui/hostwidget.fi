    at = hoststate.tr_num(b, at, bw)
    at = hoststate.tr_put(b, at, (&bh2[0 as usize]) as u64)
    at = hoststate.tr_num(b, at, bh)
    at = hoststate.tr_put(b, at, (&bkx[0 as usize]) as u64)
