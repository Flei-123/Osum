}

fn ax_keep_title(w: u64, t: u64) {
    if w >= hostbase.MAXWN {
        return
    }
    let d: u64 = (&hostbase.ax_wtitle[0 as usize]) as u64 + w * 40
    var k: u64 = 0
    while k < 39 {
        var c: u8 = 0 as u8
        if t != 0 {
            c = *((t + k) as *mut u8)
        }
        *((d + k) as *mut u8) = c
        if c == 0 as u8 {
            k = 39
        } else {
            k = k + 1
        }
    }
    *((d + 39) as *mut u8) = 0 as u8
}
