fn window(x: u64, y: u64, w: u64, h: u64, title: u64) -> u64 {
    let k: u64 = uiscale.ui_scale()
    var bw: u64 = w * k
    var bh: u64 = h * k
    let sw: u64 = hosthead.screen_w()
    let sh: u64 = hosthead.screen_h()
    var bx: u64 = x * k
    var by: u64 = y * k
    if sw != 0 && sh != 0 {
        if bw > sw {
            bw = sw
        }
        if bh > sh {
            bh = sh
        }
        if bx + bw > sw {
            bx = hoststate.sub(sw, bw)
        }
        if by + bh > sh {
            by = hoststate.sub(sh, bh)
        }
    }
    return new_win(bx, by, bw, bh, title, hostbase.NK_MAIN)
}

fn window_opts(x: u64, y: u64, w: u64, h: u64, title: u64, frameless: bool, keys: bool, opac: u64) -> u64 {
    s_win_opts = hostwin.win_opts(frameless, keys, opac)
    let i: u64 = new_win(x, y, w, h, title, hostbase.NK_MAIN)
    s_win_opts = 0
    return i
}

fn window_float(x: u64, y: u64, w: u64, h: u64, title: u64, opac: u64) -> u64 {
    s_win_opts = hostwin.win_opts(true, true, opac)
    let i: u64 = new_win(x, y, w, h, title, hostbase.NK_MAIN)
    s_win_opts = 0
    if i >= hostbase.MAXWN {
        return hostbase.MAXWN
    }
    if ulib.bad(hostwin.win_state(hoststate.ng(i, hostbase.N_H), hostwinp.WS_LAYER, hostwinp.L_FLOAT)) {
        hoststate.close(i)
        return hostbase.MAXWN
    }
    hoststate.say_window(i)
    return i
}

fn window_plain(x: u64, y: u64, w: u64, h: u64, title: u64,
    ebene: u64) -> u64 {
    s_plain_open = 1
    let i: u64 = new_win(x, y, w, h, title, hostbase.NK_MAIN)
    s_plain_open = 0
    if i >= hostbase.MAXWN {
        return hostbase.MAXWN
    }
    let hh: u64 = hoststate.ng(i, hostbase.N_H)
    if ulib.bad(hostwin.win_state(hh, hostwinp.WS_DECO, 0)) {
        hoststate.close(i)
        return hostbase.MAXWN
    }
    if ebene != hostwinp.L_NORMAL {
        if ulib.bad(hostwin.win_state(hh, hostwinp.WS_LAYER, ebene)) {
            hoststate.close(i)
            return hostbase.MAXWN
        }
    }
    hoststate.say_window(i)
    return i
}

static mut s_win_opts: u64 = 0

static mut s_plain_open: u64 = 0

fn new_win(x: u64, y: u64, w: u64, h: u64, title: u64, kind: u64) -> u64 {
    if hostbase.nwn >= hostbase.MAXWN {
        return hostbase.MAXWN
    }
    var shp: u64 = 0
    var shb: u64 = 0
    var shfd1: u64 = 0
    if hostbase.s_want_shared != 0 && w >= 32 && h >= 16 {
        shb = w * h * 4
        shp = hostwin.shm_buffer(shb)
        if shp != 0 {
            shfd1 = hostwin.shm_last_fd() + 1
        }
    }
    let hh: u64 = uisys.sys5(hostwinp.WM_CREATE, (x << 16) | y, (w << 16) | h,
        title, s_win_opts, shfd1)

    if shfd1 != 0 {
        hostwin.shm_close(shfd1 - 1)
    }
    if ulib.bad(hh) || hh == 0 {
        if shp != 0 {
            hostwin.shm_unmap(shp, shb)
        }
        return hostbase.MAXWN
    }
    if shp != 0 && !hostwin.win_shared(hh) {

        hostwin.shm_unmap(shp, shb)
        shp = 0
        shb = 0
    }
    let i: u64 = hostbase.nwn
    hostbase.nwn = hostbase.nwn + 1
    hoststate.ns(i, hostbase.N_SHP, shp)
    hoststate.ns(i, hostbase.N_SHB, shb)
    hoststate.ns(i, hostbase.N_H, hh)
    hoststate.ns(i, hostbase.N_W, w)
    hoststate.ns(i, hostbase.N_HH, h)
    hoststate.ns(i, hostbase.N_KIND, kind)
    hoststate.ns(i, hostbase.N_VAL, 0)
    hoststate.ns(i, hostbase.N_DATA, 0)
    hoststate.ns(i, hostbase.N_CNT, 0)
    hoststate.ns(i, hostbase.N_OWNER, 0)
    hoststate.ns(i, hostbase.N_X, x)
    hoststate.ns(i, hostbase.N_Y, y)
    ax_keep_title(i, title)
    hostbase.wncur = i
    hoststate.dirty_all(i)
    if s_plain_open == 0 {
        hoststate.say_window(i)
    }
    return i
}

fn paint_list(i: u64) {
    let x: u64 = hoststate.g(i, hostbase.D_X)
    let y: u64 = hoststate.g(i, hostbase.D_Y)
    let bw: u64 = hoststate.g(i, hostbase.D_W)
    let bh: u64 = hoststate.g(i, hostbase.D_H)
    let zh: u64 = row_h_of(i)
    let sicht: u64 = hoststate.sub(bh, 4) / zh
    fuib.rframe(x, y, bw, bh, hostwidget.typ_radius(hostbase.RT_LIST, hostbase.MR_FIELD, bw, bh),
        uitheme.metric(uitheme.M_BORDER), thquery.theme(uitheme.T_LINE),
        thquery.theme(uitheme.T_ENTRY))
    let int: u64 = hoststate.g(i, hostbase.D_A)
    var r: u64 = 0
    while r < sicht {
        let z: u64 = hoststate.g(i, hostbase.D_B) + r
        if z < int {
            let q: u64 = hoststate.row_at(hoststate.g(i, hostbase.D_TEXT), z)
            let ln: u64 = hoststate.row_len(q)
            let ry: u64 = y + 2 + r * zh
            var color: u64 = thquery.theme(uitheme.T_FG)
            if z == hoststate.g(i, hostbase.D_VAL) || hostwidget.sel_hat(i, z) {
                let _fb10: bool = fuib.area(x + 1, ry, hoststate.sub(bw, 16), zh,
                    thquery.theme(uitheme.T_SEL))
                color = thquery.theme_selfg()
            }

            let sym: u64 = hostwidget.icon_at_row(i, z)
            if sym != 0 {
                let ih: u64 = uiicon.icon_small()
                var oy: u64 = 2
                if zh > ih {
                    oy = (zh - ih) / 2
                }
                let _ = uiicon.icon_at(sym, icon_x(i), ry + oy,
                    ih, color)
            }
            let ein: u64 = hostwidget.list_in(i)
            if ein != 0 && sym == 0 && hoststate.g(i, hostbase.D_D) != 0 {
                let f: u64 = __mmio_read64((hoststate.g(i, hostbase.D_D) + z * 8) as *mut u64)
                if hostwidget.is_image(f) {
                    let bw3: u64 = uiicon.icon_w(f)
                    let bh3: u64 = uiicon.icon_h(f)
                    if bw3 != 0 && bh3 != 0 {
                        let tw3: u64 = hoststate.tile_w()
                        var sc3: u64 = tw3 / bw3
                        let sy3: u64 = tw3 / bh3
                        if sy3 < sc3 {
                            sc3 = sy3
                        }
                        if sc3 == 0 {
                            sc3 = 1
                        }
                        let dw3: u64 = bw3 * sc3
                        let dh3: u64 = bh3 * sc3
                        var ox3: u64 = 0
                        if tw3 > dw3 {
                            ox3 = (tw3 - dw3) / 2
                        }
                        var oy3: u64 = 0
                        if tw3 > dh3 {
                            oy3 = (tw3 - dh3) / 2
                        }

                        var top3: u64 = 3 + oy3
                        if zh > hoststate.lines_height() {
                            top3 = tile_top(zh, dh3)
                        }
                        let _b3: bool = uiicon.icon_draw_sc(f,
                            x + 5 + ox3, ry + top3, sc3)
                    }
                } else {
                let rp: u64 = hostwidget.draw_radius(hostbase.MR_FIELD)
                let ty: u64 = ry + tile_top(zh, hoststate.tile_w())
                fuib.rrect(x + 5, ty, hoststate.tile_w(), hoststate.tile_w(), rp, f)
                fuib.rframe(x + 5, ty, hoststate.tile_w(), hoststate.tile_w(), rp,
                    uitheme.metric(uitheme.M_BORDER),
                    thquery.theme(uitheme.T_LINE), f)
                if ln > 0 {
                    let bw2: u64 = uitext.text_w(uitext.F_UI, uiscale.px_ui(),
                        q, 1)
                    uitextat.text_at(uitext.F_UI, uiscale.px_ui(),
                        x + 5 + hoststate.sub(14, bw2) / 2, ty + 12, q, 1,
                        thquery.theme_on(f))
                }
                }
            }
            var n1: u64 = ln
            var p2: u64 = 0
            var n2: u64 = 0
            if hoststate.g(i, hostbase.D_SECOND) != 0 {
                var t: u64 = 0
                while t < ln {
                    if (*((q + t) as *mut u8)) == 9 as u8 {
                        n1 = t
                        p2 = q + t + 1
                        n2 = hoststate.sub(ln, t + 1)
                        t = ln
                    } else {
                        t = t + 1
                    }
                }
            }
            let free: u64 = hoststate.sub(bw, 21 + 6 + ein)
            var qq: u64 = q
            var qn: u64 = n1
            let el: u64 = hostwidget.elide(uitext.F_UI, uiscale.px_ui(), q, n1, free)
            if el != 0 {
                qq = (&hostbase.el_buf[0 as usize]) as u64
                qn = el
            }
            var rgrund: u64 = base_in_row(ry, zh)
            if n2 != 0 || hoststate.g(i, hostbase.D_SECOND) != 0 {
                rgrund = base_in_row(ry, zh / 2)
            }
            var f1: u64 = uitext.F_UI
            if n2 != 0 {
                f1 = uitext.F_BOLD
            }
            let _rt: u64 = hoststate.put_text(f1, uiscale.px_ui(),
                x + 6 + ein, rgrund, hoststate.sub(bw, 16), qq, qn, color, 0)
            if n2 != 0 {
                var f2: u64 = thquery.theme(uitheme.T_DIM)
                if z == hoststate.g(i, hostbase.D_VAL) || hostwidget.sel_hat(i, z) {
                    f2 = color
                }
                let px2: u64 = uitheme.type_px(uitheme.TY_CAPTION)
                var q2: u64 = p2
                var n2s: u64 = n2
                let e2: u64 = hostwidget.elide(uitext.F_UI, px2, p2, n2,
                    free)
                if e2 != 0 {
                    q2 = (&hostbase.el_buf[0 as usize]) as u64
                    n2s = e2
                }
                let b2: u64 = base_in_row(ry + zh / 2, zh / 2)
                let _r2: u64 = hoststate.put_text(uitext.F_UI, px2,
                    x + 6 + ein, b2, hoststate.sub(bw, 16), q2, n2s, f2, 0)
                var hg2: u64 = thquery.theme(uitheme.T_ENTRY)
                if z == hoststate.g(i, hostbase.D_VAL) || hostwidget.sel_hat(i, z) {
                    hg2 = thquery.theme(uitheme.T_SEL)
                }
                hoststate.say_painted_g(hoststate.g(i, hostbase.D_WIN), hostbase.K_LIST, b2, f2, hg2, q2, n2s,
                    n2s, n2, px2, true)
            }
            var rhg: u64 = thquery.theme(uitheme.T_ENTRY)
            if z == hoststate.g(i, hostbase.D_VAL) || hostwidget.sel_hat(i, z) {
                rhg = thquery.theme(uitheme.T_SEL)
            }
            hoststate.say_painted(hoststate.g(i, hostbase.D_WIN), hostbase.K_LIST, rgrund, color, rhg, qq, qn)
        }
        r = r + 1
    }
    hostwidget.paint_scroll(x + bw - 15, y + 1, hoststate.sub(bh, 2), hoststate.g(i, hostbase.D_B), sicht, int)
    hostwidget.focus_ring(i)
}

fn paint_table(i: u64) {
    let x: u64 = hoststate.g(i, hostbase.D_X)
    let y: u64 = hoststate.g(i, hostbase.D_Y)
    let bw: u64 = hoststate.g(i, hostbase.D_W)
    let bh: u64 = hoststate.g(i, hostbase.D_H)
    let zh: u64 = hoststate.lines_height()
    let head: u64 = zh + 4
    let sicht: u64 = hoststate.sub(hoststate.sub(bh, 4), head) / zh
    let cols: u64 = hoststate.g(i, hostbase.D_C)
    let _fb11: bool = fuib.board(x, y, bw, bh,
        hostwidget.typ_radius(hostbase.RT_TABLE, hostbase.MR_FIELD, bw, bh),
        thquery.theme(uitheme.T_ENTRY), 0, 0)
    let _fb12: bool = fuib.area(x + 1, y + 1, hoststate.sub(bw, 2), head,
        thquery.theme(uitheme.T_HEAD))
    let kq: u64 = hoststate.row_at(hoststate.g(i, hostbase.D_TEXT), 0)
    let kl: u64 = hoststate.row_len(kq)
    var cx: u64 = x + 6
    var c: u64 = 0
    while c < cols {
        let q: u64 = hoststate.col_at(kq, kl, c)
        if q != 0 {
            let ln: u64 = hoststate.col_len(q, hoststate.sub(kl, hoststate.sub(q, kq)))

            var hx: u64 = cx
            if c == 0 {
                hx = cx + hostwidget.table_in(i)
            }
            let kgrund: u64 = y + 3 + uitext.ascent_of(uitext.F_UI,
                uiscale.px_ui())
            let _kt: u64 = hoststate.put_text(uitext.F_UI, uiscale.px_ui(), hx, kgrund,
                hostwidget.column_wide(i, c), q, ln, thquery.theme(uitheme.T_FG), 0)
            hoststate.say_painted(hoststate.g(i, hostbase.D_WIN), hostbase.K_TABLE, kgrund,
                thquery.theme(uitheme.T_FG), thquery.theme(uitheme.T_HEAD),
                q, ln)
        }
        cx = cx + hostwidget.column_wide(i, c)
        if c + 1 < cols {
            fuib.vline(cx - 4, y + 1, head, thquery.theme(uitheme.T_LINE))
        }
        c = c + 1
    }
    fuib.hline(x + 1, y + head, hoststate.sub(bw, 2), thquery.theme(uitheme.T_LINE))
    let int: u64 = hoststate.sub(hoststate.g(i, hostbase.D_A), 1)
    var r: u64 = 0
    while r < sicht {
        let z: u64 = hoststate.g(i, hostbase.D_B) + r
        if z < int {
            let q: u64 = hoststate.row_at(hoststate.g(i, hostbase.D_TEXT), z + 1)
            let ln: u64 = hoststate.row_len(q)
            let ry: u64 = y + head + 1 + r * zh
            var color: u64 = thquery.theme(uitheme.T_FG)
            if z == hoststate.g(i, hostbase.D_VAL) || hostwidget.sel_hat(i, z) {
                let _fb13: bool = fuib.area(x + 1, ry, hoststate.sub(bw, 16), zh,
                    thquery.theme(uitheme.T_SEL))
                color = thquery.theme_selfg()
            }
            var tx: u64 = x + 6

            let einr: u64 = hostwidget.table_in(i)
            let sym: u64 = hostwidget.icon_at_row(i, z)
            if sym != 0 {
                let ih2: u64 = uiicon.icon_small()
                var oy2: u64 = 2
                if zh > ih2 {
                    oy2 = (zh - ih2) / 2
                }
                let _ = uiicon.icon_at(sym, tx, ry + oy2, ih2, color)
            }
            c = 0
            while c < cols {
                let cq: u64 = hoststate.col_at(q, ln, c)
                if cq != 0 {
                    var cl: u64 = hoststate.col_len(cq, hoststate.sub(ln, hoststate.sub(cq, q)))
                    let space: u64 = hoststate.sub(hostwidget.column_wide(i, c), 6)
                    cl = uiglyph.fit(uitext.F_UI, uiscale.px_ui(), cq, cl, space)
                    var f2: u64 = color
                    if c > 0 && z != hoststate.g(i, hostbase.D_VAL) {
                        f2 = thquery.theme(uitheme.T_DIM)
                    }
                    var txx: u64 = tx
                    if c == 0 {
                        txx = tx + einr
                    }
                    uitextat.text_at(uitext.F_UI, uiscale.px_ui(), txx,
                        base_in_row(ry, zh), cq, cl, f2)
                }
                tx = tx + hostwidget.column_wide(i, c)
                c = c + 1
            }
        }
        r = r + 1
    }
    fuib.frame(x, y, bw, bh, thquery.theme(uitheme.T_LINE))
    hostwidget.paint_scroll(x + bw - 15, y + head + 1, hoststate.sub(hoststate.sub(bh, head), 2),
        hoststate.g(i, hostbase.D_B), sicht, int)
    hostwidget.focus_ring(i)
}

fn paint_one(i: u64) {
    let k: u64 = hoststate.g(i, hostbase.D_KIND)
    if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_HIDE) != 0 {
        return
    }
    if k == hostbase.K_IMAGE {
        hostwidget.paint_image(i)
    } else if k == hostbase.K_SLIDER {
        hostdraw.paint_slider(i)
    } else if k == hostbase.K_LABEL {
        hostwidget.paint_label(i)
    } else if k == hostbase.K_BUTTON {
        hostwidget.paint_button(i)
    } else if k == hostbase.K_CHECK {
        hostdraw.paint_check(i)
    } else if k == hostbase.K_ENTRY {
        hostdraw.paint_entry(i)
    } else if k == hostbase.K_LIST {
        paint_list(i)
    } else if k == hostbase.K_TABLE {
        paint_table(i)
    } else if k == hostbase.K_TABS {
        hostdraw.paint_tabs(i)
    } else if k == hostbase.K_MENUBAR {
        hostdraw.paint_menubar(i)
    } else if k == hostbase.K_CHOICE {
        hostdraw.paint_choice(i)
    } else if k == hostbase.K_SEP {
        hostwidget.paint_sep(i)
    } else if k == hostbase.K_CARD {
        hostwidget.paint_card(i)
    } else if k == hostbase.K_SCROLL {
        hostwidget.paint_scroll(hoststate.g(i, hostbase.D_X), hoststate.g(i, hostbase.D_Y), hoststate.g(i, hostbase.D_H), hoststate.g(i, hostbase.D_VAL),
            hoststate.g(i, hostbase.D_B), hoststate.g(i, hostbase.D_A))
    } else if k == hostbase.K_TILE {
        hostwidget.paint_tile(i)
    } else if k == hostbase.K_GRAPH {
        hostwidget.paint_graph(i)
    } else if k == hostbase.K_CANVAS {
        hoststate.paint_canvas(i)
    } else if k == hostbase.K_TEXTAREA {
        hostdraw.paint_ta(i)
    }

    if hostbase.s_zugziel != 0 && hostbase.s_zugziel - 1 == i {
        let zx: u64 = hoststate.g(i, hostbase.D_X)
        let zy: u64 = hoststate.g(i, hostbase.D_Y)
        let zw: u64 = hoststate.g(i, hostbase.D_W)
        let zh2: u64 = hoststate.g(i, hostbase.D_H)
        let zf: u64 = thquery.theme(uitheme.T_ACCENT)
        let _zr: bool = fuib.ring(zx, zy, zw, zh2, 0, 2, zf)
    }
}

fn tip_win_open(x: u64, y: u64, w: u64, h: u64, title: u64) -> u64 {
    let i: u64 = new_win(x, y, w, h, title, hostbase.NK_TIP)
    if i >= hostbase.MAXWN {
        return hostbase.MAXWN
    }
    let _d: u64 = hostwin.win_state(hoststate.ng(i, hostbase.N_H), hostwinp.WS_DECO, 0)
    let _l: u64 = hostwin.win_state(hoststate.ng(i, hostbase.N_H), hostwinp.WS_LAYER,
        hostwinp.L_TIP)
    hoststate.dirty_all(i)
    return i
}

fn zug_auf(txt: u64, sx: u64, sy: u64) {
    if hostbase.s_zugwin != 0 {
        return
    }
    let bw: u64 = hostwidget.run_width(txt)
    let bh: u64 = hoststate.lines_height() + 8
    let i: u64 = tip_win_open(sx + 14, sy + 14, bw, bh, 0)
    if i >= hostbase.MAXWN {
        return
    }
    hostbase.s_zugwin = i + 1
    s_zugtext = txt
    s_zugw = bw
    s_zugh = bh
    hostbase.s_zugauf = hostbase.s_zugauf + 1
    hoststate.dirty_all(i)
    let _g: u64 = flush_win(i)
}

fn zug_zieh(sx: u64, sy: u64) {
    if hostbase.s_zugwin == 0 {
        return
    }
    let i: u64 = hostbase.s_zugwin - 1
    let _m: u64 = hostwin.win_move(hoststate.ng(i, hostbase.N_H), sx + 14, sy + 14)
    hoststate.ns(i, hostbase.N_X, sx + 14)
    hoststate.ns(i, hostbase.N_Y, sy + 14)
    hoststate.dirty_all(i)
    let _g: u64 = flush_win(i)
}

fn zug_zu() {
    if hostbase.s_zugwin == 0 {
        return
    }
    let i: u64 = hostbase.s_zugwin - 1
    hostbase.s_zugwin = 0
    s_zugtext = 0
    tip_win_close(i)
}

fn paint_zug(w: u64) {
    let bw: u64 = hoststate.ng(w, hostbase.N_W)
    let bh: u64 = hoststate.ng(w, hostbase.N_HH)
    let _f: bool = fuib.area(0, 0, bw, bh, thquery.theme(uitheme.T_MENU))
    let _zr2: bool = fuib.ring(0, 0, bw, bh, 0, 1,
        thquery.theme(uitheme.T_ACCENT))
    if s_zugtext != 0 {
        let _t: u64 = hoststate.put_text(uitext.F_UI, uiscale.px_ui(), 10,
            base_in_row(0, bh), hoststate.sub(bw, 20), s_zugtext, hoststate.tlen(s_zugtext),
            thquery.theme(uitheme.T_FG), 0)
    }
}

fn tip_win_close(i: u64) {
    if i >= hostbase.MAXWN {
        return
    }
    hoststate.close(i)
    if i + 1 == hostbase.nwn {
        hostbase.nwn = hostbase.nwn - 1
    }
}

fn tip_win_id(i: u64) -> u64 {
    return hoststate.ng(i, hostbase.N_H)
}

fn paint_menu(w: u64) {
    let zh: u64 = hoststate.lines_height() + 2
    let mr: u64 = uitheme.win_round(hoststate.ng(w, hostbase.N_W), hoststate.ng(w, hostbase.N_HH))
    if uitheme.aa_old() || hoststate.ng(w, hostbase.N_W) < 3 || hoststate.ng(w, hostbase.N_HH) < 3 {
        let _fb19: bool = fuib.area(0, 0, hoststate.ng(w, hostbase.N_W), hoststate.ng(w, hostbase.N_HH),
            thquery.theme(uitheme.T_MENU))
    } else {
        let _fb21: bool = fuib.area(0, 0, hoststate.ng(w, hostbase.N_W), hoststate.ng(w, hostbase.N_HH),
            thquery.theme(uitheme.T_ACCENT))
        var mi: u64 = 0
        if mr > 1 {
            mi = mr - 1
        }
        fuib.rrect(1, 1, hoststate.sub(hoststate.ng(w, hostbase.N_W), 2), hoststate.sub(hoststate.ng(w, hostbase.N_HH), 2), mi,
            thquery.theme(uitheme.T_MENU))
    }
    var k: u64 = 0
    while k < hoststate.ng(w, hostbase.N_CNT) {
        let q: u64 = hoststate.row_at(hoststate.ng(w, hostbase.N_DATA), k)
        if q != 0 {
            let ry: u64 = 2 + k * zh
            var color: u64 = thquery.theme(uitheme.T_FG)
            if k + 1 == hoststate.ng(w, hostbase.N_VAL) {
                let _fb20: bool = fuib.board(1, ry, hoststate.sub(hoststate.ng(w, hostbase.N_W), 2), zh,
                    hostwidget.typ_radius(hostbase.RT_MENU, hostbase.MR_FIELD, hoststate.sub(hoststate.ng(w, hostbase.N_W), 2), zh),
                    thquery.theme(uitheme.T_SEL), 0, 0)
                color = thquery.theme_selfg()
            }
            uitextat.text_at(uitext.F_UI, uiscale.px_ui(), 8,
                base_in_row(ry, zh), q, hoststate.row_len(q), color)
        }
        k = k + 1
    }
    if uitheme.aa_old() {
        fuib.frame(0, 0, hoststate.ng(w, hostbase.N_W), hoststate.ng(w, hostbase.N_HH), thquery.theme(uitheme.T_ACCENT))
    }
}

fn flush_win(w: u64) -> u64 {
    if w >= hostbase.MAXWN || hoststate.ng(w, hostbase.N_H) == 0 {
        return 0
    }
    hoststate.win_place_get(w)
    let n: u64 = hoststate.ng(w, hostbase.N_NDIRT)
    hoststate.ns(w, hostbase.N_NDIRT, 0)
    var gemalt: u64 = 0
    var k: u64 = 0
    while k < n {
        gemalt = gemalt + flush_rect(w, hoststate.dg(w, k, 0), hoststate.dg(w, k, 1),
            hoststate.dg(w, k, 2), hoststate.dg(w, k, 3))
        k = k + 1
    }
    return gemalt
}

fn flush_rect(w: u64, x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    if x1 <= x0 || y1 <= y0 {
        return 0
    }

    if hoststate.ng(w, hostbase.N_SHP) != 0 && hostbase.s_zugziel == 0 && hostbase.s_zugwin == 0 && hoststate.ng(w, hostbase.N_KIND) != hostbase.NK_MENU {
        let r: u64 = hostwin.win_damage(hoststate.ng(w, hostbase.N_H), x0, y0, x1 - x0, y1 - y0)
        if !ulib.bad(r) {
            hostbase.s_blits = hostbase.s_blits + 1
            return (x1 - x0) * (y1 - y0)
        }

    }
    var gemalt: u64 = 0
    var yb: u64 = y0
    while yb < y1 {
        var ye: u64 = yb + hosthead.surf_rows()
        if ye > y1 {
            ye = y1
        }
        hosthead.set_band(yb)
        uidraw.clip_set(x0, yb, x1, ye)
        hoststate.paint_bg(w, x0, yb, x1 - x0, ye - yb)
        if hoststate.ng(w, hostbase.N_KIND) == hostbase.NK_MENU {
            paint_menu(w)
        } else if hostbase.s_zugwin != 0 && w + 1 == hostbase.s_zugwin {
            paint_zug(w)
        } else {
            var i: u64 = 0
            while i < hostbase.nwd {
                if hoststate.g(i, hostbase.D_WIN) == w {
                    if hoststate.g(i, hostbase.D_Y) < ye && hoststate.g(i, hostbase.D_Y) + hoststate.g(i, hostbase.D_H) > yb {
                        paint_one(i)
                    }
                }
                i = i + 1
            }
        }
        uiglyph.push(hoststate.ng(w, hostbase.N_H), x0, yb, x1 - x0, ye - yb)
        hostbase.s_blits = hostbase.s_blits + 1
        gemalt = gemalt + (x1 - x0) * (ye - yb)
        yb = ye
    }
    return gemalt
}

fn draw_all() {
    var w: u64 = 0
    while w < hostbase.nwn {
        if hoststate.ng(w, hostbase.N_H) != 0 {
            hoststate.dirty_all(w)
        }
        w = w + 1
    }
    let _g: u64 = paint_all()
}

fn row_under(i: u64, y: u64) -> u64 {
    let zh: u64 = row_h_of(i)
    var top: u64 = hoststate.g(i, hostbase.D_Y) + 2
    if hoststate.g(i, hostbase.D_KIND) == hostbase.K_TABLE {
        top = hoststate.g(i, hostbase.D_Y) + zh + 5
    }
    if y < top {
        return hostbase.MAXWD
    }
    let r: u64 = (y - top) / zh + hoststate.g(i, hostbase.D_B)
    var int: u64 = hoststate.g(i, hostbase.D_A)
    if hoststate.g(i, hostbase.D_KIND) == hostbase.K_TABLE {
        int = hoststate.sub(int, 1)
    }
    if r >= int {
        return hostbase.MAXWD
    }
    return r
}

fn scroll_to(i: u64, z: u64) {
    let zh: u64 = row_h_of(i)
    var sicht: u64 = hoststate.sub(hoststate.g(i, hostbase.D_H), 4) / zh
    if hoststate.g(i, hostbase.D_KIND) == hostbase.K_TABLE {
        sicht = hoststate.sub(hoststate.sub(hoststate.g(i, hostbase.D_H), 4), zh + 4) / zh
    }
    if sicht == 0 {
        return
    }
    if z < hoststate.g(i, hostbase.D_B) {
        hoststate.s(i, hostbase.D_B, z)
    } else if z >= hoststate.g(i, hostbase.D_B) + sicht {
        hoststate.s(i, hostbase.D_B, z - sicht + 1)
    }
}

fn on_down(w: u64, x: u64, y: u64, btn: u64) {
    if hoststate.ng(w, hostbase.N_KIND) == hostbase.NK_MENU {

        if hostbase.s_nohit != 0 {
            return
        }
        let zh: u64 = hoststate.lines_height() + 2
        if y >= 2 {
            let k: u64 = (y - 2) / zh
            if k < hoststate.ng(w, hostbase.N_CNT) {
                hoststate.ns(w, hostbase.N_VAL, k + 1)
                hostdraw.fire(hoststate.ng(w, hostbase.N_OWNER), hostbase.K_MENUBAR, k, w)
            }
        }
        return
    }
    let i: u64 = hostwidget.hit_at(w, x, y)
    if i >= hostbase.MAXWD {
        return
    }
    let k: u64 = hoststate.g(i, hostbase.D_KIND)
    if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_FOCUSABLE) != 0 {
        hoststate.set_focus(i)
    }
    if k == hostbase.K_BUTTON {
        hoststate.s(i, hostbase.D_FLAGS, hoststate.g(i, hostbase.D_FLAGS) | hostbase.F_PRESSED)
        let _a3: u64 = hostwidget.anim_start(AN_PRESS, hoststate.g(i, hostbase.D_WIN), i,
            uitheme.MO_FAST, hostbase.EASE_OUT)
        hostbase.s_down = i + 1
        hoststate.dirty_wd(i)
        return
    }
    if k == hostbase.K_CANVAS {
        hoststate.lw_push(i, LE_DOWN, ((x - hoststate.g(i, hostbase.D_X)) << 16) | (y - hoststate.g(i, hostbase.D_Y)), btn)
        hostbase.s_down = i + 1
        return
    }
    if k == hostbase.K_SLIDER {
        hoststate.s(i, hostbase.D_FLAGS, hoststate.g(i, hostbase.D_FLAGS) | hostbase.F_PRESSED)
        hostbase.s_down = i + 1
        hoststate.slider_set(i, x)
        hostdraw.fire(i, hostbase.K_SLIDER, hoststate.g(i, hostbase.D_VAL), w)
        return
    }
    if k == hostbase.K_IMAGE {
        hostbase.s_down = i + 1
        hostbase.s_dragx = x
        hostbase.s_dragy = y
        if hoststate.g(i, hostbase.D_WZ) == 1 {
            hostbase.s_aus_x0 = hoststate.image_px(i, x)
            hostbase.s_aus_y0 = hoststate.image_py(i, y)
            hostbase.s_aus_x1 = hostbase.s_aus_x0
            hostbase.s_aus_y1 = hostbase.s_aus_y0
            hostbase.s_aus_da = 1
            hoststate.dirty_wd(i)
        }
        return
    }

    if k == hostbase.K_TILE {
        hoststate.dirty_wd(i)
        hostdraw.fire(i, hostbase.K_TILE, 0, w)
        return
    }
    if k == hostbase.K_CHECK {
        hoststate.s(i, hostbase.D_VAL, 1 - hoststate.g(i, hostbase.D_VAL))
        hoststate.dirty_wd(i)
        hostdraw.fire(i, hostbase.K_CHECK, hoststate.g(i, hostbase.D_VAL), w)
        return
    }
    if k == hostbase.K_ENTRY && hostwidget.eye_hit(i, x) {

        hostwidget.password_show(i, !hoststate.password_shown(i))
        hoststate.blink_reset()
        return
    }
    if k == hostbase.K_ENTRY {
        hoststate.blink_reset()
        let p: u64 = hoststate.g(i, hostbase.D_TEXT)
        let n: u64 = hoststate.tlen(p)
        var at: u64 = 0
        while at < n && hoststate.entry_x(i, at + 1) <= x {
            at = at + 1
        }
        hoststate.s(i, hostbase.D_B, at)
        hoststate.s(i, hostbase.D_C, at)
        hostbase.s_down = i + 1
        hoststate.dirty_wd(i)
        return
    }

    if k == hostbase.K_TEXTAREA {
        let tt: u64 = hoststate.g(i, hostbase.D_VAL)
        if tt < hostbase.TA_MAX {
            if (btn & 8) == 0 {
                hostdraw.ta_hit(i, x, y)
                hostdraw.ta_sel_clear(tt)
            } else {
                hostdraw.ta_hit(i, x, y)
            }
            hostbase.s_down = i + 1
            hoststate.set_focus(i)
            hoststate.dirty_wd(i)
        }
        return
    }
    if k == hostbase.K_LIST || k == hostbase.K_TABLE {

        if x >= hoststate.g(i, hostbase.D_X) + hoststate.g(i, hostbase.D_W) - 16 {
            let zh: u64 = row_h_of(i)
            var sicht: u64 = hoststate.sub(hoststate.g(i, hostbase.D_H), 4) / zh
            if k == hostbase.K_TABLE {
                sicht = hoststate.sub(hoststate.sub(hoststate.g(i, hostbase.D_H), 4), zh + 4) / zh
            }
            var int: u64 = hoststate.g(i, hostbase.D_A)
            if k == hostbase.K_TABLE {
                int = hoststate.sub(int, 1)
            }
            if int > sicht {
                let rel: u64 = hoststate.sub(y, hoststate.g(i, hostbase.D_Y))
                let z: u64 = rel * int / hoststate.g(i, hostbase.D_H)
                var top: u64 = z
                if top + sicht > int {
                    top = int - sicht
                }
                hoststate.s(i, hostbase.D_B, top)
                hoststate.dirty_wd(i)
            }
            return
        }
        if k == hostbase.K_TABLE && y < hoststate.g(i, hostbase.D_Y) + hoststate.lines_height() + 5 {
            var cx: u64 = hoststate.g(i, hostbase.D_X) + 2
            var c: u64 = 0
            while c < hoststate.g(i, hostbase.D_C) {
                if x >= cx && x < cx + hostwidget.column_wide(i, c) {
                    hostdraw.fire(i, hostbase.K_TABLE, c, w)
                    hoststate.s(i, hostbase.D_C, hoststate.g(i, hostbase.D_C))
                    c = hoststate.g(i, hostbase.D_C)
                } else {
                    cx = cx + hostwidget.column_wide(i, c)
                    c = c + 1
                }
            }
            return
        }
        let r: u64 = row_under(i, y)
        if r < hostbase.MAXWD {
            let now: u64 = clockapi.ticks()
            var doppelt: bool = false
            if s_lastwd == i + 1 && s_lastclick != 0 {
                if now - s_lastclick < 100 && hoststate.g(i, hostbase.D_VAL) == r {
                    doppelt = true
                }
            }

            if hoststate.g(i, hostbase.D_SELP) != 0 && (btn & 2) == 0 {
                if (btn & 16) != 0 {
                    hostwidget.sel_set(i, r, !hostwidget.sel_hat(i, r))
                    hostwidget.sel_anker(i, r)
                } else if (btn & 8) != 0 {
                    hostwidget.sel_bereich(i, r)
                } else {
                    hostwidget.sel_clear(i)
                    hostwidget.sel_set(i, r, true)
                    hostwidget.sel_anker(i, r)
                }
            }
            hoststate.s(i, hostbase.D_VAL, r)
            s_lastclick = now
            s_lastwd = i + 1
            if hoststate.g(i, hostbase.D_SELP) != 0 && (btn & 2) == 0 {
                hostbase.s_down = i + 1
            }
            hoststate.dirty_wd(i)
            if doppelt || (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_EINKLICK) != 0 {
                hostdraw.fire(i, hostbase.K_LIST, r, w)
                s_lastclick = 0
            } else if (btn & 2) != 0 {
                hostdraw.fire(i, hostbase.K_SCROLL, r, w)
            }
        }
        return
    }
    if k == hostbase.K_TABS {
        let zh: u64 = hostwidget.tab_rowh(i)
        let n: u64 = hostwidget.tab_n(i)
        var t: u64 = 0
        while t < n {
            let tw: u64 = hostwidget.tab_width(i, t)
            let tx: u64 = hostwidget.tab_x(i, t)
            let ty: u64 = hostwidget.tab_y(i, t)
            if x >= tx && x < tx + tw && y >= ty && y < ty + zh {
                if hoststate.g(i, hostbase.D_VAL) != t {
                    hoststate.s(i, hostbase.D_VAL, t)
                    hoststate.dirty_wd(i)
                    hostdraw.fire(i, hostbase.K_TABS, t, w)
                }
                t = n
            } else {
                t = t + 1
            }
        }
        return
    }
    if k == hostbase.K_MENUBAR {
        var tx: u64 = hoststate.g(i, hostbase.D_X) + 4
        var t: u64 = 0
        while t < 8 {
            let q: u64 = hoststate.row_at(hoststate.g(i, hostbase.D_TEXT), t)
            if q == 0 {
                t = 8
            } else {
                let tw: u64 = uitext.text_w(uitext.F_UI, uiscale.px_ui(), q,
                    hoststate.row_len(q)) + 16
                if x >= tx && x < tx + tw {
                    hoststate.s(i, hostbase.D_VAL, t + 1)
                    hoststate.dirty_wd(i)
                    hostdraw.fire(i, hostbase.K_MENUBAR, 0x1000 + t, w)
                    t = 8
                } else {
                    tx = tx + tw
                    t = t + 1
                }
            }
        }
        return
    }
    if k == hostbase.K_CHOICE {
        hostdraw.fire(i, hostbase.K_CHOICE, 0x1000, w)
        return
    }
}

fn ta_key(i: u64, k: u64) {
    let t: u64 = hoststate.g(i, hostbase.D_VAL)
    if t >= hostbase.TA_MAX {
        return
    }
    let shift: bool = hostdraw.key_shift()
    let ctrl: bool = hostdraw.key_ctrl()
    let rows: u64 = hostdraw.ta_rows(i)
    var bewegt: bool = false
    var geaendert: bool = false
    if k != KEY_UP && k != KEY_DOWN && k != KEY_PGUP && k != KEY_PGDN {
        hostdraw.tas(t, hostbase.TS_WANT, 0xFFFFFFFFFFFFFFFF)
    }

    if k == KEY_LEFT {
        if ctrl {
            hostdraw.ta_word_left(t)
        } else if hostdraw.ta_has_sel(t) && !shift {
            let a: u64 = hostdraw.ta_sel_first(t)
            hostdraw.tas(t, hostbase.TS_CY, a >> 32)
            hostdraw.tas(t, hostbase.TS_CX, a & 0xFFFFFFFF)
        } else if hostdraw.tag(t, hostbase.TS_CX) > 0 {
            hostdraw.tas(t, hostbase.TS_CX, hostdraw.ta_back(t, hostdraw.tag(t, hostbase.TS_CY), hostdraw.tag(t, hostbase.TS_CX)))
        } else if hostdraw.tag(t, hostbase.TS_CY) > 0 {
            hostdraw.tas(t, hostbase.TS_CY, hostdraw.tag(t, hostbase.TS_CY) - 1)
            hostdraw.tas(t, hostbase.TS_CX, hostdraw.lg(t, hostdraw.tag(t, hostbase.TS_CY), hostbase.LN_N))
        }
        bewegt = true
    } else if k == KEY_RIGHT {
        if ctrl {
            hostdraw.ta_word_right(t)
        } else if hostdraw.ta_has_sel(t) && !shift {
            let b: u64 = hostdraw.ta_sel_last(t)
            hostdraw.tas(t, hostbase.TS_CY, b >> 32)
            hostdraw.tas(t, hostbase.TS_CX, b & 0xFFFFFFFF)
        } else if hostdraw.tag(t, hostbase.TS_CX) < hostdraw.lg(t, hostdraw.tag(t, hostbase.TS_CY), hostbase.LN_N) {
            hostdraw.tas(t, hostbase.TS_CX, hostdraw.ta_fwd(t, hostdraw.tag(t, hostbase.TS_CY), hostdraw.tag(t, hostbase.TS_CX)))
        } else if hostdraw.tag(t, hostbase.TS_CY) + 1 < hostdraw.tag(t, hostbase.TS_NL) {
            hostdraw.tas(t, hostbase.TS_CY, hostdraw.tag(t, hostbase.TS_CY) + 1)
            hostdraw.tas(t, hostbase.TS_CX, 0)
        }
        bewegt = true
    } else if k == KEY_UP {
        if ctrl {
            if hostdraw.tag(t, hostbase.TS_TOP) > 0 {
                hostdraw.tas(t, hostbase.TS_TOP, hostdraw.tag(t, hostbase.TS_TOP) - 1)
            }
            hoststate.dirty_wd(i)
            return
        }
        hostdraw.ta_updown(t, true, 1)
        bewegt = true
    } else if k == KEY_DOWN {
        if ctrl {
            if hostdraw.tag(t, hostbase.TS_TOP) + rows < hostdraw.tag(t, hostbase.TS_NL) {
                hostdraw.tas(t, hostbase.TS_TOP, hostdraw.tag(t, hostbase.TS_TOP) + 1)
            }
            hoststate.dirty_wd(i)
            return
        }
        hostdraw.ta_updown(t, false, 1)
        bewegt = true
    } else if k == KEY_PGUP {
        hostdraw.ta_updown(t, true, rows)
        bewegt = true
    } else if k == KEY_PGDN {
        hostdraw.ta_updown(t, false, rows)
        bewegt = true
    } else if k == KEY_HOME {
        if ctrl {
            hostdraw.tas(t, hostbase.TS_CY, 0)
            hostdraw.tas(t, hostbase.TS_CX, 0)
        } else {
            let target: u64 = hostdraw.ta_einzug(t, hostdraw.tag(t, hostbase.TS_CY))
            if hostdraw.tag(t, hostbase.TS_CX) == target {
                hostdraw.tas(t, hostbase.TS_CX, 0)
            } else {
                hostdraw.tas(t, hostbase.TS_CX, target)
            }
        }
        bewegt = true
    } else if k == KEY_END {
        if ctrl {
            hostdraw.tas(t, hostbase.TS_CY, hostdraw.tag(t, hostbase.TS_NL) - 1)
            hostdraw.tas(t, hostbase.TS_CX, hostdraw.lg(t, hostdraw.tag(t, hostbase.TS_NL) - 1, hostbase.LN_N))
        } else {
            hostdraw.tas(t, hostbase.TS_CX, hostdraw.lg(t, hostdraw.tag(t, hostbase.TS_CY), hostbase.LN_N))
        }
        bewegt = true
    } else if k == KEY_BS || k == 127 {
        if hostdraw.tag(t, hostbase.TS_RO) != 0 {
            return
        }
        hostdraw.ta_push_undo(t)
        if !hostdraw.ta_del_sel(t) {
            if hostdraw.tag(t, hostbase.TS_CX) > 0 {
                let at: u64 = hostdraw.ta_back(t, hostdraw.tag(t, hostbase.TS_CY), hostdraw.tag(t, hostbase.TS_CX))
                hostdraw.ln_erase(t, hostdraw.tag(t, hostbase.TS_CY), at, hostdraw.tag(t, hostbase.TS_CX) - at)
                hostdraw.tas(t, hostbase.TS_CX, at)
            } else if hostdraw.tag(t, hostbase.TS_CY) > 0 {
                hostdraw.ta_join(t, hostdraw.tag(t, hostbase.TS_CY) - 1)
            }
        }
        geaendert = true
    } else if k == KEY_DEL || k == KEY_SDEL {
        if hostdraw.tag(t, hostbase.TS_RO) != 0 {
            return
        }
        hostdraw.ta_push_undo(t)
        if !hostdraw.ta_del_sel(t) {
            let y: u64 = hostdraw.tag(t, hostbase.TS_CY)
            let x: u64 = hostdraw.tag(t, hostbase.TS_CX)
            if x < hostdraw.lg(t, y, hostbase.LN_N) {
                hostdraw.ln_erase(t, y, x, hostdraw.ta_fwd(t, y, x) - x)
            } else if y + 1 < hostdraw.tag(t, hostbase.TS_NL) {
                hostdraw.ta_join(t, y)
            }
        }
        geaendert = true
    } else if k == KEY_ENTER {
        if hostdraw.tag(t, hostbase.TS_RO) != 0 {
            return
        }
        hostdraw.ta_push_undo(t)
        let _d: bool = hostdraw.ta_del_sel(t)
        hostdraw.ta_split(t)
        let vy: u64 = hostdraw.tag(t, hostbase.TS_CY) - 1
        let e2: u64 = hostdraw.ta_einzug(t, vy)
        if e2 > 0 {
            if hostdraw.ln_insert(t, hostdraw.tag(t, hostbase.TS_CY), 0, hostdraw.lg(t, vy, hostbase.LN_P), e2) {
                hostdraw.tas(t, hostbase.TS_CX, e2)
            }
        }
        geaendert = true
    } else if k == KEY_TAB {
        if hostdraw.tag(t, hostbase.TS_RO) != 0 {
            return
        }
        hostdraw.ta_push_undo(t)
        var sp: [u8; 8] = [32 as u8; 8]
        var br: u64 = hostdraw.tag(t, hostbase.TS_TAB)
        if br == 0 || br > 8 {
            br = 4
        }
        hostdraw.ta_insert(t, (&sp[0 as usize]) as u64, br)
        geaendert = true
    } else if k == KEY_CTRL_A {
        hostdraw.tas(t, hostbase.TS_AY, 0)
        hostdraw.tas(t, hostbase.TS_AX, 0)
        hostdraw.tas(t, hostbase.TS_CY, hostdraw.tag(t, hostbase.TS_NL) - 1)
        hostdraw.tas(t, hostbase.TS_CX, hostdraw.lg(t, hostdraw.tag(t, hostbase.TS_NL) - 1, hostbase.LN_N))
        hoststate.dirty_wd(i)
        return
    } else if k == KEY_CTRL_C || k == KEY_CTRL_X {
        hostdraw.ta_clip_put(t)
        if k == KEY_CTRL_X && hostdraw.tag(t, hostbase.TS_RO) == 0 {
            hostdraw.ta_push_undo(t)
            let _d2: bool = hostdraw.ta_del_sel(t)
            geaendert = true
        } else {
            return
        }
    } else if k == KEY_CTRL_V {
        if hostdraw.tag(t, hostbase.TS_RO) != 0 {
            return
        }
        hostdraw.ta_push_undo(t)
        hostdraw.ta_clip_take(t)
        geaendert = true
    } else if k == KEY_CTRL_Z {
        let at: u64 = hostdraw.tag(t, hostbase.TS_UAT)
        if at > 0 {
            if at == hostdraw.tag(t, hostbase.TS_UN) {
                hostdraw.ta_push_undo(t)
                hostdraw.tas(t, hostbase.TS_UAT, at)
            }
            hostdraw.ta_restore(t, at - 1)
            hostdraw.tas(t, hostbase.TS_UAT, at - 1)
            hostdraw.tas(t, hostbase.TS_DIRTY, 1)
            hoststate.dirty_wd(i)
        }
        return
    } else if k == 25 {

        let at2: u64 = hostdraw.tag(t, hostbase.TS_UAT)
        if at2 + 1 < hostdraw.tag(t, hostbase.TS_UN) {
            hostdraw.ta_restore(t, at2 + 1)
            hostdraw.tas(t, hostbase.TS_UAT, at2 + 1)
            hostdraw.tas(t, hostbase.TS_DIRTY, 1)
            hoststate.dirty_wd(i)
        }
        return
    } else if hostdraw.druckbar(k) {
        if hostdraw.tag(t, hostbase.TS_RO) != 0 {
            return
        }
        if !hostdraw.ta_isword(k) || !hostdraw.ta_has_sel(t) {
            if !hostdraw.ta_isword(k) {
                hostdraw.ta_push_undo(t)
            } else if hostdraw.tag(t, hostbase.TS_UN) == 0 {
                hostdraw.ta_push_undo(t)
            }
        }
        var ein: [u8; 8] = [0 as u8; 8]
        ein[(0) as usize] = k as u8
        hostdraw.ta_insert(t, (&ein[0 as usize]) as u64, 1)
        geaendert = true
    } else {
        return
    }

    if bewegt {
        hostdraw.ta_clamp(t)
        if !shift {
            hostdraw.ta_sel_clear(t)
        }
        hostdraw.ta_follow(t)
    }
    if geaendert {
        hostdraw.tas(t, hostbase.TS_DIRTY, 1)
        hostdraw.ta_follow(t)
    }
    hoststate.dirty_wd(i)
}

fn entry_tb(i: u64, t: *mut textbuf.TextBuf) -> bool {
    let p: u64 = hoststate.g(i, hostbase.D_TEXT)
    let max: u64 = hoststate.g(i, hostbase.D_D)
    if p == 0 || max < 1 {
        return false
    }
    textbuf.tb_init(t, p, (max - 1) as usize)
    textbuf.tb_set_len(t, hoststate.tlen(p) as usize)
    textbuf.tb_set_range(t, hoststate.g(i, hostbase.D_B) as usize, hoststate.g(i, hostbase.D_C) as usize)
    textbuf.tb_set_secret(t, (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_PASSWORD) != 0)
    return true
}

fn entry_tb_back(i: u64, t: *mut textbuf.TextBuf) {
    let n: usize = textbuf.tb_len(t)
    __mmio_write8((hoststate.g(i, hostbase.D_TEXT) + n as u64) as *mut u8, 0 as u8)
    hoststate.s(i, hostbase.D_B, textbuf.tb_caret(t) as u64)
    hoststate.s(i, hostbase.D_C, textbuf.tb_anchor(t) as u64)
}

fn entry_key(i: u64, k: u64) {
    var tb: textbuf.TextBuf = textbuf.tb_new()
    if !entry_tb(i, &tb) {
        return
    }
    if k == KEY_LEFT {
        textbuf.tb_left(&tb, false)
    } else if k == KEY_RIGHT {
        textbuf.tb_right(&tb, false)
    } else if k == KEY_HOME {
        textbuf.tb_home(&tb, false)
    } else if k == KEY_END {
        textbuf.tb_end(&tb, false)
    } else if k == KEY_BS || k == 127 {
        let _b: bool = textbuf.tb_backspace(&tb)
    } else if k == KEY_DEL {
        let _d: bool = textbuf.tb_delete_fwd(&tb)
    } else if k == 1 {

        textbuf.tb_select_all(&tb)
    } else if k == 3 || k == 24 {

        var out: [u8; 4096] = [0 as u8; 4096]
        let o: u64 = (&out[0 as usize]) as u64
        var m: usize = 0
        if k == 24 {
            m = textbuf.tb_cut(&tb, o, 4096)
        } else {
            m = textbuf.tb_copy(&tb, o, 4096)
        }
        if m > 0 {
            svcclip.clip_put(o, m as u64)
        }
    } else if k == 22 {

        var ein: [u8; 128] = [0 as u8; 128]
        let m: u64 = svcclip.clip_take((&ein[0 as usize]) as u64, 127)
        var q3: u64 = 0
        while q3 < m {
            if hostdraw.druckbar((ein[(q3) as usize]) as u64) {
                let _i: bool = textbuf.tb_insert(&tb,
                    (&ein[(q3) as usize]) as u64, 1)
            }
            q3 = q3 + 1
        }
    } else if hostdraw.druckbar(k) {
        var c: [u8; 1] = [k as u8; 1]
        let _i2: bool = textbuf.tb_insert(&tb, (&c[0 as usize]) as u64, 1)
    }
    entry_tb_back(i, &tb)
    hoststate.dirty_wd(i)
}

fn feed_key(c: u64) {
    on_key(hostbase.wncur, c)
}

fn feed_key_mod(k: u64, m: u64) {
    hostkey.s_keymod = m
    key_handle(hostbase.wncur, k)
}

fn on_key(wein: u64, c: u64) {
    let k: u64 = hostkey.decode(c)
    if k == 0 {
        return
    }
    key_handle(wein, k)
}

fn esc_spuelen(w: u64) {
    if hostkey.s_esc != 1 {
        return
    }
    hostkey.s_esc = 0
    key_handle(w, KEY_ESC)
}

fn key_handle(wein: u64, k: u64) {
    hostbase.s_keylast = k
    hostbase.s_keyseq = hostbase.s_keyseq + 1
    hoststate.blink_reset()
    var w: u64 = wein
    if hostbase.dl_win != 0xFFFFFFFFFFFFFFFF && hoststate.ng(hostbase.dl_win, hostbase.N_H) != 0 {
        w = hostbase.dl_win
    } else if hostbase.mn_win != 0xFFFFFFFFFFFFFFFF && hoststate.ng(hostbase.mn_win, hostbase.N_H) != 0 {
        w = hostbase.mn_win
    }
    if hoststate.ng(w, hostbase.N_KIND) == hostbase.NK_MENU {
        let zh: u64 = hoststate.ng(w, hostbase.N_CNT)
        if k == KEY_DOWN && hoststate.ng(w, hostbase.N_VAL) < zh {
            hoststate.ns(w, hostbase.N_VAL, hoststate.ng(w, hostbase.N_VAL) + 1)
            hoststate.dirty_all(w)
        } else if k == KEY_UP && hoststate.ng(w, hostbase.N_VAL) > 1 {
            hoststate.ns(w, hostbase.N_VAL, hoststate.ng(w, hostbase.N_VAL) - 1)
            hoststate.dirty_all(w)
        } else if k == KEY_ENTER && hoststate.ng(w, hostbase.N_VAL) > 0 {
            hostdraw.fire(hoststate.ng(w, hostbase.N_OWNER), hostbase.K_MENUBAR, hoststate.ng(w, hostbase.N_VAL) - 1, w)
        } else if k == KEY_ESC {
            hoststate.ns(w, hostbase.N_VAL, 0)
            hostdraw.fire(hoststate.ng(w, hostbase.N_OWNER), hostbase.K_MENUBAR, 0xFFFF, w)
        }
        return
    }
    if hoststate.ng(w, hostbase.N_KIND) == hostbase.NK_DLG {
        if k == KEY_ENTER {
            hostdraw.fire(hostbase.dl_ok, hostbase.K_BUTTON, 0, w)
            return
        }
        if k == KEY_ESC {
            hostdraw.fire(hostbase.dl_no, hostbase.K_BUTTON, 0, w)
            return
        }
        if hostbase.dl_ent < hostbase.MAXWD {
            entry_key(hostbase.dl_ent, k)
        }
        return
    }

    if (k == KEY_TAB || k == KEY_BTAB) && hostbase.s_canvas_tab != 0 {
        let fc: u64 = hoststate.focus_id()
        if fc < hostbase.MAXWD && hoststate.g(fc, hostbase.D_WIN) == w && hoststate.g(fc, hostbase.D_KIND) == hostbase.K_CANVAS {
            hoststate.lw_push(fc, LE_KEY, k, 0)
            return
        }
    }
    if k == KEY_TAB {
        hostdraw.next_focus(w, false)
        return
    }
    if k == KEY_BTAB {
        hostdraw.next_focus(w, true)
        return
    }
    let i: u64 = hoststate.focus_id()
    if i >= hostbase.MAXWD || hoststate.g(i, hostbase.D_WIN) != w {
        return
    }
    let kind: u64 = hoststate.g(i, hostbase.D_KIND)
    if kind == hostbase.K_ENTRY {
        if k == KEY_ENTER {
            hostdraw.fire(i, hostbase.K_ENTRY, 0, w)
            return
        }
        entry_key(i, k)
        return
    }
    if kind == hostbase.K_TEXTAREA {
        ta_key(i, k)
        return
    }
    if kind == hostbase.K_CANVAS {
        hoststate.lw_push(i, LE_KEY, k, 0)
        return
    }
    if kind == hostbase.K_BUTTON {
        if k == KEY_ENTER || k == 32 {
            hostdraw.fire(i, hostbase.K_BUTTON, 0, w)
        }
        return
    }
    if kind == hostbase.K_TILE {
        if k == KEY_ENTER || k == 32 {
            hostdraw.fire(i, hostbase.K_TILE, 0, w)
        }
        return
    }
    if kind == hostbase.K_CHECK {
        if k == KEY_ENTER || k == 32 {
            hoststate.s(i, hostbase.D_VAL, 1 - hoststate.g(i, hostbase.D_VAL))
            hoststate.dirty_wd(i)
            hostdraw.fire(i, hostbase.K_CHECK, hoststate.g(i, hostbase.D_VAL), w)
        }
        return
    }
    if kind == hostbase.K_SLIDER {
        var v: u64 = hoststate.g(i, hostbase.D_VAL)
        let schritt: u64 = hoststate.g(i, hostbase.D_A)
        var created: u64 = v
        if k == KEY_LEFT || k == KEY_DOWN {
            created = hoststate.sub(v, schritt)
        } else if k == KEY_RIGHT || k == KEY_UP {
            created = v + schritt
            if created > 100 {
                created = 100
            }
        } else if k == KEY_HOME {
            created = 0
        } else if k == KEY_END {
            created = 100
        } else {
            return
        }
        if created != v {
            hoststate.s(i, hostbase.D_VAL, created)
            hoststate.dirty_wd(i)
            hostdraw.fire(i, hostbase.K_SLIDER, created, w)
        }
        return
    }
    if kind == hostbase.K_LIST || kind == hostbase.K_TABLE {
        var int: u64 = hoststate.g(i, hostbase.D_A)
        if kind == hostbase.K_TABLE {
            int = hoststate.sub(int, 1)
        }
        if int == 0 {
            return
        }
        var v: u64 = hoststate.g(i, hostbase.D_VAL)
        if k == KEY_DOWN && v + 1 < int {
            v = v + 1
        } else if k == KEY_UP && v > 0 {
            v = v - 1
        } else if k == KEY_HOME {
            v = 0
        } else if k == KEY_END {
            v = int - 1
        } else if k == KEY_PGDN {
            v = numeric.umin(v + 10, int - 1)
        } else if k == KEY_PGUP {
            v = hoststate.sub(v, 10)
        } else if k == KEY_ENTER {
            hostdraw.fire(i, hostbase.K_LIST, v, w)
            return
        } else {
            return
        }
        hoststate.s(i, hostbase.D_VAL, v)
        scroll_to(i, v)
        hoststate.dirty_wd(i)
        return
    }
    if kind == hostbase.K_TABS {
        if k == KEY_RIGHT && hostwidget.tab_width(i, hoststate.g(i, hostbase.D_VAL) + 1) != 0 {
            hoststate.s(i, hostbase.D_VAL, hoststate.g(i, hostbase.D_VAL) + 1)
            hoststate.dirty_wd(i)
            hostdraw.fire(i, hostbase.K_TABS, hoststate.g(i, hostbase.D_VAL), w)
        } else if k == KEY_LEFT && hoststate.g(i, hostbase.D_VAL) > 0 {
            hoststate.s(i, hostbase.D_VAL, hoststate.g(i, hostbase.D_VAL) - 1)
            hoststate.dirty_wd(i)
            hostdraw.fire(i, hostbase.K_TABS, hoststate.g(i, hostbase.D_VAL), w)
        }
        return
    }
    if kind == hostbase.K_CHOICE {
        if k == KEY_ENTER || k == 32 {
            hostdraw.fire(i, hostbase.K_CHOICE, 0x1000, w)
        }
        return
    }
}

const MN_AIR: u64 = 8

fn menu_an_arbeit(w: u64, sy: u64, bh: u64) {
    let hh: u64 = hoststate.ng(w, hostbase.N_H)
    if hh == 0 {
        return
    }
    let wy: u64 = hostwin.work_y(hh)
    let wh2: u64 = hostwin.work_h(hh)
    let sh2: u64 = hosthead.screen_h()
    if wh2 == 0 || wy + wh2 > sh2 {
        return
    }
    let bottom: u64 = wy + wh2
    let now: u64 = hoststate.ng(w, hostbase.N_Y)
    if now + bh + MN_AIR <= bottom {
        return
    }
    var y: u64 = 0
    if sy > bh + MN_AIR {
        y = hoststate.sub(sy, bh + MN_AIR)
    }
    if y + bh + MN_AIR > bottom {
        if bottom > bh + MN_AIR {
            y = hoststate.sub(bottom, bh + MN_AIR)
        } else {
            y = wy
        }
    }
    if y == now {
        return
    }
    hoststate.ns(w, hostbase.N_Y, y)
    let _m: u64 = hostwin.win_move(hh, hoststate.ng(w, hostbase.N_X), y)
}

fn menu_at() -> u64 {
    return hostbase.mn_res
}

fn menu_close() {
    if hostbase.mn_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    hoststate.close(hostbase.mn_win)
    if hostbase.mn_win + 1 == hostbase.nwn {
        hostbase.nwn = hostbase.nwn - 1
    }
    hostbase.mn_win = 0xFFFFFFFFFFFFFFFF
}

fn dlg_text() -> u64 {
    return (&hostbase.dlgbuf[0 as usize]) as u64
}

fn dlg_state() -> u64 {
    return hostbase.dl_state
}

fn dlg_close() {
    if hostbase.dl_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    hostbase.dl_nb = 0
    hoststate.close(hostbase.dl_win)
    if hostbase.dl_win + 1 == hostbase.nwn {
        hostbase.nwn = hostbase.nwn - 1
    }
    hostbase.dl_win = 0xFFFFFFFFFFFFFFFF
    hostbase.dl_state = 0
    while hostbase.nwd > 0 && (hoststate.g(hostbase.nwd - 1, hostbase.D_FLAGS) & hostbase.F_HIDE) != 0 {
        hostbase.nwd = hostbase.nwd - 1
    }
    if hostbase.s_focus != 0 && hostbase.s_focus - 1 >= hostbase.nwd {
        hostbase.s_focus = 0
        var i: u64 = 0
        while i < hostbase.nwd {
            if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_FOCUSABLE) != 0 && hostbase.s_focus == 0 {
                hostbase.s_focus = i + 1
            }
            i = i + 1
        }
    }
}

const THEME_POLL_TICKS: u64 = 25

fn theme_watch() -> bool {
    let t: u64 = clockapi.ticks()
    if t < s_thpoll + THEME_POLL_TICKS {
        return false
    }
    s_thpoll = t
    s_thpolls = s_thpolls + 1
    if !thload.theme_poll() {
        return false
    }
    s_thswitch = s_thswitch + 1
    var w: u64 = 0
    while w < hostbase.nwn {
        if hoststate.ng(w, hostbase.N_H) != 0 {
            hoststate.dirty_all(w)
        }
        w = w + 1
    }
    return true
}

fn theme_now() -> bool {
    s_thpoll = 0
    return theme_watch()
}

fn theme_switches() -> u64 {
    return s_thswitch
}

fn theme_polls() -> u64 {
    return s_thpolls
}

fn theme_pixels() -> u64 {
    return hostbase.s_thpx
}

fn theme_stales() -> u64 {
    return s_thstale
}

const PT_ON: str = __env_or("FIRN_OSUM_PAINTTIME", "0")

static mut s_pt_n: u64 = 0

static mut s_pt_sum: u64 = 0

static mut s_pt_max: u64 = 0

static mut s_pt_said: u64 = 0

static mut pt_a: [u8; 20] = "wlib: paint frames=\0"

static mut pt_b: [u8; 11] = " avg_kcyc=\0"

static mut pt_c: [u8; 11] = " max_kcyc=\0"

static mut pt_d: [u8; 8] = " prims=\0"

fn pt_tsc() -> u64 {
    return asm("rdtsc\nshl rdx, 32\nor rax, rdx", out("rax"))
}

fn paint_all() -> u64 {
    let t0: u64 = pt_tsc()
    let n: u64 = paint_all_inner()
    if n != 0 {
        let dt: u64 = pt_tsc() -% t0
        s_pt_n = s_pt_n + 1
        s_pt_sum = s_pt_sum + dt
        if dt > s_pt_max {
            s_pt_max = dt
        }
        if s_pt_n == 32 && s_pt_said == 0 && PT_ON.n == 1
        && *(PT_ON.p) == 49 as u8 {
            s_pt_said = 1
            lineout.add_text((&pt_a[0 as usize]) as u64)
            lineout.add_num(s_pt_n)
            lineout.add_text((&pt_b[0 as usize]) as u64)
            lineout.add_num(s_pt_sum / s_pt_n / 1000)
            lineout.add_text((&pt_c[0 as usize]) as u64)
            lineout.add_num(s_pt_max / 1000)
            lineout.add_text((&pt_d[0 as usize]) as u64)
            lineout.add_num(fuib.fui_prims())
            lineout.end_line()
        }
    }
    return n
}

fn paint_all_inner() -> u64 {
    hostwidget.radius_apply()
    let before: u64 = thquery.theme_frame_begin()
    let _v: u64 = before
    var gemalt: u64 = 0
    var w: u64 = 0
    while w < hostbase.nwn {
        if hoststate.ng(w, hostbase.N_H) != 0 {
            gemalt = gemalt + flush_win(w)
        }
        w = w + 1
    }
    if thquery.theme_frame_end() {
        s_thstale = s_thstale + 1
        let _v2: u64 = thquery.theme_frame_begin()
        w = 0
        while w < hostbase.nwn {
            if hoststate.ng(w, hostbase.N_H) != 0 {
                hoststate.dirty_all(w)
                gemalt = gemalt + flush_win(w)
            }
            w = w + 1
        }
        let _e2: bool = thquery.theme_frame_end()
    }
    return gemalt
}

fn idle_sleep_on() {
    hostbase.s_idle_sleep = 1
}

fn rect_x(i: u64) -> u64 {
    return hoststate.g(i, hostbase.D_X)
}

fn rect_y(i: u64) -> u64 {
    return hoststate.g(i, hostbase.D_Y)
}

fn rect_w(i: u64) -> u64 {
    return hoststate.g(i, hostbase.D_W)
}

fn rect_h(i: u64) -> u64 {
    return hoststate.g(i, hostbase.D_H)
}

fn kind_of(i: u64) -> u64 {
    return hoststate.g(i, hostbase.D_KIND)
}

fn row_h() -> u64 {
    return hoststate.lines_height()
}

fn row_h_of(i: u64) -> u64 {
    let zh: u64 = hoststate.lines_height()
    if i >= hostbase.MAXWD || hoststate.g(i, hostbase.D_SECOND) == 0 {
        return zh
    }
    let th: u64 = uitext.text_h(uiscale.px_ui())
    if zh <= th {
        return 2 * zh
    }
    return 2 * th + (zh - th)
}

fn text_x(i: u64) -> u64 {
    let k: u64 = hoststate.g(i, hostbase.D_KIND)
    if k == hostbase.K_BUTTON {
        let tw: u64 = uitext.text_w(uitext.F_UI, uiscale.px_ui(), hoststate.g(i, hostbase.D_TEXT),
            hoststate.tlen(hoststate.g(i, hostbase.D_TEXT)))
        return hoststate.g(i, hostbase.D_X) + hoststate.sub(hoststate.g(i, hostbase.D_W), tw) / 2
    }
    if k == hostbase.K_ENTRY {
        return hoststate.g(i, hostbase.D_X) + 5
    }
    if k == hostbase.K_CHECK {
        return hoststate.g(i, hostbase.D_X) + 20
    }
    return hoststate.g(i, hostbase.D_X)
}

fn text_base(i: u64) -> u64 {
    let k: u64 = hoststate.g(i, hostbase.D_KIND)
    let asc: u64 = uitext.ascent_of(uitext.F_UI, uiscale.px_ui())
    if k == hostbase.K_LABEL {
        return hoststate.g(i, hostbase.D_Y) + asc
    }
    return hoststate.g(i, hostbase.D_Y) + (hoststate.g(i, hostbase.D_H) + asc) / 2
}

fn text_fg(i: u64) -> u64 {
    if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_OFF) != 0 {
        return thquery.theme(uitheme.T_DIM)
    }
    return thquery.theme(uitheme.T_FG)
}

fn text_bg(i: u64) -> u64 {
    let k: u64 = hoststate.g(i, hostbase.D_KIND)
    if k == hostbase.K_BUTTON {
        if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_PRESSED) != 0 {
            return thquery.theme(uitheme.T_BTNDN)
        }
        if (hoststate.g(i, hostbase.D_FLAGS) & hostbase.F_HOVER) != 0 {
            return thquery.theme(uitheme.T_BTNHI)
        }
        return thquery.theme(uitheme.T_BTN)
    }
    if k == hostbase.K_ENTRY {
        return thquery.theme(uitheme.T_ENTRY)
    }
    if k == hostbase.K_CHOICE {
        return thquery.theme(uitheme.T_BTN)
    }
    if hoststate.g(i, hostbase.D_WIN) < hostbase.MAXWN && hoststate.ng(hoststate.g(i, hostbase.D_WIN), hostbase.N_KIND) == hostbase.NK_DLG {
        return thquery.theme(uitheme.T_DLG)
    }
    return thquery.theme(uitheme.T_BG)
}

fn row_base(i: u64, r: u64) -> u64 {
    let zh: u64 = row_h_of(i)
    if i < hostbase.MAXWD && hoststate.g(i, hostbase.D_SECOND) != 0 {
        let hz: u64 = zh / 2
        return hoststate.g(i, hostbase.D_Y) + 2 + r * zh
            + hoststate.sub(hz, uitext.text_h(uiscale.px_ui())) / 2
            + uitext.ascent_of(uitext.F_UI, uiscale.px_ui())
    }
    return hoststate.g(i, hostbase.D_Y) + 2 + r * zh
        + hoststate.sub(zh, uitext.text_h(uiscale.px_ui())) / 2
        + uitext.ascent_of(uitext.F_UI, uiscale.px_ui())
}

fn base_in_row(ry: u64, zh: u64) -> u64 {
    return ry + hoststate.sub(zh, uitext.text_h(uiscale.px_ui())) / 2
        + uitext.ascent_of(uitext.F_UI, uiscale.px_ui())
}

fn row_x(i: u64) -> u64 {
    return hoststate.g(i, hostbase.D_X) + 6 + hostwidget.list_in(i)
}

fn icon_x(i: u64) -> u64 {
    return hoststate.g(i, hostbase.D_X) + 3 + 2 * uiscale.ui_scale()
}

fn icon_y(i: u64, r: u64) -> u64 {
    let zh: u64 = row_h_of(i)
    let ih: u64 = uiicon.icon_small()
    var top: u64 = 3
    if zh > ih {
        top = (zh - ih) / 2
    }
    return hoststate.g(i, hostbase.D_Y) + 2 + r * zh + top
}

fn tile_top(zh: u64, h: u64) -> u64 {
    if zh > hoststate.lines_height() && zh > h {
        return (zh - h) / 2
    }
    return 3
}

fn icon_letter_x(i: u64, p: u64) -> u64 {
    return hoststate.g(i, hostbase.D_X) + 5 + hoststate.sub(14, uitext.text_w(uitext.F_UI, uiscale.px_ui(),
        p, 1)) / 2
}

fn icon_letter_base(i: u64, r: u64) -> u64 {
    let zh: u64 = row_h_of(i)
    return hoststate.g(i, hostbase.D_Y) + 2 + r * zh + tile_top(zh, hoststate.tile_w()) + 12
}

fn head_h(i: u64) -> u64 {
    return hoststate.lines_height() + 4
}

fn head_base(i: u64) -> u64 {
    return hoststate.g(i, hostbase.D_Y) + 3 + uitext.ascent_of(uitext.F_UI, uiscale.px_ui())
}

fn cell_base(i: u64, r: u64) -> u64 {
    return hoststate.g(i, hostbase.D_Y) + head_h(i) + 1 + r * hoststate.lines_height()
        + uitext.ascent_of(uitext.F_UI, uiscale.px_ui()) + 1
}

fn cell_x(i: u64, c: u64) -> u64 {
    var x: u64 = hoststate.g(i, hostbase.D_X) + 6
    var k: u64 = 0
    while k < c && k < hoststate.g(i, hostbase.D_C) {
        x = x + hostwidget.column_wide(i, k)
        k = k + 1
    }

    if c == 0 {
        x = x + hostwidget.table_in(i)
    }
    return x
}

fn dlg_button(welcher: u64) -> u64 {
    if welcher == 0 {
        return hostbase.dl_ok
    }
    return hostbase.dl_no
}

fn dlg_label() -> u64 {
    return hostbase.dl_lbl
}

fn dlg_win() -> u64 {
    if hostbase.dl_win == 0xFFFFFFFFFFFFFFFF {
        return hostbase.MAXWN
    }
    return hostbase.dl_win
}

fn win_count() -> u64 {
    return hostbase.nwn
}

fn menu_win() -> u64 {
    if hostbase.mn_win == 0xFFFFFFFFFFFFFFFF {
        return hostbase.MAXWN
    }
    return hostbase.mn_win
}

