const LE_WHEEL: u64 = 5

const LE_HWHEEL: u64 = 6

const TA_CLIP: u64 = 65536

static mut ta_clipbuf: u64 = 0

fn focusable(i: u64, on: bool) {
    if i >= wlbase.nwd {
        return
    }
    if on {
        wlstate.s(i, wlbase.D_FLAGS, wlstate.g(i, wlbase.D_FLAGS) | wlbase.F_FOCUSABLE)
        return
    }
    wlstate.s(i, wlbase.D_FLAGS, wlstate.g(i, wlbase.D_FLAGS) & ~wlbase.F_FOCUSABLE)
    if wlbase.s_focus == i + 1 {
        next_focus(wlstate.g(i, wlbase.D_WIN), false)
        if wlbase.s_focus == i + 1 {
            wlbase.s_focus = 0
        }
        wlstate.dirty_wd(i)
    }
}

fn paint_slider(i: u64) {
    let x: u64 = wlstate.g(i, wlbase.D_X)
    let y: u64 = wlstate.g(i, wlbase.D_Y)
    let bw: u64 = wlstate.g(i, wlbase.D_W)
    let bh: u64 = wlstate.g(i, wlbase.D_H)
    let txt: u64 = wlstate.g(i, wlbase.D_TEXT)
    if txt != 0 && wlstate.tlen(txt) > 0 {
        let baseline: u64 = y + (bh
            + uitext.ascent_of(uitext.F_UI, uiscale.px_ui())) / 2
        wlstate.put_text(uitext.F_UI, uiscale.px_ui(), x, baseline, bw, txt,
            wlstate.tlen(txt), wlibc.theme(wlibc.T_FG), 0)
    }
    let zw: u64 = 34
    let lx: u64 = wlstate.slider_bahn(i)
    let rw: u64 = wlstate.slider_rw(i)
    if rw < 8 {
        return
    }

    let sk: u64 = uiscale.ui_scale()
    let rh: u64 = 4 * sk
    let ry: u64 = y + wlstate.sub(bh, rh) / 2
    let rbahn: u64 = wlwidget.typ_radius(wlbase.RT_BAHN, wlbase.MR_FIELD, rw, rh)
    let _fb5: bool = fuib.board(lx, ry, rw, rh, rbahn,
        wlibc.theme(wlibc.T_SCROLL), 0, 0)
    let v: u64 = wlstate.g(i, wlbase.D_VAL)
    let anteil: u64 = wlstate.slider_anteil(i)
    let gw: u64 = 14 * sk
    let bahn: u64 = wlstate.sub(rw, gw)
    let gx: u64 = lx + bahn * anteil / 100
    if anteil > 0 {
        let _fb6: bool = fuib.board(lx, ry, gx -% lx + gw / 2, rh, rbahn,
            wlibc.theme(wlibc.T_ACCENT), 0, 0)
    }
    let gr: u64 = gw / 2
    let gcx: u64 = gx + gr
    let gcy: u64 = y + bh / 2
    let _fb7: bool = fuib.board(wlstate.sub(gcx, gr), wlstate.sub(gcy, gr), 2 * gr, 2 * gr,
        wlwidget.typ_radius(wlbase.RT_GRIFF, wlbase.MR_GRIFF, 2 * gr, 2 * gr),
        wlibc.theme(wlibc.T_THUMB), wlibc.theme(wlibc.T_LINE), sk)
    var number: [u8; 8] = [0 as u8; 8]
    var n: u64 = text.digits(v, (&number[0 as usize]) as u64, true)
    if wlstate.g(i, wlbase.D_E) == 0 && wlstate.g(i, wlbase.D_F) == 100 {
        number[n as usize] = 37 as u8
        n = n + 1
    }
    number[n as usize] = 0 as u8
    let zx: u64 = x + bw -% zw
    let zgrund: u64 = y + (bh
        + uitext.ascent_of(uitext.F_UI, uiscale.px_ui())) / 2
    wlstate.put_text(uitext.F_UI, uiscale.px_ui(), zx, zgrund, zw,
        (&number[0 as usize]) as u64, n, wlibc.theme(wlibc.T_DIM), 0)
    wlwidget.focus_ring(i)
}

fn paint_check(i: u64) {
    let x: u64 = wlstate.g(i, wlbase.D_X)
    let y: u64 = wlstate.g(i, wlbase.D_Y)
    let k: u64 = wlstate.tile_w()
    let oy: u64 = y + wlstate.sub(wlstate.g(i, wlbase.D_H), k) / 2
    let _fb8: bool = fuib.board(x, oy, k, k,
        wlwidget.typ_radius(wlbase.RT_HAKEN, wlbase.MR_FIELD, k, k),
        wlibc.theme(wlibc.T_ENTRY), 0, 0)
    fuib.frame(x, oy, k, k, wlibc.theme(wlibc.T_LINE))
    if wlstate.g(i, wlbase.D_VAL) != 0 {
        var n: u64 = 0
        while n < 4 {
            fuib.dot(x + 3 + n, oy + 6 + n, wlibc.theme(wlibc.T_ACCENT))
            fuib.dot(x + 3 + n, oy + 7 + n, wlibc.theme(wlibc.T_ACCENT))
            n = n + 1
        }
        n = 0
        while n < 6 {
            fuib.dot(x + 7 + n, oy + 9 - n, wlibc.theme(wlibc.T_ACCENT))
            fuib.dot(x + 7 + n, oy + 10 - n, wlibc.theme(wlibc.T_ACCENT))
            n = n + 1
        }
    }
    let baseline: u64 = y + (wlstate.g(i, wlbase.D_H)
        + uitext.ascent_of(uitext.F_UI, uiscale.px_ui())) / 2
    wlstate.put_text(uitext.F_UI, uiscale.px_ui(), x + k + 6, baseline, wlstate.g(i, wlbase.D_W),
        wlstate.g(i, wlbase.D_TEXT), wlstate.tlen(wlstate.g(i, wlbase.D_TEXT)), wlibc.theme(wlibc.T_FG), 0)
    wlwidget.focus_ring(i)
}

fn paint_entry(i: u64) {
    let x: u64 = wlstate.g(i, wlbase.D_X)
    let y: u64 = wlstate.g(i, wlbase.D_Y)
    let bw: u64 = wlstate.g(i, wlbase.D_W)
    let bh: u64 = wlstate.g(i, wlbase.D_H)
    let _fb9: bool = fuib.board(x, y, bw, bh,
        wlwidget.typ_radius(wlbase.RT_FIELD, wlbase.MR_FIELD, bw, bh),
        wlibc.theme(wlibc.T_ENTRY), wlibc.theme(wlibc.T_LINE),
        uitheme.metric(uitheme.M_BORDER))
    let p: u64 = wlstate.show_text(i)
    let n: u64 = wlstate.tlen(p)
    let baseline: u64 = y + (bh + uitext.ascent_of(uitext.F_UI, uiscale.px_ui())) / 2
    var a: u64 = wlstate.show_at(i, wlstate.g(i, wlbase.D_B))
    var b: u64 = wlstate.show_at(i, wlstate.g(i, wlbase.D_C))
    if a > b {
        let t: u64 = a
        a = b
        b = t
    }
    if b > n {
        b = n
    }
    if a > n {
        a = n
    }
    let x_a: u64 = x + wlstate.inset_text()
        + uitext.text_w(uitext.F_UI, uiscale.px_ui(), p, a)
    let x_b: u64 = x + wlstate.inset_text()
        + uitext.text_w(uitext.F_UI, uiscale.px_ui(), p, b)
    if b > a {
        fuib.rect(x_a, y + 3, wlstate.sub(x_b, x_a), wlstate.sub(bh, 6),
            wlibc.theme(wlibc.T_SEL))
    }

    let k_x0: u64 = wlibc.clip_x0()
    let k_y0: u64 = wlibc.clip_y0()
    let k_x1: u64 = wlibc.clip_x1()
    let k_y1: u64 = wlibc.clip_y1()
    let ew: u64 = wlwidget.eye_w(i)
    if ew != 0 && x + bw - ew < k_x1 {
        wlibc.clip_set(k_x0, k_y0, x + bw - ew, k_y1)
    }
    var cx: u64 = wlibc.text_at(uitext.F_UI, uiscale.px_ui(), x + wlstate.inset_text(),
        baseline, p, a, wlibc.theme(wlibc.T_FG))
    if b > a {
        cx = wlibc.text_at(uitext.F_UI, uiscale.px_ui(), x_a, baseline,
            p + a, b - a, wlibc.theme_selfg())
    }
    if n > b {
        wlibc.text_at(uitext.F_UI, uiscale.px_ui(), x_b, baseline, p + b,
            n - b, wlibc.theme(wlibc.T_FG))
    }
    if wlbase.s_focus == i + 1 && wlstate.caret_on() {
        let mx: u64 = wlstate.entry_x(i, wlstate.g(i, wlbase.D_B))

        fuib.rect(mx, y + 3, uitheme.metric(uitheme.M_BORDER) + 1,
            wlstate.sub(bh, 6), wlibc.theme(wlibc.T_ACCENT))
    }
    wlibc.clip_set(k_x0, k_y0, k_x1, k_y1)
    wlwidget.paint_eye(i)
    wlwidget.focus_ring(i)
}

fn paint_tabs(i: u64) {
    let x: u64 = wlstate.g(i, wlbase.D_X)
    let y: u64 = wlstate.g(i, wlbase.D_Y)
    let bh: u64 = wlstate.g(i, wlbase.D_H)
    let _fb14: bool = fuib.area(x, y, wlstate.g(i, wlbase.D_W), bh, wlibc.theme(wlibc.T_PANEL))
    let zh: u64 = wlwidget.tab_rowh(i)
    var k: u64 = 0
    while k < wlbase.TABS_MAX {
        let q: u64 = wlstate.row_at(wlstate.g(i, wlbase.D_TEXT), k)
        if q == 0 {
            k = wlbase.TABS_MAX
        } else {
            let tw: u64 = wlwidget.tab_width(i, k)
            let tx: u64 = wlwidget.tab_x(i, k)
            let ty: u64 = wlwidget.tab_y(i, k)
            var area: u64 = wlibc.theme(wlibc.T_PANEL)
            var color: u64 = wlibc.theme(wlibc.T_DIM)
            if k == wlstate.g(i, wlbase.D_VAL) {
                area = wlibc.theme(wlibc.T_BG)
                color = wlibc.theme(wlibc.T_FG)
            }
            let _fb15: bool = fuib.board(tx, ty, tw, zh,
                wlwidget.typ_radius(wlbase.RT_TAB, wlbase.MR_BUTTON, tw, zh), area, 0, 0)
            fuib.vline(tx, ty, zh, wlibc.theme(wlibc.T_LINE))
            if k == wlstate.g(i, wlbase.D_VAL) {
                fuib.hline(tx, ty, tw, wlibc.theme(wlibc.T_ACCENT))
                fuib.hline(tx, ty + 1, tw, wlibc.theme(wlibc.T_ACCENT))
            } else {
                fuib.hline(tx, ty + zh - 1, tw, wlibc.theme(wlibc.T_LINE))
            }

            let voll: u64 = wlstate.row_len(q)
            let el: u64 = wlwidget.elide(uitext.F_UI, uiscale.px_ui(), q, voll,
                wlstate.sub(tw, 8))
            var qp: u64 = q
            var nmal: u64 = voll
            var nq: u64 = voll
            if el != 0 {
                qp = (&wlbase.el_buf[0 as usize]) as u64
                nmal = el
                nq = wlstate.sub(el, 3)
            }
            let base: u64 = ty
                + wlstate.sub(zh, uitext.text_h(uiscale.px_ui())) / 2
                + uitext.ascent_of(uitext.F_UI, uiscale.px_ui())
            wlstate.put_text(uitext.F_UI, uiscale.px_ui(), tx, base, tw, qp, nmal,
                color, 1)
            wlstate.say_painted_n(wlstate.g(i, wlbase.D_WIN), wlbase.K_TABS, base, color, area, qp,
                nmal, nq, voll)

            wlwidget.say_tab(wlstate.g(i, wlbase.D_WIN), k, tx, ty, tw, zh, q, nq, voll)
            k = k + 1
        }
    }
    var r: u64 = 0
    let lines: u64 = wlwidget.tab_rows(i)
    while r < lines {
        let letzt: u64 = wlwidget.tab_row_first(i, r + 1)
        var ex: u64 = x
        if r + 1 < lines {
            ex = wlwidget.tab_x(i, letzt - 1) + wlwidget.tab_width(i, letzt - 1)
        } else if wlwidget.tab_n(i) > 0 {
            ex = wlwidget.tab_x(i, wlwidget.tab_n(i) - 1) + wlwidget.tab_width(i, wlwidget.tab_n(i) - 1)
        }
        fuib.hline(ex, y + (r + 1) * zh - 1, wlstate.sub(x + wlstate.g(i, wlbase.D_W), ex),
            wlibc.theme(wlibc.T_LINE))
        r = r + 1
    }
    let sel: u64 = wlstate.g(i, wlbase.D_VAL)
    wlwidget.focus_ring_at(i, wlwidget.tab_x(i, sel), wlwidget.tab_y(i, sel), wlwidget.tab_width(i, sel), zh)
    wlibc.plate(x, y, wlstate.g(i, wlbase.D_W), bh)
}

fn paint_menubar(i: u64) {
    let x: u64 = wlstate.g(i, wlbase.D_X)
    let y: u64 = wlstate.g(i, wlbase.D_Y)
    let _fb16: bool = fuib.area(x, y, wlstate.g(i, wlbase.D_W), wlstate.g(i, wlbase.D_H),
        wlibc.theme(wlibc.T_PANEL))
    var tx: u64 = x + 4
    var k: u64 = 0
    while k < 8 {
        let q: u64 = wlstate.row_at(wlstate.g(i, wlbase.D_TEXT), k)
        if q == 0 {
            k = 8
        } else {
            let tw: u64 = uitext.text_w(uitext.F_UI, uiscale.px_ui(), q,
                wlstate.row_len(q)) + 16
            if k + 1 == wlstate.g(i, wlbase.D_VAL) {
                let _fb17: bool = fuib.board(tx, y, tw, wlstate.g(i, wlbase.D_H),
                    wlwidget.typ_radius(RT_BAR, wlbase.MR_BUTTON, tw, wlstate.g(i, wlbase.D_H)),
                    wlibc.theme(wlibc.T_SEL), 0, 0)
            }
            wlstate.put_text(uitext.F_UI, uiscale.px_ui(), tx,
                y + (wlstate.g(i, wlbase.D_H) + uitext.ascent_of(uitext.F_UI, uiscale.px_ui()))
                / 2, tw, q, wlstate.row_len(q), wlibc.theme(wlibc.T_FG), 1)
            tx = tx + tw
            k = k + 1
        }
    }
}

fn paint_choice(i: u64) {
    let x: u64 = wlstate.g(i, wlbase.D_X)
    let y: u64 = wlstate.g(i, wlbase.D_Y)
    let bw: u64 = wlstate.g(i, wlbase.D_W)
    let bh: u64 = wlstate.g(i, wlbase.D_H)
    let rc: u64 = wlwidget.typ_radius(wlbase.RT_SELECT, wlbase.MR_BUTTON, bw, bh)
    let _fbc: bool = fuib.board(x, y, bw, bh, rc,
        wlibc.theme(wlibc.T_BTN), wlibc.theme(wlibc.T_LINE),
        uitheme.metric(uitheme.M_BORDER))
    let q: u64 = wlstate.row_at(wlstate.g(i, wlbase.D_TEXT), wlstate.g(i, wlbase.D_VAL))
    if q != 0 {
        let cgr: u64 = y + (bh
            + uitext.ascent_of(uitext.F_UI, uiscale.px_ui())) / 2
        wlstate.put_text(uitext.F_UI, uiscale.px_ui(), x + wlstate.inset(), cgr, bw, q,
            wlstate.row_len(q), wlibc.theme(wlibc.T_FG), 0)
        wlstate.say_painted(wlstate.g(i, wlbase.D_WIN), wlbase.K_CHOICE, cgr, wlibc.theme(wlibc.T_FG),
            wlibc.theme(wlibc.T_BTN), q, wlstate.row_len(q))
    }
    var n: u64 = 0
    while n < 5 {
        fuib.hline(x + bw - 16 + n, y + bh / 2 - 2 + n, 10 - 2 * n,
            wlibc.theme(wlibc.T_FG))
        n = n + 1
    }
    wlwidget.focus_ring(i)
}

const RT_BAR: u64 = 13

fn draw_focus(x: u64, y: u64, w: u64, h: u64, rolle: u64) {
    let r: u64 = wlwidget.draw_radius(rolle)
    if fuib.ring(x, y, w, h, r, uitheme.metric(uitheme.M_FOCUS),
        wlibc.theme(wlibc.T_FOCUS)) {
        return
    }
    fuib.rring(x, y, w, h, r, uitheme.metric(uitheme.M_FOCUS),
        wlibc.theme(wlibc.T_FOCUS))
}

fn draw_area(x: u64, y: u64, w: u64, h: u64, color: u64) {
    if fuib.area(x, y, w, h, color) {
        return
    }
    fuib.rect(x, y, w, h, color)
}

fn draw_board(x: u64, y: u64, w: u64, h: u64, rolle: u64, level: u64,
    fuellung: u64, border: u64) {
    let r: u64 = wlwidget.typ_radius(wlbase.RT_PANEL, rolle, w, h)
    if level != uitheme.EL_FLAT {
        let s: u64 = uitheme.elev_strength(level)
        let reich: u64 = uitheme.elev_reach(level)
        if s != 0 && reich != 0 {
            fuib.shadow(x, y, w, h, r, s, reich,
                wlibc.theme(uitheme.C_SHADOW))
        }
    }

    if fuib.board(x, y, w, h, r, fuellung, border,
        uitheme.metric(uitheme.M_BORDER)) {
        return
    }
    if border == 0 {
        fuib.rrect(x, y, w, h, r, fuellung)
        return
    }
    fuib.rframe(x, y, w, h, r, uitheme.metric(uitheme.M_BORDER), border,
        fuellung)
}

fn draw_separator(x: u64, y: u64, w: u64) {
    wlibc.divider(x, y, w, wlibc.theme(wlibc.T_LINE))
}

fn draw_text(x: u64, grundlinie: u64, p: u64, n: u64, color: u64,
    level: u64) -> u64 {
    return wlibc.text_at(uitext.F_UI, uitheme.type_px(level), x, grundlinie,
        p, n, color)
}

fn draw_text_w(p: u64, n: u64, level: u64) -> u64 {
    return uitext.text_w(uitext.F_UI, uitheme.type_px(level), p, n)
}

fn draw_ascent(level: u64) -> u64 {
    return uitext.ascent_of(uitext.F_UI, uitheme.type_px(level))
}

fn draw_edge3(x: u64, y: u64, w: u64, h: u64, fuellung: u64, licht: u64,
    schatten: u64, eingedrueckt: bool) {
    fuib.rect(x, y, w, h, fuellung)
    fuib.frame3(x, y, w, h, licht, schatten, eingedrueckt)
}

fn draw_frame(x: u64, y: u64, w: u64, h: u64, rolle: u64, color: u64) {
    fuib.rring(x, y, w, h, wlwidget.draw_radius(rolle),
        uitheme.metric(uitheme.M_BORDER), color)
}

fn draw_line(x: u64, y: u64, w: u64, color: u64) {
    fuib.hline(x, y, w, color)
}

fn draw_bar(x: u64, y: u64, w: u64, h: u64, color: u64) {
    var r: u64 = wlwidget.typ_radius(wlbase.RT_BAHN, wlbase.MR_FIELD, w, h)
    if r * 2 > h {
        r = h / 2
    }
    if fuib.board(x, y, w, h, r, color, 0, 0) {
        return
    }
    fuib.rrect(x, y, w, h, r, color)
}

fn draw_point(x: u64, y: u64, color: u64) {
    fuib.dot(x, y, color)
}

fn draw_icon(id: u64, x: u64, y: u64) -> bool {
    return wlibc.icon_draw(id, x, y)
}

fn draw_spacing(level: u64) -> u64 {
    return uitheme.space(level)
}

fn anim_mix(von: u64, bis: u64, p: u64) -> u64 {
    if p >= 1000 {
        return bis
    }
    if bis >= von {
        return von + (bis - von) * p / 1000
    }
    return von - (von - bis) * p / 1000
}

fn fire(i: u64, kind: u64, index: u64, w: u64) {
    wlbase.s_fired = i + 1
    wlbase.s_fkind = kind
    wlbase.s_findex = index
    wlbase.s_fwin = w
}

fn on_wheel(w: u64, x: u64, y: u64, kerben: u64) {
    let i: u64 = wlwidget.hit_at(w, x, y)
    if i < wlbase.MAXWD && wlstate.g(i, wlbase.D_KIND) == wlbase.K_CANVAS {
        wlstate.lw_push(i, LE_WHEEL, ((x - wlstate.g(i, wlbase.D_X)) << 16) | (y - wlstate.g(i, wlbase.D_Y)), kerben)
    }
}

fn on_hwheel(w: u64, x: u64, y: u64, kerben: u64) {
    let i: u64 = wlwidget.hit_at(w, x, y)
    if i < wlbase.MAXWD && wlstate.g(i, wlbase.D_KIND) == wlbase.K_CANVAS {
        wlstate.lw_push(i, LE_HWHEEL, ((x - wlstate.g(i, wlbase.D_X)) << 16) | (y - wlstate.g(i, wlbase.D_Y)), kerben)
    }
}

fn set_keymod(m: u64) {
    hostkey.set_keymod(m)
}

fn key_mod() -> u64 {
    return hostkey.key_mod()
}

fn key_shift() -> bool {
    return hostkey.key_shift()
}

fn key_ctrl() -> bool {
    return hostkey.key_ctrl()
}

const LN_CAP: u64 = 2

const LN_W: u64 = 3

const TA_MAXL: u64 = 20000

const TS_LEFT: u64 = 6

const TS_LANG: u64 = 12

const TS_EOL: u64 = 14

const TS_F: u64 = 15

static mut ta_line: [u64; 60000] = [0 as u64; 60000]

static mut ta_st: [u64; 30] = [0 as u64; 30]

static mut ta_n: u64 = 0

static mut ta_wd: [u64; 2] = [0 as u64; 2]

fn ta_base(t: u64) -> u64 {
    return t * (TA_MAXL / wlbase.TA_MAX)
}

fn ta_maxl(t: u64) -> u64 {
    let _v: u64 = t
    return TA_MAXL / wlbase.TA_MAX
}

fn tag(t: u64, f: u64) -> u64 {
    if t >= wlbase.TA_MAX || f >= TS_F {
        return 0
    }
    return ta_st[(t * TS_F + f) as usize]
}

fn tas(t: u64, f: u64, v: u64) {
    if t >= wlbase.TA_MAX || f >= TS_F {
        return
    }
    ta_st[(t * TS_F + f) as usize] = v
}

fn lg(t: u64, y: u64, f: u64) -> u64 {
    if y >= ta_maxl(t) {
        return 0
    }
    return ta_line[((ta_base(t) + y) * LN_W + f) as usize]
}

fn ls_(t: u64, y: u64, f: u64, v: u64) {
    if y >= ta_maxl(t) {
        return
    }
    ta_line[((ta_base(t) + y) * LN_W + f) as usize] = v
}

fn ln_room(t: u64, y: u64, want: u64) -> bool {
    if lg(t, y, LN_CAP) >= want {
        return true
    }
    var cap: u64 = (want + 63) & 0xFFFFFFFFFFFFFFC0
    if cap < 64 {
        cap = 64
    }
    let p: u64 = wlibc.map_surface(cap)
    if ulib.bad(p) || p == 0 {
        return false
    }
    let alt: u64 = lg(t, y, wlbase.LN_P)
    let n: u64 = lg(t, y, wlbase.LN_N)
    if alt != 0 && n != 0 {
        var i: u64 = 0
        while i < n {
            __mmio_write8((p + i) as *mut u8, __mmio_read8((alt + i) as *mut u8))
            i = i + 1
        }
    }
    ls_(t, y, wlbase.LN_P, p)
    ls_(t, y, LN_CAP, cap)
    return true
}

fn ln_open(t: u64, at: u64) -> bool {
    let n: u64 = tag(t, wlbase.TS_NL)
    if n + 1 >= ta_maxl(t) {
        return false
    }
    var y: u64 = n
    while y > at {
        ls_(t, y, wlbase.LN_P, lg(t, y - 1, wlbase.LN_P))
        ls_(t, y, wlbase.LN_N, lg(t, y - 1, wlbase.LN_N))
        ls_(t, y, LN_CAP, lg(t, y - 1, LN_CAP))
        y = y - 1
    }
    ls_(t, at, wlbase.LN_P, 0)
    ls_(t, at, wlbase.LN_N, 0)
    ls_(t, at, LN_CAP, 0)
    tas(t, wlbase.TS_NL, n + 1)
    return true
}

fn ln_drop(t: u64, at: u64) {
    let n: u64 = tag(t, wlbase.TS_NL)
    if at >= n {
        return
    }
    var y: u64 = at
    while y + 1 < n {
        ls_(t, y, wlbase.LN_P, lg(t, y + 1, wlbase.LN_P))
        ls_(t, y, wlbase.LN_N, lg(t, y + 1, wlbase.LN_N))
        ls_(t, y, LN_CAP, lg(t, y + 1, LN_CAP))
        y = y + 1
    }
    tas(t, wlbase.TS_NL, n - 1)
}

fn ln_insert(t: u64, y: u64, at: u64, p: u64, n: u64) -> bool {
    if n == 0 {
        return true
    }
    let have: u64 = lg(t, y, wlbase.LN_N)
    if !ln_room(t, y, have + n) {
        return false
    }
    let dst: u64 = lg(t, y, wlbase.LN_P)
    var i: u64 = have
    while i > at {
        __mmio_write8((dst + i + n - 1) as *mut u8, __mmio_read8((dst + i - 1) as *mut u8))
        i = i - 1
    }
    i = 0
    while i < n {
        __mmio_write8((dst + at + i) as *mut u8, __mmio_read8((p + i) as *mut u8))
        i = i + 1
    }
    ls_(t, y, wlbase.LN_N, have + n)
    return true
}

fn ln_erase(t: u64, y: u64, at: u64, n: u64) {
    let have: u64 = lg(t, y, wlbase.LN_N)
    if at >= have || n == 0 {
        return
    }
    var cut: u64 = n
    if at + cut > have {
        cut = have - at
    }
    let p: u64 = lg(t, y, wlbase.LN_P)
    var i: u64 = at
    while i + cut < have {
        __mmio_write8((p + i) as *mut u8, __mmio_read8((p + i + cut) as *mut u8))
        i = i + 1
    }
    ls_(t, y, wlbase.LN_N, have - cut)
}

fn ta_back(t: u64, y: u64, at: u64) -> u64 {
    if at == 0 {
        return 0
    }
    let p: u64 = lg(t, y, wlbase.LN_P)
    var q: u64 = at - 1
    while q > 0 && (__mmio_read8((p + q) as *mut u8) as u64 & 0xC0) == 0x80 {
        q = q - 1
    }
    return q
}

fn ta_fwd(t: u64, y: u64, at: u64) -> u64 {
    let n: u64 = lg(t, y, wlbase.LN_N)
    if at >= n {
        return n
    }
    let p: u64 = lg(t, y, wlbase.LN_P)
    var q: u64 = at + 1
    while q < n && (__mmio_read8((p + q) as *mut u8) as u64 & 0xC0) == 0x80 {
        q = q + 1
    }
    return q
}

fn ta_cols(t: u64, y: u64, n: u64) -> u64 {
    let p: u64 = lg(t, y, wlbase.LN_P)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if (__mmio_read8((p + i) as *mut u8) as u64 & 0xC0) != 0x80 {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn ta_at_col(t: u64, y: u64, col: u64) -> u64 {
    let n: u64 = lg(t, y, wlbase.LN_N)
    let p: u64 = lg(t, y, wlbase.LN_P)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if (__mmio_read8((p + i) as *mut u8) as u64 & 0xC0) != 0x80 {
            if c == col {
                return i
            }
            c = c + 1
        }
        i = i + 1
    }
    return n
}

fn ta_has_sel(t: u64) -> bool {
    return tag(t, wlbase.TS_AY) != tag(t, wlbase.TS_CY) || tag(t, wlbase.TS_AX) != tag(t, wlbase.TS_CX)
}

fn ta_sel_clear(t: u64) {
    tas(t, wlbase.TS_AY, tag(t, wlbase.TS_CY))
    tas(t, wlbase.TS_AX, tag(t, wlbase.TS_CX))
}

fn ta_sel_first(t: u64) -> u64 {
    let ay: u64 = tag(t, wlbase.TS_AY)
    let cy: u64 = tag(t, wlbase.TS_CY)
    if ay < cy {
        return (ay << 32) | tag(t, wlbase.TS_AX)
    }
    if cy < ay {
        return (cy << 32) | tag(t, wlbase.TS_CX)
    }
    if tag(t, wlbase.TS_AX) <= tag(t, wlbase.TS_CX) {
        return (ay << 32) | tag(t, wlbase.TS_AX)
    }
    return (cy << 32) | tag(t, wlbase.TS_CX)
}

fn ta_sel_last(t: u64) -> u64 {
    let ay: u64 = tag(t, wlbase.TS_AY)
    let cy: u64 = tag(t, wlbase.TS_CY)
    if ay < cy {
        return (cy << 32) | tag(t, wlbase.TS_CX)
    }
    if cy < ay {
        return (ay << 32) | tag(t, wlbase.TS_AX)
    }
    if tag(t, wlbase.TS_AX) <= tag(t, wlbase.TS_CX) {
        return (cy << 32) | tag(t, wlbase.TS_CX)
    }
    return (ay << 32) | tag(t, wlbase.TS_AX)
}

fn ta_del_sel(t: u64) -> bool {
    if !ta_has_sel(t) {
        return false
    }
    let a: u64 = ta_sel_first(t)
    let b: u64 = ta_sel_last(t)
    let ay: u64 = a >> 32
    let ax: u64 = a & 0xFFFFFFFF
    let by: u64 = b >> 32
    let bx: u64 = b & 0xFFFFFFFF
    if ay == by {
        ln_erase(t, ay, ax, bx - ax)
    } else {
        ln_erase(t, ay, ax, lg(t, ay, wlbase.LN_N) - ax)
        let rest: u64 = lg(t, by, wlbase.LN_N)
        if rest > bx {
            let _o: bool = ln_insert(t, ay, ax, lg(t, by, wlbase.LN_P) + bx, rest - bx)
        }
        var k: u64 = ay + 1
        while k <= by {
            ln_drop(t, ay + 1)
            k = k + 1
        }
    }
    tas(t, wlbase.TS_CY, ay)
    tas(t, wlbase.TS_CX, ax)
    ta_sel_clear(t)
    return true
}

const UN_MAX: u64 = 16

const UN_P: u64 = 0

const UN_N: u64 = 1

const UN_CAP: u64 = 2

const UN_CY: u64 = 3

const UN_CX: u64 = 4

const UN_W: u64 = 5

static mut ta_un: [u64; 160] = [0 as u64; 160]

fn ug(t: u64, k: u64, f: u64) -> u64 {
    return ta_un[((t * UN_MAX + k) * UN_W + f) as usize]
}

fn us(t: u64, k: u64, f: u64, v: u64) {
    ta_un[((t * UN_MAX + k) * UN_W + f) as usize] = v
}

fn ta_bytes(t: u64) -> u64 {
    let n: u64 = tag(t, wlbase.TS_NL)
    var sum: u64 = 0
    var y: u64 = 0
    while y < n {
        sum = sum + lg(t, y, wlbase.LN_N) + 1
        y = y + 1
    }
    return sum
}

fn ta_copy_out(t: u64, dst: u64, max: u64) -> u64 {
    let n: u64 = tag(t, wlbase.TS_NL)
    var at: u64 = 0
    var y: u64 = 0
    while y < n {
        let ln: u64 = lg(t, y, wlbase.LN_N)
        let p: u64 = lg(t, y, wlbase.LN_P)
        var i: u64 = 0
        while i < ln && at < max {
            __mmio_write8((dst + at) as *mut u8, __mmio_read8((p + i) as *mut u8))
            at = at + 1
            i = i + 1
        }
        if y + 1 < n && at < max {
            __mmio_write8((dst + at) as *mut u8, 10 as u8)
            at = at + 1
        }
        y = y + 1
    }
    return at
}

fn ta_push_undo(t: u64) {
    let need: u64 = ta_bytes(t) + 16
    let at: u64 = tag(t, wlbase.TS_UAT)
    tas(t, wlbase.TS_UN, at)
    var k: u64 = at
    if k >= UN_MAX {
        var j: u64 = 0
        while j + 1 < UN_MAX {
            us(t, j, UN_P, ug(t, j + 1, UN_P))
            us(t, j, UN_N, ug(t, j + 1, UN_N))
            us(t, j, UN_CAP, ug(t, j + 1, UN_CAP))
            us(t, j, UN_CY, ug(t, j + 1, UN_CY))
            us(t, j, UN_CX, ug(t, j + 1, UN_CX))
            j = j + 1
        }
        k = UN_MAX - 1
    }
    if ug(t, k, UN_CAP) < need {
        let p: u64 = wlibc.map_surface((need + 4095) & 0xFFFFFFFFFFFFF000)
        if ulib.bad(p) || p == 0 {
            return
        }
        us(t, k, UN_P, p)
        us(t, k, UN_CAP, (need + 4095) & 0xFFFFFFFFFFFFF000)
    }
    us(t, k, UN_N, ta_copy_out(t, ug(t, k, UN_P), ug(t, k, UN_CAP)))
    us(t, k, UN_CY, tag(t, wlbase.TS_CY))
    us(t, k, UN_CX, tag(t, wlbase.TS_CX))
    tas(t, wlbase.TS_UN, k + 1)
    tas(t, wlbase.TS_UAT, k + 1)
}

fn ta_restore(t: u64, k: u64) {
    ta_set_text(t, ug(t, k, UN_P), ug(t, k, UN_N))
    tas(t, wlbase.TS_CY, ug(t, k, UN_CY))
    tas(t, wlbase.TS_CX, ug(t, k, UN_CX))
    ta_sel_clear(t)
    ta_follow(t)
}

fn ta_clear(t: u64) {
    tas(t, wlbase.TS_NL, 1)
    ls_(t, 0, wlbase.LN_N, 0)
    tas(t, wlbase.TS_CY, 0)
    tas(t, wlbase.TS_CX, 0)
    tas(t, wlbase.TS_TOP, 0)
    tas(t, TS_LEFT, 0)
    ta_sel_clear(t)
}

fn ta_set_text(t: u64, p: u64, n: u64) {
    tas(t, wlbase.TS_NL, 0)
    tas(t, TS_EOL, 0)
    var y: u64 = 0
    var start: u64 = 0
    var i: u64 = 0
    if !ln_open(t, 0) {
        return
    }
    while i <= n {
        if i == n || __mmio_read8((p + i) as *mut u8) as u64 == 10 {
            var ende: u64 = i
            if ende > start && __mmio_read8((p + ende - 1) as *mut u8) as u64 == 13 {
                ende = ende - 1
                tas(t, TS_EOL, 1)
            }
            if ende > start {
                let _o: bool = ln_insert(t, y, 0, p + start, ende - start)
            }
            if i == n {
                i = i + 1
            } else {
                y = y + 1
                if y >= ta_maxl(t) {
                    i = n + 1
                } else if !ln_open(t, y) {
                    i = n + 1
                } else {
                    start = i + 1
                    i = i + 1
                }
            }
        } else {
            i = i + 1
        }
    }
    tas(t, wlbase.TS_CY, 0)
    tas(t, wlbase.TS_CX, 0)
    tas(t, wlbase.TS_TOP, 0)
    tas(t, TS_LEFT, 0)
    ta_sel_clear(t)
}

fn ta_insert(t: u64, p: u64, n: u64) {
    if tag(t, wlbase.TS_RO) != 0 {
        return
    }
    let _d: bool = ta_del_sel(t)
    var i: u64 = 0
    var start: u64 = 0
    while i <= n {
        if i == n || __mmio_read8((p + i) as *mut u8) as u64 == 10 {
            var ende: u64 = i
            if ende > start && __mmio_read8((p + ende - 1) as *mut u8) as u64 == 13 {
                ende = ende - 1
            }
            if ende > start {
                let y: u64 = tag(t, wlbase.TS_CY)
                if ln_insert(t, y, tag(t, wlbase.TS_CX), p + start, ende - start) {
                    tas(t, wlbase.TS_CX, tag(t, wlbase.TS_CX) + (ende - start))
                }
            }
            if i < n {
                ta_split(t)
            }
            start = i + 1
        }
        i = i + 1
    }
    tas(t, wlbase.TS_DIRTY, 1)
    ta_sel_clear(t)
    ta_follow(t)
}

fn ta_split(t: u64) {
    let y: u64 = tag(t, wlbase.TS_CY)
    let at: u64 = tag(t, wlbase.TS_CX)
    let n: u64 = lg(t, y, wlbase.LN_N)
    if !ln_open(t, y + 1) {
        return
    }
    if n > at {
        let _o: bool = ln_insert(t, y + 1, 0, lg(t, y, wlbase.LN_P) + at, n - at)
        ln_erase(t, y, at, n - at)
    }
    tas(t, wlbase.TS_CY, y + 1)
    tas(t, wlbase.TS_CX, 0)
}

fn ta_join(t: u64, y: u64) {
    let n: u64 = lg(t, y, wlbase.LN_N)
    let m: u64 = lg(t, y + 1, wlbase.LN_N)
    if m > 0 {
        let _o: bool = ln_insert(t, y, n, lg(t, y + 1, wlbase.LN_P), m)
    }
    ln_drop(t, y + 1)
    tas(t, wlbase.TS_CY, y)
    tas(t, wlbase.TS_CX, n)
}

fn ta_lh() -> u64 {
    return uitext.text_h(wlibc.px_mono()) + 2
}

fn ta_cw() -> u64 {
    let c: u64 = uitext.mono_cell(wlibc.px_mono())
    if c == 0 {
        return 8
    }
    return c
}

fn ta_rows(i: u64) -> u64 {
    let h: u64 = wlstate.g(i, wlbase.D_H)
    let lh: u64 = ta_lh()
    if lh == 0 || h < 4 {
        return 1
    }
    let r: u64 = (h - 4) / lh
    if r == 0 {
        return 1
    }
    return r
}

fn ta_gutter(t: u64) -> u64 {
    if tag(t, TS_LANG) == 0xFF {
        return 0
    }
    var d: u64 = 3
    var n: u64 = tag(t, wlbase.TS_NL)
    var k: u64 = 1000
    while n >= k && d < 7 {
        d = d + 1
        k = k * 10
    }
    return d * ta_cw() + 10
}

fn ta_cols_fit(i: u64, t: u64) -> u64 {
    let w: u64 = wlstate.g(i, wlbase.D_W)
    let cw: u64 = ta_cw()
    let gut: u64 = ta_gutter(t)
    if w <= gut + wlstate.scroll_w() + 4 || cw == 0 {
        return 1
    }
    return (w - gut - wlstate.scroll_w() - 4) / cw
}

fn ta_follow(t: u64) {
    let i: u64 = ta_wd[(t) as usize]
    if i >= wlbase.nwd {
        return
    }
    let rows: u64 = ta_rows(i)
    let cy: u64 = tag(t, wlbase.TS_CY)
    var top: u64 = tag(t, wlbase.TS_TOP)
    if cy < top {
        top = cy
    }
    if cy >= top + rows {
        top = cy + 1 - rows
    }
    let n: u64 = tag(t, wlbase.TS_NL)
    if top + rows > n {
        if n > rows {
            if top > n - rows {
                top = n - rows
            }
        } else {
            top = 0
        }
    }
    tas(t, wlbase.TS_TOP, top)
    let cols: u64 = ta_cols_fit(i, t)
    let col: u64 = ta_cols(t, cy, tag(t, wlbase.TS_CX))
    var left: u64 = tag(t, TS_LEFT)
    if col < left {
        left = col
    }
    if col >= left + cols {
        left = col + 1 - cols
    }
    tas(t, TS_LEFT, left)
}

fn ta_clamp(t: u64) {
    let n: u64 = tag(t, wlbase.TS_NL)
    if tag(t, wlbase.TS_CY) >= n {
        tas(t, wlbase.TS_CY, n - 1)
    }
    let ln: u64 = lg(t, tag(t, wlbase.TS_CY), wlbase.LN_N)
    if tag(t, wlbase.TS_CX) > ln {
        tas(t, wlbase.TS_CX, ln)
    }
}

fn ta_einzug(t: u64, y: u64) -> u64 {
    let p: u64 = lg(t, y, wlbase.LN_P)
    let n: u64 = lg(t, y, wlbase.LN_N)
    var q: u64 = 0
    while q < n {
        let c: u64 = __mmio_read8((p + q) as *mut u8) as u64
        if c != 32 && c != 9 {
            return q
        }
        q = q + 1
    }
    return 0
}

fn ta_isword(c: u64) -> bool {
    if c >= 48 && c <= 57 {
        return true
    }
    if c >= 65 && c <= 90 {
        return true
    }
    if c >= 97 && c <= 122 {
        return true
    }
    if c == 95 || c >= 128 {
        return true
    }
    return false
}

fn ta_word_left(t: u64) {
    var y: u64 = tag(t, wlbase.TS_CY)
    var x: u64 = tag(t, wlbase.TS_CX)
    if x == 0 {
        if y == 0 {
            return
        }
        tas(t, wlbase.TS_CY, y - 1)
        tas(t, wlbase.TS_CX, lg(t, y - 1, wlbase.LN_N))
        return
    }
    let p: u64 = lg(t, y, wlbase.LN_P)
    while x > 0 && !ta_isword(__mmio_read8((p + ta_back(t, y, x)) as *mut u8) as u64) {
        x = ta_back(t, y, x)
    }
    while x > 0 && ta_isword(__mmio_read8((p + ta_back(t, y, x)) as *mut u8) as u64) {
        x = ta_back(t, y, x)
    }
    tas(t, wlbase.TS_CX, x)
}

fn ta_word_right(t: u64) {
    let y: u64 = tag(t, wlbase.TS_CY)
    let n: u64 = lg(t, y, wlbase.LN_N)
    var x: u64 = tag(t, wlbase.TS_CX)
    if x >= n {
        if y + 1 < tag(t, wlbase.TS_NL) {
            tas(t, wlbase.TS_CY, y + 1)
            tas(t, wlbase.TS_CX, 0)
        }
        return
    }
    let p: u64 = lg(t, y, wlbase.LN_P)
    while x < n && ta_isword(__mmio_read8((p + x) as *mut u8) as u64) {
        x = ta_fwd(t, y, x)
    }
    while x < n && !ta_isword(__mmio_read8((p + x) as *mut u8) as u64) {
        x = ta_fwd(t, y, x)
    }
    tas(t, wlbase.TS_CX, x)
}

fn ta_updown(t: u64, up: bool, n: u64) {
    var want: u64 = tag(t, wlbase.TS_WANT)
    let y0: u64 = tag(t, wlbase.TS_CY)
    if want == 0xFFFFFFFFFFFFFFFF {
        want = ta_cols(t, y0, tag(t, wlbase.TS_CX))
    }
    var y: u64 = y0
    if up {
        if y < n {
            y = 0
        } else {
            y = y - n
        }
    } else {
        y = y + n
        if y >= tag(t, wlbase.TS_NL) {
            y = tag(t, wlbase.TS_NL) - 1
        }
    }
    tas(t, wlbase.TS_CY, y)
    tas(t, wlbase.TS_CX, ta_at_col(t, y, want))
    tas(t, wlbase.TS_WANT, want)
}

fn ta_clip_put(t: u64) {
    if !ta_has_sel(t) {
        return
    }
    let a: u64 = ta_sel_first(t)
    let b: u64 = ta_sel_last(t)
    let ay: u64 = a >> 32
    let ax: u64 = a & 0xFFFFFFFF
    let by: u64 = b >> 32
    let bx: u64 = b & 0xFFFFFFFF
    if ta_clipbuf == 0 {
        ta_clipbuf = wlibc.map_surface(TA_CLIP)
        if ulib.bad(ta_clipbuf) {
            ta_clipbuf = 0
            return
        }
    }
    var at: u64 = 0
    var y: u64 = ay
    while y <= by && at < TA_CLIP {
        var von: u64 = 0
        var bis: u64 = lg(t, y, wlbase.LN_N)
        if y == ay {
            von = ax
        }
        if y == by {
            bis = bx
        }
        let p: u64 = lg(t, y, wlbase.LN_P)
        var q: u64 = von
        while q < bis && at < TA_CLIP {
            __mmio_write8((ta_clipbuf + at) as *mut u8, __mmio_read8((p + q) as *mut u8))
            at = at + 1
            q = q + 1
        }
        if y < by && at < TA_CLIP {
            __mmio_write8((ta_clipbuf + at) as *mut u8, 10 as u8)
            at = at + 1
        }
        y = y + 1
    }
    let _r: u64 = wlibc.clip_put(ta_clipbuf, at)
}

fn ta_clip_take(t: u64) {
    if ta_clipbuf == 0 {
        ta_clipbuf = wlibc.map_surface(TA_CLIP)
        if ulib.bad(ta_clipbuf) {
            ta_clipbuf = 0
            return
        }
    }
    let n: u64 = wlibc.clip_take(ta_clipbuf, TA_CLIP - 1)
    if n == 0 {
        return
    }
    ta_insert(t, ta_clipbuf, n)
}

const LANG_NONE: u64 = 0

const LANG_FIRN: u64 = 1

const LANG_SH: u64 = 2

const LANG_COUNT: u64 = 3

static mut kw_firn: [u8; 177] = "fn let var const if else while return struct import export profile true false bool u8 u64 i64 usize as pub static mut match for in break continue type enum impl self and or not\0"

static mut kw_sh: [u8; 135] = "if then else elif fi for while do done case esac function return local export echo cd set unset read exit break continue in shift test\0"

const HL_TEXT: u64 = 0

const HL_KEY: u64 = 1

const HL_STR: u64 = 2

const HL_COM: u64 = 3

const HL_NUM: u64 = 4

fn hl_color(art: u64) -> u64 {
    if art == HL_KEY {
        return wlibc.theme(wlibc.T_ACCENT)
    }
    if art == HL_STR {
        return ta_misch(wlibc.theme(wlibc.T_FG), wlibc.theme(uitheme.C_WARNING), 6)
    }
    if art == HL_COM {
        return wlibc.theme(wlibc.T_DIM)
    }
    if art == HL_NUM {
        return ta_misch(wlibc.theme(uitheme.C_ACCENT), wlibc.theme(wlibc.T_FG), 6)
    }
    return wlibc.theme(wlibc.T_FG)
}

fn ta_mix(a: u64, b: u64) -> u64 {
    return ta_misch(a, b, 3)
}

fn ta_misch(a: u64, b: u64, part: u64) -> u64 {
    let rest: u64 = 8 - part
    let r: u64 = (((a >> 16) & 0xFF) * rest + ((b >> 16) & 0xFF) * part) / 8
    let gg: u64 = (((a >> 8) & 0xFF) * rest + ((b >> 8) & 0xFF) * part) / 8
    let bb: u64 = ((a & 0xFF) * rest + (b & 0xFF) * part) / 8
    return (r << 16) | (gg << 8) | bb
}

fn kw_list(lang: u64) -> u64 {
    if lang == LANG_FIRN {
        return (&kw_firn[0 as usize]) as u64
    }
    if lang == LANG_SH {
        return (&kw_sh[0 as usize]) as u64
    }
    return 0
}

fn kw_hat(items: u64, p: u64, n: u64) -> bool {
    if items == 0 || n == 0 {
        return false
    }
    var i: u64 = 0
    while __mmio_read8((items + i) as *mut u8) as u64 != 0 {
        var j: u64 = 0
        while j < n && __mmio_read8((items + i + j) as *mut u8) as u64 == __mmio_read8((p + j) as *mut u8) as u64 {
            j = j + 1
        }
        if j == n {
            let nach: u64 = __mmio_read8((items + i + n) as *mut u8) as u64
            if nach == 32 || nach == 0 {
                return true
            }
        }
        while __mmio_read8((items + i) as *mut u8) as u64 != 0
            && __mmio_read8((items + i) as *mut u8) as u64 != 32 {
            i = i + 1
        }
        while __mmio_read8((items + i) as *mut u8) as u64 == 32 {
            i = i + 1
        }
    }
    return false
}

fn hl_run(t: u64, y: u64, x: u64) -> u64 {
    let lang: u64 = tag(t, TS_LANG)
    let p: u64 = lg(t, y, wlbase.LN_P)
    let n: u64 = lg(t, y, wlbase.LN_N)
    if lang == LANG_NONE || lang >= LANG_COUNT || x >= n {
        return ((n - x) << 8) | HL_TEXT
    }
    let c: u64 = __mmio_read8((p + x) as *mut u8) as u64
    if lang == LANG_FIRN && c == 47 && x + 1 < n
        && __mmio_read8((p + x + 1) as *mut u8) as u64 == 47 {
        return ((n - x) << 8) | HL_COM
    }
    if lang == LANG_SH && c == 35 {
        return ((n - x) << 8) | HL_COM
    }
    if c == 34 || c == 39 {
        var q: u64 = x + 1
        while q < n {
            let d: u64 = __mmio_read8((p + q) as *mut u8) as u64
            if d == 92 {
                q = q + 1
            } else if d == c {
                return ((q + 1 - x) << 8) | HL_STR
            }
            q = q + 1
        }
        return ((n - x) << 8) | HL_STR
    }

    if c >= 48 && c <= 57 {
        var q2: u64 = x
        while q2 < n {
            let d2: u64 = __mmio_read8((p + q2) as *mut u8) as u64
            if (d2 >= 48 && d2 <= 57) || (d2 | 32) == 120
                || ((d2 | 32) >= 97 && (d2 | 32) <= 102) {
                q2 = q2 + 1
            } else {
                q2 = n + 1
            }
        }
        if q2 > n {
            q2 = q2 - n - 1 + 0
            var q3: u64 = x
            while q3 < n {
                let d3: u64 = __mmio_read8((p + q3) as *mut u8) as u64
                if (d3 >= 48 && d3 <= 57) || (d3 | 32) == 120
                    || ((d3 | 32) >= 97 && (d3 | 32) <= 102) {
                    q3 = q3 + 1
                } else {
                    return ((q3 - x) << 8) | HL_NUM
                }
            }
            return ((q3 - x) << 8) | HL_NUM
        }
        return ((q2 - x) << 8) | HL_NUM
    }
    if ta_isword(c) {
        var q4: u64 = x
        while q4 < n && ta_isword(__mmio_read8((p + q4) as *mut u8) as u64) {
            q4 = q4 + 1
        }
        if kw_hat(kw_list(lang), p + x, q4 - x) {
            return ((q4 - x) << 8) | HL_KEY
        }
        return ((q4 - x) << 8) | HL_TEXT
    }
    return (1 << 8) | HL_TEXT
}

fn paint_ta(i: u64) {
    let t: u64 = wlstate.g(i, wlbase.D_VAL)
    if t >= wlbase.TA_MAX {
        return
    }
    let x: u64 = wlstate.g(i, wlbase.D_X)
    let y: u64 = wlstate.g(i, wlbase.D_Y)
    let bw: u64 = wlstate.g(i, wlbase.D_W)
    let bh: u64 = wlstate.g(i, wlbase.D_H)
    let lh: u64 = ta_lh()
    let cw: u64 = ta_cw()
    let gut: u64 = ta_gutter(t)
    let rows: u64 = ta_rows(i)
    let top: u64 = tag(t, wlbase.TS_TOP)
    let left: u64 = tag(t, TS_LEFT)
    let nl: u64 = tag(t, wlbase.TS_NL)
    let sw: u64 = wlstate.scroll_w()

    let a_x0: u64 = wlibc.clip_x0()
    let a_y0: u64 = wlibc.clip_y0()
    let a_x1: u64 = wlibc.clip_x1()
    let a_y1: u64 = wlibc.clip_y1()
    var c_x0: u64 = x
    var c_y0: u64 = y
    var c_x1: u64 = x + bw
    var c_y1: u64 = y + bh
    if a_x0 > c_x0 {
        c_x0 = a_x0
    }
    if a_y0 > c_y0 {
        c_y0 = a_y0
    }
    if a_x1 < c_x1 {
        c_x1 = a_x1
    }
    if a_y1 < c_y1 {
        c_y1 = a_y1
    }
    if c_x1 <= c_x0 || c_y1 <= c_y0 {
        wlibc.clip_set(a_x0, a_y0, a_x1, a_y1)
        return
    }
    wlibc.clip_set(c_x0, c_y0, c_x1, c_y1)

    let _fb: bool = fuib.area(x, y, bw, bh, wlibc.theme(wlibc.T_ENTRY))
    let _fb2: bool = fuib.ring(x, y, bw, bh,
        wlwidget.typ_radius(wlbase.RT_FIELD, wlbase.MR_FIELD, bw, bh), uitheme.metric(uitheme.M_BORDER),
        wlibc.theme(wlibc.T_LINE))

    if gut != 0 {
        fuib.rect(x + 1, y + 1, gut, bh - 2, wlibc.theme(wlibc.T_HEAD))
        fuib.rect(x + gut, y + 1, 1, bh - 2, wlibc.theme(wlibc.T_LINE))
    }

    var t_x0: u64 = x + gut + 1
    var t_y0: u64 = y + 1
    var t_x1: u64 = x + bw - 1 - sw
    var t_y1: u64 = y + bh - 1 - sw
    if c_x0 > t_x0 {
        t_x0 = c_x0
    }
    if c_y0 > t_y0 {
        t_y0 = c_y0
    }
    if c_x1 < t_x1 {
        t_x1 = c_x1
    }
    if c_y1 < t_y1 {
        t_y1 = c_y1
    }
    if t_x1 <= t_x0 || t_y1 <= t_y0 {
        wlibc.clip_set(a_x0, a_y0, a_x1, a_y1)
        return
    }

    let sel: bool = ta_has_sel(t)
    let sa: u64 = ta_sel_first(t)
    let sb: u64 = ta_sel_last(t)
    let say: u64 = sa >> 32
    let sax: u64 = sa & 0xFFFFFFFF
    let sby: u64 = sb >> 32
    let sbx: u64 = sb & 0xFFFFFFFF

    var r: u64 = 0
    while r < rows {
        let ln: u64 = top + r
        if ln >= nl {
            r = rows
        } else {
            let ty: u64 = y + 2 + r * lh
            let baseline: u64 = ty + uitext.ascent_of(uitext.F_MONO, wlibc.px_mono())

            if gut != 0 {
                var num: [u8; 12] = [0 as u8; 12]
                let nn: u64 = ta_num(ln + 1, (&num[0 as usize]) as u64)
                var color: u64 = wlibc.theme(wlibc.T_DIM)
                if ln == tag(t, wlbase.TS_CY) {
                    color = wlibc.theme(wlibc.T_FG)
                }
                wlibc.text_at(uitext.F_MONO, wlibc.px_mono(),
                    x + gut - 6 - nn * cw, baseline,
                    (&num[0 as usize]) as u64, nn, color)
            }
            wlibc.clip_set(t_x0, t_y0, t_x1, t_y1)
            if ln == tag(t, wlbase.TS_CY) && !sel {
                fuib.rect(x + gut + 1, ty, bw - gut - 2 - sw, lh,
                    ta_misch(wlibc.theme(wlibc.T_ENTRY),
                        wlibc.theme(wlibc.T_SEL), 1))
            }
            let p: u64 = lg(t, ln, wlbase.LN_P)
            let n: u64 = lg(t, ln, wlbase.LN_N)
            if sel && ln >= say && ln <= sby {
                var von: u64 = 0
                var bis: u64 = n
                if ln == say {
                    von = sax
                }
                if ln == sby {
                    bis = sbx
                }
                let c0: u64 = ta_cols(t, ln, von)
                var c1: u64 = ta_cols(t, ln, bis)
                if ln < sby {
                    c1 = c1 + 1
                }
                if c1 > left && c0 >= left {
                    fuib.rect(x + gut + 2 + (c0 - left) * cw, ty,
                        (c1 - c0) * cw, lh, wlibc.theme(wlibc.T_SEL))
                } else if c1 > left {
                    fuib.rect(x + gut + 2, ty, (c1 - left) * cw, lh,
                        wlibc.theme(wlibc.T_SEL))
                }
            }
            var q: u64 = ta_at_col(t, ln, left)
            var col: u64 = left
            let maxc: u64 = left + ta_cols_fit(i, t) + 1
            while q < n && col < maxc {
                let run: u64 = hl_run(t, ln, q)
                var length: u64 = run >> 8
                let art: u64 = run & 0xFF
                if length == 0 {
                    length = 1
                }
                if q + length > n {
                    length = n - q
                }
                var fg: u64 = hl_color(art)
                if sel && ln >= say && ln <= sby {
                    var iv: bool = true
                    if ln == say && q < sax {
                        iv = false
                    }
                    if ln == sby && q >= sbx {
                        iv = false
                    }
                    if iv {
                        fg = wlibc.theme_selfg()
                    }
                }
                wlibc.text_at(uitext.F_MONO, wlibc.px_mono(),
                    x + gut + 2 + (col - left) * cw, baseline, p + q, length, fg)
                col = col + ta_cols(t, ln, q + length) - ta_cols(t, ln, q)
                q = q + length
            }
            wlibc.clip_set(c_x0, c_y0, c_x1, c_y1)
            r = r + 1
        }
    }

    wlibc.clip_set(t_x0, t_y0, t_x1, t_y1)
    if wlbase.s_focus == i + 1 && wlstate.caret_on() && tag(t, wlbase.TS_CY) >= top && tag(t, wlbase.TS_CY) < top + rows {
        let ccol: u64 = ta_cols(t, tag(t, wlbase.TS_CY), tag(t, wlbase.TS_CX))
        if ccol >= left {
            fuib.rect(x + gut + 2 + (ccol - left) * cw,
                y + 2 + (tag(t, wlbase.TS_CY) - top) * lh, 2, lh,
                wlibc.theme(wlibc.T_ACCENT))
        }
    }
    wlibc.clip_set(c_x0, c_y0, c_x1, c_y1)

    if nl > rows {
        wlwidget.paint_scroll(x + bw - sw - 1, y + 1, bh - 2 - sw, top, rows, nl)
    }
    let wide: u64 = ta_longest(t)
    let fit: u64 = ta_cols_fit(i, t)
    if wide > fit {
        paint_hscroll(x + gut + 1, y + bh - sw - 1, bw - gut - 2 - sw,
            left, fit, wide)
    }
    wlwidget.focus_ring(i)
    wlibc.clip_set(a_x0, a_y0, a_x1, a_y1)
}

fn ta_longest(t: u64) -> u64 {
    let i: u64 = ta_wd[(t) as usize]
    if i >= wlbase.nwd {
        return 0
    }
    let top: u64 = tag(t, wlbase.TS_TOP)
    let rows: u64 = ta_rows(i)
    let nl: u64 = tag(t, wlbase.TS_NL)
    var m: u64 = 0
    var r: u64 = 0
    while r < rows && top + r < nl {
        let c: u64 = ta_cols(t, top + r, lg(t, top + r, wlbase.LN_N))
        if c > m {
            m = c
        }
        r = r + 1
    }
    return m
}

fn ta_num(v: u64, p: u64) -> u64 {
    var n: u64 = 0
    var q: u64 = v
    var digits: [u8; 12] = [0 as u8; 12]
    if q == 0 {
        __mmio_write8(p as *mut u8, 48 as u8)
        return 1
    }
    while q > 0 && n < 12 {
        digits[(n) as usize] = (48 + q % 10) as u8
        q = q / 10
        n = n + 1
    }
    var k: u64 = 0
    while k < n {
        __mmio_write8((p + k) as *mut u8, digits[(n - 1 - k) as usize])
        k = k + 1
    }
    return n
}

fn paint_hscroll(x: u64, y: u64, w: u64, left: u64, sicht: u64,
    ganz: u64) {
    let sw: u64 = wlstate.scroll_w()
    let _fh1: bool = fuib.area(x, y, w, sw, wlibc.theme(wlibc.T_SCROLL))
    if ganz == 0 || sicht >= ganz {
        return
    }
    var bw: u64 = w * sicht / ganz
    if bw < 12 {
        bw = 12
    }
    if bw > w {
        bw = w
    }
    var bx: u64 = 0
    if ganz > sicht {
        bx = (w - bw) * left / (ganz - sicht)
    }
    let _fh2: bool = fuib.board(x + bx, y + 2, bw, wlstate.thumb_w(),
        wlwidget.typ_radius(wlbase.RT_GRIFF, wlbase.MR_GRIFF, bw, wlstate.thumb_w()),
        wlibc.theme(wlibc.T_THUMB), 0, 0)
}

fn ta_hit(i: u64, mx: u64, my: u64) {
    let t: u64 = wlstate.g(i, wlbase.D_VAL)
    if t >= wlbase.TA_MAX {
        return
    }
    let lh: u64 = ta_lh()
    let cw: u64 = ta_cw()
    let gut: u64 = ta_gutter(t)
    let x0: u64 = wlstate.g(i, wlbase.D_X) + gut + 2
    let y0: u64 = wlstate.g(i, wlbase.D_Y) + 2
    var r: u64 = 0
    if my > y0 {
        r = (my - y0) / lh
    }
    var ln: u64 = tag(t, wlbase.TS_TOP) + r
    if ln >= tag(t, wlbase.TS_NL) {
        ln = tag(t, wlbase.TS_NL) - 1
    }
    var col: u64 = tag(t, TS_LEFT)
    if mx > x0 {
        col = col + (mx - x0 + cw / 2) / cw
    }
    tas(t, wlbase.TS_CY, ln)
    tas(t, wlbase.TS_CX, ta_at_col(t, ln, col))
    tas(t, wlbase.TS_WANT, 0xFFFFFFFFFFFFFFFF)
    ta_follow(t)
}

fn textarea() -> u64 {
    if ta_n >= wlbase.TA_MAX {
        return 0
    }
    let t: u64 = ta_n
    ta_n = ta_n + 1
    let i: u64 = wlwidget.add(wlbase.K_TEXTAREA, 0, 0, 0, true)
    wlstate.s(i, wlbase.D_VAL, t)
    ta_wd[(t) as usize] = i
    tas(t, wlbase.TS_TAB, 4)
    tas(t, TS_LANG, LANG_NONE)
    tas(t, wlbase.TS_WANT, 0xFFFFFFFFFFFFFFFF)
    ta_clear(t)
    return i
}

fn ta_of(i: u64) -> u64 {
    if i >= wlbase.nwd || wlstate.g(i, wlbase.D_KIND) != wlbase.K_TEXTAREA {
        return wlbase.TA_MAX
    }
    return wlstate.g(i, wlbase.D_VAL)
}

fn ta_text_set(i: u64, p: u64, n: u64) {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return
    }
    ta_set_text(t, p, n)
    tas(t, wlbase.TS_DIRTY, 0)
    tas(t, wlbase.TS_UN, 0)
    tas(t, wlbase.TS_UAT, 0)
    wlstate.dirty_wd(i)
}

fn ta_text_get(i: u64, p: u64, max: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return 0
    }
    return ta_copy_out(t, p, max)
}

fn ta_text_len(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return 0
    }
    return ta_bytes(i)
}

fn ta_wipe(i: u64) {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return
    }
    ta_clear(t)
    tas(t, wlbase.TS_DIRTY, 0)
    tas(t, wlbase.TS_UN, 0)
    tas(t, wlbase.TS_UAT, 0)
    wlstate.dirty_wd(i)
}

fn ta_line_count(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return 0
    }
    return tag(t, wlbase.TS_NL)
}

fn ta_row(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return 1
    }
    return tag(t, wlbase.TS_CY) + 1
}

fn ta_column(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return 1
    }
    return ta_cols(t, tag(t, wlbase.TS_CY), tag(t, wlbase.TS_CX)) + 1
}

fn ta_geaendert(i: u64) -> bool {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return false
    }
    return tag(t, wlbase.TS_DIRTY) != 0
}

fn ta_clean(i: u64) {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return
    }
    tas(t, wlbase.TS_DIRTY, 0)
}

fn ta_eol(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return 0
    }
    return tag(t, TS_EOL)
}

fn ta_eol_set(i: u64, v: u64) {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return
    }
    tas(t, TS_EOL, v)
}

fn ta_lang(i: u64, lang: u64) {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return
    }
    tas(t, TS_LANG, lang)
    wlstate.dirty_wd(i)
}

fn ta_nurlesen(i: u64, an: bool) {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return
    }
    var v: u64 = 0
    if an {
        v = 1
    }
    tas(t, wlbase.TS_RO, v)
}

fn ta_goto(i: u64, line: u64, column: u64) {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return
    }
    var y: u64 = line
    if y >= tag(t, wlbase.TS_NL) {
        y = tag(t, wlbase.TS_NL) - 1
    }
    tas(t, wlbase.TS_CY, y)
    tas(t, wlbase.TS_CX, column)
    ta_clamp(t)
    ta_sel_clear(t)
    ta_follow(t)
    wlstate.dirty_wd(i)
}

fn ta_waehle(i: u64, ay: u64, ax: u64, by: u64, bx: u64) {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return
    }
    tas(t, wlbase.TS_AY, ay)
    tas(t, wlbase.TS_AX, ax)
    tas(t, wlbase.TS_CY, by)
    tas(t, wlbase.TS_CX, bx)
    ta_clamp(t)
    ta_follow(t)
    wlstate.dirty_wd(i)
}

fn ta_row_p(i: u64, y: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX || y >= tag(t, wlbase.TS_NL) {
        return 0
    }
    return lg(t, y, wlbase.LN_P)
}

fn ta_row_n(i: u64, y: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX || y >= tag(t, wlbase.TS_NL) {
        return 0
    }
    return lg(t, y, wlbase.LN_N)
}

fn ta_put(i: u64, p: u64, n: u64) {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return
    }
    ta_push_undo(t)
    ta_insert(t, p, n)
    wlstate.dirty_wd(i)
}

fn ta_has_selection(i: u64) -> bool {
    let t: u64 = ta_of(i)
    if t >= wlbase.TA_MAX {
        return false
    }
    return ta_has_sel(t)
}

fn next_focus(w: u64, rueckwaerts: bool) {
    var n: u64 = 0
    var first: u64 = wlbase.MAXWD
    var last: u64 = wlbase.MAXWD
    var before: u64 = wlbase.MAXWD
    var move_to: u64 = wlbase.MAXWD
    let now: u64 = wlstate.focus_id()
    var i: u64 = 0
    while i < wlbase.nwd {
        if wlstate.g(i, wlbase.D_WIN) == w
            && (wlstate.g(i, wlbase.D_FLAGS) & (wlbase.F_HIDE | wlbase.F_OFF)) == 0
            && (wlstate.g(i, wlbase.D_FLAGS) & wlbase.F_FOCUSABLE) != 0 {
            if first == wlbase.MAXWD {
                first = i
            }
            last = i
            if i < now {
                before = i
            }
            if i > now && move_to == wlbase.MAXWD {
                move_to = i
            }
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 {
        return
    }
    var target: u64 = move_to
    if rueckwaerts {
        target = before
        if target == wlbase.MAXWD {
            target = last
        }
    } else if target == wlbase.MAXWD {
        target = first
    }
    wlstate.set_focus(target)
}

fn cp_len(p: u64, n: u64, at: u64) -> u64 {
    let l: u64 = utf8.seq_len(p, n, at)
    if l == 0 {
        return 1
    }
    return l
}

fn druckbar(c: u64) -> bool {
    return c >= 32 && c != 127 && c < 256
}
