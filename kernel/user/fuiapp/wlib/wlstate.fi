const LE_FELDER: u64 = 4

const LW_RING: u64 = 64

static mut lw_q: [u64; 256] = [0 as u64; 256]

static mut lw_head: u64 = 0

static mut lw_tail: u64 = 0

const GR_N: u64 = 0

const GR_HIST: u64 = 1

const GR_MAX: u64 = 4

const NK_TOAST: u64 = 4

const D_FIELDS: u64 = 30

const N_FIELDS: u64 = 14

const C_Y: u64 = 2

const C_FIELDS: u64 = 13

static mut wd: [u64; 6720] = [0 as u64; 6720]

const WN_LEN: u64 = 154

static mut wn: [u64; 154] = [0 as u64; 154]

static mut ct: [u64; 312] = [0 as u64; 312]

static mut s_blink_vis: u64 = 1

static mut s_blink_t: u64 = 0

static mut s_blink_ok: u64 = 0

fn canvas_tab(on: bool) {
    wlbase.s_canvas_tab = 0
    if on {
        wlbase.s_canvas_tab = 1
    }
}

static mut s_blink_n: u64 = 0

static mut s_tx: u64 = 0

static mut tr_a: [u8; 16] = "wlib: text win=\0"

static mut tr_k: [u8; 8] = " kind=\0\0"

static mut tr_x: [u8; 5] = " x=\0\0"

static mut tr_b: [u8; 8] = " base=\0\0"

static mut tr_f: [u8; 6] = " fg=\0\0"

static mut tr_g: [u8; 6] = " bg=\0\0"

static mut tr_w: [u8; 6] = " tw=\0\0"

static mut tr_ax: [u8; 6] = " ax=\0\0"

static mut tr_ay: [u8; 6] = " ay=\0\0"

static mut tr_a2: [u8; 17] = "wlib: text2 win=\0"

static mut tr_px: [u8; 6] = " px=\0\0"

const WD_LEN: u64 = 6720

fn field_fits() -> bool {
    if wlbase.MAXWN * N_FIELDS > WN_LEN {
        return false
    }
    if wlbase.MAXWN * DIRT_MAX * 4 > DR_LEN {
        return false
    }
    return wlbase.MAXWD * D_FIELDS <= WD_LEN
}

fn g(i: u64, f: u64) -> u64 {
    if i >= wlbase.MAXWD {
        return 0
    }
    if i * D_FIELDS + f >= WD_LEN {
        return 0
    }
    return wd[(i * D_FIELDS + f) as usize]
}

fn s(i: u64, f: u64, v: u64) {
    if i >= wlbase.MAXWD {
        return
    }
    if i * D_FIELDS + f >= WD_LEN {
        return
    }
    wd[(i * D_FIELDS + f) as usize] = v
}

fn ng(w: u64, f: u64) -> u64 {
    if w >= wlbase.MAXWN {
        return 0
    }
    if w * N_FIELDS + f >= WN_LEN {
        return 0
    }
    return wn[(w * N_FIELDS + f) as usize]
}

fn ns(w: u64, f: u64, v: u64) {
    if w >= wlbase.MAXWN {
        return
    }
    if w * N_FIELDS + f >= WN_LEN {
        return
    }
    wn[(w * N_FIELDS + f) as usize] = v
}

fn cg(c: u64, f: u64) -> u64 {
    if c >= wlbase.MAXCT {
        return 0
    }
    return ct[(c * C_FIELDS + f) as usize]
}

fn cs(c: u64, f: u64, v: u64) {
    if c >= wlbase.MAXCT {
        return
    }
    ct[(c * C_FIELDS + f) as usize] = v
}

fn tlen(p: u64) -> u64 {
    if p == 0 {
        return 0
    }
    return text.length(p)
}

fn sub(a: u64, b: u64) -> u64 {
    if b >= a {
        return 0
    }
    return a - b
}

static mut s_feldwarn: [u8; 48] = "wlib: FIELD TOO SMALL -- MAXWD*D_FIELDS > wd[]\n\0"

fn begin(nohit: bool, noclip: bool) -> bool {
    if !hoststart.start(noclip) {
        return false
    }

    let _ft: bool = fuiglyph.install()
    if !field_fits() {
        let _fw: u64 = lineout.add_text((&s_feldwarn[0 as usize]) as u64)
    }
    var path: [u8; 11] = "/etc/theme\0"
    wlibc.theme_load((&path[0 as usize]) as u64)
    if nohit {
        wlbase.s_nohit = 1
    }
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        wlbase.s_trace = 1
        say_font()
    }
    blink_setup()
    return true
}

const BLINK_MS: u64 = 500

fn blink_enabled() -> bool {
    return s_blink_ok != 0
}

fn blink_now() -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    if ulib.bad(ulib.sys(228, 1, (&ts[(0) as usize]) as u64, 0)) {
        return 0
    }
    return ts[(0) as usize] * 1000 + ts[(1) as usize] / 1000000
}

fn blink_setup() {
    s_blink_ok = 0
    if wlbase.s_trace == 0 {
        s_blink_ok = 1
    }
    var p_bl: [u8; 13] = "/etc/uiblink\0"
    let fdb: u64 = io.open((&p_bl[0 as usize]) as u64, 0)
    if !ulib.bad(fdb) {
        io.close(fdb)
        s_blink_ok = 1
    }
    s_blink_vis = 1
    s_blink_t = blink_now()
}

fn plog_enabled() -> bool {
    return hostflags.on(hostflags.PAINTLOG)
}

fn fulldamage() -> bool {
    return hostflags.on(hostflags.FULLDAMAGE)
}

fn paintdirect() -> bool {
    return hostflags.on(hostflags.PAINTDIRECT)
}

fn nominsize() -> bool {
    return hostflags.on(hostflags.NOMINSIZE)
}

fn noglass() -> bool {
    return hostflags.on(hostflags.NOGLASS)
}

fn eyeold() -> bool {
    return hostflags.on(hostflags.EYEOLD)
}

fn blink_reset() {
    if s_blink_vis == 0 && wlbase.s_focus != 0 {
        dirty_wd(wlbase.s_focus - 1)
    }
    s_blink_vis = 1
    s_blink_t = blink_now()
}

fn blink_tick() {
    if s_blink_ok == 0 || wlbase.s_focus == 0 {
        return
    }
    let i: u64 = wlbase.s_focus - 1
    let k: u64 = g(i, wlbase.D_KIND)
    if k != wlbase.K_ENTRY && k != wlbase.K_TEXTAREA {
        return
    }
    let t: u64 = blink_now()
    if t < s_blink_t + BLINK_MS {
        return
    }
    s_blink_t = t

    let wh: u64 = g(i, wlbase.D_WIN)
    if wh < wlbase.MAXWN && ng(wh, wlbase.N_H) != 0
        && wlibc.sys3w(hostwinp.WM_INFO, ng(wh, wlbase.N_H), hostwinp.WI_HIDDEN, 0) == 1 {
        if s_blink_vis == 0 {
            s_blink_vis = 1
            dirty_wd(i)
        }
        return
    }
    s_blink_vis = 1 - s_blink_vis
    s_blink_n = s_blink_n + 1
    dirty_wd(i)
    if wlbase.s_trace != 0 {
        var s_c: [u8; 18] = "wlib: caret vis=\0\0"
        var s_n: [u8; 4] = " n=\0"
        wlbase.tl_at = 0
        tl_s((&s_c[0 as usize]) as u64)
        tl_n(s_blink_vis)
        tl_s((&s_n[0 as usize]) as u64)
        tl_n(s_blink_n)
        say_pid()
        tl_end()
    }
}

static mut tl_b: [u8; 192] = [0 as u8; 192]

fn tl_s(p: u64) {
    var k: u64 = 0
    while wlbase.tl_at < 180 && __mmio_read8((p + k) as *mut u8) as u64 != 0 {
        tl_b[(wlbase.tl_at) as usize] = __mmio_read8((p + k) as *mut u8)
        wlbase.tl_at = wlbase.tl_at + 1
        k = k + 1
    }
}

fn tl_n(v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    let _n: u64 = text.digits(v, (&d[0 as usize]) as u64, true)
    tl_s((&d[0 as usize]) as u64)
}

fn tl_end() {
    tl_b[(wlbase.tl_at) as usize] = 10 as u8
    let _w: u64 = lineout.add_bytes((&tl_b[0 as usize]) as u64, wlbase.tl_at + 1)
    wlbase.tl_at = 0
}

fn say_pid() {
    var s_p: [u8; 6] = " pid=\0"
    tl_s((&s_p[0 as usize]) as u64)
    tl_n(ulib.sys(ulib.SYS_GETPID, 0, 0, 0))
}

fn caret_on() -> bool {
    return s_blink_vis != 0
}

static mut tf_a: [u8; 18] = "wlib: font ui px=\0"

static mut tf_b: [u8; 6] = " asc=\0"

static mut tf_c: [u8; 4] = " h=\0"

fn say_font() {
    let b: u64 = (&wlbase.tr_buf[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&tf_a[0 as usize]) as u64)
    at = tr_num(b, at, uiscale.px_ui())
    at = tr_put(b, at, (&tf_b[0 as usize]) as u64)
    at = tr_num(b, at, uitext.ascent_of(uitext.F_UI, uiscale.px_ui()))
    at = tr_put(b, at, (&tf_c[0 as usize]) as u64)
    at = tr_num(b, at, uitext.text_h(uiscale.px_ui()))
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = lineout.add_bytes(b, at)
}

fn counts() -> u64 {
    return wlbase.nwd
}

fn blits_done() -> u64 {
    return wlbase.s_blits
}

fn key_last() -> u64 {
    return wlbase.s_keylast
