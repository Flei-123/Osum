    wlbase.s_alive = 0
}

fn window_app(i: u64, name: u64) -> u64 {
    if i >= wlbase.MAXWN {
        return 0
    }
    return hostwin.win_app(ng(i, wlbase.N_H), name)
}

fn window_title(i: u64, text: u64) -> u64 {
    if i >= wlbase.MAXWN {
        return 0
    }
    return hostwin.win_title(ng(i, wlbase.N_H), text)
}

fn win_keys(w: u64, an: bool) -> u64 {
    if w >= wlbase.MAXWN {
        return 0
    }
    var v: u64 = 0
    if an {
        v = 1
    }
    return hostwin.win_state(ng(w, wlbase.N_H), hostwinp.WS_KEYS, v)
}

fn win_strip_h(w: u64) -> u64 {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return 0
    }
    return hostwin.win_info(ng(w, wlbase.N_H), hostwinp.WI_STRIPH)
}

fn win_backlum(w: u64, which: u64) -> u64 {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return 0
    }
    return hostwin.win_backlum(ng(w, wlbase.N_H), which)
}

fn win_strip_drag(w: u64, x0: u64, x1: u64) -> bool {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return false
    }
    return !ulib.bad(hostwin.win_state(ng(w, wlbase.N_H), hostwinp.WS_DRAGX, (x0 & 0xFFFFFFFF) | (x1 << 32)))
}

fn win_hide(w: u64, on: bool) -> u64 {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return 0
    }
    var v: u64 = 0
    if on {
        v = 1
    }
    return hostwin.win_state(ng(w, wlbase.N_H), hostwinp.WS_HIDDEN, v)
}

fn win_fokus(w: u64) -> bool {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return false
    }
    return wlibc.sys3w(hostwinp.WM_INFO, ng(w, wlbase.N_H), hostwinp.WI_FOCUS, 0) == 1
}

fn win_layer(w: u64) -> u64 {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return hostwinp.L_NORMAL
    }
    return wlibc.sys3w(hostwinp.WM_INFO, ng(w, wlbase.N_H), hostwinp.WI_LAYER, 0)
}

fn want_shared(on: bool) {
    wlbase.s_want_shared = 0
    if on {
        wlbase.s_want_shared = 1
    }
}

fn win_shared_ptr(w: u64) -> u64 {
    return ng(w, wlbase.N_SHP)
}

fn win_kshared(w: u64) -> bool {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return false
    }
    return hostwin.win_shared(ng(w, wlbase.N_H))
}

fn win_reshare(w: u64, nw: u64, nh: u64) -> u64 {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 || ng(w, wlbase.N_SHP) == 0 {
        return 0
    }
    let old: u64 = ng(w, wlbase.N_SHP)
    let oldb: u64 = ng(w, wlbase.N_SHB)
    let b: u64 = nw * nh * 4
    let p: u64 = hostwin.shm_buffer(b)
    if p == 0 {
        hostwin.shm_unmap(old, oldb)
        ns(w, wlbase.N_SHP, 0)
        ns(w, wlbase.N_SHB, 0)
        return 0
    }
    let fd: u64 = hostwin.shm_last_fd()
    let ok: bool = hostwin.win_setbuf(ng(w, wlbase.N_H), fd)
    hostwin.shm_close(fd)
    hostwin.shm_unmap(old, oldb)
    if !ok {
        hostwin.shm_unmap(p, b)
        ns(w, wlbase.N_SHP, 0)
        ns(w, wlbase.N_SHB, 0)
        return 0
    }
    ns(w, wlbase.N_SHP, p)
    ns(w, wlbase.N_SHB, b)
    return p
}

static mut tw_a: [u8; 14] = "wlib: win id=\0"

static mut tw_x: [u8; 4] = " x=\0"

static mut tw_y: [u8; 4] = " y=\0"

static mut tw_w: [u8; 4] = " w=\0"

static mut tw_h: [u8; 4] = " h=\0"

static mut tw_cx: [u8; 5] = " cx=\0"

static mut tw_cy: [u8; 5] = " cy=\0"

fn say_rects(name: u64) {
    var s_r: [u8; 8] = ": rect \0"
    var s_id: [u8; 4] = "id=\0"
    var s_k: [u8; 7] = " kind=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_h: [u8; 4] = " h=\0"
    var i: u64 = 0
    while i < wlbase.nwd {
        if (g(i, wlbase.D_FLAGS) & wlbase.F_HIDE) == 0 {
            lineout.add_text(name)
            lineout.add_text((&s_r[0 as usize]) as u64)
            lineout.add_text((&s_id[0 as usize]) as u64)
            lineout.add_num(i)
            lineout.add_text((&s_k[0 as usize]) as u64)
            lineout.add_num(g(i, wlbase.D_KIND))
            lineout.add_text((&s_x[0 as usize]) as u64)
            lineout.add_num(g(i, wlbase.D_X))
            lineout.add_text((&s_y[0 as usize]) as u64)
            lineout.add_num(g(i, wlbase.D_Y))
            lineout.add_text((&s_w[0 as usize]) as u64)
            lineout.add_num(g(i, wlbase.D_W))
            lineout.add_text((&s_h[0 as usize]) as u64)
            lineout.add_num(g(i, wlbase.D_H))
            lineout.end_line()
        }
        i = i + 1
    }
}

fn say_window(i: u64) {
    if wlbase.s_trace == 0 || i >= wlbase.MAXWN {
        return
    }
    let hh: u64 = ng(i, wlbase.N_H)
    if hh == 0 {
        return
    }
    let b: u64 = (&wlbase.tr_buf[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&tw_a[0 as usize]) as u64)
    at = tr_num(b, at, hh)
    at = tr_put(b, at, (&tw_x[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, wlbase.N_X))
    at = tr_put(b, at, (&tw_y[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, wlbase.N_Y))
    at = tr_put(b, at, (&tw_w[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, wlbase.N_W))
    at = tr_put(b, at, (&tw_h[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, wlbase.N_HH))
    at = tr_put(b, at, (&tw_cx[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, wlbase.N_X)
        +% wlibc.sys3w(hostwinp.WM_INFO, hh, hostwinp.WI_INX, 0))
    at = tr_put(b, at, (&tw_cy[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, wlbase.N_Y)
        +% wlibc.sys3w(hostwinp.WM_INFO, hh, hostwinp.WI_INY, 0))
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = lineout.add_bytes(b, at)
}

fn window_kind(w: u64) -> u64 {
    return ng(w, wlbase.N_KIND)
}

fn handle(w: u64) -> u64 {
    return ng(w, wlbase.N_H)
}

fn win_x(w: u64) -> u64 {
    win_place_get(w)
    return ng(w, wlbase.N_X)
}

fn win_y(w: u64) -> u64 {
    win_place_get(w)
    return ng(w, wlbase.N_Y)
}

fn win_place_get(w: u64) {
    if w >= wlbase.MAXWN {
        return
    }
    let h: u64 = ng(w, wlbase.N_H)
    if h == 0 {
        return
    }
    let x: u64 = hostwin.win_info(h, hostwinp.WI_X)
    let y: u64 = hostwin.win_info(h, hostwinp.WI_Y)
    if ulib.bad(x) || ulib.bad(y) {
        return
    }
    if x == ng(w, wlbase.N_X) && y == ng(w, wlbase.N_Y) {
        return
    }
    ns(w, wlbase.N_X, x)
    ns(w, wlbase.N_Y, y)
    say_window(w)
}

fn org_x(w: u64) -> u64 {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return ng(w, wlbase.N_X) + 2
    }
    let ix: u64 = wlibc.sys3w(hostwinp.WM_INFO, ng(w, wlbase.N_H), hostwinp.WI_INX, 0)
    if ulib.bad(ix) {
        return ng(w, wlbase.N_X) + 2
    }
    return ng(w, wlbase.N_X) + ix
}

fn org_y(w: u64) -> u64 {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return ng(w, wlbase.N_Y) + 22
    }
    let iy: u64 = wlibc.sys3w(hostwinp.WM_INFO, ng(w, wlbase.N_H), hostwinp.WI_INY, 0)
    if ulib.bad(iy) {
        return ng(w, wlbase.N_Y) + 22
    }
    return ng(w, wlbase.N_Y) + iy
}

fn win_cx(w: u64) -> u64 {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return 0
    }
    win_place_get(w)
    return ng(w, wlbase.N_X)
        + wlibc.sys3w(hostwinp.WM_INFO, ng(w, wlbase.N_H), hostwinp.WI_INX, 0)
}

fn win_cy(w: u64) -> u64 {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return 0
    }
    win_place_get(w)
    return ng(w, wlbase.N_Y)
        + wlibc.sys3w(hostwinp.WM_INFO, ng(w, wlbase.N_H), hostwinp.WI_INY, 0)
}

fn win_w(w: u64) -> u64 {
    return ng(w, wlbase.N_W)
}

fn win_h(w: u64) -> u64 {
    return ng(w, wlbase.N_HH)
}

fn closed(w: u64) -> bool {
    return ng(w, wlbase.N_H) == 0
}

fn close(w: u64) {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return
    }
    wlibc.sys3w(hostwinp.WM_CLOSE, ng(w, wlbase.N_H), 0, 0)
    ns(w, wlbase.N_H, 0)
    if ng(w, wlbase.N_SHP) != 0 {
        hostwin.shm_unmap(ng(w, wlbase.N_SHP), ng(w, wlbase.N_SHB))
        ns(w, wlbase.N_SHP, 0)
        ns(w, wlbase.N_SHB, 0)
    }
    var i: u64 = 0
    while i < wlbase.nwd {
        if g(i, wlbase.D_WIN) == w {
            s(i, wlbase.D_FLAGS, g(i, wlbase.D_FLAGS) | wlbase.F_HIDE)
        }
        i = i + 1
    }
}

const DIRT_MAX: u64 = 4

const DR_LEN: u64 = 176

static mut dr: [u64; 176] = [0 as u64; 176]

fn dg(w: u64, k: u64, f: u64) -> u64 {
    if (w * DIRT_MAX + k) * 4 + f >= DR_LEN {
        return 0
    }
    return dr[((w * DIRT_MAX + k) * 4 + f) as usize]
}

fn ds(w: u64, k: u64, f: u64, v: u64) {
    if (w * DIRT_MAX + k) * 4 + f >= DR_LEN {
        return
    }
    dr[((w * DIRT_MAX + k) * 4 + f) as usize] = v
}

fn area(x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    return (x1 - x0) * (y1 - y0)
}

fn set_entry(w: u64, k: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    ds(w, k, 0, x0)
    ds(w, k, 1, y0)
    ds(w, k, 2, x1)
    ds(w, k, 3, y1)
}

fn vereinen(w: u64, k: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    var a: u64 = dg(w, k, 0)
    var b: u64 = dg(w, k, 1)
    var c: u64 = dg(w, k, 2)
    var d: u64 = dg(w, k, 3)
    if x0 < a {
        a = x0
    }
    if y0 < b {
        b = y0
    }
    if x1 > c {
        c = x1
    }
    if y1 > d {
        d = y1
    }
    set_entry(w, k, a, b, c, d)
}

fn union_area(w: u64, k: u64, x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    var a: u64 = dg(w, k, 0)
    var b: u64 = dg(w, k, 1)
    var c: u64 = dg(w, k, 2)
    var d: u64 = dg(w, k, 3)
    if x0 < a {
        a = x0
    }
    if y0 < b {
        b = y0
    }
    if x1 > c {
        c = x1
    }
    if y1 > d {
        d = y1
    }
    return area(a, b, c, d)
}

fn dirty(w: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if w >= wlbase.MAXWN || ng(w, wlbase.N_H) == 0 {
        return
    }
    if x1 <= x0 || y1 <= y0 {
        return
    }
    var ax0: u64 = x0
    var ay0: u64 = y0
    var ax1: u64 = x1
    var ay1: u64 = y1
    if ax1 > ng(w, wlbase.N_W) {
        ax1 = ng(w, wlbase.N_W)
    }
    if ay1 > ng(w, wlbase.N_HH) {
        ay1 = ng(w, wlbase.N_HH)
    }
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    let fresh_f: u64 = area(ax0, ay0, ax1, ay1)
    var n: u64 = ng(w, wlbase.N_NDIRT)
    var beste: u64 = DIRT_MAX
    var bester_zuwachs: u64 = 0xFFFFFFFFFFFFFFFF
    var k: u64 = 0
    while k < n {
        let alt_f: u64 = area(dg(w, k, 0), dg(w, k, 1), dg(w, k, 2),
            dg(w, k, 3))
        let uf: u64 = union_area(w, k, ax0, ay0, ax1, ay1)
        if uf * 3 <= (alt_f + fresh_f) * 4 {
            let zuwachs: u64 = uf - alt_f
            if zuwachs < bester_zuwachs {
                bester_zuwachs = zuwachs
                beste = k
            }
        }
        k = k + 1
    }
    if beste < DIRT_MAX {
        vereinen(w, beste, ax0, ay0, ax1, ay1)
        return
    }
    if n < DIRT_MAX {
        set_entry(w, n, ax0, ay0, ax1, ay1)
        ns(w, wlbase.N_NDIRT, n + 1)
        return
    }
    var pa: u64 = 0
    var pb: u64 = 1
    var billigst: u64 = 0xFFFFFFFFFFFFFFFF
    var i: u64 = 0
    while i < n {
        var j: u64 = i + 1
        while j < n {
            let fi: u64 = area(dg(w, i, 0), dg(w, i, 1), dg(w, i, 2),
                dg(w, i, 3))
            let fj: u64 = area(dg(w, j, 0), dg(w, j, 1), dg(w, j, 2),
                dg(w, j, 3))
            let u: u64 = union_area(w, i, dg(w, j, 0), dg(w, j, 1),
                dg(w, j, 2), dg(w, j, 3))
            if u - fi - fj < billigst {
                billigst = u - fi - fj
                pa = i
                pb = j
            }
            j = j + 1
        }
        i = i + 1
    }
    vereinen(w, pa, dg(w, pb, 0), dg(w, pb, 1), dg(w, pb, 2), dg(w, pb, 3))
    set_entry(w, pb, ax0, ay0, ax1, ay1)
}

fn dirty_all(w: u64) {
    ns(w, wlbase.N_NDIRT, 1)
    set_entry(w, 0, 0, 0, ng(w, wlbase.N_W), ng(w, wlbase.N_HH))
}

fn dirty_wd(i: u64) {
    dirty(g(i, wlbase.D_WIN), g(i, wlbase.D_X), g(i, wlbase.D_Y), g(i, wlbase.D_X) + g(i, wlbase.D_W),
        g(i, wlbase.D_Y) + g(i, wlbase.D_H))
}

fn r4ab(v: u64) -> u64 {
    return v - (v % 4)
}

fn r4auf(v: u64) -> u64 {
    let r: u64 = v % 4
    if r == 0 {
        return v
    }
    return v + 4 - r
}

fn box_v(w: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64,
    gp: u64) -> u64 {
    return new_box(w, 1, x, y, bw, bh, pad, gp, 1)
}

fn box_h(w: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64,
    gp: u64) -> u64 {
    return new_box(w, 2, x, y, bw, bh, pad, gp, 1)
}

fn box_grid(w: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64, gp: u64,
    cols: u64) -> u64 {
    return new_box(w, 3, x, y, bw, bh, pad, gp, cols)
}

fn new_box(w: u64, kind: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64,
    gp: u64, cols: u64) -> u64 {
    if wlbase.nct >= wlbase.MAXCT {
        return wlbase.MAXCT
    }
    let c: u64 = wlbase.nct
    wlbase.nct = wlbase.nct + 1
    cs(c, wlbase.C_KIND, kind)
    cs(c, wlbase.C_X, r4auf(x))
    cs(c, C_Y, r4auf(y))
    cs(c, wlbase.C_W, bw)
    cs(c, wlbase.C_H, bh)
    cs(c, wlbase.C_PAD, pad)
    cs(c, wlbase.C_GAP, gp)
    cs(c, wlbase.C_COLS, cols)
    cs(c, wlbase.C_WIN, w)
    reset_box(c)
    wlbase.ctcur = c
    wlbase.wncur = w
    return c
}

fn reset_box(c: u64) {
    cs(c, wlbase.C_CX, cg(c, wlbase.C_X) + cg(c, wlbase.C_PAD))
    cs(c, wlbase.C_CY, cg(c, C_Y) + cg(c, wlbase.C_PAD))
    cs(c, wlbase.C_COL, 0)
    cs(c, wlbase.C_ROWH, 0)
}

fn box_end() {
    wlbase.ctcur = 0xFFFFFFFFFFFFFFFF
}

fn box_cy(c: u64) -> u64 {
    if c >= wlbase.MAXCT {
        return 0
    }
    return cg(c, wlbase.C_CY)
}

fn box_use(c: u64) {
    if c >= wlbase.nct {
        return
    }
    wlbase.ctcur = c
    wlbase.wncur = cg(c, wlbase.C_WIN)
}

fn box_at(c: u64, x: u64, y: u64, bw: u64, bh: u64) {
    if c >= wlbase.nct {
        return
    }
    cs(c, wlbase.C_X, r4auf(x))
    cs(c, C_Y, r4auf(y))
    cs(c, wlbase.C_W, bw)
    cs(c, wlbase.C_H, bh)
    reset_box(c)
}

fn size(w: u64, h: u64) {
    wlbase.want_w = w
    wlbase.want_h = h
}

fn umbruch() {
    wlbase.want_flags = wlbase.want_flags | wlbase.F_UMBRUCH
}

fn set_size(i: u64, w: u64, h: u64) {
    if i >= wlbase.nwd {
        return
    }
    s(i, wlbase.D_PW, w)
    s(i, wlbase.D_PH, h)
}

fn gap_after(n: u64) {
    wlbase.want_gap = n
}

fn canvas_set(i: u64, px: u64, bw: u64, bh: u64, line: u64) {
    if i >= wlbase.nwd || g(i, wlbase.D_KIND) != wlbase.K_CANVAS {
        return
    }
    s(i, wlbase.D_TEXT, px)
    s(i, wlbase.D_A, bw)
    s(i, wlbase.D_B, bh)
    s(i, wlbase.D_C, line)
    dirty_wd(i)
}

fn canvas_new(i: u64) {
    if i >= wlbase.nwd {
        return
    }
    dirty_wd(i)
}

fn canvas_new_part(i: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if i >= wlbase.nwd {
        return
    }
    var ax: u64 = g(i, wlbase.D_X) + x1
    var ay: u64 = g(i, wlbase.D_Y) + y1
    if ax > g(i, wlbase.D_X) + g(i, wlbase.D_W) {
        ax = g(i, wlbase.D_X) + g(i, wlbase.D_W)
    }
    if ay > g(i, wlbase.D_Y) + g(i, wlbase.D_H) {
        ay = g(i, wlbase.D_Y) + g(i, wlbase.D_H)
    }
    dirty(g(i, wlbase.D_WIN), g(i, wlbase.D_X) + x0, g(i, wlbase.D_Y) + y0, ax, ay)
}

fn lw_push(i: u64, art: u64, a: u64, b: u64) {
    if art == wlbase.LE_MOVE && lw_head != lw_tail {
        let last: u64 = ((lw_head + LW_RING - 1) % LW_RING) * LE_FELDER
        if lw_q[(last + 1) as usize] == wlbase.LE_MOVE
            && lw_q[(last) as usize] == i {
            lw_q[(last + 2) as usize] = a
            lw_q[(last + 3) as usize] = b
            return
        }
    }
    let following: u64 = (lw_head + 1) % LW_RING
    if following == lw_tail {
        lw_tail = (lw_tail + 1) % LW_RING
    }
    let at: u64 = lw_head * LE_FELDER
    lw_q[(at) as usize] = i
    lw_q[(at + 1) as usize] = art
    lw_q[(at + 2) as usize] = a
    lw_q[(at + 3) as usize] = b
    lw_head = following
}

fn canvas_event(aus: u64) -> bool {
    if lw_head == lw_tail {
        return false
    }
    let at: u64 = lw_tail * LE_FELDER
    __mmio_write64((aus) as *mut u64, lw_q[(at) as usize])
    __mmio_write64((aus + 8) as *mut u64, lw_q[(at + 1) as usize])
    __mmio_write64((aus + 16) as *mut u64, lw_q[(at + 2) as usize])
    __mmio_write64((aus + 24) as *mut u64, lw_q[(at + 3) as usize])
    lw_tail = (lw_tail + 1) % LW_RING
    return true
}

fn canvas_pending() -> u64 {
    return (lw_head + LW_RING - lw_tail) % LW_RING
}

fn canvas_pending_for(wd: u64) -> u64 {
    var n: u64 = 0
    var k: u64 = lw_tail
    while k != lw_head {
        if lw_q[(k * LE_FELDER) as usize] == wd {
            n = n + 1
        }
        k = (k + 1) % LW_RING
    }
    return n
}

fn canvas_event_for(wd: u64, aus: u64) -> bool {
    var k: u64 = lw_tail
    while k != lw_head {
        let at: u64 = k * LE_FELDER
        if lw_q[(at) as usize] == wd {
            __mmio_write64((aus) as *mut u64, lw_q[(at) as usize])
            __mmio_write64((aus + 8) as *mut u64, lw_q[(at + 1) as usize])
            __mmio_write64((aus + 16) as *mut u64, lw_q[(at + 2) as usize])
            __mmio_write64((aus + 24) as *mut u64, lw_q[(at + 3) as usize])

            var j: u64 = k
            while j != lw_tail {
                let prev: u64 = (j + LW_RING - 1) % LW_RING
                var f: u64 = 0
                while f < LE_FELDER {
                    lw_q[(j * LE_FELDER + f) as usize] = lw_q[(prev * LE_FELDER + f) as usize]
                    f = f + 1
                }
                j = prev
            }
            lw_tail = (lw_tail + 1) % LW_RING
            return true
        }
        k = (k + 1) % LW_RING
    }
    return false
}

fn paint_canvas(i: u64) {
    let px: u64 = g(i, wlbase.D_TEXT)
    if px == 0 {
        return
    }
    let bw: u64 = g(i, wlbase.D_A)
    let bh: u64 = g(i, wlbase.D_B)
    let line: u64 = g(i, wlbase.D_C)
    var ww: u64 = g(i, wlbase.D_W)
    if ww > bw {
        ww = bw
    }
    if ww > line {
        ww = line
    }
    var hh: u64 = g(i, wlbase.D_H)
    if hh > bh {
        hh = bh
    }
    var x0: u64 = g(i, wlbase.D_X)
    var x1: u64 = g(i, wlbase.D_X) + ww
    var y0: u64 = g(i, wlbase.D_Y)
    var y1: u64 = g(i, wlbase.D_Y) + hh
    if x0 < wlibc.clip_x0() {
        x0 = wlibc.clip_x0()
    }
    if x1 > wlibc.clip_x1() {
        x1 = wlibc.clip_x1()
    }
    if y0 < wlibc.clip_y0() {
        y0 = wlibc.clip_y0()
    }
    if y1 > wlibc.clip_y1() {
        y1 = wlibc.clip_y1()
    }
    let band: u64 = hosthead.band_y()
    let rows: u64 = hosthead.surf_rows()
    let sw: u64 = hosthead.surf_w()
    if x1 > sw {
        x1 = sw
    }
    if x1 <= x0 {
        return
    }
    if y0 < band {
        y0 = band
    }
    if y1 > band + rows {
        y1 = band + rows
    }
    let n: u64 = (x1 - x0) * 4
    var y: u64 = y0
    while y < y1 {
        let source: u64 = px + ((y - g(i, wlbase.D_Y)) * line + (x0 - g(i, wlbase.D_X))) * 4
        let target: u64 = hosthead.surface() + ((y - band) * sw + x0) * 4
        memcopy.copy(target, source, n)
        y = y + 1
    }
}

fn gspec(i: u64, f: u64) -> u64 {
    let p: u64 = g(i, wlbase.D_A)
    if p == 0 {
        return 0
    }
    return __mmio_read64((p + f * 8) as *mut u64)
}

fn graph_x(i: u64, k: u64) -> u64 {
    let hist: u64 = gspec(i, GR_HIST)
    if hist == 0 {
        return g(i, wlbase.D_X)
    }
    return g(i, wlbase.D_X) + 1 + k * sub(g(i, wlbase.D_W), 2) / hist
}

fn graph_y(i: u64, v: u64) -> u64 {
    var m: u64 = gspec(i, GR_MAX)
    if m == 0 {
        m = 1
    }
    var w: u64 = v
    if w > m {
        w = m
    }
    let innen: u64 = sub(g(i, wlbase.D_H), 3)
    return g(i, wlbase.D_Y) + 1 + innen - w * innen / m
}

fn graph_value(p: u64, k: u64) -> u64 {
    if p == 0 {
        return 0
    }
    return __mmio_read64((p + k * 8) as *mut u64)
}

fn paint_curve(i: u64, reihe: u64, color: u64, thick: bool) {
    let n: u64 = gspec(i, GR_N)
    if reihe == 0 || n == 0 {
        return
    }
    var k: u64 = 0
    while k < n {
        let x: u64 = graph_x(i, k)
        let y: u64 = graph_y(i, graph_value(reihe, k))
        var y0: u64 = y
        if k > 0 {
            y0 = graph_y(i, graph_value(reihe, k - 1))
        }
        var top: u64 = y
        var bottom: u64 = y0
        if y0 < y {
            top = y0
            bottom = y
        }
        if thick {
            fuib.rect(x, top, 2, bottom - top + 2, color)
        } else if (k % 2) == 0 {
            fuib.rect(x, top, 1, bottom - top + 1, color)
        }
        k = k + 1
    }
}

fn set_icon(i: u64, cp: u64) {
    if i >= wlbase.nwd || g(i, wlbase.D_KIND) != wlbase.K_BUTTON {
        return
    }
    if g(i, wlbase.D_BICON) != cp {
        s(i, wlbase.D_BICON, cp)
        dirty_wd(i)
    }
}

fn list_two(i: u64, an: bool) {
    if i >= wlbase.MAXWD {
        return
    }
    var v: u64 = 0
    if an {
        v = 1
    }
    s(i, wlbase.D_SECOND, v)
    dirty_wd(i)
}

fn list_einklick(i: u64, an: bool) {
    if i >= wlbase.MAXWD {
        return
    }
    if an {
        s(i, wlbase.D_FLAGS, g(i, wlbase.D_FLAGS) | wlbase.F_EINKLICK)
    } else {
        s(i, wlbase.D_FLAGS, g(i, wlbase.D_FLAGS) & ~wlbase.F_EINKLICK)
    }
}

fn image_set(i: u64, p: u64, w: u64, h: u64) {
    if i >= wlbase.nwd || g(i, wlbase.D_KIND) != wlbase.K_IMAGE {
        return
    }
    s(i, wlbase.D_E, p)
    s(i, wlbase.D_F, w)
    s(i, wlbase.D_G, h)
    s(i, wlbase.D_PX, 0)
    s(i, wlbase.D_PY, 0)
    s(i, wlbase.D_ROTATION, 0)
    s(i, wlbase.D_ZOOM, 100)
    dirty_wd(i)
}

fn image_bw(i: u64) -> u64 {
    if g(i, wlbase.D_ROTATION) == 1 || g(i, wlbase.D_ROTATION) == 3 {
        return g(i, wlbase.D_G)
    }
    return g(i, wlbase.D_F)
}

fn image_bh(i: u64) -> u64 {
    if g(i, wlbase.D_ROTATION) == 1 || g(i, wlbase.D_ROTATION) == 3 {
        return g(i, wlbase.D_F)
    }
    return g(i, wlbase.D_G)
}

fn image_tool(i: u64, m: u64) {
    if i >= wlbase.nwd || g(i, wlbase.D_KIND) != wlbase.K_IMAGE {
        return
    }
    s(i, wlbase.D_WZ, m)
    wlbase.s_aus_da = 0
    dirty_wd(i)
}

fn image_ox(i: u64) -> u64 {
    let zw: u64 = image_bw(i) * g(i, wlbase.D_ZOOM) / 100
    var ox: u64 = g(i, wlbase.D_X)
    if zw < g(i, wlbase.D_W) {
        ox = g(i, wlbase.D_X) + (g(i, wlbase.D_W) - zw) / 2
    }
    return ox +% g(i, wlbase.D_PX)
}

fn image_oy(i: u64) -> u64 {
    let zh: u64 = image_bh(i) * g(i, wlbase.D_ZOOM) / 100
    var oy: u64 = g(i, wlbase.D_Y)
    if zh < g(i, wlbase.D_H) {
        oy = g(i, wlbase.D_Y) + (g(i, wlbase.D_H) - zh) / 2
    }
    return oy +% g(i, wlbase.D_PY)
}

fn image_px(i: u64, x: u64) -> u64 {
    let ox: u64 = image_ox(i)
    if x <= ox {
        return 0
    }
    let v: u64 = (x - ox) * 100 / g(i, wlbase.D_ZOOM)
    if v >= g(i, wlbase.D_F) {
        return g(i, wlbase.D_F) - 1
    }
    return v
}

fn image_py(i: u64, y: u64) -> u64 {
    let oy: u64 = image_oy(i)
    if y <= oy {
        return 0
    }
    let v: u64 = (y - oy) * 100 / g(i, wlbase.D_ZOOM)
    if v >= g(i, wlbase.D_G) {
        return g(i, wlbase.D_G) - 1
    }
    return v
}

fn img_out_present() -> bool {
    return wlbase.s_aus_da != 0
}

fn img_out_x0() -> u64 {
    if wlbase.s_aus_x1 < wlbase.s_aus_x0 {
        return wlbase.s_aus_x1
    }
    return wlbase.s_aus_x0
}

fn img_out_y0() -> u64 {
    if wlbase.s_aus_y1 < wlbase.s_aus_y0 {
        return wlbase.s_aus_y1
    }
    return wlbase.s_aus_y0
}

fn img_out_x1() -> u64 {
    if wlbase.s_aus_x1 < wlbase.s_aus_x0 {
        return wlbase.s_aus_x0
    }
    return wlbase.s_aus_x1
}

fn img_out_y1() -> u64 {
    if wlbase.s_aus_y1 < wlbase.s_aus_y0 {
        return wlbase.s_aus_y0
    }
    return wlbase.s_aus_y1
}

fn img_out_gone() {
    wlbase.s_aus_da = 0
}

fn image_zoom(i: u64) -> u64 {
    return g(i, wlbase.D_ZOOM)
}

fn image_set_zoom(i: u64, z: u64) {
    if i >= wlbase.nwd || g(i, wlbase.D_KIND) != wlbase.K_IMAGE {
        return
    }
    var v: u64 = z
    if v < 5 {
        v = 5
    }
    if v > 3200 {
        v = 3200
    }
    s(i, wlbase.D_ZOOM, v)
    dirty_wd(i)
}

fn image_pan(i: u64, dx: u64, dy: u64) {
    if i >= wlbase.nwd || g(i, wlbase.D_KIND) != wlbase.K_IMAGE {
        return
    }
    s(i, wlbase.D_PX, g(i, wlbase.D_PX) +% dx)
    s(i, wlbase.D_PY, g(i, wlbase.D_PY) +% dy)
    dirty_wd(i)
}

fn image_rotate(i: u64, r: u64) {
    if i >= wlbase.nwd || g(i, wlbase.D_KIND) != wlbase.K_IMAGE {
        return
    }
    s(i, wlbase.D_ROTATION, (g(i, wlbase.D_ROTATION) + r) & 3)
    s(i, wlbase.D_PX, 0)
    s(i, wlbase.D_PY, 0)
    dirty_wd(i)
}

fn image_rot_from(i: u64) -> u64 {
    return g(i, wlbase.D_ROTATION)
}

fn image_fit(i: u64) {
    if i >= wlbase.nwd || g(i, wlbase.D_KIND) != wlbase.K_IMAGE {
        return
    }
    let bw: u64 = image_bw(i)
    let bh: u64 = image_bh(i)
    if bw == 0 || bh == 0 {
        return
    }
    var z: u64 = g(i, wlbase.D_W) * 100 / bw
    let zy: u64 = g(i, wlbase.D_H) * 100 / bh
    if zy < z {
        z = zy
    }
    if z > 100 {
        z = 100
    }
    if z < 5 {
        z = 5
    }
    s(i, wlbase.D_ZOOM, z)
    s(i, wlbase.D_PX, 0)
    s(i, wlbase.D_PY, 0)
    dirty_wd(i)
}

fn slider_anteil(i: u64) -> u64 {
    let lo: u64 = g(i, wlbase.D_E)
    let hi: u64 = g(i, wlbase.D_F)
    var v: u64 = g(i, wlbase.D_VAL)
    if v < lo {
        v = lo
    }
    if v > hi {
        v = hi
    }
    if hi <= lo {
        return 0
    }
    return (v - lo) * 100 / (hi - lo)
}

fn slider_set(i: u64, x: u64) {
    let lo: u64 = g(i, wlbase.D_E)
    let hi: u64 = g(i, wlbase.D_F)
    let bx: u64 = g(i, wlbase.D_X) + thumb_w() / 2
    let bw: u64 = g(i, wlbase.D_W) - thumb_w()
    var v: u64 = lo
    if bw > 0 {
        if x > bx {
            let d: u64 = x - bx
            if d >= bw {
                v = hi
            } else {
                v = lo + (hi - lo) * d / bw
            }
        }
    }
    if v != g(i, wlbase.D_VAL) {
        s(i, wlbase.D_VAL, v)
        dirty_wd(i)
    }
}

fn tile_h() -> u64 {
    return uitheme.metric(uitheme.M_ROW) + 8
}

fn tspec(i: u64, f: u64) -> u64 {
    let p: u64 = g(i, wlbase.D_A)
    if p == 0 {
        return 0
    }
    return __mmio_read64((p + f * 8) as *mut u64)
}

fn value(i: u64) -> u64 {
    return g(i, wlbase.D_VAL)
}

fn set_value(i: u64, v: u64) {
    if g(i, wlbase.D_VAL) == v {
        return
    }
    s(i, wlbase.D_VAL, v)
    dirty_wd(i)
}

fn text_of(i: u64) -> u64 {
    return g(i, wlbase.D_TEXT)
}

fn set_text(i: u64, p: u64) {
    s(i, wlbase.D_TEXT, p)
    if g(i, wlbase.D_KIND) == wlbase.K_LIST || g(i, wlbase.D_KIND) == wlbase.K_TABLE {
        count_rows(i)
        if g(i, wlbase.D_VAL) >= g(i, wlbase.D_A) {
            s(i, wlbase.D_VAL, 0)
        }
        s(i, wlbase.D_B, 0)
    }
    if g(i, wlbase.D_KIND) == wlbase.K_ENTRY {
        s(i, wlbase.D_B, tlen(p))
        s(i, wlbase.D_C, g(i, wlbase.D_B))
    }
    dirty_wd(i)
}

fn set_rows(i: u64, n: u64) {
    s(i, wlbase.D_A, n)
}

fn set_cols(i: u64, n: u64, breiten: u64) {
    s(i, wlbase.D_C, n)
    s(i, wlbase.D_D, breiten)
}

fn primary(i: u64, on: bool) {
    if on {
        s(i, wlbase.D_FLAGS, g(i, wlbase.D_FLAGS) | wlbase.F_MAIN)
    } else {
        s(i, wlbase.D_FLAGS, g(i, wlbase.D_FLAGS) & ~wlbase.F_MAIN)
    }
}

fn enable(i: u64, on: bool) {
    if on {
        s(i, wlbase.D_FLAGS, g(i, wlbase.D_FLAGS) & ~wlbase.F_OFF)
    } else {
        s(i, wlbase.D_FLAGS, g(i, wlbase.D_FLAGS) | wlbase.F_OFF)
    }
    dirty_wd(i)
}

fn show(i: u64, on: bool) {
    if i >= wlbase.nwd {
        return
    }
    if on {
        s(i, wlbase.D_FLAGS, g(i, wlbase.D_FLAGS) & ~wlbase.F_HIDE)
    } else {
        s(i, wlbase.D_FLAGS, g(i, wlbase.D_FLAGS) | wlbase.F_HIDE)
    }
}

fn shown(i: u64) -> bool {
    if i >= wlbase.nwd {
        return false
    }
    return (g(i, wlbase.D_FLAGS) & wlbase.F_HIDE) == 0
}

fn focus_id() -> u64 {
    if wlbase.s_focus == 0 {
        return wlbase.MAXWD
    }
    return wlbase.s_focus - 1
}

fn set_focus(i: u64) {
    if wlbase.s_focus != 0 {
        dirty_wd(wlbase.s_focus - 1)
    }
    wlbase.s_focus = i + 1
    dirty_wd(i)
    blink_reset()

    if wlbase.s_trace != 0 {
        var s_f: [u8; 16] = "wlib: focus id=\0"
        var s_k: [u8; 8] = " kind=\0\0"
        wlbase.tl_at = 0
        tl_s((&s_f[0 as usize]) as u64)
        tl_n(i)
        tl_s((&s_k[0 as usize]) as u64)
        tl_n(g(i, wlbase.D_KIND))
        say_pid()
        tl_end()
    }
}

fn fired_kind() -> u64 {
    return wlbase.s_fkind
}

fn fired_index() -> u64 {
    return wlbase.s_findex
}

fn fired_win() -> u64 {
    return wlbase.s_fwin
}

fn count_rows(i: u64) {
    let p: u64 = g(i, wlbase.D_TEXT)
    if p == 0 {
        s(i, wlbase.D_A, 0)
        return
    }
    var n: u64 = 0
    var k: u64 = 0
    var char: u64 = 0
    while (*((p + k) as *mut u8)) != 0 as u8 {
        if (*((p + k) as *mut u8)) == 10 as u8 {
            n = n + 1
            char = 0
        } else {
            char = char + 1
        }
        k = k + 1
    }
    if char > 0 {
        n = n + 1
    }
    s(i, wlbase.D_A, n)
}

fn row_at(p: u64, r: u64) -> u64 {
    if p == 0 {
        return 0
    }
    var k: u64 = 0
    var n: u64 = 0
    while n < r {
        if (*((p + k) as *mut u8)) == 0 as u8 {
            return 0
        }
        if (*((p + k) as *mut u8)) == 10 as u8 {
            n = n + 1
        }
        k = k + 1
    }
    if (*((p + k) as *mut u8)) == 0 as u8 {
        return 0
    }
    return p + k
}

fn row_len(q: u64) -> u64 {
    var n: u64 = 0
    while (*((q + n) as *mut u8)) != 0 as u8 {
        if (*((q + n) as *mut u8)) == 10 as u8 {
            return n
        }
        n = n + 1
    }
    return n
}

fn col_at(q: u64, ende: u64, c: u64) -> u64 {
    var k: u64 = 0
    var n: u64 = 0
    while n < c {
        if k >= ende {
            return 0
        }
        if (*((q + k) as *mut u8)) == 9 as u8 {
            n = n + 1
        }
        k = k + 1
    }
    if k > ende {
        return 0
    }
    return q + k
}

fn col_len(q: u64, rest: u64) -> u64 {
    var n: u64 = 0
    while n < rest {
        if (*((q + n) as *mut u8)) == 9 as u8 {
            return n
        }
        n = n + 1
    }
    return rest
}

fn lines_height() -> u64 {
    return uitheme.metric(uitheme.M_ROW)
}

fn ctrl_small() -> u64 {
    let h: u64 = uitheme.metric(uitheme.M_CTRL_H)
    if h < 8 {
        return h
    }
    return h - 4
}

fn ctrl_thin() -> u64 {
    let h: u64 = uitheme.metric(uitheme.M_CTRL_H)
    if h < 6 {
        return h
    }
    return h - 2
}

fn inset() -> u64 {
    return uitheme.metric(uitheme.M_PAD_X) / 2
}

fn inset_text() -> u64 {
    let i: u64 = inset()
    if i == 0 {
        return 0
    }
    return i - 1
}

fn scroll_w() -> u64 {
    let r: u64 = uitheme.metric(uitheme.M_ROW)
    if r < 10 {
        return r
    }
    return r - 6
}

fn thumb_w() -> u64 {
    return sub(scroll_w(), 4)
}

fn tile_w() -> u64 {
    return sub(ctrl_small(), 8)
}

fn dlg_btn_w() -> u64 {
    return uitheme.metric(uitheme.M_CTRL_H) * 3 + uitheme.metric(uitheme.M_GAP) * 2
}

fn sep_h() -> u64 {
    return uitheme.metric(uitheme.M_PAD_Y) + 1
}

fn paint_bg(w: u64, x: u64, y: u64, bw: u64, bh: u64) {
    var c: u64 = wlibc.theme(wlibc.T_BG)
    if ng(w, wlbase.N_KIND) == wlbase.NK_DLG {
        c = wlibc.theme(wlibc.T_DLG)
    }
    if ng(w, wlbase.N_KIND) == wlbase.NK_MENU {
        c = wlibc.theme(wlibc.T_MENU)
    }
    if ng(w, wlbase.N_KIND) == wlbase.NK_TIP || ng(w, wlbase.N_KIND) == NK_TOAST {
        c = wlibc.theme(wlibc.T_MENU)
    }
    fuib.rect(x, y, bw, bh, c)
}

fn put_text(f: u64, pxs: u64, x: u64, y: u64, bw: u64, p: u64, n: u64,
    color: u64, aus: u64) -> u64 {
    if p == 0 || n == 0 {
        s_tx = x
        return x
    }
    var tx: u64 = x
    if aus != 0 {
        let tw: u64 = uitext.text_w(f, pxs, p, n)
        if aus == 1 {
            tx = x + sub(bw, tw) / 2
        } else {
            tx = x + sub(bw, tw)
        }
    }
    s_tx = tx
    return wlibc.text_at(f, pxs, tx, y, p, n, color)
}

fn trace() -> bool {
    return wlbase.s_trace != 0
}

fn set_menu_title(p: u64) {
    wlbase.mn_title = p
}

fn set_trace(on: bool) {
    if on {
        wlbase.s_trace = 1
    } else {
        wlbase.s_trace = 0
    }
}

fn say_painted(w: u64, kind: u64, base: u64, fg: u64, bg: u64, p: u64,
    n: u64) {
    say_painted_n(w, kind, base, fg, bg, p, n, n, n)
}

fn say_painted_n(w: u64, kind: u64, base: u64, fg: u64, bg: u64, p: u64,
    n: u64, nq: u64, nv: u64) {
    say_painted_g(w, kind, base, fg, bg, p, n, nq, nv, uiscale.px_ui(), false)
}

fn say_painted_g(w: u64, kind: u64, base: u64, fg: u64, bg: u64, p: u64,
    n: u64, nq: u64, nv: u64, px: u64, two: bool) {
    if wlbase.s_trace == 0 || p == 0 || n == 0 {
        return
    }

    let b: u64 = (&wlbase.tr_buf[0 as usize]) as u64
    var at: u64 = 0
    if two {
        at = tr_put(b, 0, (&tr_a2[0 as usize]) as u64)
    } else {
        at = tr_put(b, 0, (&tr_a[0 as usize]) as u64)
    }
    at = tr_num(b, at, ng(w, wlbase.N_H))
    at = tr_put(b, at, (&tr_k[0 as usize]) as u64)
    at = tr_num(b, at, kind)
    at = tr_put(b, at, (&tr_x[0 as usize]) as u64)
    at = tr_num(b, at, s_tx)
    at = tr_put(b, at, (&tr_b[0 as usize]) as u64)
    at = tr_num(b, at, base)
    at = tr_put(b, at, (&tr_f[0 as usize]) as u64)
    at = tr_num(b, at, fg)
    at = tr_put(b, at, (&tr_g[0 as usize]) as u64)
    at = tr_num(b, at, bg)
    at = tr_put(b, at, (&tr_w[0 as usize]) as u64)
    at = tr_num(b, at, uitext.text_w(uitext.F_UI, px, p, n))
    at = tr_put(b, at, (&tr_ax[0 as usize]) as u64)
    at = tr_num(b, at, org_x(w))
    at = tr_put(b, at, (&tr_ay[0 as usize]) as u64)
    at = tr_num(b, at, org_y(w))
    at = tr_put(b, at, (&wlbase.tr_q[0 as usize]) as u64)
    at = tr_num(b, at, nq)
    at = tr_put(b, at, (&wlbase.tr_v[0 as usize]) as u64)
    at = tr_num(b, at, nv)
    if two {
        at = tr_put(b, at, (&tr_px[0 as usize]) as u64)
        at = tr_num(b, at, px)
    }
    at = tr_put(b, at, (&wlbase.tr_t[0 as usize]) as u64)
    var i: u64 = 0
    while i < n && at + 2 < 320 {
        __mmio_write8((b + at) as *mut u8,
            __mmio_read8((p + i) as *mut u8))
        at = at + 1
        i = i + 1
    }
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = lineout.add_bytes(b, at)
}

fn tr_put(b: u64, at: u64, p: u64) -> u64 {
    var i: u64 = 0
    var a: u64 = at
    while __mmio_read8((p + i) as *mut u8) != 0 as u8 && a + 2 < 320 {
        __mmio_write8((b + a) as *mut u8,
            __mmio_read8((p + i) as *mut u8))
        a = a + 1
        i = i + 1
    }
    return a
}

fn tr_num(b: u64, at: u64, v: u64) -> u64 {
    var d: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var q: u64 = v
    if q == 0 {
        __mmio_write8(((&d[0 as usize]) as u64) as *mut u8, 48 as u8)
        n = 1
    }
    while q > 0 && n < 24 {
        __mmio_write8((((&d[0 as usize]) as u64) + n) as *mut u8,
            (48 + q % 10) as u8)
        q = q / 10
        n = n + 1
    }
    var a: u64 = at
    var i: u64 = n
    while i > 0 && a + 2 < 320 {
        i = i - 1
        __mmio_write8((b + a) as *mut u8,
            __mmio_read8((((&d[0 as usize]) as u64) + i) as *mut u8))
        a = a + 1
    }
    return a
}

fn fui_state(i: u64) -> u64 {
    let fl: u64 = g(i, wlbase.D_FLAGS)
    if (fl & wlbase.F_OFF) != 0 {
        return fuib.Z_OFF
    }
    if (fl & wlbase.F_PRESSED) != 0 {
        return fuib.Z_PRESSED
    }
    if (fl & wlbase.F_HOVER) != 0 {
        return fuib.Z_HOVER
    }
    return fuib.Z_NORMAL
}

fn label_h_at(i: u64, bw: u64) -> u64 {
    let zh: u64 = uitext.text_h(uiscale.px_ui())
    let q: u64 = g(i, wlbase.D_TEXT)
    let n: u64 = tlen(q)
    if n == 0 || bw == 0
        || uitext.text_w(uitext.F_UI, uiscale.px_ui(), q, n) <= bw {
        return zh
    }
    return zh * 2
}

fn bg_of(w: u64) -> u64 {
    if ng(w, wlbase.N_KIND) == wlbase.NK_DLG {
        return wlibc.theme(wlibc.T_DLG)
    }
    if ng(w, wlbase.N_KIND) == wlbase.NK_MENU || ng(w, wlbase.N_KIND) == wlbase.NK_TIP
        || ng(w, wlbase.N_KIND) == NK_TOAST {
        return wlibc.theme(wlibc.T_MENU)
    }
    return wlibc.theme(wlibc.T_BG)
}

fn slider_bahn(i: u64) -> u64 {
    let txt: u64 = g(i, wlbase.D_TEXT)
    var lx: u64 = g(i, wlbase.D_X)
    if txt != 0 && tlen(txt) > 0 {
        lx = lx + uitext.text_w(uitext.F_UI, uiscale.px_ui(), txt,
            tlen(txt)) + 8
    }
    return lx
}

fn slider_rw(i: u64) -> u64 {
    let x: u64 = g(i, wlbase.D_X)
    let bw: u64 = g(i, wlbase.D_W)
    let lx: u64 = slider_bahn(i)
    let zw: u64 = 34
    if bw > (lx -% x) + zw + 8 {
        return bw -% (lx -% x) -% zw -% 8
    }
    return 0
}

static mut secret_buf: [u8; 385] = [0 as u8; 385]

fn show_text(i: u64) -> u64 {
    let p: u64 = g(i, wlbase.D_TEXT)
    if (g(i, wlbase.D_FLAGS) & wlbase.F_SECRET) == 0 {
        return p
    }

    let k: u64 = fuib.secret_mask(p, tlen(p), (&secret_buf[(0) as usize]) as u64, 384)
    secret_buf[(k) as usize] = 0 as u8
    return (&secret_buf[(0) as usize]) as u64
}

fn show_at(i: u64, at: u64) -> u64 {
    if (g(i, wlbase.D_FLAGS) & wlbase.F_SECRET) == 0 {
        return at
    }
    var tmp: [u8; 384] = [0 as u8; 384]
    return fuib.secret_mask(g(i, wlbase.D_TEXT), at, (&tmp[0 as usize]) as u64, 384)
}

fn entry_x(i: u64, at: u64) -> u64 {
    return g(i, wlbase.D_X) + inset_text() + uitext.text_w(uitext.F_UI,
        uiscale.px_ui(), show_text(i), show_at(i, at))
}

fn entry_secret(i: u64, an: bool) {
    if i >= wlbase.MAXWD {
        return
    }
    if an {
        s(i, wlbase.D_FLAGS, g(i, wlbase.D_FLAGS) | wlbase.F_SECRET)
    } else {
        s(i, wlbase.D_FLAGS, g(i, wlbase.D_FLAGS) & ~wlbase.F_SECRET)
    }
}

fn password_shown(i: u64) -> bool {
    if i >= wlbase.nwd {
        return false
    }
    return (g(i, wlbase.D_FLAGS) & wlbase.F_SECRET) == 0
}
