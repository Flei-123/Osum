fn win_handle(w: u64) -> u64 {
    return wlstate.ng(w, wlbase.N_H)
}

fn ax_flushes() -> u64 {
    return wlbase.ax_nflush
}

fn ax_last() -> u64 {
    return wlbase.ax_n
}

fn ax_presses() -> u64 {
    return wlbase.ax_npress
}

fn ax_keep_title(w: u64, t: u64) {
    if w >= wlbase.MAXWN {
        return
    }
    let d: u64 = (&wlbase.ax_wtitle[0 as usize]) as u64 + w * 40
    var k: u64 = 0
    while k < 39 {
        var c: u8 = 0 as u8
        if t != 0 {
            c = *((t + k) as *mut u8)
        }
        *((d + k) as *mut u8) = c
        if c == 0 as u8 {
            k = 39
        } else {
            k = k + 1
        }
    }
    *((d + 39) as *mut u8) = 0 as u8
}
