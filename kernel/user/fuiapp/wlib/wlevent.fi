fn window(x: u64, y: u64, w: u64, h: u64, title: u64) -> u64 {
    let k: u64 = wlibc.ui_scale()
    var bw: u64 = w * k
    var bh: u64 = h * k
    let sw: u64 = wlibc.screen_w()
    let sh: u64 = wlibc.screen_h()
    var bx: u64 = x * k
    var by: u64 = y * k
    if sw != 0 && sh != 0 {
        if bw > sw {
            bw = sw
        }
        if bh > sh {
            bh = sh
        }
        if bx + bw > sw {
            bx = wlstate.sub(sw, bw)
        }
        if by + bh > sh {
            by = wlstate.sub(sh, bh)
        }
    }
    return new_win(bx, by, bw, bh, title, wlbase.NK_MAIN)
}

fn window_opts(x: u64, y: u64, w: u64, h: u64, title: u64, frameless: bool, keys: bool, opac: u64) -> u64 {
    s_win_opts = wlibc.win_opts(frameless, keys, opac)
    let i: u64 = new_win(x, y, w, h, title, wlbase.NK_MAIN)
    s_win_opts = 0
    return i
}

fn window_float(x: u64, y: u64, w: u64, h: u64, title: u64, opac: u64) -> u64 {
    s_win_opts = wlibc.win_opts(true, true, opac)
    let i: u64 = new_win(x, y, w, h, title, wlbase.NK_MAIN)
    s_win_opts = 0
    if i >= wlbase.MAXWN {
        return wlbase.MAXWN
    }
    if ulib.bad(wlibc.win_state(wlstate.ng(i, wlbase.N_H), wlibc.WS_LAYER, wlibc.L_FLOAT)) {
        wlstate.close(i)
        return wlbase.MAXWN
    }
    wlstate.say_window(i)
    return i
}

fn window_plain(x: u64, y: u64, w: u64, h: u64, title: u64,
    ebene: u64) -> u64 {
    s_plain_open = 1
    let i: u64 = new_win(x, y, w, h, title, wlbase.NK_MAIN)
    s_plain_open = 0
    if i >= wlbase.MAXWN {
        return wlbase.MAXWN
    }
    let hh: u64 = wlstate.ng(i, wlbase.N_H)
    if ulib.bad(wlibc.win_state(hh, wlibc.WS_DECO, 0)) {
        wlstate.close(i)
        return wlbase.MAXWN
    }
    if ebene != wlibc.L_NORMAL {
        if ulib.bad(wlibc.win_state(hh, wlibc.WS_LAYER, ebene)) {
            wlstate.close(i)
            return wlbase.MAXWN
        }
    }
    wlstate.say_window(i)
    return i
}

static mut s_win_opts: u64 = 0

static mut s_plain_open: u64 = 0

fn new_win(x: u64, y: u64, w: u64, h: u64, title: u64, kind: u64) -> u64 {
    if wlbase.nwn >= wlbase.MAXWN {
        return wlbase.MAXWN
    }
    var shp: u64 = 0
    var shb: u64 = 0
    var shfd1: u64 = 0
    if wlbase.s_want_shared != 0 && w >= 32 && h >= 16 {
        shb = w * h * 4
        shp = wlibc.shm_buffer(shb)
        if shp != 0 {
            shfd1 = wlibc.shm_last_fd() + 1
        }
    }
    let hh: u64 = wlibc.sys5(wlibc.WM_CREATE, (x << 16) | y, (w << 16) | h,
        title, s_win_opts, shfd1)

    if shfd1 != 0 {
        wlibc.shm_close(shfd1 - 1)
    }
    if ulib.bad(hh) || hh == 0 {
        if shp != 0 {
            wlibc.shm_unmap(shp, shb)
        }
        return wlbase.MAXWN
    }
    if shp != 0 && !wlibc.win_shared(hh) {

        wlibc.shm_unmap(shp, shb)
        shp = 0
        shb = 0
    }
    let i: u64 = wlbase.nwn
    wlbase.nwn = wlbase.nwn + 1
    wlstate.ns(i, wlbase.N_SHP, shp)
    wlstate.ns(i, wlbase.N_SHB, shb)
    wlstate.ns(i, wlbase.N_H, hh)
    wlstate.ns(i, wlbase.N_W, w)
    wlstate.ns(i, wlbase.N_HH, h)
    wlstate.ns(i, wlbase.N_KIND, kind)
    wlstate.ns(i, wlbase.N_VAL, 0)
    wlstate.ns(i, wlbase.N_DATA, 0)
    wlstate.ns(i, wlbase.N_CNT, 0)
    wlstate.ns(i, wlbase.N_OWNER, 0)
    wlstate.ns(i, wlbase.N_X, x)
    wlstate.ns(i, wlbase.N_Y, y)
    ax_keep_title(i, title)
    wlbase.wncur = i
    wlstate.dirty_all(i)
    if s_plain_open == 0 {
        wlstate.say_window(i)
    }
    return i
}

fn paint_list(i: u64) {
    let x: u64 = wlstate.g(i, wlbase.D_X)
    let y: u64 = wlstate.g(i, wlbase.D_Y)
    let bw: u64 = wlstate.g(i, wlbase.D_W)
    let bh: u64 = wlstate.g(i, wlbase.D_H)
    let zh: u64 = row_h_of(i)
    let sicht: u64 = wlstate.sub(bh, 4) / zh
    fuib.rframe(x, y, bw, bh, wlwidget.typ_radius(wlbase.RT_LIST, wlbase.MR_FIELD, bw, bh),
        wlibc.metric(wlibc.M_BORDER), wlibc.theme(wlibc.T_LINE),
        wlibc.theme(wlibc.T_ENTRY))
    let int: u64 = wlstate.g(i, wlbase.D_A)
    var r: u64 = 0
    while r < sicht {
        let z: u64 = wlstate.g(i, wlbase.D_B) + r
        if z < int {
            let q: u64 = wlstate.row_at(wlstate.g(i, wlbase.D_TEXT), z)
            let ln: u64 = wlstate.row_len(q)
            let ry: u64 = y + 2 + r * zh
            var color: u64 = wlibc.theme(wlibc.T_FG)
            if z == wlstate.g(i, wlbase.D_VAL) || wlwidget.sel_hat(i, z) {
                let _fb10: bool = fuib.area(x + 1, ry, wlstate.sub(bw, 16), zh,
                    wlibc.theme(wlibc.T_SEL))
                color = wlibc.theme_selfg()
            }

            let sym: u64 = wlwidget.icon_at_row(i, z)
            if sym != 0 {
                let ih: u64 = wlibc.icon_small()
                var oy: u64 = 2
                if zh > ih {
                    oy = (zh - ih) / 2
                }
                let _ = wlibc.icon_at(sym, icon_x(i), ry + oy,
                    ih, color)
            }
            let ein: u64 = wlwidget.list_in(i)
            if ein != 0 && sym == 0 && wlstate.g(i, wlbase.D_D) != 0 {
                let f: u64 = __mmio_read64((wlstate.g(i, wlbase.D_D) + z * 8) as *mut u64)
                if wlwidget.is_image(f) {
                    let bw3: u64 = wlibc.icon_w(f)
                    let bh3: u64 = wlibc.icon_h(f)
                    if bw3 != 0 && bh3 != 0 {
                        let tw3: u64 = wlstate.tile_w()
                        var sc3: u64 = tw3 / bw3
                        let sy3: u64 = tw3 / bh3
                        if sy3 < sc3 {
                            sc3 = sy3
                        }
                        if sc3 == 0 {
                            sc3 = 1
                        }
                        let dw3: u64 = bw3 * sc3
                        let dh3: u64 = bh3 * sc3
                        var ox3: u64 = 0
                        if tw3 > dw3 {
                            ox3 = (tw3 - dw3) / 2
                        }
                        var oy3: u64 = 0
                        if tw3 > dh3 {
                            oy3 = (tw3 - dh3) / 2
                        }

                        var top3: u64 = 3 + oy3
                        if zh > wlstate.lines_height() {
                            top3 = tile_top(zh, dh3)
                        }
                        let _b3: bool = wlibc.icon_draw_sc(f,
                            x + 5 + ox3, ry + top3, sc3)
                    }
                } else {
                let rp: u64 = wlwidget.draw_radius(wlbase.MR_FIELD)
                let ty: u64 = ry + tile_top(zh, wlstate.tile_w())
                fuib.rrect(x + 5, ty, wlstate.tile_w(), wlstate.tile_w(), rp, f)
                fuib.rframe(x + 5, ty, wlstate.tile_w(), wlstate.tile_w(), rp,
                    wlibc.metric(wlibc.M_BORDER),
                    wlibc.theme(wlibc.T_LINE), f)
                if ln > 0 {
                    let bw2: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(),
                        q, 1)
                    wlibc.text_at(wlibc.F_UI, wlibc.px_ui(),
                        x + 5 + wlstate.sub(14, bw2) / 2, ty + 12, q, 1,
                        wlibc.theme_on(f))
                }
                }
            }
            var n1: u64 = ln
            var p2: u64 = 0
            var n2: u64 = 0
            if wlstate.g(i, wlbase.D_SECOND) != 0 {
                var t: u64 = 0
                while t < ln {
                    if (*((q + t) as *mut u8)) == 9 as u8 {
                        n1 = t
                        p2 = q + t + 1
                        n2 = wlstate.sub(ln, t + 1)
                        t = ln
                    } else {
                        t = t + 1
                    }
                }
            }
            let free: u64 = wlstate.sub(bw, 21 + 6 + ein)
            var qq: u64 = q
            var qn: u64 = n1
            let el: u64 = wlwidget.elide(wlibc.F_UI, wlibc.px_ui(), q, n1, free)
            if el != 0 {
                qq = (&wlbase.el_buf[0 as usize]) as u64
                qn = el
            }
            var rgrund: u64 = base_in_row(ry, zh)
            if n2 != 0 || wlstate.g(i, wlbase.D_SECOND) != 0 {
                rgrund = base_in_row(ry, zh / 2)
            }
            var f1: u64 = wlibc.F_UI
            if n2 != 0 {
                f1 = wlibc.F_BOLD
            }
            let _rt: u64 = wlstate.put_text(f1, wlibc.px_ui(),
                x + 6 + ein, rgrund, wlstate.sub(bw, 16), qq, qn, color, 0)
            if n2 != 0 {
                var f2: u64 = wlibc.theme(wlibc.T_DIM)
                if z == wlstate.g(i, wlbase.D_VAL) || wlwidget.sel_hat(i, z) {
                    f2 = color
                }
                let px2: u64 = wlibc.type_px(wlibc.TY_CAPTION)
                var q2: u64 = p2
                var n2s: u64 = n2
                let e2: u64 = wlwidget.elide(wlibc.F_UI, px2, p2, n2,
                    free)
                if e2 != 0 {
                    q2 = (&wlbase.el_buf[0 as usize]) as u64
                    n2s = e2
                }
                let b2: u64 = base_in_row(ry + zh / 2, zh / 2)
                let _r2: u64 = wlstate.put_text(wlibc.F_UI, px2,
                    x + 6 + ein, b2, wlstate.sub(bw, 16), q2, n2s, f2, 0)
                var hg2: u64 = wlibc.theme(wlibc.T_ENTRY)
                if z == wlstate.g(i, wlbase.D_VAL) || wlwidget.sel_hat(i, z) {
                    hg2 = wlibc.theme(wlibc.T_SEL)
                }
                wlstate.say_painted_g(wlstate.g(i, wlbase.D_WIN), wlbase.K_LIST, b2, f2, hg2, q2, n2s,
                    n2s, n2, px2, true)
            }
            var rhg: u64 = wlibc.theme(wlibc.T_ENTRY)
            if z == wlstate.g(i, wlbase.D_VAL) || wlwidget.sel_hat(i, z) {
                rhg = wlibc.theme(wlibc.T_SEL)
            }
            wlstate.say_painted(wlstate.g(i, wlbase.D_WIN), wlbase.K_LIST, rgrund, color, rhg, qq, qn)
        }
        r = r + 1
    }
    wlwidget.paint_scroll(x + bw - 15, y + 1, wlstate.sub(bh, 2), wlstate.g(i, wlbase.D_B), sicht, int)
    wlwidget.focus_ring(i)
}

fn paint_table(i: u64) {
    let x: u64 = wlstate.g(i, wlbase.D_X)
    let y: u64 = wlstate.g(i, wlbase.D_Y)
    let bw: u64 = wlstate.g(i, wlbase.D_W)
    let bh: u64 = wlstate.g(i, wlbase.D_H)
    let zh: u64 = wlstate.lines_height()
    let head: u64 = zh + 4
    let sicht: u64 = wlstate.sub(wlstate.sub(bh, 4), head) / zh
    let cols: u64 = wlstate.g(i, wlbase.D_C)
    let _fb11: bool = fuib.board(x, y, bw, bh,
        wlwidget.typ_radius(wlbase.RT_TABLE, wlbase.MR_FIELD, bw, bh),
        wlibc.theme(wlibc.T_ENTRY), 0, 0)
    let _fb12: bool = fuib.area(x + 1, y + 1, wlstate.sub(bw, 2), head,
        wlibc.theme(wlibc.T_HEAD))
    let kq: u64 = wlstate.row_at(wlstate.g(i, wlbase.D_TEXT), 0)
    let kl: u64 = wlstate.row_len(kq)
    var cx: u64 = x + 6
    var c: u64 = 0
    while c < cols {
        let q: u64 = wlstate.col_at(kq, kl, c)
        if q != 0 {
            let ln: u64 = wlstate.col_len(q, wlstate.sub(kl, wlstate.sub(q, kq)))

            var hx: u64 = cx
            if c == 0 {
                hx = cx + wlwidget.table_in(i)
            }
            let kgrund: u64 = y + 3 + wlibc.ascent_of(wlibc.F_UI,
                wlibc.px_ui())
            let _kt: u64 = wlstate.put_text(wlibc.F_UI, wlibc.px_ui(), hx, kgrund,
                wlwidget.column_wide(i, c), q, ln, wlibc.theme(wlibc.T_FG), 0)
            wlstate.say_painted(wlstate.g(i, wlbase.D_WIN), wlbase.K_TABLE, kgrund,
                wlibc.theme(wlibc.T_FG), wlibc.theme(wlibc.T_HEAD),
                q, ln)
        }
        cx = cx + wlwidget.column_wide(i, c)
        if c + 1 < cols {
            fuib.vline(cx - 4, y + 1, head, wlibc.theme(wlibc.T_LINE))
        }
        c = c + 1
    }
    fuib.hline(x + 1, y + head, wlstate.sub(bw, 2), wlibc.theme(wlibc.T_LINE))
    let int: u64 = wlstate.sub(wlstate.g(i, wlbase.D_A), 1)
    var r: u64 = 0
    while r < sicht {
        let z: u64 = wlstate.g(i, wlbase.D_B) + r
        if z < int {
            let q: u64 = wlstate.row_at(wlstate.g(i, wlbase.D_TEXT), z + 1)
            let ln: u64 = wlstate.row_len(q)
            let ry: u64 = y + head + 1 + r * zh
            var color: u64 = wlibc.theme(wlibc.T_FG)
            if z == wlstate.g(i, wlbase.D_VAL) || wlwidget.sel_hat(i, z) {
                let _fb13: bool = fuib.area(x + 1, ry, wlstate.sub(bw, 16), zh,
                    wlibc.theme(wlibc.T_SEL))
                color = wlibc.theme_selfg()
            }
            var tx: u64 = x + 6

            let einr: u64 = wlwidget.table_in(i)
            let sym: u64 = wlwidget.icon_at_row(i, z)
            if sym != 0 {
                let ih2: u64 = wlibc.icon_small()
                var oy2: u64 = 2
                if zh > ih2 {
                    oy2 = (zh - ih2) / 2
                }
                let _ = wlibc.icon_at(sym, tx, ry + oy2, ih2, color)
            }
            c = 0
            while c < cols {
                let cq: u64 = wlstate.col_at(q, ln, c)
                if cq != 0 {
                    var cl: u64 = wlstate.col_len(cq, wlstate.sub(ln, wlstate.sub(cq, q)))
                    let space: u64 = wlstate.sub(wlwidget.column_wide(i, c), 6)
                    cl = wlibc.fit(wlibc.F_UI, wlibc.px_ui(), cq, cl, space)
                    var f2: u64 = color
                    if c > 0 && z != wlstate.g(i, wlbase.D_VAL) {
                        f2 = wlibc.theme(wlibc.T_DIM)
                    }
                    var txx: u64 = tx
                    if c == 0 {
                        txx = tx + einr
                    }
                    wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), txx,
                        base_in_row(ry, zh), cq, cl, f2)
                }
                tx = tx + wlwidget.column_wide(i, c)
                c = c + 1
            }
        }
        r = r + 1
    }
    fuib.frame(x, y, bw, bh, wlibc.theme(wlibc.T_LINE))
    wlwidget.paint_scroll(x + bw - 15, y + head + 1, wlstate.sub(wlstate.sub(bh, head), 2),
        wlstate.g(i, wlbase.D_B), sicht, int)
    wlwidget.focus_ring(i)
}

fn paint_one(i: u64) {
    let k: u64 = wlstate.g(i, wlbase.D_KIND)
    if (wlstate.g(i, wlbase.D_FLAGS) & wlbase.F_HIDE) != 0 {
        return
    }
    if k == wlbase.K_IMAGE {
        wlwidget.paint_image(i)
    } else if k == wlbase.K_SLIDER {
        wldraw.paint_slider(i)
    } else if k == wlbase.K_LABEL {
        wlwidget.paint_label(i)
    } else if k == wlbase.K_BUTTON {
        wlwidget.paint_button(i)
    } else if k == wlbase.K_CHECK {
        wldraw.paint_check(i)
    } else if k == wlbase.K_ENTRY {
        wldraw.paint_entry(i)
    } else if k == wlbase.K_LIST {
        paint_list(i)
    } else if k == wlbase.K_TABLE {
        paint_table(i)
    } else if k == wlbase.K_TABS {
        wldraw.paint_tabs(i)
    } else if k == wlbase.K_MENUBAR {
        wldraw.paint_menubar(i)
    } else if k == wlbase.K_CHOICE {
        wldraw.paint_choice(i)
    } else if k == wlbase.K_SEP {
        wlwidget.paint_sep(i)
    } else if k == wlbase.K_CARD {
        wlwidget.paint_card(i)
    } else if k == wlbase.K_SCROLL {
        wlwidget.paint_scroll(wlstate.g(i, wlbase.D_X), wlstate.g(i, wlbase.D_Y), wlstate.g(i, wlbase.D_H), wlstate.g(i, wlbase.D_VAL),
            wlstate.g(i, wlbase.D_B), wlstate.g(i, wlbase.D_A))
    } else if k == wlbase.K_TILE {
        wlwidget.paint_tile(i)
    } else if k == wlbase.K_GRAPH {
        wlwidget.paint_graph(i)
    } else if k == wlbase.K_CANVAS {
        wlstate.paint_canvas(i)
    } else if k == wlbase.K_TEXTAREA {
        wldraw.paint_ta(i)
    }

    if wlbase.s_zugziel != 0 && wlbase.s_zugziel - 1 == i {
        let zx: u64 = wlstate.g(i, wlbase.D_X)
        let zy: u64 = wlstate.g(i, wlbase.D_Y)
        let zw: u64 = wlstate.g(i, wlbase.D_W)
        let zh2: u64 = wlstate.g(i, wlbase.D_H)
        let zf: u64 = wlibc.theme(wlibc.T_ACCENT)
        let _zr: bool = fuib.ring(zx, zy, zw, zh2, 0, 2, zf)
    }
}

fn tip_win_open(x: u64, y: u64, w: u64, h: u64, title: u64) -> u64 {
    let i: u64 = new_win(x, y, w, h, title, wlbase.NK_TIP)
    if i >= wlbase.MAXWN {
        return wlbase.MAXWN
    }
    let _d: u64 = wlibc.win_state(wlstate.ng(i, wlbase.N_H), wlibc.WS_DECO, 0)
    let _l: u64 = wlibc.win_state(wlstate.ng(i, wlbase.N_H), wlibc.WS_LAYER,
        wlibc.L_TIP)
    wlstate.dirty_all(i)
    return i
}

fn zug_auf(txt: u64, sx: u64, sy: u64) {
    if wlbase.s_zugwin != 0 {
        return
    }
    let bw: u64 = wlwidget.run_width(txt)
    let bh: u64 = wlstate.lines_height() + 8
    let i: u64 = tip_win_open(sx + 14, sy + 14, bw, bh, 0)
    if i >= wlbase.MAXWN {
        return
    }
    wlbase.s_zugwin = i + 1
    s_zugtext = txt
    s_zugw = bw
    s_zugh = bh
    wlbase.s_zugauf = wlbase.s_zugauf + 1
    wlstate.dirty_all(i)
    let _g: u64 = flush_win(i)
}

fn zug_zieh(sx: u64, sy: u64) {
    if wlbase.s_zugwin == 0 {
        return
    }
    let i: u64 = wlbase.s_zugwin - 1
    let _m: u64 = wlibc.win_move(wlstate.ng(i, wlbase.N_H), sx + 14, sy + 14)
    wlstate.ns(i, wlbase.N_X, sx + 14)
    wlstate.ns(i, wlbase.N_Y, sy + 14)
    wlstate.dirty_all(i)
    let _g: u64 = flush_win(i)
}

fn zug_zu() {
    if wlbase.s_zugwin == 0 {
        return
    }
    let i: u64 = wlbase.s_zugwin - 1
    wlbase.s_zugwin = 0
    s_zugtext = 0
    tip_win_close(i)
}

fn paint_zug(w: u64) {
    let bw: u64 = wlstate.ng(w, wlbase.N_W)
    let bh: u64 = wlstate.ng(w, wlbase.N_HH)
    let _f: bool = fuib.area(0, 0, bw, bh, wlibc.theme(wlibc.T_MENU))
    let _zr2: bool = fuib.ring(0, 0, bw, bh, 0, 1,
        wlibc.theme(wlibc.T_ACCENT))
    if s_zugtext != 0 {
        let _t: u64 = wlstate.put_text(wlibc.F_UI, wlibc.px_ui(), 10,
            base_in_row(0, bh), wlstate.sub(bw, 20), s_zugtext, wlstate.tlen(s_zugtext),
            wlibc.theme(wlibc.T_FG), 0)
    }
}

fn tip_win_close(i: u64) {
    if i >= wlbase.MAXWN {
        return
    }
    wlstate.close(i)
    if i + 1 == wlbase.nwn {
        wlbase.nwn = wlbase.nwn - 1
    }
}

fn tip_win_id(i: u64) -> u64 {
    return wlstate.ng(i, wlbase.N_H)
}

fn paint_menu(w: u64) {
    let zh: u64 = wlstate.lines_height() + 2
    let mr: u64 = wlibc.win_round(wlstate.ng(w, wlbase.N_W), wlstate.ng(w, wlbase.N_HH))
    if wlibc.aa_old() || wlstate.ng(w, wlbase.N_W) < 3 || wlstate.ng(w, wlbase.N_HH) < 3 {
        let _fb19: bool = fuib.area(0, 0, wlstate.ng(w, wlbase.N_W), wlstate.ng(w, wlbase.N_HH),
            wlibc.theme(wlibc.T_MENU))
    } else {
        let _fb21: bool = fuib.area(0, 0, wlstate.ng(w, wlbase.N_W), wlstate.ng(w, wlbase.N_HH),
            wlibc.theme(wlibc.T_ACCENT))
        var mi: u64 = 0
        if mr > 1 {
            mi = mr - 1
        }
        fuib.rrect(1, 1, wlstate.sub(wlstate.ng(w, wlbase.N_W), 2), wlstate.sub(wlstate.ng(w, wlbase.N_HH), 2), mi,
            wlibc.theme(wlibc.T_MENU))
    }
    var k: u64 = 0
    while k < wlstate.ng(w, wlbase.N_CNT) {
        let q: u64 = wlstate.row_at(wlstate.ng(w, wlbase.N_DATA), k)
        if q != 0 {
            let ry: u64 = 2 + k * zh
            var color: u64 = wlibc.theme(wlibc.T_FG)
            if k + 1 == wlstate.ng(w, wlbase.N_VAL) {
                let _fb20: bool = fuib.board(1, ry, wlstate.sub(wlstate.ng(w, wlbase.N_W), 2), zh,
                    wlwidget.typ_radius(wlbase.RT_MENU, wlbase.MR_FIELD, wlstate.sub(wlstate.ng(w, wlbase.N_W), 2), zh),
                    wlibc.theme(wlibc.T_SEL), 0, 0)
                color = wlibc.theme_selfg()
            }
            wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), 8,
                base_in_row(ry, zh), q, wlstate.row_len(q), color)
        }
        k = k + 1
    }
    if wlibc.aa_old() {
        fuib.frame(0, 0, wlstate.ng(w, wlbase.N_W), wlstate.ng(w, wlbase.N_HH), wlibc.theme(wlibc.T_ACCENT))
    }
}

fn flush_win(w: u64) -> u64 {
    if w >= wlbase.MAXWN || wlstate.ng(w, wlbase.N_H) == 0 {
        return 0
    }
    wlstate.win_place_get(w)
    let n: u64 = wlstate.ng(w, wlbase.N_NDIRT)
    wlstate.ns(w, wlbase.N_NDIRT, 0)
    var gemalt: u64 = 0
    var k: u64 = 0
    while k < n {
        gemalt = gemalt + flush_rect(w, wlstate.dg(w, k, 0), wlstate.dg(w, k, 1),
            wlstate.dg(w, k, 2), wlstate.dg(w, k, 3))
        k = k + 1
    }
    return gemalt
}

fn flush_rect(w: u64, x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    if x1 <= x0 || y1 <= y0 {
        return 0
    }

    if wlstate.ng(w, wlbase.N_SHP) != 0 && wlbase.s_zugziel == 0 && wlbase.s_zugwin == 0 && wlstate.ng(w, wlbase.N_KIND) != wlbase.NK_MENU {
        let r: u64 = wlibc.win_damage(wlstate.ng(w, wlbase.N_H), x0, y0, x1 - x0, y1 - y0)
        if !ulib.bad(r) {
            wlbase.s_blits = wlbase.s_blits + 1
            return (x1 - x0) * (y1 - y0)
        }

    }
    var gemalt: u64 = 0
    var yb: u64 = y0
    while yb < y1 {
        var ye: u64 = yb + wlibc.surf_rows()
        if ye > y1 {
            ye = y1
        }
        wlibc.set_band(yb)
        wlibc.clip_set(x0, yb, x1, ye)
        wlstate.paint_bg(w, x0, yb, x1 - x0, ye - yb)
        if wlstate.ng(w, wlbase.N_KIND) == wlbase.NK_MENU {
            paint_menu(w)
        } else if wlbase.s_zugwin != 0 && w + 1 == wlbase.s_zugwin {
            paint_zug(w)
        } else {
            var i: u64 = 0
            while i < wlbase.nwd {
                if wlstate.g(i, wlbase.D_WIN) == w {
                    if wlstate.g(i, wlbase.D_Y) < ye && wlstate.g(i, wlbase.D_Y) + wlstate.g(i, wlbase.D_H) > yb {
                        paint_one(i)
                    }
                }
                i = i + 1
            }
        }
        wlibc.push(wlstate.ng(w, wlbase.N_H), x0, yb, x1 - x0, ye - yb)
        wlbase.s_blits = wlbase.s_blits + 1
        gemalt = gemalt + (x1 - x0) * (ye - yb)
        yb = ye
    }
    return gemalt
}

fn draw_all() {
    var w: u64 = 0
    while w < wlbase.nwn {
        if wlstate.ng(w, wlbase.N_H) != 0 {
            wlstate.dirty_all(w)
        }
        w = w + 1
    }
    let _g: u64 = paint_all()
}

fn row_under(i: u64, y: u64) -> u64 {
    let zh: u64 = row_h_of(i)
    var top: u64 = wlstate.g(i, wlbase.D_Y) + 2
    if wlstate.g(i, wlbase.D_KIND) == wlbase.K_TABLE {
        top = wlstate.g(i, wlbase.D_Y) + zh + 5
    }
    if y < top {
        return wlbase.MAXWD
    }
    let r: u64 = (y - top) / zh + wlstate.g(i, wlbase.D_B)
    var int: u64 = wlstate.g(i, wlbase.D_A)
    if wlstate.g(i, wlbase.D_KIND) == wlbase.K_TABLE {
        int = wlstate.sub(int, 1)
    }
    if r >= int {
        return wlbase.MAXWD
    }
    return r
}

fn scroll_to(i: u64, z: u64) {
    let zh: u64 = row_h_of(i)
    var sicht: u64 = wlstate.sub(wlstate.g(i, wlbase.D_H), 4) / zh
    if wlstate.g(i, wlbase.D_KIND) == wlbase.K_TABLE {
        sicht = wlstate.sub(wlstate.sub(wlstate.g(i, wlbase.D_H), 4), zh + 4) / zh
    }
    if sicht == 0 {
        return
    }
    if z < wlstate.g(i, wlbase.D_B) {
        wlstate.s(i, wlbase.D_B, z)
    } else if z >= wlstate.g(i, wlbase.D_B) + sicht {
        wlstate.s(i, wlbase.D_B, z - sicht + 1)
    }
}

fn on_down(w: u64, x: u64, y: u64, btn: u64) {
    if wlstate.ng(w, wlbase.N_KIND) == wlbase.NK_MENU {

        if wlbase.s_nohit != 0 {
            return
        }
        let zh: u64 = wlstate.lines_height() + 2
        if y >= 2 {
            let k: u64 = (y - 2) / zh
            if k < wlstate.ng(w, wlbase.N_CNT) {
                wlstate.ns(w, wlbase.N_VAL, k + 1)
                wldraw.fire(wlstate.ng(w, wlbase.N_OWNER), wlbase.K_MENUBAR, k, w)
            }
        }
        return
    }
    let i: u64 = wlwidget.hit_at(w, x, y)
    if i >= wlbase.MAXWD {
        return
    }
    let k: u64 = wlstate.g(i, wlbase.D_KIND)
    if (wlstate.g(i, wlbase.D_FLAGS) & wlbase.F_FOCUSABLE) != 0 {
        wlstate.set_focus(i)
    }
    if k == wlbase.K_BUTTON {
        wlstate.s(i, wlbase.D_FLAGS, wlstate.g(i, wlbase.D_FLAGS) | wlbase.F_PRESSED)
        let _a3: u64 = wlwidget.anim_start(AN_PRESS, wlstate.g(i, wlbase.D_WIN), i,
            wlibc.MO_FAST, wlbase.EASE_OUT)
        wlbase.s_down = i + 1
        wlstate.dirty_wd(i)
        return
    }
    if k == wlbase.K_CANVAS {
        wlstate.lw_push(i, LE_DOWN, ((x - wlstate.g(i, wlbase.D_X)) << 16) | (y - wlstate.g(i, wlbase.D_Y)), btn)
        wlbase.s_down = i + 1
        return
    }
    if k == wlbase.K_SLIDER {
        wlstate.s(i, wlbase.D_FLAGS, wlstate.g(i, wlbase.D_FLAGS) | wlbase.F_PRESSED)
        wlbase.s_down = i + 1
        wlstate.slider_set(i, x)
        wldraw.fire(i, wlbase.K_SLIDER, wlstate.g(i, wlbase.D_VAL), w)
        return
    }
    if k == wlbase.K_IMAGE {
        wlbase.s_down = i + 1
        wlbase.s_dragx = x
        wlbase.s_dragy = y
        if wlstate.g(i, wlbase.D_WZ) == 1 {
            wlbase.s_aus_x0 = wlstate.image_px(i, x)
            wlbase.s_aus_y0 = wlstate.image_py(i, y)
            wlbase.s_aus_x1 = wlbase.s_aus_x0
            wlbase.s_aus_y1 = wlbase.s_aus_y0
            wlbase.s_aus_da = 1
            wlstate.dirty_wd(i)
        }
        return
    }

    if k == wlbase.K_TILE {
        wlstate.dirty_wd(i)
        wldraw.fire(i, wlbase.K_TILE, 0, w)
        return
    }
    if k == wlbase.K_CHECK {
        wlstate.s(i, wlbase.D_VAL, 1 - wlstate.g(i, wlbase.D_VAL))
        wlstate.dirty_wd(i)
        wldraw.fire(i, wlbase.K_CHECK, wlstate.g(i, wlbase.D_VAL), w)
        return
    }
    if k == wlbase.K_ENTRY && wlwidget.eye_hit(i, x) {

        wlwidget.password_show(i, !wlstate.password_shown(i))
        wlstate.blink_reset()
        return
    }
    if k == wlbase.K_ENTRY {
        wlstate.blink_reset()
        let p: u64 = wlstate.g(i, wlbase.D_TEXT)
        let n: u64 = wlstate.tlen(p)
        var at: u64 = 0
        while at < n && wlstate.entry_x(i, at + 1) <= x {
            at = at + 1
        }
        wlstate.s(i, wlbase.D_B, at)
        wlstate.s(i, wlbase.D_C, at)
        wlbase.s_down = i + 1
        wlstate.dirty_wd(i)
        return
    }

    if k == wlbase.K_TEXTAREA {
        let tt: u64 = wlstate.g(i, wlbase.D_VAL)
        if tt < wlbase.TA_MAX {
            if (btn & 8) == 0 {
                wldraw.ta_hit(i, x, y)
                wldraw.ta_sel_clear(tt)
            } else {
                wldraw.ta_hit(i, x, y)
            }
            wlbase.s_down = i + 1
            wlstate.set_focus(i)
            wlstate.dirty_wd(i)
        }
        return
    }
    if k == wlbase.K_LIST || k == wlbase.K_TABLE {

        if x >= wlstate.g(i, wlbase.D_X) + wlstate.g(i, wlbase.D_W) - 16 {
            let zh: u64 = row_h_of(i)
            var sicht: u64 = wlstate.sub(wlstate.g(i, wlbase.D_H), 4) / zh
            if k == wlbase.K_TABLE {
                sicht = wlstate.sub(wlstate.sub(wlstate.g(i, wlbase.D_H), 4), zh + 4) / zh
            }
            var int: u64 = wlstate.g(i, wlbase.D_A)
            if k == wlbase.K_TABLE {
                int = wlstate.sub(int, 1)
            }
            if int > sicht {
                let rel: u64 = wlstate.sub(y, wlstate.g(i, wlbase.D_Y))
                let z: u64 = rel * int / wlstate.g(i, wlbase.D_H)
                var top: u64 = z
                if top + sicht > int {
                    top = int - sicht
                }
                wlstate.s(i, wlbase.D_B, top)
                wlstate.dirty_wd(i)
            }
            return
        }
        if k == wlbase.K_TABLE && y < wlstate.g(i, wlbase.D_Y) + wlstate.lines_height() + 5 {
            var cx: u64 = wlstate.g(i, wlbase.D_X) + 2
            var c: u64 = 0
            while c < wlstate.g(i, wlbase.D_C) {
                if x >= cx && x < cx + wlwidget.column_wide(i, c) {
                    wldraw.fire(i, wlbase.K_TABLE, c, w)
                    wlstate.s(i, wlbase.D_C, wlstate.g(i, wlbase.D_C))
                    c = wlstate.g(i, wlbase.D_C)
                } else {
                    cx = cx + wlwidget.column_wide(i, c)
                    c = c + 1
                }
            }
            return
        }
        let r: u64 = row_under(i, y)
        if r < wlbase.MAXWD {
            let now: u64 = clockapi.ticks()
            var doppelt: bool = false
            if s_lastwd == i + 1 && s_lastclick != 0 {
                if now - s_lastclick < 100 && wlstate.g(i, wlbase.D_VAL) == r {
                    doppelt = true
                }
            }

            if wlstate.g(i, wlbase.D_SELP) != 0 && (btn & 2) == 0 {
                if (btn & 16) != 0 {
                    wlwidget.sel_set(i, r, !wlwidget.sel_hat(i, r))
                    wlwidget.sel_anker(i, r)
                } else if (btn & 8) != 0 {
                    wlwidget.sel_bereich(i, r)
                } else {
                    wlwidget.sel_clear(i)
                    wlwidget.sel_set(i, r, true)
                    wlwidget.sel_anker(i, r)
                }
            }
            wlstate.s(i, wlbase.D_VAL, r)
            s_lastclick = now
            s_lastwd = i + 1
            if wlstate.g(i, wlbase.D_SELP) != 0 && (btn & 2) == 0 {
                wlbase.s_down = i + 1
            }
            wlstate.dirty_wd(i)
            if doppelt || (wlstate.g(i, wlbase.D_FLAGS) & wlbase.F_EINKLICK) != 0 {
                wldraw.fire(i, wlbase.K_LIST, r, w)
                s_lastclick = 0
            } else if (btn & 2) != 0 {
                wldraw.fire(i, wlbase.K_SCROLL, r, w)
            }
        }
        return
    }
    if k == wlbase.K_TABS {
        let zh: u64 = wlwidget.tab_rowh(i)
        let n: u64 = wlwidget.tab_n(i)
        var t: u64 = 0
        while t < n {
            let tw: u64 = wlwidget.tab_width(i, t)
            let tx: u64 = wlwidget.tab_x(i, t)
            let ty: u64 = wlwidget.tab_y(i, t)
            if x >= tx && x < tx + tw && y >= ty && y < ty + zh {
                if wlstate.g(i, wlbase.D_VAL) != t {
                    wlstate.s(i, wlbase.D_VAL, t)
                    wlstate.dirty_wd(i)
                    wldraw.fire(i, wlbase.K_TABS, t, w)
                }
                t = n
            } else {
                t = t + 1
            }
        }
        return
    }
    if k == wlbase.K_MENUBAR {
        var tx: u64 = wlstate.g(i, wlbase.D_X) + 4
        var t: u64 = 0
        while t < 8 {
            let q: u64 = wlstate.row_at(wlstate.g(i, wlbase.D_TEXT), t)
            if q == 0 {
                t = 8
            } else {
                let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                    wlstate.row_len(q)) + 16
                if x >= tx && x < tx + tw {
                    wlstate.s(i, wlbase.D_VAL, t + 1)
                    wlstate.dirty_wd(i)
                    wldraw.fire(i, wlbase.K_MENUBAR, 0x1000 + t, w)
                    t = 8
                } else {
                    tx = tx + tw
                    t = t + 1
                }
            }
        }
        return
    }
    if k == wlbase.K_CHOICE {
        wldraw.fire(i, wlbase.K_CHOICE, 0x1000, w)
        return
    }
}

fn ta_key(i: u64, k: u64) {
    let t: u64 = wlstate.g(i, wlbase.D_VAL)
    if t >= wlbase.TA_MAX {
        return
    }
    let shift: bool = wldraw.key_shift()
    let ctrl: bool = wldraw.key_ctrl()
    let rows: u64 = wldraw.ta_rows(i)
    var bewegt: bool = false
    var geaendert: bool = false
    if k != KEY_UP && k != KEY_DOWN && k != KEY_PGUP && k != KEY_PGDN {
        wldraw.tas(t, wlbase.TS_WANT, 0xFFFFFFFFFFFFFFFF)
    }

    if k == KEY_LEFT {
        if ctrl {
            wldraw.ta_word_left(t)
        } else if wldraw.ta_has_sel(t) && !shift {
            let a: u64 = wldraw.ta_sel_first(t)
            wldraw.tas(t, wlbase.TS_CY, a >> 32)
            wldraw.tas(t, wlbase.TS_CX, a & 0xFFFFFFFF)
        } else if wldraw.tag(t, wlbase.TS_CX) > 0 {
            wldraw.tas(t, wlbase.TS_CX, wldraw.ta_back(t, wldraw.tag(t, wlbase.TS_CY), wldraw.tag(t, wlbase.TS_CX)))
        } else if wldraw.tag(t, wlbase.TS_CY) > 0 {
            wldraw.tas(t, wlbase.TS_CY, wldraw.tag(t, wlbase.TS_CY) - 1)
            wldraw.tas(t, wlbase.TS_CX, wldraw.lg(t, wldraw.tag(t, wlbase.TS_CY), wlbase.LN_N))
        }
        bewegt = true
    } else if k == KEY_RIGHT {
        if ctrl {
            wldraw.ta_word_right(t)
        } else if wldraw.ta_has_sel(t) && !shift {
            let b: u64 = wldraw.ta_sel_last(t)
            wldraw.tas(t, wlbase.TS_CY, b >> 32)
            wldraw.tas(t, wlbase.TS_CX, b & 0xFFFFFFFF)
        } else if wldraw.tag(t, wlbase.TS_CX) < wldraw.lg(t, wldraw.tag(t, wlbase.TS_CY), wlbase.LN_N) {
            wldraw.tas(t, wlbase.TS_CX, wldraw.ta_fwd(t, wldraw.tag(t, wlbase.TS_CY), wldraw.tag(t, wlbase.TS_CX)))
        } else if wldraw.tag(t, wlbase.TS_CY) + 1 < wldraw.tag(t, wlbase.TS_NL) {
            wldraw.tas(t, wlbase.TS_CY, wldraw.tag(t, wlbase.TS_CY) + 1)
            wldraw.tas(t, wlbase.TS_CX, 0)
        }
        bewegt = true
    } else if k == KEY_UP {
        if ctrl {
            if wldraw.tag(t, wlbase.TS_TOP) > 0 {
                wldraw.tas(t, wlbase.TS_TOP, wldraw.tag(t, wlbase.TS_TOP) - 1)
            }
            wlstate.dirty_wd(i)
            return
        }
        wldraw.ta_updown(t, true, 1)
        bewegt = true
    } else if k == KEY_DOWN {
        if ctrl {
            if wldraw.tag(t, wlbase.TS_TOP) + rows < wldraw.tag(t, wlbase.TS_NL) {
                wldraw.tas(t, wlbase.TS_TOP, wldraw.tag(t, wlbase.TS_TOP) + 1)
            }
            wlstate.dirty_wd(i)
            return
        }
        wldraw.ta_updown(t, false, 1)
        bewegt = true
    } else if k == KEY_PGUP {
        wldraw.ta_updown(t, true, rows)
        bewegt = true
    } else if k == KEY_PGDN {
        wldraw.ta_updown(t, false, rows)
        bewegt = true
    } else if k == KEY_HOME {
        if ctrl {
            wldraw.tas(t, wlbase.TS_CY, 0)
            wldraw.tas(t, wlbase.TS_CX, 0)
        } else {
            let target: u64 = wldraw.ta_einzug(t, wldraw.tag(t, wlbase.TS_CY))
            if wldraw.tag(t, wlbase.TS_CX) == target {
                wldraw.tas(t, wlbase.TS_CX, 0)
            } else {
                wldraw.tas(t, wlbase.TS_CX, target)
            }
        }
        bewegt = true
    } else if k == KEY_END {
        if ctrl {
            wldraw.tas(t, wlbase.TS_CY, wldraw.tag(t, wlbase.TS_NL) - 1)
            wldraw.tas(t, wlbase.TS_CX, wldraw.lg(t, wldraw.tag(t, wlbase.TS_NL) - 1, wlbase.LN_N))
        } else {
            wldraw.tas(t, wlbase.TS_CX, wldraw.lg(t, wldraw.tag(t, wlbase.TS_CY), wlbase.LN_N))
        }
        bewegt = true
    } else if k == KEY_BS || k == 127 {
        if wldraw.tag(t, wlbase.TS_RO) != 0 {
            return
        }
        wldraw.ta_push_undo(t)
        if !wldraw.ta_del_sel(t) {
            if wldraw.tag(t, wlbase.TS_CX) > 0 {
                let at: u64 = wldraw.ta_back(t, wldraw.tag(t, wlbase.TS_CY), wldraw.tag(t, wlbase.TS_CX))
                wldraw.ln_erase(t, wldraw.tag(t, wlbase.TS_CY), at, wldraw.tag(t, wlbase.TS_CX) - at)
                wldraw.tas(t, wlbase.TS_CX, at)
            } else if wldraw.tag(t, wlbase.TS_CY) > 0 {
                wldraw.ta_join(t, wldraw.tag(t, wlbase.TS_CY) - 1)
            }
        }
        geaendert = true
    } else if k == KEY_DEL || k == KEY_SDEL {
        if wldraw.tag(t, wlbase.TS_RO) != 0 {
            return
        }
        wldraw.ta_push_undo(t)
        if !wldraw.ta_del_sel(t) {
            let y: u64 = wldraw.tag(t, wlbase.TS_CY)
            let x: u64 = wldraw.tag(t, wlbase.TS_CX)
            if x < wldraw.lg(t, y, wlbase.LN_N) {
                wldraw.ln_erase(t, y, x, wldraw.ta_fwd(t, y, x) - x)
            } else if y + 1 < wldraw.tag(t, wlbase.TS_NL) {
                wldraw.ta_join(t, y)
            }
        }
        geaendert = true
    } else if k == KEY_ENTER {
        if wldraw.tag(t, wlbase.TS_RO) != 0 {
            return
        }
        wldraw.ta_push_undo(t)
        let _d: bool = wldraw.ta_del_sel(t)
        wldraw.ta_split(t)
        let vy: u64 = wldraw.tag(t, wlbase.TS_CY) - 1
        let e2: u64 = wldraw.ta_einzug(t, vy)
        if e2 > 0 {
            if wldraw.ln_insert(t, wldraw.tag(t, wlbase.TS_CY), 0, wldraw.lg(t, vy, wlbase.LN_P), e2) {
                wldraw.tas(t, wlbase.TS_CX, e2)
            }
        }
        geaendert = true
    } else if k == KEY_TAB {
        if wldraw.tag(t, wlbase.TS_RO) != 0 {
            return
        }
        wldraw.ta_push_undo(t)
        var sp: [u8; 8] = [32 as u8; 8]
        var br: u64 = wldraw.tag(t, wlbase.TS_TAB)
        if br == 0 || br > 8 {
            br = 4
        }
        wldraw.ta_insert(t, (&sp[0 as usize]) as u64, br)
        geaendert = true
    } else if k == KEY_CTRL_A {
        wldraw.tas(t, wlbase.TS_AY, 0)
        wldraw.tas(t, wlbase.TS_AX, 0)
        wldraw.tas(t, wlbase.TS_CY, wldraw.tag(t, wlbase.TS_NL) - 1)
        wldraw.tas(t, wlbase.TS_CX, wldraw.lg(t, wldraw.tag(t, wlbase.TS_NL) - 1, wlbase.LN_N))
        wlstate.dirty_wd(i)
        return
    } else if k == KEY_CTRL_C || k == KEY_CTRL_X {
        wldraw.ta_clip_put(t)
        if k == KEY_CTRL_X && wldraw.tag(t, wlbase.TS_RO) == 0 {
            wldraw.ta_push_undo(t)
            let _d2: bool = wldraw.ta_del_sel(t)
            geaendert = true
        } else {
            return
        }
    } else if k == KEY_CTRL_V {
        if wldraw.tag(t, wlbase.TS_RO) != 0 {
            return
        }
        wldraw.ta_push_undo(t)
        wldraw.ta_clip_take(t)
        geaendert = true
    } else if k == KEY_CTRL_Z {
        let at: u64 = wldraw.tag(t, wlbase.TS_UAT)
        if at > 0 {
            if at == wldraw.tag(t, wlbase.TS_UN) {
                wldraw.ta_push_undo(t)
                wldraw.tas(t, wlbase.TS_UAT, at)
            }
            wldraw.ta_restore(t, at - 1)
            wldraw.tas(t, wlbase.TS_UAT, at - 1)
            wldraw.tas(t, wlbase.TS_DIRTY, 1)
            wlstate.dirty_wd(i)
        }
        return
    } else if k == 25 {

        let at2: u64 = wldraw.tag(t, wlbase.TS_UAT)
        if at2 + 1 < wldraw.tag(t, wlbase.TS_UN) {
            wldraw.ta_restore(t, at2 + 1)
            wldraw.tas(t, wlbase.TS_UAT, at2 + 1)
            wldraw.tas(t, wlbase.TS_DIRTY, 1)
            wlstate.dirty_wd(i)
        }
        return
    } else if wldraw.druckbar(k) {
        if wldraw.tag(t, wlbase.TS_RO) != 0 {
            return
        }
        if !wldraw.ta_isword(k) || !wldraw.ta_has_sel(t) {
            if !wldraw.ta_isword(k) {
                wldraw.ta_push_undo(t)
            } else if wldraw.tag(t, wlbase.TS_UN) == 0 {
                wldraw.ta_push_undo(t)
            }
        }
        var ein: [u8; 8] = [0 as u8; 8]
        ein[(0) as usize] = k as u8
        wldraw.ta_insert(t, (&ein[0 as usize]) as u64, 1)
        geaendert = true
    } else {
        return
    }

    if bewegt {
        wldraw.ta_clamp(t)
        if !shift {
            wldraw.ta_sel_clear(t)
        }
        wldraw.ta_follow(t)
    }
    if geaendert {
        wldraw.tas(t, wlbase.TS_DIRTY, 1)
        wldraw.ta_follow(t)
    }
    wlstate.dirty_wd(i)
}

fn entry_tb(i: u64, t: *mut textbuf.TextBuf) -> bool {
    let p: u64 = wlstate.g(i, wlbase.D_TEXT)
    let max: u64 = wlstate.g(i, wlbase.D_D)
    if p == 0 || max < 1 {
        return false
    }
    textbuf.tb_init(t, p, (max - 1) as usize)
    textbuf.tb_set_len(t, wlstate.tlen(p) as usize)
    textbuf.tb_set_range(t, wlstate.g(i, wlbase.D_B) as usize, wlstate.g(i, wlbase.D_C) as usize)
    textbuf.tb_set_secret(t, (wlstate.g(i, wlbase.D_FLAGS) & wlbase.F_PASSWORD) != 0)
    return true
}

fn entry_tb_back(i: u64, t: *mut textbuf.TextBuf) {
    let n: usize = textbuf.tb_len(t)
    __mmio_write8((wlstate.g(i, wlbase.D_TEXT) + n as u64) as *mut u8, 0 as u8)
    wlstate.s(i, wlbase.D_B, textbuf.tb_caret(t) as u64)
    wlstate.s(i, wlbase.D_C, textbuf.tb_anchor(t) as u64)
}

fn entry_key(i: u64, k: u64) {
    var tb: textbuf.TextBuf = textbuf.tb_new()
    if !entry_tb(i, &tb) {
        return
    }
    if k == KEY_LEFT {
        textbuf.tb_left(&tb, false)
    } else if k == KEY_RIGHT {
        textbuf.tb_right(&tb, false)
    } else if k == KEY_HOME {
        textbuf.tb_home(&tb, false)
    } else if k == KEY_END {
        textbuf.tb_end(&tb, false)
    } else if k == KEY_BS || k == 127 {
        let _b: bool = textbuf.tb_backspace(&tb)
    } else if k == KEY_DEL {
        let _d: bool = textbuf.tb_delete_fwd(&tb)
    } else if k == 1 {

        textbuf.tb_select_all(&tb)
    } else if k == 3 || k == 24 {

        var out: [u8; 4096] = [0 as u8; 4096]
        let o: u64 = (&out[0 as usize]) as u64
        var m: usize = 0
        if k == 24 {
            m = textbuf.tb_cut(&tb, o, 4096)
        } else {
            m = textbuf.tb_copy(&tb, o, 4096)
        }
        if m > 0 {
            wlibc.clip_put(o, m as u64)
        }
    } else if k == 22 {

        var ein: [u8; 128] = [0 as u8; 128]
        let m: u64 = wlibc.clip_take((&ein[0 as usize]) as u64, 127)
        var q3: u64 = 0
        while q3 < m {
            if wldraw.druckbar((ein[(q3) as usize]) as u64) {
                let _i: bool = textbuf.tb_insert(&tb,
                    (&ein[(q3) as usize]) as u64, 1)
            }
            q3 = q3 + 1
        }
    } else if wldraw.druckbar(k) {
        var c: [u8; 1] = [k as u8; 1]
        let _i2: bool = textbuf.tb_insert(&tb, (&c[0 as usize]) as u64, 1)
    }
    entry_tb_back(i, &tb)
    wlstate.dirty_wd(i)
}

fn feed_key(c: u64) {
    on_key(wlbase.wncur, c)
}

fn feed_key_mod(k: u64, m: u64) {
    hostkey.s_keymod = m
    key_handle(wlbase.wncur, k)
}

fn on_key(wein: u64, c: u64) {
    let k: u64 = hostkey.decode(c)
    if k == 0 {
        return
    }
    key_handle(wein, k)
}

fn esc_spuelen(w: u64) {
    if hostkey.s_esc != 1 {
        return
    }
    hostkey.s_esc = 0
    key_handle(w, KEY_ESC)
}

fn key_handle(wein: u64, k: u64) {
    wlbase.s_keylast = k
    wlbase.s_keyseq = wlbase.s_keyseq + 1
    wlstate.blink_reset()
    var w: u64 = wein
    if wlbase.dl_win != 0xFFFFFFFFFFFFFFFF && wlstate.ng(wlbase.dl_win, wlbase.N_H) != 0 {
        w = wlbase.dl_win
    } else if wlbase.mn_win != 0xFFFFFFFFFFFFFFFF && wlstate.ng(wlbase.mn_win, wlbase.N_H) != 0 {
        w = wlbase.mn_win
    }
    if wlstate.ng(w, wlbase.N_KIND) == wlbase.NK_MENU {
        let zh: u64 = wlstate.ng(w, wlbase.N_CNT)
        if k == KEY_DOWN && wlstate.ng(w, wlbase.N_VAL) < zh {
            wlstate.ns(w, wlbase.N_VAL, wlstate.ng(w, wlbase.N_VAL) + 1)
            wlstate.dirty_all(w)
        } else if k == KEY_UP && wlstate.ng(w, wlbase.N_VAL) > 1 {
            wlstate.ns(w, wlbase.N_VAL, wlstate.ng(w, wlbase.N_VAL) - 1)
            wlstate.dirty_all(w)
        } else if k == KEY_ENTER && wlstate.ng(w, wlbase.N_VAL) > 0 {
            wldraw.fire(wlstate.ng(w, wlbase.N_OWNER), wlbase.K_MENUBAR, wlstate.ng(w, wlbase.N_VAL) - 1, w)
        } else if k == KEY_ESC {
            wlstate.ns(w, wlbase.N_VAL, 0)
            wldraw.fire(wlstate.ng(w, wlbase.N_OWNER), wlbase.K_MENUBAR, 0xFFFF, w)
        }
        return
    }
    if wlstate.ng(w, wlbase.N_KIND) == wlbase.NK_DLG {
        if k == KEY_ENTER {
            wldraw.fire(wlbase.dl_ok, wlbase.K_BUTTON, 0, w)
            return
        }
        if k == KEY_ESC {
            wldraw.fire(wlbase.dl_no, wlbase.K_BUTTON, 0, w)
            return
        }
        if wlbase.dl_ent < wlbase.MAXWD {
            entry_key(wlbase.dl_ent, k)
        }
        return
    }

    if (k == KEY_TAB || k == KEY_BTAB) && wlbase.s_canvas_tab != 0 {
        let fc: u64 = wlstate.focus_id()
        if fc < wlbase.MAXWD && wlstate.g(fc, wlbase.D_WIN) == w && wlstate.g(fc, wlbase.D_KIND) == wlbase.K_CANVAS {
            wlstate.lw_push(fc, LE_KEY, k, 0)
            return
        }
    }
    if k == KEY_TAB {
        wldraw.next_focus(w, false)
        return
    }
    if k == KEY_BTAB {
        wldraw.next_focus(w, true)
        return
    }
    let i: u64 = wlstate.focus_id()
    if i >= wlbase.MAXWD || wlstate.g(i, wlbase.D_WIN) != w {
        return
    }
    let kind: u64 = wlstate.g(i, wlbase.D_KIND)
    if kind == wlbase.K_ENTRY {
        if k == KEY_ENTER {
            wldraw.fire(i, wlbase.K_ENTRY, 0, w)
            return
        }
        entry_key(i, k)
        return
    }
    if kind == wlbase.K_TEXTAREA {
        ta_key(i, k)
        return
    }
    if kind == wlbase.K_CANVAS {
        wlstate.lw_push(i, LE_KEY, k, 0)
        return
    }
    if kind == wlbase.K_BUTTON {
        if k == KEY_ENTER || k == 32 {
            wldraw.fire(i, wlbase.K_BUTTON, 0, w)
        }
        return
    }
    if kind == wlbase.K_TILE {
        if k == KEY_ENTER || k == 32 {
            wldraw.fire(i, wlbase.K_TILE, 0, w)
        }
        return
    }
    if kind == wlbase.K_CHECK {
        if k == KEY_ENTER || k == 32 {
            wlstate.s(i, wlbase.D_VAL, 1 - wlstate.g(i, wlbase.D_VAL))
            wlstate.dirty_wd(i)
            wldraw.fire(i, wlbase.K_CHECK, wlstate.g(i, wlbase.D_VAL), w)
        }
        return
    }
    if kind == wlbase.K_SLIDER {
        var v: u64 = wlstate.g(i, wlbase.D_VAL)
        let schritt: u64 = wlstate.g(i, wlbase.D_A)
        var created: u64 = v
        if k == KEY_LEFT || k == KEY_DOWN {
            created = wlstate.sub(v, schritt)
        } else if k == KEY_RIGHT || k == KEY_UP {
            created = v + schritt
            if created > 100 {
                created = 100
            }
        } else if k == KEY_HOME {
            created = 0
        } else if k == KEY_END {
            created = 100
        } else {
            return
        }
        if created != v {
            wlstate.s(i, wlbase.D_VAL, created)
            wlstate.dirty_wd(i)
            wldraw.fire(i, wlbase.K_SLIDER, created, w)
        }
        return
    }
    if kind == wlbase.K_LIST || kind == wlbase.K_TABLE {
        var int: u64 = wlstate.g(i, wlbase.D_A)
        if kind == wlbase.K_TABLE {
            int = wlstate.sub(int, 1)
        }
        if int == 0 {
            return
        }
        var v: u64 = wlstate.g(i, wlbase.D_VAL)
        if k == KEY_DOWN && v + 1 < int {
            v = v + 1
        } else if k == KEY_UP && v > 0 {
            v = v - 1
        } else if k == KEY_HOME {
            v = 0
        } else if k == KEY_END {
            v = int - 1
        } else if k == KEY_PGDN {
            v = numeric.umin(v + 10, int - 1)
        } else if k == KEY_PGUP {
            v = wlstate.sub(v, 10)
        } else if k == KEY_ENTER {
            wldraw.fire(i, wlbase.K_LIST, v, w)
            return
        } else {
            return
        }
        wlstate.s(i, wlbase.D_VAL, v)
        scroll_to(i, v)
        wlstate.dirty_wd(i)
        return
    }
    if kind == wlbase.K_TABS {
        if k == KEY_RIGHT && wlwidget.tab_width(i, wlstate.g(i, wlbase.D_VAL) + 1) != 0 {
            wlstate.s(i, wlbase.D_VAL, wlstate.g(i, wlbase.D_VAL) + 1)
            wlstate.dirty_wd(i)
            wldraw.fire(i, wlbase.K_TABS, wlstate.g(i, wlbase.D_VAL), w)
        } else if k == KEY_LEFT && wlstate.g(i, wlbase.D_VAL) > 0 {
            wlstate.s(i, wlbase.D_VAL, wlstate.g(i, wlbase.D_VAL) - 1)
            wlstate.dirty_wd(i)
            wldraw.fire(i, wlbase.K_TABS, wlstate.g(i, wlbase.D_VAL), w)
        }
        return
    }
    if kind == wlbase.K_CHOICE {
        if k == KEY_ENTER || k == 32 {
            wldraw.fire(i, wlbase.K_CHOICE, 0x1000, w)
        }
        return
    }
}

const MN_AIR: u64 = 8

fn menu_an_arbeit(w: u64, sy: u64, bh: u64) {
    let hh: u64 = wlstate.ng(w, wlbase.N_H)
    if hh == 0 {
        return
    }
    let wy: u64 = wlibc.work_y(hh)
    let wh2: u64 = wlibc.work_h(hh)
    let sh2: u64 = wlibc.screen_h()
    if wh2 == 0 || wy + wh2 > sh2 {
        return
    }
    let bottom: u64 = wy + wh2
    let now: u64 = wlstate.ng(w, wlbase.N_Y)
    if now + bh + MN_AIR <= bottom {
        return
    }
    var y: u64 = 0
    if sy > bh + MN_AIR {
        y = wlstate.sub(sy, bh + MN_AIR)
    }
    if y + bh + MN_AIR > bottom {
        if bottom > bh + MN_AIR {
            y = wlstate.sub(bottom, bh + MN_AIR)
        } else {
            y = wy
        }
    }
    if y == now {
        return
    }
    wlstate.ns(w, wlbase.N_Y, y)
    let _m: u64 = wlibc.win_move(hh, wlstate.ng(w, wlbase.N_X), y)
}

fn menu_at() -> u64 {
    return wlbase.mn_res
}

fn menu_close() {
    if wlbase.mn_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    wlstate.close(wlbase.mn_win)
    if wlbase.mn_win + 1 == wlbase.nwn {
        wlbase.nwn = wlbase.nwn - 1
    }
    wlbase.mn_win = 0xFFFFFFFFFFFFFFFF
}

fn dlg_text() -> u64 {
    return (&wlbase.dlgbuf[0 as usize]) as u64
}

fn dlg_state() -> u64 {
    return wlbase.dl_state
}

fn dlg_close() {
    if wlbase.dl_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    wlbase.dl_nb = 0
    wlstate.close(wlbase.dl_win)
    if wlbase.dl_win + 1 == wlbase.nwn {
        wlbase.nwn = wlbase.nwn - 1
    }
    wlbase.dl_win = 0xFFFFFFFFFFFFFFFF
    wlbase.dl_state = 0
    while wlbase.nwd > 0 && (wlstate.g(wlbase.nwd - 1, wlbase.D_FLAGS) & wlbase.F_HIDE) != 0 {
        wlbase.nwd = wlbase.nwd - 1
    }
    if wlbase.s_focus != 0 && wlbase.s_focus - 1 >= wlbase.nwd {
        wlbase.s_focus = 0
        var i: u64 = 0
        while i < wlbase.nwd {
            if (wlstate.g(i, wlbase.D_FLAGS) & wlbase.F_FOCUSABLE) != 0 && wlbase.s_focus == 0 {
                wlbase.s_focus = i + 1
            }
            i = i + 1
        }
    }
}

const THEME_POLL_TICKS: u64 = 25

fn theme_watch() -> bool {
    let t: u64 = clockapi.ticks()
    if t < s_thpoll + THEME_POLL_TICKS {
        return false
    }
    s_thpoll = t
    s_thpolls = s_thpolls + 1
    if !wlibc.theme_poll() {
        return false
    }
    s_thswitch = s_thswitch + 1
    var w: u64 = 0
    while w < wlbase.nwn {
        if wlstate.ng(w, wlbase.N_H) != 0 {
            wlstate.dirty_all(w)
        }
        w = w + 1
    }
    return true
}

fn theme_now() -> bool {
    s_thpoll = 0
    return theme_watch()
}

fn theme_switches() -> u64 {
    return s_thswitch
}

fn theme_polls() -> u64 {
    return s_thpolls
}

fn theme_pixels() -> u64 {
    return wlbase.s_thpx
}

fn theme_stales() -> u64 {
    return s_thstale
}

const PT_ON: str = __env_or("FIRN_OSUM_PAINTTIME", "0")

static mut s_pt_n: u64 = 0

static mut s_pt_sum: u64 = 0

static mut s_pt_max: u64 = 0

static mut s_pt_said: u64 = 0

static mut pt_a: [u8; 20] = "wlib: paint frames=\0"

static mut pt_b: [u8; 11] = " avg_kcyc=\0"

static mut pt_c: [u8; 11] = " max_kcyc=\0"

static mut pt_d: [u8; 8] = " prims=\0"

fn pt_tsc() -> u64 {
    return asm("rdtsc\nshl rdx, 32\nor rax, rdx", out("rax"))
}

fn paint_all() -> u64 {
    let t0: u64 = pt_tsc()
    let n: u64 = paint_all_inner()
    if n != 0 {
        let dt: u64 = pt_tsc() -% t0
        s_pt_n = s_pt_n + 1
        s_pt_sum = s_pt_sum + dt
        if dt > s_pt_max {
            s_pt_max = dt
        }
        if s_pt_n == 32 && s_pt_said == 0 && PT_ON.n == 1
        && *(PT_ON.p) == 49 as u8 {
            s_pt_said = 1
            lineout.add_text((&pt_a[0 as usize]) as u64)
            lineout.add_num(s_pt_n)
            lineout.add_text((&pt_b[0 as usize]) as u64)
            lineout.add_num(s_pt_sum / s_pt_n / 1000)
            lineout.add_text((&pt_c[0 as usize]) as u64)
            lineout.add_num(s_pt_max / 1000)
            lineout.add_text((&pt_d[0 as usize]) as u64)
            lineout.add_num(fuib.fui_prims())
            lineout.end_line()
        }
    }
    return n
}

fn paint_all_inner() -> u64 {
    wlwidget.radius_apply()
    let before: u64 = wlibc.theme_frame_begin()
    let _v: u64 = before
    var gemalt: u64 = 0
    var w: u64 = 0
    while w < wlbase.nwn {
        if wlstate.ng(w, wlbase.N_H) != 0 {
            gemalt = gemalt + flush_win(w)
        }
        w = w + 1
    }
    if wlibc.theme_frame_end() {
        s_thstale = s_thstale + 1
        let _v2: u64 = wlibc.theme_frame_begin()
        w = 0
        while w < wlbase.nwn {
            if wlstate.ng(w, wlbase.N_H) != 0 {
                wlstate.dirty_all(w)
                gemalt = gemalt + flush_win(w)
            }
            w = w + 1
        }
        let _e2: bool = wlibc.theme_frame_end()
    }
    return gemalt
}

fn idle_sleep_on() {
    wlbase.s_idle_sleep = 1
}

fn rect_x(i: u64) -> u64 {
    return wlstate.g(i, wlbase.D_X)
}

fn rect_y(i: u64) -> u64 {
    return wlstate.g(i, wlbase.D_Y)
}

fn rect_w(i: u64) -> u64 {
    return wlstate.g(i, wlbase.D_W)
}

fn rect_h(i: u64) -> u64 {
    return wlstate.g(i, wlbase.D_H)
}

fn kind_of(i: u64) -> u64 {
    return wlstate.g(i, wlbase.D_KIND)
}

fn row_h() -> u64 {
    return wlstate.lines_height()
}

fn row_h_of(i: u64) -> u64 {
    let zh: u64 = wlstate.lines_height()
    if i >= wlbase.MAXWD || wlstate.g(i, wlbase.D_SECOND) == 0 {
        return zh
    }
    let th: u64 = wlibc.text_h(wlibc.px_ui())
    if zh <= th {
        return 2 * zh
    }
    return 2 * th + (zh - th)
}

fn text_x(i: u64) -> u64 {
    let k: u64 = wlstate.g(i, wlbase.D_KIND)
    if k == wlbase.K_BUTTON {
        let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), wlstate.g(i, wlbase.D_TEXT),
            wlstate.tlen(wlstate.g(i, wlbase.D_TEXT)))
        return wlstate.g(i, wlbase.D_X) + wlstate.sub(wlstate.g(i, wlbase.D_W), tw) / 2
    }
    if k == wlbase.K_ENTRY {
        return wlstate.g(i, wlbase.D_X) + 5
    }
    if k == wlbase.K_CHECK {
        return wlstate.g(i, wlbase.D_X) + 20
    }
    return wlstate.g(i, wlbase.D_X)
}

fn text_base(i: u64) -> u64 {
    let k: u64 = wlstate.g(i, wlbase.D_KIND)
    let asc: u64 = wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    if k == wlbase.K_LABEL {
        return wlstate.g(i, wlbase.D_Y) + asc
    }
    return wlstate.g(i, wlbase.D_Y) + (wlstate.g(i, wlbase.D_H) + asc) / 2
}

fn text_fg(i: u64) -> u64 {
    if (wlstate.g(i, wlbase.D_FLAGS) & wlbase.F_OFF) != 0 {
        return wlibc.theme(wlibc.T_DIM)
    }
    return wlibc.theme(wlibc.T_FG)
}

fn text_bg(i: u64) -> u64 {
    let k: u64 = wlstate.g(i, wlbase.D_KIND)
    if k == wlbase.K_BUTTON {
        if (wlstate.g(i, wlbase.D_FLAGS) & wlbase.F_PRESSED) != 0 {
            return wlibc.theme(wlibc.T_BTNDN)
        }
        if (wlstate.g(i, wlbase.D_FLAGS) & wlbase.F_HOVER) != 0 {
            return wlibc.theme(wlibc.T_BTNHI)
        }
        return wlibc.theme(wlibc.T_BTN)
    }
    if k == wlbase.K_ENTRY {
        return wlibc.theme(wlibc.T_ENTRY)
    }
    if k == wlbase.K_CHOICE {
        return wlibc.theme(wlibc.T_BTN)
    }
    if wlstate.g(i, wlbase.D_WIN) < wlbase.MAXWN && wlstate.ng(wlstate.g(i, wlbase.D_WIN), wlbase.N_KIND) == wlbase.NK_DLG {
        return wlibc.theme(wlibc.T_DLG)
    }
    return wlibc.theme(wlibc.T_BG)
}

fn row_base(i: u64, r: u64) -> u64 {
    let zh: u64 = row_h_of(i)
    if i < wlbase.MAXWD && wlstate.g(i, wlbase.D_SECOND) != 0 {
        let hz: u64 = zh / 2
        return wlstate.g(i, wlbase.D_Y) + 2 + r * zh
            + wlstate.sub(hz, wlibc.text_h(wlibc.px_ui())) / 2
            + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    }
    return wlstate.g(i, wlbase.D_Y) + 2 + r * zh
        + wlstate.sub(zh, wlibc.text_h(wlibc.px_ui())) / 2
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
}

fn base_in_row(ry: u64, zh: u64) -> u64 {
    return ry + wlstate.sub(zh, wlibc.text_h(wlibc.px_ui())) / 2
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
}

fn row_x(i: u64) -> u64 {
    return wlstate.g(i, wlbase.D_X) + 6 + wlwidget.list_in(i)
}

fn icon_x(i: u64) -> u64 {
    return wlstate.g(i, wlbase.D_X) + 3 + 2 * wlibc.ui_scale()
}

fn icon_y(i: u64, r: u64) -> u64 {
    let zh: u64 = row_h_of(i)
    let ih: u64 = wlibc.icon_small()
    var top: u64 = 3
    if zh > ih {
        top = (zh - ih) / 2
    }
    return wlstate.g(i, wlbase.D_Y) + 2 + r * zh + top
}

fn tile_top(zh: u64, h: u64) -> u64 {
    if zh > wlstate.lines_height() && zh > h {
        return (zh - h) / 2
    }
    return 3
}

fn icon_letter_x(i: u64, p: u64) -> u64 {
    return wlstate.g(i, wlbase.D_X) + 5 + wlstate.sub(14, wlibc.text_w(wlibc.F_UI, wlibc.px_ui(),
        p, 1)) / 2
}

fn icon_letter_base(i: u64, r: u64) -> u64 {
    let zh: u64 = row_h_of(i)
    return wlstate.g(i, wlbase.D_Y) + 2 + r * zh + tile_top(zh, wlstate.tile_w()) + 12
}

fn head_h(i: u64) -> u64 {
    return wlstate.lines_height() + 4
}

fn head_base(i: u64) -> u64 {
    return wlstate.g(i, wlbase.D_Y) + 3 + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
}

fn cell_base(i: u64, r: u64) -> u64 {
    return wlstate.g(i, wlbase.D_Y) + head_h(i) + 1 + r * wlstate.lines_height()
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()) + 1
}

fn cell_x(i: u64, c: u64) -> u64 {
    var x: u64 = wlstate.g(i, wlbase.D_X) + 6
    var k: u64 = 0
    while k < c && k < wlstate.g(i, wlbase.D_C) {
        x = x + wlwidget.column_wide(i, k)
        k = k + 1
    }

    if c == 0 {
        x = x + wlwidget.table_in(i)
    }
    return x
}

fn dlg_button(welcher: u64) -> u64 {
    if welcher == 0 {
        return wlbase.dl_ok
    }
    return wlbase.dl_no
}

fn dlg_label() -> u64 {
    return wlbase.dl_lbl
}

fn dlg_win() -> u64 {
    if wlbase.dl_win == 0xFFFFFFFFFFFFFFFF {
        return wlbase.MAXWN
    }
    return wlbase.dl_win
}

fn win_count() -> u64 {
    return wlbase.nwn
}

fn menu_win() -> u64 {
    if wlbase.mn_win == 0xFFFFFFFFFFFFFFFF {
        return wlbase.MAXWN
    }
    return wlbase.mn_win
}

