fn clip_hist_typ(back: u64) -> u64 {
    return wlibc.clip_hist_typ(back)
}

fn clip_hist_owner(back: u64) -> u64 {
    return wlibc.clip_hist_owner(back)
}

fn drag_put(typen: u64, p: u64, n: u64) -> u64 {
    return wlibc.drag_put(typen, p, n)
}

fn drag_take(p: u64, max: u64) -> u64 {
    return wlibc.drag_take(p, max)
}

fn drag_an() -> bool {
    return wlibc.drag_an()
}

fn drag_drop() -> u64 {
    return wlibc.drag_drop()
}

fn noti_post(dringlich: u64, p: u64, n: u64) -> u64 {
    return wlibc.noti_post(dringlich, p, n)
}

fn noti_count() -> u64 {
    return wlibc.noti_count()
