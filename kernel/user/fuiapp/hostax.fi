profile kernel

import ulib

const AXN_BYTES: u64 = 96

const AXN_NAME: u64 = 24

const AXN_NAMEMAX: u64 = 40

const AXN_ACT: u64 = 64

const AXN_ACTMAX: u64 = 32

const AXN_MAX: u64 = 224

const AXR_WINDOW: u64 = 1

const AXR_LABEL: u64 = 2

const AXR_BUTTON: u64 = 3

const AXR_CHECK: u64 = 4

const AXR_ENTRY: u64 = 5

const AXR_PASSWORD: u64 = 6

const AXR_LIST: u64 = 7

const AXR_TABLE: u64 = 8

const AXR_TAB: u64 = 9

const AXR_MENUBAR: u64 = 10

const AXR_CHOICE: u64 = 11

const AXR_SEPARATOR: u64 = 12

const AXR_SCROLLBAR: u64 = 13

const AXR_MENU: u64 = 14

const AXR_DIALOG: u64 = 15

const AXR_SLIDER: u64 = 16

const AXS_ENABLED: u64 = 1

const AXS_FOCUSABLE: u64 = 2

const AXS_FOCUSED: u64 = 4

const AXS_HIDDEN: u64 = 16

const AXS_CHECKED: u64 = 32

const AXS_PROTECTED: u64 = 64

const AXP_BASE: u64 = 0x8000

const AXS_SELECTED: u64 = 8

const AX_PUSH: u64 = 1910
const AX_READ: u64 = 1911
const AX_EVENT: u64 = 1912
const AX_PERM: u64 = 1913
const AX_INFO: u64 = 1914
const AX_SET: u64 = 1915
const AX_PRESS: u64 = 1916
const AXI_HIGH: u64 = 7
const AXC_DUMP: u64 = 99
const AXC_HIGH: u64 = 0
const AXC_MAG: u64 = 1
const AXC_ON: u64 = 3
const AXC_STICKY: u64 = 2
const AXI_COUNT: u64 = 0
const AXI_DENIED: u64 = 4
const AXI_EVDROP: u64 = 11
const AXI_EVENTS: u64 = 10
const AXI_FOREIGN: u64 = 13
const AXI_GEN: u64 = 1
const AXI_LEAKS: u64 = 6
const AXI_MAG: u64 = 8
const AXI_ON: u64 = 12
const AXI_PRESSES: u64 = 14
const AXI_PUSHES: u64 = 2
const AXI_READS: u64 = 3
const AXI_REFUSED: u64 = 15
const AXI_SECRETS: u64 = 5
const AXI_STICKY: u64 = 9
const AXP_ACT: u64 = 2
const AXP_COUNT: u64 = 3
const AXP_GRANT: u64 = 1
const AXP_MINE: u64 = 0
const AXP_READ: u64 = 1
const AXP_REVOKE: u64 = 2
const EV_AXPRESS: u64 = 8

fn ax_info(field: u64) -> u64 {
    return ulib.sys(AX_INFO, field, 0, 0)
}

fn ax_set(field: u64, v: u64) -> u64 {
    return ulib.sys(AX_SET, field, v, 0)
}

fn ax_perm(op: u64, task: u64, bits: u64) -> u64 {
    return ulib.sys(AX_PERM, op, task, bits)
}

fn ax_begin() -> u64 {
    return ulib.sys(AX_PUSH, 0, 1, 0)
}

fn ax_send(ptr: u64, n: u64) -> u64 {
    return ulib.sys(AX_PUSH, ptr, n, 0)
}

fn ax_end() -> u64 {
    return ulib.sys(AX_PUSH, 0, 0, 0)
}

fn ax_read(nr: u64, dst: u64, len: u64) -> u64 {
    return ulib.sys(AX_READ, nr, dst, len)
}

fn ax_event(dst: u64, len: u64) -> u64 {
    return ulib.sys(AX_EVENT, dst, len, 0)
}

fn ax_press(nr: u64, gen: u64) -> u64 {
    return ulib.sys(AX_PRESS, nr, gen, 0)
}

fn ax_high() -> u64 {
    if ax_info(AXI_HIGH) == 1 {
        return 1
    }
    return 0
}
