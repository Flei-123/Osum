profile kernel

import xfer

const BUS_REG_OP: u64 = 1
const BUS_FIND_OP: u64 = 2
const BUS_SEND_OP: u64 = 3
const BUS_RECV_OP: u64 = 4
const BUS_SUB_OP: u64 = 5
const BUS_PUB_OP: u64 = 6

fn bus_da() -> bool {
    return xfer.available()
}

fn bus_reg(name: u64, n: u64, zugriff: u64) -> u64 {
    return xfer.bus5(BUS_REG_OP, name, n, zugriff, 0)
}

fn bus_find(name: u64, n: u64) -> u64 {
    return xfer.bus5(BUS_FIND_OP, name, n, 0, 0)
}

fn bus_send(dienst: u64, p: u64, n: u64) -> u64 {
    return xfer.bus5(BUS_SEND_OP, dienst, p, n, 0)
}

fn bus_recv(p: u64, max: u64, head: u64) -> u64 {
    return xfer.bus5(BUS_RECV_OP, p, max, head, 0)
}

fn bus_sub(dienst: u64) -> u64 {
    return xfer.bus5(BUS_SUB_OP, dienst, 0, 0, 0)
}

fn bus_pub(dienst: u64, p: u64, n: u64) -> u64 {
    return xfer.bus5(BUS_PUB_OP, dienst, p, n, 0)
}
