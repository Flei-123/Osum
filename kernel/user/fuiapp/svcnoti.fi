profile kernel

import ulib
import xfer

const BUS_NOTIPOST_OP: u64 = 19
const BUS_NOTIGET_OP: u64 = 20
const BUS_NOTIINFO_OP: u64 = 21
const BUS_NOTIPEEK_OP: u64 = 23

fn noti_post(dringlich: u64, p: u64, n: u64) -> u64 {
    return xfer.bus5(BUS_NOTIPOST_OP, dringlich, p, n, 0)
}

fn noti_count() -> u64 {
    let n: u64 = xfer.bus5(BUS_NOTIINFO_OP, 0, 0, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn noti_new() -> u64 {
    let n: u64 = xfer.bus5(BUS_NOTIINFO_OP, 1, 0, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn noti_take(back: u64, p: u64, max: u64) -> u64 {
    let n: u64 = xfer.bus5(BUS_NOTIGET_OP, back, p, max, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn noti_peek(back: u64, p: u64, max: u64) -> u64 {
    let n: u64 = xfer.bus5(BUS_NOTIPEEK_OP, back, p, max, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn noti_prio(back: u64) -> u64 {
    let n: u64 = xfer.bus5(BUS_NOTIINFO_OP, 3, back, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn noti_len(back: u64) -> u64 {
    let n: u64 = xfer.bus5(BUS_NOTIINFO_OP, 2, back, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn noti_total() -> u64 {
    let n: u64 = xfer.bus5(BUS_NOTIINFO_OP, 5, 0, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}
