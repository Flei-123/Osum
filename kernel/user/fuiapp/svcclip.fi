profile kernel

import ulib
import xfer

static mut s_noclip: u64 = 0

const CLIP_WIG_MAX: u64 = 4096
const WIG_CLIPSET: u64 = 1803
const WIG_CLIPGET: u64 = 1804
const WIG_SCREEN: u64 = 1805
const BT_TEXT: u64 = 1
const BT_PATH: u64 = 2
const BT_HTML: u64 = 4
const BT_IMAGE: u64 = 8
const BT_FILES: u64 = 16

fn set_noclip() {
    s_noclip = 1
}

fn clip_put(p: u64, n: u64) -> u64 {
    return clip_put_typ(BT_TEXT, p, n)
}

fn clip_put_typ(typen: u64, p: u64, n: u64) -> u64 {
    if s_noclip != 0 {
        return 0
    }
    if !xfer.available() {
        var wn: u64 = n
        if wn > CLIP_WIG_MAX {
            wn = CLIP_WIG_MAX
        }
        return ulib.sys(WIG_CLIPSET, p, wn, 0)
    }
    let r: u64 = xfer.set(xfer.SEL_CLIPBOARD, typen, p, n)
    if ulib.bad(r) {
        return 0
    }
    return r
}

fn clip_take(p: u64, max: u64) -> u64 {
    return clip_hist_take(0, p, max)
}

fn clip_hist_take(back: u64, p: u64, max: u64) -> u64 {
    if s_noclip != 0 {
        return 0
    }
    if !xfer.available() {
        if back != 0 {
            return 0
        }
        let m: u64 = ulib.sys(WIG_CLIPGET, p, max, 0)
        if ulib.bad(m) {
            return 0
        }
        return m
    }
    let n: u64 = xfer.get_text(xfer.SEL_CLIPBOARD, back, p, max)
    if ulib.bad(n) {
        return 0
    }
    if n > max {
        return max
    }
    return n
}

fn clip_hist_count() -> u64 {
    return xfer.count(xfer.SEL_CLIPBOARD)
}

fn clip_hist_typ(back: u64) -> u64 {
    return xfer.types(xfer.SEL_CLIPBOARD, back)
}

fn clip_hist_owner(back: u64) -> u64 {
    return xfer.owner(xfer.SEL_CLIPBOARD, back)
}

fn clip_len() -> u64 {
    if s_noclip != 0 {
        return 0
    }
    return ulib.sys(WIG_SCREEN, 5, 0, 0)
}

fn drag_put(typen: u64, p: u64, n: u64) -> u64 {
    return xfer.drag_start(typen, p, n)
}

fn drag_take(p: u64, max: u64) -> u64 {
    return ulib.drag_take(p, max)
}

fn drag_an() -> bool {
    return xfer.drag_active()
}

fn drag_drop() -> u64 {
    return xfer.drag_end()
}
