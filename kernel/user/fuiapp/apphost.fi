}

fn noglass() -> bool {
    return hostflags.on(hostflags.NOGLASS)
}

fn trace() -> bool {
    return wlstate.trace()
}

fn dirty_every() {
    var w: u64 = 0
    while w < wlbase.MAXWN {
        wlstate.dirty_all(w)
        w = w + 1
    }
}

fn paint_all() -> u64 {
    return wlevent.paint_all()
}

