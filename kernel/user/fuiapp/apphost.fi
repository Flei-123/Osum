profile kernel

import wlib
import fuiapp.hostkey

const KEY_ESC: u64 = hostkey.KEY_ESC

const KEY_UP: u64 = hostkey.KEY_UP

const KEY_DOWN: u64 = hostkey.KEY_DOWN

fn win_x(w: u64) -> u64 {
    return wlib.win_x(w)
}

fn win_y(w: u64) -> u64 {
    return wlib.win_y(w)
}

fn win_cx(w: u64) -> u64 {
    return wlib.win_cx(w)
}

fn win_cy(w: u64) -> u64 {
    return wlib.win_cy(w)
}

fn paintdirect() -> bool {
    return wlib.paintdirect()
}

fn key_mod() -> u64 {
    return wlib.key_mod()
}

fn icon_id(c: u64) -> u64 {
    return wlib.icon_id(c)
}

fn icon_tint(word: u64, rgb: u64) -> u64 {
    return wlib.icon_tint(word, rgb)
}

fn handle(w: u64) -> u64 {
    return wlib.handle(w)
}

fn step() -> u64 {
    return wlib.step()
}

fn close_window(w: u64) {
    wlib.close(w)
    wlib.draw_all()
}

fn noglass() -> bool {
    return wlib.noglass()
}

fn trace() -> bool {
    return wlib.trace()
}

fn dirty_every() {
    var w: u64 = 0
    while w < wlib.MAXWN {
        wlib.dirty_all(w)
        w = w + 1
    }
}

fn paint_all() -> u64 {
    return wlib.paint_all()
}

fn theme_now() -> bool {
    return wlib.theme_now()
}

fn theme_polls() -> u64 {
    return wlib.theme_polls()
}

fn theme_stales() -> u64 {
    return wlib.theme_stales()
}

const ICON_TAG: u64 = wlib.ICON_TAG

fn ax_set_hooks(b: fn(u64, u64, u64) -> u64, p: fn(u64)) {
    wlib.ax_set_hooks(b, p)
}

fn begin(nohit: bool, noclip: bool) -> bool {
    return wlib.begin(nohit, noclip)
}

fn drop_an(an: bool) {
    wlib.drop_an(an)
}

fn window_app(i: u64, name: u64) -> u64 {
    return wlib.window_app(i, name)
}

fn window_title(i: u64, text: u64) -> u64 {
    return wlib.window_title(i, text)
}

fn drag_begin(txt: u64, sx: u64, sy: u64) {
    wlib.zug_auf(txt, sx, sy)
}

fn is_image_pub(p: u64) -> bool {
    return wlib.is_image_pub(p)
}

fn key_shift() -> bool {
    return wlib.key_shift()
}

fn blink_enabled() -> bool {
    return wlib.blink_enabled()
}

fn canvas_pending_for(wd: u64) -> u64 {
    return wlib.canvas_pending_for(wd)
}

fn clip_put(p: u64, n: u64) -> u64 {
    return wlib.clip_put(p, n)
}

fn clip_take(p: u64, max: u64) -> u64 {
    return wlib.clip_take(p, max)
}

fn focus_id() -> u64 {
    return wlib.focus_id()
}

fn note_resize(w: u64, nw: u64, nh: u64) {
    wlib.note_resize(w, nw, nh)
}

fn plog_enabled() -> bool {
    return wlib.plog_enabled()
}

fn resize_seq() -> u64 {
    return wlib.resize_seq()
}

fn set_focus(i: u64) {
    wlib.set_focus(i)
}

fn win_focused(w: u64) -> bool {
    return wlib.win_fokus(w)
}

fn win_hide(w: u64, on: bool) -> u64 {
    return wlib.win_hide(w, on)
}
