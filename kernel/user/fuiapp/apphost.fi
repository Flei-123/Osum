profile app

import wlib

fn win_x(w: u64) -> u64 {
    return wlib.win_x(w)
}

fn win_y(w: u64) -> u64 {
    return wlib.win_y(w)
}

fn win_cx(w: u64) -> u64 {
    return wlib.win_cx(w)
}

fn win_cy(w: u64) -> u64 {
    return wlib.win_cy(w)
}

fn paintdirect() -> bool {
    return wlib.paintdirect()
}

fn key_mod() -> u64 {
    return wlib.key_mod()
}

fn icon_id(c: u64) -> u64 {
    return wlib.icon_id(c)
}
