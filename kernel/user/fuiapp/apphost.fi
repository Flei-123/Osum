    wlib.draw_all()
}

fn noglass() -> bool {
    return wlib.noglass()
}

fn trace() -> bool {
    return wlib.trace()
}

fn dirty_every() {
    var w: u64 = 0
    while w < wlib.MAXWN {
        wlib.dirty_all(w)
        w = w + 1
    }
}

fn paint_all() -> u64 {
    return wlib.paint_all()
}

