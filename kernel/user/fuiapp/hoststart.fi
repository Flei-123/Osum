profile kernel

import fuiapp.hosthead
import svcclip
import uitheme.thload
import ulib

fn start(noclip: bool) -> bool {
    if hosthead.s_ready != 0 {
        return true
    }
    hosthead.s_scr_w = ulib.sys(hosthead.WIG_SCREEN, 0, 0, 0)
    hosthead.s_scr_h = ulib.sys(hosthead.WIG_SCREEN, 1, 0, 0)
    if ulib.bad(hosthead.s_scr_w) || hosthead.s_scr_w == 0 || hosthead.s_scr_w > hosthead.SURF_W_MAX {
        return false
    }
    if ulib.bad(hosthead.s_scr_h) || hosthead.s_scr_h == 0 {
        return false
    }
    var rows: u64 = hosthead.SURF_BUDGET / (hosthead.s_scr_w *% 4)
    if rows == 0 {
        return false
    }
    if rows > hosthead.s_scr_h {
        rows = hosthead.s_scr_h
    }
    let p: u64 = hosthead.map_surface(hosthead.s_scr_w *% rows *% 4)
    if ulib.bad(p) || p == 0 {
        return false
    }
    hosthead.s_surf = p
    hosthead.s_scap = hosthead.s_scr_w *% rows *% 4
    hosthead.s_sw = hosthead.s_scr_w
    hosthead.s_srows = rows
    if noclip {
        svcclip.set_noclip()
    }
    let _tg: u64 = thload.theme_reload()
    hosthead.s_ready = 1
    return true
}

