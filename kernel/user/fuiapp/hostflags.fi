profile kernel

import libc.io
import ulib

const PAINTLOG: u64 = 0

const FULLDAMAGE: u64 = 1

const PAINTDIRECT: u64 = 2

const NOMINSIZE: u64 = 3

const NOGLASS: u64 = 4

const EYEOLD: u64 = 5

const FLAG_COUNT: u64 = 6

const PATH_SLOT: u64 = 17

const UNKNOWN: u64 = 0

const ON: u64 = 1

const OFF: u64 = 2

static mut s_paths: [u8; 102] = "/etc/paintlog\0\0\0\0/etc/fulldamage\0\0/etc/paintdirect\0/etc/nominsize\0\0\0/etc/noglass\0\0\0\0\0/etc/eyeold\0\0\0\0\0\0"

static mut s_state: [u64; 6] = [0 as u64; 6]

fn probe(flag: u64) -> u64 {
    let fd: u64 = io.open((&s_paths[0 as usize]) as u64 + flag * PATH_SLOT, 0)
    if ulib.bad(fd) {
        return OFF
    }
    io.close(fd)
    return ON
}

fn on(flag: u64) -> bool {
    if flag >= FLAG_COUNT {
        return false
    }
    if s_state[(flag) as usize] == UNKNOWN {
        s_state[(flag) as usize] = probe(flag)
    }
    return s_state[(flag) as usize] == ON
}
