profile kernel

import ulib
import actwire

export { enabled_or, autostart, autostart_known, set_enabled, set_autostart }

static mut p_conf: [u8; 23] = "/etc/screenreader.conf\0"
static mut f_enabled: [u8; 8] = "enabled\0"
static mut f_autostart: [u8; 10] = "autostart\0"
static mut v_on: [u8; 2] = "1\0"
static mut v_off: [u8; 2] = "0\0"

fn flag_or(field: u64, dflt: bool) -> bool {
    var v: [u8; 4] = [0 as u8; 4]
    if !actwire.kvfile_get((&p_conf[0 as usize]) as u64, field, (&v[0 as usize]) as u64, 4) {
        return dflt
    }
    return v[0 as usize] == 49 as u8
}

fn put(field: u64, on: bool) -> bool {
    var v: u64 = (&v_off[0 as usize]) as u64
    if on {
        v = (&v_on[0 as usize]) as u64
    }
    return actwire.kvfile_set((&p_conf[0 as usize]) as u64, field, v)
}

fn enabled_or(dflt: bool) -> bool {
    return flag_or((&f_enabled[0 as usize]) as u64, dflt)
}

fn autostart() -> bool {
    return flag_or((&f_autostart[0 as usize]) as u64, false)
}

fn autostart_known() -> bool {
    var v: [u8; 4] = [0 as u8; 4]
    return actwire.kvfile_get((&p_conf[0 as usize]) as u64, (&f_autostart[0 as usize]) as u64, (&v[0 as usize]) as u64, 4)
}

fn set_enabled(on: bool) -> bool {
    return put((&f_enabled[0 as usize]) as u64, on)
}

fn set_autostart(on: bool) -> bool {
    return put((&f_autostart[0 as usize]) as u64, on)
}
