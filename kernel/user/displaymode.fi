profile kernel

import ulib
import libc.io
import wlibc

export { saved_mirror, save, apply_saved, current_mirror, connected }

static mut p_conf: [u8; 19] = "/etc/displays.conf\0"
static mut line_mirror: [u8; 14] = "heads=mirror\n\0"
static mut line_extend: [u8; 14] = "heads=extend\n\0"
static mut buf: [u8; 64] = [0 as u8; 64]

fn saved_mirror() -> bool {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_conf[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return false
    }
    let b: u64 = (&buf[0 as usize]) as u64
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, b, 63)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n < 11 {
        return false
    }
    return __mmio_read8((b + 6) as *mut u8) == 109 as u8
}

fn save(mirror: bool) -> bool {
    let fd: u64 = io.create((&p_conf[0 as usize]) as u64)
    if ulib.bad(fd) {
        return false
    }
    var line: u64 = (&line_extend[0 as usize]) as u64
    if mirror {
        line = (&line_mirror[0 as usize]) as u64
    }
    let len: u64 = ulib.length(line)
    let g: u64 = io.write_all(fd, line, len)
    io.close(fd)
    return !ulib.bad(g) && g >= len
}

fn current_mirror() -> bool {
    return wlibc.display_mode_mirrored()
}

fn connected() -> u64 {
    return wlibc.display_mode_connected()
}

fn apply_saved() -> bool {
    if wlibc.display_mode_connected() < 2 {
        return false
    }
    let want: bool = saved_mirror()
    if want == wlibc.display_mode_mirrored() {
        return true
    }
    return wlibc.display_mode_set(want)
}
