const K_CMD: u64 = 80 // r402: the command bar, 80..85 (new folder, cut, copy, paste, rename, delete)

const MBH: u64 = 28
const CH: u64 = 36
const STH: u64 = 24
const ROWH: u64 = 28
const BW0: u64 = 760
const BH0: u64 = 520
const NONE_ROW: u64 = 4294967295

