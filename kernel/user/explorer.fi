static mut g_ykrume: u64 = 0
// RUNDE ALLTAG: die Reiterleiste hat eine eigene Zeile zwischen den
// Brosamen und dem Inhalt.
static mut g_yreiter: u64 = 0
static mut g_horte: u64 = 0
static mut g_hbaum: u64 = 0
static mut g_binh: u64 = 0

// RUNDE EXPLORER-2, Pflichtpunkt 5: DIE BREITE DER ZEIT-SPALTE WIRD
// GEMESSEN UND NICHT GERATEN.
//
// Hier standen 186/80/76/108. 76 Bildpunkte reichen fuer "2026-09-"
// und nicht fuer die volle Zeitangabe -- die Spalte war gefuellt, und
// man konnte sie trotzdem nicht lesen (erste Aufnahme dieser Runde,
// gemessen bei 1280x800). Gemessen wird jetzt mit derselben Schrift,
// in der gemalt wird, und an einer Zeichenkette, die
// `expmodell.zeit_text` selbst erzeugt -- so kann das Muster nicht von
// dem abweichen, was in der Spalte steht. Die Probe wird nie gemalt;
// sichtbarer Text kommt weiterhin nur aus dem Katalog.
fn columns_set(tbreite: u64) {
    var probe: [u8; 32] = [0 as u8; 32]
    // Ein fester Zeitpunkt (1893456000 Sekunden = 2030-01-01 UTC):
    // die laengste Form der Ausgabe, vierstelliges Jahr und Uhrzeit.
    let pp: u64 = expmodell.time_text(1893456000,
        (&probe[0 as usize]) as u64)
    let wz: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), pp,
        ulib.length(pp)) / fuiscene.scale()
    let luft: u64 = wlibc.metric(wlibc.M_PAD_X) / fuiscene.scale()
    // Die Bildlaufleiste einer Tabelle ist 16 breit (wlib.fi, Zweig
    // "die Bildlaufleiste?" in `on_down`), dazu der Einzug der Zellen.
    let leiste: u64 = 16
    let w_zeit: u64 = wz + luft
    // Rechte sind zehn Zeichen, Groessen hoechstens acht -- an
    // derselben Probe gemessen, damit alle drei mit der Schrift wachsen.
    let w_recht: u64 = wz * 10 / 16 + luft
    let w_gr: u64 = wz * 8 / 16 + luft
    var w_name: u64 = 0
    if tbreite > leiste + w_zeit + w_recht + w_gr {
        w_name = tbreite - leiste - w_zeit - w_recht - w_gr
    }
    // Der Name bekommt den Rest, aber nie weniger als die Zeit-Spalte:
    // ein Dateimanager, in dem der Name die schmalste Spalte ist, zeigt
    // eine Liste von Auslassungspunkten.
    if w_name < w_zeit {
        w_name = w_zeit
    }
    spalten[(0) as usize] = w_name
    spalten[(1) as usize] = w_gr
    spalten[(2) as usize] = w_zeit
    spalten[(3) as usize] = w_recht
}

// ============================ RUNDE EXPLORER-2: DIE ZWEITE ANSICHT
//
// LISTE ODER SYMBOLE (Pflichtpunkt 10). Die Symbolansicht ist EIN
// Bedienelement mehr und kein zweites Programm: dieselbe Ordnung,
// dieselben Symbole wie in der Tabelle, nur ohne Spalten -- Name und
// Sinnbild, gross genug zum Zeigen. Sie liegt im selben Kasten wie die
// Tabelle; sichtbar ist immer genau eine von beiden.
//
// Gemessene Grenze: 512 Zeilen und 16 KiB Namen. Was darueber liegt,
// wird GEZAEHLT und in der Meldung gesagt -- die Tabelle zeigt in dem
// Fall ohnehin mehr, und sie ist einen Menuepunkt entfernt.
const SYMMAX: u64 = 512
static mut symansicht: u64 = 0
static mut a_sym: u64 = 0xFFFFFFFFFFFFFFFF
static mut symblob: [u8; 16384] = [0 as u8; 16384]
static mut symicons: [u64; 512] = [0 as u64; 512]
static mut sym_weg: u64 = 0
static mut s_lz1: [u8; 2] = " \0"

fn symbolansicht_bauen() {
    var sp: u64 = 0
    var z: u64 = 0
    sym_weg = 0
    let n: u64 = m_anzahl()
    while z < n {
        let e: u64 = m_ord(z)
        let name: u64 = m_name(e)
        let len: u64 = ulib.length(name)
        if z >= SYMMAX || sp + len + 2 >= 16380 {
            sym_weg = sym_weg + 1
        } else {
            if vmodus == 0 {
                symicons[(z) as usize] = expmodell.icon_for(e)
            } else {
                symicons[(z) as usize] = icon_for(e)
            }
            var k: u64 = 0
            while k < len {
                symblob[(sp) as usize] = *((name + k) as *mut u8)
                sp = sp + 1
                k = k + 1
            }
            symblob[(sp) as usize] = 10 as u8
            sp = sp + 1
        }
        z = z + 1
    }
    symblob[(sp) as usize] = 0 as u8
}

// ============================ RUNDE EXPLORER-2: ORTE UND BROSAMEN
//
// Beide Listen kommen aus `exporte` und werden hier nur ANGEZEIGT:
// die Orte als Zeilen einer `wlib`-Liste, der Weg als eine Reihe
// Knoepfe. Die Rueckgabewerte von `orte_bauen`/`krume_bauen` wurden
// bis hierher in `_no`/`_nk` weggeworfen -- gezeigt hat sie niemand.

// Auf einen Ort springen. Kopfzeilen ("Orte", "Datentraeger") sind
// keine Ziele -- sie haben keinen Pfad, und ein Sprung ins Leere waere
// schlimmer als ein Klick, der nichts tut.
// ====================================== RUNDE HOTPLUG
// AUSWERFEN, UND WARUM DAS NICHT DASSELBE IST WIE AUSHAENGEN.
//
// `umount` nimmt eine Einhaengung aus der Tafel. Auswerfen heisst:
// ERST alles Ausstehende auf das Geraet schreiben, DANN aushaengen,
// und NEIN sagen, solange jemand eine Datei darauf offen hat. Der
// Unterschied ist der zwischen einer Datei, die ankommt, und einer,
// die halb ankommt -- und weil er unsichtbar ist, wenn alles gutgeht,
// steht er hier ausgeschrieben.
//
// Die Arbeit macht der Kern (Aufruf 1704, WX_EJECT ->
// `wechsel.auswerfen`). Dieses Programm sucht nur das Ziel und sagt,
// was herauskam -- und zwar IN DER STATUSZEILE und nicht auf der
// seriellen Leitung: der Mensch vor dem Schirm liest keine Logdatei.
//
// DREI ANTWORTEN, und jede hat ihren eigenen Satz:
//   0   ausgeworfen, der Stick darf jetzt heraus
//   16  E_BUSY -- es ist noch etwas offen. KEIN Fehler, sondern eine
//       Bitte: Programm schliessen und noch einmal.
//   *   sonst: fehlgeschlagen, mit der Zahl.
fn auswerfen_klick(baum: u64, tab: u64, stat: u64, fpfad: u64) {
    var s_a: [u8; 17] = "explorer: eject \0"
    var s_rc: [u8; 5] = " rc=\0"
    // Kein Ziel: nichts tun und es sagen. Ein Knopf, der bei leerer
    // Auswahl irgendeinen Traeger wirft, ist eine Falle.
    if ort_wahl >= exporte.places_num()
        || !exporte.place_is_carrier(ort_wahl) {
        stat_set(msg.get((&k_ausnone[0 as usize]) as u64))
        say((&s_a[0 as usize]) as u64)
        sayn(999)
        nl()
        return
    }
    let ziel: u64 = exporte.place_path(ort_wahl)
    if ziel == 0 {
        return
    }
    // WELCHER TRAEGER IST DAS? Die Tafel des Kerns kennt Pfade; die
    // Seitenleiste kennt denselben Pfad. Also wird verglichen, statt
    // eine Nummer zu raten.
    var i: u64 = 0
    var tr: u64 = ulib.WX_MAX
    while i < ulib.WX_MAX {
        var pf: [u8; 24] = [0 as u8; 24]
        var n: u64 = 0
        while n < 23 {
            let c: u64 = ulib.sys(ulib.SYS_WECHSEL, ulib.WX_PATHCH, i, n)
            pf[n as usize] = c as u8
            if c == 0 {
                n = 23
            } else {
                n = n + 1
            }
        }
        pf[23] = 0 as u8
        if ulib.streq((&pf[0 as usize]) as u64, ziel) {
            tr = i
            i = ulib.WX_MAX
        } else {
            i = i + 1
        }
    }
    if tr >= ulib.WX_MAX {
        stat_set(msg.get((&k_ausnone[0 as usize]) as u64))
        return
    }
    let rc: u64 = ulib.sys(ulib.SYS_WECHSEL, ulib.WX_EJECT, tr, 0)
    say((&s_a[0 as usize]) as u64)
    say(ziel)
    kv((&s_rc[0 as usize]) as u64, rc)
    nl()
    if rc == 0 {
        stat_set(msg.get((&k_ausok[0 as usize]) as u64))
        // Der Traeger ist weg: die Seitenleiste MUSS das zeigen, und
        // zwar jetzt und nicht beim naechsten Klick.
        ort_wahl = 0xFFFFFFFFFFFFFFFF
        orte_anzeigen()
        // Stand der Mensch AUF dem ausgeworfenen Traeger, steht er
        // jetzt auf einem Pfad, den es nicht mehr gibt. Also zurueck
        // zur Wurzel -- ein Fenster, das ins Leere zeigt, ist
        // schlimmer als eines, das umschaltet.
        if ulib.length((&pfad[0 as usize]) as u64) >= ulib.length(ziel)
            && vergleich_anfang((&pfad[0 as usize]) as u64, ziel) {
            pfad[0] = 47 as u8
            pfad[1] = 0 as u8
            hist_push((&pfad[0 as usize]) as u64)
        }
        new_read(baum, tab, stat, fpfad)
        return
    }
    if rc == 16 {
        stat_set(msg.get((&k_ausbusy[0 as usize]) as u64))
        return
    }
    stat_set(msg.get((&k_ausfail[0 as usize]) as u64))
}

// Faengt `a` mit `b` an? Fuer die Frage, ob der aktuelle Ort auf dem
// Traeger liegt, den es gleich nicht mehr gibt.
fn vergleich_anfang(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while true {
        let cb: u64 = (__mmio_read8((b + i) as *mut u8)) as u64
        if cb == 0 {
            return true
        }
        let ca: u64 = (__mmio_read8((a + i) as *mut u8)) as u64
        if ca != cb {
            return false
        }
        i = i + 1
    }
    return true
}

fn place_walk(zeile: u64, baum: u64, tab: u64, stat: u64, fpfad: u64) {
    var s_g: [u8; 21] = "explorer: ortsprung \0"
    if zeile >= exporte.places_num() {
        return
    }
    if exporte.place_is_header(zeile) {
        return
    }
    let ziel: u64 = exporte.place_path(zeile)
    if ziel == 0 || (*((ziel) as *mut u8)) == 0 as u8 {
        return
    }
    vmodus = 0
    ulib.strncpy((&pfad[0 as usize]) as u64, ziel, 126)
    hist_push((&pfad[0 as usize]) as u64)
    new_read(baum, tab, stat, fpfad)
    say((&s_g[0 as usize]) as u64)
    say((&pfad[0 as usize]) as u64)
    nl()
}

// ================================== RUNDE EXPLORER-2: DIE KUERZEL
//
// WAS EINE TASTE HIER TUT, TUT SIE UEBER `expakt` -- nicht daneben.
// Der Tastenblock ist die EINZIGE Stelle, an der aus einem Kuerzel
// eine Tat wird; die Tat selbst (Ablage, Einfuegen, Umbenennen,
// Rueckgaengig) steht in `expakt.fi` und wird von Menue, Kontextmenue
// und Taste gleichermassen gerufen. Drei Wege, eine Umsetzung.
//
// DIE STEUEROKTETTE SIND GEMESSEN, nicht geraten: `kernel/kbd.fi`
// bildet Strg+Buchstabe auf die unteren fuenf Bit ab (Strg+A = 1,
// Strg+Z = 26). Die zwei Ausnahmen -- Strg+H und Strg+N -- kommen als
// `ESC [ 30/31 ; 5 ~` und haben in `wlib` eigene Nummern, weil 8 der
// Ruecklauf und 14 die Pfeiltaste hoch ist.
const T_STRG_A: u64 = 1
const T_STRG_C: u64 = 3
const T_STRG_F: u64 = 6
const T_STRG_L: u64 = 12
const T_STRG_V: u64 = 22
const T_STRG_X: u64 = 24
const T_STRG_Z: u64 = 26
// RUNDE ALLTAG: Strg+T oeffnet einen Reiter, Strg+W schliesst ihn --
// dieselben Tasten wie in jedem Browser und im Windows-Explorer. Die
// Zahlen sind die Steuerzeichen: Strg+<Buchstabe> ist der Buchstabe
// minus 64, also T=84-64=20 und W=87-64=23.
const T_STRG_T: u64 = 20
const T_STRG_W: u64 = 23

static mut k_errtit: [u8; 19] = "explorer.err.title\0"
static mut k_konftit: [u8; 24] = "explorer.conflict.title\0"
static mut k_konfbtn: [u8; 26] = "explorer.conflict.buttons\0"
static mut k_konfask: [u8; 22] = "explorer.conflict.ask\0"
static mut k_proptit: [u8; 20] = "explorer.prop.title\0"
static mut k_filter: [u8; 16] = "explorer.filter\0"
static mut k_medit: [u8; 19] = "explorer.menu.edit\0"
static mut k_mgo: [u8; 17] = "explorer.menu.go\0"
static mut k_newfile: [u8; 17] = "explorer.newfile\0"
static mut k_newfname: [u8; 22] = "explorer.newfile.name\0"
static mut k_owtit: [u8; 24] = "explorer.openwith.title\0"
static mut k_delperm: [u8; 29] = "explorer.confirm_delete_perm\0"
static mut k_mtitel: [u8; 16] = "wlib.menu.title\0"

// Woher der Konflikt kam, damit die Antwort des Vierfachdialogs die
// abgebrochene Tat WIEDERHOLEN kann: 1 = Einfuegen, 2 = Umbenennen.
static mut kfl_op: u64 = 0
static mut kfl_alt: [u8; 256] = [0 as u8; 256]
static mut kfl_neu: [u8; 128] = [0 as u8; 128]
// Der Filtertext (Strg+F) -- er muss statisch liegen, weil `expmodell`
// den Zeiger behaelt und bei jedem Lesen erneut hineinschaut.
static mut fbuf: [u8; 64] = [0 as u8; 64]

fn eintraege(p: u64) -> u64 {
    if p == 0 {
        return 0
    }
    var n: u64 = 0
    var k: u64 = 0
    var offen: bool = false
    while (*((p + k) as *mut u8)) != 0 as u8 {
        if (*((p + k) as *mut u8)) == 10 as u8 {
            n = n + 1
            offen = false
        } else {
            offen = true
        }
        k = k + 1
    }
    if offen {
        n = n + 1
    }
    return n
}

// Der volle Pfad einer ANSICHTSZEILE. Ueber `m_ord`/`m_name`, denn die
// Zeile ist nicht der Eintrag: dazwischen liegt die Sortierung.
fn full_from(zeile: u64) -> u64 {
    if zeile >= m_anzahl() {
        return 0
    }
    return join((&pfad[0 as usize]) as u64, m_name(m_ord(zeile)))
}

// DIE GANZE AUSWAHL, nicht die eine Zeile. `wlib.sel_hat` fragt das
// Bitfeld ab, das `neu_lesen` angemeldet hat; ist nichts markiert,
// gilt die Zeile unter dem Zeiger -- so wie in jedem Dateimanager.
fn select_list(tab: u64) -> u64 {
    var s_sel: [u8; 15] = "explorer: sel \0"
    var s_n: [u8; 3] = "n=\0"
    var s_a: [u8; 7] = "anker=\0"
    expakt.list_clear()
    var n: u64 = 0
    var z: u64 = 0
    let int: u64 = m_anzahl()
    while z < int {
        if fuiscene.table_sel_has(cur_key(), z) {
            if expakt.list_add(full_from(z)) {
                n = n + 1
            }
        }
        z = z + 1
    }
    if n == 0 {
        let v: u64 = cur_row()
        if v < int {
            if expakt.list_add(full_from(v)) {
                n = 1
            }
        }
    }
    say((&s_sel[0 as usize]) as u64)
    kv((&s_n[0 as usize]) as u64, n)
    kv((&s_a[0 as usize]) as u64, cur_row())
    nl()
    return n
}

// KEIN STUMMER FEHLSCHLAG (Pflichtpunkt 8). Jede Nummer ungleich null
// wird zu einem Schluessel aus `explorer.err.*` und zu einem Fenster;
// der Satz steht im Katalog und in beiden Sprachen.
fn error_show(rc: u64) -> bool {
    var s_f: [u8; 21] = "explorer: fehler rc=\0"
    var s_k: [u8; 6] = " key=\0"
    if rc == 0 {
        return false
    }
    let schl: u64 = expakt.error_key(rc)
    say((&s_f[0 as usize]) as u64)
    sayn(rc)
    say((&s_k[0 as usize]) as u64)
    say(schl)
    nl()
    // EIN HINWEIS FRAGT NICHTS. Hier stand `dlg_ask` -- der Dialog mit
    // "Ja" und "Nein"; auf die Mitteilung "Kein Platz mehr auf dem
    // Datentraeger" ist keine der beiden Antworten eine. `dlg_hinweis`
    // (Runde EXPLORER-2, wlib.fi) hat genau einen Knopf.
    let _d: u64 = dlg_hinweis(msg.get((&k_errtit[0 as usize]) as u64),
        msg.get(schl))
    return true
}

// DER KONFLIKTDIALOG MIT VIER WAHLMOEGLICHKEITEN. Ein `wlib`-Dialog
// hat zwei Knoepfe, der Katalog verlangt vier Antworten -- also ein
// Fenster mit vier Zeilen, und die Reihenfolge ist die des Katalogs
// (Ersetzen, Umbenennen, Ueberspringen, Abbrechen = K_* 0..3).
fn conflict_show(besitzer: u64) -> bool {
    var s_k: [u8; 20] = "explorer: konflikt \0"
    if !expakt.konflikt_da() {
        return false
    }
    let _b: u64 = besitzer
    // VIER KNOEPFE IN DER ORDNUNG DES KATALOGS: Ersetzen, Umbenennen,
    // Ueberspringen, Abbrechen -- genau `expakt.K_ERSETZEN` ..
    // `K_ABBRUCH` (0..3). Bis hierher war das ein Aufklappmenue an der
    // Mausstelle; eine FRAGE mit vier Antworten ist aber ein Dialog,
    // und `wlib.dlg_wahl` (Runde EXPLORER-2) kann ihn seit dieser
    // Runde stellen. Der Block kommt aus dem Katalog, wie er dasteht.
    let _d: u64 = dlg_wahl(msg.get((&k_konftit[0 as usize]) as u64),
        msg.get((&k_konfask[0 as usize]) as u64),
        msg.get((&k_konfbtn[0 as usize]) as u64), 4)
    say_dlgrect()
    say((&s_k[0 as usize]) as u64)
    say(expakt.conflict_path())
    nl()
    return true
}

// EINFUEGEN, und zwar ueber `expakt`: im selben Datentraeger benennt
// es um, sonst kopiert es Block fuer Block. Bei einem belegten Namen
// kommt der Vierfachdialog, und die Antwort wiederholt die Tat.
fn paste_do(besitzer: u64, baum: u64, tab: u64, stat: u64,
    fpfad: u64) -> u64 {
    var s_p: [u8; 17] = "explorer: paste \0"
    var s_n: [u8; 3] = "n=\0"
    var s_rc: [u8; 4] = "rc=\0"
    kfl_op = 1
    let rc: u64 = expakt.einfuegen((&pfad[0 as usize]) as u64)
    say((&s_p[0 as usize]) as u64)
    kv((&s_n[0 as usize]) as u64, expakt.clipboard_num())
    kv((&s_rc[0 as usize]) as u64, rc)
    nl()
    new_read(baum, tab, stat, fpfad)
    if conflict_show(besitzer) {
        return 9
    }
    let _f: bool = error_show(rc)
    return 0
}

// UMBENENNEN UEBER `io.rename` (Pflichtpunkt 2). Der alte Weg --
// kopieren und loeschen -- hat einen Ordner nicht mitgenommen, sondern
// verloren; er steht nicht mehr in dieser Datei.
fn rename_do(besitzer: u64, alt: u64, neu: u64, baum: u64, tab: u64,
    stat: u64, fpfad: u64) -> u64 {
    ulib.strncpy((&kfl_alt[0 as usize]) as u64, alt, 250)
    ulib.strncpy((&kfl_neu[0 as usize]) as u64, neu, 120)
    kfl_op = 2
    let rc: u64 = expakt.umbenennen((&kfl_alt[0 as usize]) as u64,
        (&kfl_neu[0 as usize]) as u64)
    new_read(baum, tab, stat, fpfad)
    if conflict_show(besitzer) {
        return 9
    }
    let _f: bool = error_show(rc)
    return 0
}

// Die Antwort auf den Vierfachdialog: merken und die abgebrochene Tat
// noch einmal versuchen -- `expakt` verbraucht die Wahl dabei.
fn conflict_reply(wahl: u64, besitzer: u64, baum: u64, tab: u64,
    stat: u64, fpfad: u64) -> u64 {
    expakt.conflict_reply(wahl)
    if wahl == expakt.K_ABBRUCH {
        return 0
    }
    if kfl_op == 2 {
        return rename_do(besitzer, (&kfl_alt[0 as usize]) as u64,
            (&kfl_neu[0 as usize]) as u64, baum, tab, stat, fpfad)
    }
    return paste_do(besitzer, baum, tab, stat, fpfad)
}

// ====================================== DER TASTENBLOCK (Punkt 7)
//
// Rueckgabe: (offen << 8) | wartet -- `offen` sagt, welches Menue
// aufgeklappt ist, `wartet` sagt, worauf ein Dialog wartet. Beides
// gehoert der Ereignisschleife; hier wird es nur ausgerechnet.
fn key_block(taste: u64, baum: u64, tab: u64, stat: u64,
    fpfad: u64) -> u64 {
    var s_t: [u8; 17] = "explorer: taste \0"
    var s_n: [u8; 3] = "n=\0"
    var s_rc: [u8; 4] = "rc=\0"
    var s_art: [u8; 5] = "art=\0"
    var s_an: [u8; 4] = "an=\0"
    if taste == T_STRG_C || taste == T_STRG_X {
        let n: u64 = select_list(tab)
        var schnitt: bool = false
        if taste == T_STRG_X {
            schnitt = true
        }
        let rc: u64 = expakt.copy_remember(schnitt)
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        say((&s_lz1[0 as usize]) as u64)
        kv((&s_n[0 as usize]) as u64, n)
        kv((&s_rc[0 as usize]) as u64, rc)
        nl()
        let _f: bool = error_show(rc)
        return 0
    }
    if taste == T_STRG_V {
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        say((&s_lz1[0 as usize]) as u64)
        kv((&s_n[0 as usize]) as u64, expakt.clipboard_num())
        nl()
        return paste_do(tab, baum, tab, stat, fpfad)
    }
    if taste == T_STRG_A {
        fuiscene.table_sel_all(cur_key())
        rfr()
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        say((&s_lz1[0 as usize]) as u64)
        kv((&s_n[0 as usize]) as u64, fuiscene.table_sel_num(cur_key()))
        nl()
        return 0
    }
    if taste == T_STRG_Z {
        let art: u64 = expakt.undo_art()
        let rc: u64 = expakt.rueckgaengig()
        new_read(baum, tab, stat, fpfad)
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        say((&s_lz1[0 as usize]) as u64)
        kv((&s_art[0 as usize]) as u64, art)
        kv((&s_rc[0 as usize]) as u64, rc)
        nl()
        let _f: bool = error_show(rc)
        return 0
    }
    if taste == wlib.KEY_F2 {
        let z: u64 = cur_row()
        if z >= m_anzahl() {
            return 0
        }
        ulib.strncpy((&dlgpuffer[0 as usize]) as u64, m_name(m_ord(z)), 120)
        let _d: u64 = dlg_entry(msg.get((&k_rename[0 as usize]) as u64),
            msg.get((&k_name[0 as usize]) as u64),
            (&dlgpuffer[0 as usize]) as u64)
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        say(m_name(m_ord(z)))
        nl()
        return 1
    }
    if taste == wlib.KEY_OLD_ENTER {
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        nl()
        return props_show(tab, tab) << 8
    }
    if taste == wlib.KEY_F5 {
        // RUNDE HOTPLUG-2: F5 liest auch die ORTE neu, nicht nur den
        // Ordner. Der Knopf "Aktualisieren" tut beides (`orte_anzeigen`
        // + `new_read`); dass dieselbe Taste weniger tat als der Knopf
        // daneben, war ein Unterschied ohne Grund -- und er hat die
        // Bildläufe der Vorrunde gekostet, die mit F5 auf einen Stick
        // in der Leiste warteten.
        orte_anzeigen()
        new_read(baum, tab, stat, fpfad)
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        nl()
        return 0
    }
    if taste == wlib.KEY_OLD_UP || taste == wlib.KEY_BS {
        eltern((&pfad[0 as usize]) as u64)
        hist_push((&pfad[0 as usize]) as u64)
        new_read(baum, tab, stat, fpfad)
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        say((&s_lz1[0 as usize]) as u64)
        say((&pfad[0 as usize]) as u64)
        nl()
        return 0
    }
    if taste == wlib.KEY_OLD_LEFT {
        if hist_at > 1 {
            hist_at = hist_at - 1
            ulib.strcpy((&pfad[0 as usize]) as u64, hist_get(hist_at - 1))
            new_read(baum, tab, stat, fpfad)
        }
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        say((&s_lz1[0 as usize]) as u64)
        kv((&s_n[0 as usize]) as u64, hist_at)
        nl()
        return 0
    }
    if taste == wlib.KEY_OLD_RIGHT {
        if hist_at < hist_n {
            hist_at = hist_at + 1
            ulib.strcpy((&pfad[0 as usize]) as u64, hist_get(hist_at - 1))
            new_read(baum, tab, stat, fpfad)
        }
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        say((&s_lz1[0 as usize]) as u64)
        kv((&s_n[0 as usize]) as u64, hist_at)
        nl()
        return 0
    }
    if taste == wlib.KEY_CTRL_H {
        expmodell.setz_versteckt(!expmodell.versteckt())
        new_read(baum, tab, stat, fpfad)
        var an: u64 = 0
        if expmodell.versteckt() {
            an = 1
        }
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        say((&s_lz1[0 as usize]) as u64)
        kv((&s_an[0 as usize]) as u64, an)
        nl()
        return 0
    }
    if taste == T_STRG_F {
        ulib.strncpy((&dlgpuffer[0 as usize]) as u64,
            (&fbuf[0 as usize]) as u64, 60)
        let _d: u64 = dlg_entry(msg.get((&k_filter[0 as usize]) as u64),
            msg.get((&k_filter[0 as usize]) as u64),
            (&dlgpuffer[0 as usize]) as u64)
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        nl()
        return 6
    }
    if taste == wlib.KEY_CTRL_N {
        let _d: u64 = dlg_entry(msg.get((&k_newdir[0 as usize]) as u64),
            msg.get((&k_name[0 as usize]) as u64), 0)
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        nl()
        return 2
    }
    if taste == wlib.KEY_DEL {
        let n: u64 = select_list(tab)
        if n == 0 {
            return 0
        }
        let _d: u64 = dlg_ask(msg.get((&k_deltit[0 as usize]) as u64),
            msg.get((&k_del[0 as usize]) as u64))
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        say((&s_lz1[0 as usize]) as u64)
        kv((&s_n[0 as usize]) as u64, n)
        nl()
        return 3
    }
    if taste == wlib.KEY_SDEL {
        let n: u64 = select_list(tab)
        if n == 0 {
            return 0
        }
        let _d: u64 = dlg_ask(msg.get((&k_rename[0 as usize]) as u64),
            msg.get((&k_delperm[0 as usize]) as u64))
        say((&s_t[0 as usize]) as u64)
        sayn(taste)
        say((&s_lz1[0 as usize]) as u64)
        kv((&s_n[0 as usize]) as u64, n)
        nl()
        return 5
    }
    return 0
}

// ------------------------------------------------------------- Programm

// Den Starter aufmachen -- ein eigenes Programm, ein eigenes Fenster.
fn launcher_open() {
    var pfad2: [u8; 17] = "/bin/launcher\0\0\0\0"
    var s_go: [u8; 25] = "explorer: launcher pid=\0\0"
    // RUNDE TUERSCHLOSS: SYS_EXEC statt SYS_SPAWN -- Begruendung in
    // launcher.fi an der gleichen Stelle. Ein Pfad ist keine Programmnummer.
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&pfad2[0 as usize]) as u64,
        0, 0)
    say((&s_go[0 as usize]) as u64)
    sayn(pid)
    nl()
}

// RUNDE EXPLORER-2, Pflichtpunkt 5: DER BEFUND ZUR ZEIT-SPALTE.
//
// Die Spalte zeigte "--", und die Frage war, an welcher der drei
// Stellen es haengt: an `expmodell.tabelle_bauen` (schreibt es die
// Zeichenkette ueberhaupt in die dritte Spalte?), an `zeit_text`
// (rechnet es die Ortszeit?) oder an `stat` selbst. Gemessen: die
// ersten beiden sind in Ordnung -- `tabelle_bauen` setzt `zeit_text`
// zwischen das zweite und dritte Tabulatorzeichen. Null kommt aus dem
// ABBILD: `mkfs.py` legt ohne `--v3` eine Platte der Fassung 2 an, und
// `fs.inode_mtime` gibt dort ausdruecklich 0 zurueck (kernel/fs.fi:707).
// Darum sagt diese Zeile bei jedem Verzeichniswechsel, wie viele der
// Eintraege eine echte Zeit haben und welche die erste ist -- damit die
// Abnahme "--" nicht mit einem Fehler im Dateimanager verwechselt.
fn report_time() {
    var s_z: [u8; 16] = "explorer: zeit \0"
    var s_m: [u8; 7] = "mtime=\0"
    var s_e: [u8; 5] = "mit=\0"
    var s_v: [u8; 5] = "von=\0"
    var s_o: [u8; 7] = "tzoff=\0"
    if vmodus != 0 {
        return
    }
    var mit: u64 = 0
    var first: u64 = 0
    var i: u64 = 0
    let n: u64 = m_anzahl()
    while i < n {
        let t: u64 = expmodell.mtime_at(expmodell.ord_at(i))
        if t != 0 {
            mit = mit + 1
            if first == 0 {
                first = t
            }
        }
        i = i + 1
    }
    say((&s_z[0 as usize]) as u64)
    kv((&s_m[0 as usize]) as u64, first)
    kv((&s_e[0 as usize]) as u64, mit)
    kv((&s_v[0 as usize]) as u64, n)
    kv((&s_o[0 as usize]) as u64, expmodell.time_offset())
    nl()
}

// RUNDE SYSTEMBUS: den vollen Pfad der Zeile auf den Ziehplatz UND in
// die Zwischenablage legen. Beides, weil es beides ist: ein Pfad, den
// man ziehen kann, ist derselbe Pfad, den man einfuegen kann -- ein
// Modell, drei Nutzer.
fn ziehen(zeile: u64) {
    if zeile >= m_anzahl() {
        return
    }
    let e: u64 = m_ord(zeile)
    // NICHT `nptr(e)`: das ist der Name aus dem KLEINEN Modell dieser
    // Datei (Sicherungsansicht). Im Normalfall kommt der Eintrag aus
    // `expmodell`, und `nptr` zeigt dann auf einen leeren Platz --
    // gezogen und kopiert wurde bis hier ein Pfad ohne Dateinamen.
    let full: u64 = join((&pfad[0 as usize]) as u64, m_name(e))
    let n: u64 = ulib.length(full)
    let _d: u64 = wlib.drag_put(wlib.CT_PATH | wlib.CT_TEXT, full, n)
    let _c: u64 = wlib.clip_put_typ(wlib.CT_PATH | wlib.CT_TEXT, full, n)
    var s_zg: [u8; 12] = "expl: zieh \0"
    say((&s_zg[0 as usize]) as u64)
    say(full)
    nl()
}

// ======================================================= RUNDE CLIP-2
//
// DAS ANDERE ENDE DER ZIEHBEWEGUNG: HIER WIRD ABGELEGT.
//
// Bis zu dieser Runde war der Dateimanager nur QUELLE -- `ziehen` legte
// den Pfad auf den Bus, und der Editor nahm ihn (`edit.fi`). Ein Ziel
// gab es nicht: wer eine Datei auf einen Ordner zog, bei dem geschah
// nichts, und im Bild sah das aus wie ein Programm, das den Zug nicht
// bemerkt. Bemerkt hat ihn niemand, weil `wlib` das Loslassen nicht
// weitergab; das ist die Naht, die diese Runde zugemacht hat
// (`wlib.K_DROP`).
//
// WOHIN ABGELEGT WIRD -- und das ist die eigentliche Entscheidung:
//
//   auf einen ORDNER in der Tabelle  ->  in diesen Ordner hinein
//   auf eine Datei oder ins Leere    ->  in den ANGEZEIGTEN Ordner
//
// Auf eine Datei zu zielen und sie damit zu treffen, waere ein
// Fehlgriff mit Folgen; jeder andere Dateimanager legt dann daneben,
// also in den Ordner, der offen ist.
//
// VERSCHOBEN WIRD UND NICHT KOPIERT, und zwar durch `expakt.einfuegen`
// -- dieselbe Funktion, die Strg+V benutzt. Sie haengt auf demselben
// Datentraeger den Verzeichniseintrag mit `io.rename` um (P-018), statt
// Oktette zu bewegen. Ein zweiter Weg, der dasselbe noch einmal tut,
// waere ein zweiter Ort fuer denselben Fehler.
//
// WAS NICHT GESCHIEHT: eine Datei auf SICH SELBST oder in den Ordner
// abzulegen, in dem sie schon liegt, tut nichts. Ohne diese Frage
// laege gleicher Quell- und Zielpfad vor, und `einfuegen` traefe auf
// einen belegten Namen -- der Konfliktdialog fuer eine Tat, die
// niemand wollte.
fn ablegen(zeile: u64, baum: u64, tab: u64, stat: u64, fpfad: u64) -> u64 {
    var s_dr: [u8; 13] = "expl: drop \0\0"
    var s_z: [u8; 3] = "z=\0"
    var s_rc: [u8; 4] = "rc=\0"
    var s_q: [u8; 4] = " q=\0"
    // In einer Sicherung liegt keine Datei, sondern ein Eintrag in
    // einer Textdatei -- dorthin laesst sich nichts ablegen.
    if vmodus != 0 {
        return 0
    }
    // DEN PFAD VOM ZIEHPLATZ, und nur wenn es wirklich ein PFAD ist.
    // Ein Ziehen mit blossem Text ist keine Datei; wer ihn trotzdem
    // einfuegte, legte eine Datei mit einem Satz als Namen an.
    var zp: [u8; 200] = [0 as u8; 200]
    if !ulib.drag_an() {
        return 0
    }
    if ulib.drag_type_path() == 0 {
        return 0
    }
    let zn: u64 = ulib.drag_take((&zp[0 as usize]) as u64, 198)
    if zn == 0 {
        return 0
    }
    zp[(zn) as usize] = 0 as u8
    // DAS ZIEL. Eine Zeile, die ein ORDNER ist, nimmt auf; alles
    // andere legt in den angezeigten Ordner.
    var ziel: [u8; 200] = [0 as u8; 200]
    ulib.strncpy((&ziel[0 as usize]) as u64, (&pfad[0 as usize]) as u64,
        198)
    if zeile < m_anzahl() {
        let e: u64 = m_ord(zeile)
        if m_art(e) != 0 {
            ulib.strncpy((&ziel[0 as usize]) as u64,
                join((&pfad[0 as usize]) as u64, m_name(e)), 198)
        }
    }
    // LIEGT ES SCHON DA? Dann ist das Ablegen erledigt, bevor es
    // anfaengt. Verglichen wird der Ordner der Quelle mit dem Ziel.
    var qdir: [u8; 200] = [0 as u8; 200]
    ulib.strncpy((&qdir[0 as usize]) as u64, (&zp[0 as usize]) as u64, 198)
    eltern((&qdir[0 as usize]) as u64)
    say((&s_dr[0 as usize]) as u64)
    say((&zp[0 as usize]) as u64)
    say((&s_q[0 as usize]) as u64)
    say((&ziel[0 as usize]) as u64)
    if ulib.streq((&qdir[0 as usize]) as u64, (&ziel[0 as usize]) as u64) {
        var s_gl: [u8; 8] = " gleich\0"
        say((&s_gl[0 as usize]) as u64)
        nl()
        let _c: u64 = ulib.drag_drop()
        return 0
    }
    // Die Ablage von `expakt` ist die Liste, die `einfuegen` abarbeitet
    // -- ein Stueck, der gezogene Pfad. `list_add` fuellt die Auswahl,
    // `copy_remember(false)` macht daraus die Ablage (kein Schnitt:
    // beim Ablegen im selben Traeger haengt `einfuegen` ohnehin um).
    drag_liste((&zp[0 as usize]) as u64)
    // ALS SCHNITT, NICHT ALS KOPIE -- und das ist nicht Geschmack,
    // sondern der Unterschied zwischen `rename` und einer neuen Datei.
    //
    // GEMESSEN am 18.09.2026, und der erste Entwurf dieser Runde hatte
    // es falsch: mit `copy_remember(false)` nimmt `expakt.einfuegen`
    // den Zweig `fileop.kopiere` (expakt.fi:505) -- die Datei lag
    // danach ZWEIMAL da, /data/alpha.txt mit Inode 105 und
    // /data/bilder/alpha.txt mit Inode 116. Der Laeufer hat genau das
    // gefunden ("inode anders 104 116"), und ohne die Messung waere es
    // durchgegangen: von aussen sieht eine Kopie am Ziel wie ein
    // gelungenes Verschieben aus.
    //
    // Ziehen und Ablegen VERSCHIEBT im selben Datentraeger -- so macht
    // es jedes andere System, und `ist_schnitt` ist genau der Schalter,
    // der `einfuegen` auf `fileop.verschiebe` und damit auf
    // `io.rename` fuehrt (P-018: der Verzeichniseintrag wird umgehaengt,
    // die Oktette werden nicht angefasst).
    nl()
    let _r: u64 = expakt.copy_remember(true)
    kfl_op = 1
    let rc: u64 = expakt.einfuegen((&ziel[0 as usize]) as u64)
    var s_de: [u8; 13] = "expl: drop* \0"
    say((&s_de[0 as usize]) as u64)
    kv((&s_rc[0 as usize]) as u64, rc)
    kv((&s_z[0 as usize]) as u64, zeile)
    nl()
    // DER ZIEHPLATZ WIRD GELEERT. Eine Ziehbewegung, die angekommen
    // ist, ist zu Ende -- bliebe sie stehen, naehme der naechste
    // Loslasser sie ein zweites Mal an.
    let _c2: u64 = ulib.drag_drop()
    new_read(baum, tab, stat, fpfad)
    if conflict_show(tab) {
        return 9
    }
    let _f: bool = error_show(rc)
    return 0
}

// ====================================================== RUNDE ALLTAG
//
// SICHTBARE RUECKMELDUNG WAEHREND DES ZIEHENS.
//
// Justins Auftrag verlangt sie ausdruecklich: "was haengt am Zeiger,
// welches Ziel ist gerade aktiv". RUNDE CLIP-2 hatte an dieser Stelle
// ausdruecklich NICHTS ("Eine Ziehgrafik unter dem Zeiger gibt es
// NICHT, und das ist hier gesagt statt hinterher entschuldigt").
//
// WARUM ES TROTZDEM KEINE ZIEHGRAFIK UNTER DEM ZEIGER GIBT, und das
// ist eine Messung und keine Bequemlichkeit: ein Programm erfaehrt von
// einer laufenden Ziehbewegung genau ZWEIMAL etwas -- `K_DRAG` beim
// Verlassen der angefassten Zeile und `K_DROP` beim Loslassen. Die
// Bewegung DAZWISCHEN bleibt in `wlib.on_move` und wird nicht
// gemeldet. Ein Bild, das dem Zeiger folgt, braucht aber jede
// Zwischenlage; es liesse sich nur in `wlib` selbst malen, und `wlib`
// gehoert in dieser Runde einem anderen (Territorium, siehe Bericht).
//
// ALSO DIE RUECKMELDUNG DORT, WO SIE OHNE FREMDEN CODE HINGEHOERT:
// in der Statuszeile des Dateimanagers steht, WAS gerade gezogen wird,
// und die angefasste Zeile bleibt hervorgehoben. Das beantwortet die
// erste Haelfte der Frage vollstaendig ("was haengt am Zeiger") und
// die zweite ("welches Ziel") beim Loslassen -- nicht waehrend der
// Fahrt. Was fehlt, steht so im Bericht und wird nicht schoengeredet.
static mut zieh_laeuft: u64 = 0
static mut ziehtext: [u8; 220] = [0 as u8; 220]

// Den Namen des gezogenen Stuecks in die Statuszeile schreiben.
fn zieh_ziel_an(zeile: u64, stat: u64) {
    if zeile >= m_anzahl() {
        return
    }
    let e: u64 = m_ord(zeile)
    var s_zt: [u8; 10] = "Ziehe: \0\0\0"
    var at: u64 = 0
    at = at + ulib.strncpy((&ziehtext[0 as usize]) as u64,
        (&s_zt[0 as usize]) as u64, 16)
    let _n: u64 = ulib.strncpy((&ziehtext[(at) as usize]) as u64,
        m_name(e), 190)
    zieh_laeuft = 1
    stat_set((&ziehtext[0 as usize]) as u64)
}

// Die Hervorhebung wieder wegnehmen. Wird nach JEDEM Ablegen gerufen
// -- auch nach einem, das nichts getan hat: eine Statuszeile, die
// "Ziehe: x" stehen laesst, obwohl nichts mehr gezogen wird, ist eine
// Luege auf dem Schirm.
fn zieh_ziel_aus() {
    zieh_laeuft = 0
    stat_msg = 0
    rfr()
}

// ====================================================== RUNDE ALLTAG
//
// ABLEGEN AUF DER ORTSLEISTE -- UND AUF DEM PAPIERKORB.
//
// RUNDE CLIP-2 hat die Ortsleiste ausdruecklich AUSGENOMMEN, mit der
// Begruendung "ein Ort ist ein Sprungziel und kein Ordner, den dieser
// Zweig kennt". Das stimmt fuer den Sprung, aber nicht fuer die Sache:
// hinter jedem Ort steht ein PFAD (`exporte.place_path`), und ein Pfad
// ist ein Ordner. Genau deshalb ist die Leiste das Ziel, das ein Mensch
// zuerst sucht -- "nach Bilder schieben" heisst, auf Bilder zu ziehen.
//
// DER PAPIERKORB IST DER GRUND, WARUM DIESE FUNKTION EXISTIERT.
// Justins Auftrag nennt ihn beim Namen ("auf den Papierkorb ziehen =
// loeschen"). Er steht seit jeher in der Leiste (`exporte.orte_bauen`),
// und `trash.hinein` kann ihn fuellen -- verbunden war beides nie.
//
// ZWEI WEGE, EINE ENTSCHEIDUNG, und sie faellt an genau einer Stelle:
//
//   Papierkorb  ->  expakt.in_korb   (verschiebt in <wurzel>/.papierkorb
//                                     UND schreibt die .info dazu, damit
//                                     "zurueck" spaeter weiss, woher)
//   jeder Ort   ->  ablegen_pfad     (dieselbe Mechanik wie die Tabelle:
//                                     copy_remember(true) -> einfuegen)
//
// Ein eigener Loeschweg neben `in_korb` waere die zweite Wahrheit --
// dieselbe Falle, die Runde CLIP-2 bei `kopiere`/`verschiebe` gestellt
// hat. Also wird hier NICHTS nachgebaut, sondern gerufen.
fn ablegen_ort(ort: u64, baum: u64, tab: u64, stat: u64, fpfad: u64) -> u64 {
    if vmodus != 0 {
        return 0
    }
    if ort >= exporte.places_num() {
        return 0
    }
    if !exporte.place_droppable(ort) {
        // Eine Ueberschrift oder ein Datentraeger. Der Ziehplatz bleibt
        // stehen: wer daneben trifft, soll es noch einmal versuchen
        // koennen, statt seine Auswahl zu verlieren.
        var s_no: [u8; 20] = "expl: ort nimmt nix\0"
        say((&s_no[0 as usize]) as u64)
        nl()
        return 0
    }
    // DEN PFAD VOM ZIEHPLATZ -- und nur, wenn es wirklich ein Pfad ist.
    var zp: [u8; 200] = [0 as u8; 200]
    if !ulib.drag_an() {
        return 0
    }
    if ulib.drag_type_path() == 0 {
        return 0
    }
    let zn: u64 = ulib.drag_take((&zp[0 as usize]) as u64, 198)
    if zn == 0 {
        return 0
    }
    zp[(zn) as usize] = 0 as u8
    var s_do: [u8; 15] = "expl: droport \0"
    say((&s_do[0 as usize]) as u64)
    say((&zp[0 as usize]) as u64)
    // ------------------------------------------------- der Papierkorb
    if exporte.place_is_trash(ort) {
        var s_tr: [u8; 9] = " -> korb\0"
        say((&s_tr[0 as usize]) as u64)
        nl()
        let rc: u64 = drag_korb((&zp[0 as usize]) as u64)
        let _c: u64 = ulib.drag_drop()
        new_read(baum, tab, stat, fpfad)
        let _f: bool = error_show(rc)
        return 0
    }
    // ------------------------------------------------- jeder andere Ort
    var ziel: [u8; 200] = [0 as u8; 200]
    ulib.strncpy((&ziel[0 as usize]) as u64, exporte.place_path(ort), 198)
    var s_pf: [u8; 5] = " -> \0"
    say((&s_pf[0 as usize]) as u64)
    say((&ziel[0 as usize]) as u64)
    nl()
    return ablegen_pfad((&zp[0 as usize]) as u64, (&ziel[0 as usize]) as u64,
        baum, tab, stat, fpfad)
}

// DER GEMEINSAME RUMPF: einen Pfad in einen Zielordner schieben.
//
// `ablegen` (Tabelle/Baum) und `ablegen_ort` (Ortsleiste) hatten sonst
// zweimal dieselben zwanzig Zeilen -- und damit zwei Orte fuer jeden
// Fehler darin. Das ist genau die Doppelung, gegen die `fuib.fi` im
// Kopf argumentiert; hier wird sie gar nicht erst angelegt.
fn ablegen_pfad(quelle: u64, ziel: u64, baum: u64, tab: u64, stat: u64,
    fpfad: u64) -> u64 {
    // LIEGT ES SCHON DA? Dann ist nichts zu tun. Ohne diese Frage
    // traefe `einfuegen` auf einen belegten Namen und stellte den
    // Konfliktdialog fuer eine Tat, die niemand wollte.
    var qdir: [u8; 200] = [0 as u8; 200]
    ulib.strncpy((&qdir[0 as usize]) as u64, quelle, 198)
    eltern((&qdir[0 as usize]) as u64)
    if ulib.streq((&qdir[0 as usize]) as u64, ziel) {
        var s_gl: [u8; 17] = "expl: ort gleich\0"
        say((&s_gl[0 as usize]) as u64)
        nl()
        let _c: u64 = ulib.drag_drop()
        return 0
    }
    drag_liste(quelle)
    // ALS SCHNITT: verschieben, nicht kopieren -- derselbe Schalter und
    // dieselbe Begruendung wie in `ablegen` (P-018, io.rename).
    let _r: u64 = expakt.copy_remember(true)
    kfl_op = 1
    let rc: u64 = expakt.einfuegen(ziel)
    var s_de: [u8; 18] = "expl: droport rc=\0"
    say((&s_de[0 as usize]) as u64)
    sayn(rc)
    nl()
    let _c2: u64 = ulib.drag_drop()
    new_read(baum, tab, stat, fpfad)
    if conflict_show(tab) {
        return 9
    }
    let _f: bool = error_show(rc)
    return 0
}

fn open(zeile: u64, baum: u64, tab: u64, stat: u64, fpfad: u64,
    marke: u64) {
    if zeile >= m_anzahl() {
        return
    }
    let e: u64 = m_ord(zeile)
    // RUNDE EXPLORER-2, Befund 15-unterordner.png: DER DOPPELKLICK
    // GING INS LEERE.
    //
    // Hier stand `nptr(e)` und weiter unten zweimal `art[e]` -- beides
    // greift in die kleinen Felder DIESER Datei, die nur im
    // Sicherungsmodus gefuellt sind. Ein echtes Verzeichnis kommt seit
    // dieser Runde aus `expmodell`; dort war `art[e]` immer 0, der
    // Zweig "ist ein Ordner" wurde nie genommen, und der Pfad blieb
    // auf /data stehen. Beide Zugriffe gehen jetzt durch die Adapter
    // `m_name`/`m_art`, die wissen, welches Modell gerade gilt.
    let name: u64 = m_name(e)
    // IN EINER SICHERUNG: hineingehen heisst tiefer in den
    // Schnappschuss, nicht auf die Platte.
    if vmodus == 2 {
        if m_art(e) != 0 {
            var sl2: [u8; 2] = "/\0"
            ulib.strcat((&vunter[0 as usize]) as u64,
                (&sl2[0 as usize]) as u64)
            ulib.strcat((&vunter[0 as usize]) as u64, name)
            show_place(fpfad)
            new_read(baum, tab, stat, fpfad)
        }
        return
    }
    // IM SPEICHER: eine Zeile ist eine SICHERUNG.
    if vmodus == 1 {
        vmodus = 2
        ulib.strncpy((&vsicher[0 as usize]) as u64, name, 60)
        vunter[(0) as usize] = 0 as u8
        show_place(fpfad)
        new_read(baum, tab, stat, fpfad)
        return
    }
    if m_art(e) != 0 {
        let full: u64 = join((&pfad[0 as usize]) as u64, name)
        ulib.strncpy((&pfad[0 as usize]) as u64, full, 126)
        // EIN SICHERUNGSSPEICHER SIEHT AUS WIE EIN ORDNER UND IST
        // KEINER. Wer hineingeht, will die Sicherungen sehen und nicht
        // PACK, INDEX und ein paar S-Dateien.
        if bstore.is_store((&pfad[0 as usize]) as u64) {
            vmodus = 1
            ulib.strncpy((&vspeicher[0 as usize]) as u64,
                (&pfad[0 as usize]) as u64, 120)
        }
        hist_push((&pfad[0 as usize]) as u64)
        new_read(baum, tab, stat, fpfad)
        return
    }
    // Eine Datei: sie starten. Ein Programm, das kein Programm ist,
    // wird vom ELF-Lader abgelehnt -- und das ist die richtige Stelle
    // dafuer, nicht eine Namensendung hier.
    let full: u64 = join((&pfad[0 as usize]) as u64, name)
    var arg: [u8; 200] = [0 as u8; 200]
    ulib.strncpy((&arg[0 as usize]) as u64, full, 190)
    // DAILY-DRIVER (r55): a `.pdf` opens in the PDF viewer, the one file
    // association there is (anything else is still started as a program).
    var pdfpid: u64 = 0xFFFFFFFFFFFFFFFF
    let nl: u64 = ulib.length(full)
    if nl > 4 {
        let e1: u64 = (*((full + nl - 4) as *mut u8)) as u64
        let e2: u64 = (*((full + nl - 3) as *mut u8)) as u64 | 32
        let e3: u64 = (*((full + nl - 2) as *mut u8)) as u64 | 32
        let e4: u64 = (*((full + nl - 1) as *mut u8)) as u64 | 32
        if e1 == 46 && e2 == 112 && e3 == 100 && e4 == 102 {
            var pdfprog: [u8; 13] = "/bin/pdfview\0"
            var pdfname: [u8; 8] = "pdfview\0"
            var pdfargv: [u64; 2] = [0 as u64; 2]
            pdfargv[0 as usize] = (&pdfname[0 as usize]) as u64
            pdfargv[1 as usize] = (&arg[0 as usize]) as u64
            pdfpid = ulib.sys(ulib.SYS_EXEC, (&pdfprog[0 as usize]) as u64,
                (&pdfargv[0 as usize]) as u64, 2)
        }
    }
    // RUNDE TUERSCHLOSS: SYS_EXEC statt SYS_SPAWN. Eine Datei aus dem
    // Dateimanager zu starten ging bis hier IMMER mit -22 aus.
    var pid: u64 = pdfpid
    if ulib.bad(pdfpid) {
        pid = ulib.sys(ulib.SYS_EXEC, (&arg[0 as usize]) as u64, 0, 0)
    }
    say(marke)
    say(full)
    var sp: [u8; 8] = " pid=\0\0\0"
    say((&sp[0 as usize]) as u64)
    sayn(pid)
    nl()
}

// Wie `eltern`, aber fuer den Weg INNERHALB einer Sicherung: der letzte
// Namensteil faellt weg, und "" ist die Wurzel der Sicherung.
fn eltern_v(p: u64) {
    var n: u64 = ulib.length(p)
    while n > 0 && (*((p + n - 1) as *mut u8)) != 47 as u8 {
        n = n - 1
    }
    if n > 0 {
        n = n - 1
    }
    __mmio_write8((p + n) as *mut u8, 0 as u8)
}

// Was in der Pfadleiste steht. In einer Sicherung ist das kein Pfad auf
// der Platte, und deshalb steht das Datum mit drin -- sonst koennte man
// eine Sicherung fuer einen Ordner halten und sich wundern, warum sich
// nichts aendern laesst.
fn show_place(fpfad: u64) {
    var sl: [u8; 2] = "/\0"
    if vmodus != 2 {
        pfad_set((&pfad[0 as usize]) as u64)
        return
    }
    ulib.strncpy((&vpfad[0 as usize]) as u64,
        (&vspeicher[0 as usize]) as u64, 120)
    ulib.strcat((&vpfad[0 as usize]) as u64, (&sl[0 as usize]) as u64)
    ulib.strcat((&vpfad[0 as usize]) as u64, (&vsicher[0 as usize]) as u64)
    ulib.strcat((&vpfad[0 as usize]) as u64, (&vunter[0 as usize]) as u64)
    pfad_set((&vpfad[0 as usize]) as u64)
}

// ------------------------------------------------- sichern, mit Anzeige

fn baue_fortschritt() {
    var k_s_d: [u8; 24] = "explorer.progress.files\0"
    var k_s_b: [u8; 24] = "explorer.progress.bytes\0"
    var k_s_n: [u8; 22] = "explorer.progress.new\0"
    var d: [u8; 24] = [0 as u8; 24]
    var lp: u64 = 0
    lp = pfeld(lp, msg.get((&k_s_d[0 as usize]) as u64), (&d[0 as usize]) as u64,
        bstore.files_of())
    lp = pfeld(lp, msg.get((&k_s_b[0 as usize]) as u64), (&d[0 as usize]) as u64,
        bstore.read_of())
    lp = pfeld(lp, msg.get((&k_s_n[0 as usize]) as u64), (&d[0 as usize]) as u64,
        bstore.written_of())
    pbuf[(lp) as usize] = 0 as u8
}

fn pfeld(lp0: u64, txt: u64, d: u64, wert: u64) -> u64 {
    var lp: u64 = lp0
    var k: u64 = 0
    while (*((txt + k) as *mut u8)) != 0 as u8 && lp < 120 {
        pbuf[(lp) as usize] = *((txt + k) as *mut u8)
        lp = lp + 1
        k = k + 1
    }
    let n: u64 = ulib.digits(wert, d)
    var i: u64 = 0
    while i < n && lp < 120 {
        pbuf[(lp) as usize] = *((d + i) as *mut u8)
        lp = lp + 1
        i = i + 1
    }
    return lp
}

// EINE SICHERUNG ANLEGEN ODER DAZULEGEN. `ziel` ist das Verzeichnis, in
// das der Benutzer gezeigt hat -- der Stick, die zweite Platte, irgendein
// Ordner. Gesichert wird `/data`, und das steht hier und nicht im
// Kleingedruckten.
// SICH SELBST ZU SICHERN GEHT NICHT. Liegt das Ziel INNERHALB der
// Quelle, waechst der Speicher, waehrend er durchgegangen wird -- der
// Lauf frisst seine eigenen Bloecke und hoert nie auf. Das ist keine
// theoretische Sorge: `/data` ist die Quelle, und das erste, worauf ein
// Benutzer im Dateimanager zeigt, ist ein Ordner in `/data`.
fn in_own_tree(ziel: u64) -> bool {
    let q: u64 = ulib.length((&t_bquelle[0 as usize]) as u64)
    if !ulib.strneq(ziel, (&t_bquelle[0 as usize]) as u64, q) {
        return false
    }
    // Genau die Quelle selbst, oder etwas darunter -- aber NICHT
    // `/datakram`, das nur so anfaengt.
    let c: u64 = (*((ziel + q) as *mut u8)) as u64
    return c == 0 || c == 47
}

fn save(ziel: u64, baum: u64, tab: u64, stat: u64, fpfad: u64) {
    var s_fertig: [u8; 12] = "  -- fertig\0"
    var s_fehler: [u8; 20] = "  -- FEHLGESCHLAGEN\0"
    var d: [u8; 24] = [0 as u8; 24]
    var nam: [u8; 32] = [0 as u8; 32]

    if in_own_tree(ziel) {
        dlg_ask(msg.get((&k_t_bak[0 as usize]) as u64),
            msg.get((&k_t_selbst2[0 as usize]) as u64))
        sag_sicherung(ziel, (&t_snap[0 as usize]) as u64, 2)
        return
    }
    // DER NAME DER SICHERUNG. Durchnummeriert, weil zwei Sicherungen im
    // selben Speicher nicht denselben Namen haben duerfen -- die zweite
    // wuerde die erste ueberschreiben.
    ulib.strcpy((&nam[0 as usize]) as u64, (&t_snap[0 as usize]) as u64)
    let k: u64 = ulib.digits(next_number(ziel), (&d[0 as usize]) as u64)
    var i: u64 = 0
    let l0: u64 = ulib.length((&nam[0 as usize]) as u64)
    while i < k {
        nam[((l0 + i)) as usize] = *(((&d[0 as usize]) as u64 + i) as *mut u8)
        i = i + 1
    }
    nam[((l0 + k)) as usize] = 0 as u8

    fuiscene.dialog_busy(msg.get((&k_t_bak[0 as usize]) as u64),
        msg.get((&k_t_lauft[0 as usize]) as u64))
    plabel = 1
    fuiscene.repaint_now()
    let rc: u64 = bstore.save((&t_bquelle[0 as usize]) as u64, ziel,
        (&nam[0 as usize]) as u64, 0, (&t_bquelle[0 as usize]) as u64,
        fortschritt)
    plabel = 0xFFFFFFFFFFFFFFFF
    // DIE ZUSAMMENFASSUNG steht in derselben Zeile, in der eben noch der
    // Fortschritt stand.
    baue_fortschritt()
    var lp: u64 = ulib.length((&pbuf[0 as usize]) as u64)
    var q: u64 = 0
    var txt: u64 = (&s_fertig[0 as usize]) as u64
    if rc != 0 {
        txt = (&s_fehler[0 as usize]) as u64
    }
    while (*((txt + q) as *mut u8)) != 0 as u8 && lp < 126 {
        pbuf[(lp) as usize] = *((txt + q) as *mut u8)
        lp = lp + 1
        q = q + 1
    }
    pbuf[(lp) as usize] = 0 as u8
    fuiscene.dialog_open(msg.get((&k_t_bak[0 as usize]) as u64),
        (&pbuf[0 as usize]) as u64, (&t_ok[0 as usize]) as u64, 0)
    sag_sicherung(ziel, (&nam[0 as usize]) as u64, rc)
    new_read(baum, tab, stat, fpfad)
}

// Wieviele Sicherungen liegen schon da? Die naechste bekommt die
// naechste Nummer.
fn next_number(ziel: u64) -> u64 {
    var namebuf: [u8; 64] = [0 as u8; 64]
    let fd: u64 = bstore.snaps_open(ziel)
    if ulib.bad(fd) {
        return 1
    }
    var n: u64 = 0
    var weiter: bool = true
    while weiter {
        if !bstore.snaps_next(fd, (&namebuf[0 as usize]) as u64, 60) {
            weiter = false
        } else {
            n = n + 1
        }
    }
    io.close(fd)
    return n + 1
}

// Auf die serielle Leitung, damit der Lauf MESSBAR ist und nicht nur
// huebsch aussieht.
fn sag_sicherung(ziel: u64, nam: u64, rc: u64) {
    var s1: [u8; 23] = "explorer: backup ziel=\0"
    var s2: [u8; 7] = " name=\0"
    var s3: [u8; 10] = " dateien=\0"
    var s4: [u8; 10] = " oktette=\0"
    var s5: [u8; 6] = " neu=\0"
    var s6: [u8; 5] = " rc=\0"
    say((&s1[0 as usize]) as u64)
    say(ziel)
    say((&s2[0 as usize]) as u64)
    say(nam)
    say((&s3[0 as usize]) as u64)
    sayn(bstore.files_of())
    say((&s4[0 as usize]) as u64)
    sayn(bstore.read_of())
    say((&s5[0 as usize]) as u64)
    sayn(bstore.written_of())
    say((&s6[0 as usize]) as u64)
    sayn(rc)
    nl()
}

// EINE DATEI ODER EINE GANZE SICHERUNG ZURUECKHOLEN. Zurueck geht es
// nach `/data` -- ein fester, genannter Ort ist ehrlicher als ein
// geratener, und wo man gerade steht, ist in einer Sicherung kein Ort
// auf der Platte.
fn zurueckholen(baum: u64, tab: u64, stat: u64, fpfad: u64) {
    var z1: [u8; 19] = "explorer: zurueck \0"
    var z2: [u8; 5] = " rc=\0"
    var rc: u64 = 1
    if vmodus == 1 {
        let z: u64 = cur_row()
        if z < m_anzahl() {
            let e: u64 = m_ord(z)
            ulib.strncpy((&pziel[0 as usize]) as u64,
                (&t_bwohin[0 as usize]) as u64, 120)
            rc = bstore.restore((&vspeicher[0 as usize]) as u64, nptr(e),
                (&pziel[0 as usize]) as u64, 0)
        }
    } else if vmodus == 2 {
        let z: u64 = cur_row()
        if z < m_anzahl() {
            let e: u64 = m_ord(z)
            let full: u64 = in_sicherung(e)
            let wohin: u64 = join((&t_bwohin[0 as usize]) as u64, nptr(e))
            ulib.strncpy((&pziel[0 as usize]) as u64, wohin, 120)
            rc = bstore.get((&vspeicher[0 as usize]) as u64,
                (&vsicher[0 as usize]) as u64, full,
                (&pziel[0 as usize]) as u64)
        }
    }
    say((&z1[0 as usize]) as u64)
    say((&pziel[0 as usize]) as u64)
    say((&z2[0 as usize]) as u64)
    sayn(rc)
    nl()
}

fn tree_walk(zeile: u64, baum: u64, tab: u64, stat: u64, fpfad: u64) {
    if zeile == 0 {
        // HINAUF, und der Weg zurueck geht durch dieselben drei
        // Ansichten, in denen man hineingegangen ist.
        if vmodus == 2 {
            if vunter[(0) as usize] != 0 as u8 {
                eltern_v((&vunter[0 as usize]) as u64)
            } else {
                vmodus = 1
            }
            show_place(fpfad)
            new_read(baum, tab, stat, fpfad)
            return
        }
        if vmodus == 1 {
            vmodus = 0
        }
        eltern((&pfad[0 as usize]) as u64)
        hist_push((&pfad[0 as usize]) as u64)
        new_read(baum, tab, stat, fpfad)
        return
    }
    if vmodus != 0 {
        return
    }
    // Zeile n zeigt auf das n-te Verzeichnis in der Folge.
    //
    // DURCH DIE ADAPTER, NICHT AN IHNEN VORBEI. Hier stand `art[e]` und
    // `nptr(e)` -- die Felder des KLEINEN Modells, das nur im
    // Sicherungsmodus gefuellt ist. Im Normalfall (`vmodus 0`) sind sie
    // leer: `art[e]` war immer 0, also fand die Schleife kein einziges
    // Verzeichnis, und ein Klick auf "bilder" im Baum liess die Tabelle
    // stehen (Befund 32-baum-navigation.png). `m_art`/`m_name` fragen
    // das Modell, das gerade gilt.
    var gesehen: u64 = 0
    var i: u64 = 0
    while i < m_anzahl() {
        let e: u64 = m_ord(i)
        if m_art(e) != 0 {
            gesehen = gesehen + 1
            if gesehen == zeile {
                let full: u64 = join((&pfad[0 as usize]) as u64, m_name(e))
                ulib.strncpy((&pfad[0 as usize]) as u64, full, 126)
                hist_push((&pfad[0 as usize]) as u64)
                new_read(baum, tab, stat, fpfad)
                i = m_anzahl()
            }
        }
        i = i + 1
    }
}

// Was ein Menuepunkt bedeutet. Gibt zurueck, worauf der Dialog danach
// wartet: 1 umbenennen, 2 neuer Ordner, 3 loeschen, 0 nichts.
// RUNDE ALLTAG: PACKEN UND ENTPACKEN AUS DEM KONTEXTMENUE.
//
// `zip` ist ein eigenes Programm und bleibt eines -- der Dateimanager
// ruft es auf, statt einen zweiten Packer zu enthalten. Gestartet wird
// mit SYS_EXEC (das ist der Aufruf mit Argumenten; SYS_SPAWN nimmt
// keine), und danach wird der Ordner neu gelesen, damit das Ergebnis
// dasteht.
fn zip_starten(full: u64, packen: bool, baum: u64, tab: u64, stat: u64,
    fpfad: u64) {
    var werkzeug: [u8; 9] = "/bin/zip\0"
    var o_c: [u8; 3] = "-c\0"
    var o_x: [u8; 3] = "-x\0"
    var ziel: [u8; 200] = [0 as u8; 200]
    var endung: [u8; 5] = ".zip\0"
    var s_go: [u8; 20] = "explorer: zip pid=\0\0"
    var argv: [u64; 4] = [0 as u64; 4]
    argv[0 as usize] = (&werkzeug[0 as usize]) as u64
    if packen {
        ulib.strncpy((&ziel[0 as usize]) as u64, full, 190)
        ulib.strcat((&ziel[0 as usize]) as u64,
            (&endung[0 as usize]) as u64)
        argv[1 as usize] = (&o_c[0 as usize]) as u64
        argv[2 as usize] = (&ziel[0 as usize]) as u64
        argv[3 as usize] = full
    } else {
        argv[1 as usize] = (&o_x[0 as usize]) as u64
        argv[2 as usize] = full
        argv[3 as usize] = (&pfad[0 as usize]) as u64
    }
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&werkzeug[0 as usize]) as u64,
        (&argv[0 as usize]) as u64, 4)
    say((&s_go[0 as usize]) as u64)
    sayn(pid)
    nl()
    if !ulib.bad(pid) && pid != 0 {
        let _w: u64 = ulib.wait_code(pid)
    }
    new_read(baum, tab, stat, fpfad)
}

// ================================ RUNDE EXPLORER-2: DIE MENUEPUNKTE
//
// EINE NUMMER JE MENUE, und jede Nummer genau einmal vergeben. Vorher
// stand `if welches == 4` ZWEIMAL in dieser Funktion: der zweite
// Zweig -- der Netzzugriff -- war unerreichbar, weil der erste
// (Sicherung zurueckholen) ihn abfing. Die Tafel steht hier, damit
// eine neue Nummer nicht wieder eine alte trifft:
//
//    1  Kontextmenue der Tabelle   `explorer.context`      14 Zeilen
//    2  Datei                      `explorer.menu.file`     6
//    3  Ansicht                    `explorer.menu.view`     8
//    4  Kontextmenue IN einer Sicherung `explorer.context.restore` 2
//    5  Netzansichten              `t_views`                4
//    6  Bearbeiten                 `explorer.menu.edit`     5
//    7  Gehe zu                    `explorer.menu.go`       5
//    8  Eigenschaften (nur lesen)  `expdlg.eig_ptr`
//    9  Konflikt                   `explorer.conflict.buttons` 4
//   10  Oeffnen mit                `expdlg.oeffnenmit_ptr`
//   11  Kontextmenue der Baumseite `explorer.context.backup` 5
//
// Rueckgabe: (offen << 8) | wartet -- dasselbe Paar wie beim
// Tastenblock, damit die Ereignisschleife nur EINE Form kennt.
// ================================ RUNDE EXPLORER-2, ZWEITER DURCHGANG
//
// EIN MENUE, EINE NUMMER -- UND JEDE NUMMER GENAU EINMAL.
//
// Befund vor dieser Runde: `menue_wahl` pruefte ZWEIMAL `welches == 4`.
// Der erste Zweig war das Sicherungs-Kontextmenue, der zweite die vier
// Netzansichten -- und weil Firn den ersten passenden Zweig nimmt, war
// der NETVIEW-Punkt "Netzzugriff" unerreichbar. Er stand im Katalog,
// er war anklickbar, und er tat nichts. Jetzt hat jedes Menue seine
// eigene Nummer, und hier steht die vollstaendige Liste:
//
//   0  keines offen
//   1  Kontextmenue der Tabelle    `explorer.context`        14 Zeilen
//   2  Menue "Datei"               `explorer.menu.file`       6
//   3  Menue "Ansicht"             `explorer.menu.view`       8
//   4  Kontextmenue IN einer Sicherung `explorer.context.restore` 2
//   5  die vier Netzansichten      `t_views`                  4
//   6  Menue "Bearbeiten"          `explorer.menu.edit`       5
//   7  Menue "Gehe zu"             `explorer.menu.go`         5
//   8  Eigenschaften (nur Anzeige) aus `expdlg.eig_ptr`
//   9  Konfliktdialog              `explorer.conflict.buttons` 4
//  10  "Oeffnen mit"               aus `expdlg.oeffnenmit_ptr`
//  11  Kontextmenue der Seitenleiste `explorer.context.backup` 5
//
// DIE INDIZES SIND EIN VERTRAG mit dem Katalog (PLAN.md, Abschnitt 4):
// die Reihenfolge der Zeilen dort ist die Reihenfolge der Zweige hier.
// Wer eine Zeile einschiebt, verschiebt eine Tat -- deshalb steht die
// Zeile als Kommentar neben jedem Zweig.
//
// Rueckgabe wie beim Tastenblock: (offen << 8) | wartet.
fn menue_wahl(welches: u64, idx: u64, tab: u64, baum: u64, stat: u64,
    fpfad: u64) -> u64 {
    if welches == 1 {
        return ctx_wahl(idx, tab, baum, stat, fpfad)
    }
    if welches == 2 {
        // explorer.menu.file: 0 Neuer Ordner, 1 Neue Datei,
        // 2 Oeffnen mit, 3 Eigenschaften, 4 Aktualisieren, 5 Beenden.
        if idx == 0 {
            let _d: u64 = dlg_entry(
                msg.get((&k_newdir[0 as usize]) as u64),
                msg.get((&k_name[0 as usize]) as u64), 0)
            return 2
        }
        if idx == 1 {
            return new_file_ask()
        }
        if idx == 2 {
            return openwith_show(tab) << 8
        }
        if idx == 3 {
            return props_show(tab, tab) << 8
        }
        if idx == 4 {
            new_read(baum, tab, stat, fpfad)
            return 0
        }
        if idx == 5 {
            fuiscene.quit()
        }
        return 0
    }
    if welches == 3 {
        // explorer.menu.view: 0 Liste, 1 Symbole, 2 Nach Name,
        // 3 Nach Groesse, 4 Nach Zeit, 5 Nach Rechten, 6 Umgekehrt,
        // 7 Versteckte Dateien.
        if idx == 0 || idx == 1 {
            // Liste oder Symbole -- `ansicht_setzen` blendet das eine
            // Bedienelement ein und das andere aus.
            view_set(idx, tab, baum, stat, fpfad)
            return 0
        }
        if idx >= 2 && idx <= 5 {
            sortby = idx - 2
            sortrev = 0
        } else if idx == 6 {
            sortrev = 1 - sortrev
        } else if idx == 7 {
            expmodell.setz_versteckt(!expmodell.versteckt())
            new_read(baum, tab, stat, fpfad)
            return 0
        }
        sag_sortierung()
        view_refresh(baum, tab)
        return 0
    }
    if welches == 4 {
        // explorer.context.restore: 0 Oeffnen, 1 Zurueckholen.
        if idx == 0 {
            open(cur_row(), baum, tab, stat, fpfad,
                msg.get((&k_t_bak[0 as usize]) as u64))
            return 0
        }
        zurueckholen(baum, tab, stat, fpfad)
        return 0
    }
    if welches == 5 {
        netview_starten(idx, tab)
        return 0
    }
    if welches == 6 {
        // explorer.menu.edit: 0 Ausschneiden, 1 Kopieren, 2 Einfuegen,
        // 3 Alles auswaehlen, 4 Rueckgaengig.
        if idx == 0 || idx == 1 {
            return clipboard_do(tab, idx == 0)
        }
        if idx == 2 {
            return paste_do(tab, baum, tab, stat, fpfad)
        }
        if idx == 3 {
            fuiscene.table_sel_all(cur_key())
            rfr()
            sag_auswahl(tab)
            return 0
        }
        return undo_do(baum, tab, stat, fpfad)
    }
    if welches == 7 {
        // explorer.menu.go: 0 Zurueck, 1 Vorwaerts, 2 Hinauf,
        // 3 Zuhause, 4 Papierkorb.
        return goto_to(idx, baum, tab, stat, fpfad)
    }
    if welches == 10 {
        let z: u64 = cur_row()
        if z < m_anzahl() {
            let rc: u64 = expdlg.oeffnenmit_start(idx, full_from(z))
            if ulib.bad(rc) {
                let _f: bool = error_show(rc)
            }
        }
        return 0
    }
    if welches == 11 {
        // explorer.context.backup: 0 Oeffnen, 1 Umbenennen, 2 Loeschen,
        // 3 Neuer Ordner, 4 Backup hierhin sichern.
        if idx == 0 {
            tree_walk(baum_row(), baum, tab, stat, fpfad)
            return 0
        }
        if idx == 1 {
            return umbenennen_fragen(tab)
        }
        if idx == 2 {
            return delete_ask(tab, false)
        }
        if idx == 3 {
            let _d: u64 = dlg_entry(
                msg.get((&k_newdir[0 as usize]) as u64),
                msg.get((&k_name[0 as usize]) as u64), 0)
            return 2
        }
        return save_ask(tab, baum, stat, fpfad)
    }
    return 0
}

// DAS KONTEXTMENUE DER TABELLE, Zeile fuer Zeile aus `explorer.context`
// (die Ordnung dort ist Vertrag, siehe PLAN.md Abschnitt 4).
fn ctx_wahl(idx: u64, tab: u64, baum: u64, stat: u64, fpfad: u64) -> u64 {
    if idx == 0 { // Oeffnen
        var empty: [u8; 4] = "\0\0\0\0"
        open(cur_row(), baum, tab, stat, fpfad,
            (&empty[0 as usize]) as u64)
        return 0
    }
    if idx == 1 { // Oeffnen mit
        return openwith_show(tab) << 8
    }
    if idx == 2 || idx == 3 { // Ausschneiden, Kopieren
        return clipboard_do(tab, idx == 2)
    }
    if idx == 4 { // Einfuegen
        return paste_do(tab, baum, tab, stat, fpfad)
    }
    if idx == 5 { // Umbenennen
        return umbenennen_fragen(tab)
    }
    if idx == 6 { // Loeschen (in den Papierkorb)
        return delete_ask(tab, false)
    }
    if idx == 7 { // Endgueltig loeschen
        return delete_ask(tab, true)
    }
    if idx == 8 { // Neuer Ordner
        let _d: u64 = dlg_entry(msg.get((&k_newdir[0 as usize]) as u64),
            msg.get((&k_name[0 as usize]) as u64), 0)
        return 2
    }
    if idx == 9 { // Neue Datei
        return new_file_ask()
    }
    if idx == 10 || idx == 11 { // Packen (ZIP), Entpacken
        let z: u64 = cur_row()
        if z < m_anzahl() {
            zip_starten(full_from(z), idx == 10, baum, tab, stat, fpfad)
        }
        return 0
    }
    if idx == 12 { // Netzzugriff -- die vier Ansichten als eigenes Menue
        let _m: u64 = popup_at(fuiscene.menu_x(), fuiscene.menu_y(),
            (&t_views[0 as usize]) as u64)
        return 5 << 8
    }
    if idx == 13 { // Eigenschaften
        return props_show(tab, tab) << 8
    }
    return 0
}

// ROUND NETVIEW: start the selected file with the chosen view. It goes
// through `/bin/netview`, which is the SAME mechanism the shell and the
// launcher use -- the file manager gets no privileged path of its own.
// RUNDE EXPLORER-2: dieser Zweig war unerreichbar (zweimal
// `welches == 4`); jetzt hat er die Nummer 5 und wird vom Punkt
// "Netzzugriff" des Kontextmenues aufgerufen.
fn netview_starten(idx: u64, tab: u64) {
    var v0: [u8; 5] = "real\0"
    var v1: [u8; 9] = "filtered\0"
    var v2: [u8; 6] = "faked\0"
    var v3: [u8; 5] = "none\0"
    var tool: [u8; 13] = "/bin/netview\0"
    var voll2: [u8; 200] = [0 as u8; 200]
    var argv: [u64; 3] = [0 as u64; 3]
    var s_nv: [u8; 19] = "explorer: netview \0"
    var s_sp2: [u8; 2] = " \0"
    var s_pid: [u8; 8] = " pid=\0\0\0"
    let z: u64 = cur_row()
    if z >= m_anzahl() {
        return
    }
    let e: u64 = m_ord(z)
    if m_art(e) != 0 {
        return
    }
    ulib.strncpy((&voll2[0 as usize]) as u64,
        join((&pfad[0 as usize]) as u64, m_name(e)), 190)
    var word: u64 = (&v0[0 as usize]) as u64
    if idx == 1 {
        word = (&v1[0 as usize]) as u64
    } else if idx == 2 {
        word = (&v2[0 as usize]) as u64
    } else if idx == 3 {
        word = (&v3[0 as usize]) as u64
    }
    argv[0 as usize] = (&tool[0 as usize]) as u64
    argv[1 as usize] = word
    argv[2 as usize] = (&voll2[0 as usize]) as u64
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&tool[0 as usize]) as u64,
        (&argv[0 as usize]) as u64, 3)
    say((&s_nv[0 as usize]) as u64)
    say(word)
    say((&s_sp2[0 as usize]) as u64)
    say((&voll2[0 as usize]) as u64)
    say((&s_pid[0 as usize]) as u64)
    sayn(pid)
    nl()
}

// KOPIEREN UND AUSSCHNEIDEN AUF DIE GANZE AUSWAHL (Pflichtpunkt 3).
// `auswahl_liste` sammelt jede Zeile mit `wlib.sel_hat`; erst wenn
// nichts markiert ist, gilt die Zeile unter dem Zeiger.
fn clipboard_do(tab: u64, schnitt: bool) -> u64 {
    var s_c: [u8; 16] = "explorer: clip \0"
    var s_n: [u8; 3] = "n=\0"
    var s_s: [u8; 9] = "schnitt=\0"
    var s_rc: [u8; 4] = "rc=\0"
    let n: u64 = select_list(tab)
    if n == 0 {
        return 0
    }
    let rc: u64 = expakt.copy_remember(schnitt)
    var sn: u64 = 0
    if schnitt {
        sn = 1
    }
    say((&s_c[0 as usize]) as u64)
    kv((&s_n[0 as usize]) as u64, n)
    kv((&s_s[0 as usize]) as u64, sn)
    kv((&s_rc[0 as usize]) as u64, rc)
    nl()
    let _f: bool = error_show(rc)
    return 0
}

fn undo_do(baum: u64, tab: u64, stat: u64, fpfad: u64) -> u64 {
    var s_u: [u8; 16] = "explorer: undo \0"
    var s_a: [u8; 5] = "art=\0"
    var s_rc: [u8; 4] = "rc=\0"
    let art0: u64 = expakt.undo_art()
    let rc: u64 = expakt.rueckgaengig()
    new_read(baum, tab, stat, fpfad)
    say((&s_u[0 as usize]) as u64)
    kv((&s_a[0 as usize]) as u64, art0)
    kv((&s_rc[0 as usize]) as u64, rc)
    nl()
    let _f: bool = error_show(rc)
    return 0
}

// Der Umbenennen-Dialog. Er nimmt die erste markierte Zeile -- bei
// einer Mehrfachauswahl ist Umbenennen das eine, was sich NICHT auf
// alle anwenden laesst, und ein Dialog je Datei waere eine Zumutung.
fn umbenennen_fragen(tab: u64) -> u64 {
    let z: u64 = first_select(tab)
    if z >= m_anzahl() {
        return 0
    }
    fuiscene.table_set_sel(cur_key(), z)
    ulib.strncpy((&dlgpuffer[0 as usize]) as u64, m_name(m_ord(z)), 120)
    let _d: u64 = dlg_entry(msg.get((&k_rename[0 as usize]) as u64),
        msg.get((&k_name[0 as usize]) as u64),
        (&dlgpuffer[0 as usize]) as u64)
    return 1
}

// Loeschen fragt IMMER nach, und die Frage nennt die Zahl der Stuecke,
// die die Auswahl traegt (sie steht in `expakt.liste_zahl`).
fn delete_ask(tab: u64, endgueltig: bool) -> u64 {
    let n: u64 = select_list(tab)
    if n == 0 {
        return 0
    }
    var ask: u64 = msg.get((&k_del[0 as usize]) as u64)
    if endgueltig {
        ask = msg.get((&k_delperm[0 as usize]) as u64)
    }
    let _d: u64 = dlg_ask(msg.get((&k_deltit[0 as usize]) as u64),
        ask)
    if endgueltig {
        return 5
    }
    return 3
}

fn new_file_ask() -> u64 {
    let _d: u64 = dlg_entry(msg.get((&k_newfile[0 as usize]) as u64),
        msg.get((&k_name[0 as usize]) as u64),
        msg.get((&k_newfname[0 as usize]) as u64))
    return 7
}

// "Backup hierhin sichern" -- wohin: in den Ordner, in dem man steht,
// oder in den ausgewaehlten, wenn einer ausgewaehlt ist.
fn save_ask(tab: u64, baum: u64, stat: u64, fpfad: u64) -> u64 {
    ulib.strncpy((&pziel[0 as usize]) as u64, (&pfad[0 as usize]) as u64,
        120)
    let z2: u64 = cur_row()
    if z2 < m_anzahl() {
        let e2: u64 = m_ord(z2)
        // UEBER DIE ADAPTER: `art[]`/`nptr()` sind die Felder des
        // kleinen Sicherungsmodells und im Normalfall leer.
        if m_art(e2) != 0 {
            ulib.strncpy((&pziel[0 as usize]) as u64,
                join((&pfad[0 as usize]) as u64, m_name(e2)), 120)
        }
    }
    if bstore.is_store((&pziel[0 as usize]) as u64) {
        // Liegt da schon ein Speicher, kommt ohne Rueckfrage eine
        // WEITERE Sicherung hinein -- nur beim ersten Mal wird gefragt.
        // Gesichert wird sofort: `vollziehen` laeuft nur nach einem
        // bestaetigten Dialog, und hier wird keiner gestellt.
        save((&pziel[0 as usize]) as u64, baum, tab, stat, fpfad)
        return 0
    }
    let _d: u64 = dlg_ask(msg.get((&k_t_bak[0 as usize]) as u64),
        msg.get((&k_t_bfrage[0 as usize]) as u64))
    return 4
}

// Die erste markierte Zeile; ohne Markierung die unter dem Zeiger.
fn first_select(tab: u64) -> u64 {
    var z: u64 = 0
    let int: u64 = m_anzahl()
    while z < int {
        if fuiscene.table_sel_has(cur_key(), z) {
            return z
        }
        z = z + 1
    }
    return cur_row()
}

// Das Menue "Gehe zu". Zuhause und Papierkorb sind ORTE und keine
// Texte: der eine kommt aus dem Dateisystem, der andere aus
// `korb.korb_von` -- derselbe Ort, den `papierkorb` benutzt.
fn goto_to(idx: u64, baum: u64, tab: u64, stat: u64, fpfad: u64) -> u64 {
    var t_home: [u8; 8] = "/home\0\0\0"
    var t_data: [u8; 8] = "/data\0\0\0"
    var s_g: [u8; 18] = "explorer: gehezu \0"
    if idx == 0 {
        if hist_at > 1 {
            hist_at = hist_at - 1
            ulib.strcpy((&pfad[0 as usize]) as u64, hist_get(hist_at - 1))
            new_read(baum, tab, stat, fpfad)
        }
    } else if idx == 1 {
        if hist_at < hist_n {
            hist_at = hist_at + 1
            ulib.strcpy((&pfad[0 as usize]) as u64, hist_get(hist_at - 1))
            new_read(baum, tab, stat, fpfad)
        }
    } else if idx == 2 {
        eltern((&pfad[0 as usize]) as u64)
        hist_push((&pfad[0 as usize]) as u64)
        new_read(baum, tab, stat, fpfad)
    } else if idx == 3 {
        var wohin: u64 = (&t_data[0 as usize]) as u64
        if ulib.is_dir((&t_home[0 as usize]) as u64) {
            wohin = (&t_home[0 as usize]) as u64
        }
        vmodus = 0
        ulib.strncpy((&pfad[0 as usize]) as u64, wohin, 126)
        hist_push((&pfad[0 as usize]) as u64)
        new_read(baum, tab, stat, fpfad)
    } else if idx == 4 {
        let k: u64 = trash.korb_von((&pfad[0 as usize]) as u64)
        if k != 0 {
            vmodus = 0
            ulib.strncpy((&pfad[0 as usize]) as u64, k, 126)
            hist_push((&pfad[0 as usize]) as u64)
            new_read(baum, tab, stat, fpfad)
        }
    }
    say((&s_g[0 as usize]) as u64)
    sayn(idx)
    var sp: [u8; 2] = " \0"
    say((&sp[0 as usize]) as u64)
    say((&pfad[0 as usize]) as u64)
    nl()
    return 0
}

fn sag_sortierung() {
    var s_s: [u8; 17] = "explorer: sort \0\0"
    var s_sp: [u8; 8] = "spalte=\0"
    var s_r: [u8; 5] = "rev=\0"
    say((&s_s[0 as usize]) as u64)
    kv((&s_sp[0 as usize]) as u64, sortby)
    kv((&s_r[0 as usize]) as u64, sortrev)
    nl()
}

// Der Dialog wurde bestaetigt. HIER steht die einzige Stelle, an der
// dieser Dateimanager die Platte AENDERT -- und sie steht an einer
// Stelle, nicht an fuenf. Jede Tat geht durch `expakt`, jede
// Rueckmeldung ungleich null durch `fehler_zeigen`.
// Rueckgabe: worauf danach gewartet wird (0 = auf nichts). Ein
// Konflikt macht einen zweiten Dialog auf, und die Schleife muss davon
// wissen -- sonst laege seine Antwort auf keinem Tisch.
// ONE WRITE FOR THE WHOLE LINE. Written in six pieces, the WM's own
// kernel line ("wm: rahmen ...") landed between them on the shared
// serial port -- k15 read "explorer: tat wm: rahmen x=70 ..." and
// "2 n=1 rc=0" on the next line, and the directory that WAS made
// counted as not made.
fn say_tat(was: u64, getan: u64, rc: u64) {
    if s_dbg == 0 {
        return
    }
    var b: [u8; 96] = [0 as u8; 96]
    var s_op: [u8; 16] = "explorer: tat \0\0"
    var s_n: [u8; 4] = " n=\0"
    var s_rc: [u8; 8] = " rc=\0\0\0\0"
    let p: u64 = (&b[0 as usize]) as u64
    var at: u64 = ulib.strcpy(p, (&s_op[0 as usize]) as u64)
    at = at + ulib.digits(was, p + at)
    at = at + ulib.strcpy(p + at, (&s_n[0 as usize]) as u64)
    at = at + ulib.digits(getan, p + at)
    at = at + ulib.strcpy(p + at, (&s_rc[0 as usize]) as u64)
    at = at + ulib.digits(rc, p + at)
    b[(at) as usize] = 10 as u8
    ulib.put(p, at + 1)
}

fn vollziehen(was: u64, tab: u64, baum: u64, stat: u64,
    fpfad: u64) -> u64 {
    var danach: u64 = 0
    if was == 0 {
        return 0
    }
    var rc: u64 = 0
    var getan: u64 = 0
    if was == 4 {
        save((&pziel[0 as usize]) as u64, baum, tab, stat, fpfad)
        return 0
    }
    if was == 9 {
        // DIE ANTWORT AUF DEN KONFLIKTDIALOG. Welcher Knopf es war,
        // sagt `wlib.dlg_wahl_at` -- 0..3 wie im Katalog. Die Tat, die
        // stehengeblieben ist, wird damit wiederholt.
        return conflict_reply(s_pick, tab, baum, tab, stat,
            fpfad)
    }
    if was == 2 {
        let full: u64 = join((&pfad[0 as usize]) as u64, fuiscene.dialog_entry_text())
        rc = io.make_dir(full)
        if ulib.bad(rc) {
            getan = 0
        } else {
            rc = 0
            getan = 1
        }
    } else if was == 7 {
        // NEUE DATEI (Pflichtpunkt 10) -- leer angelegt von `expdlg`.
        let full: u64 = join((&pfad[0 as usize]) as u64, fuiscene.dialog_entry_text())
        rc = expdlg.new_file(full, 0)
        if rc == 0 {
            getan = 1
        }
    } else if was == 6 {
        // STRG+F: der Filter. Der Puffer liegt statisch, weil
        // `expmodell` den Zeiger behaelt.
        ulib.strncpy((&fbuf[0 as usize]) as u64, fuiscene.dialog_entry_text(), 60)
        if (fbuf[(0) as usize]) == 0 as u8 {
            expmodell.setz_filter(0)
        } else {
            expmodell.setz_filter((&fbuf[0 as usize]) as u64)
        }
    } else if was == 3 || was == 5 {
        // LOESCHEN, UND ZWAR DIE GANZE AUSWAHL. Die Liste hat
        // `auswahl_liste` gefuellt, als der Dialog aufging -- was
        // danach angeklickt wird, aendert sie nicht mehr.
        var i: u64 = 0
        while i < expakt.list_num() {
            var r2: u64 = 0
            if was == 3 {
                r2 = expakt.in_korb(expakt.list_at(i))
            } else {
                r2 = expakt.endgueltig(expakt.list_at(i))
            }
            if r2 != 0 {
                rc = r2
            } else {
                getan = getan + 1
            }
            i = i + 1
        }
    } else if was == 1 {
        // DIE ERSTE MARKIERTE Zeile, nicht die unter dem Zeiger:
        // Umbenennen ist das eine, was sich nicht auf zwanzig Stuecke
        // anwenden laesst -- aber es muss die Datei treffen, die der
        // Benutzer markiert hat (Pflichtpunkt 3).
        let z: u64 = first_select(tab)
        if z < m_anzahl() {
            danach = rename_do(tab, full_from(z), fuiscene.dialog_entry_text(),
                baum, tab, stat, fpfad)
            rc = expakt.letzter_rc()
            if rc == 0 {
                getan = 1
            }
        }
    }
    say_tat(was, getan, rc)
    new_read(baum, tab, stat, fpfad)
    if rc != 0 && danach == 0 {
        let _f: bool = error_show(rc)
    }
    return danach
}

// RUNDE ROTABSCHNITTE: DIESES `main` LAEUFT, UND ES MUSS DIE
// ARGUMENTE WEITERGEBEN.
//
// Der Kommentar, der hier stand, sagte "das `main`, das nie laeuft --
// `user.ld` springt nach `u_start`". Das stimmt fuer ein Programm, das
// mit `kernel/user/crt.s` gebunden ist; dessen `_start` ruft
// USER_ENTRY. Unter `profile app` stimmt es NICHT: dort bringt firnc
// sein eigenes `_start` mit (darum darf crt.o nicht dazu, siehe
// tools/look/shot.sh), und das endet in `call main` -- der Name steht
// fest in lib/firnc1/codegen.fi, `--defsym=USER_ENTRY` erreicht ihn
// nicht. Am gebauten ELF nachgesehen: Einsprung ist `_start`, sechs
// Befehle weiter steht `call <main>`; `_F0.u_start` wird von dort nie
// gerufen.
//
// `u_start(0)` warf damit den Argumentblock weg. Bei powermon waren
// das 54 rote Zusagen (siehe ROTABSCHNITTE 11/n).
//
// Der Block liegt an einer FESTEN Adresse: Runde K16 legte den
// Stapelzeiger darauf (kernel/elf.fi, `T_USTACK = proc.ARGS_BASE`),
// und firnc's `_start` macht `mov rsp, rdi`. Jede `elf: start`-Zeile
// dieses Systems druckt sie als `ustack=0x4007f000`.
fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}

// ======================================================================
// RUNDE FUI-ALL F-8: DER DATEIMANAGER AUF DEM SZENENBAUM
//
// Bis hier war jedes Bedienelement ein Eintrag in wlibs Widgetliste, und die
// Funktionen oben reichten die Nummern `baum`, `tab`, `stat`, `fpfad` durch.
// Jetzt beschreibt das Programm sein Fenster (`build`), und die Nummern sind
// SCHLUESSEL (K_BAUM, K_TAB, K_STAT, K_PFAD): ein Knoten, der etwas melden
// soll, traegt einen. Die Parameterlisten sind geblieben, damit die Taten
// (Einfuegen, Umbenennen, Papierkorb ...) nicht angefasst werden mussten.
// ======================================================================

