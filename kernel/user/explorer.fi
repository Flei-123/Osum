// ===================================================================
// RUNDE TRESOR, ZWEITER NACHTRAG: SICHERN UND ZURUECKHOLEN.
//
// Der ganze Sinn ist ein Satz: Stick anstecken, hineingehen, "Backup
// hierhin sichern" -- fertig. Was darunter liegt, ist KEINE grosse
// Datei und kein ZIP, sondern ein VERZEICHNIS aus Bloecken, die sich
// alle Sicherungen teilen (`kernel/user/bstore.fi` erklaert, warum).
// Kluges Format unten, ein Menuepunkt oben.
//
// UND ES IST DIESELBE UMSETZUNG wie in `/bin/backup`. Der Dateimanager
// hat KEINE eigene Fassung von "Baum durchgehen und hashen" -- er ruft
// `bstore` auf. Zwei Fassungen driften, und der Tag, an dem sie sich
// uneins sind, ist der Tag, an dem jemand eine Wiederherstellung
// braucht.
//
// DREI ANSICHTEN, und `vmodus` sagt, welche gilt:
//   0  ein ganz gewoehnliches Verzeichnis
//   1  ein Sicherungsspeicher: die Liste der SICHERUNGEN, mit Datum,
//      Anzahl Dateien und Groesse
//   2  IN einer Sicherung: die Dateien darin, zum Hineingehen wie in
//      einen Ordner und zum einzelnen Zurueckholen
static mut vmodus: u64 = 0
static mut vspeicher: [u8; 128] = [0 as u8; 128] // wo der Speicher liegt
static mut vsicher: [u8; 64] = [0 as u8; 64]     // welche Sicherung
static mut vunter: [u8; 160] = [0 as u8; 160]    // wo darin
static mut vctx: [u8; 528] = [0 as u8; 528]
static mut vpfad: [u8; 256] = [0 as u8; 256]
static mut vinfo: [u64; 4] = [0 as u64; 4]
static mut zeiten: [u8; 1920] = [0 as u8; 1920]  // SIC_MAXENT * 20, das Datum
static mut pbuf: [u8; 128] = [0 as u8; 128]      // der Fortschrittstext
static mut plabel: u64 = 0xFFFFFFFFFFFFFFFF
static mut pziel: [u8; 128] = [0 as u8; 128]

static mut k_t_pop: [u8; 24] = "explorer.context.backup\0"
static mut k_t_popb: [u8; 25] = "explorer.context.restore\0"
static mut k_t_bak: [u8; 22] = "explorer.backup.title\0"
static mut k_t_bfrage: [u8; 20] = "explorer.backup.ask\0"
static mut t_bquelle: [u8; 6] = "/data\0"
static mut t_bwohin: [u8; 6] = "/data\0"
static mut k_t_lauft: [u8; 24] = "explorer.backup.running\0"
static mut t_snap: [u8; 10] = "sicherung\0"
static mut k_t_selbst2: [u8; 24] = "explorer.backup.notself\0"

static mut dlg_gemeldet: bool = false
static mut sortby: u64 = 0
static mut sortrev: u64 = 0

// RUNDE EXPLORER-2, Pflichtpunkt 3: das Bitfeld der Mehrfachauswahl.
// `wlib.sel_*` haelt keine eigene Wahrheit darueber, welche Zeile
// markiert ist -- es rechnet auf DEM Feld, das hier angemeldet wird.
// Ein Bit je Zeile, MAXENT 4096 Zeilen -> 4096/8 = 512 Oktette. Die
// Adresse muss statisch sein, weil die Bibliothek sie beim naechsten
// Malen erneut liest.
static mut selbits: [u8; 512] = [0 as u8; 512]

// ============================================ RUNDE BELEG: DER MESSAUSGANG
// STEHT IM NORMALBETRIEB AUS.
//
// Justins Befund am Abbild vom 12.09.2026: im Terminalfenster standen
// Zeilen wie `explorer: krumm n=2 fold=0` und `bg=...`. Gezaehlt hat er
// auch: 160 `ulib.say` in taskbar.fi, 38 in explorer.fi.
//
// Die Regel dazu steht seit Runde LAUFZEIT in taskmgr.fi:
//
//   EIN MESSAUSGANG GEHOERT HINTER EINEN SCHALTER, UND DER SCHALTER
//   STEHT IM NORMALBETRIEB AUS. Ein Programm, das im Auslieferungs-
//   zustand misst, misst vor allem sich selbst.
//
// NICHT GELOESCHT, SONDERN GESCHALTET. Die Zaehler (`fui=`, `fuix=`,
// `rect id=`, `text ... base=`) waren mehrfach der Schluessel zur
// Fehlersuche -- sie muessen fuer die Abnahme da sein. Also EIN Schalter
// statt zweihundert geloeschter Zeilen.
//
// ZWEI WEGE, IHN EINZUSCHALTEN, und beide gab es schon:
//   /etc/uitrace   die Datei, mit der `wlib` seit Runde LOOK dasselbe
//                  tut -- die Pruefstaende legen sie ohnehin an
//   `debug`        als Wort auf der Programmzeile, fuer den Fall, dass
//                  einer allein gestartet wird
//
// OHNE BEIDES AENDERT SICH KEIN OKTETT gegenueber vorher -- das ist die
// Bedingung dafuer, dass kein bestehender Testlaeufer davon etwas merkt.
static mut s_dbg: u64 = 0

// Die drei Ausgaenge dieses Programms, an EINER Stelle geschaltet.
// `sayn` und `nl` stehen hier, damit kein Aufrufer `ulib.` direkt
// nimmt und damit am Schalter vorbeigeht.
fn dbg_on() -> bool {
    return s_dbg != 0
}

fn dbg_setup(args: u64) {
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_dbg = 1
    }
    var a_dbg: [u8; 6] = "debug\0"
    let argc: u64 = ulib.arg_count(args)
    var ai: u64 = 1
    while ai < argc {
        if ulib.streq(ulib.arg_at(args, ai), (&a_dbg[0 as usize]) as u64) {
            s_dbg = 1
        }
        ai = ai + 1
    }
}

fn say(p: u64) {
    if s_dbg == 0 {
        return
    }
    ulib.say(p)
}

fn sayn(v: u64) {
    if s_dbg == 0 {
        return
    }
    ulib.sayn(v)
}

fn nl() {
    if s_dbg == 0 {
        return
    }
    ulib.nl()
}

fn kv(name: u64, v: u64) {
    var sp: [u8; 2] = " \0"
    say(name)
    sayn(v)
    say((&sp[0 as usize]) as u64)
}

fn nptr(i: u64) -> u64 {
    return (&namen[0 as usize]) as u64 + i * SIC_NAMEB
}

// ============================================ RUNDE EXPLORER-2: DAS MODELL
//
// ZWEI MODELLE, EIN ZUGRIFF. Der Dateimanager zeigt DREI Dinge in
// derselben Tabelle: ein echtes Verzeichnis auf der Platte, die Liste
// der Sicherungsspeicher (`vmodus 1`) und den Inhalt einer Sicherung
// (`vmodus 2`). Die beiden letzten sind KEINE Verzeichnisse -- sie
// stehen in einer Textdatei, und `scan_speicher`/`scan_sicherung`
// fuellen dafuer die kleinen Felder hier in dieser Datei.
//
// Das echte Verzeichnis kommt seit dieser Runde aus `expmodell`: dort
// stehen MAXENT 4096 statt 96, NAMEB 256 statt 32, die echten Zeiten
// aus `stat` und die Sortierung nach vier Spalten. Beides
// nebeneinanderzuhalten waere zwei Wahrheiten; darum geht JEDER Leser
// durch die sechs Adapter hier, und nur sie wissen, welches Modell
// gerade gilt. Wer `anzahl` oder `folge[]` direkt liest, liest im
// Sicherungsmodus richtig und im Normalfall falsch -- deshalb tut es
// unterhalb dieser Zeile niemand mehr.
fn m_anzahl() -> u64 {
    if vmodus == 0 {
        return expmodell.anzahl()
    }
    return anzahl
}

// Ansichtszeile -> Eintragsnummer. Die Sortierung steckt in dieser
// Abbildung, nicht in den Daten.
fn m_ord(zeile: u64) -> u64 {
    if vmodus == 0 {
        return expmodell.ord_at(zeile)
    }
    if zeile >= anzahl {
        return 0
    }
    return folge[(zeile) as usize]
}

fn m_name(e: u64) -> u64 {
    if vmodus == 0 {
        return expmodell.name_at(e)
    }
    return nptr(e)
}

fn m_art(e: u64) -> u64 {
    if vmodus == 0 {
        return expmodell.art_at(e)
    }
    return art[(e) as usize]
}

fn m_size(e: u64) -> u64 {
    if vmodus == 0 {
        return expmodell.size_at(e)
    }
    return groesse[(e) as usize]
}

fn m_modus(e: u64) -> u64 {
    if vmodus == 0 {
        return expmodell.modus_at(e)
    }
    return modus[(e) as usize]
}

// -------------------------------------------------- das Verzeichnis lesen

fn join(dir: u64, name: u64) -> u64 {
    let out: u64 = (&vollpfad[0 as usize]) as u64
    var n: u64 = 0
    while (*((dir + n) as *mut u8)) != 0 as u8 && n < 150 {
        __mmio_write8((out + n) as *mut u8, *((dir + n) as *mut u8))
        n = n + 1
    }
    if n > 1 || (*((out) as *mut u8)) != 47 as u8 {
        if n == 0 || (*((out + n - 1) as *mut u8)) != 47 as u8 {
            __mmio_write8((out + n) as *mut u8, 47 as u8)
            n = n + 1
        }
    }
    var k: u64 = 0
    while (*((name + k) as *mut u8)) != 0 as u8 && n < 190 {
        __mmio_write8((out + n) as *mut u8, *((name + k) as *mut u8))
        n = n + 1
        k = k + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return out
}

// Das echte Verzeichnis liest seit RUNDE EXPLORER-2 `expmodell.lade`
// -- mit MAXENT 4096 statt 96, NAMEB 256 statt 32 und den Zeiten aus
// `stat`. Das alte `scan` hier war danach unerreichbar und ist weg;
// zwei Leser desselben Verzeichnisses waeren zwei Wahrheiten.

// Wo das Datum der Zeile i liegt (wie `nptr`, nur fuer die Zeitspalte).
fn zptr(i: u64) -> u64 {
    return (&zeiten[0 as usize]) as u64 + i * 20
}

// ANSICHT 1: die Sicherungen eines Speichers. Jede bekommt ihr Datum aus
// dem Kopf des Schnappschusses und ihre Zahlen aus dessen `end`-Zeile --
// eine Sicherung OHNE `end` ist unvollstaendig und wird gar nicht erst
// angezeigt, denn sie ist keine.
fn scan_mem() -> u64 {
    var namebuf: [u8; 64] = [0 as u8; 64]
    anzahl = 0
    let fd: u64 = bstore.snaps_open((&vspeicher[0 as usize]) as u64)
    if ulib.bad(fd) {
        return 0
    }
    var weiter: bool = true
    while weiter {
        if !bstore.snaps_next(fd, (&namebuf[0 as usize]) as u64, 60) {
            weiter = false
        } else if anzahl < SIC_MAXENT {
            if bstore.snap_head((&vspeicher[0 as usize]) as u64,
                    (&namebuf[0 as usize]) as u64, zptr(anzahl),
                    (&vinfo[0 as usize]) as u64) {
                if vinfo[(2) as usize] != 0 {
                    ulib.strncpy(nptr(anzahl), (&namebuf[0 as usize]) as u64,
                        SIC_NAMEB - 1)
                    groesse[(anzahl) as usize] = vinfo[(1) as usize]
                    art[(anzahl) as usize] = 1
                    modus[(anzahl) as usize] = 16877
                    anzahl = anzahl + 1
                }
            }
        }
    }
    io.close(fd)
    return anzahl
}

// ANSICHT 2: was IN einer Sicherung unter `vunter` liegt. Der
// Schnappschuss ist eine Textdatei mit vollen Pfaden; angezeigt wird,
// was genau eine Ebene tiefer liegt -- damit laesst er sich begehen wie
// ein Ordner, ohne dass irgendwo ein Baum gebaut werden muss.
fn scan_sicherung() -> u64 {
    anzahl = 0
    let pl: u64 = ulib.length((&vunter[0 as usize]) as u64)
    let fd: u64 = bstore.entries_open((&vspeicher[0 as usize]) as u64,
        (&vsicher[0 as usize]) as u64, (&vctx[0 as usize]) as u64)
    if ulib.bad(fd) {
        return 0
    }
    var weiter: bool = true
    while weiter {
        if !bstore.entries_next(fd, (&vctx[0 as usize]) as u64,
                (&vpfad[0 as usize]) as u64, (&vinfo[0 as usize]) as u64) {
            weiter = false
        } else if anzahl < SIC_MAXENT {
            // Passt der Anfang? Und ist danach GENAU EIN Namensteil?
            if pl == 0 || ulib.strneq((&vpfad[0 as usize]) as u64,
                    (&vunter[0 as usize]) as u64, pl) {
                let rest: u64 = (&vpfad[0 as usize]) as u64 + pl
                if (*((rest) as *mut u8)) == 47 as u8 {
                    var k: u64 = 1
                    var tiefer: bool = false
                    while (*((rest + k) as *mut u8)) != 0 as u8 {
                        if (*((rest + k) as *mut u8)) == 47 as u8 {
                            tiefer = true
                        }
                        k = k + 1
                    }
                    if !tiefer && k > 1 {
                        ulib.strncpy(nptr(anzahl), rest + 1, SIC_NAMEB - 1)
                        groesse[(anzahl) as usize] = vinfo[(1) as usize]
                        modus[(anzahl) as usize] = vinfo[(0) as usize]
                        if (vinfo[(0) as usize] & 61440) == 16384 {
                            art[(anzahl) as usize] = 1
                        } else {
                            art[(anzahl) as usize] = 0
                        }
                        __mmio_write8((zptr(anzahl)) as *mut u8, 0 as u8)
                        anzahl = anzahl + 1
                    }
                }
            }
        }
    }
    io.close(fd)
    return anzahl
}

// DER VOLLE PFAD EINER ZEILE INNERHALB DER SICHERUNG -- `vunter` plus
// der Name. Das ist genau der Schluessel, unter dem `bstore.get` die
// Datei wiederfindet.
fn in_sicherung(e: u64) -> u64 {
    var sl: [u8; 2] = "/\0"
    ulib.strncpy((&vpfad[0 as usize]) as u64,
        (&vunter[0 as usize]) as u64, 200)
    ulib.strcat((&vpfad[0 as usize]) as u64, (&sl[0 as usize]) as u64)
    ulib.strcat((&vpfad[0 as usize]) as u64, nptr(e))
    return (&vpfad[0 as usize]) as u64
}

fn point(name: u64) -> bool {
    if (*((name) as *mut u8)) != 46 as u8 {
        return false
    }
    if (*((name + 1) as *mut u8)) == 0 as u8 {
        return true
    }
    if (*((name + 1) as *mut u8)) == 46 as u8 {
        if (*((name + 2) as *mut u8)) == 0 as u8 {
            return true
        }
    }
    return false
}

// ------------------------------------------------------------ sortieren
//
// Einfuegesortierung ueber eine Indexfolge -- bei hoechstens
// sechsundneunzig Eintraegen ist alles andere Zierat. Verzeichnisse
// kommen IMMER zuerst; das ist keine Sortierung nach einer Spalte,
// sondern die Ordnung, in der ein Baum gelesen wird.
// `ulib.cmp` GIBT 1 FUER "KLEINER", 2 FUER "GROESSER" UND 0 FUER
// GLEICH -- nicht -1/0/1 wie `strcmp`. Die erste Fassung dieser Datei
// verglich auf `== 0`, also auf GLEICHHEIT, und sortierte damit
// ueberhaupt nicht: die Tabelle stand in der Reihenfolge, in der das
// Verzeichnis auf der Platte liegt. Im Bild sah man Namen, und sie
// waren sogar richtig -- nur an der falschen Stelle. Gefunden hat es
// der Vergleich mit `tools/k15/tree.py`, der die Reihenfolge kennt,
// und nicht das Auge.
fn kleiner(a: u64, b: u64) -> bool {
    if art[(a) as usize] != art[(b) as usize] {
        return art[(a) as usize] > art[(b) as usize]
    }
    var r: bool = false
    if sortby == 1 {
        if groesse[(a) as usize] != groesse[(b) as usize] {
            r = groesse[(a) as usize] < groesse[(b) as usize]
        } else {
            r = ulib.cmp(nptr(a), nptr(b)) == 1
        }
    } else if sortby == 3 {
        if modus[(a) as usize] != modus[(b) as usize] {
            r = modus[(a) as usize] < modus[(b) as usize]
        } else {
            r = ulib.cmp(nptr(a), nptr(b)) == 1
        }
    } else {
        // Spalte 0 (Name) und Spalte 2 (Zeit -- es gibt keine, also
        // bleibt es beim Namen, und das steht im Kopf dieser Datei).
        r = ulib.cmp(nptr(a), nptr(b)) == 1
    }
    if sortrev != 0 {
        return !r
    }
    return r
}

// Im Normalfall sortiert `expmodell` (vier Spalten, echte Zeit); hier
// bleibt der Einfuegesortierer fuer die beiden Sicherungsansichten.
fn sortiere() {
    if vmodus == 0 {
        expmodell.setz_sort(sortby, sortrev)
        expmodell.sortiere()
        return
    }
    var i: u64 = 0
    while i < anzahl {
        folge[(i) as usize] = i
        i = i + 1
    }
    i = 1
    while i < anzahl {
        let v: u64 = folge[(i) as usize]
        var k: u64 = i
        while k > 0 && kleiner(v, folge[(k - 1) as usize]) {
            folge[(k) as usize] = folge[(k - 1) as usize]
            k = k - 1
        }
        folge[(k) as usize] = v
        i = i + 1
    }
}

// ------------------------------------------------------- die Textbloecke

static mut tp: u64 = 0

fn put(c: u64) {
    if tp < 6100 {
        tblob[(tp) as usize] = c as u8
        tp = tp + 1
    }
}

fn puts(p: u64) {
    var k: u64 = 0
    while (*((p + k) as *mut u8)) != 0 as u8 {
        put((*((p + k) as *mut u8)) as u64)
        k = k + 1
    }
}

fn putn(v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    let n: u64 = ulib.digits(v, (&d[0 as usize]) as u64)
    var k: u64 = 0
    while k < n {
        put((d[(k) as usize]) as u64)
        k = k + 1
    }
}

// Die Rechte, GEBAUT AUS DEN BITS, die `stat` gemeldet hat -- nicht
// hingeschrieben. Neun Bit, drei Gruppen, und das Artzeichen davor.
fn putmode(m: u64, dir: u64) {
    if dir != 0 {
        put(100) // d
    } else {
        put(45) // -
    }
    var b: u64 = 256
    var k: u64 = 0
    while k < 9 {
        if (m & b) != 0 {
            if k % 3 == 0 {
                put(114) // r
            } else if k % 3 == 1 {
                put(119) // w
            } else {
                put(120) // x
            }
        } else {
            put(45)
        }
        b = b >> 1
        k = k + 1
    }
}

// WHICH ICON A FILE GETS, and it is decided from what `stat` said and
// from the name -- not from a table of file types, which this system
// does not have in Ring 3.  Four kinds, and no more, because a fifth
// that cannot be told apart at sixteen pixels is decoration:
//
//   a directory              a folder
//   anything executable      the terminal glyph, "this one runs"
//   a name ending in .fi,
//   .md, .txt, .s, .sh       a page with lines on it
//   everything else          a blank page
//
// A FILE THAT IS BOTH -- executable AND named .sh -- IS A PROGRAM.
// What a thing DOES beats what it is called; that is the same rule
// round K16 put into `kernel/ftype.fi` when `/tarn.fi` turned out to be
// a program.
fn icon_for(e: u64) -> u64 {
    if art[(e) as usize] != 0 {
        return wlib.icon_tint(wlib.icon_id(icons.FILE_FOLDER), 15904798)
    }
    if (modus[(e) as usize] & 73) != 0 {
        return wlib.icon_tint(wlib.icon_id(icons.FILE_PROGRAM), 8141549)
    }
    if ends_with(nptr(e)) {
        return wlib.icon_tint(wlib.icon_id(icons.FILE_TEXT), 3900150)
    }
    return wlib.icon_tint(wlib.icon_id(icons.FILE_FILE), 9741240)
}

// Does the name end in one of the endings that mean readable text?
// Written out rather than table-driven: five endings, and a table of
// five entries in a language without string arrays is more code than
// the five comparisons.
fn ends_with(p: u64) -> bool {
    var n: u64 = 0
    while (*((p + n) as *mut u8)) != 0 as u8 {
        n = n + 1
    }
    if n < 3 {
        return false
    }
    let a: u64 = (*((p + n - 3) as *mut u8)) as u64
    let b: u64 = (*((p + n - 2) as *mut u8)) as u64
    let c: u64 = (*((p + n - 1) as *mut u8)) as u64
    if a == 46 && b == 102 && c == 105 {
        return true // .fi
    }
    if a == 46 && b == 109 && c == 100 {
        return true // .md
    }
    if a == 46 && b == 115 && c == 104 {
        return true // .sh
    }
    if b == 46 && c == 115 {
        return true // .s
    }
    if n >= 4 {
        let d: u64 = (*((p + n - 4) as *mut u8)) as u64
        if d == 46 && a == 116 && b == 120 && c == 116 {
            return true // .txt
        }
    }
    return false
}

// Im Normalfall baut `expmodell` die Tabelle -- samt echter Ortszeit in
// der Zeitspalte. Nur die beiden Sicherungsansichten bauen sie hier,
// weil ihre Zeilen aus einer Textdatei und nicht aus `stat` kommen.
fn build_table() {
    if vmodus == 0 {
        let _z: u64 = expmodell.table_build(msg.get((&k_cols[0 as usize]) as u64))
        return
    }
    tp = 0
    puts(msg.get((&k_cols[0 as usize]) as u64))
    var i: u64 = 0
    while i < anzahl {
        let e: u64 = folge[(i) as usize]
        symbole[(i) as usize] = icon_for(e)
        puts(nptr(e))
        put(9)
        if art[(e) as usize] != 0 {
            put(45)
            put(45)
        } else {
            putn(groesse[(e) as usize])
        }
        put(9)
        // DIE ZEIT: in einer SICHERUNG steht sie im Kopf des
        // Schnappschusses und kommt aus der CMOS-Uhr.
        if (*((zptr(e)) as *mut u8)) != 0 as u8 {
            puts(zptr(e))
        } else {
            put(45)
            put(45)
        }
        put(9)
        putmode(modus[(e) as usize], art[(e) as usize])
        put(10)
        i = i + 1
    }
    put(0)
}

// Wo der Text der Tabelle liegt und wo ihre Symbole liegen -- beides
// haengt am Modus, und beide Adressen sind statisch, wie es
// `wlib.set_text`/`row_icons` verlangen.
fn tab_text() -> u64 {
    if vmodus == 0 {
        return expmodell.table_ptr()
    }
    return (&tblob[0 as usize]) as u64
}

fn tab_icons() -> u64 {
    if vmodus == 0 {
        return expmodell.symbole_ptr()
    }
    return (&symbole[0 as usize]) as u64
}

fn build_tree() {
    var bp: u64 = 0
    var auf: [u8; 4] = "..\0\0"
    // The first row of the tree is the way up, and it is not a folder --
    // it is a MOVE.  An arrow says that and a folder does not.
    bsymbole[0 as usize] = wlib.icon_id(icons.NAV_UP)
    var bz: u64 = 1
    var k: u64 = 0
    while (*(((&auf[0 as usize]) as u64 + k) as *mut u8)) != 0 as u8 {
        bblob[(bp) as usize] = auf[(k) as usize]
        bp = bp + 1
        k = k + 1
    }
    bblob[(bp) as usize] = 10 as u8
    bp = bp + 1
    var i: u64 = 0
    let n: u64 = m_anzahl()
    while i < n {
        let e: u64 = m_ord(i)
        if m_art(e) != 0 && bp < 980 {
            if bz < 96 {
                bsymbole[(bz) as usize] = wlib.icon_tint(wlib.icon_id(icons.FILE_FOLDER), 15904798)
                bz = bz + 1
            }
            let p: u64 = m_name(e)
            k = 0
            while (*((p + k) as *mut u8)) != 0 as u8 && bp < 980 {
                bblob[(bp) as usize] = *((p + k) as *mut u8)
                bp = bp + 1
                k = k + 1
            }
            bblob[(bp) as usize] = 10 as u8
            bp = bp + 1
        }
        i = i + 1
    }
    bblob[(bp) as usize] = 0 as u8
}

fn baue_status() {
    var bytes: u64 = 0
    var dirs: u64 = 0
    var i: u64 = 0
    let n: u64 = m_anzahl()
    while i < n {
        let e: u64 = m_ord(i)
        if m_art(e) != 0 {
            dirs = dirs + 1
        } else {
            bytes = bytes + m_size(e)
        }
        i = i + 1
    }
    let s1: u64 = msg.get((&k_items[0 as usize]) as u64)
    let s2: u64 = msg.get((&k_folders[0 as usize]) as u64)
    let s3: u64 = msg.get((&k_octets[0 as usize]) as u64)
    var lp: u64 = 0
    var d: [u8; 24] = [0 as u8; 24]
    lp = anhaengen(lp, (&d[0 as usize]) as u64, n,
        s1)
    lp = anhaengen(lp, (&d[0 as usize]) as u64, dirs,
        s2)
    lp = anhaengen(lp, (&d[0 as usize]) as u64, bytes,
        s3)
    lauf[(lp) as usize] = 0 as u8
}

fn anhaengen(lp0: u64, d: u64, v: u64, txt: u64) -> u64 {
    var lp: u64 = lp0
    let n: u64 = ulib.digits(v, d)
    var k: u64 = 0
    while k < n && lp < 90 {
        lauf[(lp) as usize] = *((d + k) as *mut u8)
        lp = lp + 1
        k = k + 1
    }
    k = 0
    while (*((txt + k) as *mut u8)) != 0 as u8 && lp < 90 {
        lauf[(lp) as usize] = *((txt + k) as *mut u8)
        lp = lp + 1
        k = k + 1
    }
    return lp
}

// ------------------------------------------------------------- gehen

// EIN SCHRITT IN DIE HISTORIE. Voll heisst NICHT "ab jetzt nichts
// mehr": bis zu dieser Runde stand hier `if hist_n >= 8 { return }` --
// nach acht Ordnern merkte sich der Dateimanager stumm gar nichts mehr,
// und "Zurueck" fuehrte an eine Stelle, an der man vor einer Stunde
// war. Jetzt RUTSCHT die Reihe: der aelteste Eintrag faellt vorn
// heraus, alle anderen ruecken einen Platz nach unten, und der neue
// kommt hinten dazu -- das Verhalten jedes Browsers und jedes
// Dateimanagers.
// ====================================================== RUNDE ALLTAG
//
// DIE REITER. Fuenf kurze Funktionen, und alle fuenf arbeiten auf
// EINEM Feld von Pfaden (`reiter_pfad`) plus der Nummer des sichtbaren
// (`reiter_at`). Mehr Zustand gibt es nicht -- was ein Reiter ANZEIGT,
// rechnet `new_read` aus `pfad` wie immer.

fn reiter_p(i: u64) -> u64 {
    return (&reiter_pfad[(i * REITER_B) as usize]) as u64
}

// Den Namen eines Pfades fuer die Beschriftung: das letzte Stueck
// hinter dem Schraegstrich. "/" selbst bleibt "/", denn ein leerer
// Reiter waere nicht anklickbar.
fn reiter_name(pf: u64, aus: u64, max: u64) -> u64 {
    let n: u64 = ulib.length(pf)
    if n == 0 {
        return 0
    }
    // Die Wurzel heisst "/" und nicht "" -- ein Reiter ohne
    // Beschriftung waere ein paar Bildpunkte breit und nicht
    // anklickbar.
    if n == 1 {
        return ulib.strncpy(aus, pf, max)
    }
    var ab: u64 = 0
    var k: u64 = 0
    while k < n {
        if (*((pf + k) as *mut u8)) == 47 as u8 && k + 1 < n {
            ab = k + 1
        }
        k = k + 1
    }
    return ulib.strncpy(aus, pf + ab, max)
}

// ZWEI REITER MIT DEMSELBEN NAMEN sind nicht auseinanderzuhalten, und
// das passiert sofort: Strg+T oeffnet den neuen im SELBEN Ordner, also
// heissen beide gleich. Deshalb bekommt jeder Reiter seine NUMMER
// vorangestellt, sobald es mehr als einen gibt -- "1 data", "2 data".
//
// Gemessen und deshalb geaendert: im ersten Lauf dieser Runde standen
// zwei Reiter "data" nebeneinander, und auf dem Bild war nicht zu
// sehen, welcher welcher ist (pruef/shots/reiter/04-*.png).
fn reiter_beschriftung(i: u64, aus: u64, max: u64) -> u64 {
    var at: u64 = 0
    if reiter_n > 1 {
        __mmio_write8((aus) as *mut u8, (49 + i) as u8)
        __mmio_write8((aus + 1) as *mut u8, 32 as u8)
        at = 2
    }
    return at + reiter_name(reiter_p(i), aus + at, max - at)
}

// Den sichtbaren Reiter auf den Pfad bringen, der gerade gilt. Wird
// VOR jedem Wechsel gerufen -- sonst zeigt der alte Reiter nachher
// dorthin, wo der neue steht.
fn reiter_merken() {
    if reiter_at < REITER_MAX {
        ulib.strncpy(reiter_p(reiter_at), (&pfad[0 as usize]) as u64,
            REITER_B - 1)
    }
}

// EINEN NEUEN REITER: Strg+T. Er beginnt dort, wo der jetzige steht --
// das ist die Erwartung aus jedem Browser, und es ist auch das
// Nuetzliche: von hier aus weitergehen, ohne die Stelle zu verlieren.
fn reiter_neu(baum: u64, tab: u64, stat: u64, fpfad: u64) {
    if reiter_n >= REITER_MAX {
        var s_voll: [u8; 22] = "explorer: reiter voll\0"
        say((&s_voll[0 as usize]) as u64)
        nl()
        return
    }
    reiter_merken()
    // Hinter den sichtbaren einfuegen, nicht ans Ende: so steht der
    // neue neben dem, aus dem er kommt.
    var i: u64 = reiter_n
    while i > reiter_at + 1 {
        ulib.strncpy(reiter_p(i), reiter_p(i - 1), REITER_B - 1)
        i = i - 1
    }
    ulib.strncpy(reiter_p(reiter_at + 1), (&pfad[0 as usize]) as u64,
        REITER_B - 1)
    reiter_n = reiter_n + 1
    reiter_at = reiter_at + 1
    reiter_text_bauen()
    new_read(baum, tab, stat, fpfad)
}

// EINEN REITER SCHLIESSEN: Strg+W. Der letzte laesst sich NICHT
// schliessen -- ein Dateimanager ohne Ordner waere ein leeres Fenster,
// und das Fenster zu schliessen ist eine andere Tat mit einem anderen
// Knopf.
fn reiter_zu(baum: u64, tab: u64, stat: u64, fpfad: u64) {
    if reiter_n <= 1 {
        var s_letzt: [u8; 23] = "explorer: reiter letzt\0"
        say((&s_letzt[0 as usize]) as u64)
        nl()
        return
    }
    var i: u64 = reiter_at
    while i + 1 < reiter_n {
        ulib.strncpy(reiter_p(i), reiter_p(i + 1), REITER_B - 1)
        i = i + 1
    }
    reiter_n = reiter_n - 1
    if reiter_at >= reiter_n {
        reiter_at = reiter_n - 1
    }
    ulib.strncpy((&pfad[0 as usize]) as u64, reiter_p(reiter_at), 126)
    reiter_text_bauen()
    new_read(baum, tab, stat, fpfad)
}

fn reiter_wechsel(nr: u64, baum: u64, tab: u64, stat: u64, fpfad: u64) {
    if nr >= reiter_n || nr == reiter_at {
        return
    }
    reiter_merken()
    reiter_at = nr
    ulib.strncpy((&pfad[0 as usize]) as u64, reiter_p(reiter_at), 126)
    reiter_text_bauen()
    hist_push((&pfad[0 as usize]) as u64)
    new_read(baum, tab, stat, fpfad)
}

fn hist_push(p: u64) {
    if hist_at >= HISTN {
        // Voll: einen Platz nach vorn schieben. 63 * 128 Oktette sind
        // 8 KiB Umkopieren im schlimmsten Fall, und der Fall tritt
        // frueheste beim 65. Ordnerwechsel ein.
        var i: u64 = 0
        while i < HISTN - 1 {
            var q: u64 = 0
            while q < HISTB {
                hist[(i * HISTB + q) as usize] =
                    hist[((i + 1) * HISTB + q) as usize]
                q = q + 1
            }
            i = i + 1
        }
        hist_at = HISTN - 1
        hist_n = HISTN - 1
    }
    var k: u64 = 0
    while k < HISTB - 8 && (*((p + k) as *mut u8)) != 0 as u8 {
        hist[(hist_at * HISTB + k) as usize] = *((p + k) as *mut u8)
        k = k + 1
    }
    hist[(hist_at * HISTB + k) as usize] = 0 as u8
    hist_at = hist_at + 1
    hist_n = hist_at
    var s_h: [u8; 18] = "explorer: hist n=\0"
    var s_a: [u8; 5] = " at=\0"
    say((&s_h[0 as usize]) as u64)
    sayn(hist_n)
    say((&s_a[0 as usize]) as u64)
    sayn(hist_at)
    nl()
}

fn hist_get(i: u64) -> u64 {
    return (&hist[0 as usize]) as u64 + i * HISTB
}

fn eltern(p: u64) {
    var n: u64 = ulib.length(p)
    if n <= 1 {
        return
    }
    if (*((p + n - 1) as *mut u8)) == 47 as u8 {
        n = n - 1
    }
    while n > 1 && (*((p + n - 1) as *mut u8)) != 47 as u8 {
        n = n - 1
    }
    if n > 1 {
        n = n - 1
    }
    __mmio_write8((p + n) as *mut u8, 0 as u8)
}

// ==================================================== DIE ANORDNUNG
//
// RUNDE EXPLORER-2, Beleg 18-maximiert.png: DAS LAYOUT WIRD BEI JEDER
// GROESSENAENDERUNG NEU GERECHNET.
//
// Befund, gemessen: die vier Kaesten dieser Seite (Menueleiste,
// Werkzeugleiste, Inhalt, Statuszeile) bekamen ihre Ecken und Masse
// EINMAL beim Aufbau, aus `bh` = 430. `wlib.relayout` zieht bei einem
// Groessenwechsel nur Kaesten mit, deren Breite 0 ist -- diese hier
// haben eine gerechnete Breite. Nach dem Maximieren stand die
// Statuszeile also weiter bei y 390, die Tabelle war 300 hoch, und
// darunter lagen 400 Bildpunkte leere Flaeche: genau das leere Bild
// aus 18-maximiert.png.
//
// Darum stehen die Masse jetzt in EINER Funktion (`masse`), die
// Kastennummern und die zwei Bedienelemente, deren Groesse mitwaechst,
// in Statiks -- und `anordnen` setzt beides mit `box_at` /
// `setz_groesse` neu und laesst `wlib.neu_setzen` alles noch einmal
// anordnen. Aufgerufen wird es beim Aufbau UND bei jedem Durchlauf der
// Ereignisschleife, in dem sich `wlib.win_w/win_h` geaendert haben.
// RUNDE EXPLORER-2, Pflichtpunkt 6: SEITENLEISTE UND BROSAMEN.
//
// Die Seite hat jetzt fuenf Reihen statt vier -- Menueleiste,
// Werkzeugleiste, Brosamenleiste, Inhalt, Statuszeile -- und der
// Inhalt zwei Spalten: links ein SENKRECHTER Kasten mit den Orten
// (aus `exporte`, oben) und dem Baum (darunter), rechts die Tabelle.
// Die Brosamenleiste traegt je ein GLIED als eigenen Knopf; Strg+L
// blendet sie aus und das Textfeld ein, wie es Nautilus und der
// Explorer tun.
static mut c_krume: u64 = 0xFFFFFFFFFFFFFFFF
static mut c_reiter: u64 = 0xFFFFFFFFFFFFFFFF
static mut c_seite: u64 = 0xFFFFFFFFFFFFFFFF
static mut a_orte: u64 = 0xFFFFFFFFFFFFFFFF
static mut a_pfad: u64 = 0xFFFFFFFFFFFFFFFF
// MAXKRUME aus `exporte` ist 12; mehr Glieder zeigt kein Weg an.
static mut krumeb: [u64; 12] = [0xFFFFFFFFFFFFFFFF as u64; 12]
