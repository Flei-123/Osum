// ===================================================================
// RUNDE TRESOR, ZWEITER NACHTRAG: SICHERN UND ZURUECKHOLEN.
//
// Der ganze Sinn ist ein Satz: Stick anstecken, hineingehen, "Backup
// hierhin sichern" -- fertig. Was darunter liegt, ist KEINE grosse
// Datei und kein ZIP, sondern ein VERZEICHNIS aus Bloecken, die sich
// alle Sicherungen teilen (`kernel/user/bstore.fi` erklaert, warum).
// Kluges Format unten, ein Menuepunkt oben.
//
// UND ES IST DIESELBE UMSETZUNG wie in `/bin/backup`. Der Dateimanager
// hat KEINE eigene Fassung von "Baum durchgehen und hashen" -- er ruft
// `bstore` auf. Zwei Fassungen driften, und der Tag, an dem sie sich
// uneins sind, ist der Tag, an dem jemand eine Wiederherstellung
// braucht.
//
// DREI ANSICHTEN, und `vmodus` sagt, welche gilt:
//   0  ein ganz gewoehnliches Verzeichnis
//   1  ein Sicherungsspeicher: die Liste der SICHERUNGEN, mit Datum,
//      Anzahl Dateien und Groesse
//   2  IN einer Sicherung: die Dateien darin, zum Hineingehen wie in
//      einen Ordner und zum einzelnen Zurueckholen
static mut vmodus: u64 = 0
static mut vspeicher: [u8; 128] = [0 as u8; 128] // wo der Speicher liegt
static mut vsicher: [u8; 64] = [0 as u8; 64]     // welche Sicherung
static mut vunter: [u8; 160] = [0 as u8; 160]    // wo darin
static mut vctx: [u8; 528] = [0 as u8; 528]
static mut vpfad: [u8; 256] = [0 as u8; 256]
static mut vinfo: [u64; 4] = [0 as u64; 4]
static mut zeiten: [u8; 1920] = [0 as u8; 1920]  // MAXENT * 20, das Datum
static mut pbuf: [u8; 128] = [0 as u8; 128]      // der Fortschrittstext
static mut plabel: u64 = 0xFFFFFFFFFFFFFFFF
static mut pziel: [u8; 128] = [0 as u8; 128]

static mut k_t_pop: [u8; 24] = "explorer.context.backup\0"
static mut k_t_popb: [u8; 25] = "explorer.context.restore\0"
static mut k_t_bak: [u8; 22] = "explorer.backup.title\0"
static mut k_t_bfrage: [u8; 20] = "explorer.backup.ask\0"
static mut t_bquelle: [u8; 6] = "/data\0"
static mut t_bwohin: [u8; 6] = "/data\0"
static mut k_t_lauft: [u8; 24] = "explorer.backup.running\0"
static mut t_snap: [u8; 10] = "sicherung\0"
static mut k_t_selbst2: [u8; 24] = "explorer.backup.notself\0"

static mut dlg_gemeldet: bool = false
static mut sortby: u64 = 0
static mut sortrev: u64 = 0

fn say(p: u64) {
    ulib.say(p)
}

fn kv(name: u64, v: u64) {
    var sp: [u8; 2] = " \0"
    say(name)
    ulib.sayn(v)
    say((&sp[0 as usize]) as u64)
}

fn nptr(i: u64) -> u64 {
    return (&namen[0 as usize]) as u64 + i * NAMEB
}

// -------------------------------------------------- das Verzeichnis lesen

fn join(dir: u64, name: u64) -> u64 {
    let out: u64 = (&vollpfad[0 as usize]) as u64
    var n: u64 = 0
    while (*((dir + n) as *mut u8)) != 0 as u8 && n < 150 {
        __mmio_write8((out + n) as *mut u8, *((dir + n) as *mut u8))
        n = n + 1
    }
    if n > 1 || (*((out) as *mut u8)) != 47 as u8 {
        if n == 0 || (*((out + n - 1) as *mut u8)) != 47 as u8 {
            __mmio_write8((out + n) as *mut u8, 47 as u8)
            n = n + 1
        }
    }
    var k: u64 = 0
    while (*((name + k) as *mut u8)) != 0 as u8 && n < 190 {
        __mmio_write8((out + n) as *mut u8, *((name + k) as *mut u8))
        n = n + 1
        k = k + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return out
}

fn scan(dir: u64) -> u64 {
    var puffer: [u8; 1024] = [0 as u8; 1024]
    anzahl = 0
    let fd: u64 = io.dir_open(dir)
    if ulib.bad(fd) {
        return fd
    }
    var weiter: bool = true
    while weiter {
        let n: u64 = io.dir_read(fd, (&puffer[0 as usize]) as u64, 1024)
        if ulib.bad(n) || n == 0 {
            weiter = false
        } else {
            var at: u64 = 0
            while at < n {
                let rec: u64 = (&puffer[0 as usize]) as u64 + at
                let rl: u64 = io.dir_reclen(rec)
                if rl == 0 {
                    at = n
                } else {
                    let name: u64 = io.dir_name(rec)
                    if !punkt(name) && anzahl < MAXENT {
                        ulib.strncpy(nptr(anzahl), name, NAMEB - 1)
                        let voll: u64 = join(dir, name)
                        let m: u64 = io.stat_mode(voll)
                        var gr: u64 = 0
                        if !ulib.bad(m) {
                            let s2: u64 = io.size_of(voll)
                            if !ulib.bad(s2) {
                                gr = s2
                            }
                            modus[(anzahl) as usize] = m
                            if io.is_dir_mode(m) {
                                art[(anzahl) as usize] = 1
                            } else {
                                art[(anzahl) as usize] = 0
                            }
                        } else {
                            modus[(anzahl) as usize] = 0
                            art[(anzahl) as usize] = io.dir_kind(rec)
                        }
                        groesse[(anzahl) as usize] = gr
                        anzahl = anzahl + 1
                    }
                    at = at + rl
                }
            }
        }
    }
    io.close(fd)
    return anzahl
}

// Wo das Datum der Zeile i liegt (wie `nptr`, nur fuer die Zeitspalte).
fn zptr(i: u64) -> u64 {
    return (&zeiten[0 as usize]) as u64 + i * 20
}

// ANSICHT 1: die Sicherungen eines Speichers. Jede bekommt ihr Datum aus
// dem Kopf des Schnappschusses und ihre Zahlen aus dessen `end`-Zeile --
// eine Sicherung OHNE `end` ist unvollstaendig und wird gar nicht erst
// angezeigt, denn sie ist keine.
fn scan_speicher() -> u64 {
    var namebuf: [u8; 64] = [0 as u8; 64]
    anzahl = 0
    let fd: u64 = bstore.snaps_open((&vspeicher[0 as usize]) as u64)
    if ulib.bad(fd) {
        return 0
    }
    var weiter: bool = true
    while weiter {
        if !bstore.snaps_next(fd, (&namebuf[0 as usize]) as u64, 60) {
            weiter = false
        } else if anzahl < MAXENT {
            if bstore.snap_head((&vspeicher[0 as usize]) as u64,
                    (&namebuf[0 as usize]) as u64, zptr(anzahl),
                    (&vinfo[0 as usize]) as u64) {
                if vinfo[(2) as usize] != 0 {
                    ulib.strncpy(nptr(anzahl), (&namebuf[0 as usize]) as u64,
                        NAMEB - 1)
                    groesse[(anzahl) as usize] = vinfo[(1) as usize]
                    art[(anzahl) as usize] = 1
                    modus[(anzahl) as usize] = 16877
                    anzahl = anzahl + 1
                }
            }
        }
    }
    io.close(fd)
    return anzahl
}

// ANSICHT 2: was IN einer Sicherung unter `vunter` liegt. Der
// Schnappschuss ist eine Textdatei mit vollen Pfaden; angezeigt wird,
// was genau eine Ebene tiefer liegt -- damit laesst er sich begehen wie
// ein Ordner, ohne dass irgendwo ein Baum gebaut werden muss.
fn scan_sicherung() -> u64 {
    anzahl = 0
    let pl: u64 = ulib.length((&vunter[0 as usize]) as u64)
    let fd: u64 = bstore.entries_open((&vspeicher[0 as usize]) as u64,
        (&vsicher[0 as usize]) as u64, (&vctx[0 as usize]) as u64)
    if ulib.bad(fd) {
        return 0
    }
    var weiter: bool = true
    while weiter {
        if !bstore.entries_next(fd, (&vctx[0 as usize]) as u64,
                (&vpfad[0 as usize]) as u64, (&vinfo[0 as usize]) as u64) {
            weiter = false
        } else if anzahl < MAXENT {
            // Passt der Anfang? Und ist danach GENAU EIN Namensteil?
            if pl == 0 || ulib.strneq((&vpfad[0 as usize]) as u64,
                    (&vunter[0 as usize]) as u64, pl) {
                let rest: u64 = (&vpfad[0 as usize]) as u64 + pl
                if (*((rest) as *mut u8)) == 47 as u8 {
                    var k: u64 = 1
                    var tiefer: bool = false
                    while (*((rest + k) as *mut u8)) != 0 as u8 {
                        if (*((rest + k) as *mut u8)) == 47 as u8 {
                            tiefer = true
                        }
                        k = k + 1
                    }
                    if !tiefer && k > 1 {
                        ulib.strncpy(nptr(anzahl), rest + 1, NAMEB - 1)
                        groesse[(anzahl) as usize] = vinfo[(1) as usize]
                        modus[(anzahl) as usize] = vinfo[(0) as usize]
                        if (vinfo[(0) as usize] & 61440) == 16384 {
                            art[(anzahl) as usize] = 1
                        } else {
                            art[(anzahl) as usize] = 0
                        }
                        __mmio_write8((zptr(anzahl)) as *mut u8, 0 as u8)
                        anzahl = anzahl + 1
                    }
                }
            }
        }
    }
    io.close(fd)
    return anzahl
}

// DER VOLLE PFAD EINER ZEILE INNERHALB DER SICHERUNG -- `vunter` plus
// der Name. Das ist genau der Schluessel, unter dem `bstore.get` die
// Datei wiederfindet.
fn in_sicherung(e: u64) -> u64 {
    var sl: [u8; 2] = "/\0"
    ulib.strncpy((&vpfad[0 as usize]) as u64,
        (&vunter[0 as usize]) as u64, 200)
    ulib.strcat((&vpfad[0 as usize]) as u64, (&sl[0 as usize]) as u64)
    ulib.strcat((&vpfad[0 as usize]) as u64, nptr(e))
    return (&vpfad[0 as usize]) as u64
}

fn punkt(name: u64) -> bool {
    if (*((name) as *mut u8)) != 46 as u8 {
        return false
    }
    if (*((name + 1) as *mut u8)) == 0 as u8 {
        return true
    }
    if (*((name + 1) as *mut u8)) == 46 as u8 {
        if (*((name + 2) as *mut u8)) == 0 as u8 {
            return true
        }
    }
    return false
}

// ------------------------------------------------------------ sortieren
//
// Einfuegesortierung ueber eine Indexfolge -- bei hoechstens
// sechsundneunzig Eintraegen ist alles andere Zierat. Verzeichnisse
// kommen IMMER zuerst; das ist keine Sortierung nach einer Spalte,
// sondern die Ordnung, in der ein Baum gelesen wird.
// `ulib.cmp` GIBT 1 FUER "KLEINER", 2 FUER "GROESSER" UND 0 FUER
// GLEICH -- nicht -1/0/1 wie `strcmp`. Die erste Fassung dieser Datei
// verglich auf `== 0`, also auf GLEICHHEIT, und sortierte damit
// ueberhaupt nicht: die Tabelle stand in der Reihenfolge, in der das
// Verzeichnis auf der Platte liegt. Im Bild sah man Namen, und sie
// waren sogar richtig -- nur an der falschen Stelle. Gefunden hat es
// der Vergleich mit `tools/k15/tree.py`, der die Reihenfolge kennt,
// und nicht das Auge.
fn kleiner(a: u64, b: u64) -> bool {
    if art[(a) as usize] != art[(b) as usize] {
        return art[(a) as usize] > art[(b) as usize]
    }
    var r: bool = false
    if sortby == 1 {
        if groesse[(a) as usize] != groesse[(b) as usize] {
            r = groesse[(a) as usize] < groesse[(b) as usize]
        } else {
            r = ulib.cmp(nptr(a), nptr(b)) == 1
        }
    } else if sortby == 3 {
        if modus[(a) as usize] != modus[(b) as usize] {
            r = modus[(a) as usize] < modus[(b) as usize]
        } else {
            r = ulib.cmp(nptr(a), nptr(b)) == 1
        }
    } else {
        // Spalte 0 (Name) und Spalte 2 (Zeit -- es gibt keine, also
        // bleibt es beim Namen, und das steht im Kopf dieser Datei).
        r = ulib.cmp(nptr(a), nptr(b)) == 1
    }
    if sortrev != 0 {
        return !r
    }
    return r
}

fn sortiere() {
    var i: u64 = 0
    while i < anzahl {
        folge[(i) as usize] = i
        i = i + 1
    }
    i = 1
    while i < anzahl {
        let v: u64 = folge[(i) as usize]
        var k: u64 = i
        while k > 0 && kleiner(v, folge[(k - 1) as usize]) {
            folge[(k) as usize] = folge[(k - 1) as usize]
            k = k - 1
        }
        folge[(k) as usize] = v
        i = i + 1
    }
}

// ------------------------------------------------------- die Textbloecke

static mut tp: u64 = 0

fn put(c: u64) {
    if tp < 6100 {
        tblob[(tp) as usize] = c as u8
        tp = tp + 1
    }
}

fn puts(p: u64) {
    var k: u64 = 0
    while (*((p + k) as *mut u8)) != 0 as u8 {
        put((*((p + k) as *mut u8)) as u64)
        k = k + 1
    }
}

fn putn(v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    let n: u64 = ulib.digits(v, (&d[0 as usize]) as u64)
    var k: u64 = 0
    while k < n {
        put((d[(k) as usize]) as u64)
        k = k + 1
    }
}

// Die Rechte, GEBAUT AUS DEN BITS, die `stat` gemeldet hat -- nicht
// hingeschrieben. Neun Bit, drei Gruppen, und das Artzeichen davor.
fn putmode(m: u64, dir: u64) {
    if dir != 0 {
        put(100) // d
    } else {
        put(45) // -
    }
    var b: u64 = 256
    var k: u64 = 0
    while k < 9 {
        if (m & b) != 0 {
            if k % 3 == 0 {
                put(114) // r
            } else if k % 3 == 1 {
                put(119) // w
            } else {
                put(120) // x
            }
        } else {
            put(45)
        }
        b = b >> 1
        k = k + 1
    }
}

// WHICH ICON A FILE GETS, and it is decided from what `stat` said and
// from the name -- not from a table of file types, which this system
// does not have in Ring 3.  Four kinds, and no more, because a fifth
// that cannot be told apart at sixteen pixels is decoration:
//
//   a directory              a folder
//   anything executable      the terminal glyph, "this one runs"
//   a name ending in .fi,
//   .md, .txt, .s, .sh       a page with lines on it
//   everything else          a blank page
//
// A FILE THAT IS BOTH -- executable AND named .sh -- IS A PROGRAM.
// What a thing DOES beats what it is called; that is the same rule
// round K16 put into `kernel/ftype.fi` when `/tarn.fi` turned out to be
// a program.
fn symbol_fuer(e: u64) -> u64 {
    if art[(e) as usize] != 0 {
        return wlib.icon_id(icons.FILE_FOLDER)
    }
    if (modus[(e) as usize] & 73) != 0 {
        return wlib.icon_id(icons.FILE_PROGRAM)
    }
    if endet_auf(nptr(e)) {
        return wlib.icon_id(icons.FILE_TEXT)
    }
    return wlib.icon_id(icons.FILE_FILE)
}

// Does the name end in one of the endings that mean readable text?
// Written out rather than table-driven: five endings, and a table of
// five entries in a language without string arrays is more code than
// the five comparisons.
fn endet_auf(p: u64) -> bool {
    var n: u64 = 0
    while (*((p + n) as *mut u8)) != 0 as u8 {
        n = n + 1
    }
    if n < 3 {
        return false
    }
    let a: u64 = (*((p + n - 3) as *mut u8)) as u64
    let b: u64 = (*((p + n - 2) as *mut u8)) as u64
    let c: u64 = (*((p + n - 1) as *mut u8)) as u64
    if a == 46 && b == 102 && c == 105 {
        return true // .fi
    }
    if a == 46 && b == 109 && c == 100 {
        return true // .md
    }
    if a == 46 && b == 115 && c == 104 {
        return true // .sh
    }
    if b == 46 && c == 115 {
        return true // .s
    }
    if n >= 4 {
        let d: u64 = (*((p + n - 4) as *mut u8)) as u64
        if d == 46 && a == 116 && b == 120 && c == 116 {
            return true // .txt
        }
    }
    return false
}

fn baue_tabelle() {
    tp = 0
    puts(msg.get((&k_cols[0 as usize]) as u64))
    var i: u64 = 0
    while i < anzahl {
        let e: u64 = folge[(i) as usize]
        symbole[(i) as usize] = symbol_fuer(e)
        puts(nptr(e))
        put(9)
        if art[(e) as usize] != 0 {
            put(45)
            put(45)
        } else {
            putn(groesse[(e) as usize])
        }
        put(9)
        // DIE ZEIT: fuer DATEIEN gibt es keine, siehe den Kopf dieser
        // Datei. Fuer eine SICHERUNG gibt es sehr wohl eine -- sie steht
        // im Kopf des Schnappschusses und kommt aus der CMOS-Uhr. Genau
        // deshalb ist die Spalte damals stehen geblieben.
        if (*((zptr(e)) as *mut u8)) != 0 as u8 {
            puts(zptr(e))
        } else {
            put(45)
            put(45)
        }
        put(9)
        putmode(modus[(e) as usize], art[(e) as usize])
        put(10)
        i = i + 1
    }
    put(0)
}

fn baue_baum() {
    var bp: u64 = 0
    var auf: [u8; 4] = "..\0\0"
    // The first row of the tree is the way up, and it is not a folder --
    // it is a MOVE.  An arrow says that and a folder does not.
    bsymbole[0 as usize] = wlib.icon_id(icons.NAV_UP)
    var bz: u64 = 1
    var k: u64 = 0
    while (*(((&auf[0 as usize]) as u64 + k) as *mut u8)) != 0 as u8 {
        bblob[(bp) as usize] = auf[(k) as usize]
        bp = bp + 1
        k = k + 1
    }
    bblob[(bp) as usize] = 10 as u8
    bp = bp + 1
    var i: u64 = 0
    while i < anzahl {
        let e: u64 = folge[(i) as usize]
        if art[(e) as usize] != 0 && bp < 980 {
            if bz < 96 {
                bsymbole[(bz) as usize] = wlib.icon_id(icons.FILE_FOLDER)
                bz = bz + 1
            }
            let p: u64 = nptr(e)
            k = 0
            while (*((p + k) as *mut u8)) != 0 as u8 && bp < 980 {
                bblob[(bp) as usize] = *((p + k) as *mut u8)
                bp = bp + 1
                k = k + 1
            }
            bblob[(bp) as usize] = 10 as u8
            bp = bp + 1
        }
        i = i + 1
    }
    bblob[(bp) as usize] = 0 as u8
}

fn baue_status() {
    var bytes: u64 = 0
    var dirs: u64 = 0
    var i: u64 = 0
    while i < anzahl {
        if art[(i) as usize] != 0 {
            dirs = dirs + 1
        } else {
            bytes = bytes + groesse[(i) as usize]
        }
        i = i + 1
    }
    let s1: u64 = msg.get((&k_items[0 as usize]) as u64)
    let s2: u64 = msg.get((&k_folders[0 as usize]) as u64)
    let s3: u64 = msg.get((&k_octets[0 as usize]) as u64)
    var lp: u64 = 0
    var d: [u8; 24] = [0 as u8; 24]
    lp = anhaengen(lp, (&d[0 as usize]) as u64, anzahl,
        s1)
    lp = anhaengen(lp, (&d[0 as usize]) as u64, dirs,
        s2)
    lp = anhaengen(lp, (&d[0 as usize]) as u64, bytes,
        s3)
    lauf[(lp) as usize] = 0 as u8
}

fn anhaengen(lp0: u64, d: u64, v: u64, txt: u64) -> u64 {
    var lp: u64 = lp0
    let n: u64 = ulib.digits(v, d)
    var k: u64 = 0
    while k < n && lp < 90 {
        lauf[(lp) as usize] = *((d + k) as *mut u8)
        lp = lp + 1
        k = k + 1
    }
    k = 0
    while (*((txt + k) as *mut u8)) != 0 as u8 && lp < 90 {
        lauf[(lp) as usize] = *((txt + k) as *mut u8)
        lp = lp + 1
        k = k + 1
    }
    return lp
}

// ------------------------------------------------------------- gehen

fn hist_push(p: u64) {
    if hist_n >= 8 {
        return
    }
    var k: u64 = 0
    while k < 120 && (*((p + k) as *mut u8)) != 0 as u8 {
        hist[(hist_at * 128 + k) as usize] = *((p + k) as *mut u8)
        k = k + 1
    }
    hist[(hist_at * 128 + k) as usize] = 0 as u8
    hist_at = hist_at + 1
    hist_n = hist_at
}

fn hist_get(i: u64) -> u64 {
    return (&hist[0 as usize]) as u64 + i * 128
}

fn eltern(p: u64) {
    var n: u64 = ulib.length(p)
    if n <= 1 {
        return
    }
    if (*((p + n - 1) as *mut u8)) == 47 as u8 {
        n = n - 1
    }
    while n > 1 && (*((p + n - 1) as *mut u8)) != 47 as u8 {
        n = n - 1
    }
    if n > 1 {
        n = n - 1
    }
    __mmio_write8((p + n) as *mut u8, 0 as u8)
}

// ------------------------------------------------------------- Programm

fn u_start(args: u64) -> u64 {
    var s_no: [u8; 8] = "nohit\0\0\0"
    var s_nc: [u8; 8] = "noclip\0\0"
    var s_bad: [u8; 24] = "explorer: keine Flaeche\0"
    var s_cd: [u8; 16] = "explorer: cd \0\0\0"
    var s_n: [u8; 16] = "explorer: n=\0\0\0\0"
    var s_go: [u8; 16] = "explorer: ready\0"
    var s_start: [u8; 24] = "explorer: start \0\0\0\0\0\0\0\0"
    var s_err: [u8; 24] = "explorer: kein Zugang \0\0"
    var s_op: [u8; 16] = "explorer: op \0\0\0"
    var s_geo: [u8; 24] = "explorer: geom \0\0\0\0\0\0\0\0\0"
    var sx: [u8; 4] = "x=\0\0"
    var sy: [u8; 4] = "y=\0\0"
    var sw: [u8; 4] = "w=\0\0"
    var sh: [u8; 4] = "h=\0\0"

    // RUNDE I18N: DER KATALOG ZUERST -- vor jedem Bedienelement, denn
    // `wlib` behaelt den Zeiger auf dessen Text.
    let _mk: u64 = msg.init()
    // Den Titel des Menuefensters an die Bibliothek durchreichen.
    // wlib hat keinen Katalog (siehe `menu_open`); wer einen hat,
    // gibt ihn weiter, und ohne das stuende dort das englische Wort.
    wlib.set_menu_title(msg.get((&k_mtit[0 as usize]) as u64))
    var nohit: bool = false
    var noclip: bool = false
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        let p: u64 = ulib.arg_at(args, a)
        if ulib.streq(p, (&s_no[0 as usize]) as u64) {
            nohit = true
        }
        if ulib.streq(p, (&s_nc[0 as usize]) as u64) {
            noclip = true
        }
        a = a + 1
    }
    if !wlib.begin(nohit, noclip) {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    // Wo angefangen wird: /data, wenn es das gibt, sonst die Wurzel.
    var start: [u8; 8] = "/data\0\0\0"
    if ulib.is_dir((&start[0 as usize]) as u64) {
        ulib.strcpy((&pfad[0 as usize]) as u64,
            (&start[0 as usize]) as u64)
    }
    // DIE SPALTEN MUESSEN IN DIE TABELLE PASSEN, UND ZWAR VOR DER
    // BILDLAUFLEISTE. Die erste Fassung nahm 200+92+84+96 = 472 und
    // dazu sechs Bildpunkte Einzug -- zusammen 478 in einer Tabelle von
    // 476, von denen die Bildlaufleiste die letzten sechzehn nimmt. Die
    // Spalte "Rechte" lief also unter die Leiste, und die wird NACH den
    // Zeilen gemalt: von 373 Tintenpunkten waren vier weg. Vier. Genau
    // die Sorte Fehler, die man im Bild nicht sieht und die der Pruefer
    // je Zeichen findet. 186+80+76+108 = 450, plus 6 Einzug = 456, und
    // 476 - 16 = 460 sind da.
    spalten[(0) as usize] = 186
    spalten[(1) as usize] = 80
    spalten[(2) as usize] = 76
    spalten[(3) as usize] = 108

    // DER ANZEIGENAME KOMMT AUS DEN DATEN. Gesucht wird der Eintrag,
    // dessen `exec` auf dieses Programm zeigt -- nicht der mit einem
    // bestimmten Dateinamen: wer das Programm umbenennt, benennt dann
    // den Eintrag mit um und nicht eine Zeile hier.
    var s_titel: [u8; 24] = "explorer: name [\0\0\0\0\0\0\0\0"
    var s_zu: [u8; 8] = "] aus [\0"
    var s_end: [u8; 4] = "]\0\0\0"
    let na: u64 = appdir.load((&t_appdir[0 as usize]) as u64, false)
    var quelle: u64 = 0
    var k2: u64 = 0
    while k2 < na {
        if ulib.streq(appdir.exec_of(k2), (&t_selbst[0 as usize]) as u64) {
            ulib.strncpy((&t_titel[0 as usize]) as u64,
                appdir.name_of(k2), 62)
            quelle = appdir.datei_of(k2)
            k2 = na
        } else {
            k2 = k2 + 1
        }
    }
    if (t_titel[0 as usize]) == 0 as u8 {
        // Keine Beschreibung gefunden: dann eben der Aufrufname.
        ulib.strncpy((&t_titel[0 as usize]) as u64, ulib.arg_at(args, 0),
            62)
    }
    say((&s_titel[0 as usize]) as u64)
    say((&t_titel[0 as usize]) as u64)
    say((&s_zu[0 as usize]) as u64)
    if quelle != 0 {
        say(quelle)
    }
    say((&s_end[0 as usize]) as u64)
    ulib.nl()

    let bx: u64 = 70
    let by: u64 = 70
    let bw: u64 = 660
    let bh: u64 = 430
    let w: u64 = wlib.window(bx, by, bw, bh, (&t_titel[0 as usize]) as u64)
    if w >= wlib.MAXWN {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    say((&s_geo[0 as usize]) as u64)
    kv((&sx[0 as usize]) as u64, bx)
    kv((&sy[0 as usize]) as u64, by)
    kv((&sw[0 as usize]) as u64, bw)
    kv((&sh[0 as usize]) as u64, bh)
    ulib.nl()

    wlib.box_v(w, 0, 0, bw, 34, 6, 0)
    let mb: u64 = wlib.menubar(msg.get((&k_menu[0 as usize]) as u64))
    wlib.box_end()

    wlib.box_h(w, 8, 34, bw - 16, 28, 0, 6)
    wlib.size(30, 26)
    let bzur: u64 = wlib.button((&t_zur[0 as usize]) as u64)
    wlib.size(30, 26)
    let bvor: u64 = wlib.button((&t_vor[0 as usize]) as u64)
    wlib.size(30, 26)
    let bauf: u64 = wlib.button((&t_auf[0 as usize]) as u64)
    // DIE SCHALTFLAECHE, ueber die der Starter erreichbar ist. Ein
    // Programmverzeichnis, das man nur mit einem Kommandozeilenwort
    // aufmachen kann, ist keines.
    wlib.size(58, 26)
    let bstart: u64 = wlib.button(msg.get((&k_start[0 as usize]) as u64))
    wlib.size(0, 26)
    let fpfad: u64 = wlib.entry((&pfad[0 as usize]) as u64, 126)
    wlib.box_end()

    wlib.box_h(w, 8, 68, bw - 16, 316, 0, 8)
    wlib.size(160, 316)
    let baum: u64 = wlib.list((&bblob[0 as usize]) as u64, 12)
    wlib.size(0, 316)
    let tab: u64 = wlib.table((&tblob[0 as usize]) as u64, 12, 4,
        (&spalten[0 as usize]) as u64)
    // ROUND ICONS: the two arrays are handed over ONCE and stay the
    // same address for the life of the window.  `baue_tabelle` and
    // `baue_baum` refill them in place whenever the directory changes,
    // exactly as they refill the text blocks -- so a sort or a step
    // into a folder cannot leave the icons behind.
    wlib.row_icons(tab, (&symbole[0 as usize]) as u64)
    wlib.row_icons(baum, (&bsymbole[0 as usize]) as u64)
    wlib.box_end()

    wlib.box_v(w, 8, 390, bw - 16, 26, 0, 0)
    wlib.size(0, 20)
    let stat: u64 = wlib.label((&lauf[0 as usize]) as u64)
    wlib.box_end()

    hist_push((&pfad[0 as usize]) as u64)
    neu_lesen(baum, tab, stat, fpfad)
    wlib.draw_all()
    say((&s_go[0 as usize]) as u64)
    ulib.nl()
    say_rects(mb, bzur, bvor, bauf, fpfad, baum, tab, stat)
    say_rect(bstart)

    var offen: u64 = 0 // 1 = Kontextmenue, 2 = Datei-, 3 = Ansichtsmenue
    var wartet: u64 = 0 // 1 = umbenennen, 2 = neuer Ordner, 3 = loeschen
    var runden: u64 = 0
    while wlib.alive() && runden < 4000000 {
        runden = runden + 1
        let id: u64 = wlib.step()
        if id < wlib.MAXWD {
            let kind: u64 = wlib.fired_kind()
            let idx: u64 = wlib.fired_index()
            if kind == wlib.K_BUTTON {
                if id == bstart {
                    launcher_open()
                } else if id == bauf {
                    eltern((&pfad[0 as usize]) as u64)
                    hist_push((&pfad[0 as usize]) as u64)
                    neu_lesen(baum, tab, stat, fpfad)
                } else if id == bzur {
                    if hist_at > 1 {
                        hist_at = hist_at - 1
                        ulib.strcpy((&pfad[0 as usize]) as u64,
                            hist_get(hist_at - 1))
                        neu_lesen(baum, tab, stat, fpfad)
                    }
                } else if id == bvor {
                    if hist_at < hist_n {
                        hist_at = hist_at + 1
                        ulib.strcpy((&pfad[0 as usize]) as u64,
                            hist_get(hist_at - 1))
                        neu_lesen(baum, tab, stat, fpfad)
                    }
                }
            } else if kind == wlib.K_ENTRY && id == fpfad {
                hist_push((&pfad[0 as usize]) as u64)
                neu_lesen(baum, tab, stat, fpfad)
            } else if kind == wlib.K_LIST {
                // Doppelklick oder Eingabetaste
                if id == tab {
                    oeffnen(idx, baum, tab, stat, fpfad,
                        (&s_start[0 as usize]) as u64)
                } else if id == baum {
                    baum_gehen(idx, baum, tab, stat, fpfad)
                }
            } else if kind == wlib.K_TABLE {
                // die Kopfzeile: nach dieser Spalte sortieren
                if sortby == idx {
                    sortrev = 1 - sortrev
                } else {
                    sortby = idx
                    sortrev = 0
                }
                sortiere()
                baue_tabelle()
                baue_baum()
                wlib.set_text(tab, (&tblob[0 as usize]) as u64)
                wlib.set_text(baum, (&bblob[0 as usize]) as u64)
                say((&s_op[0 as usize]) as u64)
                kv((&sw[0 as usize]) as u64, sortby)
                kv((&sh[0 as usize]) as u64, sortrev)
                ulib.nl()
            } else if kind == wlib.K_SCROLL {
                // rechte Taste auf der Tabelle
                if id == tab {
                    // IN EINER SICHERUNG kann man nichts umbenennen und
                    // nichts loeschen -- da liegt keine Datei, da liegt
                    // ein Eintrag in einer Textdatei. Also ein anderes
                    // Menue, statt Punkte anzubieten, die nicht gehen.
                    if vmodus != 0 {
                        wlib.menu_open(id, wlibc.mouse_x(), wlibc.mouse_y(),
                            msg.get((&k_t_popb[0 as usize]) as u64), 2)
                        say_menurect()
                        offen = 4
                    } else {
                        wlib.menu_open(id, wlibc.mouse_x(), wlibc.mouse_y(),
                            msg.get((&k_ctx[0 as usize]) as u64), 5)
                        say_menurect()
                        offen = 1
                    }
                }
            } else if kind == wlib.K_MENUBAR {
                if idx >= 0x1000 {
                    let m: u64 = idx - 0x1000
                    if m == 0 {
                        wlib.menu_open(id, bx + 10, by + 22 + 30,
                            msg.get((&k_mfile[0 as usize]) as u64), 3)
                        offen = 2
                    } else {
                        wlib.menu_open(id, bx + 70, by + 22 + 30,
                            msg.get((&k_mview[0 as usize]) as u64), 3)
                        offen = 3
                    }
                } else if idx != 0xFFFF {
                    // ROUND NETVIEW: "Netzzugriff" is the one entry that
                    // opens a SECOND menu instead of doing something.
                    // The four views are not a dialogue and not a
                    // settings page -- they are four words, and a menu
                    // is what four words are.
                    if offen == 1 && idx == 4 {
                        wlib.menu_open(id, wlibc.mouse_x(),
                            wlibc.mouse_y(),
                            (&t_views[0 as usize]) as u64, 4)
                        offen = 4
                    } else {
                        wartet = menue_wahl(offen, idx, tab, baum, stat,
                            fpfad)
                        offen = 0
                    }
                } else {
                    offen = 0
                }
            }
        }
        if wlib.dlg_state() == 1 && !dlg_gemeldet {
            say_dlgrect()
            dlg_gemeldet = true
        }
        if wlib.dlg_state() <= 1 {
            // nichts
        } else {
            dlg_gemeldet = false
        }
        if wlib.dlg_state() > 1 {
            if wlib.dlg_state() == 2 {
                vollziehen(wartet, tab, baum, stat, fpfad)
            }
            wartet = 0
            wlib.dlg_close()
            wlib.draw_all()
        }
    }
    let _e: u64 = (s_cd[0 as usize]) as u64
    let _f: u64 = (s_n[0 as usize]) as u64
    let _g: u64 = (s_err[0 as usize]) as u64
    return 0
}

// Den Starter aufmachen -- ein eigenes Programm, ein eigenes Fenster.
fn launcher_open() {
    var pfad2: [u8; 17] = "/bin/launcher\0\0\0\0"
    var s_go: [u8; 25] = "explorer: launcher pid=\0\0"
    let pid: u64 = ulib.sys(ulib.SYS_SPAWN, (&pfad2[0 as usize]) as u64,
        0, 0)
    say((&s_go[0 as usize]) as u64)
    ulib.sayn(pid)
    ulib.nl()
}

fn neu_lesen(baum: u64, tab: u64, stat: u64, fpfad: u64) {
    var s_cd: [u8; 16] = "explorer: cd \0\0\0"
    var s_n: [u8; 8] = " n=\0\0\0\0\0"
    // WELCHE ANSICHT. Der Rest dieser Funktion ist fuer alle drei
    // gleich -- Tabelle, Baum, Statuszeile kennen den Unterschied nicht.
    var r: u64 = 0
    if vmodus == 1 {
        r = scan_speicher()
    } else if vmodus == 2 {
        r = scan_sicherung()
    } else {
        loesche_zeiten()
        r = scan((&pfad[0 as usize]) as u64)
    }
    if ulib.bad(r) {
        anzahl = 0
    }
    sortiere()
    baue_tabelle()
    baue_baum()
    baue_status()
    wlib.set_text(tab, (&tblob[0 as usize]) as u64)
    wlib.set_text(baum, (&bblob[0 as usize]) as u64)
    wlib.set_text(stat, (&lauf[0 as usize]) as u64)
    wlib.set_text(fpfad, (&pfad[0 as usize]) as u64)
    say((&s_cd[0 as usize]) as u64)
    say((&pfad[0 as usize]) as u64)
    say((&s_n[0 as usize]) as u64)
    ulib.sayn(anzahl)
    ulib.nl()
}

fn oeffnen(zeile: u64, baum: u64, tab: u64, stat: u64, fpfad: u64,
    marke: u64) {
    if zeile >= anzahl {
        return
    }
    let e: u64 = folge[(zeile) as usize]
    let name: u64 = nptr(e)
    // IN EINER SICHERUNG: hineingehen heisst tiefer in den
    // Schnappschuss, nicht auf die Platte.
    if vmodus == 2 {
        if art[(e) as usize] != 0 {
            var sl2: [u8; 2] = "/\0"
            ulib.strcat((&vunter[0 as usize]) as u64,
                (&sl2[0 as usize]) as u64)
            ulib.strcat((&vunter[0 as usize]) as u64, name)
            zeige_ort(fpfad)
            neu_lesen(baum, tab, stat, fpfad)
        }
        return
    }
    // IM SPEICHER: eine Zeile ist eine SICHERUNG.
    if vmodus == 1 {
        vmodus = 2
        ulib.strncpy((&vsicher[0 as usize]) as u64, name, 60)
        vunter[(0) as usize] = 0 as u8
        zeige_ort(fpfad)
        neu_lesen(baum, tab, stat, fpfad)
        return
    }
    if art[(e) as usize] != 0 {
        let voll: u64 = join((&pfad[0 as usize]) as u64, name)
        ulib.strncpy((&pfad[0 as usize]) as u64, voll, 126)
        // EIN SICHERUNGSSPEICHER SIEHT AUS WIE EIN ORDNER UND IST
        // KEINER. Wer hineingeht, will die Sicherungen sehen und nicht
        // PACK, INDEX und ein paar S-Dateien.
        if bstore.is_store((&pfad[0 as usize]) as u64) {
            vmodus = 1
            ulib.strncpy((&vspeicher[0 as usize]) as u64,
                (&pfad[0 as usize]) as u64, 120)
        }
        hist_push((&pfad[0 as usize]) as u64)
        neu_lesen(baum, tab, stat, fpfad)
        return
    }
    // Eine Datei: sie starten. Ein Programm, das kein Programm ist,
    // wird vom ELF-Lader abgelehnt -- und das ist die richtige Stelle
    // dafuer, nicht eine Namensendung hier.
    let voll: u64 = join((&pfad[0 as usize]) as u64, name)
    var arg: [u8; 200] = [0 as u8; 200]
    ulib.strncpy((&arg[0 as usize]) as u64, voll, 190)
    let pid: u64 = ulib.sys(ulib.SYS_SPAWN, (&arg[0 as usize]) as u64,
        0, 0)
    say(marke)
    say(voll)
    var sp: [u8; 8] = " pid=\0\0\0"
    say((&sp[0 as usize]) as u64)
    ulib.sayn(pid)
    ulib.nl()
}

fn loesche_zeiten() {
    var i: u64 = 0
    while i < MAXENT {
        __mmio_write8((zptr(i)) as *mut u8, 0 as u8)
        i = i + 1
    }
}

// Wie `eltern`, aber fuer den Weg INNERHALB einer Sicherung: der letzte
// Namensteil faellt weg, und "" ist die Wurzel der Sicherung.
fn eltern_v(p: u64) {
    var n: u64 = ulib.length(p)
    while n > 0 && (*((p + n - 1) as *mut u8)) != 47 as u8 {
        n = n - 1
    }
    if n > 0 {
        n = n - 1
    }
    __mmio_write8((p + n) as *mut u8, 0 as u8)
}

// Was in der Pfadleiste steht. In einer Sicherung ist das kein Pfad auf
// der Platte, und deshalb steht das Datum mit drin -- sonst koennte man
// eine Sicherung fuer einen Ordner halten und sich wundern, warum sich
// nichts aendern laesst.
fn zeige_ort(fpfad: u64) {
    var sl: [u8; 2] = "/\0"
    if vmodus != 2 {
        wlib.set_text(fpfad, (&pfad[0 as usize]) as u64)
        return
    }
    ulib.strncpy((&vpfad[0 as usize]) as u64,
        (&vspeicher[0 as usize]) as u64, 120)
    ulib.strcat((&vpfad[0 as usize]) as u64, (&sl[0 as usize]) as u64)
    ulib.strcat((&vpfad[0 as usize]) as u64, (&vsicher[0 as usize]) as u64)
    ulib.strcat((&vpfad[0 as usize]) as u64, (&vunter[0 as usize]) as u64)
    wlib.set_text(fpfad, (&vpfad[0 as usize]) as u64)
}

// ------------------------------------------------- sichern, mit Anzeige

// DER FORTSCHRITT. `bstore` ruft das nach JEDER Datei; gemalt wird nur
// jede achte, weil sonst das Zeichnen den Lauf beherrscht und die Zahl,
// die dabei herauskommt, das Malen misst und nicht das Sichern.
//
// DIE INTERESSANTE ZAHL IST "neu". Gelesen wird beim zweiten Mal wieder
// alles; GESCHRIEBEN wird fast nichts, und genau das soll der Benutzer
// sehen, denn es ist der Unterschied zwischen diesem Entwurf und einem
// ZIP, das jedes Mal von vorn anfaengt.
fn fortschritt(n: u64) -> u64 {
    if plabel == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    if (n & 7) != 0 {
        return 0
    }
    baue_fortschritt()
    wlib.set_text(plabel, (&pbuf[0 as usize]) as u64)
    wlib.draw_all()
    return 0
}

fn baue_fortschritt() {
    var k_s_d: [u8; 24] = "explorer.progress.files\0"
    var k_s_b: [u8; 24] = "explorer.progress.bytes\0"
    var k_s_n: [u8; 22] = "explorer.progress.new\0"
    var d: [u8; 24] = [0 as u8; 24]
    var lp: u64 = 0
    lp = pfeld(lp, msg.get((&k_s_d[0 as usize]) as u64), (&d[0 as usize]) as u64,
        bstore.files_of())
    lp = pfeld(lp, msg.get((&k_s_b[0 as usize]) as u64), (&d[0 as usize]) as u64,
        bstore.read_of())
    lp = pfeld(lp, msg.get((&k_s_n[0 as usize]) as u64), (&d[0 as usize]) as u64,
        bstore.written_of())
    pbuf[(lp) as usize] = 0 as u8
}

fn pfeld(lp0: u64, txt: u64, d: u64, wert: u64) -> u64 {
    var lp: u64 = lp0
    var k: u64 = 0
    while (*((txt + k) as *mut u8)) != 0 as u8 && lp < 120 {
        pbuf[(lp) as usize] = *((txt + k) as *mut u8)
        lp = lp + 1
        k = k + 1
    }
    let n: u64 = ulib.digits(wert, d)
    var i: u64 = 0
    while i < n && lp < 120 {
        pbuf[(lp) as usize] = *((d + i) as *mut u8)
        lp = lp + 1
        i = i + 1
    }
    return lp
}

// EINE SICHERUNG ANLEGEN ODER DAZULEGEN. `ziel` ist das Verzeichnis, in
// das der Benutzer gezeigt hat -- der Stick, die zweite Platte, irgendein
// Ordner. Gesichert wird `/data`, und das steht hier und nicht im
// Kleingedruckten.
// SICH SELBST ZU SICHERN GEHT NICHT. Liegt das Ziel INNERHALB der
// Quelle, waechst der Speicher, waehrend er durchgegangen wird -- der
// Lauf frisst seine eigenen Bloecke und hoert nie auf. Das ist keine
// theoretische Sorge: `/data` ist die Quelle, und das erste, worauf ein
// Benutzer im Dateimanager zeigt, ist ein Ordner in `/data`.
fn im_eigenen_baum(ziel: u64) -> bool {
    let q: u64 = ulib.length((&t_bquelle[0 as usize]) as u64)
    if !ulib.strneq(ziel, (&t_bquelle[0 as usize]) as u64, q) {
        return false
    }
    // Genau die Quelle selbst, oder etwas darunter -- aber NICHT
    // `/datakram`, das nur so anfaengt.
    let c: u64 = (*((ziel + q) as *mut u8)) as u64
    return c == 0 || c == 47
}

fn sichern(ziel: u64, baum: u64, tab: u64, stat: u64, fpfad: u64) {
    var s_fertig: [u8; 12] = "  -- fertig\0"
    var s_fehler: [u8; 20] = "  -- FEHLGESCHLAGEN\0"
    var d: [u8; 24] = [0 as u8; 24]
    var nam: [u8; 32] = [0 as u8; 32]

    if im_eigenen_baum(ziel) {
        wlib.dlg_ask(msg.get((&k_t_bak[0 as usize]) as u64),
            msg.get((&k_t_selbst2[0 as usize]) as u64))
        sag_sicherung(ziel, (&t_snap[0 as usize]) as u64, 2)
        return
    }
    // DER NAME DER SICHERUNG. Durchnummeriert, weil zwei Sicherungen im
    // selben Speicher nicht denselben Namen haben duerfen -- die zweite
    // wuerde die erste ueberschreiben.
    ulib.strcpy((&nam[0 as usize]) as u64, (&t_snap[0 as usize]) as u64)
    let k: u64 = ulib.digits(naechste_nummer(ziel), (&d[0 as usize]) as u64)
    var i: u64 = 0
    let l0: u64 = ulib.length((&nam[0 as usize]) as u64)
    while i < k {
        nam[((l0 + i)) as usize] = *(((&d[0 as usize]) as u64 + i) as *mut u8)
        i = i + 1
    }
    nam[((l0 + k)) as usize] = 0 as u8

    wlib.dlg_ask(msg.get((&k_t_bak[0 as usize]) as u64),
        msg.get((&k_t_lauft[0 as usize]) as u64))
    plabel = wlib.dlg_label()
    wlib.draw_all()
    let rc: u64 = bstore.save((&t_bquelle[0 as usize]) as u64, ziel,
        (&nam[0 as usize]) as u64, 0, (&t_bquelle[0 as usize]) as u64,
        fortschritt)
    plabel = 0xFFFFFFFFFFFFFFFF
    // DIE ZUSAMMENFASSUNG steht in derselben Zeile, in der eben noch der
    // Fortschritt stand.
    baue_fortschritt()
    var lp: u64 = ulib.length((&pbuf[0 as usize]) as u64)
    var q: u64 = 0
    var txt: u64 = (&s_fertig[0 as usize]) as u64
    if rc != 0 {
        txt = (&s_fehler[0 as usize]) as u64
    }
    while (*((txt + q) as *mut u8)) != 0 as u8 && lp < 126 {
        pbuf[(lp) as usize] = *((txt + q) as *mut u8)
        lp = lp + 1
        q = q + 1
    }
    pbuf[(lp) as usize] = 0 as u8
    wlib.set_text(wlib.dlg_label(), (&pbuf[0 as usize]) as u64)
    wlib.draw_all()
    sag_sicherung(ziel, (&nam[0 as usize]) as u64, rc)
    neu_lesen(baum, tab, stat, fpfad)
}

// Wieviele Sicherungen liegen schon da? Die naechste bekommt die
// naechste Nummer.
fn naechste_nummer(ziel: u64) -> u64 {
    var namebuf: [u8; 64] = [0 as u8; 64]
    let fd: u64 = bstore.snaps_open(ziel)
    if ulib.bad(fd) {
        return 1
    }
    var n: u64 = 0
    var weiter: bool = true
    while weiter {
        if !bstore.snaps_next(fd, (&namebuf[0 as usize]) as u64, 60) {
            weiter = false
        } else {
            n = n + 1
        }
    }
    io.close(fd)
    return n + 1
}

// Auf die serielle Leitung, damit der Lauf MESSBAR ist und nicht nur
// huebsch aussieht.
fn sag_sicherung(ziel: u64, nam: u64, rc: u64) {
    var s1: [u8; 23] = "explorer: backup ziel=\0"
    var s2: [u8; 7] = " name=\0"
    var s3: [u8; 10] = " dateien=\0"
    var s4: [u8; 10] = " oktette=\0"
    var s5: [u8; 6] = " neu=\0"
    var s6: [u8; 5] = " rc=\0"
    say((&s1[0 as usize]) as u64)
    say(ziel)
    say((&s2[0 as usize]) as u64)
    say(nam)
    say((&s3[0 as usize]) as u64)
    ulib.sayn(bstore.files_of())
    say((&s4[0 as usize]) as u64)
    ulib.sayn(bstore.read_of())
    say((&s5[0 as usize]) as u64)
    ulib.sayn(bstore.written_of())
    say((&s6[0 as usize]) as u64)
    ulib.sayn(rc)
    ulib.nl()
}

// EINE DATEI ODER EINE GANZE SICHERUNG ZURUECKHOLEN. Zurueck geht es
// nach `/data` -- ein fester, genannter Ort ist ehrlicher als ein
// geratener, und wo man gerade steht, ist in einer Sicherung kein Ort
// auf der Platte.
fn zurueckholen(baum: u64, tab: u64, stat: u64, fpfad: u64) {
    var z1: [u8; 19] = "explorer: zurueck \0"
    var z2: [u8; 5] = " rc=\0"
    var rc: u64 = 1
    if vmodus == 1 {
        let z: u64 = wlib.value(tab)
        if z < anzahl {
            let e: u64 = folge[(z) as usize]
            ulib.strncpy((&pziel[0 as usize]) as u64,
                (&t_bwohin[0 as usize]) as u64, 120)
            rc = bstore.restore((&vspeicher[0 as usize]) as u64, nptr(e),
                (&pziel[0 as usize]) as u64, 0)
        }
    } else if vmodus == 2 {
        let z: u64 = wlib.value(tab)
        if z < anzahl {
            let e: u64 = folge[(z) as usize]
            let voll: u64 = in_sicherung(e)
            let wohin: u64 = join((&t_bwohin[0 as usize]) as u64, nptr(e))
            ulib.strncpy((&pziel[0 as usize]) as u64, wohin, 120)
            rc = bstore.get((&vspeicher[0 as usize]) as u64,
                (&vsicher[0 as usize]) as u64, voll,
                (&pziel[0 as usize]) as u64)
        }
    }
    say((&z1[0 as usize]) as u64)
    say((&pziel[0 as usize]) as u64)
    say((&z2[0 as usize]) as u64)
    ulib.sayn(rc)
    ulib.nl()
}

fn baum_gehen(zeile: u64, baum: u64, tab: u64, stat: u64, fpfad: u64) {
    if zeile == 0 {
        // HINAUF, und der Weg zurueck geht durch dieselben drei
        // Ansichten, in denen man hineingegangen ist.
        if vmodus == 2 {
            if vunter[(0) as usize] != 0 as u8 {
                eltern_v((&vunter[0 as usize]) as u64)
            } else {
                vmodus = 1
            }
            zeige_ort(fpfad)
            neu_lesen(baum, tab, stat, fpfad)
            return
        }
        if vmodus == 1 {
            vmodus = 0
        }
        eltern((&pfad[0 as usize]) as u64)
        hist_push((&pfad[0 as usize]) as u64)
        neu_lesen(baum, tab, stat, fpfad)
        return
    }
    if vmodus != 0 {
        return
    }
    // Zeile n zeigt auf das n-te Verzeichnis in der Folge.
    var gesehen: u64 = 0
    var i: u64 = 0
    while i < anzahl {
        let e: u64 = folge[(i) as usize]
        if art[(e) as usize] != 0 {
            gesehen = gesehen + 1
            if gesehen == zeile {
                let voll: u64 = join((&pfad[0 as usize]) as u64, nptr(e))
                ulib.strncpy((&pfad[0 as usize]) as u64, voll, 126)
                hist_push((&pfad[0 as usize]) as u64)
                neu_lesen(baum, tab, stat, fpfad)
                i = anzahl
            }
        }
        i = i + 1
    }
}

// Was ein Menuepunkt bedeutet. Gibt zurueck, worauf der Dialog danach
// wartet: 1 umbenennen, 2 neuer Ordner, 3 loeschen, 0 nichts.
fn menue_wahl(welches: u64, idx: u64, tab: u64, baum: u64, stat: u64,
    fpfad: u64) -> u64 {
    if welches == 1 {
        if idx == 0 {
            var leer: [u8; 4] = "\0\0\0\0"
            oeffnen(wlib.value(tab), baum, tab, stat, fpfad,
                (&leer[0 as usize]) as u64)
            return 0
        }
        if idx == 1 {
            let z: u64 = wlib.value(tab)
            if z < anzahl {
                ulib.strncpy((&dlgpuffer[0 as usize]) as u64,
                    nptr(folge[(z) as usize]), 120)
                wlib.dlg_open(msg.get((&k_rename[0 as usize]) as u64),
                    msg.get((&k_name[0 as usize]) as u64),
                    (&dlgpuffer[0 as usize]) as u64)
                return 1
            }
            return 0
        }
        if idx == 2 {
            wlib.dlg_ask(msg.get((&k_rename[0 as usize]) as u64),
                msg.get((&k_del[0 as usize]) as u64))
            return 3
        }
        if idx == 3 {
            wlib.dlg_open(msg.get((&k_newdir[0 as usize]) as u64),
                msg.get((&k_name[0 as usize]) as u64), 0)
            return 2
        }
        // BACKUP HIERHIN SICHERN. Wohin: in das Verzeichnis, in dem man
        // steht, oder in das ausgewaehlte, wenn eines ausgewaehlt ist --
        // so wie man es von "hier ablegen" erwartet.
        ulib.strncpy((&pziel[0 as usize]) as u64,
            (&pfad[0 as usize]) as u64, 120)
        let z2: u64 = wlib.value(tab)
        if z2 < anzahl {
            let e2: u64 = folge[(z2) as usize]
            if art[(e2) as usize] != 0 {
                ulib.strncpy((&pziel[0 as usize]) as u64,
                    join((&pfad[0 as usize]) as u64, nptr(e2)), 120)
            }
        }
        // LIEGT DA SCHON EIN SPEICHER, wird ohne Rueckfrage eine WEITERE
        // Sicherung hineingelegt -- nicht ein zweiter Speicher daneben.
        // Nur beim ERSTEN Mal wird gefragt.
        if bstore.is_store((&pziel[0 as usize]) as u64) {
            sichern((&pziel[0 as usize]) as u64, baum, tab, stat, fpfad)
            return 0
        }
        wlib.dlg_ask(msg.get((&k_t_bak[0 as usize]) as u64),
            msg.get((&k_t_bfrage[0 as usize]) as u64))
        return 4
    }
    if welches == 4 {
        if idx == 0 {
            oeffnen(wlib.value(tab), baum, tab, stat, fpfad,
                msg.get((&k_t_bak[0 as usize]) as u64))
            return 0
        }
        zurueckholen(baum, tab, stat, fpfad)
        return 0
    }
    if welches == 2 {
        if idx == 0 {
            wlib.dlg_open(msg.get((&k_newdir[0 as usize]) as u64),
                msg.get((&k_name[0 as usize]) as u64), 0)
            return 2
        }
        if idx == 1 {
            neu_lesen(baum, tab, stat, fpfad)
            return 0
        }
        wlib.quit()
        return 0
    }
    // ROUND NETVIEW: start the selected file with the chosen view. It
    // goes through `/bin/netview`, which is the SAME mechanism the shell
    // and the launcher use -- the file manager gets no privileged path
    // of its own, and there is one place that knows how a view is put
    // on a program.
    if welches == 4 {
        let z: u64 = wlib.value(tab)
        if z < anzahl {
            let e: u64 = folge[(z) as usize]
            if art[(e) as usize] == 0 {
                var v0: [u8; 5] = "real\0"
                var v1: [u8; 9] = "filtered\0"
                var v2: [u8; 6] = "faked\0"
                var v3: [u8; 5] = "none\0"
                var tool: [u8; 13] = "/bin/netview\0"
                var voll2: [u8; 200] = [0 as u8; 200]
                var argv: [u64; 3] = [0 as u64; 3]
                ulib.strncpy((&voll2[0 as usize]) as u64,
                    join((&pfad[0 as usize]) as u64, nptr(e)), 190)
                var word: u64 = (&v0[0 as usize]) as u64
                if idx == 1 {
                    word = (&v1[0 as usize]) as u64
                } else if idx == 2 {
                    word = (&v2[0 as usize]) as u64
                } else if idx == 3 {
                    word = (&v3[0 as usize]) as u64
                }
                argv[0 as usize] = (&tool[0 as usize]) as u64
                argv[1 as usize] = word
                argv[2 as usize] = (&voll2[0 as usize]) as u64
                var s_nv: [u8; 19] = "explorer: netview \0"
                var s_sp2: [u8; 2] = " \0"
                var s_pid: [u8; 8] = " pid=\0\0\0"
                let pid: u64 = ulib.sys(ulib.SYS_EXEC,
                    (&tool[0 as usize]) as u64,
                    (&argv[0 as usize]) as u64, 3)
                say((&s_nv[0 as usize]) as u64)
                say(word)
                say((&s_sp2[0 as usize]) as u64)
                say((&voll2[0 as usize]) as u64)
                say((&s_pid[0 as usize]) as u64)
                ulib.sayn(pid)
                ulib.nl()
            }
        }
        return 0
    }
    if welches == 3 {
        if idx == 0 {
            sortby = 0
            sortrev = 0
        } else if idx == 1 {
            sortby = 1
            sortrev = 0
        } else {
            sortrev = 1 - sortrev
        }
        sortiere()
        baue_tabelle()
        baue_baum()
        wlib.set_text(tab, (&tblob[0 as usize]) as u64)
        wlib.set_text(baum, (&bblob[0 as usize]) as u64)
        return 0
    }
    return 0
}

// Der Dialog wurde bestaetigt. HIER steht die einzige Stelle, an der
// dieser Dateimanager die Platte AENDERT -- und sie steht an einer
// Stelle, nicht an fuenf.
fn vollziehen(was: u64, tab: u64, baum: u64, stat: u64, fpfad: u64) {
    var s_op: [u8; 16] = "explorer: tat \0\0"
    var s_rc: [u8; 8] = " rc=\0\0\0\0"
    if was == 0 {
        return
    }
    var rc: u64 = 0
    if was == 4 {
        sichern((&pziel[0 as usize]) as u64, baum, tab, stat, fpfad)
        return
    }
    if was == 2 {
        let voll: u64 = join((&pfad[0 as usize]) as u64, wlib.dlg_text())
        rc = io.make_dir(voll)
    } else if was == 3 {
        let z: u64 = wlib.value(tab)
        if z < anzahl {
            let voll: u64 = join((&pfad[0 as usize]) as u64,
                nptr(folge[(z) as usize]))
            rc = io.unlink(voll)
        }
    } else if was == 1 {
        let z: u64 = wlib.value(tab)
        if z < anzahl {
            rc = umbenennen(nptr(folge[(z) as usize]), wlib.dlg_text())
        }
    }
    say((&s_op[0 as usize]) as u64)
    ulib.sayn(was)
    say((&s_rc[0 as usize]) as u64)
    ulib.sayn(rc)
    ulib.nl()
    neu_lesen(baum, tab, stat, fpfad)
}

// UMBENENNEN IST KOPIEREN UND LOESCHEN, weil dieser Kernel kein
// `rename` hat. Steht im Kopf dieser Datei, steht seit Runde K11 in
// `kernel/user/mv.fi`, und steht hier noch einmal an der Stelle, an
// der es passiert.
fn umbenennen(alt: u64, neu: u64) -> u64 {
    var apfad: [u8; 200] = [0 as u8; 200]
    var puffer: [u8; 512] = [0 as u8; 512]
    let av: u64 = join((&pfad[0 as usize]) as u64, alt)
    ulib.strncpy((&apfad[0 as usize]) as u64, av, 190)
    let nv: u64 = join((&pfad[0 as usize]) as u64, neu)
    let q: u64 = io.open((&apfad[0 as usize]) as u64, 0)
    if ulib.bad(q) {
        return q
    }
    let z: u64 = io.create(nv)
    if ulib.bad(z) {
        io.close(q)
        return z
    }
    var weiter: bool = true
    while weiter {
        let n: u64 = io.read(q, (&puffer[0 as usize]) as u64, 512)
        if ulib.bad(n) || n == 0 {
            weiter = false
        } else {
            io.write_all(z, (&puffer[0 as usize]) as u64, n)
        }
    }
    io.close(q)
    io.close(z)
    return io.unlink((&apfad[0 as usize]) as u64)
}

// Was die Anordnung ausgerechnet hat -- fuer den Testlaeufer.
fn say_rects(mb: u64, bzur: u64, bvor: u64, bauf: u64, fpfad: u64,
    baum: u64, tab: u64, stat: u64) {
    say_rect(mb)
    say_rect(bzur)
    say_rect(bvor)
    say_rect(bauf)
    say_rect(fpfad)
    say_rect(baum)
    say_rect(tab)
    say_rect(stat)
    var a: [u8; 16] = "explorer: rows \0"
    var sx: [u8; 4] = "x=\0\0"
    var sb: [u8; 8] = "base=\0\0\0"
    var sh: [u8; 4] = "zh=\0"
    var sk: [u8; 8] = "kopf=\0\0\0"
    var sf: [u8; 4] = "fg=\0"
    var sg: [u8; 4] = "bg=\0"
    var ss: [u8; 6] = "sel=\0\0"
    var sc: [u8; 8] = "selfg=\0\0"
    var sd: [u8; 6] = "dim=\0\0"
    say((&a[0 as usize]) as u64)
    kv((&sx[0 as usize]) as u64, wlib.cell_x(tab, 0))
    kv((&sb[0 as usize]) as u64, wlib.cell_base(tab, 0))
    kv((&sh[0 as usize]) as u64, wlib.row_h())
    kv((&sk[0 as usize]) as u64, wlib.head_base(tab))
    kv((&sf[0 as usize]) as u64, wlibc.theme(wlibc.T_FG))
    kv((&sg[0 as usize]) as u64, wlibc.theme(wlibc.T_ENTRY))
    kv((&ss[0 as usize]) as u64, wlibc.theme(wlibc.T_SEL))
    kv((&sc[0 as usize]) as u64, wlibc.theme(wlibc.T_SELFG))
    kv((&sd[0 as usize]) as u64, wlibc.theme(wlibc.T_DIM))
    ulib.nl()
    var b: [u8; 20] = "explorer: spalten \0\0"
    say((&b[0 as usize]) as u64)
    var i: u64 = 0
    while i < 4 {
        ulib.sayn(wlib.cell_x(tab, i))
        var sp: [u8; 2] = " \0"
        say((&sp[0 as usize]) as u64)
        i = i + 1
    }
    ulib.nl()
}

// WO DER OK-KNOPF EINES DIALOGS LIEGT. Gemeldet aus demselben Grund wie
// jedes andere Rechteck dieser Anwendung (`say_rect`): der Laeufer soll
// die Oberflaeche BEDIENEN koennen, ohne zu raten, wo etwas hingemalt
// wurde. Ohne das muesste ein Test Bildpunkte suchen -- und ein Test,
// der Bildpunkte sucht, findet irgendwann den falschen.
// WO DAS KONTEXTMENUE AUFGEKLAPPT IST. Aus demselben Grund gemeldet wie
// `say_dlgrect`, und mit einem konkreten Anlass: `wlib.menu_open` klappt
// ein Menue NACH OBEN, wenn es sonst unten aus dem Bild liefe. Ein Test,
// der die Zeilenhoehe und die Aufklapprichtung raet, trifft dann den
// falschen Punkt -- und meldet einen Fehler, den es nicht gibt.
fn say_menurect() {
    var a: [u8; 20] = "explorer: menurect \0"
    var swx: [u8; 4] = "wx=\0"
    var swy: [u8; 4] = "wy=\0"
    var szh: [u8; 4] = "wh=\0"
    let w: u64 = wlib.menu_win()
    say((&a[0 as usize]) as u64)
    kv((&swx[0 as usize]) as u64, wlib.win_x(w))
    kv((&swy[0 as usize]) as u64, wlib.win_y(w))
    kv((&szh[0 as usize]) as u64, wlib.win_h(w))
    ulib.nl()
}

fn say_dlgrect() {
    var a: [u8; 19] = "explorer: dlgrect \0"
    var sx: [u8; 3] = "x=\0"
    var sy: [u8; 3] = "y=\0"
    var sw: [u8; 3] = "w=\0"
    var sh: [u8; 3] = "h=\0"
    var swx: [u8; 4] = "wx=\0"
    var swy: [u8; 4] = "wy=\0"
    let b: u64 = wlib.dlg_button(0)
    let w: u64 = wlib.dlg_win()
    say((&a[0 as usize]) as u64)
    kv((&swx[0 as usize]) as u64, wlib.win_x(w))
    kv((&swy[0 as usize]) as u64, wlib.win_y(w))
    kv((&sx[0 as usize]) as u64, wlib.rect_x(b))
    kv((&sy[0 as usize]) as u64, wlib.rect_y(b))
    kv((&sw[0 as usize]) as u64, wlib.rect_w(b))
    kv((&sh[0 as usize]) as u64, wlib.rect_h(b))
    ulib.nl()
}

fn say_rect(i: u64) {
    var a: [u8; 16] = "explorer: rect \0"
    var si: [u8; 4] = "id=\0"
    var sk: [u8; 8] = "kind=\0\0\0"
    var sx: [u8; 4] = "x=\0\0"
    var sy: [u8; 4] = "y=\0\0"
    var sw: [u8; 4] = "w=\0\0"
    var sh: [u8; 4] = "h=\0\0"
    say((&a[0 as usize]) as u64)
    kv((&si[0 as usize]) as u64, i)
    kv((&sk[0 as usize]) as u64, wlib.kind_of(i))
    kv((&sx[0 as usize]) as u64, wlib.rect_x(i))
    kv((&sy[0 as usize]) as u64, wlib.rect_y(i))
    kv((&sw[0 as usize]) as u64, wlib.rect_w(i))
    kv((&sh[0 as usize]) as u64, wlib.rect_h(i))
    ulib.nl()
}
