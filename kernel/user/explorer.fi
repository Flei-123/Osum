static mut pfadfeld_an: bool = false
static mut c_menu: u64 = 0xFFFFFFFFFFFFFFFF
static mut c_werk: u64 = 0xFFFFFFFFFFFFFFFF
static mut c_inh: u64 = 0xFFFFFFFFFFFFFFFF
static mut c_stat: u64 = 0xFFFFFFFFFFFFFFFF
static mut a_baum: u64 = 0xFFFFFFFFFFFFFFFF
static mut a_tab: u64 = 0xFFFFFFFFFFFFFFFF
static mut letzte_w: u64 = 0
static mut letzte_h: u64 = 0
// ====================================== RUNDE HOTPLUG-2
// DIE GLOCKE DES SYSTEMBUSSES, und warum der Dateimanager sie hoert.
//
// Der Kern meldet jedes Kommen und Gehen eines Wechseldatentraegers
// auf den Bus (`wechsel.melden` -> `bus.noti_post`, Text "usb+ /medien/
// usb0" bzw. "usb- ..."). Bis zu dieser Runde hat das NIEMAND
// abonniert: die Seitenleiste wurde nur neu gebaut, wenn ein Mensch
// "Aktualisieren" drueckte. Ein Stick, der im Betrieb kam, war also da
// -- eingehaengt, lesbar, in `/medien/usb0` -- und stand trotzdem nicht
// in der Leiste, bis jemand von selbst auf den Gedanken kam.
//
// Gemerkt wird nur EINE ZAHL: wie viele Meldungen es zuletzt gab
// (`noti_new` zaehlt die ungelesenen). Bewegt sie sich, werden die Orte
// neu gelesen. Das ist derselbe Griff wie bei `usb.msc_gen`/`msc_weg`
// eine Schicht tiefer -- eine Zahl kennt niemanden, und der
// Dateimanager muss den Kern nicht kennen, um auf ihn zu hoeren.
//
// WARUM NICHT DEN TEXT LESEN: `noti_take` naehme die Meldung WEG, und
// dann fehlte sie der Leiste unten rechts, die sie anzeigen soll. Die
// Zahl reicht: was sich geaendert hat, steht ohnehin in der
// Einhaengetafel, und genau die liest `exporte.carrier_read`.
static mut noti_stand: u64 = 0xFFFFFFFFFFFFFFFF
// RUNDE HOTPLUG-2: DIE NUMMER DES AUSWURFKNOPFES, damit ein Laeufer
// sie nicht aus der Reihenfolge der Knoepfe RATEN muss. Genau das
// warnt der Kopf von `say_rects` an: "dann prueft er seinen Nachbau".
// Die Tabulatorzahl eines Knopfes ist kein Vertrag -- seine gemeldete
// Nummer schon.
static mut b_aus: u64 = 0xFFFFFFFFFFFFFFFF
static mut b_orte: u64 = 0xFFFFFFFFFFFFFFFF
// Die gerechneten Masse. Sie stehen hier und nicht in `u_start`, weil
// sie an ZWEI Stellen gebraucht werden: beim Aufbau und bei jeder
// Groessenaenderung. Zwei Rechnungen waeren zwei Wahrheiten.
static mut g_rand: u64 = 0
static mut g_luft: u64 = 0
static mut g_ch: u64 = 0
static mut g_mbh: u64 = 0
static mut g_sth: u64 = 0
static mut g_innen: u64 = 0
static mut g_ywerk: u64 = 0
static mut g_yinh: u64 = 0
static mut g_hinh: u64 = 0
