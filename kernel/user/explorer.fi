static mut s_start: [u8; 17] = "explorer: start \0"

// ------------------------------------------------------------ helpers

fn rfr() {
    if s_up {
        fuiscene.refresh()
    }
}

fn cur_key() -> u64 {
    if symansicht == 1 {
        return K_SYM
    }
    return K_TAB
}

fn cur_row() -> u64 {
    return fuiscene.table_sel(cur_key())
}

fn baum_row() -> u64 {
    return fuiscene.table_sel(K_BAUM)
}

// The status line shows a message instead of the counts until the next read.
fn stat_set(p: u64) {
    stat_msg = p
    rfr()
}

// The path field holds a new text (the field keeps what the user typed, so
// every change of the place has to be written into it).
fn pfad_set(p: u64) {
    if s_up {
        fuiscene.entry_set(K_PFAD, p)
    }
}

fn text_w(p: u64) -> u64 {
    return wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, ulib.length(p)) / fuiscene.scale()
}

// A catalogue text with one line per item -> items one after the other,
// each ended by a NUL (what the popup menu of the scene host takes).
fn split_items(src: u64, dst: u64, max: u64) -> u64 {
    var n: u64 = 0
    var at: u64 = 0
    var k: u64 = 0
    var last_nl: bool = true
    while __mmio_read8((src + k) as *mut u8) != 0 as u8 && at + 2 < max {
        let c: u8 = __mmio_read8((src + k) as *mut u8)
        if c == 10 as u8 {
            __mmio_write8((dst + at) as *mut u8, 0 as u8)
            n = n + 1
            last_nl = true
        } else {
            __mmio_write8((dst + at) as *mut u8, c)
            last_nl = false
        }
        at = at + 1
        k = k + 1
    }
    if !last_nl {
        n = n + 1
    }
    __mmio_write8((dst + at) as *mut u8, 0 as u8)
    __mmio_write8((dst + at + 1) as *mut u8, 0 as u8)
    return n
}

fn item_at(p: u64, j: u64) -> u64 {
    var q: u64 = p
    var k: u64 = 0
    while k < j {
        q = q + ulib.length(q) + 1
        k = k + 1
    }
    return q
}

// Open a popup menu with the lines of `src` at (x, y); the number of lines.
fn popup_at(x: u64, y: u64, src: u64) -> u64 {
    let dst: u64 = ((&s_pm[0 as usize]) as u64)
    let n: u64 = split_items(src, dst, 1090)
    var wm: u64 = 160
    var j: u64 = 0
    while j < n {
        let tw: u64 = text_w(item_at(dst, j)) + 32
        if tw > wm {
            wm = tw
        }
        j = j + 1
    }
    wm = (wm + 3) / 4 * 4
    fuiscene.menu_open(x, y, wm, dst, n)
    say_menurect()
    return n
}

// Where a popup that nobody pointed at goes: into the file list.
fn where_x() -> u64 {
    let n: usize = fuiscene.node_of_key(cur_key())
    if n == fuiscene.NONE {
        return 40
    }
    return fuiscene.node_x(n) + 24
}

fn where_y() -> u64 {
    let n: usize = fuiscene.node_of_key(cur_key())
    if n == fuiscene.NONE {
        return 80
    }
    return fuiscene.node_y(n) + 40
}

// ------------------------------------------------------------ the dialogs

fn dlg_entry(title: u64, label: u64, initial: u64) -> u64 {
    fuiscene.dialog_entry(title, label, initial, ((&t_ok[0 as usize]) as u64), ((&t_ab[0 as usize]) as u64))
    return 0
}

fn dlg_ask(title: u64, text: u64) -> u64 {
    fuiscene.dialog_open(title, text, ((&t_ok[0 as usize]) as u64), ((&t_ab[0 as usize]) as u64))
    return 0
}

fn dlg_hinweis(title: u64, text: u64) -> u64 {
    fuiscene.dialog_open(title, text, ((&t_ok[0 as usize]) as u64), 0)
    return 0
}

fn dlg_wahl(title: u64, text: u64, btns: u64, n: u64) -> u64 {
    let _n: u64 = split_items(btns, ((&s_cb[0 as usize]) as u64), 190)
    fuiscene.dialog_choice(title, text, ((&s_cb[0 as usize]) as u64), n)
    return 0
}

// ------------------------------------------------------------ the picture

fn masse() {
    let bw: u64 = fuiscene.width()
    let bh: u64 = fuiscene.height()
    g_rand = 8
    g_luft = 8
    g_ch = CH
    g_mbh = MBH
    g_sth = STH
    g_innen = 0
    if bw > 16 {
        g_innen = bw - 16
    }
    // five rows (menu, tools, way, tabs, status) and the content between,
    // six gaps of 8 minus one... : padding 16 + five gaps 40
    // r402: four rows above the content (command bar, address bar, tabs) + the status line, four gaps
    let fix: u64 = CH + CH + CH + STH + 32 + 16
    g_hinh = 0
    if bh > fix + 40 {
        g_hinh = (bh - fix) / 4 * 4
    }
    g_bbaum = (g_innen / 4) / 4 * 4
    if g_bbaum < 160 {
        g_bbaum = 160
    }
    g_binh = 0
    if g_innen > g_bbaum + 8 {
        g_binh = g_innen - g_bbaum - 8
    }
    let n_orte: u64 = exporte.places_num()
    var gebraucht: u64 = (n_orte * ROWH + 8 + 3) / 4 * 4
    g_horte = (g_hinh / 2) / 4 * 4
    if gebraucht > g_horte {
        let rest: u64 = CH * 4 + 8
        if g_hinh > rest && gebraucht > g_hinh - rest {
            gebraucht = (g_hinh - rest) / 4 * 4
        }
        g_horte = gebraucht
    }
    g_hbaum = 0
    if g_hinh > g_horte + 8 {
        g_hbaum = g_hinh - g_horte - 8
    }
    columns_set(g_binh)
}

// What the window shows, described for the scene tree.
fn build() {
    masse()
    let col: usize = fuiscene.root()
    // ---- r402: the COMMAND BAR (what the four menus were: new folder, cut, copy, paste, rename, delete,
    // then View and More as menus). Text buttons of one height, one centre line.
    let mr: usize = fuiscene.row(col)
    n_mbar = mr
    fuiscene.set_gap(mr, 4)
    let mt: u64 = ((&s_mt[0 as usize]) as u64)
    let nm: u64 = split_items(msg.get(((&k_cmd[0 as usize]) as u64)), mt, 150)
    var m: u64 = 0
    while m < nm && m < 8 {
        let t: u64 = item_at(mt, m)
        var kk: u64 = K_CMD + m
        if m == 6 {
            kk = K_MB + 2 // View: the old View menu (list / icons / sort / hidden files)
        } else if m == 7 {
            kk = K_MB // More: the old File menu (open with, properties, refresh, quit)
        }
        let b: usize = fuiscene.button(mr, t, kk)
        fuiscene.flat(b)
        fuiscene.set_size(b, (text_w(t) + 28 + 3) / 4 * 4, CH)
        if m == 5 {
            let sp0: usize = fuiscene.row(mr)
            fuiscene.set_grow(sp0, 1)
        }
        m = m + 1
    }
    // ---- the ADDRESS BAR: back, forward, up, refresh, then the way as breadcrumbs (or the field after
    // Ctrl+L) in the rest of the row; the eject button only while a drive is selected
    let tr: usize = fuiscene.row(col)
    fuiscene.set_gap(tr, 4)
    let b1: usize = fuiscene.icon_button(tr, icons.NAV_BACK,
        msg.get(((&k_gzurueck[0 as usize]) as u64)), K_BZUR)
    fuiscene.set_size(b1, CH, CH)
    let b2: usize = fuiscene.icon_button(tr, icons.NAV_FORWARD,
        msg.get(((&k_gvor[0 as usize]) as u64)), K_BVOR)
    fuiscene.set_size(b2, CH, CH)
    let b3: usize = fuiscene.icon_button(tr, icons.NAV_UP,
        msg.get(((&k_gauf[0 as usize]) as u64)), K_BAUF)
    fuiscene.set_size(b3, CH, CH)
    let b4: usize = fuiscene.icon_button(tr, icons.NAV_REFRESH,
        msg.get(((&k_gneu[0 as usize]) as u64)), K_BNEU)
    fuiscene.set_size(b4, CH, CH)
    if exporte.place_is_carrier(ort_wahl) {
        let b5: usize = fuiscene.icon_button(tr, icons.FILE_DRIVE,
            msg.get(((&k_gaus[0 as usize]) as u64)), K_BAUS)
        fuiscene.set_size(b5, CH, CH)
    }
    if pfadfeld_an {
        let _fe: usize = fuiscene.entry(tr, K_PFAD, g_innen - (CH + 4) * 4 - 4, ((&pfad[0 as usize]) as u64))
    } else {
        var q: u64 = 0
        while q < krume_n {
            let t2: u64 = exporte.krume_text(q)
            let kb: usize = fuiscene.button(tr, t2, K_KRUME + q)
            fuiscene.set_size(kb, (text_w(t2) * 5 / 4 + 32 + 3) / 4 * 4, CH)
            q = q + 1
        }
    }
    // ---- the tabs
    let rr: usize = fuiscene.row(col)
    n_rrow = rr
    fuiscene.set_gap(rr, 4)
    var tw: u64 = 192
    if reiter_n > 0 && g_innen > 56 {
        let teil: u64 = (g_innen - 56) / reiter_n
        if teil < tw {
            tw = teil
        }
    }
    tw = tw / 4 * 4
    if tw < 96 {
        tw = 96
    }
    var r: u64 = 0
    while r < reiter_n {
        let lbl: u64 = (&s_rl[(r * 40) as usize]) as u64
        let at: u64 = reiter_beschriftung(r, lbl, 28)
        __mmio_write8((lbl + at) as *mut u8, 0 as u8)
        if reiter_n > 1 {
            let _tb: usize = fuiscene.tab_close(rr, lbl, K_RT + r, K_RX + r,
                msg.get(((&k_tabzu[0 as usize]) as u64)), r == reiter_at, tw, CH)
        } else {
            let t3: usize = fuiscene.tab(rr, lbl, K_RT + r, true)
            fuiscene.set_size(t3, tw, CH)
        }
        r = r + 1
    }
    if reiter_n < REITER_MAX {
        let pb: usize = fuiscene.button(rr, ((&t_plus[0 as usize]) as u64), K_RPLUS)
        fuiscene.set_size(pb, CH, CH)
        fuiscene.compact(pb)
    }
    // ---- the content: places and tree on the left, the files on the right
    let cr: usize = fuiscene.row(col)
    fuiscene.set_gap(cr, 8)
    let lc: usize = fuiscene.column(cr)
    fuiscene.set_gap(lc, 8)
    let _o: usize = fuiscene.table_list(lc, K_ORTE, g_bbaum, g_horte, 1,
        exporte.orte_ptr())
    fuiscene.table_icons(K_ORTE, exporte.orte_symbole())
    let _bm: usize = fuiscene.table_list(lc, K_BAUM, g_bbaum, g_hbaum, 1,
        ((&bblob[0 as usize]) as u64))
    fuiscene.table_icons(K_BAUM, ((&bsymbole[0 as usize]) as u64))
    if symansicht == 1 {
        let _sy: usize = fuiscene.table_list(cr, K_SYM, g_binh, g_hinh, 1,
            ((&symblob[0 as usize]) as u64))
        fuiscene.table_icons(K_SYM, ((&symicons[0 as usize]) as u64))
    } else {
        let _tt: usize = fuiscene.table_blob(cr, K_TAB, g_binh, g_hinh, 4,
            tab_text())
        fuiscene.table_icons(K_TAB, tab_icons())
        var c: u64 = 0
        while c < 4 {
            fuiscene.table_colw(K_TAB, c, spalten[(c) as usize])
            c = c + 1
        }
    }
    // ---- the status line
    var sp: u64 = stat_msg
    if sp == 0 {
        sp = ((&lauf[0 as usize]) as u64)
    }
    n_stat = fuiscene.label(col, sp)
}

// The things the tables are set up for, once, before the window opens.
fn tabellen_einrichten() {
    fuiscene.table_prep(K_ORTE)
    fuiscene.table_prep(K_BAUM)
    fuiscene.table_own(K_TAB, true)
    fuiscene.table_exact(K_TAB, true)
    fuiscene.table_exact(K_SYM, true)
    fuiscene.table_own(K_SYM, true)
    fuiscene.table_own(K_ORTE, true)
    fuiscene.table_own(K_BAUM, true)
    fuiscene.table_multi(K_TAB, true)
    fuiscene.table_drag(K_TAB, true)
    fuiscene.table_drop_filter(K_TAB, drop_ok_tab)
    fuiscene.table_multi(K_SYM, true)
    fuiscene.table_drag(K_SYM, true)
    fuiscene.table_drop_filter(K_SYM, drop_ok_tab)
    fuiscene.table_drop_filter(K_ORTE, drop_ok_orte)
    // a place is a jump, not a selection: ONE click goes there
    fuiscene.table_click_only(K_ORTE, true)
}

fn drop_ok_tab(row: u64) -> bool {
    if vmodus != 0 || row >= m_anzahl() {
        return false
    }
    return m_art(m_ord(row)) != 0
}

fn drop_ok_orte(row: u64) -> bool {
    if vmodus != 0 || row >= exporte.places_num() {
        return false
    }
    if exporte.place_is_header(row) {
        return false
    }
    return exporte.place_droppable(row)
}

// ------------------------------------------------------------ the tabs

fn reiter_unter(mx: u64, my: u64) -> u64 {
    var k: u64 = 0
    while k < reiter_n {
        let n: usize = fuiscene.node_of_key(K_RT + k)
        if n != fuiscene.NONE {
            if mx >= fuiscene.node_x(n) && mx < fuiscene.node_x(n) + fuiscene.node_w(n)
                && my >= fuiscene.node_y(n)
                && my < fuiscene.node_y(n) + fuiscene.node_h(n) {
                return k
            }
        }
        k = k + 1
    }
    return reiter_at
}

fn reiter_text_bauen() {
    rfr()
    say(((&s_reiter_t[0 as usize]) as u64))
    sayn(reiter_n)
    say(((&s_reiter_a[0 as usize]) as u64))
    sayn(reiter_at)
    nl()
}

// Close the tab `nr` (the cross of that tab).
fn reiter_zu_nr(nr: u64, baum: u64, tab: u64, stat: u64, fpfad: u64) {
    if nr >= reiter_n {
        return
    }
    if nr != reiter_at {
        reiter_wechsel(nr, baum, tab, stat, fpfad)
    }
    reiter_zu(baum, tab, stat, fpfad)
}

static mut s_reiter_t: [u8; 18] = "explorer: reiter \0"
static mut s_reiter_a: [u8; 4] = " a=\0"

// ------------------------------------------------------------ the views

fn view_set(welche: u64, tab: u64, baum: u64, stat: u64, fpfad: u64) {
    symansicht = welche
    symbolansicht_bauen()
    rfr()
    say(((&s_view[0 as usize]) as u64))
    sayn(welche)
    say(((&s_sp1[0 as usize]) as u64))
    kv(((&s_vn[0 as usize]) as u64), m_anzahl())
    kv(((&s_vw[0 as usize]) as u64), sym_weg)
    nl()
}

static mut s_view: [u8; 16] = "explorer: view \0"
static mut s_vn: [u8; 3] = "n=\0"
static mut s_vw: [u8; 5] = "weg=\0"

fn orte_anzeigen() {
    let n: u64 = exporte.orte_bauen()
    rfr()
    say(((&s_orte[0 as usize]) as u64))
    kv(((&s_on[0 as usize]) as u64), n)
    kv(((&s_ot[0 as usize]) as u64), exporte.carrier_num())
    nl()
    if dbg_on() {
        var p2: u64 = 0
        while p2 < exporte.places_num() {
            if exporte.place_is_carrier(p2) {
                say(((&s_ortz[0 as usize]) as u64))
                sayn(p2)
                say(((&s_ory[0 as usize]) as u64))
                sayn(p2 * ROWH)
                say(((&s_orh[0 as usize]) as u64))
                sayn(ROWH)
                nl()
            }
            p2 = p2 + 1
        }
    }
}

static mut s_orte: [u8; 16] = "explorer: orte \0"
static mut s_on: [u8; 3] = "n=\0"
static mut s_ot: [u8; 9] = "traeger=\0"
static mut s_ortz: [u8; 22] = "explorer: ortzeile i=\0"
static mut s_ory: [u8; 4] = " y=\0"
static mut s_orh: [u8; 4] = " h=\0"

// The crumbs: data only (the buttons are made by `build`).
fn krume_daten() {
    let n: u64 = exporte.krume_bauen(((&pfad[0 as usize]) as u64))
    krume_n = n
    if krume_n > 12 {
        krume_n = 12
    }
}

fn krume_anzeigen() {
    krume_daten()
    rfr()
    var feld: u64 = 0
    if pfadfeld_an {
        feld = 1
    }
    say(((&s_krume[0 as usize]) as u64))
    kv(((&s_kn[0 as usize]) as u64), krume_n)
    kv(((&s_kf[0 as usize]) as u64), feld)
    nl()
}

static mut s_krume: [u8; 17] = "explorer: krume \0"
static mut s_kn: [u8; 3] = "n=\0"
static mut s_kf: [u8; 6] = "feld=\0"

fn krume_umschalten(fpfad: u64) {
    pfadfeld_an = !pfadfeld_an
    if pfadfeld_an {
        pfad_set(((&pfad[0 as usize]) as u64))
    }
    krume_anzeigen()
    if pfadfeld_an && s_up {
        fuiscene.build_now()
        fuiscene.focus(K_PFAD)
    }
}

fn krume_klick(id: u64, baum: u64, tab: u64, stat: u64, fpfad: u64) -> bool {
    if id < K_KRUME || id >= K_KRUME + 12 {
        return false
    }
    let i: u64 = id - K_KRUME
    if i < krume_n {
        let ziel: u64 = exporte.crumb_path(i)
        if ziel != 0 && (*((ziel) as *mut u8)) != 0 as u8 {
            vmodus = 0
            ulib.strncpy(((&pfad[0 as usize]) as u64), ziel, 126)
            hist_push(((&pfad[0 as usize]) as u64))
            new_read(baum, tab, stat, fpfad)
            say(((&s_krsp[0 as usize]) as u64))
            say(((&pfad[0 as usize]) as u64))
            nl()
        }
    }
    return true
}

static mut s_krsp: [u8; 23] = "explorer: krumesprung \0"

// ------------------------------------------------------------ reading

fn new_read(baum: u64, tab: u64, stat: u64, fpfad: u64) {
    var r: u64 = 0
    if vmodus == 1 {
        r = scan_mem()
    } else if vmodus == 2 {
        r = scan_sicherung()
    } else {
        r = expmodell.lade(((&pfad[0 as usize]) as u64))
    }
    if ulib.bad(r) {
        anzahl = 0
    }
    sortiere()
    build_table()
    build_tree()
    baue_status()
    stat_msg = 0
    pfad_set(((&pfad[0 as usize]) as u64))
    symbolansicht_bauen()
    krume_daten()
    if s_up {
        fuiscene.table_sel_none(K_TAB)
        fuiscene.table_sel_none(K_SYM)
        fuiscene.table_set_top(K_TAB, 0)
        fuiscene.table_set_top(K_SYM, 0)
        fuiscene.table_set_top(K_BAUM, 0)
        fuiscene.table_set_sel(K_BAUM, fuiscene.HEAD_ROW)
        fuiscene.refresh()
    }
    say(((&s_cd[0 as usize]) as u64))
    say(((&pfad[0 as usize]) as u64))
    say(((&s_nn[0 as usize]) as u64))
    sayn(m_anzahl())
    nl()
    report_time()
}

static mut s_cd: [u8; 14] = "explorer: cd \0"
static mut s_nn: [u8; 4] = " n=\0"

fn view_refresh(baum: u64, tab: u64) {
    sortiere()
    build_table()
    build_tree()
    rfr()
}

fn sag_auswahl(tab: u64) {
    say(((&s_selx[0 as usize]) as u64))
    kv(((&s_sn[0 as usize]) as u64), fuiscene.table_sel_num(cur_key()))
    kv(((&s_sa[0 as usize]) as u64), fuiscene.table_anchor(cur_key()))
    kv(((&s_sr[0 as usize]) as u64), fuiscene.table_frames())
    nl()
}

static mut s_selx: [u8; 15] = "explorer: sel \0"
static mut s_sn: [u8; 3] = "n=\0"
static mut s_sa: [u8; 7] = "anker=\0"
static mut s_sr: [u8; 8] = "rahmen=\0"

fn fortschritt(n: u64) -> u64 {
    if plabel == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    if (n & 7) != 0 {
        return 0
    }
    baue_fortschritt()
    fuiscene.dialog_set_text(((&pbuf[0 as usize]) as u64))
    fuiscene.repaint_now()
    return 0
}

fn props_show(besitzer: u64, tab: u64) -> u64 {
    let z: u64 = cur_row()
    if z >= m_anzahl() {
        return 0
    }
    let full: u64 = full_from(z)
    let n: u64 = expdlg.eig_bauen(full, m_name(m_ord(z)),
        expmodell.time_offset())
    let _m: u64 = popup_at(where_x(), where_y(), expdlg.eig_ptr())
    say(((&s_pp[0 as usize]) as u64))
    kv(((&s_pz[0 as usize]) as u64), n)
    kv(((&s_pb[0 as usize]) as u64), expdlg.own_size())
    kv(((&s_ps[0 as usize]) as u64), expdlg.eig_stuecke())
    nl()
    return 8
}

static mut s_pp: [u8; 17] = "explorer: props \0"
static mut s_pz: [u8; 8] = "zeilen=\0"
static mut s_pb: [u8; 7] = "bytes=\0"
static mut s_ps: [u8; 8] = "stueck=\0"

fn openwith_show(tab: u64) -> u64 {
    let n: u64 = expdlg.oeffnenmit_bauen()
    if n == 0 {
        return 0
    }
    let _m: u64 = popup_at(where_x(), where_y(), expdlg.oeffnenmit_ptr())
    return 10
}

// ------------------------------------------------------------ the reports
//
// The acceptance runs read these lines (tools/design/drive.py, k15,
// explorer2, clip2, vault): the same formats as before, now measured on
// the nodes of the scene tree.

fn say_node(id: u64, kind: u64, key: u64) {
    let n: usize = fuiscene.node_of_key(key)
    if n == fuiscene.NONE {
        return
    }
    say_box(id, kind, fuiscene.node_x(n), fuiscene.node_y(n),
        fuiscene.node_w(n), fuiscene.node_h(n))
}

fn say_box(id: u64, kind: u64, x: u64, y: u64, w: u64, h: u64) {
    say(((&s_rpt[0 as usize]) as u64))
    sayn(id)
    say(((&s_rkind[0 as usize]) as u64))
    sayn(kind)
    say(((&s_rx[0 as usize]) as u64))
    sayn(x)
    say(((&s_ry[0 as usize]) as u64))
    sayn(y)
    say(((&s_rw[0 as usize]) as u64))
    sayn(w)
    say(((&s_rh[0 as usize]) as u64))
    sayn(h)
    nl()
}

fn say_rects(mb: u64, bzur: u64, bvor: u64, bauf: u64, fpfad: u64,
    baum: u64, tab: u64, stat: u64) {
    if s_dbg == 0 {
        return
    }
    // Ids in the order of the picture, top to bottom (tools/k15/layout.py
    // wants the ids of one column to rise with y): the four menu titles,
    // the tool bar, the way, the tabs, the places, the tree, the files.
    var mi: u64 = 0
    while mi < 4 {
        say_node(mi, 7, K_MB + mi)
        mi = mi + 1
    }
    say_node(4, 2, K_BZUR)
    say_node(5, 2, K_BVOR)
    say_node(6, 2, K_BAUF)
    say_node(7, 2, K_BNEU)
    say_node(8, 2, K_BAUS)
    say_node(9, 2, K_BSTART)
    say_node(10, 4, K_PFAD)
    var q: u64 = 0
    while q < krume_n {
        say_node(11 + q, 2, K_KRUME + q)
        q = q + 1
    }
    say_node(25, 5, K_BAUM)
    say_node(26, 6, K_TAB)
    if n_stat != fuiscene.NONE {
        say_box(27, 1, fuiscene.node_x(n_stat), fuiscene.node_y(n_stat),
            fuiscene.node_w(n_stat), fuiscene.node_h(n_stat))
    }
    say_node(24, 5, K_ORTE)
    say_node(28, 5, K_SYM)
    if n_rrow != fuiscene.NONE {
        say_box(23, 7, fuiscene.node_x(n_rrow), fuiscene.node_y(n_rrow),
            fuiscene.node_w(n_rrow), fuiscene.node_h(n_rrow))
    }
    say(((&s_ausk[0 as usize]) as u64))
    sayn(8)
    nl()
    say(((&s_orteliste[0 as usize]) as u64))
    sayn(24)
    nl()
    var key: u64 = K_TAB
    if symansicht == 1 {
        key = K_SYM
    }
    say(((&s_rows[0 as usize]) as u64))
    kv(((&s_rows_x[0 as usize]) as u64), fuiscene.table_text_x(key))
    kv(((&s_rows_b[0 as usize]) as u64), fuiscene.table_base(key, 0))
    kv(((&s_rows_h[0 as usize]) as u64), fuiscene.table_row_h(key))
    kv(((&s_rows_k[0 as usize]) as u64), fuiscene.table_head_base(key))
    kv(((&s_rows_kh[0 as usize]) as u64), 28)
    kv(((&s_rows_f[0 as usize]) as u64), fuiscene.table_rgb(1))
    kv(((&s_rows_g[0 as usize]) as u64), fuiscene.table_rgb(0))
    kv(((&s_rows_s[0 as usize]) as u64), fuiscene.table_rgb(3))
    kv(((&s_rows_c[0 as usize]) as u64), fuiscene.table_rgb(4))
    kv(((&s_rows_d[0 as usize]) as u64), fuiscene.table_rgb(2))
    kv(((&s_rows_i[0 as usize]) as u64), fuiscene.table_icon_x(key))
    kv(((&s_rows_j[0 as usize]) as u64), fuiscene.table_icon_y(key, 0))
    kv(((&s_rows_hb[0 as usize]) as u64), fuiscene.table_rgb(5))
    nl()
    say(((&s_spalt[0 as usize]) as u64))
    let tn: usize = fuiscene.node_of_key(key)
    var cx: u64 = 0
    if tn != fuiscene.NONE {
        cx = fuiscene.node_x(tn)
    }
    var i: u64 = 0
    while i < 4 {
        if i == 0 {
            sayn(fuiscene.table_text_x(key))
        } else {
            sayn(cx + 10)
        }
        say(((&s_sp1[0 as usize]) as u64))
        cx = cx + spalten[(i) as usize]
        i = i + 1
    }
    nl()
}

fn say_menurect() {
    if s_dbg == 0 {
        return
    }
    let w: u64 = fuiscene.win_id()
    say(((&s_mrect[0 as usize]) as u64))
    kv(((&s_mwx[0 as usize]) as u64), wlib.win_cx(w) + fuiscene.menu_x())
    kv(((&s_mwy[0 as usize]) as u64), wlib.win_cy(w) + fuiscene.menu_y())
    kv(((&s_mwh[0 as usize]) as u64), fuiscene.menu_h())
    kv(((&s_mzh[0 as usize]) as u64), 28)
    nl()
}

fn say_dlgrect() {
    if s_dbg == 0 {
        return
    }
    let w: u64 = fuiscene.win_id()
    say(((&s_drect[0 as usize]) as u64))
    kv(((&s_mwx[0 as usize]) as u64), wlib.win_cx(w))
    kv(((&s_mwy[0 as usize]) as u64), wlib.win_cy(w))
    kv(((&s_dx[0 as usize]) as u64), fuiscene.dialog_btn_x(0))
    kv(((&s_dy[0 as usize]) as u64), fuiscene.dialog_btn_y())
    kv(((&s_dw[0 as usize]) as u64), fuiscene.dialog_btn_w())
    kv(((&s_dh[0 as usize]) as u64), fuiscene.dialog_btn_h())
    nl()
}

// ------------------------------------------------------------ the events

fn sort_header(col: u64, baum: u64, tab: u64) {
    if sortby == col {
        sortrev = 1 - sortrev
    } else {
        sortby = col
        sortrev = 0
    }
    view_refresh(baum, tab)
    say(((&s_op[0 as usize]) as u64))
    kv(((&s_rows_w[0 as usize]) as u64), sortby)
    kv(((&s_rows_hh[0 as usize]) as u64), sortrev)
    nl()
    sag_sortierung()
}

static mut s_op: [u8; 14] = "explorer: op \0"
static mut s_rows_w: [u8; 3] = "w=\0"
static mut s_rows_hh: [u8; 3] = "h=\0"

fn rechtsklick() {
    let rx: u64 = fuiscene.right_x()
    let ry: u64 = fuiscene.right_y()
    let ck: u64 = fuiscene.key_at(rx, ry)
    if ck == K_TAB || ck == K_SYM {
        let row: u64 = fuiscene.table_row_at(ck, rx, ry)
        if row != fuiscene.HEAD_ROW {
            // the row under the pointer is the object, unless it already
            // belongs to the marked ones
            if !fuiscene.table_sel_has(ck, row) {
                fuiscene.table_sel_none(ck)
                fuiscene.table_sel_set(ck, row, true)
            }
            fuiscene.table_set_sel(ck, row)
        }
        if vmodus != 0 {
            let _n: u64 = popup_at(rx, ry, msg.get(((&k_t_popb[0 as usize]) as u64)))
            s_offen = 4
        } else {
            let _n: u64 = popup_at(rx, ry, msg.get(((&k_ctx[0 as usize]) as u64)))
            s_offen = 1
        }
    } else if ck == K_BAUM {
        let row2: u64 = fuiscene.table_row_at(ck, rx, ry)
        if row2 != fuiscene.HEAD_ROW {
            fuiscene.table_set_sel(ck, row2)
        }
        let _n2: u64 = popup_at(rx, ry, msg.get(((&k_t_pop[0 as usize]) as u64)))
        s_offen = 11
    }
}

// A drag begins on a row: the path goes on the drag place, a label hangs at
// the pointer.
fn ziehen_los() {
    let row: u64 = fuiscene.drag_row()
    if vmodus != 0 || row >= m_anzahl() {
        return
    }
    // dragging one of several marked rows takes all of them
    s_multidrag = false
    if fuiscene.table_sel_num(cur_key()) > 1 && fuiscene.table_sel_has(cur_key(), row) {
        s_multidrag = true
    }
    ziehen(row)
    zieh_ziel_an(row, K_STAT)
    fuiscene.drag_shield(m_name(m_ord(row)))
}

// Something came down on the window.
fn abgelegt(baum: u64, tab: u64, stat: u64, fpfad: u64) {
    let dk: u64 = fuiscene.drop_key()
    let dr: u64 = fuiscene.drop_row()
    let dx: u64 = fuiscene.drop_x()
    let dy: u64 = fuiscene.drop_y()
    var s_dw: [u8; 20] = "expl: dropziel id=\0\0"
    var s_dr2: [u8; 4] = " r=\0"
    say((&s_dw[0 as usize]) as u64)
    sayn(dk)
    say((&s_dr2[0 as usize]) as u64)
    sayn(dr)
    nl()
    // a drop on the bar of tabs switches to that tab
    var onbar: bool = false
    if n_rrow != fuiscene.NONE {
        if dx >= fuiscene.node_x(n_rrow) && dx < fuiscene.node_x(n_rrow) + fuiscene.node_w(n_rrow)
            && dy >= fuiscene.node_y(n_rrow)
            && dy < fuiscene.node_y(n_rrow) + fuiscene.node_h(n_rrow) {
            onbar = true
        }
    }
    if onbar {
        reiter_wechsel(reiter_unter(dx, dy), baum, tab, stat, fpfad)
    } else if dk == K_ORTE {
        s_wartet = ablegen_ort(dr, baum, tab, stat, fpfad)
        zieh_ziel_aus()
    } else if dk == K_TAB || dk == K_SYM {
        s_wartet = ablegen(dr, baum, tab, stat, fpfad)
        zieh_ziel_aus()
    } else if dk == K_BAUM {
        s_wartet = ablegen(NONE_ROW, baum, tab, stat, fpfad)
        zieh_ziel_aus()
    } else {
        zieh_ziel_aus()
    }
    s_multidrag = false
}

// One activated node. `key` is what `pump` answered.
fn behandeln(key: u64) {
    let baum: u64 = K_BAUM
    let tab: u64 = K_TAB
    let stat: u64 = K_STAT
    let fpfad: u64 = K_PFAD
    if key == fuiscene.KEY_DIALOG {
        let res: u64 = fuiscene.dialog_result()
        let esc: bool = fuiscene.dialog_cancelled()
        let was: u64 = s_wartet
        s_wartet = 0
        dlg_gemeldet = false
        var bestaetigt: bool = false
        if was == 9 {
            if !esc && res >= 1 {
                s_pick = res - 1
                bestaetigt = true
            }
        } else if res == 1 {
            bestaetigt = true
        }
        if bestaetigt {
            s_wartet = vollziehen(was, tab, baum, stat, fpfad)
        }
        rfr()
        return
    }
    if key == fuiscene.KEY_POPUP {
        let pick: u64 = fuiscene.menu_pick()
        if pick >= 1 {
            let mr: u64 = menue_wahl(s_offen, pick - 1, tab, baum, stat, fpfad)
            s_wartet = mr & 255
            s_offen = mr >> 8
        } else {
            s_offen = 0
        }
        return
    }
    if key == fuiscene.KEY_RCLICK {
        if vmodus == 0 || vmodus == 1 || vmodus == 2 {
            rechtsklick()
        }
        return
    }
    if key == fuiscene.KEY_DRAG {
        if vmodus == 0 {
            ziehen_los()
        }
        return
    }
    if key == fuiscene.KEY_DROP {
        abgelegt(baum, tab, stat, fpfad)
        return
    }
    if key >= K_MB && key < K_MB + 4 {
        var m: u64 = key - K_MB
        let n: usize = fuiscene.node_of_key(key)
        var x: u64 = 8
        var y: u64 = 40
        if n != fuiscene.NONE {
            x = fuiscene.node_x(n)
            y = fuiscene.node_y(n) + fuiscene.node_h(n)
        }
        var mtxt: u64 = msg.get(((&k_mfile[0 as usize]) as u64))
        s_offen = 2
        if m == 1 {
            mtxt = msg.get(((&k_medit[0 as usize]) as u64))
            s_offen = 6
        } else if m == 2 {
            mtxt = msg.get(((&k_mview[0 as usize]) as u64))
            s_offen = 3
        } else if m == 3 {
            mtxt = msg.get(((&k_mgo[0 as usize]) as u64))
            s_offen = 7
        }
        let _n: u64 = popup_at(x, y, mtxt)
        return
    }
    if key >= K_CMD && key < K_CMD + 6 {
        // r402: the command bar -- the same actions the menus ran, by the same functions
        var cr: u64 = 0
        let ci: u64 = key - K_CMD
        if ci == 0 {
            cr = menue_wahl(2, 0, tab, baum, stat, fpfad)
        } else if ci == 1 {
            cr = menue_wahl(6, 0, tab, baum, stat, fpfad)
        } else if ci == 2 {
            cr = menue_wahl(6, 1, tab, baum, stat, fpfad)
        } else if ci == 3 {
            cr = menue_wahl(6, 2, tab, baum, stat, fpfad)
        } else if ci == 4 {
            cr = umbenennen_fragen(tab)
        } else {
            cr = delete_ask(tab, false)
        }
        s_wartet = cr & 255
        s_offen = cr >> 8
    } else if key == K_BSTART {
        launcher_open()
    } else if key == K_BAUF {
        eltern(((&pfad[0 as usize]) as u64))
        hist_push(((&pfad[0 as usize]) as u64))
        new_read(baum, tab, stat, fpfad)
    } else if key == K_BZUR {
        if hist_at > 1 {
            hist_at = hist_at - 1
            ulib.strcpy(((&pfad[0 as usize]) as u64), hist_get(hist_at - 1))
            new_read(baum, tab, stat, fpfad)
        }
    } else if key == K_BVOR {
        if hist_at < hist_n {
            hist_at = hist_at + 1
            ulib.strcpy(((&pfad[0 as usize]) as u64), hist_get(hist_at - 1))
            new_read(baum, tab, stat, fpfad)
        }
    } else if key == K_BNEU {
        orte_anzeigen()
        new_read(baum, tab, stat, fpfad)
    } else if key == K_BAUS {
        auswerfen_klick(baum, tab, stat, fpfad)
    } else if key >= K_KRUME && key < K_KRUME + 12 {
        let _kk: bool = krume_klick(key, baum, tab, stat, fpfad)
    } else if key == K_PFAD {
        ulib.strncpy(((&pfad[0 as usize]) as u64), fuiscene.entry_text(K_PFAD), 126)
        hist_push(((&pfad[0 as usize]) as u64))
        new_read(baum, tab, stat, fpfad)
    } else if key == K_ORTE {
        ort_wahl = fuiscene.table_sel(K_ORTE)
        place_walk(ort_wahl, baum, tab, stat, fpfad)
    } else if key == K_BAUM {
        tree_walk(fuiscene.table_sel(K_BAUM), baum, tab, stat, fpfad)
    } else if key == K_TAB || key == K_SYM {
        var hc: u64 = 4294967295
        if key == K_TAB {
            hc = fuiscene.table_head_col()
        }
        if hc != 4294967295 {
            sort_header(hc, baum, tab)
        } else {
            open(cur_row(), baum, tab, stat, fpfad, ((&s_start[0 as usize]) as u64))
        }
    } else if key >= K_RT && key < K_RT + 8 {
        reiter_wechsel(key - K_RT, baum, tab, stat, fpfad)
    } else if key >= K_RX && key < K_RX + 8 {
        reiter_zu_nr(key - K_RX, baum, tab, stat, fpfad)
    } else if key == K_RPLUS {
        reiter_neu(baum, tab, stat, fpfad)
    }
}

fn erste_meldung() {
    let baum: u64 = K_BAUM
    let tab: u64 = K_TAB
    let stat: u64 = K_STAT
    let fpfad: u64 = K_PFAD
    say(((&s_fui[0 as usize]) as u64))
    sayn(fuib.fui_painted())
    say(((&s_fuin[0 as usize]) as u64))
    sayn(fuib.fui_rejected())
    nl()
    say_rects(0, 0, 0, 0, fpfad, baum, tab, stat)
    say(((&s_go2[0 as usize]) as u64))
    nl()
}

fn u_start(args: u64) -> u64 {
    dbg_setup(args)
    var s_no: [u8; 8] = "nohit\0\0\0"
    var s_nc: [u8; 8] = "noclip\0\0"
    var nohit: bool = false
    var noclip: bool = false
    let _mk: u64 = msg.init()
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        let p: u64 = ulib.arg_at(args, a)
        if ulib.streq(p, (&s_no[0 as usize]) as u64) {
            nohit = true
        }
        if ulib.streq(p, (&s_nc[0 as usize]) as u64) {
            noclip = true
        }
        a = a + 1
    }
    fuiscene.set_flags(nohit, noclip)
    fuiscene.set_nohit(nohit)
    if !fuiscene.begin() {
        say(((&s_bad2[0 as usize]) as u64))
        nl()
        return 1
    }
    // Where we start: /data when there is one, else the root, or the folder
    // that was handed over (`explorer /w`).
    var start: [u8; 8] = "/data\0\0\0"
    if ulib.is_dir((&start[0 as usize]) as u64) {
        ulib.strcpy(((&pfad[0 as usize]) as u64), (&start[0 as usize]) as u64)
    }
    var sa: u64 = 1
    while sa < argc {
        let sp: u64 = ulib.arg_at(args, sa)
        if __mmio_read8(sp as *mut u8) as u64 == 47 && ulib.length(sp) < 120
            && ulib.is_dir(sp) {
            ulib.strcpy(((&pfad[0 as usize]) as u64), sp)
            sa = argc
        }
        sa = sa + 1
    }
    // The display name comes from the data (/apps/explorer.osp/INFO).
    let na: u64 = appdir.load(((&t_appdir[0 as usize]) as u64), false)
    var quelle: u64 = 0
    var k2: u64 = 0
    while k2 < na {
        if ulib.streq(appdir.exec_of(k2), ((&t_selbst[0 as usize]) as u64)) {
            ulib.strncpy(((&t_titel[0 as usize]) as u64), appdir.name_of(k2), 62)
            quelle = appdir.file_of(k2)
            k2 = na
        } else {
            k2 = k2 + 1
        }
    }
    if (t_titel[0 as usize]) == 0 as u8 {
        ulib.strncpy(((&t_titel[0 as usize]) as u64), ulib.arg_at(args, 0), 62)
    }
    say(((&s_titel[0 as usize]) as u64))
    say(((&t_titel[0 as usize]) as u64))
    say(((&s_zu[0 as usize]) as u64))
    if quelle != 0 {
        say(quelle)
    }
    say(((&s_end[0 as usize]) as u64))
    nl()

    // The first tab: the folder we start in.
    ulib.strncpy(reiter_p(0), ((&pfad[0 as usize]) as u64), REITER_B - 1)
    reiter_n = 1
    reiter_at = 0
    tabellen_einrichten()
    hist_push(((&pfad[0 as usize]) as u64))
    new_read(K_BAUM, K_TAB, K_STAT, K_PFAD)
    let _zo: u64 = expmodell.time_load()
    expmodell.melde()
    let _no: u64 = exporte.orte_bauen()
    let _nk: u64 = exporte.krume_bauen(((&pfad[0 as usize]) as u64))
    expakt.melde()
    expdlg.melde()
    orte_anzeigen()
    krume_anzeigen()

    let bx: u64 = 70
    let by: u64 = 70
    if !fuiscene.open(bx, by, BW0, BH0, ((&t_titel[0 as usize]) as u64), build) {
        say(((&s_bad2[0 as usize]) as u64))
        nl()
        return 1
    }
    s_up = true
    fuiscene.set_app(((&t_nm[0 as usize]) as u64))
    fuiscene.raise()
    // This window takes drops (of its own rows and of other windows).
    fuiscene.drop_accept(true)
    say(((&s_geo2[0 as usize]) as u64))
    kv(((&s_gx[0 as usize]) as u64), bx)
    kv(((&s_gy[0 as usize]) as u64), by)
    kv(((&s_gw[0 as usize]) as u64), BW0)
    kv(((&s_gh[0 as usize]) as u64), BH0)
    nl()

    var first: bool = true
    var runden: u64 = 0
    var tasten: u64 = fuiscene.key_free_seq()
    var rahmen_zahl: u64 = fuiscene.table_frames()
    var drop_zahl: u64 = wlib.drop_count()
    while fuiscene.alive() && runden < 4000000000 {
        runden = runden + 1
        let key: u64 = fuiscene.pump()
        if first && fuiscene.painted() > 0 {
            first = false
            fuiscene.focus(K_TAB)
            fuiscene.table_set_sel(K_ORTE, fuiscene.HEAD_ROW)
            fuiscene.table_set_sel(K_BAUM, fuiscene.HEAD_ROW)
            erste_meldung()
        }
        // The menu is gone (Esc, a click elsewhere) without a choice.
        if s_offen != 0 && !fuiscene.menu_is_open() && key != fuiscene.KEY_POPUP {
            s_offen = 0
        }
        if key != 0 {
            behandeln(key)
        }
        if fuiscene.table_frames() != rahmen_zahl {
            rahmen_zahl = fuiscene.table_frames()
            sag_auswahl(K_TAB)
        }
        if wlib.drop_count() != drop_zahl {
            drop_zahl = wlib.drop_count()
            say(((&s_dc[0 as usize]) as u64))
            sayn(drop_zahl)
            nl()
        }
        // Something happened on the bus (a stick in, a stick out).
        let nn: u64 = wlib.noti_new()
        if nn != noti_stand {
            let erster: bool = noti_stand == 0xFFFFFFFFFFFFFFFF
            noti_stand = nn
            if !erster {
                let vorher: u64 = exporte.places_num()
                orte_anzeigen()
                if exporte.places_num() != vorher {
                    rfr()
                }
            }
        }
        // The keys nobody took (not a text field): the shortcuts.
        if fuiscene.key_free_seq() != tasten {
            tasten = fuiscene.key_free_seq()
            let taste: u64 = fuiscene.key_free()
            // while the path field has the keyboard only its own shortcuts
            var frei: bool = true
            if fuiscene.focus_key() == K_PFAD && taste != T_STRG_L
                && taste != T_STRG_T && taste != T_STRG_W
                && taste != wlib.KEY_F5 && taste != wlib.KEY_ESC {
                frei = false
            }
            if frei && vmodus == 0 && !fuiscene.dialog_is_open() && s_offen == 0 {
                if taste == wlib.KEY_ESC {
                    if pfadfeld_an {
                        krume_umschalten(K_PFAD)
                    }
                } else if taste == T_STRG_L {
                    krume_umschalten(K_PFAD)
                } else if taste == T_STRG_T {
                    reiter_neu(K_BAUM, K_TAB, K_STAT, K_PFAD)
                } else if taste == T_STRG_W {
                    reiter_zu(K_BAUM, K_TAB, K_STAT, K_PFAD)
                } else {
                    let r: u64 = key_block(taste, K_BAUM, K_TAB, K_STAT, K_PFAD)
                    s_wartet = r & 255
                    if (r >> 8) != 0 {
                        s_offen = r >> 8
                    }
                }
            }
        }
        if fuiscene.dialog_is_open() && !dlg_gemeldet {
            say_dlgrect()
            dlg_gemeldet = true
        }
    }
    return 0
}


// A drag of one of several marked rows takes all of them.
fn drag_liste(zp: u64) {
    if s_multidrag {
        let _n: u64 = select_list(K_TAB)
    } else {
        expakt.list_clear()
        let _a: bool = expakt.list_add(zp)
    }
}

fn drag_korb(zp: u64) -> u64 {
    if !s_multidrag {
        return expakt.in_korb(zp)
    }
    let _n: u64 = select_list(K_TAB)
    var rc: u64 = 0
    var i: u64 = 0
    while i < expakt.list_num() {
        let r2: u64 = expakt.in_korb(expakt.list_at(i))
        if r2 != 0 {
            rc = r2
        }
        i = i + 1
    }
    return rc
}
