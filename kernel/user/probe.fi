profile kernel

import ulib

export { u_start }

const A_ONE: u64 = 7
const A_ALIAS: u64 = A_ONE
const SCALE: u64 = 16777216

static mut tab: [u64; 4] = [0 as u64; 4]
static mut two: [u64; 8] = [0 as u64; 8]

fn mulf(a: u64, b: u64) -> u64 {
    return (a * b) >> 24
}

fn fifth_root(v: u64) -> u64 {
    if v == 0 {
        return 0
    }
    var r: u64 = SCALE
    var k: u64 = 0
    while k < 60 {
        let r2: u64 = mulf(r, r)
        let r4: u64 = mulf(r2, r2)
        if r4 == 0 {
            k = 60
        } else {
            let q: u64 = (v << 24) / r4
            let nr: u64 = (4 * r + q) / 5
            if nr == r {
                k = 60
            } else {
                r = nr
                k = k + 1
            }
        }
    }
    return r
}

fn lin_of(c: u64) -> u64 {
    let x: u64 = (c * SCALE) / 255
    if c <= 10 {
        return (x * 10000) / 129200
    }
    let t: u64 = ((x + (55 * SCALE) / 1000) * 1000) / 1055
    let t2: u64 = mulf(t, t)
    let t04: u64 = fifth_root(t2)
    return mulf(t2, t04)
}

fn u_start(args: u64) -> u64 {
    let _a: u64 = args
    tab[(0) as usize] = A_ALIAS
    two[(3) as usize] = 5
    ulib.sayn(A_ALIAS)
    ulib.nl()
    ulib.sayn(lin_of(0))
    ulib.nl()
    ulib.sayn(lin_of(10))
    ulib.nl()
    ulib.sayn(lin_of(128))
    ulib.nl()
    ulib.sayn(lin_of(255))
    ulib.nl()
    return 0
}
