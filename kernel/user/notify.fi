// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/notify.fi -- post a notification (a test aid and a small tool).
//
//     notify <words ...>     one notification, the words joined by blanks
//
// The task bar shows it as a toast and keeps it in the notification list. The
// acceptance run of the bar's pop-ups (tools/barpop/run.sh) uses it to raise a
// toast from the shell.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 20] = "notify: <text ...>\n\0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        let _e: u64 = ulib.eput((&s_use[0 as usize]) as u64)
        return 1
    }
    var buf: [u8; 96] = [0 as u8; 96]
    var at: u64 = 0
    var i: u64 = 1
    while i < argc {
        let a: u64 = ulib.arg_at(args, i)
        let n: u64 = ulib.length(a)
        if at + n + 1 < 95 {
            ulib.copy((&buf[0 as usize]) as u64 + at, a, n)
            at = at + n
            if i + 1 < argc {
                __mmio_write8(((&buf[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
                at = at + 1
            }
        }
        i = i + 1
    }
    let r: u64 = ulib.noti_post(1, (&buf[0 as usize]) as u64, at)
    if ulib.bad(r) {
        return 2
    }
    return 0
}
