    647205779 as u64, 328965 as u64, 0 as u64, 50331648 as u64, 
    16777216 as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64, 0 as u64, 
    0 as u64
]

// Welche der drei Groessen fuer eine gewuenschte Kantenlaenge
// genommen wird: die groesste, die noch hineinpasst. Ein Ring
// von einem Bildpunkt Staerke vertraegt keine Interpolation.
fn breit(wunsch: u64) -> u64 {
    if wunsch >= 32 {
        return 32
    }
    if wunsch >= 24 {
        return 24
    }
    if wunsch >= 16 {
        return 16
    }
    return 16
}

// Ein Bildpunkt, 0xAARRGGBB. Ausserhalb: durchsichtig.
fn punkt(n: u64, x: u64, y: u64) -> u64 {
    if x >= n || y >= n {
        return 0
    }
    let i: u64 = y * n + x
    if n == 16 {
        return b16[(i) as usize]
    }
    if n == 24 {
        return b24[(i) as usize]
    }
    if n == 32 {
        return b32[(i) as usize]
    }
    return 0
}
