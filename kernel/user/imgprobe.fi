profile kernel
import ulib
export { u_start }
static mut t: [i64; 8] = [0 as i64; 8]
static mut u16t: [u16; 4] = [0 as u16; 4]
fn u_start(args: u64) -> u64 {
    var a: i64 = 0 - 1000
    let b: i64 = a >> 3
    t[(0) as usize] = b
    var c: i64 = -5
    let d: i64 = c * 3
    u16t[(1) as usize] = 65535 as u16
    var x: u64 = 0
    if b < 0 { x = (0 - b) as u64 }
    ulib.sayn(x)
    ulib.nl()
    ulib.sayn((0 - d) as u64)
    ulib.nl()
    ulib.sayn(u16t[(1) as usize] as u64)
    ulib.nl()
    var e: i64 = 1
    e = e << 13
    ulib.sayn(e as u64)
    ulib.nl()
    let f: u64 = 300
    let g: u8 = (f & 255) as u8
    ulib.sayn(g as u64)
    ulib.nl()
    return 0
}
