profile app

import ulib
import lineout
import wlib
import icons
import fuiscene
import msg
import dropdown
import langs
import welcome_net
import welcome_conf
import welcome_open
import wlanconf

export {
    init, build, on_key, tick, page, set_page, show_on, say_page,
    PAGES, EV_NONE, EV_PAGE, EV_QUIT, EV_SHOW, EV_VIEW, K_BACK, K_NEXT, K_ROWS, K_NETS
}

const PAGES: u64 = 3
const PAGE_LANG: u64 = 0
const PAGE_NET: u64 = 1
const PAGE_DONE: u64 = 2
const EV_NONE: u64 = 0
const EV_PAGE: u64 = 1
const EV_QUIT: u64 = 2
const EV_SHOW: u64 = 3
const EV_VIEW: u64 = 4
const K_BACK: u64 = 20
const K_NEXT: u64 = 21
const K_DOTS: u64 = 22
const K_REFRESH: u64 = 30
const K_NETS: u64 = 31
const K_PW: u64 = 32
const K_CONNECT: u64 = 33
const K_ROWS: u64 = 40
const K_SHOW: u64 = 41
const MARGIN: u64 = 28
const ROW_H: u64 = 40
const CTL_H: u64 = 36
const NAV_PX: u64 = 40
const DOT: u64 = 8
const DOT_ON: u64 = 20
const SETTINGS_UPDATE: u64 = 14
const SETTINGS_DISPLAY: u64 = 1
const SETTINGS_HOME: u64 = 0
const PW_MIN: u64 = 8
const PW_MAX: u64 = 63
const MAX_ROWS: u64 = 5

static mut k_title: [u8; 14] = "welcome.title\0"
static mut k_show: [u8; 13] = "welcome.show\0"
static mut k_sett: [u8; 13] = "welcome.sett\0"
static mut k_back: [u8; 13] = "welcome.back\0"
static mut k_next: [u8; 13] = "welcome.next\0"
static mut k_done: [u8; 13] = "welcome.done\0"
static mut k_lang_head: [u8; 18] = "welcome.lang.head\0"
static mut k_lang_note: [u8; 18] = "welcome.lang.note\0"
static mut k_lang_search: [u8; 20] = "welcome.lang.search\0"
static mut k_lang_open: [u8; 18] = "welcome.lang.open\0"
static mut k_net_head: [u8; 17] = "welcome.net.head\0"
static mut k_net_note: [u8; 17] = "welcome.net.note\0"
static mut k_net_none: [u8; 22] = "welcome.net.noadapter\0"
static mut k_net_empty: [u8; 18] = "welcome.net.empty\0"
static mut k_net_open: [u8; 17] = "welcome.net.open\0"
static mut k_net_secured: [u8; 20] = "welcome.net.secured\0"
static mut k_net_saved: [u8; 18] = "welcome.net.saved\0"
static mut k_net_pw: [u8; 15] = "welcome.net.pw\0"
static mut k_net_connect: [u8; 20] = "welcome.net.connect\0"
static mut k_net_fail: [u8; 17] = "welcome.net.fail\0"
static mut k_net_short: [u8; 18] = "welcome.net.short\0"
static mut k_net_retry: [u8; 18] = "welcome.net.retry\0"
static mut k_done_head: [u8; 18] = "welcome.done.head\0"
static mut k_done_note: [u8; 18] = "welcome.done.note\0"
static mut k_step_upd: [u8; 17] = "welcome.step.upd\0"
static mut k_step_disp: [u8; 18] = "welcome.step.disp\0"

static mut page_now: u64 = 0
static mut net_pick: u64 = 0
static mut net_status: u64 = 0
static mut net_seen: u64 = 0
static mut show_now: bool = false
static mut fake_nets: bool = false
static mut net_icons: [u64; 16] = [0 as u64; 16]
static mut done_chev: [u64; 4] = [0 as u64; 4]
static mut net_locks: [u64; 16] = [0 as u64; 16]
static mut done_icons: [u64; 4] = [0 as u64; 4]
static mut done_rows: [u8; 96] = [0 as u8; 96]
static mut empty: [u8; 2] = [0 as u8; 2]

fn text(k: u64) -> u64 {
    return msg.get(k)
}

fn page() -> u64 {
    return page_now
}

fn show_on() -> bool {
    return show_now
}

fn set_page(p: u64) {
    if p >= PAGES {
        return
    }
    page_now = p
    net_status = 0
    dropdown.close()
    if p == PAGE_NET {
        net_reload()
    }
}

fn net_reload() {
    if fake_nets {
        welcome_net.seed_fake(text((&k_net_open[0 as usize]) as u64), text((&k_net_secured[0 as usize]) as u64), text((&k_net_saved[0 as usize]) as u64))
    } else {
        welcome_net.refresh(text((&k_net_open[0 as usize]) as u64), text((&k_net_secured[0 as usize]) as u64), text((&k_net_saved[0 as usize]) as u64))
    }
    net_seen = welcome_net.count() * 4 + welcome_net.link_state()
    if net_pick >= welcome_net.count() {
        net_pick = 0
    }
}

fn put(at: u64, src: u64) -> u64 {
    var o: u64 = at
    var i: u64 = 0
    while *((src + i) as *mut u8) != 0 as u8 && o < 90 {
        done_rows[(o) as usize] = *((src + i) as *mut u8)
        o = o + 1
        i = i + 1
    }
    return o
}

fn build_done_rows() {
    var o: u64 = put(0, text((&k_step_upd[0 as usize]) as u64))
    done_rows[(o) as usize] = 10 as u8
    o = put(o + 1, text((&k_step_disp[0 as usize]) as u64))
    done_rows[(o) as usize] = 10 as u8
    o = put(o + 1, text((&k_sett[0 as usize]) as u64))
    done_rows[(o) as usize] = 10 as u8
    done_rows[(o + 1) as usize] = 0 as u8
    done_icons[(0) as usize] = wlib.icon_id(icons.NAV_REFRESH)
    done_icons[(1) as usize] = wlib.icon_id(icons.BRIGHTNESS)
    done_icons[(2) as usize] = wlib.icon_id(icons.SETTINGS)
    done_chev[(0) as usize] = wlib.icon_id(icons.CHEVRON_RIGHT)
    done_chev[(1) as usize] = wlib.icon_id(icons.CHEVRON_RIGHT)
    done_chev[(2) as usize] = wlib.icon_id(icons.CHEVRON_RIGHT)
}

fn init() {
    let _n: u64 = langs.scan()
    dropdown.init(text((&k_lang_search[0 as usize]) as u64), text((&k_lang_open[0 as usize]) as u64))
    dropdown.set_items(langs.names_blob())
    dropdown.set_selected(langs.index_of(msg.lang()))
    show_now = welcome_conf.conf_on()
    fake_nets = welcome_conf.conf_num(102 as u8, 61 as u8) == 1
    net_pick = welcome_conf.conf_num(115 as u8, 61 as u8)
    var i: u64 = 0
    while i < 16 {
        net_icons[(i) as usize] = wlib.icon_id(icons.PAGE_WIFI)
        i = i + 1
    }
}

fn head_key() -> u64 {
    if page_now == PAGE_LANG {
        return (&k_lang_head[0 as usize]) as u64
    }
    if page_now == PAGE_NET {
        return (&k_net_head[0 as usize]) as u64
    }
    return (&k_done_head[0 as usize]) as u64
}

fn note_key() -> u64 {
    if page_now == PAGE_LANG {
        return (&k_lang_note[0 as usize]) as u64
    }
    if page_now == PAGE_NET {
        return (&k_net_note[0 as usize]) as u64
    }
    return (&k_done_note[0 as usize]) as u64
}

fn draw_dots(key: u64, x: u64, y: u64, w: u64, h: u64) {
    let s: u64 = fuiscene.scale()
    let total: u64 = (PAGES - 1) * (DOT + DOT) * s + DOT_ON * s
    var at: u64 = x + (w - total) / 2
    var i: u64 = 0
    while i < PAGES {
        var dw: u64 = DOT * s
        var col: u32 = fuiscene.role_col2(fuiscene.R_BORDER)
        if i == page_now {
            dw = DOT_ON * s
            col = fuiscene.role_col2(fuiscene.R_ACCENT)
        }
        fuiscene.cv_round_raw(at, y + (h - DOT * s) / 2, dw, DOT * s, DOT * s / 2, col)
        at = at + dw + DOT * s
        i = i + 1
    }
}

fn build_lang(body: usize, w: u64) {
    dropdown.build(body, w, sat(fuiscene.height(), 230))
}

fn sat(a: u64, b: u64) -> u64 {
    if a > b {
        return a - b
    }
    return 0
}

fn build_net(body: usize, w: u64) {
    let n: u64 = welcome_net.count()
    if welcome_net.link_state() == welcome_net.LINK_NO_DRIVER {
        let _a: usize = fuiscene.label_muted(body, text((&k_net_none[0 as usize]) as u64))
        return
    }
    if n == 0 {
        let _b: usize = fuiscene.label_muted(body, text((&k_net_empty[0 as usize]) as u64))
        return
    }
    var rows: u64 = n
    if rows > MAX_ROWS {
        rows = MAX_ROWS
    }
    let _t: usize = fuiscene.table_list(body, K_NETS, w, rows * ROW_H + 2, 2, welcome_net.blob())
    fuiscene.table_single(K_NETS, true)
    fuiscene.table_hover(K_NETS, true)
    fuiscene.table_row_height(K_NETS, ROW_H)
    fuiscene.table_icons(K_NETS, (&net_icons[0 as usize]) as u64)
    var r: u64 = 0
    while r < 16 {
        net_locks[(r) as usize] = 0
        if r < n && welcome_net.needs_password(r) && !welcome_net.is_known(r) {
            net_locks[(r) as usize] = wlib.icon_id(icons.NET_LOCK)
        }
        r = r + 1
    }
    fuiscene.table_exact(K_NETS, true)
    fuiscene.table_font(K_NETS, 14, 13, 18)
    fuiscene.table_trail(K_NETS, (&net_locks[0 as usize]) as u64)
    fuiscene.table_align_right(K_NETS, 1, true)
    fuiscene.table_colw(K_NETS, 0, sat(w, 130))
    fuiscene.table_colw(K_NETS, 1, 130)
    fuiscene.table_set_sel(K_NETS, net_pick)
    let line: usize = fuiscene.row(body)
    fuiscene.set_gap(line, 8)
    if welcome_net.needs_password(net_pick) && !welcome_net.is_known(net_pick) {
        let e: usize = fuiscene.entry(line, K_PW, 340, (&empty[0 as usize]) as u64)
        fuiscene.set_size(e, 340, CTL_H)
        fuiscene.entry_secret(K_PW, true)
        fuiscene.entry_hint(K_PW, text((&k_net_pw[0 as usize]) as u64))
    }
    let b: usize = fuiscene.button_main(line, text((&k_net_connect[0 as usize]) as u64), K_CONNECT)
    fuiscene.set_size(b, 110, CTL_H)
    if net_status != 0 {
        let _s: usize = fuiscene.label_muted(body, text(net_status))
    }
}

fn build_done(body: usize, w: u64) {
    build_done_rows()
    let _t: usize = fuiscene.table_list(body, K_ROWS, w, 3 * ROW_H + 2, 1, (&done_rows[0 as usize]) as u64)
    fuiscene.table_single(K_ROWS, true)
    fuiscene.table_click_only(K_ROWS, true)
    fuiscene.table_hover(K_ROWS, true)
    fuiscene.table_row_height(K_ROWS, ROW_H)
    fuiscene.table_icons(K_ROWS, (&done_icons[0 as usize]) as u64)
    fuiscene.table_set_sel(K_ROWS, 4294967295)
    fuiscene.table_exact(K_ROWS, true)
    fuiscene.table_font(K_ROWS, 14, 14, 18)
    fuiscene.table_trail(K_ROWS, (&done_chev[0 as usize]) as u64)
    let _c: usize = fuiscene.check(body, text((&k_show[0 as usize]) as u64), K_SHOW, show_now)
}

fn build() {
    let col: usize = fuiscene.root()
    fuiscene.set_pad(col, MARGIN)
    fuiscene.set_gap(col, 4)
    let w: u64 = sat(fuiscene.width(), 2 * MARGIN)
    let head: usize = fuiscene.row(col)
    fuiscene.set_size(head, w, 32)
    let h1: usize = fuiscene.label_heading(head, text(head_key()))
    fuiscene.set_grow(h1, 1)
    if page_now == PAGE_NET {
        let r: usize = fuiscene.icon_link(head, icons.NAV_REFRESH, text((&k_net_retry[0 as usize]) as u64), K_REFRESH, CTL_H, CTL_H)
        fuiscene.set_noshrink(r)
    }
    let _n: usize = fuiscene.label_muted(col, text(note_key()))
    let body: usize = fuiscene.column(col)
    fuiscene.set_gap(body, 12)
    fuiscene.set_grow(body, 1)
    if page_now == PAGE_LANG {
        build_lang(body, w)
    } else if page_now == PAGE_NET {
        build_net(body, w)
    } else {
        build_done(body, w)
    }
    let foot: usize = fuiscene.row(col)
    fuiscene.set_size(foot, w, NAV_PX)
    let b: usize = fuiscene.icon_link(foot, icons.ARROW_LEFT, text((&k_back[0 as usize]) as u64), K_BACK, NAV_PX, NAV_PX)
    fuiscene.set_noshrink(b)
    fuiscene.set_enabled(b, page_now > 0)
    let d: usize = fuiscene.canvas2(foot, K_DOTS, 100, NAV_PX, draw_dots)
    fuiscene.flat(d)
    fuiscene.set_grow(d, 1)
    var glyph: u64 = icons.ARROW_RIGHT
    var label: u64 = (&k_next[0 as usize]) as u64
    if page_now == PAGES - 1 {
        glyph = icons.CHECK
        label = (&k_done[0 as usize]) as u64
    }
    let nx: usize = fuiscene.icon_link(foot, glyph, text(label), K_NEXT, NAV_PX, NAV_PX)
    fuiscene.set_noshrink(nx)
}

fn apply_language() {
    var s_lg: [u8; 19] = "welcome: language \0"
    let code: u64 = langs.code_at(dropdown.selected())
    if msg.save_lang(code) {
        let _l: bool = msg.set_lang(code)
    }
    say((&s_lg[0 as usize]) as u64)
    say(code)
    lineout.end_line()
    fuiscene.refresh()
}

fn connect() {
    let ssid: u64 = welcome_net.ssid_at(net_pick)
    var psk: u64 = (&empty[0 as usize]) as u64
    if welcome_net.needs_password(net_pick) && !welcome_net.is_known(net_pick) {
        psk = fuiscene.entry_text(K_PW)
        let n: u64 = ulib.length(psk)
        if n < PW_MIN || n > PW_MAX {
            net_status = (&k_net_short[0 as usize]) as u64
            fuiscene.refresh()
            return
        }
    }
    if welcome_net.is_known(net_pick) || wlanconf.save(ssid, psk) {
        net_status = (&k_net_saved[0 as usize]) as u64
        var s_nc: [u8; 22] = "welcome: net saved\0\0\0\0"
        say((&s_nc[0 as usize]) as u64)
        lineout.end_line()
    } else {
        net_status = (&k_net_fail[0 as usize]) as u64
    }
    fuiscene.refresh()
}

fn open_row(r: u64) {
    if r == 0 {
        welcome_open.open_settings(SETTINGS_UPDATE)
    } else if r == 1 {
        welcome_open.open_settings(SETTINGS_DISPLAY)
    } else {
        welcome_open.open_settings(SETTINGS_HOME)
    }
}

fn on_key(key: u64) -> u64 {
    if key >= dropdown.K_FIELD && key <= dropdown.K_LIST {
        let r: u64 = dropdown.on_key(key)
        if r == dropdown.EV_PICK {
            apply_language()
        }
        if r == dropdown.EV_NONE {
            return EV_NONE
        }
        return EV_VIEW
    }
    if key == K_BACK && page_now > 0 {
        set_page(page_now - 1)
        fuiscene.refresh()
        fuiscene.focus_clear()
        return EV_PAGE
    }
    if key == K_NEXT {
        if page_now + 1 >= PAGES {
            return EV_QUIT
        }
        set_page(page_now + 1)
        fuiscene.refresh()
        fuiscene.focus_clear()
        return EV_PAGE
    }
    if key == K_REFRESH {
        net_status = 0
        net_reload()
        fuiscene.refresh()
        return EV_NONE
    }
    if key == K_NETS {
        net_pick = fuiscene.table_sel(K_NETS)
        net_status = 0
        fuiscene.refresh()
        return EV_NONE
    }
    if key == K_CONNECT {
        connect()
        return EV_NONE
    }
    if key == K_ROWS {
        open_row(fuiscene.table_sel(K_ROWS))
        return EV_NONE
    }
    if key == K_SHOW {
        show_now = fuiscene.value_of(K_SHOW) != 0
        let _w: bool = welcome_conf.conf_write(show_now)
        return EV_SHOW
    }
    return EV_NONE
}

fn tick() {
    if page_now == PAGE_LANG {
        dropdown.poll()
        return
    }
    if page_now == PAGE_NET {
        let before: u64 = net_seen
        net_reload()
        if net_seen != before {
            fuiscene.refresh()
        }
    }
}

fn say_page() {
    var s_p: [u8; 15] = "welcome: page \0"
    var s_of: [u8; 5] = " of \0"
    say(((&s_p[0 as usize]) as u64))
    lineout.add_unum(page_now)
    say(((&s_of[0 as usize]) as u64))
    lineout.add_unum(PAGES)
    lineout.end_line()
}

fn say(p: u64) {
    lineout.add_text(p)
}
