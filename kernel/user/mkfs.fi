profile kernel

import ulib
import mkfs.out
import mkfs.listing
import mkfs.buildcmd

export { u_start }

static mut w_list: [u8; 5] = "list\0"
static mut w_meta: [u8; 5] = "meta\0"
static mut w_times: [u8; 6] = "times\0"
static mut w_cat: [u8; 4] = "cat\0"
static mut w_where: [u8; 6] = "where\0"
static mut w_build: [u8; 6] = "build\0"

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc < 3 {
        out.usage()
        return 2
    }
    let cmd: u64 = ulib.arg_at(args, 1)
    let image: u64 = ulib.arg_at(args, 2)
    let path: u64 = ulib.arg_at(args, 3)
    if ulib.streq(cmd, (&w_build[0 as usize]) as u64) {
        return buildcmd.cmd_build(args, argc)
    }
    if ulib.streq(cmd, (&w_list[0 as usize]) as u64) {
        return listing.cmd_list(image)
    }
    if ulib.streq(cmd, (&w_meta[0 as usize]) as u64) {
        return listing.cmd_meta(image, path)
    }
    if argc >= 4 && ulib.streq(cmd, (&w_times[0 as usize]) as u64) {
        return listing.cmd_times(image, path)
    }
    if argc >= 4 && ulib.streq(cmd, (&w_cat[0 as usize]) as u64) {
        return listing.cmd_cat(image, path)
    }
    if argc >= 4 && ulib.streq(cmd, (&w_where[0 as usize]) as u64) {
        return listing.cmd_where(image, path)
    }
    out.err_unknown_command(cmd)
    return 2
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
