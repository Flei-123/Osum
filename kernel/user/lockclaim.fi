// kernel/user/lockclaim.fi -- r389: a program that tries to take over the lock.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_w: [u8; 24] = "lockclaim: WON, unlock=\0"
    let c: u64 = ulib.sys(1870, 4, 0, 0)
    if c == 0 {
        let u: u64 = ulib.sys(1870, 2, 0, 0)
        ulib.say((&s_w[0 as usize]) as u64)
        ulib.sayu(u)
        ulib.nl()
        return 1
    }
    return 0
}
