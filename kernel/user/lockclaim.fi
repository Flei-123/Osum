// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/lockclaim.fi -- r389: a program that tries to take over the lock.
//
// Started by `a11ydemo lockrace` right after the locker was killed. It asks
// `osum_sperre` op 4 ("be the locker"); if the kernel says yes it also tries op 2
// ("open") and prints one line. Exit code: 1 = it became the locker, 0 = refused.
// Tiny on purpose: the probe starts dozens of these inside the 0.3 s the kernel
// needs to start a new locker.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_w: [u8; 24] = "lockclaim: WON, unlock=\0"
    let c: u64 = ulib.sys(1870, 4, 0, 0)
    if c == 0 {
        let u: u64 = ulib.sys(1870, 2, 0, 0)
        ulib.say((&s_w[0 as usize]) as u64)
        ulib.sayu(u)
        ulib.nl()
        return 1
    }
    return 0
}
