profile kernel

import icons

export { COUNT, NO_KEY, init, nav_key, arg_word, icon, table_key, table_cols, col_width, none_key, is_table, page_of_key }

const COUNT: u64 = 8
const NO_KEY: u64 = 0
const MAXCOL: u64 = 8

static mut n_nav: [u64; 8] = [0 as u64; 8]
static mut n_arg: [u64; 8] = [0 as u64; 8]
static mut n_icon: [u64; 8] = [0 as u64; 8]
static mut n_key: [u64; 8] = [0 as u64; 8]
static mut n_cols: [u64; 8] = [0 as u64; 8]
static mut n_none: [u64; 8] = [0 as u64; 8]
static mut n_wid: [u64; 64] = [0 as u64; 64]

static mut s_proc: [u8; 19] = "taskmgr.page.proc\0\0"
static mut s_perf: [u8; 19] = "taskmgr.page.perf\0\0"
static mut s_start: [u8; 20] = "taskmgr.page.start\0\0"
static mut s_det: [u8; 18] = "taskmgr.page.det\0\0"
static mut s_bench: [u8; 19] = "taskmgr.page.bench\0"
static mut s_users: [u8; 19] = "taskmgr.page.users\0"
static mut s_hist: [u8; 19] = "taskmgr.page.hist\0\0"
static mut s_svc: [u8; 18] = "taskmgr.page.svc\0\0"
static mut a_proc: [u8; 10] = "processes\0"
static mut a_perf: [u8; 12] = "performance\0"
static mut a_start: [u8; 8] = "startup\0"
static mut a_det: [u8; 8] = "details\0"
static mut a_bench: [u8; 6] = "bench\0"
static mut a_users: [u8; 6] = "users\0"
static mut a_hist: [u8; 8] = "history\0"
static mut a_svc: [u8; 9] = "services\0"
static mut z_start: [u8; 17] = "taskmgr.st.none\0\0"
static mut z_bench: [u8; 15] = "taskmgr.b.none\0"
static mut z_users: [u8; 15] = "taskmgr.unone\0\0"
static mut z_hist: [u8; 17] = "taskmgr.h.none\0\0\0"
static mut z_svc: [u8; 17] = "taskmgr.svc.none\0"

fn reg(p: u64, nav: u64, arg: u64, ic: u64, key: u64, cols: u64, none: u64) {
    n_nav[p as usize] = nav
    n_arg[p as usize] = arg
    n_icon[p as usize] = ic
    n_key[p as usize] = key
    n_cols[p as usize] = cols
    n_none[p as usize] = none
}

fn widths(p: u64, a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64) {
    let at: u64 = p * MAXCOL
    n_wid[at as usize] = a
    n_wid[(at + 1) as usize] = b
    n_wid[(at + 2) as usize] = c
    n_wid[(at + 3) as usize] = d
    n_wid[(at + 4) as usize] = e
    n_wid[(at + 5) as usize] = f
    n_wid[(at + 6) as usize] = g
}

fn init() {
    reg(0, (&s_proc[0]) as u64, (&a_proc[0]) as u64, icons.PAGE_LIST, NO_KEY, 0, 0)
    reg(1, (&s_perf[0]) as u64, (&a_perf[0]) as u64, icons.PAGE_ACTIVITY, NO_KEY, 0, 0)
    reg(2, (&s_start[0]) as u64, (&a_start[0]) as u64, icons.PAGE_STARTUP, 5, 4, (&z_start[0]) as u64)
    reg(3, (&s_det[0]) as u64, (&a_det[0]) as u64, icons.PAGE_DETAILS, NO_KEY, 0, 0)
    reg(4, (&s_bench[0]) as u64, (&a_bench[0]) as u64, icons.PAGE_GAUGE, 11, 2, (&z_bench[0]) as u64)
    reg(5, (&s_users[0]) as u64, (&a_users[0]) as u64, icons.PAGE_CPU, 13, 4, (&z_users[0]) as u64)
    reg(6, (&s_hist[0]) as u64, (&a_hist[0]) as u64, icons.PAGE_MEMORY, 14, 6, (&z_hist[0]) as u64)
    reg(7, (&s_svc[0]) as u64, (&a_svc[0]) as u64, icons.SETTINGS, 15, 7, (&z_svc[0]) as u64)
    widths(2, 160, 300, 96, 120, 0, 0, 0)
    widths(4, 360, 200, 0, 0, 0, 0, 0)
    widths(5, 160, 160, 160, 200, 0, 0, 0)
    widths(6, 220, 120, 80, 80, 120, 140, 0)
    widths(7, 160, 100, 70, 80, 80, 130, 140)
}

fn nav_key(p: u64) -> u64 {
    return n_nav[p as usize]
}

fn arg_word(p: u64) -> u64 {
    return n_arg[p as usize]
}

fn icon(p: u64) -> u64 {
    return n_icon[p as usize]
}

fn table_key(p: u64) -> u64 {
    return n_key[p as usize]
}

fn table_cols(p: u64) -> u64 {
    return n_cols[p as usize]
}

fn none_key(p: u64) -> u64 {
    return n_none[p as usize]
}

fn is_table(p: u64) -> bool {
    return p < COUNT && n_key[p as usize] != NO_KEY
}

fn col_width(p: u64, c: u64) -> u64 {
    return n_wid[(p * MAXCOL + c) as usize]
}

fn page_of_key(k: u64) -> u64 {
    var p: u64 = 0
    while p < COUNT {
        if n_key[p as usize] == k && k != NO_KEY {
            return p
        }
        p = p + 1
    }
    return COUNT
}
