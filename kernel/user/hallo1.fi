// SPDX-License-Identifier: GPL-2.0-only
// tools/install/h1.fi -- RUNDE INSTALL: das Paketprogramm in zwei
// Fassungen. Es tut nichts als EINE Zeile zu schreiben, und genau
// deshalb kann der Testlauf sagen, WELCHE Fassung wirklich gelaufen ist
// -- nicht welche installiert ist, sondern welche laeuft.
profile kernel
import ulib
export { u_start }
fn u_start(args: u64) -> u64 {
    var s: [u8; 23] = "paket-hallo fassung 1\n\0"
    ulib.say((&s[0 as usize]) as u64)
    return 0
}
