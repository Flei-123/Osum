profile kernel

import ulib
import libc.io
import actwire
import vaultcall

export { u_start }

const R_OK: u64 = 0
const R_FAIL: u64 = 1
const R_NOBUS: u64 = 2

static mut line: [u8; 512] = [0 as u8; 512]

fn is_hex_key(k: u64, kn: u64) -> bool {
    var names: [u8; 56] = "pw\0pin\0new\0title\0origins\0username\0password\0notes\0origin\0"
    var at: u64 = 0
    while at < 55 {
        let l: u64 = actwire.slen((&names[0 as usize]) as u64 + at)
        if l == kn {
            var same: bool = true
            var i: u64 = 0
            while i < kn {
                if actwire.ld8(k, i) != actwire.ld8((&names[0 as usize]) as u64 + at, i) {
                    same = false
                }
                i = i + 1
            }
            if same {
                return true
            }
        }
        at = at + l + 1
    }
    return false
}

fn read_secret() -> u64 {
    let lp: u64 = (&line[0 as usize]) as u64
    let n: u64 = io.read(0, lp, 511)
    if ulib.bad(n) {
        return 0
    }
    var m: u64 = n
    while m > 0 && (actwire.ld8(lp, m - 1) == 10 || actwire.ld8(lp, m - 1) == 13) {
        m = m - 1
    }
    return m
}

fn add_arg(a: u64) {
    var kn: u64 = 0
    while actwire.ld8(a, kn) != 0 && actwire.ld8(a, kn) != 61 {
        kn = kn + 1
    }
    if actwire.ld8(a, kn) != 61 {
        return
    }
    var i: u64 = 0
    while i < kn {
        actwire.ob_ch(actwire.ld8(a, i))
        i = i + 1
    }
    actwire.ob_ch(61)
    let v: u64 = a + kn + 1
    let hexed: bool = is_hex_key(a, kn)
    if hexed && actwire.ld8(v, 0) == 45 && actwire.ld8(v, 1) == 0 {
        let n: u64 = read_secret()
        vaultcall.hex_body((&line[0 as usize]) as u64, n)
    } else {
        if hexed {
            vaultcall.hex_body(v, actwire.slen(v))
        } else {
            actwire.ob_str(v)
        }
    }
    actwire.ob_ch(10)
}

fn call() -> u64 {
    let r: u64 = vaultcall.round_trip()
    if r == vaultcall.R_NOBUS {
        return R_NOBUS
    }
    actwire.out(vaultcall.reply())
    if r == vaultcall.R_OK {
        return R_OK
    }
    return R_FAIL
}

fn u_start(args: u64) -> u64 {
    if ulib.arg_count(args) < 2 {
        var usage: [u8; 64] = "usage: vaultctl <op> [key=value ...]  (secrets: key=- = stdin)\n\0"
        actwire.eout((&usage[0 as usize]) as u64)
        return 2
    }
    actwire.ob_reset()
    var k_op: [u8; 4] = "op=\0"
    actwire.ob_str((&k_op[0 as usize]) as u64)
    actwire.ob_str(ulib.arg_at(args, 1))
    actwire.ob_ch(10)
    var i: u64 = 2
    while i < ulib.arg_count(args) {
        add_arg(ulib.arg_at(args, i))
        i = i + 1
    }
    return call()
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
