// SPDX-License-Identifier: GPL-2.0-only
//
// socapp -- the example app of the social SDK (kernel/user/socsdk.fi).
//
//   socapp play <name> [party]    say what I play; with a party friends may join
//   socapp stop
//   socapp invite <friend> [name]
//   socapp join <friend>
//   socapp take [name]            print the join target that came back

profile kernel

import ulib
import socsdk

export { u_start }

fn report(done: bool) -> u64 {
    var s_ok: [u8; 3] = "ok\0"
    var s_fail: [u8; 5] = "fail\0"
    if done {
        ulib.say((&s_ok[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    ulib.say((&s_fail[0 as usize]) as u64)
    ulib.nl()
    return 1
}

fn opt_arg(args: u64, argc: u64, k: u64) -> u64 {
    if k < argc {
        return ulib.arg_at(args, k)
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var c_play: [u8; 5] = "play\0"
    var c_stop: [u8; 5] = "stop\0"
    var c_invite: [u8; 7] = "invite\0"
    var c_join: [u8; 5] = "join\0"
    var c_take: [u8; 5] = "take\0"
    var s_target: [u8; 8] = "target=\0"
    var s_none: [u8; 5] = "none\0"
    var out: [u8; 132] = [0 as u8; 132]
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        return 2
    }
    let cmd: u64 = ulib.arg_at(args, 1)
    let a2: u64 = opt_arg(args, argc, 2)
    let a3: u64 = opt_arg(args, argc, 3)
    if ulib.streq(cmd, (&c_play[0 as usize]) as u64) && a2 != 0 {
        return report(socsdk.set_activity(a2, a3 != 0, a3))
    }
    if ulib.streq(cmd, (&c_stop[0 as usize]) as u64) {
        return report(socsdk.clear_activity())
    }
    if ulib.streq(cmd, (&c_invite[0 as usize]) as u64) && a2 != 0 {
        return report(socsdk.invite(a2, a3))
    }
    if ulib.streq(cmd, (&c_join[0 as usize]) as u64) && a2 != 0 {
        return report(socsdk.ask_to_join(a2))
    }
    if ulib.streq(cmd, (&c_take[0 as usize]) as u64) {
        if socsdk.take_join(a2, (&out[0 as usize]) as u64, 130) {
            ulib.say((&s_target[0 as usize]) as u64)
            ulib.say((&out[0 as usize]) as u64)
        } else {
            ulib.say((&s_target[0 as usize]) as u64)
            ulib.say((&s_none[0 as usize]) as u64)
        }
        ulib.nl()
        return 0
    }
    return 2
}
