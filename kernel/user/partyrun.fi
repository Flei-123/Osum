profile kernel

import ulib
import partylaunch

export { u_start }

static mut c_once: [u8; 5] = "once\0"
static mut c_watch: [u8; 6] = "watch\0"
static mut s_started: [u8; 9] = "started=\0"

const DEFAULT_SECONDS: u64 = 300

fn report(n: u64) -> u64 {
    ulib.say((&s_started[0 as usize]) as u64)
    ulib.sayn(n)
    ulib.nl()
    return 0
}

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        return 2
    }
    let cmd: u64 = ulib.arg_at(args, 1)
    if ulib.streq(cmd, (&c_once[0 as usize]) as u64) {
        return report(partylaunch.launch_ready())
    }
    if ulib.streq(cmd, (&c_watch[0 as usize]) as u64) {
        var seconds: u64 = DEFAULT_SECONDS
        if argc > 2 {
            seconds = ulib.to_num(ulib.arg_at(args, 2))
        }
        return report(partylaunch.watch(seconds))
    }
    return 2
}
