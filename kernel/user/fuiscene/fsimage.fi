import fuied
import fui.scene
import fui.widget
import fuiscene.fsbase
import fuiscene.fscore
import fuiscene.fsctl
import fuiscene.fsdraw

const IM_MAX: u64 = 16

fn image(parent: usize, key: u64, w: u64, h: u64) -> usize {
    let i: usize = scene.scene_add(fscore.sc(), parent, scene.N_WIDGET)
    if i == scene.SCENE_NONE {
        return fsbase.NONE
    }
    scene.node_set_widget_kind(fscore.sc(), i, widget.KIND_LABEL)
    scene.node_set_size(fscore.sc(), i, w as f64, h as f64)
    scene.node_set_draw(fscore.sc(), i, 0, fsdraw.draw_im)
    scene.node_set_id(fscore.sc(), i, key as u32)
    var k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT && fsbase.S.s_im_n < IM_MAX {
        k = fsbase.S.s_im_n
        fsbase.S.s_im_n = fsbase.S.s_im_n + 1
        fsbase.S.s_im_key[(k) as usize] = key
    }
    if k != fsbase.NO_SLOT {
        fsbase.S.s_im_node[(k) as usize] = i
        fsbase.S.s_im_bw[(k) as usize] = w
        fsbase.S.s_im_bh[(k) as usize] = h
    }
    return i
}

fn image_set(key: u64, px: u64, iw: u64, ih: u64) {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return
    }
    fsbase.S.s_im_px[(k) as usize] = px
    fsbase.S.s_im_w[(k) as usize] = iw
    fsbase.S.s_im_h[(k) as usize] = ih
    fsbase.S.s_im_ox[(k) as usize] = 0
    fsbase.S.s_im_oy[(k) as usize] = 0
    fscore.touch()
}

fn image_has(key: u64) -> bool {
    let k: u64 = fsctl.im_slot(key)
    return k != fsbase.NO_SLOT && fsbase.S.s_im_px[(k) as usize] != 0
}

fn image_fit(key: u64) {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return
    }
    let bw: u64 = fsctl.im_turned_w(k)
    let bh: u64 = fsctl.im_turned_h(k)
    if bw == 0 || bh == 0 {
        return
    }
    var z: u64 = fsbase.S.s_im_bw[(k) as usize] * 100 / bw
    let zy: u64 = fsbase.S.s_im_bh[(k) as usize] * 100 / bh
    if zy < z {
        z = zy
    }
    if z > 100 {
        z = 100
    }
    if z < 5 {
        z = 5
    }
    fsbase.S.s_im_zoom[(k) as usize] = z
    fsbase.S.s_im_ox[(k) as usize] = 0
    fsbase.S.s_im_oy[(k) as usize] = 0
    fscore.touch()
}

fn image_zoom(key: u64) -> u64 {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return 100
    }
    return fsbase.S.s_im_zoom[(k) as usize]
}

fn image_set_zoom(key: u64, z: u64) {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return
    }
    var v: u64 = z
    if v < 5 {
        v = 5
    }
    if v > 3200 {
        v = 3200
    }
    fsbase.S.s_im_zoom[(k) as usize] = v
    fscore.touch()
}

fn image_pan(key: u64, dx: i64, dy: i64) {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return
    }
    let zw: i64 = (fsctl.im_turned_w(k) * fsbase.S.s_im_zoom[(k) as usize] / 100) as i64
    let zh: i64 = (fsctl.im_turned_h(k) * fsbase.S.s_im_zoom[(k) as usize] / 100) as i64
    var mx: i64 = 0
    var my: i64 = 0
    if zw > (fsbase.S.s_im_bw[(k) as usize] as i64) {
        mx = (zw - (fsbase.S.s_im_bw[(k) as usize] as i64)) / 2
    }
    if zh > (fsbase.S.s_im_bh[(k) as usize] as i64) {
        my = (zh - (fsbase.S.s_im_bh[(k) as usize] as i64)) / 2
    }
    var nx: i64 = fsbase.S.s_im_ox[(k) as usize] + dx
    var ny: i64 = fsbase.S.s_im_oy[(k) as usize] + dy
    if nx > mx {
        nx = mx
    }
    if nx < 0 - mx {
        nx = 0 - mx
    }
    if ny > my {
        ny = my
    }
    if ny < 0 - my {
        ny = 0 - my
    }
    fsbase.S.s_im_ox[(k) as usize] = nx
    fsbase.S.s_im_oy[(k) as usize] = ny
    fscore.touch()
}

fn image_rotate(key: u64, q: u64) {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return
    }
    fsbase.S.s_im_turn[(k) as usize] = (fsbase.S.s_im_turn[(k) as usize] + q) & 3
    fscore.touch()
}

fn image_click(key: u64, on: bool) {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return
    }
    fsbase.S.s_im_clk[(k) as usize] = on
}

fn image_tool(key: u64, on: bool) {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return
    }
    fsbase.S.s_im_tool[(k) as usize] = on
}

fn image_sel_present(key: u64) -> bool {
    let k: u64 = fsctl.im_slot(key)
    return k != fsbase.NO_SLOT && fsbase.S.s_im_sp[(k) as usize]
}

fn image_sel_x0(key: u64) -> u64 {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return 0
    }
    return fsbase.S.s_im_a0[(k) as usize]
}

fn image_sel_y0(key: u64) -> u64 {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return 0
    }
    return fsbase.S.s_im_b0[(k) as usize]
}

fn image_sel_x1(key: u64) -> u64 {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return 0
    }
    return fsbase.S.s_im_a1[(k) as usize]
}

fn image_sel_y1(key: u64) -> u64 {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return 0
    }
    return fsbase.S.s_im_b1[(k) as usize]
}

fn image_sel_clear(key: u64) {
    let k: u64 = fsctl.im_slot(key)
    if k == fsbase.NO_SLOT {
        return
    }
    fsbase.S.s_im_sp[(k) as usize] = false
    fscore.touch()
}

fn editor_t(key: u64) -> u64 {
    let k: u64 = fsctl.ed_slot(key)
    if k == fsbase.NO_SLOT {
        return fuied.TA_MAX
    }
    return fsbase.S.s_ed_t[(k) as usize]
}

fn editor(parent: usize, key: u64, w: u64, h: u64) -> usize {
    let i: usize = scene.scene_add(fscore.sc(), parent, scene.N_WIDGET)
    if i == scene.SCENE_NONE {
        return fsbase.NONE
    }
    scene.node_set_widget_kind(fscore.sc(), i, widget.KIND_LIST)
    scene.node_set_size(fscore.sc(), i, w as f64, h as f64)
    scene.node_set_draw(fscore.sc(), i, 0, fsdraw.draw_ed)
    scene.node_set_id(fscore.sc(), i, key as u32)
    var k: u64 = fsctl.ed_slot(key)
    if k == fsbase.NO_SLOT && fsbase.S.s_ed_n < 2 {
        let t: u64 = fuied.ed_new()
        if t < fuied.TA_MAX {
            k = fsbase.S.s_ed_n
            fsbase.S.s_ed_n = fsbase.S.s_ed_n + 1
            fsbase.S.s_ed_key[(k) as usize] = key
            fsbase.S.s_ed_t[(k) as usize] = t
        }
    }
    if k != fsbase.NO_SLOT {
        fsbase.S.s_ed_node[(k) as usize] = i
    }
    return i
}

fn editor_prep(key: u64) -> u64 {
    var k: u64 = fsctl.ed_slot(key)
    if k == fsbase.NO_SLOT && fsbase.S.s_ed_n < 2 {
        let t: u64 = fuied.ed_new()
        if t < fuied.TA_MAX {
            k = fsbase.S.s_ed_n
            fsbase.S.s_ed_n = fsbase.S.s_ed_n + 1
            fsbase.S.s_ed_key[(k) as usize] = key
            fsbase.S.s_ed_t[(k) as usize] = t
        }
    }
    if k == fsbase.NO_SLOT {
        return fuied.TA_MAX
    }
    return fsbase.S.s_ed_t[(k) as usize]
}

fn ghost_button(parent: usize, text: u64, key: u64, w: u64, h: u64) -> usize {
    let i: usize = fsdraw.button(parent, text, key)
    if i != fsbase.NONE {
        scene.node_set_size(fscore.sc(), i, fscore.dpf(w as f64), fscore.dpf(h as f64))
        scene.node_set_draw(fscore.sc(), i, 0, fsdraw.draw_ghost)
    }
    return i
}

fn ghost_space(parent: usize, w: u64, h: u64) -> usize {
    let i: usize = scene.scene_add(fscore.sc(), parent, scene.N_BOX)
    if i != scene.SCENE_NONE {
        scene.node_set_size(fscore.sc(), i, fscore.dpf(w as f64), fscore.dpf(h as f64))
    }
    return i
}

fn foreign_main() -> bool {
    if !fsctl.begin() {
        return false
    }
    fsbase.S.s_quit = 1
    return true
}
