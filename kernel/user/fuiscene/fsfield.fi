import fui.render
import fui.scene
import fui.flex
import fui.painter
import fui.theme
import fui.widget
import fuiapp
import fuiscene.fscore

const FIELD_ALPHA: u32 = 4278190080

fn draw_field(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    if fscore.off_canvas(e) {
        return
    }
    let t: *mut theme.Colors = theme.theme_colors(fuiapp.theme())
    painter.round_rect(render.ctx_painter(c), widget.w_x(e) as f64, widget.w_y(e) as f64,
        widget.w_w(e) as f64, widget.w_h(e) as f64, fscore.rf(), (*t).field | FIELD_ALPHA)
}

fn field_row(parent: usize) -> usize {
    let i: usize = fscore.row(parent)
    if i != scene.SCENE_NONE {
        scene.node_set_draw(fscore.sc(), i, 0, draw_field)
        scene.node_set_padding(fscore.sc(), i, 4, 0, 4, 0)
        scene.node_set_gap(fscore.sc(), i, 0, 0)
    }
    return i
}
