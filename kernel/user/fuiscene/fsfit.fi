import fuiapp
import fuiapp.apphost
import wlibc
import fuiscene.fsbase
import fuiscene.fscore
import fuiscene.fsrun

fn work_overflow() -> u64 {
    let win: u64 = fuiapp.win()
    let hd: u64 = apphost.handle(win)
    if hd == 0 {
        return 0
    }
    let bottom: u64 = apphost.win_y(win) + wlibc.win_info(hd, wlibc.WI_INY) + apphost.win_h(win)
    let limit: u64 = wlibc.work_y(hd) + wlibc.work_h(hd)
    if bottom <= limit {
        return 0
    }
    return ((bottom - limit) * 1000 + fsbase.S.s_Sm - 1) / fsbase.S.s_Sm
}

fn win_shrink(dp: u64) -> bool {
    let win: u64 = fuiapp.win()
    let cut: u64 = fscore.sp(dp)
    if cut >= apphost.win_h(win) {
        return false
    }
    return fsrun.win_size(apphost.win_w(win), apphost.win_h(win) - cut)
}
