        scene.node_set_id(fscore.sc(), i, key as u32)
    }
}

fn set_gap(i: usize, g: u64) {
    scene.node_set_gap(fscore.sc(), i, g as i64, g as i64)
}

fn set_pad(i: usize, p: u64) {
    scene.node_set_padding(fscore.sc(), i, p as i64, p as i64, p as i64, p as i64)
}

fn set_grow(i: usize, g: u64) {
    scene.node_set_grow(fscore.sc(), i, (g * 1000) as i64, 1000)
    scene.node_set_base(fscore.sc(), i, 0)
