        scene.node_set_grow(fscore.sc(), i, 0, 0)
    }
}

fn set_align_end(i: usize) {
    scene.node_set_align_self(fscore.sc(), i, flex.AL_END)
}

fn blob_lines(blob: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while __mmio_read8((blob + i) as *mut u8) != 0 as u8 {
        if __mmio_read8((blob + i) as *mut u8) == 10 as u8 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn blob_rows(blob: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while __mmio_read8((blob + i) as *mut u8) != 0 as u8 {
        if __mmio_read8((blob + i) as *mut u8) == 10 as u8 {
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 {
        return 0
    }
    return n - 1
}

fn blob_cell(blob: u64, line: u64, col: u64) -> u64 {
    var at: u64 = 0
    var l: u64 = 0
    while l < line {
        while __mmio_read8((blob + at) as *mut u8) != 10 as u8 {
            if __mmio_read8((blob + at) as *mut u8) == 0 as u8 {
                break
            }
            at = at + 1
        }
        at = at + 1
        l = l + 1
    }
    var c: u64 = 0
    while c < col {
        while __mmio_read8((blob + at) as *mut u8) != 9 as u8 {
            let ch: u8 = __mmio_read8((blob + at) as *mut u8)
            if ch == 10 as u8 || ch == 0 as u8 {
                break
            }
            at = at + 1
        }
        if __mmio_read8((blob + at) as *mut u8) == 9 as u8 {
            at = at + 1
        }
        c = c + 1
    }
    let b: u64 = (&fsbase.S.s_cellbuf[0 as usize]) as u64
    var n: u64 = 0
    while n < 198 {
        let ch2: u8 = __mmio_read8((blob + at + n) as *mut u8)
        if ch2 == 9 as u8 || ch2 == 10 as u8 || ch2 == 0 as u8 {
            break
        }
        __mmio_write8((b + n) as *mut u8, ch2)
        n = n + 1
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    return b
}

const VAL_MAX: u64 = 24

fn val_slot(key: u64) -> u64 {
    var k: u64 = 0
    while k < fsbase.S.s_vn {
        if fsbase.S.s_vkey[(k) as usize] == key {
            return k
        }
        k = k + 1
    }
    return fsbase.NO_SLOT
}

fn value_of(key: u64) -> i64 {
    let k: u64 = val_slot(key)
    if k == fsbase.NO_SLOT {
        return 0
    }
    return fsbase.S.s_vval[(k) as usize]
}

fn set_value(key: u64, v: i64) {
    let k: u64 = val_slot(key)
    if k == fsbase.NO_SLOT {
        return
    }
    fsbase.S.s_vval[(k) as usize] = v

    let n: usize = fsbase.S.s_vnode[(k) as usize]
    if n != fsbase.NONE && n < scene.scene_count(fscore.sc()) {
        let e: *mut widget.Widget = scene.node_widget(fscore.sc(), n)
        widget.w_set_value(e, v)
        widget.w_set_selected(e, v != 0)
    }
    fscore.refresh()
}

fn val_node(i: usize, key: u64, init: i64) {
    var k: u64 = val_slot(key)
    if k == fsbase.NO_SLOT && fsbase.S.s_vn < VAL_MAX {
        k = fsbase.S.s_vn
        fsbase.S.s_vn = fsbase.S.s_vn + 1
        fsbase.S.s_vkey[(k) as usize] = key
        fsbase.S.s_vval[(k) as usize] = init
    }
    if k == fsbase.NO_SLOT {
        return
    }
    fsbase.S.s_vnode[(k) as usize] = i
    let e: *mut widget.Widget = scene.node_widget(fscore.sc(), i)
    widget.w_set_value(e, fsbase.S.s_vval[(k) as usize])
    widget.w_set_selected(e, fsbase.S.s_vval[(k) as usize] != 0)
}

fn check(parent: usize, text: u64, key: u64, on: bool) -> usize {
    let i: usize = scene.scene_add(fscore.sc(), parent, scene.N_WIDGET)
    if i == scene.SCENE_NONE {
        return fsbase.NONE
    }
    scene.node_set_widget_kind(fscore.sc(), i, widget.KIND_CHECKBOX)
    scene.node_set_text(fscore.sc(), i, text, text.length(text) as usize)
    scene.node_set_id(fscore.sc(), i, key as u32)
    var init: i64 = 0
    if on {
        init = 1
    }
    val_node(i, key, init)
    return i
}

fn set_toggle_room(w: u64) {
    fsbase.tg_room = w
}

fn slider(parent: usize, key: u64, w: u64, init: i64) -> usize {
    let i: usize = scene.scene_add(fscore.sc(), parent, scene.N_WIDGET)
    if i == scene.SCENE_NONE {
        return fsbase.NONE
    }
    scene.node_set_widget_kind(fscore.sc(), i, widget.KIND_SLIDER)

    scene.node_set_size(fscore.sc(), i, w as f64, 20.0)
    scene.node_set_id(fscore.sc(), i, key as u32)
    val_node(i, key, init)
    return i
}

const RO_MAX: u64 = 8

static mut ro_key: [u64; 8] = [0 as u64; 8]

static mut ro_lo: [u64; 8] = [0 as u64; 8]

static mut ro_hi: [u64; 8] = [0 as u64; 8]

static mut ro_pct: [u64; 8] = [0 as u64; 8]

static mut ro_n: u64 = 0

static mut ro_buf: [u8; 24] = [0 as u8; 24]

fn slider_readout(key: u64, lo: u64, hi: u64, pct: bool) {
    var k: u64 = 0
    while k < ro_n && ro_key[(k) as usize] != key {
        k = k + 1
    }
    if k == ro_n {
        if ro_n >= RO_MAX {
            return
        }
        ro_n = ro_n + 1
    }
    ro_key[(k) as usize] = key
    ro_lo[(k) as usize] = lo
    ro_hi[(k) as usize] = hi
    var f: u64 = 0
    if pct {
        f = 1
    }
    ro_pct[(k) as usize] = f
}

fn readout_fmt(k: u64) -> u64 {
    let key: u64 = ro_key[(k) as usize]
    let lo: u64 = ro_lo[(k) as usize]
    let hi: u64 = ro_hi[(k) as usize]
    let raw: i64 = value_of(key)
    var v: u64 = 0
    if raw > 0 {
        v = raw as u64
    }
    let num: u64 = lo + (v * (hi - lo) + 500) / 1000
    var n: u64 = fscore.tr_num((&ro_buf[0 as usize]) as u64, 0, num)
    if ro_pct[(k) as usize] != 0 {
        ro_buf[(n) as usize] = 32 as u8
        ro_buf[(n + 1) as usize] = 37 as u8
        n = n + 2
    }
    ro_buf[(n) as usize] = 0 as u8
    return (&ro_buf[0 as usize]) as u64
}

fn readout_text(key: u64) -> u64 {
    var k: u64 = 0
    while k < ro_n {
        if ro_key[(k) as usize] == key {
            return readout_fmt(k)
        }
        k = k + 1
    }
    return 0
}

fn readouts() {
    var k: u64 = 0
    while k < ro_n {
        let i: usize = fscore.node_of_key(ro_key[(k) as usize])
        if i != scene.SCENE_NONE && i < scene.scene_count(fscore.sc()) && fscore.node_w(i) > 0 {
            let p: u64 = readout_fmt(k)
            let px: u64 = fscore.ui_px()
            let tw: u64 = wlibc.text_w(wlibc.F_UI, px, p, text.length(p))
            let lh: u64 = wlibc.text_h(px) + 2
            let x: u64 = fscore.node_x(i) + fscore.node_w(i) + fscore.sp(12)

            var ty: u64 = fscore.node_y(i)
            if fscore.node_h(i) > fscore.sp(24) {
                ty = ty + (fscore.node_h(i) - fscore.sp(24)) / 2
            } else if ty >= (fscore.sp(24) - fscore.node_h(i)) / 2 {
                ty = ty - (fscore.sp(24) - fscore.node_h(i)) / 2
            }
            var py: u64 = ty
            if fscore.sp(24) > lh {
                py = ty + (fscore.sp(24) - lh) / 2
            }
            fuiapp.plate_ink(x, py, tw, lh)
            fscore.text_tok(x, ty, tw + fscore.sp(8), p, style.TOK_TEXT_MUTED)
        }
        k = k + 1
    }
}

fn choice(parent: usize, text: u64, key: u64) -> usize {
    let i: usize = scene.scene_add(fscore.sc(), parent, scene.N_WIDGET)
    if i == scene.SCENE_NONE {
        return fsbase.NONE
    }
    scene.node_set_widget_kind(fscore.sc(), i, widget.KIND_DROPDOWN)
    scene.node_set_text(fscore.sc(), i, text, text.length(text) as usize)
    scene.node_set_id(fscore.sc(), i, key as u32)
    return i
}

fn val_sync() -> u64 {
    var hit: u64 = 0
    var k: u64 = 0
    while k < fsbase.S.s_vn {
        let i: usize = fsbase.S.s_vnode[(k) as usize]
        if i != fsbase.NONE && i < scene.scene_count(fscore.sc()) {
            let v: i64 = widget.w_value(scene.node_widget(fscore.sc(), i))
            if v != fsbase.S.s_vval[(k) as usize] {
                fsbase.S.s_vval[(k) as usize] = v
                hit = fsbase.S.s_vkey[(k) as usize]
            }
        }
        k = k + 1
    }
    return hit
}

