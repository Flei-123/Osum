    fsbase.card_px = px
}

const PANE_SLOTS: u64 = 2

const PANE_BYTES: u64 = 1024

const PANE_BAR: usize = 8

static mut pane_mem: [u8; 2048] = [0 as u8; 2048]

static mut pane_ready: [bool; 2] = [false; 2]

static mut pane_lastf: [usize; 2] = [4294967295, 4294967295]

static mut pane_hgt: [u64; 2] = [0, 0]

fn pane_vp(slot: u64) -> *mut viewport.Viewport {
    return (((&pane_mem[0 as usize]) as u64) + slot * PANE_BYTES) as *mut viewport.Viewport
}

fn pane_sync(ud: u64, c: *mut render.Ctx, e: *mut widget.Widget) {
    let v: *mut viewport.Viewport = pane_vp(ud)
    var cw: f64 = viewport.viewport_w(v) - (PANE_BAR as f64)
    if cw < 1.0 {
        cw = 1.0
    }
    let ch: f64 = widget.w_h(e)
    if viewport.viewport_content_w(v) != cw || viewport.viewport_content_h(v) != ch {
        viewport.viewport_set_content(v, cw, ch)
        fscore.touch()
    }
}

fn pane_open(parent: usize, slot: u64, w: u64, h: u64) -> usize {
    if slot >= PANE_SLOTS {
        return fsbase.NONE
    }
    if !pane_ready[(slot) as usize] {
        *pane_vp(slot) = viewport.viewport_new(0.0, 0.0, 100.0, 100.0, 100.0, 100.0)
        pane_ready[(slot) as usize] = true
    }
    viewport.viewport_set_bar(pane_vp(slot), PANE_BAR)
    pane_hgt[(slot) as usize] = h
    let vn: usize = scene.scene_add(fscore.sc(), parent, scene.N_VIEWPORT)
    if vn == scene.SCENE_NONE {
        return fsbase.NONE
    }
    scene.node_set_viewport(fscore.sc(), vn, pane_vp(slot))
    if h > 0 {
        scene.node_set_size(fscore.sc(), vn, w as f64, h as f64)
        scene.node_set_grow(fscore.sc(), vn, 0, 0)
    } else {
        scene.node_set_grow(fscore.sc(), vn, 1000, 1000)
        scene.node_set_base(fscore.sc(), vn, 0)
    }
    let cn: usize = scene.scene_box(fscore.sc(), vn, 0 as u32, flex.FLEX_COLUMN,
        flex.JUSTIFY_START, flex.AL_STRETCH)
    if cn != scene.SCENE_NONE {
        scene.node_set_grow(fscore.sc(), cn, 0, 0)
        scene.node_set_draw(fscore.sc(), cn, slot, pane_sync)
        fsbase.pane_cn[(slot) as usize] = cn
    }
    return cn
}

fn pane_reveal(f: usize) {
    if f == fuiwirt.KEINER || f >= scene.scene_count(fscore.sc()) {
        return
    }
    var slot: u64 = 0
    while slot < PANE_SLOTS {
        let cn: usize = fsbase.pane_cn[(slot) as usize]
        if cn != fsbase.NONE && pane_ready[(slot) as usize] && pane_lastf[(slot) as usize] != f {
            var p: usize = f
            var inside: bool = false
            var guard: u64 = 0
            while p != fsbase.NONE && p < scene.scene_count(fscore.sc()) && guard < 64 {
                if p == cn {
                    inside = true
                    break
                }
                p = scene.scene_parent(fscore.sc(), p)
                guard = guard + 1
            }
            if inside {
                pane_lastf[(slot) as usize] = f
                let ry: f64 = scene.node_y(fscore.sc(), f) - scene.node_y(fscore.sc(), cn)
                if viewport.viewport_ensure_visible(pane_vp(slot), 0.0, ry, 1.0, scene.node_h(fscore.sc(), f)) {
                    fscore.touch()
                }
            }
        }
        slot = slot + 1
    }
}

fn pane_hides(slot: u64, i: usize) -> bool {
    if slot >= PANE_SLOTS || !pane_ready[(slot) as usize] || pane_hgt[(slot) as usize] == 0 {
        return false
    }
    let cn: usize = fsbase.pane_cn[(slot) as usize]
    if cn == fsbase.NONE || i >= scene.scene_count(fscore.sc()) {
        return false
    }
    let ry: f64 = scene.node_y(fscore.sc(), i) - scene.node_y(fscore.sc(), cn) - viewport.viewport_off_y(pane_vp(slot))
    return ry < -0.5 || ry + scene.node_h(fscore.sc(), i) > fscore.spf(pane_hgt[(slot) as usize] as f64) + 0.5
}

fn pane_show(slot: u64, i: usize) -> bool {
    if slot >= PANE_SLOTS || !pane_ready[(slot) as usize] || pane_hgt[(slot) as usize] == 0 {
        return false
    }
    let cn: usize = fsbase.pane_cn[(slot) as usize]
    if cn == fsbase.NONE || i >= scene.scene_count(fscore.sc()) {
        return false
    }
    let ry: f64 = scene.node_y(fscore.sc(), i) - scene.node_y(fscore.sc(), cn)
    if viewport.viewport_ensure_visible(pane_vp(slot), 0.0, ry, 1.0, scene.node_h(fscore.sc(), i)) {
        fscore.touch()
        return true
    }
    return false
}

fn pane_top(slot: u64) {
    if slot < PANE_SLOTS && pane_ready[(slot) as usize] {
        viewport.viewport_set_offset(pane_vp(slot), 0.0, 0.0)
    }
}

fn pane_offset(slot: u64) -> u64 {
    if slot < PANE_SLOTS && pane_ready[(slot) as usize] {
        return viewport.viewport_off_y(pane_vp(slot)) as u64
    }
    return 0
}

fn pane_content(slot: u64) -> u64 {
    if slot < PANE_SLOTS && pane_ready[(slot) as usize] {
        return viewport.viewport_content_h(pane_vp(slot)) as u64
    }
    return 0
}

fn pane_view(slot: u64) -> u64 {
    if slot < PANE_SLOTS && pane_ready[(slot) as usize] {
        return viewport.viewport_h(pane_vp(slot)) as u64
    }
    return 0
}

fn set_nohit(on: bool) {
    fsbase.S.s_nohit = on
}

fn im_slot(key: u64) -> u64 {
    var k: u64 = 0
    while k < fsbase.S.s_im_n {
        if fsbase.S.s_im_key[(k) as usize] == key {
            return k
        }
        k = k + 1
    }
    return fsbase.NO_SLOT
}

fn im_slot_of_node(i: usize) -> u64 {
    var k: u64 = 0
    while k < fsbase.S.s_im_n {
        if fsbase.S.s_im_node[(k) as usize] == i {
            return k
        }
        k = k + 1
    }
    return fsbase.NO_SLOT
}

fn im_turned_w(k: u64) -> u64 {
    if fsbase.S.s_im_turn[(k) as usize] & 1 == 1 {
        return fsbase.S.s_im_h[(k) as usize]
    }
    return fsbase.S.s_im_w[(k) as usize]
}

fn im_turned_h(k: u64) -> u64 {
    if fsbase.S.s_im_turn[(k) as usize] & 1 == 1 {
        return fsbase.S.s_im_w[(k) as usize]
    }
    return fsbase.S.s_im_h[(k) as usize]
}

fn im_at(x: u64, y: u64) -> u64 {
    var k: u64 = 0
    while k < fsbase.S.s_im_n {
        let i: usize = fsbase.S.s_im_node[(k) as usize]
        if i != fsbase.NONE && i < scene.scene_count(fscore.sc()) && x >= fscore.node_x(i)
            && x < fscore.node_x(i) + fscore.node_w(i) && y >= fscore.node_y(i)
            && y < fscore.node_y(i) + fscore.node_h(i) {
            return k
        }
        k = k + 1
    }
    return fsbase.NO_SLOT
}

fn im_pixel(k: u64, x: u64, y: u64, ix: *mut u64, iy: *mut u64) {
    let i: usize = fsbase.S.s_im_node[(k) as usize]
    let zm: u64 = fsbase.S.s_im_zoom[(k) as usize]
    let zw: u64 = im_turned_w(k) * zm / 100
    let zh: u64 = im_turned_h(k) * zm / 100
    let ox: i64 = (fscore.node_x(i) as i64) + ((fscore.node_w(i) as i64) - (zw as i64)) / 2 + fsbase.S.s_im_ox[(k) as usize]
    let oy: i64 = (fscore.node_y(i) as i64) + ((fscore.node_h(i) as i64) - (zh as i64)) / 2 + fsbase.S.s_im_oy[(k) as usize]
    var px: i64 = ((x as i64) - ox) * 100 / (zm as i64)
    var py: i64 = ((y as i64) - oy) * 100 / (zm as i64)
    if px < 0 {
        px = 0
    }
    if py < 0 {
        py = 0
    }
    if px >= (fsbase.S.s_im_w[(k) as usize] as i64) {
        px = (fsbase.S.s_im_w[(k) as usize] as i64) - 1
    }
    if py >= (fsbase.S.s_im_h[(k) as usize] as i64) {
        py = (fsbase.S.s_im_h[(k) as usize] as i64) - 1
    }
    *ix = px as u64
    *iy = py as u64
}

fn im_sel_update(k: u64, x: u64, y: u64) {
    var cx: u64 = 0
    var cy: u64 = 0
    im_pixel(k, x, y, &cx, &cy)
    var a0: u64 = fsbase.S.s_im_ax
    var a1: u64 = cx
    if cx < a0 {
        a0 = cx
        a1 = fsbase.S.s_im_ax
    }
    var b0: u64 = fsbase.S.s_im_ay
    var b1: u64 = cy
    if cy < b0 {
        b0 = cy
        b1 = fsbase.S.s_im_ay
    }
    fsbase.S.s_im_a0[(k) as usize] = a0
    fsbase.S.s_im_a1[(k) as usize] = a1
    fsbase.S.s_im_b0[(k) as usize] = b0
    fsbase.S.s_im_b1[(k) as usize] = b1
    fsbase.S.s_im_sp[(k) as usize] = true
    fscore.touch()
}

fn im_press(x: u64, y: u64) -> u64 {
    let k: u64 = im_at(x, y)
    if k == fsbase.NO_SLOT {
        return 0
    }
    if fsbase.S.s_im_tool[(k) as usize] && fsbase.S.s_im_px[(k) as usize] != 0
        && (fsbase.S.s_im_turn[(k) as usize] & 3) == 0 {
        var ax: u64 = 0
        var ay: u64 = 0
        im_pixel(k, x, y, &ax, &ay)
        fsbase.S.s_im_ax = ax
        fsbase.S.s_im_ay = ay
        fsbase.S.s_im_selk = k
        fsbase.S.s_im_sp[(k) as usize] = false
        im_sel_update(k, x, y)
        return 0
    }
    fsbase.S.s_im_drag = k
    fsbase.S.s_im_sx = x
    fsbase.S.s_im_sy = y
    fsbase.S.s_im_sox = fsbase.S.s_im_ox[(k) as usize]
    fsbase.S.s_im_soy = fsbase.S.s_im_oy[(k) as usize]
    if fsbase.S.s_im_clk[(k) as usize] {
        return fsbase.S.s_im_key[(k) as usize]
    }
    return 0
}

fn im_move(x: u64, y: u64) {
    if fsbase.S.s_im_selk != fsbase.NO_SLOT {
        im_sel_update(fsbase.S.s_im_selk, x, y)
        return
    }
    if fsbase.S.s_im_drag == fsbase.NO_SLOT {
        return
    }
    let k: u64 = fsbase.S.s_im_drag
    fsbase.S.s_im_ox[(k) as usize] = fsbase.S.s_im_sox + (x as i64) - (fsbase.S.s_im_sx as i64)
    fsbase.S.s_im_oy[(k) as usize] = fsbase.S.s_im_soy + (y as i64) - (fsbase.S.s_im_sy as i64)
    fscore.touch()
}

fn ed_slot(key: u64) -> u64 {
    var k: u64 = 0
    while k < fsbase.S.s_ed_n {
        if fsbase.S.s_ed_key[(k) as usize] == key {
            return k
        }
        k = k + 1
    }
    return fsbase.NO_SLOT
}

fn ed_slot_of_node(i: usize) -> u64 {
    var k: u64 = 0
    while k < fsbase.S.s_ed_n {
        if fsbase.S.s_ed_node[(k) as usize] == i {
            return k
        }
        k = k + 1
    }
    return fsbase.NO_SLOT
}

fn ed_at(x: u64, y: u64) -> u64 {
    var k: u64 = 0
    while k < fsbase.S.s_ed_n {
        let i: usize = fsbase.S.s_ed_node[(k) as usize]
        if i != fsbase.NONE && x >= fscore.node_x(i) && x < fscore.node_x(i) + fscore.node_w(i)
            && y >= fscore.node_y(i) && y < fscore.node_y(i) + fscore.node_h(i) {
            return k
        }
        k = k + 1
    }
    return fsbase.NO_SLOT
}

fn DLG_W() -> u64 {
    return fscore.sp(320)
}

fn DLG_H() -> u64 {
    return fscore.sp(148)
}

const PCT_NONE: u64 = 255

const PCT_INDET: u64 = 254

const DLG_FRAME_MS: u64 = 33

const DLG_SPIN_DOTS: u64 = 12

const DLG_SPIN_STEP_MS: u64 = 90

static mut g_dlg_spin: bool = false

static mut g_dlg_cancel_label: u64 = 0

static mut g_dlg_cancel_ask: bool = false

static mut g_dlg_frame_t: u64 = 0

fn dialog_is_open() -> bool {
    return fsbase.S.s_dlg_open
}

fn dlg_reset(kind: u64) {
    fsbase.S.s_dlg_open = true
    fsbase.S.s_dlg_kind = kind
    fsbase.S.s_dlg_res = 0
    fsbase.S.s_dlg_hot = 0
    fsbase.S.s_dlg_pct = 255
    fsbase.S.s_dlg_esc = false
    fsbase.S.s_dlg_secret = false
    fsbase.S.s_dlg_n = 2
    g_dlg_spin = false
    g_dlg_cancel_label = 0
    g_dlg_cancel_ask = false
}

fn dialog_open(title: u64, text: u64, b1: u64, b2: u64) {
    dlg_reset(0)
    fsbase.S.s_dlg_title = title
    fsbase.S.s_dlg_text = text
    fsbase.S.s_dlg_b1 = b1
    fsbase.S.s_dlg_b2 = b2
    fscore.touch()
}

fn dialog_entry(title: u64, label: u64, initial: u64, b1: u64, b2: u64) {
    dlg_reset(1)
    fsbase.S.s_dlg_title = title
    fsbase.S.s_dlg_text = label
    fsbase.S.s_dlg_b1 = b1
    fsbase.S.s_dlg_b2 = b2
    var n: u64 = 0
    if initial != 0 {
        while n < 255 && __mmio_read8((initial + n) as *mut u8) != 0 as u8 {
            __mmio_write8(((&fsbase.S.s_dbuf[0 as usize]) as u64 + n) as *mut u8,
                __mmio_read8((initial + n) as *mut u8))
            n = n + 1
        }
    }
    __mmio_write8(((&fsbase.S.s_dbuf[0 as usize]) as u64 + n) as *mut u8, 0 as u8)
    fsbase.S.s_dcar = n as usize
    if n > 0 {
        let cp: *mut usize = (&fsbase.S.s_dcar) as *mut usize
        fuiapp.edit((&fsbase.S.s_dbuf[0 as usize]) as u64, 256, cp, 1, false)
    } else {
        fuiapp.sel_clear()
    }
    fsbase.S.s_caret_on = true
    fsbase.S.s_caret_t = fuiapp.now_ms()
    fscore.touch()
}

fn dialog_entry_secret(title: u64, label: u64, initial: u64, b1: u64, b2: u64) {
    dialog_entry(title, label, initial, b1, b2)
    fsbase.S.s_dlg_secret = true
}

fn dialog_entry_text() -> u64 {
    return (&fsbase.S.s_dbuf[0 as usize]) as u64
}

fn dialog_choice(title: u64, text: u64, buttons: u64, n: u64) {
    dlg_reset(2)
    fsbase.S.s_dlg_title = title
    fsbase.S.s_dlg_text = text
    fsbase.S.s_dlg_btns = buttons
    fsbase.S.s_dlg_n = n
    if fsbase.S.s_dlg_n > 4 {
        fsbase.S.s_dlg_n = 4
    }
    if fsbase.S.s_dlg_n == 0 {
        fsbase.S.s_dlg_n = 1
    }
    fscore.touch()
}

fn dialog_busy(title: u64, text: u64) {
    dlg_reset(3)
    fsbase.S.s_dlg_title = title
    fsbase.S.s_dlg_text = text
    fsbase.S.s_dlg_pct = 0
    g_dlg_spin = true
    fscore.touch()
}

fn dialog_spin(title: u64, text: u64) {
    dlg_reset(3)
    fsbase.S.s_dlg_title = title
    fsbase.S.s_dlg_text = text
    fsbase.S.s_dlg_pct = PCT_NONE
    g_dlg_spin = true
    fscore.touch()
}

fn dialog_cancel(label: u64) {
    g_dlg_cancel_label = label
    g_dlg_cancel_ask = false
    fscore.touch()
}

fn dialog_cancel_asked() -> bool {
    return g_dlg_cancel_ask
}

fn dialog_cancel_clear() {
    g_dlg_cancel_ask = false
}

fn dialog_frame_due() -> bool {
    if !fsbase.S.s_dlg_open || fsbase.S.s_dlg_kind != 3 {
        return false
    }
    if !g_dlg_spin && fsbase.S.s_dlg_pct != PCT_INDET {
        return false
    }
    let t: u64 = fuiapp.now_ms()
    if t >= g_dlg_frame_t + DLG_FRAME_MS {
        g_dlg_frame_t = t
        return true
    }
    return false
}

fn dialog_set_text(text: u64) {
    fsbase.S.s_dlg_text = text
    fscore.touch()
}

fn dialog_progress(pct: u64) {
    fsbase.S.s_dlg_pct = pct
    fscore.touch()
}

fn dialog_close() {
    fsbase.S.s_dlg_open = false
    fsbase.S.s_dlg_pct = 255
    fscore.touch()
}

fn dialog_default(n: u64) {
    if n < fsbase.S.s_dlg_n {
        fsbase.S.s_dlg_hot = n
        fscore.touch()
    }
}

fn dialog_result() -> u64 {
    let r: u64 = fsbase.S.s_dlg_res
    fsbase.S.s_dlg_res = 0
    return r
}

fn dialog_cancelled() -> bool {
    let c: bool = fsbase.S.s_dlg_esc
    fsbase.S.s_dlg_esc = false
    return c
}

fn dialog_kind() -> u64 {
    return fsbase.S.s_dlg_kind
}

fn dlg_nbtn() -> u64 {
    if fsbase.S.s_dlg_kind == 3 {
        if g_dlg_cancel_label != 0 {
            return 1
        }
        return 0
    }
    if fsbase.S.s_dlg_kind == 2 {
        return fsbase.S.s_dlg_n
    }
    if fsbase.S.s_dlg_b2 == 0 {
        return 1
    }
    return 2
}

fn dlg_w() -> u64 {
    var want: u64 = DLG_W()
    if fsbase.S.s_dlg_kind == 2 {
        want = fsbase.S.s_dlg_n * fscore.sp(136) + fscore.sp(16)
    }
    if fuiapp.width() < want + fscore.sp(24) {
        return fuiapp.width() - fscore.sp(24)
    }
    return want
}

fn dlg_h() -> u64 {
    if fsbase.S.s_dlg_kind == 1 {
        return DLG_H() + fscore.sp(52)
    }
    if fsbase.S.s_dlg_kind == 3 {
        if g_dlg_cancel_label != 0 {
            return fscore.sp(168)
        }
        return fscore.sp(116)
    }
    if fsbase.S.s_dlg_pct != 255 {
        return DLG_H() + fscore.sp(28)
    }
    return DLG_H()
}

fn dlg_x() -> u64 {
    return (fuiapp.width() - dlg_w()) / 2
}

fn dlg_y() -> u64 {
    return (fuiapp.height() - dlg_h()) / 2
}

fn dlg_by() -> u64 {
    return dlg_y() + dlg_h() - fscore.sp(52)
}

fn dlg_bw() -> u64 {
    let n: u64 = dlg_nbtn()
    if n == 0 {
        return 0
    }
    return (dlg_w() - fscore.sp(16) * (n + 1)) / n
}

fn blob_item(p: u64, j: u64) -> u64 {
    var q: u64 = p
    var k: u64 = 0
    while k < j {
        q = q + text.length(q) + 1
        k = k + 1
    }
    return q
}

fn dlg_label(j: u64) -> u64 {
    if fsbase.S.s_dlg_kind == 3 {
        return g_dlg_cancel_label
    }
    if fsbase.S.s_dlg_kind == 2 {
        return blob_item(fsbase.S.s_dlg_btns, j)
    }
    if j == 0 {
        return fsbase.S.s_dlg_b1
    }
    return fsbase.S.s_dlg_b2
}

fn dialog_ok_x() -> u64 {
    return dlg_x() + fscore.sp(16)
}

fn dialog_ok_y() -> u64 {
    return dlg_by()
}

fn dialog_ok_w() -> u64 {
    return dlg_bw()
}

fn dialog_ok_h() -> u64 {
    return fscore.sp(36)
}

fn dialog_x() -> u64 {
    return dlg_x()
}

fn dialog_y() -> u64 {
    return dlg_y()
}

fn dialog_w() -> u64 {
    return dlg_w()
}

fn dialog_h() -> u64 {
    return dlg_h()
}

fn dialog_btn_x(j: u64) -> u64 {
    return dlg_x() + fscore.sp(16) + j * (dlg_bw() + fscore.sp(16))
}

fn dialog_btn_y() -> u64 {
    return dlg_by()
}

fn dialog_btn_w() -> u64 {
    return dlg_bw()
}

fn dialog_btn_h() -> u64 {
    return fscore.sp(36)
}

fn mix_rgb(a: u32, b: u32, k: u64) -> u32 {
    let ar: u64 = ((a >> 16) & 255 as u32) as u64
    let ag: u64 = ((a >> 8) & 255 as u32) as u64
    let ab: u64 = (a & 255 as u32) as u64
    let br: u64 = ((b >> 16) & 255 as u32) as u64
    let bg: u64 = ((b >> 8) & 255 as u32) as u64
    let bb: u64 = (b & 255 as u32) as u64
    let r: u64 = (ar * (255 - k) + br * k) / 255
    let g: u64 = (ag * (255 - k) + bg * k) / 255
    let bl: u64 = (ab * (255 - k) + bb * k) / 255
    return (4278190080 as u32) | ((r as u32) << 16) | ((g as u32) << 8) | (bl as u32)
}

fn spin_sin_half(i: u64) -> u64 {
    if i == 0 { return 1000 }
    if i == 1 { return 1500 }
    if i == 2 { return 1866 }
    if i == 3 { return 2000 }
    if i == 4 { return 1866 }
    if i == 5 { return 1500 }
    return 1000
}

fn spin_sin(i: u64) -> u64 {
    if i <= 6 {
        return spin_sin_half(i)
    }
    return 2000 - spin_sin_half(i - 6)
}

fn spin_head() -> u64 {
    return (fuiapp.now_ms() / DLG_SPIN_STEP_MS) % DLG_SPIN_DOTS
}

fn dlg_spinner(x: u64, y: u64, d: u64) {
    let z: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
    let t: *mut theme.Colors = theme.theme_colors(fuiapp.theme())
    let head: u64 = spin_head()
    let cx: f64 = (x as f64) + (d as f64) / 2.0
    let cy: f64 = (y as f64) + (d as f64) / 2.0
    let dr: f64 = (d as f64) * 0.09
    let rr: f64 = (d as f64) / 2.0 - dr
    var i: u64 = 0
    while i < DLG_SPIN_DOTS {
        let age: u64 = (head + DLG_SPIN_DOTS - i) % DLG_SPIN_DOTS
        let col: u32 = mix_rgb((*t).accent, (*t).field, age * 235 / (DLG_SPIN_DOTS - 1))
        let ox: f64 = (spin_sin(i) as f64 - 1000.0) * rr / 1000.0
        let oy: f64 = 0.0 - (spin_sin((i + 3) % DLG_SPIN_DOTS) as f64 - 1000.0) * rr / 1000.0
        painter.round_rect(z, cx + ox - dr, cy + oy - dr, dr * 2.0, dr * 2.0, dr, col)
        i = i + 1
    }
}

fn dlg_indet_bar(x: u64, y: u64, w: u64, h: f64) {
    let z: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
    let t: *mut theme.Colors = theme.theme_colors(fuiapp.theme())
    let seg: u64 = w * 30 / 100
    var p: u64 = fuiapp.now_ms() % 1600
    if p > 800 {
        p = 1600 - p
    }
    let off: u64 = (w - seg) * p / 800
    painter.round_rect(z, (x + off) as f64, y as f64, seg as f64, h, fscore.rb(), (*t).accent | 4278190080 as u32)
}

fn dlg_paint() {
    let z: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
    let t: *mut theme.Colors = theme.theme_colors(fuiapp.theme())

    fuiapp.panel(dlg_x(), dlg_y(), dlg_w(), dlg_h())
    fscore.text_tok(dlg_x() + fscore.sp(16), dlg_y() + fscore.sp(12), dlg_w() - fscore.sp(32), fsbase.S.s_dlg_title, style.TOK_TEXT_MUTED)
    if fsbase.S.s_dlg_kind == 3 && g_dlg_spin {
        dlg_spinner(dlg_x() + fscore.sp(16), dlg_y() + fscore.sp(44), fscore.sp(24))
        fscore.text_tok(dlg_x() + fscore.sp(52), dlg_y() + fscore.sp(48), dlg_w() - fscore.sp(68), fsbase.S.s_dlg_text, style.TOK_TEXT)
    } else {
        fscore.text_tok(dlg_x() + fscore.sp(16), dlg_y() + fscore.sp(48), dlg_w() - fscore.sp(32), fsbase.S.s_dlg_text, style.TOK_TEXT)
    }
    if fsbase.S.s_dlg_kind == 1 {
        fuiapp.field(dlg_x() + fscore.sp(16), dlg_y() + fscore.sp(80), dlg_w() - fscore.sp(32), fscore.sp(36),
            (&fsbase.S.s_dbuf[0 as usize]) as u64, 256, fsbase.S.s_dcar, true, fsbase.S.s_dlg_secret, false,
            fsbase.S.s_caret_on, fuiapp.sel_on())
    }
    if fsbase.S.s_dlg_pct != 255 {
        var by2: u64 = dlg_y() + fscore.sp(84)
        if fsbase.S.s_dlg_kind == 1 {
            by2 = dlg_y() + fscore.sp(128)
        }
        var pct: u64 = fsbase.S.s_dlg_pct
        if pct > 100 && pct != PCT_INDET {
            pct = 100
        }
        painter.round_rect(z, (dlg_x() + fscore.sp(16)) as f64, by2 as f64,
            (dlg_w() - fscore.sp(32)) as f64, fscore.spf(12.0), fscore.rb(), (*t).field | 4278190080 as u32)
        if pct == PCT_INDET {
            dlg_indet_bar(dlg_x() + fscore.sp(16), by2, dlg_w() - fscore.sp(32), fscore.spf(12.0))
        } else if pct > 0 {
            var fw: u64 = (dlg_w() - fscore.sp(32)) * pct / 100
            if fw < fscore.sp(12) {
                fw = fscore.sp(12)
            }
            painter.round_rect(z, (dlg_x() + fscore.sp(16)) as f64, by2 as f64, fw as f64,
                fscore.spf(12.0), fscore.rb(), (*t).accent | 4278190080 as u32)
        }
        painter.round_ring(z, (dlg_x() + fscore.sp(16)) as f64, by2 as f64,
            (dlg_w() - fscore.sp(32)) as f64, fscore.spf(12.0), fscore.rb(), 1.0,
            (*t).border_col | 4278190080 as u32)
    }
    let nb: u64 = dlg_nbtn()
    var j: u64 = 0
    while j < nb {
        let foc: bool = fsbase.S.s_dlg_hot == j && (fsbase.S.s_dlg_kind != 1 || j > 0)
        if j == 0 {
            fuiapp.button_main(dialog_btn_x(j), dlg_by(), dlg_bw(), fscore.sp(36),
                dlg_label(j), fsbase.S.s_dlg_hot == 0 && fsbase.S.s_dlg_kind != 1)
        } else {
            fuiapp.button(dialog_btn_x(j), dlg_by(), dlg_bw(), fscore.sp(36),
                dlg_label(j), foc)
        }
        j = j + 1
    }
}

fn dlg_event(e: *mut fuiapp.Ev) -> u64 {
    let ev: fuiapp.Ev = *e
    if fsbase.S.s_dlg_kind == 3 {
        if g_dlg_cancel_label != 0 {
            if ev.kind == fuiapp.EV_DOWN {
                if ev.y >= dlg_by() && ev.y < dlg_by() + fscore.sp(36) && ev.x >= dialog_btn_x(0)
                    && ev.x < dialog_btn_x(0) + dlg_bw() {
                    g_dlg_cancel_ask = true
                    fscore.touch()
                }
            } else if ev.kind == fuiapp.EV_KEY && (ev.key == hostkey.KEY_ENTER || ev.key == hostkey.KEY_ESC) {
                g_dlg_cancel_ask = true
                fscore.touch()
            }
        }
        return 0
    }
    let nb: u64 = dlg_nbtn()
    let by: u64 = dlg_by()
    if ev.kind == fuiapp.EV_DOWN {
        if ev.y >= by && ev.y < by + fscore.sp(36) && ev.x >= dlg_x() + fscore.sp(16) && nb > 0 {
            let bw: u64 = dlg_bw()
            let rel: u64 = ev.x - dlg_x() - fscore.sp(16)
            let j: u64 = rel / (bw + fscore.sp(16))
            if j < nb && rel - j * (bw + fscore.sp(16)) < bw {
                fsbase.S.s_dlg_res = j + 1
            }
        }
    } else if ev.kind == fuiapp.EV_KEY {
        if ev.key == hostkey.KEY_ENTER {
            if fsbase.S.s_dlg_kind == 1 {
                fsbase.S.s_dlg_res = 1
            } else {
                fsbase.S.s_dlg_res = fsbase.S.s_dlg_hot + 1
            }
        } else if ev.key == hostkey.KEY_ESC {
            if fsbase.S.s_dlg_kind == 2 {
                fsbase.S.s_dlg_esc = true
                fsbase.S.s_dlg_res = nb
            } else if nb == 1 {
                fsbase.S.s_dlg_res = 1
            } else {
                fsbase.S.s_dlg_res = 2
            }
        } else if nb > 1 && (ev.key == hostkey.KEY_TAB
            || (fsbase.S.s_dlg_kind != 1 && (ev.key == hostkey.KEY_LEFT
            || ev.key == hostkey.KEY_RIGHT))) {
            if ev.key == hostkey.KEY_LEFT && fsbase.S.s_dlg_kind == 2 {
                if fsbase.S.s_dlg_hot > 0 {
                    fsbase.S.s_dlg_hot = fsbase.S.s_dlg_hot - 1
                } else {
                    fsbase.S.s_dlg_hot = nb - 1
                }
            } else {
                fsbase.S.s_dlg_hot = (fsbase.S.s_dlg_hot + 1) % nb
            }
            fscore.touch()
        } else if fsbase.S.s_dlg_kind == 1 {
            let cp: *mut usize = (&fsbase.S.s_dcar) as *mut usize
            fuiapp.edit((&fsbase.S.s_dbuf[0 as usize]) as u64, 256, cp, ev.key, false)
            fsbase.S.s_caret_on = true
            fsbase.S.s_caret_t = fuiapp.now_ms()
            fscore.touch()
        }
    }
    if fsbase.S.s_dlg_res != 0 {
        fsbase.S.s_dlg_open = false
        fscore.touch()
        return KEY_DIALOG
    }
    return 0
}

fn words_copy(dst: u64, src: u64, bytes: u64) {
    var i: u64 = 0
    while i < bytes {
        __mmio_write64((dst + i) as *mut u64, __mmio_read64((src + i) as *mut u64))
        i = i + 8
    }
}

fn words_zero(dst: u64, bytes: u64) {
    var i: u64 = 0
    while i < bytes {
        __mmio_write64((dst + i) as *mut u64, 0 as u64)
        i = i + 8
    }
}

fn ctx_addr() -> u64 {
    return (&fsbase.S) as u64
}

fn ctx_bytes() -> u64 {
    return ((&fsbase.S.fa9) as u64) + 8 - ctx_addr()
}

fn blob_of(i: u64) -> u64 {
    if fsbase.w_blob[(i) as usize] == 0 {
        let m: u64 = rt.heap_alloc(ctx_bytes() as usize) as u64
        fsbase.w_blob[(i) as usize] = m
    }
    return fsbase.w_blob[(i) as usize]
}

fn ctx_save() -> bool {
    let b: u64 = blob_of(fsbase.w_cur)
    if b == 0 {
        return false
    }
    fuiapp.win_save((&fsbase.S.fa0) as u64)
    words_copy(b, ctx_addr(), ctx_bytes())
    return true
}

fn ctx_load(i: u64) {
    words_copy(ctx_addr(), fsbase.w_blob[(i) as usize], ctx_bytes())
    fuiapp.win_load((&fsbase.S.fa0) as u64)
}

fn ctx_fresh() {
    words_zero(ctx_addr(), ctx_bytes())
    ctx_init()
}

fn ctx_fa_off() -> u64 {
    return (&fsbase.S.fa0) as u64 - ctx_addr()
}

fn hit_win() -> u64 {
    return fsbase.w_hit
}

static mut rawmem: [u8; 8] = [0 as u8; 8]

fn raw_slot() -> *mut fn(u64, u64, u64, u64, u64) {
    return ((&rawmem[0 as usize]) as u64) as *mut fn(u64, u64, u64, u64, u64)
}

fn raw_take() {
    fsbase.raw_took = 1
}

fn set_raw(f: fn(u64, u64, u64, u64, u64)) {
    *raw_slot() = f
    fsbase.raw_win = fsbase.w_cur
}

static mut postmem: [u8; 8] = [0 as u8; 8]

fn post_slot() -> *mut fn() {
    return ((&postmem[0 as usize]) as u64) as *mut fn()
}

fn post_ready() -> bool {
    let slot: *mut u64 = ((&postmem[0 as usize]) as u64) as *mut u64
    return *slot != 0
}

fn set_overlay(f: fn()) {
    *post_slot() = f
}
