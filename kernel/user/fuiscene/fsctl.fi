fn ctx_init() {
    fsbase.S.s_S = 1
    fsbase.S.s_Sm = 1000
    fsbase.S.s_stale = true
    var i0: u64 = 0
    while i0 < fsbase.ENTRY_MAX {
        fsbase.S.s_enode[(i0) as usize] = 4294967295 as usize
        i0 = i0 + 1
    }
    fsbase.S.s_caret_on = true
    fsbase.S.s_mnode = 4294967295
    var i1: u64 = 0
    while i1 < 8 {
        fsbase.S.s_ct_node[(i1) as usize] = 4294967295 as usize
        i1 = i1 + 1
    }
    var i2: u64 = 0
    while i2 < 8 {
        fsbase.S.s_ct_cols[(i2) as usize] = 1 as u64
        i2 = i2 + 1
    }
    var i3: u64 = 0
    while i3 < 8 {
        fsbase.S.s_ct_rh[(i3) as usize] = 28 as u64
        i3 = i3 + 1
    }
    fsbase.S.s_ct_last_row = 4294967295
    fsbase.S.s_ct_headcol = 4294967295
    fsbase.S.s_ct_dn = 4294967295
    fsbase.S.s_ct_sbk = 4294967295
    fsbase.S.s_drop_row = 4294967295
    fsbase.S.s_hov_k = 4294967295
    fsbase.S.s_hov_row = 4294967295
    var i4: u64 = 0
    while i4 < 24 {
        fsbase.S.s_vnode[(i4) as usize] = 4294967295 as usize
        i4 = i4 + 1
    }
    var i5: u64 = 0
    while i5 < 12 {
        fsbase.S.s_cv_node[(i5) as usize] = 4294967295 as usize
        i5 = i5 + 1
    }
    var i6: u64 = 0
    while i6 < 16 {
        fsbase.S.s_im_node[(i6) as usize] = 4294967295 as usize
        i6 = i6 + 1
    }
    var i7: u64 = 0
    while i7 < 16 {
        fsbase.S.s_im_zoom[(i7) as usize] = 100 as u64
        i7 = i7 + 1
    }
    fsbase.S.s_im_selk = 4294967295
    fsbase.S.s_im_drag = 4294967295
    var i8: u64 = 0
    while i8 < 2 {
        fsbase.S.s_ed_node[(i8) as usize] = 4294967295 as usize
        i8 = i8 + 1
    }
    fsbase.S.s_ed_down = 4294967295
    fsbase.S.s_dlg_n = 2
    fsbase.S.s_dlg_pct = 255
}

const KEY_DIALOG: u64 = 4294967293

static mut s_f_nohit: bool = false

static mut s_f_noclip: bool = false

static mut s_begun: bool = false

fn set_flags(nohit: bool, noclip: bool) {
    s_f_nohit = nohit
    s_f_noclip = noclip
}

fn begin() -> bool {
    if s_begun {
        return true
    }
    if !fsbase.w_inited {
        ctx_init()
        fsbase.w_inited = true
    }
    if !apphost.begin(s_f_nohit, s_f_noclip) {
        return false
    }
    s_begun = true
    return true
}

