fn sp(n: u64) -> u64 {
    return (n * fsbase.S.s_Sm + 500) / 1000
}

fn spf(n: f64) -> f64 {
    return n * (fsbase.S.s_Sm as f64) / 1000.0
}

fn scale_milli() -> u64 {
    return fsbase.S.s_Sm
}

fn rb() -> f64 {
    return spf((*theme.theme_shape(fuiapp.theme())).r_button as f64)
}

fn rf() -> f64 {
    return spf((*theme.theme_shape(fuiapp.theme())).r_field as f64)
}

fn rp() -> f64 {
    return spf((*theme.theme_shape(fuiapp.theme())).r_panel as f64)
}

fn rb_px() -> u64 {
    return sp((*theme.theme_shape(fuiapp.theme())).r_button as u64)
}

fn rless(r: f64, d: f64) -> f64 {
    if r <= d {
        return 0.0
    }
    return r - d
}

fn rpill(h: f64) -> f64 {
    if rp() == 0.0 {
        return 0.0
    }
    return h / 2.0
}

fn scale() -> u64 {
    return fsbase.S.s_S
}

fn dpf(v: f64) -> f64 {
    return v * 1000.0 / (fsbase.S.s_Sm as f64)
}

fn ui_px() -> u64 {
    return wlibc.px_ui_at(fsbase.S.s_Sm / 10)
}

fn dp(px: u64) -> u64 {
    return px * 1000 / fsbase.S.s_Sm
}

const KEY_POPUP: u64 = 4294967294

fn buildf_slot() -> *mut fn() {
    return ((&fsbase.S.s_bf[0 as usize]) as u64) as *mut fn()
}

fn sc() -> *mut scene.Scene {
    return ((&fsbase.S.s_sc_mem[0 as usize]) as u64) as *mut scene.Scene
}

fn sh() -> *mut sheet.Sheet {
    return ((&fsbase.S.s_sh_mem[0 as usize]) as u64) as *mut sheet.Sheet
}

fn wirt() -> *mut fuiwirt.Host {
    return ((&fsbase.S.s_wirt_mem[0 as usize]) as u64) as *mut fuiwirt.Host
}

fn root() -> usize {

    if fsbase.st_on && fsbase.st_body != fsbase.NONE {
        return fsbase.st_body
    }
    return scene.scene_root(sc())
}

static mut st_caps: u64 = 0

static mut st_dragkey: u64 = 0

static mut st_x0: u64 = 0xFFFFFFFFFFFFFFFF

static mut st_x1: u64 = 0

static mut st_reports: u64 = 0

fn strip_on() -> bool {
    return fsbase.st_on
}

fn strip_h() -> u64 {
    if fsbase.st_on {
        return fsbase.st_h
    }
    return 0
}

fn strip_caps_w() -> u64 {
    return st_caps
}

fn caption_strip(on: bool) -> bool {
    if !wlib.win_cap_strip(fuiapp.win(), on) {
        return false
    }
    fsbase.st_on = on
    st_x0 = 0xFFFFFFFFFFFFFFFF
    st_x1 = 0
    if on {
        let sm0: u64 = fsbase.S.s_Sm
        fsbase.st_h = (wlib.win_strip_h(fuiapp.win()) * 1000 + sm0 - 1) / sm0
        st_caps = (wlib.win_cap_w(fuiapp.win()) * 1000 + sm0 - 1) / sm0
    } else {
        fsbase.st_h = 0
    }

    fsbase.S.s_rseq = wlib.resize_seq()
    let _rz: bool = fuiapp.resize()
    fsbase.S.s_stale = true
    touch()
    return true
}

fn strip_row() -> usize {
    if fsbase.st_on {
        return fsbase.st_row
    }
    return fsbase.NONE
}

fn strip_drag_node(key: u64) {
    st_dragkey = key
}

fn strip_sync() {
    let f: bool = wlib.win_fokus(fuiapp.win())
    if f != fsbase.st_foc {
        fsbase.st_foc = f
        touch()
    }
    if st_dragkey == 0 {
        return
    }
    let n: usize = node_of_key(st_dragkey)
    if n == fsbase.NONE {
        return
    }
    let x0: u64 = sp(node_x(n))
    let x1: u64 = sp(node_x(n) + node_w(n))
    if x0 == st_x0 && x1 == st_x1 {
        return
    }
    st_x0 = x0
    st_x1 = x1
    if wlib.win_strip_drag(fuiapp.win(), x0, x1) {
        st_reports = st_reports + 1
    }
}

fn strip_reports() -> u64 {
    return st_reports
}

fn node_count() -> usize {
    return scene.scene_count(sc())
}

fn widgets_since(first: usize) -> u64 {
    var n: u64 = 0
    var i: usize = first
    let total: usize = scene.scene_count(sc())
    while i < total {
        if scene.node_kind(sc(), i) == scene.N_WIDGET {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn width() -> u64 {
    return dp(fuiapp.width())
}

fn height() -> u64 {
    return dp(fuiapp.height())
}

fn resized() -> u64 {
    return fsbase.S.s_rseq
}

fn right_x() -> u64 {
    return fsbase.S.s_rx
}

fn right_y() -> u64 {
    return fsbase.S.s_ry
}

fn key_at(x: u64, y: u64) -> u64 {
    let n: usize = scene.scene_hit(sc(), x as f64, y as f64)
    if n == scene.SCENE_NONE || n >= scene.scene_count(sc()) {
        return 0
    }
    return scene.node_id(sc(), n) as u64
}

fn painted() -> u64 {
    return fsbase.S.s_paints
}

fn builds() -> u64 {
    return fsbase.S.s_builds
}

fn ebuf(k: u64) -> u64 {
    return ((&fsbase.S.s_ebuf[0 as usize]) as u64) + k * fsbase.ENTRY_CAP
}

fn slot_of_key(key: u64) -> u64 {
    var k: u64 = 0
    while k < fsbase.S.s_en {
        if fsbase.S.s_ekey[(k) as usize] == key {
            return k
        }
        k = k + 1
    }
    return fsbase.NO_SLOT
}

fn slot_of_node(i: usize) -> u64 {
    var k: u64 = 0
    while k < fsbase.S.s_en {
        if fsbase.S.s_enode[(k) as usize] == i {
            return k
        }
        k = k + 1
    }
    return fsbase.NO_SLOT
}

static mut gl_plate_mem: [u8; 8] = [0 as u8; 8]

fn gl_plate_slot() -> *mut fn(u64, u64, u64, u64, u64) {
    return ((&gl_plate_mem[0 as usize]) as u64) as *mut fn(u64, u64, u64, u64, u64)
}

fn off_canvas(e: *mut widget.Widget) -> bool {
    return widget.w_x(e) < 0.0 || widget.w_y(e) < 0.0
}

fn key_seq() -> u64 {
    return fsbase.S.s_kseq
}

fn key_any() -> u64 {
    return fsbase.S.s_kany
}

fn last_key() -> u64 {
    let k: u64 = fsbase.S.s_lastkey
    fsbase.S.s_lastkey = 0
    return k
}

fn MEMO_LH() -> u64 {
    return sp(22)
}

fn mbuf() -> u64 {
    return (&fsbase.S.s_mbuf[0 as usize]) as u64
}

fn POP_ROW() -> u64 {
    return sp(28)
}

fn menu_is_open() -> bool {
    return fsbase.S.s_pop_open
}

fn menu_open(x: u64, y: u64, w: u64, items: u64, n: u64) {
    fsbase.S.s_pop_open = true
    var px: u64 = x
    var py: u64 = y

    let ph: u64 = n * POP_ROW() + sp(8)
    if px + w > fuiapp.width() {
        if fuiapp.width() > w {
            px = fuiapp.width() - w
        } else {
            px = 0
        }
    }
    if py + ph > fuiapp.height() {
        if fuiapp.height() > ph {
            py = fuiapp.height() - ph
        } else {
            py = 0
        }
    }
    fsbase.S.s_pop_x = px
    fsbase.S.s_pop_y = py
    fsbase.S.s_pop_w = w
    fsbase.S.s_pop_items = items
    fsbase.S.s_pop_n = n
    fsbase.S.s_pop_hot = 0
    fsbase.S.s_pop_pick = 0
    touch()
}

fn menu_x() -> u64 {
    return fsbase.S.s_pop_x
}

fn menu_y() -> u64 {
    return fsbase.S.s_pop_y
}

fn menu_w() -> u64 {
    return fsbase.S.s_pop_w
}

fn menu_h() -> u64 {
    return pop_h()
}

fn menu_close() {
    if fsbase.S.s_pop_open {
        fsbase.S.s_pop_open = false
        touch()
    }
}

fn menu_pick() -> u64 {
    let p: u64 = fsbase.S.s_pop_pick
    fsbase.S.s_pop_pick = 0
    return p
}

fn pop_item(i: u64) -> u64 {
    var p: u64 = fsbase.S.s_pop_items
    var k: u64 = 0
    while k < i {
        p = p + text.length(p) + 1
        k = k + 1
    }
    return p
}

fn pop_h() -> u64 {
    return fsbase.S.s_pop_n * POP_ROW() + sp(8)
}

fn pop_row_at(x: u64, y: u64) -> u64 {
    if x < fsbase.S.s_pop_x || x >= fsbase.S.s_pop_x + fsbase.S.s_pop_w {
        return fsbase.NO_SLOT
    }
    if y < fsbase.S.s_pop_y + sp(4) || y >= fsbase.S.s_pop_y + sp(4) + fsbase.S.s_pop_n * POP_ROW() {
        return fsbase.NO_SLOT
    }
    return (y - fsbase.S.s_pop_y - sp(4)) / POP_ROW()
}

fn text_tok(x: u64, y: u64, w: u64, p: u64, tok: u32) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x as f64, y as f64, w as f64, spf(24.0))
    widget.w_set_text(&e, p, text.length(p) as usize)
    widget.w_set_style(&e, style.style_set_fg(style.style_new(),
        style.color_token(tok)))
    render.draw_widget(fuiapp.ctx(), &e)
}

fn sel_bar(z: *mut painter.Painter, x: u64, y: u64, h: u64) {
    let t: *mut theme.Colors = theme.theme_colors(fuiapp.theme())
    if (*t).selection == (*t).accent {
        return
    }
    var bh: u64 = sp(16)
    if bh + sp(8) > h {
        bh = h - sp(8)
    }
    painter.round_rect(z, (x + sp(1)) as f64, (y + (h - bh) / 2) as f64,
        sp(3) as f64, bh as f64, spf(1.5), (*t).accent | 4278190080 as u32)
}

fn row_draw(x: u64, y: u64, w: u64, h: u64, p: u64, on: bool) {
    let z: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
    let t: *mut theme.Colors = theme.theme_colors(fuiapp.theme())
    var tok: u32 = style.TOK_TEXT
    if on {
        painter.round_rect(z, x as f64, y as f64, w as f64, h as f64, rb(),
            (*t).selection | 4278190080 as u32)
        sel_bar(z, x, y, h)
        tok = style.TOK_SELECTION_TEXT
    }

    text_tok(x + sp(10), y + (h - sp(24)) / 2 - sp(1), w - sp(20), p, tok)
}

fn pop_paint() {
    fuiapp.panel(fsbase.S.s_pop_x, fsbase.S.s_pop_y, fsbase.S.s_pop_w, pop_h())
    var k: u64 = 0
    while k < fsbase.S.s_pop_n {
        row_draw(fsbase.S.s_pop_x + sp(4), fsbase.S.s_pop_y + sp(4) + k * POP_ROW(), fsbase.S.s_pop_w - sp(8),
            POP_ROW(), pop_item(k), k == fsbase.S.s_pop_hot)
        k = k + 1
    }
}

fn caret_on() -> bool {
    return fsbase.S.s_caret_on
}

fn keys_always(on: bool) {
    let _k: u64 = wlib.win_keys(fuiapp.win(), on)
}

fn has_focus() -> bool {
    return wlib.win_fokus(fuiapp.win())
}

static mut w_quit: u64 = 0

fn alive() -> bool {
    return w_quit == 0 && fuiapp.alive()
}

fn quit() {
    fsbase.S.s_quit = 1
    w_quit = 1
}

fn hide(on: bool) {
    let _h: u64 = wlib.win_hide(fuiapp.win(), on)
    let _p: u64 = wlib.paint_all()
    if !on {
        touch()
    }
}

fn handle() -> u64 {
    return wlib.handle(fuiapp.win())
}

fn raise() {
    let _r: u64 = wlibc.win_act(wlibc.sys3w(wlibc.WM_INFO,
        wlib.handle(fuiapp.win()), wlibc.WI_ID, 0), wlibc.WA_RAISE)
}

fn touch() {
    fuiwirt.host_touch(wirt())
}

fn refresh() {
    fsbase.S.s_stale = true
    touch()
}

const MIN_SCENE_W: u64 = 120

const MIN_SCENE_H: u64 = 80

fn too_small() -> bool {
    if !fsbase.S.s_minguard || wlib.nominsize() {
        return false
    }
    return width() < MIN_SCENE_W || height() < MIN_SCENE_H
}

fn row(parent: usize) -> usize {
    return scene.scene_box(sc(), parent, 0 as u32, flex.FLEX_ROW,
        flex.JUSTIFY_START, flex.AL_CENTER)
}

fn row_stretch(parent: usize) -> usize {
    return scene.scene_box(sc(), parent, 0 as u32, flex.FLEX_ROW,
        flex.JUSTIFY_START, flex.AL_STRETCH)
}

fn space(parent: usize, w: u64, h: u64) -> usize {
    let i: usize = scene.scene_add(sc(), parent, scene.N_BOX)
    if i != scene.SCENE_NONE {
        scene.node_set_size(sc(), i, w as f64, h as f64)
    }
    return i
}

fn separator(parent: usize) -> usize {
    let i: usize = scene.scene_add(sc(), parent, scene.N_WIDGET)
    if i != scene.SCENE_NONE {
        scene.node_set_widget_kind(sc(), i, widget.KIND_SEPARATOR)
        scene.node_set_size(sc(), i, 0.0, 1.0)
    }
    return i
}

fn label(parent: usize, text: u64) -> usize {
    let i: usize = scene.scene_add(sc(), parent, scene.N_TEXT)
    if i != scene.SCENE_NONE {
        var lh: f64 = 24.0
        if fsbase.S.s_dense {
            lh = 20.0
        }
        scene.node_set_size(sc(), i, 0.0, lh)
        scene.node_set_text(sc(), i, text, text.length(text) as usize)
    }
    return i
}

fn plate_state(e: *mut widget.Widget) -> u64 {
    var st: u64 = 0
    if widget.w_is_hover(e) {
        st = st | fsbase.TS_HOT
    }
    if widget.w_is_active(e) {
        st = st | fsbase.TS_DOWN
    }
    if widget.w_is_disabled(e) {
        st = st | fsbase.TS_OFF
    }
    return st
}

fn compact(i: usize) {
    if i == fsbase.NONE {
        return
    }
    let key: u32 = scene.node_id(sc(), i)
    if key == 0 as u32 {
        return
    }
    let _r: usize = sheet.sheet_rule(sh(), sheet.sel_id(key),
        style.style_set_pad(style.style_new(), 8, 8))
}

fn accent_ink(on: bool) {
    fsbase.acc_ink = on
}

static mut fl_marker: u64 = 0

fn ensure_flat_rules() {
    if fl_marker != fsbase.S.s_builds + 1 {

        fl_marker = fsbase.S.s_builds + 1
        let _r0: usize = sheet.sheet_rule(sh(), sheet.sel_class(fsbase.FLAT_CLS),
            style.style_set_border_width(style.style_set_fg(style.style_set_bg(style.style_new(),
                style.color_transparent()), style.color_transparent()), 0 as usize))
        let _r1: usize = sheet.sheet_rule(sh(),
            sheet.sel_with_state(sheet.sel_class(fsbase.FLAT_CLS), style.STATE_HOVER),
            style.style_set_border_width(style.style_set_bg(style.style_new(), style.color_transparent()),
                0 as usize))
        let _r2: usize = sheet.sheet_rule(sh(),
            sheet.sel_with_state(sheet.sel_class(fsbase.FLAT_CLS), style.STATE_ACTIVE),
            style.style_set_border_width(style.style_set_bg(style.style_new(), style.color_transparent()),
                0 as usize))
    }
}

fn role_col2(r: u64) -> u32 {
    return role_col(r)
}

fn text_width(p: u64, size: u64) -> u64 {
    return wlibc.text_w(wlibc.F_UI, size, p, text.length(p))
}

fn text_role(x: u64, base: u64, w: u64, p: u64, size: u64, bold: bool, role: u64) {
    two_text(x, base, w, p, size, bold, role_col(role))
}

const PLATE_CLS: u32 = 7773

fn plate_node(i: usize) {
    if i != fsbase.NONE {
        let _p: bool = scene.node_add_class(sc(), i, PLATE_CLS)
    }
}

fn cv_glyph(cp: u64, x: u64, y: u64, size: u64, rgb: u64) {
    let c: u32 = (((rgb & 255) << 16) | (rgb & 65280) | ((rgb >> 16) & 255)) as u32
    fuiapp.glyph(cp, x, y, size, c | 4278190080 as u32)
}

fn node_lines(i: usize) -> u64 {
    return scene.node_text_lines(sc(), i) as u64
}

fn node_of_key(key: u64) -> usize {
    return scene.scene_find_id(sc(), key as u32)
}

fn key_of_node(i: usize) -> u64 {
    return scene.node_id(sc(), i) as u64
}

fn keep_focus(on: bool) {
    fsbase.s_keep_focus = on
}

fn focus(key: u64) {
    let n: usize = scene.scene_find_id(sc(), key as u32)
    if n != scene.SCENE_NONE {
        control.panel_set_focus(fuiwirt.host_panel(wirt()), n)
        touch()
    }
}

fn focus_clear() {
    fsbase.focus_drop = true
    let r: u32 = control.panel_set_focus(fuiwirt.host_panel(wirt()), control.NOBODY)
    if r != 0 as u32 {
        touch()
    }
}

fn focus_key() -> u64 {
    let f: usize = fuiwirt.host_focus(wirt())
    if f == fuiwirt.KEINER || f >= scene.scene_count(sc()) {
        return 0
    }
    return scene.node_id(sc(), f) as u64
}

fn key_geom(key: u64) -> u64 {
    let pn: usize = scene.scene_find_id(sc(), key as u32)
    if pn == scene.SCENE_NONE {
        return 0
    }
    return ((node_x(pn) & 65535) << 48) | ((node_y(pn) & 65535) << 32) | ((node_w(pn) & 65535) << 16) | (node_h(pn) & 65535)
}

const NODE_FAR: u64 = 1099511627776

fn node_x(i: usize) -> u64 {
    let v: f64 = scene.node_x(sc(), i)
    if v < 0.0 {
        return NODE_FAR
    }
    return v as u64
}

fn node_y(i: usize) -> u64 {
    let v: f64 = scene.node_y(sc(), i)
    if v < 0.0 {
        return NODE_FAR
    }
    return v as u64
}

fn node_off(i: usize) -> bool {
    return scene.node_x(sc(), i) < 0.0 || scene.node_y(sc(), i) < 0.0
}

fn node_w(i: usize) -> u64 {
    return scene.node_w(sc(), i) as u64
}

fn node_h(i: usize) -> u64 {
    return scene.node_h(sc(), i) as u64
}

fn key_num(k: u64) -> u32 {
    if k == wlib.KEY_TAB {
        return fuiwirt.KEY_TAB
    }
    if k == wlib.KEY_ENTER {
        return fuiwirt.KEY_RETURN
    }
    if k == wlib.KEY_UP {
        return fuiwirt.KEY_UP
    }
    if k == wlib.KEY_DOWN {
        return fuiwirt.KEY_DOWN
    }
    if k == wlib.KEY_LEFT {
        return fuiwirt.KEY_LEFT
    }
    if k == wlib.KEY_RIGHT {
        return fuiwirt.KEY_RIGHT
    }
    return 0 as u32
}

fn halo() {
    let fk: u64 = focus_key()
    if fk == 0 {
        return
    }
    var k: u64 = 0
    while k < fsbase.S.s_nhaupt {
        if fsbase.S.s_main[(k) as usize] == fk {
            let i: usize = node_of_key(fk)
            if i != fsbase.NONE {
                let z: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
                let t: *mut theme.Colors = theme.theme_colors(fuiapp.theme())
                painter.round_ring(z, (node_x(i) - 3) as f64,
                    (node_y(i) - 3) as f64, (node_w(i) + 6) as f64,
                    (node_h(i) + 6) as f64, (rb() + spf(3.0)), 2.0,
                    (*t).text | 4278190080 as u32)
            }
        }
        k = k + 1
    }
}

fn plates() {
    if wlibc.win_alpha_fx() >= 100 {
        return
    }
    let px: u64 = ui_px()
    let lh: u64 = wlibc.text_h(px) + 2
    var tx0: u64 = 4294967295
    var ty0: u64 = 4294967295
    var tx1: u64 = 0
    var ty1: u64 = 0
    var i: usize = 0
    while i < scene.scene_count(sc()) {
        let e: *mut widget.Widget = scene.node_widget(sc(), i)
        var nt: u64 = widget.w_text_len(e) as u64

        if scene.node_kind(sc(), i) == scene.N_WIDGET && widget.w_value(e) >= 57344 && widget.w_value(e) < 63744 {
            nt = 0
        }
        if nt > 0 {
            let p: u64 = widget.w_text(e)
            var tw: u64 = wlibc.text_w(wlibc.F_UI, px, p, nt)
            if tw > node_w(i) && node_w(i) > 0 {
                tw = node_w(i)
            }
            var x: u64 = node_x(i)
            var whole: bool = false
            if scene.node_kind(sc(), i) == scene.N_WIDGET {
                let kind: u64 = nk_of(widget.w_kind(e))
                if kind == 7 {

                    if node_x(i) < tx0 {
                        tx0 = node_x(i)
                    }
                    if node_y(i) < ty0 {
                        ty0 = node_y(i)
                    }
                    if node_x(i) + node_w(i) > tx1 {
                        tx1 = node_x(i) + node_w(i)
                    }
                    if node_y(i) + node_h(i) > ty1 {
                        ty1 = node_y(i) + node_h(i)
                    }
                    whole = true
                }
                if kind == 2 && node_w(i) > tw {
                    x = x + (node_w(i) - tw) / 2
                }
                if kind == 3 {
                    let fo: *mut theme.Shape = theme.theme_shape(fuiapp.theme())
                    x = x + (wave2.box_side(fuiapp.ctx(), e)
                        + render.len_of(fuiapp.ctx(), (*fo).sp_s)) as u64
                }
            }
            if !whole {
                if node_h(i) > 2 * lh {

                    fuiapp.plate(node_x(i), node_y(i), node_w(i), node_h(i))
                } else {
                    var y0: u64 = node_y(i)
                    if node_h(i) > lh {
                        y0 = y0 + (node_h(i) - lh) / 2
                    }
                    fuiapp.plate_ink(x, y0, tw, lh)
                }
            }
        }
        i = i + 1
    }
    if tx1 > tx0 && ty1 > ty0 {
        fuiapp.plate(tx0, ty0, tx1 - tx0, ty1 - ty0)
    }

    var q: usize = 0
    while q < scene.scene_count(sc()) {
        if scene.node_has_class(sc(), q, PLATE_CLS) {
            fuiapp.plate(node_x(q), node_y(q), node_w(q), node_h(q))
        }
        q = q + 1
    }
}

fn edit_takes(k: u64) -> bool {
    if k == 1 || k == wlib.KEY_LEFT || k == wlib.KEY_RIGHT || k == wlib.KEY_HOME
        || k == wlib.KEY_END || k == wlib.KEY_BS || k == 127 || k == wlib.KEY_DEL {
        return true
    }
    return k >= 32 && k < 256
}

fn pop_event(e: *mut fuiapp.Ev) -> u64 {
    let ev: fuiapp.Ev = *e
    if ev.kind == fuiapp.EV_MOVE {
        let r: u64 = pop_row_at(ev.x, ev.y)
        if r != fsbase.NO_SLOT && r != fsbase.S.s_pop_hot {
            fsbase.S.s_pop_hot = r
            touch()
        }
        return 0
    }
    if ev.kind == fuiapp.EV_DOWN {
        let r: u64 = pop_row_at(ev.x, ev.y)
        fsbase.S.s_pop_open = false
        touch()
        if r != fsbase.NO_SLOT {
            fsbase.S.s_pop_pick = r + 1
            return KEY_POPUP
        }
        return 0
    }
    if ev.kind == fuiapp.EV_KEY {
        if ev.key == wlib.KEY_ESC {
            fsbase.S.s_pop_open = false
            touch()
        } else if ev.key == wlib.KEY_DOWN {
            if fsbase.S.s_pop_hot + 1 < fsbase.S.s_pop_n {
                fsbase.S.s_pop_hot = fsbase.S.s_pop_hot + 1
                touch()
            }
        } else if ev.key == wlib.KEY_UP {
            if fsbase.S.s_pop_hot > 0 {
                fsbase.S.s_pop_hot = fsbase.S.s_pop_hot - 1
                touch()
            }
        } else if ev.key == wlib.KEY_ENTER {
            fsbase.S.s_pop_open = false
            fsbase.S.s_pop_pick = fsbase.S.s_pop_hot + 1
            touch()
            return KEY_POPUP
        }
    }
    return 0
}

static mut s_trb: [u8; 320] = [0 as u8; 320]

static mut t_rect: [u8; 12] = ": rect id=\0\0"

static mut t_kind: [u8; 8] = " kind=\0\0"

static mut t_x: [u8; 4] = " x=\0"

static mut t_y: [u8; 4] = " y=\0"

static mut t_w: [u8; 4] = " w=\0"

static mut t_h: [u8; 4] = " h=\0"

static mut t_txt: [u8; 24] = "wlib: text win=\0\0\0\0\0\0\0\0\0"

static mut t_base: [u8; 8] = " base=\0\0"

static mut t_fg: [u8; 5] = " fg=\0"

static mut t_bg: [u8; 5] = " bg=\0"

static mut t_tw: [u8; 5] = " tw=\0"

static mut t_ax: [u8; 5] = " ax=\0"

static mut t_ay: [u8; 5] = " ay=\0"

static mut t_ow: [u8; 5] = " ow=\0"

static mut t_bw: [u8; 5] = " bw=\0"

static mut t_t: [u8; 4] = " t=\0"

static mut t_bt: [u8; 17] = "wlib: texts ax=\0\0"

fn trace_on() -> bool {
    return !wlib.blink_enabled()
}

fn tr_put(b: u64, at: u64, p: u64) -> u64 {
    var k: u64 = 0
    var n: u64 = at
    while __mmio_read8((p + k) as *mut u8) != 0 as u8 && n < 300 {
        __mmio_write8((b + n) as *mut u8, __mmio_read8((p + k) as *mut u8))
        n = n + 1
        k = k + 1
    }
    return n
}

fn tr_num(b: u64, at: u64, v: u64) -> u64 {
    var d: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var u: u64 = v
    if u == 0 {
        d[0 as usize] = 48 as u8
        n = 1
    }
    while u > 0 {
        d[(n) as usize] = (48 + u % 10) as u8
        u = u / 10
        n = n + 1
    }
    var at2: u64 = at
    while n > 0 {
        n = n - 1
        __mmio_write8((b + at2) as *mut u8, d[(n) as usize])
        at2 = at2 + 1
    }
    return at2
}

fn nk_of(k: u32) -> u64 {
    if k == widget.KIND_BUTTON {
        return 2
    }
    if k == widget.KIND_CHECKBOX {
        return 3
    }
    if k == widget.KIND_TEXTBOX {
        return 4
    }
    if k == widget.KIND_TAB {
        return 7
    }
    if k == widget.KIND_DROPDOWN {
        return 9
    }
    if k == widget.KIND_SLIDER {
        return 17
    }
    if k == widget.KIND_LIST {
        return 6
    }
    return 0
}

fn say_rects(prog: u64) {
    let b: u64 = (&s_trb[0 as usize]) as u64
    var i: usize = 0
    while i < scene.scene_count(sc()) {
        if scene.node_kind(sc(), i) == scene.N_WIDGET {
            let nk: u64 = nk_of(widget.w_kind(scene.node_widget(sc(), i)))
            if nk != 0 {
                var at: u64 = tr_put(b, 0, prog)
                at = tr_put(b, at, (&t_rect[0 as usize]) as u64)
                at = tr_num(b, at, i as u64)
                at = tr_put(b, at, (&t_kind[0 as usize]) as u64)
                at = tr_num(b, at, nk)
                at = tr_put(b, at, (&t_x[0 as usize]) as u64)
                at = tr_num(b, at, node_x(i))
                at = tr_put(b, at, (&t_y[0 as usize]) as u64)
                at = tr_num(b, at, node_y(i))
                at = tr_put(b, at, (&t_w[0 as usize]) as u64)
                at = tr_num(b, at, node_w(i))
                at = tr_put(b, at, (&t_h[0 as usize]) as u64)
                at = tr_num(b, at, node_h(i))
                __mmio_write8((b + at) as *mut u8, 10 as u8)
                let _w: u64 = lineout.add_bytes(b, at + 1)
            }
        }
        i = i + 1
    }
}

fn frameless() -> bool {
    if fuiapp.plain() != 0 {
        return true
    }
    let h: u64 = handle()
    return wlibc.win_info(h, wlibc.WI_INX) == 0 && wlibc.win_info(h, wlibc.WI_INY) == 0
}

fn org_x() -> u64 {
    if frameless() {
        return 0
    }
    return 2
}

fn org_y() -> u64 {
    if frameless() {
        return 0
    }
    return 22
}

static mut t_rad: [u8; 22] = "wlib: radius rolle=\0\0\0"

static mut t_radr: [u8; 4] = " r=\0"

static mut t_radt: [u8; 6] = " typ=\0"

fn say_radius_line(rolle: u64, r: u64, typ: u64) {
    let b: u64 = (&s_trb[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&t_rad[0 as usize]) as u64)
    at = tr_num(b, at, rolle)
    at = tr_put(b, at, (&t_radr[0 as usize]) as u64)
    at = tr_num(b, at, r)
    at = tr_put(b, at, (&t_radt[0 as usize]) as u64)
    at = tr_put(b, at, typ)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    let _w: u64 = lineout.add_bytes(b, at + 1)
}

fn say_radii() {
    if !trace_on() {
        return
    }
    let sh: *mut theme.Shape = theme.theme_shape(fuiapp.theme())
    let rbu: u64 = sp((*sh).r_button as u64)
    let rfi: u64 = sp((*sh).r_field as u64)
    let rpa: u64 = sp((*sh).r_panel as u64)
    let rwi: u64 = sp((*sh).r_window as u64)
    var n1: [u8; 7] = "button\0"
    var n2: [u8; 6] = "field\0"
    var n3: [u8; 4] = "tab\0"
    var n4: [u8; 7] = "select\0"
    var n5: [u8; 5] = "card\0"
    var n6: [u8; 5] = "list\0"
    var n7: [u8; 5] = "tile\0"
    var n8: [u8; 7] = "window\0"
    var n9: [u8; 7] = "handle\0"
    say_radius_line(0, rbu, (&n1[0 as usize]) as u64)
    say_radius_line(0, rfi, (&n2[0 as usize]) as u64)
    say_radius_line(0, rbu, (&n3[0 as usize]) as u64)
    say_radius_line(0, rfi, (&n4[0 as usize]) as u64)
    say_radius_line(1, rpa, (&n5[0 as usize]) as u64)
    say_radius_line(1, rfi, (&n6[0 as usize]) as u64)
    say_radius_line(2, rbu, (&n7[0 as usize]) as u64)
    say_radius_line(3, rwi, (&n8[0 as usize]) as u64)
    say_radius_line(4, sp(8), (&n9[0 as usize]) as u64)
}

static mut t_kn: [u8; 16] = "wlib: button x=\0"

static mut t_knr: [u8; 4] = " r=\0"

fn say_knoepfe() {
    if !trace_on() {
        return
    }
    let b: u64 = (&s_trb[0 as usize]) as u64
    let rbu: u64 = sp((*theme.theme_shape(fuiapp.theme())).r_button as u64)
    var i: usize = 0
    while i < scene.scene_count(sc()) {
        if scene.node_kind(sc(), i) == scene.N_WIDGET {
            let e: *mut widget.Widget = scene.node_widget(sc(), i)

            if nk_of(widget.w_kind(e)) == 2 && !scene.node_has_class(sc(), i, fsbase.FTILE_CLS)
                    && !scene.node_has_class(sc(), i, fsbase.FLAT_CLS) {
                var at: u64 = tr_put(b, 0, (&t_kn[0 as usize]) as u64)
                at = tr_num(b, at, node_x(i))
                at = tr_put(b, at, (&t_y[0 as usize]) as u64)
                at = tr_num(b, at, node_y(i))
                at = tr_put(b, at, (&t_w[0 as usize]) as u64)
                at = tr_num(b, at, node_w(i))
                at = tr_put(b, at, (&t_h[0 as usize]) as u64)
                at = tr_num(b, at, node_h(i))
                at = tr_put(b, at, (&t_knr[0 as usize]) as u64)
                at = tr_num(b, at, rbu)
                at = tr_put(b, at, (&t_ax[0 as usize]) as u64)
                at = tr_num(b, at, wlib.win_x(fuiapp.win()) + org_x() + node_x(i))
                at = tr_put(b, at, (&t_ay[0 as usize]) as u64)
                at = tr_num(b, at, wlib.win_y(fuiapp.win()) + org_y() + node_y(i))
                __mmio_write8((b + at) as *mut u8, 10 as u8)
                let _w: u64 = lineout.add_bytes(b, at + 1)
            }
        }
        i = i + 1
    }
}

fn say_texts() {
    if !trace_on() {
        return
    }
    let b: u64 = (&s_trb[0 as usize]) as u64

    var mk: u64 = tr_put(b, 0, (&t_bt[0 as usize]) as u64)
    mk = tr_num(b, mk, wlib.win_x(fuiapp.win()) + org_x())
    mk = tr_put(b, mk, (&t_ay[0 as usize]) as u64)
    mk = tr_num(b, mk, wlib.win_y(fuiapp.win()) + org_y())
    __mmio_write8((b + mk) as *mut u8, 10 as u8)
    let _m: u64 = lineout.add_bytes(b, mk + 1)
    let px: u64 = ui_px()
    let asc: u64 = wlibc.ascent_of(wlibc.F_UI, px)
    var i: usize = 0
    while i < scene.scene_count(sc()) {
        let e: *mut widget.Widget = scene.node_widget(sc(), i)
        var nt: u64 = widget.w_text_len(e) as u64

        if scene.node_kind(sc(), i) == scene.N_WIDGET && widget.w_value(e) >= 57344 && widget.w_value(e) < 63744 {
            nt = 0
        }
        if scene.node_kind(sc(), i) == scene.N_WIDGET && scene.node_has_class(sc(), i, fsbase.FTILE_QUIET_CLS) {
            nt = 0
        }
        if nt > 0 {
            let p: u64 = widget.w_text(e)
            var tw: u64 = wlibc.text_w(wlibc.F_UI, px, p, nt)

            var ow: u64 = tw
            var bw: u64 = 0
            if scene.node_kind(sc(), i) == scene.N_WIDGET && !scene.node_has_class(sc(), i, fsbase.FTILE_CLS) {
                let fpx: f64 = render.field_px(fuiapp.ctx(), e)
                var run0: painter.TextRun = render.text_run_of(fuiapp.ctx(), e, fpx)
                let pz: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
                ow = painter.run_width(pz, &run0, p, nt as usize) as u64
                let sz0: *mut style.StyleSet = widget.w_styleset(e)
                let st0: *mut style.Style = style.styleset_base(sz0)
                let px0: f64 = render.len_of(fuiapp.ctx(), style.resolve_num(sz0, style.SF_PAD_X,
                    (*st0).pad_x as usize,
                    render.def_pad_x(fuiapp.ctx(), widget.w_kind(e))))
                let room: f64 = widget.w_w(e) - 2.0 * px0

                if room > 0.0 && !widget.w_has_art(e) && widget.w_text_lines(e) <= 1 {
                    bw = room as u64
                }
            }
            let one_line: bool = widget.w_text_lines(e) <= 1

            if tw > node_w(i) && node_w(i) > 0 {
                tw = node_w(i)
            }
            var kind: u64 = 1
            var bg: u64 = wlibc.theme(wlibc.T_BG)
            var fgc: u64 = wlibc.theme(wlibc.T_FG)
            var x: u64 = node_x(i)
            if scene.node_kind(sc(), i) == scene.N_WIDGET {
                kind = nk_of(widget.w_kind(e))
                if kind == 2 {
                    bg = wlibc.theme(wlibc.T_BTN)

                    var hq: u64 = 0
                    while hq < fsbase.S.s_nhaupt {
                        if fsbase.S.s_main[(hq) as usize] == scene.node_id(sc(), i) as u64 {
                            bg = wlibc.theme(wlibc.C_ACCENT)
                            fgc = wlibc.theme(wlibc.C_ON_ACCENT)
                        }
                        hq = hq + 1
                    }

                    let sk: u64 = scene.node_id(sc(), i) as u64
                    if fsbase.sg_n > 0 && sk >= fsbase.sg_k0 && sk < fsbase.sg_k0 + fsbase.sg_n && sk - fsbase.sg_k0 == fsbase.sg_sel {
                        bg = wlibc.theme(wlibc.C_ACCENT)
                        fgc = wlibc.theme(wlibc.C_ON_ACCENT)
                    }
                }
                if kind == 4 {
                    bg = wlibc.theme(wlibc.T_ENTRY)
                }
                if kind == 2 || kind == 7 {
                    if scene.node_has_class(sc(), i, fsbase.FTILE_LEFT_CLS) {

                        x = x + sp(18)
                    } else if node_w(i) > tw {
                        x = x + (node_w(i) - tw) / 2
                    }
                }

                if kind == 3 {
                    let fo: *mut theme.Shape = theme.theme_shape(fuiapp.theme())
                    x = x + (wave2.box_side(fuiapp.ctx(), e)
                        + render.len_of(fuiapp.ctx(), (*fo).sp_s)) as u64
                }
            }
            let base: u64 = node_y(i) + (node_h(i) + asc) / 2
            var at: u64 = tr_put(b, 0, (&t_txt[0 as usize]) as u64)
            at = tr_num(b, at, fuiapp.win())
            at = tr_put(b, at, (&t_kind[0 as usize]) as u64)
            at = tr_num(b, at, kind)
            at = tr_put(b, at, (&t_x[0 as usize]) as u64)
            at = tr_num(b, at, x)
            at = tr_put(b, at, (&t_base[0 as usize]) as u64)
            at = tr_num(b, at, base)
            at = tr_put(b, at, (&t_fg[0 as usize]) as u64)
            at = tr_num(b, at, fgc)
            at = tr_put(b, at, (&t_bg[0 as usize]) as u64)
            at = tr_num(b, at, bg)
            at = tr_put(b, at, (&t_tw[0 as usize]) as u64)
            at = tr_num(b, at, tw)
            at = tr_put(b, at, (&t_ax[0 as usize]) as u64)
            at = tr_num(b, at, wlib.win_x(fuiapp.win()) + org_x())
            at = tr_put(b, at, (&t_ay[0 as usize]) as u64)
            at = tr_num(b, at, wlib.win_y(fuiapp.win()) + org_y())
            if one_line && bw > 0 && ow > bw {
                at = tr_put(b, at, (&t_ow[0 as usize]) as u64)
                at = tr_num(b, at, ow)
                at = tr_put(b, at, (&t_bw[0 as usize]) as u64)
                at = tr_num(b, at, bw)
            }
            at = tr_put(b, at, (&t_t[0 as usize]) as u64)
            var j: u64 = 0
            while j < nt && at + 2 < 318 {
                __mmio_write8((b + at) as *mut u8, __mmio_read8((p + j) as *mut u8))
                at = at + 1
                j = j + 1
            }
            __mmio_write8((b + at) as *mut u8, 10 as u8)
            let _w: u64 = lineout.add_bytes(b, at + 1)
        }
        i = i + 1
    }
}

static mut t_nm: [u8; 12] = ": name id=\0\0"

fn say_names(prog: u64) {
    if !trace_on() {
        return
    }
    let b: u64 = (&s_trb[0 as usize]) as u64
    var i: usize = 0
    while i < scene.scene_count(sc()) {
        let e: *mut widget.Widget = scene.node_widget(sc(), i)
        let nt: u64 = widget.w_text_len(e) as u64
        var silent: bool = false
        if scene.node_kind(sc(), i) == scene.N_WIDGET {
            silent = (widget.w_value(e) >= 57344 && widget.w_value(e) < 63744) || scene.node_has_class(sc(), i, fsbase.FTILE_QUIET_CLS)
        }
        if nt > 0 && silent {
            let p: u64 = widget.w_text(e)
            var at: u64 = tr_put(b, 0, prog)
            at = tr_put(b, at, (&t_nm[0 as usize]) as u64)
            at = tr_num(b, at, scene.node_id(sc(), i) as u64)
            at = tr_put(b, at, (&t_t[0 as usize]) as u64)
            var j: u64 = 0
            while j < nt && at + 2 < 318 {
                __mmio_write8((b + at) as *mut u8, __mmio_read8((p + j) as *mut u8))
                at = at + 1
                j = j + 1
            }
            __mmio_write8((b + at) as *mut u8, 10 as u8)
            let _w: u64 = lineout.add_bytes(b, at + 1)
        }
        i = i + 1
    }
}

fn tint_col(word: u64) -> u32 {
    let rgb: u64 = (word >> 32) & 16777215
    let sw: u64 = ((rgb & 255) << 16) | (rgb & 65280) | ((rgb >> 16) & 255)
    return (sw as u32) | 4278190080 as u32
}

fn mid_base(top: u64, h: u64, px: u64) -> u64 {
    return top + (h * 500 + px * 318 + 500) / 1000
}

fn heat_bar(on: bool) {
    fsbase.heat_bar_on = on
}

fn heat_key(key: u64, c0: u64, c1: u64) {
    fsbase.heat_k = key
    fsbase.heat_c0 = c0
    fsbase.heat_c1 = c1
}

fn heat_set(row: u64, j: u64, v: u64) {
    if row < 64 && j < 2 {
        fsbase.heat_v[(row * 2 + j) as usize] = v
    }
}

fn heat_clear() {
    var i: u64 = 0
    while i < 128 {
        fsbase.heat_v[(i) as usize] = 0
        i = i + 1
    }
}

static mut s_tipl: [u8; 24] = "fuiscene: tip key=\0\0\0\0\0\0"

static mut s_tipt: [u8; 8] = " text=\0\0"

fn say_tips() {
    var k: u64 = 0
    while k < fsbase.tip_n {
        let b: u64 = (&s_trb[0 as usize]) as u64
        var at: u64 = tr_put(b, 0, (&s_tipl[0 as usize]) as u64)
        at = tr_num(b, at, fsbase.tip_keys[(k) as usize])
        at = tr_put(b, at, (&s_tipt[0 as usize]) as u64)
        let p: u64 = fsbase.tip_txts[(k) as usize]
        var j: u64 = 0
        while *((p + j) as *mut u8) != 0 as u8 && at + 2 < 300 {
            *((b + at) as *mut u8) = *((p + j) as *mut u8)
            at = at + 1
            j = j + 1
        }
        *((b + at) as *mut u8) = 10 as u8
        let _w: u64 = lineout.add_bytes(b, at + 1)
        k = k + 1
    }
}

fn row_head(k: u64, ri: u64) -> bool {
    let a: u64 = fsbase.S.s_ct_heads[(k) as usize]
    if a == 0 || ri >= 4096 {
        return false
    }
    return __mmio_read8((a + ri) as *mut u8) == 1 as u8
}

fn row_level(k: u64, ri: u64) -> u64 {
    let a: u64 = fsbase.S.s_ct_indent[(k) as usize]
    if a == 0 || ri >= 4096 {
        return 0
    }
    return __mmio_read8((a + ri) as *mut u8) as u64
}

fn skip_head(k: u64, sel: u64, rows: u64, up: bool) -> u64 {
    var r: u64 = sel
    if up {
        while r > 0 && row_head(k, r) {
            r = r - 1
        }
        if !row_head(k, r) {
            return r
        }
        r = sel
    }
    while r + 1 < rows && row_head(k, r) {
        r = r + 1
    }
    return r
}

static mut s_fit: [u8; 272] = [0 as u8; 272]

static mut s_dots: [u8; 4] = "...\0"

fn fit_cell(p: u64, avail: u64, px: u64) -> u64 {
    let n: u64 = text.length(p)
    if n == 0 || n > 255 || avail < sp(24) {
        return p
    }
    if wlibc.text_w(wlibc.F_UI, px, p, n) <= avail {
        return p
    }
    let dw: u64 = wlibc.text_w(wlibc.F_UI, px, (&s_dots[0 as usize]) as u64, 3)
    var k: u64 = n
    while k > 0 {
        k = k - 1

        if (__mmio_read8((p + k) as *mut u8) & 192 as u8) != 128 as u8
            && wlibc.text_w(wlibc.F_UI, px, p, k) + dw <= avail {
            var j: u64 = 0
            while j < k {
                s_fit[(j) as usize] = __mmio_read8((p + j) as *mut u8)
                j = j + 1
            }
            s_fit[(k) as usize] = 46 as u8
            s_fit[(k + 1) as usize] = 46 as u8
            s_fit[(k + 2) as usize] = 46 as u8
            s_fit[(k + 3) as usize] = 0 as u8
            return (&s_fit[0 as usize]) as u64
        }
    }
    return p
}

const CUR_MAX: u64 = 16

fn cursor_for(key: u64, shape: u64) {
    wlibc.cursor_scene_mode()
    var i: u64 = 0
    while i < fsbase.cur_n {
        if fsbase.cur_key[(i) as usize] == key {
            fsbase.cur_shp[(i) as usize] = shape
            return
        }
        i = i + 1
    }
    if fsbase.cur_n < CUR_MAX {
        fsbase.cur_key[(fsbase.cur_n) as usize] = key
        fsbase.cur_shp[(fsbase.cur_n) as usize] = shape
        fsbase.cur_n = fsbase.cur_n + 1
    }
}

fn ROW_H() -> u64 {
    return sp(28)
}

fn ROW2_H() -> u64 {
    return sp(52)
}

fn ICON_W() -> u64 {
    return sp(30)
}

fn HEAD_H() -> u64 {
    return sp(28)
}

const SELB: u64 = 512

fn SB_W() -> u64 {
    return sp(8)
}

fn tpad(rh: u64) -> u64 {
    if rh > sp(24) {
        return (rh - sp(24)) / 2
    }
    return 0
}

fn colw_total(k: u64) -> u64 {
    var total: u64 = 0
    var c: u64 = 0
    while c < fsbase.S.s_ct_cols[(k) as usize] {
        total = total + fsbase.S.s_ct_colw[(k * fsbase.CT_COLS + c) as usize]
        c = c + 1
    }
    return total
}

fn colw_share(k: u64, col: u64, avail: u64, total: u64) -> u64 {
    let cols: u64 = fsbase.S.s_ct_cols[(k) as usize]
    if col + 1 < cols {
        return fsbase.S.s_ct_colw[(k * fsbase.CT_COLS + col) as usize] * avail / total
    }
    var used: u64 = 0
    var c: u64 = 0
    while c < col {
        used = used + fsbase.S.s_ct_colw[(k * fsbase.CT_COLS + c) as usize] * avail / total
        c = c + 1
    }
    if avail > used {
        return avail - used
    }
    return 1
}

fn colw_of(k: u64, col: u64, nw: u64) -> u64 {
    let v: u64 = fsbase.S.s_ct_colw[(k * fsbase.CT_COLS + col) as usize]
    if fsbase.S.s_ct_prop[(k) as usize] && nw > 2 && fsbase.S.s_ct_cols[(k) as usize] > 0 {
        let total: u64 = colw_total(k)
        if total > 0 {
            return colw_share(k, col, nw - 2, total)
        }
    }
    if v > 0 {
        return v
    }
    if nw <= 2 || fsbase.S.s_ct_cols[(k) as usize] == 0 {
        return 1
    }
    return (nw - 2) / fsbase.S.s_ct_cols[(k) as usize]
}

fn no_get(row: u64, col: u64) -> u64 {
    return (&fsbase.s_empty[0 as usize]) as u64
}

fn room_of(w: u64, cut: u64) -> u64 {
    if w > cut {
        return w - cut
    }
    return 1
}

fn row_icon(word: u64, x: u64, y: u64, rh: u64, txt: u64, on: bool) {
    if word == 0 {
        return
    }
    let z: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
    let t: *mut theme.Colors = theme.theme_colors(fuiapp.theme())
    var tile: u64 = sp(22)
    if rh >= sp(44) {
        tile = sp(32)
    }

    if fsbase.row_tile_px != 0 {
        tile = sp(fsbase.row_tile_px)
    }
    if tile > rh {
        tile = rh
    }
    let ty: u64 = y + (rh - tile) / 2
    if (word & wlib.ICON_TAG) != 0 {
        var col: u32 = (*t).text | 4278190080 as u32
        if (word & 72057594037927936) != 0 {
            col = tint_col(word)
        } else if on {
            col = (*t).selection_text | 4278190080 as u32
        }
        fuiapp.glyph(word & 65535, x + sp(1), ty, tile, col)
        return
    }
    if wlib.is_image_pub(word) {
        let src: u64 = symvar.pick(word, tile)
        let iw: u64 = __mmio_read32((src + 4) as *mut u32) as u64
        let ih: u64 = __mmio_read32((src + 8) as *mut u32) as u64
        if iw == 0 || ih == 0 || iw > 128 || ih > 128 {
            return
        }
        var sc: u64 = tile / iw
        let sy: u64 = tile / ih
        if sy < sc {
            sc = sy
        }
        if sc == 0 {
            sc = 1
        }
        var dw: u64 = iw * sc
        var dh: u64 = ih * sc

        var shift: u64 = 0
        if iw >= 32 && ih >= 32 {
            dw = tile
            dh = tile
            shift = sp(4)
        }
        var ox: u64 = 0
        if tile > dw {
            ox = (tile - dw) / 2
        }
        var oy: u64 = 0
        if tile > dh {
            oy = (tile - dh) / 2
        }
        var im: uiimage.Image = uiimage.image_wrap(src + 12, iw as usize,
            ih as usize, 0)
        uiimage.image_draw_rect(z, &im, (x + 1 + ox + shift) as f64,
            (ty + oy) as f64, dw as f64, dh as f64, 0 as u32)
        return
    }

    let rgb: u32 = (((word & 255) << 16) | (word & 65280) | ((word >> 16) & 255)) as u32
    painter.round_rect(z, (x + 1) as f64, ty as f64, tile as f64, tile as f64,
        rb(), rgb | 4278190080 as u32)
    if txt != 0 {
        var one: [u8; 2] = [0 as u8; 2]
        one[0 as usize] = __mmio_read8(txt as *mut u8)
        if one[0 as usize] != 0 as u8 {
            text_tok(x + sp(8), ty - 1, sp(16), (&one[0 as usize]) as u64,
                style.TOK_TEXT_ON_ACCENT)
        }
    }
}

fn two_text(x: u64, base: u64, w: u64, p: u64, size: u64, bold: bool,
    col: u32) {
    let n: u64 = text.length(p)
    if n == 0 {
        return
    }
    let z: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
    let old: u64 = painter.painter_font(z)
    var f: u64 = wlibc.F_UI
    if bold {
        f = wlibc.F_BOLD
        let bf: u64 = fuiglyph.fontset(fuiglyph.ROLE_BOLD)
        if bf != 0 {
            painter.painter_set_font(z, bf)
        }
    }

    var k: u64 = 0
    while k < n {
        let lead: u64 = __mmio_read8((p + k) as *mut u8) as u64
        var l: u64 = 1
        if lead >= 240 {
            l = 4
        } else if lead >= 224 {
            l = 3
        } else if lead >= 192 {
            l = 2
        }
        if k + l > n {
            l = n - k
        }
        let gx: u64 = x + wlibc.pen_x(f, size, p, n, k)
        if gx < x + w {
            let _w: f64 = painter.text(z, gx as f64, base as f64,
                (x + w - gx) as f64, size as f64, col, p + k, l as usize,
                painter.TEXT_L)
        }
        k = k + l
    }
    painter.painter_set_font(z, old)
}

fn rgb_of(c: u32) -> u64 {
    let v: u64 = c as u64
    return ((v & 255) << 16) | (v & 65280) | ((v >> 16) & 255)
}

static mut t_txt2: [u8; 18] = "wlib: text2 win=\0\0"

static mut t_pxk: [u8; 6] = " px=\0\0"

fn say_text2(x: u64, base: u64, fg: u32, bg: u32, px: u64, p: u64) {
    let n: u64 = text.length(p)
    if n == 0 {
        return
    }
    let b: u64 = (&s_trb[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&t_txt2[0 as usize]) as u64)
    at = tr_num(b, at, fuiapp.win())
    at = tr_put(b, at, (&t_kind[0 as usize]) as u64)
    at = tr_num(b, at, 5)
    at = tr_put(b, at, (&t_x[0 as usize]) as u64)
    at = tr_num(b, at, x)
    at = tr_put(b, at, (&t_base[0 as usize]) as u64)
    at = tr_num(b, at, base)
    at = tr_put(b, at, (&t_fg[0 as usize]) as u64)
    at = tr_num(b, at, rgb_of(fg))
    at = tr_put(b, at, (&t_bg[0 as usize]) as u64)
    at = tr_num(b, at, rgb_of(bg))
    at = tr_put(b, at, (&t_tw[0 as usize]) as u64)
    at = tr_num(b, at, wlibc.text_w(wlibc.F_UI, px, p, n))
    at = tr_put(b, at, (&t_ax[0 as usize]) as u64)
    at = tr_num(b, at, wlib.win_x(fuiapp.win()) + org_x())
    at = tr_put(b, at, (&t_ay[0 as usize]) as u64)
    at = tr_num(b, at, wlib.win_y(fuiapp.win()) + org_y())
    at = tr_put(b, at, (&t_pxk[0 as usize]) as u64)
    at = tr_num(b, at, px)
    at = tr_put(b, at, (&t_t[0 as usize]) as u64)
    var j: u64 = 0
    while j < n && at + 2 < 318 {
        __mmio_write8((b + at) as *mut u8, __mmio_read8((p + j) as *mut u8))
        at = at + 1
        j = j + 1
    }
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    let _w: u64 = lineout.add_bytes(b, at + 1)
}

fn sat_sub(a: u64, b: u64) -> u64 {
    if a < b {
        return 0
    }
    return a - b
}

fn rs_drag(x: u64) {
    let k: u64 = fsbase.rs_k
    var w0: u64 = fsbase.rs_w0
    var w1: u64 = fsbase.rs_w1
    let lo: u64 = sp(48)
    if x >= fsbase.rs_x0 {
        var d: u64 = x - fsbase.rs_x0
        if w1 < lo + d {
            d = 0
            if w1 > lo {
                d = w1 - lo
            }
        }
        w0 = w0 + d
        w1 = w1 - d
    } else {
        var d2: u64 = fsbase.rs_x0 - x
        if w0 < lo + d2 {
            d2 = 0
            if w0 > lo {
                d2 = w0 - lo
            }
        }
        w0 = w0 - d2
        w1 = w1 + d2
    }
    fsbase.S.s_ct_colw[(k * fsbase.CT_COLS + fsbase.rs_col) as usize] = w0
    fsbase.S.s_ct_colw[(k * fsbase.CT_COLS + fsbase.rs_col + 1) as usize] = w1
    touch()
}

fn rs_end() {
    if fsbase.rs_k != fsbase.NO_SLOT {
        fsbase.rs_k = fsbase.NO_SLOT
        fsbase.rs_seq = fsbase.rs_seq + 1
    }
}

fn ctb(k: u64, r: u64) -> bool {
    if r >= 4096 {
        return false
    }
    let byte: u64 = __mmio_read8(((&fsbase.S.s_ct_bits[0 as usize]) as u64 + k * SELB + r / 8) as *mut u8) as u64
    return (byte & (1 << (r % 8))) != 0
}

fn ctb_set(k: u64, r: u64, on: bool) {
    if r >= 4096 {
        return
    }
    let at: u64 = (&fsbase.S.s_ct_bits[0 as usize]) as u64 + k * SELB + r / 8
    var byte: u64 = __mmio_read8(at as *mut u8) as u64
    if on {
        byte = byte | (1 << (r % 8))
    } else {
        byte = byte & ~(1 << (r % 8))
    }
    __mmio_write8(at as *mut u8, byte as u8)
}

fn ctb_clear(k: u64) {
    var n: u64 = 0
    while n < SELB {
        __mmio_write8(((&fsbase.S.s_ct_bits[0 as usize]) as u64 + k * SELB + n) as *mut u8, 0 as u8)
        n = n + 1
    }
}

fn ctb_range(k: u64, a: u64, b: u64) {
    var lo: u64 = a
    var hi: u64 = b
    if lo > hi {
        lo = b
        hi = a
    }
    ctb_clear(k)
    var r: u64 = lo
    while r <= hi && r < fsbase.S.s_ct_rows[(k) as usize] {
        ctb_set(k, r, true)
        r = r + 1
    }
}

fn ctb_count(k: u64) -> u64 {
    var n: u64 = 0
    var r: u64 = 0
    let rows: u64 = fsbase.S.s_ct_rows[(k) as usize]
    while r < rows && r < 4096 {
        if ctb(k, r) {
            n = n + 1
        }
        r = r + 1
    }
    return n
}

fn key_free_seq() -> u64 {
    return fsbase.S.s_fseq
}

fn key_free() -> u64 {
    return fsbase.S.s_fkey
}

const R_SUCCESS: u64 = 3

const R_WARN: u64 = 8

const R_ERR: u64 = 9

fn role_col(r: u64) -> u32 {
    let t: *mut theme.Colors = theme.theme_colors(fuiapp.theme())
    var c: u32 = (*t).field
    if r == fsbase.R_BORDER {
        c = (*t).border_col
    } else if r == fsbase.R_ACCENT {
        c = (*t).accent
    } else if r == R_SUCCESS {
        c = (*t).success
    } else if r == fsbase.R_TEXT {
        c = (*t).text
    } else if r == fsbase.R_MUTED {
        c = (*t).text_muted
    } else if r == fsbase.R_SURFACE {
        c = (*t).surface
    } else if r == R_WARN {
        c = (*t).warning
    } else if r == R_ERR {
        c = (*t).err_col
    }
    return c | 4278190080 as u32
}

fn cv_graph(x: u64, y: u64, w: u64, h: u64, hist: u64, n: u64, line: u64) {
    let lc: u32 = role_col(line)
    navkit.paint_graph(render.ctx_painter(fuiapp.ctx()), x, y, w, h, hist, n, lc,
        (lc & 16777215 as u32) | 1073741824 as u32, role_col(fsbase.R_BORDER))
}

fn say_cv_text(x: u64, base: u64, fg_role: u64, bg_role: u64, px: u64, p: u64) {
    if !trace_on() || p == 0 {
        return
    }
    let n: u64 = text.length(p)
    if n == 0 {
        return
    }
    let b: u64 = (&s_trb[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&t_txt[0 as usize]) as u64)
    at = tr_num(b, at, fuiapp.win())
    at = tr_put(b, at, (&t_kind[0 as usize]) as u64)
    at = tr_num(b, at, 1)
    at = tr_put(b, at, (&t_x[0 as usize]) as u64)
    at = tr_num(b, at, x)
    at = tr_put(b, at, (&t_base[0 as usize]) as u64)
    at = tr_num(b, at, base)
    at = tr_put(b, at, (&t_fg[0 as usize]) as u64)
    at = tr_num(b, at, rgb_of(role_col(fg_role)))
    at = tr_put(b, at, (&t_bg[0 as usize]) as u64)
    at = tr_num(b, at, rgb_of(role_col(bg_role)))
    at = tr_put(b, at, (&t_tw[0 as usize]) as u64)
    at = tr_num(b, at, wlibc.text_w(wlibc.F_UI, px, p, n))
    at = tr_put(b, at, (&t_ax[0 as usize]) as u64)
    at = tr_num(b, at, wlib.win_x(fuiapp.win()) + org_x())
    at = tr_put(b, at, (&t_ay[0 as usize]) as u64)
    at = tr_num(b, at, wlib.win_y(fuiapp.win()) + org_y())
    at = tr_put(b, at, (&t_t[0 as usize]) as u64)
    var j: u64 = 0
    while j < n && at + 2 < 318 {
        __mmio_write8((b + at) as *mut u8, __mmio_read8((p + j) as *mut u8))
        at = at + 1
        j = j + 1
    }
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    let _w: u64 = lineout.add_bytes(b, at + 1)
}

fn cv_rect(x: u64, y: u64, w: u64, h: u64, role: u64) {
    painter.surface(render.ctx_painter(fuiapp.ctx()), x as f64, y as f64,
        w as f64, h as f64, role_col(role))
}

fn cv_rgb(x: u64, y: u64, w: u64, h: u64, rgb: u64) {

    let sw: u64 = ((rgb & 0xFF) << 16) | (rgb & 0xFF00) | ((rgb >> 16) & 0xFF)
    painter.surface(render.ctx_painter(fuiapp.ctx()), x as f64, y as f64,
        w as f64, h as f64, (sw as u32) | 4278190080 as u32)
}

fn cv_round(x: u64, y: u64, w: u64, h: u64, r: u64, role: u64) {
    painter.round_rect(render.ctx_painter(fuiapp.ctx()), x as f64, y as f64,
        w as f64, h as f64, r as f64, role_col(role))
}

fn cv_ring(x: u64, y: u64, w: u64, h: u64, r: u64, role: u64) {
    painter.round_ring(render.ctx_painter(fuiapp.ctx()), x as f64, y as f64,
        w as f64, h as f64, r as f64, 1.0, role_col(role))
}

fn cv_text(x: u64, y: u64, w: u64, p: u64, role: u64) {
    var tok: u32 = style.TOK_TEXT
    if role == fsbase.R_MUTED {
        tok = style.TOK_TEXT_MUTED
    } else if role == fsbase.R_ONFILL {
        tok = style.TOK_TEXT_ON_ACCENT
    }
    text_tok(x, y, w, p, tok)
}

fn cv_fn_slot(k: u64) -> *mut fn(u64, u64, u64, u64) {
    return (((&fsbase.S.s_cv_fn[0 as usize]) as u64) + k * 8) as *mut fn(u64, u64, u64, u64)
}

fn cv_round_rgb(x: u64, y: u64, w: u64, h: u64, r: u64, rgb: u64) {
    let z: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
    let c: u32 = (((rgb & 255) << 16) | (rgb & 65280) | ((rgb >> 16) & 255)) as u32
    painter.round_rect(z, x as f64, y as f64, w as f64, h as f64, r as f64,
        c | 4278190080 as u32)
}

fn cv_round_a(x: u64, y: u64, w: u64, h: u64, r: u64, rgb: u64, alpha: u64) {
    let z: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
    let c: u32 = (((rgb & 255) << 16) | (rgb & 65280) | ((rgb >> 16) & 255)) as u32
    painter.round_rect(z, x as f64, y as f64, w as f64, h as f64, r as f64,
        c | ((alpha & 255) << 24) as u32)
}

fn cv_ring_a(x: u64, y: u64, w: u64, h: u64, r: u64, t: u64, rgb: u64, alpha: u64) {
    let z: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
    let c: u32 = (((rgb & 255) << 16) | (rgb & 65280) | ((rgb >> 16) & 255)) as u32
    painter.round_ring(z, x as f64, y as f64, w as f64, h as f64, r as f64,
        t as f64, c | ((alpha & 255) << 24) as u32)
}

fn cv_round_raw(x: u64, y: u64, w: u64, h: u64, r: u64, c: u32) {
    painter.round_rect(render.ctx_painter(fuiapp.ctx()), x as f64, y as f64, w as f64, h as f64, r as f64, c)
}

fn cv_ring_raw(x: u64, y: u64, w: u64, h: u64, r: u64, t: u64, c: u32) {
    painter.round_ring(render.ctx_painter(fuiapp.ctx()), x as f64, y as f64, w as f64, h as f64, r as f64,
        t as f64, c)
}

fn cv_ring_rgb(x: u64, y: u64, w: u64, h: u64, r: u64, t: u64, rgb: u64) {
    let z: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
    let c: u32 = (((rgb & 255) << 16) | (rgb & 65280) | ((rgb >> 16) & 255)) as u32
    painter.round_ring(z, x as f64, y as f64, w as f64, h as f64, r as f64,
        t as f64, c | 4278190080 as u32)
}

fn cv_text_rgb(x: u64, base: u64, w: u64, p: u64, size: u64, bold: bool,
    rgb: u64) {
    let c: u32 = (((rgb & 255) << 16) | (rgb & 65280) | ((rgb >> 16) & 255)) as u32
    two_text(x, base, w, p, size, bold, c | 4278190080 as u32)
}

fn label_wrap(parent: usize, text: u64, lines: u64) -> usize {
    let i: usize = scene.scene_add(sc(), parent, scene.N_TEXT)
    if i != scene.SCENE_NONE {
        scene.node_set_size(sc(), i, 0.0, 24.0)
        scene.node_set_text(sc(), i, text, text.length(text) as usize)
        scene.node_set_text_wrap(sc(), i, lines as usize)
    }
    return i
}

fn label_muted(parent: usize, text: u64) -> usize {
    let i: usize = label(parent, text)
    if i != fsbase.NONE {
        let _r: usize = sheet.sheet_rule(sh(), sheet.sel_id(1000 + i as u32),
            style.style_set_fg(style.style_new(),
                style.color_token(style.TOK_TEXT_MUTED)))
        scene.node_set_id(sc(), i, (1000 + i) as u32)
    }
    return i
}

fn label_heading(parent: usize, text: u64) -> usize {
    let i: usize = label(parent, text)
    if i != fsbase.NONE {
        scene.node_set_size(sc(), i, 0.0, 32.0)
        let st: style.Style = style.style_set_weight(style.style_set_font(style.style_new(), 0, 20), 700)
        let _r: usize = sheet.sheet_rule(sh(), sheet.sel_id(1000 + i as u32), st)
        scene.node_set_id(sc(), i, (1000 + i) as u32)
    }
    return i
}

fn focus_canvas() {
    wlib.set_focus(fuiapp.cv())
}
