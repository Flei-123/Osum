profile kernel

import ulib

export { u_start }

const SYS_NETGET: u64 = 1300
const NG_READY: u64 = 0
const NG_LINK: u64 = 13
const NG_SPEED: u64 = 14
const NG_CARDTX: u64 = 15
const NG_CARDRX: u64 = 16

fn rate_aus(alt: u64, neu: u64, dt: u64) -> u64 {
    if dt == 0 {
        return 0
    }
    if neu < alt {
        return 0
    }
    return (neu - alt) * 100 / dt
}

static mut zeile: [u8; 256] = [0 as u8; 256]

const MAXS: u64 = 64
static mut m_tx: [u64; 64] = [0 as u64; 64]
static mut m_rx: [u64; 64] = [0 as u64; 64]
static mut m_rtx: [u64; 64] = [0 as u64; 64]
static mut m_rrx: [u64; 64] = [0 as u64; 64]

fn an(at: u64, q: u64) -> u64 {
    let d: u64 = (&zeile[0 as usize]) as u64
    var k: u64 = 0
    while __mmio_read8((q + k) as *mut u8) != 0 as u8 {
        __mmio_write8((d + at + k) as *mut u8, __mmio_read8((q + k) as *mut u8))
        k = k + 1
    }
    return at + k
}

fn anz(at: u64, v: u64) -> u64 {
    let d: u64 = (&zeile[0 as usize]) as u64
    if v == 0 {
        __mmio_write8((d + at) as *mut u8, 48 as u8)
        return at + 1
    }
    var st: u64 = 0
    var t: u64 = v
    while t > 0 {
        st = st + 1
        t = t / 10
    }
    var k: u64 = st
    t = v
    while k > 0 {
        k = k - 1
        __mmio_write8((d + at + k) as *mut u8, (48 + (t % 10)) as u8)
        t = t / 10
    }
    return at + st
}

fn raus(at: u64) {
    let d: u64 = (&zeile[0 as usize]) as u64
    __mmio_write8((d + at) as *mut u8, 10 as u8)
    let _w: u64 = ulib.put(d, at + 1)
}

fn hole(was: u64) -> u64 {
    let v: u64 = ulib.sys(SYS_NETGET, was, 0, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

fn u_start(args: u64) -> u64 {
    var s_kopf: [u8; 16] = "netmeter: start\0"
    var s_link: [u8; 7] = " link=\0"
    var s_speed: [u8; 8] = " speed=\0"
    var s_zeile: [u8; 13] = "netmeter: t=\0"
    var s_tx: [u8; 5] = " tx=\0"
    var s_rx: [u8; 5] = " rx=\0"
    var s_rtx: [u8; 6] = " rtx=\0"
    var s_rrx: [u8; 6] = " rrx=\0"
    var s_ende: [u8; 20] = "netmeter: done dtx=\0"
    var s_drx: [u8; 6] = " drx=\0"
    var s_max: [u8; 7] = " maxr=\0"

    var sek: u64 = 12
    if ulib.arg_count(args) > 1 {
        sek = ulib.to_num(ulib.arg_at(args, 1))
        if sek == 0 || sek > 120 {
            sek = 12
        }
    }

    var ah: u64 = an(0, (&s_kopf[0 as usize]) as u64)
    ah = an(ah, (&s_link[0 as usize]) as u64)
    ah = anz(ah, hole(NG_LINK))
    ah = an(ah, (&s_speed[0 as usize]) as u64)
    ah = anz(ah, hole(NG_SPEED))
    raus(ah)

    let tx0: u64 = hole(NG_CARDTX)
    let rx0: u64 = hole(NG_CARDRX)
    var vor_tx: u64 = tx0
    var vor_rx: u64 = rx0
    var vor_t: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    var maxr: u64 = 0
    var i: u64 = 0
    while i < sek {
        let bis: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0) + 100
        while ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0) < bis {
            let _p: u64 = 0
        }
        let tx: u64 = hole(NG_CARDTX)
        let rx: u64 = hole(NG_CARDRX)
        let t: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
        let dt: u64 = t - vor_t
        let rtx: u64 = rate_aus(vor_tx, tx, dt)
        let rrx: u64 = rate_aus(vor_rx, rx, dt)
        if rrx > maxr {
            maxr = rrx
        }
        if i < MAXS {
            m_tx[(i) as usize] = tx
            m_rx[(i) as usize] = rx
            m_rtx[(i) as usize] = rtx
            m_rrx[(i) as usize] = rrx
        }
        vor_tx = tx
        vor_rx = rx
        vor_t = t
        i = i + 1
    }
    var k: u64 = 0
    while k < sek && k < MAXS {
        var a: u64 = an(0, (&s_zeile[0 as usize]) as u64)
        a = anz(a, k)
        a = an(a, (&s_tx[0 as usize]) as u64)
        a = anz(a, m_tx[(k) as usize])
        a = an(a, (&s_rx[0 as usize]) as u64)
        a = anz(a, m_rx[(k) as usize])
        a = an(a, (&s_rtx[0 as usize]) as u64)
        a = anz(a, m_rtx[(k) as usize])
        a = an(a, (&s_rrx[0 as usize]) as u64)
        a = anz(a, m_rrx[(k) as usize])
        raus(a)
        k = k + 1
    }
    var af: u64 = an(0, (&s_ende[0 as usize]) as u64)
    af = anz(af, vor_tx - tx0)
    af = an(af, (&s_drx[0 as usize]) as u64)
    af = anz(af, vor_rx - rx0)
    af = an(af, (&s_max[0 as usize]) as u64)
    af = anz(af, maxr)
    raus(af)
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
