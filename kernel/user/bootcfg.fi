profile kernel

import ulib
import product

export {
    efi_dir, efi_kernel, efi_loader, single_text, dual_text, foreign_text,
    KIND_INSTALLER, KIND_CLI
}

const KIND_INSTALLER: u64 = 0
const KIND_CLI: u64 = 1

static mut b_dir: [u8; 96] = [0 as u8; 96]
static mut b_kernel: [u8; 128] = [0 as u8; 128]
static mut b_loader: [u8; 128] = [0 as u8; 128]
static mut b_text: [u8; 1024] = [0 as u8; 1024]

static mut s_efi_base: [u8; 10] = "/efi/EFI/\0"
static mut s_kernel_leaf: [u8; 9] = "/osum.mb\0"
static mut s_loader_leaf: [u8; 13] = "/BOOTX64.EFI\0"
static mut s_head: [u8; 31] = "timeout: 5\ndefault_entry: 1\n\n/\0"
static mut s_proto: [u8; 45] = "\n    protocol: multiboot1\n    path: boot():/\0"
static mut s_efi_dir: [u8; 5] = "EFI/\0"
static mut s_kernel_name: [u8; 8] = "osum.mb\0"
static mut s_slash_kernel: [u8; 9] = "/osum.mb\0"
static mut s_cmd_key: [u8; 15] = "\n    cmdline: \0"
static mut s_cmd_installer: [u8; 206] = "osum vfs gfx disp audio wm wig desk wmshell nobootterm wmdauer absturzhalt nopuls tz=60 tzrule=eu usb hidgen nic nip=169.254.10.1/16 nsvc=0 nwait=0 dhcp jarvis nosched noproc nofs anmeldung absturzneustart\0"
static mut s_cmd_cli: [u8; 82] = "osum vfs gfx wm wig desk wmshell wmdauer herz tz=60 tzrule=eu nosched noproc nofs\0"
static mut s_end: [u8; 2] = "\n\0"
static mut s_foreign: [u8; 102] = "\n/Windows Boot Manager\n    protocol: efi_chainload\n    path: boot():/EFI/Microsoft/Boot/bootmgfw.efi\n\0"

fn put(dst: u64, at: u64, source: u64) -> u64 {
    return at + ulib.strcpy(dst + at, source)
}

fn efi_dir() -> u64 {
    var at: u64 = put((&b_dir[0 as usize]) as u64, 0, (&s_efi_base[0 as usize]) as u64)
    put((&b_dir[0 as usize]) as u64, at, product.slug())
    return (&b_dir[0 as usize]) as u64
}

fn efi_kernel() -> u64 {
    var at: u64 = put((&b_kernel[0 as usize]) as u64, 0, efi_dir())
    put((&b_kernel[0 as usize]) as u64, at, (&s_slash_kernel[0 as usize]) as u64)
    return (&b_kernel[0 as usize]) as u64
}

fn efi_loader() -> u64 {
    var at: u64 = put((&b_loader[0 as usize]) as u64, 0, efi_dir())
    put((&b_loader[0 as usize]) as u64, at, (&s_loader_leaf[0 as usize]) as u64)
    return (&b_loader[0 as usize]) as u64
}

fn entry_head(at: u64) -> u64 {
    var p: u64 = put((&b_text[0 as usize]) as u64, at, (&s_head[0 as usize]) as u64)
    p = put((&b_text[0 as usize]) as u64, p, product.product())
    return put((&b_text[0 as usize]) as u64, p, (&s_proto[0 as usize]) as u64)
}

fn entry_tail(at: u64, kind: u64) -> u64 {
    var p: u64 = put((&b_text[0 as usize]) as u64, at, (&s_cmd_key[0 as usize]) as u64)
    if kind == KIND_CLI {
        p = put((&b_text[0 as usize]) as u64, p, (&s_cmd_cli[0 as usize]) as u64)
    } else {
        p = put((&b_text[0 as usize]) as u64, p, (&s_cmd_installer[0 as usize]) as u64)
    }
    return put((&b_text[0 as usize]) as u64, p, (&s_end[0 as usize]) as u64)
}

fn single_text() -> u64 {
    var p: u64 = entry_head(0)
    p = put((&b_text[0 as usize]) as u64, p, (&s_kernel_name[0 as usize]) as u64)
    entry_tail(p, KIND_INSTALLER)
    return (&b_text[0 as usize]) as u64
}

fn dual_text(kind: u64) -> u64 {
    var p: u64 = entry_head(0)
    p = put((&b_text[0 as usize]) as u64, p, (&s_efi_dir[0 as usize]) as u64)
    p = put((&b_text[0 as usize]) as u64, p, product.slug())
    p = put((&b_text[0 as usize]) as u64, p, (&s_slash_kernel[0 as usize]) as u64)
    entry_tail(p, kind)
    return (&b_text[0 as usize]) as u64
}

fn foreign_text() -> u64 {
    return (&s_foreign[0 as usize]) as u64
}
