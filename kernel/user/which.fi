// kernel/user/which.fi -- Runde K11: wo ein Befehl liegt.
//
// Dieses System hat kein $PATH -- die Shell haengt `/bin/` vor einen
// Namen ohne Schraegstrich (`sh.fi`, `make_path`), und das ist der ganze
// Suchpfad. `which` sagt also dasselbe: liegt `/bin/NAME` da, ist das die
// Antwort; ein Name MIT Schraegstrich wird so genommen, wie er dasteht.
//
// Der Beendigungscode ist der von POSIX: 0, wenn ALLE gefunden wurden,
// sonst die Anzahl der nicht gefundenen -- gedeckelt auf 1, wie GNU.

profile kernel

import ulib
import tools

export { u_start }

static mut full: [u8; 160] = [0 as u8; 160]

fn u_start(args: u64) -> u64 {
    var s_bin: [u8; 6] = "/bin/\0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        return 1
    }
    var missing: u64 = 0
    var k: u64 = 1
    while k < argc {
        let name: u64 = ulib.arg_at(args, k)
        var p: u64 = name
        if tools.last_slash(name) == ulib.EOF {
            ulib.strcpy((&full[0 as usize]) as u64, (&s_bin[0 as usize]) as u64)
            ulib.strcat((&full[0 as usize]) as u64, name)
            p = (&full[0 as usize]) as u64
        }
        if ulib.bad(ulib.size_of(p)) || ulib.is_dir(p) {
            missing = missing + 1
        } else {
            tools.ob_str(p)
            tools.ob_nl()
        }
        k = k + 1
    }
    tools.ob_flush()
    if missing > 0 {
        return 1
    }
    return 0
}
