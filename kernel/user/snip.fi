export { u_start }

const SYS_DISPGET: u64 = 1810
const DG_PITCH: u64 = 30
const DG_BPP: u64 = 31

const PIXCAP: u64 = 4587520
const ROHCAP: u64 = 65536
const KOMPCAP: u64 = 98304

static mut pix: u64 = 0
static mut roh: u64 = 0
static mut komp: u64 = 0
static mut bw: u64 = 0
static mut bh: u64 = 0
static mut scr_w: u64 = 0
static mut scr_h: u64 = 0
static mut pitch: u64 = 0
static mut bpp: u64 = 4

static mut target: [u8; 256] = [0 as u8; 256]
static mut header: [u8; 192] = [0 as u8; 192]
static mut clipboard: [u8; 288] = [0 as u8; 288]

static mut w_image: u64 = 0
static mut w_header: u64 = 0
static mut w_new: u64 = 0
static mut w_window: u64 = 0
static mut w_aus: u64 = 0
static mut w_rechteck: u64 = 0
static mut w_pfeil: u64 = 0
static mut w_pixel: u64 = 0
static mut w_save: u64 = 0
static mut w_verz: u64 = 0
static mut region_mode: bool = false
static mut img_w: u64 = 744
static mut img_h: u64 = 424
static mut w_stift: u64 = 0
static mut w_marker: u64 = 0
static mut tool: u64 = 0

static mut T_TITLE: [u8; 11] = "Ausschnitt\0"
static mut T_APP: [u8; 5] = "snip\0"
static mut T_NEW: [u8; 9] = "Vollbild\0"
static mut T_WINDOW: [u8; 8] = "Fenster\0"
static mut T_AUS: [u8; 11] = "Ausschnitt\0"
static mut T_RECHTECK: [u8; 9] = "Rechteck\0"
static mut T_PFEIL: [u8; 6] = "Pfeil\0"
static mut T_PIXEL: [u8; 10] = "Verpixeln\0"
static mut T_SAVE: [u8; 8] = "Sichern\0"
static mut T_STIFT: [u8; 6] = "Stift\0"
static mut T_MARKER: [u8; 7] = "Marker\0"
static mut T_REGION: [u8; 32] = "Ausschnitt ziehen, dann Sichern\0"
static mut T_CLIPTYP: [u8; 16] = "snip: clip typ=\0"
static mut T_VERZ: [u8; 16] = "0 s\n1 s\n3 s\n5 s\0"
static mut T_READY: [u8; 34] = "Aufnehmen, dann malen und sichern\0"
static mut T_GESICHERT: [u8; 12] = "gesichert: \0"
static mut T_FAIL: [u8; 14] = "that failed: \0"
static mut T_DEV: [u8; 8] = "/dev/fb\0"
static mut T_VOR: [u8; 6] = "bild:\0"
static mut T_FOLDER: [u8; 8] = "/bilder\0"
static mut T_FOLDER2: [u8; 20] = "/bilder/Screenshots\0"
static mut T_MUSTER: [u8; 32] = "/bilder/Screenshots/Screenshot-\0"
static mut T_ENDE: [u8; 5] = ".png\0"
static mut S_X: [u8; 5] = " × \0"

fn say(p: u64) {
    lineout.add_text(p)
}

fn map(n: u64) -> u64 {
    let p: u64 = hosthead.map_surface(n)
    if ulib.bad(p) {
        return 0
    }
    return p
}

fn screen_dims() {
    scr_w = hosthead.screen_w()
    scr_h = hosthead.screen_h()
    pitch = ulib.sys(SYS_DISPGET, DG_PITCH, 0, 0)
    bpp = ulib.sys(SYS_DISPGET, DG_BPP, 0, 0) / 8
    if ulib.bad(pitch) || pitch == 0 {
        pitch = scr_w * 4
    }
    if ulib.bad(bpp) || bpp == 0 || bpp > 4 {
        bpp = 4
    }
}

fn aufnehmen(x: u64, y: u64, w: u64, h: u64) -> bool {
    if w == 0 || h == 0 || w * h > PIXCAP / 4 {
        return false
    }
    let fd: u64 = io.open((&T_DEV[(0) as usize]) as u64, 0)
    if ulib.bad(fd) {
        return false
    }
    var line: [u8; 8192] = [0 as u8; 8192]
    let zp: u64 = (&line[(0) as usize]) as u64
    var r: u64 = 0
    var gut: bool = true
    while r < h && gut {
        let off: u64 = (y + r) * pitch + x * bpp
        if ulib.bad(io.seek(fd, off, 0)) {
            gut = false
        } else {
            var n: u64 = w * bpp
            if n > 8192 {
                n = 8192
            }
            let g: u64 = io.read_full(fd, zp, n)
            if ulib.bad(g) {
                gut = false
            } else {
                var c: u64 = 0
                while c < w && c * bpp + bpp <= n {
                    let s: u64 = zp + c * bpp
                    let b: u64 = (*((s) as *mut u8)) as u64
                    let gr: u64 = (*((s + 1) as *mut u8)) as u64
                    let rt: u64 = (*((s + 2) as *mut u8)) as u64
                    __mmio_write32((pix + (r * w + c) * 4) as *mut u32,
                        ((255 << 24) | (rt << 16) | (gr << 8) | b) as u32)
                    c = c + 1
                }
            }
        }
        r = r + 1
    }
    io.close(fd)
    if gut {
        bw = w
        bh = h
    }
    return gut
}

fn foreign_window(own: u64, rx: u64, ry: u64, rw: u64, rh: u64) -> bool {
    var list: [u8; 2048] = [0 as u8; 2048]
    let lp: u64 = (&list[(0) as usize]) as u64
    let n: u64 = uisys.sys3w(hostwinp.WM_LIST, lp, 16, 0)
    if ulib.bad(n) || n == 0 {
        return false
    }
    var i: u64 = 0
    var gefunden: bool = false
    while i < n && i < 16 {
        let e: u64 = lp + i * hostwinp.WL_BYTES
        let id: u64 = __mmio_read64((e + hostwinp.WL_ID) as *mut u64)
        let flags: u64 = __mmio_read64((e + hostwinp.WL_FLAGS) as *mut u64)
        if id != own && (flags & hostwinp.F_HIDDEN) == 0 {
            __mmio_write64((rx) as *mut u64,
                __mmio_read64((e + hostwinp.WL_X) as *mut u64))
            __mmio_write64((ry) as *mut u64,
                __mmio_read64((e + hostwinp.WL_Y) as *mut u64))
            __mmio_write64((rw) as *mut u64,
                __mmio_read64((e + hostwinp.WL_W) as *mut u64))
            __mmio_write64((rh) as *mut u64,
                __mmio_read64((e + hostwinp.WL_H) as *mut u64))
            gefunden = true
        }
        i = i + 1
    }
    return gefunden
}

fn set(x: u64, y: u64, f: u64) {
    if x < bw && y < bh {
        __mmio_write32((pix + (y * bw + x) * 4) as *mut u32, f as u32)
    }
}

fn hol(x: u64, y: u64) -> u64 {
    if x < bw && y < bh {
        return (__mmio_read32((pix + (y * bw + x) * 4) as *mut u32)) as u64
    }
    return 0
}

const ROT: u64 = 0xFFE02020

fn rechteck(x0: u64, y0: u64, x1: u64, y1: u64) {
    var d: u64 = 0
    while d < 3 {
        var x: u64 = x0
        while x <= x1 {
            set(x, y0 + d, ROT)
            set(x, y1 - d, ROT)
            x = x + 1
        }
        var y: u64 = y0
        while y <= y1 {
            set(x0 + d, y, ROT)
            set(x1 - d, y, ROT)
            y = y + 1
        }
        d = d + 1
    }
}

fn pfeil(x0: u64, y0: u64, x1: u64, y1: u64) {
    var dx: u64 = x1 -% x0
    var dy: u64 = y1 -% y0
    var n: u64 = 0
    if x1 > x0 {
        n = x1 - x0
    } else {
        n = x0 - x1
    }
    var m: u64 = 0
    if y1 > y0 {
        m = y1 - y0
    } else {
        m = y0 - y1
    }
    if m > n {
        n = m
    }
    if n == 0 {
        return
    }
    var i: u64 = 0
    while i <= n {
        let x: u64 = x0 +% (dx * i / n)
        let y: u64 = y0 +% (dy * i / n)
        var a: u64 = 0
        while a < 3 {
            var b: u64 = 0
            while b < 3 {
                set(x + a, y + b, ROT)
                b = b + 1
            }
            a = a + 1
        }
        i = i + 1
    }
    var k: u64 = 0
    while k < 14 {
        let x: u64 = x1 -% (dx * k / n)
        let y: u64 = y1 -% (dy * k / n)
        var a2: u64 = 0
        while a2 < 3 {
            set(x +% (dy * k / n) / 2 + a2, y -% (dx * k / n) / 2, ROT)
            set(x -% (dy * k / n) / 2 + a2, y +% (dx * k / n) / 2, ROT)
            a2 = a2 + 1
        }
        k = k + 1
    }
}

fn stift(x0: u64, y0: u64, x1: u64, y1: u64) {
    let dx: u64 = x1 -% x0
    let dy: u64 = y1 -% y0
    var n: u64 = 0
    if x1 > x0 {
        n = x1 - x0
    } else {
        n = x0 - x1
    }
    var m: u64 = 0
    if y1 > y0 {
        m = y1 - y0
    } else {
        m = y0 - y1
    }
    if m > n {
        n = m
    }
    if n == 0 {
        return
    }
    var i: u64 = 0
    while i <= n {
        let x: u64 = x0 +% (dx * i / n)
        let y: u64 = y0 +% (dy * i / n)
        var a: u64 = 0
        while a < 3 {
            var b: u64 = 0
            while b < 3 {
                set(x + a, y + b, ROT)
                b = b + 1
            }
            a = a + 1
        }
        i = i + 1
    }
}

fn marker(x0: u64, y0: u64, x1: u64, y1: u64) {
    var y: u64 = y0
    while y <= y1 {
        var x: u64 = x0
        while x <= x1 {
            let c: u64 = hol(x, y)
            let r: u64 = (c >> 16) & 255
            let g: u64 = (c >> 8) & 255
            let b: u64 = c & 255
            let nr: u64 = (r + 255) / 2
            let ng: u64 = (g + 230) / 2
            let nb: u64 = b / 2
            set(x, y, (255 << 24) | (nr << 16) | (ng << 8) | nb)
            x = x + 1
        }
        y = y + 1
    }
}

fn verpixeln(x0: u64, y0: u64, x1: u64, y1: u64) {
    var y: u64 = y0
    while y <= y1 {
        var x: u64 = x0
        while x <= x1 {
            var sr: u64 = 0
            var sg: u64 = 0
            var sb: u64 = 0
            var n: u64 = 0
            var by: u64 = 0
            while by < 8 && y + by <= y1 {
                var bx: u64 = 0
                while bx < 8 && x + bx <= x1 {
                    let c: u64 = hol(x + bx, y + by)
                    sr = sr + ((c >> 16) & 255)
                    sg = sg + ((c >> 8) & 255)
                    sb = sb + (c & 255)
                    n = n + 1
                    bx = bx + 1
                }
                by = by + 1
            }
            if n > 0 {
                let f: u64 = (255 << 24) | ((sr / n) << 16)
                    | ((sg / n) << 8) | (sb / n)
                var cy: u64 = 0
                while cy < 8 && y + cy <= y1 {
                    var cx: u64 = 0
                    while cx < 8 && x + cx <= x1 {
                        set(x + cx, y + cy, f)
                        cx = cx + 1
                    }
                    cy = cy + 1
                }
            }
            x = x + 8
        }
        y = y + 8
    }
}

fn num_at(p: u64, v: u64) {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = text.digits(v, (&z[(0) as usize]) as u64, true)
    z[(n) as usize] = 0 as u8
    ulib.strcat(p, (&z[(0) as usize]) as u64)
}

fn naechster_name() -> u64 {
    let z: u64 = (&target[(0) as usize]) as u64
    let _m: u64 = io.make_dir((&T_FOLDER[(0) as usize]) as u64)
    let _m2: u64 = io.make_dir((&T_FOLDER2[(0) as usize]) as u64)
    var i: u64 = 1
    while i < 10000 {
        ulib.strcpy(z, (&T_MUSTER[(0) as usize]) as u64)
        num_at(z, i)
        ulib.strcat(z, (&T_ENDE[(0) as usize]) as u64)
        let fd: u64 = io.open(z, 0)
        if ulib.bad(fd) {
            return z
        }
        io.close(fd)
        i = i + 1
    }
    return z
}

fn clipboard_image(pfadp: u64) {
    if !ulib.bad(xfer.set_file(xfer.SEL_CLIPBOARD, xfer.MIME_PNG, pfadp)) {
        say((&T_CLIPTYP[(0) as usize]) as u64)
        lineout.add_num(svcclip.clip_hist_typ(0))
        lineout.end_line()
        return
    }
    let a: u64 = (&clipboard[(0) as usize]) as u64
    ulib.strcpy(a, (&T_VOR[(0) as usize]) as u64)
    ulib.strcat(a, pfadp)
    svcclip.clip_put_typ(svcclip.BT_IMAGE | svcclip.BT_TEXT, a, text.length(a))
    say((&T_CLIPTYP[(0) as usize]) as u64)
    lineout.add_num(svcclip.clip_hist_typ(0))
    lineout.end_line()
}

fn save(pfadp: u64) -> bool {
    if bw == 0 || bh == 0 {
        return false
    }
    let fd: u64 = tools.openw(pfadp)
    if ulib.bad(fd) {
        return false
    }
    let ok: bool = image.png_file(fd, pix, bw, bh, roh, ROHCAP, komp,
        KOMPCAP)
    io.close(fd)
    if !ok {
        return false
    }
    clipboard_image(pfadp)
    return true
}

const K_IMG: u64 = 1
const K_NEW: u64 = 2
const K_WINDOW: u64 = 3
const K_AUS: u64 = 4
const K_VERZ: u64 = 5
const K_RECHTECK: u64 = 6
const K_PFEIL: u64 = 7
const K_PIXEL: u64 = 8
const K_SAVE: u64 = 9
const K_STIFT: u64 = 10
const K_MARKER: u64 = 11

static mut T_VZ: [u8; 16] = "0 s\01 s\03 s\05 s\0"
static mut verz_sel: u64 = 0

fn crop_selection() {
    let ax: u64 = fuiscene.image_sel_x0(K_IMG)
    let ay: u64 = fuiscene.image_sel_y0(K_IMG)
    let aw: u64 = fuiscene.image_sel_x1(K_IMG) - ax + 1
    let ah: u64 = fuiscene.image_sel_y1(K_IMG) - ay + 1
    var r: u64 = 0
    while r < ah {
        var c: u64 = 0
        while c < aw {
            __mmio_write32((pix + (r * aw + c) * 4) as *mut u32,
                (hol(ax + c, ay + r)) as u32)
            c = c + 1
        }
        r = r + 1
    }
    bw = aw
    bh = ah
    fuiscene.image_sel_clear(K_IMG)
}

fn verz_text(i: u64) -> u64 {
    return (&T_VZ[(i * 4) as usize]) as u64
}

fn header_build(p: u64) {
    let k: u64 = (&header[(0) as usize]) as u64
    ulib.strncpy(k, p, 100)
    if bw > 0 {
        var sp: [u8; 3] = "  \0"
        ulib.strcat(k, (&sp[(0) as usize]) as u64)
        num_at(k, bw)
        ulib.strcat(k, (&S_X[(0) as usize]) as u64)
        num_at(k, bh)
    }
    fuiscene.refresh()
}

fn verzoegern() {
    let level: u64 = verz_sel
    var sec: u64 = 0
    if level == 1 {
        sec = 1
    } else if level == 2 {
        sec = 3
    } else if level == 3 {
        sec = 5
    }
    fuiscene.hide(true)
    let _s: u64 = clockapi.sleep_ms(400 + sec * 1000)
}

fn again_present() {
    fuiscene.hide(false)
    fuiscene.refresh()
}

fn show() {
    fuiscene.image_set(K_IMG, pix, bw, bh)
    fuiscene.image_fit(K_IMG)
    fuiscene.image_tool(K_IMG, true)
}

fn build() {
    let col: usize = fuiscene.root()
    let _k: usize = fuiscene.label(col, (&header[(0) as usize]) as u64)
    let _b: usize = fuiscene.image(col, K_IMG, img_w, img_h)
    let bar1: usize = fuiscene.row(col)
    fuiscene.set_gap(bar1, 8)
    let b1: usize = fuiscene.button(bar1, (&T_NEW[(0) as usize]) as u64, K_NEW)
    fuiscene.set_size(b1, 112, 36)
    fuiscene.compact(b1)
    let b2: usize = fuiscene.button(bar1, (&T_WINDOW[(0) as usize]) as u64, K_WINDOW)
    fuiscene.set_size(b2, 100, 36)
    fuiscene.compact(b2)
    let b3: usize = fuiscene.button(bar1, (&T_AUS[(0) as usize]) as u64, K_AUS)
    fuiscene.set_size(b3, 120, 36)
    fuiscene.compact(b3)
    let ch: usize = fuiscene.choice(bar1, verz_text(verz_sel), K_VERZ)
    fuiscene.set_size(ch, 96, 36)
    let bar2: usize = fuiscene.row(col)
    fuiscene.set_gap(bar2, 8)
    let c1: usize = fuiscene.button(bar2, (&T_RECHTECK[(0) as usize]) as u64, K_RECHTECK)
    fuiscene.set_size(c1, 112, 36)
    fuiscene.compact(c1)
    let c2: usize = fuiscene.button(bar2, (&T_PFEIL[(0) as usize]) as u64, K_PFEIL)
    fuiscene.set_size(c2, 88, 36)
    fuiscene.compact(c2)
    let c3: usize = fuiscene.button(bar2, (&T_PIXEL[(0) as usize]) as u64, K_PIXEL)
    fuiscene.set_size(c3, 120, 36)
    fuiscene.compact(c3)
    let c5: usize = fuiscene.button(bar2, (&T_STIFT[(0) as usize]) as u64, K_STIFT)
    fuiscene.set_size(c5, 80, 36)
    fuiscene.compact(c5)
    let c6: usize = fuiscene.button(bar2, (&T_MARKER[(0) as usize]) as u64, K_MARKER)
    fuiscene.set_size(c6, 104, 36)
    fuiscene.compact(c6)
    let c4: usize = fuiscene.button_main(bar2, (&T_SAVE[(0) as usize]) as u64, K_SAVE)
    fuiscene.set_size(c4, 112, 36)
    fuiscene.compact(c4)
}

fn u_gui(region: bool, delay_s: u64) -> u64 {
    var s_bad: [u8; 17] = "snip: no surface\0"
    var s_mem: [u8; 20] = "snip: out of memory\0"
    var s_go: [u8; 12] = "snip: ready\0"
    var s_geom: [u8; 14] = "snip: geom w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_shot: [u8; 18] = "snip: aufnahme w=\0"
    var s_save: [u8; 17] = "snip: gesichert \0"
    pix = map(PIXCAP)
    roh = map(ROHCAP)
    komp = map(KOMPCAP)
    if pix == 0 || roh == 0 || komp == 0 {
        say((&s_mem[(0) as usize]) as u64)
        lineout.end_line()
        return 1
    }
    screen_dims()
    var bwin: u64 = 760
    var bhin: u64 = 560
    var wx: u64 = 50
    var wy: u64 = 40
    region_mode = region
    ulib.strcpy((&header[(0) as usize]) as u64, (&T_READY[(0) as usize]) as u64)
    if region {
        let _st: bool = hoststart.start(false)
        screen_dims()
        if delay_s > 0 {
            let _d: u64 = clockapi.sleep_ms(delay_s * 1000)
        }
        let _ok: bool = aufnehmen(0, 0, scr_w, scr_h)
        bwin = scr_w - 24
        bhin = scr_h - 80
        wx = 0
        wy = 0
        img_w = bwin - 16
        img_h = bhin - 150
        ulib.strcpy((&header[(0) as usize]) as u64, (&T_REGION[(0) as usize]) as u64)
    }
    if !fuiscene.open(wx, wy, bwin, bhin, (&T_TITLE[(0) as usize]) as u64,
        build) {
        say((&s_bad[(0) as usize]) as u64)
        lineout.end_line()
        return 1
    }
    fuiscene.set_app((&T_APP[(0) as usize]) as u64)
    let _k0: u64 = fuiscene.pump()
    fuiscene.image_tool(K_IMG, true)
    if region && bw > 0 {
        show()
    }
    say((&s_geom[(0) as usize]) as u64)
    lineout.add_num(bwin)
    say((&s_h[(0) as usize]) as u64)
    lineout.add_num(bhin)
    lineout.end_line()
    var s_nm: [u8; 5] = "snip\0"
    fuiscene.say_rects((&s_nm[(0) as usize]) as u64)
    say((&s_go[(0) as usize]) as u64)
    lineout.end_line()

    var runden: u64 = 0
    while fuiscene.alive() && runden < 40000000 {
        runden = runden + 1
        let id: u64 = fuiscene.pump()
        if id == K_VERZ {
            let ci: usize = fuiscene.node_of_key(K_VERZ)
            fuiscene.menu_open(fuiscene.node_x(ci),
                fuiscene.node_y(ci) + fuiscene.node_h(ci) + 2, 96,
                (&T_VZ[0 as usize]) as u64, 4)
        } else if id == fuiscene.KEY_POPUP {
            let pick: u64 = fuiscene.menu_pick()
            if pick >= 1 && pick <= 4 {
                verz_sel = pick - 1
                fuiscene.refresh()
            }
        } else if id == K_NEW {
            verzoegern()
            let ok: bool = aufnehmen(0, 0, scr_w, scr_h)
            again_present()
            if ok {
                show()
                say((&s_shot[(0) as usize]) as u64)
                lineout.add_num(bw)
                say((&s_h[(0) as usize]) as u64)
                lineout.add_num(bh)
                lineout.end_line()
            }
            header_build((&T_READY[(0) as usize]) as u64)
        } else if id == K_WINDOW {
            var fx: u64 = 0
            var fy: u64 = 0
            var fw: u64 = 0
            var fh: u64 = 0
            let da: bool = foreign_window(fuiscene.handle(),
                (&fx) as u64, (&fy) as u64, (&fw) as u64, (&fh) as u64)
            if da {
                verzoegern()
                let ok2: bool = aufnehmen(fx, fy, fw, fh)
                again_present()
                if ok2 {
                    show()
                }
            }
            header_build((&T_READY[(0) as usize]) as u64)
        } else if id == K_AUS {
            if fuiscene.image_sel_present(K_IMG) && bw > 0 {
                crop_selection()
                show()
                header_build((&T_READY[(0) as usize]) as u64)
            }
        } else if id == K_RECHTECK || id == K_PFEIL || id == K_PIXEL
            || id == K_STIFT || id == K_MARKER {
            if fuiscene.image_sel_present(K_IMG) && bw > 0 {
                let bx0: u64 = fuiscene.image_sel_x0(K_IMG)
                let by0: u64 = fuiscene.image_sel_y0(K_IMG)
                let bx1: u64 = fuiscene.image_sel_x1(K_IMG)
                let by1: u64 = fuiscene.image_sel_y1(K_IMG)
                if id == K_RECHTECK {
                    rechteck(bx0, by0, bx1, by1)
                } else if id == K_PFEIL {
                    pfeil(bx0, by0, bx1, by1)
                } else if id == K_STIFT {
                    stift(bx0, by0, bx1, by1)
                } else if id == K_MARKER {
                    marker(bx0, by0, bx1, by1)
                } else {
                    verpixeln(bx0, by0, bx1, by1)
                }
                fuiscene.image_sel_clear(K_IMG)
                fuiscene.refresh()
            }
        } else if id == K_SAVE {
            let was_region: bool = region_mode && fuiscene.image_sel_present(K_IMG)
            if was_region && bw > 0 {
                crop_selection()
            }
            let p: u64 = naechster_name()
            if save(p) {
                var t: [u8; 256] = [0 as u8; 256]
                ulib.strcpy((&t[(0) as usize]) as u64,
                    (&T_GESICHERT[(0) as usize]) as u64)
                ulib.strcat((&t[(0) as usize]) as u64, p)
                header_build((&t[(0) as usize]) as u64)
                say((&s_save[(0) as usize]) as u64)
                say(p)
                lineout.end_line()
                if was_region {
                    return 0
                }
            } else {
                header_build((&T_FAIL[(0) as usize]) as u64)
            }
        }
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var s_o: [u8; 3] = "-o\0"
    var s_v: [u8; 3] = "-v\0"
    var s_a: [u8; 3] = "-a\0"
    var a_window: [u8; 8] = "fenster\0"
    var s_use: [u8; 80] = "snip: snip [-q] [-r] [-g x y w h] [-v <sek>] [-a voll|fenster] [-o <datei.png>]\0"
    var s_mem: [u8; 20] = "snip: out of memory\0"
    var s_kein: [u8; 25] = "snip: the capture failed\0"
    var s_schr: [u8; 21] = "snip: write failed: \0"
    var s_ok: [u8; 17] = "snip: gesichert \0"
    var s_wh: [u8; 4] = " w=\0"
    var s_h: [u8; 4] = " h=\0"
    let argc: u64 = ulib.arg_count(args)
    var out: u64 = 0
    var sec: u64 = 0
    var only_window: bool = false
    var quick: bool = false
    var region: bool = false
    var geo: bool = false
    var gx: u64 = 0
    var gy: u64 = 0
    var gw: u64 = 0
    var gh: u64 = 0
    var s_q: [u8; 3] = "-q\0"
    var s_r: [u8; 3] = "-r\0"
    var s_g: [u8; 3] = "-g\0"
    var a: u64 = 1
    while a < argc {
        let p: u64 = ulib.arg_at(args, a)
        if ulib.streq(p, (&s_o[(0) as usize]) as u64) && a + 1 < argc {
            out = ulib.arg_at(args, a + 1)
            a = a + 1
        } else if ulib.streq(p, (&s_q[(0) as usize]) as u64) {
            quick = true
        } else if ulib.streq(p, (&s_r[(0) as usize]) as u64) {
            region = true
        } else if ulib.streq(p, (&s_g[(0) as usize]) as u64)
            && a + 4 < argc {
            gx = ulib.to_num(ulib.arg_at(args, a + 1))
            gy = ulib.to_num(ulib.arg_at(args, a + 2))
            gw = ulib.to_num(ulib.arg_at(args, a + 3))
            gh = ulib.to_num(ulib.arg_at(args, a + 4))
            geo = true
            a = a + 4
        } else if ulib.streq(p, (&s_v[(0) as usize]) as u64)
            && a + 1 < argc {
            sec = ulib.to_num(ulib.arg_at(args, a + 1))
            a = a + 1
        } else if ulib.streq(p, (&s_a[(0) as usize]) as u64)
            && a + 1 < argc {
            only_window = ulib.streq(ulib.arg_at(args, a + 1),
                (&a_window[(0) as usize]) as u64)
            a = a + 1
        }
        a = a + 1
    }
    if region && !geo && out == 0 {
        return u_gui(true, sec)
    }
    if out == 0 && !quick && !geo {
        if argc > 1 {
            ulib.esay_line((&s_use[(0) as usize]) as u64, 0)
            return 2
        }
        return u_gui(false, 0)
    }
    if !hoststart.start(false) {
        say((&s_kein[(0) as usize]) as u64)
        lineout.end_line()
        return 1
    }
    pix = map(PIXCAP)
    roh = map(ROHCAP)
    komp = map(KOMPCAP)
    if pix == 0 || roh == 0 || komp == 0 {
        say((&s_mem[(0) as usize]) as u64)
        lineout.end_line()
        return 1
    }
    screen_dims()
    if sec > 0 {
        let _s: u64 = clockapi.sleep_ms(sec * 1000)
    }
    var x: u64 = 0
    var y: u64 = 0
    var w: u64 = scr_w
    var h: u64 = scr_h
    if geo {
        x = gx
        y = gy
        w = gw
        h = gh
        if x + w > scr_w || y + h > scr_h {
            say((&s_kein[(0) as usize]) as u64)
            lineout.end_line()
            return 1
        }
    }
    if only_window {
        if !foreign_window(0, (&x) as u64, (&y) as u64, (&w) as u64,
            (&h) as u64) {
            say((&s_kein[(0) as usize]) as u64)
            lineout.end_line()
            return 1
        }
    }
    if !aufnehmen(x, y, w, h) {
        say((&s_kein[(0) as usize]) as u64)
        lineout.end_line()
        return 1
    }
    if out == 0 {
        out = naechster_name()
    }
    if !save(out) {
        ulib.esay_line((&s_schr[(0) as usize]) as u64, out)
        return 1
    }
    say((&s_ok[(0) as usize]) as u64)
    say(out)
    say((&s_wh[(0) as usize]) as u64)
    lineout.add_num(bw)
    say((&s_h[(0) as usize]) as u64)
    lineout.add_num(bh)
    lineout.end_line()
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
