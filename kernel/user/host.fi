
profile kernel

import ulib
import libc.dns
import libc.dnswire
import libc.octets

export { u_start }

static mut NAME: [u8; 300] = [0 as u8; 300]
static mut ADR: [u8; 16] = [0 as u8; 16]
static mut LINE: [u8; 128] = [0 as u8; 128]

fn s8(p: u64, i: u64, v: u64) {
    __mmio_write8((p + i) as *mut u8, (v & 255) as u8)
}

fn say_2(p: u64) {
    ulib.say(p)
}

fn nl() {
    ulib.nl()
}

fn v4(p: u64, out: u64) {
    var n: u64 = 0
    var i: u64 = 0
    while i < 4 {
        if i > 0 {
            s8(out, n, 46)
            n = n + 1
        }
        let t: u64 = octets.ld8(p, i)
        if t >= 100 {
            s8(out, n, 48 + t / 100)
            n = n + 1
        }
        if t >= 10 {
            s8(out, n, 48 + (t / 10) % 10)
            n = n + 1
        }
        s8(out, n, 48 + t % 10)
        n = n + 1
        i = i + 1
    }
    s8(out, n, 0)
}

fn hexziffer(v: u64) -> u64 {
    if v < 10 {
        return 48 + v
    }
    return 87 + v
}

fn v6(p: u64, out: u64) {
    var n: u64 = 0
    var g: u64 = 0
    while g < 8 {
        if g > 0 {
            s8(out, n, 58)
            n = n + 1
        }
        let w: u64 = (octets.ld8(p, g * 2) << 8) | octets.ld8(p, g * 2 + 1)
        var k: u64 = 0
        var start: bool = true
        while k < 4 {
            let nib: u64 = (w >> ((3 - k) * 4)) & 15
            if nib != 0 || k == 3 || !start {
                s8(out, n, hexziffer(nib))
                n = n + 1
                start = false
            }
            k = k + 1
        }
        g = g + 1
    }
    s8(out, n, 0)
}

fn reason(c: u64) {
    var t0: [u8; 9] = "NXDOMAIN\0"
    var t1: [u8; 7] = "NODATA\0"
    var t2: [u8; 9] = "SERVFAIL\0"
    var t3: [u8; 8] = "REFUSED\0"
    var t4: [u8; 10] = "TRUNCATED\0"
    var t5: [u8; 7] = "FORMAT\0"
    var t6: [u8; 5] = "LOOP\0"
    var t7: [u8; 8] = "TIMEOUT\0"
    var t8: [u8; 9] = "NOSERVER\0"
    var t9: [u8; 4] = "NET\0"
    var ta: [u8; 8] = "BADNAME\0"
    var tb: [u8; 7] = "NOPORT\0"
    var tc: [u8; 9] = "MISMATCH\0"
    var tz: [u8; 8] = "UNKNOWN\0"
    if c == dnswire.R_NXDOMAIN { say_2((&t0[0 as usize]) as u64) }
    else if c == dnswire.R_NODATA { say_2((&t1[0 as usize]) as u64) }
    else if c == dnswire.R_SERVFAIL { say_2((&t2[0 as usize]) as u64) }
    else if c == dnswire.R_REFUSED { say_2((&t3[0 as usize]) as u64) }
    else if c == dnswire.R_TRUNC { say_2((&t4[0 as usize]) as u64) }
    else if c == dnswire.R_FORMAT { say_2((&t5[0 as usize]) as u64) }
    else if c == dnswire.R_LOOP { say_2((&t6[0 as usize]) as u64) }
    else if c == dns.R_TIMEOUT { say_2((&t7[0 as usize]) as u64) }
    else if c == dns.R_NOSERVER { say_2((&t8[0 as usize]) as u64) }
    else if c == dns.R_NET { say_2((&t9[0 as usize]) as u64) }
    else if c == dnswire.R_BADNAME { say_2((&ta[0 as usize]) as u64) }
    else if c == dns.R_NOPORT { say_2((&tb[0 as usize]) as u64) }
    else if c == dnswire.R_MISMATCH { say_2((&tc[0 as usize]) as u64) }
    else { say_2((&tz[0 as usize]) as u64) }
}

fn show_conf() -> u64 {
    var t: [u8; 12] = "nameserver \0"
    var k: [u8; 10] = "timeout \0\0"
    var a: [u8; 10] = "attempts \0"
    dns.conf_load()
    var i: u64 = 0
    while i < dns.conf_count() {
        var b: [u8; 8] = [0 as u8; 8]
        let ip: u64 = dns.conf_at(i)
        s8((&b[0 as usize]) as u64, 0, (ip >> 24) & 255)
        s8((&b[0 as usize]) as u64, 1, (ip >> 16) & 255)
        s8((&b[0 as usize]) as u64, 2, (ip >> 8) & 255)
        s8((&b[0 as usize]) as u64, 3, ip & 255)
        v4((&b[0 as usize]) as u64, (&LINE[0 as usize]) as u64)
        say_2((&t[0 as usize]) as u64)
        say_2((&LINE[0 as usize]) as u64)
        nl()
        i = i + 1
    }
    say_2((&k[0 as usize]) as u64)
    ulib.sayu(dns.conf_timeout())
    nl()
    say_2((&a[0 as usize]) as u64)
    ulib.sayu(dns.conf_attempts())
    nl()
    if dns.conf_count() == 0 {
        return 1
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var use1: [u8; 49] = "host [-v] [-t a|aaaa] [-s <ip>] <name> | host -c\0"
    var f_v: [u8; 3] = "-v\0"
    var f_t: [u8; 3] = "-t\0"
    var f_s: [u8; 3] = "-s\0"
    var f_c: [u8; 3] = "-c\0"
    var w_aaaa: [u8; 5] = "aaaa\0"
    var w_a: [u8; 2] = "a\0"
    var w_cname: [u8; 6] = "cname\0"
    var s_srv: [u8; 10] = "  server \0"
    var s_prt: [u8; 10] = "  port   \0"
    var s_txi: [u8; 10] = "  txid   \0"
    var s_try: [u8; 10] = "  tries  \0"
    var s_drp: [u8; 10] = "  fremd  \0"
    var s_nc: [u8; 10] = "  nocaps \0"
    var s_ms: [u8; 10] = "  ms     \0"
    var s_cn: [u8; 10] = "  cname  \0"
    var s_ttl: [u8; 10] = "  ttl    \0"
    let n: u64 = ulib.arg_count(args)
    var laut: bool = false
    var typ: u64 = dnswire.T_A
    var srv: u64 = 0
    var name: u64 = 0
    var i: u64 = 1
    while i < n {
        let a: u64 = ulib.arg_at(args, i)
        if ulib.streq(a, (&f_c[0 as usize]) as u64) {
            return show_conf()
        } else if ulib.streq(a, (&f_v[0 as usize]) as u64) {
            laut = true
        } else if ulib.streq(a, (&f_t[0 as usize]) as u64) && i + 1 < n {
            i = i + 1
            let w: u64 = ulib.arg_at(args, i)
            if ulib.streq(w, (&w_aaaa[0 as usize]) as u64) {
                typ = dnswire.T_AAAA
            } else if ulib.streq(w, (&w_cname[0 as usize]) as u64) {
                typ = dnswire.T_CNAME
            } else if ulib.streq(w, (&w_a[0 as usize]) as u64) {
                typ = dnswire.T_A
            } else {
                say_2((&use1[0 as usize]) as u64)
                nl()
                return 2
            }
        } else if ulib.streq(a, (&f_s[0 as usize]) as u64) && i + 1 < n {
            i = i + 1
            srv = parse_ip(ulib.arg_at(args, i))
            if srv == 0 {
                say_2((&use1[0 as usize]) as u64)
                nl()
                return 2
            }
        } else {
            name = a
        }
        i = i + 1
    }
    if name == 0 {
        say_2((&use1[0 as usize]) as u64)
        nl()
        return 2
    }
    ulib.strncpy((&NAME[0 as usize]) as u64, name, 299)
    if srv != 0 {
        dns.conf_set(srv)
    }
    let c: u64 = dns.resolve((&NAME[0 as usize]) as u64, typ,
        (&ADR[0 as usize]) as u64)
    if c == dnswire.R_OK {
        if typ == dnswire.T_AAAA {
            v6((&ADR[0 as usize]) as u64, (&LINE[0 as usize]) as u64)
        } else {
            v4((&ADR[0 as usize]) as u64, (&LINE[0 as usize]) as u64)
        }
        say_2((&LINE[0 as usize]) as u64)
        nl()
    } else {
        reason(c)
        nl()
    }
    if laut {
        var b: [u8; 8] = [0 as u8; 8]
        let ip: u64 = dns.used_server()
        s8((&b[0 as usize]) as u64, 0, (ip >> 24) & 255)
        s8((&b[0 as usize]) as u64, 1, (ip >> 16) & 255)
        s8((&b[0 as usize]) as u64, 2, (ip >> 8) & 255)
        s8((&b[0 as usize]) as u64, 3, ip & 255)
        v4((&b[0 as usize]) as u64, (&LINE[0 as usize]) as u64)
        say_2((&s_srv[0 as usize]) as u64)
        say_2((&LINE[0 as usize]) as u64)
        nl()
        say_2((&s_prt[0 as usize]) as u64)
        ulib.sayu(dns.used_port())
        nl()
        say_2((&s_txi[0 as usize]) as u64)
        ulib.sayu(dns.used_txid())
        nl()
        say_2((&s_try[0 as usize]) as u64)
        ulib.sayu(dns.used_tries())
        nl()
        say_2((&s_drp[0 as usize]) as u64)
        ulib.sayu(dns.dropped())
        nl()
        say_2((&s_nc[0 as usize]) as u64)
        ulib.sayu(dns.used_nocaps())
        nl()
        say_2((&s_ms[0 as usize]) as u64)
        ulib.sayu(dns.used_ms())
        nl()
        say_2((&s_cn[0 as usize]) as u64)
        ulib.sayu(dnswire.cnames())
        nl()
        say_2((&s_ttl[0 as usize]) as u64)
        ulib.sayu(dnswire.ttl())
        nl()
    }
    if c == dnswire.R_OK {
        return 0
    }
    if c == dnswire.R_NXDOMAIN {
        return 3
    }
    return 1
}

fn parse_ip(p: u64) -> u64 {
    var v: u64 = 0
    var part: u64 = 0
    var points: u64 = 0
    var ziffern: u64 = 0
    var i: u64 = 0
    while true {
        let c: u64 = octets.ld8(p, i)
        if c >= 48 && c <= 57 {
            part = part * 10 + (c - 48)
            if part > 255 {
                return 0
            }
            ziffern = ziffern + 1
            i = i + 1
        } else if c == 46 && points < 3 && ziffern > 0 {
            v = (v << 8) | part
            part = 0
            ziffern = 0
            points = points + 1
            i = i + 1
        } else {
            break
        }
    }
    if points != 3 || ziffern == 0 {
        return 0
    }
    return (v << 8) | part
}
