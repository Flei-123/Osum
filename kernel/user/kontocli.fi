// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/kontocli.fi -- DAILY-DRIVER: command line for the installer's
// account step (kernel/user/instkonto.fi). For scripts and tests; the
// installer window calls the same function.
//
//     kontocli - NAME [FULL NAME] < file-with-the-password-line
// (the first argument is ignored, kept for the old call; the account is created
// in the RUNNING root, as root)
//
// The password is read like `passwd` reads it (a line from stdin; no echo
// on a terminal). Prints `kontocli: ok` or `kontocli: FEHLER <reason>`
// (1 name, 2 password, 3 no random, 4 not root, 5 write, 6 home).

profile kernel

import ulib
import pw
import instkonto

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 60] = "kkontocli: kontocli DEVICE NAME [FULL NAME] < password-line\0"
    var s_ok: [u8; 13] = "kontocli: ok\0"
    var s_fail: [u8; 18] = "kontocli: FEHLER \0"
    var q: [u8; 11] = "password: \0"
    if ulib.arg_count(args) < 3 {
        ulib.say((&s_use[0]) as u64)
        ulib.nl()
        return 2
    }
    var pass: [u8; 128] = [0 as u8; 128]
    pw.read_pass((&q[0]) as u64, (&pass[0]) as u64, 128)
    var voll: [u8; 4] = [0 as u8; 4]
    var vp: u64 = (&voll[0]) as u64
    if ulib.arg_count(args) > 3 {
        vp = ulib.arg_at(args, 3)
    }
    if instkonto.anlegen(ulib.arg_at(args, 2), vp, (&pass[0]) as u64) {
        ulib.say((&s_ok[0]) as u64)
        ulib.nl()
        return 0
    }
    ulib.say((&s_fail[0]) as u64)
    ulib.sayu(instkonto.grund())
    ulib.nl()
    return 1
}
