profile kernel

import ulib
import bootcfg

export { log_hint }

static mut s_log_file: [u8; 22] = "installer: boot file \0"
static mut s_log_entry: [u8; 27] = "installer: register entry \0"
static mut s_log_step: [u8; 78] = "installer: keep the stick plugged in, restart, choose the register entry once\0"

fn log_hint() {
    ulib.say((&s_log_file[0 as usize]) as u64)
    ulib.say(bootcfg.loader_display())
    ulib.nl()
    ulib.say((&s_log_entry[0 as usize]) as u64)
    ulib.say(bootcfg.register_entry())
    ulib.nl()
    ulib.say((&s_log_step[0 as usize]) as u64)
    ulib.nl()
}
