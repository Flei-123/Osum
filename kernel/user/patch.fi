// kernel/user/patch.fi -- Runde K11: was `diff` erzeugt, wieder einspielen.
//
// Liest eine VEREINHEITLICHTE Differenz (`diff -u`) von der
// Standardeingabe -- also `patch < d.diff`, so wie ueberall -- und
// aendert die Datei, die im `+++`-Kopf steht.
//
//   -p N   so viele Pfadteile vorn wegnehmen (`-p1` macht aus
//          `a/x/y.c` das `x/y.c`)
//   -R     rueckwaerts: die Differenz wird umgedreht, aus `-` wird `+`
//   -o F   das Ergebnis nach F statt an die Stelle der Vorlage
//
// WIE EIN BLOCK SEINE STELLE FINDET: zuerst dort, wo die Kopfzeile es
// sagt. Passt der Zusammenhang nicht, wird bis zu 32 Zeilen davor und
// dahinter gesucht -- das ist der `offset`, den jedes `patch` meldet.
// Passt er nirgends, ist der Block ABGELEHNT und der Beendigungscode 1;
// die uebrigen Bloecke werden trotzdem eingespielt, wie ueberall.
//
// Kein `fuzz`: eine Umgebung, die nur ungefaehr passt, ist genau die
// Stelle, an der ein `patch` Unsinn in eine Datei schreibt.

profile kernel

import ulib
import tools

export { u_start }

const MAXL: u64 = 512
const POOL: u64 = 24576
const OUTP: u64 = 32768
const SEARCH: u64 = 32

static mut pbuf: [u8; 24576] = [0 as u8; 24576]
static mut pat: [u64; 512] = [0 as u64; 512]
static mut plen: [u64; 512] = [0 as u64; 512]
static mut pn: u64 = 0

static mut tbuf: [u8; 24576] = [0 as u8; 24576]
static mut tat: [u64; 512] = [0 as u64; 512]
static mut tlen: [u64; 512] = [0 as u64; 512]
static mut tn: u64 = 0
static mut tnonl: bool = false

static mut obuf: [u8; 32768] = [0 as u8; 32768]
static mut oat: u64 = 0
static mut onl: bool = true

static mut name: [u8; 256] = [0 as u8; 256]
static mut target: [u8; 256] = [0 as u8; 256]
static mut strip: u64 = 0
static mut reverse: bool = false
static mut failed: u64 = 0
static mut applied: u64 = 0

fn line_at(buf: u64, at: u64, i: u64) -> u64 {
    return buf + *((at + i * 8) as *mut u64)
}

// Einen ganzen Deskriptor einlesen und in Zeilen zerlegen. Gibt die Zahl
// der Zeilen oder EOF.
fn slurp(fd: u64, buf: u64, at: u64, len: u64, nonl: u64) -> u64 {
    var total: u64 = 0
    var going: bool = true
    while going {
        let n: u64 = ulib.sys(ulib.SYS_READ, fd, buf + total, POOL - total)
        if n == 0 || ulib.bad(n) {
            going = false
        } else {
            total = total + n
            if total >= POOL {
                return ulib.EOF
            }
        }
    }
    var lines: u64 = 0
    var start: u64 = 0
    var i: u64 = 0
    while i < total {
        if *((buf + i) as *mut u8) == 10 as u8 {
            if lines >= MAXL {
                return ulib.EOF
            }
            __mmio_write64((at + lines * 8) as *mut u64, start)
            __mmio_write64((len + lines * 8) as *mut u64, i - start)
            lines = lines + 1
            start = i + 1
        }
        i = i + 1
    }
    __mmio_write8((nonl) as *mut u8, 0 as u8)
    if start < total {
        if lines >= MAXL {
            return ulib.EOF
        }
        __mmio_write64((at + lines * 8) as *mut u64, start)
        __mmio_write64((len + lines * 8) as *mut u64, total - start)
        lines = lines + 1
        __mmio_write8((nonl) as *mut u8, 1 as u8)
    }
    return lines
}

fn out_line(p: u64, n: u64, with_nl: bool) {
    var i: u64 = 0
    while i < n && oat < OUTP {
        obuf[(oat) as usize] = *((p + i) as *mut u8)
        oat = oat + 1
        i = i + 1
    }
    if with_nl && oat < OUTP {
        obuf[(oat) as usize] = 10 as u8
        oat = oat + 1
    }
}

// Der Dateiname aus einer `+++`- oder `---`-Zeile, ohne die ersten
// `strip` Pfadteile und ohne alles ab dem ersten Tabulator.
fn take_name(p: u64, n: u64) {
    var i: u64 = 4
    var end: u64 = n
    var k: u64 = 4
    while k < n {
        if *((p + k) as *mut u8) == 9 as u8 && end == n {
            end = k
        }
        k = k + 1
    }
    var left: u64 = strip
    while left > 0 {
        var found: bool = false
        var j: u64 = i
        while j < end && !found {
            if *((p + j) as *mut u8) == 47 as u8 {
                i = j + 1
                found = true
            }
            j = j + 1
        }
        if !found {
            left = 0
        } else {
            left = left - 1
        }
    }
    var w: u64 = 0
    while i < end && w + 1 < 256 {
        name[(w) as usize] = *((p + i) as *mut u8)
        w = w + 1
        i = i + 1
    }
    name[(w) as usize] = 0 as u8
}

fn starts(p: u64, n: u64, lit: u64, ln: u64) -> bool {
    if n < ln {
        return false
    }
    return tools.same_bytes(p, lit, ln)
}

// Passt der Block ab Zeile `pos` (0-basiert) auf die Vorlage?
fn fits(from: u64, to: u64, pos: u64) -> bool {
    var t: u64 = pos
    var i: u64 = from
    while i < to {
        let p: u64 = line_at((&pbuf[0 as usize]) as u64,
            (&pat[0 as usize]) as u64, i)
        let n: u64 = plen[(i) as usize]
        var c: u64 = 32
        if n > 0 {
            c = (*((p) as *mut u8)) as u64
        }
        if c == 92 {
            i = i + 1
        } else {
            var want_old: bool = c == 32
            if !reverse && c == 45 {
                want_old = true
            }
            if reverse && c == 43 {
                want_old = true
            }
            if want_old {
                if t >= tn {
                    return false
                }
                if tlen[(t) as usize] != n - 1 {
                    return false
                }
                if !tools.same_bytes(line_at((&tbuf[0 as usize]) as u64,
                        (&tat[0 as usize]) as u64, t), p + 1, n - 1) {
                    return false
                }
                t = t + 1
            }
            i = i + 1
        }
    }
    return true
}

// Den Block einspielen: alles vor `pos` ist schon geschrieben.
fn emit(from: u64, to: u64, pos: u64) -> u64 {
    var t: u64 = pos
    var i: u64 = from
    while i < to {
        let p: u64 = line_at((&pbuf[0 as usize]) as u64,
            (&pat[0 as usize]) as u64, i)
        let n: u64 = plen[(i) as usize]
        var c: u64 = 32
        if n > 0 {
            c = (*((p) as *mut u8)) as u64
        }
        if c == 92 {
            // "\ No newline at end of file" gilt fuer die ZULETZT
            // geschriebene Zeile.
            onl = false
            i = i + 1
        } else {
            var take_old: bool = false
            var take_new: bool = false
            if c == 32 {
                take_old = true
                take_new = true
            } else if c == 45 {
                if reverse {
                    take_new = true
                } else {
                    take_old = true
                }
            } else if c == 43 {
                if reverse {
                    take_old = true
                } else {
                    take_new = true
                }
            }
            if take_new {
                onl = true
                out_line(p + 1, n - 1, true)
            }
            if take_old {
                t = t + 1
            }
            i = i + 1
        }
    }
    return t
}

fn u_start(args: u64) -> u64 {
    var s_big: [u8; 24] = "patch: input too big\0\0\0\0"
    var s_none: [u8; 30] = "patch: no unified diff found\0\0"
    var s_open: [u8; 22] = "patch: cannot read \0\0\0"
    var s_write: [u8; 23] = "patch: cannot write \0\0\0"
    var s_rej: [u8; 27] = "patch: hunk FAILED at line\0"
    var l_minus: [u8; 5] = "--- \0"
    var l_plus: [u8; 5] = "+++ \0"
    var l_at: [u8; 5] = "@@ -\0"
    var o_p: [u8; 3] = "-p\0"
    var o_r: [u8; 3] = "-R\0"
    var o_o: [u8; 3] = "-o\0"
    var outname: u64 = 0
    let argc: u64 = ulib.arg_count(args)
    var at: u64 = 1
    while at < argc {
        let a: u64 = ulib.arg_at(args, at)
        if ulib.streq(a, (&o_p[0 as usize]) as u64) && at + 1 < argc {
            strip = ulib.to_num(ulib.arg_at(args, at + 1))
            at = at + 2
        } else if ulib.streq(a, (&o_r[0 as usize]) as u64) {
            reverse = true
            at = at + 1
        } else if ulib.streq(a, (&o_o[0 as usize]) as u64) && at + 1 < argc {
            outname = ulib.arg_at(args, at + 1)
            at = at + 2
        } else {
            at = at + 1
        }
    }
    let r: u64 = slurp(ulib.IN, (&pbuf[0 as usize]) as u64,
        (&pat[0 as usize]) as u64, (&plen[0 as usize]) as u64,
        (&target[0 as usize]) as u64)
    if r == ulib.EOF {
        ulib.esay_line((&s_big[0 as usize]) as u64, 0)
        return 2
    }
    pn = r
    // Der Kopf. Die Vorlage ist die Datei aus `+++`; bei `-R` die aus
    // `---`, denn dann ist sie die, die dasteht.
    var head: u64 = ulib.EOF
    var i: u64 = 0
    while i + 1 < pn && head == ulib.EOF {
        let a: u64 = line_at((&pbuf[0 as usize]) as u64,
            (&pat[0 as usize]) as u64, i)
        let b: u64 = line_at((&pbuf[0 as usize]) as u64,
            (&pat[0 as usize]) as u64, i + 1)
        if starts(a, plen[(i) as usize], (&l_minus[0 as usize]) as u64, 4)
        && starts(b, plen[(i + 1) as usize], (&l_plus[0 as usize]) as u64, 4) {
            if reverse {
                take_name(b, plen[(i + 1) as usize])
            } else {
                take_name(a, plen[(i) as usize])
            }
            head = i + 2
        }
        i = i + 1
    }
    if head == ulib.EOF {
        ulib.esay_line((&s_none[0 as usize]) as u64, 0)
        return 2
    }
    ulib.strcpy((&target[0 as usize]) as u64, (&name[0 as usize]) as u64)
    let fd: u64 = tools.openr((&target[0 as usize]) as u64)
    var nl: [u8; 1] = [0 as u8; 1]
    if ulib.bad(fd) {
        tn = 0
        tnonl = false
    } else {
        let t: u64 = slurp(fd, (&tbuf[0 as usize]) as u64,
            (&tat[0 as usize]) as u64, (&tlen[0 as usize]) as u64,
            (&nl[0 as usize]) as u64)
        ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
        if t == ulib.EOF {
            ulib.esay_line((&s_big[0 as usize]) as u64, 0)
            return 2
        }
        tn = t
        tnonl = nl[0 as usize] == 1 as u8
    }
    var done: u64 = 0
    i = head
    while i < pn {
        let p: u64 = line_at((&pbuf[0 as usize]) as u64,
            (&pat[0 as usize]) as u64, i)
        if starts(p, plen[(i) as usize], (&l_at[0 as usize]) as u64, 4) {
            var e: [u64; 1] = [0 as u64; 1]
            var want: u64 = tools.dec_at(p, 4, (&e[0 as usize]) as u64)
            if reverse {
                // Bei `-R` zaehlt die zweite Zahl der Kopfzeile.
                var j: u64 = e[0 as usize]
                while j < plen[(i) as usize]
                && *((p + j) as *mut u8) != 43 as u8 {
                    j = j + 1
                }
                want = tools.dec_at(p, j + 1, (&e[0 as usize]) as u64)
            }
            var from: u64 = i + 1
            var to: u64 = from
            while to < pn {
                let q: u64 = line_at((&pbuf[0 as usize]) as u64,
                    (&pat[0 as usize]) as u64, to)
                let n: u64 = plen[(to) as usize]
                var c: u64 = 32
                if n > 0 {
                    c = (*((q) as *mut u8)) as u64
                }
                if c == 32 || c == 43 || c == 45 || c == 92 {
                    to = to + 1
                } else {
                    to = pn
                }
            }
            to = from
            var scanning: bool = true
            while scanning && to < pn {
                let q: u64 = line_at((&pbuf[0 as usize]) as u64,
                    (&pat[0 as usize]) as u64, to)
                let n: u64 = plen[(to) as usize]
                var c: u64 = 0
                if n > 0 {
                    c = (*((q) as *mut u8)) as u64
                }
                if n == 0 || c == 32 || c == 43 || c == 45 || c == 92 {
                    to = to + 1
                } else {
                    scanning = false
                }
            }
            // Die Stelle suchen.
            var pos: u64 = 0
            if want > 0 {
                pos = want - 1
            }
            if pos < done {
                pos = done
            }
            var found: u64 = ulib.EOF
            if fits(from, to, pos) {
                found = pos
            } else {
                var d: u64 = 1
                while d <= SEARCH && found == ulib.EOF {
                    if pos >= d && pos - d >= done && fits(from, to, pos - d) {
                        found = pos - d
                    } else if pos + d <= tn && fits(from, to, pos + d) {
                        found = pos + d
                    }
                    d = d + 1
                }
            }
            if found == ulib.EOF {
                ulib.esay_line((&s_rej[0 as usize]) as u64, 0)
                failed = failed + 1
            } else {
                var k: u64 = done
                while k < found {
                    out_line(line_at((&tbuf[0 as usize]) as u64,
                        (&tat[0 as usize]) as u64, k), tlen[(k) as usize], true)
                    k = k + 1
                }
                done = emit(from, to, found)
                applied = applied + 1
            }
            i = to
        } else {
            i = i + 1
        }
    }
    var k: u64 = done
    while k < tn {
        var last_nl: bool = true
        if k + 1 == tn && tnonl {
            last_nl = false
        }
        out_line(line_at((&tbuf[0 as usize]) as u64,
            (&tat[0 as usize]) as u64, k), tlen[(k) as usize], last_nl)
        if !last_nl {
            onl = false
        }
        k = k + 1
    }
    if !onl && oat > 0 && obuf[(oat - 1) as usize] == 10 as u8 {
        oat = oat - 1
    }
    var dest: u64 = (&target[0 as usize]) as u64
    if outname != 0 {
        dest = outname
    }
    let out: u64 = tools.openw(dest)
    if ulib.bad(out) {
        ulib.esay_line((&s_write[0 as usize]) as u64, dest)
        return 2
    }
    var w: u64 = 0
    while w < oat {
        var chunk: u64 = oat - w
        if chunk > 4096 {
            chunk = 4096
        }
        let n: u64 = ulib.sys(ulib.SYS_WRITE, out,
            (&obuf[(w) as usize]) as u64, chunk)
        if ulib.bad(n) || n == 0 {
            ulib.esay_line((&s_write[0 as usize]) as u64, dest)
            ulib.sys(ulib.SYS_CLOSE, out, 0, 0)
            return 2
        }
        w = w + n
    }
    ulib.sys(ulib.SYS_CLOSE, out, 0, 0)
    if failed > 0 {
        return 1
    }
    return 0
}
