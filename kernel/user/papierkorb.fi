// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/papierkorb.fi -- Runde ALLTAG: DAS FENSTER ZUM KORB.
//
//   papierkorb                      das Fenster
//   papierkorb liste                aufzaehlen, was drin liegt
//   papierkorb weg <datei>          hineinlegen (das tut sonst der Explorer)
//   papierkorb zurueck <nummer>     wieder herausholen
//   papierkorb entfernen <nummer>   endgueltig, nur dieses eine
//   papierkorb leeren               endgueltig, alles
//
// Die Arbeit steht in `korb.fi` -- hier ist nur die Bedienung. Das ist
// kein Aufteilen um des Aufteilens willen: der Dateimanager legt ueber
// dieselbe Bibliothek hinein, und zwei Vorstellungen davon, wo der Korb
// liegt, waeren zwei Papierkoerbe.
//
// Die Oberflaeche ist eine Tabelle, drei Knoepfe und eine Zeile, die
// sagt, wie voll er ist. Alles davon kommt aus wlib.

// RUNDE GRUNDLINIE: profile app -- dieses Programm malt mit `wlib`, und
// `wlib` malt seit Runde 31 mit fUi. fUi rechnet in `f64` und benutzt
// `std.rt`; beides ist unter `profile kernel` gesperrt:
//
//     error: the module 'std.rt' belongs to the standard library and
//     is not available in profile 'kernel'
//
// Die sieben Programme des Schreibtischs (desktop, taskbar, settings,
// launcher, explorer, widgetdemo, taskmgr) stehen seit Runde 31 bzw.
// ABBILD auf `app`. Diese elf hier sind dabei uebersehen worden -- sie
// haben nie jemand gebaut ausser `fas` in K16, und dort fielen sie unter
// dem Sammelbefund "fas scheitert an" nicht auf.
profile app

import ulib
import libc.io
import trash
import fuiscene

export { u_start }

static mut blob: [u8; 20480] = [0 as u8; 20480]
static mut bp: u64 = 0
static mut kopf: [u8; 160] = [0 as u8; 160]
static mut spalten: [u64; 4] = [0; 4]
static mut root: [u8; 2] = "/\0"

static mut T_TITEL: [u8; 11] = "Papierkorb\0"
static mut T_APP: [u8; 11] = "papierkorb\0"
static mut T_ZUR: [u8; 17] = "Wiederherstellen\0"
static mut T_ENT: [u8; 20] = "Endgültig löschen\0"
static mut T_LEER: [u8; 7] = "Leeren\0"
static mut T_NEU: [u8; 10] = "Neu lesen\0"
static mut T_VON: [u8; 13] = " Einträge, \0"
static mut T_VON2: [u8; 6] = " von \0"
static mut T_MIB: [u8; 5] = " MiB\0"
static mut T_LEERTXT: [u8; 24] = "Der Papierkorb ist leer\0"

fn say(p: u64) {
    ulib.say(p)
}

fn put(c: u64) {
    if bp + 2 < 20480 {
        __mmio_write8(((&blob[(0) as usize]) as u64 + bp) as *mut u8,
            c as u8)
        bp = bp + 1
    }
}

fn puts(p: u64) {
    var i: u64 = 0
    while *((p + i) as *mut u8) != 0 as u8 {
        put((*((p + i) as *mut u8)) as u64)
        i = i + 1
    }
}

fn putn(v: u64) {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = ulib.digits(v, (&z[(0) as usize]) as u64)
    var i: u64 = 0
    while i < n {
        put(z[(i) as usize] as u64)
        i = i + 1
    }
}

fn end() {
    __mmio_write8(((&blob[(0) as usize]) as u64 + bp) as *mut u8, 0 as u8)
}

// Der Ort, aus dem die Datei kam -- ohne ihren Namen, denn der steht
// schon in der ersten Spalte.
fn place(pfad: u64, out: u64, max: u64) {
    let base: u64 = ulib.base_name(pfad)
    var n: u64 = base - pfad
    if n > 1 {
        n = n - 1
    }
    if n + 1 > max {
        n = max - 1
    }
    ulib.copy(out, pfad, n)
    __mmio_write8((out + n) as *mut u8, 0 as u8)
}

// ---- the window, described for fUi's scene tree (fuiscene) ------------

const K_TAB: u64 = 1
const K_ZUR: u64 = 2
const K_ENT: u64 = 3
const K_LEER: u64 = 4
const K_NEU: u64 = 5

static mut cell: [u8; 160] = [0 as u8; 160]
static mut T_C0: [u8; 5] = "Name\0"
static mut T_C1: [u8; 8] = "Kam aus\0"
static mut T_C2: [u8; 10] = "Gelöscht\0"
static mut T_C3: [u8; 8] = "Größe\0"

// The text of a cell of the table (row == HEAD_ROW: the header). The
// answer lives in `cell` until the next call -- the table draws it at once.
fn zelle(row: u64, col: u64) -> u64 {
    let c: u64 = (&cell[(0) as usize]) as u64
    if row == fuiscene.HEAD_ROW {
        if col == 0 {
            return (&T_C0[(0) as usize]) as u64
        }
        if col == 1 {
            return (&T_C1[(0) as usize]) as u64
        }
        if col == 2 {
            return (&T_C2[(0) as usize]) as u64
        }
        return (&T_C3[(0) as usize]) as u64
    }
    if row >= trash.anzahl() {
        __mmio_write8(c as *mut u8, 0 as u8)
        return c
    }
    if col == 0 {
        return trash.name_von(row)
    }
    if col == 1 {
        place(trash.path_from(row), c, 120)
        return c
    }
    if col == 2 {
        return trash.time_text(trash.time_from(row))
    }
    let n: u64 = ulib.digits(trash.size_from(row), c)
    __mmio_write8((c + n) as *mut u8, 0 as u8)
    return c
}

fn header_build() {
    let k: u64 = (&kopf[(0) as usize]) as u64
    var z: [u8; 24] = [0 as u8; 24]
    if trash.anzahl() == 0 {
        ulib.strcpy(k, (&T_LEERTXT[(0) as usize]) as u64)
        return
    }
    var n: u64 = ulib.digits(trash.anzahl(), (&z[(0) as usize]) as u64)
    z[(n) as usize] = 0 as u8
    ulib.strcpy(k, (&z[(0) as usize]) as u64)
    ulib.strcat(k, (&T_VON[(0) as usize]) as u64)
    n = ulib.digits((trash.sum() + 1048575) / 1048576,
        (&z[(0) as usize]) as u64)
    z[(n) as usize] = 0 as u8
    ulib.strcat(k, (&z[(0) as usize]) as u64)
    ulib.strcat(k, (&T_VON2[(0) as usize]) as u64)
    n = ulib.digits(trash.grenze() / 1048576, (&z[(0) as usize]) as u64)
    z[(n) as usize] = 0 as u8
    ulib.strcat(k, (&z[(0) as usize]) as u64)
    ulib.strcat(k, (&T_MIB[(0) as usize]) as u64)
}

fn new_read() {
    let _n: u64 = trash.load((&root[(0) as usize]) as u64)
    header_build()
    fuiscene.table_set_rows(K_TAB, trash.anzahl())
    fuiscene.table_set_sel(K_TAB, 0)
    fuiscene.refresh()
}

fn gewaehlt() -> u64 {
    let z: u64 = fuiscene.table_sel(K_TAB)
    if z >= trash.anzahl() {
        return 0xFFFFFFFFFFFFFFFF
    }
    return z
}

fn build() {
    let col: usize = fuiscene.root()
    let _k: usize = fuiscene.label(col, (&kopf[(0) as usize]) as u64)
    let t: usize = fuiscene.table(col, K_TAB, 604, 260, 4, true, trash.anzahl(), zelle)
    let _t: usize = t
    let bar: usize = fuiscene.row(col)
    fuiscene.set_gap(bar, 8)
    let b1: usize = fuiscene.button(bar, (&T_ZUR[(0) as usize]) as u64, K_ZUR)
    fuiscene.set_size(b1, 152, 36)
    let b2: usize = fuiscene.button(bar, (&T_ENT[(0) as usize]) as u64, K_ENT)
    fuiscene.set_size(b2, 160, 36)
    let b3: usize = fuiscene.button(bar, (&T_LEER[(0) as usize]) as u64, K_LEER)
    fuiscene.set_size(b3, 92, 36)
    let b4: usize = fuiscene.button(bar, (&T_NEU[(0) as usize]) as u64, K_NEU)
    fuiscene.set_size(b4, 112, 36)
}

fn u_gui() -> u64 {
    var s_bad: [u8; 26] = "papierkorb: keine Flaeche\0"
    var s_go: [u8; 18] = "papierkorb: ready\0"
    var s_geom: [u8; 20] = "papierkorb: geom w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_n: [u8; 23] = "papierkorb: eintraege \0"
    let bw: u64 = 620
    let bh: u64 = 360
    let _n0: u64 = trash.load((&root[(0) as usize]) as u64)
    header_build()
    if !fuiscene.open(70, 70, bw, bh, (&T_TITEL[(0) as usize]) as u64, build) {
        say((&s_bad[(0) as usize]) as u64)
        ulib.nl()
        return 1
    }
    var first: bool = true
    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        if first {
            first = false
            fuiscene.table_colw(K_TAB, 0, 160)
            fuiscene.table_colw(K_TAB, 1, 200)
            fuiscene.table_colw(K_TAB, 2, 140)
            fuiscene.table_colw(K_TAB, 3, 84)
            say((&s_geom[(0) as usize]) as u64)
            ulib.sayn(bw)
            say((&s_h[(0) as usize]) as u64)
            ulib.sayn(bh)
            ulib.nl()
            say((&s_n[(0) as usize]) as u64)
            ulib.sayn(trash.anzahl())
            ulib.nl()
            var s_nm: [u8; 11] = "papierkorb\0"
            fuiscene.say_rects((&s_nm[(0) as usize]) as u64)
            fuiscene.say_texts()
            say((&s_go[(0) as usize]) as u64)
            ulib.nl()
        }
        if key == K_NEU {
            new_read()
        } else if key == K_LEER {
            let _g: u64 = trash.leeren((&root[(0) as usize]) as u64)
            new_read()
        } else if key == K_ZUR {
            let z: u64 = gewaehlt()
            if z != 0xFFFFFFFFFFFFFFFF {
                let _r: u64 = trash.back((&root[(0) as usize]) as u64, trash.id_von(z))
            }
            new_read()
        } else if key == K_ENT {
            let z2: u64 = gewaehlt()
            if z2 != 0xFFFFFFFFFFFFFFFF {
                let _e: bool = trash.entfernen((&root[(0) as usize]) as u64, trash.id_von(z2))
            }
            new_read()
        }
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var c_liste: [u8; 6] = "liste\0"
    var c_weg: [u8; 4] = "weg\0"
    var c_zur: [u8; 8] = "zurueck\0"
    // Die Hilfe zeigt "zurück" -- beide Schreibungen kommen an.
    var c_zur_u: [u8; 8] = "zurück\0"
    var c_ent: [u8; 10] = "entfernen\0"
    var c_leer: [u8; 7] = "leeren\0"
    var c_aus: [u8; 12] = "ausloeschen\0"
    var c_aus_u: [u8; 12] = "auslöschen\0"
    var s_use: [u8; 71] = "papierkorb: liste | weg <datei> | zurück <n> | entfernen <n> | leeren\0"
    var s_nr: [u8; 20] = "papierkorb: nummer \0"
    var s_leer: [u8; 17] = "papierkorb: leer\0"
    var s_weg: [u8; 22] = "papierkorb: entfernt \0"
    var s_sp: [u8; 3] = "  \0"
    var s_kein: [u8; 25] = "papierkorb: geht nicht: \0"
    var s_zurok: [u8; 24] = "papierkorb: wieder da: \0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        return u_gui()
    }
    let cmd: u64 = ulib.arg_at(args, 1)
    let wz: u64 = (&root[(0) as usize]) as u64
    if ulib.streq(cmd, (&c_liste[(0) as usize]) as u64) {
        let n: u64 = trash.load(wz)
        if n == 0 {
            say((&s_leer[(0) as usize]) as u64)
            ulib.nl()
            return 0
        }
        var i: u64 = 0
        while i < n {
            say((&s_nr[(0) as usize]) as u64)
            ulib.sayn(trash.id_von(i))
            say((&s_sp[(0) as usize]) as u64)
            say(trash.path_from(i))
            say((&s_sp[(0) as usize]) as u64)
            ulib.sayn(trash.size_from(i))
            say((&s_sp[(0) as usize]) as u64)
            say(trash.time_text(trash.time_from(i)))
            ulib.nl()
            i = i + 1
        }
        return 0
    }
    if ulib.streq(cmd, (&c_weg[(0) as usize]) as u64) && argc >= 3 {
        let p: u64 = ulib.arg_at(args, 2)
        let id: u64 = trash.hinein(p)
        if id == 0 {
            ulib.esay_line((&s_kein[(0) as usize]) as u64, p)
            return 1
        }
        say((&s_nr[(0) as usize]) as u64)
        ulib.sayn(id)
        ulib.nl()
        return 0
    }
    if (ulib.streq(cmd, (&c_zur[(0) as usize]) as u64) || ulib.streq(cmd, (&c_zur_u[(0) as usize]) as u64)) && argc >= 3 {
        let id2: u64 = ulib.to_num(ulib.arg_at(args, 2))
        let r: u64 = trash.back(wz, id2)
        if r != 0 {
            ulib.esay_line((&s_kein[(0) as usize]) as u64,
                ulib.arg_at(args, 2))
            return 1
        }
        say((&s_zurok[(0) as usize]) as u64)
        ulib.sayn(id2)
        ulib.nl()
        return 0
    }
    if ulib.streq(cmd, (&c_ent[(0) as usize]) as u64) && argc >= 3 {
        let id3: u64 = ulib.to_num(ulib.arg_at(args, 2))
        if !trash.entfernen(wz, id3) {
            ulib.esay_line((&s_kein[(0) as usize]) as u64,
                ulib.arg_at(args, 2))
            return 1
        }
        say((&s_weg[(0) as usize]) as u64)
        ulib.sayn(id3)
        ulib.nl()
        return 0
    }
    // ENDGUELTIG UND OHNE KORB -- das, was der Dateimanager bei
    // Umschalt+Entf tut, auf der Konsole nachzumessen.
    if (ulib.streq(cmd, (&c_aus[(0) as usize]) as u64) || ulib.streq(cmd, (&c_aus_u[(0) as usize]) as u64)) && argc >= 3 {
        if !trash.loesche_rekursiv(ulib.arg_at(args, 2), 0) {
            ulib.esay_line((&s_kein[(0) as usize]) as u64,
                ulib.arg_at(args, 2))
            return 1
        }
        say((&s_weg[(0) as usize]) as u64)
        say(ulib.arg_at(args, 2))
        ulib.nl()
        return 0
    }
    if ulib.streq(cmd, (&c_leer[(0) as usize]) as u64) {
        let g: u64 = trash.leeren(wz)
        say((&s_weg[(0) as usize]) as u64)
        ulib.sayn(g)
        ulib.nl()
        return 0
    }
    ulib.esay_line((&s_use[(0) as usize]) as u64, 0)
    return 2
}

// RUNDE ROTABSCHNITTE: DIESES `main` LAEUFT, UND ES MUSS DIE
// ARGUMENTE WEITERGEBEN.
//
// Der Kommentar, der hier stand, sagte "das `main`, das nie laeuft --
// `user.ld` springt nach `u_start`". Das stimmt fuer ein Programm, das
// mit `kernel/user/crt.s` gebunden ist; dessen `_start` ruft
// USER_ENTRY. Unter `profile app` stimmt es NICHT: dort bringt firnc
// sein eigenes `_start` mit (darum darf crt.o nicht dazu, siehe
// tools/look/shot.sh), und das endet in `call main` -- der Name steht
// fest in lib/firnc1/codegen.fi, `--defsym=USER_ENTRY` erreicht ihn
// nicht. Am gebauten ELF nachgesehen: Einsprung ist `_start`, sechs
// Befehle weiter steht `call <main>`; `_F0.u_start` wird von dort nie
// gerufen.
//
// `u_start(0)` warf damit den Argumentblock weg. Bei powermon waren
// das 54 rote Zusagen (siehe ROTABSCHNITTE 11/n).
//
// Der Block liegt an einer FESTEN Adresse: Runde K16 legte den
// Stapelzeiger darauf (kernel/elf.fi, `T_USTACK = proc.ARGS_BASE`),
// und firnc's `_start` macht `mov rsp, rdi`. Jede `elf: start`-Zeile
// dieses Systems druckt sie als `ustack=0x4007f000`.
fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
