
profile kernel

import ulib
import tools

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 30] = "seq: needs one to three counts"
    var s_zero: [u8; 25] = "seq: the step is zero\0\0\0\0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 || argc > 4 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    var first: u64 = 1
    var step: u64 = 1
    var last: u64 = 0
    if argc == 2 {
        last = ulib.to_num(ulib.arg_at(args, 1))
    } else if argc == 3 {
        first = ulib.to_num(ulib.arg_at(args, 1))
        last = ulib.to_num(ulib.arg_at(args, 2))
    } else {
        first = ulib.to_num(ulib.arg_at(args, 1))
        step = ulib.to_num(ulib.arg_at(args, 2))
        last = ulib.to_num(ulib.arg_at(args, 3))
    }
    if step == 0 {
        ulib.esay_line((&s_zero[0 as usize]) as u64, 0)
        return 1
    }
    var v: u64 = first
    var going: bool = v <= last
    while going {
        tools.ob_num(v)
        tools.ob_nl()
        if last - v < step {
            going = false
        } else {
            v = v + step
        }
    }
    tools.ob_flush()
    return 0
}
