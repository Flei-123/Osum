profile kernel

import ulib
import wl_input

export { SHAPE_MAX, FORM_NONE, form_for_shape, apply_shape, apply_surface_cursor }

const WIG_CURSOR: u64 = 1806
const SHAPE_MAX: u64 = 36
const FORM_NONE: u64 = 0xFFFFFFFFFFFFFFFF
const FORM_ARROW: u64 = 0

static mut FORM_BY_SHAPE: [u64; 37] = [0, 0, 0, 0, 2, 8, 8, 7, 7, 1, 1, 0, 10, 11, 9, 9, 2, 11, 3, 4, 6, 5, 4, 5, 6, 3, 3, 4, 6, 5, 3, 4, 11, 0, 0, 10, 11]

fn form_for_shape(shape: u64) -> u64 {
    if shape == 0 || shape > SHAPE_MAX {
        return FORM_NONE
    }
    return FORM_BY_SHAPE[shape as usize]
}

fn apply_form(c: u64, serial: u64, form: u64) {
    if !wl_input.pointer_serial_ok(c, serial) {
        return
    }
    ulib.sys(WIG_CURSOR, form, 0, 0)
}

fn apply_shape(c: u64, serial: u64, shape: u64) {
    apply_form(c, serial, form_for_shape(shape))
}

fn apply_surface_cursor(c: u64, serial: u64) {
    apply_form(c, serial, FORM_ARROW)
}
