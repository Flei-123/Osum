profile app

export { NKEYS, NROWS, ROW_UNITS, K_CHAR, K_PLAIN, K_SHIFT, K_CTRL, K_ALTGR, K_CAPS, K_LAYOUT, K_CLOSE, K_EXT,
    kind, scan, units, row, label, rect_name }

const NKEYS: u64 = 64
const NROWS: u64 = 5
const ROW_UNITS: u64 = 60
const K_CHAR: u64 = 0
const K_PLAIN: u64 = 1
const K_SHIFT: u64 = 2
const K_CTRL: u64 = 3
const K_ALTGR: u64 = 4
const K_CAPS: u64 = 5
const K_LAYOUT: u64 = 6
const K_CLOSE: u64 = 7
const K_EXT: u64 = 8

static mut s_keys: [u64; 64] = [
    272640, 262656, 262912, 263168, 263424, 263680, 263936, 264192,
    264448, 264704, 264960, 265216, 265472, 527873, 17174273, 17043456,
    17043712, 17043968, 17044224, 17044480, 17044736, 17044992, 17045248, 17045504,
    17045760, 17046016, 17046272, 17181440, 34028037, 33824256, 33824512, 33824768,
    33825024, 33825280, 33825536, 33825792, 33826048, 33826304, 33826560, 33826816,
    34151425, 50997762, 50605056, 50605312, 50605568, 50605824, 50606080, 50606336,
    50606592, 50606848, 50607104, 50607360, 50615808, 50738690, 67509507, 67516420,
    67502086, 67502337, 68040961, 67390216, 67389448, 67391496, 67390728, 67502087
]

static mut l_esc: [u8; 4] = "Esc\0"
static mut l_back: [u8; 5] = "Back\0"
static mut l_tab: [u8; 4] = "Tab\0"
static mut l_enter: [u8; 6] = "Enter\0"
static mut l_space: [u8; 1] = "\0"
static mut l_shift: [u8; 6] = "Shift\0"
static mut l_ctrl: [u8; 5] = "Ctrl\0"
static mut l_altgr: [u8; 6] = "AltGr\0"
static mut l_caps: [u8; 5] = "Caps\0"
static mut l_us: [u8; 3] = "US\0"
static mut l_de: [u8; 3] = "DE\0"
static mut l_close: [u8; 2] = "x\0"
static mut l_up: [u8; 4] = b"\xE2\x86\x91\x00"
static mut l_down: [u8; 4] = b"\xE2\x86\x93\x00"
static mut l_left: [u8; 4] = b"\xE2\x86\x90\x00"
static mut l_right: [u8; 4] = b"\xE2\x86\x92\x00"
static mut l_none: [u8; 2] = "?\0"

static mut n_shift: [u8; 6] = "shift\0"
static mut n_ctrl: [u8; 5] = "ctrl\0"
static mut n_altgr: [u8; 6] = "altgr\0"
static mut n_caps: [u8; 5] = "caps\0"
static mut n_lay: [u8; 4] = "lay\0"
static mut n_close: [u8; 6] = "close\0"
static mut n_esc: [u8; 4] = "esc\0"
static mut n_back: [u8; 5] = "back\0"
static mut n_tab: [u8; 4] = "tab\0"
static mut n_enter: [u8; 6] = "enter\0"
static mut n_space: [u8; 6] = "space\0"
static mut n_up: [u8; 3] = "up\0"
static mut n_down: [u8; 5] = "down\0"
static mut n_left: [u8; 5] = "left\0"
static mut n_right: [u8; 6] = "right\0"
static mut n_key: [u8; 6] = "key00\0"

fn entry(i: u64) -> u64 {
    return s_keys[(i) as usize]
}

fn kind(i: u64) -> u64 {
    return entry(i) & 255
}

fn scan(i: u64) -> u64 {
    return (entry(i) >> 8) & 255
}

fn units(i: u64) -> u64 {
    return (entry(i) >> 16) & 255
}

fn row(i: u64) -> u64 {
    return (entry(i) >> 24) & 255
}

fn label(i: u64, us: bool) -> u64 {
    let k: u64 = kind(i)
    let sc: u64 = scan(i)
    if k == K_SHIFT {
        return (&l_shift[0 as usize]) as u64
    }
    if k == K_CTRL {
        return (&l_ctrl[0 as usize]) as u64
    }
    if k == K_ALTGR {
        return (&l_altgr[0 as usize]) as u64
    }
    if k == K_CAPS {
        return (&l_caps[0 as usize]) as u64
    }
    if k == K_CLOSE {
        return (&l_close[0 as usize]) as u64
    }
    if k == K_LAYOUT {
        if us {
            return (&l_us[0 as usize]) as u64
        }
        return (&l_de[0 as usize]) as u64
    }
    if k == K_EXT {
        if sc == 0x48 {
            return (&l_up[0 as usize]) as u64
        }
        if sc == 0x50 {
            return (&l_down[0 as usize]) as u64
        }
        if sc == 0x4B {
            return (&l_left[0 as usize]) as u64
        }
        return (&l_right[0 as usize]) as u64
    }
    if k == K_PLAIN {
        if sc == 0x01 {
            return (&l_esc[0 as usize]) as u64
        }
        if sc == 0x0E {
            return (&l_back[0 as usize]) as u64
        }
        if sc == 0x0F {
            return (&l_tab[0 as usize]) as u64
        }
        if sc == 0x1C {
            return (&l_enter[0 as usize]) as u64
        }
        return (&l_space[0 as usize]) as u64
    }
    return (&l_none[0 as usize]) as u64
}

fn hexdig(v: u64) -> u8 {
    if v < 10 {
        return (48 + v) as u8
    }
    return (87 + v) as u8
}

fn rect_name(i: u64) -> u64 {
    let k: u64 = kind(i)
    let sc: u64 = scan(i)
    if k == K_SHIFT {
        return (&n_shift[0 as usize]) as u64
    }
    if k == K_CTRL {
        return (&n_ctrl[0 as usize]) as u64
    }
    if k == K_ALTGR {
        return (&n_altgr[0 as usize]) as u64
    }
    if k == K_CAPS {
        return (&n_caps[0 as usize]) as u64
    }
    if k == K_LAYOUT {
        return (&n_lay[0 as usize]) as u64
    }
    if k == K_CLOSE {
        return (&n_close[0 as usize]) as u64
    }
    if k == K_EXT {
        if sc == 0x48 {
            return (&n_up[0 as usize]) as u64
        }
        if sc == 0x50 {
            return (&n_down[0 as usize]) as u64
        }
        if sc == 0x4B {
            return (&n_left[0 as usize]) as u64
        }
        return (&n_right[0 as usize]) as u64
    }
    if k == K_PLAIN {
        if sc == 0x01 {
            return (&n_esc[0 as usize]) as u64
        }
        if sc == 0x0E {
            return (&n_back[0 as usize]) as u64
        }
        if sc == 0x0F {
            return (&n_tab[0 as usize]) as u64
        }
        if sc == 0x1C {
            return (&n_enter[0 as usize]) as u64
        }
        return (&n_space[0 as usize]) as u64
    }
    n_key[3 as usize] = hexdig(sc >> 4)
    n_key[4 as usize] = hexdig(sc & 15)
    return (&n_key[0 as usize]) as u64
}
