// SPDX-License-Identifier: MIT
// kernel/user/imggif.fi -- Runde VIEWER: GIF, mit Bewegung.
//
// GIF IST DAS FORMAT, DAS SICH BEWEGT, und genau deshalb steht es hier
// und nicht in der Fussnote: ein Betrachter, der ein animiertes GIF als
// Standbild zeigt, hat es nicht gelesen, sondern nur den ersten
// Ausschnitt davon.
//
// DREI DINGE MACHEN GIF AUS, und alle drei sind hier:
//
//   LZW        Der einzige echte Aufwand. Ein Woerterbuch, das mit
//              jedem gelesenen Code um einen Eintrag waechst, und eine
//              Codebreite, die bei 4096 Eintraegen stehenbleibt, bis
//              ein Loeschcode kommt. Rund 120 Zeilen.
//   Paletten   Eine globale und je Teilbild eine eigene, hoechstens 256
//              Farben, eine davon darf durchsichtig sein.
//   Entsorgung Nach jedem Teilbild sagt der Steuerblock, was mit dem
//              Rechteck passiert: stehenlassen, mit dem Hintergrund
//              fuellen oder den Zustand davor wiederherstellen. WER DAS
//              WEGLAESST, bekommt Schlieren -- das ist der haeufigste
//              Fehler in eigenen GIF-Lesern.
//
// GEZEICHNET WIRD AUF EINE LEINWAND in Bildschirmgroesse des GIF, und
// jedes Teilbild ist ein Rechteck darauf. `next_frame` legt das
// naechste auf; `next_row` liefert die Leinwand, nicht das Teilbild.
// Nur so stimmt ein GIF, dessen zweites Teilbild 12x8 Bildpunkte gross
// ist und irgendwo in der Mitte liegt.

profile kernel

import imgmem

export {
    begin, next_row, next_frame, rewind_rows, width, height, reason,
    frames, delay_ms, frame_index, loops,
    G_OK, G_NOT_GIF, G_TRUNCATED, G_MEMORY, G_FORMAT, G_HUGE
}

const G_OK: u64 = 0
const G_NOT_GIF: u64 = 1
const G_TRUNCATED: u64 = 2
const G_MEMORY: u64 = 3
const G_FORMAT: u64 = 4
const G_HUGE: u64 = 5

const MAXPIX: u64 = 16000000 // eine Leinwand von 16 Megabildpunkten

static mut src: u64 = 0
static mut srcn: u64 = 0
static mut at: u64 = 0
static mut gw: u64 = 0
static mut gh: u64 = 0
static mut greason: u64 = G_OK
static mut canvas: u64 = 0
static mut saved: u64 = 0
static mut gct: u64 = 0 // 256 * 4
static mut lct: u64 = 0
static mut gct_n: u64 = 0
static mut bgidx: u64 = 0
static mut row: u64 = 0
static mut nframes: u64 = 0
static mut fidx: u64 = 0
static mut delay: u64 = 0
static mut gloops: u64 = 0
static mut pend_disposal: u64 = 0
static mut pend_x: u64 = 0
static mut pend_y: u64 = 0
static mut pend_w: u64 = 0
static mut pend_h: u64 = 0
static mut tidx: u64 = 0x1000 // durchsichtiger Index, >255 = keiner

// LZW
static mut lz_prefix: [u16; 4096] = [0 as u16; 4096]
static mut lz_suffix: [u8; 4096] = [0 as u8; 4096]
static mut lz_stack: [u8; 4096] = [0 as u8; 4096]

fn ld8(p: u64) -> u64 {
    return (*((p) as *mut u8)) as u64
}

fn le16(p: u64) -> u64 {
    return ld8(p) | (ld8(p + 1) << 8)
}

fn width() -> u64 {
    return gw
}

fn height() -> u64 {
    return gh
}

fn reason() -> u64 {
    return greason
}

fn frames() -> u64 {
    return nframes
}

fn frame_index() -> u64 {
    return fidx
}

fn delay_ms() -> u64 {
    return delay
}

fn loops() -> u64 {
    return gloops
}

// --------------------------------------------------------------- Kopf

fn begin(p: u64, n: u64) -> bool {
    src = p
    srcn = n
    greason = G_NOT_GIF
    row = 0
    fidx = 0
    nframes = 0
    delay = 100
    gloops = 0
    tidx = 0x1000
    pend_disposal = 0
    if n < 13 {
        return false
    }
    if ld8(p) != 71 || ld8(p + 1) != 73 || ld8(p + 2) != 70 {
        return false
    }
    gw = le16(p + 6)
    gh = le16(p + 8)
    if gw == 0 || gh == 0 {
        greason = G_FORMAT
        return false
    }
    if gw * gh > MAXPIX {
        greason = G_HUGE
        return false
    }
    let flags: u64 = ld8(p + 10)
    bgidx = ld8(p + 11)
    canvas = imgmem.take(gw * gh * 4)
    saved = imgmem.take(gw * gh * 4)
    gct = imgmem.take(1024)
    lct = imgmem.take(1024)
    if canvas == 0 || saved == 0 || gct == 0 || lct == 0 {
        greason = G_MEMORY
        return false
    }
    imgmem.zero(canvas, gw * gh * 4)
    imgmem.zero(gct, 1024)
    at = 13
    gct_n = 0
    if (flags & 128) != 0 {
        gct_n = 1 << ((flags & 7) + 1)
        if at + gct_n * 3 > n {
            greason = G_TRUNCATED
            return false
        }
        read_pal(gct, at, gct_n)
        at = at + gct_n * 3
    }
    // Wie viele Teilbilder gibt es? Einmal durchzaehlen, ohne zu
    // dekodieren -- die Anwendung will die Zahl VOR dem ersten Bild.
    nframes = count_frames()
    greason = G_OK
    if !next_frame() {
        return false
    }
    return true
}

fn read_pal(dst: u64, p: u64, n: u64) {
    var i: u64 = 0
    while i < n && i < 256 {
        __mmio_write8((dst + i * 4) as *mut u8, ld8(p + i * 3) as u8)
        __mmio_write8((dst + i * 4 + 1) as *mut u8,
            ld8(p + i * 3 + 1) as u8)
        __mmio_write8((dst + i * 4 + 2) as *mut u8,
            ld8(p + i * 3 + 2) as u8)
        __mmio_write8((dst + i * 4 + 3) as *mut u8, 255 as u8)
        i = i + 1
    }
}

fn skip_blocks(from: u64) -> u64 {
    var q: u64 = from
    while q < srcn {
        let len: u64 = ld8(q)
        if len == 0 {
            return q + 1
        }
        q = q + 1 + len
    }
    return srcn
}

fn count_frames() -> u64 {
    var q: u64 = at
    var c: u64 = 0
    while q < srcn {
        let b: u64 = ld8(q)
        if b == 44 {
            c = c + 1
            if q + 10 > srcn {
                return c
            }
            let fl: u64 = ld8(q + 9)
            q = q + 10
            if (fl & 128) != 0 {
                q = q + (1 << ((fl & 7) + 1)) * 3
            }
            if q >= srcn {
                return c
            }
            q = q + 1 // LZW-Mindestcodebreite
            q = skip_blocks(q)
        } else if b == 33 {
            if q + 2 > srcn {
                return c
            }
            q = skip_blocks(q + 2)
        } else if b == 59 {
            return c
        } else {
            q = q + 1
        }
    }
    return c
}

// ------------------------------------------------------- die Teilbilder

fn next_frame() -> bool {
    // Was das vorige Teilbild hinterlassen hat, wird zuerst entsorgt.
    if pend_disposal == 2 {
        fill_rect(pend_x, pend_y, pend_w, pend_h)
    } else if pend_disposal == 3 {
        restore_rect(pend_x, pend_y, pend_w, pend_h)
    }
    pend_disposal = 0
    tidx = 0x1000
    while at < srcn {
        let b: u64 = ld8(at)
        if b == 33 {
            // Ein Erweiterungsblock.
            if at + 2 > srcn {
                greason = G_TRUNCATED
                return false
            }
            let kind: u64 = ld8(at + 1)
            if kind == 249 && at + 7 <= srcn {
                let fl: u64 = ld8(at + 3)
                delay = le16(at + 4) * 10
                if delay == 0 {
                    delay = 100
                }
                if (fl & 1) != 0 {
                    tidx = ld8(at + 6)
                }
                pend_disposal = (fl >> 2) & 7
            } else if kind == 255 && at + 16 <= srcn {
                // NETSCAPE2.0: die Zahl der Durchlaeufe.
                if ld8(at + 3) == 78 && ld8(at + 13) == 1 {
                    gloops = le16(at + 14)
                }
            }
            at = skip_blocks(at + 2)
        } else if b == 44 {
            return draw_frame()
        } else if b == 59 {
            return false
        } else {
            at = at + 1
        }
    }
    return false
}

fn fill_rect(x: u64, y: u64, w: u64, h: u64) {
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            if x + c < gw && y + r < gh {
                __mmio_write32((canvas + ((y + r) * gw + x + c) * 4)
                    as *mut u32, 0 as u32)
            }
            c = c + 1
        }
        r = r + 1
    }
}

fn restore_rect(x: u64, y: u64, w: u64, h: u64) {
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            if x + c < gw && y + r < gh {
                let o: u64 = ((y + r) * gw + x + c) * 4
                __mmio_write32((canvas + o) as *mut u32,
                    (*((saved + o) as *mut u32)) as u32)
            }
            c = c + 1
        }
        r = r + 1
    }
}

fn draw_frame() -> bool {
    if at + 10 > srcn {
        greason = G_TRUNCATED
        return false
    }
    let fx: u64 = le16(at + 1)
    let fy: u64 = le16(at + 3)
    let fw: u64 = le16(at + 5)
    let fh: u64 = le16(at + 7)
    let fl: u64 = ld8(at + 9)
    var q: u64 = at + 10
    var pal: u64 = gct
    if (fl & 128) != 0 {
        let n: u64 = 1 << ((fl & 7) + 1)
        if q + n * 3 > srcn {
            greason = G_TRUNCATED
            return false
        }
        read_pal(lct, q, n)
        pal = lct
        q = q + n * 3
    }
    let ilace: u64 = (fl >> 6) & 1
    if q >= srcn {
        greason = G_TRUNCATED
        return false
    }
    // Fuer die Entsorgungsart 3 muss der Zustand VOR dem Zeichnen
    // gesichert sein.
    if pend_disposal == 3 {
        imgmem.copy(saved, canvas, gw * gh * 4)
    }
    pend_x = fx
    pend_y = fy
    pend_w = fw
    pend_h = fh
    let minbits: u64 = ld8(q)
    q = q + 1
    if minbits < 2 || minbits > 11 {
        greason = G_FORMAT
        return false
    }
    let ende: u64 = lzw(q, minbits, pal, fx, fy, fw, fh, ilace)
    at = ende
    fidx = fidx + 1
    row = 0
    return true
}

// ---------------------------------------------------------------- LZW

static mut bitpos: u64 = 0
static mut blk_at: u64 = 0
static mut blk_left: u64 = 0
static mut acc: u64 = 0
static mut accn: u64 = 0

fn nextbyte() -> i64 {
    while blk_left == 0 {
        if blk_at >= srcn {
            return 0 - 1
        }
        let len: u64 = ld8(blk_at)
        blk_at = blk_at + 1
        if len == 0 {
            return 0 - 1
        }
        blk_left = len
    }
    if blk_at >= srcn {
        return 0 - 1
    }
    let b: u64 = ld8(blk_at)
    blk_at = blk_at + 1
    blk_left = blk_left - 1
    return b as i64
}

fn getcode(bits: u64) -> i64 {
    while accn < bits {
        let b: i64 = nextbyte()
        if b < 0 {
            return 0 - 1
        }
        acc = acc | ((b as u64) << accn)
        accn = accn + 8
    }
    let v: u64 = acc & ((1 << bits) - 1)
    acc = acc >> bits
    accn = accn - bits
    return v as i64
}

fn put_px(pal: u64, idx: u64, x: u64, y: u64) {
    if x >= gw || y >= gh {
        return
    }
    if idx == tidx {
        return // durchsichtig: was darunter liegt, bleibt
    }
    let o: u64 = (y * gw + x) * 4
    __mmio_write32((canvas + o) as *mut u32,
        (*((pal + idx * 4) as *mut u32)) as u32)
}

// Gibt zurueck, wo es nach den Datenbloecken weitergeht.
fn lzw(from: u64, minbits: u64, pal: u64, fx: u64, fy: u64, fw: u64,
    fh: u64, ilace: u64) -> u64 {
    blk_at = from
    blk_left = 0
    acc = 0
    accn = 0
    let clear: u64 = 1 << minbits
    let stop: u64 = clear + 1
    var bits: u64 = minbits + 1
    var next: u64 = clear + 2
    var old: i64 = 0 - 1
    var first: u64 = 0
    var px: u64 = 0
    var py: u64 = 0
    var pass: u64 = 0
    var going: bool = true
    while going {
        let code: i64 = getcode(bits)
        if code < 0 {
            going = false
        } else if (code as u64) == clear {
            bits = minbits + 1
            next = clear + 2
            old = 0 - 1
        } else if (code as u64) == stop {
            going = false
        } else {
            var sp: u64 = 0
            var c: u64 = code as u64
            if c >= next {
                // Der Sonderfall KwKwK: der Code, der gerade erst
                // entsteht. Ohne ihn bricht jedes zweite GIF ab.
                if old < 0 {
                    going = false
                    c = 0
                } else {
                    lz_stack[(sp) as usize] = first as u8
                    sp = sp + 1
                    c = old as u64
                }
            }
            if going {
                var guard: u64 = 0
                while c >= clear + 2 && guard < 4096 {
                    lz_stack[(sp) as usize] = lz_suffix[(c) as usize]
                    sp = sp + 1
                    c = lz_prefix[(c) as usize] as u64
                    guard = guard + 1
                }
                first = c
                lz_stack[(sp) as usize] = c as u8
                sp = sp + 1
                // Der Stapel wird rueckwaerts geleert.
                while sp > 0 {
                    sp = sp - 1
                    let idx: u64 = lz_stack[(sp) as usize] as u64
                    if py < fh {
                        put_px(pal, idx, fx + px, fy + py)
                    }
                    px = px + 1
                    if px >= fw {
                        px = 0
                        if ilace != 0 {
                            py = py + il_step(pass)
                            while py >= fh && pass < 3 {
                                pass = pass + 1
                                py = il_start(pass)
                            }
                        } else {
                            py = py + 1
                        }
                    }
                }
                if old >= 0 && next < 4096 {
                    lz_prefix[(next) as usize] = old as u16
                    lz_suffix[(next) as usize] = first as u8
                    next = next + 1
                    if next == (1 << bits) && bits < 12 {
                        bits = bits + 1
                    }
                }
                old = code
            }
        }
    }
    // Bis zum Blockende weiterlesen, damit `at` hinter den Daten steht.
    var q: u64 = blk_at
    if blk_left > 0 {
        q = q + blk_left
    }
    return skip_blocks(q)
}

fn il_start(p: u64) -> u64 {
    var v: [u64; 4] = [0 as u64, 4, 2, 1]
    return v[(p) as usize]
}

fn il_step(p: u64) -> u64 {
    var v: [u64; 4] = [8 as u64, 8, 4, 2]
    return v[(p) as usize]
}

// ------------------------------------------------------------ Ausgabe

fn next_row(dst: u64) -> bool {
    if row >= gh {
        return false
    }
    imgmem.copy(dst, canvas + row * gw * 4, gw * 4)
    row = row + 1
    return true
}

fn rewind_rows() {
    row = 0
}
