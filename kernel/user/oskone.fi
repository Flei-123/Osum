profile app

import ulib

export { close_others }

const NAME_OSK: u64 = 0x6B736F
const SLOTS: u64 = 128
const ST_ZOMBIE: u64 = 5
const EXIT_KILLED: u64 = 137

fn close_others() -> u64 {
    let me: u64 = ulib.sys(ulib.SYS_GETPID, 0, 0, 0)
    var closed: u64 = 0
    var i: u64 = 0
    while i < SLOTS {
        let st: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_STATE, 0)
        if !ulib.bad(st) && st != 0 && st < ST_ZOMBIE {
            let pid: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PID, 0)
            let n0: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_NAME0, 0)
            let n1: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_NAME1, 0)
            if pid != me && n0 == NAME_OSK && n1 == 0 {
                let _k: u64 = ulib.sys(ulib.SYS_KILL, pid, EXIT_KILLED, 0)
                closed = closed + 1
            }
        }
        i = i + 1
    }
    return closed
}
