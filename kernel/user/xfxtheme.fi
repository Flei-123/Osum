profile kernel

import ulib
import libc.text
import xfxio

export { mode, append_prefs, env_gtk, MODE_LIGHT, MODE_DARK, MODE_AUTO }

const MODE_LIGHT: u64 = 0
const MODE_DARK: u64 = 1
const MODE_AUTO: u64 = 2
const CONF_MAX: u64 = 1024
const NEWLINE: u64 = 10
const MODE_KEY_LEN: u64 = 5

fn mode() -> u64 {
    var p_conf: [u8; 16] = "/etc/theme.conf\0"
    var k_mode: [u8; 6] = "mode=\0"
    var buf: [u8; 1024] = [0 as u8; 1024]
    let n: u64 = xfxio.read_text((&p_conf[0 as usize]) as u64, (&buf[0 as usize]) as u64, CONF_MAX)
    if n == ulib.EOF {
        return MODE_AUTO
    }
    var i: u64 = 0
    while i + MODE_KEY_LEN < n {
        let line_start: bool = i == 0 || buf[(i - 1) as usize] as u64 == NEWLINE
        if line_start && text.equal_n((&buf[i as usize]) as u64, (&k_mode[0 as usize]) as u64, MODE_KEY_LEN) {
            return value_mode(buf[(i + MODE_KEY_LEN) as usize] as u64)
        }
        i = i + 1
    }
    return MODE_AUTO
}

fn value_mode(first: u64) -> u64 {
    if first == 100 {
        return MODE_DARK
    }
    if first == 108 {
        return MODE_LIGHT
    }
    return MODE_AUTO
}

fn append_prefs(js: u64, which: u64) {
    var p_dark: [u8; 182] = "user_pref(\"ui.systemUsesDarkTheme\", 1);\nuser_pref(\"layout.css.prefers-color-scheme.content-override\", 0);\nuser_pref(\"extensions.activeThemeID\", \"firefox-compact-dark@mozilla.org\");\n\0"
    var p_light: [u8; 183] = "user_pref(\"ui.systemUsesDarkTheme\", 0);\nuser_pref(\"layout.css.prefers-color-scheme.content-override\", 1);\nuser_pref(\"extensions.activeThemeID\", \"firefox-compact-light@mozilla.org\");\n\0"
    var p_auto: [u8; 135] = "user_pref(\"layout.css.prefers-color-scheme.content-override\", 2);\nuser_pref(\"extensions.activeThemeID\", \"default-theme@mozilla.org\");\n\0"
    if which == MODE_DARK {
        ulib.strcat(js, (&p_dark[0 as usize]) as u64)
    } else if which == MODE_LIGHT {
        ulib.strcat(js, (&p_light[0 as usize]) as u64)
    } else {
        ulib.strcat(js, (&p_auto[0 as usize]) as u64)
    }
}

fn env_gtk(env: u64, at: u64, which: u64) -> u64 {
    var e_dark: [u8; 23] = "GTK_THEME=Adwaita:dark\0"
    var e_light: [u8; 18] = "GTK_THEME=Adwaita\0"
    if which == MODE_DARK {
        return xfxio.env_put(env, at, (&e_dark[0 as usize]) as u64)
    }
    if which == MODE_LIGHT {
        return xfxio.env_put(env, at, (&e_light[0 as usize]) as u64)
    }
    return at
}
