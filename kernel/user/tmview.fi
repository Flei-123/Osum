// SPDX-License-Identifier: GPL-2.0-only
profile kernel

export { NONE, GROUPS, begin, add, finish, rows, slot_at, group_at, row_of_slot, heads, group_size, group_of_kind }

const NONE: u64 = 1000000
const GROUPS: u64 = 3
const MAXS: u64 = 128
const GROUP_BASE: u64 = 1000

static mut in_slot: [u64; 128] = [0 as u64; 128]
static mut in_grp: [u64; 128] = [0 as u64; 128]
static mut n_in: u64 = 0
static mut g_cnt: [u64; 3] = [0 as u64; 3]
static mut disp: [u64; 132] = [0 as u64; 132]
static mut head_b: [u8; 132] = [0 as u8; 132]
static mut n_rows: u64 = 0

fn group_of_kind(kind: u64) -> u64 {
    if kind == 3 {
        return 0
    }
    if kind == 2 {
        return 1
    }
    return 2
}

fn begin() {
    n_in = 0
    n_rows = 0
    var g: u64 = 0
    while g < GROUPS {
        g_cnt[(g) as usize] = 0
        g = g + 1
    }
}

fn add(slot: u64, grp: u64) {
    if n_in >= MAXS || grp >= GROUPS {
        return
    }
    in_slot[(n_in) as usize] = slot
    in_grp[(n_in) as usize] = grp
    n_in = n_in + 1
    g_cnt[(grp) as usize] = g_cnt[(grp) as usize] + 1
}

fn finish() {
    n_rows = 0
    var g: u64 = 0
    while g < GROUPS {
        if g_cnt[(g) as usize] > 0 {
            disp[(n_rows) as usize] = GROUP_BASE + g
            head_b[(n_rows) as usize] = 1 as u8
            n_rows = n_rows + 1
            var i: u64 = 0
            while i < n_in {
                if in_grp[(i) as usize] == g {
                    disp[(n_rows) as usize] = in_slot[(i) as usize]
                    head_b[(n_rows) as usize] = 0 as u8
                    n_rows = n_rows + 1
                }
                i = i + 1
            }
        }
        g = g + 1
    }
}

fn rows() -> u64 {
    return n_rows
}

fn slot_at(r: u64) -> u64 {
    if r >= n_rows || disp[(r) as usize] >= GROUP_BASE {
        return NONE
    }
    return disp[(r) as usize]
}

fn group_at(r: u64) -> u64 {
    if r >= n_rows || disp[(r) as usize] < GROUP_BASE {
        return NONE
    }
    return disp[(r) as usize] - GROUP_BASE
}

fn row_of_slot(slot: u64) -> u64 {
    var r: u64 = 0
    while r < n_rows {
        if disp[(r) as usize] == slot {
            return r
        }
        r = r + 1
    }
    return NONE
}

fn group_size(g: u64) -> u64 {
    if g >= GROUPS {
        return 0
    }
    return g_cnt[(g) as usize]
}

fn heads() -> u64 {
    return (&head_b[0]) as u64
}
