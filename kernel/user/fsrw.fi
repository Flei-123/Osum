
profile kernel

import ulib
import libc.io
import libc.errno
import libc.kcall

export { u_start }

const ROLL: u64 = 4096
const SYS_CHMOD: u64 = 90

static mut roll: [u8; 4096] = [0 as u8; 4096];
static mut dat: [u8; 4096] = [0 as u8; 4096];
static mut num: [u8; 32] = [0 as u8; 32];
static mut file_path: [u8; 32] = [0 as u8; 32];

fn muster(g: u64, k: u64) -> u64 {
    return ((g *% 2654435761) +% (k *% 40503)) % 251;
}

fn set_num(v: u64) -> u64 {
    if v == 0 {
        num[(0) as usize] = 48 as u8;
        num[(1) as usize] = 0 as u8;
        return 1;
    }
    var place: u64 = 0;
    var y: u64 = v;
    while y > 0 {
        place = place + 1;
        y = y / 10;
    }
    let n: u64 = place;
    var x: u64 = v;
    while place > 0 {
        num[(place - 1) as usize] = (48 + (x % 10)) as u8;
        x = x / 10;
        place = place - 1;
    }
    num[(n) as usize] = 0 as u8;
    return n;
}

fn width_num(v: u64) {
    var x: u64 = v;
    var i: u64 = 8;
    while i > 0 {
        num[(i - 1) as usize] = (48 + (x % 10)) as u8;
        x = x / 10;
        i = i - 1;
    }
    num[(8) as usize] = 0 as u8;
}

fn read_num(p: u64) -> u64 {
    var v: u64 = 0;
    var i: u64 = 0;
    var c: u64 = __mmio_read8((p + i) as *mut u8) as u64;
    while c >= 48 && c <= 57 {
        v = v * 10 + (c - 48);
        i = i + 1;
        c = __mmio_read8((p + i) as *mut u8) as u64;
    }
    return v;
}

fn u_start(args: u64) -> u64 {
    var s_los: [u8; 10] = "fsrw: los\0";
    var s_fertig: [u8; 14] = "fsrw: fertig=\0";
    var p_d: [u8; 3] = "/d\0";
    var p_roll: [u8; 8] = "/d/roll\0";
    var p_roll2: [u8; 9] = "/d/roll2\0";
    var p_count: [u8; 9] = "/d/count\0";
    var p_f: [u8; 4] = "/d/\0";
    var w_endlos: [u8; 7] = "endlos\0";

    io.make_dir((&p_d[0 as usize]) as u64);

    var runden: u64 = 20;
    var endlos: bool = false;
    let argc: u64 = ulib.arg_count(args);
    if argc > 1 {
        let a: u64 = ulib.arg_at(args, 1);
        if ulib.streq(a, (&w_endlos[0 as usize]) as u64) {
            endlos = true;
        } else {
            runden = read_num(a);
        }
    }

    let rf: u64 = io.open((&p_roll[0 as usize]) as u64, kcall.O_RDWR);
    var rfd: u64 = rf;
    if errno.failed(rf) {
        rfd = io.create((&p_roll[0 as usize]) as u64);
    }
    if errno.failed(rfd) {
        return 1;
    }
    let rf2: u64 = io.open((&p_roll2[0 as usize]) as u64, kcall.O_RDWR);
    var rfd2: u64 = rf2;
    if errno.failed(rf2) {
        rfd2 = io.create((&p_roll2[0 as usize]) as u64);
    }
    if errno.failed(rfd2) {
        return 1;
    }

    let cf: u64 = io.open((&p_count[0 as usize]) as u64, kcall.O_RDWR);
    var cfd: u64 = cf;
    if errno.failed(cf) {
        cfd = io.create((&p_count[0 as usize]) as u64);
    }
    if errno.failed(cfd) {
        return 1;
    }

    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.say((&s_los[0 as usize]) as u64);
    ulib.nl();

    var g: u64 = 1;
    var next: bool = true;
    while next {
        // ---------------------------------------------- 1. die Rolldatei
        var i: u64 = 0;
        while i < 8 {
            roll[(i) as usize] = ((g >> (i * 8)) & 255) as u8;
            i = i + 1;
        }
        i = 8;
        while i < ROLL {
            roll[(i) as usize] = muster(g, i) as u8;
            i = i + 1;
        }
        io.seek(rfd, 0, 0);
        io.write(rfd, (&roll[0 as usize]) as u64, ROLL);
        io.seek(rfd2, 0, 0);
        io.write(rfd2, (&roll[0 as usize]) as u64, ROLL);

        let len: u64 = 512 + (g * 617) % 1536;
        i = 0;
        while i < len {
            dat[(i) as usize] = muster(g + 1000000, i) as u8;
            i = i + 1;
        }
        ulib.strcpy((&file_path[0 as usize]) as u64, (&p_f[0 as usize]) as u64);
        set_num(g);
        ulib.strcat((&file_path[0 as usize]) as u64, (&num[0 as usize]) as u64);
        let df: u64 = io.create((&file_path[0 as usize]) as u64);
        if errno.failed(df) {
            next = false
        } else {
            io.write(df, (&dat[0 as usize]) as u64, len);
            io.close(df);
            ulib.sys(SYS_CHMOD, (&file_path[0 as usize]) as u64,
                384 + (g % 8), 0);

            width_num(g);
            io.seek(cfd, 0, 0);
            io.write(cfd, (&num[0 as usize]) as u64, 8);

            if !endlos && g >= runden {
                next = false;
            }
            g = g + 1;
        }
    }
    io.close(rfd);
    io.close(rfd2);
    io.close(cfd);
    ulib.say((&s_fertig[0 as usize]) as u64);
    ulib.sayu(g - 1);
    ulib.nl();
    return 0;
}
