profile kernel

import ulib
import symvar
import appreg
import uikit.uiicon

export { slot_for, reset }

const SLOT_COUNT: u64 = 12
const NAME_W: u64 = 24
const STATE_EMPTY: u8 = 0
const STATE_OK: u8 = 1
const STATE_MISSING: u8 = 2

static mut s_data: [u8; 538800] = [0 as u8; 538800]
static mut s_name: [u8; 288] = [0 as u8; 288]
static mut s_state: [u8; 12] = [0 as u8; 12]
static mut s_next: u64 = 0


fn slot_ptr(k: u64) -> u64 {
    return (&s_data[0 as usize]) as u64 + k * symvar.SLOT_BYTES
}

fn name_ptr(k: u64) -> u64 {
    return (&s_name[0 as usize]) as u64 + k * NAME_W
}

fn find(name: u64) -> u64 {
    var k: u64 = 0
    while k < SLOT_COUNT {
        if s_state[k as usize] != STATE_EMPTY && ulib.streq(name_ptr(k), name) {
            return k
        }
        k = k + 1
    }
    return SLOT_COUNT
}

fn load(name: u64, k: u64) -> bool {
    let slot: u64 = slot_ptr(k)
    let got: u64 = appreg.symbol_for(name, slot)
    if !symvar.joined_ok(slot, got) {
        appreg.note_letter_tile(name)
        return uiicon.app_icon(name, slot)
    }
    symvar.register(slot, got)
    return true
}

fn slot_for(name: u64) -> u64 {
    if name == 0 || __mmio_read8(name as *mut u8) == 0 as u8 {
        return 0
    }
    var k: u64 = find(name)
    if k < SLOT_COUNT {
        if s_state[k as usize] == STATE_OK {
            return slot_ptr(k)
        }
        return 0
    }
    k = s_next
    s_next = (s_next + 1) % SLOT_COUNT
    ulib.strncpy(name_ptr(k), name, NAME_W)
    if load(name, k) {
        s_state[k as usize] = STATE_OK
        return slot_ptr(k)
    }
    s_state[k as usize] = STATE_MISSING
    return 0
}

fn reset() {
    var k: u64 = 0
    while k < SLOT_COUNT {
        s_state[k as usize] = STATE_EMPTY
        k = k + 1
    }
    s_next = 0
}
