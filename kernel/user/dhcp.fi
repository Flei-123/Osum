// kernel/user/dhcp.fi -- Runde DESKTOP: /bin/dhcp, DER DHCP-KLIENT.

profile kernel

import ulib
import libc.clockapi
import libc.net
import netdiag.netlog
import netdiag.dnsguard
import netdiag.helperstate
import libc.regio

export { u_start }

const RETRY: u64 = 0xFFFF
const SYS_NETGET: u64 = 1300
const SYS_NETSET: u64 = 1301
const SYS_DHCPST: u64 = 1302
const D_ST: u64 = 0
const D_TX: u64 = 1
const D_RX: u64 = 2
const D_TRY: u64 = 3

fn report(was: u64, value: u64) {
    ulib.sys(SYS_DHCPST, was, value, 0)
}
const NG_READY: u64 = 0
const NG_IP: u64 = 1
const NG_GW: u64 = 3
const NG_MAC0: u64 = 4
const NG_MAC1: u64 = 5

const PORT_S: u64 = 67
const PORT_C: u64 = 68
const PACKET: u64 = 548

const B_OP: u64 = 0
const B_HTYPE: u64 = 1
const B_HLEN: u64 = 2
const B_XID: u64 = 4
const B_FLAGS: u64 = 10
const B_YIADDR: u64 = 16
const B_CHADDR: u64 = 28
const B_MAGIC: u64 = 236
const B_OPT: u64 = 240

static mut aus: [u8; 548] = [0 as u8; 548]
static mut ein: [u8; 1024] = [0 as u8; 1024]
static mut mac: [u8; 8] = [0 as u8; 8]
static mut xid: u64 = 0
static mut o_ip: u64 = 0
static mut o_maske: u64 = 0
static mut o_gw: u64 = 0
static mut o_server: u64 = 0
static mut o_lease: u64 = 0
// DELL STABILITY (08.10.2026): lease renewal (RFC 2131 4.4.5). `renewing` makes
// `bauen(3)` a RENEWING request: ciaddr = our address, no options 50/54, and the
// broadcast bit off.
static mut renewing: u64 = 0
static mut o_dns1: u64 = 0
static mut o_dns2: u64 = 0
static mut o_dns3: u64 = 0
static mut conf: [u8; 320] = [0 as u8; 320]
static mut rconf: [u8; 640] = [0 as u8; 640]
static mut alt: [u8; 1024] = [0 as u8; 1024]

fn say(p: u64) {
    ulib.say(p)
}

// ROUND DELL2: WHAT THE BACKGROUND CLIENT IS DOING, ON THE SCREEN.
//
// Justin typed `dhcp` on the Dell 9020 and got only "bind 68 failed":
// the kernel had already started `dhcp dauer`, which holds port 68.
// The stick has no serial line, no /proc and no /bin/log, and the
// board line `22 NET` sits below the bottom of a 1024-line screen.
// So this prints the four DHCP numbers plus link and card counters --
// the same numbers the board shows, readable in the terminal.
const NG_MASKX: u64 = 2
const NG_LINKX: u64 = 13
const NG_UPGENX: u64 = 18
const NG_LEASEX: u64 = 19
const LEASE_IP: u64 = 0
const LEASE_MASK: u64 = 1
const LEASE_GW: u64 = 2
const LEASE_DNS: u64 = 3
const NG_SPEEDX: u64 = 14
const NG_CARDTXX: u64 = 15
const NG_CARDRXX: u64 = 16
const NG_INX: u64 = 6
const NG_OUTX: u64 = 7
const NG_DSTX: u64 = 9
const NG_DTXX: u64 = 10
const NG_DRXX: u64 = 11
const NG_DTRYX: u64 = 12

fn say_ip(v: u64) {
    var dot: [u8; 2] = ".\0"
    ulib.sayn((v >> 24) & 255)
    say((&dot[0 as usize]) as u64)
    ulib.sayn((v >> 16) & 255)
    say((&dot[0 as usize]) as u64)
    ulib.sayn((v >> 8) & 255)
    say((&dot[0 as usize]) as u64)
    ulib.sayn(v & 255)
}

fn ng(what: u64) -> u64 {
    let v: u64 = ulib.sys(SYS_NETGET, what, 0, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

const NG_HWX: u64 = 17

fn say_hex(v: u64, digits: u64) {
    var d: [u8; 17] = "0123456789abcdef\0"
    var c: [u8; 2] = " \0"
    var k: u64 = digits
    while k > 0 {
        k = k - 1
        c[0 as usize] = d[((v >> (k * 4)) & 15) as usize]
        say((&c[0 as usize]) as u64)
    }
}

fn hw(which: u64) -> u64 {
    return ulib.sys(SYS_NETGET, NG_HWX, which, 0)
}

// One "name=value" pair of the chip line, decimal.
fn hw_pair(name: u64, which: u64) {
    say(name)
    let v: u64 = hw(which)
    if ulib.bad(v) || v == 0xFFFFFFFF {
        var na: [u8; 3] = "na\0"
        say((&na[0 as usize]) as u64)
        return
    }
    ulib.sayn(v)
}

fn status_chip() {
    var c0: [u8; 11] = "chip: mac=\0"
    var cc: [u8; 2] = ":\0"
    var c1: [u8; 11] = " status=0x\0"
    var c2: [u8; 9] = " rctl=0x\0"
    var c3: [u8; 9] = " tctl=0x\0"
    var r0: [u8; 15] = "chip rx: good=\0"
    var r1: [u8; 8] = " bcast=\0"
    var r2: [u8; 8] = " mcast=\0"
    var r3: [u8; 8] = " total=\0"
    var r4: [u8; 9] = " missed=\0"
    var r5: [u8; 6] = " crc=\0"
    var r6: [u8; 6] = " err=\0"
    var r7: [u8; 8] = " nobuf=\0"
    var t0: [u8; 15] = "chip tx: good=\0"
    var t1: [u8; 8] = " total=\0"
    let ral: u64 = hw(10)
    if ulib.bad(ral) || ral == 0xFFFFFFFF {
        var no: [u8; 33] = "chip: no counters for this card\0\0"
        say((&no[0 as usize]) as u64)
        ulib.nl()
        return
    }
    let rah: u64 = hw(11)
    say((&c0[0 as usize]) as u64)
    say_hex(ral & 255, 2)
    say((&cc[0 as usize]) as u64)
    say_hex((ral >> 8) & 255, 2)
    say((&cc[0 as usize]) as u64)
    say_hex((ral >> 16) & 255, 2)
    say((&cc[0 as usize]) as u64)
    say_hex((ral >> 24) & 255, 2)
    say((&cc[0 as usize]) as u64)
    say_hex(rah & 255, 2)
    say((&cc[0 as usize]) as u64)
    say_hex((rah >> 8) & 255, 2)
    if (rah & 0x80000000) == 0 {
        var nv: [u8; 13] = " (NOT VALID)\0"
        say((&nv[0 as usize]) as u64)
    }
    say((&c1[0 as usize]) as u64)
    say_hex(hw(0), 8)
    say((&c2[0 as usize]) as u64)
    say_hex(hw(12), 8)
    say((&c3[0 as usize]) as u64)
    say_hex(hw(13), 8)
    ulib.nl()
    hw_pair((&r0[0 as usize]) as u64, 1)
    hw_pair((&r1[0 as usize]) as u64, 2)
    hw_pair((&r2[0 as usize]) as u64, 3)
    hw_pair((&r3[0 as usize]) as u64, 17)
    hw_pair((&r4[0 as usize]) as u64, 5)
    hw_pair((&r5[0 as usize]) as u64, 6)
    hw_pair((&r6[0 as usize]) as u64, 7)
    hw_pair((&r7[0 as usize]) as u64, 8)
    ulib.nl()
    hw_pair((&t0[0 as usize]) as u64, 4)
    hw_pair((&t1[0 as usize]) as u64, 9)
    ulib.nl()
    // ROUND DELL2: the transmit queue as the chip sees it, in hex.
    var q0: [u8; 15] = "chip txq: tdh=\0"
    var q1: [u8; 6] = " tdt=\0"
    var q2: [u8; 9] = " txdctl=\0"
    var q3: [u8; 8] = " tdlen=\0"
    var q4: [u8; 7] = " tdba=\0"
    var q5: [u8; 8] = " desc0=\0"
    var q6: [u8; 6] = " len=\0"
    var p0: [u8; 15] = "chip cfg: pba=\0"
    var p1: [u8; 10] = " pba_was=\0"
    var p2: [u8; 6] = " pbs=\0"
    var p3: [u8; 6] = " gcr=\0"
    var p4: [u8; 7] = " fwsm=\0"
    var p5: [u8; 7] = " tarc=\0"
    var p6: [u8; 7] = " ctrl=\0"
    var p7: [u8; 6] = " ext=\0"
    var p8: [u8; 6] = " icr=\0"
    hx_pair((&q0[0 as usize]) as u64, 18)
    hx_pair((&q1[0 as usize]) as u64, 19)
    hx_pair((&q2[0 as usize]) as u64, 20)
    hx_pair((&q3[0 as usize]) as u64, 21)
    say((&q4[0 as usize]) as u64)
    say_hex(hw(23), 8)
    say_hex(hw(22), 8)
    hx_pair((&q5[0 as usize]) as u64, 32)
    hx_pair((&q6[0 as usize]) as u64, 33)
    ulib.nl()
    hx_pair((&p0[0 as usize]) as u64, 24)
    hx_pair((&p1[0 as usize]) as u64, 25)
    hx_pair((&p2[0 as usize]) as u64, 31)
    hx_pair((&p3[0 as usize]) as u64, 26)
    hx_pair((&p4[0 as usize]) as u64, 27)
    hx_pair((&p5[0 as usize]) as u64, 28)
    hx_pair((&p6[0 as usize]) as u64, 29)
    hx_pair((&p7[0 as usize]) as u64, 30)
    hx_pair((&p8[0 as usize]) as u64, 35)
    ulib.nl()
    var f0: [u8; 17] = "chip fw: extcnf=\0"
    var f1: [u8; 7] = " manc=\0"
    var f2: [u8; 7] = " swsm=\0"
    hx_pair((&f0[0 as usize]) as u64, 36)
    hx_pair((&f1[0 as usize]) as u64, 37)
    hx_pair((&f2[0 as usize]) as u64, 38)
    ulib.nl()
    // ROUND DELL3: the link-up settings and the transmit FIFO.
    var l0: [u8; 15] = "chip lpt: res=\0"
    var l1: [u8; 9] = " k1+pll=\0"
    var l2: [u8; 6] = " fx6=\0"
    var l3: [u8; 6] = " ltr=\0"
    var l4: [u8; 6] = " fx4=\0"
    var l5: [u8; 7] = " tdfh=\0"
    var l6: [u8; 7] = " tdft=\0"
    var l7: [u8; 8] = " tdfpc=\0"
    var l8: [u8; 7] = " xoff=\0"
    hx_pair((&l0[0 as usize]) as u64, 43)
    hx_pair((&l1[0 as usize]) as u64, 44)
    hx_pair((&l2[0 as usize]) as u64, 45)
    hx_pair((&l3[0 as usize]) as u64, 46)
    hx_pair((&l4[0 as usize]) as u64, 47)
    hx_pair((&l5[0 as usize]) as u64, 39)
    hx_pair((&l6[0 as usize]) as u64, 40)
    hx_pair((&l7[0 as usize]) as u64, 41)
    hx_pair((&l8[0 as usize]) as u64, 42)
    var l9: [u8; 8] = " pcist=\0"
    hx_pair((&l9[0 as usize]) as u64, 48)
    ulib.nl()
}

// One "name=value" pair, hex without leading zeros.
fn hx_pair(name: u64, which: u64) {
    say(name)
    let v: u64 = hw(which)
    if ulib.bad(v) {
        var na: [u8; 3] = "na\0"
        say((&na[0 as usize]) as u64)
        return
    }
    var d: u64 = 1
    while d < 8 && (v >> (d * 4)) != 0 {
        d = d + 1
    }
    say_hex(v, d)
}

fn status() {
    var h0: [u8; 31] = "dhcp: background client state \0"
    var h1: [u8; 7] = " sent=\0"
    var h2: [u8; 10] = " replies=\0"
    var h3: [u8; 10] = " attempt=\0"
    var z0: [u8; 13] = " (never ran)\0"
    var z1: [u8; 17] = " (discover sent)\0"
    var z2: [u8; 18] = " (offer received)\0"
    var z3: [u8; 16] = " (request sent)\0"
    var z4: [u8; 20] = " (ack, address set)\0"
    var z5: [u8; 11] = " (gave up)\0"
    var z6: [u8; 19] = " (nak from server)\0"
    var n0: [u8; 11] = "net: link=\0"
    var n1: [u8; 7] = " mbit=\0"
    var n2: [u8; 18] = " stack frames in=\0"
    var n3: [u8; 6] = " out=\0"
    var n4: [u8; 17] = " card octets in=\0"
    var i0: [u8; 8] = "net: ip\0"
    var i1: [u8; 2] = "=\0"
    var i2: [u8; 7] = " mask=\0"
    var i3: [u8; 5] = " gw=\0"
    let st: u64 = ng(NG_DSTX)
    say((&h0[0 as usize]) as u64)
    ulib.sayn(st)
    var zt: u64 = (&z0[0 as usize]) as u64
    if st == 1 {
        zt = (&z1[0 as usize]) as u64
    }
    if st == 2 {
        zt = (&z2[0 as usize]) as u64
    }
    if st == 3 {
        zt = (&z3[0 as usize]) as u64
    }
    if st == 4 {
        zt = (&z4[0 as usize]) as u64
    }
    if st == 5 {
        zt = (&z5[0 as usize]) as u64
    }
    if st == 6 {
        zt = (&z6[0 as usize]) as u64
    }
    say(zt)
    say((&h1[0 as usize]) as u64)
    ulib.sayn(ng(NG_DTXX))
    say((&h2[0 as usize]) as u64)
    ulib.sayn(ng(NG_DRXX))
    say((&h3[0 as usize]) as u64)
    ulib.sayn(ng(NG_DTRYX))
    ulib.nl()
    say((&n0[0 as usize]) as u64)
    ulib.sayn(ng(NG_LINKX))
    say((&n1[0 as usize]) as u64)
    ulib.sayn(ng(NG_SPEEDX))
    say((&n2[0 as usize]) as u64)
    ulib.sayn(ng(NG_INX))
    say((&n3[0 as usize]) as u64)
    ulib.sayn(ng(NG_OUTX))
    say((&n4[0 as usize]) as u64)
    ulib.sayn(ng(NG_CARDRXX))
    say((&n3[0 as usize]) as u64)
    ulib.sayn(ng(NG_CARDTXX))
    ulib.nl()
    say((&i0[0 as usize]) as u64)
    say((&i1[0 as usize]) as u64)
    say_ip(ng(NG_IP))
    say((&i2[0 as usize]) as u64)
    say_ip(ng(NG_MASKX))
    say((&i3[0 as usize]) as u64)
    say_ip(ng(NG_GW))
    ulib.nl()
    status_chip()
}

fn s8(at: u64, v: u64) {
    __mmio_write8(((&aus[0 as usize]) as u64 + at) as *mut u8, (v & 255) as u8)
}

fn s32(at: u64, v: u64) {
    s8(at, (v >> 24) & 255)
    s8(at + 1, (v >> 16) & 255)
    s8(at + 2, (v >> 8) & 255)
    s8(at + 3, v & 255)
}

fn g32(p: u64, at: u64) -> u64 {
    return (regio.read8_at(p, at) << 24) | (regio.read8_at(p, at + 1) << 16) | (regio.read8_at(p, at + 2) << 8)
        | regio.read8_at(p, at + 3)
}

fn make(art: u64) -> u64 {
    var i: u64 = 0
    while i < PACKET {
        s8(i, 0)
        i = i + 1
    }
    s8(B_OP, 1) // BOOTREQUEST
    s8(B_HTYPE, 1) // Ethernet
    s8(B_HLEN, 6)
    s32(B_XID, xid)
    s8(B_FLAGS, 0x80)
    s8(B_FLAGS + 1, 0)
    if art == 3 && renewing != 0 {
        s8(B_FLAGS, 0)
        s8(12, (o_ip >> 24) & 255) // ciaddr
        s8(13, (o_ip >> 16) & 255)
        s8(14, (o_ip >> 8) & 255)
        s8(15, o_ip & 255)
    }
    i = 0
    while i < 6 {
        s8(B_CHADDR + i, mac[(i) as usize] as u64)
        i = i + 1
    }
    // die Kennung 99.130.83.99
    s8(B_MAGIC, 99)
    s8(B_MAGIC + 1, 130)
    s8(B_MAGIC + 2, 83)
    s8(B_MAGIC + 3, 99)
    var at: u64 = B_OPT
    s8(at, 53) // Nachrichtenart
    s8(at + 1, 1)
    s8(at + 2, art)
    at = at + 3
    if art == 3 && renewing == 0 {
        s8(at, 50) // gewuenschte Adresse
        s8(at + 1, 4)
        s8(at + 2, (o_ip >> 24) & 255)
        s8(at + 3, (o_ip >> 16) & 255)
        s8(at + 4, (o_ip >> 8) & 255)
        s8(at + 5, o_ip & 255)
        at = at + 6
        s8(at, 54)
        s8(at + 1, 4)
        s8(at + 2, (o_server >> 24) & 255)
        s8(at + 3, (o_server >> 16) & 255)
        s8(at + 4, (o_server >> 8) & 255)
        s8(at + 5, o_server & 255)
        at = at + 6
    }
    s8(at, 55) // was wir wissen wollen
    s8(at + 1, 3)
    s8(at + 2, 1) // Maske
    s8(at + 3, 3) // Gateway
    s8(at + 4, 6) // Namensdienst
    at = at + 5
    s8(at, 255) // Ende
    at = at + 1
    if at < 300 {
        at = 300
    }
    return at
}

fn read(p: u64, n: u64) -> u64 {
    if n < B_OPT {
        return 0
    }
    if regio.read8_at(p, B_MAGIC) != 99 || regio.read8_at(p, B_MAGIC + 1) != 130 {
        return 0
    }
    if regio.read8_at(p, B_MAGIC + 2) != 83 || regio.read8_at(p, B_MAGIC + 3) != 99 {
        return 0
    }
    if g32(p, B_XID) != xid {
        return 0
    }
    if regio.read8_at(p, B_OP) != 2 {
        return 0
    }
    var art: u64 = 0
    var at: u64 = B_OPT
    var next: bool = true
    while next && at < n {
        let t: u64 = regio.read8_at(p, at)
        if t == 255 {
            next = false
        } else if t == 0 {
            at = at + 1
        } else {
            if at + 1 >= n {
                next = false
            } else {
                let l: u64 = regio.read8_at(p, at + 1)
                if at + 2 + l > n {
                    next = false
                } else {
                    if t == 53 && l == 1 {
                        art = regio.read8_at(p, at + 2)
                    } else if t == 1 && l == 4 {
                        o_maske = g32(p, at + 2)
                    } else if t == 3 && l >= 4 {
                        o_gw = g32(p, at + 2)
                    } else if t == 54 && l == 4 {
                        o_server = g32(p, at + 2)
                    } else if t == 51 && l == 4 {
                        o_lease = g32(p, at + 2)
                    } else if t == 6 && l >= 4 {
                        o_dns1 = g32(p, at + 2)
                        if l >= 8 {
                            o_dns2 = g32(p, at + 6)
                        }
                        if l >= 12 {
                            o_dns3 = g32(p, at + 10)
                        }
                    }
                    at = at + 2 + l
                }
            }
        }
    }
    if art != 0 {
        o_ip = g32(p, B_YIADDR)
    }
    return art
}

fn text_an(p: u64, at: u64, q: u64) -> u64 {
    var k: u64 = 0
    while __mmio_read8((q + k) as *mut u8) != 0 as u8 {
        __mmio_write8((p + at + k) as *mut u8,
            __mmio_read8((q + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((p + at + k) as *mut u8, 0 as u8)
    return at + k
}

fn num_at(p: u64, at: u64, v: u64) -> u64 {
    if v == 0 {
        __mmio_write8((p + at) as *mut u8, 48 as u8)
        __mmio_write8((p + at + 1) as *mut u8, 0 as u8)
        return at + 1
    }
    var st: u64 = 0
    var t: u64 = v
    while t > 0 {
        st = st + 1
        t = t / 10
    }
    var k: u64 = st
    t = v
    while k > 0 {
        k = k - 1
        __mmio_write8((p + at + k) as *mut u8, (48 + (t % 10)) as u8)
        t = t / 10
    }
    __mmio_write8((p + at + st) as *mut u8, 0 as u8)
    return at + st
}

fn ip_an(p: u64, at: u64, v: u64) -> u64 {
    var pt: [u8; 2] = ".\0"
    var a: u64 = num_at(p, at, (v >> 24) & 255)
    a = text_an(p, a, (&pt[0 as usize]) as u64)
    a = num_at(p, a, (v >> 16) & 255)
    a = text_an(p, a, (&pt[0 as usize]) as u64)
    a = num_at(p, a, (v >> 8) & 255)
    a = text_an(p, a, (&pt[0 as usize]) as u64)
    return num_at(p, a, v & 255)
}

fn say_ip_2(brand: u64, v: u64) {
    var b: [u8; 24] = [0 as u8; 24]
    say(brand)
    let _n: u64 = ip_an((&b[0 as usize]) as u64, 0, v)
    say((&b[0 as usize]) as u64)
}

// Marks the moment the wire carries an address: one serial line and one line appended to the boot inventory file the
// boss reads from the stick (`/var/jarvis/hwinv.txt`). Used by the USB tethering remote test.
fn net_note(v: u64) {
    var head: [u8; 12] = "net: up ip=\0"
    var p_inv: [u8; 22] = "/var/jarvis/hwinv.txt\0"
    var b: [u8; 64] = [0 as u8; 64]
    let bp: u64 = (&b[0 as usize]) as u64
    var at: u64 = text_an(bp, 0, (&head[0 as usize]) as u64)
    at = ip_an(bp, at, v)
    b[at as usize] = 10 as u8
    at = at + 1
    ulib.put(bp, at)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_inv[0 as usize]) as u64, 1089, 0)
    if !ulib.bad(fd) {
        ulib.sys(ulib.SYS_WRITE, fd, bp, at)
        ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    }
}

// RUNDE BETRIEB: /etc/resolv.conf SCHREIBEN.
fn resolv_write(p_res: u64, k_ns: u64, k_fb: u64, k_nl: u64) -> u64 {
    let r: u64 = (&rconf[0 as usize]) as u64
    let a: u64 = (&alt[0 as usize]) as u64
    var an: u64 = 0
    let fo: u64 = ulib.sys(ulib.SYS_OPEN, p_res, 0, 0)
    if !ulib.bad(fo) {
        while an < 1023 {
            let g: u64 = ulib.sys(ulib.SYS_READ, fo, a + an, 1023 - an)
            if ulib.bad(g) || g == 0 {
                break
            }
            an = an + g
        }
        let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fo, 0, 0)
    }
    var at: u64 = 0
    var d: u64 = 0
    while d < 3 {
        var v: u64 = o_dns1
        if d == 1 {
            v = o_dns2
        }
        if d == 2 {
            v = o_dns3
        }
        if v != 0 {
            at = text_an(r, at, k_ns)
            at = ip_an(r, at, v)
            at = text_an(r, at, k_nl)
        }
        d = d + 1
    }
    var i: u64 = 0
    while i < an {
        var e: u64 = i
        while e < an && __mmio_read8((a + e) as *mut u8) != 10 as u8 {
            e = e + 1
        }
        var eq: bool = true
        var k: u64 = 0
        while k < 8 {
            if i + k >= e {
                eq = false
                break
            }
            if __mmio_read8((a + i + k) as *mut u8)
                != __mmio_read8((k_fb + k) as *mut u8) {
                eq = false
                break
            }
            k = k + 1
        }
        if eq && at + (e - i) + 2 < 640 {
            var m: u64 = i
            while m < e {
                __mmio_write8((r + at) as *mut u8,
                    __mmio_read8((a + m) as *mut u8))
                at = at + 1
                m = m + 1
            }
            at = text_an(r, at, k_nl)
        }
        i = e + 1
    }
    if at == 0 {
        return 0
    }
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, p_res, 577, 0)
    if ulib.bad(fd) {
        return 0
    }
    let w: u64 = ulib.sys(ulib.SYS_WRITE, fd, r, at)
    let _c2: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(w) {
        return 0
    }
    return w
}

// ==================================================== DELL STABILITY
// THE LEASE WAS NEVER RENEWED. This client took the address once and went away
// ("no renewal of the lease" in the head of this file); a router with a
// short lease (an hour, or a day) let the lease run out under a machine that was
// still using the address, and the Dell's internet and bridge dropped for a
// while ("Internet-Aussetzer"). With `dauer` the client now stays and does what
// RFC 2131 4.4.5 says:
//
//   T1 = lease / 2        RENEWING: unicast REQUEST (ciaddr set) to the server
//   T2 = lease * 7 / 8    REBINDING: the same, broadcast
//   lease end             the address is gone: start over (full DISCOVER)
//
// Nothing is touched while it works: the address stays, no `osum_netset`, so
// open connections (a long download!) are not reset. `t1=<seconds>` on the
// command line shortens T1 for the test (tools/stab/lease.sh).
// Returns true when the server answered with an ACK.
fn renew_once(unicast: bool, give_up_ms: u64) -> u64 {
    // 0 = nothing came back, 5 = ACK, 6 = NAK
    let fd: u64 = net.socket(net.AF_INET, net.SOCK_DGRAM | net.SOCK_NONBLOCK, 0)
    if net.failed(fd) {
        return 0
    }
    if net.failed(net.bind_port(fd, PORT_C)) {
        net.close(fd)
        return 0
    }
    xid = (ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0) *% 2654435761) & 0xFFFFFFFF
    if xid == 0 {
        xid = 0x4F53554D
    }
    var von: u64 = 0
    let keep_ip: u64 = o_ip
    renewing = 1
    let n: u64 = make(3)
    renewing = 0
    var target: u64 = net.ip4(255, 255, 255, 255)
    if unicast && o_server != 0 {
        target = o_server
    }
    let _s: u64 = net.sendto_ip(fd, (&aus[0 as usize]) as u64, n, target, PORT_S)
    var got: u64 = 0
    var waited: u64 = 0
    while waited < give_up_ms && got == 0 {
        let g: u64 = net.recvfrom_ip(fd, (&ein[0 as usize]) as u64, 1024, &von)
        if !net.failed(g) && g > 0 {
            let t: u64 = read((&ein[0 as usize]) as u64, g)
            if t == 5 || t == 6 {
                got = t
            }
        } else {
            clockapi.sleep_ms(50)
            waited = waited + 50
        }
    }
    net.close(fd)
    // An ACK to a renewal carries our address again; one with yiaddr 0 must not
    // wipe it.
    if o_ip == 0 {
        o_ip = keep_ip
    }
    return got
}

static mut link_lost: u64 = 0
static mut link_cycled: u64 = 0

static mut anlauf: u64 = 0
static mut link_seen: u64 = 2
static mut uplink_gen_seen: u64 = 0xFFFFFFFFFFFFFFFF
static mut keep_secs: u64 = 0
static mut LOG_LINK_UP: [u8; 8] = "link-up\0"
static mut LOG_LINK_DOWN: [u8; 10] = "link-down\0"
static mut LOG_LINK_RESTART: [u8; 13] = "link-restart\0"
static mut LOG_LEASE: [u8; 6] = "lease\0"
static mut LOG_STATUS: [u8; 7] = "status\0"
static mut LOG_CONF_FAIL: [u8; 10] = "conf-fail\0"
static mut LOG_RESOLV_FAIL: [u8; 12] = "resolv-fail\0"
static mut LOG_DNS_FIXED: [u8; 10] = "dns-fixed\0"
static mut LOG_DNS_FAIL: [u8; 9] = "dns-fail\0"
static mut LOG_RETRY: [u8; 6] = "retry\0"
static mut LOG_RENEWED: [u8; 8] = "renewed\0"
static mut LOG_RENEW_FAIL: [u8; 13] = "renew-failed\0"
static mut LOG_LEASE_LOST: [u8; 11] = "lease-lost\0"
static mut LOG_START: [u8; 6] = "start\0"
static mut K_IP: [u8; 3] = "ip\0"
static mut K_LINK: [u8; 5] = "link\0"
static mut K_LEASE: [u8; 6] = "lease\0"
static mut K_DNS: [u8; 4] = "dns\0"
static mut K_ATTEMPT: [u8; 8] = "attempt\0"
static mut K_WAIT: [u8; 5] = "wait\0"
static mut K_JARVISD: [u8; 8] = "jarvisd\0"
static mut K_AGE: [u8; 4] = "age\0"
static mut V_UP: [u8; 3] = "up\0"
static mut V_DOWN: [u8; 5] = "down\0"
static mut V_STALE: [u8; 6] = "stale\0"
static mut V_OK: [u8; 3] = "ok\0"
static mut V_NONE: [u8; 5] = "none\0"

fn log_event(tag: u64) {
    netlog.begin(tag)
    netlog.ip((&K_IP[0 as usize]) as u64, ng(NG_IP))
    netlog.num((&K_LINK[0 as usize]) as u64, ng(NG_LINKX))
    netlog.end()
}

fn log_lease(tag: u64) {
    netlog.begin(tag)
    netlog.ip((&K_IP[0 as usize]) as u64, o_ip)
    netlog.num((&K_LEASE[0 as usize]) as u64, o_lease)
    netlog.ip((&K_DNS[0 as usize]) as u64, o_dns1)
    netlog.end()
}

fn log_status() {
    netlog.begin((&LOG_STATUS[0 as usize]) as u64)
    netlog.ip((&K_IP[0 as usize]) as u64, ng(NG_IP))
    netlog.num((&K_LINK[0 as usize]) as u64, ng(NG_LINKX))
    netlog.num((&K_LEASE[0 as usize]) as u64, o_lease)
    netlog.ip((&K_DNS[0 as usize]) as u64, o_dns1)
    let age: u64 = helperstate.alive_age_secs(ulib.sys(ulib.SYS_SYSINFO, ulib.I_UPTIME, 0, 0))
    if age == helperstate.NONE {
        netlog.text((&K_JARVISD[0 as usize]) as u64, (&V_NONE[0 as usize]) as u64)
    } else {
        var verdict: u64 = (&V_OK[0 as usize]) as u64
        if age > 180 {
            verdict = (&V_STALE[0 as usize]) as u64
        }
        netlog.text((&K_JARVISD[0 as usize]) as u64, verdict)
        netlog.num((&K_AGE[0 as usize]) as u64, age)
    }
    netlog.end()
}

fn dns_keep(want_fallback: bool) {
    let r: u64 = dnsguard.ensure(o_dns1, o_dns2, o_dns3, want_fallback)
    if r == dnsguard.R_REPAIRED {
        log_event((&LOG_DNS_FIXED[0 as usize]) as u64)
    } else if r == dnsguard.R_FAILED {
        log_event((&LOG_DNS_FAIL[0 as usize]) as u64)
    }
}

fn later(dur: u64) -> u64 {
    if dur == 0 {
        return 1
    }
    var wait_s: u64 = 60
    if anlauf < 4 {
        wait_s = 5 << anlauf
    }
    anlauf = anlauf + 1
    netlog.begin((&LOG_RETRY[0 as usize]) as u64)
    netlog.num((&K_ATTEMPT[0 as usize]) as u64, anlauf)
    netlog.num((&K_WAIT[0 as usize]) as u64, wait_s)
    netlog.end()
    clockapi.sleep_ms(wait_s * 1000)
    return RETRY
}

fn link_watch() {
    let gen: u64 = ng(NG_UPGENX)
    if uplink_gen_seen != 0xFFFFFFFFFFFFFFFF && gen != uplink_gen_seen {
        link_cycled = 1
    }
    uplink_gen_seen = gen
    let up: u64 = ng(NG_LINKX)
    if up == 0 {
        link_lost = 1
    } else if link_lost != 0 {
        link_lost = 0
        link_cycled = 1
    }
    var now_up: u64 = 0
    if up != 0 {
        now_up = 1
    }
    if now_up != link_seen {
        if link_seen != 2 {
            if now_up == 1 {
                log_event((&LOG_LINK_UP[0 as usize]) as u64)
            } else {
                log_event((&LOG_LINK_DOWN[0 as usize]) as u64)
            }
        }
        link_seen = now_up
    }
}

fn wlan_lease(which: u64) -> u64 {
    let v: u64 = ulib.sys(SYS_NETGET, NG_LEASEX, which, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

fn wlan_adopt() -> bool {
    var s_wl: [u8; 26] = "dhcp: wlan lease adopted\0\0"
    var s_dn: [u8; 6] = " dns\0\0"
    let lip: u64 = wlan_lease(LEASE_IP)
    if lip == 0 {
        return false
    }
    o_ip = lip
    o_maske = wlan_lease(LEASE_MASK)
    o_gw = wlan_lease(LEASE_GW)
    o_server = o_gw
    o_lease = 0
    o_dns1 = wlan_lease(LEASE_DNS)
    o_dns2 = 0
    o_dns3 = 0
    if o_dns1 == 0 {
        o_dns1 = o_gw
    }
    if o_maske == 0 {
        o_maske = net.ip4(255, 255, 255, 0)
    }
    if ng(NG_IP) != o_ip {
        let _rc: u64 = ulib.sys(SYS_NETSET, o_ip, o_maske, o_gw)
    }
    say_ip_2((&s_wl[0 as usize]) as u64, o_ip)
    say_ip_2((&s_dn[0 as usize]) as u64, o_dns1)
    ulib.nl()
    net_note(o_ip)
    log_lease((&LOG_LEASE[0 as usize]) as u64)
    return true
}

fn sleep_secs(secs: u64) {
    var left: u64 = secs
    while left > 0 && link_cycled == 0 {
        clockapi.sleep_ms(1000)
        link_watch()
        keep_secs = keep_secs + 1
        if keep_secs % 10 == 0 {
            dns_keep(false)
        }
        if keep_secs % 60 == 0 {
            log_status()
        }
        left = left - 1
    }
}

// Runs for ever while the lease is renewed; returns when the address was lost
// (the caller then starts over).
fn renew_loop(t1_test: u64) -> u64 {
    var s_r1: [u8; 28] = "dhcp: renewing lease, t1=\0\0\0"
    var s_r2: [u8; 27] = "dhcp: lease renewed, new \0\0"
    var s_r3: [u8; 32] = "dhcp: renewal failed, rebinding\0"
    var s_r4: [u8; 32] = "dhcp: lease lost, starting over\0"
    var s_r5: [u8; 22] = "dhcp: server said NAK\0"
    var s_r6: [u8; 33] = "dhcp: link cycled, starting over\0"
    while true {
        let lease: u64 = o_lease
        if lease == 0 || lease == 0xFFFFFFFF {
            while link_cycled == 0 {
                sleep_secs(60)
            }
            link_cycled = 0
            log_event((&LOG_LINK_RESTART[0 as usize]) as u64)
            return 0
        }
        var t1: u64 = lease / 2
        var t2: u64 = lease * 7 / 8
        if t1_test != 0 {
            t1 = t1_test
            t2 = t1_test * 2
        }
        if t1 < 10 {
            t1 = 10
        }
        if t2 <= t1 {
            t2 = t1 + 10
        }
        say((&s_r1[0 as usize]) as u64)
        ulib.sayn(t1)
        ulib.nl()
        sleep_secs(t1)
        if link_cycled != 0 {
            link_cycled = 0
            say((&s_r6[0 as usize]) as u64)
            ulib.nl()
            return 0
        }
        // RENEWING until T2, with a pause that grows between the attempts
        var spent: u64 = t1
        var got: u64 = 0
        var gap: u64 = 4
        while got != 5 && got != 6 && spent < t2 {
            got = renew_once(true, 4000)
            if got == 0 {
                var wait: u64 = gap
                if spent + wait > t2 {
                    wait = t2 - spent
                }
                if wait > 0 {
                    sleep_secs(wait)
                }
                if link_cycled != 0 {
                    link_cycled = 0
                    say((&s_r6[0 as usize]) as u64)
                    ulib.nl()
                    return 0
                }
                spent = spent + wait + 4
                if gap < 64 {
                    gap = gap * 2
                }
            }
        }
        // REBINDING until the end of the lease
        if got == 0 {
            say((&s_r3[0 as usize]) as u64)
            ulib.nl()
            log_event((&LOG_RENEW_FAIL[0 as usize]) as u64)
            var end: u64 = lease
            if t1_test != 0 {
                end = t1_test * 3
            }
            gap = 4
            while got != 5 && got != 6 && spent < end {
                got = renew_once(false, 4000)
                if got == 0 {
                    sleep_secs(gap)
                    if link_cycled != 0 {
                        link_cycled = 0
                        say((&s_r6[0 as usize]) as u64)
                        ulib.nl()
                        return 0
                    }
                    spent = spent + gap + 4
                    if gap < 64 {
                        gap = gap * 2
                    }
                }
            }
        }
        if got == 5 {
            say((&s_r2[0 as usize]) as u64)
            ulib.sayn(o_lease)
            ulib.nl()
            log_lease((&LOG_RENEWED[0 as usize]) as u64)
        } else {
            if got == 6 {
                say((&s_r5[0 as usize]) as u64)
                ulib.nl()
            }
            say((&s_r4[0 as usize]) as u64)
            ulib.nl()
            log_event((&LOG_LEASE_LOST[0 as usize]) as u64)
            return 0
        }
    }
    return 0
}

fn run_once(args: u64) -> u64 {
    var s_no: [u8; 26] = "dhcp: no net in kernel\0\0\0\0"
    var s_ns: [u8; 26] = "dhcp: kein Socket, errno \0"
    var s_nb: [u8; 34] = "dhcp: bind 68 schlug fehl, errno \0"
    var s_go: [u8; 20] = "dhcp: discover xid=\0"
    var s_mac: [u8; 7] = "  mac=\0"
    var s_of: [u8; 16] = "dhcp: offer ip=\0"
    var s_mk: [u8; 9] = "  maske=\0"
    var s_gw: [u8; 11] = "  gateway=\0"
    var s_sv: [u8; 10] = "  server=\0"
    var s_rq: [u8; 18] = "dhcp: request ip=\0"
    var s_ak: [u8; 14] = "dhcp: ack ip=\0"
    var s_ls: [u8; 9] = "  lease=\0"
    var s_wg: [u8; 7] = "  weg=\0"
    var s_se: [u8; 18] = "dhcp: gesetzt ip=\0"
    var s_er: [u8; 33] = "dhcp: osum_netset abgelehnt, rc=\0"
    var s_to: [u8; 26] = "dhcp: no reply after \0\0\0\0\0"
    var s_ve: [u8; 11] = " Versuchen\0"
    var s_cf: [u8; 46] = "dhcp: /etc/network.conf geschrieben, Oktette \0"
    var s_cn: [u8; 41] = "dhcp: /etc/network.conf nicht schreibbar\0"
    var k_header: [u8; 11] = "modus=dhcp\0"
    var k_ip: [u8; 4] = "ip=\0"
    var k_mk: [u8; 7] = "maske=\0"
    var k_gw: [u8; 9] = "gateway=\0"
    var k_sv: [u8; 8] = "server=\0"
    var k_ls: [u8; 7] = "lease=\0"
    var k_d1: [u8; 6] = "dns1=\0"
    var k_d2: [u8; 6] = "dns2=\0"
    var k_d3: [u8; 6] = "dns3=\0"
    var k_ns: [u8; 12] = "nameserver \0"
    var k_fb: [u8; 9] = "fallback\0"
    var p_res: [u8; 17] = "/etc/resolv.conf\0"
    var s_rs: [u8; 43] = "dhcp: /etc/resolv.conf geschrieben, dns \0\0\0"
    var s_rn: [u8; 50] = "dhcp: no nameserver in lease (option 6 missing)\0\0\0"
    var k_nl: [u8; 2] = "\n\0"
    var p_conf: [u8; 18] = "/etc/network.conf\0"
    var s_ei: [u8; 7] = "einmal\0"
    var s_spaet: [u8; 44] = "dhcp: card was late, waited (x100ms): \0\0\0\0\0\0"
    var s_da: [u8; 6] = "dauer\0"
    var s_t1: [u8; 4] = "t1=\0"
    var t1_test: u64 = 0
    var s_stand: [u8; 7] = "status\0"
    var s_probe: [u8; 8] = "txprobe\0"
    var s_wdh: [u8; 32] = "dhcp: new attempt in seconds: \0\0"

    let argc: u64 = ulib.arg_count(args)
    var versuche: u64 = 6
    var dur: u64 = 0
    var a: u64 = 1
    while a < argc {
        if ulib.streq(ulib.arg_at(args, a), (&s_ei[0 as usize]) as u64) {
            versuche = 1
        }
        if ulib.streq(ulib.arg_at(args, a), (&s_da[0 as usize]) as u64) {
            dur = 1
        }
        if ulib.strneq(ulib.arg_at(args, a), (&s_t1[0 as usize]) as u64, 3) {
            t1_test = ulib.to_num(ulib.arg_at(args, a) + 3)
        }
        if ulib.streq(ulib.arg_at(args, a), (&s_stand[0 as usize]) as u64) {
            status()
            return 0
        }
        if ulib.streq(ulib.arg_at(args, a), (&s_probe[0 as usize]) as u64) {
            txprobe()
            return 0
        }
        a = a + 1
    }
    var ready: u64 = ulib.sys(SYS_NETGET, NG_READY, 0, 0)
    if ready != 1 {
        var gewartet: u64 = 0
        while ready != 1 && gewartet < 100 {
            clockapi.sleep_ms(100)
            gewartet = gewartet + 1
            ready = ulib.sys(SYS_NETGET, NG_READY, 0, 0)
        }
        if ready == 1 {
            say((&s_spaet[0 as usize]) as u64)
            ulib.sayn(gewartet)
            ulib.nl()
        }
    }
    if ready != 1 {
        say((&s_no[0 as usize]) as u64)
        ulib.nl()
        if dur != 0 {
            let wn: u64 = 5
            anlauf = anlauf + 1
            say((&s_wdh[0 as usize]) as u64)
            ulib.sayn(wn)
            ulib.nl()
            clockapi.sleep_ms(wn * 1000)
            return RETRY
        }
        return 1
    }
    link_watch()
    if wlan_adopt() {
        if resolv_write((&p_res[0 as usize]) as u64, (&k_ns[0 as usize]) as u64,
            (&k_fb[0 as usize]) as u64, (&k_nl[0 as usize]) as u64) == 0 {
            log_event((&LOG_RESOLV_FAIL[0 as usize]) as u64)
        }
        dns_keep(true)
        report(4, o_dns1)
        report(5, 0)
        report(6, 0)
        if dur != 0 && renew_loop(t1_test) == 0 {
            return RETRY
        }
        return 0
    }
    let m0: u64 = ulib.sys(SYS_NETGET, NG_MAC0, 0, 0)
    let m1: u64 = ulib.sys(SYS_NETGET, NG_MAC1, 0, 0)
    mac[(0) as usize] = ((m0 >> 24) & 255) as u8
    mac[(1) as usize] = ((m0 >> 16) & 255) as u8
    mac[(2) as usize] = ((m0 >> 8) & 255) as u8
    mac[(3) as usize] = (m0 & 255) as u8
    mac[(4) as usize] = ((m1 >> 8) & 255) as u8
    mac[(5) as usize] = (m1 & 255) as u8
    xid = (ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0) *% 2654435761)
        & 0xFFFFFFFF
    if xid == 0 {
        xid = 0x4F53554D
    }
    // ROUND DELL2: NON-BLOCKING, OR THE WAIT BELOW IS NOT 3 SECONDS BUT
    // 30 MINUTES. A blocking `recvfrom` sleeps up to NET_ROUNDS ticks
    // (30 s, kernel/sys/sys.fi) when nothing is there. The loops below
    // poll 60 times with 50 ms in between, so with a DHCP server that
    // answers at once (QEMU, every test) the difference never showed.
    // On Justin's Dell 9020 nothing answered the first DISCOVER: the
    // client sat in its first `recvfrom`, `dhcp status` said attempt 1
    // forever, and no second DISCOVER ever left. Reproduced in QEMU
    // with a socket netdev and no server; fixed by this one flag.
    let fd: u64 = net.socket(net.AF_INET, net.SOCK_DGRAM | net.SOCK_NONBLOCK, 0)
    if net.failed(fd) {
        say((&s_ns[0 as usize]) as u64)
        ulib.sayn(0 -% fd)
        ulib.nl()
        return later(dur)
    }
    let bf: u64 = net.bind_port(fd, PORT_C)
    if net.failed(bf) {
        say((&s_nb[0 as usize]) as u64)
        ulib.sayn(0 -% bf)
        ulib.nl()
        var s_bg: [u8; 50] = "dhcp: port 68 busy -- a client is already running\0"
        say((&s_bg[0 as usize]) as u64)
        ulib.nl()
        status()
        net.close(fd)
        return later(dur)
    }
    say((&s_go[0 as usize]) as u64)
    ulib.sayn(xid)
    say((&s_mac[0 as usize]) as u64)
    var k: u64 = 0
    while k < 6 {
        ulib.sayn(mac[(k) as usize] as u64)
        k = k + 1
    }
    ulib.nl()

    let rund: u64 = net.ip4(255, 255, 255, 255)
    var tor: u64 = ulib.sys(SYS_NETGET, NG_GW, 0, 0)
    if ulib.bad(tor) {
        tor = 0
    }
    var art: u64 = 0
    var von: u64 = 0
    var runde: u64 = 0
    var gone: u64 = 0 // 0 = Rundruf, 1 = Einzelruf ans Gateway
    var tx: u64 = 0
    var rx: u64 = 0
    while runde < versuche && art != 2 {
        let n: u64 = make(1)
        var target: u64 = rund
        if (runde % 2) == 1 && tor != 0 {
            target = tor
        }
        let _s: u64 = net.sendto_ip(fd, (&aus[0 as usize]) as u64, n, target,
            PORT_S)
        if !net.failed(_s) {
            tx = tx + 1
        }
        report(D_TX, tx)
        report(D_TRY, runde + 1)
        report(D_ST, 1)
        var wait_for: u64 = 0
        while wait_for < 60 && art != 2 {
            let g: u64 = net.recvfrom_ip(fd, (&ein[0 as usize]) as u64, 1024,
                &von)
            if !net.failed(g) && g > 0 {
                rx = rx + 1
                report(D_RX, rx)
                let t: u64 = read((&ein[0 as usize]) as u64, g)
                if t == 2 {
                    art = 2
                    gone = runde % 2
                    report(D_ST, 2)
                }
            } else {
                clockapi.sleep_ms(50)
            }
            wait_for = wait_for + 1
        }
        runde = runde + 1
    }
    if art != 2 {
        report(D_ST, 5) // aufgegeben: kein Angebot
        say((&s_to[0 as usize]) as u64)
        ulib.sayn(runde)
        say((&s_ve[0 as usize]) as u64)
        ulib.nl()
        net.close(fd)
        if dur != 0 {
            var w: u64 = 5
            if anlauf < 4 {
                w = 5 << anlauf
            } else {
                w = 60
            }
            anlauf = anlauf + 1
            say((&s_wdh[0 as usize]) as u64)
            ulib.sayn(w)
            ulib.nl()
            clockapi.sleep_ms(w * 1000)
            return RETRY
        }
        return 1
    }
    say_ip_2((&s_of[0 as usize]) as u64, o_ip)
    say_ip_2((&s_mk[0 as usize]) as u64, o_maske)
    say_ip_2((&s_gw[0 as usize]) as u64, o_gw)
    say_ip_2((&s_sv[0 as usize]) as u64, o_server)
    ulib.nl()

    // 2. REQUEST und ACK.
    say_ip_2((&s_rq[0 as usize]) as u64, o_ip)
    ulib.nl()
    art = 0
    runde = 0
    while runde < versuche && art != 5 {
        let n2: u64 = make(3)
        var target2: u64 = rund
        if gone == 1 && tor != 0 {
            target2 = tor
        }
        let _s2: u64 = net.sendto_ip(fd, (&aus[0 as usize]) as u64, n2, target2,
            PORT_S)
        if !net.failed(_s2) {
            tx = tx + 1
        }
        report(D_TX, tx)
        report(D_ST, 3)
        var wait_for2: u64 = 0
        while wait_for2 < 60 && art != 5 {
            let g2: u64 = net.recvfrom_ip(fd, (&ein[0 as usize]) as u64,
                1024, &von)
            if !net.failed(g2) && g2 > 0 {
                rx = rx + 1
                report(D_RX, rx)
                let t2: u64 = read((&ein[0 as usize]) as u64, g2)
                if t2 == 5 {
                    art = 5
                } else if t2 == 6 {
                    report(D_ST, 6) // NAK
                    runde = versuche
                }
            } else {
                clockapi.sleep_ms(50)
            }
            wait_for2 = wait_for2 + 1
        }
        runde = runde + 1
    }
    net.close(fd)
    if art != 5 {
        if ulib.sys(SYS_DHCPST, D_ST, 0, 0) != 6 {
            report(D_ST, 5)
        }
        say((&s_to[0 as usize]) as u64)
        ulib.sayn(runde)
        say((&s_ve[0 as usize]) as u64)
        ulib.nl()
        return later(dur)
    }
    anlauf = 0
    report(D_ST, 4)
    say_ip_2((&s_ak[0 as usize]) as u64, o_ip)
    say((&s_ls[0 as usize]) as u64)
    ulib.sayn(o_lease)
    say((&s_wg[0 as usize]) as u64)
    ulib.sayn(gone)
    ulib.nl()
    if o_maske == 0 {
        o_maske = net.ip4(255, 255, 255, 0)
    }
    let rc: u64 = ulib.sys(SYS_NETSET, o_ip, o_maske, o_gw)
    if ulib.bad(rc) {
        say((&s_er[0 as usize]) as u64)
        ulib.sayn(0 -% rc)
        ulib.nl()
        return later(dur)
    }
    say_ip_2((&s_se[0 as usize]) as u64, ulib.sys(SYS_NETGET, NG_IP, 0, 0))
    ulib.nl()
    net_note(ulib.sys(SYS_NETGET, NG_IP, 0, 0))

    let c: u64 = (&conf[0 as usize]) as u64
    var at: u64 = text_an(c, 0, (&k_header[0 as usize]) as u64)
    at = text_an(c, at, (&k_nl[0 as usize]) as u64)
    at = text_an(c, at, (&k_ip[0 as usize]) as u64)
    at = ip_an(c, at, o_ip)
    at = text_an(c, at, (&k_nl[0 as usize]) as u64)
    at = text_an(c, at, (&k_mk[0 as usize]) as u64)
    at = ip_an(c, at, o_maske)
    at = text_an(c, at, (&k_nl[0 as usize]) as u64)
    at = text_an(c, at, (&k_gw[0 as usize]) as u64)
    at = ip_an(c, at, o_gw)
    at = text_an(c, at, (&k_nl[0 as usize]) as u64)
    at = text_an(c, at, (&k_sv[0 as usize]) as u64)
    at = ip_an(c, at, o_server)
    at = text_an(c, at, (&k_nl[0 as usize]) as u64)
    at = text_an(c, at, (&k_ls[0 as usize]) as u64)
    at = num_at(c, at, o_lease)
    at = text_an(c, at, (&k_nl[0 as usize]) as u64)
    if o_dns1 != 0 {
        at = text_an(c, at, (&k_d1[0 as usize]) as u64)
        at = ip_an(c, at, o_dns1)
        at = text_an(c, at, (&k_nl[0 as usize]) as u64)
    }
    if o_dns2 != 0 {
        at = text_an(c, at, (&k_d2[0 as usize]) as u64)
        at = ip_an(c, at, o_dns2)
        at = text_an(c, at, (&k_nl[0 as usize]) as u64)
    }
    if o_dns3 != 0 {
        at = text_an(c, at, (&k_d3[0 as usize]) as u64)
        at = ip_an(c, at, o_dns3)
        at = text_an(c, at, (&k_nl[0 as usize]) as u64)
    }
    let fdc: u64 = ulib.sys(ulib.SYS_OPEN, (&p_conf[0 as usize]) as u64,
        577, 0)
    if ulib.bad(fdc) {
        say((&s_cn[0 as usize]) as u64)
        ulib.nl()
        log_event((&LOG_CONF_FAIL[0 as usize]) as u64)
    } else {
        let gw2: u64 = ulib.sys(ulib.SYS_WRITE, fdc, c, at)
        let _cl: u64 = ulib.sys(ulib.SYS_CLOSE, fdc, 0, 0)
        say((&s_cf[0 as usize]) as u64)
        ulib.sayn(gw2)
        ulib.nl()
    }
    log_lease((&LOG_LEASE[0 as usize]) as u64)

    if o_dns1 == 0 {
        say((&s_rn[0 as usize]) as u64)
        ulib.nl()
        dns_keep(true)
        if dur != 0 && renew_loop(t1_test) == 0 {
            return RETRY
        }
        return 0
    }
    let rw: u64 = resolv_write((&p_res[0 as usize]) as u64,
        (&k_ns[0 as usize]) as u64, (&k_fb[0 as usize]) as u64,
        (&k_nl[0 as usize]) as u64)
    if rw == 0 {
        log_event((&LOG_RESOLV_FAIL[0 as usize]) as u64)
    }
    dns_keep(true)
    report(4, o_dns1)
    report(5, o_dns2)
    report(6, o_dns3)
    say((&s_rs[0 as usize]) as u64)
    var dz: u64 = 1
    if o_dns2 != 0 {
        dz = 2
    }
    if o_dns3 != 0 {
        dz = 3
    }
    ulib.sayn(dz)
    ulib.nl()
    // DELL STABILITY: stay and keep the lease (see `renew_loop`)
    if dur != 0 && renew_loop(t1_test) == 0 {
        return RETRY
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    log_event((&LOG_START[0 as usize]) as u64)
    while true {
        let r: u64 = run_once(args)
        if r != RETRY {
            return r
        }
    }
    return 0
}

// ROUND DELL5: `dhcp txprobe` -- the driver resets the card eight times,
// one variant each, and sends one frame per variant (e1000.txprobe_on).
// Takes up to a minute; the screen may stand still meanwhile.
fn txprobe() {
    var h: [u8; 45] = "txprobe: 8 variants, up to a minute ...     \0"
    say((&h[0 as usize]) as u64)
    ulib.nl()
    let v: u64 = hw(49)
    var l: [u8; 11] = "txprobe: v\0"
    var e: [u8; 2] = "=\0"
    var sp: [u8; 3] = "  \0"
    if ulib.bad(v) || v == 0xFFFFFFFF {
        var na: [u8; 23] = "txprobe: not available\0"
        say((&na[0 as usize]) as u64)
        ulib.nl()
        return
    }
    say((&l[0 as usize]) as u64)
    var i: u64 = 0
    while i < 8 {
        if i > 0 {
            say((&sp[0 as usize]) as u64)
            ulib.sayn(i)
        } else {
            ulib.sayn(0)
        }
        say((&e[0 as usize]) as u64)
        say_hex((v >> (i * 4)) & 0xF, 1)
        i = i + 1
    }
    ulib.nl()
}
