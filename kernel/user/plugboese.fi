
profile kernel

import libc.memcopy
import ulib
import libc.kcall
import libc.clockapi
import lineout

export { u_start }

const WM_CREATE: u64 = 2100
const WM_LIST: u64 = 2110

const WM_PLUG_REG: u64 = 2117
const WM_PLUG_UNREG: u64 = 2118
const WM_PLUG_POLL: u64 = 2119
const WM_PLUG_INFO: u64 = 2121
const WM_PLUG_ACT: u64 = 2122
const WM_PLUG_BAR: u64 = 2124

const PL_ABI: u64 = 0
const PL_RIGHTS: u64 = 5
const PL_DENY: u64 = 13

const WMP_ABI: u64 = 1

const PA_MOVE: u64 = 1

const EV_ALL: u64 = 0x7E

const WL_ID: u64 = 0
const WL_X: u64 = 8
const WL_Y: u64 = 16
const WL_FLAGS: u64 = 48
const WL_BYTES: u64 = 128
const MAX_WIN: u64 = 32

static mut list: [u8; 128] = [0 as u8; 128]
static mut own_id: u64 = 0

fn is_err(v: u64) -> bool {
    return v > 0xFFFFFFFFFFFFF000
}

fn fehlernr(v: u64) -> u64 {
    return 0 -% v
}

fn s(p: u64) {
    let _r: u64 = lineout.add_text(p)
}

fn header() {
    var s_k: [u8; 12] = "plugboese: \0"
    s((&s_k[0 as usize]) as u64)
}

fn field(name: u64, v: u64) {
    s(name)
    lineout.add_unum(v)
}

fn name_in(p: u64, modus: u64) {
    var s_nm: [u8; 6] = "boese\0"
    var s_nb: [u8; 9] = "boesebar\0"
    memcopy.fill(p, 0, 16)
    if modus == 1 {
        let _b: u64 = ulib.strncpy(p, (&s_nb[0 as usize]) as u64, 15)
        return
    }
    let _c: u64 = ulib.strncpy(p, (&s_nm[0 as usize]) as u64, 15)
}

fn get_record(id: u64) -> u64 {
    let lp: u64 = (&list[0 as usize]) as u64
    var p: u64 = 0
    while p < MAX_WIN {
        let r: u64 = ulib.sys(WM_LIST, p, lp, WL_BYTES)
        if is_err(r) {
            return 0
        }
        if r == 1 && __mmio_read64((lp + WL_ID) as *mut u64) == id {
            return 1
        }
        p = p + 1
    }
    return 0
}

fn foreign_window() -> u64 {
    let lp: u64 = (&list[0 as usize]) as u64
    var p: u64 = 0
    while p < MAX_WIN {
        let r: u64 = ulib.sys(WM_LIST, p, lp, WL_BYTES)
        if is_err(r) {
            return 0
        }
        if r == 1 {
            let id: u64 = __mmio_read64((lp + WL_ID) as *mut u64)
            if id != 0 && id != own_id {
                return id
            }
        }
        p = p + 1
    }
    return 0
}

fn greifen() -> u64 {
    var s_su: [u8; 29] = "looking for a foreign window\0"
    var s_kf: [u8; 24] = "no foreign window found\0"
    var s_vo: [u8; 8] = "vorher \0"
    var s_na: [u8; 9] = "nachher \0"
    var s_gr: [u8; 23] = "griff nach fremdem id=\0"
    var s_rc: [u8; 9] = " errors=\0"
    var s_id: [u8; 4] = "id=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_dy: [u8; 7] = " deny=\0"
    var s_ok: [u8; 41] = "rights probe: rejected AND nothing moved\0"
    var s_nk: [u8; 39] = "rights probe: FAILED, it had an effect\0"

    header()
    s((&s_su[0 as usize]) as u64)
    lineout.end_line()
    let target: u64 = foreign_window()
    if target == 0 {
        header()
        s((&s_kf[0 as usize]) as u64)
        lineout.end_line()
        return 1
    }
    if get_record(target) != 1 {
        header()
        s((&s_kf[0 as usize]) as u64)
        lineout.end_line()
        return 1
    }
    let lp: u64 = (&list[0 as usize]) as u64
    let x0: u64 = __mmio_read64((lp + WL_X) as *mut u64)
    let y0: u64 = __mmio_read64((lp + WL_Y) as *mut u64)
    header()
    s((&s_vo[0 as usize]) as u64)
    s((&s_id[0 as usize]) as u64)
    lineout.add_unum(target)
    field((&s_x[0 as usize]) as u64, x0)
    field((&s_y[0 as usize]) as u64, y0)
    lineout.end_line()

    let d0: u64 = ulib.sys(WM_PLUG_INFO, 0, PL_DENY, 0)
    let rc: u64 = ulib.sys(WM_PLUG_ACT, PA_MOVE, target, (7 << 16) | 7)
    let d1: u64 = ulib.sys(WM_PLUG_INFO, 0, PL_DENY, 0)
    header()
    s((&s_gr[0 as usize]) as u64)
    lineout.add_unum(target)
    field((&s_rc[0 as usize]) as u64, fehlernr(rc))
    field((&s_dy[0 as usize]) as u64, d1 -% d0)
    lineout.end_line()

    let _z: u64 = clockapi.sleep_ms(200)
    if get_record(target) != 1 {
        header()
        s((&s_kf[0 as usize]) as u64)
        lineout.end_line()
        return 1
    }
    let x1: u64 = __mmio_read64((lp + WL_X) as *mut u64)
    let y1: u64 = __mmio_read64((lp + WL_Y) as *mut u64)
    header()
    s((&s_na[0 as usize]) as u64)
    s((&s_id[0 as usize]) as u64)
    lineout.add_unum(target)
    field((&s_x[0 as usize]) as u64, x1)
    field((&s_y[0 as usize]) as u64, y1)
    lineout.end_line()

    header()
    if is_err(rc) && x0 == x1 && y0 == y1 {
        s((&s_ok[0 as usize]) as u64)
        lineout.end_line()
        return 0
    }
    s((&s_nk[0 as usize]) as u64)
    lineout.end_line()
    return 1
}

fn schwelle_reizen(target: u64) {
    var s_sw: [u8; 20] = "schwelle: griffe=\0\0\0"
    var s_le: [u8; 9] = " letzte=\0"
    var s_dy: [u8; 7] = " deny=\0"
    var i: u64 = 0
    var last: u64 = 0
    while i < 12 {
        let rc: u64 = ulib.sys(WM_PLUG_ACT, PA_MOVE, target, (9 << 16) | 9)
        last = fehlernr(rc)
        i = i + 1
    }
    header()
    s((&s_sw[0 as usize]) as u64)
    lineout.add_unum(i)
    s((&s_le[0 as usize]) as u64)
    lineout.add_unum(last)
    s((&s_dy[0 as usize]) as u64)
    lineout.add_unum(ulib.sys(WM_PLUG_INFO, 0, PL_DENY, 0))
    lineout.end_line()
}

fn u_start(args: u64) -> u64 {
    var name: [u8; 16] = [0 as u8; 16]
    var w_segv: [u8; 5] = "segv\0"
    var w_hang: [u8; 5] = "hang\0"
    var s_abi: [u8; 5] = "abi=\0"
    var s_bad: [u8; 29] = "wrong interface version, end\0"
    var s_pl: [u8; 7] = "platz=\0"
    var s_re: [u8; 9] = " rechte=\0"
    var s_no: [u8; 24] = "no registration, error=\0"
    var s_sg: [u8; 22] = "gleich stuerze ich ab\0"
    var s_hg: [u8; 25] = "ab jetzt hole ich nichts\0"
    var s_en: [u8; 10] = "ende, rc=\0"
    var w_leis: [u8; 7] = "leiste\0"
    let p: u64 = (&name[0 as usize]) as u64

    var modus: u64 = 0
    let n_arg: u64 = ulib.arg_count(args)
    var ai: u64 = 0
    while ai < n_arg {
        let a: u64 = ulib.arg_at(args, ai)
        if ulib.streq(a, (&w_segv[0 as usize]) as u64) {
            modus = 1
        }
        if ulib.streq(a, (&w_hang[0 as usize]) as u64) {
            modus = 2
        }
        ai = ai + 1
    }
    name_in(p, modus)

    let abi: u64 = ulib.sys(WM_PLUG_INFO, 0, PL_ABI, 0)
    header()
    field((&s_abi[0 as usize]) as u64, abi)
    lineout.end_line()
    if is_err(abi) || abi != WMP_ABI {
        header()
        s((&s_bad[0 as usize]) as u64)
        lineout.end_line()
        return 1
    }

    var wunsch: u64 = 100
    if modus == 2 {
        wunsch = 0
    }
    let space: u64 = kcall.sys4(WM_PLUG_REG, WMP_ABI, p, EV_ALL, wunsch)
    if is_err(space) {
        header()
        s((&s_no[0 as usize]) as u64)
        lineout.add_unum(fehlernr(space))
        lineout.end_line()
        return 1
    }
    let rechte: u64 = ulib.sys(WM_PLUG_INFO, space, PL_RIGHTS, 0)
    header()
    field((&s_pl[0 as usize]) as u64, space)
    field((&s_re[0 as usize]) as u64, rechte)
    lineout.end_line()

    if modus == 1 {
        var s_bt: [u8; 13] = "plugin lebt\0\0"
        var s_ls: [u8; 22] = "leiste gesetzt, rc=\0\0\0"
        var s_wt: [u8; 19] = "wait rounds=\0\0\0\0\0\0\0"
        let brc: u64 = ulib.sys(WM_PLUG_BAR, (&s_bt[0 as usize]) as u64, 11, 0)
        header()
        s((&s_ls[0 as usize]) as u64)
        lineout.add_num(brc)
        lineout.end_line()
        var evs: [u64; 2] = [0; 2]
        let esp: u64 = (&evs[0 as usize]) as u64
        var r1: u64 = 0
        while r1 < 50 {
            var w1: u64 = 0
            while w1 < 8 && ulib.sys(WM_PLUG_POLL, esp, 0, 0) == 1 {
                w1 = w1 + 1
            }
            let _s1: u64 = clockapi.sleep_ms(100)
            r1 = r1 + 1
        }
        header()
        s((&s_wt[0 as usize]) as u64)
        lineout.add_unum(r1)
        lineout.end_line()
        header()
        s((&s_sg[0 as usize]) as u64)
        lineout.end_line()
        let z: u64 = 0
        *((z) as *mut u64) = 1
        return 0
    }

    if modus == 2 {
        var t2: [u8; 8] = "boese  \0"
        let _h: u64 = kcall.sys4(WM_CREATE, (80 << 16) | 80,
            (160 << 16) | 100, (&t2[0 as usize]) as u64, 0)
        header()
        s((&s_hg[0 as usize]) as u64)
        lineout.end_line()
        var a: u64 = 0
        while a < 4000000 {
            let _pid: u64 = ulib.sys(ulib.SYS_GETPID, 0, 0, 0)
            a = a + 1
        }
        return 0
    }

    var ev: [u64; 2] = [0; 2]
    let ep: u64 = (&ev[0 as usize]) as u64
    var runde: u64 = 0
    while runde < 20 {
        var w: u64 = 0
        while w < 8 && ulib.sys(WM_PLUG_POLL, ep, 0, 0) == 1 {
            w = w + 1
        }
        let _z: u64 = clockapi.sleep_ms(100)
        runde = runde + 1
    }
    let rc: u64 = greifen()
    let target2: u64 = foreign_window()
    if target2 != 0 {
        schwelle_reizen(target2)
    }
    let _u: u64 = ulib.sys(WM_PLUG_UNREG, 0, 0, 0)
    header()
    field((&s_en[0 as usize]) as u64, rc)
    lineout.end_line()
    return rc
}
