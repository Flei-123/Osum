// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/plugboese.fi -- DAS BOESWILLIGE PLUGIN, ABSICHTLICH.
//
// Die drei harten Grenzen der Runde sind nur dann gemessen, wenn es ein
// Plugin gibt, das sie wirklich verletzt. Genau dafuer ist dieses
// Programm da -- es ist kein Stummel und kein Platzhalter, sondern der
// Prueflingsgegner, auf den /etc/wmplug.conf mit der Zeile
// `boese rechte=0x001` schon zeigt.
//
// ES BEKOMMT ABSICHTLICH NUR R_EV_WIN (0x001): zusehen, nichts
// anfassen. Wer diese Zeile in /etc/wmplug.conf aufbohrt, macht die
// Rechte-Gegenprobe kaputt.
//
//   plugboese greif   nach einem FREMDEN Fenster greifen, ohne
//                     R_ACT_WIN zu haben. Erwartet: Fehlercode UND das
//                     Fenster steht nachweislich noch da, wo es stand.
//                     Gemessen wird der ZUSTAND (x/y vorher/nachher),
//                     nicht der Rueckgabewert allein.
//   plugboese segv    anmelden und in die Null schreiben. Der Kern muss
//                     den Platz selber abholen (`reap`), der Schreibtisch
//                     laeuft weiter.
//   plugboese hang    anmelden, abonnieren und NICHTS mehr abholen. Die
//                     Frist muss greifen und das Plugin abmelden.
//
// KEIN VERBORGENES FENSTER MEHR. Bis zu dieser Runde legte auch dieses
// Programm ein Fenster von 32x16 Bildpunkten mit einem Streifen an, nur
// damit `is_taskbar` es fuer eine Taskleiste hielt und WM_LIST ihm
// antwortete. Der Schluessel ist jetzt das Recht `R_EV_WIN` selbst
// (sysgui.fi, `darf_listen`) -- und das hat dieses Plugin, es steht in
// /etc/wmplug.conf. LESEN DARF ES ALSO, HANDELN NICHT, und genau
// dieser Unterschied ist die Gegenprobe.
//
// `plugboese segv` meldet sich unter dem Namen `boesebar` an: diese
// Zeile in /etc/wmplug.conf traegt zusaetzlich R_ACT_BAR, damit das
// Plugin VOR dem Absturz ein Feld in der Leiste besetzt. Nach dem
// Absturz ist das Feld leer -- das ist der SICHTBARE Beleg dafuer,
// dass der Kern den Toten abgeholt hat, und er wird im Foto
// nachgerechnet und nicht behauptet.

profile kernel

import ulib

export { u_start }

// ---------------------------------------------------- die Schnittstelle
const WM_CREATE: u64 = 2100
const WM_LIST: u64 = 2110

const WM_PLUG_REG: u64 = 2117
const WM_PLUG_UNREG: u64 = 2118
const WM_PLUG_POLL: u64 = 2119
const WM_PLUG_INFO: u64 = 2121
const WM_PLUG_ACT: u64 = 2122
const WM_PLUG_BAR: u64 = 2124

const PL_ABI: u64 = 0
const PL_RIGHTS: u64 = 5
const PL_DENY: u64 = 13

const WMP_ABI: u64 = 1

// die Handlungen (wmplug.PA_*)
const PA_MOVE: u64 = 1

// DAS ABONNEMENT IST EINE MASKE UEBER EREIGNISARTEN, NICHT UEBER RECHTE.
// GEMESSENER BEFUND: hier stand erst `R_EV_WIN` (0x01, ein RECHTEbit).
// Bit 0 ist gar keine Ereignisart -- E_WIN_OPEN ist 1, also Bit 1. Das
// Plugin war damit auf NICHTS abonniert, es lag ihm nie etwas, und die
// Frist konnte gar nicht reissen (`sweep` greift nur bei
// P_HEAD != P_TAIL). Der Haengerlauf endete deshalb still mit G_CRASH
// statt mit G_FRIST und sah aus wie eine Messung.
// Bits 1..6: E_WIN_OPEN, E_WIN_CLOSE, E_FOCUS, E_DESK, E_TILE, E_KEY.
const EV_ALLE: u64 = 0x7E

// die Felder eines WM_LIST-Satzes (sys.WL_*)
const WL_ID: u64 = 0
const WL_X: u64 = 8
const WL_Y: u64 = 16
const WL_FLAGS: u64 = 48
const WL_BYTES: u64 = 128
const MAX_WIN: u64 = 16

static mut liste: [u8; 128] = [0 as u8; 128]
static mut eigen_id: u64 = 0

fn is_err(v: u64) -> bool {
    return v > 0xFFFFFFFFFFFFF000
}

// Der Betrag eines Fehlers -- -E_RIGHTS soll als 2 dastehen.
fn fehlernr(v: u64) -> u64 {
    return 0 -% v
}

fn s(p: u64) {
    let _r: u64 = ulib.say(p)
}

// "plugboese: " -- der Anfang jeder Zeile dieses Programms.
fn kopf() {
    var s_k: [u8; 12] = "plugboese: \0"
    s((&s_k[0 as usize]) as u64)
}

fn feld(name: u64, v: u64) {
    s(name)
    ulib.sayu(v)
}

// DER NAME STEHT IN SECHZEHN OKTETTEN, und das ist kein Zufall:
// WM_PLUG_REG holt sich fuenfzehn, egal wie kurz der Name ist. Wer hier
// ein `[u8; 6]` hinlegt, schickt seinen halben Stapel als Namen mit
// (gemessener Befund, BEFUND-WMPLUG-NAMENSPUFFER.md).
fn name_in(p: u64, modus: u64) {
    var s_nm: [u8; 6] = "boese\0"
    var s_nb: [u8; 9] = "boesebar\0"
    ulib.fill(p, 0, 16)
    if modus == 1 {
        let _b: u64 = ulib.strncpy(p, (&s_nb[0 as usize]) as u64, 15)
        return
    }
    let _c: u64 = ulib.strncpy(p, (&s_nm[0 as usize]) as u64, 15)
}

// Den Satz zu dieser Fenster-Id holen. Rueckgabe 1 = da.
fn satz_holen(id: u64) -> u64 {
    let lp: u64 = (&liste[0 as usize]) as u64
    var p: u64 = 0
    while p < MAX_WIN {
        let r: u64 = ulib.sys(WM_LIST, p, lp, WL_BYTES)
        if is_err(r) {
            return 0
        }
        if r == 1 && __mmio_read64((lp + WL_ID) as *mut u64) == id {
            return 1
        }
        p = p + 1
    }
    return 0
}

// Irgendein FREMDES Fenster suchen -- nicht das eigene Leserechtsfenster.
fn fremdes_fenster() -> u64 {
    let lp: u64 = (&liste[0 as usize]) as u64
    var p: u64 = 0
    while p < MAX_WIN {
        let r: u64 = ulib.sys(WM_LIST, p, lp, WL_BYTES)
        if is_err(r) {
            return 0
        }
        if r == 1 {
            let id: u64 = __mmio_read64((lp + WL_ID) as *mut u64)
            if id != 0 && id != eigen_id {
                return id
            }
        }
        p = p + 1
    }
    return 0
}

// ------------------------------------------------- die Rechte-Gegenprobe
//
// DER KERN GIBT EINEN FEHLER ZURUECK -- das allein waere kein Beleg.
// Also wird der Ort VORHER gelesen, der Griff getan, und der Ort
// NACHHER noch einmal gelesen. Gleich geblieben heisst: nicht passiert.
fn greifen() -> u64 {
    var s_su: [u8; 26] = "suche ein fremdes Fenster\0"
    var s_kf: [u8; 30] = "kein fremdes Fenster gefunden\0"
    var s_vo: [u8; 8] = "vorher \0"
    var s_na: [u8; 9] = "nachher \0"
    var s_gr: [u8; 23] = "griff nach fremdem id=\0"
    var s_rc: [u8; 9] = " fehler=\0"
    var s_id: [u8; 4] = "id=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_dy: [u8; 7] = " deny=\0"
    var s_ok: [u8; 42] = "rechteprobe: abgewiesen UND nichts bewegt\0"
    var s_nk: [u8; 41] = "rechteprobe: GESCHEITERT, es hat gewirkt\0"

    kopf()
    s((&s_su[0 as usize]) as u64)
    ulib.nl()
    let ziel: u64 = fremdes_fenster()
    if ziel == 0 {
        kopf()
        s((&s_kf[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    if satz_holen(ziel) != 1 {
        kopf()
        s((&s_kf[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    let lp: u64 = (&liste[0 as usize]) as u64
    let x0: u64 = __mmio_read64((lp + WL_X) as *mut u64)
    let y0: u64 = __mmio_read64((lp + WL_Y) as *mut u64)
    kopf()
    s((&s_vo[0 as usize]) as u64)
    s((&s_id[0 as usize]) as u64)
    ulib.sayu(ziel)
    feld((&s_x[0 as usize]) as u64, x0)
    feld((&s_y[0 as usize]) as u64, y0)
    ulib.nl()

    let d0: u64 = ulib.sys(WM_PLUG_INFO, 0, PL_DENY, 0)
    // DER GRIFF. Ein Ort, der sich garantiert vom jetzigen
    // unterscheidet -- sonst waere "nichts bewegt" nicht zu sehen.
    let rc: u64 = ulib.sys(WM_PLUG_ACT, PA_MOVE, ziel, (7 << 16) | 7)
    let d1: u64 = ulib.sys(WM_PLUG_INFO, 0, PL_DENY, 0)
    kopf()
    s((&s_gr[0 as usize]) as u64)
    ulib.sayu(ziel)
    feld((&s_rc[0 as usize]) as u64, fehlernr(rc))
    feld((&s_dy[0 as usize]) as u64, d1 -% d0)
    ulib.nl()

    // UND JETZT DER ZUSTAND. Kurz warten, damit ein Bildlauf des
    // Servers dazwischen gepasst haette, wenn etwas passiert waere.
    let _z: u64 = ulib.sleep_ms(200)
    if satz_holen(ziel) != 1 {
        kopf()
        s((&s_kf[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    let x1: u64 = __mmio_read64((lp + WL_X) as *mut u64)
    let y1: u64 = __mmio_read64((lp + WL_Y) as *mut u64)
    kopf()
    s((&s_na[0 as usize]) as u64)
    s((&s_id[0 as usize]) as u64)
    ulib.sayu(ziel)
    feld((&s_x[0 as usize]) as u64, x1)
    feld((&s_y[0 as usize]) as u64, y1)
    ulib.nl()

    kopf()
    if is_err(rc) && x0 == x1 && y0 == y1 {
        s((&s_ok[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    s((&s_nk[0 as usize]) as u64)
    ulib.nl()
    return 1
}

// ------------------------------------------- die Schwelle der Geduld
//
// EINMAL FRAGEN IST EINE FRAGE, ACHTMAL GREIFEN IST EINE ABSICHT. Der
// Kern zaehlt die abgewiesenen Handlungen je Platz und meldet den Platz
// ab DENY_MAX (acht) mit G_RIGHTS ab -- auf der Leitung steht dann
// `wmplug: unreg boese grund=3`. Diese Schleife greift so lange nach
// demselben fremden Fenster, bis der Kern das tut, und zaehlt mit, beim
// wievielten Griff er aufgehoert hat, zu antworten (-E_NOTFOUND = -4
// statt -E_RIGHTS = -2: der Platz ist dann schon weg).
fn schwelle_reizen(ziel: u64) {
    var s_sw: [u8; 20] = "schwelle: griffe=\0\0\0"
    var s_le: [u8; 9] = " letzte=\0"
    var s_dy: [u8; 7] = " deny=\0"
    var i: u64 = 0
    var letzte: u64 = 0
    while i < 12 {
        let rc: u64 = ulib.sys(WM_PLUG_ACT, PA_MOVE, ziel, (9 << 16) | 9)
        letzte = fehlernr(rc)
        i = i + 1
    }
    kopf()
    s((&s_sw[0 as usize]) as u64)
    ulib.sayu(i)
    s((&s_le[0 as usize]) as u64)
    ulib.sayu(letzte)
    s((&s_dy[0 as usize]) as u64)
    ulib.sayu(ulib.sys(WM_PLUG_INFO, 0, PL_DENY, 0))
    ulib.nl()
}

// -------------------------------------------------------------- Hauptweg
fn u_start(args: u64) -> u64 {
    var name: [u8; 16] = [0 as u8; 16]
    var w_segv: [u8; 5] = "segv\0"
    var w_hang: [u8; 5] = "hang\0"
    var s_abi: [u8; 5] = "abi=\0"
    var s_bad: [u8; 40] = "falsche Fassung der Schnittstelle, ende\0"
    var s_pl: [u8; 7] = "platz=\0"
    var s_re: [u8; 9] = " rechte=\0"
    var s_no: [u8; 25] = "keine Anmeldung, fehler=\0"
    var s_sg: [u8; 22] = "gleich stuerze ich ab\0"
    var s_hg: [u8; 25] = "ab jetzt hole ich nichts\0"
    var s_en: [u8; 10] = "ende, rc=\0"
    var w_leis: [u8; 7] = "leiste\0"
    let p: u64 = (&name[0 as usize]) as u64

    // ALLE ARGUMENTE DURCHSEHEN, nicht nur das erste nach dem Namen.
    // GEMESSENER BEFUND: `/bin/plugboese boese segv` kommt als drei
    // Woerter an (Pfad, "boese", "segv"), nicht als zwei. Wer nur auf
    // Platz 1 schaut, findet dort "boese", faellt auf den Vorgabemodus
    // zurueck und misst still die falsche Gegenprobe -- genau das ist
    // zweimal passiert.
    //
    // DER MODUS STEHT VOR DER ANMELDUNG FEST, weil er den NAMEN
    // bestimmt: `segv` meldet sich als `boesebar` an und bekommt damit
    // die Zeile aus /etc/wmplug.conf, die R_ACT_BAR traegt.
    var modus: u64 = 0
    let n_arg: u64 = ulib.arg_count(args)
    var ai: u64 = 0
    while ai < n_arg {
        let a: u64 = ulib.arg_at(args, ai)
        if ulib.streq(a, (&w_segv[0 as usize]) as u64) {
            modus = 1
        }
        if ulib.streq(a, (&w_hang[0 as usize]) as u64) {
            modus = 2
        }
        ai = ai + 1
    }
    name_in(p, modus)

    // DIE FASSUNG ZUERST. Ein Plugin, das gegen eine andere Fassung
    // gebaut wurde, meldet sich gar nicht erst an.
    let abi: u64 = ulib.sys(WM_PLUG_INFO, 0, PL_ABI, 0)
    kopf()
    feld((&s_abi[0 as usize]) as u64, abi)
    ulib.nl()
    if is_err(abi) || abi != WMP_ABI {
        kopf()
        s((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }

    // Viertes Argument: die gewuenschte Frist in Ticks. Zwei Sekunden
    // sind das Meiste, was ein Plugin sich ohne Eintrag in
    // /etc/wmplug.conf selbst nehmen darf; der Haengerlauf laeuft
    // ohnehin mit `plugfrist`, das die Frist des KERNS kuerzt -- und
    // eine eigene Zahl soll die Gegenprobe nicht zahm machen, deshalb
    // steht hier im Haengermodus eine Null.
    var wunsch: u64 = 100
    if modus == 2 {
        wunsch = 0
    }
    let platz: u64 = ulib.sys4(WM_PLUG_REG, WMP_ABI, p, EV_ALLE, wunsch)
    if is_err(platz) {
        kopf()
        s((&s_no[0 as usize]) as u64)
        ulib.sayu(fehlernr(platz))
        ulib.nl()
        return 1
    }
    let rechte: u64 = ulib.sys(WM_PLUG_INFO, platz, PL_RIGHTS, 0)
    kopf()
    feld((&s_pl[0 as usize]) as u64, platz)
    feld((&s_re[0 as usize]) as u64, rechte)
    ulib.nl()

    if modus == 1 {
        // ERST DAS FELD IN DER LEISTE BESETZEN, DANN ABSTUERZEN. Der
        // Beleg der Runde ist nicht die Zeile auf der Leitung, sondern
        // das Bild: vor dem Absturz steht der Text im Leistenfeld,
        // danach ist das Feld weg, weil der Kern den Toten abgeholt
        // und seinen Platz geraeumt hat. Beides wird fotografiert und
        // mit `checkshot.py punkt` nachgerechnet.
        var s_bt: [u8; 13] = "plugin lebt\0\0"
        var s_ls: [u8; 22] = "leiste gesetzt, rc=\0\0\0"
        var s_wt: [u8; 19] = "warte runden=\0\0\0\0\0\0"
        let brc: u64 = ulib.sys(WM_PLUG_BAR, (&s_bt[0 as usize]) as u64, 11, 0)
        kopf()
        s((&s_ls[0 as usize]) as u64)
        ulib.sayn(brc)
        ulib.nl()
        // UND JETZT BRAV ABHOLEN, damit die Frist NICHT greift: was
        // hier gemessen werden soll, ist der Absturz und nicht der
        // Kehrbesen. FUENFZIG Runden zu 100 ms sind fuenf Sekunden --
        // genug, dass die Leiste den Text wirklich gemalt hat und das
        // erste Foto ihn zeigt:
        // der Abnahmelauf schiesst sein erstes Foto zwei Sekunden nach
        // der Zeile `leiste gesetzt`, und es soll SICHER vor dem
        // Absturz entstehen.
        var evs: [u64; 2] = [0; 2]
        let esp: u64 = (&evs[0 as usize]) as u64
        var r1: u64 = 0
        while r1 < 50 {
            var w1: u64 = 0
            while w1 < 8 && ulib.sys(WM_PLUG_POLL, esp, 0, 0) == 1 {
                w1 = w1 + 1
            }
            let _s1: u64 = ulib.sleep_ms(100)
            r1 = r1 + 1
        }
        kopf()
        s((&s_wt[0 as usize]) as u64)
        ulib.sayu(r1)
        ulib.nl()
        kopf()
        s((&s_sg[0 as usize]) as u64)
        ulib.nl()
        // DER ABSTURZ. Kein exit, kein unreg -- genau so endet ein
        // fehlerhaftes Plugin. Den Platz muss der Kern selber abholen.
        let z: u64 = 0
        *((z) as *mut u64) = 1
        return 0
    }

    if modus == 2 {
        // ERST ETWAS ZU TUN VERSCHAFFEN, dann nicht mehr abholen: die
        // Frist greift auf den Befund "gerufen worden und nicht
        // gekommen". Ein Plugin, dem nichts liegt, ist still und nicht
        // traege -- das ist der Unterschied, und er ist gewollt.
        var t2: [u8; 8] = "boese  \0"
        let _h: u64 = ulib.sys4(WM_CREATE, (80 << 16) | 80,
            (160 << 16) | 100, (&t2[0 as usize]) as u64, 0)
        kopf()
        s((&s_hg[0 as usize]) as u64)
        ulib.nl()
        // EINE REINE ZAEHLSCHLEIFE WIRFT DER UEBERSETZER WEG (gemessen:
        // das Programm kam sofort zurueck, bevor die Frist laufen
        // konnte). Ein Aufruf, den er nicht wegwerfen darf, haelt den
        // Prozess beschaeftigt. Fuer die Frist zaehlt ohnehin nur
        // eines: er holt seine Ereignisse nicht ab.
        var a: u64 = 0
        while a < 4000000 {
            let _pid: u64 = ulib.sys(ulib.SYS_GETPID, 0, 0, 0)
            a = a + 1
        }
        return 0
    }

    // MODUS `greif` -- die Rechte-Gegenprobe. KEIN eigenes Fenster
    // mehr: WM_LIST oeffnet jetzt das Recht R_EV_WIN, das dieses
    // Plugin aus /etc/wmplug.conf hat.
    // Dem Schreibtisch Zeit lassen, seine Fenster aufzumachen, und
    // dabei brav die eigenen Ereignisse abholen: dieses Plugin ist
    // boesartig in der HANDLUNG, nicht in der Hoeflichkeit -- sonst
    // haette die Frist es abgemeldet, bevor es greifen konnte, und
    // gemessen waere die falsche Grenze.
    var ev: [u64; 2] = [0; 2]
    let ep: u64 = (&ev[0 as usize]) as u64
    var runde: u64 = 0
    while runde < 20 {
        var w: u64 = 0
        while w < 8 && ulib.sys(WM_PLUG_POLL, ep, 0, 0) == 1 {
            w = w + 1
        }
        let _z: u64 = ulib.sleep_ms(100)
        runde = runde + 1
    }
    let rc: u64 = greifen()
    // UND DANN NICHT AUFHOEREN. Die Zusage dahinter: ein Plugin, das in
    // einer Schleife nach fremden Fenstern greift, fliegt von der Tafel
    // -- mit dem Grund G_RIGHTS (3) und nicht mit Frist oder Absturz.
    let ziel2: u64 = fremdes_fenster()
    if ziel2 != 0 {
        schwelle_reizen(ziel2)
    }
    let _u: u64 = ulib.sys(WM_PLUG_UNREG, 0, 0, 0)
    kopf()
    feld((&s_en[0 as usize]) as u64, rc)
    ulib.nl()
    return rc
}
