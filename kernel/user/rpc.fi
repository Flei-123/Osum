// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/rpc.fi -- REQUEST / REPLY ON THE KERNEL BUS (orient-rpc).
// The concept and the numbers are in docs/RPC.md.
//
// WHAT WAS MISSING. The kernel bus (docs/SYSTEMBUS.md) delivers a message
// and stamps the sender; the action bus (actwire.fi) has frames, ids and
// a blocking receive, but its request/reply is hand-written three times
// (act, orientbus, notes) and only for the broker. Every other service
// would have had to repeat: reply box, id, reassembly, timeout, "what if
// the server died". This module is that, once:
//
//   client   open a reply box r.<pid> (once), call(...) and wait, or
//            call_async(...) and collect later with state_of/take
//   server   serve_open(name), serve_next(ms), reply / fail
//
// WIRE. Exactly the frames of actwire.fi (K_REQ out, K_REP back, same
// id), nothing new in the kernel. A request payload is opaque (by
// convention text, one verb per line, like the action bus). A reply
// payload is ONE STATUS OCTET and then the data:
//
//     status 0      ok
//     status 1..99  refused by the server side of this library
//     status 100+   answered by the client side (nothing came from a server)
//
// The server may use any status 1..99 of its own (E_FAILED = 7 and up).
//
// WHO IS TRUSTED. The kernel puts pid and uid into every frame. A server
// learns WHO asked from req_pid/req_uid (not from the text). The client
// accepts a reply only for an id it is waiting for, and only from the one
// pid that sent the FIRST frame of that reply; a frame of another pid in
// the middle counts as a protocol error and is dropped. The reply box is
// A_SAMEUID (as in the action bus): a server of ANOTHER user reaches it
// only as root. The 32-bit id comes from actwire.rnd() (not secret from
// the same user, which can read the bus anyway).
//
// LIMITS (measured/declared in docs/RPC.md): request <= 2047 octets
// (actwire reassembly slots), reply <= 4095 octets incl. the status
// octet, 8 calls in flight per process. Bigger data belongs in a bus
// segment (bus.seg_*); passing a segment id in the request is the
// convention, not code here.
//
// WAITING. bus_wait blocks in the kernel; the wait is cut into slices of
// at most 100 ms, and between slices the client asks whether the service
// still exists. A server that dies mid-call is therefore reported as
// E_GONE after <= ~100 ms, not after the whole timeout.

profile kernel

import ulib
import actwire

export {
    E_OK, E_BADREQ, E_NOMETHOD, E_BUSY, E_DENIED, E_FAILED, E_TOOBIG,
    E_TIMEOUT, E_NOSVC, E_SEND, E_GONE, E_NOSLOT, E_PROTO, E_PENDING,
    E_BADID, E_NOBOX,
    NONE_ID,
    client_open, call, call_async, last_error, state_of, take, cancel, pump,
    last_len,
    serve_open, serve_next, req_buf, req_len, req_over, req_pid, req_uid,
    req_id, reply, fail, stat, stat_reset
}

// status codes. 1..99: the server side, 100+: the client side.
const E_OK: u64 = 0
const E_BADREQ: u64 = 1 // the request could not be understood
const E_NOMETHOD: u64 = 2 // the service does not know this verb
const E_BUSY: u64 = 3
const E_DENIED: u64 = 4 // the service refuses this caller
const E_TOOBIG: u64 = 5 // request or reply over the limits
const E_FAILED: u64 = 7 // first free code for a service's own errors
const E_TIMEOUT: u64 = 100 // no reply in time
const E_NOSVC: u64 = 101 // no such service
const E_SEND: u64 = 102 // the bus refused the request
const E_GONE: u64 = 103 // the service vanished while we waited
const E_NOSLOT: u64 = 104 // 8 calls are already in flight
const E_PROTO: u64 = 105 // a reply that makes no sense
const E_PENDING: u64 = 106 // take() before the reply (not an error)
const E_BADID: u64 = 107 // take()/cancel() of an id we do not know
const E_NOBOX: u64 = 108 // no reply box (bus off, or name taken)

const NONE_ID: u64 = 0

const NONE: u64 = 0xFFFFFFFF
const DEFAULT_MS: u64 = 5000
const SLICE_MS: u64 = 100

// ------------------------------------------------------------ counters
// 0 calls sent, 1 replies taken, 2 timeouts, 3 late/unknown replies
// dropped, 4 service gone, 5 requests served, 6 replies sent,
// 7 reply box gone (client died), 8 protocol errors
static mut cnt: [u64; 9] = [0 as u64; 9]

fn bump(i: u64) {
    cnt[i as usize] = cnt[i as usize] + 1
}

fn stat(i: u64) -> u64 {
    if i >= 9 {
        return 0
    }
    return cnt[i as usize]
}

fn stat_reset() {
    var i: u64 = 0
    while i < 9 {
        cnt[i as usize] = 0
        i = i + 1
    }
}

// ---------------------------------------------------- pending calls
// One entry = 10 words: state, id, deadline, pid, len, code, over,
// name (3 words = 24 octets).
const NPEND: u64 = 8
const PE: u64 = 80
const P_STATE: u64 = 0 // 0 free, 1 waiting, 2 done, 3 failed locally
const P_ID: u64 = 8
const P_DEAD: u64 = 16
const P_PID: u64 = 24
const P_LEN: u64 = 32
const P_CODE: u64 = 40
const P_OVER: u64 = 48
const P_NAME: u64 = 56
const PBUF: u64 = 4096
const PBODY: u64 = 4095

static mut pend: [u8; 640] = [0 as u8; 640]
static mut pbuf: [u8; 32768] = [0 as u8; 32768]
static mut box_open: bool = false
static mut err_last: u64 = 0
static mut body_len: u64 = 0

fn pe(i: u64) -> u64 {
    return ((&pend[0 as usize]) as u64) + i * PE
}

fn pb(i: u64) -> u64 {
    return ((&pbuf[0 as usize]) as u64) + i * PBUF
}

fn ticks_of(ms: u64) -> u64 {
    return (ms + 9) / 10
}

// The index of the live entry with this id, or NONE.
fn find_id(id: u64) -> u64 {
    var i: u64 = 0
    while i < NPEND {
        if actwire.ld64(pe(i), P_STATE) != 0 && actwire.ld64(pe(i), P_ID) == id {
            return i
        }
        i = i + 1
    }
    return NONE
}

fn count_waiting() -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < NPEND {
        if actwire.ld64(pe(i), P_STATE) == 1 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Open the reply box r.<pid> once. False: the bus is off or the name is
// taken by somebody else.
fn client_open() -> bool {
    if box_open {
        return true
    }
    var pre: [u8; 3] = "r.\0"
    var nm: [u8; 24] = [0 as u8; 24]
    let np: u64 = (&nm[0 as usize]) as u64
    actwire.name_of((&pre[0 as usize]) as u64,
        ulib.sys(ulib.SYS_GETPID, 0, 0, 0), np)
    if ulib.bad(actwire.bus_reg(np, actwire.A_SAMEUID)) {
        return false
    }
    box_open = true
    return true
}

// Send a request and return at once. Returns the id (never 0), or 0 and
// the reason in last_error() (an E_* code).
// timeout_ms 0 = 5 s. `svc` is the service name (zero-terminated).
fn call_async(svc: u64, req: u64, len: u64, timeout_ms: u64) -> u64 {
    if !client_open() {
        err_last = E_NOBOX
        return 0
    }
    let s: u64 = actwire.bus_find(svc)
    if ulib.bad(s) {
        err_last = E_NOSVC
        return 0
    }
    var slot: u64 = NONE
    var i: u64 = 0
    while i < NPEND {
        if actwire.ld64(pe(i), P_STATE) == 0 && slot == NONE {
            slot = i
        }
        i = i + 1
    }
    if slot == NONE {
        err_last = E_NOSLOT
        return 0
    }
    var id: u64 = actwire.rnd() & 0xFFFFFFFF
    while id == 0 || find_id(id) != NONE {
        id = actwire.rnd() & 0xFFFFFFFF
    }
    var ms: u64 = timeout_ms
    if ms == 0 {
        ms = DEFAULT_MS
    }
    let e: u64 = pe(slot)
    actwire.st64(e, P_STATE, 1)
    actwire.st64(e, P_ID, id)
    actwire.st64(e, P_DEAD, actwire.ticks() + ticks_of(ms))
    actwire.st64(e, P_PID, NONE)
    actwire.st64(e, P_LEN, 0)
    actwire.st64(e, P_CODE, 0)
    actwire.st64(e, P_OVER, 0)
    var k: u64 = 0
    while k < 23 && actwire.ld8(svc, k) != 0 {
        actwire.st8(e + P_NAME, k, actwire.ld8(svc, k))
        k = k + 1
    }
    actwire.st8(e + P_NAME, k, 0)
    let r: u64 = actwire.send_msg(s, actwire.K_REQ, id, req, len)
    if ulib.bad(r) {
        actwire.st64(e, P_STATE, 0)
        if r == 0xFFFFFFFFFFFFFFFD {
            err_last = E_DENIED
        } else {
            err_last = E_SEND
        }
        return 0
    }
    bump(0)
    return id
}

// Why the last call_async returned 0.
fn last_error() -> u64 {
    return err_last
}

// ------------------------------------------------------------ pump
// Everything that arrives is handled here, for client AND server use:
// a reply goes to its pending entry, a request is queued for
// serve_next, anything else is dropped.

const SQ: u64 = 8
static mut sq: [u64; 8] = [0 as u64; 8]
static mut sq_n: u64 = 0

fn sq_push(s: u64) {
    if sq_n < SQ {
        sq[sq_n as usize] = s
        sq_n = sq_n + 1
    } else {
        actwire.asm_free(s) // more requests than queue places: dropped
    }
}

fn feed_reply(fp: u64, mp: u64) {
    let id: u64 = actwire.ld32(fp, 4)
    let flags: u64 = actwire.ld8(fp, 2)
    let n: u64 = actwire.ld8(fp, 3)
    let pid: u64 = actwire.ld64(mp, 0)
    if n > actwire.FR_PAY {
        bump(8)
        return
    }
    let i: u64 = find_id(id)
    if i == NONE {
        bump(3) // late (after a timeout/cancel) or never ours
        return
    }
    let e: u64 = pe(i)
    if actwire.ld64(e, P_STATE) != 1 {
        bump(3)
        return
    }
    if (flags & 1) != 0 {
        actwire.st64(e, P_PID, pid)
        actwire.st64(e, P_LEN, 0)
        actwire.st64(e, P_OVER, 0)
    } else if actwire.ld64(e, P_PID) != pid {
        bump(8) // a middle frame from somebody else: ignored
        return
    }
    if actwire.ld64(e, P_PID) == NONE {
        bump(8) // a middle frame without a beginning
        return
    }
    var len: u64 = actwire.ld64(e, P_LEN)
    let b: u64 = pb(i)
    var k: u64 = 0
    while k < n {
        if len < PBUF - 1 {
            actwire.st8(b, len, actwire.ld8(fp, 8 + k))
            len = len + 1
        } else {
            actwire.st64(e, P_OVER, 1)
        }
        k = k + 1
    }
    actwire.st64(e, P_LEN, len)
    if (flags & 2) != 0 {
        if len == 0 {
            actwire.st64(e, P_CODE, E_PROTO)
            actwire.st64(e, P_STATE, 3)
            bump(8)
        } else if actwire.ld64(e, P_OVER) != 0 {
            actwire.st64(e, P_CODE, E_TOOBIG)
            actwire.st64(e, P_STATE, 3)
        } else {
            actwire.st64(e, P_CODE, actwire.ld8(b, 0))
            actwire.st64(e, P_STATE, 2)
        }
    }
}

fn expire() {
    let t: u64 = actwire.ticks()
    var i: u64 = 0
    while i < NPEND {
        let e: u64 = pe(i)
        if actwire.ld64(e, P_STATE) == 1 && t >= actwire.ld64(e, P_DEAD) {
            actwire.st64(e, P_CODE, E_TIMEOUT)
            actwire.st64(e, P_STATE, 3)
            bump(2)
        }
        i = i + 1
    }
}

// Called when a slice passed with nothing to read: has a service we wait
// for disappeared?
fn check_gone() {
    var i: u64 = 0
    while i < NPEND {
        let e: u64 = pe(i)
        if actwire.ld64(e, P_STATE) == 1 {
            if ulib.bad(actwire.bus_find(e + P_NAME)) {
                actwire.st64(e, P_CODE, E_GONE)
                actwire.st64(e, P_STATE, 3)
                bump(4)
            }
        }
        i = i + 1
    }
}

// Wait up to `ms` for ONE frame and handle it. 1: a frame was handled,
// 0: nothing came.
fn pump(ms: u64) -> u64 {
    var fr: [u8; 64] = [0 as u8; 64]
    var meta: [u64; 6] = [0 as u64; 6]
    let fp: u64 = (&fr[0 as usize]) as u64
    let mp: u64 = (&meta[0 as usize]) as u64
    let n: u64 = actwire.bus_wait(fp, mp, ms)
    if ulib.bad(n) || n == 0 {
        check_gone()
        expire()
        return 0
    }
    if actwire.ld8(fp, 0) == 0xA7 {
        let kind: u64 = actwire.ld8(fp, 1)
        if kind == actwire.K_REP {
            feed_reply(fp, mp)
        } else {
            let s: u64 = actwire.asm_feed(fp, mp)
            if s != actwire.NONE {
                if kind == actwire.K_REQ {
                    sq_push(s)
                } else {
                    actwire.asm_free(s) // events are not ours
                }
            }
        }
    }
    expire()
    return 1
}

// 0 free/unknown, 1 waiting, 2 answered (ok or a status from the server),
// 3 failed locally (timeout, gone, ...).
fn state_of(id: u64) -> u64 {
    let i: u64 = find_id(id)
    if i == NONE {
        return 0
    }
    return actwire.ld64(pe(i), P_STATE)
}

// The octets of the data part of the last take() (without status octet).
fn last_len() -> u64 {
    return body_len
}

// Collect the result of `id`: the status code (E_OK, a server code, or an
// E_* of the client side); the data (zero-terminated) goes to `out`,
// at most `max-1` octets, its length to last_len(). E_PENDING: not yet,
// the entry stays.
fn take(id: u64, out: u64, max: u64) -> u64 {
    body_len = 0
    let i: u64 = find_id(id)
    if i == NONE {
        return E_BADID
    }
    let e: u64 = pe(i)
    let st: u64 = actwire.ld64(e, P_STATE)
    if st == 1 {
        return E_PENDING
    }
    let code: u64 = actwire.ld64(e, P_CODE)
    if st == 2 {
        let total: u64 = actwire.ld64(e, P_LEN)
        var n: u64 = total - 1
        if n > max - 1 {
            n = max - 1
        }
        var k: u64 = 0
        while k < n {
            actwire.st8(out, k, actwire.ld8(pb(i), 1 + k))
            k = k + 1
        }
        actwire.st8(out, n, 0)
        body_len = n
        bump(1)
    } else if max > 0 {
        actwire.st8(out, 0, 0)
    }
    actwire.st64(e, P_STATE, 0)
    return code
}

// Give up on a call: the entry is freed, a later reply counts as late.
fn cancel(id: u64) -> u64 {
    let i: u64 = find_id(id)
    if i == NONE {
        return E_BADID
    }
    actwire.st64(pe(i), P_STATE, 0)
    return E_OK
}

// Synchronous call. Returns the status like take(); on E_NOSVC/E_SEND/...
// the cause of call_async. `out` gets the data (zero-terminated).
fn call(svc: u64, req: u64, len: u64, out: u64, max: u64,
    timeout_ms: u64) -> u64 {
    body_len = 0
    if max > 0 {
        actwire.st8(out, 0, 0)
    }
    let id: u64 = call_async(svc, req, len, timeout_ms)
    if id == 0 {
        return err_last
    }
    while state_of(id) == 1 {
        pump(SLICE_MS)
    }
    return take(id, out, max)
}

// ---------------------------------------------------------- server

static mut rbuf: [u8; 4160] = [0 as u8; 4160]

// Register the service. access: actwire.A_ANY / A_SAMEUID / A_ROOT.
fn serve_open(name: u64, access: u64) -> bool {
    return !ulib.bad(actwire.bus_reg(name, access))
}

// The next complete request, as a slot number for the req_* readers and
// reply/fail; NONE after `ms` without one (ms >= 0x80000000: wait).
fn serve_next(ms: u64) -> u64 {
    let forever: bool = ms >= 0x80000000
    let t_end: u64 = actwire.ticks() + ticks_of(ms)
    while sq_n == 0 {
        if !forever && actwire.ticks() >= t_end {
            return NONE
        }
        var w: u64 = SLICE_MS
        if !forever {
            let left: u64 = (t_end - actwire.ticks()) * 10
            if left < w {
                w = left
            }
        }
        if w == 0 {
            w = 1
        }
        pump(w)
    }
    let s: u64 = sq[0]
    var i: u64 = 1
    while i < sq_n {
        sq[(i - 1) as usize] = sq[i as usize]
        i = i + 1
    }
    sq_n = sq_n - 1
    return s
}

fn req_buf(s: u64) -> u64 {
    return actwire.asm_buf(s)
}

fn req_len(s: u64) -> u64 {
    return actwire.asm_len(s)
}

// True: the request was longer than 2047 octets and is cut.
fn req_over(s: u64) -> bool {
    return actwire.asm_over(s)
}

fn req_pid(s: u64) -> u64 {
    return actwire.asm_pid(s)
}

fn req_uid(s: u64) -> u64 {
    return actwire.asm_uid(s)
}

fn req_id(s: u64) -> u64 {
    return actwire.asm_id(s)
}

// Send status + data to the asker and free the slot. Oversize data is
// turned into an honest E_TOOBIG reply. Returns 0, or E_GONE if the
// asker's reply box is gone (it died or gave up).
fn respond(s: u64, code: u64, data: u64, len: u64) -> u64 {
    let pid: u64 = actwire.asm_pid(s)
    let id: u64 = actwire.asm_id(s)
    actwire.asm_free(s)
    bump(5)
    var c: u64 = code
    var n: u64 = len
    if n > PBODY - 1 {
        c = E_TOOBIG
        n = 0
    }
    let rp: u64 = (&rbuf[0 as usize]) as u64
    actwire.st8(rp, 0, c)
    var k: u64 = 0
    while k < n {
        actwire.st8(rp, 1 + k, actwire.ld8(data, k))
        k = k + 1
    }
    var pre: [u8; 3] = "r.\0"
    var nm: [u8; 24] = [0 as u8; 24]
    let np: u64 = (&nm[0 as usize]) as u64
    actwire.name_of((&pre[0 as usize]) as u64, pid, np)
    let box: u64 = actwire.bus_find(np)
    if ulib.bad(box) {
        bump(7)
        return E_GONE
    }
    if ulib.bad(actwire.send_msg(box, actwire.K_REP, id, rp, n + 1)) {
        bump(7)
        return E_SEND
    }
    bump(6)
    return E_OK
}

fn reply(s: u64, data: u64, len: u64) -> u64 {
    return respond(s, E_OK, data, len)
}

// An error answer; `data` may carry a short text (or len 0).
fn fail(s: u64, code: u64, data: u64, len: u64) -> u64 {
    var c: u64 = code
    if c == 0 || c >= E_TIMEOUT {
        c = E_FAILED
    }
    return respond(s, c, data, len)
}
