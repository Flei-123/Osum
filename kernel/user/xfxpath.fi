profile kernel

import ulib
import libc.text

export { select_app, selected, p_part, part_prefix_len, p_tar, p_man, p_js, p_mark, p_fx, p_log, p_state, p_pidw, p_pidf, p_wayd, p_tarbin, p_root, p_run, n_wayd, n_fx, p_ota, p_srcman, p_srcjs }

static mut P_TAR: [u8; 27] = "/usr/share/xfx/firefox.tar\0"
static mut P_MAN: [u8; 32] = "/usr/share/xfx/firefox.manifest\0"
static mut P_JS: [u8; 23] = "/usr/share/xfx/user.js\0"
static mut P_MARK: [u8; 25] = "/usr/share/xfx/installed\0"
static mut P_FX: [u8; 25] = "/usr/lib/firefox/firefox\0"
static mut P_LOG: [u8; 17] = "/var/log/xfx.log\0"
static mut P_STATE: [u8; 17] = "/run/xfx.install\0"
static mut P_PIDW: [u8; 14] = "/run/xfx.wayd\0"
static mut P_PIDF: [u8; 17] = "/run/xfx.firefox\0"
static mut P_WAYD: [u8; 10] = "/bin/wayd\0"
static mut P_TARBIN: [u8; 9] = "/bin/tar\0"
static mut P_ROOT: [u8; 2] = "/\0"
static mut P_RUN: [u8; 10] = "/run/xfx-\0"
static mut P_OTA: [u8; 9] = "/bin/ota\0"
static mut P_SRCMAN: [u8; 31] = "/apps/firefox.osp/xfx.manifest\0"
static mut P_SRCJS: [u8; 26] = "/apps/firefox.osp/user.js\0"

const LX_BASE_MAX: u64 = 48
const LX_CHECK_MAX: u64 = 96
const PROC_NAME_MAX: u64 = 8
static mut SELECTED: bool = false
static mut PREFIX_LEN: u64 = 15
static mut D_TAR: [u8; 96] = [0 as u8; 96]
static mut D_PART: [u8; 96] = [0 as u8; 96]
static mut D_MAN: [u8; 96] = [0 as u8; 96]
static mut D_MARK: [u8; 96] = [0 as u8; 96]
static mut D_STATE: [u8; 96] = [0 as u8; 96]
static mut D_PIDW: [u8; 96] = [0 as u8; 96]
static mut D_PIDF: [u8; 96] = [0 as u8; 96]
static mut D_LOG: [u8; 96] = [0 as u8; 96]
static mut D_SRCMAN: [u8; 96] = [0 as u8; 96]
static mut D_FX: [u8; 96] = [0 as u8; 96]
static mut D_NAME: [u8; 16] = [0 as u8; 16]
static mut S_LXDIR: [u8; 15] = "/usr/share/lx/\0"
static mut S_RUN: [u8; 9] = "/run/lx-\0"
static mut S_LOGDIR: [u8; 13] = "/var/log/lx-\0"
static mut S_APPS: [u8; 7] = "/apps/\0"
static mut S_OSP: [u8; 6] = ".osp/\0"
static mut S_TAR: [u8; 5] = ".tar\0"
static mut S_PART: [u8; 10] = ".tar.part\0"
static mut S_MAN: [u8; 10] = ".manifest\0"
static mut S_MARK: [u8; 11] = ".installed\0"
static mut S_INST: [u8; 9] = ".install\0"
static mut S_WAYD: [u8; 6] = ".wayd\0"
static mut S_APP: [u8; 5] = ".app\0"
static mut S_LOG: [u8; 5] = ".log\0"
static mut S_SRCMAN: [u8; 12] = "lx.manifest\0"

fn build(out: u64, head: u64, name: u64, tail: u64) {
    ulib.strcpy(out, head)
    ulib.strcat(out, name)
    ulib.strcat(out, tail)
}

fn select_app(name: u64, check_path: u64, proc_name: u64) -> bool {
    if text.length(name) == 0 || text.length(name) > LX_BASE_MAX || text.length(check_path) == 0 || text.length(check_path) >= LX_CHECK_MAX || text.length(proc_name) == 0 {
        return false
    }
    build((&D_TAR[0 as usize]) as u64, (&S_LXDIR[0 as usize]) as u64, name, (&S_TAR[0 as usize]) as u64)
    build((&D_PART[0 as usize]) as u64, (&S_LXDIR[0 as usize]) as u64, name, (&S_PART[0 as usize]) as u64)
    build((&D_MAN[0 as usize]) as u64, (&S_LXDIR[0 as usize]) as u64, name, (&S_MAN[0 as usize]) as u64)
    build((&D_MARK[0 as usize]) as u64, (&S_LXDIR[0 as usize]) as u64, name, (&S_MARK[0 as usize]) as u64)
    build((&D_STATE[0 as usize]) as u64, (&S_RUN[0 as usize]) as u64, name, (&S_INST[0 as usize]) as u64)
    build((&D_PIDW[0 as usize]) as u64, (&S_RUN[0 as usize]) as u64, name, (&S_WAYD[0 as usize]) as u64)
    build((&D_PIDF[0 as usize]) as u64, (&S_RUN[0 as usize]) as u64, name, (&S_APP[0 as usize]) as u64)
    build((&D_LOG[0 as usize]) as u64, (&S_LOGDIR[0 as usize]) as u64, name, (&S_LOG[0 as usize]) as u64)
    build((&D_SRCMAN[0 as usize]) as u64, (&S_APPS[0 as usize]) as u64, name, (&S_OSP[0 as usize]) as u64)
    ulib.strcat((&D_SRCMAN[0 as usize]) as u64, (&S_SRCMAN[0 as usize]) as u64)
    ulib.strcpy((&D_FX[0 as usize]) as u64, check_path)
    ulib.strncpy((&D_NAME[0 as usize]) as u64, proc_name, PROC_NAME_MAX + 1)
    D_NAME[PROC_NAME_MAX as usize] = 0 as u8
    PREFIX_LEN = text.length((&S_LXDIR[0 as usize]) as u64)
    SELECTED = true
    return true
}

fn selected() -> bool {
    return SELECTED
}

fn part_prefix_len() -> u64 {
    return PREFIX_LEN
}

fn p_part() -> u64 {
    if SELECTED {
        return (&D_PART[0 as usize]) as u64
    }
    return (&P_PART[0 as usize]) as u64
}
static mut P_PART: [u8; 32] = "/usr/share/xfx/firefox.tar.part\0"
static mut N_WAYD: [u8; 5] = "wayd\0"
static mut N_FX: [u8; 8] = "firefox\0"

fn p_tar() -> u64 {
    if SELECTED {
        return (&D_TAR[0 as usize]) as u64
    }
    return (&P_TAR[0 as usize]) as u64
}

fn p_man() -> u64 {
    if SELECTED {
        return (&D_MAN[0 as usize]) as u64
    }
    return (&P_MAN[0 as usize]) as u64
}

fn p_js() -> u64 {
    return (&P_JS[0 as usize]) as u64
}

fn p_mark() -> u64 {
    if SELECTED {
        return (&D_MARK[0 as usize]) as u64
    }
    return (&P_MARK[0 as usize]) as u64
}

fn p_fx() -> u64 {
    if SELECTED {
        return (&D_FX[0 as usize]) as u64
    }
    return (&P_FX[0 as usize]) as u64
}

fn p_log() -> u64 {
    if SELECTED {
        return (&D_LOG[0 as usize]) as u64
    }
    return (&P_LOG[0 as usize]) as u64
}

fn p_state() -> u64 {
    if SELECTED {
        return (&D_STATE[0 as usize]) as u64
    }
    return (&P_STATE[0 as usize]) as u64
}

fn p_pidw() -> u64 {
    if SELECTED {
        return (&D_PIDW[0 as usize]) as u64
    }
    return (&P_PIDW[0 as usize]) as u64
}

fn p_pidf() -> u64 {
    if SELECTED {
        return (&D_PIDF[0 as usize]) as u64
    }
    return (&P_PIDF[0 as usize]) as u64
}

fn p_wayd() -> u64 {
    return (&P_WAYD[0 as usize]) as u64
}

fn p_tarbin() -> u64 {
    return (&P_TARBIN[0 as usize]) as u64
}

fn p_root() -> u64 {
    return (&P_ROOT[0 as usize]) as u64
}

fn p_run() -> u64 {
    return (&P_RUN[0 as usize]) as u64
}

fn n_wayd() -> u64 {
    return (&N_WAYD[0 as usize]) as u64
}

fn n_fx() -> u64 {
    if SELECTED {
        return (&D_NAME[0 as usize]) as u64
    }
    return (&N_FX[0 as usize]) as u64
}

fn p_ota() -> u64 {
    return (&P_OTA[0 as usize]) as u64
}

fn p_srcman() -> u64 {
    if SELECTED {
        return (&D_SRCMAN[0 as usize]) as u64
    }
    return (&P_SRCMAN[0 as usize]) as u64
}

fn p_srcjs() -> u64 {
    return (&P_SRCJS[0 as usize]) as u64
}
