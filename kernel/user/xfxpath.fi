profile kernel

export { p_tar, p_man, p_js, p_mark, p_fx, p_log, p_state, p_pidw, p_pidf, p_wayd, p_tarbin, p_root, p_run, n_wayd, n_fx }

static mut P_TAR: [u8; 27] = "/usr/share/xfx/firefox.tar\0"
static mut P_MAN: [u8; 32] = "/usr/share/xfx/firefox.manifest\0"
static mut P_JS: [u8; 23] = "/usr/share/xfx/user.js\0"
static mut P_MARK: [u8; 25] = "/usr/share/xfx/installed\0"
static mut P_FX: [u8; 25] = "/usr/lib/firefox/firefox\0"
static mut P_LOG: [u8; 17] = "/var/log/xfx.log\0"
static mut P_STATE: [u8; 17] = "/run/xfx.install\0"
static mut P_PIDW: [u8; 14] = "/run/xfx.wayd\0"
static mut P_PIDF: [u8; 17] = "/run/xfx.firefox\0"
static mut P_WAYD: [u8; 10] = "/bin/wayd\0"
static mut P_TARBIN: [u8; 9] = "/bin/tar\0"
static mut P_ROOT: [u8; 2] = "/\0"
static mut P_RUN: [u8; 10] = "/run/xfx-\0"
static mut N_WAYD: [u8; 5] = "wayd\0"
static mut N_FX: [u8; 8] = "firefox\0"

fn p_tar() -> u64 {
    return (&P_TAR[0 as usize]) as u64
}

fn p_man() -> u64 {
    return (&P_MAN[0 as usize]) as u64
}

fn p_js() -> u64 {
    return (&P_JS[0 as usize]) as u64
}

