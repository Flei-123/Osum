    return (&P_MARK[0 as usize]) as u64
}

fn p_fx() -> u64 {
    return (&P_FX[0 as usize]) as u64
}

fn p_log() -> u64 {
    return (&P_LOG[0 as usize]) as u64
}

fn p_state() -> u64 {
    return (&P_STATE[0 as usize]) as u64
}

fn p_pidw() -> u64 {
    return (&P_PIDW[0 as usize]) as u64
}

fn p_pidf() -> u64 {
    return (&P_PIDF[0 as usize]) as u64
}

fn p_wayd() -> u64 {
    return (&P_WAYD[0 as usize]) as u64
}

fn p_tarbin() -> u64 {
    return (&P_TARBIN[0 as usize]) as u64
}

fn p_root() -> u64 {
    return (&P_ROOT[0 as usize]) as u64
}

