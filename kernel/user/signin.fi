// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/signin.fi -- r383: ONE LOOK FOR THE LOCK SCREEN AND THE
// SIGN-IN SCREEN, the layout of the Windows 11 sign-in
// (assets/ref/win11-login-ref.png):
//
//   - the wallpaper behind everything (fuiapp.backdrop_load: /etc/wallpaper,
//     blurred and shaded; a dark gradient when there is no file),
//   - in the middle: a round avatar (the initial of the user), the name, one
//     status line, the password field with the eye and the round arrow,
//   - bottom left: the user(s), bottom right: language, network, power.
//
// This file holds what both screens paint the same way. What differs (the
// tree, the keys, the logic) stays in lock.fi and glogin.fi. Every size is a
// design point in the 4-pixel grid and goes through `fuiscene.sp`.
profile app

import ulib
import wlibc
import fuiapp
import fuiscene
import icons
import wlib
import backdrop
import fui.theme

export {
    AV_D, GAP_N, COL_W, FIELD_H, WHITE, SOFT, AVATAR_RGB,
    big_c, circle, initial_of, paint_avatar, paint_name, paint_status,
    paint_hint, paint_chip, paint_deu, paint_net, glyph_tile, net_glyph, glass_plate, glass_glyph,
    SYS_NETGET, NG_STATE,
    lay_mul, lay_space, lay_set_size, lay_canvas, lay_entry, lay_tile, lay_glass_tile, lay_btn,
    glass_on, glass_install, glass_panel, glass_ink,
}

const AV_D: u64 = 112
const GAP_N: u64 = 12
const COL_W: u64 = 320
const FIELD_H: u64 = 36
const WHITE: u64 = 0xFFFFFF
const SOFT: u64 = 0xDCE6F5
const AVATAR_RGB: u64 = 0x4C6A92
const SYS_NETGET: u64 = 1300
const NG_STATE: u64 = 8

static mut T_DEU: [u8; 4] = "DEU\0"

// Text centred in the box (x, y, w, h), `size` pixels high, colour 0xRRGGBB.
fn big_c(x: u64, y: u64, w: u64, h: u64, p: u64, size: u64, bold: bool, rgb: u64) {
    var f: u64 = wlibc.F_UI
    if bold {
        f = wlibc.F_BOLD
    }
    let n: u64 = ulib.length(p)
    let tw: u64 = wlibc.text_w(f, size, p, n)
    var off: u64 = 0
    if tw < w {
        off = (w - tw) / 2
    }
    fuiscene.cv_text_rgb(x + off, y + (h + size) / 2 - size / 5, w, p, size, bold, rgb)
}

fn circle(x: u64, y: u64, d: u64, rgb: u64) {
    fuiscene.cv_round_rgb(x, y, d, d, d / 2, rgb)
}

// The first letter of a name, upper case, as a zero-ended string in `out`.
fn initial_of(namep: u64, out: u64) {
    var c: u64 = __mmio_read8(namep as *mut u8) as u64
    if c >= 97 && c <= 122 {
        c = c - 32
    }
    if c == 0 {
        c = 63
    }
    __mmio_write8(out as *mut u8, c as u8)
    __mmio_write8((out + 1) as *mut u8, 0 as u8)
}

fn paint_avatar(x: u64, y: u64, w: u64, h: u64, ini: u64) {
    let d: u64 = fuiscene.sp(AV_D)
    let x0: u64 = x + (w - d) / 2
    circle(x0, y, d, AVATAR_RGB)
    fuiscene.cv_ring_rgb(x0, y, d, d, d / 2, 2, SOFT)
    big_c(x0, y, d, d, ini, d * 2 / 5, true, WHITE)
}

fn paint_name(x: u64, y: u64, w: u64, h: u64, namep: u64) {
    big_c(x, y, w, h, namep, fuiscene.sp(24), true, WHITE)
}

fn paint_status(x: u64, y: u64, w: u64, h: u64, textp: u64) {
    big_c(x, y, w, h, textp, fuiscene.sp(16), false, WHITE)
}

fn paint_hint(x: u64, y: u64, w: u64, h: u64, textp: u64) {
    big_c(x, y, w, h, textp, fuiscene.sp(12), false, SOFT)
}

// Bottom left: a small avatar and the name next to it.
// COUNTER-PROOF SWITCH of the layout test (tools/lockflicker): the file /etc/lockold makes `lay_mul` the interface scale, so the
// lock/login scenes hand over sizes that the scene multiplies a second time -- the old double scaling (measured 11.10.2026). Without
// the file the factor is 1 and the wrappers below are plain calls. Only the test creates the file.
static mut L_OLD_PATH: [u8; 13] = "/etc/lockold\0"
static mut L_MUL: u64 = 0

fn lay_mul() -> u64 {
    if L_MUL == 0 {
        L_MUL = 1
        let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&L_OLD_PATH[(0) as usize]) as u64, 0, 0)
        if !ulib.bad(fd) {
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
            L_MUL = fuiscene.sp(1)
        }
    }
    return L_MUL
}

fn lay_space(parent: usize, w: u64, h: u64) -> usize {
    return fuiscene.space(parent, w * lay_mul(), h * lay_mul())
}

fn lay_set_size(i: usize, w: u64, h: u64) {
    fuiscene.set_size(i, w * lay_mul(), h * lay_mul())
}

fn lay_canvas(parent: usize, key: u64, w: u64, h: u64, draw: fn(u64, u64, u64, u64)) -> usize {
    return fuiscene.canvas(parent, key, w * lay_mul(), h * lay_mul(), draw)
}

fn lay_entry(parent: usize, key: u64, w: u64, text: u64) -> usize {
    return fuiscene.entry(parent, key, w * lay_mul(), text)
}

fn lay_tile(parent: usize, key: u64, name: u64, w: u64, h: u64, on: bool, ud: u64,
    cb: fn(u64, u64, u64, u64, u64, u64)) -> usize {
    return fuiscene.tile(parent, key, name, w * lay_mul(), h * lay_mul(), on, ud, cb)
}

fn lay_glass_tile(parent: usize, key: u64, name: u64, w: u64, h: u64, on: bool, ud: u64,
    cb: fn(u64, u64, u64, u64, u64, u64)) -> usize {
    return fuiscene.glass_tile(parent, key, name, w * lay_mul(), h * lay_mul(), on, ud, cb)
}

fn paint_chip(x: u64, y: u64, w: u64, h: u64, ini: u64, namep: u64) {
    let d: u64 = fuiscene.sp(36)
    circle(x, y + (h - d) / 2, d, AVATAR_RGB)
    big_c(x, y + (h - d) / 2, d, d, ini, d * 2 / 5, true, WHITE)
    fuiscene.cv_text_rgb(x + d + fuiscene.sp(12), y + (h + fuiscene.sp(14)) / 2 - fuiscene.sp(3),
        w - d - fuiscene.sp(12), namep, fuiscene.sp(14), false, WHITE)
}

fn paint_deu(x: u64, y: u64, w: u64, h: u64) {
    big_c(x, y, w, h, (&T_DEU[(0) as usize]) as u64, fuiscene.sp(12), false, WHITE)
}

// The icon for the kernel's four network states.
fn net_glyph(st: u64) -> u64 {
    if st == 3 {
        return icons.NETWORK_WIRED
    }
    if st == 2 {
        return icons.NETWORK_NO_INTERNET
    }
    if st == 1 {
        return icons.NETWORK_BLOCKED
    }
    return icons.NETWORK_OFFLINE
}

fn paint_net(x: u64, y: u64, w: u64, h: u64, st: u64) {
    glyph_tile(net_glyph(st), x, y, w, h, 0xFFFFFFFF)
}

// An icon of the icon font, centred in a box, 20 points high.
fn glyph_tile(cp: u64, x: u64, y: u64, w: u64, h: u64, col: u64) {
    let s: u64 = fuiscene.sp(20)
    fuiapp.glyph(cp, x + (w - s) / 2, y + (h - s) / 2, s, col as u32)
}

// MILK GLASS (Justin, Dell photo 07.10.2026: the language/network/power
// buttons had a pale solid box). A translucent white plate over the blurred
// wallpaper, a thin lighter rim, white glyph; hover and press make it
// stronger, the keyboard focus gets the halo. `st` bits as fuiscene.tile.
const GLASS_A: u64 = 52
const GLASS_A_HOT: u64 = 72
const GLASS_A_DOWN: u64 = 104

fn glass_plate(x: u64, y: u64, w: u64, h: u64, st: u64, lit: bool) {
    var a: u64 = GLASS_A
    if lit {
        a = GLASS_A_HOT
    }
    if st & 2 != 0 {
        a = GLASS_A_HOT
    }
    if st & 4 != 0 {
        a = GLASS_A_DOWN
    }
    let r: u64 = fuiscene.sp(8)
    if glass_on() {
        // a blurred slab of the wallpaper under the white plate (cached per background)
        let _s: bool = backdrop.glass_slab(x, y, w, h, r, fuiscene.sp(10))
    }
    fuiscene.cv_round_a(x, y, w, h, r, WHITE, a)
    fuiscene.cv_ring_a(x, y, w, h, r, 1, WHITE, 90)
    if st & 8 != 0 {
        fuiapp.halo_in(x, y, w, h)
    }
}

// ============================================================ W-GLASS: FROSTED PLATES
// Justin: "auch im Sperrbildschirm das Textfeld bitte so milchglas". One plate for the password and name
// fields, the eye, the arrow, "Anderer Benutzer" and the info/power cards of both screens:
//   soft shadow -> blurred slab of the wallpaper (backdrop.glass_slab, cached) -> translucent tint -> 1 px
//   light rim and a fine highlight on the top edge; keyboard focus = the accent ring of fUi on top.
// Light theme: milk (white 66 %) with dark ink. Dark theme: smoked glass (dark slate 46 % + a little white)
// with light ink. `/etc/noglass` (control run) brings the flat plates back; without the slab (no memory,
// too wide) the same plate is painted a little more opaque.
fn glass_on() -> bool {
    return !wlib.noglass()
}

fn glass_dark() -> bool {
    return (*theme.theme_colors(fuiapp.theme())).dark
}

// The ink of text on a plate (0xRRGGBB as `cv_text_rgb` takes it).
fn glass_ink() -> u64 {
    if glass_dark() {
        return 0xF2F6FC
    }
    return 0x1B2430
}

// kind 0 = ordinary plate (theme tint), 1 = accent plate (the sign-in arrow).
fn glass_panel(x: u64, y: u64, w: u64, h: u64, st: u64, kind: u64) {
    let r: u64 = fuiscene.sp(8)
    var g: u64 = 6
    while g > 0 {
        fuiscene.cv_round_a(x - g, y - g + 3, w + 2 * g, h + 2 * g, r + g, 0x000000, 13)
        g = g - 1
    }
    let ok: bool = backdrop.glass_slab(x, y, w, h, r, fuiscene.sp(10))
    let dark: bool = glass_dark()
    var a: u64 = 168
    var rim: u64 = 230
    if dark {
        a = 118
        rim = 104
    }
    if !ok {
        a = a + 40
        if a > 250 {
            a = 250
        }
    }
    if st & 2 != 0 {
        a = a + 18
    }
    if st & 4 != 0 {
        a = a + 36
    }
    if a > 250 {
        a = 250
    }
    if kind == 1 {
        let ac: u32 = (*theme.theme_colors(fuiapp.theme())).accent & (0x00FFFFFF as u32)
        var aa: u64 = 208
        if st & 2 != 0 {
            aa = 232
        }
        fuiscene.cv_round_raw(x, y, w, h, r, ac | ((aa << 24) as u32))
        fuiscene.cv_ring_a(x, y, w, h, r, 1, WHITE, 120)
        return
    }
    if dark {
        fuiscene.cv_round_a(x, y, w, h, r, 0x0E1420, a)
        fuiscene.cv_round_a(x, y, w, h, r, WHITE, 22)
    } else {
        fuiscene.cv_round_a(x, y, w, h, r, WHITE, a)
    }
    fuiscene.cv_ring_a(x, y, w, h, r, 1, WHITE, rim)
    // the fine highlight on the top edge
    fuiscene.cv_round_a(x + r, y + 1, w - 2 * r, 1, 0, WHITE, 70)
    if st & 8 != 0 {
        // keyboard focus: the accent ring of fUi ON the plate edge (a white inner halo vanishes on milk glass)
        let ac: u32 = (*theme.theme_colors(fuiapp.theme())).accent | (0xFF000000 as u32)
        fuiscene.cv_ring_raw(x, y, w, h, r, 2, ac)
    }
}

// The plate painter the host hands to fuiscene (fields and cards): state bits 2 hover, 8 focus.
fn plate_cb(x: u64, y: u64, w: u64, h: u64, st: u64) {
    glass_panel(x, y, w, h, st, 0)
}

fn glass_install() {
    if glass_on() {
        fuiscene.glass_plates(plate_cb)
    }
}

// A tile that is a frosted plate when glass is on and the ordinary tile otherwise.
fn lay_btn(parent: usize, key: u64, name: u64, w: u64, h: u64, on: bool, ud: u64,
    cb: fn(u64, u64, u64, u64, u64, u64)) -> usize {
    if glass_on() {
        return lay_glass_tile(parent, key, name, w, h, on, ud, cb)
    }
    return lay_tile(parent, key, name, w, h, on, ud, cb)
}

fn glass_glyph(cp: u64, x: u64, y: u64, w: u64, h: u64, st: u64, lit: bool) {
    if glass_on() {
        var gs: u64 = st
        if lit {
            gs = gs | 2
        }
        glass_panel(x, y, w, h, gs, 0)
        let gi: u64 = glass_ink()
        glyph_tile(cp, x, y, w, h, 0xFF000000 | ((gi & 255) << 16) | (gi & 65280) | ((gi >> 16) & 255))
        return
    }
    glass_plate(x, y, w, h, st, lit)
    glyph_tile(cp, x, y, w, h, 0xFFFFFFFF)
}
