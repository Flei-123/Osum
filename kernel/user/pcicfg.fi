// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import ulib
import tools
import dbgio

export { u_start }

static mut BUF: [u8; 256] = [0 as u8; 256]

fn dump(bdf: u64, off: u64, len: u64) -> u64 {
    var s_name: [u8; 7] = "pcicfg\0"
    let r: u64 = dbgio.call(dbgio.OP_CFGREAD, bdf, off, (&BUF[0 as usize]) as u64, len)
    if ulib.bad(r) {
        dbgio.put_error((&s_name[0 as usize]) as u64, r)
        return 1
    }
    dbgio.put_bytes((&BUF[0 as usize]) as u64, off, r)
    tools.ob_flush()
    return 0
}

fn write_value(bdf: u64, off: u64, width: u64, value: u64) -> u64 {
    var s_name: [u8; 7] = "pcicfg\0"
    var s_ok: [u8; 9] = "written\0\0"
    let r: u64 = dbgio.call(dbgio.OP_CFGWRITE, bdf, off, value, width)
    if ulib.bad(r) {
        dbgio.put_error((&s_name[0 as usize]) as u64, r)
        return 1
    }
    tools.ob_str((&s_ok[0 as usize]) as u64)
    tools.ob_nl()
    tools.ob_flush()
    return 0
}

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 85] = "usage: pcicfg <bb:dd.f> [off [len]] | pcicfg --write <bb:dd.f> <off> <width> <value>\0"
    var f_write: [u8; 8] = "--write\0"
    let a0: u64 = dbgio.positional(args, 0)
    if a0 == 0 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 2
    }
    let bdf: u64 = dbgio.parse_bdf(a0)
    if bdf == dbgio.BAD {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 2
    }
    if dbgio.has_flag(args, (&f_write[0 as usize]) as u64) {
        let a1: u64 = dbgio.positional(args, 1)
        let a2: u64 = dbgio.positional(args, 2)
        let a3: u64 = dbgio.positional(args, 3)
        if a1 == 0 || a2 == 0 || a3 == 0 {
            ulib.esay_line((&s_use[0 as usize]) as u64, 0)
            return 2
        }
        let off: u64 = dbgio.parse_hex(a1)
        let width: u64 = ulib.to_num(a2)
        let value: u64 = dbgio.parse_hex(a3)
        if off == dbgio.BAD || value == dbgio.BAD {
            ulib.esay_line((&s_use[0 as usize]) as u64, 0)
            return 2
        }
        return write_value(bdf, off, width, value)
    }
    var off: u64 = 0
    var len: u64 = 64
    let a1: u64 = dbgio.positional(args, 1)
    let a2: u64 = dbgio.positional(args, 2)
    if a1 != 0 {
        off = dbgio.parse_hex(a1)
        if off == dbgio.BAD {
            ulib.esay_line((&s_use[0 as usize]) as u64, 0)
            return 2
        }
        len = 256 - off
        if off > 255 {
            len = 0
        }
    }
    if a2 != 0 {
        len = dbgio.parse_hex(a2)
        if len == dbgio.BAD {
            ulib.esay_line((&s_use[0 as usize]) as u64, 0)
            return 2
        }
    }
    return dump(bdf, off, len)
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
