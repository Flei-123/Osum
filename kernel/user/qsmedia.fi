profile kernel

import actwire
import wlibc
import icons
import fuiscene
import mediacli

export { K_MEDIA, K_MPREV, K_MPLAY, K_MNEXT, R_NONE, R_CONTENT, R_LAYOUT, shown, extra, refresh, build, is_key, paint, press }

const K_MEDIA: u64 = 25
const K_MPREV: u64 = 26
const K_MPLAY: u64 = 27
const K_MNEXT: u64 = 28

const ROW_H: u64 = 56
const ROW_GAP: u64 = 6
const BTN_W: u64 = 40
const COVER: u64 = 40
const GLYPH: u64 = 14

const R_NONE: u64 = 0
const R_CONTENT: u64 = 1
const R_LAYOUT: u64 = 2

static mut was_shown: bool = false

fn sk() -> u64 {
    return wlibc.ui_scale()
}

fn shown() -> bool {
    return mediacli.present()
}

fn extra() -> u64 {
    if mediacli.present() {
        return ROW_H + 12
    }
    return 0
}

fn refresh() -> u64 {
    let changed: bool = mediacli.fetch()
    let now: bool = mediacli.present()
    if now != was_shown {
        was_shown = now
        return R_LAYOUT
    }
    if changed {
        return R_CONTENT
    }
    return R_NONE
}

fn info_w(inner: u64) -> u64 {
    return inner - 3 * BTN_W - 3 * ROW_GAP
}

fn build(card: usize, inner: u64, draw: fn(u64, u64, u64, u64, u64)) {
    if !mediacli.present() {
        return
    }
    let r: usize = fuiscene.row(card)
    fuiscene.set_gap(r, ROW_GAP)
    fuiscene.set_size(r, inner, ROW_H)
    let _i: usize = fuiscene.canvas2(r, K_MEDIA, info_w(inner), ROW_H, draw)
    let _p: usize = fuiscene.canvas2(r, K_MPREV, BTN_W, ROW_H, draw)
    let _y: usize = fuiscene.canvas2(r, K_MPLAY, BTN_W, ROW_H, draw)
    let _n: usize = fuiscene.canvas2(r, K_MNEXT, BTN_W, ROW_H, draw)
}

fn is_key(key: u64) -> bool {
    return key >= K_MEDIA && key <= K_MNEXT
}

fn plate(x: u64, y: u64, w: u64, h: u64, hot: bool) {
    var col: u64 = wlibc.theme(wlibc.T_BTN)
    if hot {
        col = wlibc.theme(wlibc.T_BTNHI)
    }
    let r: u64 = fuiscene.rb_px()
    fuiscene.cv_round_rgb(x, y, w, h, r, col)
    fuiscene.cv_ring_rgb(x, y, w, h, r, 1, wlibc.theme(wlibc.T_LINE))
}

fn tri_right(x: u64, y: u64, w: u64, h: u64, rgb: u64, left: bool) {
    var r: u64 = 0
    while r < h {
        var d: u64 = 0
        if 2 * r + 1 >= h {
            d = 2 * r + 1 - h
        } else {
            d = h - 2 * r - 1
        }
        let wr: u64 = w * (h - d) / h
        if left {
            fuiscene.cv_rgb(x + w - wr, y + r, wr, 1, rgb)
        } else {
            fuiscene.cv_rgb(x, y + r, wr, 1, rgb)
        }
        r = r + 1
    }
}

fn paint_info(x: u64, y: u64, w: u64, h: u64) {
    plate(x, y, w, h, false)
    let s: u64 = sk()
    let fg: u64 = wlibc.theme(wlibc.T_FG)
    let dim: u64 = wlibc.theme(wlibc.T_DIM)
    let cs: u64 = COVER * s
    let cx: u64 = x + 8 * s
    let cy: u64 = y + (h - cs) / 2
    fuiscene.cv_round_rgb(cx, cy, cs, cs, fuiscene.rb_px(), wlibc.theme(wlibc.T_ACCENT))
    let gs: u64 = 20 * s
    var cg: u64 = icons.VOLUME_HIGH
    if !mediacli.playing() {
        cg = icons.VOLUME_LOW
    }
    fuiscene.cv_glyph(cg, cx + (cs - gs) / 2, cy + (cs - gs) / 2, gs, wlibc.theme(wlibc.T_SELFG))
    let tx: u64 = cx + cs + 10 * s
    var room: u64 = 0
    if x + w > tx + 8 * s {
        room = x + w - tx - 8 * s
    }
    let px: u64 = wlibc.px_ui()
    let th: u64 = wlibc.text_h(px)
    let asc: u64 = wlibc.ascent_of(wlibc.F_UI, px)
    var top: u64 = y
    if h > 2 * th {
        top = y + (h - 2 * th) / 2
    }
    fuiscene.cv_text_rgb(tx, top + asc, room, mediacli.title(), px, false, fg)
    var sub: u64 = mediacli.artist()
    if actwire.ld8(sub, 0) == 0 {
        sub = mediacli.app()
    }
    fuiscene.cv_text_rgb(tx, top + th + asc, room, sub, px, false, dim)
}

fn paint_button(key: u64, x: u64, y: u64, w: u64, h: u64) {
    let s: u64 = sk()
    plate(x, y, w, h, false)
    let fg: u64 = wlibc.theme(wlibc.T_FG)
    let g: u64 = GLYPH * s
    let gx: u64 = x + (w - g) / 2
    let gy: u64 = y + (h - g) / 2
    let bar: u64 = 2 * s
    if key == K_MPLAY {
        if mediacli.playing() {
            let bw: u64 = 4 * s
            fuiscene.cv_round_rgb(gx + g / 2 - bw - s, gy, bw, g, s, fg)
            fuiscene.cv_round_rgb(gx + g / 2 + s, gy, bw, g, s, fg)
        } else {
            tri_right(gx + s, gy, g - 2 * s, g, fg, false)
        }
        return
    }
    var col: u64 = fg
    var live: bool = mediacli.can_next()
    if key == K_MPREV {
        live = mediacli.can_prev()
    }
    if !live {
        col = wlibc.theme(wlibc.T_DIM)
    }
    if key == K_MPREV {
        fuiscene.cv_rgb(gx, gy, bar, g, col)
        tri_right(gx + bar + s, gy, g - bar - s, g, col, true)
    } else {
        tri_right(gx, gy, g - bar - s, g, col, false)
        fuiscene.cv_rgb(gx + g - bar, gy, bar, g, col)
    }
}

fn paint(key: u64, x: u64, y: u64, w: u64, h: u64) {
    if key == K_MEDIA {
        paint_info(x, y, w, h)
        return
    }
    paint_button(key, x, y, w, h)
}

fn press(key: u64) -> bool {
    if key == K_MPLAY {
        return mediacli.control(cmd_toggle())
    }
    if key == K_MPREV && mediacli.can_prev() {
        return mediacli.control(cmd_prev())
    }
    if key == K_MNEXT && mediacli.can_next() {
        return mediacli.control(cmd_next())
    }
    return false
}

static mut C_TOGGLE: [u8; 7] = "toggle\0"
static mut C_PREV: [u8; 5] = "prev\0"
static mut C_NEXT: [u8; 5] = "next\0"

fn cmd_toggle() -> u64 {
    return (&C_TOGGLE[0 as usize]) as u64
}

fn cmd_prev() -> u64 {
    return (&C_PREV[0 as usize]) as u64
}

fn cmd_next() -> u64 {
    return (&C_NEXT[0 as usize]) as u64
}
