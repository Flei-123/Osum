
profile kernel

import ulib

export { u_start }

static mut S_0: [u8; 26] = "umount: cannot unmount /\0\0"
static mut S_1: [u8; 24] = "umount: cannot unmount\0\0"
static mut S_SL: [u8; 2] = "/\0"

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc >= 2 {
        let target: u64 = ulib.arg_at(args, 1)
        if !ulib.streq(target, (&S_SL[0 as usize]) as u64) {
            let r: u64 = ulib.sys(ulib.SYS_UMOUNT2, target, 0, 0)
            if ulib.bad(r) {
                ulib.esay_line((&S_1[0 as usize]) as u64, 0)
                return 1
            }
            return 0
        }
    }
    let r: u64 = ulib.sys(ulib.SYS_MOUNT, 2, 0, 0)
    if ulib.bad(r) {
        ulib.esay_line((&S_0[0 as usize]) as u64, 0)
        return 1
    }
    return 0
}
