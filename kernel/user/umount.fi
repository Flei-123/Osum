// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/umount.fi -- Runde K11: aushaengen.
//
// Danach ist FS_READY null, und jeder Weg ins Dateisystem antwortet mit
// dem Fehler, den er dafuer schon hatte -- `ls /` findet nichts, `cat`
// oeffnet nichts, `exec` startet nichts mehr von der Platte. Genau
// deshalb ist `umount` ein GUTER Testfall: er nimmt dem System den
// Boden weg und `mount /` gibt ihn zurueck.
//
// Wer `umount` aus einer Shell ruft, die auf der Platte liegt, nimmt sich
// selbst den naechsten Befehl weg -- das ist auf jedem Unix so und hier
// nicht anders.

profile kernel

import ulib

export { u_start }

// DIE ZEICHENKETTEN LIEGEN IM MODUL UND NICHT AUF DEM STAPEL -- und sie
// stehen als `static mut` da, obwohl niemand hineinschreibt.
//
// Der Grund ist ein Fehler in firnc1, dem Uebersetzer, der in Firn
// geschrieben ist: ein unveraenderliches `static` mit einer Zeichenkette
// bringt ihn OHNE MELDUNG mit Beendigungscode 1 zu Fall. firnc0
// uebersetzt dasselbe anstandslos. Der kleinste Nachweis steht in
// docs/ROUNDK11.md.
static mut S_0: [u8; 26] = "umount: cannot unmount /\0\0"
static mut S_1: [u8; 24] = "umount: cannot unmount\0\0"
static mut S_SL: [u8; 2] = "/\0"

// ROUNDE K14: `umount ZIEL` haengt eine EINHAENGUNG aus -- Linux'
// Aufruf 166. Ohne Argument (und mit "/" ) bleibt es der Weg von Runde
// K11: die eine Wurzelplatte, SYS_MOUNT mit op=2. Beide stehen
// nebeneinander, und `tools/k14/run.sh` misst beide.
//
// EINE EINHAENGUNG MIT OFFENEN DESKRIPTOREN GEHT NICHT WEG. Der Kernel
// antwortet dann -EBUSY, und das ist keine Formalie: ein Dateisystem,
// das man unter einem lesenden Prozess wegziehen kann, verliert Daten.

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc >= 2 {
        let target: u64 = ulib.arg_at(args, 1)
        if !ulib.streq(target, (&S_SL[0 as usize]) as u64) {
            let r: u64 = ulib.sys(ulib.SYS_UMOUNT2, target, 0, 0)
            if ulib.bad(r) {
                ulib.esay_line((&S_1[0 as usize]) as u64, 0)
                return 1
            }
            return 0
        }
    }
    let r: u64 = ulib.sys(ulib.SYS_MOUNT, 2, 0, 0)
    if ulib.bad(r) {
        ulib.esay_line((&S_0[0 as usize]) as u64, 0)
        return 1
    }
    return 0
}
