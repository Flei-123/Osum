profile app

import fuiapp.hostwinp
import libc.text
import uiscale
import wlibc
import fuiapp.apphost
import fuiscene
import uikit.uiflyout

export { init, open, close, is_open, step, x, y, w, h, rows, NONE, DISMISSED }

const NONE: u64 = 0xFFFFFFFFFFFFFFFF

const DISMISSED: u64 = 0xFFFFFFFFFFFFFFFE

const MAX_ROWS: u64 = 16

const ROW_PT: u64 = 28

const PAD_PT: u64 = 8

const MIN_W_PT: u64 = 60

const TEXT_PAD_PT: u64 = 24

const MAX_W_PT: u64 = 320

const BUTTON_MASK: u64 = 7

static mut pm_win: u64 = 0xFFFFFFFFFFFFFFFF

static mut pm_handle: u64 = 0

static mut pm_open: u64 = 0

static mut pm_x: u64 = 0

static mut pm_y: u64 = 0

static mut pm_w: u64 = 0

static mut pm_h: u64 = 0

static mut pm_rows: u64 = 0

static mut pm_btn_last: u64 = 0

static mut pm_focus_seen: u64 = 0

static mut pm_title: [u8; 5] = "menu\0"

fn build() {
    let root: usize = fuiscene.root()
    fuiscene.set_pad(root, 0)
    fuiscene.set_gap(root, 0)
}

fn init() -> bool {
    if pm_win != NONE {
        return true
    }
    let scale: u64 = uiscale.ui_scale()
    pm_win = fuiscene.win_open_plain(0, 0, MAX_W_PT * scale, (MAX_ROWS * ROW_PT + PAD_PT) * scale,
        (&pm_title[0 as usize]) as u64, hostwinp.L_MENU, build)
    if pm_win == fuiscene.BADWIN {
        pm_win = NONE
        return false
    }
    let _s: bool = fuiscene.win_select(pm_win)
    fuiscene.keys_always(true)
    pm_handle = fuiscene.handle()
    let _v: u64 = wlibc.win_state(pm_handle, hostwinp.WS_HIDDEN, 1)
    let _u: bool = fuiscene.win_select(0)
    return true
}

fn x() -> u64 {
    return pm_x
}

fn y() -> u64 {
    return pm_y
}

fn w() -> u64 {
    return pm_w
}

fn h() -> u64 {
    return pm_h
}

fn rows() -> u64 {
    return pm_rows
}

fn is_open() -> bool {
    return pm_open != 0
}

fn widest(items: u64, n: u64) -> u64 {
    let scale: u64 = uiscale.ui_scale()
    var best: u64 = MIN_W_PT * scale
    var p: u64 = items
    var k: u64 = 0
    while k < n {
        let tw: u64 = fuiscene.text_width(p, uiscale.px_ui()) + TEXT_PAD_PT * scale
        if tw > best {
            best = tw
        }
        p = p + text.length(p) + 1
        k = k + 1
    }
    if best > MAX_W_PT * scale {
        return MAX_W_PT * scale
    }
    return best
}

fn place(sx: u64, sy: u64) {
    var top: u64 = sy
    if sy + pm_h > wlibc.screen_h() && sy > pm_h {
        top = sy - pm_h
    }
    pm_x = uiflyout.clamp_axis(sx, pm_w, 0, wlibc.screen_w())
    pm_y = uiflyout.clamp_axis(top, pm_h, 0, wlibc.screen_h())
}

fn paint() {
    var n: u64 = 0
    while n < 3 {
        let _k: u64 = fuiscene.pump_aux(pm_win)
        n = n + 1
    }
}

fn open(sx: u64, sy: u64, items: u64, n: u64) -> bool {
    if pm_win == NONE || pm_open != 0 || n == 0 || n > MAX_ROWS {
        return false
    }
    let _s: bool = fuiscene.win_select(pm_win)
    let width: u64 = widest(items, n)
    fuiscene.menu_open(0, 0, width, items, n)
    pm_w = width
    pm_h = fuiscene.menu_h()
    let sized: bool = fuiscene.win_size(pm_w, pm_h)
    fuiscene.refresh()
    fuiscene.touch()
    let _u: bool = fuiscene.win_select(0)
    if !sized {
        return false
    }
    pm_rows = n
    place(sx, sy)
    paint()
    let _m: u64 = wlibc.sys3w(hostwinp.WM_MOVE, pm_handle, (pm_x << 16) | pm_y, 0)
    let _v: u64 = wlibc.win_state(pm_handle, hostwinp.WS_HIDDEN, 0)
    let _k: u64 = wlibc.win_state(pm_handle, hostwinp.WS_KEYS, 1)
    let _a: u64 = wlibc.win_act(wlibc.sys3w(hostwinp.WM_INFO, pm_handle, hostwinp.WI_ID, 0), hostwinp.WA_RAISE)
    let _f: bool = fuiscene.win_select(pm_win)
    fuiscene.focus_canvas()
    let _g: bool = fuiscene.win_select(0)
    pm_btn_last = wlibc.mouse_btn() & BUTTON_MASK
    pm_focus_seen = 0
    pm_open = 1
    return true
}

fn close() {
    if pm_open == 0 {
        return
    }
    pm_open = 0
    let _s: bool = fuiscene.win_select(pm_win)
    fuiscene.menu_close()
    let _u: bool = fuiscene.win_select(0)
    let _v: u64 = wlibc.win_state(pm_handle, hostwinp.WS_HIDDEN, 1)
}

fn inside(px: u64, py: u64) -> bool {
    return px >= pm_x && px < pm_x + pm_w && py >= pm_y && py < pm_y + pm_h
}

fn pressed_outside() -> bool {
    let btn: u64 = wlibc.mouse_btn() & BUTTON_MASK
    let fresh: u64 = btn & ~pm_btn_last
    pm_btn_last = btn
    return fresh != 0 && !inside(wlibc.mouse_x(), wlibc.mouse_y())
}

fn lost_focus(focused: bool) -> bool {
    if focused {
        pm_focus_seen = 1
        return false
    }
    return pm_focus_seen != 0
}

fn step() -> u64 {
    if pm_open == 0 {
        return NONE
    }
    let _st: u64 = apphost.step()
    let _k: u64 = fuiscene.pump_aux(pm_win)
    let _s: bool = fuiscene.win_select(pm_win)
    let pick: u64 = fuiscene.menu_pick()
    let live: bool = fuiscene.menu_is_open()
    let focused: bool = fuiscene.has_focus()
    let _u: bool = fuiscene.win_select(0)
    if pick != 0 {
        close()
        return pick - 1
    }
    if !live || lost_focus(focused) || pressed_outside() {
        close()
        return DISMISSED
    }
    return NONE
}
