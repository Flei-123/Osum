profile app

import fui.painter
import fui.tokens

const K_CARD: u64 = 0

const K_FLYOUT: u64 = 1

const K_TIP: u64 = 2

const K_TOAST: u64 = 3

const K_DIALOG: u64 = 4

const K_CHIP: u64 = 5

const KIND_COUNT: u64 = 6

const OPAQUE: u32 = 4278190080 as u32

static mut kind_radius: [u64; 6] = [1, 1, 1, 1, 1, 3]

static mut kind_elevation: [u64; 6] = [1, 2, 2, 2, 3, 0]

static mut legacy_look: bool = false

fn valid(kind: u64) -> u64 {
    if kind < KIND_COUNT {
        return kind
    }
    return K_CARD
}

fn elevation(kind: u64) -> u64 {
    return kind_elevation[valid(kind) as usize]
}

fn radius_px(kind: u64, w: u64, h: u64, s: u64) -> u64 {
    let r: u64 = tokens.radius(kind_radius[valid(kind) as usize], s)
    var half: u64 = h / 2
    if w < h {
        half = w / 2
    }
    if r > half {
        return half
    }
    return r
}

fn set_legacy(on: bool) {
    legacy_look = on
}

fn swap_rb(rgb: u64) -> u32 {
    return (((rgb & 255) << 16) | (rgb & 65280) | ((rgb >> 16) & 255)) as u32
}

fn paint_legacy(z: *mut painter.Painter, x: u64, y: u64, w: u64, h: u64, r: u64, fill: u64, stroke: u64) {
    painter.round_rect(z, x as f64, y as f64, w as f64, h as f64, r as f64, swap_rb(fill) | OPAQUE)
    painter.round_ring(z, x as f64, y as f64, w as f64, h as f64, r as f64, 1.0, swap_rb(stroke) | OPAQUE)
}

fn paint_rimmed(z: *mut painter.Painter, x: u64, y: u64, w: u64, h: u64, outer_r: u64, inner_r: u64,
    fill: u64, stroke: u64) {
    painter.round_rect(z, x as f64, y as f64, w as f64, h as f64, outer_r as f64, swap_rb(stroke) | OPAQUE)
    painter.round_rect(z, (x + 1) as f64, (y + 1) as f64, (w - 2) as f64, (h - 2) as f64, inner_r as f64,
        swap_rb(fill) | OPAQUE)
}

fn paint(z: *mut painter.Painter, kind: u64, x: u64, y: u64, w: u64, h: u64, s: u64, fill: u64, stroke: u64) {
    let r: u64 = radius_px(kind, w, h, s)
    if legacy_look || w < 3 || h < 3 {
        paint_legacy(z, x, y, w, h, r, fill, stroke)
        return
    }
    var ri: u64 = r
    if ri > 0 {
        ri = ri - 1
    }
    paint_rimmed(z, x, y, w, h, r, ri, fill, stroke)
}

fn paint_window(z: *mut painter.Painter, x: u64, y: u64, w: u64, h: u64, server_r: u64, fill: u64, stroke: u64) {
    if legacy_look || w < 3 || h < 3 {
        paint_legacy(z, x, y, w, h, server_r, fill, stroke)
        return
    }
    var ri: u64 = server_r
    if ri > 0 {
        ri = ri - 1
    }
    paint_rimmed(z, x, y, w, h, 0, ri, fill, stroke)
}
