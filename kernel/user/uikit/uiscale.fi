profile kernel

import fuiapp.hostwinp
import ulib

export { ui_scale, px_ui, px_to_pt, px_ui_at, win_scale_pct, PX_UI0 }

const PX_UI0: u64 = 15

const WIG_SCREEN: u64 = 1805

const SCALE_MAX: u64 = 4

const PCT_MIN: u64 = 100

const PCT_MAX: u64 = 400

static mut s_scale: u64 = 0

fn ui_scale() -> u64 {
    if s_scale == 0 {
        let v: u64 = ulib.sys(WIG_SCREEN, hostwinp.WS_SCALE, 0, 0)
        if ulib.bad(v) || v == 0 || v > SCALE_MAX {
            s_scale = 1
        } else {
            s_scale = v
        }
    }
    return s_scale
}

fn px_ui() -> u64 {
    return PX_UI0 * ui_scale()
}

fn px_to_pt(px: u64) -> u64 {
    return (px + ui_scale() - 1) / ui_scale()
}

fn px_ui_at(pct: u64) -> u64 {
    return (PX_UI0 * pct + 50) / 100
}

fn win_scale_pct(h: u64) -> u64 {
    let v: u64 = ulib.sys(hostwinp.WM_INFO, h, hostwinp.WI_SCALEPCT, 0)
    if ulib.bad(v) || v < PCT_MIN || v > PCT_MAX {
        return ui_scale() * 100
    }
    return v
}
