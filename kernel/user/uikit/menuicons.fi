profile kernel

import icons

export {
    NONE, LAUNCH, PIN, UNPIN, MINIMISE, END_TASK, CLOSE, TASK_MANAGER, SETTINGS, DISPLAY, OPEN, CUT, COPY, PASTE, RENAME,
    DELETE, NEW_FOLDER, NEW_FILE, INFO, REFRESH, VIEW, EXTRACT, MARK_ICON, MARK_SEPARATOR, ICON_ID_BASE, codepoint
}

const MARK_ICON: u64 = 1
const MARK_SEPARATOR: u64 = 2
const ICON_ID_BASE: u64 = 32
const NONE: u64 = 0
const LAUNCH: u64 = 1
const PIN: u64 = 2
const UNPIN: u64 = 3
const MINIMISE: u64 = 4
const END_TASK: u64 = 5
const CLOSE: u64 = 6
const TASK_MANAGER: u64 = 7
const SETTINGS: u64 = 8
const DISPLAY: u64 = 9
const OPEN: u64 = 10
const CUT: u64 = 11
const COPY: u64 = 12
const PASTE: u64 = 13
const RENAME: u64 = 14
const DELETE: u64 = 15
const NEW_FOLDER: u64 = 16
const NEW_FILE: u64 = 17
const INFO: u64 = 18
const REFRESH: u64 = 19
const VIEW: u64 = 20
const EXTRACT: u64 = 21

fn codepoint(id: u64) -> u64 {
    if id == LAUNCH {
        return icons.MENU_LAUNCH
    }
    if id == PIN {
        return icons.MENU_PIN
    }
    if id == UNPIN {
        return icons.MENU_UNPIN
    }
    if id == MINIMISE {
        return icons.WINDOW_MINIMISE
    }
    if id == END_TASK {
        return icons.CMD_END_TASK
    }
    if id == CLOSE {
        return icons.WINDOW_CLOSE
    }
    if id == TASK_MANAGER {
        return icons.PAGE_GAUGE
    }
    if id == SETTINGS {
        return icons.SETTINGS
    }
    if id == DISPLAY {
        return icons.SETTINGS_DISPLAY
    }
    if id == OPEN {
        return icons.CMD_OPEN
    }
    if id == CUT {
        return icons.CMD_CUT
    }
    if id == COPY {
        return icons.CMD_COPY
    }
    if id == PASTE {
        return icons.CMD_PASTE
    }
    if id == RENAME {
        return icons.CMD_RENAME
    }
    if id == DELETE {
        return icons.TRASH
    }
    if id == NEW_FOLDER {
        return icons.CMD_NEW_FOLDER
    }
    if id == NEW_FILE {
        return icons.CMD_NEW_FILE
    }
    if id == INFO {
        return icons.INFO
    }
    if id == REFRESH {
        return icons.NAV_REFRESH
    }
    if id == VIEW {
        return icons.CMD_VIEW
    }
    if id == EXTRACT {
        return icons.FILE_FOLDER_OPEN
    }
    return 0
}
