profile kernel

import fui.tokens

const SIDE_ABOVE: u64 = 0

const SIDE_BELOW: u64 = 1

static mut placed_x: u64 = 0

static mut placed_y: u64 = 0

static mut placed_side: u64 = 0

fn x() -> u64 {
    return placed_x
}

fn y() -> u64 {
    return placed_y
}

fn side() -> u64 {
    return placed_side
}

fn clamp_axis(want: u64, size: u64, lo: u64, hi: u64) -> u64 {
    if size + 2 * lo >= hi {
        return lo
    }
    if want < lo {
        return lo
    }
    if want + size + lo > hi {
        return hi - size - lo
    }
    return want
}

fn centered(anchor: u64, anchor_size: u64, size: u64) -> u64 {
    let mid: u64 = anchor + anchor_size / 2
    if mid < size / 2 {
        return 0
    }
    return mid - size / 2
}

fn place_vertical(ay: u64, ah: u64, h: u64, gap: u64, margin: u64, screen_h: u64) {
    if ay >= h + gap + margin {
        placed_y = ay - gap - h
        placed_side = SIDE_ABOVE
        return
    }
    placed_y = clamp_axis(ay + ah + gap, h, margin, screen_h)
    placed_side = SIDE_BELOW
}

fn place(ax: u64, ay: u64, aw: u64, ah: u64, w: u64, h: u64, screen_w: u64, screen_h: u64, s: u64) {
    let gap: u64 = tokens.space(tokens.SP_2, s)
    let margin: u64 = tokens.space(tokens.SP_2, s)
    placed_x = clamp_axis(centered(ax, aw, w), w, margin, screen_w)
    place_vertical(ay, ah, h, gap, margin, screen_h)
}
