profile kernel

export { PLATE, plate, plate_ink, text_at }

import fuiapp.hostwin
import uikit.uidraw
import uikit.uiglyph
import uikit.uitext
import uitheme.thengine
import uitheme.thtokens
import utf8

const PLATE: u64 = 0x01000000

fn plate(x: u64, y: u64, w: u64, h: u64) {
    if w == 0 || h == 0 {
        return
    }
    if thengine.win_alpha_fx() >= 100 || hostwin.s_panel != 0 {
        return
    }
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let a: u64 = uidraw.get(x + c, y + r)
            uidraw.px(x + c, y + r, (a & 0xFFFFFF) | PLATE)
            c = c + 1
        }
        r = r + 1
    }
}

const INK_R: u64 = 2

fn plate_ink(x: u64, y: u64, w: u64, h: u64) {
    if w == 0 || h == 0 {
        return
    }
    if thengine.win_alpha_fx() >= 100 || hostwin.s_panel != 0 {
        return
    }
    let bg: u64 = uidraw.get(x, y) & 0xFFFFFF
    var r: u64 = 0
    while r < h {
        var c: u64 = 0
        while c < w {
            let a: u64 = uidraw.get(x + c, y + r)
            if (a & 0xFFFFFF) != bg {
                var dy: u64 = 0
                while dy <= INK_R * 2 {
                    var dx: u64 = 0
                    while dx <= INK_R * 2 {

                        let qx: u64 = x + c + dx
                        let qy: u64 = y + r + dy
                        if qx >= INK_R && qy >= INK_R {
                            let q: u64 = uidraw.get(qx - INK_R, qy - INK_R)
                            if (q >> 24) != 1 {
                                uidraw.px(qx - INK_R, qy - INK_R, (q & 0xFFFFFF) | PLATE)
                            }
                        }
                        dx = dx + 1
                    }
                    dy = dy + 1
                }
            }
            c = c + 1
        }
        r = r + 1
    }
}

fn text_at(f: u64, px_: u64, x: u64, y: u64, p: u64, n: u64,
    color: u64) -> u64 {
    var cx: i64 = (x as i64) * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = n
        } else {
            if vorher != 0 {
                cx = cx + uiglyph.kern26(f, px_, vorher, c)
            }
            let at: u64 = uiglyph.gfind(f, px_, c)
            if at != 0xFFFFFFFFFFFFFFFF {
                uiglyph.draw_glyph(at, cx >> 6, y as i64, color)
                cx = cx + thtokens.gc[(at + thtokens.GC_ADV) as usize] as i64
            }
            vorher = c
            k = k + l
        }
    }
    let ende: u64 = (cx >> 6) as u64
    if ende > x {
        let asc: u64 = uitext.ascent_of(f, px_)
        var py0: u64 = 0
        if y > asc + 1 {
            py0 = y - asc - 1
        }
        plate_ink(x, py0, ende - x + 1, uitext.text_h(px_) + 2)
    }
    return ende
}
