profile app

import uiscale
import uitheme
import fuiapp
import fui.render
import fui.painter
import uikit.uiplate

const K_CARD: u64 = uiplate.K_CARD

const K_FLYOUT: u64 = uiplate.K_FLYOUT

const K_TIP: u64 = uiplate.K_TIP

const K_TOAST: u64 = uiplate.K_TOAST

const K_DIALOG: u64 = uiplate.K_DIALOG

const K_CHIP: u64 = uiplate.K_CHIP

const K_CARD_SOFT: u64 = uiplate.K_CARD_SOFT

const K_LAYER: u64 = uiplate.K_LAYER

const K_BUTTON: u64 = uiplate.K_BUTTON

fn fill_role(kind: u64) -> u64 {
    if kind == K_DIALOG {
        return uitheme.T_DLG
    }
    if kind == K_CHIP || kind == K_BUTTON {
        return uitheme.T_BTN
    }
    return uitheme.T_MENU
}

fn fill(kind: u64) -> u64 {
    return uitheme.theme(fill_role(kind))
}

fn stroke(kind: u64) -> u64 {
    return uitheme.theme(uitheme.T_LINE)
}

fn canvas_painter() -> *mut painter.Painter {
    return render.ctx_painter(fuiapp.ctx())
}

fn paint_on(z: *mut painter.Painter, kind: u64, x: u64, y: u64, w: u64, h: u64) {
    uiplate.set_legacy(uitheme.aa_old())
    uiplate.paint(z, kind, x, y, w, h, uiscale.ui_scale(), fill(kind), stroke(kind))
}

fn paint(kind: u64, x: u64, y: u64, w: u64, h: u64) {
    paint_on(canvas_painter(), kind, x, y, w, h)
}

fn paint_window(kind: u64, x: u64, y: u64, w: u64, h: u64) {
    uiplate.set_legacy(uitheme.aa_old())
    uiplate.paint_window(canvas_painter(), x, y, w, h, uitheme.win_round(w, h), fill(kind), stroke(kind))
}

fn paint_scene(z: *mut painter.Painter, kind: u64, x: f64, y: f64, w: f64, h: f64, r: f64) {
    uiplate.set_legacy(uitheme.aa_old())
    uiplate.paint_raised(z, kind, x, y, w, h, r, fill(kind), stroke(kind))
}

fn paint_filled(kind: u64, x: u64, y: u64, w: u64, h: u64, fill_rgb: u64) {
    uiplate.set_legacy(uitheme.aa_old())
    uiplate.paint(canvas_painter(), kind, x, y, w, h, uiscale.ui_scale(), fill_rgb, stroke(kind))
}

fn paint_color(kind: u64, x: u64, y: u64, w: u64, h: u64, rgb: u64) {
    uiplate.set_legacy(uitheme.aa_old())
    uiplate.paint(canvas_painter(), kind, x, y, w, h, uiscale.ui_scale(), rgb, rgb)
}
