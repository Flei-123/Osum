profile kernel

import utf8
import uitheme.thtokens
import uikit.uiglyph

export {
    F_UI, F_MONO, F_ICON, F_BOLD, text_w, text_h, ascent_of, mono_cell, ink_l, ink_t, ink_w, ink_h,
}

const F_UI: u64 = 0

const F_MONO: u64 = 1

const F_ICON: u64 = 2

const F_BOLD: u64 = 3

const IBUF_LEN: u64 = 24576

static mut ibuf: [u8; 24576] = [0 as u8; 24576]

static mut ik_key: u64 = 0

static mut ik_l: i64 = 0

static mut ik_t: i64 = 0

static mut ik_w: u64 = 0

static mut ik_h: u64 = 0

fn text_w(f: u64, px_: u64, p: u64, n: u64) -> u64 {
    var cx: i64 = 0
    var prev: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = n
        } else {
            if prev != 0 {
                cx = cx + uiglyph.kern26(f, px_, prev, c)
            }
            let at: u64 = uiglyph.gfind(f, px_, c)
            if at != 0xFFFFFFFFFFFFFFFF {
                cx = cx + thtokens.gc[(at + thtokens.GC_ADV) as usize] as i64
            }
            prev = c
            k = k + l
        }
    }
    return (cx >> 6) as u64
}

fn text_h(px_: u64) -> u64 {
    return px_ + px_ / 4
}

fn ascent_of(f: u64, px_: u64) -> u64 {
    let at: u64 = uiglyph.gfind(f, px_, 108)
    if at == 0xFFFFFFFFFFFFFFFF {
        return px_
    }
    return thtokens.gc[(at + thtokens.GC_T) as usize]
}

fn mono_cell(px_: u64) -> u64 {
    let at: u64 = uiglyph.gfind(F_MONO, px_, 48)
    if at == 0xFFFFFFFFFFFFFFFF {
        return px_
    }
    return ((thtokens.gc[(at + thtokens.GC_ADV) as usize] as i64 + 63) >> 6) as u64
}

fn ink_load(f: u64, px_: u64, c: u64) {
    let k: u64 = uiglyph.gkey(f, px_, c)
    if ik_key == k {
        return
    }
    ik_key = k
    ik_l = 0
    ik_t = 0
    ik_w = 0
    ik_h = 0
    let n: u64 = uiglyph.source_glyph(f, px_, c, (&ibuf[0 as usize]) as u64, IBUF_LEN)
    if n < 48 {
        let at: u64 = uiglyph.gfind(f, px_, c)
        if at != 0xFFFFFFFFFFFFFFFF {
            ik_l = thtokens.gc[(at + thtokens.GC_L) as usize] as i64
            ik_t = thtokens.gc[(at + thtokens.GC_T) as usize] as i64
            ik_w = thtokens.gc[(at + thtokens.GC_W) as usize]
            ik_h = thtokens.gc[(at + thtokens.GC_H) as usize]
        }
        return
    }
    let b: u64 = (&ibuf[0 as usize]) as u64
    let gw: u64 = __mmio_read64((b + 0) as *mut u64)
    let gh: u64 = __mmio_read64((b + 8) as *mut u64)
    if gw > uiglyph.GMAX || gh > uiglyph.GMAX {
        return
    }
    ik_w = gw
    ik_h = gh
    ik_l = __mmio_read64((b + 16) as *mut u64) as i64
    ik_t = __mmio_read64((b + 24) as *mut u64) as i64
}

fn ink_l(f: u64, px_: u64, c: u64) -> i64 {
    ink_load(f, px_, c)
    return ik_l
}

fn ink_t(f: u64, px_: u64, c: u64) -> i64 {
    ink_load(f, px_, c)
    return ik_t
}

fn ink_w(f: u64, px_: u64, c: u64) -> u64 {
    ink_load(f, px_, c)
    return ik_w
}

fn ink_h(f: u64, px_: u64, c: u64) -> u64 {
    ink_load(f, px_, c)
    return ik_h
}
