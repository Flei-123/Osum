profile kernel

import fui.scene
import fui.tokens
import fuiapp
import uitheme

const K_TOGGLE: u64 = 1

const K_POP: u64 = 2

const K_RISE: u64 = 3

const K_MENU: u64 = 4

const OFF_MS: i64 = 1

const MOTION_REF: u64 = 160

const STAGGER_CAP: u64 = 8

const ENTER_MAX: usize = 48

const GROUP_MAX: usize = 16

const FULL: u64 = 1000

static mut enter_node: [usize; 48] = [0 as usize; 48]

static mut enter_group: [u64; 48] = [0 as u64; 48]

static mut enter_kind: [u64; 48] = [0 as u64; 48]

static mut enter_index: [u64; 48] = [0 as u64; 48]

static mut enter_count: usize = 0

static mut enter_build: u64 = 0

static mut group_key: [u64; 16] = [0 as u64; 16]

static mut group_start: [u64; 16] = [0 as u64; 16]

static mut group_count: usize = 0

fn enabled() -> bool {
    return uitheme.motion(0) != 0
}

fn kind_ms(kind: u64) -> u64 {
    if kind == K_TOGGLE {
        return 130
    }
    if kind == K_POP {
        return 150
    }
    if kind == K_RISE {
        return 180
    }
    return 110
}

fn base_ms(kind: u64) -> u64 {
    return kind_ms(kind) * uitheme.motion(0) / MOTION_REF
}

fn rise_px(kind: u64) -> u64 {
    if kind == K_POP {
        return 10
    }
    if kind == K_RISE {
        return 16
    }
    if kind == K_MENU {
        return 6
    }
    return 0
}

fn stagger_ms(kind: u64) -> u64 {
    if kind == K_POP {
        return 28
    }
    if kind == K_RISE {
        return 22
    }
    return 0
}

fn ms(kind: u64) -> i64 {
    if !enabled() {
        return OFF_MS
    }
    return base_ms(kind) as i64
}

fn progress(start: u64, now: u64, kind: u64, index: u64) -> u64 {
    if !enabled() {
        return FULL
    }
    var step: u64 = index
    if step > STAGGER_CAP {
        step = STAGGER_CAP
    }
    let begin: u64 = start + step * stagger_ms(kind)
    if now <= begin {
        return 0
    }
    return tokens.ease_at(now - begin, base_ms(kind))
}

fn group_begin(key: u64) {
    let now: u64 = fuiapp.now_ms()
    var i: usize = 0
    while i < group_count {
        if group_key[i] == key {
            group_start[i] = now
            return
        }
        i = i + 1
    }
    if group_count < GROUP_MAX {
        group_key[group_count] = key
        group_start[group_count] = now
        group_count = group_count + 1
    }
}

fn group_started(key: u64) -> u64 {
    var i: usize = 0
    while i < group_count {
        if group_key[i] == key {
            return group_start[i]
        }
        i = i + 1
    }
    return 0
}

fn enter_reset(build: u64) {
    if build != enter_build {
        enter_build = build
        enter_count = 0
    }
}

fn enter_add(node: usize, group: u64, kind: u64, index: u64) {
    if enter_count >= ENTER_MAX {
        return
    }
    enter_node[enter_count] = node
    enter_group[enter_count] = group
    enter_kind[enter_count] = kind
    enter_index[enter_count] = index
    enter_count = enter_count + 1
}

fn enter_apply(sc: *mut scene.Scene) -> bool {
    var running: bool = false
    let now: u64 = fuiapp.now_ms()
    var i: usize = 0
    while i < enter_count {
        let kind: u64 = enter_kind[i]
        let p: u64 = progress(group_started(enter_group[i]), now, kind, enter_index[i])
        scene.node_set_opacity(sc, enter_node[i], (p as f64) / 1000.0)
        let lift: f64 = (rise_px(kind) as f64) * ((FULL - p) as f64) / 1000.0
        scene.node_set_offset(sc, enter_node[i], 0.0, lift)
        if p < FULL {
            running = true
        }
        i = i + 1
    }
    return running
}
