profile kernel

const APP_MAX: u64 = 16

const AP_NAME: u64 = 8 // 16 octets

const AP_PID: u64 = 24 // the pid that answered for `a.<app>`; 0 = not yet

const AP_WIN: u64 = 64 // AB-008b: pool offset of `for window <glob>`, 0 = none

static mut n_apps: u64 = 0

const ACT_MAX: u64 = 64

const AC_NAME: u64 = 0 // 32 octets

const AC_APP: u64 = 32

const AC_LEVEL: u64 = 40

const AC_DESC: u64 = 48

const AC_FLAGS: u64 = 56

const AC_UNDO: u64 = 80 // pool offset of the inverse action's name

const AC_ADKIND: u64 = 96 // AB-008: AD_* below, 0 = a provider answers

const AC_ADCMD: u64 = 104 // pool offset of the adapter's rest of line

const FL_DRY: u64 = 1

const FL_KEYED: u64 = 4 // AB-005: arg `key` names a setting of the schema

const FL_PRIVATE: u64 = 8 // AB-015: an event only the user and the app hear

const FL_NOASK: u64 = 16

const AD_NONE: u64 = 0

const AD_CLI: u64 = 1

const AD_DBUS: u64 = 3

const AD_UI: u64 = 4

const AD_KEYS: u64 = 5

static mut n_acts: u64 = 0

static mut n_args: u64 = 0

const L_READ: u64 = 0

const L_WRITE: u64 = 1

const L_CRIT: u64 = 2

static mut pool_at: u64 = 1 // offset 0 is the empty string

// rights: rules from /etc/orientbus/policy and grants at run time
const RULE_MAX: u64 = 32

const RU_USED: u64 = 0

const RU_CLIENT: u64 = 8 // 24 octets

const RU_GLOB: u64 = 32 // 32 octets

const RU_DENY: u64 = 64

const RU_LEVEL: u64 = 72

const RU_UNTIL: u64 = 80 // tick, 0 = no end

const RU_PERM: u64 = 88 // AB-006: 1 = written in /etc/orientbus/policy

static mut last_rule: u64 = 0

// calls forwarded to a provider and not answered yet
const PEND_MAX: u64 = 8

const PE_USED: u64 = 0

const PE_NONCE: u64 = 8

const PE_PID: u64 = 16 // who gets the reply

const PE_ID: u64 = 24 // with which id

const PE_ACT: u64 = 32

const PE_FLAGS: u64 = 40

const PE_T0: u64 = 48

const PE_APP: u64 = 56

const PE_UID: u64 = 64

const PE_CLIENT: u64 = 72 // 24 octets

const PF_DRY: u64 = 1

const PF_UNDO: u64 = 2

const PF_PING: u64 = 4

// calls waiting for a confirmation
const TOK_MAX: u64 = 8

const TK_USED: u64 = 0

const TK_NO: u64 = 8

const TK_UID: u64 = 40

const TK_CLIENT: u64 = 48 // 24 octets: the RESOLVED client (AB-003)

const TK_PRINT: u64 = 72

const TOK_BYTES: u64 = 1024

// the undo stack
const UNDO_MAX: u64 = 16

const UN_USED: u64 = 0

const UN_SEQ: u64 = 8

const UN_ACT: u64 = 16

const UN_CLIENT: u64 = 24 // 24 octets

const UN_ARGS: u64 = 48 // 200 octets, "k=v\n" lines

// counters (`act stat`)
static mut c_calls: u64 = 0

static mut c_allow: u64 = 0

static mut c_ask: u64 = 0

static mut c_dup: u64 = 0

static mut c_deny: u64 = 0

static mut c_dry: u64 = 0

static mut c_logfail: u64 = 0

static mut c_manifests: u64 = 0

static mut c_rejected: u64 = 0

static mut lazy_t: u64 = 0 // when the oldest counted entry came, 0 = none

static mut audit_lazy: bool = false

static mut c_lazy: u64 = 0

static mut mf: [u8; 16384] = [0 as u8; 16384]

static mut s_user: [u8; 5] = "user\0"

// AB-003: WHO is calling, decided ONCE per request in `on_request` and
// used by every verb. The kernel's origin of the sender pid wins; only a
// process WITHOUT a label (the user's own, the system's) may name a
// client itself -- which can only narrow its rights ("--as jarvis").
static mut g_client: [u8; 24] = [0 as u8; 24]

// AB-005: the schema is loaded once at the start
static mut have_schema: bool = false

static mut g_rlevel: u64 = 0 // the level a keyed call is decided at

// AB-008: adapters run as this uid when the caller is root (policy line
// `adapter_uid <n>`); never as root
static mut adapter_uid: u64 = 65534

static mut c_adapt: u64 = 0

static mut adptr: [u64; 10] = [0 as u64; 10]

static mut s_logpath: [u8; 23] = "/var/log/orientbus.log\0"

// AB-012: ONE older generation. When the log passes `audit_max` octets
// (256 KiB; `auditmax <n>` in the policy) it becomes orientbus.log.1 --
// the one before that is dropped -- and a fresh log begins with a line
// that says so. The counts per client are seeded from both files.
static mut s_logold: [u8; 25] = "/var/log/orientbus.log.1\0"

static mut audit_max: u64 = 262144

static mut c_rotations: u64 = 0

const D_ALLOW: u64 = 0

const D_ASK: u64 = 1

const D_DENY: u64 = 2

static mut s_allow: [u8; 6] = "allow\0"

static mut s_ask: [u8; 4] = "ask\0"

static mut s_deny: [u8; 5] = "deny\0"

static mut c_keys: u64 = 0

const AJ_PID: u64 = 16 // who gets the answer

const AJ_ID: u64 = 24

const AJ_UID: u64 = 32

const AJ_UNDO: u64 = 56 // 1 = this is an undo

const AJ_LVL: u64 = 64

const AJ_CLIENT: u64 = 72 // 24 octets

static mut aj_n: u64 = 0

static mut g_started: bool = false

static mut g_slot: u64 = 0

static mut skip_tally: bool = false

const TA_REFUSED: u64 = 3

static mut c_dryfirst: u64 = 0

const TR_BYTES: u64 = 1024

static mut c_trusted: u64 = 0 // calls answered in the dialog
