
profile kernel

import ulib
import libc.regio

export { u_start }

const SYS_FTYPE: u64 = 1900
const SYS_FOPEN: u64 = 1901
const SYS_FLIST: u64 = 1902
const SYS_FREG: u64 = 1903

const R_USED: u64 = 0
const R_ACTION: u64 = 8
const R_MAGOFF: u64 = 16
const R_MAGLEN: u64 = 24
const R_MAGIC: u64 = 32
const R_EXT: u64 = 48
const R_PROG: u64 = 64
const R_LABEL: u64 = 112
const SLOT: u64 = 128

fn say(name: u64, value: u64) {
    var k: [u8; 6] = "k16: \0"
    var g: [u8; 4] = " = \0"
    ulib.say((&k[0]) as u64)
    ulib.say(name)
    ulib.say((&g[0]) as u64)
    ulib.sayn(value as u64)
    ulib.nl()
}

fn say_text(name: u64, value: u64) {
    var k: [u8; 6] = "k16: \0"
    var g: [u8; 4] = " = \0"
    ulib.say((&k[0]) as u64)
    ulib.say(name)
    ulib.say((&g[0]) as u64)
    ulib.say(value)
    ulib.nl()
}

fn say_i(name: u64, value: u64) {
    var k: [u8; 6] = "k16: \0"
    var g: [u8; 4] = " = \0"
    var m: [u8; 2] = "-\0"
    ulib.say((&k[0]) as u64)
    ulib.say(name)
    ulib.say((&g[0]) as u64)
    if ulib.bad(value) {
        ulib.say((&m[0]) as u64)
        ulib.sayn(0 -% value)
    } else {
        ulib.sayn(value)
    }
    ulib.nl()
}

fn u_start(args: u64) -> u64 {
    var satz: [u8; 128] = [0 as u8; 128]
    let rec: u64 = (&satz[0]) as u64

    if ulib.arg_count(args) >= 3 {
        var w_open: [u8; 5] = "open\0"
        if ulib.streq(ulib.arg_at(args, 1), (&w_open[0]) as u64) {
            var argv0: [u64; 2] = [0; 2]
            var n_op: [u8; 8] = "fopen\0\0\0"
            let pid: u64 = ulib.sys(SYS_FOPEN, ulib.arg_at(args, 2),
                (&argv0[0]) as u64, 0)
            say_i((&n_op[0]) as u64, pid)
            if !ulib.bad(pid) {
                var n_opc: [u8; 9] = "fopen_c\0\0"
                say((&n_opc[0]) as u64, ulib.wait_code(pid))
            }
            var f2: [u8; 12] = "k16: fertig\0"
            ulib.say((&f2[0]) as u64)
            ulib.nl()
            return 0
        }
    }

    // ------------------------------------------------ 1. die Einordnung
    var p_hello: [u8; 11] = "/bin/hello\0"
    var p_fi: [u8; 6] = "/p.fi\0"
    var p_txt: [u8; 7] = "/q.txt\0"
    var p_tarn: [u8; 9] = "/tarn.fi\0"
    var p_foreign: [u8; 11] = "/fremd.zzz\0"
    var p_s1: [u8; 7] = "/s1.sh\0"
    var p_r1: [u8; 7] = "/r1.sh\0"
    var p_gone: [u8; 12] = "/gibtsnicht\0"

    var n_elf: [u8; 9] = "art_elf\0\0"
    var n_fi: [u8; 7] = "art_fi\0"
    var n_txt: [u8; 8] = "art_txt\0"
    var n_tarn: [u8; 9] = "art_tarn\0"
    var n_foreign: [u8; 12] = "art_foreign\0"
    var n_gone: [u8; 9] = "art_gone\0"

    let a_elf: u64 = ulib.sys(SYS_FTYPE, (&p_hello[0]) as u64, rec, SLOT)
    say_i((&n_elf[0]) as u64, a_elf)
    var n_elf_l: [u8; 11] = "art_elf_l\0\0"
    say_text((&n_elf_l[0]) as u64, rec + R_LABEL)
    var n_elf_a: [u8; 11] = "art_elf_a\0\0"
    say((&n_elf_a[0]) as u64, regio.read64(rec + R_ACTION))
    var n_elf_m: [u8; 11] = "art_elf_m\0\0"
    say((&n_elf_m[0]) as u64, regio.read64(rec + R_MAGLEN))

    let a_fi: u64 = ulib.sys(SYS_FTYPE, (&p_fi[0]) as u64, rec, SLOT)
    say_i((&n_fi[0]) as u64, a_fi)
    var n_fi_l: [u8; 10] = "art_fi_l\0\0"
    say_text((&n_fi_l[0]) as u64, rec + R_LABEL)
    var n_fi_p: [u8; 10] = "art_fi_p\0\0"
    say_text((&n_fi_p[0]) as u64, rec + R_PROG)
    var n_fi_e: [u8; 10] = "art_fi_e\0\0"
    say_text((&n_fi_e[0]) as u64, rec + R_EXT)

    let a_txt: u64 = ulib.sys(SYS_FTYPE, (&p_txt[0]) as u64, rec, SLOT)
    say_i((&n_txt[0]) as u64, a_txt)
    var n_txt_p: [u8; 11] = "art_txt_p\0\0"
    say_text((&n_txt_p[0]) as u64, rec + R_PROG)

    let a_tarn: u64 = ulib.sys(SYS_FTYPE, (&p_tarn[0]) as u64, rec, SLOT)
    say_i((&n_tarn[0]) as u64, a_tarn)
    var n_tarn_l: [u8; 12] = "art_tarn_l\0\0"
    say_text((&n_tarn_l[0]) as u64, rec + R_LABEL)

    say_i((&n_foreign[0]) as u64,
        ulib.sys(SYS_FTYPE, (&p_foreign[0]) as u64, rec, SLOT))
    say_i((&n_gone[0]) as u64,
        ulib.sys(SYS_FTYPE, (&p_gone[0]) as u64, rec, SLOT))

    var n_tab: [u8; 9] = "tab_anz\0\0"
    var i: u64 = 0
    var anz: u64 = 0
    while i < 32 {
        if !ulib.bad(ulib.sys(SYS_FLIST, i, rec, SLOT)) {
            anz = anz + 1
        }
        i = i + 1
    }
    say((&n_tab[0]) as u64, anz)
    var n_tab_end: [u8; 9] = "tab_end\0\0"
    say_i((&n_tab_end[0]) as u64, ulib.sys(SYS_FLIST, 31, rec, SLOT))

    var k: u64 = 0
    while k < SLOT {
        satz[k as usize] = 0 as u8
        k = k + 1
    }
    var e_zzz: [u8; 5] = ".zzz\0"
    var p_cat: [u8; 9] = "/bin/cat\0"
    var l_zzz: [u8; 5] = "zzz\0\0"
    ulib.strcpy(rec + R_EXT, (&e_zzz[0]) as u64)
    ulib.strcpy(rec + R_PROG, (&p_cat[0]) as u64)
    ulib.strcpy(rec + R_LABEL, (&l_zzz[0]) as u64)
    regio.write64(rec + R_ACTION, 2) // A_OPEN
    regio.write64(rec + R_USED, 1)
    var n_reg: [u8; 8] = "reg_nr\0\0"
    say_i((&n_reg[0]) as u64, ulib.sys(SYS_FREG, rec, SLOT, 0))
    var n_reg2: [u8; 11] = "reg_danach\0"
    let a2: u64 = ulib.sys(SYS_FTYPE, (&p_foreign[0]) as u64, rec, SLOT)
    say_i((&n_reg2[0]) as u64, a2)
    var n_reg3: [u8; 11] = "reg_prog\0\0\0"
    say_text((&n_reg3[0]) as u64, rec + R_PROG)
    var n_reg4: [u8; 10] = "reg_short\0"
    say_i((&n_reg4[0]) as u64, ulib.sys(SYS_FREG, rec, 64, 0))

    // -------------------------------------------------- 4. `fopen`
    var argv: [u64; 4] = [0; 4]
    var n_op1: [u8; 9] = "open_elf\0"
    let pid1: u64 = ulib.sys(SYS_FOPEN, (&p_hello[0]) as u64,
        (&argv[0]) as u64, 0)
    // Wait first, report after -- /bin/hello shares the serial line
    // (same race as the #! case below).
    var c1: u64 = 0
    if !ulib.bad(pid1) {
        c1 = ulib.wait_code(pid1)
    }
    say_i((&n_op1[0]) as u64, pid1)
    if !ulib.bad(pid1) {
        var n_op1c: [u8; 11] = "open_elf_c\0"
        say((&n_op1c[0]) as u64, c1)
    }
    var n_op2: [u8; 13] = "open_foreign\0"
    say_i((&n_op2[0]) as u64, ulib.sys(SYS_FOPEN,
        (&p_gone[0]) as u64, (&argv[0]) as u64, 0))

    // -------------------------------------------------- 5. der Ausleger
    var n_sh: [u8; 9] = "shebang\0\0"
    let pid2: u64 = ulib.sys(ulib.SYS_EXEC, (&p_s1[0]) as u64,
        (&argv[0]) as u64, 0)
    var c2: u64 = 0
    if !ulib.bad(pid2) {
        c2 = ulib.wait_code(pid2)
    }
    say_i((&n_sh[0]) as u64, pid2)
    if !ulib.bad(pid2) {
        var n_shc: [u8; 10] = "shebang_c\0"
        say((&n_shc[0]) as u64, c2)
    }
    var n_loop: [u8; 13] = "shebang_ring\0"
    say_i((&n_loop[0]) as u64, ulib.sys(ulib.SYS_EXEC,
        (&p_r1[0]) as u64, (&argv[0]) as u64, 0))
    var n_kein: [u8; 14] = "kein_programm\0"
    say_i((&n_kein[0]) as u64, ulib.sys(ulib.SYS_EXEC,
        (&p_fi[0]) as u64, (&argv[0]) as u64, 0))

    var fertig: [u8; 12] = "k16: fertig\0"
    ulib.say((&fertig[0]) as u64)
    ulib.nl()
    return 0
}

