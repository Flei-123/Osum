profile kernel

import ulib
import actwire
import libc.clockapi
import xfxio
import xfxproc
import xrpath
import xrhost
import xrdefaults
import xrdisplay
import icons
import trayreg

export { u_start }

const POLL_MS: u64 = 2000
const RESTART_WAIT_MIN: u64 = 3
const RESTART_WAIT_MAX: u64 = 30
const HEALTHY_TICKS: u64 = 15
const SYS_NETGET: u64 = 1300
const NETGET_IP: u64 = 1
const SYS_OSUM_TIPP: u64 = 1843
const TI_REMOTE: u64 = 10
const REMOTE_OFF: u64 = 0
const REMOTE_AUTH: u64 = 1
const REMOTE_ADMIN: u64 = 2
const NETGET_GW: u64 = 3
static mut net_sig: u64 = 0
static mut net_down_seen: bool = false
static mut restart_wait: u64 = RESTART_WAIT_MIN
static mut run_ticks: u64 = 0
static mut W_NOSESSION: [u8; 10] = "nosession\0"
static mut F_ENABLED: [u8; 8] = "enabled\0"
static mut F_DISCONNECT: [u8; 11] = "disconnect\0"
static mut V_FALSE: [u8; 6] = "false\0"
static mut T_OWNER: [u8; 8] = "xremote\0"
static mut T_IDLE: [u8; 26] = "Remote control: no viewer\0"
static mut T_VIEWER: [u8; 33] = "Remote control: viewer connected\0"
static mut T_OFF: [u8; 20] = "Remote control: off\0"
static mut C_OPEN: [u8; 13] = "/bin/xremote\0"
static mut C_SETTINGS: [u8; 22] = "/bin/settings page=35\0"
static mut C_DISCONNECT_LABEL: [u8; 18] = "Disconnect viewer\0"
static mut C_DISCONNECT: [u8; 24] = "/bin/xremote disconnect\0"
static mut C_STOP_LABEL: [u8; 13] = "Stop service\0"
static mut C_STOP: [u8; 17] = "/bin/xremote off\0"
static mut C_START_LABEL: [u8; 14] = "Start service\0"
static mut C_START: [u8; 16] = "/bin/xremote on\0"
static mut C_NONE: [u8; 1] = "\0"
static mut tray_sig: u64 = 99
static mut F_ADMIN: [u8; 6] = "admin\0"
static mut F_FIXED: [u8; 6] = "fixed\0"
static mut MODE_FIXED: [u8; 6] = "fixed\0"
static mut MODE_RANDOM: [u8; 7] = "random\0"
static mut F_RELAY: [u8; 6] = "relay\0"
static mut V_ONE: [u8; 2] = "1\0"
static mut V_TRUE: [u8; 5] = "true\0"
static mut S_IDLE: [u8; 5] = "idle\0"
static mut S_DISABLED: [u8; 9] = "disabled\0"
static mut S_MISSING: [u8; 16] = "package-missing\0"
static mut S_NOSESSION: [u8; 11] = "no-session\0"
static mut S_RUNNING: [u8; 8] = "running\0"
static mut S_RESTART: [u8; 11] = "restarting\0"
static mut M_UP: [u8; 18] = "xremoted: started\0"
static mut M_HOST: [u8; 23] = "xremoted: host started\0"
static mut M_STOP: [u8; 23] = "xremoted: host stopped\0"
static mut M_NETCHG: [u8; 41] = "xremoted: network changed, host restarts\0"
static mut M_FAIL: [u8; 28] = "xremoted: host start failed\0"
static mut M_PW: [u8; 43] = "xremoted: no random bytes for the password\0"
static mut password: [u8; 40] = [0 as u8; 40]
static mut fixed_mode: bool = false
static mut relay: [u8; 200] = [0 as u8; 200]
static mut state_word: u64 = 0
static mut need_session: bool = true
static mut remote_pid: u64 = 0
static mut remote_mode: u64 = REMOTE_OFF

fn flag_set(field: u64) -> bool {
    var v: [u8; 8] = [0 as u8; 8]
    if !actwire.kvfile_get(xrpath.p_conf(), field, (&v[0 as usize]) as u64, 8) {
        return false
    }
    return ulib.streq((&v[0 as usize]) as u64, (&V_ONE[0 as usize]) as u64) || ulib.streq((&v[0 as usize]) as u64, (&V_TRUE[0 as usize]) as u64)
}

fn is_enabled() -> bool {
    return flag_set((&F_ENABLED[0 as usize]) as u64)
}

fn fixed_wanted(out: u64) -> bool {
    xrhost.secure_secret()
    return flag_set((&F_FIXED[0 as usize]) as u64) && xrhost.read_fixed(out)
}

fn fixed_changed() -> bool {
    var cand: [u8; 40] = [0 as u8; 40]
    let want: bool = fixed_wanted((&cand[0 as usize]) as u64)
    if want != fixed_mode {
        return true
    }
    return want && !ulib.streq((&cand[0 as usize]) as u64, (&password[0 as usize]) as u64)
}

fn mode_word() -> u64 {
    if fixed_mode {
        return (&MODE_FIXED[0 as usize]) as u64
    }
    return (&MODE_RANDOM[0 as usize]) as u64
}

fn net_changed() -> bool {
    let ip: u64 = ulib.sys(SYS_NETGET, NETGET_IP, 0, 0)
    if ip == 0 {
        net_down_seen = true
        return false
    }
    let sig: u64 = (ip << 32) ^ ulib.sys(SYS_NETGET, NETGET_GW, 0, 0)
    let changed: bool = net_down_seen || (net_sig != 0 && sig != net_sig)
    net_down_seen = false
    net_sig = sig
    return changed
}

fn session_ok() -> bool {
    if !need_session {
        return true
    }
    return xfxproc.any_named(xrpath.n_taskbar())
}

fn publish(word: u64) {
    if state_word != word {
        state_word = word
        xrhost.write_info((&password[0 as usize]) as u64, word, mode_word())
    }
}

fn stop_all() {
    if xrhost.host_running() {
        xfxio.msg((&M_STOP[0 as usize]) as u64)
    }
    if password[0 as usize] != 0 as u8 || xrhost.host_running() {
        xrhost.stop_host()
        password[0 as usize] = 0 as u8
        fixed_mode = false
        state_word = 0
    }
}

fn start_host() -> bool {
    xrhost.migrate_home()
    if password[0 as usize] == 0 as u8 {
        var cand: [u8; 40] = [0 as u8; 40]
        if fixed_wanted((&cand[0 as usize]) as u64) {
            ulib.strcpy((&password[0 as usize]) as u64, (&cand[0 as usize]) as u64)
            fixed_mode = true
        } else if !xrhost.make_password((&password[0 as usize]) as u64) {
            xfxio.msg((&M_PW[0 as usize]) as u64)
            return false
        }
        state_word = 0
    }
    xrhost.write_pw((&password[0 as usize]) as u64)
    actwire.kvfile_get(xrpath.p_conf(), (&F_RELAY[0 as usize]) as u64, (&relay[0 as usize]) as u64, 200)
    if !xrhost.spawn_host((&relay[0 as usize]) as u64) {
        xfxio.msg((&M_FAIL[0 as usize]) as u64)
        return false
    }
    xfxio.msg((&M_HOST[0 as usize]) as u64)
    return true
}

fn step(wait: u64) -> u64 {
    let enabled: bool = is_enabled()
    if !enabled {
        stop_all()
        return 0
    }
    if !xrhost.package_ready() {
        stop_all()
        return 0
    }
    if !session_ok() {
        stop_all()
        return 0
    }
    if password[0 as usize] != 0 as u8 && fixed_changed() {
        stop_all()
        return 0
    }
    if net_changed() && xrhost.host_running() {
        xfxio.msg((&M_NETCHG[0 as usize]) as u64)
        xrhost.stop_host()
        restart_wait = RESTART_WAIT_MIN
        return 0
    }
    if xrhost.host_running() {
        publish((&S_RUNNING[0 as usize]) as u64)
        xrhost.sync_identity()
        run_ticks = run_ticks + 1
        if run_ticks >= HEALTHY_TICKS {
            restart_wait = RESTART_WAIT_MIN
        }
        return 0
    }
    if wait > 0 {
        publish((&S_RESTART[0 as usize]) as u64)
        return wait - 1
    }
    if start_host() {
        publish((&S_RUNNING[0 as usize]) as u64)
    }
    run_ticks = 0
    let next: u64 = restart_wait
    restart_wait = restart_wait * 2
    if restart_wait > RESTART_WAIT_MAX {
        restart_wait = RESTART_WAIT_MAX
    }
    return next
}

fn wanted_remote_mode() -> u64 {
    if !xrhost.host_running() || !xrhost.peer_connected() {
        return REMOTE_OFF
    }
    if flag_set((&F_ADMIN[0 as usize]) as u64) {
        return REMOTE_ADMIN
    }
    return REMOTE_AUTH
}

fn sync_remote_auth() {
    let pid: u64 = xrhost.host_pid_now()
    let mode: u64 = wanted_remote_mode()
    if pid == remote_pid && mode == remote_mode {
        return
    }
    remote_pid = pid
    remote_mode = mode
    ulib.sys(SYS_OSUM_TIPP, TI_REMOTE, pid, mode)
}

fn display_peer_ok() -> bool {
    return !xrhost.host_running() || xrhost.peer_connected()
}

fn status_idle() {
    if !is_enabled() {
        publish((&S_DISABLED[0 as usize]) as u64)
    } else if !xrhost.package_ready() {
        publish((&S_MISSING[0 as usize]) as u64)
    } else if !session_ok() {
        publish((&S_NOSESSION[0 as usize]) as u64)
    }
}

fn tray_state() -> u64 {
    if !is_enabled() {
        return 0
    }
    if xrhost.host_running() && xrhost.peer_connected() {
        return 2
    }
    return 1
}

fn tray_publish() {
    let st: u64 = tray_state()
    if st == tray_sig {
        return
    }
    trayreg.begin((&T_OWNER[0 as usize]) as u64)
    if st == 2 {
        trayreg.put_num(icons.EYE)
        trayreg.put((&T_VIEWER[0 as usize]) as u64)
    } else if st == 1 {
        trayreg.put_num(icons.SETTINGS_DISPLAY)
        trayreg.put((&T_IDLE[0 as usize]) as u64)
    } else {
        trayreg.put_num(icons.EYE_OFF)
        trayreg.put((&T_OFF[0 as usize]) as u64)
    }
    trayreg.put((&C_OPEN[0 as usize]) as u64)
    trayreg.put((&C_SETTINGS[0 as usize]) as u64)
    trayreg.put((&C_NONE[0 as usize]) as u64)
    trayreg.put((&C_DISCONNECT_LABEL[0 as usize]) as u64)
    trayreg.put((&C_DISCONNECT[0 as usize]) as u64)
    if st == 0 {
        trayreg.put((&C_START_LABEL[0 as usize]) as u64)
        trayreg.put((&C_START[0 as usize]) as u64)
    } else {
        trayreg.put((&C_STOP_LABEL[0 as usize]) as u64)
        trayreg.put((&C_STOP[0 as usize]) as u64)
    }
    if trayreg.commit() {
        tray_sig = st
    }
}

fn drop_viewer_on_request() {
    if !flag_set((&F_DISCONNECT[0 as usize]) as u64) {
        return
    }
    let _s: bool = actwire.kvfile_set(xrpath.p_conf(), (&F_DISCONNECT[0 as usize]) as u64, (&V_FALSE[0 as usize]) as u64)
    if xrhost.host_running() {
        xrhost.stop_host()
    }
}

fn u_start(args: u64) -> u64 {
    if !xfxio.is_root() {
        return 1
    }
    if ulib.arg_count(args) > 1 && ulib.streq(ulib.arg_at(args, 1), (&W_NOSESSION[0 as usize]) as u64) {
        need_session = false
    }
    xfxio.msg((&M_UP[0 as usize]) as u64)
    xrdefaults.seed()
    var wait: u64 = 0
    while true {
        drop_viewer_on_request()
        wait = step(wait)
        sync_remote_auth()
        tray_publish()
        xrdisplay.tick(display_peer_ok())
        if !xrhost.host_running() {
            status_idle()
        }
        clockapi.sleep_ms(POLL_MS)
    }
    return 0
}
