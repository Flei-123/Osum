field pw-again secret settings.password.again
field pw-set action settings.password.set

page pin settings.page.accounts-pin.title symbol-pin accounts
column left
field pin-old secret settings.pin.old
field pin-new secret settings.pin.label
field pin-set action settings.pin.set
field pin-remove action settings.pin.remove

page language settings.page.time-language.title symbol-language time
column left
field lang-ui choice settings.language.label
field lang-kbd choice settings.keyboard.label
label settings.language.note1
label settings.language.note2
field lang-apply action settings.apply

page wifi settings.page.network-wifi.title symbol-wifi network
column left
field wifi-status status
field wifi-ssid text settings.wifi.ssid
field wifi-pass secret settings.wifi.pass
field wifi-scan action settings.wifi.scan
field wifi-connect action settings.wifi.conn

page presets settings.page.personalization.title symbol-themes personal
column left
