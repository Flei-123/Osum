# SETTINGS manifest of the built-in page "Accounts" (Settings -> Konten), r136.
# Format and rules: lib/settingsman/manifest.fi and docs/SETTINGS-MANIFEST.md.
# Embedded into /bin/settings at build time (__include_str); a package ships the same file as /apps/<app>.prog/SETTINGS.
# Labels are message catalogue keys (locale/<lang>/messages). A field key is bound to its control by the Settings app
# (the "adapter" of this page: fn acct_bind in kernel/user/settings.fi).
manifest 1
app settings

page accounts konto.ui.heading person accounts
column left
label konto.ui.heading
field provider choice konto.ui.provider
field target text konto.ui.target
field certname text konto.ui.certname
field login text konto.ui.login
field mfa text konto.ui.mfa
note konto.ui.optional 2
field add action konto.ui.add
field device action konto.ui.devlogin
field book action konto.ui.book
column right
field accounts list konto.ui.accounts
field signout action konto.ui.signout
field status status
field bookline status
field password secret konto.ui.password
field tenant text konto.ui.tenant

page network settings.net.note network network
column left
field state status
field rate status
field down status
field up status
field sum status
field ping status
sep
field ip status
field mask status
field gw status
field mac status
field mode choice settings.address.label
field addrhead status
field addr-ip text
field addr-mask text
field addr-gw text
label settings.net.note
field apply action settings.apply
field confirm action settings.bus.confirm

page display settings.display.res.note1 display display
column left
field screen status
field card status
label settings.display.res.note1
label settings.display.res.note2
field modes list
field scale choice settings.display.scale.label
field rotate choice settings.display.rotate.label
field bright choice settings.display.bright.label
column right
field depth status
field apply action settings.apply
field grace status
field keep action settings.display.keep
field revert action settings.display.revert
field reason status
field saved status

page display2 settings.display.adv.hint display display
column left
note settings.display.adv.hint 3
field bright2 choice settings.display.bright.label
field gamma choice settings.display.gamma.label
field sat choice
column right
label settings.display.cust.label
row
field cw text
field ch text
field ct text
endrow
row
field cset action settings.display.cust.set
field ccheck action settings.display.cust.check
endrow
field reason2 status
field saved2 status
