
profile kernel

import deflate.huffdec

export {
    crc32, crc32_fort, deflate, store, inflate, MAXBITS,
    stream_start, stream_block, stream_end, stream_pos, stream_clear,
    E_OK, E_INPUT, E_ROOM, E_FORMAT
}

const MAXBITS: u64 = 15
const E_OK: u64 = 0
const E_INPUT: u64 = 1
const E_ROOM: u64 = 2
const E_FORMAT: u64 = 3

const M32: u64 = 0xFFFFFFFF

fn crc32(p: u64, n: u64) -> u64 {
    var crc: u64 = M32
    var i: u64 = 0
    while i < n {
        crc = crc ^ ((*((p + i) as *mut u8)) as u64)
        var k: u64 = 0
        while k < 8 {
            let mask: u64 = 0 -% (crc & 1)
            crc = (crc >> 1) ^ (0xEDB88320 & mask)
            k = k + 1
        }
        i = i + 1
    }
    return (crc ^ M32) & M32
}

fn crc32_fort(stand: u64, p: u64, n: u64) -> u64 {
    var crc: u64 = (stand ^ M32) & M32
    var i: u64 = 0
    while i < n {
        crc = crc ^ ((*((p + i) as *mut u8)) as u64)
        var k: u64 = 0
        while k < 8 {
            let mask: u64 = 0 -% (crc & 1)
            crc = (crc >> 1) ^ (0xEDB88320 & mask)
            k = k + 1
        }
        i = i + 1
    }
    return (crc ^ M32) & M32
}

static mut dst: u64 = 0
static mut dpos: u64 = 0
static mut dend: u64 = 0

fn emit(c: u64) {
    if dpos >= dend {
        huffdec.fail(E_ROOM)
        return
    }
    __mmio_write8((dst + dpos) as *mut u8, c as u8)
    dpos = dpos + 1
}

fn block_body() -> bool {
    var going: bool = true
    while going {
        let s: u64 = huffdec.symbol()
        if s == huffdec.EOF {
            return false
        }
        if s < 256 {
            emit(s)
            if huffdec.failed() {
                return false
            }
        } else if s == 256 {
            going = false
        } else {
            let len: u64 = huffdec.length_of(s)
            if len == 0 {
                return false
            }
            let dist: u64 = huffdec.dist()
            if dist == 0 {
                return false
            }
            if dist > dpos {
                huffdec.fail(E_FORMAT)
                return false
            }
            var k: u64 = 0
            while k < len {
                emit((*((dst + dpos - dist) as *mut u8)) as u64)
                if huffdec.failed() {
                    return false
                }
                k = k + 1
            }
        }
    }
    return true
}

fn inflate(in_p: u64, in_n: u64, out_p: u64, out_cap: u64,
    out_len: u64) -> u64 {
    huffdec.begin_mem(in_p, in_n)
    dst = out_p
    dpos = 0
    dend = out_cap
    var last: u64 = 0
    while last == 0 && huffdec.ok() {
        last = huffdec.bits(1)
        let kind: u64 = huffdec.bits(2)
        if huffdec.failed() {
            last = 1
        } else if kind == 0 {
            huffdec.align()
            if huffdec.avail() < 4 {
                huffdec.fail(E_INPUT)
            } else {
                let len: u64 = huffdec.getbyte() | (huffdec.getbyte() << 8)
                let nlen: u64 = huffdec.getbyte() | (huffdec.getbyte() << 8)
                if (len ^ 0xFFFF) != nlen {
                    huffdec.fail(E_FORMAT)
                } else if huffdec.avail() < len {
                    huffdec.fail(E_INPUT)
                } else {
                    var i: u64 = 0
                    while i < len && huffdec.ok() {
                        emit(huffdec.getbyte())
                        i = i + 1
                    }
                }
            }
        } else if kind == 1 {
            huffdec.fixed_trees()
            block_body()
        } else if kind == 2 {
            if huffdec.dynamic_trees() {
                block_body()
            }
        } else {
            huffdec.fail(E_FORMAT)
        }
    }
    __mmio_write64((out_len) as *mut u64, dpos)
    return huffdec.status()
}

fn store(in_p: u64, in_n: u64, out_p: u64, out_cap: u64,
    out_len: u64) -> u64 {
    dst = out_p
    dpos = 0
    dend = out_cap
    huffdec.fail(E_OK)
    var at: u64 = 0
    var going: bool = true
    while going && huffdec.ok() {
        var len: u64 = in_n - at
        if len > 65535 {
            len = 65535
        }
        var last: u64 = 0
        if at + len >= in_n {
            last = 1
            going = false
        }
        emit(last)
        emit(len & 255)
        emit((len >> 8) & 255)
        emit((len ^ 0xFFFF) & 255)
        emit(((len ^ 0xFFFF) >> 8) & 255)
        var i: u64 = 0
        while i < len && huffdec.ok() {
            emit((*((in_p + at + i) as *mut u8)) as u64)
            i = i + 1
        }
        at = at + len
    }
    __mmio_write64((out_len) as *mut u64, dpos)
    return huffdec.status()
}

const WSIZE: u64 = 4096
const PREVN: u64 = 16384
const PREVM: u64 = 16383
const MAXDIST: u64 = 16384
const CHAIN: u64 = 32

static mut head: [u64; 4096] = [0 as u64; 4096]
static mut prev: [u64; 16384] = [0 as u64; 16384]
static mut wbuf: u64 = 0
static mut wcnt: u64 = 0

fn put_bits(v: u64, n: u64) {
    wbuf = wbuf | ((v & ((1 << n) - 1)) << wcnt)
    wcnt = wcnt + n
    while wcnt >= 8 {
        emit(wbuf & 255)
        wbuf = wbuf >> 8
        wcnt = wcnt - 8
    }
}

fn put_code(code: u64, n: u64) {
    var i: u64 = n
    while i > 0 {
        i = i - 1
        put_bits((code >> i) & 1, 1)
    }
}

fn put_literal(c: u64) {
    if c < 144 {
        put_code(0x30 + c, 8)
    } else {
        put_code(0x190 + (c - 144), 9)
    }
}

fn put_length(len: u64) {
    var i: u64 = 28
    while i > 0 && huffdec.len_base(i) > len {
        i = i - 1
    }
    let sym: u64 = 257 + i
    if sym < 280 {
        put_code(sym - 256, 7)
    } else {
        put_code(0xC0 + (sym - 280), 8)
    }
    if huffdec.len_extra(i) > 0 {
        put_bits(len - huffdec.len_base(i), huffdec.len_extra(i))
    }
}

fn put_dist(d: u64) {
    var i: u64 = 29
    while i > 0 && huffdec.dist_base(i) > d {
        i = i - 1
    }
    put_code(i, 5)
    if huffdec.dist_extra(i) > 0 {
        put_bits(d - huffdec.dist_base(i), huffdec.dist_extra(i))
    }
}

fn hash3(p: u64, at: u64) -> u64 {
    let a: u64 = (*((p + at) as *mut u8)) as u64
    let b: u64 = (*((p + at + 1) as *mut u8)) as u64
    let c: u64 = (*((p + at + 2) as *mut u8)) as u64
    return ((a << 10) ^ (b << 5) ^ c) & (WSIZE - 1)
}

fn deflate(in_p: u64, in_n: u64, out_p: u64, out_cap: u64,
    out_len: u64) -> u64 {
    stream_start(out_p, out_cap)
    let r: u64 = stream_block(in_p, in_n, true)
    if r != E_OK {
        return r
    }
    return stream_end(out_len)
}
fn stream_start(out_p: u64, out_cap: u64) {
    huffdec.setup()
    dst = out_p
    dpos = 0
    dend = out_cap
    wbuf = 0
    wcnt = 0
    huffdec.fail(E_OK)
}

fn stream_pos() -> u64 {
    return dpos
}

fn stream_clear() {
    dpos = 0
}

fn stream_block(in_p: u64, in_n: u64, letzt: bool) -> u64 {
    var f: u64 = 0
    if letzt {
        f = 1
    }
    var i: u64 = 0
    while i < WSIZE {
        head[(i) as usize] = 0
        i = i + 1
    }
    i = 0
    while i < PREVN {
        prev[(i) as usize] = 0
        i = i + 1
    }
    put_bits(f, 1)
    put_bits(1, 2)
    var at: u64 = 0
    while at < in_n && huffdec.ok() {
        var best: u64 = 0
        var bestd: u64 = 0
        if at + 3 <= in_n {
            let h: u64 = hash3(in_p, at)
            var cand: u64 = head[(h) as usize]
            var tries: u64 = 0
            while cand != 0 && tries < CHAIN {
                let pos: u64 = cand - 1
                let d: u64 = at - pos
                if d > MAXDIST || d == 0 {
                    cand = 0
                } else {
                    var l: u64 = 0
                    while l < 258 && at + l < in_n
                    && *((in_p + pos + l) as *mut u8)
                        == *((in_p + at + l) as *mut u8) {
                        l = l + 1
                    }
                    if l > best {
                        best = l
                        bestd = d
                    }
                    cand = prev[(pos & PREVM) as usize]
                    tries = tries + 1
                }
            }
            prev[(at & PREVM) as usize] = head[(h) as usize]
            head[(h) as usize] = at + 1
        }
        if best >= 3 {
            put_length(best)
            put_dist(bestd)
            var k: u64 = 1
            while k < best {
                if at + k + 3 <= in_n {
                    let h2: u64 = hash3(in_p, at + k)
                    prev[((at + k) & PREVM) as usize] = head[(h2) as usize]
                    head[(h2) as usize] = at + k + 1
                }
                k = k + 1
            }
            at = at + best
        } else {
            put_literal((*((in_p + at) as *mut u8)) as u64)
            at = at + 1
        }
    }
    put_code(0, 7)
    return huffdec.status()
}

fn stream_end(out_len: u64) -> u64 {
    if wcnt > 0 {
        emit(wbuf & 255)
        wbuf = 0
        wcnt = 0
    }
    __mmio_write64((out_len) as *mut u64, dpos)
    return huffdec.status()
}
