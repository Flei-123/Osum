profile kernel

import ulib
import actwire
import xfxio
import xrpath

export { seed }

const VALUE_CAP: u64 = 40
const MODE_PRIVATE: u64 = 384
const SYS_CHMOD: u64 = 90

static mut P_DEFAULTS: [u8; 27] = "/apps/xremote.osp/DEFAULTS\0"
static mut F_ENABLED: [u8; 8] = "enabled\0"
static mut F_FIXED: [u8; 6] = "fixed\0"
static mut F_PASSWORD: [u8; 9] = "password\0"
static mut K_ENABLED: [u8; 9] = "enabled=\0"
static mut K_FIXED: [u8; 7] = "fixed=\0"
static mut K_PASSWORD: [u8; 10] = "password=\0"
static mut NL: [u8; 2] = "\n\0"
static mut M_SEEDED: [u8; 34] = "xremoted: seeded package defaults\0"

fn line(out: u64, key: u64, value: u64) {
    ulib.strcat(out, key)
    ulib.strcat(out, value)
    ulib.strcat(out, (&NL[0 as usize]) as u64)
}

fn write_secret(password: u64) -> bool {
    var b: [u8; 160] = [0 as u8; 160]
    let p: u64 = (&b[0 as usize]) as u64
    line(p, (&K_PASSWORD[0 as usize]) as u64, password)
    let ok: bool = xfxio.write_text(xrpath.p_secret(), p, ulib.O_MAKE)
    ulib.sys(SYS_CHMOD, xrpath.p_secret(), MODE_PRIVATE, 0)
    return ok
}

fn write_conf(enabled: u64, fixed: u64) -> bool {
    var b: [u8; 160] = [0 as u8; 160]
    let p: u64 = (&b[0 as usize]) as u64
    line(p, (&K_ENABLED[0 as usize]) as u64, enabled)
    line(p, (&K_FIXED[0 as usize]) as u64, fixed)
    return xfxio.write_text(xrpath.p_conf(), p, ulib.O_MAKE)
}

fn seed() {
    if xfxio.exists(xrpath.p_conf()) || !xfxio.exists((&P_DEFAULTS[0 as usize]) as u64) {
        return
    }
    var enabled: [u8; 40] = [0 as u8; 40]
    var fixed: [u8; 40] = [0 as u8; 40]
    var password: [u8; 40] = [0 as u8; 40]
    let d: u64 = (&P_DEFAULTS[0 as usize]) as u64
    let _e: bool = actwire.kvfile_get(d, (&F_ENABLED[0 as usize]) as u64, (&enabled[0 as usize]) as u64, VALUE_CAP)
    let _f: bool = actwire.kvfile_get(d, (&F_FIXED[0 as usize]) as u64, (&fixed[0 as usize]) as u64, VALUE_CAP)
    let has_pw: bool = actwire.kvfile_get(d, (&F_PASSWORD[0 as usize]) as u64, (&password[0 as usize]) as u64, VALUE_CAP)
    if has_pw && !write_secret((&password[0 as usize]) as u64) {
        return
    }
    if write_conf((&enabled[0 as usize]) as u64, (&fixed[0 as usize]) as u64) {
        xfxio.msg((&M_SEEDED[0 as usize]) as u64)
    }
}
