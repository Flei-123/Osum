profile kernel

import ulib
import touchev.api
import touchev.record

export { u_start }

const SNAP_MAX: u64 = 3088

static mut snap: [u8; 3088] = [0 as u8; 3088]

fn field(name: u64, v: u64) {
    ulib.say(name)
    ulib.sayu(v)
}

fn print_event() {
    var h_ev: [u8; 17] = "touchdemo: ev t=\0"
    var s_sl: [u8; 7] = " slot=\0"
    var s_dv: [u8; 6] = " dev=\0"
    var s_fl: [u8; 5] = " fl=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_px: [u8; 5] = " px=\0"
    var s_py: [u8; 5] = " py=\0"
    var s_p: [u8; 4] = " p=\0"
    var s_a: [u8; 4] = " a=\0"
    var s_b: [u8; 4] = " b=\0"
    ulib.say((&h_ev[0]) as u64)
    ulib.sayu(api.ev_type())
    field((&s_sl[0]) as u64, api.ev_slot())
    field((&s_dv[0]) as u64, api.ev_device())
    field((&s_fl[0]) as u64, api.ev_flags())
    field((&s_x[0]) as u64, api.ev_x())
    field((&s_y[0]) as u64, api.ev_y())
    field((&s_px[0]) as u64, api.ev_x_px())
    field((&s_py[0]) as u64, api.ev_y_px())
    field((&s_p[0]) as u64, api.ev_pressure())
    ulib.say((&s_a[0]) as u64)
    ulib.sayn(api.ev_a() as u64)
    ulib.say((&s_b[0]) as u64)
    ulib.sayn(api.ev_b() as u64)
    ulib.nl()
}

fn u_start(args: u64) -> u64 {
    var path: [u8; 14] = "/proc/touchev\0"
    var s_no: [u8; 28] = "touchdemo: cannot open ring\0"
    var s_bad: [u8; 25] = "touchdemo: bad snapshot\0\0"
    var s_sum: [u8; 19] = "touchdemo: events=\0"
    var s_drop: [u8; 10] = " dropped=\0"
    var s_gest: [u8; 11] = " gestures=\0"
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&path[0]) as u64, 0, 0)
    if ulib.failed(fd) {
        ulib.say((&s_no[0]) as u64)
        ulib.nl()
        return 1
    }
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&snap[0]) as u64, SNAP_MAX)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if !api.open() || ulib.failed(n) || !api.refill_from((&snap[0]) as u64, n) {
        ulib.say((&s_bad[0]) as u64)
        ulib.nl()
        return 1
    }
    var events: u64 = 0
    var gestures: u64 = 0
    while api.poll() {
        print_event()
        events = events + 1
        if api.ev_type() == record.T_GESTURE {
            gestures = gestures + 1
        }
    }
    ulib.say((&s_sum[0]) as u64)
    ulib.sayu(events)
    ulib.say((&s_drop[0]) as u64)
    ulib.sayu(api.dropped())
    ulib.say((&s_gest[0]) as u64)
    ulib.sayu(gestures)
    ulib.nl()
    api.close()
    return 0
}
