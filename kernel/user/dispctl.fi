// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/dispctl.fi -- Runde DISPLAY: /bin/dispctl, aus Ring 3.
//
// WOZU DAS NEBEN DEM EINSTELLUNGEN-PROGRAMM. Das Bedienfeld ist eine
// Oberflaeche; was es tut, ist von aussen nur an Bildpunkten zu sehen.
// Dieses Programm tut dasselbe ueber dieselben drei Aufrufe, meldet aber
// JEDE Zahl als Zeile auf der seriellen Leitung -- und `tools/display/
// run.sh` haelt sie gegen die Zahlen, die der KERNEL ueber sich selbst
// gemeldet hat. Zwei Wege, eine Wahrheit; laufen sie auseinander,
// stimmt die Naht zwischen Ring 0 und Ring 3 nicht.
//
//     dispctl              alles anzeigen
//     dispctl raw          jede Zahl einzeln, fuer den Testlauf
//     dispctl modes        nur die Modusliste
//     dispctl set W H      auf W x H aus der Liste wechseln
//     dispctl eigen W H [T]  eine EIGENE Aufloesung einstellen
//     dispctl pruefen W H [T] nur pruefen, ohne umzuschalten
//     dispctl speichern    den laufenden Modus auf die Platte
//     dispctl testc        die Zusagen der Runde CUSTOMRES
//     dispctl rot GRAD     0, 90, 180 oder 270
//     dispctl gamma N      30..300 (100 = 1,00)
//     dispctl hell N       0..200
//     dispctl kontrast N   0..200
//     dispctl saettigung N 0..200
//     dispctl skal N       0 Vollbild, 1 Seitenverhaeltnis, 2 keine
//     dispctl behalten     die Bestaetigungsfrage bejahen
//     dispctl zurueck      auf den alten Modus zurueck
//     dispctl test         die Zusagen dieser Runde aus Ring 3
//
// KEINE ZAHL IN DIESEM PROGRAMM IST VON DIESEM PROGRAMM -- dieselbe
// Regel wie in /bin/power. Was der Kernel nicht wirklich gelesen hat,
// meldet er als Fehler, und dann steht hier ein Strich und keine Null.

profile kernel

import ulib

export { u_start }

const SYS_DISPGET: u64 = 1810
const SYS_DISPSET: u64 = 1811
const SYS_DISPSTR: u64 = 1812

const DG_READY: u64 = 0
const DG_COUNT: u64 = 1
const DG_VRAM: u64 = 2
const DG_DEPTHS: u64 = 3
const DG_MAPLIMIT: u64 = 4
const DG_EDIDOK: u64 = 5
const DG_EDIDWHY: u64 = 6
const DG_NATW: u64 = 7
const DG_NATH: u64 = 8
const DG_CUR: u64 = 9
const DG_PANELW: u64 = 10
const DG_PANELH: u64 = 11
const DG_IMGW: u64 = 12
const DG_IMGH: u64 = 13
const DG_ROT: u64 = 14
const DG_SCALE: u64 = 15
const DG_BRIGHT: u64 = 16
const DG_CONTRAST: u64 = 17
const DG_GAMMA: u64 = 18
const DG_SAT: u64 = 19
const DG_PENDING: u64 = 20
const DG_REMAIN: u64 = 21
const DG_SWITCHES: u64 = 22
const DG_FAILS: u64 = 23
const DG_REVERTS: u64 = 24
const DG_CONFIRMS: u64 = 25
const DG_PRESENTS: u64 = 26
const DG_PROBED: u64 = 27
const DG_REFUSED: u64 = 28
const DG_TOOBIG: u64 = 29
const DG_PITCH: u64 = 30
const DG_BPP: u64 = 31
// RUNDE CUSTOMRES
const DG_CUSTWHY: u64 = 33
const DG_CUSTNUM: u64 = 34
const DG_CUSTOMS: u64 = 35
const DG_MINW: u64 = 36
const DG_MINH: u64 = 37
const DG_MAXW: u64 = 38
const DG_MAXH: u64 = 39
const DG_SAVEOK: u64 = 40
const DG_SAVEW: u64 = 41
const DG_SAVEH: u64 = 42
const DG_SAVEB: u64 = 43
const DG_SAVETRY: u64 = 44
const DG_SAVEWHY: u64 = 45
const DG_SAVEAPP: u64 = 46
const DG_MODE: u64 = 1000

const DS_MODE: u64 = 0
const DS_ROT: u64 = 1
const DS_SCALE: u64 = 2
const DS_BRIGHT: u64 = 3
const DS_CONTRAST: u64 = 4
const DS_GAMMA: u64 = 5
const DS_SAT: u64 = 6
const DS_CONFIRM: u64 = 7
const DS_REVERT: u64 = 8
const DS_CUSTOM: u64 = 11
const DS_CHECK: u64 = 12
const DS_SAVE: u64 = 13

// Die Gruende, die der Kernel fuer eine abgelehnte eigene Aufloesung
// nennt (`vmode.CW_*`). Sie stehen hier ein zweites Mal, weil dieses
// Programm in Ring 3 laeuft und den Kernel nicht einbindet -- dieselbe
// benannte Doppelung wie bei den Aufrufnummern, und
// tools/customres/run.sh rechnet beide Listen gegeneinander.
const CW_OK: u64 = 0
const CW_REGS: u64 = 1
const CW_VRAM: u64 = 2
const CW_LIMIT: u64 = 3
const CW_DEPTH: u64 = 4
const CW_UNSINN: u64 = 5
const CW_NOCARD: u64 = 6

fn dget(f: u64) -> u64 {
    return ulib.sys(SYS_DISPGET, f, 0, 0)
}

fn dset(f: u64, v: u64) -> u64 {
    return ulib.sys(SYS_DISPSET, f, v, 0)
}

// "dispctl: name=zahl" -- eine Zeile, die ein Testlaeufer mit einem
// Muster fassen kann, ohne zu raten.
fn zeile(name: u64, feld: u64) {
    var t_p: [u8; 10] = "dispctl: \0"
    var t_g: [u8; 2] = "=\0"
    var t_x: [u8; 2] = "-\0"
    ulib.say((&t_p[0 as usize]) as u64)
    ulib.say(name)
    ulib.say((&t_g[0 as usize]) as u64)
    let v: u64 = dget(feld)
    if ulib.bad(v) {
        ulib.say((&t_x[0 as usize]) as u64)
    } else {
        ulib.sayn(v)
    }
    ulib.nl()
}

fn zahl_zeile(name: u64, v: u64) {
    var t_p: [u8; 10] = "dispctl: \0"
    var t_g: [u8; 2] = "=\0"
    ulib.say((&t_p[0 as usize]) as u64)
    ulib.say(name)
    ulib.say((&t_g[0 as usize]) as u64)
    ulib.sayn(v)
    ulib.nl()
}

fn zahl_lesen(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 12 {
        let c: u64 = (*((p + i) as *mut u8)) as u64
        if c < 48 || c > 57 {
            i = 12
        } else {
            v = v * 10 + (c - 48)
            i = i + 1
        }
    }
    return v
}

// ================================================= RUNDE CUSTOMRES
//
// DER SATZ, DER DASTEHEN MUSS. "Geht nicht" ist keine Meldung: der
// Benutzer hat eine Zahl eingegeben und will wissen, WELCHE der drei
// Schranken sie gerissen hat UND MIT WELCHER ZAHL. Jede dieser Zeilen
// nennt beides, und beide Zahlen kommen aus dem Kernel -- keine davon
// ist von diesem Programm.
fn grund_zeigen(w: u64, h: u64) {
    var t_p: [u8; 23] = "dispctl: abgelehnt -- \0"
    var t_regs: [u8; 45] = "die Karte nimmt diese Zahl nicht an. Sie hat\0"
    var t_regs2: [u8; 18] = " daraus gemacht: \0"
    var t_acht: [u8; 47] = "  (Hinweis: die Breite ist kein Vielfaches von\0"
    var t_acht2: [u8; 4] = " 8)\0"
    var t_vram: [u8; 44] = "passt nicht in den Bildspeicher der Karte: \0"
    var t_lim: [u8; 48] = "dieser Kernel kann es nicht einblenden. Noetig \0"
    var t_oct: [u8; 11] = " Oktette, \0"
    var t_da: [u8; 12] = " vorhanden.\0"
    var t_geht: [u8; 8] = " gehen.\0"
    var t_kach: [u8; 42] = "  (acht 2-MiB-Fensterplaetze, geteilt mit\0"
    var t_kach2: [u8; 14] = " apic.fi)\0\0\0\0\0"
    var t_dep: [u8; 46] = "diese Farbtiefe zeichnet dieser Kernel nicht:\0"
    var t_dep2: [u8; 20] = " Bit (nur 32 gehen)\0"
    var t_uns: [u8; 28] = "die Zahl liegt ausserhalb: \0"
    var t_ber: [u8; 11] = "  (Breite \0"
    var t_hoe: [u8; 9] = ", Hoehe \0"
    var t_zu: [u8; 2] = ")\0"
    var t_bis: [u8; 5] = " .. \0"
    var t_no: [u8; 35] = "es gibt keinen Modustreiber (disp)\0"
    var t_ok: [u8; 24] = "dispctl: angenommen -- \0"
    var t_kom: [u8; 3] = ", \0"
    var t_x: [u8; 4] = " x \0"
    var t_okt: [u8; 22] = " Oktette Bildspeicher\0"

    let why: u64 = dget(DG_CUSTWHY)
    let num: u64 = dget(DG_CUSTNUM)
    if ulib.bad(why) {
        return
    }
    if why == CW_OK {
        ulib.say((&t_ok[0 as usize]) as u64)
        ulib.sayn(w)
        ulib.say((&t_x[0 as usize]) as u64)
        ulib.sayn(h)
        ulib.say((&t_kom[0 as usize]) as u64)
        ulib.sayn(num)
        ulib.say((&t_okt[0 as usize]) as u64)
        ulib.nl()
        return
    }
    ulib.say((&t_p[0 as usize]) as u64)
    if why == CW_REGS {
        ulib.say((&t_regs[0 as usize]) as u64)
        ulib.say((&t_regs2[0 as usize]) as u64)
        ulib.sayn(num)
        ulib.nl()
        // Der Hinweis ist GEMESSEN und keine Vermutung: QEMU rundet
        // VBE-Breiten auf ein Vielfaches von acht ab. 1366 wird zu 1360,
        // 1360 bleibt 1360. Genau das steht in der Zahl oben.
        if (w & 7) != 0 {
            ulib.say((&t_acht[0 as usize]) as u64)
            ulib.say((&t_acht2[0 as usize]) as u64)
            ulib.nl()
        }
        return
    }
    if why == CW_VRAM {
        ulib.say((&t_vram[0 as usize]) as u64)
        ulib.sayn(num)
        ulib.say((&t_oct[0 as usize]) as u64)
        ulib.sayn(dget(DG_VRAM))
        ulib.say((&t_da[0 as usize]) as u64)
        ulib.nl()
        return
    }
    if why == CW_LIMIT {
        ulib.say((&t_lim[0 as usize]) as u64)
        ulib.sayn(num)
        ulib.say((&t_oct[0 as usize]) as u64)
        ulib.sayn(dget(DG_MAPLIMIT))
        ulib.say((&t_geht[0 as usize]) as u64)
        ulib.nl()
        ulib.say((&t_kach[0 as usize]) as u64)
        ulib.say((&t_kach2[0 as usize]) as u64)
        ulib.nl()
        return
    }
    if why == CW_DEPTH {
        ulib.say((&t_dep[0 as usize]) as u64)
        ulib.sayn(num)
        ulib.say((&t_dep2[0 as usize]) as u64)
        ulib.nl()
        return
    }
    if why == CW_UNSINN {
        // MIT DEM BEREICH, sonst weiss der Benutzer zwar, welche seiner
        // beiden Zahlen es zerreisst, aber nicht, wohin er sie schieben
        // soll. Die Grenzen kommen aus dem Kern (DG_MINW..DG_MAXH) --
        // sie hier hinzuschreiben waere eine zweite Wahrheit.
        ulib.say((&t_uns[0 as usize]) as u64)
        ulib.sayn(num)
        ulib.say((&t_ber[0 as usize]) as u64)
        ulib.sayn(dget(DG_MINW))
        ulib.say((&t_bis[0 as usize]) as u64)
        ulib.sayn(dget(DG_MAXW))
        ulib.say((&t_hoe[0 as usize]) as u64)
        ulib.sayn(dget(DG_MINH))
        ulib.say((&t_bis[0 as usize]) as u64)
        ulib.sayn(dget(DG_MAXH))
        ulib.say((&t_zu[0 as usize]) as u64)
        ulib.nl()
        return
    }
    ulib.say((&t_no[0 as usize]) as u64)
    ulib.nl()
}

fn modi_zeigen() {
    var t_m: [u8; 15] = "dispctl: mode \0"
    var t_x: [u8; 4] = " x \0"
    var t_b: [u8; 4] = " x \0"
    let n: u64 = dget(DG_COUNT)
    if ulib.bad(n) {
        return
    }
    var i: u64 = 0
    while i < n {
        let m: u64 = dget(DG_MODE + i)
        if !ulib.bad(m) {
            ulib.say((&t_m[0 as usize]) as u64)
            ulib.sayn(i)
            ulib.say((&t_b[0 as usize]) as u64)
            ulib.sayn((m >> 32) & 0xFFFF)
            ulib.say((&t_x[0 as usize]) as u64)
            ulib.sayn((m >> 16) & 0xFFFF)
            ulib.say((&t_x[0 as usize]) as u64)
            ulib.sayn(m & 0xFFFF)
            ulib.nl()
        }
        i = i + 1
    }
}

fn alles() {
    var n_ready: [u8; 6] = "ready\0"
    var n_count: [u8; 6] = "count\0"
    var n_vram: [u8; 5] = "vram\0"
    var n_dep: [u8; 7] = "depths\0"
    var n_lim: [u8; 9] = "maplimit\0"
    var n_ed: [u8; 7] = "edidok\0"
    var n_edw: [u8; 8] = "edidwhy\0"
    var n_nw: [u8; 5] = "natw\0"
    var n_nh: [u8; 5] = "nath\0"
    var n_cur: [u8; 4] = "cur\0"
    var n_pw: [u8; 7] = "panelw\0"
    var n_ph: [u8; 7] = "panelh\0"
    var n_iw: [u8; 5] = "imgw\0"
    var n_ih: [u8; 5] = "imgh\0"
    var n_pt: [u8; 6] = "pitch\0"
    var n_bpp: [u8; 4] = "bpp\0"
    var n_rot: [u8; 4] = "rot\0"
    var n_sc: [u8; 6] = "scale\0"
    var n_br: [u8; 7] = "bright\0"
    var n_co: [u8; 9] = "contrast\0"
    var n_ga: [u8; 6] = "gamma\0"
    var n_sa: [u8; 4] = "sat\0"
    var n_pe: [u8; 8] = "pending\0"
    var n_re: [u8; 7] = "remain\0"
    var n_sw: [u8; 9] = "switches\0"
    var n_fa: [u8; 6] = "fails\0"
    var n_rv: [u8; 8] = "reverts\0"
    var n_cf: [u8; 9] = "confirms\0"
    var n_pr: [u8; 9] = "presents\0"
    var n_pb: [u8; 7] = "probed\0"
    var n_rf: [u8; 8] = "refused\0"
    var n_tb: [u8; 7] = "toobig\0"
    zeile((&n_ready[0 as usize]) as u64, DG_READY)
    zeile((&n_count[0 as usize]) as u64, DG_COUNT)
    zeile((&n_vram[0 as usize]) as u64, DG_VRAM)
    zeile((&n_dep[0 as usize]) as u64, DG_DEPTHS)
    zeile((&n_lim[0 as usize]) as u64, DG_MAPLIMIT)
    zeile((&n_ed[0 as usize]) as u64, DG_EDIDOK)
    zeile((&n_edw[0 as usize]) as u64, DG_EDIDWHY)
    zeile((&n_nw[0 as usize]) as u64, DG_NATW)
    zeile((&n_nh[0 as usize]) as u64, DG_NATH)
    zeile((&n_cur[0 as usize]) as u64, DG_CUR)
    zeile((&n_pw[0 as usize]) as u64, DG_PANELW)
    zeile((&n_ph[0 as usize]) as u64, DG_PANELH)
    zeile((&n_iw[0 as usize]) as u64, DG_IMGW)
    zeile((&n_ih[0 as usize]) as u64, DG_IMGH)
    zeile((&n_pt[0 as usize]) as u64, DG_PITCH)
    zeile((&n_bpp[0 as usize]) as u64, DG_BPP)
    zeile((&n_rot[0 as usize]) as u64, DG_ROT)
    zeile((&n_sc[0 as usize]) as u64, DG_SCALE)
    zeile((&n_br[0 as usize]) as u64, DG_BRIGHT)
    zeile((&n_co[0 as usize]) as u64, DG_CONTRAST)
    zeile((&n_ga[0 as usize]) as u64, DG_GAMMA)
    zeile((&n_sa[0 as usize]) as u64, DG_SAT)
    zeile((&n_pe[0 as usize]) as u64, DG_PENDING)
    zeile((&n_re[0 as usize]) as u64, DG_REMAIN)
    zeile((&n_sw[0 as usize]) as u64, DG_SWITCHES)
    zeile((&n_fa[0 as usize]) as u64, DG_FAILS)
    zeile((&n_rv[0 as usize]) as u64, DG_REVERTS)
    zeile((&n_cf[0 as usize]) as u64, DG_CONFIRMS)
    zeile((&n_pr[0 as usize]) as u64, DG_PRESENTS)
    zeile((&n_pb[0 as usize]) as u64, DG_PROBED)
    zeile((&n_rf[0 as usize]) as u64, DG_REFUSED)
    zeile((&n_tb[0 as usize]) as u64, DG_TOOBIG)
    // RUNDE CUSTOMRES
    var n_cw: [u8; 8] = "custwhy\0"
    var n_cn: [u8; 8] = "custnum\0"
    var n_cs: [u8; 8] = "customs\0"
    var n_mnw: [u8; 5] = "minw\0"
    var n_mnh: [u8; 5] = "minh\0"
    var n_mxw: [u8; 5] = "maxw\0"
    var n_mxh: [u8; 5] = "maxh\0"
    var n_sok: [u8; 7] = "saveok\0"
    var n_sw2: [u8; 6] = "savew\0"
    var n_sh2: [u8; 6] = "saveh\0"
    var n_sb2: [u8; 6] = "saveb\0"
    var n_st2: [u8; 8] = "savetry\0"
    var n_sy2: [u8; 8] = "savewhy\0"
    var n_sa2: [u8; 8] = "saveapp\0"
    zeile((&n_cw[0 as usize]) as u64, DG_CUSTWHY)
    zeile((&n_cn[0 as usize]) as u64, DG_CUSTNUM)
    zeile((&n_cs[0 as usize]) as u64, DG_CUSTOMS)
    zeile((&n_mnw[0 as usize]) as u64, DG_MINW)
    zeile((&n_mnh[0 as usize]) as u64, DG_MINH)
    zeile((&n_mxw[0 as usize]) as u64, DG_MAXW)
    zeile((&n_mxh[0 as usize]) as u64, DG_MAXH)
    zeile((&n_sok[0 as usize]) as u64, DG_SAVEOK)
    zeile((&n_sw2[0 as usize]) as u64, DG_SAVEW)
    zeile((&n_sh2[0 as usize]) as u64, DG_SAVEH)
    zeile((&n_sb2[0 as usize]) as u64, DG_SAVEB)
    zeile((&n_st2[0 as usize]) as u64, DG_SAVETRY)
    zeile((&n_sy2[0 as usize]) as u64, DG_SAVEWHY)
    zeile((&n_sa2[0 as usize]) as u64, DG_SAVEAPP)
    modi_zeigen()
    let e: u64 = dget(DG_EDIDOK)
    if e == 1 {
        var t_v: [u8; 18] = "dispctl: vendor=\0\0"
        var t_m: [u8; 17] = "dispctl: model=\0\0"
        var buf: [u8; 32] = [0 as u8; 32]
        let a: u64 = ulib.sys(SYS_DISPSTR, 0, (&buf[0 as usize]) as u64, 32)
        if !ulib.bad(a) {
            ulib.say((&t_v[0 as usize]) as u64)
            ulib.say((&buf[0 as usize]) as u64)
            ulib.nl()
        }
        let b: u64 = ulib.sys(SYS_DISPSTR, 1, (&buf[0 as usize]) as u64, 32)
        if !ulib.bad(b) {
            ulib.say((&t_m[0 as usize]) as u64)
            ulib.say((&buf[0 as usize]) as u64)
            ulib.nl()
        }
    }
}

// DIE ZUSAGEN AUS RING 3. Jede einzelne davon ist ein Aufruf ueber die
// Aufrufschwelle und zurueck -- was hier gruen wird, ist nicht der
// Kernel, der sich selbst prueft, sondern ein Programm ohne Rechte, das
// den Kernel fragt.
fn test() -> u64 {
    var t_t: [u8; 15] = "dispctl: test \0"
    var t_o: [u8; 4] = " / \0"
    var n: u64 = 0
    let ganz: u64 = 12

    // 1. Der Kernel hat erkundet.
    if dget(DG_READY) == 1 {
        n = n + 1
    }
    // 2. Es gibt eine Liste, und sie ist nicht leer.
    let anz: u64 = dget(DG_COUNT)
    if !ulib.bad(anz) && anz > 0 {
        n = n + 1
    }
    // 3. Jeder Eintrag hat Breite, Hoehe und 32 Bit.
    var gut: bool = true
    var i: u64 = 0
    while i < anz {
        let m: u64 = dget(DG_MODE + i)
        if ulib.bad(m) {
            gut = false
        } else {
            if ((m >> 32) & 0xFFFF) == 0 || ((m >> 16) & 0xFFFF) == 0 {
                gut = false
            }
            if (m & 0xFFFF) != 32 {
                gut = false
            }
        }
        i = i + 1
    }
    if gut {
        n = n + 1
    }
    // 4. Ein Eintrag hinter dem Ende gibt einen Fehler und keine Null.
    if ulib.bad(dget(DG_MODE + anz)) {
        n = n + 1
    }
    // 5. Ein Feld, das es nicht gibt, ebenso.
    if ulib.bad(dget(900)) {
        n = n + 1
    }
    // 6. Der laufende Modus steht in der Liste, und die Tafel passt
    //    zu seinem Eintrag.
    let cur: u64 = dget(DG_CUR)
    if cur < anz {
        let m: u64 = dget(DG_MODE + cur)
        if ((m >> 32) & 0xFFFF) == dget(DG_PANELW) {
            if ((m >> 16) & 0xFFFF) == dget(DG_PANELH) {
                n = n + 1
            }
        }
    }
    // 7. Ein Modus, den es nicht gibt, wird abgelehnt -- und der
    //    Bildschirm bleibt derselbe.
    let vor: u64 = dget(DG_PANELW)
    if ulib.bad(dset(DS_MODE, (4096 << 16) | 4096)) {
        if dget(DG_PANELW) == vor {
            n = n + 1
        }
    }
    // 8. Eine Drehung, die es nicht gibt, ebenso.
    let rvor: u64 = dget(DG_ROT)
    if ulib.bad(dset(DS_ROT, 45)) && dget(DG_ROT) == rvor {
        n = n + 1
    }
    // 9. Gamma setzen und zurueckLESEN.
    if !ulib.bad(dset(DS_GAMMA, 220)) && dget(DG_GAMMA) == 220 {
        n = n + 1
    }
    // 10. Ein Gamma ausserhalb des Bereichs wird abgelehnt, und der
    //     alte Wert bleibt stehen.
    if ulib.bad(dset(DS_GAMMA, 5)) && dget(DG_GAMMA) == 220 {
        n = n + 1
    }
    let _z: u64 = dset(DS_GAMMA, 100)
    // 11. Eine Vierteldrehung tauscht die MASSE des Bildes, nicht die
    //     der Tafel. Das ist die Zusage, an der eine Drehung von einer
    //     bloss anders gemalten Flaeche zu unterscheiden ist.
    let pw: u64 = dget(DG_PANELW)
    let ph: u64 = dget(DG_PANELH)
    if !ulib.bad(dset(DS_ROT, 90)) {
        if dget(DG_IMGW) == ph && dget(DG_IMGH) == pw {
            if dget(DG_PANELW) == pw && dget(DG_PANELH) == ph {
                n = n + 1
            }
        }
    }
    let _y: u64 = dset(DS_ROT, 0)
    // 12. ... und danach ist alles wieder, wie es war.
    if dget(DG_IMGW) == pw && dget(DG_IMGH) == ph && dget(DG_ROT) == 0 {
        n = n + 1
    }

    ulib.say((&t_t[0 as usize]) as u64)
    ulib.sayn(n)
    ulib.say((&t_o[0 as usize]) as u64)
    ulib.sayn(ganz)
    ulib.nl()
    return n
}

// DIE ZUSAGEN DER RUNDE CUSTOMRES, AUS RING 3. Wie oben: was hier
// gruen wird, ist nicht der Kernel, der sich selbst prueft, sondern ein
// Programm ohne Rechte, das ueber die Aufrufschwelle geht.
fn testc() -> u64 {
    var t_t: [u8; 16] = "dispctl: testc \0"
    var t_o: [u8; 4] = " / \0"
    var n: u64 = 0
    let ganz: u64 = 10

    let pw: u64 = dget(DG_PANELW)
    let ph: u64 = dget(DG_PANELH)
    let lim: u64 = dget(DG_MAPLIMIT)

    // 1. Die Grenzen der freien Eingabe kommen aus dem Kernel und sind
    //    keine Zahl in diesem Programm.
    if dget(DG_MINW) > 0 && dget(DG_MAXW) > dget(DG_MINW) {
        n = n + 1
    }
    // 2. Eine Breite unterhalb der Grenze wird abgelehnt, der Grund ist
    //    "Unsinn", und die genannte Zahl ist die eingegebene.
    let _a: u64 = dset(DS_CHECK, (8 << 32) | (600 << 16) | 32)
    if dget(DG_CUSTWHY) == CW_UNSINN && dget(DG_CUSTNUM) == 8 {
        n = n + 1
    }
    // 3. Eine Farbtiefe, die dieser Kernel nicht zeichnet: eigener Grund,
    //    eigene Zahl.
    let _b: u64 = dset(DS_CHECK, (800 << 32) | (600 << 16) | 16)
    if dget(DG_CUSTWHY) == CW_DEPTH && dget(DG_CUSTNUM) == 16 {
        n = n + 1
    }
    // 4. Etwas, das dieser Kernel nicht einblenden kann: Grund 3, und
    //    die Zahl ist GENAU die Zahl der noetigen Oktette.
    let _c: u64 = dset(DS_CHECK, (2560 << 32) | (1440 << 16) | 32)
    if dget(DG_CUSTWHY) == CW_LIMIT {
        if dget(DG_CUSTNUM) == 2560 * 1440 * 4 {
            if dget(DG_CUSTNUM) > lim {
                n = n + 1
            }
        }
    }
    // 5. UND DER BILDSCHIRM IST NACH DREI PRUEFUNGEN DERSELBE. Eine
    //    Pruefung, die den Bildschirm anfasst, waere in einem Bedienfeld
    //    unbrauchbar -- dort wird bei jedem Tastendruck geprueft.
    if dget(DG_PANELW) == pw && dget(DG_PANELH) == ph {
        n = n + 1
    }
    // 6. Eine eigene Aufloesung, die durchgeht, meldet Grund 0 und als
    //    Zahl die noetigen Oktette.
    let _d: u64 = dset(DS_CHECK, (1400 << 32) | (1050 << 16) | 32)
    if dget(DG_CUSTWHY) == CW_OK && dget(DG_CUSTNUM) == 1400 * 1050 * 4 {
        n = n + 1
    }
    // 7. ... und pruefen ist NICHT einstellen.
    if dget(DG_PANELW) == pw && dget(DG_PANELH) == ph {
        n = n + 1
    }
    // 8. Und jetzt wirklich einstellen: die Tafel steht danach auf den
    //    eingegebenen Zahlen.
    let e: u64 = dset(DS_CUSTOM, (1400 << 32) | (1050 << 16) | 32)
    if !ulib.bad(e) && dget(DG_PANELW) == 1400 && dget(DG_PANELH) == 1050 {
        n = n + 1
    }
    // 9. Direkt danach laeuft eine Frist -- auch fuer eine eigene
    //    Aufloesung. Das ist die Zusage, ohne die der Rest gefaehrlich
    //    waere.
    if dget(DG_PENDING) == 1 && dget(DG_REMAIN) > 1000 {
        n = n + 1
    }
    // 10. Zurueck, und die alte Tafel steht wieder da.
    let _f: u64 = dset(DS_REVERT, 0)
    if dget(DG_PANELW) == pw && dget(DG_PANELH) == ph {
        n = n + 1
    }

    ulib.say((&t_t[0 as usize]) as u64)
    ulib.sayn(n)
    ulib.say((&t_o[0 as usize]) as u64)
    ulib.sayn(ganz)
    ulib.nl()
    return n
}

fn u_start(args: u64) -> u64 {
    var w_raw: [u8; 4] = "raw\0"
    var w_modes: [u8; 6] = "modes\0"
    var w_set: [u8; 4] = "set\0"
    var w_rot: [u8; 4] = "rot\0"
    var w_gam: [u8; 6] = "gamma\0"
    var w_hell: [u8; 5] = "hell\0"
    var w_kon: [u8; 10] = "kontrast\0\0"
    var w_sat: [u8; 12] = "saettigung\0\0"
    var w_skal: [u8; 5] = "skal\0"
    var w_beh: [u8; 10] = "behalten\0\0"
    var w_zur: [u8; 8] = "zurueck\0"
    var w_test: [u8; 5] = "test\0"
    var w_testc: [u8; 6] = "testc\0"
    var w_eig: [u8; 6] = "eigen\0"
    var w_pruef: [u8; 8] = "pruefen\0"
    var w_sp: [u8; 11] = "speichern\0\0"
    var m_no: [u8; 40] = "dispctl: der Bildschirm ist nicht da\0\0\0\0"
    var m_perm: [u8; 43] = "dispctl: abgelehnt -- nicht die Wurzel?\0\0\0\0"
    var m_ok: [u8; 17] = "dispctl: gesetzt\0"
    var n_rc: [u8; 3] = "rc\0"

    let argc: u64 = ulib.arg_count(args)
    if dget(DG_READY) != 1 {
        ulib.say((&m_no[0 as usize]) as u64)
        ulib.nl()
        // Auch dann noch die Zeilen, damit die GEGENPROBE des Laeufers
        // an ihnen sieht, dass wirklich nichts gemeldet wird.
        alles()
        return 1
    }
    if argc < 2 {
        alles()
        return 0
    }
    let a1: u64 = ulib.arg_at(args, 1)
    if ulib.streq(a1, (&w_raw[0 as usize]) as u64) {
        alles()
        return 0
    }
    if ulib.streq(a1, (&w_modes[0 as usize]) as u64) {
        modi_zeigen()
        return 0
    }
    if ulib.streq(a1, (&w_test[0 as usize]) as u64) {
        let n: u64 = test()
        if n == 12 {
            return 0
        }
        return 1
    }
    if ulib.streq(a1, (&w_testc[0 as usize]) as u64) {
        let n: u64 = testc()
        if n == 10 {
            return 0
        }
        return 1
    }
    if ulib.streq(a1, (&w_sp[0 as usize]) as u64) {
        let r: u64 = dset(DS_SAVE, 0)
        zahl_zeile((&n_rc[0 as usize]) as u64, r)
        alles()
        return 0
    }
    if ulib.streq(a1, (&w_beh[0 as usize]) as u64) {
        let r: u64 = dset(DS_CONFIRM, 0)
        zahl_zeile((&n_rc[0 as usize]) as u64, r)
        return 0
    }
    if ulib.streq(a1, (&w_zur[0 as usize]) as u64) {
        let r: u64 = dset(DS_REVERT, 0)
        zahl_zeile((&n_rc[0 as usize]) as u64, r)
        alles()
        return 0
    }
    if argc < 3 {
        alles()
        return 0
    }
    let a2: u64 = ulib.arg_at(args, 2)
    var feld: u64 = 99
    var wert: u64 = zahl_lesen(a2)
    // RUNDE CUSTOMRES: `eigen` und `pruefen` nehmen DREI Zahlen, und die
    // dritte darf fehlen -- dann ist sie 32, die einzige, die dieser
    // Kernel zeichnet.
    if ulib.streq(a1, (&w_eig[0 as usize]) as u64)
        || ulib.streq(a1, (&w_pruef[0 as usize]) as u64) {
        if argc < 4 {
            var m_arg: [u8; 34] = "dispctl: eigen BREITE HOEHE [BIT]\0"
            ulib.say((&m_arg[0 as usize]) as u64)
            ulib.nl()
            return 1
        }
        let cw: u64 = zahl_lesen(a2)
        let ch: u64 = zahl_lesen(ulib.arg_at(args, 3))
        var cb: u64 = 32
        if argc > 4 {
            cb = zahl_lesen(ulib.arg_at(args, 4))
        }
        var f2: u64 = DS_CUSTOM
        if ulib.streq(a1, (&w_pruef[0 as usize]) as u64) {
            f2 = DS_CHECK
        }
        let r2: u64 = dset(f2, (cw << 32) | (ch << 16) | cb)
        grund_zeigen(cw, ch)
        zahl_zeile((&n_rc[0 as usize]) as u64, r2)
        alles()
        if ulib.bad(r2) {
            return 1
        }
        return 0
    }
    if ulib.streq(a1, (&w_set[0 as usize]) as u64) {
        if argc < 4 {
            return 1
        }
        feld = DS_MODE
        wert = (zahl_lesen(a2) << 16) | zahl_lesen(ulib.arg_at(args, 3))
    } else if ulib.streq(a1, (&w_rot[0 as usize]) as u64) {
        feld = DS_ROT
    } else if ulib.streq(a1, (&w_gam[0 as usize]) as u64) {
        feld = DS_GAMMA
    } else if ulib.streq(a1, (&w_hell[0 as usize]) as u64) {
        feld = DS_BRIGHT
    } else if ulib.streq(a1, (&w_kon[0 as usize]) as u64) {
        feld = DS_CONTRAST
    } else if ulib.streq(a1, (&w_sat[0 as usize]) as u64) {
        feld = DS_SAT
    } else if ulib.streq(a1, (&w_skal[0 as usize]) as u64) {
        feld = DS_SCALE
    }
    if feld == 99 {
        alles()
        return 0
    }
    let r: u64 = dset(feld, wert)
    if ulib.bad(r) {
        ulib.say((&m_perm[0 as usize]) as u64)
        ulib.nl()
        zahl_zeile((&n_rc[0 as usize]) as u64, r)
        alles()
        return 1
    }
    ulib.say((&m_ok[0 as usize]) as u64)
    ulib.nl()
    alles()
    return 0
}
