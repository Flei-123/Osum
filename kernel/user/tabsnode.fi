// SPDX-License-Identifier: GPL-2.0-only
import fuiscene
import wlib

export { SLOTS, open, sel, set_sel, count, pick, key, key_of, strip_key }

const SLOTS: u64 = 4
const NONE: u64 = 4294967295

static mut t_n: [u64; 4] = [0 as u64; 4]
static mut t_sel: [u64; 4] = [0 as u64; 4]
static mut t_key0: [u64; 4] = [0 as u64; 4]

fn open(parent: usize, slot: u64, key0: u64, names: u64, stride: u64, n: u64, w: u64, h: u64) -> usize {
    if slot >= SLOTS || n == 0 || n > 16 {
        return fuiscene.NONE
    }
    t_n[(slot) as usize] = n
    t_key0[(slot) as usize] = key0
    if t_sel[(slot) as usize] >= n {
        t_sel[(slot) as usize] = n - 1
    }
    let r: usize = fuiscene.row(parent)
    fuiscene.set_gap(r, 2)
    var i: u64 = 0
    while i < n {
        let t: usize = fuiscene.tab(r, names + i * stride, key0 + i, t_sel[(slot) as usize] == i)
        fuiscene.set_size(t, w, h)
        i = i + 1
    }
    return r
}

fn sel(slot: u64) -> u64 {
    return t_sel[(slot) as usize]
}

fn count(slot: u64) -> u64 {
    return t_n[(slot) as usize]
}

fn key_of(slot: u64, i: u64) -> u64 {
    return t_key0[(slot) as usize] + i
}

fn set_sel(slot: u64, i: u64) {
    if slot >= SLOTS || i >= t_n[(slot) as usize] {
        return
    }
    if t_sel[(slot) as usize] != i {
        t_sel[(slot) as usize] = i
        fuiscene.refresh()
    }
}

fn strip_key(slot: u64, k: u64) -> bool {
    return k >= t_key0[(slot) as usize] && k < t_key0[(slot) as usize] + t_n[(slot) as usize]
}

fn pick(slot: u64, k: u64) -> bool {
    if slot >= SLOTS || t_n[(slot) as usize] == 0 || !strip_key(slot, k) {
        return false
    }
    set_sel(slot, k - t_key0[(slot) as usize])
    return true
}

fn key(slot: u64, k: u64) -> bool {
    if slot >= SLOTS || t_n[(slot) as usize] == 0 {
        return false
    }
    if k != wlib.KEY_LEFT && k != wlib.KEY_RIGHT && k != wlib.KEY_HOME && k != wlib.KEY_END {
        return false
    }
    if !strip_key(slot, fuiscene.focus_key()) {
        return false
    }
    let n: u64 = t_n[(slot) as usize]
    var cur: u64 = t_sel[(slot) as usize]
    if k == wlib.KEY_LEFT {
        if cur > 0 {
            cur = cur - 1
        } else {
            cur = n - 1
        }
    } else if k == wlib.KEY_RIGHT {
        cur = cur + 1
        if cur >= n {
            cur = 0
        }
    } else if k == wlib.KEY_HOME {
        cur = 0
    } else {
        cur = n - 1
    }
    t_sel[(slot) as usize] = cur
    fuiscene.refresh()
    fuiscene.focus(t_key0[(slot) as usize] + cur)
    return true
}
