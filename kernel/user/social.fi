// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/social.fi -- THE SOCIAL SERVICE: friends, presence and
// activity for the whole system, as a provider on orient-bus.
//
//     social serve [ticks] [refresh-ticks]
//
// The concept is FirnChat's docs/SOCIAL.md and docs/ACTION-BUS.md
// section 8 ("API v1 IS a set of actions on orient-bus"):
//
//   * ONE service owns the merged address book, the own presence and
//     activity. UIs (the friends bar /bin/freunde, an overlay, a game,
//     Jarvis) never talk to a provider; they call `social.*` actions --
//     so every caller goes through the broker's rights, confirmation,
//     dry run and audit log, and the UI is replaceable.
//   * PROVIDERS sit behind one interface and are PROGRAMS, not code in
//     here: /etc/social/providers names them, ONE LINE PER ACCOUNT,
//
//         provider fleitec /bin/socfleitec /etc/social/fleitec.conf
//         provider arbeit /bin/socfleitec /etc/social/arbeit.conf
//         provider xoffi /bin/socxoffi /etc/social/xoffi.conf
//         provider local /bin/soclocal
//
//     and the service runs `<program> v1 [-c<conf>] <verb> ...` and
//     reads lines (docs/SOCIAL.md is the interface). Several at once --
//     several accounts of the same kind too; their contacts merge into
//     one book, an id is `<account>:<id>`. A new provider (Matrix, XMPP,
//     the LAN, Xoffi) is a new program and a line in that file -- this
//     file does not change and does not even know which providers exist.
//     What a provider can do it says itself (`hello` -> `caps ...`); the
//     service only asks for what is there (chat, invites, login).
//   * Privacy is enforced HERE, where the data goes out: invisible stops
//     the signs of life and the activity, `share_activity=false` keeps an
//     activity on the device.
//
// What it does on its own: asks every provider for the book every
// refresh (30 s), for new messages and invites every 5 s (providers that
// can), keeps the messages (/etc/social/messages, the last ~24 KB) and
// rings the system's bell (bus.noti_post) for a new message or invite,
// sends a sign of life every 120 s while not invisible,
// repeats the activity every 60 s (fleikontakte forgets it after 150 s),
// and publishes `social.presence`, `social.activity` and `social.contact`
// events for what changed between two books.
//
// No provider call blocks this loop: timers and the calls of people and
// apps run as jobs (socjob), a call is answered under its saved request id
// when its job is done. The broker gives a call 5 s -- a provider that
// takes longer is killed (CALL_TICKS) and the call answered `err provider
// offline`, never left hanging.

profile app

import ulib
import actwire
import socperm
import socq
import socacct
import socbg
import socbook
import socbuf
import sochello
import socinv
import socmsg
import socpriv
import socprov
import socstate
import socudone
import socujob
import socview
import socwatch

export { u_start }

const MSG_CAP: usize = 24575 // octets of kept messages
const POLL_TICKS: u64 = 500 // 5 s: messages and invites
const ALIVE_TICKS: u64 = 12000 // 120 s
const ACT_TICKS: u64 = 6000 // 60 s
const GAMES_TICKS: u64 = 360000 // 1 h: the list of games for the Melder
static mut msg_poll_ticks: u64 = 500

// The messages: one line each, TAB between the fields,
//   <account>:<peer> stamp in|out read(0|1) text
// oldest first; full = the oldest go.
static mut st_msg: [u8; 24576] = [0 as u8; 24576]
static mut refresh_ticks: u64 = 3000


static mut k_dry: [u8; 5] = "@dry\0"

// One call; the reply is built in actwire's output buffer.
fn is_provider_call(np: u64) -> bool {
    return socbuf.isz(np, "social.contacts.request") || socbuf.isz(np, "social.contacts.accept")
        || socbuf.isz(np, "social.contacts.decline") || socbuf.isz(np, "social.contacts.withdraw")
        || socbuf.isz(np, "social.contacts.remove") || socbuf.isz(np, "social.activity.set")
        || socbuf.isz(np, "social.accounts.login") || socbuf.isz(np, "social.messages.send")
        || socbuf.isz(np, "social.invites.send") || socbuf.isz(np, "social.invites.answer")
        || socbuf.isz(np, "social.refresh") || socbuf.isz(np, "social.contacts.search")
}

fn handle(msg: u64) {
    var verb: [u8; 16] = [0 as u8; 16]
    var name: [u8; 40] = [0 as u8; 40]
    let vp: u64 = (&verb[0]) as u64
    let np: u64 = (&name[0]) as u64
    let nx: u64 = actwire.word_copy(msg, 0, vp, 16)
    actwire.word_copy(msg, nx, np, 40)
    var dv: [u8; 4] = [0 as u8; 4]
    let dry: bool = actwire.kv_find(msg, (&k_dry[0]) as u64, (&dv[0]) as u64, 4)
    if socbuf.isz(vp, "ping") {
        actwire.ob_reset()
        socbuf.ob_s("pong\n")
        return
    }
    var cl0: [u8; 24] = [0 as u8; 24]
    let _c0: bool = socbuf.arg(msg, "@client", (&cl0[0]) as u64, 24)
    let pc: i64 = socperm.perm_check((&cl0[0]) as u64, np)
    if pc != 0 {
        socperm.perm_deny(pc)
        return
    }
    if sochello.hello_pending() && is_provider_call(np) {
        socstate.st_defer = true
        return
    }
    if socbuf.isz(np, "social.status") {
        socview.a_status()
    } else if socbuf.isz(np, "social.apps.list") {
        socperm.a_apps_list()
    } else if socbuf.isz(np, "social.apps.grant") {
        if socperm.a_apps_grant(msg, dry) {
            socpriv.apps_save()
        }
    } else if socbuf.isz(np, "social.apps.allow") {
        if socperm.a_apps_allow(msg, dry) {
            socpriv.apps_save()
        }
    } else if socbuf.isz(np, "social.apps.revoke") {
        if socperm.a_apps_revoke(msg, dry) {
            socpriv.apps_save()
        }
    } else if socbuf.isz(np, "social.apps.deny") {
        if socperm.a_apps_deny(msg, dry) {
            socpriv.apps_save()
        }
    } else if socbuf.isz(np, "social.privacy.show") {
        if socperm.a_priv_show(msg, dry) {
            socpriv.priv_save()
            socprov.mark_due(socstate.JK_ACTIVITY)
        }
    } else if socbuf.isz(np, "social.privacy.get") {
        socperm.a_priv_get(socstate.share_act, socbook.invisible())
    } else if socbuf.isz(np, "social.privacy.hide") {
        if socperm.a_priv_hide(msg, dry) {
            socpriv.priv_save()
            socprov.mark_due(socstate.JK_ACTIVITY)
        }
    } else if socbuf.isz(np, "social.privacy.invites") {
        if socperm.a_priv_invites(msg, dry) {
            socpriv.priv_save()
            socprov.mark_due(socstate.JK_INVITES)
        }
    } else if socbuf.isz(np, "social.contacts.list") {
        socview.a_list(msg)
    } else if socbuf.isz(np, "social.contacts.get") {
        socview.a_get(msg)
    } else if socbuf.isz(np, "social.contacts.search") {
        socview.a_search(msg)
    } else if socbuf.isz(np, "social.contacts.request") {
        let _r: bool = socview.a_relation(msg, "request", dry)
    } else if socbuf.isz(np, "social.contacts.accept") {
        let _r: bool = socview.a_relation(msg, "accept", dry)
    } else if socbuf.isz(np, "social.contacts.decline") {
        let _r: bool = socview.a_relation(msg, "decline", dry)
    } else if socbuf.isz(np, "social.contacts.withdraw") {
        let _r: bool = socview.a_relation(msg, "withdraw", dry)
    } else if socbuf.isz(np, "social.contacts.remove") {
        let _r: bool = socview.a_relation(msg, "remove", dry)
    } else if socbuf.isz(np, "social.presence.set") {
        let _r: bool = socpriv.a_presence(msg, dry)
    } else if socbuf.isz(np, "social.activity.set") {
        let _r: bool = socpriv.a_activity(msg, dry)
    } else if socbuf.isz(np, "social.activity.clear") {
        let _r: bool = socpriv.a_activity_clear(msg, dry)
    } else if socbuf.isz(np, "social.privacy.set") {
        let _r: bool = socpriv.a_privacy(msg, dry)
    } else if socbuf.isz(np, "social.accounts.list") {
        socacct.a_accounts()
    } else if socbuf.isz(np, "social.accounts.login") {
        let _r: bool = socacct.a_login(msg, dry)
    } else if socbuf.isz(np, "social.messages.send") {
        let _r: bool = socmsg.a_msg_send(msg, dry)
    } else if socbuf.isz(np, "social.messages.list") {
        socmsg.a_msg_list(msg)
    } else if socbuf.isz(np, "social.messages.unread") {
        socmsg.a_msg_unread()
    } else if socbuf.isz(np, "social.messages.read") {
        let _r: bool = socmsg.a_msg_read(msg, dry)
    } else if socbuf.isz(np, "social.invites.send") {
        let _r: bool = socinv.a_inv_send(msg, dry)
    } else if socbuf.isz(np, "social.invites.list") {
        socinv.a_inv_list(msg)
    } else if socbuf.isz(np, "social.invites.answer") {
        let _r: bool = socinv.a_inv_answer(msg, dry)
    } else if socbuf.isz(np, "social.party.take") {
        socinv.a_party_take(msg, dry)
    } else if socbuf.isz(np, "social.refresh") {
        socujob.a_refresh()
    } else {
        socbuf.ob_err("unknown_action")
    }
}

fn dispatch(msg: u64, id: u64) {
    socstate.cur_id = id
    socstate.st_async = false
    socstate.st_defer = false
    handle(msg)
    if socstate.st_defer {
        if !socq.q_put(msg, id) {
            socbuf.ob_err("busy")
            socujob.reply_to(id)
        }
        return
    }
    if !socstate.st_async {
        socujob.reply_to(id)
    }
}

fn queue_run() {
    if socq.q_count() == 0 {
        return
    }
    var k: i64 = socq.q_next(0)
    while k >= 0 {
        let kk: usize = k as usize
        let seq: u64 = socq.q_seq(kk)
        socstate.cur_id = socq.q_id(kk)
        socstate.st_async = false
        socstate.st_defer = false
        handle(socq.q_msg(kk))
        if !socstate.st_defer {
            if !socstate.st_async {
                socujob.reply_to(socstate.cur_id)
            }
            socq.q_drop(kk)
        }
        k = socq.q_next(seq)
    }
}


fn serve(limit: u64) -> u64 {
    socstate.book = socbuf.sb((&socstate.st_a[0]) as u64, 16383)
    socstate.flip = false
    socbuf.zset_s((&socstate.my_pres[0]) as u64, 16, "online")
    var pv: socbuf.SB = socbuf.sb((&socstate.st_file[0]) as u64, 4095)
    if socbuf.read_file("/etc/social/privacy", &pv) {
        socstate.share_act = socperm.priv_parse(pv.ptr, pv.len)
    }
    var ab: socbuf.SB = socbuf.sb((&socstate.st_tmp[0]) as u64, 2047)
    if socbuf.read_file("/etc/social/apps", &ab) {
        socperm.apps_load(ab.ptr, ab.len)
    }
    socprov.providers_load()
    sochello.hello_arm()
    socstate.msgs = socbuf.sb((&st_msg[0]) as u64, MSG_CAP)
    socstate.invs = socbuf.sb((&socstate.st_inv[0]) as u64, socstate.INV_CAP)
    let _m: bool = socbuf.read_file("/etc/social/messages", &socstate.msgs)
    sochello.words_load()
    var n_me: [u8; 9] = "a.social\0"
    let me: u64 = actwire.bus_reg((&n_me[0]) as u64, actwire.A_ROOT)
    if ulib.bad(me) {
        socbuf.say("social: a.social is taken\n")
        return 1
    }
    var n_bus: [u8; 11] = "orient.bus\0"
    let t0: u64 = actwire.ticks()
    socstate.svc_bus = actwire.bus_find((&n_bus[0]) as u64)
    while ulib.bad(socstate.svc_bus) && actwire.ticks() - t0 < 500 {
        actwire.yield_now()
        socstate.svc_bus = actwire.bus_find((&n_bus[0]) as u64)
    }
    if ulib.bad(socstate.svc_bus) {
        socbuf.say("social: no orient.bus here\n")
        return 1
    }
    var s_hello: [u8; 14] = "hello social\n\0"
    actwire.send_msg(socstate.svc_bus, actwire.K_REQ, actwire.rnd() & 0xFFFFFFFF,
        (&s_hello[0]) as u64, 13)
    socbuf.say("social: serving a.social, providers=")
    var d: [u8; 8] = [0 as u8; 8]
    let dn: u64 = ulib.digits(socstate.n_prov as u64, (&d[0]) as u64)
    socbuf.sayb((&d[0]) as u64, dn as usize)
    socbuf.say("\n")

    var fr: [u8; 64] = [0 as u8; 64]
    var meta: [u64; 6] = [0 as u64; 6]
    let fp: u64 = (&fr[0]) as u64
    let mp: u64 = (&meta[0]) as u64
    let t1: u64 = actwire.ticks()
    var last_check: u64 = t1
    // the first book after the broker had time to ping us
    var next_refresh: u64 = t1 + 50
    var next_alive: u64 = t1 + 60
    var next_act: u64 = t1 + ACT_TICKS
    var next_poll: u64 = t1 + 80
    var next_msg: u64 = t1 + 80
    // the first list of games once the first book is in (4 s in)
    socstate.g_next = t1 + 400
    while limit == 0 || actwire.ticks() - t1 < limit {
        // AB-002: wait in the kernel (at most 100 ms, for the timers below)
        var wait_ms: u64 = 100
        if socujob.user_busy_any() || sochello.hello_pending() || socq.q_count() > 0 {
            wait_ms = 20
        }
        let n: u64 = actwire.bus_wait(fp, mp, wait_ms)
        if !ulib.bad(n) && n > 0 {
            let s: u64 = actwire.asm_feed(fp, mp)
            if s != actwire.NONE {
                if actwire.asm_kind(s) == actwire.K_REQ {
                    dispatch(actwire.asm_buf(s), actwire.asm_id(s))
                }
                actwire.asm_free(s)
            }
        } else {
            let now: u64 = actwire.ticks()
            if now - last_check > 100 {
                last_check = now
                if ulib.bad(actwire.bus_find((&n_bus[0]) as u64)) {
                    socbuf.say("social: orient-bus is gone\n")
                    socwatch.watch_stop_all()
                    return 0
                }
            }
        }
        let tnow: u64 = actwire.ticks()
        if tnow >= next_refresh {
            socprov.mark_due(socstate.JK_CONTACTS)
            next_refresh = tnow + refresh_ticks
        }
        if tnow >= next_alive {
            if !socbook.invisible() {
                socprov.mark_due(socstate.JK_ALIVE)
            }
            next_alive = tnow + ALIVE_TICKS
        }
        if tnow >= next_act {
            if socbook.act_goes() {
                socprov.mark_due(socstate.JK_ACTIVITY)
            }
            next_act = tnow + ACT_TICKS
        }
        if tnow >= next_poll {
            socprov.mark_due(socstate.JK_INVITES)
            next_poll = tnow + POLL_TICKS
        }
        if tnow >= next_msg {
            socprov.mark_due(socstate.JK_INBOX)
            next_msg = tnow + msg_poll_ticks
        }
        if tnow >= socstate.g_next {
            socprov.mark_due(socstate.JK_GAMES)
            socstate.g_next = tnow + GAMES_TICKS
        }
        socbg.bg_tick()
        socudone.user_tick()
        queue_run()
        socwatch.watch_tick()
    }
    socwatch.watch_stop_all()
    return 0
}

fn u_start(args: u64) -> u64 {
    if ulib.arg_count(args) >= 2 && socbuf.isz(ulib.arg_at(args, 1), "serve") {
        var lim: u64 = 0
        if ulib.arg_count(args) >= 3 {
            lim = ulib.to_num(ulib.arg_at(args, 2))
        }
        if ulib.arg_count(args) >= 4 {
            refresh_ticks = ulib.to_num(ulib.arg_at(args, 3))
        }
        if ulib.arg_count(args) >= 5 {
            msg_poll_ticks = ulib.to_num(ulib.arg_at(args, 4))
        }
        return serve(lim)
    }
    if ulib.arg_count(args) >= 2 && socbuf.isz(ulib.arg_at(args, 1), "glocke") {
        // the newest notifications of the system, without marking them
        // read (BUS_NOTIPEEK_OP 23) -- what the taskbar shows as toasts
        var back: u64 = 0
        while back < 8 {
            var buf: [u8; 256] = [0 as u8; 256]
            let n: u64 = asm("syscall", out("rax"), in("rax") 1960, in("rdi") 23,
                in("rsi") back, in("rdx") (&buf[0]) as u64, in("r10") 255, in("r8") 0,
                in("r9") 0, clobber("rcx"), clobber("r11"), clobber("memory"))
            if ulib.bad(n) || n == 0 {
                back = 8
            } else {
                socbuf.say("glocke: ")
                socbuf.sayb((&buf[0]) as u64, n as usize)
                socbuf.say("\n")
                back = back + 1
            }
        }
        return 0
    }
    socbuf.say("usage: social serve [ticks] [refresh-ticks] [message-poll-ticks] | social glocke\n")
    return 1
}

// profile app: firnc's own _start calls main (kernel/user/freunde.fi
// says why the argument block has to be passed on by hand)
fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
