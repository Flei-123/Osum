// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/sucht.fi -- RUNDE SUPERSEARCH: DIE ORDNUNG AUF DER
// STANDARDAUSGABE.
//
// Die Rangfolge ist der eigentliche Wert dieser Suche, und eine Ordnung,
// die man nur an einem Bildschirmfoto ablesen kann, ist schlecht
// gemessen: ein Foto sagt, WAS oben steht, nicht WARUM. Dieses Programm
// ruft `sucher.probe` -- DIESELBE Funktion, die das Fenster ruft, nicht
// eine zweite Fassung davon -- und schreibt fuer jeden Fall die Zahl
// heraus, die herauskam, und die, die herauskommen sollte.
//
// Derselbe Gedanke wie `/bin/locate` fuer den Namensindex: was eine
// Oberflaeche behauptet, ist schwer nachzurechnen; was auf der
// Standardausgabe steht, liest ein Testlaeufer Zeile fuer Zeile.
//
// DIE UMLAUTFAELLE SIND DIE HAELFTE DER TABELLE, und einer davon ist
// eine GEGENPROBE: "ue" findet "Gruesse" mit Umlaut NICHT. Dieses
// System schreibt keine Umschrift -- es waere die halbe Loesung eines
// Problems, das eine ganze verlangt (docs/I18N.md), und eine Suche, die
// so tut, als koennte sie es, ist schlimmer als eine, die es zugibt.

profile kernel

import ulib
import libc.io
import sucher
import msg

export { u_start }

static mut gefaltet: [u8; 160] = [0 as u8; 160]

fn say(p: u64) {
    let _s: u64 = ulib.say(p)
}

fn kv(name: u64, v: u64) {
    say(name)
    ulib.sayn(v)
}

fn eine(nr: u64, eingabe: u64, name: u64, soll: u64) -> u64 {
    var s_a: [u8; 16] = "sucht: fall n=\0\0"
    var s_q: [u8; 6] = " q=[\0\0"
    var s_n: [u8; 10] = "] name=[\0\0"
    var s_r: [u8; 6] = "] rk=\0"
    var s_s: [u8; 8] = " soll=\0\0"
    var s_o: [u8; 6] = " ok=\0\0"
    var s_f: [u8; 8] = " falt=[\0"
    var s_z: [u8; 2] = "]\0"
    let ist: u64 = sucher.probe(eingabe, name)
    let _f: u64 = sucher.falten(name, (&gefaltet[0 as usize]) as u64, 160)
    say((&s_a[0 as usize]) as u64)
    ulib.sayn(nr)
    say((&s_q[0 as usize]) as u64)
    say(eingabe)
    say((&s_n[0 as usize]) as u64)
    say(name)
    say((&s_r[0 as usize]) as u64)
    ulib.sayn(ist)
    kv((&s_s[0 as usize]) as u64, soll)
    say((&s_f[0 as usize]) as u64)
    say((&gefaltet[0 as usize]) as u64)
    say((&s_z[0 as usize]) as u64)
    if ist == soll {
        kv((&s_o[0 as usize]) as u64, 1)
        ulib.nl()
        return 1
    }
    kv((&s_o[0 as usize]) as u64, 0)
    ulib.nl()
    return 0
}

fn u_start(args: u64) -> u64 {
    var s_h: [u8; 20] = "sucht: faelle gut=\0\0"
    var s_v: [u8; 6] = " von=\0"
    let _mk: u64 = msg.init()
    var gut: u64 = 0
    var n: u64 = 0

    var q0: [u8; 8] = "editor\0\0"
    var n0: [u8; 8] = "Editor\0\0"
    gut = gut + eine(0, (&q0[0 as usize]) as u64, (&n0[0 as usize]) as u64, 0)
    n = n + 1

    var q1: [u8; 8] = "EDITOR\0\0"
    var n1: [u8; 8] = "editor\0\0"
    gut = gut + eine(1, (&q1[0 as usize]) as u64, (&n1[0 as usize]) as u64, 0)
    n = n + 1

    var q2: [u8; 4] = "edi\0"
    var n2: [u8; 8] = "Editor\0\0"
    gut = gut + eine(2, (&q2[0 as usize]) as u64, (&n2[0 as usize]) as u64, 1)
    n = n + 1

    var q3: [u8; 4] = "tor\0"
    var n3: [u8; 8] = "Editor\0\0"
    gut = gut + eine(3, (&q3[0 as usize]) as u64, (&n3[0 as usize]) as u64, 2)
    n = n + 1

    var q4: [u8; 10] = "explorer\0\0"
    var n4: [u8; 16] = "Datei-Explorer\0\0"
    gut = gut + eine(4, (&q4[0 as usize]) as u64, (&n4[0 as usize]) as u64, 1)
    n = n + 1

    var q5: [u8; 6] = "plor\0\0"
    var n5: [u8; 16] = "Datei-Explorer\0\0"
    gut = gut + eine(5, (&q5[0 as usize]) as u64, (&n5[0 as usize]) as u64, 2)
    n = n + 1

    var q6: [u8; 10] = "nichtsda\0\0"
    var n6: [u8; 8] = "Editor\0\0"
    gut = gut + eine(6, (&q6[0 as usize]) as u64, (&n6[0 as usize]) as u64, 9)
    n = n + 1

    var q7: [u8; 4] = "gro\0"
    var n7: [u8; 8] = "Größe\0"
    gut = gut + eine(7, (&q7[0 as usize]) as u64, (&n7[0 as usize]) as u64, 1)
    n = n + 1

    var q8: [u8; 8] = "größe\0"
    var n8: [u8; 8] = "Größe\0"
    gut = gut + eine(8, (&q8[0 as usize]) as u64, (&n8[0 as usize]) as u64, 0)
    n = n + 1

    var q9: [u8; 8] = "GRÖSSE\0"
    var n9: [u8; 8] = "größe\0"
    gut = gut + eine(9, (&q9[0 as usize]) as u64, (&n9[0 as usize]) as u64, 0)
    n = n + 1

    var q10: [u8; 8] = "größ\0\0"
    var n10: [u8; 16] = "GRÖSSENANGABE\0\0"
    gut = gut + eine(10, (&q10[0 as usize]) as u64, (&n10[0 as usize]) as u64, 1)
    n = n + 1

    var q11: [u8; 6] = "öß\0\0"
    var n11: [u8; 8] = "Größe\0"
    gut = gut + eine(11, (&q11[0 as usize]) as u64, (&n11[0 as usize]) as u64, 2)
    n = n + 1

    var q12: [u8; 4] = "ä\0\0"
    var n12: [u8; 6] = "Bär\0\0"
    gut = gut + eine(12, (&q12[0 as usize]) as u64, (&n12[0 as usize]) as u64, 2)
    n = n + 1

    var q13: [u8; 4] = "Ä\0\0"
    var n13: [u8; 6] = "bär\0\0"
    gut = gut + eine(13, (&q13[0 as usize]) as u64, (&n13[0 as usize]) as u64, 2)
    n = n + 1

    var q14: [u8; 4] = "ue\0\0"
    var n14: [u8; 8] = "Grüße\0"
    gut = gut + eine(14, (&q14[0 as usize]) as u64, (&n14[0 as usize]) as u64, 2)
    n = n + 1

    var q15: [u8; 4] = "gru\0"
    var n15: [u8; 8] = "Grüße\0"
    gut = gut + eine(15, (&q15[0 as usize]) as u64, (&n15[0 as usize]) as u64, 1)
    n = n + 1

    var q16: [u8; 8] = "straße\0"
    var n16: [u8; 10] = "Straße 1\0"
    gut = gut + eine(16, (&q16[0 as usize]) as u64, (&n16[0 as usize]) as u64, 1)
    n = n + 1

    var q17: [u8; 2] = "x\0"
    var n17: [u8; 8] = "Größe\0"
    gut = gut + eine(17, (&q17[0 as usize]) as u64, (&n17[0 as usize]) as u64, 9)
    n = n + 1

    say((&s_h[0 as usize]) as u64)
    ulib.sayn(gut)
    kv((&s_v[0 as usize]) as u64, n)
    ulib.nl()
    if gut != n {
        return 1
    }
    return 0
}
