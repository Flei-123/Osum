
profile kernel

import ulib
import huffdec

export { gunzip_fd, out_total, E_OK, E_INPUT, E_FORMAT, E_CRC, E_IO }

const E_OK: u64 = 0
const E_INPUT: u64 = 1
const E_ROOM: u64 = 2
const E_FORMAT: u64 = 3
const E_CRC: u64 = 4
const E_IO: u64 = 5

const M32: u64 = 0xFFFFFFFF
const WIN: u64 = 32768
const WMASK: u64 = 32767

static mut win: [u8; 32768] = [0 as u8; 32768]
static mut crctab: [u64; 256] = [0 as u64; 256]
static mut crcready: u64 = 0

static mut out_fd: u64 = 0
static mut dpos: u64 = 0
static mut fpos: u64 = 0
static mut crc: u64 = 0

fn out_total() -> u64 {
    return dpos
}

fn crc_init() {
    if crcready == 1 {
        return
    }
    crcready = 1
    var n: u64 = 0
    while n < 256 {
        var c: u64 = n
        var k: u64 = 0
        while k < 8 {
            let mask: u64 = 0 -% (c & 1)
            c = (c >> 1) ^ (0xEDB88320 & mask)
            k = k + 1
        }
        crctab[(n) as usize] = c
        n = n + 1
    }
}
fn flush() {
    if dpos == fpos {
        return
    }
    let start: u64 = fpos & WMASK
    let n: u64 = dpos - fpos
    var c: u64 = crc
    var i: u64 = 0
    while i < n {
        c = crctab[((c ^ (win[(start + i) as usize] as u64)) & 255) as usize] ^ (c >> 8)
        i = i + 1
    }
    crc = c
    var o: u64 = 0
    while o < n {
        let w: u64 = ulib.sys(ulib.SYS_WRITE, out_fd, (&win[0 as usize]) as u64 + start + o, n - o)
        if ulib.bad(w) || w == 0 {
            huffdec.fail(E_IO)
            return
        }
        o = o + w
    }
    fpos = dpos
}

fn emit(c: u64) {
    win[(dpos & WMASK) as usize] = c as u8
    dpos = dpos + 1
    if (dpos & WMASK) == 0 {
        flush()
    }
}

fn block_body() -> bool {
    var going: bool = true
    while going {
        let s: u64 = huffdec.symbol()
        if s == ulib.EOF {
            return false
        }
        if s < 256 {
            emit(s)
            if huffdec.failed() {
                return false
            }
        } else if s == 256 {
            going = false
        } else {
            let len: u64 = huffdec.length_of(s)
            if len == 0 {
                return false
            }
            let dist: u64 = huffdec.dist()
            if dist == 0 {
                return false
            }
            if dist > dpos {
                huffdec.fail(E_FORMAT)
                return false
            }
            var k: u64 = 0
            while k < len {
                emit(win[((dpos - dist) & WMASK) as usize] as u64)
                if huffdec.failed() {
                    return false
                }
                k = k + 1
            }
        }
    }
    return true
}
fn inflate_blocks() {
    var last: u64 = 0
    while last == 0 && huffdec.ok() {
        last = huffdec.bits(1)
        let kind: u64 = huffdec.bits(2)
        if huffdec.failed() {
            last = 1
        } else if kind == 0 {
            huffdec.align()
            let len: u64 = le16()
            let nlen: u64 = le16()
            if huffdec.ok() {
                if (len ^ 0xFFFF) != nlen {
                    huffdec.fail(E_FORMAT)
                } else {
                    var i: u64 = 0
                    while i < len && huffdec.ok() {
                        emit(huffdec.getbyte())
                        i = i + 1
                    }
                }
            }
        } else if kind == 1 {
            huffdec.fixed_trees()
            block_body()
        } else if kind == 2 {
            if huffdec.dynamic_trees() {
                block_body()
            }
        } else {
            huffdec.fail(E_FORMAT)
        }
    }
}

fn le16() -> u64 {
    let a: u64 = huffdec.getbyte()
    let b: u64 = huffdec.getbyte()
    return a | (b << 8)
}

fn le32() -> u64 {
    let a: u64 = le16()
    let b: u64 = le16()
    return a | (b << 16)
}

fn skip(n: u64) {
    var i: u64 = 0
    while i < n && huffdec.ok() {
        huffdec.getbyte()
        i = i + 1
    }
}

fn skip_zstr() {
    var going: bool = true
    while going && huffdec.ok() {
        if huffdec.getbyte() == 0 {
            going = false
        }
    }
}
fn gunzip_fd(ifd: u64, ofd: u64) -> u64 {
    huffdec.begin_fd(ifd)
    crc_init()
    out_fd = ofd
    dpos = 0
    fpos = 0
    crc = M32
    let id1: u64 = huffdec.getbyte()
    let id2: u64 = huffdec.getbyte()
    let cm: u64 = huffdec.getbyte()
    let flg: u64 = huffdec.getbyte()
    if huffdec.failed() {
        return huffdec.status()
    }
    if id1 != 31 || id2 != 139 || cm != 8 || (flg & 224) != 0 {
        return E_FORMAT
    }
    skip(6)
    if (flg & 4) != 0 {
        let xl: u64 = le16()
        skip(xl)
    }
    if (flg & 8) != 0 {
        skip_zstr()
    }
    if (flg & 16) != 0 {
        skip_zstr()
    }
    if (flg & 2) != 0 {
        skip(2)
    }
    if huffdec.failed() {
        return huffdec.status()
    }
    inflate_blocks()
    if huffdec.failed() {
        return huffdec.status()
    }
    flush()
    if huffdec.failed() {
        return huffdec.status()
    }
    huffdec.align()
    let tcrc: u64 = le32()
    let tlen: u64 = le32()
    if huffdec.failed() {
        return huffdec.status()
    }
    if ((crc ^ M32) & M32) != tcrc || (dpos & M32) != tlen {
        return E_CRC
    }
    return E_OK
}
