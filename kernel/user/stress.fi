
profile kernel

import ulib

export { u_start }

const BLOCK: u64 = 65536

fn u_start(args: u64) -> u64 {
    var s_ok: [u8; 12] = "stress: ok \0"
    var s_kn: [u8; 15] = "stress: knapp \0"
    var s_use: [u8; 25] = "usage: stress <blocks>\0\0\0"

    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.esay_line((&s_use[0]) as u64, 0)
        return 1
    }
    let want: u64 = ulib.to_num(ulib.arg_at(args, 1))

    let base: u64 = ulib.sys(ulib.SYS_BRK, 0, 0, 0)
    if ulib.bad(base) || base == 0 {
        ulib.say_line((&s_kn[0]) as u64, 0)
        return 1
    }

    var got: u64 = 0
    var cur: u64 = base
    while got < want {
        let next: u64 = cur + BLOCK
        let r: u64 = ulib.sys(ulib.SYS_BRK, next, 0, 0)
        if ulib.bad(r) || r < next {
            ulib.say_line((&s_kn[0]) as u64, got)
            return 0
        }
        var off: u64 = 0
        while off < BLOCK {
            __mmio_write8((cur + off) as *mut u8, 65 as u8)
            off = off + 4096
        }
        cur = next
        got = got + 1
    }
    ulib.say_line((&s_ok[0]) as u64, got)
    return 0
}
