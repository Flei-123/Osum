profile app

import ulib
import libc.psched

export { u_start }

const DEFAULT_SAMPLES: u64 = 200
const SPIN_PER_SAMPLE: u64 = 300000
const MASK_BITS: u64 = 63

fn spin(seed: u64) -> u64 {
    var acc: u64 = seed
    var i: u64 = 0
    while i < SPIN_PER_SAMPLE {
        acc = acc +% (i ^ (acc >> 3)) +% 1
        i = i + 1
    }
    return acc
}

fn u_start(args: u64) -> u64 {
    var label_samples: [u8; 18] = "cpuprobe samples=\0"
    var label_mask: [u8; 7] = " mask=\0"
    var label_max: [u8; 6] = " max=\0"
    var label_sum: [u8; 6] = " sum=\0"
    var samples: u64 = DEFAULT_SAMPLES
    if ulib.arg_count(args) > 1 {
        let parsed: u64 = ulib.to_num(ulib.arg_at(args, 1))
        if parsed != 0 {
            samples = parsed
        }
    }
    var mask: u64 = 0
    var highest: u64 = 0
    var acc: u64 = 1
    var n: u64 = 0
    while n < samples {
        acc = spin(acc)
        let cpu: u64 = psched.getcpu()
        if cpu < MASK_BITS {
            mask = mask | (1 << cpu)
        }
        if cpu > highest {
            highest = cpu
        }
        n = n + 1
    }
    ulib.say((&label_samples[0 as usize]) as u64)
    ulib.sayu(samples)
    ulib.say((&label_mask[0 as usize]) as u64)
    ulib.sayu(mask)
    ulib.say((&label_max[0 as usize]) as u64)
    ulib.sayu(highest)
    ulib.say((&label_sum[0 as usize]) as u64)
    ulib.sayu(acc & 1)
    ulib.nl()
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
