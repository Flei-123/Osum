// SPDX-License-Identifier: GPL-2.0-only
profile app

import ulib
import libc.octets

export { target_of, build_arg, ARG_PREFIX, URI_CAP }

const URI_CAP: u64 = 96
const PREFIX_LEN: u64 = 7

static mut ARG_PREFIX: [u8; 8] = "target=\0"
static mut FLAG_WORD: [u8; 9] = "--target\0"

fn has_prefix(a: u64) -> bool {
    var i: u64 = 0
    while i < PREFIX_LEN {
        if octets.ld8(a, i) != octets.ld8((&ARG_PREFIX[0 as usize]) as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn copy_uri(src: u64, out: u64, cap: u64) -> u64 {
    var n: u64 = 0
    while octets.ld8(src, n) != 0 && n + 1 < cap {
        octets.st8(out, n, octets.ld8(src, n))
        n = n + 1
    }
    octets.st8(out, n, 0)
    return n
}

fn target_of(args: u64, out: u64, cap: u64) -> u64 {
    octets.st8(out, 0, 0)
    let argc: u64 = ulib.arg_count(args)
    var i: u64 = 1
    while i < argc {
        let a: u64 = ulib.arg_at(args, i)
        if has_prefix(a) {
            return copy_uri(a + PREFIX_LEN, out, cap)
        }
        if ulib.streq(a, (&FLAG_WORD[0 as usize]) as u64) && i + 1 < argc {
            return copy_uri(ulib.arg_at(args, i + 1), out, cap)
        }
        i = i + 1
    }
    return 0
}

fn build_arg(uri: u64, out: u64, cap: u64) -> u64 {
    var n: u64 = copy_uri((&ARG_PREFIX[0 as usize]) as u64, out, cap)
    n = n + copy_uri(uri, out + n, cap - n)
    return n
}
