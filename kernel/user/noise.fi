// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/krach.fi -- RUNDE PROTOKOLL: EIN ABSTURZ AUF BESTELLUNG.
//
// Das Werkzeug, mit dem `tools/protokoll/run.sh` die Punkte (b), (c)
// und (d) der Abnahme misst. Es gibt drei Arten:
//
//     krach kern      eine KERNEL-PANIK (Aufruf 1861). Die Maschine ist
//                     danach weg -- das ist der Sinn.
//     krach ud        dasselbe mit einem ungueltigen Befehl statt einem
//                     Seitenfehler: anderer Vektor, gleicher Weg.
//     krach prog      ein NULLZEIGER IN DIESEM PROGRAMM. Der Kern lebt
//                     weiter, dieser Prozess stirbt, und in /var/crash
//                     liegt hinterher ein Bericht mit dem Programmnamen.
//
// WARUM DIE ERSTEN BEIDEN EINEN RIEGEL HABEN UND DIE DRITTE NICHT: die
// ersten beiden HALTEN DIE MASCHINE AN. Der Kern nimmt sie nur an, wenn
// `krach` auf seiner Befehlszeile steht UND der Rufer Wurzel ist
// (`sys.do_krach`); ohne beides kommt -EPERM zurueck und dieses
// Programm sagt es. Die dritte braucht keinen Riegel -- jedes Programm
// darf jederzeit ueber einen eigenen Nullzeiger fallen, das ist keine
// Erlaubnis, sondern ein Fehler.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var a_kern: [u8; 5] = "kern\0"
    var a_ud: [u8; 3] = "ud\0"
    var a_prog: [u8; 5] = "prog\0"
    var s_hilf: [u8; 25] = "krach kern | ud | prog\0\0\0"
    var s_perm: [u8; 47] = "krach: der Kern hat abgelehnt (krach? Wurzel?)\0"
    var s_los: [u8; 35] = "krach: Nullzeiger in Ring 3, jetzt\0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        line_clear((&s_hilf[0 as usize]) as u64)
        return 1
    }
    let a: u64 = ulib.arg_at(args, 1)
    if ulib.streq(a, (&a_prog[0 as usize]) as u64) {
        line_clear((&s_los[0 as usize]) as u64)
        // EIN LESEZUGRIFF AUF SEITE 0. In Ring 3 ist sie nicht
        // abgebildet -- anders als im Kern, wo das erste Gigabyte eins
        // zu eins liegt (siehe `absturz.knall_c`). Also #PF in Ring 3,
        // SIGSEGV, dieser Prozess stirbt, der Kern laeuft weiter.
        //
        // `__mmio_read64` UND NICHT `*(0 as *mut u64)`, und das ist
        // gemessen: der erste Anlauf schrieb den gewoehnlichen
        // Lesezugriff hin, dessen Ergebnis niemand benutzt -- firnc
        // hat ihn weggelassen, und `krach prog` lief seelenruhig durch
        // und gab 0 zurueck. Ein MMIO-Zugriff darf nicht verschoben,
        // zusammengefasst oder entfernt werden (`kstate.fi`, Kopf);
        // genau diese Zusage wird hier gebraucht.
        let _v: u64 = __mmio_read64(0 as *mut u64)
        return 0
    }
    var art: u64 = 0
    if ulib.streq(a, (&a_ud[0 as usize]) as u64) {
        art = 1
    } else if !ulib.streq(a, (&a_kern[0 as usize]) as u64) {
        line_clear((&s_hilf[0 as usize]) as u64)
        return 1
    }
    let r: u64 = ulib.sys(ulib.SYS_KRACH, art, 0, 0)
    // HIERHER KOMMT NUR, WER ABGEWIESEN WURDE. Wenn der Aufruf
    // durchging, steht die Maschine.
    ulib.esay_line((&s_perm[0 as usize]) as u64, 0)
    return 1
}

// `ulib.say_line` haengt eine ZAHL an; hier soll nur eine Zeile
// heraus. Zwei Aufrufe, ein Name.
fn line_clear(p: u64) {
    ulib.say(p)
    ulib.nl()
}
