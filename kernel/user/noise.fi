
profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var a_kern: [u8; 5] = "kern\0"
    var a_ud: [u8; 3] = "ud\0"
    var a_kfs: [u8; 7] = "kernfs\0"
    var a_prog: [u8; 5] = "prog\0"
    var a_dop: [u8; 7] = "doppel\0"
    var s_hilf: [u8; 41] = "krach kern | kernfs | ud | prog | doppel\0"
    var s_perm: [u8; 47] = "krach: der Kern hat abgelehnt (krach? Wurzel?)\0"
    var s_los: [u8; 35] = "krach: Nullzeiger in Ring 3, jetzt\0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        line_clear((&s_hilf[0 as usize]) as u64)
        return 1
    }
    let a: u64 = ulib.arg_at(args, 1)
    if ulib.streq(a, (&a_prog[0 as usize]) as u64) {
        line_clear((&s_los[0 as usize]) as u64)
        let _v: u64 = __mmio_read64(0 as *mut u64)
        return 0
    }
    var art: u64 = 0
    if ulib.streq(a, (&a_ud[0 as usize]) as u64) {
        art = 1
    } else if ulib.streq(a, (&a_kfs[0 as usize]) as u64) {
        art = 2
    } else if ulib.streq(a, (&a_dop[0 as usize]) as u64) {
        art = 3
    } else if !ulib.streq(a, (&a_kern[0 as usize]) as u64) {
        line_clear((&s_hilf[0 as usize]) as u64)
        return 1
    }
    let r: u64 = ulib.sys(ulib.SYS_KRACH, art, 0, 0)
    ulib.esay_line((&s_perm[0 as usize]) as u64, 0)
    return 1
}

fn line_clear(p: u64) {
    ulib.say(p)
    ulib.nl()
}
