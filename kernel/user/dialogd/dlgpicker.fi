profile app

import lineout
import msg
import busy
import fuiscene
import fuiapp.hostkey
import libc.io
import libc.errno
import libc.kcall
import libc.octets
import libc.text
import services.dlgproto
import dialogd.dlgdir

export { run, content_ptr, content_len, chosen_name }

const K_LIST: u64 = 1
const K_ACT: u64 = 2
const K_CANCEL: u64 = 3
const K_NAME: u64 = 4

const WIN_X: u64 = 120
const WIN_Y: u64 = 80
const WIN_W: u64 = 560
const WIN_H_OPEN: u64 = 360
const WIN_H_SAVE: u64 = 410
const TABLE_W: u64 = 544
const TABLE_H: u64 = 230
const TABLE_MIN_H: u64 = 90
const BUTTON_H: u64 = 36
const BUTTON_W: u64 = 120
const BAR_GAP: u64 = 8
const COL_NAME_W: u64 = 340
const COL_SIZE_W: u64 = 200
const CONTENT_CAP: u64 = 65536
const SLASH: u64 = 47
const DOT: u64 = 46

static mut content: [u8; 65536] = [0 as u8; 65536]
static mut content_n: u64 = 0
static mut picked: [u8; 64] = [0 as u8; 64]
static mut g_mode: u64 = 0
static mut g_title: u64 = 0
static mut g_hint: u64 = 0
static mut g_input: u64 = 0
static mut g_answer: u64 = 0
static mut g_done: bool = false
static mut g_table_h: u64 = 230

static mut k_open: [u8; 16] = "dialogd.openbtn\0"
static mut k_save: [u8; 16] = "dialogd.savebtn\0"
static mut k_col_name: [u8; 17] = "dialogd.col.name\0"
static mut k_col_size: [u8; 17] = "dialogd.col.size\0"
static mut k_folder: [u8; 15] = "dialogd.folder\0"
static mut k_replace: [u8; 16] = "dialogd.replace\0"
static mut k_cancel: [u8; 14] = "dialog.cancel\0"
static mut s_list: [u8; 17] = "dialogd: list n=\0"
static mut s_geom: [u8; 17] = "dialogd: geom w=\0"
static mut s_h: [u8; 4] = " h=\0"
static mut s_s: [u8; 4] = " s=\0"
static mut s_dir: [u8; 6] = " dir=\0"
static mut s_ready: [u8; 16] = "dialogd: ready\0\0"

fn content_ptr() -> u64 {
    return (&content[0 as usize]) as u64
}

fn content_len() -> u64 {
    return content_n
}

fn chosen_name() -> u64 {
    return (&picked[0 as usize]) as u64
}

fn cell_of(row: u64, col: u64) -> u64 {
    if row == fuiscene.HEAD_ROW {
        if col == 0 {
            return msg.get((&k_col_name[0 as usize]) as u64)
        }
        return msg.get((&k_col_size[0 as usize]) as u64)
    }
    if col == 1 && dlgdir.is_dir(row) && !dlgdir.is_up(row) {
        return msg.get((&k_folder[0 as usize]) as u64)
    }
    return dlgdir.cell(row, col)
}

fn is_save() -> bool {
    return g_mode == dlgproto.MODE_SAVE
}

fn action_label() -> u64 {
    if is_save() {
        return msg.get((&k_save[0 as usize]) as u64)
    }
    return msg.get((&k_open[0 as usize]) as u64)
}

fn build() {
    let col: usize = fuiscene.root()
    let _p: usize = fuiscene.label_muted(col, dlgdir.cur_dir())
    let _t: usize = fuiscene.table(col, K_LIST, TABLE_W, g_table_h, 2, true, dlgdir.count(), cell_of)
    if is_save() {
        let _e: usize = fuiscene.entry(col, K_NAME, TABLE_W, g_hint)
    }
    let bar: usize = fuiscene.row(col)
    fuiscene.set_gap(bar, BAR_GAP)
    let b1: usize = fuiscene.button_main(bar, action_label(), K_ACT)
    fuiscene.set_size(b1, BUTTON_W, BUTTON_H)
    let b2: usize = fuiscene.button(bar, msg.get((&k_cancel[0 as usize]) as u64), K_CANCEL)
    fuiscene.set_size(b2, BUTTON_W, BUTTON_H)
}

fn finish(answer: u64) {
    g_answer = answer
    g_done = true
}

fn selected() -> u64 {
    let row: u64 = fuiscene.table_sel(K_LIST)
    if row >= dlgdir.count() {
        return dlgdir.NONE_ROW
    }
    return row
}

fn reload_table() {
    fuiscene.table_set_rows(K_LIST, dlgdir.count())
    fuiscene.table_set_sel(K_LIST, 0)
    fuiscene.refresh()
}

fn read_into_buffer(path: u64) -> bool {
    let size: u64 = io.size_of(path)
    if errno.failed(size) || size > CONTENT_CAP {
        return false
    }
    let fd: u64 = io.open(path, kcall.O_RDONLY)
    if errno.failed(fd) {
        return false
    }
    let got: u64 = io.read_full(fd, content_ptr(), size)
    io.close(fd)
    if errno.failed(got) {
        return false
    }
    content_n = got
    return true
}

fn remember_name(name: u64) {
    octets.zero(chosen_name(), 64)
    octets.copy(chosen_name(), name, text.length(name))
}

fn commit_open(row: u64) {
    if !read_into_buffer(dlgdir.path_of(row)) {
        finish(dlgproto.ANSWER_FAILED)
        return
    }
    remember_name(dlgdir.name_of(row))
    finish(dlgproto.ANSWER_OK)
}

fn safe_name(name: u64) -> bool {
    let n: u64 = text.length(name)
    if n == 0 || n >= dlgdir.NAME_CAP {
        return false
    }
    if n <= 2 && octets.ld8(name, 0) == DOT && (n == 1 || octets.ld8(name, 1) == DOT) {
        return false
    }
    var i: u64 = 0
    while i < n {
        if octets.ld8(name, i) == SLASH {
            return false
        }
        i = i + 1
    }
    return true
}

fn replace_allowed(path: u64) -> bool {
    if errno.failed(io.size_of(path)) {
        return true
    }
    return busy.confirm(g_title, msg.get((&k_replace[0 as usize]) as u64))
}

fn write_target(path: u64) -> bool {
    let fd: u64 = io.create(path)
    if errno.failed(fd) {
        return false
    }
    let wrote: u64 = io.write_all(fd, content_ptr(), content_n)
    io.close(fd)
    return !errno.failed(wrote) && wrote == content_n
}

fn commit_save() {
    let name: u64 = fuiscene.entry_text(K_NAME)
    var path: [u8; 320] = [0 as u8; 320]
    let p: u64 = (&path[0 as usize]) as u64
    if !safe_name(name) || !dlgdir.join(dlgdir.cur_dir(), name, p, 320) {
        return
    }
    if !replace_allowed(p) {
        return
    }
    if !read_into_buffer(g_input) || !write_target(p) {
        finish(dlgproto.ANSWER_FAILED)
        return
    }
    remember_name(name)
    finish(dlgproto.ANSWER_OK)
}

fn activate(row: u64) {
    if row != dlgdir.NONE_ROW && dlgdir.enter(row) {
        reload_table()
        return
    }
    if !is_save() && row != dlgdir.NONE_ROW {
        commit_open(row)
    }
}

fn on_action() {
    if is_save() {
        commit_save()
        return
    }
    activate(selected())
}

fn sync_name(last_row: u64) -> u64 {
    let row: u64 = selected()
    if row == last_row || row == dlgdir.NONE_ROW {
        return row
    }
    if is_save() && !dlgdir.is_dir(row) {
        fuiscene.entry_set(K_NAME, dlgdir.name_of(row))
    }
    return row
}

fn say_ready() {
    lineout.add_text((&s_list[0 as usize]) as u64)
    lineout.add_num(dlgdir.count())
    lineout.add_text((&s_dir[0 as usize]) as u64)
    lineout.add_text(dlgdir.cur_dir())
    lineout.end_line()
    lineout.add_text((&s_geom[0 as usize]) as u64)
    lineout.add_num(WIN_W)
    lineout.add_text((&s_h[0 as usize]) as u64)
    lineout.add_num(window_h())
    lineout.add_text((&s_s[0 as usize]) as u64)
    lineout.add_num(fuiscene.scale())
    lineout.end_line()
    lineout.add_text((&s_ready[0 as usize]) as u64)
    lineout.end_line()
}

fn window_h() -> u64 {
    if is_save() {
        return WIN_H_SAVE
    }
    return WIN_H_OPEN
}

fn fit_to_work_area() {
    let over: u64 = fuiscene.work_overflow()
    if over == 0 {
        return
    }
    var cut: u64 = over
    if cut > TABLE_H - TABLE_MIN_H {
        cut = TABLE_H - TABLE_MIN_H
    }
    g_table_h = TABLE_H - cut
    if fuiscene.win_shrink(cut) {
        fuiscene.refresh()
    }
}

fn first_frame() {
    fit_to_work_area()
    fuiscene.table_colw(K_LIST, 0, COL_NAME_W)
    fuiscene.table_colw(K_LIST, 1, COL_SIZE_W)
    if is_save() {
        fuiscene.focus(K_NAME)
    } else {
        fuiscene.focus(K_LIST)
    }
    say_ready()
}

fn dispatch(key: u64, esc: bool) {
    if key == K_CANCEL || esc {
        finish(dlgproto.ANSWER_CANCEL)
    } else if key == K_ACT || key == K_NAME {
        on_action()
    } else if key == K_LIST {
        activate(selected())
    }
}

fn run(mode: u64, title: u64, hint: u64, accept: u64, input_path: u64) -> u64 {
    g_mode = mode
    g_title = title
    g_hint = hint
    g_input = input_path
    g_answer = dlgproto.ANSWER_CANCEL
    g_done = false
    g_table_h = TABLE_H
    content_n = 0
    dlgdir.start(accept)
    if !fuiscene.open(WIN_X, WIN_Y, WIN_W, window_h(), title, build) {
        return dlgproto.ANSWER_FAILED
    }
    var first: bool = true
    var key_seen: u64 = fuiscene.key_seq()
    var shown_row: u64 = dlgdir.NONE_ROW
    while fuiscene.alive() && !g_done {
        let key: u64 = fuiscene.pump()
        let seq: u64 = fuiscene.key_seq()
        let esc: bool = seq != key_seen && fuiscene.key_any() == hostkey.KEY_ESC
        key_seen = seq
        if first {
            first = false
            first_frame()
        }
        dispatch(key, esc)
        shown_row = sync_name(shown_row)
    }
    return g_answer
}
