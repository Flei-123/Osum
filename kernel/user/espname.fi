profile kernel

import ulib
import libc.text

export { of }

const NAME_MAX: u64 = 24

static mut NAME: [u8; 24] = [0 as u8; 24]

fn of(dev: u64, nr: u64) -> u64 {
    let p: u64 = (&NAME[0 as usize]) as u64
    ulib.strcpy(p, dev)
    let n: u64 = text.length(p)
    if n + 2 < NAME_MAX && nr >= 1 && nr <= 9 {
        __mmio_write8((p + n) as *mut u8, (48 + nr) as u8)
        __mmio_write8((p + n + 1) as *mut u8, 0 as u8)
    }
    return p
}
