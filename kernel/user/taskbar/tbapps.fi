profile app

import icons
import taskbar.tbbase
import taskbar.tbmetrics
import traypop
import uikit.uiicon
import uitheme

export { refresh, index_at, id_at, paint, click, context, rect_x, rect_y, rect_w, rect_h, icon_glyph, tip_at }

const NO_APP: u64 = 0xFFFFFFFFFFFFFFFF
const MAX_BAR_APPS: u64 = 6
const ICON_FIRST_CODEPOINT: u64 = 0xE000
static mut s_apps_paint: [u8; 19] = "taskbar: app icon \0"
static mut s_apps_id: [u8; 5] = " id=\0"
static mut s_apps_glyph: [u8; 8] = " glyph=\0"
static mut s_apps_xy: [u8; 4] = " x=\0"
static mut s_apps_yy: [u8; 4] = " y=\0"

fn load_places() {
    if tbbase.apps_places_new == 0 {
        return
    }
    tbbase.apps_places_new = 0
    traypop.app_places_parse((&tbbase.apps_places[0 as usize]) as u64, tbbase.apps_places_n)
}

fn bar_signature(n: u64) -> u64 {
    var sig: u64 = n
    var i: u64 = 0
    while i < n {
        let id: u64 = traypop.app_bar_id(i)
        sig = sig * 31 + id * 7 + traypop.app_icon(id)
        i = i + 1
    }
    return sig
}

fn refresh() -> bool {
    let _s: bool = traypop.app_sync()
    load_places()
    var n: u64 = traypop.app_bar_count()
    if n > MAX_BAR_APPS {
        n = MAX_BAR_APPS
    }
    let sig: u64 = bar_signature(n)
    if n == tbbase.apps_n && sig == tbbase.apps_sig {
        return false
    }
    tbbase.apps_n = n
    tbbase.apps_sig = sig
    return true
}

fn rect_x(f: u64, i: u64) -> u64 {
    if tbbase.vertical != 0 {
        return tbbase.f_x[(f) as usize]
    }
    return tbbase.f_x[(f) as usize] + i * tbmetrics.tr_cell()
}

fn rect_y(f: u64, i: u64) -> u64 {
    if tbbase.vertical != 0 {
        return tbbase.f_y[(f) as usize] + i * tbmetrics.btn_h()
    }
    return tbbase.f_y[(f) as usize]
}

fn rect_w(f: u64) -> u64 {
    if tbbase.vertical != 0 {
        return tbbase.f_w[(f) as usize]
    }
    return tbmetrics.tr_cell()
}

fn rect_h(f: u64) -> u64 {
    if tbbase.vertical != 0 {
        return tbmetrics.btn_h()
    }
    return tbbase.f_h[(f) as usize]
}

fn index_at(x: u64, y: u64) -> u64 {
    let f: u64 = tbbase.F_APPS
    if tbbase.f_w[(f) as usize] == 0 {
        return NO_APP
    }
    var i: u64 = 0
    while i < tbbase.apps_n {
        let rx: u64 = rect_x(f, i)
        let ry: u64 = rect_y(f, i)
        if x >= rx && x < rx + rect_w(f) && y >= ry && y < ry + rect_h(f) {
            return i
        }
        i = i + 1
    }
    return NO_APP
}

fn id_at(x: u64, y: u64) -> u64 {
    let i: u64 = index_at(x, y)
    if i == NO_APP {
        return 0
    }
    return traypop.app_bar_id(i)
}

fn tip_at(x: u64, y: u64) -> u64 {
    let id: u64 = id_at(x, y)
    if id == 0 {
        return 0
    }
    return traypop.app_tip(id)
}

fn icon_glyph(id: u64) -> u64 {
    let ic: u64 = traypop.app_icon(id)
    if ic >= ICON_FIRST_CODEPOINT {
        return ic
    }
    return icons.FILE_PROGRAM
}

fn paint(report: bool) {
    let f: u64 = tbbase.F_APPS
    var i: u64 = 0
    while i < tbbase.apps_n {
        let id: u64 = traypop.app_bar_id(i)
        let gid: u64 = icon_glyph(id)
        let gx: u64 = rect_x(f, i) + (rect_w(f) - tbmetrics.gl_w()) / 2
        let gy: u64 = rect_y(f, i)
        let _d: bool = uiicon.icon_mid_ink(gid, gx, gy, tbmetrics.gl_w(), rect_h(f), tbmetrics.gl_w(),
            uitheme.theme(uitheme.T_FG))
        if report {
            tbmetrics.say((&s_apps_paint[0 as usize]) as u64)
            tbmetrics.sayn(i)
            tbmetrics.say((&s_apps_id[0 as usize]) as u64)
            tbmetrics.sayn(id)
            tbmetrics.say((&s_apps_glyph[0 as usize]) as u64)
            tbmetrics.sayn(gid)
            tbmetrics.say((&s_apps_xy[0 as usize]) as u64)
            tbmetrics.sayn(gx)
            tbmetrics.say((&s_apps_yy[0 as usize]) as u64)
            tbmetrics.sayn(gy)
            tbmetrics.nl()
        }
        i = i + 1
    }
}

fn click(x: u64, y: u64) -> bool {
    let id: u64 = id_at(x, y)
    if id == 0 {
        return false
    }
    traypop.app_click(id)
    return true
}

fn context(x: u64, y: u64) -> bool {
    let i: u64 = index_at(x, y)
    if i == NO_APP {
        return false
    }
    let f: u64 = tbbase.F_APPS
    traypop.app_menu_at(traypop.app_bar_id(i), tbbase.bar_x + rect_x(f, i), tbbase.bar_y + rect_y(f, i), rect_w(f), rect_h(f))
    return true
}
