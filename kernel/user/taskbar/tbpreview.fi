profile app

import fuiapp.hosthead
import taskview
import libc.clockapi
import taskbar.tbbase

export { step }

const OPEN_TICKS: u64 = 30
const LEAVE_TICKS: u64 = 60
const APP_BYTES: u64 = 24

static mut hot_button: u64 = 0
static mut hot_since: u64 = 0
static mut left_at: u64 = 0
static mut pressed_on: u64 = 0

fn has_windows(m: u64) -> bool {
    return m >= 1 && m <= tbbase.nk && tbbase.kcnt[(m - 1) as usize] != 0
}

fn pin_target(lx: u64, ly: u64) -> u64 {
    var k: u64 = 0
    while k < tbbase.npin {
        if tbbase.pinwin[(k) as usize] < tbbase.MAXK && tbbase.pw_[(k) as usize] != 0
            && lx >= tbbase.px_[(k) as usize] && lx < tbbase.px_[(k) as usize] + tbbase.pw_[(k) as usize]
            && ly >= tbbase.py_[(k) as usize] && ly < tbbase.py_[(k) as usize] + tbbase.ph_[(k) as usize] {
            return tbbase.pinwin[(k) as usize] + 1
        }
        k = k + 1
    }
    return 0
}

fn target_of(m: u64, mx: u64, my: u64) -> u64 {
    if m != 0 || mx < tbbase.bar_x || my < tbbase.bar_y {
        return m
    }
    return pin_target(mx - tbbase.bar_x, my - tbbase.bar_y)
}

fn center_of(j: u64) -> u64 {
    if tbbase.kw[(j) as usize] != 0 {
        return tbbase.kx[(j) as usize] + tbbase.kw[(j) as usize] / 2
    }
    var k: u64 = 0
    while k < tbbase.npin {
        if tbbase.pinwin[(k) as usize] == j {
            return tbbase.px_[(k) as usize] + tbbase.pw_[(k) as usize] / 2
        }
        k = k + 1
    }
    return 0
}

fn open_for(m: u64) -> bool {
    let j: u64 = m - 1
    let cx: u64 = tbbase.bar_x + center_of(j)
    return taskview.preview_open((&tbbase.kapp[0 as usize]) as u64 + j * APP_BYTES, cx,
        tbbase.bar_y, tbbase.bar_y + tbbase.bar_h)
}

fn keep_open(m: u64, mx: u64, my: u64, now: u64) -> bool {
    if taskview.hit(mx, my) || (m == hot_button && has_windows(m)) {
        left_at = now
        return true
    }
    if has_windows(m) {
        taskview.preview_shut()
        return false
    }
    if now < left_at {
        left_at = now
    }
    if now - left_at >= LEAVE_TICKS {
        taskview.preview_shut()
        return false
    }
    return true
}

fn dwell(m: u64, now: u64) {
    if m != hot_button {
        hot_button = m
        hot_since = now
        return
    }
    if now < hot_since {
        hot_since = now
    }
    if now - hot_since >= OPEN_TICKS && open_for(m) {
        left_at = now
    }
}

fn step(hover: u64, mx: u64, my: u64) -> bool {
    let m: u64 = target_of(hover, mx, my)
    let now: u64 = clockapi.ticks()
    if taskview.is_open() && !taskview.preview_is_open() {
        hot_button = 0
        return false
    }
    if taskview.preview_is_open() {
        if keep_open(m, mx, my, now) {
            return true
        }
    }
    if !has_windows(m) {
        hot_button = 0
        pressed_on = 0
        return false
    }
    if (hosthead.mouse_btn() & 1) != 0 {
        pressed_on = m
    }
    if pressed_on == m {
        return true
    }
    pressed_on = 0
    dwell(m, now)
    return true
}
