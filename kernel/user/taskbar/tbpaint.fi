const BAND: u64 = 80

static mut st_said: u64 = 99

static mut fk_said: u64 = 99

static mut pdrag_i: u64 = 0

static mut pdrag_x0: u64 = 0

static mut pdrag_y0: u64 = 0

static mut pdrag_target: u64 = 0

const PDRAG_SCHWELLE: u64 = 6

static mut lk_sx: [u8; 18] = "taskbar: start x=\0"

static mut lk_sy: [u8; 5] = " y=\0\0"

static mut lk_sw: [u8; 5] = " w=\0\0"

static mut lk_sh: [u8; 5] = " h=\0\0"

static mut lk_sg: [u8; 8] = " align=\0"

static mut lk_ic: [u8; 21] = "taskbar: icon field=\0"

static mut lk_no: [u8; 24] = "taskbar: noglyph field=\0"

static mut lk_bat: [u8; 4] = "bat\0"

static mut lk_snd: [u8; 4] = "snd\0"

static mut lk_noti: [u8; 5] = "noti\0"

static mut lk_net: [u8; 4] = "net\0"

static mut lk_id: [u8; 6] = " id=\0\0"

static mut lk_px: [u8; 6] = " px=\0\0"

static mut lk_ink: [u8; 9] = " inkbox=\0"

static mut lk_st: [u8; 8] = " state=\0"

static mut s_hv: [u8; 16] = "taskbar: hover \0"

static mut m_start: [u8; 6] = "start\0"

static mut m_clk: [u8; 6] = "clock\0"

static mut m_bat: [u8; 8] = "battery\0"

static mut m_net: [u8; 4] = "net\0"

static mut m_snd: [u8; 4] = "snd\0"

static mut m_noti: [u8; 5] = "noti\0"

static mut m_rem: [u8; 7] = "remote\0"

static mut m_lang: [u8; 5] = "lang\0"

static mut m_btn: [u8; 7] = "button\0"

static mut m_plug: [u8; 5] = "plug\0"

static mut s_pl: [u8; 18] = "taskbar: plug nr=\0"

static mut s_bt: [u8; 17] = "taskbar: btn i=\0\0"

static mut s_grp: [u8; 16] = "taskbar: grp i=\0"

static mut s_grpn: [u8; 4] = " n=\0"

static mut s_pil: [u8; 18] = "taskbar: pille i=\0"

static mut s_pilx: [u8; 4] = " x=\0"

static mut s_pilw: [u8; 4] = " w=\0"

static mut s_piltx: [u8; 5] = " tx=\0"

static mut s_piltw: [u8; 5] = " tw=\0"

static mut s_sy: [u8; 18] = "taskbar: sym btn=\0"

static mut s_syn: [u8; 7] = " app=\0\0"

static mut s_syw: [u8; 5] = " w=\0\0"

static mut s_syi: [u8; 7] = " ink=\0\0"

static mut s_pin: [u8; 16] = "taskbar: pin \0\0\0"

static mut s_pinx: [u8; 4] = " x=\0"

static mut s_piny: [u8; 4] = " y=\0"

static mut s_pinw: [u8; 4] = " w=\0"

static mut s_pinh: [u8; 4] = " h=\0"

static mut s_pinsy: [u8; 6] = " sym=\0"

static mut s_pinrun: [u8; 10] = " running=\0"

static mut s_pinact: [u8; 22] = "taskbar: pin schalte \0"

static mut s_pd0: [u8; 22] = "taskbar: pin ziehe \0\0\0"

static mut s_pdd: [u8; 5] = " dx=\0"

static mut s_pdm: [u8; 23] = "taskbar: pin target=\0\0\0"

static mut s_pd1: [u8; 25] = "taskbar: pin follow \0\0\0\0\0"

static mut s_komma: [u8; 2] = ",\0"

static mut s_syg: [u8; 10] = " gemalt=\0\0"

static mut s_syk: [u8; 10] = " button=\0\0"

static mut s_bi: [u8; 5] = " id=\0"

static mut s_bv: [u8; 9] = " hidden=\0"

static mut s_bf: [u8; 8] = " focus=\0"

static mut s_fl: [u8; 17] = "taskbar: field \0\0"

static mut s_ftw: [u8; 5] = " tw=\0"

static mut s_fn: [u8; 8] = " lines=\0"

static mut s_bn: [u8; 7] = " netv=\0"

static mut s_bmx: [u8; 8] = " mkx=\0\0\0"

static mut s_bmy: [u8; 8] = " mky=\0\0\0"

static mut s_ic: [u8; 18] = "taskbar: state s=\0"

static mut s_fk: [u8; 21] = "taskbar: faking fb=\0\0"

static mut s_fkno: [u8; 24] = "taskbar: notfaking fb=\0\0"

static mut s_tvl: [u8; 21] = "taskbar: taskview x=\0"

static mut s_chl: [u8; 20] = "taskbar: chevron x=\0"

static mut s_grl: [u8; 18] = "taskbar: group x=\0"

static mut s_opn: [u8; 7] = " open=\0"

fn status_glyph(f: u64, gid: u64, colour: u64, tag: u64, report: bool) -> u64 {
    let gx: u64 = tbbase.f_x[(f) as usize] + tbmetrics.tr_pad()
    let gy: u64 = tbbase.f_y[(f) as usize]
    if !wlibc.icon_mid_ink(gid, gx, gy, tbmetrics.gl_w(), tbbase.f_h[(f) as usize], tbmetrics.gl_w(), colour) {
        if report {
            tbmetrics.say((&lk_no[0 as usize]) as u64)
            tbmetrics.say(tag)
            tbmetrics.nl()
        }
        return 0
    }
    if report {
        tbmetrics.say((&lk_ic[0 as usize]) as u64)
        tbmetrics.say(tag)
        tbmetrics.say((&lk_id[0 as usize]) as u64)
        tbmetrics.sayn(gid)
        tbmetrics.say((&tbbase.s_tX[0 as usize]) as u64)
        tbmetrics.sayn(gx)
        tbmetrics.say((&tbbase.s_gy[0 as usize]) as u64)
        tbmetrics.sayn(gy)
        tbmetrics.say((&lk_px[0 as usize]) as u64)
        tbmetrics.sayn(tbmetrics.gl_w())
        tbmetrics.say((&lk_ink[0 as usize]) as u64)
        tbmetrics.sayn(wlibc.icon_ink_w(gid, tbmetrics.gl_w()) * wlibc.icon_ink_h(gid, tbmetrics.gl_w()))
        tbmetrics.nl()
    }
    return tbmetrics.tr_icx()
}

fn paint_band(y0: u64, hh: u64, report: bool) {
    wlibc.set_band(y0)
    wlibc.clip_set(0, y0, tbbase.win_w, y0 + hh)
    let gbase: u64 = uitheme.theme(wlibc.C_TASKBAR_BG)
    wlib.draw_area(0, y0, tbbase.win_w, hh, gbase)

    if tbbase.cf_edge == wlibc.WE_BOTTOM {
        wlib.draw_line(0, 0, tbbase.win_w, uitheme.theme(wlibc.C_BORDER))
    } else if tbbase.cf_edge == wlibc.WE_TOP {
        wlib.draw_line(0, tbbase.win_h - 1, tbbase.win_w,
            uitheme.theme(wlibc.C_BORDER))
    } else if tbbase.cf_edge == wlibc.WE_LEFT {
        wlib.draw_area(tbbase.win_w - 1, y0, 1, hh,
            uitheme.theme(wlibc.C_BORDER))
    } else {
        wlib.draw_area(0, y0, 1, hh,
            uitheme.theme(wlibc.C_BORDER))
    }
    if tbbase.shown == 0 {
        let _p0: u64 = bar_push(y0, hh)
        tbbase.ub_px = tbbase.ub_px + _p0
        tbbase.ub_soll = tbbase.ub_soll + tbbase.win_w * hh
        if _p0 == 0 {
            tbbase.ub_null = tbbase.ub_null + 1
        }
        return
    }
    var st_app: [u8; 9] = "launcher\0"
    var ssym: u64 = tblayout.sym_of((&st_app[0 as usize]) as u64)
    var st_empty: [u8; 2] = "\0\0"
    var st_txt: u64 = tbmetrics.txt((&tbbase.k_start[0 as usize]) as u64,
        (&tbbase.s_st[0 as usize]) as u64)
    if tbbase.cf_labels == tbbase.LB_NEVER {
        st_txt = (&st_empty[0 as usize]) as u64
        ssym = 0
    }
    let rs: u64 = tbhover.button_sym(tbbase.st_x, tbbase.st_y, tbbase.st_w, tbbase.st_h,
        st_txt, false, false, 0, ssym)
    if tbbase.cf_labels == tbbase.LB_NEVER {
        var gemalt: bool = tbhover.brand_paint_ok(tbbase.st_x, tbbase.st_y, tbbase.st_w, tbbase.st_h, report)
        if !gemalt {
            var edge: u64 = tbbase.st_h - 4
            if edge > tbbase.st_w - 4 {
                edge = tbbase.st_w - 4
            }
            let gx: u64 = tbbase.st_x + (tbbase.st_w - edge) / 2
            let gy: u64 = tbbase.st_y + (tbbase.st_h - edge) / 2
            if tbmetrics.glyphs_ok() {
                gemalt = wlibc.icon_at(icons.START, gx, gy, edge,
                    uitheme.theme(uitheme.T_FG))
                if gemalt && report {
                    tbmetrics.say((&s_mkv[0 as usize]) as u64)
                    tbmetrics.sayn(edge)
                    tbmetrics.nl()
                }
            }
        }
    }
    if tbbase.tv_w != 0 {
        tbhover.glyph_button(tbbase.tv_x, tbbase.tv_y, tbbase.tv_w, tbbase.tv_h, icons.TASKVIEW, tbbase.tv_h - 8)
        if report {
            tbmetrics.say((&s_tvl[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.tv_x)
            tbmetrics.say((&tbbase.s_gy[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.tv_y)
            tbmetrics.say((&tbbase.s_gw[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.tv_w)
            tbmetrics.say((&tbbase.s_gh[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.tv_h)
            tbmetrics.nl()
        }
    }
    if tbbase.chv_w != 0 {
        var chcp: u64 = icons.CHEVRON_UP
        if tbbase.chev_open != 0 {
            chcp = icons.CHEVRON_DOWN
        }
        tbhover.glyph_button(tbbase.chv_x, tbbase.chv_y, tbbase.chv_w, tbbase.chv_h, chcp, tbmetrics.gl_w())
        if report {
            tbmetrics.say((&s_chl[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.chv_x)
            tbmetrics.say((&tbbase.s_gy[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.chv_y)
            tbmetrics.say((&tbbase.s_gw[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.chv_w)
            tbmetrics.say((&tbbase.s_gh[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.chv_h)
            tbmetrics.say((&s_opn[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.chev_open)
            tbmetrics.nl()
        }
    }
    var pz2: u64 = 0
    while pz2 < tbbase.npin {
        if tbbase.pw_[(pz2) as usize] != 0 {
            let pnm: u64 = (&tbbase.pinname[0 as usize]) as u64 + pz2 * 24
            let psy: u64 = tblayout.sym_of(pnm)
            let pw2: u64 = tbbase.pinwin[(pz2) as usize]
            let laeuft: bool = pw2 < tbbase.MAXK
            var vorn: bool = false
            if laeuft && tbbase.kfok[(pw2) as usize] != 0 {
                vorn = true
            }
            let prc: u64 = tbhover.button_sym(tbbase.px_[(pz2) as usize], tbbase.py_[(pz2) as usize],
                tbbase.pw_[(pz2) as usize], tbbase.ph_[(pz2) as usize],
                (&tbbase.s_empty[0 as usize]) as u64, vorn, false, 0, psy)
            if laeuft {
                tbhover.pill(tbbase.px_[(pz2) as usize], tbbase.py_[(pz2) as usize],
                    tbbase.pw_[(pz2) as usize], tbbase.ph_[(pz2) as usize], vorn)
                tbhover.group_dashes(tbbase.kcnt[(pw2) as usize])
                if tbbase.cf_badge != 0 {
                    let wn: u64 = tbhover.app_windows(pnm)
                    if wn >= tbbase.cf_badge {
                        tbmetrics.badge_paint(tbbase.px_[(pz2) as usize], tbbase.py_[(pz2) as usize],
                            tbbase.pw_[(pz2) as usize], wn, report)
                    }
                }
            }
            if report {
                tbmetrics.say((&s_pin[0 as usize]) as u64)
                tbmetrics.say(pnm)
                tbmetrics.say((&s_pinx[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.px_[(pz2) as usize])
                tbmetrics.say((&s_piny[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.py_[(pz2) as usize])
                tbmetrics.say((&s_pinw[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.pw_[(pz2) as usize])
                tbmetrics.say((&s_pinh[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.ph_[(pz2) as usize])
                tbmetrics.say((&s_pinsy[0 as usize]) as u64)
                if psy != 0 {
                    tbmetrics.sayn(1)
                } else {
                    tbmetrics.sayn(0)
                }
                tbmetrics.say((&s_pinrun[0 as usize]) as u64)
                if laeuft {
                    tbmetrics.sayn(1)
                } else {
                    tbmetrics.sayn(0)
                }
                tbmetrics.nl()
            }
            let _pu: u64 = prc
        }
        pz2 = pz2 + 1
    }
    var i: u64 = 0
    while i < tbbase.nk {
        if tbbase.kw[(i) as usize] != 0 {
            let lab: u64 = (&tbbase.klab[0 as usize]) as u64 + i * 40
            let mk: u64 = tbmetrics.mark_icon(tbbase.knv[(i) as usize])
            let sy: u64 = tblayout.sym_of((&tbbase.kapp[0 as usize]) as u64 + i * 24)
            let rc: u64 = tbhover.button_sym(tbbase.kx[(i) as usize], tbbase.ky[(i) as usize],
                tbbase.kw[(i) as usize], tbbase.kh[(i) as usize], lab,
                tbbase.kfok[(i) as usize] != 0, tbbase.kver[(i) as usize] != 0, mk, sy)
            tbhover.pill(tbbase.kx[(i) as usize], tbbase.ky[(i) as usize], tbbase.kw[(i) as usize],
                tbbase.kh[(i) as usize], tbbase.kfok[(i) as usize] != 0)
            tbhover.group_dashes(tbbase.kcnt[(i) as usize])
            if tbbase.kid[(i) as usize] != 0 {
                let _mr: u64 = wlibc.win_minrect(tbbase.kid[(i) as usize],
                    tbbase.bar_x + tbbase.kx[(i) as usize], tbbase.bar_y + tbbase.ky[(i) as usize],
                    tbbase.kw[(i) as usize], tbbase.kh[(i) as usize])
            }
            if report && tbbase.pl_w != 0 {
                tbmetrics.say((&s_pil[0 as usize]) as u64)
                tbmetrics.sayn(i)
                tbmetrics.say((&s_pilx[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.pl_x)
                tbmetrics.say((&s_pilw[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.pl_w)
                tbmetrics.say((&s_piltx[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.lab_tx)
                tbmetrics.say((&s_piltw[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.lab_tw)
                tbmetrics.nl()
            }
            if report && sy != 0 {
                tbmetrics.say((&s_sy[0 as usize]) as u64)
                tbmetrics.sayn(i)
                tbmetrics.say((&s_syn[0 as usize]) as u64)
                tbmetrics.say((&tbbase.kapp[0 as usize]) as u64 + i * 24)
                tbmetrics.say((&s_syw[0 as usize]) as u64)
                tbmetrics.sayn(wlibc.icon_w(sy))
                tbmetrics.say((&s_syg[0 as usize]) as u64)
                tbmetrics.sayn(tblayout.sym_w(sy, tbbase.kh[(i) as usize]))
                tbmetrics.say((&s_syk[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.kh[(i) as usize])
                tbmetrics.say((&s_syi[0 as usize]) as u64)
                tbmetrics.sayn(tblayout.sym_ink(sy))
                tbmetrics.nl()
            }
            if report {
                let bg: u64 = tbbase.lab_bg
                let fg: u64 = tbbase.lab_fg
                tbmetrics.say((&s_bt[0 as usize]) as u64)
                tbmetrics.sayn(i)
                tbmetrics.say((&s_bi[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.kid[(i) as usize])
                tbmetrics.say((&tbbase.s_tX[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.kx[(i) as usize])
                tbmetrics.say((&tbbase.s_gy[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.ky[(i) as usize])
                tbmetrics.say((&tbbase.s_gw[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.kw[(i) as usize])
                tbmetrics.say((&tbbase.s_gh[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.kh[(i) as usize])
                tbmetrics.say((&s_bv[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.kver[(i) as usize])
                tbmetrics.say((&s_bf[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.kfok[(i) as usize])
                tbmetrics.say((&tbbase.s_tt[0 as usize]) as u64)
                tbmetrics.say(lab)

                if tbbase.knv[(i) as usize] != 0 {
                    tbmetrics.say((&s_bn[0 as usize]) as u64)
                    tbmetrics.sayn(tbbase.knv[(i) as usize])
                    if mk != 0 {
                        tbmetrics.say((&s_bmx[0 as usize]) as u64)
                        tbmetrics.sayn(tbbase.mk_x)
                        tbmetrics.say((&s_bmy[0 as usize]) as u64)
                        tbmetrics.sayn(tbbase.mk_y)
                    }
                }
                tbmetrics.nl()
                tbmetrics.say((&s_grp[0 as usize]) as u64)
                tbmetrics.sayn(i)
                tbmetrics.say((&s_grpn[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.kcnt[(i) as usize])
                tbmetrics.nl()
                tbmetrics.say_text((&m_btn[0 as usize]) as u64, rc >> 32,
                    rc & 0xFFFFFFFF, fg, bg, lab)
            }
        }
        i = i + 1
    }
    if tbbase.grp_w != 0 {

        if tbbase.hot_f <= tbbase.F_BAT {
            wlib.draw_board(tbbase.grp_x, tbbase.st_y, tbbase.grp_w, tbmetrics.btn_h(), wlib.MR_BUTTON,
                wlibc.EL_FLAT, tbhover.hover_plate(), 0)
        }
        if report {
            tbmetrics.say((&s_grl[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.grp_x)
            tbmetrics.say((&tbbase.s_gw[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.grp_w)
            tbmetrics.nl()
        }
    }
    var f: u64 = 0
    while f < tbbase.F_N {
        if tbbase.f_w[(f) as usize] == 0 {
            f = f + 1
        } else {
        if (tbbase.grp_w == 0 || f > tbbase.F_BAT) && tbbase.hot_f == f {
            wlib.draw_board(tbbase.f_x[(f) as usize], tbbase.f_y[(f) as usize],
                tbbase.f_w[(f) as usize], tbbase.f_h[(f) as usize], wlib.MR_BUTTON,
                wlibc.EL_FLAT, tbhover.hover_plate(), 0)
        }

        var icx: u64 = 0

        if tbmetrics.glyphs_ok() {
            if f == tbbase.F_BAT {
                icx = status_glyph(f, tbmetrics.bat_icon(), tbmetrics.bat_colour(), (&lk_bat[0 as usize]) as u64, report)
            } else if f == tbbase.F_SND {
                icx = status_glyph(f, tbmetrics.snd_icon(), tbmetrics.snd_colour(), (&lk_snd[0 as usize]) as u64, report)
            } else if f == tbbase.F_NOTI {
                icx = status_glyph(f, tbmetrics.noti_icon(), tbmetrics.noti_colour(), (&lk_noti[0 as usize]) as u64, report)
            }
        }
        if f == tbbase.F_NET {

            let sy: u64 = tbmetrics.sys_icon()
            if sy != 0 {
                let _s: bool = wlibc.icon_draw(sy, tbbase.f_x[(f) as usize] + 2,
                    tbbase.f_y[(f) as usize] + (tbbase.f_h[(f) as usize] - tbmetrics.mk_w()) / 2)
                icx = tbmetrics.mk_w() + 2
                if report && tbbase.nv_faking != fk_said {
                    fk_said = tbbase.nv_faking
                    tbmetrics.say((&s_fk[0 as usize]) as u64)
                    tbmetrics.sayn(tbbase.nv_fall)
                    tbmetrics.say((&tbbase.s_tX[0 as usize]) as u64)
                    tbmetrics.sayn(tbbase.f_x[(f) as usize] + 2)
                    tbmetrics.say((&tbbase.s_gy[0 as usize]) as u64)
                    tbmetrics.sayn(tbbase.f_y[(f) as usize]
                        + (tbbase.f_h[(f) as usize] - tbmetrics.mk_w()) / 2)
                    tbmetrics.nl()
                }
            } else if report && tbbase.nv_faking != fk_said {
                fk_said = tbbase.nv_faking
                tbmetrics.say((&s_fkno[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.nv_fall)
                tbmetrics.nl()
            }
            let ic: u64 = tbmetrics.net_pic()
            if ic == 0 && tbmetrics.glyphs_ok() {

                let nid: u64 = tbmetrics.net_glyph(tbbase.net_state)
                let nx: u64 = tbbase.f_x[(f) as usize] + tbmetrics.tr_pad() + icx
                let ny: u64 = tbbase.f_y[(f) as usize]
                if wlibc.icon_mid_ink(nid, nx, ny, tbmetrics.gl_w(), tbbase.f_h[(f) as usize], tbmetrics.gl_w(),
                    tbmetrics.net_colour(tbbase.net_state)) {
                    icx = icx + tbmetrics.tr_icx()
                    if report {
                        tbmetrics.say((&lk_ic[0 as usize]) as u64)
                        tbmetrics.say((&lk_net[0 as usize]) as u64)
                        tbmetrics.say((&lk_id[0 as usize]) as u64)
                        tbmetrics.sayn(nid)
                        tbmetrics.say((&tbbase.s_tX[0 as usize]) as u64)
                        tbmetrics.sayn(nx)
                        tbmetrics.say((&tbbase.s_gy[0 as usize]) as u64)
                        tbmetrics.sayn(ny)
                        tbmetrics.say((&lk_px[0 as usize]) as u64)
                        tbmetrics.sayn(tbmetrics.gl_w())
                        tbmetrics.say((&lk_ink[0 as usize]) as u64)
                        tbmetrics.sayn(wlibc.icon_ink_w(nid, tbmetrics.gl_w())
                            * wlibc.icon_ink_h(nid, tbmetrics.gl_w()))
                        tbmetrics.say((&lk_st[0 as usize]) as u64)
                        tbmetrics.sayn(tbbase.net_state)
                        tbmetrics.nl()
                    }
                } else if report {
                    tbmetrics.say((&lk_no[0 as usize]) as u64)
                    tbmetrics.say((&lk_net[0 as usize]) as u64)
                    tbmetrics.nl()
                }
            }
            if ic != 0 {
                let ix: u64 = tbbase.f_x[(f) as usize] + 2 + icx
                let ihh: u64 = wlibc.icon_ink_hgt(ic)
                let itop: u64 = wlibc.icon_ink_top(ic)
                var icy: u64 = tbbase.f_y[(f) as usize]
                if tbbase.f_h[(f) as usize] > ihh {
                    icy = tbbase.f_y[(f) as usize]
                        + (tbbase.f_h[(f) as usize] - ihh) / 2
                }
                if icy >= itop {
                    icy = icy - itop
                } else {
                    icy = tbbase.f_y[(f) as usize]
                }
                let ilf: u64 = wlibc.icon_ink_lft(ic)
                var ixx: u64 = ix
                if ixx >= ilf {
                    ixx = ixx - ilf
                }
                let _i: bool = wlibc.icon_draw(ic, ixx, icy)
                var iwd: u64 = wlibc.icon_ink_wid(ic)
                if iwd == 0 {
                    iwd = wlibc.icon_draw_w(ic)
                }
                icx = icx + iwd + 2
                if report && tbbase.net_state != st_said {
                    st_said = tbbase.net_state
                    tbmetrics.say((&s_ic[0 as usize]) as u64)
                    tbmetrics.sayn(tbbase.net_state)
                    tbmetrics.say((&tbbase.s_tX[0 as usize]) as u64)
                    tbmetrics.sayn(ix)
                    tbmetrics.say((&tbbase.s_gy[0 as usize]) as u64)
                    tbmetrics.sayn(icy)
                    tbmetrics.say((&lk_px[0 as usize]) as u64)
                    tbmetrics.sayn(ihh)
                    tbmetrics.nl()
                }
            }
        }
        var l: u64 = 0
        while l < tbbase.f_lines[(f) as usize] {
            let p: u64 = tbmetrics.line_of(f, l)
            let n: u64 = tbmetrics.tlen(p)
            var tx: u64 = tbbase.f_x[(f) as usize] + 4 + icx
            var base: u64 = tbbase.f_y[(f) as usize] + (tbbase.f_h[(f) as usize] + tbbase.asc) / 2 - 1

            if (f == tbbase.F_CLK || f == tbbase.F_LANG) && icx == 0 {

                let lw: u64 = tbmetrics.width_of(p)
                if f == tbbase.F_CLK && tbbase.f_lines[(f) as usize] > 1 {
                    if tbbase.f_w[(f) as usize] >= lw + tbmetrics.fld_pad() {
                        tx = tbbase.f_x[(f) as usize] + tbbase.f_w[(f) as usize] - tbmetrics.fld_pad() - lw
                    }
                } else if tbbase.f_w[(f) as usize] > lw {
                    tx = tbbase.f_x[(f) as usize] + (tbbase.f_w[(f) as usize] - lw) / 2
                }
            }
            if tbbase.f_lines[(f) as usize] > 1 {
                let blk: u64 = tbbase.f_lines[(f) as usize] * tbmetrics.line_h()
                var voben: u64 = 2
                if tbbase.f_h[(f) as usize] > blk {
                    voben = (tbbase.f_h[(f) as usize] - blk) / 2
                }
                base = tbbase.f_y[(f) as usize] + voben + tbbase.asc + l * tbmetrics.line_h()
            }
            var tfg: u64 = uitheme.theme(uitheme.T_FG)
            var tbg: u64 = uitheme.theme(wlibc.C_TASKBAR_BG)
            if f == tbbase.F_REM {

                tfg = uitheme.theme(wlibc.C_DANGER)
            }
            tbbase.schild_tray = 1
            let _e: u64 = tbmetrics.text_mit_schild(tx, base, p, n, tfg, wlibc.TY_BODY, tbg)
            tbbase.schild_tray = 0
            if report {
                var mark: u64 = (&m_net[0 as usize]) as u64
                if f == tbbase.F_BAT {
                    mark = (&m_bat[0 as usize]) as u64
                } else if f == tbbase.F_CLK {
                    mark = (&m_clk[0 as usize]) as u64
                } else if f == tbbase.F_NOTI {
                    mark = (&m_noti[0 as usize]) as u64
                } else if f == tbbase.F_LANG {
                    mark = (&m_lang[0 as usize]) as u64
                } else if f == tbbase.F_REM {
                    mark = (&m_rem[0 as usize]) as u64
                } else if f == tbbase.F_SND {
                    mark = (&m_snd[0 as usize]) as u64
                }

                tbmetrics.say_text(mark, tx, base, tfg, tbg, p)
            }
            l = l + 1
        }
        if report {
            var mark: u64 = (&m_net[0 as usize]) as u64
            if f == tbbase.F_BAT {
                mark = (&m_bat[0 as usize]) as u64
            } else if f == tbbase.F_CLK {
                mark = (&m_clk[0 as usize]) as u64
            } else if f == tbbase.F_NOTI {
                mark = (&m_noti[0 as usize]) as u64
            } else if f == tbbase.F_LANG {
                mark = (&m_lang[0 as usize]) as u64
            } else if f == tbbase.F_REM {
                mark = (&m_rem[0 as usize]) as u64
            } else if f == tbbase.F_SND {
                mark = (&m_snd[0 as usize]) as u64
            }
            tbmetrics.say((&s_fl[0 as usize]) as u64)
            tbmetrics.say(mark)
            tbmetrics.say((&tbbase.s_tX[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.f_x[(f) as usize])
            tbmetrics.say((&tbbase.s_gy[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.f_y[(f) as usize])
            tbmetrics.say((&tbbase.s_gw[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.f_w[(f) as usize])
            tbmetrics.say((&tbbase.s_gh[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.f_h[(f) as usize])
            tbmetrics.say((&s_fn[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.f_lines[(f) as usize])

            var tmw: u64 = 0
            var tl: u64 = 0
            while tl < tbbase.f_lines[(f) as usize] {
                let tl_w: u64 = tbmetrics.width_of(tbmetrics.line_of(f, tl))
                if tl_w > tmw {
                    tmw = tl_w
                }
                tl = tl + 1
            }
            tbmetrics.say((&s_ftw[0 as usize]) as u64)
            tbmetrics.sayn(tmw)
            tbmetrics.nl()
        }
        f = f + 1
        }
    }
    var pb: u64 = 0
    while pb < tbbase.PB_MAX {
        if tbbase.pb_w[(pb) as usize] == 0 {
            pb = pb + 1
        } else {
        let pp: u64 = tbstatus.plug_text(pb)
        var pn: u64 = tbmetrics.tlen(pp)
        wlib.draw_board(tbbase.pb_x[(pb) as usize], tbbase.pb_y[(pb) as usize],
            tbbase.pb_w[(pb) as usize], tbbase.pb_h[(pb) as usize], wlib.MR_BUTTON,
            wlibc.EL_FLAT, tbmetrics.badge_reason(uitheme.theme(uitheme.T_PANEL)), 0)
        while pn > 1 && wlibc.text_w(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY), pp, pn)
            + 10 > tbbase.pb_w[(pb) as usize] {
            pn = pn - 1
        }
        let ptx: u64 = tbbase.pb_x[(pb) as usize] + 5
        let pbase: u64 = tbbase.pb_y[(pb) as usize]
            + (tbbase.pb_h[(pb) as usize] + tbbase.asc) / 2 - 1
        let _pe: u64 = wlib.draw_text(ptx, pbase, pp, pn,
            uitheme.theme(uitheme.T_FG), wlibc.TY_BODY)
        if report {
            tbmetrics.say((&s_pl[0 as usize]) as u64)
            tbmetrics.sayn(pb)
            tbmetrics.say((&tbbase.s_tX[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.pb_x[(pb) as usize])
            tbmetrics.say((&tbbase.s_gy[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.pb_y[(pb) as usize])
            tbmetrics.say((&tbbase.s_gw[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.pb_w[(pb) as usize])
            tbmetrics.say((&tbbase.s_gh[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.pb_h[(pb) as usize])
            tbmetrics.nl()
            tbmetrics.say_text((&m_plug[0 as usize]) as u64, ptx, pbase,
                uitheme.theme(uitheme.T_FG), uitheme.theme(uitheme.T_PANEL), pp)
        }
        pb = pb + 1
        }
    }

    if tbbase.hover_on != 0 && tbbase.vertical == 0 {
        let hb: u64 = tbhover.hover_left()
        let he: u64 = tbhover.hover_right()
        if he > hb + 20 {
            wlibc.clip_set(hb, y0, he, y0 + hh)
            wlib.draw_board(hb, tbbase.st_y, he - hb, tbmetrics.btn_h(),
                wlib.MR_BUTTON, wlibc.EL_FLAT,
                tbmetrics.badge_reason(uitheme.theme(uitheme.T_PANEL)), 0)
            let hp: u64 = (&tbbase.hover_txt[0 as usize]) as u64
            var hn: u64 = tbmetrics.tlen(hp)
            while hn > 1 && wlibc.text_w(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY), hp, hn)
                + 6 > he - hb {
                hn = hn - 1
            }
            let hbase: u64 = tbbase.st_y + (tbmetrics.btn_h() + tbbase.asc) / 2 - 1
            let _h: u64 = wlib.draw_text(hb + 3, hbase, hp, hn,
                uitheme.theme(uitheme.T_DIM), wlibc.TY_BODY)
            wlibc.clip_set(0, y0, tbbase.win_w, y0 + hh)
            if report {
                tbmetrics.say((&s_hv[0 as usize]) as u64)
                tbmetrics.say((&tbbase.s_tX[0 as usize]) as u64)
                tbmetrics.sayn(hb + 3)
                tbmetrics.say((&tbbase.s_tb[0 as usize]) as u64)
                tbmetrics.sayn(hbase)
                tbmetrics.say((&tbbase.s_tt[0 as usize]) as u64)
                tbhover.put_n(hp, hn)
                tbmetrics.nl()
            }
        }
    }
    let _p: u64 = bar_push(y0, hh)
    tbbase.ub_px = tbbase.ub_px + _p
    tbbase.ub_soll = tbbase.ub_soll + tbbase.win_w * hh
    if _p == 0 {
        tbbase.ub_null = tbbase.ub_null + 1
    }
    if report {

        tbmetrics.say((&lk_sx[0 as usize]) as u64)
        tbmetrics.sayn(tbbase.st_x)
        tbmetrics.say((&lk_sy[0 as usize]) as u64)
        tbmetrics.sayn(tbbase.st_y)
        tbmetrics.say((&lk_sw[0 as usize]) as u64)
        tbmetrics.sayn(tbbase.st_w)
        tbmetrics.say((&lk_sh[0 as usize]) as u64)
        tbmetrics.sayn(tbbase.st_h)
        tbmetrics.say((&lk_sg[0 as usize]) as u64)
        tbmetrics.say(tbmetrics.align_name(tbbase.cf_align))
        tbmetrics.nl()
        tbmetrics.say_text((&m_start[0 as usize]) as u64, rs >> 32,
            rs & 0xFFFFFFFF, uitheme.theme(uitheme.T_FG),
            uitheme.theme(wlibc.C_BUTTON_FACE), st_txt)
    }
}

fn paint(report: bool) {
    var y: u64 = 0
    var first: bool = true

    var band: u64 = BAND
    let tragf: u64 = wlibc.surf_rows()
    if tragf != 0 && tragf < band {
        band = tragf
    }
    while y < tbbase.win_h {
        var hh: u64 = band
        if y + hh > tbbase.win_h {
            hh = tbbase.win_h - y
        }
        paint_band(y, hh, report && first)
        first = false
        y = y + hh
    }
    bar_sync()
    tbbase.paints = tbbase.paints + 1
    if report {
        tbmetrics.schild_say()
    }
    tbbase.schild_n = 0
}

static mut s_d0: [u8; 21] = "taskbar: drag start \0"

fn pin_under(x: u64, y: u64) -> u64 {
    var k: u64 = 0
    while k < tbbase.npin {
        if tbbase.pw_[(k) as usize] != 0
            && x >= tbbase.px_[(k) as usize]
            && x < tbbase.px_[(k) as usize] + tbbase.pw_[(k) as usize]
            && y >= tbbase.py_[(k) as usize]
            && y < tbbase.py_[(k) as usize] + tbbase.ph_[(k) as usize] {
            return k
        }
        k = k + 1
    }
    return tbbase.npin
}

fn pin_target(mx: u64) -> u64 {
    if tbbase.npin == 0 {
        return 0
    }
    let br: u64 = tbbase.pw_[(0) as usize] + tbmetrics.gap()
    let left: u64 = tbbase.px_[(0) as usize]
    if mx < left {
        return 0
    }
    var k: u64 = 0
    while k < tbbase.npin {
        let mitte: u64 = left + k * br + br / 2
        if mx < mitte {
            return k
        }
        k = k + 1
    }
    return tbbase.npin - 1
}

fn pin_umhaengen(von: u64, move_to: u64) {
    if von == move_to || von >= tbbase.npin || move_to >= tbbase.npin {
        return
    }
    var tmp: [u8; 24] = [0 as u8; 24]
    let qp: u64 = (&tbbase.pinname[0 as usize]) as u64 + von * 24
    var k: u64 = 0
    while k < 24 {
        tmp[(k) as usize] = *((qp + k) as *mut u8)
        k = k + 1
    }
    if move_to > von {
        var i2: u64 = von
        while i2 < move_to {
            let a2: u64 = (&tbbase.pinname[0 as usize]) as u64 + i2 * 24
            let b2: u64 = a2 + 24
            k = 0
            while k < 24 {
                __mmio_write8((a2 + k) as *mut u8,
                    *((b2 + k) as *mut u8))
                k = k + 1
            }
            i2 = i2 + 1
        }
    } else {
        var i3: u64 = von
        while i3 > move_to {
            let a3: u64 = (&tbbase.pinname[0 as usize]) as u64 + i3 * 24
            let b3: u64 = a3 - 24
            k = 0
            while k < 24 {
                __mmio_write8((a3 + k) as *mut u8,
                    *((b3 + k) as *mut u8))
                k = k + 1
            }
            i3 = i3 - 1
        }
    }
    let zp: u64 = (&tbbase.pinname[0 as usize]) as u64 + move_to * 24
    k = 0
    while k < 24 {
        __mmio_write8((zp + k) as *mut u8, tmp[(k) as usize])
        k = k + 1
    }
}

fn pin_drag_step() {
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    let los: bool = (wlibc.mouse_btn() & 1) == 0
    if tbbase.pdrag == 1 {
        var d: u64 = 0
        if mx > pdrag_x0 {
            d = mx - pdrag_x0
        } else {
            d = pdrag_x0 - mx
        }
        if los {
            tbbase.pdrag = 0
            click(pdrag_x0, pdrag_y0)
            return
        }
        if d >= PDRAG_SCHWELLE * wlibc.ui_scale() {
            tbbase.pdrag = 2
            pdrag_target = pdrag_i
            tbmetrics.say((&s_pd0[0 as usize]) as u64)
            tbmetrics.say((&tbbase.pinname[0 as usize]) as u64 + pdrag_i * 24)
            tbmetrics.say((&s_pdd[0 as usize]) as u64)
            tbmetrics.sayn(d)
            tbmetrics.nl()
        }
        return
    }
    let z: u64 = pin_target(mx)
    if z != pdrag_target {
        pdrag_target = z
        pin_umhaengen(pdrag_i, z)
        pdrag_i = z
        let _l: bool = tblayout.list_read()
        tblayout.layout()
        paint(true)
        tbmetrics.say((&s_pdm[0 as usize]) as u64)
        tbmetrics.sayn(z)
        tbmetrics.nl()
    }
    if los {
        tbbase.pdrag = 0
        var ok: u64 = 0
        if tbstatus.conf_write() {
            ok = 1
        }
        tbmetrics.say((&s_pd1[0 as usize]) as u64)
        var q: u64 = 0
        while q < tbbase.npin {
            if q > 0 {
                tbmetrics.say((&s_komma[0 as usize]) as u64)
            }
            tbmetrics.say((&tbbase.pinname[0 as usize]) as u64 + q * 24)
            q = q + 1
        }
        tbmetrics.say((&tbbase.s_wr[0 as usize]) as u64)
        tbmetrics.sayn(ok)
        tbmetrics.nl()
        let _l2: bool = tblayout.list_read()
        tblayout.layout()
        paint(true)
    }
    let _my: u64 = my
}

static mut s_cl: [u8; 18] = "taskbar: click x=\0"

static mut s_cy: [u8; 4] = " y=\0"

static mut s_ct: [u8; 8] = " hits=\0\0"

static mut s_act: [u8; 17] = "taskbar: act id=\0"

static mut s_aw: [u8; 6] = " was=\0"

static mut z_start: [u8; 6] = "start\0"

static mut z_task: [u8; 7] = "window\0"

static mut z_none: [u8; 5] = "none\0"

static mut z_qs: [u8; 6] = "quick\0"

static mut s_ctxauf: [u8; 22] = "taskbar: kontext btn=\0"

static mut s_ctxfail: [u8; 31] = "taskbar: context empty fail c=\0"

static mut s_ctxleer: [u8; 25] = "taskbar: context empty\0\0\0"

static mut s_cx: [u8; 4] = " x=\0"

static mut s_cy2: [u8; 4] = " y=\0"

static mut s_cw: [u8; 4] = " w=\0"

static mut s_ch: [u8; 4] = " h=\0"

static mut s_cn: [u8; 4] = " n=\0"

fn rechtsklick(x: u64, y: u64) {

    let pg: u64 = pin_under(x, y)
    if pg < tbbase.npin {
        tbhover.tip_close()
        let _mp: bool = taskbar_ctx.open_pin(pg)
        return
    }
    let m: u64 = tbhover.hover_brand(x, y)
    tbhover.tip_close()
    if m < 1 || m > tbbase.nk {
        if taskbar_ctx.open_empty() {

            tbmetrics.say((&s_ctxleer[0 as usize]) as u64)
            tbmetrics.say((&s_cx[0 as usize]) as u64)
            tbmetrics.sayn(uipopmenu.x())
            tbmetrics.say((&s_cy2[0 as usize]) as u64)
            tbmetrics.sayn(uipopmenu.y())
            tbmetrics.say((&s_cw[0 as usize]) as u64)
            tbmetrics.sayn(uipopmenu.w())
            tbmetrics.say((&s_ch[0 as usize]) as u64)
            tbmetrics.sayn(uipopmenu.h())
            tbmetrics.say((&s_cn[0 as usize]) as u64)
            tbmetrics.sayn(taskbar_ctx.rows())
            tbmetrics.nl()
        } else {
            tbmetrics.say((&s_ctxfail[0 as usize]) as u64)
            tbmetrics.sayn(fuiscene.win_count())
            tbmetrics.nl()
        }
        return
    }
    if taskbar_ctx.open_button(m) {
        tbmetrics.say((&s_ctxauf[0 as usize]) as u64)
        tbmetrics.sayn(m)
        tbmetrics.nl()
    }
}

static mut s_mkv: [u8; 25] = "taskbar: mark vector px=\0"

static mut z_tv: [u8; 9] = "taskview\0"

static mut z_nc: [u8; 7] = "notifc\0"

static mut z_chev: [u8; 8] = "chevron\0"

static mut z_clk: [u8; 6] = "clock\0"

fn pin_exec(pk: u64) {
    tbhover.app_exec((&tbbase.pinname[0 as usize]) as u64 + pk * 24)
}

fn click(x: u64, y: u64) {
    tbbase.clicks = tbbase.clicks + 1
    tbmetrics.say((&s_cl[0 as usize]) as u64)
    tbmetrics.sayn(x)
    tbmetrics.say((&s_cy[0 as usize]) as u64)
    tbmetrics.sayn(y)

    if tbbase.grp_w != 0 && x >= tbbase.grp_x && x < tbbase.grp_x + tbbase.grp_w
        && y >= tbbase.st_y && y < tbbase.st_y + tbmetrics.btn_h() {
        tbmetrics.say((&s_ct[0 as usize]) as u64)
        tbmetrics.say((&z_qs[0 as usize]) as u64)
        tbmetrics.nl()
        qs.toggle()
        return
    }
    if tbbase.tv_w != 0 && x >= tbbase.tv_x && x < tbbase.tv_x + tbbase.tv_w && y >= tbbase.tv_y && y < tbbase.tv_y + tbbase.tv_h {
        tbmetrics.say((&s_ct[0 as usize]) as u64)
        tbmetrics.say((&z_tv[0 as usize]) as u64)
        tbmetrics.nl()
        taskview.toggle()
        return
    }
    if tbbase.chv_w != 0 && x >= tbbase.chv_x && x < tbbase.chv_x + tbbase.chv_w && y >= tbbase.chv_y && y < tbbase.chv_y + tbbase.chv_h {
        tbmetrics.say((&s_ct[0 as usize]) as u64)
        tbmetrics.say((&z_chev[0 as usize]) as u64)
        tbmetrics.nl()

        calpop.shut_now()
        traypop.toggle(tbbase.bar_x + tbbase.chv_x, tbbase.bar_y + tbbase.chv_y, tbbase.chv_w, tbbase.chv_h, tbbase.net_da, tbbase.net_state)
        if tbbase.chev_open == 0 {
            tbbase.chev_open = 1
        } else {
            tbbase.chev_open = 0
        }
        let _sb: bool = tbstatus.status_build()
        tblayout.layout()
        paint(true)
        return
    }

    if tbbase.f_w[(tbbase.F_NOTI) as usize] != 0
        && x >= tbbase.f_x[(tbbase.F_NOTI) as usize]
        && x < tbbase.f_x[(tbbase.F_NOTI) as usize] + tbbase.f_w[(tbbase.F_NOTI) as usize]
        && y >= tbbase.f_y[(tbbase.F_NOTI) as usize]
        && y < tbbase.f_y[(tbbase.F_NOTI) as usize] + tbbase.f_h[(tbbase.F_NOTI) as usize] {
        tbmetrics.say((&s_ct[0 as usize]) as u64)
        tbmetrics.say((&z_nc[0 as usize]) as u64)
        tbmetrics.nl()
        notifc.toggle()
        return
    }

    if tbbase.f_w[(tbbase.F_CLK) as usize] != 0
        && x >= tbbase.f_x[(tbbase.F_CLK) as usize]
        && x < tbbase.f_x[(tbbase.F_CLK) as usize] + tbbase.f_w[(tbbase.F_CLK) as usize]
        && y >= tbbase.f_y[(tbbase.F_CLK) as usize]
        && y < tbbase.f_y[(tbbase.F_CLK) as usize] + tbbase.f_h[(tbbase.F_CLK) as usize] {
        tbmetrics.say((&s_ct[0 as usize]) as u64)
        tbmetrics.say((&z_clk[0 as usize]) as u64)
        tbmetrics.nl()
        if traypop.is_open() {
            traypop.shut_now()
        }
        tbhover.tip_close()
        calpop.toggle(tbbase.bar_x + tbbase.f_x[(tbbase.F_CLK) as usize], tbbase.bar_y + tbbase.f_y[(tbbase.F_CLK) as usize],
            tbbase.f_w[(tbbase.F_CLK) as usize], tbbase.f_h[(tbbase.F_CLK) as usize])
        return
    }
    if x >= tbbase.f_x[(tbbase.F_NET) as usize]
        && x < tbbase.f_x[(tbbase.F_NET) as usize] + tbbase.f_w[(tbbase.F_NET) as usize]
        && y >= tbbase.f_y[(tbbase.F_NET) as usize]
        && y < tbbase.f_y[(tbbase.F_NET) as usize] + tbbase.f_h[(tbbase.F_NET) as usize] {
        tbmetrics.say((&s_ct[0 as usize]) as u64)
        tbmetrics.say((&z_qs[0 as usize]) as u64)
        tbmetrics.nl()
        qs.toggle()
        return
    }

    if tbbase.snd_da != 0 && tbbase.f_w[(tbbase.F_SND) as usize] != 0
        && x >= tbbase.f_x[(tbbase.F_SND) as usize]
        && x < tbbase.f_x[(tbbase.F_SND) as usize] + tbbase.f_w[(tbbase.F_SND) as usize]
        && y >= tbbase.f_y[(tbbase.F_SND) as usize]
        && y < tbbase.f_y[(tbbase.F_SND) as usize] + tbbase.f_h[(tbbase.F_SND) as usize] {
        tbmetrics.say((&s_ct[0 as usize]) as u64)
        tbmetrics.say((&z_qs[0 as usize]) as u64)
        tbmetrics.nl()
        qs.toggle()
        return
    }
    if x >= tbbase.st_x && x < tbbase.st_x + tbbase.st_w && y >= tbbase.st_y && y < tbbase.st_y + tbbase.st_h {
        tbmetrics.say((&s_ct[0 as usize]) as u64)
        tbmetrics.say((&z_start[0 as usize]) as u64)
        tbmetrics.nl()
        tbpopup.startmenue_um()
        return
    }
    var pk: u64 = 0
    while pk < tbbase.npin {
        if tbbase.pw_[(pk) as usize] != 0
            && x >= tbbase.px_[(pk) as usize]
            && x < tbbase.px_[(pk) as usize] + tbbase.pw_[(pk) as usize]
            && y >= tbbase.py_[(pk) as usize]
            && y < tbbase.py_[(pk) as usize] + tbbase.ph_[(pk) as usize] {
            let w2: u64 = tbbase.pinwin[(pk) as usize]
            if w2 < tbbase.MAXK {
                var rc2: u64 = 0
                if tbbase.kcnt[(w2) as usize] > 1 && tbbase.kfok[(w2) as usize] != 0 {

                    rc2 = wlibc.win_act(tbhover.group_next(w2), wlibc.WA_RAISE)
                } else {
                    rc2 = wlibc.win_act(tbbase.kid[(w2) as usize], wlibc.WA_TOGGLE)
                }
                tbbase.acts = tbbase.acts + 1
                tbmetrics.say((&s_pinact[0 as usize]) as u64)
                tbmetrics.say((&tbbase.pinname[0 as usize]) as u64 + pk * 24)
                tbmetrics.say((&tbbase.s_rc[0 as usize]) as u64)
                tbmetrics.sayn(rc2)
                tbmetrics.nl()
            } else {
                pin_exec(pk)
            }
            let _a2: bool = tblayout.list_read()
            tblayout.layout()
            paint(true)
            return
        }
        pk = pk + 1
    }
    var i: u64 = 0
    while i < tbbase.nk {
        if tbbase.kw[(i) as usize] != 0 {
            if x >= tbbase.kx[(i) as usize] && x < tbbase.kx[(i) as usize] + tbbase.kw[(i) as usize]
                && y >= tbbase.ky[(i) as usize]
                && y < tbbase.ky[(i) as usize] + tbbase.kh[(i) as usize] {
                tbmetrics.say((&s_ct[0 as usize]) as u64)
                tbmetrics.say((&z_task[0 as usize]) as u64)
                tbmetrics.nl()
                var rc: u64 = 0
                if tbbase.kcnt[(i) as usize] > 1 && tbbase.kfok[(i) as usize] != 0 {
                    rc = wlibc.win_act(tbhover.group_next(i), wlibc.WA_RAISE)
                } else {
                    rc = wlibc.win_act(tbbase.kid[(i) as usize], wlibc.WA_TOGGLE)
                }
                tbbase.acts = tbbase.acts + 1
                tbmetrics.say((&s_act[0 as usize]) as u64)
                tbmetrics.sayn(tbbase.kid[(i) as usize])
                tbmetrics.say((&s_aw[0 as usize]) as u64)
                tbmetrics.sayn(wlibc.WA_TOGGLE)
                tbmetrics.say((&tbbase.s_rc[0 as usize]) as u64)
                tbmetrics.sayn(rc)
                tbmetrics.nl()
                let _a: bool = tblayout.list_read()
                tblayout.layout()
                paint(true)
                return
            }
        }
        i = i + 1
    }

    tbmetrics.say((&s_ct[0 as usize]) as u64)
    tbmetrics.say((&z_none[0 as usize]) as u64)
    tbmetrics.nl()
    tbbase.dragging = 1
    tbbase.drag_edge = tbbase.cf_edge
    tbbase.prev_edge = 9
    tbmetrics.say((&s_d0[0 as usize]) as u64)
    tbmetrics.say((&tbbase.s_gx[0 as usize]) as u64)
    tbmetrics.sayn(x)
    tbmetrics.say((&s_cy[0 as usize]) as u64)
    tbmetrics.sayn(y)
    tbmetrics.nl()
}

static mut bar_nodes: u64 = 0

static mut a_start: [u8; 14] = "taskbar.start\0"

static mut a_tv: [u8; 17] = "taskbar.taskview\0"

static mut a_nc: [u8; 22] = "taskbar.notifications\0"

static mut a_chev: [u8; 16] = "taskbar.chevron\0"

static mut a_quick: [u8; 14] = "taskbar.quick\0"

static mut a_pinp: [u8; 13] = "taskbar.pin.\0"

static mut a_pinb: [u8; 440] = [0 as u8; 440]

fn bar_action(key: u64) -> u64 {
    if key == tbbase.K_START {
        return (&a_start[0 as usize]) as u64
    }
    if key == tbbase.K_TV {
        return (&a_tv[0 as usize]) as u64
    }
    if key == tbbase.K_FIELD + tbbase.F_NOTI {
        return (&a_nc[0 as usize]) as u64
    }
    if key == tbbase.K_CHEV {
        return (&a_chev[0 as usize]) as u64
    }
    if key >= tbbase.K_PIN && key < tbbase.K_PIN + tbbase.npin {
        let i: u64 = key - tbbase.K_PIN
        let b: u64 = (&a_pinb[0 as usize]) as u64 + i * 44
        let at: u64 = tbmetrics.text_at_p(b, 0, (&a_pinp[0 as usize]) as u64)
        let _e: u64 = tbmetrics.text_at_p(b, at, (&tbbase.pinname[0 as usize]) as u64 + i * 24)
        return b
    }
    if key == tbbase.K_FIELD + tbbase.F_NET || key == tbbase.K_FIELD + tbbase.F_SND || key == tbbase.K_FIELD + tbbase.F_BAT {
        return (&a_quick[0 as usize]) as u64
    }
    return 0
}

fn bar_build() {
    let r: usize = fuiscene.root()
    fuiscene.set_pad(r, 0)
    fuiscene.set_gap(r, 0)
    tbpopup.bi_collect()
    var i: u64 = 0
    var cy: u64 = 0
    var nodes: u64 = 0
    while i < tbbase.bi_n {
        let y: u64 = tbbase.bi_y[(tbbase.bi_o[(i) as usize]) as usize]
        if y > cy {
            let _sy: usize = fuiscene.ghost_space(r, 0, y - cy)
        }
        let row: usize = fuiscene.row(r)
        fuiscene.set_pad(row, 0)
        fuiscene.set_gap(row, 0)
        var cx: u64 = 0
        var mh: u64 = 0
        while i < tbbase.bi_n && tbbase.bi_y[(tbbase.bi_o[(i) as usize]) as usize] == y {
            let o: u64 = tbbase.bi_o[(i) as usize]
            let x: u64 = tbbase.bi_x[(o) as usize]
            if x > cx {
                let _sx: usize = fuiscene.ghost_space(row, x - cx, 1)
            }
            let _b: usize = fuiscene.ghost_button(row, tbbase.bi_l[(o) as usize],
                tbbase.bi_k[(o) as usize], tbbase.bi_w[(o) as usize], tbbase.bi_h[(o) as usize])
            let ba: u64 = bar_action(tbbase.bi_k[(o) as usize])
            if ba != 0 {
                fuiscene.ax_action(tbbase.bi_k[(o) as usize], ba)
            }
            nodes = nodes + 1
            cx = x + tbbase.bi_w[(o) as usize]
            if tbbase.bi_h[(o) as usize] > mh {
                mh = tbbase.bi_h[(o) as usize]
            }
            i = i + 1
        }
        cy = y + mh
    }
    bar_nodes = nodes
}

fn bar_press(key: u64) {
    var i: u64 = 0
    while i < tbbase.bi_n {
        if tbbase.bi_k[(i) as usize] == key {
            click(tbbase.bi_x[(i) as usize] + tbbase.bi_w[(i) as usize] / 2,
                tbbase.bi_y[(i) as usize] + tbbase.bi_h[(i) as usize] / 2)
            return
        }
        i = i + 1
    }
}

static mut s_kbon: [u8; 17] = "taskbar: keys on\0"

static mut s_kbk: [u8; 16] = "taskbar: key n=\0"

static mut s_kboff: [u8; 19] = "taskbar: keys off \0"

static mut bar_kb: u64 = 0

static mut bar_kb_btn: u64 = 0

fn bar_keys(on: bool) {
    if tbbase.bar_ready == 0 {
        return
    }
    let _s: bool = fuiscene.win_select(0)
    if on {
        bar_kb = 1
        let _k: u64 = wlibc.win_state(tbbase.w_h, wlibc.WS_KEYS, 1)
        fuiscene.focus_canvas()
        fuiscene.focus(tbbase.K_START)
        bar_kb_btn = wlibc.mouse_btn() & 1
        tbmetrics.say((&s_kbon[0 as usize]) as u64)
        tbmetrics.nl()
    } else {
        bar_kb = 0
        let _k: u64 = wlibc.win_state(tbbase.w_h, wlibc.WS_KEYS, 0)
        fuiscene.focus(0)
        tbmetrics.say((&s_kboff[0 as usize]) as u64)
        tbmetrics.nl()
    }
    fuiscene.refresh()
}

fn bar_kb_step() {
    if bar_kb == 0 {
        return
    }
    let b: u64 = wlibc.mouse_btn() & 1
    if b != 0 && bar_kb_btn == 0 {
        bar_keys(false)
    }
    bar_kb_btn = b
}

fn bar_raw(kind: u64, x: u64, y: u64, btn: u64, key: u64) {
    if kind == tbpopup.fuiapp_down() {
        fuiscene.raw_take()
        if (btn & 2) != 0 {
            rechtsklick(x, y)
        } else {
            let pg: u64 = pin_under(x, y)
            if pg < tbbase.npin {
                tbbase.pdrag = 1
                pdrag_i = pg
                pdrag_x0 = x
                pdrag_y0 = y
            } else {
                click(x, y)
            }
        }
        return
    }
    if kind == 3 || kind == 4 {
        fuiscene.raw_take()
        return
    }
    if kind == 1 {
        if bar_kb != 0 {
            tbmetrics.say((&s_kbk[0 as usize]) as u64)
            tbmetrics.sayn(key)
            tbmetrics.nl()
        }
        if key == 27 && bar_kb != 0 {
            bar_keys(false)
        }
    }
}

fn bar_copy(dst: u64, src: u64, n: u64) {
    var k: u64 = 0
    while k + 8 <= n {
        __mmio_write64((dst + k) as *mut u64, __mmio_read64((src + k) as *mut u64))
        k = k + 8
    }
    while k < n {
        __mmio_write8((dst + k) as *mut u8, __mmio_read8((src + k) as *mut u8))
        k = k + 1
    }
}

fn bar_push(y0: u64, hh: u64) -> u64 {
    if tbbase.bar_r == 0 || hh == 0 || tbbase.win_w == 0 {
        return 0
    }
    if y0 < wlibc.band_y() {
        return 0
    }
    var rows: u64 = hh
    if y0 + rows > tbbase.win_h {
        rows = tbbase.win_h - y0
    }
    let rr: u64 = y0 - wlibc.band_y()
    if rr >= wlibc.surf_rows() {
        return 0
    }
    if rr + rows > wlibc.surf_rows() {
        rows = wlibc.surf_rows() - rr
    }
    if (y0 + rows) * tbbase.win_w * 4 > tbbase.bar_cap {
        return 0
    }
    let src: u64 = wlibc.surface() + rr * wlibc.surf_w() * 4
    var k: u64 = 0
    while k < rows {
        bar_copy(tbbase.bar_r + ((y0 + k) * tbbase.win_w) * 4, src + k * wlibc.surf_w() * 4,
            tbbase.win_w * 4)
        k = k + 1
    }
    return tbbase.win_w * rows
}

fn bar_overlay() {
    let dst: u64 = fuiscene.canvas_px()
    if dst == 0 || tbbase.bar_r == 0 {
        return
    }
    let cw: u64 = fuiscene.sp(fuiscene.width())
    let ch: u64 = fuiscene.sp(fuiscene.height())
    if cw != tbbase.win_w {
        return
    }
    var rows: u64 = tbbase.win_h
    if ch < rows {
        rows = ch
    }
    if rows * tbbase.win_w * 4 > tbbase.bar_cap {
        return
    }
    bar_copy(dst, tbbase.bar_r, rows * tbbase.win_w * 4)
}

fn bar_sync() {
    if tbbase.bar_ready == 0 {
        return
    }
    let _s: bool = fuiscene.win_select(0)
    fuiscene.refresh()
}

fn bar_pump() {
    if tbbase.bar_ready == 0 {
        return
    }
    let _st: u64 = wlib.step()
    let k: u64 = fuiscene.pump_aux(0)
    if k != 0 {
        bar_press(k)
        if bar_kb != 0 {
            bar_keys(false)
        }
    }
    bar_kb_step()
}

fn bar_size(w: u64, h: u64) -> u64 {
    let _s: bool = fuiscene.win_select(0)
    if fuiscene.win_size(w, h) {
        return 0
    }
    return 1
}
