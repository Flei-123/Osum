fn shape_say() {
    tbmetrics.say((&sh_a[0 as usize]) as u64)
    tbmetrics.say(wlibc.shape_file())
    tbmetrics.say((&sh_b[0 as usize]) as u64)
    tbmetrics.say(wlibc.shape_name())
    tbmetrics.say((&sh_c[0 as usize]) as u64)
    tbmetrics.sayn(wlibc.shape_id())
    tbmetrics.say((&sh_d[0 as usize]) as u64)
    tbmetrics.sayn(wlibc.shape_keys())
    tbmetrics.say((&sh_e[0 as usize]) as u64)
    tbmetrics.sayn(wlibc.metric(wlibc.M_CTRL_H))
    tbmetrics.say((&sh_r[0 as usize]) as u64)
    tbmetrics.sayn(wlibc.metric(wlibc.M_RADIUS_PANEL))
    tbmetrics.say((&sh_s[0 as usize]) as u64)
    tbmetrics.sayn(wlibc.metric(wlibc.M_RADIUS_BUTTON))
    tbmetrics.say((&sh_t[0 as usize]) as u64)
    tbmetrics.sayn(wlibc.metric(wlibc.M_RADIUS_INPUT))
    tbmetrics.nl()
}

static mut g_ga: [u8; 21] = "taskbar: glas alpha=\0"

static mut g_gb: [u8; 7] = " blur=\0"

