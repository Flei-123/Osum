fn glas_say() {
    tbmetrics.say((&g_ga[0 as usize]) as u64)
    tbmetrics.sayn(wlibc.tb_alpha())
    tbmetrics.say((&g_gb[0 as usize]) as u64)
    tbmetrics.sayn(wlibc.tb_blur())
    tbmetrics.say((&g_gc[0 as usize]) as u64)
    tbmetrics.sayn(wlibc.radius())
    tbmetrics.say((&g_gd[0 as usize]) as u64)
    tbmetrics.say_hex6(wlibc.theme(wlibc.C_TASKBAR_BG) & 0xFFFFFF)
    tbmetrics.nl()
}

fn conf_say() {
    tbmetrics.say((&s_cf[0 as usize]) as u64)
    tbmetrics.say((&tbbase.s_ed[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.cf_edge)
    tbmetrics.say((&s_en[0 as usize]) as u64)
    tbmetrics.say(wlibc.edge_name(tbbase.cf_edge))
    tbmetrics.say((&s_hh[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.cf_height)
    tbmetrics.say((&s_ww[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.cf_width)
    tbmetrics.say((&s_ah[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.cf_autohide)
    tbmetrics.say((&s_ot[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.cf_ontop)
    tbmetrics.say((&s_al[0 as usize]) as u64)
    tbmetrics.say(tbmetrics.align_name(tbbase.cf_align))
    tbmetrics.say((&s_sr[0 as usize]) as u64)
    if tbbase.cf_from_file != 0 {
        tbmetrics.say((&s_file[0 as usize]) as u64)
    } else {
        tbmetrics.say((&s_dflt[0 as usize]) as u64)
    }
    tbmetrics.nl()
}

