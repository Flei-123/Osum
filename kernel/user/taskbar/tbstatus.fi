static mut k_edge: [u8; 5] = "edge\0"

static mut k_pins: [u8; 5] = "pins\0"

static mut k_height: [u8; 7] = "height\0"

static mut k_width: [u8; 6] = "width\0"

static mut k_autohide: [u8; 9] = "autohide\0"

static mut k_ontop: [u8; 6] = "ontop\0"

static mut k_align: [u8; 6] = "align\0"

static mut k_seconds: [u8; 15] = "clock_seconds\0\0"

static mut k_cdate: [u8; 12] = "clock_date\0\0"

static mut k_cwday: [u8; 15] = "clock_weekday\0\0"

static mut k_clines: [u8; 13] = "clock_lines\0\0"

static mut k_labels: [u8; 8] = "labels\0\0"

static mut k_nohw: [u8; 15] = "hide_missing\0\0\0"

static mut k_lang: [u8; 14] = "tray_language\0"

static mut k_year4: [u8; 12] = "clock_year4\0"

static mut k_12h: [u8; 11] = "clock_12h\0\0"

static mut k_tv: [u8; 9] = "taskview\0"

static mut k_chev: [u8; 13] = "tray_chevron\0"

static mut k_group: [u8; 11] = "tray_group\0"

static mut k_demo: [u8; 11] = "tray_demo\0\0"

static mut k_demochg: [u8; 14] = "tray_demochg\0\0"

static mut k_badge: [u8; 7] = "badges\0"

fn conf_read() -> bool {
    var word: [u8; 24] = [0 as u8; 24]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_conf[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return false
    }
    let b: u64 = (&conf[0 as usize]) as u64
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, b, 1023)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return false
    }
    var i: u64 = 0
    while i < n {

        let ks: u64 = i
        var ke: u64 = i
        while ke < n && __mmio_read8((b + ke) as *mut u8) != 61 as u8
            && __mmio_read8((b + ke) as *mut u8) != 10 as u8 {
            ke = ke + 1
        }
        if ke < n && __mmio_read8((b + ke) as *mut u8) == 61 as u8 {
            let vs: u64 = ke + 1
            var ve: u64 = vs
            while ve < n && __mmio_read8((b + ve) as *mut u8) != 10 as u8
                && __mmio_read8((b + ve) as *mut u8) != 13 as u8 {
                ve = ve + 1
            }

            let wp: u64 = (&word[0 as usize]) as u64
            var k: u64 = 0
            var v: u64 = 0
            var digits: u64 = 0
            while vs + k < ve && k < 23 {
                let c: u64 = __mmio_read8((b + vs + k) as *mut u8) as u64
                __mmio_write8((wp + k) as *mut u8, c as u8)
                if c >= 48 && c <= 57 {
                    v = v * 10 + (c - 48)
                    digits = digits + 1
                }
                k = k + 1
            }
            __mmio_write8((wp + k) as *mut u8, 0 as u8)
            let kl: u64 = ke - ks
            if tbmetrics.key_is(b + ks, kl, (&k_pins[0 as usize]) as u64) && tbbase.pdrag == 0 {
                tbbase.npin = 0
                var q: u64 = vs
                while q < ve && tbbase.npin < MAXPIN {
                    var l: u64 = 0
                    let zp: u64 = (&tbbase.pinname[0 as usize]) as u64 + tbbase.npin * 24
                    while q < ve && l < 23 {
                        let ch: u64 = __mmio_read8((b + q) as *mut u8) as u64
                        if ch == 44 {
                            break
                        }
                        if ch != 32 && ch != 9 {
                            __mmio_write8((zp + l) as *mut u8, ch as u8)
                            l = l + 1
                        }
                        q = q + 1
                    }
                    __mmio_write8((zp + l) as *mut u8, 0 as u8)
                    if l > 0 {
                        tbbase.npin = tbbase.npin + 1
                    }
                    while q < ve
                        && __mmio_read8((b + q) as *mut u8) != 44 as u8 {
                        q = q + 1
                    }
                    if q < ve {
                        q = q + 1
                    }
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_edge[0 as usize]) as u64) {
                let e: u64 = wlibc.edge_by_name(wp)
                if e < 4 {
                    tbbase.cf_edge = e
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_height[0 as usize]) as u64) {
                if digits > 0 {
                    tbbase.cf_height = tbmetrics.clamp(v * wlibc.ui_scale(),
                        tbmetrics.h_min(), tbmetrics.h_max())
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_width[0 as usize]) as u64) {
                if digits > 0 {
                    tbbase.cf_width = tbmetrics.clamp(v, V_MIN, tbbase.V_MAX)
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_autohide[0 as usize]) as u64) {
                if digits > 0 {
                    tbbase.cf_autohide = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_ontop[0 as usize]) as u64) {
                if digits > 0 {
                    tbbase.cf_ontop = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_seconds[0 as usize]) as u64) {
                if digits > 0 {
                    cf_sec = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_cdate[0 as usize]) as u64) {
                if digits > 0 {
                    cf_date = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_cwday[0 as usize]) as u64) {
                if digits > 0 {
                    cf_wday = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_clines[0 as usize]) as u64) {
                if v == 2 {
                    cf_clines = 2
                } else if digits > 0 {
                    cf_clines = 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_nohw[0 as usize]) as u64) {
                if digits > 0 {
                    cf_hidemissing = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_lang[0 as usize]) as u64) {
                if digits > 0 {
                    cf_lang = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_year4[0 as usize]) as u64) {
                if digits > 0 {
                    cf_year4 = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_12h[0 as usize]) as u64) {
                if digits > 0 {
                    cf_12h = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_tv[0 as usize]) as u64) {
                if digits > 0 {
                    cf_tv = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_chev[0 as usize]) as u64) {
                if digits > 0 {
                    tbbase.cf_chev = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_group[0 as usize]) as u64) {
                if digits > 0 {
                    tbbase.cf_group = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_demo[0 as usize]) as u64) {
                if digits > 0 {
                    cf_demo = tbmetrics.clamp(v, 0, 101)
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_demochg[0 as usize]) as u64) {
                if digits > 0 {
                    cf_demochg = v & 1
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_badge[0 as usize]) as u64) {
                if digits > 0 {
                    tbbase.cf_badge = tbmetrics.clamp(v, 0, 9)
                }
            } else if tbmetrics.key_is(b + ks, kl, (&k_labels[0 as usize]) as u64) {
                tbbase.cf_labels = tbmetrics.labels_by_name(wp)
            } else if tbmetrics.key_is(b + ks, kl, (&k_align[0 as usize]) as u64) {

                tbbase.cf_align = tbmetrics.align_by_name(wp)
            }
            i = ve + 1
        } else {
            i = ke + 1
        }
    }
    return true
}

static mut c_head: [u8; 60] =
    "# taskbar.conf -- written by /bin/taskbar and /bin/settings\0"

fn conf_write() -> bool {
    let b: u64 = (&conf[0 as usize]) as u64
    var at: u64 = tbmetrics.text_at_p(b, 0, (&c_head[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    at = tbmetrics.text_at_p(b, at, (&k_edge[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    at = tbmetrics.text_at_p(b, at + 1, wlibc.edge_name(tbbase.cf_edge))
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = tbmetrics.wk_num(b, at, (&k_height[0 as usize]) as u64, tbbase.cf_height)
    at = tbmetrics.wk_num(b, at, (&k_width[0 as usize]) as u64, tbbase.cf_width)
    at = tbmetrics.wk_num(b, at, (&k_autohide[0 as usize]) as u64, tbbase.cf_autohide)
    at = tbmetrics.wk_num(b, at, (&k_ontop[0 as usize]) as u64, tbbase.cf_ontop)
    at = tbmetrics.wk_txt(b, at, (&k_align[0 as usize]) as u64, tbmetrics.align_name(tbbase.cf_align))

    at = tbmetrics.wk_txt(b, at, (&k_labels[0 as usize]) as u64, tbmetrics.labels_name(tbbase.cf_labels))
    at = tbmetrics.wk_num(b, at, (&k_cdate[0 as usize]) as u64, cf_date)
    at = tbmetrics.wk_num(b, at, (&k_cwday[0 as usize]) as u64, cf_wday)
    at = tbmetrics.wk_num(b, at, (&k_clines[0 as usize]) as u64, cf_clines)
    at = tbmetrics.wk_num(b, at, (&k_seconds[0 as usize]) as u64, cf_sec)
    at = tbmetrics.wk_num(b, at, (&k_lang[0 as usize]) as u64, cf_lang)
    at = tbmetrics.wk_num(b, at, (&k_year4[0 as usize]) as u64, cf_year4)
    at = tbmetrics.wk_num(b, at, (&k_12h[0 as usize]) as u64, cf_12h)
    at = tbmetrics.wk_num(b, at, (&k_nohw[0 as usize]) as u64, cf_hidemissing)
    at = tbmetrics.wk_num(b, at, (&k_tv[0 as usize]) as u64, cf_tv)
    at = tbmetrics.wk_num(b, at, (&k_chev[0 as usize]) as u64, tbbase.cf_chev)
    at = tbmetrics.wk_num(b, at, (&k_group[0 as usize]) as u64, tbbase.cf_group)
    at = tbmetrics.wk_num(b, at, (&k_badge[0 as usize]) as u64, tbbase.cf_badge)
    if tbbase.npin > 0 {
        at = tbmetrics.text_at_p(b, at + 1, (&k_pins[0 as usize]) as u64)
        __mmio_write8((b + at) as *mut u8, 61 as u8)
        at = at + 1
        var pw3: u64 = 0
        while pw3 < tbbase.npin {
            if pw3 > 0 {
                __mmio_write8((b + at) as *mut u8, 44 as u8)
                at = at + 1
            }
            at = tbmetrics.text_at_p(b, at,
                (&tbbase.pinname[0 as usize]) as u64 + pw3 * 24)
            pw3 = pw3 + 1
        }
        __mmio_write8((b + at) as *mut u8, 10 as u8)
    }
    at = at + 1
    let fd: u64 = io.create((&p_conf[0 as usize]) as u64)
    if ulib.bad(fd) {
        return false
    }
    let g: u64 = io.write_all(fd, b, at)
    io.close(fd)
    if ulib.bad(g) || g < at {
        return false
    }
    tbbase.writes = tbbase.writes + 1
    return true
}

