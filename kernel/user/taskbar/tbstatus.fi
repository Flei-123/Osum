fn ip_at(p: u64, at: u64, v: u64) -> u64 {
    if ulib.bad(v) {
        return at
    }
    var o: u64 = tbmetrics.num_at(p, at, (v >> 24) & 255)
    o = tbmetrics.text_at_p(p, o, (&s_dot[0 as usize]) as u64)
    o = tbmetrics.num_at(p, o, (v >> 16) & 255)
    o = tbmetrics.text_at_p(p, o, (&s_dot[0 as usize]) as u64)
    o = tbmetrics.num_at(p, o, (v >> 8) & 255)
    o = tbmetrics.text_at_p(p, o, (&s_dot[0 as usize]) as u64)
    return tbmetrics.num_at(p, o, v & 255)
}

