const MAXPIN: u64 = 10

const V_MIN: u64 = 56

const RM_SYS: u64 = 1843

const RM_INFO: u64 = 0

const RM_RECENT: u64 = 8

const A_READY: u64 = 0

const A_VOLUME: u64 = 4

const A_VOLGEN: u64 = 44

const SYS_WM_PLUG_INFO: u64 = 2121

const SYS_WM_PLUG_BARGET: u64 = 2125

const PL_MAXPLUG: u64 = 1

const PG_BATPRESENT: u64 = 24

const PG_BATPERCENT: u64 = 25

const PG_BATVALID: u64 = 56

const PG_BATSTATE: u64 = 27

const PG_AC: u64 = 34

const NG_READY: u64 = 0

const NG_STATE: u64 = 8

const SYS_NETVGET: u64 = 1310

const NV_FALLBACK: u64 = 13

const NV_FBVIEW: u64 = 14

