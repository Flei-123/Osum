import msg
import fui.traypower
import ulib
import libc.text
import wlib
import wlibc
import taskbar.tbbase
import libc.clockapi

const BTN_H0: u64 = 22

const H_MIN0: u64 = 20

const H_MAX0: u64 = 48

const BAT_WARN: u64 = 20

const BAT_CRIT: u64 = 10

const ICON_MAX: u64 = 1100

const MARK_MAX: u64 = 640

const IC_W0: u64 = 16

const MK_W0: u64 = 12

const GL_W0: u64 = 16

fn pad() -> u64 {
    return wlibc.space(0)
}

fn gap() -> u64 {
    return wlibc.space(1)
}

fn btn_h() -> u64 {
    var h: u64 = wlibc.metric(wlibc.M_CTRL_H)
    var raum: u64 = tbbase.thick
    if raum > 2 * pad() {
        raum = raum - 2 * pad()
    } else {
        raum = tbbase.thick
    }

    if tbbase.vertical == 0 && tbbase.thick >= 48 * wlibc.ui_scale() && h < raum {
        h = raum
    }
    if h > raum {
        h = raum
    }
    if h == 0 {
        h = BTN_H0 * wlibc.ui_scale()
    }
    return h
}

fn h_min() -> u64 {
    return H_MIN0 * wlibc.ui_scale()
}

fn h_max() -> u64 {
    return H_MAX0 * wlibc.ui_scale()
}

fn def_h() -> u64 {
    let v: u64 = wlibc.metric(wlibc.M_CTRL_H) + 2 * wlibc.space(0)
    if v < h_min() {
        return h_min()
    }
    if v > h_max() {
        return h_max()
    }
    return v
}

fn line_h() -> u64 {
    return wlibc.type_lh(wlibc.TY_CAPTION)
}

fn start_w() -> u64 {
    let p: u64 = txt((&tbbase.k_start[0 as usize]) as u64,
        (&tbbase.s_st[0 as usize]) as u64)
    let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY), p, tlen(p))
    var w: u64 = tw + 8 + btn_h() + 4 * wlibc.ui_scale()
    let mind: u64 = wlibc.snap(btn_h() * 2)
    if w < mind {
        w = mind
    }
    return wlibc.snap(w)
}

fn gl_w() -> u64 {

    return GL_W0 * wlibc.ui_scale()
}

fn tr_pad() -> u64 {
    return 4 * wlibc.ui_scale()
}

fn tr_cell() -> u64 {
    return gl_w() + 2 * tr_pad()
}

fn tr_icx() -> u64 {
    return gl_w() + 2 * tr_pad() - 4
}

fn fld_pad() -> u64 {
    return 6 * wlibc.ui_scale()
}

fn net_pic() -> u64 {
    if glyphs_ok() {
        return 0
    }
    return state_icon(tbbase.net_state)
}

fn ic_w() -> u64 {
    return IC_W0 * wlibc.ui_scale()
}

fn mk_w() -> u64 {
    return MK_W0 * wlibc.ui_scale()
}

fn snd_icon() -> u64 {
    if tbbase.snd_mute != 0 {
        return icons.VOLUME_MUTED
    }
    if tbbase.snd_vol == 0 {
        return icons.VOLUME_ZERO
    }
    if tbbase.snd_vol >= 50 {
        return icons.VOLUME_HIGH
    }
    return icons.VOLUME_LOW
}

fn bat_icon() -> u64 {
    if tbbase.bat_have == 0 || tbbase.bat_unknown != 0 {
        return icons.BATTERY_ABSENT
    }

    if traypower.state(tbbase.bat_have, tbbase.bat_pct, tbbase.bat_chg, tbbase.bat_ac) == traypower.BV_PLUGGED {
        return icons.BATTERY_PLUG
    }
    if tbbase.bat_chg != 0 {
        return icons.BATTERY_CHARGING
    }
    if tbbase.bat_pct >= 67 {
        return icons.BATTERY_FULL
    }
    if tbbase.bat_pct >= 34 {
        return icons.BATTERY_MEDIUM
    }
    if tbbase.bat_pct >= 10 {
        return icons.BATTERY_LOW
    }
    return icons.BATTERY_EMPTY
}

fn snd_colour() -> u64 {
    if tbbase.snd_mute != 0 {
        return wlibc.theme(wlibc.T_DIM)
    }
    return wlibc.theme(wlibc.T_FG)
}

fn bat_colour() -> u64 {
    if tbbase.bat_have == 0 || tbbase.bat_unknown != 0 {
        return wlibc.theme(wlibc.T_DIM)
    }
    if tbbase.bat_chg == 0 && tbbase.bat_pct < 10 {
        return wlibc.theme(wlibc.C_DANGER)
    }
    if tbbase.bat_chg == 0 && tbbase.bat_pct < 20 {
        return wlibc.theme(wlibc.C_WARNING)
    }
    return wlibc.theme(wlibc.T_FG)
}

fn net_glyph(st: u64) -> u64 {
    if st == 4 {
        return icons.NETWORK_NO_INTERNET
    }
    if st == 3 {
        return icons.NETWORK_WIRED
    }
    if st == 2 {
        return icons.NETWORK_NO_INTERNET
    }
    if st == 1 {
        return icons.NETWORK_BLOCKED
    }
    return icons.NETWORK_OFFLINE
}

fn net_colour(st: u64) -> u64 {
    if st == 3 {
        return wlibc.theme(wlibc.T_FG)
    }
    if st == 0 {
        return wlibc.theme(wlibc.T_DIM)
    }
    return wlibc.theme(wlibc.C_WARNING)
}

fn glyphs_ok() -> bool {
    return wlibc.icon_have()
}

const LB_ALWAYS: u64 = 1

static mut f_txt: [u8; 448] = [0 as u8; 448]

static mut f_full: [u8; 224] = [0 as u8; 224]

static mut ic_buf: [u8; 4400] = [0 as u8; 4400]

static mut mk_buf: [u8; 1920] = [0 as u8; 1920]

static mut sy_buf: [u8; 640] = [0 as u8; 640]

static mut bat_msg: [u8; 112] = [0 as u8; 112]

static mut kb_warn: [u8; 18] = "tray.battery.warn\0"

static mut kb_warn2: [u8; 19] = "tray.battery.crit2\0"

const DEEP_QUIET_ROUNDS: u64 = 400

static mut sp_at: u64 = 0xFFFFFFFF

fn slow_poll_due() -> bool {
    if tbbase.ub_quiet <= DEEP_QUIET_ROUNDS {
        return true
    }
    let sec: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_UPTIME, 0, 0) / 1000
    if ulib.bad(sec) || sec != sp_at {
        sp_at = sec
        return true
    }
    return false
}

static mut s_dbg: u64 = 0

fn dbg_setup(args: u64) {
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_dbg = 1
    }
    var a_dbg: [u8; 6] = "debug\0"
    let argc: u64 = ulib.arg_count(args)
    var ai: u64 = 1
    while ai < argc {
        if ulib.streq(ulib.arg_at(args, ai), (&a_dbg[0 as usize]) as u64) {
            s_dbg = 1
        }
        ai = ai + 1
    }
}

fn say(p: u64) {
    if s_dbg == 0 {
        return
    }
    lineout.add_text(p)
}

fn sayn(v: u64) {
    if s_dbg == 0 {
        return
    }
    lineout.add_num(v)
}

fn nl() {
    if s_dbg == 0 {
        return
    }
    lineout.end_line()
}

fn tlen(p: u64) -> u64 {
    return text.length(p)
}

fn two(p: u64, at: u64, v: u64) {
    __mmio_write8((p + at) as *mut u8, (48 + (v / 10) % 10) as u8)
    __mmio_write8((p + at + 1) as *mut u8, (48 + v % 10) as u8)
}

fn num_at(p: u64, at: u64, v: u64) -> u64 {
    if v == 0 {
        __mmio_write8((p + at) as *mut u8, 48 as u8)
        __mmio_write8((p + at + 1) as *mut u8, 0 as u8)
        return at + 1
    }
    var digits: u64 = 0
    var t: u64 = v
    while t > 0 {
        digits = digits + 1
        t = t / 10
    }
    var k: u64 = digits
    t = v
    while k > 0 {
        k = k - 1
        __mmio_write8((p + at + k) as *mut u8, (48 + (t % 10)) as u8)
        t = t / 10
    }
    __mmio_write8((p + at + digits) as *mut u8, 0 as u8)
    return at + digits
}

fn text_at_p(p: u64, at: u64, q: u64) -> u64 {
    var k: u64 = 0
    while __mmio_read8((q + k) as *mut u8) != 0 as u8 {
        __mmio_write8((p + at + k) as *mut u8,
            __mmio_read8((q + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((p + at + k) as *mut u8, 0 as u8)
    return at + k
}

fn width_of(p: u64) -> u64 {
    return wlibc.text_w(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY), p, tlen(p))
}

static mut v_left: [u8; 5] = "left\0"

static mut v_center: [u8; 7] = "center\0"

fn key_is(p: u64, n: u64, k: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if __mmio_read8((k + i) as *mut u8) == 0 as u8 {
            return false
        }
        if __mmio_read8((p + i) as *mut u8)
            != __mmio_read8((k + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return __mmio_read8((k + n) as *mut u8) == 0 as u8
}

fn labels_by_name(p: u64) -> u64 {
    var w_nev: [u8; 6] = "never\0"
    var w_alw: [u8; 7] = "always\0"
    var w_room: [u8; 5] = "room\0"
    var w_full: [u8; 10] = "when_full\0"
    if ulib.streq(p, (&w_nev[0 as usize]) as u64) {
        return tbbase.LB_NEVER
    }
    if ulib.streq(p, (&w_alw[0 as usize]) as u64) {
        return LB_ALWAYS
    }
    if ulib.streq(p, (&w_room[0 as usize]) as u64) {
        return tbbase.LB_ROOM
    }
    if ulib.streq(p, (&w_full[0 as usize]) as u64) {
        return tbbase.LB_ROOM
    }
    return tbbase.cf_labels
}

fn align_by_name(p: u64) -> u64 {
    if __mmio_read8((p) as *mut u8) == 99 as u8 {
        return tbbase.AL_CENTER
    }
    return tbbase.AL_LEFT
}

static mut v_never: [u8; 6] = "never\0"

static mut v_always: [u8; 7] = "always\0"

static mut v_room: [u8; 5] = "room\0"

fn labels_name(v: u64) -> u64 {
    if v == tbbase.LB_NEVER {
        return (&v_never[0 as usize]) as u64
    }
    if v == LB_ALWAYS {
        return (&v_always[0 as usize]) as u64
    }
    return (&v_room[0 as usize]) as u64
}

fn align_name(a: u64) -> u64 {
    if a == tbbase.AL_CENTER {
        return (&v_center[0 as usize]) as u64
    }
    return (&v_left[0 as usize]) as u64
}

fn clamp(v: u64, lo: u64, hi: u64) -> u64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn wk_num(b: u64, at: u64, key: u64, v: u64) -> u64 {
    var a: u64 = text_at_p(b, at + 1, key)
    __mmio_write8((b + a) as *mut u8, 61 as u8)
    a = num_at(b, a + 1, v)
    __mmio_write8((b + a) as *mut u8, 10 as u8)
    return a
}

fn wk_txt(b: u64, at: u64, key: u64, val: u64) -> u64 {
    var a: u64 = text_at_p(b, at + 1, key)
    __mmio_write8((b + a) as *mut u8, 61 as u8)
    a = text_at_p(b, a + 1, val)
    __mmio_write8((b + a) as *mut u8, 10 as u8)
    return a
}

static mut g_hd: [u8; 17] = "0123456789abcdef\0"

static mut g_hx: [u8; 7] = "000000\0"

fn say_hex6(v: u64) {
    var i: u64 = 0
    while i < 6 {
        let d: u64 = (v >> ((5 - i) * 4)) & 15
        g_hx[(i) as usize] = g_hd[(d) as usize]
        i = i + 1
    }
    g_hx[(6) as usize] = 0
    say((&g_hx[0 as usize]) as u64)
}

const BADGE_LEVEL: u64 = 32

fn badge_channel(c: u64, dunkler: bool) -> u64 {
    if dunkler {
        if c >= BADGE_LEVEL {
            return c - BADGE_LEVEL
        }
        return c + BADGE_LEVEL
    }
    if c + BADGE_LEVEL <= 255 {
        return c + BADGE_LEVEL
    }
    return c - BADGE_LEVEL
}

fn badge_color(reason: u64) -> u64 {
    let r: u64 = (reason >> 16) & 0xFF
    let g: u64 = (reason >> 8) & 0xFF
    let b: u64 = reason & 0xFF
    let dunkler: bool = (r * 299 + g * 587 + b * 114) / 1000 >= 128
    return (badge_channel(r, dunkler) << 16)
        | (badge_channel(g, dunkler) << 8)
        | badge_channel(b, dunkler)
}

fn schild_an() -> bool {
    return wlibc.tb_alpha_fx() < 100
}

fn badge_reason(reason: u64) -> u64 {
    if schild_an() {
        return badge_color(reason)
    }
    return reason
}

fn schild_noetig(below: u64) -> bool {
    let key: u64 = wlibc.theme(wlibc.C_TASKBAR_BG)
    var d: u64 = 0
    var s: u64 = 0
    while s < 3 {
        let a: u64 = (below >> (s * 8)) & 0xFF
        let b: u64 = (key >> (s * 8)) & 0xFF
        if a > b {
            d = d + (a - b)
        } else {
            d = d + (b - a)
        }
        s = s + 1
    }
    return d < 96
}

const SCHILD_TRAY_MIN: u64 = 75

fn text_schild(x: u64, base: u64, p: u64, n: u64, ty: u64, below: u64) {
    if !schild_an() {
        return
    }
    if tbbase.schild_tray != 0 && wlibc.tb_alpha_fx() >= SCHILD_TRAY_MIN {
        return
    }
    if !schild_noetig(below) {
        return
    }
    if n == 0 {
        return
    }
    let tw: u64 = wlib.draw_text_w(p, n, ty)
    if tw == 0 {
        return
    }
    let asc: u64 = wlib.draw_ascent(ty)
    let cur_gap: u64 = 3 * wlibc.ui_scale()
    var py: u64 = 0
    if base > asc + 1 {
        py = base - asc - 1
    }
    var px: u64 = 0
    if x > cur_gap {
        px = x - cur_gap
    }
    wlib.draw_board(px, py, tw + 2 * cur_gap, line_h() + 2,
        wlib.MR_BUTTON, wlibc.EL_FLAT,
        badge_color(wlibc.theme(wlibc.C_TASKBAR_BG)), 0)
    tbbase.schild_n = tbbase.schild_n + 1
}

fn text_mit_schild(x: u64, base: u64, p: u64, n: u64, fg: u64,
    ty: u64, below: u64) -> u64 {
    text_schild(x, base, p, n, ty, below)
    return wlib.draw_text(x, base, p, n, fg, ty)
}

static mut g_sa: [u8; 21] = "taskbar: schild an=\0\0"

static mut g_sf: [u8; 8] = " farbe=\0"

static mut g_sg: [u8; 8] = " grund=\0"

static mut g_sn: [u8; 4] = " n=\0"

fn schild_say() {
    say((&g_sa[0 as usize]) as u64)
    if schild_an() {
        sayn(1)
    } else {
        sayn(0)
    }
    say((&g_sf[0 as usize]) as u64)
    say_hex6(badge_color(wlibc.theme(wlibc.C_TASKBAR_BG)) & 0xFFFFFF)
    say((&g_sg[0 as usize]) as u64)
    say_hex6(wlibc.theme(wlibc.C_TASKBAR_BG) & 0xFFFFFF)
    say((&g_sn[0 as usize]) as u64)
    sayn(tbbase.schild_n)
    nl()
}

fn loc(v: u64, o: u64) -> u64 {
    if v < o {
        return 0
    }
    return v - o
}

fn rect_for(edge: u64, thickness: u64) {
    if edge == wlibc.WE_LEFT || edge == wlibc.WE_RIGHT {
        tbbase.r_w = thickness
        tbbase.r_h = tbbase.sh
        tbbase.r_y = tbbase.hy
        if edge == wlibc.WE_LEFT {
            tbbase.r_x = tbbase.hx
        } else {
            tbbase.r_x = tbbase.hx + tbbase.sw - thickness
        }
    } else {
        tbbase.r_w = tbbase.sw
        tbbase.r_h = thickness
        tbbase.r_x = tbbase.hx
        if edge == wlibc.WE_TOP {
            tbbase.r_y = tbbase.hy
        } else {
            tbbase.r_y = tbbase.hy + tbbase.sh - thickness
        }
    }
}

fn thickness_of(edge: u64) -> u64 {
    if edge == wlibc.WE_LEFT || edge == wlibc.WE_RIGHT {
        return tbbase.cf_width
    }
    return tbbase.cf_height
}

fn geometry() {
    tbbase.thick = thickness_of(tbbase.cf_edge)
    if tbbase.cf_edge == wlibc.WE_LEFT || tbbase.cf_edge == wlibc.WE_RIGHT {
        tbbase.vertical = 1
    } else {
        tbbase.vertical = 0
    }
    rect_for(tbbase.cf_edge, tbbase.thick)
    tbbase.bar_x = tbbase.r_x
    tbbase.bar_y = tbbase.r_y
    tbbase.bar_w = tbbase.r_w
    tbbase.bar_h = tbbase.r_h
}

fn window_rect() {
    if tbbase.shown != 0 {
        tbbase.win_x = tbbase.bar_x
        tbbase.win_y = tbbase.bar_y
        tbbase.win_w = tbbase.bar_w
        tbbase.win_h = tbbase.bar_h
        return
    }
    rect_for(tbbase.cf_edge, tbbase.SLIVER)
    tbbase.win_x = tbbase.r_x
    tbbase.win_y = tbbase.r_y
    tbbase.win_w = tbbase.r_w
    tbbase.win_h = tbbase.r_h
}

fn mono_ms() -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    if ulib.bad(ulib.sys(228, 1, (&ts[0 as usize]) as u64, 0)) {
        return 0
    }
    return ts[0 as usize] * 1000 + ts[1 as usize] / 1000000
}

static mut p_icons: [u8; 14] = "/etc/netview/\0"

static mut n_state: [u8; 54] = "state-nocarrier\0state-noip\0state-noroute\0state-online\0"

static mut n_mark: [u8; 35] = "mark-filtered\0mark-faked\0mark-none\0"

static mut n_sys: [u8; 11] = "sys-faking\0"

fn nth(p: u64, i: u64) -> u64 {
    var at: u64 = p
    var k: u64 = 0
    while k < i {
        while __mmio_read8((at) as *mut u8) != 0 as u8 {
            at = at + 1
        }
        at = at + 1
        k = k + 1
    }
    return at
}

fn icon_read(name: u64, dst: u64, max: u64) -> u64 {
    var path: [u8; 64] = [0 as u8; 64]
    let a: u64 = ulib.strcpy((&path[0 as usize]) as u64,
        (&p_icons[0 as usize]) as u64)
    let _b: u64 = ulib.strcpy((&path[0 as usize]) as u64 + a, name)
    let fd: u64 = io.open((&path[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = io.read_full(fd, dst, max)
    io.close(fd)
    if ulib.bad(n) {
        return 0
    }
    tbbase.ic_files = tbbase.ic_files + 1
    if tbbase.ic_min == 0 || n < tbbase.ic_min {
        tbbase.ic_min = n
    }
    return n
}

fn icons_load() {
    tbbase.ic_ok = 0
    tbbase.mk_ok = 0
    tbbase.ic_files = 0
    tbbase.ic_min = 0
    var i: u64 = 0
    while i < 4 {
        if icon_read(nth((&n_state[0 as usize]) as u64, i),
            (&ic_buf[0 as usize]) as u64 + i * ICON_MAX, ICON_MAX) > 12 {
            tbbase.ic_ok = tbbase.ic_ok + 1
        }
        i = i + 1
    }
    i = 0
    while i < 3 {
        if icon_read(nth((&n_mark[0 as usize]) as u64, i),
            (&mk_buf[0 as usize]) as u64 + i * MARK_MAX, MARK_MAX) > 12 {
            tbbase.mk_ok = tbbase.mk_ok + 1
        }
        i = i + 1
    }
    tbbase.sy_ok = 0
    if icon_read((&n_sys[0 as usize]) as u64,
        (&sy_buf[0 as usize]) as u64, MARK_MAX) > 12 {
        tbbase.sy_ok = 1
    }
}

fn sys_icon() -> u64 {
    if tbbase.nv_faking == 0 || tbbase.sy_ok == 0 {
        return 0
    }
    return (&sy_buf[0 as usize]) as u64
}

fn state_icon(s: u64) -> u64 {
    var k: u64 = s
    if k == 4 {
        k = 2
    }
    if k > 3 || tbbase.ic_ok < 4 {
        return 0
    }
    return (&ic_buf[0 as usize]) as u64 + k * ICON_MAX
}

fn mark_icon(v: u64) -> u64 {
    if v == 0 || v > 3 || tbbase.mk_ok < 3 {
        return 0
    }
    return (&mk_buf[0 as usize]) as u64 + (v - 1) * MARK_MAX
}

fn hot_field(lx: u64, ly: u64) -> u64 {
    var f: u64 = 0
    while f < tbbase.F_N {
        if tbbase.f_w[(f) as usize] != 0 && lx >= tbbase.f_x[(f) as usize]
            && lx < tbbase.f_x[(f) as usize] + tbbase.f_w[(f) as usize]
            && ly >= tbbase.f_y[(f) as usize]
            && ly < tbbase.f_y[(f) as usize] + tbbase.f_h[(f) as usize] {
            return f
        }
        f = f + 1
    }
    return 255
}

fn in_rect(lx: u64, ly: u64, x: u64, y: u64, w: u64, h: u64) -> bool {
    return w != 0 && lx >= x && lx < x + w && ly >= y && ly < y + h
}

fn hot_button(lx: u64, ly: u64) -> u64 {
    if in_rect(lx, ly, tbbase.st_x, tbbase.st_y, tbbase.st_w, tbbase.st_h) {
        return 1
    }
    if in_rect(lx, ly, tbbase.chv_x, tbbase.chv_y, tbbase.chv_w, tbbase.chv_h) {
        return 2
    }
    if in_rect(lx, ly, tbbase.tv_x, tbbase.tv_y, tbbase.tv_w, tbbase.tv_h) {
        return 3
    }
    var i: u64 = 0
    while i < tbbase.npin {
        if in_rect(lx, ly, tbbase.px_[(i) as usize], tbbase.py_[(i) as usize],
            tbbase.pw_[(i) as usize], tbbase.ph_[(i) as usize]) {
            return 100 + i
        }
        i = i + 1
    }
    i = 0
    while i < tbbase.nk {
        if in_rect(lx, ly, tbbase.kx[(i) as usize], tbbase.ky[(i) as usize],
            tbbase.kw[(i) as usize], tbbase.kh[(i) as usize]) {
            return 200 + i
        }
        i = i + 1
    }
    return 0
}

static mut p_time: [u8; 16] = "/etc/time.conf\0\0"

fn full_of(f: u64) -> u64 {
    return (&f_full[0 as usize]) as u64 + f * 32
}

fn line_of(f: u64, l: u64) -> u64 {
    return (&f_txt[0 as usize]) as u64 + (f * 2 + l) * 32
}

static mut off_at: u64 = 0xFFFF

fn offset_read() {
    let sec2: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_UPTIME, 0, 0) / 2000
    if !ulib.bad(sec2) {
        if sec2 == off_at {
            return
        }
        off_at = sec2
    }
    var buf: [u8; 64] = [0 as u8; 64]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_time[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let b: u64 = (&buf[0 as usize]) as u64
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, b, 63)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return
    }
    var i: u64 = 0
    var v: u64 = 0
    var digits: u64 = 0
    var in_value: bool = false
    while i < n {
        let c: u64 = __mmio_read8((b + i) as *mut u8) as u64
        if c == 61 {
            in_value = true
        } else if in_value && c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
            digits = digits + 1
        } else if digits > 0 {
            i = n
        }
        i = i + 1
    }
    if digits > 0 && v <= 1440 {
        tbbase.offset = v
    }
}

fn txt(key: u64, fallback: u64) -> u64 {
    let t: u64 = msg.get(key)
    if t == key {
        return fallback
    }
    return t
}

fn bat_warn_check() {
    if tbbase.bat_have == 0 || tbbase.bat_unknown != 0 {
        tbbase.bat_warned = 0
        return
    }
    if tbbase.bat_chg != 0 {
        tbbase.bat_warned = 0
        return
    }
    var level: u64 = 0
    if tbbase.bat_pct <= BAT_CRIT {
        level = 2
    } else {
        if tbbase.bat_pct <= BAT_WARN {
            level = 1
        }
    }
    if level == 0 {
        tbbase.bat_warned = 0
        return
    }
    if level <= tbbase.bat_warned {
        return
    }
    tbbase.bat_warned = level
    var key: u64 = (&kb_warn[0 as usize]) as u64
    if level == 2 {
        key = (&kb_warn2[0 as usize]) as u64
    }
    let p: u64 = (&bat_msg[0 as usize]) as u64
    let src: u64 = msg.get(key)
    var at: u64 = 0
    while at < 90 && __mmio_read8((src + at) as *mut u8) != 0 as u8 {
        __mmio_write8((p + at) as *mut u8, __mmio_read8((src + at) as *mut u8))
        at = at + 1
    }
    __mmio_write8((p + at) as *mut u8, 32 as u8)
    at = at + 1
    at = num_at(p, at, tbbase.bat_pct)
    __mmio_write8((p + at) as *mut u8, 37 as u8)
    __mmio_write8((p + at + 1) as *mut u8, 0 as u8)
    let _r: u64 = wlib.noti_post(level, p, at + 1)
}

static mut s_tx: [u8; 15] = "taskbar: text \0"

static mut s_tf: [u8; 5] = " fg=\0"

static mut s_tg: [u8; 5] = " bg=\0"

static mut s_tw: [u8; 5] = " tw=\0"

fn say_text(mark: u64, x: u64, base: u64, fg: u64, bg: u64, txt: u64) {
    if tbbase.s_report == 0 {
        return
    }
    say((&s_tx[0 as usize]) as u64)
    say(mark)
    say((&tbbase.s_tX[0 as usize]) as u64)
    sayn(x)
    say((&tbbase.s_tb[0 as usize]) as u64)
    sayn(base)
    say((&s_tf[0 as usize]) as u64)
    sayn(fg)
    say((&s_tg[0 as usize]) as u64)
    sayn(bg)
    say((&s_tw[0 as usize]) as u64)
    sayn(wlibc.text_w(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY), txt, tlen(txt)))
    say((&tbbase.s_tt[0 as usize]) as u64)
    say(txt)
    nl()
}

static mut s_bgl: [u8; 20] = "taskbar: badge txt=\0"

static mut s_bgn: [u8; 4] = " n=\0"

fn badge_paint(px0: u64, py0: u64, pw0: u64, n: u64, report: bool) {
    var dg: [u8; 4] = [0 as u8; 4]
    var dl: u64 = 1
    if n > 9 {
        dg[0 as usize] = 57 as u8
        dg[1 as usize] = 43 as u8
        dl = 2
    } else {
        dg[0 as usize] = (48 + n) as u8
    }
    dg[(dl) as usize] = 0 as u8
    let dp: u64 = (&dg[0 as usize]) as u64
    let tw: u64 = wlib.draw_text_w(dp, dl, wlibc.TY_CAPTION)
    let bh: u64 = btn_h() / 2 + 2
    var bw: u64 = tw + 6
    if bw < bh {
        bw = bh
    }
    let bx: u64 = px0 + pw0 - bw - 1
    let by: u64 = py0 + 1
    wlib.draw_board(bx, by, bw, bh, wlib.MR_BUTTON, wlibc.EL_FLAT,
        wlibc.theme(wlibc.C_ACCENT), 0)
    let base: u64 = by + (bh + wlib.draw_ascent(wlibc.TY_CAPTION)) / 2 - 1
    let _e: u64 = text_mit_schild(bx + (bw - tw) / 2, base, dp, dl,
        wlibc.theme(wlibc.C_ON_ACCENT), wlibc.TY_CAPTION,
        wlibc.theme(wlibc.C_ACCENT))
    if report {
        say((&s_bgl[0 as usize]) as u64)
        say(dp)
        say((&s_bgn[0 as usize]) as u64)
        sayn(n)
        say((&tbbase.s_tX[0 as usize]) as u64)
        sayn(bx)
        say((&tbbase.s_gy[0 as usize]) as u64)
        sayn(by)
        say((&tbbase.s_gw[0 as usize]) as u64)
        sayn(bw)
        say((&tbbase.s_gh[0 as usize]) as u64)
        sayn(bh)
        nl()
    }
}

static mut s_hkapp: [u8; 19] = "taskbar: hk start \0"

fn start_bundle(name: u64, len: u64) {
    var pp: [u8; 64] = [0 as u8; 64]
    var pv: [u8; 7] = "/apps/\0"
    var pn2: [u8; 11] = ".osp/start\0"
    var q: u64 = 0
    var k: u64 = 0
    while k < 6 {
        pp[(q) as usize] = pv[(k) as usize]
        q = q + 1
        k = k + 1
    }
    k = 0
    while k < len && k < 23 {
        pp[(q) as usize] = *((name + k) as *mut u8)
        q = q + 1
        k = k + 1
    }
    k = 0
    while k < 10 {
        pp[(q) as usize] = pn2[(k) as usize]
        q = q + 1
        k = k + 1
    }
    pp[(q) as usize] = 0 as u8
    let pid: u64 = appreg.launch((&pp[0 as usize]) as u64, 0, 0)
    say((&s_hkapp[0 as usize]) as u64)
    say((&pp[0 as usize]) as u64)
    say((&tbbase.s_pinpid[0 as usize]) as u64)
    sayn(pid)
    nl()
}
