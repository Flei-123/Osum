profile app

import filelog.filelog
import libc.io
import libc.text
import ulib
import libc.memcopy

export { sym_event, battery_unknown, LOG_OK, LOG_MISS, LOG_FALLBACK, LOG_SHORT }

const LOG_OK: u64 = 0
const LOG_MISS: u64 = 1
const LOG_FALLBACK: u64 = 2
const LOG_SHORT: u64 = 3
const LOG_MAX: u64 = 48

static mut PATH_TASKBAR_LOG: [u8; 21] = "/var/log/taskbar.log\0"
static mut TAG_SYM: [u8; 5] = "sym \0"
static mut K_KIND: [u8; 5] = "kind\0"
static mut K_APP: [u8; 4] = "app\0"
static mut K_WHY: [u8; 4] = "why\0"
static mut K_GOT: [u8; 4] = "got\0"
static mut K_INK: [u8; 4] = "ink\0"
static mut KIND_NAMES: [u8; 28] = "ok\0\0\0\0\0miss\0\0\0fb\0\0\0\0\0short\0\0"
static mut written: u64 = 0
static mut PATH_BATTERY: [u8; 14] = "/proc/battery\0"
static mut TAG_BAT: [u8; 5] = "bat \0"
static mut K_RAW: [u8; 4] = "raw\0"
static mut bat_now: [u8; 192] = [0 as u8; 192]
static mut bat_last: [u8; 192] = [0 as u8; 192]
static mut bat_written: u64 = 0

fn sym_event(kind: u64, app: u64, why: u64, got: u64, ink: u64) {
    if written >= LOG_MAX {
        return
    }
    written = written + 1
    filelog.begin((&PATH_TASKBAR_LOG[0 as usize]) as u64, (&TAG_SYM[0 as usize]) as u64)
    filelog.text((&K_KIND[0 as usize]) as u64, (&KIND_NAMES[0 as usize]) as u64 + kind * 7)
    filelog.text((&K_APP[0 as usize]) as u64, app)
    filelog.num((&K_WHY[0 as usize]) as u64, why)
    filelog.num((&K_GOT[0 as usize]) as u64, got)
    filelog.num((&K_INK[0 as usize]) as u64, ink)
    filelog.end()
}

fn battery_unknown() {
    if bat_written >= LOG_MAX {
        return
    }
    let fd: u64 = io.open((&PATH_BATTERY[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return
    }
    memcopy.fill((&bat_now[0 as usize]) as u64, 0, 192)
    let n: u64 = io.read_full(fd, (&bat_now[0 as usize]) as u64, 190)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return
    }
    var at: u64 = 0
    while at < 190 {
        if bat_now[at as usize] == 10 {
            bat_now[at as usize] = 0
        }
        at = at + 1
    }
    if text.equal((&bat_now[0 as usize]) as u64, (&bat_last[0 as usize]) as u64) {
        return
    }
    text.copy_text((&bat_last[0 as usize]) as u64, (&bat_now[0 as usize]) as u64, 192)
    bat_written = bat_written + 1
    filelog.begin((&PATH_TASKBAR_LOG[0 as usize]) as u64, (&TAG_BAT[0 as usize]) as u64)
    filelog.text((&K_RAW[0 as usize]) as u64, (&bat_now[0 as usize]) as u64)
    filelog.end()
}
