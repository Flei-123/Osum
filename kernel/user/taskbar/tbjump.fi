profile app

import fuiapp.hostwin
import fuiapp.hostwinp
import jumplist
import taskbar_ctx
import taskbar.tbbase
import taskbar.tbhover
import taskbar.tbmetrics
import taskbar.tbpaint
import ulib
import ctxreg

const KILL_SIGNAL: u64 = 137

static mut s_pin_new: [u8; 23] = "taskbar: pin new start\0"

fn window_index(ctx: u64, arg: u64) -> u64 {
    if ctx == ctxreg.CTX_TASKBAR_PIN {
        if arg < tbbase.npin {
            return tbbase.pinwin[(arg) as usize]
        }
        return tbbase.MAXK
    }
    return arg - 1
}

fn window_id(ctx: u64, arg: u64) -> u64 {
    let i: u64 = window_index(ctx, arg)
    if i >= tbbase.nk {
        return 0
    }
    return tbbase.knv[(i) as usize]
}

fn launch(ctx: u64, arg: u64, app: u64) {
    if ctx == ctxreg.CTX_TASKBAR_PIN && arg < tbbase.npin {
        tbpaint.pin_exec(arg)
        tbmetrics.say((&s_pin_new[0 as usize]) as u64)
        tbmetrics.nl()
        return
    }
    tbhover.app_exec(app)
}

fn end_task(id: u64) {
    if id == 0 {
        return
    }
    let pid: u64 = hostwin.win_owner_pid(id)
    if pid != 0 {
        let _k: u64 = ulib.sys(ulib.SYS_KILL, pid, KILL_SIGNAL, 0)
    }
}

fn run(ctx: u64, arg: u64, act: u64) -> bool {
    let app: u64 = taskbar_ctx.picked_app()
    if act == jumplist.ACT_HEADER {
        return true
    }
    if jumplist.is_entry(act) {
        let _p: u64 = jumplist.run_entry(app, act)
        return true
    }
    if act == jumplist.ACT_LAUNCH {
        launch(ctx, arg, app)
        return true
    }
    if act == jumplist.ACT_PIN {
        tbpaint.pin_add(app)
        return true
    }
    if act == jumplist.ACT_UNPIN {
        tbpaint.pin_remove(app)
        return true
    }
    if act == jumplist.ACT_END_TASK {
        end_task(window_id(ctx, arg))
        return true
    }
    if act == jumplist.ACT_CLOSE_WINDOW {
        let id: u64 = window_id(ctx, arg)
        if id != 0 {
            let _c: u64 = hostwin.win_act(id, hostwinp.WA_CLOSE)
        }
        return true
    }
    return false
}
