profile app

import barpop
import fuiapp.hostwinp
import notecard
import notifc
import qs
import uiscale
import ulib
import wlibc
import taskbar.tbbase
import taskbar.tbhover
import taskbar.tblayout
import taskbar.tbmetrics
import taskbar.tbstatus
import libc.clockapi

static mut s_sp: [u8; 23] = "taskbar: launcher pid=\0"

static mut p_start: [u8; 14] = "/bin/launcher\0"

static mut menu_pid: u64 = 0

static mut s_tog: [u8; 24] = "taskbar: startmenue zu\0\0"

static mut s_tog_auf: [u8; 25] = "taskbar: startmenue auf\0\0"

static mut s_tog_bad: [u8; 29] = "taskbar: startmenu ERROR rc=\0"

const TOAST_TICKS: u64 = 400

const TOAST_EIN: u64 = 20

const TOAST_AUS: u64 = 25

static mut to_win: u64 = 0xFFFFFFFFFFFFFFFF

static mut to_seit: u64 = 0

static mut to_count: u64 = 0

static mut to_seen: u64 = 0

static mut to_text: u64 = 0

static mut to_prio: u64 = 0

static mut to_w: u64 = 0

static mut to_h: u64 = 0

static mut to_erst: u64 = 1

static mut to_alpha_war: u64 = 0xFFFFFFFFFFFFFFFF

static mut to_takt: u64 = 0

static mut to_x: u64 = 0

static mut to_y: u64 = 0

static mut to_btn: u64 = 0

static mut s_to: [u8; 18] = "taskbar: toast [\0\0"

static mut s_tox: [u8; 6] = "] x=\0\0"

static mut s_toy: [u8; 5] = " y=\0\0"

static mut s_tow: [u8; 5] = " w=\0\0"

static mut s_toh: [u8; 5] = " h=\0\0"

static mut s_top: [u8; 8] = " prio=\0\0"

static mut s_ton: [u8; 5] = " n=\0\0"

static mut s_tozu: [u8; 19] = "taskbar: toast zu\0\0"

static mut s_toast_full: [u8; 24] = "taskbar: toast no space\0"

static mut to_puf: [u8; 96] = [0 as u8; 96]

fn toast_zu() {
    if to_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    to_win = 0xFFFFFFFFFFFFFFFF
    to_text = 0
    barpop.toast_hide()
    tbmetrics.say((&s_tozu[0 as usize]) as u64)
    tbmetrics.nl()
}

fn toast_alpha(now: u64) -> u64 {
    if to_win == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    if now < to_seit {
        return 255
    }
    let d: u64 = now - to_seit
    if d < TOAST_EIN {
        return d * 255 / TOAST_EIN
    }
    if d >= TOAST_TICKS {
        return 0
    }
    if d + TOAST_AUS >= TOAST_TICKS {
        return (TOAST_TICKS - d) * 255 / TOAST_AUS
    }
    return 255
}

fn toast_auf(text: u64, prio: u64) {
    if text == 0 || tbmetrics.tlen(text) == 0 {
        return
    }
    toast_zu()
    let sc: u64 = uiscale.ui_scale()
    let bw: u64 = notecard.width_px()
    let bh: u64 = notecard.card_h(notecard.TOAST_SLOT)
    let cur_gap: u64 = 12 * sc
    var x: u64 = tbbase.hx
    if tbbase.sw > bw + cur_gap {
        x = tbbase.hx + tbbase.sw - bw - cur_gap
    }
    var y: u64 = tbbase.hy + cur_gap
    if tbbase.bar_y == tbbase.hy && tbbase.bar_h != 0 {
        y = tbbase.hy + tbbase.bar_h + cur_gap
    }
    let i: u64 = barpop.toast_show(x, y, bw, bh)
    if i != 0 {
        tbmetrics.say((&s_toast_full[0 as usize]) as u64)
        tbmetrics.nl()
        return
    }
    to_win = 1
    to_x = x
    to_y = y
    to_btn = wlibc.mouse_btn() & 1
    to_w = bw
    to_h = bh
    to_text = text
    to_prio = prio
    to_seit = clockapi.ticks()
    to_count = to_count + 1
    to_alpha_war = 0xFFFFFFFFFFFFFFFF
    tbmetrics.say((&s_to[0 as usize]) as u64)
    tbmetrics.say(text)
    tbmetrics.say((&s_tox[0 as usize]) as u64)
    tbmetrics.sayn(x)
    tbmetrics.say((&s_toy[0 as usize]) as u64)
    tbmetrics.sayn(y)
    tbmetrics.say((&s_tow[0 as usize]) as u64)
    tbmetrics.sayn(bw)
    tbmetrics.say((&s_toh[0 as usize]) as u64)
    tbmetrics.sayn(bh)
    tbmetrics.say((&s_top[0 as usize]) as u64)
    tbmetrics.sayn(prio)
    tbmetrics.say((&s_ton[0 as usize]) as u64)
    tbmetrics.sayn(to_count)
    tbmetrics.nl()
}

fn toast_up() -> bool {
    return to_win != 0xFFFFFFFFFFFFFFFF
}

fn toast_clicked() -> bool {
    let btn: u64 = wlibc.mouse_btn() & 1
    let was: u64 = to_btn
    to_btn = btn
    if btn == 0 || was != 0 {
        return false
    }
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    if mx < to_x || my < to_y || mx >= to_x + to_w || my >= to_y + to_h {
        return false
    }
    if notecard.hit_dismiss(mx - to_x, my - to_y) {
        toast_zu()
        return true
    }
    let _a: bool = notifc.act_newest()
    toast_zu()
    return true
}

fn toast_step() {

    to_takt = to_takt + 1
    if (to_takt % 10) != 0 && to_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    let c: u64 = wlibc.noti_total()
    if to_erst != 0 {
        to_erst = 0
        to_seen = c
        return
    }
    if c > to_seen {
        to_seen = c
        let n: u64 = wlibc.noti_peek(0, (&to_puf[0 as usize]) as u64, 94)
        if n > 0 {
            to_puf[(n) as usize] = 0 as u8
            var pr: u64 = wlibc.noti_prio(0)
            if pr == 0 {
                pr = 1
            }

            if !qs.dnd_on() {
                notecard.from_bus(notecard.TOAST_SLOT, (&to_puf[0 as usize]) as u64, n, pr, c - 1)
                toast_auf(notecard.text_ptr(notecard.TOAST_SLOT), pr)
            }
        }
    }
    if to_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    if toast_clicked() {
        return
    }
    let now: u64 = clockapi.ticks()
    if now < to_seit {
        to_seit = now
        return
    }
    if now - to_seit >= TOAST_TICKS {
        toast_zu()
        return
    }
    let a: u64 = toast_alpha(now)
    if a != to_alpha_war {
        to_alpha_war = a
    }
}

static mut s_hkdesk: [u8; 24] = "taskbar: hk desktop n=\0\0"

static mut desk_hidden: u64 = 0

static mut desk_ids: [u64; 16] = [0 as u64; 16]

static mut desk_n: u64 = 0

fn show_desktop_toggle() {
    let _l: bool = tblayout.list_read()
    var i: u64 = 0
    if desk_hidden == 0 {
        desk_n = 0
        while i < tbbase.nk && desk_n < 16 {
            desk_ids[(desk_n) as usize] = tbbase.kid[(i) as usize]
            desk_n = desk_n + 1
            let _a: u64 = wlibc.win_act(tbbase.kid[(i) as usize], hostwinp.WA_HIDE)
            i = i + 1
        }
        desk_hidden = 1
    } else {
        while i < desk_n {
            let _b: u64 = wlibc.win_act(desk_ids[(i) as usize], hostwinp.WA_RAISE)
            i = i + 1
        }
        desk_hidden = 0
    }
    tbmetrics.say((&s_hkdesk[0 as usize]) as u64)
    tbmetrics.sayn(desk_n)
    tbmetrics.nl()
}

fn snip_launch(region: bool) {
    var path: [u8; 10] = "/bin/snip\0"
    var path_t: [u8; 11] = "/bin/snipt\0"
    var flag_q: [u8; 3] = "-q\0"
    var flag_r: [u8; 3] = "-r\0"
    var s_sn: [u8; 22] = "taskbar: snip pid=\0\0\0\0"
    var argv: [u64; 3] = [0 as u64; 3]
    argv[0 as usize] = (&path[0 as usize]) as u64
    if region {
        argv[0 as usize] = (&path_t[0 as usize]) as u64
        argv[1 as usize] = (&flag_r[0 as usize]) as u64
    } else {
        argv[1 as usize] = (&flag_q[0 as usize]) as u64
    }

    let pid: u64 = ulib.sys(ulib.SYS_EXEC, argv[0 as usize],
        (&argv[0 as usize]) as u64, 2)
    tbmetrics.say((&s_sn[0 as usize]) as u64)
    tbmetrics.sayn(pid)
    tbmetrics.nl()
}

fn startmenue_um() {

    wlibc.start_head_set(tbbase.my_head)
    let w: u64 = tbhover.launcher_window()
    if w != 0 {
        let rc: u64 = wlibc.win_act(w, hostwinp.WA_TOGGLE)
        if ulib.bad(rc) {
            tbmetrics.say((&s_tog_bad[0 as usize]) as u64)
            tbmetrics.sayn(rc)
            tbmetrics.nl()
            return
        }
        if tbbase.menu_was_open != 0 {
            tbmetrics.say((&s_tog[0 as usize]) as u64)
        } else {
            tbmetrics.say((&s_tog_auf[0 as usize]) as u64)
        }
        tbmetrics.nl()
        return
    }

    let pid: u64 = ulib.sys(ulib.SYS_EXEC,
        (&p_start[0 as usize]) as u64, 0, 0)
    menu_pid = pid
    tbmetrics.say((&s_sp[0 as usize]) as u64)
    tbmetrics.sayn(pid)
    tbmetrics.nl()
}

static mut t_tvn: [u8; 10] = "Task view\0"

static mut t_chn: [u8; 13] = "Hidden icons\0"

static mut t_stn: [u8; 6] = "Start\0"

const BI_MAX: u64 = 48

const K_TASK: u64 = 30

const K_PLUG: u64 = 80

fn bi_add(x: u64, y: u64, w: u64, h: u64, key: u64, lab: u64) {
    if w == 0 || h == 0 || tbbase.bi_n >= BI_MAX {
        return
    }
    tbbase.bi_x[(tbbase.bi_n) as usize] = x
    tbbase.bi_y[(tbbase.bi_n) as usize] = y
    tbbase.bi_w[(tbbase.bi_n) as usize] = w
    tbbase.bi_h[(tbbase.bi_n) as usize] = h
    tbbase.bi_k[(tbbase.bi_n) as usize] = key
    tbbase.bi_l[(tbbase.bi_n) as usize] = lab
    tbbase.bi_n = tbbase.bi_n + 1
}

fn bi_after(p: u64, q: u64) -> bool {
    if tbbase.bi_y[(p) as usize] != tbbase.bi_y[(q) as usize] {
        return tbbase.bi_y[(p) as usize] > tbbase.bi_y[(q) as usize]
    }
    return tbbase.bi_x[(p) as usize] > tbbase.bi_x[(q) as usize]
}

fn bi_collect() {
    tbbase.bi_n = 0
    bi_add(tbbase.st_x, tbbase.st_y, tbbase.st_w, tbbase.st_h, tbbase.K_START,
        tbmetrics.txt((&tbbase.k_start[0 as usize]) as u64, (&t_stn[0 as usize]) as u64))
    if tbbase.tv_w != 0 {
        bi_add(tbbase.tv_x, tbbase.tv_y, tbbase.tv_w, tbbase.tv_h, tbbase.K_TV, (&t_tvn[0 as usize]) as u64)
    }
    if tbbase.chv_w != 0 {
        bi_add(tbbase.chv_x, tbbase.chv_y, tbbase.chv_w, tbbase.chv_h, tbbase.K_CHEV, (&t_chn[0 as usize]) as u64)
    }
    var i: u64 = 0
    while i < tbbase.npin {
        bi_add(tbbase.px_[(i) as usize], tbbase.py_[(i) as usize], tbbase.pw_[(i) as usize],
            tbbase.ph_[(i) as usize], tbbase.K_PIN + i, (&tbbase.pinname[0 as usize]) as u64 + i * 24)
        i = i + 1
    }
    i = 0
    while i < tbbase.nk {
        if tbbase.kw[(i) as usize] != 0 {
            var lab: u64 = (&tbbase.klab[0 as usize]) as u64 + i * 40
            if tbmetrics.tlen(lab) == 0 {
                lab = (&tbbase.ktit[0 as usize]) as u64 + i * 40
            }
            bi_add(tbbase.kx[(i) as usize], tbbase.ky[(i) as usize], tbbase.kw[(i) as usize],
                tbbase.kh[(i) as usize], K_TASK + i, lab)
        }
        i = i + 1
    }
    var f: u64 = 0
    while f < tbbase.F_N {
        if tbbase.f_w[(f) as usize] != 0 {
            bi_add(tbbase.f_x[(f) as usize], tbbase.f_y[(f) as usize], tbbase.f_w[(f) as usize],
                tbbase.f_h[(f) as usize], tbbase.K_FIELD + f, tbstatus.field_name(f))
        }
        f = f + 1
    }
    var q: u64 = 0
    while q < tbbase.PB_MAX {
        if tbbase.pb_w[(q) as usize] != 0 {
            bi_add(tbbase.pb_x[(q) as usize], tbbase.pb_y[(q) as usize], tbbase.pb_w[(q) as usize],
                tbbase.pb_h[(q) as usize], K_PLUG + q, tbstatus.plug_text(q))
        }
        q = q + 1
    }

    var a: u64 = 0
    while a < tbbase.bi_n {
        tbbase.bi_o[(a) as usize] = a
        a = a + 1
    }
    a = 1
    while a < tbbase.bi_n {
        var b: u64 = a
        while b > 0 && bi_after(tbbase.bi_o[(b - 1) as usize], tbbase.bi_o[(b) as usize]) {
            let t: u64 = tbbase.bi_o[(b) as usize]
            tbbase.bi_o[(b) as usize] = tbbase.bi_o[(b - 1) as usize]
            tbbase.bi_o[(b - 1) as usize] = t
            b = b - 1
        }
        a = a + 1
    }
}

fn fuiapp_down() -> u64 {
    return 2
}
