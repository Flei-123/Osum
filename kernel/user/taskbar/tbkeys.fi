profile app

import capshint
import msg
import ulib
import libc.text
import fuiapp.svcnoti

export { step }

const POLL_GAP_MS: u64 = 200
const URGENCY_TOAST: u64 = 1

static mut s_seen: bool = false
static mut s_prev: u64 = 0
static mut k_caps_on: [u8; 12] = "kbd.caps.on\0"
static mut k_caps_off: [u8; 13] = "kbd.caps.off\0"
static mut k_num_on: [u8; 11] = "kbd.num.on\0"
static mut k_num_off: [u8; 12] = "kbd.num.off\0"

fn toast(key: u64) {
    let t: u64 = msg.get(key)
    let _r: u64 = svcnoti.noti_post(URGENCY_TOAST, t, text.length(t))
}

fn announce(flag: u64, now: u64, on_key: u64, off_key: u64) {
    if (s_prev & flag) == (now & flag) {
        return
    }
    if (now & flag) != 0 {
        toast(on_key)
    } else {
        toast(off_key)
    }
}

fn step() {
    if !capshint.poll(POLL_GAP_MS) {
        return
    }
    let now: u64 = capshint.bits()
    if s_seen {
        announce(capshint.BIT_CAPS, now, (&k_caps_on[0 as usize]) as u64, (&k_caps_off[0 as usize]) as u64)
        announce(capshint.BIT_NUM, now, (&k_num_on[0 as usize]) as u64, (&k_num_off[0 as usize]) as u64)
    }
    s_prev = now
    s_seen = true
}
