profile app

import fuiapp.hosthead
import fui.trayslots
import taskbar.tbbase
import taskbar.tbhover
import taskbar.tblayout
import taskbar.tbmetrics
import taskbar.tbstatus
import traypop
import uikit.uiscale

export { press_bar, step, RES_NONE, RES_CHANGED, RES_CLICK, RES_DONE, click_x, click_y }

const RES_NONE: u64 = 0
const RES_CHANGED: u64 = 1
const RES_CLICK: u64 = 2
const RES_DONE: u64 = 3

const SRC_BAR: u64 = 1
const SRC_POPUP: u64 = 2
const THRESHOLD: u64 = 6
const NO_TILE: u64 = 0xFFFFFFFFFFFFFFFF

static mut drag_slot: u64 = 0
static mut drag_src: u64 = 0
static mut x0: u64 = 0
static mut y0: u64 = 0
static mut cx: u64 = 0
static mut cy: u64 = 0
static mut btn_prev: u64 = 0
static mut s_begin: [u8; 22] = "traydrag: begin slot=\0"
static mut s_move: [u8; 21] = "traydrag: move slot=\0"
static mut s_to: [u8; 5] = " to=\0"
static mut s_idx: [u8; 6] = " idx=\0"
static mut s_end: [u8; 20] = "traydrag: end slot=\0"
static mut s_saved: [u8; 8] = " saved=\0"

fn click_x() -> u64 {
    return cx
}

fn click_y() -> u64 {
    return cy
}

fn say_slot(head: u64, slot: u64) {
    tbmetrics.say(head)
    tbmetrics.sayn(slot)
}

fn slot_under(x: u64, y: u64) -> u64 {
    var p: usize = 0
    while p < trayslots.SLOT_COUNT {
        let slot: u64 = trayslots.slot_at(p)
        let f: usize = tbmetrics.slot_field(slot) as usize
        if !trayslots.slot_is_hidden(slot) && tbbase.f_w[f] != 0
            && x >= tbbase.f_x[f] && x < tbbase.f_x[f] + tbbase.f_w[f]
            && y >= tbbase.f_y[f] && y < tbbase.f_y[f] + tbbase.f_h[f] {
            return slot
        }
        p = p + 1
    }
    return 0
}

fn begin(slot: u64, src: u64) {
    drag_slot = slot
    drag_src = src
    x0 = hosthead.mouse_x()
    y0 = hosthead.mouse_y()
    tbbase.tdrag = 1
    traypop.hold(1)
}

fn press_bar(x: u64, y: u64) -> bool {
    let slot: u64 = slot_under(x, y)
    if slot == 0 {
        return false
    }
    cx = x
    cy = y
    begin(slot, SRC_BAR)
    return true
}

fn distance(a: u64, b: u64) -> u64 {
    if a > b {
        return a - b
    }
    return b - a
}

fn bar_index(mx: u64, my: u64) -> usize {
    var n: usize = 0
    var p: usize = 0
    while p < trayslots.SLOT_COUNT {
        let s: u64 = trayslots.slot_at(p)
        if s != drag_slot && !trayslots.slot_is_hidden(s) {
            let f: usize = tbmetrics.slot_field(s) as usize
            if tbbase.f_w[f] != 0 {
                if tbbase.vertical != 0 {
                    if my > tbbase.bar_y + tbbase.f_y[f] + tbbase.f_h[f] / 2 {
                        return n
                    }
                } else if mx > tbbase.bar_x + tbbase.f_x[f] + tbbase.f_w[f] / 2 {
                    return n
                }
            }
            n = n + 1
        }
        p = p + 1
    }
    return n
}

fn apply_move(to_overflow: bool, idx: usize) -> u64 {
    if !trayslots.slot_move(drag_slot, to_overflow, idx) {
        return RES_NONE
    }
    say_slot((&s_move[0 as usize]) as u64, drag_slot)
    tbmetrics.say((&s_to[0 as usize]) as u64)
    if to_overflow {
        tbmetrics.sayn(1)
    } else {
        tbmetrics.sayn(0)
    }
    tbmetrics.say((&s_idx[0 as usize]) as u64)
    tbmetrics.sayn(idx as u64)
    tbmetrics.nl()
    tblayout.layout()
    traypop.refresh_tiles()
    return RES_CHANGED
}

fn open_popup_on_chevron(mx: u64, my: u64) {
    if tbbase.chv_w == 0 || traypop.is_open() {
        return
    }
    let ax: u64 = tbbase.bar_x + tbbase.chv_x
    let ay: u64 = tbbase.bar_y + tbbase.chv_y
    if mx >= ax && mx < ax + tbbase.chv_w && my >= ay && my < ay + tbbase.chv_h {
        traypop.toggle(ax, ay, tbbase.chv_w, tbbase.chv_h, tbbase.net_da, tbbase.net_state)
        traypop.hold(1)
    }
}

fn retarget(mx: u64, my: u64) -> u64 {
    if traypop.hit(mx, my) {
        return apply_move(true, traypop.overflow_index_at(mx, my, drag_slot))
    }
    if tbhover.inside_bar(mx, my) {
        return apply_move(false, bar_index(mx, my))
    }
    open_popup_on_chevron(mx, my)
    return RES_NONE
}

fn finish() -> u64 {
    var saved: u64 = 0
    if tbstatus.conf_write() {
        saved = 1
    }
    say_slot((&s_end[0 as usize]) as u64, drag_slot)
    tbmetrics.say((&s_saved[0 as usize]) as u64)
    tbmetrics.sayn(saved)
    tbmetrics.nl()
    tbbase.tdrag = 0
    drag_slot = 0
    traypop.hold(0)
    return RES_DONE
}

fn watch_popup_press(mx: u64, my: u64, btn: u64) {
    if tbbase.tdrag != 0 || !traypop.is_open() || (btn & 1) == 0 || (btn_prev & 1) != 0 {
        return
    }
    let t: u64 = traypop.tile_at(mx, my)
    if t == NO_TILE || traypop.tile_slot(t) == 0 {
        return
    }
    begin(traypop.tile_slot(t), SRC_POPUP)
}

fn step() -> u64 {
    let mx: u64 = hosthead.mouse_x()
    let my: u64 = hosthead.mouse_y()
    let btn: u64 = hosthead.mouse_btn()
    watch_popup_press(mx, my, btn)
    btn_prev = btn
    if tbbase.tdrag == 0 {
        return RES_NONE
    }
    let released: bool = (btn & 1) == 0
    if tbbase.tdrag == 1 {
        if released {
            tbbase.tdrag = 0
            traypop.hold(0)
            if drag_src == SRC_BAR {
                return RES_CLICK
            }
            return RES_NONE
        }
        if distance(mx, x0) < THRESHOLD * uiscale.ui_scale() && distance(my, y0) < THRESHOLD * uiscale.ui_scale() {
            return RES_NONE
        }
        tbbase.tdrag = 2
        traypop.suppress_click()
        say_slot((&s_begin[0 as usize]) as u64, drag_slot)
        tbmetrics.nl()
    }
    let res: u64 = retarget(mx, my)
    if released {
        let fin: u64 = finish()
        if res == RES_CHANGED {
            return RES_CHANGED
        }
        return fin
    }
    return res
}
