profile app

import fuiapp.apphost
import symvar
import taskbar.tblayout
import taskbar.tbmotion
import uikit.uiicon
import uikit.uiscale
import uitheme

export { paint_ghosts, paint_wait, draw_icon }

const MIN_GHOST_PX: u64 = 2
const WAIT_BAR_MIN_PX: u64 = 10
const WAIT_BAR_HEIGHT_PX: u64 = 3
const PM_FULL: u64 = 1000

fn paint_ghost(s: u64) {
    let sym: u64 = tblayout.sym_of(tbmotion.name_at(s))
    if sym == 0 || !uiicon.icon_vec(sym) {
        return
    }
    let size: u64 = tblayout.sym_w(sym, tbmotion.ghost_h(s)) * tbmotion.ghost_pm(s) / PM_FULL
    if size < MIN_GHOST_PX {
        return
    }
    let x: u64 = tbmotion.ghost_x(s) + (tbmotion.ghost_w(s) - size) / 2
    let y: u64 = tbmotion.ghost_y(s) + (tbmotion.ghost_h(s) - size) / 2
    let _d: bool = uiicon.icon_draw_fit(symvar.pick(sym, size), x, y, size)
}

fn paint_ghosts() {
    var s: u64 = 0
    while s < tbmotion.SLOTS {
        if tbmotion.kind_at(s) == tbmotion.K_GHOST {
            paint_ghost(s)
        }
        s = s + 1
    }
}

fn paint_wait(name: u64, x: u64, y: u64, w: u64, h: u64) {
    if !tbmotion.is_waiting(name) {
        return
    }
    let sc: u64 = uiscale.ui_scale()
    let min_w: u64 = WAIT_BAR_MIN_PX * sc
    var bar_w: u64 = min_w
    if w / 2 > min_w {
        bar_w = min_w + (w / 2 - min_w) * tbmotion.wait_phase(name) / PM_FULL
    }
    apphost.draw_bar(x + (w - bar_w) / 2, y + h - WAIT_BAR_HEIGHT_PX * sc, bar_w, WAIT_BAR_HEIGHT_PX * sc,
        uitheme.theme(uitheme.C_ACCENT))
}

fn centered(pos: u64, size: u64, scaled: u64) -> u64 {
    if scaled >= size {
        let grow: u64 = (scaled - size) / 2
        if grow > pos {
            return 0
        }
        return pos - grow
    }
    return pos + (size - scaled) / 2
}

fn lifted(top: u64, floor_y: u64) -> u64 {
    let lift: u64 = tbmotion.cur_lift()
    if top <= floor_y {
        return top
    }
    if lift > top - floor_y {
        return floor_y
    }
    return top - lift
}

fn draw_icon(sym: u64, size: u64, x: u64, y: u64, floor_y: u64) -> bool {
    let pm: u64 = tbmotion.cur_scale()
    if pm == PM_FULL && tbmotion.cur_lift() == 0 {
        return uiicon.icon_draw_fit(symvar.pick(sym, size), x, y, size)
    }
    var scaled: u64 = size * pm / PM_FULL
    if scaled < 1 {
        scaled = 1
    }
    return uiicon.icon_draw_fit(symvar.pick(sym, scaled), centered(x, size, scaled),
        lifted(centered(y, size, scaled), floor_y), scaled)
}
