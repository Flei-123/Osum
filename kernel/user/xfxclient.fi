profile kernel

import ulib
import actcli
import xfxio
import libc.clockapi

export { start, stop }

const REQUEST_TICKS: u64 = 500
const POLL_MS: u64 = 200
const MAX_POLLS: u64 = 75
const RESULT_BUF: u64 = 256
const ERR_NO_SERVICE: u64 = 3
const ERR_FAILED: u64 = 1

static mut P_LAST: [u8; 14] = "/run/xfx.last\0"

fn call(action: u64) -> u64 {
    var e_nobus: [u8; 38] = "xfx: the start service is not running\0"
    var e_ask: [u8; 31] = "xfx: the bus asked for consent\0"
    if !actcli.open() {
        xfxio.msg((&e_nobus[0 as usize]) as u64)
        return ERR_NO_SERVICE
    }
    actcli.req(action)
    let status: u64 = actcli.send(REQUEST_TICKS)
    if status == actcli.R_NOBUS {
        xfxio.msg((&e_nobus[0 as usize]) as u64)
        return ERR_NO_SERVICE
    }
    if status == actcli.R_CONFIRM {
        xfxio.msg((&e_ask[0 as usize]) as u64)
        return ERR_FAILED
    }
    if status != actcli.R_OK {
        ulib.say(actcli.reply())
        return ERR_FAILED
    }
    return 0
}

fn wait_done() -> u64 {
    var e_slow: [u8; 34] = "xfx: start did not finish in time\0"
    var a_result: [u8; 16] = "call xfx.result\0"
    var k_busy: [u8; 5] = "busy\0"
    var k_rc: [u8; 3] = "rc\0"
    var value: [u8; 16] = [0 as u8; 16]
    var polls: u64 = 0
    while polls < MAX_POLLS {
        if call((&a_result[0 as usize]) as u64) != 0 {
            return ERR_FAILED
        }
        actcli.field((&k_busy[0 as usize]) as u64, (&value[0 as usize]) as u64, 16)
        if ulib.to_num((&value[0 as usize]) as u64) == 0 {
            actcli.field((&k_rc[0 as usize]) as u64, (&value[0 as usize]) as u64, 16)
            return ulib.to_num((&value[0 as usize]) as u64)
        }
        clockapi.sleep_ms(POLL_MS)
        polls = polls + 1
    }
    xfxio.msg((&e_slow[0 as usize]) as u64)
    return ERR_FAILED
}

fn show_last() {
    var text: [u8; 256] = [0 as u8; 256]
    if xfxio.read_text((&P_LAST[0 as usize]) as u64, (&text[0 as usize]) as u64, RESULT_BUF) != ulib.EOF {
        ulib.say((&text[0 as usize]) as u64)
    }
}

fn start() -> u64 {
    var a_start: [u8; 15] = "call xfx.start\0"
    let rc: u64 = call((&a_start[0 as usize]) as u64)
    if rc != 0 {
        return 1
    }
    let code: u64 = wait_done()
    show_last()
    if code != 0 {
        return 1
    }
    return 0
}

fn stop() -> u64 {
    var a_stop: [u8; 14] = "call xfx.stop\0"
    var m_stop: [u8; 13] = "xfx: stopped\0"
    if call((&a_stop[0 as usize]) as u64) != 0 {
        return 1
    }
    xfxio.msg((&m_stop[0 as usize]) as u64)
    return 0
}
