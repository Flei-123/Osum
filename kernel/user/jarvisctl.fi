// ====================================================================
// WOFUER
// ====================================================================

profile kernel

import ulib
import libc.kcall
import libc.errno
import libc.io
import libc.stdio
import libc.text
import pairshow
import ctlswap
import ctldev
import libc.octets

export { u_start }

static mut FILE_PATH_RIGHTS: [u8; 29] = "/etc/jarvis/permissions.conf\0"
static mut FILE_PATH_KEY: [u8; 23] = "/etc/jarvis/device.key\0"
static mut FILE_PATH_LOG: [u8; 21] = "/var/log/jarvisd.log\0"
static mut FILE_PATH_PAIRING: [u8; 20] = "/var/jarvis/pairing\0"
static mut FILE_PATH_PAIRYES: [u8; 23] = "/var/jarvis/pairing-ok\0"
static mut FILE_PATH_CERT: [u8; 30] = "/var/jarvis/screenshot-permit\0"
static mut FILE_PATH_VARJ: [u8; 12] = "/var/jarvis\0"

static mut buffer: [u8; 8192] = [0 as u8; 8192]

fn show(t: u64) {
    ulib.say(t)
}

fn show_line(t: u64) {
    ulib.say(t)
    ulib.nl()
}

fn file_show(file_path: u64) -> u64 {
    let fd: u64 = io.open(file_path, 0)
    if errno.failed(fd) {
        return fd
    }
    var sum: u64 = 0
    while true {
        let n: u64 = io.read(fd, (&buffer[0 as usize]) as u64, 8192)
        if errno.failed(n) || n == 0 {
            break
        }
        ulib.put((&buffer[0 as usize]) as u64, n)
        sum = sum + n
    }
    io.close(fd)
    return sum
}

fn tail_show(file_path: u64, wieviel: u64) -> u64 {
    let big: u64 = io.size_of(file_path)
    if errno.failed(big) {
        return big
    }
    var von: u64 = 0
    if big > 8192 {
        von = big - 8192
    }
    let fd: u64 = io.open(file_path, 0)
    if errno.failed(fd) {
        return fd
    }
    io.seek(fd, von, kcall.SEEK_SET)
    let n: u64 = io.read_full(fd, (&buffer[0 as usize]) as u64, 8192)
    io.close(fd)
    if errno.failed(n) || n == 0 {
        return 0
    }
    var i: u64 = n
    var lines: u64 = 0
    var start: u64 = 0
    while i > 0 {
        i = i - 1
        if *((((&buffer[0 as usize]) as u64) + i) as *mut u8) == 10 as u8 {
            lines = lines + 1
            if lines > wieviel {
                start = i + 1
                break
            }
        }
    }
    if start == 0 && von > 0 {
        var k: u64 = 0
        while k < n {
            if *((((&buffer[0 as usize]) as u64) + k) as *mut u8) == 10 as u8 {
                start = k + 1
                break
            }
            k = k + 1
        }
    }
    ulib.put(((&buffer[0 as usize]) as u64) + start, n - start)
    return n - start
}

static mut cbuf: [u8; 8192] = [0 as u8; 8192]
static mut cval: [u8; 128] = [0 as u8; 128]
static mut conf_len: u64 = 0

fn helper_pid() -> u64 {
    var i: u64 = 0
    while i < 128 {
        let st: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_STATE, 0)
        if !ulib.bad(st) && st != 0 && st != 5 {
            if ulib.sys(ulib.SYS_PSTAT, i, ulib.P_NAME0, 0) == 0x006473697672616a {
                return ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PID, 0)
            }
        }
        i = i + 1
    }
    return 0
}

fn conf_load() {
    conf_len = 0
    let fd: u64 = io.open((&FILE_PATH_RIGHTS[0 as usize]) as u64, 0)
    if errno.failed(fd) {
        return
    }
    let base: u64 = (&cbuf[0 as usize]) as u64
    while conf_len < 8000 {
        let n: u64 = io.read(fd, base + conf_len, 8000 - conf_len)
        if errno.failed(n) || n == 0 {
            break
        }
        conf_len = conf_len + n
    }
    io.close(fd)
}

fn conf_get(key: u64) -> bool {
    var i: u64 = 0
    while i < conf_len {
        while i < conf_len && (cbuf[i as usize] == 32 as u8 || cbuf[i as usize] == 9 as u8) {
            i = i + 1
        }
        var k: u64 = 0
        let ls: u64 = i
        while *((key + k) as *mut u8) != 0 as u8 && i < conf_len && cbuf[i as usize] == *((key + k) as *mut u8) {
            i = i + 1
            k = k + 1
        }
        var hit: bool = false
        if *((key + k) as *mut u8) == 0 as u8 && ls < conf_len {
            var j: u64 = i
            while j < conf_len && (cbuf[j as usize] == 32 as u8 || cbuf[j as usize] == 9 as u8) {
                j = j + 1
            }
            if j < conf_len && cbuf[j as usize] == 61 as u8 {
                j = j + 1
                while j < conf_len && (cbuf[j as usize] == 32 as u8 || cbuf[j as usize] == 9 as u8) {
                    j = j + 1
                }
                var n: u64 = 0
                while j < conf_len && cbuf[j as usize] != 10 as u8 && cbuf[j as usize] != 13 as u8 && n < 120 {
                    cval[n as usize] = cbuf[j as usize]
                    n = n + 1
                    j = j + 1
                }
                while n > 0 && (cval[(n - 1) as usize] == 32 as u8 || cval[(n - 1) as usize] == 9 as u8) {
                    n = n - 1
                }
                cval[n as usize] = 0 as u8
                hit = true
            }
        }
        if hit {
            return true
        }
        while i < conf_len && cbuf[i as usize] != 10 as u8 {
            i = i + 1
        }
        i = i + 1
    }
    return false
}

fn show_right(label: u64, key: u64) {
    ulib.say(label)
    if conf_get(key) {
        ulib.say((&cval[0 as usize]) as u64)
    } else {
        var lt1: [u8; 3] = "no\0"
        ulib.say((&lt1[0 as usize]) as u64)
    }
}

fn show_contact() {
    var lt2: [u8; 14] = "Contact      \0"
    ulib.say((&lt2[0 as usize]) as u64)
    var name: [u8; 18] = "/var/jarvis/alive\0"
    let fd: u64 = io.open((&name[0 as usize]) as u64, 0)
    if errno.failed(fd) {
        var lt3: [u8; 56] = "never since boot (no good exchange with the server yet)\0"
        ulib.say((&lt3[0 as usize]) as u64)
        ulib.nl()
        return
    }
    var nb: [u8; 24] = [0 as u8; 24]
    let n: u64 = io.read(fd, (&nb[0 as usize]) as u64, 20)
    io.close(fd)
    if errno.failed(n) || n == 0 {
        var lt4: [u8; 8] = "unknown\0"
        ulib.say((&lt4[0 as usize]) as u64)
        ulib.nl()
        return
    }
    nb[n as usize] = 0 as u8
    let last: u64 = ulib.to_num((&nb[0 as usize]) as u64)
    let up: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_UPTIME, 0, 0)
    var lt5: [u8; 31] = "signed in, last good exchange \0"
    ulib.say((&lt5[0 as usize]) as u64)
    if up >= last {
        ulib.sayu((up - last) / 1000)
    } else {
        ulib.sayu(0)
    }
    var lt6: [u8; 7] = " s ago\0"
    ulib.say((&lt6[0 as usize]) as u64)
    ulib.nl()
}

fn show_helper() {
    var lt14: [u8; 7] = "server\0"
    conf_load()
    var lt7: [u8; 14] = "Helper       \0"
    ulib.say((&lt7[0 as usize]) as u64)
    let pid: u64 = helper_pid()
    if pid == 0 {
        var lt8: [u8; 70] = "NOT RUNNING -- type `jarvisd` in the terminal, it prints why it stops\0"
        ulib.say((&lt8[0 as usize]) as u64)
        ulib.nl()
    } else {
        var lt9: [u8; 14] = "running, pid \0"
        ulib.say((&lt9[0 as usize]) as u64)
        ulib.sayu(pid)
        ulib.nl()
    }
    var lt10: [u8; 14] = "Server       \0"
    ulib.say((&lt10[0 as usize]) as u64)
    var lt11: [u8; 11] = "servername\0"
    if conf_get((&lt11[0 as usize]) as u64) {
        ulib.say((&cval[0 as usize]) as u64)
        var lt12: [u8; 10] = "transport\0"
        if conf_get((&lt12[0 as usize]) as u64) {
            var lt13: [u8; 6] = " via \0"
            ulib.say((&lt13[0 as usize]) as u64)
            ulib.say((&cval[0 as usize]) as u64)
        }
        ulib.nl()
    } else if conf_get((&lt14[0 as usize]) as u64) {
        ulib.say((&cval[0 as usize]) as u64)
        ulib.nl()
    } else {
        var lt15: [u8; 101] = "NOT SET -- /etc/jarvis/permissions.conf needs `transport = https` + `servername = store.fleitec.com`\0"
        ulib.say((&lt15[0 as usize]) as u64)
        ulib.nl()
    }
    var lt16: [u8; 23] = "Rights       commands \0"
    var lt17: [u8; 9] = "commands\0"
    show_right((&lt16[0 as usize]) as u64, (&lt17[0 as usize]) as u64)
    var lt18: [u8; 14] = ", screenshot \0"
    var lt19: [u8; 11] = "screenshot\0"
    show_right((&lt18[0 as usize]) as u64, (&lt19[0 as usize]) as u64)
    var lt20: [u8; 11] = ", sysinfo \0"
    var lt21: [u8; 8] = "sysinfo\0"
    show_right((&lt20[0 as usize]) as u64, (&lt21[0 as usize]) as u64)
    var lt22: [u8; 9] = ", input \0"
    var lt23: [u8; 6] = "input\0"
    show_right((&lt22[0 as usize]) as u64, (&lt23[0 as usize]) as u64)
    ulib.nl()
    show_contact()
}

fn do_state() -> u64 {
    show_helper()
    var t1: [u8; 44] = "Permissions  /etc/jarvis/permissions.conf: \0"
    var t_da: [u8; 8] = "present\0"
    var t_gone: [u8; 8] = "MISSING\0"
    show((&t1[0 as usize]) as u64)
    let g: u64 = io.size_of((&FILE_PATH_RIGHTS[0 as usize]) as u64)
    if errno.failed(g) {
        show_line((&t_gone[0 as usize]) as u64)
    } else {
        show((&t_da[0 as usize]) as u64)
        var kl: [u8; 3] = " (\0"
        show((&kl[0 as usize]) as u64)
        ulib.sayu(g)
        var kr: [u8; 10] = " bytes)\0\0\0"
        show_line((&kr[0 as usize]) as u64)
    }

    var t2: [u8; 38] = "Key          /etc/jarvis/device.key: \0"
    show((&t2[0 as usize]) as u64)
    let m: u64 = io.stat_mode((&FILE_PATH_KEY[0 as usize]) as u64)
    if errno.failed(m) {
        var t: [u8; 34] = "none yet (`jsig init` creates it)\0"
        show_line((&t[0 as usize]) as u64)
    } else {
        var t: [u8; 15] = "present, mode \0"
        show((&t[0 as usize]) as u64)
        let r: u64 = m & 511
        ulib.sayu((r >> 6) & 7)
        ulib.sayu((r >> 3) & 7)
        ulib.sayu(r & 7)
        if (r & 63) != 0 {
            var w: [u8; 34] = "  -- TOO OPEN, others can read it\0"
            show((&w[0 as usize]) as u64)
        }
        ulib.nl()
    }

    var t3: [u8; 36] = "Log          /var/log/jarvisd.log: \0"
    show((&t3[0 as usize]) as u64)
    let lg: u64 = io.size_of((&FILE_PATH_LOG[0 as usize]) as u64)
    if errno.failed(lg) {
        var t: [u8; 6] = "empty\0"
        show_line((&t[0 as usize]) as u64)
    } else {
        ulib.sayu(lg)
        var t: [u8; 7] = " bytes\0"
        show_line((&t[0 as usize]) as u64)
    }

    var t4: [u8; 45] = "Screenshot   /var/jarvis/screenshot-permit: \0"
    show((&t4[0 as usize]) as u64)
    let sg: u64 = io.size_of((&FILE_PATH_CERT[0 as usize]) as u64)
    if errno.failed(sg) {
        var t: [u8; 10] = "none open\0"
        show_line((&t[0 as usize]) as u64)
    } else {
        var t: [u8; 12] = "ONE IS OPEN\0"
        show_line((&t[0 as usize]) as u64)
    }

    ctldev.dev_status()

    var t5: [u8; 35] = "Pairing      /var/jarvis/pairing: \0"
    show((&t5[0 as usize]) as u64)
    if pairshow.load() == pairshow.MODE_WAITING {
        var tw1: [u8; 49] = "WAITING -- enter this code in the JARVIS web UI:\0"
        show_line((&tw1[0 as usize]) as u64)
        ulib.nl()
        pairshow.show_big()
        ulib.nl()
        var tw2: [u8; 15] = "  Enter it at \0"
        show((&tw2[0 as usize]) as u64)
        conf_load()
        var tw3: [u8; 11] = "servername\0"
        if conf_get((&tw3[0 as usize]) as u64) {
            show((&cval[0 as usize]) as u64)
        } else {
            var tw4: [u8; 18] = "the JARVIS server\0"
            show((&tw4[0 as usize]) as u64)
        }
        var tw5: [u8; 25] = " > Devices.  Expires in \0"
        show((&tw5[0 as usize]) as u64)
        ulib.sayu(pairshow.seconds_left())
        var tw6: [u8; 3] = " s\0"
        show_line((&tw6[0 as usize]) as u64)
        return 0
    }
    let kg: u64 = io.size_of((&FILE_PATH_PAIRING[0 as usize]) as u64)
    if errno.failed(kg) {
        var t: [u8; 13] = "none pending\0"
        show_line((&t[0 as usize]) as u64)
    } else {
        // Show the pending code itself: the helper runs in the
        // background (desktop autostart), its console is not visible.
        var t: [u8; 32] = "WAITING -- run: jarvisctl pair \0"
        show((&t[0 as usize]) as u64)
        let fd: u64 = io.open((&FILE_PATH_PAIRING[0 as usize]) as u64, 0)
        var len: u64 = 0
        if !errno.failed(fd) {
            let n: u64 = io.read(fd, (&buffer[0 as usize]) as u64, 256)
            io.close(fd)
            if !errno.failed(n) {
                len = n
            }
        }
        while len > 0 && *((((&buffer[0 as usize]) as u64) + len - 1) as *mut u8)
                <= 32 as u8 {
            len = len - 1
        }
        __mmio_write8((((&buffer[0 as usize]) as u64) + len) as *mut u8, 0 as u8)
        show_line((&buffer[0 as usize]) as u64)
    }
    return 0
}

static mut HEXBUF: [u8; 520] = [0 as u8; 520]

fn hex_digit(v: u64) -> u8 {
    if v < 10 {
        return (48 + v) as u8
    }
    return (87 + v) as u8
}

fn hex_of(src: u64) -> u64 {
    let n: u64 = text.length(src)
    var i: u64 = 0
    while i < n && i < 255 {
        let c: u64 = (*((src + i) as *mut u8)) as u64
        __mmio_write8((((&HEXBUF[0 as usize]) as u64) + i * 2) as *mut u8, hex_digit((c >> 4) & 15))
        __mmio_write8((((&HEXBUF[0 as usize]) as u64) + i * 2 + 1) as *mut u8, hex_digit(c & 15))
        i = i + 1
    }
    __mmio_write8((((&HEXBUF[0 as usize]) as u64) + i * 2) as *mut u8, 0 as u8)
    return (&HEXBUF[0 as usize]) as u64
}

fn code_matches(pending: u64, typed: u64) -> bool {
    if ulib.streq(pending, typed) {
        return true
    }
    if ulib.streq(pending, hex_of(typed)) {
        return true
    }
    return ulib.streq(typed, hex_of(pending))
}

fn do_pair(code: u64) -> u64 {
    let fd: u64 = io.open((&FILE_PATH_PAIRING[0 as usize]) as u64, 0)
    if errno.failed(fd) {
        var t: [u8; 52] = "No pairing request pending -- nobody asked for one.\0"
        ulib.esay_line((&t[0 as usize]) as u64, 0)
        return 1
    }
    let n: u64 = io.read(fd, (&buffer[0 as usize]) as u64, 256)
    io.close(fd)
    if errno.failed(n) || n == 0 {
        return 1
    }
    var len: u64 = n
    while len > 0 && *((((&buffer[0 as usize]) as u64) + len - 1) as *mut u8)
            <= 32 as u8 {
        len = len - 1
    }
    __mmio_write8((((&buffer[0 as usize]) as u64) + len) as *mut u8, 0 as u8)
    if !code_matches((&buffer[0 as usize]) as u64, code) {
        var t: [u8; 53] = "The code does not match the one the helper received.\0"
        ulib.esay_line((&t[0 as usize]) as u64, 0)
        var t2: [u8; 15] = "It waits for: \0"
        ulib.eput((&t2[0 as usize]) as u64)
        ulib.esay_line((&buffer[0 as usize]) as u64, 0)
        return 1
    }
    io.make_dir((&FILE_PATH_VARJ[0 as usize]) as u64)
    let out: u64 = io.create((&FILE_PATH_PAIRYES[0 as usize]) as u64)
    if errno.failed(out) {
        return 1
    }
    io.write_all(out, (&buffer[0 as usize]) as u64, len)
    io.close(out)
    kcall.sys2(kcall.SYS_CHMOD, (&FILE_PATH_PAIRYES[0 as usize]) as u64, 384)
    var t: [u8; 19] = "Pairing confirmed.\0"
    show_line((&t[0 as usize]) as u64)
    return 0
}

fn do_cert(sec: u64) -> u64 {
    io.make_dir((&FILE_PATH_VARJ[0 as usize]) as u64)
    let now: u64 = io.now_sec()
    let deadline: u64 = now + sec
    var num: [u8; 32] = [0 as u8; 32]
    let n: u64 = text.digits(deadline, (&num[0 as usize]) as u64, false)
    __mmio_write8((((&num[0 as usize]) as u64) + n) as *mut u8, 10 as u8)
    let out: u64 = io.create((&FILE_PATH_CERT[0 as usize]) as u64)
    if errno.failed(out) {
        var t: [u8; 26] = "Cannot create the permit.\0"
        ulib.esay_line((&t[0 as usize]) as u64, 0)
        return 1
    }
    io.write_all(out, (&num[0 as usize]) as u64, n + 1)
    io.close(out)
    kcall.sys2(kcall.SYS_CHMOD, (&FILE_PATH_CERT[0 as usize]) as u64, 384)
    var t: [u8; 29] = "One screenshot allowed, for \0"
    show((&t[0 as usize]) as u64)
    ulib.sayu(sec)
    var t2: [u8; 10] = " seconds.\0"
    show_line((&t2[0 as usize]) as u64)
    return 0
}

const S_TIPP: u64 = 1843
const TI_INFO: u64 = 0
const TI_ARM: u64 = 1
const TI_DROP: u64 = 2
const TI_KEY: u64 = 3
const TI_MOVE: u64 = 4
const TI_LOCK: u64 = 7

const TQ_ARMED: u64 = 0
const TQ_ARMPID: u64 = 1
const TQ_TOTAL: u64 = 3
const TQ_DENIED: u64 = 4
const TQ_ARMS: u64 = 5
const TQ_MAX: u64 = 7
const TQ_RECENT: u64 = 8
const TQ_LOCKED: u64 = 9

fn do_input(args: u64, argc: u64) -> u64 {
    let da: u64 = ulib.sys(S_TIPP, TI_INFO, TQ_ARMED, 0)
    if errno.is_error(da) {
        var t0: [u8; 64] = "This kernel has no bridge (built without the bridge) or no GUI.\0"
        show_line((&t0[0 as usize]) as u64)
        return 1
    }
    if argc < 3 {
        var t1: [u8; 29] = "Remote input:               \0"
        show((&t1[0 as usize]) as u64)
        if da != 0 {
            var tj: [u8; 37] = "YES -- someone is typing right now.\n\0"
            show((&tj[0 as usize]) as u64)
        } else {
            var tn: [u8; 23] = "no, nobody is typing.\n\0"
            show((&tn[0 as usize]) as u64)
        }
        var tl: [u8; 21] = "  Emergency stop:   \0"
        show((&tl[0 as usize]) as u64)
        if ulib.sys(S_TIPP, TI_INFO, TQ_LOCKED, 0) == 1 {
            var tl1: [u8; 9] = "ENGAGED\n\0"
            show((&tl1[0 as usize]) as u64)
        } else {
            var tl0: [u8; 5] = "off\n\0"
            show((&tl0[0 as usize]) as u64)
        }
        var tr: [u8; 21] = "  Sign on screen:   \0"
        show((&tr[0 as usize]) as u64)
        if ulib.sys(S_TIPP, TI_INFO, TQ_RECENT, 0) == 1 {
            var tr1: [u8; 5] = "YES\n\0"
            show((&tr1[0 as usize]) as u64)
        } else {
            var tr0: [u8; 4] = "no\n\0"
            show((&tr0[0 as usize]) as u64)
        }
        var t2: [u8; 21] = "  Keystrokes total: \0"
        show((&t2[0 as usize]) as u64)
        ulib.sayu(ulib.sys(S_TIPP, TI_INFO, TQ_TOTAL, 0))
        ulib.nl()
        var t3: [u8; 21] = "  Permits so far:   \0"
        show((&t3[0 as usize]) as u64)
        ulib.sayu(ulib.sys(S_TIPP, TI_INFO, TQ_ARMS, 0))
        ulib.nl()
        var t4: [u8; 21] = "  Rejected:         \0"
        show((&t4[0 as usize]) as u64)
        ulib.sayu(ulib.sys(S_TIPP, TI_INFO, TQ_DENIED, 0))
        ulib.nl()
        var t5: [u8; 21] = "  Max per permit:   \0"
        show((&t5[0 as usize]) as u64)
        ulib.sayu(ulib.sys(S_TIPP, TI_INFO, TQ_MAX, 0))
        ulib.nl()
        return 0
    }
    let was: u64 = ulib.arg_at(args, 2)
    var w_gone: [u8; 7] = "revoke\0"
    var w_off: [u8; 4] = "off\0"
    var w_on: [u8; 3] = "on\0"
    var w_key: [u8; 4] = "key\0"
    var w_mouse: [u8; 6] = "mouse\0"
    // EMERGENCY STOP. `input off` engages it in the kernel (immediately:
    // an open permit is taken away, no new one is issued, nothing is
    // injected -- whatever permissions.conf says). `input on` releases
    // it and is root only; the kernel decides. Win+Esc does the same as
    // `off` from the keyboard.
    if ulib.streq(was, (&w_off[0 as usize]) as u64) {
        ulib.sys(S_TIPP, TI_LOCK, 1, 0)
        var toff: [u8; 33] = "Remote input: emergency stop ON.\0"
        show_line((&toff[0 as usize]) as u64)
        return 0
    }
    if ulib.streq(was, (&w_on[0 as usize]) as u64) {
        let rl: u64 = ulib.sys(S_TIPP, TI_LOCK, 0, 0)
        if errno.is_error(rl) {
            var tone: [u8; 36] = "Only root may release the stop.\0\0\0\0\0"
            ulib.esay_line((&tone[0 as usize]) as u64, 0)
            return 1
        }
        var ton: [u8; 35] = "Remote input: emergency stop off.\0\0"
        show_line((&ton[0 as usize]) as u64)
        return 0
    }
    if ulib.streq(was, (&w_gone[0 as usize]) as u64) {
        let r: u64 = ulib.sys(S_TIPP, TI_DROP, 0, 0)
        if errno.is_error(r) {
            var te: [u8; 39] = "The permit belongs to another process.\0"
            ulib.esay_line((&te[0 as usize]) as u64, 0)
            return 1
        }
        var tw: [u8; 22] = "Input permit revoked.\0"
        show_line((&tw[0 as usize]) as u64)
        return 0
    }
    let sch: u64 = ulib.sys(S_TIPP, TI_ARM, 0, 0)
    if errno.is_error(sch) {
        var te2: [u8; 49] = "No permit: only root or the taskbar may do that.\0"
        ulib.esay_line((&te2[0 as usize]) as u64, 0)
        return 1
    }
    var a: u64 = 0
    var b: u64 = 0
    if argc > 3 {
        a = ulib.to_num(ulib.arg_at(args, 3))
    }
    if argc > 4 {
        b = ulib.to_num(ulib.arg_at(args, 4))
    }
    var r2: u64 = 0
    if ulib.streq(was, (&w_key[0 as usize]) as u64) {
        r2 = ulib.sys(S_TIPP, TI_KEY, a, b)
    } else if ulib.streq(was, (&w_mouse[0 as usize]) as u64) {
        r2 = ulib.sys(S_TIPP, TI_MOVE, a, b)
    } else {
        ulib.sys(S_TIPP, TI_DROP, 0, 0)
        var tu: [u8; 47] = "usage: jarvisctl input key|mouse|revoke|off|on\0"
        ulib.esay_line((&tu[0 as usize]) as u64, 0)
        return 2
    }
    ulib.sys(S_TIPP, TI_DROP, 0, 0)
    if errno.is_error(r2) {
        var te3: [u8; 31] = "The kernel rejected the input.\0"
        ulib.esay_line((&te3[0 as usize]) as u64, 0)
        return 1
    }
    var tg: [u8; 9] = "injected\0"
    show_line((&tg[0 as usize]) as u64)
    return 0
}

// ====================================================================
// info: EVERYTHING A REMOTE LOOK NEEDS, IN ONE CALL
// ====================================================================
//
// The bridge answers one command of at most six words per request, so a
// full picture used to cost seven round trips (uname, date, dhcp, cat
// /proc/usb ...). `jarvisctl info` prints "key: value" lines, one fact
// per line, every line starts with its key:
//
//   version: <the /proc/version line>      build: <git hash>     image: <image id>
//   clock: YYYY-MM-DD hh:mm:ss tz=<min> rule=<n>     uptime: <ms> ms
//   net: <line of /etc/network.conf>       (or "net: none")
//   usb: controllers=N devices=M           usb: <line of /proc/usb>
//
// Nothing here is invented: a missing source prints "<key>: none".

fn rd_all(file_path: u64) -> u64 {
    let base: u64 = (&buffer[0 as usize]) as u64
    let fd: u64 = io.open(file_path, 0)
    if errno.failed(fd) {
        *(base as *mut u8) = 0 as u8
        return 0
    }
    var total: u64 = 0
    while total < 4000 {
        let n: u64 = io.read(fd, base + total, 4000 - total)
        if errno.failed(n) || n == 0 {
            break
        }
        total = total + n
    }
    io.close(fd)
    *((base + total) as *mut u8) = 0 as u8
    return total
}

// Does the text at `p` (n bytes left) start with the NUL terminated word `w`?
fn starts_with(p: u64, n: u64, w: u64) -> bool {
    var i: u64 = 0
    while octets.ld8(w, i) != 0 {
        if i >= n || octets.ld8(p, i) != octets.ld8(w, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// Prints every non empty line of the buffer as "<key>: <line>".
fn info_lines(key: u64, buf: u64, n: u64) {
    var s_col: [u8; 3] = ": \0"
    var at: u64 = 0
    while at < n {
        var e: u64 = at
        while e < n && octets.ld8(buf, e) != 10 {
            e = e + 1
        }
        if e > at {
            ulib.say(key)
            ulib.say((&s_col[0 as usize]) as u64)
            ulib.put(buf + at, e - at)
            ulib.nl()
        }
        at = e + 1
    }
}

// Prints "<key>: <token>" for the token right behind " <word> " in the buffer.
fn info_token(key: u64, buf: u64, n: u64, word: u64) {
    var s_col: [u8; 3] = ": \0"
    var sp: [u8; 2] = " \0"
    var i: u64 = 0
    var found: bool = false
    while i < n && !found {
        if octets.ld8(buf, i) == 32 && starts_with(buf + i + 1, n - i - 1, word)
            && octets.ld8(buf, i + 1 + text.length(word)) == 32 {
            found = true
            var st: u64 = i + 2 + text.length(word)
            var e: u64 = st
            while e < n && octets.ld8(buf, e) != 32 && octets.ld8(buf, e) != 10 {
                e = e + 1
            }
            ulib.say(key)
            ulib.say((&s_col[0 as usize]) as u64)
            ulib.put(buf + st, e - st)
            ulib.nl()
        }
        i = i + 1
    }
    if !found {
        var none: [u8; 7] = "none\0\0\0"
        ulib.say(key)
        ulib.say((&s_col[0 as usize]) as u64)
        ulib.say((&none[0 as usize]) as u64)
        ulib.nl()
    }
}

fn two_digits(v: u64) {
    var s_zero: [u8; 2] = "0\0"
    if v < 10 {
        ulib.say((&s_zero[0 as usize]) as u64)
    }
    ulib.sayu(v)
}

fn do_info() -> u64 {
    var p_ver: [u8; 14] = "/proc/version\0"
    var p_usb: [u8; 10] = "/proc/usb\0"
    var p_net: [u8; 18] = "/etc/network.conf\0"
    var k_ver: [u8; 8] = "version\0"
    var k_build: [u8; 6] = "build\0"
    var k_image: [u8; 6] = "image\0"
    var k_net: [u8; 4] = "net\0"
    var k_usb: [u8; 4] = "usb\0"
    var w_build: [u8; 6] = "build\0"
    var w_image: [u8; 6] = "image\0"
    var w_ctl: [u8; 11] = "controller\0"
    var w_ctlx: [u8; 16] = "controller xhci\0"
    var s_clock: [u8; 8] = "clock: \0"
    var s_tz: [u8; 5] = " tz=\0"
    var s_rule: [u8; 7] = " rule=\0"
    var s_up: [u8; 9] = "uptime: \0"
    var s_ms: [u8; 4] = " ms\0"
    var s_none: [u8; 7] = "none\0\0\0"
    var s_ctls: [u8; 20] = "usb: controllers=\0\0\0"
    var s_devs: [u8; 10] = " devices=\0"
    var s_dash: [u8; 2] = "-\0"
    var s_colon: [u8; 2] = ":\0"
    var s_sp: [u8; 2] = " \0"
    var s_colsp: [u8; 3] = ": \0"
    let base: u64 = (&buffer[0 as usize]) as u64

    var n: u64 = rd_all((&p_ver[0 as usize]) as u64)
    if n == 0 {
        ulib.say((&k_ver[0 as usize]) as u64)
        ulib.say((&s_colsp[0 as usize]) as u64)
        ulib.say((&s_none[0 as usize]) as u64)
        ulib.nl()
    } else {
        info_lines((&k_ver[0 as usize]) as u64, base, n)
        info_token((&k_build[0 as usize]) as u64, base, n, (&w_build[0 as usize]) as u64)
        info_token((&k_image[0 as usize]) as u64, base, n, (&w_image[0 as usize]) as u64)
    }

    ulib.say((&s_clock[0 as usize]) as u64)
    ulib.sayu(ulib.sys(ulib.SYS_SYSINFO, ulib.I_YEAR, 0, 0))
    ulib.say((&s_dash[0 as usize]) as u64)
    two_digits(ulib.sys(ulib.SYS_SYSINFO, ulib.I_MONTH, 0, 0))
    ulib.say((&s_dash[0 as usize]) as u64)
    two_digits(ulib.sys(ulib.SYS_SYSINFO, ulib.I_DAY, 0, 0))
    ulib.say((&s_sp[0 as usize]) as u64)
    two_digits(ulib.sys(ulib.SYS_SYSINFO, ulib.I_HOUR, 0, 0))
    ulib.say((&s_colon[0 as usize]) as u64)
    two_digits(ulib.sys(ulib.SYS_SYSINFO, ulib.I_MIN, 0, 0))
    ulib.say((&s_colon[0 as usize]) as u64)
    two_digits(ulib.sys(ulib.SYS_SYSINFO, ulib.I_SEC, 0, 0))
    ulib.say((&s_tz[0 as usize]) as u64)
    ulib.sayn(ulib.sys(ulib.SYS_SYSINFO, ulib.I_TZMIN, 0, 0))
    ulib.say((&s_rule[0 as usize]) as u64)
    ulib.sayu(ulib.sys(ulib.SYS_SYSINFO, ulib.I_TZRULE, 0, 0))
    ulib.nl()

    ulib.say((&s_up[0 as usize]) as u64)
    ulib.sayu(ulib.sys(ulib.SYS_SYSINFO, ulib.I_UPTIME, 0, 0))
    ulib.say((&s_ms[0 as usize]) as u64)
    ulib.nl()

    n = rd_all((&p_net[0 as usize]) as u64)
    if n == 0 {
        ulib.say((&k_net[0 as usize]) as u64)
        ulib.say((&s_colsp[0 as usize]) as u64)
        ulib.say((&s_none[0 as usize]) as u64)
        ulib.nl()
    } else {
        info_lines((&k_net[0 as usize]) as u64, base, n)
    }

    n = rd_all((&p_usb[0 as usize]) as u64)
    var ctls: u64 = 0
    var devs: u64 = 0
    var at: u64 = 0
    while at < n {
        var e: u64 = at
        while e < n && octets.ld8(base, e) != 10 {
            e = e + 1
        }
        if e > at {
            if starts_with(base + at, n - at, (&w_ctlx[0 as usize]) as u64) {
                ctls = ctls + 1
            } else if !starts_with(base + at, n - at, (&w_ctl[0 as usize]) as u64) {
                devs = devs + 1
            }
        }
        at = e + 1
    }
    ulib.say((&s_ctls[0 as usize]) as u64)
    ulib.sayu(ctls)
    ulib.say((&s_devs[0 as usize]) as u64)
    ulib.sayu(devs)
    ulib.nl()
    info_lines((&k_usb[0 as usize]) as u64, base, n)
    return 0
}

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    var w_zust: [u8; 7] = "status\0"
    var w_recht: [u8; 12] = "permissions\0"
    var w_prot: [u8; 4] = "log\0"
    var w_kop: [u8; 5] = "pair\0"
    var w_sch: [u8; 11] = "screenshot\0"
    var w_gone: [u8; 10] = "transport\0"
    var w_eing: [u8; 6] = "input\0"
    var w_info: [u8; 5] = "info\0"
    var w_swap: [u8; 5] = "swap\0"
    var w_dev: [u8; 4] = "dev\0"
    if argc < 2 {
        return do_state()
    }
    let was: u64 = ulib.arg_at(args, 1)
    if ulib.streq(was, (&w_zust[0 as usize]) as u64) {
        return do_state()
    }
    if ulib.streq(was, (&w_info[0 as usize]) as u64) {
        return do_info()
    }
    if ulib.streq(was, (&w_swap[0 as usize]) as u64) {
        return ctlswap.do_swap(args, argc)
    }
    if ulib.streq(was, (&w_dev[0 as usize]) as u64) {
        return ctldev.do_dev(args, argc)
    }
    if ulib.streq(was, (&w_eing[0 as usize]) as u64) {
        return do_input(args, argc)
    }
    if ulib.streq(was, (&w_recht[0 as usize]) as u64) {
        let r: u64 = file_show((&FILE_PATH_RIGHTS[0 as usize]) as u64)
        if errno.failed(r) {
            var t: [u8; 45] = "/etc/jarvis/permissions.conf does not exist.\0"
            ulib.esay_line((&t[0 as usize]) as u64, 0)
            return 1
        }
        return 0
    }
    if ulib.streq(was, (&w_prot[0 as usize]) as u64) {
        var wieviel: u64 = 20
        if argc > 2 {
            wieviel = ulib.to_num(ulib.arg_at(args, 2))
        }
        let r: u64 = tail_show((&FILE_PATH_LOG[0 as usize]) as u64, wieviel)
        if errno.failed(r) {
            var t: [u8; 36] = "No log yet -- the helper never ran.\0"
            ulib.esay_line((&t[0 as usize]) as u64, 0)
            return 1
        }
        return 0
    }
    if ulib.streq(was, (&w_kop[0 as usize]) as u64) {
        if argc < 3 {
            var t: [u8; 29] = "usage: jarvisctl pair <code>\0"
            ulib.esay_line((&t[0 as usize]) as u64, 0)
            return 2
        }
        return do_pair(ulib.arg_at(args, 2))
    }
    if ulib.streq(was, (&w_sch[0 as usize]) as u64) {
        if argc > 2 && ulib.streq(ulib.arg_at(args, 2),
                (&w_gone[0 as usize]) as u64) {
            kcall.sys1(kcall.SYS_UNLINK, (&FILE_PATH_CERT[0 as usize]) as u64)
            var t: [u8; 27] = "Screenshot permit revoked.\0"
            show_line((&t[0 as usize]) as u64)
            return 0
        }
        var sec: u64 = 60
        if argc > 2 {
            sec = ulib.to_num(ulib.arg_at(args, 2))
        }
        if sec == 0 || sec > 3600 {
            sec = 60
        }
        return do_cert(sec)
    }
    var t: [u8; 157] = "usage: jarvisctl status | info | permissions | log [n] | pair <code> | screenshot [sec|revoke] | input | swap <src> <dst> | swap --undo <dst> | dev [on|off]\0"
    ulib.esay_line((&t[0 as usize]) as u64, 0)
    return 2
}
