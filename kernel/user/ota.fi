static mut S_GEHOLT: [u8; 16] = "ota: fetched   \0"

static mut S_WSEK: [u8; 3] = " s\0"

static mut S_KEINQ: [u8; 2] = "\0\0"

const SPACE_FACTOR: u64 = 3

static mut SU_R_ROOT: [u8; 5] = "root\0"

static mut W_SU_PATHA: [u8; 22] = "path: boot():/osum.mb\0"

static mut W_SU_DEFE: [u8; 15] = "default_entry:\0"

static mut W_SU_DEF2: [u8; 18] = "default_entry: 2\n\0"

static mut W_SU_CMD: [u8; 13] = "    cmdline:\0"

static mut W_SU_OSUMB: [u8; 10] = "osum-b.mb\0"

static mut E_SU_BACK: [u8; 56] = "ota: system build is not newer than the installed one: \0"

static mut su_phase: u64 = 0

fn u_start(args: u64) -> u64 {
    return otaapply.u_start(args)
}
