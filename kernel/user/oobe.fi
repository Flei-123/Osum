profile app

import fuiscene
import instaccount
import libc.fileops
import libc.text
import lineout
import msg
import ulib

export { u_start }

const WIN_X: u64 = 200
const WIN_Y: u64 = 100
const WIN_W: u64 = 480
const WIN_H: u64 = 460
const FIELD_W: u64 = 420
const BUTTON_W: u64 = 140
const BUTTON_H: u64 = 36
const BAR_GAP: u64 = 8
const K_NAME: u64 = 1
const K_PASS: u64 = 2
const K_AGAIN: u64 = 3
const K_LANG_DE: u64 = 4
const K_LANG_EN: u64 = 5
const K_DONE: u64 = 6

static mut k_title: [u8; 11] = "oobe.title\0"
static mut k_hint: [u8; 10] = "oobe.hint\0"
static mut k_name: [u8; 10] = "oobe.name\0"
static mut k_pass: [u8; 10] = "oobe.pass\0"
static mut k_again: [u8; 11] = "oobe.again\0"
static mut k_lang: [u8; 10] = "oobe.lang\0"
static mut k_done: [u8; 10] = "oobe.done\0"
static mut k_err_name: [u8; 14] = "oobe.err.name\0"
static mut k_err_pass: [u8; 14] = "oobe.err.pass\0"
static mut k_err_match: [u8; 15] = "oobe.err.match\0"
static mut k_err_make: [u8; 14] = "oobe.err.make\0"
static mut lang_de: [u8; 3] = "de\0"
static mut lang_en: [u8; 3] = "en\0"
static mut label_de: [u8; 8] = "Deutsch\0"
static mut label_en: [u8; 8] = "English\0"
static mut p_locale: [u8; 17] = "/etc/locale.conf\0"
static mut s_conf_de: [u8; 9] = "lang=de\n\0"
static mut s_conf_en: [u8; 9] = "lang=en\n\0"
static mut s_go: [u8; 12] = "oobe: ready\0"
static mut s_bad: [u8; 19] = "oobe: no surface\0\0\0"
static mut s_made: [u8; 20] = "oobe: account made\0\0"
static mut s_err: [u8; 12] = "oobe: err=\0\0"
static mut s_nm: [u8; 5] = "oobe\0"
static mut error_key: u64 = 0

fn say(p: u64) {
    lineout.add_text(p)
}

fn build() {
    let col: usize = fuiscene.root()
    let _h: usize = fuiscene.label_wrap(col, msg.get((&k_hint[0]) as u64), 2)
    let _ln: usize = fuiscene.label(col, msg.get((&k_name[0]) as u64))
    let _en: usize = fuiscene.entry(col, K_NAME, FIELD_W, 0)
    let _lp: usize = fuiscene.label(col, msg.get((&k_pass[0]) as u64))
    let _ep: usize = fuiscene.entry(col, K_PASS, FIELD_W, 0)
    fuiscene.entry_secret(K_PASS, true)
    let _la: usize = fuiscene.label(col, msg.get((&k_again[0]) as u64))
    let _ea: usize = fuiscene.entry(col, K_AGAIN, FIELD_W, 0)
    fuiscene.entry_secret(K_AGAIN, true)
    let _ll: usize = fuiscene.label(col, msg.get((&k_lang[0]) as u64))
    let langs: usize = fuiscene.row(col)
    fuiscene.set_gap(langs, BAR_GAP)
    let b1: usize = fuiscene.button(langs, (&label_de[0]) as u64, K_LANG_DE)
    fuiscene.set_size(b1, BUTTON_W, BUTTON_H)
    let b2: usize = fuiscene.button(langs, (&label_en[0]) as u64, K_LANG_EN)
    fuiscene.set_size(b2, BUTTON_W, BUTTON_H)
    if error_key != 0 {
        let _er: usize = fuiscene.label_muted(col, msg.get(error_key))
    }
    let done: usize = fuiscene.button_main(col, msg.get((&k_done[0]) as u64), K_DONE)
    fuiscene.set_size(done, FIELD_W, BUTTON_H)
}

fn pick_language(code: u64, conf: u64) {
    let _w: u64 = fileops.write_file((&p_locale[0]) as u64, conf, text.length(conf))
    let _l: bool = msg.set_lang(code)
    fuiscene.refresh()
}

fn check_input(name: u64, pass: u64, again: u64) -> u64 {
    if name == 0 || !instaccount.name_ok(name) {
        return (&k_err_name[0]) as u64
    }
    if pass == 0 || !instaccount.pass_ok(pass) {
        return (&k_err_pass[0]) as u64
    }
    if again == 0 || !ulib.streq(pass, again) {
        return (&k_err_match[0]) as u64
    }
    return 0
}

fn finish() {
    let name: u64 = fuiscene.entry_text(K_NAME)
    let pass: u64 = fuiscene.entry_text(K_PASS)
    error_key = check_input(name, pass, fuiscene.entry_text(K_AGAIN))
    if error_key == 0 {
        if instaccount.create(name, name, pass) {
            say((&s_made[0]) as u64)
            lineout.end_line()
            fuiscene.quit()
            return
        }
        error_key = (&k_err_make[0]) as u64
        say((&s_err[0]) as u64)
        lineout.add_unum(instaccount.fail_reason())
        lineout.end_line()
    }
    fuiscene.refresh()
}

fn handle(key: u64) {
    if key == K_LANG_DE {
        pick_language((&lang_de[0]) as u64, (&s_conf_de[0]) as u64)
    } else if key == K_LANG_EN {
        pick_language((&lang_en[0]) as u64, (&s_conf_en[0]) as u64)
    } else if key == K_DONE {
        finish()
    }
}

fn u_start(args: u64) -> u64 {
    let _mi: u64 = msg.init()
    if !fuiscene.open(WIN_X, WIN_Y, WIN_W, WIN_H, msg.get((&k_title[0]) as u64), build) {
        say((&s_bad[0]) as u64)
        lineout.end_line()
        return 1
    }
    fuiscene.set_app((&s_nm[0]) as u64)
    var first: bool = true
    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        if first {
            first = false
            fuiscene.say_rects((&s_nm[0]) as u64)
            say((&s_go[0]) as u64)
            lineout.end_line()
        }
        if key != 0 {
            handle(key)
        }
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
