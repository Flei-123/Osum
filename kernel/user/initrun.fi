profile kernel

import ulib
import libc.text

export { clear_files }

const SYS_GETDENTS: u64 = 217
const DIRENT_BUF: u64 = 2048
const DIRENT_HEADER: u64 = 19
const DIRENT_RECLEN_AT: u64 = 16
const PATH_MAX: u64 = 160

static mut P_RUN: [u8; 5] = "/run\0"
static mut P_RUN_DIR: [u8; 6] = "/run/\0"
static mut P_DOT: [u8; 2] = ".\0"
static mut P_DOTDOT: [u8; 3] = "..\0"
static mut path_buf: [u8; 160] = [0 as u8; 160]
static mut dent_buf: [u8; 2048] = [0 as u8; 2048]

fn g16(p: u64) -> u64 {
    let lo: u8 = *(p as *mut u8)
    let hi: u8 = *((p + 1) as *mut u8)
    return (lo as u64) | ((hi as u64) << 8)
}

fn unlink_entry(name: u64) {
    if ulib.streq(name, (&P_DOT[0]) as u64) || ulib.streq(name, (&P_DOTDOT[0]) as u64) {
        return
    }
    if text.length(name) + 6 >= PATH_MAX {
        return
    }
    ulib.strcpy((&path_buf[0]) as u64, (&P_RUN_DIR[0]) as u64)
    ulib.strcat((&path_buf[0]) as u64, name)
    if ulib.is_dir((&path_buf[0]) as u64) {
        return
    }
    ulib.sys(ulib.SYS_UNLINK, (&path_buf[0]) as u64, 0, 0)
}

fn clear_files() {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&P_RUN[0]) as u64, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let n: u64 = ulib.sys(SYS_GETDENTS, fd, (&dent_buf[0]) as u64, DIRENT_BUF)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return
    }
    var at: u64 = 0
    while at + DIRENT_HEADER < n {
        let rl: u64 = g16((&dent_buf[0]) as u64 + at + DIRENT_RECLEN_AT)
        if rl == 0 {
            return
        }
        unlink_entry((&dent_buf[0]) as u64 + at + DIRENT_HEADER)
        at = at + rl
    }
}
