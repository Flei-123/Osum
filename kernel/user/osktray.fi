profile kernel

import ulib
import libc.io

export { shown, set_shown, launch }

static mut p_conf: [u8; 14] = "/etc/osk.conf\0"
static mut p_osk: [u8; 9] = "/bin/osk\0"
static mut a_osk: [u8; 4] = "osk\0"
static mut line_on: [u8; 8] = "tray=1\n\0"
static mut line_off: [u8; 8] = "tray=0\n\0"
static mut buf: [u8; 64] = [0 as u8; 64]

fn shown() -> bool {
    let fd: u64 = io.open((&p_conf[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return false
    }
    buf[0 as usize] = 0 as u8
    let r: u64 = io.read(fd, (&buf[0 as usize]) as u64, 63)
    io.close(fd)
    if ulib.bad(r) || r < 6 {
        return false
    }
    var i: u64 = 0
    while i + 6 <= r {
        if buf[i as usize] == 116 && buf[(i + 1) as usize] == 114 && buf[(i + 2) as usize] == 97
            && buf[(i + 3) as usize] == 121 && buf[(i + 4) as usize] == 61 {
            return buf[(i + 5) as usize] == 49
        }
        i = i + 1
    }
    return false
}

fn set_shown(on: bool) -> bool {
    let fd: u64 = io.create((&p_conf[0 as usize]) as u64)
    if ulib.bad(fd) {
        return false
    }
    var line: u64 = (&line_off[0 as usize]) as u64
    if on {
        line = (&line_on[0 as usize]) as u64
    }
    let g: u64 = io.write_all(fd, line, 7)
    io.close(fd)
    return !ulib.bad(g) && g >= 7
}

fn launch() -> u64 {
    var av: [u64; 2] = [0 as u64; 2]
    av[0 as usize] = (&a_osk[0 as usize]) as u64
    return ulib.spawn_app((&p_osk[0 as usize]) as u64, (&av[0 as usize]) as u64, 1)
}
