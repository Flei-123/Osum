profile kernel

import ulib
import xfxio
import xfxpath
import xfxproc
import xfxpack
import xfxrun

export { u_start }

fn status() -> u64 {
    var l_inst: [u8; 16] = "xfx: installed=\0"
    var l_ins: [u8; 9] = "install=\0"
    var l_pct: [u8; 5] = "pct=\0"
    var l_fx: [u8; 9] = "firefox=\0"
    var l_pid: [u8; 5] = "pid=\0"
    var l_uid: [u8; 5] = "uid=\0"
    var y: [u8; 4] = "yes\0"
    var n: [u8; 3] = "no\0"
    var r: [u8; 8] = "running\0"
    var s: [u8; 8] = "stopped\0"
    var sp: [u8; 2] = " \0"
    if xfxpack.installed() {
        ulib.say((&l_inst[0 as usize]) as u64)
        ulib.say((&y[0 as usize]) as u64)
    } else {
        ulib.say((&l_inst[0 as usize]) as u64)
        ulib.say((&n[0 as usize]) as u64)
    }
    ulib.say((&sp[0 as usize]) as u64)
    ulib.say((&l_ins[0 as usize]) as u64)
    ulib.say(xfxpack.state_word())
    if ulib.streq(xfxpack.state_word(), (&r[0 as usize]) as u64) {
        ulib.say((&sp[0 as usize]) as u64)
        ulib.say((&l_pct[0 as usize]) as u64)
        ulib.sayu(xfxpack.state_pct())
    }
    ulib.say((&sp[0 as usize]) as u64)
    ulib.say((&l_fx[0 as usize]) as u64)
    let pid: u64 = xfxio.pid_field(xfxpath.p_pidf(), 0)
    if xfxproc.proc_ok(pid, xfxpath.n_fx()) {
        ulib.say((&r[0 as usize]) as u64)
        ulib.say((&sp[0 as usize]) as u64)
        ulib.say((&l_pid[0 as usize]) as u64)
        ulib.sayu(pid)
        ulib.say((&sp[0 as usize]) as u64)
        ulib.say((&l_uid[0 as usize]) as u64)
        ulib.sayu(xfxproc.proc_uid(pid))
    } else {
        ulib.say((&s[0 as usize]) as u64)
    }
    ulib.nl()
    return 0
}

fn u_start(args: u64) -> u64 {
    var use: [u8; 37] = "usage: xfx install|start|stop|status\0"
    var w_i: [u8; 8] = "install\0"
    var w_st: [u8; 6] = "start\0"
    var w_sp: [u8; 5] = "stop\0"
    var w_ss: [u8; 7] = "status\0"
    if ulib.arg_count(args) != 2 {
        xfxio.msg((&use[0 as usize]) as u64)
        return 2
    }
    let a: u64 = ulib.arg_at(args, 1)
    if ulib.streq(a, (&w_i[0 as usize]) as u64) {
        return xfxpack.install_start()
    }
    if ulib.streq(a, (&w_st[0 as usize]) as u64) {
        return xfxrun.start()
    }
    if ulib.streq(a, (&w_sp[0 as usize]) as u64) {
        return xfxrun.stop()
    }
    if ulib.streq(a, (&w_ss[0 as usize]) as u64) {
        return status()
    }
    xfxio.msg((&use[0 as usize]) as u64)
    return 2
}
