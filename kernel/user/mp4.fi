profile kernel

import ulib
import media
import libc.octets

export {
    mp4_open, mp4_close, mp4_err, mp4_has, mp4_items, mp4_item_off,
    mp4_item_size, mp4_item_dts, mp4_item_cts, mp4_item_key, mp4_width,
    mp4_height, mp4_rate, mp4_channels, mp4_bits, mp4_audio_codec,
    mp4_duration_ms, mp4_item_ms, mp4_nal_len_size, mp4_headers_annexb,
    mp4_sample_annexb, mp4_sample_raw,
    TRK_VIDEO, TRK_AUDIO, AC_NONE, AC_PCM_LE, AC_PCM_BE, AC_OTHER,
    ME_OK, ME_OPEN, ME_NO_MOOV, ME_TRUNC, ME_NO_TRACK, ME_TABLE, ME_BIG
}

const ME_OK: u64 = 0
const ME_OPEN: u64 = 1
const ME_NO_MOOV: u64 = 2
const ME_TRUNC: u64 = 3
const ME_NO_TRACK: u64 = 4
const ME_TABLE: u64 = 5
const ME_BIG: u64 = 6

const TRK_VIDEO: u64 = 0
const TRK_AUDIO: u64 = 1

const AC_NONE: u64 = 0
const AC_PCM_LE: u64 = 1
const AC_PCM_BE: u64 = 2
const AC_OTHER: u64 = 3

const MAX_ITEMS: u64 = 6144
const SCRATCH: u64 = 524288

const F_PRESENT: u64 = 0
const F_SCALE: u64 = 1
const F_DURATION: u64 = 2
const F_W: u64 = 3
const F_H: u64 = 4
const F_RATE: u64 = 5
const F_CH: u64 = 6
const F_BITS: u64 = 7
const F_CODEC: u64 = 8
const F_ITEMS: u64 = 9
const F_NAL_LEN: u64 = 10
const F_AVCC: u64 = 11
const F_FIELDS: u64 = 16

const BOX_MOOV: u64 = 0x6D6F6F76
const BOX_TRAK: u64 = 0x7472616B
const BOX_MDIA: u64 = 0x6D646961
const BOX_MDHD: u64 = 0x6D646864
const BOX_HDLR: u64 = 0x68646C72
const BOX_MINF: u64 = 0x6D696E66
const BOX_STBL: u64 = 0x7374626C
const BOX_STSD: u64 = 0x73747364
const BOX_STTS: u64 = 0x73747473
const BOX_STSZ: u64 = 0x7374737A
const BOX_STSC: u64 = 0x73747363
const BOX_STCO: u64 = 0x7374636F
const BOX_CO64: u64 = 0x636F3634
const BOX_STSS: u64 = 0x73747373
const BOX_CTTS: u64 = 0x63747473
const BOX_AVCC: u64 = 0x61766343
const FCC_AVC1: u64 = 0x61766331
const FCC_VIDE: u64 = 0x76696465
const FCC_SOUN: u64 = 0x736F756E
const FCC_SOWT: u64 = 0x736F7774
const FCC_TWOS: u64 = 0x74776F73

static mut trk: [u64; 32] = [0 as u64; 32]
static mut it_off: [u64; 12288] = [0 as u64; 12288]
static mut it_size: [u32; 12288] = [0 as u32; 12288]
static mut it_dts: [u32; 12288] = [0 as u32; 12288]
static mut it_cts: [u32; 12288] = [0 as u32; 12288]
static mut it_key: [u8; 12288] = [0 as u8; 12288]
static mut scratch: [u8; 524288] = [0 as u8; 524288]
static mut avcc_copy: [u8; 4096] = [0 as u8; 4096]
static mut avcc_len: u64 = 0

static mut last_err: u64 = 0
static mut g_box: u64 = 0
static mut g_pay: u64 = 0
static mut g_end: u64 = 0

static mut c_i: u64 = 0
static mut c_left: u64 = 0
static mut c_delta: u64 = 0
static mut c_dts: u64 = 0
static mut c_pay: u64 = 0
static mut c_n: u64 = 0

static mut x_i: u64 = 0
static mut x_left: u64 = 0
static mut x_off: u64 = 0
static mut x_pay: u64 = 0
static mut x_n: u64 = 0

fn mp4_err() -> u64 { return last_err }

fn fail(code: u64) -> bool {
    last_err = code
    return false
}

fn fld(t: u64, f: u64) -> u64 { return trk[(t * F_FIELDS + f) as usize] }

fn fset(t: u64, f: u64, v: u64) { trk[(t * F_FIELDS + f) as usize] = v }

fn mp4_has(t: u64) -> bool { return fld(t, F_PRESENT) == 1 }
fn mp4_items(t: u64) -> u64 { return fld(t, F_ITEMS) }
fn mp4_width() -> u64 { return fld(TRK_VIDEO, F_W) }
fn mp4_height() -> u64 { return fld(TRK_VIDEO, F_H) }
fn mp4_rate() -> u64 { return fld(TRK_AUDIO, F_RATE) }
fn mp4_channels() -> u64 { return fld(TRK_AUDIO, F_CH) }
fn mp4_bits() -> u64 { return fld(TRK_AUDIO, F_BITS) }
fn mp4_audio_codec() -> u64 { return fld(TRK_AUDIO, F_CODEC) }
fn mp4_nal_len_size() -> u64 { return fld(TRK_VIDEO, F_NAL_LEN) }

fn mp4_duration_ms(t: u64) -> u64 {
    let s: u64 = fld(t, F_SCALE)
    if s == 0 { return 0 }
    return fld(t, F_DURATION) * 1000 / s
}

fn mp4_item_ms(t: u64, i: u64) -> u64 {
    let s: u64 = fld(t, F_SCALE)
    if s == 0 || i >= fld(t, F_ITEMS) { return 0 }
    return (it_cts[slot(t, i)]) as u64 * 1000 / s
}

fn slot(t: u64, i: u64) -> usize { return (t * MAX_ITEMS + i) as usize }

fn mp4_item_off(t: u64, i: u64) -> u64 {
    if i >= fld(t, F_ITEMS) { return 0 }
    return it_off[slot(t, i)]
}

fn mp4_item_size(t: u64, i: u64) -> u64 {
    if i >= fld(t, F_ITEMS) { return 0 }
    return (it_size[slot(t, i)]) as u64
}

fn mp4_item_dts(t: u64, i: u64) -> u64 {
    if i >= fld(t, F_ITEMS) { return 0 }
    return (it_dts[slot(t, i)]) as u64
}

fn mp4_item_cts(t: u64, i: u64) -> u64 {
    if i >= fld(t, F_ITEMS) { return 0 }
    return (it_cts[slot(t, i)]) as u64
}

fn mp4_item_key(t: u64, i: u64) -> bool {
    if i >= fld(t, F_ITEMS) { return false }
    return it_key[slot(t, i)] == (1 as u8)
}

fn mp4_close() {
    media.src_close()
}

fn box_next(pos: u64, end: u64, kind: u64) -> bool {
    var p: u64 = pos
    while p + 8 <= end {
        var size: u64 = media.be32(p)
        let ty: u64 = media.be32(p + 4)
        var hdr: u64 = 8
        if size == 1 {
            size = media.be64(p + 8)
            hdr = 16
        } else if size == 0 {
            size = end - p
        }
        if size < hdr { return false }
        if ty == kind {
            g_box = p
            g_pay = p + hdr
            g_end = p + size
            return true
        }
        p = p + size
    }
    return false
}

fn child(parent_pay: u64, parent_end: u64, kind: u64) -> bool {
    return box_next(parent_pay, parent_end, kind)
}

fn stts_start(pay: u64) {
    c_pay = pay
    c_n = media.be32(pay + 4)
    c_i = 0
    c_left = 0
    c_delta = 0
    c_dts = 0
    stts_load()
}

fn stts_load() {
    while c_left == 0 && c_i < c_n {
        c_left = media.be32(c_pay + 8 + c_i * 8)
        c_delta = media.be32(c_pay + 12 + c_i * 8)
        c_i = c_i + 1
    }
}

fn stts_advance(n: u64) {
    var rest: u64 = n
    while rest > 0 && c_left > 0 {
        var m: u64 = rest
        if m > c_left { m = c_left }
        c_dts = c_dts + m * c_delta
        c_left = c_left - m
        rest = rest - m
        if c_left == 0 { stts_load() }
    }
}

fn ctts_start(pay: u64) {
    if pay == 0 {
        x_pay = 0
        x_n = 0
        return
    }
    x_pay = pay
    x_n = media.be32(pay + 4)
    x_i = 0
    x_left = 0
    x_off = 0
    ctts_load()
}

fn ctts_load() {
    while x_left == 0 && x_i < x_n {
        x_left = media.be32(x_pay + 8 + x_i * 8)
        x_off = media.be32(x_pay + 12 + x_i * 8)
        x_i = x_i + 1
    }
}

fn ctts_take() -> u64 {
    if x_pay == 0 || x_left == 0 { return 0 }
    let v: u64 = x_off
    x_left = x_left - 1
    if x_left == 0 { ctts_load() }
    return v
}

fn to_ms(units: u64, scale: u64) -> u64 {
    if scale == 0 { return 0 }
    let ms: u64 = units * 1000 / scale
    if ms > 0xFFFFFFFF { return 0xFFFFFFFF }
    return ms
}

fn chunk_offset(co_pay: u64, wide: bool, c: u64) -> u64 {
    if wide { return media.be64(co_pay + 8 + c * 8) }
    return media.be32(co_pay + 8 + c * 4)
}

fn put_item(t: u64, i: u64, off: u64, size: u64, dts: u64, cts: u64, key: bool) {
    let s: usize = slot(t, i)
    it_off[s] = off
    var sz: u64 = size
    if sz > 0xFFFFFFFF { sz = 0xFFFFFFFF }
    it_size[s] = sz as u32
    it_dts[s] = dts as u32
    it_cts[s] = cts as u32
    if key { it_key[s] = 1 as u8 } else { it_key[s] = 0 as u8 }
}

fn fits(pay: u64, head: u64, n: u64, width: u64) -> bool {
    return pay + head + n * width <= media.src_size()
}

fn tables_fit(stts: u64, stsz: u64, stsc: u64, co: u64, wide: bool, stss: u64, ctts: u64,
              const_size: u64, n_samples: u64, n_runs: u64, n_chunks: u64) -> bool {
    var cw: u64 = 4
    if wide { cw = 8 }
    if !fits(co, 8, n_chunks, cw) { return false }
    if !fits(stsc, 8, n_runs, 12) { return false }
    if !fits(stts, 8, media.be32(stts + 4), 8) { return false }
    if const_size == 0 && !fits(stsz, 12, n_samples, 4) { return false }
    if stss != 0 && !fits(stss, 8, media.be32(stss + 4), 4) { return false }
    if ctts != 0 && !fits(ctts, 8, media.be32(ctts + 4), 8) { return false }
    return true
}

fn build_items(t: u64, stts: u64, stsz: u64, stsc: u64, co: u64, wide: bool,
               stss: u64, ctts: u64) -> bool {
    let scale: u64 = fld(t, F_SCALE)
    let const_size: u64 = media.be32(stsz + 4)
    let n_samples: u64 = media.be32(stsz + 8)
    let n_runs: u64 = media.be32(stsc + 4)
    let n_chunks: u64 = media.be32(co + 4)
    if n_runs == 0 || n_chunks == 0 { return fail(ME_TABLE) }
    if n_chunks > MAX_ITEMS { return fail(ME_BIG) }
    if !tables_fit(stts, stsz, stsc, co, wide, stss, ctts, const_size, n_samples, n_runs, n_chunks) {
        return fail(ME_TRUNC)
    }
    stts_start(stts)
    ctts_start(ctts)
    var n_keys: u64 = 0
    var key_i: u64 = 0
    var next_key: u64 = 0
    if stss != 0 {
        n_keys = media.be32(stss + 4)
        if n_keys > 0 { next_key = media.be32(stss + 8) }
    }
    var count: u64 = 0
    var sample: u64 = 0
    var run: u64 = 0
    var chunk: u64 = 0
    while chunk < n_chunks {
        while run + 1 < n_runs && media.be32(stsc + 8 + (run + 1) * 12) <= chunk + 1 {
            run = run + 1
        }
        let spc: u64 = media.be32(stsc + 12 + run * 12)
        var off: u64 = chunk_offset(co, wide, chunk)
        if const_size != 0 {
            if count >= MAX_ITEMS { return fail(ME_BIG) }
            put_item(t, count, off, spc * const_size, to_ms(c_dts, scale), 0, true)
            stts_advance(spc)
            count = count + 1
            sample = sample + spc
        } else {
            var k: u64 = 0
            while k < spc && sample < n_samples {
                if count >= MAX_ITEMS { return fail(ME_BIG) }
                let size: u64 = media.be32(stsz + 12 + sample * 4)
                var key: bool = true
                if stss != 0 {
                    key = false
                    if sample + 1 == next_key {
                        key = true
                        key_i = key_i + 1
                        if key_i < n_keys { next_key = media.be32(stss + 8 + key_i * 4) }
                        else { next_key = 0 }
                    }
                }
                let dts: u64 = c_dts
                let cts: u64 = dts + ctts_take()
                put_item(t, count, off, size, to_ms(dts, scale), to_ms(cts, scale), key)
                if off + size > media.src_size() { return fail(ME_TRUNC) }
                off = off + size
                stts_advance(1)
                count = count + 1
                sample = sample + 1
                k = k + 1
            }
        }
        chunk = chunk + 1
    }
    fset(t, F_ITEMS, count)
    return true
}

fn read_avcc(entry: u64, entry_end: u64) -> bool {
    if !child(entry + 86, entry_end, BOX_AVCC) { return fail(ME_TABLE) }
    let n: u64 = g_end - g_pay
    if n > 4096 || n < 7 { return fail(ME_TABLE) }
    media.src_bytes(g_pay, (&avcc_copy[(0) as usize]) as u64, n)
    avcc_len = n
    fset(TRK_VIDEO, F_NAL_LEN, (octets.ld8((&avcc_copy[(0) as usize]) as u64, 4) & 3) + 1)
    return true
}

fn parse_audio_entry(e: u64, fcc: u64) {
    fset(TRK_AUDIO, F_CH, media.be16(e + 24))
    fset(TRK_AUDIO, F_BITS, media.be16(e + 26))
    fset(TRK_AUDIO, F_RATE, media.be16(e + 32))
    if fcc == FCC_SOWT {
        fset(TRK_AUDIO, F_CODEC, AC_PCM_LE)
    } else if fcc == FCC_TWOS {
        fset(TRK_AUDIO, F_CODEC, AC_PCM_BE)
    } else {
        fset(TRK_AUDIO, F_CODEC, AC_OTHER)
    }
}

fn parse_trak(pay: u64, end: u64) -> bool {
    if !child(pay, end, BOX_MDIA) { return true }
    let mdia_pay: u64 = g_pay
    let mdia_end: u64 = g_end
    if !child(mdia_pay, mdia_end, BOX_HDLR) { return true }
    let handler: u64 = media.be32(g_pay + 8)
    var t: u64 = 0
    if handler == FCC_VIDE { t = TRK_VIDEO }
    else if handler == FCC_SOUN { t = TRK_AUDIO }
    else { return true }
    if mp4_has(t) { return true }
    if !child(mdia_pay, mdia_end, BOX_MDHD) { return fail(ME_TABLE) }
    if (media.be32(g_pay) >> 24) == 1 {
        fset(t, F_SCALE, media.be32(g_pay + 20))
        fset(t, F_DURATION, media.be64(g_pay + 24))
    } else {
        fset(t, F_SCALE, media.be32(g_pay + 12))
        fset(t, F_DURATION, media.be32(g_pay + 16))
    }
    if !child(mdia_pay, mdia_end, BOX_MINF) { return fail(ME_TABLE) }
    if !child(g_pay, g_end, BOX_STBL) { return fail(ME_TABLE) }
    let stbl_pay: u64 = g_pay
    let stbl_end: u64 = g_end
    if !child(stbl_pay, stbl_end, BOX_STSD) { return fail(ME_TABLE) }
    let entry: u64 = g_pay + 8
    let entry_end: u64 = entry + media.be32(entry)
    let fcc: u64 = media.be32(entry + 4)
    if t == TRK_VIDEO {
        if fcc != FCC_AVC1 { return true }
        fset(t, F_W, media.be16(entry + 32))
        fset(t, F_H, media.be16(entry + 34))
        if !read_avcc(entry, entry_end) { return false }
    } else {
        parse_audio_entry(entry, fcc)
    }
    if !child(stbl_pay, stbl_end, BOX_STTS) { return fail(ME_TABLE) }
    let stts: u64 = g_pay
    if !child(stbl_pay, stbl_end, BOX_STSZ) { return fail(ME_TABLE) }
    let stsz: u64 = g_pay
    if !child(stbl_pay, stbl_end, BOX_STSC) { return fail(ME_TABLE) }
    let stsc: u64 = g_pay
    var wide: bool = false
    if !child(stbl_pay, stbl_end, BOX_STCO) {
        if !child(stbl_pay, stbl_end, BOX_CO64) { return fail(ME_TABLE) }
        wide = true
    }
    let co: u64 = g_pay
    var stss: u64 = 0
    if child(stbl_pay, stbl_end, BOX_STSS) { stss = g_pay }
    var ctts: u64 = 0
    if child(stbl_pay, stbl_end, BOX_CTTS) { ctts = g_pay }
    if !build_items(t, stts, stsz, stsc, co, wide, stss, ctts) { return false }
    fset(t, F_PRESENT, 1)
    return true
}

fn mp4_open(path: u64) -> bool {
    last_err = ME_OK
    var i: u64 = 0
    while i < 32 { trk[(i) as usize] = 0; i = i + 1 }
    avcc_len = 0
    if !media.src_open(path) { return fail(ME_OPEN) }
    let size: u64 = media.src_size()
    if !box_next(0, size, BOX_MOOV) { return fail(ME_NO_MOOV) }
    if g_end > size { return fail(ME_TRUNC) }
    let moov_pay: u64 = g_pay
    let moov_end: u64 = g_end
    var pos: u64 = moov_pay
    while box_next(pos, moov_end, BOX_TRAK) {
        pos = g_end
        if !parse_trak(g_pay, g_end) { return false }
    }
    if !mp4_has(TRK_VIDEO) && !mp4_has(TRK_AUDIO) { return fail(ME_NO_TRACK) }
    return true
}

fn put_start_code(dst: u64, at: u64) {
    octets.st8(dst, at, 0)
    octets.st8(dst, at + 1, 0)
    octets.st8(dst, at + 2, 0)
    octets.st8(dst, at + 3, 1)
}

fn mp4_headers_annexb(dst: u64, cap: u64) -> u64 {
    if avcc_len < 7 { return 0 }
    let base: u64 = (&avcc_copy[(0) as usize]) as u64
    var at: u64 = 0
    var p: u64 = 5
    var groups: u64 = 2
    var g: u64 = 0
    while g < groups {
        var n: u64 = octets.ld8(base, p)
        if g == 0 { n = n & 31 }
        p = p + 1
        var k: u64 = 0
        while k < n {
            if p + 2 > avcc_len { return 0 }
            let len: u64 = (octets.ld8(base, p) << 8) | octets.ld8(base, p + 1)
            p = p + 2
            if p + len > avcc_len || at + 4 + len > cap { return 0 }
            put_start_code(dst, at)
            at = at + 4
            octets.copy(dst + at, base + p, len)
            at = at + len
            p = p + len
            k = k + 1
        }
        g = g + 1
    }
    return at
}

fn mp4_sample_raw(t: u64, i: u64, dst: u64, cap: u64) -> u64 {
    let n: u64 = mp4_item_size(t, i)
    if n == 0 || n > cap { return 0 }
    let got: u64 = media.src_bytes(mp4_item_off(t, i), dst, n)
    if got != n { return 0 }
    return n
}

fn mp4_sample_annexb(i: u64, dst: u64, cap: u64) -> u64 {
    let raw: u64 = (&scratch[(0) as usize]) as u64
    let n: u64 = mp4_sample_raw(TRK_VIDEO, i, raw, SCRATCH)
    if n == 0 { return 0 }
    let ls: u64 = mp4_nal_len_size()
    var p: u64 = 0
    var at: u64 = 0
    while p + ls <= n {
        var len: u64 = 0
        var b: u64 = 0
        while b < ls {
            len = (len << 8) | octets.ld8(raw, p + b)
            b = b + 1
        }
        p = p + ls
        if len == 0 || p + len > n || at + 4 + len > cap { return 0 }
        put_start_code(dst, at)
        at = at + 4
        octets.copy(dst + at, raw + p, len)
        at = at + len
        p = p + len
    }
    return at
}
