profile kernel

import ulib

export { is_vault_dir, launch }

fn is_vault_dir(path: u64) -> bool {
    var root: [u8; 9] = "/secrets\0"
    return ulib.streq(path, (&root[0 as usize]) as u64)
}

fn launch() -> u64 {
    var prog: [u8; 13] = "/bin/vaultui\0"
    return ulib.sys(ulib.SYS_EXEC, (&prog[0 as usize]) as u64, 0, 0)
}
