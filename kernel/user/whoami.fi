// kernel/user/whoami.fi -- Runde K13: der Name zur WIRKSAMEN Kennung.
//
// Nicht zur echten. Das ist der ganze Unterschied zwischen `whoami` und
// `id -un`, und er ist gemessen: nach `su justin` sagen beide `justin`,
// aber in einem Programm mit setuid-Bit sagt `whoami` `root` und `id -un`
// den, der es gestartet hat.
//
// Findet sich kein Eintrag in /etc/passwd, wird die ZAHL geschrieben --
// eine Kennung ohne Namen ist kein Fehler, sie ist nur namenlos.

profile kernel

import ulib
import tools
import pw

export { u_start }

fn u_start(args: u64) -> u64 {
    var nm: [u8; 64] = [0 as u8; 64]
    let euid: u64 = ulib.sys(107, 0, 0, 0)
    if pw.name_of_uid(euid, (&nm[0]) as u64, 64) {
        tools.ob_str((&nm[0]) as u64)
    } else {
        tools.ob_num(euid)
    }
    tools.ob_nl()
    tools.ob_flush()
    return 0
}
