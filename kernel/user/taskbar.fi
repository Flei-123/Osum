// RUNDE ECHTHARDWARE-4: die zwei Zahlen, an denen "zu kleines Symbol"
// zu messen ist -- die gemalte Kante und die Hoehe des Knopfes.
static mut s_syg: [u8; 10] = " gemalt=\0\0"
static mut s_syk: [u8; 9] = " knopf=\0\0"

// Die Zahl der Bildpunkte des Symbols, die WIRKLICH Farbe tragen --
// Deckung ungleich null. Ein leeres OSYM hat dieselbe Breite und
// dieselbe Hoehe wie ein volles.
fn sym_ink(p: u64) -> u64 {
    let w: u64 = wlibc.icon_w(p)
    let h: u64 = wlibc.icon_h(p)
    if w == 0 || h == 0 {
        return 0
    }
    var n: u64 = 0
    var i: u64 = 0
    while i < w * h {
        if (*((p + 12 + i * 4 + 3) as *mut u8)) != 0 as u8 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}
