static mut py_: [u64; 6] = [0 as u64; 6]
static mut pw_: [u64; 6] = [0 as u64; 6]
static mut ph_: [u64; 6] = [0 as u64; 6]

static mut ky: [u64; 10] = [0 as u64; 10]
static mut kw: [u64; 10] = [0 as u64; 10]
static mut kh: [u64; 10] = [0 as u64; 10]
static mut kid: [u64; 10] = [0 as u64; 10]
static mut kver: [u64; 10] = [0 as u64; 10]
static mut kfok: [u64; 10] = [0 as u64; 10]
// ROUND NETVIEW: the network view of the process each window belongs to.
