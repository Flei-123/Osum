fn say_text(mark: u64, x: u64, base: u64, fg: u64, bg: u64, txt: u64) {
    if s_melde == 0 {
        return
    }
    say((&s_tx[0 as usize]) as u64)
    say(mark)
    say((&s_tX[0 as usize]) as u64)
    sayn(x)
    say((&s_tb[0 as usize]) as u64)
    sayn(base)
    say((&s_tf[0 as usize]) as u64)
    sayn(fg)
    say((&s_tg[0 as usize]) as u64)
    sayn(bg)
    say((&s_tw[0 as usize]) as u64)
    sayn(wlibc.text_w(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY), txt, tlen(txt)))
    say((&s_tt[0 as usize]) as u64)
    say(txt)
    nl()
}

// One button: face, edge, and the label CENTRED. Returns the position
// of the label so it can be reported; the runner recomputes it in the
// picture, per character.
fn button(x: u64, y: u64, w: u64, h: u64, txt: u64, on: bool,
    dim: bool) -> u64 {
    return button_sym(x, y, w, h, txt, on, dim, 0, 0)
}

static mut mk_ink: u64 = 0

fn brand_paint_ok(x: u64, y: u64, w: u64, h: u64, report: bool) -> bool {
    if w < 8 || h < 8 {
        return false
    }
    var kante: u64 = h - 4
    if kante > w - 4 {
        kante = w - 4
    }
    if brand_start.wide(kante) == 0 {
        return false
    }
    brand_paint(x, y, w, h, report)
    return true
}

fn brand_paint(x: u64, y: u64, w: u64, h: u64, report: bool) {
    var s_mk: [u8; 18] = "taskbar: marke n=\0"
    var s_mx: [u8; 4] = " x=\0"
    var s_my: [u8; 4] = " y=\0"
    var s_mi: [u8; 6] = " ink=\0"
    if w < 8 || h < 8 {
        return
    }
    var kante: u64 = h - 4
    if kante > w - 4 {
        kante = w - 4
    }
    let n: u64 = brand_start.wide(kante)
    if n == 0 {
        return
    }
    var qn: u64 = n
    var draw: u64 = 1
    var best: u64 = n
    var bmal: u64 = 9
    var kn: u64 = 16
    while kn <= 64 {
        var m2: u64 = 1
        while m2 <= 4 {
            let gr: u64 = kn * m2
            if gr <= kante {
                if gr > best || (gr == best && m2 < bmal) {
                    best = gr
                    bmal = m2
                    qn = kn
                    draw = m2
                }
            }
            m2 = m2 + 1
        }
        // 16 -> 24 -> 32 -> 48 -> 64, die eingebackenen Groessen
        if kn == 16 {
            kn = 24
        } else if kn == 24 {
            kn = 32
        } else if kn == 32 {
            kn = 48
        } else if kn == 48 {
            kn = 64
        } else {
            kn = 65
        }
    }
    let gz: u64 = qn * draw
    let x0: u64 = x + (w - gz) / 2
    let y0: u64 = y + (h - gz) / 2
    let grund: u64 = wlibc.theme(wlibc.C_BUTTON_FACE)
    mk_ink = 0
    var yy: u64 = 0
    while yy < qn {
        var xx: u64 = 0
        while xx < qn {
            let v: u64 = brand_start.point(qn, xx, yy)
            let a: u64 = (v >> 24) & 0xFF
            if a != 0 {
                var q: u64 = v & wlibc.RGB24
                let qr: u64 = (q >> 16) & 255
                let qg: u64 = (q >> 8) & 255
                let qb: u64 = q & 255
                var hoch: u64 = qr
                if qg > hoch {
                    hoch = qg
                }
                if qb > hoch {
                    hoch = qb
                }
                var tief: u64 = qr
                if qg < tief {
                    tief = qg
                }
                if qb < tief {
                    tief = qb
                }
                if hoch -% tief < 24 {
                    q = wlibc.theme(wlibc.T_FG)
                }
                let f: u64 = wlibc.blend(grund, q, a)
                var dy: u64 = 0
                while dy < draw {
                    var dx: u64 = 0
                    while dx < draw {
                        wlib.draw_point(x0 + xx * draw + dx,
                            y0 + yy * draw + dy, f)
                        dx = dx + 1
                    }
                    dy = dy + 1
                }
                mk_ink = mk_ink + 1
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
    if report {
        say((&s_mk[0 as usize]) as u64)
        sayn(gz)
        say((&s_mx[0 as usize]) as u64)
        sayn(x0)
        say((&s_my[0 as usize]) as u64)
        sayn(y0)
        say((&s_mi[0 as usize]) as u64)
        sayn(mk_ink)
        nl()
    }
}

const SYM_AIR: u64 = 2

fn sym_scale(sym: u64, h: u64) -> u64 {
    let ih: u64 = wlibc.icon_h(sym)
    if ih == 0 {
        return wlibc.ui_scale()
    }
    var luft: u64 = 2 * SYM_AIR * wlibc.ui_scale()
    if h <= luft {
        luft = 0
    }
    let raum: u64 = h - luft
    var s: u64 = raum / ih
    if s < 1 {
        s = 1
    }
    if s > 8 {
        s = 8
    }
    if s < wlibc.ui_scale() {
        s = wlibc.ui_scale()
    }
    return s
}

// r399 (design audit): the drawn size of a program symbol. A vector icon (72x72 with real
// alpha, tools/svg/mkapps.py) is drawn into a square of 24 points (x ui_scale),
// the size of the icons of the Windows 11 bar, but never taller than the button
// minus the air above and below; a 16x16 drawing keeps its integer factor.
fn sym_w(sym: u64, h: u64) -> u64 {
    if wlibc.icon_vec(sym) {
        let sc: u64 = wlibc.ui_scale()
        // R-ICONS: the program symbol is as big as the logo of the start button: the whole
        // button minus the air above and below (measured: 4/5 of the button gave an ink 24
        // high against a logo ink 28 at scale 1; the artwork carries a margin of its own)
        var want: u64 = 24 * sc
        var room: u64 = 0
        if h > 2 * SYM_AIR * sc {
            room = h - 2 * SYM_AIR * sc
        }
        if room > want {
            want = room
        }
        if want > room && room > 0 {
            want = room
        }
        return want
    }
    return wlibc.icon_w(sym) * sym_scale(sym, h)
}

fn sym_hh(sym: u64, h: u64) -> u64 {
    if wlibc.icon_vec(sym) {
        return sym_w(sym, h)
    }
    return wlibc.icon_h(sym) * sym_scale(sym, h)
}

fn button_sym(x: u64, y: u64, w: u64, h: u64, txt: u64, on: bool,
    dim: bool, mark: u64, sym: u64) -> u64 {
    let weich: bool = wlibc.radius() != 0
        || wlibc.metric(wlibc.M_DIVIDER) < 50
    var fg: u64 = wlibc.theme(wlibc.T_FG)
    var face: u64 = wlibc.theme(wlibc.C_TASKBAR_BG)
    let zx: u64 = wlibc.mouse_x()
    let zy: u64 = wlibc.mouse_y()
    let ox: u64 = bar_x
    let oy: u64 = bar_y
    let drauf: bool = zx >= ox + x && zx < ox + x + w
        && zy >= oy + y && zy < oy + y + h
    let gedrueckt: bool = drauf && (wlibc.mouse_btn() & 1) != 0
    if weich {
        if on {
            var af: u64 = wlibc.theme(wlibc.C_BUTTON_HOVER)
            if gedrueckt {
                af = wlibc.mix(af, wlibc.theme(wlibc.T_BTNDN), 65)
            } else if drauf {
                af = wlibc.mix(af, wlibc.theme(wlibc.T_BTNHI), 40)
            }
            wlib.draw_board(x, y, w, h, wlib.MR_BUTTON, wlibc.EL_FLAT,
                af, 0)
            face = af
        } else if gedrueckt {
            wlib.draw_board(x, y, w, h, wlib.MR_BUTTON, wlibc.EL_FLAT,
                wlibc.theme(wlibc.T_BTNDN), 0)
            face = wlibc.theme(wlibc.T_BTNDN)
        } else if drauf {
            let dh: u64 = wlibc.mix(wlibc.theme(wlibc.T_PANEL),
                wlibc.theme(wlibc.T_BTNHI), 55)
            wlib.draw_board(x, y, w, h, wlib.MR_BUTTON, wlibc.EL_FLAT,
                dh, 0)
            face = dh
        } else if dim {
            fg = wlibc.theme(wlibc.T_DIM)
        }
        if dim {
            fg = wlibc.theme(wlibc.T_DIM)
        }
    } else {
        var bg: u64 = wlibc.theme(wlibc.C_BUTTON_FACE)
        if on {
            bg = wlibc.theme(wlibc.T_SEL)
        } else if dim {
            bg = wlibc.theme(wlibc.T_SCROLL)
        }
        wlib.draw_edge3(x, y, w, h, bg, wlibc.theme(wlibc.T_BTNHI),
            wlibc.theme(wlibc.C_BORDER), on)
        face = bg
        if on {
            fg = wlibc.theme(wlibc.T_SELFG)
        } else if dim {
            fg = wlibc.theme(wlibc.T_DIM)
        }
    }
    var room: u64 = 0
    var symsc: u64 = 0
    var symw: u64 = 0
    if sym != 0 {
        symsc = sym_scale(sym, h)
        symw = sym_w(sym, h)
        room = room + symw + 3
    }
    if mark != 0 {
        room = room + mk_w() + 3
    }
    let n: u64 = tlen(txt)
    var tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY), txt, n)
    if tw + 8 + room > w {
        if w > 8 + room {
            tw = w - 8 - room
        } else {
            tw = 0
        }
    }
    let luft: u64 = 4 * wlibc.ui_scale()
    var gruppe: u64 = tw
    if sym != 0 {
        gruppe = gruppe + symw
        if tw != 0 {
            gruppe = gruppe + luft
        }
    }
    if mark != 0 {
        gruppe = gruppe + mk_w() + luft
    }
    var gx: u64 = x + 3
    if w > gruppe + 6 {
        gx = x + (w - gruppe) / 2
    }
    let tx: u64 = gx + gruppe - tw
    let base: u64 = y + (h + asc) / 2 - 1
    lab_tx = tx
    lab_tw = tw
    lab_fg = fg
    lab_bg = face
    if n == 0 {
        lab_tw = 0
    }
    var mx: u64 = gx
    if sym != 0 {
        let sh: u64 = sym_hh(sym, h)
        var sy2: u64 = y
        if h > sh {
            sy2 = y + (h - sh) / 2
        }
        if wlibc.icon_vec(sym) {
            let _v: bool = wlibc.icon_draw_fit(symvar.pick(sym, symw), mx, sy2, symw)
        } else {
            let _s: bool = wlibc.icon_draw_sc(sym, mx, sy2, symsc)
        }
        mx = mx + symw
        if tw != 0 {
            mx = mx + luft
        }
    }
    mk_x = mx
    mk_y = y + (h - mk_w()) / 2
    if mark != 0 {
        // FLUSH LEFT AND VERTICALLY CENTRED. Left, because a mark that
        // moves with the length of the title is a mark the eye has to
        // look for; the whole value of it is that it is always in the
        // same place.
        let _m: bool = wlibc.icon_draw(mark, mx, y + (h - mk_w()) / 2)
    }
    let _e: u64 = text_mit_schild(tx, base, txt, n, fg, wlibc.TY_BODY,
        face)
    return (tx << 32) | base
}

static mut lab_tx: u64 = 0
static mut lab_fg: u64 = 0
static mut lab_bg: u64 = 0
static mut lab_tw: u64 = 0
static mut pl_x: u64 = 0
static mut pl_y: u64 = 0
static mut pl_w: u64 = 0

fn group_next(e: u64) -> u64 {
    let c: u64 = kcnt[(e) as usize]
    var cc: u64 = c
    if cc > 8 {
        cc = 8
    }
    var at: u64 = 0
    var m: u64 = 0
    while m < cc {
        if kmem[((e * 8 + m)) as usize] == kid[(e) as usize] {
            at = m
        }
        m = m + 1
    }
    return kmem[((e * 8 + (at + 1) % cc)) as usize]
}

// a group of several windows shows one short dash on each side of the bar (up to two more)
fn group_dashes(cnt: u64) {
    if cnt < 2 || pl_w == 0 {
        return
    }
    let dy: u64 = pl_y
    let c: u64 = wlibc.theme(wlibc.C_TEXT_MUTED)
    let sc: u64 = wlibc.ui_scale()
    if pl_x >= 8 * sc {
        wlib.draw_bar(pl_x - 7 * sc, dy, 4 * sc, 3 * sc, c)
    }
    if cnt > 2 {
        wlib.draw_bar(pl_x + pl_w + 3 * sc, dy, 4 * sc, 3 * sc, c)
    }
}

fn pill(x: u64, y: u64, w: u64, h: u64, vorne: bool) {
    pl_x = 0
    pl_w = 0
    let weich: bool = wlibc.radius() != 0
        || wlibc.metric(wlibc.M_DIVIDER) < 50
    if !weich || w < 12 || h < 6 {
        return
    }
    let sc: u64 = wlibc.ui_scale()
    var pw: u64 = 10 * sc
    var c: u64 = wlibc.theme(wlibc.C_TEXT_MUTED)
    if vorne {
        pw = w * 45 / 100
        if lab_tw != 0 {
            pw = lab_tw
        }
        c = wlibc.theme(wlibc.C_ACCENT)
    }
    if pw > w - 4 {
        pw = w - 4
    }
    var px: u64 = x + (w - pw) / 2
    if vorne && lab_tw != 0 && pw == lab_tw {
        px = lab_tx
    }
    var py: u64 = y + h - 3 * sc
    if cf_edge == wlibc.WE_TOP {
        py = y
    }
    wlib.draw_bar(px, py, pw, 3 * sc, c)
    pl_x = px
    pl_y = py
    pl_w = pw
}

// Where the free space of a horizontal bar begins and ends: behind the
// last window button, in front of the first status field.
fn hover_left() -> u64 {
    var x: u64 = st_x + st_w + gap()
    var i: u64 = 0
    while i < nk {
        if kw[(i) as usize] != 0 && kx[(i) as usize] + kw[(i) as usize] + gap() > x {
            x = kx[(i) as usize] + kw[(i) as usize] + gap()
        }
        i = i + 1
    }
    return x
}

fn hover_right() -> u64 {
    var x: u64 = win_w
    var f: u64 = 0
    while f < F_N {
        if f_w[(f) as usize] != 0 && f_x[(f) as usize] < x {
            x = f_x[(f) as usize]
        }
        f = f + 1
    }
    var p: u64 = 0
    while p < PB_MAX {
        if pb_w[(p) as usize] != 0 && pb_x[(p) as usize] < x {
            x = pb_x[(p) as usize]
        }
        p = p + 1
    }
    if x < gap() {
        return 0
    }
    return x - gap()
}

fn put_n(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        let _c: u64 = ulib.sys(ulib.SYS_WRITE, ulib.OUT, p + i, 1)
        i = i + 1
    }
}

static mut s_tvl: [u8; 21] = "taskbar: taskview x=\0"
static mut s_chl: [u8; 20] = "taskbar: chevron x=\0"
static mut s_grl: [u8; 18] = "taskbar: group x=\0"
static mut s_bgl: [u8; 20] = "taskbar: badge txt=\0"
static mut s_opn: [u8; 7] = " open=\0"
static mut s_bgn: [u8; 4] = " n=\0"

// r387: the number of open windows of the program a pin stands for
fn app_windows(name: u64) -> u64 {
    var c: u64 = 0
    var j: u64 = 0
    while j < nk {
        if sym_eq(name, (&kapp[0 as usize]) as u64 + j * 24) {
            c = c + kcnt[(j) as usize]
        }
        j = j + 1
    }
    return c
}

// r387: a button of the bar whose picture is a glyph of the icon font
fn glyph_button(x: u64, y: u64, w: u64, h: u64, cp: u64, kante: u64) {
    let _r: u64 = button_sym(x, y, w, h, (&s_leer[0 as usize]) as u64,
        false, false, 0, 0)
    if glyphs_ok() && w > kante && h > kante {
        let _g: bool = wlibc.icon_mid_ink(cp, x + (w - kante) / 2, y, kante,
            h, kante, wlibc.theme(wlibc.T_FG))
    }
}

// r387: the count on a pinned program with several windows (top right corner)
fn badge_paint(px0: u64, py0: u64, pw0: u64, n: u64, report: bool) {
    var dg: [u8; 4] = [0 as u8; 4]
    var dl: u64 = 1
    if n > 9 {
        dg[0 as usize] = 57 as u8
        dg[1 as usize] = 43 as u8
        dl = 2
    } else {
        dg[0 as usize] = (48 + n) as u8
    }
    dg[(dl) as usize] = 0 as u8
    let dp: u64 = (&dg[0 as usize]) as u64
    let tw: u64 = wlib.draw_text_w(dp, dl, wlibc.TY_CAPTION)
    let bh: u64 = btn_h() / 2 + 2
    var bw: u64 = tw + 6
    if bw < bh {
        bw = bh
    }
    let bx: u64 = px0 + pw0 - bw - 1
    let by: u64 = py0 + 1
    wlib.draw_board(bx, by, bw, bh, wlib.MR_BUTTON, wlibc.EL_FLAT,
        wlibc.theme(wlibc.C_ACCENT), 0)
    let base: u64 = by + (bh + wlib.draw_ascent(wlibc.TY_CAPTION)) / 2 - 1
    let _e: u64 = text_mit_schild(bx + (bw - tw) / 2, base, dp, dl,
        wlibc.theme(wlibc.C_ON_ACCENT), wlibc.TY_CAPTION,
        wlibc.theme(wlibc.C_ACCENT))
    if report {
        say((&s_bgl[0 as usize]) as u64)
        say(dp)
        say((&s_bgn[0 as usize]) as u64)
        sayn(n)
        say((&s_tX[0 as usize]) as u64)
        sayn(bx)
        say((&s_gy[0 as usize]) as u64)
        sayn(by)
        say((&s_gw[0 as usize]) as u64)
        sayn(bw)
        say((&s_gh[0 as usize]) as u64)
        sayn(bh)
        nl()
    }
}

fn paint_band(y0: u64, hh: u64, report: bool) {
    wlibc.set_band(y0)
    wlibc.clip_set(0, y0, win_w, y0 + hh)
    let gbase: u64 = wlibc.theme(wlibc.C_TASKBAR_BG)
    wlib.draw_area(0, y0, win_w, hh, gbase)
    // the hairline on the side that faces the desktop
    if cf_edge == wlibc.WE_BOTTOM {
        wlib.draw_line(0, 0, win_w, wlibc.theme(wlibc.C_BORDER))
    } else if cf_edge == wlibc.WE_TOP {
        wlib.draw_line(0, win_h - 1, win_w,
            wlibc.theme(wlibc.C_BORDER))
    } else if cf_edge == wlibc.WE_LEFT {
        wlib.draw_area(win_w - 1, y0, 1, hh,
            wlibc.theme(wlibc.C_BORDER))
    } else {
        wlib.draw_area(0, y0, 1, hh,
            wlibc.theme(wlibc.C_BORDER))
    }
    if shown == 0 {
        let _p0: u64 = bar_push(y0, hh)
        ub_px = ub_px + _p0
        ub_soll = ub_soll + win_w * hh
        if _p0 == 0 {
            ub_null = ub_null + 1
        }
        return
    }
    var st_app: [u8; 9] = "launcher\0"
    var ssym: u64 = sym_of((&st_app[0 as usize]) as u64)
    var st_leer: [u8; 2] = "\0\0"
    var st_txt: u64 = txt((&k_start[0 as usize]) as u64,
        (&s_st[0 as usize]) as u64)
    if cf_labels == LB_NEVER {
        st_txt = (&st_leer[0 as usize]) as u64
        ssym = 0
    }
    let rs: u64 = button_sym(st_x, st_y, st_w, st_h,
        st_txt, false, false, 0, ssym)
    if cf_labels == LB_NEVER {
        var gemalt: bool = brand_paint_ok(st_x, st_y, st_w, st_h, report)
        if !gemalt {
            var kante: u64 = st_h - 4
            if kante > st_w - 4 {
                kante = st_w - 4
            }
            let gx: u64 = st_x + (st_w - kante) / 2
            let gy: u64 = st_y + (st_h - kante) / 2
            if glyphs_ok() {
                gemalt = wlibc.icon_at(icons.START, gx, gy, kante,
                    wlibc.theme(wlibc.T_FG))
                if gemalt && report {
                    say((&s_mkv[0 as usize]) as u64)
                    sayn(kante)
                    nl()
                }
            }
        }
    }
    if tv_w != 0 {
        glyph_button(tv_x, tv_y, tv_w, tv_h, icons.TASKVIEW, tv_h - 8)
        if report {
            say((&s_tvl[0 as usize]) as u64)
            sayn(tv_x)
            say((&s_gy[0 as usize]) as u64)
            sayn(tv_y)
            say((&s_gw[0 as usize]) as u64)
            sayn(tv_w)
            say((&s_gh[0 as usize]) as u64)
            sayn(tv_h)
            nl()
        }
    }
    if chv_w != 0 {
        var chcp: u64 = icons.CHEVRON_UP
        if chev_open != 0 {
            chcp = icons.CHEVRON_DOWN
        }
        glyph_button(chv_x, chv_y, chv_w, chv_h, chcp, gl_w())
        if report {
            say((&s_chl[0 as usize]) as u64)
            sayn(chv_x)
            say((&s_gy[0 as usize]) as u64)
            sayn(chv_y)
            say((&s_gw[0 as usize]) as u64)
            sayn(chv_w)
            say((&s_gh[0 as usize]) as u64)
            sayn(chv_h)
            say((&s_opn[0 as usize]) as u64)
            sayn(chev_open)
            nl()
        }
    }
    var pz2: u64 = 0
    while pz2 < npin {
        if pw_[(pz2) as usize] != 0 {
            let pnm: u64 = (&pinname[0 as usize]) as u64 + pz2 * 24
            let psy: u64 = sym_of(pnm)
            let pw2: u64 = pinwin[(pz2) as usize]
            let laeuft: bool = pw2 < MAXK
            var vorn: bool = false
            if laeuft && kfok[(pw2) as usize] != 0 {
                vorn = true
            }
            let prc: u64 = button_sym(px_[(pz2) as usize], py_[(pz2) as usize],
                pw_[(pz2) as usize], ph_[(pz2) as usize],
                (&s_leer[0 as usize]) as u64, vorn, false, 0, psy)
            if laeuft {
                pill(px_[(pz2) as usize], py_[(pz2) as usize],
                    pw_[(pz2) as usize], ph_[(pz2) as usize], vorn)
                group_dashes(kcnt[(pw2) as usize])
                if cf_badge != 0 {
                    let wn: u64 = app_windows(pnm)
                    if wn >= cf_badge {
                        badge_paint(px_[(pz2) as usize], py_[(pz2) as usize],
                            pw_[(pz2) as usize], wn, report)
                    }
                }
            }
            if report {
                say((&s_pin[0 as usize]) as u64)
                say(pnm)
                say((&s_pinx[0 as usize]) as u64)
                sayn(px_[(pz2) as usize])
                say((&s_piny[0 as usize]) as u64)
                sayn(py_[(pz2) as usize])
                say((&s_pinw[0 as usize]) as u64)
                sayn(pw_[(pz2) as usize])
                say((&s_pinh[0 as usize]) as u64)
                sayn(ph_[(pz2) as usize])
                say((&s_pinsy[0 as usize]) as u64)
                if psy != 0 {
                    sayn(1)
                } else {
                    sayn(0)
                }
                say((&s_pinrun[0 as usize]) as u64)
                if laeuft {
                    sayn(1)
                } else {
                    sayn(0)
                }
                nl()
            }
            let _pu: u64 = prc
        }
        pz2 = pz2 + 1
    }
    var i: u64 = 0
    while i < nk {
        if kw[(i) as usize] != 0 {
            let lab: u64 = (&klab[0 as usize]) as u64 + i * 40
            let mk: u64 = mark_icon(knv[(i) as usize])
            let sy: u64 = sym_of((&kapp[0 as usize]) as u64 + i * 24)
            let rc: u64 = button_sym(kx[(i) as usize], ky[(i) as usize],
                kw[(i) as usize], kh[(i) as usize], lab,
                kfok[(i) as usize] != 0, kver[(i) as usize] != 0, mk, sy)
            pill(kx[(i) as usize], ky[(i) as usize], kw[(i) as usize],
                kh[(i) as usize], kfok[(i) as usize] != 0)
            group_dashes(kcnt[(i) as usize])
            if kid[(i) as usize] != 0 {
                let _mr: u64 = wlibc.win_minrect(kid[(i) as usize],
                    bar_x + kx[(i) as usize], bar_y + ky[(i) as usize],
                    kw[(i) as usize], kh[(i) as usize])
            }
            if report && pl_w != 0 {
                say((&s_pil[0 as usize]) as u64)
                sayn(i)
                say((&s_pilx[0 as usize]) as u64)
                sayn(pl_x)
                say((&s_pilw[0 as usize]) as u64)
                sayn(pl_w)
                say((&s_piltx[0 as usize]) as u64)
                sayn(lab_tx)
                say((&s_piltw[0 as usize]) as u64)
                sayn(lab_tw)
                nl()
            }
            if report && sy != 0 {
                say((&s_sy[0 as usize]) as u64)
                sayn(i)
                say((&s_syn[0 as usize]) as u64)
                say((&kapp[0 as usize]) as u64 + i * 24)
                say((&s_syw[0 as usize]) as u64)
                sayn(wlibc.icon_w(sy))
                say((&s_syg[0 as usize]) as u64)
                sayn(sym_w(sy, kh[(i) as usize]))
                say((&s_syk[0 as usize]) as u64)
                sayn(kh[(i) as usize])
                say((&s_syi[0 as usize]) as u64)
                sayn(sym_ink(sy))
                nl()
            }
            if report {
                let bg: u64 = lab_bg
                let fg: u64 = lab_fg
                say((&s_bt[0 as usize]) as u64)
                sayn(i)
                say((&s_bi[0 as usize]) as u64)
                sayn(kid[(i) as usize])
                say((&s_tX[0 as usize]) as u64)
                sayn(kx[(i) as usize])
                say((&s_gy[0 as usize]) as u64)
                sayn(ky[(i) as usize])
                say((&s_gw[0 as usize]) as u64)
                sayn(kw[(i) as usize])
                say((&s_gh[0 as usize]) as u64)
                sayn(kh[(i) as usize])
                say((&s_bv[0 as usize]) as u64)
                sayn(kver[(i) as usize])
                say((&s_bf[0 as usize]) as u64)
                sayn(kfok[(i) as usize])
                say((&s_tt[0 as usize]) as u64)
                say(lab)
                // ROUND NETVIEW, addendum: WHICH mark, and WHERE -- and
                // ONLY when there is one. A picture that is reported but
                // not drawn and a picture that is drawn but not reported
                // both fail in `tools/netview/run.sh`, which reads these
                // numbers and then reads the pixels. But the normal case
                // is `real`, and printing `netv=0` for every window of
                // every repaint is a line about nothing on a line that
                // three programs share.
                if knv[(i) as usize] != 0 {
                    say((&s_bn[0 as usize]) as u64)
                    sayn(knv[(i) as usize])
                    if mk != 0 {
                        say((&s_bmx[0 as usize]) as u64)
                        sayn(mk_x)
                        say((&s_bmy[0 as usize]) as u64)
                        sayn(mk_y)
                    }
                }
                nl()
                say((&s_grp[0 as usize]) as u64)
                sayn(i)
                say((&s_grpn[0 as usize]) as u64)
                sayn(kcnt[(i) as usize])
                nl()
                say_text((&m_btn[0 as usize]) as u64, rc >> 32,
                    rc & 0xFFFFFFFF, fg, bg, lab)
            }
        }
        i = i + 1
    }
    if grp_w != 0 {
        // W-C1: no resting plate behind the symbols (it read as a chip); only the hover plate of Windows 11
        if hot_f <= F_BAT {
            wlib.draw_board(grp_x, st_y, grp_w, btn_h(), wlib.MR_BUTTON,
                wlibc.EL_FLAT, hover_plate(), 0)
        }
        if report {
            say((&s_grl[0 as usize]) as u64)
            sayn(grp_x)
            say((&s_gw[0 as usize]) as u64)
            sayn(grp_w)
            nl()
        }
    }
    var f: u64 = 0
    while f < F_N {
        if f_w[(f) as usize] == 0 {
            f = f + 1
        } else {
        if (grp_w == 0 || f > F_BAT) && hot_f == f {
            wlib.draw_board(f_x[(f) as usize], f_y[(f) as usize],
                f_w[(f) as usize], f_h[(f) as usize], wlib.MR_BUTTON,
                wlibc.EL_FLAT, hover_plate(), 0)
        }
        // ROUND NETVIEW, addendum: the state of the MACHINE, in the
        // corner, where every system has put it for thirty years. It
        // goes in FRONT of the address and not instead of it: the icon
        // says at a glance which of four things is true, the address
        // says which address -- and neither of them replaces the other.
        var icx: u64 = 0
        // W-C1: the language field is the code only -- no keyboard symbol (it stuck to the letters)
        // ROUND LOOK: THE BATTERY GETS A SYMBOL. It never had one -- the
        // percentage came from round K18 and the glyphs from round
        // ICONS, and the two were never joined.
        if f == F_BAT && glyphs_ok() {
            let bid: u64 = bat_icon()
            let bx: u64 = f_x[(f) as usize] + tr_pad()
            let by: u64 = f_y[(f) as usize]
            if wlibc.icon_mid_ink(bid, bx, by, gl_w(), f_h[(f) as usize], gl_w(),
                bat_colour()) {
                icx = tr_icx()
                if report {
                    say((&lk_ic[0 as usize]) as u64)
                    say((&lk_bat[0 as usize]) as u64)
                    say((&lk_id[0 as usize]) as u64)
                    sayn(bid)
                    say((&s_tX[0 as usize]) as u64)
                    sayn(bx)
                    say((&s_gy[0 as usize]) as u64)
                    sayn(by)
                    say((&lk_px[0 as usize]) as u64)
                    sayn(gl_w())
                    say((&lk_ink[0 as usize]) as u64)
                    sayn(wlibc.icon_ink_w(bid, gl_w())
                        * wlibc.icon_ink_h(bid, gl_w()))
                    nl()
                }
            } else if report {
                // A GLYPH THAT IS NOT THERE IS SAID SO. Silence here
                // and a missing picture on screen look the same, and
                // one of them is a defect.
                say((&lk_no[0 as usize]) as u64)
                say((&lk_bat[0 as usize]) as u64)
                nl()
            }
        }
        // ROUND TON-2: THE VOLUME GETS THE SAME TREATMENT AS THE
        // BATTERY -- symbol first, percentage behind it. Built the
        // same way on purpose: two status fields that report
        // differently are two fields a test has to know separately.
        if f == F_SND && glyphs_ok() {
            let vid: u64 = snd_icon()
            let vx: u64 = f_x[(f) as usize] + tr_pad()
            let vy: u64 = f_y[(f) as usize]
            if wlibc.icon_mid_ink(vid, vx, vy, gl_w(), f_h[(f) as usize], gl_w(),
                snd_colour()) {
                icx = tr_icx()
                if report {
                    say((&lk_ic[0 as usize]) as u64)
                    say((&lk_snd[0 as usize]) as u64)
                    say((&lk_id[0 as usize]) as u64)
                    sayn(vid)
                    say((&s_tX[0 as usize]) as u64)
                    sayn(vx)
                    say((&s_gy[0 as usize]) as u64)
                    sayn(vy)
                    say((&lk_px[0 as usize]) as u64)
                    sayn(gl_w())
                    say((&lk_ink[0 as usize]) as u64)
                    sayn(wlibc.icon_ink_w(vid, gl_w())
                        * wlibc.icon_ink_h(vid, gl_w()))
                    nl()
                }
            } else if report {
                say((&lk_no[0 as usize]) as u64)
                say((&lk_snd[0 as usize]) as u64)
                nl()
            }
        }
        if f == F_NET {
            // SECOND ADDENDUM, and the ORDER is the argument: the
            // faking sign comes FIRST, before the state of the machine.
            // What is read first is what is read at all, and "this
            // system is telling programs a story" is the more important
            // of the two sentences -- especially in the one case that
            // needs it, `always` on a machine that is genuinely online,
            // where the state icon on its own would be true and
            // misleading at once.
            let sy: u64 = sys_icon()
            if sy != 0 {
                let _s: bool = wlibc.icon_draw(sy, f_x[(f) as usize] + 2,
                    f_y[(f) as usize] + (f_h[(f) as usize] - mk_w()) / 2)
                icx = mk_w() + 2
                if report && nv_faking != fk_said {
                    fk_said = nv_faking
                    say((&s_fk[0 as usize]) as u64)
                    sayn(nv_fall)
                    say((&s_tX[0 as usize]) as u64)
                    sayn(f_x[(f) as usize] + 2)
                    say((&s_gy[0 as usize]) as u64)
                    sayn(f_y[(f) as usize]
                        + (f_h[(f) as usize] - mk_w()) / 2)
                    nl()
                }
            } else if report && nv_faking != fk_said {
                fk_said = nv_faking
                say((&s_fkno[0 as usize]) as u64)
                sayn(nv_fall)
                nl()
            }
            let ic: u64 = net_pic()
            if ic == 0 && glyphs_ok() {
                // ROUND LOOK: no OSYM file on this disk, but there is an
                // icon font. Same four states, same place, same room.
                let nid: u64 = net_glyph(net_state)
                let nx: u64 = f_x[(f) as usize] + tr_pad() + icx
                let ny: u64 = f_y[(f) as usize]
                if wlibc.icon_mid_ink(nid, nx, ny, gl_w(), f_h[(f) as usize], gl_w(),
                    net_colour(net_state)) {
                    icx = icx + tr_icx()
                    if report {
                        say((&lk_ic[0 as usize]) as u64)
                        say((&lk_net[0 as usize]) as u64)
                        say((&lk_id[0 as usize]) as u64)
                        sayn(nid)
                        say((&s_tX[0 as usize]) as u64)
                        sayn(nx)
                        say((&s_gy[0 as usize]) as u64)
                        sayn(ny)
                        say((&lk_px[0 as usize]) as u64)
                        sayn(gl_w())
                        say((&lk_ink[0 as usize]) as u64)
                        sayn(wlibc.icon_ink_w(nid, gl_w())
                            * wlibc.icon_ink_h(nid, gl_w()))
                        say((&lk_st[0 as usize]) as u64)
                        sayn(net_state)
                        nl()
                    }
                } else if report {
                    say((&lk_no[0 as usize]) as u64)
                    say((&lk_net[0 as usize]) as u64)
                    nl()
                }
            }
            if ic != 0 {
                let ix: u64 = f_x[(f) as usize] + 2 + icx
                let ihh: u64 = wlibc.icon_ink_hgt(ic)
                let itop: u64 = wlibc.icon_ink_top(ic)
                var icy: u64 = f_y[(f) as usize]
                if f_h[(f) as usize] > ihh {
                    icy = f_y[(f) as usize]
                        + (f_h[(f) as usize] - ihh) / 2
                }
                if icy >= itop {
                    icy = icy - itop
                } else {
                    icy = f_y[(f) as usize]
                }
                let ilf: u64 = wlibc.icon_ink_lft(ic)
                var ixx: u64 = ix
                if ixx >= ilf {
                    ixx = ixx - ilf
                }
                let _i: bool = wlibc.icon_draw(ic, ixx, icy)
                var iwd: u64 = wlibc.icon_ink_wid(ic)
                if iwd == 0 {
                    iwd = wlibc.icon_draw_w(ic)
                }
                icx = icx + iwd + 2
                if report && net_state != st_said {
                    st_said = net_state
                    say((&s_ic[0 as usize]) as u64)
                    sayn(net_state)
                    say((&s_tX[0 as usize]) as u64)
                    sayn(ix)
                    say((&s_gy[0 as usize]) as u64)
                    sayn(icy)
                    say((&lk_px[0 as usize]) as u64)
                    sayn(ihh)
                    nl()
                }
            }
        }
        var l: u64 = 0
        while l < f_lines[(f) as usize] {
            let p: u64 = line_of(f, l)
            let n: u64 = tlen(p)
            var tx: u64 = f_x[(f) as usize] + 4 + icx
            var base: u64 = f_y[(f) as usize] + (f_h[(f) as usize] + asc) / 2 - 1
            // r1015: the two clock lines end on the same right edge like in Windows 11 ("14:41" over
            // "17.10.2026", both right-aligned), not on the same left edge.
            if (f == F_CLK || f == F_LANG) && icx == 0 {
                // W-C1: the cell is measured text + 2 * fld_pad: the two-line clock is right-aligned at the
                // pad (time over date), the language code and a one-line clock stand in the middle
                let lw: u64 = width_of(p)
                if f == F_CLK && f_lines[(f) as usize] > 1 {
                    if f_w[(f) as usize] >= lw + fld_pad() {
                        tx = f_x[(f) as usize] + f_w[(f) as usize] - fld_pad() - lw
                    }
                } else if f_w[(f) as usize] > lw {
                    tx = f_x[(f) as usize] + (f_w[(f) as usize] - lw) / 2
                }
            }
            if f_lines[(f) as usize] > 1 {
                let blk: u64 = f_lines[(f) as usize] * line_h()
                var voben: u64 = 2
                if f_h[(f) as usize] > blk {
                    voben = (f_h[(f) as usize] - blk) / 2
                }
                base = f_y[(f) as usize] + voben + asc + l * line_h()
            }
            var tfg: u64 = wlibc.theme(wlibc.T_FG)
            var tbg: u64 = wlibc.theme(wlibc.C_TASKBAR_BG)
            if f == F_REM {
                // red text on the normal plate (the plate colour is the
                // material's, draw_board does not take it for buttons)
                tfg = wlibc.theme(wlibc.C_DANGER)
            }
            schild_tray = 1
            let _e: u64 = text_mit_schild(tx, base, p, n, tfg, wlibc.TY_BODY, tbg)
            schild_tray = 0
            if report {
                var mark: u64 = (&m_net[0 as usize]) as u64
                if f == F_BAT {
                    mark = (&m_bat[0 as usize]) as u64
                } else if f == F_CLK {
                    mark = (&m_clk[0 as usize]) as u64
                } else if f == F_NOTI {
                    mark = (&m_noti[0 as usize]) as u64
                } else if f == F_LANG {
                    mark = (&m_lang[0 as usize]) as u64
                } else if f == F_REM {
                    mark = (&m_rem[0 as usize]) as u64
                } else if f == F_SND {
                    mark = (&m_snd[0 as usize]) as u64
                }
                // r1130: report the colours the text was PAINTED with (tfg on tbg = the bar), not T_PANEL: the tray texts sit on the bar
                // colour (opaque with transparency=off), and tools/desktop recomputes every glyph against exactly these two colours
                say_text(mark, tx, base, tfg, tbg, p)
            }
            l = l + 1
        }
        if report {
            var mark: u64 = (&m_net[0 as usize]) as u64
            if f == F_BAT {
                mark = (&m_bat[0 as usize]) as u64
            } else if f == F_CLK {
                mark = (&m_clk[0 as usize]) as u64
            } else if f == F_NOTI {
                mark = (&m_noti[0 as usize]) as u64
            } else if f == F_LANG {
                mark = (&m_lang[0 as usize]) as u64
            } else if f == F_REM {
                mark = (&m_rem[0 as usize]) as u64
            } else if f == F_SND {
                mark = (&m_snd[0 as usize]) as u64
            }
            say((&s_fl[0 as usize]) as u64)
            say(mark)
            say((&s_tX[0 as usize]) as u64)
            sayn(f_x[(f) as usize])
            say((&s_gy[0 as usize]) as u64)
            sayn(f_y[(f) as usize])
            say((&s_gw[0 as usize]) as u64)
            sayn(f_w[(f) as usize])
            say((&s_gh[0 as usize]) as u64)
            sayn(f_h[(f) as usize])
            say((&s_fn[0 as usize]) as u64)
            sayn(f_lines[(f) as usize])
            // W-C1: the measured width of the widest line, so a gate can check text <= cell
            var tmw: u64 = 0
            var tl: u64 = 0
            while tl < f_lines[(f) as usize] {
                let tl_w: u64 = width_of(line_of(f, tl))
                if tl_w > tmw {
                    tmw = tl_w
                }
                tl = tl + 1
            }
            say((&s_ftw[0 as usize]) as u64)
            sayn(tmw)
            nl()
        }
        f = f + 1
        }
    }
    var pb: u64 = 0
    while pb < PB_MAX {
        if pb_w[(pb) as usize] == 0 {
            pb = pb + 1
        } else {
        let pp: u64 = plug_text(pb)
        var pn: u64 = tlen(pp)
        wlib.draw_board(pb_x[(pb) as usize], pb_y[(pb) as usize],
            pb_w[(pb) as usize], pb_h[(pb) as usize], wlib.MR_BUTTON,
            wlibc.EL_FLAT, schild_grund(wlibc.theme(wlibc.T_PANEL)), 0)
        while pn > 1 && wlibc.text_w(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY), pp, pn)
            + 10 > pb_w[(pb) as usize] {
            pn = pn - 1
        }
        let ptx: u64 = pb_x[(pb) as usize] + 5
        let pbase: u64 = pb_y[(pb) as usize]
            + (pb_h[(pb) as usize] + asc) / 2 - 1
        let _pe: u64 = wlib.draw_text(ptx, pbase, pp, pn,
            wlibc.theme(wlibc.T_FG), wlibc.TY_BODY)
        if report {
            say((&s_pl[0 as usize]) as u64)
            sayn(pb)
            say((&s_tX[0 as usize]) as u64)
            sayn(pb_x[(pb) as usize])
            say((&s_gy[0 as usize]) as u64)
            sayn(pb_y[(pb) as usize])
            say((&s_gw[0 as usize]) as u64)
            sayn(pb_w[(pb) as usize])
            say((&s_gh[0 as usize]) as u64)
            sayn(pb_h[(pb) as usize])
            nl()
            say_text((&m_plug[0 as usize]) as u64, ptx, pbase,
                wlibc.theme(wlibc.T_FG), wlibc.theme(wlibc.T_PANEL), pp)
        }
        pb = pb + 1
        }
    }
    // ROUND NETVIEW, addendum: WHAT THE POINTER IS RESTING ON, as a
    // sentence, in the empty space between the last window button and
    // the first status field. There is no tooltip window in this system
    // and a bar 28 pixels high cannot open one; this is the room there
    // is, and an icon nobody can look up is a rune.
    if hover_on != 0 && vertical == 0 {
        let hb: u64 = hover_left()
        let he: u64 = hover_right()
        if he > hb + 20 {
            wlibc.clip_set(hb, y0, he, y0 + hh)
            wlib.draw_board(hb, st_y, he - hb, btn_h(),
                wlib.MR_BUTTON, wlibc.EL_FLAT,
                schild_grund(wlibc.theme(wlibc.T_PANEL)), 0)
            let hp: u64 = (&hover_txt[0 as usize]) as u64
            var hn: u64 = tlen(hp)
            while hn > 1 && wlibc.text_w(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY), hp, hn)
                + 6 > he - hb {
                hn = hn - 1
            }
            let hbase: u64 = st_y + (btn_h() + asc) / 2 - 1
            let _h: u64 = wlib.draw_text(hb + 3, hbase, hp, hn,
                wlibc.theme(wlibc.T_DIM), wlibc.TY_BODY)
            wlibc.clip_set(0, y0, win_w, y0 + hh)
            if report {
                say((&s_hv[0 as usize]) as u64)
                say((&s_tX[0 as usize]) as u64)
                sayn(hb + 3)
                say((&s_tb[0 as usize]) as u64)
                sayn(hbase)
                say((&s_tt[0 as usize]) as u64)
                put_n(hp, hn)
                nl()
            }
        }
    }
    let _p: u64 = bar_push(y0, hh)
    ub_px = ub_px + _p
    ub_soll = ub_soll + win_w * hh
    if _p == 0 {
        ub_null = ub_null + 1
    }
    if report {
        // ROUND LOOK: the RECTANGLE, not only the word inside it.
        say((&lk_sx[0 as usize]) as u64)
        sayn(st_x)
        say((&lk_sy[0 as usize]) as u64)
        sayn(st_y)
        say((&lk_sw[0 as usize]) as u64)
        sayn(st_w)
        say((&lk_sh[0 as usize]) as u64)
        sayn(st_h)
        say((&lk_sg[0 as usize]) as u64)
        say(align_name(cf_align))
        nl()
        say_text((&m_start[0 as usize]) as u64, rs >> 32,
            rs & 0xFFFFFFFF, wlibc.theme(wlibc.T_FG),
            wlibc.theme(wlibc.C_BUTTON_FACE), st_txt)
    }
}

// THE WHOLE BAR, BAND BY BAND. The drawing surface of the widget
// library is 800 x 81 pixels; a horizontal bar is one band, a vertical
// one is eight. Everything is clipped to the band, so each band paints
// only what falls into it -- and the report is written in the FIRST
// band only, because it describes the layout and not the band.
fn paint(report: bool) {
    var y: u64 = 0
    var first: bool = true
    //     1920 -> 136      2560 -> 102      3440 -> 76      3840 -> 68
    var band: u64 = BAND
    let tragf: u64 = wlibc.surf_rows()
    if tragf != 0 && tragf < band {
        band = tragf
    }
    while y < win_h {
        var hh: u64 = band
        if y + hh > win_h {
            hh = win_h - y
        }
        paint_band(y, hh, report && first)
        first = false
        y = y + hh
    }
    bar_sync()
    paints = paints + 1
    if report {
        schild_say()
    }
    schild_n = 0
}

// ============================================================ the drag
//
// WHY THE POINTER IS POLLED AND NOT AWAITED. A window is only told
// about the pointer while the pointer is INSIDE it (kernel/wm.fi,
// `on_mouse`). A drag from the bottom edge to the left edge leaves the
// bar after four pixels and the button is let go on the other side of
// the screen, where no event of ours will ever be raised. So the bar
// asks for the position and the buttons directly (`WIG_SCREEN`), forty
// times a second, for as long as the drag lasts -- and for no longer.

static mut s_d0: [u8; 21] = "taskbar: drag start \0"
static mut s_d1: [u8; 20] = "taskbar: drag edge=\0"
static mut s_d2: [u8; 20] = "taskbar: drag done \0"
static mut s_wr: [u8; 10] = " written=\0"
static mut s_pv: [u8; 9] = "preview\0\0"

fn close_preview() {
    var i: u64 = 0
    while i < 4 {
        if prev_h[(i) as usize] != 0 {
            let _c: u64 = wlibc.sys3w(wlibc.WM_CLOSE, prev_h[(i) as usize],
                0, 0)
            prev_h[(i) as usize] = 0
        }
        i = i + 1
    }
    prev_on = 0
    prev_edge = 9
}

// ONE THIN ALWAYS-ON-TOP WINDOW. Four of them make the outline.
fn preview_win(x: u64, y: u64, w: u64, h: u64) -> u64 {
    let hd: u64 = wlibc.sys5(wlibc.WM_CREATE, (x << 16) | y,
        (w << 16) | h, (&s_pv[0 as usize]) as u64, 0, 0)
    if ulib.bad(hd) || hd == 0 {
        return 0
    }
    let _d: u64 = wlibc.win_state(hd, wlibc.WS_DECO, 0)
    let _l: u64 = wlibc.win_state(hd, wlibc.WS_LAYER, wlibc.L_TOP)
    let _f: u64 = wlibc.sys5(wlibc.WM_FILL, hd, 0, (w << 16) | h,
        wlibc.theme(wlibc.T_SEL), 0)
    let _u: u64 = wlibc.sys3w(wlibc.WM_FLUSH, hd, 0, 0)
    return hd
}

// THE PREVIEW RECTANGLE FOR AN EDGE. Four thin windows and not one
// filled sheet: a filled 128 x 600 window costs 300 kilooctets of
// buffer, and this process has 832 for the bar, the preview and the
// drawing surface together. An outline is 34.
fn preview_show(edge: u64) {
    if prev_on != 0 && prev_edge == edge {
        return
    }
    close_preview()
    rect_for(edge, thickness_of(edge))
    let x: u64 = r_x
    let y: u64 = r_y
    let w: u64 = r_w
    let h: u64 = r_h
    prev_h[(0) as usize] = preview_win(x, y, w, PREV_T)
    prev_h[(1) as usize] = preview_win(x, y + h - PREV_T, w, PREV_T)
    prev_h[(2) as usize] = preview_win(x, y, PREV_T, h)
    prev_h[(3) as usize] = preview_win(x + w - PREV_T, y, PREV_T, h)
    prev_on = 1
    prev_edge = edge
    say((&s_d1[0 as usize]) as u64)
    sayn(edge)
    say((&s_gx[0 as usize]) as u64)
    sayn(x)
    say((&s_gy[0 as usize]) as u64)
    sayn(y)
    say((&s_gw[0 as usize]) as u64)
    sayn(w)
    say((&s_gh[0 as usize]) as u64)
    sayn(h)
    nl()
}

// THE NEAREST EDGE TO A POINT. Plain distance to the four sides; the
// same rule Windows 10 used, and the reason a drag towards a corner
// picks the side you were heading for and not the one you started on.
fn nearest_edge(mx0: u64, my0: u64) -> u64 {
    // r828: relative to this bar's head (a pointer on another head counts as that head's edge)
    var mx: u64 = 0
    var my: u64 = 0
    if mx0 > hx {
        mx = mx0 - hx
    }
    if my0 > hy {
        my = my0 - hy
    }
    if mx > sw - 1 {
        mx = sw - 1
    }
    if my > sh - 1 {
        my = sh - 1
    }
    var best: u64 = wlibc.WE_LEFT
    var d: u64 = mx
    if sw - 1 - mx < d {
        d = sw - 1 - mx
        best = wlibc.WE_RIGHT
    }
    if my < d {
        d = my
        best = wlibc.WE_TOP
    }
    if sh - 1 - my < d {
        d = sh - 1 - my
        best = wlibc.WE_BOTTOM
    }
    return best
}

fn pin_under(x: u64, y: u64) -> u64 {
    var k: u64 = 0
    while k < npin {
        if pw_[(k) as usize] != 0
            && x >= px_[(k) as usize]
            && x < px_[(k) as usize] + pw_[(k) as usize]
            && y >= py_[(k) as usize]
            && y < py_[(k) as usize] + ph_[(k) as usize] {
            return k
        }
        k = k + 1
    }
    return npin
}

fn pin_target(mx: u64) -> u64 {
    if npin == 0 {
        return 0
    }
    let br: u64 = pw_[(0) as usize] + gap()
    let links: u64 = px_[(0) as usize]
    if mx < links {
        return 0
    }
    var k: u64 = 0
    while k < npin {
        let mitte: u64 = links + k * br + br / 2
        if mx < mitte {
            return k
        }
        k = k + 1
    }
    return npin - 1
}

fn pin_umhaengen(von: u64, move_to: u64) {
    if von == move_to || von >= npin || move_to >= npin {
        return
    }
    var tmp: [u8; 24] = [0 as u8; 24]
    let qp: u64 = (&pinname[0 as usize]) as u64 + von * 24
    var k: u64 = 0
    while k < 24 {
        tmp[(k) as usize] = *((qp + k) as *mut u8)
        k = k + 1
    }
    if move_to > von {
        var i2: u64 = von
        while i2 < move_to {
            let a2: u64 = (&pinname[0 as usize]) as u64 + i2 * 24
            let b2: u64 = a2 + 24
            k = 0
            while k < 24 {
                __mmio_write8((a2 + k) as *mut u8,
                    *((b2 + k) as *mut u8))
                k = k + 1
            }
            i2 = i2 + 1
        }
    } else {
        var i3: u64 = von
        while i3 > move_to {
            let a3: u64 = (&pinname[0 as usize]) as u64 + i3 * 24
            let b3: u64 = a3 - 24
            k = 0
            while k < 24 {
                __mmio_write8((a3 + k) as *mut u8,
                    *((b3 + k) as *mut u8))
                k = k + 1
            }
            i3 = i3 - 1
        }
    }
    let zp: u64 = (&pinname[0 as usize]) as u64 + move_to * 24
    k = 0
    while k < 24 {
        __mmio_write8((zp + k) as *mut u8, tmp[(k) as usize])
        k = k + 1
    }
}

fn pin_drag_step() {
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    let los: bool = (wlibc.mouse_btn() & 1) == 0
    if pdrag == 1 {
        var d: u64 = 0
        if mx > pdrag_x0 {
            d = mx - pdrag_x0
        } else {
            d = pdrag_x0 - mx
        }
        if los {
            pdrag = 0
            click(pdrag_x0, pdrag_y0)
            return
        }
        if d >= PDRAG_SCHWELLE * wlibc.ui_scale() {
            pdrag = 2
            pdrag_ziel = pdrag_i
            say((&s_pd0[0 as usize]) as u64)
            say((&pinname[0 as usize]) as u64 + pdrag_i * 24)
            say((&s_pdd[0 as usize]) as u64)
            sayn(d)
            nl()
        }
        return
    }
    let z: u64 = pin_target(mx)
    if z != pdrag_ziel {
        pdrag_ziel = z
        pin_umhaengen(pdrag_i, z)
        pdrag_i = z
        let _l: bool = list_read()
        layout()
        paint(true)
        say((&s_pdm[0 as usize]) as u64)
        sayn(z)
        nl()
    }
    if los {
        pdrag = 0
        var ok: u64 = 0
        if conf_write() {
            ok = 1
        }
        say((&s_pd1[0 as usize]) as u64)
        var q: u64 = 0
        while q < npin {
            if q > 0 {
                say((&s_komma[0 as usize]) as u64)
            }
            say((&pinname[0 as usize]) as u64 + q * 24)
            q = q + 1
        }
        say((&s_wr[0 as usize]) as u64)
        sayn(ok)
        nl()
        let _l2: bool = list_read()
        layout()
        paint(true)
    }
    let _my: u64 = my
}

fn drag_step() {
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    let e: u64 = nearest_edge(mx, my)
    drag_edge = e
    preview_show(e)
    if (wlibc.mouse_btn() & 1) == 0 {
        // let go: this is where the edge really changes.
        dragging = 0
        close_preview()
        var written: u64 = 0
        if e != cf_edge {
            cf_edge = e
            if conf_write() {
                written = 1
            }
            geometry()
            apply()
            let _l: bool = list_read()
            layout()
            paint(true)
            geom_say()
        }
        say((&s_d2[0 as usize]) as u64)
        say((&s_ed[0 as usize]) as u64)
        sayn(e)
        say((&s_wr[0 as usize]) as u64)
        sayn(written)
        nl()
    }
}

// ======================================================== the auto-hide

static mut s_hd: [u8; 14] = "taskbar: hide\0"
static mut s_sh2: [u8; 14] = "taskbar: show\0"
static mut s_ms: [u8; 5] = " ms=\0"

fn touches_edge(mx0: u64, my0: u64) -> bool {
    // r828: the edge of THIS head -- a pointer on another head, or outside it, never reveals this bar
    if mx0 < hx || my0 < hy || mx0 >= hx + sw || my0 >= hy + sh {
        return false
    }
    let mx: u64 = mx0 - hx
    let my: u64 = my0 - hy
    if cf_edge == wlibc.WE_BOTTOM {
        return my + 1 + REVEAL >= sh
    }
    if cf_edge == wlibc.WE_TOP {
        return my <= REVEAL
    }
    if cf_edge == wlibc.WE_LEFT {
        return mx <= REVEAL
    }
    return mx + 1 + REVEAL >= sw
}

fn inside_bar(mx: u64, my: u64) -> bool {
    return mx >= bar_x && mx < bar_x + bar_w
        && my >= bar_y && my < bar_y + bar_h
}

// PULL IT IN, LET IT OUT. The measurement the runner takes is the time
// between the pointer REACHING the edge and the bar STANDING there --
// `hide_t0` is stamped at the first poll that saw the pointer on the
// edge, the second stamp is taken after the repaint. Ticks are 10
// milliseconds in this kernel (`kernel/time.fi`, TICK_HZ = 100), so
// that is the resolution of the number and not a millisecond.
fn autohide_step() {
    if cf_autohide == 0 {
        return
    }
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    if shown == 0 {
        if touches_edge(mx, my) {
            if hide_t0 == 0 {
                hide_t0 = ticks()
            }
            shown = 1
            apply()
            layout()
            // PAINTED, NOT REPORTED, and the stopwatch stops here. The
            // first version reported the whole layout inside this paint
            // and measured 230 ms -- most of which was the serial line,
            // not the bar. What is timed is the work the user waits
            // for: resize, move, reserve, draw. The layout is reported
            // afterwards, outside the measurement.
            paint(false)
            let t1: u64 = ticks()
            say((&s_sh2[0 as usize]) as u64)
            say((&s_ms[0 as usize]) as u64)
            sayn((t1 - hide_t0) * 10)
            nl()
            hide_t0 = 0
            paint(true)
        }
        return
    }
    if dragging != 0 {
        return
    }
    if !inside_bar(mx, my) {
        shown = 0
        apply()
        paint(false)
        say((&s_hd[0 as usize]) as u64)
        nl()
    }
}

// ============================================================== clicks

static mut s_cl: [u8; 18] = "taskbar: click x=\0"
static mut s_cy: [u8; 4] = " y=\0"
static mut s_ct: [u8; 8] = " hits=\0\0"
static mut s_act: [u8; 17] = "taskbar: act id=\0"
static mut s_aw: [u8; 6] = " was=\0"
static mut s_sp: [u8; 23] = "taskbar: launcher pid=\0"
static mut p_start: [u8; 14] = "/bin/launcher\0"
static mut z_start: [u8; 6] = "start\0"
static mut z_task: [u8; 7] = "window\0"
static mut z_none: [u8; 5] = "none\0"
static mut z_qs: [u8; 6] = "quick\0"
static mut s_noqs: [u8; 28] = "taskbar: no quick settings\0\0"

static mut menue_pid: u64 = 0

// ===================================================== RUNDE TUERSCHLOSS
fn launcher_window() -> u64 {
    var slot: u64 = 0
    while slot < 32 {
        let r: u64 = wlibc.win_list(slot, (&rec[0 as usize]) as u64)
        if ulib.bad(r) {
            return 0
        }
        if r == 1 {
            let b: u64 = (&rec[0 as usize]) as u64
            if ulib.streq(b + wlibc.WL_APP,
                (&a_launcher[0 as usize]) as u64) {
                let fl: u64 = __mmio_read64((b + wlibc.WL_FLAGS) as *mut u64)
                let id: u64 = __mmio_read64((b + wlibc.WL_ID) as *mut u64)
                menue_war_offen = 1
                if (fl & wlibc.F_HIDDEN) != 0 {
                    menue_war_offen = 0
                }
                let _fo: u64 = __mmio_read64((b + wlibc.WL_FOCUS) as *mut u64)
                return id
            }
        }
        slot = slot + 1
    }
    return 0
}

static mut a_launcher: [u8; 9] = "launcher\0"
static mut s_tog: [u8; 24] = "taskbar: startmenue zu\0\0"
static mut s_tog_auf: [u8; 25] = "taskbar: startmenue auf\0\0"
static mut s_tog_bad: [u8; 31] = "taskbar: startmenue FEHLER rc=\0"
static mut menue_war_offen: u64 = 0

static mut hk_gesehen: u64 = 0
static mut hk_erst: u64 = 1

// Gemessen am fertigen Abbild (UEFI, xHCI-Tastatur, 3440x1440):
//
//     hk: super allein
//     hk: super allein
static mut hk_sagte: u64 = 0

// ==================================================== RUNDE ECHTHARDWARE-2
fn hover_brand(x: u64, y: u64) -> u64 {
    if x >= st_x && x < st_x + st_w && y >= st_y && y < st_y + st_h {
        return 900
    }
    if f_w[(F_NET) as usize] != 0
        && x >= f_x[(F_NET) as usize]
        && x < f_x[(F_NET) as usize] + f_w[(F_NET) as usize]
        && y >= f_y[(F_NET) as usize]
        && y < f_y[(F_NET) as usize] + f_h[(F_NET) as usize] {
        return 901
    }
    if f_w[(F_CLK) as usize] != 0
        && x >= f_x[(F_CLK) as usize]
        && x < f_x[(F_CLK) as usize] + f_w[(F_CLK) as usize]
        && y >= f_y[(F_CLK) as usize]
        && y < f_y[(F_CLK) as usize] + f_h[(F_CLK) as usize] {
        return 902
    }
    if bat_have != 0 && f_w[(F_BAT) as usize] != 0
        && x >= f_x[(F_BAT) as usize]
        && x < f_x[(F_BAT) as usize] + f_w[(F_BAT) as usize]
        && y >= f_y[(F_BAT) as usize]
        && y < f_y[(F_BAT) as usize] + f_h[(F_BAT) as usize] {
        return 903
    }
    var i: u64 = 0
    while i < nk {
        if kver[(i) as usize] == 0
            && x >= kx[(i) as usize]
            && x < kx[(i) as usize] + kw[(i) as usize]
            && y >= ky[(i) as usize]
            && y < ky[(i) as usize] + kh[(i) as usize] {
            return i + 1
        }
        i = i + 1
    }
    return 0
}

fn hover_text(m: u64) -> u64 {
    if m == 900 {
        return msg.get((&k_start[0 as usize]) as u64)
    }
    if m == 901 {
        return full_of(F_NET)
    }
    if m == 902 {
        return full_of(F_CLK)
    }
    if m == 903 {
        // r782: "Akku 77 %, wird geladen" etc. out of the same model as the glyph
        tray_texts_sync()
        var bat_ok: u64 = 1
        if bat_unknown != 0 {
            bat_ok = 0
        }
        let _n: u64 = traypower.tooltip_valid(bat_have, bat_ok, bat_pct, bat_chg, bat_ac,
            (&bat_tip[0 as usize]) as u64, 96)
        return (&bat_tip[0 as usize]) as u64
    }
    if m >= 1 && m <= nk {
        return (&ktit[0 as usize]) as u64 + (m - 1) * 40
    }
    return 0
}

static mut angeheftet: [u64; 16] = [0 as u64; 16]

static mut s_ctxpin: [u8; 24] = "taskbar: pin neu starte\0"
static mut s_ctxauf: [u8; 22] = "taskbar: kontext btn=\0"
static mut s_ctxtat: [u8; 20] = "taskbar: kontext w=\0"
static mut s_ctxfail: [u8; 30] = "taskbar: kontext leer fail c=\0"
static mut s_ctxfm: [u8; 4] = " m=\0"
static mut s_ctxfn: [u8; 4] = " n=\0"
static mut s_ctxleer: [u8; 24] = "taskbar: kontext leer\0\0\0"
static mut s_ctxleert: [u8; 27] = "taskbar: kontext leer w=\0\0\0"
static mut s_cx: [u8; 4] = " x=\0"
static mut s_cy2: [u8; 4] = " y=\0"
static mut s_cw: [u8; 4] = " w=\0"
static mut s_ch: [u8; 4] = " h=\0"
static mut s_cn: [u8; 4] = " n=\0"

// Right click in the bar. The menus themselves (rows, labels, life cycle) are in taskbar_ctx.fi / ctxreg.fi; this only decides
// WHICH context is meant: a pin, a window button or the empty part of the bar.
fn rechtsklick(x: u64, y: u64) {
    // r529: right click on a pin: "New window" (a second terminal, a second explorer ...)
    let pg: u64 = pin_under(x, y)
    if pg < npin {
        tip_close()
        let _mp: bool = taskbar_ctx.open_pin(pg)
        return
    }
    let m: u64 = hover_brand(x, y)
    tip_close()
    if m < 1 || m > nk {
        if taskbar_ctx.open_empty() {
            // the menu rectangle goes into the line (tools/barctx clicks the rows from it)
            let mw: u64 = taskbar_ctx.win()
            say((&s_ctxleer[0 as usize]) as u64)
            say((&s_cx[0 as usize]) as u64)
            sayn(wlib.win_x(mw))
            say((&s_cy2[0 as usize]) as u64)
            sayn(wlib.win_y(mw))
            say((&s_cw[0 as usize]) as u64)
            sayn(wlib.win_w(mw))
            say((&s_ch[0 as usize]) as u64)
            sayn(wlib.win_h(mw))
            say((&s_cn[0 as usize]) as u64)
            sayn(taskbar_ctx.rows())
            nl()
        } else {
            say((&s_ctxfail[0 as usize]) as u64)
            sayn(taskbar_ctx.win())
            say((&s_ctxfm[0 as usize]) as u64)
            sayn(wlib.menu_win())
            say((&s_ctxfn[0 as usize]) as u64)
            sayn(wlib.win_count())
            nl()
        }
        return
    }
    if taskbar_ctx.open_button(m) {
        say((&s_ctxauf[0 as usize]) as u64)
        sayn(m)
        nl()
    }
}

fn tb_key(c: u64) {
    taskbar_ctx.key(c)
}

// What was chosen, once per round (the menu's own event loop is `taskbar_ctx.step`).
fn kontext_step() {
    if !taskbar_ctx.is_open() {
        return
    }
    let a: u64 = taskbar_ctx.step()
    if a == taskbar_ctx.NONE || a == taskbar_ctx.DISMISSED {
        return
    }
    let ctx: u64 = taskbar_ctx.picked_ctx()
    let arg: u64 = taskbar_ctx.picked_arg()
    if ctx == ctxreg.CTX_TASKBAR_PIN {
        if a == taskbar_ctx.ACT_NEW_WINDOW && arg < npin {
            pin_exec(arg)
            say((&s_ctxpin[0 as usize]) as u64)
            nl()
        } else {
            let _c: bool = taskbar_ctx.run_common(a)
        }
        return
    }
    if ctx == ctxreg.CTX_WINDOW_BTN {
        let i: u64 = arg - 1
        if i >= nk {
            return
        }
        if a == taskbar_ctx.ACT_NEW_WINDOW {
            // NEW WINDOW of the program of this button (jump list); nothing to start when the program names no bundle
            if kapp[((i * 24)) as usize] != 0 as u8 {
                app_exec((&kapp[0 as usize]) as u64 + i * 24)
            }
        } else if a == taskbar_ctx.ACT_MINIMISE {
            let _a: u64 = wlibc.win_act(knv[(i) as usize], wlibc.WA_HIDE)
        } else if a == taskbar_ctx.ACT_PIN {
            // the button stays when the window goes
            angeheftet[(i) as usize] = 1
        } else {
            let _c: bool = taskbar_ctx.run_common(a)
            return
        }
        say((&s_ctxtat[0 as usize]) as u64)
        sayn(a)
        nl()
        return
    }
    // empty bar
    if taskbar_ctx.run_common(a) {
        say((&s_ctxleert[0 as usize]) as u64)
        sayn(a)
        nl()
    }
}

// ==================================================== RUNDE ECHTHARDWARE-2
const TIP_TICKS: u64 = 50 // 500 ms bei 100 Hz

static mut tp_win: u64 = 0xFFFFFFFFFFFFFFFF
static mut tp_was: u64 = 0
static mut tp_seit: u64 = 0 // seit wann, in Schlaegen
static mut tp_zahl: u64 = 0

static mut s_tip: [u8; 12] = "wlib: tip [\0"
static mut s_tipx: [u8; 7] = "] x=\0\0\0"
static mut s_tipy: [u8; 5] = " y=\0\0"
static mut s_tipn: [u8; 5] = " n=\0\0"
static mut s_tipw: [u8; 5] = " w=\0\0"
static mut s_tiph: [u8; 5] = " h=\0\0"
static mut s_tipzu: [u8; 15] = "wlib: tip zu\0\0\0"
static mut s_nonc: [u8; 24] = "taskbar: no notifc host\0"
static mut s_nofo: [u8; 23] = "taskbar: no fpsov host\0"
static mut s_nobp: [u8; 31] = "taskbar: no tooltip/toast host\0"
static mut s_tipvoll: [u8; 21] = "wlib: tip kein Platz\0"

fn tip_open_is() -> bool {
    return tp_win != 0xFFFFFFFFFFFFFFFF
}

fn tip_close() {
    if tp_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    tp_win = 0xFFFFFFFFFFFFFFFF
    barpop.tip_hide()
    say((&s_tipzu[0 as usize]) as u64)
    nl()
}

fn tip_open(text: u64, sx: u64, sy: u64) {
    if text == 0 || tlen(text) == 0 {
        return
    }
    tip_close()
    let n: u64 = tlen(text)
    let sc: u64 = wlibc.ui_scale()
    let pad: u64 = 6 * sc
    // r399: `text_w` floors the width of the line (26.6 -> whole points); a face whose last
    // glyph reaches the end of its advance (Inter's k) lost its tail in a bubble sized to the
    // floor -- one point more
    let bw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY), text, n) + 2 * pad + sc
    let bh: u64 = wlibc.text_h(wlibc.type_px(wlibc.TY_BODY)) + pad
    let luft: u64 = 6 * sc
    // ============================== RUNDE BELEG: fUi SAGT, WO SIE HINGEHOERT.
    var x: u64 = 0
    var y: u64 = 0
    var ax0: u64 = 0
    var ax1: u64 = 0
    if f_w[(F_CLK) as usize] != 0 {
        ax0 = bar_x + f_x[(F_CLK) as usize]
        ax1 = ax0 + f_w[(F_CLK) as usize]
    }
    // r828: the placement rule works in head-local pixels; this head's origin is added back afterwards
    if ax1 != 0 {
        ax0 = loc(ax0, hx)
        ax1 = loc(ax1, hx)
    }
    fuib.tip_place(loc(sx, hx), loc(sy, hy), bw, bh, sw, sh,
        loc(bar_y, hy), loc(bar_y + bar_h, hy), ax0, ax1, luft, &x, &y)
    x = x + hx
    y = y + hy
    // r: since 05.10.2026 the bubble is the one tooltip window of the scene host
    // (barpop.fi): text, WM_SIZE, repaint, WM_MOVE, show.
    let i: u64 = barpop.tip_show(x, y, bw, bh, text)
    if i != 0 {
        say((&s_tipvoll[0 as usize]) as u64)
        nl()
        return
    }
    tp_win = 1
    tp_zahl = tp_zahl + 1
    say((&s_tip[0 as usize]) as u64)
    say(text)
    say((&s_tipx[0 as usize]) as u64)
    sayn(x)
    say((&s_tipy[0 as usize]) as u64)
    sayn(y)
    say((&s_tipn[0 as usize]) as u64)
    sayn(tp_zahl)
    say((&s_tipw[0 as usize]) as u64)
    sayn(bw)
    say((&s_tiph[0 as usize]) as u64)
    sayn(bh)
    nl()
}

fn tip_hover(was: u64, text: u64, sx: u64, sy: u64) {
    let jetzt: u64 = ticks_now()
    if was != tp_was {
        tp_was = was
        tp_seit = jetzt
        tip_close()
        return
    }
    if was == 0 || tip_open_is() {
        return
    }
    // r1063: no tooltip while the calendar popup is open (it covered the "Today" button)
    if calpop.is_open() {
        tp_seit = jetzt
        return
    }
    if jetzt < tp_seit {
        tp_seit = jetzt
        return
    }
    if jetzt - tp_seit >= TIP_TICKS {
        tip_open(text, sx, sy)
    }
}

fn ticks_now() -> u64 {
    return ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
}

// ================================================== RUNDE TOAST (S-006)
const TOAST_TICKS: u64 = 400
const TOAST_EIN: u64 = 20 // 200 ms Einblenden
const TOAST_AUS: u64 = 25 // 250 ms Ausblenden

static mut to_win: u64 = 0xFFFFFFFFFFFFFFFF
static mut to_seit: u64 = 0 // wann sie aufging, in Schlaegen
static mut to_zahl: u64 = 0
static mut to_gesehen: u64 = 0 // Stand von noti_total beim letzten Blick
static mut to_text: u64 = 0
static mut to_prio: u64 = 0 // 1 = Hinweis, 2 = ernst
static mut to_w: u64 = 0
static mut to_h: u64 = 0
static mut to_erst: u64 = 1
static mut to_alpha_war: u64 = 0xFFFFFFFFFFFFFFFF // zuletzt gemalter Verlauf
static mut to_takt: u64 = 0
static mut to_x: u64 = 0
static mut to_y: u64 = 0
static mut to_btn: u64 = 0

static mut s_to: [u8; 18] = "taskbar: toast [\0\0"
static mut s_tox: [u8; 6] = "] x=\0\0"
static mut s_toy: [u8; 5] = " y=\0\0"
static mut s_tow: [u8; 5] = " w=\0\0"
static mut s_toh: [u8; 5] = " h=\0\0"
static mut s_top: [u8; 8] = " prio=\0\0"
static mut s_ton: [u8; 5] = " n=\0\0"
static mut s_tozu: [u8; 19] = "taskbar: toast zu\0\0"
static mut s_tovoll: [u8; 27] = "taskbar: toast kein Platz\0\0"

static mut to_puf: [u8; 96] = [0 as u8; 96]

fn toast_zu() {
    if to_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    to_win = 0xFFFFFFFFFFFFFFFF
    to_text = 0
    barpop.toast_hide()
    say((&s_tozu[0 as usize]) as u64)
    nl()
}

fn toast_alpha(jetzt: u64) -> u64 {
    if to_win == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    if jetzt < to_seit {
        return 255
    }
    let d: u64 = jetzt - to_seit
    if d < TOAST_EIN {
        return d * 255 / TOAST_EIN
    }
    if d >= TOAST_TICKS {
        return 0
    }
    if d + TOAST_AUS >= TOAST_TICKS {
        return (TOAST_TICKS - d) * 255 / TOAST_AUS
    }
    return 255
}

fn toast_auf(text: u64, prio: u64) {
    if text == 0 || tlen(text) == 0 {
        return
    }
    toast_zu()
    let n: u64 = tlen(text)
    let sc: u64 = wlibc.ui_scale()
    let pad: u64 = 10 * sc
    var bw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY), text, n)
        + 2 * pad + 6 * sc
    if bw < 240 * sc {
        bw = 240 * sc
    }
    if bw > sw / 2 {
        bw = sw / 2
    }
    let bh: u64 = wlibc.text_h(wlibc.type_px(wlibc.TY_BODY)) + 2 * pad
    let luft: u64 = 12 * sc
    var x: u64 = hx
    if sw > bw + luft {
        x = hx + sw - bw - luft
    }
    var y: u64 = hy + luft
    if bar_y == hy && bar_h != 0 {
        y = hy + bar_h + luft
    }
    let i: u64 = barpop.toast_show(x, y, bw, bh, text, prio)
    if i != 0 {
        say((&s_tovoll[0 as usize]) as u64)
        nl()
        return
    }
    to_win = 1
    to_x = x
    to_y = y
    to_btn = wlibc.mouse_btn() & 1
    to_w = bw
    to_h = bh
    to_text = text
    to_prio = prio
    to_seit = ticks_now()
    to_zahl = to_zahl + 1
    to_alpha_war = 0xFFFFFFFFFFFFFFFF
    say((&s_to[0 as usize]) as u64)
    say(text)
    say((&s_tox[0 as usize]) as u64)
    sayn(x)
    say((&s_toy[0 as usize]) as u64)
    sayn(y)
    say((&s_tow[0 as usize]) as u64)
    sayn(bw)
    say((&s_toh[0 as usize]) as u64)
    sayn(bh)
    say((&s_top[0 as usize]) as u64)
    sayn(prio)
    say((&s_ton[0 as usize]) as u64)
    sayn(to_zahl)
    nl()
}

fn toast_up() -> bool {
    return to_win != 0xFFFFFFFFFFFFFFFF
}

fn toast_clicked() -> bool {
    let btn: u64 = wlibc.mouse_btn() & 1
    let was: u64 = to_btn
    to_btn = btn
    if btn == 0 || was != 0 {
        return false
    }
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    if mx < to_x || my < to_y || mx >= to_x + to_w || my >= to_y + to_h {
        return false
    }
    let _a: bool = notifc.act_newest()
    toast_zu()
    return true
}

fn toast_step() {
    // ================================ RUNDE TOAST: DIE DROSSEL, GEMESSEN.
    to_takt = to_takt + 1
    if (to_takt % 10) != 0 && to_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    let c: u64 = wlibc.noti_total()
    if to_erst != 0 {
        to_erst = 0
        to_gesehen = c
        return
    }
    if c > to_gesehen {
        to_gesehen = c
        let n: u64 = wlibc.noti_peek(0, (&to_puf[0 as usize]) as u64, 94)
        if n > 0 {
            to_puf[(n) as usize] = 0 as u8
            let _hn: u64 = notetext.humanize((&to_puf[0 as usize]) as u64, n, 94)
            var pr: u64 = wlibc.noti_prio(0)
            if pr == 0 {
                pr = 1
            }
            // do not disturb (quick settings tile): the bell counts it, no pop-up
            if !qs.dnd_on() {
                toast_auf((&to_puf[0 as usize]) as u64, pr)
            }
        }
    }
    if to_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    if toast_clicked() {
        return
    }
    let jetzt: u64 = ticks_now()
    if jetzt < to_seit {
        to_seit = jetzt
        return
    }
    if jetzt - to_seit >= TOAST_TICKS {
        toast_zu()
        return
    }
    let a: u64 = toast_alpha(jetzt)
    if a != to_alpha_war {
        to_alpha_war = a
    }
}

fn tip_step() {
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    if !inside_bar(mx, my) {
        tip_hover(0, 0, 0, 0)
        return
    }
    let lx: u64 = mx - bar_x
    let ly: u64 = my - bar_y
    let m: u64 = hover_brand(lx, ly)
    tip_hover(m, hover_text(m), mx, my)
}

// r831: true when this bar is the one that answers a key for the start menu: the bar of the output under the pointer
// (the first present output when the pointer is on none). One output: always.
fn hotkey_mine() -> bool {
    let n: u64 = wlibc.head_count()
    if n <= 1 {
        return true
    }
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    var first: u64 = 8
    var under: u64 = 8
    var hd: u64 = 0
    while hd < 8 {
        if wlibc.head_present(hd) {
            if first == 8 {
                first = hd
            }
            let x0: u64 = wlibc.head_field(hd, 0)
            let y0: u64 = wlibc.head_field(hd, 1)
            if mx >= x0 && my >= y0 && mx < x0 + wlibc.head_field(hd, 2) && my < y0 + wlibc.head_field(hd, 3) {
                under = hd
            }
        }
        hd = hd + 1
    }
    if under == 8 {
        under = first
    }
    return under == my_head
}

fn hotkey_step() {
    let seq: u64 = nv.hotkey_seq()
    if seq == hk_gesehen {
        return
    }
    let war: u64 = hk_gesehen
    hk_gesehen = seq
    let taste: u64 = nv.hotkey_key()
    if hk_sagte < 8 {
        hk_sagte = hk_sagte + 1
        say((&s_hk[0 as usize]) as u64)
        sayn(seq)
        say((&s_hkw[0 as usize]) as u64)
        sayn(war)
        say((&s_hkt[0 as usize]) as u64)
        sayn(taste)
        nl()
    }
    if war == 0 && seq != 1 {
        hk_erst = 0
        return
    }
    hk_erst = 0
    if taste == 0 {
        // r831: with several outputs every bar sees the key; only the bar of the output the pointer is on opens the menu
        // (else the second bar would close it again at once)
        if hotkey_mine() {
            startmenue_um()
        }
        return
    }
    // ROUND TON-2: SUPER+M SILENCES THE MACHINE.
    //
    // `m` and not one of the multimedia keys, because this kernel's
    // keyboard driver (kernel/kbd.fi) delivers letters and not the
    // extended scan codes a media key sends -- a shortcut on a key
    // that never arrives is not a shortcut. `m` for mute is what
    // Windows, GNOME and KDE all use for the same thing.
    //     if c == 108 || c == 76 { ... SP_ON = 1 ... return }
    if taste == 101 || taste == 69 {
        var bn: [u8; 9] = "explorer\0"
        start_bundle((&bn[0 as usize]) as u64, 8)
        return
    }
    if taste == 105 || taste == 73 {
        var bn2: [u8; 9] = "settings\0"
        start_bundle((&bn2[0 as usize]) as u64, 8)
        return
    }
    if taste == 1000 {
        var bn3: [u8; 8] = "taskmgr\0"
        start_bundle((&bn3[0 as usize]) as u64, 7)
        return
    }
    if taste == 100 || taste == 68 {
        show_desktop_toggle()
        return
    }
    if taste == 9 {
        say((&s_hktv[0 as usize]) as u64)
        nl()
        taskview.toggle()
        return
    }
    if taste == 114 || taste == 82 {
        var bn4: [u8; 4] = "run\0"
        start_bundle((&bn4[0 as usize]) as u64, 3)
        return
    }
    if taste == 118 || taste == 86 {
        // D-015: Win+V = the clipboard history popup (bundle `cliphist` -> /bin/cliphist)
        var bn5: [u8; 9] = "cliphist\0"
        start_bundle((&bn5[0 as usize]) as u64, 8)
        return
    }
    if taste == 336 {
        snip_launch(false)
        return
    }
    if taste == 83 {
        snip_launch(true)
        return
    }
    if taste == 110 || taste == 78 {
        if hotkey_mine() {
            say((&s_hknoti[0 as usize]) as u64)
            nl()
            notifc.toggle()
        }
        return
    }
    if taste == 116 {
        bar_keys(true)
        return
    }
    if taste == 109 {
        if snd_da != 0 {
            let an: u64 = ulib.sys(SYS_AUDGET, A_MUTED, 0, 0)
            var neu2: u64 = 1
            if an == 1 {
                neu2 = 0
            }
            let rc: u64 = ulib.sys(SYS_AUDSET, AS_MUTE, neu2, 0)
            say((&s_hkmute[0 as usize]) as u64)
            sayn(neu2)
            say((&s_hkrc[0 as usize]) as u64)
            sayn(rc)
            nl()
            snd_mute = neu2
            status_build()
            paint(false)
        }
        return
    }
}

static mut s_hkapp: [u8; 19] = "taskbar: hk start \0"
static mut s_hknoti: [u8; 18] = "taskbar: hk notif\0"
static mut s_hkdesk: [u8; 24] = "taskbar: hk desktop n=\0\0"
static mut desk_hidden: u64 = 0
static mut desk_ids: [u64; 16] = [0 as u64; 16]
static mut desk_n: u64 = 0

// W1 (hotkeys): start the bundle /apps/<name>.osp/start (same path the pinned buttons use).
fn start_bundle(name: u64, len: u64) {
    var pp: [u8; 64] = [0 as u8; 64]
    var pv: [u8; 7] = "/apps/\0"
    var pn2: [u8; 11] = ".osp/start\0"
    var q: u64 = 0
    var k: u64 = 0
    while k < 6 {
        pp[(q) as usize] = pv[(k) as usize]
        q = q + 1
        k = k + 1
    }
    k = 0
    while k < len && k < 23 {
        pp[(q) as usize] = *((name + k) as *mut u8)
        q = q + 1
        k = k + 1
    }
    k = 0
    while k < 10 {
        pp[(q) as usize] = pn2[(k) as usize]
        q = q + 1
        k = k + 1
    }
    pp[(q) as usize] = 0 as u8
    let pid: u64 = appreg.launch((&pp[0 as usize]) as u64, 0, 0)
    say((&s_hkapp[0 as usize]) as u64)
    say((&pp[0 as usize]) as u64)
    say((&s_pinpid[0 as usize]) as u64)
    sayn(pid)
    nl()
}

// W1 (hotkeys): Win+D. First press hides every window of the bar's list (remembering which), the second brings them back.
fn show_desktop_toggle() {
    let _l: bool = list_read()
    var i: u64 = 0
    if desk_hidden == 0 {
        desk_n = 0
        while i < nk && desk_n < 16 {
            desk_ids[(desk_n) as usize] = kid[(i) as usize]
            desk_n = desk_n + 1
            let _a: u64 = wlibc.win_act(kid[(i) as usize], wlibc.WA_HIDE)
            i = i + 1
        }
        desk_hidden = 1
    } else {
        while i < desk_n {
            let _b: u64 = wlibc.win_act(desk_ids[(i) as usize], wlibc.WA_RAISE)
            i = i + 1
        }
        desk_hidden = 0
    }
    say((&s_hkdesk[0 as usize]) as u64)
    sayn(desk_n)
    nl()
}

static mut s_hktv: [u8; 15] = "taskbar: hk tv\0"
static mut s_mkv: [u8; 26] = "taskbar: marke vektor px=\0"
static mut s_hkmute: [u8; 21] = "taskbar: hk mute on=\0"
static mut s_hkrc: [u8; 5] = " rc=\0"

static mut s_hk: [u8; 21] = "taskbar: klinke seq=\0"
static mut s_hkw: [u8; 7] = "  war=\0"
static mut s_hkt: [u8; 9] = "  taste=\0"

// L-008: start the screenshot tool. region=false: `snip -q` (whole screen,
// saved to /bilder/Screenshots and put on the clipboard); region=true:
// `snip -r` (frozen picture, drag a rectangle).
fn snip_launch(region: bool) {
    var path: [u8; 10] = "/bin/snip\0"
    var path_t: [u8; 11] = "/bin/snipt\0"
    var flag_q: [u8; 3] = "-q\0"
    var flag_r: [u8; 3] = "-r\0"
    var s_sn: [u8; 22] = "taskbar: snip pid=\0\0\0\0"
    var argv: [u64; 3] = [0 as u64; 3]
    argv[0 as usize] = (&path[0 as usize]) as u64
    if region {
        argv[0 as usize] = (&path_t[0 as usize]) as u64
        argv[1 as usize] = (&flag_r[0 as usize]) as u64
    } else {
        argv[1 as usize] = (&flag_q[0 as usize]) as u64
    }
    // snip creates /bilder/Screenshots itself: stays root until the user has a writable picture folder (SESSUID3 open point)
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, argv[0 as usize],
        (&argv[0 as usize]) as u64, 2)
    say((&s_sn[0 as usize]) as u64)
    sayn(pid)
    nl()
}

fn startmenue_um() {
    // r831: the menu opens on the output of THIS bar (the launcher reads it when it is shown / started)
    wlibc.start_head_set(my_head)
    let w: u64 = launcher_window()
    if w != 0 {
        let rc: u64 = wlibc.win_act(w, wlibc.WA_TOGGLE)
        if ulib.bad(rc) {
            say((&s_tog_bad[0 as usize]) as u64)
            sayn(rc)
            nl()
            return
        }
        if menue_war_offen != 0 {
            say((&s_tog[0 as usize]) as u64)
        } else {
            say((&s_tog_auf[0 as usize]) as u64)
        }
        nl()
        return
    }
    //     fn do_spawn(state, me, prog, arg) {
    //         if prog == 0 || prog > 16 { return neg(errno.E_INVAL) }
    let pid: u64 = ulib.sys(ulib.SYS_EXEC,
        (&p_start[0 as usize]) as u64, 0, 0)
    menue_pid = pid
    say((&s_sp[0 as usize]) as u64)
    sayn(pid)
    nl()
}

static mut s_notv: [u8; 27] = "taskbar: no task view card\0"
static mut z_tv: [u8; 9] = "taskview\0"
static mut z_nc: [u8; 7] = "notifc\0"
static mut z_chev: [u8; 8] = "chevron\0"
static mut z_clk: [u8; 6] = "clock\0"

// r529: start pin `pk` as a NEW instance (the path /apps/<name>.osp/start, the one the launcher uses), whether or not one
// already runs. A click on a running pin only switches the window; a terminal needs a way to open one more.
fn pin_exec(pk: u64) {
    app_exec((&pinname[0 as usize]) as u64 + pk * 24)
}

// start /apps/<name>.osp/start for a bundle name (23 bytes max, NUL ended) at `src`
fn app_exec(src: u64) {
    var pp: [u8; 64] = [0 as u8; 64]
    var pv: [u8; 7] = "/apps/\0"
    var pn2: [u8; 11] = ".osp/start\0"
    var q2: u64 = 0
    var k2: u64 = 0
    while k2 < 6 {
        pp[(q2) as usize] = pv[(k2) as usize]
        q2 = q2 + 1
        k2 = k2 + 1
    }
    k2 = 0
    while k2 < 23 && kstate8(src + k2) != 0 {
        pp[(q2) as usize] = *((src + k2) as *mut u8)
        q2 = q2 + 1
        k2 = k2 + 1
    }
    k2 = 0
    while k2 < 10 {
        pp[(q2) as usize] = pn2[(k2) as usize]
        q2 = q2 + 1
        k2 = k2 + 1
    }
    pp[(q2) as usize] = 0 as u8
    let pid2: u64 = appreg.launch(
        (&pp[0 as usize]) as u64, 0, 0)
    say((&s_pinexec[0 as usize]) as u64)
    say((&pp[0 as usize]) as u64)
    say((&s_pinpid[0 as usize]) as u64)
    sayn(pid2)
    nl()
}

fn click(x: u64, y: u64) {
    clicks = clicks + 1
    say((&s_cl[0 as usize]) as u64)
    sayn(x)
    say((&s_cy[0 as usize]) as u64)
    sayn(y)
    // THIRD ADDENDUM: the icon group in the corner opens the quick
    // settings, the way the same corner does on every system that has
    // such a panel. Before the window buttons, because it is a field
    // and not a button and would otherwise fall through to the drag.
    if grp_w != 0 && x >= grp_x && x < grp_x + grp_w
        && y >= st_y && y < st_y + btn_h() {
        say((&s_ct[0 as usize]) as u64)
        say((&z_qs[0 as usize]) as u64)
        nl()
        qs.toggle()
        return
    }
    if tv_w != 0 && x >= tv_x && x < tv_x + tv_w && y >= tv_y && y < tv_y + tv_h {
        say((&s_ct[0 as usize]) as u64)
        say((&z_tv[0 as usize]) as u64)
        nl()
        taskview.toggle()
        return
    }
    if chv_w != 0 && x >= chv_x && x < chv_x + chv_w && y >= chv_y && y < chv_y + chv_h {
        say((&s_ct[0 as usize]) as u64)
        say((&z_chev[0 as usize]) as u64)
        nl()
        // W-TRAY5: the chevron opens the tray flyout (traypop.fi) above the button. r1015: the anchor is in SCREEN
        // points (bar origin + button), not in the bar window's own -- the card sat at the top of the screen before.
        calpop.shut_now()
        traypop.toggle(bar_x + chv_x, bar_y + chv_y, chv_w, chv_h, net_da, net_state)
        if chev_open == 0 {
            chev_open = 1
        } else {
            chev_open = 0
        }
        let _sb: bool = status_build()
        layout()
        paint(true)
        return
    }
    // THE BELL opens the notification centre (history + clear). The field exists
    // only while something is unread (f_w == 0 otherwise), so this never fires on
    // an empty bar.
    if f_w[(F_NOTI) as usize] != 0
        && x >= f_x[(F_NOTI) as usize]
        && x < f_x[(F_NOTI) as usize] + f_w[(F_NOTI) as usize]
        && y >= f_y[(F_NOTI) as usize]
        && y < f_y[(F_NOTI) as usize] + f_h[(F_NOTI) as usize] {
        say((&s_ct[0 as usize]) as u64)
        say((&z_nc[0 as usize]) as u64)
        nl()
        notifc.toggle()
        return
    }
    // P-011: the clock opens the calendar popup (calpop.fi) above it; the chevron's flyout makes room
    if f_w[(F_CLK) as usize] != 0
        && x >= f_x[(F_CLK) as usize]
        && x < f_x[(F_CLK) as usize] + f_w[(F_CLK) as usize]
        && y >= f_y[(F_CLK) as usize]
        && y < f_y[(F_CLK) as usize] + f_h[(F_CLK) as usize] {
        say((&s_ct[0 as usize]) as u64)
        say((&z_clk[0 as usize]) as u64)
        nl()
        if traypop.is_open() {
            traypop.shut_now()
        }
        tip_close()
        calpop.toggle(bar_x + f_x[(F_CLK) as usize], bar_y + f_y[(F_CLK) as usize],
            f_w[(F_CLK) as usize], f_h[(F_CLK) as usize])
        return
    }
    if x >= f_x[(F_NET) as usize]
        && x < f_x[(F_NET) as usize] + f_w[(F_NET) as usize]
        && y >= f_y[(F_NET) as usize]
        && y < f_y[(F_NET) as usize] + f_h[(F_NET) as usize] {
        say((&s_ct[0 as usize]) as u64)
        say((&z_qs[0 as usize]) as u64)
        nl()
        qs.toggle()
        return
    }
    // ROUND TON-2: THE SPEAKER OPENS THE SAME PANEL. It is the field
    // next door and it belongs to the same corner -- a symbol that
    // shows a state and does nothing when it is clicked is a symbol
    // that teaches people not to click it.
    if snd_da != 0 && f_w[(F_SND) as usize] != 0
        && x >= f_x[(F_SND) as usize]
        && x < f_x[(F_SND) as usize] + f_w[(F_SND) as usize]
        && y >= f_y[(F_SND) as usize]
        && y < f_y[(F_SND) as usize] + f_h[(F_SND) as usize] {
        say((&s_ct[0 as usize]) as u64)
        say((&z_qs[0 as usize]) as u64)
        nl()
        qs.toggle()
        return
    }
    if x >= st_x && x < st_x + st_w && y >= st_y && y < st_y + st_h {
        say((&s_ct[0 as usize]) as u64)
        say((&z_start[0 as usize]) as u64)
        nl()
        startmenue_um()
        return
    }
    var pk: u64 = 0
    while pk < npin {
        if pw_[(pk) as usize] != 0
            && x >= px_[(pk) as usize]
            && x < px_[(pk) as usize] + pw_[(pk) as usize]
            && y >= py_[(pk) as usize]
            && y < py_[(pk) as usize] + ph_[(pk) as usize] {
            let w2: u64 = pinwin[(pk) as usize]
            if w2 < MAXK {
                var rc2: u64 = 0
                if kcnt[(w2) as usize] > 1 && kfok[(w2) as usize] != 0 {
                    // grouped and already in front: walk to the next window of the program
                    rc2 = wlibc.win_act(group_next(w2), wlibc.WA_RAISE)
                } else {
                    rc2 = wlibc.win_act(kid[(w2) as usize], wlibc.WA_TOGGLE)
                }
                acts = acts + 1
                say((&s_pinact[0 as usize]) as u64)
                say((&pinname[0 as usize]) as u64 + pk * 24)
                say((&s_rc[0 as usize]) as u64)
                sayn(rc2)
                nl()
            } else {
                pin_exec(pk)
            }
            let _a2: bool = list_read()
            layout()
            paint(true)
            return
        }
        pk = pk + 1
    }
    var i: u64 = 0
    while i < nk {
        if kw[(i) as usize] != 0 {
            if x >= kx[(i) as usize] && x < kx[(i) as usize] + kw[(i) as usize]
                && y >= ky[(i) as usize]
                && y < ky[(i) as usize] + kh[(i) as usize] {
                say((&s_ct[0 as usize]) as u64)
                say((&z_task[0 as usize]) as u64)
                nl()
                var rc: u64 = 0
                if kcnt[(i) as usize] > 1 && kfok[(i) as usize] != 0 {
                    rc = wlibc.win_act(group_next(i), wlibc.WA_RAISE)
                } else {
                    rc = wlibc.win_act(kid[(i) as usize], wlibc.WA_TOGGLE)
                }
                acts = acts + 1
                say((&s_act[0 as usize]) as u64)
                sayn(kid[(i) as usize])
                say((&s_aw[0 as usize]) as u64)
                sayn(wlibc.WA_TOGGLE)
                say((&s_rc[0 as usize]) as u64)
                sayn(rc)
                nl()
                let _a: bool = list_read()
                layout()
                paint(true)
                return
            }
        }
        i = i + 1
    }
    // NOTHING WAS HIT -- so this press is the beginning of a drag. That
    // is the whole gesture: press on an empty part of the bar and pull.
    say((&s_ct[0 as usize]) as u64)
    say((&z_none[0 as usize]) as u64)
    nl()
    dragging = 1
    drag_edge = cf_edge
    prev_edge = 9
    say((&s_d0[0 as usize]) as u64)
    say((&s_gx[0 as usize]) as u64)
    sayn(x)
    say((&s_cy[0 as usize]) as u64)
    sayn(y)
    nl()
}

// ================================================================ main

static mut s_bad: [u8; 23] = "taskbar: no surface\0\0\0\0"
static mut s_nol: [u8; 40] = "taskbar: no layer 2 -- not root?\0\0\0\0\0\0\0\0"
static mut s_rdy: [u8; 22] = "taskbar: ready ascent\0"
static mut s_eq: [u8; 2] = "=\0"
static mut s_stt: [u8; 18] = "taskbar: state n=\0"
// RUNDE 31: HAT fUi WIRKLICH GEMALT?
static mut s_fui: [u8; 6] = " fui=\0"
static mut s_fuix: [u8; 7] = " fuix=\0"
static mut s_fuig: [u8; 7] = " fuig=\0"
static mut s_pm: [u8; 9] = " paints=\0"
static mut s_ck: [u8; 9] = " clicks=\0"
static mut s_ac: [u8; 7] = " acts=\0"
static mut s_wt: [u8; 9] = " writes=\0"
static mut s_ur: [u8; 16] = "taskbar: round=\0"
static mut s_usb: [u8; 5] = " sb=\0"
static mut s_usbt: [u8; 6] = " sbt=\0"
static mut s_upx: [u8; 5] = " px=\0"
static mut s_usoll: [u8; 7] = " soll=\0"
static mut s_unull: [u8; 7] = " null=\0"
static mut s_upm: [u8; 5] = " pm=\0"
static mut s_uqw: [u8; 5] = " qw=\0"
static mut s_uq: [u8; 4] = " q=\0"
static mut s_title: [u8; 8] = "Taskbar\0"
static mut s_theme: [u8; 11] = "/etc/theme\0"
static mut a_once: [u8; 5] = "once\0"

static mut t_tvn: [u8; 10] = "Task view\0"
static mut t_chn: [u8; 13] = "Hidden icons\0"
static mut t_nen: [u8; 8] = "Network\0"
static mut t_snn: [u8; 7] = "Volume\0"
static mut t_btn: [u8; 8] = "Battery\0"
static mut t_nin: [u8; 14] = "Notifications\0"
static mut t_stn: [u8; 6] = "Start\0"

// =============================================================== r381 STAGE 1
// THE BAR IS A WINDOW OF THE SCENE HOST (window 0), and its rectangles are nodes.
//
// What did not change: `layout()` computes every rectangle, `paint_band` paints with
// the same painters into the same one-band surface, the polled pointer, the drag,
// the auto-hide. What did:
//   * the window is `fuiscene.open_plain` and not a raw `WM_CREATE` window;
//   * a band is not blitted to the window server any more but copied into `bar_r`
//     (a retained picture of the whole bar); the host paints it as its backdrop
//     (`bar_overlay`, over the faces of the ghost nodes) and pushes it -- so the focus ring and everything else the
//     host draws land on top of the bar's own picture, and nothing is lost when
//     the host repaints;
//   * the rectangles are ALSO a tree of nodes that paint nothing (ghost buttons) --
//     start, task view, chevron, pins, window buttons, status fields, extension
//     widgets, each with a key and the name a screen reader says: the bar is
//     visible to the accessibility export, the bridge can press a node, and the
//     keyboard focus ring has something to stand on;
//   * the pointer events of the window come to `bar_raw` (the old `EV_DOWN` code,
//     unchanged), the host skips them.
const BI_MAX: u64 = 48
const K_START: u64 = 1
const K_TV: u64 = 2
const K_CHEV: u64 = 3
const K_PIN: u64 = 10
const K_TASK: u64 = 30
const K_FIELD: u64 = 60
const K_PLUG: u64 = 80
static mut bar_r: u64 = 0 // the retained picture of the bar, win_w x win_h x 4 octets
static mut bar_cap: u64 = 0
static mut bar_ready: u64 = 0
static mut bi_n: u64 = 0
static mut bi_x: [u64; 48] = [0 as u64; 48]
static mut bi_y: [u64; 48] = [0 as u64; 48]
static mut bi_w: [u64; 48] = [0 as u64; 48]
static mut bi_h: [u64; 48] = [0 as u64; 48]
static mut bi_k: [u64; 48] = [0 as u64; 48]
static mut bi_l: [u64; 48] = [0 as u64; 48]
static mut bi_o: [u64; 48] = [0 as u64; 48] // the order of the tree
static mut bar_nodes: u64 = 0
static mut bar_pump_said: u64 = 0

fn bi_add(x: u64, y: u64, w: u64, h: u64, key: u64, lab: u64) {
    if w == 0 || h == 0 || bi_n >= BI_MAX {
        return
    }
    bi_x[(bi_n) as usize] = x
    bi_y[(bi_n) as usize] = y
    bi_w[(bi_n) as usize] = w
    bi_h[(bi_n) as usize] = h
    bi_k[(bi_n) as usize] = key
    bi_l[(bi_n) as usize] = lab
    bi_n = bi_n + 1
}

// the name of a status field for the accessibility tree: its text, or a word when
// the field is an icon only
fn field_name(f: u64) -> u64 {
    let t: u64 = full_of(f)
    if tlen(t) != 0 && f != F_NET {
        return t
    }
    if f == F_NET {
        return (&t_nen[0 as usize]) as u64
    }
    if f == F_SND {
        return (&t_snn[0 as usize]) as u64
    }
    if f == F_BAT {
        return (&t_btn[0 as usize]) as u64
    }
    if f == F_NOTI {
        return (&t_nin[0 as usize]) as u64
    }
    return t
}

// does item `p` come after item `q` (later row, or the same row and further right)?
fn bi_after(p: u64, q: u64) -> bool {
    if bi_y[(p) as usize] != bi_y[(q) as usize] {
        return bi_y[(p) as usize] > bi_y[(q) as usize]
    }
    return bi_x[(p) as usize] > bi_x[(q) as usize]
}

// every rectangle of the bar, in the order of the tree
fn bi_collect() {
    bi_n = 0
    bi_add(st_x, st_y, st_w, st_h, K_START,
        txt((&k_start[0 as usize]) as u64, (&t_stn[0 as usize]) as u64))
    if tv_w != 0 {
        bi_add(tv_x, tv_y, tv_w, tv_h, K_TV, (&t_tvn[0 as usize]) as u64)
    }
    if chv_w != 0 {
        bi_add(chv_x, chv_y, chv_w, chv_h, K_CHEV, (&t_chn[0 as usize]) as u64)
    }
    var i: u64 = 0
    while i < npin {
        bi_add(px_[(i) as usize], py_[(i) as usize], pw_[(i) as usize],
            ph_[(i) as usize], K_PIN + i, (&pinname[0 as usize]) as u64 + i * 24)
        i = i + 1
    }
    i = 0
    while i < nk {
        if kw[(i) as usize] != 0 {
            var lab: u64 = (&klab[0 as usize]) as u64 + i * 40
            if tlen(lab) == 0 {
                lab = (&ktit[0 as usize]) as u64 + i * 40
            }
            bi_add(kx[(i) as usize], ky[(i) as usize], kw[(i) as usize],
                kh[(i) as usize], K_TASK + i, lab)
        }
        i = i + 1
    }
    var f: u64 = 0
    while f < F_N {
        if f_w[(f) as usize] != 0 {
            bi_add(f_x[(f) as usize], f_y[(f) as usize], f_w[(f) as usize],
                f_h[(f) as usize], K_FIELD + f, field_name(f))
        }
        f = f + 1
    }
    var q: u64 = 0
    while q < PB_MAX {
        if pb_w[(q) as usize] != 0 {
            bi_add(pb_x[(q) as usize], pb_y[(q) as usize], pb_w[(q) as usize],
                pb_h[(q) as usize], K_PLUG + q, plug_text(q))
        }
        q = q + 1
    }
    // order: top to bottom, then left to right (insertion sort of the indices, at most 48)
    var a: u64 = 0
    while a < bi_n {
        bi_o[(a) as usize] = a
        a = a + 1
    }
    a = 1
    while a < bi_n {
        var b: u64 = a
        while b > 0 && bi_after(bi_o[(b - 1) as usize], bi_o[(b) as usize]) {
            let t: u64 = bi_o[(b) as usize]
            bi_o[(b) as usize] = bi_o[(b - 1) as usize]
            bi_o[(b - 1) as usize] = t
            b = b - 1
        }
        a = a + 1
    }
}

static mut a_start: [u8; 14] = "taskbar.start\0"
static mut a_tv: [u8; 17] = "taskbar.taskview\0"
static mut a_nc: [u8; 22] = "taskbar.notifications\0"
static mut s_notp: [u8; 20] = "taskbar: no traypop\0"
static mut s_nocp: [u8; 19] = "taskbar: no calpop\0"
static mut a_chev: [u8; 16] = "taskbar.chevron\0"
static mut a_quick: [u8; 14] = "taskbar.quick\0"
static mut a_pinp: [u8; 13] = "taskbar.pin.\0"
static mut a_pinb: [u8; 440] = [0 as u8; 440] // MAXPIN x 44

// the bus action of a node (what `act call a11y.press action=...` names; 0 = none)
fn bar_action(key: u64) -> u64 {
    if key == K_START {
        return (&a_start[0 as usize]) as u64
    }
    if key == K_TV {
        return (&a_tv[0 as usize]) as u64
    }
    if key == K_FIELD + F_NOTI {
        return (&a_nc[0 as usize]) as u64
    }
    if key == K_CHEV {
        return (&a_chev[0 as usize]) as u64
    }
    if key >= K_PIN && key < K_PIN + npin {
        let i: u64 = key - K_PIN
        let b: u64 = (&a_pinb[0 as usize]) as u64 + i * 44
        let at: u64 = text_at_p(b, 0, (&a_pinp[0 as usize]) as u64)
        let _e: u64 = text_at_p(b, at, (&pinname[0 as usize]) as u64 + i * 24)
        return b
    }
    if key == K_FIELD + F_NET || key == K_FIELD + F_SND || key == K_FIELD + F_BAT {
        return (&a_quick[0 as usize]) as u64
    }
    return 0
}

// The tree: one row per line of the bar (a horizontal bar is ONE row), spacers where
// there is room between two rectangles, a ghost button for each rectangle.
fn bar_build() {
    let r: usize = fuiscene.root()
    fuiscene.set_pad(r, 0)
    fuiscene.set_gap(r, 0)
    bi_collect()
    var i: u64 = 0
    var cy: u64 = 0
    var nodes: u64 = 0
    while i < bi_n {
        let y: u64 = bi_y[(bi_o[(i) as usize]) as usize]
        if y > cy {
            let _sy: usize = fuiscene.ghost_space(r, 0, y - cy)
        }
        let row: usize = fuiscene.row(r)
        fuiscene.set_pad(row, 0)
        fuiscene.set_gap(row, 0)
        var cx: u64 = 0
        var mh: u64 = 0
        while i < bi_n && bi_y[(bi_o[(i) as usize]) as usize] == y {
            let o: u64 = bi_o[(i) as usize]
            let x: u64 = bi_x[(o) as usize]
            if x > cx {
                let _sx: usize = fuiscene.ghost_space(row, x - cx, 1)
            }
            let _b: usize = fuiscene.ghost_button(row, bi_l[(o) as usize],
                bi_k[(o) as usize], bi_w[(o) as usize], bi_h[(o) as usize])
            let ba: u64 = bar_action(bi_k[(o) as usize])
            if ba != 0 {
                fuiscene.ax_action(bi_k[(o) as usize], ba)
            }
            nodes = nodes + 1
            cx = x + bi_w[(o) as usize]
            if bi_h[(o) as usize] > mh {
                mh = bi_h[(o) as usize]
            }
            i = i + 1
        }
        cy = y + mh
    }
    bar_nodes = nodes
}

// a node was pressed through the tree (the accessibility export, the keyboard): the
// same as a click in the middle of its rectangle
fn bar_press(key: u64) {
    var i: u64 = 0
    while i < bi_n {
        if bi_k[(i) as usize] == key {
            click(bi_x[(i) as usize] + bi_w[(i) as usize] / 2,
                bi_y[(i) as usize] + bi_h[(i) as usize] / 2)
            return
        }
        i = i + 1
    }
}

// the pointer events of the bar's window (the old loop's `EV_DOWN` branch)
static mut s_kbon: [u8; 17] = "taskbar: keys on\0"
static mut s_kbk: [u8; 16] = "taskbar: key n=\0"
static mut s_kboff: [u8; 19] = "taskbar: keys off \0"
static mut bar_kb: u64 = 0 // 1 = the keyboard is in the bar (Super+T)
static mut bar_kb_btn: u64 = 0

// Super+T: the keyboard goes to the bar. Tab / Shift+Tab walk the nodes (the focus ring
// is the host's), Enter or Space presses the focused one (the same as a click in its
// middle), Escape, a press of the pointer or an activation gives the keyboard back.
// While it is on, the window server hands the keys to the bar AND to the focused
// program (WS_KEYS), so it is short on purpose.
fn bar_keys(on: bool) {
    if bar_ready == 0 {
        return
    }
    let _s: bool = fuiscene.win_select(0)
    if on {
        bar_kb = 1
        let _k: u64 = wlibc.win_state(w_h, wlibc.WS_KEYS, 1)
        fuiscene.focus_canvas()
        fuiscene.focus(K_START)
        bar_kb_btn = wlibc.mouse_btn() & 1
        say((&s_kbon[0 as usize]) as u64)
        nl()
    } else {
        bar_kb = 0
        let _k: u64 = wlibc.win_state(w_h, wlibc.WS_KEYS, 0)
        fuiscene.focus(0)
        say((&s_kboff[0 as usize]) as u64)
        nl()
    }
    fuiscene.refresh()
}

fn bar_kb_step() {
    if bar_kb == 0 {
        return
    }
    let b: u64 = wlibc.mouse_btn() & 1
    if b != 0 && bar_kb_btn == 0 {
        bar_keys(false)
    }
    bar_kb_btn = b
}

fn bar_raw(kind: u64, x: u64, y: u64, btn: u64, key: u64) {
    if kind == fuiapp_down() {
        fuiscene.raw_take()
        if (btn & 2) != 0 {
            rechtsklick(x, y)
        } else {
            let pg: u64 = pin_under(x, y)
            if pg < npin {
                pdrag = 1
                pdrag_i = pg
                pdrag_x0 = x
                pdrag_y0 = y
            } else {
                click(x, y)
            }
        }
        return
    }
    if kind == 3 || kind == 4 {
        fuiscene.raw_take()
        return
    }
    if kind == 1 {
        if bar_kb != 0 {
            say((&s_kbk[0 as usize]) as u64)
            sayn(key)
            nl()
        }
        if key == 27 && bar_kb != 0 {
            bar_keys(false)
        }
        tb_key(key)
    }
}

fn fuiapp_down() -> u64 {
    return 2
}

fn bar_copy(dst: u64, src: u64, n: u64) {
    var k: u64 = 0
    while k + 8 <= n {
        __mmio_write64((dst + k) as *mut u64, __mmio_read64((src + k) as *mut u64))
        k = k + 8
    }
    while k < n {
        __mmio_write8((dst + k) as *mut u8, __mmio_read8((src + k) as *mut u8))
        k = k + 1
    }
}

// a band of the painted bar goes into the retained picture
fn bar_push(y0: u64, hh: u64) -> u64 {
    if bar_r == 0 || hh == 0 || win_w == 0 {
        return 0
    }
    if y0 < wlibc.band_y() {
        return 0
    }
    var rows: u64 = hh
    if y0 + rows > win_h {
        rows = win_h - y0
    }
    let rr: u64 = y0 - wlibc.band_y()
    if rr >= wlibc.surf_rows() {
        return 0
    }
    if rr + rows > wlibc.surf_rows() {
        rows = wlibc.surf_rows() - rr
    }
    if (y0 + rows) * win_w * 4 > bar_cap {
        return 0
    }
    let src: u64 = wlibc.surface() + rr * wlibc.surf_w() * 4
    var k: u64 = 0
    while k < rows {
        bar_copy(bar_r + ((y0 + k) * win_w) * 4, src + k * wlibc.surf_w() * 4,
            win_w * 4)
        k = k + 1
    }
    return win_w * rows
}

// the host's overlay for window 0: the retained picture of the bar
fn bar_overlay() {
    let dst: u64 = fuiscene.canvas_px()
    if dst == 0 || bar_r == 0 {
        return
    }
    let cw: u64 = fuiscene.sp(fuiscene.width())
    let ch: u64 = fuiscene.sp(fuiscene.height())
    if cw != win_w {
        return
    }
    var rows: u64 = win_h
    if ch < rows {
        rows = ch
    }
    if rows * win_w * 4 > bar_cap {
        return
    }
    bar_copy(dst, bar_r, rows * win_w * 4)
}

// the host paints what the bar painted: rebuild the tree (the rectangles moved) and
// let the host push the picture. Called after every paint of the bar.
fn bar_sync() {
    if bar_ready == 0 {
        return
    }
    let _s: bool = fuiscene.win_select(0)
    fuiscene.refresh()
}

// one turn of the host for the bar's window; a node that was pressed comes back as a key
fn bar_pump() {
    if bar_ready == 0 {
        return
    }
    let _st: u64 = wlib.step()
    let k: u64 = fuiscene.pump_aux(0)
    if k != 0 {
        bar_press(k)
        if bar_kb != 0 {
            bar_keys(false)
        }
    }
    bar_kb_step()
}

// the size of the bar's window (the host re-binds its canvas at its next turn)
fn bar_size(w: u64, h: u64) -> u64 {
    let _s: bool = fuiscene.win_select(0)
    if fuiscene.win_size(w, h) {
        return 0
    }
    return 1
}

static mut a_head: [u8; 7] = "--head\0"
static mut p_bar: [u8; 13] = "/bin/taskbar\0"
static mut s_hd1: [u8; 22] = "taskbar: head my=\0\0\0\0\0"
static mut s_hd2: [u8; 5] = " on=\0"
static mut s_hd3: [u8; 7] = " spawn\0"
static mut quit_req: u64 = 0
// W-C3g: one serial line per followed screen change, NOT gated by /etc/uitrace (tools/vmsvgaresize judges it: the bar must follow every step)
static mut s_fw1: [u8; 26] = "taskbar: follow screen w=\0"

// r828: find out which output this instance serves and how big it is. The first instance (no `--head`) serves the
// first head that exists; `--head N` serves head N. On a machine without a head table (one screen) nothing changes:
// hx = hy = 0, sw/sh = the screen. Returns true when the rectangle differs from what was set before.
fn head_setup() -> bool {
    // r1004: a resolution change (host hint, Settings) moves the whole desktop rectangle
    let _sr: bool = wlibc.screen_refresh()
    var nx: u64 = 0
    var ny: u64 = 0
    var nw: u64 = wlibc.screen_w()
    var nh: u64 = wlibc.screen_h()
    var on: u64 = 0
    var hd: u64 = my_head
    if head_arg == 0 {
        hd = 0
        while hd < 8 && !wlibc.head_present(hd) {
            hd = hd + 1
        }
        if hd >= 8 {
            hd = 0
        }
    }
    if hd < 8 && wlibc.head_present(hd) {
        let w: u64 = wlibc.head_field(hd, 2)
        let h: u64 = wlibc.head_field(hd, 3)
        if !ulib.bad(w) && !ulib.bad(h) && w != 0 && h != 0 {
            nx = wlibc.head_field(hd, 0)
            ny = wlibc.head_field(hd, 1)
            nw = w
            nh = h
            on = 1
            my_head = hd
        }
    }
    var changed: bool = false
    if nx != hx || ny != hy || nw != sw || nh != sh || on != head_on {
        changed = true
    }
    hx = nx
    hy = ny
    sw = nw
    sh = nh
    head_on = on
    wlibc.set_head_bounds(hx, hy, sw, sh)
    return changed
}

// Start one more bar for output `hd`: /bin/taskbar --head N
fn spawn_bar(hd: u64) {
    var num: [u8; 2] = [48 as u8, 0 as u8]
    num[0 as usize] = (48 + hd) as u8
    var argv: [u64; 4] = [0 as u64; 4]
    argv[0 as usize] = (&p_bar[0 as usize]) as u64
    argv[1 as usize] = (&a_head[0 as usize]) as u64
    argv[2 as usize] = (&num[0 as usize]) as u64
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&p_bar[0 as usize]) as u64,
        (&argv[0 as usize]) as u64, 3)
    say((&s_hd1[0 as usize]) as u64)
    sayn(hd)
    say((&s_hd3[0 as usize]) as u64)
    sayn(pid)
    nl()
}

// Polled a few times a second. The first instance starts a bar for every other head that appears (and forgets it when
// the head goes, so a replug starts a new one); a `--head` instance ends when its head is gone; a head whose rectangle
// changed (new mode, replug) moves the bar there.
fn heads_step() {
    if head_arg != 0 && !wlibc.head_present(my_head) {
        quit_req = 1
        return
    }
    if head_arg == 0 {
        var hd: u64 = 0
        while hd < 8 {
            let bit: u64 = 1 << hd
            if hd != my_head && wlibc.head_present(hd) {
                if (spawned & bit) == 0 {
                    spawned = spawned | bit
                    spawn_bar(hd)
                }
            } else {
                spawned = spawned & (0xFF ^ bit)
            }
            hd = hd + 1
        }
    }
    if head_setup() {
        // one write per piece, no ^ anchor needed by the readers (serial lines may interleave under load)
        lineout.add_text((&s_fw1[0 as usize]) as u64)
        lineout.add_num(sw)
        lineout.add_text((&s_gx2[0 as usize]) as u64)
        lineout.add_num(sh)
        lineout.end_line()
        geometry()
        shown = 1
        apply()
        layout()
        paint(true)
        say((&s_hd1[0 as usize]) as u64)
        sayn(my_head)
        say((&s_hd2[0 as usize]) as u64)
        sayn(head_on)
        nl()
        geom_say()
        size_tries = 0
    } else if size_fail != 0 && size_tries < 30 {
        size_tries = size_tries + 1
        apply()
        layout()
        paint(true)
    }
}

fn u_start(args: u64) -> u64 {
    // DELL ROUND: this program never waits for what it starts.
    ulib.ignore_children()
    dbg_setup(args)
    var once: bool = false
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        if ulib.streq(ulib.arg_at(args, a), (&a_once[0 as usize]) as u64) {
            once = true
        }
        if ulib.streq(ulib.arg_at(args, a), (&a_head[0 as usize]) as u64) && a + 1 < argc {
            let dp: *mut u8 = ulib.arg_at(args, a + 1) as *mut u8
            let d: u64 = (*dp) as u64
            if d >= 48 && d < 56 {
                head_arg = 1
                my_head = d - 48
            }
        }
        a = a + 1
    }
    if head_arg == 0 {
        let _dm: bool = displaymode.apply_saved()
    }
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_melde = 1
    }
    let _mk: u64 = msg.init()
    if !fuiscene.begin() {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    // ROUND FUI-TEXT: the type of this program is set by fUi.
    let _ft: bool = fuiglyph.install()
    let _t0: u64 = wlibc.theme_reload()
    // ROUND NETVIEW, addendum: the seven pictures, once, at the start.
    // A bar that reads them every repaint would read them sixty times a
    // second for something that never changes.
    icons_load()
    sw = wlibc.screen_w()
    sh = wlibc.screen_h()
    let _hs: bool = head_setup()
    asc = wlibc.ascent_of(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY))
    cf_height = def_h()
    cf_width = DEF_V
    if conf_read() {
        cf_from_file = 1
    }
    geometry()
    // THE WINDOW IS CREATED AS LARGE AS THE LARGEST CONFIGURATION AND
    // NOT AS LARGE AS THE CURRENT ONE. `win_size` can shrink a window
    // and can grow it back, but it cannot grow it past the buffer it
    // was created with -- and a bar that starts at the bottom (800 x 28,
    // 89 kilooctets) and is dragged to the left (104 x 600, 249) would
    // be refused at exactly that moment.
    // r381: window 0 of the scene host. Its buffer holds the area of the largest
    // configuration (a vertical bar V_MAX wide, or a horizontal one h_max() high),
    // laid out as w x h with w = the screen's width.
    // r1004: the buffer is sized for a screen up to 3840x2160 (never less than the current one): a window can shrink inside its buffer
    // but never grow past it, and the host may enlarge the screen while the bar runs.
    var ref_w: u64 = 3840
    var ref_h: u64 = 2160
    if sw > ref_w {
        ref_w = sw
    }
    if sh > ref_h {
        ref_h = sh
    }
    var area: u64 = V_MAX * ref_h
    if ref_w * h_max() > area {
        area = ref_w * h_max()
    }
    let cw0: u64 = sw
    let ch0: u64 = (area + sw - 1) / sw
    // On layer L_TOP from the start: a window that is created on L_NORMAL takes the keyboard
    // focus from the program the person is typing in (barpop: `notify hello toast` went into
    // the bar). A program that may not use L_TOP (not root) falls back to L_NORMAL, as the
    // raw window did, and the code below says so.
    var made: bool = fuiscene.open_plain(0, 0, cw0, ch0, txt((&k_title[0 as usize]) as u64,
        (&s_title[0 as usize]) as u64), wlibc.L_TOP, bar_build)
    if !made {
        made = fuiscene.open_plain(0, 0, cw0, ch0, txt((&k_title[0 as usize]) as u64,
            (&s_title[0 as usize]) as u64), wlibc.L_NORMAL, bar_build)
    }
    if !made {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    let h: u64 = fuiscene.handle()
    if ulib.bad(h) || h == 0 {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    w_h = h
    bar_cap = cw0 * ch0 * 4
    bar_r = rt.heap_alloc(bar_cap as usize) as u64
    if bar_r == 0 {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    fuiscene.set_raw(bar_raw)
    fuiscene.set_overlay(bar_overlay)
    bar_ready = 1
    if ulib.bad(wlibc.win_state(h, wlibc.WS_DECO, 0)) {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    if ulib.bad(wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_TOP)) {
        say((&s_nol[0 as usize]) as u64)
        nl()
        let _ln: u64 = wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_NORMAL)
        cf_ontop = 0
    }
    apply()
    let _u: bool = status_build()
    let _pb: bool = plugbar_read()
    let _l: bool = list_read()
    // THIRD ADDENDUM: the quick settings own a second window of this
    // process, created here and kept hidden. Opening it is a move and a
    // repaint and NOT a program start -- which is why it can be timed
    // in microseconds.
    if !qs.init(cf_autohide) {
        say((&s_noqs[0 as usize]) as u64)
        nl()
    }
    // the tooltip and the toast: one window each on the scene host (after qs.init,
    // which reserves window 0 for the bar's own window)
    if !barpop.init() {
        say((&s_nobp[0 as usize]) as u64)
        nl()
    }
    // r387: the task view card (hidden until its button is pressed)
    if !traypop.init() {
        say((&s_notp[0 as usize]) as u64)
        nl()
    }
    // P-011: the calendar popup (opened by a press on the clock field)
    if !calpop.init() {
        say((&s_nocp[0 as usize]) as u64)
        nl()
    }
    if !taskview.init() {
        say((&s_notv[0 as usize]) as u64)
        nl()
    }
    if !notifc.init() {
        say((&s_nonc[0 as usize]) as u64)
        nl()
    }
    if !fpsov.init() {
        say((&s_nofo[0 as usize]) as u64)
        nl()
    }
    let _tmi: bool = testmark.init()
    apply()
    layout()
    paint(false)
    say((&s_steht[0 as usize]) as u64)
    sayn(win_x)
    say((&s_gy[0 as usize]) as u64)
    sayn(win_y)
    say((&s_gw[0 as usize]) as u64)
    sayn(win_w)
    say((&s_gh[0 as usize]) as u64)
    sayn(win_h)
    nl()
    say((&s_lg[0 as usize]) as u64)
    say(msg.lang())
    say((&s_lgs[0 as usize]) as u64)
    sayn(msg.lang_source())
    say((&s_lgk[0 as usize]) as u64)
    sayn(_mk)
    nl()
    say((&s_ico[0 as usize]) as u64)
    sayn(ic_ok)
    say((&s_icm[0 as usize]) as u64)
    sayn(mk_ok)
    say((&s_ics[0 as usize]) as u64)
    sayn(sy_ok)
    say((&s_icf[0 as usize]) as u64)
    sayn(ic_files)
    say((&s_icn[0 as usize]) as u64)
    sayn(ic_min)
    nl()
    conf_say()
    shape_say()
    say((&s_rdy[0 as usize]) as u64)
    say((&s_eq[0 as usize]) as u64)
    sayn(asc)
    nl()
    paint(true)
    geom_say()
    health_say()
    var s_dk: [u8; 17] = "taskbar: deko n=\0"
    say((&s_dk[0 as usize]) as u64)
    sayn(wlibc.deco_push())
    // ROUND PAINT: and the FORM right after the colour.  Both come from
    // the same resolved token set, so they have to be pushed together
    // or a `modern` window would get modern colours and classic corners
    // for one repaint.
    var s_fm: [u8; 15] = "  form n=\0\0\0\0\0\0"
    say((&s_fm[0 as usize]) as u64)
    sayn(wlibc.form_push())
    nl()
    glas_say()
    if once {
        return 0
    }
    var round: u64 = 0
    var tsum: u64 = wlibc.theme_sum()
    var alive: bool = true
    // W-W (18.10.2026): quiet backoff -- see the end of the loop
    var quiet: u64 = 0
    // W-C3g: pollers are DUE-based, not `round % N`. In quiet mode `round` advances by 2, so its parity at the check was fixed:
    // with the wrong parity `round % 8` (heads_step) and `round % 10` NEVER hit and the bar never followed a resolution change.
    var due8: u64 = 8
    var due5: u64 = 5
    var due10: u64 = 10
    var q_mx: u64 = 0
    var q_my: u64 = 0
    while alive {
        // r381: the events of the bar's window come through the host (`bar_raw` for the
        // pointer), a node pressed through the tree comes back from `bar_pump`
        bar_pump()
        if !fuiscene.alive() {
            alive = false
        }
        if pdrag != 0 {
            pin_drag_step()
        }
        if dragging != 0 {
            drag_step()
        }
        // THIRD ADDENDUM. The panel polls its own window, the hotkey
        // latch and the pointer; the only thing it hands back is the
        // one setting that lives in a FILE THIS BAR OWNS. Two writers
        // of `/etc/taskbar.conf` inside one process would be two
        // answers to one question.
        let _qsc: bool = qs.step()
        let _tvs: bool = taskview.step()
        let _tps: bool = traypop.step()
        let _cps: bool = calpop.step()
        notifc.set_bell(f_x[(F_NOTI) as usize], f_y[(F_NOTI) as usize],
            f_w[(F_NOTI) as usize], f_h[(F_NOTI) as usize])
        let _ncs: bool = notifc.step()
        let _fos: bool = fpsov.step()
        let _tms: bool = testmark.step()
        hotkey_step()
        tip_step()
        toast_step()
        kontext_step()
        let hw: u64 = qs.want_hide()
        if hw != 0 {
            if hw == 1 {
                cf_autohide = 1
            } else {
                cf_autohide = 0
            }
            let _cw: bool = conf_write()
            conf_say()
            geometry()
            shown = 1
            apply()
            layout()
            paint(true)
            geom_say()
            qs.took_hide(cf_autohide)
        }
        autohide_step()
        round = round + 1
        if round >= due8 {
            due8 = round + 8
            heads_step()
            if quit_req != 0 {
                alive = false
            }
        }
        var fresh: bool = false
        // ROUND NETVIEW, addendum. Every poll, because the pointer
        // moves between polls and a sentence that appears half a second
        // after the pointer arrived is a sentence nobody waits for. It
        // costs a comparison unless something changed.
        if hover_step() {
            fresh = true
        }
        if dnd_bar_step() { // W-DND
            fresh = true
        }
        if round >= due5 {
            due5 = round + 5
            if list_read() {
                fresh = true
            }
        }
        // ==================================== RUNDE ACPI-EREIGNISSE
        let evc: u64 = ulib.sys(SYS_PWRGET, PG_EVCHANGE, 0, 0)
        if !ulib.bad(evc) && evc != 0 {
            ev_seen = ev_seen + 1
            if (evc & (EV_BATT | EV_AC)) != 0 {
                if status_build() {
                    fresh = true
                }
            }
        }
        if round >= due10 {
            due10 = round + 10
            ub_sb = ub_sb + 1
            if status_build() {
                ub_sbt = ub_sbt + 1
                fresh = true
            }
            if plugbar_read() {
                fresh = true
            }
            let tpoll: bool = wlibc.theme_poll()
            let tjetzt: u64 = wlibc.theme_sum()
            if tpoll || tjetzt != tsum {
                tsum = tjetzt
                var s_dk2: [u8; 22] = "taskbar: deko neu n=\0\0"
                say((&s_dk2[0 as usize]) as u64)
                sayn(wlibc.deco_push())
                nl()
                let _fk: u64 = wlibc.form_push()
                glas_say()
                fresh = true
                let _qt: bool = qs.theme_new()
            }
            let slowp: bool = slow_poll_due()
            if slowp && msg.changed() {
                let _s2: bool = status_build()
                fresh = true
            }
            // AND THE CONFIGURATION. This is how a change made in
            // /bin/settings arrives here without a restart: the
            // settings write the file, the bar notices within half a
            // second. There is no message, no shared memory and no
            // second copy of the state -- there is the file.
            let old_e: u64 = cf_edge
            let old_h: u64 = cf_height
            let old_w: u64 = cf_width
            let old_a: u64 = cf_autohide
            let old_o: u64 = cf_ontop
            if slowp && conf_read() {
                if cf_edge != old_e || cf_height != old_h
                    || cf_width != old_w || cf_autohide != old_a
                    || cf_ontop != old_o {
                    conf_say()
                    geometry()
                    shown = 1
                    apply()
                    fresh = true
                    geom_say()
                }
            }
        }
        if fresh && shown != 0 {
            layout()
            // REPORTED, NOT JUST PAINTED -- and the difference cost two
            // measurements. The first version reported the layout only
            // on the very first paint. By the time the screenshot was
            // taken the starter had opened a window, the buttons had
            // been re-laid out and re-shortened, and the runner was
            // comparing the picture against a layout replaced seconds
            // earlier. Every repaint now says what it painted.
            paint(true)
            say((&s_stt[0 as usize]) as u64)
            sayn(nk)
            say((&s_pm[0 as usize]) as u64)
            sayn(paints)
            say((&s_ck[0 as usize]) as u64)
            sayn(clicks)
            say((&s_ac[0 as usize]) as u64)
            sayn(acts)
            say((&s_wt[0 as usize]) as u64)
            sayn(writes)
            say((&s_fui[0 as usize]) as u64)
            sayn(fuib.fui_painted())
            say((&s_fuix[0 as usize]) as u64)
            sayn(fuib.fui_rejected())
            say((&s_fuig[0 as usize]) as u64)
            sayn(fuib.fui_reasons())
            nl()
        }
        // AND ONCE MORE BEFORE THE SLEEP. Measured, not guessed: with
        // one look per turn the hotkey took 93 to 128 milliseconds,
        // because a key pressed early in a turn waits out the whole
        // repaint of the bar -- WITH its report on the serial line --
        // before anything looks at the latch. A second look here costs
        // one system call and takes the repaint out of the wait.
        let _qs2: bool = qs.step()
        ub_round = ub_round + 1
        if ub_round >= ub_naechster {
            ub_naechster = ub_round + 200
            say((&s_ur[0 as usize]) as u64)
            sayn(ub_round)
            say((&s_usb[0 as usize]) as u64)
            sayn(ub_sb)
            say((&s_usbt[0 as usize]) as u64)
            sayn(ub_sbt)
            say((&s_upx[0 as usize]) as u64)
            sayn(ub_px)
            say((&s_usoll[0 as usize]) as u64)
            sayn(ub_soll)
            say((&s_unull[0 as usize]) as u64)
            sayn(ub_null)
            say((&s_upm[0 as usize]) as u64)
            sayn(paints)
            say((&s_uqw[0 as usize]) as u64)
            sayn(ub_qwhy)
            say((&s_uq[0 as usize]) as u64)
            sayn(ub_quiet)
            ub_qwhy = 0
            nl()
        }
        // W-W (18.10.2026): QUIET BACKOFF. VirtualBox idle desktop: the bar showed ~36 % of
        // a core with nothing happening (40 rounds/s x ~15 pollers). After QUIET_ROUNDS
        // rounds (2 s) without ANY sign of life -- nothing repainted, no popup or drag
        // moving, no power event, pointer still -- the bar sleeps 50 ms instead of 25 ms
        // and counts that round double, so the `round % N` pollers (window list, status,
        // theme, conf) keep their rate in time (list_read: 250 ms instead of 125 ms).
        // Any sign of life brings the 25 ms rhythm back at once.
        let mxn: u64 = wlibc.mouse_x()
        let myn: u64 = wlibc.mouse_y()
        var qwhy: u64 = 0
        if fresh { qwhy = qwhy | 1 }
        if _qsc || _tvs || _tps || _cps || _ncs || toast_up() { qwhy = qwhy | 2 }
        if hw != 0 || pdrag != 0 || dragging != 0 { qwhy = qwhy | 4 }
        if evc != 0 && !ulib.bad(evc) { qwhy = qwhy | 8 }
        if mxn != q_mx || myn != q_my { qwhy = qwhy | 16 }
        ub_qwhy = ub_qwhy | qwhy
        if qwhy != 0 {
            quiet = 0
        } else {
            quiet = quiet + 1
        }
        ub_quiet = quiet
        q_mx = mxn
        q_my = myn
        if quiet > QUIET_ROUNDS {
            round = round + 1
            ulib.sleep_ms(50)
        } else {
            ulib.sleep_ms(25)
        }
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
