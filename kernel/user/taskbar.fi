// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/taskbar.fi -- THE TASKBAR, /bin/taskbar.
//
// (The file was `leiste.fi` until round LOOK's addendum. Round RENAME
// had renamed suchen/starter/wigdemo and left the three biggest files
// of the desktop alone, because four rounds were editing them at the
// same time. Names of files, programs and commands in Osum are
// English; German is for the text a person reads on the screen and
// for the comments in this tree.)
//
// WHAT IT SHOWS. A start button that opens `/bin/launcher`; one button
// per ordinary window that switches to it, or minimizes it if it is
// already the active one (`WA_TOGGLE`); and three status fields fed
// from system calls and from nothing else: the network address
// (`osum_netget`), the battery (`osum_pwrget`, round K18) and the
// clock (`sysinfo`, round K9). A battery percentage that this machine
// cannot measure is not printed as zero, it is printed as "no battery".
//
// ==================== WHAT THIS ADDENDUM ADDS: THE EDGE ==============
//
// Justin asked on 27.08.2026 whether the bar can be dragged to another
// screen edge, the way Windows 10 could and Windows 11 no longer can.
// It could not: `taskbar.fi` had no position at all, the bar was at the
// bottom because `py = sh - PH` was written into the source. It can
// now, and in the two ways one expects:
//
//   1. DRAG IT. Press the left button on an empty part of the bar and
//      move the pointer towards an edge. A preview RECTANGLE follows
//      the pointer -- four thin always-on-top windows drawn in the
//      selection colour, which is an outline and not a filled sheet
//      because a filled 128 x 600 window is 300 kilooctets and this
//      process has 832 for everything. Let go, and the bar is there.
//   2. SET IT. /bin/settings, page "Darstellung".
//
//   BOTH WRITE THE SAME FILE, /etc/taskbar.conf, and neither keeps a
//   second copy of the answer anywhere:
//
//       edge=bottom       bottom | top | left | right
//       height=28         thickness of a HORIZONTAL bar
//       width=104         thickness of a VERTICAL bar
//       autohide=0        1 = slide out until the pointer touches the edge
//       ontop=1           1 = always above ordinary windows
//
//   Two thickness keys and not one, because they are two different
//   numbers: 28 pixels is a good height for a horizontal bar and a
//   useless width for a vertical one. Windows keeps them apart for the
//   same reason.
//
// A VERTICAL BAR IS NOT A ROTATED HORIZONTAL ONE. The window buttons
// stack downwards instead of sideways, the start button sits at the
// top, and the three status fields sit at the bottom, one above the
// other. Each status field measures its own text (`text_w`) against the
// width it has: if it does not fit it WRAPS onto a second line -- the
// address 10.0.2.15 becomes "10.0." and "2.15" -- and only if even that
// fails does it shorten, and then it reports the SHORTENED text so that
// what the runner checks character by character is what is on screen.
// Nothing is silently clipped.
//
// AND THE WORK AREA MOVES WITH IT. The bar tells the server which edge
// it occupies (WM_STRUT, see kernel/wm.fi); the server subtracts every
// such reservation from the screen and calls the rest the work area.
// A maximized window fills the work area and follows it when the bar
// moves. That is the same idea as `_NET_WM_STRUT` in X11, and it is
// what the round TILING needs as the root rectangle of its frame tree.
//
// WHAT IT MAY DO AND WHY. `WM_LIST` and `WM_ACT` answer only to a
// process that has reserved a screen edge -- that is, to a panel, and
// reserving an edge needs root. An ordinary application gets -E_RIGHTS
// and does not see the titles of other processes.

// ================================================ RUNDE 31: profile app
//
// DIE TASKLEISTE IST DIE WURZELDATEI, UND DAS PROFIL HAENGT AN IHR
// (compiler/src/prof.rs, dokumentiert in kernel/user/certus/build.sh).
//
// Sie braucht `app`, weil ihre Bedienelemente ab dieser Runde aus fUi
// kommen (wlib -> fuib -> lib/fui): fUi rechnet Geometrie in `f64` und
// benutzt `std.rt`, und beides ist im Profil `kernel` gesperrt -- die
// Gleitkommaregel steht in SPEC.md:125 ("Floating point | kernel: only
// with #[allow_fp] | app: free").
//
// WAS SICH DADURCH *NICHT* AENDERT: wlib.fi, wlibc.fi, qs.fi und die
// uebrigen Module bleiben `profile kernel`. Gemessen: nur die WURZEL
// muss `app` sein, die Module darunter uebersetzen unveraendert weiter.
// Das ist der Grund, warum diese Umstellung drei Zeilen ist und nicht
// zweiundzwanzig Dateien.
//
// WAS SICH BEIM BINDEN AENDERT: unter `app` legt firnc seinen eigenen
// `_start` hinein (vier Befehle, dieselben wie in crt.s). Also OHNE
// crt.o binden, sonst ist `_start` zweimal definiert -- genau wie
// kernel/user/certus/build.sh es fuer Certus macht.
profile app

import ulib
import libc.io
import wlibc
import wlib
import brand_start
import nv
import icons
import msg
import qs
// RUNDE 31: nur fuer die zwei Zaehler im Bericht (fui=/fuix=).
import fuib

export { u_start }

// ------------------------------------------------------------ numbers

const PAD0: u64 = 3 // margin between the bar edge and its contents
const GAP0: u64 = 4 // between two elements
const BTN_H0: u64 = 22 // height of every button, in both orientations
// RUNDE OBERFLAECHE: LINE_H und START_W sind Marken geworden --
// `line_h()` ist die Zeilenhoehe der Hilfstext-Stufe, `start_w()`
// zwei Klickflaechen breit.  Die zwei Zahlen, die hier standen,
// waren die der Hausform, bevor es sie gab.
const SLIVER: u64 = 2 // what is left of a hidden bar
const REVEAL: u64 = 2 // pointer this close to the edge brings it back
const BAND: u64 = 80 // rows of the drawing surface used at a time
const TASK_MAX: u64 = 132
const TASK_MIN: u64 = 48
const MAXK: u64 = 10 // that many window buttons at most
// ==================================================== RUNDE ANHEFTEN
// ANGEHEFTETE PROGRAMME. Justins Wunsch: Certus ab Werk in der Leiste,
// wie bei Windows -- das Symbol steht dort, OB DAS PROGRAMM LAEUFT
// ODER NICHT. Klick startet es; laeuft es schon, holt der Klick das
// Fenster nach vorn, statt ein zweites zu oeffnen.
//
// WARUM EINE EIGENE LISTE UND NICHT EIN FLAG AN kapp[]: die
// Fensterliste kommt vom Server und ist fluechtig -- sie kennt nur,
// was JETZT laeuft. Ein angehefteter Knopf muss aber gerade dann
// dastehen, wenn nichts laeuft. Also zwei Quellen, EIN Streifen
// Knoepfe: erst die Anhefter, dann die uebrigen Fenster.
const MAXPIN: u64 = 6

const PREV_T: u64 = 3 // thickness of the preview outline

// ================================== ROUND LOOK: WHERE THE BUTTONS SIT
//
// Windows 11 centres the start button and the window buttons and leaves
// the status corner where it was.  Windows 10 and everything before it
// put them at the left.  Both are defensible and neither is a law, so
// this is a SETTING and not a redesign -- `align=` in
// /etc/taskbar.conf, and the DEFAULT IS `left`, because a round that
// moves a user's start button without being asked has broken something
// that was not broken.
//
// WHAT IS CENTRED AND WHAT IS NOT. The start button and the window
// buttons are one group and they move together; the three status
// fields do NOT move.  That is not an imitation of Windows for its own
// sake, it is the only arrangement that survives a window opening: a
// centred group grows from the middle outwards, and if the clock were
// part of it, the clock would jump sideways every time a program
// started.  A corner does not move.
//
// AND IT WORKS ON A VERTICAL BAR TOO, where "centre" means centred in
// the HEIGHT between the top edge and the topmost status field.  A
// setting that silently does nothing in one of four configurations is
// worse than no setting.
const AL_LEFT: u64 = 0
const AL_CENTER: u64 = 1

// The limits of the two thicknesses. They are limits and not
// suggestions: `win_size` cannot grow the window past the buffer it was
// created with, and that buffer is V_MAX * screen height.
const H_MIN0: u64 = 20
const H_MAX0: u64 = 40
const V_MIN: u64 = 56
const V_MAX: u64 = 128
const DEF_H0: u64 = 28
const DEF_V: u64 = 104

// The status fields, bottom-up in a vertical bar and right to left in
// a horizontal one.
//
// ROUND TON-2 ADDED THE VOLUME, and it sits BEFORE the battery on
// purpose: the order here is the order on the bar, and every system
// that has both puts the speaker next to the clock, not out at the
// edge. It follows the same rule as the two before it -- NO SOUND
// CARD, NO FIELD (`snd_da`), because a symbol stands for something the
// machine HAS.
const F_NET: u64 = 0
// MERGE-8: TON-2 (F_SND) und SYSTEMBUS (F_NOTI) haben BEIDE von 1 an
// weitergezaehlt -- jeder Zweig fuer sich richtig, zusammen zweimal die
// 1/2/3. Die Felder sind ein zusammenhaengender Bereich 0..F_N (beide
// Anordnungsketten laufen ihn ab), also bekommt jedes Feld GENAU EINE
// Nummer und F_N waechst auf 5.
const F_SND: u64 = 1
const F_BAT: u64 = 2
const F_CLK: u64 = 3
// RUNDE SYSTEMBUS: das fuenfte Statusfeld -- die Glocke. Es ist ein FELD
// wie die anderen und keine Sonderbehandlung: dadurch bekommt es
// Anordnung, Ausrichtung, Bericht und Neuzeichnen umsonst und richtig,
// und die Leiste hat weiterhin genau EINE Stelle, an der Statusfelder
// gebaut werden.
const F_NOTI: u64 = 4
const F_N: u64 = 5

// The calls this bar needs besides the window server.
// ROUND TON-2: the sound interface. Same numbers as /bin/play,
// /bin/qs and kernel/sys.fi -- one way to a thing, not two.
const SYS_AUDGET: u64 = 1850
const SYS_AUDSET: u64 = 1851
const AS_MUTE: u64 = 2
const A_READY: u64 = 0
const A_VOLUME: u64 = 4
const A_MUTED: u64 = 21
const A_VOLGEN: u64 = 44

const SYS_PWRGET: u64 = 1750
const PG_BATPRESENT: u64 = 24
const PG_BATPERCENT: u64 = 25
// ROUND LOOK: bit 1 is the ACPI _BST charging bit. Same number as in
// kernel/sys.fi and kernel/user/power.fi -- the numbers are the
// interface to ring 3 and this bar does not invent a second one.
const PG_BATSTATE: u64 = 27
const SYS_NETGET: u64 = 1300
const NG_READY: u64 = 0
const NG_IP: u64 = 1
// ROUND NETVIEW, addendum.
const NG_MASK: u64 = 2
const NG_GW: u64 = 3
const NG_STATE: u64 = 8
// ROUND NETVIEW, second addendum: the systemwide fallback. Asked
// through NETVGET, which anybody may ask about anything -- see
// `sys.do_netvget`; a bar that could not read it could not be honest
// about it.
const SYS_NETVGET: u64 = 1310
const NV_FALLBACK: u64 = 13
const NV_FBVIEW: u64 = 14

// The two icon sets. `/etc/netview/` is where the image puts them, and
// a bar that does not find them falls back to text -- a missing icon
// must not take the address off the screen with it.
const ICON_MAX: u64 = 1100
const MARK_MAX: u64 = 640
// RUNDE ECHTHARDWARE-2: GRUNDWERTE. `ic_w()` und `mk_w()` weiter
// unten nehmen die Vervielfachung mit -- seit `wlibc.icon_draw` das
// Bild vergroessert, muss der Platz dafuer mitwachsen, sonst malt das
// groessere Symbol ueber den Text daneben.
const IC_W0: u64 = 16
const MK_W0: u64 = 12
// ROUND LOOK: the side of a status glyph. `wlibc.icon_small()` is the
// size the icon font was cut and measured for (docs/ICONS.md: 25.0
// solid pixels per icon at 16, against 11.4 for the runner-up), so
// it is the size that is used, and it is written here once.
const GL_W0: u64 = 16 // = wlibc.icon_small()

// ================================ ROUND LOOK: THE SYMBOLS IN THE CORNER
//
// Justin looked at the booted image and said: no symbol for the battery
// and none for the network, only text. He was right, and there were two
// separate reasons.
//
//   * THE NETWORK had a symbol since round NETVIEW -- an OSYM bitmap
//     out of /etc/netview/. The image simply did not carry the
//     directory, so `icons_load` counted 0 and the bar fell back to
//     text, exactly as it is supposed to. That is fixed in the image
//     (tools/look/shot.sh) and NOT here.
//   * THE BATTERY never had one at all. Round K18 gave the bar a
//     percentage and round ICONS gave the system six battery glyphs,
//     and nothing ever joined the two.
//
// So this round adds the glyph path, and it adds it BENEATH the OSYM
// path and not instead of it: `tools/netview/run.sh` reads the state
// pictures pixel by pixel out of the screenshot, and a round that
// swapped them for something else would have broken twenty-nine
// assertions to change a picture nobody complained about. The order is
//
//   1. the OSYM file from /etc/netview/  (round NETVIEW, measured there)
//   2. the glyph from /lib/icons.ttf     (this round)
//   3. the text alone                    (round DESKTOP, still true)
//
// and each step is only taken when the one before it has nothing.
//
// NO SYMBOL FOR SOMETHING THE MACHINE CANNOT MEASURE. The battery
// grades come from `PG_BATPERCENT` and `PG_BATSTATE`, both out of the
// kernel's ACPI reader; when `PG_BATPRESENT` is 0 the symbol is
// BATTERY_ABSENT, which is a statement about the firmware's answer and
// not a decoration for a missing one. The four network grades are the
// four states `sys.NG_STATE` already computes -- this bar does not ask
// three questions and draw its own conclusion.

// The grade of the battery, as a code point out of lib/icons.fi.
// The thresholds are the ones Lucide draws for: `battery-full` has
// three bars, `battery-medium` two, `battery-low` one, `battery` none.
// So the cuts are at thirds, not at some rounder-looking number --
// a symbol with two bars that means "over 35 percent" is a symbol
// that is telling a third of a truth.
// RUNDE SCHIRM: die Masse der Leiste sind Grundmasse mal der
// Vervielfachung des Servers. Eine Leiste von 28 Bildpunkten ist auf
// 3840x2160 ein Streifen, in dem kein Buchstabe mehr Platz hat -- und
// die Schrift darin waechst seit dieser Runde mit.
// ================================================== RUNDE OBERFLAECHE
//
// DIE LEISTE RECHNET NICHT MEHR SELBST.
//
// Bis hierher standen ihre Masse als eigene Konstanten in dieser Datei:
// PAD0 = 3, GAP0 = 4, BTN_H0 = 22, DEF_H0 = 28.  Vier Zahlen, die kein
// Formsatz erreichen konnte -- die Leiste zog also KEINE Aenderung an
// Abstaenden, Hoehen oder Klickflaechen mit, und sie ist die Flaeche,
// die man immer sieht.  Gemessen hat es `tools/design/messen.py`: von
// 824 gemeldeten Laengen der ganzen Oberflaeche lagen 166 auf dem
// Viererraster, und 559 der Ausreisser kamen aus dieser Datei allein.
// Drei ist kein Vielfaches von vier, und 22 auch nicht.
//
// Jetzt kommen sie aus denselben Marken wie alles andere:
//
//   pad     spacing_xs   der Rand zwischen Leistenkante und Inhalt
//   gap     spacing_s    zwischen zwei Knoepfen
//   btn_h   ctrl_h       die Klickflaeche -- die Zusage "mindestens 32"
//   def_h   ctrl_h + 2*spacing_xs   die Dicke, wenn niemand sie vorgibt
//
// UND btn_h WIRD BEGRENZT.  Eine Leiste ist so dick, wie ihre Datei
// sagt; ein Knopf, der hoeher ist als sie, wird nicht hoeher, er wird
// abgeschnitten.  Das Kappen steht hier und nicht in `layout`, weil es
// sonst an vier Stellen stehen muesste (waagerecht, senkrecht,
// Startknopf, Fensterknopf) und an einer davon vergessen wuerde.
fn pad() -> u64 {
    return wlibc.space(0)
}

fn gap() -> u64 {
    return wlibc.space(1)
}

fn btn_h() -> u64 {
    var h: u64 = wlibc.metric(wlibc.M_CTRL_H)
    var raum: u64 = thick
    if raum > 2 * pad() {
        raum = raum - 2 * pad()
    } else {
        raum = thick
    }
    if h > raum {
        h = raum
    }
    if h == 0 {
        h = BTN_H0 * wlibc.ui_scale()
    }
    return h
}

fn h_min() -> u64 {
    return H_MIN0 * wlibc.ui_scale()
}

fn h_max() -> u64 {
    return H_MAX0 * wlibc.ui_scale()
}

// Die Dicke, die eine Leiste OHNE Eintrag in ihrer Datei bekommt: die
// Klickflaeche plus der Rand oben und unten.  Unter `classic` sind das
// 26 + 2*2 = 30, unter der Hausform 32 + 2*4 = 40 -- und beides ist ein
// Ergebnis und keine getippte Zahl.  Frueher stand hier 28, und 28 war
// weder das eine noch das andere.
fn def_h() -> u64 {
    let v: u64 = wlibc.metric(wlibc.M_CTRL_H) + 2 * wlibc.space(0)
    if v < h_min() {
        return h_min()
    }
    if v > h_max() {
        return h_max()
    }
    return v
}

// Eine Zeile eines Statusfeldes.  Das ist die Zeilenhoehe der
// HILFSTEXT-Stufe (`TY_CAPTION`) und nicht mehr die 13, die hier stand:
// eine Uhrzeit und eine Netzadresse sind Hilfstext, und sie sollen
// dieselbe Zeilenhoehe haben wie jeder andere Hilfstext des Systems.
fn line_h() -> u64 {
    return wlibc.type_lh(wlibc.TY_CAPTION)
}

// Die Breite des Startknopfes MIT Wort: zwei Klickflaechen breit, auf
// das Raster gelegt.  Unter `classic` sind das 52, unter der Hausform
// 64 -- die 64, die hier als Konstante stand, war die der Hausform,
// bevor es sie gab.
fn start_w() -> u64 {
    return wlibc.snap(btn_h() * 2)
}

// ==================================================== RUNDE ECHTHARDWARE-3
// DAS SYMBOL WAECHST MIT DER LEISTE UND NICHT NUR MIT DEM SCHIRM.
//
// Justins Befund: "Programm-Icons in der Taskleiste sind nicht mittig
// und haben die falsche Groesse." Die Mitte hat Runde ECHTHARDWARE-2
// gerichtet (gemalte statt geplanter Hoehe); die GROESSE stand noch
// immer fest: 16 mal die Vervielfachung des Schirms, und sonst nichts.
//
// Die Leiste ist aber nicht so hoch, wie der Schirm gross ist -- ihre
// Dicke kommt aus dem Formsatz (`def_h`: M_CTRL_H + zweimal Rand) und
// aus `/etc/taskbar.conf`. Auf einer dicken Leiste schwimmt ein 16er
// Symbol in der Mitte, auf einer duennen stoesst es oben und unten an.
//
// Also richtet es sich nach dem KNOPF, in dem es sitzt: zwei Drittel
// seiner Hoehe, gerundet auf ein Vielfaches der Vervielfachung (ein
// Symbol auf halbem Bildpunkt waere unscharf), und nach unten wie nach
// oben begrenzt. Bei der Vorgabe (Knopf 32) kommt genau die alte 16
// heraus -- die bisherigen Bildpunktzusagen bleiben damit gueltig.
fn gl_w() -> u64 {
    let sk: u64 = wlibc.ui_scale()
    let h: u64 = btn_h()
    if h == 0 {
        return GL_W0 * sk
    }
    var v: u64 = h * 2 / 3
    // auf ein Vielfaches der Vervielfachung runden
    v = (v / sk) * sk
    let unten: u64 = 12 * sk
    let oben: u64 = 32 * sk
    if v < unten {
        v = unten
    }
    if v > oben {
        v = oben
    }
    return v
}

// Die beiden Masse, die es bis zu dieser Runde nur als feste Zahl gab.
// Sie stehen hier und nicht als Konstante, weil `ui_scale()` erst zur
// Laufzeit bekannt ist -- eine Konstante koennte sie nicht kennen.
fn ic_w() -> u64 {
    return IC_W0 * wlibc.ui_scale()
}

fn mk_w() -> u64 {
    return MK_W0 * wlibc.ui_scale()
}

// ROUND TON-2: THE VOLUME, AS A SHAPE.
//
// Three steps and a cross, and the thresholds are the same idea as the
// battery's four: at sixteen pixels a number cannot be read, an
// outline can. Muted is its OWN shape and not a colour -- "silent" has
// to be visible to someone who cannot separate grey from red.
fn snd_icon() -> u64 {
    if snd_mute != 0 {
        return icons.VOLUME_MUTED
    }
    if snd_vol == 0 {
        return icons.VOLUME_ZERO
    }
    if snd_vol >= 50 {
        return icons.VOLUME_HIGH
    }
    return icons.VOLUME_LOW
}

fn bat_icon() -> u64 {
    if bat_have == 0 {
        return icons.BATTERY_ABSENT
    }
    if bat_chg != 0 {
        return icons.BATTERY_CHARGING
    }
    if bat_pct >= 67 {
        return icons.BATTERY_FULL
    }
    if bat_pct >= 34 {
        return icons.BATTERY_MEDIUM
    }
    if bat_pct >= 10 {
        return icons.BATTERY_LOW
    }
    return icons.BATTERY_EMPTY
}

// And its colour -- a ROLE and not a value, so it is right in every
// scheme. Below ten percent the thing is an alarm and says so; the
// rest of the time it is text and looks like text.
// ROUND TON-2: stumm wird GEDAEMPFT gezeichnet, und das ist die
// zweite Haelfte der Aussage neben der Form. Ein Symbol, das nur
// blasser ist, sagt zu wenig; eines, das nur eine andere Form hat,
// faellt in einer vollen Leiste nicht auf. Beides zusammen ist
// eindeutig.
fn snd_colour() -> u64 {
    if snd_mute != 0 {
        return wlibc.theme(wlibc.T_DIM)
    }
    return wlibc.theme(wlibc.T_FG)
}

fn bat_colour() -> u64 {
    if bat_have == 0 {
        return wlibc.theme(wlibc.T_DIM)
    }
    if bat_chg == 0 && bat_pct < 10 {
        return wlibc.theme(wlibc.C_DANGER)
    }
    if bat_chg == 0 && bat_pct < 20 {
        return wlibc.theme(wlibc.C_WARNING)
    }
    return wlibc.theme(wlibc.T_FG)
}

// The four states of the machine, as glyphs. Same four the OSYM
// pictures draw and in the same order, because they are the same four
// states -- `sys.NG_STATE` numbers them and nothing here renumbers them.
//   0 no carrier  nothing plugged in        -> unplug
//   1 no address  carrier, no address yet   -> ban
//   2 no route    address, no way out       -> cloud-off
//   3 online      a way out                 -> cable
fn net_glyph(st: u64) -> u64 {
    if st == 3 {
        return icons.NETWORK_WIRED
    }
    if st == 2 {
        return icons.NETWORK_NO_INTERNET
    }
    if st == 1 {
        return icons.NETWORK_BLOCKED
    }
    return icons.NETWORK_OFFLINE
}

fn net_colour(st: u64) -> u64 {
    if st == 3 {
        return wlibc.theme(wlibc.T_FG)
    }
    if st == 0 {
        return wlibc.theme(wlibc.T_DIM)
    }
    return wlibc.theme(wlibc.C_WARNING)
}

// Is there a glyph path at all? One question, asked once per repaint,
// so that the room reserved in `layout` and the drawing in `paint`
// cannot disagree -- which is the bug round NETVIEW's addendum found
// the hard way when the icon took room it had not been given.
fn glyphs_ok() -> bool {
    return wlibc.icon_have()
}

// ------------------------------------------------------------- state

static mut w_h: u64 = 0
static mut sw: u64 = 0
static mut sh: u64 = 0
static mut asc: u64 = 0

// the configuration, and nothing else in this file decides these five
static mut cf_edge: u64 = 0
static mut cf_align: u64 = AL_LEFT
static mut cf_height: u64 = 28
static mut cf_width: u64 = 104
static mut cf_autohide: u64 = 0
static mut cf_ontop: u64 = 1
// RUNDE STARTKNOPF: die Uhr.
static mut cf_sec: u64 = 0 // Sekunden mitzeigen
static mut cf_date: u64 = 0 // Datum mitzeigen
static mut cf_wday: u64 = 0 // Wochentag mitzeigen
static mut cf_clines: u64 = 1 // 1 = einzeilig, 2 = Uhrzeit ueber Datum
// Die Beschriftung der Programmknoepfe:
//   0 nie (nur Symbol, wie Windows 11)  1 immer  2 solange Platz ist
const LB_NEVER: u64 = 0
const LB_ALWAYS: u64 = 1
const LB_ROOM: u64 = 2
static mut cf_labels: u64 = LB_NEVER
// Ein Feld ohne passende Hardware wird GAR NICHT gezeichnet.
static mut cf_hidemissing: u64 = 1
static mut cf_from_file: u64 = 0

// the geometry derived from it
static mut vertical: u64 = 0
static mut thick: u64 = 28
static mut bar_x: u64 = 0
static mut bar_y: u64 = 0
static mut bar_w: u64 = 800
static mut bar_h: u64 = 28
static mut win_x: u64 = 0
static mut win_y: u64 = 0
static mut win_w: u64 = 800
static mut win_h: u64 = 28
static mut shown: u64 = 1

// the layout
static mut st_x: u64 = 0
static mut st_y: u64 = 0
