profile app

import ulib
import libc.clockapi
import libc.io
import uitheme
import wlibc
import displaymode
import fuiglyph
import msg
import qs
import fuib
import barpop
import traypop
import uikit.uipopmenu
import calpop
import taskview
import notifc
import fpsov
import testmark
import fuiscene
import std.rt
import taskbar.tbbase
import taskbar.tbhover
import taskbar.tbinput
import taskbar.tblayout
import taskbar.tbmetrics
import taskbar.tbpaint
import taskbar.tbpopup
import taskbar.tbstatus

export { u_start }

const PAD0: u64 = 3

const GAP0: u64 = 4

const DEF_H0: u64 = 28

const DEF_V: u64 = 104

const PG_EVREADY: u64 = 45

const PG_LID: u64 = 48

const PG_EVCHANGE: u64 = 53

const EV_BUTTON: u64 = 1

const EV_LID: u64 = 2

const EV_BATT: u64 = 4

const EV_AC: u64 = 8

static mut ev_seen: u64 = 0

static mut ev: [u8; 16] = [0 as u8; 16]

const QUIET_ROUNDS: u64 = 80

static mut ub_qwhy: u64 = 0

static mut ub_round: u64 = 0

static mut ub_sb: u64 = 0

static mut ub_sbt: u64 = 0

static mut ub_naechster: u64 = 0

static mut lk_kbd: [u8; 4] = "kbd\0"

static mut k_title: [u8; 14] = "taskbar.title\0"

static mut c_pt: [u8; 2] = ".\0"

static mut s_ico: [u8; 17] = "taskbar: icons=\0\0"

static mut s_icm: [u8; 8] = " marks=\0"

static mut s_ics: [u8; 7] = " sys=\0\0"

static mut s_icf: [u8; 11] = " dateien=\0\0"

static mut s_icn: [u8; 11] = " kleinste=\0"

static mut s_steht: [u8; 18] = "taskbar: STEHT x=\0"

static mut s_lg: [u8; 16] = "taskbar: lang=\0\0"

static mut s_lgs: [u8; 7] = " src=\0\0"

static mut s_lgk: [u8; 8] = " keys=\0\0"

static mut s_noqs: [u8; 28] = "taskbar: no quick settings\0\0"

static mut s_nonc: [u8; 24] = "taskbar: no notifc host\0"

static mut s_nofo: [u8; 23] = "taskbar: no fpsov host\0"

static mut s_nobp: [u8; 31] = "taskbar: no tooltip/toast host\0"

static mut s_notv: [u8; 27] = "taskbar: no task view card\0"

static mut s_bad: [u8; 23] = "taskbar: no surface\0\0\0\0"

static mut s_nol: [u8; 40] = "taskbar: no layer 2 -- not root?\0\0\0\0\0\0\0\0"

static mut s_rdy: [u8; 22] = "taskbar: ready ascent\0"

static mut s_eq: [u8; 2] = "=\0"

static mut s_stt: [u8; 18] = "taskbar: state n=\0"

static mut s_fui: [u8; 6] = " fui=\0"

static mut s_fuix: [u8; 7] = " fuix=\0"

static mut s_fuig: [u8; 7] = " fuig=\0"

static mut s_pm: [u8; 9] = " paints=\0"

static mut s_ck: [u8; 9] = " clicks=\0"

static mut s_ac: [u8; 7] = " acts=\0"

static mut s_wt: [u8; 9] = " writes=\0"

static mut s_ur: [u8; 16] = "taskbar: round=\0"

static mut s_usb: [u8; 5] = " sb=\0"

static mut s_usbt: [u8; 6] = " sbt=\0"

static mut s_upx: [u8; 5] = " px=\0"

static mut s_usoll: [u8; 7] = " soll=\0"

static mut s_unull: [u8; 7] = " null=\0"

static mut s_upm: [u8; 5] = " pm=\0"

static mut s_uqw: [u8; 5] = " qw=\0"

static mut s_uq: [u8; 4] = " q=\0"

static mut s_title: [u8; 8] = "Taskbar\0"

static mut s_theme: [u8; 11] = "/etc/theme\0"

static mut a_once: [u8; 5] = "once\0"

static mut bar_pump_said: u64 = 0

static mut s_notp: [u8; 20] = "taskbar: no traypop\0"

static mut s_nocp: [u8; 19] = "taskbar: no calpop\0"

static mut s_nopm: [u8; 28] = "taskbar: no popup menu host\0"

fn u_start(args: u64) -> u64 {

    ulib.ignore_children()
    tbmetrics.dbg_setup(args)
    var once: bool = false
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        if ulib.streq(ulib.arg_at(args, a), (&a_once[0 as usize]) as u64) {
            once = true
        }
        if ulib.streq(ulib.arg_at(args, a), (&tbbase.a_head[0 as usize]) as u64) && a + 1 < argc {
            let dp: *mut u8 = ulib.arg_at(args, a + 1) as *mut u8
            let d: u64 = (*dp) as u64
            if d >= 48 && d < 56 {
                tbbase.head_arg = 1
                tbbase.my_head = d - 48
            }
        }
        a = a + 1
    }
    if tbbase.head_arg == 0 {
        let _dm: bool = displaymode.apply_saved()
    }
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        tbbase.s_report = 1
    }
    let _mk: u64 = msg.init()
    if !fuiscene.begin() {
        tbmetrics.say((&s_bad[0 as usize]) as u64)
        tbmetrics.nl()
        return 1
    }

    let _ft: bool = fuiglyph.install()
    let _t0: u64 = wlibc.theme_reload()

    tbmetrics.icons_load()
    tbbase.sw = wlibc.screen_w()
    tbbase.sh = wlibc.screen_h()
    let _hs: bool = tbinput.head_setup()
    tbbase.asc = wlibc.ascent_of(wlibc.F_UI, uitheme.type_px(uitheme.TY_BODY))
    tbbase.cf_height = tbmetrics.def_h()
    tbbase.cf_width = DEF_V
    if tbstatus.conf_read() {
        tbbase.cf_from_file = 1
    }
    tbmetrics.geometry()

    var ref_w: u64 = 3840
    var ref_h: u64 = 2160
    if tbbase.sw > ref_w {
        ref_w = tbbase.sw
    }
    if tbbase.sh > ref_h {
        ref_h = tbbase.sh
    }
    var area: u64 = tbbase.V_MAX * ref_h
    if ref_w * tbmetrics.h_max() > area {
        area = ref_w * tbmetrics.h_max()
    }
    let cw0: u64 = tbbase.sw
    let ch0: u64 = (area + tbbase.sw - 1) / tbbase.sw

    var made: bool = fuiscene.open_plain(0, 0, cw0, ch0, tbmetrics.txt((&k_title[0 as usize]) as u64,
        (&s_title[0 as usize]) as u64), wlibc.L_TOP, tbpaint.bar_build)
    if !made {
        made = fuiscene.open_plain(0, 0, cw0, ch0, tbmetrics.txt((&k_title[0 as usize]) as u64,
            (&s_title[0 as usize]) as u64), wlibc.L_NORMAL, tbpaint.bar_build)
    }
    if !made {
        tbmetrics.say((&s_bad[0 as usize]) as u64)
        tbmetrics.nl()
        return 1
    }
    let h: u64 = fuiscene.handle()
    if ulib.bad(h) || h == 0 {
        tbmetrics.say((&s_bad[0 as usize]) as u64)
        tbmetrics.nl()
        return 1
    }
    tbbase.w_h = h
    tbbase.bar_cap = cw0 * ch0 * 4
    tbbase.bar_r = rt.heap_alloc(tbbase.bar_cap as usize) as u64
    if tbbase.bar_r == 0 {
        tbmetrics.say((&s_bad[0 as usize]) as u64)
        tbmetrics.nl()
        return 1
    }
    fuiscene.set_raw(tbpaint.bar_raw)
    fuiscene.set_overlay(tbpaint.bar_overlay)
    tbbase.bar_ready = 1
    if ulib.bad(wlibc.win_state(h, wlibc.WS_DECO, 0)) {
        tbmetrics.say((&s_bad[0 as usize]) as u64)
        tbmetrics.nl()
        return 1
    }
    if ulib.bad(wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_TOP)) {
        tbmetrics.say((&s_nol[0 as usize]) as u64)
        tbmetrics.nl()
        let _ln: u64 = wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_NORMAL)
        tbbase.cf_ontop = 0
    }
    tbinput.apply()
    let _u: bool = tbstatus.status_build()
    let _pb: bool = tbstatus.plugbar_read()
    let _l: bool = tblayout.list_read()

    if !qs.init(tbbase.cf_autohide) {
        tbmetrics.say((&s_noqs[0 as usize]) as u64)
        tbmetrics.nl()
    }

    if !barpop.init() {
        tbmetrics.say((&s_nobp[0 as usize]) as u64)
        tbmetrics.nl()
    }

    if !traypop.init() {
        tbmetrics.say((&s_notp[0 as usize]) as u64)
        tbmetrics.nl()
    }

    if !calpop.init() {
        tbmetrics.say((&s_nocp[0 as usize]) as u64)
        tbmetrics.nl()
    }
    if !taskview.init() {
        tbmetrics.say((&s_notv[0 as usize]) as u64)
        tbmetrics.nl()
    }
    if !notifc.init() {
        tbmetrics.say((&s_nonc[0 as usize]) as u64)
        tbmetrics.nl()
    }
    if !fpsov.init() {
        tbmetrics.say((&s_nofo[0 as usize]) as u64)
        tbmetrics.nl()
    }
    let _tmi: bool = testmark.init()
    if !uipopmenu.init() {
        tbmetrics.say((&s_nopm[0 as usize]) as u64)
        tbmetrics.nl()
    }
    tbinput.apply()
    tblayout.layout()
    tbpaint.paint(false)
    tbmetrics.say((&s_steht[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.win_x)
    tbmetrics.say((&tbbase.s_gy[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.win_y)
    tbmetrics.say((&tbbase.s_gw[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.win_w)
    tbmetrics.say((&tbbase.s_gh[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.win_h)
    tbmetrics.nl()
    tbmetrics.say((&s_lg[0 as usize]) as u64)
    tbmetrics.say(msg.lang())
    tbmetrics.say((&s_lgs[0 as usize]) as u64)
    tbmetrics.sayn(msg.lang_source())
    tbmetrics.say((&s_lgk[0 as usize]) as u64)
    tbmetrics.sayn(_mk)
    tbmetrics.nl()
    tbmetrics.say((&s_ico[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.ic_ok)
    tbmetrics.say((&s_icm[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.mk_ok)
    tbmetrics.say((&s_ics[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.sy_ok)
    tbmetrics.say((&s_icf[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.ic_files)
    tbmetrics.say((&s_icn[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.ic_min)
    tbmetrics.nl()
    tbstatus.conf_say()
    tbstatus.shape_say()
    tbmetrics.say((&s_rdy[0 as usize]) as u64)
    tbmetrics.say((&s_eq[0 as usize]) as u64)
    tbmetrics.sayn(tbbase.asc)
    tbmetrics.nl()
    tbpaint.paint(true)
    tbstatus.geom_say()
    tbstatus.health_say()
    var s_dk: [u8; 17] = "taskbar: deko n=\0"
    tbmetrics.say((&s_dk[0 as usize]) as u64)
    tbmetrics.sayn(wlibc.deco_push())

    var s_fm: [u8; 15] = "  form n=\0\0\0\0\0\0"
    tbmetrics.say((&s_fm[0 as usize]) as u64)
    tbmetrics.sayn(wlibc.form_push())
    tbmetrics.nl()
    tbstatus.glas_say()
    if once {
        return 0
    }
    var round: u64 = 0
    var tsum: u64 = wlibc.theme_sum()
    var alive: bool = true

    var quiet: u64 = 0

    var due8: u64 = 8
    var due5: u64 = 5
    var due10: u64 = 10
    var q_mx: u64 = 0
    var q_my: u64 = 0
    while alive {

        tbpaint.bar_pump()
        if !fuiscene.alive() {
            alive = false
        }
        if tbbase.pdrag != 0 {
            tbpaint.pin_drag_step()
        }
        if tbbase.dragging != 0 {
            tbinput.drag_step()
        }

        let _qsc: bool = qs.step()
        let _tvs: bool = taskview.step()
        let _tps: bool = traypop.step()
        let _cps: bool = calpop.step()
        notifc.set_bell(tbbase.f_x[(tbbase.F_NOTI) as usize], tbbase.f_y[(tbbase.F_NOTI) as usize],
            tbbase.f_w[(tbbase.F_NOTI) as usize], tbbase.f_h[(tbbase.F_NOTI) as usize])
        let _ncs: bool = notifc.step()
        let _fos: bool = fpsov.step()
        let _tms: bool = testmark.step()
        tbinput.hotkey_step()
        tbhover.tip_step()
        tbpopup.toast_step()
        tbinput.kontext_step()
        let hw: u64 = qs.want_hide()
        if hw != 0 {
            if hw == 1 {
                tbbase.cf_autohide = 1
            } else {
                tbbase.cf_autohide = 0
            }
            let _cw: bool = tbstatus.conf_write()
            tbstatus.conf_say()
            tbmetrics.geometry()
            tbbase.shown = 1
            tbinput.apply()
            tblayout.layout()
            tbpaint.paint(true)
            tbstatus.geom_say()
            qs.took_hide(tbbase.cf_autohide)
        }
        tbinput.autohide_step()
        round = round + 1
        if round >= due8 {
            due8 = round + 8
            tbinput.heads_step()
            if tbbase.quit_req != 0 {
                alive = false
            }
        }
        var fresh: bool = false

        if tbhover.hover_step() {
            fresh = true
        }
        if tbinput.dnd_bar_step() {
            fresh = true
        }
        if round >= due5 {
            due5 = round + 5
            if tblayout.list_read() {
                fresh = true
            }
        }

        let evc: u64 = ulib.sys(tbbase.SYS_PWRGET, PG_EVCHANGE, 0, 0)
        if !ulib.bad(evc) && evc != 0 {
            ev_seen = ev_seen + 1
            if (evc & (EV_BATT | EV_AC)) != 0 {
                if tbstatus.status_build() {
                    fresh = true
                }
            }
        }
        if round >= due10 {
            due10 = round + 10
            ub_sb = ub_sb + 1
            if tbstatus.status_build() {
                ub_sbt = ub_sbt + 1
                fresh = true
            }
            if tbstatus.plugbar_read() {
                fresh = true
            }
            let tpoll: bool = wlibc.theme_poll()
            let tjetzt: u64 = wlibc.theme_sum()
            if tpoll || tjetzt != tsum {
                tsum = tjetzt
                var s_dk2: [u8; 25] = "taskbar: decor reset n=\0\0"
                tbmetrics.say((&s_dk2[0 as usize]) as u64)
                tbmetrics.sayn(wlibc.deco_push())
                tbmetrics.nl()
                let _fk: u64 = wlibc.form_push()
                tbstatus.glas_say()
                fresh = true
                let _qt: bool = qs.theme_new()
            }
            let slowp: bool = tbmetrics.slow_poll_due()
            if slowp && msg.changed() {
                let _s2: bool = tbstatus.status_build()
                fresh = true
            }

            let old_e: u64 = tbbase.cf_edge
            let old_h: u64 = tbbase.cf_height
            let old_w: u64 = tbbase.cf_width
            let old_a: u64 = tbbase.cf_autohide
            let old_o: u64 = tbbase.cf_ontop
            if slowp && tbstatus.conf_read() {
                if tbbase.cf_edge != old_e || tbbase.cf_height != old_h
                    || tbbase.cf_width != old_w || tbbase.cf_autohide != old_a
                    || tbbase.cf_ontop != old_o {
                    tbstatus.conf_say()
                    tbmetrics.geometry()
                    tbbase.shown = 1
                    tbinput.apply()
                    fresh = true
                    tbstatus.geom_say()
                }
            }
        }
        if fresh && tbbase.shown != 0 {
            tblayout.layout()

            tbpaint.paint(true)
            tbmetrics.say((&s_stt[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.nk)
            tbmetrics.say((&s_pm[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.paints)
            tbmetrics.say((&s_ck[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.clicks)
            tbmetrics.say((&s_ac[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.acts)
            tbmetrics.say((&s_wt[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.writes)
            tbmetrics.say((&s_fui[0 as usize]) as u64)
            tbmetrics.sayn(fuib.fui_painted())
            tbmetrics.say((&s_fuix[0 as usize]) as u64)
            tbmetrics.sayn(fuib.fui_rejected())
            tbmetrics.say((&s_fuig[0 as usize]) as u64)
            tbmetrics.sayn(fuib.fui_reasons())
            tbmetrics.nl()
        }

        let _qs2: bool = qs.step()
        ub_round = ub_round + 1
        if ub_round >= ub_naechster {
            ub_naechster = ub_round + 200
            tbmetrics.say((&s_ur[0 as usize]) as u64)
            tbmetrics.sayn(ub_round)
            tbmetrics.say((&s_usb[0 as usize]) as u64)
            tbmetrics.sayn(ub_sb)
            tbmetrics.say((&s_usbt[0 as usize]) as u64)
            tbmetrics.sayn(ub_sbt)
            tbmetrics.say((&s_upx[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.ub_px)
            tbmetrics.say((&s_usoll[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.ub_soll)
            tbmetrics.say((&s_unull[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.ub_null)
            tbmetrics.say((&s_upm[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.paints)
            tbmetrics.say((&s_uqw[0 as usize]) as u64)
            tbmetrics.sayn(ub_qwhy)
            tbmetrics.say((&s_uq[0 as usize]) as u64)
            tbmetrics.sayn(tbbase.ub_quiet)
            ub_qwhy = 0
            tbmetrics.nl()
        }

        let mxn: u64 = wlibc.mouse_x()
        let myn: u64 = wlibc.mouse_y()
        var qwhy: u64 = 0
        if fresh { qwhy = qwhy | 1 }
        if _qsc || _tvs || _tps || _cps || _ncs || tbpopup.toast_up() { qwhy = qwhy | 2 }
        if hw != 0 || tbbase.pdrag != 0 || tbbase.dragging != 0 { qwhy = qwhy | 4 }
        if evc != 0 && !ulib.bad(evc) { qwhy = qwhy | 8 }
        if mxn != q_mx || myn != q_my { qwhy = qwhy | 16 }
        ub_qwhy = ub_qwhy | qwhy
        if qwhy != 0 {
            quiet = 0
        } else {
            quiet = quiet + 1
        }
        tbbase.ub_quiet = quiet
        q_mx = mxn
        q_my = myn
        if quiet > QUIET_ROUNDS {
            round = round + 1
            clockapi.sleep_ms(50)
        } else {
            clockapi.sleep_ms(25)
        }
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
