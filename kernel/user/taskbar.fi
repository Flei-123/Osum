// RUNDE SYSTEMBUS: die Glocke hat einen eigenen Namen im Bericht.
// Ohne ihn haette sie den des Netzes getragen, und ein Laeufer, der
// `taskbar: field net` zweimal findet, sucht den Fehler an der
// falschen Stelle.
static mut m_noti: [u8; 5] = "noti\0"
static mut m_btn: [u8; 7] = "button\0"
static mut s_tx: [u8; 15] = "taskbar: text \0"
static mut s_tX: [u8; 4] = " x=\0"
static mut s_tb: [u8; 7] = " base=\0"
static mut s_tf: [u8; 5] = " fg=\0"
static mut s_tg: [u8; 5] = " bg=\0"
static mut s_tt: [u8; 4] = " t=\0"
// ===================================== RUNDE PAINT: DIE PROGRAMMSYMBOLE
//
// "warum sind start, terminal und suchen keine icons?"
//
// Die Symbole gibt es seit Runde K15: `/apps/<name>.osp/symbol`, Format
// OSYM, gezeichnet in der Groesse, in der sie haengen. Was fehlte, war
// die Verbindung Fenster -> Buendel. Ein Fenster hatte einen TITEL, und
// ein Titel ist uebersetzt, aenderbar und nicht eindeutig ("Terminal --
// sh"). Seit dieser Runde sagt das Programm SELBST, welchem Buendel es
// gehoert (WM_APP), und der Fensterserver liefert den Namen in WL_APP
// mit -- also steht hier nur noch das Nachschlagen.
//
// EIN KLEINER ZWISCHENSPEICHER UND KEIN `appdir`. `appdir.load` liest
// das ganze Verzeichnis samt Schluesselwoertern und haelt 16576 Oktette
// Symbolspeicher; ein Prozess hat 832 KiB fuer alles, und die
// Taskleiste laeuft, solange die Maschine laeuft. Sie braucht ausserdem
// nur die Buendel, die gerade ein Fenster haben -- hoechstens so viele
// wie Knoepfe. Also: SYM_N Plaetze zu je einem Symbol, geschluesselt am
// Namen, gelesen EINMAL je Name und danach nie wieder.
const SYM_N: u64 = 6
const SYM_BYTES: u64 = 1036 // 12 + 16 * 16 * 4, wie appdir.SYMBYTES
static mut sym_name: [u8; 144] = [0 as u8; 144] // SYM_N * 24
static mut sym_data: [u8; 6216] = [0 as u8; 6216] // SYM_N * SYM_BYTES
static mut sym_ok: [u64; 6] = [0 as u64; 6] // 0 unbenutzt, 1 da, 2 keins
static mut sym_used: u64 = 0
static mut sym_hits: u64 = 0
static mut sym_reads: u64 = 0

fn sym_eq(a: u64, b: u64) -> bool {
    var k: u64 = 0
    while k < 24 {
        let x: u64 = kstate8(a + k)
        if x != kstate8(b + k) {
            return false
        }
        if x == 0 {
            return true
        }
        k = k + 1
    }
    return true
}

fn kstate8(p: u64) -> u64 {
    return (*((p) as *mut u8)) as u64
}

// `/apps/<name>.osp/symbol` -> Zeiger auf das OSYM, oder 0.
//
// KEIN Symbol ist kein Fehler: ein Buendel darf keines haben, ein
// Fenster darf zu keinem Buendel gehoeren, und dann faellt der Knopf auf
// reinen Text zurueck -- dieselbe Regel wie bei Netz und Akku. Deshalb
// merkt sich der Speicher auch das NEIN (`sym_ok = 2`): sonst wuerde
// jeder Neuaufbau der Leiste dieselbe fehlende Datei wieder oeffnen.
fn sym_of(app: u64) -> u64 {
    if app == 0 || kstate8(app) == 0 {
        return 0
    }
    var i: u64 = 0
    while i < sym_used {
        if sym_eq((&sym_name[0 as usize]) as u64 + i * 24, app) {
            sym_hits = sym_hits + 1
            if sym_ok[(i) as usize] == 1 {
                return (&sym_data[0 as usize]) as u64 + i * SYM_BYTES
            }
            return 0
        }
        i = i + 1
    }
    if sym_used >= SYM_N {
        return 0
    }
    let platz: u64 = sym_used
    sym_used = sym_used + 1
    var k: u64 = 0
    while k < 24 {
        sym_name[((platz * 24 + k)) as usize] = *((app + k) as *mut u8)
        k = k + 1
    }
    sym_ok[(platz) as usize] = 2
    var pfad: [u8; 64] = [0 as u8; 64]
    var before: [u8; 7] = "/apps/\0"
    var move_to: [u8; 12] = ".osp/symbol\0"
    var n: u64 = 0
    k = 0
    while k < 6 {
        pfad[(n) as usize] = before[(k) as usize]
        n = n + 1
        k = k + 1
    }
    k = 0
    while k < 23 && kstate8(app + k) != 0 {
        pfad[(n) as usize] = *((app + k) as *mut u8)
        n = n + 1
        k = k + 1
    }
    k = 0
    while k < 11 {
        pfad[(n) as usize] = move_to[(k) as usize]
        n = n + 1
        k = k + 1
    }
    pfad[(n) as usize] = 0 as u8
    let fd: u64 = io.open((&pfad[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return 0
    }
    sym_reads = sym_reads + 1
    let ziel: u64 = (&sym_data[0 as usize]) as u64 + platz * SYM_BYTES
    let got: u64 = io.read(fd, ziel, SYM_BYTES)
    io.close(fd)
    if ulib.bad(got) || got < 12 {
        return 0
    }
    if !wlibc.icon_ok(ziel) {
        return 0
    }
    sym_ok[(platz) as usize] = 1
    return ziel
}

