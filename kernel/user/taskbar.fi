// RUNDE ABBILD: DER MESSAUSGANG DER LEISTE STEHT IM NORMALBETRIEB AUS.
//
// Justins Befund am Abbild: im Terminalfenster standen sichtbar Zeilen
// der Art
//     taskbar: text start x=18 base=19 fg=988970 bg=16777215 t=Start
// Das ist derselbe Fehler, den `taskmgr.fi` schon hatte, und dort steht
// die Regel dazu:
//
//   EIN MESSAUSGANG GEHOERT HINTER EINEN SCHALTER, UND DER SCHALTER
//   STEHT IM NORMALBETRIEB AUS. Ein Programm, das im Auslieferungs-
//   zustand misst, misst vor allem sich selbst.
//
// Die Leiste malt bei jedem Uhrenwechsel neu; auf dem Stick geht diese
// Ausgabe nicht in ein Kabel, sondern in ein Terminalfenster, das jedes
// Oktett rastern muss.
//
// DER SCHALTER IST DERSELBE WIE BEI `wlib`: die Datei `/etc/uitrace`.
// Nicht ein Wort auf der Kernel-Kommandozeile -- die gehoert dem
// Kernel, und ein Ring-3-Programm, das darin liest, erfindet eine
// Abhaengigkeit, die es nicht braucht. Gibt es die Datei nicht, aendert
// sich kein Oktett gegenueber vorher; die Pruefstaende, die
// `taskbar: text ...` lesen (tools/desktop, tools/i18n, tools/metal2
// und die Laeufe unter pruef/), legen sie ohnehin an.
static mut s_melde: u64 = 0

fn say_text(mark: u64, x: u64, base: u64, fg: u64, bg: u64, txt: u64) {
    if s_melde == 0 {
        return
    }
    say((&s_tx[0 as usize]) as u64)
    say(mark)
    say((&s_tX[0 as usize]) as u64)
    sayn(x)
    say((&s_tb[0 as usize]) as u64)
    sayn(base)
    say((&s_tf[0 as usize]) as u64)
    sayn(fg)
    say((&s_tg[0 as usize]) as u64)
    sayn(bg)
    say((&s_tt[0 as usize]) as u64)
    say(txt)
    nl()
}

// One button: face, edge, and the label CENTRED. Returns the position
// of the label so it can be reported; the runner recomputes it in the
// picture, per character.
fn button(x: u64, y: u64, w: u64, h: u64, txt: u64, on: bool,
    dim: bool) -> u64 {
    return button_sym(x, y, w, h, txt, on, dim, 0, 0)
}

// RUNDE PAINT: DASSELBE MIT EINEM PROGRAMMSYMBOL GANZ LINKS.
//
// Die Reihenfolge im Knopf ist SYMBOL, MERKMAL, BESCHRIFTUNG, und sie
// ist so und nicht anders, weil die beiden Bilder verschiedene Fragen
// beantworten: das Symbol sagt WELCHES PROGRAMM, das Merkmal aus Runde
// NETVIEW sagt WELCHE NETZSICHT. Beide links, beide immer an derselben
// Stelle -- ein Bild, das mit der Laenge des Titels wandert, muss
// gesucht werden, und dann ist es keine Hilfe mehr.
//
// `sym == 0` ist der Normalfall und kostet nichts: dann ist das hier
// Aufruf fuer Aufruf der alte Knopf, und der Laeufer, der die Lage der
// Beschriftung nachrechnet, findet dieselbe Zahl.
// THE SAME BUTTON WITH A MARK IN FRONT OF THE LABEL. `mark` is a
// picture or 0; 0 is the normal case and costs nothing, which is the
// point -- `real` gets no mark, so most buttons go through here
// unchanged and the runner that measures the label position still
// measures the same number for them.
fn button_mark(x: u64, y: u64, w: u64, h: u64, txt: u64, on: bool,
    dim: bool, mark: u64) -> u64 {
    return button_sym(x, y, w, h, txt, on, dim, mark, 0)
}

// ==================================================== RUNDE SOFTUI
//
// EINE KACHEL UND EINE PILLE STATT EINES BESCHRIFTETEN KASTENS.
//
// Justin: "ein STRICH/eine Pille unter dem laufenden Programm statt
// beschrifteter Kaesten". Der Kasten hier war ein Rechteck mit einem
// DREIDIMENSIONALEN Rand (`frame3`: helle Kante oben und links, dunkle
// unten und rechts, und bei `on` umgekehrt). Das ist die Schaltflaeche
// von Windows 95, Strich fuer Strich, und sie ist der Grund, warum die
// Leiste alt aussieht -- nicht die Farbe.
//
// Was statt dessen gemalt wird, haengt an den Formmarken und an nichts
// sonst, also bleibt `classic` unveraendert:
//
//   radius_button = 0 und divider >= 50  ->  Aufruf fuer Aufruf der
//                                            alte Kasten samt `frame3`
//   sonst                                ->  eine runde Kachel ohne
//                                            Rand, und darunter eine
//                                            Pille
//
// DIE PILLE SAGT ZWEI DINGE MIT EINEM BILD: dass das Programm LAEUFT
// (sie ist da) und ob es VORNE ist (sie ist breit und in der
// Akzentfarbe statt schmal und grau). Genau so unterscheidet Windows 11
// die beiden Zustaende, und es ist der einzige Ort in dieser Runde, an
// dem der Akzent noch auftaucht -- was Justins Punkt 5 ist: der Akzent
// gehoert dem AKTIVEN Element und sonst niemandem.
//
// DIE BESCHRIFTUNG BLEIBT. "Statt beschrifteter Kaesten" heisst hier
// der Kasten und nicht die Schrift: diese Leiste hat keine Symbole fuer
// jedes Programm, und eine Kachel ohne Schrift und ohne Symbol waere
// ein leeres Feld. Der Kasten ist weg, die Schrift steht.
// DAS MARKENZEICHEN, MITTIG IN DEN KNOPF, MIT DECKUNG.
//
// Gemischt wird gegen die KNOPFFARBE und nicht gegen den Rahmenpuffer:
// `wlibc` hat kein Zuruecklesen, und der Knopf ist einen Augenblick
// vorher genau mit dieser Farbe gefuellt worden. Das ist exakt und
// spart das Lesen.
static mut mk_ink: u64 = 0

// RUNDE 32: DASSELBE, ABER ES SAGT, OB ES GEMALT HAT.
//
// `marke_malen` gab nichts zurueck -- als es der Rueckfall war, genuegte
// das. Jetzt ist es der ERSTE Weg, und der Aufrufer muss wissen, ob er
// den zweiten braucht. Es gibt genau einen Grund, warum es nicht malt:
// der Knopf ist kleiner als acht Punkte oder `marke_start` hat fuer
// diese Kante keine Groesse (`breit` gibt 0).
fn brand_paint_ok(x: u64, y: u64, w: u64, h: u64, report: bool) -> bool {
    if w < 8 || h < 8 {
        return false
    }
    var kante: u64 = h - 4
    if kante > w - 4 {
        kante = w - 4
    }
    if brand_start.wide(kante) == 0 {
        return false
    }
    brand_paint(x, y, w, h, report)
    return true
}

fn brand_paint(x: u64, y: u64, w: u64, h: u64, report: bool) {
    var s_mk: [u8; 18] = "taskbar: marke n=\0"
    var s_mx: [u8; 4] = " x=\0"
    var s_my: [u8; 4] = " y=\0"
    var s_mi: [u8; 6] = " ink=\0"
    if w < 8 || h < 8 {
        return
    }
    var kante: u64 = h - 4
    if kante > w - 4 {
        kante = w - 4
    }
    let n: u64 = brand_start.wide(kante)
    if n == 0 {
        return
    }
    // ===================================== RUNDE ECHTHARDWARE-2
    // DIE MARKE FUELLT DEN KNOPF -- SIE HAT NUR DREI GROESSEN.
    //
    // Justin: "OS-Symbol ganz links unten: Klick macht NICHTS." Die
    // Klickflaeche war nie das Problem (der Knopf ist 72x64 und die
    // Pruefung in `click` deckt ihn ganz ab) -- die MARKE DARIN war
    // zu klein. GEMESSEN auf seiner Aufloesung: Tinte von y=1392 bis
    // y=1414, also 24 Bildpunkte in einem 64 Punkte hohen Knopf. Wer
    // auf das kleine Zeichen zielt, das er SIEHT, trifft daneben --
    // und der Knopf tut dann wirklich nichts.
    //
    // `marke_start` hat genau drei eingebackene Groessen (16/24/32),
    // die groesste ist 32. Auf einem Knopf von 60 nutzbaren Punkten
    // bleibt damit die Haelfte leer. Also wird die 32er GANZZAHLIG
    // vervielfacht -- dasselbe Kaestchenverfahren wie in
    // `wlibc.icon_draw` seit dieser Runde. Ganzzahlig, weil ein Ring
    // von einem Bildpunkt Staerke keine Zwischenwerte vertraegt (der
    // Kopf von `marke_start.breit` sagt genau das).
    // DIE BESTE KOMBINATION AUS QUELLGROESSE UND VERVIELFACHUNG.
    //
    // Nicht einfach "die groesste Quelle, dann verdoppeln": auf einem
    // Knopf mit 60 nutzbaren Punkten passt die 32er GENAU EINMAL
    // (64 waeren zu viel) -- und dann bleiben 28 Punkte leer, was
    // genau der Zustand ist, den Justin fotografiert hat. Die 24er
    // passt ZWEIMAL: 48 von 60. Also wird durchprobiert, welches
    // Paar die groesste Flaeche ergibt, die noch hineingeht.
    // ===================================== RUNDE ECHTHARDWARE-4
    // NATIVE GROESSE SCHLAEGT VERVIELFACHUNG -- DAS WAR DIE
    // "VERPIXELUNG".
    //
    // Justin zu den Bildern aus ECHTHARDWARE-3: links unten ein
    // "rundes, stark verpixeltes Symbol". Die Suche hier lief bis
    // `kn <= 32`, weil es nur drei eingebackene Groessen gab, und
    // waehlte danach allein nach FLAECHE (`gr > best`). Auf Justins
    // Knopf mit 60 nutzbaren Punkten gewann damit 32*1 = 32 gegen
    // 24*2 = 48? Nein -- 48 gewann, und genau das war der Fehler:
    // eine 24er Vorlage, ganzzahlig verdoppelt, hat Treppen an jeder
    // runden Kante, waehrend die 48er Vorlage daneben scharf ist.
    //
    // Seit dieser Runde backt `tools/brand/startimage.py` auch 48 und
    // 64 ein (die Dateien lagen laengst in assets/marke/). Also:
    //
    //   1. gesucht wird ueber ALLE fuenf Groessen
    //   2. bei gleicher Endgroesse gewinnt die mit der KLEINEREN
    //      Vervielfachung -- also die native
    //
    // Punkt 2 ist der eigentliche Fix. Ohne ihn nimmt die Suche
    // weiter 24*2 statt 48*1, obwohl beides 48 ergibt und nur eines
    // davon scharf ist.
    var qn: u64 = n
    var draw: u64 = 1
    var best: u64 = n
    var bmal: u64 = 9
    var kn: u64 = 16
    while kn <= 64 {
        var m2: u64 = 1
        while m2 <= 4 {
            let gr: u64 = kn * m2
            if gr <= kante {
                if gr > best || (gr == best && m2 < bmal) {
                    best = gr
                    bmal = m2
                    qn = kn
                    draw = m2
                }
            }
            m2 = m2 + 1
        }
        // 16 -> 24 -> 32 -> 48 -> 64, die eingebackenen Groessen
        if kn == 16 {
            kn = 24
        } else if kn == 24 {
            kn = 32
        } else if kn == 32 {
            kn = 48
        } else if kn == 48 {
            kn = 64
        } else {
            kn = 65
        }
    }
    let gz: u64 = qn * draw
    let x0: u64 = x + (w - gz) / 2
    let y0: u64 = y + (h - gz) / 2
    let grund: u64 = wlibc.theme(wlibc.C_BUTTON_FACE)
    mk_ink = 0
    var yy: u64 = 0
    while yy < qn {
        var xx: u64 = 0
        while xx < qn {
            let v: u64 = brand_start.point(qn, xx, yy)
            let a: u64 = (v >> 24) & 0xFF
            if a != 0 {
                // ==================================== RUNDE 32
                // DIE DUNKLE TINTE DER MARKE FOLGT DEM THEMA.
                //
                // GEMESSEN im dunklen Abbild: der Ring der Marke ist
                // (11,13,16), die Leiste (30,41,59). Der Ring WAR
                // gemalt -- und praktisch unsichtbar, weil beides
                // dunkel ist. Sichtbar blieb nur die cyanfarbene
                // Diagonale (5,238,250).
                //
                // Die PNG-Dateien tragen eine feste Tinte, weil sie
                // fuer einen hellen Grund gezeichnet wurden. Eine
                // zweite Datei fuer dunkel waere eine zweite Quelle
                // fuer dasselbe Zeichen -- genau das, was dieses
                // Projekt sonst vermeidet.
                //
                // Also: der DUNKLE Anteil des Zeichens wird auf die
                // Vordergrundfarbe des Themas gezogen. Auf hellem
                // Grund ist T_FG dunkel (das Zeichen bleibt, wie es
                // gezeichnet wurde), auf dunklem Grund ist T_FG hell
                // und der Ring wird sichtbar. Die BUNTEN Punkte
                // (die Diagonale) bleiben unangetastet -- sie sind
                // die Marke und nicht ihre Kontur.
                var q: u64 = v & 0xFFFFFF
                let qr: u64 = (q >> 16) & 255
                let qg: u64 = (q >> 8) & 255
                let qb: u64 = q & 255
                var hoch: u64 = qr
                if qg > hoch {
                    hoch = qg
                }
                if qb > hoch {
                    hoch = qb
                }
                var tief: u64 = qr
                if qg < tief {
                    tief = qg
                }
                if qb < tief {
                    tief = qb
                }
                // Unbunt (Grau/Schwarz) heisst: Spanne klein. Nur
                // diese Punkte sind Kontur; alles Bunte ist Marke.
                if hoch -% tief < 24 {
                    q = wlibc.theme(wlibc.T_FG)
                }
                let f: u64 = wlibc.blend(grund, q, a)
                var dy: u64 = 0
                while dy < draw {
                    var dx: u64 = 0
                    while dx < draw {
                        wlib.draw_point(x0 + xx * draw + dx,
                            y0 + yy * draw + dy, f)
                        dx = dx + 1
                    }
                    dy = dy + 1
                }
                mk_ink = mk_ink + 1
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
    if report {
        say((&s_mk[0 as usize]) as u64)
        // RUNDE ECHTHARDWARE-2: die WIRKLICH gemalte Kante (`gz`) und
        // nicht die der Quelle (`n`). Ein Bericht, der 32 sagt, waehrend
        // 64 auf dem Schirm stehen, laesst genau den Fehler unsichtbar,
        // den diese Runde gesucht hat.
        sayn(gz)
        say((&s_mx[0 as usize]) as u64)
        sayn(x0)
        say((&s_my[0 as usize]) as u64)
        sayn(y0)
        say((&s_mi[0 as usize]) as u64)
        sayn(mk_ink)
        nl()
    }
}

// ========================================== RUNDE ECHTHARDWARE-4
// DAS PROGRAMMSYMBOL FUELLT DEN KNOPF -- WIE DIE STARTMARKE SEIT EH-2.
//
// Justin hat es zum dritten Mal gemeldet: "die Programmsymbole in der
// Taskleiste sind sehr klein und wirken verloren". GEMESSEN auf seiner
// Aufloesung, aus der seriellen Leitung von ECHTHARDWARE-3:
//
//     taskbar: STEHT x=0 y=1400 w=2560 h=40     <- die Leiste
//     taskbar: sym btn=0 app=terminal w=16      <- das Symbol
//
// 16 Bildpunkte in einem 40 Punkte hohen Streifen, also 40 Prozent --
// und daneben steht die Startmarke, die seit ECHTHARDWARE-2 ihren
// Knopf ausfuellt. Das ist der Unterschied, den man sieht.
//
// DIE URSACHE IST EINE HALBE KORREKTUR. `wlibc.icon_draw` nimmt seit
// EH-2 `ui_scale()` mit -- das behebt "das Symbol bleibt 16, waehrend
// die Leiste doppelt so hoch wird", aber NUR wenn die Leiste ihre
// Hoehe auch wirklich aus der Vervielfachung bezieht. Justins Leiste
// ist 40 hoch bei `ui_scale()==2` (die Marke `ctrl_h` deckelt sie),
// das Symbol wird 16*1 oder 16*2 -- gemessen 16. Die Vervielfachung
// des SCHIRMS ist eben nicht die Vervielfachung des KNOPFES.
//
// Also dieselbe Rechnung wie bei `marke_malen`: nicht raten, sondern
// die groesste ganzzahlige Vervielfachung nehmen, die noch in die
// nutzbare Hoehe passt. GANZZAHLIG, weil die Quellen Flaechen-
// zeichnungen mit harten Kanten sind (assets/apps/*/symbol.txt) --
// ein Kaestchen bleibt ein Kaestchen.
//
// `SYM_LUFT` ist der Rand, der oben und unten frei bleibt: ein Symbol,
// das den Knopf bis auf den letzten Punkt fuellt, sieht gequetscht
// aus. Zwei Punkte je Seite bei einfacher Vervielfachung.
const SYM_AIR: u64 = 2

fn sym_scale(sym: u64, h: u64) -> u64 {
    let ih: u64 = wlibc.icon_h(sym)
    if ih == 0 {
        return wlibc.ui_scale()
    }
    var luft: u64 = 2 * SYM_AIR * wlibc.ui_scale()
    if h <= luft {
        luft = 0
    }
    let raum: u64 = h - luft
    var s: u64 = raum / ih
    if s < 1 {
        s = 1
    }
    // Nicht groesser als das, was `icon_draw_sc` zeichnen kann, und
    // nie kleiner als bisher -- eine Leiste, die schon passte, darf
    // sich durch diese Runde nicht verkleinern.
    if s > 8 {
        s = 8
    }
    if s < wlibc.ui_scale() {
        s = wlibc.ui_scale()
    }
    return s
}

fn button_sym(x: u64, y: u64, w: u64, h: u64, txt: u64, on: bool,
    dim: bool, mark: u64, sym: u64) -> u64 {
    let weich: bool = wlibc.metric(wlibc.M_RADIUS_BUTTON) != 0
        || wlibc.metric(wlibc.M_DIVIDER) < 50
    var fg: u64 = wlibc.theme(wlibc.T_FG)
    // ============================================== RUNDE VEKTOR
    // JEDER KNOPF DER LEISTE SAGT JETZT, DASS ER EINER IST.
    //
    // Justins Befund 3: "keine Button-Zustaende ... Taskleisten-
    // Knoepfe". Er hat recht. Diese Routine kannte `on` (das
    // Fenster ist vorn) und `dim` (nichts da) -- aber nicht, ob der
    // Zeiger DARAUF steht. Was die Leiste "hover" nennt, ist ein
    // TEXTFELD (`hover_txt`), also eine Sprechblase; die Flaeche
    // selbst blieb unveraendert. Man druckt und hofft.
    //
    // Der Zeiger wird gepollt und nicht aus einem Ereignis genommen:
    // die Leiste bekommt Bewegung nur INNERHALB ihres Fensters
    // gemeldet, und genau dort sind diese Knoepfe.
    let zx: u64 = wlibc.mouse_x()
    let zy: u64 = wlibc.mouse_y()
    let ox: u64 = bar_x
    let oy: u64 = bar_y
    let drauf: bool = zx >= ox + x && zx < ox + x + w
        && zy >= oy + y && zy < oy + y + h
    let gedrueckt: bool = drauf && (wlibc.mouse_btn() & 1) != 0
    if weich {
        // die Kachel
        let r: u64 = wlibc.metric(wlibc.M_RADIUS_BUTTON)
        if on {
            var af: u64 = wlibc.theme(wlibc.C_BUTTON_HOVER)
            if gedrueckt {
                af = wlibc.mix(af, wlibc.theme(wlibc.T_BTNDN), 65)
            } else if drauf {
                af = wlibc.mix(af, wlibc.theme(wlibc.T_BTNHI), 40)
            }
            wlib.draw_board(x, y, w, h, wlib.MR_BUTTON, wlibc.EL_FLAT,
                af, 0)
        } else if gedrueckt {
            // GEDRUECKT IST SICHTBAR, AUCH WENN DAS FENSTER NICHT
            // VORN IST -- sonst gibt es auf den Druck keine Antwort.
            wlib.draw_board(x, y, w, h, wlib.MR_BUTTON, wlibc.EL_FLAT,
                wlibc.theme(wlibc.T_BTNDN), 0)
        } else if drauf {
            wlib.draw_board(x, y, w, h, wlib.MR_BUTTON, wlibc.EL_FLAT,
                wlibc.mix(wlibc.theme(wlibc.T_PANEL),
                    wlibc.theme(wlibc.T_BTNHI), 55), 0)
        } else if dim {
            fg = wlibc.theme(wlibc.T_DIM)
        }
        if dim {
            fg = wlibc.theme(wlibc.T_DIM)
        }
    } else {
        // RUNDE THEME: die Marke des Schemas und nicht die alte T_BTN.
        var bg: u64 = wlibc.theme(wlibc.C_BUTTON_FACE)
        if on {
            bg = wlibc.theme(wlibc.T_SEL)
        } else if dim {
            bg = wlibc.theme(wlibc.T_SCROLL)
        }
        wlib.draw_edge3(x, y, w, h, bg, wlibc.theme(wlibc.T_BTNHI),
            wlibc.theme(wlibc.C_BORDER), on)
        if on {
            fg = wlibc.theme(wlibc.T_SELFG)
        } else if dim {
            fg = wlibc.theme(wlibc.T_DIM)
        }
    }
    var room: u64 = 0
    // RUNDE ECHTHARDWARE-4: der Platz richtet sich nach der Groesse,
    // die WIRKLICH gemalt wird -- sonst malt das groessere Symbol ueber
    // den Text daneben (derselbe Fehler wie in EH-2 bei `ic_w`).
    var symsc: u64 = 0
    var symw: u64 = 0
    if sym != 0 {
        symsc = sym_scale(sym, h)
        symw = wlibc.icon_w(sym) * symsc
        room = room + symw + 3
    }
    if mark != 0 {
        room = room + mk_w() + 3
    }
    let n: u64 = tlen(txt)
    var tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), txt, n)
    if tw + 8 + room > w {
        if w > 8 + room {
            tw = w - 8 - room
        } else {
            tw = 0
        }
    }
    // ===================================== RUNDE ECHTHARDWARE-4
    // SYMBOL UND TEXT SIND EINE GRUPPE, UND DIE GRUPPE SITZT MITTIG.
    //
    // GEMESSEN von Justin an hell-2560/01-schreibtisch.png: das
    // Terminalsymbol lag bei x 57..68 in einem Knopf, dessen linke
    // Kante bei 54 liegt -- drei Punkte links, und rechts vom Text
    // blieben zwanzig. Der Grund stand hier: `mx = x + 3` klebte das
    // Symbol fest an den linken Rand, und der Text wurde DANACH im
    // Rest zentriert. Zwei Zentrierungen nebeneinander ergeben keine.
    //
    // Die Regel dieser Runde, und sie gilt fuer jeden Knopf der
    // Leiste: Breite der Gruppe = Symbol + Luft + Marke + Luft + Text.
    // Sie beginnt bei x + (w - Gruppe) / 2. Damit ist der Abstand
    // links und rechts gleich (Unterschied hoechstens 1 Punkt, weil
    // eine ungerade Restbreite sich nicht halbieren laesst), und
    // tools/design/ausrichtung.py rechnet genau das nach.
    let luft: u64 = 4 * wlibc.ui_scale()
    var gruppe: u64 = tw
    if sym != 0 {
        // ============================================ RUNDE ANHEFTEN
        // DIE LUFT GEHOERT ZWISCHEN SYMBOL UND TEXT -- gibt es keinen
        // Text, gibt es auch kein Dazwischen.
        //
        // GEMESSEN am angehefteten Knopf (3440x1440, uiscale=2): das
        // Symbol sass bei links=7 / rechts=15, also acht Punkte zu weit
        // links -- und acht ist genau `luft`. Ein Anhefter traegt nie
        // eine Beschriftung (`tw == 0`), die Gruppe war aber trotzdem
        // um den Abstand zum Text breiter, und um dessen Haelfte
        // rutschte alles nach links.
        //
        // Dieselbe Lehre wie beim Kreuz und in der KNOPF-VORLAGE: eine
        // Zahl, die fuer einen Nachbarn reserviert wird, den es nicht
        // gibt, verschiebt das, was da ist.
        gruppe = gruppe + symw
        if tw != 0 {
            gruppe = gruppe + luft
        }
    }
    if mark != 0 {
        gruppe = gruppe + mk_w() + luft
    }
    var gx: u64 = x + 3
    if w > gruppe + 6 {
        gx = x + (w - gruppe) / 2
    }
    let tx: u64 = gx + gruppe - tw
    let base: u64 = y + (h + asc) / 2 - 1
    var mx: u64 = gx
    if sym != 0 {
        // ===================================== RUNDE ECHTHARDWARE-2
        // MITTIG NACH DER GEMALTEN HOEHE, NICHT NACH DER GEPLANTEN.
        //
        // Hier stand `(h - gl_w()) / 2`. `gl_w()` ist 16 mal der
        // Vervielfachung, gemalt wird aber `icon_h() * Vervielfachung`
        // -- bei den Symbolen dieses Baums 14 von 16 Zeilen mit Tinte.
        // GEMESSEN auf Justins Aufloesung: Knopfmitte y=1404,
        // Symbolmitte y=1399. Fuenf Punkte, und genau die sieht man
        // als "das Symbol sitzt tiefer als die Schrift".
        // RUNDE ECHTHARDWARE-4: die Hoehe kommt aus `sym_scale` und
        // nicht mehr aus `ui_scale()` allein. Mittig bleibt mittig --
        // gerechnet wird weiter mit der GEMALTEN Hoehe (EH-2).
        let sh: u64 = wlibc.icon_h(sym) * symsc
        var sy2: u64 = y
        if h > sh {
            sy2 = y + (h - sh) / 2
        }
        let _s: bool = wlibc.icon_draw_sc(sym, mx, sy2, symsc)
        // Der Abstand zum Text waechst mit: 8 Punkte bei einfacher
        // Vervielfachung sind bei doppelter 16, sonst klebt das
        // groessere Symbol am Wort. Ohne Text entfaellt er (RUNDE
        // ANHEFTEN, siehe oben).
        mx = mx + symw
        if tw != 0 {
            mx = mx + luft
        }
    }
    // RUNDE PAINT: WO DIE MARKE WIRKLICH STEHT, UND NUR HIER.
    //
    // Der Bericht der Leiste meldete `mkx = kx[i] + 3` -- eine zweite
    // Abschrift derselben Zahl, an einer anderen Stelle. Sobald ein
    // Symbol davorrueckt, stimmt die Abschrift nicht mehr, und
    // tools/netview/run.sh faellt mit "mark-filtered: falsch 54 von 54"
    // durch: es sucht die Marke dort, wo der Bericht sie behauptet.
    //
    // Der Fehler ist nicht die Marke, sondern die Doppelung. Also
    // rechnet die Lage genau EINE Stelle aus -- die, die auch malt --
    // und der Bericht liest sie hier ab.
    mk_x = mx
    mk_y = y + (h - mk_w()) / 2
    if mark != 0 {
        // FLUSH LEFT AND VERTICALLY CENTRED. Left, because a mark that
        // moves with the length of the title is a mark the eye has to
        // look for; the whole value of it is that it is always in the
        // same place.
        let _m: bool = wlibc.icon_draw(mark, mx, y + (h - mk_w()) / 2)
    }
    let _e: u64 = wlib.draw_text(tx, base, txt, n, fg, wlibc.TY_BODY)
    return (tx << 32) | base
}

// DIE PILLE UNTER EINEM FENSTERKNOPF.
//
// Drei Bildpunkte hoch, an der Kante, die dem Schreibtisch ABGEWANDT
// ist -- bei einer Leiste unten also unten. Breit und in der
// Akzentfarbe, wenn das Fenster vorne ist; schmal und in der gedaempften
// Schriftfarbe, wenn es nur laeuft.
//
// Sie wird NUR gemalt, wenn die Form sie verlangt (`radius_button != 0`
// oder ein leiser Trenner). Auf `classic` malt diese Funktion nichts,
// und die alten Bildpunktzusagen der Leiste bleiben Zahl fuer Zahl
// gueltig.
fn pill(x: u64, y: u64, w: u64, h: u64, vorne: bool) {
    let weich: bool = wlibc.metric(wlibc.M_RADIUS_BUTTON) != 0
        || wlibc.metric(wlibc.M_DIVIDER) < 50
    if !weich || w < 12 || h < 6 {
        return
    }
    var pw: u64 = 10
    var c: u64 = wlibc.theme(wlibc.C_TEXT_MUTED)
    if vorne {
        pw = w * 45 / 100
        c = wlibc.theme(wlibc.C_ACCENT)
    }
    if pw > w - 4 {
        pw = w - 4
    }
    let px: u64 = x + (w - pw) / 2
    // An der Kante, die dem Schreibtisch abgewandt ist.
    var py: u64 = y + h - 3
    if cf_edge == wlibc.WE_TOP {
        py = y
    }
    wlib.draw_bar(px, py, pw, 3, c)
}

// Where the free space of a horizontal bar begins and ends: behind the
// last window button, in front of the first status field.
fn hover_left() -> u64 {
    var x: u64 = st_x + st_w + gap()
    var i: u64 = 0
    while i < nk {
        if kw[(i) as usize] != 0 && kx[(i) as usize] + kw[(i) as usize] + gap() > x {
            x = kx[(i) as usize] + kw[(i) as usize] + gap()
        }
        i = i + 1
    }
    return x
}

fn hover_right() -> u64 {
    var x: u64 = win_w
    var f: u64 = 0
    while f < F_N {
        if f_w[(f) as usize] != 0 && f_x[(f) as usize] < x {
            x = f_x[(f) as usize]
        }
        f = f + 1
    }
    if x < gap() {
        return 0
    }
    return x - gap()
}

fn put_n(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        let _c: u64 = ulib.sys(ulib.SYS_WRITE, ulib.OUT, p + i, 1)
        i = i + 1
    }
}

fn paint_band(y0: u64, hh: u64, report: bool) {
    wlibc.set_band(y0)
    wlibc.clip_set(0, y0, win_w, y0 + hh)
    // RUNDE SOFTUI: DER VERLAUF DER LEISTE. Dieselbe Regel wie in der
    // Titelleiste (kernel/wm.fi, `paint_title`): die oberste Zeile ist
    // die dunkelste, die unterste traegt die Themafarbe unveraendert,
    // und die Staerke ist auf den Spielraum der Farbe begrenzt, damit
    // kein Kanal anschlaegt. `grad = 0` -- also `classic` -- ist EIN
    // `rect`, genau wie vorher.
    let gbase: u64 = wlibc.theme(wlibc.C_TASKBAR_BG)
    let gd: u64 = wlibc.grad_room(gbase, wlibc.metric(wlibc.M_GRAD))
    if gd == 0 || hh < 2 {
        wlib.draw_area(0, y0, win_w, hh, gbase)
    } else {
        var gy: u64 = 0
        while gy < hh {
            let rest: u64 = gd * (hh - 1 - gy) / (hh - 1)
            wlib.draw_area(0, y0 + gy, win_w, 1,
                wlibc.shade(gbase, rest))
            gy = gy + 1
        }
    }
    // the hairline on the side that faces the desktop
    if cf_edge == wlibc.WE_BOTTOM {
        wlib.draw_line(0, 0, win_w, wlibc.theme(wlibc.C_BORDER))
    } else if cf_edge == wlibc.WE_TOP {
        wlib.draw_line(0, win_h - 1, win_w,
            wlibc.theme(wlibc.C_BORDER))
    } else if cf_edge == wlibc.WE_LEFT {
        wlib.draw_area(win_w - 1, y0, 1, hh,
            wlibc.theme(wlibc.C_BORDER))
    } else {
        wlib.draw_area(0, y0, 1, hh,
            wlibc.theme(wlibc.C_BORDER))
    }
    if shown == 0 {
        let _p0: u64 = wlibc.push(w_h, 0, y0, win_w, hh)
        ub_px = ub_px + _p0
        ub_soll = ub_soll + win_w * hh
        if _p0 == 0 {
            ub_null = ub_null + 1
        }
        return
    }
    // RUNDE PAINT: DER STARTKNOPF BEKOMMT AUCH EINES, und zwar das des
    // Starters -- er OEFFNET den Starter, also ist es sein Bild und
    // kein neu erfundenes. Gibt es das Buendel nicht, bleibt der Knopf
    // reiner Text.
    var st_app: [u8; 9] = "launcher\0"
    var ssym: u64 = sym_of((&st_app[0 as usize]) as u64)
    // ============================================== RUNDE STARTKNOPF
    // DAS MARKENZEICHEN STATT DES WORTES "Start".
    //
    // Justins Foto zeigte "St" -- der Text passte nicht in den Knopf.
    // Windows 11 hat dort seit Jahren kein Wort mehr, sondern ein
    // Zeichen, und OrientOS hat jetzt eines (assets/marke/start-*.png,
    // als Bildpunkte in `marke_start.fi`, siehe den Kopf von
    // tools/brand/startimage.py).
    //
    // Der weisse Kreis IN dem Zeichen gehoert dazu und bleibt; nur der
    // Grund AUSSERHALB des Rings ist durchsichtig und wird gegen die
    // Knopffarbe gemischt. Auf einer dunklen Leiste bleibt der
    // schwarze Ring damit sichtbar, weil der weisse Kreis direkt
    // dahinter steht -- gemessen und nicht gehofft.
    var st_leer: [u8; 2] = "\0\0"
    var st_txt: u64 = txt((&k_start[0 as usize]) as u64,
        (&s_st[0 as usize]) as u64)
    if cf_labels == LB_NEVER {
        st_txt = (&st_leer[0 as usize]) as u64
        ssym = 0
    }
    let rs: u64 = button_sym(st_x, st_y, st_w, st_h,
        st_txt, false, false, 0, ssym)
    if cf_labels == LB_NEVER {
        // ======================================== RUNDE ECHTHARDWARE-3
        // DER STARTKNOPF WAR EIN HOCHSKALIERTES BITMAP.
        //
        // Justins Befund: "Start-Knopf links unten ist stark
        // GEPIXELT". Er hatte recht, und die Ursache steht in
        // `marke_malen`: `marke_start` hat DREI eingebackene Groessen
        // (16/24/32 Bildpunkte), und was groesser sein soll, wird
        // GANZZAHLIG vervielfacht -- ein Quellpunkt wird zu einem
        // s-mal-s-Kaestchen. Auf seinem 2560x1440-Schirm mit
        // uiscale 2 ist das ein 32er Bild, viermal vergroessert:
        // jede Kante eine Treppe. Das ist Nearest-Neighbour, und so
        // sieht es auch aus.
        //
        // Das Symbolfont kann es besser. `assets/osum-icons.ttf`
        // traegt seit Runde ICONS den Glyphen `icons.START`, und
        // `wlibc.icon_at` RASTERT ihn in der GEWUENSCHTEN Groesse aus
        // den Konturen -- kein Vergroessern, keine Treppen. Genau
        // diesen Weg gehen Akku, Ton und Netz in dieser Datei
        // laengst (Zeile 3185 ff.); der Startknopf war der letzte,
        // der es nicht tat.
        //
        // ZWEITER SYMBOLWEG UNNOETIG: was hier gebraucht wird, ist
        // eine Kontur in Zielgroesse, und die liegt bereits im Baum.
        // `marke_start.fi` bleibt als Rueckfall stehen, falls das
        // Font fehlt -- ein Knopf ohne Zeichen waere schlimmer als
        // ein grobes.
        // ============================================== RUNDE 32
        // DIE REIHENFOLGE WAR VERKEHRT: DAS SYMBOLFONT ZEIGT NICHT
        // DIE MARKE.
        //
        // Justin: "warum steht im Startknopf ein komisches Zeichen,
        // ist das eine andere Fassung als die, die ich boote?"
        //
        // Nein, dieselbe -- und der Knopf malte genau das, was hier
        // stand. `icons.START` ist in lib/icons.fi auf 0xE0A2
        // gebunden, und daneben steht der Name des Glyphen:
        // `layout-grid`. Das ist ein Gitter aus vier Quadraten, ein
        // generisches Startmenue-Zeichen aus dem Lucide-Satz -- und
        // genau die "vier leeren Quadrate", die er im Bild
        // ausgemessen hat. Ein MARKEN-Glyph existiert in
        // assets/osum-icons.ttf nicht (geprueft: kein MARKE/BRAND/
        // LOGO/ORIENT in lib/icons.fi), also kann dieser Weg die
        // Marke nie zeigen.
        //
        // Die Marke liegt in `marke_start.fi` -- als Bildpunkte, aus
        // assets/marke/start-{16,24,32,48,64}.png erzeugt von
        // tools/brand/startimage.py, und EINGEBACKEN ins Programm. Sie
        // haengt also nicht daran, ob ein Bauskript eine Datei
        // mitkopiert.
        //
        // Runde ECHTHARDWARE-3 hat den Vektorweg VORGEZOGEN, weil das
        // Bitmap auf Justins 2560x1440-Schirm hochskaliert und damit
        // treppig war. Das Problem war echt -- aber die Loesung hat
        // ein grobes ZEICHEN gegen ein FALSCHES getauscht. Gegen die
        // Treppen hilft, dass `marke_start` seit derselben Runde
        // 48 und 64 mitbringt (fn breit: 16/24/32/48/64), also fuer
        // uebliche Knopfgroessen nicht mehr vervielfacht werden muss.
        //
        // Also: DIE MARKE ZUERST, das Symbolfont nur als Rueckfall.
        var gemalt: bool = brand_paint_ok(st_x, st_y, st_w, st_h, report)
        if !gemalt {
            var kante: u64 = st_h - 4
            if kante > st_w - 4 {
                kante = st_w - 4
            }
            let gx: u64 = st_x + (st_w - kante) / 2
            let gy: u64 = st_y + (st_h - kante) / 2
            if glyphs_ok() {
                gemalt = wlibc.icon_at(icons.START, gx, gy, kante,
                    wlibc.theme(wlibc.T_FG))
                if gemalt && report {
                    say((&s_mkv[0 as usize]) as u64)
                    sayn(kante)
                    nl()
                }
            }
        }
    }
    // ==================================================== RUNDE ANHEFTEN
    // DIE ANGEHEFTETEN KNOEPFE. Sie stehen zwischen Startknopf und
    // Fenstern und werden mit DERSELBEN Routine gemalt wie ein
    // Fensterknopf (`button_sym`) -- gleiche Kachel, gleicher
    // Schwebezustand, gleiche Druckfarbe. Das ist der Punkt: es soll
    // kein zweiter Knopftyp entstehen, der bei der naechsten
    // Formaenderung vergessen wird.
    //
    // DIE LAUFANZEIGE IST DIESELBE PILLE wie beim Fensterknopf, und sie
    // erscheint NUR, wenn das Programm laeuft (`pinwin < MAXK`). Ein
    // kalter Anhefter hat keinen Strich -- genau wie bei Windows.
    var pz2: u64 = 0
    while pz2 < npin {
        if pw_[(pz2) as usize] != 0 {
            let pnm: u64 = (&pinname[0 as usize]) as u64 + pz2 * 24
            let psy: u64 = sym_of(pnm)
            let pw2: u64 = pinwin[(pz2) as usize]
            let laeuft: bool = pw2 < MAXK
            var vorn: bool = false
            if laeuft && kfok[(pw2) as usize] != 0 {
                vorn = true
            }
            // Kein Text: ein Anhefter ist ein Symbol. `leer` ist die
            // leere Zeichenkette, damit `button_sym` nichts schreibt.
            let prc: u64 = button_sym(px_[(pz2) as usize], py_[(pz2) as usize],
                pw_[(pz2) as usize], ph_[(pz2) as usize],
                (&s_leer[0 as usize]) as u64, vorn, false, 0, psy)
            if laeuft {
                pill(px_[(pz2) as usize], py_[(pz2) as usize],
                    pw_[(pz2) as usize], ph_[(pz2) as usize], vorn)
            }
            if report {
                say((&s_pin[0 as usize]) as u64)
                say(pnm)
                say((&s_pinx[0 as usize]) as u64)
                sayn(px_[(pz2) as usize])
                say((&s_piny[0 as usize]) as u64)
                sayn(py_[(pz2) as usize])
                say((&s_pinw[0 as usize]) as u64)
                sayn(pw_[(pz2) as usize])
                say((&s_pinh[0 as usize]) as u64)
                sayn(ph_[(pz2) as usize])
                say((&s_pinsy[0 as usize]) as u64)
                if psy != 0 {
                    sayn(1)
                } else {
                    sayn(0)
                }
                say((&s_pinrun[0 as usize]) as u64)
                if laeuft {
                    sayn(1)
                } else {
                    sayn(0)
                }
                nl()
            }
            let _pu: u64 = prc
        }
        pz2 = pz2 + 1
    }
    var i: u64 = 0
    while i < nk {
        if kw[(i) as usize] != 0 {
            let lab: u64 = (&klab[0 as usize]) as u64 + i * 40
            let mk: u64 = mark_icon(knv[(i) as usize])
            let sy: u64 = sym_of((&kapp[0 as usize]) as u64 + i * 24)
            let rc: u64 = button_sym(kx[(i) as usize], ky[(i) as usize],
                kw[(i) as usize], kh[(i) as usize], lab,
                kfok[(i) as usize] != 0, kver[(i) as usize] != 0, mk, sy)
            // RUNDE SOFTUI: DIE PILLE. Sie steht NUR unter einem
            // Fensterknopf -- der Startknopf oeffnet ein Menue und
            // laeuft nicht -- und sie unterscheidet zwei Zustaende, die
            // vorher beide "Kasten" hiessen: laeuft (schmal, grau) und
            // laeuft UND ist vorne (breit, Akzent). Ein minimiertes
            // Fenster (kver) bekommt die schmale.
            pill(kx[(i) as usize], ky[(i) as usize], kw[(i) as usize],
                kh[(i) as usize], kfok[(i) as usize] != 0)
            if report && sy != 0 {
                // WIE VIEL TINTE DAS SYMBOL WIRKLICH HAT. Ohne diese
                // Zahl ist "das Symbol ist im Knopf" eine Behauptung
                // ueber etwas, das auch ein leeres Rechteck sein
                // koennte -- genau der Fehler, den Runde K7B teuer
                // bezahlt hat.
                say((&s_sy[0 as usize]) as u64)
                sayn(i)
                say((&s_syn[0 as usize]) as u64)
                say((&kapp[0 as usize]) as u64 + i * 24)
                say((&s_syw[0 as usize]) as u64)
                sayn(wlibc.icon_w(sy))
                // RUNDE ECHTHARDWARE-4: `w=` ist die Groesse der
                // DATEI und war deshalb als Beleg wertlos -- sie steht
                // seit EH-2 auf 16, egal wie gross gemalt wird.
                // `gemalt=` ist die Kantenlaenge auf dem Schirm,
                // `knopf=` die Hoehe des Knopfes darum. Erst die zwei
                // Zahlen nebeneinander sagen, ob ein Symbol "verloren"
                // wirkt: 16 in 40 tut es, 32 in 40 nicht.
                say((&s_syg[0 as usize]) as u64)
                sayn(wlibc.icon_w(sy) * sym_scale(sy, kh[(i) as usize]))
                say((&s_syk[0 as usize]) as u64)
                sayn(kh[(i) as usize])
                say((&s_syi[0 as usize]) as u64)
                sayn(sym_ink(sy))
                nl()
            }
            if report {
                var bg: u64 = wlibc.theme(wlibc.C_BUTTON_FACE)
                var fg: u64 = wlibc.theme(wlibc.T_FG)
                if kfok[(i) as usize] != 0 {
                    bg = wlibc.theme(wlibc.T_SEL)
                    fg = wlibc.theme(wlibc.T_SELFG)
                } else if kver[(i) as usize] != 0 {
                    bg = wlibc.theme(wlibc.T_SCROLL)
                    fg = wlibc.theme(wlibc.T_DIM)
                }
                say((&s_bt[0 as usize]) as u64)
                sayn(i)
                say((&s_bi[0 as usize]) as u64)
                sayn(kid[(i) as usize])
                say((&s_tX[0 as usize]) as u64)
                sayn(kx[(i) as usize])
                say((&s_gy[0 as usize]) as u64)
                sayn(ky[(i) as usize])
                say((&s_gw[0 as usize]) as u64)
                sayn(kw[(i) as usize])
                say((&s_gh[0 as usize]) as u64)
                sayn(kh[(i) as usize])
                say((&s_bv[0 as usize]) as u64)
                sayn(kver[(i) as usize])
                say((&s_bf[0 as usize]) as u64)
                sayn(kfok[(i) as usize])
                say((&s_tt[0 as usize]) as u64)
                say(lab)
                // ROUND NETVIEW, addendum: WHICH mark, and WHERE -- and
                // ONLY when there is one. A picture that is reported but
                // not drawn and a picture that is drawn but not reported
                // both fail in `tools/netview/run.sh`, which reads these
                // numbers and then reads the pixels. But the normal case
                // is `real`, and printing `netv=0` for every window of
                // every repaint is a line about nothing on a line that
                // three programs share.
                if knv[(i) as usize] != 0 {
                    say((&s_bn[0 as usize]) as u64)
                    sayn(knv[(i) as usize])
                    if mk != 0 {
                        say((&s_bmx[0 as usize]) as u64)
                        sayn(mk_x)
                        say((&s_bmy[0 as usize]) as u64)
                        sayn(mk_y)
                    }
                }
                nl()
                say_text((&m_btn[0 as usize]) as u64, rc >> 32,
                    rc & 0xFFFFFFFF, fg, bg, lab)
            }
        }
        i = i + 1
    }
    var f: u64 = 0
    while f < F_N {
        // RUNDE STARTKNOPF: ein Feld ohne Breite wird nicht gemalt --
        // kein Rechteck, kein Symbol, keine Zeile im Bericht. Das ist
        // die andere Haelfte von "kein Symbol ohne Hardware": ohne
        // diese Zeile bliebe ein Farbfleck ohne Inhalt stehen.
        if f_w[(f) as usize] == 0 {
            f = f + 1
        } else {
        wlib.draw_board(f_x[(f) as usize], f_y[(f) as usize],
            f_w[(f) as usize], f_h[(f) as usize], wlib.MR_BUTTON,
            wlibc.EL_FLAT, wlibc.theme(wlibc.T_PANEL), 0)
        // ROUND NETVIEW, addendum: the state of the MACHINE, in the
        // corner, where every system has put it for thirty years. It
        // goes in FRONT of the address and not instead of it: the icon
        // says at a glance which of four things is true, the address
        // says which address -- and neither of them replaces the other.
        var icx: u64 = 0
        // ROUND LOOK: THE BATTERY GETS A SYMBOL. It never had one -- the
        // percentage came from round K18 and the glyphs from round
        // ICONS, and the two were never joined.
        if f == F_BAT && glyphs_ok() {
            let bid: u64 = bat_icon()
            let bx: u64 = f_x[(f) as usize] + 2
            // RUNDE LEISTE-RECHTS: `icon_mid` statt `icon_at` --
            // zentriert nach der GEMALTEN Tinte und nicht nach dem
            // bestellten Kasten. Der Kasten geht als (y, h) mit.
            let by: u64 = f_y[(f) as usize]
            if wlibc.icon_mid(bid, bx, by, f_h[(f) as usize], gl_w(),
                bat_colour()) {
                icx = gl_w() + 2
                if report {
                    say((&lk_ic[0 as usize]) as u64)
                    say((&lk_bat[0 as usize]) as u64)
                    say((&lk_id[0 as usize]) as u64)
                    sayn(bid)
                    say((&s_tX[0 as usize]) as u64)
                    sayn(bx)
                    say((&s_gy[0 as usize]) as u64)
                    sayn(by)
                    say((&lk_px[0 as usize]) as u64)
                    sayn(gl_w())
                    say((&lk_ink[0 as usize]) as u64)
                    sayn(wlibc.icon_ink_w(bid, gl_w())
                        * wlibc.icon_ink_h(bid, gl_w()))
                    nl()
                }
            } else if report {
                // A GLYPH THAT IS NOT THERE IS SAID SO. Silence here
                // and a missing picture on screen look the same, and
                // one of them is a defect.
                say((&lk_no[0 as usize]) as u64)
                say((&lk_bat[0 as usize]) as u64)
                nl()
            }
        }
        // ROUND TON-2: THE VOLUME GETS THE SAME TREATMENT AS THE
        // BATTERY -- symbol first, percentage behind it. Built the
        // same way on purpose: two status fields that report
        // differently are two fields a test has to know separately.
        if f == F_SND && glyphs_ok() {
            let vid: u64 = snd_icon()
            let vx: u64 = f_x[(f) as usize] + 2
            let vy: u64 = f_y[(f) as usize]
            if wlibc.icon_mid(vid, vx, vy, f_h[(f) as usize], gl_w(),
                snd_colour()) {
                icx = gl_w() + 2
                if report {
                    say((&lk_ic[0 as usize]) as u64)
                    say((&lk_snd[0 as usize]) as u64)
                    say((&lk_id[0 as usize]) as u64)
                    sayn(vid)
                    say((&s_tX[0 as usize]) as u64)
                    sayn(vx)
                    say((&s_gy[0 as usize]) as u64)
                    sayn(vy)
                    say((&lk_px[0 as usize]) as u64)
                    sayn(gl_w())
                    say((&lk_ink[0 as usize]) as u64)
                    sayn(wlibc.icon_ink_w(vid, gl_w())
                        * wlibc.icon_ink_h(vid, gl_w()))
                    nl()
                }
            } else if report {
                say((&lk_no[0 as usize]) as u64)
                say((&lk_snd[0 as usize]) as u64)
                nl()
            }
        }
        if f == F_NET {
            // SECOND ADDENDUM, and the ORDER is the argument: the
            // faking sign comes FIRST, before the state of the machine.
            // What is read first is what is read at all, and "this
            // system is telling programs a story" is the more important
            // of the two sentences -- especially in the one case that
            // needs it, `always` on a machine that is genuinely online,
            // where the state icon on its own would be true and
            // misleading at once.
            let sy: u64 = sys_icon()
            if sy != 0 {
                let _s: bool = wlibc.icon_draw(sy, f_x[(f) as usize] + 2,
                    f_y[(f) as usize] + (f_h[(f) as usize] - mk_w()) / 2)
                icx = mk_w() + 2
                if report && nv_faking != fk_said {
                    fk_said = nv_faking
                    say((&s_fk[0 as usize]) as u64)
                    sayn(nv_fall)
                    say((&s_tX[0 as usize]) as u64)
                    sayn(f_x[(f) as usize] + 2)
                    say((&s_gy[0 as usize]) as u64)
                    sayn(f_y[(f) as usize]
                        + (f_h[(f) as usize] - mk_w()) / 2)
                    nl()
                }
            } else if report && nv_faking != fk_said {
                fk_said = nv_faking
                say((&s_fkno[0 as usize]) as u64)
                sayn(nv_fall)
                nl()
            }
            let ic: u64 = state_icon(net_state)
            if ic == 0 && glyphs_ok() {
                // ROUND LOOK: no OSYM file on this disk, but there is an
                // icon font. Same four states, same place, same room.
                let nid: u64 = net_glyph(net_state)
                let nx: u64 = f_x[(f) as usize] + 2 + icx
                let ny: u64 = f_y[(f) as usize]
                if wlibc.icon_mid(nid, nx, ny, f_h[(f) as usize], gl_w(),
                    net_colour(net_state)) {
                    icx = icx + gl_w() + 2
                    if report {
                        say((&lk_ic[0 as usize]) as u64)
                        say((&lk_net[0 as usize]) as u64)
                        say((&lk_id[0 as usize]) as u64)
                        sayn(nid)
                        say((&s_tX[0 as usize]) as u64)
                        sayn(nx)
                        say((&s_gy[0 as usize]) as u64)
                        sayn(ny)
                        say((&lk_px[0 as usize]) as u64)
                        sayn(gl_w())
                        say((&lk_ink[0 as usize]) as u64)
                        sayn(wlibc.icon_ink_w(nid, gl_w())
                            * wlibc.icon_ink_h(nid, gl_w()))
                        say((&lk_st[0 as usize]) as u64)
                        sayn(net_state)
                        nl()
                    }
                } else if report {
                    say((&lk_no[0 as usize]) as u64)
                    say((&lk_net[0 as usize]) as u64)
                    nl()
                }
            }
            if ic != 0 {
                let ix: u64 = f_x[(f) as usize] + 2 + icx
                // ============================ RUNDE LEISTE-RECHTS
                // NACH DER GEMALTEN HOEHE MITTIG, NICHT NACH DER
                // BESTELLTEN.
                //
                // Hier stand `(f_h - ic_w()) / 2`. `ic_w()` ist die
                // FESTE Kastengroesse (16 * Vervielfachung = 32); das
                // WLAN-Bild ist aber nur 26 Punkte hoch und wird im
                // Kasten OBEN buendig gemalt. Die sechs leeren Punkte
                // lagen damit alle unten, und das Symbol sass
                // GEMESSEN bei oben=24/unten=30 -- sechs Punkte zu
                // hoch, direkt neben dem Ton, der bei 24/24 sass.
                // Zwei Symbole nebeneinander, verschieden hoch: genau
                // das sieht man.
                //
                // `icon_draw_h` gibt es seit Runde ECHTHARDWARE-2 fuer
                // genau diese Frage -- an DIESER Malstelle wurde sie
                // nur nie gestellt. Dieselbe Lehre wie beim Kreuz und
                // beim Anhefter, zum dritten Mal: wer zentriert, muss
                // die Zahl erfragen, die wirklich gemalt wird.
                // Die TINTE mittig, nicht der Kasten: `icon_draw_h`
                // ist die Kopfzeile des Bildes (16 * 2 = 32), die
                // Tinte von `state-nocarrier` steht aber nur in den
                // Zeilen 0..12. Wer den Kasten zentriert, setzt die
                // Tinte um die Haelfte der leeren Zeilen zu hoch --
                // gemessen sechs Punkte.
                let ihh: u64 = wlibc.icon_ink_hgt(ic)
                let itop: u64 = wlibc.icon_ink_top(ic)
                var icy: u64 = f_y[(f) as usize]
                if f_h[(f) as usize] > ihh {
                    icy = f_y[(f) as usize]
                        + (f_h[(f) as usize] - ihh) / 2
                }
                // Das Bild wird an seiner OBERKANTE gemalt; damit die
                // TINTE dort landet, wo sie soll, muss der Vorlauf
                // abgezogen werden.
                if icy >= itop {
                    icy = icy - itop
                } else {
                    icy = f_y[(f) as usize]
                }
                // Waagrecht dieselbe Rechnung wie senkrecht: das Bild
                // wird an seiner linken KASTENkante gemalt, also muss
                // der Vorlauf abgezogen werden, damit die TINTE am
                // Feldrand steht. Und weitergezaehlt wird mit der
                // Tintenbreite -- sonst schoebe der leere Rest den
                // Text nach rechts.
                let ilf: u64 = wlibc.icon_ink_lft(ic)
                var ixx: u64 = ix
                if ixx >= ilf {
                    ixx = ixx - ilf
                }
                let _i: bool = wlibc.icon_draw(ic, ixx, icy)
                var iwd: u64 = wlibc.icon_ink_wid(ic)
                if iwd == 0 {
                    iwd = wlibc.icon_draw_w(ic)
                }
                icx = icx + iwd + 2
                if report && net_state != st_said {
                    st_said = net_state
                    say((&s_ic[0 as usize]) as u64)
                    sayn(net_state)
                    say((&s_tX[0 as usize]) as u64)
                    sayn(ix)
                    say((&s_gy[0 as usize]) as u64)
                    sayn(icy)
                    say((&lk_px[0 as usize]) as u64)
                    sayn(ihh)
                    nl()
                }
            }
        }
        var l: u64 = 0
        while l < f_lines[(f) as usize] {
            let p: u64 = line_of(f, l)
            let n: u64 = tlen(p)
            var tx: u64 = f_x[(f) as usize] + 4 + icx
            var base: u64 = f_y[(f) as usize] + (f_h[(f) as usize] + asc) / 2 - 1
            if f_lines[(f) as usize] > 1 {
                // ================== RUNDE LEISTE-RECHTS
                // ZWEI ZEILEN MITTIG, NICHT MIT FESTEM ABSTAND.
                //
                // Hier stand `f_y + 2 + asc + l * line_h()`. Die 2 ist
                // ein fester Abstand von oben; der Block aus zwei
                // Zeilen ist aber `2 * line_h()` hoch, und das Feld ist
                // `f_h` hoch. Was unten uebrig blieb, war NICHT dasselbe
                // wie die 2 oben -- gemessen sass die Uhr bei
                // oben=9/unten=14, also fuenf Punkte zu hoch, waehrend
                // die Symbole daneben auf -1 standen.
                //
                // Jetzt wird der Block mittig gesetzt: die Haelfte des
                // Restes oben, die andere unten. Dieselbe Rechnung wie
                // bei den Symbolen -- und derselbe Grund.
                let blk: u64 = f_lines[(f) as usize] * line_h()
                var voben: u64 = 2
                if f_h[(f) as usize] > blk {
                    voben = (f_h[(f) as usize] - blk) / 2
                }
                base = f_y[(f) as usize] + voben + asc + l * line_h()
            }
            let _e: u64 = wlib.draw_text(tx, base, p, n,
                wlibc.theme(wlibc.T_FG), wlibc.TY_BODY)
            if report {
                var mark: u64 = (&m_net[0 as usize]) as u64
                if f == F_BAT {
                    mark = (&m_bat[0 as usize]) as u64
                } else if f == F_CLK {
                    mark = (&m_clk[0 as usize]) as u64
                } else if f == F_NOTI {
                    mark = (&m_noti[0 as usize]) as u64
                } else if f == F_SND {
                    // RUNDE LEISTE-RECHTS: DAS TONFELD HIESS IM BERICHT
                    // `net`. Es hatte hier nie einen eigenen Fall, fiel
                    // also in den Vorgabewert -- und die Leitung meldete
                    // `taskbar: text net t=100%` fuer die LAUTSTAERKE.
                    // Wer diese Zeile las, hielt 100 % fuer den
                    // Akkustand oder fuer eine Netzangabe. Ein Bericht,
                    // der ein Feld unter dem Namen eines anderen fuehrt,
                    // ist schlimmer als gar keiner.
                    mark = (&m_snd[0 as usize]) as u64
                }
                say_text(mark, tx, base, wlibc.theme(wlibc.T_FG),
                    wlibc.theme(wlibc.T_PANEL), p)
            }
            l = l + 1
        }
        if report {
            var mark: u64 = (&m_net[0 as usize]) as u64
            if f == F_BAT {
                mark = (&m_bat[0 as usize]) as u64
            } else if f == F_CLK {
                mark = (&m_clk[0 as usize]) as u64
            } else if f == F_NOTI {
                mark = (&m_noti[0 as usize]) as u64
            } else if f == F_SND {
                mark = (&m_snd[0 as usize]) as u64
            }
            say((&s_fl[0 as usize]) as u64)
            say(mark)
            say((&s_tX[0 as usize]) as u64)
            sayn(f_x[(f) as usize])
            say((&s_gy[0 as usize]) as u64)
            sayn(f_y[(f) as usize])
            say((&s_gw[0 as usize]) as u64)
            sayn(f_w[(f) as usize])
            say((&s_gh[0 as usize]) as u64)
            sayn(f_h[(f) as usize])
            say((&s_fn[0 as usize]) as u64)
            sayn(f_lines[(f) as usize])
            nl()
        }
        f = f + 1
        }
    }
    // ROUND NETVIEW, addendum: WHAT THE POINTER IS RESTING ON, as a
    // sentence, in the empty space between the last window button and
    // the first status field. There is no tooltip window in this system
    // and a bar 28 pixels high cannot open one; this is the room there
    // is, and an icon nobody can look up is a rune.
    if hover_on != 0 && vertical == 0 {
        let hb: u64 = hover_left()
        let he: u64 = hover_right()
        if he > hb + 20 {
            wlibc.clip_set(hb, y0, he, y0 + hh)
            wlib.draw_board(hb, st_y, he - hb, btn_h(),
                wlib.MR_BUTTON, wlibc.EL_FLAT,
                wlibc.theme(wlibc.T_PANEL), 0)
            let hp: u64 = (&hover_txt[0 as usize]) as u64
            var hn: u64 = tlen(hp)
            while hn > 1 && wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), hp, hn)
                + 6 > he - hb {
                hn = hn - 1
            }
            let hbase: u64 = st_y + (btn_h() + asc) / 2 - 1
            let _h: u64 = wlib.draw_text(hb + 3, hbase, hp, hn,
                wlibc.theme(wlibc.T_DIM), wlibc.TY_BODY)
            wlibc.clip_set(0, y0, win_w, y0 + hh)
            if report {
                say((&s_hv[0 as usize]) as u64)
                say((&s_tX[0 as usize]) as u64)
                sayn(hb + 3)
                say((&s_tb[0 as usize]) as u64)
                sayn(hbase)
                say((&s_tt[0 as usize]) as u64)
                put_n(hp, hn)
                nl()
            }
        }
    }
    let _p: u64 = wlibc.push(w_h, 0, y0, win_w, hh)
    // RUNDE UHRWERK: WAS HAT `push` WIRKLICH HINUEBERGEBRACHT?
    // `wig.blit` gibt die Zahl der Bildpunkte zurueck -- und NULL,
    // wenn `fetch` die Quelle nicht lesen durfte. Bis zu dieser Runde
    // hat das niemand angesehen (`let _p`), und genau darin lag der
    // Fehler: die Leiste meldete "gemalt", waehrend nichts ankam.
    ub_px = ub_px + _p
    ub_soll = ub_soll + win_w * hh
    if _p == 0 {
        ub_null = ub_null + 1
    }
    if report {
        // ROUND LOOK: the RECTANGLE, not only the word inside it.
        say((&lk_sx[0 as usize]) as u64)
        sayn(st_x)
        say((&lk_sy[0 as usize]) as u64)
        sayn(st_y)
        say((&lk_sw[0 as usize]) as u64)
        sayn(st_w)
        say((&lk_sh[0 as usize]) as u64)
        sayn(st_h)
        say((&lk_sg[0 as usize]) as u64)
        say(align_name(cf_align))
        nl()
        say_text((&m_start[0 as usize]) as u64, rs >> 32,
            rs & 0xFFFFFFFF, wlibc.theme(wlibc.T_FG),
            wlibc.theme(wlibc.C_BUTTON_FACE),
            txt((&k_start[0 as usize]) as u64,
                (&s_st[0 as usize]) as u64))
    }
}

// THE WHOLE BAR, BAND BY BAND. The drawing surface of the widget
// library is 800 x 81 pixels; a horizontal bar is one band, a vertical
// one is eight. Everything is clipped to the band, so each band paints
// only what falls into it -- and the report is written in the FIRST
// band only, because it describes the layout and not the band.
fn paint(report: bool) {
    var y: u64 = 0
    var first: bool = true
    // ================================================ RUNDE UHRWERK
    // DIE BANDHOEHE IST NICHT MEHR EINE ZAHL IM QUELLTEXT, SONDERN
    // DIE, DIE DIE FLAECHE WIRKLICH TRAEGT.
    //
    // `BAND` = 80 war richtig, solange die Flaeche 800 Bildpunkte breit
    // war. Sie ist aber so breit wie der SCHIRM, und ihr Platz ist
    // fest (1 MiB) -- also traegt sie auf einem breiten Schirm WENIGER
    // Zeilen:
    //
    //     1920 -> 136      2560 -> 102      3440 -> 76      3840 -> 68
    //
    // Auf Justins 3440x1440 wollte diese Schleife 80 Zeilen schieben,
    // wo 76 abgebildet waren. Der Kern darf die vier Zeilen dahinter
    // nicht lesen (`proc.user_ok`), also brach `wig.blit` ab, gab null
    // zurueck und kam nie bis `wm.damage` -- die ganze Leiste blieb auf
    // dem Schirm stehen, wie sie beim ersten Mal gemalt war. Das ist
    // die stehende Uhr.
    //
    // Mit dem Minimum aus beiden passt jedes Band immer in die Flaeche,
    // und auf schmalen Schirmen aendert sich NICHTS: dort ist
    // `surf_rows` groesser als 80, und es bleibt bei 80.
    var band: u64 = BAND
    let tragf: u64 = wlibc.surf_rows()
    if tragf != 0 && tragf < band {
        band = tragf
    }
    while y < win_h {
        var hh: u64 = band
        if y + hh > win_h {
            hh = win_h - y
        }
        paint_band(y, hh, report && first)
        first = false
        y = y + hh
    }
    paints = paints + 1
}

// ============================================================ the drag
//
// WHY THE POINTER IS POLLED AND NOT AWAITED. A window is only told
// about the pointer while the pointer is INSIDE it (kernel/wm.fi,
// `on_mouse`). A drag from the bottom edge to the left edge leaves the
// bar after four pixels and the button is let go on the other side of
// the screen, where no event of ours will ever be raised. So the bar
// asks for the position and the buttons directly (`WIG_SCREEN`), forty
// times a second, for as long as the drag lasts -- and for no longer.

static mut s_d0: [u8; 21] = "taskbar: drag start \0"
static mut s_d1: [u8; 20] = "taskbar: drag edge=\0"
static mut s_d2: [u8; 20] = "taskbar: drag done \0"
static mut s_wr: [u8; 10] = " written=\0"
static mut s_pv: [u8; 9] = "preview\0\0"

fn close_preview() {
    var i: u64 = 0
    while i < 4 {
        if prev_h[(i) as usize] != 0 {
            let _c: u64 = wlibc.sys3w(wlibc.WM_CLOSE, prev_h[(i) as usize],
                0, 0)
            prev_h[(i) as usize] = 0
        }
        i = i + 1
    }
    prev_on = 0
    prev_edge = 9
}

// ONE THIN ALWAYS-ON-TOP WINDOW. Four of them make the outline.
fn preview_win(x: u64, y: u64, w: u64, h: u64) -> u64 {
    let hd: u64 = wlibc.sys5(wlibc.WM_CREATE, (x << 16) | y,
        (w << 16) | h, (&s_pv[0 as usize]) as u64, 0, 0)
    if ulib.bad(hd) || hd == 0 {
        return 0
    }
    let _d: u64 = wlibc.win_state(hd, wlibc.WS_DECO, 0)
    let _l: u64 = wlibc.win_state(hd, wlibc.WS_LAYER, wlibc.L_TOP)
    let _f: u64 = wlibc.sys5(wlibc.WM_FILL, hd, 0, (w << 16) | h,
        wlibc.theme(wlibc.T_SEL), 0)
    let _u: u64 = wlibc.sys3w(wlibc.WM_FLUSH, hd, 0, 0)
    return hd
}

// THE PREVIEW RECTANGLE FOR AN EDGE. Four thin windows and not one
// filled sheet: a filled 128 x 600 window costs 300 kilooctets of
// buffer, and this process has 832 for the bar, the preview and the
// drawing surface together. An outline is 34.
fn preview_show(edge: u64) {
    if prev_on != 0 && prev_edge == edge {
        return
    }
    close_preview()
    rect_for(edge, thickness_of(edge))
    let x: u64 = r_x
    let y: u64 = r_y
    let w: u64 = r_w
    let h: u64 = r_h
    prev_h[(0) as usize] = preview_win(x, y, w, PREV_T)
    prev_h[(1) as usize] = preview_win(x, y + h - PREV_T, w, PREV_T)
    prev_h[(2) as usize] = preview_win(x, y, PREV_T, h)
    prev_h[(3) as usize] = preview_win(x + w - PREV_T, y, PREV_T, h)
    prev_on = 1
    prev_edge = edge
    say((&s_d1[0 as usize]) as u64)
    sayn(edge)
    say((&s_gx[0 as usize]) as u64)
    sayn(x)
    say((&s_gy[0 as usize]) as u64)
    sayn(y)
    say((&s_gw[0 as usize]) as u64)
    sayn(w)
    say((&s_gh[0 as usize]) as u64)
    sayn(h)
    nl()
}

// THE NEAREST EDGE TO A POINT. Plain distance to the four sides; the
// same rule Windows 10 used, and the reason a drag towards a corner
// picks the side you were heading for and not the one you started on.
fn nearest_edge(mx: u64, my: u64) -> u64 {
    var best: u64 = wlibc.WE_LEFT
    var d: u64 = mx
    if sw - 1 - mx < d {
        d = sw - 1 - mx
        best = wlibc.WE_RIGHT
    }
    if my < d {
        d = my
        best = wlibc.WE_TOP
    }
    if sh - 1 - my < d {
        d = sh - 1 - my
        best = wlibc.WE_BOTTOM
    }
    return best
}

// ==================================================== RUNDE ANHEFTEN
// WOHIN EIN GEZOGENER ANHEFTER GEHOERT. Gerechnet wird gegen die
// MITTEN der Plaetze und nicht gegen die Kanten: wer die Mitte des
// Nachbarn ueberschritten hat, hat ihn ueberholt. Das ist dieselbe
// Regel, nach der jede Leiste mit ziehbaren Symbolen arbeitet, und sie
// ist die einzige, die sich beim Hin- und Herwackeln nicht aufschaukelt.
// Welcher Anhefter liegt unter diesem Punkt? `npin` heisst: keiner.
fn pin_under(x: u64, y: u64) -> u64 {
    var k: u64 = 0
    while k < npin {
        if pw_[(k) as usize] != 0
            && x >= px_[(k) as usize]
            && x < px_[(k) as usize] + pw_[(k) as usize]
            && y >= py_[(k) as usize]
            && y < py_[(k) as usize] + ph_[(k) as usize] {
            return k
        }
        k = k + 1
    }
    return npin
}

fn pin_target(mx: u64) -> u64 {
    if npin == 0 {
        return 0
    }
    let br: u64 = pw_[(0) as usize] + gap()
    let links: u64 = px_[(0) as usize]
    if mx < links {
        return 0
    }
    var k: u64 = 0
    while k < npin {
        let mitte: u64 = links + k * br + br / 2
        if mx < mitte {
            return k
        }
        k = k + 1
    }
    return npin - 1
}

// Den Anhefter von `von` nach `nach` umhaengen; die dazwischen ruecken
// auf. Ein Feld von 24 Oktetten wandert, nicht ein Zeiger -- die Liste
// IST der Speicher und es gibt keine zweite Abschrift davon.
fn pin_umhaengen(von: u64, move_to: u64) {
    if von == move_to || von >= npin || move_to >= npin {
        return
    }
    var tmp: [u8; 24] = [0 as u8; 24]
    let qp: u64 = (&pinname[0 as usize]) as u64 + von * 24
    var k: u64 = 0
    while k < 24 {
        tmp[(k) as usize] = *((qp + k) as *mut u8)
        k = k + 1
    }
    if move_to > von {
        var i2: u64 = von
        while i2 < move_to {
            let a2: u64 = (&pinname[0 as usize]) as u64 + i2 * 24
            let b2: u64 = a2 + 24
            k = 0
            while k < 24 {
                __mmio_write8((a2 + k) as *mut u8,
                    *((b2 + k) as *mut u8))
                k = k + 1
            }
            i2 = i2 + 1
        }
    } else {
        var i3: u64 = von
        while i3 > move_to {
            let a3: u64 = (&pinname[0 as usize]) as u64 + i3 * 24
            let b3: u64 = a3 - 24
            k = 0
            while k < 24 {
                __mmio_write8((a3 + k) as *mut u8,
                    *((b3 + k) as *mut u8))
                k = k + 1
            }
            i3 = i3 - 1
        }
    }
    let zp: u64 = (&pinname[0 as usize]) as u64 + move_to * 24
    k = 0
    while k < 24 {
        __mmio_write8((zp + k) as *mut u8, tmp[(k) as usize])
        k = k + 1
    }
}

// Ein Schritt im Ziehen eines Anhefters. Wird jede Runde gerufen,
// solange `pdrag` nicht 0 ist.
fn pin_drag_step() {
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    let los: bool = (wlibc.mouse_btn() & 1) == 0
    // Noch nicht ueber der Schwelle: entscheidet sich hier.
    if pdrag == 1 {
        var d: u64 = 0
        if mx > pdrag_x0 {
            d = mx - pdrag_x0
        } else {
            d = pdrag_x0 - mx
        }
        if los {
            // KLICK OHNE ZIEHEN -- das ist der Normalfall und er muss
            // das Programm starten. Genau das hier ist die Stelle, an
            // der ein eingebautes Ziehen das Anheften kaputtmacht,
            // wenn man sie vergisst.
            pdrag = 0
            click(pdrag_x0, pdrag_y0)
            return
        }
        if d >= PDRAG_SCHWELLE * wlibc.ui_scale() {
            pdrag = 2
            pdrag_ziel = pdrag_i
            say((&s_pd0[0 as usize]) as u64)
            say((&pinname[0 as usize]) as u64 + pdrag_i * 24)
            say((&s_pdd[0 as usize]) as u64)
            sayn(d)
            nl()
        }
        return
    }
    // Es wird gezogen: die Einfuegestelle wandert mit.
    let z: u64 = pin_target(mx)
    if z != pdrag_ziel {
        pdrag_ziel = z
        // Die LUECKE WANDERT SICHTBAR: die Liste wird schon jetzt
        // umgehaengt und neu gemalt, statt erst beim Loslassen. Damit
        // ist das Bild waehrend des Ziehens die Wahrheit und nicht
        // eine Vorschau, die von ihr abweichen kann.
        pin_umhaengen(pdrag_i, z)
        pdrag_i = z
        let _l: bool = list_read()
        layout()
        paint(true)
        say((&s_pdm[0 as usize]) as u64)
        sayn(z)
        nl()
    }
    if los {
        pdrag = 0
        // DIE REIHENFOLGE UEBERLEBT DEN NEUSTART -- sonst war das
        // Ziehen eine Geste ohne Wirkung.
        var ok: u64 = 0
        if conf_write() {
            ok = 1
        }
        say((&s_pd1[0 as usize]) as u64)
        var q: u64 = 0
        while q < npin {
            if q > 0 {
                say((&s_komma[0 as usize]) as u64)
            }
            say((&pinname[0 as usize]) as u64 + q * 24)
            q = q + 1
        }
        say((&s_wr[0 as usize]) as u64)
        sayn(ok)
        nl()
        let _l2: bool = list_read()
        layout()
        paint(true)
    }
    let _my: u64 = my
}

fn drag_step() {
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    let e: u64 = nearest_edge(mx, my)
    drag_edge = e
    preview_show(e)
    if (wlibc.mouse_btn() & 1) == 0 {
        // let go: this is where the edge really changes.
        dragging = 0
        close_preview()
        var written: u64 = 0
        if e != cf_edge {
            cf_edge = e
            if conf_write() {
                written = 1
            }
            geometry()
            apply()
            let _l: bool = list_read()
            layout()
            paint(true)
            geom_say()
        }
        say((&s_d2[0 as usize]) as u64)
        say((&s_ed[0 as usize]) as u64)
        sayn(e)
        say((&s_wr[0 as usize]) as u64)
        sayn(written)
        nl()
    }
}

// ======================================================== the auto-hide

static mut s_hd: [u8; 14] = "taskbar: hide\0"
static mut s_sh2: [u8; 14] = "taskbar: show\0"
static mut s_ms: [u8; 5] = " ms=\0"

fn touches_edge(mx: u64, my: u64) -> bool {
    if cf_edge == wlibc.WE_BOTTOM {
        return my + 1 + REVEAL >= sh
    }
    if cf_edge == wlibc.WE_TOP {
        return my <= REVEAL
    }
    if cf_edge == wlibc.WE_LEFT {
        return mx <= REVEAL
    }
    return mx + 1 + REVEAL >= sw
}

fn inside_bar(mx: u64, my: u64) -> bool {
    return mx >= bar_x && mx < bar_x + bar_w
        && my >= bar_y && my < bar_y + bar_h
}

// PULL IT IN, LET IT OUT. The measurement the runner takes is the time
// between the pointer REACHING the edge and the bar STANDING there --
// `hide_t0` is stamped at the first poll that saw the pointer on the
// edge, the second stamp is taken after the repaint. Ticks are 10
// milliseconds in this kernel (`kernel/time.fi`, TICK_HZ = 100), so
// that is the resolution of the number and not a millisecond.
fn autohide_step() {
    if cf_autohide == 0 {
        return
    }
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    if shown == 0 {
        if touches_edge(mx, my) {
            if hide_t0 == 0 {
                hide_t0 = ticks()
            }
            shown = 1
            apply()
            layout()
            // PAINTED, NOT REPORTED, and the stopwatch stops here. The
            // first version reported the whole layout inside this paint
            // and measured 230 ms -- most of which was the serial line,
            // not the bar. What is timed is the work the user waits
            // for: resize, move, reserve, draw. The layout is reported
            // afterwards, outside the measurement.
            paint(false)
            let t1: u64 = ticks()
            say((&s_sh2[0 as usize]) as u64)
            say((&s_ms[0 as usize]) as u64)
            sayn((t1 - hide_t0) * 10)
            nl()
            hide_t0 = 0
            paint(true)
        }
        return
    }
    if dragging != 0 {
        return
    }
    if !inside_bar(mx, my) {
        shown = 0
        apply()
        paint(false)
        say((&s_hd[0 as usize]) as u64)
        nl()
    }
}

// ============================================================== clicks

static mut s_cl: [u8; 18] = "taskbar: click x=\0"
static mut s_cy: [u8; 4] = " y=\0"
static mut s_ct: [u8; 8] = " hits=\0\0"
static mut s_act: [u8; 17] = "taskbar: act id=\0"
static mut s_aw: [u8; 6] = " was=\0"
static mut s_sp: [u8; 23] = "taskbar: launcher pid=\0"
static mut p_start: [u8; 14] = "/bin/launcher\0"
static mut z_start: [u8; 6] = "start\0"
static mut z_task: [u8; 7] = "window\0"
static mut z_none: [u8; 5] = "none\0"
static mut z_qs: [u8; 6] = "quick\0"
static mut s_noqs: [u8; 28] = "taskbar: no quick settings\0\0"

// ============================================== RUNDE STARTKNOPF
// DAS STARTMENUE AUF UND ZU -- UEBER DIE SUPER-TASTE ODER DEN KNOPF.
//
// Der Startknopf hat bis hierher IMMER `SYS_SPAWN` gerufen. Zweimal
// druecken hiess also: zwei Starter. Ein Startmenue schaltet um, und
// das gilt fuer die Taste genauso wie fuer den Knopf.
//
// ZUGEMACHT WIRD UEBER DEN FENSTERSERVER und nicht ueber ein Signal an
// den Prozess: `WA_TOGGLE` ist genau der Weg, den der Klick auf den
// Fensterknopf in der Leiste schon nimmt (verkleinern/hervorholen).
// Damit ist der zweite Druck auf Super derselbe Vorgang wie ein Klick
// auf den Knopf, und es gibt nicht zwei Wege, dasselbe zu tun. Der
// Starter bleibt dabei am Leben -- das zweite Oeffnen ist deshalb
// sofort da und kostet keinen Programmstart.
static mut menue_pid: u64 = 0

// ===================================================== RUNDE TUERSCHLOSS
//
// DIESE SUCHE HAT DEN STARTER NIE GEFUNDEN, UND DARUM STAPELTEN SICH
// DIE STARTMENUES.
//
// Hier wurde ueber `nk` gelaufen -- die KNOPFLISTE der Leiste. Die
// fuellt `list_read` aber ausdruecklich nur mit Fenstern der Ebene
// `L_NORMAL` ("everything on that layer gets a button in this bar").
// Der Starter ist seit Runde STARTKNOPF `L_TOP`: er ist ein Feld an
// der Leiste und bekommt mit Absicht KEINEN Knopf. Er stand also nie
// in `nk`, `launcher_fenster` gab immer 0, `startmenue_um` sprang
// jedes Mal in den Zweig darunter und startete EIN WEITERES
// /bin/launcher.
//
// GEMESSEN (Runde DURCHKLICK, 4.6): nach 20 Klicks auf Start standen
// 16 Fenster (id=7..22), alle an derselben Stelle, keines wurde je
// abgeraeumt -- ein Leck, das mit der Laufzeit waechst. Und in dieser
// Runde noch einmal nachgesehen: id=11 und id=12, beide 440x300 bei
// x=8 y=452, waehrend die Knopfliste nur id=7 kannte.
//
// Also wird jetzt dort gesucht, wo der Starter WIRKLICH steht: in der
// Fensterliste des Servers, ueber ALLE Ebenen. Das ist dieselbe
// Quelle, die `list_read` liest -- nur ohne den Filter, der hier
// falsch ist. Gefunden wird ueber `WL_APP` ("launcher"), den der
// Starter selbst mit `wlib.window_app` setzt; der Titel taugt dafuer
// nicht, weil er uebersetzt wird.
fn launcher_window() -> u64 {
    var slot: u64 = 0
    while slot < 16 {
        let r: u64 = wlibc.win_list(slot, (&rec[0 as usize]) as u64)
        if ulib.bad(r) {
            return 0
        }
        if r == 1 {
            let b: u64 = (&rec[0 as usize]) as u64
            if ulib.streq(b + wlibc.WL_APP,
                (&a_launcher[0 as usize]) as u64) {
                // Nebenbei den Zustand mitnehmen, damit der Aufrufer
                // sagen kann, WOHIN er geschaltet hat (siehe
                // `startmenue_um`). Ein Fenster gilt als "offen", wenn
                // es weder verborgen noch unbeachtet ist.
                let fl: u64 = __mmio_read64((b + wlibc.WL_FLAGS) as *mut u64)
                let id: u64 = __mmio_read64((b + wlibc.WL_ID) as *mut u64)
                menue_war_offen = 1
                if (fl & wlibc.F_HIDDEN) != 0 {
                    menue_war_offen = 0
                }
                // ============================================ RUNDE GRIFF
                // DER FOKUS ZAEHLT HIER NICHT MEHR -- UND ZWAR AUS
                // DEMSELBEN GRUND WIE IN `sysgui` BEI WA_TOGGLE.
                //
                // Hier stand: "verborgen ODER nicht aktiv heisst: wird
                // aufgemacht". Fuer das Startmenue ist das falsch. Es
                // liegt auf L_TOP und damit immer vorn, aber den
                // Eingabefokus verliert es an JEDEN Klick auf die
                // Leiste -- und ein Klick auf die Leiste ist genau das,
                // was gerade passiert ist, wenn diese Zeile laeuft.
                //
                // Die Folge war eine Meldung, die das Gegenteil dessen
                // sagte, was geschah: zweimal "startmenue auf" bei zwei
                // Klicks, waehrend das Menue im Bild die ganze Zeit
                // offen stand.
                //
                // DIESE FUNKTION UND `sysgui` MUESSEN DIESELBE FRAGE
                // STELLEN, sonst meldet die Leiste die eine Richtung
                // und der Server tut die andere. Beide fragen jetzt
                // nur noch: ist es verborgen?
                let _fo: u64 = __mmio_read64((b + wlibc.WL_FOCUS) as *mut u64)
                return id
            }
        }
        slot = slot + 1
    }
    return 0
}

static mut a_launcher: [u8; 9] = "launcher\0"
// RUNDE TUERSCHLOSS: ZWEI Meldungen statt einer. Bis hierher stand hier
// nur "startmenue zu" -- und sie wurde bei JEDEM Umschalten gesagt,
// also auch beim Aufmachen. Wer die Leitung liest, um zu wissen, ob das
// Menue offen ist (ein Testlaeufer tut genau das), bekam dreimal
// hintereinander "zu" und schloss daraus, das Menue gehe nicht auf.
// Eine Meldung, die die Richtung verschweigt, ist keine Messung.
static mut s_tog: [u8; 24] = "taskbar: startmenue zu\0\0"
static mut s_tog_auf: [u8; 25] = "taskbar: startmenue auf\0\0"
static mut s_tog_bad: [u8; 31] = "taskbar: startmenue FEHLER rc=\0"
static mut menue_war_offen: u64 = 0

// ============================================== RUNDE STARTKNOPF
// DIE SUPER-TASTE, GELESEN NACH DEM ZAEHLERPROTOKOLL AUS kbd.fi.
//
// Der Kern schreibt Taste, Zeitstempel und einen ZAEHLER; wer eine
// Zahl sieht, die er noch nicht hatte, handelt genau einmal. Zwei
// Leser (dieser hier und `qs.step` fuer Super+A) nehmen sich den
// Druck damit nicht gegenseitig weg -- das ist der ganze Grund fuer
// den Zaehler statt einer Fahne.
//
// Taste 0 heisst SUPER ALLEIN (kein Zeichen hat den Wert null).
static mut hk_gesehen: u64 = 0
static mut hk_erst: u64 = 1

// ==================================================== RUNDE LEISTE
// DER ERSTE DRUCK AUF SUPER ZAEHLTE NICHT -- UND DAS WAR FALSCH.
//
// Gemessen am fertigen Abbild (UEFI, xHCI-Tastatur, 3440x1440):
//
//     hk: super allein
//     hk: super allein
//
// Der Kern hat beide Male erkannt, dass Super ALLEIN gedrueckt und
// losgelassen wurde -- und die Leiste hat nichts getan. Grund: `hk_erst`
// verschluckte die erste Aenderung des Zaehlers UNBEDINGT, mit der
// Begruendung "was vor dem Start der Leiste gedrueckt wurde, ist nicht
// an sie gerichtet". Die Begruendung stimmt, die Umsetzung nicht: die
// erste Aenderung, die die Leiste sieht, ist bei `seq == 1` der ERSTE
// Druck ueberhaupt -- und der ist sehr wohl an sie gerichtet.
//
// `qs.step` (Super+A) macht es seit der Runde NETVIEW richtig und
// genau eine Zeile anders: `if was != 0 || seq == 1`. Verschluckt wird
// nur, was WIRKLICH vor der Leiste da war (Zaehler stand schon hoeher,
// als sie das erste Mal hinsah). Dieselbe Regel steht jetzt hier.
//
// Und der Zustand wird GESAGT. Eine Klinke, die still nichts tut, ist
// von einer Tastatur, die nichts liefert, nicht zu unterscheiden --
// genau daran ist diese Runde beim Messen haengengeblieben.
static mut hk_sagte: u64 = 0

// ==================================================== RUNDE ECHTHARDWARE-2
//
// WAS UNTER DEM ZEIGER LIEGT -- UND DIE BLASE DAZU.
//
// Justins Vorgabe E: Verweilen auf einem Symbol der Leiste, im Tray
// oder auf einem Fensterknopf zeigt nach einer halben Sekunde einen
// Infotext.
//
// DIE MARKE IST EINE ZAHL UND KEIN ZEIGER. `wlib.tip_hover` vergleicht
// nur, OB sich geaendert hat, worauf gedeutet wird; ein Zeiger auf
// einen Titel waere derselbe, waehrend sich der Titel darunter aendert.
// 1..n sind die Fensterknoepfe, 900 der Startknopf, 901 das Netzfeld,
// 902 die Uhr.
fn hover_brand(x: u64, y: u64) -> u64 {
    if x >= st_x && x < st_x + st_w && y >= st_y && y < st_y + st_h {
        return 900
    }
    if f_w[(F_NET) as usize] != 0
        && x >= f_x[(F_NET) as usize]
        && x < f_x[(F_NET) as usize] + f_w[(F_NET) as usize]
        && y >= f_y[(F_NET) as usize]
        && y < f_y[(F_NET) as usize] + f_h[(F_NET) as usize] {
        return 901
    }
    if f_w[(F_CLK) as usize] != 0
        && x >= f_x[(F_CLK) as usize]
        && x < f_x[(F_CLK) as usize] + f_w[(F_CLK) as usize]
        && y >= f_y[(F_CLK) as usize]
        && y < f_y[(F_CLK) as usize] + f_h[(F_CLK) as usize] {
        return 902
    }
    var i: u64 = 0
    while i < nk {
        if kver[(i) as usize] == 0
            && x >= kx[(i) as usize]
            && x < kx[(i) as usize] + kw[(i) as usize]
            && y >= ky[(i) as usize]
            && y < ky[(i) as usize] + kh[(i) as usize] {
            return i + 1
        }
        i = i + 1
    }
    return 0
}

// Der Text zu einer Marke. Fuer einen Fensterknopf ist es der TITEL --
// und das ist der eigentliche Nutzen: die Knoepfe zeigen bei Justins
// Aufloesung nur ein Symbol, der Titel steht nirgends.
fn hover_text(m: u64) -> u64 {
    if m == 900 {
        return msg.get((&k_start[0 as usize]) as u64)
    }
    if m == 901 {
        return full_of(F_NET)
    }
    if m == 902 {
        return full_of(F_CLK)
    }
    if m >= 1 && m <= nk {
        // 40 Oktette je Titel, nicht 32 -- `ktit` ist [u8; 400] fuer
        // zehn Knoepfe. Die Zahl steht auch in `titel_of` (Zeile 2014).
        return (&ktit[0 as usize]) as u64 + (m - 1) * 40
    }
    return 0
}

// Die Blase, einmal je Umlauf. Sie liest den Zeiger SELBST -- genau
// wie `hover_step` daneben, das seit Langem so arbeitet. Ueber
// EV_MOVE ginge es auch, aber dann haette die Leiste zwei Quellen
// fuer dieselbe Frage "wo steht der Zeiger", und die eine wuerde
// eines Tages von der anderen abweichen.
// ==================================================== RUNDE ECHTHARDWARE-2
//
// RECHTSKLICK AUF EINEN FENSTERKNOPF -> KONTEXTMENUE (Justins Vorgabe E).
//
// ZWEI PUNKTE, UND BEIDE TUN WIRKLICH ETWAS.
//
// Justin hat "Close, Pin" genannt. SCHLIESSEN gibt es in diesem Kern
// nicht: `WM_ACT` kennt WA_RAISE, WA_HIDE und WA_TOGGLE und KEIN
// WA_CLOSE (kernel/sys.fi:3519-3521) -- ein fremdes Fenster zu
// schliessen ist ein Systemaufruf, den es hier noch nicht gibt.
//
// Also steht im Menue, was WIRKLICH geht: MINIMIEREN (WA_HIDE) und
// ANHEFTEN. Einen Punkt "Schliessen" anzubieten, der nichts tut, waere
// genau die Luege mit runden Ecken, vor der der Kopf von qs.fi warnt.
// Sobald der Kern ein WA_CLOSE hat, ist hier eine Zeile zu aendern.
static mut ctx_knopf: u64 = 0 // welcher Knopf, 1-basiert (0 = keiner)
static mut ctx_offen: u64 = 0
static mut angeheftet: [u64; 10] = [0 as u64; 10]

static mut s_ctxauf: [u8; 22] = "taskbar: kontext btn=\0"
static mut s_ctxtat: [u8; 20] = "taskbar: kontext w=\0"
static mut s_ctxpump: [u8; 27] = "taskbar: kontext pumpe mw=\0"
static mut ctx_sagte: u64 = 0

fn rechtsklick(x: u64, y: u64) {
    let m: u64 = hover_brand(x, y)
    if m < 1 || m > nk {
        return
    }
    tip_close()
    ctx_knopf = m
    ctx_offen = 1
    ctx_sagte = 0
    // Das Menue steht ueber der Leiste -- `menu_open` klappt nach oben
    // auf, wenn unten kein Platz mehr ist, und unter der Leiste ist
    // nie Platz.
    let mw: u64 = wlib.menu_open(0, wlibc.mouse_x(), wlibc.mouse_y(),
        msg.get((&k_ctx[0 as usize]) as u64), 2)
    // ===================================== RUNDE ECHTHARDWARE-3
    // HIER STAND EINE NACHHILFE, DIE JETZT UEBERFLUESSIG IST.
    //
    // Die Vorrunde hat das Kontextmenue von Hand auf `L_TOP` gelegt,
    // weil `menu_open` es auf der normalen Ebene anlegte und das
    // Startmenue (damals ebenfalls L_TOP) darueber lag. Damit lagen
    // Leiste, Startmenue und Kontextmenue auf EINER Ebene, und wer
    // oben war, entschied die Reihenfolge des Anlegens.
    //
    // Seit dieser Runde hat jede Oberflaechenart ihre eigene Ebene
    // (wm.fi: L_TOP < L_MENUE < L_POPUP < L_TIP), und `menu_open`
    // legt sich selbst auf `L_POPUP`. Diese Stelle muss nichts mehr
    // richten -- sie durfte es auch nie: `tip_win_id` auf ein
    // MENUE-Fenster anzuwenden war ein Griff in die falsche Tabelle.
    say((&s_ctxauf[0 as usize]) as u64)
    sayn(m)
    nl()
}

// ==================================================== RUNDE ECHTHARDWARE-3
// EINE TASTE, DIE AN DIE LEISTE GING.
//
// Die Leiste selbst hat kein Textfeld. Was sie mit einer Taste tun
// muss, ist trotzdem nicht nichts:
//
//   * Ist ein KONTEXTMENUE offen, gehoert die Taste ihm -- das Menue
//     ist ein wlib-Fenster, und `wlib.on_key` fuehrt darin Hoch,
//     Runter, Eingabe und Flucht. Ohne diesen Weg liess sich ein
//     Menue nur mit der Maus bedienen.
//   * FLUCHT schliesst ein offenes Menue, auch wenn `wlib` gerade
//     nichts damit anfangen kann.
//
// Alles andere wird bewusst verworfen -- aber SICHTBAR verworfen und
// nicht stillschweigend wie bisher.
fn tb_key(c: u64) {
    if ctx_offen != 0 {
        wlib.feed_key(c)
        return
    }
}

// Was gewaehlt wurde, einmal je Umlauf abgeholt.
fn kontext_step() {
    if ctx_offen == 0 {
        return
    }
    // ===================================== RUNDE ECHTHARDWARE-2
    // DAS MENUE BRAUCHT SEINE EIGENE EREIGNISSCHLEIFE.
    //
    // Die Leiste holt ihre Ereignisse SELBST (WM_EVENT auf ihr eigenes
    // Fenster) und ruft `wlib.step` nie. Das Menue ist aber ein
    // eigenes wlib-Fenster, und `mn_res` -- die Antwort "welcher Punkt
    // wurde gewaehlt" -- wird AUSSCHLIESSLICH in `wlib.step` gesetzt
    // (wlib.fi:6091 und 6111). Ohne diesen Aufruf klappt das Menue auf,
    // nimmt Klicks entgegen und sagt nie, was gewaehlt wurde.
    //
    // GEMESSEN: `taskbar: kontext btn=1` kam, `kontext w=` nie -- der
    // Klick landete richtig, die Antwort holte niemand ab.
    let _st: u64 = wlib.step()
    let r: u64 = wlib.menu_at()
    // Solange die Antwort aussteht, wird EINMAL gesagt, dass ueberhaupt
    // gepumpt wird -- sonst ist "der Klick kam nicht an" von "die
    // Schleife laeuft nicht" nicht zu unterscheiden.
    if r == 0xFFFFFFFFFFFFFFFF {
        return
    }
    ctx_offen = 0
    wlib.menu_close()
    let i: u64 = ctx_knopf - 1
    if r == 0xFFFF || i >= nk {
        return
    }
    if r == 0 {
        // MINIMIEREN
        let _a: u64 = wlibc.win_act(knv[(i) as usize], wlibc.WA_HIDE)
    } else {
        // ANHEFTEN -- der Knopf bleibt, wenn das Fenster geht.
        angeheftet[(i) as usize] = 1
    }
    say((&s_ctxtat[0 as usize]) as u64)
    sayn(r)
    nl()
}

// ==================================================== RUNDE ECHTHARDWARE-2
//
// DIE INFOBLASE -- HIER UND NICHT IN DER BIBLIOTHEK.
//
// Justins Vorgabe E: wer mit dem Zeiger auf einem Symbol der Leiste,
// im Tray oder auf einem Fensterknopf STEHENBLEIBT, soll nach einer
// halben Sekunde lesen koennen, was das ist.
//
// SIE STEHT IN DIESER DATEI, weil sie GENAU EIN Programm braucht. Der
// erste Entwurf hatte sie in `wlib.fi`; danach brach der
// selbstgehostete Uebersetzer `firnc1` an `netmon`, `freunde` und
// `powermon` ab (RC=1, keine Zeile Ausgabe -- eine feste Tabelle in
// firnc1, kein Speichermangel). `firnc0` uebersetzte dasselbe klaglos
// und das Abbild lief; gesehen hat es nur der K16-Pruefstand: "131
// gebunden, erwartet 134". wlib steckt in dreizehn Programmen, und was
// dort liegt, kostet in jedem davon.
//
// DER ZEITGEBER SCHLAEGT 100-MAL JE SEKUNDE (TICK_HZ = 100 in
// kernel/sys.fi), also sind Justins 500 ms FUENFZIG Schlaege und nicht
// fuenfhundert. Mit 500 haette die Blase erst nach fuenf Sekunden
// gestanden -- und wer fuenf Sekunden wartet, haelt sie fuer kaputt.
const TIP_TICKS: u64 = 50 // 500 ms bei 100 Hz

static mut tp_win: u64 = 0xFFFFFFFFFFFFFFFF
static mut tp_was: u64 = 0 // welche Marke gerade gilt (0 = keine)
static mut tp_seit: u64 = 0 // seit wann, in Schlaegen
static mut tp_zahl: u64 = 0

static mut s_tip: [u8; 12] = "wlib: tip [\0"
static mut s_tipx: [u8; 7] = "] x=\0\0\0"
static mut s_tipy: [u8; 5] = " y=\0\0"
static mut s_tipn: [u8; 5] = " n=\0\0"
static mut s_tipzu: [u8; 15] = "wlib: tip zu\0\0\0"
static mut s_tipvoll: [u8; 21] = "wlib: tip kein Platz\0"

fn tip_open_is() -> bool {
    return tp_win != 0xFFFFFFFFFFFFFFFF
}

fn tip_close() {
    if tp_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    let i: u64 = tp_win
    tp_win = 0xFFFFFFFFFFFFFFFF
    wlib.tip_win_close(i)
    say((&s_tipzu[0 as usize]) as u64)
    nl()
}

// Die Blase AUFMACHEN. `sx`/`sy` ist der Punkt, an dem der Zeiger
// steht; sie setzt sich DARUEBER -- unter dem Zeiger verdeckte sie das,
// worueber sie spricht.
fn tip_open(text: u64, sx: u64, sy: u64) {
    if text == 0 || tlen(text) == 0 {
        return
    }
    tip_close()
    let n: u64 = tlen(text)
    let sc: u64 = wlibc.ui_scale()
    let pad: u64 = 6 * sc
    let bw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), text, n) + 2 * pad
    let bh: u64 = wlibc.text_h(wlibc.px_ui()) + pad
    // ==================================== RUNDE ECHTHARDWARE-4
    // DIE BLASE LIEGT NEBEN DER LEISTE UND NICHT AUF IHR.
    //
    // Justins Messung B an hell-2560/01-schreibtisch.png: die Blase
    // "Start" wurde UEBER dem Startsymbol gezeichnet und verdeckte es
    // teilweise. Der Grund stand hier: gerechnet wurde vom
    // ZEIGERPUNKT (`sy - bh - 4`), und der Zeiger steht mitten auf dem
    // Knopf -- vier Bildpunkte ueber der Zeigerspitze ist immer noch
    // im Knopf.
    //
    // Eine Blase gehoert NEBEN das, worueber sie spricht. Jede Blase
    // dieser Leiste spricht ueber etwas, das IN der Leiste liegt, also
    // ist die Antwort fuer alle dieselbe: ganz aus der Leiste heraus,
    // mit einem Abstand von der Kante. Unten liegende Leiste ->
    // darueber, oben liegende -> darunter. Damit ueberdeckt sie kein
    // Symbol, egal wo der Zeiger steht.
    //
    // Waagrecht wird sie auf dem Zeiger ZENTRIERT statt links an ihm
    // aufgehaengt -- so steht sie auch am rechten Bildschirmrand nicht
    // schief unter der Uhr.
    let luft: u64 = 6 * sc
    // ============================== RUNDE BELEG: fUi SAGT, WO SIE HINGEHOERT.
    //
    // Hier stand die Rechnung selbst -- waagrecht zentrieren, am Rand
    // klemmen, senkrecht ueber die Leiste. Justins Befund am Abbild
    // zeigt, warum das zu wenig ist: die Blase "no network" stand bei
    // x 1140..1215 und damit in derselben Spalte wie die Uhr
    // (x 1166..1269), und ihre Unterkante beruehrte die Leiste bei
    // y 760. Klemmen schiebt eine Blase eben dorthin, wo sie nicht
    // hinsoll.
    //
    // Die Regel steht jetzt EINMAL in fUi (`wave2.tooltip_place`) und
    // gilt damit fuer jeden, der eine Blase zeigt -- nicht als
    // Sonderfall dieser Leiste. Was diese Leiste beisteuert, sind die
    // zwei Rechtecke, die sie kennt und fUi nicht: ihr eigenes
    // (die Blase darf nicht hinein) und das Uhrfeld (es muss lesbar
    // bleiben).
    var x: u64 = 0
    var y: u64 = 0
    var ax0: u64 = 0
    var ax1: u64 = 0
    if f_w[(F_CLK) as usize] != 0 {
        ax0 = bar_x + f_x[(F_CLK) as usize]
        ax1 = ax0 + f_w[(F_CLK) as usize]
    }
    fuib.tip_place(sx, sy, bw, bh, wlibc.screen_w(), wlibc.screen_h(),
        bar_y, bar_y + bar_h, ax0, ax1, luft, &x, &y)
    let i: u64 = wlib.tip_win_open(x, y, bw, bh, text)
    if i >= 5 {
        // KEIN PLATZ -- und das wird GESAGT. Eine Blase, die still
        // ausbleibt, ist von einer Blase, die gar nicht ausgeloest
        // wurde, nicht zu unterscheiden; genau daran ist diese Runde
        // einmal haengengeblieben.
        say((&s_tipvoll[0 as usize]) as u64)
        nl()
        return
    }
    tp_win = i
    tp_zahl = tp_zahl + 1
    tip_malen(i, text, n, bw, bh)
    say((&s_tip[0 as usize]) as u64)
    say(text)
    say((&s_tipx[0 as usize]) as u64)
    sayn(x)
    say((&s_tipy[0 as usize]) as u64)
    sayn(y)
    say((&s_tipn[0 as usize]) as u64)
    sayn(tp_zahl)
    nl()
}

// Flaeche, Rand und Text -- durch das Rahmenwerk, damit die Blase unter
// `osum` runde Ecken hat und unter `classic` eckige.
fn tip_malen(i: u64, text: u64, n: u64, bw: u64, bh: u64) {
    let hd: u64 = wlib.tip_win_id(i)
    if hd == 0 {
        return
    }
    wlibc.set_band(0)
    wlibc.clip_set(0, 0, bw, bh)
    wlib.draw_board(0, 0, bw, bh, wlib.MR_TAFEL, wlibc.EL_OVERLAY,
        wlibc.theme(wlibc.T_MENU), wlibc.theme(wlibc.T_LINE))
    let pad: u64 = 6 * wlibc.ui_scale()
    let base: u64 = (bh + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
    let _e: u64 = wlib.draw_text(pad, base, text, n,
        wlibc.theme(wlibc.T_FG), wlibc.TY_BODY)
    wlibc.push(hd, 0, 0, bw, bh)
}

// DER VERWEILZEITGEBER, als reine Rechnung. Wechselt die Marke, faengt
// die Zeit von vorn an und eine offene Blase geht zu. Bleibt sie laenger
// als TIP_TICKS gleich, geht die Blase auf.
fn tip_hover(was: u64, text: u64, sx: u64, sy: u64) {
    let jetzt: u64 = ticks_now()
    if was != tp_was {
        tp_was = was
        tp_seit = jetzt
        tip_close()
        return
    }
    if was == 0 || tip_open_is() {
        return
    }
    if jetzt < tp_seit {
        tp_seit = jetzt
        return
    }
    if jetzt - tp_seit >= TIP_TICKS {
        tip_open(text, sx, sy)
    }
}

fn ticks_now() -> u64 {
    return ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
}

fn tip_step() {
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    if !inside_bar(mx, my) {
        tip_hover(0, 0, 0, 0)
        return
    }
    let lx: u64 = mx - bar_x
    let ly: u64 = my - bar_y
    let m: u64 = hover_brand(lx, ly)
    // Die Blase steht in SCHIRM-Koordinaten.
    tip_hover(m, hover_text(m), mx, my)
}

fn hotkey_step() {
    let seq: u64 = nv.hotkey_seq()
    if seq == hk_gesehen {
        return
    }
    let war: u64 = hk_gesehen
    hk_gesehen = seq
    let taste: u64 = nv.hotkey_key()
    if hk_sagte < 8 {
        hk_sagte = hk_sagte + 1
        say((&s_hk[0 as usize]) as u64)
        sayn(seq)
        say((&s_hkw[0 as usize]) as u64)
        sayn(war)
        say((&s_hkt[0 as usize]) as u64)
        sayn(taste)
        nl()
    }
    // Verschluckt wird nur ein Stand, der schon VOR dem ersten Blick
    // der Leiste hochgezaehlt war.
    if war == 0 && seq != 1 {
        hk_erst = 0
        return
    }
    hk_erst = 0
    if taste == 0 {
        startmenue_um()
        return
    }
    // ROUND TON-2: SUPER+M SILENCES THE MACHINE.
    //
    // `m` and not one of the multimedia keys, because this kernel's
    // keyboard driver (kernel/kbd.fi) delivers letters and not the
    // extended scan codes a media key sends -- a shortcut on a key
    // that never arrives is not a shortcut. `m` for mute is what
    // Windows, GNOME and KDE all use for the same thing.
    //
    // THE HOTKEY IS THE SAME LATCH AS SUPER+A: read the counter, act
    // once. Nothing is acknowledged, so the panel and the bar can both
    // watch it without taking the press from each other.
    // ============================================== RUNDE ANMELDUNG
    // SUPER+L STEHT HIER NICHT -- ES STEHT IM KERN.
    //
    // Der erste Anlauf dieser Runde hat hier eine Klinke fuer `l`
    // eingebaut, wie es sie fuer `m` (stumm) und `a` (Kontrollzentrum)
    // gibt. Sie hat NIE ausgeloest, und das ist gut so: `kernel/kbd.fi`
    // faengt Super+L eine Ebene tiefer ab und kehrt zurueck, BEVOR der
    // Hotkey-Zaehler gesetzt wird --
    //
    //     if c == 108 || c == 76 { ... SP_ON = 1 ... return }
    //
    // Die Sperre gehoert dorthin, und die Begruendung steht dort auch:
    // sie muss auch dann gehen, wenn die Oberflaeche haengt. Eine
    // Leiste, die haengt, koennte ihre eigene Klinke nicht mehr lesen.
    //
    // WAS DER ZWEITE SPERRER GEKOSTET HAT, damit es niemand wiederholt:
    // die Leiste hat zusaetzlich `/bin/lock` gestartet, der Kern hat
    // seinen Waechter danebengestellt, und im Bericht standen ZWEI
    // "sperre: Sperrer neu" mit zwei Prozessnummern. Gemessen am
    // Abnahmelauf vom 13.09.
    if taste == 109 {
        if snd_da != 0 {
            let an: u64 = ulib.sys(SYS_AUDGET, A_MUTED, 0, 0)
            var neu2: u64 = 1
            if an == 1 {
                neu2 = 0
            }
            let rc: u64 = ulib.sys(SYS_AUDSET, AS_MUTE, neu2, 0)
            say((&s_hkmute[0 as usize]) as u64)
            sayn(neu2)
            say((&s_hkrc[0 as usize]) as u64)
            sayn(rc)
            nl()
            snd_mute = neu2
            status_build()
            paint(false)
        }
        return
    }
}

static mut s_mkv: [u8; 26] = "taskbar: marke vektor px=\0"
static mut s_hkmute: [u8; 21] = "taskbar: hk mute on=\0"
static mut s_hkrc: [u8; 5] = " rc=\0"

static mut s_hk: [u8; 21] = "taskbar: klinke seq=\0"
static mut s_hkw: [u8; 7] = "  war=\0"
static mut s_hkt: [u8; 9] = "  taste=\0"

fn startmenue_um() {
    let w: u64 = launcher_window()
    if w != 0 {
        // ============================================== RUNDE GRIFF
        // DER RUECKGABEWERT WIRD ANGESEHEN, UND ZWAR VOR DER MELDUNG.
        //
        // Hier stand `let _rc:` -- der Wert wurde geholt und
        // weggeworfen, und danach wurde in JEDEM Fall gesagt, das
        // Menue sei auf- oder zugegangen. Solange `sysgui` jeden
        // Aufruf auf ein L_TOP-Fenster mit `E_RIGHTS` abgewiesen hat
        // (die Begruendung steht dort), meldete die Leiste also einen
        // Erfolg, den es nicht gab: auf der Leitung stand
        // "startmenue auf", auf dem Schirm blieb alles stehen, und
        // zwei Abnahmebilder waren Oktett fuer Oktett gleich.
        //
        // Eine Meldung, die nicht nachsieht, ob die Tat gelungen ist,
        // ist keine Messung -- sie ist eine Behauptung. Schlaegt der
        // Aufruf fehl, wird das MIT dem Fehlercode gesagt.
        let rc: u64 = wlibc.win_act(w, wlibc.WA_TOGGLE)
        if ulib.bad(rc) {
            say((&s_tog_bad[0 as usize]) as u64)
            sayn(rc)
            nl()
            return
        }
        // NACH dem Umschalten gesagt, und mit der Richtung, in die
        // geschaltet wurde: `menue_war_offen` hat `launcher_fenster`
        // eine Zeile vorher aus den Fahnen des Servers gelesen.
        if menue_war_offen != 0 {
            say((&s_tog[0 as usize]) as u64)
        } else {
            say((&s_tog_auf[0 as usize]) as u64)
        }
        nl()
        return
    }
    // ============================================== RUNDE BLECHKERN
    // DER STARTKNOPF HAT NIE EIN PROGRAMM GESTARTET.
    //
    // Hier stand `SYS_SPAWN` mit dem PFAD `/bin/launcher` als erstem
    // Argument. `SYS_SPAWN` (1000) nimmt aber keine Anschrift, sondern
    // eine NUMMER aus `uprog.fi`:
    //
    //     fn do_spawn(state, me, prog, arg) {
    //         if prog == 0 || prog > 16 { return neg(errno.E_INVAL) }
    //
    // Ein Zeiger ist immer groesser als 16, also kam jedes Mal -22
    // zurueck. Auf der Leitung stand `taskbar: launcher pid=-22`, auf
    // dem Schirm passierte nichts, und weil bis zu dieser Runde kein
    // Lauf den 30 Bildpunkte breiten Knopf getroffen hat, ist es nie
    // aufgefallen. Der richtige Aufruf ist `SYS_EXEC` (1001) -- der
    // nimmt einen Pfad, so wie `explorer`, `firun` und `launcher` ihn
    // schon benutzen.
    let pid: u64 = ulib.sys(ulib.SYS_EXEC,
        (&p_start[0 as usize]) as u64, 0, 0)
    menue_pid = pid
    say((&s_sp[0 as usize]) as u64)
    sayn(pid)
    nl()
}

fn click(x: u64, y: u64) {
    clicks = clicks + 1
    say((&s_cl[0 as usize]) as u64)
    sayn(x)
    say((&s_cy[0 as usize]) as u64)
    sayn(y)
    // THIRD ADDENDUM: the icon group in the corner opens the quick
    // settings, the way the same corner does on every system that has
    // such a panel. Before the window buttons, because it is a field
    // and not a button and would otherwise fall through to the drag.
    if x >= f_x[(F_NET) as usize]
        && x < f_x[(F_NET) as usize] + f_w[(F_NET) as usize]
        && y >= f_y[(F_NET) as usize]
        && y < f_y[(F_NET) as usize] + f_h[(F_NET) as usize] {
        say((&s_ct[0 as usize]) as u64)
        say((&z_qs[0 as usize]) as u64)
        nl()
        qs.toggle()
        return
    }
    // ROUND TON-2: THE SPEAKER OPENS THE SAME PANEL. It is the field
    // next door and it belongs to the same corner -- a symbol that
    // shows a state and does nothing when it is clicked is a symbol
    // that teaches people not to click it.
    if snd_da != 0 && f_w[(F_SND) as usize] != 0
        && x >= f_x[(F_SND) as usize]
        && x < f_x[(F_SND) as usize] + f_w[(F_SND) as usize]
        && y >= f_y[(F_SND) as usize]
        && y < f_y[(F_SND) as usize] + f_h[(F_SND) as usize] {
        say((&s_ct[0 as usize]) as u64)
        say((&z_qs[0 as usize]) as u64)
        nl()
        qs.toggle()
        return
    }
    if x >= st_x && x < st_x + st_w && y >= st_y && y < st_y + st_h {
        say((&s_ct[0 as usize]) as u64)
        say((&z_start[0 as usize]) as u64)
        nl()
        startmenue_um()
        return
    }
    // ==================================================== RUNDE ANHEFTEN
    // KLICK AUF EINEN ANHEFTER. Zwei Faelle, und der Unterschied ist
    // der ganze Sinn der Sache:
    //   laeuft nicht -> STARTEN (`SYS_EXEC` auf /apps/<name>.osp/start,
    //                  denselben Pfad benutzt der Starter)
    //   laeuft       -> das Fenster schalten, wie ein Fensterknopf.
    // Ein Anhefter, der ein zweites Certus startet, waere ein Fehler
    // und keine Bequemlichkeit.
    var pk: u64 = 0
    while pk < npin {
        if pw_[(pk) as usize] != 0
            && x >= px_[(pk) as usize]
            && x < px_[(pk) as usize] + pw_[(pk) as usize]
            && y >= py_[(pk) as usize]
            && y < py_[(pk) as usize] + ph_[(pk) as usize] {
            let w2: u64 = pinwin[(pk) as usize]
            if w2 < MAXK {
                let rc2: u64 = wlibc.win_act(kid[(w2) as usize],
                    wlibc.WA_TOGGLE)
                acts = acts + 1
                say((&s_pinact[0 as usize]) as u64)
                say((&pinname[0 as usize]) as u64 + pk * 24)
                say((&s_rc[0 as usize]) as u64)
                sayn(rc2)
                nl()
            } else {
                // Der Pfad wird hier gebaut: /apps/<name>.osp/start
                var pp: [u8; 64] = [0 as u8; 64]
                var pv: [u8; 7] = "/apps/\0"
                var pn2: [u8; 11] = ".osp/start\0"
                var q2: u64 = 0
                var k2: u64 = 0
                while k2 < 6 {
                    pp[(q2) as usize] = pv[(k2) as usize]
                    q2 = q2 + 1
                    k2 = k2 + 1
                }
                let src: u64 = (&pinname[0 as usize]) as u64 + pk * 24
                k2 = 0
                while k2 < 23 && kstate8(src + k2) != 0 {
                    pp[(q2) as usize] = *((src + k2) as *mut u8)
                    q2 = q2 + 1
                    k2 = k2 + 1
                }
                k2 = 0
                while k2 < 10 {
                    pp[(q2) as usize] = pn2[(k2) as usize]
                    q2 = q2 + 1
                    k2 = k2 + 1
                }
                pp[(q2) as usize] = 0 as u8
                let pid2: u64 = ulib.sys(ulib.SYS_EXEC,
                    (&pp[0 as usize]) as u64, 0, 0)
                say((&s_pinexec[0 as usize]) as u64)
                say((&pp[0 as usize]) as u64)
                say((&s_pinpid[0 as usize]) as u64)
                sayn(pid2)
                nl()
            }
            let _a2: bool = list_read()
            layout()
            paint(true)
            return
        }
        pk = pk + 1
    }
    var i: u64 = 0
    while i < nk {
        if kw[(i) as usize] != 0 {
            if x >= kx[(i) as usize] && x < kx[(i) as usize] + kw[(i) as usize]
                && y >= ky[(i) as usize]
                && y < ky[(i) as usize] + kh[(i) as usize] {
                say((&s_ct[0 as usize]) as u64)
                say((&z_task[0 as usize]) as u64)
                nl()
                let rc: u64 = wlibc.win_act(kid[(i) as usize],
                    wlibc.WA_TOGGLE)
                acts = acts + 1
                say((&s_act[0 as usize]) as u64)
                sayn(kid[(i) as usize])
                say((&s_aw[0 as usize]) as u64)
                sayn(wlibc.WA_TOGGLE)
                say((&s_rc[0 as usize]) as u64)
                sayn(rc)
                nl()
                let _a: bool = list_read()
                layout()
                paint(true)
                return
            }
        }
        i = i + 1
    }
    // NOTHING WAS HIT -- so this press is the beginning of a drag. That
    // is the whole gesture: press on an empty part of the bar and pull.
    say((&s_ct[0 as usize]) as u64)
    say((&z_none[0 as usize]) as u64)
    nl()
    dragging = 1
    drag_edge = cf_edge
    prev_edge = 9
    say((&s_d0[0 as usize]) as u64)
    say((&s_gx[0 as usize]) as u64)
    sayn(x)
    say((&s_cy[0 as usize]) as u64)
    sayn(y)
    nl()
}

// ================================================================ main

static mut s_bad: [u8; 23] = "taskbar: no surface\0\0\0\0"
static mut s_nol: [u8; 40] = "taskbar: no layer 2 -- not root?\0\0\0\0\0\0\0\0"
static mut s_rdy: [u8; 22] = "taskbar: ready ascent\0"
static mut s_eq: [u8; 2] = "=\0"
static mut s_stt: [u8; 18] = "taskbar: state n=\0"
// RUNDE 31: HAT fUi WIRKLICH GEMALT?
//
// `wlib.paint_button` hat einen Rueckfall auf den alten Weg, falls die
// Bruecke keine Flaeche bekommt -- und ein Knopf sieht auf dem Bild in
// beiden Faellen aehnlich aus. Diese zwei Zahlen sind der Unterschied
// zwischen "fUi malt" und "fUi ist eingebaut und tut nichts":
// fui= wie viele Elemente fUi gemalt hat, fuix= wie oft es abgelehnt
// wurde (dann malte wlib selbst).
static mut s_fui: [u8; 6] = " fui=\0"
static mut s_fuix: [u8; 7] = " fuix=\0"
// RUNDE 32: die GRUENDE der Ablehnungen, als eine Zahl:
// bereit*1000000 + leer*10000 + band*100 + art.
static mut s_fuig: [u8; 7] = " fuig=\0"
static mut s_pm: [u8; 9] = " paints=\0"
static mut s_ck: [u8; 9] = " clicks=\0"
static mut s_ac: [u8; 7] = " acts=\0"
static mut s_wt: [u8; 9] = " writes=\0"
// RUNDE UHRWERK: die Pulszeile der Leiste.
static mut s_ur: [u8; 16] = "taskbar: round=\0"
static mut s_usb: [u8; 5] = " sb=\0"
static mut s_usbt: [u8; 6] = " sbt=\0"
static mut s_upx: [u8; 5] = " px=\0"
static mut s_usoll: [u8; 7] = " soll=\0"
static mut s_unull: [u8; 7] = " null=\0"
static mut s_upm: [u8; 5] = " pm=\0"
static mut s_title: [u8; 8] = "Taskbar\0"
static mut s_theme: [u8; 11] = "/etc/theme\0"
static mut a_once: [u8; 5] = "once\0"

fn u_start(args: u64) -> u64 {
    dbg_setup(args)
    var once: bool = false
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        if ulib.streq(ulib.arg_at(args, a), (&a_once[0 as usize]) as u64) {
            once = true
        }
        a = a + 1
    }
    // Gibt es `/etc/uitrace`, meldet die Leiste jede gemalte Textstelle
    // -- sonst schweigt sie. Dieselbe Datei, die `wlib` einschaltet.
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_melde = 1
    }
    let _mk: u64 = msg.init()
    // ================================= RUNDE BLECH-HID: ERST MALEN, DANN REDEN
    //
    // Auf Justins Blech kam von dieser Leiste GENAU EINE UND EINE HALBE
    // ZEILE an: `taskbar: lang=de src=1 keys=200`, darunter
    // `taskbar: icons=` -- und dann nichts mehr, mitten im Wort. Unten
    // am Schirm war keine Leiste.
    //
    // Was daran wirklich falsch war, ist nicht die Zeile, sondern die
    // REIHENFOLGE: dieses Programm hat bis hierher ZUERST ueber sich
    // berichtet und ERST DANACH sein Fenster gebaut und gemalt. Damit
    // steht und faellt die Sichtbarkeit der Leiste mit dem Gelingen
    // ihrer eigenen Ausgabe -- und die geht auf dem Stick nicht in ein
    // Kabel, sondern in ein TERMINALFENSTER, das jedes Oktett rastern
    // muss. Was dort haengenbleibt, haengt VOR dem ersten Malen.
    //
    // Jetzt ist es andersherum: Fenster, Ebene, Aufteilung, ein
    // STILLES erstes Malen -- und erst wenn die Leiste auf dem Schirm
    // steht, wird geredet. Die gedruckten Zeilen sind dieselben und in
    // derselben Folge; sie kommen nur nach dem Bild statt davor. Ein
    // Bericht, ohne den das Berichtete nicht stattfindet, ist kein
    // Bericht.
    if !wlibc.start(false) {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    // RUNDE THEME: nicht mehr eine Datei mit achtzehn Farben, sondern
    // der ganze Satz -- Einstellungen, Schema, Zeitzone, aufgeloest.
    let _t0: u64 = wlibc.theme_reload()
    // ROUND NETVIEW, addendum: the seven pictures, once, at the start.
    // A bar that reads them every repaint would read them sixty times a
    // second for something that never changes.
    //
    // RUNDE BLECH-HID: GELADEN WIRD HIER, GESAGT WIRD ES UNTEN. Ob eine
    // Bilddatei fehlt, entscheidet ueber das AUSSEHEN der Leiste und
    // nicht darueber, DASS es sie gibt -- `state_icon` und `mark_icon`
    // geben 0 zurueck und die Leiste faellt auf Text zurueck. Gemessen
    // mit einem Abbild ohne /etc/netview und ohne /lib/icons.ttf: die
    // Leiste steht, malt zwei Knoepfe, "Start", "kein Netz" und die
    // Uhr. Eine leere Symbolliste ist ein Aussehen, kein Ausfall.
    icons_load()
    sw = wlibc.screen_w()
    sh = wlibc.screen_h()
    asc = wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    cf_height = def_h()
    cf_width = DEF_V
    if conf_read() {
        cf_from_file = 1
    }
    geometry()
    // THE WINDOW IS CREATED AS LARGE AS THE LARGEST CONFIGURATION AND
    // NOT AS LARGE AS THE CURRENT ONE. `win_size` can shrink a window
    // and can grow it back, but it cannot grow it past the buffer it
    // was created with -- and a bar that starts at the bottom (800 x 28,
    // 89 kilooctets) and is dragged to the left (104 x 600, 249) would
    // be refused at exactly that moment.
    let h: u64 = wlibc.sys5(wlibc.WM_CREATE, 0, (V_MAX << 16) | sh,
        txt((&k_title[0 as usize]) as u64,
            (&s_title[0 as usize]) as u64), 0, 0)
    if ulib.bad(h) || h == 0 {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    w_h = h
    if ulib.bad(wlibc.win_state(h, wlibc.WS_DECO, 0)) {
        say((&s_bad[0 as usize]) as u64)
        nl()
        return 1
    }
    // RUNDE BLECH-HID: EINE LEISTE, DIE SICH WEGEN EINER EBENE SELBST
    // SCHLIESST, IST KEINE.
    //
    // Hier stand: Ebene 2 nicht bekommen -> Fenster zumachen -> Ende.
    // Das ist die Regel eines Testlaeufers ("wenn nicht genau so, dann
    // gar nicht") und nicht die eines Programms, das jemand vor sich
    // hat. `L_TOP` heisst "ueber allem"; wer es nicht bekommt, bekommt
    // `L_NORMAL` und ist DANN eben eine Leiste, die ein Fenster
    // verdecken kann -- immer noch besser als keine. Gesagt wird es
    // weiterhin, und `wm: wins ... nolayer=` zaehlt es weiter.
    if ulib.bad(wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_TOP)) {
        say((&s_nol[0 as usize]) as u64)
        nl()
        let _ln: u64 = wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_NORMAL)
        cf_ontop = 0
    }
    apply()
    let _u: bool = status_build()
    let _l: bool = list_read()
    // THIRD ADDENDUM: the quick settings own a second window of this
    // process, created here and kept hidden. Opening it is a move and a
    // repaint and NOT a program start -- which is why it can be timed
    // in microseconds.
    if !qs.init(cf_autohide) {
        say((&s_noqs[0 as usize]) as u64)
        nl()
    }
    apply()
    layout()
    // ============ RUNDE BLECH-HID: DAS ERSTE MALEN IST STILL.
    // Danach steht die Leiste auf dem Schirm, und was jetzt noch
    // gedruckt wird, kann ihr nichts mehr anhaben.
    paint(false)
    say((&s_steht[0 as usize]) as u64)
    sayn(win_x)
    say((&s_gy[0 as usize]) as u64)
    sayn(win_y)
    say((&s_gw[0 as usize]) as u64)
    sayn(win_w)
    say((&s_gh[0 as usize]) as u64)
    sayn(win_h)
    nl()
    // Und erst jetzt der Bericht -- dieselben Zeilen wie vorher, in
    // derselben Folge, nur hinter dem Bild.
    say((&s_lg[0 as usize]) as u64)
    say(msg.lang())
    say((&s_lgs[0 as usize]) as u64)
    sayn(msg.lang_source())
    say((&s_lgk[0 as usize]) as u64)
    sayn(_mk)
    nl()
    say((&s_ico[0 as usize]) as u64)
    sayn(ic_ok)
    say((&s_icm[0 as usize]) as u64)
    sayn(mk_ok)
    say((&s_ics[0 as usize]) as u64)
    sayn(sy_ok)
    say((&s_icf[0 as usize]) as u64)
    sayn(ic_files)
    say((&s_icn[0 as usize]) as u64)
    sayn(ic_min)
    nl()
    conf_say()
    shape_say()
    say((&s_rdy[0 as usize]) as u64)
    say((&s_eq[0 as usize]) as u64)
    sayn(asc)
    nl()
    paint(true)
    geom_say()
    // RUNDE THEME: DIE TASKLEISTE GIBT DEM SERVER DIE DEKORATION.
    // Sie tut es hier und nicht frueher: das Recht dazu haengt daran,
    // dass sie ein Fenster auf der obersten Ebene HAT, und das hat sie
    // erst jetzt. Sie ist auch die richtige Stelle dafuer -- sie ist
    // das Programm, dem die Umrandung des Schreibtischs gehoert.
    var s_dk: [u8; 17] = "taskbar: deko n=\0"
    say((&s_dk[0 as usize]) as u64)
    sayn(wlibc.deco_push())
    // ROUND PAINT: and the FORM right after the colour.  Both come from
    // the same resolved token set, so they have to be pushed together
    // or a `modern` window would get modern colours and classic corners
    // for one repaint.
    var s_fm: [u8; 15] = "  form n=\0\0\0\0\0\0"
    say((&s_fm[0 as usize]) as u64)
    sayn(wlibc.form_push())
    nl()
    if once {
        return 0
    }
    var round: u64 = 0
    var tsum: u64 = wlibc.theme_sum()
    var alive: bool = true
    while alive {
        var n: u64 = 0
        while n < 32 && wlibc.sys3w(wlibc.WM_EVENT, h,
            (&ev[0 as usize]) as u64, 0) == 1 {
            let b: u64 = (&ev[0 as usize]) as u64
            let typ: u64 = __mmio_read64((b) as *mut u64)
            let d: u64 = __mmio_read64((b + 8) as *mut u64)
            if typ == wlibc.EV_DOWN {
                // DIE RECHTE TASTE IST BIT 1 (kernel/ps2m.fi: links 0,
                // rechts 1, Mitte 2) -- dieselbe Zaehlung, die
                // wlib.fi:5047 schon benutzt.
                if ((d & 0xFFFF) & 2) != 0 {
                    rechtsklick((d >> 32) & 0xFFFF, (d >> 16) & 0xFFFF)
                } else {
                    // ============================ RUNDE ANHEFTEN
                    // EIN DRUCK AUF EINEN ANHEFTER IST NOCH KEIN
                    // KLICK. Er wird erst zu einem, wenn die Taste
                    // losgelassen wird, OHNE dass die Schwelle
                    // ueberschritten wurde -- `pin_drag_step` ruft
                    // `click` dann selbst nach. Jeder andere Druck
                    // geht unveraendert durch.
                    let cx: u64 = (d >> 32) & 0xFFFF
                    let cy: u64 = (d >> 16) & 0xFFFF
                    let pg: u64 = pin_under(cx, cy)
                    if pg < npin {
                        pdrag = 1
                        pdrag_i = pg
                        pdrag_x0 = cx
                        pdrag_y0 = cy
                    } else {
                        click(cx, cy)
                    }
                }
            } else if typ == wlibc.EV_KEY {
                // ======================= RUNDE ECHTHARDWARE-3
                // HIER FIELEN DIE TASTEN AUF DEN BODEN.
                //
                // Justins Befund: "Tippen kommt in den Programmen
                // nicht an", waehrend die Tafel `TAS 54` und
                // `BER 111` zeigt -- die Tastatur liefert also
                // sauber. Diese Schleife hat das Ereignis mit
                // `WM_EVENT` ABGEHOLT (und damit aus dem Ring des
                // Servers entfernt) und dann nur auf `EV_DOWN` und
                // `EV_CLOSE` geprueft. Jede Taste, die an die Leiste
                // ging, war damit gelesen und verworfen.
                //
                // Sie gehoert an dieselbe Stelle wie in jedem
                // anderen Programm: `wlib.on_key` -- das ist der
                // Weg, ueber den ein Menue Hoch/Runter/Eingabe/
                // Flucht bekommt.
                tb_key((d >> 32) & 0xFFFF)
            } else if typ == wlibc.EV_CLOSE {
                alive = false
            }
            n = n + 1
        }
        if pdrag != 0 {
            pin_drag_step()
        }
        if dragging != 0 {
            drag_step()
        }
        // THIRD ADDENDUM. The panel polls its own window, the hotkey
        // latch and the pointer; the only thing it hands back is the
        // one setting that lives in a FILE THIS BAR OWNS. Two writers
        // of `/etc/taskbar.conf` inside one process would be two
        // answers to one question.
        let _qsc: bool = qs.step()
        hotkey_step()
        tip_step()
        kontext_step()
        let hw: u64 = qs.want_hide()
        if hw != 0 {
            if hw == 1 {
                cf_autohide = 1
            } else {
                cf_autohide = 0
            }
            let _cw: bool = conf_write()
            conf_say()
            geometry()
            shown = 1
            apply()
            layout()
            paint(true)
            geom_say()
            qs.took_hide(cf_autohide)
        }
        autohide_step()
        round = round + 1
        var fresh: bool = false
        // ROUND NETVIEW, addendum. Every poll, because the pointer
        // moves between polls and a sentence that appears half a second
        // after the pointer arrived is a sentence nobody waits for. It
        // costs a comparison unless something changed.
        if hover_step() {
            fresh = true
        }
        if (round % 5) == 0 {
            if list_read() {
                fresh = true
            }
        }
        if (round % 10) == 0 {
            // RUNDE UHRWERK: gezaehlt, nicht vermutet. `ub_sb` steigt
            // bei jedem Ruf, `ub_sbt` nur, wenn sich wirklich etwas
            // geaendert hat -- bei einer Sekundenuhr also einmal je
            // Sekunde. Stehen beide, laeuft diese Schleife nicht.
            ub_sb = ub_sb + 1
            if status_build() {
                ub_sbt = ub_sbt + 1
                fresh = true
            }
            // RUNDE THEME: `theme_poll` liest nach und sagt, ob sich
            // die AUFGELOESTEN Marken geaendert haben -- nicht, ob
            // jemand eine Datei angefasst hat. Eine Leiste, die nach
            // einem `touch` neu malt, malt umsonst. Und wenn sich
            // wirklich etwas geaendert hat, bekommt der Server die
            // neue Dekoration.
            // ==================================================== RUNDE ECHT
            // DIE DEKORATION MUSS AUCH DANN NACHZIEHEN, WENN DER
            // WECHSEL AUS EINEM ANDEREN PROGRAMM KAM.
            //
            // Justins Befund, von Jarvis am Bild nachgemessen: nach dem
            // Klick auf die Dunkelkachel sind Schreibtisch (13),
            // Taskleiste (41) und Kontrollzentrum dunkel -- das
            // TERMINALFENSTER aber hell: Inhalt 245, Titelleiste 248,
            // Rahmen 232. Ein grelles weisses Rechteck im dunklen
            // System, genau das, was er "alles im white mode" nennt.
            //
            // GEMESSEN: `taskbar: deko` steht GENAU EINMAL im ganzen
            // Protokoll -- beim Start. Nach dem Kachelklick lief die
            // Leiste noch 81 000 Runden und hat `deco_push` NIE wieder
            // gerufen, obwohl sie sich selbst laengst dunkel malte.
            //
            // Der Grund: `theme_poll` meldet einen Wechsel nur, wenn
            // ENTWEDER die Datei sich geaendert hat ODER die Automatik
            // umschlaegt. Das Kontrollzentrum ruft aber
            // `theme_set_mode` in SEINEM Prozess und schreibt die Datei
            // erst danach; die aufgeloesten Marken der Leiste kommen
            // ueber die gemeinsame Bank nach, ohne dass `theme_poll`
            // je wahr wird. Die Leiste sah also neu aus und hielt sich
            // trotzdem fuer unveraendert -- und nur SIE darf dem Server
            // die Dekoration geben (WM_DECO ist ein Taskleisten-Recht).
            //
            // Also wird nicht mehr gefragt, ob jemand eine Datei
            // angefasst hat, sondern ob sich die FARBEN geaendert
            // haben: `theme_sum` ist die Pruefsumme ueber die
            // aufgeloesten Marken. Aendert sie sich, geht die
            // Dekoration hinaus -- egal, wer den Wechsel ausgeloest
            // hat.
            let tpoll: bool = wlibc.theme_poll()
            let tjetzt: u64 = wlibc.theme_sum()
            if tpoll || tjetzt != tsum {
                tsum = tjetzt
                var s_dk2: [u8; 22] = "taskbar: deko neu n=\0\0"
                say((&s_dk2[0 as usize]) as u64)
                sayn(wlibc.deco_push())
                nl()
                let _fk: u64 = wlibc.form_push()
                fresh = true
                // ================================ RUNDE ECHTHARDWARE-5
                // UND DAS KONTROLLZENTRUM GLEICH MIT.
                //
                // Justins Befund J: nach dem Umschalten auf dunkel
                // blieb das offene Panel rechts "komisch blau" und
                // wurde erst beim Schliessen und Neuoeffnen richtig.
                // Hier war der Grund: diese Schleife hat den Wechsel
                // GESEHEN (`theme_poll` oben gibt wahr), aber nur sich
                // selbst neu gemalt. Das Panel hat eine eigene
                // Ereignisschleife und ruft `wlib.step` nie -- es
                // erfaehrt also von sich aus nichts.
                //
                // Eine Zeile, und der Zwischenzustand ist weg.
                let _qt: bool = qs.theme_new()
            }
            // RUNDE I18N: UND DIE SPRACHE, an derselben Stelle und aus
            // demselben Grund wie das Farbschema -- eine Taskleiste,
            // die fuer einen Sprachwechsel einen Neustart braucht, ist
            // keine. `msg.changed` liest die Wahl des Benutzers und
            // fuellt die Plaetze neu; die Zeiger bleiben gueltig, nur
            // ihr Inhalt ist neu. Danach muss `status_build` noch
            // einmal laufen, weil "no battery" in die Puffer KOPIERT
            // wird.
            if msg.changed() {
                let _s2: bool = status_build()
                fresh = true
                // UND EINMAL AUSFUEHRLICH MELDEN: `fresh` fuehrt weiter
                // unten zu `paint(true)`, und das gibt die Textfelder
                // aus. Ein Testlaeufer muss sehen koennen, dass DIESER
                // Prozess -- nicht der, der umgestellt hat -- jetzt
                // eine andere Sprache spricht.
            }
            // AND THE CONFIGURATION. This is how a change made in
            // /bin/settings arrives here without a restart: the
            // settings write the file, the bar notices within half a
            // second. There is no message, no shared memory and no
            // second copy of the state -- there is the file.
            let old_e: u64 = cf_edge
            let old_h: u64 = cf_height
            let old_w: u64 = cf_width
            let old_a: u64 = cf_autohide
            let old_o: u64 = cf_ontop
            if conf_read() {
                if cf_edge != old_e || cf_height != old_h
                    || cf_width != old_w || cf_autohide != old_a
                    || cf_ontop != old_o {
                    conf_say()
                    geometry()
                    shown = 1
                    apply()
                    fresh = true
                    geom_say()
                }
            }
        }
        if fresh && shown != 0 {
            layout()
            // REPORTED, NOT JUST PAINTED -- and the difference cost two
            // measurements. The first version reported the layout only
            // on the very first paint. By the time the screenshot was
            // taken the starter had opened a window, the buttons had
            // been re-laid out and re-shortened, and the runner was
            // comparing the picture against a layout replaced seconds
            // earlier. Every repaint now says what it painted.
            paint(true)
            say((&s_stt[0 as usize]) as u64)
            sayn(nk)
            say((&s_pm[0 as usize]) as u64)
            sayn(paints)
            say((&s_ck[0 as usize]) as u64)
            sayn(clicks)
            say((&s_ac[0 as usize]) as u64)
            sayn(acts)
            say((&s_wt[0 as usize]) as u64)
            sayn(writes)
            say((&s_fui[0 as usize]) as u64)
            sayn(fuib.fui_painted())
            say((&s_fuix[0 as usize]) as u64)
            sayn(fuib.fui_rejected())
            say((&s_fuig[0 as usize]) as u64)
            sayn(fuib.fui_reasons())
            nl()
        }
        // AND ONCE MORE BEFORE THE SLEEP. Measured, not guessed: with
        // one look per turn the hotkey took 93 to 128 milliseconds,
        // because a key pressed early in a turn waits out the whole
        // repaint of the bar -- WITH its report on the serial line --
        // before anything looks at the latch. A second look here costs
        // one system call and takes the repaint out of the wait.
        let _qs2: bool = qs.step()
        // ============================================ RUNDE UHRWERK
        // DER PULS DIESER LEISTE, und er steht bewusst NACH allem
        // anderen: was hier gemeldet wird, ist der Zustand am Ende
        // einer vollstaendigen Runde und nicht der in ihrer Mitte.
        //
        // Alle 200 Runden, also ungefaehr alle fuenf Sekunden --
        // dieselbe Frequenz wie der Puls des Kerns und aus demselben
        // Grund: eine Zeile je Runde waere eine Zeile alle 25 ms, und
        // ein Terminal, das vierzigmal je Sekunde zurollt, ist kein
        // Messgeraet.
        ub_round = ub_round + 1
        if ub_round >= ub_naechster {
            ub_naechster = ub_round + 200
            say((&s_ur[0 as usize]) as u64)
            sayn(ub_round)
            say((&s_usb[0 as usize]) as u64)
            sayn(ub_sb)
            say((&s_usbt[0 as usize]) as u64)
            sayn(ub_sbt)
            say((&s_upx[0 as usize]) as u64)
            sayn(ub_px)
            say((&s_usoll[0 as usize]) as u64)
            sayn(ub_soll)
            say((&s_unull[0 as usize]) as u64)
            sayn(ub_null)
            say((&s_upm[0 as usize]) as u64)
            sayn(paints)
            nl()
        }
        ulib.sleep_ms(25)
    }
    return 0
}

// RUNDE 31: DAS `main`, DAS NIE LAEUFT.
//
// Das Profil `app` verlangt `fn main() -> i32`. Osums Programme
// beginnen aber bei `u_start`, und `user.ld` setzt den Einsprung
// entsprechend (`--defsym=USER_ENTRY=_F0.u_start`) -- dieses `main`
// wird also nie aufgerufen. Es steht hier, damit der Uebersetzer
// zufrieden ist, und es ruft `u_start`, damit es nicht luegt: liefe es
// doch, taete es dasselbe.
fn main() -> i32 {
    return u_start(0) as i32
}
