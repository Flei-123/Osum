// `hx`/`hy` its origin in desktop pixels. `my_head` is the output index (0 = the first head that exists, also when
// no `--head` was given); `head_on` is 1 once the window server answered with a head rectangle. The first instance
// (no `--head`) starts the others (`heads_step`); `spawned` is a bit mask of heads that already got a bar.
static mut hx: u64 = 0
static mut hy: u64 = 0
static mut my_head: u64 = 0
static mut head_arg: u64 = 0
static mut head_on: u64 = 0
