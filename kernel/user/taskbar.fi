    sayn(wlibc.tb_blur())
    say((&g_gc[0 as usize]) as u64)
    sayn(wlibc.radius())
    say((&g_gd[0 as usize]) as u64)
    say_hex6(wlibc.theme(wlibc.C_TASKBAR_BG) & 0xFFFFFF)
    nl()
}

// ========================================== RUNDE GLAS (fix-r4-1)
const SCHILD_STUFE: u64 = 32

fn schild_kanal(c: u64, dunkler: bool) -> u64 {
    if dunkler {
        if c >= SCHILD_STUFE {
            return c - SCHILD_STUFE
        }
        return c + SCHILD_STUFE
    }
    if c + SCHILD_STUFE <= 255 {
        return c + SCHILD_STUFE
    }
    return c - SCHILD_STUFE
}

fn schild_farbe(grund: u64) -> u64 {
    let r: u64 = (grund >> 16) & 0xFF
    let g: u64 = (grund >> 8) & 0xFF
    let b: u64 = grund & 0xFF
    let dunkler: bool = (r * 299 + g * 587 + b * 114) / 1000 >= 128
    return (schild_kanal(r, dunkler) << 16)
        | (schild_kanal(g, dunkler) << 8)
        | schild_kanal(b, dunkler)
}

fn schild_an() -> bool {
    return wlibc.tb_alpha_fx() < 100
}

fn schild_grund(grund: u64) -> u64 {
    if schild_an() {
        return schild_farbe(grund)
    }
    return grund
}

static mut schild_n: u64 = 0

fn schild_noetig(unter: u64) -> bool {
    let key: u64 = wlibc.theme(wlibc.C_TASKBAR_BG)
    var d: u64 = 0
    var s: u64 = 0
    while s < 3 {
        let a: u64 = (unter >> (s * 8)) & 0xFF
        let b: u64 = (key >> (s * 8)) & 0xFF
        if a > b {
            d = d + (a - b)
        } else {
            d = d + (b - a)
        }
        s = s + 1
    }
    return d < 96
}

const SCHILD_TRAY_MIN: u64 = 75
static mut schild_tray: u64 = 0

fn text_schild(x: u64, base: u64, p: u64, n: u64, ty: u64, unter: u64) {
    if !schild_an() {
        return
    }
    if schild_tray != 0 && wlibc.tb_alpha_fx() >= SCHILD_TRAY_MIN {
        return
    }
    if !schild_noetig(unter) {
        return
    }
    if n == 0 {
        return
    }
    let tw: u64 = wlib.draw_text_w(p, n, ty)
    if tw == 0 {
        return
    }
    let asc: u64 = wlib.draw_ascent(ty)
    let luft: u64 = 3 * wlibc.ui_scale()
    var py: u64 = 0
    if base > asc + 1 {
        py = base - asc - 1
    }
    var px: u64 = 0
    if x > luft {
        px = x - luft
    }
    wlib.draw_board(px, py, tw + 2 * luft, line_h() + 2,
        wlib.MR_BUTTON, wlibc.EL_FLAT,
        schild_farbe(wlibc.theme(wlibc.C_TASKBAR_BG)), 0)
    schild_n = schild_n + 1
}

fn text_mit_schild(x: u64, base: u64, p: u64, n: u64, fg: u64,
    ty: u64, unter: u64) -> u64 {
    text_schild(x, base, p, n, ty, unter)
    return wlib.draw_text(x, base, p, n, fg, ty)
}

