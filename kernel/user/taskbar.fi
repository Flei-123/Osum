fn sym_ink(p: u64) -> u64 {
    let w: u64 = wlibc.icon_w(p)
    let h: u64 = wlibc.icon_h(p)
    if w == 0 || h == 0 {
        return 0
    }
    var n: u64 = 0
    var i: u64 = 0
    while i < w * h {
        if (*((p + 12 + i * 4 + 3) as *mut u8)) != 0 as u8 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}
