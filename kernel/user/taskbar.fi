static mut kfok: [u64; 16] = [0 as u64; 16]
// WINDOW GROUPING (Windows 11): windows of one program (same WL_APP name) are ONE button. `kcnt` = windows in the group, `kmem` = their ids
// (8 per group, in slot order). The window the button stands for (kid / kfok / ktit) is the focused one, else the first.
static mut kcnt: [u64; 16] = [0 as u64; 16]
static mut kmem: [u64; 128] = [0 as u64; 128]
// ROUND NETVIEW: the network view of the process each window belongs to.
static mut knv: [u64; 16] = [0 as u64; 16]
static mut ktit: [u8; 640] = [0 as u8; 640]
static mut klab: [u8; 640] = [0 as u8; 640]
static mut nk: u64 = 0

// ROUND NETVIEW, addendum: the pictures, read once at start. Four
// states of 16x16 and three marks of 12x12, in the order the kernel
// (`sys.NS_*`) and `kernel/netview.fi` (`V_*`) count them.
static mut ic_buf: [u8; 4400] = [0 as u8; 4400]
static mut mk_buf: [u8; 1920] = [0 as u8; 1920]
// SECOND ADDENDUM: the sign for "the machine is faking". Its own
// buffer, because it is neither a state icon nor a window mark -- it
// stands NEXT to the state icon and says something about the machine
// that the four states cannot: a machine can be genuinely online AND
// faking a network for every new program at the same time.
static mut sy_buf: [u8; 640] = [0 as u8; 640]
static mut ic_ok: u64 = 0
static mut mk_ok: u64 = 0
static mut sy_ok: u64 = 0
static mut ic_files: u64 = 0
static mut ic_min: u64 = 0
static mut net_state: u64 = 0
// ROUND LOOK: what the battery is doing, as the two numbers the kernel
// gives and nothing worked out here. `bat_have` is `PG_BATPRESENT`,
// `bat_pct` is `PG_BATPERCENT`, `bat_chg` is bit 1 of `PG_BATSTATE`
// (the ACPI _BST charging bit). A machine that cannot answer leaves
// them at 0 and gets the "no battery" symbol -- which is a MEASUREMENT
// and not a guess: `PG_BATPRESENT` returning 0 means the firmware says
// there is none.
static mut bat_have: u64 = 0
static mut bat_pct: u64 = 0
static mut bat_unknown: u64 = 0
static mut kb_unk: [u8; 21] = "tray.battery.unknown\0"
static mut bat_unk_txt: [u8; 2] = "?\0"
static mut bat_chg: u64 = 0
// r782: `PG_AC`, the mains adapter. With bat_have/bat_pct/bat_chg it is the whole input of fui.traypower.
static mut bat_ac: u64 = 0
// r782: tooltip text of the battery item (traypower.tooltip, NUL terminated)
static mut bat_tip: [u8; 96] = [0 as u8; 96]
static mut bat_msg: [u8; 112] = [0 as u8; 112]
static mut kb_none: [u8; 18] = "tray.battery.none\0"
static mut kb_name: [u8; 18] = "tray.battery.name\0"
static mut kb_pct: [u8; 17] = "tray.battery.pct\0"
static mut kb_dis: [u8; 25] = "tray.battery.discharging\0"
static mut kb_chg: [u8; 22] = "tray.battery.charging\0"
static mut kb_plug: [u8; 21] = "tray.battery.plugged\0"
static mut kb_low: [u8; 17] = "tray.battery.low\0"
static mut kb_crit: [u8; 22] = "tray.battery.critical\0"
static mut kb_warn: [u8; 18] = "tray.battery.warn\0"
static mut kb_warn2: [u8; 19] = "tray.battery.crit2\0"
static mut bat_warned: u64 = 0 // 0 = nichts, 1 = Warnung, 2 = ernst
static mut ev_seen: u64 = 0
static mut nv_fall: u64 = 0 // 0 off, 1 when-offline, 2 always
static mut nv_faking: u64 = 0 // is it faking RIGHT NOW
static mut st_said: u64 = 99
static mut fk_said: u64 = 99
const HOVER_MAX: u64 = 223
static mut hover_txt: [u8; 224] = [0 as u8; 224]
static mut hover_on: u64 = 0

static mut rec: [u8; 104] = [0 as u8; 104]
static mut ev: [u8; 16] = [0 as u8; 16]
// r387: 1024 and not 256 -- the file of a Windows 11 bar (16 keys and ten pins) is
// ~400 octets; at 256 the reader lost the pins and the writer ran over the end.
static mut conf: [u8; 1024] = [0 as u8; 1024]
static mut minute_sum: u64 = 0
static mut list_sum: u64 = 0
static mut offset: u64 = 0
static mut clicks: u64 = 0
static mut acts: u64 = 0
static mut paints: u64 = 0
static mut writes: u64 = 0

const QUIET_ROUNDS: u64 = 80
// bit set since the last pulse: 1 repaint, 2 popup step, 4 drag/hide, 8 power event, 16 pointer moved
static mut ub_qwhy: u64 = 0
static mut ub_quiet: u64 = 0

// r1129b: DEEP QUIET. After DEEP_QUIET_ROUNDS rounds (~20 s) with no sign of life, the file pollers of the bar (locale, taskbar.conf)
// run once a second instead of four times a second; any sign of life ends it at once. Each pass is an open + read of several
// files, i.e. disk commands and port I/O in a VM, with nobody there to see the answer.
const DEEP_QUIET_ROUNDS: u64 = 400
static mut sp_at: u64 = 0xFFFFFFFF
fn slow_poll_due() -> bool {
    if ub_quiet <= DEEP_QUIET_ROUNDS {
        return true
    }
    let sec: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_UPTIME, 0, 0) / 1000
    if ulib.bad(sec) || sec != sp_at {
        sp_at = sec
        return true
    }
    return false
}

static mut ub_round: u64 = 0
static mut ub_sb: u64 = 0
static mut ub_sbt: u64 = 0
static mut ub_px: u64 = 0
static mut ub_naechster: u64 = 0
static mut ub_soll: u64 = 0   // Bildpunkte, die hinueber SOLLTEN
static mut ub_null: u64 = 0

static mut pdrag: u64 = 0
static mut pdrag_i: u64 = 0
static mut pdrag_x0: u64 = 0
static mut pdrag_y0: u64 = 0
static mut pdrag_ziel: u64 = 0
const PDRAG_SCHWELLE: u64 = 6

static mut dragging: u64 = 0
static mut drag_edge: u64 = 9
static mut prev_h: [u64; 5] = [0 as u64; 5]
static mut prev_on: u64 = 0
static mut prev_edge: u64 = 9
static mut hide_t0: u64 = 0

static mut s_dbg: u64 = 0

fn dbg_setup(args: u64) {
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_dbg = 1
    }
    var a_dbg: [u8; 6] = "debug\0"
    let argc: u64 = ulib.arg_count(args)
    var ai: u64 = 1
    while ai < argc {
        if ulib.streq(ulib.arg_at(args, ai), (&a_dbg[0 as usize]) as u64) {
            s_dbg = 1
        }
        ai = ai + 1
    }
}

fn say(p: u64) {
    if s_dbg == 0 {
        return
    }
    lineout.add_text(p)
}

fn sayn(v: u64) {
    if s_dbg == 0 {
        return
    }
    lineout.add_num(v)
}

fn nl() {
    if s_dbg == 0 {
        return
    }
    lineout.end_line()
}

fn tlen(p: u64) -> u64 {
    return ulib.length(p)
}

fn ticks() -> u64 {
    return ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
}

fn two(p: u64, at: u64, v: u64) {
    __mmio_write8((p + at) as *mut u8, (48 + (v / 10) % 10) as u8)
    __mmio_write8((p + at + 1) as *mut u8, (48 + v % 10) as u8)
}

fn num_at(p: u64, at: u64, v: u64) -> u64 {
    if v == 0 {
        __mmio_write8((p + at) as *mut u8, 48 as u8)
        __mmio_write8((p + at + 1) as *mut u8, 0 as u8)
        return at + 1
    }
    var digits: u64 = 0
    var t: u64 = v
    while t > 0 {
        digits = digits + 1
        t = t / 10
    }
    var k: u64 = digits
    t = v
    while k > 0 {
        k = k - 1
        __mmio_write8((p + at + k) as *mut u8, (48 + (t % 10)) as u8)
        t = t / 10
    }
    __mmio_write8((p + at + digits) as *mut u8, 0 as u8)
    return at + digits
}

fn text_at_p(p: u64, at: u64, q: u64) -> u64 {
    var k: u64 = 0
    while __mmio_read8((q + k) as *mut u8) != 0 as u8 {
        __mmio_write8((p + at + k) as *mut u8,
            __mmio_read8((q + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((p + at + k) as *mut u8, 0 as u8)
    return at + k
}

fn width_of(p: u64) -> u64 {
    return wlibc.text_w(wlibc.F_UI, wlibc.type_px(wlibc.TY_BODY), p, tlen(p))
}

// ==================================================== the configuration
//
// ONE FILE, TWO WRITERS, ONE READER. `/bin/settings` writes it
// when the user picks an edge in the settings, this bar writes it when
// the user drags itself to an edge, and this bar reads it -- at start
// and every half second afterwards, so that a change made in the
// settings arrives without a restart. There is no second place where
// the edge is remembered; if the file says `left`, the bar is on the
// left, and if the file is not there, the defaults below are.

static mut p_conf: [u8; 19] = "/etc/taskbar.conf\0\0"
static mut k_edge: [u8; 5] = "edge\0"
static mut k_pins: [u8; 5] = "pins\0"

static mut k_height: [u8; 7] = "height\0"
static mut k_width: [u8; 6] = "width\0"
static mut k_autohide: [u8; 9] = "autohide\0"
static mut k_ontop: [u8; 6] = "ontop\0"
static mut k_align: [u8; 6] = "align\0"
static mut k_seconds: [u8; 15] = "clock_seconds\0\0"
static mut k_cdate: [u8; 12] = "clock_date\0\0"
static mut k_cwday: [u8; 15] = "clock_weekday\0\0"
static mut k_clines: [u8; 13] = "clock_lines\0\0"
static mut k_labels: [u8; 8] = "labels\0\0"
static mut k_nohw: [u8; 15] = "hide_missing\0\0\0"
static mut k_lang: [u8; 14] = "tray_language\0"
static mut k_year4: [u8; 12] = "clock_year4\0"
static mut k_12h: [u8; 11] = "clock_12h\0\0"
static mut k_tv: [u8; 9] = "taskview\0"
static mut k_chev: [u8; 13] = "tray_chevron\0"
static mut k_group: [u8; 11] = "tray_group\0"
static mut k_demo: [u8; 11] = "tray_demo\0\0"
static mut k_demochg: [u8; 14] = "tray_demochg\0\0"
static mut k_badge: [u8; 7] = "badges\0"
static mut v_left: [u8; 5] = "left\0"
static mut v_center: [u8; 7] = "center\0"

fn key_is(p: u64, n: u64, k: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if __mmio_read8((k + i) as *mut u8) == 0 as u8 {
            return false
        }
        if __mmio_read8((p + i) as *mut u8)
            != __mmio_read8((k + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return __mmio_read8((k + n) as *mut u8) == 0 as u8
}

fn labels_by_name(p: u64) -> u64 {
    var w_nev: [u8; 6] = "never\0"
    var w_alw: [u8; 7] = "always\0"
    var w_room: [u8; 5] = "room\0"
    var w_full: [u8; 10] = "when_full\0"
    if ulib.streq(p, (&w_nev[0 as usize]) as u64) {
        return LB_NEVER
    }
    if ulib.streq(p, (&w_alw[0 as usize]) as u64) {
        return LB_ALWAYS
    }
    if ulib.streq(p, (&w_room[0 as usize]) as u64) {
        return LB_ROOM
    }
    if ulib.streq(p, (&w_full[0 as usize]) as u64) {
        return LB_ROOM
    }
    return cf_labels
}

fn align_by_name(p: u64) -> u64 {
    if __mmio_read8((p) as *mut u8) == 99 as u8 {
        return AL_CENTER
    }
    return AL_LEFT
}

static mut v_never: [u8; 6] = "never\0"
static mut v_always: [u8; 7] = "always\0"
static mut v_room: [u8; 5] = "room\0"

fn labels_name(v: u64) -> u64 {
    if v == LB_NEVER {
        return (&v_never[0 as usize]) as u64
    }
    if v == LB_ALWAYS {
        return (&v_always[0 as usize]) as u64
    }
    return (&v_room[0 as usize]) as u64
}

fn align_name(a: u64) -> u64 {
    if a == AL_CENTER {
        return (&v_center[0 as usize]) as u64
    }
    return (&v_left[0 as usize]) as u64
}

fn clamp(v: u64, lo: u64, hi: u64) -> u64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

// Read the file. Unknown keys are ignored, missing keys keep their
// value -- the same rule as `/etc/theme` (wlibc.theme_load). Returns
// true if the file was there at all.
fn conf_read() -> bool {
    var word: [u8; 24] = [0 as u8; 24]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_conf[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return false
    }
    let b: u64 = (&conf[0 as usize]) as u64
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, b, 1023)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return false
    }
    var i: u64 = 0
    while i < n {
        // one line
        let ks: u64 = i
        var ke: u64 = i
        while ke < n && __mmio_read8((b + ke) as *mut u8) != 61 as u8
            && __mmio_read8((b + ke) as *mut u8) != 10 as u8 {
            ke = ke + 1
        }
        if ke < n && __mmio_read8((b + ke) as *mut u8) == 61 as u8 {
            let vs: u64 = ke + 1
            var ve: u64 = vs
            while ve < n && __mmio_read8((b + ve) as *mut u8) != 10 as u8
                && __mmio_read8((b + ve) as *mut u8) != 13 as u8 {
                ve = ve + 1
            }
            // the value as a word and as a number
            let wp: u64 = (&word[0 as usize]) as u64
            var k: u64 = 0
            var v: u64 = 0
            var digits: u64 = 0
            while vs + k < ve && k < 23 {
                let c: u64 = __mmio_read8((b + vs + k) as *mut u8) as u64
                __mmio_write8((wp + k) as *mut u8, c as u8)
                if c >= 48 && c <= 57 {
                    v = v * 10 + (c - 48)
                    digits = digits + 1
                }
                k = k + 1
            }
            __mmio_write8((wp + k) as *mut u8, 0 as u8)
            let kl: u64 = ke - ks
            if key_is(b + ks, kl, (&k_pins[0 as usize]) as u64) && pdrag == 0 {
                npin = 0
                var q: u64 = vs
                while q < ve && npin < MAXPIN {
                    var l: u64 = 0
                    let zp: u64 = (&pinname[0 as usize]) as u64 + npin * 24
                    while q < ve && l < 23 {
                        let ch: u64 = __mmio_read8((b + q) as *mut u8) as u64
                        if ch == 44 {
                            break
                        }
                        if ch != 32 && ch != 9 {
                            __mmio_write8((zp + l) as *mut u8, ch as u8)
                            l = l + 1
                        }
                        q = q + 1
                    }
                    __mmio_write8((zp + l) as *mut u8, 0 as u8)
                    if l > 0 {
                        npin = npin + 1
                    }
                    while q < ve
                        && __mmio_read8((b + q) as *mut u8) != 44 as u8 {
                        q = q + 1
                    }
                    if q < ve {
                        q = q + 1
                    }
                }
            } else if key_is(b + ks, kl, (&k_edge[0 as usize]) as u64) {
                let e: u64 = wlibc.edge_by_name(wp)
                if e < 4 {
                    cf_edge = e
                }
            } else if key_is(b + ks, kl, (&k_height[0 as usize]) as u64) {
                if digits > 0 {
                    cf_height = clamp(v * wlibc.ui_scale(),
                        h_min(), h_max())
                }
            } else if key_is(b + ks, kl, (&k_width[0 as usize]) as u64) {
                if digits > 0 {
                    cf_width = clamp(v, V_MIN, V_MAX)
                }
            } else if key_is(b + ks, kl, (&k_autohide[0 as usize]) as u64) {
                if digits > 0 {
                    cf_autohide = v & 1
                }
            } else if key_is(b + ks, kl, (&k_ontop[0 as usize]) as u64) {
                if digits > 0 {
                    cf_ontop = v & 1
                }
            } else if key_is(b + ks, kl, (&k_seconds[0 as usize]) as u64) {
                if digits > 0 {
                    cf_sec = v & 1
                }
            } else if key_is(b + ks, kl, (&k_cdate[0 as usize]) as u64) {
                if digits > 0 {
                    cf_date = v & 1
                }
            } else if key_is(b + ks, kl, (&k_cwday[0 as usize]) as u64) {
                if digits > 0 {
                    cf_wday = v & 1
                }
            } else if key_is(b + ks, kl, (&k_clines[0 as usize]) as u64) {
                if v == 2 {
                    cf_clines = 2
                } else if digits > 0 {
                    cf_clines = 1
                }
            } else if key_is(b + ks, kl, (&k_nohw[0 as usize]) as u64) {
                if digits > 0 {
                    cf_hidemissing = v & 1
                }
            } else if key_is(b + ks, kl, (&k_lang[0 as usize]) as u64) {
                if digits > 0 {
                    cf_lang = v & 1
                }
            } else if key_is(b + ks, kl, (&k_year4[0 as usize]) as u64) {
                if digits > 0 {
                    cf_year4 = v & 1
                }
            } else if key_is(b + ks, kl, (&k_12h[0 as usize]) as u64) {
                if digits > 0 {
                    cf_12h = v & 1
                }
            } else if key_is(b + ks, kl, (&k_tv[0 as usize]) as u64) {
                if digits > 0 {
                    cf_tv = v & 1
                }
            } else if key_is(b + ks, kl, (&k_chev[0 as usize]) as u64) {
                if digits > 0 {
                    cf_chev = v & 1
                }
            } else if key_is(b + ks, kl, (&k_group[0 as usize]) as u64) {
                if digits > 0 {
                    cf_group = v & 1
                }
            } else if key_is(b + ks, kl, (&k_demo[0 as usize]) as u64) {
                if digits > 0 {
                    cf_demo = clamp(v, 0, 101)
                }
            } else if key_is(b + ks, kl, (&k_demochg[0 as usize]) as u64) {
                if digits > 0 {
                    cf_demochg = v & 1
                }
            } else if key_is(b + ks, kl, (&k_badge[0 as usize]) as u64) {
                if digits > 0 {
                    cf_badge = clamp(v, 0, 9)
                }
            } else if key_is(b + ks, kl, (&k_labels[0 as usize]) as u64) {
                cf_labels = labels_by_name(wp)
            } else if key_is(b + ks, kl, (&k_align[0 as usize]) as u64) {
                // ROUND LOOK. A WORD AND NOT A NUMBER, like `edge=`
                // above and unlike `ontop=`: `align=center` says what
                // it does and `align=1` does not. An unknown word
                // leaves the value alone -- the same rule the whole
                // file follows.
                cf_align = align_by_name(wp)
            }
            i = ve + 1
        } else {
            i = ke + 1
        }
    }
    return true
}

static mut c_head: [u8; 60] =
    "# taskbar.conf -- written by /bin/taskbar and /bin/settings\0"

// r387: one key line of the file: `key=value\n`; `at` is the place of the newline
// before it (the file's first line is written by the caller), the result the place of
// the newline after it. These two replace twenty copies of the same four statements.
fn wk_num(b: u64, at: u64, key: u64, v: u64) -> u64 {
    var a: u64 = text_at_p(b, at + 1, key)
    __mmio_write8((b + a) as *mut u8, 61 as u8)
    a = num_at(b, a + 1, v)
    __mmio_write8((b + a) as *mut u8, 10 as u8)
    return a
}

fn wk_txt(b: u64, at: u64, key: u64, val: u64) -> u64 {
    var a: u64 = text_at_p(b, at + 1, key)
    __mmio_write8((b + a) as *mut u8, 61 as u8)
    a = text_at_p(b, a + 1, val)
    __mmio_write8((b + a) as *mut u8, 10 as u8)
    return a
}

fn conf_write() -> bool {
    let b: u64 = (&conf[0 as usize]) as u64
    var at: u64 = text_at_p(b, 0, (&c_head[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    at = text_at_p(b, at, (&k_edge[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    at = text_at_p(b, at + 1, wlibc.edge_name(cf_edge))
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = wk_num(b, at, (&k_height[0 as usize]) as u64, cf_height)
    at = wk_num(b, at, (&k_width[0 as usize]) as u64, cf_width)
    at = wk_num(b, at, (&k_autohide[0 as usize]) as u64, cf_autohide)
    at = wk_num(b, at, (&k_ontop[0 as usize]) as u64, cf_ontop)
    at = wk_txt(b, at, (&k_align[0 as usize]) as u64, align_name(cf_align))
    // r384: THE KEYS THAT ARE NOT ABOUT THE EDGE go out too -- the clock,
    // the labels, the corner. Before, a change of the edge in Settings
    // dropped them from the file (and a bar the person had set up to look like
    // Windows 11 went back to the defaults).
    at = wk_txt(b, at, (&k_labels[0 as usize]) as u64, labels_name(cf_labels))
    at = wk_num(b, at, (&k_cdate[0 as usize]) as u64, cf_date)
    at = wk_num(b, at, (&k_cwday[0 as usize]) as u64, cf_wday)
    at = wk_num(b, at, (&k_clines[0 as usize]) as u64, cf_clines)
    at = wk_num(b, at, (&k_seconds[0 as usize]) as u64, cf_sec)
    at = wk_num(b, at, (&k_lang[0 as usize]) as u64, cf_lang)
    at = wk_num(b, at, (&k_year4[0 as usize]) as u64, cf_year4)
    at = wk_num(b, at, (&k_12h[0 as usize]) as u64, cf_12h)
    at = wk_num(b, at, (&k_nohw[0 as usize]) as u64, cf_hidemissing)
    at = wk_num(b, at, (&k_tv[0 as usize]) as u64, cf_tv)
    at = wk_num(b, at, (&k_chev[0 as usize]) as u64, cf_chev)
    at = wk_num(b, at, (&k_group[0 as usize]) as u64, cf_group)
    at = wk_num(b, at, (&k_badge[0 as usize]) as u64, cf_badge)
    if npin > 0 {
        at = text_at_p(b, at + 1, (&k_pins[0 as usize]) as u64)
        __mmio_write8((b + at) as *mut u8, 61 as u8)
        at = at + 1
        var pw3: u64 = 0
        while pw3 < npin {
            if pw3 > 0 {
                __mmio_write8((b + at) as *mut u8, 44 as u8)
                at = at + 1
            }
            at = text_at_p(b, at,
                (&pinname[0 as usize]) as u64 + pw3 * 24)
            pw3 = pw3 + 1
        }
        __mmio_write8((b + at) as *mut u8, 10 as u8)
    }
    at = at + 1
    let fd: u64 = io.create((&p_conf[0 as usize]) as u64)
    if ulib.bad(fd) {
        return false
    }
    let g: u64 = io.write_all(fd, b, at)
    io.close(fd)
    if ulib.bad(g) || g < at {
        return false
    }
    writes = writes + 1
    return true
}

