// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/h264tab.fi -- DIE ZAHLENTAFELN DES H.264-DEKODIERERS.
//
// ERZEUGT von tools/codec/mktab.py. NICHT VON HAND AENDERN --
// jede Aenderung hier geht beim naechsten Lauf verloren, und die
// Zahlen stammen ohnehin nicht von hier:
//
//   die CAVLC-Tafeln aus FFmpegs libavcodec/h264_cavlc.c,
//   die Entblockungstafeln aus libavcodec/h264_loopfilter.c,
//   die Gewichte der Intra-4x4-Modi aus den Formeln 8.3.1.2.1-9
//   der Norm ITU-T H.264 (ueber tools/codec/pred_gen.py).
//
// Eine abgetippte Huffman-Tafel hat einen Fehler, den niemand
// SIEHT: er faellt drei Koeffizienten spaeter als "Code nicht in
// der Tafel" auf, und dort sucht man ihn dann. Erzeugte Tafeln
// koennen ihn nicht haben. tools/codec/run.sh rechnet zusaetzlich
// nach, dass jede Tafel praefixfrei ist.

profile kernel

export {
    CT_LEN, CT_BITS, CDC_LEN, CDC_BITS,
    TZ_LEN, TZ_BITS, TZC_LEN, TZC_BITS, RUN_LEN, RUN_BITS,
    ALPHA, BETA, TC0, PRED4W, PRED4G, PRED4I, ZIGZAG,
    VMAT, QPC, LEVTAB_V, LEVTAB_N
}

