profile kernel

import ulib
import xfxio

export { find_slot, proc_ok, proc_uid, kill_pid }

fn find_slot(pid: u64) -> u64 {
    if pid == 0 {
        return ulib.EOF
    }
    var i: u64 = 0
    while i < 128 {
        let st: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_STATE, 0)
        if !ulib.bad(st) && st != 0 && st != 5 && st != 9 {
            if ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PID, 0) == pid {
                return i
            }
        }
        i = i + 1
    }
    return ulib.EOF
}

fn proc_ok(pid: u64, want: u64) -> bool {
    let slot: u64 = find_slot(pid)
    if slot == ulib.EOF {
        return false
    }
    let n0: u64 = ulib.sys(ulib.SYS_PSTAT, slot, ulib.P_NAME0, 0)
    var k: u64 = 0
    while *((want + k) as *mut u8) != 0 as u8 {
        if k >= 8 || ((n0 >> (k * 8)) & 255) != (*((want + k) as *mut u8)) as u64 {
            return false
        }
        k = k + 1
    }
    return k >= 8 || ((n0 >> (k * 8)) & 255) == 0
}

fn proc_uid(pid: u64) -> u64 {
    let slot: u64 = find_slot(pid)
    if slot == ulib.EOF {
        return ulib.EOF
    }
    return ulib.sys(ulib.SYS_PSTAT, slot, ulib.P_UID, 0)
}

fn kill_pid(path: u64, want: u64) {
    let pid: u64 = xfxio.pid_field(path, 0)
    if proc_ok(pid, want) {
        ulib.sys(ulib.SYS_KILL, pid, 143, 0)
        var i: u64 = 0
        while i < 30 && find_slot(pid) != ulib.EOF {
            ulib.sleep_ms(100)
            i = i + 1
        }
    }
    ulib.sys(ulib.SYS_UNLINK, path, 0, 0)
}
