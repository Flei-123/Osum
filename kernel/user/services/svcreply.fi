profile app

import libc.octets
import services.svcosum
import services.svcqueue

export { next, op, status, reply_name_ptr, data_ptr, data_len, NAME_MAX, DATA_MAX }

const NAME_MAX: u64 = 128
const DATA_MAX: u64 = 65600
const OP_AT: u64 = 8
const STATUS_AT: u64 = 12
const DATA_LEN_AT: u64 = 24

static mut head_buf: [u8; 28] = [0 as u8; 28]
static mut name_buf: [u8; 128] = [0 as u8; 128]
static mut data_buf: [u8; 65600] = [0 as u8; 65600]

fn reply_head_ptr() -> u64 {
    return (&head_buf[0 as usize]) as u64
}

fn reply_name_ptr() -> u64 {
    return (&name_buf[0 as usize]) as u64
}

fn data_ptr() -> u64 {
    return (&data_buf[0 as usize]) as u64
}

fn next() -> bool {
    if !svcosum.poll(reply_head_ptr(), reply_name_ptr(), NAME_MAX - 1, data_ptr(), DATA_MAX - 1) {
        return false
    }
    octets.st8(reply_name_ptr(), octets.le32(reply_head_ptr() + svcqueue.H_NAME_LEN), 0)
    return true
}

fn op() -> u64 {
    return octets.le32(reply_head_ptr() + OP_AT)
}

fn status() -> u64 {
    return octets.le32(reply_head_ptr() + STATUS_AT)
}

fn data_len() -> u64 {
    return octets.le32(reply_head_ptr() + DATA_LEN_AT)
}
