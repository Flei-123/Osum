profile app

import ulib
import msg
import libc.octets
import tmfmt
import deeplink
import autostartsrc
import autostart.model

export { load, total_rows, append_rows, entry_of_row, toggle_row, open_settings, NO_ENTRY }

const NO_ENTRY: u64 = 4294967295
const MAX_ROWS: u64 = 64
const BLOB_LIMIT: u64 = 2900
const TAB: u64 = 9
const NEWLINE: u64 = 10

static mut row_entry: [u64; 64] = [0 as u64; 64]
static mut row_total: u64 = 0
static mut k_on: [u8; 14] = "taskmgr.as.on\0"
static mut k_off: [u8; 15] = "taskmgr.as.off\0"
static mut k_kind: [u8; 16] = "taskmgr.as.kind\0"
static mut tab_text: [u8; 2] = "\t\0"
static mut nl_text: [u8; 2] = "\n\0"
static mut settings_exec: [u8; 25] = "/apps/settings.osp/start\0"
static mut settings_uri: [u8; 26] = "settings://apps/autostart\0"
static mut arg: [u8; 112] = [0 as u8; 112]
static mut argv: [u64; 2] = [0 as u64; 2]
static mut trace_toggle: [u8; 21] = "taskmgr: autostart \0\0"
static mut trace_on: [u8; 4] = "=on\0"
static mut trace_off: [u8; 5] = "=off\0"

fn load() {
    let _n: u64 = autostartsrc.load()
    row_total = 0
}

fn total_rows() -> u64 {
    return row_total
}

fn entry_of_row(row: u64) -> u64 {
    if row >= row_total || row >= MAX_ROWS {
        return NO_ENTRY
    }
    return row_entry[row as usize]
}

fn status_key(i: u64) -> u64 {
    if model.enabled(i) {
        return (&k_on[0 as usize]) as u64
    }
    return (&k_off[0 as usize]) as u64
}

fn append_rows(d: u64, at: u64, first_row: u64) -> u64 {
    var a: u64 = at
    var r: u64 = 0
    while r < first_row && r < MAX_ROWS {
        row_entry[r as usize] = NO_ENTRY
        r = r + 1
    }
    var i: u64 = 0
    while i < model.count() && a < BLOB_LIMIT && r < MAX_ROWS {
        if model.visible(i) && !model.locked(i) {
            a = tmfmt.put_str(d, a, model.name(i))
            a = tmfmt.put_str(d, a, (&tab_text[0 as usize]) as u64)
            a = tmfmt.put_str(d, a, model.args(i))
            a = tmfmt.put_str(d, a, (&tab_text[0 as usize]) as u64)
            a = tmfmt.put_str(d, a, msg.get((&k_kind[0 as usize]) as u64))
            a = tmfmt.put_str(d, a, (&tab_text[0 as usize]) as u64)
            a = tmfmt.put_str(d, a, msg.get(status_key(i)))
            a = tmfmt.put_str(d, a, (&nl_text[0 as usize]) as u64)
            row_entry[r as usize] = i
            r = r + 1
        }
        i = i + 1
    }
    row_total = r
    return a
}

fn toggle_row(row: u64, trace: bool) -> bool {
    let i: u64 = entry_of_row(row)
    if i == NO_ENTRY || !model.set_enabled(i, !model.enabled(i)) {
        return false
    }
    let saved: bool = autostartsrc.save(i)
    if trace {
        ulib.say((&trace_toggle[0 as usize]) as u64)
        ulib.say(model.name(i))
        if model.enabled(i) {
            ulib.say((&trace_on[0 as usize]) as u64)
        } else {
            ulib.say((&trace_off[0 as usize]) as u64)
        }
        ulib.say((&nl_text[0 as usize]) as u64)
    }
    return saved
}

fn open_settings() -> u64 {
    let _n: u64 = deeplink.build_arg((&settings_uri[0 as usize]) as u64, (&arg[0 as usize]) as u64, 112)
    argv[0 as usize] = (&settings_exec[0 as usize]) as u64
    argv[1 as usize] = (&arg[0 as usize]) as u64
    return ulib.spawn_app((&settings_exec[0 as usize]) as u64, (&argv[0 as usize]) as u64, 2)
}
