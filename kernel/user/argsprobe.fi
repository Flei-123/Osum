profile app

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var label: [u8; 16] = "argsprobe argc=\0"
    ulib.say_line((&label[0]) as u64, ulib.arg_count(args))
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
