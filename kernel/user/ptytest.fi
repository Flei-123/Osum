// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/ptytest.fi -- openpty/close in a loop (r528 test aid, tools/term/multi.sh).
//
// Opens a pty pair 40 times, closing both descriptors each time. Before r528 a pair was never given back, so the loop
// failed after three or four rounds (the tty table has to hold the console, the log tty and the terminal windows too).
// Prints `ptytest: ok=<n> fail=<n>`.

profile kernel

import ulib

export { u_start }

const SYS_OPENPTY: u64 = 1100

fn u_start(args: u64) -> u64 {
    var s_res: [u8; 16] = "ptytest: ok=\0\0\0\0"
    var s_fail: [u8; 8] = " fail=\0\0"
    // the kernel writes two 32-bit descriptors (master, slave) into the 8 octets at `out`
    var fds: [u64; 1] = [0; 1]
    var ok: u64 = 0
    var fail: u64 = 0
    var i: u64 = 0
    while i < 40 {
        let r: u64 = ulib.sys(SYS_OPENPTY, (&fds[0]) as u64, 0, 0)
        if ulib.bad(r) {
            fail = fail + 1
        } else {
            ok = ok + 1
            ulib.sys(ulib.SYS_CLOSE, fds[0] & 0xFFFFFFFF, 0, 0)
            ulib.sys(ulib.SYS_CLOSE, fds[0] >> 32, 0, 0)
        }
        i = i + 1
    }
    ulib.say((&s_res[0]) as u64)
    ulib.sayn(ok)
    ulib.say((&s_fail[0]) as u64)
    ulib.sayn(fail)
    ulib.nl()
    return 0
}
