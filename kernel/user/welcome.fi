// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/welcome.fi -- E3 (Mint round): THE WELCOME WINDOW (/bin/welcome).
//
//   welcome            the window (fUi): three hints, a check box "show at start",
//                      buttons "Open settings" and "Close"
//   welcome -a         autostart mode: exit at once (no window) unless
//                      /etc/welcome.conf says show=ja
//   welcome status     print "welcome: show=ja|nein" (what the file says)
//   welcome show on|off  write the switch (same as the check box)
//
// THE SWITCH lives in /etc/welcome.conf as one line `show=ja` or `show=nein`.
// A MISSING FILE MEANS NO: only the installer (kernel/user/instaccount.fi) writes
// `show=ja`, so a new installed system greets its owner once and every test image
// and live stick starts without an extra window in the way of the clicks. The
// desktop starts `/bin/welcome -a` after the autostart list (kernel/user/desktop.fi).
//
// NOTHING IS SENT ANYWHERE and the text says so (see /bin/privacy).

profile app

import ulib
import fuiscene
import msg

export { u_start }

const K_SHOW: u64 = 1
const K_SET: u64 = 2
const K_CLOSE: u64 = 3

static mut P_CONF: [u8; 18] = "/etc/welcome.conf\0"
static mut P_SET: [u8; 14] = "/bin/settings\0"
static mut A_SET: [u8; 9] = "settings\0"

static mut k_title: [u8; 14] = "welcome.title\0"
static mut k_head: [u8; 13] = "welcome.head\0"
static mut k_t1: [u8; 11] = "welcome.t1\0"
static mut k_t2: [u8; 11] = "welcome.t2\0"
static mut k_t3: [u8; 11] = "welcome.t3\0"
static mut k_show: [u8; 13] = "welcome.show\0"
static mut k_set: [u8; 13] = "welcome.sett\0"
static mut k_close: [u8; 14] = "welcome.close\0"

static mut show_now: bool = false

fn say(p: u64) {
    ulib.say(p)
}

// does the file say show=ja?
fn conf_on() -> bool {
    var buf: [u8; 128] = [0 as u8; 128]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&P_CONF[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return false
    }
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&buf[0 as usize]) as u64, 127)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n < 7 {
        return false
    }
    // "show=ja" at the start of a line
    var i: u64 = 0
    while i + 7 <= n {
        let at_line: bool = i == 0 || buf[(i - 1) as usize] == 10 as u8
        if at_line && buf[(i) as usize] == 115 as u8 && buf[(i + 1) as usize] == 104 as u8
            && buf[(i + 2) as usize] == 111 as u8 && buf[(i + 3) as usize] == 119 as u8
            && buf[(i + 4) as usize] == 61 as u8 && buf[(i + 5) as usize] == 106 as u8
            && buf[(i + 6) as usize] == 97 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

// A number after `key` (e.g. "w=") at the start of a line of /etc/welcome.conf; 0 when absent.
// Test hook for the gate: it opens the window at a small size (the owner gets the default).
fn conf_num(key0: u8, key1: u8) -> u64 {
    var buf: [u8; 128] = [0 as u8; 128]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&P_CONF[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&buf[0 as usize]) as u64, 127)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    var i: u64 = 0
    while i + 3 <= n {
        let at_line: bool = i == 0 || buf[(i - 1) as usize] == 10 as u8
        if at_line && buf[(i) as usize] == key0 && buf[(i + 1) as usize] == key1 {
            var v: u64 = 0
            var j: u64 = i + 2
            while j < n && buf[(j) as usize] >= 48 as u8 && buf[(j) as usize] <= 57 as u8 {
                v = v * 10 + (buf[(j) as usize] as u64 - 48)
                j = j + 1
            }
            return v
        }
        i = i + 1
    }
    return 0
}

fn conf_write(on: bool) -> bool {
    var yes: [u8; 9] = "show=ja\n\0"
    var no: [u8; 11] = "show=nein\n\0"
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&P_CONF[0 as usize]) as u64, ulib.O_MAKE, 420)
    if ulib.bad(fd) {
        return false
    }
    var w: u64 = 0
    if on {
        w = ulib.sys(ulib.SYS_WRITE, fd, (&yes[0 as usize]) as u64, 8)
    } else {
        w = ulib.sys(ulib.SYS_WRITE, fd, (&no[0 as usize]) as u64, 10)
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return !ulib.bad(w)
}

// Paragraphs dropped from the end (0 = all three shown). A small window shows fewer hints instead of squeezing
// the lines of the paragraphs into each other; a bigger window brings them back (`resized`).
static mut tier: u64 = 0
static mut nd_head: usize = 0
static mut nd_bar: usize = 0

// The boxes of the root column in order (the overlap check of `say_layout` walks them).
static mut col_nodes: [usize; 8] = [0 as usize; 8]
static mut col_n: u64 = 0

// Counter-proof switch of the gate (`l=1` in /etc/welcome.conf): the old layout (fixed one-line paragraph heights, squeezing).
static mut legacy: bool = false

fn keep(i: usize) -> usize {
    if !legacy {
        fuiscene.set_noshrink(i)
    }
    if col_n < 8 {
        col_nodes[(col_n) as usize] = i
        col_n = col_n + 1
    }
    return i
}

// A paragraph: label_wrap gives it a fixed height of ONE line (24); two or more lines then ran into the next
// box. Height 0 = the height of its lines (it follows the width the column gives it).
fn para(col: usize, key: u64) -> usize {
    if legacy {
        return keep(fuiscene.label_wrap(col, msg.get(key), 3))
    }
    let i: usize = fuiscene.label_wrap(col, msg.get(key), 12)
    fuiscene.set_size(i, 0, 0)
    return keep(i)
}

fn build() {
    let col: usize = fuiscene.root()
    col_n = 0
    nd_head = keep(fuiscene.label(col, msg.get((&k_head[0 as usize]) as u64)))
    if tier < 3 {
        let _a: usize = para(col, (&k_t1[0 as usize]) as u64)
    }
    if tier < 2 {
        let _b: usize = para(col, (&k_t2[0 as usize]) as u64)
    }
    if tier < 1 {
        let _c: usize = para(col, (&k_t3[0 as usize]) as u64)
    }
    let _ck: usize = keep(fuiscene.check(col, msg.get((&k_show[0 as usize]) as u64), K_SHOW, show_now))
    // narrow window: the two buttons stand on top of each other instead of running out of the window
    var bar: usize = 0
    if fuiscene.width() < 360 {
        bar = fuiscene.column(col)
    } else {
        bar = fuiscene.row(col)
    }
    nd_bar = keep(bar)
    fuiscene.set_gap(bar, 8)
    let b1: usize = fuiscene.button_main(bar, msg.get((&k_set[0 as usize]) as u64), K_SET)
    fuiscene.set_noshrink(b1)
    fuiscene.set_size(b1, 180, 36)
    let b2: usize = fuiscene.button(bar, msg.get((&k_close[0 as usize]) as u64), K_CLOSE)
    fuiscene.set_noshrink(b2)
    fuiscene.set_size(b2, 120, 36)
}

// The line `welcome: layout ...` (gate): window height, bottom of the button bar, hidden paragraphs, overlaps of
// neighbouring boxes of the column (0 = none).
fn say_layout() {
    var s_l: [u8; 22] = "welcome: layout win=\0\0"
    var s_b: [u8; 9] = " bottom=\0"
    var s_t: [u8; 7] = " tier=\0"
    var s_o: [u8; 10] = " overlap=\0"
    var ov: u64 = 0
    var k: u64 = 1
    while k < col_n {
        let p: usize = col_nodes[(k - 1) as usize]
        let q: usize = col_nodes[(k) as usize]
        if fuiscene.node_y(p) + fuiscene.node_h(p) > fuiscene.node_y(q) {
            ov = ov + 1
        }
        k = k + 1
    }
    // a paragraph whose box is lower than its lines (16 px each at least): the text is painted over the next box
    k = 0
    while k < col_n {
        let p2: usize = col_nodes[(k) as usize]
        if fuiscene.node_lines(p2) * 16 > fuiscene.node_h(p2) {
            ov = ov + 1
        }
        k = k + 1
    }
    say((&s_l[0 as usize]) as u64)
    ulib.sayu(fuiscene.height())
    say((&s_b[0 as usize]) as u64)
    ulib.sayu(fuiscene.node_y(nd_bar) + fuiscene.node_h(nd_bar))
    say((&s_t[0 as usize]) as u64)
    ulib.sayu(tier)
    say((&s_o[0 as usize]) as u64)
    ulib.sayu(ov)
    ulib.nl()
}

fn u_gui() -> u64 {
    var s_bad: [u8; 23] = "welcome: no surface\0\0\0\0"
    var s_go: [u8; 15] = "welcome: ready\0"
    var s_set: [u8; 16] = "welcome: show=\0\0"
    var s_ja: [u8; 3] = "ja\0"
    var s_nein: [u8; 5] = "nein\0"
    var s_nm: [u8; 8] = "welcome\0"
    let _mi: u64 = msg.init()
    show_now = conf_on()
    legacy = conf_num(108 as u8, 61 as u8) == 1
    var ww: u64 = conf_num(119 as u8, 61 as u8)
    var wh: u64 = conf_num(104 as u8, 61 as u8)
    if ww < 120 {
        ww = 520
    }
    if wh < 80 {
        wh = 330
    }
    if !fuiscene.open(160, 120, ww, wh, msg.get((&k_title[0 as usize]) as u64), build) {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    // The window tells the taskbar which bundle it belongs to (WM_APP); without it the button has no icon.
    var win_app_name: [u8; 8] = "welcome\0"
    fuiscene.set_app((&win_app_name[0 as usize]) as u64)
    var first: bool = true
    var seen_rs: u64 = fuiscene.resized()
    var seen_tier: u64 = 99
    var settle: u64 = 0
    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        // the window got another size: try all the paragraphs again, drop from the end while the bar does not fit
        if fuiscene.resized() != seen_rs {
            seen_rs = fuiscene.resized()
            tier = 0
            settle = 0
            fuiscene.refresh()
        } else if !first && !legacy && fuiscene.node_y(nd_bar) + fuiscene.node_h(nd_bar) + 8 > fuiscene.height() && tier < 3 {
            tier = tier + 1
            fuiscene.refresh()
        } else if !first && (tier != seen_tier) {
            seen_tier = tier
            say_layout()
        }
        if first {
            first = false
            fuiscene.say_rects((&s_nm[0 as usize]) as u64)
            say((&s_go[0 as usize]) as u64)
            ulib.nl()
        }
        if key == K_SHOW {
            let on: bool = fuiscene.value_of(K_SHOW) != 0
            let _w: bool = conf_write(on)
            show_now = on
            say((&s_set[0 as usize]) as u64)
            if on {
                say((&s_ja[0 as usize]) as u64)
            } else {
                say((&s_nein[0 as usize]) as u64)
            }
            ulib.nl()
        } else if key == K_SET {
            var argv: [u64; 1] = [0 as u64; 1]
            argv[(0) as usize] = (&A_SET[0 as usize]) as u64
            let _p: u64 = ulib.sys(ulib.SYS_EXEC, (&P_SET[0 as usize]) as u64, (&argv[0 as usize]) as u64, 1)
            fuiscene.quit()
        } else if key == K_CLOSE {
            fuiscene.quit()
        }
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var a_auto: [u8; 3] = "-a\0"
    var a_stat: [u8; 7] = "status\0"
    var a_show: [u8; 5] = "show\0"
    var a_on: [u8; 3] = "on\0"
    var a_off: [u8; 4] = "off\0"
    var s_st: [u8; 15] = "welcome: show=\0"
    var s_ja: [u8; 3] = "ja\0"
    var s_nein: [u8; 5] = "nein\0"
    var s_use: [u8; 44] = "usage: welcome [-a | status | show on|off]\0\0"
    var s_fail: [u8; 28] = "welcome: cannot write conf\0\0"
    let argc: u64 = ulib.arg_count(args)
    if argc >= 2 {
        let c: u64 = ulib.arg_at(args, 1)
        if ulib.streq(c, (&a_auto[0 as usize]) as u64) {
            if !conf_on() {
                return 0
            }
            return u_gui()
        }
        if ulib.streq(c, (&a_stat[0 as usize]) as u64) {
            say((&s_st[0 as usize]) as u64)
            if conf_on() {
                say((&s_ja[0 as usize]) as u64)
            } else {
                say((&s_nein[0 as usize]) as u64)
            }
            ulib.nl()
            return 0
        }
        if ulib.streq(c, (&a_show[0 as usize]) as u64) && argc >= 3 {
            let v: u64 = ulib.arg_at(args, 2)
            if ulib.streq(v, (&a_on[0 as usize]) as u64) || ulib.streq(v, (&a_off[0 as usize]) as u64) {
                if !conf_write(ulib.streq(v, (&a_on[0 as usize]) as u64)) {
                    say((&s_fail[0 as usize]) as u64)
                    ulib.nl()
                    return 1
                }
                return 0
            }
        }
        say((&s_use[0 as usize]) as u64)
        ulib.nl()
        return 2
    }
    return u_gui()
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
