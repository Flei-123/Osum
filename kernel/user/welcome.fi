profile app

import ulib
import fuiscene
import msg
import welcome_conf
import welcome_pages

export { u_start }

const WIN_X: u64 = 160
const WIN_Y: u64 = 120
const WIN_W: u64 = 520
const WIN_H: u64 = 420
const MIN_W: u64 = 280
const MIN_H: u64 = 240
const POLL_TICKS: u64 = 300

static mut k_title: [u8; 14] = "welcome.title\0"

fn say(p: u64) {
    ulib.say(p)
}

fn say_show(on: bool) {
    var s_set: [u8; 16] = "welcome: show=\0\0"
    var s_ja: [u8; 3] = "ja\0"
    var s_nein: [u8; 5] = "nein\0"
    say((&s_set[0 as usize]) as u64)
    if on {
        say((&s_ja[0 as usize]) as u64)
    } else {
        say((&s_nein[0 as usize]) as u64)
    }
    ulib.nl()
}

fn say_geom(w: u64, h: u64) {
    var s_geo: [u8; 23] = "welcome: geom x=160 y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_h: [u8; 4] = " h=\0"
    say((&s_geo[0 as usize]) as u64)
    ulib.sayu(WIN_Y)
    say((&s_w[0 as usize]) as u64)
    ulib.sayu(w)
    say((&s_h[0 as usize]) as u64)
    ulib.sayu(h)
    ulib.nl()
}

fn u_gui() -> u64 {
    var s_bad: [u8; 23] = "welcome: no surface\0\0\0\0"
    var s_go: [u8; 15] = "welcome: ready\0"
    var s_nm: [u8; 8] = "welcome\0"
    var s_app: [u8; 8] = "welcome\0"
    let _mi: u64 = msg.init()
    var ww: u64 = welcome_conf.conf_num(119 as u8, 61 as u8)
    var wh: u64 = welcome_conf.conf_num(104 as u8, 61 as u8)
    if ww < MIN_W {
        ww = WIN_W
    }
    if wh < MIN_H {
        wh = WIN_H
    }
    welcome_pages.init()
    welcome_pages.set_page(welcome_conf.conf_num(112 as u8, 61 as u8))
    if !fuiscene.open(WIN_X, WIN_Y, ww, wh, msg.get((&k_title[0 as usize]) as u64), welcome_pages.build) {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    fuiscene.set_app((&s_app[0 as usize]) as u64)
    var first: bool = true
    var report_due: bool = false
    var spin: u64 = 0
    var poll_at: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        spin = spin + 1
        if (spin % 64) == 0 {
            let now: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
            if now < poll_at || now - poll_at >= POLL_TICKS {
                poll_at = now
                welcome_pages.tick()
            }
        }
        if first {
            first = false
            fuiscene.say_rects((&s_nm[0 as usize]) as u64)
            say_geom(ww, wh)
            welcome_pages.say_page()
            say((&s_go[0 as usize]) as u64)
            ulib.nl()
        }
        if report_due {
            report_due = false
            fuiscene.say_rects((&s_nm[0 as usize]) as u64)
        }
        if key != 0 {
            let ev: u64 = welcome_pages.on_key(key)
            if ev == welcome_pages.EV_QUIT {
                fuiscene.quit()
            } else if ev == welcome_pages.EV_PAGE {
                welcome_pages.say_page()
                report_due = true
            } else if ev == welcome_pages.EV_VIEW {
                report_due = true
            } else if ev == welcome_pages.EV_SHOW {
                say_show(welcome_pages.show_on())
            }
        }
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var a_auto: [u8; 3] = "-a\0"
    var a_stat: [u8; 7] = "status\0"
    var a_show: [u8; 5] = "show\0"
    var a_on: [u8; 3] = "on\0"
    var a_off: [u8; 4] = "off\0"
    var s_use: [u8; 44] = "usage: welcome [-a | status | show on|off]\0\0"
    var s_fail: [u8; 28] = "welcome: cannot write conf\0\0"
    let argc: u64 = ulib.arg_count(args)
    if argc >= 2 {
        let c: u64 = ulib.arg_at(args, 1)
        if ulib.streq(c, (&a_auto[0 as usize]) as u64) {
            if !welcome_conf.conf_on() {
                return 0
            }
            return u_gui()
        }
        if ulib.streq(c, (&a_stat[0 as usize]) as u64) {
            say_show(welcome_conf.conf_on())
            return 0
        }
        if ulib.streq(c, (&a_show[0 as usize]) as u64) && argc >= 3 {
            let v: u64 = ulib.arg_at(args, 2)
            if ulib.streq(v, (&a_on[0 as usize]) as u64) || ulib.streq(v, (&a_off[0 as usize]) as u64) {
                if !welcome_conf.conf_write(ulib.streq(v, (&a_on[0 as usize]) as u64)) {
                    say((&s_fail[0 as usize]) as u64)
                    ulib.nl()
                    return 1
                }
                return 0
            }
        }
        say((&s_use[0 as usize]) as u64)
        ulib.nl()
        return 2
    }
    return u_gui()
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
