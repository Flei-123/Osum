// kernel/user/appdir.fi -- Runde K15, zweiter Nachtrag: DAS
// ANWENDUNGSVERZEICHNIS. Ring 3, eine Bibliothek ohne `u_start`.
//
// Osum hatte bis zum ersten Nachtrag keinen Ort, an dem steht, WELCHE
// Programme es gibt. `/bin` listet Dateinamen -- `sh`, `edit`, `wc`,
// `explorer` --, und ein Dateiname ist kein Name: er sagt nicht, was das
// Programm tut, und man kann nicht danach suchen, wenn man ihn nicht
// schon kennt.
//
// EIN PROGRAMM IST EIN VERZEICHNIS. Das ist die Form von Apples Buendel,
// und der zweite Nachtrag verlangt sie ausdruecklich: alles, was zu
// einem Programm gehoert, liegt an EINER Stelle. Installieren heisst
// kopieren, entfernen heisst loeschen, und es gibt keinen zweiten Ort,
// den man vergessen kann.
//
//     /apps/explorer.prog/
//         INFO          Anzeigename, Beschreibung, Schluesselwoerter,
//                       Fassung
//         start         die ausfuehrbare Datei
//         symbol        das Bild (OSYM, siehe tools/k15/symbol.py)
//         daten/        alles Weitere
//
// DIE ENDUNG IST `.prog` UND NICHT `.app`. `.app` ist zu deutlich
// Apples; ein System, das die Form uebernimmt, muss nicht auch den Namen
// nehmen.
//
// INFO IST `schluessel=wert`, EINE ZEILE JE FELD:
//
//     # Anmerkungen fangen mit einem Gatter an
//     name=Datei-Explorer
//     info=Dateien und Ordner ansehen
//     keys=datei,dateien,explorer,ordner,verzeichnis,manager,file,files,folder
//     fassung=1
//
// WARUM DIESES FORMAT UND NICHT `.desktop`. Der GEDANKE ist der von
// Freedesktop und er ist der richtige: Anzeigename, Beschreibung,
// Symbol und eine Liste von Schluesselwoertern, je Programm an einer
// Stelle. Was `.desktop` darueber hinaus mitbringt, hat dieses System
// nicht:
//
//   * `[Desktop Entry]` -- ein Gruppenkopf. Es gibt genau eine Gruppe.
//   * `Name[de]=` -- Sprachvarianten. Es gibt eine Sprache.
//   * `%f %U` -- Platzhalter in `Exec`. Der Starter uebergibt nichts.
//   * Escapes (`\s`, `\n`, `\\`) und in Anfuehrungszeichen gesetzte
//     Argumente. Ein Wert ist hier alles bis zum Zeilenende, roh.
//   * `Type=`, `Categories=`, `MimeType=`, `StartupNotify=` -- Felder
//     fuer Dinge, die es hier nicht gibt.
//
// Ein Leser fuer `.desktop` waere also zu neun Zehnteln Leser fuer
// Sachen, die nie vorkommen -- und jedes dieser Zehntel eine Stelle, an
// der er sich anders verhaelt als der echte.
//
// UND ES GIBT KEIN `exec=` MEHR. Im ersten Nachtrag stand dort ein
// absoluter Pfad, und ein Buendel mit einem Pfad nach draussen ist kein
// Buendel: man koennte es kopieren, und es zeigte weiter auf das alte
// Programm. Was ausgefuehrt wird, ist `<buendel>/start`, immer. Der
// Verweis dorthin kostet keinen Block (`tools/osum/mkfs.py`,
// `<neu>@<vorhanden>`) -- die Datei ist dieselbe wie die unter `/bin`.

profile kernel

import ulib
import libc.io

export {
    load, count, name_of, info_of, exec_of, icon_of, keys_of, datei_of,
    fassung_of, symbol_of, symbol_load,
    search, matches, lower, contains,
    net_of, net_user, view_for, view_word,
    MAXAPP, SYMBYTES
}

const MAXAPP: u64 = 16
const SYMBYTES: u64 = 1036 // 12 + 16 * 16 * 4
const A_NAME: u64 = 0
const A_INFO: u64 = 1
const A_EXEC: u64 = 2
const A_ICON: u64 = 3
const A_KEYS: u64 = 4
const A_FILE: u64 = 5
const A_FASS: u64 = 6
const A_SYM: u64 = 7
// ================================================== ROUND NETVIEW
//
// `net=real|filtered|faked|none` in INFO -- WHICH NETWORK THIS BUNDLE
// WANTS. Stored as the view PLUS ONE, so that 0 keeps meaning "the file
// does not say", which is not the same thing as "it says real": a
// bundle that says nothing may be overruled by a default one day, and a
// bundle that says `real` has made a statement.
const A_NET: u64 = 8
const A_FIELDS: u64 = 9

static mut ap: [u64; 144] = [0 as u64; 144] // MAXAPP * A_FIELDS
static mut folge: [u64; 16] = [0 as u64; 16]
static mut nap: u64 = 0
static mut arena: [u8; 6144] = [0 as u8; 6144]
static mut apos: u64 = 0
static mut nokeys: u64 = 0
static mut leer: [u8; 2] = "\0\0"
static mut symb: [u8; 16576] = [0 as u8; 16576] // MAXAPP * SYMBYTES

fn g(i: u64, f: u64) -> u64 {
    if i >= nap {
        return 0
    }
    return ap[(folge[(i) as usize] * A_FIELDS + f) as usize]
}

fn count() -> u64 {
    return nap
}

fn name_of(i: u64) -> u64 {
    return oder_leer(g(i, A_NAME))
}

fn info_of(i: u64) -> u64 {
    return oder_leer(g(i, A_INFO))
}

fn exec_of(i: u64) -> u64 {
    return oder_leer(g(i, A_EXEC))
}

fn fassung_of(i: u64) -> u64 {
    return oder_leer(g(i, A_FASS))
}

// Der Pfad des Symbols im Buendel. Leer, wenn keines da ist.
fn symbol_of(i: u64) -> u64 {
    return oder_leer(g(i, A_SYM))
}

// Das Bild selbst: geladen beim Lesen des Verzeichnisses, hier nur der
// Zeiger darauf. Null, wenn das Buendel keines hat oder es nicht mit
// "OSYM" anfaengt -- dann malt der Starter ein Plaettchen mit einem
// Buchstaben, und das Feld traegt statt eines Zeigers eine Farbe.
fn symbol_load(i: u64) -> u64 {
    if i >= nap {
        return 0
    }
    let k: u64 = folge[(i) as usize]
    let at: u64 = (&symb[0 as usize]) as u64 + k * SYMBYTES
    if __mmio_read8((at) as *mut u8) != 79 as u8 {
        return icon_of(i)
    }
    return at
}

fn icon_of(i: u64) -> u64 {
    return g(i, A_ICON)
}

// DIE SCHLUESSELWOERTER, und mit `nokeys` gibt es sie NICHT. Das ist die
// Gegenprobe zur Suche: dieselben Dateien, dieselbe Suche, nur ohne das
// Feld, das den Unterschied macht -- und "folder" findet dann nichts.
fn keys_of(i: u64) -> u64 {
    if nokeys != 0 {
        return (&leer[0 as usize]) as u64
    }
    return oder_leer(g(i, A_KEYS))
}

fn datei_of(i: u64) -> u64 {
    return oder_leer(g(i, A_FILE))
}

fn oder_leer(p: u64) -> u64 {
    if p == 0 {
        return (&leer[0 as usize]) as u64
    }
    return p
}

// ------------------------------------------------------------- lesen

fn put(p: u64, n: u64) -> u64 {
    if apos + n + 1 >= 4096 {
        return 0
    }
    let anfang: u64 = (&arena[0 as usize]) as u64 + apos
    var k: u64 = 0
    while k < n {
        arena[((apos + k)) as usize] = *((p + k) as *mut u8)
        k = k + 1
    }
    arena[((apos + n)) as usize] = 0 as u8
    apos = apos + n + 1
    return anfang
}

fn hex4(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return 16
}

fn feld_gleich(p: u64, n: u64, w: u64) -> bool {
    var k: u64 = 0
    while k < n {
        if (*((w + k) as *mut u8)) == 0 as u8 {
            return false
        }
        if (*((p + k) as *mut u8)) != (*((w + k) as *mut u8)) {
            return false
        }
        k = k + 1
    }
    return (*((w + n) as *mut u8)) == 0 as u8
}

fn eine_datei(pfad: u64, i: u64) -> bool {
    var buf: [u8; 1024] = [0 as u8; 1024]
    var f_name: [u8; 5] = "name\0"
    var f_info: [u8; 5] = "info\0"
    var f_exec: [u8; 5] = "exec\0"
    var f_icon: [u8; 5] = "icon\0"
    var f_keys: [u8; 5] = "keys\0"
    var f_fass: [u8; 8] = "fassung\0"
    var f_net: [u8; 4] = "net\0"
    let fd: u64 = io.open(pfad, 0)
    if ulib.bad(fd) {
        return false
    }
    let n: u64 = io.read(fd, (&buf[0 as usize]) as u64, 1023)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return false
    }
    let b: u64 = (&buf[0 as usize]) as u64
    var gefunden: bool = false
    var at: u64 = 0
    while at < n {
        var e: u64 = at
        while e < n && (*((b + e) as *mut u8)) != 10 as u8 {
            e = e + 1
        }
        if e > at && (*((b + at) as *mut u8)) != 35 as u8 {
            var g2: u64 = at
            while g2 < e && (*((b + g2) as *mut u8)) != 61 as u8 {
                g2 = g2 + 1
            }
            if g2 < e {
                let wert: u64 = b + g2 + 1
                let wlen: u64 = e - g2 - 1
                if feld_gleich(b + at, g2 - at, (&f_name[0 as usize]) as u64) {
                    ap[((i * A_FIELDS + A_NAME)) as usize] = put(wert, wlen)
                    gefunden = true
                } else if feld_gleich(b + at, g2 - at,
                    (&f_info[0 as usize]) as u64) {
                    ap[((i * A_FIELDS + A_INFO)) as usize] = put(wert, wlen)
                } else if feld_gleich(b + at, g2 - at,
                    (&f_fass[0 as usize]) as u64) {
                    ap[((i * A_FIELDS + A_FASS)) as usize] = put(wert, wlen)
                } else if feld_gleich(b + at, g2 - at,
                    (&f_keys[0 as usize]) as u64) {
                    ap[((i * A_FIELDS + A_KEYS)) as usize] = put(wert, wlen)
                } else if feld_gleich(b + at, g2 - at,
                    (&f_net[0 as usize]) as u64) {
                    let v: u64 = view_word(wert, wlen)
                    if v < 4 {
                        ap[((i * A_FIELDS + A_NET)) as usize] = v + 1
                    }
                } else if feld_gleich(b + at, g2 - at,
                    (&f_icon[0 as usize]) as u64) {
                    var v: u64 = 0
                    var stellen: u64 = 0
                    var k: u64 = 0
                    while k < wlen {
                        let d: u64 = hex4((*((wert + k) as *mut u8)) as u64)
                        if d < 16 {
                            v = (v << 4) | d
                            stellen = stellen + 1
                        }
                        k = k + 1
                    }
                    if stellen == 6 {
                        ap[((i * A_FIELDS + A_ICON)) as usize] = v
                    }
                }
            }
        }
        at = e + 1
    }
    return gefunden
}

// `.prog` am Ende -- und mindestens ein Zeichen davor, sonst waere ein
// Verzeichnis, das nur `.prog` heisst, ein Programm ohne Namen.
fn endet_auf_prog(p: u64) -> bool {
    var e: [u8; 6] = ".prog\0"
    let n: u64 = ulib.length(p)
    if n < 6 {
        return false
    }
    var k: u64 = 0
    while k < 5 {
        if (*((p + n - 5 + k) as *mut u8)) != e[(k) as usize] {
            return false
        }
        k = k + 1
    }
    return true
}

// Eine Datei im Buendel lesen. Gibt die Zahl der Oktette; 0, wenn es sie
// nicht gibt.
fn buendeldatei(dir: u64, name: u64, ziel: u64, max: u64) -> u64 {
    var voll: [u8; 160] = [0 as u8; 160]
    var schraeg: [u8; 2] = "/\0"
    ulib.strncpy((&voll[0 as usize]) as u64, dir, 120)
    ulib.strcat((&voll[0 as usize]) as u64, (&schraeg[0 as usize]) as u64)
    ulib.strcat((&voll[0 as usize]) as u64, name)
    let fd: u64 = io.open((&voll[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = io.read(fd, ziel, max)
    io.close(fd)
    if ulib.bad(n) {
        return 0
    }
    return n
}

// Das Verzeichnis lesen. Gibt die Zahl der gefundenen Programme zurueck.
// Nach Anzeigenamen sortiert -- die Reihenfolge auf der Platte ist die
// Reihenfolge, in der `mkfs.py` sie hingeschrieben hat, und das ist
// keine, an der sich ein Testlauf festhalten kann.
fn load(dir: u64, ohne_keys: bool) -> u64 {
    var eintraege: [u8; 1024] = [0 as u8; 1024]
    var voll: [u8; 160] = [0 as u8; 160]
    nap = 0
    apos = 0
    if ohne_keys {
        nokeys = 1
    } else {
        nokeys = 0
    }
    let fd: u64 = io.dir_open(dir)
    if ulib.bad(fd) {
        return 0
    }
    var weiter: bool = true
    while weiter {
        let n: u64 = io.dir_read(fd, (&eintraege[0 as usize]) as u64, 1024)
        if ulib.bad(n) || n == 0 {
            weiter = false
        } else {
            var at: u64 = 0
            while at < n {
                let rec: u64 = (&eintraege[0 as usize]) as u64 + at
                let rl: u64 = io.dir_reclen(rec)
                if rl == 0 {
                    at = n
                } else {
                    let nm: u64 = io.dir_name(rec)
                    if endet_auf_prog(nm) && nap < MAXAPP {
                        var s_info: [u8; 5] = "INFO\0"
                        var s_start: [u8; 6] = "start\0"
                        var s_sym: [u8; 7] = "symbol\0"
                        ulib.strncpy((&voll[0 as usize]) as u64, dir, 100)
                        var slash: [u8; 2] = "/\0"
                        ulib.strcat((&voll[0 as usize]) as u64,
                            (&slash[0 as usize]) as u64)
                        ulib.strcat((&voll[0 as usize]) as u64, nm)
                        var k: u64 = 0
                        while k < A_FIELDS {
                            ap[((nap * A_FIELDS + k)) as usize] = 0
                            k = k + 1
                        }
                        ap[((nap * A_FIELDS + A_FILE)) as usize] =
                            put(nm, ulib.length(nm))
                        // DER BEFEHL WIRD GEBAUT, NICHT GELESEN: er ist
                        // `<buendel>/start` und kann gar nichts anderes
                        // sein. Ein Buendel, dessen INFO woanders
                        // hinzeigt, waere kopierbar und trotzdem
                        // abhaengig von dem, wovon es weg kopiert wurde.
                        var befehl: [u8; 160] = [0 as u8; 160]
                        ulib.strcpy((&befehl[0 as usize]) as u64,
                            (&voll[0 as usize]) as u64)
                        ulib.strcat((&befehl[0 as usize]) as u64,
                            (&slash[0 as usize]) as u64)
                        ulib.strcat((&befehl[0 as usize]) as u64,
                            (&s_start[0 as usize]) as u64)
                        ap[((nap * A_FIELDS + A_EXEC)) as usize] =
                            put((&befehl[0 as usize]) as u64,
                                ulib.length((&befehl[0 as usize]) as u64))
                        var symp: [u8; 160] = [0 as u8; 160]
                        ulib.strcpy((&symp[0 as usize]) as u64,
                            (&voll[0 as usize]) as u64)
                        ulib.strcat((&symp[0 as usize]) as u64,
                            (&slash[0 as usize]) as u64)
                        ulib.strcat((&symp[0 as usize]) as u64,
                            (&s_sym[0 as usize]) as u64)
                        ap[((nap * A_FIELDS + A_SYM)) as usize] =
                            put((&symp[0 as usize]) as u64,
                                ulib.length((&symp[0 as usize]) as u64))
                        var infop: [u8; 160] = [0 as u8; 160]
                        ulib.strcpy((&infop[0 as usize]) as u64,
                            (&voll[0 as usize]) as u64)
                        ulib.strcat((&infop[0 as usize]) as u64,
                            (&slash[0 as usize]) as u64)
                        ulib.strcat((&infop[0 as usize]) as u64,
                            (&s_info[0 as usize]) as u64)
                        if eine_datei((&infop[0 as usize]) as u64, nap) {
                            buendeldatei((&voll[0 as usize]) as u64,
                                (&s_sym[0 as usize]) as u64,
                                (&symb[0 as usize]) as u64 + nap * SYMBYTES,
                                SYMBYTES)
                            nap = nap + 1
                        }
                    }
                    at = at + rl
                }
            }
        }
    }
    io.close(fd)
    // nach Anzeigenamen sortieren
    var i: u64 = 0
    while i < nap {
        folge[(i) as usize] = i
        i = i + 1
    }
    i = 1
    while i < nap {
        let v: u64 = folge[(i) as usize]
        var k: u64 = i
        while k > 0 && ulib.cmp(ap[((v * A_FIELDS + A_NAME)) as usize],
            ap[((folge[((k - 1)) as usize] * A_FIELDS + A_NAME)) as usize])
            == 1 {
            folge[(k) as usize] = folge[((k - 1)) as usize]
            k = k - 1
        }
        folge[(k) as usize] = v
        i = i + 1
    }
    return nap
}

// ------------------------------------------------------------- suchen

fn lower(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

// Steht `nadel` irgendwo in `heu`? Gross und klein gelten als gleich --
// wer "Explorer" tippt, meint "explorer".
fn contains(heu: u64, nadel: u64) -> bool {
    let n: u64 = ulib.length(nadel)
    if n == 0 {
        return true
    }
    let h: u64 = ulib.length(heu)
    if n > h {
        return false
    }
    var i: u64 = 0
    while i + n <= h {
        var k: u64 = 0
        var gleich: bool = true
        while k < n {
            if lower((*((heu + i + k) as *mut u8)) as u64)
                != lower((*((nadel + k) as *mut u8)) as u64) {
                gleich = false
                k = n
            } else {
                k = k + 1
            }
        }
        if gleich {
            return true
        }
        i = i + 1
    }
    return false
}

// DREI FELDER, UND DAS DRITTE IST DER GRUND FUER DIE GANZE SACHE.
// Anzeigename und Beschreibung findet man auch mit einem Namensvergleich;
// die Schluesselwoerter sind das, was "folder" auf "Datei-Explorer"
// zeigen laesst, obwohl das Wort dort nicht steht.
fn matches(i: u64, term: u64) -> bool {
    if ulib.length(term) == 0 {
        return true
    }
    if contains(name_of(i), term) {
        return true
    }
    if contains(info_of(i), term) {
        return true
    }
    return contains(keys_of(i), term)
}

// Die Treffer in `out` (je acht Oktette ein Index). Gibt die Zahl.
fn search(term: u64, out: u64, max: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < nap && n < max {
        if matches(i, term) {
            __mmio_write64((out + n * 8) as *mut u64, i)
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// ================================================== ROUND NETVIEW
//
// WHICH NETWORK A BUNDLE IS STARTED WITH, and WHERE THAT IS WRITTEN.
// There are exactly two places and they are ordered; the order is here
// and nowhere else, so that "where does this number come from" has one
// answer:
//
//   1. THE PERSON. `/users/<name>/config/netview`, one line per bundle:
//
//          explorer faked
//          browser  filtered
//
//      This is what the settings application writes and what the
//      person changed by hand. It wins, because a system that lets a
//      package overrule its user is a system that works for the
//      package.
//   2. THE PACKAGE. `net=` in `/apps/<name>.prog/INFO`. This is the
//      author of the program saying what it needs -- a reasonable
//      default and never more than that.
//   3. Neither: `real`. What every program got before this round.
//
// AND THERE IS NO THIRD PLACE. In particular the view is not written
// into the task record from here: what this returns is handed to
// `/bin/netview`, which tightens ITSELF and then starts the program.
// The running state lives in exactly one place (`sched.T_NETV`), and
// these files are what it is set FROM, not a second copy of it.

fn view_word(p: u64, n: u64) -> u64 {
    var w0: [u8; 5] = "real\0"
    var w1: [u8; 9] = "filtered\0"
    var w2: [u8; 6] = "faked\0"
    var w3: [u8; 5] = "none\0"
    if feld_gleich(p, n, (&w0[0 as usize]) as u64) {
        return 0
    }
    if feld_gleich(p, n, (&w1[0 as usize]) as u64) {
        return 1
    }
    if feld_gleich(p, n, (&w2[0 as usize]) as u64) {
        return 2
    }
    if feld_gleich(p, n, (&w3[0 as usize]) as u64) {
        return 3
    }
    return 9
}

// What the bundle asked for, or 9 if it did not ask.
fn net_of(i: u64) -> u64 {
    let v: u64 = g(i, A_NET)
    if v == 0 {
        return 9
    }
    return v - 1
}

// What the person wrote, or 9 if there is no line for this name. `who`
// is the user name; the caller has it and this file will not go and
// fetch a second copy of it.
fn net_user(who: u64, name: u64) -> u64 {
    var pfad: [u8; 128] = [0 as u8; 128]
    var buf: [u8; 1024] = [0 as u8; 1024]
    var p1: [u8; 8] = "/users/\0"
    var p2: [u8; 16] = "/config/netview\0"
    if who == 0 || ulib.length(who) == 0 {
        return 9
    }
    let a: u64 = ulib.strcpy((&pfad[0 as usize]) as u64,
        (&p1[0 as usize]) as u64)
    let b2: u64 = ulib.strcpy((&pfad[0 as usize]) as u64 + a, who)
    let _c: u64 = ulib.strcpy((&pfad[0 as usize]) as u64 + a + b2,
        (&p2[0 as usize]) as u64)
    let fd: u64 = io.open((&pfad[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return 9
    }
    let n: u64 = io.read(fd, (&buf[0 as usize]) as u64, 1023)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return 9
    }
    let b: u64 = (&buf[0 as usize]) as u64
    var at: u64 = 0
    while at < n {
        var e: u64 = at
        while e < n && (*((b + e) as *mut u8)) != 10 as u8 {
            e = e + 1
        }
        if e > at && (*((b + at) as *mut u8)) != 35 as u8 {
            // `<name> <view>`, separated by one or more spaces.
            var s: u64 = at
            while s < e && (*((b + s) as *mut u8)) != 32 as u8 {
                s = s + 1
            }
            if s < e && feld_gleich(b + at, s - at, name) {
                var v: u64 = s
                while v < e && (*((b + v) as *mut u8)) == 32 as u8 {
                    v = v + 1
                }
                var w: u64 = v
                while w < e && (*((b + w) as *mut u8)) != 32 as u8 {
                    w = w + 1
                }
                let got: u64 = view_word(b + v, w - v)
                if got < 4 {
                    return got
                }
            }
        }
        at = e + 1
    }
    return 9
}

// The two above, in the order the comment gives. `who` may be 0 -- then
// there is no person to ask and only the package speaks.
fn view_for(who: u64, i: u64, name: u64) -> u64 {
    let u: u64 = net_user(who, name)
    if u < 4 {
        return u
    }
    let a: u64 = net_of(i)
    if a < 4 {
        return a
    }
    return 0
}
