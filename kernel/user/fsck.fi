
profile kernel

import ulib
import libc.io
import libc.errno
import libc.kcall
import fsckpart
import fsckcrypt

export { u_start }

const BS: u64 = 512
const MAGIC_LO: u64 = 0x2D4F4653
const MAGIC_HI: u64 = 0x4F53554D

const SB_MAGIC: u64 = 0
const SB_BSIZE: u64 = 8
const SB_BLOCKS: u64 = 16
const SB_INODES: u64 = 24
const SB_BITMAP: u64 = 32
const SB_ITABLE: u64 = 40
const SB_DATA: u64 = 48
const SB_ROOT: u64 = 56
const SB_VERSION: u64 = 64
const SB_BMBLOCKS: u64 = 72
const SB_ISIZE: u64 = 80
const SB_DIRENT: u64 = 88
const SB_NAMELEN: u64 = 96
const SB_JSTART: u64 = 104
const SB_JBLOCKS: u64 = 112
const SB_XVER: u64 = 120
const SB_XBLOCKS: u64 = 128
const SB_XBMSTART: u64 = 136
const SB_XITSTART: u64 = 144
const SB_XINODES: u64 = 152

const I_TYPE: u64 = 0
const I_SIZE: u64 = 8
const I_DIRECT: u64 = 24
const I_INDIRECT: u64 = 112
const I_DINDIRECT: u64 = 120
const I_TINDIRECT: u64 = 128
const I_QINDIRECT: u64 = 160

const T_FILE: u64 = 1
const T_DIR: u64 = 2
const T_LINK: u64 = 3

const PER_BLOCK: u64 = 64

const J_COMMIT_LO: u64 = 0x4A53464F
const J_COMMIT_HI: u64 = 0x4D4D4F43

const SEEN_BLOCKS: u64 = 1048576
const SEEN_BYTES: u64 = 131072
const VIS_MAX: u64 = 262144
const STACK_MAX: u64 = 512

static mut sb: [u8; 512] = [0 as u8; 512];
static mut blk: [u8; 512] = [0 as u8; 512];
static mut ptr: [u8; 512] = [0 as u8; 512];
static mut ptr2: [u8; 512] = [0 as u8; 512];
static mut ent: [u8; 512] = [0 as u8; 512];
static mut seen: [u8; 131072] = [0 as u8; 131072];
static mut vis: [u8; 32768] = [0 as u8; 32768];
static mut stack: [u64; 512] = [0 as u64; 512];

static mut fd: u64 = 0;
static mut part_base: u64 = 0;
static mut x_base: u64 = 0;
static mut x_it: u64 = 0;
static mut x_lo: u64 = 0;
static mut x_hi: u64 = 0;
static mut lost_n: u64 = 0;
static mut missing_n: u64 = 0;
static mut errors: u64 = 0;
static mut fixed: u64 = 0;
static mut repair: bool = false;
static mut check_only: bool = false;
static mut dot_entry: bool = false;

fn report(label: u64, value: u64) {
    var s_head: [u8; 7] = "fsck: \0";
    var s_eq: [u8; 4] = " = \0";
    ulib.say((&s_head[0 as usize]) as u64);
    ulib.say(label);
    ulib.say((&s_eq[0 as usize]) as u64);
    ulib.sayu(value);
    ulib.nl();
}

fn g64(p: u64) -> u64 {
    return __mmio_read64(p as *mut u64);
}

fn read_sector(lba: u64, dst: u64) -> bool {
    if errno.failed(io.seek(fd, (part_base + fsckcrypt.data_offset() + lba) * BS, 0)) {
        return false;
    }
    let n: u64 = io.read_full(fd, dst, BS);
    if errno.failed(n) {
        return false;
    }
    if n != BS {
        return false;
    }
    return fsckcrypt.after_read(lba, dst);
}

fn write_sector(lba: u64, src: u64) -> bool {
    if errno.failed(io.seek(fd, (part_base + fsckcrypt.data_offset() + lba) * BS, 0)) {
        return false;
    }
    let out: u64 = fsckcrypt.before_write(lba, src);
    if out == 0 {
        return false;
    }
    let n: u64 = io.write(fd, out, BS);
    if errno.failed(n) {
        return false;
    }
    return n == BS;
}

fn seen_get(b: u64) -> u64 {
    if b >= SEEN_BLOCKS {
        return 1;
    }
    return ((seen[((b / 8)) as usize] as u64) >> (b % 8)) & 1;
}

fn seen_set(b: u64) {
    if b >= SEEN_BLOCKS {
        return;
    }
    seen[((b / 8)) as usize] =
        ((seen[((b / 8)) as usize] as u64) | (1 << (b % 8))) as u8;
}

fn vis_get(i: u64) -> u64 {
    if i >= VIS_MAX {
        return 1;
    }
    return ((vis[((i / 8)) as usize] as u64) >> (i % 8)) & 1;
}

fn vis_set(i: u64) {
    if i >= VIS_MAX {
        return;
    }
    vis[((i / 8)) as usize] =
        ((vis[((i / 8)) as usize] as u64) | (1 << (i % 8))) as u8;
}

fn inode_lba(ino: u64, itab: u64, ipb: u64) -> u64 {
    if x_base != 0 && ino > x_base {
        return x_it + (ino - 1 - x_base) / ipb;
    }
    return itab + (ino - 1) / ipb;
}

fn inode_pos(ino: u64, ipb: u64) -> u64 {
    if x_base != 0 && ino > x_base {
        return (ino - 1 - x_base) % ipb;
    }
    return (ino - 1) % ipb;
}

fn check_map(from: u64, to: u64, mapstart: u64, origin: u64) {
    if from >= to {
        return;
    }
    var map_block: u64 = (from - origin) / 4096;
    while map_block <= (to - 1 - origin) / 4096 {
        if !read_sector(mapstart + map_block, (&blk[0 as usize]) as u64) {
            map_block = (to - 1 - origin) / 4096;
        } else {
            var dirty: bool = false;
            var blk_no: u64 = origin + map_block * 4096;
            if blk_no < from {
                blk_no = from;
            }
            let end: u64 = min_u64(origin + (map_block + 1) * 4096, to);
            while blk_no < end {
                let idx: u64 = blk_no - origin;
                let map_byte: u64 = blk[(((idx % 4096) / 8)) as usize] as u64;
                let map_bit: u64 = (map_byte >> (idx % 8)) & 1;
                let s: u64 = seen_get(blk_no);
                if map_bit == 1 && s == 0 {
                    lost_n = lost_n + 1;
                    if repair {
                        blk[(((idx % 4096) / 8)) as usize] =
                            (map_byte & (255 ^ (1 << (idx % 8)))) as u8;
                        dirty = true;
                        fixed = fixed + 1;
                    }
                }
                if map_bit == 0 && s == 1 {
                    missing_n = missing_n + 1;
                    if repair {
                        blk[(((idx % 4096) / 8)) as usize] =
                            (map_byte | (1 << (idx % 8))) as u8;
                        dirty = true;
                        fixed = fixed + 1;
                    }
                }
                blk_no = blk_no + 1;
            }
            if dirty {
                write_sector(mapstart + map_block, (&blk[0 as usize]) as u64);
            }
        }
        map_block = map_block + 1;
    }
}

fn superblock_magic_ok() -> u64 {
    let m: u64 = g64((&sb[0 as usize]) as u64 + SB_MAGIC);
    if (m & 0xFFFFFFFF) == MAGIC_LO && (m >> 32) == MAGIC_HI {
        return 1;
    }
    return 0;
}

fn u_start(args: u64) -> u64 {
    var s_dev: [u8; 10] = "/dev/hda\0\0";
    var w_r: [u8; 3] = "-r\0";
    var w_check: [u8; 13] = "--check-only\0";
    var w_crypt: [u8; 8] = "--crypt\0";
    var n_crypt: [u8; 6] = "crypt\0";
    var n_crypt_open: [u8; 11] = "crypt_open\0";
    var n_crypt_slot: [u8; 11] = "crypt_slot\0";
    var pass_ptr: u64 = 0;
    var n_part: [u8; 16] = "partition_start\0";
    var n_magic: [u8; 6] = "magic\0";
    var n_version: [u8; 8] = "version\0";
    var n_blocks: [u8; 7] = "blocks\0";
    var n_inodes: [u8; 7] = "inodes\0";
    var n_geom: [u8; 5] = "geom\0";
    var n_journal: [u8; 8] = "journal\0";
    var n_journal_open: [u8; 13] = "journal_open\0";
    var n_files: [u8; 6] = "files\0";
    var n_used_blocks: [u8; 12] = "used_blocks\0";
    var n_out_of_range: [u8; 13] = "out_of_range\0";
    var n_duplicate: [u8; 10] = "duplicate\0";
    var n_lost: [u8; 5] = "lost\0";
    var n_missing: [u8; 8] = "missing\0";
    var n_bad_type: [u8; 9] = "bad_type\0";
    var n_dirs: [u8; 5] = "dirs\0";
    var n_dead_links: [u8; 11] = "dead_links\0";
    var n_cycles: [u8; 7] = "cycles\0";
    var n_too_large: [u8; 10] = "too_large\0";
    var n_errors: [u8; 7] = "errors\0";
    var n_fixed: [u8; 6] = "fixed\0";

    var path: u64 = (&s_dev[0 as usize]) as u64;
    let argc: u64 = ulib.arg_count(args);
    var ai: u64 = 1;
    while ai < argc {
        let a: u64 = ulib.arg_at(args, ai);
        if ulib.streq(a, (&w_r[0 as usize]) as u64) {
            repair = true;
        } else if ulib.streq(a, (&w_check[0 as usize]) as u64) {
            check_only = true;
        } else if ulib.streq(a, (&w_crypt[0 as usize]) as u64) && ai + 1 < argc {
            ai = ai + 1;
            pass_ptr = ulib.arg_at(args, ai);
        } else {
            path = a;
        }
        ai = ai + 1;
    }

    if check_only {
        repair = false;
    }
    var f: u64 = io.open(path, 0);
    if repair {
        f = io.open(path, kcall.O_RDWR);
    }
    if errno.failed(f) && repair {
        f = io.open(path, 0);
        repair = false;
    }
    if errno.failed(f) {
        report((&n_magic[0 as usize]) as u64, 0);
        report((&n_errors[0 as usize]) as u64, 1);
        return 1;
    }
    fd = f;

    let dev_len: u64 = io.seek(fd, 0, 2);
    var device_blocks: u64 = 0;
    if !errno.failed(dev_len) {
        device_blocks = dev_len / BS;
    }

    var have_sb: bool = read_sector(0, (&sb[0 as usize]) as u64);
    var magic_ok: u64 = 0;
    if have_sb {
        magic_ok = superblock_magic_ok();
    }
    var crypt_state: u64 = fsckcrypt.probe(fd, 0);
    if crypt_state == fsckcrypt.ABSENT && magic_ok == 0 && fsckpart.find_ofs_partition(fd) {
        part_base = fsckpart.found_start();
        device_blocks = fsckpart.found_blocks();
        crypt_state = fsckcrypt.probe(fd, part_base);
        if crypt_state == fsckcrypt.ABSENT {
            have_sb = read_sector(0, (&sb[0 as usize]) as u64);
            if have_sb {
                magic_ok = superblock_magic_ok();
            }
        }
    }
    if crypt_state != fsckcrypt.ABSENT {
        report((&n_crypt[0 as usize]) as u64, 1);
        var opened: bool = false;
        if crypt_state == fsckcrypt.PRESENT && pass_ptr != 0 {
            opened = fsckcrypt.unlock(pass_ptr, ulib.length(pass_ptr));
        }
        if opened {
            report((&n_crypt_open[0 as usize]) as u64, 1);
            report((&n_crypt_slot[0 as usize]) as u64, fsckcrypt.slot());
            device_blocks = fsckcrypt.data_blocks();
            have_sb = read_sector(0, (&sb[0 as usize]) as u64);
            magic_ok = 0;
            if have_sb {
                magic_ok = superblock_magic_ok();
            }
        } else {
            report((&n_crypt_open[0 as usize]) as u64, 0);
            report((&n_part[0 as usize]) as u64, part_base);
            report((&n_magic[0 as usize]) as u64, 0);
            errors = errors + 1;
            report((&n_errors[0 as usize]) as u64, errors);
            io.close(fd);
            return 1;
        }
    }
    report((&n_part[0 as usize]) as u64, part_base);
    if !have_sb {
        report((&n_magic[0 as usize]) as u64, 0);
        report((&n_errors[0 as usize]) as u64, 1);
        io.close(fd);
        return 1;
    }
    report((&n_magic[0 as usize]) as u64, magic_ok);
    if magic_ok == 0 {
        errors = errors + 1;
        report((&n_errors[0 as usize]) as u64, errors);
        io.close(fd);
        return 1;
    }

    var ver: u64 = g64((&sb[0 as usize]) as u64 + SB_VERSION);
    if ver == 0 {
        ver = 1;
    }
    report((&n_version[0 as usize]) as u64, ver);

    let bsize: u64 = g64((&sb[0 as usize]) as u64 + SB_BSIZE);
    var geom: u64 = 1;
    if bsize != BS {
        geom = 0;
    }

    var bmb: u64 = g64((&sb[0 as usize]) as u64 + SB_BMBLOCKS);
    var isize: u64 = g64((&sb[0 as usize]) as u64 + SB_ISIZE);
    var dirent: u64 = g64((&sb[0 as usize]) as u64 + SB_DIRENT);
    if bmb == 0 {
        bmb = 1;
    }
    if isize == 0 {
        isize = 128;
    }
    if dirent == 0 {
        dirent = 32;
    }
    if isize < 128 || isize > BS || (BS % isize) != 0 {
        geom = 0;
        isize = 128;
    }
    if dirent < 32 || dirent > BS {
        geom = 0;
        dirent = 32;
    }
    let ipb: u64 = BS / isize;
    var directs: u64 = 8;
    if ver < 2 {
        directs = 11;
    }

    let bmstart: u64 = g64((&sb[0 as usize]) as u64 + SB_BITMAP);
    let itab: u64 = g64((&sb[0 as usize]) as u64 + SB_ITABLE);
    var ds: u64 = g64((&sb[0 as usize]) as u64 + SB_DATA);
    var ni: u64 = g64((&sb[0 as usize]) as u64 + SB_INODES);
    var total: u64 = g64((&sb[0 as usize]) as u64 + SB_BLOCKS);

    if total == 0 || (device_blocks != 0 && total > device_blocks) {
        if device_blocks != 0 {
            total = device_blocks;
        }
    }
    if bmstart == 0 || bmstart >= total {
        geom = 0;
    }
    if itab <= bmstart || itab >= total {
        geom = 0;
    }
    if ds <= itab || ds >= total {
        geom = 0;
        ds = itab + 1;
    }
    let fits: u64 = (ds - itab) * ipb;
    if ni == 0 || ni > fits {
        if ni > fits {
            geom = 0;
        }
        ni = fits;
    }
    if bmb * 4096 < total {
        geom = 0;
    }
    var ext_inodes: u64 = 0;
    var ext_ds: u64 = 0;
    var xbm: u64 = 0;
    if g64((&sb[0 as usize]) as u64 + SB_XVER) != 0 {
        let xblk: u64 = g64((&sb[0 as usize]) as u64 + SB_XBLOCKS);
        xbm = g64((&sb[0 as usize]) as u64 + SB_XBMSTART);
        let xit: u64 = g64((&sb[0 as usize]) as u64 + SB_XITSTART);
        let xin: u64 = g64((&sb[0 as usize]) as u64 + SB_XINODES);
        let cover: u64 = bmb * 4096;
        var xok: bool = xblk > cover && total <= cover && xbm == cover;
        if xin == 0 || xin % ipb != 0 {
            xok = false;
        }
        if device_blocks != 0 && xblk > device_blocks {
            xok = false;
        }
        if xok {
            let nbm: u64 = (xblk - cover + 4095) / 4096;
            ext_ds = xit + (xin + ipb - 1) / ipb;
            if xit < xbm + nbm || ext_ds + 8 > xblk {
                xok = false;
            }
        }
        if xok {
            x_base = ni;
            x_it = xit;
            x_lo = total;
            x_hi = ext_ds;
            ext_inodes = xin;
            total = xblk;
        } else {
            geom = 0;
        }
    }
    if total > SEEN_BLOCKS {
        report((&n_too_large[0 as usize]) as u64, total);
    } else {
        report((&n_too_large[0 as usize]) as u64, 0);
    }
    report((&n_blocks[0 as usize]) as u64, total);
    report((&n_inodes[0 as usize]) as u64, ni + ext_inodes);
    ni = ni + ext_inodes;
    report((&n_geom[0 as usize]) as u64, geom);
    if geom == 0 {
        errors = errors + 1;
    }

    let js: u64 = g64((&sb[0 as usize]) as u64 + SB_JSTART);
    let jb: u64 = g64((&sb[0 as usize]) as u64 + SB_JBLOCKS);
    var journal_open: u64 = 0;
    if js != 0 && jb >= 522 && js + jb <= total {
        if read_sector(js + 521, (&blk[0 as usize]) as u64) {
            let cm: u64 = g64((&blk[0 as usize]) as u64);
            if (cm & 0xFFFFFFFF) == J_COMMIT_LO && (cm >> 32) == J_COMMIT_HI {
                journal_open = 1;
            }
        }
    }
    report((&n_journal[0 as usize]) as u64, jb);
    report((&n_journal_open[0 as usize]) as u64, journal_open);

    var b: u64 = 0;
    while b < ds && b < total {
        seen_set(b);
        b = b + 1;
    }
    if x_base != 0 {
        b = x_lo;
        while b < x_hi && b < SEEN_BLOCKS {
            seen_set(b);
            b = b + 1;
        }
    }

    var files: u64 = 0;
    var used_blocks: u64 = 0;
    var out_of_range: u64 = 0;
    var duplicate: u64 = 0;
    var bad_type: u64 = 0;
    var dirs: u64 = 0;
    var ino: u64 = 1;
    while ino <= ni {
        let iblk: u64 = inode_lba(ino, itab, ipb);
        let ioff: u64 = inode_pos(ino, ipb) * isize;
        if !read_sector(iblk, (&blk[0 as usize]) as u64) {
            ino = ni;
        } else {
            let at: u64 = (&blk[0 as usize]) as u64 + ioff;
            let itype: u64 = g64(at + I_TYPE);
            if itype != 0 {
                if itype != T_FILE && itype != T_DIR && itype != T_LINK {
                    bad_type = bad_type + 1;
                } else {
                    files = files + 1;
                    if itype == T_DIR {
                        dirs = dirs + 1;
                    }
                }
                if itype == T_FILE || itype == T_DIR || itype == T_LINK {
                    var k: u64 = 0;
                    while k < directs {
                        let p: u64 = g64(at + I_DIRECT + k * 8);
                        let r: u64 = claim(p, ds, total);
                        used_blocks = used_blocks + (r & 1);
                        out_of_range = out_of_range + ((r >> 1) & 1);
                        duplicate = duplicate + ((r >> 2) & 1);
                        k = k + 1;
                    }
                    let s1: u64 = g64(at + I_INDIRECT);
                    let e1: u64 = walk_level(s1, ds, total, 1);
                    used_blocks = used_blocks + (e1 & 0xFFFF);
                    out_of_range = out_of_range + ((e1 >> 16) & 0xFFFF);
                    duplicate = duplicate + ((e1 >> 32) & 0xFFFF);
                    let s2: u64 = g64(at + I_DINDIRECT);
                    let e2: u64 = walk_level(s2, ds, total, 2);
                    used_blocks = used_blocks + (e2 & 0xFFFF);
                    out_of_range = out_of_range + ((e2 >> 16) & 0xFFFF);
                    duplicate = duplicate + ((e2 >> 32) & 0xFFFF);
                    if ver >= 3 {
                        let s3: u64 = g64(at + I_TINDIRECT);
                        let e3: u64 = walk_level(s3, ds, total, 3);
                        used_blocks = used_blocks + (e3 & 0xFFFF);
                        out_of_range = out_of_range + ((e3 >> 16) & 0xFFFF);
                        duplicate = duplicate + ((e3 >> 32) & 0xFFFF);
                        let s4: u64 = g64(at + I_QINDIRECT);
                        let e4: u64 = walk_level(s4, ds, total, 4);
                        used_blocks = used_blocks + (e4 & 0xFFFF);
                        out_of_range = out_of_range + ((e4 >> 16) & 0xFFFF);
                        duplicate = duplicate + ((e4 >> 32) & 0xFFFF);
                    }
                }
            }
            ino = ino + 1;
        }
    }
    report((&n_files[0 as usize]) as u64, files);
    report((&n_dirs[0 as usize]) as u64, dirs);
    report((&n_used_blocks[0 as usize]) as u64, used_blocks);
    report((&n_out_of_range[0 as usize]) as u64, out_of_range);
    report((&n_duplicate[0 as usize]) as u64, duplicate);
    report((&n_bad_type[0 as usize]) as u64, bad_type);
    errors = errors + out_of_range + duplicate + bad_type;

    lost_n = 0;
    missing_n = 0;
    if x_base != 0 {
        check_map(ds, min_u64(x_lo, SEEN_BLOCKS), bmstart, 0);
        check_map(x_hi, min_u64(total, SEEN_BLOCKS), xbm, bmb * 4096);
    } else {
        check_map(ds, min_u64(total, SEEN_BLOCKS), bmstart, 0);
    }
    let lost: u64 = lost_n;
    let missing: u64 = missing_n;
    report((&n_lost[0 as usize]) as u64, lost);
    report((&n_missing[0 as usize]) as u64, missing);
    errors = errors + missing;
    if !repair {
        errors = errors + lost;
    }

    var dead_links: u64 = 0;
    var cycles: u64 = 0;
    var sp: u64 = 0;
    let root: u64 = g64((&sb[0 as usize]) as u64 + SB_ROOT);
    if root != 0 && root <= ni {
        stack[(0) as usize] = root;
        sp = 1;
        vis_set(root);
    }
    while sp > 0 {
        sp = sp - 1;
        let d: u64 = stack[(sp) as usize];
        let n: u64 = entry_count(d, itab, ipb, isize, dirent);
        var e: u64 = 0;
        while e < n {
            let child: u64 = entry(d, e, itab, ipb, isize, dirent, ds,
                total, directs, ver);
            if child != 0 {
                if child > ni {
                    dead_links = dead_links + 1;
                } else {
                    if type_of(child, itab, ipb, isize) == 0 {
                        dead_links = dead_links + 1;
                    } else {
                        if type_of(child, itab, ipb, isize) == T_DIR {
                            if vis_get(child) == 0 {
                                vis_set(child);
                                if sp < STACK_MAX {
                                    stack[(sp) as usize] = child;
                                    sp = sp + 1;
                                }
                            } else {
                                if !dot_entry {
                                    cycles = cycles + 1;
                                }
                            }
                        }
                    }
                }
            }
            e = e + 1;
        }
    }
    report((&n_dead_links[0 as usize]) as u64, dead_links);
    report((&n_cycles[0 as usize]) as u64, cycles);
    errors = errors + dead_links + cycles;

    report((&n_errors[0 as usize]) as u64, errors);
    report((&n_fixed[0 as usize]) as u64, fixed);
    io.close(fd);
    if errors == 0 {
        return 0;
    }
    return 1;
}

fn min_u64(a: u64, b: u64) -> u64 {
    if a < b {
        return a;
    }
    return b;
}

fn claim(p: u64, ds: u64, total: u64) -> u64 {
    if p == 0 {
        return 0;
    }
    if p < ds || p >= total {
        return 2;
    }
    if x_base != 0 && p >= x_lo && p < x_hi {
        return 2;
    }
    if p >= SEEN_BLOCKS {
        return 1;
    }
    if seen_get(p) == 1 {
        return 5;
    }
    seen_set(p);
    return 1;
}

fn walk_level(p: u64, ds: u64, total: u64, depth: u64) -> u64 {
    if p == 0 {
        return 0;
    }
    let r0: u64 = claim(p, ds, total);
    var counted: u64 = r0 & 1;
    var outside: u64 = (r0 >> 1) & 1;
    var dup: u64 = (r0 >> 2) & 1;
    if outside == 1 || dup == 1 {
        return counted | (outside << 16) | (dup << 32);
    }
    if !read_sector(p, (&ptr[0 as usize]) as u64) {
        return counted | (outside << 16) | (dup << 32);
    }
    var copy: [u64; 64] = [0 as u64; 64];
    var i: u64 = 0;
    while i < PER_BLOCK {
        copy[(i) as usize] = g64((&ptr[0 as usize]) as u64 + i * 8);
        i = i + 1;
    }
    i = 0;
    while i < PER_BLOCK {
        let q: u64 = copy[(i) as usize];
        if q != 0 {
            if depth == 1 {
                let r: u64 = claim(q, ds, total);
                counted = counted + (r & 1);
                outside = outside + ((r >> 1) & 1);
                dup = dup + ((r >> 2) & 1);
            } else {
                let r2: u64 = walk_level(q, ds, total, depth - 1);
                counted = counted + (r2 & 0xFFFF);
                outside = outside + ((r2 >> 16) & 0xFFFF);
                dup = dup + ((r2 >> 32) & 0xFFFF);
            }
        }
        i = i + 1;
    }
    return min_u64(counted, 65535) | (min_u64(outside, 65535) << 16)
        | (min_u64(dup, 65535) << 32);
}

fn type_of(ino: u64, itab: u64, ipb: u64, isize: u64) -> u64 {
    if ino == 0 {
        return 0;
    }
    if !read_sector(inode_lba(ino, itab, ipb), (&ptr2[0 as usize]) as u64) {
        return 0;
    }
    return g64((&ptr2[0 as usize]) as u64 + inode_pos(ino, ipb) * isize
        + I_TYPE);
}

fn entry_count(ino: u64, itab: u64, ipb: u64, isize: u64, dirent: u64) -> u64 {
    if ino == 0 {
        return 0;
    }
    if !read_sector(inode_lba(ino, itab, ipb), (&ptr2[0 as usize]) as u64) {
        return 0;
    }
    let sz: u64 = g64((&ptr2[0 as usize]) as u64 + inode_pos(ino, ipb) * isize
        + I_SIZE);
    return sz / dirent;
}

fn entry(ino: u64, e: u64, itab: u64, ipb: u64, isize: u64, dirent: u64,
    ds: u64, total: u64, directs: u64, ver: u64) -> u64 {
    let pos: u64 = e * dirent;
    let idx: u64 = pos / BS;
    let inb: u64 = pos % BS;
    if inb + 8 > BS {
        return 0;
    }
    let b: u64 = data_block(ino, idx, itab, ipb, isize, ds, total, directs,
        ver);
    if b == 0 {
        return 0;
    }
    if !read_sector(b, (&ent[0 as usize]) as u64) {
        return 0;
    }
    dot_entry = false;
    if inb + 11 <= BS {
        let c0: u64 = __mmio_read8(((&ent[0 as usize]) as u64 + inb + 8)
            as *mut u8) as u64;
        let c1: u64 = __mmio_read8(((&ent[0 as usize]) as u64 + inb + 9)
            as *mut u8) as u64;
        let c2: u64 = __mmio_read8(((&ent[0 as usize]) as u64 + inb + 10)
            as *mut u8) as u64;
        if c0 == 46 && c1 == 0 {
            dot_entry = true;
        }
        if c0 == 46 && c1 == 46 && c2 == 0 {
            dot_entry = true;
        }
    }
    return g64((&ent[0 as usize]) as u64 + inb);
}

fn data_block(ino: u64, idx: u64, itab: u64, ipb: u64, isize: u64, ds: u64,
    total: u64, directs: u64, ver: u64) -> u64 {
    if ino == 0 {
        return 0;
    }
    if !read_sector(inode_lba(ino, itab, ipb), (&ptr2[0 as usize]) as u64) {
        return 0;
    }
    let at: u64 = (&ptr2[0 as usize]) as u64 + inode_pos(ino, ipb) * isize;
    if idx < directs {
        return in_range(g64(at + I_DIRECT + idx * 8), ds, total);
    }
    var k: u64 = idx - directs;
    if k < PER_BLOCK {
        return cursor(in_range(g64(at + I_INDIRECT), ds, total), k, ds,
            total);
    }
    k = k - PER_BLOCK;
    if k < PER_BLOCK * PER_BLOCK {
        let l1: u64 = cursor(in_range(g64(at + I_DINDIRECT), ds, total),
            k / PER_BLOCK, ds, total);
        return cursor(l1, k % PER_BLOCK, ds, total);
    }
    if ver < 3 {
        return 0;
    }
    k = k - PER_BLOCK * PER_BLOCK;
    if k < PER_BLOCK * PER_BLOCK * PER_BLOCK {
        let m1: u64 = cursor(in_range(g64(at + I_TINDIRECT), ds, total),
            k / (PER_BLOCK * PER_BLOCK), ds, total);
        let m2: u64 = cursor(m1, (k / PER_BLOCK) % PER_BLOCK, ds, total);
        return cursor(m2, k % PER_BLOCK, ds, total);
    }
    k = k - PER_BLOCK * PER_BLOCK * PER_BLOCK;
    if k >= PER_BLOCK * PER_BLOCK * PER_BLOCK * PER_BLOCK {
        return 0;
    }
    let n1: u64 = cursor(in_range(g64(at + I_QINDIRECT), ds, total),
        k / (PER_BLOCK * PER_BLOCK * PER_BLOCK), ds, total);
    let n2: u64 = cursor(n1, (k / (PER_BLOCK * PER_BLOCK)) % PER_BLOCK, ds, total);
    let n3: u64 = cursor(n2, (k / PER_BLOCK) % PER_BLOCK, ds, total);
    return cursor(n3, k % PER_BLOCK, ds, total);
}

fn in_range(p: u64, ds: u64, total: u64) -> u64 {
    if p < ds || p >= total {
        return 0;
    }
    if x_base != 0 && p >= x_lo && p < x_hi {
        return 0;
    }
    return p;
}

fn cursor(block: u64, k: u64, ds: u64, total: u64) -> u64 {
    if block == 0 {
        return 0;
    }
    if !read_sector(block, (&ptr[0 as usize]) as u64) {
        return 0;
    }
    return in_range(g64((&ptr[0 as usize]) as u64 + k * 8), ds, total);
}
