// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/fsck.fi -- RUNDE FSROBUST: DAS PRUEFPROGRAMM FUER OFS.
//
// Es liest die Platte ROH, ueber `/dev/hda`, und in Ring 3. Beides ist
// Absicht:
//
//   ROH, weil ein Pruefprogramm, das durch dasselbe Dateisystem sieht,
//   das es pruefen soll, genau die Fehler nicht findet, die dieses
//   Dateisystem hat. `open`/`read` auf einen Pfad geht durch `fs.path`,
//   `fs.read_at` und `file_block` -- ein kaputter Zeiger dort faellt
//   dann als "Datei nicht gefunden" auf und nicht als das, was er ist.
//   `/dev/hda` gibt Sektoren.
//
//   IN RING 3, weil dieses Programm auch eine Platte pruefen koennen
//   muss, die der Kern gar nicht eingehaengt hat -- und weil es sonst
//   nicht abstuerzen duerfte. Ein `fsck`, das auf einem mutwillig
//   zerstoerten Abbild in eine Endlosschleife laeuft, ist schlimmer als
//   keines: es sieht aus, als arbeite es.
//
// ==================================================================
// WARUM ES IMMER FERTIG WIRD
// ==================================================================
//
// Das ist die Zusage, die in der Aufgabe steht, und sie wird hier nicht
// gehofft, sondern gebaut. JEDE Schleife dieses Programms laeuft ueber
// eine Zahl, die VORHER gedeckelt wurde:
//
//   * Die Zahl der Bloecke ist hoechstens die des Geraets (`lseek` auf
//     das Ende von /dev/hda) -- was der Superblock behauptet, gilt nur,
//     wenn es kleiner ist.
//   * Die Zahl der Inodes ist hoechstens, was zwischen Inodetabelle und
//     Datenbereich Platz hat.
//   * Der Zeigerbaum hat DREI Stufen, keine mehr; die Tiefe ist
//     ausgeschrieben und nicht rekursiv.
//   * Der Verzeichnisdurchlauf merkt sich jede besuchte Inode und
//     betritt keine zweimal. Ein Verzeichnis, das sich selbst enthaelt,
//     kostet damit einen Besuch und keinen zweiten.
//   * Der Arbeitsstapel des Durchlaufs ist fest; laeuft er voll, sagt
//     das Programm das und hoert auf.
//
// ==================================================================
// WAS ES PRUEFT
// ==================================================================
//
//   1. Den Superblock: Kennung, Blockgroesse, Fassung, und ob die
//      Bereiche in der richtigen Reihenfolge liegen und auf die Platte
//      passen.
//   2. Das Journal: ob eine Bestaetigung offen steht. Nachtragen tut
//      `mount`; hier wird es nur GEMELDET, weil ein `fsck`, das
//      nachtraegt, dem Kern in die Arbeit pfuscht.
//   3. Jede Inode: Art, und jeden Blockzeiger auf Bereich und
//      DOPPELBELEGUNG. Zwei Dateien, die sich einen Block teilen, sind
//      der Schaden, der sich still ausbreitet.
//   4. Die Karte gegen die Wirklichkeit: ein Block, der belegt ist und
//      zu niemandem gehoert, ist VERLOREN; einer, der zu jemandem
//      gehoert und frei dasteht, wird beim naechsten Schreiben ein
//      zweites Mal vergeben -- das ist der gefaehrlichere von beiden.
//   5. Den Verzeichnisbaum ab der Wurzel: jeder Eintrag muss auf eine
//      Inode zeigen, die es gibt.
//
// WAS ES BEHEBT, mit `-r`, und NUR, wo es eindeutig ist:
//
//   * einen verlorenen Block wieder freigeben,
//   * einen benutzten Block in der Karte als belegt eintragen.
//
// Alles andere wird gemeldet und nicht angefasst. Welche von zwei
// Dateien einen doppelt belegten Block behalten soll, weiss dieses
// Programm nicht, und zu raten waere schlimmer als zu melden.

profile kernel

import ulib
import libc.io
import libc.errno
import libc.kcall

export { u_start }

const BS: u64 = 512
const MAGIC_LO: u64 = 0x2D4F4653      // "-OFS" (die oberen vier Oktette)
const MAGIC_HI: u64 = 0x4F53554D      // "OSUM" (die unteren vier)

const SB_MAGIC: u64 = 0
const SB_BSIZE: u64 = 8
const SB_BLOCKS: u64 = 16
const SB_INODES: u64 = 24
const SB_BITMAP: u64 = 32
const SB_ITABLE: u64 = 40
const SB_DATA: u64 = 48
const SB_ROOT: u64 = 56
const SB_VERSION: u64 = 64
const SB_BMBLOCKS: u64 = 72
const SB_ISIZE: u64 = 80
const SB_DIRENT: u64 = 88
const SB_NAMELEN: u64 = 96
const SB_JSTART: u64 = 104
const SB_JBLOCKS: u64 = 112

const I_TYPE: u64 = 0
const I_SIZE: u64 = 8
const I_DIRECT: u64 = 24
const I_INDIRECT: u64 = 112
const I_DINDIRECT: u64 = 120
const I_TINDIRECT: u64 = 128

const T_FILE: u64 = 1
const T_DIR: u64 = 2
const T_LINK: u64 = 3

const PER_BLOCK: u64 = 64 // 512 / 8

// `kernel/ofsj.fi::COMMIT_MAGIC`, dieselbe Zahl.
const J_COMMIT_LO: u64 = 0x4A53464F
const J_COMMIT_HI: u64 = 0x4D4D4F43

// Wie viele Bloecke die Doppelbelegungspruefung deckt. 1.048.576 Bits
// sind 128 KiB Speicher und 512 MiB Platte. Was darueber liegt, wird
// GEMELDET und nicht stillschweigend uebersprungen -- eine Pruefung, die
// heimlich aufhoert, ist eine Luege.
const SEEN_BLOCKS: u64 = 1048576
const SEEN_BYTES: u64 = 131072
// Wie viele Inodes der Verzeichnisdurchlauf hoechstens kennt.
const VIS_MAX: u64 = 65536
const STAPEL_MAX: u64 = 512

static mut sb: [u8; 512] = [0 as u8; 512];
static mut blk: [u8; 512] = [0 as u8; 512];
static mut ptr: [u8; 512] = [0 as u8; 512];
static mut ptr2: [u8; 512] = [0 as u8; 512];
static mut ent: [u8; 512] = [0 as u8; 512];
static mut seen: [u8; 131072] = [0 as u8; 131072];
static mut vis: [u8; 8192] = [0 as u8; 8192];
static mut stapel: [u64; 512] = [0 as u64; 512];

static mut fd: u64 = 0;
static mut fehler: u64 = 0;
static mut behoben: u64 = 0;
static mut reparieren: bool = false;
// Ob der zuletzt gelesene Verzeichniseintrag `.` oder `..` hiess. Die
// beiden sind die EINZIGEN Namen, unter denen ein Verzeichnis
// zurueckzeigen darf; jeder andere Name auf ein schon besuchtes
// Verzeichnis ist ein KREIS.
static mut punkt: bool = false;

fn sag(name: u64, wert: u64) {
    var s_kopf: [u8; 7] = "fsck: \0";
    var s_gl: [u8; 4] = " = \0";
    ulib.say((&s_kopf[0 as usize]) as u64);
    ulib.say(name);
    ulib.say((&s_gl[0 as usize]) as u64);
    ulib.sayu(wert);
    ulib.nl();
}

fn g64(p: u64) -> u64 {
    return __mmio_read64(p as *mut u64);
}

fn lies(lba: u64, ziel: u64) -> bool {
    if errno.failed(io.seek(fd, lba * BS, 0)) {
        return false;
    }
    let n: u64 = io.read_full(fd, ziel, BS);
    if errno.failed(n) {
        return false;
    }
    if n != BS {
        return false;
    }
    return true;
}

fn schreib(lba: u64, quelle: u64) -> bool {
    if errno.failed(io.seek(fd, lba * BS, 0)) {
        return false;
    }
    let n: u64 = io.write(fd, quelle, BS);
    if errno.failed(n) {
        return false;
    }
    return n == BS;
}

// ------------------------------------------------------ die zweite Karte
//
// `seen` ist die Karte, die dieses Programm SELBST fuehrt: ein Bit je
// Block, gesetzt heisst "jemand benutzt ihn". Am Ende wird sie gegen die
// Karte auf der Platte gehalten, und jeder Unterschied ist ein Befund.
fn seen_get(b: u64) -> u64 {
    if b >= SEEN_BLOCKS {
        return 1;
    }
    return ((seen[((b / 8)) as usize] as u64) >> (b % 8)) & 1;
}

fn seen_set(b: u64) {
    if b >= SEEN_BLOCKS {
        return;
    }
    seen[((b / 8)) as usize] =
        ((seen[((b / 8)) as usize] as u64) | (1 << (b % 8))) as u8;
}

fn vis_get(i: u64) -> u64 {
    if i >= VIS_MAX {
        return 1;
    }
    return ((vis[((i / 8)) as usize] as u64) >> (i % 8)) & 1;
}

fn vis_set(i: u64) {
    if i >= VIS_MAX {
        return;
    }
    vis[((i / 8)) as usize] =
        ((vis[((i / 8)) as usize] as u64) | (1 << (i % 8))) as u8;
}

fn u_start(args: u64) -> u64 {
    var s_dev: [u8; 10] = "/dev/hda\0\0";
    var w_r: [u8; 3] = "-r\0";
    var n_magic: [u8; 7] = "magic\0\0";
    var n_version: [u8; 9] = "version\0\0";
    var n_blocks: [u8; 8] = "blocks\0\0";
    var n_inodes: [u8; 8] = "inodes\0\0";
    var n_geom: [u8; 6] = "geom\0\0";
    var n_journal: [u8; 9] = "journal\0\0";
    var n_joffen: [u8; 8] = "joffen\0\0";
    var n_dateien: [u8; 9] = "dateien\0\0";
    var n_bloecke: [u8; 9] = "bloecke\0\0";
    var n_ausser: [u8; 8] = "ausser\0\0";
    var n_doppelt: [u8; 9] = "doppelt\0\0";
    var n_verloren: [u8; 10] = "verloren\0\0";
    var n_fehlend: [u8; 9] = "fehlend\0\0";
    var n_badtype: [u8; 9] = "badtype\0\0";
    var n_dirs: [u8; 6] = "dirs\0\0";
    var n_totlinks: [u8; 10] = "totlinks\0\0";
    var n_kreise: [u8; 8] = "kreise\0\0";
    var n_zugross: [u8; 9] = "zugross\0\0";
    var n_fehler: [u8; 8] = "fehler\0\0";
    var n_behoben: [u8; 9] = "behoben\0\0";

    var pfad: u64 = (&s_dev[0 as usize]) as u64;
    let argc: u64 = ulib.arg_count(args);
    var ai: u64 = 1;
    while ai < argc {
        let a: u64 = ulib.arg_at(args, ai);
        if ulib.streq(a, (&w_r[0 as usize]) as u64) {
            reparieren = true;
        } else {
            pfad = a;
        }
        ai = ai + 1;
    }

    let f: u64 = io.open(pfad, kcall.O_RDWR);
    if errno.failed(f) {
        let f2: u64 = io.open(pfad, 0);
        if errno.failed(f2) {
            sag((&n_magic[0 as usize]) as u64, 0);
            sag((&n_fehler[0 as usize]) as u64, 1);
            return 1;
        }
        fd = f2;
        reparieren = false;
    } else {
        fd = f;
    }

    // WIE GROSS DAS GERAET WIRKLICH IST. Das ist die erste und
    // wichtigste Deckelung: alles, was der Superblock behauptet, wird
    // hieran gemessen.
    let laenge: u64 = io.seek(fd, 0, 2);
    var geraet: u64 = 0;
    if !errno.failed(laenge) {
        geraet = laenge / BS;
    }

    if !lies(0, (&sb[0 as usize]) as u64) {
        sag((&n_magic[0 as usize]) as u64, 0);
        sag((&n_fehler[0 as usize]) as u64, 1);
        io.close(fd);
        return 1;
    }
    let m: u64 = g64((&sb[0 as usize]) as u64 + SB_MAGIC);
    var magic_ok: u64 = 0;
    if (m & 0xFFFFFFFF) == MAGIC_LO && (m >> 32) == MAGIC_HI {
        magic_ok = 1;
    }
    sag((&n_magic[0 as usize]) as u64, magic_ok);
    if magic_ok == 0 {
        fehler = fehler + 1;
        sag((&n_fehler[0 as usize]) as u64, fehler);
        io.close(fd);
        return 1;
    }

    var ver: u64 = g64((&sb[0 as usize]) as u64 + SB_VERSION);
    if ver == 0 {
        ver = 1;
    }
    sag((&n_version[0 as usize]) as u64, ver);

    let bsize: u64 = g64((&sb[0 as usize]) as u64 + SB_BSIZE);
    var geom: u64 = 1;
    if bsize != BS {
        geom = 0;
    }

    var bmb: u64 = g64((&sb[0 as usize]) as u64 + SB_BMBLOCKS);
    var isize: u64 = g64((&sb[0 as usize]) as u64 + SB_ISIZE);
    var dirent: u64 = g64((&sb[0 as usize]) as u64 + SB_DIRENT);
    if bmb == 0 {
        bmb = 1;
    }
    if isize == 0 {
        isize = 128;
    }
    if dirent == 0 {
        dirent = 32;
    }
    if isize < 128 || isize > BS || (BS % isize) != 0 {
        geom = 0;
        isize = 128;
    }
    if dirent < 32 || dirent > BS {
        geom = 0;
        dirent = 32;
    }
    let ipb: u64 = BS / isize;
    var directs: u64 = 8;
    if ver < 2 {
        directs = 11;
    }

    let bmstart: u64 = g64((&sb[0 as usize]) as u64 + SB_BITMAP);
    let itab: u64 = g64((&sb[0 as usize]) as u64 + SB_ITABLE);
    var ds: u64 = g64((&sb[0 as usize]) as u64 + SB_DATA);
    var ni: u64 = g64((&sb[0 as usize]) as u64 + SB_INODES);
    var total: u64 = g64((&sb[0 as usize]) as u64 + SB_BLOCKS);

    // ----------------------------------------------------- die Deckelung
    if total == 0 || (geraet != 0 && total > geraet) {
        if geraet != 0 {
            total = geraet;
        }
    }
    if total > SEEN_BLOCKS {
        sag((&n_zugross[0 as usize]) as u64, total);
    } else {
        sag((&n_zugross[0 as usize]) as u64, 0);
    }
    if bmstart == 0 || bmstart >= total {
        geom = 0;
    }
    if itab <= bmstart || itab >= total {
        geom = 0;
    }
    if ds <= itab || ds >= total {
        geom = 0;
        ds = itab + 1;
    }
    // Mehr Inodes, als zwischen Tabelle und Daten passen, gibt es nicht.
    let passt: u64 = (ds - itab) * ipb;
    if ni == 0 || ni > passt {
        if ni > passt {
            geom = 0;
        }
        ni = passt;
    }
    if bmb * 4096 < total {
        geom = 0;
    }
    sag((&n_blocks[0 as usize]) as u64, total);
    sag((&n_inodes[0 as usize]) as u64, ni);
    sag((&n_geom[0 as usize]) as u64, geom);
    if geom == 0 {
        fehler = fehler + 1;
    }

    // ------------------------------------------------------- das Journal
    let js: u64 = g64((&sb[0 as usize]) as u64 + SB_JSTART);
    let jb: u64 = g64((&sb[0 as usize]) as u64 + SB_JBLOCKS);
    var joffen: u64 = 0;
    if js != 0 && jb >= 522 && js + jb <= total {
        if lies(js + 521, (&blk[0 as usize]) as u64) {
            let cm: u64 = g64((&blk[0 as usize]) as u64);
            if (cm & 0xFFFFFFFF) == J_COMMIT_LO && (cm >> 32) == J_COMMIT_HI {
                joffen = 1;
            }
        }
    }
    sag((&n_journal[0 as usize]) as u64, jb);
    sag((&n_joffen[0 as usize]) as u64, joffen);

    // Die Verwaltung gehoert niemandem und ist trotzdem belegt.
    var b: u64 = 0;
    while b < ds && b < total {
        seen_set(b);
        b = b + 1;
    }

    // ------------------------------------------------------ die Inodes
    var dateien: u64 = 0;
    var bloecke: u64 = 0;
    var ausser: u64 = 0;
    var doppelt: u64 = 0;
    var badtype: u64 = 0;
    var dirs: u64 = 0;
    var ino: u64 = 1;
    while ino <= ni {
        // `ino - 1` UND NICHT `ino`: die Inodetabelle faengt bei Nummer
        // EINS an, es gibt keinen Platz null. `kernel/fs.fi` rechnet in
        // `inode_block_of` genauso, und der erste Entwurf dieses
        // Programms tat es nicht -- es las damit jede Inode um eine zu
        // hoch und meldete Fehler, die es nicht gab.
        let iblk: u64 = itab + (ino - 1) / ipb;
        let ioff: u64 = ((ino - 1) % ipb) * isize;
        if !lies(iblk, (&blk[0 as usize]) as u64) {
            ino = ni;
        } else {
            let at: u64 = (&blk[0 as usize]) as u64 + ioff;
            let art: u64 = g64(at + I_TYPE);
            if art != 0 {
                if art != T_FILE && art != T_DIR && art != T_LINK {
                    badtype = badtype + 1;
                } else {
                    dateien = dateien + 1;
                    if art == T_DIR {
                        dirs = dirs + 1;
                    }
                }
                if art == T_FILE || art == T_DIR || art == T_LINK {
                    // die direkten Zeiger
                    var k: u64 = 0;
                    while k < directs {
                        let p: u64 = g64(at + I_DIRECT + k * 8);
                        let r: u64 = nimm(p, ds, total);
                        bloecke = bloecke + (r & 1);
                        ausser = ausser + ((r >> 1) & 1);
                        doppelt = doppelt + ((r >> 2) & 1);
                        k = k + 1;
                    }
                    // eine Stufe
                    let s1: u64 = g64(at + I_INDIRECT);
                    let e1: u64 = stufe(s1, ds, total, 1);
                    bloecke = bloecke + (e1 & 0xFFFF);
                    ausser = ausser + ((e1 >> 16) & 0xFFFF);
                    doppelt = doppelt + ((e1 >> 32) & 0xFFFF);
                    // zwei Stufen
                    let s2: u64 = g64(at + I_DINDIRECT);
                    let e2: u64 = stufe(s2, ds, total, 2);
                    bloecke = bloecke + (e2 & 0xFFFF);
                    ausser = ausser + ((e2 >> 16) & 0xFFFF);
                    doppelt = doppelt + ((e2 >> 32) & 0xFFFF);
                    // drei Stufen -- nur in Fassung 3
                    if ver >= 3 {
                        let s3: u64 = g64(at + I_TINDIRECT);
                        let e3: u64 = stufe(s3, ds, total, 3);
                        bloecke = bloecke + (e3 & 0xFFFF);
                        ausser = ausser + ((e3 >> 16) & 0xFFFF);
                        doppelt = doppelt + ((e3 >> 32) & 0xFFFF);
                    }
                }
            }
            ino = ino + 1;
        }
    }
    sag((&n_dateien[0 as usize]) as u64, dateien);
    sag((&n_dirs[0 as usize]) as u64, dirs);
    sag((&n_bloecke[0 as usize]) as u64, bloecke);
    sag((&n_ausser[0 as usize]) as u64, ausser);
    sag((&n_doppelt[0 as usize]) as u64, doppelt);
    sag((&n_badtype[0 as usize]) as u64, badtype);
    fehler = fehler + ausser + doppelt + badtype;

    // ------------------------------------- die Karte gegen die Wirklichkeit
    var verloren: u64 = 0;
    var fehlend: u64 = 0;
    if total <= SEEN_BLOCKS {
        var kb: u64 = ds / 4096;
        while kb <= (total - 1) / 4096 {
            if !lies(bmstart + kb, (&blk[0 as usize]) as u64) {
                kb = (total - 1) / 4096;
            } else {
                var geaendert: bool = false;
                var bb: u64 = kb * 4096;
                if bb < ds {
                    bb = ds;
                }
                let ende: u64 = grenze((kb + 1) * 4096, total);
                while bb < ende {
                    let byte: u64 = blk[(((bb % 4096) / 8)) as usize] as u64;
                    let bit: u64 = (byte >> (bb % 8)) & 1;
                    let s: u64 = seen_get(bb);
                    if bit == 1 && s == 0 {
                        verloren = verloren + 1;
                        if reparieren {
                            blk[(((bb % 4096) / 8)) as usize] =
                                (byte & (255 ^ (1 << (bb % 8)))) as u8;
                            geaendert = true;
                            behoben = behoben + 1;
                        }
                    }
                    if bit == 0 && s == 1 {
                        fehlend = fehlend + 1;
                        if reparieren {
                            blk[(((bb % 4096) / 8)) as usize] =
                                (byte | (1 << (bb % 8))) as u8;
                            geaendert = true;
                            behoben = behoben + 1;
                        }
                    }
                    bb = bb + 1;
                }
                if geaendert {
                    schreib(bmstart + kb, (&blk[0 as usize]) as u64);
                }
            }
            kb = kb + 1;
        }
    }
    sag((&n_verloren[0 as usize]) as u64, verloren);
    sag((&n_fehlend[0 as usize]) as u64, fehlend);
    fehler = fehler + fehlend;
    if !reparieren {
        fehler = fehler + verloren;
    }

    // -------------------------------------------- der Verzeichnisdurchlauf
    //
    // Breitensuche ab der Wurzel, mit festem Stapel und einer Marke je
    // besuchter Inode. Ein Verzeichnis, das sich selbst enthaelt, wird
    // damit EINMAL betreten -- der zweite Versuch prallt an der Marke ab.
    var totlinks: u64 = 0;
    var kreise: u64 = 0;
    var sp: u64 = 0;
    let wurzel: u64 = g64((&sb[0 as usize]) as u64 + SB_ROOT);
    if wurzel != 0 && wurzel <= ni {
        stapel[(0) as usize] = wurzel;
        sp = 1;
        vis_set(wurzel);
    }
    while sp > 0 {
        sp = sp - 1;
        let d: u64 = stapel[(sp) as usize];
        let n: u64 = eintraege(d, itab, ipb, isize, dirent);
        var e: u64 = 0;
        while e < n {
            let kind: u64 = eintrag(d, e, itab, ipb, isize, dirent, ds,
                total, directs, ver);
            if kind != 0 {
                if kind > ni {
                    totlinks = totlinks + 1;
                } else {
                    if art_von(kind, itab, ipb, isize) == 0 {
                        totlinks = totlinks + 1;
                    } else {
                        if art_von(kind, itab, ipb, isize) == T_DIR {
                            if vis_get(kind) == 0 {
                                vis_set(kind);
                                if sp < STAPEL_MAX {
                                    stapel[(sp) as usize] = kind;
                                    sp = sp + 1;
                                }
                            } else {
                                // SCHON BESUCHT. Unter `.` oder `..`
                                // ist das die Regel; unter jedem
                                // anderen Namen ist es ein KREIS, und
                                // der laesst ein Verzeichnis nie
                                // wieder loeschen.
                                if !punkt {
                                    kreise = kreise + 1;
                                }
                            }
                        }
                    }
                }
            }
            e = e + 1;
        }
    }
    sag((&n_totlinks[0 as usize]) as u64, totlinks);
    sag((&n_kreise[0 as usize]) as u64, kreise);
    fehler = fehler + totlinks + kreise;

    sag((&n_fehler[0 as usize]) as u64, fehler);
    sag((&n_behoben[0 as usize]) as u64, behoben);
    io.close(fd);
    if fehler == 0 {
        return 0;
    }
    return 1;
}

fn grenze(a: u64, b: u64) -> u64 {
    if a < b {
        return a;
    }
    return b;
}

// EIN Blockzeiger. Rueckgabe als Bitfeld: 1 = gezaehlt, 2 = ausserhalb,
// 4 = doppelt belegt.
fn nimm(p: u64, ds: u64, total: u64) -> u64 {
    if p == 0 {
        return 0;
    }
    if p < ds || p >= total {
        return 2;
    }
    if seen_get(p) == 1 {
        return 5;
    }
    seen_set(p);
    return 1;
}

// Ein Zeigerblock, `tiefe` Stufen tief. Die Tiefe ist eine Zahl von 1
// bis 3 und keine Rekursion ohne Boden -- weiter als drei geht dieses
// Dateisystem nicht, also geht dieses Programm auch nicht weiter.
// Rueckgabe: gezaehlt | ausserhalb << 16 | doppelt << 32.
fn stufe(p: u64, ds: u64, total: u64, tiefe: u64) -> u64 {
    if p == 0 {
        return 0;
    }
    let r0: u64 = nimm(p, ds, total);
    var gez: u64 = r0 & 1;
    var aus: u64 = (r0 >> 1) & 1;
    var dop: u64 = (r0 >> 2) & 1;
    if aus == 1 || dop == 1 {
        return gez | (aus << 16) | (dop << 32);
    }
    if !lies(p, (&ptr[0 as usize]) as u64) {
        return gez | (aus << 16) | (dop << 32);
    }
    // Der Block wird KOPIERT, bevor eine Stufe tiefer denselben Puffer
    // braucht. Ohne das laese die zweite Stufe den Zeiger der ersten
    // unter sich weg -- derselbe Fehler, den `kernel/fs.fi` in Runde K4
    // mit `buf_i2` behoben hat.
    var kopie: [u64; 64] = [0 as u64; 64];
    var i: u64 = 0;
    while i < PER_BLOCK {
        kopie[(i) as usize] = g64((&ptr[0 as usize]) as u64 + i * 8);
        i = i + 1;
    }
    i = 0;
    while i < PER_BLOCK {
        let q: u64 = kopie[(i) as usize];
        if q != 0 {
            if tiefe == 1 {
                let r: u64 = nimm(q, ds, total);
                gez = gez + (r & 1);
                aus = aus + ((r >> 1) & 1);
                dop = dop + ((r >> 2) & 1);
            } else {
                let r2: u64 = stufe(q, ds, total, tiefe - 1);
                gez = gez + (r2 & 0xFFFF);
                aus = aus + ((r2 >> 16) & 0xFFFF);
                dop = dop + ((r2 >> 32) & 0xFFFF);
            }
        }
        i = i + 1;
    }
    return grenze(gez, 65535) | (grenze(aus, 65535) << 16)
        | (grenze(dop, 65535) << 32);
}

fn art_von(ino: u64, itab: u64, ipb: u64, isize: u64) -> u64 {
    if ino == 0 {
        return 0;
    }
    if !lies(itab + (ino - 1) / ipb, (&ptr2[0 as usize]) as u64) {
        return 0;
    }
    return g64((&ptr2[0 as usize]) as u64 + ((ino - 1) % ipb) * isize
        + I_TYPE);
}

fn eintraege(ino: u64, itab: u64, ipb: u64, isize: u64, dirent: u64) -> u64 {
    if ino == 0 {
        return 0;
    }
    if !lies(itab + (ino - 1) / ipb, (&ptr2[0 as usize]) as u64) {
        return 0;
    }
    let sz: u64 = g64((&ptr2[0 as usize]) as u64 + ((ino - 1) % ipb) * isize
        + I_SIZE);
    return sz / dirent;
}

// Der `e`-te Eintrag eines Verzeichnisses, ROH von der Platte gelesen.
// Rueckgabe: die Inodenummer, 0 = leerer Platz oder unlesbar.
fn eintrag(ino: u64, e: u64, itab: u64, ipb: u64, isize: u64, dirent: u64,
    ds: u64, total: u64, directs: u64, ver: u64) -> u64 {
    let pos: u64 = e * dirent;
    let idx: u64 = pos / BS;
    let inb: u64 = pos % BS;
    // Ein Eintrag darf ueber eine Blockgrenze gehen; dieses Programm
    // liest dann nur den vorderen Teil -- die INODENUMMER steht in den
    // ersten acht Oktetten, und mehr braucht es hier nicht.
    if inb + 8 > BS {
        return 0;
    }
    let b: u64 = datenblock(ino, idx, itab, ipb, isize, ds, total, directs,
        ver);
    if b == 0 {
        return 0;
    }
    if !lies(b, (&ent[0 as usize]) as u64) {
        return 0;
    }
    punkt = false;
    if inb + 11 <= BS {
        let c0: u64 = __mmio_read8(((&ent[0 as usize]) as u64 + inb + 8)
            as *mut u8) as u64;
        let c1: u64 = __mmio_read8(((&ent[0 as usize]) as u64 + inb + 9)
            as *mut u8) as u64;
        let c2: u64 = __mmio_read8(((&ent[0 as usize]) as u64 + inb + 10)
            as *mut u8) as u64;
        if c0 == 46 && c1 == 0 {
            punkt = true;
        }
        if c0 == 46 && c1 == 46 && c2 == 0 {
            punkt = true;
        }
    }
    return g64((&ent[0 as usize]) as u64 + inb);
}

// Der `idx`-te Block einer Datei, ROH. Dieselben drei Stufen wie in
// `kernel/fs.fi::file_block`, nur ohne Wachsen -- und mit einer
// Bereichspruefung bei JEDEM Schritt, weil hier ein kaputter Zeiger
// erwartet wird und kein gueltiger.
fn datenblock(ino: u64, idx: u64, itab: u64, ipb: u64, isize: u64, ds: u64,
    total: u64, directs: u64, ver: u64) -> u64 {
    if ino == 0 {
        return 0;
    }
    if !lies(itab + (ino - 1) / ipb, (&ptr2[0 as usize]) as u64) {
        return 0;
    }
    let at: u64 = (&ptr2[0 as usize]) as u64 + ((ino - 1) % ipb) * isize;
    if idx < directs {
        return im_bereich(g64(at + I_DIRECT + idx * 8), ds, total);
    }
    var k: u64 = idx - directs;
    if k < PER_BLOCK {
        return zeiger(im_bereich(g64(at + I_INDIRECT), ds, total), k, ds,
            total);
    }
    k = k - PER_BLOCK;
    if k < PER_BLOCK * PER_BLOCK {
        let l1: u64 = zeiger(im_bereich(g64(at + I_DINDIRECT), ds, total),
            k / PER_BLOCK, ds, total);
        return zeiger(l1, k % PER_BLOCK, ds, total);
    }
    if ver < 3 {
        return 0;
    }
    k = k - PER_BLOCK * PER_BLOCK;
    if k >= PER_BLOCK * PER_BLOCK * PER_BLOCK {
        return 0;
    }
    let m1: u64 = zeiger(im_bereich(g64(at + I_TINDIRECT), ds, total),
        k / (PER_BLOCK * PER_BLOCK), ds, total);
    let m2: u64 = zeiger(m1, (k / PER_BLOCK) % PER_BLOCK, ds, total);
    return zeiger(m2, k % PER_BLOCK, ds, total);
}

fn im_bereich(p: u64, ds: u64, total: u64) -> u64 {
    if p < ds || p >= total {
        return 0;
    }
    return p;
}

fn zeiger(block: u64, k: u64, ds: u64, total: u64) -> u64 {
    if block == 0 {
        return 0;
    }
    if !lies(block, (&ptr[0 as usize]) as u64) {
        return 0;
    }
    return im_bereich(g64((&ptr[0 as usize]) as u64 + k * 8), ds, total);
}
