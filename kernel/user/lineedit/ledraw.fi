profile kernel

import ulib
import lineedit.lebuf

export { begin, refresh, append, finish, clear_screen, flush }

const OUT_MAX: u64 = 2048

static mut ob: [u8; 2048] = [0 as u8; 2048]
static mut on: u64 = 0
static mut cur_row: u64 = 0
static mut cur_col: u64 = 0

fn flush() {
    if on > 0 {
        ulib.put((&ob[0 as usize]) as u64, on)
        on = 0
    }
}

fn byte(b: u64) {
    if on + 1 >= OUT_MAX {
        flush()
    }
    ob[on as usize] = b as u8
    on = on + 1
}

fn number(v: u64) {
    if v >= 10 {
        number(v / 10)
    }
    byte(48 + v % 10)
}

fn csi(n: u64, fin: u64) {
    byte(27)
    byte(91)
    if n != 1 {
        number(n)
    }
    byte(fin)
}

fn bytes(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        byte(lebuf.at(p, i))
        i = i + 1
    }
}

fn go(row: u64, col: u64) {
    if row > cur_row {
        csi(row - cur_row, 66)
    } else if row < cur_row {
        csi(cur_row - row, 65)
    }
    byte(13)
    if col > 0 {
        csi(col, 67)
    }
    cur_row = row
    cur_col = col
}

fn begin(prompt: u64, plen: u64, cols: u64) {
    on = 0
    bytes(prompt, ulib.length(prompt))
    cur_row = plen / cols
    cur_col = plen % cols
    flush()
}

fn refresh(prompt: u64, plen: u64, p: u64, len: u64, pos: u64, cols: u64) {
    if cur_row > 0 {
        csi(cur_row, 65)
    }
    byte(13)
    bytes(prompt, ulib.length(prompt))
    bytes(p, len)
    let total: u64 = plen + lebuf.cells(p, 0, len)
    cur_row = total / cols
    cur_col = total % cols
    if cur_col == 0 {
        byte(13)
        byte(10)
    }
    csi(0, 74)
    let tgt: u64 = plen + lebuf.cells(p, 0, pos)
    go(tgt / cols, tgt % cols)
    flush()
}

fn append(b: u64, plen: u64, p: u64, len: u64, cols: u64) -> bool {
    let total: u64 = plen + lebuf.cells(p, 0, len)
    if total % cols == 0 || b >= 128 {
        return false
    }
    byte(b)
    cur_row = total / cols
    cur_col = total % cols
    flush()
    return true
}

fn finish(plen: u64, p: u64, len: u64, cols: u64, mark: u64) {
    let total: u64 = plen + lebuf.cells(p, 0, len)
    go(total / cols, total % cols)
    bytes(mark, ulib.length(mark))
    if total % cols != 0 || ulib.length(mark) > 0 {
        byte(13)
        byte(10)
    }
    cur_row = 0
    cur_col = 0
    flush()
}

fn clear_screen() {
    byte(27)
    byte(91)
    byte(72)
    byte(27)
    byte(91)
    byte(50)
    byte(74)
    cur_row = 0
    cur_col = 0
}
