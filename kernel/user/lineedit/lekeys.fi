// SPDX-License-Identifier: GPL-2.0-only
profile kernel

export { reset, feed, NONE, UP, DOWN, LEFT, RIGHT, HOME, END, DEL, WORD_LEFT, WORD_RIGHT }

const NONE: u64 = 0x1000
const UP: u64 = 0x100
const DOWN: u64 = 0x101
const LEFT: u64 = 0x102
const RIGHT: u64 = 0x103
const HOME: u64 = 0x104
const END: u64 = 0x105
const DEL: u64 = 0x106
const WORD_LEFT: u64 = 0x107
const WORD_RIGHT: u64 = 0x108

const ST_PLAIN: u64 = 0
const ST_ESC: u64 = 1
const ST_CSI: u64 = 2
const ST_SS3: u64 = 3
const MOD_CTRL: u64 = 5

static mut st: u64 = 0
static mut p0: u64 = 0
static mut p1: u64 = 0
static mut np: u64 = 0

fn reset() {
    st = ST_PLAIN
}

fn arrow(fin: u64, ctrl: bool) -> u64 {
    if fin == 65 {
        return UP
    }
    if fin == 66 {
        return DOWN
    }
    if fin == 67 {
        if ctrl {
            return WORD_RIGHT
        }
        return RIGHT
    }
    if fin == 68 {
        if ctrl {
            return WORD_LEFT
        }
        return LEFT
    }
    if fin == 72 {
        return HOME
    }
    if fin == 70 {
        return END
    }
    return NONE
}

fn tilde(n: u64) -> u64 {
    if n == 1 || n == 7 {
        return HOME
    }
    if n == 4 || n == 8 {
        return END
    }
    if n == 3 {
        return DEL
    }
    return NONE
}

fn csi_final(fin: u64) -> u64 {
    if fin == 126 {
        return tilde(p0)
    }
    return arrow(fin, np > 1 && p1 == MOD_CTRL)
}

fn feed(c: u64) -> u64 {
    if st == ST_ESC {
        if c == 27 {
            return NONE
        }
        if c == 91 {
            st = ST_CSI
            p0 = 0
            p1 = 0
            np = 0
            return NONE
        }
        if c == 79 {
            st = ST_SS3
            return NONE
        }
        st = ST_PLAIN
        return c
    }
    if st == ST_SS3 {
        st = ST_PLAIN
        return arrow(c, false)
    }
    if st == ST_CSI {
        if c >= 48 && c <= 57 {
            if np == 0 {
                np = 1
            }
            if np == 1 {
                p0 = (p0 * 10 + c - 48) % 10000
            } else if np == 2 {
                p1 = (p1 * 10 + c - 48) % 10000
            }
            return NONE
        }
        if c == 59 {
            if np == 0 {
                np = 1
            }
            np = np + 1
            return NONE
        }
        if c >= 64 && c <= 126 {
            st = ST_PLAIN
            return csi_final(c)
        }
        if c < 32 {
            st = ST_PLAIN
            return c
        }
        return NONE
    }
    if c == 27 {
        st = ST_ESC
        return NONE
    }
    return c
}
