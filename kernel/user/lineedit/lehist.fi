profile kernel

export { add, count, entry, MAX }

const MAX: u64 = 32
const SLOT: u64 = 256

static mut store: [u8; 8192] = [0 as u8; 8192]
static mut used: u64 = 0

fn slot_at(i: u64) -> u64 {
    return (&store[(i * SLOT) as usize]) as u64
}

fn same(a: u64, b: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if *((a + i) as *mut u8) != *((b + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return *((a + n) as *mut u8) == 0 as u8
}

fn add(p: u64, n0: u64) {
    var n: u64 = n0
    if n == 0 {
        return
    }
    if n >= SLOT {
        n = SLOT - 1
    }
    if used > 0 && same(slot_at(used - 1), p, n) {
        return
    }
    if used == MAX {
        var k: u64 = 0
        while k < (MAX - 1) * SLOT {
            store[k as usize] = store[(k + SLOT) as usize]
            k = k + 1
        }
        used = MAX - 1
    }
    let d: u64 = slot_at(used)
    var i: u64 = 0
    while i < n {
        *((d + i) as *mut u8) = *((p + i) as *mut u8)
        i = i + 1
    }
    *((d + n) as *mut u8) = 0 as u8
    used = used + 1
}

fn count() -> u64 {
    return used
}

fn entry(age: u64) -> u64 {
    if age >= used {
        return 0
    }
    return slot_at(used - 1 - age)
}
