// SPDX-License-Identifier: GPL-2.0-only
import libc.octets

profile kernel

export { cells, prev, next, word_left, word_right, insert, remove, copy }

fn is_cont(b: u64) -> bool {
    return b >= 128 && b <= 191
}

fn cells(p: u64, from: u64, to: u64) -> u64 {
    var k: u64 = 0
    var i: u64 = from
    while i < to {
        if !is_cont(octets.ld8(p, i)) {
            k = k + 1
        }
        i = i + 1
    }
    return k
}

fn prev(p: u64, pos: u64) -> u64 {
    var i: u64 = pos
    if i == 0 {
        return 0
    }
    i = i - 1
    while i > 0 && is_cont(octets.ld8(p, i)) {
        i = i - 1
    }
    return i
}

fn next(p: u64, len: u64, pos: u64) -> u64 {
    if pos >= len {
        return len
    }
    var i: u64 = pos + 1
    while i < len && is_cont(octets.ld8(p, i)) {
        i = i + 1
    }
    return i
}

fn is_space(b: u64) -> bool {
    return b == 32 || b == 9
}

fn word_left(p: u64, pos: u64) -> u64 {
    var i: u64 = pos
    while i > 0 && is_space(octets.ld8(p, i - 1)) {
        i = i - 1
    }
    while i > 0 && !is_space(octets.ld8(p, i - 1)) {
        i = i - 1
    }
    return i
}

fn word_right(p: u64, len: u64, pos: u64) -> u64 {
    var i: u64 = pos
    while i < len && is_space(octets.ld8(p, i)) {
        i = i + 1
    }
    while i < len && !is_space(octets.ld8(p, i)) {
        i = i + 1
    }
    return i
}

fn insert(p: u64, len: u64, max: u64, pos: u64, b: u64) -> bool {
    if len + 1 >= max || pos > len {
        return false
    }
    var i: u64 = len
    while i > pos {
        *((p + i) as *mut u8) = *((p + i - 1) as *mut u8)
        i = i - 1
    }
    *((p + pos) as *mut u8) = b as u8
    *((p + len + 1) as *mut u8) = 0 as u8
    return true
}

fn remove(p: u64, len: u64, from: u64, to: u64) -> u64 {
    if to <= from || to > len {
        return len
    }
    let gap: u64 = to - from
    var i: u64 = from
    while i + gap < len {
        *((p + i) as *mut u8) = *((p + i + gap) as *mut u8)
        i = i + 1
    }
    *((p + len - gap) as *mut u8) = 0 as u8
    return len - gap
}

fn copy(dst: u64, src: u64, max: u64) -> u64 {
    var n: u64 = 0
    while n + 1 < max && *((src + n) as *mut u8) != 0 as u8 {
        *((dst + n) as *mut u8) = *((src + n) as *mut u8)
        n = n + 1
    }
    *((dst + n) as *mut u8) = 0 as u8
    return n
}
