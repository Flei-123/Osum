profile kernel

import ulib

export { raw_on, raw_off, cols }

const SYS_IOCTL: u64 = 16
const TCGETS: u64 = 0x5401
const TCSETS: u64 = 0x5402
const TIOCGWINSZ: u64 = 0x5413
const ISIG: u64 = 1
const ICANON: u64 = 2
const ECHO: u64 = 8
const ECHOWIN: u64 = 0x20000000
const LFLAG_AT: u64 = 12
const CC_AT: u64 = 17
const VTIME: u64 = 5
const VMIN: u64 = 6
const DEFAULT_COLS: u64 = 80

static mut saved: [u8; 40] = [0 as u8; 40]
static mut raw: [u8; 40] = [0 as u8; 40]

fn raw_on(fd: u64) -> bool {
    let s: u64 = (&saved[0 as usize]) as u64
    if ulib.bad(ulib.sys(SYS_IOCTL, fd, TCGETS, s)) {
        return false
    }
    var i: u64 = 0
    while i < 40 {
        raw[i as usize] = saved[i as usize]
        i = i + 1
    }
    let r: u64 = (&raw[0 as usize]) as u64
    var lf: u64 = __mmio_read32((r + LFLAG_AT) as *mut u32) as u64
    lf = lf & (0xFFFFFFFF - (ISIG | ICANON | ECHO | ECHOWIN))
    __mmio_write32((r + LFLAG_AT) as *mut u32, lf as u32)
    raw[(CC_AT + VMIN) as usize] = 1 as u8
    raw[(CC_AT + VTIME) as usize] = 0 as u8
    return !ulib.bad(ulib.sys(SYS_IOCTL, fd, TCSETS, r))
}

fn raw_off(fd: u64) {
    ulib.sys(SYS_IOCTL, fd, TCSETS, (&saved[0 as usize]) as u64)
}

fn cols(fd: u64) -> u64 {
    var ws: [u8; 8] = [0 as u8; 8]
    if ulib.bad(ulib.sys(SYS_IOCTL, fd, TIOCGWINSZ, (&ws[0 as usize]) as u64)) {
        return DEFAULT_COLS
    }
    let c: u64 = (ws[2 as usize] as u64) | ((ws[3 as usize] as u64) << 8)
    if c < 8 || c > 1000 {
        return DEFAULT_COLS
    }
    return c
}
