profile kernel

import ulib
import dcrypt

export {
    crypt_begin, crypt_end, crypt_off, crypt_active,
    BS, ALIGNMENT, ESP_DEFAULT,
    read_at, write_at, is_ofs, grow, grow_begin, grow_step, grow_position, copy_begin, copy_step, copy_position, fail_with,
    COPY_MORE, COPY_DONE, COPY_ERROR, GROW_MORE, GROW_DONE, GROW_ERROR, F_ABORT, F_TIMEOUT, copy_file, files_equal, kernel_source,
    gpt_write, bios_load, bios_present, fat32_create, copy_root, copy_root_from,
    plan_esp_start, plan_esp_end, plan_ofs_start, plan_ofs_end,
    plan_fits, check_source,
    step_nr, step_count, progress_permille, error_at, rewritten,
    F_NONE, F_OPEN, F_READ, F_WRITE, F_NO_OFS, F_SMALL, F_MAP, F_NO_KERNEL, kernel_ready,
    S_GPT, S_ESP, S_COPY, S_GROW, S_BOOT, S_DONE
}

const S_GPT: u64 = 1
const S_ESP: u64 = 2
const S_COPY: u64 = 3
const S_GROW: u64 = 4
const S_BOOT: u64 = 5
const S_DONE: u64 = 6

const F_NONE: u64 = 0
const F_OPEN: u64 = 1
const F_READ: u64 = 2
const F_WRITE: u64 = 3
const F_NO_OFS: u64 = 4
const F_SMALL: u64 = 5
const F_MAP: u64 = 6
const F_ABORT: u64 = 7
const F_TIMEOUT: u64 = 8
const F_NO_KERNEL: u64 = 9

const COPY_MORE: u64 = 0
const COPY_DONE: u64 = 1
const COPY_ERROR: u64 = 2
const GROW_MORE: u64 = 0
const GROW_DONE: u64 = 1
const GROW_ERROR: u64 = 2

static mut st_step: u64 = 0
static mut st_permille: u64 = 0
static mut st_error: u64 = 0

fn step_nr() -> u64 {
    return st_step
}

fn step_count() -> u64 {
    return S_DONE
}

fn progress_permille() -> u64 {
    return st_permille
}

fn error_at() -> u64 {
    return st_error
}

fn fail_with(code: u64) {
    st_error = code
}

static mut SECTOR_BUF: [u8; 512] = [0 as u8; 512]
static mut SECTOR_BUF2: [u8; 512] = [0 as u8; 512]
static mut COPY_BUF: [u8; 8192] = [0 as u8; 8192]

static mut COPY_BUF2: [u8; 8192] = [0 as u8; 8192]

const BIOSMAX: u64 = 32768
static mut BIOSBIN: [u8; 32768] = [0 as u8; 32768]
static mut bios_n: u64 = 0
static mut p_bios_hdd: [u8; 22] = "/boot/limine-hdd.bin\0\0"
static mut g_entries: u64 = 128
static mut g_entsect: u64 = 32

const BS: u64 = 512

const ALIGNMENT: u64 = 2048

const ENTRIES: u64 = 128
const ENTSIZE: u64 = 128
const ENTSECT: u64 = 32
const ESP_DEFAULT: u64 = 70000

fn p8(at: u64, v: u64) {
    __mmio_write8((at) as *mut u8, v as u8)
}

fn g8(at: u64) -> u64 {
    return (*((at) as *mut u8)) as u64
}

fn p16(at: u64, v: u64) {
    p8(at, v & 255)
    p8(at + 1, (v >> 8) & 255)
}

fn p32(at: u64, v: u64) {
    p8(at, v & 255)
    p8(at + 1, (v >> 8) & 255)
    p8(at + 2, (v >> 16) & 255)
    p8(at + 3, (v >> 24) & 255)
}

fn p64(at: u64, v: u64) {
    p32(at, v & 0xFFFFFFFF)
    p32(at + 4, (v >> 32) & 0xFFFFFFFF)
}

fn g32(at: u64) -> u64 {
    return g8(at) | (g8(at + 1) << 8) | (g8(at + 2) << 16) | (g8(at + 3) << 24)
}

fn g64(at: u64) -> u64 {
    return g32(at) | (g32(at + 4) << 32)
}

fn zero_fill(at: u64, n: u64) {
    ulib.fill(at, 0, n)
}

fn crc_start() -> u64 {
    return 0xFFFFFFFF
}

fn crc_feed(seed: u64, p: u64, len: u64) -> u64 {
    var crc: u64 = seed
    var i: u64 = 0
    while i < len {
        crc = crc ^ g8(p + i)
        var k: u64 = 0
        while k < 8 {
            let mask: u64 = 0 -% (crc & 1)
            crc = (crc >> 1) ^ (0xEDB88320 & mask)
            k = k + 1
        }
        i = i + 1
    }
    return crc
}

fn crc_end(seed: u64) -> u64 {
    return (seed ^ 0xFFFFFFFF) & 0xFFFFFFFF
}

fn crc_of(p: u64, len: u64) -> u64 {
    return crc_end(crc_feed(crc_start(), p, len))
}

fn raw_read(fd: u64, lba: u64, at: u64, n: u64) -> bool {
    let w: u64 = ulib.sys(ulib.SYS_SEEK, fd, lba * BS, ulib.SEEK_SET)
    if ulib.bad(w) {
        st_error = F_READ
        return false
    }
    var got: u64 = 0
    while got < n {
        let r: u64 = ulib.sys(ulib.SYS_READ, fd, at + got, n - got)
        if ulib.bad(r) || r == 0 {
            st_error = F_READ
            return false
        }
        got = got + r
    }
    return true
}

fn raw_write(fd: u64, lba: u64, at: u64, n: u64) -> bool {
    let w: u64 = ulib.sys(ulib.SYS_SEEK, fd, lba * BS, ulib.SEEK_SET)
    if ulib.bad(w) {
        st_error = F_WRITE
        return false
    }
    var done: u64 = 0
    while done < n {
        let r: u64 = ulib.sys(ulib.SYS_WRITE, fd, at + done, n - done)
        if ulib.bad(r) || r == 0 {
            st_error = F_WRITE
            return false
        }
        done = done + r
    }
    return true
}

static mut cry_on: u64 = 0
static mut cry_data: u64 = 0
static mut cry_end: u64 = 0
static mut CRYSC: [u8; 8192] = [0 as u8; 8192]

fn crypt_active() -> bool {
    return cry_on == 1
}

fn crypt_off() -> u64 {
    if cry_on == 1 {
        return dcrypt.HDR_SECTORS
    }
    return 0
}

fn crypt_end() {
    cry_on = 0
}

fn crypt_begin(fd: u64, start: u64, count: u64, pw: u64, pwlen: u64) -> bool {
    if !dcrypt.setup(pw, pwlen, dcrypt.DEF_T, dcrypt.DEF_M, dcrypt.DEF_P, count) {
        st_error = F_WRITE
        return false
    }
    if !dcrypt.verify_pass(pw, pwlen) {
        st_error = F_WRITE
        return false
    }
    if !raw_write(fd, start, dcrypt.header_ptr(), dcrypt.HDR_SECTORS * BS) {
        return false
    }
    cry_data = start + dcrypt.HDR_SECTORS
    cry_end = start + count
    cry_on = 1
    return true
}

fn read_at(fd: u64, lba: u64, at: u64, n: u64) -> bool {
    if cry_on == 1 && lba >= cry_data && lba < cry_end {
        let sc: u64 = (&CRYSC[0 as usize]) as u64
        var done: u64 = 0
        while done < n {
            var c: u64 = n - done
            if c > 8192 {
                c = 8192
            }
            if !raw_read(fd, lba + done / BS, sc, c) {
                return false
            }
            if !dcrypt.dec_sectors(lba + done / BS - cry_data, sc, at + done, c / BS) {
                st_error = F_READ
                return false
            }
            done = done + c
        }
        return true
    }
    return raw_read(fd, lba, at, n)
}

fn write_at(fd: u64, lba: u64, at: u64, n: u64) -> bool {
    if cry_on == 1 && lba >= cry_data && lba < cry_end {
        let sc: u64 = (&CRYSC[0 as usize]) as u64
        var done: u64 = 0
        while done < n {
            var c: u64 = n - done
            if c > 8192 {
                c = 8192
            }
            if !dcrypt.enc_sectors(lba + done / BS - cry_data, at + done, sc, c / BS) {
                st_error = F_WRITE
                return false
            }
            if !raw_write(fd, lba + done / BS, sc, c) {
                return false
            }
            done = done + c
        }
        return true
    }
    return raw_write(fd, lba, at, n)
}

fn bytes_equal(p: u64, q: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if g8(p + i) != g8(q + i) {
            return false
        }
        i = i + 1
    }
    return true
}

static mut st_rewritten: u64 = 0
fn rewritten() -> u64 {
    return st_rewritten
}

fn write_checked(fd: u64, lba: u64, at: u64, n: u64) -> bool {
    let rb: u64 = (&COPY_BUF2[0 as usize]) as u64
    var attempt: u64 = 0
    while attempt < 5 {
        if !write_at(fd, lba, at, n) {
            return false
        }
        if n <= 8192 && read_at(fd, lba, rb, n) && bytes_equal(at, rb, n) {
            return true
        }
        if n > 8192 {
            return true
        }
        st_rewritten = st_rewritten + 1
        attempt = attempt + 1
    }
    st_error = F_WRITE
    return false
}

fn guid_esp(at: u64) {
    p8(at + 0, 0x28)
    p8(at + 1, 0x73)
    p8(at + 2, 0x2A)
    p8(at + 3, 0xC1)
    p8(at + 4, 0x1F)
    p8(at + 5, 0xF8)
    p8(at + 6, 0xD2)
    p8(at + 7, 0x11)
    p8(at + 8, 0xBA)
    p8(at + 9, 0x4B)
    p8(at + 10, 0x00)
    p8(at + 11, 0xA0)
    p8(at + 12, 0xC9)
    p8(at + 13, 0x3E)
    p8(at + 14, 0xC9)
    p8(at + 15, 0x3B)
}

fn guid_ofs(at: u64) {
    p8(at + 0, 0x4D)
    p8(at + 1, 0x55)
    p8(at + 2, 0x53)
    p8(at + 3, 0x4F)
    p8(at + 4, 0x46)
    p8(at + 5, 0x4F)
    p8(at + 6, 0x01)
    p8(at + 7, 0x53)
    p8(at + 8, 0x8E)
    p8(at + 9, 0x75)
    p8(at + 10, 0x6D)
    p8(at + 11, 0x6F)
    p8(at + 12, 0x72)
    p8(at + 13, 0x69)
    p8(at + 14, 0x4F)
    p8(at + 15, 0x53)
}

fn guid_own(at: u64, nr: u64) {
    guid_ofs(at)
    p8(at + 6, 0x40 | (nr & 15))
    p32(at + 12, 0x53464F00 | nr)
}

fn table_sector(nr: u64, esp_start: u64, esp_end: u64, ofs_start: u64,
    ofs_end: u64) {
    let p: u64 = (&SECTOR_BUF2[0 as usize]) as u64
    zero_fill(p, BS)
    if nr != 0 {
        return
    }

    guid_esp(p + 0)
    guid_own(p + 16, 1)
    p64(p + 32, esp_start)
    p64(p + 40, esp_end)
    p64(p + 48, 0)

    p16(p + 56, 69)
    p16(p + 58, 70)
    p16(p + 60, 73)

    guid_ofs(p + 128)
    guid_own(p + 144, 2)
    p64(p + 160, ofs_start)
    p64(p + 168, ofs_end)
    p64(p + 176, 0)

    p16(p + 184, 79)
    p16(p + 186, 83)
    p16(p + 188, 85)
    p16(p + 190, 77)
}

fn table_crc(esp_start: u64, esp_end: u64, ofs_start: u64,
    ofs_end: u64) -> u64 {
    var c: u64 = crc_start()
    var i: u64 = 0
    while i < g_entsect {
        table_sector(i, esp_start, esp_end, ofs_start, ofs_end)
        c = crc_feed(c, (&SECTOR_BUF2[0 as usize]) as u64, BS)
        i = i + 1
    }
    return crc_end(c)
}

fn header(at: u64, mine: u64, other: u64, table: u64, first_block: u64,
    last_block: u64, tcrc: u64) {
    zero_fill(at, BS)
    p8(at + 0, 69)
    p8(at + 1, 70)
    p8(at + 2, 73)
    p8(at + 3, 32)
    p8(at + 4, 80)
    p8(at + 5, 65)
    p8(at + 6, 82)
    p8(at + 7, 84)
    p32(at + 8, 0x00010000)
    p32(at + 12, 92)
    p32(at + 16, 0)
    p32(at + 20, 0)
    p64(at + 24, mine)
    p64(at + 32, other)
    p64(at + 40, first_block)
    p64(at + 48, last_block)
    guid_own(at + 56, 3)
    p64(at + 72, table)
    p32(at + 80, g_entries)
    p32(at + 84, ENTSIZE)
    p32(at + 88, tcrc)

    p32(at + 16, crc_of(at, 92))
}

fn fat_size(total_size: u64, reserved: u64, spc: u64, nfat: u64) -> u64 {
    let t1: u64 = total_size - reserved
    let t2: u64 = (256 * spc + nfat) / 2
    return (t1 + t2 - 1) / t2
}

fn fat32_create(fd: u64, start: u64, total_size: u64) -> bool {
    let spc: u64 = 1
    let reserved: u64 = 32
    let nfat: u64 = 2
    let fatsz: u64 = fat_size(total_size, reserved, spc, nfat)
    let p: u64 = (&SECTOR_BUF[0 as usize]) as u64
    zero_fill(p, BS)
    p8(p + 0, 0xEB)
    p8(p + 1, 0x58)
    p8(p + 2, 0x90)

    p8(p + 3, 77)
    p8(p + 4, 83)
    p8(p + 5, 87)
    p8(p + 6, 73)
    p8(p + 7, 78)
    p8(p + 8, 52)
    p8(p + 9, 46)
    p8(p + 10, 49)
    p16(p + 11, BS)
    p8(p + 13, spc)
    p16(p + 14, reserved)
    p8(p + 16, nfat)
    p16(p + 17, 0)
    p16(p + 19, 0)
    p8(p + 21, 0xF8)
    p16(p + 22, 0)
    p16(p + 24, 32)
    p16(p + 26, 8)
    p32(p + 28, start)
    p32(p + 32, total_size)
    p32(p + 36, fatsz)
    p16(p + 40, 0)
    p16(p + 42, 0)
    p32(p + 44, 2)
    p16(p + 48, 1)
    p16(p + 50, 6)
    p8(p + 64, 0x80)
    p8(p + 66, 0x29)
    p32(p + 67, 0x4F53554D)

    p8(p + 71, 79)
    p8(p + 72, 83)
    p8(p + 73, 85)
    p8(p + 74, 77)
    p8(p + 75, 32)
    p8(p + 76, 69)
    p8(p + 77, 70)
    p8(p + 78, 73)
    p8(p + 79, 32)
    p8(p + 80, 32)
    p8(p + 81, 32)

    p8(p + 82, 70)
    p8(p + 83, 65)
    p8(p + 84, 84)
    p8(p + 85, 51)
    p8(p + 86, 50)
    p8(p + 87, 32)
    p8(p + 88, 32)
    p8(p + 89, 32)
    p8(p + 510, 0x55)
    p8(p + 511, 0xAA)
    if !write_at(fd, start, p, BS) {
        return false
    }
    if !write_at(fd, start + 6, p, BS) {
        return false
    }

    let data: u64 = reserved + nfat * fatsz
    let volumes: u64 = (total_size - data) / spc
    zero_fill(p, BS)
    p32(p + 0, 0x41615252)
    p32(p + 484, 0x61417272)
    p32(p + 488, volumes - 1)
    p32(p + 492, 3)
    p8(p + 510, 0x55)
    p8(p + 511, 0xAA)
    if !write_at(fd, start + 1, p, BS) {
        return false
    }
    if !write_at(fd, start + 7, p, BS) {
        return false
    }

    var f: u64 = 0
    while f < nfat {
        let fatlba: u64 = start + reserved + f * fatsz
        zero_fill(p, BS)
        p32(p + 0, 0x0FFFFFF8)
        p32(p + 4, 0x0FFFFFFF)
        p32(p + 8, 0x0FFFFFFF)
        if !write_at(fd, fatlba, p, BS) {
            return false
        }
        zero_fill(p, BS)
        var k: u64 = 1
        while k < fatsz {
            if !write_at(fd, fatlba + k, p, BS) {
                return false
            }
            k = k + 1
        }
        f = f + 1
    }

    zero_fill(p, BS)
    p8(p + 0, 79)
    p8(p + 1, 83)
    p8(p + 2, 85)
    p8(p + 3, 77)
    p8(p + 4, 32)
    p8(p + 5, 69)
    p8(p + 6, 70)
    p8(p + 7, 73)
    p8(p + 8, 32)
    p8(p + 9, 32)
    p8(p + 10, 32)
    p8(p + 11, 0x08)
    if !write_at(fd, start + data, p, BS) {
        return false
    }
    zero_fill(p, BS)
    var c: u64 = 1
    while c < spc {
        if !write_at(fd, start + data + c, p, BS) {
            return false
        }
        c = c + 1
    }
    return true
}

const SB_MAGIC: u64 = 0
const SB_BLOCKS: u64 = 16
const SB_INODES: u64 = 24
const SB_BITMAP: u64 = 32
const SB_ITABLE: u64 = 40
const SB_DATA: u64 = 48
const SB_BITBLOCKS: u64 = 72
const MAGIC_LO: u64 = 0x2D4F4653
const MAGIC_HI: u64 = 0x4F53554D

fn is_ofs(at: u64) -> bool {
    return g32(at + SB_MAGIC) == MAGIC_LO && g32(at + SB_MAGIC + 4) == MAGIC_HI
}

static mut gr_fd: u64 = 0
static mut gr_start: u64 = 0
static mut gr_pos: u64 = 0
static mut gr_from: u64 = 0
static mut gr_to: u64 = 0

fn grow_begin(fd: u64, start: u64, new_size: u64) -> u64 {
    let p: u64 = (&SECTOR_BUF[0 as usize]) as u64
    if !read_at(fd, start, p, BS) {
        return 0
    }
    if !is_ofs(p) {
        return 0
    }
    let old_blocks: u64 = g64(p + SB_BLOCKS)
    var map_blocks: u64 = g64(p + SB_BITBLOCKS)
    if map_blocks == 0 {
        map_blocks = 1
    }
    let covers: u64 = map_blocks * BS * 8
    var dest_buf: u64 = new_size
    if dest_buf > covers {
        dest_buf = covers
    }
    gr_fd = fd
    gr_start = start
    gr_from = old_blocks
    gr_pos = old_blocks
    gr_to = old_blocks
    if dest_buf <= old_blocks {
        return old_blocks
    }
    p64(p + SB_BLOCKS, dest_buf)
    if !write_at(fd, start, p, BS) {
        return 0
    }
    gr_to = dest_buf
    return dest_buf
}

fn grow_step(max_maps: u64) -> u64 {
    let p: u64 = (&SECTOR_BUF[0 as usize]) as u64
    var maps: u64 = 0
    while gr_pos < gr_to && maps < max_maps {
        let kb: u64 = 1 + gr_pos / (BS * 8)
        if !read_at(gr_fd, gr_start + kb, p, BS) {
            return GROW_ERROR
        }
        var end_pos: u64 = kb * BS * 8
        if end_pos > gr_to {
            end_pos = gr_to
        }
        while gr_pos < end_pos {
            let bit: u64 = gr_pos % (BS * 8)
            let at: u64 = p + bit / 8
            p8(at, g8(at) & (255 ^ (1 << (bit % 8))))
            gr_pos = gr_pos + 1
        }
        if !write_at(gr_fd, gr_start + kb, p, BS) {
            return GROW_ERROR
        }
        maps = maps + 1
    }
    if gr_to > gr_from {
        st_permille = ((gr_pos - gr_from) * 1000) / (gr_to - gr_from)
    }
    if gr_pos >= gr_to {
        return GROW_DONE
    }
    return GROW_MORE
}

fn grow_position() -> u64 {
    return gr_pos
}

fn grow(fd: u64, start: u64, new_size: u64) -> u64 {
    let dest_buf: u64 = grow_begin(fd, start, new_size)
    if dest_buf == 0 {
        return 0
    }
    while true {
        let r: u64 = grow_step(64)
        if r == GROW_ERROR {
            return 0
        }
        if r == GROW_DONE {
            break
        }
    }
    return dest_buf
}

static mut p_ksrc_boot: [u8; 16] = "/boot/osum.mb\0\0\0"
static mut p_ksrc_src: [u8; 20] = "/bootsrc/osum.mb\0\0\0\0"
static mut p_ksrc_mnt: [u8; 10] = "/bootsrc\0\0"
static mut p_ksrc_vfat: [u8; 6] = "vfat\0\0"
static mut p_ksrc_d0: [u8; 10] = "/dev/hda1\0"
static mut p_ksrc_d1: [u8; 10] = "/dev/sda1\0"
static mut p_ksrc_d2: [u8; 10] = "/dev/hdb1\0"
static mut p_ksrc_d3: [u8; 10] = "/dev/sdb1\0"
static mut p_ksrc_d4: [u8; 12] = "/dev/nvme01\0"
static mut p_ksrc_d5: [u8; 10] = "/dev/usb1\0"

fn ksrc_try(dev: u64) -> bool {
    let m: u64 = ulib.sys4(ulib.SYS_VMOUNT, dev,
        (&p_ksrc_mnt[0 as usize]) as u64, (&p_ksrc_vfat[0 as usize]) as u64, ulib.MNT_RDONLY)
    if ulib.bad(m) {
        return false
    }
    let b: u64 = ulib.sys(ulib.SYS_OPEN, (&p_ksrc_src[0 as usize]) as u64, 0, 0)
    if !ulib.bad(b) {
        ulib.sys(ulib.SYS_CLOSE, b, 0, 0)
        return true
    }
    ulib.sys(ulib.SYS_UMOUNT2, (&p_ksrc_mnt[0 as usize]) as u64, 0, 0)
    return false
}

fn kernel_source() -> u64 {
    let a: u64 = ulib.sys(ulib.SYS_OPEN, (&p_ksrc_boot[0 as usize]) as u64, 0, 0)
    if !ulib.bad(a) {
        ulib.sys(ulib.SYS_CLOSE, a, 0, 0)
        return (&p_ksrc_boot[0 as usize]) as u64
    }
    let mounted: u64 = ulib.sys(ulib.SYS_OPEN, (&p_ksrc_src[0 as usize]) as u64, 0, 0)
    if !ulib.bad(mounted) {
        ulib.sys(ulib.SYS_CLOSE, mounted, 0, 0)
        return (&p_ksrc_src[0 as usize]) as u64
    }
    ulib.sys(ulib.SYS_MKDIR, (&p_ksrc_mnt[0 as usize]) as u64, 0, 0)
    if ksrc_try((&p_ksrc_d0[0 as usize]) as u64) || ksrc_try((&p_ksrc_d1[0 as usize]) as u64)
        || ksrc_try((&p_ksrc_d2[0 as usize]) as u64) || ksrc_try((&p_ksrc_d3[0 as usize]) as u64)
        || ksrc_try((&p_ksrc_d4[0 as usize]) as u64) || ksrc_try((&p_ksrc_d5[0 as usize]) as u64) {
        return (&p_ksrc_src[0 as usize]) as u64
    }
    return (&p_ksrc_boot[0 as usize]) as u64
}

fn kernel_ready() -> bool {
    let path: u64 = kernel_source()
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, 0, 0)
    if ulib.bad(fd) {
        fail_with(F_NO_KERNEL)
        return false
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.size_of(path) == 0 {
        fail_with(F_NO_KERNEL)
        return false
    }
    return true
}

fn copy_file(src_path: u64, move_to: u64) -> bool {
    var attempt: u64 = 0
    while attempt < 3 {
        if !copy_file_once(src_path, move_to) {
            return false
        }
        if files_equal(src_path, move_to) {
            return true
        }
        st_rewritten = st_rewritten + 1
        attempt = attempt + 1
    }
    return false
}

fn files_equal(src_path: u64, dst_path: u64) -> bool {
    let a: u64 = ulib.sys(ulib.SYS_OPEN, src_path, 0, 0)
    if ulib.bad(a) {
        return false
    }
    let b: u64 = ulib.sys(ulib.SYS_OPEN, dst_path, 0, 0)
    if ulib.bad(b) {
        ulib.sys(ulib.SYS_CLOSE, a, 0, 0)
        return false
    }
    let pa: u64 = (&COPY_BUF[0 as usize]) as u64
    let pb: u64 = (&COPY_BUF2[0 as usize]) as u64
    var succeeded: bool = true
    var keep_going: bool = true
    while keep_going {
        let n: u64 = ulib.sys(ulib.SYS_READ, a, pa, 8192)
        if ulib.bad(n) {
            succeeded = false
            keep_going = false
        } else if n == 0 {
            let m0: u64 = ulib.sys(ulib.SYS_READ, b, pb, 1)
            if ulib.bad(m0) || m0 != 0 {
                succeeded = false
            }
            keep_going = false
        } else {
            var m: u64 = 0
            while m < n {
                let r: u64 = ulib.sys(ulib.SYS_READ, b, pb + m, n - m)
                if ulib.bad(r) || r == 0 {
                    m = n + 1
                } else {
                    m = m + r
                }
            }
            if m != n || !bytes_equal(pa, pb, n) {
                succeeded = false
                keep_going = false
            }
        }
    }
    ulib.sys(ulib.SYS_CLOSE, a, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, b, 0, 0)
    return succeeded
}

fn copy_file_once(src_path: u64, move_to: u64) -> bool {
    let a: u64 = ulib.sys(ulib.SYS_OPEN, src_path, 0, 0)
    if ulib.bad(a) {
        return false
    }
    ulib.sys(ulib.SYS_UNLINK, move_to, 0, 0)
    let b: u64 = ulib.sys(ulib.SYS_OPEN, move_to, ulib.O_MAKE, 0)
    if ulib.bad(b) {
        ulib.sys(ulib.SYS_CLOSE, a, 0, 0)
        return false
    }
    let buffer: u64 = (&COPY_BUF[0 as usize]) as u64
    var succeeded: bool = true
    var keep_going: bool = true
    while keep_going {
        let n: u64 = ulib.sys(ulib.SYS_READ, a, buffer, 8192)
        if ulib.bad(n) || n == 0 {
            keep_going = false
        } else {

            var off: u64 = 0
            while off < n {
                let w: u64 = ulib.sys(ulib.SYS_WRITE, b, buffer + off, n - off)
                if ulib.bad(w) || w == 0 {
                    succeeded = false
                    keep_going = false
                    off = n
                } else {
                    off = off + w
                }
            }
        }
    }
    ulib.sys(ulib.SYS_CLOSE, a, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, b, 0, 0)
    return succeeded
}

fn plan_esp_start() -> u64 {
    return ALIGNMENT
}

fn plan_esp_end(esp_sector: u64) -> u64 {
    return ALIGNMENT + esp_sector - 1
}

fn plan_ofs_start(esp_sector: u64) -> u64 {
    return plan_esp_end(esp_sector) + 1
}

fn plan_ofs_end(sect_count: u64) -> u64 {
    return sect_count - 34
}

fn plan_fits(sect_count: u64, esp_sector: u64) -> bool {
    if sect_count < ALIGNMENT + esp_sector + 4096 {
        st_error = F_SMALL
        return false
    }
    return true
}

fn bios_load() -> bool {
    bios_n = 0
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_bios_hdd[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return false
    }
    let buf: u64 = (&BIOSBIN[0 as usize]) as u64
    var n: u64 = 0
    var keep_going: bool = true
    while keep_going && n < BIOSMAX {
        let r: u64 = ulib.sys(ulib.SYS_READ, fd, buf + n, BIOSMAX - n)
        if ulib.bad(r) || r == 0 {
            keep_going = false
        } else {
            n = n + r
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)

    if n < 2048 || n >= BIOSMAX {
        return false
    }
    if g8(buf + 510) != 0x55 || g8(buf + 511) != 0xAA {
        return false
    }
    bios_n = n
    return true
}

fn bios_present() -> bool {
    return bios_n != 0
}

fn gpt_write(dst_fd: u64, sect_count: u64, esp_sector: u64) -> bool {
    st_step = S_GPT
    let first_block: u64 = 2 + ENTSECT
    let last_block: u64 = plan_ofs_end(sect_count)
    let esp_start: u64 = plan_esp_start()
    let esp_end: u64 = plan_esp_end(esp_sector)
    let ofs_start: u64 = plan_ofs_start(esp_sector)
    let ofs_end: u64 = last_block

    var s2_size: u64 = 0
    var size_a: u64 = 0
    var size_b: u64 = 0
    var loc_a: u64 = 0
    var loc_b: u64 = 0
    g_entries = ENTRIES
    g_entsect = ENTSECT
    if bios_n != 0 {
        s2_size = bios_n - 512
        let sects: u64 = (s2_size + 511) / 512
        size_a = (sects / 2) * 512
        if sects % 2 != 0 {
            size_a = size_a + 512
        }
        size_b = (sects / 2) * 512
        loc_a = 2 + ENTSECT - size_a / 512
        loc_b = sect_count - 33 + ENTSECT - size_b / 512

        g_entsect = loc_a - 2
        g_entries = g_entsect * (BS / ENTSIZE)
        if g_entsect < 2 || size_a / 512 + 2 > ENTSECT {
            bios_n = 0
            g_entries = ENTRIES
            g_entsect = ENTSECT
        }
    }

    let tcrc: u64 = table_crc(esp_start, esp_end, ofs_start, ofs_end)
    var k: u64 = 0
    while k < g_entsect {
        table_sector(k, esp_start, esp_end, ofs_start, ofs_end)
        let q: u64 = (&SECTOR_BUF2[0 as usize]) as u64
        if !write_at(dst_fd, 2 + k, q, BS) {
            return false
        }
        if !write_at(dst_fd, sect_count - 33 + k, q, BS) {
            return false
        }
        k = k + 1
    }
    let p: u64 = (&SECTOR_BUF[0 as usize]) as u64
    header(p, 1, sect_count - 1, 2, first_block, last_block, tcrc)
    if !write_at(dst_fd, 1, p, BS) {
        return false
    }
    header(p, sect_count - 1, 1, sect_count - 33, first_block, last_block, tcrc)
    if !write_at(dst_fd, sect_count - 1, p, BS) {
        return false
    }

    if bios_n != 0 {
        let b: u64 = (&BIOSBIN[0 as usize]) as u64
        var i: u64 = 0
        while i < size_a / 512 {
            if !write_at(dst_fd, loc_a + i, b + 512 + i * 512, BS) {
                return false
            }
            i = i + 1
        }

        let rest_b: u64 = s2_size - size_a
        var j: u64 = 0
        while j * 512 < rest_b {
            let q: u64 = (&SECTOR_BUF2[0 as usize]) as u64
            zero_fill(q, BS)
            var m: u64 = rest_b - j * 512
            if m > 512 {
                m = 512
            }
            var t: u64 = 0
            while t < m {
                p8(q + t, g8(b + 512 + size_a + j * 512 + t))
                t = t + 1
            }
            if !write_at(dst_fd, loc_b + j, q, BS) {
                return false
            }
            j = j + 1
        }
    }

    zero_fill(p, BS)
    if bios_n != 0 {
        let b: u64 = (&BIOSBIN[0 as usize]) as u64
        var c: u64 = 0
        while c < 512 {
            p8(p + c, g8(b + c))
            c = c + 1
        }

        p16(p + 0x1a4, size_a)
        p16(p + 0x1a4 + 2, size_b)
        p64(p + 0x1a4 + 4, loc_a * BS)
        p64(p + 0x1a4 + 12, loc_b * BS)

        var z: u64 = 440
        while z < 510 {
            p8(p + z, 0)
            z = z + 1
        }
        p32(p + 218, 0)
        p16(p + 222, 0)
    }
    p8(p + 446 + 1, 0x00)
    p8(p + 446 + 2, 0x02)
    p8(p + 446 + 3, 0x00)
    p8(p + 446 + 4, 0xEE)
    p8(p + 446 + 5, 0xFF)
    p8(p + 446 + 6, 0xFF)
    p8(p + 446 + 7, 0xFF)
    p32(p + 446 + 8, 1)
    var rest: u64 = sect_count - 1
    if rest > 0xFFFFFFFF {
        rest = 0xFFFFFFFF
    }
    p32(p + 446 + 12, rest)
    p8(p + 510, 0x55)
    p8(p + 511, 0xAA)
    if !write_at(dst_fd, 0, p, BS) {
        return false
    }
    return true
}

fn copy_root(dst_fd: u64, src_fd: u64, esp_sector: u64, src_sect: u64) -> bool {
    return copy_root_from(dst_fd, src_fd, plan_ofs_start(esp_sector), src_sect)
}

static mut cp_zfd: u64 = 0
static mut cp_qfd: u64 = 0
static mut cp_start: u64 = 0
static mut cp_total: u64 = 0
static mut cp_pos: u64 = 0

fn copy_begin(dst_fd: u64, src_fd: u64, ofs_start: u64, src_sect: u64) {
    st_step = S_COPY
    st_permille = 0
    cp_zfd = dst_fd
    cp_qfd = src_fd
    cp_start = ofs_start
    cp_total = src_sect
    cp_pos = 0
}

fn copy_step(max_chunks: u64) -> u64 {
    let buffer: u64 = (&COPY_BUF[0 as usize]) as u64
    let stride: u64 = 8192 / BS
    var chunks: u64 = 0
    while cp_pos < cp_total && chunks < max_chunks {
        var n: u64 = stride
        if cp_pos + n > cp_total {
            n = cp_total - cp_pos
        }
        if !read_at(cp_qfd, cp_pos, buffer, n * BS) {
            return COPY_ERROR
        }
        if !write_checked(cp_zfd, cp_start + cp_pos, buffer, n * BS) {
            return COPY_ERROR
        }
        cp_pos = cp_pos + n
        chunks = chunks + 1
    }
    if cp_total > 0 {
        st_permille = (cp_pos * 1000) / cp_total
    }
    if cp_pos >= cp_total {
        st_permille = 1000
        return COPY_DONE
    }
    return COPY_MORE
}

fn copy_position() -> u64 {
    return cp_pos
}

fn copy_root_from(dst_fd: u64, src_fd: u64, ofs_start: u64, src_sect: u64) -> bool {
    copy_begin(dst_fd, src_fd, ofs_start, src_sect)
    while true {
        let r: u64 = copy_step(256)
        if r == COPY_ERROR {
            return false
        }
        if r == COPY_DONE {
            break
        }
    }
    return true
}

fn check_source(src_fd: u64) -> u64 {
    let p: u64 = (&SECTOR_BUF[0 as usize]) as u64
    if !read_at(src_fd, 0, p, BS) {
        st_error = F_READ
        return 0
    }
    if !is_ofs(p) {
        st_error = F_NO_OFS
        return 0
    }
    var src_map_blocks: u64 = g64(p + SB_BITBLOCKS)
    if src_map_blocks == 0 {
        src_map_blocks = 1
    }
    return src_map_blocks
}
