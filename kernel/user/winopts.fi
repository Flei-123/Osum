// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/winopts.fi -- W-WINOPTS stage 1 (docs/APP-WINDOW-OPTS.md): WINDOW OPTIONS AND THE WINDOW'S OWN OPACITY, from ring 3.
//
// Started by the kernel word `wigapp=/bin/winopts` (tools/winopts/run.sh). Every result is one serial line `winopts: <name> <a> <b>`.
//
//   1. wlib.window_opts: frameless + keys + opacity 128 in ONE call -- the opacity reads back (WI_OPAC), the client area starts at
//      the window corner (WI_INX/WI_INY = 0), the default window of wlib.window keeps 255 and its frame
//   2. WS_OPAC: set 0, 255, 77 and read back; 256 and 2^32 are refused (E_INVALID = 4) and change nothing
//   3. an options word with an unknown bit is refused and makes no window
//   4. foreign windows: every handle number this program does not own is refused by WS_OPAC, and our two windows keep their values
//   5. after setuid(1000): L_TOP is still refused (E_RIGHTS = 2), L_NORMAL is allowed, window_opts and WS_OPAC still work
//
// Integer only, no heap; profile app because wlib pulls in the fUi libraries.

profile app

import ulib
import lineout
import wlibc
import wlib
import fuiscene

export { u_start }

const SYS_SETUID: u64 = 105

static mut s_t: [u8; 10] = "winopts: \0"
static mut s_sp: [u8; 2] = " \0"
static mut s_title: [u8; 8] = "winopts\0"
static mut s_title2: [u8; 9] = "winopts2\0"

fn line(name: u64, a: u64, b: u64) {
    lineout.add_text((&s_t[0 as usize]) as u64)
    lineout.add_text(name)
    lineout.add_text((&s_sp[0 as usize]) as u64)
    lineout.add_unum(a)
    lineout.add_text((&s_sp[0 as usize]) as u64)
    lineout.add_unum(b)
    lineout.end_line()
}

fn yes(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

fn opac_of(h: u64) -> u64 {
    return wlibc.sys3w(wlibc.WM_INFO, h, wlibc.WI_OPAC, 0)
}

fn u_start(args: u64) -> u64 {
    var n_begin: [u8; 6] = "begin\0"
    var n_opts: [u8; 7] = "o-make\0"
    var n_oop: [u8; 7] = "o-opac\0"
    var n_ofr: [u8; 8] = "o-frame\0"
    var n_dop: [u8; 7] = "d-opac\0"
    var n_dfr: [u8; 8] = "d-frame\0"
    var n_s0: [u8; 6] = "set-0\0"
    var n_s255: [u8; 8] = "set-255\0"
    var n_s77: [u8; 7] = "set-77\0"
    var n_s256: [u8; 8] = "set-256\0"
    var n_sbig: [u8; 8] = "set-big\0"
    var n_s256k: [u8; 9] = "set-256k\0"
    var n_bad: [u8; 8] = "bad-bit\0"
    var n_badw: [u8; 9] = "bad-bit0\0"
    var n_for: [u8; 8] = "foreign\0"
    var n_forkeep: [u8; 13] = "foreign-keep\0"
    var n_root: [u8; 9] = "uid0-top\0"
    var n_suid: [u8; 7] = "setuid\0"
    var n_top: [u8; 9] = "user-top\0"
    var n_norm: [u8; 10] = "user-norm\0"
    var n_umake: [u8; 10] = "user-make\0"
    var n_uop: [u8; 10] = "user-opac\0"
    var n_done: [u8; 5] = "done\0"

    if !wlib.begin(false, false) {
        line((&n_begin[0 as usize]) as u64, 0, 0)
        return 1
    }
    line((&n_begin[0 as usize]) as u64, 1, 0)

    // 1. one call: frameless + keys + opacity 128; and the default window next to it
    let wi: u64 = wlib.window_opts(300, 200, 240, 120, (&s_title[0 as usize]) as u64, true, true, 128)
    var h: u64 = 0
    if wi != wlib.MAXWN {
        h = wlib.handle(wi)
    }
    line((&n_opts[0 as usize]) as u64, yes(h != 0), 0)
    line((&n_oop[0 as usize]) as u64, opac_of(h), 128)
    let ox: u64 = wlibc.sys3w(wlibc.WM_INFO, h, wlibc.WI_INX, 0)
    let oy: u64 = wlibc.sys3w(wlibc.WM_INFO, h, wlibc.WI_INY, 0)
    line((&n_ofr[0 as usize]) as u64, ox, oy)
    let wd: u64 = wlib.window(100, 100, 240, 120, (&s_title2[0 as usize]) as u64)
    var h2: u64 = 0
    if wd != wlib.MAXWN {
        h2 = wlib.handle(wd)
    }
    line((&n_dop[0 as usize]) as u64, opac_of(h2), 255)
    let dx: u64 = wlibc.sys3w(wlibc.WM_INFO, h2, wlibc.WI_INX, 0)
    let dy: u64 = wlibc.sys3w(wlibc.WM_INFO, h2, wlibc.WI_INY, 0)
    line((&n_dfr[0 as usize]) as u64, dx, dy)

    // 2. WS_OPAC set + read back; out of range refused and nothing changes
    let r0: u64 = wlibc.win_set_opac(h, 0)
    line((&n_s0[0 as usize]) as u64, r0, opac_of(h))
    let r255: u64 = wlibc.win_set_opac(h, 255)
    line((&n_s255[0 as usize]) as u64, r255, opac_of(h))
    let r77: u64 = wlibc.win_set_opac(h, 77)
    line((&n_s77[0 as usize]) as u64, r77, opac_of(h))
    let r256: u64 = wlibc.win_set_opac(h, 256)
    line((&n_s256[0 as usize]) as u64, 0 -% r256, opac_of(h))
    let rbig: u64 = wlibc.win_set_opac(h, 0x100000000)
    line((&n_sbig[0 as usize]) as u64, 0 -% rbig, opac_of(h))
    let rneg: u64 = wlibc.win_set_opac(h, 0xFFFFFFFFFFFFFFFF)
    line((&n_s256k[0 as usize]) as u64, 0 -% rneg, opac_of(h))

    // 3. an unknown bit in the options word: refused, no window
    let hb: u64 = wlibc.sys5(wlibc.WM_CREATE, (50 << 16) | 50, (160 << 16) | 100, (&s_title[0 as usize]) as u64, 0x10, 0)
    line((&n_bad[0 as usize]) as u64, 0 -% hb, yes(hb != 0 && !ulib.bad(hb)))
    let hb2: u64 = wlibc.sys5(wlibc.WM_CREATE, (50 << 16) | 50, (160 << 16) | 100, (&s_title[0 as usize]) as u64, 1 << 16, 0)
    line((&n_badw[0 as usize]) as u64, 0 -% hb2, yes(hb2 != 0 && !ulib.bad(hb2)))

    // 4. every other handle number is not our window: WS_OPAC refuses it
    var refused: u64 = 0
    var tried: u64 = 0
    var k: u64 = 0
    while k < 256 {
        if k != h && k != h2 {
            let r: u64 = wlibc.win_set_opac(k, 5)
            tried = tried + 1
            if ulib.bad(r) {
                refused = refused + 1
            }
        }
        k = k + 1
    }
    line((&n_for[0 as usize]) as u64, refused, tried)
    line((&n_forkeep[0 as usize]) as u64, opac_of(h), opac_of(h2))

    // 5. as an ordinary user
    let r0t: u64 = wlibc.win_state(h2, wlibc.WS_LAYER, wlibc.L_TOP)
    line((&n_root[0 as usize]) as u64, r0t, 0)
    let su: u64 = ulib.sys(SYS_SETUID, 1000, 0, 0)
    line((&n_suid[0 as usize]) as u64, yes(!ulib.bad(su)), 0)
    let rt: u64 = wlibc.win_state(h2, wlibc.WS_LAYER, wlibc.L_TOP)
    line((&n_top[0 as usize]) as u64, 0 -% rt, opac_of(h2))
    let rn: u64 = wlibc.win_state(h2, wlibc.WS_LAYER, wlibc.L_NORMAL)
    line((&n_norm[0 as usize]) as u64, rn, 0)
    let wu: u64 = wlib.window_opts(400, 300, 200, 100, (&s_title[0 as usize]) as u64, true, false, 200)
    var hu: u64 = 0
    if wu != wlib.MAXWN {
        hu = wlib.handle(wu)
    }
    line((&n_umake[0 as usize]) as u64, yes(hu != 0), opac_of(hu))
    let ru: u64 = wlibc.win_set_opac(hu, 33)
    line((&n_uop[0 as usize]) as u64, ru, opac_of(hu))

    line((&n_done[0 as usize]) as u64, 1, 0)
    var t: u64 = 0
    while t < 100 {
        let _z: u64 = ulib.sleep_ms(100)
        t = t + 1
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
