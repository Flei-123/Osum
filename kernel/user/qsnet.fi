const K_NOTE: u64 = 56
const CUR_UD: u64 = 0xFE
const SWITCH_UD: u64 = 0xFD
const ETH_UD: u64 = 0xFF
const K_NET0: u64 = 50
const MAX_ROWS: u64 = 4
const ROW_H0: u64 = 48
const ROW_PAD0: u64 = 12
const HEAD_H0: u64 = 32
const FOOT_H0: u64 = 32
const CUR_TILE_H0: u64 = 44
const CUR_BTN_H0: u64 = 32
const CUR_PAD0: u64 = 12
const CUR_GAP0: u64 = 8
const NET_GAP0: u64 = 8
const LIST_GAP0: u64 = 4
const NOTE_H0: u64 = 32
const SEP_H0: u64 = 1
const CARD_PAD0: u64 = 16
const LABEL_H0: u64 = 20
const ENTRY_H0: u64 = 32
const PW_SLACK0: u64 = 16
const SWITCH_CELL_W0: u64 = 48
const INFO_SIZE0: u64 = 18
const LINE_GAP0: u64 = 2
const CONNECT_WAIT_NS: u64 = 30000000000
const CONN_ARMED: u64 = 1
const NAME_GAP0: u64 = 8
const TEXT_NUDGE0: u64 = 2
const NONE_PICK: u64 = 0xFFFFFFFF
const ROW_CAP: u64 = 72
const POLL_NS: u64 = 1000000000
const PW_MIN: u64 = 8
const PW_MAX: u64 = 63

const MSG_NONE: u64 = 0
const MSG_GOING: u64 = 1
const MSG_SHORT: u64 = 2
const MSG_FAIL: u64 = 3
const MSG_BAD_PW: u64 = 4
const MSG_NO_LINK: u64 = 5

static mut page: u64 = 0
static mut picked: u64 = NONE_PICK
static mut msg_kind: u64 = 0
static mut sig_last: u64 = 0
static mut poll_next: u64 = 0
static mut conn_deadline: u64 = 0
static mut conn_secured: bool = false
static mut show_pw: bool = false
static mut conn_ssid: [u8; 40] = [0 as u8; 40]
static mut pw_title: [u8; 96] = [0 as u8; 96]
static mut ssid_now: [u8; 40] = [0 as u8; 40]
static mut title_buf: [u8; 72] = [0 as u8; 72]
static mut rows_buf: [u8; 360] = [0 as u8; 360]
static mut ip_buf: [u8; 24] = [0 as u8; 24]
static mut note_ptr: u64 = 0
static mut net_rank: [u64; 4] = [0 as u64; 4]
static mut empty: [u8; 2] = "\0\0"
static mut sp: [u8; 3] = "  \0"
static mut dot: [u8; 2] = ".\0"

static mut k_net: [u8; 7] = "qs.net\0"
static mut k_title: [u8; 13] = "qs.net.title\0"
static mut k_eth: [u8; 11] = "qs.net.eth\0"
static mut k_wifi: [u8; 12] = "qs.net.wifi\0"
static mut k_hdr: [u8; 11] = "qs.net.hdr\0"
static mut k_empty: [u8; 13] = "qs.net.empty\0"
static mut k_nowifi: [u8; 14] = "qs.net.nowifi\0"
static mut k_connect: [u8; 15] = "qs.net.connect\0"
static mut k_pw: [u8; 10] = "qs.net.pw\0"
static mut k_sh_on: [u8; 16] = "qs.net.short.on\0"
static mut k_sh_off: [u8; 17] = "qs.net.short.off\0"
static mut k_sh_cable: [u8; 19] = "qs.net.short.cable\0"
static mut k_sh_limited: [u8; 21] = "qs.net.short.limited\0"
static mut k_pw_for: [u8; 13] = "qs.net.pwfor\0"
static mut k_cancel: [u8; 14] = "qs.net.cancel\0"
static mut k_show: [u8; 12] = "qs.net.show\0"
static mut k_offline: [u8; 15] = "qs.net.offline\0"
static mut k_m_badpw: [u8; 15] = "qs.net.m.badpw\0"
static mut k_m_nolink: [u8; 16] = "qs.net.m.nolink\0"
static mut k_settings: [u8; 16] = "qs.net.settings\0"
static mut k_secured: [u8; 15] = "qs.net.secured\0"
static mut k_open: [u8; 12] = "qs.net.open\0"
static mut k_disconnect: [u8; 18] = "qs.net.disconnect\0"
static mut k_more: [u8; 12] = "qs.net.more\0"
static mut k_refresh: [u8; 15] = "qs.net.refresh\0"
static mut k_info: [u8; 12] = "qs.net.info\0"
static mut k_switch: [u8; 14] = "qs.net.switch\0"
static mut k_back: [u8; 12] = "qs.net.back\0"
static mut k_st_off: [u8; 14] = "qs.net.st.off\0"
static mut k_st_unplugged: [u8; 20] = "qs.net.st.unplugged\0"
static mut k_st_limited: [u8; 18] = "qs.net.st.limited\0"
static mut k_st_noroute: [u8; 18] = "qs.net.st.noroute\0"
static mut k_st_ok: [u8; 13] = "qs.net.st.ok\0"
static mut k_st_nogw: [u8; 15] = "qs.net.st.nogw\0"
static mut k_st_nodns: [u8; 16] = "qs.net.st.nodns\0"
static mut k_st_noinet: [u8; 17] = "qs.net.st.noinet\0"
static mut k_m_going: [u8; 15] = "qs.net.m.going\0"
static mut k_m_short: [u8; 15] = "qs.net.m.short\0"
static mut k_m_fail: [u8; 14] = "qs.net.m.fail\0"
static mut k_w_open: [u8; 24] = "settings.wifi.word.open\0"
static mut k_w_secured: [u8; 27] = "settings.wifi.word.secured\0"
static mut k_w_saved: [u8; 25] = "settings.wifi.word.saved\0"
static mut k_w_current: [u8; 27] = "settings.wifi.word.current\0"
static mut s_line_page: [u8; 17] = "qsnet: page open\0"
static mut s_line_back: [u8; 12] = "qsnet: back\0"
static mut s_line_state: [u8; 14] = "qsnet: state=\0"
static mut s_line_kind: [u8; 7] = " kind=\0"
static mut s_line_rows: [u8; 7] = " rows=\0"
static mut s_line_pick: [u8; 13] = "qsnet: pick=\0"
static mut s_line_conn: [u8; 15] = "qsnet: connect\0"
static mut s_line_box: [u8; 14] = "qsnet: box k=\0"
static mut s_box_x: [u8; 4] = " x=\0"
static mut s_box_y: [u8; 4] = " y=\0"
static mut s_box_w: [u8; 4] = " w=\0"
static mut s_box_h: [u8; 4] = " h=\0"
static mut s_line_short: [u8; 22] = "qsnet: password short\0"
static mut s_line_rc: [u8; 5] = " rc=\0"
static mut s_line_size: [u8; 15] = "qsnet: page h=\0"
static mut s_line_badpw: [u8; 19] = "qsnet: link failed\0"

fn text_of(key: u64) -> u64 {
    return msg.get(key)
}

fn sys_net(what: u64) -> u64 {
    let v: u64 = ulib.sys(SYS_NETGET, what, 0, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

fn up_kind() -> u64 {
    return sys_net(NG_UPKIND)
}

fn is_wifi_up() -> bool {
    return up_kind() == KIND_WLAN
}

fn state_code() -> u64 {
    var st: u64 = sys_net(NG_STATE)
    let hl: u64 = sys_net(NG_HEALTH)
    if st == ST_OK && hl >= HEALTH_NO_GATEWAY && hl <= HEALTH_NO_INTERNET {
        if hl == HEALTH_NO_GATEWAY {
            return ST_NO_GATEWAY
        }
        if hl == HEALTH_NO_DNS {
            return ST_NO_DNS
        }
        return ST_NO_INTERNET
    }
    if st == 4 {
        if hl == HEALTH_NO_GATEWAY {
            return ST_NO_GATEWAY
        }
        if hl == HEALTH_NO_DNS {
            return ST_NO_DNS
        }
        return ST_NO_INTERNET
    }
    return st
}

fn has_wifi() -> bool {
    return welcome_net.link_state() != welcome_net.LINK_NO_DRIVER
}

fn is_online() -> bool {
    return state_code() == ST_OK
}

fn current_ssid() -> u64 {
    ssid_now[0 as usize] = 0 as u8
    if is_wifi_up() || (welcome_net.link_state() == welcome_net.LINK_UP && state_code() == ST_OFF) {
        let _s: bool = wlanconf.saved_ssid((&ssid_now[0 as usize]) as u64, 33)
    }
    return (&ssid_now[0 as usize]) as u64
}

fn title() -> u64 {
    let st: u64 = state_code()
    if st == ST_OFF {
        return text_of((&k_net[0 as usize]) as u64)
    }
    if is_wifi_up() {
        let s: u64 = current_ssid()
        if *(s as *mut u8) != 0 as u8 {
            let _n: u64 = ulib.strncpy((&title_buf[0 as usize]) as u64, s, 40)
            return (&title_buf[0 as usize]) as u64
        }
        return text_of((&k_wifi[0 as usize]) as u64)
    }
    return text_of((&k_eth[0 as usize]) as u64)
}

fn status_text() -> u64 {
    let st: u64 = state_code()
    if st == ST_OFF {
        if !is_wifi_up() && up_kind() != 0 && up_kind() != KIND_WLAN && sys_net(NG_READY) == 0 {
            return text_of((&k_st_unplugged[0 as usize]) as u64)
        }
        return text_of((&k_st_off[0 as usize]) as u64)
    }
    if st == ST_LIMITED {
        return text_of((&k_st_limited[0 as usize]) as u64)
    }
    if st == ST_NO_ROUTE {
        return text_of((&k_st_noroute[0 as usize]) as u64)
    }
    if st == ST_NO_GATEWAY {
        return text_of((&k_st_nogw[0 as usize]) as u64)
    }
    if st == ST_NO_DNS {
        return text_of((&k_st_nodns[0 as usize]) as u64)
    }
    if st == ST_NO_INTERNET {
        return text_of((&k_st_noinet[0 as usize]) as u64)
    }
    return text_of((&k_st_ok[0 as usize]) as u64)
}

fn short_status() -> u64 {
    let st: u64 = state_code()
    if st == ST_OK {
        return text_of((&k_sh_on[0 as usize]) as u64)
    }
    if st == ST_OFF {
        if !is_wifi_up() && up_kind() != 0 && up_kind() != KIND_WLAN && sys_net(NG_READY) == 0 {
            return text_of((&k_sh_cable[0 as usize]) as u64)
        }
        return text_of((&k_sh_off[0 as usize]) as u64)
    }
    return text_of((&k_sh_limited[0 as usize]) as u64)
}

fn glyph() -> u64 {
    let st: u64 = state_code()
    if st == ST_OFF {
        return icons.NETWORK_OFFLINE
    }
    if st != ST_OK {
        return icons.NETWORK_NO_INTERNET
    }
    if is_wifi_up() {
        return icons.PAGE_WIFI
    }
    return icons.NETWORK_WIRED
}

fn signature() -> u64 {
    var h: u64 = 1469598103934665603
    h = (h ^ state_code()) *% 1099511628211
    h = (h ^ up_kind()) *% 1099511628211
    h = (h ^ sys_net(NG_IP)) *% 1099511628211
    h = (h ^ welcome_net.link_state()) *% 1099511628211
    h = (h ^ netui.list_count()) *% 1099511628211
    h = (h ^ page) *% 1099511628211
    h = (h ^ msg_kind) *% 1099511628211
    h = (h ^ picked) *% 1099511628211
    return h
}

fn refresh_list() {
    welcome_net.refresh((&k_w_open[0 as usize]) as u64, (&k_w_secured[0 as usize]) as u64,
        (&k_w_saved[0 as usize]) as u64)
}

fn poll(now: u64) -> bool {
    if now < poll_next {
        return false
    }
    poll_next = now + POLL_NS
    if page != 0 {
        refresh_list()
    }
    watch_connect(now)
    let s: u64 = signature()
    if s == sig_last {
        return false
    }
    sig_last = s
    report_state()
    return true
}

fn linked_to_target() -> bool {
    if !is_wifi_up() || state_code() == ST_OFF {
        return false
    }
    return ulib.streq(current_ssid(), (&conn_ssid[0 as usize]) as u64)
}

fn rank_of_target() -> u64 {
    var r: u64 = 0
    while r < netui.list_count() {
        if ulib.streq(welcome_net.ssid_at(r), (&conn_ssid[0 as usize]) as u64) {
            return r
        }
        r = r + 1
    }
    return NONE_PICK
}

fn watch_connect(now: u64) {
    if conn_deadline == 0 {
        return
    }
    if conn_deadline == CONN_ARMED {
        conn_deadline = now + CONNECT_WAIT_NS
        return
    }
    if linked_to_target() {
        conn_deadline = 0
        msg_kind = MSG_NONE
        return
    }
    if now < conn_deadline {
        return
    }
    conn_deadline = 0
    if conn_secured {
        msg_kind = MSG_BAD_PW
        picked = rank_of_target()
        report_line((&s_line_badpw[0 as usize]) as u64)
        return
    }
    msg_kind = MSG_NO_LINK
}

fn report_state() {
    let _a: u64 = lineout.add_text((&s_line_state[0 as usize]) as u64)
    lineout.add_num(state_code())
    let _b: u64 = lineout.add_text((&s_line_kind[0 as usize]) as u64)
    lineout.add_num(up_kind())
    let _c: u64 = lineout.add_text((&s_line_rows[0 as usize]) as u64)
    lineout.add_num(netui.list_count())
    lineout.end_line()
}

fn report_line(p: u64) {
    let _a: u64 = lineout.add_text(p)
    lineout.end_line()
}

fn is_page() -> bool {
    return page != 0
}

fn open_page() {
    page = 1
    picked = NONE_PICK
    msg_kind = MSG_NONE
    show_pw = false
    refresh_list()
    sig_last = signature()
    report_line((&s_line_page[0 as usize]) as u64)
    report_state()
}

fn back() {
    page = 0
    picked = NONE_PICK
    msg_kind = MSG_NONE
    sig_last = signature()
    report_line((&s_line_back[0 as usize]) as u64)
}

fn owns_key(key: u64) -> bool {
    return key >= K_BACK && key <= K_NOTE
}

fn is_current(rank: u64) -> bool {
    if !is_wifi_up() {
        return false
    }
    let s: u64 = current_ssid()
    return *(s as *mut u8) != 0 as u8 && ulib.streq(welcome_net.ssid_at(rank), s)
}

fn word_of(rank: u64) -> u64 {
    if is_current(rank) {
        return text_of((&k_w_current[0 as usize]) as u64)
    }
    if netui.list_known(rank) {
        return text_of((&k_w_saved[0 as usize]) as u64)
    }
    return (&empty[0 as usize]) as u64
}

fn row_text(rank: u64) -> u64 {
    let base: u64 = (&rows_buf[0 as usize]) as u64 + rank * ROW_CAP
    var at: u64 = ulib.strncpy(base, welcome_net.ssid_at(rank), 40)
    at = at + ulib.strcpy(base + at, (&sp[0 as usize]) as u64)
    let _w: u64 = ulib.strncpy(base + at, word_of(rank), ROW_CAP - at - 1)
    return base
}

fn ip_text() -> u64 {
    let ip: u64 = sys_net(NG_IP)
    let dst: u64 = (&ip_buf[0 as usize]) as u64
    var at: u64 = 0
    var shift: u64 = 24
    var part: u64 = 0
    while part < 4 {
        at = at + text.digits((ip >> shift) & 255, dst + at, false)
        if part < 3 {
            at = at + ulib.strcpy(dst + at, (&dot[0 as usize]) as u64)
        }
        if shift >= 8 {
            shift = shift - 8
        }
        part = part + 1
    }
    *((dst + at) as *mut u8) = 0 as u8
    return dst
}

fn message_text() -> u64 {
    if msg_kind == MSG_GOING {
        return text_of((&k_m_going[0 as usize]) as u64)
    }
    if msg_kind == MSG_SHORT {
        return text_of((&k_m_short[0 as usize]) as u64)
    }
    if msg_kind == MSG_FAIL {
        return text_of((&k_m_fail[0 as usize]) as u64)
    }
    if msg_kind == MSG_BAD_PW {
        return text_of((&k_m_badpw[0 as usize]) as u64)
    }
    if msg_kind == MSG_NO_LINK {
        return text_of((&k_m_nolink[0 as usize]) as u64)
    }
    return 0
}

fn has_wired() -> bool {
    return up_kind() != 0 && up_kind() != KIND_WLAN
}

fn eth_status() -> u64 {
    if is_wifi_up() {
        return text_of((&k_st_off[0 as usize]) as u64)
    }
    if state_code() != ST_OFF && sys_net(NG_IP) != 0 && sys_net(NG_READY) != 0 {
        return ip_text()
    }
    return status_text()
}

fn text_fit(p: u64, avail: u64) -> u64 {
    let px: u64 = uiscale.px_ui()
    let n: u64 = text.length(p)
    if uitext.text_w(uitext.F_UI, px, p, n) <= avail {
        return n
    }
    return uiglyph.fit(uitext.F_UI, px, p, n, avail)
}

fn sc() -> u64 {
    return uiscale.ui_scale()
}
fn ROW_H() -> u64 {
    return ROW_H0 * sc()
}
fn wifi_enabled() -> bool {
    return !qsmodes.on(qsmodes.T_AIRPLANE)
}
fn cur_rank() -> u64 {
    var r: u64 = 0
    while r < netui.list_count() {
        if is_current(r) {
            return r
        }
        r = r + 1
    }
    return NONE_PICK
}
fn n_other_rows() -> u64 {
    var n: u64 = netui.list_count()
    if cur_rank() != NONE_PICK {
        n = n - 1
    }
    if n > MAX_ROWS {
        n = MAX_ROWS
    }
    return n
}
fn list_note() -> u64 {
    if !has_wifi() {
        return text_of((&k_nowifi[0 as usize]) as u64)
    }
    if netui.list_count() == 0 {
        return text_of((&k_empty[0 as usize]) as u64)
    }
    return 0
}
fn cur_block_hp() -> u64 {
    return 2 * CUR_PAD0 + CUR_TILE_H0 + CUR_GAP0 + CUR_BTN_H0
}
fn list_children() -> u64 {
    var n: u64 = n_other_rows()
    if has_wired() {
        n = n + 1
    }
    if cur_rank() != NONE_PICK {
        n = n + 1
    }
    if list_note() != 0 {
        n = n + 1
    }
    return n
}
fn list_hp() -> u64 {
    var h: u64 = n_other_rows() * ROW_H0
    if has_wired() {
        h = h + ROW_H0
    }
    if cur_rank() != NONE_PICK {
        h = h + cur_block_hp()
    }
    if list_note() != 0 {
        h = h + NOTE_H0
    }
    let k: u64 = list_children()
    if k > 1 {
        h = h + (k - 1) * LIST_GAP0
    }
    return h
}
fn password_hp() -> u64 {
    var h: u64 = LABEL_H0 + ENTRY_H0 + CUR_BTN_H0 + 2 * NET_GAP0 + PW_SLACK0
    if message_text() != 0 {
        h = h + LABEL_H0 + NET_GAP0
    }
    return h
}
fn footer_note_hp() -> u64 {
    if message_text() != 0 {
        return NOTE_H0 + NET_GAP0
    }
    return 0
}
fn page_hp() -> u64 {
    var h: u64 = 2 * CARD_PAD0 + HEAD_H0 + NET_GAP0 + SEP_H0 + NET_GAP0
    if picked != NONE_PICK {
        return h + password_hp()
    }
    h = h + list_hp() + footer_note_hp() + NET_GAP0 + SEP_H0 + NET_GAP0 + FOOT_H0
    return h
}
fn paint_text(x: u64, y: u64, h: u64, w: u64, p: u64, rgb: u64) {
    let px: u64 = uiscale.px_ui()
    let base: u64 = y + (h - uitext.text_h(px)) / 2 + uitext.ascent_of(uitext.F_UI, px) + TEXT_NUDGE0 * sc()
    fuiscene.cv_text_rgb(x, base, w, p, px, false, rgb)
}
fn row_paint(ud: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    let on: bool = (st & fuiscene.TS_ON) != 0
    let fg: u64 = qsnetdraw.paint_plate(x, y, w, h, st, on)
    var dim: u64 = uitheme.theme(uitheme.T_DIM)
    if on {
        dim = fg
    }
    let pad: u64 = ROW_PAD0 * sc()
    var name: u64 = 0
    var word: u64 = 0
    var left: u64 = x + pad
    if ud == ETH_UD {
        let gs: u64 = 20 * sc()
        fuiscene.cv_glyph(icons.NETWORK_WIRED, left, y + (h - gs) / 2, gs, fg)
        name = text_of((&k_eth[0 as usize]) as u64)
        word = eth_status()
    } else {
        qsnetdraw.paint_signal(left, y, h, netui.list_bars(ud), welcome_net.needs_password(ud), fg, dim)
        name = welcome_net.ssid_at(ud)
        word = word_of(ud)
    }
    left = x + pad + qsnetdraw.SIGNAL_AREA0 * sc()
    var right: u64 = x + w - pad
    let px: u64 = uiscale.px_ui()
    if text.length(word) > 0 {
        let wn: u64 = text_fit(word, (w - 2 * pad) / 2)
        let wd: u64 = uitext.text_w(uitext.F_UI, px, word, wn)
        paint_text(right - wd, y, h, wd + 2, word, dim)
        right = right - wd - NAME_GAP0 * sc()
    }
    if right > left {
        let nn: u64 = text_fit(name, right - left)
        let nw: u64 = uitext.text_w(uitext.F_UI, px, name, nn)
        paint_text(left, y, h, nw + 2, name, fg)
    }
}
fn cur_status() -> u64 {
    if state_code() != ST_OK {
        return status_text()
    }
    if welcome_net.needs_password(cur_rank()) {
        return text_of((&k_secured[0 as usize]) as u64)
    }
    return text_of((&k_open[0 as usize]) as u64)
}
fn cur_paint(ud: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    let fg: u64 = uitheme.theme(uitheme.T_FG)
    let dim: u64 = uitheme.theme(uitheme.T_DIM)
    let r: u64 = cur_rank()
    if r == NONE_PICK {
        return
    }
    let pad: u64 = ROW_PAD0 * sc()
    qsnetdraw.paint_accent_bar(x, y, h)
    qsnetdraw.paint_signal(x + pad, y, h, netui.list_bars(r), welcome_net.needs_password(r), fg, dim)
    let isz: u64 = INFO_SIZE0 * sc()
    fuiscene.cv_glyph(icons.INFO, x + w - isz - pad / 2, y + (h - isz) / 2, isz, dim)
    let px: u64 = uiscale.px_ui()
    let lh: u64 = uitext.text_h(px)
    let top: u64 = y + (h - 2 * lh - LINE_GAP0 * sc()) / 2
    let asc: u64 = uitext.ascent_of(uitext.F_UI, px)
    let tx: u64 = x + pad + qsnetdraw.SIGNAL_AREA0 * sc()
    let avail: u64 = x + w - isz - pad - tx
    let name: u64 = welcome_net.ssid_at(r)
    let nn: u64 = text_fit(name, avail)
    fuiscene.cv_text_rgb(tx, top + asc, uitext.text_w(uitext.F_UI, px, name, nn) + 2, name, px, false, fg)
    let stt: u64 = cur_status()
    let sn: u64 = text_fit(stt, avail)
    fuiscene.cv_text_rgb(tx, top + lh + LINE_GAP0 * sc() + asc, uitext.text_w(uitext.F_UI, px, stt, sn) + 2, stt, px,
        false, dim)
}
fn net_paint(ud: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    if ud == SWITCH_UD {
        qsnetdraw.paint_switch(x, y, w, h, (st & fuiscene.TS_ON) != 0, (st & fuiscene.TS_HOT) != 0)
        return
    }
    if ud == CUR_UD {
        cur_paint(ud, x, y, w, h, st)
        return
    }
    row_paint(ud, x, y, w, h, st)
}
fn note_paint(x: u64, y: u64, w: u64, h: u64) {
    let p: u64 = note_ptr
    if p == 0 {
        return
    }
    paint_text(x + ROW_PAD0 * sc(), y, h, w - 2 * ROW_PAD0 * sc(), p, uitheme.theme(uitheme.T_DIM))
}
fn add_note(parent: usize, p: u64, w: u64) {
    note_ptr = p
    let _n: usize = fuiscene.canvas(parent, K_NOTE, w, NOTE_H0, note_paint)
}
fn add_row(parent: usize, key: u64, label: u64, ud: u64, on: bool, inner_w: u64) {
    let r: usize = fuiscene.row(parent)
    let _t: usize = fuiscene.flat_tile(r, key, label, inner_w, ROW_H0, on, ud, net_paint)
}
fn build_header(card: usize, inner_w: u64) {
    let hd: usize = fuiscene.row(card)
    fuiscene.set_gap(hd, 8)
    var left_w: u64 = inner_w
    if has_wifi() {
        left_w = inner_w - SWITCH_CELL_W0 - 8
    }
    fuiscene.set_size(hd, inner_w, HEAD_H0)
    let left: usize = fuiscene.row(hd)
    fuiscene.set_gap(left, 8)
    fuiscene.set_size(left, left_w, HEAD_H0)
    let b: usize = fuiscene.icon_button(left, icons.ARROW_LEFT, text_of((&k_back[0 as usize]) as u64), K_BACK)
    fuiscene.set_size(b, HEAD_H0, HEAD_H0)
    let _t: usize = fuiscene.label(left, text_of((&k_title[0 as usize]) as u64))
    if has_wifi() {
        let _s: usize = fuiscene.flat_tile(hd, K_SWITCH, text_of((&k_switch[0 as usize]) as u64), SWITCH_CELL_W0,
            HEAD_H0, wifi_enabled(), SWITCH_UD, net_paint)
    }
}
fn build_current(list: usize, inner_w: u64) {
    let blk: usize = fuiscene.card_soft(list)
    fuiscene.set_pad(blk, CUR_PAD0)
    fuiscene.set_gap(blk, CUR_GAP0)
    let w: u64 = inner_w - 2 * CUR_PAD0
    let r1: usize = fuiscene.row(blk)
    let _t: usize = fuiscene.flat_tile(r1, K_CUR, row_text(cur_rank()), w, CUR_TILE_H0, false, CUR_UD, net_paint)
    let r2: usize = fuiscene.row(blk)
    let btn: usize = fuiscene.button(r2, text_of((&k_disconnect[0 as usize]) as u64), K_DISCONNECT)
    fuiscene.set_size(btn, w, CUR_BTN_H0)
}
fn build_list(card: usize, inner_w: u64) {
    let list: usize = fuiscene.column(card)
    fuiscene.set_gap(list, LIST_GAP0)
    if has_wired() {
        add_row(list, K_ETH, text_of((&k_eth[0 as usize]) as u64), ETH_UD, !is_wifi_up() && state_code() != ST_OFF, inner_w)
    }
    let cur: u64 = cur_rank()
    if cur != NONE_PICK {
        build_current(list, inner_w)
    }
    let note: u64 = list_note()
    if note != 0 {
        add_note(list, note, inner_w)
        return
    }
    var r: u64 = 0
    var shown: u64 = 0
    while r < netui.list_count() && shown < MAX_ROWS {
        if r != cur {
            add_row(list, K_NET0 + shown, row_text(r), r, false, inner_w)
            net_rank[shown as usize] = r
            shown = shown + 1
        }
        r = r + 1
    }
}
fn build_footer(card: usize, inner_w: u64) {
    let ft: usize = fuiscene.row(card)
    fuiscene.set_gap(ft, 8)
    fuiscene.set_size(ft, inner_w, FOOT_H0)
    let left: usize = fuiscene.row(ft)
    fuiscene.set_size(left, inner_w - FOOT_H0 - 8, FOOT_H0)
    let _l: usize = fuiscene.link(left, text_of((&k_more[0 as usize]) as u64), K_SETTINGS, FOOT_H0)
    let rb: usize = fuiscene.icon_button(ft, icons.NAV_REFRESH, text_of((&k_refresh[0 as usize]) as u64), K_REFRESH)
    fuiscene.set_size(rb, FOOT_H0, FOOT_H0)
}
fn build(card: usize, inner_w: u64) {
    fuiscene.set_gap(card, NET_GAP0)
    build_header(card, inner_w)
    let _s1: usize = fuiscene.separator(card)
    if picked != NONE_PICK {
        build_password(card, inner_w)
        return
    }
    build_list(card, inner_w)
    let m: u64 = message_text()
    if m != 0 {
        let _m: usize = fuiscene.label_muted(card, m)
    }
    let _s2: usize = fuiscene.separator(card)
    build_footer(card, inner_w)
}
fn pw_title_text() -> u64 {
    let dst: u64 = (&pw_title[0 as usize]) as u64
    var at: u64 = ulib.strcpy(dst, text_of((&k_pw_for[0 as usize]) as u64))
    at = at + ulib.strcpy(dst + at, (&sp[0 as usize]) as u64)
    let _s: u64 = ulib.strncpy(dst + at, (&conn_ssid[0 as usize]) as u64, 40)
    return dst
}

fn build_password(card: usize, inner_w: u64) {
    let _t: usize = fuiscene.label(card, pw_title_text())
    let pr: usize = fuiscene.row(card)
    fuiscene.set_gap(pr, 8)
    let _e: usize = fuiscene.entry(pr, K_PW, inner_w - 56 * fuiscene.scale(), (&empty[0 as usize]) as u64)
    fuiscene.entry_secret(K_PW, !show_pw)
    fuiscene.entry_hint(K_PW, text_of((&k_pw[0 as usize]) as u64))
    var eye: u64 = icons.EYE
    if show_pw {
        eye = icons.EYE_OFF
    }
    let _v: usize = fuiscene.icon_button(pr, eye, text_of((&k_show[0 as usize]) as u64), K_SHOW)
    let m: u64 = message_text()
    if m != 0 {
        let _m: usize = fuiscene.label_muted(card, m)
    }
    let br: usize = fuiscene.row(card)
    fuiscene.set_gap(br, 8)
    let _c: usize = fuiscene.button(br, text_of((&k_cancel[0 as usize]) as u64), K_CANCEL)
    let _k: usize = fuiscene.button_main(br, text_of((&k_connect[0 as usize]) as u64), K_CONNECT)
}

fn remember(rank: u64) {
    let _c: u64 = ulib.strncpy((&conn_ssid[0 as usize]) as u64, welcome_net.ssid_at(rank), 33)
}

fn arm_watch(rank: u64) {
    remember(rank)
    conn_secured = welcome_net.needs_password(rank)
    conn_deadline = CONN_ARMED
}

fn save_and_go(rank: u64, psk: u64) -> bool {
    let ok: bool = wlanconf.save(welcome_net.ssid_at(rank), psk)
    let _a: u64 = lineout.add_text((&s_line_conn[0 as usize]) as u64)
    let _b: u64 = lineout.add_text((&s_line_rc[0 as usize]) as u64)
    if ok {
        lineout.add_num(0)
        msg_kind = MSG_GOING
        arm_watch(rank)
    } else {
        lineout.add_num(1)
        msg_kind = MSG_FAIL
    }
    lineout.end_line()
    return ok
}

fn pick_row(rank: u64) -> u64 {
    let _a: u64 = lineout.add_text((&s_line_pick[0 as usize]) as u64)
    lineout.add_num(rank)
    lineout.end_line()
    if rank >= netui.list_count() || is_current(rank) {
        return 1
    }
    msg_kind = MSG_NONE
    if welcome_net.needs_password(rank) && !netui.list_known(rank) {
        picked = rank
        remember(rank)
        return 1
    }
    picked = NONE_PICK
    let _ok: bool = save_and_go(rank, (&empty[0 as usize]) as u64)
    return 1
}

fn submit_password() -> u64 {
    if picked == NONE_PICK {
        return 0
    }
    let psk: u64 = fuiscene.entry_text(K_PW)
    msg_kind = MSG_NONE
    var n: u64 = 0
    if psk != 0 {
        n = text.length(psk)
    }
    if n < PW_MIN || n > PW_MAX {
        msg_kind = MSG_SHORT
        report_line((&s_line_short[0 as usize]) as u64)
        return 1
    }
    var target: u64 = rank_of_target()
    if target == NONE_PICK {
        target = picked
    }
    let ok: bool = save_and_go(target, psk)
    fuiscene.entry_set(K_PW, (&empty[0 as usize]) as u64)
    if ok {
        picked = NONE_PICK
    }
    return 1
}

fn act(key: u64) -> u64 {
    if key == K_BACK {
        back()
        return 1
    }
    if key == K_CONNECT {
        return submit_password()
    }
    if key == K_SHOW {
        show_pw = !show_pw
        return 1
    }
    if key == K_CANCEL {
        picked = NONE_PICK
        msg_kind = MSG_NONE
        fuiscene.entry_set(K_PW, (&empty[0 as usize]) as u64)
        return 1
    }
    if key == K_ETH {
        return 1
    }
    if key == K_CUR {
        return 1
    }
    if key == K_DISCONNECT || key == K_SWITCH {
        let _rc: u64 = qsmodes.click(qsmodes.T_AIRPLANE)
        refresh_list()
        return 1
    }
    if key == K_REFRESH {
        refresh_list()
        return 1
    }
    if key >= K_NET0 && key < K_NET0 + MAX_ROWS {
        return pick_row(net_rank[(key - K_NET0) as usize])
    }
    return 0
}

fn trace_box(key: u64) {
    let n: usize = fuiscene.node_of_key(key)
    if n == fuiscene.NONE {
        return
    }
    let _a: u64 = lineout.add_text((&s_line_box[0 as usize]) as u64)
    lineout.add_num(key)
    let _x: u64 = lineout.add_text((&s_box_x[0 as usize]) as u64)
    lineout.add_num(fuiscene.node_x(n))
    let _y: u64 = lineout.add_text((&s_box_y[0 as usize]) as u64)
    lineout.add_num(fuiscene.node_y(n))
    let _w: u64 = lineout.add_text((&s_box_w[0 as usize]) as u64)
    lineout.add_num(fuiscene.node_w(n))
    let _h: u64 = lineout.add_text((&s_box_h[0 as usize]) as u64)
    lineout.add_num(fuiscene.node_h(n))
    lineout.end_line()
}

fn trace_boxes() {
    let _a: u64 = lineout.add_text((&s_line_size[0 as usize]) as u64)
    lineout.add_num(page_hp() * sc())
    lineout.end_line()
    trace_box(K_CUR)
    trace_box(K_DISCONNECT)
    trace_box(K_REFRESH)
    trace_box(K_SWITCH)
    trace_box(K_SETTINGS)
    trace_box(K_ETH)
    trace_box(K_SHOW)
    trace_box(K_CANCEL)
    var r: u64 = 0
    while r < MAX_ROWS {
        trace_box(K_NET0 + r)
        r = r + 1
    }
    trace_box(K_PW)
    trace_box(K_CONNECT)
    trace_box(K_BACK)
}
