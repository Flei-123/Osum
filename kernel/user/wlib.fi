// SPDX-License-Identifier: MIT
// kernel/user/wlib.fi -- Runde K15: DIE WIDGET-BIBLIOTHEK. Ring 3.
//
// Runde K10 gab einer Anwendung ein Rechteck, ein Handle und einen Ring
// mit Ereignissen. Was zwischen diesem Rechteck und einem Programm
// fehlt, ist alles: ein Knopf weiss, dass er gedrueckt aussieht,
// solange die Taste unten ist; ein Textfeld weiss, wo die Einfuegemarke
// steht; eine Liste weiss, welche Zeile ausgewaehlt ist und wie weit
// sie gerollt wurde; die Tabulatortaste weiss, was als naechstes den
// Fokus bekommt. Das steht hier.
//
// UND ES STEHT IN RING 3, NICHT IM KERNEL. Der Auftrag dieser Runde
// sagt es, und es ist auch richtig so: ein Kernel, der weiss, wie ein
// Knopf aussieht, kann nicht mehr sagen, was er ist. Was diese
// Bibliothek vom Kernel braucht, sind sieben Aufrufe
// (`kernel/wlib.fi`), und keiner davon kennt ein Widget.
//
// DER AUFBAU, in der Reihenfolge, in der ein Programm ihn benutzt:
//
//   1. `wlib.begin(nohit, noclip)` -- die Zeichenflaeche holen, das
//      Farbschema lesen.
//   2. `wlib.window(x, y, w, h, titel)` -- ein Fenster beim Server.
//   3. Kaesten aufmachen (`box_v`, `box_h`, `box_grid`) und Widgets
//      hineinstellen. Jedes gibt eine Nummer zurueck.
//   4. `wlib.step()` in einer Schleife: holt die Ereignisse ALLER
//      Fenster ab, verteilt sie, malt neu, was schmutzig ist, und gibt
//      die Nummer des Widgets zurueck, bei dem etwas passiert ist.
//
// WAS EIN "EREIGNIS" HIER IST: ein Knopf, der losgelassen wurde, eine
// Zeile, auf die doppelt geklickt wurde, ein Menuepunkt, der gewaehlt
// wurde, ein Reiter, der gewechselt hat, ein Dialog, der geschlossen
// wurde. Nicht: jede Mausbewegung. Die verarbeitet die Bibliothek
// selbst, und sie ist der Grund, warum ueberhaupt etwas neu gemalt
// wird.
//
// DIE ZWEI GEGENPROBEN, die diese Bibliothek selbst mitbringt:
//
//   `nohit`   Die Trefferpruefung ist aus. Widgets werden gemalt, die
//             Maus laeuft, die Ereignisse kommen an -- und landen bei
//             KEINEM Widget. Kein Knopf geht herunter, keine Zeile
//             wird ausgewaehlt, kein Menue klappt auf. Jede Messung,
//             die "der Klick ist angekommen" behauptet, MUSS damit
//             einbrechen.
//   `noclip`  Die Zwischenablage ist aus. Kopieren und Einfuegen tun
//             nichts, der Rest bleibt.
//
// WAS ES NICHT GIBT, und es steht hier und nicht in einer Fussnote:
// keine Unterfenster im Fenster (jedes Menue und jeder Dialog ist ein
// eigenes Fenster beim Server), keine Umbrueche im Textfeld (es ist
// EINE Zeile), keine Auswahl mit Umschalt-Pfeil (die Umschalttaste
// kommt in diesem System nicht als eigenes Ereignis an -- die
// Zeilendisziplin liefert das fertige Zeichen), und kein Ziehen
// zwischen Fenstern.

profile kernel

import ulib
import wlibc
import utf8

export {
    begin, window, window_plain, window_kind, close, closed, handle,
    win_w, win_h, win_x, win_y, win_hide, win_layer,
    box_v, box_h, box_grid, box_end, size, gap_after,
    label, button, check, entry, list, table, tabs, menubar, choice,
    sep, scrollarea,
    entry_secret, set_secret, ax_name, ax_flush, ax_nodes, ax_pushes,
    min_w, min_h, tab_count, visits, visit_at, focusables,
    KEY_BACKTAB,
    value, set_value, text_of, set_text, set_rows, set_cols, enable,
    show, shown, neu_setzen,
    list_icons, row_icons, icon_id, ICON_TAG,
    focus_id, set_focus, fired_kind, fired_index, fired_win,
    step, draw_all, dirty, dirty_all, alive, quit,
    menu_open, menu_at, menu_win, dlg_text, dlg_open, dlg_ask, dlg_state,
    dlg_close, dlg_button, dlg_win, dlg_label,
    counts, blits_done, key_last,
    theme_watch, theme_now, theme_switches, theme_polls, theme_pixels,
    theme_stales, paint_all, THEME_POLL_TICKS,
    rect_x, rect_y, rect_w, rect_h, kind_of, tab_x, tab_w,
    text_x, text_base, text_fg, text_bg, row_base, row_x, row_h,
    head_base, cell_base, cell_x, head_h, icon_x, icon_y,
    icon_letter_x, icon_letter_base,
    K_LABEL, K_BUTTON, K_CHECK, K_ENTRY, K_LIST, K_TABLE, K_TABS,
    K_MENUBAR, K_CHOICE, K_SEP, K_SCROLL,
    NK_MAIN, NK_MENU, NK_DLG,
    KEY_TAB, KEY_ENTER, KEY_BS, KEY_ESC, KEY_UP, KEY_DOWN, KEY_LEFT,
    KEY_RIGHT, KEY_HOME, KEY_END, KEY_PGUP, KEY_PGDN, KEY_DEL,
    MAXWD, MAXWN
}

// ------------------------------------------------------- die Zahlen

const MAXWD: u64 = 96 // Widgets insgesamt
const MAXWN: u64 = 4 // Fenster: das Hauptfenster, ein Menue, ein Dialog
const MAXCT: u64 = 24 // Kaesten

const K_LABEL: u64 = 1
const K_BUTTON: u64 = 2
const K_CHECK: u64 = 3
const K_ENTRY: u64 = 4
const K_LIST: u64 = 5
const K_TABLE: u64 = 6
const K_TABS: u64 = 7
const K_MENUBAR: u64 = 8
const K_CHOICE: u64 = 9
const K_SEP: u64 = 10
const K_SCROLL: u64 = 11

const NK_MAIN: u64 = 0
const NK_MENU: u64 = 1
const NK_DLG: u64 = 2

// Die Felder eines Widgets. Sechzehn Woerter, ein Feld je Wort -- Firn
// hat keine Verbunde, und eine Tabelle aus Woertern ist ehrlicher als
// sechzehn Felder mit sechzehn Namen.
const D_KIND: u64 = 0
const D_X: u64 = 1
const D_Y: u64 = 2
const D_W: u64 = 3
const D_H: u64 = 4
const D_FLAGS: u64 = 5
const D_TEXT: u64 = 6
const D_VAL: u64 = 7
const D_WIN: u64 = 8
const D_A: u64 = 9 // Rollversatz / Zeilenzahl
const D_B: u64 = 10 // Einfuegemarke / sichtbare Zeilen
const D_C: u64 = 11 // Auswahlanker / Spaltenzahl
const D_D: u64 = 12 // Hoechstlaenge / Spaltenbreiten
const D_PW: u64 = 13 // Wunschbreite
const D_PH: u64 = 14 // Wunschhoehe
const D_CT: u64 = 15 // der Kasten
// ROUND ICONS: one word per row, an icon from the icon font.  It sits
// next to `D_D` and not inside it on purpose: `D_D` already means two
// different things depending on the widget (longest text for an entry,
// column widths for a table), and a third meaning in the same slot is
// how a widget ends up drawing a column width as a picture.
const D_ICONS: u64 = 16
// RUNDE A11Y: VIER FELDER MEHR, UND JEDES LOEST EINEN EIGENEN FEHLER.
//
//   D_MIN          die NATUERLICHE Mindestgroesse -- so breit und hoch,
//                  wie der eigene Text in der AKTUELLEN Schriftgroesse
//                  wirklich ist. Ohne sie ist Skalieren ein Gluecksspiel:
//                  die Schrift waechst um 50 Prozent, der Kasten um die
//                  Zahl, die ein Programm vor drei Runden hingeschrieben
//                  hat, und die Beschriftung steht ueber der Kante. Die
//                  Anordnung nimmt seit dieser Runde IMMER das Groessere
//                  von beidem.
//   D_AXN          ein ausdruecklicher zugaenglicher Name. Nur noetig,
//                  wo der sichtbare Text NICHT der Name ist -- also beim
//                  Passwortfeld, dessen sichtbarer "Text" sein Inhalt
//                  ist und niemanden etwas angeht.
//   F_SECRET       (eine Flagge in D_FLAGS, kein eigenes Wort): der
//                  Inhalt dieses Feldes geht nicht in den Baum.
//
// ZWEI WOERTER UND NICHT VIER, und der Grund ist gemessen: jedes
// grafische Programm dieses Systems bindet diese Bibliothek EIN, also
// kostet jedes Wort mehr in `wd` 96 * 8 Oktette in JEDER der dreizehn
// ausfuehrbaren Dateien auf dem Abbild. Die erste Fassung nahm vier
// Woerter und liess das Abbild der Runde DESKTOP ueberlaufen
// ("mkfs: the disk is full"). Breite und Hoehe passen in ein Wort
// (je 32 Bit), und "geheim" ist EIN Bit und gehoert zu den Flaggen.
const D_MIN: u64 = 17 // Mindestbreite | Mindesthoehe << 32
const D_AXN: u64 = 18 // ausdruecklicher zugaenglicher Name
const D_FIELDS: u64 = 19

// Ein Textfeld, dessen Inhalt niemanden etwas angeht. Eine Flagge in
// `D_FLAGS` und kein eigenes Wort.
const F_SECRET: u64 = 32

// Wie viele Saetze der Puffer traegt.
const AXBUF: u64 = 16

// Wie viele Fokuswechsel die Spur behaelt.
const VISITS: u64 = 32

const F_FOCUSABLE: u64 = 1
const F_PRESSED: u64 = 2
const F_HOVER: u64 = 4
const F_OFF: u64 = 8
const F_HIDE: u64 = 16

// Ein Fenster
const N_H: u64 = 0
const N_W: u64 = 1
const N_HH: u64 = 2
const N_KIND: u64 = 3
const N_VAL: u64 = 4
const N_DATA: u64 = 5
const N_CNT: u64 = 6
const N_NDIRT: u64 = 7 // wie viele Rechtecke gerade schmutzig sind
// RUNDE A11Y: der Titel. Er ist der zugaengliche NAME des
// Fensterknotens -- ein Fenster ohne Namen ist fuer einen
// Bildschirmleser ein Fenster ohne Auskunft darueber, wo man ist.
const N_TITLE: u64 = 8
const N_OWNER: u64 = 11
const N_X: u64 = 12
const N_Y: u64 = 13
const N_FIELDS: u64 = 14

// Ein Kasten
const C_KIND: u64 = 0 // 1 senkrecht, 2 waagerecht, 3 Raster
const C_X: u64 = 1
const C_Y: u64 = 2
const C_W: u64 = 3
const C_H: u64 = 4
const C_PAD: u64 = 5
const C_GAP: u64 = 6
const C_COLS: u64 = 7
const C_CX: u64 = 8 // der Setzpunkt
const C_CY: u64 = 9
const C_COL: u64 = 10
const C_ROWH: u64 = 11
const C_WIN: u64 = 12
const C_FIELDS: u64 = 13

const KEY_TAB: u64 = 9
const KEY_ENTER: u64 = 13
const KEY_BS: u64 = 8
const KEY_ESC: u64 = 27
const KEY_UP: u64 = 0x101
const KEY_DOWN: u64 = 0x102
const KEY_LEFT: u64 = 0x103
const KEY_RIGHT: u64 = 0x104
const KEY_HOME: u64 = 0x105
const KEY_END: u64 = 0x106
const KEY_PGUP: u64 = 0x107
const KEY_PGDN: u64 = 0x108
const KEY_DEL: u64 = 0x109
// RUNDE A11Y: UMSCHALT-TAB. Sie kommt als `ESC [ Z` von der Tastatur
// (`kernel/kbd.fi`), also als das, was ein VT100 fuer diese Taste
// schickt. Vorher gab es sie NICHT: mit und ohne Umschalt kam eine 9,
// und "rueckwaerts durch die Bedienelemente" war nicht bedienbar.
const KEY_BACKTAB: u64 = 0x10A

// ------------------------------------------------------- der Zustand

static mut wd: [u64; 1824] = [0 as u64; 1824] // MAXWD * D_FIELDS
static mut wn: [u64; 56] = [0 as u64; 56] // MAXWN * N_FIELDS
static mut ct: [u64; 312] = [0 as u64; 312] // MAXCT * C_FIELDS
static mut nwd: u64 = 0
static mut nwn: u64 = 0
static mut nct: u64 = 0
static mut ctcur: u64 = 0xFFFFFFFFFFFFFFFF
static mut wncur: u64 = 0
static mut want_w: u64 = 0
static mut want_h: u64 = 0
static mut want_gap: u64 = 0

static mut s_focus: u64 = 0 // Widgetnummer + 1
// RUNDE A11Y: der Baum ist veraltet und muss neu herueber.
static mut s_axdirty: u64 = 1
// RUNDE A11Y: DIE SPUR DES FOKUS.
//
// Sie ist gebaut fuer den ehrlichen Test "jedes Bedienelement ist per
// Tastatur erreichbar": durchtabben und zaehlen. Ein Programm, das den
// Fokus nur ABFRAGT, sieht ihn nicht -- `step()` verarbeitet bis zu 64
// Ereignisse am Stueck, und wenn drei Tabulatoren zwischen zwei
// Abfragen kommen, sieht der Fragende nur den letzten. GEMESSEN: von
// vierzehn Tabulatoren tauchten elf Stellen auf, und drei fehlten --
// nicht weil sie unerreichbar waren, sondern weil niemand hinsah. Eine
// Spur, die bei JEDEM Fokuswechsel schreibt, hat dieses Loch nicht.
static mut s_visit: [u64; 32] = [0 as u64; 32]
static mut s_nvisit: u64 = 0
static mut s_axnodes: u64 = 0
static mut s_axpushes: u64 = 0
// SECHZEHN SAETZE UND NICHT VIERUNDSECHZIG. Derselbe Grund wie bei
// `wd`: 4096 Oktette in jeder ausfuehrbaren Datei sind teuer, und ein
// Aufruf mehr je sechzehn Bedienelemente ist billig -- der Baum wird
// nur neu geschickt, wenn sich etwas geaendert hat.
static mut axbuf: [u8; 1024] = [0 as u8; 1024]
static mut s_nohit: u64 = 0
static mut s_alive: u64 = 1
static mut s_fired: u64 = 0
static mut s_fkind: u64 = 0
static mut s_findex: u64 = 0
static mut s_fwin: u64 = 0
static mut s_blits: u64 = 0
static mut s_keylast: u64 = 0
static mut s_down: u64 = 0 // gedruecktes Widget + 1
static mut s_esc: u64 = 0 // Zustand der Fluchtfolge
static mut s_lastclick: u64 = 0
static mut s_lastwd: u64 = 0
static mut s_ticks: u64 = 0
// RUNDE THEME. Was das Umschalten kostet, gezaehlt an der Stelle, an
// der es passiert -- nicht geschaetzt.
static mut s_thpoll: u64 = 0 // Tick des letzten Nachsehens
static mut s_thgen: u64 = 0 // zuletzt gesehene Generation
static mut s_thswitch: u64 = 0 // wie oft sich das Thema geaendert hat
static mut s_thpx: u64 = 0 // Bildpunkte, die dafuer neu gemalt wurden
static mut s_thstale: u64 = 0 // Male, die ein Bild mittendrin veraltete
static mut s_thpolls: u64 = 0
static mut dlgbuf: [u8; 160] = [0 as u8; 160]
static mut ev: [u8; 16] = [0 as u8; 16]

// ------------------------------------------------------- der Zugriff

fn g(i: u64, f: u64) -> u64 {
    if i >= MAXWD {
        return 0
    }
    return wd[(i * D_FIELDS + f) as usize]
}

fn s(i: u64, f: u64, v: u64) {
    if i >= MAXWD {
        return
    }
    wd[(i * D_FIELDS + f) as usize] = v
}

fn ng(w: u64, f: u64) -> u64 {
    if w >= MAXWN {
        return 0
    }
    return wn[(w * N_FIELDS + f) as usize]
}

fn ns(w: u64, f: u64, v: u64) {
    if w >= MAXWN {
        return
    }
    wn[(w * N_FIELDS + f) as usize] = v
}

fn cg(c: u64, f: u64) -> u64 {
    if c >= MAXCT {
        return 0
    }
    return ct[(c * C_FIELDS + f) as usize]
}

fn cs(c: u64, f: u64, v: u64) {
    if c >= MAXCT {
        return
    }
    ct[(c * C_FIELDS + f) as usize] = v
}

fn tlen(p: u64) -> u64 {
    if p == 0 {
        return 0
    }
    return ulib.length(p)
}

fn imin(a: u64, b: u64) -> u64 {
    if a < b {
        return a
    }
    return b
}

fn sub(a: u64, b: u64) -> u64 {
    if b >= a {
        return 0
    }
    return a - b
}

// ------------------------------------------------------- das Aufsetzen

fn begin(nohit: bool, noclip: bool) -> bool {
    if !wlibc.start(noclip) {
        return false
    }
    var pfad: [u8; 11] = "/etc/theme\0"
    wlibc.theme_load((&pfad[0 as usize]) as u64)
    if nohit {
        s_nohit = 1
    }
    return true
}

fn counts() -> u64 {
    return nwd
}

fn blits_done() -> u64 {
    return s_blits
}

fn key_last() -> u64 {
    return s_keylast
}

fn alive() -> bool {
    return s_alive != 0
}

fn quit() {
    s_alive = 0
}

// ------------------------------------------------------- die Fenster

fn window(x: u64, y: u64, w: u64, h: u64, titel: u64) -> u64 {
    return new_win(x, y, w, h, titel, NK_MAIN)
}

// RUNDE DESKTOP: EIN FENSTER OHNE SCHMUCK AUF EINER EIGENEN EBENE.
// Schreibtisch und Taskleiste sind gewoehnliche Fenster -- sie haben
// nur keinen Rahmen und keine Titelleiste, und sie liegen ganz hinten
// beziehungsweise ganz vorn. Beides sagt DER SERVER, nicht die
// Anwendung: eine Anwendung, die sich selbst nach vorn malt, malt in
// ihr eigenes Rechteck und damit unter alle anderen.
//
// Gibt MAXWN zurueck, wenn kein Fenster zu haben war -- und ebenso,
// wenn die Ebene abgelehnt wurde. Ebene 0 und 2 darf nur die Wurzel;
// wer sie nicht bekommt, soll KEIN Fenster behalten, das aussieht wie
// eine Taskleiste und keine ist.
fn window_plain(x: u64, y: u64, w: u64, h: u64, titel: u64,
    ebene: u64) -> u64 {
    let i: u64 = new_win(x, y, w, h, titel, NK_MAIN)
    if i >= MAXWN {
        return MAXWN
    }
    let hh: u64 = ng(i, N_H)
    if ulib.bad(wlibc.win_state(hh, wlibc.WS_DECO, 0)) {
        close(i)
        return MAXWN
    }
    if ebene != wlibc.L_NORMAL {
        if ulib.bad(wlibc.win_state(hh, wlibc.WS_LAYER, ebene)) {
            close(i)
            return MAXWN
        }
    }
    return i
}

// Das eigene Fenster minimieren oder wiederherstellen.
fn win_hide(w: u64, on: bool) -> u64 {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return 0
    }
    var v: u64 = 0
    if on {
        v = 1
    }
    return wlibc.win_state(ng(w, N_H), wlibc.WS_HIDDEN, v)
}

fn win_layer(w: u64) -> u64 {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return wlibc.L_NORMAL
    }
    return wlibc.sys3w(wlibc.WM_INFO, ng(w, N_H), wlibc.WI_LAYER, 0)
}

fn new_win(x: u64, y: u64, w0: u64, h0: u64, titel: u64,
    kind: u64) -> u64 {
    if nwn >= MAXWN {
        return MAXWN
    }
    // RUNDE A11Y: EIN FENSTER WAECHST MIT. Ein Dialog, der bei 150
    // Prozent dieselben 300 Bildpunkte breit bleibt, hat zwei Knoepfe,
    // die nebeneinander nicht mehr hineinpassen -- und der zweite
    // steht dann halb draussen. Ein MENUE waechst besonders, weil seine
    // Breite ohnehin aus dem laengsten Eintrag gerechnet wird; dort
    // skaliert bereits `text_w`, also skaliert `new_win` nur, was ihm
    // gegeben wurde.
    var w: u64 = wlibc.sc(w0)
    var h: u64 = wlibc.sc(h0)
    // UND ES BLEIBT AUF DEM SCHIRM. Bei 150 Prozent ist ein Fenster von
    // 480 x 420 Entwurfseinheiten 720 x 630 gross -- auf einem Schirm
    // von 800 x 600 haengt der untere Rand heraus, und die Knoepfe
    // darin sind unerreichbar. Das ist derselbe Fehler wie eine
    // abgeschnittene Beschriftung, nur eine Ebene hoeher.
    let rand: u64 = 2 * 2 // der Fensterrahmen links und rechts
    let oben: u64 = 22 + 2 // Titelleiste und unterer Rahmen
    if w + rand > wlibc.screen_w() {
        w = sub(wlibc.screen_w(), rand)
    }
    if y + h + oben > wlibc.screen_h() {
        h = sub(sub(wlibc.screen_h(), oben), y)
    }
    if kind != NK_MAIN {
        // Menue und Dialog rechnen ihre Groesse SELBST aus der bereits
        // skalierten Schrift. Ein zweites Skalieren waere doppelt.
        w = w0
        h = h0
    }
    let hh: u64 = wlibc.sys5(wlibc.WM_CREATE, (x << 16) | y, (w << 16) | h,
        titel, 0, 0)
    if ulib.bad(hh) || hh == 0 {
        return MAXWN
    }
    let i: u64 = nwn
    nwn = nwn + 1
    ns(i, N_H, hh)
    ns(i, N_W, w)
    ns(i, N_HH, h)
    ns(i, N_KIND, kind)
    ns(i, N_VAL, 0)
    ns(i, N_DATA, 0)
    ns(i, N_CNT, 0)
    ns(i, N_OWNER, 0)
    ns(i, N_X, x)
    ns(i, N_Y, y)
    ns(i, N_TITLE, titel)
    wncur = i
    dirty_all(i)
    return i
}

fn window_kind(w: u64) -> u64 {
    return ng(w, N_KIND)
}

fn handle(w: u64) -> u64 {
    return ng(w, N_H)
}

// Wo das Fenster auf dem BILDSCHIRM steht. Ein Menue liegt am Zeiger
// und nicht an einer Stelle, die ein Testlaeufer erraten kann -- also
// sagt die Bibliothek sie.
fn win_x(w: u64) -> u64 {
    return ng(w, N_X)
}

fn win_y(w: u64) -> u64 {
    return ng(w, N_Y)
}

fn win_w(w: u64) -> u64 {
    return ng(w, N_W)
}

fn win_h(w: u64) -> u64 {
    return ng(w, N_HH)
}

fn closed(w: u64) -> bool {
    return ng(w, N_H) == 0
}

fn close(w: u64) {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return
    }
    wlibc.sys3w(wlibc.WM_CLOSE, ng(w, N_H), 0, 0)
    ns(w, N_H, 0)
    // Die Widgets dieses Fensters verschwinden mit ihm.
    var i: u64 = 0
    while i < nwd {
        if g(i, D_WIN) == w {
            s(i, D_FLAGS, g(i, D_FLAGS) | F_HIDE)
        }
        i = i + 1
    }
}

// ------------------------------------------------- der schmutzige Teil
//
// BIS ZU VIER RECHTECKE JE FENSTER, UND NICHT EINES. Die erste Fassung
// fuehrte EIN Rechteck und legte jede Meldung hinein -- die Vereinigung
// von allem. Das ist bequem und es ist gemessen falsch: bewegt sich der
// Zeiger von einem Knopf oben zu einer Liste unten, sind beide
// schmutzig, die Vereinigung ist das halbe Fenster, und dazwischen wird
// alles neu gemalt, was sich nicht geaendert hat. Gemessen: EIN Klick
// auf ein Kaestchen kostete so 82 992 von 192 000 Bildpunkten -- Faktor
// 2,3 statt Faktor 30.
//
// Also vier Rechtecke, und die Regel zum Zusammenlegen ist eine
// Flaechenregel: zwei werden nur dann eines, wenn die Vereinigung nicht
// mehr als ein Drittel groesser ist als beide zusammen. Sind alle vier
// belegt, wird das Paar zusammengelegt, das dabei am wenigsten
// hinzufuegt -- so bleibt die Zahl beschraenkt und die Flaeche klein.
const DIRT_MAX: u64 = 4

static mut dr: [u64; 64] = [0 as u64; 64] // MAXWN * DIRT_MAX * 4

fn dg(w: u64, k: u64, f: u64) -> u64 {
    return dr[((w * DIRT_MAX + k) * 4 + f) as usize]
}

fn ds(w: u64, k: u64, f: u64, v: u64) {
    dr[((w * DIRT_MAX + k) * 4 + f) as usize] = v
}

fn flaeche(x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    return (x1 - x0) * (y1 - y0)
}

fn setz(w: u64, k: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    ds(w, k, 0, x0)
    ds(w, k, 1, y0)
    ds(w, k, 2, x1)
    ds(w, k, 3, y1)
}

fn vereinen(w: u64, k: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    var a: u64 = dg(w, k, 0)
    var b: u64 = dg(w, k, 1)
    var c: u64 = dg(w, k, 2)
    var d: u64 = dg(w, k, 3)
    if x0 < a {
        a = x0
    }
    if y0 < b {
        b = y0
    }
    if x1 > c {
        c = x1
    }
    if y1 > d {
        d = y1
    }
    setz(w, k, a, b, c, d)
}

fn union_flaeche(w: u64, k: u64, x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    var a: u64 = dg(w, k, 0)
    var b: u64 = dg(w, k, 1)
    var c: u64 = dg(w, k, 2)
    var d: u64 = dg(w, k, 3)
    if x0 < a {
        a = x0
    }
    if y0 < b {
        b = y0
    }
    if x1 > c {
        c = x1
    }
    if y1 > d {
        d = y1
    }
    return flaeche(a, b, c, d)
}

fn dirty(w: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return
    }
    if x1 <= x0 || y1 <= y0 {
        return
    }
    var ax0: u64 = x0
    var ay0: u64 = y0
    var ax1: u64 = x1
    var ay1: u64 = y1
    if ax1 > ng(w, N_W) {
        ax1 = ng(w, N_W)
    }
    if ay1 > ng(w, N_HH) {
        ay1 = ng(w, N_HH)
    }
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    let neu_f: u64 = flaeche(ax0, ay0, ax1, ay1)
    var n: u64 = ng(w, N_NDIRT)
    // 1. Passt es guenstig zu einem der vorhandenen?
    var beste: u64 = DIRT_MAX
    var bester_zuwachs: u64 = 0xFFFFFFFFFFFFFFFF
    var k: u64 = 0
    while k < n {
        let alt_f: u64 = flaeche(dg(w, k, 0), dg(w, k, 1), dg(w, k, 2),
            dg(w, k, 3))
        let uf: u64 = union_flaeche(w, k, ax0, ay0, ax1, ay1)
        if uf * 3 <= (alt_f + neu_f) * 4 {
            let zuwachs: u64 = uf - alt_f
            if zuwachs < bester_zuwachs {
                bester_zuwachs = zuwachs
                beste = k
            }
        }
        k = k + 1
    }
    if beste < DIRT_MAX {
        vereinen(w, beste, ax0, ay0, ax1, ay1)
        return
    }
    // 2. Ist noch ein Platz frei?
    if n < DIRT_MAX {
        setz(w, n, ax0, ay0, ax1, ay1)
        ns(w, N_NDIRT, n + 1)
        return
    }
    // 3. Alle belegt: das Paar zusammenlegen, das am wenigsten kostet.
    var pa: u64 = 0
    var pb: u64 = 1
    var billigst: u64 = 0xFFFFFFFFFFFFFFFF
    var i: u64 = 0
    while i < n {
        var j: u64 = i + 1
        while j < n {
            let fi: u64 = flaeche(dg(w, i, 0), dg(w, i, 1), dg(w, i, 2),
                dg(w, i, 3))
            let fj: u64 = flaeche(dg(w, j, 0), dg(w, j, 1), dg(w, j, 2),
                dg(w, j, 3))
            let u: u64 = union_flaeche(w, i, dg(w, j, 0), dg(w, j, 1),
                dg(w, j, 2), dg(w, j, 3))
            if u - fi - fj < billigst {
                billigst = u - fi - fj
                pa = i
                pb = j
            }
            j = j + 1
        }
        i = i + 1
    }
    vereinen(w, pa, dg(w, pb, 0), dg(w, pb, 1), dg(w, pb, 2), dg(w, pb, 3))
    setz(w, pb, ax0, ay0, ax1, ay1)
}

fn dirty_all(w: u64) {
    ns(w, N_NDIRT, 1)
    setz(w, 0, 0, 0, ng(w, N_W), ng(w, N_HH))
}

fn dirty_wd(i: u64) {
    dirty(g(i, D_WIN), g(i, D_X), g(i, D_Y), g(i, D_X) + g(i, D_W),
        g(i, D_Y) + g(i, D_H))
}

// ------------------------------------------------------- die Anordnung
//
// DREI KAESTEN, UND SIE SETZEN, WAS MAN IHNEN GIBT.
//
//   senkrecht  jedes Widget bekommt die volle Breite des Kastens und
//              seine Wunschhoehe; der Setzpunkt wandert nach unten.
//   waagerecht jedes bekommt seine Wunschbreite und die volle Hoehe;
//              der Setzpunkt wandert nach rechts. Eine Wunschbreite
//              von 0 heisst "nimm, was uebrig ist" -- so bekommt eine
//              Pfadleiste ihren Platz zwischen zwei Knoepfen.
//   Raster     `cols` Spalten gleicher Breite, Zeilenhoehe ist die
//              hoechste Wunschhoehe der Zeile.
//
// Das ist eine Anordnung und kein Loeser. Was sie kann, steht hier;
// was sie nicht kann -- Gewichte, Mindestgroessen, Ausdehnen in beide
// Richtungen zugleich -- steht in docs/ROUNDK15.md unter den Grenzen.
//
// SIE LAEUFT BEI JEDER GROESSENAENDERUNG NEU (`relayout`), und das ist
// der Grund, warum die Kaesten ueberhaupt gespeichert werden statt die
// Rechtecke nur einmal auszurechnen.

fn box_v(w: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64,
    gp: u64) -> u64 {
    return new_box(w, 1, x, y, bw, bh, pad, gp, 1)
}

fn box_h(w: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64,
    gp: u64) -> u64 {
    return new_box(w, 2, x, y, bw, bh, pad, gp, 1)
}

fn box_grid(w: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64, gp: u64,
    cols: u64) -> u64 {
    return new_box(w, 3, x, y, bw, bh, pad, gp, cols)
}

fn new_box(w: u64, kind: u64, x0: u64, y0: u64, bw0: u64, bh0: u64,
    pad0: u64, gp0: u64, cols: u64) -> u64 {
    if nct >= MAXCT {
        return MAXCT
    }
    // RUNDE A11Y: auch der Kasten rechnet in Entwurfseinheiten.
    let x: u64 = wlibc.sc(x0)
    let y: u64 = wlibc.sc(y0)
    let bw: u64 = wlibc.sc(bw0)
    let bh: u64 = wlibc.sc(bh0)
    let pad: u64 = wlibc.sc(pad0)
    let gp: u64 = wlibc.sc(gp0)
    let c: u64 = nct
    nct = nct + 1
    cs(c, C_KIND, kind)
    cs(c, C_X, x)
    cs(c, C_Y, y)
    cs(c, C_W, bw)
    cs(c, C_H, bh)
    cs(c, C_PAD, pad)
    cs(c, C_GAP, gp)
    cs(c, C_COLS, cols)
    cs(c, C_WIN, w)
    reset_box(c)
    ctcur = c
    wncur = w
    return c
}

fn reset_box(c: u64) {
    cs(c, C_CX, cg(c, C_X) + cg(c, C_PAD))
    cs(c, C_CY, cg(c, C_Y) + cg(c, C_PAD))
    cs(c, C_COL, 0)
    cs(c, C_ROWH, 0)
}

fn box_end() {
    ctcur = 0xFFFFFFFFFFFFFFFF
}

// Die Wunschgroesse des NAECHSTEN Widgets. Danach ist sie wieder
// vergessen -- eine Wunschgroesse, die haengenbleibt, ist die Sorte
// Zustand, die man erst bemerkt, wenn drei Knoepfe zu hoch sind.
// RUNDE A11Y: DIE ZAHLEN EINES PROGRAMMS SIND ENTWURFSEINHEITEN.
//
// Ein Programm sagt `size(94, 28)` und meint "so gross, wie es bei 100
// Prozent aussehen soll". Was daraus auf dem Schirm wird, entscheidet
// die systemweite Skalierung -- hier, an EINER Stelle, und nicht in
// jedem Programm noch einmal. Das ist der Unterschied zwischen einer
// Oberflaeche, die skaliert, und einer, in der zwanzig Programme es
// zwanzigmal halb richtig machen.
fn size(w: u64, h: u64) {
    want_w = wlibc.sc(w)
    want_h = wlibc.sc(h)
}

fn gap_after(n: u64) {
    want_gap = n
}

fn place(i: u64) {
    let c: u64 = g(i, D_CT)
    if c >= MAXCT {
        return
    }
    let innen: u64 = sub(cg(c, C_W), 2 * cg(c, C_PAD))
    let kind: u64 = cg(c, C_KIND)
    // RUNDE A11Y: DIE WUNSCHGROESSE IST EINE UNTERGRENZE UND KEINE
    // OBERGRENZE.
    //
    // Bis hierher bekam ein Knopf genau die Breite, die das Programm
    // ihm gab. Bei 150 Prozent ist die Schrift 22 statt 15 Bildpunkte
    // hoch und "Abbrechen" 40 Prozent breiter -- der Knopf blieb, was
    // er war, und die Beschriftung stand ueber der Kante. Genau das ist
    // der haeufigste Fehler beim Skalieren, und er ist der Grund, warum
    // diese Zeile hier steht und nicht in einer Fussnote.
    //
    // `D_MIN` ist AUS DER SCHRIFT gerechnet, in der jetzt
    // gemalt wird. Bei 100 Prozent sind sie kleiner als jede
    // Wunschgroesse, die ein bestehendes Programm angibt -- kein
    // bestehender Testlauf sieht einen Unterschied.
    var pw: u64 = g(i, D_PW)
    var ph: u64 = g(i, D_PH)
    if ph == 0 {
        ph = wlibc.sc(24)
    }
    if pw != 0 && pw < min_w(i) {
        pw = min_w(i)
    }
    if ph < min_h(i) {
        ph = min_h(i)
    }
    if kind == 1 {
        s(i, D_X, cg(c, C_CX))
        s(i, D_Y, cg(c, C_CY))
        var bw: u64 = innen
        if pw != 0 && pw < innen {
            bw = pw
        }
        if bw < min_w(i) {
            bw = min_w(i)
        }
        s(i, D_W, bw)
        s(i, D_H, ph)
        cs(c, C_CY, cg(c, C_CY) + ph + cg(c, C_GAP))
    } else if kind == 2 {
        let rest: u64 = sub(cg(c, C_X) + cg(c, C_W) - cg(c, C_PAD),
            cg(c, C_CX))
        var bw2: u64 = pw
        if bw2 == 0 || bw2 > rest {
            bw2 = rest
        }
        if bw2 < min_w(i) {
            bw2 = min_w(i)
        }
        s(i, D_X, cg(c, C_CX))
        s(i, D_Y, cg(c, C_CY))
        s(i, D_W, bw2)
        var bh2: u64 = ph
        let hoch: u64 = sub(cg(c, C_H), 2 * cg(c, C_PAD))
        if g(i, D_PH) == 0 && hoch > 0 {
            bh2 = hoch
        }
        s(i, D_H, bh2)
        cs(c, C_CX, cg(c, C_CX) + bw2 + cg(c, C_GAP))
    } else {
        let cols: u64 = cg(c, C_COLS)
        var zw: u64 = 40
        if cols > 0 {
            zw = sub(innen + cg(c, C_GAP), 0) / cols
            if zw > cg(c, C_GAP) {
                zw = zw - cg(c, C_GAP)
            }
        }
        if zw < min_w(i) {
            zw = min_w(i)
        }
        s(i, D_X, cg(c, C_CX))
        s(i, D_Y, cg(c, C_CY))
        s(i, D_W, zw)
        s(i, D_H, ph)
        if ph > cg(c, C_ROWH) {
            cs(c, C_ROWH, ph)
        }
        cs(c, C_COL, cg(c, C_COL) + 1)
        if cg(c, C_COL) >= cols {
            cs(c, C_COL, 0)
            cs(c, C_CX, cg(c, C_X) + cg(c, C_PAD))
            cs(c, C_CY, cg(c, C_CY) + cg(c, C_ROWH) + cg(c, C_GAP))
            cs(c, C_ROWH, 0)
        } else {
            cs(c, C_CX, cg(c, C_CX) + zw + cg(c, C_GAP))
        }
    }
    if want_gap != 0 {
        if kind == 2 {
            cs(c, C_CX, cg(c, C_CX) + want_gap)
        } else {
            cs(c, C_CY, cg(c, C_CY) + want_gap)
        }
        want_gap = 0
    }
}

// Alle Kaesten von vorn setzen. Wird nach einer Groessenaenderung
// gerufen und nach jeder Aenderung, die Platz kostet.
fn relayout() {
    s_axdirty = 1
    var c: u64 = 0
    while c < nct {
        // Kaesten, die die volle Fensterbreite wollten, wachsen mit.
        let w: u64 = cg(c, C_WIN)
        if cg(c, C_W) == 0 {
            cs(c, C_W, ng(w, N_W))
        }
        reset_box(c)
        c = c + 1
    }
    var i: u64 = 0
    while i < nwd {
        if (g(i, D_FLAGS) & F_HIDE) == 0 {
            place(i)
        }
        i = i + 1
    }
}

// ------------------------------------------------------- die Widgets

fn add(kind: u64, txt: u64, pw: u64, ph: u64, fokus: bool) -> u64 {
    if nwd >= MAXWD {
        return 0
    }
    let i: u64 = nwd
    nwd = nwd + 1
    s_axdirty = 1
    s(i, D_KIND, kind)
    s(i, D_TEXT, txt)
    s(i, D_WIN, wncur)
    s(i, D_CT, ctcur)
    s(i, D_PW, want_w)
    s(i, D_PH, want_h)
    if want_w == 0 {
        s(i, D_PW, pw)
    }
    if want_h == 0 {
        s(i, D_PH, ph)
    }
    want_w = 0
    want_h = 0
    var fl: u64 = 0
    if fokus {
        fl = F_FOCUSABLE
    }
    s(i, D_FLAGS, fl)
    calc_min(i)
    place(i)
    // RUNDE A11Y: DIE MENUELEISTE IST FOKUSSIERBAR, ABER SIE BEKOMMT DEN
    // FOKUS NICHT ALS ERSTE.
    //
    // Beides gehoert zusammen und beides ist Absicht. Erreichbar muss
    // sie sein -- ohne das kommt niemand ohne Maus an ein Menue. Aber
    // ein Fenster, dessen Eingabemarke beim Aufgehen in der Menueleiste
    // steht, ist falsch: getippt wird in das erste FELD, und jede
    // Oberflaeche der letzten dreissig Jahre haelt es so.
    //
    // GEMESSEN, nicht ueberlegt: die erste Fassung liess sie den Fokus
    // nehmen, und `tools/k15/run.sh` fiel darueber -- "der Fokusring
    // liegt bildpunktgenau um die Reiter: 964 von 964 Kantenpunkten
    // falsch". Er lag um die Menueleiste. Ein bestehender Test, der
    // eine Verhaltensaenderung findet, hat seine Arbeit getan.
    if s_focus == 0 && fokus && kind != K_MENUBAR {
        s_focus = i + 1
    }
    return i
}

fn label(txt: u64) -> u64 {
    return add(K_LABEL, txt, 0, wlibc.text_h(wlibc.px_ui()), false)
}

fn button(txt: u64) -> u64 {
    let w: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), txt, tlen(txt))
        + wlibc.sc(24)
    return add(K_BUTTON, txt, w, wlibc.sc(26), true)
}

fn check(txt: u64, on: bool) -> u64 {
    let i: u64 = add(K_CHECK, txt, 0, wlibc.sc(22), true)
    if on {
        s(i, D_VAL, 1)
    }
    return i
}

// Ein Textfeld arbeitet auf dem Puffer DES AUFRUFERS. Die Bibliothek
// legt keinen an: wer den Text hinterher braucht, hat ihn dann schon.
fn entry(buf: u64, max: u64) -> u64 {
    let i: u64 = add(K_ENTRY, buf, 0, wlibc.sc(24), true)
    s(i, D_D, max)
    s(i, D_B, tlen(buf))
    s(i, D_C, tlen(buf))
    return i
}

// ================================================== RUNDE A11Y
//
// EIN TEXTFELD, DESSEN INHALT NIEMANDEN ETWAS ANGEHT.
//
// Es ist ein gewoehnliches Textfeld mit EINEM Unterschied, und der
// Unterschied ist die zweite der zwei Sperren dieser Runde: sein Inhalt
// geht NICHT in den Bedienelement-Baum. Nicht als Wert, nicht als Name,
// nicht als Laenge. Was in den Baum geht, ist die ROLLE
// (`AR_PASSWORD`), damit ein Bildschirmleser "Passwortfeld" sagen kann,
// die Lage, die Groesse, der Zustand -- und der Name, den das Programm
// ausdruecklich mit `ax_name` gesetzt hat.
//
// Die erste Sperre steht im Kernel (`kernel/ax.fi`, `push_node`): dort
// wird der Wert eines Knotens mit dieser Rolle auf null gezwungen, auch
// wenn doch einer ankommt, und der Versuch wird gezaehlt. Zwei Sperren,
// weil eine Sperre, an der alles haengt, keine ist.
fn entry_secret(buf: u64, max: u64) -> u64 {
    let i: u64 = entry(buf, max)
    s(i, D_FLAGS, g(i, D_FLAGS) | F_SECRET)
    return i
}

fn set_secret(i: u64, on: bool) {
    if i >= nwd {
        return
    }
    if on {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_SECRET)
    } else {
        s(i, D_FLAGS, g(i, D_FLAGS) & ~F_SECRET)
    }
    s_axdirty = 1
}

// Der zugaengliche Name, wenn der sichtbare Text keiner ist.
fn ax_name(i: u64, p: u64) {
    if i >= nwd {
        return
    }
    s(i, D_AXN, p)
    s_axdirty = 1
}

fn list(blob: u64, rows: u64) -> u64 {
    let i: u64 = add(K_LIST, blob, 0, rows * zeilen_hoehe() + wlibc.sc(4),
        true)
    s(i, D_VAL, 0)
    s(i, D_A, 0)
    count_rows(i)
    return i
}

// Eine Tabelle bekommt die Zeilen als EINEN Text: Spalten durch
// Tabulator getrennt, Zeilen durch Zeilenumbruch. Kein Modell, keine
// Rueckrufe -- die Sprache hat keine Funktionszeiger, und ein
// Zeilenpuffer ist das, was ein Dateimanager ohnehin baut.
fn table(blob: u64, rows: u64, cols: u64, breiten: u64) -> u64 {
    let i: u64 = add(K_TABLE, blob, 0, rows * zeilen_hoehe() + wlibc.sc(24),
        true)
    s(i, D_C, cols)
    s(i, D_D, breiten)
    s(i, D_VAL, 0)
    s(i, D_A, 0)
    count_rows(i)
    return i
}

fn tabs(txt: u64) -> u64 {
    return add(K_TABS, txt, 0, wlibc.sc(26), true)
}

// RUNDE A11Y: DIE MENUELEISTE BEKOMMT DEN FOKUS.
//
// Sie war das einzige Bedienelement dieser Bibliothek, das per Maus
// bedienbar war und per Tastatur NICHT -- `add(..., false)`. Wer keine
// Maus benutzen kann, kam damit an kein einziges Menue dieses Systems.
// Das ist keine Feinheit, das ist der Unterschied zwischen bedienbar
// und nicht bedienbar.
fn menubar(txt: u64) -> u64 {
    return add(K_MENUBAR, txt, 0, wlibc.sc(22), true)
}

fn choice(txt: u64, sel: u64) -> u64 {
    let i: u64 = add(K_CHOICE, txt, 0, wlibc.sc(24), true)
    s(i, D_VAL, sel)
    return i
}

fn sep() -> u64 {
    return add(K_SEP, 0, 0, wlibc.sc(5), false)
}

fn scrollarea(rows: u64, sicht: u64) -> u64 {
    let i: u64 = add(K_SCROLL, 0, wlibc.sc(14), 0, false)
    s(i, D_A, rows)
    s(i, D_B, sicht)
    return i
}

// ------------------------------------------------------- der Zustand

// ================================================== RUNDE A11Y
//
// DIE NATUERLICHE MINDESTGROESSE, AUS DER SCHRIFT GERECHNET.
//
// Sie ist der Kern der Zusage "bei 150 Prozent ist keine Beschriftung
// abgeschnitten". Sie wird bei jedem Anlegen und bei jedem `set_text`
// neu gerechnet, in der Schriftgroesse, die JETZT gilt -- und die
// Anordnung nimmt sie als Untergrenze (`place`).
//
// Warum je Art eine eigene Rechnung: der Platz um den Text herum ist je
// Art ein anderer. Ein Kaestchen hat sein Quadrat davor, ein Auswahlfeld
// sein Dreieck dahinter, ein Reiter seine Zwischenraeume. Eine
// gemeinsame Zahl waere fuer die Haelfte zu klein und fuer die andere
// Haelfte zu gross.
fn zeilen_breite(p: u64) -> u64 {
    var breit: u64 = 0
    var k: u64 = 0
    while k < 32 {
        let q: u64 = row_at(p, k)
        if q == 0 {
            k = 32
        } else {
            let w: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                row_len(q))
            if w > breit {
                breit = w
            }
            k = k + 1
        }
    }
    return breit
}

fn calc_min(i: u64) {
    let k: u64 = g(i, D_KIND)
    let p: u64 = g(i, D_TEXT)
    let th: u64 = wlibc.text_h(wlibc.px_ui())
    var mw: u64 = 0
    var mh: u64 = 0
    if k == K_LABEL {
        mw = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, tlen(p))
        mh = th
    } else if k == K_BUTTON {
        mw = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, tlen(p))
            + wlibc.sc(16)
        mh = th + wlibc.sc(6)
    } else if k == K_CHECK {
        mw = wlibc.sc(14) + wlibc.sc(6)
            + wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, tlen(p))
        mh = th + wlibc.sc(4)
    } else if k == K_ENTRY {
        mw = wlibc.sc(60)
        mh = th + wlibc.sc(6)
    } else if k == K_LIST {
        mw = wlibc.sc(60)
        mh = zeilen_hoehe() + wlibc.sc(4)
    } else if k == K_TABLE {
        mw = wlibc.sc(60)
        mh = 2 * zeilen_hoehe() + wlibc.sc(8)
    } else if k == K_TABS {
        // ALLE Reiter nebeneinander -- ein Reiter, der aus dem Kasten
        // faellt, ist unerreichbar, und die Pfeiltasten helfen nur dem,
        // der ihn schon sieht.
        var t: u64 = 0
        while t < 8 {
            let b: u64 = tab_breite(i, t)
            if b == 0 {
                t = 8
            } else {
                mw = mw + b
                t = t + 1
            }
        }
        mh = th + wlibc.sc(8)
    } else if k == K_MENUBAR {
        var m: u64 = 0
        while m < 8 {
            let q: u64 = row_at(p, m)
            if q == 0 {
                m = 8
            } else {
                mw = mw + wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                    row_len(q)) + wlibc.sc(16)
                m = m + 1
            }
        }
        mh = th + wlibc.sc(4)
    } else if k == K_CHOICE {
        mw = zeilen_breite(p) + wlibc.sc(28)
        mh = th + wlibc.sc(6)
    } else if k == K_SCROLL {
        mw = wlibc.sc(14)
        mh = 0
    }
    s(i, D_MIN, (mw & 0xFFFFFFFF) | ((mh & 0xFFFFFFFF) << 32))
}

fn min_w(i: u64) -> u64 {
    return g(i, D_MIN) & 0xFFFFFFFF
}

fn min_h(i: u64) -> u64 {
    return (g(i, D_MIN) >> 32) & 0xFFFFFFFF
}

// Wie viele Reiter es gibt -- der Testlaeufer zaehlt damit nach, dass
// er wirklich jeden erreicht hat.
fn tab_count(i: u64) -> u64 {
    var t: u64 = 0
    while t < 8 {
        if tab_breite(i, t) == 0 {
            return t
        }
        t = t + 1
    }
    return 8
}

fn value(i: u64) -> u64 {
    return g(i, D_VAL)
}

fn set_value(i: u64, v: u64) {
    if g(i, D_VAL) == v {
        return
    }
    s(i, D_VAL, v)
    s_axdirty = 1
    dirty_wd(i)
}

fn text_of(i: u64) -> u64 {
    return g(i, D_TEXT)
}

fn set_text(i: u64, p: u64) {
    s(i, D_TEXT, p)
    calc_min(i)
    s_axdirty = 1
    if g(i, D_KIND) == K_LIST || g(i, D_KIND) == K_TABLE {
        count_rows(i)
        if g(i, D_VAL) >= g(i, D_A) {
            s(i, D_VAL, 0)
        }
        s(i, D_B, 0)
    }
    if g(i, D_KIND) == K_ENTRY {
        s(i, D_B, tlen(p))
        s(i, D_C, g(i, D_B))
    }
    dirty_wd(i)
}

fn set_rows(i: u64, n: u64) {
    s(i, D_A, n)
}

fn set_cols(i: u64, n: u64, breiten: u64) {
    s(i, D_C, n)
    s(i, D_D, breiten)
}

fn enable(i: u64, on: bool) {
    s_axdirty = 1
    if on {
        s(i, D_FLAGS, g(i, D_FLAGS) & ~F_OFF)
    } else {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_OFF)
    }
    dirty_wd(i)
}

// RUNDE DESKTOP: EIN WIDGET AUS DER ANORDNUNG NEHMEN UND
// ZURUECKGEBEN. Das ist der Unterschied zwischen `enable` (steht da,
// laesst sich nicht bedienen) und dem, was ein REITER braucht: die
// Widgets des anderen Reiters sollen gar nicht da sein, und der Platz,
// den sie belegt haetten, soll dem sichtbaren zugutekommen.
//
// `relayout` ueberspringt verborgene Widgets seit Runde K15 -- die
// Zeile stand da und war unbenutzbar, weil es keinen Weg gab, F_HIDE
// von aussen zu setzen. Diese beiden Funktionen sind der Weg.
fn show(i: u64, on: bool) {
    if i >= nwd {
        return
    }
    s_axdirty = 1
    if on {
        s(i, D_FLAGS, g(i, D_FLAGS) & ~F_HIDE)
    } else {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_HIDE)
    }
}

fn shown(i: u64) -> bool {
    if i >= nwd {
        return false
    }
    return (g(i, D_FLAGS) & F_HIDE) == 0
}

// Alles neu anordnen und neu malen. Nach jedem Reiterwechsel.
fn neu_setzen() {
    relayout()
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            dirty_all(w)
        }
        w = w + 1
    }
}

fn focus_id() -> u64 {
    if s_focus == 0 {
        return MAXWD
    }
    return s_focus - 1
}

fn set_focus(i: u64) {
    if s_focus != 0 {
        dirty_wd(s_focus - 1)
    }
    s_focus = i + 1
    s_axdirty = 1
    if s_nvisit < VISITS {
        s_visit[(s_nvisit) as usize] = i
        s_nvisit = s_nvisit + 1
    }
    dirty_wd(i)
}

// Wie viele Fokuswechsel es gab und wohin sie gingen.
fn visits() -> u64 {
    return s_nvisit
}

fn visit_at(k: u64) -> u64 {
    if k >= s_nvisit || k >= VISITS {
        return MAXWD
    }
    return s_visit[(k) as usize]
}

// Wie viele Bedienelemente ueberhaupt fokussierbar sind -- die Zahl,
// gegen die der Testlaeufer die Spur haelt.
fn focusables() -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < nwd {
        if (g(i, D_FLAGS) & (F_HIDE | F_OFF)) == 0
            && (g(i, D_FLAGS) & F_FOCUSABLE) != 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn fired_kind() -> u64 {
    return s_fkind
}

fn fired_index() -> u64 {
    return s_findex
}

fn fired_win() -> u64 {
    return s_fwin
}

// --------------------------------------------------- Zeilen und Spalten

// Wie viele Zeilen der Textblock hat. Eine Zeile ist alles bis zum
// naechsten Umbruch; der letzte Umbruch zaehlt nicht als leere Zeile
// dahinter.
fn count_rows(i: u64) {
    let p: u64 = g(i, D_TEXT)
    if p == 0 {
        s(i, D_A, 0)
        return
    }
    var n: u64 = 0
    var k: u64 = 0
    var zeichen: u64 = 0
    while (*((p + k) as *mut u8)) != 0 as u8 {
        if (*((p + k) as *mut u8)) == 10 as u8 {
            n = n + 1
            zeichen = 0
        } else {
            zeichen = zeichen + 1
        }
        k = k + 1
    }
    if zeichen > 0 {
        n = n + 1
    }
    s(i, D_A, n)
}

fn row_at(p: u64, r: u64) -> u64 {
    if p == 0 {
        return 0
    }
    var k: u64 = 0
    var n: u64 = 0
    while n < r {
        if (*((p + k) as *mut u8)) == 0 as u8 {
            return 0
        }
        if (*((p + k) as *mut u8)) == 10 as u8 {
            n = n + 1
        }
        k = k + 1
    }
    if (*((p + k) as *mut u8)) == 0 as u8 {
        return 0
    }
    return p + k
}

fn row_len(q: u64) -> u64 {
    var n: u64 = 0
    while (*((q + n) as *mut u8)) != 0 as u8 {
        if (*((q + n) as *mut u8)) == 10 as u8 {
            return n
        }
        n = n + 1
    }
    return n
}

// Spalte `c` einer Zeile: Zeiger und Laenge (Laenge oben in `col_len`).
fn col_at(q: u64, ende: u64, c: u64) -> u64 {
    var k: u64 = 0
    var n: u64 = 0
    while n < c {
        if k >= ende {
            return 0
        }
        if (*((q + k) as *mut u8)) == 9 as u8 {
            n = n + 1
        }
        k = k + 1
    }
    if k > ende {
        return 0
    }
    return q + k
}

fn col_len(q: u64, rest: u64) -> u64 {
    var n: u64 = 0
    while n < rest {
        if (*((q + n) as *mut u8)) == 9 as u8 {
            return n
        }
        n = n + 1
    }
    return rest
}

fn zeilen_hoehe() -> u64 {
    return wlibc.px_ui() + wlibc.sc(5)
}

// ==================================================================
// DAS MALEN
//
// Alles laeuft ueber `wlibc.px` und damit ueber den Streifen. Kein
// Widget kennt den Fensterpuffer, kein Widget kennt einen
// Systemaufruf: es malt in Fensterkoordinaten, und die Bibliothek
// entscheidet, welcher Streifen gerade darunter liegt.

fn paint_bg(w: u64, x: u64, y: u64, bw: u64, bh: u64) {
    var c: u64 = wlibc.theme(wlibc.T_BG)
    if ng(w, N_KIND) == NK_DLG {
        c = wlibc.theme(wlibc.T_DLG)
    }
    if ng(w, N_KIND) == NK_MENU {
        c = wlibc.theme(wlibc.T_MENU)
    }
    wlibc.rect(x, y, bw, bh, c)
}

// Text, waagerecht ausgerichtet: 0 links, 1 mittig, 2 rechts.
fn put_text(f: u64, pxs: u64, x: u64, y: u64, bw: u64, p: u64, n: u64,
    farbe: u64, aus: u64) -> u64 {
    if p == 0 || n == 0 {
        return x
    }
    var tx: u64 = x
    if aus != 0 {
        let tw: u64 = wlibc.text_w(f, pxs, p, n)
        if aus == 1 {
            tx = x + sub(bw, tw) / 2
        } else {
            tx = x + sub(bw, tw)
        }
    }
    return wlibc.text_at(f, pxs, tx, y, p, n, farbe)
}

fn focus_ring(i: u64) {
    if s_focus != i + 1 {
        return
    }
    wlibc.frame(g(i, D_X), g(i, D_Y), g(i, D_W), g(i, D_H),
        wlibc.theme(wlibc.T_FOCUS))
}

fn paint_scroll(x: u64, y: u64, h: u64, oben: u64, sicht: u64,
    ganz: u64) {
    wlibc.rect(x, y, 14, h, wlibc.theme(wlibc.T_SCROLL))
    if ganz == 0 || sicht >= ganz {
        return
    }
    var th: u64 = h * sicht / ganz
    if th < 12 {
        th = 12
    }
    if th > h {
        th = h
    }
    var ty: u64 = 0
    if ganz > sicht {
        ty = (h - th) * oben / (ganz - sicht)
    }
    wlibc.rect(x + 2, y + ty, 10, th, wlibc.theme(wlibc.T_THUMB))
}

fn paint_button(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    var flaeche: u64 = wlibc.theme(wlibc.T_BTN)
    if (g(i, D_FLAGS) & F_PRESSED) != 0 {
        flaeche = wlibc.theme(wlibc.T_BTNDN)
    } else if (g(i, D_FLAGS) & F_HOVER) != 0 {
        flaeche = wlibc.theme(wlibc.T_BTNHI)
    }
    wlibc.rect(x, y, bw, bh, flaeche)
    wlibc.frame3(x, y, bw, bh, wlibc.theme(wlibc.T_BTNHI),
        wlibc.theme(wlibc.T_LINE), (g(i, D_FLAGS) & F_PRESSED) != 0)
    var farbe: u64 = wlibc.theme(wlibc.T_FG)
    if (g(i, D_FLAGS) & F_OFF) != 0 {
        farbe = wlibc.theme(wlibc.T_DIM)
    }
    let grund: u64 = y + (bh + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
    put_text(wlibc.F_UI, wlibc.px_ui(), x, grund, bw, g(i, D_TEXT),
        tlen(g(i, D_TEXT)), farbe, 1)
    focus_ring(i)
}

fn paint_label(i: u64) {
    let grund: u64 = g(i, D_Y) + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    put_text(wlibc.F_UI, wlibc.px_ui(), g(i, D_X), grund, g(i, D_W),
        g(i, D_TEXT), tlen(g(i, D_TEXT)), wlibc.theme(wlibc.T_FG), 0)
}

fn paint_check(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let k: u64 = wlibc.sc(14)
    let oy: u64 = y + sub(g(i, D_H), k) / 2
    wlibc.rect(x, oy, k, k, wlibc.theme(wlibc.T_ENTRY))
    wlibc.frame(x, oy, k, k, wlibc.theme(wlibc.T_LINE))
    if g(i, D_VAL) != 0 {
        // Ein Haken aus zwei Strichen, und nicht ein gefuelltes
        // Kaestchen: ein Bildschirmfoto kann einen Haken von einer
        // Auswahlfarbe unterscheiden, eine Fuellung nicht.
        var n: u64 = 0
        while n < 4 {
            wlibc.px(x + 3 + n, oy + 6 + n, wlibc.theme(wlibc.T_ACCENT))
            wlibc.px(x + 3 + n, oy + 7 + n, wlibc.theme(wlibc.T_ACCENT))
            n = n + 1
        }
        n = 0
        while n < 6 {
            wlibc.px(x + 7 + n, oy + 9 - n, wlibc.theme(wlibc.T_ACCENT))
            wlibc.px(x + 7 + n, oy + 10 - n, wlibc.theme(wlibc.T_ACCENT))
            n = n + 1
        }
    }
    let grund: u64 = y + (g(i, D_H)
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
    put_text(wlibc.F_UI, wlibc.px_ui(), x + k + wlibc.sc(6), grund,
        sub(g(i, D_W), k + wlibc.sc(6)),
        g(i, D_TEXT), tlen(g(i, D_TEXT)), wlibc.theme(wlibc.T_FG), 0)
    focus_ring(i)
}

// DAS TEXTFELD, und hier steckt die meiste Arbeit dieser Datei.
//
// Es zeigt eine Zeile, es hat eine EINFUEGEMARKE (`D_B`) und einen
// AUSWAHLANKER (`D_C`). Sind beide gleich, ist nichts ausgewaehlt.
// Sonst liegt die Auswahl zwischen ihnen, und sie wird mit der
// Auswahlfarbe hinterlegt und in der Auswahlvordergrundfarbe gesetzt --
// zwei Textlaeufe statt einem, damit die Farbe wirklich wechselt und
// nicht nur der Hintergrund.
fn entry_x(i: u64, at: u64) -> u64 {
    return g(i, D_X) + wlibc.sc(5) + wlibc.text_w(wlibc.F_UI,
        wlibc.px_ui(), g(i, D_TEXT), at)
}

fn paint_entry(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    wlibc.rect(x, y, bw, bh, wlibc.theme(wlibc.T_ENTRY))
    wlibc.frame(x, y, bw, bh, wlibc.theme(wlibc.T_LINE))
    let p: u64 = g(i, D_TEXT)
    let n: u64 = tlen(p)
    let grund: u64 = y + (bh + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
    var a: u64 = g(i, D_B)
    var b: u64 = g(i, D_C)
    if a > b {
        let t: u64 = a
        a = b
        b = t
    }
    if b > n {
        b = n
    }
    if a > n {
        a = n
    }
    if b > a {
        let x0: u64 = entry_x(i, a)
        let x1: u64 = entry_x(i, b)
        wlibc.rect(x0, y + 3, sub(x1, x0), sub(bh, 6),
            wlibc.theme(wlibc.T_SEL))
    }
    // vor der Auswahl, die Auswahl, danach -- drei Laeufe, damit die
    // ausgewaehlten Zeichen ihre eigene Farbe bekommen.
    var cx: u64 = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(),
        x + wlibc.sc(5), grund, p, a, wlibc.theme(wlibc.T_FG))
    if b > a {
        cx = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), entry_x(i, a), grund,
            p + a, b - a, wlibc.theme(wlibc.T_SELFG))
    }
    if n > b {
        wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), entry_x(i, b), grund, p + b,
            n - b, wlibc.theme(wlibc.T_FG))
    }
    // Die Einfuegemarke -- nur, wenn das Feld den Fokus hat. Ein Feld,
    // das immer eine Marke zeigt, sagt nicht mehr, wohin getippt wird.
    if s_focus == i + 1 {
        let mx: u64 = entry_x(i, g(i, D_B))
        wlibc.rect(mx, y + 3, 2, sub(bh, 6), wlibc.theme(wlibc.T_ACCENT))
    }
    focus_ring(i)
}

// EIN SYMBOL JE ZEILE. `p` zeigt auf ein Feld aus WOERTERN, eines je
// Zeile, und jedes ist entweder
//
//   * ein ZEIGER auf ein Bild im Format OSYM (`tools/k15/icon.py`:
//     vier Oktette "OSYM", Breite, Hoehe, dann Breite mal Hoehe
//     Bildpunkte zu vier Oktetten) -- so liegt es in jedem Buendel unter
//     `/apps/<name>.osp/symbol`, oder
//   * eine FARBE, wenn kein Bild da ist. Dann wird ein Plaettchen in
//     dieser Farbe gemalt und der erste Buchstabe des Namens darauf.
//
// Unterschieden werden die beiden am Kopf: was mit "OSYM" anfaengt, ist
// ein Bild. Ein Zeiger in Ring 3 liegt bei 0x40100000 und eine Farbe
// unter 0x01000000, also waere auch das eine Unterscheidung -- aber eine,
// die von der Speicherkarte abhaengt statt vom Inhalt, und die faellt
// still um, wenn sich die Karte aendert.
//
// WARUM UEBERHAUPT EIN BILD. Der erste Nachtrag hatte nur die Farbe, und
// das war ehrlich, solange dieses System keine Bilddatei lesen konnte.
// Der zweite Nachtrag verlangt ein Buendel, in dem ALLES steckt, was zu
// einem Programm gehoert -- ein Symbol, das in Wahrheit sechs Hexziffern
// in einer Textdatei ist, gehoert nicht dazu. Das Format ist so klein,
// dass der Leser dieser Datei zwanzig Zeilen hat, und es ist trotzdem
// eine Datei mit Bildpunkten darin, die man Punkt fuer Punkt gegen den
// Schirm rechnen kann.
fn list_icons(i: u64, p: u64) {
    s(i, D_D, p)
    dirty_wd(i)
}

// ROUND ICONS: THE THIRD KIND OF ROW SYMBOL, and a list or a table can
// carry it next to the two that already exist.
//
// A word in the array passed here is either 0 (this row has none) or an
// icon out of `lib/icons.fi` with ICON_TAG set.  The tag is bit 63, and
// it is a tag and not a range check for the same reason `ist_bild`
// looks at "OSYM" and not at an address: a rule that depends on where
// something happens to lie in memory falls over silently the day the
// memory map moves.  Bit 63 is set by no pointer this process can hold
// (Ring 3 lives at 0x40100000) and by no colour (colours are 24 bit).
//
// WHY NOT REUSE `list_icons`.  That array means "a picture or a
// colour", it is only read by lists, and it puts a 14 by 14 tile with a
// letter on it where there is no picture.  An icon is neither: it has
// no tile, no letter and no colour of its own -- it takes the colour of
// the row it stands in, which is exactly what makes it work in a light
// and a dark theme without a second set of drawings.
const ICON_TAG: u64 = 9223372036854775808 // 1 << 63

fn icon_id(c: u64) -> u64 {
    return ICON_TAG | c
}

fn row_icons(i: u64, p: u64) {
    s(i, D_ICONS, p)
    dirty_wd(i)
}

// The icon of visible row `z`, or 0.  One place where the array is
// read, so a list and a table cannot disagree about what is in it.
fn icon_at_row(i: u64, z: u64) -> u64 {
    let p: u64 = g(i, D_ICONS)
    if p == 0 {
        return 0
    }
    let w: u64 = __mmio_read64((p + z * 8) as *mut u64)
    if (w & ICON_TAG) == 0 {
        return 0
    }
    return w & 65535
}

// "OSYM" -- vier Oktette, gelesen als eine Zahl waere es von der
// Ausrichtung abhaengig, also Oktett fuer Oktett.
//
// ZUERST DER BEREICH, DANN DIE KENNUNG, und das ist kein Uebereifer: die
// erste Fassung fragte nur `p < 4096` und las danach vier Oktette. Eine
// FARBE wie 0x707880 ist groesser als 4096 -- der Starter setzte genau
// die fuer seine Dateitreffer, und der Prozess starb mit
// `user fault: cr2=0x707880`. Ein Wort ist nur dann ein Zeiger, wenn es
// in den privaten Bereich dieses Prozesses zeigt (`proc.IMAGE_BASE` bis
// zum Ende der privaten Seiten); alles andere ist eine Farbe.
const U_LO: u64 = 0x40100000
const U_HI: u64 = 0x40200000

fn ist_bild(p: u64) -> bool {
    if p < U_LO || p >= U_HI {
        return false
    }
    if __mmio_read8((p) as *mut u8) != 79 as u8 {
        return false
    }
    if __mmio_read8((p + 1) as *mut u8) != 83 as u8 {
        return false
    }
    if __mmio_read8((p + 2) as *mut u8) != 89 as u8 {
        return false
    }
    return __mmio_read8((p + 3) as *mut u8) == 77 as u8
}

fn bild_w(p: u64) -> u64 {
    return __mmio_read32((p + 4) as *mut u32) as u64
}

fn bild_h(p: u64) -> u64 {
    return __mmio_read32((p + 8) as *mut u32) as u64
}

// Das Bild in ein Feld von `kw` mal `kh`. Groesser wird nicht skaliert,
// sondern beschnitten -- ein Symbol, das nicht passt, ist ein Fehler im
// Buendel und soll auffallen, nicht weichgezeichnet werden.
fn bild_malen(p: u64, x: u64, y: u64, kw: u64, kh: u64) {
    let w: u64 = bild_w(p)
    let h: u64 = bild_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return
    }
    var r: u64 = 0
    while r < h && r < kh {
        var c: u64 = 0
        while c < w && c < kw {
            let f: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            // DECKUNG NULL HEISST DURCHSICHTIG, und dann bleibt stehen,
            // was schon da ist -- die Auswahlfarbe der Zeile zum
            // Beispiel. Ohne das haette jedes Symbol einen schwarzen
            // Kasten um sich, und ein Pruefer, der die Zeilenfarbe misst,
            // faende sie an den Ecken nicht.
            if (f >> 24) != 0 {
                wlibc.px(x + c, y + r, f & wlibc.RGB24)
            }
            c = c + 1
        }
        r = r + 1
    }
}

// ROUND ICONS: HOW FAR THE FIRST COLUMN OF A TABLE MOVES RIGHT.
//
// WIDGET-WIDE AND NOT PER ROW, and both reasons matter.  Visually: a
// column whose names start at two different x depending on whether that
// row happens to have an icon is a ragged column.  And for the
// measurement: `cell_x` reports where a cell BEGINS, the file manager
// tells the test runner that number, and the runner then looks for ink
// there.  A per-row indent could not be reported by a per-widget
// function, so the two would disagree -- which is exactly the bug this
// function exists to make impossible.  `paint_table` and `cell_x` both
// go through here.
fn table_ein(i: u64) -> u64 {
    if g(i, D_KIND) == K_TABLE && g(i, D_ICONS) != 0 {
        return wlibc.ICON_SMALL + 4
    }
    return 0
}

fn list_ein(i: u64) -> u64 {
    if g(i, D_KIND) == K_LIST && g(i, D_D) != 0 {
        return 22
    }
    // ROUND ICONS: an icon indents the text by the same amount as a
    // tile, so that a list with icons and a list with tiles line up.
    if g(i, D_KIND) == K_LIST && g(i, D_ICONS) != 0 {
        return 22
    }
    return 0
}

fn paint_list(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    let zh: u64 = zeilen_hoehe()
    let sicht: u64 = sub(bh, 4) / zh
    wlibc.rect(x, y, bw, bh, wlibc.theme(wlibc.T_ENTRY))
    wlibc.frame(x, y, bw, bh, wlibc.theme(wlibc.T_LINE))
    let ganz: u64 = g(i, D_A)
    var r: u64 = 0
    while r < sicht {
        let z: u64 = g(i, D_B) + r
        if z < ganz {
            let q: u64 = row_at(g(i, D_TEXT), z)
            let ln: u64 = row_len(q)
            let ry: u64 = y + 2 + r * zh
            var farbe: u64 = wlibc.theme(wlibc.T_FG)
            if z == g(i, D_VAL) {
                wlibc.rect(x + 1, ry, sub(bw, 16), zh,
                    wlibc.theme(wlibc.T_SEL))
                farbe = wlibc.theme(wlibc.T_SELFG)
            }
            // ROUND ICONS: an icon takes precedence over the tile.
            // A row that has both was a mistake in the caller, and
            // drawing the icon is the answer that loses no information.
            let sym: u64 = icon_at_row(i, z)
            if sym != 0 {
                let _ = wlibc.icon_at(sym, x + 5, ry + 2,
                    wlibc.ICON_SMALL, farbe)
            }
            let ein: u64 = list_ein(i)
            if ein != 0 && sym == 0 {
                let f: u64 = __mmio_read64((g(i, D_D) + z * 8) as *mut u64)
                if ist_bild(f) {
                    // KEIN RAHMEN UEBER EIN BILD. Der erste Entwurf malte
                    // erst das Symbol und dann denselben Rahmen wie um
                    // ein Farbplaettchen -- und ueberschrieb damit die
                    // untere und die rechte Kante des Bildes. Der
                    // Pruefer sah 25 von 169 deckenden Bildpunkten
                    // falsch; im Bild sah man nichts. Ein Symbol bringt
                    // seinen Rand selbst mit oder hat keinen.
                    bild_malen(f, x + 5, ry + 3, 14, 14)
                } else {
                wlibc.rect(x + 5, ry + 3, 14, 14, f)
                wlibc.frame(x + 5, ry + 3, 14, 14, wlibc.theme(wlibc.T_LINE))
                if ln > 0 {
                    // MITTIG AUF DAS PLAETTCHEN, und das ist keine
                    // Feinheit: die erste Fassung setzte den Buchstaben
                    // auf eine feste Stelle, und bei einem breiten
                    // ragte er ueber den Rand -- im Bild sah man einen
                    // Buchstaben, im Pruefer 49 von 67 Tintenpunkten
                    // falsch, weil dort nicht mehr die Farbe des
                    // Plaettchens hinter ihm stand.
                    let bw2: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(),
                        q, 1)
                    // WEISS WAR FALSCH, UND ZWAR MESSBAR: die Farbe
                    // des Plaettchens kommt aus der Anwendung, und auf
                    // einem hellen Plaettchen ist ein weisser
                    // Buchstabe nicht zu lesen. `theme_on` rechnet den
                    // Kontrast beider Kandidaten aus und nimmt den
                    // besseren -- dieselbe Rechnung, mit der die
                    // Akzentfarbe ihre Schriftfarbe bekommt.
                    wlibc.text_at(wlibc.F_UI, wlibc.px_ui(),
                        x + 5 + sub(14, bw2) / 2, ry + 3 + 12, q, 1,
                        wlibc.theme_on(f))
                }
                }
            }
            wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), x + 6 + ein,
                ry + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()) + 1, q, ln,
                farbe)
        }
        r = r + 1
    }
    paint_scroll(x + bw - 15, y + 1, sub(bh, 2), g(i, D_B), sicht, ganz)
    focus_ring(i)
}

fn spalte_breit(i: u64, c: u64) -> u64 {
    let p: u64 = g(i, D_D)
    if p == 0 {
        return 100
    }
    return __mmio_read64((p + c * 8) as *mut u64)
}

fn paint_table(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    let zh: u64 = zeilen_hoehe()
    let kopf: u64 = zh + 4
    let sicht: u64 = sub(sub(bh, 4), kopf) / zh
    let cols: u64 = g(i, D_C)
    wlibc.rect(x, y, bw, bh, wlibc.theme(wlibc.T_ENTRY))
    // DIE KOPFZEILE. Sie ist Zeile 0 des Textblocks -- so steht die
    // Beschriftung in derselben Quelle wie die Daten, und eine Spalte,
    // die dazukommt, kann nicht vergessen werden.
    wlibc.rect(x + 1, y + 1, sub(bw, 2), kopf, wlibc.theme(wlibc.T_HEAD))
    let kq: u64 = row_at(g(i, D_TEXT), 0)
    let kl: u64 = row_len(kq)
    var cx: u64 = x + 6
    var c: u64 = 0
    while c < cols {
        let q: u64 = col_at(kq, kl, c)
        if q != 0 {
            let ln: u64 = col_len(q, sub(kl, sub(q, kq)))
            // ROUND ICONS: the heading of the first column moves right
            // with its data.  Only the TEXT -- `cx` keeps carrying the
            // column geometry, because the separator lines below use it
            // and they must stay where the columns are.
            var hx: u64 = cx
            if c == 0 {
                hx = cx + table_ein(i)
            }
            wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), hx,
                y + 3 + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()), q, ln,
                wlibc.theme(wlibc.T_FG))
        }
        cx = cx + spalte_breit(i, c)
        if c + 1 < cols {
            wlibc.vline(cx - 4, y + 1, kopf, wlibc.theme(wlibc.T_LINE))
        }
        c = c + 1
    }
    wlibc.hline(x + 1, y + kopf, sub(bw, 2), wlibc.theme(wlibc.T_LINE))
    let ganz: u64 = sub(g(i, D_A), 1)
    var r: u64 = 0
    while r < sicht {
        let z: u64 = g(i, D_B) + r
        if z < ganz {
            let q: u64 = row_at(g(i, D_TEXT), z + 1)
            let ln: u64 = row_len(q)
            let ry: u64 = y + kopf + 1 + r * zh
            var farbe: u64 = wlibc.theme(wlibc.T_FG)
            if z == g(i, D_VAL) {
                wlibc.rect(x + 1, ry, sub(bw, 16), zh,
                    wlibc.theme(wlibc.T_SEL))
                farbe = wlibc.theme(wlibc.T_SELFG)
            }
            var tx: u64 = x + 6
            // ROUND ICONS: the icon of the row goes in front of the
            // FIRST column, and only the first column moves right.  A
            // table whose every column shifted would have its header
            // over the wrong data.
            let einr: u64 = table_ein(i)
            let sym: u64 = icon_at_row(i, z)
            if sym != 0 {
                let _ = wlibc.icon_at(sym, tx, ry + 2, wlibc.ICON_SMALL,
                    farbe)
            }
            c = 0
            while c < cols {
                let cq: u64 = col_at(q, ln, c)
                if cq != 0 {
                    var cl: u64 = col_len(cq, sub(ln, sub(cq, q)))
                    // was nicht in die Spalte passt, wird abgeschnitten
                    // und nicht in die naechste geschrieben
                    // RUNDE I18N: `fit` statt "ein Oktett weniger, bis
                    // es passt". Die alte Schleife hat ein Zeichen
                    // zerteilt, sobald die Spalte mitten in einem
                    // Umlaut endete.
                    let platz: u64 = sub(spalte_breit(i, c), 6)
                    cl = wlibc.fit(wlibc.F_UI, wlibc.px_ui(), cq, cl, platz)
                    var f2: u64 = farbe
                    if c > 0 && z != g(i, D_VAL) {
                        f2 = wlibc.theme(wlibc.T_DIM)
                    }
                    var txx: u64 = tx
                    if c == 0 {
                        txx = tx + einr
                    }
                    wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), txx,
                        ry + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()) + 1,
                        cq, cl, f2)
                }
                tx = tx + spalte_breit(i, c)
                c = c + 1
            }
        }
        r = r + 1
    }
    wlibc.frame(x, y, bw, bh, wlibc.theme(wlibc.T_LINE))
    paint_scroll(x + bw - 15, y + kopf + 1, sub(sub(bh, kopf), 2),
        g(i, D_B), sicht, ganz)
    focus_ring(i)
}

fn tab_breite(i: u64, k: u64) -> u64 {
    let q: u64 = row_at(g(i, D_TEXT), k)
    if q == 0 {
        return 0
    }
    return wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q, row_len(q))
        + wlibc.sc(20)
}

// RUNDE I18N: WO EIN REITER LIEGT.
//
// Aus demselben Grund, aus dem es seit Runde K15 `text_x` und
// `text_base` gibt: ohne diese beiden Zahlen muesste ein Testlaeufer
// die Breite eines Reiters aus der Schrift NACHRECHNEN, um ihn
// anklicken zu koennen -- und rechnete dann eine zweite Fassung von
// `tab_breite` nach, die auseinanderlaufen kann. Die Breite haengt am
// Text, der Text haengt an der Sprache, und die Sprache ist genau das,
// was diese Runde umstellt: auf Englisch ist "Language" schmaler als
// "Sprache" breit ist. Wer hier raet, klickt in einer der beiden
// Sprachen daneben.
fn tab_x(i: u64, k: u64) -> u64 {
    var x: u64 = g(i, D_X)
    var t: u64 = 0
    while t < k && t < 8 {
        x = x + tab_breite(i, t)
        t = t + 1
    }
    return x
}

fn tab_w(i: u64, k: u64) -> u64 {
    return tab_breite(i, k)
}

fn paint_tabs(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bh: u64 = g(i, D_H)
    wlibc.rect(x, y, g(i, D_W), bh, wlibc.theme(wlibc.T_PANEL))
    var tx: u64 = x
    var k: u64 = 0
    while k < 8 {
        let q: u64 = row_at(g(i, D_TEXT), k)
        if q == 0 {
            k = 8
        } else {
            let tw: u64 = tab_breite(i, k)
            var flaeche: u64 = wlibc.theme(wlibc.T_PANEL)
            var farbe: u64 = wlibc.theme(wlibc.T_DIM)
            if k == g(i, D_VAL) {
                flaeche = wlibc.theme(wlibc.T_BG)
                farbe = wlibc.theme(wlibc.T_FG)
            }
            wlibc.rect(tx, y, tw, bh, flaeche)
            wlibc.vline(tx, y, bh, wlibc.theme(wlibc.T_LINE))
            if k == g(i, D_VAL) {
                wlibc.hline(tx, y, tw, wlibc.theme(wlibc.T_ACCENT))
                wlibc.hline(tx, y + 1, tw, wlibc.theme(wlibc.T_ACCENT))
            } else {
                wlibc.hline(tx, y + bh - 1, tw, wlibc.theme(wlibc.T_LINE))
            }
            put_text(wlibc.F_UI, wlibc.px_ui(), tx,
                y + (bh + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2, tw,
                q, row_len(q), farbe, 1)
            tx = tx + tw
            k = k + 1
        }
    }
    wlibc.hline(tx, y + bh - 1, sub(x + g(i, D_W), tx),
        wlibc.theme(wlibc.T_LINE))
    focus_ring(i)
}

fn paint_menubar(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    wlibc.rect(x, y, g(i, D_W), g(i, D_H), wlibc.theme(wlibc.T_PANEL))
    var tx: u64 = x + wlibc.sc(4)
    var k: u64 = 0
    while k < 8 {
        let q: u64 = row_at(g(i, D_TEXT), k)
        if q == 0 {
            k = 8
        } else {
            let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                row_len(q)) + wlibc.sc(16)
            if k + 1 == g(i, D_VAL) {
                wlibc.rect(tx, y, tw, g(i, D_H), wlibc.theme(wlibc.T_SEL))
            }
            put_text(wlibc.F_UI, wlibc.px_ui(), tx,
                y + (g(i, D_H) + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()))
                / 2, tw, q, row_len(q), wlibc.theme(wlibc.T_FG), 1)
            tx = tx + tw
            k = k + 1
        }
    }
}

fn paint_choice(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    wlibc.rect(x, y, bw, bh, wlibc.theme(wlibc.T_BTN))
    wlibc.frame3(x, y, bw, bh, wlibc.theme(wlibc.T_BTNHI),
        wlibc.theme(wlibc.T_LINE), false)
    let q: u64 = row_at(g(i, D_TEXT), g(i, D_VAL))
    if q != 0 {
        put_text(wlibc.F_UI, wlibc.px_ui(), x + wlibc.sc(6),
            y + (bh + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2,
            sub(bw, wlibc.sc(28)), q,
            row_len(q), wlibc.theme(wlibc.T_FG), 0)
    }
    // Das Dreieck rechts -- sechs Zeilen, von aussen nach innen.
    var n: u64 = 0
    while n < 5 {
        wlibc.hline(x + bw - 16 + n, y + bh / 2 - 2 + n, 10 - 2 * n,
            wlibc.theme(wlibc.T_FG))
        n = n + 1
    }
    focus_ring(i)
}

fn paint_sep(i: u64) {
    wlibc.hline(g(i, D_X), g(i, D_Y) + g(i, D_H) / 2, g(i, D_W),
        wlibc.theme(wlibc.T_LINE))
}

fn paint_one(i: u64) {
    let k: u64 = g(i, D_KIND)
    if (g(i, D_FLAGS) & F_HIDE) != 0 {
        return
    }
    if k == K_LABEL {
        paint_label(i)
    } else if k == K_BUTTON {
        paint_button(i)
    } else if k == K_CHECK {
        paint_check(i)
    } else if k == K_ENTRY {
        paint_entry(i)
    } else if k == K_LIST {
        paint_list(i)
    } else if k == K_TABLE {
        paint_table(i)
    } else if k == K_TABS {
        paint_tabs(i)
    } else if k == K_MENUBAR {
        paint_menubar(i)
    } else if k == K_CHOICE {
        paint_choice(i)
    } else if k == K_SEP {
        paint_sep(i)
    } else if k == K_SCROLL {
        paint_scroll(g(i, D_X), g(i, D_Y), g(i, D_H), g(i, D_VAL),
            g(i, D_B), g(i, D_A))
    }
}

// EIN MENUEFENSTER. Es hat keine Widgets -- es ist eine Liste von
// Zeilen und ein Rahmen. Der Grund: ein Menue ist der einzige Fall, in
// dem ein FENSTER genau ein Widget ist, und eine Widgetliste dafuer
// waere eine Verwaltung ohne Nutzen.
fn paint_menu(w: u64) {
    let zh: u64 = zeilen_hoehe() + 2
    wlibc.rect(0, 0, ng(w, N_W), ng(w, N_HH), wlibc.theme(wlibc.T_MENU))
    var k: u64 = 0
    while k < ng(w, N_CNT) {
        let q: u64 = row_at(ng(w, N_DATA), k)
        if q != 0 {
            let ry: u64 = 2 + k * zh
            var farbe: u64 = wlibc.theme(wlibc.T_FG)
            if k + 1 == ng(w, N_VAL) {
                wlibc.rect(1, ry, sub(ng(w, N_W), 2), zh,
                    wlibc.theme(wlibc.T_SEL))
                farbe = wlibc.theme(wlibc.T_SELFG)
            }
            wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), 8,
                ry + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()) + 1, q,
                row_len(q), farbe)
        }
        k = k + 1
    }
    wlibc.frame(0, 0, ng(w, N_W), ng(w, N_HH), wlibc.theme(wlibc.T_ACCENT))
}

// DAS NEUZEICHNEN -- STREIFEN FUER STREIFEN.
//
// Der schmutzige Bereich wird in so viele Streifen zerlegt, wie die
// Flaeche hoch ist. Je Streifen: Hintergrund, alle Widgets, die ihn
// beruehren, und EIN Aufruf hinueber. Ein Widget, das drei Streifen
// beruehrt, wird dreimal gezeichnet -- was es kostet, ist der Anteil,
// der ohnehin gezeichnet wird, und was es spart, ist der ganze Puffer.
fn flush_win(w: u64) -> u64 {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return 0
    }
    let n: u64 = ng(w, N_NDIRT)
    ns(w, N_NDIRT, 0)
    var gemalt: u64 = 0
    var k: u64 = 0
    while k < n {
        gemalt = gemalt + flush_rect(w, dg(w, k, 0), dg(w, k, 1),
            dg(w, k, 2), dg(w, k, 3))
        k = k + 1
    }
    return gemalt
}

fn flush_rect(w: u64, x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    var gemalt: u64 = 0
    var yb: u64 = y0
    while yb < y1 {
        var ye: u64 = yb + wlibc.surf_rows()
        if ye > y1 {
            ye = y1
        }
        wlibc.set_band(yb)
        wlibc.clip_set(x0, yb, x1, ye)
        paint_bg(w, x0, yb, x1 - x0, ye - yb)
        if ng(w, N_KIND) == NK_MENU {
            paint_menu(w)
        } else {
            var i: u64 = 0
            while i < nwd {
                if g(i, D_WIN) == w {
                    if g(i, D_Y) < ye && g(i, D_Y) + g(i, D_H) > yb {
                        paint_one(i)
                    }
                }
                i = i + 1
            }
        }
        wlibc.push(ng(w, N_H), x0, yb, x1 - x0, ye - yb)
        s_blits = s_blits + 1
        gemalt = gemalt + (x1 - x0) * (ye - yb)
        yb = ye
    }
    return gemalt
}

fn draw_all() {
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            dirty_all(w)
        }
        w = w + 1
    }
    let _g: u64 = paint_all()
}

// ==================================================================
// DIE EINGABE
//
// DIE TREFFERPRUEFUNG IST DIE STELLE, AN DER `nohit` ANSETZT. Ohne sie
// kommen dieselben Ereignisse an, dieselben Zaehler laufen hoch -- und
// kein Widget erfaehrt davon. Das ist die Gegenprobe zu jeder Zusage
// ueber einen Klick: sie MUSS damit einbrechen.
fn hit_at(w: u64, x: u64, y: u64) -> u64 {
    if s_nohit != 0 {
        return MAXWD
    }
    var i: u64 = 0
    while i < nwd {
        if g(i, D_WIN) == w && (g(i, D_FLAGS) & (F_HIDE | F_OFF)) == 0 {
            if x >= g(i, D_X) && x < g(i, D_X) + g(i, D_W) {
                if y >= g(i, D_Y) && y < g(i, D_Y) + g(i, D_H) {
                    return i
                }
            }
        }
        i = i + 1
    }
    return MAXWD
}

fn ticks() -> u64 {
    return ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
}

fn fire(i: u64, kind: u64, index: u64, w: u64) {
    s_fired = i + 1
    s_fkind = kind
    s_findex = index
    s_fwin = w
}

// Welche Zeile einer Liste/Tabelle liegt unter dieser Stelle? MAXWD,
// wenn keine.
fn row_under(i: u64, y: u64) -> u64 {
    let zh: u64 = zeilen_hoehe()
    var oben: u64 = g(i, D_Y) + 2
    if g(i, D_KIND) == K_TABLE {
        oben = g(i, D_Y) + zh + 5
    }
    if y < oben {
        return MAXWD
    }
    let r: u64 = (y - oben) / zh + g(i, D_B)
    var ganz: u64 = g(i, D_A)
    if g(i, D_KIND) == K_TABLE {
        ganz = sub(ganz, 1)
    }
    if r >= ganz {
        return MAXWD
    }
    return r
}

fn scroll_to(i: u64, z: u64) {
    let zh: u64 = zeilen_hoehe()
    var sicht: u64 = sub(g(i, D_H), 4) / zh
    if g(i, D_KIND) == K_TABLE {
        sicht = sub(sub(g(i, D_H), 4), zh + 4) / zh
    }
    if sicht == 0 {
        return
    }
    if z < g(i, D_B) {
        s(i, D_B, z)
    } else if z >= g(i, D_B) + sicht {
        s(i, D_B, z - sicht + 1)
    }
}

fn on_down(w: u64, x: u64, y: u64, btn: u64) {
    // Ein Menuefenster: die Zeile unter dem Zeiger waehlen.
    if ng(w, N_KIND) == NK_MENU {
        if s_nohit != 0 {
            return
        }
        let zh: u64 = zeilen_hoehe() + 2
        if y >= 2 {
            let k: u64 = (y - 2) / zh
            if k < ng(w, N_CNT) {
                ns(w, N_VAL, k + 1)
                fire(ng(w, N_OWNER), K_MENUBAR, k, w)
            }
        }
        return
    }
    let i: u64 = hit_at(w, x, y)
    if i >= MAXWD {
        return
    }
    let k: u64 = g(i, D_KIND)
    if (g(i, D_FLAGS) & F_FOCUSABLE) != 0 {
        set_focus(i)
    }
    if k == K_BUTTON {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_PRESSED)
        s_down = i + 1
        dirty_wd(i)
        return
    }
    if k == K_CHECK {
        s(i, D_VAL, 1 - g(i, D_VAL))
        dirty_wd(i)
        fire(i, K_CHECK, g(i, D_VAL), w)
        return
    }
    if k == K_ENTRY {
        // Die Einfuegemarke dorthin, wo geklickt wurde -- Zeichen fuer
        // Zeichen nachgerechnet und nicht durch die mittlere Breite
        // geteilt: bei einer Proportionalschrift waere das um bis zu
        // ein halbes Zeichen daneben.
        let p: u64 = g(i, D_TEXT)
        let n: u64 = tlen(p)
        var at: u64 = 0
        while at < n && entry_x(i, at + 1) <= x {
            at = at + 1
        }
        s(i, D_B, at)
        s(i, D_C, at)
        s_down = i + 1
        dirty_wd(i)
        return
    }
    if k == K_LIST || k == K_TABLE {
        // die Bildlaufleiste?
        if x >= g(i, D_X) + g(i, D_W) - 16 {
            let zh: u64 = zeilen_hoehe()
            var sicht: u64 = sub(g(i, D_H), 4) / zh
            if k == K_TABLE {
                sicht = sub(sub(g(i, D_H), 4), zh + 4) / zh
            }
            var ganz: u64 = g(i, D_A)
            if k == K_TABLE {
                ganz = sub(ganz, 1)
            }
            if ganz > sicht {
                let rel: u64 = sub(y, g(i, D_Y))
                let z: u64 = rel * ganz / g(i, D_H)
                var oben: u64 = z
                if oben + sicht > ganz {
                    oben = ganz - sicht
                }
                s(i, D_B, oben)
                dirty_wd(i)
            }
            return
        }
        // die Kopfzeile einer Tabelle: nach dieser Spalte sortieren
        if k == K_TABLE && y < g(i, D_Y) + zeilen_hoehe() + 5 {
            var cx: u64 = g(i, D_X) + 2
            var c: u64 = 0
            while c < g(i, D_C) {
                if x >= cx && x < cx + spalte_breit(i, c) {
                    fire(i, K_TABLE, c, w)
                    s(i, D_C, g(i, D_C))
                    c = g(i, D_C)
                } else {
                    cx = cx + spalte_breit(i, c)
                    c = c + 1
                }
            }
            return
        }
        let r: u64 = row_under(i, y)
        if r < MAXWD {
            let jetzt: u64 = ticks()
            var doppelt: bool = false
            if s_lastwd == i + 1 && s_lastclick != 0 {
                if jetzt - s_lastclick < 100 && g(i, D_VAL) == r {
                    doppelt = true
                }
            }
            s(i, D_VAL, r)
            s_lastclick = jetzt
            s_lastwd = i + 1
            dirty_wd(i)
            if doppelt {
                fire(i, K_LIST, r, w)
                s_lastclick = 0
            } else if (btn & 2) != 0 {
                // DIE RECHTE TASTE IST BIT 1 UND NICHT BIT 2. Der
                // PS/2-Baustein legt links auf Bit 0, RECHTS auf Bit 1
                // und die Mitte auf Bit 2 (`kernel/ps2m.fi`); der
                // QEMU-Monitor nimmt fuer `mouse_button` dieselbe
                // Reihenfolge (1 links, 2 rechts, 4 Mitte). Die erste
                // Fassung dieser Zeile pruefte auf 4 -- das ist die
                // MITTLERE Taste, und das Kontextmenue klappte nie auf,
                // ohne dass irgendwo ein Fehler stand.
                fire(i, K_SCROLL, r, w)
            }
        }
        return
    }
    if k == K_TABS {
        var tx: u64 = g(i, D_X)
        var t: u64 = 0
        while t < 8 {
            let tw: u64 = tab_breite(i, t)
            if tw == 0 {
                t = 8
            } else if x >= tx && x < tx + tw {
                if g(i, D_VAL) != t {
                    s(i, D_VAL, t)
                    dirty_wd(i)
                    fire(i, K_TABS, t, w)
                }
                t = 8
            } else {
                tx = tx + tw
                t = t + 1
            }
        }
        return
    }
    if k == K_MENUBAR {
        var tx: u64 = g(i, D_X) + wlibc.sc(4)
        var t: u64 = 0
        while t < 8 {
            let q: u64 = row_at(g(i, D_TEXT), t)
            if q == 0 {
                t = 8
            } else {
                let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                    row_len(q)) + wlibc.sc(16)
                if x >= tx && x < tx + tw {
                    s(i, D_VAL, t + 1)
                    dirty_wd(i)
                    fire(i, K_MENUBAR, 0x1000 + t, w)
                    t = 8
                } else {
                    tx = tx + tw
                    t = t + 1
                }
            }
        }
        return
    }
    if k == K_CHOICE {
        fire(i, K_CHOICE, 0x1000, w)
        return
    }
}

fn on_up(w: u64, x: u64, y: u64) {
    if s_down != 0 {
        let i: u64 = s_down - 1
        s_down = 0
        if g(i, D_KIND) == K_BUTTON {
            s(i, D_FLAGS, g(i, D_FLAGS) & ~F_PRESSED)
            dirty_wd(i)
            // Nur, wenn losgelassen wurde, WO gedrueckt wurde -- so wie
            // jeder Knopf seit vierzig Jahren.
            if hit_at(w, x, y) == i {
                fire(i, K_BUTTON, 0, w)
            }
        }
    }
}

fn on_move(w: u64, x: u64, y: u64, btn: u64) {
    if ng(w, N_KIND) == NK_MENU {
        let zh: u64 = zeilen_hoehe() + 2
        var k: u64 = ng(w, N_CNT)
        if y >= 2 {
            k = (y - 2) / zh
        }
        if k < ng(w, N_CNT) && ng(w, N_VAL) != k + 1 {
            ns(w, N_VAL, k + 1)
            dirty_all(w)
        }
        return
    }
    let i: u64 = hit_at(w, x, y)
    // Das Zeigerbild: ueber einem Textfeld ein Balken, sonst ein Pfeil.
    // Es ist der einzige Weg, auf dem eine Anwendung dem SERVER etwas
    // ueber den Zeiger sagt, und deshalb steht er im Logbuch.
    if i < MAXWD && g(i, D_KIND) == K_ENTRY {
        wlibc.cursor_shape(1)
    } else {
        wlibc.cursor_shape(0)
    }
    // Ziehen im Textfeld waehlt aus. Umschalt-Pfeil gibt es hier nicht:
    // die Zeilendisziplin liefert das FERTIGE Zeichen, die Umschalttaste
    // kommt nie als eigenes Ereignis an. Also waehlt die Maus.
    if s_down != 0 && (btn & 1) != 0 {
        let d: u64 = s_down - 1
        if g(d, D_KIND) == K_ENTRY {
            let p: u64 = g(d, D_TEXT)
            let n: u64 = tlen(p)
            // RUNDE I18N: der Sprung ist ein ZEICHEN, nicht ein Oktett
            // -- sonst setzt ein Mausklick die Marke zwischen die
            // beiden Haelften eines Umlauts.
            var at: u64 = 0
            var fertig: bool = false
            while at < n && !fertig {
                let w2: u64 = at + cp_len(p, n, at)
                if entry_x(d, w2) > x {
                    fertig = true
                } else {
                    at = w2
                }
            }
            if at != g(d, D_B) {
                s(d, D_B, at)
                dirty_wd(d)
            }
            return
        }
    }
    var k2: u64 = 0
    while k2 < nwd {
        if g(k2, D_WIN) == w {
            let alt: bool = (g(k2, D_FLAGS) & F_HOVER) != 0
            let neu: bool = k2 == i
            if alt != neu {
                if neu {
                    s(k2, D_FLAGS, g(k2, D_FLAGS) | F_HOVER)
                } else {
                    s(k2, D_FLAGS, g(k2, D_FLAGS) & ~F_HOVER)
                }
                if g(k2, D_KIND) == K_BUTTON {
                    dirty_wd(k2)
                }
            }
        }
        k2 = k2 + 1
    }
}

// ------------------------------------------------- die Tastatur

// DIE FLUCHTFOLGEN. Die Zeilendisziplin dieses Systems schickt
// Pfeiltasten als `ESC [ D` und Seitentasten als `ESC [ 5 ~` -- so, wie
// ein VT100 es tut und wie `kernel/kbd.fi` es aufsetzt. Ein Ereignis
// traegt EIN Oktett, also steht die Zustandsmaschine hier.
//
// EINE AUSNAHME, und sie ist aelter als diese Runde: die Pfeiltaste
// nach oben kommt als EIN Oktett 14. `kernel/kbd.fi` sagt warum.
fn decode(c: u64) -> u64 {
    if s_esc == 0 {
        if c == 27 {
            s_esc = 1
            return 0
        }
        if c == 14 {
            return KEY_UP
        }
        return c
    }
    if s_esc == 1 {
        if c == 91 {
            s_esc = 2
            return 0
        }
        s_esc = 0
        return KEY_ESC
    }
    if s_esc == 2 {
        if c >= 48 && c <= 57 {
            s_esc = 3 + (c - 48)
            return 0
        }
        s_esc = 0
        if c == 65 {
            return KEY_UP
        }
        if c == 66 {
            return KEY_DOWN
        }
        if c == 67 {
            return KEY_RIGHT
        }
        if c == 68 {
            return KEY_LEFT
        }
        if c == 90 {
            return KEY_BACKTAB
        }
        if c == 72 {
            return KEY_HOME
        }
        if c == 70 {
            return KEY_END
        }
        return 0
    }
    // `ESC [ n ~`
    let n: u64 = s_esc - 3
    s_esc = 0
    if c != 126 {
        return 0
    }
    if n == 5 {
        return KEY_PGUP
    }
    if n == 6 {
        return KEY_PGDN
    }
    if n == 3 {
        return KEY_DEL
    }
    if n == 1 {
        return KEY_HOME
    }
    if n == 4 {
        return KEY_END
    }
    return 0
}

fn next_focus(w: u64, rueckwaerts: bool) {
    var n: u64 = 0
    var erste: u64 = MAXWD
    var letzte: u64 = MAXWD
    var vor: u64 = MAXWD
    var nach: u64 = MAXWD
    let jetzt: u64 = focus_id()
    var i: u64 = 0
    while i < nwd {
        if g(i, D_WIN) == w
            && (g(i, D_FLAGS) & (F_HIDE | F_OFF)) == 0
            && (g(i, D_FLAGS) & F_FOCUSABLE) != 0 {
            if erste == MAXWD {
                erste = i
            }
            letzte = i
            if i < jetzt {
                vor = i
            }
            if i > jetzt && nach == MAXWD {
                nach = i
            }
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 {
        return
    }
    var ziel: u64 = nach
    if rueckwaerts {
        ziel = vor
        if ziel == MAXWD {
            ziel = letzte
        }
    } else if ziel == MAXWD {
        ziel = erste
    }
    set_focus(ziel)
}

fn entry_erase(i: u64) -> bool {
    var a: u64 = g(i, D_B)
    var b: u64 = g(i, D_C)
    if a == b {
        return false
    }
    if a > b {
        let t: u64 = a
        a = b
        b = t
    }
    let p: u64 = g(i, D_TEXT)
    let n: u64 = tlen(p)
    var k: u64 = b
    while k <= n {
        __mmio_write8((p + a + (k - b)) as *mut u8,
            *((p + k) as *mut u8))
        k = k + 1
    }
    s(i, D_B, a)
    s(i, D_C, a)
    return true
}

fn entry_insert(i: u64, c: u64) {
    let p: u64 = g(i, D_TEXT)
    entry_erase(i)
    var n: u64 = tlen(p)
    if n + 1 >= g(i, D_D) {
        return
    }
    let at: u64 = g(i, D_B)
    var k: u64 = n + 1
    while k > at {
        __mmio_write8((p + k) as *mut u8, *((p + k - 1) as *mut u8))
        k = k - 1
    }
    __mmio_write8((p + at) as *mut u8, c as u8)
    s(i, D_B, at + 1)
    s(i, D_C, at + 1)
}

// RUNDE I18N: die Laenge des Zeichens, das bei `at` beginnt. Steht
// `at` auf einer Fortsetzung -- was nach dieser Runde nicht mehr
// vorkommen soll --, kommt 1 heraus, und der Zeiger bewegt sich
// wenigstens.
fn cp_len(p: u64, n: u64, at: u64) -> u64 {
    let l: u64 = utf8.seq_len(p, n, at)
    if l == 0 {
        return 1
    }
    return l
}

// Ist dieses OKTETT eines, das in ein Textfeld gehoert? Bis Runde I18N
// hiess das `c >= 32 && c < 127` -- reines ASCII, und jedes Oktett
// eines Umlauts (0xC3, 0xB6) fiel stillschweigend weg. Jetzt: alles ab
// 32 ausser 127. Die Oktette einer Mehr-Oktett-Folge kommen von der
// Tastatur NACHEINANDER und landen dadurch nebeneinander im Feld --
// genau die Folge, die `utf8.next` beim Zeichnen wieder zusammensetzt.
fn druckbar(c: u64) -> bool {
    return c >= 32 && c != 127 && c < 256
}

fn entry_key(i: u64, k: u64) {
    let p: u64 = g(i, D_TEXT)
    let n: u64 = tlen(p)
    // RUNDE I18N: DIE EINFUEGEMARKE SPRINGT UEBER ZEICHEN, NICHT UEBER
    // OKTETTE. `D_B` und `D_C` bleiben OKTETTVERSATZE -- alles andere
    // hier rechnet damit, und `entry_x` misst damit --, aber sie stehen
    // ab jetzt IMMER auf einer Zeichengrenze. Der Pfeil nach links geht
    // sonst mitten in einen Umlaut hinein, und die naechste Taste
    // zerteilt ihn.
    if k == KEY_LEFT {
        s(i, D_B, wlibc.back(p, g(i, D_B)))
        s(i, D_C, g(i, D_B))
    } else if k == KEY_RIGHT {
        if g(i, D_B) < n {
            s(i, D_B, g(i, D_B) + cp_len(p, n, g(i, D_B)))
        }
        s(i, D_C, g(i, D_B))
    } else if k == KEY_HOME {
        s(i, D_B, 0)
        s(i, D_C, 0)
    } else if k == KEY_END {
        s(i, D_B, n)
        s(i, D_C, n)
    } else if k == KEY_BS || k == 127 {
        // GANZ ZURUECK, NICHT EIN OKTETT ZURUECK. Ein Rueckschritt, der
        // ein Oktett loescht, laesst von einem Umlaut die erste Haelfte
        // stehen -- eine kaputte Folge, die als Ersatzzeichen erscheint
        // und beim naechsten Rueckschritt noch eine haesslichere ergibt.
        if !entry_erase(i) {
            if g(i, D_B) > 0 {
                let at: u64 = wlibc.back(p, g(i, D_B))
                let weg: u64 = g(i, D_B) - at
                var q: u64 = at
                while q + weg <= n {
                    __mmio_write8((p + q) as *mut u8,
                        *((p + q + weg) as *mut u8))
                    q = q + 1
                }
                s(i, D_B, at)
                s(i, D_C, at)
            }
        }
    } else if k == KEY_DEL {
        if !entry_erase(i) {
            if g(i, D_B) < n {
                let weg2: u64 = cp_len(p, n, g(i, D_B))
                var q2: u64 = g(i, D_B)
                while q2 + weg2 <= n {
                    __mmio_write8((p + q2) as *mut u8,
                        *((p + q2 + weg2) as *mut u8))
                    q2 = q2 + 1
                }
            }
        }
    } else if k == 1 {
        // STRG-A: alles auswaehlen
        s(i, D_C, 0)
        s(i, D_B, n)
    } else if k == 3 || k == 24 {
        // STRG-C / STRG-X
        var a: u64 = g(i, D_B)
        var b: u64 = g(i, D_C)
        if a > b {
            let t: u64 = a
            a = b
            b = t
        }
        if b > a {
            wlibc.clip_put(p + a, b - a)
            if k == 24 {
                entry_erase(i)
            }
        }
    } else if k == 22 {
        // STRG-V
        var ein: [u8; 128] = [0 as u8; 128]
        let m: u64 = wlibc.clip_take((&ein[0 as usize]) as u64, 127)
        var q3: u64 = 0
        while q3 < m {
            let c: u64 = (ein[(q3) as usize]) as u64
            if druckbar(c) {
                entry_insert(i, c)
            }
            q3 = q3 + 1
        }
    } else if druckbar(k) {
        entry_insert(i, k)
    }
    dirty_wd(i)
}

fn on_key(w: u64, c: u64) {
    let k: u64 = decode(c)
    if k == 0 {
        return
    }
    s_keylast = k
    if ng(w, N_KIND) == NK_MENU {
        let zh: u64 = ng(w, N_CNT)
        if k == KEY_DOWN && ng(w, N_VAL) < zh {
            ns(w, N_VAL, ng(w, N_VAL) + 1)
            dirty_all(w)
        } else if k == KEY_UP && ng(w, N_VAL) > 1 {
            ns(w, N_VAL, ng(w, N_VAL) - 1)
            dirty_all(w)
        } else if k == KEY_ENTER && ng(w, N_VAL) > 0 {
            fire(ng(w, N_OWNER), K_MENUBAR, ng(w, N_VAL) - 1, w)
        } else if k == KEY_ESC {
            ns(w, N_VAL, 0)
            fire(ng(w, N_OWNER), K_MENUBAR, 0xFFFF, w)
        }
        return
    }
    if k == KEY_TAB {
        next_focus(w, false)
        return
    }
    // RUNDE A11Y: UMSCHALT-TAB GEHT RUECKWAERTS. Die Schleife
    // rueckwaerts gab es schon (`next_focus(w, true)`) -- sie war nur
    // von keiner Taste aus erreichbar, weil die Tastatur Umschalt-Tab
    // nicht von Tab unterschied.
    if k == KEY_BACKTAB {
        next_focus(w, true)
        return
    }
    let i: u64 = focus_id()
    if i >= MAXWD || g(i, D_WIN) != w {
        return
    }
    let kind: u64 = g(i, D_KIND)
    if kind == K_ENTRY {
        if k == KEY_ENTER {
            fire(i, K_ENTRY, 0, w)
            return
        }
        entry_key(i, k)
        return
    }
    if kind == K_BUTTON {
        if k == KEY_ENTER || k == 32 {
            fire(i, K_BUTTON, 0, w)
        }
        return
    }
    if kind == K_CHECK {
        if k == KEY_ENTER || k == 32 {
            s(i, D_VAL, 1 - g(i, D_VAL))
            dirty_wd(i)
            fire(i, K_CHECK, g(i, D_VAL), w)
        }
        return
    }
    if kind == K_LIST || kind == K_TABLE {
        var ganz: u64 = g(i, D_A)
        if kind == K_TABLE {
            ganz = sub(ganz, 1)
        }
        if ganz == 0 {
            return
        }
        var v: u64 = g(i, D_VAL)
        if k == KEY_DOWN && v + 1 < ganz {
            v = v + 1
        } else if k == KEY_UP && v > 0 {
            v = v - 1
        } else if k == KEY_HOME {
            v = 0
        } else if k == KEY_END {
            v = ganz - 1
        } else if k == KEY_PGDN {
            v = imin(v + 10, ganz - 1)
        } else if k == KEY_PGUP {
            v = sub(v, 10)
        } else if k == KEY_ENTER {
            fire(i, K_LIST, v, w)
            return
        } else {
            return
        }
        s(i, D_VAL, v)
        scroll_to(i, v)
        dirty_wd(i)
        return
    }
    if kind == K_TABS {
        if k == KEY_RIGHT && tab_breite(i, g(i, D_VAL) + 1) != 0 {
            s(i, D_VAL, g(i, D_VAL) + 1)
            dirty_wd(i)
            fire(i, K_TABS, g(i, D_VAL), w)
        } else if k == KEY_LEFT && g(i, D_VAL) > 0 {
            s(i, D_VAL, g(i, D_VAL) - 1)
            dirty_wd(i)
            fire(i, K_TABS, g(i, D_VAL), w)
        }
        return
    }
    if kind == K_CHOICE {
        if k == KEY_ENTER || k == 32 {
            fire(i, K_CHOICE, 0x1000, w)
            return
        }
        // RUNDE A11Y: die Pfeiltasten waehlen, ohne aufzuklappen. Ein
        // Auswahlfeld, das man nur ueber ein Menue bedienen kann, ist
        // fuer den, der die Maus nicht benutzt, zwei Schritte zu weit.
        if k == KEY_DOWN && row_at(g(i, D_TEXT), g(i, D_VAL) + 1) != 0 {
            s(i, D_VAL, g(i, D_VAL) + 1)
            dirty_wd(i)
            s_axdirty = 1
            fire(i, K_CHOICE, g(i, D_VAL), w)
        } else if k == KEY_UP && g(i, D_VAL) > 0 {
            s(i, D_VAL, g(i, D_VAL) - 1)
            dirty_wd(i)
            s_axdirty = 1
            fire(i, K_CHOICE, g(i, D_VAL), w)
        }
        return
    }
    // RUNDE A11Y: DIE MENUELEISTE PER TASTATUR.
    //
    // Enter, Leertaste oder Pfeil nach unten klappt das Menue auf, das
    // gerade gewaehlt ist; die Pfeiltasten links und rechts gehen
    // durch die Eintraege. Vorher gab es keinen einzigen Weg dorthin,
    // der ohne Maus auskam.
    if kind == K_MENUBAR {
        let anz: u64 = menu_count(i)
        if anz == 0 {
            return
        }
        var v: u64 = g(i, D_VAL)
        if v == 0 {
            v = 1
        }
        if k == KEY_RIGHT && v < anz {
            s(i, D_VAL, v + 1)
            dirty_wd(i)
            s_axdirty = 1
        } else if k == KEY_LEFT && v > 1 {
            s(i, D_VAL, v - 1)
            dirty_wd(i)
            s_axdirty = 1
        } else if k == KEY_ENTER || k == 32 || k == KEY_DOWN {
            s(i, D_VAL, v)
            dirty_wd(i)
            fire(i, K_MENUBAR, 0x1000 + (v - 1), w)
        } else if k == KEY_ESC {
            s(i, D_VAL, 0)
            dirty_wd(i)
        }
        return
    }
    // RUNDE A11Y: ESC BRICHT AB -- IN JEDEM FENSTER, NICHT NUR IM
    // MENUE. In einem Dialog ist das die Absage.
    if k == KEY_ESC && w == dl_win {
        dl_state = 3
        return
    }
}

// Wie viele Eintraege eine Menueleiste hat.
fn menu_count(i: u64) -> u64 {
    var t: u64 = 0
    while t < 8 {
        if row_at(g(i, D_TEXT), t) == 0 {
            return t
        }
        t = t + 1
    }
    return 8
}

// ==================================================================
// MENUES UND DIALOGE
//
// BEIDE SIND EIGENE FENSTER BEIM SERVER, und das ist keine Notloesung,
// sondern die einzige richtige Antwort in diesem System: ein
// Kontextmenue, das in das Fenster gemalt wird, endet an dessen Rand.
// Ein Menue am unteren Rand einer Liste waere abgeschnitten. Der
// Fensterserver hat Fenster, also bekommt ein Menue eines.
//
// WAS DAS KOSTET: ein Menue hat eine Titelleiste und einen Rahmen wie
// jedes Fenster (`kernel/wm.fi` malt sie). Ein Server mit einem
// Fenstertyp OHNE Zierrat waere die Antwort darauf; er steht in
// docs/ROUNDK15.md unter dem, was offen bleibt.

// RUNDE A11Y: DER TITEL LIEGT ALS MODUL-STATIC UND NICHT ALS LOKALES
// FELD. Seit der Fensterknoten des Baumes den Titelzeiger BEHAELT,
// waere ein lokales Feld ein Zeiger in einen Rahmen, den es beim
// Lesen nicht mehr gibt -- Firn faengt das ab ("the address of the
// local escapes"), und es hat recht damit.
static mut mn_titel: [u8; 6] = "Menue\0"
static mut mn_win: u64 = 0xFFFFFFFFFFFFFFFF
static mut mn_res: u64 = 0xFFFFFFFFFFFFFFFF

fn menu_open(owner: u64, sx: u64, sy: u64, items: u64, n: u64) -> u64 {
    if mn_win != 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    let zh: u64 = zeilen_hoehe() + 2
    var bw: u64 = 60
    var k: u64 = 0
    while k < n {
        let q: u64 = row_at(items, k)
        if q != 0 {
            let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                row_len(q)) + 24
            if tw > bw {
                bw = tw
            }
        }
        k = k + 1
    }
    let bh: u64 = n * zh + 4
    // Ein Menue, das unten aus dem Bild laeuft, klappt nach oben auf --
    // deshalb kennt diese Bibliothek die Bildschirmgroesse.
    var y: u64 = sy
    if y + bh + 24 > wlibc.screen_h() {
        y = sub(sy, bh + 24)
    }
    var x: u64 = sx
    if x + bw + 4 > wlibc.screen_w() {
        x = sub(wlibc.screen_w(), bw + 4)
    }
    let w: u64 = new_win(x, y, bw, bh, (&mn_titel[0 as usize]) as u64,
        NK_MENU)
    if w >= MAXWN {
        return MAXWN
    }
    ns(w, N_DATA, items)
    ns(w, N_CNT, n)
    ns(w, N_VAL, 0)
    ns(w, N_OWNER, owner)
    mn_win = w
    mn_res = 0xFFFFFFFFFFFFFFFF
    dirty_all(w)
    return w
}

// Was gewaehlt wurde. 0xFFFF heisst abgebrochen, 0xFFFFFFFF... heisst
// "noch offen".
fn menu_at() -> u64 {
    return mn_res
}

fn menu_close() {
    if mn_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    close(mn_win)
    // Der Platz wird wieder frei: ein Programm, das zwanzig Menues
    // aufklappt, soll nicht nach vier stehenbleiben.
    if mn_win + 1 == nwn {
        nwn = nwn - 1
    }
    mn_win = 0xFFFFFFFFFFFFFFFF
}

static mut dl_win: u64 = 0xFFFFFFFFFFFFFFFF
static mut dl_state: u64 = 0
static mut dl_ok: u64 = 0
static mut dl_no: u64 = 0
static mut dl_ent: u64 = MAXWD
static mut dl_lbl: u64 = 0

fn dlg_text() -> u64 {
    return (&dlgbuf[0 as usize]) as u64
}

// 0 = keiner offen, 1 = offen, 2 = bestaetigt, 3 = abgebrochen
fn dlg_state() -> u64 {
    return dl_state
}

fn dlg_open(titel: u64, frage: u64, anfang: u64) -> u64 {
    return dlg_new(titel, frage, anfang, true)
}

fn dlg_ask(titel: u64, frage: u64) -> u64 {
    return dlg_new(titel, frage, 0, false)
}

// Die Beschriftungen der beiden Knoepfe liegen STATISCH, und der
// Uebersetzer besteht darauf: `button` behaelt den Zeiger ueber das
// Ende von `dlg_new` hinaus, und ein Zeiger in einen abgeraeumten
// Rahmen waere genau die Sorte Fehler, die man erst im Bild sieht.
static mut d_ok: [u8; 3] = "OK\0"
static mut d_ja: [u8; 3] = "Ja\0"
static mut d_ab: [u8; 10] = "Abbrechen\0"
static mut d_nein: [u8; 5] = "Nein\0"

fn dlg_new(titel: u64, frage: u64, anfang: u64, mit_feld: bool) -> u64 {
    if dl_win != 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    let bw: u64 = 340
    var bh: u64 = 108
    if !mit_feld {
        bh = 84
    }
    let x: u64 = sub(wlibc.screen_w(), bw) / 2
    let y: u64 = sub(wlibc.screen_h(), bh) / 2
    let w: u64 = new_win(x, y, bw, bh, titel, NK_DLG)
    if w >= MAXWN {
        return MAXWN
    }
    dl_win = w
    dl_state = 1
    var i: u64 = 0
    while i < 160 {
        dlgbuf[(i) as usize] = 0 as u8
        i = i + 1
    }
    if anfang != 0 {
        ulib.strncpy((&dlgbuf[0 as usize]) as u64, anfang, 158)
    }
    box_v(w, 0, 0, bw, bh, 12, 10)
    size(0, wlibc.text_h(wlibc.px_ui()))
    dl_lbl = label(frage)
    dl_ent = MAXWD
    if mit_feld {
        size(0, 26)
        dl_ent = entry((&dlgbuf[0 as usize]) as u64, 158)
        set_focus(dl_ent)
    }
    let unten: u64 = cg(ctcur, C_CY)
    box_end()
    box_h(w, sub(bw, 220), unten, 208, 30, 0, 10)
    size(94, 28)
    if mit_feld {
        dl_ok = button((&d_ok[0 as usize]) as u64)
    } else {
        dl_ok = button((&d_ja[0 as usize]) as u64)
    }
    size(94, 28)
    if mit_feld {
        dl_no = button((&d_ab[0 as usize]) as u64)
    } else {
        dl_no = button((&d_nein[0 as usize]) as u64)
    }
    box_end()
    dirty_all(w)
    return w
}

fn dlg_close() {
    if dl_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    close(dl_win)
    if dl_win + 1 == nwn {
        nwn = nwn - 1
    }
    dl_win = 0xFFFFFFFFFFFFFFFF
    dl_state = 0
    // Die Widgets des Dialogs sind verborgen; ihre Plaetze werden
    // wieder frei, wenn sie am Ende der Tafel liegen.
    while nwd > 0 && (g(nwd - 1, D_FLAGS) & F_HIDE) != 0 {
        nwd = nwd - 1
    }
    if s_focus != 0 && s_focus - 1 >= nwd {
        s_focus = 0
        var i: u64 = 0
        while i < nwd {
            if (g(i, D_FLAGS) & F_FOCUSABLE) != 0 && s_focus == 0 {
                s_focus = i + 1
            }
            i = i + 1
        }
    }
}

// ==================================================================
// DIE EREIGNISSCHLEIFE
//
// EIN Aufruf holt die Ereignisse ALLER Fenster ab, verteilt sie, malt
// nach, was schmutzig geworden ist, und gibt die Nummer des Widgets
// zurueck, bei dem etwas passiert ist -- oder MAXWD.
//
// SIE GIBT DIE MASCHINE HER, wenn nichts anliegt. Das steht hier, weil
// Runde K10 genau daran gescheitert ist: eine Warteschleife, die nicht
// abgibt, laesst die andere Aufgabe nicht laufen, und im
// Bildschirmfoto fehlt dann etwas, ohne dass irgendwo ein Fehler steht.

// ================================================== RUNDE THEME
//
// DAS UMSCHALTEN ZUR LAUFZEIT, VON DER SEITE DES FENSTERS AUS.
//
// Ein Programm mit dieser Bibliothek muss dafuer NICHTS tun: `step()`
// sieht zehnmal in der Sekunde nach, ob sich die aufgeloesten Marken
// geaendert haben, und wenn ja, ist alles schmutzig. Zehnmal und nicht
// bei jedem Durchlauf, weil ein Nachsehen drei Dateien liest und den
// ganzen Satz neu aufloest; die Verzoegerung, die das kostet, steht
// gemessen in docs/ROUNDTHEME.md und wird nicht kleingeredet.
const THEME_POLL_TICKS: u64 = 25

fn theme_watch() -> bool {
    let t: u64 = ticks()
    if t < s_thpoll + THEME_POLL_TICKS {
        return false
    }
    s_thpoll = t
    s_thpolls = s_thpolls + 1
    if !wlibc.theme_poll() {
        return false
    }
    s_thswitch = s_thswitch + 1
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            dirty_all(w)
        }
        w = w + 1
    }
    return true
}

// Sofort nachsehen, ohne auf den Takt zu warten. Der Testlaeufer
// braucht das, um eine Zeit zu messen, in der kein Warten steckt.
fn theme_now() -> bool {
    s_thpoll = 0
    return theme_watch()
}

fn theme_switches() -> u64 {
    return s_thswitch
}

fn theme_polls() -> u64 {
    return s_thpolls
}

fn theme_pixels() -> u64 {
    return s_thpx
}

fn theme_stales() -> u64 {
    return s_thstale
}

// Alle Fenster neu malen und die Flaeche zurueckgeben. EINE Stelle,
// damit die Zahl aus der Messung und die Zahl aus dem Betrieb dieselbe
// Rechnung sind.
fn paint_all() -> u64 {
    let vor: u64 = wlibc.theme_frame_begin()
    let _v: u64 = vor
    var gemalt: u64 = 0
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            gemalt = gemalt + flush_win(w)
        }
        w = w + 1
    }
    // DAS THEMA HAT SICH WAEHREND DES MALENS GEDREHT. Das Bild, das
    // gerade fertig geworden ist, ist in sich stimmig -- es hat die
    // ganze Zeit aus derselben Bank gelesen -- aber es ist nicht mehr
    // das aktuelle. Also genau EINMAL noch, mit der neuen Bank; ein
    // zweites Mal kann es nicht noetig werden, weil der naechste
    // Durchlauf wieder frisch einrastet.
    if wlibc.theme_frame_end() {
        s_thstale = s_thstale + 1
        let _v2: u64 = wlibc.theme_frame_begin()
        w = 0
        while w < nwn {
            if ng(w, N_H) != 0 {
                dirty_all(w)
                gemalt = gemalt + flush_win(w)
            }
            w = w + 1
        }
        let _e2: bool = wlibc.theme_frame_end()
    }
    return gemalt
}

// ==================================================================
// RUNDE A11Y -- DER BEDIENELEMENT-BAUM, UND ER ENTSTEHT VON SELBST
//
// DAS IST DIE ENTSCHEIDUNG DIESER RUNDE, in einer Funktion.
//
// Ein Programm, das diese Bibliothek benutzt, tut fuer seine
// Zugaenglichkeit NICHTS. Es stellt einen Knopf hin; die Bibliothek
// weiss, dass ein Knopf ein Knopf ist, wie er heisst, wo er liegt, wie
// gross er ist, ob er den Fokus hat und ob er abgeschaltet ist -- und
// schickt das herueber. Es gibt keine zweite Beschreibung, die ein
// Programmierer pflegen muesste und die nach drei Runden nicht mehr
// stimmt.
//
// GENAU DAS GEHT NUR JETZT. Nachtraeglich haette jedes der
// fuenfundzwanzig Programme dieses Systems seine eigene Beschreibung
// bekommen muessen, und jedes neue wieder. So kostet es EINE Stelle.
//
// WAS EIN KNOTEN TRAEGT: Rolle, zugaenglicher Name, Wert, Zustand
// (aktiv, fokussierbar, fokussiert, ausgewaehlt, verborgen, angehakt,
// geschuetzt), Lage, Groesse und der Elternknoten. Die Lage ist
// FENSTERBEZOGEN; der Elternknoten ist das Fenster, und dessen Knoten
// traegt die Bildschirmkoordinaten. Wer daraus die Stelle auf dem
// Schirm braucht, addiert -- und der Testlaeufer tut genau das und
// haelt das Ergebnis gegen ein Bildschirmfoto.
//
// DER INHALT EINES PASSWORTFELDES IST NICHT DABEI. Er wird hier gar
// nicht erst abgeschickt (zweite Sperre; die erste steht im Kernel).

fn ax_rolle(k: u64) -> u64 {
    if k == K_LABEL {
        return wlibc.AR_LABEL
    }
    if k == K_BUTTON {
        return wlibc.AR_BUTTON
    }
    if k == K_CHECK {
        return wlibc.AR_CHECK
    }
    if k == K_ENTRY {
        return wlibc.AR_ENTRY
    }
    if k == K_LIST {
        return wlibc.AR_LIST
    }
    if k == K_TABLE {
        return wlibc.AR_TABLE
    }
    if k == K_TABS {
        return wlibc.AR_TAB
    }
    if k == K_MENUBAR {
        return wlibc.AR_MENUBAR
    }
    if k == K_CHOICE {
        return wlibc.AR_CHOICE
    }
    if k == K_SEP {
        return wlibc.AR_SEPARATOR
    }
    if k == K_SCROLL {
        return wlibc.AR_SCROLLBAR
    }
    return wlibc.AR_NONE
}

fn ax_win_rolle(w: u64) -> u64 {
    if ng(w, N_KIND) == NK_MENU {
        return wlibc.AR_MENU
    }
    if ng(w, N_KIND) == NK_DLG {
        return wlibc.AR_DIALOG
    }
    return wlibc.AR_WINDOW
}

// Der Zustand eines Widgets als Bitmuster.
fn ax_zustand(i: u64) -> u64 {
    var z: u64 = 0
    let f: u64 = g(i, D_FLAGS)
    if (f & F_OFF) == 0 {
        z = z | wlibc.AS_ENABLED
    }
    if (f & F_FOCUSABLE) != 0 {
        z = z | wlibc.AS_FOCUSABLE
    }
    if (f & F_HIDE) != 0 {
        z = z | wlibc.AS_HIDDEN
    }
    if s_focus == i + 1 {
        z = z | wlibc.AS_FOCUSED
    }
    let k: u64 = g(i, D_KIND)
    if k == K_CHECK && g(i, D_VAL) != 0 {
        z = z | wlibc.AS_CHECKED
    }
    if (k == K_LIST || k == K_TABLE || k == K_TABS) && g(i, D_VAL) != 0 {
        z = z | wlibc.AS_SELECTED
    }
    if (g(i, D_FLAGS) & F_SECRET) != 0 {
        z = z | wlibc.AS_PROTECTED
    }
    return z
}

// Ein Oktett in den Satzpuffer.
fn ab(off: u64, v: u64) {
    axbuf[(off) as usize] = v as u8
}

fn aw(off: u64, v: u64) {
    __mmio_write64(((&axbuf[0 as usize]) as u64 + off) as *mut u64, v)
}

// Der zugaengliche NAME. Die Reihenfolge ist die Entscheidung:
//
//   1. Was das Programm ausdruecklich gesetzt hat (`ax_name`).
//   2. Bei einem geschuetzten Feld: NICHTS WEITER. Der Inhalt bleibt
//      hier, und zwar bevor er abgeschickt wird.
//   3. Sonst der sichtbare Text -- bei einer Liste oder Tabelle die
//      AUSGEWAEHLTE Zeile, denn die ist es, die ein Leser vorliest.
fn ax_namensquelle(i: u64) -> u64 {
    if g(i, D_AXN) != 0 {
        return g(i, D_AXN)
    }
    if (g(i, D_FLAGS) & F_SECRET) != 0 {
        return 0
    }
    let k: u64 = g(i, D_KIND)
    if k == K_LIST {
        return row_at(g(i, D_TEXT), g(i, D_VAL))
    }
    if k == K_TABLE {
        return row_at(g(i, D_TEXT), g(i, D_VAL) + 1)
    }
    if k == K_TABS || k == K_CHOICE {
        return row_at(g(i, D_TEXT), g(i, D_VAL))
    }
    return g(i, D_TEXT)
}

// Den Namen in den Satz schreiben -- hoechstens AX_NAME_MAX-1 Oktette,
// und ein Umbruch beendet ihn (eine Liste liefert ihre Zeile mit dem
// Rest dahinter).
fn ax_name_kopieren(off: u64, p: u64) {
    var k: u64 = 0
    if p != 0 {
        while k + 1 < wlibc.AX_NAME_MAX {
            let c: u64 = (*((p + k) as *mut u8)) as u64
            if c == 0 || c == 10 || c == 9 {
                k = wlibc.AX_NAME_MAX
            } else {
                ab(off + k, c)
                k = k + 1
            }
        }
    }
    var z: u64 = k
    if z >= wlibc.AX_NAME_MAX {
        z = wlibc.AX_NAME_MAX - 1
    }
    while z < wlibc.AX_NAME_MAX {
        ab(off + z, 0)
        z = z + 1
    }
}

fn ax_satz(n: u64, rolle: u64, zustand: u64, fenster: u64, eltern: u64,
    x: u64, y: u64, w: u64, h: u64, wert: u64, name: u64) {
    let off: u64 = n * wlibc.AX_NODE
    aw(off, rolle | (zustand << 8) | (fenster << 16) | (eltern << 24))
    aw(off + 8, (x & 0xFFFF) | ((y & 0xFFFF) << 16)
        | ((w & 0xFFFF) << 32) | ((h & 0xFFFF) << 48))
    aw(off + 16, wert)
    ax_name_kopieren(off + wlibc.AX_NAME_OFF, name)
}

fn ax_nodes() -> u64 {
    return s_axnodes
}

fn ax_pushes() -> u64 {
    return s_axpushes
}

// Den ganzen Baum herueberschieben. Bis zu 64 Saetze je Aufruf -- so
// viele passen in den Zwischenspeicher des Kernels.
fn ax_flush() -> u64 {
    if s_axdirty == 0 {
        return s_axnodes
    }
    s_axdirty = 0
    if !wlibc.a11y_on() {
        return 0
    }
    let _b: u64 = wlibc.ax_begin()
    var n: u64 = 0
    var ganz: u64 = 0
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            // Der Fensterknoten. Seine Lage ist die auf dem BILDSCHIRM.
            ax_satz(n, ax_win_rolle(w), wlibc.AS_ENABLED, w, 0xFF,
                ng(w, N_X), ng(w, N_Y), ng(w, N_W), ng(w, N_HH), w,
                ng(w, N_TITLE))
            let vater: u64 = ganz
            n = n + 1
            ganz = ganz + 1
            if n == AXBUF {
                let _s: u64 = wlibc.ax_send((&axbuf[0 as usize]) as u64, n)
                n = 0
            }
            var i: u64 = 0
            while i < nwd {
                if g(i, D_WIN) == w && (g(i, D_FLAGS) & F_HIDE) == 0 {
                    ax_satz(n, ax_rolle(g(i, D_KIND)), ax_zustand(i), w,
                        vater, g(i, D_X), g(i, D_Y), g(i, D_W), g(i, D_H),
                        g(i, D_VAL), ax_namensquelle(i))
                    // DIE ZWEITE SPERRE, UND SIE STEHT HIER: ein
                    // geschuetztes Feld bekommt die Rolle
                    // "Passwortfeld" und den Wert NULL. Sein Inhalt
                    // verlaesst diesen Prozess nicht.
                    if (g(i, D_FLAGS) & F_SECRET) != 0 {
                        let off: u64 = n * wlibc.AX_NODE
                        aw(off, wlibc.AR_PASSWORD | (ax_zustand(i) << 8)
                            | (w << 16) | (vater << 24))
                        aw(off + 16, 0)
                    }
                    n = n + 1
                    ganz = ganz + 1
                    if n == AXBUF {
                        let _s2: u64 = wlibc.ax_send(
                            (&axbuf[0 as usize]) as u64, n)
                        n = 0
                    }
                }
                i = i + 1
            }
        }
        w = w + 1
    }
    if n != 0 {
        let _s3: u64 = wlibc.ax_send((&axbuf[0 as usize]) as u64, n)
    }
    let _e: u64 = wlibc.ax_end()
    s_axnodes = ganz
    s_axpushes = s_axpushes + 1
    return ganz
}

fn step() -> u64 {
    s_fired = 0
    s_fkind = 0
    s_findex = 0
    s_ticks = s_ticks + 1
    // RUNDE A11Y: der Baum wird nachgezogen, BEVOR die Ereignisse
    // dieses Durchlaufs kommen -- so sieht ein Leser den Stand, den
    // der Benutzer gerade sieht, und nicht den davor.
    let _ax: u64 = ax_flush()
    var etwas: bool = false
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            var n: u64 = 0
            while n < 64 && wlibc.sys3w(wlibc.WM_EVENT, ng(w, N_H),
                (&ev[0 as usize]) as u64, 0) == 1 {
                etwas = true
                n = n + 1
                let b: u64 = (&ev[0 as usize]) as u64
                let typ: u64 = __mmio_read64((b) as *mut u64)
                let d: u64 = __mmio_read64((b + 8) as *mut u64)
                let ex: u64 = (d >> 32) & 0xFFFF
                let ey: u64 = (d >> 16) & 0xFFFF
                let btn: u64 = d & 0xFFFF
                if typ == wlibc.EV_DOWN {
                    on_down(w, ex, ey, btn)
                } else if typ == wlibc.EV_UP {
                    on_up(w, ex, ey)
                } else if typ == wlibc.EV_MOVE {
                    on_move(w, ex, ey, btn)
                } else if typ == wlibc.EV_KEY {
                    on_key(w, ex)
                } else if typ == wlibc.EV_CLOSE {
                    ns(w, N_H, 0)
                    if w == mn_win {
                        mn_res = 0xFFFF
                    } else if w == dl_win {
                        dl_state = 3
                    } else if ng(w, N_KIND) == NK_MAIN {
                        s_alive = 0
                    }
                } else if typ == wlibc.EV_RESIZE {
                    ns(w, N_W, ex)
                    ns(w, N_HH, ey)
                    relayout()
                    dirty_all(w)
                }
            }
        }
        w = w + 1
    }
    // Ein Menue, bei dem etwas gewaehlt wurde, schliesst sich selbst --
    // ein Menue, das nach der Wahl stehenbleibt, ist keines.
    if mn_win != 0xFFFFFFFFFFFFFFFF && s_fired != 0 {
        if s_fwin == mn_win {
            mn_res = s_findex
            let besitzer: u64 = s_fired - 1
            menu_close()
            if mn_res == 0xFFFF {
                s_fired = 0
            } else {
                s_fired = besitzer + 1
                s_fkind = K_MENUBAR
                s_findex = mn_res
            }
        }
    }
    // Der Dialog: die beiden Knoepfe sind seine Antwort.
    if dl_win != 0xFFFFFFFFFFFFFFFF && s_fired != 0 {
        let i: u64 = s_fired - 1
        if i == dl_ok {
            dl_state = 2
            s_fired = 0
        } else if i == dl_no {
            dl_state = 3
            s_fired = 0
        } else if i == dl_ent && s_fkind == K_ENTRY {
            dl_state = 2
            s_fired = 0
        }
    }
    let gewechselt: bool = theme_watch()
    let gemalt: u64 = paint_all()
    if gewechselt {
        s_thpx = s_thpx + gemalt
    }
    if !etwas && gemalt == 0 {
        ulib.sys(ulib.SYS_YIELD, 0, 0, 0)
    }
    if s_fired == 0 {
        return MAXWD
    }
    return s_fired - 1
}

// ==================================================================
// WAS DIE ANORDNUNG AUSGERECHNET HAT -- UND WOHIN DER TEXT KOMMT
//
// Diese acht Funktionen sind fuer die MESSUNG da und fuer nichts
// sonst. Sie geben dieselben Zahlen zurueck, mit denen `paint_*` malt
// -- nicht aehnliche, dieselben: jede steht als Ausdruck genau einmal,
// hier und dort, und wer eine der beiden aendert, macht den Testlauf
// rot statt ihn zu belegen.
//
// Ohne sie muesste ein Testlaeufer die Grundlinie eines Knopftextes
// selbst ausrechnen -- also die Anordnung nachbauen --, und dann pruefte
// er seinen eigenen Nachbau. So sagt die Anwendung, wo sie es
// hinschreibt, und der Laeufer rechnet im BILD nach, ob es dort steht.

fn rect_x(i: u64) -> u64 {
    return g(i, D_X)
}

fn rect_y(i: u64) -> u64 {
    return g(i, D_Y)
}

fn rect_w(i: u64) -> u64 {
    return g(i, D_W)
}

fn rect_h(i: u64) -> u64 {
    return g(i, D_H)
}

fn kind_of(i: u64) -> u64 {
    return g(i, D_KIND)
}

fn row_h() -> u64 {
    return zeilen_hoehe()
}

fn text_x(i: u64) -> u64 {
    let k: u64 = g(i, D_KIND)
    if k == K_BUTTON {
        let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), g(i, D_TEXT),
            tlen(g(i, D_TEXT)))
        return g(i, D_X) + sub(g(i, D_W), tw) / 2
    }
    if k == K_ENTRY {
        return g(i, D_X) + 5
    }
    if k == K_CHECK {
        return g(i, D_X) + 20
    }
    return g(i, D_X)
}

fn text_base(i: u64) -> u64 {
    let k: u64 = g(i, D_KIND)
    let asc: u64 = wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    if k == K_LABEL {
        return g(i, D_Y) + asc
    }
    return g(i, D_Y) + (g(i, D_H) + asc) / 2
}

fn text_fg(i: u64) -> u64 {
    if (g(i, D_FLAGS) & F_OFF) != 0 {
        return wlibc.theme(wlibc.T_DIM)
    }
    return wlibc.theme(wlibc.T_FG)
}

// Die Farbe UNTER dem Text. Sie gehoert zur Messung, weil ein
// kantengeglaettetes Zeichen aus Mischungen zwischen beiden besteht --
// ohne den Hintergrund ist keine einzige Zwischenstufe nachzurechnen.
fn text_bg(i: u64) -> u64 {
    let k: u64 = g(i, D_KIND)
    if k == K_BUTTON {
        if (g(i, D_FLAGS) & F_PRESSED) != 0 {
            return wlibc.theme(wlibc.T_BTNDN)
        }
        if (g(i, D_FLAGS) & F_HOVER) != 0 {
            return wlibc.theme(wlibc.T_BTNHI)
        }
        return wlibc.theme(wlibc.T_BTN)
    }
    if k == K_ENTRY {
        return wlibc.theme(wlibc.T_ENTRY)
    }
    if k == K_CHOICE {
        return wlibc.theme(wlibc.T_BTN)
    }
    if g(i, D_WIN) < MAXWN && ng(g(i, D_WIN), N_KIND) == NK_DLG {
        return wlibc.theme(wlibc.T_DLG)
    }
    return wlibc.theme(wlibc.T_BG)
}

// Die Grundlinie der SICHTBAREN Zeile `r` einer Liste, und die Stelle,
// an der ihr Text anfaengt. Genau die Rechnung aus `paint_list`.
fn row_base(i: u64, r: u64) -> u64 {
    let zh: u64 = zeilen_hoehe()
    return g(i, D_Y) + 2 + r * zh
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()) + 1
}

fn row_x(i: u64) -> u64 {
    return g(i, D_X) + 6 + list_ein(i)
}

// Wo das Symbolplaettchen einer sichtbaren Zeile liegt.
fn icon_x(i: u64) -> u64 {
    return g(i, D_X) + 5
}

fn icon_y(i: u64, r: u64) -> u64 {
    return g(i, D_Y) + 2 + r * zeilen_hoehe() + 3
}

// Wo der Buchstabe auf dem Plaettchen anfaengt und auf welcher
// Grundlinie er sitzt -- fuer die Messung, genau die Ausdruecke von oben.
fn icon_letter_x(i: u64, p: u64) -> u64 {
    return g(i, D_X) + 5 + sub(14, wlibc.text_w(wlibc.F_UI, wlibc.px_ui(),
        p, 1)) / 2
}

fn icon_letter_base(i: u64, r: u64) -> u64 {
    return g(i, D_Y) + 2 + r * zeilen_hoehe() + 15
}

// DIE TABELLE HAT IHRE EIGENE RECHNUNG, und diese drei Funktionen sind
// der Grund, warum sie hier steht: die erste Fassung des Dateimanagers
// meldete die Grundlinie einer Tabellenzeile als "die einer Liste plus
// Kopfhoehe" -- und lag um EINEN Bildpunkt daneben. Im Bild sah man
// nichts (der Text stand ja da), im Pruefer standen 219 von 304
// Tintenpunkten falsch, und die Ursache war keine Farbe, sondern eine
// Zeile: `paint_list` setzt bei `y + 2`, `paint_table` bei
// `y + kopf + 1`. Jetzt steht jede der beiden Rechnungen genau einmal.
fn head_h(i: u64) -> u64 {
    return zeilen_hoehe() + 4
}

fn head_base(i: u64) -> u64 {
    return g(i, D_Y) + 3 + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
}

fn cell_base(i: u64, r: u64) -> u64 {
    return g(i, D_Y) + head_h(i) + 1 + r * zeilen_hoehe()
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()) + 1
}

fn cell_x(i: u64, c: u64) -> u64 {
    var x: u64 = g(i, D_X) + 6
    var k: u64 = 0
    while k < c && k < g(i, D_C) {
        x = x + spalte_breit(i, k)
        k = k + 1
    }
    // ROUND ICONS: the first column starts behind the icon.  Only the
    // first -- a table whose every column shifted would have its header
    // over the wrong data, and `paint_table` does the same thing here.
    if c == 0 {
        x = x + table_ein(i)
    }
    return x
}

// Welche Widgetnummer die beiden Knoepfe eines Dialogs haben, und in
// welchem Fenster er liegt. Fuer die MESSUNG: ein Testlaeufer, der die
// Stelle des Knopfes selbst ausrechnet, rechnet die Anordnung nach --
// und prueft dann seinen eigenen Nachbau.
fn dlg_button(welcher: u64) -> u64 {
    if welcher == 0 {
        return dl_ok
    }
    return dl_no
}

fn dlg_label() -> u64 {
    return dl_lbl
}

fn dlg_win() -> u64 {
    if dl_win == 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    return dl_win
}

fn menu_win() -> u64 {
    if mn_win == 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    return mn_win
}
