    ctrl_small, ctrl_thin, inset, inset_text, dlg_btn_w,
    head_base, cell_base, cell_x, head_h, icon_x, icon_y,
    icon_letter_x, icon_letter_base,
    K_LABEL, K_BUTTON, K_CHECK, K_ENTRY, K_LIST, K_TABLE, K_TABS, K_TILE,
