const C_FIELDS: u64 = 13

const KEY_TAB: u64 = 9
const KEY_ENTER: u64 = 13
const KEY_BS: u64 = 8
const KEY_ESC: u64 = 27
const KEY_UP: u64 = 0x101
const KEY_DOWN: u64 = 0x102
const KEY_LEFT: u64 = 0x103
const KEY_RIGHT: u64 = 0x104
const KEY_HOME: u64 = 0x105
const KEY_END: u64 = 0x106
const KEY_PGUP: u64 = 0x107
const KEY_PGDN: u64 = 0x108
const KEY_DEL: u64 = 0x109
// RUNDE ALLTAG: UMSCHALT+ENTF IST EINE ANDERE TASTE. Der Dateimanager
// legt bei Entf in den Papierkorb und loescht bei Umschalt+Entf
// endgueltig; ohne eine eigene Nummer waere das nicht zu unterscheiden.
// Der Kern schickt dafuer `ESC [ 3 ; 2 ~` (kernel/kbd.fi, `arrow`).
const KEY_SDEL: u64 = 0x10A

// ------------------------------------------------------- der Zustand

static mut wd: [u64; 4000] = [0 as u64; 4000] // MAXWD * D_FIELDS
// RUNDE ECHTHARDWARE-2: 70 UND NICHT 56 -- MAXWN IST 5 GEWORDEN.
//
// Diese Zeile ist beim Anheben von MAXWN (4 -> 5, fuer die Infoblase)
// stehengeblieben, und das ist genau die Sorte Fehler, die eine
// Konstante mit einer HANDGERECHNETEN Feldgroesse danebenstellt: 56
// ist 4 * 14, gebraucht werden 5 * 14 = 70. Das fuenfte Fenster hat
// damit ueber das Feldende hinausgeschrieben.
//
// GEFUNDEN HAT ES DER K16-PRUEFSTAND, nicht das laufende System: der
// selbstgehostete Uebersetzer `firnc1` brach an `netmon`, `freunde`
// und `powermon` ohne eine Zeile Ausgabe ab (131 gebundene Programme
// statt 134). Im Abbild lief unterdessen alles -- `firnc0` uebersetzt
// dasselbe klaglos. Ein Pruefstand, der zwei Uebersetzer gegeneinander
// haelt, ist genau dafuer da.
static mut wn: [u64; 70] = [0 as u64; 70] // MAXWN * N_FIELDS
static mut ct: [u64; 312] = [0 as u64; 312] // MAXCT * C_FIELDS
static mut nwd: u64 = 0
static mut nwn: u64 = 0
static mut nct: u64 = 0
static mut ctcur: u64 = 0xFFFFFFFFFFFFFFFF
static mut wncur: u64 = 0
static mut want_w: u64 = 0
static mut want_h: u64 = 0
static mut want_gap: u64 = 0

static mut s_focus: u64 = 0 // Widgetnummer + 1
static mut s_nohit: u64 = 0
static mut s_alive: u64 = 1
static mut s_fired: u64 = 0
static mut s_fkind: u64 = 0
static mut s_findex: u64 = 0
static mut s_fwin: u64 = 0
static mut s_blits: u64 = 0
static mut s_keylast: u64 = 0
static mut s_keyseq: u64 = 0
// RUNDE ALLTAG: die Zahl und der Modifikator einer Fluchtfolge
// `ESC [ n ; m ~`. Vorher stand die Zahl im Zustand selbst
// (`s_esc = 3 + Ziffer`) und mehr als eine Ziffer gab es nicht.
static mut s_num: u64 = 0
static mut s_mod: u64 = 0
static mut s_down: u64 = 0 // gedruecktes Widget + 1
// RUNDE ALLTAG: wo das Ziehen anfing (Bildflaeche und Schieberegler).
static mut s_dragx: u64 = 0
static mut s_dragy: u64 = 0
// Der gezogene Ausschnitt, in BILDPUNKTEN des Bildes und nicht des
// Schirms -- ein Programm, das darin etwas veraendert, rechnet sonst
// jede Vergroesserung selbst zurueck.
static mut s_aus_x0: u64 = 0
static mut s_aus_y0: u64 = 0
static mut s_aus_x1: u64 = 0
static mut s_aus_y1: u64 = 0
static mut s_aus_da: u64 = 0
static mut s_esc: u64 = 0 // Zustand der Fluchtfolge
static mut s_lastclick: u64 = 0
static mut s_lastwd: u64 = 0
static mut s_ticks: u64 = 0

// ================================ RUNDE DESIGN-2: DIE BEWEGUNG
//
// EIN Tween-Verwalter fuer die ganze Bibliothek, und zwar aus dem
// Grund, aus dem alles andere hier auch nur einmal existiert: eine
// Bewegung, die jedes Programm selbst zaehlt, laeuft auf zwei Fenstern
// verschieden schnell.
//
// DIE ZEITQUELLE IST `ticks()`, also `SYS_SYSINFO/I_TICKS`, und der
// Takt steht in kernel/time.fi: `TICK_HZ = 100`. Ein Tick sind somit
// GENAU 10 ms. Das ist die einzige Umrechnung in dieser Datei, sie
// steht hier, und sie heisst `MS_PRO_TICK`.
//
// WARUM NICHT 60 Hz. Weil dieser Kernel 100 Hz hat. Eine Bibliothek,
// die 60 Hz BEHAUPTET, waehrend ihr Zeitgeber mit 100 laeuft, rechnet
// jede Dauer um 40 Prozent falsch. Die Zusage lautet: die Dauer in
// Millisekunden stimmt; die Zahl der Zwischenbilder ist, was die
// Maschine hergibt.
//
// WAS EIN TWEEN IST: vier Zahlen (Anfangstick, Dauer in Ticks, Kurve,
// Ziel) und ein Fortschritt 0..1000. Nicht 0..100 -- bei einem Fenster
// von 800 Bildpunkten ist ein Prozent acht Bildpunkte, und ein Sprung
// von acht Bildpunkten ist genau das Ruckeln, das diese Runde
// abstellen soll.
const TW_MAX: u64 = 16
const TW_FREI: u64 = 0
const TW_LAEUFT: u64 = 1
const TW_FERTIG: u64 = 2

// Die Felder eines Tweens.
const TW_STATE: u64 = 0
const TW_T0: u64 = 1
const TW_DUR: u64 = 2
const TW_CURVE: u64 = 3
const TW_WHAT: u64 = 4
const TW_WIN: u64 = 5
const TW_WD: u64 = 6
const TW_P: u64 = 7
const TW_FIELDS: u64 = 8

// Die Kurven. Linear ist ausdruecklich dabei, weil eine gemessene
// Bewegung eine braucht, an der nichts zu deuten ist.
const EASE_LINEAR: u64 = 0
const EASE_OUT: u64 = 1
const EASE_IN_OUT: u64 = 2

// Wofuer eine Bewegung laeuft.
const AN_WIN_OPEN: u64 = 1
const AN_WIN_CLOSE: u64 = 2
const AN_MENU: u64 = 3
const AN_HOVER: u64 = 4
const AN_PRESS: u64 = 5
const AN_NOTIFY: u64 = 6

const MS_PRO_TICK: u64 = 10

static mut tw: [u64; 128] = [0 as u64; 128]
static mut tw_n: u64 = 0
static mut tw_starts: u64 = 0
static mut tw_frames: u64 = 0

// =============================== RUNDE LOOK: DIE OBERFLAECHE MELDET SICH
//
// Die Taskleiste meldet seit Runde DESKTOP jede Zeile, die sie malt, mit
// x, Grundlinie, Vorder- und Hintergrundfarbe -- und deshalb kann
// `tools/netview/run.sh` sie BILDPUNKTGENAU gegen eine zweite Rasterung
// halten, statt sie anzusehen. Jedes andere Fenster dieses Systems
// konnte das nicht: die Widgets werden hier gemalt, und hier wurde
// nichts gemeldet.
//
// Diese Runde braucht es dreimal:
//   * Abschnitt A -- ein Text MIT UMLAUT muss Bildpunkt fuer Bildpunkt
//     nachgerechnet werden, und dafuer muss seine Grundlinie bekannt
//     sein und nicht nachgerechnet.
//   * Abschnitt C/D -- eine Zusage ueber Innenabstand und Eckenradius
//     ist eine Zusage ueber KOORDINATEN. Wer sie im Testlauf selbst
//     ausrechnet, prueft seine eigene Rechnung.
//
// ES IST AUS, SOLANGE NIEMAND ES EINSCHALTET, und eingeschaltet wird es
// durch eine DATEI auf der Platte (`/etc/uitrace`) und nicht durch ein
// Wort auf der Kernel-Kommandozeile: die Kommandozeile gehoert dem
// Kernel, und ein Ring-3-Programm, das darin liest, hat eine Abhaengigkeit
// erfunden, die es nicht braucht. Ohne die Datei ist die serielle
// Ausgabe dieses Systems Oktett fuer Oktett dieselbe wie vorher -- das
// ist die Bedingung dafuer, dass kein bestehender Testlaeufer davon
// etwas merkt.
static mut s_trace: u64 = 0
static mut s_tx: u64 = 0
// Der Titel des Menuefensters, wenn ein Programm ihn gesetzt hat.
static mut mn_titel: u64 = 0
static mut tr_a: [u8; 16] = "wlib: text win=\0"
static mut tr_k: [u8; 8] = " kind=\0\0"
static mut tr_x: [u8; 5] = " x=\0\0"
static mut tr_b: [u8; 8] = " base=\0\0"
static mut tr_f: [u8; 6] = " fg=\0\0"
static mut tr_g: [u8; 6] = " bg=\0\0"
// ROUND THEMESTORE: AND HOW WIDE IT IS.
//
// A checker that has to GUESS the width of a piece of text guesses too
// generously -- it then finds ink from the widget next door inside the
// box it drew around this one, and reports two labels as overlapping
// that do not touch. Measured: eighty-six false overlaps in one
// screenshot before this field existed. The program knows the width;
// it computed it to centre the text. So it says it.
static mut tr_w: [u8; 6] = " tw=\0\0"
// ROUND SOFTUI: AND WHERE THE WINDOW IS.
//
// Every number in this line is WINDOW-LOCAL, and the handle in `win=`
// is a handle and not a place -- so a checker that reads this line
// cannot find the text in the picture.  It could only guess, and
// `tools/softui/pruef.py` guessing means it looks at the wrong window
// and reports every label of a two-window screenshot as empty.  That
// is not a checker, that is noise.  Two numbers fix it.
static mut tr_ax: [u8; 6] = " ax=\0\0"
static mut tr_ay: [u8; 6] = " ay=\0\0"
static mut tr_t: [u8; 5] = " t=\0\0"
static mut tr_buf: [u8; 320] = [0 as u8; 320]
// RUNDE THEME. Was das Umschalten kostet, gezaehlt an der Stelle, an
// der es passiert -- nicht geschaetzt.
static mut s_thpoll: u64 = 0 // Tick des letzten Nachsehens
static mut s_thgen: u64 = 0 // zuletzt gesehene Generation
static mut s_thswitch: u64 = 0 // wie oft sich das Thema geaendert hat
static mut s_thpx: u64 = 0 // Bildpunkte, die dafuer neu gemalt wurden
static mut s_thstale: u64 = 0 // Male, die ein Bild mittendrin veraltete
static mut s_thpolls: u64 = 0
static mut dlgbuf: [u8; 160] = [0 as u8; 160]
static mut ev: [u8; 16] = [0 as u8; 16]

// ------------------------------------------------------- der Zugriff

fn g(i: u64, f: u64) -> u64 {
    if i >= MAXWD {
        return 0
    }
    return wd[(i * D_FIELDS + f) as usize]
}

fn s(i: u64, f: u64, v: u64) {
    if i >= MAXWD {
        return
    }
    wd[(i * D_FIELDS + f) as usize] = v
}

fn ng(w: u64, f: u64) -> u64 {
    if w >= MAXWN {
        return 0
    }
    return wn[(w * N_FIELDS + f) as usize]
}

fn ns(w: u64, f: u64, v: u64) {
    if w >= MAXWN {
        return
    }
    wn[(w * N_FIELDS + f) as usize] = v
}

fn cg(c: u64, f: u64) -> u64 {
    if c >= MAXCT {
        return 0
    }
    return ct[(c * C_FIELDS + f) as usize]
}

fn cs(c: u64, f: u64, v: u64) {
    if c >= MAXCT {
        return
    }
    ct[(c * C_FIELDS + f) as usize] = v
}

fn tlen(p: u64) -> u64 {
    if p == 0 {
        return 0
    }
    return ulib.length(p)
}

fn imin(a: u64, b: u64) -> u64 {
    if a < b {
        return a
    }
    return b
}

fn sub(a: u64, b: u64) -> u64 {
    if b >= a {
        return 0
    }
    return a - b
}

// ------------------------------------------------------- das Aufsetzen

fn begin(nohit: bool, noclip: bool) -> bool {
    if !wlibc.start(noclip) {
        return false
    }
    var pfad: [u8; 11] = "/etc/theme\0"
    wlibc.theme_load((&pfad[0 as usize]) as u64)
    if nohit {
        s_nohit = 1
    }
    // RUNDE LOOK: gibt es die Datei, meldet diese Bibliothek jede Zeile,
    // die sie malt. Gibt es sie nicht, aendert sich kein Oktett.
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_trace = 1
        say_font()
    }
    return true
}

// RUNDE THEMESTORE: WIE HOCH EINE ZEILE WIRKLICH IST.
//
// `wlib: text ... base=` sagt die Grundlinie. Wer daraus einen Kasten
// um die Buchstaben macht, muss wissen, wie weit die Schrift ueber und
// unter der Grundlinie steht -- und `shotcheck.py` hat das geraten:
// sechzehn hinauf, sechs hinunter, zweiundzwanzig hoch. Die Zeilen
// einer Liste stehen ZWANZIG auseinander. Damit schnitt der geratene
// Kasten jeder Zeile in die Nachbarzeile, fand dort deren Tinte und
// meldete Ueberlappungen, die es nicht gab -- drei Stueck in einer
// Aufnahme, in der nichts falsch war. Die Bibliothek weiss die Zahlen;
// sie sagt sie jetzt, und geraten wird nicht mehr.
static mut tf_a: [u8; 18] = "wlib: font ui px=\0"
static mut tf_b: [u8; 6] = " asc=\0"
static mut tf_c: [u8; 4] = " h=\0"

fn say_font() {
    let b: u64 = (&tr_buf[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&tf_a[0 as usize]) as u64)
    at = tr_num(b, at, wlibc.px_ui())
    at = tr_put(b, at, (&tf_b[0 as usize]) as u64)
    at = tr_num(b, at, wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()))
    at = tr_put(b, at, (&tf_c[0 as usize]) as u64)
    at = tr_num(b, at, wlibc.text_h(wlibc.px_ui()))
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(b, at)
}

fn counts() -> u64 {
    return nwd
}

fn blits_done() -> u64 {
    return s_blits
}

fn key_last() -> u64 {
    return s_keylast
}

// WIE OFT SCHON EINE TASTE KAM. Ein Programm, das auf Entf reagieren
// will, kann `key_last` nicht vergleichen -- zweimal Entf ist zweimal
// dieselbe Zahl. Es vergleicht diesen Zaehler.
fn key_seq() -> u64 {
    return s_keyseq
}

fn alive() -> bool {
    return s_alive != 0
}

fn quit() {
    s_alive = 0
}

// ------------------------------------------------------- die Fenster

// RUNDE SCHIRM: DIE MASSE SIND LOGISCH, NICHT IN BILDPUNKTEN.
//
// Jedes Programm dieser Sammlung nennt hier feste Zahlen -- 440x300
// beim Starter, 660x430 beim Datei-Explorer. Die Bedienelemente DARIN
// wachsen mit der Oberflaechenschrift (`wlibc.metric`, `px_ui`), das
// Fenster aber wuchs nicht mit: auf 3840x2160 stand ein Starterfenster
// von 440 Bildpunkten in der Ecke, und seine Liste war abgeschnitten
// ("Editor -- Text schreib..."). Gemessen im Bild, nicht im Quelltext.
//
// Also: Groesse UND Stelle mal dem Faktor, und danach auf den Schirm
// gedeckelt, damit aus dem Wachsen kein Hinausragen wird.
fn window(x: u64, y: u64, w: u64, h: u64, titel: u64) -> u64 {
    let k: u64 = wlibc.ui_scale()
    var bw: u64 = w * k
    var bh: u64 = h * k
    let sw: u64 = wlibc.screen_w()
    let sh: u64 = wlibc.screen_h()
    var bx: u64 = x * k
    var by: u64 = y * k
    if sw != 0 && sh != 0 {
        if bw > sw {
            bw = sw
        }
        if bh > sh {
            bh = sh
        }
        if bx + bw > sw {
            bx = sub(sw, bw)
        }
        if by + bh > sh {
            by = sub(sh, bh)
        }
    }
    return new_win(bx, by, bw, bh, titel, NK_MAIN)
}

// RUNDE PAINT: WELCHEM BUENDEL DIESES FENSTER GEHOERT.
//
// Ein Aufruf, einmal, gleich nach `window`. Was er bringt, ist das
// Symbol im Taskleisten-Knopf: die Bilder liegen seit Runde K15 in
// `/apps/<name>.osp/symbol`, und was fehlte, war der Satz "dieses
// Fenster ist jenes Programm". Der Titel konnte ihn nicht sagen -- er
// ist uebersetzt, er aendert sich im Lauf, und zwei Programme duerfen
// denselben tragen.
//
// Wer es nicht ruft, aendert nichts: der Knopf bleibt reiner Text.
fn window_app(i: u64, name: u64) -> u64 {
    if i >= MAXWN {
        return 0
    }
    return wlibc.win_app(ng(i, N_H), name)
}

// RUNDE DESKTOP: EIN FENSTER OHNE SCHMUCK AUF EINER EIGENEN EBENE.
// Schreibtisch und Taskleiste sind gewoehnliche Fenster -- sie haben
// nur keinen Rahmen und keine Titelleiste, und sie liegen ganz hinten
// beziehungsweise ganz vorn. Beides sagt DER SERVER, nicht die
// Anwendung: eine Anwendung, die sich selbst nach vorn malt, malt in
// ihr eigenes Rechteck und damit unter alle anderen.
//
// Gibt MAXWN zurueck, wenn kein Fenster zu haben war -- und ebenso,
// wenn die Ebene abgelehnt wurde. Ebene 0 und 2 darf nur die Wurzel;
// wer sie nicht bekommt, soll KEIN Fenster behalten, das aussieht wie
// eine Taskleiste und keine ist.
fn window_plain(x: u64, y: u64, w: u64, h: u64, titel: u64,
    ebene: u64) -> u64 {
    let i: u64 = new_win(x, y, w, h, titel, NK_MAIN)
    if i >= MAXWN {
        return MAXWN
    }
    let hh: u64 = ng(i, N_H)
    if ulib.bad(wlibc.win_state(hh, wlibc.WS_DECO, 0)) {
        close(i)
        return MAXWN
    }
    if ebene != wlibc.L_NORMAL {
        if ulib.bad(wlibc.win_state(hh, wlibc.WS_LAYER, ebene)) {
            close(i)
            return MAXWN
        }
    }
    // Der Schmuck ist eben abgeschaltet worden: der Ursprung der
    // Malflaeche ist ein anderer als der, der beim Anlegen galt.
    say_window(i)
    return i
}

// RUNDE ECHTHARDWARE-1: "dieses Fenster will die Tastatur, auch wenn
// es nicht auf der normalen Ebene liegt". Fuer das Startmenue -- siehe
// die lange Begruendung in kernel/user/launcher.fi.
fn win_keys(w: u64, an: bool) -> u64 {
    if w >= MAXWN {
        return 0
    }
    var v: u64 = 0
    if an {
        v = 1
    }
    return wlibc.win_state(ng(w, N_H), wlibc.WS_KEYS, v)
}

// Das eigene Fenster minimieren oder wiederherstellen.
fn win_hide(w: u64, on: bool) -> u64 {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return 0
    }
    var v: u64 = 0
    if on {
        v = 1
    }
    return wlibc.win_state(ng(w, N_H), wlibc.WS_HIDDEN, v)
}

fn win_layer(w: u64) -> u64 {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return wlibc.L_NORMAL
    }
    return wlibc.sys3w(wlibc.WM_INFO, ng(w, N_H), wlibc.WI_LAYER, 0)
}

fn new_win(x: u64, y: u64, w: u64, h: u64, titel: u64, kind: u64) -> u64 {
    if nwn >= MAXWN {
        return MAXWN
    }
    let hh: u64 = wlibc.sys5(wlibc.WM_CREATE, (x << 16) | y, (w << 16) | h,
        titel, 0, 0)
    if ulib.bad(hh) || hh == 0 {
        return MAXWN
    }
    let i: u64 = nwn
    nwn = nwn + 1
    ns(i, N_H, hh)
    ns(i, N_W, w)
    ns(i, N_HH, h)
    ns(i, N_KIND, kind)
    ns(i, N_VAL, 0)
    ns(i, N_DATA, 0)
    ns(i, N_CNT, 0)
    ns(i, N_OWNER, 0)
    ns(i, N_X, x)
    ns(i, N_Y, y)
    wncur = i
    dirty_all(i)
    say_window(i)
    return i
}

// RUNDE THEMESTORE: JEDES FENSTER SAGT, WO ES STEHT -- und wo seine
// MALFLAECHE anfaengt.
//
// `wlib: text ...` meldet x und Grundlinie IM FENSTER. Wer eine
// Aufnahme des ganzen Bildschirms nachmessen will, braucht dazu den
// Ursprung, und den hatte bisher nur `settings`, weil es ihn selbst
// hinschrieb. Fuer jedes andere Fenster -- den Starter zum Beispiel --
// blieb dem Pruefer nur, 0,0 anzunehmen: er misst dann eine Stelle des
// Schreibtischs und nennt sie eine Beschriftung. Genau so ist in
// dieser Runde eine leere Beschriftung gemeldet worden, die keine war,
// und drei ueberlappende, die sich nicht beruehrten.
//
// Der Versatz wird NICHT nachgerechnet (kein BORDER, kein TITLE_H in
// dieser Datei): er wird beim Server erfragt, der ihn in `inx`/`iny`
// ohnehin fuehrt -- ein Fenster ohne Schmuck bekommt so von selbst 0.
static mut tw_a: [u8; 14] = "wlib: win id=\0"
static mut tw_x: [u8; 4] = " x=\0"
static mut tw_y: [u8; 4] = " y=\0"
static mut tw_w: [u8; 4] = " w=\0"
static mut tw_h: [u8; 4] = " h=\0"
static mut tw_cx: [u8; 5] = " cx=\0"
static mut tw_cy: [u8; 5] = " cy=\0"

// RUNDE DESIGN-2: die Woerter der Bewegungsmeldung.
static mut an_wort: [u8; 12] = "wlib: anim \0"
static mut an_was: [u8; 5] = "was=\0"
static mut an_p: [u8; 4] = " p=\0"
static mut an_dur: [u8; 6] = " dur=\0"
static mut an_wd: [u8; 5] = " wd=\0"
// RUNDE ALLTAG: DIE ANWENDUNG SAGT, WO SIE ALLES HINGELEGT HAT.
//
// In einer Zeile je Bedienelement, im Format, das
// `tools/design/messen.py` und `tools/alltag/shotcheck.py` lesen:
//
//     <name>: rect id=3 kind=2 x=8 y=40 w=100 h=32
//
// Bis hierher hat jedes Programm diese Schleife selbst geschrieben
// (widgetdemo, explorer, settings -- dreimal derselbe Code mit drei
// Puffern). Sie gehoert in die Bibliothek: WAS ein Programm hingelegt
// hat, weiss die Bibliothek besser als das Programm, und ein Pruefer,
// der fuenf verschiedene Schreibweisen lesen muss, misst irgendwann
// eine davon nicht mehr.
fn say_rects(name: u64) {
    var s_r: [u8; 8] = ": rect \0"
    var s_id: [u8; 4] = "id=\0"
    var s_k: [u8; 7] = " kind=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_h: [u8; 4] = " h=\0"
    var i: u64 = 0
    while i < nwd {
        if (g(i, D_FLAGS) & F_HIDE) == 0 {
            ulib.say(name)
            ulib.say((&s_r[0 as usize]) as u64)
            ulib.say((&s_id[0 as usize]) as u64)
            ulib.sayn(i)
            ulib.say((&s_k[0 as usize]) as u64)
            ulib.sayn(g(i, D_KIND))
            ulib.say((&s_x[0 as usize]) as u64)
            ulib.sayn(g(i, D_X))
            ulib.say((&s_y[0 as usize]) as u64)
            ulib.sayn(g(i, D_Y))
            ulib.say((&s_w[0 as usize]) as u64)
            ulib.sayn(g(i, D_W))
            ulib.say((&s_h[0 as usize]) as u64)
            ulib.sayn(g(i, D_H))
            ulib.nl()
        }
        i = i + 1
    }
}

fn say_window(i: u64) {
    if s_trace == 0 || i >= MAXWN {
        return
    }
    let hh: u64 = ng(i, N_H)
    if hh == 0 {
        return
    }
    let b: u64 = (&tr_buf[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&tw_a[0 as usize]) as u64)
    at = tr_num(b, at, hh)
    at = tr_put(b, at, (&tw_x[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, N_X))
    at = tr_put(b, at, (&tw_y[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, N_Y))
    at = tr_put(b, at, (&tw_w[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, N_W))
    at = tr_put(b, at, (&tw_h[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, N_HH))
    at = tr_put(b, at, (&tw_cx[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, N_X)
        + wlibc.sys3w(wlibc.WM_INFO, hh, wlibc.WI_INX, 0))
    at = tr_put(b, at, (&tw_cy[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, N_Y)
        + wlibc.sys3w(wlibc.WM_INFO, hh, wlibc.WI_INY, 0))
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(b, at)
}

fn window_kind(w: u64) -> u64 {
    return ng(w, N_KIND)
}

fn handle(w: u64) -> u64 {
    return ng(w, N_H)
}

// Wo das Fenster auf dem BILDSCHIRM steht. Ein Menue liegt am Zeiger
// und nicht an einer Stelle, die ein Testlaeufer erraten kann -- also
// sagt die Bibliothek sie.
fn win_x(w: u64) -> u64 {
    return ng(w, N_X)
}

fn win_y(w: u64) -> u64 {
    return ng(w, N_Y)
}

fn win_w(w: u64) -> u64 {
    return ng(w, N_W)
}

fn win_h(w: u64) -> u64 {
    return ng(w, N_HH)
}

fn closed(w: u64) -> bool {
    return ng(w, N_H) == 0
}

fn close(w: u64) {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return
    }
    wlibc.sys3w(wlibc.WM_CLOSE, ng(w, N_H), 0, 0)
    ns(w, N_H, 0)
    // Die Widgets dieses Fensters verschwinden mit ihm.
    var i: u64 = 0
    while i < nwd {
        if g(i, D_WIN) == w {
            s(i, D_FLAGS, g(i, D_FLAGS) | F_HIDE)
        }
        i = i + 1
    }
}

// ------------------------------------------------- der schmutzige Teil
//
// BIS ZU VIER RECHTECKE JE FENSTER, UND NICHT EINES. Die erste Fassung
// fuehrte EIN Rechteck und legte jede Meldung hinein -- die Vereinigung
// von allem. Das ist bequem und es ist gemessen falsch: bewegt sich der
// Zeiger von einem Knopf oben zu einer Liste unten, sind beide
// schmutzig, die Vereinigung ist das halbe Fenster, und dazwischen wird
// alles neu gemalt, was sich nicht geaendert hat. Gemessen: EIN Klick
// auf ein Kaestchen kostete so 82 992 von 192 000 Bildpunkten -- Faktor
// 2,3 statt Faktor 30.
//
// Also vier Rechtecke, und die Regel zum Zusammenlegen ist eine
// Flaechenregel: zwei werden nur dann eines, wenn die Vereinigung nicht
// mehr als ein Drittel groesser ist als beide zusammen. Sind alle vier
// belegt, wird das Paar zusammengelegt, das dabei am wenigsten
// hinzufuegt -- so bleibt die Zahl beschraenkt und die Flaeche klein.
const DIRT_MAX: u64 = 4

// RUNDE ECHTHARDWARE-2: 80 statt 64 -- dieselbe Rechnung wie bei `wn`
// eine Seite weiter oben, und derselbe Grund: MAXWN ist 5.
// 5 * DIRT_MAX(4) * 4 = 80.
static mut dr: [u64; 80] = [0 as u64; 80] // MAXWN * DIRT_MAX * 4

fn dg(w: u64, k: u64, f: u64) -> u64 {
    return dr[((w * DIRT_MAX + k) * 4 + f) as usize]
}

fn ds(w: u64, k: u64, f: u64, v: u64) {
    dr[((w * DIRT_MAX + k) * 4 + f) as usize] = v
}

fn flaeche(x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    return (x1 - x0) * (y1 - y0)
}

fn setz(w: u64, k: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    ds(w, k, 0, x0)
    ds(w, k, 1, y0)
    ds(w, k, 2, x1)
    ds(w, k, 3, y1)
}

fn vereinen(w: u64, k: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    var a: u64 = dg(w, k, 0)
    var b: u64 = dg(w, k, 1)
    var c: u64 = dg(w, k, 2)
    var d: u64 = dg(w, k, 3)
    if x0 < a {
        a = x0
    }
    if y0 < b {
        b = y0
    }
    if x1 > c {
        c = x1
    }
    if y1 > d {
        d = y1
    }
    setz(w, k, a, b, c, d)
}

fn union_flaeche(w: u64, k: u64, x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    var a: u64 = dg(w, k, 0)
    var b: u64 = dg(w, k, 1)
    var c: u64 = dg(w, k, 2)
    var d: u64 = dg(w, k, 3)
    if x0 < a {
        a = x0
    }
    if y0 < b {
        b = y0
    }
    if x1 > c {
        c = x1
    }
    if y1 > d {
        d = y1
    }
    return flaeche(a, b, c, d)
}

fn dirty(w: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return
    }
    if x1 <= x0 || y1 <= y0 {
        return
    }
    var ax0: u64 = x0
    var ay0: u64 = y0
    var ax1: u64 = x1
    var ay1: u64 = y1
    if ax1 > ng(w, N_W) {
        ax1 = ng(w, N_W)
    }
    if ay1 > ng(w, N_HH) {
        ay1 = ng(w, N_HH)
    }
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    let neu_f: u64 = flaeche(ax0, ay0, ax1, ay1)
    var n: u64 = ng(w, N_NDIRT)
    // 1. Passt es guenstig zu einem der vorhandenen?
    var beste: u64 = DIRT_MAX
    var bester_zuwachs: u64 = 0xFFFFFFFFFFFFFFFF
    var k: u64 = 0
    while k < n {
        let alt_f: u64 = flaeche(dg(w, k, 0), dg(w, k, 1), dg(w, k, 2),
            dg(w, k, 3))
        let uf: u64 = union_flaeche(w, k, ax0, ay0, ax1, ay1)
        if uf * 3 <= (alt_f + neu_f) * 4 {
            let zuwachs: u64 = uf - alt_f
            if zuwachs < bester_zuwachs {
                bester_zuwachs = zuwachs
                beste = k
            }
        }
        k = k + 1
    }
    if beste < DIRT_MAX {
        vereinen(w, beste, ax0, ay0, ax1, ay1)
        return
    }
    // 2. Ist noch ein Platz frei?
    if n < DIRT_MAX {
        setz(w, n, ax0, ay0, ax1, ay1)
        ns(w, N_NDIRT, n + 1)
        return
    }
    // 3. Alle belegt: das Paar zusammenlegen, das am wenigsten kostet.
    var pa: u64 = 0
    var pb: u64 = 1
    var billigst: u64 = 0xFFFFFFFFFFFFFFFF
    var i: u64 = 0
    while i < n {
        var j: u64 = i + 1
        while j < n {
            let fi: u64 = flaeche(dg(w, i, 0), dg(w, i, 1), dg(w, i, 2),
                dg(w, i, 3))
            let fj: u64 = flaeche(dg(w, j, 0), dg(w, j, 1), dg(w, j, 2),
                dg(w, j, 3))
            let u: u64 = union_flaeche(w, i, dg(w, j, 0), dg(w, j, 1),
                dg(w, j, 2), dg(w, j, 3))
            if u - fi - fj < billigst {
                billigst = u - fi - fj
                pa = i
                pb = j
            }
            j = j + 1
        }
        i = i + 1
    }
    vereinen(w, pa, dg(w, pb, 0), dg(w, pb, 1), dg(w, pb, 2), dg(w, pb, 3))
    setz(w, pb, ax0, ay0, ax1, ay1)
}

fn dirty_all(w: u64) {
    ns(w, N_NDIRT, 1)
    setz(w, 0, 0, 0, ng(w, N_W), ng(w, N_HH))
}

fn dirty_wd(i: u64) {
    dirty(g(i, D_WIN), g(i, D_X), g(i, D_Y), g(i, D_X) + g(i, D_W),
        g(i, D_Y) + g(i, D_H))
}

// ------------------------------------------------------- die Anordnung
//
// DREI KAESTEN, UND SIE SETZEN, WAS MAN IHNEN GIBT.
//
//   senkrecht  jedes Widget bekommt die volle Breite des Kastens und
//              seine Wunschhoehe; der Setzpunkt wandert nach unten.
//   waagerecht jedes bekommt seine Wunschbreite und die volle Hoehe;
//              der Setzpunkt wandert nach rechts. Eine Wunschbreite
//              von 0 heisst "nimm, was uebrig ist" -- so bekommt eine
//              Pfadleiste ihren Platz zwischen zwei Knoepfen.
//   Raster     `cols` Spalten gleicher Breite, Zeilenhoehe ist die
//              hoechste Wunschhoehe der Zeile.
//
// Das ist eine Anordnung und kein Loeser. Was sie kann, steht hier;
// was sie nicht kann -- Gewichte, Mindestgroessen, Ausdehnen in beide
// Richtungen zugleich -- steht in docs/ROUNDK15.md unter den Grenzen.
//
// SIE LAEUFT BEI JEDER GROESSENAENDERUNG NEU (`relayout`), und das ist
// der Grund, warum die Kaesten ueberhaupt gespeichert werden statt die
// Rechtecke nur einmal auszurechnen.

// RUNDE ALLTAG: DAS VIERER-RASTER, EINMAL IN DER BIBLIOTHEK.
//
// Jede Laenge, die ein Kasten vergibt, liegt auf einem Vielfachen von
// vier. Vorher kam sie aus der Textbreite eines Knopfes (78, 90, 112)
// oder aus der Schrifthoehe (18) -- Zahlen, die kein Raster kennen,
// und ein Bild, in dem nichts auf einer gemeinsamen Linie steht.
// Gemessen wird das von tools/design/messen.py; hier wird es
// hergestellt, damit KEIN Programm es selbst rechnen muss.
fn r4ab(v: u64) -> u64 {
    return v - (v % 4)
}

fn r4auf(v: u64) -> u64 {
    let r: u64 = v % 4
    if r == 0 {
        return v
    }
    return v + 4 - r
}

fn box_v(w: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64,
    gp: u64) -> u64 {
    return new_box(w, 1, x, y, bw, bh, pad, gp, 1)
}

fn box_h(w: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64,
    gp: u64) -> u64 {
    return new_box(w, 2, x, y, bw, bh, pad, gp, 1)
}

fn box_grid(w: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64, gp: u64,
    cols: u64) -> u64 {
    return new_box(w, 3, x, y, bw, bh, pad, gp, cols)
}

fn new_box(w: u64, kind: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64,
    gp: u64, cols: u64) -> u64 {
    if nct >= MAXCT {
        return MAXCT
    }
    let c: u64 = nct
    nct = nct + 1
    cs(c, C_KIND, kind)
    // RUNDE ALLTAG: auch die ECKE eines Kastens liegt auf dem Raster.
    // Ein mittig gesetzter Kasten rechnet (1280-420)/2 = 430 aus, und
    // damit stand im Sperrbildschirm KEINE einzige Laenge auf einer
    // Vierer-Linie. Aufgerundet, nicht abgerundet: nach unten koennte
    // ein Kasten, der unter einer Reiterleiste beginnt, in sie
    // hineinrutschen.
    cs(c, C_X, r4auf(x))
    cs(c, C_Y, r4auf(y))
    cs(c, C_W, bw)
    cs(c, C_H, bh)
    cs(c, C_PAD, pad)
    cs(c, C_GAP, gp)
    cs(c, C_COLS, cols)
    cs(c, C_WIN, w)
    reset_box(c)
    ctcur = c
    wncur = w
    return c
}

fn reset_box(c: u64) {
    cs(c, C_CX, cg(c, C_X) + cg(c, C_PAD))
    cs(c, C_CY, cg(c, C_Y) + cg(c, C_PAD))
    cs(c, C_COL, 0)
    cs(c, C_ROWH, 0)
}

fn box_end() {
    ctcur = 0xFFFFFFFFFFFFFFFF
}

// ROUND THEMESTORE: MOVE A BOX AFTER THE FACT.
//
// The two-column Darstellung page needs to know where the tab bar
// ends, and the tab bar's height is a TOKEN -- 26 under `classic`, 32
// under `modern`. So the columns cannot be given a fixed y at build
// time and left there: a shape change at run time would slide the tab
// bar down onto them. The settings program re-measures and calls this
// after every `reshape`, which is exactly what `reshape` exists for.
// WHICH BOX THE NEXT WIDGET GOES INTO. `box_v` and friends both
// CREATE a box and select it; a page laid out in two columns has to be
// able to go back to the first one, and that is all this does.
fn box_use(c: u64) {
    if c >= nct {
        return
    }
    ctcur = c
    wncur = cg(c, C_WIN)
}

fn box_at(c: u64, x: u64, y: u64, bw: u64, bh: u64) {
    if c >= nct {
        return
    }
    cs(c, C_X, r4auf(x))
    cs(c, C_Y, r4auf(y))
    cs(c, C_W, bw)
    cs(c, C_H, bh)
    reset_box(c)
}

// Die Wunschgroesse des NAECHSTEN Widgets. Danach ist sie wieder
// vergessen -- eine Wunschgroesse, die haengenbleibt, ist die Sorte
// Zustand, die man erst bemerkt, wenn drei Knoepfe zu hoch sind.
fn size(w: u64, h: u64) {
    want_w = w
    want_h = h
}

// RUNDE ALLTAG: die Wunschgroesse NACHTRAEGLICH aendern.
//
// `size` gilt fuer das naechste Bedienelement; danach war die Groesse
// fest. Ein Fenster, das seinen Inhalt an seine eigene Hoehe anpasst
// (die Bildflaeche des Betrachters), braucht genau das -- sonst bleibt
// unter dem Bild ein Streifen Luft stehen, der von nichts kommt.
// `neu_setzen` danach ordnet an.
fn setz_groesse(i: u64, w: u64, h: u64) {
    if i >= nwd {
        return
    }
    s(i, D_PW, w)
    s(i, D_PH, h)
}

fn gap_after(n: u64) {
    want_gap = n
}

fn place(i: u64) {
    let c: u64 = g(i, D_CT)
    if c >= MAXCT {
        return
    }
    let innen: u64 = sub(cg(c, C_W), 2 * cg(c, C_PAD))
    let kind: u64 = cg(c, C_KIND)
    var pw: u64 = g(i, D_PW)
    var ph: u64 = g(i, D_PH)
    if ph == 0 {
        ph = 24
    }
    ph = r4auf(ph)
    if kind == 1 {
        s(i, D_X, cg(c, C_CX))
        s(i, D_Y, cg(c, C_CY))
        var bw: u64 = r4ab(innen)
        if pw != 0 && r4auf(pw) < bw {
            bw = r4auf(pw)
        }
        s(i, D_W, bw)
        s(i, D_H, ph)
        cs(c, C_CY, cg(c, C_CY) + ph + cg(c, C_GAP))
    } else if kind == 2 {
        let rest: u64 = sub(cg(c, C_X) + cg(c, C_W) - cg(c, C_PAD),
            cg(c, C_CX))
        var bw2: u64 = r4auf(pw)
        if pw == 0 || bw2 > r4ab(rest) {
            bw2 = r4ab(rest)
        }
        s(i, D_X, cg(c, C_CX))
        s(i, D_Y, cg(c, C_CY))
        s(i, D_W, bw2)
        var bh2: u64 = ph
        let hoch: u64 = sub(cg(c, C_H), 2 * cg(c, C_PAD))
        if g(i, D_PH) == 0 && hoch > 0 {
            bh2 = r4ab(hoch)
        }
        s(i, D_H, bh2)
        cs(c, C_CX, cg(c, C_CX) + bw2 + cg(c, C_GAP))
    } else {
        let cols: u64 = cg(c, C_COLS)
        var zw: u64 = 40
        if cols > 0 {
            zw = sub(innen + cg(c, C_GAP), 0) / cols
            if zw > cg(c, C_GAP) {
                zw = zw - cg(c, C_GAP)
            }
            zw = r4ab(zw)
        }
        s(i, D_X, cg(c, C_CX))
        s(i, D_Y, cg(c, C_CY))
        s(i, D_W, zw)
        s(i, D_H, ph)
        if ph > cg(c, C_ROWH) {
            cs(c, C_ROWH, ph)
        }
        cs(c, C_COL, cg(c, C_COL) + 1)
        if cg(c, C_COL) >= cols {
            cs(c, C_COL, 0)
            cs(c, C_CX, cg(c, C_X) + cg(c, C_PAD))
            cs(c, C_CY, cg(c, C_CY) + cg(c, C_ROWH) + cg(c, C_GAP))
            cs(c, C_ROWH, 0)
        } else {
            cs(c, C_CX, cg(c, C_CX) + zw + cg(c, C_GAP))
        }
    }
    if want_gap != 0 {
        if kind == 2 {
            cs(c, C_CX, cg(c, C_CX) + want_gap)
        } else {
            cs(c, C_CY, cg(c, C_CY) + want_gap)
        }
        want_gap = 0
    }
}

// Alle Kaesten von vorn setzen. Wird nach einer Groessenaenderung
// gerufen und nach jeder Aenderung, die Platz kostet.
fn relayout() {
    var c: u64 = 0
    while c < nct {
        // Kaesten, die die volle Fensterbreite wollten, wachsen mit.
        let w: u64 = cg(c, C_WIN)
        if cg(c, C_W) == 0 {
            cs(c, C_W, ng(w, N_W))
        }
        reset_box(c)
        c = c + 1
    }
    var i: u64 = 0
    while i < nwd {
        if (g(i, D_FLAGS) & F_HIDE) == 0 {
            place(i)
        }
        i = i + 1
    }
}

// ============================ ROUND LOOK: THE SHAPE CHANGED UNDER US
//
// A widget takes its height when it is CREATED (`add`), because that is
// when the box it goes into needs to know how much room to leave. Change
// `shape=` at run time and every one of those heights is stale: 32-pixel
// buttons would be drawn into 26-pixel rectangles, the click targets
// would sit where the old ones were, and the page would look like a
// misprint.
//
// So a shape change is a re-measurement and not a repaint. This walks
// the widget table, asks the CURRENT tokens for the height of each kind,
// and lays the boxes out again. Nothing else moves: every widget keeps
// its number, its value, its focus and -- the one that matters -- the
// TEXT POINTER it was given, which is why a shape change and a language
// change can happen in either order.
//
// Widths are left alone except for buttons, whose width is text plus
// padding and therefore also a function of a token.
fn reshape() {
    var i: u64 = 0
    while i < nwd {
        let k: u64 = g(i, D_KIND)
        if k == K_BUTTON {
            s(i, D_H, wlibc.metric(wlibc.M_CTRL_H))
            let t: u64 = g(i, D_TEXT)
            let want: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), t, tlen(t))
                + wlibc.metric(wlibc.M_PAD_X) * 2
            // A button that was given a width by `size()` keeps it --
            // the dialog buttons are meant to be equal, not snug.
            if g(i, D_W) < want {
                s(i, D_W, want)
            }
        } else if k == K_TABS {
            s(i, D_H, wlibc.metric(wlibc.M_CTRL_H))
        } else if k == K_ENTRY || k == K_CHOICE {
            s(i, D_H, ctrl_thin())
        } else if k == K_CHECK || k == K_MENUBAR || k == K_SLIDER {
            // RUNDE TON-2: der Regler richtet sich wie jedes andere
            // Bedienelement nach dem Thema. Ohne diese Zeile behielte
            // er nach einem Themenwechsel seine alte Hoehe, waehrend
            // alles um ihn herum sich aendert.
            s(i, D_H, ctrl_small())
        } else if k == K_SEP {
            s(i, D_H, sep_h())
        } else if k == K_SCROLL {
            s(i, D_W, scroll_w())
        } else if k == K_TILE {
            s(i, D_H, tile_h())
        }
        i = i + 1
    }
    relayout()
}

// ------------------------------------------------------- die Widgets

fn add(kind: u64, txt: u64, pw: u64, ph: u64, fokus: bool) -> u64 {
    if nwd >= MAXWD {
        return 0
    }
    let i: u64 = nwd
    nwd = nwd + 1
    s(i, D_KIND, kind)
    s(i, D_TEXT, txt)
    s(i, D_WIN, wncur)
    s(i, D_CT, ctcur)
    s(i, D_PW, want_w)
    s(i, D_PH, want_h)
    if want_w == 0 {
        s(i, D_PW, pw)
    }
    if want_h == 0 {
        s(i, D_PH, ph)
    }
    want_w = 0
    want_h = 0
    var fl: u64 = 0
    if fokus {
        fl = F_FOCUSABLE
    }
    s(i, D_FLAGS, fl)
    place(i)
    if s_focus == 0 && fokus {
        s_focus = i + 1
    }
    return i
}

fn label(txt: u64) -> u64 {
    return add(K_LABEL, txt, 0, wlibc.text_h(wlibc.px_ui()), false)
}

// EINE KARTE. Sie nimmt den Platz, den ihr Kasten ihr gibt -- also
// `size(bw, bh)` davor, wie bei jedem anderen Bedienelement.
fn card() -> u64 {
    return add(K_CARD, 0, 0, 0, false)
}

// RUNDE WERKZEUGE: der Verlaufsgraph. Er nimmt den Platz, den sein
// Kasten ihm gibt -- also `size(bw, bh)` davor, wie bei jedem anderen
// Bedienelement.
fn graph(spec: u64) -> u64 {
    let i: u64 = add(K_GRAPH, 0, 0, 0, false)
    s(i, D_A, spec)
    return i
}

fn leinwand(px: u64, bw: u64, bh: u64) -> u64 {
    let i: u64 = add(K_LEINWAND, px, bw, bh, true)
    s(i, D_A, bw)
    s(i, D_B, bh)
    s(i, D_C, bw)
    return i
}

// Ein anderer Puffer (nach einer Groessenaenderung): Zeiger, Breite,
// Hoehe, Zeilenlaenge in Bildpunkten.
fn leinwand_setzen(i: u64, px: u64, bw: u64, bh: u64, zeile: u64) {
    if i >= nwd || g(i, D_KIND) != K_LEINWAND {
        return
    }
    s(i, D_TEXT, px)
    s(i, D_A, bw)
    s(i, D_B, bh)
    s(i, D_C, zeile)
    dirty_wd(i)
}

// Die Bildpunkte haben sich geaendert -- ganz ...
fn leinwand_neu(i: u64) {
    if i >= nwd {
        return
    }
    dirty_wd(i)
}

// ... oder in einem Ausschnitt (in Leinwandkoordinaten, [x0,x1) x [y0,y1)).
fn leinwand_neu_teil(i: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if i >= nwd {
        return
    }
    var ax: u64 = g(i, D_X) + x1
    var ay: u64 = g(i, D_Y) + y1
    if ax > g(i, D_X) + g(i, D_W) {
        ax = g(i, D_X) + g(i, D_W)
    }
    if ay > g(i, D_Y) + g(i, D_H) {
        ay = g(i, D_Y) + g(i, D_H)
    }
    dirty(g(i, D_WIN), g(i, D_X) + x0, g(i, D_Y) + y0, ax, ay)
}

fn lw_push(i: u64, art: u64, a: u64, b: u64) {
    // Eine Bewegung ersetzt die vorige, wenn sie zuoberst liegt.
    if art == LE_MOVE && lw_head != lw_tail {
        let letzte: u64 = ((lw_head + LW_RING - 1) % LW_RING) * LE_FELDER
        if lw_q[(letzte + 1) as usize] == LE_MOVE
            && lw_q[(letzte) as usize] == i {
            lw_q[(letzte + 2) as usize] = a
            lw_q[(letzte + 3) as usize] = b
            return
        }
    }
    let naechste: u64 = (lw_head + 1) % LW_RING
    if naechste == lw_tail {
        // Voll: das aelteste faellt weg. Ein Ring, der den neuesten
        // Klick verwirft, waere der schlechtere.
        lw_tail = (lw_tail + 1) % LW_RING
    }
    let at: u64 = lw_head * LE_FELDER
    lw_q[(at) as usize] = i
    lw_q[(at + 1) as usize] = art
    lw_q[(at + 2) as usize] = a
    lw_q[(at + 3) as usize] = b
    lw_head = naechste
}

// Das naechste Ereignis der Leinwand in vier Woerter (Widget, Art, a,
// b) hinter `aus`. false = keines.
fn leinwand_ereignis(aus: u64) -> bool {
    if lw_head == lw_tail {
        return false
    }
    let at: u64 = lw_tail * LE_FELDER
    __mmio_write64((aus) as *mut u64, lw_q[(at) as usize])
    __mmio_write64((aus + 8) as *mut u64, lw_q[(at + 1) as usize])
    __mmio_write64((aus + 16) as *mut u64, lw_q[(at + 2) as usize])
    __mmio_write64((aus + 24) as *mut u64, lw_q[(at + 3) as usize])
    lw_tail = (lw_tail + 1) % LW_RING
    return true
}

fn leinwand_anstehend() -> u64 {
    return (lw_head + LW_RING - lw_tail) % LW_RING
}

// Das Malen: der Ausschnitt des Streifens, den die Leinwand bedeckt,
// Zeile fuer Zeile aus dem Puffer des Aufrufers. Was die Leinwand nicht
// bedeckt (ein Widget, das groesser ist als sein Puffer), behaelt den
// Hintergrund, den `paint_bg` schon gemalt hat.
fn paint_leinwand(i: u64) {
    let px: u64 = g(i, D_TEXT)
    if px == 0 {
        return
    }
    let bw: u64 = g(i, D_A)
    let bh: u64 = g(i, D_B)
    let zeile: u64 = g(i, D_C)
    var ww: u64 = g(i, D_W)
    if ww > bw {
        ww = bw
    }
    var hh: u64 = g(i, D_H)
    if hh > bh {
        hh = bh
    }
    var x0: u64 = g(i, D_X)
    var x1: u64 = g(i, D_X) + ww
    var y0: u64 = g(i, D_Y)
    var y1: u64 = g(i, D_Y) + hh
    if x0 < wlibc.clip_x0() {
        x0 = wlibc.clip_x0()
    }
    if x1 > wlibc.clip_x1() {
        x1 = wlibc.clip_x1()
    }
    if y0 < wlibc.clip_y0() {
        y0 = wlibc.clip_y0()
    }
    if y1 > wlibc.clip_y1() {
        y1 = wlibc.clip_y1()
    }
    let band: u64 = wlibc.band_y()
    let rows: u64 = wlibc.surf_rows()
    let sw: u64 = wlibc.surf_w()
    if x1 > sw {
        x1 = sw
    }
    if x1 <= x0 {
        return
    }
    if y0 < band {
        y0 = band
    }
    if y1 > band + rows {
        y1 = band + rows
    }
    let n: u64 = (x1 - x0) * 4
    var y: u64 = y0
    while y < y1 {
        let quelle: u64 = px + ((y - g(i, D_Y)) * zeile + (x0 - g(i, D_X))) * 4
        let ziel: u64 = wlibc.surface() + ((y - band) * sw + x0) * 4
        ulib.copy(ziel, quelle, n)
        y = y + 1
    }
}

fn gspec(i: u64, f: u64) -> u64 {
    let p: u64 = g(i, D_A)
    if p == 0 {
        return 0
    }
    return __mmio_read64((p + f * 8) as *mut u64)
}

// WO EIN MESSPUNKT LIEGT. Die beiden Funktionen sind EXPORTIERT, damit
// ein Testlaeufer im Bild an derselben Stelle nachsehen kann, an der
// gemalt wurde -- und nicht an einer, die er selbst ausgerechnet hat.
// Dieselbe Regel wie bei `rect_x` und `text_base` seit Runde K15.
fn graph_x(i: u64, k: u64) -> u64 {
    let hist: u64 = gspec(i, GR_HIST)
    if hist == 0 {
        return g(i, D_X)
    }
    return g(i, D_X) + 1 + k * sub(g(i, D_W), 2) / hist
}

fn graph_y(i: u64, v: u64) -> u64 {
    var m: u64 = gspec(i, GR_MAX)
    if m == 0 {
        m = 1
    }
    var w: u64 = v
    if w > m {
        w = m
    }
    let innen: u64 = sub(g(i, D_H), 3)
    return g(i, D_Y) + 1 + innen - w * innen / m
}

fn graph_wert(p: u64, k: u64) -> u64 {
    if p == 0 {
        return 0
    }
    return __mmio_read64((p + k * 8) as *mut u64)
}

// EINE KURVE. `dick` ist zwei Bildpunkte breit und durchgezogen, duenn
// ist einer und nur an jeder zweiten Stelle gemalt -- der zweite
// Unterschied neben der Farbe, damit die zwei Reihen auch dann zu
// trennen sind, wenn jemand die Farben nicht unterscheiden kann.
fn paint_kurve(i: u64, reihe: u64, farbe: u64, dick: bool) {
    let n: u64 = gspec(i, GR_N)
    if reihe == 0 || n == 0 {
        return
    }
    var k: u64 = 0
    while k < n {
        let x: u64 = graph_x(i, k)
        let y: u64 = graph_y(i, graph_wert(reihe, k))
        var y0: u64 = y
        if k > 0 {
            y0 = graph_y(i, graph_wert(reihe, k - 1))
        }
        var oben: u64 = y
        var unten: u64 = y0
        if y0 < y {
            oben = y0
            unten = y
        }
        if dick {
            wlibc.rect(x, oben, 2, unten - oben + 2, farbe)
        } else if (k % 2) == 0 {
            wlibc.rect(x, oben, 1, unten - oben + 1, farbe)
        }
        k = k + 1
    }
}

fn paint_graph(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    if bw < 8 || bh < 8 {
        return
    }
    let r: u64 = wlibc.metric(wlibc.M_RADIUS_PANEL)
    wlibc.rrect(x, y, bw, bh, r,
        wlibc.theme_semantic(wlibc.S_SURFACE_SUNKEN))
    wlibc.rring(x, y, bw, bh, r, 1, wlibc.theme_semantic(wlibc.S_BORDER))
    // Das Gitter bei einem, zwei und drei Vierteln. Ohne es ist eine
    // Kurve eine Linie ohne Massstab.
    var q: u64 = 1
    while q < 4 {
        wlibc.hline(x + 1, y + bh * q / 4, sub(bw, 2),
            wlibc.theme_semantic(wlibc.S_BORDER))
        q = q + 1
    }
    paint_kurve(i, gspec(i, GR_B), wlibc.theme_semantic(wlibc.S_SUCCESS),
        false)
    paint_kurve(i, gspec(i, GR_A), wlibc.theme_semantic(wlibc.S_ACCENT),
        true)
}

// ROUND LOOK: THE SIZE OF A CONTROL IS A TOKEN, NOT A LITERAL.
// `24` was two lots of twelve and `26` was a height; both are now
// asked for, and with `shape=classic` both come back as 24 and 26.
fn button(txt: u64) -> u64 {
    let pad: u64 = wlibc.metric(wlibc.M_PAD_X)
    let w: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), txt, tlen(txt))
        + pad * 2
    return add(K_BUTTON, txt, w, wlibc.metric(wlibc.M_CTRL_H), true)
}

// RUNDE TON-2: EIN SCHIEBEREGLER, 0..100.
//
// `txt` ist die Beschriftung LINKS davon (0 = keine). Der Wert steht
// wie bei jedem anderen Widget in `value`/`set_value`.
//
// DIE HOEHE IST `ctrl_small()` UND NICHT DIE DER RINNE. Die Rinne ist
// vier Bildpunkte hoch; ein Widget, das nur vier Bildpunkte hoch ist,
// laesst sich nicht treffen. Gemessen wird die Klickflaeche
// (tools/design/messen.py, Frage 2, Grenze 32 Bildpunkte), und die
// ist hier die ganze Widgethoehe.


fn check(txt: u64, on: bool) -> u64 {
    let i: u64 = add(K_CHECK, txt, 0, ctrl_small(), true)
    if on {
        s(i, D_VAL, 1)
    }
    return i
}

// Ein Textfeld arbeitet auf dem Puffer DES AUFRUFERS. Die Bibliothek
// legt keinen an: wer den Text hinterher braucht, hat ihn dann schon.
fn entry(buf: u64, max: u64) -> u64 {
    let i: u64 = add(K_ENTRY, buf, 0, ctrl_thin(), true)
    s(i, D_D, max)
    s(i, D_B, tlen(buf))
    s(i, D_C, tlen(buf))
    return i
}

fn list(blob: u64, rows: u64) -> u64 {
    let i: u64 = add(K_LIST, blob, 0, rows * zeilen_hoehe() + 4, true)
    s(i, D_VAL, 0)
    s(i, D_A, 0)
    count_rows(i)
    return i
}

// Eine Tabelle bekommt die Zeilen als EINEN Text: Spalten durch
// Tabulator getrennt, Zeilen durch Zeilenumbruch. Kein Modell, keine
// Rueckrufe -- die Sprache hat keine Funktionszeiger, und ein
// Zeilenpuffer ist das, was ein Dateimanager ohnehin baut.
// Ein Klick genuegt. Fuer das Startmenue; ueberall sonst bleibt es
// beim Doppelklick.
fn list_einklick(i: u64, an: bool) {
    if i >= MAXWD {
        return
    }
    if an {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_EINKLICK)
    } else {
        s(i, D_FLAGS, g(i, D_FLAGS) & ~F_EINKLICK)
    }
}

fn table(blob: u64, rows: u64, cols: u64, breiten: u64) -> u64 {
    let i: u64 = add(K_TABLE, blob, 0,
        rows * zeilen_hoehe() + zeilen_hoehe() + 4, true)
    s(i, D_C, cols)
    s(i, D_D, breiten)
    s(i, D_VAL, 0)
    s(i, D_A, 0)
    count_rows(i)
    return i
}

fn tabs(txt: u64) -> u64 {
    return add(K_TABS, txt, 0, wlibc.metric(wlibc.M_CTRL_H), true)
}

fn menubar(txt: u64) -> u64 {
    return add(K_MENUBAR, txt, 0, ctrl_small(), false)
}

fn choice(txt: u64, sel: u64) -> u64 {
    let i: u64 = add(K_CHOICE, txt, 0, ctrl_thin(), true)
    s(i, D_VAL, sel)
    return i
}

// ============================ RUNDE ALLTAG: DIE BILDFLAECHE
//
// Sie bekommt einen Zeiger auf ein Feld aus u32 (0xAARRGGBB, eine Zahl
// je Bildpunkt, zeilenweise) und malt es -- vergroessert, verschoben,
// gedreht. Die Bibliothek KOPIERT das Bild nicht: ein Foto sind
// Megabytes, und ein Prozess dieses Systems hat sechs davon.
//
// VERGROESSERT WIRD MIT DEM NAECHSTEN NACHBARN. Das ist die richtige
// Wahl fuer das, wofuer diese Flaeche da ist: ein Bildschirmfoto beim
// Hineinzoomen soll KANTEN zeigen und keine weichgezeichnete Ahnung
// davon, wo der Text stand.
fn bild(p: u64, w: u64, h: u64) -> u64 {
    let i: u64 = add(K_BILD, 0, 0, 0, true)
    s(i, D_E, p)
    s(i, D_F, w)
    s(i, D_G, h)
    s(i, D_ZOOM, 100)
    s(i, D_PX, 0)
    s(i, D_PY, 0)
    s(i, D_DREH, 0)
    return i
}

fn bild_setzen(i: u64, p: u64, w: u64, h: u64) {
    if i >= nwd || g(i, D_KIND) != K_BILD {
        return
    }
    s(i, D_E, p)
    s(i, D_F, w)
    s(i, D_G, h)
    s(i, D_PX, 0)
    s(i, D_PY, 0)
    s(i, D_DREH, 0)
    s(i, D_ZOOM, 100)
    dirty_wd(i)
}

fn bild_bw(i: u64) -> u64 {
    if g(i, D_DREH) == 1 || g(i, D_DREH) == 3 {
        return g(i, D_G)
    }
    return g(i, D_F)
}

fn bild_bh(i: u64) -> u64 {
    if g(i, D_DREH) == 1 || g(i, D_DREH) == 3 {
        return g(i, D_F)
    }
    // D_G ist die Hoehe DES BILDES. Hier stand D_H -- die Hoehe des
    // WIDGETS -- und damit war das Bild nie senkrecht mittig und
    // "Anpassen" rechnete mit der falschen Zahl. Im Bild zu sehen: das
    // Foto klebte oben am Rand.
    return g(i, D_G)
}

// Welches Werkzeug die Maus auf der Bildflaeche ist: 0 schiebt das
// Bild, 1 zieht einen Ausschnitt auf. Das Ausschnittwerkzeug braucht
// das zweite, der Betrachter das erste.
fn bild_werkzeug(i: u64, m: u64) {
    if i >= nwd || g(i, D_KIND) != K_BILD {
        return
    }
    s(i, D_WZ, m)
    s_aus_da = 0
    dirty_wd(i)
}

// Die Ecke des Bildes auf dem Schirm -- dieselbe Rechnung wie in
// `paint_bild`, und deshalb steht sie einmal hier und nicht zweimal.
fn bild_ox(i: u64) -> u64 {
    let zw: u64 = bild_bw(i) * g(i, D_ZOOM) / 100
    var ox: u64 = g(i, D_X)
    if zw < g(i, D_W) {
        ox = g(i, D_X) + (g(i, D_W) - zw) / 2
    }
    return ox +% g(i, D_PX)
}

fn bild_oy(i: u64) -> u64 {
    let zh: u64 = bild_bh(i) * g(i, D_ZOOM) / 100
    var oy: u64 = g(i, D_Y)
    if zh < g(i, D_H) {
        oy = g(i, D_Y) + (g(i, D_H) - zh) / 2
    }
    return oy +% g(i, D_PY)
}

// Ein Punkt auf dem Schirm als Punkt IM BILD. Ausserhalb wird auf den
// Rand geklemmt -- wer ueber den Rand hinauszieht, meint den Rand.
fn bild_px(i: u64, x: u64) -> u64 {
    let ox: u64 = bild_ox(i)
    if x <= ox {
        return 0
    }
    let v: u64 = (x - ox) * 100 / g(i, D_ZOOM)
    if v >= g(i, D_F) {
        return g(i, D_F) - 1
    }
    return v
}

fn bild_py(i: u64, y: u64) -> u64 {
    let oy: u64 = bild_oy(i)
    if y <= oy {
        return 0
    }
    let v: u64 = (y - oy) * 100 / g(i, D_ZOOM)
    if v >= g(i, D_G) {
        return g(i, D_G) - 1
    }
    return v
}

fn bild_aus_da() -> bool {
    return s_aus_da != 0
}

fn bild_aus_x0() -> u64 {
    if s_aus_x1 < s_aus_x0 {
        return s_aus_x1
    }
    return s_aus_x0
}

fn bild_aus_y0() -> u64 {
    if s_aus_y1 < s_aus_y0 {
        return s_aus_y1
    }
    return s_aus_y0
}

fn bild_aus_x1() -> u64 {
    if s_aus_x1 < s_aus_x0 {
        return s_aus_x0
    }
    return s_aus_x1
}

fn bild_aus_y1() -> u64 {
    if s_aus_y1 < s_aus_y0 {
        return s_aus_y0
    }
    return s_aus_y1
}

fn bild_aus_weg() {
    s_aus_da = 0
}

fn bild_zoom(i: u64) -> u64 {
    return g(i, D_ZOOM)
}

fn bild_set_zoom(i: u64, z: u64) {
    if i >= nwd || g(i, D_KIND) != K_BILD {
        return
    }
    var v: u64 = z
    if v < 5 {
        v = 5
    }
    if v > 3200 {
        v = 3200
    }
    s(i, D_ZOOM, v)
    dirty_wd(i)
}

fn bild_schieben(i: u64, dx: u64, dy: u64) {
    if i >= nwd || g(i, D_KIND) != K_BILD {
        return
    }
    s(i, D_PX, g(i, D_PX) +% dx)
    s(i, D_PY, g(i, D_PY) +% dy)
    dirty_wd(i)
}

fn bild_drehen(i: u64, r: u64) {
    if i >= nwd || g(i, D_KIND) != K_BILD {
        return
    }
    s(i, D_DREH, (g(i, D_DREH) + r) & 3)
    s(i, D_PX, 0)
    s(i, D_PY, 0)
    dirty_wd(i)
}

fn bild_dreh_von(i: u64) -> u64 {
    return g(i, D_DREH)
}

// So gross, dass es ganz hineinpasst -- und nie ueber 100 Prozent, denn
// ein kleines Symbol auf Fensterbreite gezogen ist kein Bild mehr.
fn bild_anpassen(i: u64) {
    if i >= nwd || g(i, D_KIND) != K_BILD {
        return
    }
    let bw: u64 = bild_bw(i)
    let bh: u64 = bild_bh(i)
    if bw == 0 || bh == 0 {
        return
    }
    var z: u64 = g(i, D_W) * 100 / bw
    let zy: u64 = g(i, D_H) * 100 / bh
    if zy < z {
        z = zy
    }
    if z > 100 {
        z = 100
    }
    if z < 5 {
        z = 5
    }
    s(i, D_ZOOM, z)
    s(i, D_PX, 0)
    s(i, D_PY, 0)
    dirty_wd(i)
}

// ============================ RUNDE ALLTAG: DER SCHIEBEREGLER
//
// Wert zwischen `min` und `max`. Er meldet sich beim Ziehen UND beim
// Loslassen; wer nur das Ergebnis will, sieht auf `value` beim
// Loslassen, wer mitziehen will (die Vergroesserung im Bildbetrachter),
// nimmt jede Meldung.
fn slider(min: u64, max: u64, wert: u64) -> u64 {
    let i: u64 = add(K_SLIDER, 0, 0, ctrl_small(), true)
    s(i, D_E, min)
    s(i, D_F, max)
    if max <= min {
        s(i, D_F, min + 1)
    }
    s(i, D_VAL, wert)
    return i
}

fn slider_setz(i: u64, x: u64) {
    let lo: u64 = g(i, D_E)
    let hi: u64 = g(i, D_F)
    let bx: u64 = g(i, D_X) + thumb_w() / 2
    let bw: u64 = g(i, D_W) - thumb_w()
    var v: u64 = lo
    if bw > 0 {
        if x > bx {
            let d: u64 = x - bx
            if d >= bw {
                v = hi
            } else {
                v = lo + (hi - lo) * d / bw
            }
        }
    }
    if v != g(i, D_VAL) {
        s(i, D_VAL, v)
        dirty_wd(i)
    }
}

fn sep() -> u64 {
    return add(K_SEP, 0, 0, sep_h(), false)
}

// ============================ ROUND THEMESTORE: THE PREVIEW TILE
//
// Justin's words were "eine Vorschaukachel, die das ECHTE Aussehen
// zeigt (aus den Token gerendert, kein gemaltes Bild, das spaeter nicht
// mehr stimmt)". So there is no bitmap anywhere in this round.
//
// A tile is handed a block of `TILE_FIELDS` words -- the resolved
// component colours of ONE preset, its two corner radii, its shadow
// strength, which edge its taskbar sits on and where its buttons
// start -- and it draws a miniature of a desktop out of them with the
// same `rrect`, `rframe` and `drop_shadow` the real window uses. If a
// scheme file changes, the tile changes with it, because the tile was
// never a picture of the scheme; it is the scheme, drawn small.
//
// The block belongs to the CALLER, exactly like the buffer behind an
// entry field. This library does not resolve themes and is not going
// to start: `wlibc.theme_probe` resolves, `vorlage.fi` decides what to
// probe, and this draws what it is given.
// THE MINIATURE'S OWN GEOMETRY, NAMED.
//
// `tests/look/rawmetric.py` counts literal sizes in the argument
// positions of the drawing calls, and it would count every one of
// these -- rightly, by its own rule: a painting routine must not name
// a size. These are not interface sizes, they are the proportions of a
// PICTURE of an interface, and the honest way to say so is to give
// each of them a name and a reason here rather than to add an
// exception to the checker. A checker with an exception for the file
// that was just written is not a checker.
const TP_W: u64 = 92 // the picture half of a tile
const TP_BAR: u64 = 5 // the miniature taskbar
const TP_BTN: u64 = 14 // the button on it
const TP_WX: u64 = 8 // the window's inset from the picture's left
const TP_WY: u64 = 6 // and from its top
const TP_WW: u64 = 60 // the miniature window
const TP_TITLE: u64 = 7 // its title bar
const TP_LINE: u64 = 2 // a line of body text
const TP_MARK: u64 = 22 // the mark on the title bar
const TILE_FIELDS: u64 = 17
const TL_SURFACE: u64 = 0
const TL_RAISED: u64 = 1
const TL_ACCENT: u64 = 2
const TL_ONACCENT: u64 = 3
const TL_TEXT: u64 = 4
const TL_FRAME: u64 = 5
const TL_TASKBAR: u64 = 6
const TL_TBTEXT: u64 = 7
const TL_BUTTON: u64 = 8
const TL_RADW: u64 = 9
const TL_RADB: u64 = 10
const TL_SHADOW: u64 = 11
const TL_EDGE: u64 = 12
const TL_ALIGN: u64 = 13
const TL_NAME: u64 = 14
const TL_LOW: u64 = 15
const TL_DANGER: u64 = 16

fn tile(spec: u64) -> u64 {
    let i: u64 = add(K_TILE, 0, 0, tile_h(), true)
    s(i, D_A, spec)
    return i
}

// ONE ROW PLUS EIGHT PIXELS: 28 under `classic`, 32 under `modern`.
//
// That is not a taste, it is the answer to a subtraction. The window
// has 542 usable pixels, the tab bar and the status line take 92 of
// them, and ten tiles plus their heading plus the gaps have to fit in
// what is left. The number is derived from the `row` token so that it
// follows the shape instead of being measured once for one of them.
//
// RUNDE ALLTAG: ACHT UND NICHT ZEHN. Seit dieser Runde liegt jede
// Laenge, die ein Kasten vergibt, auf dem Vierer-Raster; `row + 10`
// ergab 34, wurde auf 36 aufgerundet, und die zehnte Kachel fiel
// unten aus dem Kasten heraus -- sichtbar daran, dass "Werkstatt"
// gemalt wurde und im Bild kein einziger Bildpunkt davon ankam.
// `row + 8` ist selbst schon ein Vielfaches von vier (32 unter
// `modern`), wird also nicht mehr gerundet, und zehn Kacheln haben
// wieder Luft.
fn tile_h() -> u64 {
    return wlibc.metric(wlibc.M_ROW) + 8
}

fn tspec(i: u64, f: u64) -> u64 {
    let p: u64 = g(i, D_A)
    if p == 0 {
        return 0
    }
    return __mmio_read64((p + f * 8) as *mut u64)
}

fn paint_tile(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let w: u64 = g(i, D_W)
    let h: u64 = g(i, D_H)
    if w < 40 || h < 20 {
        return
    }
    // THE PICTURE HALF IS ON THE RIGHT AND IS ALWAYS THE SAME SHAPE, so
    // that ten tiles under each other can be compared by eye and by a
    // pixel reader. 96 wide; the name gets the rest.
    let pw: u64 = TP_W
    let px: u64 = x + sub(w, pw)
    let ph: u64 = sub(h, 8)
    let py: u64 = y + 4
    let sel: bool = g(i, D_VAL) != 0
    // the tile's own surface, and the frame that says which one is
    // chosen -- the frame is the only part of a tile that comes from
    // the RUNNING theme, because "selected" is a fact about this
    // window and not about the preset.
    wlibc.rrect(x, y, w, h, wlibc.metric(wlibc.M_RADIUS_PANEL),
        tspec(i, TL_SURFACE))
    if sel {
        wlibc.rring(x, y, w, h, wlibc.metric(wlibc.M_RADIUS_PANEL),
            wlibc.metric(wlibc.M_FOCUS) + 1, wlibc.theme(wlibc.T_FOCUS))
    } else {
        wlibc.rring(x, y, w, h, wlibc.metric(wlibc.M_RADIUS_PANEL), 1,
            tspec(i, TL_FRAME))
    }
    // ---- the miniature taskbar, on ITS OWN edge
    let e: u64 = tspec(i, TL_EDGE)
    let bar: u64 = TP_BAR
    var bx: u64 = px
    var by: u64 = py
    var bw2: u64 = pw
    var bh2: u64 = bar
    if e == 1 {
        by = py
    } else if e == 2 {
        bw2 = bar
        bh2 = ph
    } else if e == 3 {
        bx = px + pw - bar
        bw2 = bar
        bh2 = ph
    } else {
        by = py + ph - bar
    }
    // the desktop under it
    wlibc.rect(px, py, pw, ph, tspec(i, TL_SURFACE))
    wlibc.rect(bx, by, bw2, bh2, tspec(i, TL_TASKBAR))
    // one button on the bar, where the alignment puts it
    let blen: u64 = TP_BTN
    if e == 2 || e == 3 {
        var byy: u64 = by + 3
        if tspec(i, TL_ALIGN) == 1 {
            byy = by + sub(bh2, blen) / 2
        }
        wlibc.rect(bx + 1, byy, sub(bar, TP_LINE), blen, tspec(i, TL_ACCENT))
    } else {
        var bxx: u64 = bx + 3
        if tspec(i, TL_ALIGN) == 1 {
            bxx = bx + sub(bw2, blen) / 2
        }
        wlibc.rect(bxx, by + 1, blen, sub(bar, TP_LINE), tspec(i, TL_ACCENT))
    }
    // ---- the miniature window, with ITS OWN radius and shadow
    var wx: u64 = px + TP_WX
    var wy: u64 = py + TP_WY
    if e == 1 {
        wy = py + TP_WY + 3
    }
    if e == 2 {
        wx = px + TP_WX + 4
    }
    let ww: u64 = TP_WW
    let wh: u64 = sub(ph, TP_WY * 2)
    if wh < 10 {
        return
    }
    wlibc.drop_shadow(wx, wy, ww, wh, tspec(i, TL_RADW),
        tspec(i, TL_SHADOW), 3, tspec(i, TL_TEXT))
    wlibc.rframe(wx, wy, ww, wh, tspec(i, TL_RADW), 1,
        tspec(i, TL_FRAME), tspec(i, TL_RAISED))
    // the title bar in the accent, with the label colour on it
    let th: u64 = TP_TITLE
    wlibc.rrect(wx + 1, wy + 1, ww - 2, th, tspec(i, TL_RADW),
        tspec(i, TL_ACCENT))
    wlibc.rect(wx + 1, wy + th - 2, ww - 2, TP_LINE + 1, tspec(i, TL_ACCENT))
    wlibc.rect(wx + 4, wy + 3, TP_MARK, TP_LINE, tspec(i, TL_ONACCENT))
    // one line of body text and a button, in the body colours
    wlibc.rect(wx + 4, wy + th + 4, ww - TP_BTN, TP_LINE, tspec(i, TL_TEXT))
    let byb: u64 = wy + wh - TP_TITLE - 3
    if byb > wy + th + 6 {
        wlibc.rframe(wx + 4, byb, TP_MARK + 2, TP_TITLE + 1, tspec(i, TL_RADB), 1,
            tspec(i, TL_FRAME), tspec(i, TL_BUTTON))
    }
    // ---- the name, on the tile's own surface in its own text colour
    let nm: u64 = tspec(i, TL_NAME)
    let asc: u64 = wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    let tw: u64 = sub(sub(px, x), 12)
    var col: u64 = tspec(i, TL_TEXT)
    if tspec(i, TL_LOW) != 0 {
        col = tspec(i, TL_DANGER)
    }
    // THE BASELINE IS CENTRED IN THE TILE and not four pixels down: a
    // 30-pixel tile with a 15-pixel line has 7 above and 8 below, and
    // putting the text at a fixed offset is how a label ends up half
    // outside the thing it belongs to when the shape changes.
    let base: u64 = y + sub(h, wlibc.text_h(wlibc.px_ui())) / 2 + asc
    let _p: u64 = put_text(wlibc.F_UI, wlibc.px_ui(), x + 8,
        base, tw, nm, tlen(nm), col, 0)
    say_painted(g(i, D_WIN), K_TILE, base, col,
        tspec(i, TL_SURFACE), nm, tlen(nm))
}

fn scrollarea(rows: u64, sicht: u64) -> u64 {
    let i: u64 = add(K_SCROLL, 0, scroll_w(), 0, false)
    s(i, D_A, rows)
    s(i, D_B, sicht)
    return i
}

// ------------------------------------------------------- der Zustand

fn value(i: u64) -> u64 {
    return g(i, D_VAL)
}

fn set_value(i: u64, v: u64) {
    if g(i, D_VAL) == v {
        return
    }
    s(i, D_VAL, v)
    dirty_wd(i)
}

fn text_of(i: u64) -> u64 {
    return g(i, D_TEXT)
}

fn set_text(i: u64, p: u64) {
    s(i, D_TEXT, p)
    if g(i, D_KIND) == K_LIST || g(i, D_KIND) == K_TABLE {
        count_rows(i)
        if g(i, D_VAL) >= g(i, D_A) {
            s(i, D_VAL, 0)
        }
        s(i, D_B, 0)
    }
    if g(i, D_KIND) == K_ENTRY {
        s(i, D_B, tlen(p))
        s(i, D_C, g(i, D_B))
    }
    dirty_wd(i)
}

fn set_rows(i: u64, n: u64) {
    s(i, D_A, n)
}

fn set_cols(i: u64, n: u64, breiten: u64) {
    s(i, D_C, n)
    s(i, D_D, breiten)
}

fn enable(i: u64, on: bool) {
    if on {
        s(i, D_FLAGS, g(i, D_FLAGS) & ~F_OFF)
    } else {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_OFF)
    }
    dirty_wd(i)
}

// RUNDE DESKTOP: EIN WIDGET AUS DER ANORDNUNG NEHMEN UND
// ZURUECKGEBEN. Das ist der Unterschied zwischen `enable` (steht da,
// laesst sich nicht bedienen) und dem, was ein REITER braucht: die
// Widgets des anderen Reiters sollen gar nicht da sein, und der Platz,
// den sie belegt haetten, soll dem sichtbaren zugutekommen.
//
// `relayout` ueberspringt verborgene Widgets seit Runde K15 -- die
// Zeile stand da und war unbenutzbar, weil es keinen Weg gab, F_HIDE
// von aussen zu setzen. Diese beiden Funktionen sind der Weg.
fn show(i: u64, on: bool) {
    if i >= nwd {
        return
    }
    if on {
        s(i, D_FLAGS, g(i, D_FLAGS) & ~F_HIDE)
    } else {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_HIDE)
    }
}

fn shown(i: u64) -> bool {
    if i >= nwd {
        return false
    }
    return (g(i, D_FLAGS) & F_HIDE) == 0
}

// Alles neu anordnen und neu malen. Nach jedem Reiterwechsel.
fn neu_setzen() {
    relayout()
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            dirty_all(w)
        }
        w = w + 1
    }
}

fn focus_id() -> u64 {
    if s_focus == 0 {
        return MAXWD
    }
    return s_focus - 1
}

fn set_focus(i: u64) {
    if s_focus != 0 {
        dirty_wd(s_focus - 1)
    }
    s_focus = i + 1
    dirty_wd(i)
}

fn fired_kind() -> u64 {
    return s_fkind
}

fn fired_index() -> u64 {
    return s_findex
}

fn fired_win() -> u64 {
    return s_fwin
}

// --------------------------------------------------- Zeilen und Spalten

// Wie viele Zeilen der Textblock hat. Eine Zeile ist alles bis zum
// naechsten Umbruch; der letzte Umbruch zaehlt nicht als leere Zeile
// dahinter.
fn count_rows(i: u64) {
    let p: u64 = g(i, D_TEXT)
    if p == 0 {
        s(i, D_A, 0)
        return
    }
    var n: u64 = 0
    var k: u64 = 0
    var zeichen: u64 = 0
    while (*((p + k) as *mut u8)) != 0 as u8 {
        if (*((p + k) as *mut u8)) == 10 as u8 {
            n = n + 1
            zeichen = 0
        } else {
            zeichen = zeichen + 1
        }
        k = k + 1
    }
    if zeichen > 0 {
        n = n + 1
    }
    s(i, D_A, n)
}

fn row_at(p: u64, r: u64) -> u64 {
    if p == 0 {
        return 0
    }
    var k: u64 = 0
    var n: u64 = 0
    while n < r {
        if (*((p + k) as *mut u8)) == 0 as u8 {
            return 0
        }
        if (*((p + k) as *mut u8)) == 10 as u8 {
            n = n + 1
        }
        k = k + 1
    }
    if (*((p + k) as *mut u8)) == 0 as u8 {
        return 0
    }
    return p + k
}

fn row_len(q: u64) -> u64 {
    var n: u64 = 0
    while (*((q + n) as *mut u8)) != 0 as u8 {
        if (*((q + n) as *mut u8)) == 10 as u8 {
            return n
        }
        n = n + 1
    }
    return n
}

// Spalte `c` einer Zeile: Zeiger und Laenge (Laenge oben in `col_len`).
fn col_at(q: u64, ende: u64, c: u64) -> u64 {
    var k: u64 = 0
    var n: u64 = 0
    while n < c {
        if k >= ende {
            return 0
        }
        if (*((q + k) as *mut u8)) == 9 as u8 {
            n = n + 1
        }
        k = k + 1
    }
    if k > ende {
        return 0
    }
    return q + k
}

fn col_len(q: u64, rest: u64) -> u64 {
    var n: u64 = 0
    while n < rest {
        if (*((q + n) as *mut u8)) == 9 as u8 {
            return n
        }
        n = n + 1
    }
    return rest
}

// ROUND LOOK. `PX_UI + 5` was 20 and is now the `row` token, which is
// 20 in `classic`. Every list, table, menu and drop-down in this
// library measures itself against this one function, which is why the
// row height only had to be moved once.
fn zeilen_hoehe() -> u64 {
    return wlibc.metric(wlibc.M_ROW)
}

// Two derived heights, so that the shape files carry ONE control height
// and not four. A checkbox and a menu bar are four pixels shorter than
// a button and a text field two -- that is what this library has always
// drawn (22 and 24 against 26), and the relationship is kept rather
// than four separate tokens that could drift apart.
fn ctrl_small() -> u64 {
    let h: u64 = wlibc.metric(wlibc.M_CTRL_H)
    if h < 8 {
        return h
    }
    return h - 4
}

fn ctrl_thin() -> u64 {
    let h: u64 = wlibc.metric(wlibc.M_CTRL_H)
    if h < 6 {
        return h
    }
    return h - 2
}

// The inset of TEXT inside a box that is not a button: half a button's
// padding. The old code said 5 in `paint_entry` and 6 in `paint_list`
// and meant the same thing both times.
fn inset() -> u64 {
    return wlibc.metric(wlibc.M_PAD_X) / 2
}

// AND ONE PIXEL LESS, INSIDE A TEXT FIELD.
//
// The old code said `x + 5` in `paint_entry` and `x + 6` in
// `paint_list` and `paint_choice`, and meant the same thing all three
// times. That one-pixel difference is a wart and not a decision -- but
// tools/k15/run.sh measures the caret and the text of a text field
// PIXEL BY PIXEL against a second rasterisation, so straightening it
// out would move ten characters by one pixel and turn a green section
// red for a tidy-up nobody asked for.
//
// So the wart is kept, named, and derived from the same token: classic
// gets its 5 and its 6 exactly as before, and modern gets 7 and 8.
// Whoever wants them equal can have it in a round that re-measures
// round K15's screenshots, which is where that cost belongs.
fn inset_text() -> u64 {
    let i: u64 = inset()
    if i == 0 {
        return 0
    }
    return i - 1
}

// Four more derivations, for the same reason as the two heights above:
// a shape file carries ONE control height and ONE row height, and the
// pieces that have always been a fixed distance from those keep that
// distance instead of becoming four more tokens that can drift.
//
//   scroll_w   14 in classic (M_ROW - 6). A scrollbar is a hair
//              narrower than a row is tall, which is what makes a list
//              read as a list and not as a table.
//   thumb_w    the thumb sits two pixels inside its track on each side.
//   tile_w     14 in classic (ctrl_small - 8): the coloured tile and
//              the checkbox square, which have always been the same
//              size because they are the same idea.
//   sep_h      5 in classic (M_PAD_Y + 1): one line, with the vertical
//              padding around it.
fn scroll_w() -> u64 {
    let r: u64 = wlibc.metric(wlibc.M_ROW)
    if r < 10 {
        return r
    }
    return r - 6
}

fn thumb_w() -> u64 {
    return sub(scroll_w(), 4)
}

fn tile_w() -> u64 {
    return sub(ctrl_small(), 8)
}

// The two buttons of a dialog are as wide as three of their own
// heights plus a gap -- 94 in classic, which is what was written there.
fn dlg_btn_w() -> u64 {
    return wlibc.metric(wlibc.M_CTRL_H) * 3 + wlibc.metric(wlibc.M_GAP) * 2
}

fn sep_h() -> u64 {
    return wlibc.metric(wlibc.M_PAD_Y) + 1
}

// ==================================================================
// DAS MALEN
//
// Alles laeuft ueber `wlibc.px` und damit ueber den Streifen. Kein
// Widget kennt den Fensterpuffer, kein Widget kennt einen
// Systemaufruf: es malt in Fensterkoordinaten, und die Bibliothek
// entscheidet, welcher Streifen gerade darunter liegt.

fn paint_bg(w: u64, x: u64, y: u64, bw: u64, bh: u64) {
    var c: u64 = wlibc.theme(wlibc.T_BG)
    if ng(w, N_KIND) == NK_DLG {
        c = wlibc.theme(wlibc.T_DLG)
    }
    if ng(w, N_KIND) == NK_MENU {
        c = wlibc.theme(wlibc.T_MENU)
    }
    // Die Blase nimmt die Menuefarbe: sie schwebt ueber allem, wie ein
    // Menue, und muss sich vom Fenster darunter abheben.
    if ng(w, N_KIND) == NK_TIP {
        c = wlibc.theme(wlibc.T_MENU)
    }
    wlibc.rect(x, y, bw, bh, c)
}

// Text, waagerecht ausgerichtet: 0 links, 1 mittig, 2 rechts.
fn put_text(f: u64, pxs: u64, x: u64, y: u64, bw: u64, p: u64, n: u64,
    farbe: u64, aus: u64) -> u64 {
    if p == 0 || n == 0 {
        s_tx = x
        return x
    }
    var tx: u64 = x
    if aus != 0 {
        let tw: u64 = wlibc.text_w(f, pxs, p, n)
        if aus == 1 {
            tx = x + sub(bw, tw) / 2
        } else {
            tx = x + sub(bw, tw)
        }
    }
    // WO DER TEXT WIRKLICH ANFAENGT. Bei `aus=1` ist das nicht `x`,
    // sondern die Mitte -- und genau diese Zahl braucht ein Pruefer, der
    // die Glyphen nachrastert. Sie hier zu merken ist der Unterschied
    // zwischen "der Laeufer rechnet die Zentrierung nach" (und prueft
    // dann seine eigene Rechnung) und "das Programm sagt, wo es gemalt
    // hat".
    s_tx = tx
    return wlibc.text_at(f, pxs, tx, y, p, n, farbe)
}

fn trace() -> bool {
    return s_trace != 0
}

// Den Titel des Menuefensters setzen. Ein Programm mit Katalog ruft
// das einmal beim Start mit `msg.get("wlib.menu.title")`; wer es nicht
// ruft, bekommt das englische Wort aus der Bibliothek.
fn set_menu_title(p: u64) {
    mn_titel = p
}

fn set_trace(on: bool) {
    if on {
        s_trace = 1
    } else {
        s_trace = 0
    }
}

// EINE GEMALTE ZEILE, mit allem, was ein Pruefer braucht: das Fenster
// (die Nummer, die der Fensterserver in `wm: win ... id=` fuehrt), die
// Art des Bedienelements, x und Grundlinie IM FENSTER, die beiden
// Farben und der Text.
fn say_painted(w: u64, kind: u64, base: u64, fg: u64, bg: u64, p: u64,
    n: u64) {
    if s_trace == 0 || p == 0 || n == 0 {
        return
    }
    // ONE WRITE AND NOT TWELVE.
    //
    // The first version of this called `ulib.say` and `ulib.sayn`
    // twelve times per line, and on a desktop that is five processes
    // sharing one serial port that came out interleaved: a checker
    // looking for a complete line found one in most runs and none in
    // some, which is the worst thing a measurement can be. The taskbar
    // has lived with it since round DESKTOP because it repaints often
    // enough that SOME line survives; a proof should not depend on
    // that.
    //
    // So the line is built in a buffer and handed to the kernel in a
    // single `write`, which is where the serialisation is. Same octets,
    // same order, one call.
    let b: u64 = (&tr_buf[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&tr_a[0 as usize]) as u64)
    at = tr_num(b, at, ng(w, N_H))
    at = tr_put(b, at, (&tr_k[0 as usize]) as u64)
    at = tr_num(b, at, kind)
    at = tr_put(b, at, (&tr_x[0 as usize]) as u64)
    at = tr_num(b, at, s_tx)
    at = tr_put(b, at, (&tr_b[0 as usize]) as u64)
    at = tr_num(b, at, base)
    at = tr_put(b, at, (&tr_f[0 as usize]) as u64)
    at = tr_num(b, at, fg)
    at = tr_put(b, at, (&tr_g[0 as usize]) as u64)
    at = tr_num(b, at, bg)
    at = tr_put(b, at, (&tr_w[0 as usize]) as u64)
    at = tr_num(b, at, wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, n))
    // Der Ursprung der MALFLAECHE auf dem Schirm: die aeussere Ecke des
    // Fensters plus Rand (BORDER = 2) und Titelleiste (TITLE_H = 22).
    // Dieselben zwei Zahlen wie in `say_tab` -- und wenn der
    // Fensterserver sie je aendert, sind BEIDE Stellen falsch, was
    // tools/softui/pruef.py sofort als "LEER" meldet.
    at = tr_put(b, at, (&tr_ax[0 as usize]) as u64)
    at = tr_num(b, at, ng(w, N_X) + 2)
    at = tr_put(b, at, (&tr_ay[0 as usize]) as u64)
    at = tr_num(b, at, ng(w, N_Y) + 22)
    at = tr_put(b, at, (&tr_t[0 as usize]) as u64)
    var i: u64 = 0
    while i < n && at + 2 < 320 {
        __mmio_write8((b + at) as *mut u8,
            __mmio_read8((p + i) as *mut u8))
        at = at + 1
        i = i + 1
    }
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(b, at)
}

// Text into the buffer, without the terminating zero. Returns where the
// next thing goes.
fn tr_put(b: u64, at: u64, p: u64) -> u64 {
    var i: u64 = 0
    var a: u64 = at
    while __mmio_read8((p + i) as *mut u8) != 0 as u8 && a + 2 < 320 {
        __mmio_write8((b + a) as *mut u8,
            __mmio_read8((p + i) as *mut u8))
        a = a + 1
        i = i + 1
    }
    return a
}

// A decimal number into the same buffer, most significant digit first.
fn tr_num(b: u64, at: u64, v: u64) -> u64 {
    var d: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var q: u64 = v
    if q == 0 {
        __mmio_write8(((&d[0 as usize]) as u64) as *mut u8, 48 as u8)
        n = 1
    }
    while q > 0 && n < 24 {
        __mmio_write8((((&d[0 as usize]) as u64) + n) as *mut u8,
            (48 + q % 10) as u8)
        q = q / 10
        n = n + 1
    }
    var a: u64 = at
    var i: u64 = n
    while i > 0 && a + 2 < 320 {
        i = i - 1
        __mmio_write8((b + a) as *mut u8,
            __mmio_read8((((&d[0 as usize]) as u64) + i) as *mut u8))
        a = a + 1
    }
    return a
}

// ROUND LOOK: the ring is as thick as the shape says and follows the
// same corner. It is the one thing `modern` makes LOUDER (2 pixels
// against 1), because it is the only thing on the list that somebody
// navigating by keyboard depends on.
fn focus_ring(i: u64) {
    if s_focus != i + 1 {
        return
    }
    // `rring` and not `rframe`: a focus ring goes ON TOP of a control
    // that is already painted, and `rframe` would fill it in.
    wlibc.rring(g(i, D_X), g(i, D_Y), g(i, D_W), g(i, D_H),
        wlibc.metric(wlibc.M_RADIUS_BUTTON),
        wlibc.metric(wlibc.M_FOCUS), wlibc.theme(wlibc.T_FOCUS))
}

fn paint_scroll(x: u64, y: u64, h: u64, oben: u64, sicht: u64,
    ganz: u64) {
    wlibc.rect(x, y, scroll_w(), h, wlibc.theme(wlibc.T_SCROLL))
    if ganz == 0 || sicht >= ganz {
        return
    }
    var th: u64 = h * sicht / ganz
    if th < 12 {
        th = 12
    }
    if th > h {
        th = h
    }
    var ty: u64 = 0
    if ganz > sicht {
        ty = (h - th) * oben / (ganz - sicht)
    }
    wlibc.rrect(x + 2, y + ty, thumb_w(), th,
        wlibc.metric(wlibc.M_RADIUS_INPUT) / 2, wlibc.theme(wlibc.T_THUMB))
}

fn paint_button(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    var flaeche: u64 = wlibc.theme(wlibc.T_BTN)
    if (g(i, D_FLAGS) & F_PRESSED) != 0 {
        flaeche = wlibc.theme(wlibc.T_BTNDN)
    } else if (g(i, D_FLAGS) & F_HOVER) != 0 {
        flaeche = wlibc.theme(wlibc.T_BTNHI)
    }
    // ROUND LOOK: a rounded face and a rounded outline. With
    // `radius_button=0` (classic) `rrect` IS `rect` and `rframe` IS
    // `frame3`'s square outline -- the same pixels, by the same route.
    let rb: u64 = wlibc.metric(wlibc.M_RADIUS_BUTTON)
    if rb == 0 {
        wlibc.rect(x, y, bw, bh, flaeche)
        wlibc.frame3(x, y, bw, bh, wlibc.theme(wlibc.T_BTNHI),
            wlibc.theme(wlibc.T_LINE), (g(i, D_FLAGS) & F_PRESSED) != 0)
    } else {
        // ============================== RUNDE ECHTHARDWARE-1
        // DREI SUBTRAKTIONEN, DIE UNTER NULL LAUFEN KONNTEN -- UND
        // GENAU DARAN IST JUSTINS STARTMENUE GESTORBEN.
        //
        // Auf seinem Foto vom 09.09. laesst sich im Startmenue nichts
        // anklicken und nichts tippen. Der Grund steht auf der
        // seriellen Leitung des Nachbaus:
        //
        //   panic: integer overflow in 'u64 - u64'
        //          at kernel/user/wlib.fi:2878
        //
        // Das ist DIESE Zeile. `bw - 2 * bo` und `bh - 2 * bo` laufen
        // unter null, sobald ein Knopf schmaler oder niedriger als
        // zwei Randbreiten ist, und `rb - bo`, sobald der Radius
        // kleiner als der Rand ist. In `u64` ist das kein negativer
        // Wert, sondern eine Zahl in der Naehe von 2^64 -- der Kern
        // faengt es ab und erschlaegt den Prozess.
        //
        // WARUM ES ERST JETZT AUFFIEL: dieser Zweig laeuft nur bei
        // `radius_button != 0`, also nur unter `shape=osum`. Bis zu
        // dieser Runde lieferte der Stick gar keine Formdatei mit und
        // stand deshalb immer auf `classic` (Radius 0) -- der Fehler
        // lag seit Runde LOOK im Baum und konnte nie zuschlagen.
        // Seit das Abbild `shape=osum` mitbringt, schlaegt er bei
        // JEDEM Knopf zu, der klein ist.
        //
        // Der Prozess, der hier stirbt, ist der STARTER: kein Fenster
        // mehr, das Klicks annimmt, keine Eingabe, kein Start. Genau
        // Justins Befund -- und er sah aus wie ein Ereignisproblem,
        // war aber eine Subtraktion.
        wlibc.rrect(x, y, bw, bh, rb, wlibc.theme(wlibc.T_LINE))
        var bo: u64 = wlibc.metric(wlibc.M_BORDER)
        if 2 * bo >= bw || 2 * bo >= bh {
            bo = 0
        }
        var ri: u64 = 0
        if rb > bo {
            ri = rb - bo
        }
        wlibc.rrect(x + bo, y + bo, bw - 2 * bo, bh - 2 * bo,
            ri, flaeche)
    }
    var farbe: u64 = wlibc.theme(wlibc.T_FG)
    if (g(i, D_FLAGS) & F_OFF) != 0 {
        farbe = wlibc.theme(wlibc.T_DIM)
    }
    let grund: u64 = y + (bh + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
    put_text(wlibc.F_UI, wlibc.px_ui(), x, grund, bw, g(i, D_TEXT),
        tlen(g(i, D_TEXT)), farbe, 1)
    say_painted(g(i, D_WIN), K_BUTTON, grund, farbe, flaeche,
        g(i, D_TEXT), tlen(g(i, D_TEXT)))
    focus_ring(i)
}

// RUNDE MERGE-2: EIN ETIKETT, DAS NICHT IN SEINEN KASTEN PASST, WIRD
// GEKUERZT -- und das Gekuerzte wird gemeldet.
//
// `put_text` benutzt seine Breite nur zum Ausrichten, es schneidet
// nicht ab; ein zu langes Etikett malt bis dahin, wo es aufhoert, und
// das ist die Spalte daneben. Gefunden mit dem berichtigten
// tools/themestore/shotcheck.py auf der Seite Vorlagen: die Zeile
// "Abendrot: schlechtestes Textpaar 5.34:1" ist 302 Bildpunkte breit,
// die linke Spalte gibt 268 her, und ihre letzten zwei Punkte lagen auf
// dem Namen der Kachel daneben. Solange der Pruefer keine einzige Zeile
// erkannte (das alte Muster passte nach Runde SOFTUI nicht mehr), war
// diese Ueberlappung unsichtbar.
//
// Dieselbe Regel wie bei den Listenzeilen der Runde THEMESTORE ("eine
// Zeile, die nicht passt, wird gekuerzt"), an derselben Stelle
// gemeldet: `say_painted` bekommt den Text, der WIRKLICH gemalt wurde,
// nicht den, der gewuenscht war.
fn paint_label(i: u64) {
    let grund: u64 = g(i, D_Y) + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    var q: u64 = g(i, D_TEXT)
    var qn: u64 = tlen(q)
    let el: u64 = elide(wlibc.F_UI, wlibc.px_ui(), q, qn, g(i, D_W))
    if el != 0 {
        q = (&el_buf[0 as usize]) as u64
        qn = el
    }
    put_text(wlibc.F_UI, wlibc.px_ui(), g(i, D_X), grund, g(i, D_W),
        q, qn, wlibc.theme(wlibc.T_FG), 0)
    say_painted(g(i, D_WIN), K_LABEL, grund, wlibc.theme(wlibc.T_FG),
        bg_of(g(i, D_WIN)), q, qn)
}

// Die Flaeche, auf der ein Etikett liegt. `paint_bg` entscheidet das
// schon; hier steht dieselbe Entscheidung als Frage, damit die gemeldete
// Hintergrundfarbe die ist, die wirklich unter dem Text liegt.
fn bg_of(w: u64) -> u64 {
    if ng(w, N_KIND) == NK_DLG {
        return wlibc.theme(wlibc.T_DLG)
    }
    if ng(w, N_KIND) == NK_MENU || ng(w, N_KIND) == NK_TIP {
        return wlibc.theme(wlibc.T_MENU)
    }
    return wlibc.theme(wlibc.T_BG)
}

// RUNDE TON-2: WO DIE RINNE ANFAENGT UND WIE BREIT SIE IST.
//
// Zwei Stellen brauchen dieselbe Rechnung -- das Malen und das
// Treffen. Stuende sie zweimal da, waere der Regler eines Tages an
// einer anderen Stelle zu fassen, als er gezeichnet ist; das ist der
// Fehler, den man erst auf einem Bildschirmfoto sieht.
fn slider_bahn(i: u64) -> u64 {
    let txt: u64 = g(i, D_TEXT)
    var lx: u64 = g(i, D_X)
    if txt != 0 && tlen(txt) > 0 {
        lx = lx + wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), txt,
            tlen(txt)) + 8
    }
    return lx
}

fn slider_rw(i: u64) -> u64 {
    let x: u64 = g(i, D_X)
    let bw: u64 = g(i, D_W)
    let lx: u64 = slider_bahn(i)
    let zw: u64 = 34
    if bw > (lx -% x) + zw + 8 {
        return bw -% (lx -% x) -% zw -% 8
    }
    return 0
}

// Aus einer Zeigerstelle einen Wert. Der Griff ist zehn Bildpunkte
// breit, also ist die BAHN um zehn kuerzer als die Rinne -- gerechnet
// wird auf die Mitte des Griffs, sonst laesst sich die 100 nicht
// erreichen.

// RUNDE TON-2: DER SCHIEBEREGLER.
//
// Beschriftung links, dann die Rinne, rechts der Wert in Prozent.
// JEDE Farbe kommt aus dem Thema: die Rinne aus T_SCROLL (dieselbe,
// aus der die Rollleiste ihre nimmt -- es ist dieselbe Sache: eine
// Bahn, in der etwas laeuft), der gefuellte Teil aus T_ACCENT, der
// Griff aus T_THUMB. Ein fester Farbwert an dieser Stelle wuerde von
// tools/design/messen.py gezaehlt, und zwar zu Recht: er ueberlebte
// keinen Themenwechsel.
fn paint_slider(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    let txt: u64 = g(i, D_TEXT)
    if txt != 0 && tlen(txt) > 0 {
        let grund: u64 = y + (bh
            + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
        put_text(wlibc.F_UI, wlibc.px_ui(), x, grund, bw, txt,
            tlen(txt), wlibc.theme(wlibc.T_FG), 0)
    }
    // RECHTS BLEIBT PLATZ FUER DIE ZAHL. Ein Regler ohne abgelesenen
    // Wert ist eine Schaetzung; "wie laut ist es gerade" muss man
    // ablesen koennen und nicht abmessen.
    //
    // DIE BAHN KOMMT AUS DERSELBEN RECHNUNG WIE DAS TREFFEN
    // (`slider_bahn`/`slider_rw`) -- zwei Rechnungen fuer dieselbe
    // Rinne gingen irgendwann auseinander.
    let zw: u64 = 34
    let lx: u64 = slider_bahn(i)
    let rw: u64 = slider_rw(i)
    if rw < 8 {
        return
    }
    let rh: u64 = 4
    let ry: u64 = y + sub(bh, rh) / 2
    wlibc.rect(lx, ry, rw, rh, wlibc.theme(wlibc.T_SCROLL))
    wlibc.frame(lx, ry, rw, rh, wlibc.theme(wlibc.T_LINE))
    var v: u64 = g(i, D_VAL)
    if v > 100 {
        v = 100
    }
    // DER GRIFF SITZT AUF DER MITTE DES WERTES, nicht an seinem Anfang:
    // sonst steht er bei 100 % mit seiner halben Breite ueber dem Ende
    // der Rinne.
    let gw: u64 = 10
    let bahn: u64 = sub(rw, gw)
    let gx: u64 = lx + bahn * v / 100
    if v > 0 {
        wlibc.rect(lx, ry, gx -% lx + gw / 2, rh,
            wlibc.theme(wlibc.T_ACCENT))
    }
    let gh: u64 = 14
    let gy: u64 = y + sub(bh, gh) / 2
    wlibc.rect(gx, gy, gw, gh, wlibc.theme(wlibc.T_THUMB))
    wlibc.frame(gx, gy, gw, gh, wlibc.theme(wlibc.T_LINE))
    // DER WERT ALS ZAHL, rechtsbuendig an der Widgetkante.
    var zahl: [u8; 8] = [0 as u8; 8]
    let n: u64 = ulib.digits(v, (&zahl[0 as usize]) as u64)
    zahl[n as usize] = 37 as u8
    zahl[(n + 1) as usize] = 0 as u8
    let zx: u64 = x + bw -% zw
    let zgrund: u64 = y + (bh
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
    put_text(wlibc.F_UI, wlibc.px_ui(), zx, zgrund, zw,
        (&zahl[0 as usize]) as u64, n + 1, wlibc.theme(wlibc.T_DIM), 0)
    focus_ring(i)
}

fn paint_check(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let k: u64 = tile_w()
    let oy: u64 = y + sub(g(i, D_H), k) / 2
    wlibc.rect(x, oy, k, k, wlibc.theme(wlibc.T_ENTRY))
    wlibc.frame(x, oy, k, k, wlibc.theme(wlibc.T_LINE))
    if g(i, D_VAL) != 0 {
        // Ein Haken aus zwei Strichen, und nicht ein gefuelltes
        // Kaestchen: ein Bildschirmfoto kann einen Haken von einer
        // Auswahlfarbe unterscheiden, eine Fuellung nicht.
        var n: u64 = 0
        while n < 4 {
            wlibc.px(x + 3 + n, oy + 6 + n, wlibc.theme(wlibc.T_ACCENT))
            wlibc.px(x + 3 + n, oy + 7 + n, wlibc.theme(wlibc.T_ACCENT))
            n = n + 1
        }
        n = 0
        while n < 6 {
            wlibc.px(x + 7 + n, oy + 9 - n, wlibc.theme(wlibc.T_ACCENT))
            wlibc.px(x + 7 + n, oy + 10 - n, wlibc.theme(wlibc.T_ACCENT))
            n = n + 1
        }
    }
    let grund: u64 = y + (g(i, D_H)
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
    put_text(wlibc.F_UI, wlibc.px_ui(), x + k + 6, grund, g(i, D_W),
        g(i, D_TEXT), tlen(g(i, D_TEXT)), wlibc.theme(wlibc.T_FG), 0)
    focus_ring(i)
}

// DAS TEXTFELD, und hier steckt die meiste Arbeit dieser Datei.
//
// Es zeigt eine Zeile, es hat eine EINFUEGEMARKE (`D_B`) und einen
// AUSWAHLANKER (`D_C`). Sind beide gleich, ist nichts ausgewaehlt.
// Sonst liegt die Auswahl zwischen ihnen, und sie wird mit der
// Auswahlfarbe hinterlegt und in der Auswahlvordergrundfarbe gesetzt --
// zwei Textlaeufe statt einem, damit die Farbe wirklich wechselt und
// nicht nur der Hintergrund.
// WHERE CHARACTER `at` OF A TEXT FIELD BEGINS. It has to agree with
// `paint_entry` to the pixel -- the caret is drawn from here and the
// selection is measured from here -- so it asks the same function.
fn entry_x(i: u64, at: u64) -> u64 {
    return g(i, D_X) + inset_text() + wlibc.text_w(wlibc.F_UI,
        wlibc.px_ui(), g(i, D_TEXT), at)
}

fn paint_entry(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    // ROUND LOOK: box and outline from the shape tokens. At radius 0
    // and border 1 this is the `rect` + `frame` it always was.
    wlibc.rframe(x, y, bw, bh, wlibc.metric(wlibc.M_RADIUS_INPUT),
        wlibc.metric(wlibc.M_BORDER), wlibc.theme(wlibc.T_LINE),
        wlibc.theme(wlibc.T_ENTRY))
    let p: u64 = g(i, D_TEXT)
    let n: u64 = tlen(p)
    let grund: u64 = y + (bh + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
    var a: u64 = g(i, D_B)
    var b: u64 = g(i, D_C)
    if a > b {
        let t: u64 = a
        a = b
        b = t
    }
    if b > n {
        b = n
    }
    if a > n {
        a = n
    }
    if b > a {
        let x0: u64 = entry_x(i, a)
        let x1: u64 = entry_x(i, b)
        wlibc.rect(x0, y + 3, sub(x1, x0), sub(bh, 6),
            wlibc.theme(wlibc.T_SEL))
    }
    // vor der Auswahl, die Auswahl, danach -- drei Laeufe, damit die
    // ausgewaehlten Zeichen ihre eigene Farbe bekommen.
    var cx: u64 = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), x + inset_text(),
        grund, p, a, wlibc.theme(wlibc.T_FG))
    if b > a {
        cx = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), entry_x(i, a), grund,
            p + a, b - a, wlibc.theme_selfg())
    }
    if n > b {
        wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), entry_x(i, b), grund, p + b,
            n - b, wlibc.theme(wlibc.T_FG))
    }
    // Die Einfuegemarke -- nur, wenn das Feld den Fokus hat. Ein Feld,
    // das immer eine Marke zeigt, sagt nicht mehr, wohin getippt wird.
    if s_focus == i + 1 {
        let mx: u64 = entry_x(i, g(i, D_B))
        // The caret is as wide as a border and never thinner than
        // one pixel -- it is a line, and lines are the one thing this
        // round deliberately leaves alone.
        wlibc.rect(mx, y + 3, wlibc.metric(wlibc.M_BORDER) + 1,
            sub(bh, 6), wlibc.theme(wlibc.T_ACCENT))
    }
    focus_ring(i)
}

// EIN SYMBOL JE ZEILE. `p` zeigt auf ein Feld aus WOERTERN, eines je
// Zeile, und jedes ist entweder
//
//   * ein ZEIGER auf ein Bild im Format OSYM (`tools/k15/icon.py`:
//     vier Oktette "OSYM", Breite, Hoehe, dann Breite mal Hoehe
//     Bildpunkte zu vier Oktetten) -- so liegt es in jedem Buendel unter
//     `/apps/<name>.osp/symbol`, oder
//   * eine FARBE, wenn kein Bild da ist. Dann wird ein Plaettchen in
//     dieser Farbe gemalt und der erste Buchstabe des Namens darauf.
//
// Unterschieden werden die beiden am Kopf: was mit "OSYM" anfaengt, ist
// ein Bild. Ein Zeiger in Ring 3 liegt bei 0x40100000 und eine Farbe
// unter 0x01000000, also waere auch das eine Unterscheidung -- aber eine,
// die von der Speicherkarte abhaengt statt vom Inhalt, und die faellt
// still um, wenn sich die Karte aendert.
//
// WARUM UEBERHAUPT EIN BILD. Der erste Nachtrag hatte nur die Farbe, und
// das war ehrlich, solange dieses System keine Bilddatei lesen konnte.
// Der zweite Nachtrag verlangt ein Buendel, in dem ALLES steckt, was zu
// einem Programm gehoert -- ein Symbol, das in Wahrheit sechs Hexziffern
// in einer Textdatei ist, gehoert nicht dazu. Das Format ist so klein,
// dass der Leser dieser Datei zwanzig Zeilen hat, und es ist trotzdem
// eine Datei mit Bildpunkten darin, die man Punkt fuer Punkt gegen den
// Schirm rechnen kann.
fn list_icons(i: u64, p: u64) {
    s(i, D_D, p)
    dirty_wd(i)
}

// ROUND ICONS: THE THIRD KIND OF ROW SYMBOL, and a list or a table can
// carry it next to the two that already exist.
//
// A word in the array passed here is either 0 (this row has none) or an
// icon out of `lib/icons.fi` with ICON_TAG set.  The tag is bit 63, and
// it is a tag and not a range check for the same reason `ist_bild`
// looks at "OSYM" and not at an address: a rule that depends on where
// something happens to lie in memory falls over silently the day the
// memory map moves.  Bit 63 is set by no pointer this process can hold
// (Ring 3 lives at 0x40100000) and by no colour (colours are 24 bit).
//
// WHY NOT REUSE `list_icons`.  That array means "a picture or a
// colour", it is only read by lists, and it puts a 14 by 14 tile with a
// letter on it where there is no picture.  An icon is neither: it has
// no tile, no letter and no colour of its own -- it takes the colour of
// the row it stands in, which is exactly what makes it work in a light
// and a dark theme without a second set of drawings.
const ICON_TAG: u64 = 9223372036854775808 // 1 << 63

fn icon_id(c: u64) -> u64 {
    return ICON_TAG | c
}

fn row_icons(i: u64, p: u64) {
    s(i, D_ICONS, p)
    dirty_wd(i)
}

// The icon of visible row `z`, or 0.  One place where the array is
// read, so a list and a table cannot disagree about what is in it.
fn icon_at_row(i: u64, z: u64) -> u64 {
    let p: u64 = g(i, D_ICONS)
    if p == 0 {
        return 0
    }
    let w: u64 = __mmio_read64((p + z * 8) as *mut u64)
    if (w & ICON_TAG) == 0 {
        return 0
    }
    return w & 65535
}

// "OSYM" -- vier Oktette, gelesen als eine Zahl waere es von der
// Ausrichtung abhaengig, also Oktett fuer Oktett.
//
// ZUERST DER BEREICH, DANN DIE KENNUNG, und das ist kein Uebereifer: die
// erste Fassung fragte nur `p < 4096` und las danach vier Oktette. Eine
// FARBE wie 0x707880 ist groesser als 4096 -- der Starter setzte genau
// die fuer seine Dateitreffer, und der Prozess starb mit
// `user fault: cr2=0x707880`. Ein Wort ist nur dann ein Zeiger, wenn es
// in den privaten Bereich dieses Prozesses zeigt (`proc.IMAGE_BASE` bis
// zum Ende der privaten Seiten); alles andere ist eine Farbe.
const U_LO: u64 = 0x40100000
const U_HI: u64 = 0x40200000

fn ist_bild(p: u64) -> bool {
    if p < U_LO || p >= U_HI {
        return false
    }
    if __mmio_read8((p) as *mut u8) != 79 as u8 {
        return false
    }
    if __mmio_read8((p + 1) as *mut u8) != 83 as u8 {
        return false
    }
    if __mmio_read8((p + 2) as *mut u8) != 89 as u8 {
        return false
    }
    return __mmio_read8((p + 3) as *mut u8) == 77 as u8
}

fn bild_w(p: u64) -> u64 {
    return __mmio_read32((p + 4) as *mut u32) as u64
}

fn bild_h(p: u64) -> u64 {
    return __mmio_read32((p + 8) as *mut u32) as u64
}

// Das Bild in ein Feld von `kw` mal `kh`. Groesser wird nicht skaliert,
// sondern beschnitten -- ein Symbol, das nicht passt, ist ein Fehler im
// Buendel und soll auffallen, nicht weichgezeichnet werden.
fn bild_malen(p: u64, x: u64, y: u64, kw: u64, kh: u64) {
    let w: u64 = bild_w(p)
    let h: u64 = bild_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return
    }
    var r: u64 = 0
    while r < h && r < kh {
        var c: u64 = 0
        while c < w && c < kw {
            let f: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            // DECKUNG NULL HEISST DURCHSICHTIG, und dann bleibt stehen,
            // was schon da ist -- die Auswahlfarbe der Zeile zum
            // Beispiel. Ohne das haette jedes Symbol einen schwarzen
            // Kasten um sich, und ein Pruefer, der die Zeilenfarbe misst,
            // faende sie an den Ecken nicht.
            if (f >> 24) != 0 {
                wlibc.px(x + c, y + r, f & wlibc.RGB24)
            }
            c = c + 1
        }
        r = r + 1
    }
}

// ROUND ICONS: HOW FAR THE FIRST COLUMN OF A TABLE MOVES RIGHT.
//
// WIDGET-WIDE AND NOT PER ROW, and both reasons matter.  Visually: a
// column whose names start at two different x depending on whether that
// row happens to have an icon is a ragged column.  And for the
// measurement: `cell_x` reports where a cell BEGINS, the file manager
// tells the test runner that number, and the runner then looks for ink
// there.  A per-row indent could not be reported by a per-widget
// function, so the two would disagree -- which is exactly the bug this
// function exists to make impossible.  `paint_table` and `cell_x` both
// go through here.
fn table_ein(i: u64) -> u64 {
    if g(i, D_KIND) == K_TABLE && g(i, D_ICONS) != 0 {
        // RUNDE ECHTHARDWARE-2: der Abstand skaliert mit, wie im
        // Listenzweig darunter -- 4 feste Punkte sind neben einem
        // doppelt so grossen Symbol kein Abstand mehr.
        return wlibc.icon_small() + 4 * wlibc.ui_scale()
    }
    return 0
}

// ============================================== RUNDE ECHTHARDWARE-2
// DER EINZUG WAECHST MIT DEM SYMBOL.
//
// Hier stand zweimal die feste 22: 16 Punkte Symbol und 6 Abstand,
// gemessen bei einfacher Vervielfachung. Seit `wlibc.icon_draw` das
// Bild vergroessert, ist das Symbol bei doppelter Vervielfachung 32
// Punkte breit -- und lief damit UNTER den Text, der weiterhin bei 22
// anfing. Auf Justins Foto ist das die Zeile, in der Ordnersymbol und
// Name aneinanderkleben, im Startmenue wie im Dateimanager.
//
// `table_ein` daneben hat es immer richtig gemacht (`icon_small() +
// 4`); die Liste zieht jetzt gleich. Der Abstand ist Justins Vorgabe:
// acht Punkte mal Vervielfachung zwischen Bild und Wort.
fn list_ein(i: u64) -> u64 {
    if g(i, D_KIND) == K_LIST
        && (g(i, D_D) != 0 || g(i, D_ICONS) != 0) {
        return wlibc.icon_small() + 6 * wlibc.ui_scale()
    }
    return 0
}

// RUNDE THEMESTORE: EINE ZEILE, DIE NICHT PASST, WIRD GEKUERZT --
// und die gekuerzte wird gemeldet.
//
// Der Starter setzt Zeilen wie "Suchen -- Programme und Dateien finden
// und starten": 412 Bildpunkte breit in einer Liste, die 416 breit ist
// und davon 15 an den Rollbalken und 22 an das Symbol verliert. Gemalt
// wurde bisher trotzdem die ganze Zeile; der Rest lief unter dem
// Rollbalken durch bis an den Fensterrand. Im Bild sah man ein Wort,
// das an der Kante aufhoert, und in `wlib: text ... tw=` stand die
// Breite, die der Text GERN gehabt haette. Ein Pruefer, der beides
// vergleicht, bekommt "abgeschnitten" -- zu Recht.
//
// Also: so viele GANZE Zeichen wie hineingehen, dann drei Punkte. Die
// Grenze wird an UTF-8 gehalten (Folgeoktette 0x80..0xBF gehoeren zum
// Zeichen davor) -- ein halb abgeschnittener Umlaut waere genau der
// Fehler, den die Runde davor gejagt hat.
static mut el_buf: [u8; 192] = [0 as u8; 192]

fn fit_n(f: u64, pxs: u64, p: u64, n: u64, limit: u64) -> u64 {
    var k: u64 = n
    while k > 0 {
        // nicht mitten in ein Zeichen hinein
        while k > 0
            && (__mmio_read8((p + k) as *mut u8) & 192 as u8) == 128 as u8 {
            k = k - 1
        }
        if wlibc.text_w(f, pxs, p, k) <= limit {
            return k
        }
        if k == 0 {
            return 0
        }
        k = k - 1
    }
    return 0
}

// Gibt die Laenge im Puffer zurueck; `el_buf` traegt danach den Text,
// der wirklich gemalt werden soll. Passt alles, wird nichts kopiert
// und `p` bleibt der Text -- dafuer sagt die Funktion, ob sie gekuerzt
// hat.
fn elide(f: u64, pxs: u64, p: u64, n: u64, limit: u64) -> u64 {
    if n == 0 || wlibc.text_w(f, pxs, p, n) <= limit {
        return 0
    }
    var dots: [u8; 4] = "...\0"
    let dw: u64 = wlibc.text_w(f, pxs, (&dots[0 as usize]) as u64, 3)
    let k: u64 = fit_n(f, pxs, p, n, sub(limit, dw))
    var a: u64 = 0
    while a < k && a < 188 {
        __mmio_write8(((&el_buf[0 as usize]) as u64 + a) as *mut u8,
            __mmio_read8((p + a) as *mut u8))
        a = a + 1
    }
    var d: u64 = 0
    while d < 3 {
        __mmio_write8(((&el_buf[0 as usize]) as u64 + a) as *mut u8,
            46 as u8)
        a = a + 1
        d = d + 1
    }
    __mmio_write8(((&el_buf[0 as usize]) as u64 + a) as *mut u8, 0 as u8)
    return a
}

fn paint_list(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    let zh: u64 = zeilen_hoehe()
    let sicht: u64 = sub(bh, 4) / zh
    wlibc.rframe(x, y, bw, bh, wlibc.metric(wlibc.M_RADIUS_INPUT),
        wlibc.metric(wlibc.M_BORDER), wlibc.theme(wlibc.T_LINE),
        wlibc.theme(wlibc.T_ENTRY))
    let ganz: u64 = g(i, D_A)
    var r: u64 = 0
    while r < sicht {
        let z: u64 = g(i, D_B) + r
        if z < ganz {
            let q: u64 = row_at(g(i, D_TEXT), z)
            let ln: u64 = row_len(q)
            let ry: u64 = y + 2 + r * zh
            var farbe: u64 = wlibc.theme(wlibc.T_FG)
            if z == g(i, D_VAL) {
                wlibc.rect(x + 1, ry, sub(bw, 16), zh,
                    wlibc.theme(wlibc.T_SEL))
                farbe = wlibc.theme_selfg()
            }
            // ROUND ICONS: an icon takes precedence over the tile.
            // A row that has both was a mistake in the caller, and
            // drawing the icon is the answer that loses no information.
            let sym: u64 = icon_at_row(i, z)
            if sym != 0 {
                // RUNDE ECHTHARDWARE-2: MITTIG IN DER ZEILE. `ry + 2`
                // war ein fester Abstand von oben und setzte das
                // Symbol bei doppelter Vervielfachung sichtbar ueber
                // die Schriftlinie -- Justins "Symbol sitzt tiefer /
                // nicht auf gleicher Hoehe wie der Text". Dieselbe
                // Rechnung wie in `icon_y`, damit Bericht und Bild
                // dieselbe Zahl nennen.
                let ih: u64 = wlibc.icon_small()
                var oy: u64 = 2
                if zh > ih {
                    oy = (zh - ih) / 2
                }
                let _ = wlibc.icon_at(sym, icon_x(i), ry + oy,
                    ih, farbe)
            }
            let ein: u64 = list_ein(i)
            if ein != 0 && sym == 0 {
                let f: u64 = __mmio_read64((g(i, D_D) + z * 8) as *mut u64)
                if ist_bild(f) {
                    // KEIN RAHMEN UEBER EIN BILD. Der erste Entwurf malte
                    // erst das Symbol und dann denselben Rahmen wie um
                    // ein Farbplaettchen -- und ueberschrieb damit die
                    // untere und die rechte Kante des Bildes. Der
                    // Pruefer sah 25 von 169 deckenden Bildpunkten
                    // falsch; im Bild sah man nichts. Ein Symbol bringt
                    // seinen Rand selbst mit oder hat keinen.
                    bild_malen(f, x + 5, ry + 3, tile_w(), tile_w())
                } else {
                wlibc.rrect(x + 5, ry + 3, tile_w(), tile_w(),
                    wlibc.metric(wlibc.M_RADIUS_INPUT) / 2, f)
                wlibc.rframe(x + 5, ry + 3, tile_w(), tile_w(),
                    wlibc.metric(wlibc.M_RADIUS_INPUT) / 2,
                    wlibc.metric(wlibc.M_BORDER),
                    wlibc.theme(wlibc.T_LINE), f)
                if ln > 0 {
                    // MITTIG AUF DAS PLAETTCHEN, und das ist keine
                    // Feinheit: die erste Fassung setzte den Buchstaben
                    // auf eine feste Stelle, und bei einem breiten
                    // ragte er ueber den Rand -- im Bild sah man einen
                    // Buchstaben, im Pruefer 49 von 67 Tintenpunkten
                    // falsch, weil dort nicht mehr die Farbe des
                    // Plaettchens hinter ihm stand.
                    let bw2: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(),
                        q, 1)
                    // WEISS WAR FALSCH, UND ZWAR MESSBAR: die Farbe
                    // des Plaettchens kommt aus der Anwendung, und auf
                    // einem hellen Plaettchen ist ein weisser
                    // Buchstabe nicht zu lesen. `theme_on` rechnet den
                    // Kontrast beider Kandidaten aus und nimmt den
                    // besseren -- dieselbe Rechnung, mit der die
                    // Akzentfarbe ihre Schriftfarbe bekommt.
                    wlibc.text_at(wlibc.F_UI, wlibc.px_ui(),
                        x + 5 + sub(14, bw2) / 2, ry + 3 + 12, q, 1,
                        wlibc.theme_on(f))
                }
                }
            }
            // ROUND LOOK, THIRD ADDENDUM: A LIST ROW SAYS WHERE IT
            // DREW. Until here it did not, and that is exactly why
            // "Text schreiben und aendern" could sit in the starter for
            // half a year: the launcher's rows carry the bundle labels,
            // the bundle labels never go through the catalogue, and a
            // widget that reports nothing cannot be photographed. The
            // draw goes through `put_text` for one reason -- it is what
            // sets `s_tx`, so the reported x is the one the text
            // really started at and not a second guess at it.
            let rgrund: u64 = ry + wlibc.ascent_of(wlibc.F_UI,
                wlibc.px_ui()) + 1
            // Was zwischen dem Textanfang und dem Rollbalken frei ist:
            // die Breite, ab der gekuerzt werden muss.
            let frei: u64 = sub(bw, 21 + 6 + ein)
            var qq: u64 = q
            var qn: u64 = ln
            let el: u64 = elide(wlibc.F_UI, wlibc.px_ui(), q, ln, frei)
            if el != 0 {
                qq = (&el_buf[0 as usize]) as u64
                qn = el
            }
            let _rt: u64 = put_text(wlibc.F_UI, wlibc.px_ui(),
                x + 6 + ein, rgrund, sub(bw, 16), qq, qn, farbe, 0)
            var rhg: u64 = wlibc.theme(wlibc.T_ENTRY)
            if z == g(i, D_VAL) {
                rhg = wlibc.theme(wlibc.T_SEL)
            }
            // GEMELDET WIRD, WAS GEMALT WURDE -- nicht, was gewuenscht
            // war. Sonst misst ein Pruefer die eine Zeile gegen die
            // Breite der anderen.
            say_painted(g(i, D_WIN), K_LIST, rgrund, farbe, rhg, qq, qn)
        }
        r = r + 1
    }
    paint_scroll(x + bw - 15, y + 1, sub(bh, 2), g(i, D_B), sicht, ganz)
    focus_ring(i)
}

fn spalte_breit(i: u64, c: u64) -> u64 {
    let p: u64 = g(i, D_D)
    if p == 0 {
        return 100
    }
    return __mmio_read64((p + c * 8) as *mut u64)
}

fn paint_table(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    let zh: u64 = zeilen_hoehe()
    let kopf: u64 = zh + 4
    let sicht: u64 = sub(sub(bh, 4), kopf) / zh
    let cols: u64 = g(i, D_C)
    wlibc.rect(x, y, bw, bh, wlibc.theme(wlibc.T_ENTRY))
    // DIE KOPFZEILE. Sie ist Zeile 0 des Textblocks -- so steht die
    // Beschriftung in derselben Quelle wie die Daten, und eine Spalte,
    // die dazukommt, kann nicht vergessen werden.
    wlibc.rect(x + 1, y + 1, sub(bw, 2), kopf, wlibc.theme(wlibc.T_HEAD))
    let kq: u64 = row_at(g(i, D_TEXT), 0)
    let kl: u64 = row_len(kq)
    var cx: u64 = x + 6
    var c: u64 = 0
    while c < cols {
        let q: u64 = col_at(kq, kl, c)
        if q != 0 {
            let ln: u64 = col_len(q, sub(kl, sub(q, kq)))
            // ROUND ICONS: the heading of the first column moves right
            // with its data.  Only the TEXT -- `cx` keeps carrying the
            // column geometry, because the separator lines below use it
            // and they must stay where the columns are.
            var hx: u64 = cx
            if c == 0 {
                hx = cx + table_ein(i)
            }
            // Dieselbe Meldung fuer die Kopfzeile. Sie traegt
            // "Name / Groesse / Zeit / Rechte" -- und "Groesse" ist die
            // einzige Zeichenkette der Oberflaeche, in der ein `oe` und
            // ein `ss` NEBENEINANDER stehen. Ohne diese Zeile ist sie
            // nicht nachmessbar.
            let kgrund: u64 = y + 3 + wlibc.ascent_of(wlibc.F_UI,
                wlibc.px_ui())
            let _kt: u64 = put_text(wlibc.F_UI, wlibc.px_ui(), hx, kgrund,
                spalte_breit(i, c), q, ln, wlibc.theme(wlibc.T_FG), 0)
            say_painted(g(i, D_WIN), K_TABLE, kgrund,
                wlibc.theme(wlibc.T_FG), wlibc.theme(wlibc.T_HEAD),
                q, ln)
        }
        cx = cx + spalte_breit(i, c)
        if c + 1 < cols {
            wlibc.vline(cx - 4, y + 1, kopf, wlibc.theme(wlibc.T_LINE))
        }
        c = c + 1
    }
    wlibc.hline(x + 1, y + kopf, sub(bw, 2), wlibc.theme(wlibc.T_LINE))
    let ganz: u64 = sub(g(i, D_A), 1)
    var r: u64 = 0
    while r < sicht {
        let z: u64 = g(i, D_B) + r
        if z < ganz {
            let q: u64 = row_at(g(i, D_TEXT), z + 1)
            let ln: u64 = row_len(q)
            let ry: u64 = y + kopf + 1 + r * zh
            var farbe: u64 = wlibc.theme(wlibc.T_FG)
            if z == g(i, D_VAL) {
                wlibc.rect(x + 1, ry, sub(bw, 16), zh,
                    wlibc.theme(wlibc.T_SEL))
                farbe = wlibc.theme_selfg()
            }
            var tx: u64 = x + 6
            // ROUND ICONS: the icon of the row goes in front of the
            // FIRST column, and only the first column moves right.  A
            // table whose every column shifted would have its header
            // over the wrong data.
            let einr: u64 = table_ein(i)
            let sym: u64 = icon_at_row(i, z)
            if sym != 0 {
                // RUNDE ECHTHARDWARE-2: mittig, wie in der Liste.
                let ih2: u64 = wlibc.icon_small()
                var oy2: u64 = 2
                if zh > ih2 {
                    oy2 = (zh - ih2) / 2
                }
                let _ = wlibc.icon_at(sym, tx, ry + oy2, ih2, farbe)
            }
            c = 0
            while c < cols {
                let cq: u64 = col_at(q, ln, c)
                if cq != 0 {
                    var cl: u64 = col_len(cq, sub(ln, sub(cq, q)))
                    // was nicht in die Spalte passt, wird abgeschnitten
                    // und nicht in die naechste geschrieben
                    // RUNDE I18N: `fit` statt "ein Oktett weniger, bis
                    // es passt". Die alte Schleife hat ein Zeichen
                    // zerteilt, sobald die Spalte mitten in einem
                    // Umlaut endete.
                    let platz: u64 = sub(spalte_breit(i, c), 6)
                    cl = wlibc.fit(wlibc.F_UI, wlibc.px_ui(), cq, cl, platz)
                    var f2: u64 = farbe
                    if c > 0 && z != g(i, D_VAL) {
                        f2 = wlibc.theme(wlibc.T_DIM)
                    }
                    var txx: u64 = tx
                    if c == 0 {
                        txx = tx + einr
                    }
                    wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), txx,
                        ry + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()) + 1,
                        cq, cl, f2)
                }
                tx = tx + spalte_breit(i, c)
                c = c + 1
            }
        }
        r = r + 1
    }
    wlibc.frame(x, y, bw, bh, wlibc.theme(wlibc.T_LINE))
    paint_scroll(x + bw - 15, y + kopf + 1, sub(sub(bh, kopf), 2),
        g(i, D_B), sicht, ganz)
    focus_ring(i)
}

// THE TAB BAR DID NOT FIT AND NOBODY HAD LOOKED.
//
// Seven tabs of German text come to 576 pixels; the widget is 540 wide.
// So "Sprache" was drawn from x=505 to x=586, thirty-six pixels past
// the end of its own widget, and the eighth tab this round adds would
// have started at 586 and run off the window entirely. It has been that
// way since the seventh tab came back; nothing said so, because a
// widget that paints outside its rectangle is not an error anywhere in
// this library -- it is just paint.
//
// It was found by the tab trace line this round added, which is the
// whole argument for trace lines: `x=586 w=85` in a widget that ends at
// 550 is a sentence, and a screenshot of it is a shrug.
//
// The fix is one division. If the natural widths do not fit, every tab
// is scaled by the same factor and the labels are clipped to what is
// left. Painter and hit test both come through here, so they cannot
// disagree about where a tab is -- which is the only thing that would
// be worse than tabs that are too wide.
fn tab_natur(i: u64, k: u64) -> u64 {
    let q: u64 = row_at(g(i, D_TEXT), k)
    if q == 0 {
        return 0
    }
    return wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q, row_len(q)) + 20
}

fn tab_summe(i: u64) -> u64 {
    var t: u64 = 0
    var k: u64 = 0
    while k < 12 {
        let b: u64 = tab_natur(i, k)
        if b == 0 {
            k = 12
        } else {
            t = t + b
            k = k + 1
        }
    }
    return t
}

fn tab_breite(i: u64, k: u64) -> u64 {
    let b: u64 = tab_natur(i, k)
    if b == 0 {
        return 0
    }
    let ganz: u64 = tab_summe(i)
    let platz: u64 = g(i, D_W)
    if ganz <= platz || ganz == 0 {
        return b
    }
    // integer scaling, and never below the room a couple of letters
    // need -- a two-pixel tab is not a tab.
    var sk: u64 = b * platz / ganz
    if sk < 24 {
        sk = 24
    }
    return sk
}

// RUNDE I18N: WO EIN REITER LIEGT.
//
// Aus demselben Grund, aus dem es seit Runde K15 `text_x` und
// `text_base` gibt: ohne diese beiden Zahlen muesste ein Testlaeufer
// die Breite eines Reiters aus der Schrift NACHRECHNEN, um ihn
// anklicken zu koennen -- und rechnete dann eine zweite Fassung von
// `tab_breite` nach, die auseinanderlaufen kann. Die Breite haengt am
// Text, der Text haengt an der Sprache, und die Sprache ist genau das,
// was diese Runde umstellt: auf Englisch ist "Language" schmaler als
// "Sprache" breit ist. Wer hier raet, klickt in einer der beiden
// Sprachen daneben.
fn tab_x(i: u64, k: u64) -> u64 {
    var x: u64 = g(i, D_X)
    var t: u64 = 0
    // 12 UND NICHT 8. Jede andere Stelle dieser Datei, die Reiter
    // zaehlt (`tab_summe`, der Mausklick, die Pfeiltasten), geht bis 12;
    // nur hier stand 8. Solange es acht Reiter gab, fiel das nicht auf.
    // Runde SYNC bringt den neunten, und der neunte war noch der letzte
    // Fall, der zufaellig richtig herauskam -- der zehnte haette seine
    // Lage falsch gemeldet, und ein Testlaeufer haette danebengeklickt,
    // ohne dass irgendetwas rot geworden waere.
    while t < k && t < 12 {
        x = x + tab_breite(i, t)
        t = t + 1
    }
    return x
}

fn tab_w(i: u64, k: u64) -> u64 {
    return tab_breite(i, k)
}

fn say_tab(w: u64, k: u64, x: u64, y: u64, tw: u64, th: u64) {
    var a: [u8; 13] = "wlib: tab i=\0"
    var bx: [u8; 4] = " x=\0"
    var by: [u8; 4] = " y=\0"
    var bw2: [u8; 4] = " w=\0"
    var bh2: [u8; 4] = " h=\0"
    var bax: [u8; 5] = " ax=\0"
    var bay: [u8; 5] = " ay=\0"
    if s_trace == 0 {
        return
    }
    ulib.say((&a[0 as usize]) as u64)
    ulib.sayn(k)
    ulib.say((&bx[0 as usize]) as u64)
    ulib.sayn(x)
    ulib.say((&by[0 as usize]) as u64)
    ulib.sayn(y)
    ulib.say((&bw2[0 as usize]) as u64)
    ulib.sayn(tw)
    ulib.say((&bh2[0 as usize]) as u64)
    ulib.sayn(th)
    // AND THE PLACE ON THE SCREEN, in the same line. Round LOOK paid
    // for splitting that across two lines on a shared serial port.
    ulib.say((&bax[0 as usize]) as u64)
    ulib.sayn(ng(w, N_X) + 2 + x)
    ulib.say((&bay[0 as usize]) as u64)
    ulib.sayn(ng(w, N_Y) + 22 + y)
    ulib.nl()
}

fn paint_tabs(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bh: u64 = g(i, D_H)
    wlibc.rect(x, y, g(i, D_W), bh, wlibc.theme(wlibc.T_PANEL))
    // ROUND THEMESTORE: TWELVE AND NOT EIGHT. The settings program has
    // eight tabs since this round, and eight was the exact limit -- the
    // next tab anybody adds would have been drawn nowhere and would
    // have swallowed its clicks, with no message of any kind. The hit
    // test below counts to the same number, and it has to: a tab that
    // is drawn and not clickable is worse than one that is neither.
    var tx: u64 = x
    var k: u64 = 0
    while k < 12 {
        let q: u64 = row_at(g(i, D_TEXT), k)
        if q == 0 {
            k = 12
        } else {
            let tw: u64 = tab_breite(i, k)
            var flaeche: u64 = wlibc.theme(wlibc.T_PANEL)
            var farbe: u64 = wlibc.theme(wlibc.T_DIM)
            if k == g(i, D_VAL) {
                flaeche = wlibc.theme(wlibc.T_BG)
                farbe = wlibc.theme(wlibc.T_FG)
            }
            wlibc.rect(tx, y, tw, bh, flaeche)
            wlibc.vline(tx, y, bh, wlibc.theme(wlibc.T_LINE))
            if k == g(i, D_VAL) {
                wlibc.hline(tx, y, tw, wlibc.theme(wlibc.T_ACCENT))
                wlibc.hline(tx, y + 1, tw, wlibc.theme(wlibc.T_ACCENT))
            } else {
                wlibc.hline(tx, y + bh - 1, tw, wlibc.theme(wlibc.T_LINE))
            }
            // AND THE LABEL IS CLIPPED TO THE TAB. `fit` answers how
            // many characters go into a width; without it a scaled tab
            // paints its name across the next one, which is exactly
            // the "overlapping text" this round is supposed to find
            // rather than produce.
            let nq: u64 = wlibc.fit(wlibc.F_UI, wlibc.px_ui(), q,
                row_len(q), sub(tw, 6))
            put_text(wlibc.F_UI, wlibc.px_ui(), tx,
                y + (bh + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2, tw,
                q, nq, farbe, 1)
            // WHERE THE TAB IS, REPORTED BY THE THING THAT DRAWS IT.
            // Round LOOK made list rows and table headers say where
            // they painted, for the reason a runner that computes a tab
            // boundary is a runner that checks its own arithmetic. Same
            // rule, one widget further along.
            say_tab(g(i, D_WIN), k, tx, y, tw, bh)
            tx = tx + tw
            k = k + 1
        }
    }
    wlibc.hline(tx, y + bh - 1, sub(x + g(i, D_W), tx),
        wlibc.theme(wlibc.T_LINE))
    focus_ring(i)
}

fn paint_menubar(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    wlibc.rect(x, y, g(i, D_W), g(i, D_H), wlibc.theme(wlibc.T_PANEL))
    var tx: u64 = x + 4
    var k: u64 = 0
    while k < 8 {
        let q: u64 = row_at(g(i, D_TEXT), k)
        if q == 0 {
            k = 8
        } else {
            let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                row_len(q)) + 16
            if k + 1 == g(i, D_VAL) {
                wlibc.rect(tx, y, tw, g(i, D_H), wlibc.theme(wlibc.T_SEL))
            }
            put_text(wlibc.F_UI, wlibc.px_ui(), tx,
                y + (g(i, D_H) + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()))
                / 2, tw, q, row_len(q), wlibc.theme(wlibc.T_FG), 1)
            tx = tx + tw
            k = k + 1
        }
    }
}

fn paint_choice(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    let rc: u64 = wlibc.metric(wlibc.M_RADIUS_BUTTON)
    if rc == 0 {
        wlibc.rect(x, y, bw, bh, wlibc.theme(wlibc.T_BTN))
        wlibc.frame3(x, y, bw, bh, wlibc.theme(wlibc.T_BTNHI),
            wlibc.theme(wlibc.T_LINE), false)
    } else {
        wlibc.rframe(x, y, bw, bh, rc, wlibc.metric(wlibc.M_BORDER),
            wlibc.theme(wlibc.T_LINE), wlibc.theme(wlibc.T_BTN))
    }
    let q: u64 = row_at(g(i, D_TEXT), g(i, D_VAL))
    if q != 0 {
        let cgr: u64 = y + (bh
            + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
        put_text(wlibc.F_UI, wlibc.px_ui(), x + inset(), cgr, bw, q,
            row_len(q), wlibc.theme(wlibc.T_FG), 0)
        say_painted(g(i, D_WIN), K_CHOICE, cgr, wlibc.theme(wlibc.T_FG),
            wlibc.theme(wlibc.T_BTN), q, row_len(q))
    }
    // Das Dreieck rechts -- sechs Zeilen, von aussen nach innen.
    var n: u64 = 0
    while n < 5 {
        wlibc.hline(x + bw - 16 + n, y + bh / 2 - 2 + n, 10 - 2 * n,
            wlibc.theme(wlibc.T_FG))
        n = n + 1
    }
    focus_ring(i)
}

// ROUND LOOK: a separating line at the opacity the shape asks for.
// `classic` says 100 and gets the same hard line it always got.
fn paint_sep(i: u64) {
    wlibc.divider(g(i, D_X), g(i, D_Y) + g(i, D_H) / 2, g(i, D_W),
        wlibc.theme(wlibc.T_LINE))
}

// ROUND SOFTUI: THE CARD.
//
// A rounded panel, a soft shadow under it, and NO line around it.  The
// shadow is `wlibc.drop_shadow`, which round LOOK built and round PAINT
// measured; it reads what is under the panel out of THIS window's own
// buffer, which is legal -- the widget library owns every pixel of it.
// That is the difference from the window shadow in the compositor and
// it is why the compositor needed a mask and this does not: a card is
// painted once per repaint of a page, a window shadow once per frame.
fn paint_card(i: u64) {
    let r: u64 = wlibc.metric(wlibc.M_RADIUS_PANEL)
    if r == 0 && wlibc.metric(wlibc.M_DIVIDER) >= 50 {
        return
    }
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let w: u64 = g(i, D_W)
    let h: u64 = g(i, D_H)
    if w < 8 || h < 8 {
        return
    }
    wlibc.drop_shadow(x, y, w, h, r, wlibc.metric(wlibc.M_SHADOW2),
        wlibc.metric(wlibc.M_SHADOW_R2), wlibc.theme(wlibc.C_SHADOW))
    wlibc.rrect(x, y, w, h, r, wlibc.theme(wlibc.C_PANEL_BG))
}

// Die Bildflaeche. Erst der Grund (ein Bild mit Deckung unter eins
// braucht einen), dann das Bild, dann der Rahmen. Beschnitten wird auf
// das Widget: `wlibc.clip_set` -- ohne das malte ein vergroessertes
// Bild ueber die halbe Fensterbreite.
fn paint_bild(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let w: u64 = g(i, D_W)
    let h: u64 = g(i, D_H)
    wlibc.rect(x, y, w, h, wlibc.theme(wlibc.T_ENTRY))
    let p: u64 = g(i, D_E)
    let iw: u64 = g(i, D_F)
    let ih: u64 = g(i, D_G)
    if p == 0 || iw == 0 || ih == 0 || w < 4 || h < 4 {
        wlibc.frame(x, y, w, h, wlibc.theme(wlibc.T_LINE))
        return
    }
    let z: u64 = g(i, D_ZOOM)
    let dreh: u64 = g(i, D_DREH)
    let bw: u64 = bild_bw(i)
    let bh: u64 = bild_bh(i)
    let zw: u64 = bw * z / 100
    let zh: u64 = bh * z / 100
    // Die linke obere Ecke: mittig, plus die Verschiebung.
    var ox: u64 = x
    if zw < w {
        ox = x + (w - zw) / 2
    }
    var oy: u64 = y
    if zh < h {
        oy = y + (h - zh) / 2
    }
    ox = ox +% g(i, D_PX)
    oy = oy +% g(i, D_PY)
    let a_x0: u64 = wlibc.clip_x0()
    let a_y0: u64 = wlibc.clip_y0()
    let a_x1: u64 = wlibc.clip_x1()
    let a_y1: u64 = wlibc.clip_y1()
    wlibc.clip_set(x, y, x + w, y + h)
    var sy: u64 = 0
    while sy < h {
        let py: u64 = y + sy
        // Welcher Bildpunkt liegt hier? Rueckwaerts gerechnet, damit
        // jeder Bildschirmpunkt genau einmal gesetzt wird.
        let dy: u64 = py -% oy
        if dy < zh {
            let qy: u64 = dy * 100 / z
            var sx: u64 = 0
            while sx < w {
                let px: u64 = x + sx
                let dx: u64 = px -% ox
                if dx < zw {
                    let qx: u64 = dx * 100 / z
                    var bx: u64 = qx
                    var by: u64 = qy
                    if dreh == 1 {
                        bx = qy
                        by = ih - 1 - qx
                    } else if dreh == 2 {
                        bx = iw - 1 - qx
                        by = ih - 1 - qy
                    } else if dreh == 3 {
                        bx = iw - 1 - qy
                        by = qx
                    }
                    if bx < iw && by < ih {
                        let f: u64 = (__mmio_read32((p + (by * iw + bx) * 4)
                            as *mut u32)) as u64
                        let a: u64 = f >> 24
                        if a == 255 {
                            wlibc.px(px, py, f & wlibc.RGB24)
                        } else if a > 0 {
                            wlibc.px(px, py, wlibc.blend(wlibc.get(px, py),
                                f & wlibc.RGB24, a))
                        }
                    }
                }
                sx = sx + 1
            }
        }
        sy = sy + 1
    }
    // Der gezogene Ausschnitt: ein Rahmen in der Akzentfarbe, INNEN
    // beschnitten wie das Bild selbst.
    if g(i, D_WZ) == 1 && s_aus_da != 0 {
        let ox2: u64 = bild_ox(i)
        let oy2: u64 = bild_oy(i)
        let ax: u64 = ox2 + bild_aus_x0() * z / 100
        let ay: u64 = oy2 + bild_aus_y0() * z / 100
        let aw: u64 = (bild_aus_x1() - bild_aus_x0() + 1) * z / 100
        let ah: u64 = (bild_aus_y1() - bild_aus_y0() + 1) * z / 100
        wlibc.frame(ax, ay, aw, ah, wlibc.theme(wlibc.T_ACCENT))
        if aw > 2 && ah > 2 {
            wlibc.frame(ax + 1, ay + 1, aw - 2, ah - 2,
                wlibc.theme(wlibc.T_ACCENT))
        }
    }
    wlibc.clip_set(a_x0, a_y0, a_x1, a_y1)
    wlibc.frame(x, y, w, h, wlibc.theme(wlibc.T_LINE))
    focus_ring(i)
}

// Der Schieberegler: eine Rinne, ein gefuellter Teil bis zum Griff, der
// Griff. Die Farben sind die des Farbschemas, die Hoehen die der
// Vorlage -- keine Zahl davon steht hier.

fn paint_one(i: u64) {
    let k: u64 = g(i, D_KIND)
    if (g(i, D_FLAGS) & F_HIDE) != 0 {
        return
    }
    if k == K_BILD {
        paint_bild(i)
    } else if k == K_SLIDER {
        paint_slider(i)
    } else if k == K_LABEL {
        paint_label(i)
    } else if k == K_BUTTON {
        paint_button(i)
    } else if k == K_CHECK {
        paint_check(i)
    } else if k == K_ENTRY {
        paint_entry(i)
    } else if k == K_LIST {
        paint_list(i)
    } else if k == K_TABLE {
        paint_table(i)
    } else if k == K_TABS {
        paint_tabs(i)
    } else if k == K_MENUBAR {
        paint_menubar(i)
    } else if k == K_CHOICE {
        paint_choice(i)
    } else if k == K_SEP {
        paint_sep(i)
    } else if k == K_CARD {
        paint_card(i)
    } else if k == K_SCROLL {
        paint_scroll(g(i, D_X), g(i, D_Y), g(i, D_H), g(i, D_VAL),
            g(i, D_B), g(i, D_A))
    } else if k == K_TILE {
        paint_tile(i)
    } else if k == K_GRAPH {
        paint_graph(i)
    } else if k == K_LEINWAND {
        paint_leinwand(i)
    }
}

// EIN MENUEFENSTER. Es hat keine Widgets -- es ist eine Liste von
// Zeilen und ein Rahmen. Der Grund: ein Menue ist der einzige Fall, in
// dem ein FENSTER genau ein Widget ist, und eine Widgetliste dafuer
// waere eine Verwaltung ohne Nutzen.
// ==================================================== RUNDE ECHTHARDWARE-2
//
// EIN FENSTER FUER EINE INFOBLASE -- ANGELEGT UND WIEDER WEGGERAEUMT.
//
// Das ist ALLES, was die Bibliothek zur Blase beitraegt: das Fenster.
// Gezeichnet wird sie vom Programm, dem sie gehoert (die Taskleiste),
// und zwar mit denselben `mal_*`-Aufrufen wie jede andere Flaeche.
//
// WARUM DIE TEILUNG. Der erste Entwurf hatte die ganze Blase hier --
// Aufmachen, Zumachen, Verweilzeit, Zeichnen. Danach brach `firnc1` an
// drei Programmen ab (siehe die Begruendung bei NK_TIP). wlib steckt in
// dreizehn Programmen; die Blase braucht eines. Also bleibt hier der
// Teil, der ohne die Fenstertafel dieser Datei nicht ginge, und der
// Rest zieht dorthin, wo er gebraucht wird.
fn tip_win_open(x: u64, y: u64, w: u64, h: u64, titel: u64) -> u64 {
    let i: u64 = new_win(x, y, w, h, titel, NK_TIP)
    if i >= MAXWN {
        return MAXWN
    }
    // Ohne das kommt die Blase mit Titelleiste -- gemessen: tp=30,
    // dreissig Bildpunkte Schmuck ueber einer Zeile Text.
    let _d: u64 = wlibc.win_state(ng(i, N_H), wlibc.WS_DECO, 0)
    dirty_all(i)
    return i
}

fn tip_win_close(i: u64) {
    if i >= MAXWN {
        return
    }
    close(i)
    // Der Platz wird wieder frei -- wie bei `menu_close`. Eine Leiste,
    // die tausendmal am Tag eine Blase zeigt, darf die Fenstertafel
    // nicht vollaufen lassen.
    if i + 1 == nwn {
        nwn = nwn - 1
    }
}

// Die Kennung beim Fensterserver -- die braucht der Eigentuemer, um
// seine Blase zu bemalen und auf den Schirm zu schieben.
fn tip_win_id(i: u64) -> u64 {
    return ng(i, N_H)
}

fn paint_menu(w: u64) {
    let zh: u64 = zeilen_hoehe() + 2
    wlibc.rect(0, 0, ng(w, N_W), ng(w, N_HH), wlibc.theme(wlibc.T_MENU))
    var k: u64 = 0
    while k < ng(w, N_CNT) {
        let q: u64 = row_at(ng(w, N_DATA), k)
        if q != 0 {
            let ry: u64 = 2 + k * zh
            var farbe: u64 = wlibc.theme(wlibc.T_FG)
            if k + 1 == ng(w, N_VAL) {
                wlibc.rect(1, ry, sub(ng(w, N_W), 2), zh,
                    wlibc.theme(wlibc.T_SEL))
                farbe = wlibc.theme_selfg()
            }
            wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), 8,
                ry + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()) + 1, q,
                row_len(q), farbe)
        }
        k = k + 1
    }
    wlibc.frame(0, 0, ng(w, N_W), ng(w, N_HH), wlibc.theme(wlibc.T_ACCENT))
}

// DAS NEUZEICHNEN -- STREIFEN FUER STREIFEN.
//
// Der schmutzige Bereich wird in so viele Streifen zerlegt, wie die
// Flaeche hoch ist. Je Streifen: Hintergrund, alle Widgets, die ihn
// beruehren, und EIN Aufruf hinueber. Ein Widget, das drei Streifen
// beruehrt, wird dreimal gezeichnet -- was es kostet, ist der Anteil,
// der ohnehin gezeichnet wird, und was es spart, ist der ganze Puffer.
fn flush_win(w: u64) -> u64 {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return 0
    }
    let n: u64 = ng(w, N_NDIRT)
    ns(w, N_NDIRT, 0)
    var gemalt: u64 = 0
    var k: u64 = 0
    while k < n {
        gemalt = gemalt + flush_rect(w, dg(w, k, 0), dg(w, k, 1),
            dg(w, k, 2), dg(w, k, 3))
        k = k + 1
    }
    return gemalt
}

fn flush_rect(w: u64, x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    var gemalt: u64 = 0
    var yb: u64 = y0
    while yb < y1 {
        var ye: u64 = yb + wlibc.surf_rows()
        if ye > y1 {
            ye = y1
        }
        wlibc.set_band(yb)
        wlibc.clip_set(x0, yb, x1, ye)
        paint_bg(w, x0, yb, x1 - x0, ye - yb)
        if ng(w, N_KIND) == NK_MENU {
            paint_menu(w)
        } else {
            var i: u64 = 0
            while i < nwd {
                if g(i, D_WIN) == w {
                    if g(i, D_Y) < ye && g(i, D_Y) + g(i, D_H) > yb {
                        paint_one(i)
                    }
                }
                i = i + 1
            }
        }
        wlibc.push(ng(w, N_H), x0, yb, x1 - x0, ye - yb)
        s_blits = s_blits + 1
        gemalt = gemalt + (x1 - x0) * (ye - yb)
        yb = ye
    }
    return gemalt
}

fn draw_all() {
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            dirty_all(w)
        }
        w = w + 1
    }
    let _g: u64 = paint_all()
}

// ==================================================================
// DIE EINGABE
//
// DIE TREFFERPRUEFUNG IST DIE STELLE, AN DER `nohit` ANSETZT. Ohne sie
// kommen dieselben Ereignisse an, dieselben Zaehler laufen hoch -- und
// kein Widget erfaehrt davon. Das ist die Gegenprobe zu jeder Zusage
// ueber einen Klick: sie MUSS damit einbrechen.
fn hit_at(w: u64, x: u64, y: u64) -> u64 {
    if s_nohit != 0 {
        return MAXWD
    }
    var i: u64 = 0
    while i < nwd {
        if g(i, D_WIN) == w && (g(i, D_FLAGS) & (F_HIDE | F_OFF)) == 0 {
            if x >= g(i, D_X) && x < g(i, D_X) + g(i, D_W) {
                if y >= g(i, D_Y) && y < g(i, D_Y) + g(i, D_H) {
                    return i
                }
            }
        }
        i = i + 1
    }
    return MAXWD
}

fn ticks() -> u64 {
    return ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
}

// ------------------------------------------------------ die Bewegung
//
// DIE KURVEN, IN GANZZAHLEN. Eingang und Ausgang sind Tausendstel.
// Es gibt hier keine Fliesskommazahl, und das ist keine Sparsamkeit:
// dieser Kernel rettet in `syscall` keine SSE-Register, also hat ein
// Ring-3-Programm, das in einer Ereignisschleife multipliziert, mit
// `f64` keine Zusage. Ganzzahlen haben eine.
//
// ease-out ist 1-(1-t)^2, ease-in-out ist die Zwei-Stueck-Parabel --
// beides die Formen aus states-and-variants.md, nur als Bruch.
fn ease(kurve: u64, t: u64) -> u64 {
    var p: u64 = t
    if p > 1000 {
        p = 1000
    }
    if kurve == EASE_OUT {
        let inv: u64 = 1000 - p
        return 1000 - inv * inv / 1000
    }
    if kurve == EASE_IN_OUT {
        if p < 500 {
            return 2 * p * p / 1000
        }
        let inv2: u64 = 1000 - p
        return 1000 - 2 * inv2 * inv2 / 1000
    }
    return p
}

fn tg(i: u64, f: u64) -> u64 {
    return tw[(i * TW_FIELDS + f) as usize]
}

fn tset(i: u64, f: u64, v: u64) {
    tw[(i * TW_FIELDS + f) as usize] = v
}

// "Sind Bewegungen abgeschaltet?" -- EINE Stelle. `motion` gibt 0
// zurueck, wenn die Formentabelle motion=0 sagt, und das ist genau die
// Zusage "Animationen reduzieren": jede Bewegung ist dann sofort fertig
// statt uebersprungen. Der Unterschied ist wichtig -- der Endzustand
// wird in beiden Faellen erreicht, nur ohne Zwischenbilder.
fn motion_aus() -> bool {
    return wlibc.motion(wlibc.MO_NORMAL) == 0
}

// Eine Bewegung anmelden. Gibt die Nummer zurueck, oder TW_MAX, wenn
// kein Platz ist -- und das ist kein Fehler: eine Oberflaeche, die
// mehr als sechzehn Dinge gleichzeitig bewegt, darf die siebzehnte
// weglassen. Sie ist dann sofort an ihrem Ziel.
fn anim_start(was: u64, w: u64, wd: u64, stufe: u64, kurve: u64) -> u64 {
    // Laeuft fuer dasselbe Ding schon eine: sie wird ersetzt, nicht
    // gestapelt. Ein Knopf, ueber den die Maus dreimal wandert, hatte
    // sonst drei Bewegungen mit drei Startzeiten.
    var i: u64 = 0
    var frei: u64 = TW_MAX
    while i < tw_n {
        if tg(i, TW_STATE) != TW_FREI && tg(i, TW_WHAT) == was
            && tg(i, TW_WIN) == w && tg(i, TW_WD) == wd {
            frei = i
            i = tw_n
        } else {
            i = i + 1
        }
    }
    if frei == TW_MAX {
        var k: u64 = 0
        while k < TW_MAX && tg(k, TW_STATE) != TW_FREI {
            k = k + 1
        }
        if k >= TW_MAX {
            return TW_MAX
        }
        frei = k
        if frei >= tw_n {
            tw_n = frei + 1
        }
    }
    let ms: u64 = wlibc.motion(stufe)
    var d: u64 = ms / MS_PRO_TICK
    if d == 0 {
        d = 1
    }
    tset(frei, TW_STATE, TW_LAEUFT)
    tset(frei, TW_T0, ticks())
    tset(frei, TW_DUR, d)
    tset(frei, TW_CURVE, kurve)
    tset(frei, TW_WHAT, was)
    tset(frei, TW_WIN, w)
    tset(frei, TW_WD, wd)
    tset(frei, TW_P, 0)
    tw_starts = tw_starts + 1
    // motion=0: sofort am Ziel, aber EINMAL gemalt.
    if ms == 0 {
        tset(frei, TW_P, 1000)
        tset(frei, TW_STATE, TW_FERTIG)
    }
    return frei
}

// Der Fortschritt eines Dings, 0..1000. Laeuft keine Bewegung dafuer,
// ist die Antwort 1000 -- "steht an seinem Ziel". Das ist die Antwort,
// die ein Maler will: er fragt nicht, OB etwas animiert wird, er malt
// den Zustand, den er bekommt.
fn anim_at(was: u64, w: u64, wd: u64) -> u64 {
    var i: u64 = 0
    while i < tw_n {
        if tg(i, TW_STATE) != TW_FREI && tg(i, TW_WHAT) == was
            && tg(i, TW_WIN) == w && tg(i, TW_WD) == wd {
            return ease(tg(i, TW_CURVE), tg(i, TW_P))
        }
        i = i + 1
    }
    return 1000
}

fn anim_laeuft(was: u64, w: u64, wd: u64) -> bool {
    var i: u64 = 0
    while i < tw_n {
        if tg(i, TW_STATE) == TW_LAEUFT && tg(i, TW_WHAT) == was
            && tg(i, TW_WIN) == w && tg(i, TW_WD) == wd {
            return true
        }
        i = i + 1
    }
    return false
}

fn anim_stop(was: u64, w: u64, wd: u64) {
    var i: u64 = 0
    while i < tw_n {
        if tg(i, TW_STATE) != TW_FREI && tg(i, TW_WHAT) == was
            && tg(i, TW_WIN) == w && tg(i, TW_WD) == wd {
            tset(i, TW_STATE, TW_FREI)
        }
        i = i + 1
    }
}

// EIN Takt fuer alle Bewegungen, aufgerufen aus `step`. Gibt zurueck,
// wie viele noch laufen -- danach entscheidet `step`, ob es die CPU
// abgeben darf oder nicht. Das ist der ganze Unterschied zwischen einer
// Bewegung und einem Standbild: eine Schleife, die bei "nichts
// passiert" schlaeft, muss wissen, dass eine laufende Bewegung ETWAS
// ist.
// Ein Schritt einer Bewegung auf die serielle Leitung. Nur mit
// `/etc/uitrace`, wie jede andere Meldung dieser Bibliothek.
fn say_anim(was: u64, wd: u64, p: u64, dur: u64) {
    if s_trace == 0 {
        return
    }
    let b: u64 = (&tr_buf[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&an_wort[0 as usize]) as u64)
    at = tr_put(b, at, (&an_was[0 as usize]) as u64)
    at = tr_num(b, at, was)
    at = tr_put(b, at, (&an_wd[0 as usize]) as u64)
    at = tr_num(b, at, wd)
    at = tr_put(b, at, (&an_p[0 as usize]) as u64)
    at = tr_num(b, at, p)
    at = tr_put(b, at, (&an_dur[0 as usize]) as u64)
    at = tr_num(b, at, dur)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(b, at)
}

fn anim_tick() -> u64 {
    if tw_n == 0 {
        return 0
    }
    let jetzt: u64 = ticks()
    var aktiv: u64 = 0
    var i: u64 = 0
    while i < tw_n {
        let st: u64 = tg(i, TW_STATE)
        if st == TW_LAEUFT {
            var p: u64 = 1000
            let d: u64 = tg(i, TW_DUR)
            let t0: u64 = tg(i, TW_T0)
            if jetzt > t0 {
                let v: u64 = jetzt - t0
                if v < d {
                    p = v * 1000 / d
                }
            } else {
                p = 0
            }
            if p != tg(i, TW_P) {
                tset(i, TW_P, p)
                let w: u64 = tg(i, TW_WIN)
                let wd: u64 = tg(i, TW_WD)
                if wd < MAXWD && wd < nwd {
                    dirty_wd(wd)
                } else {
                    dirty_all(w)
                }
                tw_frames = tw_frames + 1
                say_anim(tg(i, TW_WHAT), wd, p, d)
            }
            if p >= 1000 {
                tset(i, TW_STATE, TW_FERTIG)
            } else {
                aktiv = aktiv + 1
            }
        } else if st == TW_FERTIG {
            // Ein fertiger Tween bleibt EINEN Durchlauf stehen, damit
            // `anim_at` den Endzustand noch einmal liefert, und wird
            // dann frei. Wer ihn sofort loescht, malt das letzte Bild
            // einer Bewegung nie.
            tset(i, TW_STATE, TW_FREI)
        }
        i = i + 1
    }
    // Den Rand zuruecknehmen, damit `tw_n` nicht auf 16 stehenbleibt.
    while tw_n > 0 && tg(tw_n - 1, TW_STATE) == TW_FREI {
        tw_n = tw_n - 1
    }
    return aktiv
}

fn anim_starts() -> u64 {
    return tw_starts
}

fn anim_frames() -> u64 {
    return tw_frames
}

// Ein Wert zwischen zwei Zahlen, nach Fortschritt. Die eine Rechnung,
// die ein Maler braucht, damit sie nicht in fuenfzehn Fassungen im
// Baum steht.
// ==================================================================
// RUNDE DESIGN-2: DER MALER -- die zweite Schicht neben den Widgets.
//
// WOFUER ER DA IST. Fuenf Programme dieses Systems sind keine
// Widget-Fenster: die Taskleiste, das Schnelleinstellungs-Blatt, das
// Verlaufsdiagramm des Task-Managers, die Kachelkarte von `speicher`
// und der Schreibtisch. Sie malen eine FLAECHE, und ein Knopf ist
// dafuer das falsche Werkzeug.
//
// Vor dieser Runde haben sie deshalb `wlibc.rect`, `wlibc.frame` und
// `wlibc.text_at` selbst gerufen -- also am Rahmenwerk vorbei, mit
// eigenen Radien (keinen), eigenen Abstaenden (getippt) und eigener
// Hoehe (keiner). Genau das zaehlt tools/design/zaehlen.py.
//
// DIE ANTWORT IST NICHT "macht Knoepfe daraus", sondern die Regel von
// Justin: was das Rahmenwerk nicht kann, wird INS Rahmenwerk gebaut.
// Diese Schicht ist der Pinsel, den ein flaechenmalendes Programm
// braucht -- und sie kennt die Form-Tokens, die ein Programm nicht
// kennen soll.
//
// WAS SIE NICHT IST: ein zweiter Zeichenkern. Jede Routine hier ist
// eine Handvoll Zeilen ueber wlibc, und die Rechnung (Radius aus der
// Rolle, Schatten aus der Hoehenstufe, Abstand aus der Skala) steht
// EINMAL hier statt fuenfmal dort.

// Die Rollen, aus denen ein Radius folgt. Ein Programm sagt WAS es
// malt, nicht WIE rund es ist.
const MR_FLAECHE: u64 = 0   // Hintergrund, kein Radius
const MR_TAFEL: u64 = 1     // eine Tafel/Karte
const MR_KNOPF: u64 = 2     // etwas Anfassbares
const MR_FELD: u64 = 3      // ein Eingabefeld/eine Spur

fn mal_radius(rolle: u64) -> u64 {
    if rolle == MR_TAFEL {
        return wlibc.metric(wlibc.M_RADIUS_PANEL)
    }
    if rolle == MR_KNOPF {
        return wlibc.metric(wlibc.M_RADIUS_BUTTON)
    }
    if rolle == MR_FELD {
        return wlibc.metric(wlibc.M_RADIUS_INPUT)
    }
    return 0
}

// EINE FLAECHE. Das ist `rect` mit einem Namen -- und der Name ist der
// Punkt: ein Programm, das seinen Hintergrund fuellt, sagt das jetzt,
// statt ein Rechteck zu malen.
fn mal_flaeche(x: u64, y: u64, w: u64, h: u64, farbe: u64) {
    wlibc.rrect(x, y, w, h, 0, farbe)
}

// EINE TAFEL: Flaeche mit dem Radius ihrer Rolle, wahlweise mit einer
// Umrandung und mit einer Hoehenstufe (also einem Schatten).
//
// `stufe` ist EL_FLAT..EL_WINDOW aus wlibc. Bei EL_FLAT wird kein
// Schatten gemalt und die Routine kostet genau so viel wie vorher.
fn mal_tafel(x: u64, y: u64, w: u64, h: u64, rolle: u64, stufe: u64,
    fuellung: u64, rand: u64) {
    let r: u64 = mal_radius(rolle)
    if stufe != wlibc.EL_FLAT {
        let s: u64 = wlibc.elev_strength(stufe)
        let reich: u64 = wlibc.elev_reach(stufe)
        if s != 0 && reich != 0 {
            wlibc.drop_shadow(x, y, w, h, r, s, reich,
                wlibc.theme(wlibc.C_SHADOW))
        }
    }
    if rand == 0 {
        wlibc.rrect(x, y, w, h, r, fuellung)
        return
    }
    wlibc.rframe(x, y, w, h, r, wlibc.metric(wlibc.M_BORDER), rand,
        fuellung)
}

// EINE TRENNLINIE, mit der Deckkraft aus der Formentabelle. `classic`
// bekommt seine harte Linie, `osum` eine, die nicht schreit.
fn mal_trenner(x: u64, y: u64, w: u64) {
    wlibc.divider(x, y, w, wlibc.theme(wlibc.T_LINE))
}

// TEXT AN EINER GRUNDLINIE, in einer Typo-Stufe. Ein Programm nennt die
// STUFE (TY_CAPTION..TY_DISPLAY) und keine Punktgroesse.
fn mal_text(x: u64, grundlinie: u64, p: u64, n: u64, farbe: u64,
    stufe: u64) -> u64 {
    return wlibc.text_at(wlibc.F_UI, wlibc.type_px(stufe), x, grundlinie,
        p, n, farbe)
}

// Wie breit wird dieser Text in dieser Stufe? Messen ist kein Malen,
// aber es gehoert an dieselbe Stelle wie das Malen -- sonst misst ein
// Programm mit einer anderen Groesse, als es malt.
fn mal_text_w(p: u64, n: u64, stufe: u64) -> u64 {
    return wlibc.text_w(wlibc.F_UI, wlibc.type_px(stufe), p, n)
}

fn mal_ascent(stufe: u64) -> u64 {
    return wlibc.ascent_of(wlibc.F_UI, wlibc.type_px(stufe))
}

// DIE ALTE KANTE: Flaeche, darauf eine Kante mit Licht und Schatten.
//
// Das ist die Form von `classic` und ausdruecklich KEINE Gestaltung
// dieser Runde -- sie ist die Vergangenheit, und sie muss erhalten
// bleiben, weil tools/look/run.sh Bildpunkt fuer Bildpunkt gegen sie
// misst. `eingedrueckt` dreht Licht und Schatten um.
//
// Sie steht hier und nicht mehr in der Taskleiste, damit auch der
// letzte Pinselstrich dieses Systems durch das Rahmenwerk geht.
fn mal_kante3(x: u64, y: u64, w: u64, h: u64, fuellung: u64, licht: u64,
    schatten: u64, eingedrueckt: bool) {
    wlibc.rect(x, y, w, h, fuellung)
    wlibc.frame3(x, y, w, h, licht, schatten, eingedrueckt)
}

// EIN RAHMEN OHNE FUELLUNG, mit dem Radius seiner Rolle.
//
// Fuer alles, was UEBER bereits Gemaltes gelegt wird: die Umrandung
// einer Kachelkarte, der Rand eines Diagramms. `mal_tafel` fuellt --
// wer sie hier nimmt, loescht, was er gerade gemalt hat.
fn mal_rahmen(x: u64, y: u64, w: u64, h: u64, rolle: u64, farbe: u64) {
    wlibc.rring(x, y, w, h, mal_radius(rolle),
        wlibc.metric(wlibc.M_BORDER), farbe)
}

// EINE WAAGERECHTE HILFSLINIE IN VOLLER DECKKRAFT.
//
// Nicht `mal_trenner`: der ist ein TRENNER zwischen zwei Bereichen und
// laeuft mit der Deckkraft aus der Formentabelle (bei `osum` ein
// Fuenftel). Ein Gitter in einem Diagramm ist etwas anderes -- es muss
// ablesbar sein, sonst ist es kein Gitter.
fn mal_linie(x: u64, y: u64, w: u64, farbe: u64) {
    wlibc.hline(x, y, w, farbe)
}

// EIN BALKEN: die Grundform eines Reglers, eines Fortschritts und eines
// Diagrammbalkens. Radius der Rolle "Feld", damit ein Balken von vier
// Bildpunkten Hoehe nicht wie ein Draht aussieht.
fn mal_balken(x: u64, y: u64, w: u64, h: u64, farbe: u64) {
    var r: u64 = mal_radius(MR_FELD)
    if r * 2 > h {
        r = h / 2
    }
    wlibc.rrect(x, y, w, h, r, farbe)
}

// EIN EINZELNER BILDPUNKT -- fuer die einzige Stelle, an der das
// wirklich noetig ist: ein Hintergrundbild, das Punkt fuer Punkt
// gerechnet wird (kernel/user/desktop.fi). Er steht hier, damit auch
// diese Stelle durch das Rahmenwerk geht und nicht daran vorbei.
fn mal_punkt(x: u64, y: u64, farbe: u64) {
    wlibc.px(x, y, farbe)
}

// EIN SYMBOL an einer Stelle, in der Farbe einer Rolle.
fn mal_symbol(id: u64, x: u64, y: u64) -> bool {
    return wlibc.icon_draw(id, x, y)
}

// Ein Abstand aus der Skala. `sp(0..3)` = xs/s/m/l. Damit hoert das
// Tippen von 8, 10, 12 in den Programmen auf.
fn mal_abstand(stufe: u64) -> u64 {
    return wlibc.space(stufe)
}

fn anim_mix(von: u64, bis: u64, p: u64) -> u64 {
    if p >= 1000 {
        return bis
    }
    if bis >= von {
        return von + (bis - von) * p / 1000
    }
    return von - (von - bis) * p / 1000
}

fn fire(i: u64, kind: u64, index: u64, w: u64) {
    s_fired = i + 1
    s_fkind = kind
    s_findex = index
    s_fwin = w
}

// Welche Zeile einer Liste/Tabelle liegt unter dieser Stelle? MAXWD,
// wenn keine.
fn row_under(i: u64, y: u64) -> u64 {
    let zh: u64 = zeilen_hoehe()
    var oben: u64 = g(i, D_Y) + 2
    if g(i, D_KIND) == K_TABLE {
        oben = g(i, D_Y) + zh + 5
    }
    if y < oben {
        return MAXWD
    }
    let r: u64 = (y - oben) / zh + g(i, D_B)
    var ganz: u64 = g(i, D_A)
    if g(i, D_KIND) == K_TABLE {
        ganz = sub(ganz, 1)
    }
    if r >= ganz {
        return MAXWD
    }
    return r
}

fn scroll_to(i: u64, z: u64) {
    let zh: u64 = zeilen_hoehe()
    var sicht: u64 = sub(g(i, D_H), 4) / zh
    if g(i, D_KIND) == K_TABLE {
        sicht = sub(sub(g(i, D_H), 4), zh + 4) / zh
    }
    if sicht == 0 {
        return
    }
    if z < g(i, D_B) {
        s(i, D_B, z)
    } else if z >= g(i, D_B) + sicht {
        s(i, D_B, z - sicht + 1)
    }
}

fn on_down(w: u64, x: u64, y: u64, btn: u64) {
    // Ein Menuefenster: die Zeile unter dem Zeiger waehlen.
    if ng(w, N_KIND) == NK_MENU {
        // RUNDE ECHTHARDWARE-2, ANMERKUNG STATT CODE.
        //
        // Hier stand waehrend der Runde eine Spurzeile, und sie hat den
        // Fehler gefunden: das Kontextmenue der Leiste stand sichtbar
        // da, und trotzdem kam hier NICHTS an -- weil das Startmenue
        // auf L_TOP darueber lag und der Server den Klick folgerichtig
        // diesem gab. Wer denselben Verdacht noch einmal hat, setzt sie
        // wieder ein; DAUERHAFT bleibt sie NICHT.
        //
        // Grund: `wlib` steckt in dreizehn Programmen, und diese Datei
        // steht dicht unter einer stillen Grenze des selbstgehosteten
        // Uebersetzers (siehe NK_TIP weiter oben und OFFEN.md D-019).
        // Die zwanzig Zeilen Spur haben `firnc1` an `netmon`, `freunde`
        // und `powermon` erneut abbrechen lassen -- K16 fiel von 64/0
        // auf 62/2 zurueck. Eine Diagnose, die den Pruefstand rot
        // macht, ist keine.
        if s_nohit != 0 {
            return
        }
        let zh: u64 = zeilen_hoehe() + 2
        if y >= 2 {
            let k: u64 = (y - 2) / zh
            if k < ng(w, N_CNT) {
                ns(w, N_VAL, k + 1)
                fire(ng(w, N_OWNER), K_MENUBAR, k, w)
            }
        }
        return
    }
    let i: u64 = hit_at(w, x, y)
    if i >= MAXWD {
        return
    }
    let k: u64 = g(i, D_KIND)
    if (g(i, D_FLAGS) & F_FOCUSABLE) != 0 {
        set_focus(i)
    }
    if k == K_BUTTON {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_PRESSED)
        // Das Druecken ist die schnellste Bewegung im System: die
        // Hand ist schon da, das Bild darf nicht hinterherlaufen.
        let _a3: u64 = anim_start(AN_PRESS, g(i, D_WIN), i,
            wlibc.MO_FAST, EASE_OUT)
        s_down = i + 1
        dirty_wd(i)
        return
    }
    // RUNDE CERTUS-AUF-OSUM: die Leinwand bekommt die Stelle IM WIDGET
    // und entscheidet selbst, was darunter liegt.
    if k == K_LEINWAND {
        lw_push(i, LE_DOWN, ((x - g(i, D_X)) << 16) | (y - g(i, D_Y)), btn)
        s_down = i + 1
        return
    }
    // RUNDE ALLTAG. Ein Schieberegler springt dorthin, wo geklickt
    // wurde, und zieht dann mit. Eine Bildflaeche schiebt das Bild.
    if k == K_SLIDER {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_PRESSED)
        s_down = i + 1
        slider_setz(i, x)
        fire(i, K_SLIDER, g(i, D_VAL), w)
        return
    }
    if k == K_BILD {
        s_down = i + 1
        s_dragx = x
        s_dragy = y
        if g(i, D_WZ) == 1 {
            s_aus_x0 = bild_px(i, x)
            s_aus_y0 = bild_py(i, y)
            s_aus_x1 = s_aus_x0
            s_aus_y1 = s_aus_y0
            s_aus_da = 1
            dirty_wd(i)
        }
        return
    }
    // ROUND THEMESTORE: A TILE IS A BIG BUTTON. It reports the click
    // at once instead of on release -- there is no "pressed" look to
    // show, because the tile already shows a preset and dimming it
    // would misrepresent the very thing it is there to display.
    if k == K_TILE {
        dirty_wd(i)
        fire(i, K_TILE, 0, w)
        return
    }
    if k == K_CHECK {
        s(i, D_VAL, 1 - g(i, D_VAL))
        dirty_wd(i)
        fire(i, K_CHECK, g(i, D_VAL), w)
        return
    }
    // MERGE-8: hier stand TON-2s zweiter K_SLIDER-Zweig. Runde ALLTAG
    // behandelt denselben Fall weiter oben in dieser Funktion und kehrt
    // dort zurueck -- dieser Block war nach dem Zusammenfuehren nicht
    // mehr erreichbar (und rief slider_set_x, das mit TON-2s Regler
    // weggefallen ist).
    if k == K_ENTRY {
        // Die Einfuegemarke dorthin, wo geklickt wurde -- Zeichen fuer
        // Zeichen nachgerechnet und nicht durch die mittlere Breite
        // geteilt: bei einer Proportionalschrift waere das um bis zu
        // ein halbes Zeichen daneben.
        let p: u64 = g(i, D_TEXT)
        let n: u64 = tlen(p)
        var at: u64 = 0
        while at < n && entry_x(i, at + 1) <= x {
            at = at + 1
        }
        s(i, D_B, at)
        s(i, D_C, at)
        s_down = i + 1
        dirty_wd(i)
        return
    }
    if k == K_LIST || k == K_TABLE {
        // die Bildlaufleiste?
        if x >= g(i, D_X) + g(i, D_W) - 16 {
            let zh: u64 = zeilen_hoehe()
            var sicht: u64 = sub(g(i, D_H), 4) / zh
            if k == K_TABLE {
                sicht = sub(sub(g(i, D_H), 4), zh + 4) / zh
            }
            var ganz: u64 = g(i, D_A)
            if k == K_TABLE {
                ganz = sub(ganz, 1)
            }
            if ganz > sicht {
                let rel: u64 = sub(y, g(i, D_Y))
                let z: u64 = rel * ganz / g(i, D_H)
                var oben: u64 = z
                if oben + sicht > ganz {
                    oben = ganz - sicht
                }
                s(i, D_B, oben)
                dirty_wd(i)
            }
            return
        }
        // die Kopfzeile einer Tabelle: nach dieser Spalte sortieren
        if k == K_TABLE && y < g(i, D_Y) + zeilen_hoehe() + 5 {
            var cx: u64 = g(i, D_X) + 2
            var c: u64 = 0
            while c < g(i, D_C) {
                if x >= cx && x < cx + spalte_breit(i, c) {
                    fire(i, K_TABLE, c, w)
                    s(i, D_C, g(i, D_C))
                    c = g(i, D_C)
                } else {
                    cx = cx + spalte_breit(i, c)
                    c = c + 1
                }
            }
            return
        }
        let r: u64 = row_under(i, y)
        if r < MAXWD {
            let jetzt: u64 = ticks()
            var doppelt: bool = false
            if s_lastwd == i + 1 && s_lastclick != 0 {
                if jetzt - s_lastclick < 100 && g(i, D_VAL) == r {
                    doppelt = true
                }
            }
            s(i, D_VAL, r)
            s_lastclick = jetzt
            s_lastwd = i + 1
            dirty_wd(i)
            if doppelt || (g(i, D_FLAGS) & F_EINKLICK) != 0 {
                fire(i, K_LIST, r, w)
                s_lastclick = 0
            } else if (btn & 2) != 0 {
                // DIE RECHTE TASTE IST BIT 1 UND NICHT BIT 2. Der
                // PS/2-Baustein legt links auf Bit 0, RECHTS auf Bit 1
                // und die Mitte auf Bit 2 (`kernel/ps2m.fi`); der
                // QEMU-Monitor nimmt fuer `mouse_button` dieselbe
                // Reihenfolge (1 links, 2 rechts, 4 Mitte). Die erste
                // Fassung dieser Zeile pruefte auf 4 -- das ist die
                // MITTLERE Taste, und das Kontextmenue klappte nie auf,
                // ohne dass irgendwo ein Fehler stand.
                fire(i, K_SCROLL, r, w)
            }
        }
        return
    }
    if k == K_TABS {
        var tx: u64 = g(i, D_X)
        var t: u64 = 0
        while t < 12 {
            let tw: u64 = tab_breite(i, t)
            if tw == 0 {
                t = 12
            } else if x >= tx && x < tx + tw {
                if g(i, D_VAL) != t {
                    s(i, D_VAL, t)
                    dirty_wd(i)
                    fire(i, K_TABS, t, w)
                }
                t = 12
            } else {
                tx = tx + tw
                t = t + 1
            }
        }
        return
    }
    if k == K_MENUBAR {
        var tx: u64 = g(i, D_X) + 4
        var t: u64 = 0
        while t < 8 {
            let q: u64 = row_at(g(i, D_TEXT), t)
            if q == 0 {
                t = 8
            } else {
                let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                    row_len(q)) + 16
                if x >= tx && x < tx + tw {
                    s(i, D_VAL, t + 1)
                    dirty_wd(i)
                    fire(i, K_MENUBAR, 0x1000 + t, w)
                    t = 8
                } else {
                    tx = tx + tw
                    t = t + 1
                }
            }
        }
        return
    }
    if k == K_CHOICE {
        fire(i, K_CHOICE, 0x1000, w)
        return
    }
}

fn on_up(w: u64, x: u64, y: u64) {
    if s_down != 0 {
        let i: u64 = s_down - 1
        s_down = 0
        if g(i, D_KIND) == K_LEINWAND {
            lw_push(i, LE_UP, (sub(x, g(i, D_X)) << 16) | sub(y, g(i, D_Y)),
                0)
            return
        }
        if g(i, D_KIND) == K_SLIDER {
            s(i, D_FLAGS, g(i, D_FLAGS) & ~F_PRESSED)
            dirty_wd(i)
            fire(i, K_SLIDER, g(i, D_VAL), w)
            return
        }
        if g(i, D_KIND) == K_BILD {
            fire(i, K_BILD, 0, w)
            return
        }
        if g(i, D_KIND) == K_BUTTON {
            s(i, D_FLAGS, g(i, D_FLAGS) & ~F_PRESSED)
            dirty_wd(i)
            // Nur, wenn losgelassen wurde, WO gedrueckt wurde -- so wie
            // jeder Knopf seit vierzig Jahren.
            if hit_at(w, x, y) == i {
                fire(i, K_BUTTON, 0, w)
            }
        }
    }
}

fn on_move(w: u64, x: u64, y: u64, btn: u64) {
    if ng(w, N_KIND) == NK_MENU {
        let zh: u64 = zeilen_hoehe() + 2
        var k: u64 = ng(w, N_CNT)
        if y >= 2 {
            k = (y - 2) / zh
        }
        if k < ng(w, N_CNT) && ng(w, N_VAL) != k + 1 {
            ns(w, N_VAL, k + 1)
            dirty_all(w)
        }
        return
    }
    let i: u64 = hit_at(w, x, y)
    // RUNDE CERTUS-AUF-OSUM: die Leinwand sieht jede Bewegung ueber ihr
    // (ein ueberfahrener Verweis will das wissen); zusammengefasst im
    // Ring, siehe `lw_push`.
    if i < MAXWD && g(i, D_KIND) == K_LEINWAND {
        lw_push(i, LE_MOVE, ((x - g(i, D_X)) << 16) | (y - g(i, D_Y)), btn)
    }
    // Das Zeigerbild: ueber einem Textfeld ein Balken, sonst ein Pfeil.
    // Es ist der einzige Weg, auf dem eine Anwendung dem SERVER etwas
    // ueber den Zeiger sagt, und deshalb steht er im Logbuch.
    if i < MAXWD && g(i, D_KIND) == K_ENTRY {
        wlibc.cursor_shape(1)
    } else {
        wlibc.cursor_shape(0)
    }
    // Ziehen im Textfeld waehlt aus. Umschalt-Pfeil gibt es hier nicht:
    // die Zeilendisziplin liefert das FERTIGE Zeichen, die Umschalttaste
    // kommt nie als eigenes Ereignis an. Also waehlt die Maus.
    if s_down != 0 && (btn & 1) != 0 {
        let dd: u64 = s_down - 1
        if g(dd, D_KIND) == K_SLIDER {
            slider_setz(dd, x)
            fire(dd, K_SLIDER, g(dd, D_VAL), w)
            return
        }
        if g(dd, D_KIND) == K_BILD {
            if g(dd, D_WZ) == 1 {
                s_aus_x1 = bild_px(dd, x)
                s_aus_y1 = bild_py(dd, y)
                dirty_wd(dd)
                return
            }
            bild_schieben(dd, x -% s_dragx, y -% s_dragy)
            s_dragx = x
            s_dragy = y
            return
        }
    }
    if s_down != 0 && (btn & 1) != 0 {
        let d: u64 = s_down - 1
        // MERGE-8: hier stand TON-2s Zieh-Zweig fuer den Regler. Runde
        // ALLTAG zieht denselben Regler weiter oben in dieser Funktion
        // (slider_setz) und kehrt dort zurueck.
        if g(d, D_KIND) == K_ENTRY {
            let p: u64 = g(d, D_TEXT)
            let n: u64 = tlen(p)
            // RUNDE I18N: der Sprung ist ein ZEICHEN, nicht ein Oktett
            // -- sonst setzt ein Mausklick die Marke zwischen die
            // beiden Haelften eines Umlauts.
            var at: u64 = 0
            var fertig: bool = false
            while at < n && !fertig {
                let w2: u64 = at + cp_len(p, n, at)
                if entry_x(d, w2) > x {
                    fertig = true
                } else {
                    at = w2
                }
            }
            if at != g(d, D_B) {
                s(d, D_B, at)
                dirty_wd(d)
            }
            return
        }
    }
    var k2: u64 = 0
    while k2 < nwd {
        if g(k2, D_WIN) == w {
            let alt: bool = (g(k2, D_FLAGS) & F_HOVER) != 0
            let neu: bool = k2 == i
            if alt != neu {
                if neu {
                    s(k2, D_FLAGS, g(k2, D_FLAGS) | F_HOVER)
                    // RUNDE DESIGN-2: der Knopf faehrt hoch,
                    // er springt nicht. MO_FAST = 120 ms.
                    let _a1: u64 = anim_start(AN_HOVER, g(k2, D_WIN),
                        k2, wlibc.MO_FAST, EASE_OUT)
                } else {
                    s(k2, D_FLAGS, g(k2, D_FLAGS) & ~F_HOVER)
                    let _a2: u64 = anim_start(AN_HOVER, g(k2, D_WIN),
                        k2, wlibc.MO_FAST, EASE_OUT)
                }
                if g(k2, D_KIND) == K_BUTTON {
                    dirty_wd(k2)
                }
            }
        }
        k2 = k2 + 1
    }
}

// ------------------------------------------------- die Tastatur

// DIE FLUCHTFOLGEN. Die Zeilendisziplin dieses Systems schickt
// Pfeiltasten als `ESC [ D` und Seitentasten als `ESC [ 5 ~` -- so, wie
// ein VT100 es tut und wie `kernel/kbd.fi` es aufsetzt. Ein Ereignis
// traegt EIN Oktett, also steht die Zustandsmaschine hier.
//
// EINE AUSNAHME, und sie ist aelter als diese Runde: die Pfeiltaste
// nach oben kommt als EIN Oktett 14. `kernel/kbd.fi` sagt warum.
fn decode(c: u64) -> u64 {
    if s_esc == 0 {
        if c == 27 {
            s_esc = 1
            return 0
        }
        if c == 14 {
            return KEY_UP
        }
        // RUNDE ALLTAG: DIE EINGABETASTE KOMMT ALS ZEILENVORSCHUB.
        //
        // `KEY_ENTER` ist 13, die Tastatur dieses Systems liefert 10
        // (kernel/kbd.fi, us-Tabelle). Damit hat in JEDEM Fenster die
        // Eingabetaste nichts getan -- kein Knopf, kein Dialog, kein
        // Textfeld. Gemessen an einem Dialog, der sich mit
        // `sendkey ret` nicht schliessen liess. Hier wird aus dem
        // einen das andere, an der einen Stelle, an der alle Tasten
        // vorbeikommen.
        if c == 10 {
            return KEY_ENTER
        }
        return c
    }
    if s_esc == 1 {
        if c == 91 {
            s_esc = 2
            return 0
        }
        s_esc = 0
        return KEY_ESC
    }
    if s_esc == 2 {
        if c >= 48 && c <= 57 {
            s_num = c - 48
            s_mod = 0
            s_esc = 3
            return 0
        }
        s_esc = 0
        if c == 65 {
            return KEY_UP
        }
        if c == 66 {
            return KEY_DOWN
        }
        if c == 67 {
            return KEY_RIGHT
        }
        if c == 68 {
            return KEY_LEFT
        }
        if c == 72 {
            return KEY_HOME
        }
        if c == 70 {
            return KEY_END
        }
        return 0
    }
    // `ESC [ n ~` und `ESC [ n ; m ~`. Der Modifikator m ist der von
    // xterm: 2 = Umschalt, 3 = Alt, 5 = Steuerung, jeweils plus eins.
    if s_esc == 3 {
        if c >= 48 && c <= 57 {
            s_num = s_num * 10 + (c - 48)
            return 0
        }
        if c == 59 {
            s_esc = 4
            return 0
        }
        s_esc = 0
        if c != 126 {
            return 0
        }
        return tilde(s_num, 0)
    }
    if c >= 48 && c <= 57 {
        s_mod = s_mod * 10 + (c - 48)
        return 0
    }
    s_esc = 0
    if c != 126 {
        return 0
    }
    return tilde(s_num, s_mod)
}

fn tilde(n: u64, m: u64) -> u64 {
    if n == 5 {
        return KEY_PGUP
    }
    if n == 6 {
        return KEY_PGDN
    }
    if n == 3 {
        if m == 2 {
            return KEY_SDEL
        }
        return KEY_DEL
    }
    if n == 1 {
        return KEY_HOME
    }
    if n == 4 {
        return KEY_END
    }
    return 0
}

fn next_focus(w: u64, rueckwaerts: bool) {
    var n: u64 = 0
    var erste: u64 = MAXWD
    var letzte: u64 = MAXWD
    var vor: u64 = MAXWD
    var nach: u64 = MAXWD
    let jetzt: u64 = focus_id()
    var i: u64 = 0
    while i < nwd {
        if g(i, D_WIN) == w
            && (g(i, D_FLAGS) & (F_HIDE | F_OFF)) == 0
            && (g(i, D_FLAGS) & F_FOCUSABLE) != 0 {
            if erste == MAXWD {
                erste = i
            }
            letzte = i
            if i < jetzt {
                vor = i
            }
            if i > jetzt && nach == MAXWD {
                nach = i
            }
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 {
        return
    }
    var ziel: u64 = nach
    if rueckwaerts {
        ziel = vor
        if ziel == MAXWD {
            ziel = letzte
        }
    } else if ziel == MAXWD {
        ziel = erste
    }
    set_focus(ziel)
}

fn entry_erase(i: u64) -> bool {
    var a: u64 = g(i, D_B)
    var b: u64 = g(i, D_C)
    if a == b {
        return false
    }
    if a > b {
        let t: u64 = a
        a = b
        b = t
    }
    let p: u64 = g(i, D_TEXT)
    let n: u64 = tlen(p)
    var k: u64 = b
    while k <= n {
        __mmio_write8((p + a + (k - b)) as *mut u8,
            *((p + k) as *mut u8))
        k = k + 1
    }
    s(i, D_B, a)
    s(i, D_C, a)
    return true
}

fn entry_insert(i: u64, c: u64) {
    let p: u64 = g(i, D_TEXT)
    entry_erase(i)
    var n: u64 = tlen(p)
    if n + 1 >= g(i, D_D) {
        return
    }
    let at: u64 = g(i, D_B)
    var k: u64 = n + 1
    while k > at {
        __mmio_write8((p + k) as *mut u8, *((p + k - 1) as *mut u8))
        k = k - 1
    }
    __mmio_write8((p + at) as *mut u8, c as u8)
    s(i, D_B, at + 1)
    s(i, D_C, at + 1)
}

// RUNDE I18N: die Laenge des Zeichens, das bei `at` beginnt. Steht
// `at` auf einer Fortsetzung -- was nach dieser Runde nicht mehr
// vorkommen soll --, kommt 1 heraus, und der Zeiger bewegt sich
// wenigstens.
fn cp_len(p: u64, n: u64, at: u64) -> u64 {
    let l: u64 = utf8.seq_len(p, n, at)
    if l == 0 {
        return 1
    }
    return l
}

// Ist dieses OKTETT eines, das in ein Textfeld gehoert? Bis Runde I18N
// hiess das `c >= 32 && c < 127` -- reines ASCII, und jedes Oktett
// eines Umlauts (0xC3, 0xB6) fiel stillschweigend weg. Jetzt: alles ab
// 32 ausser 127. Die Oktette einer Mehr-Oktett-Folge kommen von der
// Tastatur NACHEINANDER und landen dadurch nebeneinander im Feld --
// genau die Folge, die `utf8.next` beim Zeichnen wieder zusammensetzt.
fn druckbar(c: u64) -> bool {
    return c >= 32 && c != 127 && c < 256
}

fn entry_key(i: u64, k: u64) {
    let p: u64 = g(i, D_TEXT)
    let n: u64 = tlen(p)
    // RUNDE I18N: DIE EINFUEGEMARKE SPRINGT UEBER ZEICHEN, NICHT UEBER
    // OKTETTE. `D_B` und `D_C` bleiben OKTETTVERSATZE -- alles andere
    // hier rechnet damit, und `entry_x` misst damit --, aber sie stehen
    // ab jetzt IMMER auf einer Zeichengrenze. Der Pfeil nach links geht
    // sonst mitten in einen Umlaut hinein, und die naechste Taste
    // zerteilt ihn.
    if k == KEY_LEFT {
        s(i, D_B, wlibc.back(p, g(i, D_B)))
        s(i, D_C, g(i, D_B))
    } else if k == KEY_RIGHT {
        if g(i, D_B) < n {
            s(i, D_B, g(i, D_B) + cp_len(p, n, g(i, D_B)))
        }
        s(i, D_C, g(i, D_B))
    } else if k == KEY_HOME {
        s(i, D_B, 0)
        s(i, D_C, 0)
    } else if k == KEY_END {
        s(i, D_B, n)
        s(i, D_C, n)
    } else if k == KEY_BS || k == 127 {
        // GANZ ZURUECK, NICHT EIN OKTETT ZURUECK. Ein Rueckschritt, der
        // ein Oktett loescht, laesst von einem Umlaut die erste Haelfte
        // stehen -- eine kaputte Folge, die als Ersatzzeichen erscheint
        // und beim naechsten Rueckschritt noch eine haesslichere ergibt.
        if !entry_erase(i) {
            if g(i, D_B) > 0 {
                let at: u64 = wlibc.back(p, g(i, D_B))
                let weg: u64 = g(i, D_B) - at
                var q: u64 = at
                while q + weg <= n {
                    __mmio_write8((p + q) as *mut u8,
                        *((p + q + weg) as *mut u8))
                    q = q + 1
                }
                s(i, D_B, at)
                s(i, D_C, at)
            }
        }
    } else if k == KEY_DEL {
        if !entry_erase(i) {
            if g(i, D_B) < n {
                let weg2: u64 = cp_len(p, n, g(i, D_B))
                var q2: u64 = g(i, D_B)
                while q2 + weg2 <= n {
                    __mmio_write8((p + q2) as *mut u8,
                        *((p + q2 + weg2) as *mut u8))
                    q2 = q2 + 1
                }
            }
        }
    } else if k == 1 {
        // STRG-A: alles auswaehlen
        s(i, D_C, 0)
        s(i, D_B, n)
    } else if k == 3 || k == 24 {
        // STRG-C / STRG-X
        var a: u64 = g(i, D_B)
        var b: u64 = g(i, D_C)
        if a > b {
            let t: u64 = a
            a = b
            b = t
        }
        if b > a {
            wlibc.clip_put(p + a, b - a)
            if k == 24 {
                entry_erase(i)
            }
        }
    } else if k == 22 {
        // STRG-V
        var ein: [u8; 128] = [0 as u8; 128]
        let m: u64 = wlibc.clip_take((&ein[0 as usize]) as u64, 127)
        var q3: u64 = 0
        while q3 < m {
            let c: u64 = (ein[(q3) as usize]) as u64
            if druckbar(c) {
                entry_insert(i, c)
            }
            q3 = q3 + 1
        }
    } else if druckbar(k) {
        entry_insert(i, k)
    }
    dirty_wd(i)
}

fn on_key(wein: u64, c: u64) {
    let k: u64 = decode(c)
    if k == 0 {
        return
    }
    s_keylast = k
    s_keyseq = s_keyseq + 1
    // RUNDE ALLTAG: EIN DIALOG IST MODAL, AUCH FUER DIE TASTATUR.
    //
    // Der Fensterserver schickt die Taste an das Fenster mit dem
    // Fokus, und das ist nach `dlg_ask` weiterhin das Hauptfenster --
    // der Dialog ist gerade erst entstanden und noch nicht angeklickt
    // worden. Also landete jede Taste bei der Tabelle darunter, und
    // ein Dialog liess sich mit der Eingabetaste nicht schliessen
    // (gemessen mit `sendkey ret`). Solange einer offen ist, gehoert
    // die Tastatur ihm.
    var w: u64 = wein
    if dl_win != 0xFFFFFFFFFFFFFFFF && ng(dl_win, N_H) != 0 {
        w = dl_win
    } else if mn_win != 0xFFFFFFFFFFFFFFFF && ng(mn_win, N_H) != 0 {
        w = mn_win
    }
    if ng(w, N_KIND) == NK_MENU {
        let zh: u64 = ng(w, N_CNT)
        if k == KEY_DOWN && ng(w, N_VAL) < zh {
            ns(w, N_VAL, ng(w, N_VAL) + 1)
            dirty_all(w)
        } else if k == KEY_UP && ng(w, N_VAL) > 1 {
            ns(w, N_VAL, ng(w, N_VAL) - 1)
            dirty_all(w)
        } else if k == KEY_ENTER && ng(w, N_VAL) > 0 {
            fire(ng(w, N_OWNER), K_MENUBAR, ng(w, N_VAL) - 1, w)
        } else if k == KEY_ESC {
            ns(w, N_VAL, 0)
            fire(ng(w, N_OWNER), K_MENUBAR, 0xFFFF, w)
        }
        return
    }
    // EIN DIALOG HAT ZWEI TASTEN, und beide muessen ohne Maus gehen:
    // Eingabe ist "ja", Flucht ist "nein". Sein Textfeld bekommt alles
    // andere -- der Fokus liegt nach `dlg_open` darauf, nach `dlg_ask`
    // gibt es keines.
    if ng(w, N_KIND) == NK_DLG {
        if k == KEY_ENTER {
            fire(dl_ok, K_BUTTON, 0, w)
            return
        }
        if k == KEY_ESC {
            fire(dl_no, K_BUTTON, 0, w)
            return
        }
        if dl_ent < MAXWD {
            entry_key(dl_ent, k)
        }
        return
    }
    if k == KEY_TAB {
        next_focus(w, false)
        return
    }
    let i: u64 = focus_id()
    if i >= MAXWD || g(i, D_WIN) != w {
        return
    }
    let kind: u64 = g(i, D_KIND)
    if kind == K_ENTRY {
        if k == KEY_ENTER {
            fire(i, K_ENTRY, 0, w)
            return
        }
        entry_key(i, k)
        return
    }
    if kind == K_LEINWAND {
        lw_push(i, LE_KEY, k, 0)
        return
    }
    if kind == K_BUTTON {
        if k == KEY_ENTER || k == 32 {
            fire(i, K_BUTTON, 0, w)
        }
        return
    }
    if kind == K_TILE {
        if k == KEY_ENTER || k == 32 {
            fire(i, K_TILE, 0, w)
        }
        return
    }
    if kind == K_CHECK {
        if k == KEY_ENTER || k == 32 {
            s(i, D_VAL, 1 - g(i, D_VAL))
            dirty_wd(i)
            fire(i, K_CHECK, g(i, D_VAL), w)
        }
        return
    }
    // RUNDE TON-2: der Regler an der Tastatur. Links/rechts eine
    // Stufe, Pos1/Ende an die Enden -- dieselben Tasten, die jedes
    // andere System dafuer nimmt, und die einzige Art, ihn ohne Maus
    // zu bedienen.
    if kind == K_SLIDER {
        var v: u64 = g(i, D_VAL)
        let schritt: u64 = g(i, D_A)
        var neu: u64 = v
        if k == KEY_LEFT || k == KEY_DOWN {
            neu = sub(v, schritt)
        } else if k == KEY_RIGHT || k == KEY_UP {
            neu = v + schritt
            if neu > 100 {
                neu = 100
            }
        } else if k == KEY_HOME {
            neu = 0
        } else if k == KEY_END {
            neu = 100
        } else {
            return
        }
        if neu != v {
            s(i, D_VAL, neu)
            dirty_wd(i)
            fire(i, K_SLIDER, neu, w)
        }
        return
    }
    if kind == K_LIST || kind == K_TABLE {
        var ganz: u64 = g(i, D_A)
        if kind == K_TABLE {
            ganz = sub(ganz, 1)
        }
        if ganz == 0 {
            return
        }
        var v: u64 = g(i, D_VAL)
        if k == KEY_DOWN && v + 1 < ganz {
            v = v + 1
        } else if k == KEY_UP && v > 0 {
            v = v - 1
        } else if k == KEY_HOME {
            v = 0
        } else if k == KEY_END {
            v = ganz - 1
        } else if k == KEY_PGDN {
            v = imin(v + 10, ganz - 1)
        } else if k == KEY_PGUP {
            v = sub(v, 10)
        } else if k == KEY_ENTER {
            fire(i, K_LIST, v, w)
            return
        } else {
            return
        }
        s(i, D_VAL, v)
        scroll_to(i, v)
        dirty_wd(i)
        return
    }
    if kind == K_TABS {
        if k == KEY_RIGHT && tab_breite(i, g(i, D_VAL) + 1) != 0 {
            s(i, D_VAL, g(i, D_VAL) + 1)
            dirty_wd(i)
            fire(i, K_TABS, g(i, D_VAL), w)
        } else if k == KEY_LEFT && g(i, D_VAL) > 0 {
            s(i, D_VAL, g(i, D_VAL) - 1)
            dirty_wd(i)
            fire(i, K_TABS, g(i, D_VAL), w)
        }
        return
    }
    if kind == K_CHOICE {
        if k == KEY_ENTER || k == 32 {
            fire(i, K_CHOICE, 0x1000, w)
        }
        return
    }
}

// ==================================================================
// MENUES UND DIALOGE
//
// BEIDE SIND EIGENE FENSTER BEIM SERVER, und das ist keine Notloesung,
// sondern die einzige richtige Antwort in diesem System: ein
// Kontextmenue, das in das Fenster gemalt wird, endet an dessen Rand.
// Ein Menue am unteren Rand einer Liste waere abgeschnitten. Der
// Fensterserver hat Fenster, also bekommt ein Menue eines.
//
// WAS DAS KOSTET: ein Menue hat eine Titelleiste und einen Rahmen wie
// jedes Fenster (`kernel/wm.fi` malt sie). Ein Server mit einem
// Fenstertyp OHNE Zierrat waere die Antwort darauf; er steht in
// docs/ROUNDK15.md unter dem, was offen bleibt.

static mut mn_win: u64 = 0xFFFFFFFFFFFFFFFF
static mut mn_res: u64 = 0xFFFFFFFFFFFFFFFF

fn menu_open(owner: u64, sx: u64, sy: u64, items: u64, n: u64) -> u64 {
    if mn_win != 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    // ROUND LOOK, THIRD ADDENDUM: THIS TITLE IS DRAWN.
    //
    // A menu window carries a 22-pixel title bar (tools/k15/run.sh
    // computes its rows as MNY + TITLE + 15), so this string is on the
    // screen -- and it sat here in German, hardcoded, in the widget
    // library. `tools/i18n/scan.py` never saw it: it said "Menue", and
    // "Menue" was not in that scanner's word list.
    //
    // wlib cannot read the catalogue itself. It is linked into all
    // thirteen programs, and pulling `msg` in here would put a
    // catalogue into `sh` and `ls` as well -- on a disk that ran out of
    // room in this very round. So the LIBRARY carries the untranslated
    // English, exactly as msg.fi does for a missing key, and a program
    // that has a catalogue hands the translation down with
    // `set_menu_title`.
    var titel: [u8; 6] = "Menu\0\0"
    var tp: u64 = (&titel[0 as usize]) as u64
    if mn_titel != 0 {
        tp = mn_titel
    }
    let zh: u64 = zeilen_hoehe() + 2
    var bw: u64 = 60
    var k: u64 = 0
    while k < n {
        let q: u64 = row_at(items, k)
        if q != 0 {
            let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                row_len(q)) + 24
            if tw > bw {
                bw = tw
            }
        }
        k = k + 1
    }
    let bh: u64 = n * zh + 4
    // Ein Menue, das unten aus dem Bild laeuft, klappt nach oben auf --
    // deshalb kennt diese Bibliothek die Bildschirmgroesse.
    var y: u64 = sy
    if y + bh + 24 > wlibc.screen_h() {
        y = sub(sy, bh + 24)
    }
    var x: u64 = sx
    if x + bw + 4 > wlibc.screen_w() {
        x = sub(wlibc.screen_w(), bw + 4)
    }
    let w: u64 = new_win(x, y, bw, bh, tp, NK_MENU)
    // RUNDE DESIGN-2: das Menue klappt auf. Ganzes Fenster, also
    // MAXWD als Widget -- `anim_tick` macht daraus `dirty_all`.
    let _a4: u64 = anim_start(AN_MENU, w, MAXWD, wlibc.MO_FAST,
        EASE_OUT)
    if w >= MAXWN {
        return MAXWN
    }
    ns(w, N_DATA, items)
    ns(w, N_CNT, n)
    ns(w, N_VAL, 0)
    ns(w, N_OWNER, owner)
    mn_win = w
    mn_res = 0xFFFFFFFFFFFFFFFF
    dirty_all(w)
    return w
}

// Was gewaehlt wurde. 0xFFFF heisst abgebrochen, 0xFFFFFFFF... heisst
// "noch offen".
fn menu_at() -> u64 {
    return mn_res
}

fn menu_close() {
    if mn_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    close(mn_win)
    // Der Platz wird wieder frei: ein Programm, das zwanzig Menues
    // aufklappt, soll nicht nach vier stehenbleiben.
    if mn_win + 1 == nwn {
        nwn = nwn - 1
    }
    mn_win = 0xFFFFFFFFFFFFFFFF
}

static mut dl_win: u64 = 0xFFFFFFFFFFFFFFFF
static mut dl_state: u64 = 0
static mut dl_ok: u64 = 0
static mut dl_no: u64 = 0
static mut dl_ent: u64 = MAXWD
static mut dl_lbl: u64 = 0

fn dlg_text() -> u64 {
    return (&dlgbuf[0 as usize]) as u64
}

// 0 = keiner offen, 1 = offen, 2 = bestaetigt, 3 = abgebrochen
fn dlg_state() -> u64 {
    return dl_state
}

fn dlg_open(titel: u64, frage: u64, anfang: u64) -> u64 {
    return dlg_new(titel, frage, anfang, true)
}

fn dlg_ask(titel: u64, frage: u64) -> u64 {
    return dlg_new(titel, frage, 0, false)
}

// Die Beschriftungen der beiden Knoepfe liegen STATISCH, und der
// Uebersetzer besteht darauf: `button` behaelt den Zeiger ueber das
// Ende von `dlg_new` hinaus, und ein Zeiger in einen abgeraeumten
// Rahmen waere genau die Sorte Fehler, die man erst im Bild sieht.
static mut d_ok: [u8; 3] = "OK\0"
static mut d_ja: [u8; 3] = "Ja\0"
static mut d_ab: [u8; 10] = "Abbrechen\0"
static mut d_nein: [u8; 5] = "Nein\0"

fn dlg_new(titel: u64, frage: u64, anfang: u64, mit_feld: bool) -> u64 {
    if dl_win != 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    let bw: u64 = 340
    var bh: u64 = 108
    if !mit_feld {
        bh = 84
    }
    let x: u64 = sub(wlibc.screen_w(), bw) / 2
    let y: u64 = sub(wlibc.screen_h(), bh) / 2
    let w: u64 = new_win(x, y, bw, bh, titel, NK_DLG)
    if w >= MAXWN {
        return MAXWN
    }
    dl_win = w
    dl_state = 1
    var i: u64 = 0
    while i < 160 {
        dlgbuf[(i) as usize] = 0 as u8
        i = i + 1
    }
    if anfang != 0 {
        ulib.strncpy((&dlgbuf[0 as usize]) as u64, anfang, 158)
    }
    box_v(w, 0, 0, bw, bh, 12, 10)
    size(0, wlibc.text_h(wlibc.px_ui()))
    dl_lbl = label(frage)
    dl_ent = MAXWD
    if mit_feld {
        size(0, wlibc.metric(wlibc.M_CTRL_H))
        dl_ent = entry((&dlgbuf[0 as usize]) as u64, 158)
        set_focus(dl_ent)
    }
    let unten: u64 = cg(ctcur, C_CY)
    box_end()
    box_h(w, sub(bw, 220), unten, 208, 30, 0, 10)
    size(dlg_btn_w(), wlibc.metric(wlibc.M_CTRL_H) + 2)
    if mit_feld {
        dl_ok = button((&d_ok[0 as usize]) as u64)
    } else {
        dl_ok = button((&d_ja[0 as usize]) as u64)
    }
    size(dlg_btn_w(), wlibc.metric(wlibc.M_CTRL_H) + 2)
    if mit_feld {
        dl_no = button((&d_ab[0 as usize]) as u64)
    } else {
        dl_no = button((&d_nein[0 as usize]) as u64)
    }
    box_end()
    dirty_all(w)
    return w
}

fn dlg_close() {
    if dl_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    close(dl_win)
    if dl_win + 1 == nwn {
        nwn = nwn - 1
    }
    dl_win = 0xFFFFFFFFFFFFFFFF
    dl_state = 0
    // Die Widgets des Dialogs sind verborgen; ihre Plaetze werden
    // wieder frei, wenn sie am Ende der Tafel liegen.
    while nwd > 0 && (g(nwd - 1, D_FLAGS) & F_HIDE) != 0 {
        nwd = nwd - 1
    }
    if s_focus != 0 && s_focus - 1 >= nwd {
        s_focus = 0
        var i: u64 = 0
        while i < nwd {
            if (g(i, D_FLAGS) & F_FOCUSABLE) != 0 && s_focus == 0 {
                s_focus = i + 1
            }
            i = i + 1
        }
    }
}

// ==================================================================
// DIE EREIGNISSCHLEIFE
//
// EIN Aufruf holt die Ereignisse ALLER Fenster ab, verteilt sie, malt
// nach, was schmutzig geworden ist, und gibt die Nummer des Widgets
// zurueck, bei dem etwas passiert ist -- oder MAXWD.
//
// SIE GIBT DIE MASCHINE HER, wenn nichts anliegt. Das steht hier, weil
// Runde K10 genau daran gescheitert ist: eine Warteschleife, die nicht
// abgibt, laesst die andere Aufgabe nicht laufen, und im
// Bildschirmfoto fehlt dann etwas, ohne dass irgendwo ein Fehler steht.

// ================================================== RUNDE THEME
//
// DAS UMSCHALTEN ZUR LAUFZEIT, VON DER SEITE DES FENSTERS AUS.
//
// Ein Programm mit dieser Bibliothek muss dafuer NICHTS tun: `step()`
// sieht zehnmal in der Sekunde nach, ob sich die aufgeloesten Marken
// geaendert haben, und wenn ja, ist alles schmutzig. Zehnmal und nicht
// bei jedem Durchlauf, weil ein Nachsehen drei Dateien liest und den
// ganzen Satz neu aufloest; die Verzoegerung, die das kostet, steht
// gemessen in docs/ROUNDTHEME.md und wird nicht kleingeredet.
const THEME_POLL_TICKS: u64 = 25

fn theme_watch() -> bool {
    let t: u64 = ticks()
    if t < s_thpoll + THEME_POLL_TICKS {
        return false
    }
    s_thpoll = t
    s_thpolls = s_thpolls + 1
    if !wlibc.theme_poll() {
        return false
    }
    s_thswitch = s_thswitch + 1
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            dirty_all(w)
        }
        w = w + 1
    }
    return true
}

// Sofort nachsehen, ohne auf den Takt zu warten. Der Testlaeufer
// braucht das, um eine Zeit zu messen, in der kein Warten steckt.
fn theme_now() -> bool {
    s_thpoll = 0
    return theme_watch()
}

fn theme_switches() -> u64 {
    return s_thswitch
}

fn theme_polls() -> u64 {
    return s_thpolls
}

fn theme_pixels() -> u64 {
    return s_thpx
}

fn theme_stales() -> u64 {
    return s_thstale
}

// Alle Fenster neu malen und die Flaeche zurueckgeben. EINE Stelle,
// damit die Zahl aus der Messung und die Zahl aus dem Betrieb dieselbe
// Rechnung sind.
fn paint_all() -> u64 {
    let vor: u64 = wlibc.theme_frame_begin()
    let _v: u64 = vor
    var gemalt: u64 = 0
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            gemalt = gemalt + flush_win(w)
        }
        w = w + 1
    }
    // DAS THEMA HAT SICH WAEHREND DES MALENS GEDREHT. Das Bild, das
    // gerade fertig geworden ist, ist in sich stimmig -- es hat die
    // ganze Zeit aus derselben Bank gelesen -- aber es ist nicht mehr
    // das aktuelle. Also genau EINMAL noch, mit der neuen Bank; ein
    // zweites Mal kann es nicht noetig werden, weil der naechste
    // Durchlauf wieder frisch einrastet.
    if wlibc.theme_frame_end() {
        s_thstale = s_thstale + 1
        let _v2: u64 = wlibc.theme_frame_begin()
        w = 0
        while w < nwn {
            if ng(w, N_H) != 0 {
                dirty_all(w)
                gemalt = gemalt + flush_win(w)
            }
            w = w + 1
        }
        let _e2: bool = wlibc.theme_frame_end()
    }
    return gemalt
}

fn step() -> u64 {
    s_fired = 0
    s_fkind = 0
    s_findex = 0
    s_ticks = s_ticks + 1
    var etwas: bool = false
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            var n: u64 = 0
            while n < 64 && wlibc.sys3w(wlibc.WM_EVENT, ng(w, N_H),
                (&ev[0 as usize]) as u64, 0) == 1 {
                etwas = true
                n = n + 1
                let b: u64 = (&ev[0 as usize]) as u64
                let typ: u64 = __mmio_read64((b) as *mut u64)
                let d: u64 = __mmio_read64((b + 8) as *mut u64)
                let ex: u64 = (d >> 32) & 0xFFFF
                let ey: u64 = (d >> 16) & 0xFFFF
                let btn: u64 = d & 0xFFFF
                if typ == wlibc.EV_DOWN {
                    on_down(w, ex, ey, btn)
                } else if typ == wlibc.EV_UP {
                    on_up(w, ex, ey)
                } else if typ == wlibc.EV_MOVE {
                    on_move(w, ex, ey, btn)
                } else if typ == wlibc.EV_KEY {
                    on_key(w, ex)
                } else if typ == wlibc.EV_CLOSE {
                    ns(w, N_H, 0)
                    if w == mn_win {
                        mn_res = 0xFFFF
                    } else if w == dl_win {
                        dl_state = 3
                    } else if ng(w, N_KIND) == NK_MAIN {
                        s_alive = 0
                    }
                } else if typ == wlibc.EV_RESIZE {
                    ns(w, N_W, ex)
                    ns(w, N_HH, ey)
                    relayout()
                    dirty_all(w)
                }
            }
        }
        w = w + 1
    }
    // Ein Menue, bei dem etwas gewaehlt wurde, schliesst sich selbst --
    // ein Menue, das nach der Wahl stehenbleibt, ist keines.
    if mn_win != 0xFFFFFFFFFFFFFFFF && s_fired != 0 {
        if s_fwin == mn_win {
            mn_res = s_findex
            let besitzer: u64 = s_fired - 1
            menu_close()
            if mn_res == 0xFFFF {
                s_fired = 0
            } else {
                s_fired = besitzer + 1
                s_fkind = K_MENUBAR
                s_findex = mn_res
            }
        }
    }
    // Der Dialog: die beiden Knoepfe sind seine Antwort.
    if dl_win != 0xFFFFFFFFFFFFFFFF && s_fired != 0 {
        let i: u64 = s_fired - 1
        if i == dl_ok {
            dl_state = 2
            s_fired = 0
        } else if i == dl_no {
            dl_state = 3
            s_fired = 0
        } else if i == dl_ent && s_fkind == K_ENTRY {
            dl_state = 2
            s_fired = 0
        }
    }
    let gewechselt: bool = theme_watch()
    // RUNDE DESIGN-2: die Bewegungen VOR dem Malen weiterdrehen. Wer
    // sie danach dreht, malt jedes Zwischenbild einen Durchlauf zu
    // spaet -- bei 150 ms sind das bei zehn Bildern zehn Prozent.
    let laufend: u64 = anim_tick()
    let gemalt: u64 = paint_all()
    if gewechselt {
        s_thpx = s_thpx + gemalt
    }
    // Eine laufende Bewegung ist ETWAS. Ohne diese Zeile schlaeft die
    // Schleife mitten in einer Animation ein und das Fenster bleibt auf
    // halbem Weg stehen, bis die Maus wackelt.
    if !etwas && gemalt == 0 && laufend == 0 {
        ulib.sys(ulib.SYS_YIELD, 0, 0, 0)
    }
    if s_fired == 0 {
        return MAXWD
    }
    return s_fired - 1
}

// ==================================================================
// WAS DIE ANORDNUNG AUSGERECHNET HAT -- UND WOHIN DER TEXT KOMMT
//
// Diese acht Funktionen sind fuer die MESSUNG da und fuer nichts
// sonst. Sie geben dieselben Zahlen zurueck, mit denen `paint_*` malt
// -- nicht aehnliche, dieselben: jede steht als Ausdruck genau einmal,
// hier und dort, und wer eine der beiden aendert, macht den Testlauf
// rot statt ihn zu belegen.
//
// Ohne sie muesste ein Testlaeufer die Grundlinie eines Knopftextes
// selbst ausrechnen -- also die Anordnung nachbauen --, und dann pruefte
// er seinen eigenen Nachbau. So sagt die Anwendung, wo sie es
// hinschreibt, und der Laeufer rechnet im BILD nach, ob es dort steht.

fn rect_x(i: u64) -> u64 {
    return g(i, D_X)
}

fn rect_y(i: u64) -> u64 {
    return g(i, D_Y)
}

fn rect_w(i: u64) -> u64 {
    return g(i, D_W)
}

fn rect_h(i: u64) -> u64 {
    return g(i, D_H)
}

fn kind_of(i: u64) -> u64 {
    return g(i, D_KIND)
}

fn row_h() -> u64 {
    return zeilen_hoehe()
}

fn text_x(i: u64) -> u64 {
    let k: u64 = g(i, D_KIND)
    if k == K_BUTTON {
        let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), g(i, D_TEXT),
            tlen(g(i, D_TEXT)))
        return g(i, D_X) + sub(g(i, D_W), tw) / 2
    }
    if k == K_ENTRY {
        return g(i, D_X) + 5
    }
    if k == K_CHECK {
        return g(i, D_X) + 20
    }
    return g(i, D_X)
}

fn text_base(i: u64) -> u64 {
    let k: u64 = g(i, D_KIND)
    let asc: u64 = wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    if k == K_LABEL {
        return g(i, D_Y) + asc
    }
    return g(i, D_Y) + (g(i, D_H) + asc) / 2
}

fn text_fg(i: u64) -> u64 {
    if (g(i, D_FLAGS) & F_OFF) != 0 {
        return wlibc.theme(wlibc.T_DIM)
    }
    return wlibc.theme(wlibc.T_FG)
}

// Die Farbe UNTER dem Text. Sie gehoert zur Messung, weil ein
// kantengeglaettetes Zeichen aus Mischungen zwischen beiden besteht --
// ohne den Hintergrund ist keine einzige Zwischenstufe nachzurechnen.
fn text_bg(i: u64) -> u64 {
    let k: u64 = g(i, D_KIND)
    if k == K_BUTTON {
        if (g(i, D_FLAGS) & F_PRESSED) != 0 {
            return wlibc.theme(wlibc.T_BTNDN)
        }
        if (g(i, D_FLAGS) & F_HOVER) != 0 {
            return wlibc.theme(wlibc.T_BTNHI)
        }
        return wlibc.theme(wlibc.T_BTN)
    }
    if k == K_ENTRY {
        return wlibc.theme(wlibc.T_ENTRY)
    }
    if k == K_CHOICE {
        return wlibc.theme(wlibc.T_BTN)
    }
    if g(i, D_WIN) < MAXWN && ng(g(i, D_WIN), N_KIND) == NK_DLG {
        return wlibc.theme(wlibc.T_DLG)
    }
    return wlibc.theme(wlibc.T_BG)
}

// Die Grundlinie der SICHTBAREN Zeile `r` einer Liste, und die Stelle,
// an der ihr Text anfaengt. Genau die Rechnung aus `paint_list`.
fn row_base(i: u64, r: u64) -> u64 {
    let zh: u64 = zeilen_hoehe()
    return g(i, D_Y) + 2 + r * zh
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()) + 1
}

fn row_x(i: u64) -> u64 {
    return g(i, D_X) + 6 + list_ein(i)
}

// Wo das Symbolplaettchen einer sichtbaren Zeile liegt.
fn icon_x(i: u64) -> u64 {
    return g(i, D_X) + 3 + 2 * wlibc.ui_scale()
}

// RUNDE ECHTHARDWARE-2: SENKRECHT MITTIG IN DER ZEILE.
//
// Hier stand `+ 3` -- ein fester Abstand von oben. Bei doppelter
// Vervielfachung ist die Zeile hoeher UND das Symbol groesser, und
// eine feste 3 setzt es dann zu hoch: auf Justins Foto sitzt das
// Ordnersymbol sichtbar ueber der Schriftlinie. Gerechnet wird
// stattdessen die Mitte der Zeile, wie es der Knopf in der Taskleiste
// seit dieser Runde auch tut.
fn icon_y(i: u64, r: u64) -> u64 {
    let zh: u64 = zeilen_hoehe()
    let ih: u64 = wlibc.icon_small()
    var oben: u64 = 3
    if zh > ih {
        oben = (zh - ih) / 2
    }
    return g(i, D_Y) + 2 + r * zh + oben
}

// Wo der Buchstabe auf dem Plaettchen anfaengt und auf welcher
// Grundlinie er sitzt -- fuer die Messung, genau die Ausdruecke von oben.
fn icon_letter_x(i: u64, p: u64) -> u64 {
    return g(i, D_X) + 5 + sub(14, wlibc.text_w(wlibc.F_UI, wlibc.px_ui(),
        p, 1)) / 2
}

fn icon_letter_base(i: u64, r: u64) -> u64 {
    return g(i, D_Y) + 2 + r * zeilen_hoehe() + 15
}

// DIE TABELLE HAT IHRE EIGENE RECHNUNG, und diese drei Funktionen sind
// der Grund, warum sie hier steht: die erste Fassung des Dateimanagers
// meldete die Grundlinie einer Tabellenzeile als "die einer Liste plus
// Kopfhoehe" -- und lag um EINEN Bildpunkt daneben. Im Bild sah man
// nichts (der Text stand ja da), im Pruefer standen 219 von 304
// Tintenpunkten falsch, und die Ursache war keine Farbe, sondern eine
// Zeile: `paint_list` setzt bei `y + 2`, `paint_table` bei
// `y + kopf + 1`. Jetzt steht jede der beiden Rechnungen genau einmal.
fn head_h(i: u64) -> u64 {
    return zeilen_hoehe() + 4
}

fn head_base(i: u64) -> u64 {
    return g(i, D_Y) + 3 + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
}

fn cell_base(i: u64, r: u64) -> u64 {
    return g(i, D_Y) + head_h(i) + 1 + r * zeilen_hoehe()
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()) + 1
}

fn cell_x(i: u64, c: u64) -> u64 {
    var x: u64 = g(i, D_X) + 6
    var k: u64 = 0
    while k < c && k < g(i, D_C) {
        x = x + spalte_breit(i, k)
        k = k + 1
    }
    // ROUND ICONS: the first column starts behind the icon.  Only the
    // first -- a table whose every column shifted would have its header
    // over the wrong data, and `paint_table` does the same thing here.
    if c == 0 {
        x = x + table_ein(i)
    }
    return x
}

// Welche Widgetnummer die beiden Knoepfe eines Dialogs haben, und in
// welchem Fenster er liegt. Fuer die MESSUNG: ein Testlaeufer, der die
// Stelle des Knopfes selbst ausrechnet, rechnet die Anordnung nach --
// und prueft dann seinen eigenen Nachbau.
fn dlg_button(welcher: u64) -> u64 {
    if welcher == 0 {
        return dl_ok
    }
    return dl_no
}

fn dlg_label() -> u64 {
    return dl_lbl
}

fn dlg_win() -> u64 {
    if dl_win == 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    return dl_win
}

fn menu_win() -> u64 {
    if mn_win == 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    return mn_win
}


// ==================================================== RUNDE SYSTEMBUS
//
// DURCHREICHE, und mehr soll es nicht sein. Was hier steht, ist keine
// zweite Zwischenablage, sondern der Weg dorthin -- damit eine
// Anwendung eine Zeile schreibt und nicht einen Systemruf baut.

fn clip_put(p: u64, n: u64) -> u64 {
    return wlibc.clip_put(p, n)
}

fn clip_put_typ(typen: u64, p: u64, n: u64) -> u64 {
    return wlibc.clip_put_typ(typen, p, n)
}

fn clip_take(p: u64, max: u64) -> u64 {
    return wlibc.clip_take(p, max)
}

fn clip_hist_take(zurueck: u64, p: u64, max: u64) -> u64 {
    return wlibc.clip_hist_take(zurueck, p, max)
}

fn clip_hist_count() -> u64 {
    return wlibc.clip_hist_count()
}

fn clip_hist_typ(zurueck: u64) -> u64 {
    return wlibc.clip_hist_typ(zurueck)
}

fn clip_hist_owner(zurueck: u64) -> u64 {
    return wlibc.clip_hist_owner(zurueck)
}

fn drag_put(typen: u64, p: u64, n: u64) -> u64 {
    return wlibc.drag_put(typen, p, n)
}

fn drag_take(p: u64, max: u64) -> u64 {
    return wlibc.drag_take(p, max)
}

fn drag_an() -> bool {
    return wlibc.drag_an()
}

fn drag_weg() -> u64 {
    return wlibc.drag_weg()
}

fn noti_post(dringlich: u64, p: u64, n: u64) -> u64 {
    return wlibc.noti_post(dringlich, p, n)
}

fn noti_count() -> u64 {
    return wlibc.noti_count()
}

fn noti_neu() -> u64 {
    return wlibc.noti_neu()
}

fn noti_take(zurueck: u64, p: u64, max: u64) -> u64 {
    return wlibc.noti_take(zurueck, p, max)
}
