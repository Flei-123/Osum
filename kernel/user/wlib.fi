    clip_put, clip_put_typ, clip_take, clip_hist_take, clip_hist_count,
    clip_hist_typ, clip_hist_owner,
    drag_put, drag_take, drag_an, drag_weg,
    noti_post, noti_count, noti_neu, noti_take,
    CT_TEXT, CT_PATH, CT_HTML, CT_IMAGE, CT_FILES
, win_keys}

const CT_TEXT: u64 = 1
const CT_PATH: u64 = 2
const CT_HTML: u64 = 4
const CT_IMAGE: u64 = 8
const CT_FILES: u64 = 16

// ------------------------------------------------------- die Zahlen

// ROUND THEMESTORE: 160 AND NOT 96, AND `ids` IN settings.fi 128 AND
// NOT 64. The settings program registered 86 widgets and kept only the
// first 64 of them in its tab table -- so every widget from number 65
// on was never hidden, and the Netzzugriff and Sprache pages were laid
// out on TOP of whichever page was showing. That is measured, not
// suspected: `tools/themestore/run.sh` section 5 counts the reported
// rectangles per tab, and the number before this change was 86 on
// every tab. Two limits, one silent overflow each.
const MAXWD: u64 = 160 // Widgets insgesamt
// RUNDE ECHTHARDWARE-2: FUENF UND NICHT VIER -- DIE INFOBLASE BRAUCHT
// EINEN PLATZ.
//
// GEMESSEN, nicht vermutet: der erste Lauf mit der Blase meldete auf
// der Leitung brav `wlib: tip [Terminal -- sh] x=120 y=1324`, und im
// Bild war an dieser Stelle NICHTS -- 0,0 % Tinte auf 300x50
// Bildpunkten. Der Grund steht in `new_win`: bei `nwn >= MAXWN` gibt
// es MAXWN zurueck und malt nicht. Die Leiste hatte ihre vier Plaetze
// schon (Hauptfenster + die Vorschaurahmen), die Blase bekam keinen,
// und der Fehler war still -- `tip_show` hat die Zeile trotzdem
// gedruckt, weil sie VOR dem Anlegen steht.
//
// Genau die Sorte Fehler, die man nur im Bild sieht und nie im Log.
const MAXWN: u64 = 5 // Hauptfenster, Menue, Dialog, Vorschau, Infoblase
const MAXCT: u64 = 24 // Kaesten

const K_LABEL: u64 = 1
const K_BUTTON: u64 = 2
const K_CHECK: u64 = 3
const K_ENTRY: u64 = 4
const K_LIST: u64 = 5
const K_TABLE: u64 = 6
const K_TABS: u64 = 7
const K_MENUBAR: u64 = 8
const K_CHOICE: u64 = 9
const K_SEP: u64 = 10
const K_SCROLL: u64 = 11
// ROUND THEMESTORE: a preview tile. The one widget in this library
// whose colours do NOT come from the running theme -- it draws a
// preset, and a preset is by definition not the thing that is running.
const K_TILE: u64 = 12
// ==================================================== RUNDE TON-2
//
// DER SCHIEBEREGLER. Er kommt in die BIBLIOTHEK und nicht in das
// Programm, und das ist die Regel dieses Projekts und keine Vorliebe:
// ein Lautstaerkeregler, den `/bin/qs` selbst malt, ist ein Programm,
// das an der Bibliothek vorbei zeichnet -- und genau das zaehlt
// `tools/design/messen.py` als Fehler. Der zweite Regler (Helligkeit,
// Mausgeschwindigkeit, Fortschritt) haette ihn ohnehin gebraucht.
//
// WAS ER IST: ein Wert von 0 bis 100 in `D_VAL`, eine Rinne, ein
// Griff. Kein Bruchteil, keine eigene Skala -- Prozent ist genau das,
// was `audset AS_VOLUME` nimmt, und eine zweite Einheit dazwischen
// waere eine Umrechnung, die irgendwann falsch herum steht.
// MERGE-8: hier stand `const K_SLIDER: u64 = 13` aus Runde TON-2 --
// dieselbe 13 wie K_CARD (SOFTUI), und ausserdem ein zweites Mal
// K_SLIDER: Runde ALLTAG bringt denselben Regler als 17 mit. Firn
// nimmt die spaetere Bindung, TON-2s 13 war also schon tot -- aber
// eine tote Nummer, die auf K_CARD zeigt. Eine Art, eine Nummer: 17.
// ==================================================== ROUND SOFTUI
//
// A CARD: A ROUNDED PANEL WITH A SOFT SHADOW AND NO BORDER.
//
// Justin's point 4 -- "Inhalte in Karten gruppiert statt in Rahmen
// gepresst" -- and it is the one point that cannot be done with a
// token.  A radius token makes an existing rectangle round; it cannot
// invent the rectangle that groups four controls, because nothing in
// this library ever drew one.  A frame did that job, and a frame is
// exactly what point 6 says to take away.
//
// So a card is a WIDGET, and it is a widget for a reason worth writing
// down: widgets are painted in the order they were created, so a card
// created before the controls it groups is painted behind them.  There
// is no z-order in this library and this round does not add one -- the
// creation order IS the z-order, and it always was.
//
// ON `classic` A CARD PAINTS NOTHING AT ALL.  Not a rectangle in the
// surface colour, nothing: before this round there were no cards, and
// a card that paints a surface-coloured rectangle over a
// surface-coloured window is a pixel-for-pixel no-op that still costs
// a fill.  `radius_panel == 0` and a loud divider mean classic, and
// classic gets the screen it had.
const K_CARD: u64 = 13
// ================================================== RUNDE WERKZEUGE
// EIN VERLAUFSGRAPH.
//
// Der Aufgabenverwalter zeigt die letzten sechzig Messwerte von
// Prozessorauslastung und Speicher als zwei Kurven. Gezeichnet hat er
// sie zuerst SELBST, nach jedem Anstrich der Bibliothek, und genau das
// ging nicht: `paint_all` malt den Hintergrund jedes schmutzigen
// Rechtecks neu und streicht dabei alles weg, was nicht aus einem
// Widget kommt. Ein Bildschirmfoto trifft dann mit etwa gleicher
// Wahrscheinlichkeit den Zustand VOR oder NACH dem Nachziehen --
// gemessen: derselbe Programmstand, zwei Laeufe, einmal 4 282 gemalte
// Bildpunkte in der Flaeche und einmal 152.
//
// Also ist der Graph ein WIDGET geworden, und damit malt er im selben
// Durchgang wie alles andere. Er bringt keine fremde Bibliothek mit:
// er ist eine Schleife ueber sechzig Zahlen mit `rect` und `hline`.
//
// DIE ZAHLEN GEHOEREN DEM AUFRUFER, genau wie der Puffer hinter einem
// Textfeld und der Block hinter einer Vorschaukachel: `graph(spec)`
// bekommt einen Zeiger auf GRAPH_FIELDS Woerter und liest sie bei
// jedem Anstrich frisch. Diese Bibliothek fuehrt keine Messreihe.
const K_GRAPH: u64 = 14
// RUNDE ALLTAG: ZWEI NEUE BEDIENELEMENTE, UND SIE STEHEN HIER UND NICHT
// IN EINEM PROGRAMM.
//
// Der Bildbetrachter braucht eine Flaeche, auf der ein Bild steht, das
// man vergroessern und schieben kann; das Ausschnittwerkzeug braucht
// dieselbe, um den Ausschnitt zu zeigen; die Einstellungen haetten
// gerne einen Schieberegler. Ein Programm, das sich das selbst malt,
// malt an der Bibliothek vorbei -- und die Regel dieses Projekts ist,
// dass es das nicht gibt. Also: K_BILD und K_SLIDER, gemalt von wlib,
// bedient von wlib, in jedem Farbschema richtig.
const K_BILD: u64 = 16
const K_SLIDER: u64 = 17

// ========================================== RUNDE CERTUS-AUF-OSUM
// EINE LEINWAND: DAS WIDGET, DESSEN BILDPUNKTE DEM AUFRUFER GEHOEREN.
//
// Der Browser Certus malt seine Seite selbst -- Baumbau, Kaskade,
// Layout, Schriftrasterer, alles in lib/paint auf eine eigene Leinwand.
// Was er von dieser Bibliothek braucht, sind die Bedienelemente darum
// herum (Knoepfe, Adressfeld, Reiter) und EIN Rechteck, in dem seine
// Bildpunkte stehen und stehen BLEIBEN: `paint_all` malt den Hintergrund
// jedes schmutzigen Rechtecks neu und streicht dabei weg, was nicht aus
// einem Widget kommt (dieselbe Beobachtung wie beim Graphen oben). Also
// ist die Leinwand ein Widget.
//
// DIE BILDPUNKTE GEHOEREN DEM AUFRUFER, wie der Puffer hinter einem
// Textfeld: `leinwand(px, w, h)` bekommt einen Zeiger auf w*h Woerter zu
// 32 Bit (0x00RRGGBB, im Speicher B, G, R, 0 -- dasselbe Format wie die
// Malflaeche und wie WIG_BLIT) und liest sie bei jedem Anstrich frisch.
// Wer die Bildpunkte geaendert hat, sagt es mit `leinwand_neu`; die
// Bibliothek kopiert dann den Ausschnitt des schmutzigen Streifens
// Zeile fuer Zeile in die Malflaeche.
//
// DIE EINGABE GEHT IN EINEN RING und nicht ueber `fire`: `fire` haelt
// EIN Ereignis je `step`, und ein `step` holt bis zu 64 Ereignisse ab
// -- eine Mausbewegung mit einem Klick dahinter verloere den Klick. Der
// Ring haelt 64 Eintraege zu vier Woertern (Widget, Art, a, b); die
// Bewegungen werden darin ZUSAMMENGEFASST (eine Bewegung ersetzt die
// vorige, solange nichts dazwischen liegt), damit ein Zeiger, der
// ueber die Seite faehrt, den Ring nicht fuellt.
//
// Felder im Widget: D_TEXT = die Bildpunkte, D_A = Breite des Puffers,
// D_B = Hoehe des Puffers, D_C = Zeilenlaenge in Bildpunkten.
const K_LEINWAND: u64 = 15
const LE_DOWN: u64 = 1 // a = (x << 16) | y im Widget, b = Tasten
const LE_UP: u64 = 2 // dito
const LE_MOVE: u64 = 3 // dito
const LE_KEY: u64 = 4 // a = die Taste wie aus `decode` (KEY_* oder Oktett)
const LE_FELDER: u64 = 4
const LW_RING: u64 = 64
static mut lw_q: [u64; 256] = [0 as u64; 256] // LW_RING * LE_FELDER
static mut lw_head: u64 = 0
static mut lw_tail: u64 = 0

const GRAPH_FIELDS: u64 = 5
const GR_N: u64 = 0 // wie viele Messwerte belegt sind
const GR_HIST: u64 = 1 // wie viele Plaetze die Reihe hat
const GR_A: u64 = 2 // Zeiger auf die erste Reihe (durchgezogen, dick)
const GR_B: u64 = 3 // Zeiger auf die zweite (gestrichelt, duenn)
const GR_MAX: u64 = 4 // der Wert, der ganz oben liegt (z. B. 1000)

const NK_MAIN: u64 = 0
const NK_MENU: u64 = 1
const NK_DLG: u64 = 2
// RUNDE ECHTHARDWARE-2: DIE INFOBLASE. Eigene Art und nicht ein Menue
// mit einer Zeile: sie nimmt KEINE Klicks an, hat keinen Rahmen zum
// Anfassen und verschwindet von selbst. Ein Menue, das nichts kann,
// waere ein Menue, das man versehentlich bedient.
//
// DIE ART STEHT HIER, DIE BLASE SELBST NICHT -- und das ist keine
// Geschmacksfrage, sondern eine Messung. Der erste Entwurf hatte
// `tip_show`/`tip_hide`/`tip_hover`/`paint_tip` in dieser Datei. Danach
// brach der SELBSTGEHOSTETE Uebersetzer `firnc1` an `netmon`,
// `freunde` und `powermon` ab -- RC=1, keine Zeile Ausgabe, 4 MB
// Speicher (also keine Wirtsknappheit, sondern eine feste Tabelle in
// firnc1). `firnc0` uebersetzte dasselbe klaglos, das Abbild lief, und
// nur der K16-Pruefstand sah es: "131 gebunden, erwartet 134".
//
// EINZELN uebersetzt jeder Bestandteil; es ist die SUMME. wlib ist in
// dreizehn Programme gelinkt, und was hier liegt, kostet in jedem
// davon. Die Blase braucht GENAU EIN Programm -- die Taskleiste --,
// also liegt sie dort (kernel/user/taskbar.fi, Abschnitt INFOBLASE).
const NK_TIP: u64 = 3

// Die Felder eines Widgets. Sechzehn Woerter, ein Feld je Wort -- Firn
// hat keine Verbunde, und eine Tabelle aus Woertern ist ehrlicher als
// sechzehn Felder mit sechzehn Namen.
const D_KIND: u64 = 0
const D_X: u64 = 1
const D_Y: u64 = 2
const D_W: u64 = 3
const D_H: u64 = 4
const D_FLAGS: u64 = 5
const D_TEXT: u64 = 6
const D_VAL: u64 = 7
const D_WIN: u64 = 8
const D_A: u64 = 9 // Rollversatz / Zeilenzahl
const D_B: u64 = 10 // Einfuegemarke / sichtbare Zeilen
const D_C: u64 = 11 // Auswahlanker / Spaltenzahl
const D_D: u64 = 12 // Hoechstlaenge / Spaltenbreiten
const D_PW: u64 = 13 // Wunschbreite
const D_PH: u64 = 14 // Wunschhoehe
const D_CT: u64 = 15 // der Kasten
// ROUND ICONS: one word per row, an icon from the icon font.  It sits
// next to `D_D` and not inside it on purpose: `D_D` already means two
// different things depending on the widget (longest text for an entry,
// column widths for a table), and a third meaning in the same slot is
// how a widget ends up drawing a column width as a picture.
const D_ICONS: u64 = 16
// RUNDE ALLTAG: die Felder der Bildflaeche und des Schiebereglers.
const D_E: u64 = 17 // Bildzeiger / Kleinstwert
const D_F: u64 = 18 // Bildbreite / Groesstwert
const D_G: u64 = 19 // Bildhoehe / Schrittweite
const D_ZOOM: u64 = 20 // Vergroesserung in Hundertsteln
const D_PX: u64 = 21 // Verschiebung waagerecht
const D_PY: u64 = 22 // Verschiebung senkrecht
const D_DREH: u64 = 23 // 0, 1, 2, 3 -- Vielfache von 90 Grad
const D_WZ: u64 = 24 // 0 = schieben, 1 = Ausschnitt ziehen
const D_FIELDS: u64 = 25

const F_FOCUSABLE: u64 = 1
const F_PRESSED: u64 = 2
const F_HOVER: u64 = 4
const F_OFF: u64 = 8
const F_HIDE: u64 = 16
// ============================================== RUNDE STARTKNOPF
// EINE LISTE, DIE SCHON BEIM ERSTEN KLICK AUSLOEST.
//
// Justin klickt im Starter einen Eintrag an, und nichts geschieht. Das
// ist kein Fehler in der Trefferflaeche -- die Auswahl WIRD gesetzt --,
// sondern die Bedienregel: eine Liste loest bis hierher nur beim
// DOPPELKLICK aus. Fuer einen Dateimanager ist das richtig (man waehlt
// oft, man oeffnet selten). Fuer ein STARTMENUE ist es falsch: dort
// ist der einzige Zweck eines Klicks, das Programm zu starten, und
// jedes System der Welt startet dort beim ersten Klick.
//
// Die Regel gehoert also an die Liste und nicht in die Bibliothek.
const F_EINKLICK: u64 = 32

// Ein Fenster
const N_H: u64 = 0
const N_W: u64 = 1
const N_HH: u64 = 2
const N_KIND: u64 = 3
const N_VAL: u64 = 4
const N_DATA: u64 = 5
const N_CNT: u64 = 6
const N_NDIRT: u64 = 7 // wie viele Rechtecke gerade schmutzig sind
const N_OWNER: u64 = 11
const N_X: u64 = 12
const N_Y: u64 = 13
const N_FIELDS: u64 = 14

// Ein Kasten
const C_KIND: u64 = 0 // 1 senkrecht, 2 waagerecht, 3 Raster
const C_X: u64 = 1
const C_Y: u64 = 2
const C_W: u64 = 3
const C_H: u64 = 4
const C_PAD: u64 = 5
const C_GAP: u64 = 6
const C_COLS: u64 = 7
const C_CX: u64 = 8 // der Setzpunkt
const C_CY: u64 = 9
const C_COL: u64 = 10
const C_ROWH: u64 = 11
