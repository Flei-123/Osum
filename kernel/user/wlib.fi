    // RUNDE CERTUS-AUF-OSUM: die Leinwand.
    K_LEINWAND, leinwand, leinwand_setzen, leinwand_neu, leinwand_neu_teil,
    leinwand_ereignis, leinwand_anstehend,
    LE_DOWN, LE_UP, LE_MOVE, LE_KEY, LE_FELDER,
    K_BILD, K_SLIDER, bild, bild_setzen, bild_zoom, bild_set_zoom,
