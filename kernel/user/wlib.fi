// SPDX-License-Identifier: MIT
// kernel/user/wlib.fi -- Runde K15: DIE WIDGET-BIBLIOTHEK. Ring 3.
//
// Runde K10 gab einer Anwendung ein Rechteck, ein Handle und einen Ring
// mit Ereignissen. Was zwischen diesem Rechteck und einem Programm
// fehlt, ist alles: ein Knopf weiss, dass er gedrueckt aussieht,
// solange die Taste unten ist; ein Textfeld weiss, wo die Einfuegemarke
// steht; eine Liste weiss, welche Zeile ausgewaehlt ist und wie weit
// sie gerollt wurde; die Tabulatortaste weiss, was als naechstes den
// Fokus bekommt. Das steht hier.
//
// UND ES STEHT IN RING 3, NICHT IM KERNEL. Der Auftrag dieser Runde
// sagt es, und es ist auch richtig so: ein Kernel, der weiss, wie ein
// Knopf aussieht, kann nicht mehr sagen, was er ist. Was diese
// Bibliothek vom Kernel braucht, sind sieben Aufrufe
// (`kernel/wlib.fi`), und keiner davon kennt ein Widget.
//
// DER AUFBAU, in der Reihenfolge, in der ein Programm ihn benutzt:
//
//   1. `wlib.begin(nohit, noclip)` -- die Zeichenflaeche holen, das
//      Farbschema lesen.
//   2. `wlib.window(x, y, w, h, titel)` -- ein Fenster beim Server.
//   3. Kaesten aufmachen (`box_v`, `box_h`, `box_grid`) und Widgets
//      hineinstellen. Jedes gibt eine Nummer zurueck.
//   4. `wlib.step()` in einer Schleife: holt die Ereignisse ALLER
//      Fenster ab, verteilt sie, malt neu, was schmutzig ist, und gibt
//      die Nummer des Widgets zurueck, bei dem etwas passiert ist.
//
// WAS EIN "EREIGNIS" HIER IST: ein Knopf, der losgelassen wurde, eine
// Zeile, auf die doppelt geklickt wurde, ein Menuepunkt, der gewaehlt
// wurde, ein Reiter, der gewechselt hat, ein Dialog, der geschlossen
// wurde. Nicht: jede Mausbewegung. Die verarbeitet die Bibliothek
// selbst, und sie ist der Grund, warum ueberhaupt etwas neu gemalt
// wird.
//
// DIE ZWEI GEGENPROBEN, die diese Bibliothek selbst mitbringt:
//
//   `nohit`   Die Trefferpruefung ist aus. Widgets werden gemalt, die
//             Maus laeuft, die Ereignisse kommen an -- und landen bei
//             KEINEM Widget. Kein Knopf geht herunter, keine Zeile
//             wird ausgewaehlt, kein Menue klappt auf. Jede Messung,
//             die "der Klick ist angekommen" behauptet, MUSS damit
//             einbrechen.
//   `noclip`  Die Zwischenablage ist aus. Kopieren und Einfuegen tun
//             nichts, der Rest bleibt.
//
// WAS ES NICHT GIBT, und es steht hier und nicht in einer Fussnote:
// keine Unterfenster im Fenster (jedes Menue und jeder Dialog ist ein
// eigenes Fenster beim Server), keine Umbrueche im Textfeld (es ist
// EINE Zeile), keine Auswahl mit Umschalt-Pfeil (die Umschalttaste
// kommt in diesem System nicht als eigenes Ereignis an -- die
// Zeilendisziplin liefert das fertige Zeichen), und kein Ziehen
// zwischen Fenstern.

profile kernel

import ulib
import libc.io
import wlibc
import utf8

export {
    begin, window, window_app, window_plain, window_kind, close, closed, handle,
    trace, set_trace, set_menu_title, reshape, say_rects,
    win_w, win_h, win_x, win_y, win_hide, win_layer,
    box_v, box_h, box_grid, box_end, box_at, box_use, size, gap_after,
