const KEY_CTRL_T: u64 = 20
const KEY_CTRL_V: u64 = 22
const KEY_CTRL_X: u64 = 24
const KEY_CTRL_Z: u64 = 26

// ------------------------------------------------------- der Zustand

// ==================================================== RUNDE MERGE-10
// DIE BEIDEN FELDER, DIE IN DIESER RUNDE BEIDE ZU KLEIN GEWESEN WAEREN.
//
// Hier trafen zwei Runden aufeinander, die DIESELBEN zwei Felder aus
// je einem anderen Grund vergroessert haben, und keine der beiden
// Fassungen war nach dem Zusammenfuehren noch richtig:
//
//   EXPLORER-2   hob D_FIELDS 25 -> 29  =>  wd  4000 -> 4640, liess
//                aber MAXWN bei 4       =>  wn  56
//   ECHTHARDWARE-2 hob MAXWN 4 -> 5     =>  wn    56 -> 70, liess
//                aber D_FIELDS bei 25   =>  wd  4000
//
// Nach dem Zusammenfuehren gelten BEIDE Konstanten: MAXWD 160,
// D_FIELDS 29, MAXWN 5, N_FIELDS 14. Wer hier eine der beiden Seiten
// einfach uebernimmt, bekommt ein Feld, das ZU KLEIN IST FUER DIE
// KONSTANTEN, DIE DANEBEN STEHEN -- und das ist genau der Fehler, den
// MERGE-9 schon einmal hatte (zwei Kernvariablen auf derselben
// Adresse). Er faellt im laufenden System nicht auf; er faellt dem
// K16-Pruefstand auf, weil `firnc1` beim Binden umkippt.
//
// Also werden die Zahlen NICHT abgeschrieben, sondern AUSGERECHNET:
//   wd = MAXWD * D_FIELDS = 160 * 29 = 4640
//   wn = MAXWN * N_FIELDS =   5 * 14 =   70
// Aendert jemand eine der vier Konstanten, muessen diese zwei Zeilen
// mitwandern -- `pruef_felder()` weiter unten sagt es dann sofort.
//
// ================================================== RUNDE O-NETZUI
// UND GENAU DAS IST WIEDER PASSIERT -- 4640 WAR ZU KLEIN.
//
// `D_FIELDS` steht seit einer spaeteren Runde auf DREISSIG (Zeile 469),
// nicht mehr auf 29. Das Feld daneben ist aber bei 4640 geblieben, und
// 160 * 30 sind 4800. Die letzten fuenf Bedienelemente (ab Nummer 154,
// denn 154 * 30 = 4620) schreiben damit HINTER das Feld.
//
// WIE ES AUFFIEL: diese Runde bringt acht Bedienelemente auf der
// Netzseite dazu und kam damit auf 157. Im Bildschirmfoto war das
// Fenster der Einstellungen VOLLSTAENDIG LEER -- kein Reiter, kein
// Text --, und auf der seriellen Leitung stand hinter `settings: ready`
// die Zeile
//
//     panic: index out of bounds in '[u64; 4640]' at wlib.fi:827
//
// Der Fehler lag NICHT an dieser Runde: er lag seit der Erhoehung von
// D_FIELDS im Baum und wartete darauf, dass ein Programm das
// hundertvierundfuenfzigste Bedienelement anlegt. Ohne die Bildkontrolle
// waere er mit dieser Runde eingebaut worden statt aufgedeckt.
//
// Ausgerechnet statt abgeschrieben, und diesmal mit einer Pruefung, die
// nicht vom Erinnerungsvermoegen des naechsten Bearbeiters abhaengt:
// `feld_passt()` weiter unten rechnet beides nach und meldet sich.
//   wd = MAXWD * D_FIELDS = 224 * 30 = 6720
static mut wd: [u64; 6720] = [0 as u64; 6720] // MAXWD * D_FIELDS (224 * 30)
static mut wn: [u64; 70] = [0 as u64; 70] // MAXWN * N_FIELDS (5 * 14)
static mut ct: [u64; 312] = [0 as u64; 312] // MAXCT * C_FIELDS
static mut nwd: u64 = 0
static mut nwn: u64 = 0
static mut nct: u64 = 0
static mut ctcur: u64 = 0xFFFFFFFFFFFFFFFF
static mut wncur: u64 = 0
static mut want_w: u64 = 0
static mut want_h: u64 = 0
// Die Wunschmarke des NAECHSTEN Bedienelements -- heute nur
// `F_UMBRUCH`. Wie `want_w` gilt sie fuer genau eines und ist danach
// wieder vergessen.
static mut want_flags: u64 = 0
static mut want_gap: u64 = 0

static mut s_focus: u64 = 0 // Widgetnummer + 1
static mut s_nohit: u64 = 0
static mut s_alive: u64 = 1
static mut s_fired: u64 = 0
static mut s_fkind: u64 = 0
static mut s_findex: u64 = 0
static mut s_fwin: u64 = 0
static mut s_blits: u64 = 0
static mut s_keylast: u64 = 0
static mut s_keyseq: u64 = 0
// RUNDE EXPLORER-2, ZWEITER DURCHGANG: WIE OFT SICH EIN FENSTER
// GEAENDERT HAT. `relayout` ordnet Kaesten, die die volle Breite
// wollten, von selbst neu -- ein Programm mit gerechneter Seite
// (Seitenleiste, Kopfzeile, Tabelle, Statuszeile) muss seine Masse
// jedoch SELBST neu ausrechnen. Ohne einen Zaehler merkt es das
// Maximieren nicht und malt die alte Aufteilung in das neue Fenster:
// genau der leere Inhalt aus 18-maximiert.png.
static mut s_reseq: u64 = 0
// RUNDE ALLTAG: die Zahl und der Modifikator einer Fluchtfolge
// `ESC [ n ; m ~`. Vorher stand die Zahl im Zustand selbst
// (`s_esc = 3 + Ziffer`) und mehr als eine Ziffer gab es nicht.
static mut s_num: u64 = 0
static mut s_mod: u64 = 0
// RUNDE GUI-EDITOR: der Modifikator der zuletzt entschluesselten Taste.
static mut s_keymod: u64 = 0
// RUNDE GUI-EDITOR: der Puffer fuer Ausschneiden/Einsetzen im
// mehrzeiligen Feld. Einmal geholt, dann behalten.
const TA_CLIP: u64 = 65536
static mut ta_clipbuf: u64 = 0
static mut s_down: u64 = 0 // gedruecktes Widget + 1
// RUNDE ALLTAG: wo das Ziehen anfing (Bildflaeche und Schieberegler).
// RUNDE EXPLORER-2, Punkt 3: wie oft ein Mausrahmen eine Auswahl
// veraendert hat. Eine Zahl, damit die Abnahme das Ziehen MESSEN kann,
// statt es an einem Standbild zu erraten.
static mut s_rahmen: u64 = 0
// RUNDE CLIP-2: wie oft ein Ablegen gemeldet wurde. Dieselbe Absicht
// wie `s_rahmen`: eine Zahl, die eine Abnahme LESEN kann, statt das
// Ablegen an einem Standbild zu erraten.
static mut s_drops: u64 = 0
// Ob dieses Programm Ablegeziel ist. Wer sich nicht anmeldet, merkt von
// fremden Ziehbewegungen nichts -- so wie eine Liste ohne `sel_an`
// nicht mitzieht.
static mut s_dropan: u64 = 0
// RUNDE CLIP-2: wie oft ein Ziehen ANGEFANGEN hat, und auf welchem
// Widget es gerade laeuft (+1). Das zweite verhindert, dass aus einer
// Bewegung zwanzig Meldungen werden: gemeldet wird EINMAL je Zug.
static mut s_drags: u64 = 0
static mut s_dragwd: u64 = 0
static mut s_dragx: u64 = 0
static mut s_dragy: u64 = 0
// Der gezogene Ausschnitt, in BILDPUNKTEN des Bildes und nicht des
// Schirms -- ein Programm, das darin etwas veraendert, rechnet sonst
// jede Vergroesserung selbst zurueck.
static mut s_aus_x0: u64 = 0
static mut s_aus_y0: u64 = 0
static mut s_aus_x1: u64 = 0
static mut s_aus_y1: u64 = 0
static mut s_aus_da: u64 = 0
static mut s_esc: u64 = 0 // Zustand der Fluchtfolge
static mut s_lastclick: u64 = 0
static mut s_lastwd: u64 = 0
static mut s_ticks: u64 = 0

// ================================ RUNDE DESIGN-2: DIE BEWEGUNG
//
// EIN Tween-Verwalter fuer die ganze Bibliothek, und zwar aus dem
// Grund, aus dem alles andere hier auch nur einmal existiert: eine
// Bewegung, die jedes Programm selbst zaehlt, laeuft auf zwei Fenstern
// verschieden schnell.
//
// DIE ZEITQUELLE IST `ticks()`, also `SYS_SYSINFO/I_TICKS`, und der
// Takt steht in kernel/time.fi: `TICK_HZ = 100`. Ein Tick sind somit
// GENAU 10 ms. Das ist die einzige Umrechnung in dieser Datei, sie
// steht hier, und sie heisst `MS_PRO_TICK`.
//
// WARUM NICHT 60 Hz. Weil dieser Kernel 100 Hz hat. Eine Bibliothek,
// die 60 Hz BEHAUPTET, waehrend ihr Zeitgeber mit 100 laeuft, rechnet
// jede Dauer um 40 Prozent falsch. Die Zusage lautet: die Dauer in
// Millisekunden stimmt; die Zahl der Zwischenbilder ist, was die
// Maschine hergibt.
//
// WAS EIN TWEEN IST: vier Zahlen (Anfangstick, Dauer in Ticks, Kurve,
// Ziel) und ein Fortschritt 0..1000. Nicht 0..100 -- bei einem Fenster
// von 800 Bildpunkten ist ein Prozent acht Bildpunkte, und ein Sprung
// von acht Bildpunkten ist genau das Ruckeln, das diese Runde
// abstellen soll.
const TW_MAX: u64 = 16
const TW_FREE: u64 = 0
const TW_LAEUFT: u64 = 1
const TW_FERTIG: u64 = 2

// Die Felder eines Tweens.
const TW_STATE: u64 = 0
const TW_T0: u64 = 1
const TW_DUR: u64 = 2
const TW_CURVE: u64 = 3
const TW_WHAT: u64 = 4
const TW_WIN: u64 = 5
const TW_WD: u64 = 6
const TW_P: u64 = 7
const TW_FIELDS: u64 = 8

// Die Kurven. Linear ist ausdruecklich dabei, weil eine gemessene
// Bewegung eine braucht, an der nichts zu deuten ist.
const EASE_LINEAR: u64 = 0
const EASE_OUT: u64 = 1
const EASE_IN_OUT: u64 = 2

// Wofuer eine Bewegung laeuft.
const AN_WIN_OPEN: u64 = 1
const AN_WIN_CLOSE: u64 = 2
const AN_MENU: u64 = 3
const AN_HOVER: u64 = 4
const AN_PRESS: u64 = 5
const AN_NOTIFY: u64 = 6

const MS_PRO_TICK: u64 = 10

static mut tw: [u64; 128] = [0 as u64; 128]
static mut tw_n: u64 = 0
static mut tw_starts: u64 = 0
static mut tw_frames: u64 = 0

// =============================== RUNDE LOOK: DIE OBERFLAECHE MELDET SICH
//
// Die Taskleiste meldet seit Runde DESKTOP jede Zeile, die sie malt, mit
// x, Grundlinie, Vorder- und Hintergrundfarbe -- und deshalb kann
// `tools/netview/run.sh` sie BILDPUNKTGENAU gegen eine zweite Rasterung
// halten, statt sie anzusehen. Jedes andere Fenster dieses Systems
// konnte das nicht: die Widgets werden hier gemalt, und hier wurde
// nichts gemeldet.
//
// Diese Runde braucht es dreimal:
//   * Abschnitt A -- ein Text MIT UMLAUT muss Bildpunkt fuer Bildpunkt
//     nachgerechnet werden, und dafuer muss seine Grundlinie bekannt
//     sein und nicht nachgerechnet.
//   * Abschnitt C/D -- eine Zusage ueber Innenabstand und Eckenradius
//     ist eine Zusage ueber KOORDINATEN. Wer sie im Testlauf selbst
//     ausrechnet, prueft seine eigene Rechnung.
//
// ES IST AUS, SOLANGE NIEMAND ES EINSCHALTET, und eingeschaltet wird es
// durch eine DATEI auf der Platte (`/etc/uitrace`) und nicht durch ein
// Wort auf der Kernel-Kommandozeile: die Kommandozeile gehoert dem
// Kernel, und ein Ring-3-Programm, das darin liest, hat eine Abhaengigkeit
// erfunden, die es nicht braucht. Ohne die Datei ist die serielle
// Ausgabe dieses Systems Oktett fuer Oktett dieselbe wie vorher -- das
// ist die Bedingung dafuer, dass kein bestehender Testlaeufer davon
// etwas merkt.
static mut s_trace: u64 = 0
static mut s_tx: u64 = 0
// Der Titel des Menuefensters, wenn ein Programm ihn gesetzt hat.
static mut mn_titel: u64 = 0
static mut tr_a: [u8; 16] = "wlib: text win=\0"
static mut tr_k: [u8; 8] = " kind=\0\0"
static mut tr_x: [u8; 5] = " x=\0\0"
static mut tr_b: [u8; 8] = " base=\0\0"
static mut tr_f: [u8; 6] = " fg=\0\0"
static mut tr_g: [u8; 6] = " bg=\0\0"
// ROUND THEMESTORE: AND HOW WIDE IT IS.
//
// A checker that has to GUESS the width of a piece of text guesses too
// generously -- it then finds ink from the widget next door inside the
// box it drew around this one, and reports two labels as overlapping
// that do not touch. Measured: eighty-six false overlaps in one
// screenshot before this field existed. The program knows the width;
// it computed it to centre the text. So it says it.
static mut tr_w: [u8; 6] = " tw=\0\0"
// ROUND SOFTUI: AND WHERE THE WINDOW IS.
//
// Every number in this line is WINDOW-LOCAL, and the handle in `win=`
// is a handle and not a place -- so a checker that reads this line
// cannot find the text in the picture.  It could only guess, and
// `tools/softui/check.py` guessing means it looks at the wrong window
// and reports every label of a two-window screenshot as empty.  That
// is not a checker, that is noise.  Two numbers fix it.
static mut tr_ax: [u8; 6] = " ax=\0\0"
static mut tr_ay: [u8; 6] = " ay=\0\0"
// RUNDE GLAS (nachtrag): UND WIE VIEL VON DEM TEXT UEBRIG BLIEB.
//
// `nq` ist die Zahl der Oktette DES NAMENS, die auf dem Schirm
// stehen (die drei Punkte einer Kuerzung gehoeren nicht zum Namen und
// zaehlen nicht mit), `nv` die des ungekuerzten Textes. Solange beide gleich sind, steht in `t=`
// der ganze Name; sind sie es nicht, hat ein Bedienelement gekuerzt --
// und genau das war bisher unsichtbar: die Reiterleiste malte
// "Netzzugrif" statt "Netzzugriff", und kein Pruefer konnte das von
// einem Reiter unterscheiden, der wirklich so heisst. Zwei Zahlen
// machen daraus eine Messung (tools/themestore/shotcheck.py, `cut`
// und `elided`).
static mut tr_q: [u8; 6] = " nq=\0\0"
static mut tr_v: [u8; 6] = " nv=\0\0"
static mut tr_t: [u8; 5] = " t=\0\0"
static mut tr_buf: [u8; 320] = [0 as u8; 320]
// RUNDE THEME. Was das Umschalten kostet, gezaehlt an der Stelle, an
// der es passiert -- nicht geschaetzt.
static mut s_thpoll: u64 = 0 // Tick des letzten Nachsehens
static mut s_thgen: u64 = 0 // zuletzt gesehene Generation
static mut s_thswitch: u64 = 0 // wie oft sich das Thema geaendert hat
static mut s_thpx: u64 = 0 // Bildpunkte, die dafuer neu gemalt wurden
static mut s_thstale: u64 = 0 // Male, die ein Bild mittendrin veraltete
static mut s_thpolls: u64 = 0
static mut dlgbuf: [u8; 160] = [0 as u8; 160]
static mut ev: [u8; 16] = [0 as u8; 16]

// ------------------------------------------------------- der Zugriff

// ================================================== RUNDE O-NETZUI
// PASST DAS FELD ZU DEN KONSTANTEN DANEBEN?
//
// Die Frage hat sich diese Datei schon einmal gestellt (Runde MERGE-10,
// der Kasten ueber `wd`) und die Antwort dann in einen Kommentar
// geschrieben. Ein Kommentar haelt genau so lange, bis jemand eine der
// Konstanten aendert und den Kommentar nicht liest -- danach schreibt
// `s()` ueber das Feldende, und man sieht es erst an einem leeren
// Fenster und einer Panikzeile.
//
// `WD_LEN` ist die WIRKLICHE Laenge des Feldes. Stimmt sie nicht mit
// `MAXWD * D_FIELDS` ueberein, gibt `feld_passt` false, und `begin`
// sagt es auf der Leitung, bevor irgendetwas gemalt wird.
const WD_LEN: u64 = 6720

fn feld_passt() -> bool {
    return MAXWD * D_FIELDS <= WD_LEN
}

fn g(i: u64, f: u64) -> u64 {
    if i >= MAXWD {
        return 0
    }
    // Und der Riegel fuer den Fall, dass doch jemand die Konstanten
    // verschiebt: lieber eine 0 als ein Lesezugriff hinter dem Feld.
    if i * D_FIELDS + f >= WD_LEN {
        return 0
    }
    return wd[(i * D_FIELDS + f) as usize]
}

fn s(i: u64, f: u64, v: u64) {
    if i >= MAXWD {
        return
    }
    // DERSELBE RIEGEL WIE IN `g`, und hier ist er der wichtigere: ein
    // Schreibzugriff hinter dem Feldende hat in Runde O-NETZUI das
    // ganze Fenster der Einstellungen leer gemacht.
    if i * D_FIELDS + f >= WD_LEN {
        return
    }
    wd[(i * D_FIELDS + f) as usize] = v
}

fn ng(w: u64, f: u64) -> u64 {
    if w >= MAXWN {
        return 0
    }
    return wn[(w * N_FIELDS + f) as usize]
}

fn ns(w: u64, f: u64, v: u64) {
    if w >= MAXWN {
        return
    }
    wn[(w * N_FIELDS + f) as usize] = v
}

fn cg(c: u64, f: u64) -> u64 {
    if c >= MAXCT {
        return 0
    }
    return ct[(c * C_FIELDS + f) as usize]
}

fn cs(c: u64, f: u64, v: u64) {
    if c >= MAXCT {
        return
    }
    ct[(c * C_FIELDS + f) as usize] = v
}

fn tlen(p: u64) -> u64 {
    if p == 0 {
        return 0
    }
    return ulib.length(p)
}

fn imin(a: u64, b: u64) -> u64 {
    if a < b {
        return a
    }
    return b
}

fn sub(a: u64, b: u64) -> u64 {
    if b >= a {
        return 0
    }
    return a - b
}

// ------------------------------------------------------- das Aufsetzen

static mut s_feldwarn: [u8; 46] = "wlib: FELD ZU KLEIN -- MAXWD*D_FIELDS > wd[]\n\0"

fn begin(nohit: bool, noclip: bool) -> bool {
    if !wlibc.start(noclip) {
        return false
    }
    // RUNDE O-NETZUI: passt das Widgetfeld zu den Konstanten daneben?
    // Wenn nicht, steht es hier auf der Leitung -- BEVOR das erste
    // Bedienelement angelegt wird. Der Lauf geht weiter (die Riegel in
    // `g`/`s` fangen den Zugriff ab, es fehlen dann nur die letzten
    // Bedienelemente), aber niemand muss den Grund mehr raten.
    if !feld_passt() {
        let _fw: u64 = ulib.say((&s_feldwarn[0 as usize]) as u64)
    }
    var pfad: [u8; 11] = "/etc/theme\0"
    wlibc.theme_load((&pfad[0 as usize]) as u64)
    if nohit {
        s_nohit = 1
    }
    // RUNDE LOOK: gibt es die Datei, meldet diese Bibliothek jede Zeile,
    // die sie malt. Gibt es sie nicht, aendert sich kein Oktett.
    var p_tr: [u8; 14] = "/etc/uitrace\0\0"
    let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
    if !ulib.bad(fdt) {
        io.close(fdt)
        s_trace = 1
        say_font()
    }
    return true
}

// RUNDE THEMESTORE: WIE HOCH EINE ZEILE WIRKLICH IST.
//
// `wlib: text ... base=` sagt die Grundlinie. Wer daraus einen Kasten
// um die Buchstaben macht, muss wissen, wie weit die Schrift ueber und
// unter der Grundlinie steht -- und `shotcheck.py` hat das geraten:
// sechzehn hinauf, sechs hinunter, zweiundzwanzig hoch. Die Zeilen
// einer Liste stehen ZWANZIG auseinander. Damit schnitt der geratene
// Kasten jeder Zeile in die Nachbarzeile, fand dort deren Tinte und
// meldete Ueberlappungen, die es nicht gab -- drei Stueck in einer
// Aufnahme, in der nichts falsch war. Die Bibliothek weiss die Zahlen;
// sie sagt sie jetzt, und geraten wird nicht mehr.
static mut tf_a: [u8; 18] = "wlib: font ui px=\0"
static mut tf_b: [u8; 6] = " asc=\0"
static mut tf_c: [u8; 4] = " h=\0"

fn say_font() {
    let b: u64 = (&tr_buf[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&tf_a[0 as usize]) as u64)
    at = tr_num(b, at, wlibc.px_ui())
    at = tr_put(b, at, (&tf_b[0 as usize]) as u64)
    at = tr_num(b, at, wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()))
    at = tr_put(b, at, (&tf_c[0 as usize]) as u64)
    at = tr_num(b, at, wlibc.text_h(wlibc.px_ui()))
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(b, at)
}

fn counts() -> u64 {
    return nwd
}

fn blits_done() -> u64 {
    return s_blits
}

fn key_last() -> u64 {
    return s_keylast
}

// WIE OFT SCHON EINE TASTE KAM. Ein Programm, das auf Entf reagieren
// will, kann `key_last` nicht vergleichen -- zweimal Entf ist zweimal
// dieselbe Zahl. Es vergleicht diesen Zaehler.
// Wie oft ein Fenster seine Groesse geaendert hat. Ein Programm
// vergleicht die Zahl mit der zuletzt gesehenen und rechnet seine
// Seite neu, wenn sie gewachsen ist -- eine Zahl statt eines Vergleichs
// von Breite UND Hoehe an fuenf Stellen.
fn resize_seq() -> u64 {
    return s_reseq
}

fn key_seq() -> u64 {
    return s_keyseq
}

fn alive() -> bool {
    return s_alive != 0
}

fn quit() {
    s_alive = 0
}

// ------------------------------------------------------- die Fenster

// RUNDE SCHIRM: DIE MASSE SIND LOGISCH, NICHT IN BILDPUNKTEN.
//
// Jedes Programm dieser Sammlung nennt hier feste Zahlen -- 440x300
// beim Starter, 660x430 beim Datei-Explorer. Die Bedienelemente DARIN
// wachsen mit der Oberflaechenschrift (`wlibc.metric`, `px_ui`), das
// Fenster aber wuchs nicht mit: auf 3840x2160 stand ein Starterfenster
// von 440 Bildpunkten in der Ecke, und seine Liste war abgeschnitten
// ("Editor -- Text schreib..."). Gemessen im Bild, nicht im Quelltext.
//
// Also: Groesse UND Stelle mal dem Faktor, und danach auf den Schirm
// gedeckelt, damit aus dem Wachsen kein Hinausragen wird.
fn window(x: u64, y: u64, w: u64, h: u64, titel: u64) -> u64 {
    let k: u64 = wlibc.ui_scale()
    var bw: u64 = w * k
    var bh: u64 = h * k
    let sw: u64 = wlibc.screen_w()
    let sh: u64 = wlibc.screen_h()
    var bx: u64 = x * k
    var by: u64 = y * k
    if sw != 0 && sh != 0 {
        if bw > sw {
            bw = sw
        }
        if bh > sh {
            bh = sh
        }
        if bx + bw > sw {
            bx = sub(sw, bw)
        }
        if by + bh > sh {
            by = sub(sh, bh)
        }
    }
    return new_win(bx, by, bw, bh, titel, NK_MAIN)
}

// RUNDE PAINT: WELCHEM BUENDEL DIESES FENSTER GEHOERT.
//
// Ein Aufruf, einmal, gleich nach `window`. Was er bringt, ist das
// Symbol im Taskleisten-Knopf: die Bilder liegen seit Runde K15 in
// `/apps/<name>.osp/symbol`, und was fehlte, war der Satz "dieses
// Fenster ist jenes Programm". Der Titel konnte ihn nicht sagen -- er
// ist uebersetzt, er aendert sich im Lauf, und zwei Programme duerfen
// denselben tragen.
//
// Wer es nicht ruft, aendert nichts: der Knopf bleibt reiner Text.
fn window_app(i: u64, name: u64) -> u64 {
    if i >= MAXWN {
        return 0
    }
    return wlibc.win_app(ng(i, N_H), name)
}

// RUNDE DESKTOP: EIN FENSTER OHNE SCHMUCK AUF EINER EIGENEN EBENE.
// Schreibtisch und Taskleiste sind gewoehnliche Fenster -- sie haben
// nur keinen Rahmen und keine Titelleiste, und sie liegen ganz hinten
// beziehungsweise ganz vorn. Beides sagt DER SERVER, nicht die
// Anwendung: eine Anwendung, die sich selbst nach vorn malt, malt in
// ihr eigenes Rechteck und damit unter alle anderen.
//
// Gibt MAXWN zurueck, wenn kein Fenster zu haben war -- und ebenso,
// wenn die Ebene abgelehnt wurde. Ebene 0 und 2 darf nur die Wurzel;
// wer sie nicht bekommt, soll KEIN Fenster behalten, das aussieht wie
// eine Taskleiste und keine ist.
fn window_plain(x: u64, y: u64, w: u64, h: u64, titel: u64,
    ebene: u64) -> u64 {
    let i: u64 = new_win(x, y, w, h, titel, NK_MAIN)
    if i >= MAXWN {
        return MAXWN
    }
    let hh: u64 = ng(i, N_H)
    if ulib.bad(wlibc.win_state(hh, wlibc.WS_DECO, 0)) {
        close(i)
        return MAXWN
    }
    if ebene != wlibc.L_NORMAL {
        if ulib.bad(wlibc.win_state(hh, wlibc.WS_LAYER, ebene)) {
            close(i)
            return MAXWN
        }
    }
    // Der Schmuck ist eben abgeschaltet worden: der Ursprung der
    // Malflaeche ist ein anderer als der, der beim Anlegen galt.
    say_window(i)
    return i
}

// RUNDE ECHTHARDWARE-1: "dieses Fenster will die Tastatur, auch wenn
// es nicht auf der normalen Ebene liegt". Fuer das Startmenue -- siehe
// die lange Begruendung in kernel/user/launcher.fi.
fn win_keys(w: u64, an: bool) -> u64 {
    if w >= MAXWN {
        return 0
    }
    var v: u64 = 0
    if an {
        v = 1
    }
    return wlibc.win_state(ng(w, N_H), wlibc.WS_KEYS, v)
}

// Das eigene Fenster minimieren oder wiederherstellen.
fn win_hide(w: u64, on: bool) -> u64 {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return 0
    }
    var v: u64 = 0
    if on {
        v = 1
    }
    return wlibc.win_state(ng(w, N_H), wlibc.WS_HIDDEN, v)
}

// ======================================== RUNDE ECHTHARDWARE-4
// HAT DIESES FENSTER DEN EINGABEFOKUS?
//
// Gebraucht fuer das Startmenue: eine Ueberlagerung schliesst, wenn
// man DANEBEN klickt. "Daneben" laesst sich in Ring 3 nicht sehen --
// ein Klick auf ein fremdes Fenster erzeugt hier kein Ereignis. Was
// man sehen kann, ist die Folge davon: der Fokus ist weg. Der Server
// beantwortet das seit jeher (`sysgui.fi`, `WI_FOCUS` ->
// `wm.focus(state) == i`); es fehlte nur der Weg heraus.
fn win_fokus(w: u64) -> bool {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return false
    }
    return wlibc.sys3w(wlibc.WM_INFO, ng(w, N_H), wlibc.WI_FOCUS, 0) == 1
}

fn win_layer(w: u64) -> u64 {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return wlibc.L_NORMAL
    }
    return wlibc.sys3w(wlibc.WM_INFO, ng(w, N_H), wlibc.WI_LAYER, 0)
}

fn new_win(x: u64, y: u64, w: u64, h: u64, titel: u64, kind: u64) -> u64 {
    if nwn >= MAXWN {
        return MAXWN
    }
    let hh: u64 = wlibc.sys5(wlibc.WM_CREATE, (x << 16) | y, (w << 16) | h,
        titel, 0, 0)
    if ulib.bad(hh) || hh == 0 {
        return MAXWN
    }
    let i: u64 = nwn
    nwn = nwn + 1
    ns(i, N_H, hh)
    ns(i, N_W, w)
    ns(i, N_HH, h)
    ns(i, N_KIND, kind)
    ns(i, N_VAL, 0)
    ns(i, N_DATA, 0)
    ns(i, N_CNT, 0)
    ns(i, N_OWNER, 0)
    ns(i, N_X, x)
    ns(i, N_Y, y)
    wncur = i
    dirty_all(i)
    say_window(i)
    return i
}

// RUNDE THEMESTORE: JEDES FENSTER SAGT, WO ES STEHT -- und wo seine
// MALFLAECHE anfaengt.
//
// `wlib: text ...` meldet x und Grundlinie IM FENSTER. Wer eine
// Aufnahme des ganzen Bildschirms nachmessen will, braucht dazu den
// Ursprung, und den hatte bisher nur `settings`, weil es ihn selbst
// hinschrieb. Fuer jedes andere Fenster -- den Starter zum Beispiel --
// blieb dem Pruefer nur, 0,0 anzunehmen: er misst dann eine Stelle des
// Schreibtischs und nennt sie eine Beschriftung. Genau so ist in
// dieser Runde eine leere Beschriftung gemeldet worden, die keine war,
// und drei ueberlappende, die sich nicht beruehrten.
//
// Der Versatz wird NICHT nachgerechnet (kein BORDER, kein TITLE_H in
// dieser Datei): er wird beim Server erfragt, der ihn in `inx`/`iny`
// ohnehin fuehrt -- ein Fenster ohne Schmuck bekommt so von selbst 0.
static mut tw_a: [u8; 14] = "wlib: win id=\0"
static mut tw_x: [u8; 4] = " x=\0"
static mut tw_y: [u8; 4] = " y=\0"
static mut tw_w: [u8; 4] = " w=\0"
static mut tw_h: [u8; 4] = " h=\0"
static mut tw_cx: [u8; 5] = " cx=\0"
static mut tw_cy: [u8; 5] = " cy=\0"

// RUNDE DESIGN-2: die Woerter der Bewegungsmeldung.
static mut an_wort: [u8; 12] = "wlib: anim \0"
static mut an_was: [u8; 5] = "was=\0"
static mut an_p: [u8; 4] = " p=\0"
static mut an_dur: [u8; 6] = " dur=\0"
static mut an_wd: [u8; 5] = " wd=\0"
// RUNDE ALLTAG: DIE ANWENDUNG SAGT, WO SIE ALLES HINGELEGT HAT.
//
// In einer Zeile je Bedienelement, im Format, das
// `tools/design/messen.py` und `tools/alltag/shotcheck.py` lesen:
//
//     <name>: rect id=3 kind=2 x=8 y=40 w=100 h=32
//
// Bis hierher hat jedes Programm diese Schleife selbst geschrieben
// (widgetdemo, explorer, settings -- dreimal derselbe Code mit drei
// Puffern). Sie gehoert in die Bibliothek: WAS ein Programm hingelegt
// hat, weiss die Bibliothek besser als das Programm, und ein Pruefer,
// der fuenf verschiedene Schreibweisen lesen muss, misst irgendwann
// eine davon nicht mehr.
fn say_rects(name: u64) {
    var s_r: [u8; 8] = ": rect \0"
    var s_id: [u8; 4] = "id=\0"
    var s_k: [u8; 7] = " kind=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_h: [u8; 4] = " h=\0"
    var i: u64 = 0
    while i < nwd {
        if (g(i, D_FLAGS) & F_HIDE) == 0 {
            ulib.say(name)
            ulib.say((&s_r[0 as usize]) as u64)
            ulib.say((&s_id[0 as usize]) as u64)
            ulib.sayn(i)
            ulib.say((&s_k[0 as usize]) as u64)
            ulib.sayn(g(i, D_KIND))
            ulib.say((&s_x[0 as usize]) as u64)
            ulib.sayn(g(i, D_X))
            ulib.say((&s_y[0 as usize]) as u64)
            ulib.sayn(g(i, D_Y))
            ulib.say((&s_w[0 as usize]) as u64)
            ulib.sayn(g(i, D_W))
            ulib.say((&s_h[0 as usize]) as u64)
            ulib.sayn(g(i, D_H))
            ulib.nl()
        }
        i = i + 1
    }
}

fn say_window(i: u64) {
    if s_trace == 0 || i >= MAXWN {
        return
    }
    // Die gemerkte Stelle kann veraltet sein -- siehe
    // `win_ort_holen`. Sie steht dort schon aufgefrischt, wenn der
    // Aufruf von dort kommt; kommt er von woanders, holt dieser Aufruf
    // sie.
    let hh: u64 = ng(i, N_H)
    if hh == 0 {
        return
    }
    let b: u64 = (&tr_buf[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&tw_a[0 as usize]) as u64)
    at = tr_num(b, at, hh)
    at = tr_put(b, at, (&tw_x[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, N_X))
    at = tr_put(b, at, (&tw_y[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, N_Y))
    at = tr_put(b, at, (&tw_w[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, N_W))
    at = tr_put(b, at, (&tw_h[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, N_HH))
    at = tr_put(b, at, (&tw_cx[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, N_X)
        + wlibc.sys3w(wlibc.WM_INFO, hh, wlibc.WI_INX, 0))
    at = tr_put(b, at, (&tw_cy[0 as usize]) as u64)
    at = tr_num(b, at, ng(i, N_Y)
        + wlibc.sys3w(wlibc.WM_INFO, hh, wlibc.WI_INY, 0))
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(b, at)
}

fn window_kind(w: u64) -> u64 {
    return ng(w, N_KIND)
}

fn handle(w: u64) -> u64 {
    return ng(w, N_H)
}

// Wo das Fenster auf dem BILDSCHIRM steht. Ein Menue liegt am Zeiger
// und nicht an einer Stelle, die ein Testlaeufer erraten kann -- also
// sagt die Bibliothek sie.
fn win_x(w: u64) -> u64 {
    win_ort_holen(w)
    return ng(w, N_X)
}

fn win_y(w: u64) -> u64 {
    win_ort_holen(w)
    return ng(w, N_Y)
}

// RUNDE GLAS: DIE GEMERKTE STELLE IST NICHT DIE WAHRE.
//
// Was hier stand, war die Stelle, an der das Fenster ANGELEGT wurde.
// Der Fensterserver setzt es aber um: an den Arbeitsbereich, wenn die
// Taskleiste oben sitzt, und dorthin, wohin eine Hand es zieht.
// GEMESSEN an der Vorlage `terminal` (edge=top): die Seite meldete
// ihre Statuszeile bei 514 und der Server malte sie bei 564 -- genau
// die 25 Bildpunkte, um die er das Fenster unter die obere Leiste
// gesetzt hatte. Ein Laeufer, der auf eine gemeldete Stelle klickt,
// trifft dann nichts, und die Bildpruefung sucht Buchstaben, wo keine
// sind.
//
// Also wird gefragt statt geglaubt, und die Antwort ersetzt die
// gemerkte Zahl. Der Aufruf kostet einen Systemaufruf und steht an
// keiner Stelle, die je Bildpunkt laeuft: Menues aufsetzen und
// Rechtecke melden, beides Handvoll-Ereignisse.
fn win_ort_holen(w: u64) {
    if w >= MAXWN {
        return
    }
    let h: u64 = ng(w, N_H)
    if h == 0 {
        return
    }
    let x: u64 = wlibc.win_info(h, wlibc.WI_X)
    let y: u64 = wlibc.win_info(h, wlibc.WI_Y)
    if ulib.bad(x) || ulib.bad(y) {
        return
    }
    if x == ng(w, N_X) && y == ng(w, N_Y) {
        return
    }
    ns(w, N_X, x)
    ns(w, N_Y, y)
    // UND DIE MESSUNG ERFAEHRT DAVON. Die Fensterzeile ist der
    // Ursprung, aus dem jeder Pruefer die absoluten Stellen rechnet
    // (`tools/themestore/shotcheck.py` nimmt die letzte je Fenster);
    // eine Verschiebung, die nur im Programm ankommt, waere fuer ihn
    // nicht geschehen.
    say_window(w)
}

// WO DIE MALFLAECHE ANFAENGT, auf dem Bildschirm. Ein Fenster mit
// Schmuck traegt Rahmen und Titelleiste; was ein Programm bei 0,0 malt,
// liegt also nicht bei `win_x`. Wer ein Aufklappmenue UNTER seine
// Menueleiste setzen will, braucht genau diese Summe -- vorher stand
// dafuer `bx + 10` und `by + 22 + 30` im Dateimanager, also drei
// getippte Zahlen, die den Schmuck des Servers nachrechneten.
fn win_cx(w: u64) -> u64 {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return 0
    }
    return ng(w, N_X)
        + wlibc.sys3w(wlibc.WM_INFO, ng(w, N_H), wlibc.WI_INX, 0)
}

fn win_cy(w: u64) -> u64 {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return 0
    }
    return ng(w, N_Y)
        + wlibc.sys3w(wlibc.WM_INFO, ng(w, N_H), wlibc.WI_INY, 0)
}

fn win_w(w: u64) -> u64 {
    return ng(w, N_W)
}

fn win_h(w: u64) -> u64 {
    return ng(w, N_HH)
}

fn closed(w: u64) -> bool {
    return ng(w, N_H) == 0
}

fn close(w: u64) {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return
    }
    wlibc.sys3w(wlibc.WM_CLOSE, ng(w, N_H), 0, 0)
    ns(w, N_H, 0)
    // Die Widgets dieses Fensters verschwinden mit ihm.
    var i: u64 = 0
    while i < nwd {
        if g(i, D_WIN) == w {
            s(i, D_FLAGS, g(i, D_FLAGS) | F_HIDE)
        }
        i = i + 1
    }
}

// ------------------------------------------------- der schmutzige Teil
//
// BIS ZU VIER RECHTECKE JE FENSTER, UND NICHT EINES. Die erste Fassung
// fuehrte EIN Rechteck und legte jede Meldung hinein -- die Vereinigung
// von allem. Das ist bequem und es ist gemessen falsch: bewegt sich der
// Zeiger von einem Knopf oben zu einer Liste unten, sind beide
// schmutzig, die Vereinigung ist das halbe Fenster, und dazwischen wird
// alles neu gemalt, was sich nicht geaendert hat. Gemessen: EIN Klick
// auf ein Kaestchen kostete so 82 992 von 192 000 Bildpunkten -- Faktor
// 2,3 statt Faktor 30.
//
// Also vier Rechtecke, und die Regel zum Zusammenlegen ist eine
// Flaechenregel: zwei werden nur dann eines, wenn die Vereinigung nicht
// mehr als ein Drittel groesser ist als beide zusammen. Sind alle vier
// belegt, wird das Paar zusammengelegt, das dabei am wenigsten
// hinzufuegt -- so bleibt die Zahl beschraenkt und die Flaeche klein.
const DIRT_MAX: u64 = 4

// RUNDE ECHTHARDWARE-2: 80 statt 64 -- dieselbe Rechnung wie bei `wn`
// eine Seite weiter oben, und derselbe Grund: MAXWN ist 5.
// 5 * DIRT_MAX(4) * 4 = 80.
static mut dr: [u64; 80] = [0 as u64; 80] // MAXWN * DIRT_MAX * 4

fn dg(w: u64, k: u64, f: u64) -> u64 {
    return dr[((w * DIRT_MAX + k) * 4 + f) as usize]
}

fn ds(w: u64, k: u64, f: u64, v: u64) {
    dr[((w * DIRT_MAX + k) * 4 + f) as usize] = v
}

fn area(x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    return (x1 - x0) * (y1 - y0)
}

fn setz(w: u64, k: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    ds(w, k, 0, x0)
    ds(w, k, 1, y0)
    ds(w, k, 2, x1)
    ds(w, k, 3, y1)
}

fn vereinen(w: u64, k: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    var a: u64 = dg(w, k, 0)
    var b: u64 = dg(w, k, 1)
    var c: u64 = dg(w, k, 2)
    var d: u64 = dg(w, k, 3)
    if x0 < a {
        a = x0
    }
    if y0 < b {
        b = y0
    }
    if x1 > c {
        c = x1
    }
    if y1 > d {
        d = y1
    }
    setz(w, k, a, b, c, d)
}

fn union_area(w: u64, k: u64, x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    var a: u64 = dg(w, k, 0)
    var b: u64 = dg(w, k, 1)
    var c: u64 = dg(w, k, 2)
    var d: u64 = dg(w, k, 3)
    if x0 < a {
        a = x0
    }
    if y0 < b {
        b = y0
    }
    if x1 > c {
        c = x1
    }
    if y1 > d {
        d = y1
    }
    return area(a, b, c, d)
}

fn dirty(w: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return
    }
    if x1 <= x0 || y1 <= y0 {
        return
    }
    var ax0: u64 = x0
    var ay0: u64 = y0
    var ax1: u64 = x1
    var ay1: u64 = y1
    if ax1 > ng(w, N_W) {
        ax1 = ng(w, N_W)
    }
    if ay1 > ng(w, N_HH) {
        ay1 = ng(w, N_HH)
    }
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    let neu_f: u64 = area(ax0, ay0, ax1, ay1)
    var n: u64 = ng(w, N_NDIRT)
    // 1. Passt es guenstig zu einem der vorhandenen?
    var beste: u64 = DIRT_MAX
    var bester_zuwachs: u64 = 0xFFFFFFFFFFFFFFFF
    var k: u64 = 0
    while k < n {
        let alt_f: u64 = area(dg(w, k, 0), dg(w, k, 1), dg(w, k, 2),
            dg(w, k, 3))
        let uf: u64 = union_area(w, k, ax0, ay0, ax1, ay1)
        if uf * 3 <= (alt_f + neu_f) * 4 {
            let zuwachs: u64 = uf - alt_f
            if zuwachs < bester_zuwachs {
                bester_zuwachs = zuwachs
                beste = k
            }
        }
        k = k + 1
    }
    if beste < DIRT_MAX {
        vereinen(w, beste, ax0, ay0, ax1, ay1)
        return
    }
    // 2. Ist noch ein Platz frei?
    if n < DIRT_MAX {
        setz(w, n, ax0, ay0, ax1, ay1)
        ns(w, N_NDIRT, n + 1)
        return
    }
    // 3. Alle belegt: das Paar zusammenlegen, das am wenigsten kostet.
    var pa: u64 = 0
    var pb: u64 = 1
    var billigst: u64 = 0xFFFFFFFFFFFFFFFF
    var i: u64 = 0
    while i < n {
        var j: u64 = i + 1
        while j < n {
            let fi: u64 = area(dg(w, i, 0), dg(w, i, 1), dg(w, i, 2),
                dg(w, i, 3))
            let fj: u64 = area(dg(w, j, 0), dg(w, j, 1), dg(w, j, 2),
                dg(w, j, 3))
            let u: u64 = union_area(w, i, dg(w, j, 0), dg(w, j, 1),
                dg(w, j, 2), dg(w, j, 3))
            if u - fi - fj < billigst {
                billigst = u - fi - fj
                pa = i
                pb = j
            }
            j = j + 1
        }
        i = i + 1
    }
    vereinen(w, pa, dg(w, pb, 0), dg(w, pb, 1), dg(w, pb, 2), dg(w, pb, 3))
    setz(w, pb, ax0, ay0, ax1, ay1)
}

fn dirty_all(w: u64) {
    ns(w, N_NDIRT, 1)
    setz(w, 0, 0, 0, ng(w, N_W), ng(w, N_HH))
}

fn dirty_wd(i: u64) {
    dirty(g(i, D_WIN), g(i, D_X), g(i, D_Y), g(i, D_X) + g(i, D_W),
        g(i, D_Y) + g(i, D_H))
}

// ------------------------------------------------------- die Anordnung
//
// DREI KAESTEN, UND SIE SETZEN, WAS MAN IHNEN GIBT.
//
//   senkrecht  jedes Widget bekommt die volle Breite des Kastens und
//              seine Wunschhoehe; der Setzpunkt wandert nach unten.
//   waagerecht jedes bekommt seine Wunschbreite und die volle Hoehe;
//              der Setzpunkt wandert nach rechts. Eine Wunschbreite
//              von 0 heisst "nimm, was uebrig ist" -- so bekommt eine
//              Pfadleiste ihren Platz zwischen zwei Knoepfen.
//   Raster     `cols` Spalten gleicher Breite, Zeilenhoehe ist die
//              hoechste Wunschhoehe der Zeile.
//
// Das ist eine Anordnung und kein Loeser. Was sie kann, steht hier;
// was sie nicht kann -- Gewichte, Mindestgroessen, Ausdehnen in beide
// Richtungen zugleich -- steht in docs/ROUNDK15.md unter den Grenzen.
//
// SIE LAEUFT BEI JEDER GROESSENAENDERUNG NEU (`relayout`), und das ist
// der Grund, warum die Kaesten ueberhaupt gespeichert werden statt die
// Rechtecke nur einmal auszurechnen.

// RUNDE ALLTAG: DAS VIERER-RASTER, EINMAL IN DER BIBLIOTHEK.
//
// Jede Laenge, die ein Kasten vergibt, liegt auf einem Vielfachen von
// vier. Vorher kam sie aus der Textbreite eines Knopfes (78, 90, 112)
// oder aus der Schrifthoehe (18) -- Zahlen, die kein Raster kennen,
// und ein Bild, in dem nichts auf einer gemeinsamen Linie steht.
// Gemessen wird das von tools/design/messen.py; hier wird es
// hergestellt, damit KEIN Programm es selbst rechnen muss.
fn r4ab(v: u64) -> u64 {
    return v - (v % 4)
}

fn r4auf(v: u64) -> u64 {
    let r: u64 = v % 4
    if r == 0 {
        return v
    }
    return v + 4 - r
}

fn box_v(w: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64,
    gp: u64) -> u64 {
    return new_box(w, 1, x, y, bw, bh, pad, gp, 1)
}

fn box_h(w: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64,
    gp: u64) -> u64 {
    return new_box(w, 2, x, y, bw, bh, pad, gp, 1)
}

fn box_grid(w: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64, gp: u64,
    cols: u64) -> u64 {
    return new_box(w, 3, x, y, bw, bh, pad, gp, cols)
}

fn new_box(w: u64, kind: u64, x: u64, y: u64, bw: u64, bh: u64, pad: u64,
    gp: u64, cols: u64) -> u64 {
    if nct >= MAXCT {
        return MAXCT
    }
    let c: u64 = nct
    nct = nct + 1
    cs(c, C_KIND, kind)
    // RUNDE ALLTAG: auch die ECKE eines Kastens liegt auf dem Raster.
    // Ein mittig gesetzter Kasten rechnet (1280-420)/2 = 430 aus, und
    // damit stand im Sperrbildschirm KEINE einzige Laenge auf einer
    // Vierer-Linie. Aufgerundet, nicht abgerundet: nach unten koennte
    // ein Kasten, der unter einer Reiterleiste beginnt, in sie
    // hineinrutschen.
    cs(c, C_X, r4auf(x))
    cs(c, C_Y, r4auf(y))
    cs(c, C_W, bw)
    cs(c, C_H, bh)
    cs(c, C_PAD, pad)
    cs(c, C_GAP, gp)
    cs(c, C_COLS, cols)
    cs(c, C_WIN, w)
    reset_box(c)
    ctcur = c
    wncur = w
    return c
}

fn reset_box(c: u64) {
    cs(c, C_CX, cg(c, C_X) + cg(c, C_PAD))
    cs(c, C_CY, cg(c, C_Y) + cg(c, C_PAD))
    cs(c, C_COL, 0)
    cs(c, C_ROWH, 0)
}

fn box_end() {
    ctcur = 0xFFFFFFFFFFFFFFFF
}

// ROUND THEMESTORE: MOVE A BOX AFTER THE FACT.
//
// The two-column Darstellung page needs to know where the tab bar
// ends, and the tab bar's height is a TOKEN -- 26 under `classic`, 32
// under `modern`. So the columns cannot be given a fixed y at build
// time and left there: a shape change at run time would slide the tab
// bar down onto them. The settings program re-measures and calls this
// after every `reshape`, which is exactly what `reshape` exists for.
// WHICH BOX THE NEXT WIDGET GOES INTO. `box_v` and friends both
// CREATE a box and select it; a page laid out in two columns has to be
// able to go back to the first one, and that is all this does.
fn box_use(c: u64) {
    if c >= nct {
        return
    }
    ctcur = c
    wncur = cg(c, C_WIN)
}

fn box_at(c: u64, x: u64, y: u64, bw: u64, bh: u64) {
    if c >= nct {
        return
    }
    cs(c, C_X, r4auf(x))
    cs(c, C_Y, r4auf(y))
    cs(c, C_W, bw)
    cs(c, C_H, bh)
    reset_box(c)
}

// Die Wunschgroesse des NAECHSTEN Widgets. Danach ist sie wieder
// vergessen -- eine Wunschgroesse, die haengenbleibt, ist die Sorte
// Zustand, die man erst bemerkt, wenn drei Knoepfe zu hoch sind.
fn size(w: u64, h: u64) {
    want_w = w
    want_h = h
}

// DAS NAECHSTE ETIKETT DARF UMBRECHEN statt zu kuerzen. Dieselbe
// Machart wie `size`: sie gilt fuer genau ein Bedienelement, sonst
// waere sie ein Zustand, der einem drei Seiten spaeter auffaellt.
fn umbruch() {
    want_flags = want_flags | F_UMBRUCH
}

// RUNDE ALLTAG: die Wunschgroesse NACHTRAEGLICH aendern.
//
// `size` gilt fuer das naechste Bedienelement; danach war die Groesse
// fest. Ein Fenster, das seinen Inhalt an seine eigene Hoehe anpasst
// (die Bildflaeche des Betrachters), braucht genau das -- sonst bleibt
// unter dem Bild ein Streifen Luft stehen, der von nichts kommt.
// `neu_setzen` danach ordnet an.
fn set_size(i: u64, w: u64, h: u64) {
    if i >= nwd {
        return
    }
    s(i, D_PW, w)
    s(i, D_PH, h)
}

fn gap_after(n: u64) {
    want_gap = n
}

fn place(i: u64) {
    let c: u64 = g(i, D_CT)
    if c >= MAXCT {
        return
    }
    let innen: u64 = sub(cg(c, C_W), 2 * cg(c, C_PAD))
    let kind: u64 = cg(c, C_KIND)
    var pw: u64 = g(i, D_PW)
    var ph: u64 = g(i, D_PH)
    if ph == 0 {
        ph = 24
    }
    ph = r4auf(ph)
    if kind == 1 {
        s(i, D_X, cg(c, C_CX))
        s(i, D_Y, cg(c, C_CY))
        var bw: u64 = r4ab(innen)
        if pw != 0 && r4auf(pw) < bw {
            bw = r4auf(pw)
        }
        s(i, D_W, bw)
        // ============ RUNDE GLAS (nachtrag): HOEHE AUS DER BREITE
        //
        // Zwei Bedienelemente wissen erst hier, wie hoch sie sein
        // muessen: die Reiterleiste (passen die Namen in eine Zeile
        // oder braucht sie zwei?) und ein umbrechendes Etikett (passt
        // der Satz in eine Zeile?). Beides haengt an der BREITE, und
        // die steht erst in der Zeile darueber fest -- deshalb wird
        // die Wunschhoehe genau hier und an keiner zweiten Stelle
        // berichtigt. `relayout` geht durch dieselbe Funktion, also
        // stimmt die Hoehe auch nach einem Form- oder Sprachwechsel.
        var ph2: u64 = ph
        if g(i, D_KIND) == K_TABS {
            ph2 = r4auf(tab_h_at(i, bw))
        } else if g(i, D_KIND) == K_LABEL
            && (g(i, D_FLAGS) & F_UMBRUCH) != 0 {
            ph2 = r4auf(label_h_at(i, bw))
        }
        s(i, D_H, ph2)
        cs(c, C_CY, cg(c, C_CY) + ph2 + cg(c, C_GAP))
    } else if kind == 2 {
        let rest: u64 = sub(cg(c, C_X) + cg(c, C_W) - cg(c, C_PAD),
            cg(c, C_CX))
        var bw2: u64 = r4auf(pw)
        if pw == 0 || bw2 > r4ab(rest) {
            bw2 = r4ab(rest)
        }
        s(i, D_X, cg(c, C_CX))
        s(i, D_Y, cg(c, C_CY))
        s(i, D_W, bw2)
        var bh2: u64 = ph
        let hoch: u64 = sub(cg(c, C_H), 2 * cg(c, C_PAD))
        if g(i, D_PH) == 0 && hoch > 0 {
            bh2 = r4ab(hoch)
        }
        s(i, D_H, bh2)
        cs(c, C_CX, cg(c, C_CX) + bw2 + cg(c, C_GAP))
    } else {
        let cols: u64 = cg(c, C_COLS)
        var zw: u64 = 40
        if cols > 0 {
            zw = sub(innen + cg(c, C_GAP), 0) / cols
            if zw > cg(c, C_GAP) {
                zw = zw - cg(c, C_GAP)
            }
            zw = r4ab(zw)
        }
        s(i, D_X, cg(c, C_CX))
        s(i, D_Y, cg(c, C_CY))
        s(i, D_W, zw)
        s(i, D_H, ph)
        if ph > cg(c, C_ROWH) {
            cs(c, C_ROWH, ph)
        }
        cs(c, C_COL, cg(c, C_COL) + 1)
        if cg(c, C_COL) >= cols {
            cs(c, C_COL, 0)
            cs(c, C_CX, cg(c, C_X) + cg(c, C_PAD))
            cs(c, C_CY, cg(c, C_CY) + cg(c, C_ROWH) + cg(c, C_GAP))
            cs(c, C_ROWH, 0)
        } else {
            cs(c, C_CX, cg(c, C_CX) + zw + cg(c, C_GAP))
        }
    }
    if want_gap != 0 {
        if kind == 2 {
            cs(c, C_CX, cg(c, C_CX) + want_gap)
        } else {
            cs(c, C_CY, cg(c, C_CY) + want_gap)
        }
        want_gap = 0
    }
}

// Alle Kaesten von vorn setzen. Wird nach einer Groessenaenderung
// gerufen und nach jeder Aenderung, die Platz kostet.
fn relayout() {
    var c: u64 = 0
    while c < nct {
        // Kaesten, die die volle Fensterbreite wollten, wachsen mit.
        let w: u64 = cg(c, C_WIN)
        if cg(c, C_W) == 0 {
            cs(c, C_W, ng(w, N_W))
        }
        reset_box(c)
        c = c + 1
    }
    var i: u64 = 0
    while i < nwd {
        if (g(i, D_FLAGS) & F_HIDE) == 0 {
            place(i)
        }
        i = i + 1
    }
}

// ============================ ROUND LOOK: THE SHAPE CHANGED UNDER US
//
// A widget takes its height when it is CREATED (`add`), because that is
// when the box it goes into needs to know how much room to leave. Change
// `shape=` at run time and every one of those heights is stale: 32-pixel
// buttons would be drawn into 26-pixel rectangles, the click targets
// would sit where the old ones were, and the page would look like a
// misprint.
//
// So a shape change is a re-measurement and not a repaint. This walks
// the widget table, asks the CURRENT tokens for the height of each kind,
// and lays the boxes out again. Nothing else moves: every widget keeps
// its number, its value, its focus and -- the one that matters -- the
// TEXT POINTER it was given, which is why a shape change and a language
// change can happen in either order.
//
// Widths are left alone except for buttons, whose width is text plus
// padding and therefore also a function of a token.
fn reshape() {
    var i: u64 = 0
    while i < nwd {
        let k: u64 = g(i, D_KIND)
        if k == K_BUTTON {
            s(i, D_H, wlibc.metric(wlibc.M_CTRL_H))
            let t: u64 = g(i, D_TEXT)
            let want: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), t, tlen(t))
                + wlibc.metric(wlibc.M_PAD_X) * 2
            // A button that was given a width by `size()` keeps it --
            // the dialog buttons are meant to be equal, not snug.
            if g(i, D_W) < want {
                s(i, D_W, want)
            }
        } else if k == K_TABS {
            s(i, D_H, wlibc.metric(wlibc.M_CTRL_H))
        } else if k == K_ENTRY || k == K_CHOICE {
            s(i, D_H, ctrl_thin())
        } else if k == K_CHECK || k == K_MENUBAR || k == K_SLIDER {
            // RUNDE TON-2: der Regler richtet sich wie jedes andere
            // Bedienelement nach dem Thema. Ohne diese Zeile behielte
            // er nach einem Themenwechsel seine alte Hoehe, waehrend
            // alles um ihn herum sich aendert.
            s(i, D_H, ctrl_small())
        } else if k == K_SEP {
            s(i, D_H, sep_h())
        } else if k == K_SCROLL {
            s(i, D_W, scroll_w())
        } else if k == K_TILE {
            s(i, D_H, tile_h())
        }
        i = i + 1
    }
    relayout()
}

// ------------------------------------------------------- die Widgets

static mut s_vollwarn: [u8; 42] = "wlib: WIDGETTAFEL VOLL -- MAXWD erreicht\n\0"

fn add(kind: u64, txt: u64, pw: u64, ph: u64, fokus: bool) -> u64 {
    if nwd >= MAXWD {
        // RUNDE O-NETZUI: UND ES WIRD GESAGT.
        //
        // Hier stand nur `return 0`, und 0 ist die Nummer des ERSTEN
        // Bedienelements -- jedes ueberzaehlige Element hat damit still
        // in dessen Platz geschrieben. In den Einstellungen war das die
        // Reiterleiste; die Folge war eine Seite, die beim Reiterwechsel
        // nicht mehr umschaltete, ohne eine einzige Fehlermeldung.
        //
        // Die 0 bleibt der Rueckgabewert (ein anderer waere ein
        // ungueltiger Index, und jeder Aufrufer reicht ihn an `show`
        // und `set_text` weiter) -- aber sie kommt jetzt mit einer
        // Zeile auf der Leitung, und `tools/netzui/run.sh` sucht sie.
        let _vw: u64 = ulib.say((&s_vollwarn[0 as usize]) as u64)
        return 0
    }
    let i: u64 = nwd
    nwd = nwd + 1
    s(i, D_KIND, kind)
    s(i, D_TEXT, txt)
    s(i, D_WIN, wncur)
    s(i, D_CT, ctcur)
    s(i, D_PW, want_w)
    s(i, D_PH, want_h)
    if want_w == 0 {
        s(i, D_PW, pw)
    }
    if want_h == 0 {
        s(i, D_PH, ph)
    }
    want_w = 0
    want_h = 0
    var fl: u64 = want_flags
    want_flags = 0
    if fokus {
        fl = fl | F_FOCUSABLE
    }
    s(i, D_FLAGS, fl)
    place(i)
    if s_focus == 0 && fokus {
        s_focus = i + 1
    }
    return i
}

fn label(txt: u64) -> u64 {
    return add(K_LABEL, txt, 0, wlibc.text_h(wlibc.px_ui()), false)
}

// EINE KARTE. Sie nimmt den Platz, den ihr Kasten ihr gibt -- also
// `size(bw, bh)` davor, wie bei jedem anderen Bedienelement.
fn card() -> u64 {
    return add(K_CARD, 0, 0, 0, false)
}

// RUNDE WERKZEUGE: der Verlaufsgraph. Er nimmt den Platz, den sein
// Kasten ihm gibt -- also `size(bw, bh)` davor, wie bei jedem anderen
// Bedienelement.
fn graph(spec: u64) -> u64 {
    let i: u64 = add(K_GRAPH, 0, 0, 0, false)
    s(i, D_A, spec)
    return i
}

fn canvas(px: u64, bw: u64, bh: u64) -> u64 {
    let i: u64 = add(K_CANVAS, px, bw, bh, true)
    s(i, D_A, bw)
    s(i, D_B, bh)
    s(i, D_C, bw)
    return i
}

// Ein anderer Puffer (nach einer Groessenaenderung): Zeiger, Breite,
// Hoehe, Zeilenlaenge in Bildpunkten.
fn canvas_set(i: u64, px: u64, bw: u64, bh: u64, zeile: u64) {
    if i >= nwd || g(i, D_KIND) != K_CANVAS {
        return
    }
    s(i, D_TEXT, px)
    s(i, D_A, bw)
    s(i, D_B, bh)
    s(i, D_C, zeile)
    dirty_wd(i)
}

// Die Bildpunkte haben sich geaendert -- ganz ...
fn canvas_new(i: u64) {
    if i >= nwd {
        return
    }
    dirty_wd(i)
}

// ... oder in einem Ausschnitt (in Leinwandkoordinaten, [x0,x1) x [y0,y1)).
fn canvas_new_part(i: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if i >= nwd {
        return
    }
    var ax: u64 = g(i, D_X) + x1
    var ay: u64 = g(i, D_Y) + y1
    if ax > g(i, D_X) + g(i, D_W) {
        ax = g(i, D_X) + g(i, D_W)
    }
    if ay > g(i, D_Y) + g(i, D_H) {
        ay = g(i, D_Y) + g(i, D_H)
    }
    dirty(g(i, D_WIN), g(i, D_X) + x0, g(i, D_Y) + y0, ax, ay)
}

fn lw_push(i: u64, art: u64, a: u64, b: u64) {
    // Eine Bewegung ersetzt die vorige, wenn sie zuoberst liegt.
    if art == LE_MOVE && lw_head != lw_tail {
        let letzte: u64 = ((lw_head + LW_RING - 1) % LW_RING) * LE_FELDER
        if lw_q[(letzte + 1) as usize] == LE_MOVE
            && lw_q[(letzte) as usize] == i {
            lw_q[(letzte + 2) as usize] = a
            lw_q[(letzte + 3) as usize] = b
            return
        }
    }
    let naechste: u64 = (lw_head + 1) % LW_RING
    if naechste == lw_tail {
        // Voll: das aelteste faellt weg. Ein Ring, der den neuesten
        // Klick verwirft, waere der schlechtere.
        lw_tail = (lw_tail + 1) % LW_RING
    }
    let at: u64 = lw_head * LE_FELDER
    lw_q[(at) as usize] = i
    lw_q[(at + 1) as usize] = art
    lw_q[(at + 2) as usize] = a
    lw_q[(at + 3) as usize] = b
    lw_head = naechste
}

// Das naechste Ereignis der Leinwand in vier Woerter (Widget, Art, a,
// b) hinter `aus`. false = keines.
fn canvas_event(aus: u64) -> bool {
    if lw_head == lw_tail {
        return false
    }
    let at: u64 = lw_tail * LE_FELDER
    __mmio_write64((aus) as *mut u64, lw_q[(at) as usize])
    __mmio_write64((aus + 8) as *mut u64, lw_q[(at + 1) as usize])
    __mmio_write64((aus + 16) as *mut u64, lw_q[(at + 2) as usize])
    __mmio_write64((aus + 24) as *mut u64, lw_q[(at + 3) as usize])
    lw_tail = (lw_tail + 1) % LW_RING
    return true
}

fn canvas_pending() -> u64 {
    return (lw_head + LW_RING - lw_tail) % LW_RING
}

// Das Malen: der Ausschnitt des Streifens, den die Leinwand bedeckt,
// Zeile fuer Zeile aus dem Puffer des Aufrufers. Was die Leinwand nicht
// bedeckt (ein Widget, das groesser ist als sein Puffer), behaelt den
// Hintergrund, den `paint_bg` schon gemalt hat.
fn paint_canvas(i: u64) {
    let px: u64 = g(i, D_TEXT)
    if px == 0 {
        return
    }
    let bw: u64 = g(i, D_A)
    let bh: u64 = g(i, D_B)
    let zeile: u64 = g(i, D_C)
    var ww: u64 = g(i, D_W)
    if ww > bw {
        ww = bw
    }
    var hh: u64 = g(i, D_H)
    if hh > bh {
        hh = bh
    }
    var x0: u64 = g(i, D_X)
    var x1: u64 = g(i, D_X) + ww
    var y0: u64 = g(i, D_Y)
    var y1: u64 = g(i, D_Y) + hh
    if x0 < wlibc.clip_x0() {
        x0 = wlibc.clip_x0()
    }
    if x1 > wlibc.clip_x1() {
        x1 = wlibc.clip_x1()
    }
    if y0 < wlibc.clip_y0() {
        y0 = wlibc.clip_y0()
    }
    if y1 > wlibc.clip_y1() {
        y1 = wlibc.clip_y1()
    }
    let band: u64 = wlibc.band_y()
    let rows: u64 = wlibc.surf_rows()
    let sw: u64 = wlibc.surf_w()
    if x1 > sw {
        x1 = sw
    }
    if x1 <= x0 {
        return
    }
    if y0 < band {
        y0 = band
    }
    if y1 > band + rows {
        y1 = band + rows
    }
    let n: u64 = (x1 - x0) * 4
    var y: u64 = y0
    while y < y1 {
        let quelle: u64 = px + ((y - g(i, D_Y)) * zeile + (x0 - g(i, D_X))) * 4
        let ziel: u64 = wlibc.surface() + ((y - band) * sw + x0) * 4
        ulib.copy(ziel, quelle, n)
        y = y + 1
    }
}

fn gspec(i: u64, f: u64) -> u64 {
    let p: u64 = g(i, D_A)
    if p == 0 {
        return 0
    }
    return __mmio_read64((p + f * 8) as *mut u64)
}

// WO EIN MESSPUNKT LIEGT. Die beiden Funktionen sind EXPORTIERT, damit
// ein Testlaeufer im Bild an derselben Stelle nachsehen kann, an der
// gemalt wurde -- und nicht an einer, die er selbst ausgerechnet hat.
// Dieselbe Regel wie bei `rect_x` und `text_base` seit Runde K15.
fn graph_x(i: u64, k: u64) -> u64 {
    let hist: u64 = gspec(i, GR_HIST)
    if hist == 0 {
        return g(i, D_X)
    }
    return g(i, D_X) + 1 + k * sub(g(i, D_W), 2) / hist
}

fn graph_y(i: u64, v: u64) -> u64 {
    var m: u64 = gspec(i, GR_MAX)
    if m == 0 {
        m = 1
    }
    var w: u64 = v
    if w > m {
        w = m
    }
    let innen: u64 = sub(g(i, D_H), 3)
    return g(i, D_Y) + 1 + innen - w * innen / m
}

fn graph_value(p: u64, k: u64) -> u64 {
    if p == 0 {
        return 0
    }
    return __mmio_read64((p + k * 8) as *mut u64)
}

// EINE KURVE. `dick` ist zwei Bildpunkte breit und durchgezogen, duenn
// ist einer und nur an jeder zweiten Stelle gemalt -- der zweite
// Unterschied neben der Farbe, damit die zwei Reihen auch dann zu
// trennen sind, wenn jemand die Farben nicht unterscheiden kann.
fn paint_curve(i: u64, reihe: u64, farbe: u64, dick: bool) {
    let n: u64 = gspec(i, GR_N)
    if reihe == 0 || n == 0 {
        return
    }
    var k: u64 = 0
    while k < n {
        let x: u64 = graph_x(i, k)
        let y: u64 = graph_y(i, graph_value(reihe, k))
        var y0: u64 = y
        if k > 0 {
            y0 = graph_y(i, graph_value(reihe, k - 1))
        }
        var oben: u64 = y
        var unten: u64 = y0
        if y0 < y {
            oben = y0
            unten = y
        }
        if dick {
            wlibc.rect(x, oben, 2, unten - oben + 2, farbe)
        } else if (k % 2) == 0 {
            wlibc.rect(x, oben, 1, unten - oben + 1, farbe)
        }
        k = k + 1
    }
}

fn paint_graph(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    if bw < 8 || bh < 8 {
        return
    }
    // RUNDE GLAS: der Radius kommt aus der ROLLE und nicht mehr aus der
    // Marke daneben -- eine Tafel ist eine Tafel, egal ob ein Diagramm
    // oder eine Karte darauf steht.
    let r: u64 = typ_radius(RT_TAFEL, MR_TAFEL, bw, bh)
    wlibc.rrect(x, y, bw, bh, r,
        wlibc.theme_semantic(wlibc.S_SURFACE_SUNKEN))
    wlibc.rring(x, y, bw, bh, r, 1, wlibc.theme_semantic(wlibc.S_BORDER))
    // Das Gitter bei einem, zwei und drei Vierteln. Ohne es ist eine
    // Kurve eine Linie ohne Massstab.
    var q: u64 = 1
    while q < 4 {
        wlibc.hline(x + 1, y + bh * q / 4, sub(bw, 2),
            wlibc.theme_semantic(wlibc.S_BORDER))
        q = q + 1
    }
    paint_curve(i, gspec(i, GR_B), wlibc.theme_semantic(wlibc.S_SUCCESS),
        false)
    paint_curve(i, gspec(i, GR_A), wlibc.theme_semantic(wlibc.S_ACCENT),
        true)
}

// ROUND LOOK: THE SIZE OF A CONTROL IS A TOKEN, NOT A LITERAL.
// `24` was two lots of twelve and `26` was a height; both are now
// asked for, and with `shape=classic` both come back as 24 and 26.
fn button(txt: u64) -> u64 {
    let pad: u64 = wlibc.metric(wlibc.M_PAD_X)
    let w: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), txt, tlen(txt))
        + pad * 2
    return add(K_BUTTON, txt, w, wlibc.metric(wlibc.M_CTRL_H), true)
}

// RUNDE EXPLORER-2, Pflichtpunkt 12: EIN KNOPF MIT EINEM SYMBOL.
//
// `cp` ist ein Zeichenplatz aus `lib/icons.fi` (NAV_BACK, NAV_UP ...),
// NICHT der Wert aus `icon_id` -- die Marke aus Bit 63 gehoert in die
// Symbolfelder von Listen, hier steht der Platz nackt.
//
// `txt` traegt weiter die Beschriftung fuer den Vorleser und fuer
// `say_painted`; sie wird nur NICHT gemalt. Ein Knopf, dessen Bild
// allein die Bedeutung traegt, ist fuer einen Vorleser ein leerer
// Knopf -- deshalb ist der Text hier Pflicht und nicht wahlfrei.
//
// DIE BREITE IST DIE HOEHE. Ein Symbolknopf ist quadratisch; die
// Hoehe kommt wie bei jedem anderen Knopf aus `M_CTRL_H`, damit die
// Werkzeugleiste eine Kante hat und keine Treppe.
fn icon_button(cp: u64, txt: u64) -> u64 {
    let h: u64 = wlibc.metric(wlibc.M_CTRL_H)
    let i: u64 = add(K_BUTTON, txt, h, h, true)
    if i < MAXWD {
        s(i, D_BICON, cp)
    }
    return i
}

// RUNDE TON-2: EIN SCHIEBEREGLER, 0..100.
//
// `txt` ist die Beschriftung LINKS davon (0 = keine). Der Wert steht
// wie bei jedem anderen Widget in `value`/`set_value`.
//
// DIE HOEHE IST `ctrl_small()` UND NICHT DIE DER RINNE. Die Rinne ist
// vier Bildpunkte hoch; ein Widget, das nur vier Bildpunkte hoch ist,
// laesst sich nicht treffen. Gemessen wird die Klickflaeche
// (tools/design/messen.py, Frage 2, Grenze 32 Bildpunkte), und die
// ist hier die ganze Widgethoehe.


fn check(txt: u64, on: bool) -> u64 {
    let i: u64 = add(K_CHECK, txt, 0, ctrl_small(), true)
    if on {
        s(i, D_VAL, 1)
    }
    return i
}

// Ein Textfeld arbeitet auf dem Puffer DES AUFRUFERS. Die Bibliothek
// legt keinen an: wer den Text hinterher braucht, hat ihn dann schon.
fn entry(buf: u64, max: u64) -> u64 {
    let i: u64 = add(K_ENTRY, buf, 0, ctrl_thin(), true)
    s(i, D_D, max)
    s(i, D_B, tlen(buf))
    s(i, D_C, tlen(buf))
    return i
}

fn list(blob: u64, rows: u64) -> u64 {
    let i: u64 = add(K_LIST, blob, 0, rows * lines_height() + 4, true)
    s(i, D_VAL, 0)
    s(i, D_A, 0)
    count_rows(i)
    return i
}

// Eine Tabelle bekommt die Zeilen als EINEN Text: Spalten durch
// Tabulator getrennt, Zeilen durch Zeilenumbruch. Kein Modell, keine
// Rueckrufe -- die Sprache hat keine Funktionszeiger, und ein
// Zeilenpuffer ist das, was ein Dateimanager ohnehin baut.
// Ein Klick genuegt. Fuer das Startmenue; ueberall sonst bleibt es
// beim Doppelklick.
// ================================================== RUNDE FUI-WIN11
// ZWEI ZEILEN JE EINTRAG AN- ODER ABSCHALTEN.
//
// Der Text bleibt EIN Block mit einem Eintrag je Zeilenumbruch; die
// zweite Haelfte steht hinter einem TABULATOR. Damit aendert sich an
// Auswahl, Rollversatz und `D_VAL` nichts -- ein Eintrag bleibt ein
// Eintrag, er ist nur doppelt so hoch.
fn list_zwei(i: u64, an: bool) {
    if i >= MAXWD {
        return
    }
    var v: u64 = 0
    if an {
        v = 1
    }
    s(i, D_ZWEI, v)
    dirty_wd(i)
}

fn list_einklick(i: u64, an: bool) {
    if i >= MAXWD {
        return
    }
    if an {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_EINKLICK)
    } else {
        s(i, D_FLAGS, g(i, D_FLAGS) & ~F_EINKLICK)
    }
}

fn table(blob: u64, rows: u64, cols: u64, breiten: u64) -> u64 {
    let i: u64 = add(K_TABLE, blob, 0,
        rows * lines_height() + lines_height() + 4, true)
    s(i, D_C, cols)
    s(i, D_D, breiten)
    s(i, D_VAL, 0)
    s(i, D_A, 0)
    count_rows(i)
    return i
}

fn tabs(txt: u64) -> u64 {
    return add(K_TABS, txt, 0, wlibc.metric(wlibc.M_CTRL_H), true)
}

fn menubar(txt: u64) -> u64 {
    return add(K_MENUBAR, txt, 0, ctrl_small(), false)
}

fn choice(txt: u64, sel: u64) -> u64 {
    let i: u64 = add(K_CHOICE, txt, 0, ctrl_thin(), true)
    s(i, D_VAL, sel)
    return i
}

// ============================ RUNDE ALLTAG: DIE BILDFLAECHE
//
// Sie bekommt einen Zeiger auf ein Feld aus u32 (0xAARRGGBB, eine Zahl
// je Bildpunkt, zeilenweise) und malt es -- vergroessert, verschoben,
// gedreht. Die Bibliothek KOPIERT das Bild nicht: ein Foto sind
// Megabytes, und ein Prozess dieses Systems hat sechs davon.
//
// VERGROESSERT WIRD MIT DEM NAECHSTEN NACHBARN. Das ist die richtige
// Wahl fuer das, wofuer diese Flaeche da ist: ein Bildschirmfoto beim
// Hineinzoomen soll KANTEN zeigen und keine weichgezeichnete Ahnung
// davon, wo der Text stand.
fn image(p: u64, w: u64, h: u64) -> u64 {
    let i: u64 = add(K_IMAGE, 0, 0, 0, true)
    s(i, D_E, p)
    s(i, D_F, w)
    s(i, D_G, h)
    s(i, D_ZOOM, 100)
    s(i, D_PX, 0)
    s(i, D_PY, 0)
    s(i, D_DREH, 0)
    return i
}

fn image_set(i: u64, p: u64, w: u64, h: u64) {
    if i >= nwd || g(i, D_KIND) != K_IMAGE {
        return
    }
    s(i, D_E, p)
    s(i, D_F, w)
    s(i, D_G, h)
    s(i, D_PX, 0)
    s(i, D_PY, 0)
    s(i, D_DREH, 0)
    s(i, D_ZOOM, 100)
    dirty_wd(i)
}

fn image_bw(i: u64) -> u64 {
    if g(i, D_DREH) == 1 || g(i, D_DREH) == 3 {
        return g(i, D_G)
    }
    return g(i, D_F)
}

fn image_bh(i: u64) -> u64 {
    if g(i, D_DREH) == 1 || g(i, D_DREH) == 3 {
        return g(i, D_F)
    }
    // D_G ist die Hoehe DES BILDES. Hier stand D_H -- die Hoehe des
    // WIDGETS -- und damit war das Bild nie senkrecht mittig und
    // "Anpassen" rechnete mit der falschen Zahl. Im Bild zu sehen: das
    // Foto klebte oben am Rand.
    return g(i, D_G)
}

// Welches Werkzeug die Maus auf der Bildflaeche ist: 0 schiebt das
// Bild, 1 zieht einen Ausschnitt auf. Das Ausschnittwerkzeug braucht
// das zweite, der Betrachter das erste.
fn image_tool(i: u64, m: u64) {
    if i >= nwd || g(i, D_KIND) != K_IMAGE {
        return
    }
    s(i, D_WZ, m)
    s_aus_da = 0
    dirty_wd(i)
}

// Die Ecke des Bildes auf dem Schirm -- dieselbe Rechnung wie in
// `paint_bild`, und deshalb steht sie einmal hier und nicht zweimal.
fn image_ox(i: u64) -> u64 {
    let zw: u64 = image_bw(i) * g(i, D_ZOOM) / 100
    var ox: u64 = g(i, D_X)
    if zw < g(i, D_W) {
        ox = g(i, D_X) + (g(i, D_W) - zw) / 2
    }
    return ox +% g(i, D_PX)
}

fn image_oy(i: u64) -> u64 {
    let zh: u64 = image_bh(i) * g(i, D_ZOOM) / 100
    var oy: u64 = g(i, D_Y)
    if zh < g(i, D_H) {
        oy = g(i, D_Y) + (g(i, D_H) - zh) / 2
    }
    return oy +% g(i, D_PY)
}

// Ein Punkt auf dem Schirm als Punkt IM BILD. Ausserhalb wird auf den
// Rand geklemmt -- wer ueber den Rand hinauszieht, meint den Rand.
fn image_px(i: u64, x: u64) -> u64 {
    let ox: u64 = image_ox(i)
    if x <= ox {
        return 0
    }
    let v: u64 = (x - ox) * 100 / g(i, D_ZOOM)
    if v >= g(i, D_F) {
        return g(i, D_F) - 1
    }
    return v
}

fn image_py(i: u64, y: u64) -> u64 {
    let oy: u64 = image_oy(i)
    if y <= oy {
        return 0
    }
    let v: u64 = (y - oy) * 100 / g(i, D_ZOOM)
    if v >= g(i, D_G) {
        return g(i, D_G) - 1
    }
    return v
}

fn img_out_present() -> bool {
    return s_aus_da != 0
}

fn img_out_x0() -> u64 {
    if s_aus_x1 < s_aus_x0 {
        return s_aus_x1
    }
    return s_aus_x0
}

fn img_out_y0() -> u64 {
    if s_aus_y1 < s_aus_y0 {
        return s_aus_y1
    }
    return s_aus_y0
}

fn img_out_x1() -> u64 {
    if s_aus_x1 < s_aus_x0 {
        return s_aus_x0
    }
    return s_aus_x1
}

fn img_out_y1() -> u64 {
    if s_aus_y1 < s_aus_y0 {
        return s_aus_y0
    }
    return s_aus_y1
}

fn img_out_gone() {
    s_aus_da = 0
}

fn image_zoom(i: u64) -> u64 {
    return g(i, D_ZOOM)
}

fn image_set_zoom(i: u64, z: u64) {
    if i >= nwd || g(i, D_KIND) != K_IMAGE {
        return
    }
    var v: u64 = z
    if v < 5 {
        v = 5
    }
    if v > 3200 {
        v = 3200
    }
    s(i, D_ZOOM, v)
    dirty_wd(i)
}

fn image_pan(i: u64, dx: u64, dy: u64) {
    if i >= nwd || g(i, D_KIND) != K_IMAGE {
        return
    }
    s(i, D_PX, g(i, D_PX) +% dx)
    s(i, D_PY, g(i, D_PY) +% dy)
    dirty_wd(i)
}

fn image_rotate(i: u64, r: u64) {
    if i >= nwd || g(i, D_KIND) != K_IMAGE {
        return
    }
    s(i, D_DREH, (g(i, D_DREH) + r) & 3)
    s(i, D_PX, 0)
    s(i, D_PY, 0)
    dirty_wd(i)
}

fn image_rot_from(i: u64) -> u64 {
    return g(i, D_DREH)
}

// So gross, dass es ganz hineinpasst -- und nie ueber 100 Prozent, denn
// ein kleines Symbol auf Fensterbreite gezogen ist kein Bild mehr.
fn image_fit(i: u64) {
    if i >= nwd || g(i, D_KIND) != K_IMAGE {
        return
    }
    let bw: u64 = image_bw(i)
    let bh: u64 = image_bh(i)
    if bw == 0 || bh == 0 {
        return
    }
    var z: u64 = g(i, D_W) * 100 / bw
    let zy: u64 = g(i, D_H) * 100 / bh
    if zy < z {
        z = zy
    }
    if z > 100 {
        z = 100
    }
    if z < 5 {
        z = 5
    }
    s(i, D_ZOOM, z)
    s(i, D_PX, 0)
    s(i, D_PY, 0)
    dirty_wd(i)
}

// ============================ RUNDE ALLTAG: DER SCHIEBEREGLER
//
// Wert zwischen `min` und `max`. Er meldet sich beim Ziehen UND beim
// Loslassen; wer nur das Ergebnis will, sieht auf `value` beim
// Loslassen, wer mitziehen will (die Vergroesserung im Bildbetrachter),
// nimmt jede Meldung.
fn slider(min: u64, max: u64, wert: u64) -> u64 {
    let i: u64 = add(K_SLIDER, 0, 0, ctrl_small(), true)
    s(i, D_E, min)
    s(i, D_F, max)
    if max <= min {
        s(i, D_F, min + 1)
    }
    s(i, D_VAL, wert)
    return i
}

// RUNDE GLAS: DER WERT ALS ANTEIL DER BAHN, in Prozent.
//
// Das Malen braucht dieselbe Rechnung wie das Treffen, nur andersherum:
// `slider_setz` macht aus einer Stelle einen Wert, das hier macht aus
// einem Wert eine Stelle. Sie steht einmal da, damit beide nicht eines
// Tages verschiedene Bahnen meinen -- derselbe Grund, aus dem
// `slider_bahn` einmal dasteht.
fn slider_anteil(i: u64) -> u64 {
    let lo: u64 = g(i, D_E)
    let hi: u64 = g(i, D_F)
    var v: u64 = g(i, D_VAL)
    if v < lo {
        v = lo
    }
    if v > hi {
        v = hi
    }
    if hi <= lo {
        return 0
    }
    return (v - lo) * 100 / (hi - lo)
}

fn slider_setz(i: u64, x: u64) {
    let lo: u64 = g(i, D_E)
    let hi: u64 = g(i, D_F)
    let bx: u64 = g(i, D_X) + thumb_w() / 2
    let bw: u64 = g(i, D_W) - thumb_w()
    var v: u64 = lo
    if bw > 0 {
        if x > bx {
            let d: u64 = x - bx
            if d >= bw {
                v = hi
            } else {
                v = lo + (hi - lo) * d / bw
            }
        }
    }
    if v != g(i, D_VAL) {
        s(i, D_VAL, v)
        dirty_wd(i)
    }
}

fn sep() -> u64 {
    return add(K_SEP, 0, 0, sep_h(), false)
}

// ============================ ROUND THEMESTORE: THE PREVIEW TILE
//
// Justin's words were "eine Vorschaukachel, die das ECHTE Aussehen
// zeigt (aus den Token gerendert, kein gemaltes Bild, das spaeter nicht
// mehr stimmt)". So there is no bitmap anywhere in this round.
//
// A tile is handed a block of `TILE_FIELDS` words -- the resolved
// component colours of ONE preset, its two corner radii, its shadow
// strength, which edge its taskbar sits on and where its buttons
// start -- and it draws a miniature of a desktop out of them with the
// same `rrect`, `rframe` and `drop_shadow` the real window uses. If a
// scheme file changes, the tile changes with it, because the tile was
// never a picture of the scheme; it is the scheme, drawn small.
//
// The block belongs to the CALLER, exactly like the buffer behind an
// entry field. This library does not resolve themes and is not going
// to start: `wlibc.theme_probe` resolves, `vorlage.fi` decides what to
// probe, and this draws what it is given.
// THE MINIATURE'S OWN GEOMETRY, NAMED.
//
// `tests/look/rawmetric.py` counts literal sizes in the argument
// positions of the drawing calls, and it would count every one of
// these -- rightly, by its own rule: a painting routine must not name
// a size. These are not interface sizes, they are the proportions of a
// PICTURE of an interface, and the honest way to say so is to give
// each of them a name and a reason here rather than to add an
// exception to the checker. A checker with an exception for the file
// that was just written is not a checker.
const TP_W: u64 = 92 // the picture half of a tile
const TP_BAR: u64 = 5 // the miniature taskbar
const TP_BTN: u64 = 14 // the button on it
const TP_WX: u64 = 8 // the window's inset from the picture's left
const TP_WY: u64 = 6 // and from its top
const TP_WW: u64 = 60 // the miniature window
const TP_TITLE: u64 = 7 // its title bar
const TP_LINE: u64 = 2 // a line of body text
const TP_MARK: u64 = 22 // the mark on the title bar
const TILE_FIELDS: u64 = 17
const TL_SURFACE: u64 = 0
const TL_RAISED: u64 = 1
const TL_ACCENT: u64 = 2
const TL_ONACCENT: u64 = 3
const TL_TEXT: u64 = 4
const TL_FRAME: u64 = 5
const TL_TASKBAR: u64 = 6
const TL_TBTEXT: u64 = 7
const TL_BUTTON: u64 = 8
const TL_RADW: u64 = 9
const TL_RADB: u64 = 10
const TL_SHADOW: u64 = 11
const TL_EDGE: u64 = 12
const TL_ALIGN: u64 = 13
const TL_NAME: u64 = 14
const TL_LOW: u64 = 15
const TL_DANGER: u64 = 16

fn tile(spec: u64) -> u64 {
    let i: u64 = add(K_TILE, 0, 0, tile_h(), true)
    s(i, D_A, spec)
    return i
}

// ONE ROW PLUS EIGHT PIXELS: 28 under `classic`, 32 under `modern`.
//
// That is not a taste, it is the answer to a subtraction. The window
// has 542 usable pixels, the tab bar and the status line take 92 of
// them, and ten tiles plus their heading plus the gaps have to fit in
// what is left. The number is derived from the `row` token so that it
// follows the shape instead of being measured once for one of them.
//
// RUNDE ALLTAG: ACHT UND NICHT ZEHN. Seit dieser Runde liegt jede
// Laenge, die ein Kasten vergibt, auf dem Vierer-Raster; `row + 10`
// ergab 34, wurde auf 36 aufgerundet, und die zehnte Kachel fiel
// unten aus dem Kasten heraus -- sichtbar daran, dass "Werkstatt"
// gemalt wurde und im Bild kein einziger Bildpunkt davon ankam.
// `row + 8` ist selbst schon ein Vielfaches von vier (32 unter
// `modern`), wird also nicht mehr gerundet, und zehn Kacheln haben
// wieder Luft.
fn tile_h() -> u64 {
    return wlibc.metric(wlibc.M_ROW) + 8
}

fn tspec(i: u64, f: u64) -> u64 {
    let p: u64 = g(i, D_A)
    if p == 0 {
        return 0
    }
    return __mmio_read64((p + f * 8) as *mut u64)
}

// WIE WEIT EINE RUNDUNG IN EINER BESTIMMTEN HOEHE NACH INNEN GREIFT.
//
// Eine Flaeche mit Radius `r` ist in der Zeile `d` unter ihrer Kante um
// so viele Bildpunkte schmaler, als dieser Wert sagt: der kleinste `e`,
// fuer den der Punkt (r-e, r-d) noch im Viertelkreis liegt. Das ist
// dieselbe Bedingung, mit der `wlibc.rrect` seine Ecken deckt --
// deshalb wird hier auch nichts gemalt, sondern nur GERECHNET: wer ein
// Rechteck in eine gerundete Flaeche legt, ruckt es um diese Zahl ein
// und liegt damit garantiert innerhalb desselben Umrisses. Eine
// Wurzel braucht es dafuer nicht; bei hoechstens 24 Durchgaengen ist
// die Schleife billiger als jede Naeherung und dazu exakt.
fn ecke_ein(r: u64, d: u64) -> u64 {
    if r <= d {
        return 0
    }
    let b: u64 = r - d
    var e: u64 = 0
    while e < r {
        let a: u64 = r - e
        if a * a + b * b <= r * r {
            return e
        }
        e = e + 1
    }
    return r
}

fn paint_tile(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let w: u64 = g(i, D_W)
    let h: u64 = g(i, D_H)
    if w < 40 || h < 20 {
        return
    }
    // THE PICTURE HALF IS ON THE RIGHT AND IS ALWAYS THE SAME SHAPE, so
    // that ten tiles under each other can be compared by eye and by a
    // pixel reader. 96 wide; the name gets the rest.
    //
    // RUNDE GLAS (nachtrag): UND SIE LIEGT INNERHALB DER RUNDUNG.
    //
    // Die Vorschau sass bis hierher buendig an der rechten Kante der
    // Kachel (`x + w - pw`), die Kachel selbst ist aber RUND. Der
    // senkrechte Balken der Miniaturleiste an der rechten Kante
    // (`edge=rechts`, die Vorlagen "Tafel" und "Studio") lief damit an
    // der Rundung vorbei ins Freie: im Bild 09 ein sechs Bildpunkte
    // breiter Farbschlitz bei x=768..774, ausserhalb des Umrisses und
    // ausserhalb der Spalte. `ecke_ein` sagt, wie weit die Rundung an
    // der Hoehe der Vorschau (4 Bildpunkte unter der Kante) nach innen
    // greift; um genau so viel rueckt die Vorschau ein. Damit liegt
    // JEDE Flaeche der Kachel -- Fuellung, Leiste, Knopf, Fenster --
    // innerhalb desselben Umrisses, ohne dass ein zweiter Rasterizer
    // dafuer noetig waere.
    let rk: u64 = typ_radius(RT_KACHEL, MR_TAFEL, w, h)
    let rkant: u64 = ecke_ein(rk, 4)
    let pw: u64 = TP_W
    let px: u64 = sub(x + sub(w, pw), rkant)
    let ph: u64 = sub(h, 8)
    let py: u64 = y + 4
    let sel: bool = g(i, D_VAL) != 0
    // the tile's own surface, and the frame that says which one is
    // chosen -- the frame is the only part of a tile that comes from
    // the RUNNING theme, because "selected" is a fact about this
    // window and not about the preset.
    // RUNDE 32: fUi malt Flaeche und Auswahlring. Die FARBE kommt
    // weiter aus `tspec(i, TL_SURFACE)` -- eine Kachel traegt ihre
    // Farben selbst (Vorschaukacheln der Themenauswahl zeigen ein
    // ANDERES Schema als das laufende), und die darf fUi nicht
    // ueberstimmen. `sel` bleibt der Zustand des Aufrufers.
    // RUNDE GLAS: dreimal dieselbe Marke abgetippt -- jetzt einmal aus
    // der Rolle geholt (`rk`, oben). Flaeche und Ring MUESSEN dieselbe
    // Zahl haben, sonst liegt der Ring bei einem gedrehten Regler
    // neben der Kante.
    // ============================================ RUNDE GLAS (nachtrag)
    // FLAECHE UND RAHMEN KOMMEN AUS DERSELBEN ECKENDECKUNG, und der
    // Grund dafuer stand als heller Keil im Bild 09.
    //
    // Die Flaeche kam bis hierher aus `fuib.tafel` (dem Vektorrasterer)
    // und der Rahmen aus `wlibc.rring` (der Eckendeckung `corner_cov`)
    // -- zwei Rasterer fuer EINE Form. Das war nicht nur unsauber,
    // sondern SICHTBAR: `fuib.tafel` beschneidet ein Rechteck, das oben
    // aus dem Malband herausragt, auf die Bandkante und rundet danach
    // die Ecken des BESCHNITTENEN Rechtecks (kernel/user/fuib.fi, "ein
    // Rechteck, das oben aus dem Band herausragt, wird beschnitten").
    // Liegt die Bandkante mitten in einer Kachel, malt die Bruecke also
    // eine runde Ecke MITTEN IN DIE FLAECHE. GEMESSEN an der Kachel
    // "Mitternacht" in Bild 09: ein acht Bildpunkte breiter Keil in
    // Farbe des Seitengrunds bei x=331..338, Zeilen 229..233, also
    // genau dort, wo der Name anfaengt -- er sah wie ein verlorenes
    // Zeichen aus und wurde auch dafuer gehalten.
    //
    // `wlibc.rrect` hat diese Schwaeche nicht: es malt die ganze Form,
    // und `wlibc.px` verwirft die Bildpunkte ausserhalb des Bandes.
    // Flaeche und Rahmen tragen damit denselben `rk`, dieselben Kanten
    // und dieselben Mischstufen an der Rundung.
    //
    // Die FARBE kommt weiter aus `tspec(i, TL_SURFACE)` -- eine Kachel
    // traegt ihre Farben selbst (Vorschaukacheln zeigen ein ANDERES
    // Schema als das laufende). `sel` bleibt der Zustand des Aufrufers,
    // und der Auswahlring ist der einzige Teil der Kachel, der aus dem
    // LAUFENDEN Satz kommt: ihn malt weiter fUi -- und wo fUi ihn wegen
    // des Bandes ablehnt (`fuib.ring` gibt dann `false` zurueck und
    // malte bis hierher gar nichts), malt dieselbe Eckendeckung ihn.
    wlibc.rrect(x, y, w, h, rk, tspec(i, TL_SURFACE))
    if sel {
        let fw: u64 = wlibc.metric(wlibc.M_FOCUS) + 1
        if !fuib.ring(x, y, w, h, rk, fw, wlibc.theme(wlibc.T_FOCUS)) {
            wlibc.rring(x, y, w, h, rk, fw, wlibc.theme(wlibc.T_FOCUS))
        }
    } else {
        wlibc.rring(x, y, w, h, rk, 1,
            tspec(i, TL_FRAME))
    }
    // ---- the miniature taskbar, on ITS OWN edge
    let e: u64 = tspec(i, TL_EDGE)
    let bar: u64 = TP_BAR
    var bx: u64 = px
    var by: u64 = py
    var bw2: u64 = pw
    var bh2: u64 = bar
    if e == 1 {
        by = py
    } else if e == 2 {
        bw2 = bar
        bh2 = ph
    } else if e == 3 {
        bx = px + pw - bar
        bw2 = bar
        bh2 = ph
    } else {
        by = py + ph - bar
    }
    // the desktop under it
    wlibc.rect(px, py, pw, ph, tspec(i, TL_SURFACE))
    wlibc.rect(bx, by, bw2, bh2, tspec(i, TL_TASKBAR))
    // one button on the bar, where the alignment puts it
    let blen: u64 = TP_BTN
    if e == 2 || e == 3 {
        var byy: u64 = by + 3
        if tspec(i, TL_ALIGN) == 1 {
            byy = by + sub(bh2, blen) / 2
        }
        wlibc.rect(bx + 1, byy, sub(bar, TP_LINE), blen, tspec(i, TL_ACCENT))
    } else {
        var bxx: u64 = bx + 3
        if tspec(i, TL_ALIGN) == 1 {
            bxx = bx + sub(bw2, blen) / 2
        }
        wlibc.rect(bxx, by + 1, blen, sub(bar, TP_LINE), tspec(i, TL_ACCENT))
    }
    // ---- the miniature window, with ITS OWN radius and shadow
    var wx: u64 = px + TP_WX
    var wy: u64 = py + TP_WY
    if e == 1 {
        wy = py + TP_WY + 3
    }
    if e == 2 {
        wx = px + TP_WX + 4
    }
    let ww: u64 = TP_WW
    let wh: u64 = sub(ph, TP_WY * 2)
    if wh < 10 {
        return
    }
    wlibc.drop_shadow(wx, wy, ww, wh, tspec(i, TL_RADW),
        tspec(i, TL_SHADOW), 3, tspec(i, TL_TEXT))
    wlibc.rframe(wx, wy, ww, wh, tspec(i, TL_RADW), 1,
        tspec(i, TL_FRAME), tspec(i, TL_RAISED))
    // the title bar in the accent, with the label colour on it
    let th: u64 = TP_TITLE
    wlibc.rrect(wx + 1, wy + 1, ww - 2, th, tspec(i, TL_RADW),
        tspec(i, TL_ACCENT))
    wlibc.rect(wx + 1, wy + th - 2, ww - 2, TP_LINE + 1, tspec(i, TL_ACCENT))
    wlibc.rect(wx + 4, wy + 3, TP_MARK, TP_LINE, tspec(i, TL_ONACCENT))
    // one line of body text and a button, in the body colours
    wlibc.rect(wx + 4, wy + th + 4, ww - TP_BTN, TP_LINE, tspec(i, TL_TEXT))
    let byb: u64 = wy + wh - TP_TITLE - 3
    if byb > wy + th + 6 {
        wlibc.rframe(wx + 4, byb, TP_MARK + 2, TP_TITLE + 1, tspec(i, TL_RADB), 1,
            tspec(i, TL_FRAME), tspec(i, TL_BUTTON))
    }
    // ---- the name, on the tile's own surface in its own text colour
    let nm: u64 = tspec(i, TL_NAME)
    let asc: u64 = wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    let tw: u64 = sub(sub(px, x), 12)
    var col: u64 = tspec(i, TL_TEXT)
    if tspec(i, TL_LOW) != 0 {
        col = tspec(i, TL_DANGER)
    }
    // THE BASELINE IS CENTRED IN THE TILE and not four pixels down: a
    // 30-pixel tile with a 15-pixel line has 7 above and 8 below, and
    // putting the text at a fixed offset is how a label ends up half
    // outside the thing it belongs to when the shape changes.
    let base: u64 = y + sub(h, wlibc.text_h(wlibc.px_ui())) / 2 + asc
    let _p: u64 = put_text(wlibc.F_UI, wlibc.px_ui(), x + 8,
        base, tw, nm, tlen(nm), col, 0)
    say_painted(g(i, D_WIN), K_TILE, base, col,
        tspec(i, TL_SURFACE), nm, tlen(nm))
}

fn scrollarea(rows: u64, sicht: u64) -> u64 {
    let i: u64 = add(K_SCROLL, 0, scroll_w(), 0, false)
    s(i, D_A, rows)
    s(i, D_B, sicht)
    return i
}

// ------------------------------------------------------- der Zustand

fn value(i: u64) -> u64 {
    return g(i, D_VAL)
}

fn set_value(i: u64, v: u64) {
    if g(i, D_VAL) == v {
        return
    }
    s(i, D_VAL, v)
    dirty_wd(i)
}

fn text_of(i: u64) -> u64 {
    return g(i, D_TEXT)
}

fn set_text(i: u64, p: u64) {
    s(i, D_TEXT, p)
    if g(i, D_KIND) == K_LIST || g(i, D_KIND) == K_TABLE {
        count_rows(i)
        if g(i, D_VAL) >= g(i, D_A) {
            s(i, D_VAL, 0)
        }
        s(i, D_B, 0)
    }
    if g(i, D_KIND) == K_ENTRY {
        s(i, D_B, tlen(p))
        s(i, D_C, g(i, D_B))
    }
    dirty_wd(i)
}

fn set_rows(i: u64, n: u64) {
    s(i, D_A, n)
}

fn set_cols(i: u64, n: u64, breiten: u64) {
    s(i, D_C, n)
    s(i, D_D, breiten)
}

fn enable(i: u64, on: bool) {
    if on {
        s(i, D_FLAGS, g(i, D_FLAGS) & ~F_OFF)
    } else {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_OFF)
    }
    dirty_wd(i)
}

// RUNDE DESKTOP: EIN WIDGET AUS DER ANORDNUNG NEHMEN UND
// ZURUECKGEBEN. Das ist der Unterschied zwischen `enable` (steht da,
// laesst sich nicht bedienen) und dem, was ein REITER braucht: die
// Widgets des anderen Reiters sollen gar nicht da sein, und der Platz,
// den sie belegt haetten, soll dem sichtbaren zugutekommen.
//
// `relayout` ueberspringt verborgene Widgets seit Runde K15 -- die
// Zeile stand da und war unbenutzbar, weil es keinen Weg gab, F_HIDE
// von aussen zu setzen. Diese beiden Funktionen sind der Weg.
fn show(i: u64, on: bool) {
    if i >= nwd {
        return
    }
    if on {
        s(i, D_FLAGS, g(i, D_FLAGS) & ~F_HIDE)
    } else {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_HIDE)
    }
}

fn shown(i: u64) -> bool {
    if i >= nwd {
        return false
    }
    return (g(i, D_FLAGS) & F_HIDE) == 0
}

// Alles neu anordnen und neu malen. Nach jedem Reiterwechsel.
fn new_set() {
    relayout()
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            dirty_all(w)
        }
        w = w + 1
    }
}

fn focus_id() -> u64 {
    if s_focus == 0 {
        return MAXWD
    }
    return s_focus - 1
}

fn set_focus(i: u64) {
    if s_focus != 0 {
        dirty_wd(s_focus - 1)
    }
    s_focus = i + 1
    dirty_wd(i)
}

fn fired_kind() -> u64 {
    return s_fkind
}

fn fired_index() -> u64 {
    return s_findex
}

fn fired_win() -> u64 {
    return s_fwin
}

// --------------------------------------------------- Zeilen und Spalten

// Wie viele Zeilen der Textblock hat. Eine Zeile ist alles bis zum
// naechsten Umbruch; der letzte Umbruch zaehlt nicht als leere Zeile
// dahinter.
fn count_rows(i: u64) {
    let p: u64 = g(i, D_TEXT)
    if p == 0 {
        s(i, D_A, 0)
        return
    }
    var n: u64 = 0
    var k: u64 = 0
    var char: u64 = 0
    while (*((p + k) as *mut u8)) != 0 as u8 {
        if (*((p + k) as *mut u8)) == 10 as u8 {
            n = n + 1
            char = 0
        } else {
            char = char + 1
        }
        k = k + 1
    }
    if char > 0 {
        n = n + 1
    }
    s(i, D_A, n)
}

fn row_at(p: u64, r: u64) -> u64 {
    if p == 0 {
        return 0
    }
    var k: u64 = 0
    var n: u64 = 0
    while n < r {
        if (*((p + k) as *mut u8)) == 0 as u8 {
            return 0
        }
        if (*((p + k) as *mut u8)) == 10 as u8 {
            n = n + 1
        }
        k = k + 1
    }
    if (*((p + k) as *mut u8)) == 0 as u8 {
        return 0
    }
    return p + k
}

fn row_len(q: u64) -> u64 {
    var n: u64 = 0
    while (*((q + n) as *mut u8)) != 0 as u8 {
        if (*((q + n) as *mut u8)) == 10 as u8 {
            return n
        }
        n = n + 1
    }
    return n
}

// Spalte `c` einer Zeile: Zeiger und Laenge (Laenge oben in `col_len`).
fn col_at(q: u64, ende: u64, c: u64) -> u64 {
    var k: u64 = 0
    var n: u64 = 0
    while n < c {
        if k >= ende {
            return 0
        }
        if (*((q + k) as *mut u8)) == 9 as u8 {
            n = n + 1
        }
        k = k + 1
    }
    if k > ende {
        return 0
    }
    return q + k
}

fn col_len(q: u64, rest: u64) -> u64 {
    var n: u64 = 0
    while n < rest {
        if (*((q + n) as *mut u8)) == 9 as u8 {
            return n
        }
        n = n + 1
    }
    return rest
}

// ROUND LOOK. `PX_UI + 5` was 20 and is now the `row` token, which is
// 20 in `classic`. Every list, table, menu and drop-down in this
// library measures itself against this one function, which is why the
// row height only had to be moved once.
fn lines_height() -> u64 {
    return wlibc.metric(wlibc.M_ROW)
}

// Two derived heights, so that the shape files carry ONE control height
// and not four. A checkbox and a menu bar are four pixels shorter than
// a button and a text field two -- that is what this library has always
// drawn (22 and 24 against 26), and the relationship is kept rather
// than four separate tokens that could drift apart.
fn ctrl_small() -> u64 {
    let h: u64 = wlibc.metric(wlibc.M_CTRL_H)
    if h < 8 {
        return h
    }
    return h - 4
}

fn ctrl_thin() -> u64 {
    let h: u64 = wlibc.metric(wlibc.M_CTRL_H)
    if h < 6 {
        return h
    }
    return h - 2
}

// The inset of TEXT inside a box that is not a button: half a button's
// padding. The old code said 5 in `paint_entry` and 6 in `paint_list`
// and meant the same thing both times.
fn inset() -> u64 {
    return wlibc.metric(wlibc.M_PAD_X) / 2
}

// AND ONE PIXEL LESS, INSIDE A TEXT FIELD.
//
// The old code said `x + 5` in `paint_entry` and `x + 6` in
// `paint_list` and `paint_choice`, and meant the same thing all three
// times. That one-pixel difference is a wart and not a decision -- but
// tools/k15/run.sh measures the caret and the text of a text field
// PIXEL BY PIXEL against a second rasterisation, so straightening it
// out would move ten characters by one pixel and turn a green section
// red for a tidy-up nobody asked for.
//
// So the wart is kept, named, and derived from the same token: classic
// gets its 5 and its 6 exactly as before, and modern gets 7 and 8.
// Whoever wants them equal can have it in a round that re-measures
// round K15's screenshots, which is where that cost belongs.
fn inset_text() -> u64 {
    let i: u64 = inset()
    if i == 0 {
        return 0
    }
    return i - 1
}

// Four more derivations, for the same reason as the two heights above:
// a shape file carries ONE control height and ONE row height, and the
// pieces that have always been a fixed distance from those keep that
// distance instead of becoming four more tokens that can drift.
//
//   scroll_w   14 in classic (M_ROW - 6). A scrollbar is a hair
//              narrower than a row is tall, which is what makes a list
//              read as a list and not as a table.
//   thumb_w    the thumb sits two pixels inside its track on each side.
//   tile_w     14 in classic (ctrl_small - 8): the coloured tile and
//              the checkbox square, which have always been the same
//              size because they are the same idea.
//   sep_h      5 in classic (M_PAD_Y + 1): one line, with the vertical
//              padding around it.
fn scroll_w() -> u64 {
    let r: u64 = wlibc.metric(wlibc.M_ROW)
    if r < 10 {
        return r
    }
    return r - 6
}

fn thumb_w() -> u64 {
    return sub(scroll_w(), 4)
}

fn tile_w() -> u64 {
    return sub(ctrl_small(), 8)
}

// The two buttons of a dialog are as wide as three of their own
// heights plus a gap -- 94 in classic, which is what was written there.
fn dlg_btn_w() -> u64 {
    return wlibc.metric(wlibc.M_CTRL_H) * 3 + wlibc.metric(wlibc.M_GAP) * 2
}

fn sep_h() -> u64 {
    return wlibc.metric(wlibc.M_PAD_Y) + 1
}

// ==================================================================
// DAS MALEN
//
// Alles laeuft ueber `wlibc.px` und damit ueber den Streifen. Kein
// Widget kennt den Fensterpuffer, kein Widget kennt einen
// Systemaufruf: es malt in Fensterkoordinaten, und die Bibliothek
// entscheidet, welcher Streifen gerade darunter liegt.

fn paint_bg(w: u64, x: u64, y: u64, bw: u64, bh: u64) {
    var c: u64 = wlibc.theme(wlibc.T_BG)
    if ng(w, N_KIND) == NK_DLG {
        c = wlibc.theme(wlibc.T_DLG)
    }
    if ng(w, N_KIND) == NK_MENU {
        c = wlibc.theme(wlibc.T_MENU)
    }
    // Die Blase nimmt die Menuefarbe: sie schwebt ueber allem, wie ein
    // Menue, und muss sich vom Fenster darunter abheben.
    if ng(w, N_KIND) == NK_TIP {
        c = wlibc.theme(wlibc.T_MENU)
    }
    wlibc.rect(x, y, bw, bh, c)
}

// Text, waagerecht ausgerichtet: 0 links, 1 mittig, 2 rechts.
fn put_text(f: u64, pxs: u64, x: u64, y: u64, bw: u64, p: u64, n: u64,
    farbe: u64, aus: u64) -> u64 {
    if p == 0 || n == 0 {
        s_tx = x
        return x
    }
    var tx: u64 = x
    if aus != 0 {
        let tw: u64 = wlibc.text_w(f, pxs, p, n)
        if aus == 1 {
            tx = x + sub(bw, tw) / 2
        } else {
            tx = x + sub(bw, tw)
        }
    }
    // WO DER TEXT WIRKLICH ANFAENGT. Bei `aus=1` ist das nicht `x`,
    // sondern die Mitte -- und genau diese Zahl braucht ein Pruefer, der
    // die Glyphen nachrastert. Sie hier zu merken ist der Unterschied
    // zwischen "der Laeufer rechnet die Zentrierung nach" (und prueft
    // dann seine eigene Rechnung) und "das Programm sagt, wo es gemalt
    // hat".
    s_tx = tx
    return wlibc.text_at(f, pxs, tx, y, p, n, farbe)
}

fn trace() -> bool {
    return s_trace != 0
}

// Den Titel des Menuefensters setzen. Ein Programm mit Katalog ruft
// das einmal beim Start mit `msg.get("wlib.menu.title")`; wer es nicht
// ruft, bekommt das englische Wort aus der Bibliothek.
fn set_menu_title(p: u64) {
    mn_titel = p
}

fn set_trace(on: bool) {
    if on {
        s_trace = 1
    } else {
        s_trace = 0
    }
}

// EINE GEMALTE ZEILE, mit allem, was ein Pruefer braucht: das Fenster
// (die Nummer, die der Fensterserver in `wm: win ... id=` fuehrt), die
// Art des Bedienelements, x und Grundlinie IM FENSTER, die beiden
// Farben und der Text.
fn say_painted(w: u64, kind: u64, base: u64, fg: u64, bg: u64, p: u64,
    n: u64) {
    say_painted_n(w, kind, base, fg, bg, p, n, n, n)
}

// DIESELBE ZEILE, ABER MIT DER UNGEKUERZTEN LAENGE DANEBEN.
//
// Wer einen Text kuerzt, malt `n` Oktette von `nv`, und nur er weiss
// das noch. Sagt er es nicht, ist die Kuerzung im Bild von einem
// kurzen Namen nicht zu unterscheiden -- und ein geklemmtes Label
// bleibt jahrelang unbemerkt, so wie die Reiter dieser Runde.
// `say_painted` reicht `nv = n` durch: wer nicht kuerzt, hat nichts zu
// melden.
fn say_painted_n(w: u64, kind: u64, base: u64, fg: u64, bg: u64, p: u64,
    n: u64, nq: u64, nv: u64) {
    if s_trace == 0 || p == 0 || n == 0 {
        return
    }
    // ONE WRITE AND NOT TWELVE.
    //
    // The first version of this called `ulib.say` and `ulib.sayn`
    // twelve times per line, and on a desktop that is five processes
    // sharing one serial port that came out interleaved: a checker
    // looking for a complete line found one in most runs and none in
    // some, which is the worst thing a measurement can be. The taskbar
    // has lived with it since round DESKTOP because it repaints often
    // enough that SOME line survives; a proof should not depend on
    // that.
    //
    // So the line is built in a buffer and handed to the kernel in a
    // single `write`, which is where the serialisation is. Same octets,
    // same order, one call.
    let b: u64 = (&tr_buf[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&tr_a[0 as usize]) as u64)
    at = tr_num(b, at, ng(w, N_H))
    at = tr_put(b, at, (&tr_k[0 as usize]) as u64)
    at = tr_num(b, at, kind)
    at = tr_put(b, at, (&tr_x[0 as usize]) as u64)
    at = tr_num(b, at, s_tx)
    at = tr_put(b, at, (&tr_b[0 as usize]) as u64)
    at = tr_num(b, at, base)
    at = tr_put(b, at, (&tr_f[0 as usize]) as u64)
    at = tr_num(b, at, fg)
    at = tr_put(b, at, (&tr_g[0 as usize]) as u64)
    at = tr_num(b, at, bg)
    at = tr_put(b, at, (&tr_w[0 as usize]) as u64)
    at = tr_num(b, at, wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, n))
    // Der Ursprung der MALFLAECHE auf dem Schirm: die aeussere Ecke des
    // Fensters plus Rand (BORDER = 2) und Titelleiste (TITLE_H = 22).
    // Dieselben zwei Zahlen wie in `say_tab` -- und wenn der
    // Fensterserver sie je aendert, sind BEIDE Stellen falsch, was
    // tools/softui/check.py sofort als "LEER" meldet.
    at = tr_put(b, at, (&tr_ax[0 as usize]) as u64)
    at = tr_num(b, at, ng(w, N_X) + 2)
    at = tr_put(b, at, (&tr_ay[0 as usize]) as u64)
    at = tr_num(b, at, ng(w, N_Y) + 22)
    at = tr_put(b, at, (&tr_q[0 as usize]) as u64)
    at = tr_num(b, at, nq)
    at = tr_put(b, at, (&tr_v[0 as usize]) as u64)
    at = tr_num(b, at, nv)
    at = tr_put(b, at, (&tr_t[0 as usize]) as u64)
    var i: u64 = 0
    while i < n && at + 2 < 320 {
        __mmio_write8((b + at) as *mut u8,
            __mmio_read8((p + i) as *mut u8))
        at = at + 1
        i = i + 1
    }
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(b, at)
}

// Text into the buffer, without the terminating zero. Returns where the
// next thing goes.
fn tr_put(b: u64, at: u64, p: u64) -> u64 {
    var i: u64 = 0
    var a: u64 = at
    while __mmio_read8((p + i) as *mut u8) != 0 as u8 && a + 2 < 320 {
        __mmio_write8((b + a) as *mut u8,
            __mmio_read8((p + i) as *mut u8))
        a = a + 1
        i = i + 1
    }
    return a
}

// A decimal number into the same buffer, most significant digit first.
fn tr_num(b: u64, at: u64, v: u64) -> u64 {
    var d: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var q: u64 = v
    if q == 0 {
        __mmio_write8(((&d[0 as usize]) as u64) as *mut u8, 48 as u8)
        n = 1
    }
    while q > 0 && n < 24 {
        __mmio_write8((((&d[0 as usize]) as u64) + n) as *mut u8,
            (48 + q % 10) as u8)
        q = q / 10
        n = n + 1
    }
    var a: u64 = at
    var i: u64 = n
    while i > 0 && a + 2 < 320 {
        i = i - 1
        __mmio_write8((b + a) as *mut u8,
            __mmio_read8((((&d[0 as usize]) as u64) + i) as *mut u8))
        a = a + 1
    }
    return a
}

// ROUND LOOK: the ring is as thick as the shape says and follows the
// same corner. It is the one thing `modern` makes LOUDER (2 pixels
// against 1), because it is the only thing on the list that somebody
// navigating by keyboard depends on.
// RUNDE 31: DER ZUSTAND EINES ELEMENTS, WIE fUi IHN NENNT.
//
// Dieselbe Rangfolge, die paint_button vorher in seinen drei Zweigen
// hatte: gedrueckt schlaegt darueberfahren, und abgeschaltet schlaegt
// beides. Sie steht jetzt EINMAL hier statt in jedem paint_*.
fn fui_zustand(i: u64) -> u64 {
    let fl: u64 = g(i, D_FLAGS)
    if (fl & F_OFF) != 0 {
        return fuib.Z_OFF
    }
    if (fl & F_PRESSED) != 0 {
        return fuib.Z_PRESSED
    }
    if (fl & F_HOVER) != 0 {
        return fuib.Z_HOVER
    }
    return fuib.Z_NORMAL
}

fn focus_ring(i: u64) {
    focus_ring_at(i, g(i, D_X), g(i, D_Y), g(i, D_W), g(i, D_H))
}

// DERSELBE RING, ABER UM EIN ANGEGEBENES RECHTECK.
//
// Ein Bedienelement, das aus mehreren anfassbaren Stuecken besteht
// (die Reiterleiste ist das einzige), traegt den Ring nicht um sich
// selbst, sondern um das Stueck, das gerade gilt. Der Ring bleibt die
// EINE Stelle, die einen Fokusring malt -- nur das Rechteck ist jetzt
// ein Argument statt einer Annahme.
fn focus_ring_at(i: u64, rx: u64, ry: u64, rw: u64, rh: u64) {
    if s_focus != i + 1 || rw == 0 || rh == 0 {
        return
    }
    // `rring` and not `rframe`: a focus ring goes ON TOP of a control
    // that is already painted, and `rframe` would fill it in.
    // RUNDE 31: der Fokusring aus fUi. Er liegt OBEN AUF einem schon
    // gemalten Element, also ein Ring und keine gefuellte Flaeche --
    // `round_ring`, dieselbe Rolle wie `rring`.
    // RUNDE GLAS: derselbe Weg zum Radius wie bei der Flaeche darunter
    // (`draw_radius`) -- ein Ring, der seine Zahl aus einer anderen
    // Quelle holte, wandert bei jeder Reglerbewegung von der Kante weg.
    // Gemeldet wird hier NICHT: ein Fokusring ist kein Widgettyp,
    // sondern liegt auf einem.
    if fuib.ring(rx, ry, rw, rh, draw_radius(MR_BUTTON),
        wlibc.metric(wlibc.M_FOCUS), wlibc.theme(wlibc.T_FOCUS)) {
        return
    }
    wlibc.rring(rx, ry, rw, rh, draw_radius(MR_BUTTON),
        wlibc.metric(wlibc.M_FOCUS), wlibc.theme(wlibc.T_FOCUS))
}

fn paint_scroll(x: u64, y: u64, h: u64, oben: u64, sicht: u64,
    int: u64) {
    // RUNDE 32: die Rinne aus fUi. DIE RECHNUNG DARUNTER BLEIBT
    // UNANGETASTET -- `ty` und `th` kommen weiter aus `oben`, `sicht`
    // und `ganz`, also aus dem Zustand des Aufrufers. Umgestellt wird
    // nur, WER die zwei Rechtecke malt.
    let _fb3: bool = fuib.area(x, y, scroll_w(), h, wlibc.theme(wlibc.T_SCROLL))
    if int == 0 || sicht >= int {
        return
    }
    var th: u64 = h * sicht / int
    if th < 12 {
        th = 12
    }
    if th > h {
        th = h
    }
    var ty: u64 = 0
    if int > sicht {
        ty = (h - th) * oben / (int - sicht)
    }
    // RUNDE VEKTOR: der Griff der Bildlaufleiste bekommt denselben
    // Radius wie jeder Griff -- so rund wie er breit ist. `radius_input/2`
    // war eine feste Zahl, die bei Vervielfachung 2 nicht mitwuchs.
    let _fb4: bool = fuib.tafel(x + 2, y + ty, thumb_w(), th,
        typ_radius(RT_GRIFF, MR_GRIFF, thumb_w(), th),
        wlibc.theme(wlibc.T_THUMB), 0, 0)
}

fn paint_button(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    var area: u64 = wlibc.theme(wlibc.T_BTN)
    if (g(i, D_FLAGS) & F_PRESSED) != 0 {
        area = wlibc.theme(wlibc.T_BTNDN)
    } else if (g(i, D_FLAGS) & F_HOVER) != 0 {
        area = wlibc.theme(wlibc.T_BTNHI)
    }
    // ============================================== RUNDE 31: fUi MALT
    //
    // Hier standen zwei Zweige, die einen Knopf malten: `rect`+`frame3`
    // fuer `classic` und `rrect` zweimal fuer `osum`. Beides tut fUis
    // `draw_button` auch -- und zwar mit demselben Radius, weil
    // `fuib.thema_neu` ihn aus `wlibc.metric(M_RADIUS_BUTTON)` nimmt.
    // Zwei Umsetzungen einer Optik waren genau das, was raus soll.
    //
    // Der Rueckweg bleibt: findet die Bruecke keine Flaeche (kein
    // Fenster, Band noch nicht gesetzt), malt der alte Weg. Ein Knopf,
    // der gar nicht erscheint, waere schlimmer als ein eckiger.
    // RUNDE GLAS: DIE ZAHL WIRD VOR DER VERZWEIGUNG GEHOLT UND GEMELDET.
    //
    // Malt fUi die Flaeche (der erste Zweig), nimmt es den Radius ueber
    // `fuib.thema_neu` aus derselben Marke -- der Knopf ist also auch
    // dort rund. Stuende `typ_radius` erst im zweiten Zweig, fehlte auf
    // einem laufenden System die Zeile `typ=knopf` vollstaendig, und
    // die Abnahme haette genau den Weg nicht gemessen, der wirklich
    // malt.
    let rb: u64 = typ_radius(RT_KNOPF, MR_BUTTON, bw, bh)
    // RUNDE GLAS (fix-r3-2): WER DIE FLAECHE MALT, SAGT AUCH, OB ER
    // SIE GERAHMT HAT.
    //
    // fUi malt den Knopf flach: eine Flaeche in Weiss auf einer Karte
    // in fast Weiss und KEINE Umrisskante. Auf der Seite Darstellung
    // war der Knopf "Uebernehmen" deshalb von einer Beschriftung nicht
    // zu unterscheiden -- ein Bedienelement, das nicht aussieht wie
    // eines, ist keines. Der Rueckweg unten rahmt selbst (`rrect` in
    // T_LINE mit der Flaeche darin, bzw. `frame3` beim eckigen Knopf,
    // das auch den gedrueckten Zustand zeigt); nur der fUi-Zweig
    // braucht die Kante nachgereicht. Diese Marke sagt, welcher Fall
    // vorliegt, damit die Kante nicht zweimal entsteht.
    var gerahmt: bool = false
    if fuib.draw(fuib.S_BUTTON, x, y, bw, bh, fui_zustand(i), 0) {
        // fUi hat die Flaeche gemalt -- weiter beim Text.
    } else {
    if rb == 0 {
        wlibc.rect(x, y, bw, bh, area)
        wlibc.frame3(x, y, bw, bh, wlibc.theme(wlibc.T_BTNHI),
            wlibc.theme(wlibc.T_LINE), (g(i, D_FLAGS) & F_PRESSED) != 0)
    } else {
        // ============================== RUNDE ECHTHARDWARE-1
        // DREI SUBTRAKTIONEN, DIE UNTER NULL LAUFEN KONNTEN -- UND
        // GENAU DARAN IST JUSTINS STARTMENUE GESTORBEN.
        //
        // Auf seinem Foto vom 09.09. laesst sich im Startmenue nichts
        // anklicken und nichts tippen. Der Grund steht auf der
        // seriellen Leitung des Nachbaus:
        //
        //   panic: integer overflow in 'u64 - u64'
        //          at kernel/user/wlib.fi:2878
        //
        // Das ist DIESE Zeile. `bw - 2 * bo` und `bh - 2 * bo` laufen
        // unter null, sobald ein Knopf schmaler oder niedriger als
        // zwei Randbreiten ist, und `rb - bo`, sobald der Radius
        // kleiner als der Rand ist. In `u64` ist das kein negativer
        // Wert, sondern eine Zahl in der Naehe von 2^64 -- der Kern
        // faengt es ab und erschlaegt den Prozess.
        //
        // WARUM ES ERST JETZT AUFFIEL: dieser Zweig laeuft nur bei
        // `radius_button != 0`, also nur unter `shape=osum`. Bis zu
        // dieser Runde lieferte der Stick gar keine Formdatei mit und
        // stand deshalb immer auf `classic` (Radius 0) -- der Fehler
        // lag seit Runde LOOK im Baum und konnte nie zuschlagen.
        // Seit das Abbild `shape=osum` mitbringt, schlaegt er bei
        // JEDEM Knopf zu, der klein ist.
        //
        // Der Prozess, der hier stirbt, ist der STARTER: kein Fenster
        // mehr, das Klicks annimmt, keine Eingabe, kein Start. Genau
        // Justins Befund -- und er sah aus wie ein Ereignisproblem,
        // war aber eine Subtraktion.
        wlibc.rrect(x, y, bw, bh, rb, wlibc.theme(wlibc.T_LINE))
        var bo: u64 = wlibc.metric(wlibc.M_BORDER)
        if 2 * bo >= bw || 2 * bo >= bh {
            bo = 0
        }
        var ri: u64 = 0
        if rb > bo {
            ri = rb - bo
        }
        wlibc.rrect(x + bo, y + bo, bw - 2 * bo, bh - 2 * bo,
            ri, area)
    }
    gerahmt = true
    }
    if !gerahmt {
        // DIE UMRISSKANTE DES KNOPFES, in derselben Farbe und mit
        // demselben Radius wie der Rueckweg sie malt -- `fuib.ring`
        // ist die eine Stelle, die einen Ring legt, und faellt von
        // selbst auf `wlibc.rring` zurueck. Die Breite ist die Marke
        // M_BORDER; ist sie 0 (ein Satz ganz ohne Raender), bleibt
        // trotzdem ein Bildpunkt stehen, denn `shotcheck.py` weist
        // ab jetzt fuer JEDES gemeldete Widget vom Typ `button`
        // mindestens eine Kante im Bild nach.
        var kb: u64 = wlibc.metric(wlibc.M_BORDER)
        if kb == 0 {
            kb = 1
        }
        let _kante: bool = fuib.ring(x, y, bw, bh, rb, kb,
            wlibc.theme(wlibc.T_LINE))
    }
    // UND ER SAGT, WO ER STEHT -- egal, wer die Flaeche gemalt hat.
    say_knopf(g(i, D_WIN), x, y, bw, bh, rb)
    var farbe: u64 = wlibc.theme(wlibc.T_FG)
    if (g(i, D_FLAGS) & F_OFF) != 0 {
        farbe = wlibc.theme(wlibc.T_DIM)
    }
    let grund: u64 = y + (bh + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
    // RUNDE EXPLORER-2: traegt der Knopf ein Symbol, wird das Symbol
    // gemalt und der Text NICHT -- er bleibt als Beschriftung fuer
    // `say_painted` und den Vorleser stehen. Gemalt wird mit
    // `wlibc.icon_at` und in der Farbe des Knopfes, also hell auf
    // dunkel und dunkel auf hell, ohne zweiten Satz Zeichnungen.
    let sym: u64 = g(i, D_BICON)
    if sym != 0 {
        let k: u64 = wlibc.icon_small()
        let _ok: bool = wlibc.icon_at(sym, x + (bw - k) / 2,
            y + (bh - k) / 2, k, farbe)
    } else {
        put_text(wlibc.F_UI, wlibc.px_ui(), x, grund, bw, g(i, D_TEXT),
            tlen(g(i, D_TEXT)), farbe, 1)
    }
    say_painted(g(i, D_WIN), K_BUTTON, grund, farbe, area,
        g(i, D_TEXT), tlen(g(i, D_TEXT)))
    focus_ring(i)
}

// RUNDE MERGE-2: EIN ETIKETT, DAS NICHT IN SEINEN KASTEN PASST, WIRD
// GEKUERZT -- und das Gekuerzte wird gemeldet.
//
// `put_text` benutzt seine Breite nur zum Ausrichten, es schneidet
// nicht ab; ein zu langes Etikett malt bis dahin, wo es aufhoert, und
// das ist die Spalte daneben. Gefunden mit dem berichtigten
// tools/themestore/shotcheck.py auf der Seite Vorlagen: die Zeile
// "Abendrot: schlechtestes Textpaar 5.34:1" ist 302 Bildpunkte breit,
// die linke Spalte gibt 268 her, und ihre letzten zwei Punkte lagen auf
// dem Namen der Kachel daneben. Solange der Pruefer keine einzige Zeile
// erkannte (das alte Muster passte nach Runde SOFTUI nicht mehr), war
// diese Ueberlappung unsichtbar.
//
// Dieselbe Regel wie bei den Listenzeilen der Runde THEMESTORE ("eine
// Zeile, die nicht passt, wird gekuerzt"), an derselben Stelle
// gemeldet: `say_painted` bekommt den Text, der WIRKLICH gemalt wurde,
// nicht den, der gewuenscht war.
// WIE HOCH EIN UMBRECHENDES ETIKETT IN DIESER BREITE IST.
// `place` fragt das, sobald die Breite feststeht -- und nur dort.
fn label_h_at(i: u64, bw: u64) -> u64 {
    let zh: u64 = wlibc.text_h(wlibc.px_ui())
    let q: u64 = g(i, D_TEXT)
    let n: u64 = tlen(q)
    if n == 0 || bw == 0
        || wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q, n) <= bw {
        return zh
    }
    return zh * 2
}

// WO EIN SATZ UMBRICHT: am letzten Leerzeichen, das noch in die Breite
// passt. Gibt es keines (ein einziges langes Wort), wird hart getrennt
// -- das ist haesslich, aber es ist immer noch der ganze Text und
// nicht die Haelfte mit drei Punkten.
fn wrap_split(f: u64, pxs: u64, p: u64, n: u64, limit: u64) -> u64 {
    let k: u64 = fit_n(f, pxs, p, n, limit)
    if k == 0 || k >= n {
        return n
    }
    var b: u64 = k
    while b > 0 {
        if __mmio_read8((p + b) as *mut u8) == 32 as u8 {
            return b
        }
        b = b - 1
    }
    return k
}

fn paint_label(i: u64) {
    let zh: u64 = wlibc.text_h(wlibc.px_ui())
    let asc: u64 = wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    let grund: u64 = g(i, D_Y) + asc
    let voll: u64 = g(i, D_TEXT)
    let vn: u64 = tlen(voll)
    let bw: u64 = g(i, D_W)
    // ------- RUNDE GLAS (nachtrag): ZWEI ZEILEN STATT DREI PUNKTE
    if (g(i, D_FLAGS) & F_UMBRUCH) != 0 && vn > 0
        && wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), voll, vn) > bw {
        let n1: u64 = wrap_split(wlibc.F_UI, wlibc.px_ui(), voll, vn, bw)
        put_text(wlibc.F_UI, wlibc.px_ui(), g(i, D_X), grund, bw,
            voll, n1, wlibc.theme(wlibc.T_FG), 0)
        say_painted(g(i, D_WIN), K_LABEL, grund, wlibc.theme(wlibc.T_FG),
            bg_of(g(i, D_WIN)), voll, n1)
        // Das Leerzeichen, an dem getrennt wurde, gehoert in keine der
        // beiden Zeilen -- es stuende sonst als Einzug vor der zweiten.
        var st: u64 = n1
        if st < vn && __mmio_read8((voll + st) as *mut u8) == 32 as u8 {
            st = st + 1
        }
        var q2: u64 = voll + st
        var n2: u64 = sub(vn, st)
        let el2: u64 = elide(wlibc.F_UI, wlibc.px_ui(), q2, n2, bw)
        var nq2: u64 = n2
        if el2 != 0 {
            q2 = (&el_buf[0 as usize]) as u64
            n2 = el2
            nq2 = sub(el2, 3)
        }
        put_text(wlibc.F_UI, wlibc.px_ui(), g(i, D_X), grund + zh, bw,
            q2, n2, wlibc.theme(wlibc.T_FG), 0)
        say_painted_n(g(i, D_WIN), K_LABEL, grund + zh,
            wlibc.theme(wlibc.T_FG), bg_of(g(i, D_WIN)), q2, n2, nq2,
            sub(vn, st))
        return
    }
    var q: u64 = voll
    var qn: u64 = vn
    // UND WENN DOCH GEKUERZT WIRD, STEHT ES IN DER MELDUNG.
    //
    // Bis hierher meldete ein gekuerztes Etikett `nq=nv`: die
    // gemeldete Laenge war die des GEMALTEN Textes, und damit war eine
    // Kuerzung aus der Leitung nicht mehr zu erkennen -- nur die
    // Reiter sagten es. Seit dieser Runde zaehlt
    // tools/themestore/shotcheck.py gekuerzten Fliesstext getrennt von
    // den Reitern, und dafuer muss der Fliesstext es auch sagen.
    let el: u64 = elide(wlibc.F_UI, wlibc.px_ui(), q, qn, bw)
    var nq: u64 = qn
    if el != 0 {
        q = (&el_buf[0 as usize]) as u64
        qn = el
        nq = sub(el, 3)
    }
    put_text(wlibc.F_UI, wlibc.px_ui(), g(i, D_X), grund, bw,
        q, qn, wlibc.theme(wlibc.T_FG), 0)
    say_painted_n(g(i, D_WIN), K_LABEL, grund, wlibc.theme(wlibc.T_FG),
        bg_of(g(i, D_WIN)), q, qn, nq, vn)
}

// Die Flaeche, auf der ein Etikett liegt. `paint_bg` entscheidet das
// schon; hier steht dieselbe Entscheidung als Frage, damit die gemeldete
// Hintergrundfarbe die ist, die wirklich unter dem Text liegt.
fn bg_of(w: u64) -> u64 {
    if ng(w, N_KIND) == NK_DLG {
        return wlibc.theme(wlibc.T_DLG)
    }
    if ng(w, N_KIND) == NK_MENU || ng(w, N_KIND) == NK_TIP {
        return wlibc.theme(wlibc.T_MENU)
    }
    return wlibc.theme(wlibc.T_BG)
}

// RUNDE TON-2: WO DIE RINNE ANFAENGT UND WIE BREIT SIE IST.
//
// Zwei Stellen brauchen dieselbe Rechnung -- das Malen und das
// Treffen. Stuende sie zweimal da, waere der Regler eines Tages an
// einer anderen Stelle zu fassen, als er gezeichnet ist; das ist der
// Fehler, den man erst auf einem Bildschirmfoto sieht.
fn slider_bahn(i: u64) -> u64 {
    let txt: u64 = g(i, D_TEXT)
    var lx: u64 = g(i, D_X)
    if txt != 0 && tlen(txt) > 0 {
        lx = lx + wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), txt,
            tlen(txt)) + 8
    }
    return lx
}

fn slider_rw(i: u64) -> u64 {
    let x: u64 = g(i, D_X)
    let bw: u64 = g(i, D_W)
    let lx: u64 = slider_bahn(i)
    let zw: u64 = 34
    if bw > (lx -% x) + zw + 8 {
        return bw -% (lx -% x) -% zw -% 8
    }
    return 0
}

// Aus einer Zeigerstelle einen Wert. Der Griff ist zehn Bildpunkte
// breit, also ist die BAHN um zehn kuerzer als die Rinne -- gerechnet
// wird auf die Mitte des Griffs, sonst laesst sich die 100 nicht
// erreichen.

// RUNDE TON-2: DER SCHIEBEREGLER.
//
// Beschriftung links, dann die Rinne, rechts der Wert in Prozent.
// JEDE Farbe kommt aus dem Thema: die Rinne aus T_SCROLL (dieselbe,
// aus der die Rollleiste ihre nimmt -- es ist dieselbe Sache: eine
// Bahn, in der etwas laeuft), der gefuellte Teil aus T_ACCENT, der
// Griff aus T_THUMB. Ein fester Farbwert an dieser Stelle wuerde von
// tools/design/messen.py gezaehlt, und zwar zu Recht: er ueberlebte
// keinen Themenwechsel.
fn paint_slider(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    let txt: u64 = g(i, D_TEXT)
    if txt != 0 && tlen(txt) > 0 {
        let grund: u64 = y + (bh
            + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
        put_text(wlibc.F_UI, wlibc.px_ui(), x, grund, bw, txt,
            tlen(txt), wlibc.theme(wlibc.T_FG), 0)
    }
    // RECHTS BLEIBT PLATZ FUER DIE ZAHL. Ein Regler ohne abgelesenen
    // Wert ist eine Schaetzung; "wie laut ist es gerade" muss man
    // ablesen koennen und nicht abmessen.
    //
    // DIE BAHN KOMMT AUS DERSELBEN RECHNUNG WIE DAS TREFFEN
    // (`slider_bahn`/`slider_rw`) -- zwei Rechnungen fuer dieselbe
    // Rinne gingen irgendwann auseinander.
    let zw: u64 = 34
    let lx: u64 = slider_bahn(i)
    let rw: u64 = slider_rw(i)
    if rw < 8 {
        return
    }
    // ================================================ RUNDE VEKTOR
    //
    // RINNE UND GRIFF SIND KURVEN, NICHT RECHTECKE -- UND SIE
    // WACHSEN MIT DER OBERFLAECHE.
    //
    // Was hier stand: `rh = 4`, `gw = 10`, `gh = 14`, alles mit
    // `wlibc.rect` gemalt. Zwei Fehler in vier Zeilen:
    //
    //   1. Der Griff war ein RECHTECK. Justins Klage "alles eckig"
    //      hat hier ihren sichtbarsten Fall: ein Schieberegler, den
    //      jedes andere System rund zeichnet.
    //   2. Die drei Zahlen standen NACKT da. `wlibc.metric` malnimmt
    //      jede Laenge mit `ui_scale()` (wlibc.fi:3969), diese drei
    //      aber nicht -- bei Vervielfachung 2 wurde das Widget doppelt
    //      so hoch, die Rinne blieb vier Bildpunkte duenn und der
    //      Griff zehn breit. Auf Justins 1440p-Schirm war das ein
    //      Faden mit einem Kruemel darauf.
    //
    // Jetzt: alle drei Masse mal `sk`, die Rinne mit halber Hoehe als
    // Radius (also ein Stadion, keine Kiste), der Griff ein KREIS.
    let sk: u64 = wlibc.ui_scale()
    let rh: u64 = 4 * sk
    let ry: u64 = y + sub(bh, rh) / 2
    // RUNDE 31: die Rinne aus fUi (mal_balken geht dort durch), mit
    // Rueckfall auf wlibcs Kapsel.
    // RUNDE GLAS: `rh / 2` WAR EINE ABGETIPPTE ZAHL.
    //
    // Sie machte die Bahn zu einer Kapsel, egal was die Vorlage sagt --
    // bei `radius=0` (frueher `shape=classic`) blieb als einziges
    // Stueck der Oberflaeche eine Rundung stehen. Jetzt kommt sie aus
    // der Rolle "Feld"; `fuib.tafel` deckelt ohnehin auf `rh / 2`,
    // also ist eine hohe Einstellung weiter die Kapsel von vorher.
    let rbahn: u64 = typ_radius(RT_BAHN, MR_FIELD, rw, rh)
    let _fb5: bool = fuib.tafel(lx, ry, rw, rh, rbahn,
        wlibc.theme(wlibc.T_SCROLL), 0, 0)
    // RUNDE GLAS: DER GRIFF STEHT AUF DEM WERT -- IN DESSEN EIGENEM
    // BEREICH.
    //
    // Hier stand `v / 100`, und damit rechnete das Malen in Prozent,
    // waehrend `slider_setz` den Klick auf `min..max` umrechnet. Bei
    // einem Regler von 0 bis 100 fiel das nicht auf; bei dem der
    // Eckenrundung (0..24) stand der Griff bei 10 Bildpunkten auf
    // einem Zehntel der Bahn, obwohl der Wert bei knapp der Haelfte
    // liegt, und ein Klick auf den Griff sprang sofort woandershin.
    // Ein Regler, dessen Griff nicht dort steht, wo sein Wert ist, ist
    // eine falsche Anzeige, und genau das misst die Abnahme.
    //
    // `slider_anteil` rechnet den Anteil, und sie rechnet ihn an DER
    // EINEN Stelle -- `slider_setz` ist ihre Umkehrung.
    let v: u64 = g(i, D_VAL)
    let anteil: u64 = slider_anteil(i)
    // DER GRIFF SITZT AUF DER MITTE DES WERTES, nicht an seinem Anfang:
    // sonst steht er bei 100 % mit seiner halben Breite ueber dem Ende
    // der Rinne.
    let gw: u64 = 14 * sk
    let bahn: u64 = sub(rw, gw)
    let gx: u64 = lx + bahn * anteil / 100
    if anteil > 0 {
        // Die Fuellung endet unter der Mitte des Griffs.
        let _fb6: bool = fuib.tafel(lx, ry, gx -% lx + gw / 2, rh, rbahn,
            wlibc.theme(wlibc.T_ACCENT), 0, 0)
    }
    // DER GRIFF: ein Kreis mit Rand. Erst der Rand als voller Kreis,
    // dann die Flaeche einen Bildpunkt kleiner -- so ist die Kante
    // rundum gleich dick, was sie bei zwei Rechtecken nie war.
    let gr: u64 = gw / 2
    let gcx: u64 = gx + gr
    let gcy: u64 = y + bh / 2
    // RUNDE 31: DER GRIFF AUS fUi. Vorher zwei Kreise (Rand als voller
    // Kreis, Flaeche einen Punkt kleiner); fUi macht daraus eine
    // Kapsel mit Rand -- ein Aufruf, dieselbe Kante rundum.
    // RUNDE GLAS: auch hier stand die Zahl abgetippt (`gr`). Die Rolle
    // MR_GRIFF sagt "so rund wie moeglich", `fuib.tafel` deckelt das
    // auf genau dieses `gr` -- derselbe Kreis wie vorher, aber aus der
    // einen Quelle, und in der Meldung als `typ=griff` nachweisbar.
    let _fb7: bool = fuib.tafel(sub(gcx, gr), sub(gcy, gr), 2 * gr, 2 * gr,
        typ_radius(RT_GRIFF, MR_GRIFF, 2 * gr, 2 * gr),
        wlibc.theme(wlibc.T_THUMB), wlibc.theme(wlibc.T_LINE), sk)
    // DER WERT ALS ZAHL, rechtsbuendig an der Widgetkante.
    //
    // RUNDE GLAS: DAS PROZENTZEICHEN GEHOERT NUR AN EINEN PROZENTWERT.
    // Es stand frueher an jedem Regler, und an dem der Eckenrundung
    // waeren aus 10 Bildpunkten "10 %" geworden -- eine Zahl, die
    // etwas anderes behauptet als sie ist. Ein Regler von 0 bis 100
    // ist ein Prozentregler und behaelt das Zeichen; jeder andere
    // zeigt seine eigene Einheit, also die blosse Zahl.
    var zahl: [u8; 8] = [0 as u8; 8]
    var n: u64 = ulib.digits(v, (&zahl[0 as usize]) as u64)
    if g(i, D_E) == 0 && g(i, D_F) == 100 {
        zahl[n as usize] = 37 as u8
        n = n + 1
    }
    zahl[n as usize] = 0 as u8
    let zx: u64 = x + bw -% zw
    let zgrund: u64 = y + (bh
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
    put_text(wlibc.F_UI, wlibc.px_ui(), zx, zgrund, zw,
        (&zahl[0 as usize]) as u64, n, wlibc.theme(wlibc.T_DIM), 0)
    focus_ring(i)
}

fn paint_check(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let k: u64 = tile_w()
    let oy: u64 = y + sub(g(i, D_H), k) / 2
    // RUNDE 31: das Kaestchen aus fUi.
    let _fb8: bool = fuib.tafel(x, oy, k, k,
        typ_radius(RT_HAKEN, MR_FIELD, k, k),
        wlibc.theme(wlibc.T_ENTRY), 0, 0)
    wlibc.frame(x, oy, k, k, wlibc.theme(wlibc.T_LINE))
    if g(i, D_VAL) != 0 {
        // Ein Haken aus zwei Strichen, und nicht ein gefuelltes
        // Kaestchen: ein Bildschirmfoto kann einen Haken von einer
        // Auswahlfarbe unterscheiden, eine Fuellung nicht.
        var n: u64 = 0
        while n < 4 {
            wlibc.px(x + 3 + n, oy + 6 + n, wlibc.theme(wlibc.T_ACCENT))
            wlibc.px(x + 3 + n, oy + 7 + n, wlibc.theme(wlibc.T_ACCENT))
            n = n + 1
        }
        n = 0
        while n < 6 {
            wlibc.px(x + 7 + n, oy + 9 - n, wlibc.theme(wlibc.T_ACCENT))
            wlibc.px(x + 7 + n, oy + 10 - n, wlibc.theme(wlibc.T_ACCENT))
            n = n + 1
        }
    }
    let grund: u64 = y + (g(i, D_H)
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
    put_text(wlibc.F_UI, wlibc.px_ui(), x + k + 6, grund, g(i, D_W),
        g(i, D_TEXT), tlen(g(i, D_TEXT)), wlibc.theme(wlibc.T_FG), 0)
    focus_ring(i)
}

// DAS TEXTFELD, und hier steckt die meiste Arbeit dieser Datei.
//
// Es zeigt eine Zeile, es hat eine EINFUEGEMARKE (`D_B`) und einen
// AUSWAHLANKER (`D_C`). Sind beide gleich, ist nichts ausgewaehlt.
// Sonst liegt die Auswahl zwischen ihnen, und sie wird mit der
// Auswahlfarbe hinterlegt und in der Auswahlvordergrundfarbe gesetzt --
// zwei Textlaeufe statt einem, damit die Farbe wirklich wechselt und
// nicht nur der Hintergrund.
// WHERE CHARACTER `at` OF A TEXT FIELD BEGINS. It has to agree with
// `paint_entry` to the pixel -- the caret is drawn from here and the
// selection is measured from here -- so it asks the same function.
// RUNDE ANMELDUNG: DER TEXT, DER GEMALT WIRD -- und das ist bei einem
// Kennwortfeld nicht der, der im Puffer steht.
//
// Die Punkte stehen in einem EIGENEN Puffer dieser Bibliothek und
// werden bei jedem Aufruf neu gefuellt. Zwei Gruende, warum nicht im
// Puffer des Programms: der gehoert dem Programm (es will den Klartext
// pruefen), und ein Feld, das seinen eigenen Inhalt ueberschreibt,
// haette ihn beim ersten Malen verloren.
//
// Der Punkt ist U+2022 (BULLET), in UTF-8 drei Oktette: E2 80 A2.
// Dasselbe Zeichen, das jedes andere System hier setzt.
static mut geheim_puf: [u8; 385] = [0 as u8; 385] // 128 Punkte a 3 Oktette + Abschluss

fn zeig_text(i: u64) -> u64 {
    let p: u64 = g(i, D_TEXT)
    if (g(i, D_FLAGS) & F_GEHEIM) == 0 {
        return p
    }
    var n: u64 = tlen(p)
    if n > 128 {
        n = 128
    }
    var k: u64 = 0
    while k < n {
        geheim_puf[(k * 3 + 0) as usize] = 0xE2 as u8
        geheim_puf[(k * 3 + 1) as usize] = 0x80 as u8
        geheim_puf[(k * 3 + 2) as usize] = 0xA2 as u8
        k = k + 1
    }
    geheim_puf[(n * 3) as usize] = 0 as u8
    return (&geheim_puf[(0) as usize]) as u64
}

// WIE VIELE OKTETTE `at` ZEICHEN IM ANGEZEIGTEN TEXT SIND. Im
// Klartextfeld ist das `at` selbst (so war es immer); im verdeckten
// Feld sind es drei je Punkt, weil der Punkt drei Oktette breit ist.
// `text_w` zaehlt OKTETTE und nicht Zeichen -- stuende hier `at`, saesse
// die Einfuegemarke im Kennwortfeld bei einem Drittel des Weges.
fn zeig_at(i: u64, at: u64) -> u64 {
    if (g(i, D_FLAGS) & F_GEHEIM) == 0 {
        return at
    }
    var a: u64 = at
    if a > 128 {
        a = 128
    }
    return a * 3
}

fn entry_x(i: u64, at: u64) -> u64 {
    return g(i, D_X) + inset_text() + wlibc.text_w(wlibc.F_UI,
        wlibc.px_ui(), zeig_text(i), zeig_at(i, at))
}

// RUNDE ANMELDUNG: DIESES FELD VERDECKT SEINE EINGABE.
//
// Nach `entry(...)` zu rufen und nicht davor -- es braucht die Nummer,
// die `entry` zurueckgibt.
fn entry_geheim(i: u64, an: bool) {
    if i >= MAXWD {
        return
    }
    if an {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_GEHEIM)
    } else {
        s(i, D_FLAGS, g(i, D_FLAGS) & ~F_GEHEIM)
    }
}

fn paint_entry(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    // ROUND LOOK: box and outline from the shape tokens. At radius 0
    // and border 1 this is the `rect` + `frame` it always was.
    // RUNDE 31: Feld und Rand aus fUi -- dieselbe Kurve, derselbe
    // Radius (M_RADIUS_INPUT geht ueber fuib.thema_neu in fUis
    // Formentabelle).
    let _fb9: bool = fuib.tafel(x, y, bw, bh,
        typ_radius(RT_FELD, MR_FIELD, bw, bh),
        wlibc.theme(wlibc.T_ENTRY), wlibc.theme(wlibc.T_LINE),
        wlibc.metric(wlibc.M_BORDER))
    // RUNDE ANMELDUNG: GEMALT WIRD, WAS `zeig_text` SAGT. Im normalen
    // Feld ist das der Puffer des Programms; im Kennwortfeld sind es
    // Punkte. Alles darunter -- Auswahl, Marke, die drei Textlaeufe --
    // rechnet ab hier in OKTETTEN DES ANGEZEIGTEN Textes, sonst faellt
    // das eine gegen das andere auseinander.
    let p: u64 = zeig_text(i)
    let n: u64 = tlen(p)
    let grund: u64 = y + (bh + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
    var a: u64 = zeig_at(i, g(i, D_B))
    var b: u64 = zeig_at(i, g(i, D_C))
    if a > b {
        let t: u64 = a
        a = b
        b = t
    }
    if b > n {
        b = n
    }
    if a > n {
        a = n
    }
    // `a` und `b` sind bereits OKTETTE des ANGEZEIGTEN Textes. Sie
    // duerfen deshalb NICHT noch einmal durch `entry_x` -- das wuerde
    // `zeig_at` ein zweites Mal anwenden und im Kennwortfeld auf das
    // Neunfache laufen. Gemessen wird direkt an `p`.
    let x_a: u64 = x + inset_text()
        + wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, a)
    let x_b: u64 = x + inset_text()
        + wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), p, b)
    if b > a {
        wlibc.rect(x_a, y + 3, sub(x_b, x_a), sub(bh, 6),
            wlibc.theme(wlibc.T_SEL))
    }
    // vor der Auswahl, die Auswahl, danach -- drei Laeufe, damit die
    // ausgewaehlten Zeichen ihre eigene Farbe bekommen.
    var cx: u64 = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), x + inset_text(),
        grund, p, a, wlibc.theme(wlibc.T_FG))
    if b > a {
        cx = wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), x_a, grund,
            p + a, b - a, wlibc.theme_selfg())
    }
    if n > b {
        wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), x_b, grund, p + b,
            n - b, wlibc.theme(wlibc.T_FG))
    }
    // Die Einfuegemarke -- nur, wenn das Feld den Fokus hat. Ein Feld,
    // das immer eine Marke zeigt, sagt nicht mehr, wohin getippt wird.
    if s_focus == i + 1 {
        let mx: u64 = entry_x(i, g(i, D_B))
        // The caret is as wide as a border and never thinner than
        // one pixel -- it is a line, and lines are the one thing this
        // round deliberately leaves alone.
        wlibc.rect(mx, y + 3, wlibc.metric(wlibc.M_BORDER) + 1,
            sub(bh, 6), wlibc.theme(wlibc.T_ACCENT))
    }
    focus_ring(i)
}

// EIN SYMBOL JE ZEILE. `p` zeigt auf ein Feld aus WOERTERN, eines je
// Zeile, und jedes ist entweder
//
//   * ein ZEIGER auf ein Bild im Format OSYM (`tools/k15/icon.py`:
//     vier Oktette "OSYM", Breite, Hoehe, dann Breite mal Hoehe
//     Bildpunkte zu vier Oktetten) -- so liegt es in jedem Buendel unter
//     `/apps/<name>.osp/symbol`, oder
//   * eine FARBE, wenn kein Bild da ist. Dann wird ein Plaettchen in
//     dieser Farbe gemalt und der erste Buchstabe des Namens darauf.
//
// Unterschieden werden die beiden am Kopf: was mit "OSYM" anfaengt, ist
// ein Bild. Ein Zeiger in Ring 3 liegt bei 0x40100000 und eine Farbe
// unter 0x01000000, also waere auch das eine Unterscheidung -- aber eine,
// die von der Speicherkarte abhaengt statt vom Inhalt, und die faellt
// still um, wenn sich die Karte aendert.
//
// WARUM UEBERHAUPT EIN BILD. Der erste Nachtrag hatte nur die Farbe, und
// das war ehrlich, solange dieses System keine Bilddatei lesen konnte.
// Der zweite Nachtrag verlangt ein Buendel, in dem ALLES steckt, was zu
// einem Programm gehoert -- ein Symbol, das in Wahrheit sechs Hexziffern
// in einer Textdatei ist, gehoert nicht dazu. Das Format ist so klein,
// dass der Leser dieser Datei zwanzig Zeilen hat, und es ist trotzdem
// eine Datei mit Bildpunkten darin, die man Punkt fuer Punkt gegen den
// Schirm rechnen kann.
fn list_icons(i: u64, p: u64) {
    s(i, D_D, p)
    dirty_wd(i)
}

// ROUND ICONS: THE THIRD KIND OF ROW SYMBOL, and a list or a table can
// carry it next to the two that already exist.
//
// A word in the array passed here is either 0 (this row has none) or an
// icon out of `lib/icons.fi` with ICON_TAG set.  The tag is bit 63, and
// it is a tag and not a range check for the same reason `ist_bild`
// looks at "OSYM" and not at an address: a rule that depends on where
// something happens to lie in memory falls over silently the day the
// memory map moves.  Bit 63 is set by no pointer this process can hold
// (Ring 3 lives at 0x40100000) and by no colour (colours are 24 bit).
//
// WHY NOT REUSE `list_icons`.  That array means "a picture or a
// colour", it is only read by lists, and it puts a 14 by 14 tile with a
// letter on it where there is no picture.  An icon is neither: it has
// no tile, no letter and no colour of its own -- it takes the colour of
// the row it stands in, which is exactly what makes it work in a light
// and a dark theme without a second set of drawings.
const ICON_TAG: u64 = 9223372036854775808 // 1 << 63

fn icon_id(c: u64) -> u64 {
    return ICON_TAG | c
}

fn row_icons(i: u64, p: u64) {
    s(i, D_ICONS, p)
    dirty_wd(i)
}

// ================================================== RUNDE EXPLORER-2
// DIE MEHRFACHAUSWAHL, nach aussen. Sieben kurze Funktionen, und alle
// arbeiten auf DEM Bitfeld, das der Aufrufer angemeldet hat -- die
// Bibliothek haelt keine zweite Wahrheit darueber, welche Zeile
// markiert ist.
fn sel_an(i: u64, feld: u64, lines: u64) {
    if i >= MAXWD {
        return
    }
    s(i, D_SELP, feld)
    s(i, D_SELN, lines)
    s(i, D_ANKER, 0)
    dirty_wd(i)
}

fn sel_hat(i: u64, z: u64) -> bool {
    let p: u64 = g(i, D_SELP)
    if p == 0 || z >= g(i, D_SELN) {
        return false
    }
    let byte: u64 = __mmio_read8((p + z / 8) as *mut u8) as u64
    return (byte & (1 << (z % 8))) != 0
}

fn sel_setz(i: u64, z: u64, an: bool) {
    let p: u64 = g(i, D_SELP)
    if p == 0 || z >= g(i, D_SELN) {
        return
    }
    let at: u64 = p + z / 8
    var byte: u64 = __mmio_read8((at) as *mut u8) as u64
    let bit: u64 = 1 << (z % 8)
    if an {
        byte = byte | bit
    } else {
        byte = byte & ~bit
    }
    __mmio_write8((at) as *mut u8, byte as u8)
    dirty_wd(i)
}

fn sel_leeren(i: u64) {
    let p: u64 = g(i, D_SELP)
    if p == 0 {
        return
    }
    var k: u64 = 0
    let n: u64 = (g(i, D_SELN) + 7) / 8
    while k < n {
        __mmio_write8((p + k) as *mut u8, 0 as u8)
        k = k + 1
    }
    dirty_wd(i)
}

// ALLE markieren -- Strg+A. Die Zeilenzahl kommt aus dem Widget und
// nicht vom Aufrufer, damit "alle" auch nach einem Wechsel des
// Verzeichnisses wirklich alle sind.
fn sel_alle(i: u64) {
    let p: u64 = g(i, D_SELP)
    if p == 0 {
        return
    }
    var int: u64 = g(i, D_A)
    if g(i, D_KIND) == K_TABLE {
        int = sub(int, 1)
    }
    if int > g(i, D_SELN) {
        int = g(i, D_SELN)
    }
    sel_leeren(i)
    var z: u64 = 0
    while z < int {
        sel_setz(i, z, true)
        z = z + 1
    }
    dirty_wd(i)
}

// Ein BEREICH, vom Anker bis hierher -- Umschalt+Klick. Der Anker ist
// die Zeile, auf der die Auswahl angefangen hat; ohne einen ist die
// angefasste Zeile selbst der Anfang.
fn sel_bereich(i: u64, bis: u64) {
    if g(i, D_SELP) == 0 {
        return
    }
    var von: u64 = g(i, D_ANKER)
    var b: u64 = bis
    if von > b {
        let t: u64 = von
        von = b
        b = t
    }
    sel_leeren(i)
    var z: u64 = von
    while z <= b {
        sel_setz(i, z, true)
        z = z + 1
    }
    dirty_wd(i)
}

fn sel_anker(i: u64, z: u64) {
    s(i, D_ANKER, z)
}

// Wo ein Bereich angefangen hat -- fuer die Belegzeile eines Programms,
// das seine Auswahl meldet. Ohne einen Leser waere der Anker eine
// Zahl, die nur die Bibliothek kennt.
fn sel_anker_von(i: u64) -> u64 {
    if i >= MAXWD {
        return 0
    }
    return g(i, D_ANKER)
}

// Wie oft ein Mausrahmen (Ziehen ueber eine Liste) die Auswahl
// gesetzt hat.
fn sel_frame() -> u64 {
    return s_rahmen
}

// RUNDE CLIP-2: dieses Programm nimmt Abgelegtes an. Ohne diesen Ruf
// meldet `on_up` kein `K_DROP` -- ein Programm, das mit einer fremden
// Ziehbewegung nichts anfangen kann, soll auch nicht gefragt werden.
fn drop_an(an: bool) {
    if an {
        s_dropan = 1
    } else {
        s_dropan = 0
    }
}

// Wie oft ein Ablegen gemeldet wurde. Fuer die Abnahme: eine Zahl auf
// der Leitung schlaegt ein Standbild.
fn drop_count() -> u64 {
    return s_drops
}

// Wie oft eine Ziehbewegung angefangen hat.
fn drag_starts() -> u64 {
    return s_drags
}

// Wie viele Zeilen markiert sind. Gezaehlt und nicht mitgefuehrt: ein
// Zaehler, der neben dem Bitfeld herlaeuft, ist ein zweiter Ort, an dem
// dieselbe Wahrheit stehen kann.
fn sel_num(i: u64) -> u64 {
    if g(i, D_SELP) == 0 {
        return 0
    }
    var n: u64 = 0
    var z: u64 = 0
    while z < g(i, D_SELN) {
        if sel_hat(i, z) {
            n = n + 1
        }
        z = z + 1
    }
    return n
}

// The icon of visible row `z`, or 0.  One place where the array is
// read, so a list and a table cannot disagree about what is in it.
fn icon_at_row(i: u64, z: u64) -> u64 {
    let p: u64 = g(i, D_ICONS)
    if p == 0 {
        return 0
    }
    let w: u64 = __mmio_read64((p + z * 8) as *mut u64)
    if (w & ICON_TAG) == 0 {
        return 0
    }
    return w & 65535
}

// "OSYM" -- vier Oktette, gelesen als eine Zahl waere es von der
// Ausrichtung abhaengig, also Oktett fuer Oktett.
//
// ZUERST DER BEREICH, DANN DIE KENNUNG, und das ist kein Uebereifer: die
// erste Fassung fragte nur `p < 4096` und las danach vier Oktette. Eine
// FARBE wie 0x707880 ist groesser als 4096 -- der Starter setzte genau
// die fuer seine Dateitreffer, und der Prozess starb mit
// `user fault: cr2=0x707880`. Ein Wort ist nur dann ein Zeiger, wenn es
// in den privaten Bereich dieses Prozesses zeigt (`proc.IMAGE_BASE` bis
// zum Ende der privaten Seiten); alles andere ist eine Farbe.
const U_LO: u64 = 0x40100000
const U_HI: u64 = 0x40200000

fn is_image_pub(p: u64) -> bool {
    return is_image(p)
}

fn is_image(p: u64) -> bool {
    if p < U_LO || p >= U_HI {
        return false
    }
    if __mmio_read8((p) as *mut u8) != 79 as u8 {
        return false
    }
    if __mmio_read8((p + 1) as *mut u8) != 83 as u8 {
        return false
    }
    if __mmio_read8((p + 2) as *mut u8) != 89 as u8 {
        return false
    }
    return __mmio_read8((p + 3) as *mut u8) == 77 as u8
}

fn image_w(p: u64) -> u64 {
    return __mmio_read32((p + 4) as *mut u32) as u64
}

fn image_h(p: u64) -> u64 {
    return __mmio_read32((p + 8) as *mut u32) as u64
}

// Das Bild in ein Feld von `kw` mal `kh`. Groesser wird nicht skaliert,
// sondern beschnitten -- ein Symbol, das nicht passt, ist ein Fehler im
// Buendel und soll auffallen, nicht weichgezeichnet werden.
fn image_paint(p: u64, x: u64, y: u64, kw: u64, kh: u64) {
    let w: u64 = image_w(p)
    let h: u64 = image_h(p)
    if w == 0 || h == 0 || w > 64 || h > 64 {
        return
    }
    var r: u64 = 0
    while r < h && r < kh {
        var c: u64 = 0
        while c < w && c < kw {
            let f: u64 = __mmio_read32((p + 12 + (r * w + c) * 4)
                as *mut u32) as u64
            // DECKUNG NULL HEISST DURCHSICHTIG, und dann bleibt stehen,
            // was schon da ist -- die Auswahlfarbe der Zeile zum
            // Beispiel. Ohne das haette jedes Symbol einen schwarzen
            // Kasten um sich, und ein Pruefer, der die Zeilenfarbe misst,
            // faende sie an den Ecken nicht.
            if (f >> 24) != 0 {
                wlibc.px(x + c, y + r, f & wlibc.RGB24)
            }
            c = c + 1
        }
        r = r + 1
    }
}

// ROUND ICONS: HOW FAR THE FIRST COLUMN OF A TABLE MOVES RIGHT.
//
// WIDGET-WIDE AND NOT PER ROW, and both reasons matter.  Visually: a
// column whose names start at two different x depending on whether that
// row happens to have an icon is a ragged column.  And for the
// measurement: `cell_x` reports where a cell BEGINS, the file manager
// tells the test runner that number, and the runner then looks for ink
// there.  A per-row indent could not be reported by a per-widget
// function, so the two would disagree -- which is exactly the bug this
// function exists to make impossible.  `paint_table` and `cell_x` both
// go through here.
fn table_in(i: u64) -> u64 {
    if g(i, D_KIND) == K_TABLE && g(i, D_ICONS) != 0 {
        // RUNDE ECHTHARDWARE-2: der Abstand skaliert mit, wie im
        // Listenzweig darunter -- 4 feste Punkte sind neben einem
        // doppelt so grossen Symbol kein Abstand mehr.
        return wlibc.icon_small() + 4 * wlibc.ui_scale()
    }
    return 0
}

// ============================================== RUNDE ECHTHARDWARE-2
// DER EINZUG WAECHST MIT DEM SYMBOL.
//
// Hier stand zweimal die feste 22: 16 Punkte Symbol und 6 Abstand,
// gemessen bei einfacher Vervielfachung. Seit `wlibc.icon_draw` das
// Bild vergroessert, ist das Symbol bei doppelter Vervielfachung 32
// Punkte breit -- und lief damit UNTER den Text, der weiterhin bei 22
// anfing. Auf Justins Foto ist das die Zeile, in der Ordnersymbol und
// Name aneinanderkleben, im Startmenue wie im Dateimanager.
//
// `table_ein` daneben hat es immer richtig gemacht (`icon_small() +
// 4`); die Liste zieht jetzt gleich. Der Abstand ist Justins Vorgabe:
// acht Punkte mal Vervielfachung zwischen Bild und Wort.
fn list_in(i: u64) -> u64 {
    if g(i, D_KIND) == K_LIST
        && (g(i, D_D) != 0 || g(i, D_ICONS) != 0) {
        return wlibc.icon_small() + 6 * wlibc.ui_scale()
    }
    return 0
}

// RUNDE THEMESTORE: EINE ZEILE, DIE NICHT PASST, WIRD GEKUERZT --
// und die gekuerzte wird gemeldet.
//
// Der Starter setzt Zeilen wie "Suchen -- Programme und Dateien finden
// und starten": 412 Bildpunkte breit in einer Liste, die 416 breit ist
// und davon 15 an den Rollbalken und 22 an das Symbol verliert. Gemalt
// wurde bisher trotzdem die ganze Zeile; der Rest lief unter dem
// Rollbalken durch bis an den Fensterrand. Im Bild sah man ein Wort,
// das an der Kante aufhoert, und in `wlib: text ... tw=` stand die
// Breite, die der Text GERN gehabt haette. Ein Pruefer, der beides
// vergleicht, bekommt "abgeschnitten" -- zu Recht.
//
// Also: so viele GANZE Zeichen wie hineingehen, dann drei Punkte. Die
// Grenze wird an UTF-8 gehalten (Folgeoktette 0x80..0xBF gehoeren zum
// Zeichen davor) -- ein halb abgeschnittener Umlaut waere genau der
// Fehler, den die Runde davor gejagt hat.
static mut el_buf: [u8; 192] = [0 as u8; 192]

fn fit_n(f: u64, pxs: u64, p: u64, n: u64, limit: u64) -> u64 {
    var k: u64 = n
    while k > 0 {
        // nicht mitten in ein Zeichen hinein
        while k > 0
            && (__mmio_read8((p + k) as *mut u8) & 192 as u8) == 128 as u8 {
            k = k - 1
        }
        if wlibc.text_w(f, pxs, p, k) <= limit {
            return k
        }
        if k == 0 {
            return 0
        }
        k = k - 1
    }
    return 0
}

// Gibt die Laenge im Puffer zurueck; `el_buf` traegt danach den Text,
// der wirklich gemalt werden soll. Passt alles, wird nichts kopiert
// und `p` bleibt der Text -- dafuer sagt die Funktion, ob sie gekuerzt
// hat.
fn elide(f: u64, pxs: u64, p: u64, n: u64, limit: u64) -> u64 {
    if n == 0 || wlibc.text_w(f, pxs, p, n) <= limit {
        return 0
    }
    var dots: [u8; 4] = "...\0"
    let dw: u64 = wlibc.text_w(f, pxs, (&dots[0 as usize]) as u64, 3)
    let k: u64 = fit_n(f, pxs, p, n, sub(limit, dw))
    var a: u64 = 0
    while a < k && a < 188 {
        __mmio_write8(((&el_buf[0 as usize]) as u64 + a) as *mut u8,
            __mmio_read8((p + a) as *mut u8))
        a = a + 1
    }
    var d: u64 = 0
    while d < 3 {
        __mmio_write8(((&el_buf[0 as usize]) as u64 + a) as *mut u8,
            46 as u8)
        a = a + 1
        d = d + 1
    }
    __mmio_write8(((&el_buf[0 as usize]) as u64 + a) as *mut u8, 0 as u8)
    return a
}

fn paint_list(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    // RUNDE FUI-WIN11: die Zeilenhoehe DIESER Liste (zweizeilig oder
    // nicht), nicht die des Systems.
    let zh: u64 = row_h_of(i)
    let sicht: u64 = sub(bh, 4) / zh
    // RUNDE GLAS: der Radius der Liste kommt aus der Rolle "Feld" --
    // eine Liste ist ein Feld mit Zeilen darin, und zwei Marken fuer
    // dieselbe Kante waeren zwei Zahlen, die auseinanderlaufen.
    wlibc.rframe(x, y, bw, bh, typ_radius(RT_LISTE, MR_FIELD, bw, bh),
        wlibc.metric(wlibc.M_BORDER), wlibc.theme(wlibc.T_LINE),
        wlibc.theme(wlibc.T_ENTRY))
    let int: u64 = g(i, D_A)
    var r: u64 = 0
    while r < sicht {
        let z: u64 = g(i, D_B) + r
        if z < int {
            let q: u64 = row_at(g(i, D_TEXT), z)
            let ln: u64 = row_len(q)
            let ry: u64 = y + 2 + r * zh
            var farbe: u64 = wlibc.theme(wlibc.T_FG)
            // RUNDE EXPLORER-2: der Balken gilt fuer die Zeile mit
            // dem Zeiger UND fuer jede markierte. Zwei Farben (eine
            // fuer "markiert", eine fuer "hier steht der Zeiger")
            // waeren ehrlicher, aber dieses Thema hat nur EIN
            // Auswahlblau -- und zwei erfundene Toene waeren eine
            // Farbe, die in keinem Schema steht.
            if z == g(i, D_VAL) || sel_hat(i, z) {
                // RUNDE 32: der Auswahlbalken aus fUi. Die BEDINGUNG darueber
                // (D_VAL bzw. sel_hat) ist unangetastet -- nur das Rechteck
                // wird von fUi gemalt.
                let _fb10: bool = fuib.area(x + 1, ry, sub(bw, 16), zh,
                    wlibc.theme(wlibc.T_SEL))
                farbe = wlibc.theme_selfg()
            }
            // ROUND ICONS: an icon takes precedence over the tile.
            // A row that has both was a mistake in the caller, and
            // drawing the icon is the answer that loses no information.
            let sym: u64 = icon_at_row(i, z)
            if sym != 0 {
                // RUNDE ECHTHARDWARE-2: MITTIG IN DER ZEILE. `ry + 2`
                // war ein fester Abstand von oben und setzte das
                // Symbol bei doppelter Vervielfachung sichtbar ueber
                // die Schriftlinie -- Justins "Symbol sitzt tiefer /
                // nicht auf gleicher Hoehe wie der Text". Dieselbe
                // Rechnung wie in `icon_y`, damit Bericht und Bild
                // dieselbe Zahl nennen.
                let ih: u64 = wlibc.icon_small()
                var oy: u64 = 2
                if zh > ih {
                    oy = (zh - ih) / 2
                }
                let _ = wlibc.icon_at(sym, icon_x(i), ry + oy,
                    ih, farbe)
            }
            let ein: u64 = list_in(i)
            // RUNDE HOTPLUG-2: DER ZEIGER AUF DIE PLAETTCHEN KANN NULL
            // SEIN, und dann darf hier nicht gelesen werden.
            //
            // `list_in` gibt schon dann einen Einzug zurueck, wenn
            // ENTWEDER Plaettchen (`D_D`) ODER Symbole (`D_ICONS`)
            // gesetzt sind -- eine Liste mit `row_icons` und OHNE
            // Plaettchen erfuellt das. Gelesen wurde danach trotzdem
            // aus `D_D`, also aus der Adresse `0 + z * 8`.
            //
            // Sichtbar wird es erst bei einer Zeile OHNE eigenes
            // Symbol (`sym == 0`) -- in der Seitenleiste des
            // Dateimanagers ist das die Kopfzeile "Datentraeger", und
            // die gibt es erst, seit dort ein Stick steht. Gemessen:
            // `user fault: pid=3 vector=14 err=0x5 cr2=0x28` in
            // `wlib.paint_list`, und 0x28 ist 40 -- Zeile 5 mal acht.
            //
            // `icon_at_row` daneben macht es richtig und prueft seinen
            // Zeiger. Hier fehlte genau diese Zeile.
            if ein != 0 && sym == 0 && g(i, D_D) != 0 {
                let f: u64 = __mmio_read64((g(i, D_D) + z * 8) as *mut u64)
                if is_image(f) {
                    // KEIN RAHMEN UEBER EIN BILD. Der erste Entwurf malte
                    // erst das Symbol und dann denselben Rahmen wie um
                    // ein Farbplaettchen -- und ueberschrieb damit die
                    // untere und die rechte Kante des Bildes. Der
                    // Pruefer sah 25 von 169 deckenden Bildpunkten
                    // falsch; im Bild sah man nichts. Ein Symbol bringt
                    // seinen Rand selbst mit oder hat keinen.
                    // ================== RUNDE LISTENSYMBOLE
                    // GERASTERT IN ZIELGROESSE, NICHT ROH.
                    //
                    // Hier stand `bild_malen(...)`, und das malt einen
                    // Punkt der Quelle als EINEN Punkt des Schirms --
                    // ohne Vervielfachung. Ein 16x16-Buendelsymbol kam
                    // also 16x16 in ein Plaettchen, das bei uiscale=2
                    // 28 Punkte breit ist: ein kleiner Fleck oben links
                    // im Feld, daneben Leere. Justin hat es "matschige
                    // Farbkleckse" genannt, ZOOM-listenicons.png zeigt
                    // es.
                    //
                    // `icon_draw_sc` ist derselbe Weg, den die
                    // Anhefter in der Leiste gehen: ein Quellpunkt wird
                    // zu einem s-mal-s-Kaestchen, also GANZZAHLIG
                    // vergroessert. Ganzzahlig ist der Punkt -- ein
                    // krummer Faktor verschmiert die Kanten, und genau
                    // das war der Matsch.
                    //
                    // Der Faktor ist der groesste, der noch ins
                    // Plaettchen passt (mindestens 1), und was dann
                    // uebrig bleibt, wird links/oben zur Haelfte
                    // verteilt: das Symbol steht MITTIG im Plaettchen
                    // statt in der Ecke.
                    let bw3: u64 = wlibc.icon_w(f)
                    let bh3: u64 = wlibc.icon_h(f)
                    if bw3 != 0 && bh3 != 0 {
                        let tw3: u64 = tile_w()
                        var sc3: u64 = tw3 / bw3
                        let sy3: u64 = tw3 / bh3
                        if sy3 < sc3 {
                            sc3 = sy3
                        }
                        if sc3 == 0 {
                            sc3 = 1
                        }
                        let dw3: u64 = bw3 * sc3
                        let dh3: u64 = bh3 * sc3
                        var ox3: u64 = 0
                        if tw3 > dw3 {
                            ox3 = (tw3 - dw3) / 2
                        }
                        var oy3: u64 = 0
                        if tw3 > dh3 {
                            oy3 = (tw3 - dh3) / 2
                        }
                        let _b3: bool = wlibc.icon_draw_sc(f,
                            x + 5 + ox3, ry + 3 + oy3, sc3)
                    }
                } else {
                // RUNDE GLAS: `M_RADIUS_INPUT / 2` war eine abgetippte
                // Halbierung -- das Plaettchen blieb kantig, waehrend
                // die Liste um es herum rund wurde. Jetzt dieselbe
                // Rolle wie die Liste; `rrect` deckelt auf die halbe
                // Kantenlaenge, ein Plaettchen wird also nie ein Kreis,
                // ohne dass hier eine zweite Zahl steht.
                let rp: u64 = draw_radius(MR_FIELD)
                wlibc.rrect(x + 5, ry + 3, tile_w(), tile_w(), rp, f)
                wlibc.rframe(x + 5, ry + 3, tile_w(), tile_w(), rp,
                    wlibc.metric(wlibc.M_BORDER),
                    wlibc.theme(wlibc.T_LINE), f)
                if ln > 0 {
                    // MITTIG AUF DAS PLAETTCHEN, und das ist keine
                    // Feinheit: die erste Fassung setzte den Buchstaben
                    // auf eine feste Stelle, und bei einem breiten
                    // ragte er ueber den Rand -- im Bild sah man einen
                    // Buchstaben, im Pruefer 49 von 67 Tintenpunkten
                    // falsch, weil dort nicht mehr die Farbe des
                    // Plaettchens hinter ihm stand.
                    let bw2: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(),
                        q, 1)
                    // WEISS WAR FALSCH, UND ZWAR MESSBAR: die Farbe
                    // des Plaettchens kommt aus der Anwendung, und auf
                    // einem hellen Plaettchen ist ein weisser
                    // Buchstabe nicht zu lesen. `theme_on` rechnet den
                    // Kontrast beider Kandidaten aus und nimmt den
                    // besseren -- dieselbe Rechnung, mit der die
                    // Akzentfarbe ihre Schriftfarbe bekommt.
                    wlibc.text_at(wlibc.F_UI, wlibc.px_ui(),
                        x + 5 + sub(14, bw2) / 2, ry + 3 + 12, q, 1,
                        wlibc.theme_on(f))
                }
                }
            }
            // ROUND LOOK, THIRD ADDENDUM: A LIST ROW SAYS WHERE IT
            // DREW. Until here it did not, and that is exactly why
            // "Text schreiben und aendern" could sit in the starter for
            // half a year: the launcher's rows carry the bundle labels,
            // the bundle labels never go through the catalogue, and a
            // widget that reports nothing cannot be photographed. The
            // draw goes through `put_text` for one reason -- it is what
            // sets `s_tx`, so the reported x is the one the text
            // really started at and not a second guess at it.
            // ================================ RUNDE FUI-WIN11
            // EINE ZEILE ODER ZWEI -- UND DER SCHNITT IST DER TABULATOR.
            //
            // Einzeilig bleibt alles, wie es war. Zweizeilig wird die
            // Zeile am TABULATOR (9) geteilt: davor der Name, dahinter
            // die Beschreibung. Steht kein Tabulator darin, ist die
            // ganze Zeile der Name und die zweite Zeile bleibt leer --
            // eine Liste, die einen Eintrag ohne Beschreibung bekommt,
            // soll ihn zeigen und nicht verschlucken.
            var n1: u64 = ln
            var p2: u64 = 0
            var n2: u64 = 0
            if g(i, D_ZWEI) != 0 {
                var t: u64 = 0
                while t < ln {
                    if (*((q + t) as *mut u8)) == 9 as u8 {
                        n1 = t
                        p2 = q + t + 1
                        n2 = sub(ln, t + 1)
                        t = ln
                    } else {
                        t = t + 1
                    }
                }
            }
            // Was zwischen dem Textanfang und dem Rollbalken frei ist:
            // die Breite, ab der gekuerzt werden muss.
            let free: u64 = sub(bw, 21 + 6 + ein)
            var qq: u64 = q
            var qn: u64 = n1
            let el: u64 = elide(wlibc.F_UI, wlibc.px_ui(), q, n1, free)
            if el != 0 {
                qq = (&el_buf[0 as usize]) as u64
                qn = el
            }
            // DIE GRUNDLINIE DER ERSTEN ZEILE. Einzeilig ist das die
            // Mitte der Zeile wie bisher; zweizeilig sitzt sie im
            // OBEREN Halbfeld, damit beide Zeilen zusammen mittig
            // stehen.
            var rgrund: u64 = base_in_row(ry, zh)
            if n2 != 0 || g(i, D_ZWEI) != 0 {
                rgrund = base_in_row(ry, zh / 2)
            }
            let _rt: u64 = put_text(wlibc.F_UI, wlibc.px_ui(),
                x + 6 + ein, rgrund, sub(bw, 16), qq, qn, farbe, 0)
            // DIE ZWEITE ZEILE, GEDAEMPFT. Sie ist eine Beschreibung
            // und kein zweiter Name -- auf Windows steht sie grau, und
            // das ist auch der Grund, warum sie nicht fett ist.
            //
            // AUF DEM AUSWAHLBALKEN NICHT GEDAEMPFT: dort ist der
            // Grund die Akzentfarbe, und die gedaempfte Textfarbe des
            // Themas ist gegen sie nicht gerechnet. Dann traegt die
            // zweite Zeile dieselbe Farbe wie die erste -- lesbar ist
            // wichtiger als leise.
            if n2 != 0 {
                var f2: u64 = wlibc.theme(wlibc.T_DIM)
                if z == g(i, D_VAL) || sel_hat(i, z) {
                    f2 = farbe
                }
                var q2: u64 = p2
                var n2s: u64 = n2
                let e2: u64 = elide(wlibc.F_UI, wlibc.px_ui(), p2, n2,
                    free)
                if e2 != 0 {
                    q2 = (&el_buf[0 as usize]) as u64
                    n2s = e2
                }
                let _r2: u64 = put_text(wlibc.F_UI, wlibc.px_ui(),
                    x + 6 + ein, base_in_row(ry + zh / 2, zh / 2),
                    sub(bw, 16), q2, n2s, f2, 0)
            }
            var rhg: u64 = wlibc.theme(wlibc.T_ENTRY)
            // RUNDE EXPLORER-2: markiert ODER die Zeile mit dem Zeiger.
            if z == g(i, D_VAL) || sel_hat(i, z) {
                rhg = wlibc.theme(wlibc.T_SEL)
            }
            // GEMELDET WIRD, WAS GEMALT WURDE -- nicht, was gewuenscht
            // war. Sonst misst ein Pruefer die eine Zeile gegen die
            // Breite der anderen.
            say_painted(g(i, D_WIN), K_LIST, rgrund, farbe, rhg, qq, qn)
        }
        r = r + 1
    }
    paint_scroll(x + bw - 15, y + 1, sub(bh, 2), g(i, D_B), sicht, int)
    focus_ring(i)
}

fn column_wide(i: u64, c: u64) -> u64 {
    let p: u64 = g(i, D_D)
    if p == 0 {
        return 100
    }
    return __mmio_read64((p + c * 8) as *mut u64)
}

fn paint_table(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    let zh: u64 = lines_height()
    let kopf: u64 = zh + 4
    let sicht: u64 = sub(sub(bh, 4), kopf) / zh
    let cols: u64 = g(i, D_C)
    // ================================================== RUNDE 32
    // fUi MALT DIE FLAECHEN. DIE SPALTENBREITEN BLEIBEN, WO SIE SIND.
    //
    // `D_D` traegt die Spaltenbreiten, `D_C` die Spaltenzahl, `D_A` den
    // Rollversatz und `D_VAL`/`sel_hat` die Auswahl -- alles vier wird
    // WEITER von wlib gerechnet (cell_x, head_base, cell_base). fUis
    // `draw_table` fuehrt sein eigenes Spaltenmodell; die beiden
    // gegeneinander zu uebersetzen waere genau der halb uebersetzte
    // Zustand, der falsch malt, ohne es zu sagen.
    // RUNDE GLAS: die Flaeche der Tabelle bekommt den Radius ihrer
    // Rolle. Die KOPFZEILE darunter bleibt eckig -- sie ist ein
    // Streifen INNERHALB dieser Flaeche und keine eigene Tafel; eine
    // zweite Rundung darin erzeugte nur eine Kerbe an der Oberkante.
    let _fb11: bool = fuib.tafel(x, y, bw, bh,
        typ_radius(RT_TABELLE, MR_FIELD, bw, bh),
        wlibc.theme(wlibc.T_ENTRY), 0, 0)
    // DIE KOPFZEILE. Sie ist Zeile 0 des Textblocks -- so steht die
    // Beschriftung in derselben Quelle wie die Daten, und eine Spalte,
    // die dazukommt, kann nicht vergessen werden.
    let _fb12: bool = fuib.area(x + 1, y + 1, sub(bw, 2), kopf,
        wlibc.theme(wlibc.T_HEAD))
    let kq: u64 = row_at(g(i, D_TEXT), 0)
    let kl: u64 = row_len(kq)
    var cx: u64 = x + 6
    var c: u64 = 0
    while c < cols {
        let q: u64 = col_at(kq, kl, c)
        if q != 0 {
            let ln: u64 = col_len(q, sub(kl, sub(q, kq)))
            // ROUND ICONS: the heading of the first column moves right
            // with its data.  Only the TEXT -- `cx` keeps carrying the
            // column geometry, because the separator lines below use it
            // and they must stay where the columns are.
            var hx: u64 = cx
            if c == 0 {
                hx = cx + table_in(i)
            }
            // Dieselbe Meldung fuer die Kopfzeile. Sie traegt
            // "Name / Groesse / Zeit / Rechte" -- und "Groesse" ist die
            // einzige Zeichenkette der Oberflaeche, in der ein `oe` und
            // ein `ss` NEBENEINANDER stehen. Ohne diese Zeile ist sie
            // nicht nachmessbar.
            let kgrund: u64 = y + 3 + wlibc.ascent_of(wlibc.F_UI,
                wlibc.px_ui())
            let _kt: u64 = put_text(wlibc.F_UI, wlibc.px_ui(), hx, kgrund,
                column_wide(i, c), q, ln, wlibc.theme(wlibc.T_FG), 0)
            say_painted(g(i, D_WIN), K_TABLE, kgrund,
                wlibc.theme(wlibc.T_FG), wlibc.theme(wlibc.T_HEAD),
                q, ln)
        }
        cx = cx + column_wide(i, c)
        if c + 1 < cols {
            wlibc.vline(cx - 4, y + 1, kopf, wlibc.theme(wlibc.T_LINE))
        }
        c = c + 1
    }
    wlibc.hline(x + 1, y + kopf, sub(bw, 2), wlibc.theme(wlibc.T_LINE))
    let int: u64 = sub(g(i, D_A), 1)
    var r: u64 = 0
    while r < sicht {
        let z: u64 = g(i, D_B) + r
        if z < int {
            let q: u64 = row_at(g(i, D_TEXT), z + 1)
            let ln: u64 = row_len(q)
            let ry: u64 = y + kopf + 1 + r * zh
            var farbe: u64 = wlibc.theme(wlibc.T_FG)
            // RUNDE EXPLORER-2: der Balken gilt fuer die Zeile mit
            // dem Zeiger UND fuer jede markierte. Zwei Farben (eine
            // fuer "markiert", eine fuer "hier steht der Zeiger")
            // waeren ehrlicher, aber dieses Thema hat nur EIN
            // Auswahlblau -- und zwei erfundene Toene waeren eine
            // Farbe, die in keinem Schema steht.
            if z == g(i, D_VAL) || sel_hat(i, z) {
                // RUNDE 32: der Auswahlbalken aus fUi. Die BEDINGUNG darueber
                // (D_VAL bzw. sel_hat) ist unangetastet -- nur das Rechteck
                // wird von fUi gemalt.
                let _fb13: bool = fuib.area(x + 1, ry, sub(bw, 16), zh,
                    wlibc.theme(wlibc.T_SEL))
                farbe = wlibc.theme_selfg()
            }
            var tx: u64 = x + 6
            // ROUND ICONS: the icon of the row goes in front of the
            // FIRST column, and only the first column moves right.  A
            // table whose every column shifted would have its header
            // over the wrong data.
            let einr: u64 = table_in(i)
            let sym: u64 = icon_at_row(i, z)
            if sym != 0 {
                // RUNDE ECHTHARDWARE-2: mittig, wie in der Liste.
                let ih2: u64 = wlibc.icon_small()
                var oy2: u64 = 2
                if zh > ih2 {
                    oy2 = (zh - ih2) / 2
                }
                let _ = wlibc.icon_at(sym, tx, ry + oy2, ih2, farbe)
            }
            c = 0
            while c < cols {
                let cq: u64 = col_at(q, ln, c)
                if cq != 0 {
                    var cl: u64 = col_len(cq, sub(ln, sub(cq, q)))
                    // was nicht in die Spalte passt, wird abgeschnitten
                    // und nicht in die naechste geschrieben
                    // RUNDE I18N: `fit` statt "ein Oktett weniger, bis
                    // es passt". Die alte Schleife hat ein Zeichen
                    // zerteilt, sobald die Spalte mitten in einem
                    // Umlaut endete.
                    let platz: u64 = sub(column_wide(i, c), 6)
                    cl = wlibc.fit(wlibc.F_UI, wlibc.px_ui(), cq, cl, platz)
                    var f2: u64 = farbe
                    if c > 0 && z != g(i, D_VAL) {
                        f2 = wlibc.theme(wlibc.T_DIM)
                    }
                    var txx: u64 = tx
                    if c == 0 {
                        txx = tx + einr
                    }
                    wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), txx,
                        base_in_row(ry, zh), cq, cl, f2)
                }
                tx = tx + column_wide(i, c)
                c = c + 1
            }
        }
        r = r + 1
    }
    wlibc.frame(x, y, bw, bh, wlibc.theme(wlibc.T_LINE))
    paint_scroll(x + bw - 15, y + kopf + 1, sub(sub(bh, kopf), 2),
        g(i, D_B), sicht, int)
    focus_ring(i)
}

// THE TAB BAR DID NOT FIT AND NOBODY HAD LOOKED.
//
// Seven tabs of German text come to 576 pixels; the widget is 540 wide.
// So "Sprache" was drawn from x=505 to x=586, thirty-six pixels past
// the end of its own widget, and the eighth tab this round adds would
// have started at 586 and run off the window entirely. It has been that
// way since the seventh tab came back; nothing said so, because a
// widget that paints outside its rectangle is not an error anywhere in
// this library -- it is just paint.
//
// It was found by the tab trace line this round added, which is the
// whole argument for trace lines: `x=586 w=85` in a widget that ends at
// 550 is a sentence, and a screenshot of it is a shrug.
//
// The fix is one division. If the natural widths do not fit, every tab
// is scaled by the same factor and the labels are clipped to what is
// left. Painter and hit test both come through here, so they cannot
// disagree about where a tab is -- which is the only thing that would
// be worse than tabs that are too wide.
//
// ================================ RUNDE GLAS (nachtrag): ZWEI ZEILEN
//
// Die Division war ehrlich, aber sie loeste das Falsche. Elf deutsche
// Reiter messen 861 Bildpunkte in einer Leiste von 728: JEDER wurde
// anteilig schmaler und NEUN von elf verloren Buchstaben ("Netzzu...",
// "Darstell..."). Eine Zusage, die neun gekuerzte Reiter erlaubt,
// misst nichts -- sie schreibt den Ist-Zustand fest.
//
// Passt die Zeile nicht, bekommt die Leiste deshalb eine ZWEITE: die
// Reiter werden auf zwei Zeilen verteilt, und zwar dort geteilt, wo
// die Haelfte der Gesamtbreite erreicht ist, damit beide Zeilen etwa
// gleich voll sind. 861 auf zwei Zeilen sind rund 430 je Zeile in 728
// Bildpunkten -- kein einziger Reiter muss mehr gekuerzt werden, und
// die Division bleibt als Rueckfall fuer den Tag, an dem eine ZEILE
// allein nicht mehr passt.
//
// Alle vier Rechnungen (Breite, Stelle, Zeile, Hoehe) stehen hier und
// sind die einzigen: Maler, Treffer und Fokusring holen sich dieselben
// Zahlen, sonst laege ein Reiter woanders, als er anklickbar ist.
// ============ UND DIE BREITEN WERDEN EINMAL GEMESSEN UND NICHT TAUSENDMAL
//
// Die natuerliche Breite eines Reiters ist eine Schriftmessung
// (`text_w` geht Zeichen fuer Zeichen durch die Zeichentabelle), und
// die vier Rechnungen darueber rufen einander: `tab_x` fragt
// `tab_width`, `tab_width` fragt die Summe SEINER ZEILE, die Zeile
// fragt `tab_split`, und `tab_split` summiert alle elf. Ohne
// Zwischenspeicher sind das mehrere tausend Schriftmessungen je
// Anstrich der Leiste -- GEMESSEN: die Seite brauchte danach mehr als
// zwei Sekunden fuer einen Reiterwechsel, und auf dem Bild stand noch
// die alte Seite, weil der Anstrich zum Zeitpunkt der Aufnahme erst
// beim neunten Reiter war.
//
// Also einmal messen, solange sich nichts aendert. Der Schluessel ist
// alles, woran eine Breite haengt: der Textblock, die Breite der
// Leiste, die Schriftgroesse und die Laenge des Blocks (ein
// Sprachwechsel schreibt unter Umstaenden in denselben Puffer). Passt
// er nicht mehr, wird neu gemessen -- eine Zwischenspeicherung, die
// man nicht loswird, waere schlimmer als die langsame Rechnung.
static mut tbc_key: u64 = 0
static mut tbc_n: u64 = 0
static mut tbc_sum: u64 = 0
static mut tbc_nat: [u64; 12] = [0 as u64; 12]

fn tab_fill(i: u64) {
    let q0: u64 = g(i, D_TEXT)
    let schluessel: u64 = q0 ^ (g(i, D_W) * 7919) ^ (wlibc.px_ui() * 104729)
        ^ (tlen(q0) * 131) ^ (i + 1)
    if schluessel == tbc_key && tbc_key != 0 {
        return
    }
    tbc_key = schluessel
    tbc_sum = 0
    tbc_n = 0
    var k: u64 = 0
    while k < 12 {
        let q: u64 = row_at(q0, k)
        if q == 0 {
            tbc_nat[(k) as usize] = 0
            k = k + 1
        } else {
            let b: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                row_len(q)) + 20
            tbc_nat[(k) as usize] = b
            tbc_sum = tbc_sum + b
            tbc_n = tbc_n + 1
            k = k + 1
        }
    }
}

fn tab_natur(i: u64, k: u64) -> u64 {
    if k >= 12 {
        return 0
    }
    tab_fill(i)
    return tbc_nat[(k) as usize]
}

fn tab_sum(i: u64) -> u64 {
    tab_fill(i)
    return tbc_sum
}

// WIE VIELE REITER DIE LEISTE UEBERHAUPT HAT.
fn tab_n(i: u64) -> u64 {
    tab_fill(i)
    return tbc_n
}

// EINE ZEILE ODER ZWEI -- gefragt fuer eine BREITE und nicht fuer das
// Bedienelement, weil `place` die Hoehe braucht, bevor die Breite im
// Feld steht. Wer das Bedienelement meint, nimmt `tab_rows`.
fn tab_rows_at(i: u64, platz: u64) -> u64 {
    if platz == 0 || tab_sum(i) <= platz || tab_n(i) < 2 {
        return 1
    }
    return 2
}

fn tab_rows(i: u64) -> u64 {
    return tab_rows_at(i, g(i, D_W))
}

// WO DIE ERSTE ZEILE AUFHOERT: beim ersten Reiter, mit dem die halbe
// Gesamtbreite erreicht ist. Damit sind beide Zeilen etwa gleich voll;
// eine Teilung "so viel wie passt" liesse die zweite Zeile fast leer
// und die erste bis an den Rand gefuellt.
fn tab_split(i: u64) -> u64 {
    let n: u64 = tab_n(i)
    if n < 2 {
        return n
    }
    let ges: u64 = tab_sum(i)
    var acc: u64 = 0
    var k: u64 = 0
    while k < n {
        acc = acc + tab_natur(i, k)
        if acc * 2 >= ges {
            // Die zweite Zeile bekommt mindestens einen Reiter, sonst
            // waere es wieder eine Zeile -- nur mit doppelter Hoehe.
            if k + 1 >= n {
                return n - 1
            }
            return k + 1
        }
        k = k + 1
    }
    return n - 1
}

fn tab_row(i: u64, k: u64) -> u64 {
    if tab_rows(i) < 2 || k < tab_split(i) {
        return 0
    }
    return 1
}

fn tab_row_first(i: u64, r: u64) -> u64 {
    if r == 0 {
        return 0
    }
    return tab_split(i)
}

fn tab_row_sum(i: u64, r: u64) -> u64 {
    let n: u64 = tab_n(i)
    var k: u64 = tab_row_first(i, r)
    var t: u64 = 0
    while k < n && tab_row(i, k) == r {
        t = t + tab_natur(i, k)
        k = k + 1
    }
    return t
}

fn tab_width(i: u64, k: u64) -> u64 {
    let b: u64 = tab_natur(i, k)
    if b == 0 {
        return 0
    }
    // DIE SUMME DER EIGENEN ZEILE und nicht die aller Reiter: auf zwei
    // Zeilen verteilt passt jede fuer sich, und dann wird nichts
    // skaliert und nichts gekuerzt.
    let int: u64 = tab_row_sum(i, tab_row(i, k))
    let platz: u64 = g(i, D_W)
    if int <= platz || int == 0 {
        return b
    }
    // integer scaling, and never below the room a couple of letters
    // need -- a two-pixel tab is not a tab.
    var sk: u64 = b * platz / int
    if sk < 24 {
        sk = 24
    }
    return sk
}

// DIE HOEHE EINER ZEILE. Eine einzelne Zeile ist so hoch wie jedes
// andere Bedienelement (`M_CTRL_H`); zwei Zeilen duerfen die Seite
// nicht um eine ganze Bedienhoehe nach unten schieben, also sind sie
// je so hoch, wie die Schrift samt Luft braucht. Gemessen: 24 statt
// 32 auf `modern`, zwei Zeilen kosten damit 16 Bildpunkte und nicht 32.
fn tab_rowh_at(i: u64, platz: u64) -> u64 {
    if tab_rows_at(i, platz) < 2 {
        return wlibc.metric(wlibc.M_CTRL_H)
    }
    // VIER BILDPUNKTE LUFT UM DIE SCHRIFT, nicht acht: zwei Zeilen von
    // 24 kosten die Seite 16 Bildpunkte gegenueber einer von 32, und
    // genau diese 16 holt die Einstellungsseite an ihren zwei Raendern
    // wieder herein (kernel/user/settings.fi, `ctop` und `ty`). Mit
    // acht waeren es 24 gewesen, und dann haette eine Zeile der
    // linken Spalte weichen muessen.
    return r4auf(wlibc.text_h(wlibc.px_ui()) + 4)
}

fn tab_rowh(i: u64) -> u64 {
    return tab_rowh_at(i, g(i, D_W))
}

// DIE HOEHE DER GANZEN LEISTE, fuer eine Breite gefragt. `place`
// benutzt genau diese Zahl; damit ist die Hoehe des Bedienelements
// immer ein ganzes Vielfaches der Zeilenhoehe.
fn tab_h_at(i: u64, platz: u64) -> u64 {
    return tab_rowh_at(i, platz) * tab_rows_at(i, platz)
}

fn tab_y(i: u64, k: u64) -> u64 {
    return g(i, D_Y) + tab_row(i, k) * tab_rowh(i)
}

// RUNDE I18N: WO EIN REITER LIEGT.
//
// Aus demselben Grund, aus dem es seit Runde K15 `text_x` und
// `text_base` gibt: ohne diese beiden Zahlen muesste ein Testlaeufer
// die Breite eines Reiters aus der Schrift NACHRECHNEN, um ihn
// anklicken zu koennen -- und rechnete dann eine zweite Fassung von
// `tab_breite` nach, die auseinanderlaufen kann. Die Breite haengt am
// Text, der Text haengt an der Sprache, und die Sprache ist genau das,
// was diese Runde umstellt: auf Englisch ist "Language" schmaler als
// "Sprache" breit ist. Wer hier raet, klickt in einer der beiden
// Sprachen daneben.
// WO DER EINTRAG k EINER MENUELEISTE ANFAENGT (im Fenster gemessen).
// Dieselbe Rechnung, die `on_down` fuer den Klick macht -- und deshalb
// steht sie hier einmal statt zweimal: ein Menue, das der Klick bei
// 120 trifft und das Programm bei 70 aufklappt, steht daneben.
fn menubar_x(i: u64, k: u64) -> u64 {
    if i >= MAXWD || g(i, D_KIND) != K_MENUBAR {
        return 0
    }
    var tx: u64 = g(i, D_X) + 4
    var t: u64 = 0
    while t < k && t < 8 {
        let q: u64 = row_at(g(i, D_TEXT), t)
        if q == 0 {
            return tx
        }
        tx = tx + wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
            row_len(q)) + 16
        t = t + 1
    }
    return tx
}

fn tab_x(i: u64, k: u64) -> u64 {
    var x: u64 = g(i, D_X)
    // RUNDE GLAS (nachtrag): GEZAEHLT WIRD IN DER EIGENEN ZEILE. Der
    // erste Reiter der zweiten Zeile faengt wieder am linken Rand an;
    // saehe der Treffer die Summe aller Vorgaenger, laege jeder Reiter
    // der zweiten Zeile weit rechts ausserhalb der Leiste.
    var t: u64 = tab_row_first(i, tab_row(i, k))
    // 12 UND NICHT 8. Jede andere Stelle dieser Datei, die Reiter
    // zaehlt (`tab_summe`, der Mausklick, die Pfeiltasten), geht bis 12;
    // nur hier stand 8. Solange es acht Reiter gab, fiel das nicht auf.
    // Runde SYNC bringt den neunten, und der neunte war noch der letzte
    // Fall, der zufaellig richtig herauskam -- der zehnte haette seine
    // Lage falsch gemeldet, und ein Testlaeufer haette danebengeklickt,
    // ohne dass irgendetwas rot geworden waere.
    while t < k && t < 12 {
        x = x + tab_width(i, t)
        t = t + 1
    }
    return x
}

fn tab_w(i: u64, k: u64) -> u64 {
    return tab_width(i, k)
}

// RUNDE GLAS (fix-r3-2): WO EIN KNOPF STEHT UND WIE RUND ER IST.
//
// `tools/themestore/shotcheck.py` weist ab jetzt fuer JEDES gemeldete
// Bedienelement vom Typ `button` mindestens eine Umrisskante im Bild
// nach. Der Grund steht in der Aufnahme 08 der Runde: eine Flaeche in
// Weiss auf einer Karte in fast Weiss und ohne Rand ist von einer
// Beschriftung nicht zu unterscheiden, und genau so sah der Knopf
// "Uebernehmen" aus. Die Textzeile (`wlib: text kind=2`) sagt nur, wo
// die SCHRIFT sitzt -- fuer eine Kante braucht der Pruefer das
// Rechteck des Knopfes, und den Radius dazu, sonst sucht er die Kante
// in einer abgerundeten Ecke.
//
// `ax`/`ay` ist die linke obere Ecke auf dem SCHIRM (Ursprung der
// Malflaeche plus die Ecke im Fenster), damit der Pruefer nicht
// nachrechnen muss. Eine Zeile, ein Schreibvorgang -- dieselbe
// Begruendung wie bei `say_painted`.
fn say_knopf(w: u64, x: u64, y: u64, bw: u64, bh: u64, r: u64) {
    var a: [u8; 15] = "wlib: knopf x=\0"
    var by: [u8; 4] = " y=\0"
    var bw2: [u8; 4] = " w=\0"
    var bh2: [u8; 4] = " h=\0"
    var br: [u8; 4] = " r=\0"
    var bax: [u8; 5] = " ax=\0"
    var bay: [u8; 5] = " ay=\0"
    var nl2: [u8; 2] = "\n\0"
    if s_trace == 0 {
        return
    }
    let b: u64 = (&tr_buf[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&a[0 as usize]) as u64)
    at = tr_num(b, at, x)
    at = tr_put(b, at, (&by[0 as usize]) as u64)
    at = tr_num(b, at, y)
    at = tr_put(b, at, (&bw2[0 as usize]) as u64)
    at = tr_num(b, at, bw)
    at = tr_put(b, at, (&bh2[0 as usize]) as u64)
    at = tr_num(b, at, bh)
    at = tr_put(b, at, (&br[0 as usize]) as u64)
    at = tr_num(b, at, r)
    at = tr_put(b, at, (&bax[0 as usize]) as u64)
    at = tr_num(b, at, ng(w, N_X) + 2 + x)
    at = tr_put(b, at, (&bay[0 as usize]) as u64)
    at = tr_num(b, at, ng(w, N_Y) + 22 + y)
    at = tr_put(b, at, (&nl2[0 as usize]) as u64)
    let _p: u64 = ulib.put(b, at)
}

fn say_tab(w: u64, k: u64, x: u64, y: u64, tw: u64, th: u64, q: u64,
    nq: u64, nv: u64) {
    var a: [u8; 13] = "wlib: tab i=\0"
    var bx: [u8; 4] = " x=\0"
    var by: [u8; 4] = " y=\0"
    var bw2: [u8; 4] = " w=\0"
    var bh2: [u8; 4] = " h=\0"
    var bax: [u8; 5] = " ax=\0"
    var bay: [u8; 5] = " ay=\0"
    if s_trace == 0 {
        return
    }
    ulib.say((&a[0 as usize]) as u64)
    ulib.sayn(k)
    ulib.say((&bx[0 as usize]) as u64)
    ulib.sayn(x)
    ulib.say((&by[0 as usize]) as u64)
    ulib.sayn(y)
    ulib.say((&bw2[0 as usize]) as u64)
    ulib.sayn(tw)
    ulib.say((&bh2[0 as usize]) as u64)
    ulib.sayn(th)
    // AND THE PLACE ON THE SCREEN, in the same line. Round LOOK paid
    // for splitting that across two lines on a shared serial port.
    ulib.say((&bax[0 as usize]) as u64)
    ulib.sayn(ng(w, N_X) + 2 + x)
    ulib.say((&bay[0 as usize]) as u64)
    ulib.sayn(ng(w, N_Y) + 22 + y)
    // UND WIE DER REITER HEISST -- UNGEKUERZT.
    //
    // `nq` ist, was gemalt wurde, `nv`, was dastehen sollte, und `t=`
    // traegt den GANZEN Namen. Ohne den ganzen Namen kann ein
    // Abnahmelauf die Beschriftung nicht gegen die Sprachdatei halten:
    // er saehe "Netzzugrif" und haette keine Zeile, an der er merkt,
    // dass dem Reiter ein Buchstabe fehlt. Der Text wird oktettweise
    // und mit EINEM Schreibvorgang ausgegeben -- `ulib.say` liefe bis
    // zur naechsten Null und schriebe damit die ganze Reiterliste.
    ulib.say((&tr_q[0 as usize]) as u64)
    ulib.sayn(nq)
    ulib.say((&tr_v[0 as usize]) as u64)
    ulib.sayn(nv)
    ulib.say((&tr_t[0 as usize]) as u64)
    let b: u64 = (&tr_buf[0 as usize]) as u64
    var c: u64 = 0
    while c < nv && c + 2 < 320 {
        __mmio_write8((b + c) as *mut u8, __mmio_read8((q + c) as *mut u8))
        c = c + 1
    }
    __mmio_write8((b + c) as *mut u8, 10 as u8)
    let _wt: u64 = ulib.put(b, c + 1)
}

fn paint_tabs(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bh: u64 = g(i, D_H)
    // RUNDE 32: fUi malt; der aktive Reiter (D_VAL) und tab_x/tab_w
    // rechnen unveraendert weiter.
    let _fb14: bool = fuib.area(x, y, g(i, D_W), bh, wlibc.theme(wlibc.T_PANEL))
    // ROUND THEMESTORE: TWELVE AND NOT EIGHT. The settings program has
    // eight tabs since this round, and eight was the exact limit -- the
    // next tab anybody adds would have been drawn nowhere and would
    // have swallowed its clicks, with no message of any kind. The hit
    // test below counts to the same number, and it has to: a tab that
    // is drawn and not clickable is worse than one that is neither.
    // RUNDE GLAS (nachtrag): STELLE UND ZEILE KOMMEN AUS `tab_x` und
    // `tab_y` und werden hier nicht mitgezaehlt. Eine zweite Zaehlung
    // waere genau der Fehler, den diese Datei bei den Menueleisten
    // schon einmal hatte: gemalt bei 120, getroffen bei 70.
    let zh: u64 = tab_rowh(i)
    var k: u64 = 0
    while k < 12 {
        let q: u64 = row_at(g(i, D_TEXT), k)
        if q == 0 {
            k = 12
        } else {
            let tw: u64 = tab_width(i, k)
            let tx: u64 = tab_x(i, k)
            let ty: u64 = tab_y(i, k)
            var area: u64 = wlibc.theme(wlibc.T_PANEL)
            var farbe: u64 = wlibc.theme(wlibc.T_DIM)
            if k == g(i, D_VAL) {
                area = wlibc.theme(wlibc.T_BG)
                farbe = wlibc.theme(wlibc.T_FG)
            }
            // RUNDE GLAS: der einzelne Reiter ist eine anfassbare
            // Flaeche und bekommt den Radius eines Knopfes. Der
            // Streifen dahinter (`_fb14`) bleibt eckig: er laeuft ueber
            // die ganze Breite des Fensters und hat dort keine Ecke,
            // die man runden koennte.
            let _fb15: bool = fuib.tafel(tx, ty, tw, zh,
                typ_radius(RT_REITER, MR_BUTTON, tw, zh), area, 0, 0)
            wlibc.vline(tx, ty, zh, wlibc.theme(wlibc.T_LINE))
            if k == g(i, D_VAL) {
                wlibc.hline(tx, ty, tw, wlibc.theme(wlibc.T_ACCENT))
                wlibc.hline(tx, ty + 1, tw, wlibc.theme(wlibc.T_ACCENT))
            } else {
                wlibc.hline(tx, ty + zh - 1, tw, wlibc.theme(wlibc.T_LINE))
            }
            // AND THE LABEL IS CLIPPED TO THE TAB -- BUT VISIBLY.
            //
            // `fit` answers how many characters go into a width, and
            // it answers it SILENTLY: eleven German tabs need 861
            // pixels in a bar 728 wide, so every label lost about a
            // seventh of itself and "Netzzugriff" was painted
            // "Netzzugrif". Nobody could see that this was a cut and
            // not the name -- a missing last letter looks like a
            // word. `elide` puts three dots where it cut, which is the
            // one mark a reader recognises without knowing the name,
            // and both lengths go into the trace so that
            // tools/themestore/shotcheck.py can COUNT the cuts instead
            // of leaving them to the eye.
            let voll: u64 = row_len(q)
            let el: u64 = elide(wlibc.F_UI, wlibc.px_ui(), q, voll,
                sub(tw, 8))
            var qp: u64 = q
            var nmal: u64 = voll
            var nq: u64 = voll
            if el != 0 {
                qp = (&el_buf[0 as usize]) as u64
                // `el` ist die Laenge MIT den drei Punkten; vom Namen
                // selbst stehen also drei Oktette weniger da. Diese
                // Zahl und nicht `el` gehoert in `nq=`: gemeldet wird,
                // wie viel vom NAMEN uebrig ist, sonst meldete eine
                // Kuerzung von acht auf sechs Buchstaben neun.
                nmal = el
                nq = sub(el, 3)
            }
            // DIE SCHRIFT WIRD MIT IHREM GANZEN KASTEN MITTIG
            // GESETZT und nicht mit ihrer Oberlaenge. In einer Zeile
            // von 24 Bildpunkten sass die Grundlinie sonst so tief,
            // dass die Unterlaengen von "Abgleich" und "Vorlagen"
            // genau auf der unteren Kante des Reiters standen -- die
            // Bildpunktprobe in tools/themestore/shotcheck.py nennt
            // das `LINIE`, und sie hat recht: Schrift auf einer Linie
            // liest sich schlecht. `text_h` ist Ober- plus
            // Unterlaenge, also ist `(zh - text_h) / 2` die Luft, die
            // oben und unten gleich bleibt.
            let base: u64 = ty
                + sub(zh, wlibc.text_h(wlibc.px_ui())) / 2
                + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
            put_text(wlibc.F_UI, wlibc.px_ui(), tx, base, tw, qp, nmal,
                farbe, 1)
            // UND DIE BESCHRIFTUNG MELDET SICH WIE JEDE ANDERE.
            // Bis hierher war die Reiterleiste die einzige Flaeche mit
            // Text, die keine `wlib: text`-Zeile schrieb -- also die
            // einzige, ueber die shotcheck.py nichts wusste. Genau
            // dort sassen die geklemmten Namen.
            say_painted_n(g(i, D_WIN), K_TABS, base, farbe, area, qp,
                nmal, nq, voll)
            // WHERE THE TAB IS, REPORTED BY THE THING THAT DRAWS IT.
            // Round LOOK made list rows and table headers say where
            // they painted, for the reason a runner that computes a tab
            // boundary is a runner that checks its own arithmetic. Same
            // rule, one widget further along.
            say_tab(g(i, D_WIN), k, tx, ty, tw, zh, q, nq, voll)
            k = k + 1
        }
    }
    // DER REST JEDER ZEILE bekommt denselben Strich wie ein nicht
    // gewaehlter Reiter -- je Zeile einen, sonst endete die untere
    // Kante der ersten Zeile im Nichts.
    var r: u64 = 0
    let zeilen: u64 = tab_rows(i)
    while r < zeilen {
        let letzt: u64 = tab_row_first(i, r + 1)
        var ex: u64 = x
        if r + 1 < zeilen {
            ex = tab_x(i, letzt - 1) + tab_width(i, letzt - 1)
        } else if tab_n(i) > 0 {
            ex = tab_x(i, tab_n(i) - 1) + tab_width(i, tab_n(i) - 1)
        }
        wlibc.hline(ex, y + (r + 1) * zh - 1, sub(x + g(i, D_W), ex),
            wlibc.theme(wlibc.T_LINE))
        r = r + 1
    }
    // DER FOKUSRING LIEGT AUF DEM REITER UND NICHT UM DIE LEISTE.
    //
    // Er lag um die ganze Leiste, und die Leiste ist 728 Bildpunkte
    // breit: ihre untere Kante lief unter den beiden Karten der Seite
    // hindurch, die vier Bildpunkte in sie hineinragen. Die Karten
    // malten sie streckenweise zu, uebrig blieben zwei blaue
    // Strichreste bei x=313..330 und x=713..759 -- in 02, 03, 08, 10,
    // 13 und 14 zu sehen und in keiner Zusage. Ein Ring um den
    // AKTIVEN REITER sagt ausserdem das Richtige: die Tastatur
    // wechselt den Reiter, nicht die Leiste. Er liegt vollstaendig
    // innerhalb des Rechtecks, das `say_tab` fuer diesen Reiter
    // meldet, und genau daran misst es der Abnahmelauf.
    let sel: u64 = g(i, D_VAL)
    focus_ring_at(i, tab_x(i, sel), tab_y(i, sel), tab_width(i, sel), zh)
}

fn paint_menubar(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    // RUNDE 32: fUi malt die Flaechen; die Auswahl (D_VAL) und die
    // Spaltenrechnung bleiben unveraendert.
    let _fb16: bool = fuib.area(x, y, g(i, D_W), g(i, D_H),
        wlibc.theme(wlibc.T_PANEL))
    var tx: u64 = x + 4
    var k: u64 = 0
    while k < 8 {
        let q: u64 = row_at(g(i, D_TEXT), k)
        if q == 0 {
            k = 8
        } else {
            let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                row_len(q)) + 16
            if k + 1 == g(i, D_VAL) {
                // RUNDE GLAS: der Balken unter dem offenen Menuetitel
                // ist das einzige Stueck dieser Leiste mit eigenen
                // Ecken -- also bekommt er den Radius eines Knopfes.
                let _fb17: bool = fuib.tafel(tx, y, tw, g(i, D_H),
                    typ_radius(RT_LEISTE, MR_BUTTON, tw, g(i, D_H)),
                    wlibc.theme(wlibc.T_SEL), 0, 0)
            }
            put_text(wlibc.F_UI, wlibc.px_ui(), tx,
                y + (g(i, D_H) + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()))
                / 2, tw, q, row_len(q), wlibc.theme(wlibc.T_FG), 1)
            tx = tx + tw
            k = k + 1
        }
    }
}

fn paint_choice(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    let rc: u64 = typ_radius(RT_AUSWAHL, MR_BUTTON, bw, bh)
    // RUNDE 32: fUi malt die Flaeche. DER GEWAEHLTE EINTRAG (D_VAL) und
    // `row_at` bleiben unveraendert -- umgestellt ist nur das Malen.
    let _fbc: bool = fuib.tafel(x, y, bw, bh, rc,
        wlibc.theme(wlibc.T_BTN), wlibc.theme(wlibc.T_LINE),
        wlibc.metric(wlibc.M_BORDER))
    let q: u64 = row_at(g(i, D_TEXT), g(i, D_VAL))
    if q != 0 {
        let cgr: u64 = y + (bh
            + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())) / 2
        put_text(wlibc.F_UI, wlibc.px_ui(), x + inset(), cgr, bw, q,
            row_len(q), wlibc.theme(wlibc.T_FG), 0)
        say_painted(g(i, D_WIN), K_CHOICE, cgr, wlibc.theme(wlibc.T_FG),
            wlibc.theme(wlibc.T_BTN), q, row_len(q))
    }
    // Das Dreieck rechts -- sechs Zeilen, von aussen nach innen.
    var n: u64 = 0
    while n < 5 {
        wlibc.hline(x + bw - 16 + n, y + bh / 2 - 2 + n, 10 - 2 * n,
            wlibc.theme(wlibc.T_FG))
        n = n + 1
    }
    focus_ring(i)
}

// ROUND LOOK: a separating line at the opacity the shape asks for.
// `classic` says 100 and gets the same hard line it always got.
fn paint_sep(i: u64) {
    wlibc.divider(g(i, D_X), g(i, D_Y) + g(i, D_H) / 2, g(i, D_W),
        wlibc.theme(wlibc.T_LINE))
}

// ROUND SOFTUI: THE CARD.
//
// A rounded panel, a soft shadow under it, and NO line around it.  The
// shadow is `wlibc.drop_shadow`, which round LOOK built and round PAINT
// measured; it reads what is under the panel out of THIS window's own
// buffer, which is legal -- the widget library owns every pixel of it.
// That is the difference from the window shadow in the compositor and
// it is why the compositor needed a mask and this does not: a card is
// painted once per repaint of a page, a window shadow once per frame.
fn paint_card(i: u64) {
    let r: u64 = draw_radius(MR_TAFEL)
    if r == 0 && wlibc.metric(wlibc.M_DIVIDER) >= 50 {
        return
    }
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let w: u64 = g(i, D_W)
    let h: u64 = g(i, D_H)
    if w < 8 || h < 8 {
        return
    }
    // RUNDE GLAS: gemeldet wird erst hier, wenn wirklich gemalt wird --
    // die zwei Ausstiege darueber malen nichts, und eine Meldung ueber
    // eine Karte, die es nicht gibt, waere eine Zeile ohne Bild.
    say_radius(RT_KARTE, MR_TAFEL, r, w, h)
    wlibc.drop_shadow(x, y, w, h, r, wlibc.metric(wlibc.M_SHADOW2),
        wlibc.metric(wlibc.M_SHADOW_R2), wlibc.theme(wlibc.C_SHADOW))
    // RUNDE 31: die Karte aus fUi.
    let _fb18: bool = fuib.tafel(x, y, w, h, r, wlibc.theme(wlibc.C_PANEL_BG), 0, 0)
}

// Die Bildflaeche. Erst der Grund (ein Bild mit Deckung unter eins
// braucht einen), dann das Bild, dann der Rahmen. Beschnitten wird auf
// das Widget: `wlibc.clip_set` -- ohne das malte ein vergroessertes
// Bild ueber die halbe Fensterbreite.
fn paint_image(i: u64) {
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let w: u64 = g(i, D_W)
    let h: u64 = g(i, D_H)
    wlibc.rect(x, y, w, h, wlibc.theme(wlibc.T_ENTRY))
    let p: u64 = g(i, D_E)
    let iw: u64 = g(i, D_F)
    let ih: u64 = g(i, D_G)
    if p == 0 || iw == 0 || ih == 0 || w < 4 || h < 4 {
        wlibc.frame(x, y, w, h, wlibc.theme(wlibc.T_LINE))
        return
    }
    let z: u64 = g(i, D_ZOOM)
    let dreh: u64 = g(i, D_DREH)
    let bw: u64 = image_bw(i)
    let bh: u64 = image_bh(i)
    let zw: u64 = bw * z / 100
    let zh: u64 = bh * z / 100
    // Die linke obere Ecke: mittig, plus die Verschiebung.
    var ox: u64 = x
    if zw < w {
        ox = x + (w - zw) / 2
    }
    var oy: u64 = y
    if zh < h {
        oy = y + (h - zh) / 2
    }
    ox = ox +% g(i, D_PX)
    oy = oy +% g(i, D_PY)
    let a_x0: u64 = wlibc.clip_x0()
    let a_y0: u64 = wlibc.clip_y0()
    let a_x1: u64 = wlibc.clip_x1()
    let a_y1: u64 = wlibc.clip_y1()
    wlibc.clip_set(x, y, x + w, y + h)
    var sy: u64 = 0
    while sy < h {
        let py: u64 = y + sy
        // Welcher Bildpunkt liegt hier? Rueckwaerts gerechnet, damit
        // jeder Bildschirmpunkt genau einmal gesetzt wird.
        let dy: u64 = py -% oy
        if dy < zh {
            let qy: u64 = dy * 100 / z
            var sx: u64 = 0
            while sx < w {
                let px: u64 = x + sx
                let dx: u64 = px -% ox
                if dx < zw {
                    let qx: u64 = dx * 100 / z
                    var bx: u64 = qx
                    var by: u64 = qy
                    if dreh == 1 {
                        bx = qy
                        by = ih - 1 - qx
                    } else if dreh == 2 {
                        bx = iw - 1 - qx
                        by = ih - 1 - qy
                    } else if dreh == 3 {
                        bx = iw - 1 - qy
                        by = qx
                    }
                    if bx < iw && by < ih {
                        let f: u64 = (__mmio_read32((p + (by * iw + bx) * 4)
                            as *mut u32)) as u64
                        let a: u64 = f >> 24
                        if a == 255 {
                            wlibc.px(px, py, f & wlibc.RGB24)
                        } else if a > 0 {
                            wlibc.px(px, py, wlibc.blend(wlibc.get(px, py),
                                f & wlibc.RGB24, a))
                        }
                    }
                }
                sx = sx + 1
            }
        }
        sy = sy + 1
    }
    // Der gezogene Ausschnitt: ein Rahmen in der Akzentfarbe, INNEN
    // beschnitten wie das Bild selbst.
    if g(i, D_WZ) == 1 && s_aus_da != 0 {
        let ox2: u64 = image_ox(i)
        let oy2: u64 = image_oy(i)
        let ax: u64 = ox2 + img_out_x0() * z / 100
        let ay: u64 = oy2 + img_out_y0() * z / 100
        let aw: u64 = (img_out_x1() - img_out_x0() + 1) * z / 100
        let ah: u64 = (img_out_y1() - img_out_y0() + 1) * z / 100
        wlibc.frame(ax, ay, aw, ah, wlibc.theme(wlibc.T_ACCENT))
        if aw > 2 && ah > 2 {
            wlibc.frame(ax + 1, ay + 1, aw - 2, ah - 2,
                wlibc.theme(wlibc.T_ACCENT))
        }
    }
    wlibc.clip_set(a_x0, a_y0, a_x1, a_y1)
    wlibc.frame(x, y, w, h, wlibc.theme(wlibc.T_LINE))
    focus_ring(i)
}

// Der Schieberegler: eine Rinne, ein gefuellter Teil bis zum Griff, der
// Griff. Die Farben sind die des Farbschemas, die Hoehen die der
// Vorlage -- keine Zahl davon steht hier.

fn paint_one(i: u64) {
    let k: u64 = g(i, D_KIND)
    if (g(i, D_FLAGS) & F_HIDE) != 0 {
        return
    }
    if k == K_IMAGE {
        paint_image(i)
    } else if k == K_SLIDER {
        paint_slider(i)
    } else if k == K_LABEL {
        paint_label(i)
    } else if k == K_BUTTON {
        paint_button(i)
    } else if k == K_CHECK {
        paint_check(i)
    } else if k == K_ENTRY {
        paint_entry(i)
    } else if k == K_LIST {
        paint_list(i)
    } else if k == K_TABLE {
        paint_table(i)
    } else if k == K_TABS {
        paint_tabs(i)
    } else if k == K_MENUBAR {
        paint_menubar(i)
    } else if k == K_CHOICE {
        paint_choice(i)
    } else if k == K_SEP {
        paint_sep(i)
    } else if k == K_CARD {
        paint_card(i)
    } else if k == K_SCROLL {
        paint_scroll(g(i, D_X), g(i, D_Y), g(i, D_H), g(i, D_VAL),
            g(i, D_B), g(i, D_A))
    } else if k == K_TILE {
        paint_tile(i)
    } else if k == K_GRAPH {
        paint_graph(i)
    } else if k == K_CANVAS {
        paint_canvas(i)
    } else if k == K_TEXTAREA {
        paint_ta(i)
    }
}

// EIN MENUEFENSTER. Es hat keine Widgets -- es ist eine Liste von
// Zeilen und ein Rahmen. Der Grund: ein Menue ist der einzige Fall, in
// dem ein FENSTER genau ein Widget ist, und eine Widgetliste dafuer
// waere eine Verwaltung ohne Nutzen.
// ==================================================== RUNDE ECHTHARDWARE-2
//
// EIN FENSTER FUER EINE INFOBLASE -- ANGELEGT UND WIEDER WEGGERAEUMT.
//
// Das ist ALLES, was die Bibliothek zur Blase beitraegt: das Fenster.
// Gezeichnet wird sie vom Programm, dem sie gehoert (die Taskleiste),
// und zwar mit denselben `mal_*`-Aufrufen wie jede andere Flaeche.
//
// WARUM DIE TEILUNG. Der erste Entwurf hatte die ganze Blase hier --
// Aufmachen, Zumachen, Verweilzeit, Zeichnen. Danach brach `firnc1` an
// drei Programmen ab (siehe die Begruendung bei NK_TIP). wlib steckt in
// dreizehn Programmen; die Blase braucht eines. Also bleibt hier der
// Teil, der ohne die Fenstertafel dieser Datei nicht ginge, und der
// Rest zieht dorthin, wo er gebraucht wird.
fn tip_win_open(x: u64, y: u64, w: u64, h: u64, titel: u64) -> u64 {
    let i: u64 = new_win(x, y, w, h, titel, NK_TIP)
    if i >= MAXWN {
        return MAXWN
    }
    // Ohne das kommt die Blase mit Titelleiste -- gemessen: tp=30,
    // dreissig Bildpunkte Schmuck ueber einer Zeile Text.
    let _d: u64 = wlibc.win_state(ng(i, N_H), wlibc.WS_DECO, 0)
    // =================================== RUNDE ECHTHARDWARE-3
    // DIE BLASE GEHOERT UEBER ALLES, AUCH UEBER DIE TASKLEISTE.
    //
    // Justins Foto: der Tooltip "169.254.10.1" verschwindet HINTER
    // der Leiste. Die Blase lag auf der normalen Ebene, die Leiste
    // auf L_TOP -- also lag die Leiste darueber, und zwar zu Recht.
    // Eine Blase hat jetzt ihre EIGENE Ebene ganz oben, und der
    // Fensterserver gibt ihr keinen Klick (siehe `wm.hit`).
    let _l: u64 = wlibc.win_state(ng(i, N_H), wlibc.WS_LAYER,
        wlibc.L_TIP)
    dirty_all(i)
    return i
}

fn tip_win_close(i: u64) {
    if i >= MAXWN {
        return
    }
    close(i)
    // Der Platz wird wieder frei -- wie bei `menu_close`. Eine Leiste,
    // die tausendmal am Tag eine Blase zeigt, darf die Fenstertafel
    // nicht vollaufen lassen.
    if i + 1 == nwn {
        nwn = nwn - 1
    }
}

// Die Kennung beim Fensterserver -- die braucht der Eigentuemer, um
// seine Blase zu bemalen und auf den Schirm zu schieben.
fn tip_win_id(i: u64) -> u64 {
    return ng(i, N_H)
}

fn paint_menu(w: u64) {
    let zh: u64 = lines_height() + 2
    // RUNDE 32: fUi malt; welche Zeile hervorgehoben ist, rechnet
    // weiter das Menue selbst.
    let _fb19: bool = fuib.area(0, 0, ng(w, N_W), ng(w, N_HH),
        wlibc.theme(wlibc.T_MENU))
    var k: u64 = 0
    while k < ng(w, N_CNT) {
        let q: u64 = row_at(ng(w, N_DATA), k)
        if q != 0 {
            let ry: u64 = 2 + k * zh
            var farbe: u64 = wlibc.theme(wlibc.T_FG)
            if k + 1 == ng(w, N_VAL) {
                // RUNDE GLAS: der hervorgehobene Eintrag bekommt den
                // Radius eines Feldes. Der GRUND des Menuefensters
                // (`_fb19`) bleibt eckig -- die Rundung eines Fensters
                // malt der Fensterserver, und eine zweite hier darin
                // ergaebe einen doppelten Rand.
                let _fb20: bool = fuib.tafel(1, ry, sub(ng(w, N_W), 2), zh,
                    typ_radius(RT_MENUE, MR_FIELD, sub(ng(w, N_W), 2), zh),
                    wlibc.theme(wlibc.T_SEL), 0, 0)
                farbe = wlibc.theme_selfg()
            }
            wlibc.text_at(wlibc.F_UI, wlibc.px_ui(), 8,
                base_in_row(ry, zh), q, row_len(q), farbe)
        }
        k = k + 1
    }
    wlibc.frame(0, 0, ng(w, N_W), ng(w, N_HH), wlibc.theme(wlibc.T_ACCENT))
}

// DAS NEUZEICHNEN -- STREIFEN FUER STREIFEN.
//
// Der schmutzige Bereich wird in so viele Streifen zerlegt, wie die
// Flaeche hoch ist. Je Streifen: Hintergrund, alle Widgets, die ihn
// beruehren, und EIN Aufruf hinueber. Ein Widget, das drei Streifen
// beruehrt, wird dreimal gezeichnet -- was es kostet, ist der Anteil,
// der ohnehin gezeichnet wird, und was es spart, ist der ganze Puffer.
fn flush_win(w: u64) -> u64 {
    if w >= MAXWN || ng(w, N_H) == 0 {
        return 0
    }
    // ============================================ RUNDE GLAS (NACHTRAG)
    // WER GEZOGEN WURDE, STEHT WOANDERS -- UND MUSS ES SAGEN.
    //
    // `win_ort_holen` fragt den Server nach der wahren Stelle und
    // meldet eine Aenderung weiter; aufgerufen wurde es aber nur aus
    // `win_x`/`win_y`, und die ruft im Anstrich niemand. Zieht eine
    // Hand das Fenster unter die Taskleiste, malt der Server es dort
    // richtig, das Programm meldet seine Beschriftungen aber weiter zu
    // dem Ursprung, an dem es ANGELEGT wurde. GEMESSEN an Bild 15
    // dieser Runde: nach einem Zug von 400,10 nach 400,600 meldete
    // `tools/themestore/shotcheck.py` acht leere Beschriftungen -- an
    // den alten Stellen war wirklich nichts, und an den neuen hat
    // niemand nachgesehen.
    //
    // Hier ist die Stelle, durch die JEDER Anstrich geht, und sie
    // kostet zwei Systemaufrufe je Anstrich (nicht je Bildpunkt und
    // nicht je Bedienelement).
    win_ort_holen(w)
    let n: u64 = ng(w, N_NDIRT)
    ns(w, N_NDIRT, 0)
    var gemalt: u64 = 0
    var k: u64 = 0
    while k < n {
        gemalt = gemalt + flush_rect(w, dg(w, k, 0), dg(w, k, 1),
            dg(w, k, 2), dg(w, k, 3))
        k = k + 1
    }
    return gemalt
}

fn flush_rect(w: u64, x0: u64, y0: u64, x1: u64, y1: u64) -> u64 {
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    var gemalt: u64 = 0
    var yb: u64 = y0
    while yb < y1 {
        var ye: u64 = yb + wlibc.surf_rows()
        if ye > y1 {
            ye = y1
        }
        wlibc.set_band(yb)
        wlibc.clip_set(x0, yb, x1, ye)
        paint_bg(w, x0, yb, x1 - x0, ye - yb)
        if ng(w, N_KIND) == NK_MENU {
            paint_menu(w)
        } else {
            var i: u64 = 0
            while i < nwd {
                if g(i, D_WIN) == w {
                    if g(i, D_Y) < ye && g(i, D_Y) + g(i, D_H) > yb {
                        paint_one(i)
                    }
                }
                i = i + 1
            }
        }
        wlibc.push(ng(w, N_H), x0, yb, x1 - x0, ye - yb)
        s_blits = s_blits + 1
        gemalt = gemalt + (x1 - x0) * (ye - yb)
        yb = ye
    }
    return gemalt
}

fn draw_all() {
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            dirty_all(w)
        }
        w = w + 1
    }
    let _g: u64 = paint_all()
}

// ==================================================================
// DIE EINGABE
//
// DIE TREFFERPRUEFUNG IST DIE STELLE, AN DER `nohit` ANSETZT. Ohne sie
// kommen dieselben Ereignisse an, dieselben Zaehler laufen hoch -- und
// kein Widget erfaehrt davon. Das ist die Gegenprobe zu jeder Zusage
// ueber einen Klick: sie MUSS damit einbrechen.
// RUNDE ECHTHARDWARE-4: WAS EINEN KLICK BEANTWORTET.
//
// Die Aufzaehlung steht hier EINMAL und nicht an jeder Stelle, die
// den Zeiger setzt. Ein abgeschalteter Knopf ist NICHT anklickbar --
// eine Hand ueber einem Feld, das nichts tut, ist eine Luege.
fn anklickbar(i: u64) -> bool {
    if i >= MAXWD {
        return false
    }
    if (g(i, D_FLAGS) & (F_OFF | F_HIDE)) != 0 {
        return false
    }
    let k: u64 = g(i, D_KIND)
    return k == K_BUTTON || k == K_CHECK
        || k == K_LIST || k == K_TABS || k == K_MENUBAR || k == K_CHOICE
        || k == K_SLIDER || k == K_TABLE || k == K_TILE
}

fn hit_at(w: u64, x: u64, y: u64) -> u64 {
    if s_nohit != 0 {
        return MAXWD
    }
    var i: u64 = 0
    while i < nwd {
        if g(i, D_WIN) == w && (g(i, D_FLAGS) & (F_HIDE | F_OFF)) == 0
            && !nur_schmuck(g(i, D_KIND)) {
            if x >= g(i, D_X) && x < g(i, D_X) + g(i, D_W) {
                if y >= g(i, D_Y) && y < g(i, D_Y) + g(i, D_H) {
                    return i
                }
            }
        }
        i = i + 1
    }
    return MAXWD
}

// RUNDE GLAS: EIN KASTEN IST KEIN BEDIENELEMENT.
//
// `hit_at` nimmt das ERSTE Widget der Reihe, dessen Rechteck den Punkt
// enthaelt -- und eine Karte (`wlib.card`) ist genau ein Rechteck, das
// eine ganze Spalte gross ist und zuerst angelegt wird, damit sie
// hinter allem liegt. Damit schluckte sie jeden Klick, der in ihre
// Flaeche fiel: auf der Seite Darstellung sind das alle
// Bedienelemente oberhalb von Zeile 436, und GEMESSEN heisst das, ein
// Klick auf den Regler der Eckenrundung kam nie an, waehrend der
// Regler der Taskleiste einen Bildpunkt unterhalb der Karte
// funktionierte.
//
// Schmuck faengt keine Klicks. Das ist keine Sonderregel fuer diese
// Runde: ein Trennstrich ist genauso wenig anzufassen wie eine Karte,
// und beide sollen den Bedienelementen, die auf ihnen liegen, nicht im
// Weg stehen.
fn nur_schmuck(k: u64) -> bool {
    return k == K_CARD || k == K_SEP
}

fn ticks() -> u64 {
    return ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
}

// ------------------------------------------------------ die Bewegung
//
// DIE KURVEN, IN GANZZAHLEN. Eingang und Ausgang sind Tausendstel.
// Es gibt hier keine Fliesskommazahl, und das ist keine Sparsamkeit:
// dieser Kernel rettet in `syscall` keine SSE-Register, also hat ein
// Ring-3-Programm, das in einer Ereignisschleife multipliziert, mit
// `f64` keine Zusage. Ganzzahlen haben eine.
//
// ease-out ist 1-(1-t)^2, ease-in-out ist die Zwei-Stueck-Parabel --
// beides die Formen aus states-and-variants.md, nur als Bruch.
fn ease(curve: u64, t: u64) -> u64 {
    var p: u64 = t
    if p > 1000 {
        p = 1000
    }
    if curve == EASE_OUT {
        let inv: u64 = 1000 - p
        return 1000 - inv * inv / 1000
    }
    if curve == EASE_IN_OUT {
        if p < 500 {
            return 2 * p * p / 1000
        }
        let inv2: u64 = 1000 - p
        return 1000 - 2 * inv2 * inv2 / 1000
    }
    return p
}

fn tg(i: u64, f: u64) -> u64 {
    return tw[(i * TW_FIELDS + f) as usize]
}

fn tset(i: u64, f: u64, v: u64) {
    tw[(i * TW_FIELDS + f) as usize] = v
}

// "Sind Bewegungen abgeschaltet?" -- EINE Stelle. `motion` gibt 0
// zurueck, wenn die Formentabelle motion=0 sagt, und das ist genau die
// Zusage "Animationen reduzieren": jede Bewegung ist dann sofort fertig
// statt uebersprungen. Der Unterschied ist wichtig -- der Endzustand
// wird in beiden Faellen erreicht, nur ohne Zwischenbilder.
fn motion_off() -> bool {
    return wlibc.motion(wlibc.MO_NORMAL) == 0
}

// Eine Bewegung anmelden. Gibt die Nummer zurueck, oder TW_MAX, wenn
// kein Platz ist -- und das ist kein Fehler: eine Oberflaeche, die
// mehr als sechzehn Dinge gleichzeitig bewegt, darf die siebzehnte
// weglassen. Sie ist dann sofort an ihrem Ziel.
fn anim_start(was: u64, w: u64, wd: u64, stufe: u64, curve: u64) -> u64 {
    // Laeuft fuer dasselbe Ding schon eine: sie wird ersetzt, nicht
    // gestapelt. Ein Knopf, ueber den die Maus dreimal wandert, hatte
    // sonst drei Bewegungen mit drei Startzeiten.
    var i: u64 = 0
    var free: u64 = TW_MAX
    while i < tw_n {
        if tg(i, TW_STATE) != TW_FREE && tg(i, TW_WHAT) == was
            && tg(i, TW_WIN) == w && tg(i, TW_WD) == wd {
            free = i
            i = tw_n
        } else {
            i = i + 1
        }
    }
    if free == TW_MAX {
        var k: u64 = 0
        while k < TW_MAX && tg(k, TW_STATE) != TW_FREE {
            k = k + 1
        }
        if k >= TW_MAX {
            return TW_MAX
        }
        free = k
        if free >= tw_n {
            tw_n = free + 1
        }
    }
    let ms: u64 = wlibc.motion(stufe)
    var d: u64 = ms / MS_PRO_TICK
    if d == 0 {
        d = 1
    }
    tset(free, TW_STATE, TW_LAEUFT)
    tset(free, TW_T0, ticks())
    tset(free, TW_DUR, d)
    tset(free, TW_CURVE, curve)
    tset(free, TW_WHAT, was)
    tset(free, TW_WIN, w)
    tset(free, TW_WD, wd)
    tset(free, TW_P, 0)
    tw_starts = tw_starts + 1
    // motion=0: sofort am Ziel, aber EINMAL gemalt.
    if ms == 0 {
        tset(free, TW_P, 1000)
        tset(free, TW_STATE, TW_FERTIG)
    }
    return free
}

// Der Fortschritt eines Dings, 0..1000. Laeuft keine Bewegung dafuer,
// ist die Antwort 1000 -- "steht an seinem Ziel". Das ist die Antwort,
// die ein Maler will: er fragt nicht, OB etwas animiert wird, er malt
// den Zustand, den er bekommt.
fn anim_at(was: u64, w: u64, wd: u64) -> u64 {
    var i: u64 = 0
    while i < tw_n {
        if tg(i, TW_STATE) != TW_FREE && tg(i, TW_WHAT) == was
            && tg(i, TW_WIN) == w && tg(i, TW_WD) == wd {
            return ease(tg(i, TW_CURVE), tg(i, TW_P))
        }
        i = i + 1
    }
    return 1000
}

fn anim_laeuft(was: u64, w: u64, wd: u64) -> bool {
    var i: u64 = 0
    while i < tw_n {
        if tg(i, TW_STATE) == TW_LAEUFT && tg(i, TW_WHAT) == was
            && tg(i, TW_WIN) == w && tg(i, TW_WD) == wd {
            return true
        }
        i = i + 1
    }
    return false
}

fn anim_stop(was: u64, w: u64, wd: u64) {
    var i: u64 = 0
    while i < tw_n {
        if tg(i, TW_STATE) != TW_FREE && tg(i, TW_WHAT) == was
            && tg(i, TW_WIN) == w && tg(i, TW_WD) == wd {
            tset(i, TW_STATE, TW_FREE)
        }
        i = i + 1
    }
}

// EIN Takt fuer alle Bewegungen, aufgerufen aus `step`. Gibt zurueck,
// wie viele noch laufen -- danach entscheidet `step`, ob es die CPU
// abgeben darf oder nicht. Das ist der ganze Unterschied zwischen einer
// Bewegung und einem Standbild: eine Schleife, die bei "nichts
// passiert" schlaeft, muss wissen, dass eine laufende Bewegung ETWAS
// ist.
// Ein Schritt einer Bewegung auf die serielle Leitung. Nur mit
// `/etc/uitrace`, wie jede andere Meldung dieser Bibliothek.
fn say_anim(was: u64, wd: u64, p: u64, dur: u64) {
    if s_trace == 0 {
        return
    }
    let b: u64 = (&tr_buf[0 as usize]) as u64
    var at: u64 = tr_put(b, 0, (&an_wort[0 as usize]) as u64)
    at = tr_put(b, at, (&an_was[0 as usize]) as u64)
    at = tr_num(b, at, was)
    at = tr_put(b, at, (&an_wd[0 as usize]) as u64)
    at = tr_num(b, at, wd)
    at = tr_put(b, at, (&an_p[0 as usize]) as u64)
    at = tr_num(b, at, p)
    at = tr_put(b, at, (&an_dur[0 as usize]) as u64)
    at = tr_num(b, at, dur)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = ulib.put(b, at)
}

fn anim_tick() -> u64 {
    if tw_n == 0 {
        return 0
    }
    let jetzt: u64 = ticks()
    var aktiv: u64 = 0
    var i: u64 = 0
    while i < tw_n {
        let st: u64 = tg(i, TW_STATE)
        if st == TW_LAEUFT {
            var p: u64 = 1000
            let d: u64 = tg(i, TW_DUR)
            let t0: u64 = tg(i, TW_T0)
            if jetzt > t0 {
                let v: u64 = jetzt - t0
                if v < d {
                    p = v * 1000 / d
                }
            } else {
                p = 0
            }
            if p != tg(i, TW_P) {
                tset(i, TW_P, p)
                let w: u64 = tg(i, TW_WIN)
                let wd: u64 = tg(i, TW_WD)
                if wd < MAXWD && wd < nwd {
                    dirty_wd(wd)
                } else {
                    dirty_all(w)
                }
                tw_frames = tw_frames + 1
                say_anim(tg(i, TW_WHAT), wd, p, d)
            }
            if p >= 1000 {
                tset(i, TW_STATE, TW_FERTIG)
            } else {
                aktiv = aktiv + 1
            }
        } else if st == TW_FERTIG {
            // Ein fertiger Tween bleibt EINEN Durchlauf stehen, damit
            // `anim_at` den Endzustand noch einmal liefert, und wird
            // dann frei. Wer ihn sofort loescht, malt das letzte Bild
            // einer Bewegung nie.
            tset(i, TW_STATE, TW_FREE)
        }
        i = i + 1
    }
    // Den Rand zuruecknehmen, damit `tw_n` nicht auf 16 stehenbleibt.
    while tw_n > 0 && tg(tw_n - 1, TW_STATE) == TW_FREE {
        tw_n = tw_n - 1
    }
    return aktiv
}

fn anim_starts() -> u64 {
    return tw_starts
}

fn anim_frames() -> u64 {
    return tw_frames
}

// Ein Wert zwischen zwei Zahlen, nach Fortschritt. Die eine Rechnung,
// die ein Maler braucht, damit sie nicht in fuenfzehn Fassungen im
// Baum steht.
// ==================================================================
// RUNDE DESIGN-2: DER MALER -- die zweite Schicht neben den Widgets.
//
// WOFUER ER DA IST. Fuenf Programme dieses Systems sind keine
// Widget-Fenster: die Taskleiste, das Schnelleinstellungs-Blatt, das
// Verlaufsdiagramm des Task-Managers, die Kachelkarte von `speicher`
// und der Schreibtisch. Sie malen eine FLAECHE, und ein Knopf ist
// dafuer das falsche Werkzeug.
//
// Vor dieser Runde haben sie deshalb `wlibc.rect`, `wlibc.frame` und
// `wlibc.text_at` selbst gerufen -- also am Rahmenwerk vorbei, mit
// eigenen Radien (keinen), eigenen Abstaenden (getippt) und eigener
// Hoehe (keiner). Genau das zaehlt tools/design/zaehlen.py.
//
// DIE ANTWORT IST NICHT "macht Knoepfe daraus", sondern die Regel von
// Justin: was das Rahmenwerk nicht kann, wird INS Rahmenwerk gebaut.
// Diese Schicht ist der Pinsel, den ein flaechenmalendes Programm
// braucht -- und sie kennt die Form-Tokens, die ein Programm nicht
// kennen soll.
//
// WAS SIE NICHT IST: ein zweiter Zeichenkern. Jede Routine hier ist
// eine Handvoll Zeilen ueber wlibc, und die Rechnung (Radius aus der
// Rolle, Schatten aus der Hoehenstufe, Abstand aus der Skala) steht
// EINMAL hier statt fuenfmal dort.

// Die Rollen, aus denen ein Radius folgt. Ein Programm sagt WAS es
// malt, nicht WIE rund es ist.
const MR_AREA: u64 = 0   // Hintergrund, kein Radius
const MR_TAFEL: u64 = 1     // eine Tafel/Karte
const MR_BUTTON: u64 = 2     // etwas Anfassbares
const MR_FIELD: u64 = 3      // ein Eingabefeld/eine Spur
// RUNDE VEKTOR: EIN GRIFF IST RUND, UND ZWAR IMMER.
//
// Gemessen an Justins Kontrollzentrum bei Vervielfachung 2: der Griff
// ist 24x32 gross, `radius_button` ist 8 -- also acht von zwoelf
// moeglichen Punkten. Die Flanken bleiben gerade, und genau das hat er
// als "eckiges Ding" fotografiert. Bei Vervielfachung 1 ist der Griff
// 12x16 und der Radius 6 von 6 moeglichen -- da faellt es NICHT auf,
// und deshalb hat es der Pruefstand nie gezeigt.
//
// Ein fester Radius ist fuer einen Griff die falsche Zahl: er soll so
// rund sein, wie er hoch ist. `mal_radius` kennt seine Masse nicht,
// also gibt diese Rolle den Hoechstwert zurueck; `rrect` deckelt ihn
// ohnehin auf die halbe kuerzere Seite. Damit ist ein Griff bei JEDER
// Vervielfachung eine Kapsel und nie ein Kasten.
const MR_GRIFF: u64 = 4     // ein Reglergriff: immer voll rund

fn draw_radius(rolle: u64) -> u64 {
    if rolle == MR_GRIFF {
        // So rund wie moeglich; `rrect` deckelt auf die halbe Seite.
        return 0xFFFF
    }
    if rolle == MR_TAFEL {
        return wlibc.metric(wlibc.M_RADIUS_PANEL)
    }
    if rolle == MR_BUTTON {
        return wlibc.metric(wlibc.M_RADIUS_BUTTON)
    }
    if rolle == MR_FIELD {
        return wlibc.metric(wlibc.M_RADIUS_INPUT)
    }
    return 0
}

// ====================================================== RUNDE GLAS
// WO DER RADIUS ANKOMMT -- UND DIE ZAHL, AN DER MAN DAS NACHMISST.
//
// Die Zahl selbst kommt aus `met[M_RADIUS_*]` und damit aus
// /etc/theme.conf; diese Bibliothek erfindet sie nicht, sie verteilt
// sie. Die Arbeit dieser Runde war, die Stellen zu finden, die statt
// `draw_radius` eine ABGETIPPTE Zahl malten -- eine feste 0 bei jedem
// `fuib.area`, `rh / 2` an der Reglerbahn, `M_RADIUS_INPUT / 2` am
// Plaettchen einer Listenzeile -- und eine Meldung zu haben, die
// beweist, dass keine uebersehen wurde.
//
// EINE ZEILE JE TYP UND BILD, nicht je Aufruf: ein Bild malt dutzende
// Knoepfe, und dutzende gleiche Zeilen auf einer seriellen Leitung
// sind keine Messung, sondern deren Verstopfung. Die Abnahme liest
// deshalb eine LISTE VON TYPEN und keine Gesamtzahl -- ein Typ, der
// den Radius nicht bekommt, faellt dadurch auf, dass seine Zeile
// fehlt, und nicht dadurch, dass eine Summe um eins danebenliegt.
//
// `r=` ist die WIRKLICH gemalte Rundung und nicht die gewuenschte:
// `wlibc.rrect` und `fuib.tafel` deckeln beide auf die halbe kuerzere
// Seite, und ein Griff schickt absichtlich 0xFFFF ("so rund wie
// moeglich"). Wer die ungedeckelte Zahl meldete, meldete etwas, das
// im Bild nicht steht.
const RT_KNOPF: u64 = 0
const RT_FELD: u64 = 1
const RT_LISTE: u64 = 2
const RT_KARTE: u64 = 3
const RT_MENUE: u64 = 4
const RT_REITER: u64 = 5
const RT_KACHEL: u64 = 6
const RT_BAHN: u64 = 7
const RT_GRIFF: u64 = 8
const RT_TAFEL: u64 = 9
const RT_HAKEN: u64 = 10
const RT_AUSWAHL: u64 = 11
const RT_TABELLE: u64 = 12
const RT_LEISTE: u64 = 13
const RT_TYPEN: u64 = 14

static mut rt_knopf: [u8; 6] = "knopf\0"
static mut rt_feld: [u8; 5] = "feld\0"
static mut rt_liste: [u8; 6] = "liste\0"
static mut rt_karte: [u8; 6] = "karte\0"
static mut rt_menue: [u8; 6] = "menue\0"
static mut rt_reiter: [u8; 7] = "reiter\0"
static mut rt_kachel: [u8; 7] = "kachel\0"
static mut rt_bahn: [u8; 5] = "bahn\0"
static mut rt_griff: [u8; 6] = "griff\0"
static mut rt_tafel: [u8; 6] = "tafel\0"
static mut rt_haken: [u8; 6] = "haken\0"
static mut rt_auswahl: [u8; 8] = "auswahl\0"
static mut rt_tabelle: [u8; 8] = "tabelle\0"
static mut rt_leiste: [u8; 7] = "leiste\0"

fn radius_typ_name(typ: u64) -> u64 {
    if typ == RT_KNOPF {
        return (&rt_knopf[0 as usize]) as u64
    }
    if typ == RT_FELD {
        return (&rt_feld[0 as usize]) as u64
    }
    if typ == RT_LISTE {
        return (&rt_liste[0 as usize]) as u64
    }
    if typ == RT_KARTE {
        return (&rt_karte[0 as usize]) as u64
    }
    if typ == RT_MENUE {
        return (&rt_menue[0 as usize]) as u64
    }
    if typ == RT_REITER {
        return (&rt_reiter[0 as usize]) as u64
    }
    if typ == RT_KACHEL {
        return (&rt_kachel[0 as usize]) as u64
    }
    if typ == RT_BAHN {
        return (&rt_bahn[0 as usize]) as u64
    }
    if typ == RT_GRIFF {
        return (&rt_griff[0 as usize]) as u64
    }
    if typ == RT_TAFEL {
        return (&rt_tafel[0 as usize]) as u64
    }
    if typ == RT_HAKEN {
        return (&rt_haken[0 as usize]) as u64
    }
    if typ == RT_AUSWAHL {
        return (&rt_auswahl[0 as usize]) as u64
    }
    if typ == RT_TABELLE {
        return (&rt_tabelle[0 as usize]) as u64
    }
    return (&rt_leiste[0 as usize]) as u64
}

// Welche Rolle dieser Typ in diesem Bild schon gemeldet hat, um eins
// erhoeht -- 0 heisst "noch gar nicht". Die Rolle steht mit darin,
// damit `draw_board` (das mit VERSCHIEDENEN Rollen gerufen wird) nicht
// nur seine erste meldet und der Rest still bleibt.
static mut s_rgesagt: [u64; 14] = [0 as u64; 14]
// Und eine Obergrenze je Bild. Ein Programm, das seine Tafeln in einer
// Schleife mit wechselnder Rolle malt, koennte sonst doch wieder eine
// Zeile je Aufruf erzeugen.
static mut s_rzeilen: u64 = 0
static mut rr_a: [u8; 20] = "wlib: radius rolle=\0"
static mut rr_r: [u8; 5] = " r=\0\0"
static mut rr_t: [u8; 7] = " typ=\0\0"

// ====================================================== RUNDE GLAS
// WER `begin` NICHT RUFT, MELDET TROTZDEM.
//
// Die Taskleiste und das Kontrollzentrum bauen ihr Fenster selbst und
// rufen `wlib.begin` nie -- sie benutzen von dieser Bibliothek nur die
// Malschicht (`draw_board`, gemessen: kein einziges wlib-Widget). In
// genau diesen zwei Programmen stand `s_trace` deshalb auf 0, und
// ausgerechnet fuer die groessten Flaechen des Bildes haette die
// Abnahme nie eine Zeile gesehen.
//
// Nachgesehen wird dieselbe Datei wie in `begin` (/etc/uitrace), EINMAL
// je Programm. Sie schaltet NUR diese Meldung ein und nicht `s_trace`:
// sonst redete die Leiste ploetzlich ueber jede gemalte Textstelle, und
// jedes bestehende Protokoll saehe anders aus als vorher.
static mut s_rreden: u64 = 0 // 0 = noch nicht nachgesehen, 1 = ja, 2 = nein

fn radius_reden() -> bool {
    if s_trace != 0 {
        return true
    }
    if s_rreden == 0 {
        s_rreden = 2
        var p_tr: [u8; 14] = "/etc/uitrace\0\0"
        let fdt: u64 = io.open((&p_tr[0 as usize]) as u64, 0)
        if !ulib.bad(fdt) {
            io.close(fdt)
            s_rreden = 1
            fuib.radius_bild(true)
        }
    }
    return s_rreden == 1
}

// EIN NEUES BILD FAENGT AN. Hier und nur hier werden die Meldungen
// wieder freigegeben -- `paint_all` ist die Stelle, an der wlib ein
// Bild beginnt, und `fuib` bekommt denselben Anstoss, damit seine
// zwei Wege (Vektor und `rrect`) im selben Takt melden.
fn radius_bild() {
    var t: u64 = 0
    while t < RT_TYPEN {
        s_rgesagt[t as usize] = 0
        t = t + 1
    }
    s_rzeilen = 0
    fuib.radius_bild(radius_reden())
}

fn say_radius(typ: u64, rolle: u64, r: u64, w: u64, h: u64) {
    if !radius_reden() || typ >= RT_TYPEN || s_rzeilen >= 64 {
        return
    }
    if s_rgesagt[typ as usize] == rolle + 1 {
        return
    }
    s_rgesagt[typ as usize] = rolle + 1
    s_rzeilen = s_rzeilen + 1
    // Die Deckelung, die `rrect`/`fuib.tafel` gleich selbst vornehmen.
    var kurz: u64 = w
    if h < kurz {
        kurz = h
    }
    var eff: u64 = r
    if eff > kurz / 2 {
        eff = kurz / 2
    }
    ulib.say((&rr_a[0 as usize]) as u64)
    ulib.sayn(rolle)
    ulib.say((&rr_r[0 as usize]) as u64)
    ulib.sayn(eff)
    ulib.say((&rr_t[0 as usize]) as u64)
    ulib.say(radius_typ_name(typ))
    ulib.nl()
}

// DER RADIUS EINES WIDGETTYPS -- und die Meldung darueber in einem
// Zug. Wer den Wert holt, meldet ihn auch; zwei getrennte Aufrufe
// waeren zwei Stellen, und die zweite wird vergessen.
fn typ_radius(typ: u64, rolle: u64, w: u64, h: u64) -> u64 {
    let r: u64 = draw_radius(rolle)
    say_radius(typ, rolle, r, w, h)
    return r
}

// ================================================== RUNDE GEISTERBALKEN
// DER FOKUSRING AN EINER FLAECHE -- das Gegenstueck zu `focus_ring(i)`.
//
// `focus_ring` nimmt einen WIDGET-INDEX und holt sich das Rechteck aus
// der Widgetliste. Ein Programm, das seine Flaechen mit `draw_board`
// malt (Taskleiste, Kontrollzentrum, Suchfenster -- zusammen 0 Aufrufe
// von wlib.button), hat diesen Index nicht und stuende damit ohne
// Fokusring da. Ein Programm, das ihn sich selbst aus `rring` baut,
// waere genau die zweite Umsetzung, die tools/check-ui.sh verbietet.
//
// Also dieselbe Optik aus derselben Quelle, nur an Koordinaten:
// derselbe Radius (`draw_radius`), dieselbe Breite (`M_FOCUS`),
// dieselbe Farbe (`T_FOCUS`) und derselbe Weg ueber fUi (`fuib.ring`)
// wie in `focus_ring`.
fn draw_focus(x: u64, y: u64, w: u64, h: u64, rolle: u64) {
    let r: u64 = draw_radius(rolle)
    if fuib.ring(x, y, w, h, r, wlibc.metric(wlibc.M_FOCUS),
        wlibc.theme(wlibc.T_FOCUS)) {
        return
    }
    wlibc.rring(x, y, w, h, r, wlibc.metric(wlibc.M_FOCUS),
        wlibc.theme(wlibc.T_FOCUS))
}

// EINE FLAECHE. Das ist `rect` mit einem Namen -- und der Name ist der
// Punkt: ein Programm, das seinen Hintergrund fuellt, sagt das jetzt,
// statt ein Rechteck zu malen.
fn draw_area(x: u64, y: u64, w: u64, h: u64, farbe: u64) {
    // RUNDE 31: fUi malt, die Farbe bleibt die des Aufrufers.
    if fuib.area(x, y, w, h, farbe) {
        return
    }
    wlibc.rect(x, y, w, h, farbe)
}

// EINE TAFEL: Flaeche mit dem Radius ihrer Rolle, wahlweise mit einer
// Umrandung und mit einer Hoehenstufe (also einem Schatten).
//
// `stufe` ist EL_FLAT..EL_WINDOW aus wlibc. Bei EL_FLAT wird kein
// Schatten gemalt und die Routine kostet genau so viel wie vorher.
fn draw_board(x: u64, y: u64, w: u64, h: u64, rolle: u64, stufe: u64,
    fuellung: u64, rand: u64) {
    // RUNDE GLAS: die Rolle des Aufrufers wird mitgemeldet. Taskleiste,
    // Kontrollzentrum und Suchfenster malen ihre Flaechen mit GENAU
    // dieser Funktion und mit keinem wlib-Widget -- ohne die Zeile hier
    // waeren sie in der Abnahme unsichtbar, obwohl sie die groessten
    // Flaechen des Bildes sind.
    let r: u64 = typ_radius(RT_TAFEL, rolle, w, h)
    // DER SCHATTEN BLEIBT HIER. Er ist keine Flaeche eines
    // Bedienelements, sondern eine Eigenschaft der Erhebung, und
    // wlibc.drop_shadow kennt die Tabelle dazu (elev_strength/reach).
    if stufe != wlibc.EL_FLAT {
        let s: u64 = wlibc.elev_strength(stufe)
        let reich: u64 = wlibc.elev_reach(stufe)
        if s != 0 && reich != 0 {
            wlibc.drop_shadow(x, y, w, h, r, s, reich,
                wlibc.theme(wlibc.C_SHADOW))
        }
    }
    // ============================================== RUNDE 31: fUi MALT
    //
    // Die Kurve kommt ab jetzt aus fUis Rasterer, nicht aus wlibcs
    // `rrect`/`rframe`. Die FARBE bleibt die des Aufrufers -- das
    // Kontrollzentrum rechnet seine Kachelfarben aus Schema und
    // Zustand, und fUi soll sie malen und nicht ueberstimmen.
    //
    // Warum das der wichtigere Weg ist als `paint_button`: die
    // Taskleiste, das Kontrollzentrum und das Suchfenster benutzen
    // KEIN einziges wlib-Widget (gemessen: 0 Aufrufe von
    // wlib.button/label/check/...), sondern malen ihre Flaechen mit
    // genau dieser Funktion. Ohne sie waere fUi eingebaut und auf dem
    // Bildschirm unsichtbar.
    if fuib.tafel(x, y, w, h, r, fuellung, rand,
        wlibc.metric(wlibc.M_BORDER)) {
        return
    }
    if rand == 0 {
        wlibc.rrect(x, y, w, h, r, fuellung)
        return
    }
    wlibc.rframe(x, y, w, h, r, wlibc.metric(wlibc.M_BORDER), rand,
        fuellung)
}

// EINE TRENNLINIE, mit der Deckkraft aus der Formentabelle. `classic`
// bekommt seine harte Linie, `osum` eine, die nicht schreit.
fn draw_separator(x: u64, y: u64, w: u64) {
    wlibc.divider(x, y, w, wlibc.theme(wlibc.T_LINE))
}

// TEXT AN EINER GRUNDLINIE, in einer Typo-Stufe. Ein Programm nennt die
// STUFE (TY_CAPTION..TY_DISPLAY) und keine Punktgroesse.
fn draw_text(x: u64, grundlinie: u64, p: u64, n: u64, farbe: u64,
    stufe: u64) -> u64 {
    return wlibc.text_at(wlibc.F_UI, wlibc.type_px(stufe), x, grundlinie,
        p, n, farbe)
}

// Wie breit wird dieser Text in dieser Stufe? Messen ist kein Malen,
// aber es gehoert an dieselbe Stelle wie das Malen -- sonst misst ein
// Programm mit einer anderen Groesse, als es malt.
fn draw_text_w(p: u64, n: u64, stufe: u64) -> u64 {
    return wlibc.text_w(wlibc.F_UI, wlibc.type_px(stufe), p, n)
}

fn draw_ascent(stufe: u64) -> u64 {
    return wlibc.ascent_of(wlibc.F_UI, wlibc.type_px(stufe))
}

// DIE ALTE KANTE: Flaeche, darauf eine Kante mit Licht und Schatten.
//
// Das ist die Form von `classic` und ausdruecklich KEINE Gestaltung
// dieser Runde -- sie ist die Vergangenheit, und sie muss erhalten
// bleiben, weil tools/look/run.sh Bildpunkt fuer Bildpunkt gegen sie
// misst. `eingedrueckt` dreht Licht und Schatten um.
//
// Sie steht hier und nicht mehr in der Taskleiste, damit auch der
// letzte Pinselstrich dieses Systems durch das Rahmenwerk geht.
fn draw_edge3(x: u64, y: u64, w: u64, h: u64, fuellung: u64, licht: u64,
    schatten: u64, eingedrueckt: bool) {
    wlibc.rect(x, y, w, h, fuellung)
    wlibc.frame3(x, y, w, h, licht, schatten, eingedrueckt)
}

// EIN RAHMEN OHNE FUELLUNG, mit dem Radius seiner Rolle.
//
// Fuer alles, was UEBER bereits Gemaltes gelegt wird: die Umrandung
// einer Kachelkarte, der Rand eines Diagramms. `mal_tafel` fuellt --
// wer sie hier nimmt, loescht, was er gerade gemalt hat.
fn draw_frame(x: u64, y: u64, w: u64, h: u64, rolle: u64, farbe: u64) {
    wlibc.rring(x, y, w, h, draw_radius(rolle),
        wlibc.metric(wlibc.M_BORDER), farbe)
}

// EINE WAAGERECHTE HILFSLINIE IN VOLLER DECKKRAFT.
//
// Nicht `mal_trenner`: der ist ein TRENNER zwischen zwei Bereichen und
// laeuft mit der Deckkraft aus der Formentabelle (bei `osum` ein
// Fuenftel). Ein Gitter in einem Diagramm ist etwas anderes -- es muss
// ablesbar sein, sonst ist es kein Gitter.
fn draw_line(x: u64, y: u64, w: u64, farbe: u64) {
    wlibc.hline(x, y, w, farbe)
}

// EIN BALKEN: die Grundform eines Reglers, eines Fortschritts und eines
// Diagrammbalkens. Radius der Rolle "Feld", damit ein Balken von vier
// Bildpunkten Hoehe nicht wie ein Draht aussieht.
fn draw_bar(x: u64, y: u64, w: u64, h: u64, farbe: u64) {
    var r: u64 = typ_radius(RT_BAHN, MR_FIELD, w, h)
    if r * 2 > h {
        r = h / 2
    }
    // RUNDE 31: die Rinne eines Reglers und der Fortschrittsbalken --
    // dieselbe Kapsel, gemalt von fUi.
    if fuib.tafel(x, y, w, h, r, farbe, 0, 0) {
        return
    }
    wlibc.rrect(x, y, w, h, r, farbe)
}

// EIN EINZELNER BILDPUNKT -- fuer die einzige Stelle, an der das
// wirklich noetig ist: ein Hintergrundbild, das Punkt fuer Punkt
// gerechnet wird (kernel/user/desktop.fi). Er steht hier, damit auch
// diese Stelle durch das Rahmenwerk geht und nicht daran vorbei.
fn draw_point(x: u64, y: u64, farbe: u64) {
    wlibc.px(x, y, farbe)
}

// EIN SYMBOL an einer Stelle, in der Farbe einer Rolle.
fn draw_icon(id: u64, x: u64, y: u64) -> bool {
    return wlibc.icon_draw(id, x, y)
}

// Ein Abstand aus der Skala. `sp(0..3)` = xs/s/m/l. Damit hoert das
// Tippen von 8, 10, 12 in den Programmen auf.
fn draw_spacing(stufe: u64) -> u64 {
    return wlibc.space(stufe)
}

fn anim_mix(von: u64, bis: u64, p: u64) -> u64 {
    if p >= 1000 {
        return bis
    }
    if bis >= von {
        return von + (bis - von) * p / 1000
    }
    return von - (von - bis) * p / 1000
}

fn fire(i: u64, kind: u64, index: u64, w: u64) {
    s_fired = i + 1
    s_fkind = kind
    s_findex = index
    s_fwin = w
}

// Welche Zeile einer Liste/Tabelle liegt unter dieser Stelle? MAXWD,
// wenn keine.
fn row_under(i: u64, y: u64) -> u64 {
    // RUNDE FUI-WIN11: die Zeilenhoehe DIESER Liste. Ohne das trifft
    // in einer zweizeiligen Liste jeder Klick die falsche Zeile --
    // der Fehler, der im Bild NICHT zu sehen ist.
    let zh: u64 = row_h_of(i)
    var oben: u64 = g(i, D_Y) + 2
    if g(i, D_KIND) == K_TABLE {
        oben = g(i, D_Y) + zh + 5
    }
    if y < oben {
        return MAXWD
    }
    let r: u64 = (y - oben) / zh + g(i, D_B)
    var int: u64 = g(i, D_A)
    if g(i, D_KIND) == K_TABLE {
        int = sub(int, 1)
    }
    if r >= int {
        return MAXWD
    }
    return r
}

fn scroll_to(i: u64, z: u64) {
    // RUNDE FUI-WIN11: dieselbe Zeilenhoehe wie beim Malen, sonst
    // rollt die Liste an der sichtbaren Zeile vorbei.
    let zh: u64 = row_h_of(i)
    var sicht: u64 = sub(g(i, D_H), 4) / zh
    if g(i, D_KIND) == K_TABLE {
        sicht = sub(sub(g(i, D_H), 4), zh + 4) / zh
    }
    if sicht == 0 {
        return
    }
    if z < g(i, D_B) {
        s(i, D_B, z)
    } else if z >= g(i, D_B) + sicht {
        s(i, D_B, z - sicht + 1)
    }
}

fn on_down(w: u64, x: u64, y: u64, btn: u64) {
    // Ein Menuefenster: die Zeile unter dem Zeiger waehlen.
    if ng(w, N_KIND) == NK_MENU {
        // RUNDE ECHTHARDWARE-2, ANMERKUNG STATT CODE.
        //
        // Hier stand waehrend der Runde eine Spurzeile, und sie hat den
        // Fehler gefunden: das Kontextmenue der Leiste stand sichtbar
        // da, und trotzdem kam hier NICHTS an -- weil das Startmenue
        // auf L_TOP darueber lag und der Server den Klick folgerichtig
        // diesem gab. Wer denselben Verdacht noch einmal hat, setzt sie
        // wieder ein; DAUERHAFT bleibt sie NICHT.
        //
        // Grund: `wlib` steckt in dreizehn Programmen, und diese Datei
        // steht dicht unter einer stillen Grenze des selbstgehosteten
        // Uebersetzers (siehe NK_TIP weiter oben und OFFEN.md D-019).
        // Die zwanzig Zeilen Spur haben `firnc1` an `netmon`, `freunde`
        // und `powermon` erneut abbrechen lassen -- K16 fiel von 64/0
        // auf 62/2 zurueck. Eine Diagnose, die den Pruefstand rot
        // macht, ist keine.
        if s_nohit != 0 {
            return
        }
        let zh: u64 = lines_height() + 2
        if y >= 2 {
            let k: u64 = (y - 2) / zh
            if k < ng(w, N_CNT) {
                ns(w, N_VAL, k + 1)
                fire(ng(w, N_OWNER), K_MENUBAR, k, w)
            }
        }
        return
    }
    let i: u64 = hit_at(w, x, y)
    if i >= MAXWD {
        return
    }
    let k: u64 = g(i, D_KIND)
    if (g(i, D_FLAGS) & F_FOCUSABLE) != 0 {
        set_focus(i)
    }
    if k == K_BUTTON {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_PRESSED)
        // Das Druecken ist die schnellste Bewegung im System: die
        // Hand ist schon da, das Bild darf nicht hinterherlaufen.
        let _a3: u64 = anim_start(AN_PRESS, g(i, D_WIN), i,
            wlibc.MO_FAST, EASE_OUT)
        s_down = i + 1
        dirty_wd(i)
        return
    }
    // RUNDE CERTUS-AUF-OSUM: die Leinwand bekommt die Stelle IM WIDGET
    // und entscheidet selbst, was darunter liegt.
    if k == K_CANVAS {
        lw_push(i, LE_DOWN, ((x - g(i, D_X)) << 16) | (y - g(i, D_Y)), btn)
        s_down = i + 1
        return
    }
    // RUNDE ALLTAG. Ein Schieberegler springt dorthin, wo geklickt
    // wurde, und zieht dann mit. Eine Bildflaeche schiebt das Bild.
    if k == K_SLIDER {
        s(i, D_FLAGS, g(i, D_FLAGS) | F_PRESSED)
        s_down = i + 1
        slider_setz(i, x)
        fire(i, K_SLIDER, g(i, D_VAL), w)
        return
    }
    if k == K_IMAGE {
        s_down = i + 1
        s_dragx = x
        s_dragy = y
        if g(i, D_WZ) == 1 {
            s_aus_x0 = image_px(i, x)
            s_aus_y0 = image_py(i, y)
            s_aus_x1 = s_aus_x0
            s_aus_y1 = s_aus_y0
            s_aus_da = 1
            dirty_wd(i)
        }
        return
    }
    // ROUND THEMESTORE: A TILE IS A BIG BUTTON. It reports the click
    // at once instead of on release -- there is no "pressed" look to
    // show, because the tile already shows a preset and dimming it
    // would misrepresent the very thing it is there to display.
    if k == K_TILE {
        dirty_wd(i)
        fire(i, K_TILE, 0, w)
        return
    }
    if k == K_CHECK {
        s(i, D_VAL, 1 - g(i, D_VAL))
        dirty_wd(i)
        fire(i, K_CHECK, g(i, D_VAL), w)
        return
    }
    // MERGE-8: hier stand TON-2s zweiter K_SLIDER-Zweig. Runde ALLTAG
    // behandelt denselben Fall weiter oben in dieser Funktion und kehrt
    // dort zurueck -- dieser Block war nach dem Zusammenfuehren nicht
    // mehr erreichbar (und rief slider_set_x, das mit TON-2s Regler
    // weggefallen ist).
    if k == K_ENTRY {
        // Die Einfuegemarke dorthin, wo geklickt wurde -- Zeichen fuer
        // Zeichen nachgerechnet und nicht durch die mittlere Breite
        // geteilt: bei einer Proportionalschrift waere das um bis zu
        // ein halbes Zeichen daneben.
        let p: u64 = g(i, D_TEXT)
        let n: u64 = tlen(p)
        var at: u64 = 0
        while at < n && entry_x(i, at + 1) <= x {
            at = at + 1
        }
        s(i, D_B, at)
        s(i, D_C, at)
        s_down = i + 1
        dirty_wd(i)
        return
    }
    // ============================================== RUNDE GUI-EDITOR
    //
    // DER KLICK IM MEHRZEILIGEN FELD. Er setzt die Marke; mit
    // gehaltener Umschalttaste (M_SHIFT = 8, dieselbe Maske wie bei
    // der Liste) zieht er statt dessen die Auswahl bis hierher.
    // `s_down` merkt sich das Feld, damit `on_move` weiterziehen kann.
    if k == K_TEXTAREA {
        let tt: u64 = g(i, D_VAL)
        if tt < TA_MAX {
            if (btn & 8) == 0 {
                ta_hit(i, x, y)
                ta_sel_clear(tt)
            } else {
                ta_hit(i, x, y)
            }
            s_down = i + 1
            set_focus(i)
            dirty_wd(i)
        }
        return
    }
    if k == K_LIST || k == K_TABLE {
        // die Bildlaufleiste?
        if x >= g(i, D_X) + g(i, D_W) - 16 {
            // RUNDE FUI-WIN11: dieselbe Zeilenhoehe wie beim Malen --
            // sonst springt die Rollleiste um andere Betraege, als die
            // Liste zeigt.
            let zh: u64 = row_h_of(i)
            var sicht: u64 = sub(g(i, D_H), 4) / zh
            if k == K_TABLE {
                sicht = sub(sub(g(i, D_H), 4), zh + 4) / zh
            }
            var int: u64 = g(i, D_A)
            if k == K_TABLE {
                int = sub(int, 1)
            }
            if int > sicht {
                let rel: u64 = sub(y, g(i, D_Y))
                let z: u64 = rel * int / g(i, D_H)
                var oben: u64 = z
                if oben + sicht > int {
                    oben = int - sicht
                }
                s(i, D_B, oben)
                dirty_wd(i)
            }
            return
        }
        // die Kopfzeile einer Tabelle: nach dieser Spalte sortieren
        if k == K_TABLE && y < g(i, D_Y) + lines_height() + 5 {
            var cx: u64 = g(i, D_X) + 2
            var c: u64 = 0
            while c < g(i, D_C) {
                if x >= cx && x < cx + column_wide(i, c) {
                    fire(i, K_TABLE, c, w)
                    s(i, D_C, g(i, D_C))
                    c = g(i, D_C)
                } else {
                    cx = cx + column_wide(i, c)
                    c = c + 1
                }
            }
            return
        }
        let r: u64 = row_under(i, y)
        if r < MAXWD {
            let jetzt: u64 = ticks()
            var doppelt: bool = false
            if s_lastwd == i + 1 && s_lastclick != 0 {
                if jetzt - s_lastclick < 100 && g(i, D_VAL) == r {
                    doppelt = true
                }
            }
            // ==================================== RUNDE EXPLORER-2
            //
            // STRG-KLICK UND UMSCHALT-KLICK. Die zwei Bits kommen aus
            // `kernel/wm.fi` in derselben Maske wie die Maustasten
            // (M_CTRL = 16, M_SHIFT = 8); eine Liste OHNE angemeldetes
            // Bitfeld sieht davon nichts und verhaelt sich wie immer.
            if g(i, D_SELP) != 0 && (btn & 2) == 0 {
                if (btn & 16) != 0 {
                    // Strg: dieses eine Stueck umschalten, der Rest
                    // bleibt stehen. Der Anker wandert mit, damit ein
                    // Umschalt-Klick danach von HIER aus misst.
                    sel_setz(i, r, !sel_hat(i, r))
                    sel_anker(i, r)
                } else if (btn & 8) != 0 {
                    // Umschalt: vom Anker bis hierher, alles dazwischen.
                    sel_bereich(i, r)
                } else {
                    // Ein Klick ohne Umschalttaste ist ein NEUER
                    // Anfang -- er wirft die alte Auswahl weg. Das ist
                    // die Regel jedes Dateimanagers, und ohne sie
                    // sammelt sich die Auswahl klammheimlich an.
                    sel_leeren(i)
                    sel_setz(i, r, true)
                    sel_anker(i, r)
                }
            }
            s(i, D_VAL, r)
            s_lastclick = jetzt
            s_lastwd = i + 1
            // RUNDE EXPLORER-2, Punkt 3: WER GEDRUECKT HAELT, ZIEHT
            // EINEN RAHMEN. Dafuer muss `on_move` wissen, auf welchem
            // Widget die Bewegung angefangen hat -- dieselbe Angabe,
            // die ein Knopf oder ein Regler hinterlaesst. Ein Widget
            // ohne Bitfeld meldet sich nicht an: dann bleibt alles wie
            // vorher.
            if g(i, D_SELP) != 0 && (btn & 2) == 0 {
                s_down = i + 1
            }
            dirty_wd(i)
            if doppelt || (g(i, D_FLAGS) & F_EINKLICK) != 0 {
                fire(i, K_LIST, r, w)
                s_lastclick = 0
            } else if (btn & 2) != 0 {
                // DIE RECHTE TASTE IST BIT 1 UND NICHT BIT 2. Der
                // PS/2-Baustein legt links auf Bit 0, RECHTS auf Bit 1
                // und die Mitte auf Bit 2 (`kernel/ps2m.fi`); der
                // QEMU-Monitor nimmt fuer `mouse_button` dieselbe
                // Reihenfolge (1 links, 2 rechts, 4 Mitte). Die erste
                // Fassung dieser Zeile pruefte auf 4 -- das ist die
                // MITTLERE Taste, und das Kontextmenue klappte nie auf,
                // ohne dass irgendwo ein Fehler stand.
                fire(i, K_SCROLL, r, w)
            }
        }
        return
    }
    if k == K_TABS {
        // RUNDE GLAS (nachtrag): DER KLICK KENNT DIE ZWEITE ZEILE.
        // Die Stelle jedes Reiters kommt aus `tab_x`/`tab_y` -- also
        // aus derselben Rechnung, aus der sie gemalt wird -- und die
        // Zeile wird MITGEPRUEFT. Ohne das Y traefe ein Klick in der
        // unteren Zeile den Reiter, der in der oberen daruebersteht.
        let zh: u64 = tab_rowh(i)
        let n: u64 = tab_n(i)
        var t: u64 = 0
        while t < n {
            let tw: u64 = tab_width(i, t)
            let tx: u64 = tab_x(i, t)
            let ty: u64 = tab_y(i, t)
            if x >= tx && x < tx + tw && y >= ty && y < ty + zh {
                if g(i, D_VAL) != t {
                    s(i, D_VAL, t)
                    dirty_wd(i)
                    fire(i, K_TABS, t, w)
                }
                t = n
            } else {
                t = t + 1
            }
        }
        return
    }
    if k == K_MENUBAR {
        var tx: u64 = g(i, D_X) + 4
        var t: u64 = 0
        while t < 8 {
            let q: u64 = row_at(g(i, D_TEXT), t)
            if q == 0 {
                t = 8
            } else {
                let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                    row_len(q)) + 16
                if x >= tx && x < tx + tw {
                    s(i, D_VAL, t + 1)
                    dirty_wd(i)
                    fire(i, K_MENUBAR, 0x1000 + t, w)
                    t = 8
                } else {
                    tx = tx + tw
                    t = t + 1
                }
            }
        }
        return
    }
    if k == K_CHOICE {
        fire(i, K_CHOICE, 0x1000, w)
        return
    }
}

fn on_up(w: u64, x: u64, y: u64) {
    // RUNDE CLIP-2: der Zug ist vorbei -- der naechste darf wieder
    // melden.
    s_dragwd = 0
    // ================================================== RUNDE CLIP-2
    //
    // ZUERST: LIEGT HIER ETWAS AB? Das wird VOR `s_down` gefragt, und
    // das ist der ganze Kniff. Eine Ziehbewegung faengt in einem
    // ANDEREN Fenster an (der Explorer legt beim Anfassen ab), also ist
    // `s_down` in DIESEM Fenster null -- der alte Rumpf war damit schon
    // fertig, bevor er zum Ablegen kam.
    //
    // Gefragt wird der Ziehplatz und nicht ein Zustand dieser
    // Bibliothek: eine Ziehbewegung zwischen ZWEI Programmen kennt kein
    // gemeinsames `wlib`, sie kennt nur den Bus.
    if s_dropan != 0 && wlibc.drag_an() {
        let d: u64 = hit_at(w, x, y)
        if d < MAXWD {
            let kd: u64 = g(d, D_KIND)
            var zeile: u64 = MAXWD
            if kd == K_LIST || kd == K_TABLE {
                zeile = row_under(d, y)
            }
            s_drops = s_drops + 1
            s_down = 0
            fire(d, K_DROP, zeile, w)
            return
        }
    }
    if s_down != 0 {
        let i: u64 = s_down - 1
        s_down = 0
        if g(i, D_KIND) == K_CANVAS {
            lw_push(i, LE_UP, (sub(x, g(i, D_X)) << 16) | sub(y, g(i, D_Y)),
                0)
            return
        }
        if g(i, D_KIND) == K_SLIDER {
            s(i, D_FLAGS, g(i, D_FLAGS) & ~F_PRESSED)
            dirty_wd(i)
            fire(i, K_SLIDER, g(i, D_VAL), w)
            return
        }
        if g(i, D_KIND) == K_IMAGE {
            fire(i, K_IMAGE, 0, w)
            return
        }
        if g(i, D_KIND) == K_BUTTON {
            s(i, D_FLAGS, g(i, D_FLAGS) & ~F_PRESSED)
            dirty_wd(i)
            // Nur, wenn losgelassen wurde, WO gedrueckt wurde -- so wie
            // jeder Knopf seit vierzig Jahren.
            if hit_at(w, x, y) == i {
                fire(i, K_BUTTON, 0, w)
            }
        }
    }
}

fn on_move(w: u64, x: u64, y: u64, btn: u64) {
    if ng(w, N_KIND) == NK_MENU {
        let zh: u64 = lines_height() + 2
        var k: u64 = ng(w, N_CNT)
        if y >= 2 {
            k = (y - 2) / zh
        }
        if k < ng(w, N_CNT) && ng(w, N_VAL) != k + 1 {
            ns(w, N_VAL, k + 1)
            dirty_all(w)
        }
        return
    }
    let i: u64 = hit_at(w, x, y)
    // RUNDE CERTUS-AUF-OSUM: die Leinwand sieht jede Bewegung ueber ihr
    // (ein ueberfahrener Verweis will das wissen); zusammengefasst im
    // Ring, siehe `lw_push`.
    if i < MAXWD && g(i, D_KIND) == K_CANVAS {
        lw_push(i, LE_MOVE, ((x - g(i, D_X)) << 16) | (y - g(i, D_Y)), btn)
    }
    // Das Zeigerbild: ueber einem Textfeld ein Balken, sonst ein Pfeil.
    // Es ist der einzige Weg, auf dem eine Anwendung dem SERVER etwas
    // ueber den Zeiger sagt, und deshalb steht er im Logbuch.
    // ======================================== RUNDE ECHTHARDWARE-4
    // DREI FORMEN STATT ZWEI: Balken ueber Text, HAND ueber allem,
    // was man anklicken kann, sonst der Pfeil.
    //
    // Bis hierher gab es Balken und Pfeil. Ein Knopf, ein Listeneintrag
    // und ein Verweis sahen damit genauso aus wie der leere
    // Fensterhintergrund -- und "was kann ich hier ueberhaupt
    // anklicken" ist die erste Frage, die ein Mensch an eine
    // Oberflaeche hat. Die Formen liegen in `kernel/zeiger.fi`:
    // 0 Pfeil, 1 Textmarke, 2 Hand.
    if i < MAXWD && g(i, D_KIND) == K_ENTRY {
        wlibc.cursor_shape(1)
    } else if i < MAXWD && anklickbar(i) {
        wlibc.cursor_shape(2)
    } else {
        wlibc.cursor_shape(0)
    }
    // Ziehen im Textfeld waehlt aus.
    //
    // RUNDE GUI-EDITOR, NACHTRAG ZU EINEM SATZ, DER HIER STAND: "die
    // Umschalttaste kommt nie als eigenes Ereignis an, also waehlt die
    // Maus". Das stimmte, solange `kernel/drv/hid/kbd.fi` den
    // xterm-Modifikator nur an die Tilde-Formen haengte -- Pfeil links
    // und Umschalt+Pfeil links waren dieselben drei Oktette. Seit
    // dieser Runde schickt `mods_of` ihn auch an die Buchstabenformen,
    // und `key_shift()` beantwortet die Frage. Die Maus waehlt
    // weiterhin, aber sie ist nicht mehr der einzige Weg.
    if s_down != 0 && (btn & 1) != 0 {
        let dd: u64 = s_down - 1
        // Im mehrzeiligen Feld zieht die Maus die Auswahl auf: der
        // Anker bleibt, wo gedrueckt wurde, die Marke folgt dem Zeiger.
        if g(dd, D_KIND) == K_TEXTAREA {
            let ty: u64 = g(dd, D_VAL)
            if ty < TA_MAX {
                let ay: u64 = tag(ty, TS_AY)
                let ax: u64 = tag(ty, TS_AX)
                ta_hit(dd, x, y)
                tas(ty, TS_AY, ay)
                tas(ty, TS_AX, ax)
                dirty_wd(dd)
            }
            return
        }
        if g(dd, D_KIND) == K_SLIDER {
            slider_setz(dd, x)
            fire(dd, K_SLIDER, g(dd, D_VAL), w)
            return
        }
        if g(dd, D_KIND) == K_IMAGE {
            if g(dd, D_WZ) == 1 {
                s_aus_x1 = image_px(dd, x)
                s_aus_y1 = image_py(dd, y)
                dirty_wd(dd)
                return
            }
            image_pan(dd, x -% s_dragx, y -% s_dragy)
            s_dragx = x
            s_dragy = y
            return
        }
        // ================================== RUNDE EXPLORER-2, Punkt 3
        //
        // DER MAUSRAHMEN. Mit gedrueckter Taste ueber eine Liste zu
        // ziehen waehlt aus, vom Anker (der Zeile, auf der gedrueckt
        // wurde) bis zu der unter dem Zeiger -- dieselbe Rechnung wie
        // Umschalt+Klick, nur fortwaehrend. GEWAEHLT WIRD IN ZEILEN und
        // nicht in Bildpunkten: eine Liste hat keine Spalten, ein
        // Gummirechteck ueber ihr waere Zierat, und die Auswahl waere
        // dieselbe. Ohne angemeldetes Bitfeld (`sel_an`) passiert
        // nichts -- eine gewoehnliche Liste zieht nicht mit.
        let kz: u64 = g(dd, D_KIND)
        if (kz == K_LIST || kz == K_TABLE) && g(dd, D_SELP) != 0 {
            let r: u64 = row_under(dd, y)
            // ERST ZIEHEN, WENN DER ZEIGER DIE ZEILE VERLAESST.
            //
            // GEMESSEN am 09.09.2026, und es war ein Fehler DIESER
            // Runde: der Zweig zog bei JEDER Bewegung mit gedrueckter
            // Taste, auch bei einer um null Bildpunkte. Der Testlaeufer
            // faehrt den Zeiger vor jedem Klick an die Stelle
            // (`drive.py::fahre`), und zwischen den zwei Klicks eines
            // DOPPELklicks kam damit ein `on_move` auf DERSELBEN Zeile.
            // Das setzte `D_VAL` neu -- und der Doppelklick prueft
            // `g(i, D_VAL) == r`, also war er keiner mehr: ein
            // Doppelklick auf einen Ordner tat nichts, und im Bild sah
            // es aus, als naehme die Tabelle keine Klicks an.
            //
            // Ein Rahmen faengt bei einer ANDEREN Zeile an; solange der
            // Zeiger auf der steht, auf der gedrueckt wurde, ist die
            // Bewegung ein Zittern der Hand und kein Ziehen.
            if r < MAXWD && r != g(dd, D_VAL) {
                // ================================== RUNDE CLIP-2
                //
                // HIER FAENGT EIN ZIEHEN AN -- und hier trennen sich
                // die beiden Deutungen derselben Bewegung.
                //
                // Ein angemeldetes ZIEHZIEL-Programm (`drop_an`) will
                // wissen, dass gezogen wird, damit es seinen Pfad auf
                // den Bus legen kann; ein Programm ohne Anmeldung zieht
                // weiter einen Mausrahmen und merkt von alledem nichts.
                // Die Auswahl bleibt in BEIDEN Faellen stehen: wer eine
                // Datei zieht, hat sie beim Druecken ausgewaehlt, und
                // sie ihm unter der Hand wegzunehmen waere falsch.
                //
                // EINMAL JE ZUG. `s_dragwd` haelt fest, dass fuer
                // diesen Druck schon gemeldet wurde -- sonst kaeme bei
                // jeder Bildpunktbewegung eine weitere Meldung, und der
                // Bus bekaeme zwanzig Schreibvorgaenge fuer eine
                // Bewegung.
                if s_dropan != 0 && s_dragwd == 0 {
                    s_dragwd = dd + 1
                    s_drags = s_drags + 1
                    // Gemeldet wird die Zeile, auf der GEDRUECKT wurde
                    // (`D_ANKER`), und nicht die unter dem Zeiger: das
                    // gezogene Stueck ist das angefasste.
                    fire(dd, K_DRAG, sel_anker_von(dd), w)
                } else {
                    sel_bereich(dd, r)
                    s(dd, D_VAL, r)
                    s_rahmen = s_rahmen + 1
                    dirty_wd(dd)
                }
            }
            return
        }
    }
    if s_down != 0 && (btn & 1) != 0 {
        let d: u64 = s_down - 1
        // MERGE-8: hier stand TON-2s Zieh-Zweig fuer den Regler. Runde
        // ALLTAG zieht denselben Regler weiter oben in dieser Funktion
        // (slider_setz) und kehrt dort zurueck.
        if g(d, D_KIND) == K_ENTRY {
            let p: u64 = g(d, D_TEXT)
            let n: u64 = tlen(p)
            // RUNDE I18N: der Sprung ist ein ZEICHEN, nicht ein Oktett
            // -- sonst setzt ein Mausklick die Marke zwischen die
            // beiden Haelften eines Umlauts.
            var at: u64 = 0
            var fertig: bool = false
            while at < n && !fertig {
                let w2: u64 = at + cp_len(p, n, at)
                if entry_x(d, w2) > x {
                    fertig = true
                } else {
                    at = w2
                }
            }
            if at != g(d, D_B) {
                s(d, D_B, at)
                dirty_wd(d)
            }
            return
        }
    }
    var k2: u64 = 0
    while k2 < nwd {
        if g(k2, D_WIN) == w {
            let alt: bool = (g(k2, D_FLAGS) & F_HOVER) != 0
            let neu: bool = k2 == i
            if alt != neu {
                if neu {
                    s(k2, D_FLAGS, g(k2, D_FLAGS) | F_HOVER)
                    // RUNDE DESIGN-2: der Knopf faehrt hoch,
                    // er springt nicht. MO_FAST = 120 ms.
                    let _a1: u64 = anim_start(AN_HOVER, g(k2, D_WIN),
                        k2, wlibc.MO_FAST, EASE_OUT)
                } else {
                    s(k2, D_FLAGS, g(k2, D_FLAGS) & ~F_HOVER)
                    let _a2: u64 = anim_start(AN_HOVER, g(k2, D_WIN),
                        k2, wlibc.MO_FAST, EASE_OUT)
                }
                if g(k2, D_KIND) == K_BUTTON {
                    dirty_wd(k2)
                }
            }
        }
        k2 = k2 + 1
    }
}

// ------------------------------------------------- die Tastatur

// DIE FLUCHTFOLGEN. Die Zeilendisziplin dieses Systems schickt
// Pfeiltasten als `ESC [ D` und Seitentasten als `ESC [ 5 ~` -- so, wie
// ein VT100 es tut und wie `kernel/kbd.fi` es aufsetzt. Ein Ereignis
// traegt EIN Oktett, also steht die Zustandsmaschine hier.
//
// EINE AUSNAHME, und sie ist aelter als diese Runde: die Pfeiltaste
// nach oben kommt als EIN Oktett 14. `kernel/kbd.fi` sagt warum.
fn decode(c: u64) -> u64 {
    if s_esc == 0 {
        if c == 27 {
            s_esc = 1
            return 0
        }
        if c == 14 {
            return KEY_UP
        }
        // RUNDE ALLTAG: DIE EINGABETASTE KOMMT ALS ZEILENVORSCHUB.
        //
        // `KEY_ENTER` ist 13, die Tastatur dieses Systems liefert 10
        // (kernel/kbd.fi, us-Tabelle). Damit hat in JEDEM Fenster die
        // Eingabetaste nichts getan -- kein Knopf, kein Dialog, kein
        // Textfeld. Gemessen an einem Dialog, der sich mit
        // `sendkey ret` nicht schliessen liess. Hier wird aus dem
        // einen das andere, an der einen Stelle, an der alle Tasten
        // vorbeikommen.
        if c == 10 {
            s_keymod = 0
            return KEY_ENTER
        }
        s_keymod = 0
        return c
    }
    if s_esc == 1 {
        if c == 91 {
            s_esc = 2
            return 0
        }
        // ============================================ RUNDE EXPLORER-2
        //
        // EINE EINZELNE FLUCHTTASTE DARF DIE NAECHSTE NICHT FRESSEN.
        //
        // Hier stand nur `s_esc = 0; return KEY_ESC`, und damit ging
        // das Oktett `c` VERLOREN. Bei einem echten Terminal ist das
        // selten zu sehen; hier ist es die Regel, denn die Flucht kommt
        // als EINZELNES Oktett (kernel/kbd.fi, Abtastcode 1) und die
        // naechste Sondertaste faengt selbst mit einer Flucht an.
        //
        // GEMESSEN am 09.09.2026: im Drehbuch der Abnahme steht
        // `taste esc` (ein Menue zumachen) und gleich danach
        // `taste alt-ret` (Eigenschaften). Auf der Leitung stand beides
        // -- `key: ^[` und `key: ^[[^[` --, im Fenster kam nur die
        // Flucht an: die zweite Flucht wurde als "kein [" gelesen,
        // gab eine ZWEITE Flucht zurueck, und der Rest der Folge
        // (`[ 27 ; 3 ~`) lief als Text ins Leere. Alt+Eingabe war
        // damit die einzige Taste dieser Runde, die nie ankam -- und
        // es lag nicht an ihr.
        //
        // Ist `c` selbst eine Flucht, fangen wir die Folge NEU an,
        // statt sie wegzuwerfen: das ist genau der Fall "zwei Fluchten
        // hintereinander", und die zweite gehoert zur naechsten Taste.
        if c == 27 {
            return KEY_ESC
        }
        s_esc = 0
        return KEY_ESC
    }
    if s_esc == 2 {
        if c >= 48 && c <= 57 {
            s_num = c - 48
            s_mod = 0
            s_esc = 3
            return 0
        }
        s_esc = 0
        // OHNE Ziffern davor: kein Modifikator. `s_keymod` gehoert zur
        // Taste, die hier gerade fertig wird, und muss deshalb hier
        // geloescht werden und nicht beim naechsten Tastendruck.
        s_keymod = 0
        return letter_key(c)
    }
    // `ESC [ n ~` und `ESC [ n ; m ~`. Der Modifikator m ist der von
    // xterm: 2 = Umschalt, 3 = Alt, 5 = Steuerung, jeweils plus eins.
    if s_esc == 3 {
        if c >= 48 && c <= 57 {
            s_num = s_num * 10 + (c - 48)
            return 0
        }
        if c == 59 {
            s_esc = 4
            return 0
        }
        s_esc = 0
        if c != 126 {
            // RUNDE GUI-EDITOR: `ESC [ 1 A` -- eine Ziffer und dann ein
            // BUCHSTABE. Bis hierher fiel das auf `return 0`, also auf
            // eine verschluckte Taste.
            s_keymod = 0
            return letter_key(c)
        }
        return tilde(s_num, 0)
    }
    if c >= 48 && c <= 57 {
        s_mod = s_mod * 10 + (c - 48)
        return 0
    }
    s_esc = 0
    if c != 126 {
        // ==================================== RUNDE GUI-EDITOR
        //
        // `ESC [ 1 ; 2 D` -- UMSCHALT + PFEIL LINKS.
        //
        // Hier stand `return 0`: eine Folge, die nicht auf `~` endet,
        // war eine unbekannte Folge und wurde weggeworfen. Genau das
        // ist die lange Form der Pfeiltasten, und sie ist der Grund,
        // warum dieses System bis zu dieser Runde keine Auswahl mit
        // Umschalt kannte.
        //
        // Der Modifikator wird NICHT in die Tastennummer gerechnet:
        // `KEY_LEFT` bleibt `KEY_LEFT`, damit jedes bestehende
        // Programm die Taste weiter erkennt. Wer den Unterschied
        // braucht, fragt `key_mod()`.
        s_keymod = s_mod
        return letter_key(c)
    }
    s_keymod = s_mod
    return tilde(s_num, s_mod)
}

// RUNDE GUI-EDITOR: die sechs Tasten mit einem BUCHSTABEN als Finale.
// Sie stehen hier einmal, statt an den drei Stellen, an denen eine
// Fluchtfolge enden kann.
fn letter_key(c: u64) -> u64 {
    if c == 65 {
        return KEY_UP
    }
    if c == 66 {
        return KEY_DOWN
    }
    if c == 67 {
        return KEY_RIGHT
    }
    if c == 68 {
        return KEY_LEFT
    }
    if c == 72 {
        return KEY_HOME
    }
    if c == 70 {
        return KEY_END
    }
    return 0
}

// ==================================================== RUNDE GUI-EDITOR
//
// WELCHE MODIFIKATOREN BEI DER LETZTEN TASTE LAGEN.
//
// Die Zahl ist die von xterm, unveraendert so, wie sie auf der Leitung
// stand: 2 = Umschalt, 3 = Alt, 5 = Strg, 6 = Strg+Umschalt. 0 heisst
// "keiner" -- das ist der Normalfall und die kurze Form der Folge.
//
// WARUM NICHT IN DER TASTENNUMMER: `KEY_LEFT` ist in dreiundzwanzig
// Programmen `KEY_LEFT`. Ein Umschalt+Links, das eine ANDERE Nummer
// haette, waere fuer jedes davon eine unbekannte Taste; so bleibt es
// dieselbe Taste, und nur wer fragt, sieht den Unterschied.
fn key_mod() -> u64 {
    return s_keymod
}

fn key_shift() -> bool {
    return s_keymod == 2 || s_keymod == 4 || s_keymod == 6 || s_keymod == 8
}

fn key_ctrl() -> bool {
    return s_keymod >= 5
}

fn tilde(n: u64, m: u64) -> u64 {
    // RUNDE EXPLORER-2: die F-Tasten und die Kombinationen. Sie stehen
    // VOR den alten Nummern, weil sie eigene Nummern haben und keine
    // der alten ueberdecken -- die Reihenfolge ist hier nur Lesbarkeit.
    if n >= 11 && n <= 15 {
        return KEY_F1 + (n - 11)
    }
    if n >= 17 && n <= 21 {
        // Die Luecke bei 16 ist xterms, nicht unsere: F6 ist 17.
        if m == 3 {
            // `ESC [ 20..22 ; 3 ~` sind die Alt-Pfeile, und die haben
            // dieselben Nummern wie F9/F10 -- der Modifikator trennt
            // sie, so wie er bei Entf zwischen Entf und Umschalt+Entf
            // trennt.
            if n == 20 {
                return KEY_OLD_LEFT
            }
            if n == 21 {
                return KEY_OLD_RIGHT
            }
        }
        return KEY_F6 + (n - 17)
    }
    if n == 22 && m == 3 {
        return KEY_OLD_UP
    }
    if n == 27 && m == 3 {
        return KEY_OLD_ENTER
    }
    if n == 30 && m == 5 {
        return KEY_CTRL_H
    }
    if n == 31 && m == 5 {
        return KEY_CTRL_N
    }
    if n == 5 {
        return KEY_PGUP
    }
    if n == 6 {
        return KEY_PGDN
    }
    if n == 3 {
        if m == 2 {
            return KEY_SDEL
        }
        return KEY_DEL
    }
    if n == 1 {
        return KEY_HOME
    }
    if n == 4 {
        return KEY_END
    }
    return 0
}

// ==================================================== RUNDE GUI-EDITOR
//
// K_TEXTAREA -- DAS MEHRZEILIGE TEXTFELD.
//
// ========================================================= WARUM ES FEHLTE
//
// Der Kopf dieser Datei sagt seit Runde K15 einen Satz, der bis heute
// stimmte: "keine Umbrueche im Textfeld (es ist EINE Zeile)". Das
// Textfeld `K_ENTRY` haelt einen Zeiger auf einen Puffer des Aufrufers,
// eine Einfuegemarke und einen Anker -- und das reicht fuer eine
// Adresszeile, einen Dateinamen und ein Kennwort.
//
// Es reicht fuer keinen Editor. Ein Editor braucht ZEILEN, und Zeilen
// sind nicht "ein Puffer mit \n darin": wer eine Datei mit
// fuenftausend Zeilen als EIN Oktettfeld haelt und in Zeile drei ein
// Zeichen einfuegt, kopiert alle Oktette dahinter um EINS nach hinten.
// Das ist bei jedem Tastendruck die ganze Datei.
//
// ============================================== WIE DER TEXT HIER LIEGT
//
// Als ZEILENTAFEL. Jede Zeile ist ein eigener Block aus `map_surface`
// (ein anonymes mmap, dasselbe, was wlibc fuer die Malflaeche nimmt),
// und die Tafel haelt je Zeile drei Woerter:
//
//     LN_P    Zeiger auf die Oktette der Zeile (ohne Zeilenumbruch)
//     LN_N    wie viele Oktette benutzt sind
//     LN_CAP  wie viele Platz haben
//
// Ein Zeichen einfuegen kopiert damit nur den REST DIESER ZEILE, nicht
// den Rest der Datei -- bei einer Zeile von 60 Zeichen sind das 60
// Oktette statt 200 000. Eine Zeile teilen (Eingabetaste) oder zwei
// zusammenziehen (Rueckschritt am Zeilenanfang) verschiebt EINTRAEGE
// IN DER TAFEL (je 3 Woerter), nicht den Text.
//
// WARUM NICHT EIN LUECKENPUFFER. Er waere fuer das Tippen genauso gut
// und fuer "gehe zu Zeile 4000" schlechter: dort muesste er zaehlen,
// die Zeilentafel rechnet. Und der Zeichner braucht genau das --
// "gib mir Zeile 312 bis 348" -- bei jedem einzelnen Bild.
//
// ============================================ WAS DER ZEICHNER WIRKLICH MALT
//
// NUR DEN SICHTBAREN AUSSCHNITT. `paint_ta` faengt bei `TA_TOP` an und
// hoert nach so vielen Zeilen auf, wie in das Rechteck passen -- bei
// einem Fenster von 700 Bildpunkten sind das rund 40 Zeilen, ob die
// Datei nun 50 oder 50 000 hat. Ohne das ist eine grosse Datei nicht
// langsam, sondern unbedienbar.
//
// DIE SCHRIFT IST DIE FESTE (`F_MONO`). Das ist keine Geschmacksfrage:
// mit einer festen Zellenbreite ist "welche Spalte ist an Bildpunkt x"
// eine Division statt einer Messung Zeichen fuer Zeichen, und beim
// Ziehen mit der Maus wird diese Frage je Bewegung gestellt.
//
// ====================================================== WAS ES KANN
//
// Marke mit Pfeilen, Pos1/Ende, Bild auf/ab, Strg+Pfeil wortweise,
// Strg+Pos1/Ende an Anfang und Ende der Datei. Auswahl mit Umschalt
// (siehe `mods_of` in kernel/drv/hid/kbd.fi -- diese Runde hat die
// Umschalttaste ueberhaupt erst auf die Leitung gebracht) und mit der
// Maus, samt Ziehen. Zwischenablage ueber `wlibc.clip_put/clip_take`,
// also dieselbe, die der Dateimanager benutzt. Rueckgaengig und
// Wiederholen. Zwei Rollbalken.
//
// DIE OKTETTE GEHOEREN DIESEM WIDGET und nicht dem Aufrufer -- das ist
// der Unterschied zu `K_ENTRY`. Ein Editor, der seinen Text als festes
// Feld anlegen muesste, haette wieder eine Hoechstgroesse im
// Quelltext.
const K_TEXTAREA: u64 = 18

// Die Zeilentafel: je Zeile drei Woerter.
const LN_P: u64 = 0
const LN_N: u64 = 1
const LN_CAP: u64 = 2
const LN_W: u64 = 3

// Wie viele Zeilen und wie viele Textfelder es geben darf.
//
// DIE ZAHLEN SIND GEMESSEN UND NICHT GERATEN. 20 000 Zeilen zu drei
// Woertern sind 480 KiB Tafel -- das ist die eine grosse feste Tafel
// dieses Widgets, und sie liegt in `.bss`, also im Abbild als Luecke
// und nicht als Oktette. Die Messlatte dieser Runde nennt 5 000
// Zeilen; das Vierfache davon ist Luft, ohne dass die Tafel in die
// Groessenordnung kommt, in der sie selbst das Problem waere.
const TA_MAXL: u64 = 20000
const TA_MAX: u64 = 2 // wie viele mehrzeilige Felder gleichzeitig

// Der Zustand je Textfeld, neben der Zeilentafel.
const TS_NL: u64 = 0 // wie viele Zeilen belegt sind
const TS_CY: u64 = 1 // die Marke: Zeile
const TS_CX: u64 = 2 // die Marke: Oktett IN der Zeile
const TS_AY: u64 = 3 // der Anker der Auswahl: Zeile
const TS_AX: u64 = 4 // der Anker: Oktett
const TS_TOP: u64 = 5 // erste sichtbare Zeile
const TS_LEFT: u64 = 6 // waagerechter Versatz in ZEICHEN
const TS_DIRTY: u64 = 7 // veraendert seit dem letzten Sichern
const TS_WANT: u64 = 8 // Wunschspalte fuer Hoch/Runter
const TS_UN: u64 = 9 // wie viele Schritte im Rueckgaengig-Stapel
const TS_UAT: u64 = 10 // wo im Stapel wir stehen (fuer Wiederholen)
const TS_TAB: u64 = 11 // Tabulatorbreite in Zeichen
const TS_LANG: u64 = 12 // welche Sprache eingefaerbt wird
const TS_RO: u64 = 13 // nur lesen
const TS_EOL: u64 = 14 // 0 = LF, 1 = CRLF -- was beim Sichern geschrieben wird
const TS_F: u64 = 15

static mut ta_line: [u64; 60000] = [0 as u64; 60000] // TA_MAXL * LN_W
static mut ta_st: [u64; 30] = [0 as u64; 30] // TA_MAX * TS_F
static mut ta_n: u64 = 0 // wie viele Textfelder angelegt sind
static mut ta_wd: [u64; 2] = [0 as u64; 2] // Widget-Nummer je Textfeld

// DIE ZEILENTAFEL GEHOERT IMMER GENAU EINEM FELD. Zwei mehrzeilige
// Felder gleichzeitig gibt es in diesem System nicht (der Editor hat
// EINES und schaltet die Reiter darauf um) -- `TA_MAX` ist 2, damit ein
// Dialog daneben eines haben darf, und die Tafel bekommt das Feld 0.
// Fuer ein zweites Feld faengt sie bei TA_MAXL/2 an.
fn ta_base(t: u64) -> u64 {
    return t * (TA_MAXL / TA_MAX)
}

fn ta_maxl(t: u64) -> u64 {
    let _v: u64 = t
    return TA_MAXL / TA_MAX
}

fn tag(t: u64, f: u64) -> u64 {
    if t >= TA_MAX || f >= TS_F {
        return 0
    }
    return ta_st[(t * TS_F + f) as usize]
}

fn tas(t: u64, f: u64, v: u64) {
    if t >= TA_MAX || f >= TS_F {
        return
    }
    ta_st[(t * TS_F + f) as usize] = v
}

fn lg(t: u64, y: u64, f: u64) -> u64 {
    if y >= ta_maxl(t) {
        return 0
    }
    return ta_line[((ta_base(t) + y) * LN_W + f) as usize]
}

fn ls_(t: u64, y: u64, f: u64, v: u64) {
    if y >= ta_maxl(t) {
        return
    }
    ta_line[((ta_base(t) + y) * LN_W + f) as usize] = v
}

// EINE ZEILE BEKOMMT PLATZ. Aufgerundet auf 64 Oktette, damit das
// Tippen in einer Zeile nicht bei jedem zweiten Zeichen neu abbildet.
//
// `map_surface` ist ein anonymes mmap und gibt nie etwas zurueck --
// eine Zeile, die kuerzer wird, behaelt ihren Block. Das ist Absicht:
// ein Editor, der beim Loeschen Speicher zurueckgibt, holt ihn beim
// naechsten Tippen wieder, und dieses System hat keinen Allokator, der
// das billig koennte.
fn ln_room(t: u64, y: u64, want: u64) -> bool {
    if lg(t, y, LN_CAP) >= want {
        return true
    }
    var cap: u64 = (want + 63) & 0xFFFFFFFFFFFFFFC0
    if cap < 64 {
        cap = 64
    }
    let p: u64 = wlibc.map_surface(cap)
    if ulib.bad(p) || p == 0 {
        return false
    }
    let alt: u64 = lg(t, y, LN_P)
    let n: u64 = lg(t, y, LN_N)
    if alt != 0 && n != 0 {
        var i: u64 = 0
        while i < n {
            __mmio_write8((p + i) as *mut u8, __mmio_read8((alt + i) as *mut u8))
            i = i + 1
        }
    }
    ls_(t, y, LN_P, p)
    ls_(t, y, LN_CAP, cap)
    return true
}

// ------------------------------------------------- die Zeilen umschichten
//
// EINE ZEILE EINFUEGEN ODER WEGNEHMEN VERSCHIEBT EINTRAEGE, NICHT TEXT.
// Drei Woerter je Zeile: bei 5000 Zeilen sind das im schlimmsten Fall
// 120 KiB Umkopieren, und das geschieht bei der EINGABETASTE, nicht bei
// jedem Zeichen.
fn ln_open(t: u64, at: u64) -> bool {
    let n: u64 = tag(t, TS_NL)
    if n + 1 >= ta_maxl(t) {
        return false
    }
    var y: u64 = n
    while y > at {
        ls_(t, y, LN_P, lg(t, y - 1, LN_P))
        ls_(t, y, LN_N, lg(t, y - 1, LN_N))
        ls_(t, y, LN_CAP, lg(t, y - 1, LN_CAP))
        y = y - 1
    }
    ls_(t, at, LN_P, 0)
    ls_(t, at, LN_N, 0)
    ls_(t, at, LN_CAP, 0)
    tas(t, TS_NL, n + 1)
    return true
}

fn ln_drop(t: u64, at: u64) {
    let n: u64 = tag(t, TS_NL)
    if at >= n {
        return
    }
    var y: u64 = at
    while y + 1 < n {
        ls_(t, y, LN_P, lg(t, y + 1, LN_P))
        ls_(t, y, LN_N, lg(t, y + 1, LN_N))
        ls_(t, y, LN_CAP, lg(t, y + 1, LN_CAP))
        y = y + 1
    }
    tas(t, TS_NL, n - 1)
}

// --------------------------------------------------- Oktette in der Zeile

fn ln_insert(t: u64, y: u64, at: u64, p: u64, n: u64) -> bool {
    if n == 0 {
        return true
    }
    let have: u64 = lg(t, y, LN_N)
    if !ln_room(t, y, have + n) {
        return false
    }
    let dst: u64 = lg(t, y, LN_P)
    var i: u64 = have
    while i > at {
        __mmio_write8((dst + i + n - 1) as *mut u8, __mmio_read8((dst + i - 1) as *mut u8))
        i = i - 1
    }
    i = 0
    while i < n {
        __mmio_write8((dst + at + i) as *mut u8, __mmio_read8((p + i) as *mut u8))
        i = i + 1
    }
    ls_(t, y, LN_N, have + n)
    return true
}

fn ln_erase(t: u64, y: u64, at: u64, n: u64) {
    let have: u64 = lg(t, y, LN_N)
    if at >= have || n == 0 {
        return
    }
    var weg: u64 = n
    if at + weg > have {
        weg = have - at
    }
    let p: u64 = lg(t, y, LN_P)
    var i: u64 = at
    while i + weg < have {
        __mmio_write8((p + i) as *mut u8, __mmio_read8((p + i + weg) as *mut u8))
        i = i + 1
    }
    ls_(t, y, LN_N, have - weg)
}

// ------------------------------------------------------ Zeichengrenzen
//
// RUNDE I18N gilt hier genauso wie im einzeiligen Feld: die Marke steht
// IMMER auf einer Zeichengrenze, sonst zerteilt der naechste
// Rueckschritt einen Umlaut.
fn ta_back(t: u64, y: u64, at: u64) -> u64 {
    if at == 0 {
        return 0
    }
    let p: u64 = lg(t, y, LN_P)
    var q: u64 = at - 1
    while q > 0 && (__mmio_read8((p + q) as *mut u8) as u64 & 0xC0) == 0x80 {
        q = q - 1
    }
    return q
}

fn ta_fwd(t: u64, y: u64, at: u64) -> u64 {
    let n: u64 = lg(t, y, LN_N)
    if at >= n {
        return n
    }
    let p: u64 = lg(t, y, LN_P)
    var q: u64 = at + 1
    while q < n && (__mmio_read8((p + q) as *mut u8) as u64 & 0xC0) == 0x80 {
        q = q + 1
    }
    return q
}

// Wie viele ZEICHEN stehen in den ersten `n` Oktetten? Das ist die
// Spalte, und die Spalte ist bei fester Schrift auch der Ort.
fn ta_cols(t: u64, y: u64, n: u64) -> u64 {
    let p: u64 = lg(t, y, LN_P)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if (__mmio_read8((p + i) as *mut u8) as u64 & 0xC0) != 0x80 {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// Und zurueck: an welchem OKTETT faengt die Spalte `col` an?
fn ta_at_col(t: u64, y: u64, col: u64) -> u64 {
    let n: u64 = lg(t, y, LN_N)
    let p: u64 = lg(t, y, LN_P)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if (__mmio_read8((p + i) as *mut u8) as u64 & 0xC0) != 0x80 {
            if c == col {
                return i
            }
            c = c + 1
        }
        i = i + 1
    }
    return n
}

// ------------------------------------------------------------ die Auswahl

fn ta_has_sel(t: u64) -> bool {
    return tag(t, TS_AY) != tag(t, TS_CY) || tag(t, TS_AX) != tag(t, TS_CX)
}

fn ta_sel_clear(t: u64) {
    tas(t, TS_AY, tag(t, TS_CY))
    tas(t, TS_AX, tag(t, TS_CX))
}

// Der Anfang der Auswahl in Lesereihenfolge -- der Anker kann HINTER
// der Marke liegen, wenn rueckwaerts ausgewaehlt wurde.
fn ta_sel_first(t: u64) -> u64 {
    let ay: u64 = tag(t, TS_AY)
    let cy: u64 = tag(t, TS_CY)
    if ay < cy {
        return (ay << 32) | tag(t, TS_AX)
    }
    if cy < ay {
        return (cy << 32) | tag(t, TS_CX)
    }
    if tag(t, TS_AX) <= tag(t, TS_CX) {
        return (ay << 32) | tag(t, TS_AX)
    }
    return (cy << 32) | tag(t, TS_CX)
}

fn ta_sel_last(t: u64) -> u64 {
    let ay: u64 = tag(t, TS_AY)
    let cy: u64 = tag(t, TS_CY)
    if ay < cy {
        return (cy << 32) | tag(t, TS_CX)
    }
    if cy < ay {
        return (ay << 32) | tag(t, TS_AX)
    }
    if tag(t, TS_AX) <= tag(t, TS_CX) {
        return (cy << 32) | tag(t, TS_CX)
    }
    return (ay << 32) | tag(t, TS_AX)
}

// Die Auswahl wegnehmen. Danach steht die Marke an ihrem Anfang.
fn ta_del_sel(t: u64) -> bool {
    if !ta_has_sel(t) {
        return false
    }
    let a: u64 = ta_sel_first(t)
    let b: u64 = ta_sel_last(t)
    let ay: u64 = a >> 32
    let ax: u64 = a & 0xFFFFFFFF
    let by: u64 = b >> 32
    let bx: u64 = b & 0xFFFFFFFF
    if ay == by {
        ln_erase(t, ay, ax, bx - ax)
    } else {
        // Der Rest der ersten Zeile faellt weg, der Rest der letzten
        // wird angehaengt, alles dazwischen verschwindet.
        ln_erase(t, ay, ax, lg(t, ay, LN_N) - ax)
        let rest: u64 = lg(t, by, LN_N)
        if rest > bx {
            let _o: bool = ln_insert(t, ay, ax, lg(t, by, LN_P) + bx, rest - bx)
        }
        var k: u64 = ay + 1
        while k <= by {
            ln_drop(t, ay + 1)
            k = k + 1
        }
    }
    tas(t, TS_CY, ay)
    tas(t, TS_CX, ax)
    ta_sel_clear(t)
    return true
}

// ================================================== RUECKGAENGIG UND WIEDERHOLEN
//
// WAS GESICHERT WIRD: der ganze Text, als EIN Schnappschuss je Schritt.
//
// Das ist die grobe Art, und sie steht hier mit Begruendung statt mit
// Entschuldigung. Die feine Art (je Schritt nur "an Stelle x kamen
// diese drei Oktette dazu") braucht eine Umkehrung je Operation, und
// jede davon ist eine eigene Fehlerquelle -- eine falsche Umkehrung
// faellt erst auf, wenn jemand zwanzig Schritte zurueckgeht und der
// Text danach kaputt ist.
//
// Ein Schnappschuss kann nicht falsch sein. Was er kostet, ist
// Speicher, und zwar die Dateigroesse mal UN_MAX; bei einer Datei von
// 200 KiB und 16 Schritten sind das 3 MiB, und dieses System hat 512.
// Wer eine Datei von 10 MiB bearbeitet, bekommt keinen Schritt mehr
// (`ta_push_undo` gibt dann still auf, statt den Editor anzuhalten) --
// das ist ehrlicher als ein Stapel, der gelegentlich Unsinn einspielt.
const UN_MAX: u64 = 16
const UN_P: u64 = 0 // Zeiger auf den Schnappschuss
const UN_N: u64 = 1 // seine Laenge
const UN_CAP: u64 = 2
const UN_CY: u64 = 3 // wo die Marke stand
const UN_CX: u64 = 4
const UN_W: u64 = 5

static mut ta_un: [u64; 160] = [0 as u64; 160] // TA_MAX * UN_MAX * UN_W

fn ug(t: u64, k: u64, f: u64) -> u64 {
    return ta_un[((t * UN_MAX + k) * UN_W + f) as usize]
}

fn us(t: u64, k: u64, f: u64, v: u64) {
    ta_un[((t * UN_MAX + k) * UN_W + f) as usize] = v
}

// Wie viele Oktette der ganze Text braucht (mit je einem \n).
fn ta_bytes(t: u64) -> u64 {
    let n: u64 = tag(t, TS_NL)
    var sum: u64 = 0
    var y: u64 = 0
    while y < n {
        sum = sum + lg(t, y, LN_N) + 1
        y = y + 1
    }
    return sum
}

// Den ganzen Text in einen Puffer schreiben. Gibt die Laenge zurueck.
fn ta_copy_out(t: u64, dst: u64, max: u64) -> u64 {
    let n: u64 = tag(t, TS_NL)
    var at: u64 = 0
    var y: u64 = 0
    while y < n {
        let ln: u64 = lg(t, y, LN_N)
        let p: u64 = lg(t, y, LN_P)
        var i: u64 = 0
        while i < ln && at < max {
            __mmio_write8((dst + at) as *mut u8, __mmio_read8((p + i) as *mut u8))
            at = at + 1
            i = i + 1
        }
        if y + 1 < n && at < max {
            __mmio_write8((dst + at) as *mut u8, 10 as u8)
            at = at + 1
        }
        y = y + 1
    }
    return at
}

fn ta_push_undo(t: u64) {
    let need: u64 = ta_bytes(t) + 16
    let at: u64 = tag(t, TS_UAT)
    // Ein neuer Schritt wirft alles weg, was "vorwaerts" lag -- wer
    // nach dem Zurueckgehen tippt, hat einen neuen Ast aufgemacht.
    tas(t, TS_UN, at)
    var k: u64 = at
    if k >= UN_MAX {
        // Der Stapel ist voll: den aeltesten wegschieben.
        var j: u64 = 0
        while j + 1 < UN_MAX {
            us(t, j, UN_P, ug(t, j + 1, UN_P))
            us(t, j, UN_N, ug(t, j + 1, UN_N))
            us(t, j, UN_CAP, ug(t, j + 1, UN_CAP))
            us(t, j, UN_CY, ug(t, j + 1, UN_CY))
            us(t, j, UN_CX, ug(t, j + 1, UN_CX))
            j = j + 1
        }
        k = UN_MAX - 1
    }
    if ug(t, k, UN_CAP) < need {
        let p: u64 = wlibc.map_surface((need + 4095) & 0xFFFFFFFFFFFFF000)
        if ulib.bad(p) || p == 0 {
            return
        }
        us(t, k, UN_P, p)
        us(t, k, UN_CAP, (need + 4095) & 0xFFFFFFFFFFFFF000)
    }
    us(t, k, UN_N, ta_copy_out(t, ug(t, k, UN_P), ug(t, k, UN_CAP)))
    us(t, k, UN_CY, tag(t, TS_CY))
    us(t, k, UN_CX, tag(t, TS_CX))
    tas(t, TS_UN, k + 1)
    tas(t, TS_UAT, k + 1)
}

fn ta_restore(t: u64, k: u64) {
    ta_set_text(t, ug(t, k, UN_P), ug(t, k, UN_N))
    tas(t, TS_CY, ug(t, k, UN_CY))
    tas(t, TS_CX, ug(t, k, UN_CX))
    ta_sel_clear(t)
    ta_follow(t)
}

// ------------------------------------------------------------- Text setzen

fn ta_clear(t: u64) {
    tas(t, TS_NL, 1)
    ls_(t, 0, LN_N, 0)
    tas(t, TS_CY, 0)
    tas(t, TS_CX, 0)
    tas(t, TS_TOP, 0)
    tas(t, TS_LEFT, 0)
    ta_sel_clear(t)
}

// EINEN GANZEN TEXT EINLESEN. Das ist der Weg, auf dem eine Datei
// hereinkommt: einmal durch die Oktette, bei jedem \n eine Zeile
// weiter. \r vor dem \n wird geschluckt und GEMERKT (`TS_EOL`), damit
// eine Datei aus der anderen Welt beim Sichern so bleibt, wie sie war.
fn ta_set_text(t: u64, p: u64, n: u64) {
    tas(t, TS_NL, 0)
    tas(t, TS_EOL, 0)
    var y: u64 = 0
    var start: u64 = 0
    var i: u64 = 0
    if !ln_open(t, 0) {
        return
    }
    while i <= n {
        if i == n || __mmio_read8((p + i) as *mut u8) as u64 == 10 {
            var ende: u64 = i
            if ende > start && __mmio_read8((p + ende - 1) as *mut u8) as u64 == 13 {
                ende = ende - 1
                tas(t, TS_EOL, 1)
            }
            if ende > start {
                let _o: bool = ln_insert(t, y, 0, p + start, ende - start)
            }
            if i == n {
                i = i + 1
            } else {
                y = y + 1
                if y >= ta_maxl(t) {
                    i = n + 1
                } else if !ln_open(t, y) {
                    i = n + 1
                } else {
                    start = i + 1
                    i = i + 1
                }
            }
        } else {
            i = i + 1
        }
    }
    tas(t, TS_CY, 0)
    tas(t, TS_CX, 0)
    tas(t, TS_TOP, 0)
    tas(t, TS_LEFT, 0)
    ta_sel_clear(t)
}

// ---------------------------------------------------------- Text einfuegen

// EINEN BLOCK EINFUEGEN, mit Zeilenumbruechen darin -- das ist das
// Einsetzen aus der Zwischenablage und zugleich der Weg, auf dem EIN
// Zeichen hereinkommt (dann ohne Umbruch).
fn ta_insert(t: u64, p: u64, n: u64) {
    if tag(t, TS_RO) != 0 {
        return
    }
    let _d: bool = ta_del_sel(t)
    var i: u64 = 0
    var start: u64 = 0
    while i <= n {
        if i == n || __mmio_read8((p + i) as *mut u8) as u64 == 10 {
            var ende: u64 = i
            if ende > start && __mmio_read8((p + ende - 1) as *mut u8) as u64 == 13 {
                ende = ende - 1
            }
            if ende > start {
                let y: u64 = tag(t, TS_CY)
                if ln_insert(t, y, tag(t, TS_CX), p + start, ende - start) {
                    tas(t, TS_CX, tag(t, TS_CX) + (ende - start))
                }
            }
            if i < n {
                ta_split(t)
            }
            start = i + 1
        }
        i = i + 1
    }
    tas(t, TS_DIRTY, 1)
    ta_sel_clear(t)
    ta_follow(t)
}

// DIE EINGABETASTE: die Zeile an der Marke teilen.
fn ta_split(t: u64) {
    let y: u64 = tag(t, TS_CY)
    let at: u64 = tag(t, TS_CX)
    let n: u64 = lg(t, y, LN_N)
    if !ln_open(t, y + 1) {
        return
    }
    if n > at {
        let _o: bool = ln_insert(t, y + 1, 0, lg(t, y, LN_P) + at, n - at)
        ln_erase(t, y, at, n - at)
    }
    tas(t, TS_CY, y + 1)
    tas(t, TS_CX, 0)
}

// ZWEI ZEILEN ZUSAMMENZIEHEN -- Rueckschritt am Zeilenanfang.
fn ta_join(t: u64, y: u64) {
    let n: u64 = lg(t, y, LN_N)
    let m: u64 = lg(t, y + 1, LN_N)
    if m > 0 {
        let _o: bool = ln_insert(t, y, n, lg(t, y + 1, LN_P), m)
    }
    ln_drop(t, y + 1)
    tas(t, TS_CY, y)
    tas(t, TS_CX, n)
}

// ------------------------------------------------------------- die Masse
//
// Zeilenhoehe und Zellenbreite der FESTEN Schrift. Sie stehen an einer
// Stelle, weil der Zeichner, die Trefferpruefung und der Bildlauf
// dieselbe Zahl brauchen -- rechnet einer anders, klickt man daneben.
fn ta_lh() -> u64 {
    return wlibc.text_h(wlibc.px_mono()) + 2
}

fn ta_cw() -> u64 {
    let c: u64 = wlibc.mono_cell(wlibc.px_mono())
    if c == 0 {
        return 8
    }
    return c
}

// Wie viele Zeilen und Spalten in das Feld passen.
fn ta_rows(i: u64) -> u64 {
    let h: u64 = g(i, D_H)
    let lh: u64 = ta_lh()
    if lh == 0 || h < 4 {
        return 1
    }
    let r: u64 = (h - 4) / lh
    if r == 0 {
        return 1
    }
    return r
}

fn ta_gutter(t: u64) -> u64 {
    if tag(t, TS_LANG) == 0xFF {
        return 0
    }
    // Die Spalte mit den Zeilennummern ist so breit wie die groesste
    // Nummer, mindestens drei Stellen -- sonst springt der Text, wenn
    // die Datei von 999 auf 1000 Zeilen waechst.
    var d: u64 = 3
    var n: u64 = tag(t, TS_NL)
    var k: u64 = 1000
    while n >= k && d < 7 {
        d = d + 1
        k = k * 10
    }
    return d * ta_cw() + 10
}

fn ta_cols_fit(i: u64, t: u64) -> u64 {
    let w: u64 = g(i, D_W)
    let cw: u64 = ta_cw()
    let gut: u64 = ta_gutter(t)
    if w <= gut + scroll_w() + 4 || cw == 0 {
        return 1
    }
    return (w - gut - scroll_w() - 4) / cw
}

// ============================================= DER BILDLAUF FOLGT DER MARKE
//
// Ohne diese Funktion tippt man aus dem Fenster heraus: die Marke geht
// weiter, das Bild bleibt stehen. Sie wird nach JEDER Bewegung und
// jeder Aenderung gerufen.
fn ta_follow(t: u64) {
    let i: u64 = ta_wd[(t) as usize]
    if i >= nwd {
        return
    }
    let rows: u64 = ta_rows(i)
    let cy: u64 = tag(t, TS_CY)
    var top: u64 = tag(t, TS_TOP)
    if cy < top {
        top = cy
    }
    if cy >= top + rows {
        top = cy + 1 - rows
    }
    let n: u64 = tag(t, TS_NL)
    if top + rows > n {
        if n > rows {
            if top > n - rows {
                top = n - rows
            }
        } else {
            top = 0
        }
    }
    tas(t, TS_TOP, top)
    // Und waagerecht dasselbe, in ZEICHEN.
    let cols: u64 = ta_cols_fit(i, t)
    let col: u64 = ta_cols(t, cy, tag(t, TS_CX))
    var left: u64 = tag(t, TS_LEFT)
    if col < left {
        left = col
    }
    if col >= left + cols {
        left = col + 1 - cols
    }
    tas(t, TS_LEFT, left)
}

// ------------------------------------------------------------ die Bewegung

fn ta_clamp(t: u64) {
    let n: u64 = tag(t, TS_NL)
    if tag(t, TS_CY) >= n {
        tas(t, TS_CY, n - 1)
    }
    let ln: u64 = lg(t, tag(t, TS_CY), LN_N)
    if tag(t, TS_CX) > ln {
        tas(t, TS_CX, ln)
    }
}

// WO DER TEXT EINER ZEILE ANFAENGT -- also hinter der Einrueckung.
//
// Sie wird an ZWEI Stellen gebraucht: Pos1 springt zuerst hierher (und
// erst beim zweiten Druck an den Rand), und die Eingabetaste nimmt
// genau diese Oktette auf die neue Zeile mit. Deshalb steht die
// Rechnung einmal und nicht zweimal.
//
// Eine Zeile, die NUR aus Leerzeichen besteht, hat keinen Textanfang;
// dann kommt 0 heraus, und Pos1 tut das Richtige (an den Rand).
fn ta_einzug(t: u64, y: u64) -> u64 {
    let p: u64 = lg(t, y, LN_P)
    let n: u64 = lg(t, y, LN_N)
    var q: u64 = 0
    while q < n {
        let c: u64 = __mmio_read8((p + q) as *mut u8) as u64
        if c != 32 && c != 9 {
            return q
        }
        q = q + 1
    }
    return 0
}

// WORTWEISE. Ein "Wort" ist hier, was auch der Rest dieses Systems ein
// Wort nennt: Buchstaben, Ziffern und der Unterstrich. Alles andere
// trennt.
fn ta_isword(c: u64) -> bool {
    if c >= 48 && c <= 57 {
        return true
    }
    if c >= 65 && c <= 90 {
        return true
    }
    if c >= 97 && c <= 122 {
        return true
    }
    if c == 95 || c >= 128 {
        return true
    }
    return false
}

fn ta_word_left(t: u64) {
    var y: u64 = tag(t, TS_CY)
    var x: u64 = tag(t, TS_CX)
    if x == 0 {
        if y == 0 {
            return
        }
        tas(t, TS_CY, y - 1)
        tas(t, TS_CX, lg(t, y - 1, LN_N))
        return
    }
    let p: u64 = lg(t, y, LN_P)
    // Erst das Trennende ueberspringen, dann das Wort.
    while x > 0 && !ta_isword(__mmio_read8((p + ta_back(t, y, x)) as *mut u8) as u64) {
        x = ta_back(t, y, x)
    }
    while x > 0 && ta_isword(__mmio_read8((p + ta_back(t, y, x)) as *mut u8) as u64) {
        x = ta_back(t, y, x)
    }
    tas(t, TS_CX, x)
}

fn ta_word_right(t: u64) {
    let y: u64 = tag(t, TS_CY)
    let n: u64 = lg(t, y, LN_N)
    var x: u64 = tag(t, TS_CX)
    if x >= n {
        if y + 1 < tag(t, TS_NL) {
            tas(t, TS_CY, y + 1)
            tas(t, TS_CX, 0)
        }
        return
    }
    let p: u64 = lg(t, y, LN_P)
    while x < n && ta_isword(__mmio_read8((p + x) as *mut u8) as u64) {
        x = ta_fwd(t, y, x)
    }
    while x < n && !ta_isword(__mmio_read8((p + x) as *mut u8) as u64) {
        x = ta_fwd(t, y, x)
    }
    tas(t, TS_CX, x)
}

// Hoch und runter halten die WUNSCHSPALTE fest: wer in einer langen
// Zeile steht, durch eine kurze faehrt und wieder in eine lange kommt,
// landet dort, wo er angefangen hat. Ohne das klebt die Marke an der
// kuerzesten Zeile, durch die sie gekommen ist.
fn ta_updown(t: u64, hoch: bool, n: u64) {
    var want: u64 = tag(t, TS_WANT)
    let y0: u64 = tag(t, TS_CY)
    if want == 0xFFFFFFFFFFFFFFFF {
        want = ta_cols(t, y0, tag(t, TS_CX))
    }
    var y: u64 = y0
    if hoch {
        if y < n {
            y = 0
        } else {
            y = y - n
        }
    } else {
        y = y + n
        if y >= tag(t, TS_NL) {
            y = tag(t, TS_NL) - 1
        }
    }
    tas(t, TS_CY, y)
    tas(t, TS_CX, ta_at_col(t, y, want))
    tas(t, TS_WANT, want)
}

// ======================================================== DIE TASTATUR
//
// EINE Stelle, an der entschieden wird, was eine Taste tut. Der
// Modifikator kommt aus `key_mod()` -- diese Runde hat ihn auf die
// Leitung gebracht (kernel/drv/hid/kbd.fi, `mods_of`), vorher war
// Umschalt+Links von Links nicht zu unterscheiden.
//
// DIE AUSWAHL IST EINE REGEL UND KEINE SONDERBEHANDLUNG: vor jeder
// Bewegung wird gefragt, ob Umschalt liegt. Wenn ja, bleibt der Anker
// stehen; wenn nein, wird er nachgezogen. Damit waehlt JEDE
// Bewegungstaste aus, auch die, an die man zuerst nicht denkt
// (Strg+Pos1, Bild ab).
fn ta_key(i: u64, k: u64) {
    let t: u64 = g(i, D_VAL)
    if t >= TA_MAX {
        return
    }
    let shift: bool = key_shift()
    let ctrl: bool = key_ctrl()
    let rows: u64 = ta_rows(i)
    var bewegt: bool = false
    var geaendert: bool = false
    // Die Wunschspalte gilt nur fuer Hoch/Runter in Folge.
    if k != KEY_UP && k != KEY_DOWN && k != KEY_PGUP && k != KEY_PGDN {
        tas(t, TS_WANT, 0xFFFFFFFFFFFFFFFF)
    }

    if k == KEY_LEFT {
        if ctrl {
            ta_word_left(t)
        } else if ta_has_sel(t) && !shift {
            let a: u64 = ta_sel_first(t)
            tas(t, TS_CY, a >> 32)
            tas(t, TS_CX, a & 0xFFFFFFFF)
        } else if tag(t, TS_CX) > 0 {
            tas(t, TS_CX, ta_back(t, tag(t, TS_CY), tag(t, TS_CX)))
        } else if tag(t, TS_CY) > 0 {
            tas(t, TS_CY, tag(t, TS_CY) - 1)
            tas(t, TS_CX, lg(t, tag(t, TS_CY), LN_N))
        }
        bewegt = true
    } else if k == KEY_RIGHT {
        if ctrl {
            ta_word_right(t)
        } else if ta_has_sel(t) && !shift {
            let b: u64 = ta_sel_last(t)
            tas(t, TS_CY, b >> 32)
            tas(t, TS_CX, b & 0xFFFFFFFF)
        } else if tag(t, TS_CX) < lg(t, tag(t, TS_CY), LN_N) {
            tas(t, TS_CX, ta_fwd(t, tag(t, TS_CY), tag(t, TS_CX)))
        } else if tag(t, TS_CY) + 1 < tag(t, TS_NL) {
            tas(t, TS_CY, tag(t, TS_CY) + 1)
            tas(t, TS_CX, 0)
        }
        bewegt = true
    } else if k == KEY_UP {
        if ctrl {
            // Strg+Hoch rollt das Bild, ohne die Marke mitzunehmen --
            // wie in jedem Editor.
            if tag(t, TS_TOP) > 0 {
                tas(t, TS_TOP, tag(t, TS_TOP) - 1)
            }
            dirty_wd(i)
            return
        }
        ta_updown(t, true, 1)
        bewegt = true
    } else if k == KEY_DOWN {
        if ctrl {
            if tag(t, TS_TOP) + rows < tag(t, TS_NL) {
                tas(t, TS_TOP, tag(t, TS_TOP) + 1)
            }
            dirty_wd(i)
            return
        }
        ta_updown(t, false, 1)
        bewegt = true
    } else if k == KEY_PGUP {
        ta_updown(t, true, rows)
        bewegt = true
    } else if k == KEY_PGDN {
        ta_updown(t, false, rows)
        bewegt = true
    } else if k == KEY_HOME {
        if ctrl {
            tas(t, TS_CY, 0)
            tas(t, TS_CX, 0)
        } else {
            // POS1 GEHT ZUERST AN DEN TEXT, DANN AN DEN RAND. Wer in
            // eingerueckten Zeilen arbeitet, will den Text und nicht
            // die Spalte 0 -- und wer die Spalte 0 will, drueckt noch
            // einmal.
            let ziel: u64 = ta_einzug(t, tag(t, TS_CY))
            if tag(t, TS_CX) == ziel {
                tas(t, TS_CX, 0)
            } else {
                tas(t, TS_CX, ziel)
            }
        }
        bewegt = true
    } else if k == KEY_END {
        if ctrl {
            tas(t, TS_CY, tag(t, TS_NL) - 1)
            tas(t, TS_CX, lg(t, tag(t, TS_NL) - 1, LN_N))
        } else {
            tas(t, TS_CX, lg(t, tag(t, TS_CY), LN_N))
        }
        bewegt = true
    } else if k == KEY_BS || k == 127 {
        if tag(t, TS_RO) != 0 {
            return
        }
        ta_push_undo(t)
        if !ta_del_sel(t) {
            if tag(t, TS_CX) > 0 {
                let at: u64 = ta_back(t, tag(t, TS_CY), tag(t, TS_CX))
                ln_erase(t, tag(t, TS_CY), at, tag(t, TS_CX) - at)
                tas(t, TS_CX, at)
            } else if tag(t, TS_CY) > 0 {
                ta_join(t, tag(t, TS_CY) - 1)
            }
        }
        geaendert = true
    } else if k == KEY_DEL || k == KEY_SDEL {
        if tag(t, TS_RO) != 0 {
            return
        }
        ta_push_undo(t)
        if !ta_del_sel(t) {
            let y: u64 = tag(t, TS_CY)
            let x: u64 = tag(t, TS_CX)
            if x < lg(t, y, LN_N) {
                ln_erase(t, y, x, ta_fwd(t, y, x) - x)
            } else if y + 1 < tag(t, TS_NL) {
                ta_join(t, y)
            }
        }
        geaendert = true
    } else if k == KEY_ENTER {
        if tag(t, TS_RO) != 0 {
            return
        }
        ta_push_undo(t)
        let _d: bool = ta_del_sel(t)
        ta_split(t)
        // DIE EINRUECKUNG DER VORIGEN ZEILE WIRD UEBERNOMMEN. Ohne das
        // faengt in einem eingerueckten Block jede neue Zeile ganz
        // links an, und der Rhythmus des Tippens bricht.
        let vy: u64 = tag(t, TS_CY) - 1
        let e2: u64 = ta_einzug(t, vy)
        if e2 > 0 {
            if ln_insert(t, tag(t, TS_CY), 0, lg(t, vy, LN_P), e2) {
                tas(t, TS_CX, e2)
            }
        }
        geaendert = true
    } else if k == KEY_TAB {
        if tag(t, TS_RO) != 0 {
            return
        }
        ta_push_undo(t)
        var sp: [u8; 8] = [32 as u8; 8]
        var br: u64 = tag(t, TS_TAB)
        if br == 0 || br > 8 {
            br = 4
        }
        ta_insert(t, (&sp[0 as usize]) as u64, br)
        geaendert = true
    } else if k == KEY_CTRL_A {
        tas(t, TS_AY, 0)
        tas(t, TS_AX, 0)
        tas(t, TS_CY, tag(t, TS_NL) - 1)
        tas(t, TS_CX, lg(t, tag(t, TS_NL) - 1, LN_N))
        dirty_wd(i)
        return
    } else if k == KEY_CTRL_C || k == KEY_CTRL_X {
        ta_clip_put(t)
        if k == KEY_CTRL_X && tag(t, TS_RO) == 0 {
            ta_push_undo(t)
            let _d2: bool = ta_del_sel(t)
            geaendert = true
        } else {
            return
        }
    } else if k == KEY_CTRL_V {
        if tag(t, TS_RO) != 0 {
            return
        }
        ta_push_undo(t)
        ta_clip_take(t)
        geaendert = true
    } else if k == KEY_CTRL_Z {
        // RUECKGAENGIG. Der Schritt, auf den wir zurueckgehen, ist der
        // VORIGE -- und bevor wir den ersten Schritt zurueckgehen,
        // muss der JETZIGE Stand im Stapel stehen, sonst ist er nach
        // einem Wiederholen weg.
        let at: u64 = tag(t, TS_UAT)
        if at > 0 {
            if at == tag(t, TS_UN) {
                ta_push_undo(t)
                tas(t, TS_UAT, at)
            }
            ta_restore(t, at - 1)
            tas(t, TS_UAT, at - 1)
            tas(t, TS_DIRTY, 1)
            dirty_wd(i)
        }
        return
    } else if k == 25 {
        // Strg+Y -- Wiederholen.
        let at2: u64 = tag(t, TS_UAT)
        if at2 + 1 < tag(t, TS_UN) {
            ta_restore(t, at2 + 1)
            tas(t, TS_UAT, at2 + 1)
            tas(t, TS_DIRTY, 1)
            dirty_wd(i)
        }
        return
    } else if druckbar(k) {
        if tag(t, TS_RO) != 0 {
            return
        }
        // EIN SCHNAPPSCHUSS JE WORT, NICHT JE ZEICHEN. Wer einen Satz
        // tippt und einmal Strg+Z drueckt, will den Satz weg haben und
        // nicht den letzten Buchstaben. Ein neues Wort faengt nach
        // einem Trennzeichen an.
        if !ta_isword(k) || !ta_has_sel(t) {
            if !ta_isword(k) {
                ta_push_undo(t)
            } else if tag(t, TS_UN) == 0 {
                ta_push_undo(t)
            }
        }
        // EINE TASTE IST EIN OKTETT. Die Oktette eines Umlauts kommen
        // von der Tastatur NACHEINANDER (siehe `druckbar` weiter
        // unten) und landen dadurch nebeneinander im Puffer -- genau
        // die Folge, die `utf8.next` beim Zeichnen wieder zusammensetzt.
        var ein: [u8; 8] = [0 as u8; 8]
        ein[(0) as usize] = k as u8
        ta_insert(t, (&ein[0 as usize]) as u64, 1)
        geaendert = true
    } else {
        return
    }

    if bewegt {
        ta_clamp(t)
        if !shift {
            ta_sel_clear(t)
        }
        ta_follow(t)
    }
    if geaendert {
        tas(t, TS_DIRTY, 1)
        ta_follow(t)
    }
    dirty_wd(i)
}

// ---------------------------------------------------- die Zwischenablage

fn ta_clip_put(t: u64) {
    if !ta_has_sel(t) {
        return
    }
    let a: u64 = ta_sel_first(t)
    let b: u64 = ta_sel_last(t)
    let ay: u64 = a >> 32
    let ax: u64 = a & 0xFFFFFFFF
    let by: u64 = b >> 32
    let bx: u64 = b & 0xFFFFFFFF
    // Ein Puffer fuer die Auswahl. Er wird einmal geholt und behalten.
    if ta_clipbuf == 0 {
        ta_clipbuf = wlibc.map_surface(TA_CLIP)
        if ulib.bad(ta_clipbuf) {
            ta_clipbuf = 0
            return
        }
    }
    var at: u64 = 0
    var y: u64 = ay
    while y <= by && at < TA_CLIP {
        var von: u64 = 0
        var bis: u64 = lg(t, y, LN_N)
        if y == ay {
            von = ax
        }
        if y == by {
            bis = bx
        }
        let p: u64 = lg(t, y, LN_P)
        var q: u64 = von
        while q < bis && at < TA_CLIP {
            __mmio_write8((ta_clipbuf + at) as *mut u8, __mmio_read8((p + q) as *mut u8))
            at = at + 1
            q = q + 1
        }
        if y < by && at < TA_CLIP {
            __mmio_write8((ta_clipbuf + at) as *mut u8, 10 as u8)
            at = at + 1
        }
        y = y + 1
    }
    let _r: u64 = wlibc.clip_put(ta_clipbuf, at)
}

fn ta_clip_take(t: u64) {
    if ta_clipbuf == 0 {
        ta_clipbuf = wlibc.map_surface(TA_CLIP)
        if ulib.bad(ta_clipbuf) {
            ta_clipbuf = 0
            return
        }
    }
    let n: u64 = wlibc.clip_take(ta_clipbuf, TA_CLIP - 1)
    if n == 0 {
        return
    }
    ta_insert(t, ta_clipbuf, n)
}

// ================================================= DIE SYNTAXHERVORHEBUNG
//
// SIE IST EINE TABELLE UND KEIN GEFLECHT AUS if.
//
// Eine Sprache besteht hier aus vier Angaben: ihre Schluesselwoerter,
// wie ein Zeilenkommentar anfaengt, ob sie Zeichenketten in
// Anfuehrungszeichen kennt, und ob Zahlen eigens gefaerbt werden. Wer
// eine fuenfte Sprache dazulegt, schreibt eine Zeile in `ta_lang_kw`
// und nichts sonst -- genau das verlangt der Auftrag ("Struktur so,
// dass weitere Sprachen dazukommen koennen").
//
// WAS SIE AUSDRUECKLICH NICHT IST: ein Parser. Sie sieht eine Zeile
// fuer sich allein an. Ein Blockkommentar ueber mehrere Zeilen wird
// deshalb nur in der Zeile erkannt, in der er anfaengt -- und das
// steht hier, statt dass es jemand spaeter als Fehler meldet.
const LANG_NONE: u64 = 0
const LANG_FIRN: u64 = 1
const LANG_SH: u64 = 2
const LANG_COUNT: u64 = 3

// Die Schluesselwoerter, durch Leerzeichen getrennt, je Sprache eine
// Zeichenkette.
static mut kw_firn: [u8; 177] = "fn let var const if else while return struct import export profile true false bool u8 u64 i64 usize as pub static mut match for in break continue type enum impl self and or not\0"
static mut kw_sh: [u8; 135] = "if then else elif fi for while do done case esac function return local export echo cd set unset read exit break continue in shift test\0"

// Die Farben. Sie kommen aus dem Farbschema und nicht aus dem
// Quelltext -- ein Editor, der seine eigenen sechs Hexziffern malt,
// sieht in jedem zweiten Schema falsch aus.
const HL_TEXT: u64 = 0
const HL_KEY: u64 = 1
const HL_STR: u64 = 2
const HL_COM: u64 = 3
const HL_NUM: u64 = 4

fn hl_color(art: u64) -> u64 {
    if art == HL_KEY {
        return wlibc.theme(wlibc.T_ACCENT)
    }
    if art == HL_STR {
        return ta_misch(wlibc.theme(wlibc.T_FG), 0x00C07030, 6)
    }
    if art == HL_COM {
        return wlibc.theme(wlibc.T_DIM)
    }
    if art == HL_NUM {
        return ta_misch(wlibc.theme(wlibc.T_FG), 0x00206090, 6)
    }
    return wlibc.theme(wlibc.T_FG)
}

// Eine Farbe zur Haelfte in eine andere ziehen -- damit die
// Hervorhebung im hellen wie im dunklen Schema lesbar bleibt, statt
// eine feste Farbe zu behaupten.
fn ta_mix(a: u64, b: u64) -> u64 {
    return ta_misch(a, b, 3)
}

// `teil` von acht Teilen `b`, der Rest `a`. EINE Rechnung fuer zwei
// sehr verschiedene Zwecke, und der Unterschied ist genau dieser
// Parameter:
//
//   Syntaxfarbe      teil 6 -- die Farbe soll man SEHEN
//   Zeile mit Marke  teil 1 -- die Hinterlegung soll man FAST NICHT
//                    sehen
//
// GEMESSEN AM BILD, nicht geschaetzt: der erste Entwurf nahm fuer
// beides drei Viertel, und die Zeile unter der Marke wurde damit ein
// satter blauer Balken quer durch das Fenster -- der Text darin war
// schlechter zu lesen als ueberall sonst, und das Auge sprang beim
// Tippen nur noch dorthin. Eine Hervorhebung, die lauter ist als der
// Text, den sie hervorhebt, ist keine.
fn ta_misch(a: u64, b: u64, teil: u64) -> u64 {
    let rest: u64 = 8 - teil
    let r: u64 = (((a >> 16) & 0xFF) * rest + ((b >> 16) & 0xFF) * teil) / 8
    let gg: u64 = (((a >> 8) & 0xFF) * rest + ((b >> 8) & 0xFF) * teil) / 8
    let bb: u64 = ((a & 0xFF) * rest + (b & 0xFF) * teil) / 8
    return (r << 16) | (gg << 8) | bb
}

fn kw_list(lang: u64) -> u64 {
    if lang == LANG_FIRN {
        return (&kw_firn[0 as usize]) as u64
    }
    if lang == LANG_SH {
        return (&kw_sh[0 as usize]) as u64
    }
    return 0
}

// Steht in der Liste genau dieses Wort?
fn kw_hat(liste: u64, p: u64, n: u64) -> bool {
    if liste == 0 || n == 0 {
        return false
    }
    var i: u64 = 0
    while __mmio_read8((liste + i) as *mut u8) as u64 != 0 {
        // den Anfang eines Wortes suchen
        var j: u64 = 0
        while j < n && __mmio_read8((liste + i + j) as *mut u8) as u64 == __mmio_read8((p + j) as *mut u8) as u64 {
            j = j + 1
        }
        if j == n {
            let nach: u64 = __mmio_read8((liste + i + n) as *mut u8) as u64
            if nach == 32 || nach == 0 {
                return true
            }
        }
        // zum naechsten Wort
        while __mmio_read8((liste + i) as *mut u8) as u64 != 0
            && __mmio_read8((liste + i) as *mut u8) as u64 != 32 {
            i = i + 1
        }
        while __mmio_read8((liste + i) as *mut u8) as u64 == 32 {
            i = i + 1
        }
    }
    return false
}

// Welche Art hat das Zeichen an Stelle `x`? Die Antwort gilt fuer den
// Lauf, der dort anfaengt; `bis` sagt, wie weit er reicht.
fn hl_run(t: u64, y: u64, x: u64) -> u64 {
    let lang: u64 = tag(t, TS_LANG)
    let p: u64 = lg(t, y, LN_P)
    let n: u64 = lg(t, y, LN_N)
    if lang == LANG_NONE || lang >= LANG_COUNT || x >= n {
        return ((n - x) << 8) | HL_TEXT
    }
    let c: u64 = __mmio_read8((p + x) as *mut u8) as u64
    // Ein Zeilenkommentar: `//` in Firn, `#` in der Shell.
    if lang == LANG_FIRN && c == 47 && x + 1 < n
        && __mmio_read8((p + x + 1) as *mut u8) as u64 == 47 {
        return ((n - x) << 8) | HL_COM
    }
    if lang == LANG_SH && c == 35 {
        return ((n - x) << 8) | HL_COM
    }
    // Eine Zeichenkette. Sie endet am naechsten gleichen
    // Anfuehrungszeichen oder am Zeilenende.
    if c == 34 || c == 39 {
        var q: u64 = x + 1
        while q < n {
            let d: u64 = __mmio_read8((p + q) as *mut u8) as u64
            if d == 92 {
                q = q + 1
            } else if d == c {
                return ((q + 1 - x) << 8) | HL_STR
            }
            q = q + 1
        }
        return ((n - x) << 8) | HL_STR
    }
    // Eine Zahl.
    if c >= 48 && c <= 57 {
        var q2: u64 = x
        while q2 < n {
            let d2: u64 = __mmio_read8((p + q2) as *mut u8) as u64
            if (d2 >= 48 && d2 <= 57) || (d2 | 32) == 120
                || ((d2 | 32) >= 97 && (d2 | 32) <= 102) {
                q2 = q2 + 1
            } else {
                q2 = n + 1
            }
        }
        if q2 > n {
            q2 = q2 - n - 1 + 0
            var q3: u64 = x
            while q3 < n {
                let d3: u64 = __mmio_read8((p + q3) as *mut u8) as u64
                if (d3 >= 48 && d3 <= 57) || (d3 | 32) == 120
                    || ((d3 | 32) >= 97 && (d3 | 32) <= 102) {
                    q3 = q3 + 1
                } else {
                    return ((q3 - x) << 8) | HL_NUM
                }
            }
            return ((q3 - x) << 8) | HL_NUM
        }
        return ((q2 - x) << 8) | HL_NUM
    }
    // Ein Wort -- vielleicht ein Schluesselwort.
    if ta_isword(c) {
        var q4: u64 = x
        while q4 < n && ta_isword(__mmio_read8((p + q4) as *mut u8) as u64) {
            q4 = q4 + 1
        }
        if kw_hat(kw_list(lang), p + x, q4 - x) {
            return ((q4 - x) << 8) | HL_KEY
        }
        return ((q4 - x) << 8) | HL_TEXT
    }
    return (1 << 8) | HL_TEXT
}

// ============================================================ DER ZEICHNER
//
// ER MALT NUR, WAS ZU SEHEN IST. Das ist die ganze Zusage dieser
// Runde an die Geschwindigkeit: die Schleife laeuft von `TS_TOP` bis
// `TS_TOP + rows`, und `rows` ist die Hoehe des Rechtecks geteilt
// durch die Zeilenhoehe. Eine Datei mit 5 000 Zeilen kostet genauso
// viel wie eine mit 50.
fn paint_ta(i: u64) {
    let t: u64 = g(i, D_VAL)
    if t >= TA_MAX {
        return
    }
    let x: u64 = g(i, D_X)
    let y: u64 = g(i, D_Y)
    let bw: u64 = g(i, D_W)
    let bh: u64 = g(i, D_H)
    let lh: u64 = ta_lh()
    let cw: u64 = ta_cw()
    let gut: u64 = ta_gutter(t)
    let rows: u64 = ta_rows(i)
    let top: u64 = tag(t, TS_TOP)
    let left: u64 = tag(t, TS_LEFT)
    let nl: u64 = tag(t, TS_NL)
    let sw: u64 = scroll_w()

    // Alles, was gemalt wird, bleibt im Feld -- ohne das laeuft eine
    // lange Zeile ueber den Rand hinaus ins Fenster.
    //
    // ======================= RUNDE GUI-EDITOR: UND IM BAND, NICHT NUR IM FELD
    //
    // DER SCHNITT MUSS MIT DEM BESTEHENDEN VERSCHNITTEN WERDEN und
    // darf ihn nicht ersetzen. Der Grund steht in `flush_rect`: ein
    // Fenster wird in BAENDERN gemalt (`wlibc.surf_rows()`, bei 1280
    // Breite 204 Zeilen hoch), und vor jedem Band setzt `flush_rect`
    // den Schnitt auf genau dieses Band. Wer ihn hier auf das ganze
    // Feld setzt, malt ueber die Bandgrenze hinaus -- und was dort
    // landet, gehoert schon zum naechsten Streifen der Malflaeche.
    //
    // GEMESSEN AM BILD, und anders war es nicht zu finden: im leeren
    // Editor standen drei waagerechte graue Linien quer durch das
    // Textfeld, bei y = 266, 470 und 674. Der Abstand ist 204 -- die
    // Bandhoehe. Im Quelltext sieht dieser Fehler wie eine richtige
    // Zeile aus.
    let a_x0: u64 = wlibc.clip_x0()
    let a_y0: u64 = wlibc.clip_y0()
    let a_x1: u64 = wlibc.clip_x1()
    let a_y1: u64 = wlibc.clip_y1()
    // Der Schnitt umfasst das GANZE Feld samt Rahmen und den zwei
    // Rollbalken -- `fuib.tafel` malt den Rand bei x und bei x+bw-1,
    // und ein Schnitt, der eins weiter innen liegt, radierte ihn weg.
    // Der Text wird weiter unten ein zweites Mal enger geschnitten.
    var c_x0: u64 = x
    var c_y0: u64 = y
    var c_x1: u64 = x + bw
    var c_y1: u64 = y + bh
    if a_x0 > c_x0 {
        c_x0 = a_x0
    }
    if a_y0 > c_y0 {
        c_y0 = a_y0
    }
    if a_x1 < c_x1 {
        c_x1 = a_x1
    }
    if a_y1 < c_y1 {
        c_y1 = a_y1
    }
    if c_x1 <= c_x0 || c_y1 <= c_y0 {
        // Von diesem Feld liegt in diesem Band nichts. Der Schnitt
        // bleibt, wie er war, und es wird nichts gemalt.
        wlibc.clip_set(a_x0, a_y0, a_x1, a_y1)
        return
    }
    wlibc.clip_set(c_x0, c_y0, c_x1, c_y1)

    // ========================= RUNDE GUI-EDITOR: DIE FLAECHE IN ZWEI TEILEN
    //
    // DER HINTERGRUND WIRD ERST FLACH GEFUELLT UND DANN GERAHMT, und
    // das ist kein Umweg, sondern die Abhilfe zu einem Fehler, den man
    // NUR IM BILD sieht.
    //
    // `fuib.tafel` schneidet ein Rechteck, das oben aus dem Band
    // herausragt, auf das Band zu (Runde 32, mit Begruendung) und malt
    // dann eine RUNDE Ecke -- mit dem vollen Radius, aber an der neuen
    // Oberkante. Bei jedem Bedienelement dieses Systems faellt das nie
    // auf: keines ist hoeher als ein Band (204 Zeilen bei 1280 Breite).
    // Dieses Feld ist 560 hoch und liegt damit in DREI Baendern -- an
    // jeder Bandgrenze rundete fUi eine Ecke in die Flaeche hinein und
    // liess eine Reihe Fensterhintergrund stehen.
    //
    // GEMESSEN am Bild dieser Runde: waagerechte Linien in
    // (226,232,240) bei y = 470 und y = 674, Abstand genau 204. Im
    // Quelltext ist davon nichts zu sehen.
    //
    // Der Rahmen bleibt rund (er wird nur einmal je Band gemalt und
    // liegt am Rand, nicht in der Flaeche); die FUELLUNG ist ein
    // flaches Rechteck, und ein flaches Rechteck hat an keiner
    // Bandgrenze eine Ecke. `fuib.area` ist derselbe Weg durch fUi,
    // nur ohne Radius -- check-ui bleibt damit zufrieden.
    let _fb: bool = fuib.area(x, y, bw, bh, wlibc.theme(wlibc.T_ENTRY))
    let _fb2: bool = fuib.ring(x, y, bw, bh,
        typ_radius(RT_FELD, MR_FIELD, bw, bh), wlibc.metric(wlibc.M_BORDER),
        wlibc.theme(wlibc.T_LINE))

    // DIE SPALTE MIT DEN ZEILENNUMMERN. Sie ist etwas dunkler als das
    // Feld, damit sie eine Spalte IST und nicht nur Zahlen am Rand.
    if gut != 0 {
        wlibc.rect(x + 1, y + 1, gut, bh - 2, wlibc.theme(wlibc.T_HEAD))
        wlibc.rect(x + gut, y + 1, 1, bh - 2, wlibc.theme(wlibc.T_LINE))
    }


    // JETZT ERST DER ENGERE SCHNITT FUER DEN TEXT: er darf nicht in
    // die Nummernspalte und nicht unter die Rollbalken laufen. Er
    // wird wieder mit dem Band verschnitten, aus demselben Grund wie
    // oben.
    var t_x0: u64 = x + gut + 1
    var t_y0: u64 = y + 1
    var t_x1: u64 = x + bw - 1 - sw
    var t_y1: u64 = y + bh - 1 - sw
    if c_x0 > t_x0 {
        t_x0 = c_x0
    }
    if c_y0 > t_y0 {
        t_y0 = c_y0
    }
    if c_x1 < t_x1 {
        t_x1 = c_x1
    }
    if c_y1 < t_y1 {
        t_y1 = c_y1
    }
    if t_x1 <= t_x0 || t_y1 <= t_y0 {
        wlibc.clip_set(a_x0, a_y0, a_x1, a_y1)
        return
    }

    let sel: bool = ta_has_sel(t)
    let sa: u64 = ta_sel_first(t)
    let sb: u64 = ta_sel_last(t)
    let say: u64 = sa >> 32
    let sax: u64 = sa & 0xFFFFFFFF
    let sby: u64 = sb >> 32
    let sbx: u64 = sb & 0xFFFFFFFF

    // Der enge Schnitt kommt NICHT um die ganze Schleife: die
    // Zeilennummer steht LINKS von `t_x0` (in der Nummernspalte), und
    // ein Schnitt, der bei x+gut+1 anfaengt, radiert sie weg -- genau
    // das ist beim ersten Versuch passiert, und im Bild fehlten alle
    // Nummern. Gesetzt wird er deshalb je Zeile um den TEXT herum und
    // fuer die Nummer wieder geloest.
    var r: u64 = 0
    while r < rows {
        let ln: u64 = top + r
        if ln >= nl {
            r = rows
        } else {
            let ty: u64 = y + 2 + r * lh
            let grund: u64 = ty + wlibc.ascent_of(wlibc.F_MONO, wlibc.px_mono())
            // die Zeilennummer
            if gut != 0 {
                var num: [u8; 12] = [0 as u8; 12]
                let nn: u64 = ta_num(ln + 1, (&num[0 as usize]) as u64)
                var farbe: u64 = wlibc.theme(wlibc.T_DIM)
                if ln == tag(t, TS_CY) {
                    farbe = wlibc.theme(wlibc.T_FG)
                }
                wlibc.text_at(wlibc.F_MONO, wlibc.px_mono(),
                    x + gut - 6 - nn * cw, grund,
                    (&num[0 as usize]) as u64, nn, farbe)
            }
            // Ab hier gehoert alles dem TEXTBEREICH -- also der enge
            // Schnitt.
            wlibc.clip_set(t_x0, t_y0, t_x1, t_y1)
            // DIE ZEILE, IN DER DIE MARKE STEHT, wird hinterlegt.
            if ln == tag(t, TS_CY) && !sel {
                wlibc.rect(x + gut + 1, ty, bw - gut - 2 - sw, lh,
                    ta_misch(wlibc.theme(wlibc.T_ENTRY),
                        wlibc.theme(wlibc.T_SEL), 1))
            }
            let p: u64 = lg(t, ln, LN_P)
            let n: u64 = lg(t, ln, LN_N)
            // Die Auswahl dieser Zeile als Balken.
            if sel && ln >= say && ln <= sby {
                var von: u64 = 0
                var bis: u64 = n
                if ln == say {
                    von = sax
                }
                if ln == sby {
                    bis = sbx
                }
                let c0: u64 = ta_cols(t, ln, von)
                var c1: u64 = ta_cols(t, ln, bis)
                if ln < sby {
                    c1 = c1 + 1 // der Umbruch gehoert dazu
                }
                if c1 > left && c0 >= left {
                    wlibc.rect(x + gut + 2 + (c0 - left) * cw, ty,
                        (c1 - c0) * cw, lh, wlibc.theme(wlibc.T_SEL))
                } else if c1 > left {
                    wlibc.rect(x + gut + 2, ty, (c1 - left) * cw, lh,
                        wlibc.theme(wlibc.T_SEL))
                }
            }
            // Der Text, in Laeufen einer Farbe.
            var q: u64 = ta_at_col(t, ln, left)
            var col: u64 = left
            let maxc: u64 = left + ta_cols_fit(i, t) + 1
            while q < n && col < maxc {
                let run: u64 = hl_run(t, ln, q)
                var laenge: u64 = run >> 8
                let art: u64 = run & 0xFF
                if laenge == 0 {
                    laenge = 1
                }
                if q + laenge > n {
                    laenge = n - q
                }
                var fg: u64 = hl_color(art)
                if sel && ln >= say && ln <= sby {
                    var iv: bool = true
                    if ln == say && q < sax {
                        iv = false
                    }
                    if ln == sby && q >= sbx {
                        iv = false
                    }
                    if iv {
                        fg = wlibc.theme_selfg()
                    }
                }
                wlibc.text_at(wlibc.F_MONO, wlibc.px_mono(),
                    x + gut + 2 + (col - left) * cw, grund, p + q, laenge, fg)
                col = col + ta_cols(t, ln, q + laenge) - ta_cols(t, ln, q)
                q = q + laenge
            }
            wlibc.clip_set(c_x0, c_y0, c_x1, c_y1)
            r = r + 1
        }
    }

    // DIE EINFUEGEMARKE. Sie blinkt nicht: ein Blinken braucht einen
    // Zeitgeber, der das Fenster von selbst schmutzig macht, und den
    // hat diese Bibliothek nicht. Ein stehender Strich ist ehrlicher
    // als einer, der manchmal da ist und manchmal nicht.
    wlibc.clip_set(t_x0, t_y0, t_x1, t_y1)
    if s_focus == i + 1 && tag(t, TS_CY) >= top && tag(t, TS_CY) < top + rows {
        let ccol: u64 = ta_cols(t, tag(t, TS_CY), tag(t, TS_CX))
        if ccol >= left {
            wlibc.rect(x + gut + 2 + (ccol - left) * cw,
                y + 2 + (tag(t, TS_CY) - top) * lh, 2, lh,
                wlibc.theme(wlibc.T_ACCENT))
        }
    }
    // Zurueck auf den weiten Schnitt (immer noch im Band): die
    // Rollbalken liegen ausserhalb des Textbereichs.
    wlibc.clip_set(c_x0, c_y0, c_x1, c_y1)

    // DIE ZWEI ROLLBALKEN. Sie werden gemalt, wenn es etwas zu rollen
    // gibt -- ein Balken, der immer voll ist, sagt nichts.
    if nl > rows {
        paint_scroll(x + bw - sw - 1, y + 1, bh - 2 - sw, top, rows, nl)
    }
    let breit: u64 = ta_longest(t)
    let fit: u64 = ta_cols_fit(i, t)
    if breit > fit {
        paint_hscroll(x + gut + 1, y + bh - sw - 1, bw - gut - 2 - sw,
            left, fit, breit)
    }
    focus_ring(i)
    wlibc.clip_set(a_x0, a_y0, a_x1, a_y1)
}

// Die laengste Zeile -- fuer den waagerechten Balken. Sie wird ueber
// die SICHTBAREN Zeilen gesucht und nicht ueber die ganze Datei: bei
// 5 000 Zeilen waere das eine Schleife ueber alles, je Bild.
fn ta_longest(t: u64) -> u64 {
    let i: u64 = ta_wd[(t) as usize]
    if i >= nwd {
        return 0
    }
    let top: u64 = tag(t, TS_TOP)
    let rows: u64 = ta_rows(i)
    let nl: u64 = tag(t, TS_NL)
    var m: u64 = 0
    var r: u64 = 0
    while r < rows && top + r < nl {
        let c: u64 = ta_cols(t, top + r, lg(t, top + r, LN_N))
        if c > m {
            m = c
        }
        r = r + 1
    }
    return m
}

// Eine Zahl als Ziffern. Gibt zurueck, wie viele es wurden.
fn ta_num(v: u64, p: u64) -> u64 {
    var n: u64 = 0
    var q: u64 = v
    var stellen: [u8; 12] = [0 as u8; 12]
    if q == 0 {
        __mmio_write8(p as *mut u8, 48 as u8)
        return 1
    }
    while q > 0 && n < 12 {
        stellen[(n) as usize] = (48 + q % 10) as u8
        q = q / 10
        n = n + 1
    }
    var k: u64 = 0
    while k < n {
        __mmio_write8((p + k) as *mut u8, stellen[(n - 1 - k) as usize])
        k = k + 1
    }
    return n
}

// EIN WAAGERECHTER ROLLBALKEN.
//
// `paint_scroll` gibt es schon, aber nur senkrecht -- und ein
// gedrehter Aufruf waere ein zweiter Satz Rechnungen an einer Stelle,
// an der schon einer steht. Gemalt wird mit DENSELBEN zwei Aufrufen
// wie dort (`fuib.area` fuer die Rinne, `fuib.tafel` fuer den Griff),
// damit `tools/check-ui.sh` recht behaelt: es gibt keine zweite
// Umsetzung dieser Optik, nur dieselbe um neunzig Grad.
fn paint_hscroll(x: u64, y: u64, w: u64, links: u64, sicht: u64,
    ganz: u64) {
    let sw: u64 = scroll_w()
    let _fh1: bool = fuib.area(x, y, w, sw, wlibc.theme(wlibc.T_SCROLL))
    if ganz == 0 || sicht >= ganz {
        return
    }
    var bw: u64 = w * sicht / ganz
    if bw < 12 {
        bw = 12
    }
    if bw > w {
        bw = w
    }
    var bx: u64 = 0
    if ganz > sicht {
        bx = (w - bw) * links / (ganz - sicht)
    }
    let _fh2: bool = fuib.tafel(x + bx, y + 2, bw, thumb_w(),
        typ_radius(RT_GRIFF, MR_GRIFF, bw, thumb_w()),
        wlibc.theme(wlibc.T_THUMB), 0, 0)
}

// ========================================================== DIE MAUS
//
// WO IM TEXT LIEGT EIN PUNKT. Mit fester Schrift ist das eine
// Division und keine Messung Zeichen fuer Zeichen -- genau deshalb ist
// die Schrift fest.
fn ta_hit(i: u64, mx: u64, my: u64) {
    let t: u64 = g(i, D_VAL)
    if t >= TA_MAX {
        return
    }
    let lh: u64 = ta_lh()
    let cw: u64 = ta_cw()
    let gut: u64 = ta_gutter(t)
    let x0: u64 = g(i, D_X) + gut + 2
    let y0: u64 = g(i, D_Y) + 2
    var r: u64 = 0
    if my > y0 {
        r = (my - y0) / lh
    }
    var ln: u64 = tag(t, TS_TOP) + r
    if ln >= tag(t, TS_NL) {
        ln = tag(t, TS_NL) - 1
    }
    var col: u64 = tag(t, TS_LEFT)
    if mx > x0 {
        col = col + (mx - x0 + cw / 2) / cw
    }
    tas(t, TS_CY, ln)
    tas(t, TS_CX, ta_at_col(t, ln, col))
    tas(t, TS_WANT, 0xFFFFFFFFFFFFFFFF)
    ta_follow(t)
}

// ==================================================== WAS EIN PROGRAMM SIEHT
//
// Die Schnittstelle nach aussen. Sie ist bewusst klein: ein Editor
// braucht "leg ein Feld an", "gib mir den Text", "nimm diesen Text",
// "wo steht die Marke" und "ist etwas veraendert" -- alles andere
// macht das Widget selbst.

// EIN MEHRZEILIGES TEXTFELD ANLEGEN. Es nimmt den Platz, den sein
// Kasten ihm gibt (`size(bw, bh)` davor), wie jedes andere Element.
fn textarea() -> u64 {
    if ta_n >= TA_MAX {
        return 0
    }
    let t: u64 = ta_n
    ta_n = ta_n + 1
    let i: u64 = add(K_TEXTAREA, 0, 0, 0, true)
    s(i, D_VAL, t)
    ta_wd[(t) as usize] = i
    tas(t, TS_TAB, 4)
    tas(t, TS_LANG, LANG_NONE)
    tas(t, TS_WANT, 0xFFFFFFFFFFFFFFFF)
    ta_clear(t)
    return i
}

fn ta_of(i: u64) -> u64 {
    if i >= nwd || g(i, D_KIND) != K_TEXTAREA {
        return TA_MAX
    }
    return g(i, D_VAL)
}

// Den ganzen Text setzen (eine Datei oeffnen).
fn ta_text_set(i: u64, p: u64, n: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    ta_set_text(t, p, n)
    tas(t, TS_DIRTY, 0)
    tas(t, TS_UN, 0)
    tas(t, TS_UAT, 0)
    dirty_wd(i)
}

// Den ganzen Text holen (sichern). Gibt die Laenge zurueck.
fn ta_text_get(i: u64, p: u64, max: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return 0
    }
    return ta_copy_out(t, p, max)
}

fn ta_text_len(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return 0
    }
    return ta_bytes(i)
}

fn ta_leeren(i: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    ta_clear(t)
    tas(t, TS_DIRTY, 0)
    tas(t, TS_UN, 0)
    tas(t, TS_UAT, 0)
    dirty_wd(i)
}

fn ta_zeilen(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return 0
    }
    return tag(t, TS_NL)
}

// Zeile und Spalte der Marke -- fuer die Statuszeile. Beide ab 1
// gezaehlt, so wie ein Mensch zaehlt.
fn ta_zeile(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return 1
    }
    return tag(t, TS_CY) + 1
}

fn ta_spalte(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return 1
    }
    return ta_cols(t, tag(t, TS_CY), tag(t, TS_CX)) + 1
}

fn ta_geaendert(i: u64) -> bool {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return false
    }
    return tag(t, TS_DIRTY) != 0
}

fn ta_sauber(i: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    tas(t, TS_DIRTY, 0)
}

// CRLF oder LF -- was beim Sichern geschrieben wird, und was beim
// Oeffnen gefunden wurde.
fn ta_eol(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return 0
    }
    return tag(t, TS_EOL)
}

fn ta_eol_set(i: u64, v: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    tas(t, TS_EOL, v)
}

// Welche Sprache eingefaerbt wird.
fn ta_lang(i: u64, lang: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    tas(t, TS_LANG, lang)
    dirty_wd(i)
}

fn ta_nurlesen(i: u64, an: bool) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    var v: u64 = 0
    if an {
        v = 1
    }
    tas(t, TS_RO, v)
}

// ZU EINER ZEILE SPRINGEN -- fuer "Gehe zu" und fuer den Treffer einer
// Suche. `spalte` ist ein OKTETTVERSATZ in der Zeile.
fn ta_gehe(i: u64, zeile: u64, spalte: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    var y: u64 = zeile
    if y >= tag(t, TS_NL) {
        y = tag(t, TS_NL) - 1
    }
    tas(t, TS_CY, y)
    tas(t, TS_CX, spalte)
    ta_clamp(t)
    ta_sel_clear(t)
    ta_follow(t)
    dirty_wd(i)
}

// EINEN BEREICH AUSWAEHLEN -- so zeigt die Suche ihren Treffer.
fn ta_waehle(i: u64, ay: u64, ax: u64, by: u64, bx: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    tas(t, TS_AY, ay)
    tas(t, TS_AX, ax)
    tas(t, TS_CY, by)
    tas(t, TS_CX, bx)
    ta_clamp(t)
    ta_follow(t)
    dirty_wd(i)
}

// Eine Zeile lesen -- die Suche geht damit durch die Datei, ohne dass
// sie den ganzen Text in einen Puffer holen muss.
fn ta_zeile_p(i: u64, y: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX || y >= tag(t, TS_NL) {
        return 0
    }
    return lg(t, y, LN_P)
}

fn ta_zeile_n(i: u64, y: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX || y >= tag(t, TS_NL) {
        return 0
    }
    return lg(t, y, LN_N)
}

// Text an der Marke einsetzen -- das Ersetzen der Suche.
fn ta_einfuegen(i: u64, p: u64, n: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    ta_push_undo(t)
    ta_insert(t, p, n)
    dirty_wd(i)
}

fn ta_hat_auswahl(i: u64) -> bool {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return false
    }
    return ta_has_sel(t)
}

fn next_focus(w: u64, rueckwaerts: bool) {
    var n: u64 = 0
    var first: u64 = MAXWD
    var letzte: u64 = MAXWD
    var before: u64 = MAXWD
    var move_to: u64 = MAXWD
    let jetzt: u64 = focus_id()
    var i: u64 = 0
    while i < nwd {
        if g(i, D_WIN) == w
            && (g(i, D_FLAGS) & (F_HIDE | F_OFF)) == 0
            && (g(i, D_FLAGS) & F_FOCUSABLE) != 0 {
            if first == MAXWD {
                first = i
            }
            letzte = i
            if i < jetzt {
                before = i
            }
            if i > jetzt && move_to == MAXWD {
                move_to = i
            }
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 {
        return
    }
    var ziel: u64 = move_to
    if rueckwaerts {
        ziel = before
        if ziel == MAXWD {
            ziel = letzte
        }
    } else if ziel == MAXWD {
        ziel = first
    }
    set_focus(ziel)
}

fn entry_erase(i: u64) -> bool {
    var a: u64 = g(i, D_B)
    var b: u64 = g(i, D_C)
    if a == b {
        return false
    }
    if a > b {
        let t: u64 = a
        a = b
        b = t
    }
    let p: u64 = g(i, D_TEXT)
    let n: u64 = tlen(p)
    var k: u64 = b
    while k <= n {
        __mmio_write8((p + a + (k - b)) as *mut u8,
            __mmio_read8((p + k) as *mut u8))
        k = k + 1
    }
    s(i, D_B, a)
    s(i, D_C, a)
    return true
}

fn entry_insert(i: u64, c: u64) {
    let p: u64 = g(i, D_TEXT)
    entry_erase(i)
    var n: u64 = tlen(p)
    if n + 1 >= g(i, D_D) {
        return
    }
    let at: u64 = g(i, D_B)
    var k: u64 = n + 1
    while k > at {
        __mmio_write8((p + k) as *mut u8, __mmio_read8((p + k - 1) as *mut u8))
        k = k - 1
    }
    __mmio_write8((p + at) as *mut u8, c as u8)
    s(i, D_B, at + 1)
    s(i, D_C, at + 1)
}

// RUNDE I18N: die Laenge des Zeichens, das bei `at` beginnt. Steht
// `at` auf einer Fortsetzung -- was nach dieser Runde nicht mehr
// vorkommen soll --, kommt 1 heraus, und der Zeiger bewegt sich
// wenigstens.
fn cp_len(p: u64, n: u64, at: u64) -> u64 {
    let l: u64 = utf8.seq_len(p, n, at)
    if l == 0 {
        return 1
    }
    return l
}

// Ist dieses OKTETT eines, das in ein Textfeld gehoert? Bis Runde I18N
// hiess das `c >= 32 && c < 127` -- reines ASCII, und jedes Oktett
// eines Umlauts (0xC3, 0xB6) fiel stillschweigend weg. Jetzt: alles ab
// 32 ausser 127. Die Oktette einer Mehr-Oktett-Folge kommen von der
// Tastatur NACHEINANDER und landen dadurch nebeneinander im Feld --
// genau die Folge, die `utf8.next` beim Zeichnen wieder zusammensetzt.
fn druckbar(c: u64) -> bool {
    return c >= 32 && c != 127 && c < 256
}

fn entry_key(i: u64, k: u64) {
    let p: u64 = g(i, D_TEXT)
    let n: u64 = tlen(p)
    // RUNDE I18N: DIE EINFUEGEMARKE SPRINGT UEBER ZEICHEN, NICHT UEBER
    // OKTETTE. `D_B` und `D_C` bleiben OKTETTVERSATZE -- alles andere
    // hier rechnet damit, und `entry_x` misst damit --, aber sie stehen
    // ab jetzt IMMER auf einer Zeichengrenze. Der Pfeil nach links geht
    // sonst mitten in einen Umlaut hinein, und die naechste Taste
    // zerteilt ihn.
    if k == KEY_LEFT {
        s(i, D_B, wlibc.back(p, g(i, D_B)))
        s(i, D_C, g(i, D_B))
    } else if k == KEY_RIGHT {
        if g(i, D_B) < n {
            s(i, D_B, g(i, D_B) + cp_len(p, n, g(i, D_B)))
        }
        s(i, D_C, g(i, D_B))
    } else if k == KEY_HOME {
        s(i, D_B, 0)
        s(i, D_C, 0)
    } else if k == KEY_END {
        s(i, D_B, n)
        s(i, D_C, n)
    } else if k == KEY_BS || k == 127 {
        // GANZ ZURUECK, NICHT EIN OKTETT ZURUECK. Ein Rueckschritt, der
        // ein Oktett loescht, laesst von einem Umlaut die erste Haelfte
        // stehen -- eine kaputte Folge, die als Ersatzzeichen erscheint
        // und beim naechsten Rueckschritt noch eine haesslichere ergibt.
        if !entry_erase(i) {
            if g(i, D_B) > 0 {
                let at: u64 = wlibc.back(p, g(i, D_B))
                let weg: u64 = g(i, D_B) - at
                var q: u64 = at
                while q + weg <= n {
                    __mmio_write8((p + q) as *mut u8,
                        __mmio_read8((p + q + weg) as *mut u8))
                    q = q + 1
                }
                s(i, D_B, at)
                s(i, D_C, at)
            }
        }
    } else if k == KEY_DEL {
        if !entry_erase(i) {
            if g(i, D_B) < n {
                let weg2: u64 = cp_len(p, n, g(i, D_B))
                var q2: u64 = g(i, D_B)
                while q2 + weg2 <= n {
                    __mmio_write8((p + q2) as *mut u8,
                        __mmio_read8((p + q2 + weg2) as *mut u8))
                    q2 = q2 + 1
                }
            }
        }
    } else if k == 1 {
        // STRG-A: alles auswaehlen
        s(i, D_C, 0)
        s(i, D_B, n)
    } else if k == 3 || k == 24 {
        // STRG-C / STRG-X
        var a: u64 = g(i, D_B)
        var b: u64 = g(i, D_C)
        if a > b {
            let t: u64 = a
            a = b
            b = t
        }
        if b > a {
            wlibc.clip_put(p + a, b - a)
            if k == 24 {
                entry_erase(i)
            }
        }
    } else if k == 22 {
        // STRG-V
        var ein: [u8; 128] = [0 as u8; 128]
        let m: u64 = wlibc.clip_take((&ein[0 as usize]) as u64, 127)
        var q3: u64 = 0
        while q3 < m {
            let c: u64 = (ein[(q3) as usize]) as u64
            if druckbar(c) {
                entry_insert(i, c)
            }
            q3 = q3 + 1
        }
    } else if druckbar(k) {
        entry_insert(i, k)
    }
    dirty_wd(i)
}

// ================================================== RUNDE ECHTHARDWARE-3
// EINE TASTE VON AUSSEN EINSPEISEN.
//
// `wlib.step` holt die Ereignisse fuer die Fenster, die DIESE
// Bibliothek angelegt hat. Die Taskleiste und der Schreibtisch fuehren
// aber ihre EIGENE Ereignisschleife (sie holen `WM_EVENT` auf ihr
// eigenes Fenster ab) und riefen `step` nie -- damit hatte eine Taste,
// die an eines dieser beiden Fenster ging, keinen Weg mehr hierher und
// wurde verworfen. Genau das war Justins "Tippen kommt nicht an".
//
// Wer seine Ereignisse selbst abholt, reicht die Taste hier herein.
// Das Ziel sucht `on_key` wie sonst auch: ein offener Dialog zuerst,
// dann ein offenes Menue, sonst das angegebene Fenster.
fn feed_key(c: u64) {
    on_key(wncur, c)
}

// ==================================================== RUNDE GUI-EDITOR
//
// EINE TASTE MIT MODIFIKATOR EINSPEISEN -- OHNE DEN UMWEG UEBER DIE
// FLUCHTFOLGE.
//
// `feed_key` schickt ein OKTETT durch `decode`; eine Taste wie
// `Umschalt+Pfeil rechts` besteht dort aus sechs Oktetten
// (`ESC [ 1 ; 2 C`), und wer sie einspeisen will, muesste sie
// buchstabieren. Das ist fuer einen Pruefstand nicht falsch, aber es
// misst dann die Fluchtfolge mit.
//
// Hier wird die schon FERTIGE Tastennummer mit ihrem Modifikator
// eingesetzt -- derselbe Zustand, den `decode` am Ende einer Folge
// herstellt. `key_shift()` und `key_ctrl()` sehen danach dasselbe wie
// bei einer echten Taste.
//
// `m` ist die Zahl von xterm: 0 = nichts, 2 = Umschalt, 5 = Strg,
// 6 = beide.
fn feed_key_mod(k: u64, m: u64) {
    s_keymod = m
    key_handle(wncur, k)
}

fn on_key(wein: u64, c: u64) {
    let k: u64 = decode(c)
    if k == 0 {
        return
    }
    key_handle(wein, k)
}

// ============================================== RUNDE ECHTHARDWARE-4
// EINE EINZELNE FLUCHTTASTE MUSS AUCH ALLEIN ANKOMMEN.
//
// GEMESSEN an menue-2560/serial.txt dieser Runde: das Drehbuch
// drueckte Escape, auf der Leitung stand `key: ^[`, und das Startmenue
// blieb offen. `decode` sieht die 27, setzt `s_esc = 1` und gibt NULL
// zurueck -- sie wartet auf das zweite Oktett, denn `^[[A` (Pfeil
// hoch) faengt genauso an. Kommt kein zweites, wartet sie fuer immer.
// In einem Terminal fiele das kaum auf; hier ist es der Normalfall,
// denn dieser Kern liefert die Flucht als EINZELNES Oktett
// (kernel/kbd.fi, Abtastcode 1).
//
// Die Loesung, die jedes Terminal seit jeher benutzt: eine Frist. Sie
// heisst hier nicht "Millisekunden", sondern "das Ereignisbuendel ist
// leer" -- `step` holt alle anstehenden Ereignisse in einem Zug ab,
// und was nach dem letzten davon noch offen ist, war allein.
fn esc_spuelen(w: u64) {
    if s_esc != 1 {
        return
    }
    s_esc = 0
    key_handle(w, KEY_ESC)
}

fn key_handle(wein: u64, k: u64) {
    s_keylast = k
    s_keyseq = s_keyseq + 1
    // RUNDE ALLTAG: EIN DIALOG IST MODAL, AUCH FUER DIE TASTATUR.
    //
    // Der Fensterserver schickt die Taste an das Fenster mit dem
    // Fokus, und das ist nach `dlg_ask` weiterhin das Hauptfenster --
    // der Dialog ist gerade erst entstanden und noch nicht angeklickt
    // worden. Also landete jede Taste bei der Tabelle darunter, und
    // ein Dialog liess sich mit der Eingabetaste nicht schliessen
    // (gemessen mit `sendkey ret`). Solange einer offen ist, gehoert
    // die Tastatur ihm.
    var w: u64 = wein
    if dl_win != 0xFFFFFFFFFFFFFFFF && ng(dl_win, N_H) != 0 {
        w = dl_win
    } else if mn_win != 0xFFFFFFFFFFFFFFFF && ng(mn_win, N_H) != 0 {
        w = mn_win
    }
    if ng(w, N_KIND) == NK_MENU {
        let zh: u64 = ng(w, N_CNT)
        if k == KEY_DOWN && ng(w, N_VAL) < zh {
            ns(w, N_VAL, ng(w, N_VAL) + 1)
            dirty_all(w)
        } else if k == KEY_UP && ng(w, N_VAL) > 1 {
            ns(w, N_VAL, ng(w, N_VAL) - 1)
            dirty_all(w)
        } else if k == KEY_ENTER && ng(w, N_VAL) > 0 {
            fire(ng(w, N_OWNER), K_MENUBAR, ng(w, N_VAL) - 1, w)
        } else if k == KEY_ESC {
            ns(w, N_VAL, 0)
            fire(ng(w, N_OWNER), K_MENUBAR, 0xFFFF, w)
        }
        return
    }
    // EIN DIALOG HAT ZWEI TASTEN, und beide muessen ohne Maus gehen:
    // Eingabe ist "ja", Flucht ist "nein". Sein Textfeld bekommt alles
    // andere -- der Fokus liegt nach `dlg_open` darauf, nach `dlg_ask`
    // gibt es keines.
    if ng(w, N_KIND) == NK_DLG {
        if k == KEY_ENTER {
            fire(dl_ok, K_BUTTON, 0, w)
            return
        }
        if k == KEY_ESC {
            fire(dl_no, K_BUTTON, 0, w)
            return
        }
        if dl_ent < MAXWD {
            entry_key(dl_ent, k)
        }
        return
    }
    if k == KEY_TAB {
        next_focus(w, false)
        return
    }
    let i: u64 = focus_id()
    if i >= MAXWD || g(i, D_WIN) != w {
        return
    }
    let kind: u64 = g(i, D_KIND)
    if kind == K_ENTRY {
        if k == KEY_ENTER {
            fire(i, K_ENTRY, 0, w)
            return
        }
        entry_key(i, k)
        return
    }
    // RUNDE GUI-EDITOR: das mehrzeilige Feld nimmt die Eingabetaste
    // SELBST (sie macht eine neue Zeile) -- anders als das einzeilige,
    // bei dem sie das Ereignis ausloest.
    if kind == K_TEXTAREA {
        ta_key(i, k)
        return
    }
    if kind == K_CANVAS {
        lw_push(i, LE_KEY, k, 0)
        return
    }
    if kind == K_BUTTON {
        if k == KEY_ENTER || k == 32 {
            fire(i, K_BUTTON, 0, w)
        }
        return
    }
    if kind == K_TILE {
        if k == KEY_ENTER || k == 32 {
            fire(i, K_TILE, 0, w)
        }
        return
    }
    if kind == K_CHECK {
        if k == KEY_ENTER || k == 32 {
            s(i, D_VAL, 1 - g(i, D_VAL))
            dirty_wd(i)
            fire(i, K_CHECK, g(i, D_VAL), w)
        }
        return
    }
    // RUNDE TON-2: der Regler an der Tastatur. Links/rechts eine
    // Stufe, Pos1/Ende an die Enden -- dieselben Tasten, die jedes
    // andere System dafuer nimmt, und die einzige Art, ihn ohne Maus
    // zu bedienen.
    if kind == K_SLIDER {
        var v: u64 = g(i, D_VAL)
        let schritt: u64 = g(i, D_A)
        var neu: u64 = v
        if k == KEY_LEFT || k == KEY_DOWN {
            neu = sub(v, schritt)
        } else if k == KEY_RIGHT || k == KEY_UP {
            neu = v + schritt
            if neu > 100 {
                neu = 100
            }
        } else if k == KEY_HOME {
            neu = 0
        } else if k == KEY_END {
            neu = 100
        } else {
            return
        }
        if neu != v {
            s(i, D_VAL, neu)
            dirty_wd(i)
            fire(i, K_SLIDER, neu, w)
        }
        return
    }
    if kind == K_LIST || kind == K_TABLE {
        var int: u64 = g(i, D_A)
        if kind == K_TABLE {
            int = sub(int, 1)
        }
        if int == 0 {
            return
        }
        var v: u64 = g(i, D_VAL)
        if k == KEY_DOWN && v + 1 < int {
            v = v + 1
        } else if k == KEY_UP && v > 0 {
            v = v - 1
        } else if k == KEY_HOME {
            v = 0
        } else if k == KEY_END {
            v = int - 1
        } else if k == KEY_PGDN {
            v = imin(v + 10, int - 1)
        } else if k == KEY_PGUP {
            v = sub(v, 10)
        } else if k == KEY_ENTER {
            fire(i, K_LIST, v, w)
            return
        } else {
            return
        }
        s(i, D_VAL, v)
        scroll_to(i, v)
        dirty_wd(i)
        return
    }
    if kind == K_TABS {
        if k == KEY_RIGHT && tab_width(i, g(i, D_VAL) + 1) != 0 {
            s(i, D_VAL, g(i, D_VAL) + 1)
            dirty_wd(i)
            fire(i, K_TABS, g(i, D_VAL), w)
        } else if k == KEY_LEFT && g(i, D_VAL) > 0 {
            s(i, D_VAL, g(i, D_VAL) - 1)
            dirty_wd(i)
            fire(i, K_TABS, g(i, D_VAL), w)
        }
        return
    }
    if kind == K_CHOICE {
        if k == KEY_ENTER || k == 32 {
            fire(i, K_CHOICE, 0x1000, w)
        }
        return
    }
}

// ==================================================================
// MENUES UND DIALOGE
//
// BEIDE SIND EIGENE FENSTER BEIM SERVER, und das ist keine Notloesung,
// sondern die einzige richtige Antwort in diesem System: ein
// Kontextmenue, das in das Fenster gemalt wird, endet an dessen Rand.
// Ein Menue am unteren Rand einer Liste waere abgeschnitten. Der
// Fensterserver hat Fenster, also bekommt ein Menue eines.
//
// WAS DAS GEKOSTET HAT, BIS RUNDE EXPLORER-2: ein Menue trug die
// Titelleiste und den Rahmen jedes gewoehnlichen Fensters
// (`kernel/wm.fi` malt sie). Im Bild 11-menue-gehezu.png stand ueber
// den drei Eintraegen "Me - [] X" -- ein Aufklappmenue mit
// Schliessknopf, das kein Mensch so kennt.
//
// DIE ANTWORT WAR SCHON DA: `WS_DECO 0` (kernel/sysgui.fi ~884 ->
// wm.set_deco). Der Schreibtisch und die Taskleiste benutzen es seit
// Runde DESKTOP, und es ist NICHT der Wurzel vorbehalten -- nur die
// Ebene ist es. Ein Menue schaltet den Schmuck also ab wie sie, und
// weil der Ursprung der Malflaeche danach ein anderer ist, wird er
// mit `say_window` erneut gemeldet.

static mut mn_win: u64 = 0xFFFFFFFFFFFFFFFF
static mut mn_res: u64 = 0xFFFFFFFFFFFFFFFF

fn menu_open(owner: u64, sx: u64, sy: u64, items: u64, n: u64) -> u64 {
    if mn_win != 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    // ROUND LOOK, THIRD ADDENDUM: THIS TITLE IS DRAWN.
    //
    // A menu window carries a 22-pixel title bar (tools/k15/run.sh
    // computes its rows as MNY + TITLE + 15), so this string is on the
    // screen -- and it sat here in German, hardcoded, in the widget
    // library. `tools/i18n/scan.py` never saw it: it said "Menue", and
    // "Menue" was not in that scanner's word list.
    //
    // wlib cannot read the catalogue itself. It is linked into all
    // thirteen programs, and pulling `msg` in here would put a
    // catalogue into `sh` and `ls` as well -- on a disk that ran out of
    // room in this very round. So the LIBRARY carries the untranslated
    // English, exactly as msg.fi does for a missing key, and a program
    // that has a catalogue hands the translation down with
    // `set_menu_title`.
    var titel: [u8; 6] = "Menu\0\0"
    var tp: u64 = (&titel[0 as usize]) as u64
    if mn_titel != 0 {
        tp = mn_titel
    }
    let zh: u64 = lines_height() + 2
    var bw: u64 = 60
    var k: u64 = 0
    while k < n {
        let q: u64 = row_at(items, k)
        if q != 0 {
            let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), q,
                row_len(q)) + 24
            if tw > bw {
                bw = tw
            }
        }
        k = k + 1
    }
    // DIE HOEHE IST DIE DER EINTRAEGE, und seit dieser Runde ist sie
    // auch die des FENSTERS: ein Menue traegt keine Titelleiste mehr
    // (siehe unten, WS_DECO). Was `n` sagt, steht also wirklich da --
    // 11-menue-gehezu.png zeigte drei von sechs Eintraegen, weil die
    // Zahl von aussen fest getippt war und nicht aus dem Katalog kam.
    let bh: u64 = n * zh + 4
    // Ein Menue, das unten aus dem Bild laeuft, klappt nach oben auf --
    // deshalb kennt diese Bibliothek die Bildschirmgroesse. OHNE
    // Titelleiste sind es genau `bh` Bildpunkte und nicht bh + 24.
    var y: u64 = sy
    if y + bh + 4 > wlibc.screen_h() {
        y = sub(sy, bh + 4)
    }
    var x: u64 = sx
    if x + bw + 4 > wlibc.screen_w() {
        x = sub(wlibc.screen_w(), bw + 4)
    }
    let w: u64 = new_win(x, y, bw, bh, tp, NK_MENU)
    // ================================== RUNDE EXPLORER-2, ZWEITE RUNDE
    //
    // EIN AUFKLAPPMENUE IST KEIN FENSTER MIT KNOEPFEN. Bis hierher war
    // es genau das: `new_win` legt ein gewoehnliches Fenster an, und
    // `kernel/wm.fi` malt jedem gewoehnlichen Fenster Rahmen,
    // Titelleiste und die drei Knoepfe rechts oben. Im Bild
    // (11-menue-gehezu.png) stand ueber "Liste / Symbole / Nach Name"
    // eine Leiste mit "Me - [] X" -- ein Menue zum Zuklappen und
    // Maximieren. Der Kopf dieser Datei hat das seit Runde K15 als
    // offenen Punkt gefuehrt; der Server kann es laengst, es hat nur
    // niemand gesagt: `WS_DECO 0`, derselbe Weg, den `window_plain`
    // fuer die Taskleiste geht. Danach ist die Malflaeche das ganze
    // Fenster, weshalb der Ursprung noch einmal gemeldet wird.
    if w < MAXWN {
        let _wd: u64 = wlibc.win_state(ng(w, N_H), wlibc.WS_DECO, 0)
        // =============================== RUNDE ECHTHARDWARE-3
        // EIN MENUE LIEGT AUF DER MENUEEBENE, und nicht dort, wo
        // gerade Platz ist.
        //
        // Justins Befund: der Rechtsklick auf ein Leistensymbol
        // oeffnete ein ECHTES Fenster mit Minimieren/Maximieren/X.
        // Der Schmuck ist oben abgeschaltet; was fehlte, war die
        // EBENE. `taskbar.fi` hat sich damit beholfen, das Menue
        // hinterher von Hand auf L_TOP zu legen -- also auf DIESELBE
        // Ebene wie die Leiste, und dann entschied die Reihenfolge.
        // Jetzt hat das Menue eine eigene Ebene ueber der Leiste und
        // ueber dem Startmenue, und niemand muss mehr nachhelfen.
        let _wl: u64 = wlibc.win_state(ng(w, N_H), wlibc.WS_LAYER,
            wlibc.L_POPUP)
        // Ein Menue will die Tastatur: hoch/runter/Eingabe/Flucht.
        let _wk: u64 = wlibc.win_state(ng(w, N_H), wlibc.WS_KEYS, 1)
        say_window(w)
    }
    // RUNDE DESIGN-2: das Menue klappt auf. Ganzes Fenster, also
    // MAXWD als Widget -- `anim_tick` macht daraus `dirty_all`.
    let _a4: u64 = anim_start(AN_MENU, w, MAXWD, wlibc.MO_FAST,
        EASE_OUT)
    if w >= MAXWN {
        return MAXWN
    }
    ns(w, N_DATA, items)
    ns(w, N_CNT, n)
    ns(w, N_VAL, 0)
    ns(w, N_OWNER, owner)
    mn_win = w
    mn_res = 0xFFFFFFFFFFFFFFFF
    dirty_all(w)
    return w
}

// Was gewaehlt wurde. 0xFFFF heisst abgebrochen, 0xFFFFFFFF... heisst
// "noch offen".
fn menu_at() -> u64 {
    return mn_res
}

fn menu_close() {
    if mn_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    close(mn_win)
    // Der Platz wird wieder frei: ein Programm, das zwanzig Menues
    // aufklappt, soll nicht nach vier stehenbleiben.
    if mn_win + 1 == nwn {
        nwn = nwn - 1
    }
    mn_win = 0xFFFFFFFFFFFFFFFF
}

static mut dl_win: u64 = 0xFFFFFFFFFFFFFFFF
static mut dl_state: u64 = 0
static mut dl_ok: u64 = 0
static mut dl_no: u64 = 0
static mut dl_ent: u64 = MAXWD
static mut dl_lbl: u64 = 0

fn dlg_text() -> u64 {
    return (&dlgbuf[0 as usize]) as u64
}

// 0 = keiner offen, 1 = offen, 2 = bestaetigt, 3 = abgebrochen
fn dlg_state() -> u64 {
    return dl_state
}

fn dlg_open(titel: u64, ask: u64, anfang: u64) -> u64 {
    return dlg_new(titel, ask, anfang, true)
}

fn dlg_ask(titel: u64, ask: u64) -> u64 {
    return dlg_new(titel, ask, 0, false)
}

// Die Beschriftungen der beiden Knoepfe liegen STATISCH, und der
// Uebersetzer besteht darauf: `button` behaelt den Zeiger ueber das
// Ende von `dlg_new` hinaus, und ein Zeiger in einen abgeraeumten
// Rahmen waere genau die Sorte Fehler, die man erst im Bild sieht.
static mut d_ok: [u8; 3] = "OK\0"
static mut d_ja: [u8; 3] = "Ja\0"
static mut d_ab: [u8; 10] = "Abbrechen\0"
static mut d_nein: [u8; 5] = "Nein\0"

fn dlg_new(titel: u64, ask: u64, anfang: u64, mit_feld: bool) -> u64 {
    if dl_win != 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    // RUNDE EXPLORER-2, Beleg 30-dialog-neuer-ordner.png: DIE HOEHE WIRD
    // GERECHNET UND NICHT GETIPPT. Hier standen 108 und 84 -- Zahlen aus
    // einem Formsatz mit 26 Bildpunkt hohen Knoepfen. Unter `shape=osum`
    // ist die Klickflaeche 32 hoch, und damit lag die Knopfreihe genau
    // auf dem unteren Rahmen: OK und Abbrechen waren angeschnitten.
    // Jetzt ist die Hoehe die Summe dessen, was hineingesetzt wird --
    // Rand, Frage, (Feld), Luft, Knopfreihe, Rand --, und zwar mit
    // DERSELBEN Aufrundung (`r4auf`), die `place` gleich darauf
    // anwendet. Wer eine der Marken aendert, aendert die Hoehe mit.
    let bw: u64 = 340
    let d_pad: u64 = 12  // der Rand des Dialogs
    let d_luft: u64 = 10 // zwischen Frage, Feld und Knopfreihe
    let d_th: u64 = r4auf(wlibc.text_h(wlibc.px_ui()))
    let d_ch: u64 = r4auf(wlibc.metric(wlibc.M_CTRL_H))
    let d_kh: u64 = r4auf(wlibc.metric(wlibc.M_CTRL_H) + 2)
    var d_inhalt: u64 = d_th + d_luft
    if mit_feld {
        d_inhalt = d_inhalt + d_ch + d_luft
    }
    let bh: u64 = d_pad + d_inhalt + d_kh + d_pad
    let x: u64 = sub(wlibc.screen_w(), bw) / 2
    let y: u64 = sub(wlibc.screen_h(), bh) / 2
    let w: u64 = new_win(x, y, bw, bh, titel, NK_DLG)
    if w >= MAXWN {
        return MAXWN
    }
    dl_win = w
    dl_state = 1
    var i: u64 = 0
    while i < 160 {
        dlgbuf[(i) as usize] = 0 as u8
        i = i + 1
    }
    if anfang != 0 {
        ulib.strncpy((&dlgbuf[0 as usize]) as u64, anfang, 158)
    }
    box_v(w, 0, 0, bw, bh, d_pad, d_luft)
    size(0, wlibc.text_h(wlibc.px_ui()))
    dl_lbl = label(ask)
    dl_ent = MAXWD
    if mit_feld {
        size(0, wlibc.metric(wlibc.M_CTRL_H))
        dl_ent = entry((&dlgbuf[0 as usize]) as u64, 158)
        set_focus(dl_ent)
    }
    let unten: u64 = cg(ctcur, C_CY)
    box_end()
    // DIE KNOPFREIHE: zwei Knoepfe, EIN fester Abstand dazwischen
    // (`M_GAP`), und die Reihe steht mit dem Rand des Dialogs buendig.
    // 220/208/30 waren drei Zahlen, die keine Marke kannte -- bei einem
    // breiteren Knopf standen die beiden aufeinander.
    let d_kluft: u64 = wlibc.metric(wlibc.M_GAP)
    let d_kw: u64 = dlg_btn_w()
    let d_reihe: u64 = d_kw * 2 + d_kluft
    box_h(w, sub(bw, d_reihe + d_pad), unten, d_reihe, d_kh, 0, d_kluft)
    size(dlg_btn_w(), wlibc.metric(wlibc.M_CTRL_H) + 2)
    if mit_feld {
        dl_ok = button((&d_ok[0 as usize]) as u64)
    } else {
        dl_ok = button((&d_ja[0 as usize]) as u64)
    }
    size(dlg_btn_w(), wlibc.metric(wlibc.M_CTRL_H) + 2)
    if mit_feld {
        dl_no = button((&d_ab[0 as usize]) as u64)
    } else {
        dl_no = button((&d_nein[0 as usize]) as u64)
    }
    box_end()
    dirty_all(w)
    return w
}

// ================================== RUNDE EXPLORER-2, ZWEITE RUNDE
//
// EIN DIALOG MIT MEHR ALS ZWEI ANTWORTEN -- und der Grund dafuer ist
// Pflichtpunkt 2: trifft "Einfuegen" oder "Umbenennen" auf einen
// bestehenden Namen, hat der Mensch VIER Antworten (Ersetzen,
// Umbenennen, Ueberspringen, Abbrechen). Ein Ja/Nein-Dialog kann diese
// Frage nicht stellen, und zwei hintereinander waeren zwei Fragen.
//
// DIE BESCHRIFTUNGEN KOMMEN VON AUSSEN, als ein Block mit
// Zeilenumbruechen -- genau die Form, in der der Katalog
// (`explorer.conflict.buttons`) sie haelt. Diese Bibliothek hat keinen
// Katalog (Begruendung bei `menu_open`), also uebersetzt sie nichts;
// sie kopiert die Zeilen in einen STATISCHEN Puffer, denn `button`
// behaelt den Zeiger ueber das Ende dieser Funktion hinaus.
const DLG_MAXB: u64 = 4
static mut dl_btn: [u64; 4] = [0 as u64; 4]
static mut dl_nb: u64 = 0
static mut dl_wahl: u64 = 0xFFFF
static mut dw_buf: [u8; 256] = [0 as u8; 256]
static mut dw_off: [u64; 4] = [0 as u64; 4]

// Welcher der Knoepfe es war -- 0 ist der erste. 0xFFFF heisst "noch
// keiner"; nach `dlg_state() == 2` steht hier die Antwort.
fn dlg_wahl_at() -> u64 {
    return dl_wahl
}

// EIN HINWEISFENSTER: eine Aussage, ein Knopf. Fuer jede Meldung, die
// nichts fragt -- zum Beispiel den Fehlschlag einer Dateioperation, der
// nach Pflichtpunkt 8 NIE stumm bleiben darf.
fn dlg_hinweis(titel: u64, ask: u64) -> u64 {
    return dlg_wahl(titel, ask, 0, 1)
}

fn dlg_wahl(titel: u64, ask: u64, block: u64, n: u64) -> u64 {
    if dl_win != 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    var nk: u64 = n
    if nk == 0 {
        nk = 1
    }
    if nk > DLG_MAXB {
        nk = DLG_MAXB
    }
    // Die Beschriftungen in den statischen Puffer, jede mit ihrem
    // Nullzeichen dahinter.
    var p: u64 = 0
    var i: u64 = 0
    while i < nk {
        dw_off[(i) as usize] = p
        let q: u64 = row_at(block, i)
        if q != 0 {
            let l: u64 = row_len(q)
            var k: u64 = 0
            while k < l && p < 250 {
                dw_buf[(p) as usize] = __mmio_read8((q + k) as *mut u8)
                p = p + 1
                k = k + 1
            }
        }
        dw_buf[(p) as usize] = 0 as u8
        p = p + 1
        i = i + 1
    }
    // Die Masse wie bei `dlg_new`: alles aus Marken, nichts getippt.
    let d_pad: u64 = 12
    let d_luft: u64 = 10
    let d_th: u64 = r4auf(wlibc.text_h(wlibc.px_ui()))
    let d_kh: u64 = r4auf(wlibc.metric(wlibc.M_CTRL_H) + 2)
    let d_kluft: u64 = wlibc.metric(wlibc.M_GAP)
    let d_kw: u64 = dlg_btn_w()
    let d_reihe: u64 = d_kw * nk + d_kluft * sub(nk, 1)
    var bw: u64 = 340
    if d_reihe + 2 * d_pad > bw {
        bw = d_reihe + 2 * d_pad
    }
    let bh: u64 = d_pad + d_th + d_luft + d_kh + d_pad
    let x: u64 = sub(wlibc.screen_w(), bw) / 2
    let y: u64 = sub(wlibc.screen_h(), bh) / 2
    let w: u64 = new_win(x, y, bw, bh, titel, NK_DLG)
    if w >= MAXWN {
        return MAXWN
    }
    dl_win = w
    dl_state = 1
    dl_wahl = 0xFFFF
    dl_nb = nk
    dl_ent = MAXWD
    box_v(w, 0, 0, bw, bh, d_pad, d_luft)
    size(0, wlibc.text_h(wlibc.px_ui()))
    dl_lbl = label(ask)
    let unten: u64 = cg(ctcur, C_CY)
    box_end()
    box_h(w, sub(bw, d_reihe + d_pad), unten, d_reihe, d_kh, 0, d_kluft)
    i = 0
    while i < nk {
        var txt: u64 = (&d_ok[0 as usize]) as u64
        if block != 0 {
            txt = (&dw_buf[0 as usize]) as u64 + dw_off[(i) as usize]
        }
        size(d_kw, wlibc.metric(wlibc.M_CTRL_H) + 2)
        dl_btn[(i) as usize] = button(txt)
        i = i + 1
    }
    box_end()
    // `dlg_button(0)`/`(1)` melden weiterhin die zwei ersten Knoepfe --
    // `say_dlgrect` misst darueber, und ein Testlaeufer soll auch
    // diesen Dialog treffen koennen.
    dl_ok = dl_btn[(0) as usize]
    dl_no = dl_btn[(0) as usize]
    if nk > 1 {
        dl_no = dl_btn[(sub(nk, 1)) as usize]
    }
    dirty_all(w)
    return w
}

fn dlg_close() {
    if dl_win == 0xFFFFFFFFFFFFFFFF {
        return
    }
    dl_nb = 0
    close(dl_win)
    if dl_win + 1 == nwn {
        nwn = nwn - 1
    }
    dl_win = 0xFFFFFFFFFFFFFFFF
    dl_state = 0
    // Die Widgets des Dialogs sind verborgen; ihre Plaetze werden
    // wieder frei, wenn sie am Ende der Tafel liegen.
    while nwd > 0 && (g(nwd - 1, D_FLAGS) & F_HIDE) != 0 {
        nwd = nwd - 1
    }
    if s_focus != 0 && s_focus - 1 >= nwd {
        s_focus = 0
        var i: u64 = 0
        while i < nwd {
            if (g(i, D_FLAGS) & F_FOCUSABLE) != 0 && s_focus == 0 {
                s_focus = i + 1
            }
            i = i + 1
        }
    }
}

// ==================================================================
// DIE EREIGNISSCHLEIFE
//
// EIN Aufruf holt die Ereignisse ALLER Fenster ab, verteilt sie, malt
// nach, was schmutzig geworden ist, und gibt die Nummer des Widgets
// zurueck, bei dem etwas passiert ist -- oder MAXWD.
//
// SIE GIBT DIE MASCHINE HER, wenn nichts anliegt. Das steht hier, weil
// Runde K10 genau daran gescheitert ist: eine Warteschleife, die nicht
// abgibt, laesst die andere Aufgabe nicht laufen, und im
// Bildschirmfoto fehlt dann etwas, ohne dass irgendwo ein Fehler steht.

// ================================================== RUNDE THEME
//
// DAS UMSCHALTEN ZUR LAUFZEIT, VON DER SEITE DES FENSTERS AUS.
//
// Ein Programm mit dieser Bibliothek muss dafuer NICHTS tun: `step()`
// sieht zehnmal in der Sekunde nach, ob sich die aufgeloesten Marken
// geaendert haben, und wenn ja, ist alles schmutzig. Zehnmal und nicht
// bei jedem Durchlauf, weil ein Nachsehen drei Dateien liest und den
// ganzen Satz neu aufloest; die Verzoegerung, die das kostet, steht
// gemessen in docs/ROUNDTHEME.md und wird nicht kleingeredet.
const THEME_POLL_TICKS: u64 = 25

fn theme_watch() -> bool {
    let t: u64 = ticks()
    if t < s_thpoll + THEME_POLL_TICKS {
        return false
    }
    s_thpoll = t
    s_thpolls = s_thpolls + 1
    if !wlibc.theme_poll() {
        return false
    }
    s_thswitch = s_thswitch + 1
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            dirty_all(w)
        }
        w = w + 1
    }
    return true
}

// Sofort nachsehen, ohne auf den Takt zu warten. Der Testlaeufer
// braucht das, um eine Zeit zu messen, in der kein Warten steckt.
fn theme_now() -> bool {
    s_thpoll = 0
    return theme_watch()
}

fn theme_switches() -> u64 {
    return s_thswitch
}

fn theme_polls() -> u64 {
    return s_thpolls
}

fn theme_pixels() -> u64 {
    return s_thpx
}

fn theme_stales() -> u64 {
    return s_thstale
}

// Alle Fenster neu malen und die Flaeche zurueckgeben. EINE Stelle,
// damit die Zahl aus der Messung und die Zahl aus dem Betrieb dieselbe
// Rechnung sind.
fn paint_all() -> u64 {
    // RUNDE GLAS: ein Bild faengt an, also darf jeder Widgettyp seinen
    // Radius wieder einmal melden. Das ist die EINE Stelle, an der
    // wlib ein Bild beginnt -- steht der Anstoss woanders, meldet
    // entweder jeder Aufruf oder keiner.
    radius_bild()
    let before: u64 = wlibc.theme_frame_begin()
    let _v: u64 = before
    var gemalt: u64 = 0
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            gemalt = gemalt + flush_win(w)
        }
        w = w + 1
    }
    // DAS THEMA HAT SICH WAEHREND DES MALENS GEDREHT. Das Bild, das
    // gerade fertig geworden ist, ist in sich stimmig -- es hat die
    // ganze Zeit aus derselben Bank gelesen -- aber es ist nicht mehr
    // das aktuelle. Also genau EINMAL noch, mit der neuen Bank; ein
    // zweites Mal kann es nicht noetig werden, weil der naechste
    // Durchlauf wieder frisch einrastet.
    if wlibc.theme_frame_end() {
        s_thstale = s_thstale + 1
        let _v2: u64 = wlibc.theme_frame_begin()
        w = 0
        while w < nwn {
            if ng(w, N_H) != 0 {
                dirty_all(w)
                gemalt = gemalt + flush_win(w)
            }
            w = w + 1
        }
        let _e2: bool = wlibc.theme_frame_end()
    }
    return gemalt
}

fn step() -> u64 {
    s_fired = 0
    s_fkind = 0
    s_findex = 0
    s_ticks = s_ticks + 1
    var etwas: bool = false
    var w: u64 = 0
    while w < nwn {
        if ng(w, N_H) != 0 {
            var n: u64 = 0
            while n < 64 && wlibc.sys3w(wlibc.WM_EVENT, ng(w, N_H),
                (&ev[0 as usize]) as u64, 0) == 1 {
                etwas = true
                n = n + 1
                let b: u64 = (&ev[0 as usize]) as u64
                let typ: u64 = __mmio_read64((b) as *mut u64)
                let d: u64 = __mmio_read64((b + 8) as *mut u64)
                let ex: u64 = (d >> 32) & 0xFFFF
                let ey: u64 = (d >> 16) & 0xFFFF
                let btn: u64 = d & 0xFFFF
                if typ == wlibc.EV_DOWN {
                    on_down(w, ex, ey, btn)
                } else if typ == wlibc.EV_UP {
                    on_up(w, ex, ey)
                } else if typ == wlibc.EV_MOVE {
                    on_move(w, ex, ey, btn)
                } else if typ == wlibc.EV_KEY {
                    on_key(w, ex)
                } else if typ == wlibc.EV_CLOSE {
                    ns(w, N_H, 0)
                    if w == mn_win {
                        mn_res = 0xFFFF
                    } else if w == dl_win {
                        dl_state = 3
                    } else if ng(w, N_KIND) == NK_MAIN {
                        s_alive = 0
                    }
                } else if typ == wlibc.EV_RESIZE {
                    ns(w, N_W, ex)
                    ns(w, N_HH, ey)
                    relayout()
                    dirty_all(w)
                    s_reseq = s_reseq + 1
                }
            }
            // RUNDE ECHTHARDWARE-4: das Buendel ist leer. Was von
            // einer Fluchtfolge offen blieb, war eine EINZELNE
            // Fluchttaste -- siehe `esc_spuelen`.
            esc_spuelen(w)
        }
        w = w + 1
    }
    // Ein Menue, bei dem etwas gewaehlt wurde, schliesst sich selbst --
    // ein Menue, das nach der Wahl stehenbleibt, ist keines.
    if mn_win != 0xFFFFFFFFFFFFFFFF && s_fired != 0 {
        if s_fwin == mn_win {
            mn_res = s_findex
            let besitzer: u64 = s_fired - 1
            menu_close()
            if mn_res == 0xFFFF {
                s_fired = 0
            } else {
                s_fired = besitzer + 1
                s_fkind = K_MENUBAR
                s_findex = mn_res
            }
        }
    }
    // Der Dialog: die beiden Knoepfe sind seine Antwort.
    if dl_win != 0xFFFFFFFFFFFFFFFF && s_fired != 0 {
        let i: u64 = s_fired - 1
        // RUNDE EXPLORER-2: ein Dialog mit mehr als zwei Antworten
        // (`dlg_wahl`). Welcher Knopf es war, steht in `dl_wahl`; der
        // Zustand ist "bestaetigt", denn abgebrochen wird bei diesem
        // Dialog ueber einen der Knoepfe und nicht daneben.
        var b: u64 = 0
        while b < dl_nb {
            if i == dl_btn[(b) as usize] {
                dl_wahl = b
                dl_state = 2
                s_fired = 0
            }
            b = b + 1
        }
        if dl_nb == 0 {
            if i == dl_ok {
                dl_state = 2
                s_fired = 0
            } else if i == dl_no {
                dl_state = 3
                s_fired = 0
            } else if i == dl_ent && s_fkind == K_ENTRY {
                dl_state = 2
                s_fired = 0
            }
        }
    }
    let gewechselt: bool = theme_watch()
    // RUNDE DESIGN-2: die Bewegungen VOR dem Malen weiterdrehen. Wer
    // sie danach dreht, malt jedes Zwischenbild einen Durchlauf zu
    // spaet -- bei 150 ms sind das bei zehn Bildern zehn Prozent.
    let laufend: u64 = anim_tick()
    let gemalt: u64 = paint_all()
    if gewechselt {
        s_thpx = s_thpx + gemalt
    }
    // Eine laufende Bewegung ist ETWAS. Ohne diese Zeile schlaeft die
    // Schleife mitten in einer Animation ein und das Fenster bleibt auf
    // halbem Weg stehen, bis die Maus wackelt.
    if !etwas && gemalt == 0 && laufend == 0 {
        ulib.sys(ulib.SYS_YIELD, 0, 0, 0)
    }
    if s_fired == 0 {
        return MAXWD
    }
    return s_fired - 1
}

// ==================================================================
// WAS DIE ANORDNUNG AUSGERECHNET HAT -- UND WOHIN DER TEXT KOMMT
//
// Diese acht Funktionen sind fuer die MESSUNG da und fuer nichts
// sonst. Sie geben dieselben Zahlen zurueck, mit denen `paint_*` malt
// -- nicht aehnliche, dieselben: jede steht als Ausdruck genau einmal,
// hier und dort, und wer eine der beiden aendert, macht den Testlauf
// rot statt ihn zu belegen.
//
// Ohne sie muesste ein Testlaeufer die Grundlinie eines Knopftextes
// selbst ausrechnen -- also die Anordnung nachbauen --, und dann pruefte
// er seinen eigenen Nachbau. So sagt die Anwendung, wo sie es
// hinschreibt, und der Laeufer rechnet im BILD nach, ob es dort steht.

fn rect_x(i: u64) -> u64 {
    return g(i, D_X)
}

fn rect_y(i: u64) -> u64 {
    return g(i, D_Y)
}

fn rect_w(i: u64) -> u64 {
    return g(i, D_W)
}

fn rect_h(i: u64) -> u64 {
    return g(i, D_H)
}

fn kind_of(i: u64) -> u64 {
    return g(i, D_KIND)
}

fn row_h() -> u64 {
    return lines_height()
}

// ================================================== RUNDE FUI-WIN11
// DIE ZEILENHOEHE DIESER EINEN LISTE.
//
// `lines_height()` ist die Zeilenhoehe des SYSTEMS (M_ROW) und gilt
// fuer jede Liste und jede Tabelle. Eine zweizeilige Liste braucht
// mehr -- aber nur SIE, und deshalb wird hier je Widget gefragt und
// nicht die Systemzahl veraendert.
//
// Zwei Textzeilen plus dieselbe Luft, die eine einzeilige Zeile ueber
// und unter der Schrift hat: `zh - text_h` ist genau diese Luft.
fn row_h_of(i: u64) -> u64 {
    let zh: u64 = lines_height()
    if i >= MAXWD || g(i, D_ZWEI) == 0 {
        return zh
    }
    let th: u64 = wlibc.text_h(wlibc.px_ui())
    if zh <= th {
        return 2 * zh
    }
    return 2 * th + (zh - th)
}

fn text_x(i: u64) -> u64 {
    let k: u64 = g(i, D_KIND)
    if k == K_BUTTON {
        let tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.px_ui(), g(i, D_TEXT),
            tlen(g(i, D_TEXT)))
        return g(i, D_X) + sub(g(i, D_W), tw) / 2
    }
    if k == K_ENTRY {
        return g(i, D_X) + 5
    }
    if k == K_CHECK {
        return g(i, D_X) + 20
    }
    return g(i, D_X)
}

fn text_base(i: u64) -> u64 {
    let k: u64 = g(i, D_KIND)
    let asc: u64 = wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    if k == K_LABEL {
        return g(i, D_Y) + asc
    }
    return g(i, D_Y) + (g(i, D_H) + asc) / 2
}

fn text_fg(i: u64) -> u64 {
    if (g(i, D_FLAGS) & F_OFF) != 0 {
        return wlibc.theme(wlibc.T_DIM)
    }
    return wlibc.theme(wlibc.T_FG)
}

// Die Farbe UNTER dem Text. Sie gehoert zur Messung, weil ein
// kantengeglaettetes Zeichen aus Mischungen zwischen beiden besteht --
// ohne den Hintergrund ist keine einzige Zwischenstufe nachzurechnen.
fn text_bg(i: u64) -> u64 {
    let k: u64 = g(i, D_KIND)
    if k == K_BUTTON {
        if (g(i, D_FLAGS) & F_PRESSED) != 0 {
            return wlibc.theme(wlibc.T_BTNDN)
        }
        if (g(i, D_FLAGS) & F_HOVER) != 0 {
            return wlibc.theme(wlibc.T_BTNHI)
        }
        return wlibc.theme(wlibc.T_BTN)
    }
    if k == K_ENTRY {
        return wlibc.theme(wlibc.T_ENTRY)
    }
    if k == K_CHOICE {
        return wlibc.theme(wlibc.T_BTN)
    }
    if g(i, D_WIN) < MAXWN && ng(g(i, D_WIN), N_KIND) == NK_DLG {
        return wlibc.theme(wlibc.T_DLG)
    }
    return wlibc.theme(wlibc.T_BG)
}

// Die Grundlinie der SICHTBAREN Zeile `r` einer Liste, und die Stelle,
// an der ihr Text anfaengt. Genau die Rechnung aus `paint_list`.
// ================================================ RUNDE ABBILD
// DIE GRUNDLINIE EINER ZEILE -- AN EINER STELLE.
//
// JUSTINS BEFUND, gemessen an hell-05-kontrollzentrum.png:
//
//     Balken Mitte 258,5   Symbol Mitte 258,0   Text Mitte 252,0
//
// Der Text sass 6,5 Punkte ZU HOCH. Nachgemessen an demselben Bild
// nach Runde 32: unveraendert 258,5 / 255,0 / 252,0 -- die acht
// paint_*-Umstellungen haben das nicht angefasst, weil sie die
// FLAECHEN auf fUi umgestellt haben und nicht die Schriftlage.
//
// WOHER DIE 6,5 KOMMEN. Das Symbol wurde schon in Runde
// ECHTHARDWARE-2 mittig gesetzt (`(zh - ih) / 2`, siehe paint_list).
// Der Text nicht: er stand auf `ry + ascent + 1`, also einem FESTEN
// Abstand von der Oberkante. Ein fester Abstand ist so lange richtig,
// wie Zeilenhoehe und Schriftgroesse zueinander passen; sobald die
// Zeile hoeher wird als die Schrift (M_ROW waechst mit dem Thema,
// die Schrift nicht im selben Schritt), bleibt die Schrift oben
// kleben und das Symbol wandert in die Mitte. Genau das ist der
// Abstand, den Justin gesehen hat.
//
// DIE RECHNUNG, dieselbe wie bei der Kachel (`paint_tile`, wo sie
// seit Runde THEMESTORE richtig steht): den TEXTKASTEN
// (`text_h` = Oberlaenge + Unterlaenge) in der Zeile zentrieren und
// die Grundlinie um die Oberlaenge nach unten setzen.
//
//     grund = ry + (zh - text_h) / 2 + ascent
//
// UND SIE STEHT HIER, in EINER Funktion, nicht viermal abgeschrieben:
// Liste, Tabelle, Menue und Auswahlfeld rechnen dieselbe Zeile und
// muessen dieselbe Zahl bekommen, sonst sitzt der Text in der Liste
// anders als in der Tabelle daneben.
fn row_base(i: u64, r: u64) -> u64 {
    // RUNDE FUI-WIN11: gemeldet wird die Grundlinie der ERSTEN Zeile
    // eines Eintrags -- dieselbe Rechnung wie in `paint_list`, damit
    // Bericht und Bild dieselbe Zahl nennen.
    let zh: u64 = row_h_of(i)
    if i < MAXWD && g(i, D_ZWEI) != 0 {
        let hz: u64 = zh / 2
        return g(i, D_Y) + 2 + r * zh
            + sub(hz, wlibc.text_h(wlibc.px_ui())) / 2
            + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
    }
    return g(i, D_Y) + 2 + r * zh
        + sub(zh, wlibc.text_h(wlibc.px_ui())) / 2
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
}

// Dieselbe Rechnung wie `row_base`, aber fuer die Maler, die ihre
// Zeilenoberkante `ry` schon ausgerechnet haben (Liste, Tabelle,
// Menue). EINE Stelle, damit die drei nicht auseinanderlaufen.
fn base_in_row(ry: u64, zh: u64) -> u64 {
    return ry + sub(zh, wlibc.text_h(wlibc.px_ui())) / 2
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
}

fn row_x(i: u64) -> u64 {
    return g(i, D_X) + 6 + list_in(i)
}

// Wo das Symbolplaettchen einer sichtbaren Zeile liegt.
fn icon_x(i: u64) -> u64 {
    return g(i, D_X) + 3 + 2 * wlibc.ui_scale()
}

// RUNDE ECHTHARDWARE-2: SENKRECHT MITTIG IN DER ZEILE.
//
// Hier stand `+ 3` -- ein fester Abstand von oben. Bei doppelter
// Vervielfachung ist die Zeile hoeher UND das Symbol groesser, und
// eine feste 3 setzt es dann zu hoch: auf Justins Foto sitzt das
// Ordnersymbol sichtbar ueber der Schriftlinie. Gerechnet wird
// stattdessen die Mitte der Zeile, wie es der Knopf in der Taskleiste
// seit dieser Runde auch tut.
fn icon_y(i: u64, r: u64) -> u64 {
    // RUNDE FUI-WIN11: das Symbol sitzt mittig in der GANZEN Zeile,
    // also auch in der doppelt hohen.
    let zh: u64 = row_h_of(i)
    let ih: u64 = wlibc.icon_small()
    var oben: u64 = 3
    if zh > ih {
        oben = (zh - ih) / 2
    }
    return g(i, D_Y) + 2 + r * zh + oben
}

// Wo der Buchstabe auf dem Plaettchen anfaengt und auf welcher
// Grundlinie er sitzt -- fuer die Messung, genau die Ausdruecke von oben.
fn icon_letter_x(i: u64, p: u64) -> u64 {
    return g(i, D_X) + 5 + sub(14, wlibc.text_w(wlibc.F_UI, wlibc.px_ui(),
        p, 1)) / 2
}

fn icon_letter_base(i: u64, r: u64) -> u64 {
    return g(i, D_Y) + 2 + r * lines_height() + 15
}

// DIE TABELLE HAT IHRE EIGENE RECHNUNG, und diese drei Funktionen sind
// der Grund, warum sie hier steht: die erste Fassung des Dateimanagers
// meldete die Grundlinie einer Tabellenzeile als "die einer Liste plus
// Kopfhoehe" -- und lag um EINEN Bildpunkt daneben. Im Bild sah man
// nichts (der Text stand ja da), im Pruefer standen 219 von 304
// Tintenpunkten falsch, und die Ursache war keine Farbe, sondern eine
// Zeile: `paint_list` setzt bei `y + 2`, `paint_table` bei
// `y + kopf + 1`. Jetzt steht jede der beiden Rechnungen genau einmal.
fn head_h(i: u64) -> u64 {
    return lines_height() + 4
}

fn head_base(i: u64) -> u64 {
    return g(i, D_Y) + 3 + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui())
}

fn cell_base(i: u64, r: u64) -> u64 {
    return g(i, D_Y) + head_h(i) + 1 + r * lines_height()
        + wlibc.ascent_of(wlibc.F_UI, wlibc.px_ui()) + 1
}

fn cell_x(i: u64, c: u64) -> u64 {
    var x: u64 = g(i, D_X) + 6
    var k: u64 = 0
    while k < c && k < g(i, D_C) {
        x = x + column_wide(i, k)
        k = k + 1
    }
    // ROUND ICONS: the first column starts behind the icon.  Only the
    // first -- a table whose every column shifted would have its header
    // over the wrong data, and `paint_table` does the same thing here.
    if c == 0 {
        x = x + table_in(i)
    }
    return x
}

// Welche Widgetnummer die beiden Knoepfe eines Dialogs haben, und in
// welchem Fenster er liegt. Fuer die MESSUNG: ein Testlaeufer, der die
// Stelle des Knopfes selbst ausrechnet, rechnet die Anordnung nach --
// und prueft dann seinen eigenen Nachbau.
fn dlg_button(welcher: u64) -> u64 {
    if welcher == 0 {
        return dl_ok
    }
    return dl_no
}

fn dlg_label() -> u64 {
    return dl_lbl
}

fn dlg_win() -> u64 {
    if dl_win == 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    return dl_win
}

fn menu_win() -> u64 {
    if mn_win == 0xFFFFFFFFFFFFFFFF {
        return MAXWN
    }
    return mn_win
}


// ==================================================== RUNDE SYSTEMBUS
//
// DURCHREICHE, und mehr soll es nicht sein. Was hier steht, ist keine
// zweite Zwischenablage, sondern der Weg dorthin -- damit eine
// Anwendung eine Zeile schreibt und nicht einen Systemruf baut.

fn clip_put(p: u64, n: u64) -> u64 {
    return wlibc.clip_put(p, n)
}

fn clip_put_typ(typen: u64, p: u64, n: u64) -> u64 {
    return wlibc.clip_put_typ(typen, p, n)
}

fn clip_take(p: u64, max: u64) -> u64 {
    return wlibc.clip_take(p, max)
}

fn clip_hist_take(back: u64, p: u64, max: u64) -> u64 {
    return wlibc.clip_hist_take(back, p, max)
}

fn clip_hist_count() -> u64 {
    return wlibc.clip_hist_count()
}

fn clip_hist_typ(back: u64) -> u64 {
    return wlibc.clip_hist_typ(back)
}

fn clip_hist_owner(back: u64) -> u64 {
    return wlibc.clip_hist_owner(back)
}

fn drag_put(typen: u64, p: u64, n: u64) -> u64 {
    return wlibc.drag_put(typen, p, n)
}

fn drag_take(p: u64, max: u64) -> u64 {
    return wlibc.drag_take(p, max)
}

fn drag_an() -> bool {
    return wlibc.drag_an()
}

fn drag_drop() -> u64 {
    return wlibc.drag_drop()
}

fn noti_post(dringlich: u64, p: u64, n: u64) -> u64 {
    return wlibc.noti_post(dringlich, p, n)
}

fn noti_count() -> u64 {
    return wlibc.noti_count()
}

fn noti_new() -> u64 {
    return wlibc.noti_new()
}

fn noti_take(back: u64, p: u64, max: u64) -> u64 {
    return wlibc.noti_take(back, p, max)
}
