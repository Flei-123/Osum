    // kann, statt sie zu filmen) und die Kurven (fuer den Pruefstand).
    anim_starts, anim_frames, anim_at, anim_laeuft, ease, anim_mix,
    motion_aus, EASE_LINEAR, EASE_OUT, EASE_IN_OUT,
    // RUNDE DESIGN-2: der Maler -- die Schicht fuer die Programme,
