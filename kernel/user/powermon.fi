
profile app

import ulib
import libc.io
import libc.text
import lineout
import tools
import fuiscene

export { u_start }

const SYS_PMON: u64 = 1830

const PM_ON: u64 = 0
const PM_MODE: u64 = 1
const PM_SAMPLES: u64 = 2
const PM_LASTTICK: u64 = 3
const PM_HZ: u64 = 4
const PM_RATE: u64 = 5
const PM_UNIT: u64 = 6
const PM_RATEOK: u64 = 7
const PM_BASE: u64 = 8
const PM_BASEOK: u64 = 9
const PM_BASEN: u64 = 10
const PM_BASESUM: u64 = 11
const PM_BASEMIN: u64 = 12
const PM_ATTRIB: u64 = 13
const PM_BUSY: u64 = 14
const PM_IDLE: u64 = 15
const PM_DEAD: u64 = 16
const PM_SYSE: u64 = 17
const PM_ACRATE: u64 = 18
const PM_ACOK: u64 = 19
const PM_BATRATE: u64 = 20
const PM_BATOK: u64 = 21
const PM_HEALTH: u64 = 22
const PM_HEALTHOK: u64 = 23
const PM_MINUTES: u64 = 24
const PM_COST: u64 = 25
const PM_COSTN: u64 = 26
const PM_MISSES: u64 = 27
const PM_DAYSTART: u64 = 28
const PM_HEAD: u64 = 29
const PM_EVERY: u64 = 30
const PM_MAXRATE: u64 = 31
const PM_MINRATE: u64 = 32
const PM_DAYS: u64 = 33
const PM_WINDOWS: u64 = 34
const PM_ORPHAN: u64 = 35
const PM_ORPHANS: u64 = 36
const PM_STAGED: u64 = 37

const PR_TICKS: u64 = 0
const PR_ENERGY: u64 = 1
const PR_DAYT: u64 = 2
const PR_DAYE: u64 = 3
const PR_PROCS: u64 = 4
const PR_PEND: u64 = 5
const NPROG: u64 = 16
const NSAMPLE: u64 = 256
const NBUCKET: u64 = 11

const PS_ROLLDAY: u64 = 0
const PS_RESET: u64 = 1

const SYS_PWRGET: u64 = 1750
const PG_BATPERCENT: u64 = 25
const PG_BATFULL: u64 = 30
const PG_BATDESIGN: u64 = 31
const PG_ACOK: u64 = 33
const PG_AC: u64 = 34
const PG_TEMP: u64 = 16
const PG_TEMPOK: u64 = 17
const PG_BRIGHT: u64 = 38

const KEEP_DAYS: u64 = 90

static mut APP_BUNDLE_NAME: [u8; 9] = "powermon\0"

fn pm(kind: u64, index: u64, field: u64) -> u64 {
    return ulib.sys(SYS_PMON, kind, index, field)
}

fn scal(which: u64) -> u64 {
    return pm(0, 0, which)
}

fn pwr(field: u64) -> u64 {
    return ulib.sys(SYS_PWRGET, field, 0, 0)
}

fn is_err(v: u64) -> bool {
    return (v >> 63) != 0
}

fn ch(c: u64) {
    var b: [u8; 2] = [0 as u8; 2]
    b[(0) as usize] = c as u8
    lineout.add_bytes((&b[0 as usize]) as u64, 1)
}

fn spaces(n: u64) {
    var i: u64 = 0
    while i < n {
        ch(32)
        i = i + 1
    }
}

fn width_of(v: u64) -> u64 {
    var d: u64 = 1
    var t: u64 = v
    while t >= 10 {
        t = t / 10
        d = d + 1
    }
    return d
}

fn num_w(v: u64, w: u64) {
    let d: u64 = width_of(v)
    if w > d {
        spaces(w -% d)
    }
    lineout.add_unum(v)
}

fn dash_w(w: u64) {
    if w > 2 {
        spaces(w -% 2)
    }
    ch(45)
    ch(45)
}

fn to_mj(mwticks: u64, hz: u64) -> u64 {
    if hz == 0 {
        return 0
    }
    return mwticks / hz
}

static mut cum: u64 = 0
static mut cum_pct: u64 = 0

fn share_reset() {
    cum = 0
    cum_pct = 0
}

fn share_next(part: u64, total: u64) -> u64 {
    if total == 0 {
        return 0
    }
    cum = cum + part
    let now: u64 = (cum * 100 + total / 2) / total
    let d: u64 = now -% cum_pct
    cum_pct = now
    return d
}

static mut r_ticks: [u64; 16] = [0 as u64; 16]
static mut r_energy: [u64; 16] = [0 as u64; 16]
static mut r_procs: [u64; 16] = [0 as u64; 16]
static mut r_name: [u8; 384] = [0 as u8; 384]
static mut r_order: [u64; 16] = [0 as u64; 16]
static mut r_n: u64 = 0
static mut t_ticks: u64 = 0
static mut t_energy: u64 = 0

fn load_rows() {
    r_n = 0
    t_ticks = 0
    t_energy = 0
    var i: u64 = 0
    while i < NPROG {
        let first: u64 = pm(7, i, 0)
        if !is_err(first) && first != 0 {
            var k: u64 = 0
            while k < 24 {
                let c: u64 = pm(7, i, k)
                if is_err(c) {
                    r_name[(r_n * 24 + k) as usize] = 0 as u8
                } else {
                    r_name[(r_n * 24 + k) as usize] = c as u8
                }
                k = k + 1
            }
            r_ticks[(r_n) as usize] = pm(6, i, PR_TICKS)
            r_energy[(r_n) as usize] = pm(6, i, PR_ENERGY)
            r_procs[(r_n) as usize] = pm(6, i, PR_PROCS)
            t_ticks = t_ticks + r_ticks[(r_n) as usize]
            t_energy = t_energy + r_energy[(r_n) as usize]
            r_order[(r_n) as usize] = r_n
            r_n = r_n + 1
        }
        i = i + 1
    }
    var a: u64 = 0
    while a < r_n {
        var b: u64 = a + 1
        while b < r_n {
            if r_ticks[(r_order[(b) as usize]) as usize]
                > r_ticks[(r_order[(a) as usize]) as usize] {
                let tmp: u64 = r_order[(a) as usize]
                r_order[(a) as usize] = r_order[(b) as usize]
                r_order[(b) as usize] = tmp
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn name_len(row: u64) -> u64 {
    var i: u64 = 0
    while i < 24 && r_name[(row * 24 + i) as usize] != 0 as u8 {
        i = i + 1
    }
    return i
}

fn say_name(row: u64, pad: u64) {
    let n: u64 = name_len(row)
    lineout.add_bytes((&r_name[(row * 24) as usize]) as u64, n)
    if pad > n {
        spaces(pad -% n)
    }
}

fn line_mw(label: u64, v: u64, ok: bool) {
    var unit: [u8; 4] = " mW\0"
    lineout.add_text(label)
    if ok {
        num_w(v, 8)
        lineout.add_text((&unit[0 as usize]) as u64)
    } else {
        dash_w(8)
    }
    lineout.end_line()
}

fn machine() {
    var h1: [u8; 25] = "Battery usage by program\0"
    var h2: [u8; 42] = "measured total, proportionally attributed\0"
    var l_now: [u8; 16] = "  Power now    \0"
    var l_base: [u8; 16] = "  System floor \0"
    var l_att: [u8; 16] = "  Attributable \0"
    var l_bat: [u8; 16] = "  Charge       \0"
    var l_hp: [u8; 16] = "  Health       \0"
    var l_rt: [u8; 16] = "  Runtime left \0"
    var l_ac: [u8; 16] = "  On mains     \0"
    var l_tp: [u8; 16] = "  Temperature  \0"
    var l_br: [u8; 16] = "  Brightness   \0"
    var s_pct: [u8; 3] = " %\0"
    var s_of: [u8; 5] = " of \0"
    var s_mwh: [u8; 5] = " mWh\0"
    var s_min: [u8; 5] = " min\0"
    var s_yes: [u8; 9] = "     yes\0"
    var s_no: [u8; 9] = "      no\0"
    var s_c: [u8; 3] = " C\0"
    var s_meas: [u8; 19] = "   (measured over \0"
    var s_idle: [u8; 16] = " idle windows)\0\0"
    var s_none: [u8; 39] = "   (no idle window yet -- all of it is\0"
    var s_none2: [u8; 19] = " booked to System)\0"
    var s_des: [u8; 8] = " design\0"

    lineout.add_text((&h1[0 as usize]) as u64)
    lineout.end_line()
    lineout.add_text((&h2[0 as usize]) as u64)
    lineout.end_line()
    lineout.end_line()

    let ok: bool = scal(PM_RATEOK) != 0
    line_mw((&l_now[0 as usize]) as u64, scal(PM_RATE), ok)
    let bok: bool = scal(PM_BASEOK) != 0
    line_mw((&l_base[0 as usize]) as u64, scal(PM_BASE), bok)
    if bok {
        lineout.add_text((&s_meas[0 as usize]) as u64)
        lineout.add_unum(scal(PM_BASEN))
        lineout.add_text((&s_idle[0 as usize]) as u64)
        lineout.end_line()
    } else {
        lineout.add_text((&s_none[0 as usize]) as u64)
        lineout.add_text((&s_none2[0 as usize]) as u64)
        lineout.end_line()
    }
    line_mw((&l_att[0 as usize]) as u64, scal(PM_ATTRIB), ok)

    let pct: u64 = pwr(PG_BATPERCENT)
    lineout.add_text((&l_bat[0 as usize]) as u64)
    if is_err(pct) {
        dash_w(8)
    } else {
        num_w(pct, 8)
        lineout.add_text((&s_pct[0 as usize]) as u64)
        lineout.add_text((&s_of[0 as usize]) as u64)
        lineout.add_unum(pwr(PG_BATFULL))
        lineout.add_text((&s_mwh[0 as usize]) as u64)
    }
    lineout.end_line()

    lineout.add_text((&l_hp[0 as usize]) as u64)
    if scal(PM_HEALTHOK) != 0 {
        num_w(scal(PM_HEALTH), 8)
        lineout.add_text((&s_pct[0 as usize]) as u64)
        lineout.add_text((&s_of[0 as usize]) as u64)
        lineout.add_unum(pwr(PG_BATDESIGN))
        lineout.add_text((&s_mwh[0 as usize]) as u64)
        lineout.add_text((&s_des[0 as usize]) as u64)
    } else {
        dash_w(8)
    }
    lineout.end_line()

    lineout.add_text((&l_rt[0 as usize]) as u64)
    let mins: u64 = scal(PM_MINUTES)
    if ok && mins != 0 {
        num_w(mins, 8)
        lineout.add_text((&s_min[0 as usize]) as u64)
    } else {
        dash_w(8)
    }
    lineout.end_line()

    lineout.add_text((&l_ac[0 as usize]) as u64)
    if pwr(PG_ACOK) == 1 {
        if pwr(PG_AC) == 1 {
            lineout.add_text((&s_yes[0 as usize]) as u64)
        } else {
            lineout.add_text((&s_no[0 as usize]) as u64)
        }
    } else {
        dash_w(8)
    }
    lineout.end_line()

    lineout.add_text((&l_tp[0 as usize]) as u64)
    if pwr(PG_TEMPOK) == 1 {
        num_w(pwr(PG_TEMP), 8)
        lineout.add_text((&s_c[0 as usize]) as u64)
    } else {
        dash_w(8)
    }
    lineout.end_line()

    let br: u64 = pwr(PG_BRIGHT)
    lineout.add_text((&l_br[0 as usize]) as u64)
    if is_err(br) {
        dash_w(8)
    } else {
        num_w(br, 8)
        lineout.add_text((&s_pct[0 as usize]) as u64)
    }
    lineout.end_line()
    lineout.end_line()
}

fn table() {
    var h: [u8; 47] = "PROGRAM             CPU   SHARE       mJ  RUNS\0"
    var s_pct: [u8; 3] = " %\0"
    var note1: [u8; 22] = "  Sum of the shares: \0"
    var flat: [u8; 63] = "  NOTE: the measured draw did not change with the load on this\0"
    var flat2: [u8; 62] = "  machine, so the floor swallowed all of it and nothing could\0"
    var flat3: [u8; 62] = "  be attributed. The CPU column below is measured; SHARE is a\0"
    var flat4: [u8; 43] = "  share of attributed processor time only.\0"

    let hz: u64 = scal(PM_HZ)
    lineout.add_text((&h[0 as usize]) as u64)
    lineout.end_line()
    share_reset()
    var i: u64 = 0
    var total: u64 = 0
    while i < r_n {
        let row: u64 = r_order[(i) as usize]
        say_name(row, 20)
        num_w(r_ticks[(row) as usize], 5)
        let sh: u64 = share_next(r_ticks[(row) as usize], t_ticks)
        total = total + sh
        num_w(sh, 6)
        lineout.add_text((&s_pct[0 as usize]) as u64)
        num_w(to_mj(r_energy[(row) as usize], hz), 9)
        num_w(r_procs[(row) as usize], 6)
        lineout.end_line()
        i = i + 1
    }
    lineout.end_line()
    lineout.add_text((&note1[0 as usize]) as u64)
    lineout.add_unum(total)
    lineout.add_text((&s_pct[0 as usize]) as u64)
    lineout.end_line()
    if scal(PM_RATEOK) != 0 && scal(PM_ATTRIB) == 0 {
        lineout.add_text((&flat[0 as usize]) as u64)
        lineout.end_line()
        lineout.add_text((&flat2[0 as usize]) as u64)
        lineout.end_line()
        lineout.add_text((&flat3[0 as usize]) as u64)
        lineout.end_line()
        lineout.add_text((&flat4[0 as usize]) as u64)
        lineout.end_line()
    }
}

fn graph(rows: u64) {
    var h: [u8; 51] = "Measured draw, newest last (one row = one sample)\0\0"
    var s_mw: [u8; 5] = " mW \0"
    var none: [u8; 32] = "  no sample with a battery yet\0\0"
    let head_i: u64 = scal(PM_HEAD)
    let n: u64 = scal(PM_SAMPLES)
    let hi: u64 = scal(PM_MAXRATE)
    if n == 0 || hi == 0 {
        lineout.add_text((&none[0 as usize]) as u64)
        lineout.end_line()
        return
    }
    lineout.add_text((&h[0 as usize]) as u64)
    lineout.end_line()
    var have: u64 = n
    if have > NSAMPLE {
        have = NSAMPLE
    }
    var show: u64 = rows
    if show > have {
        show = have
    }
    var k: u64 = 0
    while k < show {
        let back: u64 = show -% k
        var idx: u64 = 0
        if head_i >= back {
            idx = head_i -% back
        } else {
            idx = NSAMPLE + head_i -% back
        }
        let v: u64 = pm(3, idx, 0)
        if !is_err(v) {
            spaces(2)
            num_w(v, 6)
            lineout.add_text((&s_mw[0 as usize]) as u64)
            let bars: u64 = (v * 40) / hi
            var b: u64 = 0
            while b < bars {
                ch(35)
                b = b + 1
            }
            lineout.end_line()
        }
        k = k + 1
    }
}

fn brightness() {
    var h: [u8; 48] = "Brightness against measured draw (mean per 10%)\0"
    var s_n: [u8; 12] = "   samples \0"
    var s_mw: [u8; 4] = " mW\0"
    var s_pct: [u8; 3] = "% \0"
    var none: [u8; 39] = "  no bucket has a sample in it yet\0\0\0\0\0"
    var any: bool = false
    var b: u64 = 0
    while b < NBUCKET {
        if pm(4, b, 0) != 0 {
            any = true
        }
        b = b + 1
    }
    if !any {
        lineout.add_text((&none[0 as usize]) as u64)
        lineout.end_line()
        return
    }
    lineout.add_text((&h[0 as usize]) as u64)
    lineout.end_line()
    b = 0
    while b < NBUCKET {
        let n: u64 = pm(4, b, 0)
        if n != 0 {
            spaces(2)
            num_w(pm(4, b, 2), 3)
            lineout.add_text((&s_pct[0 as usize]) as u64)
            num_w(pm(4, b, 1) / n, 7)
            lineout.add_text((&s_mw[0 as usize]) as u64)
            lineout.add_text((&s_n[0 as usize]) as u64)
            lineout.add_unum(n)
            lineout.end_line()
        }
        b = b + 1
    }
}

fn raw_one(name: u64, v: u64) {
    var pre: [u8; 11] = "powermon: \0"
    var eq: [u8; 2] = "=\0"
    lineout.add_text((&pre[0 as usize]) as u64)
    lineout.add_text(name)
    lineout.add_text((&eq[0 as usize]) as u64)
    if is_err(v) {
        lineout.add_num(v)
    } else {
        lineout.add_unum(v)
    }
    lineout.end_line()
}

fn raw() {
    var n_on: [u8; 3] = "on\0"
    var n_hz: [u8; 3] = "hz\0"
    var n_sa: [u8; 8] = "samples\0"
    var n_ra: [u8; 5] = "rate\0"
    var n_ro: [u8; 7] = "rateok\0"
    var n_ba: [u8; 5] = "base\0"
    var n_bo: [u8; 7] = "baseok\0"
    var n_bn: [u8; 6] = "basen\0"
    var n_at: [u8; 7] = "attrib\0"
    var n_te: [u8; 6] = "proce\0"
    var n_se: [u8; 5] = "syse\0"
    var n_he: [u8; 7] = "health\0"
    var n_ho: [u8; 9] = "healthok\0"
    var n_mi: [u8; 8] = "minutes\0"
    var n_co: [u8; 5] = "cost\0"
    var n_cn: [u8; 6] = "costn\0"
    var n_ms: [u8; 7] = "misses\0"
    var n_wi: [u8; 8] = "windows\0"
    var n_ac: [u8; 7] = "acrate\0"
    var n_bt: [u8; 8] = "batrate\0"
    var n_pn: [u8; 6] = "progn\0"
    var n_pt: [u8; 10] = "progticks\0"
    var n_pe: [u8; 7] = "progmw\0"
    var n_su: [u8; 9] = "sumshare\0"
    var n_un: [u8; 5] = "unit\0"
    var pre: [u8; 11] = "powermon: \0"
    var sp: [u8; 2] = " \0"
    raw_one((&n_on[0 as usize]) as u64, scal(PM_ON))
    raw_one((&n_hz[0 as usize]) as u64, scal(PM_HZ))
    raw_one((&n_sa[0 as usize]) as u64, scal(PM_SAMPLES))
    raw_one((&n_ra[0 as usize]) as u64, scal(PM_RATE))
    raw_one((&n_ro[0 as usize]) as u64, scal(PM_RATEOK))
    raw_one((&n_ba[0 as usize]) as u64, scal(PM_BASE))
    raw_one((&n_bo[0 as usize]) as u64, scal(PM_BASEOK))
    raw_one((&n_bn[0 as usize]) as u64, scal(PM_BASEN))
    raw_one((&n_at[0 as usize]) as u64, scal(PM_ATTRIB))
    raw_one((&n_te[0 as usize]) as u64, scal(PM_DEAD))
    raw_one((&n_se[0 as usize]) as u64, scal(PM_SYSE))
    raw_one((&n_he[0 as usize]) as u64, scal(PM_HEALTH))
    raw_one((&n_ho[0 as usize]) as u64, scal(PM_HEALTHOK))
    raw_one((&n_mi[0 as usize]) as u64, scal(PM_MINUTES))
    raw_one((&n_co[0 as usize]) as u64, scal(PM_COST))
    raw_one((&n_cn[0 as usize]) as u64, scal(PM_COSTN))
    raw_one((&n_ms[0 as usize]) as u64, scal(PM_MISSES))
    raw_one((&n_wi[0 as usize]) as u64, scal(PM_WINDOWS))
    raw_one((&n_ac[0 as usize]) as u64, scal(PM_ACRATE))
    raw_one((&n_bt[0 as usize]) as u64, scal(PM_BATRATE))
    raw_one((&n_un[0 as usize]) as u64, scal(PM_UNIT))
    raw_one((&n_pn[0 as usize]) as u64, r_n)
    raw_one((&n_pt[0 as usize]) as u64, t_ticks)
    raw_one((&n_pe[0 as usize]) as u64, t_energy)
    share_reset()
    var sum: u64 = 0
    var i: u64 = 0
    while i < r_n {
        let row: u64 = r_order[(i) as usize]
        let sh: u64 = share_next(r_ticks[(row) as usize], t_ticks)
        sum = sum + sh
        lineout.add_text((&pre[0 as usize]) as u64)
        say_name(row, 0)
        lineout.add_text((&sp[0 as usize]) as u64)
        lineout.add_unum(r_ticks[(row) as usize])
        lineout.add_text((&sp[0 as usize]) as u64)
        lineout.add_unum(r_energy[(row) as usize])
        lineout.add_text((&sp[0 as usize]) as u64)
        lineout.add_unum(sh)
        lineout.add_text((&sp[0 as usize]) as u64)
        lineout.add_unum(r_procs[(row) as usize])
        lineout.end_line()
        i = i + 1
    }
    raw_one((&n_su[0 as usize]) as u64, sum)
}

static mut fbuf: [u8; 16384] = [0 as u8; 16384]
static mut flen: u64 = 0
static mut old: [u8; 16384] = [0 as u8; 16384]

fn put_ch(c: u64) {
    if flen < 16383 {
        fbuf[(flen) as usize] = c as u8
        flen = flen + 1
    }
}

fn put_str(p: u64) {
    var i: u64 = 0
    let n: u64 = text.length(p)
    while i < n {
        put_ch(__mmio_read8((p + i) as *mut u8) as u64)
        i = i + 1
    }
}

fn put_num(v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var t: u64 = v
    if t == 0 {
        put_ch(48)
        return
    }
    while t != 0 {
        d[(n) as usize] = (48 + t -% (t / 10) * 10) as u8
        t = t / 10
        n = n + 1
    }
    while n != 0 {
        n = n -% 1
        put_ch(d[(n) as usize] as u64)
    }
}

fn day_write() -> u64 {
    var path: [u8; 19] = "/etc/powermon.days\0"
    var s_h1: [u8; 62] = "# osum powermon -- one line per day, newest last, at most 90.\0"
    var s_h2: [u8; 62] = "# mJ is milliwatt-ticks divided by the tick rate: millijoules\0"
    var s_h3: [u8; 62] = "# total = system + programs, and it is measured, not modelled\0"
    var s_open: [u8; 32] = "powermon: cannot write the file\0"
    var s_wrote: [u8; 17] = "powermon: wrote \0"
    var s_oct: [u8; 8] = " octets\0"
    var s_day: [u8; 5] = "day=\0"
    var s_tot: [u8; 10] = " totalmJ=\0"
    var s_sys: [u8; 11] = " systemmJ=\0"
    var s_base: [u8; 9] = " basemW=\0"
    var s_sam: [u8; 10] = " samples=\0"
    var s_hlt: [u8; 9] = " health=\0"
    var s_p: [u8; 7] = " prog=\0"
    var s_col: [u8; 2] = ":\0"

    let hz: u64 = scal(PM_HZ)
    flen = 0

    var oldn: u64 = 0
    let fd: u64 = tools.openr((&path[0 as usize]) as u64)
    if !ulib.bad(fd) {
        let got: u64 = io.read_full(fd, (&old[0 as usize]) as u64,
            16383)
        if !ulib.bad(got) {
            oldn = got
        }
        ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    }

    var data: u64 = 0
    var i: u64 = 0
    var at_start: bool = true
    while i < oldn {
        if at_start && old[(i) as usize] != 35 as u8 {
            data = data + 1
        }
        at_start = false
        if old[(i) as usize] == 10 as u8 {
            at_start = true
        }
        i = i + 1
    }
    var drop: u64 = 0
    if data + 1 > KEEP_DAYS {
        drop = data + 1 -% KEEP_DAYS
    }

    put_str((&s_h1[0 as usize]) as u64)
    put_ch(10)
    put_str((&s_h2[0 as usize]) as u64)
    put_ch(10)
    put_str((&s_h3[0 as usize]) as u64)
    put_ch(10)

    var seen: u64 = 0
    var skip: bool = false
    i = 0
    at_start = true
    while i < oldn {
        if at_start {
            skip = false
            if old[(i) as usize] == 35 as u8 {
                skip = true
            } else {
                if seen < drop {
                    skip = true
                }
                seen = seen + 1
            }
        }
        at_start = false
        if !skip {
            put_ch(old[(i) as usize] as u64)
        }
        if old[(i) as usize] == 10 as u8 {
            at_start = true
        }
        i = i + 1
    }
    if flen != 0 && fbuf[(flen - 1) as usize] != 10 as u8 {
        put_ch(10)
    }

    put_str((&s_day[0 as usize]) as u64)
    put_num(ulib.sys(ulib.SYS_SYSINFO, ulib.I_YEAR, 0, 0) * 10000
        + ulib.sys(ulib.SYS_SYSINFO, ulib.I_MONTH, 0, 0) * 100
        + ulib.sys(ulib.SYS_SYSINFO, ulib.I_DAY, 0, 0))
    put_str((&s_tot[0 as usize]) as u64)
    put_num(to_mj(scal(PM_SYSE) + scal(PM_DEAD), hz))
    put_str((&s_sys[0 as usize]) as u64)
    put_num(to_mj(scal(PM_SYSE), hz))
    put_str((&s_base[0 as usize]) as u64)
    put_num(scal(PM_BASE))
    put_str((&s_sam[0 as usize]) as u64)
    put_num(scal(PM_SAMPLES))
    put_str((&s_hlt[0 as usize]) as u64)
    put_num(scal(PM_HEALTH))
    var k: u64 = 0
    while k < r_n && k < 5 {
        let row: u64 = r_order[(k) as usize]
        put_str((&s_p[0 as usize]) as u64)
        var j: u64 = 0
        while j < 24 && r_name[(row * 24 + j) as usize] != 0 as u8 {
            put_ch(r_name[(row * 24 + j) as usize] as u64)
            j = j + 1
        }
        put_str((&s_col[0 as usize]) as u64)
        put_num(to_mj(r_energy[(row) as usize], hz))
        k = k + 1
    }
    put_ch(10)

    let out: u64 = tools.openw((&path[0 as usize]) as u64)
    if ulib.bad(out) {
        ulib.esay_line((&s_open[0 as usize]) as u64, 0)
        return 1
    }
    ulib.sys(ulib.SYS_WRITE, out, (&fbuf[0 as usize]) as u64, flen)
    ulib.sys(ulib.SYS_CLOSE, out, 0, 0)
    ulib.sys(SYS_PMON, 5, PS_ROLLDAY, 0)
    lineout.add_text((&s_wrote[0 as usize]) as u64)
    lineout.add_unum(flen)
    lineout.add_text((&s_oct[0 as usize]) as u64)
    lineout.end_line()
    return 0
}

static mut blob: [u8; 2048] = [0 as u8; 2048]
static mut bn: u64 = 0
static mut head: [u8; 512] = [0 as u8; 512]
static mut hn: u64 = 0

fn b_ch(c: u64) {
    if bn < 2047 {
        blob[(bn) as usize] = c as u8
        bn = bn + 1
    }
}

fn b_str(p: u64) {
    var i: u64 = 0
    let n: u64 = text.length(p)
    while i < n {
        b_ch(__mmio_read8((p + i) as *mut u8) as u64)
        i = i + 1
    }
}

fn b_num(v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var t: u64 = v
    if t == 0 {
        b_ch(48)
        return
    }
    while t != 0 {
        d[(n) as usize] = (48 + t -% (t / 10) * 10) as u8
        t = t / 10
        n = n + 1
    }
    while n != 0 {
        n = n -% 1
        b_ch(d[(n) as usize] as u64)
    }
}

fn h_ch(c: u64) {
    if hn < 511 {
        head[(hn) as usize] = c as u8
        hn = hn + 1
    }
}

fn h_str(p: u64) {
    var i: u64 = 0
    let n: u64 = text.length(p)
    while i < n {
        h_ch(__mmio_read8((p + i) as *mut u8) as u64)
        i = i + 1
    }
}

fn h_num(v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var t: u64 = v
    if t == 0 {
        h_ch(48)
        return
    }
    while t != 0 {
        d[(n) as usize] = (48 + t -% (t / 10) * 10) as u8
        t = t / 10
        n = n + 1
    }
    while n != 0 {
        n = n -% 1
        h_ch(d[(n) as usize] as u64)
    }
}

fn build_blob() {
    var s_pct: [u8; 3] = " %\0"
    let hz: u64 = scal(PM_HZ)
    bn = 0
    share_reset()
    var i: u64 = 0
    while i < r_n {
        let row: u64 = r_order[(i) as usize]
        var j: u64 = 0
        while j < 24 && r_name[(row * 24 + j) as usize] != 0 as u8 {
            b_ch(r_name[(row * 24 + j) as usize] as u64)
            j = j + 1
        }
        b_ch(9)
        b_num(share_next(r_ticks[(row) as usize], t_ticks))
        b_str((&s_pct[0 as usize]) as u64)
        b_ch(9)
        b_num(r_ticks[(row) as usize])
        b_ch(9)
        b_num(to_mj(r_energy[(row) as usize], hz))
        b_ch(10)
        i = i + 1
    }
    b_ch(0)
}

fn build_head() {
    var s_now: [u8; 12] = "Power now: \0"
    var s_mw: [u8; 5] = " mW\0\0"
    var s_fl: [u8; 17] = "   System floor \0"
    var s_at: [u8; 17] = "   Attributable \0"
    var s_hl: [u8; 12] = "   Health: \0"
    var s_pc: [u8; 3] = " %\0"
    var s_rt: [u8; 12] = "   Left: \0\0\0"
    var s_mn: [u8; 5] = " min\0"
    var s_un: [u8; 3] = "--\0"
    hn = 0
    h_str((&s_now[0 as usize]) as u64)
    if scal(PM_RATEOK) != 0 {
        h_num(scal(PM_RATE))
        h_str((&s_mw[0 as usize]) as u64)
    } else {
        h_str((&s_un[0 as usize]) as u64)
    }
    h_str((&s_fl[0 as usize]) as u64)
    if scal(PM_BASEOK) != 0 {
        h_num(scal(PM_BASE))
        h_str((&s_mw[0 as usize]) as u64)
    } else {
        h_str((&s_un[0 as usize]) as u64)
    }
    h_str((&s_at[0 as usize]) as u64)
    h_num(scal(PM_ATTRIB))
    h_str((&s_mw[0 as usize]) as u64)
    h_str((&s_hl[0 as usize]) as u64)
    if scal(PM_HEALTHOK) != 0 {
        h_num(scal(PM_HEALTH))
        h_str((&s_pc[0 as usize]) as u64)
    } else {
        h_str((&s_un[0 as usize]) as u64)
    }
    h_str((&s_rt[0 as usize]) as u64)
    if scal(PM_MINUTES) != 0 {
        h_num(scal(PM_MINUTES))
        h_str((&s_mn[0 as usize]) as u64)
    } else {
        h_str((&s_un[0 as usize]) as u64)
    }
    h_ch(0)
}

static mut t_win: [u8; 25] = "Battery usage by program\0"
static mut t_sub: [u8; 42] = "measured total, proportionally attributed\0"
static mut t_close: [u8; 6] = "Close\0"
static mut breiten: [u64; 4] = [200 as u64, 90 as u64, 130 as u64, 120 as u64]

const K_TAB: u64 = 1
const K_CLOSE: u64 = 2

fn build() {
    let col: usize = fuiscene.root()
    let _a: usize = fuiscene.label(col, (&head[0 as usize]) as u64)
    let _b: usize = fuiscene.label(col, (&t_sub[0 as usize]) as u64)
    let _t: usize = fuiscene.table_blob(col, K_TAB, 620 - 16, 288, 4,
        (&blob[0 as usize]) as u64)
    let bar: usize = fuiscene.row(col)
    let _sp: usize = fuiscene.space(bar, 620 - 16 - 96, 4)
    let bc: usize = fuiscene.button(bar, (&t_close[0 as usize]) as u64, K_CLOSE)
    fuiscene.set_size(bc, 96, 36)
}

fn window(hold: bool) -> u64 {
    var s_bad: [u8; 29] = "powermon: no drawing surface\0"
    var s_win: [u8; 23] = "powermon: window w=\0\0\0\0"
    var s_h: [u8; 4] = " h=\0"
    var s_rows: [u8; 19] = "powermon: rows=\0\0\0\0"
    var s_ready: [u8; 17] = "powermon: ready\0\0"

    let bw: u64 = 620
    let bh: u64 = 420
    build_head()
    build_blob()
    if !fuiscene.open(70, 70, bw, bh, (&t_win[0 as usize]) as u64, build) {
        ulib.esay_line((&s_bad[0 as usize]) as u64, 0)
        return 1
    }
    fuiscene.set_app((&APP_BUNDLE_NAME[0 as usize]) as u64)
    lineout.add_text((&s_win[0 as usize]) as u64)
    lineout.add_unum(bw)
    lineout.add_text((&s_h[0 as usize]) as u64)
    lineout.add_unum(bh)
    lineout.end_line()

    let _k0: u64 = fuiscene.pump()
    var ci: u64 = 0
    while ci < 4 {
        fuiscene.table_colw(K_TAB, ci, breiten[(ci) as usize])
        ci = ci + 1
    }
    fuiscene.table_set_sel(K_TAB, fuiscene.HEAD_ROW)
    fuiscene.refresh()
    let _k1: u64 = fuiscene.pump()
    lineout.add_text((&s_rows[0 as usize]) as u64)
    lineout.add_unum(r_n)
    lineout.end_line()
    lineout.add_text((&s_ready[0 as usize]) as u64)
    lineout.end_line()
    if !hold {
        fuiscene.quit()
        return 0
    }
    while fuiscene.alive() {
        let id: u64 = fuiscene.pump()
        if id == K_CLOSE {
            fuiscene.quit()
        }
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var w_raw: [u8; 4] = "raw\0"
    var w_graph: [u8; 6] = "graph\0"
    var w_day: [u8; 4] = "day\0"
    var w_reset: [u8; 6] = "reset\0"
    var w_win: [u8; 7] = "window\0"
    var w_hold: [u8; 5] = "hold\0"
    var w_bright: [u8; 7] = "bright\0"
    var s_off: [u8; 47] = "powermon: the power accounting is not running.\0"
    var s_reset: [u8; 28] = "powermon: the split is gone\0"
    var s_noperm: [u8; 41] = "powermon: only the owner may do that (0)\0"

    let argc: u64 = ulib.arg_count(args)
    var mode: u64 = 0
    var hold: bool = false
    var a: u64 = 1
    while a < argc {
        let p: u64 = ulib.arg_at(args, a)
        if ulib.streq(p, (&w_raw[0 as usize]) as u64) {
            mode = 1
        }
        if ulib.streq(p, (&w_graph[0 as usize]) as u64) {
            mode = 2
        }
        if ulib.streq(p, (&w_day[0 as usize]) as u64) {
            mode = 3
        }
        if ulib.streq(p, (&w_reset[0 as usize]) as u64) {
            mode = 4
        }
        if ulib.streq(p, (&w_win[0 as usize]) as u64) {
            mode = 5
        }
        if ulib.streq(p, (&w_bright[0 as usize]) as u64) {
            mode = 6
        }
        if ulib.streq(p, (&w_hold[0 as usize]) as u64) {
            hold = true
        }
        a = a + 1
    }

    if scal(PM_ON) == 0 && mode != 4 {
        ulib.esay_line((&s_off[0 as usize]) as u64, 0)
        return 1
    }

    load_rows()
    if mode == 1 {
        raw()
        return 0
    }
    if mode == 2 {
        graph(24)
        return 0
    }
    if mode == 3 {
        return day_write()
    }
    if mode == 4 {
        let r: u64 = ulib.sys(SYS_PMON, 5, PS_RESET, 0)
        if is_err(r) {
            ulib.esay_line((&s_noperm[0 as usize]) as u64, 0)
            return 1
        }
        lineout.add_text((&s_reset[0 as usize]) as u64)
        lineout.end_line()
        return 0
    }
    if mode == 5 {
        return window(hold)
    }
    if mode == 6 {
        brightness()
        return 0
    }
    machine()
    table()
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
