profile kernel

import ulib

export { NA, refresh, known, fps_x10 }

const NA: u64 = 0xFFFFFFFFFFFFFFFF
const SLOTS: u64 = 32
const BUF: u64 = 6144

static mut raw: [u8; 6144] = [0 as u8; 6144]
static mut raw_len: u64 = 0
static mut w_pres: [u64; 32] = [0 as u64; 32]
static mut w_pid: [u64; 32] = [0 as u64; 32]
static mut w_rate: [u64; 32] = [0 as u64; 32]
const RING: u64 = 4
const WINDOW_MS: u64 = 1000
const MIN_MS: u64 = 400
const PUSH_MS: u64 = 500
static mut s_t: [u64; 4] = [0 as u64; 4]
static mut s_ok: [u64; 4] = [0 as u64; 4]
static mut s_pres: [u64; 128] = [0 as u64; 128]
static mut s_pid: [u64; 128] = [0 as u64; 128]
static mut s_newest: u64 = 0

fn known(v: u64) -> bool {
    return v != NA
}

fn slurp() {
    var p_frames: [u8; 13] = "/proc/frames\0"
    raw_len = 0
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_frames[0]) as u64, 0, 0)
    if ulib.bad(fd) {
        return
    }
    var going: bool = true
    while going && raw_len < BUF - 1 {
        let got: u64 = ulib.sys(ulib.SYS_READ, fd, (&raw[0]) as u64 + raw_len, BUF - 1 - raw_len)
        if got == 0 || ulib.bad(got) {
            going = false
        } else {
            raw_len = raw_len + got
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
}

fn at_is(at: u64, key: u64) -> bool {
    let klen: u64 = ulib.length(key)
    var i: u64 = 0
    while i < klen {
        if at + i >= raw_len {
            return false
        }
        if raw[(at + i) as usize] != *((key + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

fn digits_at(at: u64) -> u64 {
    var v: u64 = at
    var n: u64 = 0
    while v < raw_len && raw[v as usize] >= 48 as u8 && raw[v as usize] <= 57 as u8 {
        n = n * 10 + (raw[v as usize] as u64 - 48)
        v = v + 1
    }
    return n
}

fn skip_digits(at: u64) -> u64 {
    var v: u64 = at
    while v < raw_len && raw[v as usize] >= 48 as u8 && raw[v as usize] <= 57 as u8 {
        v = v + 1
    }
    return v
}

fn parse() {
    var k_win: [u8; 5] = "win.\0"
    var k_pres: [u8; 11] = ".presents \0"
    var k_pid: [u8; 6] = ".pid \0"
    var i: u64 = 0
    while i < SLOTS {
        w_pres[i as usize] = 0
        w_pid[i as usize] = 0
        i = i + 1
    }
    slurp()
    var at: u64 = 0
    while at < raw_len {
        if at_is(at, (&k_win[0]) as u64) {
            let idx: u64 = digits_at(at + 4)
            let rest: u64 = skip_digits(at + 4)
            if idx < SLOTS {
                if at_is(rest, (&k_pres[0]) as u64) {
                    w_pres[idx as usize] = digits_at(rest + 10)
                } else if at_is(rest, (&k_pid[0]) as u64) {
                    w_pid[idx as usize] = digits_at(rest + 5)
                }
            }
        }
        while at < raw_len && raw[at as usize] != 10 as u8 {
            at = at + 1
        }
        at = at + 1
    }
}

fn age_of(now_ms: u64, k: u64) -> u64 {
    if s_ok[k as usize] == 0 || now_ms < s_t[k as usize] {
        return 0
    }
    return now_ms - s_t[k as usize]
}

fn pick(now_ms: u64) -> u64 {
    var best: u64 = NA
    var best_age: u64 = 0
    var j: u64 = 0
    while j < RING {
        let age: u64 = age_of(now_ms, j)
        if age >= MIN_MS {
            if best == NA {
                best = j
                best_age = age
            } else if best_age < WINDOW_MS && age > best_age {
                best = j
                best_age = age
            } else if age >= WINDOW_MS && age < best_age {
                best = j
                best_age = age
            }
        }
        j = j + 1
    }
    return best
}

fn push(now_ms: u64) {
    let k: u64 = (s_newest + 1) % RING
    s_t[k as usize] = now_ms
    s_ok[k as usize] = 1
    var i: u64 = 0
    while i < SLOTS {
        s_pres[(k * SLOTS + i) as usize] = w_pres[i as usize]
        s_pid[(k * SLOTS + i) as usize] = w_pid[i as usize]
        i = i + 1
    }
    s_newest = k
}

fn refresh(now_ms: u64) {
    parse()
    let base: u64 = pick(now_ms)
    var i: u64 = 0
    while i < SLOTS {
        w_rate[i as usize] = NA
        if base != NA && w_pid[i as usize] != 0 {
            let at: u64 = (base * SLOTS + i) as u64
            let dt: u64 = now_ms - s_t[base as usize]
            if s_pid[at as usize] == w_pid[i as usize] && w_pres[i as usize] >= s_pres[at as usize] && dt > 0 {
                w_rate[i as usize] = (w_pres[i as usize] - s_pres[at as usize]) * 10000 / dt
            }
        }
        i = i + 1
    }
    if s_ok[s_newest as usize] == 0 || age_of(now_ms, s_newest) >= PUSH_MS {
        push(now_ms)
    }
}

fn fps_x10(pid: u64) -> u64 {
    var best: u64 = NA
    var i: u64 = 0
    while i < SLOTS {
        if pid != 0 && w_pid[i as usize] == pid && w_rate[i as usize] != NA {
            if best == NA || w_rate[i as usize] > best {
                best = w_rate[i as usize]
            }
        }
        i = i + 1
    }
    return best
}
