//     lock: argc gesehen 0

profile kernel

import ulib
import libc.text
import libc.clockapi
import lineout
import libc.io

export { u_start }

const SYS_LOCK: u64 = 1870
const OP_STATE: u64 = 0
const OP_AN: u64 = 1
const OP_IDLE: u64 = 3

static mut T_CONF: [u8; 17] = "/etc/sperre.conf\0"
static mut K_EMPTY: [u8; 10] = "leerlauf=\0"

fn sy(op: u64, arg: u64) -> u64 {
    return ulib.sys(SYS_LOCK, op, arg, 0)
}

fn idle_limit() -> u64 {
    var buf: [u8; 512] = [0 as u8; 512]
    let fd: u64 = io.open((&T_CONF[(0) as usize]) as u64, 0)
    if ulib.bad(fd) {
        return 0
    }
    let b: u64 = (&buf[(0) as usize]) as u64
    let n: u64 = io.read(fd, b, 500)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return 0
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    let at: u64 = ulib.find(b, (&K_EMPTY[(0) as usize]) as u64)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return ulib.to_num(b + at + text.length((&K_EMPTY[(0) as usize]) as u64))
}

fn u_start(args: u64) -> u64 {
    var s_start: [u8; 26] = "idlelock: on, idle limit \0"
    var s_s: [u8; 3] = " s\0"
    var s_aus: [u8; 27] = "idlelock: off (leerlauf=0)\0"
    var s_an: [u8; 38] = "idlelock: idle limit reached, locking\0"
    var s_fresh: [u8; 26] = "idlelock: idle limit now \0"

    var limit: u64 = idle_limit()
    if limit == 0 {
        lineout.add_text((&s_aus[(0) as usize]) as u64)
        lineout.end_line()
    } else {
        lineout.add_text((&s_start[(0) as usize]) as u64)
        lineout.add_num(limit)
        lineout.add_text((&s_s[(0) as usize]) as u64)
        lineout.end_line()
    }

    var runden: u64 = 0
    while runden < 4000000 {
        runden = runden + 1
        let _s: u64 = clockapi.sleep_ms(250)
        // ROUND W-D: the limit is read again every 4 s (16 rounds of 250 ms),
        // so a change in Settings (lock.idle -> /etc/sperre.conf) takes
        // effect at once and not only after the next sign-in. `0` (never)
        // no longer ends the watcher: it keeps waiting for a new number.
        if (runden % 16) == 0 {
            let fresh: u64 = idle_limit()
            if fresh != limit {
                limit = fresh
                lineout.add_text((&s_fresh[(0) as usize]) as u64)
                lineout.add_num(limit)
                lineout.add_text((&s_s[(0) as usize]) as u64)
                lineout.end_line()
            }
        }
        if limit != 0 && sy(OP_STATE, 0) == 0 {
            let idle: u64 = sy(OP_IDLE, 0)
            if !ulib.bad(idle) {
                // ROUND DELL2: the idle line every two seconds is gone.
                // idlelock inherits the session's terminal, so on the
                // Dell 9020 forty "idlelock: idle=" lines buried the
                // shell prompt the user was typing into. No runner reads
                // them; start and lock lines stay.
                if idle >= limit * 1000 {
                    lineout.add_text((&s_an[(0) as usize]) as u64)
                    lineout.end_line()
                    let _a: u64 = sy(OP_AN, 0)
                }
            }
        }
    }
    return 0
}
