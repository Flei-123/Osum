profile kernel

import ulib
import libc.io
import libc.errno

export { u_start }

const PAYLOAD_BYTES: u64 = 1048576
const FILE_COUNT: u64 = 12
const ASCII_ZERO: u64 = 48

static mut payload: [u8; 1048576] = [0 as u8; 1048576];
static mut file_path: [u8; 8] = [0 as u8; 8];

fn set_path(k: u64) {
    file_path[(0) as usize] = 47 as u8;
    file_path[(1) as usize] = 100 as u8;
    file_path[(2) as usize] = 47 as u8;
    file_path[(3) as usize] = 98 as u8;
    file_path[(4) as usize] = (ASCII_ZERO + k / 10) as u8;
    file_path[(5) as usize] = (ASCII_ZERO + k % 10) as u8;
    file_path[(6) as usize] = 0 as u8;
}

fn u_start(args: u64) -> u64 {
    var s_start: [u8; 14] = "fsrbig: start\0";
    var s_done: [u8; 13] = "fsrbig: done\0";
    var p_dir: [u8; 3] = "/d\0";

    io.make_dir((&p_dir[0 as usize]) as u64);
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.say((&s_start[0 as usize]) as u64);
    ulib.nl();

    var k: u64 = 0;
    while k < FILE_COUNT {
        set_path(k);
        let fd: u64 = io.create((&file_path[0 as usize]) as u64);
        if !errno.failed(fd) {
            io.write(fd, (&payload[0 as usize]) as u64, PAYLOAD_BYTES);
            io.close(fd);
        }
        k = k + 1;
    }
    ulib.say((&s_done[0 as usize]) as u64);
    ulib.nl();
    return 0;
}
