profile kernel

import ulib
import lineout
import libc.io
import libc.errno
import libc.text
import libc.octets
import libc.kcall
import services.svcrules
import services.svcqueue
import services.svcosum

export { u_start }

const NAME_BUF: u64 = 128
const VALUE_BUF: u64 = 131072
const BIG_CHUNK: u64 = 4096
const VAL_SHOW_MAX: u64 = 64
const NOTE_LEN: u64 = 13
const SAVE_BODY_LEN: u64 = 13
const BIG_CHUNKS: u64 = 25
const BIG_CHUNK_BYTE: u64 = 98

static mut name_buf: [u8; 128] = [0 as u8; 128]
static mut value_buf: [u8; 131072] = [0 as u8; 131072]
static mut head_buf: [u8; 28] = [0 as u8; 28]
static mut out_buf: [u8; 8] = [0 as u8; 8]
static mut APP_NAME: [u8; 9] = "pickdemo\0"
static mut SEED_KEY: [u8; 5] = "seed\0"
static mut SEED_VALUE: [u8; 2] = "x\0"
static mut NOTE_PATH: [u8; 18] = "/data/zzzpick.txt\0"
static mut NOTE_BODY: [u8; 14] = "note-body-123\0"
static mut SKIP_PATH: [u8; 17] = "/data/zzskip.bin\0"
static mut SKIP_BODY: [u8; 5] = "skip\0"
static mut t_title: [u8; 11] = "Demo title\0"
static mut t_accept: [u8; 4] = "txt\0"
static mut l_wait_ok: [u8; 18] = "pickdemo: ok-wait\0"
static mut l_ok: [u8; 13] = "pickdemo: ok\0"
static mut l_wait_cancel: [u8; 22] = "pickdemo: cancel-wait\0"
static mut l_cancel: [u8; 17] = "pickdemo: cancel\0"
static mut l_rec: [u8; 14] = "pickdemo: rec\0"
static mut SAVE_PATH: [u8; 16] = "/data/zsave.txt\0"
static mut BIG_PATH: [u8; 17] = "/data/zzzbig.big\0"
static mut SAVE_NAME: [u8; 10] = "zsave.txt\0"
static mut SAVE_BODY: [u8; 14] = "saved-body-45\0"
static mut t_save_title: [u8; 10] = "Save demo\0"
static mut t_big_accept: [u8; 4] = "big\0"
static mut l_wait_save: [u8; 20] = "pickdemo: save-wait\0"
static mut l_save: [u8; 15] = "pickdemo: save\0"
static mut l_file: [u8; 15] = "pickdemo: file\0"
static mut l_wait_big: [u8; 19] = "pickdemo: big-wait\0"
static mut l_big: [u8; 14] = "pickdemo: big\0"
static mut s_size: [u8; 7] = " size=\0"
static mut l_done: [u8; 15] = "pickdemo: done\0"
static mut s_status: [u8; 9] = " status=\0"
static mut s_op: [u8; 5] = " op=\0"
static mut s_name: [u8; 7] = " name=\0"
static mut s_len: [u8; 6] = " len=\0"
static mut s_val: [u8; 6] = " val=\0"

fn say(p: u64) {
    let _n: u64 = lineout.add_text(p)
}

fn num_line(label: u64, v: u64) {
    say(label)
    lineout.add_num(v)
}

fn mark(p: u64) {
    say(p)
    lineout.end_line()
}

fn seed_file(path: u64, body: u64, n: u64) {
    let fd: u64 = io.create(path)
    if errno.failed(fd) {
        return
    }
    let _w: u64 = io.write_all(fd, body, n)
    let _c: u64 = io.close(fd)
}

fn seed() {
    let app: u64 = (&APP_NAME[0 as usize]) as u64
    let _a: u64 = svcosum.set_app(app, text.length(app))
    let _s: u64 = svcosum.store_set((&SEED_KEY[0 as usize]) as u64, 4, (&SEED_VALUE[0 as usize]) as u64, 1)
    seed_file((&NOTE_PATH[0 as usize]) as u64, (&NOTE_BODY[0 as usize]) as u64, NOTE_LEN)
    seed_file((&SKIP_PATH[0 as usize]) as u64, (&SKIP_BODY[0 as usize]) as u64, 4)
}

fn drain_pick_queue() {
    let head: u64 = (&head_buf[0 as usize]) as u64
    let name: u64 = (&name_buf[0 as usize]) as u64
    let value: u64 = (&value_buf[0 as usize]) as u64
    while svcosum.pending() > 0 {
        octets.zero(name, NAME_BUF)
        octets.zero(value, VALUE_BUF)
        if !svcosum.poll(head, name, NAME_BUF - 1, value, VALUE_BUF - 1) {
            return
        }
        say((&l_rec[0 as usize]) as u64)
        num_line((&s_op[0 as usize]) as u64, octets.le32(head + 8))
        say((&s_status[0 as usize]) as u64)
        say(svcrules.status_name(octets.le32(head + 12)))
        say((&s_name[0 as usize]) as u64)
        say(name)
        num_line((&s_len[0 as usize]) as u64, octets.le32(head + 24))
        say((&s_val[0 as usize]) as u64)
        if text.length(value) <= VAL_SHOW_MAX {
            say(value)
        }
        lineout.end_line()
    }
}

fn ask_pick(wait: u64, label: u64) {
    mark(wait)
    let st: u64 = svcosum.pick_open((&t_title[0 as usize]) as u64, (&t_accept[0 as usize]) as u64, (&out_buf[0 as usize]) as u64)
    say(label)
    say((&s_status[0 as usize]) as u64)
    say(svcrules.status_name(st))
    lineout.end_line()
    drain_pick_queue()
}

fn seed_big() {
    let chunk: u64 = (&value_buf[0 as usize]) as u64
    var at: u64 = 0
    while at < BIG_CHUNK {
        octets.st8(chunk, at, BIG_CHUNK_BYTE)
        at = at + 1
    }
    let fd: u64 = io.create((&BIG_PATH[0 as usize]) as u64)
    if errno.failed(fd) {
        return
    }
    var written: u64 = 0
    while written < BIG_CHUNKS {
        let _w: u64 = io.write_all(fd, chunk, BIG_CHUNK)
        written = written + 1
    }
    let _c: u64 = io.close(fd)
}

fn report_file(path: u64) {
    say((&l_file[0 as usize]) as u64)
    num_line((&s_size[0 as usize]) as u64, io.size_of(path))
    lineout.end_line()
}

fn ask_save() {
    mark((&l_wait_save[0 as usize]) as u64)
    let st: u64 = svcosum.pick_save((&t_save_title[0 as usize]) as u64, (&SAVE_NAME[0 as usize]) as u64, (&SAVE_BODY[0 as usize]) as u64, SAVE_BODY_LEN, (&out_buf[0 as usize]) as u64)
    say((&l_save[0 as usize]) as u64)
    say((&s_status[0 as usize]) as u64)
    say(svcrules.status_name(st))
    lineout.end_line()
    drain_pick_queue()
    report_file((&SAVE_PATH[0 as usize]) as u64)
}

fn ask_big() {
    mark((&l_wait_big[0 as usize]) as u64)
    let st: u64 = svcosum.pick_open((&t_title[0 as usize]) as u64, (&t_big_accept[0 as usize]) as u64, (&out_buf[0 as usize]) as u64)
    say((&l_big[0 as usize]) as u64)
    say((&s_status[0 as usize]) as u64)
    say(svcrules.status_name(st))
    lineout.end_line()
    drain_pick_queue()
}

fn u_start(args: u64) -> u64 {
    seed()
    seed_big()
    ask_pick((&l_wait_ok[0 as usize]) as u64, (&l_ok[0 as usize]) as u64)
    ask_pick((&l_wait_cancel[0 as usize]) as u64, (&l_cancel[0 as usize]) as u64)
    ask_save()
    ask_big()
    mark((&l_done[0 as usize]) as u64)
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
