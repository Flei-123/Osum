
profile kernel

import ulib
import libc.text
import libc.clockapi
import sha
import libc.errno
import tools

export {
    sha256, hmac256, pbkdf2, hex_out, same_dk,
    make_hash, check_hash, ITERS, DK_LEN,
    load_passwd, field, line_at, lines_of, name_of_uid, session_uid, uid_of_name,
    gid_of_name, shell_of_name, home_of_name, shadow_of, PW_MAX,
    read_all, write_all, read_pass, set_shadow,
    DB_OK, DB_MISSING, DB_UNREADABLE, shadow_state, user_state, db_errno,
    conf_num,
    pwbuf_ptr,
    KOSTEN, VERZOEGERUNG_MS, MAX_ITERS
}

const DK_LEN: u64 = 32

const ITERS: u64 = 8192

const MAX_ITERS: u64 = 10000000

const KOSTEN: u64 = 8192
const VERZOEGERUNG_MS: u64 = 1000

const PW_MAX: u64 = 4096



fn sha256(p: u64, len: u64, out: u64) -> bool {
    if len > 256 {
        return false
    }
    return sha.sha256(p, len, out)
}

fn hmac256(key: u64, klen: u64, m: u64, mlen: u64, out: u64) -> bool {
    var k0: [u8; 64] = [0 as u8; 64]
    var tmp: [u8; 32] = [0 as u8; 32]
    var i: u64 = 0
    if klen > 64 {
        if !sha256(key, klen, (&tmp[0]) as u64) {
            return false
        }
        while i < 32 {
            k0[i as usize] = tmp[i as usize]
            i = i + 1
        }
    } else {
        while i < klen {
            k0[i as usize] = *((key + i) as *mut u8)
            i = i + 1
        }
    }
    var inner: [u8; 128] = [0 as u8; 128]
    var outer: [u8; 128] = [0 as u8; 128]
    i = 0
    while i < 64 {
        inner[i as usize] = ((k0[i as usize] as u64) ^ 0x36) as u8
        outer[i as usize] = ((k0[i as usize] as u64) ^ 0x5C) as u8
        i = i + 1
    }
    if mlen > 64 {
        return false
    }
    i = 0
    while i < mlen {
        inner[(64 + i) as usize] = *((m + i) as *mut u8)
        i = i + 1
    }
    if !sha256((&inner[0]) as u64, 64 + mlen, (&tmp[0]) as u64) {
        return false
    }
    i = 0
    while i < 32 {
        outer[(64 + i) as usize] = tmp[i as usize]
        i = i + 1
    }
    return sha256((&outer[0]) as u64, 96, out)
}

fn pbkdf2(pw: u64, plen: u64, salt: u64, slen: u64, iters: u64,
    out: u64) -> bool {
    if slen > 60 {
        return false
    }
    var first: [u8; 64] = [0 as u8; 64]
    var u: [u8; 32] = [0 as u8; 32]
    var t: [u8; 32] = [0 as u8; 32]
    var i: u64 = 0
    while i < slen {
        first[i as usize] = *((salt + i) as *mut u8)
        i = i + 1
    }
    first[slen as usize] = 0 as u8
    first[(slen + 1) as usize] = 0 as u8
    first[(slen + 2) as usize] = 0 as u8
    first[(slen + 3) as usize] = 1 as u8
    if !hmac256(pw, plen, (&first[0]) as u64, slen + 4, (&u[0]) as u64) {
        return false
    }
    i = 0
    while i < 32 {
        t[i as usize] = u[i as usize]
        i = i + 1
    }
    var r: u64 = 1
    while r < iters {
        if !hmac256(pw, plen, (&u[0]) as u64, 32, (&u[0]) as u64) {
            return false
        }
        i = 0
        while i < 32 {
            t[i as usize] = ((t[i as usize] as u64) ^ (u[i as usize] as u64)) as u8
            i = i + 1
        }
        r = r + 1
    }
    i = 0
    while i < 32 {
        __mmio_write8((out + i) as *mut u8, t[i as usize])
        i = i + 1
    }
    return true
}

fn hex_out(p: u64, n: u64, out: u64) {
    var d: [u8; 17] = "0123456789abcdef\0"
    var i: u64 = 0
    while i < n {
        let v: u64 = (*((p + i) as *mut u8)) as u64
        __mmio_write8((out + i * 2) as *mut u8, d[((v >> 4) & 15) as usize])
        __mmio_write8((out + i * 2 + 1) as *mut u8, d[(v & 15) as usize])
        i = i + 1
    }
    __mmio_write8((out + n * 2) as *mut u8, 0 as u8)
}

fn same_dk(a: u64, b: u64, n: u64) -> bool {
    var diff: u64 = 0
    var i: u64 = 0
    while i < n {
        diff = diff | ((*((a + i) as *mut u8)) as u64
            ^ (*((b + i) as *mut u8)) as u64)
        i = i + 1
    }
    return diff == 0
}

fn make_hash(pw: u64, out: u64) -> bool {
    var salt: [u8; 8] = [0 as u8; 8]
    var dk: [u8; 32] = [0 as u8; 32]
    var shex: [u8; 20] = [0 as u8; 20]
    var dhex: [u8; 72] = [0 as u8; 72]
    var head: [u8; 8] = "$osum1$\0"
    var dollar: [u8; 2] = "$\0"
    let got: u64 = ulib.sys(318, (&salt[0]) as u64, 8, 0)
    if ulib.bad(got) || got != 8 {
        return false
    }
    var rounds_key: [u8; 11] = "kdf_rounds\0"
    var rounds_key_old: [u8; 12] = "kdf_runden\0\0"
    var it: u64 = conf_num((&rounds_key[0]) as u64, 0)
    if it == 0 {
        it = conf_num((&rounds_key_old[0]) as u64, KOSTEN)
    }
    if it == 0 || it > MAX_ITERS {
        it = KOSTEN
    }
    if !pbkdf2(pw, text.length(pw), (&salt[0]) as u64, 8, it,
        (&dk[0]) as u64) {
        return false
    }
    hex_out((&salt[0]) as u64, 8, (&shex[0]) as u64)
    hex_out((&dk[0]) as u64, 32, (&dhex[0]) as u64)
    var at: u64 = ulib.strcpy(out, (&head[0]) as u64)
    var num: [u8; 24] = [0 as u8; 24]
    text.digits(it, (&num[0]) as u64, true)
    at = at + ulib.strcpy(out + at, (&num[0]) as u64)
    at = at + ulib.strcpy(out + at, (&dollar[0]) as u64)
    at = at + ulib.strcpy(out + at, (&shex[0]) as u64)
    at = at + ulib.strcpy(out + at, (&dollar[0]) as u64)
    ulib.strcpy(out + at, (&dhex[0]) as u64)
    return true
}

fn hexval(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return 16
}

fn check_hash(rec: u64, pw: u64) -> bool {
    var head: [u8; 8] = "$osum1$\0"
    if !ulib.strneq(rec, (&head[0]) as u64, 7) {
        return false
    }
    var at: u64 = 7
    let iters: u64 = ulib.to_num(rec + at)
    while *((rec + at) as *mut u8) != 36 as u8 {
        if *((rec + at) as *mut u8) == 0 as u8 {
            return false
        }
        at = at + 1
    }
    at = at + 1
    var salt: [u8; 32] = [0 as u8; 32]
    var slen: u64 = 0
    while *((rec + at) as *mut u8) != 36 as u8 {
        let hi: u64 = hexval((*((rec + at) as *mut u8)) as u64)
        let lo: u64 = hexval((*((rec + at + 1) as *mut u8)) as u64)
        if hi > 15 || lo > 15 || slen >= 32 {
            return false
        }
        salt[slen as usize] = ((hi << 4) | lo) as u8
        slen = slen + 1
        at = at + 2
    }
    at = at + 1
    var want: [u8; 32] = [0 as u8; 32]
    var wlen: u64 = 0
    while *((rec + at) as *mut u8) != 0 as u8 && wlen < 32 {
        let hi: u64 = hexval((*((rec + at) as *mut u8)) as u64)
        let lo: u64 = hexval((*((rec + at + 1) as *mut u8)) as u64)
        if hi > 15 || lo > 15 {
            return false
        }
        want[wlen as usize] = ((hi << 4) | lo) as u8
        wlen = wlen + 1
        at = at + 2
    }
    if wlen != 32 || iters == 0 || iters > MAX_ITERS {
        return false
    }
    var dk: [u8; 32] = [0 as u8; 32]
    if !pbkdf2(pw, text.length(pw), (&salt[0]) as u64, slen, iters,
        (&dk[0]) as u64) {
        return false
    }
    return same_dk((&dk[0]) as u64, (&want[0]) as u64, 32)
}

static mut pwbuf: [u8; 4096] = [0 as u8; 4096]
static mut pwlen: u64 = 0
static mut shbuf: [u8; 4096] = [0 as u8; 4096]

fn read_all(path: u64, buf: u64, max: u64) -> u64 {
    read_err = 0
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, 0, 0)
    if ulib.bad(fd) {
        read_err = errno.negated(fd)
        return ulib.EOF
    }
    var at: u64 = 0
    var going: bool = true
    while going {
        let n: u64 = ulib.sys(ulib.SYS_READ, fd, buf + at, max - 1 - at)
        if ulib.bad(n) {
            read_err = errno.negated(n)
            going = false
        } else if n == 0 {
            going = false
        } else {
            at = at + n
            if at + 1 >= max {
                going = false
            }
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    __mmio_write8((buf + at) as *mut u8, 0 as u8)
    if read_err != 0 && at == 0 {
        return ulib.EOF
    }
    return at
}

const DB_OK: u64 = 0
const DB_MISSING: u64 = 1
const DB_UNREADABLE: u64 = 2
const DB_TRIES: u64 = 5
const DB_GAP_MS: u64 = 200
const ERR_NOENT: u64 = 2

static mut read_err: u64 = 0
static mut db_err: u64 = 0

fn db_errno() -> u64 {
    return db_err
}

fn read_db(path: u64, buf: u64, max: u64) -> u64 {
    var t: u64 = 0
    while t < DB_TRIES {
        let n: u64 = read_all(path, buf, max)
        if n != ulib.EOF && n != 0 {
            db_err = 0
            return n
        }
        if n == ulib.EOF && read_err == ERR_NOENT {
            db_err = ERR_NOENT
            return ulib.EOF
        }
        db_err = read_err
        t = t + 1
        if t < DB_TRIES {
            let _s: u64 = clockapi.sleep_ms(DB_GAP_MS)
        }
    }
    if db_err == 0 {
        db_err = ERR_EMPTY
    }
    return ulib.EOF
}

const ERR_EMPTY: u64 = 61

fn user_state(name: u64) -> u64 {
    var p: [u8; 12] = "/etc/passwd\0"
    let n: u64 = read_db((&p[0]) as u64, (&pwbuf[0]) as u64, 4096)
    if n == ulib.EOF {
        pwlen = 0
        return DB_UNREADABLE
    }
    pwlen = n
    var f: [u8; 32] = [0 as u8; 32]
    if !pw_field(name, 2, (&f[0]) as u64, 32) {
        return DB_MISSING
    }
    return DB_OK
}

fn shadow_state(name: u64, out: u64, max: u64) -> u64 {
    var p: [u8; 12] = "/etc/shadow\0"
    let n: u64 = read_db((&p[0]) as u64, (&shbuf[0]) as u64, 4096)
    if n == ulib.EOF {
        if db_err == ERR_NOENT {
            return DB_MISSING
        }
        return DB_UNREADABLE
    }
    if shadow_scan(name, out, max) {
        return DB_OK
    }
    return DB_MISSING
}

fn load_passwd() -> u64 {
    var p: [u8; 12] = "/etc/passwd\0"
    let n: u64 = read_all((&p[0]) as u64, (&pwbuf[0]) as u64, 4096)
    if n == ulib.EOF {
        pwlen = 0
        return ulib.EOF
    }
    pwlen = n
    return n
}

fn pwbuf_ptr() -> u64 {
    return (&pwbuf[0]) as u64
}

fn lines_of(buf: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while *((buf + i) as *mut u8) != 0 as u8 {
        if *((buf + i) as *mut u8) == 10 as u8 {
            n = n + 1
        }
        i = i + 1
    }
    if i > 0 && *((buf + i - 1) as *mut u8) != 10 as u8 {
        n = n + 1
    }
    return n
}

fn line_at(buf: u64, i: u64, out: u64, max: u64) -> u64 {
    var at: u64 = 0
    var k: u64 = 0
    while k < i {
        while *((buf + at) as *mut u8) != 10 as u8 {
            if *((buf + at) as *mut u8) == 0 as u8 {
                return ulib.EOF
            }
            at = at + 1
        }
        at = at + 1
        k = k + 1
    }
    if *((buf + at) as *mut u8) == 0 as u8 {
        return ulib.EOF
    }
    var n: u64 = 0
    while *((buf + at) as *mut u8) != 0 as u8
        && *((buf + at) as *mut u8) != 10 as u8 {
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, *((buf + at) as *mut u8))
            n = n + 1
        }
        at = at + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return n
}

fn field(line: u64, k: u64, out: u64, max: u64) -> bool {
    var at: u64 = 0
    var f: u64 = 0
    while f < k {
        while *((line + at) as *mut u8) != 58 as u8 {
            if *((line + at) as *mut u8) == 0 as u8 {
                __mmio_write8((out) as *mut u8, 0 as u8)
                return false
            }
            at = at + 1
        }
        at = at + 1
        f = f + 1
    }
    var n: u64 = 0
    while *((line + at) as *mut u8) != 0 as u8
        && *((line + at) as *mut u8) != 58 as u8 {
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, *((line + at) as *mut u8))
            n = n + 1
        }
        at = at + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return true
}

fn pw_field(name: u64, want: u64, out: u64, max: u64) -> bool {
    if pwlen == 0 {
        if load_passwd() == ulib.EOF {
            return false
        }
    }
    var line: [u8; 256] = [0 as u8; 256]
    var f: [u8; 128] = [0 as u8; 128]
    var i: u64 = 0
    let n: u64 = lines_of((&pwbuf[0]) as u64)
    while i < n {
        if line_at((&pwbuf[0]) as u64, i, (&line[0]) as u64, 256) != ulib.EOF {
            field((&line[0]) as u64, 0, (&f[0]) as u64, 128)
            if ulib.streq((&f[0]) as u64, name) {
                return field((&line[0]) as u64, want, out, max)
            }
        }
        i = i + 1
    }
    return false
}

fn uid_of_name(name: u64) -> u64 {
    var f: [u8; 32] = [0 as u8; 32]
    if !pw_field(name, 2, (&f[0]) as u64, 32) {
        return ulib.EOF
    }
    return ulib.to_num((&f[0]) as u64)
}

fn gid_of_name(name: u64) -> u64 {
    var f: [u8; 32] = [0 as u8; 32]
    if !pw_field(name, 3, (&f[0]) as u64, 32) {
        return ulib.EOF
    }
    return ulib.to_num((&f[0]) as u64)
}

fn shell_of_name(name: u64, out: u64, max: u64) -> bool {
    return pw_field(name, 6, out, max)
}

fn home_of_name(name: u64, out: u64, max: u64) -> bool {
    return pw_field(name, 5, out, max)
}

const SYS_SESSION_OP: u64 = 1870
const SESSION_OP_OWNER: u64 = 8
fn session_uid() -> u64 {
    var uid: u64 = ulib.sys(SYS_SESSION_OP, SESSION_OP_OWNER, 0, 0)
    if ulib.bad(uid) || uid == 0 {
        uid = ulib.sys(107, 0, 0, 0)
    }
    return uid
}

fn name_of_uid(uid: u64, out: u64, max: u64) -> bool {
    if pwlen == 0 {
        if load_passwd() == ulib.EOF {
            return false
        }
    }
    var line: [u8; 256] = [0 as u8; 256]
    var f: [u8; 128] = [0 as u8; 128]
    var i: u64 = 0
    let n: u64 = lines_of((&pwbuf[0]) as u64)
    while i < n {
        if line_at((&pwbuf[0]) as u64, i, (&line[0]) as u64, 256) != ulib.EOF {
            field((&line[0]) as u64, 2, (&f[0]) as u64, 128)
            if ulib.to_num((&f[0]) as u64) == uid {
                return field((&line[0]) as u64, 0, out, max)
            }
        }
        i = i + 1
    }
    return false
}

fn shadow_of(name: u64, out: u64, max: u64) -> bool {
    var p: [u8; 12] = "/etc/shadow\0"
    let n: u64 = read_all((&p[0]) as u64, (&shbuf[0]) as u64, 4096)
    if n == ulib.EOF {
        return false
    }
    return shadow_scan(name, out, max)
}

fn shadow_scan(name: u64, out: u64, max: u64) -> bool {
    var line: [u8; 256] = [0 as u8; 256]
    var f: [u8; 128] = [0 as u8; 128]
    var i: u64 = 0
    let cnt: u64 = lines_of((&shbuf[0]) as u64)
    while i < cnt {
        if line_at((&shbuf[0]) as u64, i, (&line[0]) as u64, 256) != ulib.EOF {
            field((&line[0]) as u64, 0, (&f[0]) as u64, 128)
            if ulib.streq((&f[0]) as u64, name) {
                return field((&line[0]) as u64, 1, out, max)
            }
        }
        i = i + 1
    }
    return false
}

fn write_all(path: u64, buf: u64, len: u64) -> bool {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, 577, 0)
    if ulib.bad(fd) {
        return false
    }
    var at: u64 = 0
    while at < len {
        let n: u64 = ulib.sys(ulib.SYS_WRITE, fd, buf + at, len - at)
        if ulib.bad(n) || n == 0 {
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
            return false
        }
        at = at + n
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return true
}

fn read_pass(prompt: u64, out: u64, max: u64) -> u64 {
    var t: [u8; 40] = [0 as u8; 40]
    var saved: [u8; 40] = [0 as u8; 40]
    var tty: bool = false
    if !ulib.bad(ulib.sys(16, 0, 0x5401, (&t[0]) as u64)) {
        tty = true
        var i: u64 = 0
        while i < 36 {
            saved[i as usize] = t[i as usize]
            i = i + 1
        }
        let lf: u64 = __mmio_read32((((&t[12]) as u64)) as *mut u32) as u64
        __mmio_write32((((&t[12]) as u64)) as *mut u32,
            (lf & 0xFFFFFFF7) as u32)
        ulib.sys(16, 0, 0x5404, (&t[0]) as u64)
        if prompt != 0 {
            ulib.eput(prompt)
        }
    }
    var n: u64 = 0
    var c: [u8; 1] = [0 as u8; 1]
    var going: bool = true
    while going {
        let r: u64 = ulib.sys(ulib.SYS_READ, 0, (&c[0]) as u64, 1)
        if ulib.bad(r) || r == 0 {
            going = false
        } else {
            if c[0 as usize] == 10 as u8 || c[0 as usize] == 13 as u8 {
                going = false
            } else {
                if n + 1 < max {
                    __mmio_write8((out + n) as *mut u8, c[0 as usize])
                    n = n + 1
                }
            }
        }
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    if tty {
        ulib.sys(16, 0, 0x5404, (&saved[0]) as u64)
        var nlc: [u8; 2] = "\n\0"
        ulib.eput((&nlc[0]) as u64)
    }
    return n
}

fn set_shadow(name: u64, rec: u64) -> bool {
    var path: [u8; 12] = "/etc/shadow\0"
    var out: [u8; 4096] = [0 as u8; 4096]
    var line: [u8; 256] = [0 as u8; 256]
    var f: [u8; 128] = [0 as u8; 128]
    var tail: [u8; 16] = ":0:0:99999:7:::\0"
    var colon: [u8; 2] = ":\0"
    var nlc: [u8; 2] = "\n\0"
    let have: u64 = read_all((&path[0]) as u64, (&shbuf[0]) as u64, 4096)
    var at: u64 = 0
    var found: bool = false
    if have != ulib.EOF {
        let cnt: u64 = lines_of((&shbuf[0]) as u64)
        var i: u64 = 0
        while i < cnt {
            if line_at((&shbuf[0]) as u64, i, (&line[0]) as u64, 256)
                != ulib.EOF {
                field((&line[0]) as u64, 0, (&f[0]) as u64, 128)
                if ulib.streq((&f[0]) as u64, name) {
                    found = true
                    at = at + ulib.strcpy((&out[at as usize]) as u64, name)
                    at = at + ulib.strcpy((&out[at as usize]) as u64,
                        (&colon[0]) as u64)
                    at = at + ulib.strcpy((&out[at as usize]) as u64, rec)
                    at = at + ulib.strcpy((&out[at as usize]) as u64,
                        (&tail[0]) as u64)
                } else {
                    at = at + ulib.strcpy((&out[at as usize]) as u64,
                        (&line[0]) as u64)
                }
                at = at + ulib.strcpy((&out[at as usize]) as u64,
                    (&nlc[0]) as u64)
            }
            i = i + 1
        }
    }
    if !found {
        at = at + ulib.strcpy((&out[at as usize]) as u64, name)
        at = at + ulib.strcpy((&out[at as usize]) as u64, (&colon[0]) as u64)
        at = at + ulib.strcpy((&out[at as usize]) as u64, rec)
        at = at + ulib.strcpy((&out[at as usize]) as u64, (&tail[0]) as u64)
        at = at + ulib.strcpy((&out[at as usize]) as u64, (&nlc[0]) as u64)
    }
    var tmp: [u8; 16] = "/etc/shadow.neu\0"
    var before: [u8; 16] = "/etc/shadow.alt\0"
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&tmp[0]) as u64, 577, 0)
    if ulib.bad(fd) {
        return false
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    var st: [u8; 144] = [0 as u8; 144]
    var mode: u64 = 384
    var ouid: u64 = 0
    var ogid: u64 = 0
    if !ulib.bad(ulib.sys(4, (&path[0]) as u64, (&st[0]) as u64, 0)) {
        mode = ((*((&st[24]) as *mut u32)) as u64) & 4095
        ouid = (*((&st[28]) as *mut u32)) as u64
        ogid = (*((&st[32]) as *mut u32)) as u64
    }
    ulib.sys(90, (&tmp[0]) as u64, mode, 0)
    ulib.sys(92, (&tmp[0]) as u64, ouid, ogid)
    if !write_all((&tmp[0]) as u64, (&out[0]) as u64, at) {
        ulib.sys(ulib.SYS_UNLINK, (&tmp[0]) as u64, 0, 0)
        return false
    }
    ulib.sys(ulib.SYS_UNLINK, (&before[0]) as u64, 0, 0)
    let hatte: bool = !ulib.bad(ulib.sys(ulib.SYS_RENAME,
        (&path[0]) as u64, (&before[0]) as u64, 0))
    if ulib.bad(ulib.sys(ulib.SYS_RENAME, (&tmp[0]) as u64,
        (&path[0]) as u64, 0)) {
        if hatte {
            ulib.sys(ulib.SYS_RENAME, (&before[0]) as u64, (&path[0]) as u64, 0)
        }
        ulib.sys(ulib.SYS_UNLINK, (&tmp[0]) as u64, 0, 0)
        return false
    }
    ulib.sys(ulib.SYS_UNLINK, (&before[0]) as u64, 0, 0)
    return true
}

fn conf_num(key: u64, vorgabe: u64) -> u64 {
    var p: [u8; 17] = "/etc/login.conf\0\0"
    var buf: [u8; 1024] = [0 as u8; 1024]
    if read_all((&p[0]) as u64, (&buf[0]) as u64, 1024) == ulib.EOF {
        return vorgabe
    }
    let kl: u64 = text.length(key)
    var line: [u8; 128] = [0 as u8; 128]
    var i: u64 = 0
    let cnt: u64 = lines_of((&buf[0]) as u64)
    while i < cnt {
        if line_at((&buf[0]) as u64, i, (&line[0]) as u64, 128)
            != ulib.EOF {
            var at: u64 = 0
            while line[at as usize] == 32 as u8 || line[at as usize] == 9 as u8 {
                at = at + 1
            }
            if line[at as usize] != 35 as u8 {
                if ulib.strneq((&line[at as usize]) as u64, key, kl) {
                    var k: u64 = at + kl
                    while line[k as usize] == 32 as u8
                        || line[k as usize] == 9 as u8 {
                        k = k + 1
                    }
                    if line[k as usize] == 61 as u8 {
                        k = k + 1
                        while line[k as usize] == 32 as u8
                            || line[k as usize] == 9 as u8 {
                            k = k + 1
                        }
                        let v: u64 = ulib.to_num((&line[k as usize]) as u64)
                        if v != ulib.EOF {
                            return v
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return vorgabe
}
