// SPDX-License-Identifier: MIT
// kernel/user/pw.fi -- Runde K13: die Benutzerdatenbank und das Passwort.
//
// ZWEI DINGE, UND SIE GEHOEREN ZUSAMMEN.
//
// 1. /etc/passwd UND /etc/shadow. Die Form ist die gewohnte, weil es
//    keinen Grund gibt, eine neue zu erfinden:
//
//        name:x:uid:gid:beschreibung:heim:shell
//        name:$osum1$<runden>$<salz>$<abgeleitet>:0:0:99999:7:::
//
//    Das `x` in der zweiten Spalte von /etc/passwd heisst seit den
//    achtziger Jahren: "das Passwort steht woanders". Genau darum geht
//    es -- /etc/passwd darf jeder lesen (`id`, `ls -l`, `whoami`
//    brauchen es), /etc/shadow niemand ausser root (0o600). Wer beides
//    in eine Datei legt, hat einen Passwortspeicher, den jeder Prozess
//    im System lesen darf.
//
// 2. WIE EIN PASSWORT ABGELEGT WIRD, und das ist der Teil, bei dem man
//    es falsch machen kann, ohne dass etwas auffaellt.
//
//    NICHT im Klartext -- das ist die Auflage, und sie ist die
//    naheliegendste. NICHT als blosser SHA-256 des Passworts -- das ist
//    die zweite Falle: ein einzelner Hash ist in der Groessenordnung von
//    Milliarden Versuchen je Sekunde durchprobierbar, und zwei Menschen
//    mit demselben Passwort haetten denselben Eintrag.
//
//    Was hier steht, ist PBKDF2-HMAC-SHA256 (RFC 2898) mit acht Oktetten
//    Salz aus `getrandom` und 2048 Runden. Das Salz macht zwei gleiche
//    Passwoerter zu zwei verschiedenen Eintraegen und verbietet
//    vorberechnete Tabellen; die Runden machen jeden einzelnen Versuch
//    2048 mal so teuer. Beides ist ehrlich gemessen und steht in
//    docs/ROUNDK13.md: 2048 Runden sind fuer heutige Verhaeltnisse WENIG
//    (glibc nimmt 5000 bei sha512crypt, moderne Empfehlungen liegen bei
//    600000 fuer PBKDF2-HMAC-SHA256), und der Grund ist ebenso ehrlich:
//    dieses System laeuft in einer Softwareemulation ohne
//    Gleitkommaeinheit und ohne Beschleuniger, und 600000 Runden waeren
//    hier ueber vier Minuten je Anmeldung. Es ist die richtige BAUART
//    mit einer zu kleinen Zahl, und die Zahl steht in der Datei
//    (`$osum1$2048$...`), damit sie sich erhoehen laesst, ohne dass ein
//    bestehendes Passwort ungueltig wird.
//
//    NICHT gemacht: eine speicherharte Ableitung (scrypt, Argon2). Die
//    braeuchte einen Allokator, und ein Programm dieses Userlands hat
//    keinen.
//
// DER VERGLEICH LAEUFT IN KONSTANTER ZEIT (`same_dk`): ein Vergleich,
// der beim ersten falschen Oktett abbricht, verraet ueber die Laufzeit,
// wie viele Oktette stimmten.
//
// SHA-256 ist hier zu Fuss geschrieben (FIPS 180-4). Dass es das
// RICHTIGE SHA-256 ist, wird nicht behauptet, sondern gemessen: der
// Testlaeufer laesst den WIRT dieselben Eingaben durch Pythons
// `hashlib`/`hmac`/`hashlib.pbkdf2_hmac` schicken und haelt die
// Ergebnisse Zeichen fuer Zeichen dagegen.

profile kernel

import ulib
import tools

export {
    sha256, hmac256, pbkdf2, hex_out, same_dk,
    make_hash, check_hash, ITERS, DK_LEN,
    load_passwd, field, line_at, lines_of, name_of_uid, uid_of_name,
    gid_of_name, shell_of_name, home_of_name, shadow_of, PW_MAX,
    read_all, write_all, read_pass, set_shadow,
    // ------------------------------------------- RUNDE MULTIUSER
    conf_num,
    KOSTEN, VERZOEGERUNG_MS, MAX_ITERS
}

const DK_LEN: u64 = 32

// ================== RUNDE MULTIUSER: DER KOSTENFAKTOR, GEMESSEN
//
// HIER STAND 2048, und im Kopf dieser Datei stand seit K13, dass das zu
// wenig ist. Diese Runde ersetzt die Zahl nicht durch eine schoenere,
// sondern durch eine GEMESSENE -- und die Messung steht in
// docs/ROUNDMULTIUSER.md und laeuft in `tools/multiuser/run.sh` bei
// jeder Abnahme mit (`mut kdf`).
//
// WAS GEMESSEN WURDE, auf einem AMD EPYC 7571, QEMU 7.2.22:
//
//     Osum, PBKDF2-HMAC-SHA256, dieselbe Funktion wie unten,
//     8192 Runden, kleinste von drei Messungen:
//       unter -accel kvm -cpu host   268.635 us = 30.494 Runden/s
//       unter TCG (Softwareemulation) 1.965.373 us = 4.168 Runden/s
//     derselbe Wirt, OpenSSL hinter Pythons hashlib
//                                  1.768.429 Runden/s
//
// DREI ZAHLEN FOLGEN DARAUS, und die dritte ist die unangenehme:
//
//   1. Bei 8192 Runden dauert EINE PRUEFUNG auf echter Hardware
//      269 ms. Das ist das Zeitbudget, das man einer Anmeldung
//      zumuten kann, ohne dass sie sich kaputt anfuehlt -- und es ist
//      das, worauf die uebliche Empfehlung ("waehle den Kostenfaktor
//      so, dass eine Pruefung 0,25 s dauert") hinauslaeuft.
//   2. 2048 Runden dauerten 60 ms. Der Faktor ist also 4.
//   3. EIN ANGREIFER RECHNET NICHT MIT DIESEM CODE. OpenSSL ist auf
//      demselben Rechner 56 mal schneller als dieses SHA-256 in Firn
//      (kein SIMD, 32-Bit-Woerter in u64 mit Maske). Bei 8192 Runden
//      schafft ein Kern also rund 216 Rateversuche je Sekunde, 32
//      Kerne rund 6.900. Das ist der ehrliche Wert dieser Zahl, und er
//      ist der Grund, warum diese Runde ZUSAETZLICH die Verzoegerung
//      nach einem Fehlversuch einbaut: gegen ein gestohlenes
//      /etc/shadow hilft der Kostenfaktor, gegen Durchprobieren an der
//      Anmeldung hilft er kaum.
//
// WARUM NICHT 600.000, wie es fuer PBKDF2-HMAC-SHA256 empfohlen wird:
// das waeren hier 19 SEKUNDEN je Anmeldung. Die Empfehlung ist fuer
// eine Umsetzung geschrieben, die eine halbe Million Runden in einer
// drittel Sekunde schafft; diese hier schafft 31.400 in einer Sekunde.
// Eine Zahl abzuschreiben, ohne die Maschine darunter zu messen, waere
// Sicherheitstheater.
//
// WARUM NICHT Argon2id, was der Auftrag bevorzugt haette: es braucht
// SPEICHER, und ein Programm dieses Userlands hat keinen Allokator
// (weder `malloc` noch `brk` in `ulib`). Ein festes Feld waere machbar,
// aber Argon2id braucht darunter BLAKE2b, und BLAKE2b ist eine zweite
// Hashfunktion, die geschrieben UND gegen RFC-Vektoren gemessen werden
// muesste. Was daran fehlt, steht als Luecke in
// docs/ROUNDMULTIUSER.md -- ausgeschrieben und nicht verschwiegen.
// DIE FORM DES EINTRAGS IST DARAUF VORBEREITET: `$osum1$` ist eine
// Kennung des VERFAHRENS, und ein `$osum2$` daneben aendert an keinem
// bestehenden Eintrag etwas.
const ITERS: u64 = 8192

// Die Obergrenze, die `check_hash` einem Eintrag zugesteht. Sie stand
// auf 100.000 -- also UNTER dem, was heute empfohlen wird, und damit
// haette ein Administrator den Kostenfaktor gar nicht hoch genug
// stellen koennen. Sie ist eine Notbremse gegen einen VERDORBENEN
// Eintrag (ein `$osum1$99999999999$...` in einer kaputten Datei wuerde
// die Anmeldung fuer immer haengen lassen), nicht eine Vorgabe. Zehn
// Millionen Runden sind hier fuenf Minuten; das faellt auf, ohne dass
// jemand mit einer Zahl ausgesperrt wird, die er absichtlich gewaehlt
// hat.
const MAX_ITERS: u64 = 10000000

// Die zwei Werte aus /etc/login.conf, wenn es die Datei nicht gibt.
// `kosten` ist die Rundenzahl fuer NEUE Passwoerter -- ein
// BESTEHENDER Eintrag traegt seine eigene bei sich und bleibt
// gueltig. `verzoegerung` ist, was `login` nach dem ERSTEN Fehlversuch
// wartet; danach verdoppelt es sich.
const KOSTEN: u64 = 8192
const VERZOEGERUNG_MS: u64 = 1000

const PW_MAX: u64 = 4096

// ---------------------------------------------------------- SHA-256

const M32: u64 = 0xFFFFFFFF

static mut kt: [u64; 64] = [0 as u64; 64]
static mut kt_ready: u64 = 0
static mut msg: [u8; 320] = [0 as u8; 320]

fn ktab() {
    if kt_ready != 0 {
        return
    }
    kt[0] = 0x428a2f98
    kt[1] = 0x71374491
    kt[2] = 0xb5c0fbcf
    kt[3] = 0xe9b5dba5
    kt[4] = 0x3956c25b
    kt[5] = 0x59f111f1
    kt[6] = 0x923f82a4
    kt[7] = 0xab1c5ed5
    kt[8] = 0xd807aa98
    kt[9] = 0x12835b01
    kt[10] = 0x243185be
    kt[11] = 0x550c7dc3
    kt[12] = 0x72be5d74
    kt[13] = 0x80deb1fe
    kt[14] = 0x9bdc06a7
    kt[15] = 0xc19bf174
    kt[16] = 0xe49b69c1
    kt[17] = 0xefbe4786
    kt[18] = 0x0fc19dc6
    kt[19] = 0x240ca1cc
    kt[20] = 0x2de92c6f
    kt[21] = 0x4a7484aa
    kt[22] = 0x5cb0a9dc
    kt[23] = 0x76f988da
    kt[24] = 0x983e5152
    kt[25] = 0xa831c66d
    kt[26] = 0xb00327c8
    kt[27] = 0xbf597fc7
    kt[28] = 0xc6e00bf3
    kt[29] = 0xd5a79147
    kt[30] = 0x06ca6351
    kt[31] = 0x14292967
    kt[32] = 0x27b70a85
    kt[33] = 0x2e1b2138
    kt[34] = 0x4d2c6dfc
    kt[35] = 0x53380d13
    kt[36] = 0x650a7354
    kt[37] = 0x766a0abb
    kt[38] = 0x81c2c92e
    kt[39] = 0x92722c85
    kt[40] = 0xa2bfe8a1
    kt[41] = 0xa81a664b
    kt[42] = 0xc24b8b70
    kt[43] = 0xc76c51a3
    kt[44] = 0xd192e819
    kt[45] = 0xd6990624
    kt[46] = 0xf40e3585
    kt[47] = 0x106aa070
    kt[48] = 0x19a4c116
    kt[49] = 0x1e376c08
    kt[50] = 0x2748774c
    kt[51] = 0x34b0bcb5
    kt[52] = 0x391c0cb3
    kt[53] = 0x4ed8aa4a
    kt[54] = 0x5b9cca4f
    kt[55] = 0x682e6ff3
    kt[56] = 0x748f82ee
    kt[57] = 0x78a5636f
    kt[58] = 0x84c87814
    kt[59] = 0x8cc70208
    kt[60] = 0x90befffa
    kt[61] = 0xa4506ceb
    kt[62] = 0xbef9a3f7
    kt[63] = 0xc67178f2
    kt_ready = 1
}

fn rotr(x: u64, n: u64) -> u64 {
    let v: u64 = x & M32
    return ((v >> n) | (v << (32 - n))) & M32
}

// Ein Block von 64 Oktetten in den Zustand. `h` zeigt auf acht Woerter.
fn block(h: u64, at: u64) {
    var w: [u64; 64] = [0 as u64; 64]
    var i: u64 = 0
    while i < 16 {
        w[i as usize] = ((msg[(at + i * 4) as usize] as u64) << 24)
            | ((msg[(at + i * 4 + 1) as usize] as u64) << 16)
            | ((msg[(at + i * 4 + 2) as usize] as u64) << 8)
            | (msg[(at + i * 4 + 3) as usize] as u64)
        i = i + 1
    }
    while i < 64 {
        let a: u64 = w[(i - 15) as usize]
        let b: u64 = w[(i - 2) as usize]
        let s0: u64 = rotr(a, 7) ^ rotr(a, 18) ^ ((a & M32) >> 3)
        let s1: u64 = rotr(b, 17) ^ rotr(b, 19) ^ ((b & M32) >> 10)
        w[i as usize] = (w[(i - 16) as usize] + s0 + w[(i - 7) as usize]
            + s1) & M32
        i = i + 1
    }
    var a: u64 = *((h) as *mut u64)
    var b: u64 = *((h + 8) as *mut u64)
    var c: u64 = *((h + 16) as *mut u64)
    var d: u64 = *((h + 24) as *mut u64)
    var e: u64 = *((h + 32) as *mut u64)
    var f: u64 = *((h + 40) as *mut u64)
    var g: u64 = *((h + 48) as *mut u64)
    var hh: u64 = *((h + 56) as *mut u64)
    var t: u64 = 0
    while t < 64 {
        let S1: u64 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
        let ch: u64 = (e & f) ^ ((~e) & g & M32)
        let t1: u64 = (hh + S1 + ch + kt[t as usize] + w[t as usize]) & M32
        let S0: u64 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
        let mj: u64 = (a & b) ^ (a & c) ^ (b & c)
        let t2: u64 = (S0 + mj) & M32
        hh = g
        g = f
        f = e
        e = (d + t1) & M32
        d = c
        c = b
        b = a
        a = (t1 + t2) & M32
        t = t + 1
    }
    __mmio_write64((h) as *mut u64, (*((h) as *mut u64) + a) & M32)
    __mmio_write64((h + 8) as *mut u64, (*((h + 8) as *mut u64) + b) & M32)
    __mmio_write64((h + 16) as *mut u64, (*((h + 16) as *mut u64) + c) & M32)
    __mmio_write64((h + 24) as *mut u64, (*((h + 24) as *mut u64) + d) & M32)
    __mmio_write64((h + 32) as *mut u64, (*((h + 32) as *mut u64) + e) & M32)
    __mmio_write64((h + 40) as *mut u64, (*((h + 40) as *mut u64) + f) & M32)
    __mmio_write64((h + 48) as *mut u64, (*((h + 48) as *mut u64) + g) & M32)
    __mmio_write64((h + 56) as *mut u64, (*((h + 56) as *mut u64) + hh) & M32)
}

// SHA-256 ueber hoechstens 256 Oktette. Mehr braucht niemand hier: der
// laengste Aufruf ist HMAC ueber 64 Oktette Polster plus 32 Oktette
// Zwischenwert.
fn sha256(p: u64, len: u64, out: u64) -> bool {
    if len > 256 {
        return false
    }
    ktab()
    var h: [u64; 8] = [0 as u64; 8]
    h[0] = 0x6a09e667
    h[1] = 0xbb67ae85
    h[2] = 0x3c6ef372
    h[3] = 0xa54ff53a
    h[4] = 0x510e527f
    h[5] = 0x9b05688c
    h[6] = 0x1f83d9ab
    h[7] = 0x5be0cd19
    var i: u64 = 0
    while i < len {
        msg[i as usize] = *((p + i) as *mut u8)
        i = i + 1
    }
    msg[len as usize] = 0x80 as u8
    var total: u64 = ((len + 9 + 63) / 64) * 64
    i = len + 1
    while i < total {
        msg[i as usize] = 0 as u8
        i = i + 1
    }
    let bits: u64 = len * 8
    i = 0
    while i < 8 {
        msg[(total - 1 - i) as usize] = ((bits >> (i * 8)) & 255) as u8
        i = i + 1
    }
    var at: u64 = 0
    while at < total {
        block((&h[0]) as u64, at)
        at = at + 64
    }
    i = 0
    while i < 8 {
        let v: u64 = h[i as usize]
        __mmio_write8((out + i * 4) as *mut u8, ((v >> 24) & 255) as u8)
        __mmio_write8((out + i * 4 + 1) as *mut u8, ((v >> 16) & 255) as u8)
        __mmio_write8((out + i * 4 + 2) as *mut u8, ((v >> 8) & 255) as u8)
        __mmio_write8((out + i * 4 + 3) as *mut u8, (v & 255) as u8)
        i = i + 1
    }
    return true
}

// HMAC-SHA256 (RFC 2104). Der Schluessel ist hier immer kuerzer als 64
// Oktette; der Fall "laenger" ist trotzdem da, weil er sonst genau dann
// fehlt, wenn ihn jemand braucht.
fn hmac256(key: u64, klen: u64, m: u64, mlen: u64, out: u64) -> bool {
    var k0: [u8; 64] = [0 as u8; 64]
    var tmp: [u8; 32] = [0 as u8; 32]
    var i: u64 = 0
    if klen > 64 {
        if !sha256(key, klen, (&tmp[0]) as u64) {
            return false
        }
        while i < 32 {
            k0[i as usize] = tmp[i as usize]
            i = i + 1
        }
    } else {
        while i < klen {
            k0[i as usize] = *((key + i) as *mut u8)
            i = i + 1
        }
    }
    var inner: [u8; 128] = [0 as u8; 128]
    var outer: [u8; 128] = [0 as u8; 128]
    i = 0
    while i < 64 {
        inner[i as usize] = ((k0[i as usize] as u64) ^ 0x36) as u8
        outer[i as usize] = ((k0[i as usize] as u64) ^ 0x5C) as u8
        i = i + 1
    }
    if mlen > 64 {
        return false
    }
    i = 0
    while i < mlen {
        inner[(64 + i) as usize] = *((m + i) as *mut u8)
        i = i + 1
    }
    if !sha256((&inner[0]) as u64, 64 + mlen, (&tmp[0]) as u64) {
        return false
    }
    i = 0
    while i < 32 {
        outer[(64 + i) as usize] = tmp[i as usize]
        i = i + 1
    }
    return sha256((&outer[0]) as u64, 96, out)
}

// PBKDF2-HMAC-SHA256 mit dkLen = 32, also genau EINEM Block. Der
// Blockindex ist deshalb fest 1, und die Schleife ist die aus RFC 2898,
// Abschnitt 5.2.
fn pbkdf2(pw: u64, plen: u64, salt: u64, slen: u64, iters: u64,
    out: u64) -> bool {
    if slen > 60 {
        return false
    }
    var first: [u8; 64] = [0 as u8; 64]
    var u: [u8; 32] = [0 as u8; 32]
    var t: [u8; 32] = [0 as u8; 32]
    var i: u64 = 0
    while i < slen {
        first[i as usize] = *((salt + i) as *mut u8)
        i = i + 1
    }
    first[slen as usize] = 0 as u8
    first[(slen + 1) as usize] = 0 as u8
    first[(slen + 2) as usize] = 0 as u8
    first[(slen + 3) as usize] = 1 as u8
    if !hmac256(pw, plen, (&first[0]) as u64, slen + 4, (&u[0]) as u64) {
        return false
    }
    i = 0
    while i < 32 {
        t[i as usize] = u[i as usize]
        i = i + 1
    }
    var r: u64 = 1
    while r < iters {
        if !hmac256(pw, plen, (&u[0]) as u64, 32, (&u[0]) as u64) {
            return false
        }
        i = 0
        while i < 32 {
            t[i as usize] = ((t[i as usize] as u64) ^ (u[i as usize] as u64)) as u8
            i = i + 1
        }
        r = r + 1
    }
    i = 0
    while i < 32 {
        __mmio_write8((out + i) as *mut u8, t[i as usize])
        i = i + 1
    }
    return true
}

// --------------------------------------------------------- Hexadezimal

fn hex_out(p: u64, n: u64, out: u64) {
    var d: [u8; 17] = "0123456789abcdef\0"
    var i: u64 = 0
    while i < n {
        let v: u64 = (*((p + i) as *mut u8)) as u64
        __mmio_write8((out + i * 2) as *mut u8, d[((v >> 4) & 15) as usize])
        __mmio_write8((out + i * 2 + 1) as *mut u8, d[(v & 15) as usize])
        i = i + 1
    }
    __mmio_write8((out + n * 2) as *mut u8, 0 as u8)
}

// Zwei Zeichenketten in KONSTANTER ZEIT. Ein Vergleich, der beim ersten
// Unterschied stehenbleibt, sagt ueber seine Laufzeit, wie weit er
// gekommen ist -- bei einem Passwortvergleich ist das eine Auskunft, die
// niemand geben will.
fn same_dk(a: u64, b: u64, n: u64) -> bool {
    var diff: u64 = 0
    var i: u64 = 0
    while i < n {
        diff = diff | ((*((a + i) as *mut u8)) as u64
            ^ (*((b + i) as *mut u8)) as u64)
        i = i + 1
    }
    return diff == 0
}

// ------------------------------------------- der Eintrag in /etc/shadow

// `$osum1$<runden>$<salz-hex>$<abgeleitet-hex>` in `out`. Das Salz kommt
// aus `getrandom` -- acht Oktette, und wenn der Kern keinen Zufall
// liefert, wird KEIN Eintrag gebaut, statt einen mit vorhersagbarem Salz
// zu bauen.
fn make_hash(pw: u64, out: u64) -> bool {
    var salt: [u8; 8] = [0 as u8; 8]
    var dk: [u8; 32] = [0 as u8; 32]
    var shex: [u8; 20] = [0 as u8; 20]
    var dhex: [u8; 72] = [0 as u8; 72]
    var head: [u8; 8] = "$osum1$\0"
    var dollar: [u8; 2] = "$\0"
    let got: u64 = ulib.sys(318, (&salt[0]) as u64, 8, 0)
    if ulib.bad(got) || got != 8 {
        return false
    }
    // RUNDE MULTIUSER: die Rundenzahl kommt aus /etc/login.conf, wenn
    // dort eine steht, sonst ist es ITERS. Ein Administrator soll den
    // Kostenfaktor heraufsetzen koennen, ohne den Kernel neu zu bauen
    // -- und der Eintrag traegt die gewaehlte Zahl bei sich, also
    // bleibt jedes bestehende Passwort gueltig.
    var runden: [u8; 12] = "kdf_runden\0\0"
    var it: u64 = conf_num((&runden[0]) as u64, KOSTEN)
    if it == 0 || it > MAX_ITERS {
        it = KOSTEN
    }
    if !pbkdf2(pw, ulib.length(pw), (&salt[0]) as u64, 8, it,
        (&dk[0]) as u64) {
        return false
    }
    hex_out((&salt[0]) as u64, 8, (&shex[0]) as u64)
    hex_out((&dk[0]) as u64, 32, (&dhex[0]) as u64)
    var at: u64 = ulib.strcpy(out, (&head[0]) as u64)
    var num: [u8; 24] = [0 as u8; 24]
    ulib.digits(it, (&num[0]) as u64)
    at = at + ulib.strcpy(out + at, (&num[0]) as u64)
    at = at + ulib.strcpy(out + at, (&dollar[0]) as u64)
    at = at + ulib.strcpy(out + at, (&shex[0]) as u64)
    at = at + ulib.strcpy(out + at, (&dollar[0]) as u64)
    ulib.strcpy(out + at, (&dhex[0]) as u64)
    return true
}

fn hexval(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return 16
}

// Stimmt `pw` zu dem Eintrag `rec`? Der Eintrag traegt seine eigene
// Rundenzahl und sein eigenes Salz mit sich -- ein alter Eintrag bleibt
// deshalb gueltig, wenn ITERS spaeter steigt.
fn check_hash(rec: u64, pw: u64) -> bool {
    var head: [u8; 8] = "$osum1$\0"
    if !ulib.strneq(rec, (&head[0]) as u64, 7) {
        return false
    }
    var at: u64 = 7
    let iters: u64 = ulib.to_num(rec + at)
    while *((rec + at) as *mut u8) != 36 as u8 {
        if *((rec + at) as *mut u8) == 0 as u8 {
            return false
        }
        at = at + 1
    }
    at = at + 1
    var salt: [u8; 32] = [0 as u8; 32]
    var slen: u64 = 0
    while *((rec + at) as *mut u8) != 36 as u8 {
        let hi: u64 = hexval((*((rec + at) as *mut u8)) as u64)
        let lo: u64 = hexval((*((rec + at + 1) as *mut u8)) as u64)
        if hi > 15 || lo > 15 || slen >= 32 {
            return false
        }
        salt[slen as usize] = ((hi << 4) | lo) as u8
        slen = slen + 1
        at = at + 2
    }
    at = at + 1
    var want: [u8; 32] = [0 as u8; 32]
    var wlen: u64 = 0
    while *((rec + at) as *mut u8) != 0 as u8 && wlen < 32 {
        let hi: u64 = hexval((*((rec + at) as *mut u8)) as u64)
        let lo: u64 = hexval((*((rec + at + 1) as *mut u8)) as u64)
        if hi > 15 || lo > 15 {
            return false
        }
        want[wlen as usize] = ((hi << 4) | lo) as u8
        wlen = wlen + 1
        at = at + 2
    }
    if wlen != 32 || iters == 0 || iters > MAX_ITERS {
        return false
    }
    var dk: [u8; 32] = [0 as u8; 32]
    if !pbkdf2(pw, ulib.length(pw), (&salt[0]) as u64, slen, iters,
        (&dk[0]) as u64) {
        return false
    }
    return same_dk((&dk[0]) as u64, (&want[0]) as u64, 32)
}

// ------------------------------------------------------ die Datenbank

static mut pwbuf: [u8; 4096] = [0 as u8; 4096]
static mut pwlen: u64 = 0
static mut shbuf: [u8; 4096] = [0 as u8; 4096]

// Eine ganze Datei in einen Puffer. Kein Allokator, also feste Groesse
// und eine ehrliche Grenze: was nicht hineinpasst, wird abgeschnitten,
// und die Zeile danach beginnt nicht mitten in einem Namen, weil nur
// GANZE Zeilen verwendet werden.
fn read_all(path: u64, buf: u64, max: u64) -> u64 {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, 0, 0)
    if ulib.bad(fd) {
        return ulib.EOF
    }
    var at: u64 = 0
    var going: bool = true
    while going {
        let n: u64 = ulib.sys(ulib.SYS_READ, fd, buf + at, max - 1 - at)
        if ulib.bad(n) || n == 0 {
            going = false
        } else {
            at = at + n
            if at + 1 >= max {
                going = false
            }
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    __mmio_write8((buf + at) as *mut u8, 0 as u8)
    return at
}

fn load_passwd() -> u64 {
    var p: [u8; 12] = "/etc/passwd\0"
    let n: u64 = read_all((&p[0]) as u64, (&pwbuf[0]) as u64, 4096)
    if n == ulib.EOF {
        pwlen = 0
        return ulib.EOF
    }
    pwlen = n
    return n
}

fn lines_of(buf: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while *((buf + i) as *mut u8) != 0 as u8 {
        if *((buf + i) as *mut u8) == 10 as u8 {
            n = n + 1
        }
        i = i + 1
    }
    if i > 0 && *((buf + i - 1) as *mut u8) != 10 as u8 {
        n = n + 1
    }
    return n
}

// Die `i`-te Zeile in `out`, ohne Zeilenende. EOF, wenn es sie nicht
// gibt.
fn line_at(buf: u64, i: u64, out: u64, max: u64) -> u64 {
    var at: u64 = 0
    var k: u64 = 0
    while k < i {
        while *((buf + at) as *mut u8) != 10 as u8 {
            if *((buf + at) as *mut u8) == 0 as u8 {
                return ulib.EOF
            }
            at = at + 1
        }
        at = at + 1
        k = k + 1
    }
    if *((buf + at) as *mut u8) == 0 as u8 {
        return ulib.EOF
    }
    var n: u64 = 0
    while *((buf + at) as *mut u8) != 0 as u8
        && *((buf + at) as *mut u8) != 10 as u8 {
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, *((buf + at) as *mut u8))
            n = n + 1
        }
        at = at + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return n
}

// Das `k`-te Feld einer Zeile, durch ':' getrennt.
fn field(line: u64, k: u64, out: u64, max: u64) -> bool {
    var at: u64 = 0
    var f: u64 = 0
    while f < k {
        while *((line + at) as *mut u8) != 58 as u8 {
            if *((line + at) as *mut u8) == 0 as u8 {
                __mmio_write8((out) as *mut u8, 0 as u8)
                return false
            }
            at = at + 1
        }
        at = at + 1
        f = f + 1
    }
    var n: u64 = 0
    while *((line + at) as *mut u8) != 0 as u8
        && *((line + at) as *mut u8) != 58 as u8 {
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, *((line + at) as *mut u8))
            n = n + 1
        }
        at = at + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return true
}

// Das Feld `want` des Eintrags mit dem Namen `name`, oder false.
fn pw_field(name: u64, want: u64, out: u64, max: u64) -> bool {
    if pwlen == 0 {
        if load_passwd() == ulib.EOF {
            return false
        }
    }
    var line: [u8; 256] = [0 as u8; 256]
    var f: [u8; 128] = [0 as u8; 128]
    var i: u64 = 0
    let n: u64 = lines_of((&pwbuf[0]) as u64)
    while i < n {
        if line_at((&pwbuf[0]) as u64, i, (&line[0]) as u64, 256) != ulib.EOF {
            field((&line[0]) as u64, 0, (&f[0]) as u64, 128)
            if ulib.streq((&f[0]) as u64, name) {
                return field((&line[0]) as u64, want, out, max)
            }
        }
        i = i + 1
    }
    return false
}

fn uid_of_name(name: u64) -> u64 {
    var f: [u8; 32] = [0 as u8; 32]
    if !pw_field(name, 2, (&f[0]) as u64, 32) {
        return ulib.EOF
    }
    return ulib.to_num((&f[0]) as u64)
}

fn gid_of_name(name: u64) -> u64 {
    var f: [u8; 32] = [0 as u8; 32]
    if !pw_field(name, 3, (&f[0]) as u64, 32) {
        return ulib.EOF
    }
    return ulib.to_num((&f[0]) as u64)
}

fn shell_of_name(name: u64, out: u64, max: u64) -> bool {
    return pw_field(name, 6, out, max)
}

fn home_of_name(name: u64, out: u64, max: u64) -> bool {
    return pw_field(name, 5, out, max)
}

// Der Name zu einer Kennung. Findet sich keiner, wird nichts erfunden --
// `id` schreibt dann die Zahl, wie es sich gehoert.
fn name_of_uid(uid: u64, out: u64, max: u64) -> bool {
    if pwlen == 0 {
        if load_passwd() == ulib.EOF {
            return false
        }
    }
    var line: [u8; 256] = [0 as u8; 256]
    var f: [u8; 128] = [0 as u8; 128]
    var i: u64 = 0
    let n: u64 = lines_of((&pwbuf[0]) as u64)
    while i < n {
        if line_at((&pwbuf[0]) as u64, i, (&line[0]) as u64, 256) != ulib.EOF {
            field((&line[0]) as u64, 2, (&f[0]) as u64, 128)
            if ulib.to_num((&f[0]) as u64) == uid {
                return field((&line[0]) as u64, 0, out, max)
            }
        }
        i = i + 1
    }
    return false
}

// Der Passworteintrag aus /etc/shadow. Wer die Datei nicht lesen darf,
// bekommt false -- und das ist kein Fehler des Programms, sondern der
// Sinn der Datei.
fn shadow_of(name: u64, out: u64, max: u64) -> bool {
    var p: [u8; 12] = "/etc/shadow\0"
    let n: u64 = read_all((&p[0]) as u64, (&shbuf[0]) as u64, 4096)
    if n == ulib.EOF {
        return false
    }
    var line: [u8; 256] = [0 as u8; 256]
    var f: [u8; 128] = [0 as u8; 128]
    var i: u64 = 0
    let cnt: u64 = lines_of((&shbuf[0]) as u64)
    while i < cnt {
        if line_at((&shbuf[0]) as u64, i, (&line[0]) as u64, 256) != ulib.EOF {
            field((&line[0]) as u64, 0, (&f[0]) as u64, 128)
            if ulib.streq((&f[0]) as u64, name) {
                return field((&line[0]) as u64, 1, out, max)
            }
        }
        i = i + 1
    }
    return false
}

// ------------------------------------------------- schreiben und fragen

// Eine ganze Datei, geschrieben. `O_WRONLY|O_CREAT|O_TRUNC` = 577, das
// ist dasselbe, was ein `>` in der Shell bedeutet.
fn write_all(path: u64, buf: u64, len: u64) -> bool {
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, 577, 0)
    if ulib.bad(fd) {
        return false
    }
    var at: u64 = 0
    while at < len {
        let n: u64 = ulib.sys(ulib.SYS_WRITE, fd, buf + at, len - at)
        if ulib.bad(n) || n == 0 {
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
            return false
        }
        at = at + n
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return true
}

// DAS PASSWORT EINLESEN, und zwar so, wie es sich gehoert:
//
//   * Haengt an Deskriptor 0 ein TERMINAL, wird die Eingabeaufforderung
//     geschrieben und das ECHO ABGESCHALTET -- ein Passwort, das auf dem
//     Schirm steht, ist keines. Danach wird der alte Zustand des
//     Terminals wiederhergestellt, auch wenn nichts kam.
//   * Haengt dort etwas anderes -- eine Datei, eine Roehre --, wird
//     NICHT gefragt und einfach eine Zeile gelesen. Das ist genau, was
//     `passwd < datei` in einem Skript tut, und es ist der Grund, warum
//     diese Programme ueberhaupt messbar sind: die Shell dieses Systems
//     liest ihr Skript in Bloecken von 512 Oktetten und haette die
//     Antwort sonst schon verschluckt.
//
// GELESEN WIRD OKTETT FUER OKTETT. Ein Puffer waere hier falsch: was
// hinter der Zeile steht, gehoert dem naechsten Leser.
fn read_pass(prompt: u64, out: u64, max: u64) -> u64 {
    var t: [u8; 40] = [0 as u8; 40]
    var saved: [u8; 40] = [0 as u8; 40]
    var tty: bool = false
    if !ulib.bad(ulib.sys(16, 0, 0x5401, (&t[0]) as u64)) {
        tty = true
        var i: u64 = 0
        while i < 36 {
            saved[i as usize] = t[i as usize]
            i = i + 1
        }
        // c_lflag steht bei +12; ECHO ist Bit 3 (0o10).
        let lf: u64 = __mmio_read32((((&t[12]) as u64)) as *mut u32) as u64
        __mmio_write32((((&t[12]) as u64)) as *mut u32,
            (lf & 0xFFFFFFF7) as u32)
        ulib.sys(16, 0, 0x5404, (&t[0]) as u64)
        if prompt != 0 {
            ulib.eput(prompt)
        }
    }
    var n: u64 = 0
    var c: [u8; 1] = [0 as u8; 1]
    var going: bool = true
    while going {
        let r: u64 = ulib.sys(ulib.SYS_READ, 0, (&c[0]) as u64, 1)
        if ulib.bad(r) || r == 0 {
            going = false
        } else {
            if c[0 as usize] == 10 as u8 || c[0 as usize] == 13 as u8 {
                going = false
            } else {
                if n + 1 < max {
                    __mmio_write8((out + n) as *mut u8, c[0 as usize])
                    n = n + 1
                }
            }
        }
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    if tty {
        ulib.sys(16, 0, 0x5404, (&saved[0]) as u64)
        var nlc: [u8; 2] = "\n\0"
        ulib.eput((&nlc[0]) as u64)
    }
    return n
}

// Den Eintrag eines Benutzers in /etc/shadow ersetzen oder anhaengen.
//
// RUNDE MULTIUSER: UEBER EINE ZWISCHENDATEI UND `rename`. Hier stand
// bis zu dieser Runde die ehrliche Grenze "ohne Zwischendatei, weil
// dieses Dateisystem kein `rename` hat" -- und sie stimmt seit Runde
// OFS3 nicht mehr: `SYS_RENAME` (82) steht in der Aufruftabelle, und
// `fs.rename_path` haengt einen Namen innerhalb desselben
// Dateisystems um.
//
// Warum das mehr ist als Ordnungsliebe: `write_all` oeffnet die Datei
// mit O_TRUNC. Zwischen dem Abschneiden und dem letzten geschriebenen
// Oktett ist /etc/shadow LEER oder HALB -- und wer in genau diesem
// Augenblick den Strom verliert, hat ein System, an dem sich niemand
// mehr anmelden kann. Mit der Zwischendatei ist der gefaehrliche
// Zeitraum EIN Verzeichniseintrag lang: entweder steht der alte Name
// auf der alten Inode oder auf der neuen, ein Drittes gibt es nicht.
//
// Die Zwischendatei entsteht MIT DEN RECHTEN, die sie am Ende haben
// soll (0o600, root), und nicht mit denen, die die Maske gerade
// hergibt -- sonst waere /etc/shadow fuer die Dauer eines `passwd`
// lesbar. `chmod` unmittelbar nach dem Anlegen, vor dem ersten
// geschriebenen Oktett.
fn set_shadow(name: u64, rec: u64) -> bool {
    var path: [u8; 12] = "/etc/shadow\0"
    var out: [u8; 4096] = [0 as u8; 4096]
    var line: [u8; 256] = [0 as u8; 256]
    var f: [u8; 128] = [0 as u8; 128]
    var tail: [u8; 16] = ":0:0:99999:7:::\0"
    var colon: [u8; 2] = ":\0"
    var nlc: [u8; 2] = "\n\0"
    let have: u64 = read_all((&path[0]) as u64, (&shbuf[0]) as u64, 4096)
    var at: u64 = 0
    var found: bool = false
    if have != ulib.EOF {
        let cnt: u64 = lines_of((&shbuf[0]) as u64)
        var i: u64 = 0
        while i < cnt {
            if line_at((&shbuf[0]) as u64, i, (&line[0]) as u64, 256)
                != ulib.EOF {
                field((&line[0]) as u64, 0, (&f[0]) as u64, 128)
                if ulib.streq((&f[0]) as u64, name) {
                    found = true
                    at = at + ulib.strcpy((&out[at as usize]) as u64, name)
                    at = at + ulib.strcpy((&out[at as usize]) as u64,
                        (&colon[0]) as u64)
                    at = at + ulib.strcpy((&out[at as usize]) as u64, rec)
                    at = at + ulib.strcpy((&out[at as usize]) as u64,
                        (&tail[0]) as u64)
                } else {
                    at = at + ulib.strcpy((&out[at as usize]) as u64,
                        (&line[0]) as u64)
                }
                at = at + ulib.strcpy((&out[at as usize]) as u64,
                    (&nlc[0]) as u64)
            }
            i = i + 1
        }
    }
    if !found {
        at = at + ulib.strcpy((&out[at as usize]) as u64, name)
        at = at + ulib.strcpy((&out[at as usize]) as u64, (&colon[0]) as u64)
        at = at + ulib.strcpy((&out[at as usize]) as u64, rec)
        at = at + ulib.strcpy((&out[at as usize]) as u64, (&tail[0]) as u64)
        at = at + ulib.strcpy((&out[at as usize]) as u64, (&nlc[0]) as u64)
    }
    // ============================ DIE VIER SCHRITTE, UND WARUM VIER
    //
    // GEMESSEN, NICHT ANGENOMMEN: `rename` dieses Kernels UEBERSCHREIBT
    // NICHT. Runde K14 hat das ausdruecklich so entschieden und in
    // `fs.rename_path` hingeschrieben ("dieser Kernel ueberschreibt
    // nicht still"), und `tools/k14/run.sh` misst es. Der erste Versuch
    // dieser Runde war das naive `schreib .neu, rename ueber shadow` --
    // er kam mit -EEXIST (-17) zurueck, und das steht hier, weil es der
    // Grund fuer die vier Schritte ist:
    //
    //   1. /etc/shadow.neu schreiben, mit 0o600 VOR dem ersten Oktett
    //   2. /etc/shadow  ->  /etc/shadow.alt     (umbenennen, nicht loeschen)
    //   3. /etc/shadow.neu  ->  /etc/shadow
    //   4. /etc/shadow.alt loeschen
    //
    // WAS DAS WERT IST: zu KEINEM Zeitpunkt sind die alten Oktette weg.
    // Faellt der Strom aus, findet man vor:
    //   nach 1: shadow (alt, ganz) + shadow.neu       -> nichts verloren
    //   nach 2: shadow.alt (alt, ganz) + shadow.neu   -> beides da
    //   nach 3: shadow (neu, ganz) + shadow.alt       -> beides da
    // Die alte Fassung ohne Zwischendatei hatte dagegen ein Fenster von
    // der Laenge eines ganzen Schreibvorgangs, in dem /etc/shadow LEER
    // war -- O_TRUNC schneidet ab, bevor das erste Oktett kommt. Ein
    // System, das in diesem Fenster abstuerzt, laesst niemanden mehr
    // herein.
    //
    // WAS BLEIBT: zwischen 2 und 3 gibt es kurz KEIN /etc/shadow. Das
    // ist zwei Verzeichnisoperationen lang und ohne Ein-/Ausgabe
    // dazwischen -- aber es ist nicht null, und ein `rename`, das nach
    // POSIX ersetzt, waere die richtige Antwort darauf. Das steht als
    // Luecke in docs/ROUNDMULTIUSER.md und nicht als erledigt.
    var tmp: [u8; 16] = "/etc/shadow.neu\0"
    var vor: [u8; 16] = "/etc/shadow.alt\0"
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&tmp[0]) as u64, 577, 0)
    if ulib.bad(fd) {
        return false
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    // ================== RECHTE UND EIGENTUEMER, BEVOR ETWAS DRINSTEHT
    //
    // GEMESSEN UND NICHT ANGENOMMEN: die frische Datei bekommt
    // Eigentuemer und Gruppe aus den WIRKSAMEN Kennungen dessen, der
    // sie anlegt (`perm.on_create`). Bei `passwd` ist die wirksame
    // BENUTZERkennung 0 -- das setuid-Bit -- die wirksame GRUPPE aber
    // die des Menschen davor. Der erste Lauf dieser Runde hat genau
    // das produziert: `/etc/shadow 600 0 1000`, also root:justin. Mit
    // 0o600 ist das nicht ausnutzbar, aber es ist falsch, und beim
    // naechsten `chmod 0640` waere es eine offene Tuer.
    //
    // Also werden Rechte UND Eigentuemer der alten Datei uebernommen,
    // bevor das erste Oktett geschrieben wird. Findet sich keine alte
    // Datei, gilt 0o600 root:root -- das, was /etc/shadow haben muss.
    var st: [u8; 144] = [0 as u8; 144]
    var mode: u64 = 384 // 0o600
    var ouid: u64 = 0
    var ogid: u64 = 0
    if !ulib.bad(ulib.sys(4, (&path[0]) as u64, (&st[0]) as u64, 0)) {
        mode = ((*((&st[24]) as *mut u32)) as u64) & 4095
        ouid = (*((&st[28]) as *mut u32)) as u64
        ogid = (*((&st[32]) as *mut u32)) as u64
    }
    ulib.sys(90, (&tmp[0]) as u64, mode, 0)
    ulib.sys(92, (&tmp[0]) as u64, ouid, ogid)
    if !write_all((&tmp[0]) as u64, (&out[0]) as u64, at) {
        ulib.sys(ulib.SYS_UNLINK, (&tmp[0]) as u64, 0, 0)
        return false
    }
    // Ein Rest aus einem abgebrochenen Lauf steht im Weg -- weg damit,
    // BEVOR etwas Wertvolles darauf zeigt.
    ulib.sys(ulib.SYS_UNLINK, (&vor[0]) as u64, 0, 0)
    let hatte: bool = !ulib.bad(ulib.sys(ulib.SYS_RENAME,
        (&path[0]) as u64, (&vor[0]) as u64, 0))
    if ulib.bad(ulib.sys(ulib.SYS_RENAME, (&tmp[0]) as u64,
        (&path[0]) as u64, 0)) {
        // Schritt 3 ging schief. Dann zurueck -- lieber das alte
        // Passwort als gar keines.
        if hatte {
            ulib.sys(ulib.SYS_RENAME, (&vor[0]) as u64, (&path[0]) as u64, 0)
        }
        ulib.sys(ulib.SYS_UNLINK, (&tmp[0]) as u64, 0, 0)
        return false
    }
    ulib.sys(ulib.SYS_UNLINK, (&vor[0]) as u64, 0, 0)
    return true
}

// ============================ RUNDE MULTIUSER: /etc/login.conf
//
// EINE ZAHL AUS EINER DATEI, in der einfachsten Form, die noch ein
// Format ist:
//
//     # Zeilen mit # sind Kommentar
//     kdf_runden = 8192
//     verzoegerung_ms = 1000
//     max_versuche = 3
//
// WARUM ES DIE DATEI GIBT: der Kostenfaktor unten ist gemessen -- auf
// DIESER Maschine. Auf einer anderen ist er falsch. Ein Wert, den man
// nur durch Neuuebersetzen aendern kann, wird nie geaendert.
//
// GIBT ES DIE DATEI NICHT, gilt der Vorgabewert, und das ist kein
// Fehler: ein System ohne /etc/login.conf muss sich anmelden lassen.
fn conf_num(key: u64, vorgabe: u64) -> u64 {
    var p: [u8; 17] = "/etc/login.conf\0\0"
    var buf: [u8; 1024] = [0 as u8; 1024]
    if read_all((&p[0]) as u64, (&buf[0]) as u64, 1024) == ulib.EOF {
        return vorgabe
    }
    let kl: u64 = ulib.length(key)
    var line: [u8; 128] = [0 as u8; 128]
    var i: u64 = 0
    let cnt: u64 = lines_of((&buf[0]) as u64)
    while i < cnt {
        if line_at((&buf[0]) as u64, i, (&line[0]) as u64, 128)
            != ulib.EOF {
            var at: u64 = 0
            while line[at as usize] == 32 as u8 || line[at as usize] == 9 as u8 {
                at = at + 1
            }
            if line[at as usize] != 35 as u8 { // '#'
                if ulib.strneq((&line[at as usize]) as u64, key, kl) {
                    var k: u64 = at + kl
                    while line[k as usize] == 32 as u8
                        || line[k as usize] == 9 as u8 {
                        k = k + 1
                    }
                    if line[k as usize] == 61 as u8 { // '='
                        k = k + 1
                        while line[k as usize] == 32 as u8
                            || line[k as usize] == 9 as u8 {
                            k = k + 1
                        }
                        let v: u64 = ulib.to_num((&line[k as usize]) as u64)
                        if v != ulib.EOF {
                            return v
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return vorgabe
}
