profile app

import ulib

export { open_settings }

const PAGE_NONE: u64 = 0

static mut p_settings: [u8; 14] = "/bin/settings\0"
static mut a_settings: [u8; 9] = "settings\0"
static mut a_page: [u8; 24] = [0 as u8; 24]

fn page_arg(page: u64) -> u64 {
    var head: [u8; 6] = "page=\0"
    let a: u64 = (&a_page[0 as usize]) as u64
    var at: u64 = 0
    while at < 5 {
        __mmio_write8((a + at) as *mut u8, head[(at) as usize])
        at = at + 1
    }
    if page >= 10 {
        __mmio_write8((a + at) as *mut u8, (48 + page / 10) as u8)
        at = at + 1
    }
    __mmio_write8((a + at) as *mut u8, (48 + page % 10) as u8)
    __mmio_write8((a + at + 1) as *mut u8, 0 as u8)
    return a
}

fn open_settings(page: u64) {
    var argv: [u64; 2] = [0 as u64; 2]
    argv[(0) as usize] = (&a_settings[0 as usize]) as u64
    var argc: u64 = 1
    if page != PAGE_NONE {
        argv[(1) as usize] = page_arg(page)
        argc = 2
    }
    let _p: u64 = ulib.sys(ulib.SYS_EXEC, (&p_settings[0 as usize]) as u64, (&argv[0 as usize]) as u64, argc)
}
