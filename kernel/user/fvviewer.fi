// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/fvviewer.fi -- FreeViewer viewer for OrientOS (ring 3, --profile=app).
//
//   fvviewer                                 window (fUi): id + password / ask mode, wss://
//   fvviewer -t <ipv4> <port> <id> <pw|-a>   headless test against the Rust test host (ws://)
//   fvviewer -w <id>                         headless wss probe: DNS + TLS + ws + relay pairing
//
// WINDOW MODE (no `-t`): form with the host ID and the password. A LEFT-EMPTY password means
// ask mode: the host user confirms and the 4 digit session code is shown BIG while waiting --
// compare it with the code on the host (the host proves nothing else, roadmap r5). Connect:
// libc.dns -> wss://freeviewer.fleitec.com/fv/ws (TLS 1.3, /etc/ssl/roots.pem) -> relay pairing
// -> handshake (Argon2id ~19 MiB, blocking: the status says "Verbinde..." first). Then the
// picture is a fUi image widget (Frame/Tiles composited into one ARGB buffer, scaled into
// the window), pointer + keys go through fuiscene.set_raw (lib/fv/input.fi), the clipboard
// is synced both ways (wlibc.clip_put / clip_take, max 256 KiB), Ping/Pong gives the rtt,
// and a lost connection is retried 3 times (same id / password) before the form returns.
//
// `-t` talks plain ws://<ipv4>:<port>/fv/ws and is the ONLY way to get an unencrypted relay
// link; the windowed viewer always uses wss://. Everything inside the session is encrypted
// either way.
//
// What the `-t` test does against the synthetic Rust test host (FV_TESTHOST=1,
// src/testhost.rs of the freeviewer repo): pair, handshake, Caps{h264:false},
// NeedKeyframe, then
//   screen    ScreenInfo 640x480
//   frame     full JPEG decoded; pixels at 4 probe points equal the gradient
//             (x*255/639, y*255/479, 128) within a JPEG tolerance
//   counter   the counter tile (16,432 160x36) changes at least once
//   ping      Ping -> Pong with the same timestamp
//   click     MouseMove + left button -> 16x16 red mark tile at the pointer
//   clip      Clipboard "fvv-clip" -> echo:fvv-clip
//   keys      lib/fv/input.fi messages (a, Enter, Ctrl+C, Ctrl+Alt+Del, F5 ...); the gate checks the
//             host log lines "TESTHOST input: Key ... / KeyVk ... / Special ..."
// Prints "  ok    <name>" / "  FAIL  <name>" and "FVV: <n> ok, <m> FAIL".
// Exit 0 = all ok.

profile app

import ulib
import wlib
import wlibc
import fuiapp
import fuiscene
import std.rt
import std.net
import jpeg
import libc.dns
import fv.client
import fv.proto
import fv.input

// ---------------------------------------------------------------- output (no std.io: it clashes with libc.io)
fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn say_c(p: u64) {
    rt.write_everything(1, p, rt.c_length(p))
}

fn say_b(p: u64, n: u64) {
    rt.write_everything(1, p, n as usize)
}

const IMGCAP: u64 = 9216000 // 1920 x 1200 x 4
const TIMEOUT_S: u64 = 40

static mut K_PATH: [u8; 7] = "/fv/ws\0"
static mut CLIP: [u8; 8] = "fvv-clip"

static mut n_ok: u64 = 0
static mut n_fail: u64 = 0

fn pn(v: u64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, v)
    rt.write_everything(1, b.ptr, b.len)
    rt.buf_free(&b)
}

fn say_line(s: str) {
    say(s)
    say("\n")
}

fn pass(name: str) {
    n_ok = n_ok + 1
    say("  ok    ")
    say_line(name)
}

fn fail(name: str) {
    n_fail = n_fail + 1
    say("  FAIL  ")
    say_line(name)
}

fn now_seconds() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 0, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] as u64
}

fn parse_u(p: u64) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while true {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 {
            return v
        }
        v = v * 10 + (c - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn parse_ip(p: u64, out: *mut u32) -> bool {
    var parts: [u32; 4] = [0; 4]
    var k: usize = 0
    var v: u32 = 0
    var digits: usize = 0
    var i: usize = 0
    while true {
        let ch: u8 = rt.ld8(p, i)
        if ch == 0 as u8 {
            break
        }
        if ch == 46 as u8 {
            if digits == 0 || k >= 3 {
                return false
            }
            parts[k] = v
            k = k + 1
            v = 0
            digits = 0
        } else {
            if ch < 48 as u8 || ch > 57 as u8 {
                return false
            }
            v = v * 10 as u32 + (ch - 48 as u8) as u32
            digits = digits + 1
            if v > 255 as u32 {
                return false
            }
        }
        i = i + 1
    }
    if k != 3 || digits == 0 {
        return false
    }
    parts[3] = v
    *out = net.ipv4(parts[0] as u8, parts[1] as u8, parts[2] as u8, parts[3] as u8)
    return true
}

// pixel (x,y) of a w-wide ARGB image -> 0xRRGGBB
fn pixel(img: u64, w: u64, x: u64, y: u64) -> u64 {
    return (rt.ld32(img, (y * w + x) as usize) as u64) & 0xFFFFFF
}

fn near(a: u64, b: u64, tol: u64) -> bool {
    if a > b {
        return a - b <= tol
    }
    return b - a <= tol
}

// does pixel (x,y) of the frame look like the gradient of the test host?
fn gradient_ok(img: u64, w: u64, x: u64, y: u64) -> bool {
    let px: u64 = pixel(img, w, x, y)
    let r: u64 = (px >> 16) & 255
    let g: u64 = (px >> 8) & 255
    let b: u64 = px & 255
    return near(r, x * 255 / 639, 10) && near(g, y * 255 / 479, 10) && near(b, 128, 10)
}

// sum of all pixels of a rectangle (change detector for the counter tile)
fn rect_sum(img: u64, w: u64, x0: u64, y0: u64, rw: u64, rh: u64) -> u64 {
    var s: u64 = 0
    var y: u64 = y0
    while y < y0 + rh {
        var x: u64 = x0
        while x < x0 + rw {
            s = s + pixel(img, w, x, y)
            x = x + 1
        }
        y = y + 1
    }
    return s
}

// copy a decoded tile (tw x th, tmp) into the image at (x,y)
fn blit(img: u64, iw: u64, ih: u64, tmp: u64, tw: u64, th: u64, x: u64, y: u64) {
    var row: u64 = 0
    while row < th {
        if y + row < ih {
            var col: u64 = 0
            while col < tw {
                if x + col < iw {
                    rt.st32(img, ((y + row) * iw + x + col) as usize,
                        rt.ld32(tmp, (row * tw + col) as usize))
                }
                col = col + 1
            }
        }
        row = row + 1
    }
}

fn send_msg(cl: *mut client.Client, obuf: u64, n: u64) -> bool {
    return client.cl_send(cl, obuf, n)
}

// one OrientOS key event through lib/fv/input.fi
fn send_key(cl: *mut client.Client, kb: u64, kl: u64, code: u64, mod: u64) {
    let cnt: u64 = input.key_msgs(kb, kl, code, mod)
    var i: u64 = 0
    while i < cnt {
        client.cl_send(cl, kb + i * input.SLOT, rt.ld8(kl, i as usize) as u64)
        i = i + 1
    }
}

// the JPEG decoder keeps pointers to the message buffer (heap) in statics
#[allow_escape]
fn run_test(start: u64) -> i32 {
    let argc: usize = rt.arg_count(start)
    if argc < 6 || rt.ld8(rt.arg_ptr(start, 1), 1) != 116 as u8 {
        say_line("usage: fvviewer -t <ipv4> <port> <id> <password|-a>")
        return 2
    }
    var addr: u32 = 0
    if !parse_ip(rt.arg_ptr(start, 2), &addr) {
        say_line("fvviewer: the address must be an IPv4 number")
        return 2
    }
    let port: u64 = parse_u(rt.arg_ptr(start, 3))
    let id: u64 = rt.arg_ptr(start, 4)
    let pw: u64 = rt.arg_ptr(start, 5)
    var ask: bool = false
    if rt.c_length(pw) == 2 && rt.ld8(pw, 0) == 45 as u8 && rt.ld8(pw, 1) == 97 as u8 {
        ask = true
    }

    var cl: client.Client = client.client_new()
    if !client.cl_alloc(&cl) {
        say_line("FVV: no memory for the buffers")
        return 1
    }
    let img: u64 = rt.heap_alloc(IMGCAP as usize)
    let tmp: u64 = rt.heap_alloc(IMGCAP as usize)
    let obuf: u64 = rt.heap_alloc(4096)
    if img == 0 || tmp == 0 || obuf == 0 {
        say_line("FVV: no memory for the image")
        return 1
    }

    // ---- connect, pair, handshake
    let hostp: u64 = rt.arg_ptr(start, 2)
    if !client.cl_connect(&cl, addr, port as u16, false, hostp, rt.c_length(hostp) as u64,
        (&K_PATH[0]) as u64, 6, 0) {
        fail("connect + websocket upgrade")
        pn(cl.err)
        say("\n")
        return 1
    }
    pass("connect + websocket upgrade")
    if !client.cl_pair(&cl, id, rt.c_length(id) as u64) {
        fail("relay pairing")
        pn(cl.err)
        say("\n")
        return 1
    }
    pass("relay pairing")
    var hs: bool = false
    if ask {
        var nm: [u8; 8] = "OrientOS"
        hs = client.cl_handshake_ask(&cl, (&nm[0]) as u64, 8)
    } else {
        hs = client.cl_handshake(&cl, pw, rt.c_length(pw) as u64)
    }
    if !hs {
        fail("handshake")
        pn(cl.err)
        say("\n")
        return 1
    }
    if ask {
        pass("handshake (ask mode)")
    } else {
        pass("handshake (password, Argon2id 19 MiB)")
    }
    say("  code  ")
    say_b(client.cl_code(&cl), 4)
    say("\n")

    // ---- caps + first frame
    var n: u64 = proto.enc_caps(obuf, false)
    send_msg(&cl, obuf, n)
    n = proto.enc_needkey(obuf)
    send_msg(&cl, obuf, n)
    n = proto.enc_ping(obuf, 123456789)
    send_msg(&cl, obuf, n)
    client.cl_set_timeout(&cl, 1000)

    var got_screen: bool = false
    var got_frame: bool = false
    var got_pong: bool = false
    var got_counter: bool = false
    var got_mark: bool = false
    var got_echo: bool = false
    var sent_input: bool = false
    var iw: u64 = 0
    var ih: u64 = 0
    var counter0: u64 = 0
    var wh: [u64; 2] = [0; 2]
    var deadline: u64 = now_seconds() + TIMEOUT_S

    while now_seconds() < deadline {
        if got_screen && got_frame && got_pong && got_counter && got_mark && got_echo {
            break
        }
        let len: i64 = client.cl_recv(&cl)
        if len < 0 {
            if client.cl_timed_out(&cl) {
                continue
            }
            if len == 0 - 2 {
                say_line("  note  peer gone")
            } else {
                say("  note  connection ended, error ")
                pn(cl.err)
                say("\n")
            }
            break
        }
        let m: u64 = cl.pbuf
        let t: u64 = proto.msg_type(m, len as u64)
        if t == proto.T_SCREEN {
            if proto.dec_screen(m, len as u64, (&wh[0]) as u64) {
                if wh[0] == 640 && wh[1] == 480 {
                    got_screen = true
                }
            }
        } else if t == proto.T_FRAME {
            var f: proto.Frame = proto.Frame { w: 0, h: 0, jpeg: 0, len: 0 }
            if proto.dec_frame(m, len as u64, &f) {
                let first: bool = !got_frame
                if jpeg.jpeg_read(f.jpeg, f.len, img, IMGCAP) {
                    iw = jpeg.width()
                    ih = jpeg.height()
                    got_frame = true
                    counter0 = rect_sum(img, iw, 16, 432, 160, 36)
                    if !first {
                        // a keyframe sent again: image replaced, nothing to report
                    } else if iw == 640 && ih == 480 && gradient_ok(img, iw, 500, 100)
                        && gradient_ok(img, iw, 600, 300) && gradient_ok(img, iw, 100, 300)
                        && gradient_ok(img, iw, 320, 400) {
                        pass("frame decoded, 4 pixel probes equal the gradient")
                    } else {
                        fail("frame decoded, 4 pixel probes equal the gradient")
                        say("        size ")
                        pn(iw)
                        say("x")
                        pn(ih)
                        say(" p(500,100)=")
                        pn(pixel(img, iw, 500, 100))
                        say("\n")
                    }
                } else {
                    fail("frame decoded")
                    say_c(jpeg.fehlertext())
                    say("\n")
                }
            }
        } else if t == proto.T_TILES {
            var it: proto.TileIt = proto.TileIt { p: 0, n: 0, at: 0, left: 0, w: 0, h: 0 }
            var tl: proto.Tile = proto.Tile { x: 0, y: 0, w: 0, h: 0, jpeg: 0, len: 0 }
            if got_frame && proto.tiles_begin(m, len as u64, &it) {
                while proto.tiles_next(&it, &tl) {
                    if jpeg.jpeg_read(tl.jpeg, tl.len, tmp, IMGCAP) {
                        let tw: u64 = jpeg.width()
                        let th: u64 = jpeg.height()
                        blit(img, iw, ih, tmp, tw, th, tl.x, tl.y)
                        if tl.x == 16 && tl.y == 432 {
                            if rect_sum(img, iw, 16, 432, 160, 36) != counter0 {
                                got_counter = true
                            }
                        }
                        if tw == 16 && th == 16 && tl.x < 640 {
                            // the mark of the left click: red square
                            let c: u64 = pixel(img, iw, tl.x + 8, tl.y + 8)
                            if (c >> 16) > 200 && ((c >> 8) & 255) < 60 && (c & 255) < 60 {
                                got_mark = true
                            }
                        }
                    }
                }
            }
        } else if t == proto.T_PONG {
            if proto.dec_ping(m, len as u64) == 123456789 {
                got_pong = true
            }
        } else if t == proto.T_PING {
            let ts: u64 = proto.dec_ping(m, len as u64)
            n = proto.enc_pong(obuf, ts)
            send_msg(&cl, obuf, n)
        } else if t == proto.T_CLIP {
            var cp: [u64; 2] = [0; 2]
            if proto.dec_clip(m, len as u64, (&cp[0]) as u64) {
                // "echo:" + text
                if cp[1] == 13 && rt.ld8(cp[0], 0) == 101 as u8 && rt.ld8(cp[0], 5) == 102 as u8 {
                    got_echo = true
                }
            }
        }
        // first frame is in: send the input once
        if got_frame && !sent_input {
            sent_input = true
            n = proto.enc_move(obuf, 5000, 5000)
            send_msg(&cl, obuf, n)
            n = proto.enc_button(obuf, 0, true)
            send_msg(&cl, obuf, n)
            n = proto.enc_button(obuf, 0, false)
            send_msg(&cl, obuf, n)
            n = proto.enc_clip(obuf, (&CLIP[0]) as u64, 8)
            send_msg(&cl, obuf, n)
            let kb: u64 = rt.heap_alloc(256)
            let kl: u64 = rt.heap_alloc(16)
            send_key(&cl, kb, kl, 97, 0)
            send_key(&cl, kb, kl, 13, 0)
            send_key(&cl, kb, kl, 3, 0)
            send_key(&cl, kb, kl, 0x109, 7)
            send_key(&cl, kb, kl, 0x114, 0)
            send_key(&cl, kb, kl, 0x103, 2)
            send_key(&cl, kb, kl, 9, 3)
        }
    }

    if got_screen { pass("ScreenInfo 640x480") } else { fail("ScreenInfo 640x480") }
    if !got_frame { fail("frame decoded") }
    if got_counter { pass("counter tile changes (tiles applied)") } else { fail("counter tile changes (tiles applied)") }
    if got_pong { pass("ping -> pong") } else { fail("ping -> pong") }
    if got_mark { pass("click -> red mark tile at the pointer") } else { fail("click -> red mark tile at the pointer") }
    if got_echo { pass("clipboard echo") } else { fail("clipboard echo") }

    client.cl_close(&cl)
    say("FVV: ")
    pn(n_ok)
    say(" ok, ")
    pn(n_fail)
    say(" FAIL\n")
    if n_fail == 0 {
        return 0
    }
    return 1
}

// ================================================================== window mode (fUi)

const ST_FORM: u64 = 0
const ST_CONNECT: u64 = 1 // blocking work is due (the status "Verbinde..." was painted first)
const ST_WAIT: u64 = 2 // handshake sent: password check / the host user decides
const ST_LIVE: u64 = 3

const K_GO: u64 = 1
const K_ID: u64 = 10
const K_PW: u64 = 11
const K_IMG: u64 = 20
const K_CAD: u64 = 30
const K_WIN: u64 = 31
const K_ALTTAB: u64 = 32
const K_UP: u64 = 33
const K_DOWN: u64 = 34
const K_BYE: u64 = 35

const RELAY_HOST: str = "freeviewer.fleitec.com"
const RETRIES: u64 = 3
const QCAP: u64 = 128
const CLIPCAP: u64 = 262144

static mut st: u64 = 0
static mut st_delay: u64 = 0
static mut retry_n: u64 = 0
static mut retry_at: u64 = 0
static mut ask_mode: bool = false

static mut POOL: [u8; 2048] = [0 as u8; 2048]
static mut STATUS: [u8; 192] = [0 as u8; 192]
static mut STLEN: u64 = 0
static mut CODE: [u8; 8] = [0 as u8; 8]
static mut IDBUF: [u8; 64] = [0 as u8; 64]
static mut PWBUF: [u8; 128] = [0 as u8; 128]

// remote screen + pointer state
static mut rw: u64 = 0
static mut rh: u64 = 0
static mut iw: u64 = 0
static mut ih: u64 = 0
static mut fit_w: u64 = 0
static mut fit_h: u64 = 0
static mut cur_x: i64 = 0 - 1
static mut cur_y: i64 = 0 - 1
static mut cur_vis: bool = false
static mut btn_mask: u64 = 0

// buffers
static mut g_img: u64 = 0
static mut g_tmp: u64 = 0
static mut g_obuf: u64 = 0
static mut g_kb: u64 = 0
static mut g_kl: u64 = 0
static mut g_clip: u64 = 0
static mut g_clip_last: u64 = 0 // length of the text last seen / sent / received
static mut g_clip_at: u64 = 0

// input queue (filled by the raw hook, drained by the loop)
static mut Q: [u64; 640] = [0; 640] // QCAP x (kind, x, y, btn, key)
static mut q_head: u64 = 0
static mut q_tail: u64 = 0

// statistics
static mut n_updates: u64 = 0
static mut fps: u64 = 0
static mut fps_at: u64 = 0
static mut fps_n: u64 = 0
static mut rtt_ms: u64 = 0
static mut ping_at: u64 = 0

// ---- GATE-ONLY test entry (tools/fvviewer/gui.sh). NEVER the default: it exists only when the
// file /etc/fvviewer.test is present in the image ("<ipv4> <port> [tls]" in one line). The window
// then talks to <ipv4>:<port> instead of freeviewer.fleitec.com (plain ws://, or wss:// against the
// test CA /etc/fvviewer-ca.pem for host name "localhost" with `tls`), prints "fvviewer: ..." lines on
// the serial console, and does a clipboard self test. A normal install has no such file.
static mut TEST_ON: bool = false
static mut TEST_TLS: bool = false
static mut TEST_ADDR: u32 = 0
static mut TEST_PORT: u64 = 0
static mut TEST_HOST: [u8; 64] = [0 as u8; 64]
static mut t_click_at: u64 = 0 // when the last button-down went out (0 = none pending)
static mut t_dec_ms: u64 = 0 // time spent in handle_msg, this second
static mut t_msgs: u64 = 0
static mut t_live_at: u64 = 0
static mut t_conn_t0: u64 = 0
static mut t_rects: u64 = 0
static mut t_clip_state: u64 = 0 // 0 = not yet, 1 = put, 2 = echo seen
static mut TEST_CLIP: [u8; 12] = "fvv-gui-clip"

fn load_test_target() {
    TEST_ON = false
    var b: rt.Buf = rt.buf_new()
    var path: [u8; 19] = "/etc/fvviewer.test\0"
    if !rt.read_file((&path[0]) as u64, &b) {
        rt.buf_free(&b)
        return
    }
    var i: u64 = 0
    var sp1: u64 = 0
    var sp2: u64 = 0
    var n: u64 = b.len as u64
    if n > 62 { n = 62 }
    while i < n {
        let c: u8 = rt.ld8(b.ptr, i as usize)
        if c == 10 as u8 || c == 0 as u8 {
            break
        }
        if c == 32 as u8 {
            if sp1 == 0 { sp1 = i } else if sp2 == 0 { sp2 = i }
            TEST_HOST[i as usize] = 0 as u8
        } else {
            TEST_HOST[i as usize] = c
        }
        i = i + 1
    }
    TEST_HOST[i as usize] = 0 as u8
    if sp1 > 0 && parse_ip((&TEST_HOST[0]) as u64, &TEST_ADDR) {
        TEST_PORT = parse_u((&TEST_HOST[0]) as u64 + sp1 + 1)
        TEST_TLS = sp2 > 0 && rt.ld8((&TEST_HOST[0]) as u64, (sp2 + 1) as usize) == 116 as u8
        TEST_ON = TEST_PORT > 0
    }
    rt.buf_free(&b)
}

fn trace_rect(name: str, key: u64) {
    if !TEST_ON {
        return
    }
    let ni: usize = fuiscene.node_of_key(key)
    tr("rect name=")
    say(name)
    say(" x=")
    pn(fuiscene.node_x(ni))
    say(" y=")
    pn(fuiscene.node_y(ni))
    say(" w=")
    pn(fuiscene.node_w(ni))
    say(" h=")
    pn(fuiscene.node_h(ni))
    say("\n")
}

fn tr(s: str) {
    if TEST_ON {
        say("fvviewer: ")
        say(s)
    }
}

fn trn(v: u64) {
    if TEST_ON {
        pn(v)
    }
}

fn pool(slot: u64, s: str) -> u64 {
    let base: u64 = (&POOL[0]) as u64 + slot * 128
    var i: u64 = 0
    while i < (s.n as u64) && i < 127 {
        rt.st8(base, i as usize, rt.ld8(s.p as u64, i as usize))
        i = i + 1
    }
    rt.st8(base, i as usize, 0 as u8)
    return base
}

fn st_begin() {
    STLEN = 0
    STATUS[0] = 0 as u8
}

fn st_str(s: str) {
    var i: u64 = 0
    while i < (s.n as u64) && STLEN < 180 {
        STATUS[STLEN as usize] = rt.ld8(s.p as u64, i as usize)
        STLEN = STLEN + 1
        i = i + 1
    }
    STATUS[STLEN as usize] = 0 as u8
}

fn st_cstr(p: u64) {
    var i: u64 = 0
    while rt.ld8(p, i as usize) != 0 as u8 && STLEN < 180 {
        STATUS[STLEN as usize] = rt.ld8(p, i as usize)
        STLEN = STLEN + 1
        i = i + 1
    }
    STATUS[STLEN as usize] = 0 as u8
}

fn st_dec(v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        d[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        d[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 && STLEN < 180 {
        n = n - 1
        STATUS[STLEN as usize] = d[n as usize]
        STLEN = STLEN + 1
    }
    STATUS[STLEN as usize] = 0 as u8
}

fn copy_c(dst: u64, cap: u64, src: u64) {
    var i: u64 = 0
    while i + 1 < cap && rt.ld8(src, i as usize) != 0 as u8 {
        rt.st8(dst, i as usize, rt.ld8(src, i as usize))
        i = i + 1
    }
    rt.st8(dst, i as usize, 0 as u8)
}

fn err_text(cl: *mut client.Client) {
    let e: u64 = (*cl).err
    if e == client.E_TCP { st_str("Keine Verbindung zum Relay (TCP)") }
    else if e == client.E_TLS { st_str("TLS fehlgeschlagen (Zertifikat/Uhrzeit?)") }
    else if e == client.E_UPGRADE { st_str("WebSocket-Upgrade abgelehnt") }
    else if e == client.E_RELAY {
        st_str("Relay: ")
        st_cstr((&(*cl).errtxt[0]) as u64)
    }
    else if e == client.E_AUTH { st_str("Falsches Passwort") }
    else if e == client.E_DENIED { st_str("Host hat abgelehnt") }
    else if e == client.E_GONE { st_str("Host ist weg") }
    else if e == client.E_MEM { st_str("Zu wenig Speicher") }
    else {
        st_str("Verbindung getrennt (Fehler ")
        st_dec(e)
        st_str(")")
    }
}

// ---------------------------------------------------------------- tree

fn build() {
    let col: usize = fuiscene.root()
    if st == ST_LIVE {
        let bar: usize = fuiscene.row(col)
        let _b1: usize = fuiscene.button(bar, pool(0, "Strg+Alt+Entf"), K_CAD)
        let _b2: usize = fuiscene.button(bar, pool(1, "Win"), K_WIN)
        let _b3: usize = fuiscene.button(bar, pool(2, "Alt+Tab"), K_ALTTAB)
        let _b4: usize = fuiscene.button(bar, pool(3, "Rad hoch"), K_UP)
        let _b5: usize = fuiscene.button(bar, pool(4, "Rad runter"), K_DOWN)
        let _b6: usize = fuiscene.button(bar, pool(5, "Trennen"), K_BYE)
        var w: u64 = fuiscene.width()
        var h: u64 = fuiscene.height()
        if w > 24 { w = w - 24 } else { w = 100 }
        if h > 110 { h = h - 110 } else { h = 100 }
        let _im: usize = fuiscene.image(col, K_IMG, w, h)
        let _sl: usize = fuiscene.label(col, (&STATUS[0]) as u64)
        return
    }
    let _t: usize = fuiscene.label(col, pool(6, "FreeViewer - Fernzugriff"))
    let _l1: usize = fuiscene.label(col, pool(7, "Host-ID"))
    let _e1: usize = fuiscene.entry(col, K_ID, 300, (&IDBUF[0]) as u64)
    let _l2: usize = fuiscene.label(col, pool(8, "Passwort (leer = Ask-Modus, Host bestaetigt)"))
    let _e2: usize = fuiscene.entry(col, K_PW, 300, (&PWBUF[0]) as u64)
    fuiscene.entry_secret(K_PW, true)
    if st == ST_FORM {
        let _go: usize = fuiscene.button_main(col, pool(9, "Verbinden"), K_GO)
    }
    let _sl: usize = fuiscene.label(col, (&STATUS[0]) as u64)
    if st == ST_WAIT && ask_mode {
        let _l3: usize = fuiscene.label(col, pool(10, "Sitzungscode - muss auf dem Host gleich sein:"))
        let _sp: usize = fuiscene.ghost_space(col, 300, 80)
    }
}

// the big session code (ask mode) and the remote pointer, painted over the tree
fn overlay() {
    if st == ST_WAIT && ask_mode {
        var i: usize = fuiscene.node_count()
        // the code sits in the last ghost space of the tree: it is the last node
        if i > 0 {
            i = i - 1
            fuiscene.text_role(fuiscene.node_x(i) + 8, fuiscene.node_y(i) + 64, 300,
                (&CODE[0]) as u64, 64, true, fuiscene.R_ACCENT)
        }
    }
    if st == ST_LIVE && cur_vis && cur_x >= 0 && rw > 0 && rh > 0 {
        let ni: usize = fuiscene.node_of_key(K_IMG)
        var r: input.Rect = input.rect_new()
        input.view_rect(fuiscene.node_x(ni), fuiscene.node_y(ni), fuiscene.node_w(ni),
            fuiscene.node_h(ni), rw, rh, fuiscene.image_zoom(K_IMG), &r)
        let px: i64 = r.x + (cur_x * (r.w as i64)) / 10000
        let py: i64 = r.y + (cur_y * (r.h as i64)) / 10000
        if px > 0 && py > 0 {
            fuiscene.text_role((px - 5) as u64, (py + 5) as u64, 16, (&CROSS[0]) as u64, 16, true,
                fuiscene.R_ACCENT)
        }
    }
}

static mut CROSS: [u8; 2] = "+\0"

// ---------------------------------------------------------------- raw input hook

fn q_push(kind: u64, x: u64, y: u64, btn: u64, key: u64) {
    let next: u64 = (q_head + 1) % QCAP
    if next == q_tail {
        return // full: drop (moves are the typical flood)
    }
    let b: u64 = q_head * 5
    Q[b as usize] = kind
    Q[(b + 1) as usize] = x
    Q[(b + 2) as usize] = y
    Q[(b + 3) as usize] = btn
    Q[(b + 4) as usize] = key
    q_head = next
}

fn in_image(x: u64, y: u64) -> bool {
    if rw == 0 || rh == 0 {
        return false
    }
    let ni: usize = fuiscene.node_of_key(K_IMG)
    var r: input.Rect = input.rect_new()
    input.view_rect(fuiscene.node_x(ni), fuiscene.node_y(ni), fuiscene.node_w(ni),
        fuiscene.node_h(ni), rw, rh, fuiscene.image_zoom(K_IMG), &r)
    var xy: [u64; 2] = [0; 2]
    return input.map_pointer(x, y, &r, &xy[0])
}

fn raw_hook(kind: u64, x: u64, y: u64, btn: u64, key: u64) {
    if st != ST_LIVE {
        return
    }
    if kind == fuiapp.EV_KEY {
        q_push(kind, x, y, btn, key)
        fuiscene.raw_take()
        return
    }
    if kind == fuiapp.EV_MOVE || kind == fuiapp.EV_DOWN || kind == fuiapp.EV_UP {
        if in_image(x, y) || (btn_mask != 0 && kind != fuiapp.EV_DROP) {
            q_push(kind, x, y, btn, key)
            fuiscene.raw_take()
        }
    }
}

// ---------------------------------------------------------------- session

fn alloc_all() -> bool {
    if g_img != 0 {
        return true
    }
    g_img = rt.heap_alloc(IMGCAP as usize)
    g_tmp = rt.heap_alloc(IMGCAP as usize)
    g_obuf = rt.heap_alloc(4096)
    g_kb = rt.heap_alloc(256)
    g_kl = rt.heap_alloc(16)
    g_clip = rt.heap_alloc((CLIPCAP + 16) as usize)
    return g_img != 0 && g_tmp != 0 && g_obuf != 0 && g_kb != 0 && g_kl != 0 && g_clip != 0
}

fn send_m(cl: *mut client.Client, n: u64) -> bool {
    return client.cl_send(cl, g_obuf, n)
}

// blocking: DNS, wss, pairing, first half of the handshake. true = handshake answer sent.
fn do_connect(cl: *mut client.Client) -> bool {
    if TEST_ON {
        // GATE ONLY (see load_test_target)
        var lh: [u8; 10] = "localhost\0"
        var ca: [u8; 23] = "/etc/fvviewer-ca.pem\0\0\0"
        var tpath: [u8; 6] = "/fv/ws"
        var okc: bool = false
        if TEST_TLS {
            okc = client.cl_connect(cl, TEST_ADDR, TEST_PORT as u16, true, (&lh[0]) as u64, 9,
                (&tpath[0]) as u64, 6, (&ca[0]) as u64)
        } else {
            okc = client.cl_connect(cl, TEST_ADDR, TEST_PORT as u16, false, (&TEST_HOST[0]) as u64,
                rt.c_length((&TEST_HOST[0]) as u64) as u64, (&tpath[0]) as u64, 6, 0)
        }
        if !okc {
            st_begin()
            err_text(cl)
            return false
        }
    } else {
        let a4: u64 = dns.resolve_a(RELAY_HOST.p as u64)
        if a4 == 0 {
            st_begin()
            st_str("DNS: freeviewer.fleitec.com nicht aufloesbar (Netz?)")
            return false
        }
        var path: [u8; 6] = "/fv/ws"
        var roots: [u8; 19] = "/etc/ssl/roots.pem\0"
        if !client.cl_connect(cl, a4 as u32, 443, true, RELAY_HOST.p as u64, RELAY_HOST.n as u64,
            (&path[0]) as u64, 6, (&roots[0]) as u64) {
            st_begin()
            err_text(cl)
            return false
        }
    }
    if !client.cl_pair(cl, (&IDBUF[0]) as u64, rt.c_length((&IDBUF[0]) as u64) as u64) {
        st_begin()
        err_text(cl)
        return false
    }
    var ok: bool = false
    if ask_mode {
        var nm: [u8; 8] = "OrientOS"
        ok = client.cl_handshake_begin(cl, false, 0, 0, (&nm[0]) as u64, 8)
    } else {
        ok = client.cl_handshake_begin(cl, true, (&PWBUF[0]) as u64,
            rt.c_length((&PWBUF[0]) as u64) as u64, 0, 0)
    }
    if !ok {
        st_begin()
        err_text(cl)
        return false
    }
    return true
}

fn go_live(cl: *mut client.Client) {
    st = ST_LIVE
    retry_n = 0
    rw = 0
    rh = 0
    iw = 0
    ih = 0
    fit_w = 0
    cur_vis = false
    btn_mask = 0
    q_head = 0
    q_tail = 0
    n_updates = 0
    fps_n = 0
    fps = 0
    rtt_ms = 0
    g_clip_last = 0
    fps_at = fuiapp.now_ms()
    ping_at = 0
    client.cl_set_timeout(cl, 15)
    var n: u64 = proto.enc_caps(g_obuf, false)
    send_m(cl, n)
    n = proto.enc_needkey(g_obuf)
    send_m(cl, n)
    st_begin()
    st_str("Verbunden")
    t_live_at = fuiapp.now_ms()
    t_clip_state = 0
    t_click_at = 0
    t_rects = 0
    tr("state live after ms=")
    trn(t_live_at - t_conn_t0)
    tr("\n")
    fuiscene.refresh()
}

fn lose(cl: *mut client.Client, why_err: bool) {
    if TEST_ON {
        tr("lost err=")
        trn((*cl).err)
        tr(" retry_n=")
        trn(retry_n)
        tr("\n")
    }
    client.cl_close(cl)
    image_off()
    t_rects = 0
    // retry the same id / password (no retry when the host said no or the password is wrong)
    if why_err && (*cl).err != client.E_AUTH && (*cl).err != client.E_DENIED && retry_n < RETRIES {
        retry_n = retry_n + 1
        st = ST_CONNECT
        st_delay = 0
        retry_at = fuiapp.now_ms() + 2000
        st_begin()
        st_str("Verbindung verloren - neuer Versuch ")
        st_dec(retry_n)
        st_str("/3")
    } else {
        st = ST_FORM
        retry_n = 0
        st_begin()
        err_text(cl)
    }
    *cl = client.client_new()
    client.cl_alloc(cl)
    fuiscene.refresh()
}

fn image_off() {
    fuiscene.image_set(K_IMG, 0, 0, 0)
    rw = 0
    rh = 0
}

fn fit_image() {
    if iw == 0 || ih == 0 {
        return
    }
    let ni: usize = fuiscene.node_of_key(K_IMG)
    let bw: u64 = fuiscene.node_w(ni)
    let bh: u64 = fuiscene.node_h(ni)
    if bw == 0 || bh == 0 {
        return
    }
    var z: u64 = bw * 100 / iw
    let zy: u64 = bh * 100 / ih
    if zy < z {
        z = zy
    }
    if z > 400 {
        z = 400
    }
    if z < 5 {
        z = 5
    }
    fuiscene.image_set_zoom(K_IMG, z)
    if TEST_ON && (bw != fit_w || bh != fit_h) {
        tr("rect name=img x=")
        trn(fuiscene.node_x(ni))
        tr(" y=")
        trn(fuiscene.node_y(ni))
        tr(" w=")
        trn(bw)
        tr(" h=")
        trn(bh)
        tr(" zoom=")
        trn(z)
        tr(" img=")
        trn(iw)
        tr("x")
        trn(ih)
        tr("\n")
        var vr: input.Rect = input.rect_new()
        input.view_rect(fuiscene.node_x(ni), fuiscene.node_y(ni), bw, bh, rw, rh, fuiscene.image_zoom(K_IMG), &vr)
        tr("rect name=view x=")
        trn(vr.x as u64)
        tr(" y=")
        trn(vr.y as u64)
        tr(" w=")
        trn(vr.w as u64)
        tr(" h=")
        trn(vr.h as u64)
        tr("\n")
    }
    fit_w = bw
    fit_h = bh
}

fn blit_img(tmp: u64, tw: u64, th: u64, x: u64, y: u64) {
    var row: u64 = 0
    while row < th {
        if y + row < ih {
            var col: u64 = 0
            while col < tw {
                if x + col < iw {
                    rt.st32(g_img, ((y + row) * iw + x + col) as usize,
                        rt.ld32(tmp, (row * tw + col) as usize))
                }
                col = col + 1
            }
        }
        row = row + 1
    }
}

fn handle_msg(cl: *mut client.Client, m: u64, len: u64) {
    let t0: u64 = fuiapp.now_ms()
    handle_msg2(cl, m, len)
    if TEST_ON {
        t_dec_ms = t_dec_ms + (fuiapp.now_ms() - t0)
        t_msgs = t_msgs + 1
    }
}

fn handle_msg2(cl: *mut client.Client, m: u64, len: u64) {
    let t: u64 = proto.msg_type(m, len)
    if t == proto.T_SCREEN {
        var wh: [u64; 2] = [0; 2]
        if proto.dec_screen(m, len, (&wh[0]) as u64) {
            rw = wh[0]
            rh = wh[1]
        }
    } else if t == proto.T_FRAME {
        var f: proto.Frame = proto.Frame { w: 0, h: 0, jpeg: 0, len: 0 }
        if proto.dec_frame(m, len, &f) {
            if jpeg.jpeg_read(f.jpeg, f.len, g_img, IMGCAP) {
                iw = jpeg.width()
                ih = jpeg.height()
                if rw == 0 {
                    rw = iw
                    rh = ih
                }
                fuiscene.image_set(K_IMG, g_img, iw, ih)
                fit_image()
                n_updates = n_updates + 1
                fps_n = fps_n + 1
                fuiscene.refresh()
            }
        }
    } else if t == proto.T_TILES {
        var it: proto.TileIt = proto.TileIt { p: 0, n: 0, at: 0, left: 0, w: 0, h: 0 }
        var tl: proto.Tile = proto.Tile { x: 0, y: 0, w: 0, h: 0, jpeg: 0, len: 0 }
        if iw > 0 && proto.tiles_begin(m, len, &it) {
            while proto.tiles_next(&it, &tl) {
                if jpeg.jpeg_read(tl.jpeg, tl.len, g_tmp, IMGCAP) {
                    blit_img(g_tmp, jpeg.width(), jpeg.height(), tl.x, tl.y)
                    if TEST_ON && t_click_at != 0 && tl.w == 16 && tl.h == 16 {
                        tr("click-to-mark ms=")
                        trn(fuiapp.now_ms() - t_click_at)
                        tr("\n")
                        t_click_at = 0
                    }
                }
            }
            n_updates = n_updates + 1
            fps_n = fps_n + 1
            fuiscene.refresh()
        }
    } else if t == proto.T_CURSOR {
        var c: proto.Cursor = proto.Cursor { x: 0, y: 0, visible: false }
        if proto.dec_cursor(m, len, &c) {
            cur_x = c.x
            cur_y = c.y
            cur_vis = c.visible
            fuiscene.refresh()
        }
    } else if t == proto.T_PONG {
        let ts: u64 = proto.dec_ping(m, len)
        let now: u64 = fuiapp.now_ms()
        if now >= ts {
            rtt_ms = now - ts
        }
    } else if t == proto.T_PING {
        let n: u64 = proto.enc_pong(g_obuf, proto.dec_ping(m, len))
        send_m(cl, n)
    } else if t == proto.T_CLIP {
        var cp: [u64; 2] = [0; 2]
        if proto.dec_clip(m, len, (&cp[0]) as u64) {
            if TEST_ON {
                tr("clip rx n=")
                trn(cp[1])
                tr(" text=")
                say_b(cp[0], cp[1])
                tr("\n")
                if cp[1] == 16 && rt.ld8(cp[0], 0) == 101 as u8 && rt.ld8(cp[0], 5) == 102 as u8 {
                    t_clip_state = 2
                    tr("clip echo ok\n")
                }
            }
            if cp[1] <= CLIPCAP {
                // remember it as "already in sync" before it lands in the local clipboard
                wlibc.clip_put(cp[0], cp[1])
                g_clip_last = cp[1]
                copy_clip_snapshot(cp[0], cp[1])
            }
        }
    }
}

// the last text known to both sides (g_clip holds it)
fn copy_clip_snapshot(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        rt.st8(g_clip, i as usize, rt.ld8(p, i as usize))
        i = i + 1
    }
}

fn clip_same(p: u64, n: u64) -> bool {
    if n != g_clip_last {
        return false
    }
    var i: u64 = 0
    while i < n {
        if rt.ld8(p, i as usize) != rt.ld8(g_clip, i as usize) {
            return false
        }
        i = i + 1
    }
    return true
}

// local clipboard changed -> send it (checked twice a second)
fn clip_sync(cl: *mut client.Client, now: u64) {
    if now < g_clip_at + 500 {
        return
    }
    g_clip_at = now
    // read into the tail of the buffer so the snapshot stays intact until we know it differs
    let probe: u64 = g_clip + CLIPCAP / 2
    let n: u64 = wlibc.clip_take(probe, CLIPCAP / 2)
    if n == 0 || n > CLIPCAP / 2 {
        return
    }
    if clip_same(probe, n) {
        return
    }
    copy_clip_snapshot(probe, n)
    g_clip_last = n
    let k: u64 = proto.enc_clip(g_obuf, g_clip, n)
    client.cl_send(cl, g_obuf, k)
}

fn send_button(cl: *mut client.Client, button: u64, down: bool) {
    let n: u64 = proto.enc_button(g_obuf, button, down)
    send_m(cl, n)
}

fn drain_input(cl: *mut client.Client) {
    var mv: bool = false
    var mvx: u64 = 0
    var mvy: u64 = 0
    var rect: input.Rect = input.rect_new()
    let ni: usize = fuiscene.node_of_key(K_IMG)
    input.view_rect(fuiscene.node_x(ni), fuiscene.node_y(ni), fuiscene.node_w(ni),
        fuiscene.node_h(ni), rw, rh, fuiscene.image_zoom(K_IMG), &rect)
    while q_tail != q_head {
        let b: u64 = q_tail * 5
        let kind: u64 = Q[b as usize]
        let x: u64 = Q[(b + 1) as usize]
        let y: u64 = Q[(b + 2) as usize]
        let btn: u64 = Q[(b + 3) as usize]
        let key: u64 = Q[(b + 4) as usize]
        q_tail = (q_tail + 1) % QCAP
        if kind == fuiapp.EV_KEY {
            let cnt: u64 = input.key_msgs(g_kb, g_kl, key, wlib.key_mod())
            if TEST_ON {
                tr("key code=")
                trn(key)
                tr(" msgs=")
                trn(cnt)
                tr("\n")
            }
            var i: u64 = 0
            while i < cnt {
                client.cl_send(cl, g_kb + i * input.SLOT, rt.ld8(g_kl, i as usize) as u64)
                i = i + 1
            }
            continue
        }
        var xy: [u64; 2] = [0; 2]
        let inside: bool = input.map_pointer(x, y, &rect, &xy[0])
        if inside {
            mv = true
            mvx = xy[0]
            mvy = xy[1]
        }
        if TEST_ON && (kind == fuiapp.EV_DOWN || kind == fuiapp.EV_UP) {
            if kind == fuiapp.EV_DOWN { tr("ev down") } else { tr("ev up") }
            tr(" x=")
            trn(x)
            tr(" y=")
            trn(y)
            tr(" btn=")
            trn(btn)
            tr(" inside=")
            if inside { tr("1") } else { tr("0") }
            tr(" ptr=")
            trn(xy[0])
            tr(",")
            trn(xy[1])
            tr(" held=")
            trn(btn_mask)
            tr("\n")
        }
        if kind == fuiapp.EV_DOWN {
            if mv {
                let n: u64 = proto.enc_move(g_obuf, mvx as i64, mvy as i64)
                send_m(cl, n)
                mv = false
            }
            if TEST_ON && t_click_at == 0 {
                t_click_at = fuiapp.now_ms()
            }
            if (btn & 1) != 0 && (btn_mask & 1) == 0 {
                send_button(cl, 0, true)
                btn_mask = btn_mask | 1
            }
            if (btn & 2) != 0 && (btn_mask & 2) == 0 {
                send_button(cl, 1, true)
                btn_mask = btn_mask | 2
            }
            if (btn & 4) != 0 && (btn_mask & 4) == 0 {
                send_button(cl, 2, true)
                btn_mask = btn_mask | 4
            }
        } else if kind == fuiapp.EV_UP {
            if mv {
                let n: u64 = proto.enc_move(g_obuf, mvx as i64, mvy as i64)
                send_m(cl, n)
                mv = false
            }
            // the OS does not say which button came up: release everything that is held
            if (btn_mask & 1) != 0 { send_button(cl, 0, false) }
            if (btn_mask & 2) != 0 { send_button(cl, 1, false) }
            if (btn_mask & 4) != 0 { send_button(cl, 2, false) }
            btn_mask = 0
        }
    }
    if mv {
        let n: u64 = proto.enc_move(g_obuf, mvx as i64, mvy as i64)
        send_m(cl, n)
    }
}

// one pass of the live session; false = the connection ended
fn live_tick(cl: *mut client.Client) -> bool {
    let now: u64 = fuiapp.now_ms()
    drain_input(cl)
    clip_sync(cl, now)
    if now >= ping_at + 2000 {
        ping_at = now
        let n: u64 = proto.enc_ping(g_obuf, now)
        send_m(cl, n)
    }
    var got: u64 = 0
    while got < 8 {
        let len: i64 = client.cl_recv(cl)
        if len < 0 {
            if client.cl_timed_out(cl) {
                break
            }
            return false
        }
        handle_msg(cl, (*cl).pbuf, len as u64)
        got = got + 1
    }
    if now >= fps_at + 1000 {
        fps = fps_n * 1000 / (now - fps_at)
        fps_n = 0
        fps_at = now
        st_begin()
        st_str("Verbunden - ")
        st_dec(fps)
        st_str(" Bilder/s, Latenz ")
        st_dec(rtt_ms)
        st_str(" ms")
        fuiscene.refresh()
        if TEST_ON {
            tr("live fps=")
            trn(fps)
            tr(" rtt=")
            trn(rtt_ms)
            tr(" handle_ms=")
            trn(t_dec_ms)
            tr(" msgs=")
            trn(t_msgs)
            tr("\n")
            t_dec_ms = 0
            t_msgs = 0
        }
    }
    if TEST_ON && t_clip_state == 0 && now >= t_live_at + 3000 {
        // clipboard self test: put a text into the OS clipboard, clip_sync must send it to the host
        wlibc.clip_put((&TEST_CLIP[0]) as u64, 12)
        t_clip_state = 1
        tr("clip put n=12\n")
    }
    if fit_w != fuiscene.node_w(fuiscene.node_of_key(K_IMG)) || fit_h != fuiscene.node_h(fuiscene.node_of_key(K_IMG)) {
        fit_image()
    }
    return true
}

fn start_connect() {
    copy_c((&IDBUF[0]) as u64, 64, fuiscene.entry_text(K_ID))
    copy_c((&PWBUF[0]) as u64, 128, fuiscene.entry_text(K_PW))
    if rt.c_length((&IDBUF[0]) as u64) == 0 {
        st_begin()
        st_str("Bitte die Host-ID eintragen")
        fuiscene.refresh()
        return
    }
    ask_mode = rt.c_length((&PWBUF[0]) as u64) == 0
    t_conn_t0 = fuiapp.now_ms()
    tr("connect start id_len=")
    trn(rt.c_length((&IDBUF[0]) as u64) as u64)
    tr(" pw_len=")
    trn(rt.c_length((&PWBUF[0]) as u64) as u64)
    tr("\n")
    st = ST_CONNECT
    st_delay = 2
    retry_at = 0
    retry_n = 0
    st_begin()
    st_str("Verbinde...")
    fuiscene.refresh()
}

fn code_to_buf(cl: *mut client.Client) {
    let d: u64 = client.cl_code(cl)
    var i: u64 = 0
    while i < 4 {
        CODE[i as usize] = rt.ld8(d, i as usize)
        i = i + 1
    }
    CODE[4] = 0 as u8
}

// the window
#[allow_escape]
fn gui() -> i32 {
    if !alloc_all() {
        return 1
    }
    var cl: client.Client = client.client_new()
    if !client.cl_alloc(&cl) {
        return 1
    }
    load_test_target()
    st_begin()
    if TEST_ON {
        st_str("TESTMODUS (Gate): lokaler Relay statt freeviewer.fleitec.com")
    } else {
        st_str("Bereit")
    }
    if !fuiscene.open(80, 50, 860, 640, pool(11, "FreeViewer"), build) {
        return 2
    }
    if TEST_ON {
        tr("test mode on (gate only)\n")
        tr("geom x=80 y=50 w=860 h=640\n")
        tr("state form\n")
    }
    fuiscene.set_raw(raw_hook)
    fuiscene.set_overlay(overlay)
    var seen: u64 = 0
    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        if TEST_ON && st == ST_FORM && t_rects == 0 && fuiscene.painted() > 0 {
            t_rects = 1
            trace_rect("id", K_ID)
            trace_rect("pw", K_PW)
            trace_rect("go", K_GO)
        }
        if st == ST_FORM {
            if key == K_GO || key == K_ID || key == K_PW {
                start_connect()
            }
        } else if st == ST_LIVE {
            if key == K_CAD {
                send_m(&cl, proto.enc_special(g_obuf, proto.SPECIAL_CAD))
            } else if key == K_WIN {
                send_m(&cl, proto.enc_special(g_obuf, proto.SPECIAL_WIN))
            } else if key == K_ALTTAB {
                send_m(&cl, proto.enc_special(g_obuf, proto.SPECIAL_ALTTAB))
            } else if key == K_UP {
                send_m(&cl, proto.enc_wheel(g_obuf, 3))
            } else if key == K_DOWN {
                send_m(&cl, proto.enc_wheel(g_obuf, 0 - 3))
            } else if key == K_BYE {
                client.cl_close(&cl)
                image_off()
                cl = client.client_new()
                client.cl_alloc(&cl)
                st = ST_FORM
                st_begin()
                st_str("Getrennt")
                fuiscene.refresh()
                continue
            }
            if !live_tick(&cl) {
                lose(&cl, true)
            }
        } else if st == ST_CONNECT {
            // painted twice first ("Verbinde..." must be visible), then the blocking part
            if st_delay > 0 {
                st_delay = st_delay - 1
            } else if fuiapp.now_ms() >= retry_at {
                if do_connect(&cl) {
                    if ask_mode {
                        code_to_buf(&cl)
                    }
                    st = ST_WAIT
                    client.cl_set_timeout(&cl, 40)
                    st_begin()
                    if ask_mode {
                        st_str("Warte auf Bestaetigung am Host...")
                    } else {
                        st_str("Pruefe Passwort...")
                    }
                    fuiscene.refresh()
                } else {
                    lose(&cl, retry_n > 0)
                }
            }
        } else if st == ST_WAIT {
            let r: i64 = client.cl_handshake_poll(&cl)
            if r == 1 {
                go_live(&cl)
            } else if r < 0 {
                lose(&cl, false)
            }
        }
    }
    client.cl_close(&cl)
    return 0
}

// ---------------------------------------------------------------- wss probe (headless)

// fvviewer -w <id>: DNS + TLS 1.3 + websocket upgrade + relay pairing against the real relay.
// An id that does not exist is answered by the relay with an error ("offline"): that proves
// the whole transport without touching any host.
#[allow_escape]
fn run_probe(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        say_line("usage: fvviewer -w <id>")
        return 2
    }
    let id: u64 = rt.arg_ptr(start, 2)
    var cl: client.Client = client.client_new()
    if !client.cl_alloc(&cl) {
        say_line("WSS: no memory")
        return 1
    }
    let a4: u64 = dns.resolve_a(RELAY_HOST.p as u64)
    if a4 == 0 {
        say_line("WSS: dns failed")
        return 1
    }
    say("WSS: dns ok ")
    pn(a4)
    say("\n")
    var path: [u8; 6] = "/fv/ws"
    var roots: [u8; 19] = "/etc/ssl/roots.pem\0"
    if !client.cl_connect(&cl, a4 as u32, 443, true, RELAY_HOST.p as u64, RELAY_HOST.n as u64,
        (&path[0]) as u64, 6, (&roots[0]) as u64) {
        say("WSS: connect failed, error ")
        pn(cl.err)
        say(" ")
        say_b(cl.ebuf.ptr, cl.ebuf.len as u64)
        say("\n")
        return 1
    }
    say_line("WSS: tls + websocket upgrade ok")
    if client.cl_pair(&cl, id, rt.c_length(id) as u64) {
        say_line("WSS: paired (the id is online!)")
        client.cl_close(&cl)
        return 0
    }
    if cl.err == client.E_RELAY {
        say("WSS: relay error: ")
        say_b((&cl.errtxt[0]) as u64, cl.errlen)
        say("\n")
        client.cl_close(&cl)
        return 0
    }
    say("WSS: pairing failed, error ")
    pn(cl.err)
    say("\n")
    return 1
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) >= 2 {
        let c: u8 = rt.ld8(rt.arg_ptr(start, 1), 1)
        if rt.ld8(rt.arg_ptr(start, 1), 0) == 45 as u8 {
            if c == 116 as u8 {
                return run_test(start)
            }
            if c == 119 as u8 {
                return run_probe(start)
            }
        }
    }
    return gui()
}
