profile kernel

export { pack4, field, placed, clamp_axis }

const FIELD_BITS: u64 = 16
const FIELD_MASK: u64 = 0xFFFF
const FIELD_SIGN: u64 = 0x8000
const FIELD_RANGE: i64 = 0x10000

const ANCHOR_TOP: u64 = 1
const ANCHOR_BOTTOM: u64 = 2
const ANCHOR_LEFT: u64 = 3
const ANCHOR_RIGHT: u64 = 4
const ANCHOR_TOP_LEFT: u64 = 5
const ANCHOR_BOTTOM_LEFT: u64 = 6
const ANCHOR_TOP_RIGHT: u64 = 7
const ANCHOR_BOTTOM_RIGHT: u64 = 8

const SETTING_BYTE: u64 = 8
const SETTING_MASK: u64 = 0xFF

fn pack4(a: i64, b: i64, c: i64, d: i64) -> u64 {
    return (((a as u64) & FIELD_MASK) << 48)
        | (((b as u64) & FIELD_MASK) << 32)
        | (((c as u64) & FIELD_MASK) << 16)
        | ((d as u64) & FIELD_MASK)
}

fn field(packed: u64, n: u64) -> i64 {
    let raw: u64 = (packed >> (48 - n * FIELD_BITS)) & FIELD_MASK
    var v: i64 = raw as i64
    if (raw & FIELD_SIGN) != 0 {
        v = v - FIELD_RANGE
    }
    return v
}

fn is_left(side: u64) -> bool {
    return side == ANCHOR_LEFT || side == ANCHOR_TOP_LEFT || side == ANCHOR_BOTTOM_LEFT
}

fn is_right(side: u64) -> bool {
    return side == ANCHOR_RIGHT || side == ANCHOR_TOP_RIGHT || side == ANCHOR_BOTTOM_RIGHT
}

fn is_top(side: u64) -> bool {
    return side == ANCHOR_TOP || side == ANCHOR_TOP_LEFT || side == ANCHOR_TOP_RIGHT
}

fn is_bottom(side: u64) -> bool {
    return side == ANCHOR_BOTTOM || side == ANCHOR_BOTTOM_LEFT || side == ANCHOR_BOTTOM_RIGHT
}

fn axis_origin(low: bool, high: bool, start: i64, extent: i64) -> i64 {
    if low {
        return start
    }
    if high {
        return start + extent
    }
    return start + extent / 2
}

fn axis_shift(low: bool, high: bool, extent: i64) -> i64 {
    if low {
        return 0 - extent
    }
    if high {
        return 0
    }
    return 0 - extent / 2
}

fn placed(size: u64, rect: u64, settings: u64, offset: u64) -> u64 {
    let anchor: u64 = settings & SETTING_MASK
    let gravity: u64 = (settings >> SETTING_BYTE) & SETTING_MASK
    let w: i64 = field(size, 0)
    let h: i64 = field(size, 1)
    let ax: i64 = axis_origin(is_left(anchor), is_right(anchor), field(rect, 0), field(rect, 2))
    let ay: i64 = axis_origin(is_top(anchor), is_bottom(anchor), field(rect, 1), field(rect, 3))
    let x: i64 = ax + axis_shift(is_left(gravity), is_right(gravity), w) + field(offset, 0)
    let y: i64 = ay + axis_shift(is_top(gravity), is_bottom(gravity), h) + field(offset, 1)
    return pack4(x, y, w, h)
}

fn clamp_axis(pos: i64, extent: i64, limit: i64) -> i64 {
    var p: i64 = pos
    if p + extent > limit {
        p = limit - extent
    }
    if p < 0 {
        p = 0
    }
    return p
}
