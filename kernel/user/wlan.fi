// kernel/user/wlan.fi -- /bin/wlan, Runde WLAN-2.

profile kernel

import ulib
import wlan.usbchip
import wlan.ar9271
import wlan.link
import crypto.sha256

export { u_start }

const SYS_CHMOD: u64 = 90

const PBKDF2_RUNDEN: u64 = 4096

fn hexziffer(v: u64) -> u8 {
    if v < 10 {
        return (48 + v) as u8
    }
    return (87 + v) as u8
}

// ------------------------------------------------------------------
// wlan status
// ------------------------------------------------------------------

fn status() -> u64 {
    var s1: [u8; 38] = "wlan: no device -- there is no driver\0"
    var s2: [u8; 53] = "wlan: a USB stick would be RECOGNIZED by its number,\0"
    var s3: [u8; 55] = "      but none is driven. 'wlan chips' shows the list.\0"
    var s4: [u8; 59] = "wlan: what is missing is in docs/WLAN.md sections 5 and 8.\0"
    ulib.say((&s1[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&s2[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&s3[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&s4[0 as usize]) as u64)
    ulib.nl()
    return 0
}

fn chips() -> u64 {
    var head: [u8; 46] = "wlan: these USB ids are recognized and NAMED:\0"
    var fuss: [u8; 59] = "wlan: none of them has a driver. On real hardware the line\0"
    var fuss2: [u8; 52] = "      reads 'wifi-usb: <name> (<vid>:<pid>), no...'\0"
    ulib.say((&head[0 as usize]) as u64)
    ulib.nl()
    var name: [u8; 40] = [0; 40]
    var row: [u8; 80] = [0; 80]
    var k: u64 = 0
    let n: u64 = usbchip.entry_count() as u64
    while k < n {
        let vid: u64 = usbchip.entry_vid(k as usize)
        let pid: u64 = usbchip.entry_pid(k as usize)
        var at: u64 = 0
        row[(at) as usize] = 32 as u8
        at = at + 1
        row[(at) as usize] = 32 as u8
        at = at + 1
        var sh: u64 = 12
        while sh < 16 {
            row[(at) as usize] = hexziffer((vid >> sh) & 15)
            at = at + 1
            if sh == 0 { sh = 16 } else { sh = sh - 4 }
        }
        row[(at) as usize] = 58 as u8
        at = at + 1
        sh = 12
        while sh < 16 {
            row[(at) as usize] = hexziffer((pid >> sh) & 15)
            at = at + 1
            if sh == 0 { sh = 16 } else { sh = sh - 4 }
        }
        row[(at) as usize] = 32 as u8
        at = at + 1
        row[(at) as usize] = 32 as u8
        at = at + 1
        usbchip.name_get(vid, pid, (&name[0 as usize]) as u64)
        var i: u64 = 0
        while name[(i) as usize] != 0 as u8 {
            row[(at) as usize] = name[(i) as usize]
            at = at + 1
            i = i + 1
        }
        row[(at) as usize] = 0 as u8
        ulib.say((&row[0 as usize]) as u64)
        ulib.nl()
        k = k + 1
    }
    ulib.say((&fuss[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&fuss2[0 as usize]) as u64)
    ulib.nl()
    return 0
}

// ------------------------------------------------------------------
// wlan scan
// ------------------------------------------------------------------

fn scan() -> u64 {
    var s1: [u8; 44] = "wlan: no scan -- that needs a radio device.\0"
    var s2: [u8; 60] = "wlan: the scan itself is built and measured (parse beacons,\0"
    var s3: [u8; 63] = "      collect networks, reject insecure ones); what is missing\0"
    var s4: [u8; 46] = "      is the driver that delivers the frames.\0"
    ulib.say((&s1[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&s2[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&s3[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&s4[0 as usize]) as u64)
    ulib.nl()
    return 1
}

// ------------------------------------------------------------------
// wlan connect <ssid> <psk>
// ------------------------------------------------------------------

fn connect_cmd(ssid: u64, psk: u64) -> u64 {
    var s_short: [u8; 58] = "wlan: the password must be 8 to 63 characters (WPA2/WPA3)\0"
    var s_ssid: [u8; 50] = "wlan: the network name must be 1 to 32 characters\0"
    var s_ok: [u8; 42] = "wlan: /etc/wlan.conf written for network \0"
    var s_pmk: [u8; 46] = "wlan: the PMK is computed on connect, not now\0"
    var s_no: [u8; 35] = "wlan: cannot create /etc/wlan.conf\0"
    var s_rechte: [u8; 45] = "wlan: mode 0600 failed -- file removed again\0"
    var s_hin: [u8; 51] = "wlan: this does NOT connect -- there is no driver.\0"
    var conf_path: [u8; 15] = "/etc/wlan.conf\0"

    let sl: u64 = ulib.length(ssid)
    let pl: u64 = ulib.length(psk)
    if sl == 0 || sl > 32 {
        ulib.say((&s_ssid[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    if pl < 8 || pl > 63 {
        ulib.say((&s_short[0 as usize]) as u64)
        ulib.nl()
        return 1
    }

    var inhalt: [u8; 256] = [0; 256]
    var at: u64 = 0
    var k_ssid: [u8; 6] = "ssid \0"
    var k_psk: [u8; 5] = "psk \0"
    var i: u64 = 0
    while k_ssid[(i) as usize] != 0 as u8 {
        inhalt[(at) as usize] = k_ssid[(i) as usize]
        at = at + 1
        i = i + 1
    }
    i = 0
    while i < sl {
        inhalt[(at) as usize] = __mmio_read8((ssid + i) as *mut u8)
        at = at + 1
        i = i + 1
    }
    inhalt[(at) as usize] = 10 as u8
    at = at + 1
    i = 0
    while k_psk[(i) as usize] != 0 as u8 {
        inhalt[(at) as usize] = k_psk[(i) as usize]
        at = at + 1
        i = i + 1
    }
    i = 0
    while i < pl {
        inhalt[(at) as usize] = __mmio_read8((psk + i) as *mut u8)
        at = at + 1
        i = i + 1
    }
    inhalt[(at) as usize] = 10 as u8
    at = at + 1

    // O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&conf_path[0 as usize]) as u64,
        577, 384)
    if ulib.bad(fd) {
        ulib.say((&s_no[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    ulib.sys(ulib.SYS_WRITE, fd, (&inhalt[0 as usize]) as u64, at)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)

    let r: u64 = ulib.sys(SYS_CHMOD, (&conf_path[0 as usize]) as u64, 384, 0)
    if ulib.bad(r) {
        ulib.sys(ulib.SYS_UNLINK, (&conf_path[0 as usize]) as u64, 0, 0)
        ulib.say((&s_rechte[0 as usize]) as u64)
        ulib.nl()
        return 1
    }

    ulib.say((&s_ok[0 as usize]) as u64)
    ulib.say(ssid)
    ulib.nl()
    ulib.say((&s_pmk[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&s_hin[0 as usize]) as u64)
    ulib.nl()
    return 0
}

fn forget() -> u64 {
    var conf_path: [u8; 15] = "/etc/wlan.conf\0"
    var s_w: [u8; 29] = "wlan: /etc/wlan.conf deleted\0"
    var s_n: [u8; 36] = "wlan: /etc/wlan.conf does not exist\0"
    let r: u64 = ulib.sys(ulib.SYS_UNLINK, (&conf_path[0 as usize]) as u64, 0, 0)
    if ulib.bad(r) {
        ulib.say((&s_n[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    ulib.say((&s_w[0 as usize]) as u64)
    ulib.nl()
    return 0
}

// ------------------------------------------------------------------
// wlan fw -- is the AR9271 firmware on disk, and is it the pinned one?
// ------------------------------------------------------------------
// Streams the file through SHA-256 (no big buffer) and compares with the
// digest pinned in lib/wlan/ar9271.fi. Loading it into a chip is the
// kernel USB glue's job (not wired yet, roadmap r21 / M1).

fn fw_check() -> u64 {
    var path: [u8; 42] = "/lib/firmware/ath9k_htc/htc_9271-1.4.0.fw\0"
    var s_none: [u8; 60] = "wlan fw: file missing (/lib/firmware/ath9k_htc/htc_9271...)\0"
    var s_ok: [u8; 37] = "wlan fw: firmware found, pin MATCHES\0"
    var s_bad: [u8; 60] = "wlan fw: file present but pin DOES NOT MATCH -- not loading\0"
    var s_sz: [u8; 16] = "wlan fw: Bytes \0"
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&path[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        ulib.say((&s_none[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    var h: sha256.Sha256 = sha256.sha256_new()
    sha256.begin(&h)
    var chunk: [u8; 1024] = [0; 1024]
    var total: u64 = 0
    var go: bool = true
    while go {
        let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&chunk[0 as usize]) as u64, 1024)
        if ulib.bad(n) || n == 0 {
            go = false
        } else {
            sha256.update(&h, (&chunk[0 as usize]) as u64, n as usize)
            total = total + n
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    var d: [u8; 32] = [0; 32]
    sha256.finish(&h, (&d[0 as usize]) as u64)
    ulib.say((&s_sz[0 as usize]) as u64)
    ulib.sayu(total)
    ulib.nl()
    if ar9271.digest_pinned((&d[0 as usize]) as u64) {
        ulib.say((&s_ok[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    ulib.say((&s_bad[0 as usize]) as u64)
    ulib.nl()
    return 1
}

// ------------------------------------------------------------------
// wlan link -- the connection path (lib/wlan/link.fi) in this program
// ------------------------------------------------------------------
// Builds the Link object (session + group key state + per-network rate/width/standard) and reports what
// it knows. Without a radio no beacon and no EAPOL frame ever reaches it, so it knows nothing yet; the
// line says so. The wiring is real (the same object the driver will feed), the data is not there.

fn link_cmd() -> u64 {
    var s1: [u8; 85] = "wlan link: connection path built in (EAPOL dispatch, group key, rate/width/standard)\0"
    var s2: [u8; 40] = "wlan link: last frame kind (0 = none): \0"
    var s3: [u8; 54] = "wlan link: no frames yet -- they arrive with a driver\0"
    var l: link.Link = link.link_new()
    ulib.say((&s1[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&s2[0 as usize]) as u64)
    ulib.sayu(link.link_last_kind(&l))
    ulib.nl()
    if link.link_last_kind(&l) == link.LK_NONE {
        ulib.say((&s3[0 as usize]) as u64)
        ulib.nl()
    }
    return 0
}

fn help() -> u64 {
    var h1: [u8; 32] = "wlan -- set up and inspect WLAN\0"
    var h2: [u8; 31] = "  wlan status            state\0"
    var h3: [u8; 53] = "  wlan chips             which sticks are recognized\0"
    var h4: [u8; 45] = "  wlan scan              search for networks\0"
    var h5: [u8; 28] = "  wlan connect <ssid> <psk>\0"
    var h6: [u8; 47] = "  wlan forget            delete /etc/wlan.conf\0"
    ulib.say((&h1[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&h2[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&h3[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&h4[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&h5[0 as usize]) as u64)
    ulib.nl()
    ulib.say((&h6[0 as usize]) as u64)
    ulib.nl()
    return 0
}

fn u_start(args: u64) -> u64 {
    var c_status: [u8; 7] = "status\0"
    var c_chips: [u8; 6] = "chips\0"
    var c_scan: [u8; 5] = "scan\0"
    var c_fw: [u8; 3] = "fw\0"
    var c_link: [u8; 5] = "link\0"
    var c_conn: [u8; 8] = "connect\0"
    var c_forget: [u8; 7] = "forget\0"
    var c_verb: [u8; 10] = "verbinden\0"
    var c_verg: [u8; 10] = "vergessen\0"

    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        return help()
    }
    let b: u64 = ulib.arg_at(args, 1)
    if ulib.streq(b, (&c_status[0 as usize]) as u64) {
        return status()
    }
    if ulib.streq(b, (&c_chips[0 as usize]) as u64) {
        return chips()
    }
    if ulib.streq(b, (&c_fw[0 as usize]) as u64) {
        return fw_check()
    }
    if ulib.streq(b, (&c_link[0 as usize]) as u64) {
        return link_cmd()
    }
    if ulib.streq(b, (&c_scan[0 as usize]) as u64) {
        return scan()
    }
    if ulib.streq(b, (&c_forget[0 as usize]) as u64) || ulib.streq(b, (&c_verg[0 as usize]) as u64) {
        return forget()
    }
    if ulib.streq(b, (&c_conn[0 as usize]) as u64) || ulib.streq(b, (&c_verb[0 as usize]) as u64) {
        if argc < 4 {
            return help()
        }
        return connect_cmd(ulib.arg_at(args, 2), ulib.arg_at(args, 3))
    }
    return help()
}
