profile app

import msg
import setroute
import libc.text
import ulib

export { query, title_at, open_page }

const MAX_PAGES: u64 = 8

static mut hit_pages: [u64; 8] = [0 as u64; 8]
static mut hit_count: u64 = 0
static mut exec_path: [u8; 25] = "/apps/settings.osp/start\0"
static mut arg_prefix: [u8; 6] = "page=\0"

fn query(term: u64, out: u64, max: u64) -> u64 {
    hit_count = 0
    if text.length(term) == 0 || !setroute.init() {
        return 0
    }
    let _found: u64 = setroute.query_pages(term)
    let raw: u64 = setroute.hit_raw()
    var i: u64 = 0
    while i < raw && hit_count < max && hit_count < MAX_PAGES {
        let page: u64 = setroute.hit_page(i)
        if page != setroute.NONE && !contains(page) {
            hit_pages[(hit_count) as usize] = page
            __mmio_write64((out + hit_count * 8) as *mut u64, page)
            hit_count = hit_count + 1
        }
        i = i + 1
    }
    return hit_count
}

fn contains(page: u64) -> bool {
    var k: u64 = 0
    while k < hit_count {
        if hit_pages[(k) as usize] == page {
            return true
        }
        k = k + 1
    }
    return false
}

fn title_at(page: u64) -> u64 {
    return setroute.page_title(page)
}

fn open_page(page: u64) -> u64 {
    var arg: [u8; 24] = [0 as u8; 24]
    var argv: [u64; 2] = [0 as u64; 2]
    ulib.strncpy((&arg[0 as usize]) as u64, (&arg_prefix[0 as usize]) as u64, 6)
    let digits: u64 = text.digits(page, ((&arg[0 as usize]) as u64) + 5, false)
    __mmio_write8(((&arg[0 as usize]) as u64 + 5 + digits) as *mut u8, 0 as u8)
    argv[0 as usize] = (&exec_path[0 as usize]) as u64
    argv[1 as usize] = (&arg[0 as usize]) as u64
    return ulib.spawn_app((&exec_path[0 as usize]) as u64, (&argv[0 as usize]) as u64, 2)
}
