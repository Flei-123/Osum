profile kernel

import ulib
import lineout

export { u_start }

static mut n_short: [u8; 6] = "short\0";
static mut n_mb: [u8; 3] = "mb\0";
static mut n_dticks: [u8; 7] = "dticks\0";
static mut n_total: [u8; 12] = "total_ticks\0";
static mut n_used: [u8; 12] = "blocks_used\0";
static mut chunk: [u8; 65536] = [0 as u8; 65536];

fn report(name: u64, value: u64) {
    var head: [u8; 9] = "wbench: \0";
    var eq: [u8; 4] = " = \0";
    lineout.add_text((&head[0 as usize]) as u64);
    lineout.add_text(name);
    lineout.add_text((&eq[0 as usize]) as u64);
    lineout.add_unum(value);
    lineout.end_line();
}

fn parse(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while *((p + i) as *mut u8) >= 48 as u8 && *((p + i) as *mut u8) <= 57 as u8 {
        v = v * 10 + ((*((p + i) as *mut u8)) as u64 - 48)
        i = i + 1
    }
    return v
}

fn ticks() -> u64 {
    return ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
}

fn u_start(args: u64) -> u64 {
    if ulib.arg_count(args) < 4 {
        return 2
    }
    let path: u64 = ulib.arg_at(args, 1)
    let total: u64 = parse(ulib.arg_at(args, 2)) * 1048576
    var size: u64 = parse(ulib.arg_at(args, 3))
    if size > 65536 {
        size = 65536
    }
    var i: u64 = 0
    while i < size {
        chunk[(i) as usize] = ((i * 7 + 1) & 255) as u8
        i = i + 1
    }
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, ulib.O_MAKE, 0)
    if ulib.bad(fd) {
        return 1
    }
    let free0: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_BFREE, 0, 0)
    let t0: u64 = ticks()
    var last: u64 = t0
    var done: u64 = 0
    var mark: u64 = 8388608
    while done < total {
        let n: u64 = ulib.sys(ulib.SYS_WRITE, fd, (&chunk[0 as usize]) as u64, size)
        if ulib.bad(n) || n != size {
            report((&n_short[0 as usize]) as u64, done)
            return 3
        }
        done = done + size
        if done >= mark {
            let t: u64 = ticks()
            report((&n_mb[0 as usize]) as u64, done / 1048576)
            report((&n_dticks[0 as usize]) as u64, t - last)
            last = t
            mark = mark + 8388608
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    report((&n_total[0 as usize]) as u64, ticks() - t0)
    report((&n_used[0 as usize]) as u64, free0 - ulib.sys(ulib.SYS_SYSINFO, ulib.I_BFREE, 0, 0))
    return 0
}
