// SPDX-License-Identifier: GPL-2.0-only
profile app

import ulib
import libc.clockapi
import lineout
import fuiapp
import fuiscene
import busy
import wlib
import wlibc

export { u_start }

static mut t_title: [u8; 11] = "Scale demo\0"
static mut t_box: [u8; 15] = "scaledemo: box\0"
static mut t_w: [u8; 4] = " w=\0"
static mut t_h: [u8; 4] = " h=\0"
static mut t_sm: [u8; 5] = " sm=\0"
static mut t_pct: [u8; 6] = " pct=\0"
static mut t_inx: [u8; 6] = " inx=\0"
static mut t_iny: [u8; 6] = " iny=\0"
static mut t_capw: [u8; 7] = " capw=\0"
static mut last_inx: u64 = 0
static mut last_w: u64 = 0
static mut last_sm: u64 = 0

const BOX_W: u64 = 100
const BOX_H: u64 = 40
const BOX_KEY: u64 = 1

static mut APP_BUNDLE_NAME: [u8; 10] = "scaledemo\0"

fn say(p: u64) {
    let _r: u64 = lineout.add_text(p)
}

fn draw(key: u64, x: u64, y: u64, w: u64, h: u64) {
    let bw: u64 = fuiscene.sp(BOX_W)
    let bh: u64 = fuiscene.sp(BOX_H)
    fuiscene.cv_round_raw(x, y, bw, bh, 0, 4294902015 as u32)
    if bw != last_w || fuiscene.scale_milli() != last_sm || wlibc.win_info(wlib.handle(fuiapp.win()), wlibc.WI_INX) != last_inx {
        last_inx = wlibc.win_info(wlib.handle(fuiapp.win()), wlibc.WI_INX)
        last_w = bw
        last_sm = fuiscene.scale_milli()
        say((&t_box[0 as usize]) as u64)
        say((&t_w[0 as usize]) as u64)
        lineout.add_num(bw)
        say((&t_h[0 as usize]) as u64)
        lineout.add_num(bh)
        say((&t_sm[0 as usize]) as u64)
        lineout.add_num(last_sm)
        say((&t_pct[0 as usize]) as u64)
        lineout.add_num(wlibc.win_scale_pct(wlib.handle(fuiapp.win())))
        say((&t_inx[0 as usize]) as u64)
        lineout.add_num(wlibc.win_info(wlib.handle(fuiapp.win()), wlibc.WI_INX))
        say((&t_iny[0 as usize]) as u64)
        lineout.add_num(wlibc.win_info(wlib.handle(fuiapp.win()), wlibc.WI_INY))
        say((&t_capw[0 as usize]) as u64)
        lineout.add_num(wlibc.win_info(wlib.handle(fuiapp.win()), wlibc.WI_CAPW))
        lineout.end_line()
    }
}

fn build() {
    let col: usize = fuiscene.root()
    let _c: usize = fuiscene.canvas2(col, BOX_KEY, BOX_W, BOX_H, draw)
}

fn arg_number(args: u64, index: u64, fallback: u64) -> u64 {
    if ulib.arg_count(args) <= index {
        return fallback
    }
    var n: u64 = 0
    let p: u64 = ulib.arg_at(args, index)
    var i: u64 = 0
    while __mmio_read8((p + i) as *mut u8) >= 48 as u8 && __mmio_read8((p + i) as *mut u8) <= 57 as u8 {
        n = n * 10 + (__mmio_read8((p + i) as *mut u8) as u64 - 48)
        i = i + 1
    }
    return n
}

fn u_start(args: u64) -> u64 {
    let x: u64 = arg_number(args, 1, 60)
    let y: u64 = arg_number(args, 2, 60)
    if !fuiscene.open(x, y, 320, 200, (&t_title[0 as usize]) as u64, build) {
        return 1
    }
    fuiscene.set_app((&APP_BUNDLE_NAME[0 as usize]) as u64)
    let hot_on: u64 = arg_number(args, 3, 0)
    let t0: u64 = fuiapp.now_ms()
    var hot_step: u64 = 0
    while fuiscene.alive() && fuiapp.now_ms() - t0 < 120000 {
        let _c: bool = busy.tick()
        let t: u64 = fuiapp.now_ms() - t0
        if hot_on != 0 && hot_step == 0 && t >= 30000 {
            hot_step = 1
            let _h: bool = wlibc.head_hot(1)
        }
        if hot_on != 0 && hot_step == 1 && t >= 34000 {
            hot_step = 2
            let _h: bool = wlibc.head_hot(1)
        }
        let _s: u64 = clockapi.sleep_ms(10)
    }
    fuiscene.quit()
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
