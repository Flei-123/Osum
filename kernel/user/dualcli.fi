profile kernel

import ulib
import instkern
import dualkern
import wunlock
import shrinkflow
import instinfo
import ntfsshrink.codes

export { u_start }

const BS: u64 = 512

const MIN_GAP: u64 = 65536

static mut S_USE: [u8; 42] = "dualcli TARGET [--ja] [--free MIB]\0\0\0\0\0\0\0\0"
static mut O_YES: [u8; 6] = "--ja\0\0"
static mut O_INFO: [u8; 7] = "--info\0"
static mut O_FREE: [u8; 8] = "--free\0\0"
static mut S_RECOVER: [u8; 16] = "dual: recover=\0\0"
static mut S_SH_OFFER: [u8; 16] = "dual: shoffer \0\0"
static mut S_SH_PLAN: [u8; 16] = "dual: shplan \0\0\0"
static mut S_SH_REFUSE: [u8; 18] = "dual: shrefuse \0\0\0"
static mut S_SH_RESULT: [u8; 18] = "dual: shresult=\0\0\0"
static mut S_SH_PROG: [u8; 14] = "dual: shprog \0"
static mut sh_last_pct: u64 = 101
static mut S_SH_DONE: [u8; 16] = "dual: shrunk \0\0\0"
static mut O_SOURCE: [u8; 10] = "--quelle\0\0"
static mut D_SOURCE: [u8; 10] = "/dev/ram0\0"

static mut S_NO_KERNEL: [u8; 27] = "dual: kernel image missing\0"
static mut S_NOOPEN: [u8; 17] = "dual: no access \0"
static mut S_TABLE: [u8; 14] = "dual: table=\0\0"
static mut S_PART: [u8; 13] = "dual: part \0\0"
static mut S_FREE: [u8; 13] = "dual: free \0\0"
static mut S_ESP: [u8; 12] = "dual: esp=\0\0"
static mut S_NO_GPT: [u8; 15] = "dual: no gpt\0\0\0"
static mut S_BROKEN: [u8; 20] = "dual: gpt broken\0\0\0\0"
static mut S_G_READ: [u8; 24] = "dual: gpt read failed\0\0\0"
static mut S_G_HSIZE: [u8; 28] = "dual: gpt header size bad\0\0\0"
static mut S_G_HCRC: [u8; 28] = "dual: gpt header crc bad\0\0\0\0"
static mut S_G_ESIZE: [u8; 28] = "dual: gpt entry size bad\0\0\0\0"
static mut S_G_COUNT: [u8; 28] = "dual: gpt entry count bad\0\0\0"
static mut S_G_TCRC: [u8; 28] = "dual: gpt table crc bad\0\0\0\0\0"
static mut S_G_AT: [u8; 8] = " got=\0\0\0"
static mut S_G_WANT: [u8; 8] = " want=\0\0"
static mut S_TOO_LITTLE: [u8; 20] = "dual: too little\0\0\0\0"
static mut S_NO_ESP: [u8; 15] = "dual: no esp\0\0\0"
static mut S_ESP_TOO_SMALL: [u8; 21] = "dual: esp too small\0\0"
static mut S_DRY_RUN: [u8; 19] = "dual: dry run, end\0"
static mut S_NEW: [u8; 13] = "dual: new p\0\0"
static mut S_COPIED: [u8; 13] = "dual: copied\0"
static mut S_GROW: [u8; 12] = "dual: grown\0"
static mut S_DONE: [u8; 12] = "dual: done\0\0"
static mut S_ERROR: [u8; 13] = "dual: ERROR \0"
static mut S_SPACE: [u8; 2] = " \0"

fn say_space() {
    ulib.say((&S_SPACE[0 as usize]) as u64)
}

fn error_code(n: u64) -> u64 {
    ulib.say((&S_ERROR[0 as usize]) as u64)
    ulib.sayu(n)
    ulib.nl()
    wunlock.relock()
    return 1
}

fn gpt_detail() {
    ulib.say((&S_G_AT[0 as usize]) as u64)
    ulib.sayu(dualkern.detail_got())
    ulib.say((&S_G_WANT[0 as usize]) as u64)
    ulib.sayu(dualkern.detail_want())
}

fn say_reason() {
    let g: u64 = dualkern.reason_code()
    if g == dualkern.D_NO_GPT {
        ulib.say((&S_NO_GPT[0 as usize]) as u64)
    } else if g == dualkern.D_BROKEN {
        ulib.say((&S_BROKEN[0 as usize]) as u64)
    } else if g == dualkern.D_READ {
        ulib.say((&S_G_READ[0 as usize]) as u64)
        gpt_detail()
    } else if g == dualkern.D_HSIZE {
        ulib.say((&S_G_HSIZE[0 as usize]) as u64)
        gpt_detail()
    } else if g == dualkern.D_HCRC {
        ulib.say((&S_G_HCRC[0 as usize]) as u64)
        gpt_detail()
    } else if g == dualkern.D_ESIZE {
        ulib.say((&S_G_ESIZE[0 as usize]) as u64)
        gpt_detail()
    } else if g == dualkern.D_COUNT {
        ulib.say((&S_G_COUNT[0 as usize]) as u64)
        gpt_detail()
    } else if g == dualkern.D_TCRC {
        ulib.say((&S_G_TCRC[0 as usize]) as u64)
        gpt_detail()
    } else if g == dualkern.D_TOO_LITTLE {
        ulib.say((&S_TOO_LITTLE[0 as usize]) as u64)
    } else if g == dualkern.D_NO_ESP {
        ulib.say((&S_NO_ESP[0 as usize]) as u64)
    } else if g == dualkern.D_ESP_TOO_SMALL {
        ulib.say((&S_ESP_TOO_SMALL[0 as usize]) as u64)
    } else {
        ulib.say((&S_ERROR[0 as usize]) as u64)
        ulib.sayu(g)
    }
    ulib.nl()
}

static mut ESPNAME: [u8; 24] = [0 as u8; 24]

fn esp_name(dev: u64, nr: u64) -> u64 {
    let p: u64 = (&ESPNAME[0 as usize]) as u64
    ulib.strcpy(p, dev)
    let n: u64 = ulib.length(p)
    if n + 2 < 24 && nr >= 1 && nr <= 9 {
        __mmio_write8((p + n) as *mut u8, (48 + nr) as u8)
        __mmio_write8((p + n + 1) as *mut u8, 0 as u8)
    }
    return p
}

static mut P_EFI: [u8; 6] = "/efi\0\0"
static mut P_EFI_EFI: [u8; 10] = "/efi/EFI\0\0"
static mut P_EFI_BOOT: [u8; 16] = "/efi/EFI/BOOT\0\0\0"
static mut P_EFI_OS: [u8; 18] = "/efi/EFI/orientos\0"
static mut P_EFI_OSKERN: [u8; 26] = "/efi/EFI/orientos/osum.mb\0"
static mut P_EFI_OSLDR: [u8; 30] = "/efi/EFI/orientos/BOOTX64.EFI\0"
static mut P_EFI_LDR: [u8; 26] = "/efi/EFI/BOOT/BOOTX64.EFI\0"
static mut P_EFI_LIM: [u8; 17] = "/efi/limine.conf\0"
static mut P_FOREIGN: [u8; 37] = "/efi/EFI/Microsoft/Boot/bootmgfw.efi\0"
static mut P_SRC_KERN: [u8; 14] = "/boot/osum.mb\0"
static mut P_SRC_LDR: [u8; 18] = "/boot/BOOTX64.EFI\0"
static mut T_VFAT: [u8; 5] = "vfat\0"

static mut LIM1: [u8; 199] = "timeout: 5\ndefault_entry: 1\n\n/OrientOS\n    protocol: multiboot1\n    path: boot():/EFI/orientos/osum.mb\n    cmdline: osum vfs gfx wm wig desk wmshell wmdauer herz tz=60 tzrule=eu nosched noproc nofs\n\0"
static mut LIM2: [u8; 102] = "\n/Windows Boot Manager\n    protocol: efi_chainload\n    path: boot():/EFI/Microsoft/Boot/bootmgfw.efi\n\0"

static mut S_MENU: [u8; 13] = "dual: menu=\0\0"
static mut S_SOURCE: [u8; 15] = "dual: source=\0\0"
static mut S_SRC_REASON: [u8; 19] = "dual: srcreason=\0\0\0"
static mut S_SRC_SECT: [u8; 16] = "dual: srcsect=\0\0"

fn file_exists(path: u64) -> bool {
    let f: u64 = ulib.sys(ulib.SYS_OPEN, path, 0, 0)
    if ulib.bad(f) {
        return false
    }
    ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
    return true
}

fn start_file() -> u64 {
    let foreign: bool = file_exists((&P_FOREIGN[0 as usize]) as u64)
    ulib.sys(ulib.SYS_UNLINK, (&P_EFI_LIM[0 as usize]) as u64, 0, 0)
    let f: u64 = ulib.sys(ulib.SYS_OPEN, (&P_EFI_LIM[0 as usize]) as u64,
        ulib.O_MAKE, 0)
    if ulib.bad(f) {
        return 0
    }
    let n1: u64 = ulib.length((&LIM1[0 as usize]) as u64)
    let w1: u64 = ulib.sys(ulib.SYS_WRITE, f, (&LIM1[0 as usize]) as u64, n1)
    if ulib.bad(w1) || w1 != n1 {
        ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
        return 0
    }
    var how_many: u64 = 1
    if foreign {
        let n2: u64 = ulib.length((&LIM2[0 as usize]) as u64)
        let w2: u64 = ulib.sys(ulib.SYS_WRITE, f, (&LIM2[0 as usize]) as u64, n2)
        if ulib.bad(w2) || w2 != n2 {
            ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
            return 0
        }
        how_many = 2
    }
    ulib.sys(ulib.SYS_CLOSE, f, 0, 0)
    return how_many
}

fn bootloader(espdev: u64) -> bool {
    ulib.sys(ulib.SYS_MKDIR, (&P_EFI[0 as usize]) as u64, 0, 0)
    let m: u64 = ulib.sys4(ulib.SYS_VMOUNT, espdev,
        (&P_EFI[0 as usize]) as u64, (&T_VFAT[0 as usize]) as u64, 0)
    if ulib.bad(m) {
        return false
    }

    ulib.sys(ulib.SYS_MKDIR, (&P_EFI_EFI[0 as usize]) as u64, 0, 0)
    ulib.sys(ulib.SYS_MKDIR, (&P_EFI_OS[0 as usize]) as u64, 0, 0)
    ulib.sys(ulib.SYS_MKDIR, (&P_EFI_BOOT[0 as usize]) as u64, 0, 0)
    var succeeded: bool = true
    if !instkern.copy_file(instkern.kernel_source(),
        (&P_EFI_OSKERN[0 as usize]) as u64) {
        succeeded = false
    }
    if succeeded && !instkern.copy_file((&P_SRC_LDR[0 as usize]) as u64,
        (&P_EFI_OSLDR[0 as usize]) as u64) {
        succeeded = false
    }
    if succeeded && !instkern.copy_file((&P_SRC_LDR[0 as usize]) as u64,
        (&P_EFI_LDR[0 as usize]) as u64) {
        succeeded = false
    }
    if succeeded {
        let w: u64 = start_file()
        ulib.say((&S_MENU[0 as usize]) as u64)
        ulib.sayu(w)
        ulib.nl()
        if w == 0 {
            succeeded = false
        }
    }
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.sys(ulib.SYS_UMOUNT2, (&P_EFI[0 as usize]) as u64, 0, 0)
    return succeeded
}

fn shrink_progress(phase: u64, pct: u64) -> u64 {
    let all: u64 = shrinkflow.overall_pct(phase, pct)
    if all != sh_last_pct && (all % 10 == 0 || all == 100) {
        sh_last_pct = all
        ulib.say((&S_SH_PROG[0 as usize]) as u64)
        ulib.sayu(all)
        ulib.nl()
    }
    return 0
}

fn shrink_step(dst_fd: u64, sect_count: u64, dest_buf: u64, args: u64, argc: u64, yes: bool, free_mib: u64) -> u64 {
    let s: u64 = shrinkflow.scan()
    if s == shrinkflow.S_NONE {
        say_reason()
        return 2
    }
    if s == shrinkflow.S_REFUSED {
        ulib.say((&S_SH_REFUSE[0 as usize]) as u64)
        ulib.sayu(shrinkflow.refusal())
        ulib.nl()
        return 2
    }
    ulib.say((&S_SH_OFFER[0 as usize]) as u64)
    ulib.sayu(shrinkflow.offer_part())
    say_space()
    ulib.sayu(shrinkflow.offer_psize())
    say_space()
    ulib.sayu(shrinkflow.offer_free())
    ulib.nl()
    var free: u64 = shrinkflow.free_target(shrinkflow.offer_free())
    if free_mib != 0 {
        free = free_mib * 2048
    }
    ulib.say((&S_SH_PLAN[0 as usize]) as u64)
    ulib.sayu(shrinkflow.new_size_for(shrinkflow.offer_base(), shrinkflow.offer_psize(), free))
    say_space()
    ulib.sayu(free)
    ulib.nl()
    if !yes {
        ulib.say((&S_DRY_RUN[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    if !wunlock.confirm_unlock(dst_fd, dest_buf, args, argc) {
        return 3
    }
    let r: u64 = shrinkflow.run_shrink(free, shrink_progress)
    ulib.say((&S_SH_RESULT[0 as usize]) as u64)
    ulib.sayu(r)
    ulib.nl()
    if r != codes.E_OK {
        wunlock.relock()
        return 3
    }
    let n: u64 = dualkern.read_table(dst_fd, sect_count)
    ulib.say((&S_SH_DONE[0 as usize]) as u64)
    ulib.sayu(n)
    ulib.nl()
    if !dualkern.gpt_verify() {
        say_reason()
        return 3
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        ulib.say((&S_USE[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    let dest_buf: u64 = ulib.arg_at(args, 1)
    var yes: bool = false
    var info: bool = false
    var free_mib: u64 = 0

    var source: u64 = (&D_SOURCE[0 as usize]) as u64
    var i: u64 = 2
    while i < argc {
        let a: u64 = ulib.arg_at(args, i)
        if ulib.streq(a, (&O_YES[0 as usize]) as u64) {
            yes = true
        } else if ulib.streq(a, (&O_INFO[0 as usize]) as u64) {
            info = true
        } else if ulib.streq(a, (&O_FREE[0 as usize]) as u64) && i + 1 < argc {
            i = i + 1
            free_mib = shrinkflow.parse_dec(ulib.arg_at(args, i))
        } else if ulib.streq(a, (&O_SOURCE[0 as usize]) as u64) && i + 1 < argc {
            i = i + 1
            source = ulib.arg_at(args, i)
        }
        i = i + 1
    }

    if info {
        let rfd: u64 = ulib.sys(ulib.SYS_OPEN, dest_buf, 0, 0)
        if ulib.bad(rfd) {
            ulib.say((&S_NOOPEN[0 as usize]) as u64)
            ulib.say(dest_buf)
            ulib.nl()
            return 1
        }
        let rc: u64 = instinfo.report(rfd, ulib.size_of(dest_buf) / BS)
        ulib.sys(ulib.SYS_CLOSE, rfd, 0, 0)
        return rc
    }

    let dst_fd: u64 = ulib.sys(ulib.SYS_OPEN, dest_buf, ulib.O_RDWR, 0)
    if ulib.bad(dst_fd) {
        ulib.say((&S_NOOPEN[0 as usize]) as u64)
        ulib.say(dest_buf)
        ulib.nl()
        return 1
    }
    let sect_count: u64 = ulib.size_of(dest_buf) / BS

    shrinkflow.bind(dst_fd, sect_count, dest_buf)
    let fixed: u64 = shrinkflow.recover_pending()
    ulib.say((&S_RECOVER[0 as usize]) as u64)
    ulib.sayu(fixed)
    ulib.nl()

    var n: u64 = dualkern.read_table(dst_fd, sect_count)
    ulib.say((&S_TABLE[0 as usize]) as u64)
    ulib.sayu(n)
    ulib.nl()
    if !dualkern.gpt_verify() {
        say_reason()
        return 1
    }
    var k: u64 = 0
    while k < n {
        ulib.say((&S_PART[0 as usize]) as u64)
        ulib.sayu(k + 1)
        say_space()
        ulib.sayu(dualkern.p_start(k))
        say_space()
        ulib.sayu(dualkern.p_end(k))
        say_space()
        ulib.sayu(dualkern.p_typ(k))
        ulib.nl()
        k = k + 1
    }

    if !dualkern.find_gap(MIN_GAP) {
        let st: u64 = shrink_step(dst_fd, sect_count, dest_buf, args, argc, yes, free_mib)
        if st != 0 {
            return st - 1
        }
        n = dualkern.entry_count()
        if !dualkern.find_gap(MIN_GAP) {
            say_reason()
            return 1
        }
    }
    let from_pos: u64 = dualkern.gap_start()
    let to_pos: u64 = dualkern.gap_end()
    ulib.say((&S_FREE[0 as usize]) as u64)
    ulib.sayu(from_pos)
    say_space()
    ulib.sayu(to_pos)
    ulib.nl()

    let espi: u64 = dualkern.find_esp()
    if espi >= dualkern.entry_count() {
        say_reason()
        return 1
    }
    if !dualkern.esp_big_enough(espi) {
        say_reason()
        return 1
    }
    ulib.say((&S_ESP[0 as usize]) as u64)
    ulib.sayu(espi + 1)
    ulib.nl()

    ulib.say((&S_SOURCE[0 as usize]) as u64)
    ulib.say(source)
    ulib.nl()
    let src_fd: u64 = ulib.sys(ulib.SYS_OPEN, source, 0, 0)
    if ulib.bad(src_fd) {
        return error_code(70)
    }
    let src_check: u64 = instkern.check_source(src_fd)
    if src_check == 0 {

        ulib.say((&S_SRC_REASON[0 as usize]) as u64)
        ulib.sayu(instkern.error_at())
        ulib.nl()
        return error_code(71)
    }
    let src_sect: u64 = ulib.size_of(source) / BS
    ulib.say((&S_SRC_SECT[0 as usize]) as u64)
    ulib.sayu(src_sect)
    ulib.nl()
    if to_pos - from_pos + 1 < src_sect {
        ulib.say((&S_TOO_LITTLE[0 as usize]) as u64)
        ulib.nl()
        return 1
    }

    if !yes {
        ulib.say((&S_DRY_RUN[0 as usize]) as u64)
        ulib.nl()
        return 0
    }

    if !instkern.kernel_ready() {
        ulib.say((&S_NO_KERNEL[0 as usize]) as u64)
        ulib.nl()
        return 1
    }

    if !wunlock.confirm_unlock(dst_fd, dest_buf, args, argc) {
        return 1
    }

    let nr: u64 = dualkern.write_beside(dst_fd, from_pos, to_pos)
    if nr == 0 {
        say_reason()
        return error_code(78)
    }
    ulib.say((&S_NEW[0 as usize]) as u64)
    ulib.sayu(nr)
    say_space()
    ulib.sayu(from_pos)
    say_space()
    ulib.sayu(to_pos)
    ulib.nl()

    if !instkern.copy_root_from(dst_fd, src_fd, from_pos, src_sect) {
        return error_code(79)
    }
    ulib.say((&S_COPIED[0 as usize]) as u64)
    say_space()
    ulib.sayu(src_sect)
    ulib.nl()

    let new_size: u64 = instkern.grow(dst_fd, from_pos, to_pos - from_pos + 1)
    if new_size == 0 {
        return error_code(80)
    }
    ulib.say((&S_GROW[0 as usize]) as u64)
    say_space()
    ulib.sayu(new_size)
    ulib.nl()
    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, dst_fd, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, src_fd, 0, 0)

    let espdev: u64 = esp_name(dest_buf, espi + 1)
    ulib.say((&S_ESP[0 as usize]) as u64)
    ulib.say(espdev)
    ulib.nl()
    if !bootloader(espdev) {
        return error_code(81)
    }

    ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
    wunlock.relock()
    ulib.say((&S_DONE[0 as usize]) as u64)
    ulib.nl()
    return 0
}
