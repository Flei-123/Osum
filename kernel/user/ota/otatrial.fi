profile kernel

import ulib
import ota.otacmd

export { counter_reset, log_rollback }

static mut P_TRY: [u8; 19] = "/sysesp/osboot.try\0"

static mut P_LOG_DIR: [u8; 9] = "/var/log\0"

static mut P_LOG: [u8; 26] = "/var/log/ota-rollback.log\0"

static mut W_ZERO: [u8; 3] = "0\n\0"

static mut S_PRE: [u8; 23] = "rollback: trial kernel\0"

static mut S_SPACE: [u8; 2] = " \0"

static mut S_UPD: [u8; 10] = " (update \0"

static mut S_POST: [u8; 32] = ") failed, previous slot active\n\0"

static mut LOG_LINE: [u8; 128] = [0 as u8; 128]

const COUNTER_LEN: u64 = 2

fn counter_reset() -> bool {
    return otacmd.file_write((&P_TRY[0 as usize]) as u64, (&W_ZERO[0 as usize]) as u64, COUNTER_LEN)
}

fn log_rollback(commit: u64, count: u64) -> bool {
    let line: u64 = (&LOG_LINE[0 as usize]) as u64
    ulib.sys(ulib.SYS_MKDIR, (&P_LOG_DIR[0 as usize]) as u64, 0, 0)
    ulib.strcpy(line, (&S_PRE[0 as usize]) as u64)
    ulib.strcat(line, (&S_SPACE[0 as usize]) as u64)
    ulib.strcat(line, commit)
    ulib.strcat(line, (&S_UPD[0 as usize]) as u64)
    otacmd.num_at(line, count)
    ulib.strcat(line, (&S_POST[0 as usize]) as u64)
    return otacmd.file_write((&P_LOG[0 as usize]) as u64, line, otacmd.len(line))
}
