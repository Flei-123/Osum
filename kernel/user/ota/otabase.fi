// 1 when the last cmd_find could not fetch the VERZEICHNIS (no network yet,
// clock not set, DNS not ready). cmd_dienst then retries soon instead of
// waiting a whole `abstand` (O-002, 03.10.2026: the first search runs before
// DHCP/SNTP and used to cost one hour).
static mut find_missing: u64 = 0

static mut K_ABST: [u8; 9] = "abstand=\0"

static mut K_AUTO: [u8; 6] = "auto=\0"

static mut K_TIMEOUT: [u8; 7] = "frist=\0"

