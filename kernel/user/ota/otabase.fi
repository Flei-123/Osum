static mut ARGV: [u64; 8] = [0 as u64; 8]

static mut vz_len: u64 = 0

const ERP_LEN: u64 = 36

// r542 (11.10.2026): the real peak is ONE package sum plus ONE package, not
// three sums. Each package is deleted from `/tmp/ota` right after `opk`
// installed it (step 7), so the bytes MOVE from the staging file into the
// store entry instead of existing twice. Peak = all staged files (after
// the download) + the store entry of the package being unpacked right now
// (= the largest package) + slack for generation, journal and directory
// entries (SPACE_SLACK + 1/8 of the sum). 15.8 MB of packages need about
// 24 MB this way instead of 47.4 MB (SPACE_FACTOR 3 stays for reference only).
const SPACE_SLACK: u64 = 524288

static mut last_err: [u8; 64] = [0 as u8; 64]

