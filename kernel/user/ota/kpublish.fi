profile kernel

import ulib
import ota.otacmd

export { drop_gz }

static mut P_GZ: [u8; 136] = [0 as u8; 136]

static mut S_GZ_SUFFIX: [u8; 4] = ".gz\0"

fn drop_gz(kernel_path: u64) {
    let n: u64 = ulib.strcpy((&P_GZ[0 as usize]) as u64, kernel_path)
    if n > 128 {
        return
    }
    ulib.strcpy((&P_GZ[0 as usize]) as u64 + n, (&S_GZ_SUFFIX[0 as usize]) as u64)
    otacmd.remove((&P_GZ[0 as usize]) as u64)
}
