static mut C_ZUR: [u8; 9] = "rollback\0"

static mut C_WACH: [u8; 9] = "watchdog\0"

static mut C_DIEN: [u8; 8] = "service\0"

static mut C_BOOT: [u8; 5] = "boot\0"
static mut C_JOIN: [u8; 5] = "join\0"

static mut N_DESK: [u8; 8] = "desktop\0"

static mut N_GLOG: [u8; 7] = "glogin\0"

static mut S_BGUT: [u8; 43] = "ota: start healthy, trial confirmed after \0"

static mut S_BNEU: [u8; 77] = "ota: start NOT healthy within the grace period -- restart, the kernel counts\0"

static mut C_EINS: [u8; 9] = "settings\0"

static mut C_SET: [u8; 4] = "set\0"

static mut W_TRUE: [u8; 5] = "true\0"

static mut K_START: [u8; 7] = "start=\0"

static mut W_JA: [u8; 3] = "ja\0"

static mut A_ERP: [u8; 6] = "trial\0"

static mut A_OK: [u8; 3] = "ok\0"

static mut S_DIENST: [u8; 24] = "ota: service, interval \0"

static mut S_DAUS: [u8; 29] = "ota: automatic search is OFF\0"

fn cmd_bestaetigen() -> u64 {
    otajoin.join_all()
    let rc: u64 = otacmd.opk_ruf((&A_ERP[0 as usize]) as u64, (&A_OK[0 as usize]) as u64,
        0, 0, 3)
    if rc == 0 {
        otacmd.stand_write((&otabase.W_PH_IDLE[0 as usize]) as u64)
    }
    su_finish()
    return rc
}

const SYS_CHMOD: u64 = 90

fn cmd_boot(extra: u64) -> u64 {
    otajoin.join_all()
    otacmd.conf_load()
    if otacmd.in_erprobung() {
        let gesund: u64 = otacmd.conf_num((&otabase.K_HEALTHY[0 as usize]) as u64, 60)
        var timeout: u64 = otacmd.conf_num((&otabase.K_TIMEOUT[0 as usize]) as u64, 120)
        if timeout <= gesund {
            timeout = gesund + 60
        }
        var s: u64 = 0
        var gut: bool = false
        while s < timeout && !gut {
            clockapi.sleep_ms(1000)
            s = s + 1
            if s >= gesund && otacmd.in_erprobung()
                && (otacmd.name_laeuft((&N_DESK[0 as usize]) as u64)
                    || otacmd.name_laeuft((&N_GLOG[0 as usize]) as u64)
                    || (extra != 0 && otacmd.name_laeuft(extra))) {
                gut = true
            }
            if !otacmd.in_erprobung() {
                return cmd_dienst(0)
            }
        }
        if !gut {
            ulib.say((&S_BNEU[0 as usize]) as u64)
            ulib.nl()
            ulib.sys(ulib.SYS_SYNC, 0, 0, 0)
            ulib.sys(otabase.SYS_REBOOT, otabase.RB_RESTART, 0, 0)
            return 1
        }
        otacmd.sagn((&S_BGUT[0 as usize]) as u64, s)
        cmd_bestaetigen()
    }
    return cmd_dienst(0)
}

fn cmd_dienst(rounds: u64) -> u64 {
    otacmd.conf_load()
    var auto: [u8; 16] = [0 as u8; 16]
    let hat: bool = otacmd.conf_value((&otabase.K_AUTO[0 as usize]) as u64,
        (&auto[0 as usize]) as u64, 16)
    let spacing: u64 = otacmd.conf_num((&otabase.K_INTERVAL[0 as usize]) as u64, 3600)
    // DEFAULT ON (decision of the owner, 02.10.2026): a missing `auto=`
    // key means automatic updates are ON; only an explicit value other
    // than ja/true (nein, false, ...) switches the service off.
    if (hat && !(ulib.streq((&auto[0 as usize]) as u64,
        (&W_JA[0 as usize]) as u64) || ulib.streq((&auto[0 as usize]) as u64,
        (&W_TRUE[0 as usize]) as u64))) || spacing == 0 {
        ulib.say((&S_DAUS[0 as usize]) as u64)
        ulib.nl()
        return 0
    }
    otacmd.sagn((&S_DIENST[0 as usize]) as u64, spacing)
    // system check: at the first round (right after boot + START seconds) and then every
    // `sysinterval=` seconds (default 21600 = 6 h). The test entry `ota service <n>` does it
    // only with the extra word `system` (`ota service 1 system`), so the package tests stay as they were.
    var sys_gap: u64 = otacmd.conf_num((&otabase.K_SYSINTERVAL[0 as usize]) as u64, 21600)
    var sys_on: bool = sys_gap != 0
    if rounds != 0 {
        sys_on = sys_on && dienst_sys
    }
    var sys_left: u64 = 0
    var keep_going: bool = true
    var gelaufen: u64 = 0
    var fehlversuche: u64 = 0
    // w-disklag: the first search comes START seconds after the service
    // starts (default 180, `start=` in /etc/ota.conf). Right after boot the
    // disk is busy with login, desktop and service starts; on a rotating
    // disk the search (TLS, fetch spawn = binary load from disk, sntp)
    // competed with them and made the login unusable. Only the real
    // service (rounds == 0) waits; the test entry `ota service <n>` does not.
    if rounds == 0 {
        let verz: u64 = otacmd.conf_num((&K_START[0 as usize]) as u64, 180)
        var v: u64 = 0
        while v < verz {
            clockapi.sleep_ms(1000)
            v = v + 1
        }
    }
    while keep_going {
        let vorher: bool = otacmd.clock_unsynced()
        if vorher {
            otacmd.sntp_run()
        }
        var fr: u64 = otacmd.cmd_find()
        if fr != 0 && otabase.find_missing != 0 && !vorher && otacmd.clock_unsynced() && otacmd.sntp_run() {
            fr = otacmd.cmd_find()
        }
        if fr == 0 && !otacmd.in_erprobung() {
            otacmd.cmd_einspielen()
        }
        if sys_on && sys_left == 0 {
            // the feed answered (newer = 0, current = 1): next look in `sysabstand`;
            // an error (offline, clock) is retried with the next round of the service
            let sr: u64 = su_auto_check()
            if sr <= 1 {
                sys_left = sys_gap
            }
        }
        gelaufen = gelaufen + 1
        if rounds != 0 && gelaufen >= rounds {
            return 0
        }
        // O-002: after a failed fetch (network/clock not ready right after
        // boot) look again in 30 s, at most 20 times (10 minutes), then fall
        // back to the normal `abstand`.
        var wait: u64 = spacing
        if otabase.find_missing != 0 && fehlversuche < 20 {
            // w-disklag: backoff 30, 60, 120, 240 s ... (was a fixed 30 s,
            // i.e. a TLS search + fetch spawn every 30 s while offline),
            // never longer than `abstand`.
            wait = 30
            var k: u64 = 0
            while k < fehlversuche && k < 4 {
                wait = wait * 2
                k = k + 1
            }
            if spacing < wait {
                wait = spacing
            }
            fehlversuche = fehlversuche + 1
        } else {
            fehlversuche = 0
        }
        var s: u64 = 0
        while s < wait {
            clockapi.sleep_ms(1000)
            s = s + 1
        }
        if sys_left > wait {
            sys_left = sys_left - wait
        } else {
            sys_left = 0
        }
    }
    return 0
}

