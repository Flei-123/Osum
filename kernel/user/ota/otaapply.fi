static mut S_USE1: [u8; 26] = "ota search | show | apply\0"

static mut S_USE2: [u8; 73] = "ota confirm | rollback | watchdog | service | system search|apply|status\0"

static mut C_SUCH: [u8; 7] = "search\0"

static mut C_SHOW: [u8; 5] = "show\0"

static mut C_HOL: [u8; 6] = "fetch\0"

static mut C_EIN: [u8; 6] = "apply\0"

