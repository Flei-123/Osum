profile app

import ulib
import wlib
import fuiscene
import fuiapp

export { u_start }

const K_ENTRY: u64 = 1
static mut k_title: [u8; 8] = "osktest\0"
static mut s_last: [u8; 120] = [0 as u8; 120]
static mut p_osk: [u8; 9] = "/bin/osk\0"
static mut a_osk: [u8; 4] = "osk\0"

fn rd8(p: u64) -> u64 {
    return __mmio_read8(p as *mut u8) as u64
}

fn wr8(p: u64, v: u64) {
    __mmio_write8(p as *mut u8, v as u8)
}

fn say(p: u64) {
    let _s: u64 = ulib.say(p)
}

fn start_osk(args: u64) {
    var av: [u64; 3] = [0 as u64; 3]
    av[0 as usize] = (&a_osk[0 as usize]) as u64
    var n: u64 = 1
    if ulib.arg_count(args) >= 2 {
        av[1 as usize] = ulib.arg_at(args, 1)
        n = 2
    }
    let _p: u64 = ulib.spawn_app((&p_osk[0 as usize]) as u64, (&av[0 as usize]) as u64, n)
}

fn build() {
    let col: usize = fuiscene.root()
    let _e: usize = fuiscene.entry(col, K_ENTRY, 360, 0)
}

fn say_rect() {
    let g: u64 = fuiscene.key_geom(K_ENTRY)
    if g == 0 {
        return
    }
    var s_a: [u8; 25] = "osktest: rect name=entry\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_ax: [u8; 5] = " ax=\0"
    var s_ay: [u8; 5] = " ay=\0"
    let x: u64 = g >> 48
    let y: u64 = (g >> 32) & 65535
    let w0: u64 = fuiapp.win()
    say((&s_a[0 as usize]) as u64)
    say((&s_x[0 as usize]) as u64)
    ulib.sayn(x)
    say((&s_y[0 as usize]) as u64)
    ulib.sayn(y)
    say((&s_w[0 as usize]) as u64)
    ulib.sayn((g >> 16) & 65535)
    say((&s_h[0 as usize]) as u64)
    ulib.sayn(g & 65535)
    say((&s_ax[0 as usize]) as u64)
    ulib.sayn(wlib.win_cx(w0) + x)
    say((&s_ay[0 as usize]) as u64)
    ulib.sayn(wlib.win_cy(w0) + y)
    ulib.nl()
}

fn u_start(args: u64) -> u64 {
    var s_go: [u8; 15] = "osktest: ready\0"
    var s_t: [u8; 15] = "osktest: text=\0"
    if !fuiscene.open(200, 120, 420, 120, (&k_title[0 as usize]) as u64, build) {
        return 1
    }
    var first: bool = true
    while fuiscene.alive() {
        let _k: u64 = fuiscene.pump()
        if first {
            first = false
            say_rect()
            say((&s_go[0 as usize]) as u64)
            ulib.nl()
            start_osk(args)
        }
        let q: u64 = fuiscene.entry_text(K_ENTRY)
        if !ulib.streq(q, (&s_last[0 as usize]) as u64) {
            wr8((&s_last[0 as usize]) as u64, 0)
            var i: u64 = 0
            while rd8(q + i) != 0 && i < 118 {
                wr8((&s_last[0 as usize]) as u64 + i, rd8(q + i))
                i = i + 1
                wr8((&s_last[0 as usize]) as u64 + i, 0)
            }
            say((&s_t[0 as usize]) as u64)
            say(q)
            ulib.nl()
        }
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
