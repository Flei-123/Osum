// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/notify/notifc.fi -- THE NOTIFICATION LIST of the combined clock flyout (calpop.fi).
//
// The kernel bus keeps the last 16 notifications (`svcnoti.noti_*`). This module turns them into rows
// (newest first, neighbours that read the same are one row with a count) for the flyout, which draws them
// with notecard.draw_card and routes the clicks back here. "Clear all" marks every entry read (the bell goes
// away) and remembers `noti_total()` as a base line; only entries posted later are listed. Dismissing one row
// hides its range of entries (notecard.dismiss_range).
//
//   load(cap_pt)       read the rows that fit into cap_pt design points; returns the row count
//   rows(), list_pt()  row count, summed card height + gaps
//   clear_all()        mark everything read
//   click(i, lx, ly)   a press inside the card of row i (local pixels): CLICK_* result
//   changed()          a notification arrived since the last load()
//   report()           serial lines of the rows
//
// Serial lines (read by tools/features/run.sh, tools/notecard):
//   notifc: row <i> prio=<p> text=<text>   notifc: clear n=<entries marked read>
//   notifc: act row=<i> path=<p>           notifc: eject row=<i> path=<p> rc=<n>      notifc: toast act path=<p>

profile app

import fuiapp.svcnoti
import ulib
import libc.text
import lineout
import notify.notetext
import msg
import libc.regio
import notify.notecard

export { report_open, report_card, report_shut, load, rows, list_h_pt, changed, clear_all, report, click, act_newest, CLICK_NONE, CLICK_CHANGED, CLICK_CLOSE, NC_MAXR }

const NC_MAXR: u64 = 8
const CLICK_NONE: u64 = 0
const CLICK_CHANGED: u64 = 1
const CLICK_CLOSE: u64 = 2
const ROW_BYTES: u64 = 96
const ARG_BYTES: u64 = 24
const APP_PATH_BYTES: u64 = 64
const CRASH_NAME_OFFSET: u64 = 6
const ACT_NONE: u64 = 0
const ACT_FOLDER: u64 = 1
const SEC_NONE: u64 = 0
const SEC_EJECT: u64 = 1
const SEC_REPORT: u64 = 2
const RC_BUSY: u64 = 16
const GAPP: u64 = 4

static mut n_rows: u64 = 0
static mut base_: u64 = 0 // noti_total() at the last "Clear all"
static mut seen_total: u64 = 0 // noti_total() when the list was last built
static mut row_txt: [u8; 768] = [0 as u8; 768] // NC_MAXR x ROW_BYTES
static mut row_pri: [u64; 8] = [0 as u64; 8]
static mut row_cnt: [u64; 8] = [0 as u64; 8]
static mut row_act: [u64; 8] = [0 as u64; 8]
static mut row_sec: [u64; 8] = [0 as u64; 8]
static mut row_lo: [u64; 8] = [0 as u64; 8]
static mut row_hi: [u64; 8] = [0 as u64; 8]
static mut list_pt: u64 = 0
static mut list_cap: u64 = 0
static mut row_arg: [u8; 192] = [0 as u8; 192]
static mut row_app: [u8; 192] = [0 as u8; 192]
static mut toast_arg: [u8; 24] = [0 as u8; 24]
static mut raw_buf: [u8; 96] = [0 as u8; 96]
static mut hum_buf: [u8; 96] = [0 as u8; 96]
static mut p_explorer: [u8; 14] = "/bin/explorer\0"
static mut p_crashdir: [u8; 11] = "/var/crash\0"
static mut s_act: [u8; 17] = "notifc: act row=\0"
static mut s_actp: [u8; 7] = " path=\0"
static mut s_grp: [u8; 4] = " (x\0"
static mut s_ej: [u8; 19] = "notifc: eject row=\0"
static mut s_rc: [u8; 5] = " rc=\0"
static mut s_toast: [u8; 19] = "notifc: toast act \0"
static mut k_sec_eject: [u8; 16] = "notif.act.eject\0"
static mut k_sec_report: [u8; 17] = "notif.act.report\0"
static mut k_sec_restart: [u8; 18] = "notif.act.restart\0"
static mut p_apps_dir: [u8; 7] = "/apps/\0"
static mut p_bundle_start: [u8; 12] = ".osp/start\0\0"
static mut s_restart: [u8; 22] = "notifc: restart row=\0\0"
static mut k_eject_busy: [u8; 16] = "note.eject.busy\0"
static mut k_eject_fail: [u8; 16] = "note.eject.fail\0"

static mut s_row: [u8; 13] = "notifc: row \0"
static mut s_pr: [u8; 7] = " prio=\0"
static mut s_tx: [u8; 7] = " text=\0"
static mut s_open: [u8; 16] = "notifc: open n=\0"
static mut s_xy: [u8; 4] = " x=\0"
static mut s_yy: [u8; 4] = " y=\0"
static mut s_ww: [u8; 4] = " w=\0"
static mut s_hh: [u8; 4] = " h=\0"
static mut s_card: [u8; 14] = "notifc: card \0"
static mut s_btn: [u8; 13] = "notifc: btn \0"
static mut s_shut: [u8; 14] = "notifc: shut \0"
static mut s_clr: [u8; 17] = "notifc: clear n=\0"

fn say(p: u64) {
    let _s: u64 = lineout.add_text(p)
}

fn sec_label(kind: u64) -> u64 {
    if kind == SEC_EJECT {
        return msg.get((&k_sec_eject[0 as usize]) as u64)
    }
    return msg.get((&k_sec_report[0 as usize]) as u64)
}

// How many entries are listed: the ring holds at most 16, and only those posted since
// the last "Clear all" count.
fn visible() -> u64 {
    var n: u64 = svcnoti.noti_count()
    let tot: u64 = svcnoti.noti_total()
    var since: u64 = 0
    if tot > base_ {
        since = tot - base_
    }
    if since < n {
        n = since
    }
    return n
}

fn is_media(raw: u64, n: u64) -> bool {
    return n > 5 && regio.read8_at(raw, 0) == 117 && regio.read8_at(raw, 1) == 115 && regio.read8_at(raw, 2) == 98 && regio.read8_at(raw, 4) == 32
}

fn is_crash(raw: u64, n: u64) -> bool {
    return n > 6 && regio.read8_at(raw, 0) == 99 && regio.read8_at(raw, 1) == 114 && regio.read8_at(raw, 5) == 32
}

fn classify(raw: u64, n: u64, dst: u64) -> u64 {
    if is_media(raw, n) {
        var k: u64 = 0
        var more: bool = true
        while more && k + 5 < n && k + 1 < ARG_BYTES {
            let c: u64 = regio.read8_at(raw, 5 + k)
            if c == 32 || c == 0 {
                more = false
            } else {
                __mmio_write8((dst + k) as *mut u8, c as u8)
                k = k + 1
            }
        }
        __mmio_write8((dst + k) as *mut u8, 0 as u8)
        if k > 0 && regio.read8_at(raw, 3) != 45 {
            return ACT_FOLDER
        }
        return ACT_NONE
    }
    if is_crash(raw, n) {
        var k: u64 = 0
        while k < 10 {
            __mmio_write8((dst + k) as *mut u8, regio.read8_at((&p_crashdir[0 as usize]) as u64, k) as u8)
            k = k + 1
        }
        __mmio_write8((dst + 10) as *mut u8, 0 as u8)
        return ACT_FOLDER
    }
    return ACT_NONE
}

fn secondary(raw: u64, n: u64, act: u64) -> u64 {
    if act != ACT_FOLDER {
        return SEC_NONE
    }
    if is_media(raw, n) && regio.read8_at(raw, 3) == 43 {
        return SEC_EJECT
    }
    if is_crash(raw, n) {
        return SEC_REPORT
    }
    return SEC_NONE
}

fn same_text(a: u64, b: u64) -> bool {
    var k: u64 = 0
    while k < ROW_BYTES - 2 {
        let ca: u64 = __mmio_read8((a + k) as *mut u8) as u64
        if ca != __mmio_read8((b + k) as *mut u8) as u64 {
            return false
        }
        if ca == 0 {
            return true
        }
        k = k + 1
    }
    return true
}

fn append_count(p: u64, cnt: u64) {
    var n: u64 = 0
    while n < ROW_BYTES - 12 && __mmio_read8((p + n) as *mut u8) as u64 != 0 {
        n = n + 1
    }
    var k: u64 = 0
    while k < 3 {
        __mmio_write8((p + n + k) as *mut u8, __mmio_read8(((&s_grp[0 as usize]) as u64 + k) as *mut u8))
        k = k + 1
    }
    n = n + 3
    var div: u64 = 100
    while div > 1 && cnt / div == 0 {
        div = div / 10
    }
    while div > 0 {
        __mmio_write8((p + n) as *mut u8, (48 + (cnt / div) % 10) as u8)
        n = n + 1
        div = div / 10
    }
    __mmio_write8((p + n) as *mut u8, 41 as u8)
    __mmio_write8((p + n + 1) as *mut u8, 0 as u8)
}

fn humanized_copy(raw: u64, n: u64) -> u64 {
    let hum: u64 = (&hum_buf[0 as usize]) as u64
    var k: u64 = 0
    while k <= n {
        __mmio_write8((hum + k) as *mut u8, __mmio_read8((raw + k) as *mut u8))
        k = k + 1
    }
    let _hn: u64 = notetext.humanize(hum, n, ROW_BYTES - 4)
    return hum
}

fn store_text(slot: u64, hum: u64, prio: u64) {
    let p: u64 = (&row_txt[0 as usize]) as u64 + slot * ROW_BYTES
    var k: u64 = 0
    while k < ROW_BYTES - 2 {
        let c: u64 = __mmio_read8((hum + k) as *mut u8) as u64
        __mmio_write8((p + 2 + k) as *mut u8, c as u8)
        if c == 0 {
            k = ROW_BYTES
        } else {
            k = k + 1
        }
    }
    if prio >= 2 {
        __mmio_write8(p as *mut u8, 33 as u8)
    } else {
        __mmio_write8(p as *mut u8, 45 as u8)
    }
    __mmio_write8((p + 1) as *mut u8, 32 as u8)
}

fn crash_app_name(raw: u64, n: u64, dst: u64) {
    var k: u64 = 0
    while k < ARG_BYTES - 1 && CRASH_NAME_OFFSET + k < n {
        let c: u64 = regio.read8_at(raw, CRASH_NAME_OFFSET + k)
        if c == 32 || c == 0 {
            break
        }
        __mmio_write8((dst + k) as *mut u8, c as u8)
        k = k + 1
    }
    __mmio_write8((dst + k) as *mut u8, 0 as u8)
}

fn app_start_path(name: u64, out: u64) {
    let _a: u64 = ulib.strcpy(out, (&p_apps_dir[0 as usize]) as u64)
    let _b: u64 = ulib.strcat(out, name)
    let _c: u64 = ulib.strcat(out, (&p_bundle_start[0 as usize]) as u64)
}

fn app_restartable(name: u64) -> bool {
    var path: [u8; 64] = [0 as u8; 64]
    if regio.read8_at(name, 0) == 0 {
        return false
    }
    app_start_path(name, (&path[0 as usize]) as u64)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&path[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return false
    }
    let _x: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return true
}

fn store_row(slot: u64, hum: u64, raw: u64, n: u64, prio: u64, seq: u64) -> bool {
    notecard.from_bus(slot + 1, raw, n, prio, seq)
    let act: u64 = classify(raw, n, (&row_arg[0 as usize]) as u64 + slot * ARG_BYTES)
    let sec: u64 = secondary(raw, n, act)
    let app: u64 = (&row_app[0 as usize]) as u64 + slot * ARG_BYTES
    __mmio_write8(app as *mut u8, 0 as u8)
    if sec == SEC_REPORT {
        crash_app_name(raw, n, app)
    }
    if sec == SEC_REPORT && app_restartable(app) {
        notecard.set_buttons(slot + 1, msg.get((&k_sec_restart[0 as usize]) as u64), sec_label(sec))
    } else if sec != SEC_NONE {
        __mmio_write8(app as *mut u8, 0 as u8)
        notecard.set_buttons(slot + 1, sec_label(sec), 0)
    }
    let need: u64 = notecard.card_h_pt(slot + 1) + GAPP
    if list_pt + need > list_cap {
        return false
    }
    list_pt = list_pt + need
    store_text(slot, hum, prio)
    row_pri[slot as usize] = prio
    row_cnt[slot as usize] = 1
    row_lo[slot as usize] = seq
    row_hi[slot as usize] = seq
    row_act[slot as usize] = act
    row_sec[slot as usize] = sec
    return true
}

fn add_entry(raw: u64, n: u64, prio: u64, seq: u64) {
    let hum: u64 = humanized_copy(raw, n)
    if n_rows > 0 && same_text(hum, (&row_txt[0 as usize]) as u64 + (n_rows - 1) * ROW_BYTES + 2)
        && row_pri[(n_rows - 1) as usize] == prio {
        row_cnt[(n_rows - 1) as usize] = row_cnt[(n_rows - 1) as usize] + 1
        row_lo[(n_rows - 1) as usize] = seq
        return
    }
    if n_rows < NC_MAXR && store_row(n_rows, hum, raw, n, prio, seq) {
        n_rows = n_rows + 1
    }
}

fn append_counts() {
    var r: u64 = 0
    while r < n_rows {
        if row_cnt[r as usize] > 1 {
            append_count((&row_txt[0 as usize]) as u64 + r * ROW_BYTES + 2, row_cnt[r as usize])
            append_count(notecard.text_ptr(r + 1), row_cnt[r as usize])
        }
        r = r + 1
    }
}

// Read the newest entries WITHOUT marking them read (`noti_peek`): looking at the list
// is not the same as having dealt with it, the bell keeps its count until "Clear all".
// Neighbouring entries that read the same are one row with a count.
fn read_rows() {
    let raw_n: u64 = visible()
    seen_total = svcnoti.noti_total()
    n_rows = 0
    list_pt = 0
    var i: u64 = 0
    while i < raw_n {
        let raw: u64 = (&raw_buf[0 as usize]) as u64
        var n: u64 = svcnoti.noti_peek(i, raw, ROW_BYTES - 4)
        if n > ROW_BYTES - 4 {
            n = ROW_BYTES - 4
        }
        __mmio_write8((raw + n) as *mut u8, 0 as u8)
        let seq: u64 = seen_total - 1 - i
        if !notecard.is_dismissed(seq) {
            add_entry(raw, n, svcnoti.noti_prio(i), seq)
        }
        i = i + 1
    }
    append_counts()
}

fn spawn_explorer(path: u64) {
    var av: [u64; 2] = [0 as u64; 2]
    av[0 as usize] = (&p_explorer[0 as usize]) as u64
    av[1 as usize] = path
    let _pid: u64 = ulib.spawn_app((&p_explorer[0 as usize]) as u64, (&av[0 as usize]) as u64, 2)
}

fn act_row(i: u64) {
    if i >= n_rows || row_act[i as usize] != ACT_FOLDER {
        return
    }
    let path: u64 = (&row_arg[0 as usize]) as u64 + i * ARG_BYTES
    say((&s_act[0 as usize]) as u64)
    lineout.add_num(i)
    say((&s_actp[0 as usize]) as u64)
    say(path)
    lineout.end_line()
    spawn_explorer(path)
}

fn act_newest() -> bool {
    let raw: u64 = (&raw_buf[0 as usize]) as u64
    var n: u64 = svcnoti.noti_peek(0, raw, ROW_BYTES - 4)
    if n > ROW_BYTES - 4 {
        n = ROW_BYTES - 4
    }
    __mmio_write8((raw + n) as *mut u8, 0 as u8)
    let path: u64 = (&toast_arg[0 as usize]) as u64
    if n == 0 || classify(raw, n, path) != ACT_FOLDER {
        return false
    }
    say((&s_toast[0 as usize]) as u64)
    say((&s_actp[0 as usize]) as u64 + 1)
    say(path)
    lineout.end_line()
    spawn_explorer(path)
    return true
}

fn carrier_of(path: u64) -> u64 {
    var i: u64 = 0
    while i < ulib.WX_MAX {
        var pf: [u8; 24] = [0 as u8; 24]
        var n: u64 = 0
        while n < 23 {
            let c: u64 = ulib.sys(ulib.SYS_WECHSEL, ulib.WX_PATHCH, i, n)
            pf[n as usize] = c as u8
            if c == 0 {
                n = 23
            } else {
                n = n + 1
            }
        }
        pf[23] = 0 as u8
        if ulib.streq((&pf[0 as usize]) as u64, path) {
            return i
        }
        i = i + 1
    }
    return ulib.WX_MAX
}

fn restart_row(i: u64) {
    if i >= n_rows || row_sec[i as usize] != SEC_REPORT {
        return
    }
    var path: [u8; 64] = [0 as u8; 64]
    var av: [u64; 2] = [0 as u64; 2]
    app_start_path((&row_app[0 as usize]) as u64 + i * ARG_BYTES, (&path[0 as usize]) as u64)
    av[0 as usize] = (&path[0 as usize]) as u64
    let pid: u64 = ulib.spawn_app((&path[0 as usize]) as u64, (&av[0 as usize]) as u64, 1)
    say((&s_restart[0 as usize]) as u64)
    lineout.add_num(i)
    say((&s_actp[0 as usize]) as u64)
    say((&path[0 as usize]) as u64)
    say((&s_rc[0 as usize]) as u64)
    lineout.add_num(pid)
    lineout.end_line()
}

fn eject_row(i: u64) {
    if i >= n_rows || row_sec[i as usize] != SEC_EJECT {
        return
    }
    let path: u64 = (&row_arg[0 as usize]) as u64 + i * ARG_BYTES
    let tr: u64 = carrier_of(path)
    var rc: u64 = 0xFFFF
    if tr < ulib.WX_MAX {
        rc = ulib.sys(ulib.SYS_WECHSEL, ulib.WX_EJECT, tr, 0)
    }
    say((&s_ej[0 as usize]) as u64)
    lineout.add_num(i)
    say((&s_actp[0 as usize]) as u64)
    say(path)
    say((&s_rc[0 as usize]) as u64)
    lineout.add_num(rc)
    lineout.end_line()
    if rc == 0 {
        return
    }
    var key: u64 = (&k_eject_fail[0 as usize]) as u64
    if rc == RC_BUSY {
        key = (&k_eject_busy[0 as usize]) as u64
    }
    let t: u64 = msg.get(key)
    let _r: u64 = ulib.noti_post(2, t, text.length(t))
}

// The work area of the bar: the card goes in the corner of it, on the side of the bar.
// How many rows the card shows right now (0 while it is shut).
// rebuild the tree from the rows and paint it (open, clear, a new notification)
// Mark everything read (the bell goes away) and start the list afresh.

fn load(cap_pt: u64) -> u64 {
    list_cap = cap_pt
    read_rows()
    return n_rows
}

fn rows() -> u64 {
    return n_rows
}

fn list_h_pt() -> u64 {
    return list_pt
}

fn changed() -> bool {
    return svcnoti.noti_total() != seen_total
}

fn clear_all() {
    var buf: [u8; 8] = [0 as u8; 8]
    let cnt: u64 = svcnoti.noti_count()
    var i: u64 = 0
    while i < cnt {
        let _n: u64 = svcnoti.noti_take(i, (&buf[0 as usize]) as u64, 1)
        i = i + 1
    }
    base_ = svcnoti.noti_total()
    say((&s_clr[0 as usize]) as u64)
    lineout.add_num(cnt)
    lineout.end_line()
}

fn report() {
    var i: u64 = 0
    while i < n_rows {
        say((&s_row[0 as usize]) as u64)
        lineout.add_num(i)
        say((&s_pr[0 as usize]) as u64)
        lineout.add_num(row_pri[i as usize])
        say((&s_tx[0 as usize]) as u64)
        say((&row_txt[0 as usize]) as u64 + i * ROW_BYTES + 2)
        lineout.end_line()
        i = i + 1
    }
}

fn click(i: u64, lx: u64, ly: u64) -> u64 {
    if i >= n_rows {
        return CLICK_NONE
    }
    if notecard.hit_dismiss(lx, ly) {
        notecard.dismiss_range(row_lo[i as usize], row_hi[i as usize])
        return CLICK_CHANGED
    }
    let hit: u64 = notecard.hit_button(i + 1, lx, ly)
    if hit == 1 && row_sec[i as usize] == SEC_REPORT && regio.read8_at((&row_app[0 as usize]) as u64, i * ARG_BYTES) != 0 {
        restart_row(i)
        return CLICK_CLOSE
    }
    if hit != 0 {
        if row_sec[i as usize] == SEC_EJECT {
            eject_row(i)
            return CLICK_CHANGED
        }
        act_row(i)
        return CLICK_CLOSE
    }
    if row_act[i as usize] != ACT_NONE {
        act_row(i)
        return CLICK_CLOSE
    }
    return CLICK_NONE
}

fn say_rect(label: u64, i: u64, x: u64, y: u64, w: u64, h: u64) {
    say(label)
    lineout.add_num(i)
    say((&s_xy[0 as usize]) as u64)
    lineout.add_num(x)
    say((&s_yy[0 as usize]) as u64)
    lineout.add_num(y)
    say((&s_ww[0 as usize]) as u64)
    lineout.add_num(w)
    say((&s_hh[0 as usize]) as u64)
    lineout.add_num(h)
    lineout.end_line()
}

fn report_open(x: u64, y: u64, w: u64, h: u64) {
    say((&s_open[0 as usize]) as u64)
    lineout.add_num(n_rows)
    say((&s_xy[0 as usize]) as u64)
    lineout.add_num(x)
    say((&s_yy[0 as usize]) as u64)
    lineout.add_num(y)
    say((&s_ww[0 as usize]) as u64)
    lineout.add_num(w)
    say((&s_hh[0 as usize]) as u64)
    lineout.add_num(h)
    lineout.end_line()
}

fn report_card(i: u64, cx: u64, cy: u64) {
    if i >= n_rows {
        return
    }
    say_rect((&s_card[0 as usize]) as u64, i, cx, cy, notecard.width_px(), notecard.card_h(i + 1))
    if row_sec[i as usize] != SEC_NONE {
        say_rect((&s_btn[0 as usize]) as u64, i, cx + notecard.button_rect_x(0),
            cy + notecard.button_rect_y(i + 1), notecard.button_w(), notecard.button_h())
    }
}

fn report_shut(why: u64) {
    say((&s_shut[0 as usize]) as u64)
    say(why)
    lineout.end_line()
}
