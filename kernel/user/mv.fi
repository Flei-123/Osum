// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/mv.fi -- round K6: a name that moves.
//
// RUNDE OFS3: `mv` BENENNT UM. Hier stand seit Runde K6: "this kernel
// has no `rename` ... so `mv` is a copy and an unlink -- which means it
// costs the length of the file and needs the room for it twice for a
// moment". Runde K14 hat `rename` in den Kernel gebaut (Aufruf 82,
// `fs.rename_path`), aber dieses Programm nie umgestellt; es kopierte
// weiter. Diese Runde stellt es um.
//
// DER UNTERSCHIED IST MESSBAR UND WIRD GEMESSEN: eine Datei von zwei
// Megaoktett umzubenennen brauchte vorher zwei Megaoktett freien Platz
// und schrieb sie ein zweites Mal auf die Platte. Jetzt aendert sich ein
// Verzeichniseintrag, die Inode bleibt, wo sie ist, und KEIN Datenoktett
// wird angefasst -- `tools/ofs3/run.sh` haelt die Inodenummer vorher und
// nachher gegeneinander.
//
// DAS KOPIEREN BLEIBT ALS NOTWEG STEHEN, und es wird gebraucht: `rename`
// arbeitet nur INNERHALB eines Dateisystems (POSIX sagt -EXDEV), und
// `mv /a /mnt/b` ueber eine Einhaengegrenze hinweg ist genau der Fall.
// Wer es umgekehrt macht -- kopieren und nur bei Bedarf umbenennen --,
// hat einen `mv`, der bei jeder grossen Datei langsam ist.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 32] = "mv: needs a source and a target\0"
    var s_src: [u8; 17] = "mv: cannot open \0"
    var s_dst: [u8; 18] = "mv: cannot write \0"
    var s_dir: [u8; 20] = "mv: is a directory \0"
    var full: [u8; 128] = [0 as u8; 128]

    let argc: u64 = ulib.arg_count(args)
    if argc < 3 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    let src: u64 = ulib.arg_at(args, 1)
    var dst: u64 = ulib.arg_at(args, 2)
    if ulib.is_dir(src) {
        ulib.esay_line((&s_dir[0 as usize]) as u64, src)
        return 1
    }
    if ulib.is_dir(dst) {
        var sl: [u8; 2] = "/\0"
        ulib.strcpy((&full[0 as usize]) as u64, dst)
        ulib.strcat((&full[0 as usize]) as u64, (&sl[0 as usize]) as u64)
        ulib.strcat((&full[0 as usize]) as u64, ulib.base_name(src))
        dst = (&full[0 as usize]) as u64
    }
    if ulib.streq(src, dst) {
        return 0
    }
    // RUNDE OFS3: ZUERST UMBENENNEN. Klappt es, ist das ganze Programm
    // an dieser Stelle fertig -- ohne ein einziges gelesenes Oktett.
    // Der Kernel gibt EEXIST, wenn das Ziel schon da ist (er
    // ueberschreibt nicht still), also wird es vorher weggenommen --
    // dasselbe, was der Kopierweg unten mit `unlink` auch tut.
    ulib.sys(ulib.SYS_UNLINK, dst, 0, 0)
    if !ulib.bad(ulib.sys(ulib.SYS_RENAME, src, dst, 0)) {
        return 0
    }
    // Ging nicht -- ueber eine Einhaengegrenze hinweg zum Beispiel.
    // Dann der Notweg: kopieren und loeschen.
    let in_fd: u64 = ulib.sys(ulib.SYS_OPEN, src, 0, 0)
    if ulib.bad(in_fd) {
        ulib.esay_line((&s_src[0 as usize]) as u64, src)
        return 1
    }
    ulib.sys(ulib.SYS_UNLINK, dst, 0, 0)
    let out_fd: u64 = ulib.sys(ulib.SYS_OPEN, dst, ulib.O_MAKE, 0)
    if ulib.bad(out_fd) {
        ulib.esay_line((&s_dst[0 as usize]) as u64, dst)
        ulib.sys(ulib.SYS_CLOSE, in_fd, 0, 0)
        return 1
    }
    var buf: [u8; 512] = [0 as u8; 512]
    var code: u64 = 0
    var going: bool = true
    while going {
        let n: u64 = ulib.sys(ulib.SYS_READ, in_fd,
            (&buf[0 as usize]) as u64, 512)
        if n == 0 || ulib.bad(n) {
            going = false
        } else {
            let w: u64 = ulib.sys(ulib.SYS_WRITE, out_fd,
                (&buf[0 as usize]) as u64, n)
            if ulib.bad(w) || w != n {
                ulib.esay_line((&s_dst[0 as usize]) as u64, dst)
                code = 1
                going = false
            }
        }
    }
    ulib.sys(ulib.SYS_CLOSE, in_fd, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, out_fd, 0, 0)
    if code == 0 {
        ulib.sys(ulib.SYS_UNLINK, src, 0, 0)
    }
    return code
}
