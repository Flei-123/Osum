profile kernel

import ulib
import tools
import dbgio

export { u_start }

static mut BUF: [u8; 1024] = [0 as u8; 1024]

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 46] = "usage: prphread <bb:dd.f> <addr-hex> [count]\0\0"
    var s_name: [u8; 9] = "prphread\0"
    var s_sep: [u8; 3] = ": \0"
    let a0: u64 = dbgio.positional(args, 0)
    let a1: u64 = dbgio.positional(args, 1)
    if a0 == 0 || a1 == 0 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 2
    }
    let bdf: u64 = dbgio.parse_bdf(a0)
    let addr: u64 = dbgio.parse_hex(a1)
    if bdf == dbgio.BAD || addr == dbgio.BAD {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 2
    }
    var count: u64 = 1
    let a2: u64 = dbgio.positional(args, 2)
    if a2 != 0 {
        count = ulib.to_num(a2)
    }
    let r: u64 = dbgio.call(dbgio.OP_PRPHREAD, bdf, addr, (&BUF[0 as usize]) as u64, count)
    if ulib.bad(r) {
        dbgio.put_error((&s_name[0 as usize]) as u64, r)
        return 1
    }
    var i: u64 = 0
    while i < r {
        dbgio.put_hex(addr + i * 4, 8)
        tools.ob_str((&s_sep[0 as usize]) as u64)
        dbgio.put_hex(dbgio.dword_at((&BUF[0 as usize]) as u64 + i * 4), 8)
        tools.ob_nl()
        i = i + 1
    }
    tools.ob_flush()
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
