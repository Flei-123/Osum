static mut m_feuer: [u8; 19] = "taskmgr: feuer id=\0"
static mut m_art: [u8; 6] = " art=\0"
static mut m_idx: [u8; 6] = " idx=\0"
static mut m_tab: [u8; 20] = "taskmgr: tabelle x=\0"
static mut m_kopfh: [u8; 7] = " kopf=\0"
static mut m_zh: [u8; 5] = " zh=\0"
static mut m_spalte: [u8; 19] = "taskmgr: spalte c=\0"
static mut m_text: [u8; 17] = "taskmgr: text x=\0"
static mut m_base: [u8; 7] = " base=\0"
static mut m_fg: [u8; 5] = " fg=\0"
static mut m_bg: [u8; 5] = " bg=\0"
static mut m_ot: [u8; 3] = " [\0"
static mut m_ct2: [u8; 2] = "]\0"
static mut m_nowm: [u8; 28] = "taskmgr: kein Fensterserver\0"
static mut m_net: [u8; 18] = "taskmgr: netz tx=\0"
static mut m_nrx: [u8; 5] = " rx=\0"
static mut m_non: [u8; 5] = " on=\0"

static mut a_takt: [u8; 5] = "takt\0"
static mut a_runden: [u8; 7] = "runden\0"
static mut a_melde: [u8; 6] = "melde\0"
static mut a_nohit: [u8; 6] = "nohit\0"

// ------------------------------------------------------------ Werkzeug

fn say(p: u64) {
    ulib.say(p)
}

fn sub(a: u64, b: u64) -> u64 {
    if b >= a {
        return 0
    }
    return a - b
}

fn ptr(p: u64) -> u64 {
    return p
}

fn put_str(d: u64, at: u64, s: u64) -> u64 {
    let n: u64 = ulib.length(s)
    var i: u64 = 0
    while i < n {
        __mmio_write8((d + at + i) as *mut u8, __mmio_read8((s + i) as *mut u8))
        i = i + 1
    }
    __mmio_write8((d + at + n) as *mut u8, 0 as u8)
    return at + n
}

fn put_num(d: u64, at: u64, v: u64) -> u64 {
    let n: u64 = ulib.digits(v, d + at)
    __mmio_write8((d + at + n) as *mut u8, 0 as u8)
    return at + n
}

// Promille als Prozent mit einer Nachkommastelle: 375 -> "37,5".
fn put_pm(d: u64, at: u64, v: u64) -> u64 {
    var a: u64 = at
    a = put_num(d, a, v / 10)
    a = put_str(d, a, ptr((&u_comma[0]) as u64))
    a = put_num(d, a, v % 10)
    return a
}

// Kibioktette, und ab tausend Kibioktetten in Mebioktetten mit einer
// Nachkommastelle. Ohne Bruch waere jede Zahl unter einem MiB eine 0.
fn put_size(d: u64, at: u64, kib: u64) -> u64 {
    var a: u64 = at
    if kib < 1024 {
        a = put_num(d, a, kib)
        return put_str(d, a, ptr((&u_kib[0]) as u64))
    }
    let mib: u64 = kib / 1024
    let zehntel: u64 = (kib % 1024) * 10 / 1024
    a = put_num(d, a, mib)
    a = put_str(d, a, ptr((&u_comma[0]) as u64))
    a = put_num(d, a, zehntel)
    return put_str(d, a, ptr((&u_mib[0]) as u64))
}

fn put_time(d: u64, at: u64, ms: u64) -> u64 {
    let sek: u64 = ms / 1000
    var a: u64 = at
    a = put_num(d, a, sek / 3600)
    a = put_str(d, a, ptr((&u_h[0]) as u64))
    a = put_num(d, a, (sek / 60) % 60)
    a = put_str(d, a, ptr((&u_m[0]) as u64))
    a = put_num(d, a, sek % 60)
    return put_str(d, a, ptr((&u_s[0]) as u64))
}

// ================= EINE ZEILE, EIN SCHREIBVORGANG ==================
//
// Auf dieser seriellen Leitung schreiben mehrere Prozesse gleichzeitig:
// der Schreibtisch, die Taskleiste, der Starter und dieses Programm.
// Wer eine Zeile aus einem Dutzend `say`-Aufrufen zusammensetzt, bekommt
// vom Nachbarn mitten hinein geschrieben -- GEMESSEN in dieser Runde:
//
//     taskmgr: spalte c=launcher: geom 1 x=80 w=276
//
// Das ist keine Schoenheitsfrage: ein Testlaeufer, der diese Zeile
// liest, findet die Spalte nicht und meldet einen Fehler, den es nicht
// gibt. `kernel/user/qs.fi` hat dieselbe Lehre in Runde HAENGER
// gezogen. Also: die ganze Zeile in einen Puffer, EIN `put`, und das
// Zeilenende gehoert dazu.
static mut zl: [u8; 512] = [0 as u8; 512]
static mut zn: u64 = 0

fn z_str(t: u64) {
    if zn + ulib.length(t) < 508 {
        zn = put_str((&zl[0]) as u64, zn, t)
    }
}

fn z_num(v: u64) {
    if zn + 24 < 508 {
        zn = put_num((&zl[0]) as u64, zn, v)
    }
}

fn z_kv(t: u64, v: u64) {
    z_str(t)
    z_num(v)
}

fn z_new(t: u64) {
    zn = 0
    z_str(t)
}

fn z_end() {
    __mmio_write8(((&zl[0]) as u64 + zn) as *mut u8, 10 as u8)
    zn = zn + 1
    let _w: u64 = ulib.put((&zl[0]) as u64, zn)
    zn = 0
}

fn kv(name: u64, v: u64) {
    z_kv(name, v)
}

// ------------------------------------------------------- die Messung

fn pstat(i: u64, f: u64) -> u64 {
    let v: u64 = ulib.sys(ulib.SYS_PSTAT, i, f, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

fn cpustat(i: u64, f: u64) -> u64 {
    let v: u64 = ulib.sys(ulib.SYS_CPUSTAT, i, f, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

fn info(f: u64) -> u64 {
    let v: u64 = ulib.sys(ulib.SYS_SYSINFO, f, 0, 0)
    if ulib.bad(v) {
        return 0
    }
    return v
}

fn netmon(f: u64) -> u64 {
    let v: u64 = ulib.sys(ulib.SYS_NETMON, 0, 0, f)
    if ulib.bad(v) {
        return 0
    }
    return v
}

// Der Name eines Prozesses, Oktett fuer Oktett aus SYS_PMON, Art 2 --
// dieselbe Quelle wie in /bin/powermon. Er steht im Kernel an genau
// einer Stelle (`elf.fi` beim Einsprung), also kann er hier nicht von
// dem abweichen, was wirklich laeuft.
const SYS_PMON: u64 = 1830

fn read_name(slot: u64) {
    let d: u64 = (&p_name[0]) as u64 + slot * NAMEW
    var i: u64 = 0
    while i < NAMEW {
        var c: u64 = ulib.sys(SYS_PMON, 2, slot, i)
        if ulib.bad(c) {
            c = 0
        }
        __mmio_write8((d + i) as *mut u8, c as u8)
        i = i + 1
    }
    __mmio_write8((d + NAMEW - 1) as *mut u8, 0 as u8)
}

fn name_of(slot: u64) -> u64 {
    let d: u64 = (&p_name[0]) as u64 + slot * NAMEW
    if __mmio_read8((d) as *mut u8) != 0 as u8 {
        return d
    }
    let k: u64 = p_kind[(slot) as usize]
    if k == 0 {
        return msg.get(ptr((&k_k_boot[0]) as u64))
    }
    if k == 1 {
        return msg.get(ptr((&k_k_idle[0]) as u64))
    }
    if k == 2 {
        return msg.get(ptr((&k_k_worker[0]) as u64))
    }
    return msg.get(ptr((&k_k_user[0]) as u64))
}

fn state_word(st: u64) -> u64 {
    if st == 1 {
        return msg.get(ptr((&k_s_ready[0]) as u64))
    }
    if st == 2 {
        return msg.get(ptr((&k_s_run[0]) as u64))
    }
    if st == 3 {
        return msg.get(ptr((&k_s_sleep[0]) as u64))
    }
    if st == 4 {
        return msg.get(ptr((&k_s_wait[0]) as u64))
    }
    if st == 5 {
        return msg.get(ptr((&k_s_zombie[0]) as u64))
    }
    if st == 7 {
        return msg.get(ptr((&k_s_stop[0]) as u64))
    }
    if st == 8 {
        return msg.get(ptr((&k_s_poll[0]) as u64))
    }
    return msg.get(ptr((&k_s_new[0]) as u64))
}

// EINE MESSUNG. `erste` heisst: nur den Stand holen, keine Differenz
// bilden -- ohne einen Vorher-Wert ist jeder Prozentsatz erfunden.
fn sample(first: bool) {
    var n: u64 = cpustat(0, ulib.CS_COUNT)
    if n == 0 || n > MAXCPU {
        n = 1
    }
    ncpu = n
    var d_all: u64 = 0
    var d_busy: u64 = 0
    var i: u64 = 0
    while i < ncpu {
        let t: u64 = cpustat(i, ulib.CS_TICKS)
        let idl: u64 = cpustat(i, ulib.CS_IDLE)
        let dt: u64 = sub(t, c_ticks[(i) as usize])
        var di: u64 = sub(idl, c_idle[(i) as usize])
        if di > dt {
            di = dt
        }
        c_ticks[(i) as usize] = t
        c_idle[(i) as usize] = idl
        if !first && dt > 0 {
            c_pm[(i) as usize] = (dt - di) * 1000 / dt
        }
        d_all = d_all + dt
        d_busy = d_busy + (dt - di)
        i = i + 1
    }
    if !first && d_all > 0 {
        cpu_pm = d_busy * 1000 / d_all
    }

    // Der Speicher: Rahmen, wie `top` sie zaehlt. Ein Rahmen ist 4 KiB.
    mem_all = info(ulib.I_FRAMES_ALL)
    let free: u64 = info(ulib.I_FRAMES_FREE)
    mem_used = sub(mem_all, free)
    if mem_all > 0 {
        mem_pm = mem_used * 1000 / mem_all
    }
    disk_all = info(ulib.I_BLOCKS)
    disk_used = sub(disk_all, info(ulib.I_BFREE))
    if disk_all > 0 {
        disk_pm = disk_used * 1000 / disk_all
    }
    up_ms = info(ulib.I_UPTIME)

    // Das Netz: dieselben zwei Zaehler, die `/bin/netmon` liest.
    net_ok = netmon(ulib.NM_ON)
    let tx: u64 = netmon(ulib.NM_SYSTX)
    let rx: u64 = netmon(ulib.NM_SYSRX)
    if !first {
        net_tx = sub(tx, net_ltx)
        net_rx = sub(rx, net_lrx)
    }
    net_ltx = tx
    net_lrx = rx

    // Die Prozesse.
    nlive = 0
    var s: u64 = 0
    while s < SLOTS {
        let st: u64 = ulib.sys(ulib.SYS_PSTAT, s, ulib.P_STATE, 0)
        if ulib.bad(st) || st == 0 {
            p_last[(s) as usize] = 0
            p_lastpid[(s) as usize] = 0
        } else {
            let pid: u64 = pstat(s, ulib.P_PID)
            let tk: u64 = pstat(s, ulib.P_TICKS)
            var d: u64 = 0
            if p_lastpid[(s) as usize] == pid && tk > p_last[(s) as usize] {
                d = tk - p_last[(s) as usize]
            }
            p_last[(s) as usize] = tk
            p_lastpid[(s) as usize] = pid
            p_pid[(s) as usize] = pid
            p_ppid[(s) as usize] = pstat(s, ulib.P_PPID)
            p_state[(s) as usize] = st
            p_kind[(s) as usize] = pstat(s, ulib.P_KIND)
            p_pages[(s) as usize] = pstat(s, ulib.P_PAGES)
            p_core[(s) as usize] = pstat(s, ulib.P_CPU)
            p_ticks[(s) as usize] = tk
            if first || d_all == 0 {
                p_pm[(s) as usize] = 0
            } else {
                p_pm[(s) as usize] = d * 1000 / d_all
            }
            read_name(s)
            ord[(nlive) as usize] = s
            nlive = nlive + 1
        }
        s = s + 1
    }
    sortiere()
}

// -------------------------------------------------------- das Sortieren
//
// Einfuegesortieren ueber die Platznummern. Zweiunddreissig Zeilen
// einmal je Sekunde -- ein schnelleres Verfahren waere hier mehr Code
// als Nutzen.

fn schluessel(s: u64) -> u64 {
    if sort_col == 0 {
        return p_pid[(s) as usize]
    }
    if sort_col == 2 {
        return p_state[(s) as usize]
    }
    if sort_col == 3 {
        return p_pm[(s) as usize]
    }
    if sort_col == 4 {
        return p_pages[(s) as usize]
    }
    if sort_col == 5 {
        return p_core[(s) as usize]
    }
    return 0
}

// Spalte 1 ist der Name, und ein Name ist keine Zahl. Der Vergleich
// laeuft Oktett fuer Oktett; gleiche Namen entscheidet die
// Prozessnummer, damit die Reihenfolge zwischen zwei Messungen nicht
// springt.
fn before(a: u64, b: u64) -> bool {
    if sort_col == 1 {
        let pa: u64 = name_of(a)
        let pb: u64 = name_of(b)
        var i: u64 = 0
        while i < NAMEW {
            let ca: u64 = __mmio_read8((pa + i) as *mut u8) as u64
            let cb: u64 = __mmio_read8((pb + i) as *mut u8) as u64
            if ca != cb {
                if sort_ab != 0 {
                    return ca > cb
                }
                return ca < cb
            }
            if ca == 0 {
                i = NAMEW
            }
            i = i + 1
        }
        return p_pid[(a) as usize] < p_pid[(b) as usize]
    }
    let ka: u64 = schluessel(a)
    let kb: u64 = schluessel(b)
    if ka == kb {
        return p_pid[(a) as usize] < p_pid[(b) as usize]
    }
    if sort_ab != 0 {
        return ka > kb
    }
    return ka < kb
}

fn sortiere() {
    var i: u64 = 1
    while i < nlive {
        let v: u64 = ord[(i) as usize]
        var j: u64 = i
        while j > 0 && before(v, ord[(j - 1) as usize]) {
            ord[(j) as usize] = ord[(j - 1) as usize]
            j = j - 1
        }
        ord[(j) as usize] = v
        i = i + 1
    }
}

// ------------------------------------------------------- die Textblocks

fn build_head() {
    let d: u64 = (&l_sys[0]) as u64
    var a: u64 = 0
    a = put_str(d, a, msg.get(ptr((&k_cpu[0]) as u64)))
    a = put_str(d, a, ptr((&u_colon[0]) as u64))
    a = put_pm(d, a, cpu_pm)
    a = put_str(d, a, ptr((&u_pct[0]) as u64))
    a = put_str(d, a, ptr((&u_sep[0]) as u64))
    a = put_str(d, a, msg.get(ptr((&k_mem[0]) as u64)))
    a = put_str(d, a, ptr((&u_colon[0]) as u64))
    a = put_size(d, a, mem_used * 4)
    a = put_str(d, a, ptr((&u_slash[0]) as u64))
    a = put_size(d, a, mem_all * 4)
    a = put_str(d, a, ptr((&u_op[0]) as u64))
    a = put_pm(d, a, mem_pm)
    a = put_str(d, a, ptr((&u_pct[0]) as u64))
    a = put_str(d, a, ptr((&u_cl[0]) as u64))
    a = put_str(d, a, ptr((&u_sep[0]) as u64))
    a = put_str(d, a, msg.get(ptr((&k_up[0]) as u64)))
    a = put_str(d, a, ptr((&u_colon[0]) as u64))
    a = put_time(d, a, up_ms)

    let e: u64 = (&l_cores[0]) as u64
    var b: u64 = 0
    b = put_str(e, b, msg.get(ptr((&k_cores[0]) as u64)))
    b = put_str(e, b, ptr((&u_colon[0]) as u64))
    var i: u64 = 0
    while i < ncpu {
        if i > 0 {
            b = put_str(e, b, ptr((&u_sep[0]) as u64))
        }
        b = put_num(e, b, i)
        b = put_str(e, b, ptr((&u_colon[0]) as u64))
        b = put_pm(e, b, c_pm[(i) as usize])
        b = put_str(e, b, ptr((&u_pct[0]) as u64))
        i = i + 1
    }

    let f: u64 = (&l_disk[0]) as u64
    var c: u64 = 0
    c = put_str(f, c, msg.get(ptr((&k_disk[0]) as u64)))
    c = put_str(f, c, ptr((&u_colon[0]) as u64))
    c = put_size(f, c, disk_used * 512 / 1024)
    c = put_str(f, c, ptr((&u_slash[0]) as u64))
    c = put_size(f, c, disk_all * 512 / 1024)
    c = put_str(f, c, ptr((&u_op[0]) as u64))
    c = put_pm(f, c, disk_pm)
    c = put_str(f, c, ptr((&u_pct[0]) as u64))
    c = put_str(f, c, ptr((&u_cl[0]) as u64))
    c = put_str(f, c, ptr((&u_sep[0]) as u64))
    c = put_str(f, c, msg.get(ptr((&k_net[0]) as u64)))
    c = put_str(f, c, ptr((&u_colon[0]) as u64))
    // OHNE ZAEHLUNG KEINE ZAHL. `netmon` zaehlt nur, wenn es
    // eingeschaltet ist -- dann steht hier ein Strich und keine Null,
    // die wie "nichts uebertragen" aussaehe.
    if net_ok == 0 {
        c = put_str(f, c, ptr((&u_dash[0]) as u64))
    } else {
        c = put_size(f, c, net_tx / 1024)
        c = put_str(f, c, ptr((&u_ps[0]) as u64))
        c = put_str(f, c, ptr((&u_slash[0]) as u64))
        c = put_size(f, c, net_rx / 1024)
        c = put_str(f, c, ptr((&u_ps[0]) as u64))
    }
    c = put_str(f, c, ptr((&u_sep[0]) as u64))
    c = put_str(f, c, msg.get(ptr((&k_tasks[0]) as u64)))
    c = put_str(f, c, ptr((&u_colon[0]) as u64))
    c = put_num(f, c, nlive)
}

// r402: the same numbers for the four cards (`kp_big` / `kp_sub`, 40 and 64 octets each)
fn build_kpi() {
    let b: u64 = (&kp_big[0]) as u64
    let q: u64 = (&kp_sub[0]) as u64
    var a: u64 = put_pm(b, 0, cpu_pm)
    a = put_str(b, a, ptr((&u_pct[0]) as u64))
    var z: u64 = put_str(q, 0, msg.get(ptr((&k_up[0]) as u64)))
    z = put_str(q, z, ptr((&u_colon[0]) as u64))
    z = put_time(q, z, up_ms)
    kp_pm[0 as usize] = cpu_pm
    a = put_pm(b + 40, 0, mem_pm)
    a = put_str(b + 40, a, ptr((&u_pct[0]) as u64))
    z = put_size(q + 64, 0, mem_used * 4)
    z = put_str(q + 64, z, ptr((&u_slash[0]) as u64))
    z = put_size(q + 64, z, mem_all * 4)
    kp_pm[1 as usize] = mem_pm
    a = put_pm(b + 80, 0, disk_pm)
    a = put_str(b + 80, a, ptr((&u_pct[0]) as u64))
    z = put_size(q + 128, 0, disk_used * 512 / 1024)
    z = put_str(q + 128, z, ptr((&u_slash[0]) as u64))
    z = put_size(q + 128, z, disk_all * 512 / 1024)
    kp_pm[2 as usize] = disk_pm
    if net_ok == 0 {
        a = put_str(b + 120, 0, ptr((&u_dash[0]) as u64))
        z = put_str(q + 192, 0, msg.get(ptr((&k_tasks[0]) as u64)))
        z = put_str(q + 192, z, ptr((&u_colon[0]) as u64))
        z = put_num(q + 192, z, nlive)
        kp_pm[3 as usize] = 0
    } else {
        a = put_size(b + 120, 0, net_tx / 1024)
        a = put_str(b + 120, a, ptr((&u_ps[0]) as u64))
        z = put_size(q + 192, 0, net_rx / 1024)
        z = put_str(q + 192, z, ptr((&u_ps[0]) as u64))
        var np: u64 = (net_tx + net_rx) / 1024
        if np > 1000 {
            np = 1000
        }
        kp_pm[3 as usize] = np
    }
}

// Die Kopfzeile der Tabelle ist Zeile 0 des Blocks -- so steht die
// Beschriftung in derselben Quelle wie die Daten. Die Pfeilspitze sagt,
// nach welcher Spalte sortiert ist und in welche Richtung; ohne sie
// waere die Sortierung nur an der Reihenfolge zu erraten.
// r443: the totals sit in the header of their columns ("CPU 12,3 %", "Memory 31,0 %"), as in the Windows
// task manager: the column you sort by says how much of the machine it adds up to.
fn head_sum(d: u64, at: u64, col: u64) -> u64 {
    var a: u64 = at
    if col == 3 {
        a = put_str(d, a, ptr((&u_sp[0]) as u64))
        a = put_num(d, a, cpu_pm / 10)
        a = put_str(d, a, ptr((&u_pct[0]) as u64))
    } else if col == 4 {
        a = put_str(d, a, ptr((&u_sp[0]) as u64))
        a = put_num(d, a, mem_pm / 10)
        a = put_str(d, a, ptr((&u_pct[0]) as u64))
    }
    return a
}

// The symbol of a process in the list: a program, a worker, the idle task, the kernel.
fn kind_icon(k: u64) -> u64 {
    if k == 3 {
        return wlib.icon_tint(wlib.icon_id(icons.FILE_PROGRAM), 8141549)
    }
    if k == 2 {
        return wlib.icon_tint(wlib.icon_id(icons.SETTINGS), 9741240)
    }
    if k == 1 {
        return wlib.icon_tint(wlib.icon_id(icons.POWER), 9741240)
    }
    return wlib.icon_tint(wlib.icon_id(icons.START), 15904798)
}

fn build_rows() {
    let d: u64 = (&blob[0]) as u64
    var a: u64 = 0
    let kopf: u64 = msg.get(ptr((&k_cols[0]) as u64))
    let kn: u64 = ulib.length(kopf)
    var i: u64 = 0
    var spalte: u64 = 0
    while i < kn {
        let ch: u64 = __mmio_read8((kopf + i) as *mut u8) as u64
        if ch == 9 {
            a = head_sum(d, a, spalte)
            if spalte == sort_col {
                a = put_str(d, a, pfeil())
            }
            spalte = spalte + 1
        }
        __mmio_write8((d + a) as *mut u8, ch as u8)
        a = a + 1
        i = i + 1
    }
    a = head_sum(d, a, spalte)
    if spalte == sort_col {
        a = put_str(d, a, pfeil())
    }
    a = put_str(d, a, ptr((&u_nl[0]) as u64))

    var r: u64 = 0
    while r < nlive {
        let s: u64 = ord[(r) as usize]
        row_icons[(r) as usize] = kind_icon(p_kind[(s) as usize])
        a = put_num(d, a, p_pid[(s) as usize])
        a = put_str(d, a, ptr((&u_tab[0]) as u64))
        a = put_str(d, a, name_of(s))
        a = put_str(d, a, ptr((&u_tab[0]) as u64))
        a = put_str(d, a, state_word(p_state[(s) as usize]))
        a = put_str(d, a, ptr((&u_tab[0]) as u64))
        a = put_pm(d, a, p_pm[(s) as usize])
        a = put_str(d, a, ptr((&u_pct[0]) as u64))
        a = put_str(d, a, ptr((&u_tab[0]) as u64))
        // KEIN EIGENER ADRESSRAUM, KEINE ZAHL. Die Bootaufgabe und die
        // Leerlaufaufgaben laufen im Adressraum des Kernels; eine 0 KiB
        // waere eine Messung, ein Strich ist die Wahrheit.
        if p_pages[(s) as usize] == 0 {
            a = put_str(d, a, ptr((&u_dash[0]) as u64))
        } else {
            a = put_size(d, a, p_pages[(s) as usize] * 4)
        }
        a = put_str(d, a, ptr((&u_tab[0]) as u64))
        if p_core[(s) as usize] >= MAXCPU {
            a = put_str(d, a, ptr((&u_dash[0]) as u64))
        } else {
            a = put_num(d, a, p_core[(s) as usize])
        }
        a = put_str(d, a, ptr((&u_nl[0]) as u64))
        // r402: the heat of the CPU and memory cells (row r of the table is row r of `ord`)
        fuiscene.heat_set(r, 0, p_pm[(s) as usize] * 4)
        var mh: u64 = 0
        if mem_all > 0 {
            mh = p_pages[(s) as usize] * 4000 / mem_all
        }
        fuiscene.heat_set(r, 1, mh * 8)
        r = r + 1
    }
    __mmio_write8((d + a) as *mut u8, 0 as u8)
}

fn pfeil() -> u64 {
    if sort_ab != 0 {
        return ptr((&u_arrow_dn[0]) as u64)
    }
    return ptr((&u_arrow_up[0]) as u64)
}

fn row_of_pid(pid: u64) -> u64 {
    var r: u64 = 0
    while r < nlive {
        if p_pid[(ord[(r) as usize]) as usize] == pid {
            return r
        }
        r = r + 1
    }
    return SLOTS
}

fn build_sel() {
    let d: u64 = (&l_sel[0]) as u64
    var a: u64 = 0
    if sel_pid == 0 {
        let _x: u64 = put_str(d, a, msg.get(ptr((&k_nosel[0]) as u64)))
        return
    }
    a = put_str(d, a, msg.get(ptr((&k_sel[0]) as u64)))
    a = put_str(d, a, ptr((&u_colon[0]) as u64))
    let r: u64 = row_of_pid(sel_pid)
    if r < SLOTS {
        a = put_str(d, a, name_of(ord[(r) as usize]))
        a = put_str(d, a, ptr((&u_sp[0]) as u64))
    }
    a = put_str(d, a, ptr((&u_op[0]) as u64))
    a = put_num(d, a, sel_pid)
    a = put_str(d, a, ptr((&u_cl[0]) as u64))
}

// --------------------------------------------------------- der Graph
//
// FUI-ALL: der Graph ist ein Knoten des fUi-Szenenbaums (fuiscene.canvas)
// und wird von DIESEM Programm gemalt -- mit den Rollenfarben des Themas
// (Feld, Rand, Akzent, Erfolg), nie mit Zahlen. Die Stellen der Messpunkte
// rechnen `gx_of` / `gy_of`, und die Zeile `taskmgr: graph` meldet sie.

fn hist_push() {
    hist_schieben()
}

// The network load as 0..1000 of the largest rate seen so far (at least 100 KiB/s): the graph needs a
// scale, and a fixed one would show a idle line on a fast link and a full one on a slow link.
fn net_now() -> u64 {
    if net_ok == 0 {
        return 0
    }
    let kib: u64 = (net_tx + net_rx) / 1024
    if kib > net_max {
        net_max = kib
    }
    return kib * 1000 / net_max
}

fn hist_schieben() {
    if h_n < HIST {
        h_cpu[(h_n) as usize] = cpu_pm
        h_mem[(h_n) as usize] = mem_pm
        h_disk[(h_n) as usize] = disk_pm
        h_net[(h_n) as usize] = net_now()
        h_n = h_n + 1
        return
    }
    var i: u64 = 0
    while i + 1 < HIST {
        h_cpu[(i) as usize] = h_cpu[(i + 1) as usize]
        h_mem[(i) as usize] = h_mem[(i + 1) as usize]
        h_disk[(i) as usize] = h_disk[(i + 1) as usize]
        h_net[(i) as usize] = h_net[(i + 1) as usize]
        i = i + 1
    }
    h_cpu[(HIST - 1) as usize] = cpu_pm
    h_mem[(HIST - 1) as usize] = mem_pm
    h_disk[(HIST - 1) as usize] = disk_pm
    h_net[(HIST - 1) as usize] = net_now()
}

// Die Stelle eines Messpunktes. EINE Funktion, und der Mitschnitt
// meldet ihr Ergebnis fuer den ersten und den letzten Punkt -- ein
// Pruefer, der die Formel nachbaut, kann seinen Nachbau an beiden Enden
// gegen das Original halten.
// r443: where the history curve of the performance page puts a sample: the box is the canvas shrunk by its
// 1-pixel frame, the samples are laid over its whole width (lib/fui/navkit.fi `paint_graph`).
fn gx_of(gx: u64, gw: u64, i: u64) -> u64 {
    if h_n < 2 {
        return gx + 1
    }
    return gx + 1 + i * sub(gw, 3) / (h_n - 1)
}

fn gy_of(gy: u64, gh: u64, v: u64) -> u64 {
    return gy + 1 + navnum.graph_y(sub(gh, 2), v)
}

// the report of a text the cards paint (the shot checker finds the text where this says it is)
fn kpi_say(x: u64, base: u64, role: u64, txt: u64) {
    if !fuiscene.trace_on() {
        return
    }
    z_new(ptr((&m_text[0]) as u64))
    z_num(x)
    z_kv(ptr((&m_base[0]) as u64), base)
    z_kv(ptr((&m_fg[0]) as u64), (fuiscene.role_col(role) as u64) & 0xFFFFFF)
    z_kv(ptr((&m_bg[0]) as u64), (fuiscene.role_col(fuiscene.R_FIELD) as u64) & 0xFFFFFF)
    z_str(ptr((&m_ot[0]) as u64))
    z_str(txt)
    z_str(ptr((&m_ct2[0]) as u64))
    z_end()
}

// r402 (D-011): THE SUMMARY AS FOUR CARDS (CPU, memory, disk, network): a muted title, the big number,
// a small line, and a thin bar of the load under it -- the overview first, the details below.
fn kpi_draw(kx: u64, ky: u64, kw: u64, kh: u64) {
    let gap: u64 = 8
    let cw: u64 = sub(kw, 3 * gap) / 4
    var c: u64 = 0
    while c < 4 {
        let cx: u64 = kx + c * (cw + gap)
        fuiscene.cv_round(cx, ky, cw, kh, 8, fuiscene.R_FIELD)
        fuiscene.cv_ring(cx, ky, cw, kh, 8, fuiscene.R_BORDER)
        var tt: u64 = ptr((&k_cpu[0]) as u64)
        if c == 1 {
            tt = ptr((&k_mem[0]) as u64)
        } else if c == 2 {
            tt = ptr((&k_disk[0]) as u64)
        } else if c == 3 {
            tt = ptr((&k_net[0]) as u64)
        }
        fuiscene.text_role(cx + 12, ky + 22, cw - 20, msg.get(tt), 12, false, fuiscene.R_MUTED)
        fuiscene.text_role(cx + 12, ky + 48, cw - 20, (&kp_big[0]) as u64 + c * 40, 20, true,
            fuiscene.R_TEXT)
        kp_x[(c) as usize] = cx
        kp_y[(c) as usize] = ky
        fuiscene.text_role(cx + 12, ky + 66, cw - 20, (&kp_sub[0]) as u64 + c * 64, 12, false,
            fuiscene.R_MUTED)
        // the bar: a track and the load, 0..1000
        let bx: u64 = cx + 12
        let bw: u64 = sub(cw, 24)
        fuiscene.cv_round(bx, ky + kh - 12, bw, 4, 2, fuiscene.R_BORDER)
        var fw: u64 = bw * kp_pm[(c) as usize] / 1000
        if kp_pm[(c) as usize] > 0 && fw < 4 {
            fw = 4
        }
        if fw > bw {
            fw = bw
        }
        var role: u64 = fuiscene.R_ACCENT
        if c == 1 {
            role = fuiscene.R_SUCCESS
        }
        if fw > 0 {
            fuiscene.cv_round(bx, ky + kh - 12, fw, 4, 2, role)
        }
        c = c + 1
    }
}

// r443: the small texts of the four cards, reported like the text of a node (the picture checker measures them);
// to be printed right after `say_texts` of the same picture.
fn say_cards() {
    if n_kpi == fuiscene.NONE {
        return
    }
    var c: u64 = 0
    while c < 4 {
        var tt: u64 = ptr((&k_cpu[0]) as u64)
        if c == 1 {
            tt = ptr((&k_mem[0]) as u64)
        } else if c == 2 {
            tt = ptr((&k_disk[0]) as u64)
        } else if c == 3 {
            tt = ptr((&k_net[0]) as u64)
        }
        fuiscene.say_cv_text(kp_x[(c) as usize] + 12, kp_y[(c) as usize] + 22, fuiscene.R_MUTED,
            fuiscene.R_FIELD, 12, msg.get(tt))
        fuiscene.say_cv_text(kp_x[(c) as usize] + 12, kp_y[(c) as usize] + 66, fuiscene.R_MUTED,
            fuiscene.R_FIELD, 12, (&kp_sub[0]) as u64 + c * 64)
        c = c + 1
    }
}

// What the program says about the graph on the serial line: where it is
// and which numbers are in it (tools/toolbench/graphcheck.py).
fn draw_graph(gx: u64, gy: u64, gw: u64, gh: u64, melden: bool) {
    if !melden {
        return
    }
    var letzte: u64 = 0
    if h_n > 0 {
        letzte = h_n - 1
    }
    z_new(ptr((&m_graph[0]) as u64))
    z_num(gx)
    z_kv(ptr((&m_y[0]) as u64), gy)
    z_kv(ptr((&m_w[0]) as u64), gw)
    z_kv(ptr((&m_h[0]) as u64), gh)
    z_kv(ptr((&m_gn[0]) as u64), h_n)
    z_kv(ptr((&m_ghist[0]) as u64), HIST)
    z_kv(ptr((&m_p0x[0]) as u64), gx_of(gx, gw, 0))
    z_kv(ptr((&m_p0y[0]) as u64), gy_of(gy, gh, h_cpu[(0) as usize]))
    z_kv(ptr((&m_pnx[0]) as u64), gx_of(gx, gw, letzte))
    z_kv(ptr((&m_pny[0]) as u64), gy_of(gy, gh, h_cpu[(letzte) as usize]))
    z_end()
    if melde == 0 {
        return
    }
    z_new(ptr((&m_gcpu[0]) as u64))
    var i: u64 = 0
    while i < h_n {
        z_str(ptr((&u_sp[0]) as u64))
        z_num(h_cpu[(i) as usize])
        i = i + 1
    }
    z_end()
    z_new(ptr((&m_gmem[0]) as u64))
    i = 0
    while i < h_n {
        z_str(ptr((&u_sp[0]) as u64))
        z_num(h_mem[(i) as usize])
        i = i + 1
    }
    z_end()
}

// ------------------------------------------------------- der Mitschnitt

// wlib's kinds, as the acceptance scripts know them.
const NK_LABEL: u64 = 1
const NK_BUTTON: u64 = 2
const NK_TABLE: u64 = 6
const NK_GRAPH: u64 = 14

const K_TAB: u64 = 1
const K_KILL: u64 = 2
const K_OVF: u64 = 30 // the "..." of the command bar
const ROW_H: u64 = 32
const HEAD_H: u64 = 28

// The nodes of the current tree (they change with every rebuild).
static mut n_sys: usize = 0
static mut n_core: usize = 0
static mut n_disk: usize = 0
static mut n_graph: usize = 0
static mut n_tab: usize = 0
static mut n_sel: usize = 0
static mut n_kill: usize = 0

static mut t_ok: [u8; 3] = "OK\0"
static mut t_abbr: [u8; 10] = "Abbrechen\0"

fn say_rect(n: usize, id: u64, art: u64) {
    if n == fuiscene.NONE {
        return
    }
    z_new(ptr((&m_rect[0]) as u64))
    z_num(id)
    z_kv(ptr((&m_kind[0]) as u64), art)
    z_kv(ptr((&m_x[0]) as u64), fuiscene.node_x(n))
    z_kv(ptr((&m_y[0]) as u64), fuiscene.node_y(n))
    z_kv(ptr((&m_w[0]) as u64), fuiscene.node_w(n))
    z_kv(ptr((&m_h[0]) as u64), fuiscene.node_h(n))
    z_end()
}

// Die Oberkante der Zeile r der Tabelle, in Fensterkoordinaten.
fn tab_y(r: u64) -> u64 {
    if n_tab == fuiscene.NONE {
        return 0
    }
    return fuiscene.node_y(n_tab) + HEAD_H + 2 + r * ROW_H
}

// EIN VOLLER BLOCK. Er geht ueber die serielle Leitung, und die ist
// 115 200 Baud: vierzig Zeilen je Sekunde sind ein Fuenftel der
// Leitung und bremsen genau das Programm, das die Auslastung messen
// soll. Also nur, wenn `melde` es verlangt -- und einmal am Anfang und
// einmal am Ende, damit auch ein stiller Lauf nachzurechnen ist.
fn bericht() {
    blocknr = blocknr + 1
    z_new(ptr((&m_block[0]) as u64))
    z_num(blocknr)
    z_end()
    z_new(ptr((&m_head[0]) as u64))
    z_num(cpu_pm)
    z_kv(ptr((&m_mem[0]) as u64), mem_pm)
    z_kv(ptr((&m_memu[0]) as u64), mem_used * 4)
    z_kv(ptr((&m_mema[0]) as u64), mem_all * 4)
    z_kv(ptr((&m_disk[0]) as u64), disk_pm)
    z_kv(ptr((&m_up[0]) as u64), up_ms)
    z_kv(ptr((&m_tasks[0]) as u64), nlive)
    z_end()
    z_new(ptr((&m_net[0]) as u64))
    z_num(net_tx)
    z_kv(ptr((&m_nrx[0]) as u64), net_rx)
    z_kv(ptr((&m_non[0]) as u64), net_ok)
    z_end()
    var i: u64 = 0
    while i < ncpu {
        z_new(ptr((&m_core[0]) as u64))
        z_num(i)
        z_kv(ptr((&m_ct[0]) as u64), c_ticks[(i) as usize])
        z_kv(ptr((&m_ci[0]) as u64), c_idle[(i) as usize])
        z_kv(ptr((&m_cp[0]) as u64), c_pm[(i) as usize])
        z_end()
        i = i + 1
    }
    var r: u64 = 0
    while r < nlive {
        let s: u64 = ord[(r) as usize]
        z_new(ptr((&m_row[0]) as u64))
        z_num(r)
        z_kv(ptr((&m_pid[0]) as u64), p_pid[(s) as usize])
        z_kv(ptr((&m_ppid[0]) as u64), p_ppid[(s) as usize])
        z_kv(ptr((&m_st[0]) as u64), p_state[(s) as usize])
        z_kv(ptr((&m_pm[0]) as u64), p_pm[(s) as usize])
        z_kv(ptr((&m_kib[0]) as u64), p_pages[(s) as usize] * 4)
        z_kv(ptr((&m_kern[0]) as u64), p_core[(s) as usize])
        z_kv(ptr((&m_ct[0]) as u64), p_ticks[(s) as usize])
        // WO DIE ZEILE STEHT, in Fensterkoordinaten. Ein Testlaeufer,
        // der das ausrechnen muesste, rechnete die Anordnung nach --
        // und pruefte damit seinen eigenen Nachbau. `tab_y` ist
        // dieselbe Formel, mit der die Tabelle die Zeile hinmalt.
        z_kv(ptr((&m_y[0]) as u64), tab_y(r))
        z_str(ptr((&m_name[0]) as u64))
        z_str(name_of(s))
        z_end()
        r = r + 1
    }
    z_new(ptr((&m_blockend[0]) as u64))
    z_num(blocknr)
    z_end()
}

// ------------------------------------------------------------ die Argumente

fn arg_num(args: u64, wort: u64, standard: u64) -> u64 {
    let n: u64 = ulib.arg_count(args)
    var i: u64 = 1
    while i + 1 < n {
        if ulib.streq(ulib.arg_at(args, i), wort) {
            return ulib.to_num(ulib.arg_at(args, i + 1))
        }
        i = i + 1
    }
    return standard
}

fn arg_hat(args: u64, wort: u64) -> bool {
    let n: u64 = ulib.arg_count(args)
    var i: u64 = 1
    while i < n {
        if ulib.streq(ulib.arg_at(args, i), wort) {
            return true
        }
        i = i + 1
    }
    return false
}

// ---------------------------------------------------------------- Start

// The window, described for fUi's scene tree. Everything the program
// shows is a node; the numbers it shows are texts in static buffers that
// `sample` and the build_* functions fill before `refresh()`.
// ======================================================= r443 (D-013): THE PAGES
//
// A sidebar of four pages on the left, the page right of it. The sidebar is a one-column list of the
// navigation kit (icons, accent bar on the chosen row); the pages are described again at every `refresh`.

const K_NAV: u64 = 3
const K_PSEL: u64 = 4
const K_START: u64 = 5
const PSELH: u64 = 346 // the height of the graph and the values under it (GH + 8 + 88)

fn nav_make() {
    let d: u64 = (&nav_blob[0]) as u64
    var a: u64 = put_str(d, 0, msg.get(ptr((&k_pg_proc[0]) as u64)))
    a = put_str(d, a, ptr((&u_nl[0]) as u64))
    a = put_str(d, a, msg.get(ptr((&k_pg_perf[0]) as u64)))
    a = put_str(d, a, ptr((&u_nl[0]) as u64))
    a = put_str(d, a, msg.get(ptr((&k_pg_start[0]) as u64)))
    a = put_str(d, a, ptr((&u_nl[0]) as u64))
    a = put_str(d, a, msg.get(ptr((&k_pg_det[0]) as u64)))
    a = put_str(d, a, ptr((&u_nl[0]) as u64))
    nav_icons[0 as usize] = wlib.icon_id(icons.PAGE_LIST)
    nav_icons[1 as usize] = wlib.icon_id(icons.PAGE_ACTIVITY)
    nav_icons[2 as usize] = wlib.icon_id(icons.PAGE_STARTUP)
    nav_icons[3 as usize] = wlib.icon_id(icons.PAGE_DETAILS)
}

// The four resources of the performance page as two-line rows: the name, and under it the number and the line.
fn psel_make() {
    let d: u64 = (&psel_blob[0]) as u64
    var a: u64 = 0
    var c: u64 = 0
    while c < 4 {
        var tt: u64 = ptr((&k_cpu[0]) as u64)
        if c == 1 {
            tt = ptr((&k_mem[0]) as u64)
        } else if c == 2 {
            tt = ptr((&k_disk[0]) as u64)
        } else if c == 3 {
            tt = ptr((&k_net[0]) as u64)
        }
        a = put_str(d, a, msg.get(tt))
        a = put_str(d, a, ptr((&u_tab[0]) as u64))
        a = put_str(d, a, (&kp_big[0]) as u64 + c * 40)
        a = put_str(d, a, ptr((&u_sep[0]) as u64))
        a = put_str(d, a, (&kp_sub[0]) as u64 + c * 64)
        a = put_str(d, a, ptr((&u_nl[0]) as u64))
        c = c + 1
    }
}

// One statistic of the performance page: a muted word and the value under it (up to four).
fn stat_add(lab: u64, v: u64) {
    if stat_n >= 4 {
        return
    }
    stat_lab[(stat_n) as usize] = lab
    put_str((&stat_val[0]) as u64 + stat_n * 64, 0, v)
    stat_n = stat_n + 1
}

// The values under the graph, for the chosen resource. Built into `stat_val` (4 x 64 octets).
fn stats_make() {
    stat_n = 0
    var t: [u8; 64] = [0 as u8; 64]
    let tp: u64 = (&t[0]) as u64
    if perf_sel == 0 {
        var a: u64 = put_pm(tp, 0, cpu_pm)
        a = put_str(tp, a, ptr((&u_pct[0]) as u64))
        stat_add(msg.get(ptr((&k_s_util[0]) as u64)), tp)
        let _x: u64 = put_num(tp, 0, nlive)
        stat_add(msg.get(ptr((&k_s_procs[0]) as u64)), tp)
        let _y: u64 = put_time(tp, 0, up_ms)
        stat_add(msg.get(ptr((&k_up[0]) as u64)), tp)
        let _z: u64 = put_num(tp, 0, ncpu)
        stat_add(msg.get(ptr((&k_cores[0]) as u64)), tp)
    } else if perf_sel == 1 {
        let _a: u64 = put_size(tp, 0, mem_used * 4)
        stat_add(msg.get(ptr((&k_s_used[0]) as u64)), tp)
        let _b: u64 = put_size(tp, 0, sub(mem_all, mem_used) * 4)
        stat_add(msg.get(ptr((&k_s_free[0]) as u64)), tp)
        let _c: u64 = put_size(tp, 0, mem_all * 4)
        stat_add(msg.get(ptr((&k_s_total[0]) as u64)), tp)
        var a2: u64 = put_pm(tp, 0, mem_pm)
        a2 = put_str(tp, a2, ptr((&u_pct[0]) as u64))
        stat_add(msg.get(ptr((&k_s_util[0]) as u64)), tp)
    } else if perf_sel == 2 {
        let _a: u64 = put_size(tp, 0, disk_used * 512 / 1024)
        stat_add(msg.get(ptr((&k_s_used[0]) as u64)), tp)
        let _b: u64 = put_size(tp, 0, sub(disk_all, disk_used) * 512 / 1024)
        stat_add(msg.get(ptr((&k_s_free[0]) as u64)), tp)
        let _c: u64 = put_size(tp, 0, disk_all * 512 / 1024)
        stat_add(msg.get(ptr((&k_s_total[0]) as u64)), tp)
        var a3: u64 = put_pm(tp, 0, disk_pm)
        a3 = put_str(tp, a3, ptr((&u_pct[0]) as u64))
        stat_add(msg.get(ptr((&k_s_util[0]) as u64)), tp)
    } else {
        if net_ok == 0 {
            let _d: u64 = put_str(tp, 0, ptr((&u_dash[0]) as u64))
            stat_add(msg.get(ptr((&k_s_sent[0]) as u64)), tp)
            stat_add(msg.get(ptr((&k_s_recv[0]) as u64)), tp)
        } else {
            var a4: u64 = put_size(tp, 0, net_tx / 1024)
            a4 = put_str(tp, a4, ptr((&u_ps[0]) as u64))
            stat_add(msg.get(ptr((&k_s_sent[0]) as u64)), tp)
            var a5: u64 = put_size(tp, 0, net_rx / 1024)
            a5 = put_str(tp, a5, ptr((&u_ps[0]) as u64))
            stat_add(msg.get(ptr((&k_s_recv[0]) as u64)), tp)
        }
    }
}

fn perf_hist() -> u64 {
    if perf_sel == 1 {
        return (&h_mem[0]) as u64
    }
    if perf_sel == 2 {
        return (&h_disk[0]) as u64
    }
    if perf_sel == 3 {
        return (&h_net[0]) as u64
    }
    return (&h_cpu[0]) as u64
}

fn perf_role() -> u64 {
    if perf_sel == 1 {
        return fuiscene.R_SUCCESS
    }
    if perf_sel == 2 {
        return fuiscene.R_WARN
    }
    if perf_sel == 3 {
        return fuiscene.R_ERR
    }
    return fuiscene.R_ACCENT
}

fn perf_name() -> u64 {
    if perf_sel == 1 {
        return msg.get(ptr((&k_mem[0]) as u64))
    }
    if perf_sel == 2 {
        return msg.get(ptr((&k_disk[0]) as u64))
    }
    if perf_sel == 3 {
        return msg.get(ptr((&k_net[0]) as u64))
    }
    return msg.get(ptr((&k_cpu[0]) as u64))
}

// The history of the chosen resource: a card, the curve with its area, the name at the top left and the
// number at the top right.
fn graph_draw(gx: u64, gy: u64, gw: u64, gh: u64) {
    fuiscene.cv_round(gx, gy, gw, gh, 8, fuiscene.R_FIELD)
    fuiscene.cv_graph(gx + 1, gy + 1, sub(gw, 2), sub(gh, 2), perf_hist(), h_n, perf_role())
    fuiscene.cv_ring(gx, gy, gw, gh, 8, fuiscene.R_BORDER)
    fuiscene.text_role(gx + 14, gy + 24, sub(gw, 28), perf_name(), 14, true, fuiscene.R_MUTED)
    fuiscene.text_role(gx + gw - 124, gy + 26, 112, (&kp_big[0]) as u64 + perf_sel * 40, 18, true,
        fuiscene.R_TEXT)
}

// Up to four values under the graph.
fn stats_draw(sx: u64, sy: u64, sw: u64, sh: u64) {
    fuiscene.cv_round(sx, sy, sw, sh, 8, fuiscene.R_FIELD)
    fuiscene.cv_ring(sx, sy, sw, sh, 8, fuiscene.R_BORDER)
    let cw: u64 = sub(sw, 24) / 4
    var i: u64 = 0
    while i < stat_n {
        let x: u64 = sx + 14 + i * cw
        fuiscene.text_role(x, sy + 30, sub(cw, 8), stat_lab[(i) as usize], 12, false, fuiscene.R_MUTED)
        fuiscene.text_role(x, sy + 62, sub(cw, 8), (&stat_val[0]) as u64 + i * 64, 18, true,
            fuiscene.R_TEXT)
        i = i + 1
    }
}

// One horizontal meter: a word at the left, the track with the filled part, the number at the right.
fn meter(x: u64, y: u64, w: u64, lab: u64, v: u64, num: u64, role: u64) {
    fuiscene.text_role(x, y + 14, 150, lab, 13, false, fuiscene.R_TEXT)
    let bx: u64 = x + 160
    let bw: u64 = sub(w, 160 + 110)
    fuiscene.cv_round(bx, y + 6, bw, 8, 4, fuiscene.R_BORDER)
    var fw: u64 = bw * v / 1000
    if v > 0 && fw < 8 {
        fw = 8
    }
    if fw > bw {
        fw = bw
    }
    if fw > 0 {
        fuiscene.cv_round(bx, y + 6, fw, 8, 4, role)
    }
    fuiscene.text_role(bx + bw + 12, y + 14, 98, num, 13, false, fuiscene.R_MUTED)
}

// Below the graph: the cores (CPU), the biggest programs (memory), the disk, the two network directions.
fn cores_draw(cx: u64, cy: u64, cw: u64, ch: u64) {
    fuiscene.cv_round(cx, cy, cw, ch, 8, fuiscene.R_FIELD)
    fuiscene.cv_ring(cx, cy, cw, ch, 8, fuiscene.R_BORDER)
    var t: [u8; 64] = [0 as u8; 64]
    let tp: u64 = (&t[0]) as u64
    if perf_sel == 0 {
        var c: u64 = 0
        while c < ncpu && c < MAXCPU {
            var a: u64 = put_str(tp, 0, msg.get(ptr((&k_d_core[0]) as u64)))
            a = put_str(tp, a, ptr((&u_sp[0]) as u64))
            a = put_num(tp, a, c)
            let lab: u64 = tp
            var nb: [u8; 24] = [0 as u8; 24]
            var b: u64 = put_pm((&nb[0]) as u64, 0, c_pm[(c) as usize])
            b = put_str((&nb[0]) as u64, b, ptr((&u_pct[0]) as u64))
            meter(cx + 14, cy + 10 + c * 24, sub(cw, 28), lab, c_pm[(c) as usize], (&nb[0]) as u64,
                fuiscene.R_ACCENT)
            c = c + 1
        }
    } else if perf_sel == 1 {
        // the five programs with the most pages
        var shown: [u64; 5] = [32 as u64; 5]
        var k: u64 = 0
        var top: u64 = 1
        while k < 5 {
            var best: u64 = 32
            var r: u64 = 0
            while r < nlive {
                let sl: u64 = ord[(r) as usize]
                var used: bool = false
                var q: u64 = 0
                while q < k {
                    if shown[(q) as usize] == sl {
                        used = true
                    }
                    q = q + 1
                }
                if !used && p_pages[(sl) as usize] > 0
                    && (best == 32 || p_pages[(sl) as usize] > p_pages[(best) as usize]) {
                    best = sl
                }
                r = r + 1
            }
            shown[(k) as usize] = best
            if best < 32 {
                if k == 0 {
                    top = p_pages[(best) as usize]
                }
                var nb: [u8; 24] = [0 as u8; 24]
                let _b: u64 = put_size((&nb[0]) as u64, 0, p_pages[(best) as usize] * 4)
                meter(cx + 14, cy + 10 + k * 24, sub(cw, 28), name_of(best),
                    p_pages[(best) as usize] * 1000 / top, (&nb[0]) as u64, fuiscene.R_SUCCESS)
            }
            k = k + 1
        }
    } else if perf_sel == 2 {
        var nb: [u8; 24] = [0 as u8; 24]
        var b: u64 = put_pm((&nb[0]) as u64, 0, disk_pm)
        b = put_str((&nb[0]) as u64, b, ptr((&u_pct[0]) as u64))
        meter(cx + 14, cy + 10, sub(cw, 28), msg.get(ptr((&k_s_used[0]) as u64)), disk_pm,
            (&nb[0]) as u64, fuiscene.R_WARN)
    } else {
        if net_ok != 0 {
            var nb: [u8; 24] = [0 as u8; 24]
            var b: u64 = put_size((&nb[0]) as u64, 0, net_tx / 1024)
            b = put_str((&nb[0]) as u64, b, ptr((&u_ps[0]) as u64))
            meter(cx + 14, cy + 10, sub(cw, 28), msg.get(ptr((&k_s_sent[0]) as u64)),
                net_tx / 1024 * 1000 / net_max, (&nb[0]) as u64, fuiscene.R_ERR)
            var nc: [u8; 24] = [0 as u8; 24]
            var c2: u64 = put_size((&nc[0]) as u64, 0, net_rx / 1024)
            c2 = put_str((&nc[0]) as u64, c2, ptr((&u_ps[0]) as u64))
            meter(cx + 14, cy + 34, sub(cw, 28), msg.get(ptr((&k_s_recv[0]) as u64)),
                net_rx / 1024 * 1000 / net_max, (&nc[0]) as u64, fuiscene.R_ERR)
        }
    }
}

// The details of the chosen process: a card of word / value pairs.
fn det_draw(dx: u64, dy: u64, dw: u64, dh: u64) {
    fuiscene.cv_round(dx, dy, dw, dh, 8, fuiscene.R_FIELD)
    fuiscene.cv_ring(dx, dy, dw, dh, 8, fuiscene.R_BORDER)
    let r: u64 = row_of_pid(sel_pid)
    if sel_pid == 0 || r >= SLOTS {
        fuiscene.text_role(dx + 16, dy + 36, sub(dw, 32), msg.get(ptr((&k_d_none[0]) as u64)), 14, false,
            fuiscene.R_MUTED)
        return
    }
    let sl: u64 = ord[(r) as usize]
    fuiscene.text_role(dx + 16, dy + 40, sub(dw, 32), name_of(sl), 22, true, fuiscene.R_TEXT)
    var t: [u8; 64] = [0 as u8; 64]
    let tp: u64 = (&t[0]) as u64
    var line: u64 = 0
    while line < 8 {
        var lab: u64 = ptr((&k_d_pid[0]) as u64)
        var a: u64 = 0
        if line == 0 {
            a = put_num(tp, 0, p_pid[(sl) as usize])
        } else if line == 1 {
            lab = ptr((&k_d_ppid[0]) as u64)
            a = put_num(tp, 0, p_ppid[(sl) as usize])
        } else if line == 2 {
            lab = ptr((&k_d_state[0]) as u64)
            a = put_str(tp, 0, state_word(p_state[(sl) as usize]))
        } else if line == 3 {
            lab = ptr((&k_d_kind[0]) as u64)
            let k: u64 = p_kind[(sl) as usize]
            var kw: u64 = ptr((&k_k_user[0]) as u64)
            if k == 0 {
                kw = ptr((&k_k_boot[0]) as u64)
            } else if k == 1 {
                kw = ptr((&k_k_idle[0]) as u64)
            } else if k == 2 {
                kw = ptr((&k_k_worker[0]) as u64)
            }
            a = put_str(tp, 0, msg.get(kw))
        } else if line == 4 {
            lab = ptr((&k_d_cpu[0]) as u64)
            a = put_pm(tp, 0, p_pm[(sl) as usize])
            a = put_str(tp, a, ptr((&u_pct[0]) as u64))
        } else if line == 5 {
            lab = ptr((&k_mem[0]) as u64)
            if p_pages[(sl) as usize] == 0 {
                a = put_str(tp, 0, ptr((&u_dash[0]) as u64))
            } else {
                a = put_size(tp, 0, p_pages[(sl) as usize] * 4)
            }
        } else if line == 6 {
            lab = ptr((&k_d_core[0]) as u64)
            if p_core[(sl) as usize] >= MAXCPU {
                a = put_str(tp, 0, ptr((&u_dash[0]) as u64))
            } else {
                a = put_num(tp, 0, p_core[(sl) as usize])
            }
        } else {
            lab = ptr((&k_d_ticks[0]) as u64)
            a = put_num(tp, 0, p_ticks[(sl) as usize])
        }
        let y: u64 = dy + 84 + line * 32
        fuiscene.text_role(dx + 16, y, 200, msg.get(lab), 13, false, fuiscene.R_MUTED)
        fuiscene.text_role(dx + 232, y, sub(dw, 248), tp, 14, false, fuiscene.R_TEXT)
        line = line + 1
    }
}

// Startup: the services of /etc/inittab, one row each (name, command, mode, status).
fn st_load() {
    let d: u64 = (&st_blob[0]) as u64
    var a: u64 = put_str(d, 0, msg.get(ptr((&k_scols[0]) as u64)))
    a = put_str(d, a, ptr((&u_nl[0]) as u64))
    st_n = 0
    var path: [u8; 14] = "/etc/inittab\0\0"
    let fd: u64 = io.open((&path[0]) as u64, 0)
    if ulib.bad(fd) {
        return
    }
    let n: u64 = io.read(fd, (&init_buf[0]) as u64, 2040)
    io.close(fd)
    if ulib.bad(n) {
        return
    }
    __mmio_write8(((&init_buf[0]) as u64 + n) as *mut u8, 0 as u8)
    var at: u64 = 0
    while at < n && a < 2900 {
        // one line: [at, end)
        var e: u64 = at
        while e < n && __mmio_read8(((&init_buf[0]) as u64 + e) as *mut u8) != 10 as u8 {
            e = e + 1
        }
        let first: u64 = __mmio_read8(((&init_buf[0]) as u64 + at) as *mut u8) as u64
        if e > at && first != 35 {
            // fields name:targets:action:command[:options]
            var fs: [u64; 5] = [0 as u64; 5]
            var fe: [u64; 5] = [0 as u64; 5]
            var nf: u64 = 0
            var q: u64 = at
            var start: u64 = at
            while q <= e && nf < 5 {
                var ch: u64 = 0
                if q < e {
                    ch = __mmio_read8(((&init_buf[0]) as u64 + q) as *mut u8) as u64
                }
                if q == e || (ch == 58 && nf < 3) {
                    fs[(nf) as usize] = start
                    fe[(nf) as usize] = q
                    nf = nf + 1
                    start = q + 1
                }
                q = q + 1
            }
            if nf >= 4 {
                // name
                var k: u64 = fs[0 as usize]
                while k < fe[0 as usize] && a < 2900 {
                    __mmio_write8((d + a) as *mut u8, __mmio_read8(((&init_buf[0]) as u64 + k) as *mut u8))
                    a = a + 1
                    k = k + 1
                }
                a = put_str(d, a, ptr((&u_tab[0]) as u64))
                // command (the rest of the line after the third colon)
                k = fs[3 as usize]
                while k < fe[3 as usize] && a < 2900 {
                    __mmio_write8((d + a) as *mut u8, __mmio_read8(((&init_buf[0]) as u64 + k) as *mut u8))
                    a = a + 1
                    k = k + 1
                }
                a = put_str(d, a, ptr((&u_tab[0]) as u64))
                // the mode word from the action
                var is_off: bool = false
                var wk: u64 = ptr((&k_m_once[0]) as u64)
                let alen: u64 = fe[2 as usize] - fs[2 as usize]
                let a0: u64 = __mmio_read8(((&init_buf[0]) as u64 + fs[2 as usize]) as *mut u8) as u64
                if alen >= 3 && a0 == 111 && __mmio_read8(((&init_buf[0]) as u64 + fs[2 as usize] + 1) as *mut u8) as u64 == 102 {
                    wk = ptr((&k_m_off[0]) as u64)
                    is_off = true
                } else if a0 == 114 {
                    wk = ptr((&k_m_resp[0]) as u64)
                } else if a0 == 99 {
                    wk = ptr((&k_m_ctrl[0]) as u64)
                }
                a = put_str(d, a, msg.get(wk))
                a = put_str(d, a, ptr((&u_tab[0]) as u64))
                // the status: a process of that name is alive
                var run: bool = false
                if !is_off {
                    // the program name: the last part of the first word of the command
                    var cs: u64 = fs[3 as usize]
                    var ce: u64 = cs
                    while ce < fe[3 as usize] && __mmio_read8(((&init_buf[0]) as u64 + ce) as *mut u8) != 32 as u8 {
                        ce = ce + 1
                    }
                    var ps: u64 = ce
                    while ps > cs && __mmio_read8(((&init_buf[0]) as u64 + ps - 1) as *mut u8) != 47 as u8 {
                        ps = ps - 1
                    }
                    var sl: u64 = 0
                    while sl < SLOTS && !run {
                        if p_lastpid[(sl) as usize] != 0 {
                            let nm: u64 = (&p_name[0]) as u64 + sl * NAMEW
                            var j: u64 = 0
                            var same: bool = true
                            while ps + j < ce {
                                if __mmio_read8((nm + j) as *mut u8) != __mmio_read8(((&init_buf[0]) as u64 + ps + j) as *mut u8) {
                                    same = false
                                }
                                j = j + 1
                            }
                            if same && j > 0 && __mmio_read8((nm + j) as *mut u8) == 0 as u8 {
                                run = true
                            }
                        }
                        sl = sl + 1
                    }
                }
                var sk: u64 = ptr((&k_t_stop[0]) as u64)
                if is_off {
                    sk = ptr((&k_t_off[0]) as u64)
                } else if run {
                    sk = ptr((&k_t_run[0]) as u64)
                }
                a = put_str(d, a, msg.get(sk))
                a = put_str(d, a, ptr((&u_nl[0]) as u64))
                st_n = st_n + 1
            }
        }
        at = e + 1
    }
}

fn build_proc(cc: usize) {
    n_kpi = fuiscene.canvas(cc, 10, CW, KH, kpi_draw)
    n_sys = n_kpi
    n_core = n_kpi
    n_disk = n_kpi
    // r461: the command bar (an icon with the word as its tooltip and accessibility name) and the sentence of the selection in
    // ONE row of 32 points, above the list: 8 + the cards + the bar + the gaps of 8 (the list is 36 points taller than with the
    // old sentence line and the text button below it)
    command_row(cc)
    n_tab = fuiscene.table_blob(cc, K_TAB, CW, BH - 16 - KH - 32 - 16, NCOL, ptr((&blob[0]) as u64))
    fuiscene.table_icons(K_TAB, ptr((&row_icons[0]) as u64))
    fuiscene.heat_key(K_TAB, 3, 4)
}

// The command bar of the pages that end a process: "End task" as an icon, and at its right the sentence about the selection.
fn command_row(cc: usize) {
    let bar: usize = fuiscene.row(cc)
    fuiscene.set_gap(bar, 8)
    fuiscene.cmd_begin()
    fuiscene.cmd_item(icons.CMD_END_TASK, K_KILL, msg.get(ptr((&k_end[0]) as u64)), 0, 0)
    let _vis: u64 = fuiscene.cmd_end(bar, 120, K_OVF)
    n_kill = fuiscene.node_of_key(K_KILL)
    n_sel = fuiscene.label(bar, ptr((&l_sel[0]) as u64))
}

fn build_perf(cc: usize) {
    let r1: usize = fuiscene.row(cc)
    fuiscene.set_gap(r1, 8)
    n_psel = fuiscene.table_list(r1, K_PSEL, 188, PSELH, 1, ptr((&psel_blob[0]) as u64))
    fuiscene.table_two(K_PSEL, true)
    fuiscene.table_single(K_PSEL, true)
    fuiscene.table_set_sel(K_PSEL, perf_sel)
    let rc: usize = fuiscene.column(r1)
    fuiscene.set_gap(rc, 8)
    n_graph = fuiscene.canvas(rc, 6, CW - 196, GH, graph_draw)
    n_stats = fuiscene.canvas(rc, 7, CW - 196, 88, stats_draw)
    n_cores = fuiscene.canvas(cc, 8, CW, BH - 16 - GH - 88 - 16, cores_draw)
}

fn build_start(cc: usize) {
    var h: u64 = BH - 16
    if st_n == 0 {
        // nothing is configured: say so instead of showing an empty frame
        let _m: usize = fuiscene.label_muted(cc, msg.get(ptr((&k_st_none[0]) as u64)))
        h = BH - 16 - 32
    }
    n_start = fuiscene.table_blob(cc, K_START, CW, h, 4, ptr((&st_blob[0]) as u64))
}

fn build_details(cc: usize) {
    command_row(cc)
    n_det = fuiscene.canvas(cc, 9, CW, BH - 16 - 32 - 8, det_draw)
}

fn build() {
    let col: usize = fuiscene.root()
    // the nodes of a page that is not shown
    n_kpi = fuiscene.NONE
    n_sys = fuiscene.NONE
    n_core = fuiscene.NONE
    n_disk = fuiscene.NONE
    n_graph = fuiscene.NONE
    n_tab = fuiscene.NONE
    n_sel = fuiscene.NONE
    n_kill = fuiscene.NONE
    n_psel = fuiscene.NONE
    n_stats = fuiscene.NONE
    n_cores = fuiscene.NONE
    n_det = fuiscene.NONE
    n_start = fuiscene.NONE
    let top: usize = fuiscene.row(col)
    fuiscene.set_gap(top, 8)
    let _nv: usize = fuiscene.table_list(top, K_NAV, NAVW, BH - 16, 1, ptr((&nav_blob[0]) as u64))
    fuiscene.table_icons(K_NAV, ptr((&nav_icons[0]) as u64))
    fuiscene.table_single(K_NAV, true)
    fuiscene.table_set_sel(K_NAV, page)
    let cc: usize = fuiscene.column(top)
    fuiscene.set_gap(cc, 8)
    if page == 0 {
        build_proc(cc)
    } else if page == 1 {
        build_perf(cc)
    } else if page == 2 {
        build_start(cc)
    } else {
        build_details(cc)
    }
}

// The place of the table's columns and the report of what is where.
fn report_layout() {
    say_rect(n_sys, 0, NK_LABEL)
    say_rect(n_core, 1, NK_LABEL)
    say_rect(n_disk, 2, NK_LABEL)
    say_rect(n_graph, 3, NK_GRAPH)
    say_rect(n_tab, 4, NK_TABLE)
    say_rect(n_sel, 5, NK_LABEL)
    say_rect(n_kill, 6, NK_BUTTON)
    if n_tab == fuiscene.NONE {
        return
    }
    z_new(ptr((&m_tab[0]) as u64))
    z_num(fuiscene.node_x(n_tab))
    z_kv(ptr((&m_y[0]) as u64), fuiscene.node_y(n_tab))
    z_kv(ptr((&m_kopfh[0]) as u64), HEAD_H)
    z_kv(ptr((&m_zh[0]) as u64), ROW_H)
    z_end()
    var sx: u64 = fuiscene.node_x(n_tab)
    var sc: u64 = 0
    while sc < NCOL {
        z_new(ptr((&m_spalte[0]) as u64))
        z_num(sc)
        z_kv(ptr((&m_x[0]) as u64), sx)
        z_kv(ptr((&m_w[0]) as u64), cols[(sc) as usize])
        z_end()
        sx = sx + cols[(sc) as usize]
        sc = sc + 1
    }
}

// The selected process in the table (or no row at all).
fn show_sel() {
    let r: u64 = row_of_pid(sel_pid)
    if sel_pid != 0 && r < SLOTS {
        fuiscene.table_set_sel(K_TAB, r)
    } else {
        fuiscene.table_set_sel(K_TAB, fuiscene.HEAD_ROW)
    }
}

fn u_start(args: u64) -> u64 {
    let takt: u64 = arg_num(args, ptr((&a_takt[0]) as u64), 1000)
    let grenze: u64 = arg_num(args, ptr((&a_runden[0]) as u64), 0)
    if arg_hat(args, ptr((&a_melde[0]) as u64)) {
        melde = 1
    }
    let nohit: bool = arg_hat(args, ptr((&a_nohit[0]) as u64))
    fuiscene.set_nohit(nohit)
    // `taskmgr performance` / `startup` / `details` opens on that page (the acceptance runs use it)
    if arg_hat(args, ptr((&a_page_perf[0]) as u64)) {
        page = 1
    } else if arg_hat(args, ptr((&a_page_start[0]) as u64)) {
        page = 2
    } else if arg_hat(args, ptr((&a_page_det[0]) as u64)) {
        page = 3
    }

    // DER KATALOG ZUERST, vor jedem Bedienelement: ein Knoten behaelt den
    // Zeiger auf seinen Text, und ein Knopf, der vor dem Katalog
    // entsteht, traegt den Schluessel statt des Wortes.
    let _mk: u64 = msg.init()
    // ============================================ RUNDE ECHTHARDWARE-6
    // DER MITSCHNITT IST EIN SCHALTER, UND DER SCHALTER STEHT IM
    // NORMALBETRIEB AUS (Justins ausgelasteter Kern: ein Programm, das im
    // Auslieferungszustand misst, misst vor allem sich selbst).
    // `taskmgr melde` schaltet ihn ein.
    sample(true)
    hist_push()
    build_head()
    build_kpi()
    build_rows()
    build_sel()
    nav_make()
    psel_make()
    stats_make()
    if page == 2 {
        st_load()
    }

    // The column widths: the fixed ones from the numbers above, the name
    // gets what is left (the table is BW - 16 wide, on the 4-point grid).
    let fix: u64 = CW_PID + CW_STATE + CW_CPU + CW_MEM + CW_CORE
    var namew: u64 = 160
    if CW > fix + 2 + 160 {
        namew = (CW - fix - 2) / 4 * 4
    }
    cols[(0) as usize] = CW_PID
    cols[(1) as usize] = namew
    cols[(2) as usize] = CW_STATE
    cols[(3) as usize] = CW_CPU
    cols[(4) as usize] = CW_MEM
    cols[(5) as usize] = CW_CORE

    if !fuiscene.open(20, 16, BW, BH,
        msg.get(ptr((&k_title[0]) as u64)), build) {
        say(ptr((&m_nowm[0]) as u64))
        ulib.nl()
        return 1
    }
    fuiscene.set_app(ptr((&t_self[0]) as u64))
    // NACH VORN, EINMAL, BEIM OEFFNEN. Der Fensterserver hebt ein
    // Fenster NICHT, wenn man es anklickt (Runde DESKTOP); ein Programm,
    // das gerade gestartet wurde, gehoert aber nach vorn.
    fuiscene.raise()
    z_new(ptr((&m_start[0]) as u64))
    z_num(BW)
    z_kv(ptr((&m_bh[0]) as u64), BH)
    z_kv(ptr((&m_wx[0]) as u64), 20)
    z_kv(ptr((&m_wy[0]) as u64), 16)
    z_end()

    var first: bool = true
    var runden: u64 = 0
    var last: u64 = info(ulib.I_TICKS)
    var gemeldet: bool = false
    while fuiscene.alive() && (grenze == 0 || runden < grenze) {
        runden = runden + 1
        let key: u64 = fuiscene.pump()
        if first {
            first = false
            var ci: u64 = 0
            while ci < NCOL {
                fuiscene.table_colw(K_TAB, ci, cols[(ci) as usize])
                ci = ci + 1
            }
            fuiscene.table_single(K_TAB, true)
            fuiscene.table_row_height(K_TAB, 32)
            fuiscene.table_hover(K_TAB, true)
            fuiscene.table_hover(K_NAV, true)
            fuiscene.table_hover(K_PSEL, true)
            fuiscene.table_row_height(K_NAV, 40)
            fuiscene.table_colw(K_START, 0, 160)
            fuiscene.table_colw(K_START, 1, 300)
            fuiscene.table_colw(K_START, 2, 96)
            fuiscene.table_colw(K_START, 3, 120)
            show_sel()
            z_new(ptr((&m_neu[0]) as u64))
            z_end()
            fuiscene.refresh()
            let _k2: u64 = fuiscene.pump()
            report_layout()
            var nm: [u8; 8] = "taskmgr\0"
            fuiscene.say_rects(ptr((&nm[0]) as u64))
            fuiscene.say_texts()
            say_cards()
            if n_graph != fuiscene.NONE {
                draw_graph(fuiscene.node_x(n_graph), fuiscene.node_y(n_graph),
                    fuiscene.node_w(n_graph), fuiscene.node_h(n_graph), true)
            }
            bericht()
            gemeldet = true
        }
        if key != 0 {
            // JEDES AUSLOESEN WIRD GEMELDET. Ohne diese Zeile ist ein
            // Klick, der nicht ankommt, nicht von einem Klick zu
            // unterscheiden, der ankommt und nichts bewirkt.
            z_new(ptr((&m_feuer[0]) as u64))
            z_num(key)
            z_kv(ptr((&m_art[0]) as u64), 0)
            z_kv(ptr((&m_idx[0]) as u64), fuiscene.table_sel(K_TAB))
            z_end()
        }
        if key == K_NAV {
            // a page of the sidebar was chosen
            let np: u64 = fuiscene.table_sel(K_NAV)
            if np < 4 && np != page {
                page = np
                if page == 2 {
                    st_load()
                }
                z_new(ptr((&m_page[0]) as u64))
                z_num(page)
                z_end()
                fuiscene.refresh()
                gemeldet = false
            }
        } else if key == K_PSEL {
            let nr: u64 = fuiscene.table_sel(K_PSEL)
            if nr < 4 {
                perf_sel = nr
                stats_make()
                fuiscene.refresh()
            }
        } else if key == K_TAB {
            let hc: u64 = fuiscene.table_head_col()
            if hc != 4294967295 {
                // Ein Klick in die Kopfzeile: nach dieser Spalte
                // sortieren. Dieselbe Spalte noch einmal dreht die
                // Richtung um.
                if hc == sort_col {
                    if sort_ab != 0 {
                        sort_ab = 0
                    } else {
                        sort_ab = 1
                    }
                } else {
                    sort_col = hc
                    sort_ab = 1
                }
                sortiere()
                build_rows()
                fuiscene.table_set_blob(K_TAB, ptr((&blob[0]) as u64))
                show_sel()
                z_new(ptr((&m_sort[0]) as u64))
                z_num(sort_col)
                z_kv(ptr((&m_ab[0]) as u64), sort_ab)
                z_end()
            } else {
                // EINE ZEILE WURDE ANGEKLICKT. Gemerkt wird die
                // PROZESSNUMMER und nicht die Zeilennummer -- eine
                // Zeilennummer zeigt nach dem naechsten Sortieren auf
                // einen anderen Prozess, und der Knopf daneben beendet
                // ihn.
                let z: u64 = fuiscene.table_sel(K_TAB)
                if z < nlive {
                    sel_pid = p_pid[(ord[(z) as usize]) as usize]
                    build_sel()
                    z_new(ptr((&m_wahl[0]) as u64))
                    z_num(sel_pid)
                    z_end()
                    fuiscene.refresh()
                }
            }
        } else if key == K_KILL {
            ask()
        } else if key == fuiscene.KEY_DIALOG {
            let res: u64 = fuiscene.dialog_result()
            if ask_pid != 0 {
                if res == 1 {
                    toeten()
                }
                ask_pid = 0
                build_sel()
                show_sel()
                fuiscene.refresh()
            }
        }
        let jetzt: u64 = info(ulib.I_TICKS)
        if jetzt >= last + takt / 10 {
            last = jetzt
            sample(false)
            hist_push()
            build_head()
            build_kpi()
            build_rows()
            psel_make()
            stats_make()
            if page == 2 {
                st_load()
                fuiscene.table_set_blob(K_START, ptr((&st_blob[0]) as u64))
            }
            if sel_pid != 0 && row_of_pid(sel_pid) >= SLOTS {
                sel_pid = 0
            }
            build_sel()
            if page == 0 {
                fuiscene.table_set_blob(K_TAB, ptr((&blob[0]) as u64))
                show_sel()
            }
            // DIE MARKE VOR DEM NEUMALEN. `tools/themestore/shotcheck.py`
            // nimmt alles NACH der letzten Marke als das Bild, das
            // gerade steht.
            z_new(ptr((&m_neu[0]) as u64))
            z_end()
            fuiscene.refresh()
            gemeldet = false
        } else if !gemeldet && fuiscene.painted() > 0 {
            // The picture after the last update is on the screen: say
            // where things are and what is in the graph.
            gemeldet = true
            if melde != 0 || fuiscene.trace_on() {
                var nm2: [u8; 8] = "taskmgr\0"
                fuiscene.say_rects(ptr((&nm2[0]) as u64))
                fuiscene.say_texts()
                say_cards()
                if n_graph != fuiscene.NONE {
                    draw_graph(fuiscene.node_x(n_graph), fuiscene.node_y(n_graph),
                        fuiscene.node_w(n_graph), fuiscene.node_h(n_graph), true)
                }
            }
            if melde != 0 {
                bericht()
            }
        }
    }
    bericht()
    return 0
}

fn ask() {
    if sel_pid == 0 || ask_pid != 0 {
        return
    }
    let d: u64 = (&ask[0]) as u64
    var a: u64 = 0
    a = put_str(d, a, msg.get(ptr((&k_asktext[0]) as u64)))
    a = put_str(d, a, ptr((&u_sp[0]) as u64))
    let r: u64 = row_of_pid(sel_pid)
    if r < SLOTS {
        a = put_str(d, a, name_of(ord[(r) as usize]))
        a = put_str(d, a, ptr((&u_sp[0]) as u64))
    }
    a = put_str(d, a, ptr((&u_op[0]) as u64))
    a = put_num(d, a, sel_pid)
    a = put_str(d, a, ptr((&u_cl[0]) as u64))
    a = put_str(d, a, ptr((&u_q[0]) as u64))
    fuiscene.dialog_open(msg.get(ptr((&k_asktitle[0]) as u64)), d,
        ptr((&t_ok[0]) as u64), ptr((&t_abbr[0]) as u64))
    ask_pid = sel_pid
    z_new(ptr((&m_ask[0]) as u64))
    z_num(ask_pid)
    z_end()
    // where the answer button stands (for the click tests)
    z_new(ptr((&m_dlg[0]) as u64))
    z_num(fuiscene.dialog_ok_x())
    z_kv(ptr((&m_y[0]) as u64), fuiscene.dialog_ok_y())
    z_kv(ptr((&m_w[0]) as u64), fuiscene.dialog_ok_w())
    z_kv(ptr((&m_h[0]) as u64), fuiscene.dialog_ok_h())
    z_end()
}

// GENAU DER AUFRUF AUS /bin/kill, mit demselben Code. 137 ist 128 + 9,
// die Zahl, die ein System mit einem SIGKILL hinterliesse. Der Kernel
// entscheidet, ob es erlaubt ist (`sys.kill_allowed`, Runde K13: nur
// eigene Prozesse), und ein Fehler wird GEMELDET und nicht verschluckt.
fn toeten() {
    let rc: u64 = ulib.sys(ulib.SYS_KILL, ask_pid, 137, 0)
    z_new(ptr((&m_kill[0]) as u64))
    z_num(ask_pid)
    z_kv(ptr((&m_rc[0]) as u64), rc)
    z_end()
    if sel_pid == ask_pid {
        sel_pid = 0
    }
}

// RUNDE ROTABSCHNITTE: DIESES `main` LAEUFT, UND ES MUSS DIE
// ARGUMENTE WEITERGEBEN.
//
// Der Kommentar, der hier stand, sagte "das `main`, das nie laeuft --
// `user.ld` springt nach `u_start`". Das stimmt fuer ein Programm, das
// mit `kernel/user/crt.s` gebunden ist; dessen `_start` ruft
// USER_ENTRY. Unter `profile app` stimmt es NICHT: dort bringt firnc
// sein eigenes `_start` mit (darum darf crt.o nicht dazu, siehe
// tools/look/shot.sh), und das endet in `call main` -- der Name steht
// fest in lib/firnc1/codegen.fi, `--defsym=USER_ENTRY` erreicht ihn
// nicht. Am gebauten ELF nachgesehen: Einsprung ist `_start`, sechs
// Befehle weiter steht `call <main>`; `_F0.u_start` wird von dort nie
// gerufen.
//
// `u_start(0)` warf damit den Argumentblock weg. Bei powermon waren
// das 54 rote Zusagen (siehe ROTABSCHNITTE 11/n).
//
// Der Block liegt an einer FESTEN Adresse: Runde K16 legte den
// Stapelzeiger darauf (kernel/elf.fi, `T_USTACK = proc.ARGS_BASE`),
// und firnc's `_start` macht `mov rsp, rdi`. Jede `elf: start`-Zeile
// dieses Systems druckt sie als `ustack=0x4007f000`.
fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
