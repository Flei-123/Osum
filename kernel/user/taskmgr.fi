// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/taskmgr.fi -- RUNDE WERKZEUGE: DER AUFGABENVERWALTER.
//
// Osum hatte `ps`, `top`, `kill`, `speicher`, `df`, `netmon` und
// `powermon` -- sieben Programme, die alle etwas ueber die laufende
// Maschine wissen, und alle sieben schreiben Zeilen in ein Terminal.
// Was fehlte, ist das Fenster, das ein Mensch aufmacht, wenn etwas
// haengt: eine Liste, in der man eine Zeile ANKLICKT, und ein Knopf,
// der sie beendet.
//
// ------------------------------------------------------------------
// DIE REGEL DIESER DATEI: KEINE ZAHL IST VON DIESEM PROGRAMM
//
// Dieselbe Regel wie in /bin/power und /bin/dispctl, und hier ist sie
// wichtiger als dort, weil ein Aufgabenverwalter die Zahlen ZEIGT und
// nicht nur meldet. Jede Zahl kommt aus demselben Systemaufruf, den
// auch das Kommandozeilenwerkzeug daneben benutzt:
//
//   Prozessliste     SYS_PSTAT, ein Feld je Aufruf -- wie `/bin/ps`
//                    und `/bin/top` seit Runde K6.
//   Name             SYS_PMON, Art 2 -- dieselbe Quelle, aus der
//                    `/bin/powermon` die Programmnamen nimmt. Der
//                    Kernel setzt ihn an EINER Stelle (`elf.fi`, beim
//                    Einsprung), also gibt es keinen zweiten Namen.
//   Speicher         SYS_PSTAT, P_PAGES -- neu in dieser Runde, gezaehlt
//                    aus DENSELBEN Seitentabellen, die `proc.free_space`
//                    beim Beenden zurueckgibt.
//   Kern             SYS_PSTAT, P_CPU -- neu, aus dem Feld, das der
//                    Aufgabenwechsel schreibt.
//   je Kern          SYS_CPUSTAT -- neu; `C_TICKS` gab es seit Runde K5,
//                    `C_IDLETICKS` kam in dieser Runde dazu, weil eine
//                    Auslastung ohne Leerlaufzaehler nicht ausrechenbar
//                    ist.
//   Speicher gesamt  SYS_SYSINFO, I_FRAMES_* -- wie `/bin/top`.
//   Platte           SYS_SYSINFO, I_BLOCKS/I_BFREE/I_BSIZE -- wie
//                    `/bin/df`.
//   Netz             SYS_NETMON, NM_SYSTX/NM_SYSRX -- wie `/bin/netmon`.
//   Betriebszeit     SYS_SYSINFO, I_UPTIME -- wie `/bin/top`.
//   Beenden          SYS_KILL, genau der Aufruf aus `/bin/kill`, mit
//                    demselben Code 137.
//
// WAS DIESES PROGRAMM SELBST RECHNET, sind Differenzen und Prozente:
// die Auslastung ist (Schlaege - Leerlauf) / Schlaege zwischen ZWEI
// Messungen, und das gehoert nach Ring 3, weil hier der Zeitpunkt
// beider Messungen bekannt ist.
//
// ------------------------------------------------------------------
// WARUM DER ANTEIL EINES PROZESSES SICH AUF DIE GANZE MASCHINE BEZIEHT
//
// Vier Kerne schlagen viermal in der Sekunde hundertmal; ein Prozess,
// der einen Kern voll belegt, bekommt hundert Schlaege von vierhundert.
// Dieses Programm zeigt 25 % und nicht 100 %, und der Grund ist die
// Spalte darueber: die Summe der Zeilen soll die Auslastung des Kopfes
// ergeben. `top` unter Linux zeigt die andere Zahl und muss dafuer
// erklaeren, warum acht Prozesse zusammen 800 % haben.
//
// ------------------------------------------------------------------
// DIE LEERLAUFAUFGABEN STEHEN MIT IN DER LISTE
//
// Genau wie in `ps`. Sie mit ihrer typischen Auslastung von 90 % zu
// verstecken, waere die bequeme Anzeige -- und die Summe der uebrigen
// Zeilen ergaebe dann nicht mehr die Zahl im Kopf. Wer sie sieht, sieht
// die Maschine.
//
// ------------------------------------------------------------------
// DER VERLAUFSGRAPH IST SELBST GEMALT
//
// Sechzig Messpunkte, zwei Kurven, gezeichnet mit `wlibc.rrect`,
// `wlibc.px` und `wlibc.hline` in genau demselben Streifenverfahren,
// das `wlib.flush_rect` benutzt: Streifen setzen, beschneiden, malen,
// hinueberschieben. Es gibt keine Bibliothek dafuer und diese Runde
// baut auch keine -- ein Graph ist eine Schleife ueber sechzig Zahlen.
//
// ZWEI KURVEN, DREI UNTERSCHIEDE. Farbe allein taugt nicht (dieselbe
// Feststellung wie bei den Kacheln der Schnelleinstellungen): die
// Prozessorkurve ist ZWEI Bildpunkte dick und durchgezogen, die
// Speicherkurve ist einen dick und GESTRICHELT, und daneben steht in
// Worten, welche welche ist.
//
// ------------------------------------------------------------------
// DIE FARBEN KOMMEN AUS DEN ROLLEN, NIE AUS ZAHLEN
//
// `wlibc.theme_semantic(S_*)` und `wlibc.theme(T_*)`, kein einziger
// Farbwert im Quelltext. Sonst waere der Dunkelmodus kaputt und die
// Kontrastpruefung (tools/themestore/run.sh) haette recht damit.
//
// ------------------------------------------------------------------
// AUFRUF
//
//     taskmgr                       das Fenster
//     taskmgr takt N                Millisekunden zwischen zwei Messungen
//     taskmgr runden N              nach N Durchlaeufen von selbst enden
//     taskmgr melde                 jeden Durchlauf auf die serielle
//                                   Leitung -- Kopf, Kerne, jede Zeile,
//                                   jeder Messpunkt des Graphen
//     taskmgr nohit                 die Gegenprobe von `wlib`: keine
//                                   Trefferpruefung, also kein Klick

// RUNDE ABBILD: PROFIL `app`, WEIL `wlib` JETZT fUi BENUTZT.
//
// Dieses Programm stand auf `profile kernel`, und das ging, solange
// `wlib` nur wlibc malte. Seit Runde 31 kommen die Bedienelemente aus
// fUi, und fUi rechnet in f64 und benutzt `std.rt` -- beides ist unter
// `kernel` gesperrt:
//
//     error: the module 'std.rt' belongs to the standard library and
//     is not available in profile 'kernel'   (fui/theme.fi:81)
//
// Aufgefallen ist es erst beim Bauen des USB-Abbilds: `tools/look/shot.sh`
// baut den Taskmanager nicht mit, `tools/usbimg/build.sh` schon. Alle
// anderen Programme mit Oberflaeche (desktop, taskbar, settings,
// launcher, explorer, widgetdemo) stehen seit Runde 31 auf `app`; dieses
// hier ist das letzte, das nachzieht.
profile app

import ulib
import libc.io
import wlibc
import wlib
import icons
import msg
import fuiscene
import fui.navnum

export { u_start }

// ------------------------------------------------------------- Zahlen

const SLOTS: u64 = 32 // kstate.MAX_TASKS
const MAXCPU: u64 = 8 // kstate.MAX_CPUS
const NCOL: u64 = 6
const HIST: u64 = 60 // Messpunkte des Graphen
const NAMEW: u64 = 24 // pmon.NAME_MAX

// ==================================================== RUNDE MERGE-6
// JEDE LAENGE HIER LIEGT AUF DEM VIERERRASTER DER RUNDE OBERFLAECHE.
//
// Dieses Programm ist auf einem Zweig entstanden, der die Runde
// OBERFLAECHE nicht kannte, und hat seine Zahlen deshalb so getippt,
// wie sie gerade passten. Beim Zusammenfuehren sind drei davon
// aufgefallen -- 62, 82 und noch einmal 62 -- und sie sind nicht
// harmlos: die Spaltenbreiten stehen in JEDEM Rechteck, das die
// Tabelle meldet, und `tools/design/messen.py` zaehlt genau diese
// Zahlen. Drei krumme Spalten in einem Fenster mit sechs Spalten
// ziehen den Rasteranteil des ganzen Standes nach unten.
//
// GEMESSEN (tools/design/messen.py, siehe docs/RUNDE-MERGE6.md):
//   62 / 4 = 15,5   82 / 4 = 20,5   -- beide daneben
//   64 / 4 = 16     84 / 4 = 21     -- beide darauf
//
// Die uebrigen drei Zahlen (752, 524, 116) lagen schon richtig; sie
// gehen jetzt trotzdem durch `wlibc.snap_up`, damit die naechste
// Aenderung nicht wieder danebenfaellt. Eine Regel, die nur im
// Kommentar steht, haelt genau bis zur naechsten Runde -- das ist die
// Lehre aus BLECHKERN, eine Etage hoeher.
// r443 (D-013): a sidebar of pages on the left (Processes, Performance, Startup, Details), the content right of it
const BW: u64 = 880
const BH: u64 = 580
const NAVW: u64 = 176 // the sidebar
const CW: u64 = 680 // BW - 16 - NAVW - 8: the width of a page
const GH: u64 = 250 // the history graph of the performance page
const KH: u64 = 92 // r402: Hoehe der vier Karten

// Die Spalten, die keinen Text tragen, der wachsen kann. Der Name
// bekommt, was uebrig bleibt -- so passt die Tabelle auch, wenn die
// Design-Runde die Abstaende aendert.
const CW_PID: u64 = 64
const CW_STATE: u64 = 104
const CW_CPU: u64 = 104
const CW_MEM: u64 = 128
const CW_CORE: u64 = 64

