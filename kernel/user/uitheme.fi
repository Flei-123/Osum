const T_MENU: u64 = 17

const T_COUNT: u64 = thtokens.T_COUNT

fn theme(i: u64) -> u64 {
    if i >= thtokens.C_COUNT {
        return 0
    }
    return thtokens.tok[(thtokens.paint_base + i) as usize]
}

