profile kernel

import wlibc.wcbase

const T_BG: u64 = 0

const T_FG: u64 = 1

const T_DIM: u64 = 2

const T_PANEL: u64 = 3

const T_BTN: u64 = 4

const T_BTNHI: u64 = 5

const T_BTNDN: u64 = 6

const T_LINE: u64 = 7

const T_SEL: u64 = 8

const T_SELFG: u64 = 9

const T_FOCUS: u64 = 10

const T_ENTRY: u64 = 11

const T_HEAD: u64 = 12

const T_SCROLL: u64 = 13

const T_THUMB: u64 = 14

const T_ACCENT: u64 = 15

const T_DLG: u64 = 16

const T_MENU: u64 = 17

const T_COUNT: u64 = wcbase.T_COUNT

fn theme(i: u64) -> u64 {
    if i >= wcbase.C_COUNT {
        return 0
    }
    return wcbase.tok[(wcbase.paint_base + i) as usize]
}
