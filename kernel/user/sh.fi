// kernel/user/sh.fi -- round K6: a shell that is one.
//
// Round K1 made the shell a FILE: it read a line, split it into words and
// started `/bin/<word>`. That was the point of that round and it was
// enough for it. It is not a shell. A shell is the program that decides
// WHERE a program's output goes and WHAT it reads, and round K1 had no
// answer to either: every program wrote to the serial port and read the
// console, because the kernel had one of each.
//
// What this one can do, and every one of them is measured in
// `tools/userland/run.sh`:
//
//   * `cmd a b c`, and the words may be quoted: 'a b' and "a b" are one
//     argument, and "$X" is one argument even when the value has a space
//     in it.
//   * `> file`, `>> file`, `< file`, `2> file`. The shell redirects
//     ITSELF and the child is born into it (`kernel/uio.fi`,
//     `exec` hands the three descriptors on) -- which is why redirection
//     also works for the built-in commands, without one line for it.
//   * `a | b | c`. THE HONEST PART: there is no `pipe()` in this kernel
//     yet -- round K4 is building it -- so a pipe is STAGED THROUGH A
//     FILE: `a > /tmp/sh0`, then `b < /tmp/sh0 > /tmp/sh1`, and so on.
//     The output is the same, the two ends do not run at the same time,
//     and a program that never ends would fill the disk instead of
//     blocking its writer. It says so in docs/ROUNDK6.md.
//   * `cmd &`: the child is not waited for. `wait` picks the corpses up,
//     and `exit` waits for what is left -- a shell that left zombies
//     behind would leak a page table per background job.
//   * `$?`, `NAME=value`, `$NAME`, `${...}` is NOT there.
//   * `cd`, `pwd`, `export`, `exit`, `wait` as built-in commands, because
//     none of them can be a program: a child cannot change its parent's
//     working directory.
//   * A LINE EDITOR: 8 takes the last octet back, 14 (the up arrow, see
//     `kernel/kbd.fi`) fetches the line before this one back. The
//     kernel eats the backspace itself when the input is a keyboard; in a
//     SCRIPT both of them arrive here, which is how the editor is
//     measured without a person in front of the machine.
//   * `sh /path/to/script`: the commands come out of a file, and then the
//     shell is quiet -- no banner, no prompt, no exit code per command.
//     Round K1's chatter is what an INTERACTIVE shell does, and
//     `tools/osum/run.sh` still measures exactly that.

profile kernel

import ulib

export { u_start }

const LINE: u64 = 256
const MAX_TOK: u64 = 48
const MAX_ARGS: u64 = 8 // what `exec` takes (proc.MAX_ARGS)
const WORD_SPACE: u64 = 768
const NVAR: u64 = 8
const VNAME: u64 = 16
const VVAL: u64 = 64
const NBG: u64 = 8
const MAX_STAGE: u64 = 4

// The kinds of token. Everything that is not one of the operators is a
// word, and a word has been through the quotes and the variables already.
const K_WORD: u64 = 0
const K_PIPE: u64 = 1
const K_IN: u64 = 2
const K_OUT: u64 = 3
const K_APP: u64 = 4
const K_ERR: u64 = 5
const K_AMP: u64 = 6
const K_SEMI: u64 = 7

// A program on this system has no allocator. Everything the shell needs
// while it works stands here, in the .bss the loader zeroed.
static mut line: [u8; 256] = [0 as u8; 256]
static mut prev: [u8; 256] = [0 as u8; 256]
static mut words: [u8; 768] = [0 as u8; 768]
static mut tok_kind: [u64; 48] = [0 as u64; 48]
static mut tok_at: [u64; 48] = [0 as u64; 48]
static mut ntok: u64 = 0
static mut wat: u64 = 0
static mut vname: [u8; 128] = [0 as u8; 128]
static mut vval: [u8; 512] = [0 as u8; 512]
static mut vexp: [u64; 8] = [0 as u64; 8]
static mut nvar: u64 = 0
static mut status: u64 = 0
static mut bg_pid: [u64; 8] = [0 as u64; 8]
static mut nbg: u64 = 0
static mut argv: [u64; 8] = [0 as u64; 8]
static mut argc: u64 = 0
static mut path: [u8; 128] = [0 as u8; 128]
static mut rctx: [u8; 528] = [0 as u8; 528]
static mut interactive: u64 = 0
static mut in_fd: u64 = 0
static mut commands: u64 = 0
static mut tmp_ready: u64 = 0
static mut scratch: [u8; 128] = [0 as u8; 128]
static mut leaving: u64 = 0
static mut did_run: u64 = 0
static mut last_bg: u64 = 0
// ROUND K4 CHANGED WHAT `close` MEANS, and this is the whole of what it
// cost. Round K6 was written against a kernel in which the three standard
// descriptors were a piece of per-task state and `close(1)` gave 1 back
// to the console -- which is how this shell used to take its output back
// after `ls > /out`. Round K4 built a real table of open files, in which
// `close(1)` frees the slot and the next `open` gets it: the second
// redirection of a run would have landed on descriptor 1 by accident.
// So the shell does what every Unix shell has done since 1979 -- it keeps
// a COPY of its own three and points them back with `dup2`.
static mut save_in: u64 = 0
static mut save_out: u64 = 0
static mut save_err: u64 = 0

fn u_start(args: u64) -> u64 {
    var s_hi: [u8; 17] = "sh: ready, osum\n\0"
    var s_bye: [u8; 9] = "sh: bye\n\0"
    var s_nofile: [u8; 19] = "sh: cannot read \0\0\0"

    // Before the script is opened, so that the copies get the low numbers
    // and nothing that comes later can be handed one of them.
    save_in = ulib.sys(ulib.SYS_DUP, ulib.IN, 0, 0)
    save_out = ulib.sys(ulib.SYS_DUP, ulib.OUT, 0, 0)
    save_err = ulib.sys(ulib.SYS_DUP, ulib.ERR, 0, 0)
    ulib.rd_init((&rctx[0 as usize]) as u64)
    in_fd = ulib.IN
    interactive = 1
    let ac: u64 = ulib.arg_count(args)
    if ac > 1 {
        let p: u64 = ulib.arg_at(args, 1)
        let fd: u64 = ulib.sys(ulib.SYS_OPEN, p, 0, 0)
        if ulib.bad(fd) {
            ulib.esay_line((&s_nofile[0 as usize]) as u64, p)
            return 127
        }
        in_fd = fd
        interactive = 0
        // `$0` ist das Skript, `$1` das erste Argument dahinter -- so wie
        // ueberall.
        var k: u64 = 1
        npos = 0
        while k < ac && k - 1 < NPOS {
            pos_set(k - 1, ulib.arg_at(args, k))
            npos = k
            k = k + 1
        }
        // RUNDE K11: ein Skript wird als GANZES gelesen und in
        // Anweisungen zerlegt. Nur so kann ein `if` ueber mehrere Zeilen
        // gehen. Der interaktive Weg darunter bleibt der von Runde K1.
        let rc: u64 = run_script(in_fd)
        ulib.sys(ulib.SYS_CLOSE, in_fd, 0, 0)
        reap_all()
        return rc
    }
    if interactive == 1 {
        ulib.say((&s_hi[0 as usize]) as u64)
    }
    var running: bool = true
    while running {
        let n: u64 = get_line(in_fd)
        if ulib.bad(n) {
            running = false
        } else {
            if interactive == 1 {
                prompt()
                ulib.say((&line[0 as usize]) as u64)
                ulib.nl()
            }
            if n > 0 {
                if !run_line() {
                    running = false
                }
            }
        }
    }
    reap_all()
    if interactive == 1 {
        ulib.say((&s_bye[0 as usize]) as u64)
        if leaving == 0 {
            return commands
        }
    }
    // A shell that ran a script ends with the code of the last command in
    // it, and `exit 3` means 3. Only the interactive shell of round K1
    // still counts its commands.
    return status
}

fn prompt() {
    var s_p: [u8; 7] = "osum$ \0"
    ulib.say((&s_p[0 as usize]) as u64)
}

// --------------------------------------------------------- the line

// One line, with the two keys of a line editor in it. The kernel already
// takes the backspace back when the input is a real keyboard
// (`sys.keyboard_read`); everything that comes out of a FILE arrives
// here untouched, and that is where the measurement gets at it.
fn get_line(fd: u64) -> u64 {
    var c: u64 = ulib.rd_byte(fd, (&rctx[0 as usize]) as u64)
    if c == 256 {
        return ulib.EOF
    }
    var n: u64 = 0
    while c != 256 && c != 10 {
        if c == 8 {
            if n > 0 {
                n = n - 1
            }
        } else if c == 14 {
            n = 0
            while prev[n as usize] != 0 as u8 && n + 1 < LINE {
                line[n as usize] = prev[n as usize]
                n = n + 1
            }
        } else {
            if n + 1 < LINE {
                line[n as usize] = c as u8
                n = n + 1
            }
        }
        c = ulib.rd_byte(fd, (&rctx[0 as usize]) as u64)
    }
    line[n as usize] = 0 as u8
    if n > 0 {
        var i: u64 = 0
        while i <= n {
            prev[i as usize] = line[i as usize]
            i = i + 1
        }
    }
    return n
}

// ------------------------------------------------------ the variables

fn var_find(name: u64) -> u64 {
    var i: u64 = 0
    while i < nvar {
        if ulib.streq((&vname[(i * VNAME) as usize]) as u64, name) {
            return i
        }
        i = i + 1
    }
    return NVAR
}

fn var_get(name: u64) -> u64 {
    let i: u64 = var_find(name)
    if i >= NVAR {
        return 0
    }
    return (&vval[(i * VVAL) as usize]) as u64
}

fn var_set(name: u64, value: u64) {
    var i: u64 = var_find(name)
    if i >= NVAR {
        if nvar >= NVAR {
            return
        }
        i = nvar
        nvar = nvar + 1
        ulib.strncpy((&vname[(i * VNAME) as usize]) as u64, name, VNAME)
        vexp[i as usize] = 0
    }
    var k: u64 = 0
    while k + 1 < VVAL && *((value + k) as *mut u8) != 0 as u8 {
        vval[(i * VVAL + k) as usize] = *((value + k) as *mut u8)
        k = k + 1
    }
    vval[(i * VVAL + k) as usize] = 0 as u8
}

// ------------------------------------------------------- the tokenizer

fn ch(i: u64) -> u64 {
    if i >= LINE {
        return 0
    }
    return (line[i as usize]) as u64
}

fn put_word(c: u64) {
    if wat + 1 < WORD_SPACE {
        words[wat as usize] = c as u8
        wat = wat + 1
    }
}

fn push_tok(kind: u64, at: u64) {
    if ntok >= MAX_TOK {
        return
    }
    tok_kind[ntok as usize] = kind
    tok_at[ntok as usize] = at
    ntok = ntok + 1
}

fn is_name(c: u64) -> bool {
    if c >= 48 && c <= 57 {
        return true
    }
    if c >= 65 && c <= 90 {
        return true
    }
    if c >= 97 && c <= 122 {
        return true
    }
    return c == 95
}

// `$?` is the code of the last command, `$NAME` a variable, and a `$` in
// front of anything else is a `$`. The value is written into the word
// that is being built, so a variable with a space in it stays ONE
// argument only inside quotes -- which is exactly the rule every shell
// has, and the reason "$X" and $X are different.
fn expand(i: u64) -> u64 {
    var name: [u8; 20] = [0 as u8; 20]
    if ch(i + 1) == 33 {
        var buf: [u8; 26] = [0 as u8; 26]
        let n: u64 = ulib.digits(last_bg, (&buf[0 as usize]) as u64)
        var k: u64 = 0
        while k < n {
            put_word((buf[k as usize]) as u64)
            k = k + 1
        }
        return i + 2
    }
    if ch(i + 1) == 63 {
        var buf: [u8; 26] = [0 as u8; 26]
        let n: u64 = ulib.digits(status, (&buf[0 as usize]) as u64)
        var k: u64 = 0
        while k < n {
            put_word((buf[k as usize]) as u64)
            k = k + 1
        }
        return i + 2
    }
    // RUNDE K11: `$#` ist die Zahl der Stellungsparameter, `$0`..`$9`
    // sind sie selbst, und `${NAME}` ist `$NAME` mit Klammern -- das
    // braucht man, sobald hinter dem Namen ein Buchstabe steht
    // (`${X}abc`).
    if ch(i + 1) == 35 {
        var buf: [u8; 26] = [0 as u8; 26]
        var many: u64 = 0
        if npos > 0 {
            many = npos - 1
        }
        let n: u64 = ulib.digits(many, (&buf[0 as usize]) as u64)
        var k: u64 = 0
        while k < n {
            put_word((buf[k as usize]) as u64)
            k = k + 1
        }
        return i + 2
    }
    if ch(i + 1) >= 48 && ch(i + 1) <= 57 {
        let v0: u64 = pos_get(ch(i + 1) - 48)
        if v0 != 0 {
            var k: u64 = 0
            while *((v0 + k) as *mut u8) != 0 as u8 {
                put_word((*((v0 + k) as *mut u8)) as u64)
                k = k + 1
            }
        }
        return i + 2
    }
    if ch(i + 1) == 123 {
        var name2: [u8; 20] = [0 as u8; 20]
        var at2: u64 = i + 2
        var n2: u64 = 0
        while is_name(ch(at2)) && n2 + 1 < 20 {
            name2[n2 as usize] = ch(at2) as u8
            n2 = n2 + 1
            at2 = at2 + 1
        }
        name2[n2 as usize] = 0 as u8
        if ch(at2) == 125 {
            at2 = at2 + 1
        }
        let v2: u64 = var_get((&name2[0 as usize]) as u64)
        if v2 != 0 {
            var k: u64 = 0
            while *((v2 + k) as *mut u8) != 0 as u8 {
                put_word((*((v2 + k) as *mut u8)) as u64)
                k = k + 1
            }
        }
        return at2
    }
    if !is_name(ch(i + 1)) {
        put_word(36)
        return i + 1
    }
    var at: u64 = i + 1
    var n: u64 = 0
    while is_name(ch(at)) && n + 1 < 20 {
        name[n as usize] = ch(at) as u8
        n = n + 1
        at = at + 1
    }
    name[n as usize] = 0 as u8
    let v: u64 = var_get((&name[0 as usize]) as u64)
    if v != 0 {
        var k: u64 = 0
        while *((v + k) as *mut u8) != 0 as u8 {
            put_word((*((v + k) as *mut u8)) as u64)
            k = k + 1
        }
    }
    return at
}

fn is_break(c: u64) -> bool {
    if c == 0 || c == 32 || c == 9 {
        return true
    }
    return c == 124 || c == 60 || c == 62 || c == 38 || c == 59
}

// The whole line into tokens. Returns false when it is broken -- an
// unterminated quote is the only way that happens.
fn tokenize() -> bool {
    var s_quote: [u8; 26] = "sh: unterminated quote\0\0\0\0"
    ntok = 0
    wat = 0
    var i: u64 = 0
    var going: bool = true
    while going {
        while ch(i) == 32 || ch(i) == 9 {
            i = i + 1
        }
        let c: u64 = ch(i)
        if c == 0 || c == 35 {
            going = false
        } else if c == 124 {
            push_tok(K_PIPE, 0)
            i = i + 1
        } else if c == 60 {
            push_tok(K_IN, 0)
            i = i + 1
        } else if c == 38 {
            push_tok(K_AMP, 0)
            i = i + 1
        } else if c == 59 {
            push_tok(K_SEMI, 0)
            i = i + 1
        } else if c == 62 {
            if ch(i + 1) == 62 {
                push_tok(K_APP, 0)
                i = i + 2
            } else {
                push_tok(K_OUT, 0)
                i = i + 1
            }
        } else if c == 50 && ch(i + 1) == 62 {
            push_tok(K_ERR, 0)
            i = i + 2
        } else {
            let start: u64 = wat
            var open: bool = true
            while open {
                let d: u64 = ch(i)
                if is_break(d) {
                    open = false
                } else if d == 39 {
                    i = i + 1
                    while ch(i) != 39 && ch(i) != 0 {
                        put_word(ch(i))
                        i = i + 1
                    }
                    if ch(i) == 0 {
                        ulib.esay_line((&s_quote[0 as usize]) as u64, 0)
                        return false
                    }
                    i = i + 1
                } else if d == 34 {
                    i = i + 1
                    while ch(i) != 34 && ch(i) != 0 {
                        if ch(i) == 36 {
                            i = expand(i)
                        } else {
                            put_word(ch(i))
                            i = i + 1
                        }
                    }
                    if ch(i) == 0 {
                        ulib.esay_line((&s_quote[0 as usize]) as u64, 0)
                        return false
                    }
                    i = i + 1
                } else if d == 36 {
                    i = expand(i)
                } else {
                    put_word(d)
                    i = i + 1
                }
            }
            put_word(0)
            push_tok(K_WORD, start)
        }
    }
    return true
}

fn word_at(t: u64) -> u64 {
    return (&words[(tok_at[t as usize]) as usize]) as u64
}

// ------------------------------------------------------------ running

// One line: split at `;` and `&`, and run each piece. Returns false when
// `exit` was one of them.
fn run_line() -> bool {
    if !tokenize() {
        status = 2
        return true
    }
    var i: u64 = 0
    while i < ntok {
        var j: u64 = i
        var bg: bool = false
        while j < ntok && tok_kind[j as usize] != K_SEMI
        && tok_kind[j as usize] != K_AMP {
            j = j + 1
        }
        if j < ntok && tok_kind[j as usize] == K_AMP {
            bg = true
        }
        if j > i {
            commands = commands + 1
            if !run_pipeline(i, j, bg) {
                return false
            }
        }
        i = j + 1
    }
    return true
}

// The temporary files a pipe is staged through. They are made when the
// first pipe of the run needs them and not before: an image without a
// pipe in it must look exactly the way round K1 left it.
fn tmp_path(k: u64) -> u64 {
    var t0: [u8; 9] = "/tmp/sh0\0"
    var t1: [u8; 9] = "/tmp/sh1\0"
    var dir: [u8; 5] = "/tmp\0"
    if tmp_ready == 0 {
        ulib.sys(ulib.SYS_MKDIR, (&dir[0 as usize]) as u64, 0, 0)
        tmp_ready = 1
    }
    if k % 2 == 0 {
        ulib.strcpy((&scratch[0 as usize]) as u64, (&t0[0 as usize]) as u64)
    } else {
        ulib.strcpy((&scratch[0 as usize]) as u64, (&t1[0 as usize]) as u64)
    }
    return (&scratch[0 as usize]) as u64
}

// `a | b | c` between the tokens `from` and `to`. Every stage but the
// last writes into a file that the next one reads.
fn run_pipeline(from: u64, to: u64, bg: bool) -> bool {
    var stage_in: [u8; 128] = [0 as u8; 128]
    var stage_out: [u8; 128] = [0 as u8; 128]
    var stages: u64 = 1
    var t: u64 = from
    while t < to {
        if tok_kind[t as usize] == K_PIPE {
            stages = stages + 1
        }
        t = t + 1
    }
    if stages > MAX_STAGE {
        var s_deep: [u8; 24] = "sh: too many stages\0\0\0\0\0"
        ulib.esay_line((&s_deep[0 as usize]) as u64, 0)
        status = 2
        return true
    }
    var start: u64 = from
    var k: u64 = 0
    var alive: bool = true
    while k < stages {
        var end: u64 = start
        while end < to && tok_kind[end as usize] != K_PIPE {
            end = end + 1
        }
        stage_in[0 as usize] = 0 as u8
        stage_out[0 as usize] = 0 as u8
        if k > 0 {
            ulib.strcpy((&stage_in[0 as usize]) as u64, tmp_path(k - 1))
        }
        if k + 1 < stages {
            ulib.strcpy((&stage_out[0 as usize]) as u64, tmp_path(k))
        }
        let last: bool = k + 1 == stages
        if !run_stage(start, end, (&stage_in[0 as usize]) as u64,
            (&stage_out[0 as usize]) as u64, bg && last) {
            alive = false
        }
        start = end + 1
        k = k + 1
    }
    if stages > 1 {
        var d: u64 = 0
        while d + 1 < stages {
            ulib.sys(ulib.SYS_UNLINK, tmp_path(d), 0, 0)
            d = d + 1
        }
    }
    return alive
}

// One command: the words are the arguments, everything after a `<`, `>`,
// `>>` or `2>` is a file name. `pin`/`pout` are what the pipeline asks
// for and an explicit redirection wins over them.
fn run_stage(from: u64, to: u64, pin: u64, pout: u64, bg: bool) -> bool {
    var f_in: [u8; 96] = [0 as u8; 96]
    var f_out: [u8; 96] = [0 as u8; 96]
    var f_err: [u8; 96] = [0 as u8; 96]
    var s_what: [u8; 22] = "sh: missing file name\0"
    var s_many: [u8; 26] = "sh: too many arguments\0\0\0\0"
    var append: bool = false
    argc = 0
    ulib.strncpy((&f_in[0 as usize]) as u64, pin, 96)
    ulib.strncpy((&f_out[0 as usize]) as u64, pout, 96)
    f_err[0 as usize] = 0 as u8
    var t: u64 = from
    while t < to {
        let kind: u64 = tok_kind[t as usize]
        if kind == K_WORD {
            if argc >= MAX_ARGS {
                ulib.esay_line((&s_many[0 as usize]) as u64, 0)
                status = 2
                return true
            }
            argv[argc as usize] = word_at(t)
            argc = argc + 1
            t = t + 1
        } else {
            if t + 1 >= to || tok_kind[(t + 1) as usize] != K_WORD {
                ulib.esay_line((&s_what[0 as usize]) as u64, 0)
                status = 2
                return true
            }
            if kind == K_IN {
                ulib.strncpy((&f_in[0 as usize]) as u64, word_at(t + 1), 96)
            } else if kind == K_ERR {
                ulib.strncpy((&f_err[0 as usize]) as u64, word_at(t + 1), 96)
            } else {
                ulib.strncpy((&f_out[0 as usize]) as u64, word_at(t + 1), 96)
                append = kind == K_APP
            }
            t = t + 2
        }
    }
    if argc == 0 {
        // Only assignments, or nothing at all.
        return true
    }
    if assignments() {
        status = 0
        return true
    }
    if !redirect(0, (&f_in[0 as usize]) as u64, false) {
        return true
    }
    if !redirect(1, (&f_out[0 as usize]) as u64, append) {
        undo()
        return true
    }
    if !redirect(2, (&f_err[0 as usize]) as u64, false) {
        undo()
        return true
    }
    did_run = 0
    let alive: bool = execute(bg)
    undo()
    if interactive == 1 && did_run == 1 {
        var s_arrow: [u8; 5] = " -> \0"
        prompt()
        ulib.say(argv[0 as usize])
        ulib.say((&s_arrow[0 as usize]) as u64)
        ulib.sayn(status)
        ulib.nl()
    }
    return alive
}

// `NAME=value` in front of a command. A real shell would hand it to the
// child as an environment; `exec` has none in this kernel (round K4),
// so it is set here and stays set. docs/ROUNDK6.md says so.
fn eq_at(w: u64) -> u64 {
    let first: u64 = (*((w) as *mut u8)) as u64
    if !is_name(first) || (first >= 48 && first <= 57) {
        return 0
    }
    var n: u64 = 0
    while *((w + n) as *mut u8) != 0 as u8 {
        if *((w + n) as *mut u8) == 61 as u8 {
            if n == 0 {
                return 0
            }
            return n + 1
        }
        if !is_name((*((w + n) as *mut u8)) as u64) {
            return 0
        }
        n = n + 1
    }
    return 0
}

fn assignments() -> bool {
    var name: [u8; 20] = [0 as u8; 20]
    var done: u64 = 0
    var going: bool = true
    while going && done < argc {
        let w: u64 = argv[done as usize]
        let eq: u64 = eq_at(w)
        if eq == 0 {
            going = false
        } else {
            var k: u64 = 0
            while k + 1 < eq && k + 1 < 20 {
                name[k as usize] = *((w + k) as *mut u8)
                k = k + 1
            }
            name[k as usize] = 0 as u8
            var_set((&name[0 as usize]) as u64, w + eq)
            done = done + 1
        }
    }
    if done == argc {
        return true
    }
    if done > 0 {
        var k: u64 = 0
        while done + k < argc {
            argv[k as usize] = argv[(done + k) as usize]
            k = k + 1
        }
        argc = k
    }
    return false
}

// One of the three standard descriptors onto a file, or left alone when
// the name is empty. `>` unlinks first, which is this file system's
// truncate; `>>` seeks to the end.
fn redirect(fd: u64, name: u64, append: bool) -> bool {
    var s_open: [u8; 20] = "sh: cannot open \0\0\0\0"
    if *((name) as *mut u8) == 0 as u8 {
        return true
    }
    if fd == 0 {
        let r: u64 = ulib.sys(ulib.SYS_OPEN, name, 0, 0)
        if ulib.bad(r) {
            ulib.esay_line((&s_open[0 as usize]) as u64, name)
            status = 2
            return false
        }
        ulib.sys(ulib.SYS_DUP2, r, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, r, 0, 0)
        return true
    }
    // ROUND K4'S FLAGS. Round K6 took the name away to empty the file,
    // because the file system of round K1 could not shorten one and
    // `open` took a boolean "make it". Both are gone: `>` is
    // O_WRONLY|O_CREAT|O_TRUNC and `>>` is O_WRONLY|O_CREAT|O_APPEND, and
    // the kernel puts an appending write at the end of the file itself --
    // no seek, and no gap between the seek and the write.
    var flags: u64 = ulib.O_MAKE
    if append {
        flags = 1089 // O_WRONLY | O_CREAT | O_APPEND
    }
    let w: u64 = ulib.sys(ulib.SYS_OPEN, name, flags, 0)
    if ulib.bad(w) {
        ulib.esay_line((&s_open[0 as usize]) as u64, name)
        status = 2
        return false
    }
    ulib.sys(ulib.SYS_DUP2, w, fd, 0)
    ulib.sys(ulib.SYS_CLOSE, w, 0, 0)
    return true
}

// Every redirection back to where it was. The copies made in `u_start`
// are the "where it was" -- not the console: a shell whose own output was
// already pointed somewhere has to go back THERE.
fn undo() {
    if !ulib.bad(save_in) {
        ulib.sys(ulib.SYS_DUP2, save_in, 0, 0)
    }
    if !ulib.bad(save_out) {
        ulib.sys(ulib.SYS_DUP2, save_out, 1, 0)
    }
    if !ulib.bad(save_err) {
        ulib.sys(ulib.SYS_DUP2, save_err, 2, 0)
    }
}

// `ls` means `/bin/ls`; a name with a slash in it means itself. Two
// lines, and they are the whole of what a bigger system calls a search
// path -- one directory, and it is named in the shell and not in the
// kernel.
fn make_path(cmd: u64) {
    var b_bin: [u8; 6] = "/bin/\0"
    var slash: bool = false
    var i: u64 = 0
    while *((cmd + i) as *mut u8) != 0 as u8 {
        if *((cmd + i) as *mut u8) == 47 as u8 {
            slash = true
        }
        i = i + 1
    }
    if slash {
        ulib.strncpy((&path[0 as usize]) as u64, cmd, 128)
        return
    }
    ulib.strcpy((&path[0 as usize]) as u64, (&b_bin[0 as usize]) as u64)
    ulib.strncpy((&path[0 as usize]) as u64 + 5, cmd, 123)
}

// The command itself. Returns false only for `exit`.
fn execute(bg: bool) -> bool {
    var s_no: [u8; 16] = "sh: cannot run \0"
    var s_arrow: [u8; 5] = " -> \0"
    var s_job: [u8; 3] = "[\0\0"
    var s_jend: [u8; 3] = "] \0"
    if builtin() {
        return leaving == 0
    }
    make_path(argv[0 as usize])
    push_env()
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&path[0 as usize]) as u64,
        (&argv[0 as usize]) as u64, argc)
    if ulib.bad(pid) {
        ulib.eput((&s_no[0 as usize]) as u64)
        ulib.eput(argv[0 as usize])
        ulib.eput((&s_arrow[0 as usize]) as u64)
        say_err(pid)
        status = 127
        return true
    }
    if bg {
        if nbg < NBG {
            bg_pid[nbg as usize] = pid
            nbg = nbg + 1
        }
        last_bg = pid
        ulib.say((&s_job[0 as usize]) as u64)
        ulib.sayu(nbg)
        ulib.say((&s_jend[0 as usize]) as u64)
        ulib.sayu(pid)
        ulib.nl()
        status = 0
        return true
    }
    status = ulib.wait_code(pid)
    did_run = 1
    return true
}

// A negative number on descriptor 2. `ulib.sayn` writes on 1, and an
// error that went to 1 would land in the file of `cmd > file`.
fn say_err(v: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    ulib.digits(v, (&buf[0 as usize]) as u64)
    ulib.eput((&buf[0 as usize]) as u64)
    var nlc: [u8; 2] = "\n\0"
    ulib.eput((&nlc[0 as usize]) as u64)
}

// ---------------------------------------------------------- built-ins

// The commands that cannot be programs: a child process cannot change
// its parent's working directory, cannot set its variables and cannot
// end it. Everything else on this system IS a program.
fn builtin() -> bool {
    var c_cd: [u8; 3] = "cd\0"
    var c_pwd: [u8; 4] = "pwd\0"
    var c_exit: [u8; 5] = "exit\0"
    var c_export: [u8; 7] = "export\0"
    var c_wait: [u8; 5] = "wait\0"
    var c_test: [u8; 5] = "test\0"
    var c_brk: [u8; 2] = "[\0"
    var c_shift: [u8; 6] = "shift\0"
    let w: u64 = argv[0 as usize]
    if ulib.streq(w, (&c_test[0 as usize]) as u64) {
        status = do_test(false)
        return true
    }
    if ulib.streq(w, (&c_brk[0 as usize]) as u64) {
        status = do_test(true)
        return true
    }
    if ulib.streq(w, (&c_shift[0 as usize]) as u64) {
        do_shift()
        return true
    }
    if ulib.streq(w, (&c_cd[0 as usize]) as u64) {
        do_cd()
        return true
    }
    if ulib.streq(w, (&c_pwd[0 as usize]) as u64) {
        do_pwd()
        return true
    }
    if ulib.streq(w, (&c_exit[0 as usize]) as u64) {
        leaving = 1
        if argc > 1 {
            status = ulib.to_num(argv[1 as usize])
        }
        return true
    }
    if ulib.streq(w, (&c_export[0 as usize]) as u64) {
        do_export()
        return true
    }
    if ulib.streq(w, (&c_wait[0 as usize]) as u64) {
        reap_all()
        status = 0
        return true
    }
    return false
}

fn do_cd() {
    var home: [u8; 2] = "/\0"
    var s_no: [u8; 20] = "sh: cannot cd to \0\0\0"
    var target: u64 = (&home[0 as usize]) as u64
    if argc > 1 {
        target = argv[1 as usize]
    }
    let r: u64 = ulib.sys(ulib.SYS_CHDIR, target, 0, 0)
    if ulib.bad(r) {
        ulib.esay_line((&s_no[0 as usize]) as u64, target)
        status = 1
        return
    }
    status = 0
}

fn do_pwd() {
    var buf: [u8; 96] = [0 as u8; 96]
    // Linux's `getcwd` counts the terminating zero, and so does this
    // kernel now that round K6 sits on round K4's layer -- what is
    // PRINTED is one octet less.
    let n: u64 = ulib.sys(ulib.SYS_GETCWD, (&buf[0 as usize]) as u64, 96, 0)
    if ulib.bad(n) || n == 0 {
        status = 1
        return
    }
    ulib.put((&buf[0 as usize]) as u64, n - 1)
    ulib.nl()
    status = 0
}

// `export NAME` marks a variable, `export` alone lists what is marked.
// The mark reaches no child yet: `exec` has no environment in this
// kernel. It is here so that the shell has the word and the round after
// this one has somewhere to hang it.
fn do_export() {
    var s_eq: [u8; 2] = "=\0"
    if argc == 1 {
        var i: u64 = 0
        while i < nvar {
            if vexp[i as usize] == 1 {
                ulib.say((&vname[(i * VNAME) as usize]) as u64)
                ulib.say((&s_eq[0 as usize]) as u64)
                ulib.say((&vval[(i * VVAL) as usize]) as u64)
                ulib.nl()
            }
            i = i + 1
        }
        status = 0
        return
    }
    var k: u64 = 1
    while k < argc {
        let i: u64 = var_find(argv[k as usize])
        if i < NVAR {
            vexp[i as usize] = 1
        }
        k = k + 1
    }
    status = 0
}

// Every background child that is still a corpse. A shell that walked
// away from them would leave a page table and a kernel stack per job
// behind, and `tools/osum/run.sh` counts exactly those frames.
fn reap_all() {
    var s_done: [u8; 2] = "[\0"
    var s_arrow: [u8; 6] = "] -> \0"
    var i: u64 = 0
    while i < nbg {
        let code: u64 = ulib.wait_code(bg_pid[i as usize])
        ulib.say((&s_done[0 as usize]) as u64)
        ulib.sayu(bg_pid[i as usize])
        ulib.say((&s_arrow[0 as usize]) as u64)
        ulib.sayn(code)
        ulib.nl()
        i = i + 1
    }
    nbg = 0
}

// ================================================ RUNDE K11: das Skript
//
// WAS DIE SHELL AUS RUNDE K6 VORGEFUNDEN HAT -- nachgesehen und nicht
// geraten (`kernel/user/sh.fi`, Stand f4c58d1): Roehren mit bis zu vier
// Stufen ueber Zwischendateien, `<`, `>`, `>>`, `2>`, `;`, `&` und
// `wait`, einfache und doppelte Anfuehrungszeichen, `$NAME`, `$?`, `$!`,
// Zuweisungen `NAME=wert` vor einem Befehl, die eingebauten Befehle `cd`,
// `pwd`, `exit`, `export` und `wait`, einen Zeileneditor mit Ruecktaste
// und "die Zeile von vorhin", und `/bin/` als einzigen Suchpfad.
//
// WAS FEHLTE: alles, was ein Skript zu einem Programm macht. Kein `if`,
// kein `for`, kein `while`, kein `case`, keine Funktionen, kein `test`,
// keine Stellungsparameter. Ein Skript war eine Liste von Befehlen.
//
// DER ZUSCHNITT DIESER RUNDE, und er ist mit Absicht so: die Maschinerie
// von K6 bleibt Zeile fuer Zeile stehen. Darueber liegt eine Schicht, die
// den Text in ANWEISUNGEN zerlegt (getrennt an Zeilenende und `;`,
// Anfuehrungszeichen zaehlen mit) und die Schluesselwoerter erkennt.
// Alles, was kein Schluesselwort ist, geht durch `run_line` -- dieselbe
// Funktion, dieselbe Ausgabe, dieselben Beendigungscodes wie in Runde K6.
// Deshalb misst tools/userland/run.sh weiterhin genau das, was es gemessen
// hat.
//
// EINE ANWEISUNG DARF 255 OKTETTE HABEN (`LINE`); ein Skript im Ganzen
// 16384 und 512 Anweisungen. Was darueber liegt, wird ABGELEHNT.

const SRCMAX: u64 = 16384
const STMTS: u64 = 512
const NFUNC: u64 = 16
const FNLEN: u64 = 24
const NPOS: u64 = 10
const POSLEN: u64 = 64
const FORBUF: u64 = 1024
const FORMAX: u64 = 32

static mut src: [u8; 16384] = [0 as u8; 16384]
static mut raw: [u8; 16384] = [0 as u8; 16384]
static mut nraw: u64 = 0
static mut nsrc: u64 = 0
static mut sat: [u64; 512] = [0 as u64; 512]
static mut slen: [u64; 512] = [0 as u64; 512]
static mut nstmt: u64 = 0
static mut fn_name: [u8; 384] = [0 as u8; 384]
static mut fn_beg: [u64; 16] = [0 as u64; 16]
static mut fn_end: [u64; 16] = [0 as u64; 16]
static mut nfunc: u64 = 0
static mut pos: [u8; 640] = [0 as u8; 640]
static mut npos: u64 = 0
static mut ret_flag: u64 = 0
static mut brk_flag: u64 = 0
static mut cont_flag: u64 = 0
static mut calls: u64 = 0
static mut kwbuf: [u8; 32] = [0 as u8; 32]

// EIN WOERTERBUCH STATT VIERZIG ZEICHENKETTEN AUF DEM STAPEL.
//
// Ein `var s: [u8; n] = "then\0"` INNERHALB einer Funktion legt Firn Stufe
// 0 auf den Stapel und fuellt es bei jedem Aufruf Oktett fuer Oktett. Der
// Ausfuehrer haette so vierzig davon, und der Vergleich waere vierzig
// Aufrufe von `streq`. Hier steht die Liste EINMAL in `.rodata`, und
// verglichen wird eine ZAHL. Es steht als `static mut` da und nicht als
// `static`, obwohl niemand hineinschreibt: firnc1 (der Uebersetzer in
// Firn) bricht bei einem unveraenderlichen `static` mit einer
// Zeichenkette in einer Datei dieser Groesse OHNE MELDUNG mit 1 ab.
// Siehe docs/ROUNDK11.md, Abschnitt "was am Uebersetzer aufgefallen ist".
//
// Das ist nicht Kosmetik: die Shell muss samt
// dem uebrigen Userland auf eine Platte von 2 MiB passen, und
// tools/userland/run.sh rechnet das nach.
const W_IF: u64 = 1
const W_THEN: u64 = 2
const W_ELIF: u64 = 3
const W_ELSE: u64 = 4
const W_FI: u64 = 5
const W_WHILE: u64 = 6
const W_UNTIL: u64 = 7
const W_FOR: u64 = 8
const W_DO: u64 = 9
const W_DONE: u64 = 10
const W_CASE: u64 = 11
const W_ESAC: u64 = 12
const W_IN: u64 = 13
const W_RETURN: u64 = 14
const W_BREAK: u64 = 15
const W_CONTINUE: u64 = 16
const W_COLON: u64 = 17
const W_SEMI2: u64 = 18
const W_OPEN: u64 = 19
const W_CLOSE: u64 = 20

static mut KWTAB: [u8; 89] = "if\0then\0elif\0else\0fi\0while\0until\0for\0do\0done\0case\0esac\0in\0return\0break\0continue\0:\0;;\0{\0}\0"

// Welche Nummer dieses Wort hat, oder 0.
fn kw_id_of(p: u64) -> u64 {
    var at: u64 = 0
    var id: u64 = 1
    while at < 89 {
        if KWTAB[(at) as usize] == 0 as u8 {
            return 0
        }
        if ulib.streq((&KWTAB[(at) as usize]) as u64, p) {
            return id
        }
        while KWTAB[(at) as usize] != 0 as u8 {
            at = at + 1
        }
        at = at + 1
        id = id + 1
    }
    return 0
}

fn kw_id(i: u64) -> u64 {
    return kw_id_of(kw_of(i))
}

// ------------------------------------------------- Anweisungen schneiden

fn add_stmt(from: u64, to: u64) {
    var a: u64 = from
    var b: u64 = to
    while a < b && (src[(a) as usize] == 32 as u8 || src[(a) as usize] == 9 as u8) {
        a = a + 1
    }
    while b > a && (src[(b - 1) as usize] == 32 as u8
        || src[(b - 1) as usize] == 9 as u8) {
        b = b - 1
    }
    if b <= a || nstmt >= STMTS {
        return
    }
    // `then`, `else` und `do` sind Schluesselwoerter, hinter denen auf
    // derselben Zeile ein Befehl stehen darf (`if x; then echo a; fi`).
    // Sie werden hier abgetrennt, damit der Ausfuehrer nur noch ganze
    // Schluesselwoerter sieht.
    let w: u64 = word_end(a, b)
    if lead(a, w) {
        sat[(nstmt) as usize] = a
        slen[(nstmt) as usize] = w - a
        nstmt = nstmt + 1
        add_stmt(w, b)
        return
    }
    sat[(nstmt) as usize] = a
    slen[(nstmt) as usize] = b - a
    nstmt = nstmt + 1
}

fn word_end(a: u64, b: u64) -> u64 {
    var i: u64 = a
    while i < b && src[(i) as usize] != 32 as u8 && src[(i) as usize] != 9 as u8 {
        i = i + 1
    }
    return i
}

fn lit_eq(a: u64, n: u64, p: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if src[(a + i) as usize] != *((p + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return *((p + n) as *mut u8) == 0 as u8
}

// Ein Schluesselwort, hinter dem auf derselben Zeile noch ein Befehl
// stehen darf.
fn lead(a: u64, w: u64) -> bool {
    var buf: [u8; 32] = [0 as u8; 32]
    var n: u64 = w - a
    if n > 30 {
        return false
    }
    var k: u64 = 0
    while k < n {
        buf[(k) as usize] = src[(a + k) as usize]
        k = k + 1
    }
    buf[(n) as usize] = 0 as u8
    let id: u64 = kw_id_of((&buf[0 as usize]) as u64)
    return id == W_THEN || id == W_ELSE || id == W_DO
}

// Der ganze Text in Anweisungen. Getrennt wird an Zeilenende und an `;`,
// aber nicht innerhalb von Anfuehrungszeichen -- `echo "a;b"` ist EINE.
// `;;` bleibt als eigene Anweisung stehen: `case` braucht es.
fn split_all() {
    nstmt = 0
    var i: u64 = 0
    while i < nsrc {
        while i < nsrc && (src[(i) as usize] == 32 as u8
            || src[(i) as usize] == 9 as u8 || src[(i) as usize] == 10 as u8) {
            i = i + 1
        }
        if i < nsrc && src[(i) as usize] == 59 as u8 {
            if i + 1 < nsrc && src[(i + 1) as usize] == 59 as u8 {
                if nstmt < STMTS {
                    sat[(nstmt) as usize] = i
                    slen[(nstmt) as usize] = 2
                    nstmt = nstmt + 1
                }
                i = i + 2
            } else {
                i = i + 1
            }
        } else if i < nsrc && src[(i) as usize] == 35 as u8 {
            while i < nsrc && src[(i) as usize] != 10 as u8 {
                i = i + 1
            }
        } else if i < nsrc {
            let start: u64 = i
            var q: u64 = 0
            var going: bool = true
            while going && i < nsrc {
                let c: u64 = (src[(i) as usize]) as u64
                if q != 0 {
                    if c == q {
                        q = 0
                    }
                    i = i + 1
                } else if c == 39 || c == 34 {
                    q = c
                    i = i + 1
                } else if c == 10 || c == 59 {
                    going = false
                } else if c == 35 && i > start
                && (src[(i - 1) as usize] == 32 as u8
                    || src[(i - 1) as usize] == 9 as u8) {
                    going = false
                } else {
                    i = i + 1
                }
            }
            add_stmt(start, i)
            if i < nsrc && src[(i) as usize] == 35 as u8 {
                while i < nsrc && src[(i) as usize] != 10 as u8 {
                    i = i + 1
                }
            }
        }
    }
}

// ------------------------------------------------- das erste Wort

fn kw_of(i: u64) -> u64 {
    let a: u64 = sat[(i) as usize]
    let b: u64 = a + slen[(i) as usize]
    let w: u64 = word_end(a, b)
    var n: u64 = w - a
    if n > 30 {
        n = 30
    }
    var k: u64 = 0
    while k < n {
        kwbuf[(k) as usize] = src[(a + k) as usize]
        k = k + 1
    }
    kwbuf[(n) as usize] = 0 as u8
    return (&kwbuf[0 as usize]) as u64
}

fn kw_is(i: u64, p: u64) -> bool {
    return ulib.streq(kw_of(i), p)
}

// Alles nach dem ersten Wort dieser Anweisung.
fn tail_of(i: u64) -> u64 {
    let a: u64 = sat[(i) as usize]
    let b: u64 = a + slen[(i) as usize]
    var w: u64 = word_end(a, b)
    while w < b && (src[(w) as usize] == 32 as u8
        || src[(w) as usize] == 9 as u8) {
        w = w + 1
    }
    return w
}

fn tail_len(i: u64) -> u64 {
    let a: u64 = sat[(i) as usize]
    let b: u64 = a + slen[(i) as usize]
    let w: u64 = tail_of(i)
    if w >= b {
        return 0
    }
    return b - w
}

// ------------------------------------------------- Bloecke finden

fn opener(i: u64) -> bool {
    let id: u64 = kw_id(i)
    return id == W_IF || id == W_WHILE || id == W_UNTIL || id == W_FOR
        || id == W_CASE
}

fn closer(i: u64) -> bool {
    let id: u64 = kw_id(i)
    return id == W_FI || id == W_DONE || id == W_ESAC
}

// Die naechste Anweisung zwischen `from` und `to`, deren erstes Wort
// eines der drei ist -- auf DERSELBEN Verschachtelungsebene.
fn scan_to(from: u64, to: u64, a: u64, b: u64, c: u64) -> u64 {
    var depth: u64 = 0
    var i: u64 = from
    while i < to {
        if depth == 0 {
            let w: u64 = kw_id(i)
            if w != 0 && (w == a || w == b || w == c) {
                return i
            }
        }
        if opener(i) {
            depth = depth + 1
        } else if closer(i) {
            if depth > 0 {
                depth = depth - 1
            }
        }
        i = i + 1
    }
    return to
}

// ------------------------------------------------- Anweisungen ausfuehren

// Ein Stueck Rohtext als Befehlszeile. Genau der Weg von Runde K6.
fn run_text(p: u64, n: u64) -> bool {
    var k: u64 = 0
    while k < n && k + 1 < LINE {
        line[(k) as usize] = *((p + k) as *mut u8)
        k = k + 1
    }
    line[(k) as usize] = 0 as u8
    if k == 0 {
        return true
    }
    return run_line()
}

fn run_stmt(i: u64) -> bool {
    return run_text((&src[(sat[(i) as usize]) as usize]) as u64,
        slen[(i) as usize])
}

// Nur zerlegen, nicht ausfuehren -- fuer `for` und `case`, die die Worte
// selbst brauchen.
fn tokenize_stmt(i: u64) -> bool {
    var k: u64 = 0
    let n: u64 = slen[(i) as usize]
    let p: u64 = (&src[(sat[(i) as usize]) as usize]) as u64
    while k < n && k + 1 < LINE {
        line[(k) as usize] = *((p + k) as *mut u8)
        k = k + 1
    }
    line[(k) as usize] = 0 as u8
    return tokenize()
}

// ------------------------------------------------------------- Muster

fn wild(pat: u64, s: u64) -> bool {
    var p: u64 = 0
    var t: u64 = 0
    var star: u64 = ulib.EOF
    var back: u64 = 0
    var done: bool = false
    var result: bool = false
    while !done {
        let sc: u64 = (*((s + t) as *mut u8)) as u64
        let pc: u64 = (*((pat + p) as *mut u8)) as u64
        if pc == 0 && sc == 0 {
            result = true
            done = true
        } else if pc == 42 {
            star = p
            p = p + 1
            back = t
        } else if sc != 0 && (pc == 63 || pc == sc) {
            p = p + 1
            t = t + 1
        } else if star != ulib.EOF && sc != 0 {
            p = star + 1
            back = back + 1
            t = back
        } else {
            result = false
            done = true
        }
    }
    return result
}

// ------------------------------------------------------------- test / [

fn num_cmp(a: u64, op: u64, b: u64) -> bool {
    let x: u64 = ulib.to_num(a)
    let y: u64 = ulib.to_num(b)
    if op == 1 {
        return x == y
    }
    if op == 2 {
        return x != y
    }
    if op == 3 {
        return x < y
    }
    if op == 4 {
        return x <= y
    }
    if op == 5 {
        return x > y
    }
    return x >= y
}

// Dieselbe Ueberlegung wie beim Woerterbuch der Schluesselwoerter: EINE
// Liste in `.rodata`, verglichen wird eine Zahl.
//   1 -eq  2 -ne  3 -lt  4 -le  5 -gt  6 -ge
//   7 -e   8 -f   9 -d  10 -r  11 -s  12 -n  13 -z
//  14 =   15 !=  16 !
static mut OPTAB: [u8; 52] = "-eq\0-ne\0-lt\0-le\0-gt\0-ge\0-e\0-f\0-d\0-r\0-s\0-n\0-z\0=\0!=\0!\0"

fn op_id(p: u64) -> u64 {
    var at: u64 = 0
    var id: u64 = 1
    while at < 52 {
        if OPTAB[(at) as usize] == 0 as u8 {
            return 0
        }
        if ulib.streq((&OPTAB[(at) as usize]) as u64, p) {
            return id
        }
        while OPTAB[(at) as usize] != 0 as u8 {
            at = at + 1
        }
        at = at + 1
        id = id + 1
    }
    return 0
}

fn num_op(p: u64) -> u64 {
    let id: u64 = op_id(p)
    if id >= 1 && id <= 6 {
        return id
    }
    return 0
}

// `test` und `[` sind hier eingebaut und keine Programme. Zwei Gruende:
// ein Prozess je Bedingung waere in einer `while`-Schleife der ganze
// Aufwand, und `[` muesste als Dateiname `/bin/[` auf der Platte liegen,
// wo ihn niemand vermutet. Jede Shell macht es so.
//
// Was es kennt: -e -f -d -r -s (Dateien), -n -z (Zeichenketten),
// = != (Vergleich), -eq -ne -lt -le -gt -ge (Zahlen), ! davor, und ein
// einzelnes Wort ist wahr, wenn es nicht leer ist.
fn do_test(as_bracket: bool) -> u64 {
    var n: u64 = argc
    if as_bracket {
        // Die schliessende Klammer gehoert nicht zur Bedingung.
        if n > 1 {
            n = n - 1
        }
    }
    var at: u64 = 1
    var invert: bool = false
    while at < n && op_id(argv[(at) as usize]) == 16 {
        invert = !invert
        at = at + 1
    }
    var yes: bool = false
    let left: u64 = n - at
    if left == 1 {
        yes = *((argv[(at) as usize]) as *mut u8) != 0 as u8
    } else if left == 2 {
        let o: u64 = op_id(argv[(at) as usize])
        let v: u64 = argv[(at + 1) as usize]
        if o == 7 || o == 10 {
            yes = !ulib.bad(ulib.size_of(v)) || ulib.is_dir(v)
        } else if o == 8 {
            yes = !ulib.bad(ulib.size_of(v)) && !ulib.is_dir(v)
        } else if o == 9 {
            yes = ulib.is_dir(v)
        } else if o == 11 {
            let sz: u64 = ulib.size_of(v)
            yes = !ulib.bad(sz) && sz > 0
        } else if o == 12 {
            yes = *((v) as *mut u8) != 0 as u8
        } else if o == 13 {
            yes = *((v) as *mut u8) == 0 as u8
        }
    } else if left >= 3 {
        let a: u64 = argv[(at) as usize]
        let o: u64 = op_id(argv[(at + 1) as usize])
        let b: u64 = argv[(at + 2) as usize]
        if o >= 1 && o <= 6 {
            yes = num_cmp(a, o, b)
        } else if o == 14 {
            yes = ulib.streq(a, b)
        } else if o == 15 {
            yes = !ulib.streq(a, b)
        }
    }
    if invert {
        yes = !yes
    }
    if yes {
        return 0
    }
    return 1
}

// ------------------------------------------------------- Funktionen

fn func_find(name: u64) -> u64 {
    var i: u64 = 0
    while i < nfunc {
        if ulib.streq((&fn_name[(i * FNLEN) as usize]) as u64, name) {
            return i
        }
        i = i + 1
    }
    return NFUNC
}

fn pos_set(k: u64, p: u64) {
    if k >= NPOS {
        return
    }
    ulib.strncpy((&pos[(k * POSLEN) as usize]) as u64, p, POSLEN)
}

fn pos_get(k: u64) -> u64 {
    if k >= NPOS || k >= npos {
        return 0
    }
    return (&pos[(k * POSLEN) as usize]) as u64
}

// ------------------------------------------------- der Ausfuehrer

// Anweisungen `from`..`to`. Gibt false, wenn `exit` dabei war.
fn exec_range(from: u64, to: u64) -> bool {
    var i: u64 = from
    while i < to && ret_flag == 0 && brk_flag == 0 && cont_flag == 0 {
        let w: u64 = kw_id(i)
        if w == W_IF {
            i = do_if(i, to)
            if i == ulib.EOF {
                return false
            }
        } else if w == W_WHILE || w == W_UNTIL {
            let r: u64 = do_while(i, to, w == W_UNTIL)
            if r == ulib.EOF {
                return false
            }
            i = r
        } else if w == W_FOR {
            let r: u64 = do_for(i, to)
            if r == ulib.EOF {
                return false
            }
            i = r
        } else if w == W_CASE {
            let r: u64 = do_case(i, to)
            if r == ulib.EOF {
                return false
            }
            i = r
        } else if w == W_RETURN {
            if tail_len(i) > 0 {
                status = ulib.to_num((&src[(tail_of(i)) as usize]) as u64)
            }
            ret_flag = 1
            i = i + 1
        } else if w == W_BREAK {
            brk_flag = 1
            i = i + 1
        } else if w == W_CONTINUE {
            cont_flag = 1
            i = i + 1
        } else if w == W_COLON {
            status = 0
            i = i + 1
        } else if w != 0 {
            // Ein Schluesselwort ohne seinen Kopf -- uebergehen statt als
            // Befehl zu suchen. So bleibt ein halb geschriebenes Skript
            // eine Meldung und kein `sh: cannot run fi`.
            i = i + 1
        } else if is_funcdef(i) {
            i = def_func(i, to)
        } else {
            if !run_one(i) {
                return false
            }
            i = i + 1
        }
    }
    return true
}

// Ein gewoehnlicher Befehl -- oder der Aufruf einer Funktion.
fn run_one(i: u64) -> bool {
    if !tokenize_stmt(i) {
        status = 2
        return true
    }
    if ntok == 0 {
        return true
    }
    let first: u64 = word_at(0)
    let f: u64 = func_find(first)
    if f < NFUNC && tok_kind[0 as usize] == K_WORD {
        return call_func(f)
    }
    return run_stmt(i)
}

fn call_func(f: u64) -> bool {
    var save: [u8; 640] = [0 as u8; 640]
    var s_deep: [u8; 24] = "sh: functions too deep\0\0"
    if calls >= 8 {
        ulib.esay_line((&s_deep[0 as usize]) as u64, 0)
        status = 2
        return true
    }
    // Die Stellungsparameter des Aufrufers retten -- eine Funktion, die
    // die $1 ihres Aufrufers zerstoert, ist keine.
    var k: u64 = 0
    while k < NPOS * POSLEN {
        save[(k) as usize] = pos[(k) as usize]
        k = k + 1
    }
    let saved_n: u64 = npos
    npos = 0
    k = 0
    while k < ntok && k < NPOS {
        if tok_kind[(k) as usize] == K_WORD {
            pos_set(k, word_at(k))
            npos = k + 1
        }
        k = k + 1
    }
    calls = calls + 1
    let alive: bool = exec_range(fn_beg[(f) as usize], fn_end[(f) as usize])
    calls = calls - 1
    ret_flag = 0
    k = 0
    while k < NPOS * POSLEN {
        pos[(k) as usize] = save[(k) as usize]
        k = k + 1
    }
    npos = saved_n
    return alive
}

// `name()` oder `name() {`
fn is_funcdef(i: u64) -> bool {
    let a: u64 = sat[(i) as usize]
    let b: u64 = a + slen[(i) as usize]
    let w: u64 = word_end(a, b)
    if w - a < 3 {
        return false
    }
    return src[(w - 2) as usize] == 40 as u8 && src[(w - 1) as usize] == 41 as u8
}

fn def_func(i: u64, to: u64) -> u64 {
    let a: u64 = sat[(i) as usize]
    let b: u64 = a + slen[(i) as usize]
    let w: u64 = word_end(a, b)
    var n: u64 = w - a - 2
    if n + 1 >= FNLEN {
        n = FNLEN - 1
    }
    if nfunc >= NFUNC {
        return i + 1
    }
    var k: u64 = 0
    while k < n {
        fn_name[(nfunc * FNLEN + k) as usize] = src[(a + k) as usize]
        k = k + 1
    }
    fn_name[(nfunc * FNLEN + n) as usize] = 0 as u8
    // Der Rumpf beginnt hinter der oeffnenden Klammer. Steht sie allein
    // in der naechsten Anweisung, faengt er eine spaeter an.
    var body: u64 = i + 1
    let end: u64 = scan_to(body, to, W_CLOSE, 0, 0)
    if body < to && kw_id(body) == W_OPEN && slen[(body) as usize] == 1 {
        body = body + 1
    }
    fn_beg[(nfunc) as usize] = body
    fn_end[(nfunc) as usize] = end
    nfunc = nfunc + 1
    if end < to {
        return end + 1
    }
    return to
}

// `if` .. `then` .. [`elif` .. `then` ..] [`else` ..] `fi`
fn do_if(i: u64, to: u64) -> u64 {
    let fi: u64 = scan_to(i + 1, to, W_FI, 0, 0)
    var head: u64 = i
    var done: bool = false
    var alive: bool = true
    while !done {
        let then_at: u64 = scan_to(head + 1, fi, W_THEN, 0, 0)
        if then_at >= fi {
            done = true
        } else {
            // Die Bedingung: alles zwischen dem Kopf und `then`.
            if tail_len(head) > 0 {
                if !run_text((&src[(tail_of(head)) as usize]) as u64,
                    tail_len(head)) {
                    return ulib.EOF
                }
            }
            var c: u64 = head + 1
            while c < then_at {
                if !run_stmt(c) {
                    return ulib.EOF
                }
                c = c + 1
            }
            let ok: bool = status == 0
            let next: u64 = scan_to(then_at + 1, fi, W_ELIF, W_ELSE, 0)
            if ok {
                if !exec_range(then_at + 1, next) {
                    return ulib.EOF
                }
                done = true
            } else if next < fi && kw_id(next) == W_ELSE {
                if !exec_range(next + 1, fi) {
                    return ulib.EOF
                }
                done = true
            } else if next < fi {
                head = next
            } else {
                status = 0
                done = true
            }
        }
    }
    if fi < to {
        return fi + 1
    }
    return to
}

// `while COND` `do` .. `done` -- und `until`, das dieselbe Schleife mit
// umgedrehter Bedingung ist.
fn do_while(i: u64, to: u64, invert: bool) -> u64 {
    let done_at: u64 = scan_to(i + 1, to, W_DONE, 0, 0)
    let do_at: u64 = scan_to(i + 1, done_at, W_DO, 0, 0)
    if do_at >= done_at {
        return done_at
    }
    var rounds: u64 = 0
    var going: bool = true
    while going {
        if tail_len(i) > 0 {
            if !run_text((&src[(tail_of(i)) as usize]) as u64, tail_len(i)) {
                return ulib.EOF
            }
        }
        var c: u64 = i + 1
        while c < do_at {
            if !run_stmt(c) {
                return ulib.EOF
            }
            c = c + 1
        }
        var ok: bool = status == 0
        if invert {
            ok = !ok
        }
        if !ok {
            going = false
        } else {
            if !exec_range(do_at + 1, done_at) {
                return ulib.EOF
            }
            cont_flag = 0
            if brk_flag == 1 {
                brk_flag = 0
                going = false
            }
            if ret_flag == 1 {
                going = false
            }
            rounds = rounds + 1
            // EINE OBERGRENZE, und sie steht hier mit Absicht: eine
            // Schleife, die nicht endet, macht aus einem Testlauf ein
            // Zeitlimit, und ein Zeitlimit misst nichts.
            if rounds > 100000 {
                going = false
            }
        }
    }
    if done_at < to {
        return done_at + 1
    }
    return to
}

// `for V in W...` `do` .. `done`
fn do_for(i: u64, to: u64) -> u64 {
    var buf: [u8; 1024] = [0 as u8; 1024]
    var at: [u64; 32] = [0 as u64; 32]
    var name: [u8; 24] = [0 as u8; 24]
    let done_at: u64 = scan_to(i + 1, to, W_DONE, 0, 0)
    let do_at: u64 = scan_to(i + 1, done_at, W_DO, 0, 0)
    if do_at >= done_at {
        return done_at
    }
    if !tokenize_stmt(i) {
        status = 2
        return done_at + 1
    }
    if ntok < 2 {
        return done_at + 1
    }
    ulib.strncpy((&name[0 as usize]) as u64, word_at(1), 24)
    var k: u64 = 2
    if k < ntok && kw_id_of(word_at(k)) == W_IN {
        k = k + 1
    }
    // DIE WORTE WERDEN AN LEERZEICHEN NOCH EINMAL ZERLEGT. `$LIST` wird
    // in Runde K6 zu EINEM Wort, auch ohne Anfuehrungszeichen; damit
    // `for i in $LIST` das tut, was jeder erwartet, teilt genau diese
    // Schleife sie hier. Das ist eine ABWEICHUNG von POSIX (dort trennt
    // die Zerlegung schon frueher) und steht in docs/ROUNDK11.md.
    var n: u64 = 0
    var used: u64 = 0
    while k < ntok && n < FORMAX {
        let p: u64 = word_at(k)
        var j: u64 = 0
        var start: u64 = used
        var any: bool = false
        var going: bool = true
        while going {
            let c: u64 = (*((p + j) as *mut u8)) as u64
            if c == 0 || c == 32 || c == 9 {
                if any && n < FORMAX && used + 1 < FORBUF {
                    buf[(used) as usize] = 0 as u8
                    used = used + 1
                    at[(n) as usize] = start
                    n = n + 1
                }
                any = false
                start = used
                if c == 0 {
                    going = false
                }
            } else if used + 2 < FORBUF {
                buf[(used) as usize] = c as u8
                used = used + 1
                any = true
            }
            j = j + 1
        }
        k = k + 1
    }
    var idx: u64 = 0
    while idx < n {
        var_set((&name[0 as usize]) as u64, (&buf[(at[(idx) as usize]) as usize]) as u64)
        if !exec_range(do_at + 1, done_at) {
            return ulib.EOF
        }
        cont_flag = 0
        if brk_flag == 1 {
            brk_flag = 0
            idx = n
        }
        if ret_flag == 1 {
            idx = n
        }
        idx = idx + 1
    }
    if done_at < to {
        return done_at + 1
    }
    return to
}

// `case W in` `MUSTER)` .. `;;` .. `esac`
fn do_case(i: u64, to: u64) -> u64 {
    var subject: [u8; 128] = [0 as u8; 128]
    var pat: [u8; 128] = [0 as u8; 128]
    let esac: u64 = scan_to(i + 1, to, W_ESAC, 0, 0)
    if !tokenize_stmt(i) {
        status = 2
        return esac + 1
    }
    if ntok < 2 {
        return esac + 1
    }
    ulib.strncpy((&subject[0 as usize]) as u64, word_at(1), 128)
    var j: u64 = i + 1
    var hit: bool = false
    while j < esac && !hit {
        // Eine Zweigzeile: `MUSTER)` oder `A|B)` -- und dahinter darf
        // schon der erste Befehl stehen.
        let a: u64 = sat[(j) as usize]
        let b: u64 = a + slen[(j) as usize]
        var close: u64 = a
        var q: u64 = 0
        while close < b && (q != 0 || src[(close) as usize] != 41 as u8) {
            let c: u64 = (src[(close) as usize]) as u64
            if q != 0 {
                if c == q {
                    q = 0
                }
            } else if c == 39 || c == 34 {
                q = c
            }
            close = close + 1
        }
        if close >= b {
            j = j + 1
        } else {
            // Passt eines der Muster?
            var start: u64 = a
            var m: u64 = a
            var matched: bool = false
            while m <= close {
                if m == close || src[(m) as usize] == 124 as u8 {
                    var n: u64 = m - start
                    if n + 1 >= 128 {
                        n = 127
                    }
                    var q2: u64 = 0
                    while q2 < n {
                        pat[(q2) as usize] = src[(start + q2) as usize]
                        q2 = q2 + 1
                    }
                    pat[(n) as usize] = 0 as u8
                    if wild((&pat[0 as usize]) as u64,
                        (&subject[0 as usize]) as u64) {
                        matched = true
                    }
                    start = m + 1
                }
                m = m + 1
            }
            let stop: u64 = scan_to(j + 1, esac, W_SEMI2, 0, 0)
            if matched {
                hit = true
                status = 0
                // Was hinter der Klammer noch auf der Zeile steht.
                var rest: u64 = close + 1
                while rest < b && (src[(rest) as usize] == 32 as u8
                    || src[(rest) as usize] == 9 as u8) {
                    rest = rest + 1
                }
                if rest < b {
                    if !run_text((&src[(rest) as usize]) as u64, b - rest) {
                        return ulib.EOF
                    }
                }
                if !exec_range(j + 1, stop) {
                    return ulib.EOF
                }
            }
            j = stop + 1
        }
    }
    if !hit {
        status = 0
    }
    if esac < to {
        return esac + 1
    }
    return to
}

// ---------------------------------------------------- ein ganzes Skript

fn read_all(fd: u64) -> bool {
    nraw = 0
    var going: bool = true
    while going {
        let n: u64 = ulib.sys(ulib.SYS_READ, fd,
            (&raw[(nraw) as usize]) as u64, 4096)
        if n == 0 || ulib.bad(n) {
            going = false
        } else {
            nraw = nraw + n
            if nraw + 4096 > SRCMAX {
                return false
            }
        }
    }
    return edit_pass()
}

// DER ZEILENEDITOR AUS RUNDE K1, UNVERAENDERT -- und er steht hier, weil
// er sonst mit dem Lesen als Ganzes verschwunden waere.
//
// Auf dieser Maschine sind das Oktett 8 (Ruecktaste) und das Oktett 14
// ("die Zeile von vorhin") Tasten, und weil sie Oktette sind, kann eine
// DATEI sie genauso enthalten. Genau daran misst Abschnitt 5 von
// tools/userland/run.sh den Zeileneditor -- ohne einen Menschen davor.
// Also bekommt der Text vor dem Zerlegen denselben Durchgang, den
// `get_line` Zeichen fuer Zeichen macht: 8 nimmt das letzte Zeichen
// zurueck, 14 setzt die vorige Zeile ein, und eine nicht leere Zeile
// wird die neue "vorige".
fn edit_pass() -> bool {
    var last: [u8; 256] = [0 as u8; 256]
    var cur: [u8; 256] = [0 as u8; 256]
    nsrc = 0
    var i: u64 = 0
    var n: u64 = 0
    var going: bool = true
    while going {
        let at_end: bool = i >= nraw
        var c: u64 = 10
        if !at_end {
            c = (raw[(i) as usize]) as u64
        }
        if c == 10 {
            if nsrc + n + 2 >= SRCMAX {
                return false
            }
            var k: u64 = 0
            while k < n {
                src[(nsrc + k) as usize] = cur[(k) as usize]
                k = k + 1
            }
            nsrc = nsrc + n
            src[(nsrc) as usize] = 10 as u8
            nsrc = nsrc + 1
            if n > 0 {
                k = 0
                while k <= n {
                    last[(k) as usize] = cur[(k) as usize]
                    k = k + 1
                }
            }
            n = 0
            if at_end {
                going = false
            }
        } else if c == 8 {
            if n > 0 {
                n = n - 1
            }
        } else if c == 14 {
            n = 0
            while last[(n) as usize] != 0 as u8 && n + 1 < LINE {
                cur[(n) as usize] = last[(n) as usize]
                n = n + 1
            }
        } else if n + 1 < LINE {
            cur[(n) as usize] = c as u8
            n = n + 1
        }
        cur[(n) as usize] = 0 as u8
        i = i + 1
    }
    return true
}

fn run_script(fd: u64) -> u64 {
    var s_big: [u8; 22] = "sh: script too big\0\0\0\0"
    if !read_all(fd) {
        ulib.esay_line((&s_big[0 as usize]) as u64, 0)
        return 2
    }
    split_all()
    exec_range(0, nstmt)
    return status
}

// `shift` -- die Stellungsparameter um eins nach vorn.
fn do_shift() {
    var k: u64 = 1
    while k + 1 < npos {
        var i: u64 = 0
        while i < POSLEN {
            pos[(k * POSLEN + i) as usize] = pos[((k + 1) * POSLEN + i) as usize]
            i = i + 1
        }
        k = k + 1
    }
    if npos > 1 {
        npos = npos - 1
    }
    status = 0
}

// RUNDE K11: `export` erreicht das Kind. Runde K6 hat die Markierung
// gesetzt und in die Doku geschrieben, dass sie nirgends ankommt; jetzt
// wird sie vor jedem Start in den Kernel geschoben (SYS_OSUM_SETENV), und
// `kernel/elf.fi` legt sie dem Kind auf die Argumentseite.
//
// Vor JEDEM Start und nicht nur beim `export`: eine Variable, die schon
// markiert ist und danach einen neuen Wert bekommt, soll den neuen Wert
// weitergeben.
fn push_env() {
    var buf: [u8; 512] = [0 as u8; 512]
    var at: u64 = 0
    var i: u64 = 0
    while i < nvar {
        if vexp[(i) as usize] == 1 {
            let name: u64 = (&vname[(i * VNAME) as usize]) as u64
            let val: u64 = (&vval[(i * VVAL) as usize]) as u64
            let n1: u64 = ulib.length(name)
            let n2: u64 = ulib.length(val)
            if at + n1 + n2 + 2 < 512 {
                var k: u64 = 0
                while k < n1 {
                    buf[(at + k) as usize] = *((name + k) as *mut u8)
                    k = k + 1
                }
                at = at + n1
                buf[(at) as usize] = 61 as u8
                at = at + 1
                k = 0
                while k < n2 {
                    buf[(at + k) as usize] = *((val + k) as *mut u8)
                    k = k + 1
                }
                at = at + n2
                buf[(at) as usize] = 0 as u8
                at = at + 1
            }
        }
        i = i + 1
    }
    ulib.set_env((&buf[0 as usize]) as u64, at)
}
