
profile kernel

import ulib
import libc.text
import libc.io
import libc.errno
import lineedit.leread

export { u_start }

const LINE: u64 = 256
const MAX_TOK: u64 = 96
const MAX_ARGS: u64 = 64
const WORD_SPACE: u64 = 768
const NVAR: u64 = 8
const VNAME: u64 = 16
const VVAL: u64 = 64
const NBG: u64 = 8
const MAX_STAGE: u64 = 4

const K_WORD: u64 = 0
const K_PIPE: u64 = 1
const K_IN: u64 = 2
const K_OUT: u64 = 3
const K_APP: u64 = 4
const K_ERR: u64 = 5
const K_AMP: u64 = 6
const K_SEMI: u64 = 7
const K_ERRDUP: u64 = 8
const K_OUTDUP: u64 = 9
const K_ERRAPP: u64 = 10
const K_AND: u64 = 11
const K_OR: u64 = 12
const NO_FD: u64 = 0xFFFFFFFF
const FD_MASK: u64 = 0xFFFFFFFF
const FD_SHIFT: u64 = 32

static mut line: [u8; 256] = [0 as u8; 256]
static mut words: [u8; 768] = [0 as u8; 768]
static mut tok_kind: [u64; 96] = [0 as u64; 96]
static mut tok_at: [u64; 96] = [0 as u64; 96]
static mut ntok: u64 = 0
static mut wat: u64 = 0
static mut vname: [u8; 128] = [0 as u8; 128]
static mut vval: [u8; 512] = [0 as u8; 512]
static mut vexp: [u64; 8] = [0 as u64; 8]
static mut nvar: u64 = 0
static mut status: u64 = 0
static mut bg_pid: [u64; 8] = [0 as u64; 8]
static mut nbg: u64 = 0
static mut argv: [u64; 64] = [0 as u64; 64]
static mut argc: u64 = 0
static mut path: [u8; 128] = [0 as u8; 128]
static mut rctx: [u8; 528] = [0 as u8; 528]
static mut interactive: u64 = 0
static mut in_fd: u64 = 0
static mut commands: u64 = 0
static mut stage_pid: [u64; 4] = [0 as u64; 4]
static mut leaving: u64 = 0
static mut did_run: u64 = 0
static mut last_bg: u64 = 0
static mut save_in: u64 = 0
static mut save_out: u64 = 0
static mut save_err: u64 = 0

fn u_start(args: u64) -> u64 {
    var s_hi: [u8; 17] = "sh: ready, osum\n\0"
    var s_bye: [u8; 9] = "sh: bye\n\0"
    var s_nofile: [u8; 19] = "sh: cannot read \0\0\0"

    save_in = ulib.sys(ulib.SYS_DUP, ulib.IN, 0, 0)
    save_out = ulib.sys(ulib.SYS_DUP, ulib.OUT, 0, 0)
    save_err = ulib.sys(ulib.SYS_DUP, ulib.ERR, 0, 0)
    ulib.rd_init((&rctx[0 as usize]) as u64)
    in_fd = ulib.IN
    interactive = 1
    let ac: u64 = ulib.arg_count(args)
    if ac > 1 {
        let p: u64 = ulib.arg_at(args, 1)
        let fd: u64 = ulib.sys(ulib.SYS_OPEN, p, 0, 0)
        if ulib.bad(fd) {
            ulib.esay_line((&s_nofile[0 as usize]) as u64, p)
            return 127
        }
        in_fd = fd
        interactive = 0
        var k: u64 = 1
        npos = 0
        while k < ac && k - 1 < NPOS {
            pos_set(k - 1, ulib.arg_at(args, k))
            npos = k
            k = k + 1
        }
        let rc: u64 = run_script(in_fd)
        ulib.sys(ulib.SYS_CLOSE, in_fd, 0, 0)
        reap_all()
        return rc
    }
    if interactive == 1 {
        ulib.say((&s_hi[0 as usize]) as u64)
    }
    var running: bool = true
    while running {
        let n: u64 = next_line()
        if ulib.bad(n) {
            running = false
        } else {
            if n > 0 {
                if !run_line() {
                    running = false
                }
            }
        }
    }
    reap_all()
    if interactive == 1 {
        ulib.say((&s_bye[0 as usize]) as u64)
        if leaving == 0 {
            return commands
        }
    }
    return status
}

fn prompt() {
    var s_p: [u8; 7] = "osum$ \0"
    ulib.say((&s_p[0 as usize]) as u64)
}

fn next_line() -> u64 {
    var s_p: [u8; 7] = "osum$ \0"
    if interactive == 0 {
        return get_line(in_fd)
    }
    let e: u64 = leread.read_line(in_fd, (&s_p[0 as usize]) as u64, (&line[0 as usize]) as u64, LINE)
    if e != leread.NO_TTY {
        return e
    }
    prompt()
    live_echo(in_fd, true)
    let n: u64 = get_line(in_fd)
    live_echo(in_fd, false)
    if !ulib.bad(n) {
        ulib.say((&line[0 as usize]) as u64)
        ulib.nl()
    }
    return n
}

const SH_IOCTL: u64 = 16
const SH_TCGETS: u64 = 0x5401
const SH_TCSETS: u64 = 0x5402
const SH_ECHOWIN: u64 = 0x20000000

fn live_echo(fd: u64, on: bool) {
    var t: [u8; 40] = [0 as u8; 40]
    if ulib.bad(ulib.sys(SH_IOCTL, fd, SH_TCGETS, (&t[0 as usize]) as u64)) {
        return
    }
    var lf: u64 = __mmio_read32((((&t[12 as usize]) as u64)) as *mut u32) as u64
    if on {
        lf = lf | SH_ECHOWIN
    } else {
        lf = lf & (0xFFFFFFFF - SH_ECHOWIN)
    }
    __mmio_write32((((&t[12 as usize]) as u64)) as *mut u32, lf as u32)
    ulib.sys(SH_IOCTL, fd, SH_TCSETS, (&t[0 as usize]) as u64)
}

fn get_line(fd: u64) -> u64 {
    var c: u64 = ulib.rd_byte(fd, (&rctx[0 as usize]) as u64)
    if c == 256 {
        return ulib.EOF
    }
    var n: u64 = 0
    var es: u64 = 0
    while c != 256 && c != 10 {
        var keep: bool = true
        if es == 2 {
            keep = false
            if c >= 64 && c <= 126 {
                es = 0
            }
        } else if es == 3 {
            keep = false
            es = 0
        } else if es == 1 {
            es = 0
            if c == 27 {
                keep = false
                es = 1
            } else if c == 91 {
                keep = false
                es = 2
            } else if c == 79 {
                keep = false
                es = 3
            }
        } else if c == 27 {
            keep = false
            es = 1
        }
        if !keep {
        } else if c == 8 {
            if n > 0 {
                n = n - 1
            }
        } else {
            if n + 1 < LINE {
                line[n as usize] = c as u8
                n = n + 1
            }
        }
        c = ulib.rd_byte(fd, (&rctx[0 as usize]) as u64)
    }
    line[n as usize] = 0 as u8
    return n
}

fn var_find(name: u64) -> u64 {
    var i: u64 = 0
    while i < nvar {
        if ulib.streq((&vname[(i * VNAME) as usize]) as u64, name) {
            return i
        }
        i = i + 1
    }
    return NVAR
}

fn var_get(name: u64) -> u64 {
    let i: u64 = var_find(name)
    if i >= NVAR {
        return 0
    }
    return (&vval[(i * VVAL) as usize]) as u64
}

fn var_set(name: u64, value: u64) {
    var i: u64 = var_find(name)
    if i >= NVAR {
        if nvar >= NVAR {
            return
        }
        i = nvar
        nvar = nvar + 1
        ulib.strncpy((&vname[(i * VNAME) as usize]) as u64, name, VNAME)
        vexp[i as usize] = 0
    }
    var k: u64 = 0
    while k + 1 < VVAL && *((value + k) as *mut u8) != 0 as u8 {
        vval[(i * VVAL + k) as usize] = *((value + k) as *mut u8)
        k = k + 1
    }
    vval[(i * VVAL + k) as usize] = 0 as u8
}

fn ch(i: u64) -> u64 {
    if i >= LINE {
        return 0
    }
    return (line[i as usize]) as u64
}

fn put_word(c: u64) {
    if wat + 1 < WORD_SPACE {
        words[wat as usize] = c as u8
        wat = wat + 1
    }
}

fn push_tok(kind: u64, at: u64) {
    if ntok >= MAX_TOK {
        return
    }
    tok_kind[ntok as usize] = kind
    tok_at[ntok as usize] = at
    ntok = ntok + 1
}

fn is_name(c: u64) -> bool {
    if c >= 48 && c <= 57 {
        return true
    }
    if c >= 65 && c <= 90 {
        return true
    }
    if c >= 97 && c <= 122 {
        return true
    }
    return c == 95
}

fn expand(i: u64) -> u64 {
    var name: [u8; 20] = [0 as u8; 20]
    if ch(i + 1) == 33 {
        var buf: [u8; 26] = [0 as u8; 26]
        let n: u64 = text.digits(last_bg, (&buf[0 as usize]) as u64, true)
        var k: u64 = 0
        while k < n {
            put_word((buf[k as usize]) as u64)
            k = k + 1
        }
        return i + 2
    }
    if ch(i + 1) == 63 {
        var buf: [u8; 26] = [0 as u8; 26]
        let n: u64 = text.digits(status, (&buf[0 as usize]) as u64, true)
        var k: u64 = 0
        while k < n {
            put_word((buf[k as usize]) as u64)
            k = k + 1
        }
        return i + 2
    }
    if ch(i + 1) == 35 {
        var buf: [u8; 26] = [0 as u8; 26]
        var many: u64 = 0
        if npos > 0 {
            many = npos - 1
        }
        let n: u64 = text.digits(many, (&buf[0 as usize]) as u64, true)
        var k: u64 = 0
        while k < n {
            put_word((buf[k as usize]) as u64)
            k = k + 1
        }
        return i + 2
    }
    if ch(i + 1) >= 48 && ch(i + 1) <= 57 {
        let v0: u64 = pos_get(ch(i + 1) - 48)
        if v0 != 0 {
            var k: u64 = 0
            while *((v0 + k) as *mut u8) != 0 as u8 {
                put_word((*((v0 + k) as *mut u8)) as u64)
                k = k + 1
            }
        }
        return i + 2
    }
    if ch(i + 1) == 123 {
        var name2: [u8; 20] = [0 as u8; 20]
        var at2: u64 = i + 2
        var n2: u64 = 0
        while is_name(ch(at2)) && n2 + 1 < 20 {
            name2[n2 as usize] = ch(at2) as u8
            n2 = n2 + 1
            at2 = at2 + 1
        }
        name2[n2 as usize] = 0 as u8
        if ch(at2) == 125 {
            at2 = at2 + 1
        }
        let v2: u64 = var_get((&name2[0 as usize]) as u64)
        if v2 != 0 {
            var k: u64 = 0
            while *((v2 + k) as *mut u8) != 0 as u8 {
                put_word((*((v2 + k) as *mut u8)) as u64)
                k = k + 1
            }
        }
        return at2
    }
    if !is_name(ch(i + 1)) {
        put_word(36)
        return i + 1
    }
    var at: u64 = i + 1
    var n: u64 = 0
    while is_name(ch(at)) && n + 1 < 20 {
        name[n as usize] = ch(at) as u8
        n = n + 1
        at = at + 1
    }
    name[n as usize] = 0 as u8
    let v: u64 = var_get((&name[0 as usize]) as u64)
    if v != 0 {
        var k: u64 = 0
        while *((v + k) as *mut u8) != 0 as u8 {
            put_word((*((v + k) as *mut u8)) as u64)
            k = k + 1
        }
    }
    return at
}

fn is_break(c: u64) -> bool {
    if c == 0 || c == 32 || c == 9 {
        return true
    }
    return c == 124 || c == 60 || c == 62 || c == 38 || c == 59
}

fn lex_out(at: u64) -> u64 {
    var i: u64 = at
    if ch(i) == 49 {
        i = i + 1
    }
    if ch(i + 1) == 38 && ch(i + 2) == 50 {
        push_tok(K_OUTDUP, 0)
        return i + 3
    }
    if ch(i + 1) == 62 {
        push_tok(K_APP, 0)
        return i + 2
    }
    push_tok(K_OUT, 0)
    return i + 1
}

fn lex_err(at: u64) -> u64 {
    if ch(at + 2) == 38 && ch(at + 3) == 49 {
        push_tok(K_ERRDUP, 0)
        return at + 4
    }
    if ch(at + 2) == 62 {
        push_tok(K_ERRAPP, 0)
        return at + 3
    }
    push_tok(K_ERR, 0)
    return at + 2
}

fn tokenize() -> bool {
    var s_quote: [u8; 26] = "sh: unterminated quote\0\0\0\0"
    ntok = 0
    wat = 0
    var i: u64 = 0
    var going: bool = true
    while going {
        while ch(i) == 32 || ch(i) == 9 {
            i = i + 1
        }
        let c: u64 = ch(i)
        if c == 0 || c == 35 {
            going = false
        } else if c == 124 && ch(i + 1) == 124 {
            push_tok(K_OR, 0)
            i = i + 2
        } else if c == 124 {
            push_tok(K_PIPE, 0)
            i = i + 1
        } else if c == 60 {
            push_tok(K_IN, 0)
            i = i + 1
        } else if c == 38 && ch(i + 1) == 38 {
            push_tok(K_AND, 0)
            i = i + 2
        } else if c == 38 {
            push_tok(K_AMP, 0)
            i = i + 1
        } else if c == 59 {
            push_tok(K_SEMI, 0)
            i = i + 1
        } else if c == 62 || (c == 49 && ch(i + 1) == 62) {
            i = lex_out(i)
        } else if c == 50 && ch(i + 1) == 62 {
            i = lex_err(i)
        } else {
            let start: u64 = wat
            var open: bool = true
            while open {
                let d: u64 = ch(i)
                if is_break(d) {
                    open = false
                } else if d == 39 {
                    i = i + 1
                    while ch(i) != 39 && ch(i) != 0 {
                        put_word(ch(i))
                        i = i + 1
                    }
                    if ch(i) == 0 {
                        ulib.esay_line((&s_quote[0 as usize]) as u64, 0)
                        return false
                    }
                    i = i + 1
                } else if d == 34 {
                    i = i + 1
                    while ch(i) != 34 && ch(i) != 0 {
                        if ch(i) == 92 {
                            let n: u64 = ch(i + 1)
                            if n == 36 || n == 96 || n == 34 || n == 92 {
                                put_word(n)
                                i = i + 2
                            } else {
                                put_word(92)
                                i = i + 1
                            }
                        } else if ch(i) == 36 {
                            i = expand(i)
                        } else {
                            put_word(ch(i))
                            i = i + 1
                        }
                    }
                    if ch(i) == 0 {
                        ulib.esay_line((&s_quote[0 as usize]) as u64, 0)
                        return false
                    }
                    i = i + 1
                } else if d == 36 {
                    i = expand(i)
                } else if d == 92 {
                    if ch(i + 1) == 0 {
                        put_word(92)
                        i = i + 1
                    } else {
                        put_word(ch(i + 1))
                        i = i + 2
                    }
                } else {
                    put_word(d)
                    i = i + 1
                }
            }
            put_word(0)
            push_tok(K_WORD, start)
        }
    }
    return true
}

fn word_at(t: u64) -> u64 {
    return (&words[(tok_at[t as usize]) as usize]) as u64
}

fn is_separator(kind: u64) -> bool {
    return kind == K_SEMI || kind == K_AMP || kind == K_AND || kind == K_OR
}

fn run_line() -> bool {
    if !tokenize() {
        status = 2
        return true
    }
    var i: u64 = 0
    var skip: bool = false
    while i < ntok {
        var j: u64 = i
        while j < ntok && !is_separator(tok_kind[j as usize]) {
            j = j + 1
        }
        var sep: u64 = K_SEMI
        if j < ntok {
            sep = tok_kind[j as usize]
        }
        if j > i && !skip {
            commands = commands + 1
            if !run_pipeline(i, j, sep == K_AMP) {
                return false
            }
        }
        skip = (sep == K_AND && status != 0) || (sep == K_OR && status == 0)
        i = j + 1
    }
    return true
}

fn count_stages(from: u64, to: u64) -> u64 {
    var stages: u64 = 1
    var t: u64 = from
    while t < to {
        if tok_kind[t as usize] == K_PIPE {
            stages = stages + 1
        }
        t = t + 1
    }
    return stages
}

fn close_fd(fd: u64) {
    if fd != NO_FD {
        ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    }
}

fn announce_job(pid: u64) {
    var s_job: [u8; 3] = "[\0\0"
    var s_jend: [u8; 3] = "] \0"
    ulib.say((&s_job[0 as usize]) as u64)
    ulib.sayu(nbg)
    ulib.say((&s_jend[0 as usize]) as u64)
    ulib.sayu(pid)
    ulib.nl()
}

fn keep_job(pid: u64) {
    if nbg < NBG {
        bg_pid[nbg as usize] = pid
        nbg = nbg + 1
    }
    last_bg = pid
}

fn run_pipeline(from: u64, to: u64, bg: bool) -> bool {
    var s_deep: [u8; 24] = "sh: too many stages\0\0\0\0\0"
    var s_pipe: [u8; 24] = "sh: cannot make a pipe\0\0"
    let stages: u64 = count_stages(from, to)
    if stages > MAX_STAGE {
        ulib.esay_line((&s_deep[0 as usize]) as u64, 0)
        status = 2
        return true
    }
    var carry: u64 = NO_FD
    var start: u64 = from
    var k: u64 = 0
    while k < stages {
        var end: u64 = start
        while end < to && tok_kind[end as usize] != K_PIPE {
            end = end + 1
        }
        var out_r: u64 = NO_FD
        var out_w: u64 = NO_FD
        if k + 1 < stages {
            var pfd: [u64; 1] = [0 as u64; 1]
            if errno.failed(io.pipe((&pfd[0 as usize]) as u64)) {
                ulib.esay_line((&s_pipe[0 as usize]) as u64, 0)
                close_fd(carry)
                reap_stages(k)
                status = 2
                return leaving == 0
            }
            out_r = pfd[0 as usize] & FD_MASK
            out_w = (pfd[0 as usize] >> FD_SHIFT) & FD_MASK
        }
        stage_pid[k as usize] = run_stage(start, end, carry, out_w)
        close_fd(carry)
        close_fd(out_w)
        carry = out_r
        start = end + 1
        k = k + 1
    }
    if bg {
        detach_stages(stages)
        return leaving == 0
    }
    reap_stages(stages)
    return leaving == 0
}

fn detach_stages(count: u64) {
    var s: u64 = 0
    while s < count {
        if stage_pid[s as usize] != 0 {
            keep_job(stage_pid[s as usize])
        }
        s = s + 1
    }
    let last: u64 = stage_pid[(count - 1) as usize]
    if last != 0 {
        announce_job(last)
        status = 0
    }
}

fn reap_stages(count: u64) {
    var s_arrow: [u8; 5] = " -> \0"
    var s: u64 = 0
    var waited: bool = false
    while s < count {
        let pid: u64 = stage_pid[s as usize]
        if pid != 0 {
            let code: u64 = ulib.wait_code(pid)
            if s + 1 == count {
                status = code
                waited = true
            }
        }
        s = s + 1
    }
    if waited && interactive == 1 {
        prompt()
        ulib.say(argv[0 as usize])
        ulib.say((&s_arrow[0 as usize]) as u64)
        ulib.sayn(status)
        ulib.nl()
    }
}

fn run_stage(from: u64, to: u64, pin: u64, pout: u64) -> u64 {
    var s_what: [u8; 22] = "sh: missing file name\0"
    var s_many: [u8; 26] = "sh: too many arguments\0\0\0\0"
    argc = 0
    if pin != NO_FD {
        ulib.sys(ulib.SYS_DUP2, pin, 0, 0)
    }
    if pout != NO_FD {
        ulib.sys(ulib.SYS_DUP2, pout, 1, 0)
    }
    var t: u64 = from
    while t < to {
        let kind: u64 = tok_kind[t as usize]
        if kind == K_WORD {
            if argc >= MAX_ARGS {
                ulib.esay_line((&s_many[0 as usize]) as u64, 0)
                status = 2
                undo()
                return 0
            }
            argv[argc as usize] = word_at(t)
            argc = argc + 1
            t = t + 1
        } else if kind == K_ERRDUP {
            ulib.sys(ulib.SYS_DUP2, 1, 2, 0)
            t = t + 1
        } else if kind == K_OUTDUP {
            ulib.sys(ulib.SYS_DUP2, 2, 1, 0)
            t = t + 1
        } else {
            if t + 1 >= to || tok_kind[(t + 1) as usize] != K_WORD {
                ulib.esay_line((&s_what[0 as usize]) as u64, 0)
                status = 2
                undo()
                return 0
            }
            if !apply_redirect(kind, word_at(t + 1)) {
                undo()
                return 0
            }
            t = t + 2
        }
    }
    if argc == 0 {
        undo()
        return 0
    }
    if assignments() {
        status = 0
        undo()
        return 0
    }
    did_run = 0
    let pid: u64 = launch()
    undo()
    return pid
}

fn apply_redirect(kind: u64, name: u64) -> bool {
    if kind == K_IN {
        return redirect(0, name, false)
    }
    if kind == K_ERR || kind == K_ERRAPP {
        return redirect(2, name, kind == K_ERRAPP)
    }
    return redirect(1, name, kind == K_APP)
}

fn eq_at(w: u64) -> u64 {
    let first: u64 = (*((w) as *mut u8)) as u64
    if !is_name(first) || (first >= 48 && first <= 57) {
        return 0
    }
    var n: u64 = 0
    while *((w + n) as *mut u8) != 0 as u8 {
        if *((w + n) as *mut u8) == 61 as u8 {
            if n == 0 {
                return 0
            }
            return n + 1
        }
        if !is_name((*((w + n) as *mut u8)) as u64) {
            return 0
        }
        n = n + 1
    }
    return 0
}

fn assignments() -> bool {
    var name: [u8; 20] = [0 as u8; 20]
    var done: u64 = 0
    var going: bool = true
    while going && done < argc {
        let w: u64 = argv[done as usize]
        let eq: u64 = eq_at(w)
        if eq == 0 {
            going = false
        } else {
            var k: u64 = 0
            while k + 1 < eq && k + 1 < 20 {
                name[k as usize] = *((w + k) as *mut u8)
                k = k + 1
            }
            name[k as usize] = 0 as u8
            var_set((&name[0 as usize]) as u64, w + eq)
            done = done + 1
        }
    }
    if done == argc {
        return true
    }
    if done > 0 {
        var k: u64 = 0
        while done + k < argc {
            argv[k as usize] = argv[(done + k) as usize]
            k = k + 1
        }
        argc = k
    }
    return false
}

fn redirect(fd: u64, name: u64, append: bool) -> bool {
    var s_open: [u8; 20] = "sh: cannot open \0\0\0\0"
    if *((name) as *mut u8) == 0 as u8 {
        return true
    }
    if fd == 0 {
        let r: u64 = ulib.sys(ulib.SYS_OPEN, name, 0, 0)
        if ulib.bad(r) {
            ulib.esay_line((&s_open[0 as usize]) as u64, name)
            status = 2
            return false
        }
        ulib.sys(ulib.SYS_DUP2, r, 0, 0)
        ulib.sys(ulib.SYS_CLOSE, r, 0, 0)
        return true
    }
    var flags: u64 = ulib.O_MAKE
    if append {
        flags = 1089
    }
    let w: u64 = ulib.sys(ulib.SYS_OPEN, name, flags, 0)
    if ulib.bad(w) {
        ulib.esay_line((&s_open[0 as usize]) as u64, name)
        status = 2
        return false
    }
    ulib.sys(ulib.SYS_DUP2, w, fd, 0)
    ulib.sys(ulib.SYS_CLOSE, w, 0, 0)
    return true
}

fn undo() {
    if !ulib.bad(save_in) {
        ulib.sys(ulib.SYS_DUP2, save_in, 0, 0)
    }
    if !ulib.bad(save_out) {
        ulib.sys(ulib.SYS_DUP2, save_out, 1, 0)
    }
    if !ulib.bad(save_err) {
        ulib.sys(ulib.SYS_DUP2, save_err, 2, 0)
    }
}

fn make_path(cmd: u64) {
    var b_bin: [u8; 6] = "/bin/\0"
    var slash: bool = false
    var i: u64 = 0
    while *((cmd + i) as *mut u8) != 0 as u8 {
        if *((cmd + i) as *mut u8) == 47 as u8 {
            slash = true
        }
        i = i + 1
    }
    if slash {
        ulib.strncpy((&path[0 as usize]) as u64, cmd, 128)
        return
    }
    ulib.strcpy((&path[0 as usize]) as u64, (&b_bin[0 as usize]) as u64)
    ulib.strncpy((&path[0 as usize]) as u64 + 5, cmd, 123)
}

fn launch() -> u64 {
    var s_no: [u8; 16] = "sh: cannot run \0"
    var s_arrow: [u8; 5] = " -> \0"
    if builtin() {
        return 0
    }
    make_path(argv[0 as usize])
    push_env()
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&path[0 as usize]) as u64,
        (&argv[0 as usize]) as u64, argc)
    if ulib.bad(pid) {
        ulib.eput((&s_no[0 as usize]) as u64)
        ulib.eput(argv[0 as usize])
        ulib.eput((&s_arrow[0 as usize]) as u64)
        say_err(pid)
        status = 127
        return 0
    }
    return pid
}

fn say_err(v: u64) {
    var buf: [u8; 26] = [0 as u8; 26]
    text.digits(v, (&buf[0 as usize]) as u64, true)
    ulib.eput((&buf[0 as usize]) as u64)
    var nlc: [u8; 2] = "\n\0"
    ulib.eput((&nlc[0 as usize]) as u64)
}

fn builtin() -> bool {
    var c_cd: [u8; 3] = "cd\0"
    var c_pwd: [u8; 4] = "pwd\0"
    var c_exit: [u8; 5] = "exit\0"
    var c_export: [u8; 7] = "export\0"
    var c_wait: [u8; 5] = "wait\0"
    var c_test: [u8; 5] = "test\0"
    var c_brk: [u8; 2] = "[\0"
    var c_shift: [u8; 6] = "shift\0"
    var c_clip: [u8; 5] = "clip\0"
    let w: u64 = argv[0 as usize]
    if ulib.streq(w, (&c_clip[0 as usize]) as u64) {
        do_clip()
        return true
    }
    if ulib.streq(w, (&c_test[0 as usize]) as u64) {
        status = do_test(false)
        return true
    }
    if ulib.streq(w, (&c_brk[0 as usize]) as u64) {
        status = do_test(true)
        return true
    }
    if ulib.streq(w, (&c_shift[0 as usize]) as u64) {
        do_shift()
        return true
    }
    if ulib.streq(w, (&c_cd[0 as usize]) as u64) {
        do_cd()
        return true
    }
    if ulib.streq(w, (&c_pwd[0 as usize]) as u64) {
        do_pwd()
        return true
    }
    if ulib.streq(w, (&c_exit[0 as usize]) as u64) {
        leaving = 1
        if argc > 1 {
            status = ulib.to_num(argv[1 as usize])
        }
        return true
    }
    if ulib.streq(w, (&c_export[0 as usize]) as u64) {
        do_export()
        return true
    }
    if ulib.streq(w, (&c_wait[0 as usize]) as u64) {
        reap_all()
        status = 0
        return true
    }
    return false
}

fn do_clip() {
    var buf: [u8; 192] = [0 as u8; 192]
    var s_l: [u8; 3] = "-l\0"
    var s_empty: [u8; 22] = "clip: nichts abgelegt\0"
    var s_kein: [u8; 25] = "clip: kein Bus (nobus?)\n\0"
    var s_nr: [u8; 3] = " [\0"
    var s_zu: [u8; 3] = "] \0"
    var s_pid: [u8; 6] = " pid=\0"
    if !ulib.bus_da() {
        ulib.say((&s_kein[0 as usize]) as u64)
        status = 1
        return
    }
    if argc > 1 && ulib.streq(argv[1 as usize], (&s_l[0 as usize]) as u64) {
        let n: u64 = ulib.clip_count()
        var i: u64 = 0
        while i < n {
            let m: u64 = ulib.clip_hist_take(i, (&buf[0 as usize]) as u64, 191)
            ulib.say((&s_nr[0 as usize]) as u64)
            ulib.sayn(i)
            ulib.say((&s_zu[0 as usize]) as u64)
            ulib.put((&buf[0 as usize]) as u64, m)
            ulib.say((&s_pid[0 as usize]) as u64)
            ulib.sayn(ulib.clip_owner(i))
            ulib.nl()
            i = i + 1
        }
        status = 0
        return
    }
    if argc > 1 {
        var at: u64 = 0
        var k: u64 = 1
        while k < argc && at < 190 {
            let a: u64 = argv[(k) as usize]
            var j: u64 = 0
            while at < 190 && *((a + j) as *mut u8) != 0 as u8 {
                buf[(at) as usize] = *((a + j) as *mut u8)
                at = at + 1
                j = j + 1
            }
            if k + 1 < argc && at < 190 {
                buf[(at) as usize] = 32 as u8
                at = at + 1
            }
            k = k + 1
        }
        let r: u64 = ulib.clip_put(ulib.BT_TEXT, (&buf[0 as usize]) as u64, at)
        if ulib.bad(r) {
            status = 1
            return
        }
        status = 0
        return
    }
    let m: u64 = ulib.clip_take((&buf[0 as usize]) as u64, 191)
    if m == 0 {
        ulib.say_line((&s_empty[0 as usize]) as u64, ulib.clip_count())
        status = 1
        return
    }
    ulib.put((&buf[0 as usize]) as u64, m)
    ulib.nl()
    status = 0
}

fn do_cd() {
    var home: [u8; 2] = "/\0"
    var s_no: [u8; 20] = "sh: cannot cd to \0\0\0"
    var target: u64 = (&home[0 as usize]) as u64
    if argc > 1 {
        target = argv[1 as usize]
    }
    let r: u64 = ulib.sys(ulib.SYS_CHDIR, target, 0, 0)
    if ulib.bad(r) {
        ulib.esay_line((&s_no[0 as usize]) as u64, target)
        status = 1
        return
    }
    status = 0
}

fn do_pwd() {
    var buf: [u8; 96] = [0 as u8; 96]
    let n: u64 = ulib.sys(ulib.SYS_GETCWD, (&buf[0 as usize]) as u64, 96, 0)
    if ulib.bad(n) || n == 0 {
        status = 1
        return
    }
    ulib.put((&buf[0 as usize]) as u64, n - 1)
    ulib.nl()
    status = 0
}

fn do_export() {
    var s_eq: [u8; 2] = "=\0"
    if argc == 1 {
        var i: u64 = 0
        while i < nvar {
            if vexp[i as usize] == 1 {
                ulib.say((&vname[(i * VNAME) as usize]) as u64)
                ulib.say((&s_eq[0 as usize]) as u64)
                ulib.say((&vval[(i * VVAL) as usize]) as u64)
                ulib.nl()
            }
            i = i + 1
        }
        status = 0
        return
    }
    var k: u64 = 1
    while k < argc {
        let i: u64 = var_find(argv[k as usize])
        if i < NVAR {
            vexp[i as usize] = 1
        }
        k = k + 1
    }
    status = 0
}

fn reap_all() {
    var s_done: [u8; 2] = "[\0"
    var s_arrow: [u8; 6] = "] -> \0"
    var i: u64 = 0
    while i < nbg {
        let code: u64 = ulib.wait_code(bg_pid[i as usize])
        ulib.say((&s_done[0 as usize]) as u64)
        ulib.sayu(bg_pid[i as usize])
        ulib.say((&s_arrow[0 as usize]) as u64)
        ulib.sayn(code)
        ulib.nl()
        i = i + 1
    }
    nbg = 0
}

const SRCMAX: u64 = 16384
const STMTS: u64 = 512
const NFUNC: u64 = 16
const FNLEN: u64 = 24
const NPOS: u64 = 10
const POSLEN: u64 = 64
const FORBUF: u64 = 1024
const FORMAX: u64 = 32

static mut src: [u8; 16384] = [0 as u8; 16384]
static mut raw: [u8; 16384] = [0 as u8; 16384]
static mut nraw: u64 = 0
static mut nsrc: u64 = 0
static mut sat: [u64; 512] = [0 as u64; 512]
static mut slen: [u64; 512] = [0 as u64; 512]
static mut nstmt: u64 = 0
static mut fn_name: [u8; 384] = [0 as u8; 384]
static mut fn_beg: [u64; 16] = [0 as u64; 16]
static mut fn_end: [u64; 16] = [0 as u64; 16]
static mut nfunc: u64 = 0
static mut pos: [u8; 640] = [0 as u8; 640]
static mut npos: u64 = 0
static mut ret_flag: u64 = 0
static mut brk_flag: u64 = 0
static mut cont_flag: u64 = 0
static mut calls: u64 = 0
static mut kwbuf: [u8; 32] = [0 as u8; 32]

const W_IF: u64 = 1
const W_THEN: u64 = 2
const W_ELIF: u64 = 3
const W_ELSE: u64 = 4
const W_FI: u64 = 5
const W_WHILE: u64 = 6
const W_UNTIL: u64 = 7
const W_FOR: u64 = 8
const W_DO: u64 = 9
const W_DONE: u64 = 10
const W_CASE: u64 = 11
const W_ESAC: u64 = 12
const W_IN: u64 = 13
const W_RETURN: u64 = 14
const W_BREAK: u64 = 15
const W_CONTINUE: u64 = 16
const W_COLON: u64 = 17
const W_SEMI2: u64 = 18
const W_OPEN: u64 = 19
const W_CLOSE: u64 = 20

static mut KWTAB: [u8; 89] = "if\0then\0elif\0else\0fi\0while\0until\0for\0do\0done\0case\0esac\0in\0return\0break\0continue\0:\0;;\0{\0}\0"

fn kw_id_of(p: u64) -> u64 {
    var at: u64 = 0
    var id: u64 = 1
    while at < 89 {
        if KWTAB[(at) as usize] == 0 as u8 {
            return 0
        }
        if ulib.streq((&KWTAB[(at) as usize]) as u64, p) {
            return id
        }
        while KWTAB[(at) as usize] != 0 as u8 {
            at = at + 1
        }
        at = at + 1
        id = id + 1
    }
    return 0
}

fn kw_id(i: u64) -> u64 {
    return kw_id_of(kw_of(i))
}

fn add_stmt(from: u64, to: u64) {
    var a: u64 = from
    var b: u64 = to
    while a < b && (src[(a) as usize] == 32 as u8 || src[(a) as usize] == 9 as u8) {
        a = a + 1
    }
    while b > a && (src[(b - 1) as usize] == 32 as u8
        || src[(b - 1) as usize] == 9 as u8) {
        b = b - 1
    }
    if b <= a || nstmt >= STMTS {
        return
    }
    let w: u64 = word_end(a, b)
    if w - a >= 3 && src[(w - 2) as usize] == 40 as u8
    && src[(w - 1) as usize] == 41 as u8 && w < b {
        sat[(nstmt) as usize] = a
        slen[(nstmt) as usize] = w - a
        nstmt = nstmt + 1
        add_stmt(w, b)
        return
    }
    if w - a == 1 && src[(a) as usize] == 123 as u8 && w < b {
        sat[(nstmt) as usize] = a
        slen[(nstmt) as usize] = 1
        nstmt = nstmt + 1
        add_stmt(w, b)
        return
    }
    if lead(a, w) {
        sat[(nstmt) as usize] = a
        slen[(nstmt) as usize] = w - a
        nstmt = nstmt + 1
        add_stmt(w, b)
        return
    }
    sat[(nstmt) as usize] = a
    slen[(nstmt) as usize] = b - a
    nstmt = nstmt + 1
}

fn word_end(a: u64, b: u64) -> u64 {
    var i: u64 = a
    while i < b && src[(i) as usize] != 32 as u8 && src[(i) as usize] != 9 as u8 {
        i = i + 1
    }
    return i
}

fn lit_eq(a: u64, n: u64, p: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if src[(a + i) as usize] != *((p + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return *((p + n) as *mut u8) == 0 as u8
}

fn lead(a: u64, w: u64) -> bool {
    var buf: [u8; 32] = [0 as u8; 32]
    var n: u64 = w - a
    if n > 30 {
        return false
    }
    var k: u64 = 0
    while k < n {
        buf[(k) as usize] = src[(a + k) as usize]
        k = k + 1
    }
    buf[(n) as usize] = 0 as u8
    let id: u64 = kw_id_of((&buf[0 as usize]) as u64)
    return id == W_THEN || id == W_ELSE || id == W_DO
}

fn split_all() {
    nstmt = 0
    var i: u64 = 0
    while i < nsrc {
        while i < nsrc && (src[(i) as usize] == 32 as u8
            || src[(i) as usize] == 9 as u8 || src[(i) as usize] == 10 as u8) {
            i = i + 1
        }
        if i < nsrc && src[(i) as usize] == 59 as u8 {
            if i + 1 < nsrc && src[(i + 1) as usize] == 59 as u8 {
                if nstmt < STMTS {
                    sat[(nstmt) as usize] = i
                    slen[(nstmt) as usize] = 2
                    nstmt = nstmt + 1
                }
                i = i + 2
            } else {
                i = i + 1
            }
        } else if i < nsrc && src[(i) as usize] == 35 as u8 {
            while i < nsrc && src[(i) as usize] != 10 as u8 {
                i = i + 1
            }
        } else if i < nsrc {
            let start: u64 = i
            var q: u64 = 0
            var going: bool = true
            while going && i < nsrc {
                let c: u64 = (src[(i) as usize]) as u64
                if q != 0 {
                    if c == q {
                        q = 0
                    }
                    i = i + 1
                } else if c == 39 || c == 34 {
                    q = c
                    i = i + 1
                } else if c == 10 || c == 59 {
                    going = false
                } else if c == 35 && i > start
                && (src[(i - 1) as usize] == 32 as u8
                    || src[(i - 1) as usize] == 9 as u8) {
                    going = false
                } else {
                    i = i + 1
                }
            }
            add_stmt(start, i)
            if i < nsrc && src[(i) as usize] == 35 as u8 {
                while i < nsrc && src[(i) as usize] != 10 as u8 {
                    i = i + 1
                }
            }
        }
    }
}

fn kw_of(i: u64) -> u64 {
    let a: u64 = sat[(i) as usize]
    let b: u64 = a + slen[(i) as usize]
    let w: u64 = word_end(a, b)
    var n: u64 = w - a
    if n > 30 {
        n = 30
    }
    var k: u64 = 0
    while k < n {
        kwbuf[(k) as usize] = src[(a + k) as usize]
        k = k + 1
    }
    kwbuf[(n) as usize] = 0 as u8
    return (&kwbuf[0 as usize]) as u64
}

fn kw_is(i: u64, p: u64) -> bool {
    return ulib.streq(kw_of(i), p)
}

fn tail_of(i: u64) -> u64 {
    let a: u64 = sat[(i) as usize]
    let b: u64 = a + slen[(i) as usize]
    var w: u64 = word_end(a, b)
    while w < b && (src[(w) as usize] == 32 as u8
        || src[(w) as usize] == 9 as u8) {
        w = w + 1
    }
    return w
}

fn tail_len(i: u64) -> u64 {
    let a: u64 = sat[(i) as usize]
    let b: u64 = a + slen[(i) as usize]
    let w: u64 = tail_of(i)
    if w >= b {
        return 0
    }
    return b - w
}

fn opener(i: u64) -> bool {
    let id: u64 = kw_id(i)
    return id == W_IF || id == W_WHILE || id == W_UNTIL || id == W_FOR
        || id == W_CASE
}

fn closer(i: u64) -> bool {
    let id: u64 = kw_id(i)
    return id == W_FI || id == W_DONE || id == W_ESAC
}

fn scan_to(from: u64, to: u64, a: u64, b: u64, c: u64) -> u64 {
    var depth: u64 = 0
    var i: u64 = from
    while i < to {
        if depth == 0 {
            let w: u64 = kw_id(i)
            if w != 0 && (w == a || w == b || w == c) {
                return i
            }
        }
        if opener(i) {
            depth = depth + 1
        } else if closer(i) {
            if depth > 0 {
                depth = depth - 1
            }
        }
        i = i + 1
    }
    return to
}

fn run_text(p: u64, n: u64) -> bool {
    var k: u64 = 0
    while k < n && k + 1 < LINE {
        line[(k) as usize] = *((p + k) as *mut u8)
        k = k + 1
    }
    line[(k) as usize] = 0 as u8
    if k == 0 {
        return true
    }
    return run_line()
}

fn run_stmt(i: u64) -> bool {
    return run_text((&src[(sat[(i) as usize]) as usize]) as u64,
        slen[(i) as usize])
}

fn tokenize_stmt(i: u64) -> bool {
    var k: u64 = 0
    let n: u64 = slen[(i) as usize]
    let p: u64 = (&src[(sat[(i) as usize]) as usize]) as u64
    while k < n && k + 1 < LINE {
        line[(k) as usize] = *((p + k) as *mut u8)
        k = k + 1
    }
    line[(k) as usize] = 0 as u8
    return tokenize()
}

fn wild(pat: u64, s: u64) -> bool {
    var p: u64 = 0
    var t: u64 = 0
    var star: u64 = ulib.EOF
    var back: u64 = 0
    var done: bool = false
    var result: bool = false
    while !done {
        let sc: u64 = (*((s + t) as *mut u8)) as u64
        let pc: u64 = (*((pat + p) as *mut u8)) as u64
        if pc == 0 && sc == 0 {
            result = true
            done = true
        } else if pc == 42 {
            star = p
            p = p + 1
            back = t
        } else if sc != 0 && (pc == 63 || pc == sc) {
            p = p + 1
            t = t + 1
        } else if star != ulib.EOF && sc != 0 {
            p = star + 1
            back = back + 1
            t = back
        } else {
            result = false
            done = true
        }
    }
    return result
}

fn num_cmp(a: u64, op: u64, b: u64) -> bool {
    let x: u64 = ulib.to_num(a)
    let y: u64 = ulib.to_num(b)
    if op == 1 {
        return x == y
    }
    if op == 2 {
        return x != y
    }
    if op == 3 {
        return x < y
    }
    if op == 4 {
        return x <= y
    }
    if op == 5 {
        return x > y
    }
    return x >= y
}

static mut OPTAB: [u8; 52] = "-eq\0-ne\0-lt\0-le\0-gt\0-ge\0-e\0-f\0-d\0-r\0-s\0-n\0-z\0=\0!=\0!\0"

fn op_id(p: u64) -> u64 {
    var at: u64 = 0
    var id: u64 = 1
    while at < 52 {
        if OPTAB[(at) as usize] == 0 as u8 {
            return 0
        }
        if ulib.streq((&OPTAB[(at) as usize]) as u64, p) {
            return id
        }
        while OPTAB[(at) as usize] != 0 as u8 {
            at = at + 1
        }
        at = at + 1
        id = id + 1
    }
    return 0
}

fn num_op(p: u64) -> u64 {
    let id: u64 = op_id(p)
    if id >= 1 && id <= 6 {
        return id
    }
    return 0
}

fn do_test(as_bracket: bool) -> u64 {
    var n: u64 = argc
    if as_bracket {
        if n > 1 {
            n = n - 1
        }
    }
    var at: u64 = 1
    var invert: bool = false
    while at < n && op_id(argv[(at) as usize]) == 16 {
        invert = !invert
        at = at + 1
    }
    var yes: bool = false
    let left: u64 = n - at
    if left == 1 {
        yes = *((argv[(at) as usize]) as *mut u8) != 0 as u8
    } else if left == 2 {
        let o: u64 = op_id(argv[(at) as usize])
        let v: u64 = argv[(at + 1) as usize]
        if o == 7 || o == 10 {
            yes = !ulib.bad(io.size_of(v)) || ulib.is_dir(v)
        } else if o == 8 {
            yes = !ulib.bad(io.size_of(v)) && !ulib.is_dir(v)
        } else if o == 9 {
            yes = ulib.is_dir(v)
        } else if o == 11 {
            let sz: u64 = io.size_of(v)
            yes = !ulib.bad(sz) && sz > 0
        } else if o == 12 {
            yes = *((v) as *mut u8) != 0 as u8
        } else if o == 13 {
            yes = *((v) as *mut u8) == 0 as u8
        }
    } else if left >= 3 {
        let a: u64 = argv[(at) as usize]
        let o: u64 = op_id(argv[(at + 1) as usize])
        let b: u64 = argv[(at + 2) as usize]
        if o >= 1 && o <= 6 {
            yes = num_cmp(a, o, b)
        } else if o == 14 {
            yes = ulib.streq(a, b)
        } else if o == 15 {
            yes = !ulib.streq(a, b)
        }
    }
    if invert {
        yes = !yes
    }
    if yes {
        return 0
    }
    return 1
}

fn func_find(name: u64) -> u64 {
    var i: u64 = 0
    while i < nfunc {
        if ulib.streq((&fn_name[(i * FNLEN) as usize]) as u64, name) {
            return i
        }
        i = i + 1
    }
    return NFUNC
}

fn pos_set(k: u64, p: u64) {
    if k >= NPOS {
        return
    }
    ulib.strncpy((&pos[(k * POSLEN) as usize]) as u64, p, POSLEN)
}

fn pos_get(k: u64) -> u64 {
    if k >= NPOS || k >= npos {
        return 0
    }
    return (&pos[(k * POSLEN) as usize]) as u64
}

fn exec_range(from: u64, to: u64) -> bool {
    var i: u64 = from
    while i < to && ret_flag == 0 && brk_flag == 0 && cont_flag == 0 {
        let w: u64 = kw_id(i)
        if w == W_IF {
            i = do_if(i, to)
            if i == ulib.EOF {
                return false
            }
        } else if w == W_WHILE || w == W_UNTIL {
            let r: u64 = do_while(i, to, w == W_UNTIL)
            if r == ulib.EOF {
                return false
            }
            i = r
        } else if w == W_FOR {
            let r: u64 = do_for(i, to)
            if r == ulib.EOF {
                return false
            }
            i = r
        } else if w == W_CASE {
            let r: u64 = do_case(i, to)
            if r == ulib.EOF {
                return false
            }
            i = r
        } else if w == W_RETURN {
            if tail_len(i) > 0 {
                status = ulib.to_num((&src[(tail_of(i)) as usize]) as u64)
            }
            ret_flag = 1
            i = i + 1
        } else if w == W_BREAK {
            brk_flag = 1
            i = i + 1
        } else if w == W_CONTINUE {
            cont_flag = 1
            i = i + 1
        } else if w == W_COLON {
            status = 0
            i = i + 1
        } else if w != 0 {
            i = i + 1
        } else if is_funcdef(i) {
            i = def_func(i, to)
        } else {
            if !run_one(i) {
                return false
            }
            i = i + 1
        }
    }
    return true
}

fn run_one(i: u64) -> bool {
    if !tokenize_stmt(i) {
        status = 2
        return true
    }
    if ntok == 0 {
        return true
    }
    let first: u64 = word_at(0)
    let f: u64 = func_find(first)
    if f < NFUNC && tok_kind[0 as usize] == K_WORD {
        return call_func(f)
    }
    return run_stmt(i)
}

fn call_func(f: u64) -> bool {
    var save: [u8; 640] = [0 as u8; 640]
    var s_deep: [u8; 24] = "sh: functions too deep\0\0"
    if calls >= 8 {
        ulib.esay_line((&s_deep[0 as usize]) as u64, 0)
        status = 2
        return true
    }
    var k: u64 = 0
    while k < NPOS * POSLEN {
        save[(k) as usize] = pos[(k) as usize]
        k = k + 1
    }
    let saved_n: u64 = npos
    npos = 0
    k = 0
    while k < ntok && k < NPOS {
        if tok_kind[(k) as usize] == K_WORD {
            pos_set(k, word_at(k))
            npos = k + 1
        }
        k = k + 1
    }
    calls = calls + 1
    let alive: bool = exec_range(fn_beg[(f) as usize], fn_end[(f) as usize])
    calls = calls - 1
    ret_flag = 0
    k = 0
    while k < NPOS * POSLEN {
        pos[(k) as usize] = save[(k) as usize]
        k = k + 1
    }
    npos = saved_n
    return alive
}

fn is_funcdef(i: u64) -> bool {
    let a: u64 = sat[(i) as usize]
    let b: u64 = a + slen[(i) as usize]
    let w: u64 = word_end(a, b)
    if w - a < 3 {
        return false
    }
    return src[(w - 2) as usize] == 40 as u8 && src[(w - 1) as usize] == 41 as u8
}

fn def_func(i: u64, to: u64) -> u64 {
    let a: u64 = sat[(i) as usize]
    let b: u64 = a + slen[(i) as usize]
    let w: u64 = word_end(a, b)
    var n: u64 = w - a - 2
    if n + 1 >= FNLEN {
        n = FNLEN - 1
    }
    if nfunc >= NFUNC {
        return i + 1
    }
    var k: u64 = 0
    while k < n {
        fn_name[(nfunc * FNLEN + k) as usize] = src[(a + k) as usize]
        k = k + 1
    }
    fn_name[(nfunc * FNLEN + n) as usize] = 0 as u8
    var body: u64 = i + 1
    let end: u64 = scan_to(body, to, W_CLOSE, 0, 0)
    if body < to && kw_id(body) == W_OPEN && slen[(body) as usize] == 1 {
        body = body + 1
    }
    fn_beg[(nfunc) as usize] = body
    fn_end[(nfunc) as usize] = end
    nfunc = nfunc + 1
    if end < to {
        return end + 1
    }
    return to
}

fn do_if(i: u64, to: u64) -> u64 {
    let fi: u64 = scan_to(i + 1, to, W_FI, 0, 0)
    var head: u64 = i
    var done: bool = false
    var alive: bool = true
    while !done {
        let then_at: u64 = scan_to(head + 1, fi, W_THEN, 0, 0)
        if then_at >= fi {
            done = true
        } else {
            if tail_len(head) > 0 {
                if !run_text((&src[(tail_of(head)) as usize]) as u64,
                    tail_len(head)) {
                    return ulib.EOF
                }
            }
            var c: u64 = head + 1
            while c < then_at {
                if !run_stmt(c) {
                    return ulib.EOF
                }
                c = c + 1
            }
            let ok: bool = status == 0
            let next: u64 = scan_to(then_at + 1, fi, W_ELIF, W_ELSE, 0)
            if ok {
                if !exec_range(then_at + 1, next) {
                    return ulib.EOF
                }
                done = true
            } else if next < fi && kw_id(next) == W_ELSE {
                if !exec_range(next + 1, fi) {
                    return ulib.EOF
                }
                done = true
            } else if next < fi {
                head = next
            } else {
                status = 0
                done = true
            }
        }
    }
    if fi < to {
        return fi + 1
    }
    return to
}

fn do_while(i: u64, to: u64, invert: bool) -> u64 {
    let done_at: u64 = scan_to(i + 1, to, W_DONE, 0, 0)
    let do_at: u64 = scan_to(i + 1, done_at, W_DO, 0, 0)
    if do_at >= done_at {
        return done_at
    }
    var rounds: u64 = 0
    var going: bool = true
    while going {
        if tail_len(i) > 0 {
            if !run_text((&src[(tail_of(i)) as usize]) as u64, tail_len(i)) {
                return ulib.EOF
            }
        }
        var c: u64 = i + 1
        while c < do_at {
            if !run_stmt(c) {
                return ulib.EOF
            }
            c = c + 1
        }
        var ok: bool = status == 0
        if invert {
            ok = !ok
        }
        if !ok {
            going = false
        } else {
            if !exec_range(do_at + 1, done_at) {
                return ulib.EOF
            }
            cont_flag = 0
            if brk_flag == 1 {
                brk_flag = 0
                going = false
            }
            if ret_flag == 1 {
                going = false
            }
            rounds = rounds + 1
            if rounds > 100000 {
                going = false
            }
        }
    }
    if done_at < to {
        return done_at + 1
    }
    return to
}

fn do_for(i: u64, to: u64) -> u64 {
    var buf: [u8; 1024] = [0 as u8; 1024]
    var at: [u64; 32] = [0 as u64; 32]
    var name: [u8; 24] = [0 as u8; 24]
    let done_at: u64 = scan_to(i + 1, to, W_DONE, 0, 0)
    let do_at: u64 = scan_to(i + 1, done_at, W_DO, 0, 0)
    if do_at >= done_at {
        return done_at
    }
    if !tokenize_stmt(i) {
        status = 2
        return done_at + 1
    }
    if ntok < 2 {
        return done_at + 1
    }
    ulib.strncpy((&name[0 as usize]) as u64, word_at(1), 24)
    var k: u64 = 2
    if k < ntok && kw_id_of(word_at(k)) == W_IN {
        k = k + 1
    }
    var n: u64 = 0
    var used: u64 = 0
    while k < ntok && n < FORMAX {
        let p: u64 = word_at(k)
        var j: u64 = 0
        var start: u64 = used
        var any: bool = false
        var going: bool = true
        while going {
            let c: u64 = (*((p + j) as *mut u8)) as u64
            if c == 0 || c == 32 || c == 9 {
                if any && n < FORMAX && used + 1 < FORBUF {
                    buf[(used) as usize] = 0 as u8
                    used = used + 1
                    at[(n) as usize] = start
                    n = n + 1
                }
                any = false
                start = used
                if c == 0 {
                    going = false
                }
            } else if used + 2 < FORBUF {
                buf[(used) as usize] = c as u8
                used = used + 1
                any = true
            }
            j = j + 1
        }
        k = k + 1
    }
    var idx: u64 = 0
    while idx < n {
        var_set((&name[0 as usize]) as u64, (&buf[(at[(idx) as usize]) as usize]) as u64)
        if !exec_range(do_at + 1, done_at) {
            return ulib.EOF
        }
        cont_flag = 0
        if brk_flag == 1 {
            brk_flag = 0
            idx = n
        }
        if ret_flag == 1 {
            idx = n
        }
        idx = idx + 1
    }
    if done_at < to {
        return done_at + 1
    }
    return to
}

fn do_case(i: u64, to: u64) -> u64 {
    var subject: [u8; 128] = [0 as u8; 128]
    var pat: [u8; 128] = [0 as u8; 128]
    let esac: u64 = scan_to(i + 1, to, W_ESAC, 0, 0)
    if !tokenize_stmt(i) {
        status = 2
        return esac + 1
    }
    if ntok < 2 {
        return esac + 1
    }
    ulib.strncpy((&subject[0 as usize]) as u64, word_at(1), 128)
    var j: u64 = i + 1
    var hit: bool = false
    while j < esac && !hit {
        let a: u64 = sat[(j) as usize]
        let b: u64 = a + slen[(j) as usize]
        var close: u64 = a
        var q: u64 = 0
        while close < b && (q != 0 || src[(close) as usize] != 41 as u8) {
            let c: u64 = (src[(close) as usize]) as u64
            if q != 0 {
                if c == q {
                    q = 0
                }
            } else if c == 39 || c == 34 {
                q = c
            }
            close = close + 1
        }
        if close >= b {
            j = j + 1
        } else {
            var start: u64 = a
            var m: u64 = a
            var matched: bool = false
            while m <= close {
                if m == close || src[(m) as usize] == 124 as u8 {
                    var n: u64 = m - start
                    if n + 1 >= 128 {
                        n = 127
                    }
                    var q2: u64 = 0
                    while q2 < n {
                        pat[(q2) as usize] = src[(start + q2) as usize]
                        q2 = q2 + 1
                    }
                    pat[(n) as usize] = 0 as u8
                    if wild((&pat[0 as usize]) as u64,
                        (&subject[0 as usize]) as u64) {
                        matched = true
                    }
                    start = m + 1
                }
                m = m + 1
            }
            let stop: u64 = scan_to(j + 1, esac, W_SEMI2, 0, 0)
            if matched {
                hit = true
                status = 0
                var rest: u64 = close + 1
                while rest < b && (src[(rest) as usize] == 32 as u8
                    || src[(rest) as usize] == 9 as u8) {
                    rest = rest + 1
                }
                if rest < b {
                    if !run_text((&src[(rest) as usize]) as u64, b - rest) {
                        return ulib.EOF
                    }
                }
                if !exec_range(j + 1, stop) {
                    return ulib.EOF
                }
            }
            j = stop + 1
        }
    }
    if !hit {
        status = 0
    }
    if esac < to {
        return esac + 1
    }
    return to
}

fn read_all(fd: u64) -> bool {
    nraw = 0
    var going: bool = true
    while going {
        let n: u64 = ulib.sys(ulib.SYS_READ, fd,
            (&raw[(nraw) as usize]) as u64, 4096)
        if n == 0 || ulib.bad(n) {
            going = false
        } else {
            nraw = nraw + n
            if nraw + 4096 > SRCMAX {
                return false
            }
        }
    }
    return edit_pass()
}

fn edit_pass() -> bool {
    var last: [u8; 256] = [0 as u8; 256]
    var cur: [u8; 256] = [0 as u8; 256]
    nsrc = 0
    var i: u64 = 0
    var n: u64 = 0
    var going: bool = true
    while going {
        let at_end: bool = i >= nraw
        var c: u64 = 10
        if !at_end {
            c = (raw[(i) as usize]) as u64
        }
        if c == 10 {
            if nsrc + n + 2 >= SRCMAX {
                return false
            }
            var k: u64 = 0
            while k < n {
                src[(nsrc + k) as usize] = cur[(k) as usize]
                k = k + 1
            }
            nsrc = nsrc + n
            src[(nsrc) as usize] = 10 as u8
            nsrc = nsrc + 1
            if n > 0 {
                k = 0
                while k <= n {
                    last[(k) as usize] = cur[(k) as usize]
                    k = k + 1
                }
            }
            n = 0
            if at_end {
                going = false
            }
        } else if c == 8 {
            if n > 0 {
                n = n - 1
            }
        } else if c == 14 {
            n = 0
            while last[(n) as usize] != 0 as u8 && n + 1 < LINE {
                cur[(n) as usize] = last[(n) as usize]
                n = n + 1
            }
        } else if n + 1 < LINE {
            cur[(n) as usize] = c as u8
            n = n + 1
        }
        cur[(n) as usize] = 0 as u8
        i = i + 1
    }
    return true
}

fn run_script(fd: u64) -> u64 {
    var s_big: [u8; 22] = "sh: script too big\0\0\0\0"
    if !read_all(fd) {
        ulib.esay_line((&s_big[0 as usize]) as u64, 0)
        return 2
    }
    split_all()
    exec_range(0, nstmt)
    return status
}

fn do_shift() {
    var k: u64 = 1
    while k + 1 < npos {
        var i: u64 = 0
        while i < POSLEN {
            pos[(k * POSLEN + i) as usize] = pos[((k + 1) * POSLEN + i) as usize]
            i = i + 1
        }
        k = k + 1
    }
    if npos > 1 {
        npos = npos - 1
    }
    status = 0
}

fn push_env() {
    var buf: [u8; 512] = [0 as u8; 512]
    var at: u64 = 0
    var n: u64 = nvar
    if n > NVAR {
        n = NVAR
    }
    var i: u64 = 0
    while i < n {
        if vexp[(i) as usize] == 1 {
            var k: u64 = 0
            var start: u64 = at
            var ok: bool = true
            while k + 1 < VNAME && vname[(i * VNAME + k) as usize] != 0 as u8 {
                if at + 3 >= 512 {
                    ok = false
                    k = VNAME
                } else {
                    buf[(at) as usize] = vname[(i * VNAME + k) as usize]
                    at = at + 1
                    k = k + 1
                }
            }
            if ok && at + 2 < 512 {
                buf[(at) as usize] = 61 as u8
                at = at + 1
                k = 0
                while k + 1 < VVAL && vval[(i * VVAL + k) as usize] != 0 as u8 {
                    if at + 2 >= 512 {
                        ok = false
                        k = VVAL
                    } else {
                        buf[(at) as usize] = vval[(i * VVAL + k) as usize]
                        at = at + 1
                        k = k + 1
                    }
                }
            } else {
                ok = false
            }
            if ok {
                buf[(at) as usize] = 0 as u8
                at = at + 1
            } else {
                at = start
            }
        }
        i = i + 1
    }
    ulib.set_env((&buf[0 as usize]) as u64, at)
}
