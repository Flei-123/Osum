// kernel/user/leiste.fi -- THE TASKBAR, /bin/leiste.
//
// (The file still carries its German name because a parallel round
// RENAME owns the renaming of this tree -- leiste.fi -> taskbar.fi.
// Everything NEW in this file is English: identifiers, constants,
// configuration keys, paths, on-screen labels and comments.)
//
// WHAT IT SHOWS. A start button that opens `/bin/launcher`; one button
// per ordinary window that switches to it, or minimizes it if it is
// already the active one (`WA_TOGGLE`); and three status fields fed
// from system calls and from nothing else: the network address
// (`osum_netget`), the battery (`osum_pwrget`, round K18) and the
// clock (`sysinfo`, round K9). A battery percentage that this machine
// cannot measure is not printed as zero, it is printed as "no battery".
//
// ==================== WHAT THIS ADDENDUM ADDS: THE EDGE ==============
//
// Justin asked on 27.08.2026 whether the bar can be dragged to another
// screen edge, the way Windows 10 could and Windows 11 no longer can.
// It could not: `leiste.fi` had no position at all, the bar was at the
// bottom because `py = sh - PH` was written into the source. It can
// now, and in the two ways one expects:
//
//   1. DRAG IT. Press the left button on an empty part of the bar and
//      move the pointer towards an edge. A preview RECTANGLE follows
//      the pointer -- four thin always-on-top windows drawn in the
//      selection colour, which is an outline and not a filled sheet
//      because a filled 128 x 600 window is 300 kilooctets and this
//      process has 832 for everything. Let go, and the bar is there.
//   2. SET IT. /bin/einstellungen, page "Darstellung".
//
//   BOTH WRITE THE SAME FILE, /etc/taskbar.conf, and neither keeps a
//   second copy of the answer anywhere:
//
//       edge=bottom       bottom | top | left | right
//       height=28         thickness of a HORIZONTAL bar
//       width=104         thickness of a VERTICAL bar
//       autohide=0        1 = slide out until the pointer touches the edge
//       ontop=1           1 = always above ordinary windows
//
//   Two thickness keys and not one, because they are two different
//   numbers: 28 pixels is a good height for a horizontal bar and a
//   useless width for a vertical one. Windows keeps them apart for the
//   same reason.
//
// A VERTICAL BAR IS NOT A ROTATED HORIZONTAL ONE. The window buttons
// stack downwards instead of sideways, the start button sits at the
// top, and the three status fields sit at the bottom, one above the
// other. Each status field measures its own text (`text_w`) against the
// width it has: if it does not fit it WRAPS onto a second line -- the
// address 10.0.2.15 becomes "10.0." and "2.15" -- and only if even that
// fails does it shorten, and then it reports the SHORTENED text so that
// what the runner checks character by character is what is on screen.
// Nothing is silently clipped.
//
// AND THE WORK AREA MOVES WITH IT. The bar tells the server which edge
// it occupies (WM_STRUT, see kernel/wm.fi); the server subtracts every
// such reservation from the screen and calls the rest the work area.
// A maximized window fills the work area and follows it when the bar
// moves. That is the same idea as `_NET_WM_STRUT` in X11, and it is
// what the round TILING needs as the root rectangle of its frame tree.
//
// WHAT IT MAY DO AND WHY. `WM_LIST` and `WM_ACT` answer only to a
// process that has reserved a screen edge -- that is, to a panel, and
// reserving an edge needs root. An ordinary application gets -E_RIGHTS
// and does not see the titles of other processes.

profile kernel

import ulib
import libc.io
import wlibc
import msg
import qs

export { u_start }

// ------------------------------------------------------------ numbers

const PAD: u64 = 3 // margin between the bar edge and its contents
const GAP: u64 = 4 // between two elements
const BTN_H: u64 = 22 // height of every button, in both orientations
const LINE_H: u64 = 13 // one line of a status field
const SLIVER: u64 = 2 // what is left of a hidden bar
const REVEAL: u64 = 2 // pointer this close to the edge brings it back
const BAND: u64 = 80 // rows of the drawing surface used at a time
const START_W: u64 = 64
const TASK_MAX: u64 = 132
const TASK_MIN: u64 = 48
const MAXK: u64 = 10 // that many window buttons at most
const PREV_T: u64 = 3 // thickness of the preview outline

// The limits of the two thicknesses. They are limits and not
// suggestions: `win_size` cannot grow the window past the buffer it was
// created with, and that buffer is V_MAX * screen height.
const H_MIN: u64 = 20
const H_MAX: u64 = 40
const V_MIN: u64 = 56
const V_MAX: u64 = 128
const DEF_H: u64 = 28
const DEF_V: u64 = 104

// The three status fields, bottom-up in a vertical bar and right to
// left in a horizontal one.
const F_NET: u64 = 0
const F_BAT: u64 = 1
const F_CLK: u64 = 2
const F_N: u64 = 3

// The calls this bar needs besides the window server.
const SYS_PWRGET: u64 = 1750
const PG_BATPRESENT: u64 = 24
const PG_BATPERCENT: u64 = 25
const SYS_NETGET: u64 = 1300
const NG_READY: u64 = 0
const NG_IP: u64 = 1
// ROUND NETVIEW, addendum.
const NG_MASK: u64 = 2
const NG_GW: u64 = 3
const NG_STATE: u64 = 8
// ROUND NETVIEW, second addendum: the systemwide fallback. Asked
// through NETVGET, which anybody may ask about anything -- see
// `sys.do_netvget`; a bar that could not read it could not be honest
// about it.
const SYS_NETVGET: u64 = 1310
const NV_FALLBACK: u64 = 13
const NV_FBVIEW: u64 = 14

// The two icon sets. `/etc/netview/` is where the image puts them, and
// a bar that does not find them falls back to text -- a missing icon
// must not take the address off the screen with it.
const ICON_MAX: u64 = 1100
const MARK_MAX: u64 = 640
const IC_W: u64 = 16
const MK_W: u64 = 12

// ------------------------------------------------------------- state

static mut w_h: u64 = 0
static mut sw: u64 = 0
static mut sh: u64 = 0
static mut asc: u64 = 0

// the configuration, and nothing else in this file decides these five
static mut cf_edge: u64 = 0
static mut cf_height: u64 = 28
static mut cf_width: u64 = 104
static mut cf_autohide: u64 = 0
static mut cf_ontop: u64 = 1
static mut cf_from_file: u64 = 0

// the geometry derived from it
static mut vertical: u64 = 0
static mut thick: u64 = 28
static mut bar_x: u64 = 0
static mut bar_y: u64 = 0
static mut bar_w: u64 = 800
static mut bar_h: u64 = 28
static mut win_x: u64 = 0
static mut win_y: u64 = 0
static mut win_w: u64 = 800
static mut win_h: u64 = 28
static mut shown: u64 = 1

// the layout
static mut st_x: u64 = 0
static mut st_y: u64 = 0
static mut st_w: u64 = 0
static mut st_h: u64 = 0
static mut f_x: [u64; 3] = [0 as u64; 3]
static mut f_y: [u64; 3] = [0 as u64; 3]
static mut f_w: [u64; 3] = [0 as u64; 3]
static mut f_h: [u64; 3] = [0 as u64; 3]
static mut f_lines: [u64; 3] = [0 as u64; 3]
static mut f_txt: [u8; 192] = [0 as u8; 192] // 3 fields x 2 lines x 32
static mut f_full: [u8; 96] = [0 as u8; 96] // 3 fields x 32, unshortened
static mut kx: [u64; 10] = [0 as u64; 10]
static mut ky: [u64; 10] = [0 as u64; 10]
static mut kw: [u64; 10] = [0 as u64; 10]
static mut kh: [u64; 10] = [0 as u64; 10]
static mut kid: [u64; 10] = [0 as u64; 10]
static mut kver: [u64; 10] = [0 as u64; 10]
static mut kfok: [u64; 10] = [0 as u64; 10]
// ROUND NETVIEW: the network view of the process each window belongs to.
static mut knv: [u64; 10] = [0 as u64; 10]
static mut ktit: [u8; 400] = [0 as u8; 400]
static mut klab: [u8; 400] = [0 as u8; 400]
static mut nk: u64 = 0

// ROUND NETVIEW, addendum: the pictures, read once at start. Four
// states of 16x16 and three marks of 12x12, in the order the kernel
// (`sys.NS_*`) and `kernel/netview.fi` (`V_*`) count them.
static mut ic_buf: [u8; 4400] = [0 as u8; 4400]
static mut mk_buf: [u8; 1920] = [0 as u8; 1920]
// SECOND ADDENDUM: the sign for "the machine is faking". Its own
// buffer, because it is neither a state icon nor a window mark -- it
// stands NEXT to the state icon and says something about the machine
// that the four states cannot: a machine can be genuinely online AND
// faking a network for every new program at the same time.
static mut sy_buf: [u8; 640] = [0 as u8; 640]
static mut ic_ok: u64 = 0
static mut mk_ok: u64 = 0
static mut sy_ok: u64 = 0
static mut net_state: u64 = 0
static mut nv_fall: u64 = 0 // 0 off, 1 when-offline, 2 always
static mut nv_faking: u64 = 0 // is it faking RIGHT NOW
// WAS ZULETZT GEMELDET WURDE. Der Zustand der Maschine aendert sich
// fast nie, und eine Zeile, die er bei JEDEM Neuzeichnen noch einmal
// schreibt, ist keine Meldung, sondern Laerm auf der seriellen Leitung
// -- auf der zur selben Zeit die Einstellungen und der Starter
// schreiben. Genau daran ist eine Zusage in `tools/desktop/run.sh`
// zerbrochen: zwei Programme haben sich mitten in ein Wort geschrieben.
static mut st_said: u64 = 99
static mut fk_said: u64 = 99
// SECOND ADDENDUM: 224 and not 96, and this was a REAL fault and not a
// precaution. The longest sentence the corner could already build --
// "Adresse da, aber kein Weg nach draussen" plus address, mask and
// gateway -- is 99 octets, and `text_at_p` writes without looking. It
// has been three octets over the end since the first addendum and
// nothing noticed, because the fields behind it are written every
// second anyway. The two sentences of this addendum would have made it
// 184. So: room for the longest, and `hover_add` below, which counts.
const HOVER_MAX: u64 = 223
static mut hover_txt: [u8; 224] = [0 as u8; 224]
static mut hover_on: u64 = 0

static mut rec: [u8; 104] = [0 as u8; 104]
static mut ev: [u8; 16] = [0 as u8; 16]
static mut conf: [u8; 256] = [0 as u8; 256]
static mut minute_sum: u64 = 0
static mut list_sum: u64 = 0
static mut offset: u64 = 0
static mut clicks: u64 = 0
static mut acts: u64 = 0
static mut paints: u64 = 0
static mut writes: u64 = 0

// the drag
static mut dragging: u64 = 0
static mut drag_edge: u64 = 9
static mut prev_h: [u64; 4] = [0 as u64; 4]
static mut prev_on: u64 = 0
static mut prev_edge: u64 = 9
static mut hide_t0: u64 = 0

fn say(p: u64) {
    ulib.say(p)
}

fn tlen(p: u64) -> u64 {
    return ulib.length(p)
}

fn ticks() -> u64 {
    return ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
}

fn two(p: u64, at: u64, v: u64) {
    __mmio_write8((p + at) as *mut u8, (48 + (v / 10) % 10) as u8)
    __mmio_write8((p + at + 1) as *mut u8, (48 + v % 10) as u8)
}

fn num_at(p: u64, at: u64, v: u64) -> u64 {
    if v == 0 {
        __mmio_write8((p + at) as *mut u8, 48 as u8)
        __mmio_write8((p + at + 1) as *mut u8, 0 as u8)
        return at + 1
    }
    var digits: u64 = 0
    var t: u64 = v
    while t > 0 {
        digits = digits + 1
        t = t / 10
    }
    var k: u64 = digits
    t = v
    while k > 0 {
        k = k - 1
        __mmio_write8((p + at + k) as *mut u8, (48 + (t % 10)) as u8)
        t = t / 10
    }
    __mmio_write8((p + at + digits) as *mut u8, 0 as u8)
    return at + digits
}

fn text_at_p(p: u64, at: u64, q: u64) -> u64 {
    var k: u64 = 0
    while __mmio_read8((q + k) as *mut u8) != 0 as u8 {
        __mmio_write8((p + at + k) as *mut u8,
            __mmio_read8((q + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((p + at + k) as *mut u8, 0 as u8)
    return at + k
}

fn width_of(p: u64) -> u64 {
    return wlibc.text_w(wlibc.F_UI, wlibc.PX_UI, p, tlen(p))
}

// ==================================================== the configuration
//
// ONE FILE, TWO WRITERS, ONE READER. `/bin/einstellungen` writes it
// when the user picks an edge in the settings, this bar writes it when
// the user drags itself to an edge, and this bar reads it -- at start
// and every half second afterwards, so that a change made in the
// settings arrives without a restart. There is no second place where
// the edge is remembered; if the file says `left`, the bar is on the
// left, and if the file is not there, the defaults below are.

static mut p_conf: [u8; 19] = "/etc/taskbar.conf\0\0"
static mut k_edge: [u8; 5] = "edge\0"
static mut k_height: [u8; 7] = "height\0"
static mut k_width: [u8; 6] = "width\0"
static mut k_autohide: [u8; 9] = "autohide\0"
static mut k_ontop: [u8; 6] = "ontop\0"

fn key_is(p: u64, n: u64, k: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if __mmio_read8((k + i) as *mut u8) == 0 as u8 {
            return false
        }
        if __mmio_read8((p + i) as *mut u8)
            != __mmio_read8((k + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return __mmio_read8((k + n) as *mut u8) == 0 as u8
}

fn clamp(v: u64, lo: u64, hi: u64) -> u64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

// Read the file. Unknown keys are ignored, missing keys keep their
// value -- the same rule as `/etc/theme` (wlibc.theme_load). Returns
// true if the file was there at all.
fn conf_read() -> bool {
    var word: [u8; 24] = [0 as u8; 24]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_conf[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return false
    }
    let b: u64 = (&conf[0 as usize]) as u64
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, b, 255)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return false
    }
    var i: u64 = 0
    while i < n {
        // one line
        let ks: u64 = i
        var ke: u64 = i
        while ke < n && __mmio_read8((b + ke) as *mut u8) != 61 as u8
            && __mmio_read8((b + ke) as *mut u8) != 10 as u8 {
            ke = ke + 1
        }
        if ke < n && __mmio_read8((b + ke) as *mut u8) == 61 as u8 {
            let vs: u64 = ke + 1
            var ve: u64 = vs
            while ve < n && __mmio_read8((b + ve) as *mut u8) != 10 as u8
                && __mmio_read8((b + ve) as *mut u8) != 13 as u8 {
                ve = ve + 1
            }
            // the value as a word and as a number
            let wp: u64 = (&word[0 as usize]) as u64
            var k: u64 = 0
            var v: u64 = 0
            var digits: u64 = 0
            while vs + k < ve && k < 23 {
                let c: u64 = __mmio_read8((b + vs + k) as *mut u8) as u64
                __mmio_write8((wp + k) as *mut u8, c as u8)
                if c >= 48 && c <= 57 {
                    v = v * 10 + (c - 48)
                    digits = digits + 1
                }
                k = k + 1
            }
            __mmio_write8((wp + k) as *mut u8, 0 as u8)
            let kl: u64 = ke - ks
            if key_is(b + ks, kl, (&k_edge[0 as usize]) as u64) {
                let e: u64 = wlibc.edge_by_name(wp)
                if e < 4 {
                    cf_edge = e
                }
            } else if key_is(b + ks, kl, (&k_height[0 as usize]) as u64) {
                if digits > 0 {
                    cf_height = clamp(v, H_MIN, H_MAX)
                }
            } else if key_is(b + ks, kl, (&k_width[0 as usize]) as u64) {
                if digits > 0 {
                    cf_width = clamp(v, V_MIN, V_MAX)
                }
            } else if key_is(b + ks, kl, (&k_autohide[0 as usize]) as u64) {
                if digits > 0 {
                    cf_autohide = v & 1
                }
            } else if key_is(b + ks, kl, (&k_ontop[0 as usize]) as u64) {
                if digits > 0 {
                    cf_ontop = v & 1
                }
            }
            i = ve + 1
        } else {
            i = ke + 1
        }
    }
    return true
}

static mut c_head: [u8; 64] =
    "# taskbar.conf -- written by /bin/leiste and /bin/einstellungen\0"

fn conf_write() -> bool {
    let b: u64 = (&conf[0 as usize]) as u64
    var at: u64 = text_at_p(b, 0, (&c_head[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    at = text_at_p(b, at, (&k_edge[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    at = text_at_p(b, at + 1, wlibc.edge_name(cf_edge))
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = text_at_p(b, at + 1, (&k_height[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    at = num_at(b, at + 1, cf_height)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = text_at_p(b, at + 1, (&k_width[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    at = num_at(b, at + 1, cf_width)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = text_at_p(b, at + 1, (&k_autohide[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    at = num_at(b, at + 1, cf_autohide)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = text_at_p(b, at + 1, (&k_ontop[0 as usize]) as u64)
    __mmio_write8((b + at) as *mut u8, 61 as u8)
    at = num_at(b, at + 1, cf_ontop)
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let fd: u64 = io.create((&p_conf[0 as usize]) as u64)
    if ulib.bad(fd) {
        return false
    }
    let g: u64 = io.write_all(fd, b, at)
    io.close(fd)
    if ulib.bad(g) || g < at {
        return false
    }
    writes = writes + 1
    return true
}

static mut s_cf: [u8; 15] = "taskbar: conf \0"
static mut s_ed: [u8; 6] = "edge=\0"
static mut s_en: [u8; 8] = " ename=\0"
static mut s_hh: [u8; 9] = " height=\0"
static mut s_ww: [u8; 8] = " width=\0"
static mut s_ah: [u8; 11] = " autohide=\0"
static mut s_ot: [u8; 8] = " ontop=\0"
static mut s_sr: [u8; 6] = " src=\0"
static mut s_file: [u8; 5] = "file\0"
static mut s_dflt: [u8; 8] = "default\0"

fn conf_say() {
    say((&s_cf[0 as usize]) as u64)
    say((&s_ed[0 as usize]) as u64)
    ulib.sayn(cf_edge)
    say((&s_en[0 as usize]) as u64)
    say(wlibc.edge_name(cf_edge))
    say((&s_hh[0 as usize]) as u64)
    ulib.sayn(cf_height)
    say((&s_ww[0 as usize]) as u64)
    ulib.sayn(cf_width)
    say((&s_ah[0 as usize]) as u64)
    ulib.sayn(cf_autohide)
    say((&s_ot[0 as usize]) as u64)
    ulib.sayn(cf_ontop)
    say((&s_sr[0 as usize]) as u64)
    if cf_from_file != 0 {
        say((&s_file[0 as usize]) as u64)
    } else {
        say((&s_dflt[0 as usize]) as u64)
    }
    ulib.nl()
}

// ======================================================== the geometry
//
// The rectangle of the bar for an edge and a thickness. In ONE
// function, because the drag preview, the strut, the window itself and
// the settings all have to agree on it, and four copies of this
// arithmetic would agree on three days out of four.

static mut r_x: u64 = 0
static mut r_y: u64 = 0
static mut r_w: u64 = 0
static mut r_h: u64 = 0

fn rect_for(edge: u64, thickness: u64) {
    if edge == wlibc.WE_LEFT || edge == wlibc.WE_RIGHT {
        r_w = thickness
        r_h = sh
        r_y = 0
        if edge == wlibc.WE_LEFT {
            r_x = 0
        } else {
            r_x = sw - thickness
        }
    } else {
        r_w = sw
        r_h = thickness
        r_x = 0
        if edge == wlibc.WE_TOP {
            r_y = 0
        } else {
            r_y = sh - thickness
        }
    }
}

fn thickness_of(edge: u64) -> u64 {
    if edge == wlibc.WE_LEFT || edge == wlibc.WE_RIGHT {
        return cf_width
    }
    return cf_height
}

fn geometry() {
    thick = thickness_of(cf_edge)
    if cf_edge == wlibc.WE_LEFT || cf_edge == wlibc.WE_RIGHT {
        vertical = 1
    } else {
        vertical = 0
    }
    rect_for(cf_edge, thick)
    bar_x = r_x
    bar_y = r_y
    bar_w = r_w
    bar_h = r_h
}

// The rectangle the WINDOW currently has -- the same as the bar when it
// is out, a SLIVER at the edge when auto-hide has pulled it in.
fn window_rect() {
    if shown != 0 {
        win_x = bar_x
        win_y = bar_y
        win_w = bar_w
        win_h = bar_h
        return
    }
    rect_for(cf_edge, SLIVER)
    win_x = r_x
    win_y = r_y
    win_w = r_w
    win_h = r_h
}

static mut s_gm: [u8; 15] = "taskbar: geom \0"
static mut s_gx: [u8; 4] = " x=\0"
static mut s_gy: [u8; 4] = " y=\0"
static mut s_gw: [u8; 4] = " w=\0"
static mut s_gh: [u8; 4] = " h=\0"
static mut s_gv: [u8; 11] = " vertical=\0"
static mut s_gt: [u8; 8] = " thick=\0"
static mut s_gs: [u8; 8] = " shown=\0"
static mut s_wa: [u8; 15] = "taskbar: work \0"
static mut s_sx: [u8; 16] = "taskbar: strut \0"
static mut s_rc: [u8; 5] = " rc=\0"
static mut s_sz: [u8; 7] = " size=\0"

fn geom_say() {
    say((&s_gm[0 as usize]) as u64)
    say((&s_ed[0 as usize]) as u64)
    ulib.sayn(cf_edge)
    say((&s_gx[0 as usize]) as u64)
    ulib.sayn(win_x)
    say((&s_gy[0 as usize]) as u64)
    ulib.sayn(win_y)
    say((&s_gw[0 as usize]) as u64)
    ulib.sayn(win_w)
    say((&s_gh[0 as usize]) as u64)
    ulib.sayn(win_h)
    say((&s_gv[0 as usize]) as u64)
    ulib.sayn(vertical)
    say((&s_gt[0 as usize]) as u64)
    ulib.sayn(thick)
    say((&s_gs[0 as usize]) as u64)
    ulib.sayn(shown)
    ulib.nl()
    say((&s_wa[0 as usize]) as u64)
    say((&s_gx[0 as usize]) as u64)
    ulib.sayn(wlibc.work_x(w_h))
    say((&s_gy[0 as usize]) as u64)
    ulib.sayn(wlibc.work_y(w_h))
    say((&s_gw[0 as usize]) as u64)
    ulib.sayn(wlibc.work_w(w_h))
    say((&s_gh[0 as usize]) as u64)
    ulib.sayn(wlibc.work_h(w_h))
    ulib.nl()
}

// PUT THE WINDOW WHERE THE CONFIGURATION SAYS. Size first, then
// position, then the reservation -- in that order, because a window
// that is moved before it is shrunk is briefly 800 wide at the left
// edge, and the server would compose that.
//
// THE RESERVATION IS THE SLIVER WHEN AUTO-HIDE IS ON, in BOTH states.
// Not the full thickness while the bar is out and zero while it is in:
// that would resize every maximized window twice a second as the
// pointer wanders past. Windows reserves a sliver for an auto-hiding
// bar for exactly this reason.
fn apply() {
    window_rect()
    let _s: u64 = wlibc.win_size(w_h, win_w, win_h)
    let _m: u64 = wlibc.sys3w(wlibc.WM_MOVE, w_h, (win_x << 16) | win_y, 0)
    var reserve: u64 = thick
    if cf_autohide != 0 {
        reserve = SLIVER
    }
    let rc: u64 = wlibc.win_strut(w_h, cf_edge, reserve)
    say((&s_sx[0 as usize]) as u64)
    say((&s_ed[0 as usize]) as u64)
    ulib.sayn(cf_edge)
    say((&s_sz[0 as usize]) as u64)
    ulib.sayn(reserve)
    say((&s_rc[0 as usize]) as u64)
    ulib.sayn(rc)
    ulib.nl()
    var layer: u64 = wlibc.L_TOP
    if cf_ontop == 0 {
        layer = wlibc.L_NORMAL
    }
    let _l: u64 = wlibc.win_state(w_h, wlibc.WS_LAYER, layer)
    // THIRD ADDENDUM, and this is the whole of the panel in this file:
    // it is told WHERE, and it decides everything else. The rectangle
    // it gets is the WORK AREA -- what is left of the screen after this
    // bar reserved its edge -- and not the screen, so the panel appears
    // beside the bar on all four edges instead of under it on three.
    qs.anchor(cf_edge, wlibc.work_x(w_h), wlibc.work_y(w_h),
        wlibc.work_w(w_h), wlibc.work_h(w_h))
}

// ============================================ ROUND NETVIEW, addendum
//
// TWO ANSWERS AND NOT ONE, and that is the whole of this part.
//
// Windows shows ONE icon in the corner and it describes THE MACHINE.
// Here the network is a property of a PROCESS, so one icon cannot say
// it: this machine can be genuinely online while three programs see a
// faked network, one sees none and two see the real one. A single
// symbol would have to be wrong about five of them.
//
// So there are two displays, answering two different questions:
//
//   the CORNER  -- what the machine really has: carrier, address,
//                  route. Four states, one icon, and the details as
//                  text while the pointer rests on it.
//   the BUTTON  -- what THIS program sees. A mark, and only when it is
//                  not the normal case; `real` gets nothing, because a
//                  mark on every window is a mark that says nothing.
//
// THE SAME DRAWING IN BOTH SCHEMES. The pictures are OSYM files whose
// colours are ROLES and not values (`wlibc.icon_draw`), so a light
// scheme and a dark one get the same shapes in their own colours, out
// of one file.

static mut p_icons: [u8; 14] = "/etc/netview/\0"
static mut n_state: [u8; 54] = "state-nocarrier\0state-noip\0state-noroute\0state-online\0"
static mut n_mark: [u8; 35] = "mark-filtered\0mark-faked\0mark-none\0"
static mut n_sys: [u8; 11] = "sys-faking\0"

fn nth(p: u64, i: u64) -> u64 {
    var at: u64 = p
    var k: u64 = 0
    while k < i {
        while __mmio_read8((at) as *mut u8) != 0 as u8 {
            at = at + 1
        }
        at = at + 1
        k = k + 1
    }
    return at
}

// One picture into `dst`. 0 if there is no such file -- which is not
// fatal and not silent: `icons_load` counts what it got and the count
// goes into the report, so a run with no pictures says so.
fn icon_read(name: u64, dst: u64, max: u64) -> u64 {
    var path: [u8; 64] = [0 as u8; 64]
    let a: u64 = ulib.strcpy((&path[0 as usize]) as u64,
        (&p_icons[0 as usize]) as u64)
    let _b: u64 = ulib.strcpy((&path[0 as usize]) as u64 + a, name)
    let fd: u64 = io.open((&path[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = io.read(fd, dst, max)
    io.close(fd)
    if ulib.bad(n) {
        return 0
    }
    return n
}

fn icons_load() {
    ic_ok = 0
    mk_ok = 0
    var i: u64 = 0
    while i < 4 {
        if icon_read(nth((&n_state[0 as usize]) as u64, i),
            (&ic_buf[0 as usize]) as u64 + i * ICON_MAX, ICON_MAX) > 12 {
            ic_ok = ic_ok + 1
        }
        i = i + 1
    }
    i = 0
    while i < 3 {
        if icon_read(nth((&n_mark[0 as usize]) as u64, i),
            (&mk_buf[0 as usize]) as u64 + i * MARK_MAX, MARK_MAX) > 12 {
            mk_ok = mk_ok + 1
        }
        i = i + 1
    }
    sy_ok = 0
    if icon_read((&n_sys[0 as usize]) as u64,
        (&sy_buf[0 as usize]) as u64, MARK_MAX) > 12 {
        sy_ok = 1
    }
}

// The sign, or 0 when the machine is not faking. `real` gets nothing --
// the same rule the window marks follow, and for the same reason: a
// sign that is always there says nothing when it matters.
fn sys_icon() -> u64 {
    if nv_faking == 0 || sy_ok == 0 {
        return 0
    }
    return (&sy_buf[0 as usize]) as u64
}

fn state_icon(s: u64) -> u64 {
    if s > 3 || ic_ok < 4 {
        return 0
    }
    return (&ic_buf[0 as usize]) as u64 + s * ICON_MAX
}

// The view of a process minus one: `real` is 0 and gets no mark, so
// `filtered` is mark 0, `faked` mark 1, `none` mark 2. 0 means "this
// one gets nothing".
fn mark_icon(v: u64) -> u64 {
    if v == 0 || v > 3 || mk_ok < 3 {
        return 0
    }
    return (&mk_buf[0 as usize]) as u64 + (v - 1) * MARK_MAX
}


// ============================================ ROUND NETVIEW, addendum
//
// WHAT THE POINTER IS RESTING ON, AS A SENTENCE. An icon that says
// something the person cannot look up is a rune. There is no tooltip
// window in this system and a bar that is 28 pixels high cannot open
// one; what there IS is the empty space between the last window button
// and the first status field, and that is where the sentence goes.
//
// It is drawn in the DIM role, so it reads as an explanation and not as
// another control, and it is reported on the serial line like every
// other piece of text in this bar -- so `tools/netview/run.sh` can hold
// the reported sentence against the picture, character by character,
// the way round DESKTOP does it for the clock.

static mut h_none: [u8; 57] = "Netzzugriff: keiner -- dieses Programm bekommt kein Netz\0"
static mut h_fake: [u8; 75] = "Netzzugriff: vorgetaeuscht -- dieses Programm erreicht nichts von draussen\0"
static mut h_filt: [u8; 54] = "Netzzugriff: gefiltert -- nur die eingetragenen Ziele\0"
static mut h_s0: [u8; 46] = "Kein Verbindungstraeger -- nichts eingesteckt\0"
static mut h_s1: [u8; 31] = "Traeger da, noch keine Adresse\0"
static mut h_s2: [u8; 40] = "Adresse da, aber kein Weg nach draussen\0"
static mut h_s3: [u8; 22] = "Verbunden ueber Kabel\0"
// SECOND ADDENDUM. The sentence that has to be there, because the sign
// alone is a rune: an icon nobody can look up is not honesty, it is
// decoration. Two sentences and not one -- WHAT is happening, and on
// WHOSE orders, so that the person knows where to go and undo it.
static mut h_fb1: [u8; 62] = "  --  Das System taeuscht neuen Programmen ein Netz vor\0\0\0\0\0\0\0"
static mut h_fb2: [u8; 26] = " (Voreinstellung: immer)\0\0"
static mut h_fb3: [u8; 34] = " (Voreinstellung: wenn offline)\0\0\0"
static mut h_sp2: [u8; 3] = "  \0"
static mut h_msk: [u8; 9] = "  Maske \0"
static mut h_gw: [u8; 6] = "  gw \0"
static mut s_hv: [u8; 16] = "taskbar: hover \0"

fn hover_clear() {
    hover_on = 0
    __mmio_write8(((&hover_txt[0 as usize]) as u64) as *mut u8, 0 as u8)
}

fn hover_set(txt: u64) {
    hover_on = 1
    let _a: u64 = ulib.strncpy((&hover_txt[0 as usize]) as u64, txt, 95)
}

// The corner: the state in words, and then the three numbers Windows
// hides behind two more clicks.
// Append, and STOP AT THE END. `text_at_p` does not count, which is
// fine for a field that is built out of numbers of known length and is
// not fine for a sentence that grows with the state of the machine.
fn hover_add(at: u64, q: u64) -> u64 {
    let p: u64 = (&hover_txt[0 as usize]) as u64
    var k: u64 = 0
    while __mmio_read8((q + k) as *mut u8) != 0 as u8
        && at + k < HOVER_MAX {
        __mmio_write8((p + at + k) as *mut u8,
            __mmio_read8((q + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((p + at + k) as *mut u8, 0 as u8)
    return at + k
}

fn hover_state() {
    var w: u64 = (&h_s0[0 as usize]) as u64
    if net_state == 1 {
        w = (&h_s1[0 as usize]) as u64
    } else if net_state == 2 {
        w = (&h_s2[0 as usize]) as u64
    } else if net_state == 3 {
        w = (&h_s3[0 as usize]) as u64
    }
    var at: u64 = ulib.strncpy((&hover_txt[0 as usize]) as u64, w, 40)
    let h: u64 = (&hover_txt[0 as usize]) as u64
    if net_state >= 2 {
        at = hover_add(at, (&h_sp2[0 as usize]) as u64)
        at = ip_at(h, at, ulib.sys(SYS_NETGET, NG_IP, 0, 0))
        at = hover_add(at, (&h_msk[0 as usize]) as u64)
        at = ip_at(h, at, ulib.sys(SYS_NETGET, NG_MASK, 0, 0))
        at = hover_add(at, (&h_gw[0 as usize]) as u64)
        at = ip_at(h, at, ulib.sys(SYS_NETGET, NG_GW, 0, 0))
    }
    // AND WHAT THE SIGN BESIDE IT MEANS. It goes AFTER the state of the
    // machine on purpose: the machine's own truth is not replaced by
    // the fact that the system is dressing it up, it is added to.
    if nv_faking != 0 {
        at = hover_add(at, (&h_fb1[0 as usize]) as u64)
        if nv_fall == 2 {
            at = hover_add(at, (&h_fb2[0 as usize]) as u64)
        } else {
            at = hover_add(at, (&h_fb3[0 as usize]) as u64)
        }
    }
    hover_on = 1
}

fn ip_at(p: u64, at: u64, v: u64) -> u64 {
    if ulib.bad(v) {
        return at
    }
    var o: u64 = num_at(p, at, (v >> 24) & 255)
    o = text_at_p(p, o, (&s_dot[0 as usize]) as u64)
    o = num_at(p, o, (v >> 16) & 255)
    o = text_at_p(p, o, (&s_dot[0 as usize]) as u64)
    o = num_at(p, o, (v >> 8) & 255)
    o = text_at_p(p, o, (&s_dot[0 as usize]) as u64)
    return num_at(p, o, v & 255)
}

// Which of the two displays the pointer is on. Called once per poll,
// and it changes nothing but `hover_txt` -- the repaint is decided by
// the caller, so that a pointer standing still costs no drawing.
fn hover_step() -> bool {
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    let was: u64 = hover_on
    var old: [u8; 96] = [0 as u8; 96]
    let _c: u64 = ulib.strncpy((&old[0 as usize]) as u64,
        (&hover_txt[0 as usize]) as u64, 95)
    hover_clear()
    if inside_bar(mx, my) {
        let lx: u64 = mx - bar_x
        let ly: u64 = my - bar_y
        if lx >= f_x[(F_NET) as usize]
            && lx < f_x[(F_NET) as usize] + f_w[(F_NET) as usize]
            && ly >= f_y[(F_NET) as usize]
            && ly < f_y[(F_NET) as usize] + f_h[(F_NET) as usize] {
            hover_state()
        } else {
            var i: u64 = 0
            while i < nk {
                if kw[(i) as usize] != 0 && knv[(i) as usize] != 0
                    && lx >= kx[(i) as usize]
                    && lx < kx[(i) as usize] + kw[(i) as usize]
                    && ly >= ky[(i) as usize]
                    && ly < ky[(i) as usize] + kh[(i) as usize] {
                    if knv[(i) as usize] == 1 {
                        hover_set((&h_filt[0 as usize]) as u64)
                    } else if knv[(i) as usize] == 2 {
                        hover_set((&h_fake[0 as usize]) as u64)
                    } else {
                        hover_set((&h_none[0 as usize]) as u64)
                    }
                    i = nk
                } else {
                    i = i + 1
                }
            }
        }
    }
    if was != hover_on {
        return true
    }
    return !ulib.streq((&old[0 as usize]) as u64,
        (&hover_txt[0 as usize]) as u64)
}

// ================================================== the status fields
//
// Three strings out of three system calls, and then the only
// interesting part: MAKING THEM FIT. A field has `avail` pixels. If the
// whole string fits, it is one line. If not, it is broken at a sensible
// character -- the last dot of an address, the space of "Battery 87%"
// -- and becomes two lines. Only if a half still does not fit is it
// shortened, one character at a time, and then the SHORTENED text is
// what gets reported. `tools/desktop/run.sh` checks the reported text
// against the picture character by character, so a program that reports
// the long form and paints the short one would fail there and not pass
// quietly.

// ================================================ RUNDE I18N: DIE TEXTE
//
// Fuenf Zeichenketten dieser Datei sind ANZEIGETEXT: der Fenstername,
// der Startknopf und die drei Meldungen ueber Akku und Netz. Hier
// stehen ihre SCHLUESSEL -- englisch, wie jeder Name in diesem System
// -- und der Text kommt zur Laufzeit aus
// /usr/share/locale/<code>/messages. Die englischen Zeichenketten
// bleiben als RUECKFALL stehen: ohne Sprachdateien meldet `msg.get`
// den Schluessel, und ein Knopf mit "taskbar.start" darauf waere
// schlechter als einer mit "Start".
//
// WAS NICHT UEBERSETZT WIRD und deshalb NICHT hier steht: die
// Meldungen auf der seriellen Leitung ("leiste: knopf i=..."), die
// Namen der Messfelder ("start", "uhr", "akku", "netz") und der Pfad
// "/etc/theme". Das erste ist ein Mitschnitt fuer Testlaeufer, das
// zweite sind Namen, das dritte ist ein Pfad. Wer einen Mitschnitt
// uebersetzt, macht jeden Testlaeufer sprachabhaengig.
static mut k_title: [u8; 14] = "taskbar.title\0"
static mut k_start: [u8; 14] = "taskbar.start\0"
static mut k_batt: [u8; 16] = "taskbar.battery\0"
static mut k_nobatt: [u8; 19] = "taskbar.no_battery\0"
static mut k_nonet: [u8; 19] = "taskbar.no_network\0"
static mut s_nobat: [u8; 11] = "no battery\0"
static mut s_nonet: [u8; 11] = "no network\0"
static mut s_bat: [u8; 9] = "Battery \0"
static mut s_pct: [u8; 2] = "%\0"
static mut s_dot: [u8; 2] = ".\0"
static mut p_time: [u8; 16] = "/etc/time.conf\0\0"

fn full_of(f: u64) -> u64 {
    return (&f_full[0 as usize]) as u64 + f * 32
}

fn line_of(f: u64, l: u64) -> u64 {
    return (&f_txt[0 as usize]) as u64 + (f * 2 + l) * 32
}

// The offset to local time. This kernel can read the hardware clock and
// not set it (`SYS_TIME`), so what a ring 3 program can honestly do is
// shift the DISPLAY -- and that is what /etc/time.conf holds.
fn offset_read() {
    var buf: [u8; 64] = [0 as u8; 64]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&p_time[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let b: u64 = (&buf[0 as usize]) as u64
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, b, 63)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return
    }
    var i: u64 = 0
    var v: u64 = 0
    var digits: u64 = 0
    var in_value: bool = false
    while i < n {
        let c: u64 = __mmio_read8((b + i) as *mut u8) as u64
        if c == 61 {
            in_value = true
        } else if in_value && c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
            digits = digits + 1
        } else if digits > 0 {
            i = n
        }
        i = i + 1
    }
    if digits > 0 && v <= 1440 {
        offset = v
    }
}

// Build the three unshortened strings. Returns true if anything moved.
// Ein Anzeigetext: der uebersetzte, wenn es einen gibt, sonst der
// englische aus dieser Datei. `msg.get` gibt bei einem unbekannten
// Schluessel den Schluessel zurueck; das ist fuer einen Testlaeufer
// richtig und fuer einen Knopf falsch.
fn txt(key: u64, fallback: u64) -> u64 {
    let t: u64 = msg.get(key)
    if t == key {
        return fallback
    }
    return t
}

fn status_build() -> bool {
    let s_kA: u64 = txt((&k_nobatt[0 as usize]) as u64,
        (&s_nobat[0 as usize]) as u64)
    let s_kN: u64 = txt((&k_nonet[0 as usize]) as u64,
        (&s_nonet[0 as usize]) as u64)
    let s_ak: u64 = txt((&k_batt[0 as usize]) as u64,
        (&s_bat[0 as usize]) as u64)
    offset_read()
    let hr: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_HOUR, 0, 0)
    let mi: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_MIN, 0, 0)
    let whole: u64 = ((hr * 60 + mi) + offset) % 1440
    let c: u64 = full_of(F_CLK)
    two(c, 0, whole / 60)
    __mmio_write8((c + 2) as *mut u8, 58 as u8)
    two(c, 3, whole % 60)
    __mmio_write8((c + 5) as *mut u8, 0 as u8)
    let a: u64 = full_of(F_BAT)
    let have: u64 = ulib.sys(SYS_PWRGET, PG_BATPRESENT, 0, 0)
    if ulib.bad(have) || have == 0 {
        let _q: u64 = text_at_p(a, 0, s_kA)
    } else {
        let pc: u64 = ulib.sys(SYS_PWRGET, PG_BATPERCENT, 0, 0)
        if ulib.bad(pc) {
            let _q: u64 = text_at_p(a, 0, s_kA)
        } else {
            var at: u64 = text_at_p(a, 0, s_ak)
            at = num_at(a, at, pc)
            let _q: u64 = text_at_p(a, at, (&s_pct[0 as usize]) as u64)
        }
    }
    let ne: u64 = full_of(F_NET)
    // ROUND NETVIEW, addendum: the four states of the MACHINE. The
    // kernel works them out (`sys.NG_STATE`) so that this bar does not
    // ask three questions and draw its own conclusion -- the next
    // reader of those three would conclude something else.
    let st: u64 = ulib.sys(SYS_NETGET, NG_STATE, 0, 0)
    if ulib.bad(st) {
        net_state = 0
    } else {
        net_state = st
    }
    // SECOND ADDENDUM: the preference, and what it amounts to right
    // now. Both out of the kernel, neither worked out here -- the bar
    // must not be the second place that decides what `when-offline`
    // means.
    let fb: u64 = ulib.sys(SYS_NETVGET, 0, NV_FALLBACK, 0)
    if ulib.bad(fb) {
        nv_fall = 0
    } else {
        nv_fall = fb
    }
    let fv: u64 = ulib.sys(SYS_NETVGET, 0, NV_FBVIEW, 0)
    if !ulib.bad(fv) && fv == 2 {
        nv_faking = 1
    } else {
        nv_faking = 0
    }
    let rd: u64 = ulib.sys(SYS_NETGET, NG_READY, 0, 0)
    var ip: u64 = 0
    if !ulib.bad(rd) && rd != 0 {
        ip = ulib.sys(SYS_NETGET, NG_IP, 0, 0)
        if ulib.bad(ip) {
            ip = 0
        }
    }
    if ip == 0 {
        let _q: u64 = text_at_p(ne, 0, s_kN)
    } else {
        var at: u64 = num_at(ne, 0, (ip >> 24) & 255)
        at = text_at_p(ne, at, (&s_dot[0 as usize]) as u64)
        at = num_at(ne, at, (ip >> 16) & 255)
        at = text_at_p(ne, at, (&s_dot[0 as usize]) as u64)
        at = num_at(ne, at, (ip >> 8) & 255)
        at = text_at_p(ne, at, (&s_dot[0 as usize]) as u64)
        at = num_at(ne, at, ip & 255)
    }
    var sum: u64 = 1469598103934665603 ^ (net_state *% 2654435761)
    // The sign is not part of any of the three texts, so without this
    // line the bar would not repaint when the preference changed --
    // the person would set `always` and see nothing happen.
    sum = sum ^ ((nv_faking * 3 + nv_fall) *% 40503)
    var q: u64 = 0
    while q < F_N {
        let p: u64 = full_of(q)
        var k: u64 = 0
        while __mmio_read8((p + k) as *mut u8) != 0 as u8 && k < 31 {
            let z: u64 = __mmio_read8((p + k) as *mut u8) as u64
            sum = (sum ^ z) *% 1099511628211
            k = k + 1
        }
        q = q + 1
    }
    let changed: bool = sum != minute_sum
    minute_sum = sum
    return changed
}

// Copy `n` characters and terminate.
fn copy_n(dst: u64, src: u64, n: u64) {
    var k: u64 = 0
    while k < n {
        __mmio_write8((dst + k) as *mut u8,
            __mmio_read8((src + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((dst + n) as *mut u8, 0 as u8)
}

// Shorten a line until it fits. The last resort, and it is reported.
fn shorten(p: u64, avail: u64) {
    var n: u64 = tlen(p)
    while n > 1
        && wlibc.text_w(wlibc.F_UI, wlibc.PX_UI, p, n) > avail {
        n = n - 1
    }
    __mmio_write8((p + n) as *mut u8, 0 as u8)
}

// WHERE TO BREAK A LINE. For an address the LAST dot ("10.0." / "2.15"),
// for anything else the last space. Zero means: no sensible break.
fn break_at(p: u64) -> u64 {
    let n: u64 = tlen(p)
    var dot: u64 = 0
    var space: u64 = 0
    var i: u64 = 0
    while i < n {
        let c: u64 = __mmio_read8((p + i) as *mut u8) as u64
        if c == 46 {
            dot = i + 1
        } else if c == 32 {
            space = i + 1
        }
        i = i + 1
    }
    if dot > 0 && dot < n {
        return dot
    }
    if space > 0 && space < n {
        return space
    }
    return 0
}

// Lay a field out into one or two lines that fit into `avail` pixels.
fn fit_field(f: u64, avail: u64) {
    let src: u64 = full_of(f)
    let l0: u64 = line_of(f, 0)
    let l1: u64 = line_of(f, 1)
    __mmio_write8((l1) as *mut u8, 0 as u8)
    if width_of(src) <= avail {
        copy_n(l0, src, tlen(src))
        f_lines[(f) as usize] = 1
        return
    }
    let b: u64 = break_at(src)
    if b > 0 {
        copy_n(l0, src, b)
        copy_n(l1, src + b, tlen(src) - b)
        if width_of(l0) <= avail && width_of(l1) <= avail {
            f_lines[(f) as usize] = 2
            return
        }
        shorten(l0, avail)
        shorten(l1, avail)
        f_lines[(f) as usize] = 2
        return
    }
    copy_n(l0, src, tlen(src))
    shorten(l0, avail)
    f_lines[(f) as usize] = 1
}

// ========================================================== the layout

fn shorten_title(i: u64, width: u64) {
    let q: u64 = (&ktit[0 as usize]) as u64 + i * 40
    let z: u64 = (&klab[0 as usize]) as u64 + i * 40
    var n: u64 = tlen(q)
    if n > 31 {
        n = 31
    }
    while n > 1
        && wlibc.text_w(wlibc.F_UI, wlibc.PX_UI, q, n) + 10 > width {
        n = n - 1
    }
    copy_n(z, q, n)
}

// EVERY RECTANGLE OF THE BAR, FOR BOTH ORIENTATIONS, IN ONE PLACE.
// A vertical bar is not a rotated horizontal one: the start button sits
// at the top instead of the left, the window buttons stack downwards,
// and the three status fields sit at the bottom one above the other,
// each as tall as the number of lines it needed.
fn layout() {
    var i: u64 = 0
    if vertical != 0 {
        let inner: u64 = thick - PAD * 2
        st_x = PAD
        st_y = PAD
        st_w = inner
        st_h = BTN_H
        // the status fields, from the bottom up: clock, battery, net
        var y: u64 = bar_h - PAD
        var f: u64 = F_CLK
        while f < F_N {
            // ROUND NETVIEW, addendum: the icon takes its room off the
            // text's share here too -- see the horizontal case below for
            // what happened when it did not.
            var vroom: u64 = 0
            if f == F_NET && state_icon(net_state) != 0 {
                vroom = IC_W + 2
            }
            if f == F_NET && sys_icon() != 0 {
                vroom = vroom + MK_W + 2
            }
            fit_field(f, inner - 8 - vroom)
            let hh: u64 = f_lines[(f) as usize] * LINE_H + 4
            y = y - hh
            f_x[(f) as usize] = PAD
            f_y[(f) as usize] = y
            f_w[(f) as usize] = inner
            f_h[(f) as usize] = hh
            y = y - GAP
            if f == F_CLK {
                f = F_BAT
            } else if f == F_BAT {
                f = F_NET
            } else {
                f = F_N
            }
        }
        // the window buttons in between
        let top: u64 = st_y + st_h + GAP
        var space: u64 = 0
        if y > top {
            space = y - top
        }
        i = 0
        while i < nk {
            let by: u64 = top + i * (BTN_H + GAP)
            kx[(i) as usize] = PAD
            ky[(i) as usize] = by
            kw[(i) as usize] = inner
            kh[(i) as usize] = BTN_H
            if by + BTN_H > top + space {
                kw[(i) as usize] = 0 // no room left: no button, no lie
            } else {
                shorten_title(i, inner)
            }
            i = i + 1
        }
        return
    }
    st_x = PAD + 1
    st_y = (bar_h - BTN_H) / 2
    st_w = START_W
    st_h = BTN_H
    var x: u64 = bar_w - PAD
    var f: u64 = F_CLK
    while f < F_N {
        // ROUND NETVIEW, addendum: THE ICON NEEDS ROOM AND IT HAS TO BE
        // TAKEN OFF THE TEXT'S SHARE, not added on top of it. The first
        // version drew the icon in front of the address and left the
        // field the width it had -- so the address ran out of its own
        // rectangle and into the battery beside it, and the acceptance
        // run of round DESKTOP said the rectangles were wrong. It was
        // right, and this is why that run stays in the suite.
        var room: u64 = 0
        if f == F_NET && state_icon(net_state) != 0 {
            room = IC_W + 2
        }
        // SECOND ADDENDUM: and the faking sign takes its room off the
        // same share. The lesson of the first addendum, applied before
        // it had to be learned twice: an icon that is added ON TOP of
        // the field's width pushes the address into the battery.
        if f == F_NET && sys_icon() != 0 {
            room = room + MK_W + 2
        }
        fit_field(f, bar_w / 4 - room)
        var ww: u64 = width_of(line_of(f, 0)) + 10 + room
        if f_lines[(f) as usize] > 1 {
            let w1: u64 = width_of(line_of(f, 1)) + 10 + room
            if w1 > ww {
                ww = w1
            }
        }
        x = x - ww
        f_x[(f) as usize] = x
        f_y[(f) as usize] = st_y
        f_w[(f) as usize] = ww
        f_h[(f) as usize] = BTN_H
        x = x - GAP
        if f == F_CLK {
            f = F_BAT
        } else if f == F_BAT {
            f = F_NET
        } else {
            f = F_N
        }
    }
    let left: u64 = st_x + st_w + GAP
    var space: u64 = 0
    if x > left {
        space = x - left
    }
    var width: u64 = TASK_MAX
    if nk > 0 {
        width = (space - (nk - 1) * GAP) / nk
        if width > TASK_MAX {
            width = TASK_MAX
        }
    }
    i = 0
    while i < nk {
        kx[(i) as usize] = left + i * (width + GAP)
        ky[(i) as usize] = st_y
        kh[(i) as usize] = BTN_H
        if width >= TASK_MIN {
            kw[(i) as usize] = width
            shorten_title(i, width)
        } else {
            kw[(i) as usize] = 0
        }
        i = i + 1
    }
}

// ========================================================== the window list

fn list_read() -> bool {
    var sum: u64 = 1469598103934665603
    var n: u64 = 0
    var slot: u64 = 0
    while slot < 16 && n < MAXK {
        let r: u64 = wlibc.win_list(slot, (&rec[0 as usize]) as u64)
        if ulib.bad(r) {
            slot = 16
        } else {
            if r == 1 {
                let b: u64 = (&rec[0 as usize]) as u64
                let layer: u64 = __mmio_read64((b + wlibc.WL_LAYER) as *mut u64)
                // THIRD ADDENDUM: OUR OWN QUICK SETTINGS ARE NOT AN
                // APPLICATION. The panel lives on the normal layer
                // because it has to be able to take the keyboard (see
                // `qs.init`), and everything on that layer gets a
                // button in this bar -- but a panel that belongs to
                // this bar must not stand beside the programs.
                let own: u64 = __mmio_read64((b + wlibc.WL_ID) as *mut u64)
                if layer == wlibc.L_NORMAL && own != qs.win_id() {
                    let id: u64 = own
                    let fl: u64 = __mmio_read64((b + wlibc.WL_FLAGS) as *mut u64)
                    let fo: u64 = __mmio_read64((b + wlibc.WL_FOCUS) as *mut u64)
                    let nv: u64 = __mmio_read64((b + wlibc.WL_NETV) as *mut u64)
                    kid[(n) as usize] = id
                    kver[(n) as usize] = fl & wlibc.F_HIDDEN
                    kfok[(n) as usize] = fo
                    knv[(n) as usize] = nv
                    // ================================ ROUND NETVIEW
                    //
                    // GETAEUSCHT WIRD DAS PROGRAMM, NIE DER MENSCH. The
                    // first version of this round put a CHARACTER in
                    // front of the title -- `~`, `+`, `x`. That was
                    // honest and it was ugly, and the addendum replaces
                    // it with a real picture (`paint_band` draws
                    // `mark_icon` in the button). The title is the title
                    // again; what the process sees stands beside it and
                    // not inside it.
                    var k: u64 = 0
                    while k < 31 {
                        ktit[((n * 40 + k)) as usize] =
                            __mmio_read8((b + wlibc.WL_TITLE + k) as *mut u8)
                        k = k + 1
                    }
                    ktit[((n * 40 + 31)) as usize] = 0 as u8
                    let mix: u64 = id *% 131 +% (fl & 1) *% 7 +% fo +% nv *% 17
                    sum = (sum ^ mix) *% 1099511628211
                    n = n + 1
                }
            }
            slot = slot + 1
        }
    }
    nk = n
    sum = sum ^ (n *% 1000003)
    let other: bool = sum != list_sum
    list_sum = sum
    return other
}

// ============================================================ painting

static mut s_st: [u8; 6] = "Start\0"
static mut m_start: [u8; 6] = "start\0"
static mut m_clk: [u8; 6] = "clock\0"
static mut m_bat: [u8; 8] = "battery\0"
static mut m_net: [u8; 4] = "net\0"
static mut m_btn: [u8; 7] = "button\0"
static mut s_tx: [u8; 15] = "taskbar: text \0"
static mut s_tX: [u8; 4] = " x=\0"
static mut s_tb: [u8; 7] = " base=\0"
static mut s_tf: [u8; 5] = " fg=\0"
static mut s_tg: [u8; 5] = " bg=\0"
static mut s_tt: [u8; 4] = " t=\0"
static mut s_bt: [u8; 17] = "taskbar: btn i=\0\0"
static mut s_bi: [u8; 5] = " id=\0"
static mut s_bv: [u8; 9] = " hidden=\0"
static mut s_bf: [u8; 8] = " focus=\0"
static mut s_fl: [u8; 17] = "taskbar: field \0\0"
static mut s_fn: [u8; 8] = " lines=\0"
static mut s_bn: [u8; 7] = " netv=\0"
static mut s_bmx: [u8; 8] = " mkx=\0\0\0"
static mut s_bmy: [u8; 8] = " mky=\0\0\0"
static mut s_ic: [u8; 18] = "taskbar: state s=\0"
static mut s_fk: [u8; 21] = "taskbar: faking fb=\0\0"
static mut s_fkno: [u8; 24] = "taskbar: notfaking fb=\0\0"
static mut s_ico: [u8; 17] = "taskbar: icons=\0\0"
static mut s_icm: [u8; 8] = " marks=\0"
static mut s_ics: [u8; 7] = " sys=\0\0"

fn say_text(mark: u64, x: u64, base: u64, fg: u64, bg: u64, txt: u64) {
    say((&s_tx[0 as usize]) as u64)
    say(mark)
    say((&s_tX[0 as usize]) as u64)
    ulib.sayn(x)
    say((&s_tb[0 as usize]) as u64)
    ulib.sayn(base)
    say((&s_tf[0 as usize]) as u64)
    ulib.sayn(fg)
    say((&s_tg[0 as usize]) as u64)
    ulib.sayn(bg)
    say((&s_tt[0 as usize]) as u64)
    say(txt)
    ulib.nl()
}

// One button: face, edge, and the label CENTRED. Returns the position
// of the label so it can be reported; the runner recomputes it in the
// picture, per character.
fn button(x: u64, y: u64, w: u64, h: u64, txt: u64, on: bool,
    dim: bool) -> u64 {
    return button_mark(x, y, w, h, txt, on, dim, 0)
}

// THE SAME BUTTON WITH A MARK IN FRONT OF THE LABEL. `mark` is a
// picture or 0; 0 is the normal case and costs nothing, which is the
// point -- `real` gets no mark, so most buttons go through here
// unchanged and the runner that measures the label position still
// measures the same number for them.
fn button_mark(x: u64, y: u64, w: u64, h: u64, txt: u64, on: bool,
    dim: bool, mark: u64) -> u64 {
    // RUNDE THEME: die Marke des Schemas und nicht die alte T_BTN.
    var bg: u64 = wlibc.theme(wlibc.C_BUTTON_FACE)
    if on {
        bg = wlibc.theme(wlibc.T_SEL)
    } else if dim {
        bg = wlibc.theme(wlibc.T_SCROLL)
    }
    wlibc.rect(x, y, w, h, bg)
    wlibc.frame3(x, y, w, h, wlibc.theme(wlibc.T_BTNHI),
        wlibc.theme(wlibc.C_BORDER), on)
    var fg: u64 = wlibc.theme(wlibc.T_FG)
    if on {
        fg = wlibc.theme(wlibc.T_SELFG)
    } else if dim {
        fg = wlibc.theme(wlibc.T_DIM)
    }
    var room: u64 = 0
    if mark != 0 {
        room = MK_W + 3
    }
    let n: u64 = tlen(txt)
    var tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.PX_UI, txt, n)
    if tw + 8 + room > w {
        if w > 8 + room {
            tw = w - 8 - room
        } else {
            tw = 0
        }
    }
    let tx: u64 = x + room + (w - room - tw) / 2
    let base: u64 = y + (h + asc) / 2 - 1
    if mark != 0 {
        // FLUSH LEFT AND VERTICALLY CENTRED. Left, because a mark that
        // moves with the length of the title is a mark the eye has to
        // look for; the whole value of it is that it is always in the
        // same place.
        let _m: bool = wlibc.icon_draw(mark, x + 3, y + (h - MK_W) / 2)
    }
    let _e: u64 = wlibc.text_at(wlibc.F_UI, wlibc.PX_UI, tx, base, txt, n,
        fg)
    return (tx << 32) | base
}

// Where the free space of a horizontal bar begins and ends: behind the
// last window button, in front of the first status field.
fn hover_left() -> u64 {
    var x: u64 = st_x + st_w + GAP
    var i: u64 = 0
    while i < nk {
        if kw[(i) as usize] != 0 && kx[(i) as usize] + kw[(i) as usize] + GAP > x {
            x = kx[(i) as usize] + kw[(i) as usize] + GAP
        }
        i = i + 1
    }
    return x
}

fn hover_right() -> u64 {
    var x: u64 = win_w
    var f: u64 = 0
    while f < F_N {
        if f_w[(f) as usize] != 0 && f_x[(f) as usize] < x {
            x = f_x[(f) as usize]
        }
        f = f + 1
    }
    if x < GAP {
        return 0
    }
    return x - GAP
}

fn put_n(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        let _c: u64 = ulib.sys(ulib.SYS_WRITE, ulib.OUT, p + i, 1)
        i = i + 1
    }
}

fn paint_band(y0: u64, hh: u64, report: bool) {
    wlibc.set_band(y0)
    wlibc.clip_set(0, y0, win_w, y0 + hh)
    wlibc.rect(0, y0, win_w, hh, wlibc.theme(wlibc.C_TASKBAR_BG))
    // the hairline on the side that faces the desktop
    if cf_edge == wlibc.WE_BOTTOM {
        wlibc.hline(0, 0, win_w, wlibc.theme(wlibc.C_BORDER))
    } else if cf_edge == wlibc.WE_TOP {
        wlibc.hline(0, win_h - 1, win_w, wlibc.theme(wlibc.C_BORDER))
    } else if cf_edge == wlibc.WE_LEFT {
        wlibc.rect(win_w - 1, y0, 1, hh, wlibc.theme(wlibc.C_BORDER))
    } else {
        wlibc.rect(0, y0, 1, hh, wlibc.theme(wlibc.C_BORDER))
    }
    if shown == 0 {
        let _p0: u64 = wlibc.push(w_h, 0, y0, win_w, hh)
        return
    }
    let rs: u64 = button(st_x, st_y, st_w, st_h,
        txt((&k_start[0 as usize]) as u64,
            (&s_st[0 as usize]) as u64), false, false)
    var i: u64 = 0
    while i < nk {
        if kw[(i) as usize] != 0 {
            let lab: u64 = (&klab[0 as usize]) as u64 + i * 40
            let mk: u64 = mark_icon(knv[(i) as usize])
            let rc: u64 = button_mark(kx[(i) as usize], ky[(i) as usize],
                kw[(i) as usize], kh[(i) as usize], lab,
                kfok[(i) as usize] != 0, kver[(i) as usize] != 0, mk)
            if report {
                var bg: u64 = wlibc.theme(wlibc.C_BUTTON_FACE)
                var fg: u64 = wlibc.theme(wlibc.T_FG)
                if kfok[(i) as usize] != 0 {
                    bg = wlibc.theme(wlibc.T_SEL)
                    fg = wlibc.theme(wlibc.T_SELFG)
                } else if kver[(i) as usize] != 0 {
                    bg = wlibc.theme(wlibc.T_SCROLL)
                    fg = wlibc.theme(wlibc.T_DIM)
                }
                say((&s_bt[0 as usize]) as u64)
                ulib.sayn(i)
                say((&s_bi[0 as usize]) as u64)
                ulib.sayn(kid[(i) as usize])
                say((&s_tX[0 as usize]) as u64)
                ulib.sayn(kx[(i) as usize])
                say((&s_gy[0 as usize]) as u64)
                ulib.sayn(ky[(i) as usize])
                say((&s_gw[0 as usize]) as u64)
                ulib.sayn(kw[(i) as usize])
                say((&s_gh[0 as usize]) as u64)
                ulib.sayn(kh[(i) as usize])
                say((&s_bv[0 as usize]) as u64)
                ulib.sayn(kver[(i) as usize])
                say((&s_bf[0 as usize]) as u64)
                ulib.sayn(kfok[(i) as usize])
                say((&s_tt[0 as usize]) as u64)
                say(lab)
                // ROUND NETVIEW, addendum: WHICH mark, and WHERE -- and
                // ONLY when there is one. A picture that is reported but
                // not drawn and a picture that is drawn but not reported
                // both fail in `tools/netview/run.sh`, which reads these
                // numbers and then reads the pixels. But the normal case
                // is `real`, and printing `netv=0` for every window of
                // every repaint is a line about nothing on a line that
                // three programs share.
                if knv[(i) as usize] != 0 {
                    say((&s_bn[0 as usize]) as u64)
                    ulib.sayn(knv[(i) as usize])
                    if mk != 0 {
                        say((&s_bmx[0 as usize]) as u64)
                        ulib.sayn(kx[(i) as usize] + 3)
                        say((&s_bmy[0 as usize]) as u64)
                        ulib.sayn(ky[(i) as usize]
                            + (kh[(i) as usize] - MK_W) / 2)
                    }
                }
                ulib.nl()
                say_text((&m_btn[0 as usize]) as u64, rc >> 32,
                    rc & 0xFFFFFFFF, fg, bg, lab)
            }
        }
        i = i + 1
    }
    var f: u64 = 0
    while f < F_N {
        wlibc.rect(f_x[(f) as usize], f_y[(f) as usize], f_w[(f) as usize],
            f_h[(f) as usize], wlibc.theme(wlibc.T_PANEL))
        // ROUND NETVIEW, addendum: the state of the MACHINE, in the
        // corner, where every system has put it for thirty years. It
        // goes in FRONT of the address and not instead of it: the icon
        // says at a glance which of four things is true, the address
        // says which address -- and neither of them replaces the other.
        var icx: u64 = 0
        if f == F_NET {
            // SECOND ADDENDUM, and the ORDER is the argument: the
            // faking sign comes FIRST, before the state of the machine.
            // What is read first is what is read at all, and "this
            // system is telling programs a story" is the more important
            // of the two sentences -- especially in the one case that
            // needs it, `always` on a machine that is genuinely online,
            // where the state icon on its own would be true and
            // misleading at once.
            let sy: u64 = sys_icon()
            if sy != 0 {
                let _s: bool = wlibc.icon_draw(sy, f_x[(f) as usize] + 2,
                    f_y[(f) as usize] + (f_h[(f) as usize] - MK_W) / 2)
                icx = MK_W + 2
                if report && nv_faking != fk_said {
                    fk_said = nv_faking
                    say((&s_fk[0 as usize]) as u64)
                    ulib.sayn(nv_fall)
                    say((&s_tX[0 as usize]) as u64)
                    ulib.sayn(f_x[(f) as usize] + 2)
                    say((&s_gy[0 as usize]) as u64)
                    ulib.sayn(f_y[(f) as usize]
                        + (f_h[(f) as usize] - MK_W) / 2)
                    ulib.nl()
                }
            } else if report && nv_faking != fk_said {
                fk_said = nv_faking
                say((&s_fkno[0 as usize]) as u64)
                ulib.sayn(nv_fall)
                ulib.nl()
            }
            let ic: u64 = state_icon(net_state)
            if ic != 0 {
                let ix: u64 = f_x[(f) as usize] + 2 + icx
                let _i: bool = wlibc.icon_draw(ic, ix,
                    f_y[(f) as usize] + (f_h[(f) as usize] - IC_W) / 2)
                icx = icx + IC_W + 2
                if report && net_state != st_said {
                    st_said = net_state
                    say((&s_ic[0 as usize]) as u64)
                    ulib.sayn(net_state)
                    say((&s_tX[0 as usize]) as u64)
                    ulib.sayn(ix)
                    say((&s_gy[0 as usize]) as u64)
                    ulib.sayn(f_y[(f) as usize] + (f_h[(f) as usize] - IC_W) / 2)
                    ulib.nl()
                }
            }
        }
        var l: u64 = 0
        while l < f_lines[(f) as usize] {
            let p: u64 = line_of(f, l)
            let n: u64 = tlen(p)
            var tx: u64 = f_x[(f) as usize] + 4 + icx
            var base: u64 = f_y[(f) as usize] + (f_h[(f) as usize] + asc) / 2 - 1
            if f_lines[(f) as usize] > 1 {
                base = f_y[(f) as usize] + 2 + asc + l * LINE_H
            }
            let _e: u64 = wlibc.text_at(wlibc.F_UI, wlibc.PX_UI, tx, base,
                p, n, wlibc.theme(wlibc.T_FG))
            if report {
                var mark: u64 = (&m_net[0 as usize]) as u64
                if f == F_BAT {
                    mark = (&m_bat[0 as usize]) as u64
                } else if f == F_CLK {
                    mark = (&m_clk[0 as usize]) as u64
                }
                say_text(mark, tx, base, wlibc.theme(wlibc.T_FG),
                    wlibc.theme(wlibc.T_PANEL), p)
            }
            l = l + 1
        }
        if report {
            var mark: u64 = (&m_net[0 as usize]) as u64
            if f == F_BAT {
                mark = (&m_bat[0 as usize]) as u64
            } else if f == F_CLK {
                mark = (&m_clk[0 as usize]) as u64
            }
            say((&s_fl[0 as usize]) as u64)
            say(mark)
            say((&s_tX[0 as usize]) as u64)
            ulib.sayn(f_x[(f) as usize])
            say((&s_gy[0 as usize]) as u64)
            ulib.sayn(f_y[(f) as usize])
            say((&s_gw[0 as usize]) as u64)
            ulib.sayn(f_w[(f) as usize])
            say((&s_gh[0 as usize]) as u64)
            ulib.sayn(f_h[(f) as usize])
            say((&s_fn[0 as usize]) as u64)
            ulib.sayn(f_lines[(f) as usize])
            ulib.nl()
        }
        f = f + 1
    }
    // ROUND NETVIEW, addendum: WHAT THE POINTER IS RESTING ON, as a
    // sentence, in the empty space between the last window button and
    // the first status field. There is no tooltip window in this system
    // and a bar 28 pixels high cannot open one; this is the room there
    // is, and an icon nobody can look up is a rune.
    if hover_on != 0 && vertical == 0 {
        let hb: u64 = hover_left()
        let he: u64 = hover_right()
        if he > hb + 20 {
            wlibc.clip_set(hb, y0, he, y0 + hh)
            wlibc.rect(hb, st_y, he - hb, BTN_H,
                wlibc.theme(wlibc.T_PANEL))
            let hp: u64 = (&hover_txt[0 as usize]) as u64
            var hn: u64 = tlen(hp)
            while hn > 1 && wlibc.text_w(wlibc.F_UI, wlibc.PX_UI, hp, hn)
                + 6 > he - hb {
                hn = hn - 1
            }
            let hbase: u64 = st_y + (BTN_H + asc) / 2 - 1
            let _h: u64 = wlibc.text_at(wlibc.F_UI, wlibc.PX_UI, hb + 3,
                hbase, hp, hn, wlibc.theme(wlibc.T_DIM))
            wlibc.clip_set(0, y0, win_w, y0 + hh)
            if report {
                say((&s_hv[0 as usize]) as u64)
                say((&s_tX[0 as usize]) as u64)
                ulib.sayn(hb + 3)
                say((&s_tb[0 as usize]) as u64)
                ulib.sayn(hbase)
                say((&s_tt[0 as usize]) as u64)
                put_n(hp, hn)
                ulib.nl()
            }
        }
    }
    let _p: u64 = wlibc.push(w_h, 0, y0, win_w, hh)
    if report {
        say_text((&m_start[0 as usize]) as u64, rs >> 32,
            rs & 0xFFFFFFFF, wlibc.theme(wlibc.T_FG),
            wlibc.theme(wlibc.C_BUTTON_FACE),
            txt((&k_start[0 as usize]) as u64,
                (&s_st[0 as usize]) as u64))
    }
}

// THE WHOLE BAR, BAND BY BAND. The drawing surface of the widget
// library is 800 x 81 pixels; a horizontal bar is one band, a vertical
// one is eight. Everything is clipped to the band, so each band paints
// only what falls into it -- and the report is written in the FIRST
// band only, because it describes the layout and not the band.
fn paint(report: bool) {
    var y: u64 = 0
    var first: bool = true
    while y < win_h {
        var hh: u64 = BAND
        if y + hh > win_h {
            hh = win_h - y
        }
        paint_band(y, hh, report && first)
        first = false
        y = y + hh
    }
    paints = paints + 1
}

// ============================================================ the drag
//
// WHY THE POINTER IS POLLED AND NOT AWAITED. A window is only told
// about the pointer while the pointer is INSIDE it (kernel/wm.fi,
// `on_mouse`). A drag from the bottom edge to the left edge leaves the
// bar after four pixels and the button is let go on the other side of
// the screen, where no event of ours will ever be raised. So the bar
// asks for the position and the buttons directly (`WIG_SCREEN`), forty
// times a second, for as long as the drag lasts -- and for no longer.

static mut s_d0: [u8; 21] = "taskbar: drag start \0"
static mut s_d1: [u8; 20] = "taskbar: drag edge=\0"
static mut s_d2: [u8; 20] = "taskbar: drag done \0"
static mut s_wr: [u8; 10] = " written=\0"
static mut s_pv: [u8; 9] = "preview\0\0"

fn close_preview() {
    var i: u64 = 0
    while i < 4 {
        if prev_h[(i) as usize] != 0 {
            let _c: u64 = wlibc.sys3w(wlibc.WM_CLOSE, prev_h[(i) as usize],
                0, 0)
            prev_h[(i) as usize] = 0
        }
        i = i + 1
    }
    prev_on = 0
    prev_edge = 9
}

// ONE THIN ALWAYS-ON-TOP WINDOW. Four of them make the outline.
fn preview_win(x: u64, y: u64, w: u64, h: u64) -> u64 {
    let hd: u64 = wlibc.sys5(wlibc.WM_CREATE, (x << 16) | y,
        (w << 16) | h, (&s_pv[0 as usize]) as u64, 0, 0)
    if ulib.bad(hd) || hd == 0 {
        return 0
    }
    let _d: u64 = wlibc.win_state(hd, wlibc.WS_DECO, 0)
    let _l: u64 = wlibc.win_state(hd, wlibc.WS_LAYER, wlibc.L_TOP)
    let _f: u64 = wlibc.sys5(wlibc.WM_FILL, hd, 0, (w << 16) | h,
        wlibc.theme(wlibc.T_SEL), 0)
    let _u: u64 = wlibc.sys3w(wlibc.WM_FLUSH, hd, 0, 0)
    return hd
}

// THE PREVIEW RECTANGLE FOR AN EDGE. Four thin windows and not one
// filled sheet: a filled 128 x 600 window costs 300 kilooctets of
// buffer, and this process has 832 for the bar, the preview and the
// drawing surface together. An outline is 34.
fn preview_show(edge: u64) {
    if prev_on != 0 && prev_edge == edge {
        return
    }
    close_preview()
    rect_for(edge, thickness_of(edge))
    let x: u64 = r_x
    let y: u64 = r_y
    let w: u64 = r_w
    let h: u64 = r_h
    prev_h[(0) as usize] = preview_win(x, y, w, PREV_T)
    prev_h[(1) as usize] = preview_win(x, y + h - PREV_T, w, PREV_T)
    prev_h[(2) as usize] = preview_win(x, y, PREV_T, h)
    prev_h[(3) as usize] = preview_win(x + w - PREV_T, y, PREV_T, h)
    prev_on = 1
    prev_edge = edge
    say((&s_d1[0 as usize]) as u64)
    ulib.sayn(edge)
    say((&s_gx[0 as usize]) as u64)
    ulib.sayn(x)
    say((&s_gy[0 as usize]) as u64)
    ulib.sayn(y)
    say((&s_gw[0 as usize]) as u64)
    ulib.sayn(w)
    say((&s_gh[0 as usize]) as u64)
    ulib.sayn(h)
    ulib.nl()
}

// THE NEAREST EDGE TO A POINT. Plain distance to the four sides; the
// same rule Windows 10 used, and the reason a drag towards a corner
// picks the side you were heading for and not the one you started on.
fn nearest_edge(mx: u64, my: u64) -> u64 {
    var best: u64 = wlibc.WE_LEFT
    var d: u64 = mx
    if sw - 1 - mx < d {
        d = sw - 1 - mx
        best = wlibc.WE_RIGHT
    }
    if my < d {
        d = my
        best = wlibc.WE_TOP
    }
    if sh - 1 - my < d {
        d = sh - 1 - my
        best = wlibc.WE_BOTTOM
    }
    return best
}

fn drag_step() {
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    let e: u64 = nearest_edge(mx, my)
    drag_edge = e
    preview_show(e)
    if (wlibc.mouse_btn() & 1) == 0 {
        // let go: this is where the edge really changes.
        dragging = 0
        close_preview()
        var written: u64 = 0
        if e != cf_edge {
            cf_edge = e
            if conf_write() {
                written = 1
            }
            geometry()
            apply()
            let _l: bool = list_read()
            layout()
            paint(true)
            geom_say()
        }
        say((&s_d2[0 as usize]) as u64)
        say((&s_ed[0 as usize]) as u64)
        ulib.sayn(e)
        say((&s_wr[0 as usize]) as u64)
        ulib.sayn(written)
        ulib.nl()
    }
}

// ======================================================== the auto-hide

static mut s_hd: [u8; 14] = "taskbar: hide\0"
static mut s_sh2: [u8; 14] = "taskbar: show\0"
static mut s_ms: [u8; 5] = " ms=\0"

fn touches_edge(mx: u64, my: u64) -> bool {
    if cf_edge == wlibc.WE_BOTTOM {
        return my + 1 + REVEAL >= sh
    }
    if cf_edge == wlibc.WE_TOP {
        return my <= REVEAL
    }
    if cf_edge == wlibc.WE_LEFT {
        return mx <= REVEAL
    }
    return mx + 1 + REVEAL >= sw
}

fn inside_bar(mx: u64, my: u64) -> bool {
    return mx >= bar_x && mx < bar_x + bar_w
        && my >= bar_y && my < bar_y + bar_h
}

// PULL IT IN, LET IT OUT. The measurement the runner takes is the time
// between the pointer REACHING the edge and the bar STANDING there --
// `hide_t0` is stamped at the first poll that saw the pointer on the
// edge, the second stamp is taken after the repaint. Ticks are 10
// milliseconds in this kernel (`kernel/time.fi`, TICK_HZ = 100), so
// that is the resolution of the number and not a millisecond.
fn autohide_step() {
    if cf_autohide == 0 {
        return
    }
    let mx: u64 = wlibc.mouse_x()
    let my: u64 = wlibc.mouse_y()
    if shown == 0 {
        if touches_edge(mx, my) {
            if hide_t0 == 0 {
                hide_t0 = ticks()
            }
            shown = 1
            apply()
            layout()
            // PAINTED, NOT REPORTED, and the stopwatch stops here. The
            // first version reported the whole layout inside this paint
            // and measured 230 ms -- most of which was the serial line,
            // not the bar. What is timed is the work the user waits
            // for: resize, move, reserve, draw. The layout is reported
            // afterwards, outside the measurement.
            paint(false)
            let t1: u64 = ticks()
            say((&s_sh2[0 as usize]) as u64)
            say((&s_ms[0 as usize]) as u64)
            ulib.sayn((t1 - hide_t0) * 10)
            ulib.nl()
            hide_t0 = 0
            paint(true)
        }
        return
    }
    if dragging != 0 {
        return
    }
    if !inside_bar(mx, my) {
        shown = 0
        apply()
        paint(false)
        say((&s_hd[0 as usize]) as u64)
        ulib.nl()
    }
}

// ============================================================== clicks

static mut s_cl: [u8; 18] = "taskbar: click x=\0"
static mut s_cy: [u8; 4] = " y=\0"
static mut s_ct: [u8; 8] = " hits=\0\0"
static mut s_act: [u8; 17] = "taskbar: act id=\0"
static mut s_aw: [u8; 6] = " was=\0"
static mut s_sp: [u8; 23] = "taskbar: launcher pid=\0"
static mut p_start: [u8; 14] = "/bin/launcher\0"
static mut z_start: [u8; 6] = "start\0"
static mut z_task: [u8; 7] = "window\0"
static mut z_none: [u8; 5] = "none\0"
static mut z_qs: [u8; 6] = "quick\0"
static mut s_noqs: [u8; 28] = "taskbar: no quick settings\0\0"

fn click(x: u64, y: u64) {
    clicks = clicks + 1
    say((&s_cl[0 as usize]) as u64)
    ulib.sayn(x)
    say((&s_cy[0 as usize]) as u64)
    ulib.sayn(y)
    // THIRD ADDENDUM: the icon group in the corner opens the quick
    // settings, the way the same corner does on every system that has
    // such a panel. Before the window buttons, because it is a field
    // and not a button and would otherwise fall through to the drag.
    if x >= f_x[(F_NET) as usize]
        && x < f_x[(F_NET) as usize] + f_w[(F_NET) as usize]
        && y >= f_y[(F_NET) as usize]
        && y < f_y[(F_NET) as usize] + f_h[(F_NET) as usize] {
        say((&s_ct[0 as usize]) as u64)
        say((&z_qs[0 as usize]) as u64)
        ulib.nl()
        qs.toggle()
        return
    }
    if x >= st_x && x < st_x + st_w && y >= st_y && y < st_y + st_h {
        say((&s_ct[0 as usize]) as u64)
        say((&z_start[0 as usize]) as u64)
        ulib.nl()
        let pid: u64 = ulib.sys(ulib.SYS_SPAWN,
            (&p_start[0 as usize]) as u64, 0, 0)
        say((&s_sp[0 as usize]) as u64)
        ulib.sayn(pid)
        ulib.nl()
        return
    }
    var i: u64 = 0
    while i < nk {
        if kw[(i) as usize] != 0 {
            if x >= kx[(i) as usize] && x < kx[(i) as usize] + kw[(i) as usize]
                && y >= ky[(i) as usize]
                && y < ky[(i) as usize] + kh[(i) as usize] {
                say((&s_ct[0 as usize]) as u64)
                say((&z_task[0 as usize]) as u64)
                ulib.nl()
                let rc: u64 = wlibc.win_act(kid[(i) as usize],
                    wlibc.WA_TOGGLE)
                acts = acts + 1
                say((&s_act[0 as usize]) as u64)
                ulib.sayn(kid[(i) as usize])
                say((&s_aw[0 as usize]) as u64)
                ulib.sayn(wlibc.WA_TOGGLE)
                say((&s_rc[0 as usize]) as u64)
                ulib.sayn(rc)
                ulib.nl()
                let _a: bool = list_read()
                layout()
                paint(true)
                return
            }
        }
        i = i + 1
    }
    // NOTHING WAS HIT -- so this press is the beginning of a drag. That
    // is the whole gesture: press on an empty part of the bar and pull.
    say((&s_ct[0 as usize]) as u64)
    say((&z_none[0 as usize]) as u64)
    ulib.nl()
    dragging = 1
    drag_edge = cf_edge
    prev_edge = 9
    say((&s_d0[0 as usize]) as u64)
    say((&s_gx[0 as usize]) as u64)
    ulib.sayn(x)
    say((&s_cy[0 as usize]) as u64)
    ulib.sayn(y)
    ulib.nl()
}

// ================================================================ main

static mut s_bad: [u8; 23] = "taskbar: no surface\0\0\0\0"
static mut s_nol: [u8; 40] = "taskbar: no layer 2 -- not root?\0\0\0\0\0\0\0\0"
static mut s_rdy: [u8; 22] = "taskbar: ready ascent\0"
static mut s_eq: [u8; 2] = "=\0"
static mut s_stt: [u8; 18] = "taskbar: state n=\0"
static mut s_pm: [u8; 9] = " paints=\0"
static mut s_ck: [u8; 9] = " clicks=\0"
static mut s_ac: [u8; 7] = " acts=\0"
static mut s_wt: [u8; 9] = " writes=\0"
static mut s_title: [u8; 8] = "Taskbar\0"
static mut s_theme: [u8; 11] = "/etc/theme\0"
static mut a_once: [u8; 5] = "once\0"

fn u_start(args: u64) -> u64 {
    var once: bool = false
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        if ulib.streq(ulib.arg_at(args, a), (&a_once[0 as usize]) as u64) {
            once = true
        }
        a = a + 1
    }
    let _mk: u64 = msg.init()
    if !wlibc.start(false) {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    // RUNDE THEME: nicht mehr eine Datei mit achtzehn Farben, sondern
    // der ganze Satz -- Einstellungen, Schema, Zeitzone, aufgeloest.
    let _t0: u64 = wlibc.theme_reload()
    // ROUND NETVIEW, addendum: the seven pictures, once, at the start.
    // A bar that reads them every repaint would read them sixty times a
    // second for something that never changes.
    icons_load()
    say((&s_ico[0 as usize]) as u64)
    ulib.sayn(ic_ok)
    say((&s_icm[0 as usize]) as u64)
    ulib.sayn(mk_ok)
    say((&s_ics[0 as usize]) as u64)
    ulib.sayn(sy_ok)
    ulib.nl()
    sw = wlibc.screen_w()
    sh = wlibc.screen_h()
    asc = wlibc.ascent_of(wlibc.F_UI, wlibc.PX_UI)
    cf_height = DEF_H
    cf_width = DEF_V
    if conf_read() {
        cf_from_file = 1
    }
    conf_say()
    geometry()
    // THE WINDOW IS CREATED AS LARGE AS THE LARGEST CONFIGURATION AND
    // NOT AS LARGE AS THE CURRENT ONE. `win_size` can shrink a window
    // and can grow it back, but it cannot grow it past the buffer it
    // was created with -- and a bar that starts at the bottom (800 x 28,
    // 89 kilooctets) and is dragged to the left (104 x 600, 249) would
    // be refused at exactly that moment.
    let h: u64 = wlibc.sys5(wlibc.WM_CREATE, 0, (V_MAX << 16) | sh,
        txt((&k_title[0 as usize]) as u64,
            (&s_title[0 as usize]) as u64), 0, 0)
    if ulib.bad(h) || h == 0 {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    w_h = h
    if ulib.bad(wlibc.win_state(h, wlibc.WS_DECO, 0)) {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    if ulib.bad(wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_TOP)) {
        say((&s_nol[0 as usize]) as u64)
        ulib.nl()
        let _c: u64 = wlibc.sys3w(wlibc.WM_CLOSE, h, 0, 0)
        return 1
    }
    apply()
    say((&s_rdy[0 as usize]) as u64)
    say((&s_eq[0 as usize]) as u64)
    ulib.sayn(asc)
    ulib.nl()
    let _u: bool = status_build()
    let _l: bool = list_read()
    // THIRD ADDENDUM: the quick settings own a second window of this
    // process, created here and kept hidden. Opening it is a move and a
    // repaint and NOT a program start -- which is why it can be timed
    // in microseconds.
    if !qs.init(cf_autohide) {
        say((&s_noqs[0 as usize]) as u64)
        ulib.nl()
    }
    apply()
    layout()
    paint(true)
    geom_say()
    // RUNDE THEME: DIE TASKLEISTE GIBT DEM SERVER DIE DEKORATION.
    // Sie tut es hier und nicht frueher: das Recht dazu haengt daran,
    // dass sie ein Fenster auf der obersten Ebene HAT, und das hat sie
    // erst jetzt. Sie ist auch die richtige Stelle dafuer -- sie ist
    // das Programm, dem die Umrandung des Schreibtischs gehoert.
    var s_dk: [u8; 16] = "leiste: deko n=\0"
    say((&s_dk[0 as usize]) as u64)
    ulib.sayn(wlibc.deco_push())
    ulib.nl()
    if once {
        return 0
    }
    var round: u64 = 0
    var tsum: u64 = wlibc.theme_sum()
    var alive: bool = true
    while alive {
        var n: u64 = 0
        while n < 32 && wlibc.sys3w(wlibc.WM_EVENT, h,
            (&ev[0 as usize]) as u64, 0) == 1 {
            let b: u64 = (&ev[0 as usize]) as u64
            let typ: u64 = __mmio_read64((b) as *mut u64)
            let d: u64 = __mmio_read64((b + 8) as *mut u64)
            if typ == wlibc.EV_DOWN {
                click((d >> 32) & 0xFFFF, (d >> 16) & 0xFFFF)
            } else if typ == wlibc.EV_CLOSE {
                alive = false
            }
            n = n + 1
        }
        if dragging != 0 {
            drag_step()
        }
        // THIRD ADDENDUM. The panel polls its own window, the hotkey
        // latch and the pointer; the only thing it hands back is the
        // one setting that lives in a FILE THIS BAR OWNS. Two writers
        // of `/etc/taskbar.conf` inside one process would be two
        // answers to one question.
        let _qsc: bool = qs.step()
        let hw: u64 = qs.want_hide()
        if hw != 0 {
            if hw == 1 {
                cf_autohide = 1
            } else {
                cf_autohide = 0
            }
            let _cw: bool = conf_write()
            conf_say()
            geometry()
            shown = 1
            apply()
            layout()
            paint(true)
            geom_say()
            qs.took_hide(cf_autohide)
        }
        autohide_step()
        round = round + 1
        var fresh: bool = false
        // ROUND NETVIEW, addendum. Every poll, because the pointer
        // moves between polls and a sentence that appears half a second
        // after the pointer arrived is a sentence nobody waits for. It
        // costs a comparison unless something changed.
        if hover_step() {
            fresh = true
        }
        if (round % 5) == 0 {
            if list_read() {
                fresh = true
            }
        }
        if (round % 10) == 0 {
            if status_build() {
                fresh = true
            }
            // RUNDE THEME: `theme_poll` liest nach und sagt, ob sich
            // die AUFGELOESTEN Marken geaendert haben -- nicht, ob
            // jemand eine Datei angefasst hat. Eine Leiste, die nach
            // einem `touch` neu malt, malt umsonst. Und wenn sich
            // wirklich etwas geaendert hat, bekommt der Server die
            // neue Dekoration.
            if wlibc.theme_poll() {
                tsum = wlibc.theme_sum()
                let _dk: u64 = wlibc.deco_push()
                fresh = true
            }
            // RUNDE I18N: UND DIE SPRACHE, an derselben Stelle und aus
            // demselben Grund wie das Farbschema -- eine Taskleiste,
            // die fuer einen Sprachwechsel einen Neustart braucht, ist
            // keine. `msg.changed` liest die Wahl des Benutzers und
            // fuellt die Plaetze neu; die Zeiger bleiben gueltig, nur
            // ihr Inhalt ist neu. Danach muss `status_build` noch
            // einmal laufen, weil "no battery" in die Puffer KOPIERT
            // wird.
            if msg.changed() {
                let _s2: bool = status_build()
                fresh = true
                // UND EINMAL AUSFUEHRLICH MELDEN: `fresh` fuehrt weiter
                // unten zu `paint(true)`, und das gibt die Textfelder
                // aus. Ein Testlaeufer muss sehen koennen, dass DIESER
                // Prozess -- nicht der, der umgestellt hat -- jetzt
                // eine andere Sprache spricht.
            }
            // AND THE CONFIGURATION. This is how a change made in
            // /bin/einstellungen arrives here without a restart: the
            // settings write the file, the bar notices within half a
            // second. There is no message, no shared memory and no
            // second copy of the state -- there is the file.
            let old_e: u64 = cf_edge
            let old_h: u64 = cf_height
            let old_w: u64 = cf_width
            let old_a: u64 = cf_autohide
            let old_o: u64 = cf_ontop
            if conf_read() {
                if cf_edge != old_e || cf_height != old_h
                    || cf_width != old_w || cf_autohide != old_a
                    || cf_ontop != old_o {
                    conf_say()
                    geometry()
                    shown = 1
                    apply()
                    fresh = true
                    geom_say()
                }
            }
        }
        if fresh && shown != 0 {
            layout()
            // REPORTED, NOT JUST PAINTED -- and the difference cost two
            // measurements. The first version reported the layout only
            // on the very first paint. By the time the screenshot was
            // taken the starter had opened a window, the buttons had
            // been re-laid out and re-shortened, and the runner was
            // comparing the picture against a layout replaced seconds
            // earlier. Every repaint now says what it painted.
            paint(true)
            say((&s_stt[0 as usize]) as u64)
            ulib.sayn(nk)
            say((&s_pm[0 as usize]) as u64)
            ulib.sayn(paints)
            say((&s_ck[0 as usize]) as u64)
            ulib.sayn(clicks)
            say((&s_ac[0 as usize]) as u64)
            ulib.sayn(acts)
            say((&s_wt[0 as usize]) as u64)
            ulib.sayn(writes)
            ulib.nl()
        }
        // AND ONCE MORE BEFORE THE SLEEP. Measured, not guessed: with
        // one look per turn the hotkey took 93 to 128 milliseconds,
        // because a key pressed early in a turn waits out the whole
        // repaint of the bar -- WITH its report on the serial line --
        // before anything looks at the latch. A second look here costs
        // one system call and takes the repaint out of the wait.
        let _qs2: bool = qs.step()
        ulib.sleep_ms(25)
    }
    return 0
}
