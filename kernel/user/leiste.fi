// kernel/user/leiste.fi -- Runde DESKTOP: /bin/leiste, DIE TASKLEISTE.
//
// Am 27.08.2026 hat Justin gefragt, ob Osum eine Taskleiste hat. Die
// Antwort war nein, und sie war nicht knapp daneben: im ganzen Baum gab
// es kein Panel, kein Dock und keine Leiste -- jeder Treffer auf
// "Leiste" war die TITELleiste eines Fensters. Das hier ist die
// Antwort darauf.
//
// WAS SIE ZEIGT, von links nach rechts:
//
//   Start        oeffnet den Starter (`/bin/starter`, Runde K15) --
//                das Fenster mit dem Suchfeld ueber `/apps`.
//   je Fenster   einen Knopf mit dem Titel. Ein Klick holt das Fenster
//                nach vorn; ein Klick auf das Fenster, das schon vorn
//                ist, legt es weg (minimieren). Das ist die Regel jeder
//                Taskleiste seit Windows 95, und sie steht in EINER
//                Zeile im Kernel (`WA_TOGGLE`).
//   Netz         die eigene Adresse, oder "kein Netz".
//   Akku         Ladestand in Prozent, oder "kein Akku" -- und das ist
//                keine Kosmetik: eine erfundene Null in Prozent sieht
//                aus wie eine Messung. Die Zahl kommt aus
//                `osum_pwrget` (Runde K18) und aus nichts sonst.
//   Uhr          Stunde und Minute aus `sysinfo` (Runde K9).
//
// WIE SIE VON DEN ANDEREN FENSTERN WEISS. Ueber `WM_LIST` und `WM_ACT`
// (Runde DESKTOP, `kernel/sys.fi`), und die beiden geben nur dem
// Auskunft, der SELBST ein Fenster auf der obersten Ebene hat -- also
// einer Taskleiste. Eine gewoehnliche Anwendung bekommt -E_RIGHTS und
// sieht die Titel der anderen NICHT. Das ist mit Absicht so eng: eine
// Liste aller Fenstertitel ist eine Auskunft ueber fremde Prozesse.
//
// SIE NIMMT DIE TASTATUR NICHT. Ein Klick auf die Leiste wechselt das
// Fenster und stiehlt dabei nicht den Eingabefokus -- das entscheidet
// der Server anhand der Ebene (`kernel/wm.fi`, `on_mouse`).
//
// SIE MALT SICH IN EINEM ZUG. Das Fenster ist 800 x 28 Bildpunkte und
// passt damit in EINEN Streifen der Zeichenflaeche (800 x 81) -- ein
// Neuzeichnen ist ein einziger WIG_BLIT.

profile kernel

import ulib
import wlibc
import msg

export { u_start }

// ================================================ RUNDE I18N: DIE TEXTE
//
// Fuenf Zeichenketten dieser Datei sind ANZEIGETEXT und standen bis
// heute auf Deutsch im Quelltext: der Fenstername, der Startknopf und
// die drei Meldungen ueber Akku und Netz. Hier stehen ab jetzt ihre
// SCHLUESSEL -- englisch, wie jeder Name in diesem System -- und der
// Text kommt zur Laufzeit aus /usr/share/locale/<code>/messages.
//
// WAS NICHT UEBERSETZT WIRD und deshalb NICHT hier steht: die Meldungen
// auf der seriellen Leitung ("leiste: knopf i=..."), die Namen der
// Messfelder ("start", "uhr", "akku", "netz") und der Pfad
// "/etc/theme". Das erste ist ein Mitschnitt fuer Testlaeufer, das
// zweite sind Namen, das dritte ist ein Pfad -- alle drei bleiben
// englisch bzw. wie sie sind. Wer einen Mitschnitt uebersetzt, macht
// jeden Testlaeufer sprachabhaengig.
static mut k_title: [u8; 14] = "taskbar.title\0"
static mut k_start: [u8; 14] = "taskbar.start\0"
static mut k_batt: [u8; 16] = "taskbar.battery\0"
static mut k_nobatt: [u8; 19] = "taskbar.no_battery\0"
static mut k_nonet: [u8; 19] = "taskbar.no_network\0"


const PH: u64 = 28 // die Hoehe der Leiste
const KY: u64 = 3 // der obere Rand eines Knopfes
const KH: u64 = 22 // seine Hoehe
const START_X: u64 = 4
const START_W: u64 = 64
const TASK_X: u64 = 72
const TASK_MAX: u64 = 132 // so breit wird ein Knopf hoechstens
const TASK_MIN: u64 = 48
const UHR_W: u64 = 56
const AKKU_W: u64 = 82
const NETZ_W: u64 = 124
const LUECKE: u64 = 4
const MAXK: u64 = 10 // so viele Fensterknoepfe passen hoechstens

// Die Aufrufe, die diese Leiste ausser dem Fensterserver braucht.
const SYS_PWRGET: u64 = 1750
const PG_BATPRESENT: u64 = 24
const PG_BATPERCENT: u64 = 25
const SYS_NETGET: u64 = 1300
const NG_READY: u64 = 0
const NG_IP: u64 = 1

static mut w_h: u64 = 0
static mut sw: u64 = 0
static mut sh: u64 = 0
static mut py: u64 = 0 // wo die Leiste auf dem Schirm anfaengt
static mut satz: [u8; 96] = [0 as u8; 96]
static mut ev: [u8; 16] = [0 as u8; 16]
static mut kid: [u64; 10] = [0 as u64; 10]
static mut kver: [u64; 10] = [0 as u64; 10]
static mut kfok: [u64; 10] = [0 as u64; 10]
static mut kx: [u64; 10] = [0 as u64; 10]
static mut kw: [u64; 10] = [0 as u64; 10]
static mut ktit: [u8; 400] = [0 as u8; 400] // MAXK * 40
static mut klab: [u8; 400] = [0 as u8; 400] // das, was WIRKLICH dasteht
static mut nk: u64 = 0
static mut uhr: [u8; 8] = [0 as u8; 8]
static mut akku: [u8; 24] = [0 as u8; 24]
static mut netz: [u8; 32] = [0 as u8; 32]
static mut minute: u64 = 999
static mut standsumme: u64 = 0
static mut versatz: u64 = 0 // Minuten aus /etc/zeit.conf
static mut zustand: u64 = 0 // Pruefsumme ueber die Fensterliste
static mut klicks: u64 = 0
static mut taten: u64 = 0
static mut male: u64 = 0
static mut asc: u64 = 0

fn say(p: u64) {
    ulib.say(p)
}

fn tlen(p: u64) -> u64 {
    return ulib.length(p)
}

// Zwei Ziffern an eine Stelle. Eine Uhr, die "9:5" zeigt, ist keine.
fn zwei(p: u64, at: u64, v: u64) {
    let a: u64 = (v / 10) % 10
    let b: u64 = v % 10
    __mmio_write8((p + at) as *mut u8, (48 + a) as u8)
    __mmio_write8((p + at + 1) as *mut u8, (48 + b) as u8)
}

fn zahl_an(p: u64, at: u64, v: u64) -> u64 {
    if v == 0 {
        __mmio_write8((p + at) as *mut u8, 48 as u8)
        return at + 1
    }
    var stellen: u64 = 0
    var t: u64 = v
    while t > 0 {
        stellen = stellen + 1
        t = t / 10
    }
    var k: u64 = stellen
    t = v
    while k > 0 {
        k = k - 1
        __mmio_write8((p + at + k) as *mut u8, (48 + (t % 10)) as u8)
        t = t / 10
    }
    return at + stellen
}

fn text_an(p: u64, at: u64, q: u64) -> u64 {
    var k: u64 = 0
    while __mmio_read8((q + k) as *mut u8) != 0 as u8 {
        __mmio_write8((p + at + k) as *mut u8,
            __mmio_read8((q + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((p + at + k) as *mut u8, 0 as u8)
    return at + k
}

// ---------------------------------------------------------- das Malen

// Ein Knopf: Flaeche, Kante, Aufschrift -- und die Aufschrift MITTIG.
// Gibt die Stelle der Aufschrift zurueck, damit sie gemeldet werden
// kann; der Laeufer rechnet sie im Bild JE ZEICHEN nach.
fn knopf(x: u64, w: u64, txt: u64, ein: bool, grau: bool) -> u64 {
    var bg: u64 = wlibc.theme(wlibc.T_BTN)
    if ein {
        bg = wlibc.theme(wlibc.T_SEL)
    } else if grau {
        bg = wlibc.theme(wlibc.T_SCROLL)
    }
    wlibc.rect(x, KY, w, KH, bg)
    wlibc.frame3(x, KY, w, KH, wlibc.theme(wlibc.T_BTNHI),
        wlibc.theme(wlibc.T_LINE), ein)
    var fg: u64 = wlibc.theme(wlibc.T_FG)
    if ein {
        fg = wlibc.theme(wlibc.T_SELFG)
    } else if grau {
        fg = wlibc.theme(wlibc.T_DIM)
    }
    let n: u64 = tlen(txt)
    var tw: u64 = wlibc.text_w(wlibc.F_UI, wlibc.PX_UI, txt, n)
    if tw + 8 > w {
        tw = w - 8
    }
    let tx: u64 = x + (w - tw) / 2
    let base: u64 = KY + (KH + asc) / 2 - 1
    let _e: u64 = wlibc.text_at(wlibc.F_UI, wlibc.PX_UI, tx, base, txt, n,
        fg)
    return (tx << 32) | base
}

// Ein Feld rechts: Flaeche in Leistenfarbe, Text linksbuendig.
fn feld(x: u64, w: u64, txt: u64) -> u64 {
    wlibc.rect(x, KY, w, KH, wlibc.theme(wlibc.T_PANEL))
    let n: u64 = tlen(txt)
    let base: u64 = KY + (KH + asc) / 2 - 1
    let _e: u64 = wlibc.text_at(wlibc.F_UI, wlibc.PX_UI, x + 4, base, txt,
        n, wlibc.theme(wlibc.T_FG))
    return ((x + 4) << 32) | base
}

static mut r_start: u64 = 0
static mut r_uhr: u64 = 0
static mut r_akku: u64 = 0
static mut r_netz: u64 = 0
static mut x_uhr: u64 = 0
static mut x_akku: u64 = 0
static mut x_netz: u64 = 0

fn melde_text(marke: u64, rc: u64, bg: u64, fg: u64, txt: u64) {
    var s_t: [u8; 14] = "leiste: text \0"
    var s_x: [u8; 4] = " x=\0"
    var s_b: [u8; 7] = " base=\0"
    var s_f: [u8; 5] = " fg=\0"
    var s_g: [u8; 5] = " bg=\0"
    var s_e: [u8; 4] = " t=\0"
    say((&s_t[0 as usize]) as u64)
    say(marke)
    say((&s_x[0 as usize]) as u64)
    ulib.sayn(rc >> 32)
    say((&s_b[0 as usize]) as u64)
    ulib.sayn(rc & 0xFFFFFFFF)
    say((&s_f[0 as usize]) as u64)
    ulib.sayn(fg)
    say((&s_g[0 as usize]) as u64)
    ulib.sayn(bg)
    say((&s_e[0 as usize]) as u64)
    say(txt)
    ulib.nl()
}

// DIE UHR, DER AKKU UND DAS NETZ. Jede Zahl kommt aus einem
// Systemaufruf; keine steht in diesem Programm.
// DER VERSATZ ZUR ORTSZEIT. Die Hardware-Uhr dieses Rechners laeuft
// nach UTC, und dieser Kernel kann sie nicht stellen (er hat nur
// `SYS_TIME` zum Lesen). Was ein Programm in Ring 3 tun kann, ist die
// ANZEIGE verschieben -- und genau das steht in `/etc/zeit.conf`, das
// die Einstellungen schreiben:
//
//     offset=120
//
// Ohne Datei bleibt es bei UTC, und die Leiste behauptet nichts anderes.
fn versatz_lesen() {
    var pfad: [u8; 15] = "/etc/zeit.conf␀"
    var buf: [u8; 64] = [0 as u8; 64]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&pfad[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return
    }
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&buf[0 as usize]) as u64, 63)
    let _c: u64 = ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        return
    }
    let b: u64 = (&buf[0 as usize]) as u64
    var i: u64 = 0
    var v: u64 = 0
    var ziffern: u64 = 0
    var im_wert: bool = false
    while i < n {
        let c: u64 = __mmio_read8((b + i) as *mut u8) as u64
        if c == 61 {
            im_wert = true
        } else if im_wert && c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
            ziffern = ziffern + 1
        } else if ziffern > 0 {
            i = n
        }
        i = i + 1
    }
    if ziffern > 0 && v <= 1440 {
        versatz = v
    }
}

fn stand_holen() -> bool {
    let s_kA: u64 = msg.get((&k_nobatt[0 as usize]) as u64)
    let s_kN: u64 = msg.get((&k_nonet[0 as usize]) as u64)
    let s_ak: u64 = msg.get((&k_batt[0 as usize]) as u64)
    var s_pz: [u8; 2] = "%\0"
    var s_pt: [u8; 2] = ".\0"
    versatz_lesen()
    let st: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_HOUR, 0, 0)
    let mi: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_MIN, 0, 0)
    // Ortszeit statt UTC: die Minuten seit Mitternacht plus Versatz,
    // modulo einen Tag. In EINER Rechnung, damit 23:30 + 120 nicht
    // 25:30 wird.
    let ganz: u64 = ((st * 60 + mi) + versatz) % 1440
    let u: u64 = (&uhr[0 as usize]) as u64
    zwei(u, 0, ganz / 60)
    __mmio_write8((u + 2) as *mut u8, 58 as u8)
    zwei(u, 3, ganz % 60)
    __mmio_write8((u + 5) as *mut u8, 0 as u8)
    minute = mi
    // der Akku
    let a: u64 = (&akku[0 as usize]) as u64
    let da: u64 = ulib.sys(SYS_PWRGET, PG_BATPRESENT, 0, 0)
    if ulib.bad(da) || da == 0 {
        let _q: u64 = text_an(a, 0, s_kA)
    } else {
        let pz: u64 = ulib.sys(SYS_PWRGET, PG_BATPERCENT, 0, 0)
        if ulib.bad(pz) {
            let _q: u64 = text_an(a, 0, s_kA)
        } else {
            var at: u64 = text_an(a, 0, s_ak)
            at = zahl_an(a, at, pz)
            let _q: u64 = text_an(a, at, (&s_pz[0 as usize]) as u64)
        }
    }
    // das Netz
    let ne: u64 = (&netz[0 as usize]) as u64
    let rd: u64 = ulib.sys(SYS_NETGET, NG_READY, 0, 0)
    if ulib.bad(rd) || rd == 0 {
        let _q: u64 = text_an(ne, 0, s_kN)
    } else {
        let ip: u64 = ulib.sys(SYS_NETGET, NG_IP, 0, 0)
        if ulib.bad(ip) || ip == 0 {
            let _q: u64 = text_an(ne, 0, s_kN)
        } else {
            var at: u64 = zahl_an(ne, 0, (ip >> 24) & 255)
            at = text_an(ne, at, (&s_pt[0 as usize]) as u64)
            at = zahl_an(ne, at, (ip >> 16) & 255)
            at = text_an(ne, at, (&s_pt[0 as usize]) as u64)
            at = zahl_an(ne, at, (ip >> 8) & 255)
            at = text_an(ne, at, (&s_pt[0 as usize]) as u64)
            at = zahl_an(ne, at, ip & 255)
            __mmio_write8((ne + at) as *mut u8, 0 as u8)
        }
    }
    // HAT SICH IRGENDETWAS GEAENDERT? Die erste Fassung sah nur auf die
    // Minute -- und die Leiste zeigte nach dem DHCP-Lauf weiter die alte
    // Adresse, weil die Minute dieselbe war. Also eine Pruefsumme ueber
    // ALLES, was rechts steht.
    var summe: u64 = 1469598103934665603
    var q: u64 = 0
    while q < 3 {
        var pz: u64 = (&uhr[0 as usize]) as u64
        if q == 1 {
            pz = (&akku[0 as usize]) as u64
        } else if q == 2 {
            pz = (&netz[0 as usize]) as u64
        }
        var kk: u64 = 0
        while __mmio_read8((pz + kk) as *mut u8) != 0 as u8 && kk < 40 {
            // RUNDE I18N, NEBENBEFUND: DAS `*%` STAND AM ANFANG DER
            // ZWEITEN ZEILE, und damit liess sich diese Datei GAR NICHT
            // uebersetzen -- firnc sagt "expected an expression, found
            // '*%'". Der Zerteiler kann eine Zeile fortsetzen, solange
            // sie unvollstaendig ist (eine offene Klammer); eine Zeile,
            // die eine fertige Zahl ergibt, ist zu Ende. Gefunden hat
            // es diese Runde beim ersten Uebersetzen der Taskleiste.
            summe = (summe ^ (__mmio_read8((pz + kk) as *mut u8) as u64)) *%
                1099511628211
            kk = kk + 1
        }
        q = q + 1
    }
    let neu: bool = summe != standsumme
    standsumme = summe
    return neu
}

// DIE FENSTERLISTE. Sie kommt Satz fuer Satz aus dem Server; genommen
// werden nur die der NORMALEN Ebene -- die Leiste selbst und der
// Schreibtisch gehoeren nicht in die Leiste.
fn liste_holen() -> bool {
    var summe: u64 = 1469598103934665603
    var n: u64 = 0
    var platz: u64 = 0
    while platz < 16 && n < MAXK {
        let r: u64 = wlibc.win_list(platz, (&satz[0 as usize]) as u64)
        if ulib.bad(r) {
            platz = 16
        } else if r == 1 {
            let b: u64 = (&satz[0 as usize]) as u64
            let ebene: u64 = __mmio_read64((b + wlibc.WL_LAYER) as *mut u64)
            if ebene == wlibc.L_NORMAL {
                let id: u64 = __mmio_read64((b + wlibc.WL_ID) as *mut u64)
                let fl: u64 = __mmio_read64((b + wlibc.WL_FLAGS) as *mut u64)
                let fo: u64 = __mmio_read64((b + wlibc.WL_FOCUS) as *mut u64)
                kid[(n) as usize] = id
                kver[(n) as usize] = fl & wlibc.F_HIDDEN
                kfok[(n) as usize] = fo
                var k: u64 = 0
                while k < 31 {
                    ktit[((n * 40 + k)) as usize] =
                        __mmio_read8((b + wlibc.WL_TITLE + k) as *mut u8)
                    k = k + 1
                }
                ktit[((n * 40 + 31)) as usize] = 0 as u8
                summe = (summe ^ (id *% 131 +% (fl & 1) *% 7 +% fo)) *% 1099511628211
                n = n + 1
            }
            platz = platz + 1
        } else {
            platz = platz + 1
        }
    }
    nk = n
    summe = summe ^ (n *% 1000003)
    let anders: bool = summe != zustand
    zustand = summe
    return anders
}

// EINEN TITEL SO WEIT KUERZEN, DASS ER IN DEN KNOPF PASST -- und das
// Ergebnis steht danach in `klab`, also genau das, was wirklich auf dem
// Schirm landet. Der Laeufer prueft DIESEN Text je Zeichen; ein
// Programm, das den ungekuerzten meldet und den gekuerzten malt, waere
// nicht nachrechenbar.
fn kuerzen(i: u64, breite: u64) {
    let q: u64 = (&ktit[0 as usize]) as u64 + i * 40
    let z: u64 = (&klab[0 as usize]) as u64 + i * 40
    var n: u64 = tlen(q)
    if n > 31 {
        n = 31
    }
    while n > 1 && wlibc.text_w(wlibc.F_UI, wlibc.PX_UI, q, n) + 10 > breite {
        n = n - 1
    }
    var k: u64 = 0
    while k < n {
        __mmio_write8((z + k) as *mut u8, __mmio_read8((q + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((z + n) as *mut u8, 0 as u8)
}

fn malen(melden: bool) {
    let s_St: u64 = msg.get((&k_start[0 as usize]) as u64)
    var m_st: [u8; 6] = "start\0"
    var m_uh: [u8; 4] = "uhr\0"
    var m_ak: [u8; 5] = "akku\0"
    var m_ne: [u8; 5] = "netz\0"
    var m_kn: [u8; 6] = "knopf\0"
    var s_kk: [u8; 17] = "leiste: knopf i=\0"
    var s_ki: [u8; 5] = " id=\0"
    var s_kx: [u8; 4] = " x=\0"
    var s_kw: [u8; 4] = " w=\0"
    var s_kv: [u8; 9] = " hidden=\0"
    var s_kf: [u8; 8] = " focus=\0"
    var s_kt: [u8; 4] = " t=\0"
    wlibc.set_band(0)
    wlibc.clip_set(0, 0, sw, PH)
    wlibc.rect(0, 0, sw, PH, wlibc.theme(wlibc.T_PANEL))
    wlibc.hline(0, 0, sw, wlibc.theme(wlibc.T_LINE))
    r_start = knopf(START_X, START_W, s_St, false,
        false)
    // die Felder rechts
    x_uhr = sw - LUECKE - UHR_W
    x_akku = x_uhr - LUECKE - AKKU_W
    x_netz = x_akku - LUECKE - NETZ_W
    r_netz = feld(x_netz, NETZ_W, (&netz[0 as usize]) as u64)
    r_akku = feld(x_akku, AKKU_W, (&akku[0 as usize]) as u64)
    r_uhr = feld(x_uhr, UHR_W, (&uhr[0 as usize]) as u64)
    // die Fensterknoepfe dazwischen
    var frei: u64 = 0
    if x_netz > TASK_X + LUECKE {
        frei = x_netz - TASK_X - LUECKE
    }
    var breite: u64 = TASK_MAX
    if nk > 0 {
        breite = (frei - (nk - 1) * LUECKE) / nk
        if breite > TASK_MAX {
            breite = TASK_MAX
        }
    }
    var i: u64 = 0
    while i < nk {
        let x: u64 = TASK_X + i * (breite + LUECKE)
        kx[(i) as usize] = x
        kw[(i) as usize] = breite
        if breite >= TASK_MIN {
            kuerzen(i, breite)
            let lab: u64 = (&klab[0 as usize]) as u64 + i * 40
            let rc: u64 = knopf(x, breite, lab, kfok[(i) as usize] != 0,
                kver[(i) as usize] != 0)
            if melden {
                say((&s_kk[0 as usize]) as u64)
                ulib.sayn(i)
                say((&s_ki[0 as usize]) as u64)
                ulib.sayn(kid[(i) as usize])
                say((&s_kx[0 as usize]) as u64)
                ulib.sayn(x)
                say((&s_kw[0 as usize]) as u64)
                ulib.sayn(breite)
                say((&s_kv[0 as usize]) as u64)
                ulib.sayn(kver[(i) as usize])
                say((&s_kf[0 as usize]) as u64)
                ulib.sayn(kfok[(i) as usize])
                say((&s_kt[0 as usize]) as u64)
                say(lab)
                ulib.nl()
                var bg: u64 = wlibc.theme(wlibc.T_BTN)
                var fg: u64 = wlibc.theme(wlibc.T_FG)
                if kfok[(i) as usize] != 0 {
                    bg = wlibc.theme(wlibc.T_SEL)
                    fg = wlibc.theme(wlibc.T_SELFG)
                } else if kver[(i) as usize] != 0 {
                    bg = wlibc.theme(wlibc.T_SCROLL)
                    fg = wlibc.theme(wlibc.T_DIM)
                }
                melde_text((&m_kn[0 as usize]) as u64, rc, bg, fg, lab)
            }
        } else {
            kw[(i) as usize] = 0
        }
        i = i + 1
    }
    let _n: u64 = wlibc.push(w_h, 0, 0, sw, PH)
    male = male + 1
    if melden {
        melde_text((&m_st[0 as usize]) as u64, r_start,
            wlibc.theme(wlibc.T_BTN), wlibc.theme(wlibc.T_FG),
            s_St)
        melde_text((&m_ne[0 as usize]) as u64, r_netz,
            wlibc.theme(wlibc.T_PANEL), wlibc.theme(wlibc.T_FG),
            (&netz[0 as usize]) as u64)
        melde_text((&m_ak[0 as usize]) as u64, r_akku,
            wlibc.theme(wlibc.T_PANEL), wlibc.theme(wlibc.T_FG),
            (&akku[0 as usize]) as u64)
        melde_text((&m_uh[0 as usize]) as u64, r_uhr,
            wlibc.theme(wlibc.T_PANEL), wlibc.theme(wlibc.T_FG),
            (&uhr[0 as usize]) as u64)
    }
}

fn klick(x: u64, y: u64) {
    var s_kl: [u8; 17] = "leiste: klick x=\0"
    var s_ky: [u8; 4] = " y=\0"
    var s_kz: [u8; 7] = " ziel=\0"
    var s_ta: [u8; 16] = "leiste: tat id=\0"
    var s_tw: [u8; 6] = " was=\0"
    var s_tr: [u8; 5] = " rc=\0"
    var s_sp: [u8; 21] = "leiste: starter pid=\0"
    var p_star: [u8; 13] = "/bin/starter\0"
    var z_start: [u8; 6] = "start\0"
    var z_task: [u8; 8] = "fenster\0"
    var z_leer: [u8; 7] = "nichts\0"
    klicks = klicks + 1
    say((&s_kl[0 as usize]) as u64)
    ulib.sayn(x)
    say((&s_ky[0 as usize]) as u64)
    ulib.sayn(y)
    if y < KY || y >= KY + KH {
        say((&s_kz[0 as usize]) as u64)
        say((&z_leer[0 as usize]) as u64)
        ulib.nl()
        return
    }
    if x >= START_X && x < START_X + START_W {
        say((&s_kz[0 as usize]) as u64)
        say((&z_start[0 as usize]) as u64)
        ulib.nl()
        let pid: u64 = ulib.sys(ulib.SYS_SPAWN,
            (&p_star[0 as usize]) as u64, 0, 0)
        say((&s_sp[0 as usize]) as u64)
        ulib.sayn(pid)
        ulib.nl()
        return
    }
    var i: u64 = 0
    while i < nk {
        if kw[(i) as usize] != 0 {
            if x >= kx[(i) as usize]
                && x < kx[(i) as usize] + kw[(i) as usize] {
                say((&s_kz[0 as usize]) as u64)
                say((&z_task[0 as usize]) as u64)
                ulib.nl()
                let rc: u64 = wlibc.win_act(kid[(i) as usize],
                    wlibc.WA_TOGGLE)
                taten = taten + 1
                say((&s_ta[0 as usize]) as u64)
                ulib.sayn(kid[(i) as usize])
                say((&s_tw[0 as usize]) as u64)
                ulib.sayn(wlibc.WA_TOGGLE)
                say((&s_tr[0 as usize]) as u64)
                ulib.sayn(rc)
                ulib.nl()
                let _a: bool = liste_holen()
                malen(false)
                return
            }
        }
        i = i + 1
    }
    say((&s_kz[0 as usize]) as u64)
    say((&z_leer[0 as usize]) as u64)
    ulib.nl()
}

fn u_start(args: u64) -> u64 {
    var s_bad: [u8; 22] = "leiste: keine Flaeche\0"
    var s_nol: [u8; 43] = "leiste: keine Ebene 2 -- nicht die Wurzel?\0"
    var s_rd: [u8; 17] = "leiste: ready w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_l: [u8; 8] = " layer=\0"
    var s_asc: [u8; 9] = " ascent=\0"
    var s_th: [u8; 11] = "/etc/theme\0"
    var s_st: [u8; 17] = "leiste: stand n=\0"
    var s_ma: [u8; 7] = " male=\0"
    var s_kk2: [u8; 9] = " klicks=\0"
    var s_tt: [u8; 8] = " taten=\0"
    var s_1: [u8; 7] = "einmal\0"

    var einmal: bool = false
    let argc: u64 = ulib.arg_count(args)
    var a: u64 = 1
    while a < argc {
        if ulib.streq(ulib.arg_at(args, a), (&s_1[0 as usize]) as u64) {
            einmal = true
        }
        a = a + 1
    }
    let _mk: u64 = msg.init()
    if !wlibc.start(false) {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    let _t0: u64 = wlibc.theme_load((&s_th[0 as usize]) as u64)
    sw = wlibc.screen_w()
    sh = wlibc.screen_h()
    py = sh - PH
    asc = wlibc.ascent_of(wlibc.F_UI, wlibc.PX_UI)
    let h: u64 = wlibc.sys5(wlibc.WM_CREATE, py, (sw << 16) | PH,
        msg.get((&k_title[0 as usize]) as u64), 0, 0)
    if ulib.bad(h) || h == 0 {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    w_h = h
    if ulib.bad(wlibc.win_state(h, wlibc.WS_DECO, 0)) {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    // GANZ NACH VORN. Ohne das ist die Leiste ein Fenster wie jedes
    // andere und verschwindet unter dem naechsten, das aufgeht.
    if ulib.bad(wlibc.win_state(h, wlibc.WS_LAYER, wlibc.L_TOP)) {
        say((&s_nol[0 as usize]) as u64)
        ulib.nl()
        let _c: u64 = wlibc.sys3w(wlibc.WM_CLOSE, h, 0, 0)
        return 1
    }
    say((&s_rd[0 as usize]) as u64)
    ulib.sayn(sw)
    say((&s_h[0 as usize]) as u64)
    ulib.sayn(PH)
    say((&s_y[0 as usize]) as u64)
    ulib.sayn(py)
    say((&s_l[0 as usize]) as u64)
    ulib.sayn(wlibc.sys3w(wlibc.WM_INFO, h, wlibc.WI_LAYER, 0))
    say((&s_asc[0 as usize]) as u64)
    ulib.sayn(asc)
    ulib.nl()
    let _u: bool = stand_holen()
    let _l: bool = liste_holen()
    malen(true)
    if einmal {
        return 0
    }
    var runde: u64 = 0
    var summe: u64 = wlibc.theme_sum()
    var sprache_neu: bool = false
    var lebt: bool = true
    while lebt {
        var n: u64 = 0
        while n < 32 && wlibc.sys3w(wlibc.WM_EVENT, h,
            (&ev[0 as usize]) as u64, 0) == 1 {
            let b: u64 = (&ev[0 as usize]) as u64
            let typ: u64 = __mmio_read64((b) as *mut u64)
            let d: u64 = __mmio_read64((b + 8) as *mut u64)
            if typ == wlibc.EV_DOWN {
                klick((d >> 32) & 0xFFFF, (d >> 16) & 0xFFFF)
            } else if typ == wlibc.EV_CLOSE {
                lebt = false
            }
            n = n + 1
        }
        runde = runde + 1
        // Die Fensterliste acht Mal in der Sekunde, die Uhr zweimal.
        var neu: bool = false
        if (runde % 5) == 0 {
            if liste_holen() {
                neu = true
            }
        }
        if (runde % 20) == 0 {
            if stand_holen() {
                neu = true
            }
            let ts: u64 = wlibc.theme_load((&s_th[0 as usize]) as u64)
            let _z: u64 = ts
            let ns: u64 = wlibc.theme_sum()
            if ns != summe {
                summe = ns
                neu = true
            }
            // RUNDE I18N: UND DIE SPRACHE, an derselben Stelle und aus
            // demselben Grund wie das Farbschema -- eine Taskleiste,
            // die fuer einen Sprachwechsel einen Neustart braucht, ist
            // keine. `msg.changed` liest die Wahl des Benutzers und
            // fuellt die Plaetze neu; die Zeiger bleiben gueltig, nur
            // ihr Inhalt ist neu. Danach muss `stand_holen` noch einmal
            // laufen, weil "kein Akku" in die Puffer KOPIERT wird.
            if msg.changed() {
                let _s2: bool = stand_holen()
                neu = true
                // UND EINMAL AUSFUEHRLICH MELDEN. `malen(false)` gibt
                // die Textfelder NICHT aus -- sonst stuende bei jedem
                // Uhrenschlag eine Zeile mehr im Mitschnitt. Beim
                // Sprachwechsel ist genau das aber die Messung: ein
                // Testlaeufer muss sehen koennen, dass DIESER Prozess
                // -- nicht der, der umgestellt hat -- jetzt eine andere
                // Sprache spricht.
                sprache_neu = true
            }
        }
        if neu {
            malen(sprache_neu)
            sprache_neu = false
            say((&s_st[0 as usize]) as u64)
            ulib.sayn(nk)
            say((&s_ma[0 as usize]) as u64)
            ulib.sayn(male)
            say((&s_kk2[0 as usize]) as u64)
            ulib.sayn(klicks)
            say((&s_tt[0 as usize]) as u64)
            ulib.sayn(taten)
            ulib.nl()
        }
        ulib.sleep_ms(25)
    }
    return 0
}
