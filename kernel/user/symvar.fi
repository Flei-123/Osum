// SPDX-License-Identifier: MIT
profile kernel

export { register, pick, joined_ok, SLOT_BYTES, MAIN_BYTES }

const MAIN_BYTES: u64 = 20748
const SMALL_SIZE: u64 = 44
const LARGE_SIZE: u64 = 64
const SMALL_BYTES: u64 = 7756
const LARGE_BYTES: u64 = 16396
const SLOT_BYTES: u64 = 44900
const MAX_SLOTS: u64 = 32

static mut slots: [u64; 32] = [0 as u64; 32]
static mut n_slots: u64 = 0

fn header_ok(p: u64, size: u64) -> bool {
    if __mmio_read8(p as *mut u8) != 79 as u8 || __mmio_read8((p + 1) as *mut u8) != 83 as u8 {
        return false
    }
    if __mmio_read8((p + 2) as *mut u8) != 89 as u8 || __mmio_read8((p + 3) as *mut u8) != 77 as u8 {
        return false
    }
    return __mmio_read32((p + 4) as *mut u32) as u64 == size && __mmio_read32((p + 8) as *mut u32) as u64 == size
}

fn registered(slot: u64) -> bool {
    var i: u64 = 0
    while i < n_slots {
        if slots[i as usize] == slot {
            return true
        }
        i = i + 1
    }
    return false
}

fn joined_ok(slot: u64, got: u64) -> bool {
    if got != SLOT_BYTES {
        return false
    }
    if !header_ok(slot, 72) || !header_ok(slot + MAIN_BYTES, SMALL_SIZE) {
        return false
    }
    return header_ok(slot + MAIN_BYTES + SMALL_BYTES, LARGE_SIZE)
}

fn register(slot: u64, got: u64) {
    if n_slots >= MAX_SLOTS || registered(slot) || !joined_ok(slot, got) {
        return
    }
    slots[n_slots as usize] = slot
    n_slots = n_slots + 1
}

fn bake_ok(word: u64, at: u64, size: u64) -> bool {
    return header_ok(word + at, size)
}

fn pick_size(tile: u64) -> u64 {
    if 44 % tile == 0 {
        return SMALL_SIZE
    }
    if 64 % tile == 0 {
        return LARGE_SIZE
    }
    if 72 % tile == 0 {
        return 72
    }
    if tile <= SMALL_SIZE {
        return SMALL_SIZE
    }
    if tile <= LARGE_SIZE {
        return LARGE_SIZE
    }
    return 72
}

fn pick(word: u64, tile: u64) -> u64 {
    if tile < 16 {
        return word
    }
    var i: u64 = 0
    while i < n_slots {
        if slots[i as usize] == word {
            let size: u64 = pick_size(tile)
            if size == SMALL_SIZE && bake_ok(word, MAIN_BYTES, SMALL_SIZE) {
                return word + MAIN_BYTES
            }
            if size == LARGE_SIZE && bake_ok(word, MAIN_BYTES + SMALL_BYTES, LARGE_SIZE) {
                return word + MAIN_BYTES + SMALL_BYTES
            }
            return word
        }
        i = i + 1
    }
    return word
}
