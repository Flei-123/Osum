// SPDX-License-Identifier: MIT
profile kernel

export { register, pick, SLOT_BYTES, MAIN_BYTES }

const MAIN_BYTES: u64 = 20748
const SMALL_SIZE: u64 = 44
const LARGE_SIZE: u64 = 64
const SMALL_BYTES: u64 = 7756
const LARGE_BYTES: u64 = 16396
const SLOT_BYTES: u64 = 44900
const MAX_SLOTS: u64 = 32

static mut slots: [u64; 32] = [0 as u64; 32]
static mut n_slots: u64 = 0

fn header_ok(p: u64, size: u64) -> bool {
    if __mmio_read8(p as *mut u8) != 79 as u8 || __mmio_read8((p + 1) as *mut u8) != 83 as u8 {
        return false
    }
    if __mmio_read8((p + 2) as *mut u8) != 89 as u8 || __mmio_read8((p + 3) as *mut u8) != 77 as u8 {
        return false
    }
    return __mmio_read32((p + 4) as *mut u32) as u64 == size && __mmio_read32((p + 8) as *mut u32) as u64 == size
}

fn register(slot: u64, got: u64) {
    if got != SLOT_BYTES || n_slots >= MAX_SLOTS {
        return
    }
    if !header_ok(slot, 72) || !header_ok(slot + MAIN_BYTES, SMALL_SIZE)
        || !header_ok(slot + MAIN_BYTES + SMALL_BYTES, LARGE_SIZE) {
        return
    }
    slots[n_slots as usize] = slot
    n_slots = n_slots + 1
}

fn pick(word: u64, tile: u64) -> u64 {
    if tile < 16 {
        return word
    }
    var i: u64 = 0
    while i < n_slots {
        if slots[i as usize] == word {
            if SMALL_SIZE % tile == 0 {
                return word + MAIN_BYTES
            }
            if LARGE_SIZE % tile == 0 {
                return word + MAIN_BYTES + SMALL_BYTES
            }
            return word
        }
        i = i + 1
    }
    return word
}
