// kernel/user/shat.fi -- round TRESOR: the measurement of `sha.fi`.
//
// A hash function that is only READ is not checked. This program hashes
// the three standard messages of FIPS 180-4 plus two that exercise the
// STREAMING path, and prints the hex. `tools/tresor/run.sh` puts the same
// five messages through Python's `hashlib` on the host and compares the
// lines character by character.
//
// The five, and what each one is for:
//
//   1  "abc"                       the classic vector, one short block
//   2  ""                          the empty message -- pure padding, and
//                                  the case that a naive implementation
//                                  gets wrong by hashing nothing at all
//   3  "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
//                                  56 octets: the length field no longer
//                                  fits in the first block, so this forces
//                                  the SECOND padding block. Off-by-one
//                                  country.
//   4  1000 x "a"                  many blocks through `update`
//   5  the same 1000 octets fed in SEVEN pieces of uneven length
//                                  -- must give the SAME hash as 4, which
//                                  is the whole promise of a stream.

profile kernel

import ulib
import sha

export { u_start }

static mut big: [u8; 1000] = [0 as u8; 1000]

fn show(label: u64, dig: u64) {
    var hex: [u8; 65] = [0 as u8; 65]
    sha.hex_out(dig, (&hex[0]) as u64)
    ulib.say(label)
    ulib.say((&hex[0]) as u64)
    ulib.nl()
}

fn u_start(args: u64) -> u64 {
    var m1: [u8; 4] = "abc\0"
    var m3: [u8; 57] = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq\0"
    var l1: [u8; 8] = "sha1: \0\0"
    var l2: [u8; 8] = "sha2: \0\0"
    var l3: [u8; 8] = "sha3: \0\0"
    var l4: [u8; 8] = "sha4: \0\0"
    var l5: [u8; 8] = "sha5: \0\0"
    var dig: [u8; 32] = [0 as u8; 32]

    sha.hash((&m1[0]) as u64, 3, (&dig[0]) as u64)
    show((&l1[0]) as u64, (&dig[0]) as u64)

    sha.hash((&m1[0]) as u64, 0, (&dig[0]) as u64)
    show((&l2[0]) as u64, (&dig[0]) as u64)

    sha.hash((&m3[0]) as u64, 56, (&dig[0]) as u64)
    show((&l3[0]) as u64, (&dig[0]) as u64)

    var i: u64 = 0
    while i < 1000 {
        big[i as usize] = 97 as u8
        i = i + 1
    }
    sha.hash((&big[0]) as u64, 1000, (&dig[0]) as u64)
    show((&l4[0]) as u64, (&dig[0]) as u64)

    // The same octets, but in seven helpings that do not line up with the
    // sixty-four octet block. If the buffering is wrong, this differs.
    var cuts: [u64; 7] = [1 as u64, 63 as u64, 64 as u64, 65 as u64,
        200 as u64, 300 as u64, 307 as u64]
    sha.begin()
    var at: u64 = 0
    var c: u64 = 0
    while c < 7 {
        sha.update((&big[0]) as u64 + at, cuts[c as usize])
        at = at + cuts[c as usize]
        c = c + 1
    }
    sha.finish((&dig[0]) as u64)
    show((&l5[0]) as u64, (&dig[0]) as u64)
    return 0
}
