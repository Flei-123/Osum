profile app

import actwire
import socbuf
import socstate

export { is_rep, ob_also }

fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

fn fld_eq(a: u64, b: u64, k: usize) -> bool {
    var an: usize = 0
    var bn: usize = 0
    let ap: u64 = socbuf.fld(a, k, &an)
    let bp: u64 = socbuf.fld(b, k, &bn)
    return an == bn && socbuf.r_eq(ap, bp, an)
}

fn handle_eq(a: u64, b: u64) -> bool {
    var an: usize = 0
    var bn: usize = 0
    let ap: u64 = socbuf.fld(a, 5, &an)
    let bp: u64 = socbuf.fld(b, 5, &bn)
    if an == 0 || an != bn {
        return false
    }
    var i: usize = 0
    while i < an {
        if lower(socbuf.r_ld8(ap, i)) != lower(socbuf.r_ld8(bp, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn same_person(a: u64, b: u64) -> bool {
    return a != b && !fld_eq(a, b, 0) && handle_eq(a, b)
}

fn fld_is(lp: u64, k: usize, s: str) -> bool {
    var n: usize = 0
    let p: u64 = socbuf.fld(lp, k, &n)
    return socbuf.is(p, n, s)
}

fn relation_rank(lp: u64) -> u64 {
    if fld_is(lp, 2, "friend") {
        return 4
    }
    if fld_is(lp, 2, "incoming") {
        return 3
    }
    if fld_is(lp, 2, "outgoing") {
        return 2
    }
    return 1
}

fn presence_rank(lp: u64) -> u64 {
    if fld_is(lp, 3, "online") || fld_is(lp, 3, "away") || fld_is(lp, 3, "dnd") {
        return 1
    }
    return 0
}

fn activity_rank(lp: u64) -> u64 {
    var n: usize = 0
    let _p: u64 = socbuf.fld(lp, 7, &n)
    if n > 0 {
        return 1
    }
    return 0
}

fn score(lp: u64) -> u64 {
    return relation_rank(lp) * 4 + activity_rank(lp) * 2 + presence_rank(lp)
}

fn beats(o: u64, lp: u64) -> bool {
    let so: u64 = score(o)
    let sl: u64 = score(lp)
    return so > sl || (so == sl && o < lp)
}

fn is_rep(lp: u64) -> bool {
    var at: usize = 0
    while at < socstate.book.len {
        let o: u64 = socstate.book.ptr + at as u64
        if same_person(lp, o) && beats(o, lp) {
            return false
        }
        at = at + socbuf.line_len(o) + 1
    }
    return true
}

fn ob_also(lp: u64) {
    var first: bool = true
    var at: usize = 0
    while at < socstate.book.len {
        let o: u64 = socstate.book.ptr + at as u64
        if same_person(lp, o) {
            if !first {
                actwire.ob_ch(44)
            }
            first = false
            var n: usize = 0
            let p0: u64 = socbuf.fld(o, 0, &n)
            actwire.ob_n(p0, n as u64)
            actwire.ob_ch(58)
            let p1: u64 = socbuf.fld(o, 1, &n)
            actwire.ob_n(p1, n as u64)
        }
        at = at + socbuf.line_len(o) + 1
    }
}
