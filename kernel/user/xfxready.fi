profile kernel

import ulib
import libc.io

export { log_mark, wayd_ready }

const READ_MAX: u64 = 4000

fn log_mark(log: u64) -> u64 {
    let size: u64 = io.size_of(log)
    if ulib.bad(size) {
        return 0
    }
    return size
}

fn wayd_ready(log: u64, mark: u64) -> bool {
    var needle: [u8; 16] = "wayd: ready on \0"
    var buf: [u8; 4096] = [0 as u8; 4096]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, log, 0, 0)
    if ulib.bad(fd) {
        return false
    }
    ulib.sys(ulib.SYS_SEEK, fd, mark, 0)
    var got: u64 = ulib.sys(ulib.SYS_READ, fd, (&buf[0 as usize]) as u64, READ_MAX)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(got) || got == 0 {
        return false
    }
    buf[got as usize] = 0 as u8
    return ulib.find((&buf[0 as usize]) as u64, (&needle[0 as usize]) as u64) != ulib.EOF
}
