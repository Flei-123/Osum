// SPDX-License-Identifier: GPL-2.0-only

profile kernel

export { q_put, q_count, q_next, q_msg, q_id, q_seq, q_drop }

const Q_SLOTS: usize = 6
const Q_W: usize = 2048

static mut q_buf: [u8; 12288] = [0 as u8; 12288]
static mut q_ids: [u64; 6] = [0 as u64; 6]
static mut q_seqs: [u64; 6] = [0 as u64; 6]
static mut q_used: [u8; 6] = [0 as u8; 6]
static mut q_clock: u64 = 0

fn q_slot(k: usize) -> u64 {
    return (&q_buf[0]) as u64 + (k * Q_W) as u64
}

fn q_put(msg: u64, id: u64) -> bool {
    var k: usize = 0
    while k < Q_SLOTS {
        if q_used[k] == 0 as u8 {
            let dst: u64 = q_slot(k)
            var n: usize = 0
            while n < Q_W - 1 && *((msg + n as u64) as *mut u8) != 0 as u8 {
                *((dst + n as u64) as *mut u8) = *((msg + n as u64) as *mut u8)
                n = n + 1
            }
            *((dst + n as u64) as *mut u8) = 0 as u8
            q_ids[k] = id
            q_clock = q_clock + 1
            q_seqs[k] = q_clock
            q_used[k] = 1 as u8
            return true
        }
        k = k + 1
    }
    return false
}

fn q_count() -> usize {
    var n: usize = 0
    var k: usize = 0
    while k < Q_SLOTS {
        if q_used[k] != 0 as u8 {
            n = n + 1
        }
        k = k + 1
    }
    return n
}

fn q_next(after: u64) -> i64 {
    var best: i64 = -1
    var k: usize = 0
    while k < Q_SLOTS {
        if q_used[k] != 0 as u8 && q_seqs[k] > after {
            if best < 0 || q_seqs[k] < q_seqs[best as usize] {
                best = k as i64
            }
        }
        k = k + 1
    }
    return best
}

fn q_msg(k: usize) -> u64 {
    return q_slot(k)
}

fn q_id(k: usize) -> u64 {
    return q_ids[k]
}

fn q_seq(k: usize) -> u64 {
    return q_seqs[k]
}

fn q_drop(k: usize) {
    q_used[k] = 0 as u8
}
