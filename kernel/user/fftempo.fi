//     tempo: ms = <zahl>
//     tempo: oktette = <zahl>

profile kernel

import ulib

export { u_start }

const SYS_READ: u64 = 0
const SYS_OPEN: u64 = 2
const SYS_CLOSE: u64 = 3
const SYS_CLOCK_GETTIME: u64 = 228
const CLOCK_MONOTONIC: u64 = 1
const O_RDONLY: u64 = 0

static mut BUFFER: [u8; 4096] = [0 as u8; 4096]

fn now_ms() -> u64 {
    var ts: [u8; 16] = [0 as u8; 16]
    let r: u64 = ulib.sys(SYS_CLOCK_GETTIME, CLOCK_MONOTONIC,
        (&ts[0 as usize]) as u64, 0)
    if ulib.bad(r) {
        return 0
    }
    let s: u64 = __mmio_read64(((&ts[0 as usize]) as u64) as *mut u64)
    let ns: u64 = __mmio_read64((((&ts[0 as usize]) as u64) + 8) as *mut u64)
    return s * 1000 + ns / 1000000
}

fn line(name: u64, v: u64) {
    var s_pre: [u8; 8] = "tempo: \0"
    var s_eq: [u8; 4] = " = \0"
    ulib.say((&s_pre[0 as usize]) as u64)
    ulib.say(name)
    ulib.say((&s_eq[0 as usize]) as u64)
    ulib.sayn(v)
    ulib.nl()
}

fn u_start(args: u64) -> u64 {
    var n_ms: [u8; 3] = "ms\0"
    var n_okt: [u8; 8] = "oktette\0"
    var s_use: [u8; 24] = "usage: fftempo PATH\0\0\0\0\0"

    if ulib.arg_count(args) < 2 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    let file_path: u64 = ulib.arg_at(args, 1)
    let fd: u64 = ulib.sys(SYS_OPEN, file_path, O_RDONLY, 0)
    if ulib.bad(fd) {
        line((&n_ms[0 as usize]) as u64, 0)
        line((&n_okt[0 as usize]) as u64, 0)
        return 1
    }

    let t0: u64 = now_ms()
    var gesamt: u64 = 0
    var next: bool = true
    while next {
        let got: u64 = ulib.sys(SYS_READ, fd,
            (&BUFFER[0 as usize]) as u64, 4096)
        if ulib.bad(got) || got == 0 {
            next = false
        } else {
            gesamt = gesamt + got
        }
    }
    let t1: u64 = now_ms()
    ulib.sys(SYS_CLOSE, fd, 0, 0)

    line((&n_ms[0 as usize]) as u64, t1 - t0)
    line((&n_okt[0 as usize]) as u64, gesamt)
    return 0
}
