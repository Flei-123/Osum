const NG_READY: u64 = 0

const NG_MASK: u64 = 2

const NG_MAC0: u64 = 4

const NG_MAC1: u64 = 5

const NG_STATE: u64 = 8

static mut l_ip: [u8; 64] = [0 as u8; 64]

static mut l_maske: [u8; 64] = [0 as u8; 64]

static mut l_gw: [u8; 64] = [0 as u8; 64]

static mut l_mac: [u8; 64] = [0 as u8; 64]

static mut l_nzust: [u8; 96] = [0 as u8; 96]

static mut k_n_h1: [u8; 22] = "settings.net.heading\0\0"

static mut k_n_verb: [u8; 24] = "settings.net.connected\0\0"

static mut k_n_getr: [u8; 27] = "settings.net.disconnected\0\0"

static mut k_n_noip: [u8; 21] = "settings.net.noaddr\0\0"

static mut k_n_noweg: [u8; 22] = "settings.net.noroute\0\0"

const HALF: u64 = 340

static mut k_t_tabs: [u8; 14] = "settings.tabs\0"

static mut k_t_tabs2: [u8; 15] = "settings.tabs2\0"

static mut k_t_tabs3: [u8; 15] = "settings.tabs3\0"

static mut k_z_stufen: [u8; 21] = "settings.zieh.stufen\0"

static mut k_c_bez: [u8; 25] = "settings.address.choices\0"

static mut k_l_ip2: [u8; 24] = "settings.address.fields\0"

static mut k_c_tb: [u8; 30] = "settings.taskbar.edge.choices\0"

static mut k_c_tbal: [u8; 31] = "settings.taskbar.align.choices\0"

static mut k_c_trn: [u8; 24] = "settings.transp.choices\0"

fn two_on(p: u64, at: u64, v: u64) -> u64 {
    __mmio_write8((p + at) as *mut u8, (48 + ((v / 10) % 10)) as u8)
    __mmio_write8((p + at + 1) as *mut u8, (48 + (v % 10)) as u8)
    __mmio_write8((p + at + 2) as *mut u8, 0 as u8)
    return at + 2
}

fn state_row() {
    let d: u64 = (&l_nzust[0 as usize]) as u64
    let st: u64 = ulib.sys(setbase.SYS_NETGET, NG_STATE, 0, 0)
    var a: u64 = setcore.text_an(d, 0, msg.get((&k_n_h1[0 as usize]) as u64))
    if ulib.bad(st) || st == 0 {
        let _e: u64 = setcore.text_an(d, a, msg.get((&k_n_getr[0 as usize]) as u64))
        return
    }
    if st == 1 {
        let _e: u64 = setcore.text_an(d, a, msg.get((&k_n_noip[0 as usize]) as u64))
        return
    }
    if st == 2 {
        let _e: u64 = setcore.text_an(d, a, msg.get((&k_n_noweg[0 as usize]) as u64))
        return
    }
    let _e: u64 = setcore.text_an(d, a, msg.get((&k_n_verb[0 as usize]) as u64))
}

fn net_live_build() {
    state_row()
    setcore.rate_line()
    setcore.throughput_lines()
    setcore.ping_line()
    setaccount.prog_board()
    setcore.conn_board()
}

fn dns_live_fill() {
    let _n: u64 = dns.conf_load()
    let d: u64 = dns.conf_at(0)
    setbase.e_dns[0 as usize] = 0 as u8
    if d != 0 {
        let _e4: u64 = setcore.ip_an((&setbase.e_dns[0 as usize]) as u64, 0, d)
    }
    var line: [u8; 64] = [0 as u8; 64]
    var k_live: [u8; 20] = "settings: live dns=\0"
    let a: u64 = setcore.text_an((&line[0 as usize]) as u64, 0, (&k_live[0 as usize]) as u64)
    let _t: u64 = setcore.text_an((&line[0 as usize]) as u64, a, (&setbase.e_dns[0 as usize]) as u64)
    setcore.say((&line[0 as usize]) as u64)
    setcore.nl()
}

fn state_read() {
    var k_t_akt: [u8; 26] = "settings.label.resolution\0"
    var t_mal: [u8; 4] = " x \0"
    var k_t_dat: [u8; 21] = "settings.label.clock\0"
    var t_pkt: [u8; 2] = ".\0"
    var t_dp: [u8; 2] = ":\0"
    var k_t_ip: [u8; 23] = "settings.label.address\0"
    var k_t_mk: [u8; 20] = "settings.label.mask\0"
    var k_t_gw: [u8; 23] = "settings.label.gateway\0"
    var k_t_mac: [u8; 24] = "settings.label.hardware\0"
    var k_t_kn: [u8; 21] = "settings.label.nonet\0"
    var k_t_wer: [u8; 24] = "settings.label.loggedin\0"
    var k_t_uid: [u8; 19] = "settings.label.uid\0"
    var t_dd: [u8; 2] = "-\0"
    var a: u64 = setcore.text_an((&setbase.l_screen[0 as usize]) as u64, 0,
        msg.get((&k_t_akt[0 as usize]) as u64))
    a = setcore.num_at((&setbase.l_screen[0 as usize]) as u64, a, wlibc.screen_w())
    a = setcore.text_an((&setbase.l_screen[0 as usize]) as u64, a,
        (&t_mal[0 as usize]) as u64)
    a = setcore.num_at((&setbase.l_screen[0 as usize]) as u64, a, wlibc.screen_h())
    setcore.modes_read()
    setcore.map_read()
    let _f: bool = setcore.deadline_read()

    let d: u64 = (&setbase.l_datum[0 as usize]) as u64
    a = setcore.text_an(d, 0, msg.get((&k_t_dat[0 as usize]) as u64))
    a = setcore.num_at(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_YEAR, 0, 0))
    a = setcore.text_an(d, a, (&t_dd[0 as usize]) as u64)
    a = two_on(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_MONTH, 0, 0))
    a = setcore.text_an(d, a, (&t_dd[0 as usize]) as u64)
    a = two_on(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_DAY, 0, 0))
    a = setcore.text_an(d, a, (&t_mal[0 as usize]) as u64)
    a = two_on(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_HOUR, 0, 0))
    a = setcore.text_an(d, a, (&t_dp[0 as usize]) as u64)
    a = two_on(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_MIN, 0, 0))

    let rd: u64 = ulib.sys(setbase.SYS_NETGET, NG_READY, 0, 0)
    let ip: u64 = (&l_ip[0 as usize]) as u64
    let mk: u64 = (&l_maske[0 as usize]) as u64
    let gw: u64 = (&l_gw[0 as usize]) as u64
    let mc: u64 = (&l_mac[0 as usize]) as u64
    if ulib.bad(rd) || rd == 0 {
        a = setcore.text_an(ip, 0, msg.get((&k_t_ip[0 as usize]) as u64))
        let _z: u64 = setcore.text_an(ip, a, msg.get((&k_t_kn[0 as usize]) as u64))
        a = setcore.text_an(mk, 0, msg.get((&k_t_mk[0 as usize]) as u64))
        let _y: u64 = setcore.text_an(mk, a, msg.get((&k_t_kn[0 as usize]) as u64))
        a = setcore.text_an(gw, 0, msg.get((&k_t_gw[0 as usize]) as u64))
        let _x: u64 = setcore.text_an(gw, a, msg.get((&k_t_kn[0 as usize]) as u64))
        a = setcore.text_an(mc, 0, msg.get((&k_t_mac[0 as usize]) as u64))
        let _w2: u64 = setcore.text_an(mc, a, msg.get((&k_t_kn[0 as usize]) as u64))
    } else {
        let v: u64 = ulib.sys(setbase.SYS_NETGET, setbase.NG_IP, 0, 0)
        let m: u64 = ulib.sys(setbase.SYS_NETGET, NG_MASK, 0, 0)
        let g: u64 = ulib.sys(setbase.SYS_NETGET, setbase.NG_GW, 0, 0)
        a = setcore.text_an(ip, 0, msg.get((&k_t_ip[0 as usize]) as u64))
        let _z: u64 = setcore.ip_an(ip, a, v)
        a = setcore.text_an(mk, 0, msg.get((&k_t_mk[0 as usize]) as u64))
        let _y: u64 = setcore.ip_an(mk, a, m)
        a = setcore.text_an(gw, 0, msg.get((&k_t_gw[0 as usize]) as u64))
        let _x: u64 = setcore.ip_an(gw, a, g)
        let m0: u64 = ulib.sys(setbase.SYS_NETGET, NG_MAC0, 0, 0)
        let m1: u64 = ulib.sys(setbase.SYS_NETGET, NG_MAC1, 0, 0)
        a = setcore.text_an(mc, 0, msg.get((&k_t_mac[0 as usize]) as u64))
        a = setcore.num_at(mc, a, (m0 >> 24) & 255)
        a = setcore.text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = setcore.num_at(mc, a, (m0 >> 16) & 255)
        a = setcore.text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = setcore.num_at(mc, a, (m0 >> 8) & 255)
        a = setcore.text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = setcore.num_at(mc, a, m0 & 255)
        a = setcore.text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = setcore.num_at(mc, a, (m1 >> 8) & 255)
        a = setcore.text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = setcore.num_at(mc, a, m1 & 255)
        let _e1: u64 = setcore.ip_an((&setbase.e_ip[0 as usize]) as u64, 0, v)
        let _e2: u64 = setcore.ip_an((&setbase.e_maske[0 as usize]) as u64, 0, m)
        let _e3: u64 = setcore.ip_an((&setbase.e_gw[0 as usize]) as u64, 0, g)
        dns_live_fill()
    }

    let uid: u64 = pw.session_uid()
    if !pw.name_of_uid(uid, (&setbase.name[0 as usize]) as u64, 64) {
        setbase.name[(0) as usize] = 63 as u8
        setbase.name[(1) as usize] = 0 as u8
    }
    a = setcore.text_an((&setbase.l_wer[0 as usize]) as u64, 0, msg.get((&k_t_wer[0 as usize]) as u64))
    a = setcore.text_an((&setbase.l_wer[0 as usize]) as u64, a, (&setbase.name[0 as usize]) as u64)
    a = setcore.text_an((&setbase.l_wer[0 as usize]) as u64, a, msg.get((&k_t_uid[0 as usize]) as u64))
    let _u: u64 = setcore.num_at((&setbase.l_wer[0 as usize]) as u64, a, uid)
    setcore.say((&sw_a[0 as usize]) as u64)
    setcore.sayn(uid)
    setcore.say((&sw_b[0 as usize]) as u64)
    setcore.say((&setbase.name[0 as usize]) as u64)
    setcore.nl()
}

static mut sw_a: [u8; 19] = "settings: who uid=\0"

static mut sw_b: [u8; 7] = " name=\0"

fn show_tab(r: u64) {
    if r != setbase.active_tab {
        fuiscene.pane_top(0)
    }
    setbase.active_tab = r
    setroute.note_page(r)
    if r >= setbase.R_ANZ {
        pkg_enter(r - setbase.R_ANZ)
    }
    fuiscene.refresh()
    setbase.rep_due = 1
}

static mut k_sy_head: [u8; 18] = "settings.bus.head\0"

static mut k_sy_ok: [u8; 16] = "settings.bus.ok\0"

static mut k_sy_ask: [u8; 17] = "settings.bus.ask\0"

static mut k_sy_usedlg: [u8; 11] = "use_dialog\0"

static mut k_sy_undone: [u8; 20] = "settings.bus.undone\0"

static mut k_sy_harm: [u8; 22] = "settings.bus.harmless\0"

static mut k_sy_crit: [u8; 22] = "settings.bus.critical\0"

static mut sy_keys: [u8; 1024] = [0 as u8; 1024]

static mut sy_rows: u64 = 0

static mut sy_pkey: [u8; 40] = [0 as u8; 40]

static mut sy_areas: [u8; 54] = "display sound lock locale net update security privacy\0"

fn sys_area(area: u64, at0: u64) -> u64 {
    let bp: u64 = (&setbase.b_sys[0 as usize]) as u64
    var at: u64 = at0
    var v_list: [u8; 19] = "call settings.list\0"
    var k_area: [u8; 5] = "area\0"
    actcli.req((&v_list[0 as usize]) as u64)
    actcli.arg((&k_area[0 as usize]) as u64, area)
    if actcli.send(300) != actcli.R_OK {
        return at
    }
    let rp: u64 = actcli.reply()

    var ln: [u8; 240] = [0 as u8; 240]
    let lp: u64 = (&ln[0 as usize]) as u64
    var k: u64 = 2
    while actcli.line(k, lp, 240) {
        let kp: u64 = (&sy_keys[0 as usize]) as u64 + sy_rows * 32

        var e: u64 = 0
        while regio.read8_at(lp, e) != 0 && regio.read8_at(lp, e) != 61 {
            e = e + 1
        }
        if sy_rows < 32 {
            let _kk: u64 = setaccount.bx_putn(kp, 0, 32, lp, e)
            at = setaccount.bx_putn(bp, at, 4096, lp, e)
            at = setaccount.bx_ch(bp, at, 4096, 9)
            if regio.read8_at(lp, e) == 61 {
                at = setaccount.bx_put(bp, at, 4096, lp + e + 1)
            }
            at = setaccount.bx_ch(bp, at, 4096, 9)

            var ty: [u8; 240] = [0 as u8; 240]
            let tp: u64 = (&ty[0 as usize]) as u64
            if actcli.line(k + 1, tp, 240) {
                var s: u64 = 0
                var j: u64 = 0
                while regio.read8_at(tp, j) != 0 {
                    if regio.read8_at(tp, j) == 32 {
                        s = j + 1
                    }
                    j = j + 1
                }

                if regio.read8_at(tp, s) == 99 {
                    at = setaccount.bx_put(bp, at, 4096,
                        msg.get((&k_sy_crit[0 as usize]) as u64))
                } else if regio.read8_at(tp, s) == 104 {
                    at = setaccount.bx_put(bp, at, 4096,
                        msg.get((&k_sy_harm[0 as usize]) as u64))
                } else {
                    at = setaccount.bx_put(bp, at, 4096, tp + s)
                }
            }
            at = setaccount.bx_ch(bp, at, 4096, 9)
            var tx: [u8; 240] = [0 as u8; 240]
            let xp: u64 = (&tx[0 as usize]) as u64
            if actcli.line(k + 2, xp, 240) {
                var q: u64 = 0
                while regio.read8_at(xp, q) != 0 && regio.read8_at(xp, q) != 61 {
                    q = q + 1
                }
                if regio.read8_at(xp, q) == 61 {

                    var ck: [u8; 64] = [0 as u8; 64]
                    let cp: u64 = (&ck[0 as usize]) as u64
                    var s_pre: [u8; 14] = "settings.key.\0"
                    var o: u64 = setaccount.bx_put(cp, 0, 64, (&s_pre[0 as usize]) as u64)

                    var e: u64 = 0
                    if q > 5 {
                        e = q - 5
                    }
                    let _o2: u64 = setaccount.bx_putn(cp + o, 0, 64 - o, xp, e)
                    let tr: u64 = msg.get(cp)
                    if tr != cp {
                        at = setaccount.bx_put(bp, at, 4096, tr)
                    } else {
                        at = setaccount.bx_put(bp, at, 4096, xp + q + 1)
                    }
                }
            }
            at = setaccount.bx_ch(bp, at, 4096, 10)
            sy_rows = sy_rows + 1
        }
        k = k + 3
    }
    return at
}

fn sys_load() {
    let bp: u64 = (&setbase.b_sys[0 as usize]) as u64
    var at: u64 = setaccount.bx_put(bp, 0, 4096, msg.get((&k_sy_head[0 as usize]) as u64))
    at = setaccount.bx_ch(bp, at, 4096, 10)
    sy_rows = 0
    if !actcli.open() {
        at = setaccount.bx_put(bp, at, 4096, msg.get((&setbase.k_sy_nobus[0 as usize]) as u64))
        at = setaccount.bx_ch(bp, at, 4096, 10)
    } else {
        let ap: u64 = (&sy_areas[0 as usize]) as u64
        var w0: u64 = 0
        var i: u64 = 0
        var wd: [u8; 24] = [0 as u8; 24]
        let wp: u64 = (&wd[0 as usize]) as u64
        while true {
            let c: u64 = regio.read8_at(ap, i)
            if c == 32 || c == 0 {
                let _w: u64 = setaccount.bx_putn(wp, 0, 24, ap + w0, i - w0)
                at = sys_area(wp, at)
                w0 = i + 1
            }
            if c == 0 {
                break
            }
            i = i + 1
        }
        if sy_rows == 0 {
            at = setaccount.bx_put(bp, at, 4096, msg.get((&setbase.k_sy_nobus[0 as usize]) as u64))
            at = setaccount.bx_ch(bp, at, 4096, 10)
        }
    }
    var s1: [u8; 32] = "settings: bus page=system rows=\0"
    setcore.say((&s1[0 as usize]) as u64)
    setcore.sayn(sy_rows)
    setcore.nl()
}

fn sys_key(out: u64) -> bool {
    if sy_rows == 0 {
        return false
    }

    let r: u64 = fuiscene.table_sel(setbase.sy_tab)
    if r >= sy_rows {
        return false
    }
    let _o: u64 = setaccount.bx_put(out, 0, 32, (&sy_keys[0 as usize]) as u64 + r * 32)
    return true
}

fn sys_answer(rc: u64, key: u64) {
    let sp: u64 = (&setbase.l_systat[0 as usize]) as u64
    var ln: [u8; 160] = [0 as u8; 160]
    let lp: u64 = (&ln[0 as usize]) as u64
    let _l: bool = actcli.line(0, lp, 160)
    if rc == actcli.R_OK {
        setaccount.stat_set(sp, (&k_sy_ok[0 as usize]) as u64, key)
    } else if rc == actcli.R_CONFIRM {

        var j: u64 = 8
        var no: u64 = 0
        while regio.read8_at(lp, j) >= 48 && regio.read8_at(lp, j) <= 57 {
            no = no * 10 + regio.read8_at(lp, j) - 48
            j = j + 1
        }
        setbase.sy_pend = no
        let _pk: u64 = setaccount.bx_put((&sy_pkey[0 as usize]) as u64, 0, 40, key)
        setaccount.stat_set(sp, (&k_sy_ask[0 as usize]) as u64, key)
    } else if rc == actcli.R_NOBUS {
        setaccount.stat_set(sp, (&setbase.k_sy_nobus[0 as usize]) as u64, 0)
    } else if ulib.find(lp, (&k_sy_usedlg[0 as usize]) as u64) != 0xFFFFFFFFFFFFFFFF {

        setaccount.stat_set(sp, (&k_sy_ask[0 as usize]) as u64, key)
    } else {
        setaccount.stat_set(sp, (&setbase.k_sy_err[0 as usize]) as u64, lp)
    }
    var s1: [u8; 25] = "settings: bus answer rc=\0"
    var s2: [u8; 8] = " line=[\0"
    var s3: [u8; 2] = "]\0"
    setcore.say((&s1[0 as usize]) as u64)
    setcore.sayn(rc)
    setcore.say((&s2[0 as usize]) as u64)
    setcore.say(lp)
    setcore.say((&s3[0 as usize]) as u64)
    setcore.nl()
}

fn sys_set() {
    var key: [u8; 32] = [0 as u8; 32]
    let kp: u64 = (&key[0 as usize]) as u64
    if !sys_key(kp) {
        setaccount.stat_set((&setbase.l_systat[0 as usize]) as u64, (&setbase.k_sy_pick[0 as usize]) as u64, 0)
        return
    }
    var v_set: [u8; 18] = "call settings.set\0"
    var k_key: [u8; 4] = "key\0"
    var k_val: [u8; 6] = "value\0"
    actcli.req((&v_set[0 as usize]) as u64)
    actcli.arg((&k_key[0 as usize]) as u64, kp)
    actcli.arg((&k_val[0 as usize]) as u64, (&setbase.e_sval[0 as usize]) as u64)
    setbase.sy_pend = 0
    let rc: u64 = actcli.send(300)
    sys_answer(rc, kp)
}

fn net_fixed_bus(ip: u64, mask: u64, gw: u64, dns: u64) -> u64 {
    var v_fix: [u8; 24] = "call settings.net.fixed\0"
    var k_ip: [u8; 3] = "ip\0"
    var k_mask: [u8; 5] = "mask\0"
    var k_gw: [u8; 3] = "gw\0"
    var k_dns: [u8; 4] = "dns\0"
    var k_nf: [u8; 10] = "net.fixed\0"
    if !actcli.open() {
        return actcli.R_NOBUS
    }
    actcli.req((&v_fix[0 as usize]) as u64)
    actcli.arg((&k_ip[0 as usize]) as u64, ip)
    actcli.arg((&k_mask[0 as usize]) as u64, mask)
    if regio.read8_at(gw, 0) != 0 {
        actcli.arg((&k_gw[0 as usize]) as u64, gw)
    }
    if regio.read8_at(dns, 0) != 0 {
        actcli.arg((&k_dns[0 as usize]) as u64, dns)
    }
    setbase.sy_pend = 0
    let rc: u64 = actcli.send(300)
    var s1: [u8; 32] = "settings: page net fixed asked\n\0"
    setcore.say((&s1[0 as usize]) as u64)
    sys_answer(rc, (&k_nf[0 as usize]) as u64)
    return rc
}

fn sys_confirm() {
    if setbase.sy_pend == 0 {
        setaccount.stat_set((&setbase.l_systat[0 as usize]) as u64, (&setbase.k_sy_pick[0 as usize]) as u64, 0)
        return
    }
    var cf: [u8; 32] = [0 as u8; 32]
    let cp: u64 = (&cf[0 as usize]) as u64
    var s_c: [u8; 9] = "confirm \0"
    var o: u64 = setaccount.bx_put(cp, 0, 32, (&s_c[0 as usize]) as u64)
    o = setaccount.bx_num(cp, o, 32, setbase.sy_pend)
    actcli.req(cp)
    setbase.sy_pend = 0
    let rc: u64 = actcli.send(300)
    sys_answer(rc, (&sy_pkey[0 as usize]) as u64)
}

fn sys_undo() {
    var s_u: [u8; 5] = "undo\0"
    actcli.req((&s_u[0 as usize]) as u64)
    let rc: u64 = actcli.send(300)
    if rc == actcli.R_OK {
        setaccount.stat_set((&setbase.l_systat[0 as usize]) as u64, (&k_sy_undone[0 as usize]) as u64, 0)
        var s1: [u8; 38] = "settings: bus answer rc=0 line=[undo]\0"
        setcore.say((&s1[0 as usize]) as u64)
        setcore.nl()
    } else {
        var s_k: [u8; 1] = "\0"
        sys_answer(rc, (&s_k[0 as usize]) as u64)
    }
}

const K_TILE0: u64 = 170

const MAN_ACCOUNTS: str = __include_str("../settings.d/builtin.settings")

static mut man_state: u64 = 0

fn man_ready() -> bool {
    if man_state == 0 {
        let m: str = MAN_ACCOUNTS
        let n: u64 = manifest.load(m.p as u64, m.n as u64)
        if n == manifest.ERR {
            man_state = 2
        } else {
            man_state = 1
        }
    }
    return man_state == 1
}

const NET_NAMES: str = __include_str("../settings.d/network.bind")

const DSP_NAMES: str = __include_str("../settings.d/display.bind")

const PER_NAMES: str = __include_str("../settings.d/personal.bind")

const SYS_NAMES: str = __include_str("../settings.d/system.bind")

const TL_NAMES: str = __include_str("../settings.d/tools.bind")

fn man_bind(w: u64, key: u64) -> u64 {
    if w == 0 {
        return setdevice.acct_bind(key)
    }
    var m: str = NET_NAMES
    if w == 2 {
        m = DSP_NAMES
    }
    if w == 3 {
        m = PER_NAMES
    }
    if w == 4 {
        m = SYS_NAMES
    }
    if w == 5 {
        m = TL_NAMES
    }
    let ix: u64 = manifest.names_index(m.p as u64, m.n as u64, key)
    if ix == manifest.NONE {
        return setbase.AB_NONE
    }
    return ix
}

fn net_id(ix: u64) -> u64 {
    if ix == 10 { return setbase.K_CN }
    if ix == 12 { return setbase.K_EN1 }
    if ix == 13 { return setbase.K_EN2 }
    if ix == 14 { return setbase.K_EN3 }
    if ix == 19 { return setbase.K_EN4 }
    if ix == 15 { return setbase.K_B4 }
    if ix == 16 { return setbase.K_B4J }
    return 0
}

fn net_buf(ix: u64) -> u64 {
    if ix == 0 { return (&l_nzust[0 as usize]) as u64 }
    if ix == 1 { return (&setbase.l_nrate[0 as usize]) as u64 }
    if ix == 2 { return (&setbase.l_nrunter[0 as usize]) as u64 }
    if ix == 3 { return (&setbase.l_nrauf[0 as usize]) as u64 }
    if ix == 4 { return (&setbase.l_nsumme[0 as usize]) as u64 }
    if ix == 5 { return (&setbase.l_nping[0 as usize]) as u64 }
    if ix == 6 { return (&l_ip[0 as usize]) as u64 }
    if ix == 7 { return (&l_maske[0 as usize]) as u64 }
    if ix == 8 { return (&l_gw[0 as usize]) as u64 }
    if ix == 9 { return (&l_mac[0 as usize]) as u64 }
    if ix == 10 { return msg.get((&k_c_bez[0 as usize]) as u64) }
    if ix == 11 { return msg.get((&k_l_ip2[0 as usize]) as u64) }
    if ix == 12 { return (&setbase.e_ip[0 as usize]) as u64 }
    if ix == 13 { return (&setbase.e_maske[0 as usize]) as u64 }
    if ix == 14 { return (&setbase.e_gw[0 as usize]) as u64 }
    if ix == 19 { return (&setbase.e_dns[0 as usize]) as u64 }
    return 0
}

fn sys_id(ix: u64) -> u64 {
    if ix == 0 { return setbase.K_CE }
    if ix == 1 { return setbase.K_ET }
    if ix == 2 { return setbase.K_KA }
    if ix == 3 { return setbase.K_KO }
    if ix == 4 { return setbase.K_CAL }
    if ix == 6 { return setbase.K_TRN }
    if ix == 7 { return setbase.K_SL_TBA }
    if ix == 8 { return setbase.K_SL_BLUR }
    if ix == 9 { return setbase.K_ZS1 }
    if ix == 10 { return setbase.K_ZS2 }
    if ix == 11 { return setbase.K_ZS3 }
    if ix == 12 { return setbase.K_BS1 }
    if ix == 13 { return setbase.K_BS2 }
    if ix == 14 { return setbase.K_KSH }
    if ix == 15 { return setbase.K_SL_RAD }
    if ix == 16 { return setbase.K_SL_WA }
    if ix == 18 { return setbase.K_URF }
    if ix == 19 { return setbase.K_PR_TAB }
    if ix == 20 { return setbase.K_PR_BREF }
    if ix == 25 { return setbase.K_UP_BCHK }
    if ix == 26 { return setbase.K_UP_BINST }
    if ix == 27 { return setbase.K_UP_BCHAN }
    if ix == 28 { return setbase.K_UP_BAUTO }
    if ix == 29 { return setbase.K_UP_BRB }
    if ix == 30 { return setbase.K_UP_BCONF }
    if ix == 35 { return setbase.K_SU_BCHK }
    if ix == 36 { return setbase.K_SU_BINST }
    if ix == 38 { return setbase.K_BV1 }
    if ix == 39 { return setbase.K_EVN }
    if ix == 40 { return setbase.K_BV2 }
    if ix == 41 { return setbase.K_VSEL }
    if ix == 42 { return K_TILE0 }
    return 0
}

fn sys_buf(ix: u64) -> u64 {
    if ix == 0 { return msg.get((&k_c_tb[0 as usize]) as u64) }
    if ix == 1 { return (&setbase.e_tbs[0 as usize]) as u64 }
    if ix == 4 { return msg.get((&k_c_tbal[0 as usize]) as u64) }
    if ix == 5 { return (&setbase.l_warn[0 as usize]) as u64 }
    if ix == 6 { return msg.get((&k_c_trn[0 as usize]) as u64) }
    if ix == 7 { return (&setbase.tba_lbl[0 as usize]) as u64 }
    if ix >= 9 && ix <= 13 { return msg.get((&k_z_stufen[0 as usize]) as u64) }
    if ix == 17 { return (&setbase.l_ustat[0 as usize]) as u64 }
    if ix == 19 { return (&setbase.b_proto[0 as usize]) as u64 }
    if ix == 21 { return (&setbase.l_prostat[0 as usize]) as u64 }
    if ix == 22 { return (&setbase.l_upver[0 as usize]) as u64 }
    if ix == 23 { return (&setbase.l_uplast[0 as usize]) as u64 }
    if ix == 24 { return (&setbase.l_upphase[0 as usize]) as u64 }
    if ix == 31 { return (&setbase.l_systat[0 as usize]) as u64 }
    if ix == 32 { return (&setbase.l_suver[0 as usize]) as u64 }
    if ix == 33 { return (&setbase.l_suphase[0 as usize]) as u64 }
    if ix == 34 { return (&setbase.b_sunotes[0 as usize]) as u64 }
    if ix == 37 { return (&setbase.l_vkon[0 as usize]) as u64 }
    if ix == 39 { return (&setbase.e_vid[0 as usize]) as u64 }
    if ix == 41 {
        setbase.kval[(setbase.K_VSEL) as usize] = setbase.v_sel
        return (&setbase.v_entries[0 as usize]) as u64
    }
    return 0
}

fn sys_bk(ix: u64) -> u64 {
    if ix == 38 { return 2 }
    if ix == 18 || ix == 20 || ix == 40 || ix == 35 || ix == 36 { return 1 }
    if ix >= 25 && ix <= 30 { return 1 }
    return 0
}

fn sys_wd(ix: u64) -> u64 {
    if ix == 0 { return setdevice.first_of(150, 80, 6) }
    if ix == 1 { return 80 }
    if ix >= 9 && ix <= 11 { return setdevice.fitn(100, 3, 4) }
    if ix == 12 || ix == 13 { return setdevice.fitn(120, 2, 6) }
    if ix == 18 { return setdevice.fitw(140) }
    if ix == 38 || ix == 40 { return setdevice.fitw(150) }
    if ix >= 25 && ix <= 30 { return setdevice.fitw(260) }
    if ix == 35 || ix == 36 { return setdevice.fitw(260) }
    return 0
}

fn sys_bool(ix: u64) -> bool {
    if ix == 2 { return setbase.tb_autohide != 0 }
    if ix == 3 { return setbase.tb_ontop != 0 }
    if ix == 14 { return wlibc.shadow_an() }
    return false
}

fn sys_sl(ix: u64, what: u64) -> u64 {
    if ix == 7 {
        if what == 1 { return 100 }
        if what == 2 { return 1 }
        if what == 3 { return wlibc.tb_alpha() }
    }
    if ix == 8 {
        if what == 1 { return 16 }
        if what == 3 { return wlibc.tb_blur() }
    }
    if ix == 15 {
        if what == 1 { return 24 }
        if what == 3 { return wlibc.radius() }
    }
    if ix == 16 {
        if what == 1 { return 100 }
        if what == 2 { return 1 }
        if what == 3 { return wlibc.win_alpha() }
    }
    return 0
}

fn sys_tbl(ix: u64, what: u64) -> u64 {
    if ix == 19 {
        if what == 0 { return 6 }
        if what == 1 { return 300 }
        if what == 2 { return 22 }
        if what == 3 { return (&setbase.c_proto[0 as usize]) as u64 }
    }
    return 0
}

fn man_sl(w: u64, ix: u64, what: u64) -> u64 {
    if w == 4 {
        return sys_sl(ix, what)
    }
    return 0
}

fn man_tbl(w: u64, ix: u64, what: u64) -> u64 {
    if w == 4 {
        return sys_tbl(ix, what)
    }
    if w == 5 {
        return setdevice.tl_tbl(ix, what)
    }
    return 0
}

fn man_bool(w: u64, ix: u64) -> bool {
    if w == 4 {
        return sys_bool(ix)
    }
    return false
}

fn man_cv(w: u64, ix: u64) -> u64 {
    if w == 4 && ix == 42 { return 1 }
    return 0
}

fn man_cond(w: u64, ix: u64) -> bool {
    if w == 0 {
        if ix == 14 { return setbase.acct_more != 0 }
        if ix == 15 { return setbase.k_n > 0 }
    }
    if w == 1 && ix == 17 {
        return setbase.kval[(setbase.K_CN) as usize] != 0
    }
    if w == 1 && ix == 18 {
        return setbase.sy_pend != 0
    }
    if w == 3 && ix == 31 {
        return setwifi.needs_password(setwifi.pick())
    }
    if w == 4 && ix == 43 {
        return setbase.v_n > 0
    }
    if w == 5 {
        if ix == 5 { return setbase.y_account != 0 }
        if ix == 6 { return setbase.y_kn > 0 }
    }
    return false
}

fn man_id(w: u64, ix: u64) -> u64 {
    if w == 0 {
        return setdevice.acct_id(ix)
    }
    if w == 2 {
        return setdevice.dsp_id(ix)
    }
    if w == 3 {
        return setdevice.per_id(ix)
    }
    if w == 4 {
        return sys_id(ix)
    }
    if w == 5 {
        return setdevice.tl_id(ix)
    }
    return net_id(ix)
}

fn man_buf(w: u64, ix: u64) -> u64 {
    if w == 0 {
        return setdevice.acct_buf(ix)
    }
    if w == 2 {
        return setdevice.dsp_buf(ix)
    }
    if w == 3 {
        return setdevice.per_buf(ix)
    }
    if w == 4 {
        return sys_buf(ix)
    }
    if w == 5 {
        return setdevice.tl_buf(ix)
    }
    return net_buf(ix)
}

fn man_ht(w: u64, ix: u64) -> u64 {
    if w == 2 && ix == 2 {
        return 110
    }
    if w == 4 && ix == 19 {
        return sys_tbl(ix, 1)
    }
    if w == 4 && ix == 42 {
        return 64
    }
    if w == 5 {
        if ix == 4 { return 90 }
        if ix != 25 { return setdevice.tl_tbl(ix, 1) }
    }
    return 150
}

fn man_bk(w: u64, ix: u64) -> u64 {
    if w == 3 {
        return setdevice.per_bk(ix)
    }
    if w == 4 {
        return sys_bk(ix)
    }
    if w == 5 {
        return setdevice.tl_bk(ix)
    }
    if w == 1 && (ix == 15 || ix == 16) {
        return 1
    }
    if w == 2 {
        if ix == 7 { return 2 }
        if ix == 9 { return 3 }
        if ix == 10 || ix == 19 || ix == 20 { return 1 }
    }
    return 0
}

fn man_visible(w: u64, i: u64) -> bool {
    let c: u64 = manifest.item_cond(i)
    if c == 0 {
        return true
    }
    let cix: u64 = man_bind(w, c)
    if cix == setbase.AB_NONE {
        return false
    }
    return man_cond(w, cix) != (manifest.item_neg(i) == 1)
}

fn man_wd(w: u64, ix: u64) -> u64 {
    if w == 3 {
        return setdevice.per_wd(ix)
    }
    if w == 4 {
        return sys_wd(ix)
    }
    if w == 5 {
        return setdevice.tl_wd(ix)
    }
    if w == 1 {
        if ix == 10 || (ix >= 12 && ix <= 14) {
            return HALF - 2 * wlibc.space(2)
        }
        if ix == 15 || ix == 16 {
            return setdevice.fitw(140)
        }
    }
    if w == 2 {
        if ix == 7 { return setdevice.fitw(140) }
        if ix == 9 { return setdevice.fitw(240) }
        if ix == 10 || ix == 19 || ix == 20 { return setdevice.fitw(120) }
        if ix == 16 || ix == 17 { return 70 }
        if ix == 18 { return 50 }
    }
    return 0
}

fn man_slider(parent: usize, w: u64, ix: u64, lab: u64, id: u64, buf: u64) {
    let row: usize = fuiscene.row(parent)
    var ltxt: u64 = buf
    if ltxt == 0 {
        ltxt = msg.get(lab)
    }
    let n_l: usize = fuiscene.label(row, ltxt)
    fuiscene.set_size(n_l, setdevice.slab_w(), 0)
    let lo: u64 = man_sl(w, ix, 0)
    let hi: u64 = man_sl(w, ix, 1)
    let _n_s: usize = fuiscene.slider(row, id, setdevice.slid_w(), setaccount.slv_init(id, lo, hi, man_sl(w, ix, 3)))
    fuiscene.slider_readout(id, lo, hi, man_sl(w, ix, 2) == 1)
}

fn man_table(parent: usize, w: u64, ix: u64, lab: u64, id: u64, buf: u64) {
    if lab != 0 {
        let _n_tl: usize = fuiscene.label(parent, msg.get(lab))
    }
    let cols: u64 = man_tbl(w, ix, 0)
    let _n_t: usize = fuiscene.table_blob(parent, id, 0, man_ht(w, ix), cols, buf)
    if man_tbl(w, ix, 2) != 0 {
        fuiscene.table_row_height(id, man_tbl(w, ix, 2))
    }
    setaccount.colw_set(id, man_tbl(w, ix, 3), cols)
}

fn man_canvas(parent: usize, w: u64, ix: u64, id: u64) {
    if man_cv(w, ix) == 1 {
        let _n_cv: usize = fuiscene.canvas2(parent, id, 0, man_ht(w, ix), setaccount.draw_tile)
    }
}

fn man_field(parent: usize, w: u64, i: u64) {
    let lab: u64 = manifest.item_label(i)
    let ix: u64 = man_bind(w, manifest.item_key(i))
    if ix == setbase.AB_NONE {
        return
    }
    let ty: u64 = manifest.item_type(i)
    let id: u64 = man_id(w, ix)
    let buf: u64 = man_buf(w, ix)
    let bw: u64 = man_wd(w, ix)
    if ty == manifest.T_ACTION {
        let bk: u64 = man_bk(w, ix)
        var n_b: usize = 0
        if bk == 2 {
            n_b = fuiscene.button_main(parent, msg.get(lab), id)
        } else {
            n_b = fuiscene.button(parent, msg.get(lab), id)
        }
        if bk == 1 || bk == 2 {
            fuiscene.set_size(n_b, bw, 28)
        } else if bk == 3 {
            fuiscene.button_fit(n_b, msg.get(lab), bw)
        } else {
            fuiscene.button_fit(n_b, msg.get(lab), setdevice.fitw(160))
        }
    } else if ty == manifest.T_STATUS {
        let df: u64 = manifest.item_def(i)
        if df != 0 {
            let _n_sw: usize = fuiscene.label_wrap(parent, buf, __mmio_read8(df as *mut u8) as u64 - 48)
        } else {
            let _n_s: usize = fuiscene.label(parent, buf)
        }
    } else if ty == manifest.T_LIST {
        if lab != 0 {
            let _n_ll: usize = fuiscene.label(parent, msg.get(lab))
        }
        let _n_t: usize = fuiscene.table_list(parent, id, 0, man_ht(w, ix), 1, buf)
        if id == setbase.K_WNETS {
            fuiscene.table_single(id, true)
            fuiscene.table_set_sel(id, setwifi.pick())
        }
    } else if ty == manifest.T_CHOICE {
        if lab != 0 {
            let _n_cl: usize = fuiscene.label(parent, msg.get(lab))
        }
        let n_c: usize = fuiscene.choice(parent, setaccount.chtext(id, buf), id)
        fuiscene.set_size(n_c, bw, 28)
    } else if ty == manifest.T_BOOL {
        let _n_k: usize = fuiscene.toggle(parent, msg.get(lab), id, man_bool(w, ix))
    } else if ty == manifest.T_SLIDER {
        man_slider(parent, w, ix, lab, id, buf)
    } else if ty == manifest.T_TABLE {
        man_table(parent, w, ix, lab, id, buf)
    } else if ty == manifest.T_CANVAS {
        man_canvas(parent, w, ix, id)
    } else if ty == manifest.T_TEXT || ty == manifest.T_SECRET {
        if lab != 0 {
            let _n_el: usize = fuiscene.label(parent, msg.get(lab))
        }
        let n_e: usize = fuiscene.entry(parent, id, bw, buf)
        fuiscene.set_size(n_e, bw, 28)
        if ty == manifest.T_SECRET {
            fuiscene.entry_secret(id, true)
        }
    }
}

static mut pkg_base: u64 = 0

const GROUP_NAMES: str = __include_str("../settings.d/groups.names")

static mut pkg_state: u64 = 0

static mut pkg_buf: [u8; 3080] = [0 as u8; 3080]

static mut pkg_pend: u64 = 0

static mut pkg_pend_item: u64 = 0

static mut pkg_kept: u64 = 0

static mut k_pkg_dlg: [u8; 17] = "settings.pkg.dlg\0"

static mut k_pkg_usedlg: [u8; 11] = "use_dialog\0"

static mut pkg_call: [u8; 64] = [0 as u8; 64]

static mut k_settings_catpkg: [u8; 16] = "settings.catpkg\0"

static mut k_pkg_ok: [u8; 16] = "settings.pkg.ok\0"

static mut k_pkg_ask: [u8; 17] = "settings.pkg.ask\0"

static mut k_pkg_err: [u8; 17] = "settings.pkg.err\0"

static mut k_pkg_nobus: [u8; 19] = "settings.pkg.nobus\0"

static mut k_pkg_deny: [u8; 18] = "settings.pkg.deny\0"

fn tab_key(p: u64) -> u64 {
    if p >= setbase.R_ANZ {
        return setbase.K_PKGTAB0 + p - setbase.R_ANZ
    }
    return setbase.K_TAB0 + p
}

fn pkg_cat(n: u64) -> u64 {
    if n >= setbase.pkg_n {
        return setbase.NCAT
    }
    let g: str = GROUP_NAMES
    let ix: u64 = manifest.names_index(g.p as u64, g.n as u64, manifest.page_group(setbase.pkg_pg[(n) as usize]))
    if ix == manifest.NONE {
        return setbase.NCAT
    }
    return ix
}

fn pkg_two(n: u64) -> bool {
    if n >= setbase.pkg_n {
        return false
    }
    let pg: u64 = setbase.pkg_pg[(n) as usize]
    var i: u64 = manifest.page_first(pg)
    let end: u64 = i + manifest.page_len(pg)
    while i < end {
        if manifest.item_col(i) == 1 {
            return true
        }
        i = i + 1
    }
    return false
}

fn pkg_names() {
    var n: u64 = 0
    while n < setbase.pkg_n {
        let t: u64 = msg.get(manifest.page_title(setbase.pkg_pg[(n) as usize]))
        let dst: u64 = ((&setbase.tab_buf[0 as usize]) as u64) + (setbase.R_ANZ + n) * 40
        let o: u64 = ulib.strncpy(dst, t, 38)
        __mmio_write8((dst + o) as *mut u8, 0 as u8)
        n = n + 1
    }
}

fn pkg_try(name: u64) {
    var t_dir: [u8; 7] = "/apps/\0"
    var t_set: [u8; 15] = ".prog/SETTINGS\0"
    var path: [u8; 96] = [0 as u8; 96]
    let pp: u64 = (&path[0 as usize]) as u64
    if text.length(name) > 40 {
        return
    }
    ulib.strcpy(pp, (&t_dir[0 as usize]) as u64)
    ulib.strcat(pp, name)
    ulib.strcat(pp, (&t_set[0 as usize]) as u64)
    let n: u64 = setcore.file_read(pp, (&pkg_buf[0 as usize]) as u64, 3080)
    if n == 0 || n > 3072 {
        return
    }
    let pre: u64 = manifest.page_count()
    let _r: u64 = manifest.add_pkg((&pkg_buf[0 as usize]) as u64, n, name)
    let post: u64 = manifest.page_count()
    if post > pre && pre >= pkg_base {
        let _q: u64 = setroute.queue_package((&pkg_buf[0 as usize]) as u64, n, name, setbase.R_ANZ + pre - pkg_base, post - pre)
    }
}

fn pkg_init() {
    if pkg_state != 0 {
        return
    }
    pkg_state = 1
    if !man_ready() {
        return
    }
    setdevice.ap_load()
    pkg_base = manifest.page_count()
    var k: u64 = 0
    while k < setbase.ap_n {
        pkg_try(setdevice.ap_name_ptr(k))
        k = k + 1
    }
    let np: u64 = manifest.page_count()
    var p: u64 = 0
    while p < np && setbase.pkg_n < setbase.PKG_MAX {
        if manifest.page_app(p) != 0 {
            setbase.pkg_pg[(setbase.pkg_n) as usize] = p
            setbase.pkg_n = setbase.pkg_n + 1
        }
        p = p + 1
    }
}

fn pkg_prefix_ok(app: u64, act: u64) -> bool {
    if app == 0 || act == 0 {
        return false
    }
    var i: u64 = 0
    while regio.read8_at(app, i) != 0 {
        if regio.read8_at(act, i) != regio.read8_at(app, i) {
            return false
        }
        i = i + 1
    }
    return regio.read8_at(act, i) == 46
}

fn pkg_say(key: u64) {
    setaccount.stat_set((&setbase.pkg_stat[0 as usize]) as u64, key, 0)
}

fn pkg_req(act: u64) {
    let cp: u64 = (&pkg_call[0 as usize]) as u64
    var t_call: [u8; 6] = "call \0"
    let o: u64 = setaccount.bx_put(cp, 0, 64, (&t_call[0 as usize]) as u64)
    let _o2: u64 = setaccount.bx_put(cp, o, 64, act)
    actcli.req(cp)
}

fn pkg_dialog_only() -> bool {
    var ln: [u8; 160] = [0 as u8; 160]
    let lp: u64 = (&ln[0 as usize]) as u64
    let _l: bool = actcli.line(0, lp, 160)
    return ulib.find(lp, (&k_pkg_usedlg[0 as usize]) as u64) != 0xFFFFFFFFFFFFFFFF
}

fn pkg_trace_text(i: u64, tx: u64) {
    var s1: [u8; 22] = "settings: pkg text i=\0"
    var s2: [u8; 6] = " len=\0"
    setcore.say((&s1[0 as usize]) as u64)
    setcore.sayn(i)
    setcore.say((&s2[0 as usize]) as u64)
    if tx == 0 {
        setcore.sayn(0xFFFF)
    } else {
        setcore.sayn(text.length(tx))
    }
    setcore.nl()
}

fn pkg_trace(rc: u64) {
    var ln: [u8; 160] = [0 as u8; 160]
    let lp: u64 = (&ln[0 as usize]) as u64
    let _l: bool = actcli.line(0, lp, 160)
    var s1: [u8; 25] = "settings: pkg answer rc=\0"
    var s2: [u8; 8] = " line=[\0"
    var s3: [u8; 2] = "]\0"
    setcore.say((&s1[0 as usize]) as u64)
    setcore.sayn(rc)
    setcore.say((&s2[0 as usize]) as u64)
    setcore.say(lp)
    setcore.say((&s3[0 as usize]) as u64)
    setcore.nl()
}

fn pkg_true(c: u64) -> bool {
    return c == 116 || c == 84 || c == 49 || c == 121 || c == 89
}

fn pkg_enter(n: u64) {
    if n >= setbase.pkg_n {
        return
    }
    pkg_pend = 0
    __mmio_write8(((&setbase.pkg_stat[0 as usize]) as u64) as *mut u8, 0 as u8)
    pkg_read_page(n)
}

fn pkg_read_page(n: u64) {
    let pg: u64 = setbase.pkg_pg[(n) as usize]
    let app: u64 = manifest.app_at(manifest.page_app(pg))
    let first: u64 = manifest.page_first(pg)
    let len: u64 = manifest.page_len(pg)
    var i: u64 = first
    while i < first + len && i - first < 80 {
        let slot: u64 = i - first
        setbase.pkg_val[(slot) as usize] = 0
        __mmio_write8(((&setbase.pkg_txt[0 as usize]) as u64 + slot * 64) as *mut u8, 0 as u8)
        if manifest.item_kind(i) == manifest.K_FIELD {
            let df: u64 = manifest.item_def(i)
            if df != 0 {
                if manifest.item_type(i) == manifest.T_BOOL {
                    if pkg_true(regio.read8_at(df, 0)) {
                        setbase.pkg_val[(slot) as usize] = 1
                    }
                } else {
                    let o: u64 = ulib.strncpy(((&setbase.pkg_txt[0 as usize]) as u64) + slot * 64, df, 62)
                    __mmio_write8(((&setbase.pkg_txt[0 as usize]) as u64 + slot * 64 + o) as *mut u8, 0 as u8)
                }
            }
            let rd: u64 = manifest.item_read(i)
            if rd != 0 && pkg_prefix_ok(app, rd) {
                pkg_req(rd)
                let rc: u64 = actcli.send(300)
                if rc == actcli.R_OK {
                    var v: [u8; 64] = [0 as u8; 64]
                    let vp: u64 = (&v[0 as usize]) as u64
                    if actcli.field(manifest.item_key(i), vp, 64) {
                        if manifest.item_type(i) == manifest.T_BOOL {
                            setbase.pkg_val[(slot) as usize] = 0
                            if pkg_true(regio.read8_at(vp, 0)) {
                                setbase.pkg_val[(slot) as usize] = 1
                            }
                        } else {
                            let o2: u64 = ulib.strncpy(((&setbase.pkg_txt[0 as usize]) as u64) + slot * 64, vp, 62)
                            __mmio_write8(((&setbase.pkg_txt[0 as usize]) as u64 + slot * 64 + o2) as *mut u8, 0 as u8)
                        }
                    }
                } else if rc == actcli.R_NOBUS {
                    pkg_say((&k_pkg_nobus[0 as usize]) as u64)
                }
            }
        }
        i = i + 1
    }
}

fn pkg_click(i: u64) {
    if setbase.active_tab < setbase.R_ANZ || setbase.active_tab - setbase.R_ANZ >= setbase.pkg_n {
        return
    }
    let n: u64 = setbase.active_tab - setbase.R_ANZ
    let pg: u64 = setbase.pkg_pg[(n) as usize]
    let first: u64 = manifest.page_first(pg)
    if i < first || i >= first + manifest.page_len(pg) || i - first >= 80 {
        return
    }
    let slot: u64 = i - first
    let ty: u64 = manifest.item_type(i)
    let wr: u64 = manifest.item_write(i)
    let app: u64 = manifest.app_at(manifest.page_app(pg))
    if wr == 0 || ty == manifest.T_STATUS {
        fuiscene.refresh()
        return
    }
    if !pkg_prefix_ok(app, wr) {
        pkg_say((&k_pkg_deny[0 as usize]) as u64)
        fuiscene.refresh()
        return
    }
    var rc: u64 = actcli.R_ERR
    if pkg_pend != 0 && pkg_pend_item == i {

        var cf: [u8; 32] = [0 as u8; 32]
        var s_c: [u8; 9] = "confirm \0"
        let o: u64 = setaccount.bx_put((&cf[0 as usize]) as u64, 0, 32, (&s_c[0 as usize]) as u64)
        let _o2: u64 = setaccount.bx_num((&cf[0 as usize]) as u64, o, 32, pkg_pend)
        actcli.req((&cf[0 as usize]) as u64)
        pkg_kept = pkg_pend
        pkg_pend = 0
        rc = actcli.send(300)
    } else {
        if ty == manifest.T_TEXT || ty == manifest.T_SECRET {
            let tx0: u64 = fuiscene.entry_text(setbase.K_PKGF0 + i)
            pkg_trace_text(i, tx0)
            if tx0 == 0 || regio.read8_at(tx0, 0) == 0 {
                fuiscene.refresh()
                return
            }
        }
        pkg_req(wr)
        if ty == manifest.T_BOOL {
            var t_t: [u8; 5] = "true\0"
            var t_f: [u8; 6] = "false\0"
            if fuiscene.value_of(setbase.K_PKGF0 + i) != 0 {
                actcli.arg(manifest.item_key(i), (&t_t[0 as usize]) as u64)
            } else {
                actcli.arg(manifest.item_key(i), (&t_f[0 as usize]) as u64)
            }
        } else if ty == manifest.T_TEXT || ty == manifest.T_SECRET {
            let tx: u64 = fuiscene.entry_text(setbase.K_PKGF0 + i)
            if tx != 0 {
                actcli.arg(manifest.item_key(i), tx)
            }
        }
        pkg_pend = 0
        rc = actcli.send(300)
    }
    if rc == actcli.R_OK {
        pkg_say((&k_pkg_ok[0 as usize]) as u64)
    } else if rc == actcli.R_CONFIRM {
        var ln: [u8; 160] = [0 as u8; 160]
        let lp: u64 = (&ln[0 as usize]) as u64
        let _l: bool = actcli.line(0, lp, 160)
        var j: u64 = 8
        var no: u64 = 0
        while regio.read8_at(lp, j) >= 48 && regio.read8_at(lp, j) <= 57 {
            no = no * 10 + regio.read8_at(lp, j) - 48
            j = j + 1
        }
        pkg_pend = no
        pkg_pend_item = i
        pkg_say((&k_pkg_ask[0 as usize]) as u64)
    } else if rc == actcli.R_NOBUS {
        pkg_say((&k_pkg_nobus[0 as usize]) as u64)
    } else if pkg_dialog_only() {
        pkg_pend = pkg_kept
        pkg_pend_item = i
        pkg_say((&k_pkg_dlg[0 as usize]) as u64)
    } else {
        pkg_say((&k_pkg_err[0 as usize]) as u64)
    }
    pkg_trace(rc)

    pkg_read_page(n)
    let _slot: u64 = slot
    fuiscene.refresh()
    setbase.rep_due = 1
}

fn net_sum() -> u64 {
    var sum: u64 = 7
    var i: u64 = 0
    while i < 64 {
        sum = (sum ^ (l_nzust[(i) as usize] as u64)) *% 1099511628211
        sum = (sum ^ (setbase.l_nrate[(i) as usize] as u64)) *% 1099511628211
        sum = (sum ^ (setbase.l_nrunter[(i) as usize] as u64)) *% 1099511628211
        sum = (sum ^ (setbase.l_nrauf[(i) as usize] as u64)) *% 1099511628211
        sum = (sum ^ (setbase.l_nsumme[(i) as usize] as u64)) *% 1099511628211
        sum = (sum ^ (setbase.l_nping[(i) as usize] as u64)) *% 1099511628211
        i = i + 1
    }
    i = 0
    while i < 400 {
        sum = (sum ^ (setbase.b_nprog[(i) as usize] as u64)) *% 1099511628211
        sum = (sum ^ (setbase.b_nconn[(i) as usize] as u64)) *% 1099511628211
        i = i + 1
    }
    return sum
}

fn cat_of(p: u64) -> u64 {
    if p >= setbase.R_ANZ {
        return pkg_cat(p - setbase.R_ANZ)
    }
    if p == setbase.R_SYSTEM || p == setbase.R_BRIDGE || p == setbase.R_MOUSE || p == setbase.R_ENERGIE || p == setbase.R_APPS || p == setbase.R_SOUND || p == setbase.R_TOUCHPAD {
        return 0
    } else if p == setbase.R_SCREEN || p == setbase.R_SCREEN2 || p == setbase.R_SCREEN3 {
        return 1
    } else if p == setbase.R_NET || p == setbase.R_NETDETAIL || p == setbase.R_NETV || p == setbase.R_WIFI || p == setbase.R_USBNET || p == setbase.R_BLUETOOTH {
        return 2
    } else if p == setbase.R_BENUT || p == setbase.R_ACCOUNT || p == setbase.R_SYNC || p == setbase.R_PASSW || p == setbase.R_PIN {
        return 3
    } else if p == setbase.R_DARST || p == setbase.R_VORL || p == setbase.R_TASKBAR || p == setbase.R_EFFECTS || p == setbase.R_SCHEME || p == setbase.R_ACCENT || p == setbase.R_VTRANS {
        return 4
    } else if p == setbase.R_TIME || p == setbase.R_SPRACHE {
        return 5
    } else if p == setbase.R_UPDATE {
        return 6
    }
    return 7
}

fn cat_name(c: u64) -> u64 {
    if c >= setbase.NCAT {
        return msg.get((&k_settings_catpkg[0 as usize]) as u64)
    }
    return ((&setbase.cat_buf[0 as usize]) as u64) + c * 40
}

fn accent_slider_row(card: usize, name: u64, key: u64, lo: u64, hi: u64, v: u64) {
    let r: usize = fuiscene.row(card)
    let l: usize = fuiscene.label(r, name)
    fuiscene.set_size(l, setdevice.fitw(96), 0)
    let _s: usize = fuiscene.slider(r, key, 160, setaccount.slv_init(key, lo, hi, v))
}

fn accent_from_sliders() {
    setbase.acc_h = setaccount.slv(setbase.K_HUE, 0, 359)
    setbase.acc_s = setaccount.slv(setbase.K_SATU, 0, 100)
    setbase.acc_v = setaccount.slv(setbase.K_VALU, 0, 100)
    setdevice.hex_put((&setbase.e_akzent[0 as usize]) as u64, hsv.to_rgb(setbase.acc_h, setbase.acc_s, setbase.acc_v))
    setbase.sw_sel = 8
}

fn accent_pick(i: u64) {
    setbase.sw_sel = i
    let rgb: u64 = setdevice.sw_rgb(i)
    setbase.acc_h = hsv.hue_of(rgb)
    setbase.acc_s = hsv.sat_of(rgb)
    setbase.acc_v = hsv.val_of(rgb)
    let _c: u64 = ulib.strncpy((&setbase.e_akzent[0 as usize]) as u64, ((&setbase.sw_hex[0 as usize]) as u64) + i * 8, 12)
}

fn tab_names() {
    tab_names_base()
    pkg_names()
}

fn tab_names_base() {
    let next: u64 = tab_fill(msg.get((&k_t_tabs[0 as usize]) as u64), 0)
    let mid: u64 = tab_fill(msg.get((&k_t_tabs2[0 as usize]) as u64), next)
    let last: u64 = tab_fill(msg.get((&k_t_tabs3[0 as usize]) as u64), mid)
    var t: u64 = last
    while t < setbase.R_ANZ {
        setbase.tab_buf[((t * 40)) as usize] = 0 as u8
        t = t + 1
    }
}

fn tab_fill(src: u64, first: u64) -> u64 {
    var t: u64 = first
    var o: u64 = 0
    var q: u64 = 0
    while t < setbase.R_ANZ {
        let c: u8 = __mmio_read8((src + q) as *mut u8)
        if c == 0 as u8 || c == 10 as u8 {
            setbase.tab_buf[((t * 40 + o)) as usize] = 0 as u8
            t = t + 1
            o = 0
            if c == 0 as u8 {
                return t
            }
        } else if o < 38 {
            setbase.tab_buf[((t * 40 + o)) as usize] = c
            o = o + 1
        }
        q = q + 1
    }
    return t
}

fn two_cols(r: u64) -> bool {
    return r == setbase.R_DARST || r == setbase.R_VORL || r == setbase.R_TASKBAR || r == setbase.R_EFFECTS || r == setbase.R_SCHEME || r == setbase.R_SCREEN || r == setbase.R_SCREEN2 || r == setbase.R_SCREEN3 || r == setbase.R_NETV
        || r == setbase.R_ACCOUNT || (r == setbase.R_APPS && setbase.ap_sel != setbase.AP_NONE) || (r >= setbase.R_ANZ && pkg_two(r - setbase.R_ANZ))
}
