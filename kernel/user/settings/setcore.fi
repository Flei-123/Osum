fn field_num(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    var fertig: bool = false
    while i < 12 && !fertig {
        let c: u64 = __mmio_read8((p + i) as *mut u8) as u64
        if c < 48 || c > 57 {
            fertig = true
        } else {
            v = v * 10 + (c - 48)
            i = i + 1
        }
    }
    return v
}

static mut ms_a: [u8; 23] = "settings: menu open i=\0"

static mut ms_d: [u8; 7] = " rows=\0"

static mut ms_g: [u8; 5] = " rh=\0"

static mut ms_e: [u8; 23] = "settings: menu took i=\0"

static mut ms_f: [u8; 6] = " row=\0"

fn menu_say(i: u64, x: u64, y: u64, n: u64) {
