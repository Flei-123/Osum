fn rs_put(at: u64, p: u64) -> u64 {
    let b: u64 = (&setbase.rs_buf[0 as usize]) as u64
    var i: u64 = 0
    var a: u64 = at
    while __mmio_read8((p + i) as *mut u8) != 0 as u8 && a + 2 < 160 {
        __mmio_write8((b + a) as *mut u8, __mmio_read8((p + i) as *mut u8))
        a = a + 1
        i = i + 1
    }
    return a
}

fn rs_num(at: u64, v: u64) -> u64 {
    let b: u64 = (&setbase.rs_buf[0 as usize]) as u64
    var d: [u8; 24] = [0 as u8; 24]
    let dp: u64 = (&d[0 as usize]) as u64
    var n: u64 = 0
    var q: u64 = v
    if q == 0 {
        __mmio_write8(dp as *mut u8, 48 as u8)
        n = 1
    }
    while q > 0 && n < 24 {
        __mmio_write8((dp + n) as *mut u8, (48 + q % 10) as u8)
        q = q / 10
        n = n + 1
    }
    var a: u64 = at
    var i: u64 = n
    while i > 0 && a + 2 < 160 {
        i = i - 1
        __mmio_write8((b + a) as *mut u8, __mmio_read8((dp + i) as *mut u8))
        a = a + 1
    }
    return a
}

fn rect_say(name: u64, key: u64) {
    let i: usize = fuiscene.node_of_key(key)
    if i == fuiscene.NONE {
        return
    }
    rect_say_at(name, fuiscene.node_x(i), fuiscene.node_y(i),
        fuiscene.node_w(i), fuiscene.node_h(i))
}

fn neg_pos(v: u64) -> bool {
    return v >= 549755813888
}

fn rect_say_at(name: u64, rx: u64, ry: u64, rw: u64, rh: u64) {
    if neg_pos(rx) || neg_pos(ry) {
        return
    }
    var at: u64 = rs_put(0, (&setbase.mr_a[0 as usize]) as u64)
    at = rs_put(at, name)
    at = rs_put(at, (&setbase.ms_b[0 as usize]) as u64)
    at = rs_num(at, rx)
    at = rs_put(at, (&setbase.ms_c[0 as usize]) as u64)
    at = rs_num(at, ry)
    at = rs_put(at, (&setbase.mr_w[0 as usize]) as u64)
    at = rs_num(at, rw)
    at = rs_put(at, (&setbase.mr_h[0 as usize]) as u64)
    at = rs_num(at, rh)
    at = rs_put(at, (&setbase.mr_ax[0 as usize]) as u64)
    at = rs_num(at, apphost.win_cx(setbase.w) + rx)
    at = rs_put(at, (&setbase.mr_ay[0 as usize]) as u64)
    at = rs_num(at, apphost.win_cy(setbase.w) + ry)
    let b: u64 = (&setbase.rs_buf[0 as usize]) as u64
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = lineout.add_bytes(b, at)
}

fn tset(t: u64, f: u64, v: u64) {
    if t >= setbase.TILES || f >= setbase.TILE_FIELDS {
        return
    }
    setbase.tsp[((t * setbase.TILE_FIELDS + f)) as usize] = v
}

fn tspec_at(t: u64) -> u64 {
    return ((&setbase.tsp[0 as usize]) as u64) + t * setbase.TILE_FIELDS * 8
}

fn columns_set(tb: u64, bw: u64, bh: u64) {

}

fn karten_say() {
    var a: [u8; 7] = "kartel\0"
    var c: [u8; 7] = "karter\0"

    if setbase.card_l != 0 {
        let i: usize = (setbase.card_l - 1) as usize
        rect_say_at((&a[0 as usize]) as u64, fuiscene.node_x(i), fuiscene.node_y(i),
            fuiscene.node_w(i), fuiscene.node_h(i))
    }
    if setbase.card_r != 0 {
        let i2: usize = (setbase.card_r - 1) as usize
        rect_say_at((&c[0 as usize]) as u64, fuiscene.node_x(i2), fuiscene.node_y(i2),
            fuiscene.node_w(i2), fuiscene.node_h(i2))
    }
}

fn templates_read() {
    var nl: [u8; 2] = "\n\0"
    setbase.v_n = template.scan()
    var bp: u64 = 0
    var i: u64 = 0
    while i < setbase.v_n && i < setbase.TILES {

        bp = text_an((&setbase.v_entries[0 as usize]) as u64, bp, template.name_at(i))
        if i + 1 < setbase.v_n && i + 1 < setbase.TILES {
            bp = text_an((&setbase.v_entries[0 as usize]) as u64, bp,
                (&nl[0 as usize]) as u64)
        }

        let _k: u64 = template.measure(i)
        tset(i, setbase.TL_SURFACE, wlibc.theme_probe_comp(uitheme.C_WINDOW_BG))
        tset(i, setbase.TL_RAISED, wlibc.theme_probe_comp(uitheme.C_PANEL_BG))
        tset(i, setbase.TL_ACCENT, wlibc.theme_probe_comp(uitheme.C_TITLEBAR_BG))
        tset(i, setbase.TL_ONACCENT,
            wlibc.theme_probe_comp(uitheme.C_TITLEBAR_TEXT))
        tset(i, setbase.TL_TEXT, wlibc.theme_probe_comp(uitheme.C_WINDOW_TEXT))
        tset(i, setbase.TL_FRAME, wlibc.theme_probe_comp(uitheme.C_WINDOW_FRAME))
        tset(i, setbase.TL_TASKBAR, wlibc.theme_probe_comp(uitheme.C_TASKBAR_BG))
        tset(i, setbase.TL_TBTEXT, wlibc.theme_probe_comp(uitheme.C_TASKBAR_TEXT))
        tset(i, setbase.TL_BUTTON, wlibc.theme_probe_comp(uitheme.C_BUTTON_FACE))
        tset(i, setbase.TL_DANGER, wlibc.theme_probe_comp(uitheme.C_DANGER))
        tset(i, setbase.TL_RADW,
            wlibc.theme_probe_metric(uitheme.M_RADIUS_WINDOW))
        tset(i, setbase.TL_RADB,
            wlibc.theme_probe_metric(uitheme.M_RADIUS_BUTTON))
        tset(i, setbase.TL_SHADOW, wlibc.theme_probe_metric(uitheme.M_SHADOW))
        tset(i, setbase.TL_EDGE, template.edge_at(i))
        tset(i, setbase.TL_ALIGN, template.align_at(i))
        tset(i, setbase.TL_NAME, template.name_at(i))
        tset(i, setbase.TL_LOW, template.low_at(i))
        i = i + 1
    }
    setbase.v_entries[(bp) as usize] = 0 as u8
    if setbase.v_sel >= setbase.v_n {
        setbase.v_sel = 0
    }
}

fn quote_kon(p: u64, at: u64, v: u64) -> u64 {
    var punkt: [u8; 2] = ".\0"
    var eins: [u8; 4] = ":1\0\0"
    var a: u64 = num_at(p, at, v / 100)
    a = text_an(p, a, (&punkt[0 as usize]) as u64)
    if v % 100 < 10 {
        var z: [u8; 2] = "0\0"
        a = text_an(p, a, (&z[0 as usize]) as u64)
    }
    a = num_at(p, a, v % 100)
    return text_an(p, a, (&eins[0 as usize]) as u64)
}

const Y_LESEMAX: u64 = 1024

fn sync_field(text: u64, name: u64, out: u64, max: u64) -> bool {
    var i: u64 = 0
    var zeilenanfang: bool = true
    while __mmio_read8((text + i) as *mut u8) != 0 as u8 {
        if zeilenanfang {
            var k: u64 = 0
            var fits: bool = true
            while __mmio_read8((name + k) as *mut u8) != 0 as u8 {
                if __mmio_read8((text + i + k) as *mut u8)
                    != __mmio_read8((name + k) as *mut u8) {
                    fits = false
                }
                k = k + 1
            }
            if fits && __mmio_read8((text + i + k) as *mut u8) == 32 as u8 {
                var q: u64 = i + k + 1
                var a: u64 = 0
                while a + 1 < max
                    && __mmio_read8((text + q) as *mut u8) != 0 as u8
                    && __mmio_read8((text + q) as *mut u8) != 10 as u8 {
                    __mmio_write8((out + a) as *mut u8,
                        __mmio_read8((text + q) as *mut u8))
                    a = a + 1
                    q = q + 1
                }
                __mmio_write8((out + a) as *mut u8, 0 as u8)
                return true
            }
        }
        zeilenanfang = __mmio_read8((text + i) as *mut u8) == 10 as u8
        i = i + 1
    }
    __mmio_write8((out) as *mut u8, 0 as u8)
    return false
}

fn copy_until_null(von: u64, move_to: u64) -> u64 {
    var k: u64 = 0
    while __mmio_read8((von + k) as *mut u8) != 0 as u8 {
        __mmio_write8((move_to + k) as *mut u8, __mmio_read8((von + k) as *mut u8))
        k = k + 1
    }
    return k
}

fn line_begins(text: u64, at: u64, name: u64) -> bool {
    var k: u64 = 0
    while __mmio_read8((name + k) as *mut u8) != 0 as u8 {
        if __mmio_read8((text + at + k) as *mut u8)
            != __mmio_read8((name + k) as *mut u8) {
            return false
        }
        k = k + 1
    }
    let c: u8 = __mmio_read8((text + at + k) as *mut u8)
    return c == 32 as u8 || c == 61 as u8 || c == 9 as u8
}

fn sync_read() {
    var p_head: [u8; 12] = "/konto/KOPF\0"
    var p_zaehl: [u8; 15] = "/konto/COUNTER\0"
    var p_zaehl_old: [u8; 15] = "/konto/ZAEHLER\0"
    var p_conf: [u8; 17] = "/konto/CONFLICTS\0"
    var p_conf_old: [u8; 17] = "/konto/KONFLIKTE\0"
    var p_sit: [u8; 19] = "/system/tresor.sit\0"
    var n_prov: [u8; 9] = "provider\0"
    var n_anb_old: [u8; 9] = "anbieter\0"
    var n_target: [u8; 7] = "target\0"
    var n_target_old: [u8; 5] = "ziel\0"
    var buffer: [u8; 1024] = [0 as u8; 1024]
    var value: [u8; 128] = [0 as u8; 128]
    let pp: u64 = (&buffer[0 as usize]) as u64
    let wp: u64 = (&value[0 as usize]) as u64
    let lp: u64 = (&setbase.l_yprov[0 as usize]) as u64
    let lz: u64 = (&setbase.l_yziel[0 as usize]) as u64
    let ls: u64 = (&setbase.l_ystand[0 as usize]) as u64
    let lt: u64 = (&setbase.l_ytres[0 as usize]) as u64
    setbase.y_account = 0
    __mmio_write8((lp) as *mut u8, 0 as u8)
    __mmio_write8((lz) as *mut u8, 0 as u8)
    __mmio_write8((ls) as *mut u8, 0 as u8)
    if file_read((&p_head[0 as usize]) as u64, pp, Y_LESEMAX) > 0 {
        setbase.y_account = 1
        var a: u64 = text_an(lp, 0, msg.get((&k_y_prov[0 as usize]) as u64))
        if sync_field(pp, (&n_prov[0 as usize]) as u64, wp, 128) || sync_field(pp, (&n_anb_old[0 as usize]) as u64, wp, 128) {
            a = text_an(lp, a, wp)
        }
        var b: u64 = text_an(lz, 0, msg.get((&k_y_target[0 as usize]) as u64))
        if sync_field(pp, (&n_target[0 as usize]) as u64, wp, 128) || sync_field(pp, (&n_target_old[0 as usize]) as u64, wp, 128) {
            b = text_an(lz, b, wp)
        }
        var c: u64 = text_an(ls, 0, msg.get((&k_y_stand[0 as usize]) as u64))
        var gen: u64 = 0
        if file_read_or_old((&p_zaehl[0 as usize]) as u64, (&p_zaehl_old[0 as usize]) as u64, pp, Y_LESEMAX) > 0 {
            gen = num_from(pp)
        }
        let _c2: u64 = num_at(ls, c, gen)
    }
    let t: u64 = text_an(lt, 0, msg.get((&k_y_tres[0 as usize]) as u64))
    if file_read((&p_sit[0 as usize]) as u64, pp, Y_LESEMAX) > 0 {
        let _t1: u64 = text_an(lt, t, msg.get((&k_y_auf[0 as usize]) as u64))
    } else {
        let _t2: u64 = text_an(lt, t, msg.get((&k_y_zu[0 as usize]) as u64))
    }
    setbase.y_kn = 0
    let kb: u64 = (&setbase.y_conf[0 as usize]) as u64
    __mmio_write8((kb) as *mut u8, 0 as u8)
    if file_read_or_old((&p_conf[0 as usize]) as u64, (&p_conf_old[0 as usize]) as u64, pp, Y_LESEMAX) > 0 {
        var i: u64 = 0
        var o: u64 = 0
        while __mmio_read8((pp + i) as *mut u8) != 0 as u8 && o + 2 < 640 {
            let ch: u64 = __mmio_read8((pp + i) as *mut u8) as u64
            if ch == 10 {
                if o > 0 && __mmio_read8((kb + o - 1) as *mut u8) != 10 as u8 {
                    __mmio_write8((kb + o) as *mut u8, 10 as u8)
                    o = o + 1
                    setbase.y_kn = setbase.y_kn + 1
                }
            } else {
                __mmio_write8((kb + o) as *mut u8, ch as u8)
                o = o + 1
            }
            i = i + 1
        }
        if o > 0 && __mmio_read8((kb + o - 1) as *mut u8) != 10 as u8 {
            setbase.y_kn = setbase.y_kn + 1
        }
        __mmio_write8((kb + o) as *mut u8, 0 as u8)
    }
}

fn template_con_show() {
    let k: u64 = (&setbase.l_vkon[0 as usize]) as u64
    if setbase.v_n == 0 {
        __mmio_write8((k) as *mut u8, 0 as u8)
        return
    }
    let _m: u64 = template.measure(setbase.v_sel)
    var a: u64 = text_an(k, 0, template.name_at(setbase.v_sel))
    a = text_an(k, a, msg.get((&k_v_ok[0 as usize]) as u64))
    a = quote_kon(k, a, template.m_min())
    if template.low_at(setbase.v_sel) != 0 {
        let _b: u64 = text_an(k, a, msg.get((&k_v_low[0 as usize]) as u64))
    }
}

fn template_say() {
    var a: [u8; 18] = "settings: preset \0"
    var k1: [u8; 3] = "i=\0"
    var k2: [u8; 5] = " id=\0"
    var k3: [u8; 6] = " min=\0"
    var k4: [u8; 6] = " low=\0"
    var k5: [u8; 5] = " bg=\0"
    var k6: [u8; 6] = " txt=\0"
    var k7: [u8; 6] = " acc=\0"
    var k8: [u8; 6] = " sel=\0"
    var i: u64 = 0
    while i < setbase.v_n && i < setbase.TILES {
        let _m: u64 = template.measure(i)
        say((&a[0 as usize]) as u64)
        say((&k1[0 as usize]) as u64)
        sayn(i)
        say((&k2[0 as usize]) as u64)
        say(template.id_at(i))
        say((&k3[0 as usize]) as u64)
        sayn(template.m_min())
        say((&k4[0 as usize]) as u64)
        sayn(template.low_at(i))
        say((&k5[0 as usize]) as u64)
        sayn(setbase.tsp[((i * setbase.TILE_FIELDS + setbase.TL_SURFACE)) as usize])
        say((&k6[0 as usize]) as u64)
        sayn(setbase.tsp[((i * setbase.TILE_FIELDS + setbase.TL_TEXT)) as usize])
        say((&k7[0 as usize]) as u64)
        sayn(setbase.tsp[((i * setbase.TILE_FIELDS + setbase.TL_ACCENT)) as usize])
        say((&k8[0 as usize]) as u64)
        sayn(setbase.v_sel)
        nl()
        i = i + 1
    }
}

fn anhaengen_c(target: u64, at: u64, max: u64, was: u64) -> u64 {
    var a: u64 = at
    var i: u64 = 0
    while *((was + i) as *mut u8) != 0 as u8 && a + 1 < max {
        *((target + a) as *mut u8) = *((was + i) as *mut u8)
        a = a + 1
        i = i + 1
    }
    return a
}

fn level_of_secs(secs: u64) -> u64 {
    return lockidle.level_of(secs)
}

fn say_bar(x: u64, y: u64, w: u64, h: u64, kx: u64, ky: u64, kw: u64, kh: u64,
    ein: u64) {
    if !fuiscene.trace_on() {
        return
    }
    var a0: [u8; 22] = "wlib: kachelbalken x=\0"
    var a1: [u8; 4] = " y=\0"
    var a2: [u8; 4] = " w=\0"
    var a3: [u8; 4] = " h=\0"
    var a4: [u8; 5] = " kx=\0"
    var a5: [u8; 5] = " ky=\0"
    var a6: [u8; 5] = " kw=\0"
    var a7: [u8; 5] = " kh=\0"
    var a8: [u8; 6] = " ein=\0"
    var at: u64 = rs_put(0, (&a0[0 as usize]) as u64)
    at = rs_num(at, x)
    at = rs_put(at, (&a1[0 as usize]) as u64)
    at = rs_num(at, y)
    at = rs_put(at, (&a2[0 as usize]) as u64)
    at = rs_num(at, w)
    at = rs_put(at, (&a3[0 as usize]) as u64)
    at = rs_num(at, h)
    at = rs_put(at, (&a4[0 as usize]) as u64)
    at = rs_num(at, kx)
    at = rs_put(at, (&a5[0 as usize]) as u64)
    at = rs_num(at, ky)
    at = rs_put(at, (&a6[0 as usize]) as u64)
    at = rs_num(at, kw)
    at = rs_put(at, (&a7[0 as usize]) as u64)
    at = rs_num(at, kh)
    at = rs_put(at, (&a8[0 as usize]) as u64)
    at = rs_num(at, ein)
    let bb: u64 = (&setbase.rs_buf[0 as usize]) as u64
    __mmio_write8((bb + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = lineout.add_bytes(bb, at)
}

fn say_kachel_text(x: u64, base: u64, name: u64, fg: u64, bg: u64) {
    if !fuiscene.trace_on() {
        return
    }
    var a0: [u8; 30] = "wlib: text win=0 kind=12 x=\0\0\0"
    var a1: [u8; 7] = " base=\0"
    var a2: [u8; 5] = " fg=\0"
    var a3: [u8; 5] = " bg=\0"
    var a4: [u8; 5] = " tw=\0"
    var a5: [u8; 5] = " ax=\0"
    var a6: [u8; 5] = " ay=\0"
    var a7: [u8; 5] = " nq=\0"
    var a8: [u8; 5] = " nv=\0"
    var a9: [u8; 4] = " t=\0"
    let n: u64 = text.length(name)
    var at: u64 = rs_put(0, (&a0[0 as usize]) as u64)
    at = rs_num(at, x)
    at = rs_put(at, (&a1[0 as usize]) as u64)
    at = rs_num(at, base)
    at = rs_put(at, (&a2[0 as usize]) as u64)
    at = rs_num(at, fg)
    at = rs_put(at, (&a3[0 as usize]) as u64)
    at = rs_num(at, bg)
    at = rs_put(at, (&a4[0 as usize]) as u64)
    at = rs_num(at, wlibc.text_w(wlibc.F_UI, uiscale.px_ui(), name, n))
    at = rs_put(at, (&a5[0 as usize]) as u64)
    at = rs_num(at, apphost.win_cx(setbase.w))
    at = rs_put(at, (&a6[0 as usize]) as u64)
    at = rs_num(at, apphost.win_cy(setbase.w))
    at = rs_put(at, (&a7[0 as usize]) as u64)
    at = rs_num(at, n)
    at = rs_put(at, (&a8[0 as usize]) as u64)
    at = rs_num(at, n)
    at = rs_put(at, (&a9[0 as usize]) as u64)
    at = rs_put(at, name)
    let bb: u64 = (&setbase.rs_buf[0 as usize]) as u64
    __mmio_write8((bb + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = lineout.add_bytes(bb, at)
}
