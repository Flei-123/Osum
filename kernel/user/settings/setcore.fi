static mut k_n_pingn: [u8; 22] = "settings.net.rttnone\0\0"

static mut k_n_pingw: [u8; 22] = "settings.net.rttwait\0\0"

static mut k_n_kconn: [u8; 24] = "settings.net.cols.conn\0\0"

static mut buffer: [u8; 2048] = [0 as u8; 2048]

static mut l_kon: [u8; 96] = [0 as u8; 96]

