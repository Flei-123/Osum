fn reason_read(w: u64, h: u64) {

    let why: u64 = dget(DG_CUSTWHY)
    let num: u64 = dget(DG_CUSTNUM)
    if ulib.bad(why) {
        let _z: u64 = text_an((&setbase.d_reason[0 as usize]) as u64, 0,
            msg.get((&k_g_t_no[0 as usize]) as u64))
        return
    }
    var a: u64 = 0
    if why == 0 {
        a = text_an((&setbase.d_reason[0 as usize]) as u64, 0,
            msg.get((&k_g_t_ok[0 as usize]) as u64))
        let _b: u64 = num_at((&setbase.d_reason[0 as usize]) as u64, a, num)
        return
    }
    if why == 1 {
        a = text_an((&setbase.d_reason[0 as usize]) as u64, 0,
            msg.get((&k_g_t_regs[0 as usize]) as u64))
        a = num_at((&setbase.d_reason[0 as usize]) as u64, a, num)
        if (w & 7) != 0 {
            a = text_an((&setbase.d_reason[0 as usize]) as u64, a,
                msg.get((&k_g_t_acht[0 as usize]) as u64))
        }
        return
    }
    if why == 2 {
        a = text_an((&setbase.d_reason[0 as usize]) as u64, 0,
            msg.get((&k_g_t_vram[0 as usize]) as u64))
        a = num_at((&setbase.d_reason[0 as usize]) as u64, a, num)
        a = text_an((&setbase.d_reason[0 as usize]) as u64, a,
            msg.get((&k_g_t_von[0 as usize]) as u64))
        let _c: u64 = num_at((&setbase.d_reason[0 as usize]) as u64, a,
            dget(DG_VRAM))
        return
    }
    if why == 3 {
        a = text_an((&setbase.d_reason[0 as usize]) as u64, 0,
            msg.get((&k_g_t_lim[0 as usize]) as u64))
        a = num_at((&setbase.d_reason[0 as usize]) as u64, a, num)
        a = text_an((&setbase.d_reason[0 as usize]) as u64, a,
            msg.get((&k_g_t_von[0 as usize]) as u64))
        a = num_at((&setbase.d_reason[0 as usize]) as u64, a, dget(DG_MAPLIMIT))
        let _d: u64 = text_an((&setbase.d_reason[0 as usize]) as u64, a,
            msg.get((&k_g_t_kach[0 as usize]) as u64))
        return
    }
    if why == 4 {
        a = text_an((&setbase.d_reason[0 as usize]) as u64, 0,
            msg.get((&k_g_t_dep[0 as usize]) as u64))
        a = num_at((&setbase.d_reason[0 as usize]) as u64, a, num)
        let _e: u64 = text_an((&setbase.d_reason[0 as usize]) as u64, a,
            msg.get((&k_g_t_bit[0 as usize]) as u64))
        return
    }
    if why == 5 {
        a = text_an((&setbase.d_reason[0 as usize]) as u64, 0,
            msg.get((&k_g_t_range[0 as usize]) as u64))
        a = num_at((&setbase.d_reason[0 as usize]) as u64, a, num)
        a = text_an((&setbase.d_reason[0 as usize]) as u64, a,
            msg.get((&k_g_t_empty[0 as usize]) as u64))
        a = num_at((&setbase.d_reason[0 as usize]) as u64, a, dget(DG_MINW))
        a = text_an((&setbase.d_reason[0 as usize]) as u64, a,
            msg.get((&k_g_t_bis[0 as usize]) as u64))
        let _f: u64 = num_at((&setbase.d_reason[0 as usize]) as u64, a,
            dget(DG_MAXW))
        return
    }
    let _g: u64 = text_an((&setbase.d_reason[0 as usize]) as u64, 0,
        msg.get((&k_g_t_no[0 as usize]) as u64))
}

fn save_read() {
    if dget(DG_SAVEOK) != 1 {
