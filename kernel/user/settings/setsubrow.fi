import fuiscene
import icons

export { ROW_H, paint }

const ROW_H: u64 = 52
const ICON_SIZE: u64 = 20
const ICON_X: u64 = 16
const TEXT_X: u64 = 52
const CHEVRON_SIZE: u64 = 16
const CHEVRON_ROOM: u64 = 36
const CHEVRON_FROM_RIGHT: u64 = 28
const CORNER: u64 = 6
const STATE_HOT: u64 = 2
const STATE_FOCUS: u64 = 8
const TEXT_SIZE: u64 = 14
const TEXT_BASE: u64 = 5

fn paint(x: u64, y: u64, w: u64, h: u64, st: u64, name: u64, glyph: u64) {
    let s: u64 = fuiscene.sp(1)
    fuiscene.cv_round(x, y, w, h, CORNER * s, fuiscene.R_FIELD)
    var ring: u64 = fuiscene.R_BORDER
    if (st & (STATE_HOT | STATE_FOCUS)) != 0 {
        ring = fuiscene.R_ACCENT
    }
    fuiscene.cv_ring(x, y, w, h, CORNER * s, ring)
    var text_x: u64 = ICON_X
    if glyph != 0 {
        let gs: u64 = ICON_SIZE * s
        fuiscene.cv_glyph_role(glyph, x + ICON_X * s, y + (h - gs) / 2, gs, fuiscene.R_TEXT)
        text_x = TEXT_X
    }
    let text_y: u64 = y + h / 2 + TEXT_BASE * s
    let room: u64 = fuiscene.sat_sub(w, (text_x + CHEVRON_ROOM) * s)
    fuiscene.text_role_fit(x + text_x * s, text_y, room, name, TEXT_SIZE * s, false, fuiscene.R_TEXT)
    fuiscene.say_cv_text(x + text_x * s, text_y, fuiscene.R_TEXT, fuiscene.R_FIELD, TEXT_SIZE * s, name)
    let cs: u64 = CHEVRON_SIZE * s
    fuiscene.cv_glyph_role(icons.CHEVRON_RIGHT, x + fuiscene.sat_sub(w, CHEVRON_FROM_RIGHT * s), y + (h - cs) / 2, cs, fuiscene.R_TEXT)
}
