fn tl_bk(ix: u64) -> u64 {
    if ix == 11 || (ix >= 14 && ix <= 16) || ix == 20 || ix == 21 || ix == 23 || ix == 27 || ix == 29 { return 1 }
    return 0
}

fn tl_wd(ix: u64) -> u64 {
    if ix == 13 { return fitw(260) }
    if ix == 27 || ix == 29 { return fitw(140) }
    return 0
}

fn tl_tbl(ix: u64, what: u64) -> u64 {
    if ix == 12 {
        if what == 0 { return 4 }
        if what == 1 { return 214 }
        if what == 2 { return 22 }
        if what == 3 { return (&setbase.c_sys[0 as usize]) as u64 }
    }
    if ix == 19 || ix == 22 {
        if what == 0 { return 6 }
        if what == 1 { return 100 }
        if what == 2 { return 22 }
        if what == 3 {
            if ix == 19 { return (&setbase.c_rules[0 as usize]) as u64 }
            return (&setbase.c_cls[0 as usize]) as u64
        }
    }
    if ix == 30 || ix == 31 {
        if what == 0 { return 4 }
        if what == 1 { return 126 }
        if what == 3 {
            if ix == 30 { return (&setbase.c_nprog[0 as usize]) as u64 }
            return (&setbase.c_nconn[0 as usize]) as u64
        }
    }
    return 0
}

fn pages_all() -> u64 {
    return setbase.R_ANZ + setbase.pkg_n
}

fn key_page(k: u64) -> u64 {
    if k >= setbase.K_TAB0 && k < setbase.K_TAB0 + setbase.R_ANZ {
        return k - setbase.K_TAB0
    }
    if k >= setbase.K_PKGTAB0 && k < setbase.K_PKGTAB0 + setbase.pkg_n {
        return setbase.R_ANZ + k - setbase.K_PKGTAB0
    }
    return setbase.NO_PAGE
}

static mut k_settings_cats: [u8; 14] = "settings.cats\0"

static mut k_settings_seg: [u8; 13] = "settings.seg\0"

static mut k_settings_sw: [u8; 12] = "settings.sw\0"

fn sw_rgb(i: u64) -> u64 {
    if i == 0 {
        return 3108830
    } else if i == 1 {
        return 957095
    } else if i == 2 {
        return 3055195
    } else if i == 3 {
        return 14263296
    } else if i == 4 {
        return 15227148
    } else if i == 5 {
        return 14041157
    } else if i == 6 {
        return 14040223
    }
    return 8146395
}

fn contains_ci(hay: u64, needle: u64) -> bool {
    let nl: u64 = text.length(needle)
    let hl: u64 = text.length(hay)
    if nl == 0 {
        return true
    }
    if nl > hl {
        return false
    }
    var i: u64 = 0
    while i + nl <= hl {
        var j: u64 = 0
        while j < nl && text.lower(regio.read8_at(hay, i + j)) == text.lower(regio.read8_at(needle, j)) {
            j = j + 1
        }
        if j == nl {
            return true
        }
        i = i + 1
    }
    return false
}

fn split_lines(src: u64, dst: u64, slot: u64, n: u64) {
    var t: u64 = 0
    while t < n {
        __mmio_write8((dst + t * slot) as *mut u8, 0 as u8)
        t = t + 1
    }
    t = 0
    var o: u64 = 0
    var q: u64 = 0
    while t < n {
        let c: u64 = regio.read8_at(src, q)
        if c == 0 || c == 10 {
            __mmio_write8((dst + t * slot + o) as *mut u8, 0 as u8)
            t = t + 1
            o = 0
            if c == 0 {
                return
            }
        } else if o + 1 < slot {
            __mmio_write8((dst + t * slot + o) as *mut u8, c as u8)
            o = o + 1
        }
        q = q + 1
    }
}

fn hex_put(dst: u64, v: u64) {
    var i: u64 = 0
    while i < 6 {
        let d: u64 = (v >> ((5 - i) * 4)) & 15
        var ch: u64 = 48 + d
        if d > 9 {
            ch = 87 + d
        }
        __mmio_write8((dst + i) as *mut u8, ch as u8)
        i = i + 1
    }
    __mmio_write8((dst + 6) as *mut u8, 0 as u8)
}

fn shell_texts() {
    split_lines(msg.get((&k_settings_cats[0 as usize]) as u64), (&setbase.cat_buf[0 as usize]) as u64, 40, setbase.NCAT)
    split_lines(msg.get((&k_settings_seg[0 as usize]) as u64), (&setbase.seg_buf[0 as usize]) as u64, 40, 3)
    split_lines(msg.get((&k_settings_sw[0 as usize]) as u64), (&setbase.swn_buf[0 as usize]) as u64, 40, 8)
    var i: u64 = 0
    while i < 8 {
        hex_put(((&setbase.sw_hex[0 as usize]) as u64) + i * 8, sw_rgb(i))
        i = i + 1
    }
}

const RES_MAX: u64 = 12

fn res_group(pg: u64) -> u64 {
    var fi: u64 = 0
    while fi < setroute.flat_count() {
        if setroute.flat_page(fi) == pg {
            if setroute.flat_depth(fi) == 0 {
                return 0
            }
            var j: u64 = fi
            while j > 0 {
                j = j - 1
                if setroute.flat_depth(j) == 0 {
                    return setroute.flat_title(j)
                }
            }
            return 0
        }
        fi = fi + 1
    }
    return 0
}

fn res_put(dst: u64, at: u64, src: u64) -> u64 {
    var o: u64 = at
    var i: u64 = 0
    while regio.read8_at(src, i) != 0 && o < 62 {
        __mmio_write8((dst + o) as *mut u8, regio.read8_at(src, i) as u8)
        o = o + 1
        i = i + 1
    }
    __mmio_write8((dst + o) as *mut u8, 0 as u8)
    return o
}

fn res_has(pg: u64) -> bool {
    var i: u64 = 0
    while i < setbase.res_n {
        if setbase.res_pg[(i) as usize] == pg {
            return true
        }
        i = i + 1
    }
    return false
}

fn res_build() {
    setbase.res_n = 0
    if !setroute.ready() || regio.read8_at((&setbase.e_srch[0 as usize]) as u64, 0) == 0 {
        return
    }
    var sep: [u8; 4] = " - \0"
    var i: u64 = 0
    while i < setroute.hit_raw() && setbase.res_n < RES_MAX {
        let pg: u64 = setroute.hit_page(i)
        if pg != setroute.NONE && pg < setbase.R_ANZ && !res_has(pg) {
            setbase.res_pg[(setbase.res_n) as usize] = pg
            let dst: u64 = ((&setbase.res_buf[0 as usize]) as u64) + setbase.res_n * 64
            var o: u64 = res_put(dst, 0, setroute.page_title(pg))
            let g: u64 = res_group(pg)
            if g != 0 {
                o = res_put(dst, o, (&sep[0 as usize]) as u64)
                let _o2: u64 = res_put(dst, o, g)
            }
            setbase.res_n = setbase.res_n + 1
        }
        i = i + 1
    }
    var s_r: [u8; 21] = "settings: results n=\0"
    var s_t: [u8; 6] = " top=\0"
    var s_p: [u8; 3] = " r\0"
    var s_e: [u8; 2] = "=\0"
    setcore.say((&s_r[0 as usize]) as u64)
    setcore.sayn(setbase.res_n)
    setcore.say((&s_t[0 as usize]) as u64)
    setcore.sayn(setroute.top_page())
    var k: u64 = 0
    while k < setbase.res_n && k < 4 {
        setcore.say((&s_p[0 as usize]) as u64)
        setcore.sayn(k)
        setcore.say((&s_e[0 as usize]) as u64)
        setcore.sayn(setbase.res_pg[(k) as usize])
        k = k + 1
    }
    setcore.nl()
}

fn glass_plate(x: u64, y: u64, w: u64, h: u64, r: u64) {
    fuiscene.cv_round(x, y, w, h, r, fuiscene.R_SURFACE)
    fuiscene.cv_round_a(x, y, w, h, r, 16777215, 46)
    fuiscene.cv_ring(x, y, w, h, r, fuiscene.R_BORDER)

    if w > 2 * r {
        fuiscene.cv_round_a(x + r, y + 1, w - 2 * r, 1, 0, 16777215, 90)
    }
}

fn sat_sub_u(a: u64, b: u64) -> u64 {
    if a < b {
        return 0
    }
    return a - b
}

fn room_of(w: u64, m: u64) -> u64 {
    if w < m {
        return 0
    }
    return w - m
}

fn card_head(card: usize, title: u64, help: u64) {
    let _t: usize = fuiscene.label(card, title)

    if !short_win() {
        let _h: usize = fuiscene.label_muted(card, help)
    }
}

fn short_win() -> bool {
    return fuiscene.height() < 640
}

fn fitw(w: u64) -> u64 {
    if setbase.cw_in == 0 || w <= setbase.cw_in {
        return w
    }
    return setbase.cw_in
}

fn fitn(w: u64, n: u64, gap: u64) -> u64 {
    if setbase.cw_in == 0 {
        return w
    }
    var m: u64 = 0
    if setbase.cw_in > gap * (n - 1) {
        m = (setbase.cw_in - gap * (n - 1)) / n
    }
    if m < 16 {
        m = 16
    }
    if w < m {
        return w
    }
    return m
}

fn slab_w() -> u64 {
    if setbase.cw_in == 0 {
        return 150
    }
    return setbase.cw_in * 2 / 5
}

fn slid_w() -> u64 {
    if setbase.cw_in == 0 {
        return 160
    }
    return setbase.cw_in - setbase.cw_in * 2 / 5 - 6
}

fn first_of(w: u64, rest: u64, gap: u64) -> u64 {
    if setbase.cw_in == 0 || w + rest + gap <= setbase.cw_in {
        return w
    }
    if setbase.cw_in < rest + gap + 60 {
        return 60
    }
    return setbase.cw_in - rest - gap
}
