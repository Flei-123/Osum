    if ix == 3 || ix == 6 || ix == 9 || ix == 12 || ix == 13 || ix == 16 || ix == 20 { return 1 }
    if ix == 23 || ix == 24 || ix == 26 || ix == 27 || ix == 28 { return 1 }
    return 0
}

fn per_wd(ix: u64) -> u64 {
    if ix == 3 || ix == 16 || ix == 20 || ix == 21 { return fitw(140) }
    if ix == 6 || ix == 9 || ix == 12 || ix == 13 { return fitw(160) }
    if ix == 23 || ix == 24 || ix == 27 { return fitw(150) }
    if ix == 28 { return fitw(260) }
    return 0
}

