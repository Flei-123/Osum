const SYS_AUDGET: u64 = 1850

const SYS_AUDSET: u64 = 1851

const A_READY: u64 = 0

const A_VOLUME: u64 = 4

const A_MUTED: u64 = 21

const A_CAPREADY: u64 = 54

const A_CAPMUTE: u64 = 56

const AS_VOLUME: u64 = 0

const AS_MUTE: u64 = 2

const AS_CAPMUTE: u64 = 16

static mut p_proc_usb: [u8; 10] = "/proc/usb\0"

static mut k_sp_one: [u8; 3] = " \0\0"

static mut k_us_none: [u8; 21] = "settings.usbnet.none\0"

static mut k_us_found: [u8; 22] = "settings.usbnet.found\0"

