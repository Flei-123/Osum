const K_YB: u64 = 29

const K_TNP: u64 = 70

const K_TNC: u64 = 71

fn ls_h() -> u64 {
    if short_win() {
        return 100
    }
    return 118
}

fn usbnet_refresh() {
    var buf: [u8; 1024] = [0 as u8; 1024]
    let n: u64 = setcore.file_read((&p_proc_usb[0 as usize]) as u64, (&buf[0 as usize]) as u64, 1024)
    var lines: u64 = 0
    var k: u64 = 0
    while k < n {
        if buf[(k) as usize] == 10 as u8 {
            lines = lines + 1
        }
        k = k + 1
    }
    if lines == 0 {
        let _t: u64 = setcore.text_an((&setbase.l_ustat[0 as usize]) as u64, 0, msg.get((&k_us_none[0 as usize]) as u64))
    } else {
        var at: u64 = setcore.text_an((&setbase.l_ustat[0 as usize]) as u64, 0, msg.get((&k_us_found[0 as usize]) as u64))
        setbase.l_ustat[(at) as usize] = (48 + lines % 10) as u8
        if lines >= 10 {
            setbase.l_ustat[(at) as usize] = (48 + (lines / 10) % 10) as u8
            setbase.l_ustat[(at + 1) as usize] = (48 + lines % 10) as u8
            at = at + 1
        }
        setbase.l_ustat[(at + 1) as usize] = 0 as u8
    }
}

fn osk_toggle() {
    var s_o: [u8; 20] = "settings: osk tray=\0"
    var s_k: [u8; 5] = " ok=\0"
    setbase.ms_osk = 0
    if (fuiscene.value_of(setbase.K_MS_OSK) as u64) != 0 {
        setbase.ms_osk = 1
    }
    let ok: bool = osktray.set_shown(setbase.ms_osk != 0)
    setcore.say((&s_o[0 as usize]) as u64)
    setcore.sayn(setbase.ms_osk)
    setcore.say((&s_k[0 as usize]) as u64)
    if ok {
        setcore.sayn(1)
    } else {
        setcore.sayn(0)
    }
    setcore.nl()
}

fn sound_load() {
    setbase.sn_da = 0
    setbase.sn_mic_da = 0
    if ulib.sys(SYS_AUDGET, A_READY, 0, 0) == 1 {
        setbase.sn_da = 1
        setbase.sn_vol = ulib.sys(SYS_AUDGET, A_VOLUME, 0, 0)
        setbase.sn_mute = ulib.sys(SYS_AUDGET, A_MUTED, 0, 0)
        if setbase.sn_vol > 100 {
            setbase.sn_vol = 100
        }
    }
    if ulib.sys(SYS_AUDGET, A_CAPREADY, 0, 0) == 1 {
        setbase.sn_mic_da = 1
        setbase.sn_mic_mute = ulib.sys(SYS_AUDGET, A_CAPMUTE, 0, 0)
    }
}

fn sound_say(what: u64, v: u64, rc: u64) {
    var s_sn: [u8; 17] = "settings: sound \0"
    var s_rc: [u8; 5] = " rc=\0"
    var s_v: [u8; 4] = " v=\0"
    setcore.say((&s_sn[0 as usize]) as u64)
    setcore.sayn(what)
    setcore.say((&s_v[0 as usize]) as u64)
    setcore.sayn(v)
    setcore.say((&s_rc[0 as usize]) as u64)
    setcore.sayn(rc)
    setcore.nl()
}

fn sound_slider() {
    let v: u64 = setaccount.slv(setbase.K_SND_VOL, 0, 100)
    let rc: u64 = ulib.sys(SYS_AUDSET, AS_VOLUME, v, 0)
    if v > 0 && setbase.sn_mute != 0 {
        let _m: u64 = ulib.sys(SYS_AUDSET, AS_MUTE, 0, 0)
        setbase.sn_mute = 0
    }
    setbase.sn_vol = v
    sound_say(0, v, rc)
}

fn sound_toggle_mute() {
    var nm: u64 = 0
    if (fuiscene.value_of(setbase.K_SND_MUTE) as u64) != 0 {
        nm = 1
    }
    let rc: u64 = ulib.sys(SYS_AUDSET, AS_MUTE, nm, 0)
    setbase.sn_mute = nm
    sound_say(1, nm, rc)
}

fn sound_toggle_mic() {
    var nm: u64 = 0
    if (fuiscene.value_of(setbase.K_SND_MIC) as u64) != 0 {
        nm = 1
    }
    let rc: u64 = ulib.sys(SYS_AUDSET, AS_CAPMUTE, nm, 0)
    setbase.sn_mic_mute = nm
    sound_say(2, nm, rc)
}

fn sound_bar_cb(x: u64, y: u64, w: u64, h: u64) {
    navview.infobar_paint(x, y, w, h, navview.IB_WARN, msg.get((&k_sn_none[0 as usize]) as u64))
}

fn info_export() -> u64 {
    var t_bin: [u8; 13] = "/bin/sysinfo\0"
    var t_tmp: [u8; 5] = "/tmp\0"
    var t_out: [u8; 23] = "/tmp/osum-report.txt\0\0\0"
    var argv: [u64; 1] = [0 as u64; 1]
    if setaccount.bin_missing((&t_bin[0 as usize]) as u64) {
        return 255
    }
    argv[(0) as usize] = (&t_bin[0 as usize]) as u64
    let _md: u64 = ulib.sys(ulib.SYS_MKDIR, (&t_tmp[0 as usize]) as u64, 448, 0)
    let s1: u64 = ulib.sys(ulib.SYS_DUP, 1, 0, 0)
    let afd: u64 = ulib.sys(ulib.SYS_OPEN, (&t_out[0 as usize]) as u64, ulib.O_MAKE, 384)
    if ulib.bad(afd) {
        if !ulib.bad(s1) {
            ulib.sys(ulib.SYS_CLOSE, s1, 0, 0)
        }
        return 254
    }
    ulib.sys(ulib.SYS_DUP2, afd, 1, 0)
    ulib.sys(ulib.SYS_CLOSE, afd, 0, 0)
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&t_bin[0 as usize]) as u64, (&argv[0 as usize]) as u64, 1)
    if !ulib.bad(s1) {
        ulib.sys(ulib.SYS_DUP2, s1, 1, 0)
        ulib.sys(ulib.SYS_CLOSE, s1, 0, 0)
    }
    if ulib.bad(pid) {
        return 255
    }
    return ulib.wait_code(pid)
}

fn info_size() -> u64 {
    var t_out: [u8; 23] = "/tmp/osum-report.txt\0\0\0"
    var buf: [u8; 4096] = [0 as u8; 4096]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&t_out[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&buf[0 as usize]) as u64, 4095)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) {
        return 0
    }
    return n
}

const AP_MAX: u64 = 16

const AP_CEIL_NONE: u64 = 8192

static mut ap_selname: [u8; 24] = [0 as u8; 24]

static mut ap_name: [u8; 384] = [0 as u8; 384]

static mut ap_mask: [u64; 16] = [0 as u64; 16]

static mut ap_man: [u64; 16] = [0 as u64; 16]

static mut ap_cpu: [u64; 16] = [0 as u64; 16]

static mut ap_wake: [u64; 16] = [0 as u64; 16]

static mut ap_tx: [u64; 16] = [0 as u64; 16]

static mut ap_rx: [u64; 16] = [0 as u64; 16]

static mut ap_data: [u64; 16] = [0 as u64; 16]

static mut ap_cpu_total: u64 = 0

static mut ap_raw: [u8; 2048] = [0 as u8; 2048]

fn ap_name_ptr(k: u64) -> u64 {
    return ((&ap_name[0 as usize]) as u64) + k * 24
}

fn ap_run(path: u64, argv: u64, argc: u64) -> u64 {
    if setaccount.bin_missing(path) {
        return 255
    }
    var t_tmp: [u8; 5] = "/tmp\0"
    var t_out: [u8; 19] = "/tmp/osum-apps.out\0"
    let _md: u64 = ulib.sys(ulib.SYS_MKDIR, (&t_tmp[0 as usize]) as u64, 448, 0)
    let _ul: u64 = ulib.sys(ulib.SYS_UNLINK, (&t_out[0 as usize]) as u64, 0, 0)
    let s1: u64 = ulib.sys(ulib.SYS_DUP, 1, 0, 0)
    let afd: u64 = ulib.sys(ulib.SYS_OPEN, (&t_out[0 as usize]) as u64, ulib.O_MAKE, 384)
    if ulib.bad(afd) {
        if !ulib.bad(s1) {
            ulib.sys(ulib.SYS_CLOSE, s1, 0, 0)
        }
        return 254
    }
    ulib.sys(ulib.SYS_DUP2, afd, 1, 0)
    ulib.sys(ulib.SYS_CLOSE, afd, 0, 0)
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, path, argv, argc)
    if !ulib.bad(s1) {
        ulib.sys(ulib.SYS_DUP2, s1, 1, 0)
        ulib.sys(ulib.SYS_CLOSE, s1, 0, 0)
    }
    if ulib.bad(pid) {
        return 255
    }
    return ulib.wait_code(pid)
}

fn ap_read() -> u64 {
    var t_out: [u8; 19] = "/tmp/osum-apps.out\0"
    let base: u64 = (&ap_raw[0 as usize]) as u64
    __mmio_write8(base as *mut u8, 0 as u8)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&t_out[0 as usize]) as u64, 0, 0)
    if ulib.bad(fd) {
        return 0
    }
    var tot: u64 = 0
    var go: bool = true
    while go && tot < 2040 {
        let n: u64 = ulib.sys(ulib.SYS_READ, fd, base + tot, 2040 - tot)
        if ulib.bad(n) || n == 0 {
            go = false
        } else {
            tot = tot + n
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    __mmio_write8((base + tot) as *mut u8, 0 as u8)
    return tot
}

fn ap_raw_has(pat: u64) -> bool {
    let base: u64 = (&ap_raw[0 as usize]) as u64
    let pl: u64 = text.length(pat)
    var i: u64 = 0
    while regio.read8_at(base, i) != 0 {
        var k: u64 = 0
        while k < pl && regio.read8_at(base, i + k) == regio.read8_at(pat, k) {
            k = k + 1
        }
        if k == pl {
            return true
        }
        i = i + 1
    }
    return false
}

fn ap_set_field(k: u64, f: u64, v: u64) {
    if f == 0 {
        ap_mask[(k) as usize] = v
    } else if f == 1 {
        if v >= AP_CEIL_NONE {
            setbase.ap_ceil[(k) as usize] = 0
            ap_man[(k) as usize] = 0
        } else {
            setbase.ap_ceil[(k) as usize] = v
            ap_man[(k) as usize] = 1
        }
    } else if f == 2 {
        ap_cpu[(k) as usize] = v
    } else if f == 3 {
        ap_wake[(k) as usize] = v
    } else if f == 4 {
        ap_tx[(k) as usize] = v
    } else if f == 5 {
        ap_rx[(k) as usize] = v
    } else {
        ap_data[(k) as usize] = v
    }
}

fn ap_parse_line(base: u64, start: u64, e: u64, k: u64) {
    var p: u64 = start
    var q: u64 = 0
    while p < e && regio.read8_at(base, p) != 32 {
        if q < 19 {
            ap_name[(k * 24 + q) as usize] = regio.read8_at(base, p) as u8
            q = q + 1
        }
        p = p + 1
    }
    ap_name[(k * 24 + q) as usize] = 0 as u8
    var f: u64 = 0
    while f < 7 && p < e {
        while p < e && regio.read8_at(base, p) == 32 {
            p = p + 1
        }
        var v: u64 = 0
        if regio.read8_at(base, p) == 100 {
            v = setcore.num_from(base + p + 5)
        } else {
            v = setcore.num_from(base + p)
        }
        ap_set_field(k, f, v)
        while p < e && regio.read8_at(base, p) != 32 {
            p = p + 1
        }
        f = f + 1
    }
}

fn ap_pct(k: u64) -> u64 {
    if ap_cpu_total == 0 {
        return 0
    }
    return ap_cpu[(k) as usize] * 100 / ap_cpu_total
}

fn ap_fmt_line(k: u64) {
    var s_sep: [u8; 4] = " - \0"
    var s_pc: [u8; 2] = "%\0"
    var s_sl: [u8; 2] = "/\0"
    var s_sp: [u8; 2] = " \0"
    let d: u64 = ((&setbase.ap_line[0 as usize]) as u64) + k * 96
    var a: u64 = setcore.text_an(d, 0, ap_name_ptr(k))
    a = setcore.text_an(d, a, (&s_sep[0 as usize]) as u64)
    a = setcore.text_an(d, a, msg.get((&k_ap_lcpu[0 as usize]) as u64))
    a = setcore.text_an(d, a, (&s_sp[0 as usize]) as u64)
    a = setcore.num_at(d, a, ap_pct(k))
    a = setcore.text_an(d, a, (&s_pc[0 as usize]) as u64)
    a = setcore.text_an(d, a, (&s_sep[0 as usize]) as u64)
    a = setcore.text_an(d, a, msg.get((&k_ap_lnet[0 as usize]) as u64))
    a = setcore.text_an(d, a, (&s_sp[0 as usize]) as u64)
    a = setcore.num_at(d, a, ap_tx[(k) as usize])
    a = setcore.text_an(d, a, (&s_sl[0 as usize]) as u64)
    a = setcore.num_at(d, a, ap_rx[(k) as usize])
}

fn ap_bundle_there(name: u64) -> bool {
    var t_osp: [u8; 5] = ".osp\0"
    var t_prog: [u8; 6] = ".prog\0"
    var path: [u8; 64] = [0 as u8; 64]
    var t_dir: [u8; 7] = "/apps/\0"
    ulib.strcpy((&path[0 as usize]) as u64, (&t_dir[0 as usize]) as u64)
    ulib.strcat((&path[0 as usize]) as u64, name)
    let n: u64 = text.length((&path[0 as usize]) as u64)
    if n > 50 {
        return true
    }
    ulib.strcat((&path[0 as usize]) as u64, (&t_osp[0 as usize]) as u64)
    if ulib.is_dir((&path[0 as usize]) as u64) {
        return true
    }
    __mmio_write8(((&path[0 as usize]) as u64 + n) as *mut u8, 0 as u8)
    ulib.strcat((&path[0 as usize]) as u64, (&t_prog[0 as usize]) as u64)
    return ulib.is_dir((&path[0 as usize]) as u64)
}

fn ap_load() {
    var t_bin: [u8; 15] = "/bin/apprights\0"
    var t_list: [u8; 5] = "list\0"
    var argv: [u64; 2] = [0 as u64; 2]
    argv[(0) as usize] = (&t_bin[0 as usize]) as u64
    argv[(1) as usize] = (&t_list[0 as usize]) as u64
    setbase.ap_n = 0
    ap_cpu_total = 0
    let _rc: u64 = ap_run((&t_bin[0 as usize]) as u64, (&argv[0 as usize]) as u64, 2)
    let n: u64 = ap_read()
    let base: u64 = (&ap_raw[0 as usize]) as u64
    var i: u64 = 0
    while i < n && setbase.ap_n < AP_MAX {
        var e: u64 = i
        while e < n && regio.read8_at(base, e) != 10 {
            e = e + 1
        }
        if e > i + 4 && regio.read8_at(base, i) == 97 && regio.read8_at(base, i + 1) == 112 && regio.read8_at(base, i + 2) == 112 && regio.read8_at(base, i + 3) == 32 {
            ap_parse_line(base, i + 4, e, setbase.ap_n)

            if ap_bundle_there(ap_name_ptr(setbase.ap_n)) {
                ap_cpu_total = ap_cpu_total + ap_cpu[(setbase.ap_n) as usize]
                setbase.ap_n = setbase.ap_n + 1
            }
        }
        i = e + 1
    }
    var k: u64 = 0
    while k < setbase.ap_n {
        ap_fmt_line(k)
        k = k + 1
    }
    if setbase.ap_sel != setbase.AP_NONE {
        var found: u64 = setbase.AP_NONE
        k = 0
        while k < setbase.ap_n {
            if ulib.streq(ap_name_ptr(k), (&ap_selname[0 as usize]) as u64) {
                found = k
            }
            k = k + 1
        }
        setbase.ap_sel = found
        if found == setbase.AP_NONE {
            setbase.ap_arm = 0
        }
    }
}

fn ap_prep_detail(k: u64) {
    var s_sp: [u8; 2] = " \0"
    var s_pc: [u8; 2] = "%\0"
    var s_sl: [u8; 4] = " / \0"
    let b: u64 = (&setbase.ap_txt[0 as usize]) as u64

    let _a0: u64 = setcore.text_an(b, 0, ap_name_ptr(k))

    var a: u64 = setcore.text_an(b + 256, 0, msg.get((&k_ap_lbat[0 as usize]) as u64))
    a = setcore.text_an(b + 256, a, (&s_sp[0 as usize]) as u64)
    a = setcore.num_at(b + 256, a, ap_pct(k))
    a = setcore.text_an(b + 256, a, (&s_pc[0 as usize]) as u64)

    a = setcore.text_an(b + 512, 0, msg.get((&k_ap_lwake[0 as usize]) as u64))
    a = setcore.text_an(b + 512, a, (&s_sp[0 as usize]) as u64)
    a = setcore.num_at(b + 512, a, ap_wake[(k) as usize])

    a = setcore.text_an(b + 768, 0, msg.get((&k_ap_lsent[0 as usize]) as u64))
    a = setcore.text_an(b + 768, a, (&s_sp[0 as usize]) as u64)
    a = setcore.num_at(b + 768, a, ap_tx[(k) as usize])
    a = setcore.text_an(b + 768, a, (&s_sl[0 as usize]) as u64)
    a = setcore.num_at(b + 768, a, ap_rx[(k) as usize])

    if ap_data[(k) as usize] != 0 {
        let _a4: u64 = setcore.text_an(b + 1024, 0, msg.get((&k_ap_data1[0 as usize]) as u64))
    } else {
        let _a4b: u64 = setcore.text_an(b + 1024, 0, msg.get((&k_ap_data0[0 as usize]) as u64))
    }

    if ap_man[(k) as usize] == 0 {
        let _a5: u64 = setcore.text_an(b + 1280, 0, msg.get((&k_ap_noman[0 as usize]) as u64))
    } else {
        a = setcore.text_an(b + 1280, 0, msg.get((&k_ap_nodecl[0 as usize]) as u64))
        var bit: u64 = 0
        while bit < setbase.AP_NRIGHTS {
            if bit != setbase.AP_BIT_NOTIFY && (setbase.ap_ceil[(k) as usize] & (1 << bit)) == 0 {
                a = setcore.text_an(b + 1280, a, (&s_sp[0 as usize]) as u64)
                a = setcore.text_an(b + 1280, a, policy.name_of_bit(1 << bit))
            }
            bit = bit + 1
        }
    }
}

fn ap_toggle_state(k: u64, bit: u64) -> bool {
    return (ap_mask[(k) as usize] & (1 << bit)) != 0
}

fn ap_status(key: u64) {
    let _s: u64 = setcore.text_an((&setbase.l_apstat[0 as usize]) as u64, 0, msg.get(key))
}

fn ap_redraw() {
    fuiscene.refresh()
    setbase.rep_due = 1
}

fn ap_set(k: u64, newmask: u64) {
    var s_set: [u8; 4] = "set\0"
    var t_bin: [u8; 15] = "/bin/apprights\0"
    var s_l1: [u8; 20] = "settings: apps set \0"
    var s_l2: [u8; 7] = " mask=\0"
    var s_l3: [u8; 5] = " rc=\0"
    var s_l4: [u8; 8] = " saved=\0"
    var argv: [u64; 20] = [0 as u64; 20]
    argv[(0) as usize] = (&t_bin[0 as usize]) as u64
    argv[(1) as usize] = (&s_set[0 as usize]) as u64
    argv[(2) as usize] = ap_name_ptr(k)
    var argc: u64 = 3
    var bit: u64 = 0
    while bit < setbase.AP_NRIGHTS {
        if (newmask & (1 << bit)) != 0 && argc < 19 {
            argv[(argc) as usize] = policy.name_of_bit(1 << bit)
            argc = argc + 1
        }
        bit = bit + 1
    }
    let rc: u64 = ap_run((&t_bin[0 as usize]) as u64, (&argv[0 as usize]) as u64, argc)
    let _n: u64 = ap_read()
    var saved: u64 = 1
    var s_ns: [u8; 10] = "not saved\0"
    if ap_raw_has((&s_ns[0 as usize]) as u64) {
        saved = 0
    }
    var name: [u8; 24] = [0 as u8; 24]
    let _c: u64 = setcore.text_an((&name[0 as usize]) as u64, 0, ap_name_ptr(k))
    ap_load()
    var now: u64 = 0
    var j: u64 = 0
    while j < setbase.ap_n {
        if ulib.streq(ap_name_ptr(j), (&name[0 as usize]) as u64) {
            now = ap_mask[(j) as usize]
        }
        j = j + 1
    }
    lineout.add_text((&s_l1[0 as usize]) as u64)
    lineout.add_text((&name[0 as usize]) as u64)
    lineout.add_text((&s_l2[0 as usize]) as u64)
    lineout.add_num(now)
    lineout.add_text((&s_l3[0 as usize]) as u64)
    lineout.add_num(rc)
    lineout.add_text((&s_l4[0 as usize]) as u64)
    lineout.add_num(saved)
    lineout.end_line()
    if now != newmask {
        ap_status((&k_ap_fail[0 as usize]) as u64)
    } else if saved == 0 {
        ap_status((&k_ap_nosave[0 as usize]) as u64)
    } else {
        ap_status((&k_ap_ok[0 as usize]) as u64)
    }
}

fn ap_stop(k: u64) {
    var s_stop: [u8; 5] = "stop\0"
    var t_bin: [u8; 15] = "/bin/apprights\0"
    var s_l1: [u8; 21] = "settings: apps stop \0"
    var s_l2: [u8; 5] = " rc=\0"
    var s_l3: [u8; 9] = " killed=\0"
    var s_w: [u8; 16] = "apprights: stop\0"
    var argv: [u64; 3] = [0 as u64; 3]
    argv[(0) as usize] = (&t_bin[0 as usize]) as u64
    argv[(1) as usize] = (&s_stop[0 as usize]) as u64
    argv[(2) as usize] = ap_name_ptr(k)
    let rc: u64 = ap_run((&t_bin[0 as usize]) as u64, (&argv[0 as usize]) as u64, 3)
    let n: u64 = ap_read()
    var killed: u64 = 0
    if n > 16 {
        killed = setcore.num_from((&ap_raw[0 as usize]) as u64 + 16)
    }
    lineout.add_text((&s_l1[0 as usize]) as u64)
    lineout.add_text(ap_name_ptr(k))
    lineout.add_text((&s_l2[0 as usize]) as u64)
    lineout.add_num(rc)
    lineout.add_text((&s_l3[0 as usize]) as u64)
    lineout.add_num(killed)
    lineout.end_line()
    if rc == 0 {
        ap_status((&k_ap_ok[0 as usize]) as u64)
    } else {
        ap_status((&k_ap_fail[0 as usize]) as u64)
    }
    ap_load()
}

fn ap_uninstall(k: u64) {
    var s_rm: [u8; 7] = "remove\0"
    var t_bin: [u8; 9] = "/bin/opk\0"
    var s_l1: [u8; 26] = "settings: apps uninstall \0"
    var s_l2: [u8; 5] = " rc=\0"
    var argv: [u64; 3] = [0 as u64; 3]
    argv[(0) as usize] = (&t_bin[0 as usize]) as u64
    argv[(1) as usize] = (&s_rm[0 as usize]) as u64
    argv[(2) as usize] = ap_name_ptr(k)
    let rc: u64 = ap_run((&t_bin[0 as usize]) as u64, (&argv[0 as usize]) as u64, 3)
    lineout.add_text((&s_l1[0 as usize]) as u64)
    lineout.add_text(ap_name_ptr(k))
    lineout.add_text((&s_l2[0 as usize]) as u64)
    lineout.add_num(rc)
    lineout.end_line()
    setbase.ap_sel = setbase.AP_NONE
    setbase.ap_arm = 0
    ap_load()
    if rc == 0 {
        ap_status((&k_ap_ok[0 as usize]) as u64)
    } else {
        ap_status((&k_ap_fail[0 as usize]) as u64)
    }
}

fn ap_click(id: u64) {
    var s_op: [u8; 21] = "settings: apps open \0"
    __mmio_write8((&setbase.l_apstat[0 as usize]) as u64 as *mut u8, 0 as u8)
    if id >= setbase.K_AP_LIST0 && id < setbase.K_AP_LIST0 + AP_MAX {
        let pk: u64 = id - setbase.K_AP_LIST0
        if pk < setbase.ap_n {
            setbase.ap_sel = pk
            setbase.ap_arm = 0
            let _c: u64 = setcore.text_an((&ap_selname[0 as usize]) as u64, 0, ap_name_ptr(pk))
            lineout.add_text((&s_op[0 as usize]) as u64)
            lineout.add_text(ap_name_ptr(pk))
            lineout.end_line()
        }
    } else if id == setbase.K_AP_BACK {
        setbase.ap_sel = setbase.AP_NONE
        setbase.ap_arm = 0
        ap_load()
    } else if id == setbase.K_AP_REF {
        ap_load()
    } else if setbase.ap_sel != setbase.AP_NONE && setbase.ap_sel < setbase.ap_n {
        let k: u64 = setbase.ap_sel
        if id >= setbase.K_AP_RIGHT0 && id < setbase.K_AP_RIGHT0 + setbase.AP_NRIGHTS {
            let bit: u64 = id - setbase.K_AP_RIGHT0
            if (setbase.ap_ceil[(k) as usize] & (1 << bit)) == 0 {

                var s_rf: [u8; 24] = "settings: apps refused \0"
                lineout.add_text((&s_rf[0 as usize]) as u64)
                lineout.add_text(ap_name_ptr(k))
                lineout.end_line()
                ap_status((&k_ap_fail[0 as usize]) as u64)
            } else {
                ap_set(k, ap_mask[(k) as usize] ^ (1 << bit))
            }
            setbase.ap_arm = 0
        } else if id == setbase.K_AP_STOP {
            setbase.ap_arm = 0
            ap_stop(k)
        } else if id == setbase.K_AP_UNINST {
            if setbase.ap_arm == 0 {
                setbase.ap_arm = 1
            } else {
                ap_uninstall(k)
            }
        }

    }
    ap_redraw()
}

fn ap_rects() {
    var s_ls: [u8; 23] = "settings: apps list n=\0"
    var s_rw: [u8; 20] = "settings: apps row \0"
    var s_m: [u8; 7] = " mask=\0"
    var s_c: [u8; 7] = " ceil=\0"
    var s_p: [u8; 6] = " cpu=\0"
    var s_d: [u8; 23] = "settings: apps detail \0"
    var s_da: [u8; 7] = " data=\0"
    var s_ar: [u8; 6] = " arm=\0"
    if setbase.ap_sel == setbase.AP_NONE || setbase.ap_sel >= setbase.ap_n {
        lineout.add_text((&s_ls[0 as usize]) as u64)
        lineout.add_num(setbase.ap_n)
        lineout.end_line()
        var ri: u64 = 0
        while ri < setbase.ap_n {
            var nm: [u8; 5] = "apl?\0"
            nm[(3) as usize] = (97 + ri) as u8
            setcore.rect_say((&nm[0 as usize]) as u64, setbase.K_AP_LIST0 + ri)
            lineout.add_text((&s_rw[0 as usize]) as u64)
            lineout.add_text(ap_name_ptr(ri))
            lineout.add_text((&s_m[0 as usize]) as u64)
            lineout.add_num(ap_mask[(ri) as usize])
            lineout.add_text((&s_c[0 as usize]) as u64)
            lineout.add_num(setbase.ap_ceil[(ri) as usize])
            lineout.add_text((&s_p[0 as usize]) as u64)
            lineout.add_num(ap_cpu[(ri) as usize])
            lineout.end_line()
            ri = ri + 1
        }
        var n1: [u8; 5] = "apfr\0"
        setcore.rect_say((&n1[0 as usize]) as u64, setbase.K_AP_REF)
        return
    }
    let k: u64 = setbase.ap_sel
    lineout.add_text((&s_d[0 as usize]) as u64)
    lineout.add_text(ap_name_ptr(k))
    lineout.add_text((&s_m[0 as usize]) as u64)
    lineout.add_num(ap_mask[(k) as usize])
    lineout.add_text((&s_c[0 as usize]) as u64)
    lineout.add_num(setbase.ap_ceil[(k) as usize])
    lineout.add_text((&s_da[0 as usize]) as u64)
    lineout.add_num(ap_data[(k) as usize])
    lineout.add_text((&s_ar[0 as usize]) as u64)
    lineout.add_num(setbase.ap_arm)
    lineout.end_line()
    var bit: u64 = 0
    while bit < setbase.AP_NRIGHTS {
        var nr: [u8; 5] = "apr?\0"
        nr[(3) as usize] = (97 + bit) as u8
        setcore.rect_say((&nr[0 as usize]) as u64, setbase.K_AP_RIGHT0 + bit)
        bit = bit + 1
    }
    var n2: [u8; 5] = "apbk\0"
    var n3: [u8; 5] = "apsp\0"
    var n4: [u8; 5] = "apun\0"
    var n5: [u8; 5] = "apcl\0"
    var n6: [u8; 5] = "apen\0"
    var n7: [u8; 5] = "appa\0"
    setcore.rect_say((&n2[0 as usize]) as u64, setbase.K_AP_BACK)
    setcore.rect_say((&n3[0 as usize]) as u64, setbase.K_AP_STOP)
    setcore.rect_say((&n4[0 as usize]) as u64, setbase.K_AP_UNINST)
    setcore.rect_say((&n5[0 as usize]) as u64, setbase.K_AP_CLEAR)
    setcore.rect_say((&n6[0 as usize]) as u64, setbase.K_AP_ENERGY)
    setcore.rect_say((&n7[0 as usize]) as u64, setbase.K_AP_PAUSE)
}

const AB_NAMES: str = __include_str("../settings.d/accounts.bind")

fn acct_bind(key: u64) -> u64 {
    let m: str = AB_NAMES
    let ix: u64 = manifest.names_index(m.p as u64, m.n as u64, key)
    if ix == manifest.NONE {
        return setbase.AB_NONE
    }
    return ix
}

