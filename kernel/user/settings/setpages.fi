        setcore.rect_say((&q3[0 as usize]) as u64, setbase.nz_b4j)
    }
    if setbase.active_tab == setbase.R_UPDATE {
        var u1: [u8; 7] = "ucheck\0"
        var u2: [u8; 6] = "uinst\0"
        var u3: [u8; 6] = "uchan\0"
