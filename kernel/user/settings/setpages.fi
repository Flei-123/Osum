fn page_man(w: u64, pid: u64, left: usize, right: usize) {
    if !setsystem.man_ready() {
        return
    }
    let pg: u64 = manifest.page_find(pid)
    if pg == manifest.NONE {
        return
    }
    var i: u64 = manifest.page_first(pg)
    let end: u64 = i + manifest.page_len(pg)
    var in_row: bool = false
    var hidden_row: bool = false
    var rowp: usize = 0
    while i < end {
        var parent: usize = left
        if manifest.item_col(i) == 1 {
            parent = right
        }
        let kind: u64 = manifest.item_kind(i)
        let lab: u64 = manifest.item_label(i)
        if kind == manifest.K_ROW {
            hidden_row = !setsystem.man_visible(w, i)
            if !hidden_row {
                rowp = fuiscene.row(parent)
                if manifest.item_num(i) > 0 {
                    fuiscene.set_gap(rowp, manifest.item_num(i))
                }
            }
            in_row = true
        } else if kind == manifest.K_ENDROW {
            in_row = false
            hidden_row = false
        } else if in_row {
            parent = rowp
        }
        if hidden_row || !setsystem.man_visible(w, i) {
            i = i + 1
        } else {
            if kind == manifest.K_LABEL {
                let _n_l: usize = fuiscene.label(parent, msg.get(lab))
            } else if kind == manifest.K_NOTE {
                let _n_w: usize = fuiscene.label_wrap(parent, msg.get(lab), manifest.item_num(i))
            } else if kind == manifest.K_SEP {
                let _n_sp: usize = fuiscene.separator(parent)
            } else if kind == manifest.K_FIELD {
                setsystem.man_field(parent, w, i)
            }
            i = i + 1
        }
    }
}

