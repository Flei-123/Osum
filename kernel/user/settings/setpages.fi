fn report_fui() {
    var s_f: [u8; 18] = "settings: fui ok=\0"
    var s_x: [u8; 5] = " no=\0"
    var s_g: [u8; 8] = " grund=\0"
    var at: u64 = setcore.rs_put(0, (&s_f[0 as usize]) as u64)
    at = setcore.rs_num(at, fuib.fui_painted())
    at = setcore.rs_put(at, (&s_x[0 as usize]) as u64)
    at = setcore.rs_num(at, fuib.fui_rejected())
    at = setcore.rs_put(at, (&s_g[0 as usize]) as u64)
    at = setcore.rs_num(at, fuib.fui_reasons())
    let b: u64 = (&setbase.rs_buf[0 as usize]) as u64
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = lineout.add_bytes(b, at)
}

fn report_elements() {
    var s_n: [u8; 22] = "settings: elemente n=\0"
    var s_m: [u8; 6] = " max=\0"
    var at: u64 = setcore.rs_put(0, (&s_n[0 as usize]) as u64)
    at = setcore.rs_num(at, nid)
    at = setcore.rs_put(at, (&s_m[0 as usize]) as u64)
    at = setcore.rs_num(at, 192)
    let b: u64 = (&setbase.rs_buf[0 as usize]) as u64
    __mmio_write8((b + at) as *mut u8, 10 as u8)
    at = at + 1
    let _w: u64 = lineout.add_bytes(b, at)
}

fn report_state() {
    var s_m: [u8; 24] = "settings: stand reiter=\0"
    var s_g: [u8; 14] = " geschrieben=\0"
    var s_s: [u8; 10] = " schemas=\0"
    var s_t: [u8; 10] = " status=[\0"
    var s_z: [u8; 2] = "]\0"
    setcore.say((&s_m[0 as usize]) as u64)
    setcore.sayn(setbase.active_tab)
    setcore.say((&s_s[0 as usize]) as u64)
    setcore.sayn(setbase.nschema)
    setcore.say((&s_g[0 as usize]) as u64)
    setcore.sayn(setbase.geschrieben)
    setcore.say((&s_t[0 as usize]) as u64)
    setcore.say((&setbase.l_stat[0 as usize]) as u64)
    setcore.say((&s_z[0 as usize]) as u64)

    if setbase.active_tab == setbase.R_ACCOUNT {
        var s_k: [u8; 9] = " konto=[\0"
        var s_b: [u8; 8] = " book=[\0"
        setcore.say((&s_k[0 as usize]) as u64)
        setcore.say((&setbase.l_kstat[0 as usize]) as u64)
        setcore.say((&s_z[0 as usize]) as u64)
        setcore.say((&s_b[0 as usize]) as u64)
        setcore.say((&setbase.l_kbook[0 as usize]) as u64)
        setcore.say((&s_z[0 as usize]) as u64)
    }

    if setbase.active_tab >= setbase.R_ANZ {
        var s_p: [u8; 7] = " pkg=[\0"
        setcore.say((&s_p[0 as usize]) as u64)
        setcore.say((&setbase.pkg_stat[0 as usize]) as u64)
        setcore.say((&s_z[0 as usize]) as u64)
    }
    setcore.nl()
    nav_state_say()
}

fn bus_page(r: u64) {
    if r == setbase.R_APPS {
        setbase.ap_sel = setbase.AP_NONE
        setbase.ap_arm = 0
        __mmio_write8((&setbase.l_apstat[0 as usize]) as u64 as *mut u8, 0 as u8)
        setdevice.ap_load()
    }
    if r == setbase.R_ENERGIE {
        pw_load()
    }
    if r == setbase.R_MOUSE {
        mouse_load()
    }
    if r == setbase.R_SOUND {
        setdevice.sound_load()
    }
    if r == setbase.R_TOUCHPAD {
        tp_load()
    }
    if r == setbase.R_BLUETOOTH {
        let _bl: bool = setbt.load()
    }
    if r == setbase.R_UPDATE {

        __mmio_write8((&setbase.l_systat[0 as usize]) as u64 as *mut u8, 0 as u8)
        upd_show()
    }
    if r == setbase.R_PROTO {
        setaccount.proto_load()
    }
    if r == setbase.R_SYSTEM {
        setsystem.sys_load()
    }
    if r == setbase.R_RECHTE {
        setaccount.rights_load()
    }
}

fn nav_rects() {
    var n_b: [u8; 8] = "navback\0"
    var n_f: [u8; 7] = "navfwd\0"
    var n_c: [u8; 10] = "navcrumb?\0"
    setcore.rect_say((&n_b[0 as usize]) as u64, setbase.K_NAVBACK)
    setcore.rect_say((&n_f[0 as usize]) as u64, setbase.K_NAVFWD)
    var ci: u64 = 0
    while ci < navview.shown_count() {
        n_c[(8) as usize] = (97 + ci) as u8
        setcore.rect_say((&n_c[0 as usize]) as u64, setbase.K_CRUMB0 + ci)
        ci = ci + 1
    }
}

fn bus_rects() {
    nav_rects()

    var k: u64 = 0
    while k < setbase.R_ANZ {
        var nm: [u8; 6] = "tab??\0"
        if k < 26 {
            nm[(3) as usize] = (97 + k) as u8
            nm[(4) as usize] = 0 as u8
        } else {
            nm[(3) as usize] = (48 + k / 10) as u8
            nm[(4) as usize] = (48 + k % 10) as u8
        }
        let tn: usize = fuiscene.node_of_key(setbase.K_TAB0 + k)
        if tn == fuiscene.NONE || !side_tab_hidden(tn) {
            setcore.rect_say((&nm[0 as usize]) as u64, setbase.K_TAB0 + k)
        }
        k = k + 1
    }

    var pk: u64 = 0
    while pk < setbase.pkg_n && pk < 8 {
        var pn: [u8; 7] = "ptab?\0\0"
        pn[(4) as usize] = (97 + pk) as u8
        setcore.rect_say((&pn[0 as usize]) as u64, setbase.K_PKGTAB0 + pk)
        pk = pk + 1
    }
    if setbase.active_tab >= setbase.R_ANZ && setbase.active_tab - setbase.R_ANZ < setbase.pkg_n {
        let pg0: u64 = setbase.pkg_pg[(setbase.active_tab - setbase.R_ANZ) as usize]
        let f0: u64 = manifest.page_first(pg0)
        var pi: u64 = f0
        while pi < f0 + manifest.page_len(pg0) && pi - f0 < 80 {
            if fuiscene.node_of_key(setbase.K_PKGF0 + pi) != fuiscene.NONE {
                var pfn: [u8; 5] = "pf??\0"
                pfn[(2) as usize] = (97 + (pi / 26) % 26) as u8
                pfn[(3) as usize] = (97 + pi % 26) as u8
                setcore.rect_say((&pfn[0 as usize]) as u64, setbase.K_PKGF0 + pi)
            }
            pi = pi + 1
        }
    }
    if setbase.active_tab == setbase.R_SYSTEM {
        var n1: [u8; 5] = "stab\0"
        var n2: [u8; 5] = "sent\0"
        var n3: [u8; 5] = "sset\0"
        var n4: [u8; 6] = "sconf\0"
        var n5: [u8; 6] = "sundo\0"
        setcore.rect_say((&n1[0 as usize]) as u64, setbase.sy_tab)
        setcore.rect_say((&n2[0 as usize]) as u64, setbase.sy_ent)
        setcore.rect_say((&n3[0 as usize]) as u64, setbase.sy_bset)
        setcore.rect_say((&n4[0 as usize]) as u64, setbase.sy_bconf)
        setcore.rect_say((&n5[0 as usize]) as u64, setbase.sy_bundo)
        var s_rh: [u8; 16] = "settings: rowh=\0"
        let _p: u64 = lineout.add_bytes((&s_rh[0 as usize]) as u64, 15)
        lineout.add_num(fuiscene.table_row_h(setbase.sy_tab))
        lineout.end_line()
    }
    if setbase.active_tab == setbase.R_ENERGIE {
        var e1: [u8; 6] = "plidb\0"
        var e2: [u8; 6] = "plida\0"
        var e3: [u8; 6] = "pscrb\0"
        var e4: [u8; 6] = "pscra\0"
        var e5: [u8; 6] = "psbyb\0"
        var e6: [u8; 6] = "psbya\0"
        var e7: [u8; 7] = "pprofb\0"
        var e8: [u8; 7] = "pprofa\0"
        setcore.rect_say((&e1[0 as usize]) as u64, setbase.K_PW_LB)
        setcore.rect_say((&e2[0 as usize]) as u64, setbase.K_PW_LA)
        setcore.rect_say((&e3[0 as usize]) as u64, setbase.K_PW_SB)
        setcore.rect_say((&e4[0 as usize]) as u64, setbase.K_PW_SA)
        setcore.rect_say((&e5[0 as usize]) as u64, setbase.K_PW_YB)
        setcore.rect_say((&e6[0 as usize]) as u64, setbase.K_PW_YA)
        setcore.rect_say((&e7[0 as usize]) as u64, setbase.K_PW_PB)
        setcore.rect_say((&e8[0 as usize]) as u64, setbase.K_PW_PA)
    }
    if setbase.active_tab == setbase.R_APPS {
        setdevice.ap_rects()
    }
    if setbase.active_tab == setbase.R_INFO {
        var i1: [u8; 6] = "ibexp\0"
        setcore.rect_say((&i1[0 as usize]) as u64, setbase.K_IN_BEXP)
    }
    if setbase.active_tab == setbase.R_MOUSE {
        var m1: [u8; 7] = "mspeed\0"
        var m2: [u8; 7] = "maccel\0"
        var m3: [u8; 5] = "mnat\0"
        var m4: [u8; 5] = "mges\0"
        var m5: [u8; 5] = "mfps\0"
        var m6: [u8; 5] = "mmon\0"
        var m7: [u8; 5] = "mosk\0"
        var m8: [u8; 5] = "mpgd\0"
        setcore.rect_say((&m1[0 as usize]) as u64, setbase.K_MS_SPD)
        setcore.rect_say((&m2[0 as usize]) as u64, setbase.K_MS_ACC)
        setcore.rect_say((&m3[0 as usize]) as u64, setbase.K_MS_NAT)
        setcore.rect_say((&m4[0 as usize]) as u64, setbase.K_MS_GES)
        setcore.rect_say((&m5[0 as usize]) as u64, setbase.K_MS_FPS)
        setcore.rect_say((&m6[0 as usize]) as u64, setbase.K_MS_MON)
        setcore.rect_say((&m7[0 as usize]) as u64, setbase.K_MS_OSK)
        setcore.rect_say((&m8[0 as usize]) as u64, setbase.K_MS_PG)
    }
    if setbase.active_tab == setbase.R_SOUND {
        var sd1: [u8; 5] = "svol\0"
        var sd2: [u8; 6] = "smute\0"
        var sd3: [u8; 5] = "smic\0"
        setcore.rect_say((&sd1[0 as usize]) as u64, setbase.K_SND_VOL)
        setcore.rect_say((&sd2[0 as usize]) as u64, setbase.K_SND_MUTE)
        setcore.rect_say((&sd3[0 as usize]) as u64, setbase.K_SND_MIC)
    }
    if setbase.active_tab == setbase.R_BLUETOOTH {
        var bt1: [u8; 6] = "btpwr\0"
        var bt2: [u8; 7] = "btscan\0"
        setcore.rect_say((&bt1[0 as usize]) as u64, setbt.K_POWER)
        setcore.rect_say((&bt2[0 as usize]) as u64, setbt.K_SCAN)
    }
    if setbase.active_tab == setbase.R_TOUCHPAD {
        var t1: [u8; 6] = "tptap\0"
        var t2: [u8; 7] = "tptap2\0"
        var t3: [u8; 7] = "tpdrag\0"
        var t4: [u8; 9] = "tpcorner\0"
        var t5: [u8; 6] = "tpnat\0"
        var t6: [u8; 9] = "tpscroll\0"
        var t7: [u8; 6] = "tpmom\0"
        var t8: [u8; 8] = "tppinch\0"
        var t9: [u8; 6] = "tpspd\0"
        var ta: [u8; 6] = "tpsw3\0"
        var tb: [u8; 6] = "tpsw4\0"
        var tc: [u8; 6] = "tptyp\0"
        var td: [u8; 5] = "tpon\0"
        setcore.rect_say((&t1[0 as usize]) as u64, setbase.K_TP_TAP)
        setcore.rect_say((&t2[0 as usize]) as u64, K_TP_TAP2)
        setcore.rect_say((&t3[0 as usize]) as u64, K_TP_DRAG)
        setcore.rect_say((&t4[0 as usize]) as u64, K_TP_CORNER)
        setcore.rect_say((&t5[0 as usize]) as u64, K_TP_NAT)
        setcore.rect_say((&t6[0 as usize]) as u64, K_TP_SCROLL)
        setcore.rect_say((&t7[0 as usize]) as u64, K_TP_MOM)
        setcore.rect_say((&t8[0 as usize]) as u64, K_TP_PINCH)
        setcore.rect_say((&t9[0 as usize]) as u64, setbase.K_TP_SPD)
        setcore.rect_say((&ta[0 as usize]) as u64, K_TP_SW3)
        setcore.rect_say((&tb[0 as usize]) as u64, K_TP_SW4)
        setcore.rect_say((&tc[0 as usize]) as u64, K_TP_TYP)
        setcore.rect_say((&td[0 as usize]) as u64, setbase.K_TP_ON)
    }
    if setbase.active_tab == setbase.R_ACCOUNT {

        var o1: [u8; 5] = "kdev\0"
        var o2: [u8; 6] = "kbook\0"
        setcore.rect_say((&o1[0 as usize]) as u64, setbase.K_BKDEV)
        setcore.rect_say((&o2[0 as usize]) as u64, setbase.K_BKBOOK)
    }
    if setbase.active_tab == setbase.R_SCREEN {
        var d1: [u8; 8] = "dbright\0"
        var d2: [u8; 7] = "dapply\0"
        setcore.rect_say((&d1[0 as usize]) as u64, setbase.ds_ch)
        setcore.rect_say((&d2[0 as usize]) as u64, setbase.ds_b2)
    }
    if setbase.active_tab == setbase.R_NET {
        var q1: [u8; 6] = "nmode\0"
        var q2: [u8; 7] = "napply\0"
        var q3: [u8; 6] = "nconf\0"
        setcore.rect_say((&q1[0 as usize]) as u64, setbase.nz_cn)
