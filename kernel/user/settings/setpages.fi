static mut pkg_dsp: [u8; 8000] = [0 as u8; 8000]

static mut pkg_empty: [u8; 2] = [0 as u8; 2]

fn page_pkg(left: usize, right: usize, n: u64) {
    if n >= setbase.pkg_n {
        return
    }
    let pg: u64 = setbase.pkg_pg[(n) as usize]
    let first: u64 = manifest.page_first(pg)
    let end: u64 = first + manifest.page_len(pg)
    var i: u64 = first
    var bools: u64 = 0
    while i < end && i - first < 80 {
        var parent: usize = left
        if manifest.item_col(i) == 1 {
            parent = right
        }
        let kind: u64 = manifest.item_kind(i)
        let lab: u64 = manifest.item_label(i)
        let slot: u64 = i - first
        let id: u64 = setbase.K_PKGF0 + i
        if kind == manifest.K_LABEL {
            let _nl: usize = fuiscene.label(parent, msg.get(lab))
        } else if kind == manifest.K_NOTE {
            let _nw: usize = fuiscene.label_wrap(parent, msg.get(lab), manifest.item_num(i))
        } else if kind == manifest.K_FIELD {
            let ty: u64 = manifest.item_type(i)
            var ltxt: u64 = (&pkg_empty[0 as usize]) as u64
            if lab != 0 {
                ltxt = msg.get(lab)
            }
            if ty == manifest.T_BOOL {
                if bools < 16 {
                    var on: bool = false
                    if setbase.pkg_val[(slot) as usize] != 0 {
                        on = true
                    }
                    let _nb: usize = fuiscene.toggle(parent, ltxt, id, on)
                    bools = bools + 1
                }
            } else if ty == manifest.T_ACTION {
                let n_b: usize = fuiscene.button(parent, ltxt, id)
                fuiscene.button_fit(n_b, ltxt, setdevice.fitw(160))
            } else if ty == manifest.T_STATUS {
                let dp: u64 = ((&pkg_dsp[0 as usize]) as u64) + slot * 100
                var o: u64 = setaccount.bx_put(dp, 0, 100, ltxt)
                if regio.read8_at(((&setbase.pkg_txt[0 as usize]) as u64) + slot * 64, 0) != 0 {
                    var t_cs: [u8; 3] = ": \0"
                    o = setaccount.bx_put(dp, o, 100, (&t_cs[0 as usize]) as u64)
                    let _o3: u64 = setaccount.bx_put(dp, o, 100, ((&setbase.pkg_txt[0 as usize]) as u64) + slot * 64)
                }
                let _ns: usize = fuiscene.label(parent, dp)
            } else if ty == manifest.T_TEXT || ty == manifest.T_SECRET {
                if lab != 0 {
                    let _ne: usize = fuiscene.label(parent, ltxt)
                }
                let n_e: usize = fuiscene.entry(parent, id, 0, ((&setbase.pkg_txt[0 as usize]) as u64) + slot * 64)
                fuiscene.set_size(n_e, 0, 28)
                if ty == manifest.T_SECRET {
                    fuiscene.entry_secret(id, true)
                }
            }
        }
        i = i + 1
    }
    if regio.read8_at((&setbase.pkg_stat[0 as usize]) as u64, 0) != 0 {
        let _nt: usize = fuiscene.label_muted(left, (&setbase.pkg_stat[0 as usize]) as u64)
    }
}

static mut nav_crumbs: u64 = 0

const SF_HOT: u64 = 2

const SF_FOCUS: u64 = 8

static mut k_settings_p_mode: [u8; 16] = "settings.p.mode\0"

static mut k_settings_p_mode2: [u8; 17] = "settings.p.mode2\0"

static mut k_settings_p_acc: [u8; 15] = "settings.p.acc\0"

static mut k_settings_p_acc2: [u8; 16] = "settings.p.acc2\0"

static mut k_settings_sw_custom: [u8; 19] = "settings.sw.custom\0"

static mut k_settings_hue: [u8; 13] = "settings.hue\0"

static mut k_settings_sat: [u8; 13] = "settings.sat\0"

static mut k_settings_val: [u8; 13] = "settings.val\0"

static mut k_settings_p_wp: [u8; 14] = "settings.p.wp\0"

static mut k_settings_p_wp2: [u8; 15] = "settings.p.wp2\0"

static mut k_settings_p_wp3: [u8; 15] = "settings.p.wp3\0"

static mut kwkey: [u8; 16] = "settings.kw\0\0\0\0\0"

static mut srch_word: [u8; 48] = [0 as u8; 48]

fn page_name(p: u64) -> u64 {
    return ((&setbase.tab_buf[0 as usize]) as u64) + p * 40
}

fn page_matches(p: u64) -> bool {
    let q: u64 = (&setbase.e_srch[0 as usize]) as u64
    if regio.read8_at(q, 0) == 0 {
        return true
    }
    if p < setbase.R_ANZ && setroute.ready() {
        return setroute.page_shown(p)
    }

    let kb: u64 = (&kwkey[0 as usize]) as u64
    if p >= 30 {
        __mmio_write8((kb + 11) as *mut u8, 51 as u8)
        __mmio_write8((kb + 12) as *mut u8, (48 + (p - 30)) as u8)
        __mmio_write8((kb + 13) as *mut u8, 0 as u8)
    } else if p >= 20 {
        __mmio_write8((kb + 11) as *mut u8, 50 as u8)
        __mmio_write8((kb + 12) as *mut u8, (48 + (p - 20)) as u8)
        __mmio_write8((kb + 13) as *mut u8, 0 as u8)
    } else if p >= 10 {
        __mmio_write8((kb + 11) as *mut u8, 49 as u8)
        __mmio_write8((kb + 12) as *mut u8, (48 + (p - 10)) as u8)
        __mmio_write8((kb + 13) as *mut u8, 0 as u8)
    } else {
        __mmio_write8((kb + 11) as *mut u8, (48 + p) as u8)
        __mmio_write8((kb + 12) as *mut u8, 0 as u8)
    }
    var kw: u64 = (&pkg_empty[0 as usize]) as u64
    if p < setbase.R_ANZ {
        kw = msg.get(kb)
    }
    let wb: u64 = (&srch_word[0 as usize]) as u64
    var i: u64 = 0
    while regio.read8_at(q, i) != 0 {
        while regio.read8_at(q, i) == 32 {
            i = i + 1
        }
        var n: u64 = 0
        while regio.read8_at(q, i) != 0 && regio.read8_at(q, i) != 32 && n + 1 < 48 {
            __mmio_write8((wb + n) as *mut u8, regio.read8_at(q, i) as u8)
            n = n + 1
            i = i + 1
        }
        __mmio_write8((wb + n) as *mut u8, 0 as u8)
        if n > 0 {
            if !setdevice.contains_ci(page_name(p), wb) && !setdevice.contains_ci(setsystem.cat_name(setsystem.cat_of(p)), wb)
                && !setdevice.contains_ci(kw, wb) {
                return false
            }
        }
    }
    return true
}

fn side_results(lst: usize, item_h: u64) {
    var i: u64 = 0
    while i < setbase.res_n {
        let ln: u64 = ((&setbase.res_buf[0 as usize]) as u64) + i * 64
        let _t: usize = navview.side_item(lst, setsystem.tab_key(setbase.res_pg[(i) as usize]), ln, item_h, 512 + i, tile_cb)
        i = i + 1
    }
}

fn nav_compute() {
    setbase.nav_n = 0
    let _qp: u64 = setroute.query_pages((&setbase.e_srch[0 as usize]) as u64)
    setdevice.res_build()
    var i: u64 = 0
    while i < setdevice.pages_all() {
        if page_matches(i) {
            setbase.nav_vis[(i) as usize] = 1
            setbase.nav_n = setbase.nav_n + 1
        } else {
            setbase.nav_vis[(i) as usize] = 0
        }
        i = i + 1
    }
}

fn nav_step(cur: u64, down: bool) -> u64 {
    var order: [u64; 32] = [0 as u64; 32]
    var n: u64 = 0
    var fo: u64 = 0
    while setroute.ready() && fo < setroute.flat_count() {
        let fp: u64 = setroute.flat_page(fo)
        if fp != setroute.NONE && setbase.nav_vis[(fp) as usize] != 0 && n < 32 {
            order[(n) as usize] = fp
            n = n + 1
        }
        fo = fo + 1
    }
    var c: u64 = 0
    while c < setbase.NCAT + 1 {
        var p: u64 = 0
        while p < setdevice.pages_all() {
            if setsystem.cat_of(p) == c && setbase.nav_vis[(p) as usize] != 0 && (p >= setbase.R_ANZ || !setroute.ready()) && n < 32 {
                order[(n) as usize] = p
                n = n + 1
            }
            p = p + 1
        }
        c = c + 1
    }
    var at: u64 = n
    var k: u64 = 0
    while k < n {
        if order[(k) as usize] == cur {
            at = k
        }
        k = k + 1
    }
    if n == 0 {
        return cur
    }
    if at == n {
        if down {
            return order[0 as usize]
        }
        return order[(n - 1) as usize]
    }
    if down && at + 1 < n {
        return order[(at + 1) as usize]
    }
    if !down && at > 0 {
        return order[(at - 1) as usize]
    }
    return cur
}

fn tile_cb(ud: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    let kind: u64 = ud / 256
    let arg: u64 = ud % 256
    let s: u64 = fuiscene.sp(1)
    if kind == 1 {

        let pgn: u64 = arg % 64
        var tname: u64 = setroute.page_title(pgn)
        if tname == 0 {
            tname = page_name(pgn)
        }
        navview.item_paint(x, y, w, h, st, tname, pgn == setbase.active_tab, arg / 64)
    } else if kind == 3 {

        let d: u64 = w
        if setbase.sw_sel == arg {
            fuiscene.cv_ring_rgb(x, y, d, d, d / 2, 2 * s, 8355711)
            fuiscene.cv_ring(x, y, d, d, d / 2, fuiscene.R_TEXT)
        }
        fuiscene.cv_round_rgb(x + 4 * s, y + 4 * s, d - 8 * s, d - 8 * s, (d - 8 * s) / 2, setdevice.sw_rgb(arg))
        if (st & SF_FOCUS) != 0 {
            fuiscene.cv_ring(x - 1, y - 1, d + 2, d + 2, d / 2 + 1, fuiscene.R_ACCENT)
        }
        if (st & SF_HOT) != 0 && setbase.sw_sel != arg {
            fuiscene.cv_ring(x + 2 * s, y + 2 * s, d - 4 * s, d - 4 * s, d / 2, fuiscene.R_BORDER)
        }
    } else if kind == 5 {
        let d: u64 = 22 * s
        var cur: u64 = hsv.to_rgb(setbase.acc_h, setbase.acc_s, setbase.acc_v)
        fuiscene.cv_round_rgb(x + 8 * s, y + (h - d) / 2, d, d, d / 2, cur)
        if setbase.sw_sel == 8 {
            fuiscene.cv_ring(x + 8 * s - 2 * s, y + (h - d) / 2 - 2 * s, d + 4 * s, d + 4 * s, d / 2 + 2 * s, fuiscene.R_TEXT)
        }
        fuiscene.text_role(x + 40 * s, y + h / 2 + 5 * s, setdevice.room_of(w, 48 * s), msg.get((&k_settings_sw_custom[0 as usize]) as u64), 14 * s, false, fuiscene.R_TEXT)
        if (st & SF_FOCUS) != 0 {
            fuiscene.cv_ring(x, y, w, h, 6 * s, fuiscene.R_ACCENT)
        }
    } else if kind == 2 {

        let rp: u64 = setbase.res_pg[(arg % 12) as usize]
        navview.item_paint(x, y, w, h, st, ((&setbase.res_buf[0 as usize]) as u64) + (arg % 12) * 64, rp == setbase.active_tab, 0)
    } else if kind == 4 {

        fuiscene.cv_round_rgb(x, y, w, h, 8 * s, 797789)
        fuiscene.cv_round_a(x, y, w, h / 2, 8 * s, 6732799, 90)
        fuiscene.cv_round_a(x, y + h - 34 * s, w, 32 * s, 8 * s, 331845, 215)
        fuiscene.cv_ring(x, y, w, h, 8 * s, fuiscene.R_ACCENT)
        fuiscene.cv_ring(x + 1, y + 1, w - 2, h - 2, 8 * s, fuiscene.R_ACCENT)
        fuiscene.text_role(x + 8 * s, y + h - 8 * s, w - 12 * s, msg.get((&k_settings_p_wp3[0 as usize]) as u64), 12 * s, true, fuiscene.R_ONFILL)
    }
}

const NAV_W: u64 = 640

fn nav_mode() -> bool {
    return fuiscene.width() < NAV_W
}

fn nav_list_only() -> bool {
    return nav_mode() && !setbase.nav_detail
}

fn nav_page_only() -> bool {
    return nav_mode() && setbase.nav_detail
}

fn page_scrolls() -> bool {
    return nav_mode() || fuiscene.height() < 500
}

fn side_w() -> u64 {
    if nav_list_only() {
        return fuiscene.width() - 16
    }
    if fuiscene.width() >= 900 {
        return setbase.SIDE_W
    }
    if fuiscene.width() < 700 {
        return 132
    }
    return 190
}

fn personal_mode(left: usize) {
    setdevice.card_head(left, msg.get((&k_settings_p_mode[0 as usize]) as u64), msg.get((&k_settings_p_mode2[0 as usize]) as u64))
    let _seg: usize = fuiscene.segmented(left, setbase.K_SEG0, (&setbase.seg_buf[0 as usize]) as u64, 40, 3, setbase.kval[(setbase.K_CM) as usize], setdevice.fitn(92, 3, 2))
    if setbase.cw_in != 0 {
        fuiscene.set_gap(_seg, 2)
    }
}

fn personal_accent(left: usize) {
    setdevice.card_head(left, msg.get((&k_settings_p_acc[0 as usize]) as u64), msg.get((&k_settings_p_acc2[0 as usize]) as u64))
    let rw: usize = fuiscene.row(left)
    fuiscene.set_gap(rw, 4)
    var j: u64 = 0
    while j < 8 {
        let _w: usize = fuiscene.ftile_quiet(rw, setbase.K_SW0 + j, ((&setbase.swn_buf[0 as usize]) as u64) + j * 40, setdevice.fitn(30, 8, 4), setdevice.fitn(30, 8, 4), 768 + j, tile_cb)
        j = j + 1
    }
    let _c: usize = fuiscene.ftile_left_nb(left, setbase.K_ACCC, msg.get((&k_settings_sw_custom[0 as usize]) as u64), 0, 36, 1280, tile_cb)
    if setbase.acc_open {
        setsystem.accent_slider_row(left, msg.get((&k_settings_hue[0 as usize]) as u64), setbase.K_HUE, 0, 359, setbase.acc_h)
        setsystem.accent_slider_row(left, msg.get((&k_settings_sat[0 as usize]) as u64), setbase.K_SATU, 0, 100, setbase.acc_s)
        setsystem.accent_slider_row(left, msg.get((&k_settings_val[0 as usize]) as u64), setbase.K_VALU, 0, 100, setbase.acc_v)
    }
}

fn personal_wall(right: usize) {
    setdevice.card_head(right, msg.get((&k_settings_p_wp[0 as usize]) as u64), msg.get((&k_settings_p_wp2[0 as usize]) as u64))
    let rt: usize = fuiscene.row(right)

    var wp_h: u64 = 84
    if setdevice.short_win() {
        wp_h = 40
    }
    let _t: usize = fuiscene.ftile_quiet(rt, setbase.K_WP0, msg.get((&k_settings_p_wp3[0 as usize]) as u64), setdevice.fitw(150), wp_h, 1024, tile_cb)
}

fn side_tab_hidden(n: usize) -> bool {
    if !setbase.side_scroll {
        return false
    }
    return fuiscene.pane_hides(1, n)
}

fn side_n() -> u64 {
    if !setroute.ready() || setbase.res_n > 0 {
        return setbase.nav_n
    }
    let ar: u64 = setside.root_of(setbase.active_tab)
    var n: u64 = 0
    var fi: u64 = 0
    while fi < setroute.flat_count() {
        let pg: u64 = setroute.flat_page(fi)
        if pg != setroute.NONE && setbase.nav_vis[(pg) as usize] != 0 && setside.child_shown(fi, ar) {
            n = n + 1
        }
        fi = fi + 1
    }
    return n
}

fn side_fit(item_h: u64, compact: bool) -> u64 {
    let sn: u64 = side_n()
    setbase.side_scroll = false
    var heads: u64 = 0
    var c: u64 = 0
    while c < setbase.NCAT + 1 {
        var p: u64 = 0
        var any: bool = false
        while p < setdevice.pages_all() {
            if setsystem.cat_of(p) == c && setbase.nav_vis[(p) as usize] != 0 && (p >= setbase.R_ANZ || !setroute.ready()) {
                any = true
            }
            p = p + 1
        }
        if any {
            heads = heads + 1
        }
        c = c + 1
    }
    var fg: u64 = 0
    while setroute.ready() && fg < setroute.flat_count() {
        if setroute.flat_page(fg) == setroute.NONE && setroute.group_shown(fg) {
            heads = heads + 1
        }
        fg = fg + 1
    }
    if sn == 0 {
        return item_h
    }
    var gap: u64 = 2
    if compact {
        gap = 0
    }

    let used: u64 = 108 + heads * 20
    let h: u64 = fuiscene.height()
    if h <= used + sn * 18 {
        setbase.side_scroll = true
        return 24
    }
    let fit: u64 = (h - used) / sn - gap
    if fit < item_h {
        if fit < 18 {
            setbase.side_scroll = true
            return 24
        }
        return fit
    }
    return item_h
}

fn side_routes(lst: usize, item_h: u64) {
    if !setroute.ready() {
        return
    }
    let ar: u64 = setside.root_of(setbase.active_tab)
    var fi: u64 = 0
    while fi < setroute.flat_count() {
        let pg: u64 = setroute.flat_page(fi)
        if pg == setroute.NONE {
            if setroute.group_shown(fi) {
                let _g: usize = navview.side_group(lst, setroute.flat_title(fi))
            }
        } else if setbase.nav_vis[(pg) as usize] != 0 && (setbase.res_n > 0 || setside.child_shown(fi, ar)) {
            let sub: u64 = setroute.flat_depth(fi)
            let _t: usize = navview.side_item(lst, setsystem.tab_key(pg), setroute.flat_title(fi), item_h, 256 + pg + 64 * sub, tile_cb)
        }
        fi = fi + 1
    }
}

fn nav_header(main: usize) {
    let hr: usize = fuiscene.row(main)
    fuiscene.set_gap(hr, 12)
    fuiscene.set_size(hr, 0, 52)
    let _tb: usize = navview.toolbar(hr)
    nav_crumbs = navview.crumbs_row(hr, setroute.current_uri(), setroute.current_uri_len())
}

fn nav_act(act: u64, key: u64) {
    var pg: u64 = setroute.NONE
    if act == navview.ACT_BACK {
        pg = setroute.go_back()
    } else if act == navview.ACT_FORWARD {
        pg = setroute.go_forward()
    } else if act == navview.ACT_UP {
        pg = setroute.go_up()
    } else if act == navview.ACT_CRUMB {
        pg = setroute.open_uri(setroute.current_uri(), navview.crumb_target_len(key))
    } else if act == navview.ACT_RELATED {
        pg = setroute.open_uri(navview.related_uri(key), navview.related_uri_len(key))
    }
    if pg != setroute.NONE && pg != setbase.active_tab {
        bus_page(pg)
        setsystem.show_tab(pg)
    } else {
        fuiscene.refresh()
    }
    setbase.rep_due = 1
}

fn nav_state_say() {
    if !setroute.ready() {
        return
    }
    setcore.say(setroute.state_line(nav_crumbs))
    setcore.nl()
    var s_c: [u8; 25] = "settings: controls page=\0"
    var s_n: [u8; 4] = " n=\0"
    setcore.say((&s_c[0 as usize]) as u64)
    setcore.sayn(setbase.ctl_pg)
    setcore.say((&s_n[0 as usize]) as u64)
    setcore.sayn(setbase.ctl_n)
    setcore.nl()
}
