static mut ms_speed: u64 = 100

static mut ms_accel: u64 = 0

static mut ms_nat: u64 = 0

static mut ms_ges: u64 = 0

static mut ms_fps: u64 = 0

static mut ms_mon: u64 = 0

static mut ms_pg: u64 = 0

static mut ms_conf: [u8; 16] = "/etc/mouse.conf\0"

static mut ms_buf: [u8; 192] = [0 as u8; 192]

fn mouse_clamp() {
    if ms_speed < 10 {
        ms_speed = 10
    }
    if ms_speed > 400 {
        ms_speed = 400
    }
    if ms_accel > 5 {
        ms_accel = 5
    }
    if ms_nat > 1 {
        ms_nat = 1
    }
    if ms_ges > 1 {
        ms_ges = 1
    }
    if ms_fps > 1 {
        ms_fps = 1
    }
    if ms_mon > 1 {
        ms_mon = 1
    }
    if ms_pg > 1 {
        ms_pg = 1
    }
}

fn mouse_file_num(key: u64, def: u64) -> u64 {
    let at: u64 = ulib.find((&ms_buf[0 as usize]) as u64, key)
    if at == 0xFFFFFFFFFFFFFFFF {
        return def
    }
    return ulib.to_num(((&ms_buf[0 as usize]) as u64) + at + text.length(key))
}

fn mouse_toggle_pg() {
    if (fuiscene.value_of(setbase.K_MS_PG) as u64) != 0 {
        ms_pg = 1
    } else {
        ms_pg = 0
    }
    mouse_store(6)
}

fn mouse_load() {
    var k_speed: [u8; 7] = "speed=\0"
    var k_accel: [u8; 7] = "accel=\0"
    var k_nat: [u8; 9] = "natural=\0"
    var k_ges: [u8; 10] = "gestures=\0"
    var k_fps: [u8; 5] = "fps=\0"
    var k_mon: [u8; 5] = "mon=\0"
    var k_pg: [u8; 12] = "pixelguard=\0"
    var t_true: [u8; 5] = "true\0"
    ms_speed = 100
    ms_accel = 0
    ms_nat = 0
    ms_ges = 0
    ms_fps = 0
    ms_mon = 0
    ms_pg = 0
    let fd: u64 = io.open((&ms_conf[0 as usize]) as u64, 0)
    if !ulib.bad(fd) {
        let n: u64 = io.read(fd, (&ms_buf[0 as usize]) as u64, 180)
        io.close(fd)
        if !ulib.bad(n) && n > 0 {
            __mmio_write8((((&ms_buf[0 as usize]) as u64) + n) as *mut u8, 0 as u8)
            ms_speed = mouse_file_num((&k_speed[0 as usize]) as u64, 100)
            ms_accel = mouse_file_num((&k_accel[0 as usize]) as u64, 0)
            let at: u64 = ulib.find((&ms_buf[0 as usize]) as u64, (&k_nat[0 as usize]) as u64)
            if at != 0xFFFFFFFFFFFFFFFF {
                let v: u64 = ((&ms_buf[0 as usize]) as u64) + at + 8
                if regio.read8_at(v, 0) == 116 || regio.read8_at(v, 0) == 49 {
                    ms_nat = 1
                }
            }
            let ag: u64 = ulib.find((&ms_buf[0 as usize]) as u64, (&k_ges[0 as usize]) as u64)
            if ag != 0xFFFFFFFFFFFFFFFF {
                let vg: u64 = ((&ms_buf[0 as usize]) as u64) + ag + 9
                if regio.read8_at(vg, 0) == 116 || regio.read8_at(vg, 0) == 49 {
                    ms_ges = 1
                }
            }
            let af: u64 = ulib.find((&ms_buf[0 as usize]) as u64, (&k_fps[0 as usize]) as u64)
            if af != 0xFFFFFFFFFFFFFFFF {
                let vf: u64 = ((&ms_buf[0 as usize]) as u64) + af + 4
                if regio.read8_at(vf, 0) == 116 || regio.read8_at(vf, 0) == 49 {
                    ms_fps = 1
                }
            }
            let am: u64 = ulib.find((&ms_buf[0 as usize]) as u64, (&k_mon[0 as usize]) as u64)
            if am != 0xFFFFFFFFFFFFFFFF {
                let vm: u64 = ((&ms_buf[0 as usize]) as u64) + am + 4
                if regio.read8_at(vm, 0) == 116 || regio.read8_at(vm, 0) == 49 {
                    ms_mon = 1
                }
            }
            let aq: u64 = ulib.find((&ms_buf[0 as usize]) as u64, (&k_pg[0 as usize]) as u64)
            if aq != 0xFFFFFFFFFFFFFFFF {
                let vq: u64 = ((&ms_buf[0 as usize]) as u64) + aq + 11
                if regio.read8_at(vq, 0) == 116 || regio.read8_at(vq, 0) == 49 {
                    ms_pg = 1
                }
            }
        }
    }
    mouse_clamp()
}

fn mouse_file_write() -> bool {
    var h: [u8; 48] = "# /etc/mouse.conf -- written by settings\nspeed=\0"
    var a: [u8; 8] = "\naccel=\0"
    var n0: [u8; 16] = "\nnatural=false\n\0"
    var n1: [u8; 15] = "\nnatural=true\n\0"
    var g0: [u8; 16] = "gestures=false\n\0"
    var g1: [u8; 15] = "gestures=true\n\0"
    var f0: [u8; 11] = "fps=false\n\0"
    var f1: [u8; 10] = "fps=true\n\0"
    var o0: [u8; 11] = "mon=false\n\0"
    var o1: [u8; 10] = "mon=true\n\0"
    var q0: [u8; 18] = "pixelguard=false\n\0"
    var q1: [u8; 17] = "pixelguard=true\n\0"
    var z: [u8; 24] = [0 as u8; 24]
    let b: u64 = (&ms_buf[0 as usize]) as u64
    ulib.strcpy(b, (&h[0 as usize]) as u64)
    var d: u64 = text.digits(ms_speed, (&z[0 as usize]) as u64, true)
    z[(d) as usize] = 0 as u8
    ulib.strcat(b, (&z[0 as usize]) as u64)
    ulib.strcat(b, (&a[0 as usize]) as u64)
    d = text.digits(ms_accel, (&z[0 as usize]) as u64, true)
    z[(d) as usize] = 0 as u8
    ulib.strcat(b, (&z[0 as usize]) as u64)
    if ms_nat != 0 {
        ulib.strcat(b, (&n1[0 as usize]) as u64)
    } else {
        ulib.strcat(b, (&n0[0 as usize]) as u64)
    }
    if ms_ges != 0 {
        ulib.strcat(b, (&g1[0 as usize]) as u64)
    } else {
        ulib.strcat(b, (&g0[0 as usize]) as u64)
    }
    if ms_fps != 0 {
        ulib.strcat(b, (&f1[0 as usize]) as u64)
    } else {
        ulib.strcat(b, (&f0[0 as usize]) as u64)
    }
    if ms_mon != 0 {
        ulib.strcat(b, (&o1[0 as usize]) as u64)
    } else {
        ulib.strcat(b, (&o0[0 as usize]) as u64)
    }
    if ms_pg != 0 {
        ulib.strcat(b, (&q1[0 as usize]) as u64)
    } else {
        ulib.strcat(b, (&q0[0 as usize]) as u64)
    }
    let fd: u64 = io.create((&ms_conf[0 as usize]) as u64)
    if ulib.bad(fd) {
        return false
    }
    let len: u64 = text.length(b)
    let g: u64 = io.write_all(fd, b, len)
    io.close(fd)
    return !ulib.bad(g) && g >= len
}

fn mouse_bus_set(key: u64, value: u64) -> bool {
    var v_set: [u8; 18] = "call settings.set\0"
    var k_key: [u8; 4] = "key\0"
    var k_val: [u8; 6] = "value\0"
    var z: [u8; 24] = [0 as u8; 24]
    if !actcli.open() {
        return false
    }
    let n: u64 = text.digits(value, (&z[0 as usize]) as u64, true)
    z[(n) as usize] = 0 as u8
    actcli.req((&v_set[0 as usize]) as u64)
    actcli.arg((&k_key[0 as usize]) as u64, key)
    actcli.arg((&k_val[0 as usize]) as u64, (&z[0 as usize]) as u64)
    return actcli.send(300) == actcli.R_OK
}

fn mouse_say_state(ok: bool) {
    var s_ms: [u8; 23] = "settings: mouse speed=\0"
    var s_ac: [u8; 8] = " accel=\0"
    var s_na: [u8; 10] = " natural=\0"
    var s_ok: [u8; 5] = " ok=\0"
    var s_ge: [u8; 11] = " gestures=\0"
    var s_fp: [u8; 6] = " fps=\0"
    var s_mo: [u8; 6] = " mon=\0"
    var s_pq: [u8; 5] = " pg=\0"
    setcore.say((&s_ms[0 as usize]) as u64)
    setcore.sayn(ms_speed)
    setcore.say((&s_ac[0 as usize]) as u64)
    setcore.sayn(ms_accel)
    setcore.say((&s_na[0 as usize]) as u64)
    setcore.sayn(ms_nat)
    setcore.say((&s_ge[0 as usize]) as u64)
    setcore.sayn(ms_ges)
    setcore.say((&s_ok[0 as usize]) as u64)
    if ok {
        setcore.sayn(1)
    } else {
        setcore.sayn(0)
    }
    setcore.say((&s_fp[0 as usize]) as u64)
    setcore.sayn(ms_fps)
    setcore.say((&s_mo[0 as usize]) as u64)
    setcore.sayn(ms_mon)
    setcore.say((&s_pq[0 as usize]) as u64)
    setcore.sayn(ms_pg)
    setcore.nl()
}

fn mouse_status(ok: bool) {
    if ok {
        let _a: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_ms_saved[0 as usize]) as u64))
    } else {
        let _b: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_ms_nobus[0 as usize]) as u64))
    }
}

fn mouse_store(which: u64) {
    var k_speed: [u8; 12] = "mouse.speed\0"
    var k_accel: [u8; 12] = "mouse.accel\0"
    var k_nat: [u8; 14] = "mouse.natural\0"
    var k_ges: [u8; 15] = "mouse.gestures\0"
    var k_fps: [u8; 10] = "debug.fps\0"
    var k_mon: [u8; 10] = "debug.mon\0"
    var k_pg: [u8; 17] = "debug.pixelguard\0"
    var ok: bool = false
    if which == 0 {
        ok = mouse_bus_set((&k_speed[0 as usize]) as u64, ms_speed)
    } else if which == 1 {
        ok = mouse_bus_set((&k_accel[0 as usize]) as u64, ms_accel)
    } else if which == 2 {
        ok = mouse_bus_set((&k_nat[0 as usize]) as u64, ms_nat)
    } else if which == 3 {
        ok = mouse_bus_set((&k_ges[0 as usize]) as u64, ms_ges)
    } else if which == 4 {
        ok = mouse_bus_set((&k_fps[0 as usize]) as u64, ms_fps)
    } else if which == 5 {
        ok = mouse_bus_set((&k_mon[0 as usize]) as u64, ms_mon)
    } else {
        ok = mouse_bus_set((&k_pg[0 as usize]) as u64, ms_pg)
    }
    if !ok {
        ok = mouse_file_write()
    }
    mouse_status(ok)
    mouse_say_state(ok)
    report_state()
}

fn mouse_slider(id: u64) {
    if id == setbase.K_MS_SPD {
        ms_speed = setaccount.slv(setbase.K_MS_SPD, 10, 400)
        mouse_clamp()
        mouse_store(0)
    } else {
        ms_accel = setaccount.slv(setbase.K_MS_ACC, 0, 5)
        mouse_clamp()
        mouse_store(1)
    }
}

fn mouse_toggle() {
    if (fuiscene.value_of(setbase.K_MS_NAT) as u64) != 0 {
        ms_nat = 1
    } else {
        ms_nat = 0
    }
    mouse_store(2)
}

fn mouse_toggle_ges() {
    if (fuiscene.value_of(setbase.K_MS_GES) as u64) != 0 {
        ms_ges = 1
    } else {
        ms_ges = 0
    }
    mouse_store(3)
}

fn mouse_toggle_fps() {
    if (fuiscene.value_of(setbase.K_MS_FPS) as u64) != 0 {
        ms_fps = 1
    } else {
        ms_fps = 0
    }
    mouse_store(4)
}

fn mouse_toggle_mon() {
    if (fuiscene.value_of(setbase.K_MS_MON) as u64) != 0 {
        ms_mon = 1
    } else {
        ms_mon = 0
    }
    mouse_store(5)
}

fn page_mouse(left: usize, right: usize) {
    setbase.ms_osk = 0
    if osktray.shown() {
        setbase.ms_osk = 1
    }

    let _n_ms2: usize = fuiscene.label(left, msg.get((&k_ms_note[0 as usize]) as u64))
    let r_spd: usize = fuiscene.row(left)
    let l_spd: usize = fuiscene.label(r_spd, msg.get((&k_ms_speed[0 as usize]) as u64))
    fuiscene.set_size(l_spd, setdevice.fitw(150), 0)
    let _n_spd: usize = fuiscene.slider(r_spd, setbase.K_MS_SPD, 200, setaccount.slv_init(setbase.K_MS_SPD, 10, 400, ms_speed))
    fuiscene.slider_readout(setbase.K_MS_SPD, 10, 400, true)
    let r_acc: usize = fuiscene.row(left)
    let l_acc: usize = fuiscene.label(r_acc, msg.get((&k_ms_accel[0 as usize]) as u64))
    fuiscene.set_size(l_acc, setdevice.fitw(150), 0)
    let _n_acc: usize = fuiscene.slider(r_acc, setbase.K_MS_ACC, 200, setaccount.slv_init(setbase.K_MS_ACC, 0, 5, ms_accel))
    fuiscene.slider_readout(setbase.K_MS_ACC, 0, 5, false)
    let _n_nat: usize = fuiscene.toggle(left, msg.get((&k_ms_nat[0 as usize]) as u64), setbase.K_MS_NAT, (ms_nat != 0))
    let _n_ges: usize = fuiscene.toggle(left, msg.get((&k_ms_ges[0 as usize]) as u64), setbase.K_MS_GES, (ms_ges != 0))
    let _n_fps: usize = fuiscene.toggle(left, msg.get((&k_ms_fps[0 as usize]) as u64), setbase.K_MS_FPS, (ms_fps != 0))
    let _n_mon: usize = fuiscene.toggle(left, msg.get((&k_ms_mon[0 as usize]) as u64), setbase.K_MS_MON, (ms_mon != 0))
    let _n_pg: usize = fuiscene.toggle(left, msg.get((&k_ms_pg[0 as usize]) as u64), setbase.K_MS_PG, (ms_pg != 0))
    let _n_osk: usize = fuiscene.toggle(left, msg.get((&k_ms_osk[0 as usize]) as u64), setbase.K_MS_OSK, (setbase.ms_osk != 0))
}

fn page_bluetooth(left: usize, right: usize) {
    var s_bt0: [u8; 20] = "settings: bluetooth\0"
    setcore.say((&s_bt0[0 as usize]) as u64)
    setcore.nl()
    setbt.page(left)
}

fn page_sound(left: usize, right: usize) {
    if setbase.sn_da == 0 {
        var s_sn0: [u8; 21] = "settings: sound none\0"
        setcore.say((&s_sn0[0 as usize]) as u64)
        setcore.nl()
        let _n_sn0: usize = navview.infobar(left, K_SND_BAR, 40, setdevice.sound_bar_cb)
        return
    }
    let _n_sn1: usize = fuiscene.label(left, msg.get((&k_sn_note[0 as usize]) as u64))
    let r_vol: usize = fuiscene.row(left)
    let l_vol: usize = fuiscene.label(r_vol, msg.get((&k_sn_vol[0 as usize]) as u64))
    fuiscene.set_size(l_vol, setdevice.fitw(150), 0)
    let _n_vol: usize = fuiscene.slider(r_vol, setbase.K_SND_VOL, 200, setaccount.slv_init(setbase.K_SND_VOL, 0, 100, setbase.sn_vol))
    fuiscene.slider_readout(setbase.K_SND_VOL, 0, 100, true)
    let _n_mute: usize = fuiscene.toggle(left, msg.get((&k_sn_mute[0 as usize]) as u64), setbase.K_SND_MUTE, (setbase.sn_mute != 0))
    if setbase.sn_mic_da != 0 {
        let _n_mic: usize = fuiscene.toggle(left, msg.get((&k_sn_mic[0 as usize]) as u64), setbase.K_SND_MIC, (setbase.sn_mic_mute != 0))
    } else {
        let _n_nomic: usize = fuiscene.label(left, msg.get((&k_sn_nomic[0 as usize]) as u64))
    }
}

const TP_N: u64 = 13

static mut tp_v: [u64; 13] = [1, 1, 1, 1, 0, 1, 1, 1, 100, 1, 1, 1, 1]

static mut tp_fk: [u8; 119] = "\ntap=\0\ntap2=\0\ndrag=\0\ncorner=\0\nnatural=\0\nscroll=\0\nmomentum=\0\npinch=\0\nscrollspeed=\0\nswipe3=\0\nswipe4=\0\ntyping=\0\nenabled=\0\0"

static mut tp_bk: [u8; 210] = "touchpad.tap\0touchpad.tap2\0touchpad.drag\0touchpad.corner\0touchpad.natural\0touchpad.scroll\0touchpad.momentum\0touchpad.pinch\0touchpad.scrollspeed\0touchpad.swipe3\0touchpad.swipe4\0touchpad.typing\0touchpad.enabled\0\0"

static mut tp_conf: [u8; 19] = "/etc/touchpad.conf\0"

static mut tp_buf: [u8; 320] = [0 as u8; 320]

fn tp_nth(base: u64, n: u64) -> u64 {
    var p: u64 = base
    var i: u64 = 0
    while i < n {
        while regio.read8_at(p, 0) != 0 {
            p = p + 1
        }
        p = p + 1
        i = i + 1
    }
    return p
}

fn tp_numeric(i: u64) -> bool {
    return i >= 8 && i <= 10
}

fn tp_clamp() {
    var i: u64 = 0
    while i < 8 {
        if tp_v[(i) as usize] > 1 {
            tp_v[(i) as usize] = 1
        }
        i = i + 1
    }
    if tp_v[11] > 1 {
        tp_v[11] = 1
    }
    if tp_v[12] > 1 {
        tp_v[12] = 1
    }
    if tp_v[8] < 10 {
        tp_v[8] = 10
    }
    if tp_v[8] > 500 {
        tp_v[8] = 500
    }
    if tp_v[9] > 2 {
        tp_v[9] = 2
    }
    if tp_v[10] > 2 {
        tp_v[10] = 2
    }
}

fn tp_load() {
    var i: u64 = 0

    while i < TP_N {
        tp_v[(i) as usize] = 1
        i = i + 1
    }
    tp_v[3] = 1
    tp_v[4] = 0
    tp_v[8] = 100
    let b: u64 = (&tp_buf[0 as usize]) as u64
    let fd: u64 = io.open((&tp_conf[0 as usize]) as u64, 0)
    if !ulib.bad(fd) {

        __mmio_write8(b as *mut u8, 10 as u8)
        let n: u64 = io.read(fd, b + 1, 300)
        io.close(fd)
        if !ulib.bad(n) && n > 0 {
            __mmio_write8((b + 1 + n) as *mut u8, 0 as u8)
            i = 0
            while i < TP_N {
                let at: u64 = ulib.find(b, tp_nth((&tp_fk[0 as usize]) as u64, i))
                if at != 0xFFFFFFFFFFFFFFFF {
                    let v: u64 = b + at + text.length(tp_nth((&tp_fk[0 as usize]) as u64, i))
                    if tp_numeric(i) {
                        tp_v[(i) as usize] = ulib.to_num(v)
                    } else if regio.read8_at(v, 0) == 116 || regio.read8_at(v, 0) == 49 {
                        tp_v[(i) as usize] = 1
                    } else {
                        tp_v[(i) as usize] = 0
                    }
                }
                i = i + 1
            }
        }
    }
    tp_clamp()
}

fn tp_file_write() -> bool {
    var h: [u8; 45] = "# /etc/touchpad.conf -- written by settings\n\0"
    var t1: [u8; 6] = "true\n\0"
    var t0: [u8; 7] = "false\n\0"
    var nl1: [u8; 2] = "\n\0"
    var z: [u8; 24] = [0 as u8; 24]
    let b: u64 = (&tp_buf[0 as usize]) as u64
    ulib.strcpy(b, (&h[0 as usize]) as u64)
    var i: u64 = 0
    while i < TP_N {

        ulib.strcat(b, tp_nth((&tp_fk[0 as usize]) as u64, i) + 1)
        if tp_numeric(i) {
            let d: u64 = text.digits(tp_v[(i) as usize], (&z[0 as usize]) as u64, true)
            z[(d) as usize] = 0 as u8
            ulib.strcat(b, (&z[0 as usize]) as u64)
            ulib.strcat(b, (&nl1[0 as usize]) as u64)
        } else if tp_v[(i) as usize] != 0 {
            ulib.strcat(b, (&t1[0 as usize]) as u64)
        } else {
            ulib.strcat(b, (&t0[0 as usize]) as u64)
        }
        i = i + 1
    }
    let fd: u64 = io.create((&tp_conf[0 as usize]) as u64)
    if ulib.bad(fd) {
        return false
    }
    let len: u64 = text.length(b)
    let g: u64 = io.write_all(fd, b, len)
    io.close(fd)
    return !ulib.bad(g) && g >= len
}

fn tp_say_state(i: u64, ok: bool) {
    var s_tp: [u8; 20] = "settings: touchpad \0"
    var s_i: [u8; 4] = " i=\0"
    var s_ok: [u8; 5] = " ok=\0"
    setcore.say((&s_tp[0 as usize]) as u64)
    var j: u64 = 0
    while j < TP_N {
        setcore.sayn(tp_v[(j) as usize])
        if j + 1 < TP_N {
            var sp: [u8; 2] = ",\0"
            setcore.say((&sp[0 as usize]) as u64)
        }
        j = j + 1
    }
    setcore.say((&s_i[0 as usize]) as u64)
    setcore.sayn(i)
    setcore.say((&s_ok[0 as usize]) as u64)
    if ok {
        setcore.sayn(1)
    } else {
        setcore.sayn(0)
    }
    setcore.nl()
}

fn tp_status(ok: bool) {
    if ok {
        let _a: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_tp_saved[0 as usize]) as u64))
    } else {
        let _b: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_tp_nobus[0 as usize]) as u64))
    }
}

fn tp_store(i: u64) {
    var ok: bool = mouse_bus_set(tp_nth((&tp_bk[0 as usize]) as u64, i), tp_v[(i) as usize])
    if !ok {
        ok = tp_file_write()
    }
    tp_status(ok)
    tp_say_state(i, ok)
    report_state()
}

fn tp_index(id: u64) -> u64 {
    if id == setbase.K_TP_TAP { return 0 }
    if id == K_TP_TAP2 { return 1 }
    if id == K_TP_DRAG { return 2 }
    if id == K_TP_CORNER { return 3 }
    if id == K_TP_NAT { return 4 }
    if id == K_TP_SCROLL { return 5 }
    if id == K_TP_MOM { return 6 }
    if id == K_TP_PINCH { return 7 }
    if id == K_TP_SW3 { return 9 }
    if id == K_TP_TYP { return 11 }
    if id == setbase.K_TP_ON { return 12 }
    return 10
}

fn tp_toggle(id: u64) {
    let i: u64 = tp_index(id)
    if (fuiscene.value_of(id) as u64) != 0 {
        tp_v[(i) as usize] = 1
    } else {
        tp_v[(i) as usize] = 0
    }
    tp_store(i)
}

fn tp_slider() {
    tp_v[8] = setaccount.slv(setbase.K_TP_SPD, 10, 500)
    tp_clamp()
    tp_store(8)
}

fn page_touchpad(left: usize, right: usize) {
    let _n_tp: usize = fuiscene.label(left, msg.get((&k_tp_note[0 as usize]) as u64))
    let _n_on: usize = fuiscene.toggle(left, msg.get((&k_tp_on[0 as usize]) as u64), setbase.K_TP_ON, (tp_v[12] != 0))
    let _n_tap: usize = fuiscene.toggle(left, msg.get((&k_tp_tap[0 as usize]) as u64), setbase.K_TP_TAP, (tp_v[0] != 0))
    let _n_tap2: usize = fuiscene.toggle(left, msg.get((&k_tp_tap2[0 as usize]) as u64), K_TP_TAP2, (tp_v[1] != 0))
    let _n_drag: usize = fuiscene.toggle(left, msg.get((&k_tp_drag[0 as usize]) as u64), K_TP_DRAG, (tp_v[2] != 0))
    let _n_cor: usize = fuiscene.toggle(left, msg.get((&k_tp_corner[0 as usize]) as u64), K_TP_CORNER, (tp_v[3] != 0))
    let _n_nat: usize = fuiscene.toggle(left, msg.get((&k_tp_nat[0 as usize]) as u64), K_TP_NAT, (tp_v[4] != 0))
    let _n_scr: usize = fuiscene.toggle(left, msg.get((&k_tp_scroll[0 as usize]) as u64), K_TP_SCROLL, (tp_v[5] != 0))
    let r_spd: usize = fuiscene.row(left)
    let l_spd: usize = fuiscene.label(r_spd, msg.get((&k_tp_speed[0 as usize]) as u64))
    fuiscene.set_size(l_spd, setdevice.fitw(150), 0)
    let _n_spd: usize = fuiscene.slider(r_spd, setbase.K_TP_SPD, 200, setaccount.slv_init(setbase.K_TP_SPD, 10, 500, tp_v[8]))
    fuiscene.slider_readout(setbase.K_TP_SPD, 10, 500, true)
    let _n_mom: usize = fuiscene.toggle(left, msg.get((&k_tp_mom[0 as usize]) as u64), K_TP_MOM, (tp_v[6] != 0))
    let _n_pin: usize = fuiscene.toggle(left, msg.get((&k_tp_pinch[0 as usize]) as u64), K_TP_PINCH, (tp_v[7] != 0))
    let _n_sw3: usize = fuiscene.toggle(left, msg.get((&k_tp_sw3[0 as usize]) as u64), K_TP_SW3, (tp_v[9] != 0))
    let _n_sw4: usize = fuiscene.toggle(left, msg.get((&k_tp_sw4[0 as usize]) as u64), K_TP_SW4, (tp_v[10] != 0))
    let _n_typ: usize = fuiscene.toggle(left, msg.get((&k_tp_typing[0 as usize]) as u64), K_TP_TYP, (tp_v[11] != 0))
}

static mut pw_lid: [u64; 2] = [0 as u64; 2]

static mut pw_prof: [u64; 2] = [0 as u64; 2]

static mut pw_scr: [u64; 2] = [0 as u64; 2]

static mut pw_sby: [u64; 2] = [0 as u64; 2]

static mut pw_bri: [u64; 2] = [101 as u64; 2]

static mut pw_conf: [u8; 16] = "/etc/power.conf\0"

static mut pw_buf: [u8; 512] = [0 as u8; 512]

fn pw_val(key: u64) -> u64 {
    let at: u64 = ulib.find((&pw_buf[0 as usize]) as u64, key)
    if at == 0xFFFFFFFFFFFFFFFF {
        return 0
    }
    return ((&pw_buf[0 as usize]) as u64) + at + text.length(key)
}

fn pw_num(key: u64, def: u64) -> u64 {
    let v: u64 = pw_val(key)
    if v == 0 {
        return def
    }
    let c: u64 = regio.read8_at(v, 0)
    if c < 48 || c > 57 {
        return def
    }
    return ulib.to_num(v)
}

fn pw_lid_idx(key: u64, def: u64) -> u64 {
    let v: u64 = pw_val(key)
    if v == 0 {
        return def
    }
    let c: u64 = regio.read8_at(v, 0)
    if c == 115 {
        if regio.read8_at(v, 1) == 104 {
            return 3
        }
        return 0
    }
    if c == 104 {
        return 1
    }
    if c == 110 {
        return 2
    }
    return def
}

fn pw_prof_idx(key: u64, def: u64) -> u64 {
    let v: u64 = pw_val(key)
    if v == 0 {
        return def
    }
    let c: u64 = regio.read8_at(v, 0)
    if c == 115 {
        return 0
    }
    if c == 98 {
        return 1
    }
    if c == 112 {
        return 2
    }
    return def
}

fn pw_clamp() {
    var i: u64 = 0
    while i < 2 {
        if pw_lid[(i) as usize] > 3 {
            pw_lid[(i) as usize] = 0
        }
        if pw_prof[(i) as usize] > 2 {
            pw_prof[(i) as usize] = 1
        }
        if pw_scr[(i) as usize] > 60 {
            pw_scr[(i) as usize] = 60
        }
        if pw_sby[(i) as usize] > 240 {
            pw_sby[(i) as usize] = 240
        }
        i = i + 1
    }
}

fn pw_sync_kval() {
    setbase.kval[(setbase.K_PW_LB) as usize] = pw_lid[0]
    setbase.kval[(setbase.K_PW_LA) as usize] = pw_lid[1]
    setbase.kval[(setbase.K_PW_PB) as usize] = pw_prof[0]
    setbase.kval[(setbase.K_PW_PA) as usize] = pw_prof[1]
}

fn pw_load() {
    var a: [u8; 9] = "lid_bat=\0"
    var b: [u8; 8] = "lid_ac=\0"
    var c: [u8; 12] = "screen_bat=\0"
    var d: [u8; 11] = "screen_ac=\0"
    var e: [u8; 13] = "standby_bat=\0"
    var f: [u8; 12] = "standby_ac=\0"
    var g: [u8; 13] = "profile_bat=\0"
    var h: [u8; 12] = "profile_ac=\0"
    var i: [u8; 12] = "bright_bat=\0"
    var j: [u8; 11] = "bright_ac=\0"
    pw_buf[0] = 0 as u8
    let fd: u64 = io.open((&pw_conf[0 as usize]) as u64, 0)
    if !ulib.bad(fd) {
        let n: u64 = io.read(fd, (&pw_buf[0 as usize]) as u64, 500)
        io.close(fd)
        if !ulib.bad(n) && n > 0 {
            __mmio_write8((((&pw_buf[0 as usize]) as u64) + n) as *mut u8, 0 as u8)
        }
    }
    pw_lid[0] = pw_lid_idx((&a[0 as usize]) as u64, 0)
    pw_lid[1] = pw_lid_idx((&b[0 as usize]) as u64, 0)
    pw_scr[0] = pw_num((&c[0 as usize]) as u64, 300) / 60
    pw_scr[1] = pw_num((&d[0 as usize]) as u64, 600) / 60
    pw_sby[0] = pw_num((&e[0 as usize]) as u64, 900) / 60
    pw_sby[1] = pw_num((&f[0 as usize]) as u64, 0) / 60
    pw_prof[0] = pw_prof_idx((&g[0 as usize]) as u64, 0)
    pw_prof[1] = pw_prof_idx((&h[0 as usize]) as u64, 1)
    pw_bri[0] = pw_num((&i[0 as usize]) as u64, 101)
    pw_bri[1] = pw_num((&j[0 as usize]) as u64, 101)
    pw_clamp()
    pw_sync_kval()
}

static mut pw_w_sleep: [u8; 6] = "sleep\0"

static mut pw_w_hib: [u8; 10] = "hibernate\0"

static mut pw_w_none: [u8; 8] = "nothing\0"

static mut pw_w_down: [u8; 9] = "shutdown\0"

static mut pw_w_save: [u8; 5] = "save\0"

static mut pw_w_bal: [u8; 9] = "balanced\0"

static mut pw_w_perf: [u8; 12] = "performance\0"

fn pw_lid_word(i: u64) -> u64 {
    if i == 1 {
        return (&pw_w_hib[0 as usize]) as u64
    }
    if i == 2 {
        return (&pw_w_none[0 as usize]) as u64
    }
    if i == 3 {
        return (&pw_w_down[0 as usize]) as u64
    }
    return (&pw_w_sleep[0 as usize]) as u64
}

fn pw_prof_word(i: u64) -> u64 {
    if i == 0 {
        return (&pw_w_save[0 as usize]) as u64
    }
    if i == 2 {
        return (&pw_w_perf[0 as usize]) as u64
    }
    return (&pw_w_bal[0 as usize]) as u64
}

fn pw_line(b: u64, key: u64, num: u64, word: u64) {
    var z: [u8; 24] = [0 as u8; 24]
    var eq: [u8; 2] = "=\0"
    var nl2: [u8; 2] = "\n\0"
    ulib.strcat(b, key)
    ulib.strcat(b, (&eq[0 as usize]) as u64)
    if word != 0 {
        ulib.strcat(b, word)
    } else {
        let d: u64 = text.digits(num, (&z[0 as usize]) as u64, true)
        z[(d) as usize] = 0 as u8
        ulib.strcat(b, (&z[0 as usize]) as u64)
    }
    ulib.strcat(b, (&nl2[0 as usize]) as u64)
}

fn pw_file_write() -> bool {
    var h: [u8; 46] = "# /etc/power.conf -- written by settings\n\0\0\0\0\0"
    var a: [u8; 8] = "lid_bat\0"
    var b: [u8; 7] = "lid_ac\0"
    var c: [u8; 11] = "screen_bat\0"
    var d: [u8; 10] = "screen_ac\0"
    var e: [u8; 12] = "standby_bat\0"
    var f: [u8; 11] = "standby_ac\0"
    var g: [u8; 12] = "profile_bat\0"
    var hh: [u8; 11] = "profile_ac\0"
    var i: [u8; 11] = "bright_bat\0"
    var j: [u8; 10] = "bright_ac\0"
    let bp: u64 = (&pw_buf[0 as usize]) as u64
    ulib.strcpy(bp, (&h[0 as usize]) as u64)
    pw_line(bp, (&a[0 as usize]) as u64, 0, pw_lid_word(pw_lid[0]))
    pw_line(bp, (&b[0 as usize]) as u64, 0, pw_lid_word(pw_lid[1]))
    pw_line(bp, (&c[0 as usize]) as u64, pw_scr[0] * 60, 0)
    pw_line(bp, (&d[0 as usize]) as u64, pw_scr[1] * 60, 0)
    pw_line(bp, (&e[0 as usize]) as u64, pw_sby[0] * 60, 0)
    pw_line(bp, (&f[0 as usize]) as u64, pw_sby[1] * 60, 0)
    pw_line(bp, (&g[0 as usize]) as u64, 0, pw_prof_word(pw_prof[0]))
    pw_line(bp, (&hh[0 as usize]) as u64, 0, pw_prof_word(pw_prof[1]))
    pw_line(bp, (&i[0 as usize]) as u64, pw_bri[0], 0)
    pw_line(bp, (&j[0 as usize]) as u64, pw_bri[1], 0)
    let fd: u64 = io.create((&pw_conf[0 as usize]) as u64)
    if ulib.bad(fd) {
        return false
    }
    let len: u64 = text.length(bp)
    let g2: u64 = io.write_all(fd, bp, len)
    io.close(fd)
    return !ulib.bad(g2) && g2 >= len
}

fn pw_bus_set(key: u64, value: u64) -> bool {
    var v_set: [u8; 18] = "call settings.set\0"
    var k_key: [u8; 4] = "key\0"
    var k_val: [u8; 6] = "value\0"
    if !actcli.open() {
        return false
    }
    actcli.req((&v_set[0 as usize]) as u64)
    actcli.arg((&k_key[0 as usize]) as u64, key)
    actcli.arg((&k_val[0 as usize]) as u64, value)
    return actcli.send(300) == actcli.R_OK
}

fn pw_bus_num(key: u64, v: u64) -> bool {
    var z: [u8; 24] = [0 as u8; 24]
    let d: u64 = text.digits(v, (&z[0 as usize]) as u64, true)
    z[(d) as usize] = 0 as u8
    return pw_bus_set(key, (&z[0 as usize]) as u64)
}

fn pw_say_state(ok: bool) {
    var s0: [u8; 17] = "settings: power \0"
    var s1: [u8; 6] = "lidb=\0"
    var s2: [u8; 7] = " lida=\0"
    var s3: [u8; 7] = " scrb=\0"
    var s4: [u8; 7] = " scra=\0"
    var s5: [u8; 7] = " sbyb=\0"
    var s6: [u8; 7] = " sbya=\0"
    var s7: [u8; 7] = " prfb=\0"
    var s8: [u8; 7] = " prfa=\0"
    var s9: [u8; 5] = " ok=\0"
    setcore.say((&s0[0 as usize]) as u64)
    setcore.say((&s1[0 as usize]) as u64)
    setcore.sayn(pw_lid[0])
    setcore.say((&s2[0 as usize]) as u64)
    setcore.sayn(pw_lid[1])
    setcore.say((&s3[0 as usize]) as u64)
    setcore.sayn(pw_scr[0])
    setcore.say((&s4[0 as usize]) as u64)
    setcore.sayn(pw_scr[1])
    setcore.say((&s5[0 as usize]) as u64)
    setcore.sayn(pw_sby[0])
    setcore.say((&s6[0 as usize]) as u64)
    setcore.sayn(pw_sby[1])
    setcore.say((&s7[0 as usize]) as u64)
    setcore.sayn(pw_prof[0])
    setcore.say((&s8[0 as usize]) as u64)
    setcore.sayn(pw_prof[1])
    setcore.say((&s9[0 as usize]) as u64)
    if ok {
        setcore.sayn(1)
    } else {
        setcore.sayn(0)
    }
    setcore.nl()
}

fn pw_store(which: u64) {
    var k0: [u8; 20] = "power.lid.battery\0\0\0"
    var k1: [u8; 18] = "power.lid.mains\0\0\0"
    var k2: [u8; 22] = "power.screen.battery\0\0"
    var k3: [u8; 20] = "power.screen.mains\0\0"
    var k4: [u8; 23] = "power.standby.battery\0\0"
    var k5: [u8; 21] = "power.standby.mains\0\0"
    var k6: [u8; 22] = "power.profile.battery\0"
    var k7: [u8; 20] = "power.profile.mains\0"
    var ok: bool = false
    if which == 0 {
        ok = pw_bus_set((&k0[0 as usize]) as u64, pw_lid_word(pw_lid[0]))
    } else if which == 1 {
        ok = pw_bus_set((&k1[0 as usize]) as u64, pw_lid_word(pw_lid[1]))
    } else if which == 2 {
        ok = pw_bus_num((&k2[0 as usize]) as u64, pw_scr[0] * 60)
    } else if which == 3 {
        ok = pw_bus_num((&k3[0 as usize]) as u64, pw_scr[1] * 60)
    } else if which == 4 {
        ok = pw_bus_num((&k4[0 as usize]) as u64, pw_sby[0] * 60)
    } else if which == 5 {
        ok = pw_bus_num((&k5[0 as usize]) as u64, pw_sby[1] * 60)
    } else if which == 6 {
        ok = pw_bus_set((&k6[0 as usize]) as u64, pw_prof_word(pw_prof[0]))
    } else {
        ok = pw_bus_set((&k7[0 as usize]) as u64, pw_prof_word(pw_prof[1]))
    }
    if !ok {
        ok = pw_file_write()
    }
    if ok {
        let _a: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_pw_saved[0 as usize]) as u64))
    } else {
        let _b: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_pw_nobus[0 as usize]) as u64))
    }
    pw_say_state(ok)
    report_state()
}

fn pw_choice(id: u64) {
    if id == setbase.K_PW_LB {
        pw_lid[0] = setbase.kval[(setbase.K_PW_LB) as usize]
        pw_clamp()
        pw_store(0)
    } else if id == setbase.K_PW_LA {
        pw_lid[1] = setbase.kval[(setbase.K_PW_LA) as usize]
        pw_clamp()
        pw_store(1)
    } else if id == setbase.K_PW_PB {
        pw_prof[0] = setbase.kval[(setbase.K_PW_PB) as usize]
        pw_clamp()
        pw_store(6)
    } else {
        pw_prof[1] = setbase.kval[(setbase.K_PW_PA) as usize]
        pw_clamp()
        pw_store(7)
    }
}

fn pw_slider(id: u64) {
    if id == setbase.K_PW_SB {
        pw_scr[0] = setaccount.slv(setbase.K_PW_SB, 0, 60)
        pw_clamp()
        pw_store(2)
    } else if id == setbase.K_PW_SA {
        pw_scr[1] = setaccount.slv(setbase.K_PW_SA, 0, 60)
        pw_clamp()
        pw_store(3)
    } else if id == setbase.K_PW_YB {
        pw_sby[0] = setaccount.slv(setbase.K_PW_YB, 0, 240)
        pw_clamp()
        pw_store(4)
    } else {
        pw_sby[1] = setaccount.slv(setbase.K_PW_YA, 0, 240)
        pw_clamp()
        pw_store(5)
    }
}

fn page_energie_col(col: usize, head: u64, kl: u64, ks: u64, ky: u64, kp: u64, i: u64) {
    let _h: usize = fuiscene.label(col, head)
    let _l1: usize = fuiscene.label(col, msg.get((&k_pw_lid[0 as usize]) as u64))
    let _c1: usize = fuiscene.choice(col, setaccount.chtext(kl, msg.get((&k_pw_lids[0 as usize]) as u64)), kl)
    let r_s: usize = fuiscene.row(col)
    let l_s: usize = fuiscene.label(r_s, msg.get((&k_pw_scr[0 as usize]) as u64))
    fuiscene.set_size(l_s, setdevice.fitw(170), 0)
    let _n_s: usize = fuiscene.slider(r_s, ks, 150, setaccount.slv_init(ks, 0, 60, pw_scr[(i) as usize]))
    fuiscene.slider_readout(ks, 0, 60, false)
    let r_y: usize = fuiscene.row(col)
    let l_y: usize = fuiscene.label(r_y, msg.get((&k_pw_sby[0 as usize]) as u64))
    fuiscene.set_size(l_y, setdevice.fitw(170), 0)
    let _n_y: usize = fuiscene.slider(r_y, ky, 150, setaccount.slv_init(ky, 0, 240, pw_sby[(i) as usize]))
    fuiscene.slider_readout(ky, 0, 240, false)
    let _l2: usize = fuiscene.label(col, msg.get((&k_pw_prof[0 as usize]) as u64))
    let _c2: usize = fuiscene.choice(col, setaccount.chtext(kp, msg.get((&k_pw_profs[0 as usize]) as u64)), kp)
}

fn page_energie(left: usize, right: usize) {
    let _n_p1: usize = fuiscene.label(left, msg.get((&k_pw_title[0 as usize]) as u64))
    let _n_p2: usize = fuiscene.label(left, msg.get((&k_pw_note[0 as usize]) as u64))
    page_energie_col(left, msg.get((&k_pw_bat[0 as usize]) as u64), setbase.K_PW_LB, setbase.K_PW_SB, setbase.K_PW_YB, setbase.K_PW_PB, 0)
    page_energie_col(right, msg.get((&k_pw_ac[0 as usize]) as u64), setbase.K_PW_LA, setbase.K_PW_SA, setbase.K_PW_YA, setbase.K_PW_PA, 1)
}

fn page_apps(left: usize, right: usize) {
    let _t1: usize = fuiscene.label(left, msg.get((&k_ap_title[0 as usize]) as u64))
    let _t2: usize = fuiscene.label(left, msg.get((&k_ap_note[0 as usize]) as u64))
    if setbase.ap_sel == setbase.AP_NONE || setbase.ap_sel >= setbase.ap_n {
        if setbase.ap_n == 0 {
            let _t3: usize = fuiscene.label(left, msg.get((&k_ap_none[0 as usize]) as u64))
        }
        var ki: u64 = 0
        while ki < setbase.ap_n {
            let nbl: usize = fuiscene.button(left, (((&setbase.ap_line[0 as usize]) as u64) + ki * 96), setbase.K_AP_LIST0 + ki)
            fuiscene.set_size(nbl, 0, 28)
            ki = ki + 1
        }
        let nr: usize = fuiscene.button(left, msg.get((&k_ap_ref[0 as usize]) as u64), setbase.K_AP_REF)
        fuiscene.set_size(nr, 0, 28)
        let _ts: usize = fuiscene.label(left, (&setbase.l_apstat[0 as usize]) as u64)
        return
    }
    let k: u64 = setbase.ap_sel
    setdevice.ap_prep_detail(k)
    let b: u64 = (&setbase.ap_txt[0 as usize]) as u64
    let nb: usize = fuiscene.button(left, msg.get((&k_ap_back[0 as usize]) as u64), setbase.K_AP_BACK)
    fuiscene.set_size(nb, 0, 28)
    let _l0: usize = fuiscene.label(left, b)
    let _l1: usize = fuiscene.label(left, b + 256)
    let _l2: usize = fuiscene.label(left, b + 512)
    let _l3: usize = fuiscene.label(left, b + 768)
    let _l4: usize = fuiscene.label(left, b + 1024)
    let _lr: usize = fuiscene.label(left, msg.get((&k_ap_rights[0 as usize]) as u64))
    var bit: u64 = 0
    while bit < setbase.AP_NRIGHTS {
        if bit != setbase.AP_BIT_NOTIFY && (setbase.ap_ceil[(k) as usize] & (1 << bit)) != 0 {
            let _sw: usize = fuiscene.toggle(left, policy.name_of_bit(1 << bit), setbase.K_AP_RIGHT0 + bit, setdevice.ap_toggle_state(k, bit))
        }
        bit = bit + 1
    }
    let _l5: usize = fuiscene.label(left, b + 1280)

    let nn: usize = fuiscene.toggle(right, msg.get((&k_ap_noti[0 as usize]) as u64), setbase.K_AP_RIGHT0 + setbase.AP_BIT_NOTIFY,
        setdevice.ap_toggle_state(k, setbase.AP_BIT_NOTIFY))
    if (setbase.ap_ceil[(k) as usize] & (1 << setbase.AP_BIT_NOTIFY)) == 0 {
        fuiscene.set_enabled(nn, false)
    }
    let ns: usize = fuiscene.button(right, msg.get((&k_ap_stop[0 as usize]) as u64), setbase.K_AP_STOP)
    fuiscene.set_size(ns, 0, 28)
    var u_key: u64 = 0
    if setbase.ap_arm != 0 {
        u_key = (&k_ap_uninst2[0 as usize]) as u64
    } else {
        u_key = (&k_ap_uninst[0 as usize]) as u64
    }
    let nu: usize = fuiscene.button(right, msg.get(u_key), setbase.K_AP_UNINST)
    fuiscene.set_size(nu, 0, 28)
    let nc: usize = fuiscene.button(right, msg.get((&k_ap_clear[0 as usize]) as u64), setbase.K_AP_CLEAR)
    fuiscene.set_size(nc, 0, 28)

    fuiscene.set_enabled(nc, false)
    let _lc: usize = fuiscene.label(right, msg.get((&k_ap_clearnote[0 as usize]) as u64))
    let ne: usize = fuiscene.button(right, msg.get((&k_ap_energy[0 as usize]) as u64), setbase.K_AP_ENERGY)
    fuiscene.set_size(ne, 0, 28)
    fuiscene.set_enabled(ne, false)
    let np: usize = fuiscene.button(right, msg.get((&k_ap_pause[0 as usize]) as u64), setbase.K_AP_PAUSE)
    fuiscene.set_size(np, 0, 28)
    fuiscene.set_enabled(np, false)
    let _ts2: usize = fuiscene.label(right, (&setbase.l_apstat[0 as usize]) as u64)
}

