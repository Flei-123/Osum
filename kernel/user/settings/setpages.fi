static mut k_su_build: [u8; 23] = "settings.upd.sys.build\0"

static mut k_su_chan: [u8; 22] = "settings.upd.sys.chan\0"

static mut k_su_ph: [u8; 24] = "settings.upd.sys.phase.\0"

static mut k_su_none: [u8; 22] = "settings.upd.sys.none\0"

static mut s_true: [u8; 5] = "true\0"

static mut s_ja: [u8; 3] = "ja\0"

fn bus_set(key: u64, val: u64) -> u64 {
    if !actcli.open() {
        var s0: [u8; 36] = "settings: no bus, page writes self\n\0"
        setcore.say((&s0[0 as usize]) as u64)
        return actcli.R_NOBUS
    }
    var v_set: [u8; 18] = "call settings.set\0"
    var k_key: [u8; 4] = "key\0"
    var k_val: [u8; 6] = "value\0"
    actcli.req((&v_set[0 as usize]) as u64)
    actcli.arg((&k_key[0 as usize]) as u64, key)
    actcli.arg((&k_val[0 as usize]) as u64, val)
    setbase.sy_pend = 0
    let rc: u64 = actcli.send(300)
    var s1: [u8; 24] = "settings: page set key=\0"
    setcore.say((&s1[0 as usize]) as u64)
    setcore.say(key)
    setcore.nl()
    setsystem.sys_answer(rc, key)
    return rc
}

fn bus_set_num(key: u64, v: u64) -> u64 {
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = text.digits(v, (&z[0 as usize]) as u64, true)
    z[(n) as usize] = 0 as u8
    return bus_set(key, (&z[0 as usize]) as u64)
}

fn upd_val(lp: u64, key: u64, out: u64, max: u64) -> bool {
    let kl: u64 = text.length(key)
    var i: u64 = 0
    while i < kl {
        if regio.read8_at(lp, i) != regio.read8_at(key, i) {
            return false
        }
        i = i + 1
    }
    var o: u64 = 0
    while regio.read8_at(lp, kl + o) != 0 && o + 1 < max {
        __mmio_write8((out + o) as *mut u8, regio.read8_at(lp, kl + o) as u8)
        o = o + 1
    }
    __mmio_write8((out + o) as *mut u8, 0 as u8)
    return true
}

fn upd_load() {
    var k_here: [u8; 6] = "here=\0"
    var k_there: [u8; 7] = "there=\0"
    var k_time: [u8; 6] = "time=\0"
    var k_phase: [u8; 7] = "phase=\0"
    var k_chan: [u8; 9] = "channel=\0"
    var k_auto: [u8; 6] = "auto=\0"
    var k_busy: [u8; 6] = "busy=\0"
    var here: [u8; 24] = [0 as u8; 24]
    var there: [u8; 24] = [0 as u8; 24]
    var tm: [u8; 40] = [0 as u8; 40]
    var ph: [u8; 24] = [0 as u8; 24]
    var bz: [u8; 8] = [0 as u8; 8]
    var ln: [u8; 120] = [0 as u8; 120]
    let lp: u64 = (&ln[0 as usize]) as u64
    var s_st: [u8; 28] = "call settings.update.status\0"
    var s_sp: [u8; 4] = " | \0"
    ph[(0) as usize] = 0 as u8
    here[(0) as usize] = 48 as u8
    here[(1) as usize] = 0 as u8
    there[(0) as usize] = 48 as u8
    there[(1) as usize] = 0 as u8
    tm[(0) as usize] = 0 as u8
    up_busy = 0
    __mmio_write8((&up_chan[0 as usize]) as u64 as *mut u8, 0 as u8)
    __mmio_write8((&up_auto[0 as usize]) as u64 as *mut u8, 0 as u8)
    var got: bool = false
    if actcli.open() {
        actcli.req((&s_st[0 as usize]) as u64)
        if actcli.send(300) == actcli.R_OK {
            got = true
            var n: u64 = 1
            while actcli.line(n, lp, 120) {
                let _a: bool = upd_val(lp, (&k_here[0 as usize]) as u64, (&here[0 as usize]) as u64, 24)
                let _b: bool = upd_val(lp, (&k_there[0 as usize]) as u64, (&there[0 as usize]) as u64, 24)
                let _c: bool = upd_val(lp, (&k_time[0 as usize]) as u64, (&tm[0 as usize]) as u64, 40)
                let _d: bool = upd_val(lp, (&k_phase[0 as usize]) as u64, (&ph[0 as usize]) as u64, 24)
                let _e: bool = upd_val(lp, (&k_chan[0 as usize]) as u64, (&up_chan[0 as usize]) as u64, 16)
                let _f: bool = upd_val(lp, (&k_auto[0 as usize]) as u64, (&up_auto[0 as usize]) as u64, 16)
                var bb: [u8; 8] = [0 as u8; 8]
                if upd_val(lp, (&k_busy[0 as usize]) as u64, (&bb[0 as usize]) as u64, 8) {
                    up_busy = ulib.to_num((&bb[0 as usize]) as u64)
                }
                n = n + 1
            }
        }
    }
    let p1: u64 = (&setbase.l_upver[0 as usize]) as u64
    let p2: u64 = (&setbase.l_uplast[0 as usize]) as u64
    let p3: u64 = (&setbase.l_upphase[0 as usize]) as u64
    if !got {
        var o0: u64 = setaccount.bx_put(p1, 0, 200, msg.get((&setbase.k_sy_nobus[0 as usize]) as u64))
        __mmio_write8((p2) as *mut u8, 0 as u8)
        __mmio_write8((p3) as *mut u8, 0 as u8)
        return
    }

    var o: u64 = setaccount.bx_put(p1, 0, 200, msg.get((&k_up_ver[0 as usize]) as u64))
    o = setaccount.bx_put(p1, o, 200, (&here[0 as usize]) as u64)
    o = setaccount.bx_put(p1, o, 200, (&s_sp[0 as usize]) as u64)
    o = setaccount.bx_put(p1, o, 200, msg.get((&k_up_chan[0 as usize]) as u64))
    o = setaccount.bx_put(p1, o, 200, (&up_chan[0 as usize]) as u64)
    o = setaccount.bx_put(p1, o, 200, (&s_sp[0 as usize]) as u64)
    o = setaccount.bx_put(p1, o, 200, msg.get((&k_up_auto[0 as usize]) as u64))
    var on: bool = ulib.streq((&up_auto[0 as usize]) as u64, (&s_true[0 as usize]) as u64)
        || ulib.streq((&up_auto[0 as usize]) as u64, (&s_ja[0 as usize]) as u64)
    if on {
        o = setaccount.bx_put(p1, o, 200, msg.get((&k_up_on[0 as usize]) as u64))
    } else {
        o = setaccount.bx_put(p1, o, 200, msg.get((&k_up_off[0 as usize]) as u64))
    }

    o = setaccount.bx_put(p2, 0, 200, msg.get((&k_up_last[0 as usize]) as u64))
    if tm[0 as usize] == 0 as u8 {
        o = setaccount.bx_put(p2, o, 200, msg.get((&k_up_never[0 as usize]) as u64))
    } else {
        o = setaccount.bx_put(p2, o, 200, (&tm[0 as usize]) as u64)
    }
    if ulib.to_num((&there[0 as usize]) as u64) != 0 {
        o = setaccount.bx_put(p2, o, 200, (&s_sp[0 as usize]) as u64)
        o = setaccount.bx_put(p2, o, 200, msg.get((&k_up_srv[0 as usize]) as u64))
        o = setaccount.bx_put(p2, o, 200, (&there[0 as usize]) as u64)
    }

    var key: [u8; 48] = [0 as u8; 48]
    let kp: u64 = (&key[0 as usize]) as u64
    var kq: u64 = setaccount.bx_put(kp, 0, 48, (&k_up_ph[0 as usize]) as u64)
    kq = setaccount.bx_put(kp, kq, 48, (&ph[0 as usize]) as u64)
    o = setaccount.bx_put(p3, 0, 200, msg.get(kp))
    if up_busy != 0 {
        o = setaccount.bx_put(p3, o, 200, (&s_sp[0 as usize]) as u64)
        o = setaccount.bx_put(p3, o, 200, msg.get((&k_up_busy[0 as usize]) as u64))
    }
    var s1: [u8; 28] = "settings: update page here=\0"
    setcore.say((&s1[0 as usize]) as u64)
    setcore.say((&here[0 as usize]) as u64)
    var s2: [u8; 8] = " phase=\0"
    setcore.say((&s2[0 as usize]) as u64)
    setcore.say((&ph[0 as usize]) as u64)
    var s3: [u8; 10] = " channel=\0"
    setcore.say((&s3[0 as usize]) as u64)
    setcore.say((&up_chan[0 as usize]) as u64)
    var s4: [u8; 7] = " busy=\0"
    setcore.say((&s4[0 as usize]) as u64)
    setcore.sayn(up_busy)
    setcore.nl()
}

fn sysupd_load() {
    var k_ver: [u8; 5] = "ver=\0"
    var k_here: [u8; 6] = "here=\0"
    var k_there: [u8; 7] = "there=\0"
    var k_commit: [u8; 8] = "commit=\0"
    var k_phase: [u8; 7] = "phase=\0"
    var k_chan: [u8; 9] = "channel=\0"
    var k_note: [u8; 6] = "note=\0"
    var k_reason: [u8; 8] = "reason=\0"
    var reason: [u8; 64] = [0 as u8; 64]
    var s_sst: [u8; 31] = "call settings.update.sysstatus\0"
    var ver: [u8; 100] = [0 as u8; 100]
    var here: [u8; 24] = [0 as u8; 24]
    var there: [u8; 24] = [0 as u8; 24]
    var commit: [u8; 24] = [0 as u8; 24]
    var ph: [u8; 24] = [0 as u8; 24]
    var chan: [u8; 24] = [0 as u8; 24]
    var s_sp: [u8; 4] = " | \0"
    var ln: [u8; 120] = [0 as u8; 120]
    let lp: u64 = (&ln[0 as usize]) as u64
    var note: [u8; 100] = [0 as u8; 100]
    let nbuf: u64 = (&setbase.b_sunotes[0 as usize]) as u64
    __mmio_write8(nbuf as *mut u8, 0 as u8)
    var nat: u64 = 0
    var got: bool = false
    if actcli.open() {
        actcli.req((&s_sst[0 as usize]) as u64)
        if actcli.send(300) == actcli.R_OK {
            got = true
            var n: u64 = 1
            while actcli.line(n, lp, 120) {
                let _a: bool = upd_val(lp, (&k_ver[0 as usize]) as u64, (&ver[0 as usize]) as u64, 100)
                let _b: bool = upd_val(lp, (&k_here[0 as usize]) as u64, (&here[0 as usize]) as u64, 24)
                let _c: bool = upd_val(lp, (&k_there[0 as usize]) as u64, (&there[0 as usize]) as u64, 24)
                let _d: bool = upd_val(lp, (&k_commit[0 as usize]) as u64, (&commit[0 as usize]) as u64, 24)
                let _e: bool = upd_val(lp, (&k_phase[0 as usize]) as u64, (&ph[0 as usize]) as u64, 24)
                let _f: bool = upd_val(lp, (&k_chan[0 as usize]) as u64, (&chan[0 as usize]) as u64, 24)
                let _r: bool = upd_val(lp, (&k_reason[0 as usize]) as u64, (&reason[0 as usize]) as u64, 64)
                if upd_val(lp, (&k_note[0 as usize]) as u64, (&note[0 as usize]) as u64, 100) {
                    nat = setaccount.bx_put(nbuf, nat, 1000, (&note[0 as usize]) as u64)
                    nat = setaccount.bx_put(nbuf, nat, 1000, (&s_sp[0 as usize]) as u64)
                }
                n = n + 1
            }
        }
    }
    let p1: u64 = (&setbase.l_suver[0 as usize]) as u64
    let p2: u64 = (&setbase.l_suphase[0 as usize]) as u64
    if !got {
        var o0: u64 = setaccount.bx_put(p1, 0, 200, msg.get((&setbase.k_sy_nobus[0 as usize]) as u64))
        __mmio_write8((p2) as *mut u8, 0 as u8)
        return
    }
    if nat >= 3 {
        nat = nat - 3
        __mmio_write8((nbuf + nat) as *mut u8, 0 as u8)
    }
    if nat == 0 {
        nat = setaccount.bx_put(nbuf, 0, 1000, msg.get((&k_su_none[0 as usize]) as u64))
    }

    var o: u64 = setaccount.bx_put(p1, 0, 200, msg.get((&k_su_ver[0 as usize]) as u64))
    if ver[0 as usize] == 0 as u8 {
        o = setaccount.bx_put(p1, o, 200, msg.get((&k_su_build[0 as usize]) as u64))
        o = setaccount.bx_put(p1, o, 200, (&here[0 as usize]) as u64)
    } else {
        o = setaccount.bx_put(p1, o, 200, (&ver[0 as usize]) as u64)
    }
    o = setaccount.bx_put(p1, o, 200, (&s_sp[0 as usize]) as u64)
    o = setaccount.bx_put(p1, o, 200, msg.get((&k_su_chan[0 as usize]) as u64))
    o = setaccount.bx_put(p1, o, 200, (&chan[0 as usize]) as u64)

    var key: [u8; 48] = [0 as u8; 48]
    let kp: u64 = (&key[0 as usize]) as u64
    var kq: u64 = setaccount.bx_put(kp, 0, 48, (&k_su_ph[0 as usize]) as u64)
    kq = setaccount.bx_put(kp, kq, 48, (&ph[0 as usize]) as u64)
    o = setaccount.bx_put(p2, 0, 200, msg.get(kp))
    if ph[0 as usize] == 102 as u8 && reason[0 as usize] != 0 as u8 {
        o = setaccount.bx_put(p2, o, 200, (&s_sp[0 as usize]) as u64)
        o = setaccount.bx_put(p2, o, 200, (&reason[0 as usize]) as u64)
    }
    if ph[0 as usize] == 97 as u8 && ph[1 as usize] == 118 as u8 {

        o = setaccount.bx_put(p2, o, 200, (&s_sp[0 as usize]) as u64)
        o = setaccount.bx_put(p2, o, 200, msg.get((&k_su_build[0 as usize]) as u64))
        o = setaccount.bx_put(p2, o, 200, (&there[0 as usize]) as u64)
        o = setaccount.bx_put(p2, o, 200, (&s_sp[0 as usize]) as u64)
        o = setaccount.bx_put(p2, o, 200, (&commit[0 as usize]) as u64)
    }
    var s1: [u8; 30] = "settings: system update here=\0"
    setcore.say((&s1[0 as usize]) as u64)
    setcore.say((&here[0 as usize]) as u64)
    var s2: [u8; 8] = " phase=\0"
    setcore.say((&s2[0 as usize]) as u64)
    setcore.say((&ph[0 as usize]) as u64)
    var s3: [u8; 8] = " there=\0"
    setcore.say((&s3[0 as usize]) as u64)
    setcore.say((&there[0 as usize]) as u64)
    var s4: [u8; 8] = " notes=\0"
    setcore.say((&s4[0 as usize]) as u64)
    setcore.sayn(text.length(nbuf))
    setcore.nl()
}

fn upd_call(verb: u64, shown: u64) {
    setbase.sy_pend = 0
    if !actcli.open() {
        setaccount.stat_set((&setbase.l_systat[0 as usize]) as u64, (&setbase.k_sy_nobus[0 as usize]) as u64, 0)
        return
    }
    actcli.req(verb)
    let rc: u64 = actcli.send(300)
    setsystem.sys_answer(rc, shown)
}

fn upd_toggle(which: u64) {
    var k_ch: [u8; 15] = "update.channel\0"
    var k_au: [u8; 12] = "update.auto\0"
    var v_stable: [u8; 7] = "stable\0"
    var v_test: [u8; 5] = "test\0"
    var v_true: [u8; 5] = "true\0"
    var v_false: [u8; 6] = "false\0"
    if which == 0 {
        if ulib.streq((&up_chan[0 as usize]) as u64, (&v_test[0 as usize]) as u64) {
            let _r: u64 = bus_set((&k_ch[0 as usize]) as u64, (&v_stable[0 as usize]) as u64)
        } else {
            let _r2: u64 = bus_set((&k_ch[0 as usize]) as u64, (&v_test[0 as usize]) as u64)
        }
    } else {
        if ulib.streq((&up_auto[0 as usize]) as u64, (&v_true[0 as usize]) as u64)
            || ulib.streq((&up_auto[0 as usize]) as u64, (&s_ja[0 as usize]) as u64) {
            let _r3: u64 = bus_set((&k_au[0 as usize]) as u64, (&v_false[0 as usize]) as u64)
        } else {
            let _r4: u64 = bus_set((&k_au[0 as usize]) as u64, (&v_true[0 as usize]) as u64)
        }
    }
}

fn upd_show() {
    upd_load()
    sysupd_load()
    fuiscene.refresh()
}

