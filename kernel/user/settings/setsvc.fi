profile app

import libc.octets
import libc.text
import lineout
import msg
import services.svcosum
import services.svcrules
import services.dlgproto
import settings.setbase

export { restore_start_page, remember_page, confirm_restore }

const APP_LEN: u64 = 8
const KEY_LEN: u64 = 9
const VALUE_CAP: u64 = 16
const RESULT_CAP: u64 = 8
const PAGE_DIGITS_MAX: u64 = 3
const NO_PAGE: u64 = 4294967295

static mut APP: [u8; 9] = "settings\0"
static mut KEY: [u8; 10] = "last-page\0"
static mut K_TITLE: [u8; 31] = "settings.confirm.restore.title\0"
static mut K_TEXT: [u8; 30] = "settings.confirm.restore.text\0"
static mut LOADED: [u8; 30] = "settings: page restored page=\0"
static mut SAVED: [u8; 27] = "settings: page saved page=\0"
static mut CONFIRM: [u8; 34] = "settings: confirm restore status=\0"
static mut STATUS: [u8; 9] = " status=\0"
static mut ANSWER: [u8; 9] = " answer=\0"
static mut GO: [u8; 5] = " go=\0"
static mut value_buf: [u8; 16] = [0 as u8; 16]
static mut result_buf: [u8; 8] = [0 as u8; 8]
static mut saved_page: u64 = 4294967295

fn value_ptr() -> u64 {
    return (&value_buf[0 as usize]) as u64
}

fn result_ptr() -> u64 {
    return (&result_buf[0 as usize]) as u64
}

fn key_ptr() -> u64 {
    return (&KEY[0 as usize]) as u64
}

fn bind() {
    let _status: u64 = svcosum.set_app((&APP[0 as usize]) as u64, APP_LEN)
}

fn put(buf: u64) {
    lineout.add_text(buf)
}

fn put_field(name: u64, value: u64) {
    put(name)
    lineout.add_num(value)
}

fn stored_digits_valid(n: u64) -> bool {
    if n == 0 || n > PAGE_DIGITS_MAX {
        return false
    }
    var at: u64 = 0
    while at < n {
        if !text.is_digit(octets.ld8(value_ptr(), at)) {
            return false
        }
        at = at + 1
    }
    return true
}

fn read_page() -> u64 {
    octets.zero(value_ptr(), VALUE_CAP)
    octets.zero(result_ptr(), RESULT_CAP)
    bind()
    let status: u64 = svcosum.store_get(key_ptr(), KEY_LEN, value_ptr(), VALUE_CAP - 1, result_ptr())
    if status != svcrules.OK {
        return NO_PAGE
    }
    if !stored_digits_valid(octets.le32(result_ptr())) {
        return NO_PAGE
    }
    return text.number(value_ptr())
}

fn restore_start_page() {
    if setbase.start_page != setbase.R_DARST {
        return
    }
    let page: u64 = read_page()
    if page == NO_PAGE || page >= setbase.R_ANZ {
        return
    }
    setbase.start_page = page
    saved_page = page
    put_field((&LOADED[0 as usize]) as u64, page)
    lineout.end_line()
}

fn remember_page(page: u64) {
    if page >= setbase.R_ANZ || page == saved_page {
        return
    }
    saved_page = page
    octets.zero(value_ptr(), VALUE_CAP)
    let digits: u64 = text.digits(page, value_ptr(), false)
    bind()
    let status: u64 = svcosum.store_set(key_ptr(), KEY_LEN, value_ptr(), digits)
    put_field((&SAVED[0 as usize]) as u64, page)
    put_field((&STATUS[0 as usize]) as u64, status)
    lineout.end_line()
}

fn confirm_restore() -> bool {
    octets.zero(result_ptr(), RESULT_CAP)
    bind()
    let status: u64 = svcosum.confirm(msg.get((&K_TITLE[0 as usize]) as u64),
        msg.get((&K_TEXT[0 as usize]) as u64), result_ptr())
    let answer: u64 = octets.le32(result_ptr())
    var go: u64 = 0
    if status == svcrules.NO_BACKEND || (status == svcrules.OK && answer == dlgproto.ANSWER_OK) {
        go = 1
    }
    put_field((&CONFIRM[0 as usize]) as u64, status)
    put_field((&ANSWER[0 as usize]) as u64, answer)
    put_field((&GO[0 as usize]) as u64, go)
    lineout.end_line()
    return go == 1
}
