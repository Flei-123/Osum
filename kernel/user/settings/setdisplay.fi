profile app

import fuiapp.hosthead
import fuiscene
import icons
import msg
import actcli
import qsmodes
import ulib
import displaymode
import settings.setaccount
import settings.setarrange
import settings.setbase
import settings.setbootres
import settings.setcore
import settings.setpages
import settings.setsystem

export { page, choice_picked, slider_moved, button_clicked }

const DG_COUNT: u64 = 1
const DG_EDIDOK: u64 = 5
const DG_NATW: u64 = 7
const DG_NATH: u64 = 8
const DG_PANELW: u64 = 10
const DG_PANELH: u64 = 11
const DG_ROT: u64 = 14
const DG_BRIGHT: u64 = 16
const DG_SAT: u64 = 19

const DS_MODE: u64 = 0
const DS_ROT: u64 = 1
const DS_BRIGHT: u64 = 3
const DS_SAT: u64 = 6

const NOTE_NONE: u64 = 0
const NOTE_REBOOT: u64 = 1
const NOTE_MODE_FAILED: u64 = 2
const NOTE_SCALE_FAILED: u64 = 3
const NOTE_NEEDS_DRIVER: u64 = 4
const NOTE_SAVE_FAILED: u64 = 5
const NOTE_SCALED: u64 = 6

const MODE_CAP: u64 = 30
const MODE_MIN_W: u64 = 640
const MODE_MIN_H: u64 = 480
const ITEMS_CAP: u64 = 430
const SCALE_STEPS: u64 = 5
const BRIGHT_MIN: u64 = 5
const BRIGHT_MAX: u64 = 100
const ICON_BOX: u64 = 36
const ICON_SIZE: u64 = 20
const CHOICE_W: u64 = 200
const SLIDER_W: u64 = 220
const ROW_GAP: u64 = 14
const PROFILE_VIVID: u64 = 140
const PROFILE_SOFT: u64 = 70
const PROFILE_NEUTRAL: u64 = 100
const WIDTH_SCALE_150: u64 = 2400
const WIDTH_SCALE_200: u64 = 3200

static mut m_path: [u8; 18] = "settings.dsp.path\0"
static mut m_sec_color: [u8; 23] = "settings.dsp.sec.color\0"
static mut m_sec_layout: [u8; 24] = "settings.dsp.sec.layout\0"
static mut m_sec_related: [u8; 25] = "settings.dsp.sec.related\0"
static mut m_bright_t: [u8; 22] = "settings.dsp.bright.t\0"
static mut m_bright_s: [u8; 22] = "settings.dsp.bright.s\0"
static mut m_bright_n: [u8; 22] = "settings.dsp.bright.n\0"
static mut m_night_t: [u8; 21] = "settings.dsp.night.t\0"
static mut m_night_s: [u8; 21] = "settings.dsp.night.s\0"
static mut m_on: [u8; 16] = "settings.dsp.on\0"
static mut m_off: [u8; 17] = "settings.dsp.off\0"
static mut m_profile_t: [u8; 23] = "settings.dsp.profile.t\0"
static mut m_profile_s: [u8; 23] = "settings.dsp.profile.s\0"
static mut m_profile_n: [u8; 23] = "settings.dsp.profile.n\0"
static mut m_profile_c: [u8; 23] = "settings.dsp.profile.c\0"
static mut m_scale_t: [u8; 21] = "settings.dsp.scale.t\0"
static mut m_scale_s: [u8; 21] = "settings.dsp.scale.s\0"
static mut m_res_t: [u8; 19] = "settings.dsp.res.t\0"
static mut m_res_s: [u8; 19] = "settings.dsp.res.s\0"
static mut m_res_boot: [u8; 22] = "settings.dsp.res.boot\0"
static mut m_rot_t: [u8; 19] = "settings.dsp.rot.t\0"
static mut m_rot_s: [u8; 19] = "settings.dsp.rot.s\0"
static mut m_rot_c: [u8; 19] = "settings.dsp.rot.c\0"
static mut m_rot_n: [u8; 19] = "settings.dsp.rot.n\0"
static mut m_multi_t: [u8; 21] = "settings.dsp.multi.t\0"
static mut m_multi_s: [u8; 21] = "settings.dsp.multi.s\0"
static mut m_adv_t: [u8; 19] = "settings.dsp.adv.t\0"
static mut m_adv_s: [u8; 19] = "settings.dsp.adv.s\0"
static mut m_keep_t: [u8; 20] = "settings.dsp.keep.t\0"
static mut m_keep_a: [u8; 20] = "settings.dsp.keep.a\0"
static mut m_keep_b: [u8; 20] = "settings.dsp.keep.b\0"
static mut m_keep_yes: [u8; 22] = "settings.dsp.keep.yes\0"
static mut m_keep_no: [u8; 21] = "settings.dsp.keep.no\0"
static mut m_auto: [u8; 18] = "settings.dsp.auto\0"
static mut m_rec: [u8; 17] = "settings.dsp.rec\0"
static mut m_note_reboot: [u8; 25] = "settings.dsp.note.reboot\0"
static mut m_note_mode: [u8; 23] = "settings.dsp.note.mode\0"
static mut m_note_scale: [u8; 24] = "settings.dsp.note.scale\0"
static mut m_note_driver: [u8; 25] = "settings.dsp.note.driver\0"
static mut m_note_save: [u8; 23] = "settings.dsp.note.save\0"
static mut m_note_scaled: [u8; 25] = "settings.dsp.note.scaled\0"
static mut s_pick: [u8; 23] = "settings: display pick\0"
static mut t_space_pct: [u8; 3] = "%\0\0"
static mut t_nl: [u8; 2] = "\n\0"
static mut t_x: [u8; 4] = " x \0"
static mut t_sp: [u8; 2] = " \0"

static mut res_items: [u8; 480] = [0 as u8; 480]
static mut res_w: [u64; 32] = [0 as u64; 32]
static mut res_h: [u64; 32] = [0 as u64; 32]
static mut res_n: u64 = 0
static mut scale_items: [u8; 160] = [0 as u8; 160]
static mut keep_text: [u8; 160] = [0 as u8; 160]
static mut note: u64 = 0
static mut driver_ready: bool = false

fn key_text(k: u64) -> u64 {
    return msg.get(k)
}

fn scale_pct(i: u64) -> u64 {
    if i == 1 { return 125 }
    if i == 2 { return 150 }
    if i == 3 { return 175 }
    if i == 4 { return 200 }
    return 100
}

fn scale_index(pct: u64) -> u64 {
    var best: u64 = 0
    var i: u64 = 0
    while i < SCALE_STEPS {
        if pct >= scale_pct(i) {
            best = i
        }
        i = i + 1
    }
    return best
}

fn recommended_scale_index() -> u64 {
    let w: u64 = hosthead.screen_w()
    if w >= WIDTH_SCALE_200 {
        return 4
    }
    if w >= WIDTH_SCALE_150 {
        return 2
    }
    return 0
}

fn current_panel_w() -> u64 {
    if driver_ready {
        let v: u64 = setcore.dget(DG_PANELW)
        if !ulib.bad(v) && v > 0 {
            return v
        }
    }
    return hosthead.screen_w()
}

fn current_panel_h() -> u64 {
    if driver_ready {
        let v: u64 = setcore.dget(DG_PANELH)
        if !ulib.bad(v) && v > 0 {
            return v
        }
    }
    return hosthead.screen_h()
}

fn native_w() -> u64 {
    if driver_ready && setcore.dget(DG_EDIDOK) == 1 {
        return setcore.dget(DG_NATW)
    }
    return 0
}

fn native_h() -> u64 {
    if driver_ready && setcore.dget(DG_EDIDOK) == 1 {
        return setcore.dget(DG_NATH)
    }
    return 0
}

fn add_mode_text(at: u64, w: u64, h: u64, rec: bool) -> u64 {
    let p: u64 = (&res_items[0 as usize]) as u64
    var a: u64 = setcore.num_at(p, at, w)
    a = setcore.text_an(p, a, (&t_x[0 as usize]) as u64)
    a = setcore.num_at(p, a, h)
    if rec {
        a = setcore.text_an(p, a, (&t_sp[0 as usize]) as u64)
        a = setcore.text_an(p, a, key_text((&m_rec[0 as usize]) as u64))
    }
    return a
}

fn mode_known(w: u64, h: u64) -> bool {
    var i: u64 = 0
    while i < res_n {
        if res_w[(i) as usize] == w && res_h[(i) as usize] == h {
            return true
        }
        i = i + 1
    }
    return false
}

fn add_mode(at: u64, w: u64, h: u64, rec: bool) -> u64 {
    var a: u64 = at
    if res_n > 0 {
        a = setcore.text_an((&res_items[0 as usize]) as u64, a, (&t_nl[0 as usize]) as u64)
    }
    res_w[(res_n) as usize] = w
    res_h[(res_n) as usize] = h
    res_n = res_n + 1
    return add_mode_text(a, w, h, rec)
}

fn build_driver_modes() -> u64 {
    let n: u64 = setcore.dget(DG_COUNT)
    let nw: u64 = native_w()
    let nh: u64 = native_h()
    var a: u64 = 0
    var i: u64 = n
    while i > 0 && res_n < MODE_CAP && a < ITEMS_CAP {
        i = i - 1
        let m: u64 = setcore.dget(setbase.DG_MODE + i)
        if !ulib.bad(m) {
            let w: u64 = (m >> 32) & 0xFFFF
            let h: u64 = (m >> 16) & 0xFFFF
            if w >= MODE_MIN_W && h >= MODE_MIN_H && !mode_known(w, h) {
                a = add_mode(a, w, h, w == nw && h == nh)
            }
        }
    }
    return a
}

fn build_boot_modes() -> u64 {
    var a: u64 = 0
    res_w[0 as usize] = 0
    res_h[0 as usize] = 0
    res_n = 1
    let p: u64 = (&res_items[0 as usize]) as u64
    a = setcore.text_an(p, a, key_text((&m_auto[0 as usize]) as u64))
    a = setcore.text_an(p, a, (&t_sp[0 as usize]) as u64)
    a = setcore.text_an(p, a, key_text((&m_rec[0 as usize]) as u64))
    var i: u64 = 1
    while i < setbootres.FIXED_COUNT {
        a = add_mode(a, setbootres.fixed_w(i), setbootres.fixed_h(i), false)
        i = i + 1
    }
    return a
}

fn select_current_mode() -> u64 {
    if !driver_ready {
        let s: u64 = setbootres.saved()
        var i: u64 = 1
        while i < res_n {
            if s == ((res_w[(i) as usize] << 16) | res_h[(i) as usize]) {
                return i
            }
            i = i + 1
        }
        return 0
    }
    let w: u64 = current_panel_w()
    let h: u64 = current_panel_h()
    var i: u64 = 0
    while i < res_n {
        if res_w[(i) as usize] == w && res_h[(i) as usize] == h {
            return i
        }
        i = i + 1
    }
    return 0
}

fn load_resolutions() {
    res_n = 0
    if driver_ready {
        let _a: u64 = build_driver_modes()
    } else {
        let _b: u64 = build_boot_modes()
    }
    setbase.kval[(setbase.K_DSP_RES) as usize] = select_current_mode()
}

fn load_scales() {
    let p: u64 = (&scale_items[0 as usize]) as u64
    let rec: u64 = recommended_scale_index()
    var a: u64 = 0
    var i: u64 = 0
    while i < SCALE_STEPS {
        if i > 0 {
            a = setcore.text_an(p, a, (&t_nl[0 as usize]) as u64)
        }
        a = setcore.num_at(p, a, scale_pct(i))
        a = setcore.text_an(p, a, (&t_space_pct[0 as usize]) as u64)
        if i == rec {
            a = setcore.text_an(p, a, (&t_sp[0 as usize]) as u64)
            a = setcore.text_an(p, a, key_text((&m_rec[0 as usize]) as u64))
        }
        i = i + 1
    }
    setbase.kval[(setbase.K_DSP_SCALE) as usize] = scale_index(hosthead.head_scale(setarrange.selected()))
}

fn load_state() {
    let ready: u64 = setcore.dget(setbase.DG_READY)
    driver_ready = !ulib.bad(ready) && ready == 1
    load_resolutions()
    load_scales()
    var rot: u64 = 0
    if driver_ready {
        let r: u64 = setcore.dget(DG_ROT)
        if !ulib.bad(r) {
            rot = (r / 90) % 4
        }
    }
    setbase.kval[(setbase.K_DSP_ROT) as usize] = rot
    var prof: u64 = 0
    if driver_ready {
        let s: u64 = setcore.dget(DG_SAT)
        if !ulib.bad(s) && s >= PROFILE_VIVID - 10 {
            prof = 1
        } else if !ulib.bad(s) && s <= PROFILE_SOFT + 15 {
            prof = 2
        }
    }
    setbase.kval[(setbase.K_DSP_PROFILE) as usize] = prof
}

fn paint_glyph(cp: u64, x: u64, y: u64, w: u64, h: u64) {
    let s: u64 = fuiscene.sp(1)
    let size: u64 = ICON_SIZE * s
    fuiscene.cv_glyph_role(cp, x + (w - size) / 2, y + (h - size) / 2, size, fuiscene.R_TEXT)
}

fn draw_bright(x: u64, y: u64, w: u64, h: u64) {
    paint_glyph(icons.BRIGHTNESS, x, y, w, h)
}

fn draw_night(x: u64, y: u64, w: u64, h: u64) {
    paint_glyph(icons.QS_NIGHT, x, y, w, h)
}

fn draw_profile(x: u64, y: u64, w: u64, h: u64) {
    paint_glyph(icons.SETTINGS_PERSONALIZATION, x, y, w, h)
}

fn draw_scale(x: u64, y: u64, w: u64, h: u64) {
    paint_glyph(icons.START, x, y, w, h)
}

fn draw_res(x: u64, y: u64, w: u64, h: u64) {
    paint_glyph(icons.SETTINGS_DISPLAY, x, y, w, h)
}

fn draw_rot(x: u64, y: u64, w: u64, h: u64) {
    paint_glyph(icons.NAV_REFRESH, x, y, w, h)
}

fn draw_multi(x: u64, y: u64, w: u64, h: u64) {
    paint_glyph(icons.SETTINGS_TASKBAR, x, y, w, h)
}

fn draw_adv(x: u64, y: u64, w: u64, h: u64) {
    paint_glyph(icons.SETTINGS_SYSTEM, x, y, w, h)
}

fn setting_row(parent: usize, draw: fn(u64, u64, u64, u64), title: u64, sub: u64) -> usize {
    let card: usize = fuiscene.card(parent)
    let r: usize = fuiscene.row(card)
    fuiscene.set_gap(r, ROW_GAP)
    let box: u64 = fuiscene.sp(ICON_BOX)
    let _ic: usize = fuiscene.canvas(r, 0, box, box, draw)
    let col: usize = fuiscene.column_w(r, 1)
    let _t: usize = fuiscene.label(col, title)
    let _s: usize = fuiscene.label_muted(col, sub)
    return r
}

fn section(parent: usize, key: u64) {
    let _h: usize = fuiscene.label_heading(parent, key_text(key))
}

fn choice_control(r: usize, key: u64, items: u64) {
    let c: usize = fuiscene.choice(r, setaccount.chtext(key, items), key)
    fuiscene.set_size(c, fuiscene.sp(CHOICE_W), 0)
}

fn keep_dialog(parent: usize) {
    let card: usize = fuiscene.card(parent)
    let _t: usize = fuiscene.label_heading(card, key_text((&m_keep_t[0 as usize]) as u64))
    let p: u64 = (&keep_text[0 as usize]) as u64
    var a: u64 = setcore.text_an(p, 0, key_text((&m_keep_a[0 as usize]) as u64))
    a = setcore.num_at(p, a, setcore.remain_secs())
    a = setcore.text_an(p, a, key_text((&m_keep_b[0 as usize]) as u64))
    let _s: usize = fuiscene.label_muted(card, p)
    let r: usize = fuiscene.row(card)
    fuiscene.set_gap(r, 10)
    let _y: usize = fuiscene.button_main(r, key_text((&m_keep_yes[0 as usize]) as u64), setbase.K_B2A)
    let _n: usize = fuiscene.button(r, key_text((&m_keep_no[0 as usize]) as u64), setbase.K_B2B)
}

fn bright_row(parent: usize) {
    let k: u64 = setcore.dget(DG_BRIGHT)
    if ulib.bad(k) {
        let _r: usize = setting_row(parent, draw_bright, key_text((&m_bright_t[0 as usize]) as u64),
            key_text((&m_bright_n[0 as usize]) as u64))
        return
    }
    let r: usize = setting_row(parent, draw_bright, key_text((&m_bright_t[0 as usize]) as u64),
        key_text((&m_bright_s[0 as usize]) as u64))
    let _sl: usize = fuiscene.slider(r, setbase.K_DSP_BR, fuiscene.sp(SLIDER_W),
        setaccount.slv_init(setbase.K_DSP_BR, BRIGHT_MIN, BRIGHT_MAX, k / 2))
    fuiscene.slider_readout(setbase.K_DSP_BR, BRIGHT_MIN, BRIGHT_MAX, true)
}

fn night_row(parent: usize) {
    let r: usize = setting_row(parent, draw_night, key_text((&m_night_t[0 as usize]) as u64),
        key_text((&m_night_s[0 as usize]) as u64))
    let on: bool = qsmodes.on(qsmodes.T_NIGHT)
    var label: u64 = key_text((&m_off[0 as usize]) as u64)
    if on {
        label = key_text((&m_on[0 as usize]) as u64)
    }
    let _t: usize = fuiscene.toggle(r, label, setbase.K_DSP_NIGHT, on)
}

fn profile_row(parent: usize) {
    if !driver_ready {
        let _n: usize = setting_row(parent, draw_profile, key_text((&m_profile_t[0 as usize]) as u64),
            key_text((&m_profile_n[0 as usize]) as u64))
        return
    }
    let r: usize = setting_row(parent, draw_profile, key_text((&m_profile_t[0 as usize]) as u64),
        key_text((&m_profile_s[0 as usize]) as u64))
    choice_control(r, setbase.K_DSP_PROFILE, key_text((&m_profile_c[0 as usize]) as u64))
}

fn scale_row(parent: usize) {
    let r: usize = setting_row(parent, draw_scale, key_text((&m_scale_t[0 as usize]) as u64),
        key_text((&m_scale_s[0 as usize]) as u64))
    choice_control(r, setbase.K_DSP_SCALE, (&scale_items[0 as usize]) as u64)
}

fn res_row(parent: usize) {
    var sub: u64 = key_text((&m_res_s[0 as usize]) as u64)
    if !driver_ready {
        sub = key_text((&m_res_boot[0 as usize]) as u64)
    }
    let r: usize = setting_row(parent, draw_res, key_text((&m_res_t[0 as usize]) as u64), sub)
    choice_control(r, setbase.K_DSP_RES, (&res_items[0 as usize]) as u64)
}

fn rot_row(parent: usize) {
    if !driver_ready {
        let _n: usize = setting_row(parent, draw_rot, key_text((&m_rot_t[0 as usize]) as u64),
            key_text((&m_rot_n[0 as usize]) as u64))
        return
    }
    let r: usize = setting_row(parent, draw_rot, key_text((&m_rot_t[0 as usize]) as u64),
        key_text((&m_rot_s[0 as usize]) as u64))
    choice_control(r, setbase.K_DSP_ROT, key_text((&m_rot_c[0 as usize]) as u64))
}

fn link_row(parent: usize, draw: fn(u64, u64, u64, u64), title: u64, sub: u64, key: u64) {
    let r: usize = setting_row(parent, draw, title, sub)
    let _c: usize = fuiscene.icon_link(r, icons.CHEVRON_RIGHT, title, key, fuiscene.sp(ICON_BOX), fuiscene.sp(ICON_BOX))
}

fn note_text() -> u64 {
    if note == NOTE_REBOOT { return key_text((&m_note_reboot[0 as usize]) as u64) }
    if note == NOTE_MODE_FAILED { return key_text((&m_note_mode[0 as usize]) as u64) }
    if note == NOTE_SCALE_FAILED { return key_text((&m_note_scale[0 as usize]) as u64) }
    if note == NOTE_NEEDS_DRIVER { return key_text((&m_note_driver[0 as usize]) as u64) }
    if note == NOTE_SAVE_FAILED { return key_text((&m_note_save[0 as usize]) as u64) }
    if note == NOTE_SCALED { return key_text((&m_note_scaled[0 as usize]) as u64) }
    return 0
}

fn page(left: usize) {
    load_state()
    let _p: usize = fuiscene.label_heading(left, key_text((&m_path[0 as usize]) as u64))
    if setcore.dget(setbase.DG_PENDING) == 1 {
        keep_dialog(left)
    }
    section(left, (&m_sec_color[0 as usize]) as u64)
    bright_row(left)
    night_row(left)
    profile_row(left)
    section(left, (&m_sec_layout[0 as usize]) as u64)
    scale_row(left)
    res_row(left)
    rot_row(left)
    link_row(left, draw_multi, key_text((&m_multi_t[0 as usize]) as u64),
        key_text((&m_multi_s[0 as usize]) as u64), setbase.K_DSP_MULTI)
    let nt: u64 = note_text()
    if nt != 0 {
        let _n: usize = fuiscene.label_muted(left, nt)
    }
    section(left, (&m_sec_related[0 as usize]) as u64)
    link_row(left, draw_adv, key_text((&m_adv_t[0 as usize]) as u64),
        key_text((&m_adv_s[0 as usize]) as u64), setbase.K_DSP_ADV)
}

fn apply_driver_mode(idx: u64) {
    let rc: u64 = setcore.dset(DS_MODE, (res_w[(idx) as usize] << 16) | res_h[(idx) as usize])
    if ulib.bad(rc) {
        note = NOTE_MODE_FAILED
    } else {
        note = NOTE_NONE
    }
}

fn apply_boot_mode(idx: u64) {
    if setbootres.save(res_w[(idx) as usize], res_h[(idx) as usize]) {
        note = NOTE_REBOOT
    } else {
        note = NOTE_SAVE_FAILED
    }
}

fn pick_resolution(idx: u64) {
    if idx >= res_n {
        return
    }
    if driver_ready {
        apply_driver_mode(idx)
    } else {
        apply_boot_mode(idx)
    }
}

fn pick_scale(idx: u64) {
    let pct: u64 = scale_pct(idx)
    if hosthead.head_scale_set(setarrange.selected(), pct) {
        let _sv: bool = displaymode.save(displaymode.current_mirror())
        note = NOTE_SCALED
    } else {
        note = NOTE_SCALE_FAILED
    }
}

fn pick_rotation(idx: u64) {
    if !driver_ready || ulib.bad(setcore.dset(DS_ROT, idx * 90)) {
        note = NOTE_NEEDS_DRIVER
        return
    }
    note = NOTE_NONE
}

fn profile_saturation(idx: u64) -> u64 {
    if idx == 1 {
        return PROFILE_VIVID
    }
    if idx == 2 {
        return PROFILE_SOFT
    }
    return PROFILE_NEUTRAL
}

fn pick_profile(idx: u64) {
    if !driver_ready || ulib.bad(setcore.dset(DS_SAT, profile_saturation(idx))) {
        note = NOTE_NEEDS_DRIVER
        return
    }
    note = NOTE_NONE
}

fn choice_picked(id: u64, idx: u64) {
    setcore.say((&s_pick[0 as usize]) as u64)
    setcore.nl()
    if id == setbase.K_DSP_RES {
        pick_resolution(idx)
    } else if id == setbase.K_DSP_SCALE {
        pick_scale(idx)
    } else if id == setbase.K_DSP_ROT {
        pick_rotation(idx)
    } else if id == setbase.K_DSP_PROFILE {
        pick_profile(idx)
    }
    setsystem.state_read()
    fuiscene.refresh()
    setpages.report_state()
}

fn slider_moved() {
    var key: [u8; 19] = "display.brightness\0"
    let p: u64 = setaccount.slv(setbase.K_DSP_BR, BRIGHT_MIN, BRIGHT_MAX)
    if setpages.bus_set_num((&key[0 as usize]) as u64, p) == actcli.R_NOBUS {
        let _r: u64 = setcore.dset(DS_BRIGHT, p * 2)
    }
}

fn open_page(r: u64) {
    if setpages.nav_mode() {
        setbase.nav_detail = true
    }
    setpages.bus_page(r)
    setsystem.show_tab(r)
    setpages.report_state()
}

fn button_clicked(id: u64) -> bool {
    if id == setbase.K_DSP_NIGHT {
        let _rc: u64 = qsmodes.click(qsmodes.T_NIGHT)
        fuiscene.refresh()
        setpages.report_state()
        return true
    }
    if id == setbase.K_DSP_MULTI {
        open_page(setbase.R_SCREEN3)
        return true
    }
    if id == setbase.K_DSP_ADV {
        open_page(setbase.R_SCREEN2)
        return true
    }
    return false
}
