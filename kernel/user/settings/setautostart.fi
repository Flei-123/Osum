profile app

import fuiscene
import msg
import ulib
import libc.octets
import libc.text
import autostartsrc
import autostart.model
import settings.setbase
import settings.setcore

export { load, page, rects, owns, toggle }

const RECT_NAME_BYTES: u64 = 8

static mut m_note: [u8; 26] = "settings.autostart.note\0\0\0"
static mut m_system: [u8; 29] = "settings.autostart.system\0\0\0\0"
static mut m_empty: [u8; 26] = "settings.autostart.empty\0\0"
static mut s_page: [u8; 36] = "settings: autostart page entries=\0\0\0"
static mut s_toggle: [u8; 22] = "settings: autostart \0\0"
static mut s_eq_on: [u8; 4] = "=on\0"
static mut s_eq_off: [u8; 5] = "=off\0"
static mut r_prefix: [u8; 4] = "asw\0"
static mut rect_name: [u8; 8] = [0 as u8; 8]

fn owns(id: u64) -> bool {
    return id >= setbase.K_AS0 && id < setbase.K_AS0 + model.MAX_ENTRIES
}

fn load() {
    let n: u64 = autostartsrc.load()
    setcore.say((&s_page[0 as usize]) as u64)
    setcore.sayn(n)
    setcore.nl()
}

fn shown_count() -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < model.count() {
        if model.visible(i) && !model.locked(i) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn services(left: usize) {
    var heading: bool = false
    var i: u64 = 0
    while i < model.count() {
        if model.visible(i) && model.locked(i) {
            if !heading {
                let _h: usize = fuiscene.label_muted(left, msg.get((&m_system[0 as usize]) as u64))
                heading = true
            }
            let _l: usize = fuiscene.label(left, model.name(i))
        }
        i = i + 1
    }
}

fn page(left: usize, right: usize) {
    setbase.rep_due = 1
    let _note: usize = fuiscene.label_wrap(left, msg.get((&m_note[0 as usize]) as u64), 3)
    if shown_count() == 0 {
        let _e: usize = fuiscene.label_muted(left, msg.get((&m_empty[0 as usize]) as u64))
    }
    var i: u64 = 0
    while i < model.count() {
        if model.visible(i) && !model.locked(i) {
            let _t: usize = fuiscene.toggle(left, model.name(i), setbase.K_AS0 + i, model.enabled(i))
        }
        i = i + 1
    }
    services(left)
}

fn rects() {
    var i: u64 = 0
    while i < model.count() {
        if model.visible(i) && !model.locked(i) {
            let p: u64 = (&rect_name[0 as usize]) as u64
            var n: u64 = 0
            while n < 3 {
                octets.st8(p, n, octets.ld8((&r_prefix[0 as usize]) as u64, n))
                n = n + 1
            }
            let digits: u64 = text.digits(i, p + 3, false)
            octets.st8(p, 3 + digits, 0)
            setcore.rect_say(p, setbase.K_AS0 + i)
        }
        i = i + 1
    }
}

fn toggle(id: u64) {
    let i: u64 = id - setbase.K_AS0
    let on: bool = (fuiscene.value_of(id) as u64) != 0
    if !model.set_enabled(i, on) {
        fuiscene.refresh()
        return
    }
    let _saved: bool = autostartsrc.save(i)
    setcore.say((&s_toggle[0 as usize]) as u64)
    setcore.say(model.name(i))
    if on {
        setcore.say((&s_eq_on[0 as usize]) as u64)
    } else {
        setcore.say((&s_eq_off[0 as usize]) as u64)
    }
    setcore.nl()
    fuiscene.refresh()
}
