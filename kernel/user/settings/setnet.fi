profile app

import ulib
import msg
import actcli
import fuiscene
import settings.setbase
import settings.setcore
import settings.setpages
import settings.setsystem
import netdiag.dnsguard

export { apply, mode_init }

const SYS_NETSET: u64 = 1301

static mut t_net: [u8; 18] = "/etc/network.conf\0"
static mut t_dhcp: [u8; 10] = "/bin/dhcp\0"
static mut k_ndh: [u8; 9] = "net.dhcp\0"
static mut k_true: [u8; 5] = "true\0"
static mut k_m_net: [u8; 28] = "settings.status.net_written\0"
static mut k_m_netzno: [u8; 24] = "settings.status.net_bad\0"
static mut k_m_netzr: [u8; 27] = "settings.status.net_denied\0"
static mut k_m_dhcp: [u8; 29] = "settings.status.dhcp_started\0"
static mut k_m_dhcpf: [u8; 28] = "settings.status.dhcp_failed\0"
static mut k_m_dhcpw: [u8; 29] = "settings.status.dhcp_unsaved\0"
static mut k_dh: [u8; 12] = "modus=dhcp\n\0"
static mut k_fe: [u8; 15] = "modus=fest\nip=\0"
static mut k_mk: [u8; 8] = "\nmaske=\0"
static mut k_gw: [u8; 10] = "\ngateway=\0"
static mut k_nl: [u8; 2] = "\n\0"
static mut k_trace_a: [u8; 25] = "settings: net fields ip=\0"
static mut k_trace_b: [u8; 7] = " mask=\0"
static mut k_trace_c: [u8; 5] = " gw=\0"
static mut k_key_ip: [u8; 4] = "ip=\0"
static mut k_key_mask: [u8; 7] = "maske=\0"
static mut k_key_gw: [u8; 9] = "gateway=\0"
static mut k_key_dns: [u8; 5] = "dns=\0"
static mut k_gw_dns: [u8; 6] = "\ndns=\0"
static mut k_trace_d: [u8; 6] = " dns=\0"
const MODE_AUTOMATIC: u64 = 0
const MODE_FIXED: u64 = 1
const CONF_MAX: u64 = 256

fn mode_read() -> u64 {
    var buf: [u8; 256] = [0 as u8; 256]
    let n: u64 = setcore.file_read((&t_net[0 as usize]) as u64, (&buf[0 as usize]) as u64, CONF_MAX)
    if n >= 10 && buf[0 as usize] == 109 as u8 && buf[5 as usize] == 61 as u8 && buf[6 as usize] == 100 as u8 && buf[7 as usize] == 104 as u8 && buf[8 as usize] == 99 as u8 {
        return MODE_AUTOMATIC
    }
    return MODE_FIXED
}

fn key_matches(buf: u64, at: u64, key: u64) -> bool {
    var k: u64 = 0
    while __mmio_read8((key + k) as *mut u8) as u64 != 0 {
        if __mmio_read8((buf + at + k) as *mut u8) != __mmio_read8((key + k) as *mut u8) {
            return false
        }
        k = k + 1
    }
    return true
}

fn key_length(key: u64) -> u64 {
    var k: u64 = 0
    while __mmio_read8((key + k) as *mut u8) as u64 != 0 {
        k = k + 1
    }
    return k
}

fn conf_fill(buf: u64, n: u64, key: u64, dst: u64) {
    var at: u64 = 0
    let klen: u64 = key_length(key)
    while at < n {
        if key_matches(buf, at, key) {
            var j: u64 = 0
            while j < 20 && at + klen + j < n {
                let c: u64 = __mmio_read8((buf + at + klen + j) as *mut u8) as u64
                if c == 10 || c == 13 || c == 0 {
                    break
                }
                __mmio_write8((dst + j) as *mut u8, c as u8)
                j = j + 1
            }
            __mmio_write8((dst + j) as *mut u8, 0 as u8)
            if setcore.ip_read(dst) == 0 {
                __mmio_write8(dst as *mut u8, 0 as u8)
            }
            return
        }
        while at < n && __mmio_read8((buf + at) as *mut u8) as u64 != 10 {
            at = at + 1
        }
        at = at + 1
    }
}

fn fields_from_conf() {
    var buf: [u8; 256] = [0 as u8; 256]
    let b: u64 = (&buf[0 as usize]) as u64
    let n: u64 = setcore.file_read((&t_net[0 as usize]) as u64, b, CONF_MAX)
    if n == 0 {
        return
    }
    conf_fill(b, n, (&k_key_ip[0 as usize]) as u64, (&setbase.e_ip[0 as usize]) as u64)
    conf_fill(b, n, (&k_key_mask[0 as usize]) as u64, (&setbase.e_maske[0 as usize]) as u64)
    conf_fill(b, n, (&k_key_gw[0 as usize]) as u64, (&setbase.e_gw[0 as usize]) as u64)
    conf_fill(b, n, (&k_key_dns[0 as usize]) as u64, (&setbase.e_dns[0 as usize]) as u64)
    var line: [u8; 144] = [0 as u8; 144]
    var a: u64 = setcore.text_an((&line[0 as usize]) as u64, 0, (&k_trace_a[0 as usize]) as u64)
    a = setcore.text_an((&line[0 as usize]) as u64, a, (&setbase.e_ip[0 as usize]) as u64)
    a = setcore.text_an((&line[0 as usize]) as u64, a, (&k_trace_b[0 as usize]) as u64)
    a = setcore.text_an((&line[0 as usize]) as u64, a, (&setbase.e_maske[0 as usize]) as u64)
    a = setcore.text_an((&line[0 as usize]) as u64, a, (&k_trace_c[0 as usize]) as u64)
    a = setcore.text_an((&line[0 as usize]) as u64, a, (&setbase.e_gw[0 as usize]) as u64)
    a = setcore.text_an((&line[0 as usize]) as u64, a, (&k_trace_d[0 as usize]) as u64)
    a = setcore.text_an((&line[0 as usize]) as u64, a, (&setbase.e_dns[0 as usize]) as u64)
    setcore.say((&line[0 as usize]) as u64)
    setcore.nl()
    fuiscene.entry_set(setbase.K_EN1, (&setbase.e_ip[0 as usize]) as u64)
    fuiscene.entry_set(setbase.K_EN2, (&setbase.e_maske[0 as usize]) as u64)
    fuiscene.entry_set(setbase.K_EN3, (&setbase.e_gw[0 as usize]) as u64)
    fuiscene.entry_set(setbase.K_EN4, (&setbase.e_dns[0 as usize]) as u64)
}

fn mode_init() {
    let m: u64 = mode_read()
    setbase.kval[(setbase.K_CN) as usize] = m
    if m == MODE_FIXED {
        fields_from_conf()
    }
}

fn status_from_bus() {
    let _cb: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, (&setbase.l_systat[0 as usize]) as u64)
}

fn apply_dhcp_file() {
    var buf: [u8; 24] = [0 as u8; 24]
    let n: u64 = setcore.text_an((&buf[0 as usize]) as u64, 0, (&k_dh[0 as usize]) as u64)
    if !setcore.file_write((&t_net[0 as usize]) as u64, (&buf[0 as usize]) as u64, n) {
        let _u: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_m_dhcpw[0 as usize]) as u64))
        return
    }
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, (&t_dhcp[0 as usize]) as u64, 0, 0)
    if ulib.bad(pid) {
        let _f: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_m_dhcpf[0 as usize]) as u64))
        return
    }
    let a: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_m_dhcp[0 as usize]) as u64))
    let _z: u64 = setcore.num_at((&setbase.l_stat[0 as usize]) as u64, a, pid)
}

fn apply_fixed() {
    let vip: u64 = setcore.ip_read((&setbase.e_ip[0 as usize]) as u64)
    let vmk: u64 = setcore.ip_read((&setbase.e_maske[0 as usize]) as u64)
    let vgw: u64 = setcore.ip_read((&setbase.e_gw[0 as usize]) as u64)
    var vdns: u64 = 0
    if setbase.e_dns[0 as usize] != 0 as u8 {
        vdns = setcore.ip_read((&setbase.e_dns[0 as usize]) as u64)
        if vdns == 0 {
            let _b: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_m_netzno[0 as usize]) as u64))
            return
        }
    }
    if vip == 0 || vmk == 0 {
        let _s: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_m_netzno[0 as usize]) as u64))
        return
    }
    let brc: u64 = setsystem.net_fixed_bus((&setbase.e_ip[0 as usize]) as u64, (&setbase.e_maske[0 as usize]) as u64, (&setbase.e_gw[0 as usize]) as u64, (&setbase.e_dns[0 as usize]) as u64)
    if brc != actcli.R_NOBUS {
        status_from_bus()
        return
    }
    if ulib.bad(ulib.sys(SYS_NETSET, vip, vmk, vgw)) {
        let _d: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_m_netzr[0 as usize]) as u64))
        return
    }
    var buf: [u8; 128] = [0 as u8; 128]
    var a: u64 = setcore.text_an((&buf[0 as usize]) as u64, 0, (&k_fe[0 as usize]) as u64)
    a = setcore.ip_an((&buf[0 as usize]) as u64, a, vip)
    a = setcore.text_an((&buf[0 as usize]) as u64, a, (&k_mk[0 as usize]) as u64)
    a = setcore.ip_an((&buf[0 as usize]) as u64, a, vmk)
    a = setcore.text_an((&buf[0 as usize]) as u64, a, (&k_gw[0 as usize]) as u64)
    a = setcore.ip_an((&buf[0 as usize]) as u64, a, vgw)
    if vdns != 0 {
        a = setcore.text_an((&buf[0 as usize]) as u64, a, (&k_gw_dns[0 as usize]) as u64)
        a = setcore.ip_an((&buf[0 as usize]) as u64, a, vdns)
    }
    a = setcore.text_an((&buf[0 as usize]) as u64, a, (&k_nl[0 as usize]) as u64)
    if vdns != 0 {
        let _d: u64 = dnsguard.set_primary(vdns)
    }
    let _w: bool = setcore.file_write((&t_net[0 as usize]) as u64, (&buf[0 as usize]) as u64, a)
    let _s: u64 = setcore.text_an((&setbase.l_stat[0 as usize]) as u64, 0, msg.get((&k_m_net[0 as usize]) as u64))
}

fn apply() {
    if setbase.kval[(setbase.K_CN) as usize] == MODE_AUTOMATIC {
        if setpages.bus_set((&k_ndh[0 as usize]) as u64, (&k_true[0 as usize]) as u64) != actcli.R_NOBUS {
            status_from_bus()
        } else {
            apply_dhcp_file()
        }
    } else {
        apply_fixed()
    }
    setsystem.state_read()
    setpages.report_state()
}
