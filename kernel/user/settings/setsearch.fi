profile app

import fuiscene
import msg
import startlearn
import settings.setbase
import settings.setcore

export { load, page, rects, owns, toggle, reset }

static mut m_note: [u8; 21] = "settings.search.note\0"
static mut m_learn: [u8; 22] = "settings.search.learn\0"
static mut m_reset: [u8; 22] = "settings.search.reset\0"
static mut m_cleared: [u8; 24] = "settings.search.cleared\0"
static mut r_learn: [u8; 5] = "srln\0"
static mut r_reset: [u8; 5] = "srrs\0"
static mut s_on: [u8; 26] = "settings: search learn=on\0"
static mut s_off: [u8; 27] = "settings: search learn=off\0"
static mut s_clear: [u8; 27] = "settings: search history 0\0"
static mut learn_on: bool = true
static mut cleared: bool = false

fn owns(id: u64) -> bool {
    return id == setbase.K_SEARCH_LEARN || id == setbase.K_SEARCH_RESET
}

fn trace() {
    if learn_on {
        setcore.say((&s_on[0 as usize]) as u64)
    } else {
        setcore.say((&s_off[0 as usize]) as u64)
    }
    setcore.nl()
}

fn load() {
    startlearn.sync()
    learn_on = startlearn.is_enabled()
    trace()
}

fn page(left: usize, right: usize) {
    let _note: usize = fuiscene.label_wrap(left, msg.get((&m_note[0 as usize]) as u64), 3)
    let _sw: usize = fuiscene.toggle(left, msg.get((&m_learn[0 as usize]) as u64), setbase.K_SEARCH_LEARN, learn_on)
    let _rs: usize = fuiscene.button(left, msg.get((&m_reset[0 as usize]) as u64), setbase.K_SEARCH_RESET)
    if cleared {
        let _ok: usize = fuiscene.label_muted(left, msg.get((&m_cleared[0 as usize]) as u64))
    }
}

fn rects() {
    setcore.rect_say((&r_learn[0 as usize]) as u64, setbase.K_SEARCH_LEARN)
    setcore.rect_say((&r_reset[0 as usize]) as u64, setbase.K_SEARCH_RESET)
}

fn toggle() {
    cleared = false
    startlearn.set_enabled((fuiscene.value_of(setbase.K_SEARCH_LEARN) as u64) != 0)
    load()
    fuiscene.refresh()
}

fn reset() {
    startlearn.reset_all()
    cleared = true
    setcore.say((&s_clear[0 as usize]) as u64)
    setcore.nl()
    fuiscene.refresh()
}
