const TI_INFO: u64 = 0

const TQ_ARMED: u64 = 0

const TQ_TOTAL: u64 = 3

const TQ_DENIED: u64 = 4

static mut k_n_kprog: [u8; 24] = "settings.net.cols.prog\0\0"

static mut k_anb_n: u64 = 0

static mut k_aus: [u8; 4096] = [0 as u8; 4096]

static mut k_ausn: u64 = 0

const SYS_PIPE: u64 = 22

static mut k_v_acc: [u8; 26] = "settings.presets.account\0\0"

