
profile kernel

import ulib
import libc.text
import libc.io
import libc.clockapi
import tools

export { u_start }

static mut buf: [u8; 2048] = [0 as u8; 2048]

fn show_state() -> u64 {
    var path: [u8; 15] = "/run/svc.state\0"
    var b: [u8; 1024] = [0 as u8; 1024]
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&path[0]) as u64, 0, 0)
    if ulib.bad(fd) {
        return 1
    }
    var going: bool = true
    while going {
        let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&b[0]) as u64, 1024)
        if ulib.bad(n) || n == 0 {
            going = false
        } else {
            ulib.put((&b[0]) as u64, n)
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return 0
}

fn ob_left(p: u64, w: u64) {
    let n: u64 = text.length(p)
    tools.ob_str(p)
    var i: u64 = n
    while i < w {
        tools.ob_byte(32)
        i = i + 1
    }
}

fn ob_dur(ms: u64) {
    tools.ob_num(ms / 1000)
    tools.ob_byte(46)
    tools.ob_num((ms % 1000) / 100)
    tools.ob_byte(115)
}

fn table() -> u64 {
    var path: [u8; 15] = "/run/svc.state\0"
    var h1: [u8; 8] = "SERVICE\0"
    var h2: [u8; 6] = "STATE\0"
    var h3: [u8; 4] = "PID\0"
    var h4: [u8; 7] = "STARTS\0"
    var h5: [u8; 7] = "ERRORS\0"
    var h6: [u8; 7] = "UPTIME\0"
    var h7: [u8; 7] = "TARGET\0"
    var w_run: [u8; 8] = "running\0"
    var e_no: [u8; 32] = "svc: /run/svc.state fehlt\0\0\0\0\0\0\0"
    var stroke: [u8; 2] = "-\0"
    var name: [u8; 40] = [0 as u8; 40]
    var zust: [u8; 24] = [0 as u8; 24]
    var f: [u8; 32] = [0 as u8; 32]
    var line: [u8; 256] = [0 as u8; 256]

    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&path[0]) as u64, 0, 0)
    if ulib.bad(fd) {
        ulib.esay_line((&e_no[0]) as u64, 0)
        return 1
    }
    var at: u64 = 0
    var going: bool = true
    while going {
        let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&buf[at as usize]) as u64,
            2048 - at - 1)
        if ulib.bad(n) || n == 0 {
            going = false
        } else {
            at = at + n
        }
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    __mmio_write8((&buf[at as usize]) as u64 as *mut u8, 0 as u8)

    let now: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_UPTIME, 0, 0)

    ob_left((&h1[0]) as u64, 17)
    ob_left((&h2[0]) as u64, 10)
    tools.ob_str((&h3[0]) as u64)
    tools.ob_byte(32)
    tools.ob_byte(32)
    ob_left((&h4[0]) as u64, 8)
    ob_left((&h5[0]) as u64, 8)
    ob_left((&h6[0]) as u64, 10)
    tools.ob_str((&h7[0]) as u64)
    tools.ob_nl()

    var laufen: u64 = 0
    var all: u64 = 0
    var pos: u64 = 0
    while pos < at {
        var k: u64 = 0
        while pos + k < at && buf[(pos + k) as usize] != 10 as u8 && k < 255 {
            line[k as usize] = buf[(pos + k) as usize]
            k = k + 1
        }
        line[k as usize] = 0 as u8
        pos = pos + k + 1
        if line[0 as usize] != 0 as u8 {
            all = all + 1
            var p: u64 = ulib.word((&line[0]) as u64, 0, (&name[0]) as u64, 40)
            p = ulib.word((&line[0]) as u64, p, (&zust[0]) as u64, 24)
            ob_left((&name[0]) as u64, 17)
            ob_left((&zust[0]) as u64, 10)
            p = ulib.word((&line[0]) as u64, p, (&f[0]) as u64, 32)
            tools.ob_pad(ulib.to_num((&f[0]) as u64), 3)
            tools.ob_byte(32)
            tools.ob_byte(32)
            p = ulib.word((&line[0]) as u64, p, (&f[0]) as u64, 32)
            tools.ob_pad(ulib.to_num((&f[0]) as u64), 4)
            tools.ob_byte(32)
            tools.ob_byte(32)
            tools.ob_byte(32)
            tools.ob_byte(32)
            p = ulib.word((&line[0]) as u64, p, (&f[0]) as u64, 32)
            tools.ob_pad(ulib.to_num((&f[0]) as u64), 4)
            tools.ob_byte(32)
            tools.ob_byte(32)
            tools.ob_byte(32)
            tools.ob_byte(32)
            p = ulib.word((&line[0]) as u64, p, (&f[0]) as u64, 32)
            let seit: u64 = ulib.to_num((&f[0]) as u64)
            var wide: u64 = 0
            if ulib.streq((&zust[0]) as u64, (&w_run[0]) as u64) {
                laufen = laufen + 1
                if seit != 0 && now >= seit {
                    ob_dur(now -% seit)
                    wide = 1
                }
            }
            if wide == 0 {
                tools.ob_str((&stroke[0]) as u64)
            }
            tools.ob_byte(32)
            tools.ob_byte(32)
            tools.ob_byte(32)
            ulib.word((&line[0]) as u64, p, (&f[0]) as u64, 32)
            tools.ob_str((&f[0]) as u64)
            tools.ob_nl()
        }
    }
    var s_sum: [u8; 4] = " / \0"
    var s_lauf: [u8; 20] = " Dienste laufen\0\0\0\0\0"
    tools.ob_num(laufen)
    tools.ob_str((&s_sum[0]) as u64)
    tools.ob_num(all)
    tools.ob_str((&s_lauf[0]) as u64)
    tools.ob_nl()
    tools.ob_flush()
    return 0
}

fn send(verb: u64, who: u64) -> u64 {
    var path: [u8; 13] = "/run/svc.cmd\0"
    var line: [u8; 128] = [0 as u8; 128]
    var sp: [u8; 2] = " \0"
    var nlc: [u8; 2] = "\n\0"
    var e_no: [u8; 35] = "svc: /run/svc.cmd nicht schreibbar\0"
    var at: u64 = ulib.strcpy((&line[0]) as u64, verb)
    if who != 0 {
        at = at + ulib.strcpy((&line[at as usize]) as u64, (&sp[0]) as u64)
        at = at + ulib.strcpy((&line[at as usize]) as u64, who)
    }
    at = at + ulib.strcpy((&line[at as usize]) as u64, (&nlc[0]) as u64)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&path[0]) as u64, 577, 0)
    if ulib.bad(fd) {
        ulib.esay_line((&e_no[0]) as u64, 0)
        return 1
    }
    ulib.sys(ulib.SYS_WRITE, fd, (&line[0]) as u64, at)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return 0
}

fn wait_done() -> bool {
    var path: [u8; 13] = "/run/svc.cmd\0"
    var round: u64 = 0
    while round < 40 {
        if io.size_of((&path[0]) as u64) == 0 {
            clockapi.sleep_ms(60)
            return true
        }
        clockapi.sleep_ms(25)
        round = round + 1
    }
    return false
}

fn show_target() -> u64 {
    var path: [u8; 10] = "/etc/ziel\0"
    var b: [u8; 64] = [0 as u8; 64]
    var w_kon: [u8; 9] = "konsole\n\0"
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, (&path[0]) as u64, 0, 0)
    if ulib.bad(fd) {
        ulib.say((&w_kon[0]) as u64)
        return 0
    }
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&b[0]) as u64, 63)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) || n == 0 {
        ulib.say((&w_kon[0]) as u64)
        return 0
    }
    ulib.put((&b[0]) as u64, n)
    if b[(n - 1) as usize] != 10 as u8 {
        ulib.nl()
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var w_status: [u8; 7] = "status\0"
    var w_list: [u8; 5] = "list\0"
    var w_start: [u8; 6] = "start\0"
    var w_stop: [u8; 5] = "stop\0"
    var w_rest: [u8; 8] = "restart\0"
    var w_down: [u8; 9] = "shutdown\0"
    var w_boot: [u8; 7] = "reboot\0"
    var w_target: [u8; 5] = "ziel\0"
    var w_target_new: [u8; 7] = "target\0"
    var e_use: [u8; 70] =
        "svc: svc [list|status|target|start|stop|restart NAME|shutdown|reboot]\0"
    var e_noinit: [u8; 28] = "svc: init antwortet nicht\0\0\0"
    var e_nostate: [u8; 32] = "svc: /run/svc.state fehlt\0\0\0\0\0\0\0"

    let n: u64 = ulib.arg_count(args)
    if n < 2 {
        return table()
    }
    let verb: u64 = ulib.arg_at(args, 1)
    if ulib.streq(verb, (&w_list[0]) as u64) {
        return table()
    }
    if ulib.streq(verb, (&w_target[0]) as u64) || ulib.streq(verb, (&w_target_new[0]) as u64) {
        return show_target()
    }
    if ulib.streq(verb, (&w_status[0]) as u64) {
        if show_state() != 0 {
            ulib.esay_line((&e_nostate[0]) as u64, 0)
            return 1
        }
        return 0
    }
    if ulib.streq(verb, (&w_down[0]) as u64)
        || ulib.streq(verb, (&w_boot[0]) as u64) {
        return send(verb, 0)
    }
    if !ulib.streq(verb, (&w_start[0]) as u64)
        && !ulib.streq(verb, (&w_stop[0]) as u64)
        && !ulib.streq(verb, (&w_rest[0]) as u64) {
        ulib.esay_line((&e_use[0]) as u64, 0)
        return 2
    }
    if n < 3 {
        ulib.esay_line((&e_use[0]) as u64, 0)
        return 2
    }
    let rc: u64 = send(verb, ulib.arg_at(args, 2))
    if rc != 0 {
        return rc
    }
    if !wait_done() {
        ulib.esay_line((&e_noinit[0]) as u64, 0)
        return 1
    }
    return show_state()
}
