profile kernel

import filelog.filelog
import instkern

export {
    note, reason, step, detail, key, log_step, log_failure, log_start,
    R_NONE, R_PROTECTED, R_UNLOCK, R_OPEN_TARGET, R_OPEN_SOURCE, R_TOO_SMALL, R_SOURCE_BAD,
    R_NO_KERNEL, R_ACCOUNT, R_GPT, R_ESP, R_COPY, R_GROW, R_BOOT, R_TIMEOUT, R_CANCEL
}

const R_NONE: u64 = 0
const R_PROTECTED: u64 = 1
const R_UNLOCK: u64 = 2
const R_OPEN_TARGET: u64 = 3
const R_OPEN_SOURCE: u64 = 4
const R_TOO_SMALL: u64 = 5
const R_SOURCE_BAD: u64 = 6
const R_NO_KERNEL: u64 = 7
const R_ACCOUNT: u64 = 8
const R_GPT: u64 = 9
const R_ESP: u64 = 10
const R_COPY: u64 = 11
const R_GROW: u64 = 12
const R_BOOT: u64 = 13
const R_TIMEOUT: u64 = 14
const R_CANCEL: u64 = 15
const DIGIT_AT: u64 = 18

static mut PATH_LOG: [u8; 21] = "/var/log/install.log\0"
static mut TAG_START: [u8; 6] = "start\0"
static mut TAG_STEP: [u8; 5] = "step\0"
static mut TAG_FAIL: [u8; 5] = "fail\0"
static mut K_DISK: [u8; 5] = "disk\0"
static mut K_SECTORS: [u8; 8] = "sectors\0"
static mut K_NR: [u8; 2] = "n\0"
static mut K_PERMILLE: [u8; 9] = "permille\0"
static mut K_REASON: [u8; 7] = "reason\0"
static mut K_STEP: [u8; 5] = "step\0"
static mut K_CODE: [u8; 5] = "code\0"
static mut K_DETAIL: [u8; 7] = "detail\0"
static mut KEY_BUF: [u8; 24] = "installer.fail.r00\0\0\0\0\0\0"
static mut g_reason: u64 = 0
static mut g_step: u64 = 0
static mut g_detail: u64 = 0

fn note(why: u64, at_step: u64, info: u64) {
    g_reason = why
    g_step = at_step
    g_detail = info
}

fn reason() -> u64 {
    return g_reason
}

fn step() -> u64 {
    return g_step
}

fn detail() -> u64 {
    return g_detail
}

fn key() -> u64 {
    KEY_BUF[DIGIT_AT as usize] = (48 + g_reason / 10) as u8
    KEY_BUF[(DIGIT_AT + 1) as usize] = (48 + g_reason % 10) as u8
    return (&KEY_BUF[0 as usize]) as u64
}

fn log_start(dev: u64, sectors: u64) {
    filelog.begin((&PATH_LOG[0 as usize]) as u64, (&TAG_START[0 as usize]) as u64)
    filelog.text((&K_DISK[0 as usize]) as u64, dev)
    filelog.num((&K_SECTORS[0 as usize]) as u64, sectors)
    filelog.end()
}

fn log_step(nr: u64, permille: u64) {
    filelog.begin((&PATH_LOG[0 as usize]) as u64, (&TAG_STEP[0 as usize]) as u64)
    filelog.num((&K_NR[0 as usize]) as u64, nr)
    filelog.num((&K_PERMILLE[0 as usize]) as u64, permille)
    filelog.end()
}

fn log_failure() {
    filelog.begin((&PATH_LOG[0 as usize]) as u64, (&TAG_FAIL[0 as usize]) as u64)
    filelog.num((&K_REASON[0 as usize]) as u64, g_reason)
    filelog.num((&K_STEP[0 as usize]) as u64, g_step)
    filelog.num((&K_CODE[0 as usize]) as u64, instkern.error_at())
    filelog.num((&K_DETAIL[0 as usize]) as u64, g_detail)
    filelog.end()
}
