// SPDX-License-Identifier: MIT
// kernel/user/nidx.fi -- Runde K15, zweiter Nachtrag: DER NAMENSINDEX.
// Ring 3, eine Bibliothek ohne `u_start`, wie `ulib.fi` und `wlib.fi`.
//
// WAS "EVERYTHING" WIRKLICH MACHT, und warum das hier nachbaubar ist.
// Das Programm von voidtools durchsucht die Platte NICHT. Es liest
// EINMAL die Master File Table von NTFS am Stueck -- die Tabelle, die
// das Dateisystem ohnehin fuer jede Datei fuehrt -- und baut daraus im
// Arbeitsspeicher eine Liste NUR AUS NAMEN. Ein frisches Windows mit
// rund 120 000 Dateien ist dadurch in etwa einer Sekunde erfasst. Danach
// sieht es die Tabelle nie wieder an, sondern verfolgt das
// Aenderungsjournal (USN) und traegt nach. Es ist deshalb sofort da:
// gesucht wird in einer Namensliste im Speicher, nicht auf der Platte,
// und indiziert werden Namen, keine Inhalte.
//
// BEIDE HAELFTEN GIBT ES IN OSUM SEIT DEM ZWEITEN NACHTRAG:
//   * `WIG_SCAN` (1807) laeuft EINMAL durch die Inode-Tabelle und gibt
//     die Verzeichniseintraege heraus, ohne einen einzigen Pfad
//     aufzuloesen (`kernel/fs.fi`, `scan`).
//   * `WIG_JRNL` (1808) holt die Aenderungen ab, die `fs.dir_add` und
//     `fs.dir_remove` seither eingetragen haben (`kernel/nidx.fi`).
//
// WAS HIER STEHT, IST DIE HAELFTE IN RING 3: die Namensliste, das
// Nachziehen und die Suche. Und daneben -- absichtlich in derselben
// Datei -- DER BAUMDURCHLAUF, gegen den sich der Index beweisen muss.
// Beide beantworten dieselbe Frage; sie muessen dieselben Treffer
// liefern, sonst luegt der Index. Sie in getrennten Programmen zu haben
// waere bequemer und waere schwaecher: so laufen sie im selben Prozess,
// auf demselben Dateisystem, im selben Augenblick.
//
// WAS DER INDEX NICHT KANN, und es gehoert nach vorn:
//   * Er ueberlebt keinen Neustart. Das Journal liegt im Speicher des
//     Kernels, nicht auf der Platte -- die Begruendung fuer diesen
//     Handel steht in `kernel/nidx.fi`.
//   * Er haelt 4200 Namen. Darueber sagt `build` "abgeschnitten" statt
//     stillschweigend die Haelfte zu vergessen.
//   * Er sucht in NAMEN. Nicht in Inhalten. Genau wie das Vorbild.
//
// RUNDE SPEICHER, DRITTER NACHTRAG: DER INDEX TRAEGT AUCH DIE GROESSE,
// UND ER SUMMIERT SIE DEN BAUM HINAUF.
//
// TreeSize und WizTree muessen beim Start jedes Mal die Platte
// durchlaufen -- das ist der ganze Grund, warum sie einen Fortschritts-
// balken haben. Osum muss das nicht: die Inode-Tabelle traegt die
// Groesse ohnehin (`fs.scan` liefert sie seit dem zweiten Nachtrag im
// Feld R_SIZE), und das Journal meldet seit dieser Runde auch, dass eine
// Datei gewachsen oder geschrumpft ist. Was hier dazukommt, ist die
// AUFSUMMIERUNG: fuer jedes Verzeichnis steht die Gesamtgroesse seines
// Teilbaums als Zahl da, ohne dass jemand hineinsieht.
//
// WIE DAS GEHT, UND ES IST EINE ZEILE ARITHMETIK: eine Datei traegt ihre
// Groesse zu JEDEM ihrer Vorfahren bei. Also wird beim Aufbau je Datei
// die Elternkette hinaufgelaufen und die Groesse aufaddiert -- acht
// Ebenen tief, nicht 4000. Und bei jeder spaeteren Aenderung wird
// GENAUSO die Kette hinaufgelaufen, aber nur mit dem UNTERSCHIED. Das
// ist der Unterschied zwischen "sofort" und "gleich".
//
// DAMIT DAS BILLIG BLEIBT, BRAUCHT ES EINEN WEG VON EINER INODE-NUMMER
// ZU IHREM PLATZ IN DER LISTE. `path_of` sucht ihn linear, und das ist
// dort richtig: es passiert fuer die paar Treffer, die jemand ansieht.
// Beim Hinaufsummieren waere es 4200 * 8 Durchgaenge ueber 4200 Namen.
// Also gibt es eine Tafel: `dio[Inode] = Platz + 1`, direkt adressiert,
// keine Streuung und keine Kollision. Sie fasst HN Inodes; ein Abbild
// mit mehr faellt auf den linearen Weg zurueck und ist dann langsam,
// aber nicht falsch -- und `dio_voll` sagt, dass es passiert ist.
//
// WAS GEZAEHLT WIRD, IST DASSELBE WIE BEI `du`: die GROESSE der Dateien,
// ein Verzeichnis zaehlt NULL. Nicht der belegte Platz, nicht die
// Eintragstabelle des Verzeichnisses. Der Grund ist die Gegenprobe --
// `walk_total` weiter unten laeuft den Baum wirklich ab und muss auf
// dasselbe Oktett kommen, und `du` seit Runde K11 auch. Drei Wege, eine
// Zahl.

profile kernel

import ulib
import libc.io
import libc.kcall

export {
    build, poll, find, count, name_at, ino_at, kind_at, parent_at,
    path_of, walk_find, walk_seen, contains, lower,
    calls, records, truncated, lost_seen, seq_now, mono_us,
    MAXN, NAMEN,
    // ---- Runde SPEICHER ----
    size_build, size_at, sub_at, blk_at, slot_of_ino, root_ino,
    total_of_ino, blocks_of_ino, kilo, is_dir_at, dio_voll,
    walk_total, walk_blocks, walk_files, walk_dirs, ino_of_path,
    ROOT, NICHTS
}

const MAXN: u64 = 4200
const NAMEN: u64 = 24 // wie ein Verzeichniseintrag in OFS

// Der Satz, den Kernel und Ring 3 teilen -- 64 Oktette, dieselben
// Felder beim Tabellenlauf wie im Journal (`kernel/nidx.fi`).
const REC: u64 = 64
const R_INO: u64 = 0
const R_PARENT: u64 = 8
const R_SIZE: u64 = 16
const R_KIND: u64 = 24
const R_NAME: u64 = 32
const R_OP: u64 = 56

const OP_ADD: u64 = 1
const OP_DEL: u64 = 2
const OP_SIZE: u64 = 3

const K_DIR: u64 = 2

const WIG_SCAN: u64 = 1807
const WIG_JRNL: u64 = 1808
const WIG_IDXINFO: u64 = 1809
const WX_JSEQ: u64 = 2
const WX_JLOST: u64 = 3
const WX_ROOT: u64 = 6

// RUNDE SPEICHER. `ROOT` ist der Platz der WURZEL in den Summenfeldern:
// sie hat keinen Verzeichniseintrag und steht deshalb in keiner
// Namensliste -- aber eine Summe hat sie. `NICHTS` heisst "diese Inode
// kenne ich nicht".
const ROOT: u64 = 4200 // == MAXN
const NICHTS: u64 = 4201
const HN: u64 = 8192 // so viele Inodes fasst die Platztafel

const SYS_CLOCK_GETTIME: u64 = 228
const CLOCK_MONOTONIC: u64 = 1

// STAPEL VON SATZ-PUFFERN: 63 Saetze je Aufruf, so viel wie der Kernel
// in eine Seite legt.
const STAPEL: u64 = 63

static mut nm: [u8; 100800] = [0 as u8; 100800] // MAXN * NAMEN
static mut pino: [u32; 4200] = [0 as u32; 4200]
static mut ino_: [u32; 4200] = [0 as u32; 4200]
static mut art: [u8; 4200] = [0 as u8; 4200]
static mut nn: u64 = 0
static mut jseq: u64 = 0
static mut jlost: u64 = 0
static mut abgeschnitten: u64 = 0
static mut aufrufe: u64 = 0
static mut saetze: u64 = 0
static mut puffer: [u8; 4032] = [0 as u8; 4032] // STAPEL * REC
static mut lauf: [u64; 2] = [0 as u64; 2]
static mut gesehen: u64 = 0

// ---- Runde SPEICHER: die Groessen -----------------------------------
//
// `groesse` ist die EIGENE Groesse eines Eintrags (bei einem Verzeichnis
// bedeutungslos, es zaehlt null). `summe` und `kbsumme` sind die
// GESAMTGROESSE des Teilbaums -- Oktette und Kilooktett-Bloecke, letztere
// je Datei aufgerundet, weil `du` so rechnet. Beide haben einen Platz
// mehr als es Eintraege gibt: der letzte (`ROOT`) gehoert der Wurzel.
static mut groesse: [u32; 4200] = [0 as u32; 4200]
static mut summe: [u64; 4201] = [0 as u64; 4201]
static mut kbsumme: [u64; 4201] = [0 as u64; 4201]
static mut dio: [u32; 8192] = [0 as u32; 8192]
static mut wurzel: u64 = 0
static mut ueberlauf: u64 = 0

fn sys3(number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

// Mikrosekunden von der monotonen Uhr. Sie ist mit geeichtem
// Zyklenzaehler auf die Nanosekunde genau (`kernel/time.fi`), und ohne
// ihn auf zehn Millisekunden -- das steht bei jeder Messung dabei, weil
// eine Zahl ohne ihre Koernung eine Behauptung ist.
fn mono_us() -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    kcall.sys2(SYS_CLOCK_GETTIME, CLOCK_MONOTONIC, (&ts[0 as usize]) as u64)
    return ts[0 as usize] *% 1000000 +% ts[1 as usize] / 1000
}

fn count() -> u64 {
    return nn
}

fn calls() -> u64 {
    return aufrufe
}

fn records() -> u64 {
    return saetze
}

fn truncated() -> u64 {
    return abgeschnitten
}

fn lost_seen() -> u64 {
    return jlost
}

fn seq_now() -> u64 {
    return jseq
}

fn name_at(i: u64) -> u64 {
    return (&nm[0 as usize]) as u64 + i * NAMEN
}

fn ino_at(i: u64) -> u64 {
    return ino_[(i) as usize] as u64
}

fn parent_at(i: u64) -> u64 {
    return pino[(i) as usize] as u64
}

fn kind_at(i: u64) -> u64 {
    return art[(i) as usize] as u64
}

// -------------------------------------------- RUNDE SPEICHER: Zugriffe

fn is_dir_at(i: u64) -> bool {
    return art[(i) as usize] as u64 == K_DIR
}

fn size_at(i: u64) -> u64 {
    return groesse[(i) as usize] as u64
}

fn sub_at(i: u64) -> u64 {
    return summe[(i) as usize]
}

fn blk_at(i: u64) -> u64 {
    return kbsumme[(i) as usize]
}

fn root_ino() -> u64 {
    return wurzel
}

fn dio_voll() -> u64 {
    return ueberlauf
}

// Aufgerundete Kilooktett-Bloecke -- DIESELBE Zeile wie in
// `kernel/user/du.fi` seit Runde K11. Sie steht hier, damit sie nicht
// zweimal irgendwo steht und beim naechsten Anfassen auseinanderlaeuft.
fn kilo(sz: u64) -> u64 {
    return (sz + 1023) / 1024
}

// DER PLATZ EINER INODE. `ROOT` fuer die Wurzel, `NICHTS`, wenn der
// Index sie nicht kennt.
fn slot_of_ino(ino: u64) -> u64 {
    if ino == 0 {
        return NICHTS
    }
    if ino == wurzel {
        return ROOT
    }
    if ino < HN {
        let v: u64 = dio[(ino) as usize] as u64
        if v == 0 {
            return NICHTS
        }
        return v - 1
    }
    // Der Notweg. Er ist langsam und er ist richtig; `dio_voll` sagt,
    // dass er benutzt wurde.
    ueberlauf = ueberlauf + 1
    var i: u64 = 0
    while i < nn {
        if ino_[(i) as usize] as u64 == ino {
            return i
        }
        i = i + 1
    }
    return NICHTS
}

fn dio_set(ino: u64, wert: u64) {
    if ino != 0 && ino < HN {
        dio[(ino) as usize] = wert as u32
    }
}

// Die Gesamtgroesse unter einer Inode, in Oktetten. Ohne einen einzigen
// Systemaufruf -- das ist der ganze Punkt dieser Runde.
fn total_of_ino(ino: u64) -> u64 {
    let s2: u64 = slot_of_ino(ino)
    if s2 > ROOT {
        return 0
    }
    return summe[(s2) as usize]
}

fn blocks_of_ino(ino: u64) -> u64 {
    let s2: u64 = slot_of_ino(ino)
    if s2 > ROOT {
        return 0
    }
    return kbsumme[(s2) as usize]
}

// Die Inode-Nummer zu einem Pfad -- ueber `stat`, also ueber den Kernel.
// Das ist der EINE Systemaufruf, den die Oberflaeche braucht, um zu
// wissen, wo sie steht; alles danach kommt aus dem Speicher.
fn ino_of_path(pfad: u64) -> u64 {
    var st: [u8; 144] = [0 as u8; 144]
    let r: u64 = io.stat_into(pfad, (&st[0 as usize]) as u64)
    if ulib.bad(r) {
        return 0
    }
    return __mmio_read64(((&st[0 as usize]) as u64 + io.ST_INO) as *mut u64)
}

// DIE KETTE HINAUF. Jeder Vorfahre bekommt den Betrag dazu (oder
// abgezogen). Acht Ebenen, nicht 4000 -- und `wache` ist da, weil ein
// Verzeichnisbaum, dessen `..` im Kreis zeigt, sonst diese Schleife nie
// verliesse. Ein Index, der haengt, ist schlimmer als einer, der irrt.
fn hoch(eltern: u64, okt: u64, kb: u64, minus: bool) {
    var p: u64 = eltern
    var wache: u64 = 0
    var weiter: bool = true
    while weiter && wache < 32 {
        let j: u64 = slot_of_ino(p)
        if j > ROOT {
            weiter = false
        } else {
            if minus {
                if summe[(j) as usize] >= okt {
                    summe[(j) as usize] = summe[(j) as usize] - okt
                } else {
                    summe[(j) as usize] = 0
                }
                if kbsumme[(j) as usize] >= kb {
                    kbsumme[(j) as usize] = kbsumme[(j) as usize] - kb
                } else {
                    kbsumme[(j) as usize] = 0
                }
            } else {
                summe[(j) as usize] = summe[(j) as usize] + okt
                kbsumme[(j) as usize] = kbsumme[(j) as usize] + kb
            }
            if j == ROOT {
                weiter = false
            } else {
                p = pino[(j) as usize] as u64
            }
        }
        wache = wache + 1
    }
}

// Was ein Eintrag zu seinen Vorfahren beitraegt. Eine Datei ihre eigene
// Groesse; ein Verzeichnis das, was unter ihm liegt.
fn beitrag(i: u64) -> u64 {
    if is_dir_at(i) {
        return summe[(i) as usize]
    }
    return groesse[(i) as usize] as u64
}

fn beitrag_kb(i: u64) -> u64 {
    if is_dir_at(i) {
        return kbsumme[(i) as usize]
    }
    return kilo(groesse[(i) as usize] as u64)
}

// DIE AUFSUMMIERUNG. Einmal nach `build`, danach nie wieder -- `poll`
// haelt sie mit Unterschieden nach.
fn size_build() -> u64 {
    wurzel = sys3(WIG_IDXINFO, WX_ROOT, 0, 0)
    if ulib.bad(wurzel) || wurzel == 0 {
        wurzel = 1
    }
    ueberlauf = 0
    var i: u64 = 0
    while i <= ROOT {
        summe[(i) as usize] = 0
        kbsumme[(i) as usize] = 0
        i = i + 1
    }
    i = 0
    while i < nn {
        if !is_dir_at(i) {
            let o: u64 = groesse[(i) as usize] as u64
            hoch(pino[(i) as usize] as u64, o, kilo(o), false)
        }
        i = i + 1
    }
    return summe[(ROOT) as usize]
}

// ------------------------------------------------------- der Aufbau

fn eintragen(rec: u64) -> bool {
    if nn >= MAXN {
        abgeschnitten = abgeschnitten + 1
        return false
    }
    let ziel: u64 = (&nm[0 as usize]) as u64 + nn * NAMEN
    var k: u64 = 0
    while k < NAMEN {
        __mmio_write8((ziel + k) as *mut u8,
            __mmio_read8((rec + R_NAME + k) as *mut u8))
        k = k + 1
    }
    ino_[(nn) as usize] = (__mmio_read64((rec + R_INO) as *mut u64)) as u32
    pino[(nn) as usize] = (__mmio_read64((rec + R_PARENT) as *mut u64)) as u32
    art[(nn) as usize] = (__mmio_read64((rec + R_KIND) as *mut u64)) as u8
    // RUNDE SPEICHER: die Groesse steht im selben Satz, an derselben
    // Stelle wie beim Tabellenlauf. Sie kostet hier NICHTS -- der Kernel
    // hat den Inode-Block ohnehin gelesen.
    groesse[(nn) as usize] =
        (__mmio_read64((rec + R_SIZE) as *mut u64)) as u32
    summe[(nn) as usize] = 0
    kbsumme[(nn) as usize] = 0
    dio_set(__mmio_read64((rec + R_INO) as *mut u64), nn + 1)
    nn = nn + 1
    return true
}

fn loeschen(dir: u64, name: u64) -> bool {
    var i: u64 = 0
    while i < nn {
        if pino[(i) as usize] as u64 == dir && gleich(name_at(i), name) {
            // Der letzte rueckt nach: eine Namensliste hat keine
            // Reihenfolge, die etwas bedeutet, und ein Loch haette eine.
            // RUNDE SPEICHER: ERST ABZIEHEN, DANN WEGRAEUMEN. Was der
            // Eintrag zu seinen Vorfahren beigetragen hat, muss er
            // wieder hergeben, SOLANGE er noch dasteht -- danach ist
            // seine Elternnummer weg.
            hoch(pino[(i) as usize] as u64, beitrag(i), beitrag_kb(i),
                true)
            // Aus der Platztafel nur dann, wenn sie WIRKLICH auf diesen
            // Eintrag zeigt. Beim Umbenennen steht der neue Name schon
            // im Index und die Tafel zeigt auf IHN; wer hier blind
            // loeschte, machte den neuen Eintrag unauffindbar.
            if slot_of_ino(ino_[(i) as usize] as u64) == i {
                dio_set(ino_[(i) as usize] as u64, 0)
            }
            nn = nn - 1
            if i != nn {
                var k: u64 = 0
                while k < NAMEN {
                    __mmio_write8((name_at(i) + k) as *mut u8,
                        __mmio_read8((name_at(nn) + k) as *mut u8))
                    k = k + 1
                }
                ino_[(i) as usize] = ino_[(nn) as usize]
                pino[(i) as usize] = pino[(nn) as usize]
                art[(i) as usize] = art[(nn) as usize]
                groesse[(i) as usize] = groesse[(nn) as usize]
                summe[(i) as usize] = summe[(nn) as usize]
                kbsumme[(i) as usize] = kbsumme[(nn) as usize]
                // Der Nachrueckende hat einen neuen Platz -- die Tafel
                // muss das erfahren, sonst zeigt sie ins Leere.
                if slot_of_ino(ino_[(i) as usize] as u64) == nn {
                    dio_set(ino_[(i) as usize] as u64, i + 1)
                }
            }
            return true
        }
        i = i + 1
    }
    return false
}

fn gleich(a: u64, b: u64) -> bool {
    var k: u64 = 0
    while k < NAMEN {
        let x: u64 = __mmio_read8((a + k) as *mut u8) as u64
        let y: u64 = __mmio_read8((b + k) as *mut u8) as u64
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        k = k + 1
    }
    return true
}

// DER AUFBAU. Ein Durchgang durch die Inode-Tabelle, so oft aufgerufen,
// wie 63 Saetze in eine Seite passen. Gibt die Zahl der Namen zurueck.
//
// DIE LAUFENDE NUMMER DES JOURNALS WIRD VORHER GEHOLT, nicht nachher.
// Wer sie nachher holte, verloere jede Aenderung, die WAEHREND des Laufs
// passiert: der Lauf haette sie vielleicht noch nicht gesehen, und das
// Journal gaelte danach als abgearbeitet. Vorher zu fragen heisst
// hoechstens, eine Aenderung zweimal zu sehen -- und ein zweites
// "dazugekommen" ist harmlos, ein verlorenes nicht.
fn build() -> u64 {
    nn = 0
    aufrufe = 0
    saetze = 0
    abgeschnitten = 0
    // RUNDE SPEICHER: die Platztafel gehoert dem Aufbau, den es gerade
    // gibt. Ein zweiter Aufbau mit Resten des ersten waere ein Index,
    // der auf Eintraege zeigt, die es nicht mehr gibt.
    var z: u64 = 0
    while z < HN {
        dio[(z) as usize] = 0 as u32
        z = z + 1
    }
    ueberlauf = 0
    jseq = sys3(WIG_IDXINFO, WX_JSEQ, 0, 0)
    jlost = sys3(WIG_IDXINFO, WX_JLOST, 0, 0)
    lauf[(0) as usize] = 0
    var weiter: bool = true
    while weiter {
        let got: u64 = sys3(WIG_SCAN, (&lauf[0 as usize]) as u64,
            (&puffer[0 as usize]) as u64, STAPEL)
        aufrufe = aufrufe + 1
        if ulib.bad(got) || got == 0 {
            weiter = false
        } else {
            saetze = saetze + got
            var i: u64 = 0
            while i < got {
                eintragen((&puffer[0 as usize]) as u64 + i * REC)
                i = i + 1
            }
        }
    }
    return nn
}

// NACHZIEHEN OHNE NEUAUFBAU. Gibt die Zahl der verarbeiteten Saetze
// zurueck; hat der Ring etwas verworfen, gibt es 0 zurueck und `poll`
// meldet ueber `lost_seen`, dass neu gebaut werden muss.
fn poll() -> u64 {
    let verloren: u64 = sys3(WIG_IDXINFO, WX_JLOST, 0, 0)
    var n: u64 = 0
    var weiter: bool = true
    while weiter {
        let got: u64 = sys3(WIG_JRNL, jseq, (&puffer[0 as usize]) as u64,
            STAPEL)
        if ulib.bad(got) || got == 0 {
            weiter = false
        } else {
            var i: u64 = 0
            while i < got {
                let rec: u64 = (&puffer[0 as usize]) as u64 + i * REC
                let op: u64 = __mmio_read64((rec + R_OP) as *mut u64)
                let dir: u64 = __mmio_read64((rec + R_PARENT) as *mut u64)
                if op == OP_ADD {
                    // Erst weg, dann hin: ein Name, den es schon gab
                    // (der Lauf hat ihn gesehen, das Journal meldet ihn
                    // noch einmal), darf nicht zweimal im Index stehen.
                    loeschen(dir, rec + R_NAME)
                    if eintragen(rec) {
                        let neu2: u64 = nn - 1
                        hoch(dir, beitrag(neu2), beitrag_kb(neu2), false)
                    }
                } else if op == OP_DEL {
                    loeschen(dir, rec + R_NAME)
                } else if op == OP_SIZE {
                    // RUNDE SPEICHER: EINE DATEI HAT IHRE GROESSE
                    // GEAENDERT. Was hinaufgetragen wird, ist der
                    // UNTERSCHIED und nicht die Groesse -- der Rest
                    // steht ja schon oben. Genau das ist der Grund,
                    // warum die Antwort sofort da ist: die Arbeit ist
                    // proportional zur AENDERUNG, nicht zum Baum.
                    let wo: u64 = slot_of_ino(
                        __mmio_read64((rec + R_INO) as *mut u64))
                    if wo < ROOT {
                        let neu3: u64 =
                            __mmio_read64((rec + R_SIZE) as *mut u64)
                        let alt3: u64 = groesse[(wo) as usize] as u64
                        groesse[(wo) as usize] = neu3 as u32
                        let e: u64 = pino[(wo) as usize] as u64
                        if neu3 >= alt3 {
                            hoch(e, neu3 - alt3,
                                kilo(neu3) - kilo(alt3), false)
                        } else {
                            hoch(e, alt3 - neu3,
                                kilo(alt3) - kilo(neu3), true)
                        }
                    }
                }
                n = n + 1
                i = i + 1
            }
            jseq = jseq + got
        }
    }
    jlost = verloren
    return n
}

// ------------------------------------------------------- die Suche

fn lower(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

fn contains(heu: u64, nadel: u64) -> bool {
    let n: u64 = ulib.length(nadel)
    if n == 0 {
        return true
    }
    let h: u64 = ulib.length(heu)
    if n > h {
        return false
    }
    var i: u64 = 0
    while i + n <= h {
        var k: u64 = 0
        var g: bool = true
        while k < n {
            if lower(__mmio_read8((heu + i + k) as *mut u8) as u64)
                != lower(__mmio_read8((nadel + k) as *mut u8) as u64) {
                g = false
                k = n
            } else {
                k = k + 1
            }
        }
        if g {
            return true
        }
        i = i + 1
    }
    return false
}

// IM SPEICHER, UND NUR DORT. Kein Systemaufruf, kein Block, keine
// Pfadaufloesung -- der Unterschied zum Baumdurchlauf darunter ist genau
// dieser, und er wird in Mikrosekunden gemessen.
fn find(term: u64, out: u64, max: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < nn && n < max {
        if contains(name_at(i), term) {
            __mmio_write64((out + n * 8) as *mut u64, i)
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Der ganze Pfad eines Treffers. Die Eltern werden rueckwaerts gesucht;
// das ist ein Durchgang je Ebene und passiert nur fuer die paar Treffer,
// die jemand ansieht -- nicht fuer 4000 Namen beim Aufbau. Genau das ist
// der Grund, warum der Index NUR Namen haelt und keine Pfade.
fn path_of(i: u64, out: u64, max: u64) -> u64 {
    var teile: [u64; 24] = [0 as u64; 24]
    var tiefe: u64 = 0
    var wo: u64 = i
    var weiter: bool = true
    while weiter && tiefe < 24 {
        teile[(tiefe) as usize] = wo
        tiefe = tiefe + 1
        let eltern: u64 = pino[(wo) as usize] as u64
        if eltern <= 1 {
            weiter = false
        } else {
            var k: u64 = 0
            var gefunden: bool = false
            while k < nn && !gefunden {
                if ino_[(k) as usize] as u64 == eltern
                    && art[(k) as usize] as u64 == K_DIR {
                    wo = k
                    gefunden = true
                }
                k = k + 1
            }
            if !gefunden {
                weiter = false
            }
        }
    }
    var at: u64 = 0
    while tiefe > 0 {
        tiefe = tiefe - 1
        if at + 1 < max {
            __mmio_write8((out + at) as *mut u8, 47 as u8)
            at = at + 1
        }
        let p: u64 = name_at(teile[(tiefe) as usize])
        var k: u64 = 0
        while k < NAMEN && at + 1 < max {
            let c: u64 = __mmio_read8((p + k) as *mut u8) as u64
            if c == 0 {
                k = NAMEN
            } else {
                __mmio_write8((out + at) as *mut u8, c as u8)
                at = at + 1
                k = k + 1
            }
        }
    }
    __mmio_write8((out + at) as *mut u8, 0 as u8)
    return at
}

// ------------------------------------------------- DIE GEGENPROBE
//
// DIESELBE FRAGE, DER ANDERE WEG: von der Wurzel aus jedes Verzeichnis
// oeffnen, seine Eintraege lesen, in die Unterverzeichnisse absteigen.
// Das ist, was ein `find /` tut, und es ist das, was der Index ersetzt.
//
// Was ihn teuer macht, ist nicht das Lesen -- es ist der PFAD. Jedes
// `open` loest die ganze Kette von der Wurzel an noch einmal auf,
// Bestandteil fuer Bestandteil, und je Bestandteil laeuft der Kernel
// durch ein Verzeichnis. Der Tabellenlauf tut das kein einziges Mal.
//
// `walk_seen` sagt hinterher, wie viele Namen er gesehen hat. Wenn diese
// Zahl nicht zu der des Index passt, ist die Gleichheit der Treffer ein
// Zufall und keine Zusage.
//
// ER LIEFERT DIE NAMEN und nicht nur eine Anzahl -- je Treffer NAMEN
// Oktette in `out`. Zwei Suchen, die beide "sieben" sagen, koennen sieben
// VERSCHIEDENE Dateien meinen; nur der Vergleich der Namen schliesst das
// aus, und genau den rechnet der Messlauf nach.
static mut wpfad: [u8; 512] = [0 as u8; 512]
static mut wbuf: [u8; 1024] = [0 as u8; 1024]

fn walk_seen() -> u64 {
    return gesehen
}

fn walk_find(term: u64, out: u64, max: u64) -> u64 {
    var wurzel: [u8; 2] = "/\0"
    gesehen = 0
    ulib.strcpy((&wpfad[0 as usize]) as u64, (&wurzel[0 as usize]) as u64)
    return absteigen((&wpfad[0 as usize]) as u64, term, out, max, 0, 0)
}

fn absteigen(pfad: u64, term: u64, out: u64, max: u64, hab: u64,
    tiefe: u64) -> u64 {
    var n: u64 = hab
    if tiefe > 8 {
        return n
    }
    let fd: u64 = io.dir_open(pfad)
    if ulib.bad(fd) {
        return n
    }
    // ERST DIESES VERZEICHNIS GANZ LESEN, DANN ABSTEIGEN. Wer mitten im
    // Lesen ein zweites oeffnet, braucht einen zweiten Puffer je Ebene --
    // acht Ebenen auf dem Stapel einer Anwendung, die 32 KiB davon hat.
    //
    // GEMERKT WERDEN NUR DIE UNTERVERZEICHNISSE. Der erste Entwurf legte
    // JEDEN Namen in diesen Puffer, und in einem Ordner mit 4000 Dateien
    // war er nach sechzig voll -- der Durchlauf stieg dann in kein
    // Unterverzeichnis mehr ab und meldete zu wenige Treffer. Eine
    // Gegenprobe, die weniger findet als der Index, wuerde den Index
    // faelschlich gut aussehen lassen.
    var namen: [u8; 1024] = [0 as u8; 1024]
    var anzahl: u64 = 0
    var at: u64 = 0
    var weiter: bool = true
    while weiter {
        let got: u64 = io.dir_read(fd, (&wbuf[0 as usize]) as u64, 1024)
        if ulib.bad(got) || got == 0 {
            weiter = false
        } else {
            var p: u64 = 0
            while p < got {
                let rec: u64 = (&wbuf[0 as usize]) as u64 + p
                let rl: u64 = io.dir_reclen(rec)
                if rl == 0 {
                    p = got
                } else {
                    let name: u64 = io.dir_name(rec)
                    if !punkt(name) {
                        gesehen = gesehen + 1
                        if contains(name, term) && n < max {
                            var k: u64 = 0
                            while k < NAMEN {
                                var c: u64 = 0
                                if k < ulib.length(name) {
                                    c = __mmio_read8((name + k) as *mut u8)
                                        as u64
                                }
                                __mmio_write8((out + n * NAMEN + k) as *mut u8,
                                    c as u8)
                                k = k + 1
                            }
                            n = n + 1
                        }
                        if io.dir_kind(rec) == io.DT_DIR {
                            let ln: u64 = ulib.length(name)
                            if at + ln + 1 < 1024 {
                                ulib.strcpy((&namen[0 as usize]) as u64 + at,
                                    name)
                                anzahl = anzahl + 1
                                at = at + ln + 1
                            }
                        }
                    }
                    p = p + rl
                }
            }
        }
    }
    io.close(fd)
    var unten: [u8; 256] = [0 as u8; 256]
    var i: u64 = 0
    var wo: u64 = 0
    while i < anzahl {
        let name: u64 = (&namen[0 as usize]) as u64 + wo
        let ln: u64 = ulib.length(name)
        ulib.strcpy((&unten[0 as usize]) as u64, pfad)
        if ulib.length((&unten[0 as usize]) as u64) > 1 {
            var schraeg: [u8; 2] = "/\0"
            ulib.strcat((&unten[0 as usize]) as u64,
                (&schraeg[0 as usize]) as u64)
        }
        ulib.strcat((&unten[0 as usize]) as u64, name)
        n = absteigen((&unten[0 as usize]) as u64, term, out, max, n,
            tiefe + 1)
        wo = wo + ln + 1
        i = i + 1
    }
    return n
}

// ------------------------------- RUNDE SPEICHER: DIE GROSSE GEGENPROBE
//
// DIESELBE FRAGE, DER ANDERE WEG -- und dies ist die wichtigste Zusage
// der Runde. Ein Wert, der sofort da ist und falsch, ist wertlos.
//
// `walk_total` tut das, was TreeSize und WizTree bei jedem Start tun:
// von einem Verzeichnis aus jedes Unterverzeichnis oeffnen, jeden
// Eintrag lesen, fuer jede Datei `stat` rufen und die Oktette addieren.
// Was das teuer macht, ist nicht das Addieren -- es ist, dass jedes
// `stat` den ganzen Pfad von der Wurzel an noch einmal aufloest.
//
// GEZAEHLT WIRD GENAU WIE IM INDEX: die Groesse der Dateien, ein
// Verzeichnis null. Und daneben die aufgerundeten Kilooktett-Bloecke,
// weil `du` in ihnen rechnet. Kaeme hier eine andere Zahl heraus als aus
// dem Index, waere der Index eine Behauptung.
static mut wsum: u64 = 0
static mut wkb: u64 = 0
static mut wdat: u64 = 0
static mut wdir: u64 = 0
static mut wpfad2: [u8; 512] = [0 as u8; 512]

fn walk_blocks() -> u64 {
    return wkb
}

fn walk_files() -> u64 {
    return wdat
}

fn walk_dirs() -> u64 {
    return wdir
}

fn walk_total(pfad: u64) -> u64 {
    wsum = 0
    wkb = 0
    wdat = 0
    wdir = 0
    ulib.strncpy((&wpfad2[0 as usize]) as u64, pfad, 500)
    tief((&wpfad2[0 as usize]) as u64, 0)
    return wsum
}

fn tief(pfad: u64, tiefe: u64) {
    if tiefe > 8 {
        return
    }
    let fd: u64 = io.dir_open(pfad)
    if ulib.bad(fd) {
        return
    }
    // Dieselbe Regel wie beim Namensdurchlauf darueber: erst dieses
    // Verzeichnis GANZ lesen, dann absteigen, und gemerkt werden nur die
    // Unterverzeichnisse. Ein Ordner mit 4000 Dateien fuellte sonst den
    // Puffer nach sechzig Namen, und der Durchlauf stiege in kein
    // Unterverzeichnis mehr ab -- eine Gegenprobe, die zu wenig findet,
    // laesst den Index falschlich gut aussehen.
    var namen: [u8; 1024] = [0 as u8; 1024]
    var anzahl: u64 = 0
    var at: u64 = 0
    var voll: [u8; 512] = [0 as u8; 512]
    var weiter: bool = true
    while weiter {
        let got: u64 = io.dir_read(fd, (&wbuf[0 as usize]) as u64, 1024)
        if ulib.bad(got) || got == 0 {
            weiter = false
        } else {
            var p: u64 = 0
            while p < got {
                let rec: u64 = (&wbuf[0 as usize]) as u64 + p
                let rl: u64 = io.dir_reclen(rec)
                if rl == 0 {
                    p = got
                } else {
                    let name: u64 = io.dir_name(rec)
                    if !punkt(name) {
                        if io.dir_kind(rec) == io.DT_DIR {
                            wdir = wdir + 1
                            let ln: u64 = ulib.length(name)
                            if at + ln + 1 < 1024 {
                                ulib.strcpy((&namen[0 as usize]) as u64 + at,
                                    name)
                                anzahl = anzahl + 1
                                at = at + ln + 1
                            }
                        } else {
                            fuege((&voll[0 as usize]) as u64, pfad, name)
                            let sz: u64 =
                                ulib.size_of((&voll[0 as usize]) as u64)
                            if !ulib.bad(sz) {
                                wsum = wsum + sz
                                wkb = wkb + kilo(sz)
                                wdat = wdat + 1
                            }
                        }
                    }
                    p = p + rl
                }
            }
        }
    }
    io.close(fd)
    var i: u64 = 0
    var wo: u64 = 0
    while i < anzahl {
        let name: u64 = (&namen[0 as usize]) as u64 + wo
        let ln: u64 = ulib.length(name)
        fuege((&voll[0 as usize]) as u64, pfad, name)
        tief((&voll[0 as usize]) as u64, tiefe + 1)
        wo = wo + ln + 1
        i = i + 1
    }
}

fn fuege(out: u64, dir: u64, name: u64) {
    var schraeg: [u8; 2] = "/\0"
    ulib.strncpy(out, dir, 400)
    if ulib.length(out) > 1 {
        ulib.strcat(out, (&schraeg[0 as usize]) as u64)
    }
    ulib.strcat(out, name)
}

fn punkt(p: u64) -> bool {
    if __mmio_read8(p as *mut u8) != 46 as u8 {
        return false
    }
    if __mmio_read8((p + 1) as *mut u8) == 0 as u8 {
        return true
    }
    if __mmio_read8((p + 1) as *mut u8) != 46 as u8 {
        return false
    }
    return __mmio_read8((p + 2) as *mut u8) == 0 as u8
}
