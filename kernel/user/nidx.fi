
profile kernel

import ulib
import libc.io
import libc.kcall

export {
    build, poll, find, count, name_at, ino_at, kind_at, parent_at,
    path_of, walk_find, walk_seen, contains, lower,
    calls, records, truncated, lost_seen, seq_now, mono_us,
    MAXN, NAMES,
    size_build, size_at, sub_at, blk_at, slot_of_ino, root_ino,
    total_of_ino, blocks_of_ino, kilo, is_dir_at, dio_full,
    walk_total, walk_blocks, walk_files, walk_dirs, ino_of_path,
    ROOT, NICHTS
}

const MAXN: u64 = 4200
const NAMES: u64 = 24

const REC: u64 = 64
const R_INO: u64 = 0
const R_PARENT: u64 = 8
const R_SIZE: u64 = 16
const R_KIND: u64 = 24
const R_NAME: u64 = 32
const R_OP: u64 = 56

const OP_ADD: u64 = 1
const OP_DEL: u64 = 2
const OP_SIZE: u64 = 3

const K_DIR: u64 = 2

const WIG_SCAN: u64 = 1807
const WIG_JRNL: u64 = 1808
const WIG_IDXINFO: u64 = 1809
const WX_JSEQ: u64 = 2
const WX_JLOST: u64 = 3
const WX_ROOT: u64 = 6

const ROOT: u64 = 4200
const NICHTS: u64 = 4201
const HN: u64 = 8192

const SYS_CLOCK_GETTIME: u64 = 228
const CLOCK_MONOTONIC: u64 = 1

const STACK: u64 = 63

static mut nm: [u8; 100800] = [0 as u8; 100800]
static mut pino: [u32; 4200] = [0 as u32; 4200]
static mut ino_: [u32; 4200] = [0 as u32; 4200]
static mut art: [u8; 4200] = [0 as u8; 4200]
static mut nn: u64 = 0
static mut jseq: u64 = 0
static mut jlost: u64 = 0
static mut abgeschnitten: u64 = 0
static mut aufrufe: u64 = 0
static mut saetze: u64 = 0
static mut buffer: [u8; 4032] = [0 as u8; 4032]
static mut lauf: [u64; 2] = [0 as u64; 2]
static mut seen: u64 = 0

static mut size: [u32; 4200] = [0 as u32; 4200]
static mut sum: [u64; 4201] = [0 as u64; 4201]
static mut kbsumme: [u64; 4201] = [0 as u64; 4201]
static mut dio: [u32; 8192] = [0 as u32; 8192]
static mut root: u64 = 0
static mut ueberlauf: u64 = 0

fn sys3(number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

fn mono_us() -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    kcall.sys2(SYS_CLOCK_GETTIME, CLOCK_MONOTONIC, (&ts[0 as usize]) as u64)
    return ts[0 as usize] *% 1000000 +% ts[1 as usize] / 1000
}

fn count() -> u64 {
    return nn
}

fn calls() -> u64 {
    return aufrufe
}

fn records() -> u64 {
    return saetze
}

fn truncated() -> u64 {
    return abgeschnitten
}

fn lost_seen() -> u64 {
    return jlost
}

fn seq_now() -> u64 {
    return jseq
}

fn name_at(i: u64) -> u64 {
    return (&nm[0 as usize]) as u64 + i * NAMES
}

fn ino_at(i: u64) -> u64 {
    return ino_[(i) as usize] as u64
}

fn parent_at(i: u64) -> u64 {
    return pino[(i) as usize] as u64
}

fn kind_at(i: u64) -> u64 {
    return art[(i) as usize] as u64
}

fn is_dir_at(i: u64) -> bool {
    return art[(i) as usize] as u64 == K_DIR
}

fn size_at(i: u64) -> u64 {
    return size[(i) as usize] as u64
}

fn sub_at(i: u64) -> u64 {
    return sum[(i) as usize]
}

fn blk_at(i: u64) -> u64 {
    return kbsumme[(i) as usize]
}

fn root_ino() -> u64 {
    return root
}

fn dio_full() -> u64 {
    return ueberlauf
}

fn kilo(sz: u64) -> u64 {
    return (sz + 1023) / 1024
}

fn slot_of_ino(ino: u64) -> u64 {
    if ino == 0 {
        return NICHTS
    }
    if ino == root {
        return ROOT
    }
    if ino < HN {
        let v: u64 = dio[(ino) as usize] as u64
        if v == 0 {
            return NICHTS
        }
        return v - 1
    }
    ueberlauf = ueberlauf + 1
    var i: u64 = 0
    while i < nn {
        if ino_[(i) as usize] as u64 == ino {
            return i
        }
        i = i + 1
    }
    return NICHTS
}

fn dio_set(ino: u64, value: u64) {
    if ino != 0 && ino < HN {
        dio[(ino) as usize] = value as u32
    }
}

fn total_of_ino(ino: u64) -> u64 {
    let s2: u64 = slot_of_ino(ino)
    if s2 > ROOT {
        return 0
    }
    return sum[(s2) as usize]
}

fn blocks_of_ino(ino: u64) -> u64 {
    let s2: u64 = slot_of_ino(ino)
    if s2 > ROOT {
        return 0
    }
    return kbsumme[(s2) as usize]
}

fn ino_of_path(path: u64) -> u64 {
    var st: [u8; 144] = [0 as u8; 144]
    let r: u64 = io.stat_into(path, (&st[0 as usize]) as u64)
    if ulib.bad(r) {
        return 0
    }
    return __mmio_read64(((&st[0 as usize]) as u64 + io.ST_INO) as *mut u64)
}

fn up(eltern: u64, okt: u64, kb: u64, minus: bool) {
    var p: u64 = eltern
    var wache: u64 = 0
    var next: bool = true
    while next && wache < 32 {
        let j: u64 = slot_of_ino(p)
        if j > ROOT {
            next = false
        } else {
            if minus {
                if sum[(j) as usize] >= okt {
                    sum[(j) as usize] = sum[(j) as usize] - okt
                } else {
                    sum[(j) as usize] = 0
                }
                if kbsumme[(j) as usize] >= kb {
                    kbsumme[(j) as usize] = kbsumme[(j) as usize] - kb
                } else {
                    kbsumme[(j) as usize] = 0
                }
            } else {
                sum[(j) as usize] = sum[(j) as usize] + okt
                kbsumme[(j) as usize] = kbsumme[(j) as usize] + kb
            }
            if j == ROOT {
                next = false
            } else {
                p = pino[(j) as usize] as u64
            }
        }
        wache = wache + 1
    }
}

fn beitrag(i: u64) -> u64 {
    if is_dir_at(i) {
        return sum[(i) as usize]
    }
    return size[(i) as usize] as u64
}

fn beitrag_kb(i: u64) -> u64 {
    if is_dir_at(i) {
        return kbsumme[(i) as usize]
    }
    return kilo(size[(i) as usize] as u64)
}

fn size_build() -> u64 {
    root = sys3(WIG_IDXINFO, WX_ROOT, 0, 0)
    if ulib.bad(root) || root == 0 {
        root = 1
    }
    ueberlauf = 0
    var i: u64 = 0
    while i <= ROOT {
        sum[(i) as usize] = 0
        kbsumme[(i) as usize] = 0
        i = i + 1
    }
    i = 0
    while i < nn {
        if !is_dir_at(i) {
            let o: u64 = size[(i) as usize] as u64
            up(pino[(i) as usize] as u64, o, kilo(o), false)
        }
        i = i + 1
    }
    return sum[(ROOT) as usize]
}

fn eintragen(rec: u64) -> bool {
    if nn >= MAXN {
        abgeschnitten = abgeschnitten + 1
        return false
    }
    let target: u64 = (&nm[0 as usize]) as u64 + nn * NAMES
    var k: u64 = 0
    while k < NAMES {
        __mmio_write8((target + k) as *mut u8,
            __mmio_read8((rec + R_NAME + k) as *mut u8))
        k = k + 1
    }
    ino_[(nn) as usize] = (__mmio_read64((rec + R_INO) as *mut u64)) as u32
    pino[(nn) as usize] = (__mmio_read64((rec + R_PARENT) as *mut u64)) as u32
    art[(nn) as usize] = (__mmio_read64((rec + R_KIND) as *mut u64)) as u8
    size[(nn) as usize] =
        (__mmio_read64((rec + R_SIZE) as *mut u64)) as u32
    sum[(nn) as usize] = 0
    kbsumme[(nn) as usize] = 0
    dio_set(__mmio_read64((rec + R_INO) as *mut u64), nn + 1)
    nn = nn + 1
    return true
}

fn delete(dir: u64, name: u64) -> bool {
    var i: u64 = 0
    while i < nn {
        if pino[(i) as usize] as u64 == dir && eq(name_at(i), name) {
            up(pino[(i) as usize] as u64, beitrag(i), beitrag_kb(i),
                true)
            if slot_of_ino(ino_[(i) as usize] as u64) == i {
                dio_set(ino_[(i) as usize] as u64, 0)
            }
            nn = nn - 1
            if i != nn {
                var k: u64 = 0
                while k < NAMES {
                    __mmio_write8((name_at(i) + k) as *mut u8,
                        __mmio_read8((name_at(nn) + k) as *mut u8))
                    k = k + 1
                }
                ino_[(i) as usize] = ino_[(nn) as usize]
                pino[(i) as usize] = pino[(nn) as usize]
                art[(i) as usize] = art[(nn) as usize]
                size[(i) as usize] = size[(nn) as usize]
                sum[(i) as usize] = sum[(nn) as usize]
                kbsumme[(i) as usize] = kbsumme[(nn) as usize]
                if slot_of_ino(ino_[(i) as usize] as u64) == nn {
                    dio_set(ino_[(i) as usize] as u64, i + 1)
                }
            }
            return true
        }
        i = i + 1
    }
    return false
}

fn eq(a: u64, b: u64) -> bool {
    var k: u64 = 0
    while k < NAMES {
        let x: u64 = __mmio_read8((a + k) as *mut u8) as u64
        let y: u64 = __mmio_read8((b + k) as *mut u8) as u64
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        k = k + 1
    }
    return true
}

fn build() -> u64 {
    nn = 0
    aufrufe = 0
    saetze = 0
    abgeschnitten = 0
    var z: u64 = 0
    while z < HN {
        dio[(z) as usize] = 0 as u32
        z = z + 1
    }
    ueberlauf = 0
    jseq = sys3(WIG_IDXINFO, WX_JSEQ, 0, 0)
    jlost = sys3(WIG_IDXINFO, WX_JLOST, 0, 0)
    lauf[(0) as usize] = 0
    var next: bool = true
    while next {
        let got: u64 = sys3(WIG_SCAN, (&lauf[0 as usize]) as u64,
            (&buffer[0 as usize]) as u64, STACK)
        aufrufe = aufrufe + 1
        if ulib.bad(got) || got == 0 {
            next = false
        } else {
            saetze = saetze + got
            var i: u64 = 0
            while i < got {
                eintragen((&buffer[0 as usize]) as u64 + i * REC)
                i = i + 1
            }
        }
    }
    return nn
}

fn poll() -> u64 {
    let lost: u64 = sys3(WIG_IDXINFO, WX_JLOST, 0, 0)
    var n: u64 = 0
    var next: bool = true
    while next {
        let got: u64 = sys3(WIG_JRNL, jseq, (&buffer[0 as usize]) as u64,
            STACK)
        if ulib.bad(got) || got == 0 {
            next = false
        } else {
            var i: u64 = 0
            while i < got {
                let rec: u64 = (&buffer[0 as usize]) as u64 + i * REC
                let op: u64 = __mmio_read64((rec + R_OP) as *mut u64)
                let dir: u64 = __mmio_read64((rec + R_PARENT) as *mut u64)
                if op == OP_ADD {
                    delete(dir, rec + R_NAME)
                    if eintragen(rec) {
                        let new2: u64 = nn - 1
                        up(dir, beitrag(new2), beitrag_kb(new2), false)
                    }
                } else if op == OP_DEL {
                    delete(dir, rec + R_NAME)
                } else if op == OP_SIZE {
                    let wo: u64 = slot_of_ino(
                        __mmio_read64((rec + R_INO) as *mut u64))
                    if wo < ROOT {
                        let new3: u64 =
                            __mmio_read64((rec + R_SIZE) as *mut u64)
                        let alt3: u64 = size[(wo) as usize] as u64
                        size[(wo) as usize] = new3 as u32
                        let e: u64 = pino[(wo) as usize] as u64
                        if new3 >= alt3 {
                            up(e, new3 - alt3,
                                kilo(new3) - kilo(alt3), false)
                        } else {
                            up(e, alt3 - new3,
                                kilo(alt3) - kilo(new3), true)
                        }
                    }
                }
                n = n + 1
                i = i + 1
            }
            jseq = jseq + got
        }
    }
    jlost = lost
    return n
}

fn lower(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

fn contains(heu: u64, nadel: u64) -> bool {
    let n: u64 = ulib.length(nadel)
    if n == 0 {
        return true
    }
    let h: u64 = ulib.length(heu)
    if n > h {
        return false
    }
    var i: u64 = 0
    while i + n <= h {
        var k: u64 = 0
        var g: bool = true
        while k < n {
            if lower(__mmio_read8((heu + i + k) as *mut u8) as u64)
                != lower(__mmio_read8((nadel + k) as *mut u8) as u64) {
                g = false
                k = n
            } else {
                k = k + 1
            }
        }
        if g {
            return true
        }
        i = i + 1
    }
    return false
}

fn find(term: u64, out: u64, max: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < nn && n < max {
        if contains(name_at(i), term) {
            __mmio_write64((out + n * 8) as *mut u64, i)
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn path_of(i: u64, out: u64, max: u64) -> u64 {
    var teile: [u64; 24] = [0 as u64; 24]
    var tiefe: u64 = 0
    var wo: u64 = i
    var next: bool = true
    while next && tiefe < 24 {
        teile[(tiefe) as usize] = wo
        tiefe = tiefe + 1
        let eltern: u64 = pino[(wo) as usize] as u64
        if eltern <= 1 {
            next = false
        } else {
            var k: u64 = 0
            var gefunden: bool = false
            while k < nn && !gefunden {
                if ino_[(k) as usize] as u64 == eltern
                    && art[(k) as usize] as u64 == K_DIR {
                    wo = k
                    gefunden = true
                }
                k = k + 1
            }
            if !gefunden {
                next = false
            }
        }
    }
    var at: u64 = 0
    while tiefe > 0 {
        tiefe = tiefe - 1
        if at + 1 < max {
            __mmio_write8((out + at) as *mut u8, 47 as u8)
            at = at + 1
        }
        let p: u64 = name_at(teile[(tiefe) as usize])
        var k: u64 = 0
        while k < NAMES && at + 1 < max {
            let c: u64 = __mmio_read8((p + k) as *mut u8) as u64
            if c == 0 {
                k = NAMES
            } else {
                __mmio_write8((out + at) as *mut u8, c as u8)
                at = at + 1
                k = k + 1
            }
        }
    }
    __mmio_write8((out + at) as *mut u8, 0 as u8)
    return at
}

static mut wpfad: [u8; 512] = [0 as u8; 512]
static mut wbuf: [u8; 1024] = [0 as u8; 1024]

fn walk_seen() -> u64 {
    return seen
}

fn walk_find(term: u64, out: u64, max: u64) -> u64 {
    var root: [u8; 2] = "/\0"
    seen = 0
    ulib.strcpy((&wpfad[0 as usize]) as u64, (&root[0 as usize]) as u64)
    return absteigen((&wpfad[0 as usize]) as u64, term, out, max, 0, 0)
}

fn absteigen(path: u64, term: u64, out: u64, max: u64, hab: u64,
    tiefe: u64) -> u64 {
    var n: u64 = hab
    if tiefe > 8 {
        return n
    }
    let fd: u64 = io.dir_open(path)
    if ulib.bad(fd) {
        return n
    }
    var names: [u8; 1024] = [0 as u8; 1024]
    var total: u64 = 0
    var at: u64 = 0
    var next: bool = true
    while next {
        let got: u64 = io.dir_read(fd, (&wbuf[0 as usize]) as u64, 1024)
        if ulib.bad(got) || got == 0 {
            next = false
        } else {
            var p: u64 = 0
            while p < got {
                let rec: u64 = (&wbuf[0 as usize]) as u64 + p
                let rl: u64 = io.dir_reclen(rec)
                if rl == 0 {
                    p = got
                } else {
                    let name: u64 = io.dir_name(rec)
                    if !point(name) {
                        seen = seen + 1
                        if contains(name, term) && n < max {
                            var k: u64 = 0
                            while k < NAMES {
                                var c: u64 = 0
                                if k < ulib.length(name) {
                                    c = __mmio_read8((name + k) as *mut u8)
                                        as u64
                                }
                                __mmio_write8((out + n * NAMES + k) as *mut u8,
                                    c as u8)
                                k = k + 1
                            }
                            n = n + 1
                        }
                        if io.dir_kind(rec) == io.DT_DIR {
                            let ln: u64 = ulib.length(name)
                            if at + ln + 1 < 1024 {
                                ulib.strcpy((&names[0 as usize]) as u64 + at,
                                    name)
                                total = total + 1
                                at = at + ln + 1
                            }
                        }
                    }
                    p = p + rl
                }
            }
        }
    }
    io.close(fd)
    var bottom: [u8; 256] = [0 as u8; 256]
    var i: u64 = 0
    var wo: u64 = 0
    while i < total {
        let name: u64 = (&names[0 as usize]) as u64 + wo
        let ln: u64 = ulib.length(name)
        ulib.strcpy((&bottom[0 as usize]) as u64, path)
        if ulib.length((&bottom[0 as usize]) as u64) > 1 {
            var schraeg: [u8; 2] = "/\0"
            ulib.strcat((&bottom[0 as usize]) as u64,
                (&schraeg[0 as usize]) as u64)
        }
        ulib.strcat((&bottom[0 as usize]) as u64, name)
        n = absteigen((&bottom[0 as usize]) as u64, term, out, max, n,
            tiefe + 1)
        wo = wo + ln + 1
        i = i + 1
    }
    return n
}

static mut wsum: u64 = 0
static mut wkb: u64 = 0
static mut wdat: u64 = 0
static mut wdir: u64 = 0
static mut wpfad2: [u8; 512] = [0 as u8; 512]

fn walk_blocks() -> u64 {
    return wkb
}

fn walk_files() -> u64 {
    return wdat
}

fn walk_dirs() -> u64 {
    return wdir
}

fn walk_total(path: u64) -> u64 {
    wsum = 0
    wkb = 0
    wdat = 0
    wdir = 0
    ulib.strncpy((&wpfad2[0 as usize]) as u64, path, 500)
    tief((&wpfad2[0 as usize]) as u64, 0)
    return wsum
}

fn tief(path: u64, tiefe: u64) {
    if tiefe > 8 {
        return
    }
    let fd: u64 = io.dir_open(path)
    if ulib.bad(fd) {
        return
    }
    var names: [u8; 1024] = [0 as u8; 1024]
    var total: u64 = 0
    var at: u64 = 0
    var full: [u8; 512] = [0 as u8; 512]
    var next: bool = true
    while next {
        let got: u64 = io.dir_read(fd, (&wbuf[0 as usize]) as u64, 1024)
        if ulib.bad(got) || got == 0 {
            next = false
        } else {
            var p: u64 = 0
            while p < got {
                let rec: u64 = (&wbuf[0 as usize]) as u64 + p
                let rl: u64 = io.dir_reclen(rec)
                if rl == 0 {
                    p = got
                } else {
                    let name: u64 = io.dir_name(rec)
                    if !point(name) {
                        if io.dir_kind(rec) == io.DT_DIR {
                            wdir = wdir + 1
                            let ln: u64 = ulib.length(name)
                            if at + ln + 1 < 1024 {
                                ulib.strcpy((&names[0 as usize]) as u64 + at,
                                    name)
                                total = total + 1
                                at = at + ln + 1
                            }
                        } else {
                            fuege((&full[0 as usize]) as u64, path, name)
                            let sz: u64 =
                                io.size_of((&full[0 as usize]) as u64)
                            if !ulib.bad(sz) {
                                wsum = wsum + sz
                                wkb = wkb + kilo(sz)
                                wdat = wdat + 1
                            }
                        }
                    }
                    p = p + rl
                }
            }
        }
    }
    io.close(fd)
    var i: u64 = 0
    var wo: u64 = 0
    while i < total {
        let name: u64 = (&names[0 as usize]) as u64 + wo
        let ln: u64 = ulib.length(name)
        fuege((&full[0 as usize]) as u64, path, name)
        tief((&full[0 as usize]) as u64, tiefe + 1)
        wo = wo + ln + 1
        i = i + 1
    }
}

fn fuege(out: u64, dir: u64, name: u64) {
    var schraeg: [u8; 2] = "/\0"
    ulib.strncpy(out, dir, 400)
    if ulib.length(out) > 1 {
        ulib.strcat(out, (&schraeg[0 as usize]) as u64)
    }
    ulib.strcat(out, name)
}

fn point(p: u64) -> bool {
    if __mmio_read8(p as *mut u8) != 46 as u8 {
        return false
    }
    if __mmio_read8((p + 1) as *mut u8) == 0 as u8 {
        return true
    }
    if __mmio_read8((p + 1) as *mut u8) != 46 as u8 {
        return false
    }
    return __mmio_read8((p + 2) as *mut u8) == 0 as u8
}
