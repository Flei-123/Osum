profile app

import ulib

export { u_start }

fn starts(p: u64, w: u64) -> bool {
    var i: u64 = 0
    while *((w + i) as *mut u8) != 0 as u8 {
        if *((p + i) as *mut u8) != *((w + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

fn u_start(args: u64) -> u64 {
    var m_allow: [u8; 6] = "allow\0"
    var m_timeout: [u8; 8] = "timeout\0"
    var m_hang: [u8; 5] = "hang\0"
    var m_ui: [u8; 3] = "ui\0"
    var s_log: [u8; 14] = "vpstub: args \0"
    var s_sp: [u8; 2] = " \0"
    ulib.say((&s_log[0 as usize]) as u64)
    ulib.sayu(ulib.arg_count(args))
    var i: u64 = 2
    while i < ulib.arg_count(args) {
        ulib.say((&s_sp[0 as usize]) as u64)
        ulib.say(ulib.arg_at(args, i))
        i = i + 1
    }
    ulib.nl()
    let mode: u64 = ulib.arg_at(args, 2)
    if starts(mode, (&m_allow[0 as usize]) as u64) {
        return 0
    }
    if starts(mode, (&m_timeout[0 as usize]) as u64) {
        return 2
    }
    if starts(mode, (&m_ui[0 as usize]) as u64) {
        return 3
    }
    if starts(mode, (&m_hang[0 as usize]) as u64) {
        while true {
            ulib.sleep_ms(200)
        }
    }
    return 1
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
