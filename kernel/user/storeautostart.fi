profile app

import libc.octets
import autostartsrc
import autostart.model

export { refresh, offered, enabled, toggle }

fn index_of(name: u64) -> u64 {
    return model.find(name, octets.cstr_len(name))
}

fn refresh() {
    let _n: u64 = autostartsrc.load()
}

fn offered(name: u64) -> bool {
    let i: u64 = index_of(name)
    return i != model.MAX_ENTRIES && model.visible(i) && !model.locked(i)
}

fn enabled(name: u64) -> bool {
    let i: u64 = index_of(name)
    return i != model.MAX_ENTRIES && model.enabled(i)
}

fn toggle(name: u64) -> bool {
    let i: u64 = index_of(name)
    if i == model.MAX_ENTRIES || !model.set_enabled(i, !model.enabled(i)) {
        return false
    }
    return autostartsrc.save(i)
}
