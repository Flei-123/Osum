// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/fuied.fi -- FUI-ALL F-9: THE MULTI-LINE TEXT AREA FOR THE
// SCENE HOST.
//
// The model (a table of lines, the caret, the selection, the undo stack,
// the keys, the syntax colours) is the text area that lived in wlib.fi
// (K_TEXTAREA, RUNDE GUI-EDITOR). It never depended on wlib's widget list
// except for two numbers -- how many rows and columns fit -- so here those
// two numbers are SET BY THE HOST (`ed_size`), and everything else moved
// over unchanged. The painting is new: fUi's painter and the mono font of
// fuiglyph, on a grid of cells (`ta_cw`) like the old one.
//
// The host (`fuiscene.editor`) owns the node, the pointer and the focus;
// this file owns the text. One field is one index `t`.
profile app

import ulib
import wlibc
import wlib
import utf8
import fuiapp
import fuiglyph
import fui.render
import fui.theme
import fui.painter

export {
    ed_new, ed_size, ed_key, ed_key_mod, ed_paint, ed_hit, ed_press, ed_drag, ed_wheel,
    ed_scroll_hit, ta_text_set, ta_text_get, ta_text_len, ta_leeren,
    ta_zeilen, ta_zeile, ta_spalte, ta_geaendert, ta_sauber, ta_eol,
    ta_eol_set, ta_lang, ta_nurlesen, ta_gehe, ta_waehle, ta_zeile_p,
    ta_zeile_n, ta_einfuegen, ta_hat_auswahl, ta_follow,
    LANG_NONE, LANG_FIRN, LANG_SH, TA_MAX, ED_SB,
}

const ED_SB: u64 = 12
const TA_CLIP: u64 = 65536
static mut ta_clipbuf: u64 = 0

// Die Zeilentafel: je Zeile drei Woerter.
const LN_P: u64 = 0
const LN_N: u64 = 1
const LN_CAP: u64 = 2
const LN_W: u64 = 3

// Wie viele Zeilen und wie viele Textfelder es geben darf.
//
// DIE ZAHLEN SIND GEMESSEN UND NICHT GERATEN. 20 000 Zeilen zu drei
// Woertern sind 480 KiB Tafel -- das ist die eine grosse feste Tafel
// dieses Widgets, und sie liegt in `.bss`, also im Abbild als Luecke
// und nicht als Oktette. Die Messlatte dieser Runde nennt 5 000
// Zeilen; das Vierfache davon ist Luft, ohne dass die Tafel in die
// Groessenordnung kommt, in der sie selbst das Problem waere.
const TA_MAXL: u64 = 20000
const TA_MAX: u64 = 2 // wie viele mehrzeilige Felder gleichzeitig

// Der Zustand je Textfeld, neben der Zeilentafel.
const TS_NL: u64 = 0 // wie viele Zeilen belegt sind
const TS_CY: u64 = 1 // die Marke: Zeile
const TS_CX: u64 = 2 // die Marke: Oktett IN der Zeile
const TS_AY: u64 = 3 // der Anker der Auswahl: Zeile
const TS_AX: u64 = 4 // der Anker: Oktett
const TS_TOP: u64 = 5 // erste sichtbare Zeile
const TS_LEFT: u64 = 6 // waagerechter Versatz in ZEICHEN
const TS_DIRTY: u64 = 7 // veraendert seit dem letzten Sichern
const TS_WANT: u64 = 8 // Wunschspalte fuer Hoch/Runter
const TS_UN: u64 = 9 // wie viele Schritte im Rueckgaengig-Stapel
const TS_UAT: u64 = 10 // wo im Stapel wir stehen (fuer Wiederholen)
const TS_TAB: u64 = 11 // Tabulatorbreite in Zeichen
const TS_LANG: u64 = 12 // welche Sprache eingefaerbt wird
const TS_RO: u64 = 13 // nur lesen
const TS_EOL: u64 = 14 // 0 = LF, 1 = CRLF -- was beim Sichern geschrieben wird
const TS_ROWS: u64 = 15 // rows that fit (the host sets them)
const TS_FITC: u64 = 16 // columns that fit
const TS_F: u64 = 17

static mut ta_line: [u64; 60000] = [0 as u64; 60000] // TA_MAXL * LN_W
static mut ta_st: [u64; 34] = [0 as u64; 34] // TA_MAX * TS_F
static mut ta_n: u64 = 0 // wie viele Textfelder angelegt sind

// DIE ZEILENTAFEL GEHOERT IMMER GENAU EINEM FELD. Zwei mehrzeilige
// Felder gleichzeitig gibt es in diesem System nicht (der Editor hat
// EINES und schaltet die Reiter darauf um) -- `TA_MAX` ist 2, damit ein
// Dialog daneben eines haben darf, und die Tafel bekommt das Feld 0.
// Fuer ein zweites Feld faengt sie bei TA_MAXL/2 an.
fn ta_base(t: u64) -> u64 {
    return t * (TA_MAXL / TA_MAX)
}

fn ta_maxl(t: u64) -> u64 {
    let _v: u64 = t
    return TA_MAXL / TA_MAX
}

fn tag(t: u64, f: u64) -> u64 {
    if t >= TA_MAX || f >= TS_F {
        return 0
    }
    return ta_st[(t * TS_F + f) as usize]
}

fn tas(t: u64, f: u64, v: u64) {
    if t >= TA_MAX || f >= TS_F {
        return
    }
    ta_st[(t * TS_F + f) as usize] = v
}

fn lg(t: u64, y: u64, f: u64) -> u64 {
    if y >= ta_maxl(t) {
        return 0
    }
    return ta_line[((ta_base(t) + y) * LN_W + f) as usize]
}

fn ls_(t: u64, y: u64, f: u64, v: u64) {
    if y >= ta_maxl(t) {
        return
    }
    ta_line[((ta_base(t) + y) * LN_W + f) as usize] = v
}

// EINE ZEILE BEKOMMT PLATZ. Aufgerundet auf 64 Oktette, damit das
// Tippen in einer Zeile nicht bei jedem zweiten Zeichen neu abbildet.
//
// `map_surface` ist ein anonymes mmap und gibt nie etwas zurueck --
// eine Zeile, die kuerzer wird, behaelt ihren Block. Das ist Absicht:
// ein Editor, der beim Loeschen Speicher zurueckgibt, holt ihn beim
// naechsten Tippen wieder, und dieses System hat keinen Allokator, der
// das billig koennte.
fn ln_room(t: u64, y: u64, want: u64) -> bool {
    if lg(t, y, LN_CAP) >= want {
        return true
    }
    var cap: u64 = (want + 63) & 0xFFFFFFFFFFFFFFC0
    if cap < 64 {
        cap = 64
    }
    let p: u64 = wlibc.map_surface(cap)
    if ulib.bad(p) || p == 0 {
        return false
    }
    let alt: u64 = lg(t, y, LN_P)
    let n: u64 = lg(t, y, LN_N)
    if alt != 0 && n != 0 {
        var i: u64 = 0
        while i < n {
            __mmio_write8((p + i) as *mut u8, __mmio_read8((alt + i) as *mut u8))
            i = i + 1
        }
    }
    ls_(t, y, LN_P, p)
    ls_(t, y, LN_CAP, cap)
    return true
}

// ------------------------------------------------- die Zeilen umschichten
//
// EINE ZEILE EINFUEGEN ODER WEGNEHMEN VERSCHIEBT EINTRAEGE, NICHT TEXT.
// Drei Woerter je Zeile: bei 5000 Zeilen sind das im schlimmsten Fall
// 120 KiB Umkopieren, und das geschieht bei der EINGABETASTE, nicht bei
// jedem Zeichen.
fn ln_open(t: u64, at: u64) -> bool {
    let n: u64 = tag(t, TS_NL)
    if n + 1 >= ta_maxl(t) {
        return false
    }
    var y: u64 = n
    while y > at {
        ls_(t, y, LN_P, lg(t, y - 1, LN_P))
        ls_(t, y, LN_N, lg(t, y - 1, LN_N))
        ls_(t, y, LN_CAP, lg(t, y - 1, LN_CAP))
        y = y - 1
    }
    ls_(t, at, LN_P, 0)
    ls_(t, at, LN_N, 0)
    ls_(t, at, LN_CAP, 0)
    tas(t, TS_NL, n + 1)
    return true
}

fn ln_drop(t: u64, at: u64) {
    let n: u64 = tag(t, TS_NL)
    if at >= n {
        return
    }
    var y: u64 = at
    while y + 1 < n {
        ls_(t, y, LN_P, lg(t, y + 1, LN_P))
        ls_(t, y, LN_N, lg(t, y + 1, LN_N))
        ls_(t, y, LN_CAP, lg(t, y + 1, LN_CAP))
        y = y + 1
    }
    tas(t, TS_NL, n - 1)
}

// --------------------------------------------------- Oktette in der Zeile

fn ln_insert(t: u64, y: u64, at: u64, p: u64, n: u64) -> bool {
    if n == 0 {
        return true
    }
    let have: u64 = lg(t, y, LN_N)
    if !ln_room(t, y, have + n) {
        return false
    }
    let dst: u64 = lg(t, y, LN_P)
    var i: u64 = have
    while i > at {
        __mmio_write8((dst + i + n - 1) as *mut u8, __mmio_read8((dst + i - 1) as *mut u8))
        i = i - 1
    }
    i = 0
    while i < n {
        __mmio_write8((dst + at + i) as *mut u8, __mmio_read8((p + i) as *mut u8))
        i = i + 1
    }
    ls_(t, y, LN_N, have + n)
    return true
}

fn ln_erase(t: u64, y: u64, at: u64, n: u64) {
    let have: u64 = lg(t, y, LN_N)
    if at >= have || n == 0 {
        return
    }
    var weg: u64 = n
    if at + weg > have {
        weg = have - at
    }
    let p: u64 = lg(t, y, LN_P)
    var i: u64 = at
    while i + weg < have {
        __mmio_write8((p + i) as *mut u8, __mmio_read8((p + i + weg) as *mut u8))
        i = i + 1
    }
    ls_(t, y, LN_N, have - weg)
}

// ------------------------------------------------------ Zeichengrenzen
//
// RUNDE I18N gilt hier genauso wie im einzeiligen Feld: die Marke steht
// IMMER auf einer Zeichengrenze, sonst zerteilt der naechste
// Rueckschritt einen Umlaut.
fn ta_back(t: u64, y: u64, at: u64) -> u64 {
    if at == 0 {
        return 0
    }
    let p: u64 = lg(t, y, LN_P)
    var q: u64 = at - 1
    while q > 0 && (__mmio_read8((p + q) as *mut u8) as u64 & 0xC0) == 0x80 {
        q = q - 1
    }
    return q
}

fn ta_fwd(t: u64, y: u64, at: u64) -> u64 {
    let n: u64 = lg(t, y, LN_N)
    if at >= n {
        return n
    }
    let p: u64 = lg(t, y, LN_P)
    var q: u64 = at + 1
    while q < n && (__mmio_read8((p + q) as *mut u8) as u64 & 0xC0) == 0x80 {
        q = q + 1
    }
    return q
}

// Wie viele ZEICHEN stehen in den ersten `n` Oktetten? Das ist die
// Spalte, und die Spalte ist bei fester Schrift auch der Ort.
fn ta_cols(t: u64, y: u64, n: u64) -> u64 {
    let p: u64 = lg(t, y, LN_P)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if (__mmio_read8((p + i) as *mut u8) as u64 & 0xC0) != 0x80 {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// Und zurueck: an welchem OKTETT faengt die Spalte `col` an?
fn ta_at_col(t: u64, y: u64, col: u64) -> u64 {
    let n: u64 = lg(t, y, LN_N)
    let p: u64 = lg(t, y, LN_P)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if (__mmio_read8((p + i) as *mut u8) as u64 & 0xC0) != 0x80 {
            if c == col {
                return i
            }
            c = c + 1
        }
        i = i + 1
    }
    return n
}

// ------------------------------------------------------------ die Auswahl

fn ta_has_sel(t: u64) -> bool {
    return tag(t, TS_AY) != tag(t, TS_CY) || tag(t, TS_AX) != tag(t, TS_CX)
}

fn ta_sel_clear(t: u64) {
    tas(t, TS_AY, tag(t, TS_CY))
    tas(t, TS_AX, tag(t, TS_CX))
}

// Der Anfang der Auswahl in Lesereihenfolge -- der Anker kann HINTER
// der Marke liegen, wenn rueckwaerts ausgewaehlt wurde.
fn ta_sel_first(t: u64) -> u64 {
    let ay: u64 = tag(t, TS_AY)
    let cy: u64 = tag(t, TS_CY)
    if ay < cy {
        return (ay << 32) | tag(t, TS_AX)
    }
    if cy < ay {
        return (cy << 32) | tag(t, TS_CX)
    }
    if tag(t, TS_AX) <= tag(t, TS_CX) {
        return (ay << 32) | tag(t, TS_AX)
    }
    return (cy << 32) | tag(t, TS_CX)
}

fn ta_sel_last(t: u64) -> u64 {
    let ay: u64 = tag(t, TS_AY)
    let cy: u64 = tag(t, TS_CY)
    if ay < cy {
        return (cy << 32) | tag(t, TS_CX)
    }
    if cy < ay {
        return (ay << 32) | tag(t, TS_AX)
    }
    if tag(t, TS_AX) <= tag(t, TS_CX) {
        return (cy << 32) | tag(t, TS_CX)
    }
    return (ay << 32) | tag(t, TS_AX)
}

// Die Auswahl wegnehmen. Danach steht die Marke an ihrem Anfang.
fn ta_del_sel(t: u64) -> bool {
    if !ta_has_sel(t) {
        return false
    }
    let a: u64 = ta_sel_first(t)
    let b: u64 = ta_sel_last(t)
    let ay: u64 = a >> 32
    let ax: u64 = a & 0xFFFFFFFF
    let by: u64 = b >> 32
    let bx: u64 = b & 0xFFFFFFFF
    if ay == by {
        ln_erase(t, ay, ax, bx - ax)
    } else {
        // Der Rest der ersten Zeile faellt weg, der Rest der letzten
        // wird angehaengt, alles dazwischen verschwindet.
        ln_erase(t, ay, ax, lg(t, ay, LN_N) - ax)
        let rest: u64 = lg(t, by, LN_N)
        if rest > bx {
            let _o: bool = ln_insert(t, ay, ax, lg(t, by, LN_P) + bx, rest - bx)
        }
        var k: u64 = ay + 1
        while k <= by {
            ln_drop(t, ay + 1)
            k = k + 1
        }
    }
    tas(t, TS_CY, ay)
    tas(t, TS_CX, ax)
    ta_sel_clear(t)
    return true
}

// ================================================== RUECKGAENGIG UND WIEDERHOLEN
//
// WAS GESICHERT WIRD: der ganze Text, als EIN Schnappschuss je Schritt.
//
// Das ist die grobe Art, und sie steht hier mit Begruendung statt mit
// Entschuldigung. Die feine Art (je Schritt nur "an Stelle x kamen
// diese drei Oktette dazu") braucht eine Umkehrung je Operation, und
// jede davon ist eine eigene Fehlerquelle -- eine falsche Umkehrung
// faellt erst auf, wenn jemand zwanzig Schritte zurueckgeht und der
// Text danach kaputt ist.
//
// Ein Schnappschuss kann nicht falsch sein. Was er kostet, ist
// Speicher, und zwar die Dateigroesse mal UN_MAX; bei einer Datei von
// 200 KiB und 16 Schritten sind das 3 MiB, und dieses System hat 512.
// Wer eine Datei von 10 MiB bearbeitet, bekommt keinen Schritt mehr
// (`ta_push_undo` gibt dann still auf, statt den Editor anzuhalten) --
// das ist ehrlicher als ein Stapel, der gelegentlich Unsinn einspielt.
const UN_MAX: u64 = 16
const UN_P: u64 = 0 // Zeiger auf den Schnappschuss
const UN_N: u64 = 1 // seine Laenge
const UN_CAP: u64 = 2
const UN_CY: u64 = 3 // wo die Marke stand
const UN_CX: u64 = 4
const UN_W: u64 = 5

static mut ta_un: [u64; 160] = [0 as u64; 160] // TA_MAX * UN_MAX * UN_W

fn ug(t: u64, k: u64, f: u64) -> u64 {
    return ta_un[((t * UN_MAX + k) * UN_W + f) as usize]
}

fn us(t: u64, k: u64, f: u64, v: u64) {
    ta_un[((t * UN_MAX + k) * UN_W + f) as usize] = v
}

// Wie viele Oktette der ganze Text braucht (mit je einem \n).
fn ta_bytes(t: u64) -> u64 {
    let n: u64 = tag(t, TS_NL)
    var sum: u64 = 0
    var y: u64 = 0
    while y < n {
        sum = sum + lg(t, y, LN_N) + 1
        y = y + 1
    }
    return sum
}

// Den ganzen Text in einen Puffer schreiben. Gibt die Laenge zurueck.
fn ta_copy_out(t: u64, dst: u64, max: u64) -> u64 {
    let n: u64 = tag(t, TS_NL)
    var at: u64 = 0
    var y: u64 = 0
    while y < n {
        let ln: u64 = lg(t, y, LN_N)
        let p: u64 = lg(t, y, LN_P)
        var i: u64 = 0
        while i < ln && at < max {
            __mmio_write8((dst + at) as *mut u8, __mmio_read8((p + i) as *mut u8))
            at = at + 1
            i = i + 1
        }
        if y + 1 < n && at < max {
            __mmio_write8((dst + at) as *mut u8, 10 as u8)
            at = at + 1
        }
        y = y + 1
    }
    return at
}

fn ta_push_undo(t: u64) {
    let need: u64 = ta_bytes(t) + 16
    let at: u64 = tag(t, TS_UAT)
    // Ein neuer Schritt wirft alles weg, was "vorwaerts" lag -- wer
    // nach dem Zurueckgehen tippt, hat einen neuen Ast aufgemacht.
    tas(t, TS_UN, at)
    var k: u64 = at
    if k >= UN_MAX {
        // Der Stapel ist voll: den aeltesten wegschieben.
        var j: u64 = 0
        while j + 1 < UN_MAX {
            us(t, j, UN_P, ug(t, j + 1, UN_P))
            us(t, j, UN_N, ug(t, j + 1, UN_N))
            us(t, j, UN_CAP, ug(t, j + 1, UN_CAP))
            us(t, j, UN_CY, ug(t, j + 1, UN_CY))
            us(t, j, UN_CX, ug(t, j + 1, UN_CX))
            j = j + 1
        }
        k = UN_MAX - 1
    }
    if ug(t, k, UN_CAP) < need {
        let p: u64 = wlibc.map_surface((need + 4095) & 0xFFFFFFFFFFFFF000)
        if ulib.bad(p) || p == 0 {
            return
        }
        us(t, k, UN_P, p)
        us(t, k, UN_CAP, (need + 4095) & 0xFFFFFFFFFFFFF000)
    }
    us(t, k, UN_N, ta_copy_out(t, ug(t, k, UN_P), ug(t, k, UN_CAP)))
    us(t, k, UN_CY, tag(t, TS_CY))
    us(t, k, UN_CX, tag(t, TS_CX))
    tas(t, TS_UN, k + 1)
    tas(t, TS_UAT, k + 1)
}

fn ta_restore(t: u64, k: u64) {
    ta_set_text(t, ug(t, k, UN_P), ug(t, k, UN_N))
    tas(t, TS_CY, ug(t, k, UN_CY))
    tas(t, TS_CX, ug(t, k, UN_CX))
    ta_sel_clear(t)
    ta_follow(t)
}

// ------------------------------------------------------------- Text setzen

fn ta_clear(t: u64) {
    tas(t, TS_NL, 1)
    ls_(t, 0, LN_N, 0)
    tas(t, TS_CY, 0)
    tas(t, TS_CX, 0)
    tas(t, TS_TOP, 0)
    tas(t, TS_LEFT, 0)
    ta_sel_clear(t)
}

// EINEN GANZEN TEXT EINLESEN. Das ist der Weg, auf dem eine Datei
// hereinkommt: einmal durch die Oktette, bei jedem \n eine Zeile
// weiter. \r vor dem \n wird geschluckt und GEMERKT (`TS_EOL`), damit
// eine Datei aus der anderen Welt beim Sichern so bleibt, wie sie war.
fn ta_set_text(t: u64, p: u64, n: u64) {
    tas(t, TS_NL, 0)
    tas(t, TS_EOL, 0)
    var y: u64 = 0
    var start: u64 = 0
    var i: u64 = 0
    if !ln_open(t, 0) {
        return
    }
    while i <= n {
        if i == n || __mmio_read8((p + i) as *mut u8) as u64 == 10 {
            var ende: u64 = i
            if ende > start && __mmio_read8((p + ende - 1) as *mut u8) as u64 == 13 {
                ende = ende - 1
                tas(t, TS_EOL, 1)
            }
            if ende > start {
                let _o: bool = ln_insert(t, y, 0, p + start, ende - start)
            }
            if i == n {
                i = i + 1
            } else {
                y = y + 1
                if y >= ta_maxl(t) {
                    i = n + 1
                } else if !ln_open(t, y) {
                    i = n + 1
                } else {
                    start = i + 1
                    i = i + 1
                }
            }
        } else {
            i = i + 1
        }
    }
    tas(t, TS_CY, 0)
    tas(t, TS_CX, 0)
    tas(t, TS_TOP, 0)
    tas(t, TS_LEFT, 0)
    ta_sel_clear(t)
}

// ---------------------------------------------------------- Text einfuegen

// EINEN BLOCK EINFUEGEN, mit Zeilenumbruechen darin -- das ist das
// Einsetzen aus der Zwischenablage und zugleich der Weg, auf dem EIN
// Zeichen hereinkommt (dann ohne Umbruch).
fn ta_insert(t: u64, p: u64, n: u64) {
    if tag(t, TS_RO) != 0 {
        return
    }
    let _d: bool = ta_del_sel(t)
    var i: u64 = 0
    var start: u64 = 0
    while i <= n {
        if i == n || __mmio_read8((p + i) as *mut u8) as u64 == 10 {
            var ende: u64 = i
            if ende > start && __mmio_read8((p + ende - 1) as *mut u8) as u64 == 13 {
                ende = ende - 1
            }
            if ende > start {
                let y: u64 = tag(t, TS_CY)
                if ln_insert(t, y, tag(t, TS_CX), p + start, ende - start) {
                    tas(t, TS_CX, tag(t, TS_CX) + (ende - start))
                }
            }
            if i < n {
                ta_split(t)
            }
            start = i + 1
        }
        i = i + 1
    }
    tas(t, TS_DIRTY, 1)
    ta_sel_clear(t)
    ta_follow(t)
}

// DIE EINGABETASTE: die Zeile an der Marke teilen.
fn ta_split(t: u64) {
    let y: u64 = tag(t, TS_CY)
    let at: u64 = tag(t, TS_CX)
    let n: u64 = lg(t, y, LN_N)
    if !ln_open(t, y + 1) {
        return
    }
    if n > at {
        let _o: bool = ln_insert(t, y + 1, 0, lg(t, y, LN_P) + at, n - at)
        ln_erase(t, y, at, n - at)
    }
    tas(t, TS_CY, y + 1)
    tas(t, TS_CX, 0)
}

// ZWEI ZEILEN ZUSAMMENZIEHEN -- Rueckschritt am Zeilenanfang.
fn ta_join(t: u64, y: u64) {
    let n: u64 = lg(t, y, LN_N)
    let m: u64 = lg(t, y + 1, LN_N)
    if m > 0 {
        let _o: bool = ln_insert(t, y, n, lg(t, y + 1, LN_P), m)
    }
    ln_drop(t, y + 1)
    tas(t, TS_CY, y)
    tas(t, TS_CX, n)
}

// ------------------------------------------------------------- die Masse
//
// Zeilenhoehe und Zellenbreite der FESTEN Schrift. Sie stehen an einer
// Stelle, weil der Zeichner, die Trefferpruefung und der Bildlauf
// dieselbe Zahl brauchen -- rechnet einer anders, klickt man daneben.
fn ta_lh() -> u64 {
    return wlibc.text_h(wlibc.px_mono()) + 2
}

fn ta_cw() -> u64 {
    let c: u64 = wlibc.mono_cell(wlibc.px_mono())
    if c == 0 {
        return 8
    }
    return c
}

// Wie viele Zeilen und Spalten in das Feld passen.
fn ta_rows(t: u64) -> u64 {
    let r: u64 = tag(t, TS_ROWS)
    if r == 0 {
        return 1
    }
    return r
}

fn ta_gutter(t: u64) -> u64 {
    if tag(t, TS_LANG) == 0xFF {
        return 0
    }
    // Die Spalte mit den Zeilennummern ist so breit wie die groesste
    // Nummer, mindestens drei Stellen -- sonst springt der Text, wenn
    // die Datei von 999 auf 1000 Zeilen waechst.
    var d: u64 = 3
    var n: u64 = tag(t, TS_NL)
    var k: u64 = 1000
    while n >= k && d < 7 {
        d = d + 1
        k = k * 10
    }
    return d * ta_cw() + 10
}

fn ta_cols_fit(t: u64) -> u64 {
    let c: u64 = tag(t, TS_FITC)
    if c == 0 {
        return 1
    }
    return c
}

// ============================================= DER BILDLAUF FOLGT DER MARKE
//
// Ohne diese Funktion tippt man aus dem Fenster heraus: die Marke geht
// weiter, das Bild bleibt stehen. Sie wird nach JEDER Bewegung und
// jeder Aenderung gerufen.
fn ta_follow(t: u64) {
    let rows: u64 = ta_rows(t)
    let cy: u64 = tag(t, TS_CY)
    var top: u64 = tag(t, TS_TOP)
    if cy < top {
        top = cy
    }
    if cy >= top + rows {
        top = cy + 1 - rows
    }
    let n: u64 = tag(t, TS_NL)
    if top + rows > n {
        if n > rows {
            if top > n - rows {
                top = n - rows
            }
        } else {
            top = 0
        }
    }
    tas(t, TS_TOP, top)
    // Und waagerecht dasselbe, in ZEICHEN.
    let cols: u64 = ta_cols_fit(t)
    let col: u64 = ta_cols(t, cy, tag(t, TS_CX))
    var left: u64 = tag(t, TS_LEFT)
    if col < left {
        left = col
    }
    if col >= left + cols {
        left = col + 1 - cols
    }
    tas(t, TS_LEFT, left)
}

// ------------------------------------------------------------ die Bewegung

fn ta_clamp(t: u64) {
    let n: u64 = tag(t, TS_NL)
    if tag(t, TS_CY) >= n {
        tas(t, TS_CY, n - 1)
    }
    let ln: u64 = lg(t, tag(t, TS_CY), LN_N)
    if tag(t, TS_CX) > ln {
        tas(t, TS_CX, ln)
    }
}

// WO DER TEXT EINER ZEILE ANFAENGT -- also hinter der Einrueckung.
//
// Sie wird an ZWEI Stellen gebraucht: Pos1 springt zuerst hierher (und
// erst beim zweiten Druck an den Rand), und die Eingabetaste nimmt
// genau diese Oktette auf die neue Zeile mit. Deshalb steht die
// Rechnung einmal und nicht zweimal.
//
// Eine Zeile, die NUR aus Leerzeichen besteht, hat keinen Textanfang;
// dann kommt 0 heraus, und Pos1 tut das Richtige (an den Rand).
fn ta_einzug(t: u64, y: u64) -> u64 {
    let p: u64 = lg(t, y, LN_P)
    let n: u64 = lg(t, y, LN_N)
    var q: u64 = 0
    while q < n {
        let c: u64 = __mmio_read8((p + q) as *mut u8) as u64
        if c != 32 && c != 9 {
            return q
        }
        q = q + 1
    }
    return 0
}

// WORTWEISE. Ein "Wort" ist hier, was auch der Rest dieses Systems ein
// Wort nennt: Buchstaben, Ziffern und der Unterstrich. Alles andere
// trennt.
fn ta_isword(c: u64) -> bool {
    if c >= 48 && c <= 57 {
        return true
    }
    if c >= 65 && c <= 90 {
        return true
    }
    if c >= 97 && c <= 122 {
        return true
    }
    if c == 95 || c >= 128 {
        return true
    }
    return false
}

fn ta_word_left(t: u64) {
    var y: u64 = tag(t, TS_CY)
    var x: u64 = tag(t, TS_CX)
    if x == 0 {
        if y == 0 {
            return
        }
        tas(t, TS_CY, y - 1)
        tas(t, TS_CX, lg(t, y - 1, LN_N))
        return
    }
    let p: u64 = lg(t, y, LN_P)
    // Erst das Trennende ueberspringen, dann das Wort.
    while x > 0 && !ta_isword(__mmio_read8((p + ta_back(t, y, x)) as *mut u8) as u64) {
        x = ta_back(t, y, x)
    }
    while x > 0 && ta_isword(__mmio_read8((p + ta_back(t, y, x)) as *mut u8) as u64) {
        x = ta_back(t, y, x)
    }
    tas(t, TS_CX, x)
}

fn ta_word_right(t: u64) {
    let y: u64 = tag(t, TS_CY)
    let n: u64 = lg(t, y, LN_N)
    var x: u64 = tag(t, TS_CX)
    if x >= n {
        if y + 1 < tag(t, TS_NL) {
            tas(t, TS_CY, y + 1)
            tas(t, TS_CX, 0)
        }
        return
    }
    let p: u64 = lg(t, y, LN_P)
    while x < n && ta_isword(__mmio_read8((p + x) as *mut u8) as u64) {
        x = ta_fwd(t, y, x)
    }
    while x < n && !ta_isword(__mmio_read8((p + x) as *mut u8) as u64) {
        x = ta_fwd(t, y, x)
    }
    tas(t, TS_CX, x)
}

// Hoch und runter halten die WUNSCHSPALTE fest: wer in einer langen
// Zeile steht, durch eine kurze faehrt und wieder in eine lange kommt,
// landet dort, wo er angefangen hat. Ohne das klebt die Marke an der
// kuerzesten Zeile, durch die sie gekommen ist.
fn ta_updown(t: u64, hoch: bool, n: u64) {
    var want: u64 = tag(t, TS_WANT)
    let y0: u64 = tag(t, TS_CY)
    if want == 0xFFFFFFFFFFFFFFFF {
        want = ta_cols(t, y0, tag(t, TS_CX))
    }
    var y: u64 = y0
    if hoch {
        if y < n {
            y = 0
        } else {
            y = y - n
        }
    } else {
        y = y + n
        if y >= tag(t, TS_NL) {
            y = tag(t, TS_NL) - 1
        }
    }
    tas(t, TS_CY, y)
    tas(t, TS_CX, ta_at_col(t, y, want))
    tas(t, TS_WANT, want)
}

// ======================================================== DIE TASTATUR
//
// EINE Stelle, an der entschieden wird, was eine Taste tut. Der
// Modifikator kommt aus `key_mod()` -- diese Runde hat ihn auf die
// Leitung gebracht (kernel/drv/hid/kbd.fi, `mods_of`), vorher war
// Umschalt+Links von Links nicht zu unterscheiden.
//
// DIE AUSWAHL IST EINE REGEL UND KEINE SONDERBEHANDLUNG: vor jeder
// Bewegung wird gefragt, ob Umschalt liegt. Wenn ja, bleibt der Anker
// stehen; wenn nein, wird er nachgezogen. Damit waehlt JEDE
// Bewegungstaste aus, auch die, an die man zuerst nicht denkt
// (Strg+Pos1, Bild ab).
fn ta_key(t: u64, k: u64) {
    if t >= TA_MAX {
        return
    }
    let shift: bool = wlib.key_shift()
    let ctrl: bool = wlib.key_ctrl()
    let rows: u64 = ta_rows(t)
    var bewegt: bool = false
    var geaendert: bool = false
    // Die Wunschspalte gilt nur fuer Hoch/Runter in Folge.
    if k != wlib.KEY_UP && k != wlib.KEY_DOWN && k != wlib.KEY_PGUP && k != wlib.KEY_PGDN {
        tas(t, TS_WANT, 0xFFFFFFFFFFFFFFFF)
    }

    if k == wlib.KEY_LEFT {
        if ctrl {
            ta_word_left(t)
        } else if ta_has_sel(t) && !shift {
            let a: u64 = ta_sel_first(t)
            tas(t, TS_CY, a >> 32)
            tas(t, TS_CX, a & 0xFFFFFFFF)
        } else if tag(t, TS_CX) > 0 {
            tas(t, TS_CX, ta_back(t, tag(t, TS_CY), tag(t, TS_CX)))
        } else if tag(t, TS_CY) > 0 {
            tas(t, TS_CY, tag(t, TS_CY) - 1)
            tas(t, TS_CX, lg(t, tag(t, TS_CY), LN_N))
        }
        bewegt = true
    } else if k == wlib.KEY_RIGHT {
        if ctrl {
            ta_word_right(t)
        } else if ta_has_sel(t) && !shift {
            let b: u64 = ta_sel_last(t)
            tas(t, TS_CY, b >> 32)
            tas(t, TS_CX, b & 0xFFFFFFFF)
        } else if tag(t, TS_CX) < lg(t, tag(t, TS_CY), LN_N) {
            tas(t, TS_CX, ta_fwd(t, tag(t, TS_CY), tag(t, TS_CX)))
        } else if tag(t, TS_CY) + 1 < tag(t, TS_NL) {
            tas(t, TS_CY, tag(t, TS_CY) + 1)
            tas(t, TS_CX, 0)
        }
        bewegt = true
    } else if k == wlib.KEY_UP {
        if ctrl {
            // Strg+Hoch rollt das Bild, ohne die Marke mitzunehmen --
            // wie in jedem Editor.
            if tag(t, TS_TOP) > 0 {
                tas(t, TS_TOP, tag(t, TS_TOP) - 1)
            }
            return
        }
        ta_updown(t, true, 1)
        bewegt = true
    } else if k == wlib.KEY_DOWN {
        if ctrl {
            if tag(t, TS_TOP) + rows < tag(t, TS_NL) {
                tas(t, TS_TOP, tag(t, TS_TOP) + 1)
            }
            return
        }
        ta_updown(t, false, 1)
        bewegt = true
    } else if k == wlib.KEY_PGUP {
        ta_updown(t, true, rows)
        bewegt = true
    } else if k == wlib.KEY_PGDN {
        ta_updown(t, false, rows)
        bewegt = true
    } else if k == wlib.KEY_HOME {
        if ctrl {
            tas(t, TS_CY, 0)
            tas(t, TS_CX, 0)
        } else {
            // POS1 GEHT ZUERST AN DEN TEXT, DANN AN DEN RAND. Wer in
            // eingerueckten Zeilen arbeitet, will den Text und nicht
            // die Spalte 0 -- und wer die Spalte 0 will, drueckt noch
            // einmal.
            let ziel: u64 = ta_einzug(t, tag(t, TS_CY))
            if tag(t, TS_CX) == ziel {
                tas(t, TS_CX, 0)
            } else {
                tas(t, TS_CX, ziel)
            }
        }
        bewegt = true
    } else if k == wlib.KEY_END {
        if ctrl {
            tas(t, TS_CY, tag(t, TS_NL) - 1)
            tas(t, TS_CX, lg(t, tag(t, TS_NL) - 1, LN_N))
        } else {
            tas(t, TS_CX, lg(t, tag(t, TS_CY), LN_N))
        }
        bewegt = true
    } else if k == wlib.KEY_BS || k == 127 {
        if tag(t, TS_RO) != 0 {
            return
        }
        ta_push_undo(t)
        if !ta_del_sel(t) {
            if tag(t, TS_CX) > 0 {
                let at: u64 = ta_back(t, tag(t, TS_CY), tag(t, TS_CX))
                ln_erase(t, tag(t, TS_CY), at, tag(t, TS_CX) - at)
                tas(t, TS_CX, at)
            } else if tag(t, TS_CY) > 0 {
                ta_join(t, tag(t, TS_CY) - 1)
            }
        }
        geaendert = true
    } else if k == wlib.KEY_DEL || k == wlib.KEY_SDEL {
        if tag(t, TS_RO) != 0 {
            return
        }
        ta_push_undo(t)
        if !ta_del_sel(t) {
            let y: u64 = tag(t, TS_CY)
            let x: u64 = tag(t, TS_CX)
            if x < lg(t, y, LN_N) {
                ln_erase(t, y, x, ta_fwd(t, y, x) - x)
            } else if y + 1 < tag(t, TS_NL) {
                ta_join(t, y)
            }
        }
        geaendert = true
    } else if k == wlib.KEY_ENTER {
        if tag(t, TS_RO) != 0 {
            return
        }
        ta_push_undo(t)
        let _d: bool = ta_del_sel(t)
        ta_split(t)
        // DIE EINRUECKUNG DER VORIGEN ZEILE WIRD UEBERNOMMEN. Ohne das
        // faengt in einem eingerueckten Block jede neue Zeile ganz
        // links an, und der Rhythmus des Tippens bricht.
        let vy: u64 = tag(t, TS_CY) - 1
        let e2: u64 = ta_einzug(t, vy)
        if e2 > 0 {
            if ln_insert(t, tag(t, TS_CY), 0, lg(t, vy, LN_P), e2) {
                tas(t, TS_CX, e2)
            }
        }
        geaendert = true
    } else if k == wlib.KEY_TAB {
        if tag(t, TS_RO) != 0 {
            return
        }
        ta_push_undo(t)
        var sp: [u8; 8] = [32 as u8; 8]
        var br: u64 = tag(t, TS_TAB)
        if br == 0 || br > 8 {
            br = 4
        }
        ta_insert(t, (&sp[0 as usize]) as u64, br)
        geaendert = true
    } else if k == wlib.KEY_CTRL_A {
        tas(t, TS_AY, 0)
        tas(t, TS_AX, 0)
        tas(t, TS_CY, tag(t, TS_NL) - 1)
        tas(t, TS_CX, lg(t, tag(t, TS_NL) - 1, LN_N))
        return
    } else if k == wlib.KEY_CTRL_C || k == wlib.KEY_CTRL_X {
        ta_clip_put(t)
        if k == wlib.KEY_CTRL_X && tag(t, TS_RO) == 0 {
            ta_push_undo(t)
            let _d2: bool = ta_del_sel(t)
            geaendert = true
        } else {
            return
        }
    } else if k == wlib.KEY_CTRL_V {
        if tag(t, TS_RO) != 0 {
            return
        }
        ta_push_undo(t)
        ta_clip_take(t)
        geaendert = true
    } else if k == wlib.KEY_CTRL_Z {
        // RUECKGAENGIG. Der Schritt, auf den wir zurueckgehen, ist der
        // VORIGE -- und bevor wir den ersten Schritt zurueckgehen,
        // muss der JETZIGE Stand im Stapel stehen, sonst ist er nach
        // einem Wiederholen weg.
        let at: u64 = tag(t, TS_UAT)
        if at > 0 {
            if at == tag(t, TS_UN) {
                ta_push_undo(t)
                tas(t, TS_UAT, at)
            }
            ta_restore(t, at - 1)
            tas(t, TS_UAT, at - 1)
            tas(t, TS_DIRTY, 1)
        }
        return
    } else if k == 25 {
        // Strg+Y -- Wiederholen.
        let at2: u64 = tag(t, TS_UAT)
        if at2 + 1 < tag(t, TS_UN) {
            ta_restore(t, at2 + 1)
            tas(t, TS_UAT, at2 + 1)
            tas(t, TS_DIRTY, 1)
        }
        return
    } else if druckbar(k) {
        if tag(t, TS_RO) != 0 {
            return
        }
        // EIN SCHNAPPSCHUSS JE WORT, NICHT JE ZEICHEN. Wer einen Satz
        // tippt und einmal Strg+Z drueckt, will den Satz weg haben und
        // nicht den letzten Buchstaben. Ein neues Wort faengt nach
        // einem Trennzeichen an.
        if !ta_isword(k) || !ta_has_sel(t) {
            if !ta_isword(k) {
                ta_push_undo(t)
            } else if tag(t, TS_UN) == 0 {
                ta_push_undo(t)
            }
        }
        // EINE TASTE IST EIN OKTETT. Die Oktette eines Umlauts kommen
        // von der Tastatur NACHEINANDER (siehe `druckbar` weiter
        // unten) und landen dadurch nebeneinander im Puffer -- genau
        // die Folge, die `utf8.next` beim Zeichnen wieder zusammensetzt.
        var ein: [u8; 8] = [0 as u8; 8]
        ein[(0) as usize] = k as u8
        ta_insert(t, (&ein[0 as usize]) as u64, 1)
        geaendert = true
    } else {
        return
    }

    if bewegt {
        ta_clamp(t)
        if !shift {
            ta_sel_clear(t)
        }
        ta_follow(t)
    }
    if geaendert {
        tas(t, TS_DIRTY, 1)
        ta_follow(t)
    }
}

// ---------------------------------------------------- die Zwischenablage

fn ta_clip_put(t: u64) {
    if !ta_has_sel(t) {
        return
    }
    let a: u64 = ta_sel_first(t)
    let b: u64 = ta_sel_last(t)
    let ay: u64 = a >> 32
    let ax: u64 = a & 0xFFFFFFFF
    let by: u64 = b >> 32
    let bx: u64 = b & 0xFFFFFFFF
    // Ein Puffer fuer die Auswahl. Er wird einmal geholt und behalten.
    if ta_clipbuf == 0 {
        ta_clipbuf = wlibc.map_surface(TA_CLIP)
        if ulib.bad(ta_clipbuf) {
            ta_clipbuf = 0
            return
        }
    }
    var at: u64 = 0
    var y: u64 = ay
    while y <= by && at < TA_CLIP {
        var von: u64 = 0
        var bis: u64 = lg(t, y, LN_N)
        if y == ay {
            von = ax
        }
        if y == by {
            bis = bx
        }
        let p: u64 = lg(t, y, LN_P)
        var q: u64 = von
        while q < bis && at < TA_CLIP {
            __mmio_write8((ta_clipbuf + at) as *mut u8, __mmio_read8((p + q) as *mut u8))
            at = at + 1
            q = q + 1
        }
        if y < by && at < TA_CLIP {
            __mmio_write8((ta_clipbuf + at) as *mut u8, 10 as u8)
            at = at + 1
        }
        y = y + 1
    }
    let _r: u64 = wlibc.clip_put(ta_clipbuf, at)
}

fn ta_clip_take(t: u64) {
    if ta_clipbuf == 0 {
        ta_clipbuf = wlibc.map_surface(TA_CLIP)
        if ulib.bad(ta_clipbuf) {
            ta_clipbuf = 0
            return
        }
    }
    let n: u64 = wlibc.clip_take(ta_clipbuf, TA_CLIP - 1)
    if n == 0 {
        return
    }
    ta_insert(t, ta_clipbuf, n)
}

// ================================================= DIE SYNTAXHERVORHEBUNG
//
// SIE IST EINE TABELLE UND KEIN GEFLECHT AUS if.
//
// Eine Sprache besteht hier aus vier Angaben: ihre Schluesselwoerter,
// wie ein Zeilenkommentar anfaengt, ob sie Zeichenketten in
// Anfuehrungszeichen kennt, und ob Zahlen eigens gefaerbt werden. Wer
// eine fuenfte Sprache dazulegt, schreibt eine Zeile in `ta_lang_kw`
// und nichts sonst -- genau das verlangt der Auftrag ("Struktur so,
// dass weitere Sprachen dazukommen koennen").
//
// WAS SIE AUSDRUECKLICH NICHT IST: ein Parser. Sie sieht eine Zeile
// fuer sich allein an. Ein Blockkommentar ueber mehrere Zeilen wird
// deshalb nur in der Zeile erkannt, in der er anfaengt -- und das
// steht hier, statt dass es jemand spaeter als Fehler meldet.
const LANG_NONE: u64 = 0
const LANG_FIRN: u64 = 1
const LANG_SH: u64 = 2
const LANG_COUNT: u64 = 3

// Die Schluesselwoerter, durch Leerzeichen getrennt, je Sprache eine
// Zeichenkette.
static mut kw_firn: [u8; 177] = "fn let var const if else while return struct import export profile true false bool u8 u64 i64 usize as pub static mut match for in break continue type enum impl self and or not\0"
static mut kw_sh: [u8; 135] = "if then else elif fi for while do done case esac function return local export echo cd set unset read exit break continue in shift test\0"

// Die Farben. Sie kommen aus dem Farbschema und nicht aus dem
// Quelltext -- ein Editor, der seine eigenen sechs Hexziffern malt,
// sieht in jedem zweiten Schema falsch aus.
const HL_TEXT: u64 = 0
const HL_KEY: u64 = 1
const HL_STR: u64 = 2
const HL_COM: u64 = 3
const HL_NUM: u64 = 4

fn hl_color(art: u64) -> u64 {
    if art == HL_KEY {
        return wlibc.theme(wlibc.T_ACCENT)
    }
    if art == HL_STR {
        return ta_misch(wlibc.theme(wlibc.T_FG), 0x00C07030, 6)
    }
    if art == HL_COM {
        return wlibc.theme(wlibc.T_DIM)
    }
    if art == HL_NUM {
        return ta_misch(wlibc.theme(wlibc.T_FG), 0x00206090, 6)
    }
    return wlibc.theme(wlibc.T_FG)
}

// Eine Farbe zur Haelfte in eine andere ziehen -- damit die
// Hervorhebung im hellen wie im dunklen Schema lesbar bleibt, statt
// eine feste Farbe zu behaupten.
fn ta_mix(a: u64, b: u64) -> u64 {
    return ta_misch(a, b, 3)
}

// `teil` von acht Teilen `b`, der Rest `a`. EINE Rechnung fuer zwei
// sehr verschiedene Zwecke, und der Unterschied ist genau dieser
// Parameter:
//
//   Syntaxfarbe      teil 6 -- die Farbe soll man SEHEN
//   Zeile mit Marke  teil 1 -- die Hinterlegung soll man FAST NICHT
//                    sehen
//
// GEMESSEN AM BILD, nicht geschaetzt: der erste Entwurf nahm fuer
// beides drei Viertel, und die Zeile unter der Marke wurde damit ein
// satter blauer Balken quer durch das Fenster -- der Text darin war
// schlechter zu lesen als ueberall sonst, und das Auge sprang beim
// Tippen nur noch dorthin. Eine Hervorhebung, die lauter ist als der
// Text, den sie hervorhebt, ist keine.
fn ta_misch(a: u64, b: u64, teil: u64) -> u64 {
    let rest: u64 = 8 - teil
    let r: u64 = (((a >> 16) & 0xFF) * rest + ((b >> 16) & 0xFF) * teil) / 8
    let gg: u64 = (((a >> 8) & 0xFF) * rest + ((b >> 8) & 0xFF) * teil) / 8
    let bb: u64 = ((a & 0xFF) * rest + (b & 0xFF) * teil) / 8
    return (r << 16) | (gg << 8) | bb
}

fn kw_list(lang: u64) -> u64 {
    if lang == LANG_FIRN {
        return (&kw_firn[0 as usize]) as u64
    }
    if lang == LANG_SH {
        return (&kw_sh[0 as usize]) as u64
    }
    return 0
}

// Steht in der Liste genau dieses Wort?
fn kw_hat(liste: u64, p: u64, n: u64) -> bool {
    if liste == 0 || n == 0 {
        return false
    }
    var i: u64 = 0
    while __mmio_read8((liste + i) as *mut u8) as u64 != 0 {
        // den Anfang eines Wortes suchen
        var j: u64 = 0
        while j < n && __mmio_read8((liste + i + j) as *mut u8) as u64 == __mmio_read8((p + j) as *mut u8) as u64 {
            j = j + 1
        }
        if j == n {
            let nach: u64 = __mmio_read8((liste + i + n) as *mut u8) as u64
            if nach == 32 || nach == 0 {
                return true
            }
        }
        // zum naechsten Wort
        while __mmio_read8((liste + i) as *mut u8) as u64 != 0
            && __mmio_read8((liste + i) as *mut u8) as u64 != 32 {
            i = i + 1
        }
        while __mmio_read8((liste + i) as *mut u8) as u64 == 32 {
            i = i + 1
        }
    }
    return false
}

// Welche Art hat das Zeichen an Stelle `x`? Die Antwort gilt fuer den
// Lauf, der dort anfaengt; `bis` sagt, wie weit er reicht.
fn hl_run(t: u64, y: u64, x: u64) -> u64 {
    let lang: u64 = tag(t, TS_LANG)
    let p: u64 = lg(t, y, LN_P)
    let n: u64 = lg(t, y, LN_N)
    if lang == LANG_NONE || lang >= LANG_COUNT || x >= n {
        return ((n - x) << 8) | HL_TEXT
    }
    let c: u64 = __mmio_read8((p + x) as *mut u8) as u64
    // Ein Zeilenkommentar: `//` in Firn, `#` in der Shell.
    if lang == LANG_FIRN && c == 47 && x + 1 < n
        && __mmio_read8((p + x + 1) as *mut u8) as u64 == 47 {
        return ((n - x) << 8) | HL_COM
    }
    if lang == LANG_SH && c == 35 {
        return ((n - x) << 8) | HL_COM
    }
    // Eine Zeichenkette. Sie endet am naechsten gleichen
    // Anfuehrungszeichen oder am Zeilenende.
    if c == 34 || c == 39 {
        var q: u64 = x + 1
        while q < n {
            let d: u64 = __mmio_read8((p + q) as *mut u8) as u64
            if d == 92 {
                q = q + 1
            } else if d == c {
                return ((q + 1 - x) << 8) | HL_STR
            }
            q = q + 1
        }
        return ((n - x) << 8) | HL_STR
    }
    // Eine Zahl.
    if c >= 48 && c <= 57 {
        var q2: u64 = x
        while q2 < n {
            let d2: u64 = __mmio_read8((p + q2) as *mut u8) as u64
            if (d2 >= 48 && d2 <= 57) || (d2 | 32) == 120
                || ((d2 | 32) >= 97 && (d2 | 32) <= 102) {
                q2 = q2 + 1
            } else {
                q2 = n + 1
            }
        }
        if q2 > n {
            q2 = q2 - n - 1 + 0
            var q3: u64 = x
            while q3 < n {
                let d3: u64 = __mmio_read8((p + q3) as *mut u8) as u64
                if (d3 >= 48 && d3 <= 57) || (d3 | 32) == 120
                    || ((d3 | 32) >= 97 && (d3 | 32) <= 102) {
                    q3 = q3 + 1
                } else {
                    return ((q3 - x) << 8) | HL_NUM
                }
            }
            return ((q3 - x) << 8) | HL_NUM
        }
        return ((q2 - x) << 8) | HL_NUM
    }
    // Ein Wort -- vielleicht ein Schluesselwort.
    if ta_isword(c) {
        var q4: u64 = x
        while q4 < n && ta_isword(__mmio_read8((p + q4) as *mut u8) as u64) {
            q4 = q4 + 1
        }
        if kw_hat(kw_list(lang), p + x, q4 - x) {
            return ((q4 - x) << 8) | HL_KEY
        }
        return ((q4 - x) << 8) | HL_TEXT
    }
    return (1 << 8) | HL_TEXT
}

// ============================================================ DER ZEICHNER
//
// ER MALT NUR, WAS ZU SEHEN IST. Das ist die ganze Zusage dieser
// Runde an die Geschwindigkeit: die Schleife laeuft von `TS_TOP` bis
// `TS_TOP + rows`, und `rows` ist die Hoehe des Rechtecks geteilt
// durch die Zeilenhoehe. Eine Datei mit 5 000 Zeilen kostet genauso
// viel wie eine mit 50.

fn cp_len(p: u64, n: u64, at: u64) -> u64 {
    let l: u64 = utf8.seq_len(p, n, at)
    if l == 0 {
        return 1
    }
    return l
}

fn druckbar(c: u64) -> bool {
    return c >= 32 && c != 127 && c < 256
}

fn ta_longest(t: u64) -> u64 {
    let top: u64 = tag(t, TS_TOP)
    let rows: u64 = ta_rows(t)
    let nl: u64 = tag(t, TS_NL)
    var m: u64 = 0
    var r: u64 = 0
    while r < rows && top + r < nl {
        let c: u64 = ta_cols(t, top + r, lg(t, top + r, LN_N))
        if c > m {
            m = c
        }
        r = r + 1
    }
    return m
}

// Eine Zahl als Ziffern. Gibt zurueck, wie viele es wurden.
fn ta_num(v: u64, p: u64) -> u64 {
    var n: u64 = 0
    var q: u64 = v
    var stellen: [u8; 12] = [0 as u8; 12]
    if q == 0 {
        __mmio_write8(p as *mut u8, 48 as u8)
        return 1
    }
    while q > 0 && n < 12 {
        stellen[(n) as usize] = (48 + q % 10) as u8
        q = q / 10
        n = n + 1
    }
    var k: u64 = 0
    while k < n {
        __mmio_write8((p + k) as *mut u8, stellen[(n - 1 - k) as usize])
        k = k + 1
    }
    return n
}



// ==================================================== WAS EIN PROGRAMM SIEHT
//
// Die Schnittstelle nach aussen. Sie ist bewusst klein: ein Editor
// braucht "leg ein Feld an", "gib mir den Text", "nimm diesen Text",
// "wo steht die Marke" und "ist etwas veraendert" -- alles andere
// macht das Widget selbst.



// Den ganzen Text setzen (eine Datei oeffnen).
fn ta_text_set(i: u64, p: u64, n: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    ta_set_text(t, p, n)
    tas(t, TS_DIRTY, 0)
    tas(t, TS_UN, 0)
    tas(t, TS_UAT, 0)
}

// Den ganzen Text holen (sichern). Gibt die Laenge zurueck.
fn ta_text_get(i: u64, p: u64, max: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return 0
    }
    return ta_copy_out(t, p, max)
}

fn ta_text_len(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return 0
    }
    return ta_bytes(t)
}

fn ta_leeren(i: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    ta_clear(t)
    tas(t, TS_DIRTY, 0)
    tas(t, TS_UN, 0)
    tas(t, TS_UAT, 0)
}

fn ta_zeilen(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return 0
    }
    return tag(t, TS_NL)
}

// Zeile und Spalte der Marke -- fuer die Statuszeile. Beide ab 1
// gezaehlt, so wie ein Mensch zaehlt.
fn ta_zeile(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return 1
    }
    return tag(t, TS_CY) + 1
}

fn ta_spalte(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return 1
    }
    return ta_cols(t, tag(t, TS_CY), tag(t, TS_CX)) + 1
}

fn ta_geaendert(i: u64) -> bool {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return false
    }
    return tag(t, TS_DIRTY) != 0
}

fn ta_sauber(i: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    tas(t, TS_DIRTY, 0)
}

// CRLF oder LF -- was beim Sichern geschrieben wird, und was beim
// Oeffnen gefunden wurde.
fn ta_eol(i: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return 0
    }
    return tag(t, TS_EOL)
}

fn ta_eol_set(i: u64, v: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    tas(t, TS_EOL, v)
}

// Welche Sprache eingefaerbt wird.
fn ta_lang(i: u64, lang: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    tas(t, TS_LANG, lang)
}

fn ta_nurlesen(i: u64, an: bool) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    var v: u64 = 0
    if an {
        v = 1
    }
    tas(t, TS_RO, v)
}

// ZU EINER ZEILE SPRINGEN -- fuer "Gehe zu" und fuer den Treffer einer
// Suche. `spalte` ist ein OKTETTVERSATZ in der Zeile.
fn ta_gehe(i: u64, zeile: u64, spalte: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    var y: u64 = zeile
    if y >= tag(t, TS_NL) {
        y = tag(t, TS_NL) - 1
    }
    tas(t, TS_CY, y)
    tas(t, TS_CX, spalte)
    ta_clamp(t)
    ta_sel_clear(t)
    ta_follow(t)
}

// EINEN BEREICH AUSWAEHLEN -- so zeigt die Suche ihren Treffer.
fn ta_waehle(i: u64, ay: u64, ax: u64, by: u64, bx: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    tas(t, TS_AY, ay)
    tas(t, TS_AX, ax)
    tas(t, TS_CY, by)
    tas(t, TS_CX, bx)
    ta_clamp(t)
    ta_follow(t)
}

// Eine Zeile lesen -- die Suche geht damit durch die Datei, ohne dass
// sie den ganzen Text in einen Puffer holen muss.
fn ta_zeile_p(i: u64, y: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX || y >= tag(t, TS_NL) {
        return 0
    }
    return lg(t, y, LN_P)
}

fn ta_zeile_n(i: u64, y: u64) -> u64 {
    let t: u64 = ta_of(i)
    if t >= TA_MAX || y >= tag(t, TS_NL) {
        return 0
    }
    return lg(t, y, LN_N)
}

// Text an der Marke einsetzen -- das Ersetzen der Suche.
fn ta_einfuegen(i: u64, p: u64, n: u64) {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return
    }
    ta_push_undo(t)
    ta_insert(t, p, n)
}

fn ta_hat_auswahl(i: u64) -> bool {
    let t: u64 = ta_of(i)
    if t >= TA_MAX {
        return false
    }
    return ta_has_sel(t)
}


// ------------------------------------------------------------- new here

fn ed_new() -> u64 {
    if ta_n >= TA_MAX {
        return TA_MAX
    }
    let t: u64 = ta_n
    ta_n = ta_n + 1
    tas(t, TS_TAB, 4)
    tas(t, TS_LANG, LANG_NONE)
    tas(t, TS_WANT, 0xFFFFFFFFFFFFFFFF)
    ta_clear(t)
    return t
}

fn ta_of(i: u64) -> u64 {
    if i >= ta_n {
        return TA_MAX
    }
    return i
}

// The node is `w` x `h` pixels: how many rows and columns fit.
fn ed_size(t: u64, w: u64, h: u64) {
    if t >= TA_MAX {
        return
    }
    let lh: u64 = ta_lh()
    var rows: u64 = 1
    if h > 4 && lh > 0 {
        rows = (h - 4) / lh
        if rows == 0 {
            rows = 1
        }
    }
    let gut: u64 = ta_gutter(t)
    var cols: u64 = 1
    if w > gut + ED_SB + 4 && ta_cw() > 0 {
        cols = (w - gut - ED_SB - 4) / ta_cw()
        if cols == 0 {
            cols = 1
        }
    }
    tas(t, TS_ROWS, rows)
    tas(t, TS_FITC, cols)
}

fn ed_key(t: u64, k: u64) {
    ta_key(t, k)
}

// A key with a modifier (2 = Shift) fed by the program itself.
fn ed_key_mod(t: u64, k: u64, m: u64) {
    wlib.set_keymod(m)
    ta_key(t, k)
    wlib.set_keymod(0)
}

// A mixture of two painter colours (channel by channel).
fn mixc(a: u32, b: u32, teil: u64) -> u32 {
    let rest: u64 = 8 - teil
    let av: u64 = a as u64
    let bv: u64 = b as u64
    let r: u64 = (((av >> 16) & 0xFF) * rest + ((bv >> 16) & 0xFF) * teil) / 8
    let g2: u64 = (((av >> 8) & 0xFF) * rest + ((bv >> 8) & 0xFF) * teil) / 8
    let bl: u64 = ((av & 0xFF) * rest + (bv & 0xFF) * teil) / 8
    return ((r << 16) | (g2 << 8) | bl) as u32
}

fn hl_col(art: u64, th: *mut theme.Colors) -> u32 {
    if art == HL_KEY {
        return (*th).accent
    }
    if art == HL_STR {
        return mixc((*th).text, 3174592 as u32, 6) // orange-brown (painter order)
    }
    if art == HL_COM {
        return (*th).text_muted
    }
    if art == HL_NUM {
        return mixc((*th).text, 9461792 as u32, 6) // blue
    }
    return (*th).text
}

fn solid(z: *mut painter.Painter, x: u64, y: u64, w: u64, h: u64, col: u32) {
    if w == 0 || h == 0 {
        return
    }
    painter.round_rect(z, x as f64, y as f64, w as f64, h as f64, 0.0,
        col | 4278190080 as u32)
}

// Draw `n` bytes of text at (x, base) in the mono font.
fn mono_text(z: *mut painter.Painter, x: u64, base: u64, w: u64, p: u64,
    n: u64, col: u32) {
    if n == 0 || w == 0 {
        return
    }
    let _r: f64 = painter.text(z, x as f64, base as f64, w as f64,
        wlibc.px_mono() as f64, col | 4278190080 as u32, p, n as usize,
        painter.TEXT_L)
}

fn ed_paint(t: u64, x: u64, y: u64, bw: u64, bh: u64, focus: bool,
    caret_on: bool) {
    if t >= TA_MAX {
        return
    }
    let z: *mut painter.Painter = render.ctx_painter(fuiapp.ctx())
    let th: *mut theme.Colors = theme.theme_colors(fuiapp.theme())
    let lh: u64 = ta_lh()
    let cw: u64 = ta_cw()
    let gut: u64 = ta_gutter(t)
    let rows: u64 = ta_rows(t)
    let top: u64 = tag(t, TS_TOP)
    let left: u64 = tag(t, TS_LEFT)
    let nl: u64 = tag(t, TS_NL)
    let fit: u64 = ta_cols_fit(t)
    painter.round_rect(z, x as f64, y as f64, bw as f64, bh as f64, 8.0,
        (*th).field | 4278190080 as u32)
    if gut != 0 {
        solid(z, x + 1, y + 1, gut, bh - 2, (*th).surface)
        solid(z, x + gut, y + 1, 1, bh - 2, (*th).separator)
    }
    let sel: bool = ta_has_sel(t)
    let sa: u64 = ta_sel_first(t)
    let sb: u64 = ta_sel_last(t)
    let say: u64 = sa >> 32
    let sax: u64 = sa & 0xFFFFFFFF
    let sby: u64 = sb >> 32
    let sbx: u64 = sb & 0xFFFFFFFF
    let mono: u64 = fuiglyph.fontset(fuiglyph.ROLE_MONO)
    let oldf: u64 = painter.painter_font(z)
    if mono != 0 {
        painter.painter_set_font(z, mono)
    }
    let tx0: u64 = x + gut + 2
    let tw: u64 = fit * cw
    var r: u64 = 0
    while r < rows {
        let ln: u64 = top + r
        if ln >= nl {
            r = rows
        } else {
            let ty: u64 = y + 2 + r * lh
            let grund: u64 = ty + wlibc.ascent_of(wlibc.F_MONO, wlibc.px_mono())
            if gut != 0 {
                var num: [u8; 12] = [0 as u8; 12]
                let nn: u64 = ta_num(ln + 1, (&num[0 as usize]) as u64)
                var farbe: u32 = (*th).text_muted
                if ln == tag(t, TS_CY) {
                    farbe = (*th).text
                }
                mono_text(z, x + gut - 6 - nn * cw, grund, nn * cw + 2,
                    (&num[0 as usize]) as u64, nn, farbe)
            }
            if ln == tag(t, TS_CY) && !sel {
                solid(z, x + gut + 1, ty, tw + 2, lh,
                    mixc((*th).field, (*th).selection, 1))
            }
            let p: u64 = lg(t, ln, LN_P)
            let n: u64 = lg(t, ln, LN_N)
            if sel && ln >= say && ln <= sby {
                var von: u64 = 0
                var bis: u64 = n
                if ln == say {
                    von = sax
                }
                if ln == sby {
                    bis = sbx
                }
                var c0: u64 = ta_cols(t, ln, von)
                var c1: u64 = ta_cols(t, ln, bis)
                if ln < sby {
                    c1 = c1 + 1
                }
                if c0 < left {
                    c0 = left
                }
                if c1 > left + fit {
                    c1 = left + fit
                }
                if c1 > c0 {
                    solid(z, tx0 + (c0 - left) * cw, ty, (c1 - c0) * cw, lh,
                        (*th).selection)
                }
            }
            var q: u64 = ta_at_col(t, ln, left)
            var col: u64 = left
            let maxc: u64 = left + fit
            while q < n && col < maxc {
                let run: u64 = hl_run(t, ln, q)
                var laenge: u64 = run >> 8
                let art: u64 = run & 0xFF
                if laenge == 0 {
                    laenge = 1
                }
                if q + laenge > n {
                    laenge = n - q
                }
                // cut the run where the columns end
                let c_start: u64 = col
                var cut: u64 = laenge
                while cut > 0 && c_start + ta_cols(t, ln, q + cut) - ta_cols(t, ln, q) > maxc {
                    cut = cut - 1
                    while cut > 0 && (__mmio_read8((p + q + cut) as *mut u8) & 192 as u8) == 128 as u8 {
                        cut = cut - 1
                    }
                }
                var fg: u32 = hl_col(art, th)
                if sel && ln >= say && ln <= sby {
                    var iv: bool = true
                    if ln == say && q < sax {
                        iv = false
                    }
                    if ln == sby && q >= sbx {
                        iv = false
                    }
                    if iv {
                        fg = (*th).selection_text
                    }
                }
                mono_text(z, tx0 + (col - left) * cw, grund, tw + cw, p + q,
                    cut, fg)
                col = col + ta_cols(t, ln, q + laenge) - ta_cols(t, ln, q)
                q = q + laenge
            }
            r = r + 1
        }
    }
    if mono != 0 {
        painter.painter_set_font(z, oldf)
    }
    if focus && caret_on && tag(t, TS_CY) >= top && tag(t, TS_CY) < top + rows {
        let ccol: u64 = ta_cols(t, tag(t, TS_CY), tag(t, TS_CX))
        if ccol >= left && ccol <= left + fit {
            solid(z, tx0 + (ccol - left) * cw, y + 2 + (tag(t, TS_CY) - top) * lh,
                2, lh, (*th).accent)
        }
    }
    // the scroll bars
    let sw: u64 = ED_SB
    if nl > rows {
        let th2: u64 = bh - 2 - sw
        var bar: u64 = th2 * rows / nl
        if bar < 16 {
            bar = 16
        }
        if bar > th2 {
            bar = th2
        }
        var bo: u64 = 0
        if nl > rows {
            bo = (th2 - bar) * top / (nl - rows)
        }
        solid(z, x + bw - sw - 1, y + 1, sw, th2, (*th).base)
        painter.round_rect(z, (x + bw - sw + 1) as f64, (y + 1 + bo) as f64,
            (sw - 4) as f64, bar as f64, 3.0,
            (*th).text_muted | 4278190080 as u32)
    }
    let breit: u64 = ta_longest(t)
    if breit > fit {
        let hw: u64 = bw - gut - 2 - sw
        var hb: u64 = hw * fit / breit
        if hb < 16 {
            hb = 16
        }
        if hb > hw {
            hb = hw
        }
        var ho: u64 = 0
        if breit > fit {
            ho = (hw - hb) * left / (breit - fit)
        }
        solid(z, x + gut + 1, y + bh - sw - 1, hw, sw, (*th).base)
        painter.round_rect(z, (x + gut + 1 + ho) as f64, (y + bh - sw + 1) as f64,
            hb as f64, (sw - 4) as f64, 3.0, (*th).text_muted | 4278190080 as u32)
    }
    painter.round_ring(z, x as f64, y as f64, bw as f64, bh as f64, 8.0, 1.0,
        (*th).border_col | 4278190080 as u32)
}

// The caret goes where the pointer is (node at nx, ny; pointer mx, my).
fn ed_hit(t: u64, nx: u64, ny: u64, mx: u64, my: u64) {
    if t >= TA_MAX {
        return
    }
    let lh: u64 = ta_lh()
    let cw: u64 = ta_cw()
    let gut: u64 = ta_gutter(t)
    let x0: u64 = nx + gut + 2
    let y0: u64 = ny + 2
    var r: u64 = 0
    if my > y0 {
        r = (my - y0) / lh
    }
    var ln: u64 = tag(t, TS_TOP) + r
    if ln >= tag(t, TS_NL) {
        ln = tag(t, TS_NL) - 1
    }
    var col: u64 = tag(t, TS_LEFT)
    if mx > x0 {
        col = col + (mx - x0 + cw / 2) / cw
    }
    tas(t, TS_CY, ln)
    tas(t, TS_CX, ta_at_col(t, ln, col))
    tas(t, TS_WANT, 0xFFFFFFFFFFFFFFFF)
    ta_follow(t)
}

// A press: the caret, and a new anchor unless Shift extends the selection.
fn ed_press(t: u64, nx: u64, ny: u64, mx: u64, my: u64, shift: bool) {
    if t >= TA_MAX {
        return
    }
    if shift {
        ed_hit(t, nx, ny, mx, my)
        return
    }
    ed_hit(t, nx, ny, mx, my)
    ta_sel_clear(t)
}

// Dragging with the button down extends the selection from the anchor.
fn ed_drag(t: u64, nx: u64, ny: u64, mx: u64, my: u64) {
    if t >= TA_MAX {
        return
    }
    let ay: u64 = tag(t, TS_AY)
    let ax: u64 = tag(t, TS_AX)
    ed_hit(t, nx, ny, mx, my)
    tas(t, TS_AY, ay)
    tas(t, TS_AX, ax)
}

// The wheel / a click on the scroll bar track: scroll to a fraction.
fn ed_wheel(t: u64, lines: i64) {
    if t >= TA_MAX {
        return
    }
    let nl: u64 = tag(t, TS_NL)
    let rows: u64 = ta_rows(t)
    var top: u64 = tag(t, TS_TOP)
    if lines < 0 {
        let d: u64 = (0 - lines) as u64
        if top > d {
            top = top - d
        } else {
            top = 0
        }
    } else {
        top = top + (lines as u64)
        if nl > rows && top > nl - rows {
            top = nl - rows
        } else if nl <= rows {
            top = 0
        }
    }
    tas(t, TS_TOP, top)
}

// Is (mx, my) on the vertical scroll bar of the node at (nx, ny, bw, bh)?
// Then the view scrolls to that height and true is returned.
fn ed_scroll_hit(t: u64, nx: u64, ny: u64, bw: u64, bh: u64, mx: u64, my: u64) -> bool {
    if t >= TA_MAX {
        return false
    }
    let nl: u64 = tag(t, TS_NL)
    let rows: u64 = ta_rows(t)
    if nl <= rows || mx + ED_SB + 1 < nx + bw || mx >= nx + bw {
        return false
    }
    let th2: u64 = bh - 2 - ED_SB
    var rel: u64 = 0
    if my > ny + 1 {
        rel = my - ny - 1
    }
    if rel > th2 {
        rel = th2
    }
    var top: u64 = rel * (nl - rows) / th2
    if top > nl - rows {
        top = nl - rows
    }
    tas(t, TS_TOP, top)
    return true
}

