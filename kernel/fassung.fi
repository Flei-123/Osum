//
// kernel/fassung.fi -- WELCHE FASSUNG LAEUFT HIER EIGENTLICH.
//
// WARUM ES DIESE DATEI GIBT, und der Grund ist eine verlorene Runde.
// Am 03.09.2026 hat Justin ein Abbild gebrannt, getestet und gemeldet
// "kein Unterschied". Danach standen zwei Stunden Arbeit im Raum, ohne
// dass irgendjemand -- er nicht und der Kern auch nicht -- sagen
// konnte, WELCHE Fassung auf dem Stick lag. Der Nachweis musste
// hinterher aus Zeitstempeln, Pruefsummen und einem QEMU-Lauf
// zusammengesucht werden.
//
// Seither steht der kurze Commit-Hash im Kern, und zwar an zwei
// Stellen, an denen ein Mensch ihn OHNE serielle Leitung sieht:
//
//   1. als erste Zeile des Startprotokolls (`osum <hash>`)
//   2. in der gruenen Messleiste oben auf dem Schreibtisch
//
// Ein Foto des Bildschirms sagt damit immer, welche Fassung laeuft.
//
// DIE ZEICHENKETTE WIRD BEIM BAUEN ERSETZT. `tools/build-kernel.sh`
// kopiert den Kernbaum nach /tmp und setzt dort den echten Hash ein
// (`sed` auf die Fragezeichen). Wer diese Datei direkt uebersetzt,
// bekommt `unbekannt` -- und das ist ehrlicher als eine Zahl, die
// nichts bedeutet.

profile kernel

import kstate

export { text, len }

// GENAU ACHT FRAGEZEICHEN, und sie sind ein Vertrag mit
// `tools/build-kernel.sh`. Wer hier die Laenge aendert, muss dort das
// `sed` mit aendern -- der Bau prueft danach nach, dass die Zeichen
// wirklich ersetzt wurden, und bricht sonst ab.
static mut s_fassung: [u8; 16] = "osum ????????\0\0\0"

fn text() -> u64 {
    return (&s_fassung[0]) as u64
}

fn len() -> u64 {
    var n: u64 = 0
    while n < 16 && kstate.get8(text() + n) != 0 {
        n = n + 1
    }
    return n
}
