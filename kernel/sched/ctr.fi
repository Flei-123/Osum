
profile kernel

import lib.kstate
import sched.sched
import serial

export {
    MAX_CTR, HOST, NAME_MAX, ROOT_MAX,
    C_FREE, C_SET, C_RUN, C_DEAD,
    ctr_of, set_ctr, inherit,
    alloc, free_slot, state_of, set_state, exists, alive,
    name_at, name_set, root_at, root_set, root_len,
    mem_limit, mem_limit_set, mem_used, mem_charge, mem_uncharge,
    mem_peak, mem_denials,
    cpu_share, cpu_share_set, cpu_ticks, cpu_tick_add,
    procs_of, procs_limit, procs_limit_set,
    may_reroot, may_limit,
    netview_of, netview_set,
    visible, may_signal,
    jail, jail_needed, fold, find_root, prefix_len,
    count, first_free, report,
    created, destroyed, escapes, note_escape
}

// ------------------------------------------------------------ die Zahlen
const MAX_CTR: u64 = 8

const HOST: u64 = 0

const NAME_MAX: u64 = 32
const ROOT_MAX: u64 = 96

// Die Zustaende eines Platzes.
const C_FREE: u64 = 0 // Platz frei
const C_SET: u64 = 1
const C_RUN: u64 = 2
const C_DEAD: u64 = 3

const CTR_BYTES: u64 = 256

const X_STATE: u64 = 0
const X_MEMLIM: u64 = 8
const X_MEMUSE: u64 = 16
const X_MEMPEAK: u64 = 24
const X_MEMDENY: u64 = 32
const X_CPUSH: u64 = 40 // Anteil 1..100, 0 = keine Bevorzugung
const X_CPUTICK: u64 = 48
const X_PROCLIM: u64 = 56
const X_NETV: u64 = 64
const X_ROOTLEN: u64 = 72
const X_NAME: u64 = 80 // NAME_MAX Oktette
const X_ROOT: u64 = 128 // ROOT_MAX Oktette -- bis 224, Rest frei

const G_OFF: u64 = MAX_CTR * CTR_BYTES
const G_CREATED: u64 = G_OFF + 0
const G_DESTROYED: u64 = G_OFF + 8
const G_ESCAPES: u64 = G_OFF + 16 // abgewehrte Ausbruchsversuche

fn rec(i: u64) -> u64 {
    return kstate.CTR_OFF + i * CTR_BYTES
}

// -------------------------------------------------- die Zugehoerigkeit

fn ctr_of(state: u64, t: u64) -> u64 {
    if t >= kstate.MAX_TASKS {
        return HOST
    }
    let c: u64 = sched.tget(state, t, sched.T_CTR)
    if c >= MAX_CTR {
        return HOST
    }
    return c
}

fn set_ctr(state: u64, t: u64, c: u64) {
    if t >= kstate.MAX_TASKS || c >= MAX_CTR {
        return
    }
    sched.tset(state, t, sched.T_CTR, c)
}

fn inherit(state: u64, parent: u64, child: u64) {
    if parent >= kstate.MAX_TASKS || child >= kstate.MAX_TASKS {
        return
    }
    sched.tset(state, child, sched.T_CTR,
        sched.tget(state, parent, sched.T_CTR))
}

// ------------------------------------------------------- die Plaetze

fn state_of(state: u64, i: u64) -> u64 {
    if i == 0 || i >= MAX_CTR {
        return C_FREE
    }
    return kstate.get(state, rec(i) + X_STATE)
}

fn set_state(state: u64, i: u64, s: u64) {
    if i == 0 || i >= MAX_CTR {
        return
    }
    kstate.set(state, rec(i) + X_STATE, s)
}

fn exists(state: u64, i: u64) -> bool {
    return state_of(state, i) != C_FREE
}

fn alive(state: u64, i: u64) -> bool {
    let s: u64 = state_of(state, i)
    return s == C_SET || s == C_RUN
}

fn first_free(state: u64) -> u64 {
    var i: u64 = 1
    while i < MAX_CTR {
        if state_of(state, i) == C_FREE {
            return i
        }
        i = i + 1
    }
    return 0
}

fn count(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 1
    while i < MAX_CTR {
        if state_of(state, i) != C_FREE {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn alloc(state: u64) -> u64 {
    let i: u64 = first_free(state)
    if i == 0 {
        return 0
    }
    let a: u64 = rec(i)
    var k: u64 = 0
    while k < CTR_BYTES {
        kstate.set8(state + a + k, 0 as u8)
        k = k + 1
    }
    kstate.set(state, a + X_STATE, C_SET)
    kstate.add(state, G_CREATED, 1)
    return i
}

fn free_slot(state: u64, i: u64) {
    if i == 0 || i >= MAX_CTR {
        return
    }
    let a: u64 = rec(i)
    var k: u64 = 0
    while k < CTR_BYTES {
        kstate.set8(state + a + k, 0 as u8)
        k = k + 1
    }
    kstate.add(state, G_DESTROYED, 1)
}

// ------------------------------------------------------------ der Name

fn name_at(state: u64, i: u64, k: u64) -> u64 {
    if i == 0 || i >= MAX_CTR || k >= NAME_MAX {
        return 0
    }
    return kstate.get8(state + rec(i) + X_NAME + k)
}

fn name_set(state: u64, i: u64, src: u64) {
    if i == 0 || i >= MAX_CTR {
        return
    }
    let a: u64 = state + rec(i) + X_NAME
    var k: u64 = 0
    while k < NAME_MAX - 1 && kstate.get8(src + k) != 0 {
        kstate.set8(a + k, kstate.get8(src + k) as u8)
        k = k + 1
    }
    while k < NAME_MAX {
        kstate.set8(a + k, 0 as u8)
        k = k + 1
    }
}

// ----------------------------------------------------------- DIE WURZEL

fn root_len(state: u64, i: u64) -> u64 {
    if i == 0 || i >= MAX_CTR {
        return 0
    }
    return kstate.get(state, rec(i) + X_ROOTLEN)
}

fn root_at(state: u64, i: u64, k: u64) -> u64 {
    if i == 0 || i >= MAX_CTR || k >= ROOT_MAX {
        return 0
    }
    return kstate.get8(state + rec(i) + X_ROOT + k)
}

fn root_set(state: u64, i: u64, src: u64) -> bool {
    if i == 0 || i >= MAX_CTR {
        return false
    }
    if kstate.get8(src) != 47 {
        return false
    }
    let a: u64 = state + rec(i) + X_ROOT
    var n: u64 = 0
    while n < ROOT_MAX - 1 && kstate.get8(src + n) != 0 {
        kstate.set8(a + n, kstate.get8(src + n) as u8)
        n = n + 1
    }
    while n > 0 && kstate.get8(a + n - 1) == 47 {
        n = n - 1
    }
    var k: u64 = n
    while k < ROOT_MAX {
        kstate.set8(a + k, 0 as u8)
        k = k + 1
    }
    kstate.set(state, rec(i) + X_ROOTLEN, n)
    return n > 0
}

fn may_reroot(state: u64, i: u64, src: u64) -> bool {
    if i == 0 || i >= MAX_CTR {
        return false
    }
    let n: u64 = root_len(state, i)
    if n == 0 {
        return true
    }
    var k: u64 = 0
    while k < n {
        if kstate.get8(src + k) != root_at(state, i, k) {
            return false
        }
        k = k + 1
    }
    let c: u64 = kstate.get8(src + n)
    return c == 47
}

// ---------------------------------------------------- DIE SPEICHERGRENZE

fn mem_limit(state: u64, i: u64) -> u64 {
    if i == 0 || i >= MAX_CTR {
        return 0
    }
    return kstate.get(state, rec(i) + X_MEMLIM)
}

fn mem_used(state: u64, i: u64) -> u64 {
    if i == 0 || i >= MAX_CTR {
        return 0
    }
    return kstate.get(state, rec(i) + X_MEMUSE)
}

fn mem_peak(state: u64, i: u64) -> u64 {
    if i == 0 || i >= MAX_CTR {
        return 0
    }
    return kstate.get(state, rec(i) + X_MEMPEAK)
}

fn mem_denials(state: u64, i: u64) -> u64 {
    if i == 0 || i >= MAX_CTR {
        return 0
    }
    return kstate.get(state, rec(i) + X_MEMDENY)
}

fn mem_limit_set(state: u64, i: u64, frames: u64) {
    if i == 0 || i >= MAX_CTR {
        return
    }
    kstate.set(state, rec(i) + X_MEMLIM, frames)
}

fn may_limit(state: u64, i: u64, want: u64) -> bool {
    if i == 0 || i >= MAX_CTR {
        return false
    }
    let have: u64 = mem_limit(state, i)
    if have == 0 {
        return want != 0
    }
    if want == 0 {
        return false
    }
    return want <= have
}

fn mem_charge(state: u64, i: u64, frames: u64) -> bool {
    if i == 0 || i >= MAX_CTR {
        return true
    }
    let a: u64 = rec(i)
    let lim: u64 = kstate.get(state, a + X_MEMLIM)
    let use: u64 = kstate.get(state, a + X_MEMUSE)
    if lim != 0 {
        if use + frames > lim {
            kstate.add(state, a + X_MEMDENY, 1)
            return false
        }
    }
    let updated: u64 = use + frames
    kstate.set(state, a + X_MEMUSE, updated)
    if updated > kstate.get(state, a + X_MEMPEAK) {
        kstate.set(state, a + X_MEMPEAK, updated)
    }
    return true
}

fn mem_uncharge(state: u64, i: u64, frames: u64) {
    if i == 0 || i >= MAX_CTR {
        return
    }
    let a: u64 = rec(i)
    let use: u64 = kstate.get(state, a + X_MEMUSE)
    if frames >= use {
        kstate.set(state, a + X_MEMUSE, 0)
    } else {
        kstate.set(state, a + X_MEMUSE, use - frames)
    }
}

// ------------------------------------------------------- DER CPU-ANTEIL

fn cpu_share(state: u64, i: u64) -> u64 {
    if i == 0 || i >= MAX_CTR {
        return 0
    }
    return kstate.get(state, rec(i) + X_CPUSH)
}

fn cpu_share_set(state: u64, i: u64, sh: u64) -> bool {
    if i == 0 || i >= MAX_CTR {
        return false
    }
    if sh > 100 {
        return false
    }
    kstate.set(state, rec(i) + X_CPUSH, sh)
    return true
}

fn cpu_ticks(state: u64, i: u64) -> u64 {
    if i == 0 || i >= MAX_CTR {
        return 0
    }
    return kstate.get(state, rec(i) + X_CPUTICK)
}

fn cpu_tick_add(state: u64, i: u64, n: u64) {
    if i == 0 || i >= MAX_CTR {
        return
    }
    kstate.add(state, rec(i) + X_CPUTICK, n)
}

// ------------------------------------------------------ die Prozesszahl

fn procs_of(state: u64, i: u64) -> u64 {
    if i == 0 || i >= MAX_CTR {
        return 0
    }
    var n: u64 = 0
    var t: u64 = 0
    while t < kstate.MAX_TASKS {
        let st: u64 = sched.tget(state, t, sched.T_STATE)
        if st != sched.S_FREE && st != sched.S_ZOMBIE {
            if ctr_of(state, t) == i {
                n = n + 1
            }
        }
        t = t + 1
    }
    return n
}

fn procs_limit(state: u64, i: u64) -> u64 {
    if i == 0 || i >= MAX_CTR {
        return 0
    }
    return kstate.get(state, rec(i) + X_PROCLIM)
}

fn procs_limit_set(state: u64, i: u64, n: u64) {
    if i == 0 || i >= MAX_CTR {
        return
    }
    kstate.set(state, rec(i) + X_PROCLIM, n)
}

// ---------------------------------------------------------- das Netz
fn netview_of(state: u64, i: u64) -> u64 {
    if i == 0 || i >= MAX_CTR {
        return 0
    }
    return kstate.get(state, rec(i) + X_NETV)
}

fn netview_set(state: u64, i: u64, v: u64) {
    if i == 0 || i >= MAX_CTR {
        return
    }
    kstate.set(state, rec(i) + X_NETV, v)
}

// ------------------------------------------------- DIE EIGENE SICHT
fn visible(state: u64, watcher: u64, target: u64) -> bool {
    let a: u64 = ctr_of(state, watcher)
    if a == HOST {
        return true
    }
    return a == ctr_of(state, target)
}

fn may_signal(state: u64, sender: u64, target: u64) -> bool {
    return visible(state, sender, target)
}

fn fold(buf: u64, len: u64) -> u64 {
    var at: u64 = 0
    var i: u64 = 0
    var going: bool = true
    while going {
        while i < len && kstate.get8(buf + i) == 47 {
            i = i + 1
        }
        if i >= len {
            going = false
        } else {
            var n: u64 = 0
            let start: u64 = i
            while i < len && kstate.get8(buf + i) != 47 {
                n = n + 1
                i = i + 1
            }
            var punkt: u64 = 0
            if n == 1 && kstate.get8(buf + start) == 46 {
                punkt = 1
            }
            if n == 2 && kstate.get8(buf + start) == 46
            && kstate.get8(buf + start + 1) == 46 {
                punkt = 2
            }
            if punkt == 1 {
                going = true // "." aendert nichts
            } else if punkt == 2 {
                while at > 0 && kstate.get8(buf + at - 1) != 47 {
                    at = at - 1
                }
                if at > 0 {
                    at = at - 1
                }
            } else {
                kstate.set8(buf + at, 47 as u8)
                at = at + 1
                var k: u64 = 0
                while k < n {
                    kstate.set8(buf + at, kstate.get8(buf + start + k) as u8)
                    at = at + 1
                    k = k + 1
                }
            }
        }
    }
    if at == 0 {
        kstate.set8(buf + at, 47 as u8)
        at = at + 1
    }
    kstate.set8(buf + at, 0 as u8)
    return at
}

fn jail_needed(state: u64, t: u64) -> bool {
    let c: u64 = ctr_of(state, t)
    if c == HOST {
        return false
    }
    return root_len(state, c) != 0
}

fn jail(state: u64, t: u64, buf: u64, len: u64, max: u64) -> u64 {
    let c: u64 = ctr_of(state, t)
    if c == HOST {
        return len
    }
    let rl: u64 = root_len(state, c)
    if rl == 0 {
        return len
    }
    let n: u64 = fold(buf, len)
    if rl + n + 1 > max {
        return 0
    }
    var k: u64 = n + 1
    while k > 0 {
        kstate.set8(buf + rl + k - 1, kstate.get8(buf + k - 1) as u8)
        k = k - 1
    }
    var j: u64 = 0
    while j < rl {
        kstate.set8(buf + j, root_at(state, c, j) as u8)
        j = j + 1
    }
    return rl + n
}

// chroot(2) support (W-MG3). A container slot with exactly this root (src = absolute, folded, NUL-terminated), or 0.
fn find_root(state: u64, src: u64) -> u64 {
    var n: u64 = 0
    while kstate.get8(src + n) != 0 {
        n = n + 1
    }
    var i: u64 = 1
    while i < MAX_CTR {
        if alive(state, i) && root_len(state, i) == n {
            var k: u64 = 0
            while k < n && kstate.get8(src + k) == root_at(state, i, k) {
                k = k + 1
            }
            if k == n {
                return i
            }
        }
        i = i + 1
    }
    return 0
}

// How many leading octets of `buf` are the jail root of task `t` (0 when `t` is not jailed or `buf` does not start with the root
// followed by '/' or the end). A path that went through `jail` always matches; a kernel-internal path does not.
fn prefix_len(state: u64, t: u64, buf: u64) -> u64 {
    let c: u64 = ctr_of(state, t)
    if c == HOST {
        return 0
    }
    let rl: u64 = root_len(state, c)
    if rl == 0 {
        return 0
    }
    var k: u64 = 0
    while k < rl {
        if kstate.get8(buf + k) != root_at(state, c, k) {
            return 0
        }
        k = k + 1
    }
    let e: u64 = kstate.get8(buf + rl)
    if e != 47 && e != 0 {
        return 0
    }
    return rl
}

// ---------------------------------------------------------- die Zaehler

fn created(state: u64) -> u64 {
    return kstate.get(state, G_CREATED)
}

fn destroyed(state: u64) -> u64 {
    return kstate.get(state, G_DESTROYED)
}

fn escapes(state: u64) -> u64 {
    return kstate.get(state, G_ESCAPES)
}

fn note_escape(state: u64) {
    kstate.add(state, G_ESCAPES, 1)
}

// ------------------------------------------------------------ der Bericht
fn report(state: u64) {
    var s_n: [u8; 14] = "ctr: count=\0\0\0"
    var s_c: [u8; 16] = "ctr: created=\0\0\0"
    var s_d: [u8; 18] = "ctr: destroyed=\0\0\0"
    var s_e: [u8; 16] = "ctr: escapes=\0\0\0"
    serial.puts((&s_n[0]) as u64)
    serial.dec(count(state))
    serial.nl()
    serial.puts((&s_c[0]) as u64)
    serial.dec(created(state))
    serial.nl()
    serial.puts((&s_d[0]) as u64)
    serial.dec(destroyed(state))
    serial.nl()
    serial.puts((&s_e[0]) as u64)
    serial.dec(escapes(state))
    serial.nl()
    var s_l: [u8; 10] = "ctr[\0\0\0\0\0\0"
    var s_lim: [u8; 8] = "] lim=\0\0"
    var s_use: [u8; 7] = " use=\0\0"
    var s_pk: [u8; 8] = " peak=\0\0"
    var s_dn: [u8; 8] = " deny=\0\0"
    var s_cp: [u8; 8] = " cpu=\0\0\0"
    var s_tk: [u8; 9] = " ticks=\0\0"
    var s_pr: [u8; 9] = " procs=\0\0"
    var i: u64 = 1
    while i < MAX_CTR {
        if state_of(state, i) != C_FREE {
            serial.puts((&s_l[0]) as u64)
            serial.dec(i)
            serial.puts((&s_lim[0]) as u64)
            serial.dec(mem_limit(state, i))
            serial.puts((&s_use[0]) as u64)
            serial.dec(mem_used(state, i))
            serial.puts((&s_pk[0]) as u64)
            serial.dec(mem_peak(state, i))
            serial.puts((&s_dn[0]) as u64)
            serial.dec(mem_denials(state, i))
            serial.puts((&s_cp[0]) as u64)
            serial.dec(cpu_share(state, i))
            serial.puts((&s_tk[0]) as u64)
            serial.dec(cpu_ticks(state, i))
            serial.puts((&s_pr[0]) as u64)
            serial.dec(procs_of(state, i))
            serial.nl()
        }
        i = i + 1
    }
}
