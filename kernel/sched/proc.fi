

export {
    create, user_start, free_space, space_pages, reap, translate, user_ok,
    map_programs,
    badentry_num,
    inherit, create_bare, create_thread, discard, page_free, page_exec, map_page,
    map_page_zero, map_huge, nx, page_mapped, page_protect, tlb_flush_if_current, page_rights, page_zero, page_copy,
    map_frame,
    create_cap,
    copy_space, swap_space, use_space, page_drop, ARG_RESUME,
    USER_DATA, USER_STACK, USER_SPAN, USER_TOP,
    IMAGE_BASE, IMAGE_END, ARGS_BASE, MAX_ARGS, STACK_FLOOR, grow_stack, stack_zone_has,
    PRIV_SLOTS, MAIN_SLOTS, LAZY_BASE, LAZY_TOP, LAZY_ATOP, LAZYF_MAX, range_drop, lazy_mark, lazy_mark_image, lazy_mark_file, prefill_file_page, page_cached, lazy_fault, lazy_zone, lazy_find, page_taken, BIG_TOP, BIG_FLOOR, SHM_ARENA_BASE, SHM_ARENA_TOP, demand_fault, pd_slot, pt_for, page_free,
    frame_count, frame_at,
    frame_virt_at, space_build_empty, map_restored
}
import sched.proc.procbase
import sched.proc.proccopy
import sched.proc.procfault
import sched.proc.procmap
import sched.proc.procpt
import sched.proc.procspace
import sched.proc.procswap

const USER_STACK: u64 = 0x40001000

const BIG_TOP: u64 = 0x52C00000

const BIG_FLOOR: u64 = 0x44400000

const MAX_ARGS: u64 = 64

fn create(state: u64, prog: u64, arg: u64, prio: u64) -> u64 {
    return procspace.create(state, prog, arg, prio)
}

fn user_start(state: u64, i: u64, kind: u64) {
    proccopy.user_start(state, i, kind)
}

fn free_space(state: u64, i: u64) -> u64 {
    return procswap.free_space(state, i)
}

fn space_pages(state: u64, i: u64) -> u64 {
    return procpt.space_pages(state, i)
}

fn reap(state: u64, i: u64) -> bool {
    return procswap.reap(state, i)
}

fn translate(state: u64, i: u64, addr: u64) -> u64 {
    return procmap.translate(state, i, addr)
}

fn user_ok(state: u64, i: u64, addr: u64, len: u64) -> bool {
    return procfault.user_ok(state, i, addr, len)
}

fn map_programs(state: u64) -> u64 {
    return procpt.map_programs(state)
}

fn badentry_num() -> u64 {
    return proccopy.badentry_num()
}

fn inherit(state: u64, parent: u64, child: u64) -> bool {
    return procpt.inherit(state, parent, child)
}

fn create_bare(state: u64, prio: u64) -> u64 {
    return procspace.create_bare(state, prio)
}

fn create_thread(state: u64, erzeuger: u64, prio: u64) -> u64 {
    return procswap.create_thread(state, erzeuger, prio)
}

fn discard(state: u64, i: u64) {
    procswap.discard(state, i)
}

fn page_free(state: u64, i: u64, addr: u64) -> bool {
    return procmap.page_free(state, i, addr)
}

fn page_exec(state: u64, i: u64, addr: u64) -> bool {
    return procmap.page_exec(state, i, addr)
}

fn map_page(state: u64, i: u64, addr: u64, writable: bool, runnable: bool) -> u64 {
    return procmap.map_page(state, i, addr, writable, runnable)
}

fn map_page_zero(state: u64, i: u64, addr: u64, writable: bool, runnable: bool) -> u64 {
    return procmap.map_page_zero(state, i, addr, writable, runnable)
}

fn map_huge(state: u64, i: u64, addr: u64, phys: u64, writable: bool) -> bool {
    return procmap.map_huge(state, i, addr, phys, writable)
}

fn nx(state: u64) -> u64 {
    return procpt.nx(state)
}

fn page_mapped(state: u64, i: u64, addr: u64) -> bool {
    return procspace.page_mapped(state, i, addr)
}

fn page_protect(state: u64, i: u64, addr: u64, readable: bool, writable: bool, runnable: bool) -> u64 {
    return procspace.page_protect(state, i, addr, readable, writable, runnable)
}

fn tlb_flush_if_current(state: u64, i: u64) {
    procspace.tlb_flush_if_current(state, i)
}

fn page_rights(state: u64, i: u64, addr: u64) -> u64 {
    return procspace.page_rights(state, i, addr)
}

fn page_zero(state: u64, i: u64, addr: u64) -> bool {
    return procspace.page_zero(state, i, addr)
}

fn page_copy(state: u64, i: u64, from: u64, to: u64) -> bool {
    return proccopy.page_copy(state, i, from, to)
}

fn map_frame(state: u64, i: u64, addr: u64, frame: u64, writable: bool) -> bool {
    return procmap.map_frame(state, i, addr, frame, writable)
}

fn create_cap(state: u64, prog: u64, rights: u64, prio: u64) -> u64 {
    return procspace.create_cap(state, prog, rights, prio)
}

fn copy_space(state: u64, from: u64, to: u64) -> u64 {
    return proccopy.copy_space(state, from, to)
}

fn swap_space(state: u64, a: u64, b: u64) {
    proccopy.swap_space(state, a, b)
}

fn use_space(state: u64, i: u64) {
    proccopy.use_space(state, i)
}

fn page_drop(state: u64, i: u64, addr: u64) -> bool {
    return procspace.page_drop(state, i, addr)
}

const ARG_RESUME: u64 = proccopy.ARG_RESUME

const USER_DATA: u64 = procbase.USER_DATA

const USER_SPAN: u64 = procbase.USER_SPAN

const USER_TOP: u64 = procspace.USER_TOP

const IMAGE_BASE: u64 = procmap.IMAGE_BASE

const IMAGE_END: u64 = procmap.IMAGE_END

const ARGS_BASE: u64 = procspace.ARGS_BASE

const STACK_FLOOR: u64 = procbase.STACK_FLOOR

fn grow_stack(state: u64, i: u64, addr: u64, rsp: u64) -> bool {
    return procmap.grow_stack(state, i, addr, rsp)
}

fn stack_zone_has(state: u64, i: u64, addr: u64) -> bool {
    return procmap.stack_zone_has(state, i, addr)
}

const PRIV_SLOTS: u64 = procbase.PRIV_SLOTS

const MAIN_SLOTS: u64 = procbase.MAIN_SLOTS

const LAZY_BASE: u64 = procbase.LAZY_BASE

const LAZY_TOP: u64 = procbase.LAZY_TOP

const LAZY_ATOP: u64 = procmap.LAZY_ATOP

const LAZYF_MAX: u64 = procmap.LAZYF_MAX

fn range_drop(state: u64, i: u64, start: u64, end: u64) {
    procspace.range_drop(state, i, start, end)
}

fn lazy_mark(state: u64, i: u64, addr: u64, readable: bool, writable: bool, runnable: bool) -> bool {
    return procmap.lazy_mark(state, i, addr, readable, writable, runnable)
}

fn lazy_mark_image(state: u64, i: u64, addr: u64, writable: bool, runnable: bool) -> bool {
    return procmap.lazy_mark_image(state, i, addr, writable, runnable)
}

fn lazy_mark_file(state: u64, i: u64, addr: u64, readable: bool, writable: bool, runnable: bool, ino: u64, pg: u64) -> bool {
    return procmap.lazy_mark_file(state, i, addr, readable, writable, runnable, ino, pg)
}

fn prefill_file_page(state: u64, i: u64, addr: u64, writable: bool, runnable: bool, ino: u64, pg: u64) -> bool {
    return procfault.prefill_file_page(state, i, addr, writable, runnable, ino, pg)
}

fn page_cached(state: u64, i: u64, addr: u64) -> bool {
    return procmap.page_cached(state, i, addr)
}

fn lazy_fault(state: u64, cur: u64, addr: u64, err: u64) -> bool {
    return procfault.lazy_fault(state, cur, addr, err)
}

fn lazy_zone(addr: u64) -> bool {
    return procmap.lazy_zone(addr)
}

fn lazy_find(state: u64, i: u64, pages: u64) -> u64 {
    return procmap.lazy_find(state, i, pages)
}

fn page_taken(state: u64, i: u64, addr: u64) -> bool {
    return procmap.page_taken(state, i, addr)
}

const SHM_ARENA_BASE: u64 = procfault.SHM_ARENA_BASE

const SHM_ARENA_TOP: u64 = procfault.SHM_ARENA_TOP

fn demand_fault(state: u64, cur: u64, addr: u64, err: u64) -> bool {
    return procfault.demand_fault(state, cur, addr, err)
}

fn pd_slot(addr: u64) -> u64 {
    return procpt.pd_slot(addr)
}

fn pt_for(state: u64, i: u64, addr: u64, allocate: bool) -> u64 {
    return procpt.pt_for(state, i, addr, allocate)
}

fn frame_count(state: u64, i: u64) -> u64 {
    return procpt.frame_count(state, i)
}

fn frame_at(state: u64, i: u64, want: u64) -> u64 {
    return procpt.frame_at(state, i, want)
}

fn frame_virt_at(state: u64, i: u64, want: u64) -> u64 {
    return procpt.frame_virt_at(state, i, want)
}

fn space_build_empty(state: u64, i: u64) -> u64 {
    return procpt.space_build_empty(state, i)
}

fn map_restored(state: u64, i: u64, addr: u64, frame: u64) -> bool {
    return procmap.map_restored(state, i, addr, frame)
}
