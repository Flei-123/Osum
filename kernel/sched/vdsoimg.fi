fn part_5(frame: u64) {
    regio.write64(frame + 1104, 0x00000000000000E4)
}

fn write_image(frame: u64) {
    part_0(frame)
    part_1(frame)
    part_2(frame)
    part_3(frame)
    part_4(frame)
    part_5(frame)
}
