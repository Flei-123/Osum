import sched.ctr
import mm.fileshare
import mm.mmframe
import mm.mmswap
import sched.sched
import sched.taskconst
import sched.taskslot
import mm.mmlock
import sched.proc.prochooks
import sched.proc.procbase
import sched.proc.proclow
import sched.proc.procmap
import sched.proc.procpt
import sched.proc.procspace
import sched.proc.procswap

const SHM_ARENA_BASE: u64 = 0x53601000

const SHM_ARENA_TOP: u64 = 0x7B600000

fn prefill_file_page(state: u64, i: u64, addr: u64, writable: bool, runnable: bool, ino: u64, pg: u64) -> bool {
    if !procmap.lazy_mark_file(state, i, addr, true, writable, runnable, ino, pg) {
        return false
    }
    let s: u64 = procpt.pt_slot(addr)
    let pt: u64 = procpt.pt_for(state, i, addr, false)
    if pt == 0 {
        return false
    }
    if lazy_file_page(state, i, addr, pt, s, procpt.read_entry(pt, s)) == 1 {
        return true
    }
    procpt.write_entry(pt, s, 0)
    return false
}

fn lazy_file_install(state: u64, cur: u64, page: u64, pt: u64, s: u64, e0: u64, frame: u64, shared: bool) -> u64 {
    var result: u64 = 0
    mmlock.demand_lock(state)
    let e: u64 = procpt.read_entry(pt, s)
    if (e & procbase.PAGE_PRESENT) != 0 {
        result = 2
    } else if (e & procbase.PAGE_LAZYF) != 0 && (e & procbase.PAGE_USER) != 0 && ((e ^ e0) & 0x000FFFFFFFFFF000) == 0 {
        if (!shared || (e & procbase.PAGE_WRITE) == 0) && ctr.mem_charge(state, ctr.ctr_of(state, cur), 1) {
            var bits: u64 = procbase.PAGE_PRESENT | procbase.PAGE_USER | (e & procbase.PAGE_WRITE)
            if (e & procbase.PAGE_LAZYX) == 0 {
                bits = bits | procpt.nx(state)
            }
            if shared {
                bits = bits | procbase.PAGE_SHARED | procbase.PAGE_PCACHE
            }
            procpt.write_entry(pt, s, frame | bits)
            taskslot.tset(state, cur, taskconst.T_UPAGES, taskslot.tget(state, cur, taskconst.T_UPAGES) + 1)
            result = 1
        }
    }
    mmlock.demand_unlock(state)
    return result
}

const FAULT_AROUND_PAGES: u64 = 16

const PTE_FILE_REF_MASK: u64 = procbase.PAGE_PRESENT | procbase.PAGE_LAZYF | procbase.PAGE_USER | procbase.PAGE_WRITE

const PTE_FILE_REF_WANT: u64 = procbase.PAGE_LAZYF | procbase.PAGE_USER

const PTE_FILE_INO_SHIFT: u64 = 12

const PTE_FILE_PAGE_SHIFT: u64 = 32

const PTE_FILE_FIELD_MASK: u64 = 0xFFFFF

fn lazy_file_ino(e: u64) -> u64 {
    return (e >> PTE_FILE_INO_SHIFT) & PTE_FILE_FIELD_MASK
}

fn lazy_file_pg(e: u64) -> u64 {
    return (e >> PTE_FILE_PAGE_SHIFT) & PTE_FILE_FIELD_MASK
}

fn lazy_file_cache_page(state: u64, ino: u64, pg: u64, wide: bool) -> u64 {
    let seen: u64 = fileshare.epoch()
    let frame: u64 = mmframe.frame_alloc_user_low(state)
    if frame == 0 {
        return 0
    }
    var got: u64 = 0
    if wide {
        got = prochooks.read_at_wide(state, ino, pg * mmframe.FRAME_SIZE, frame, mmframe.FRAME_SIZE)
    } else {
        got = prochooks.read_at(state, ino, pg * mmframe.FRAME_SIZE, frame, mmframe.FRAME_SIZE)
    }
    procmap.zero_tail(frame, got)
    let kept: u64 = fileshare.insert(state, ino, pg, frame, seen)
    if kept != frame {
        mmframe.frame_free(state, frame)
    }
    return kept
}

fn lazy_file_private_frame(state: u64, ino: u64, pg: u64) -> u64 {
    var cached: u64 = fileshare.lookup(state, ino, pg)
    if cached == 0 && fileshare.has_room(state) {
        cached = lazy_file_cache_page(state, ino, pg, true)
    }
    if cached == 0 {
        return 0
    }
    let frame: u64 = mmframe.frame_alloc_user_low(state)
    if frame != 0 {
        procswap.copy_frame_words(mmframe.kva(frame), mmframe.kva(cached))
    }
    return frame
}

fn lazy_file_page(state: u64, cur: u64, page: u64, pt: u64, s: u64, e0: u64) -> u64 {
    let ino: u64 = lazy_file_ino(e0)
    let pg: u64 = lazy_file_pg(e0)
    let share: bool = (e0 & procbase.PAGE_WRITE) == 0
    var frame: u64 = 0
    var shared: bool = false
    var owned: bool = false
    if share {
        frame = fileshare.lookup(state, ino, pg)
        shared = frame != 0
    } else {
        frame = lazy_file_private_frame(state, ino, pg)
        owned = frame != 0
    }
    if frame == 0 {
        let seen: u64 = fileshare.epoch()
        frame = mmframe.frame_alloc_user_low(state)
        if frame == 0 {
            return 0
        }
        owned = true
        let got: u64 = prochooks.read_at(state, ino, pg * mmframe.FRAME_SIZE, frame, mmframe.FRAME_SIZE)
        procmap.zero_tail(frame, got)
        if share {
            let kept: u64 = fileshare.insert(state, ino, pg, frame, seen)
            if kept != 0 {
                if kept != frame {
                    mmframe.frame_free(state, frame)
                    frame = kept
                }
                shared = true
                owned = false
            }
        }
    }
    let r: u64 = lazy_file_install(state, cur, page, pt, s, e0, frame, shared)
    if r != 1 && owned {
        mmframe.frame_free(state, frame)
    }
    return r
}

fn lazy_file_neighbor(e: u64, ino: u64, pg: u64) -> bool {
    return (e & PTE_FILE_REF_MASK) == PTE_FILE_REF_WANT && lazy_file_ino(e) == ino && lazy_file_pg(e) == pg
}

fn lazy_file_readahead(state: u64, pt: u64, s: u64, e0: u64) -> u64 {
    let ino: u64 = lazy_file_ino(e0)
    let pg: u64 = lazy_file_pg(e0)
    let first: u64 = s - s % FAULT_AROUND_PAGES
    var cached: u64 = 0
    var i: u64 = first
    while i < first + FAULT_AROUND_PAGES {
        var e: u64 = e0
        if i != s {
            e = procpt.read_entry(pt, i)
        }
        if (i == s || pg + i >= s) && lazy_file_neighbor(e, ino, pg + i - s) {
            if fileshare.lookup(state, ino, pg + i - s) != 0 {
                cached = cached | ((1 as u64) << (i - first))
            } else if fileshare.has_room(state) {
                let _k: u64 = lazy_file_cache_page(state, ino, pg + i - s, true)
            }
        }
        i = i + 1
    }
    return cached
}

fn lazy_file_around(state: u64, cur: u64, page: u64, pt: u64, s: u64, e0: u64) -> u64 {
    let first: u64 = s - s % FAULT_AROUND_PAGES
    var cached: u64 = 0
    if fileshare.has_room(state) {
        cached = lazy_file_readahead(state, pt, s, e0)
    }
    let ino: u64 = lazy_file_ino(e0)
    let pg: u64 = lazy_file_pg(e0)
    var main: u64 = 0
    var i: u64 = first
    while i < first + FAULT_AROUND_PAGES {
        if i == s {
            main = lazy_file_page(state, cur, page, pt, s, e0)
        } else if ((cached >> (i - first)) & 1) != 0 {
            let e: u64 = procpt.read_entry(pt, i)
            if lazy_file_neighbor(e, ino, pg + i - s) {
                let _r: u64 = lazy_file_page(state, cur, page, pt, i, e)
            }
        }
        i = i + 1
    }
    return main
}

fn lazy_file_fault(state: u64, cur: u64, page: u64, err: u64, pt: u64, s: u64) -> bool {
    let e0: u64 = procpt.read_entry(pt, s)
    if (e0 & procbase.PAGE_USER) == 0 {
        return false
    }
    if (err & 2) != 0 && (e0 & procbase.PAGE_WRITE) == 0 {
        return false
    }
    if (err & 16) != 0 && (e0 & procbase.PAGE_LAZYX) == 0 {
        return false
    }
    var r: u64 = 0
    if (e0 & procbase.PAGE_WRITE) == 0 {
        r = lazy_file_around(state, cur, page, pt, s, e0)
    } else {
        r = lazy_file_page(state, cur, page, pt, s, e0)
    }
    if r != 0 {
        procspace.tlb_flush_if_current(state, cur)
    }
    return r != 0
}

fn swap_fault(state: u64, cur: u64, page: u64, err: u64, pt: u64, s: u64) -> bool {
    let e0: u64 = procpt.read_entry(pt, s)
    if (e0 & procbase.PAGE_USER) == 0 {
        return false
    }
    if (err & 2) != 0 && (e0 & procbase.PAGE_WRITE) == 0 {
        return false
    }
    if (err & 16) != 0 && (e0 & procbase.PAGE_EXEC_SW) == 0 {
        return false
    }
    let slot: u64 = procmap.swap_slot_of(e0)
    var tmp: u64 = mmframe.frame_alloc_user_low(state)
    if tmp == 0 {
        let _r: u64 = procswap.swap_reclaim(state, cur, (err & 4) != 0)
        tmp = mmframe.frame_alloc_user_low(state)
        if tmp == 0 {
            return false
        }
    }
    while mmswap.busy(slot) {
        sched.yield_now(state)
    }
    let got: u64 = prochooks.read_at(state, mmswap.inode(), slot * mmswap.SLOT_BYTES, tmp, mmframe.FRAME_SIZE)
    if got != mmframe.FRAME_SIZE {
        mmswap.count_fail()
        mmframe.frame_free(state, tmp)
        return false
    }
    var ok: bool = false
    mmlock.demand_lock(state)
    let e: u64 = procpt.read_entry(pt, s)
    if (e & procbase.PAGE_PRESENT) != 0 {
        ok = true
    } else if e == e0 {
        procpt.write_entry(pt, s, 0)
        let f: u64 = procmap.map_page(state, cur, page, (e0 & procbase.PAGE_WRITE) != 0, (e0 & procbase.PAGE_EXEC_SW) != 0)
        if f != 0 {
            var o: u64 = 0
            while o < mmframe.FRAME_SIZE / 8 {
                __mmio_write64((f + o * 8) as *mut u64, __mmio_read64((tmp + o * 8) as *mut u64))
                o = o + 1
            }
            mmswap.release(state, slot)
            mmswap.count_in()
            ok = true
        } else {
            procpt.write_entry(pt, s, e)
        }
    }
    mmlock.demand_unlock(state)
    mmframe.frame_free(state, tmp)
    if ok {
        procspace.tlb_flush_if_current(state, cur)
    }
    return ok
}

const ANON_AROUND_PAGES: u64 = 8

const ANON_AROUND_MIN_FREE: u64 = 4096

fn anon_around(state: u64, cur: u64, pt: u64, s: u64, e: u64) {
    if mmframe.frames_free(state) < ANON_AROUND_MIN_FREE {
        return
    }
    let first: u64 = s - s % ANON_AROUND_PAGES
    var want: u64 = 0
    var k: u64 = first
    while k < first + ANON_AROUND_PAGES {
        if k != s && procpt.read_entry(pt, k) == e {
            want = want + 1
        }
        k = k + 1
    }
    let counter: u64 = ctr.ctr_of(state, cur)
    if want == 0 || !ctr.mem_charge(state, counter, want) {
        return
    }
    var bits: u64 = procbase.PAGE_PRESENT | procbase.PAGE_USER | (e & procbase.PAGE_WRITE)
    if (e & procbase.PAGE_LAZYX) == 0 {
        bits = bits | procpt.nx(state)
    }
    var mapped: u64 = 0
    let flags: u64 = mmframe.lock(state)
    k = first
    while k < first + ANON_AROUND_PAGES && mapped < want {
        if k != s && procpt.read_entry(pt, k) == e {
            let frame: u64 = mmframe.frame_alloc_user_locked(state)
            if frame == 0 {
                break
            }
            procpt.zero_frame(frame)
            procpt.write_entry(pt, k, frame | bits)
            mapped = mapped + 1
        }
        k = k + 1
    }
    mmframe.unlock(state, flags)
    if mapped < want {
        ctr.mem_uncharge(state, counter, want - mapped)
    }
    if mapped != 0 {
        taskslot.tset(state, cur, taskconst.T_UPAGES, taskslot.tget(state, cur, taskconst.T_UPAGES) + mapped)
    }
}

fn lazy_fault(state: u64, cur: u64, addr: u64, err: u64) -> bool {
    if !procmap.lazy_zone(addr) || (err & 1) != 0 {
        return false
    }
    let page: u64 = addr & 0xFFFFFFFFFFFFF000
    let s: u64 = procpt.pt_slot(page)
    let pt: u64 = procpt.pt_for(state, cur, page, false)
    if pt == 0 {
        return false
    }
    let reclaimed: bool = procswap.swap_relieve(state, cur, err)
    let e1: u64 = procpt.read_entry(pt, s)
    if procmap.is_swap_entry(e1) {
        return swap_fault(state, cur, page, err, pt, s)
    }
    if (e1 & procbase.PAGE_PRESENT) == 0 && (e1 & procbase.PAGE_LAZYF) != 0 {
        return lazy_file_fault(state, cur, page, err, pt, s)
    }
    var ok: bool = false
    mmlock.demand_lock(state)
    let e: u64 = procpt.read_entry(pt, s)
    if (e & procbase.PAGE_PRESENT) != 0 {
        ok = true
    } else if (e & procbase.PAGE_LAZY) != 0 && (e & procbase.PAGE_USER) != 0 {
        var denied: bool = false
        if (err & 2) != 0 && (e & procbase.PAGE_WRITE) == 0 {
            denied = true
        }
        if (err & 16) != 0 && (e & procbase.PAGE_LAZYX) == 0 {
            denied = true
        }
        if !denied {
            procpt.write_entry(pt, s, 0)
            if procmap.map_page_zero(state, cur, page, (e & procbase.PAGE_WRITE) != 0, (e & procbase.PAGE_LAZYX) != 0) != 0 {
                ok = true
                anon_around(state, cur, pt, s, e)
            } else {
                procpt.write_entry(pt, s, e)
            }
        }
    }
    mmlock.demand_unlock(state)
    if ok && reclaimed {
        procspace.tlb_flush_if_current(state, cur)
    }
    return ok
}

fn demand_fault(state: u64, cur: u64, addr: u64, err: u64) -> bool {
    if addr < SHM_ARENA_BASE || addr >= SHM_ARENA_TOP || (err & 1) != 0 {
        return false
    }
    let page: u64 = addr & 0xFFFFFFFFFFFFF000
    var ok: bool = false
    mmlock.demand_lock(state)
    if procmap.page_free(state, cur, page) {
        let r: u64 = prochooks.shm_demand(state, cur, page, err)
        if r != 0 && procmap.map_frame(state, cur, page, r & 0xFFFFFFFFFFFFF000, (r & 1) != 0) {
            ok = true
        }
    } else {
        ok = procmap.translate(state, cur, page) != 0
    }
    mmlock.demand_unlock(state)
    if ok {
        procspace.tlb_flush_if_current(state, cur)
    }
    return ok
}

fn low_user_range(state: u64, i: u64, addr: u64, len: u64) -> bool {
    if !proclow.contains(addr) || taskslot.tget(state, i, taskconst.T_LOWPD) == 0 {
        return false
    }
    return len <= proclow.LOW_END - addr
}

fn user_range_ok(state: u64, i: u64, addr: u64, len: u64) -> bool {
    if len == 0 {
        return true
    }
    if addr < procbase.USER_DATA && !low_user_range(state, i, addr, len) {
        return false
    }
    if addr +% len < addr {
        return false
    }
    return addr +% len <= procbase.USER_DATA + procbase.USER_SPAN * procbase.PRIV_SLOTS
}

fn user_ok(state: u64, i: u64, addr: u64, len: u64) -> bool {
    if !user_range_ok(state, i, addr, len) {
        return false
    }
    if len == 0 {
        return true
    }
    var p: u64 = addr
    let last: u64 = addr +% len -% 1
    while p <= last {
        if p >= SHM_ARENA_BASE && p < SHM_ARENA_TOP && procmap.translate(state, i, p) == 0 {
            if !demand_fault(state, i, p, 0) {
                return false
            }
        }
        if procmap.lazy_zone(p) && procmap.translate(state, i, p) == 0 {
            if !lazy_fault(state, i, p, 0) {
                return false
            }
        }
        let pml4: u64 = taskslot.tget(state, i, taskconst.T_CR3)
        let e4: u64 = procpt.read_entry(pml4, (p >> 39) & 0x1FF)
        if (e4 & procbase.PAGE_USER) == 0 {
            return false
        }
        let e3: u64 = procpt.read_entry(e4 & procbase.ADDR_MASK, (p >> 30) & 0x1FF)
        if (e3 & procbase.PAGE_USER) == 0 {
            return false
        }
        let e2: u64 = procpt.read_entry(e3 & procbase.ADDR_MASK, (p >> 21) & 0x1FF)
        if (e2 & procbase.PAGE_USER) == 0 {
            return false
        }
        if (e2 & procbase.PAGE_HUGE) != 0 {
            if (e2 & procbase.PAGE_PRESENT) == 0 {
                return false
            }
            p = (p & (~(procbase.HUGE_SIZE - 1))) + procbase.HUGE_SIZE
        } else {
            var e1: u64 = procpt.read_entry(e2 & procbase.ADDR_MASK, (p >> 12) & 0x1FF)
            if (e1 & procbase.PAGE_PRESENT) == 0 && procspace.stack_page_for_call(state, i, p) {
                e1 = procpt.read_entry(e2 & procbase.ADDR_MASK, (p >> 12) & 0x1FF)
            }
            if (e1 & procbase.PAGE_USER) == 0 || (e1 & procbase.PAGE_PRESENT) == 0 {
                return false
            }
            p = (p & 0xFFFFFFFFFFFFF000) + 4096
        }
    }
    return true
}
