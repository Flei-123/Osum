profile kernel

export {
    register, task_reset, task_files, task_release, shm_demand, read_at, read_at_wide, write_at, swap_file,
    H_TASK_RESET, H_TASK_FILES, H_TASK_RELEASE, H_SHM_DEMAND, H_READ_AT, H_READ_AT_WIDE, H_WRITE_AT, H_SWAP_FILE
}

const H_TASK_RESET: u64 = 0
const H_TASK_FILES: u64 = 1
const H_TASK_RELEASE: u64 = 2
const H_SHM_DEMAND: u64 = 3
const H_READ_AT: u64 = 4
const H_READ_AT_WIDE: u64 = 5
const H_WRITE_AT: u64 = 6
const H_SWAP_FILE: u64 = 7
const H_COUNT: u64 = 8

static mut table: [u64; 8] = [0 as u64; 8]

fn register(slot: u64, handler: u64) {
    if slot < H_COUNT {
        table[slot as usize] = handler
    }
}

fn fire_task(slot: u64, state: u64, i: u64) {
    let handler: u64 = table[slot as usize]
    if handler != 0 {
        let call: fn(u64, u64) = handler as fn(u64, u64)
        call(state, i)
    }
}

fn fire_io(slot: u64, state: u64, ino: u64, off: u64, buf: u64, len: u64) -> u64 {
    let handler: u64 = table[slot as usize]
    if handler == 0 {
        return 0
    }
    let call: fn(u64, u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64, u64) -> u64
    return call(state, ino, off, buf, len)
}

fn task_reset(state: u64, i: u64) {
    fire_task(H_TASK_RESET, state, i)
}

fn task_files(state: u64, i: u64) {
    fire_task(H_TASK_FILES, state, i)
}

fn task_release(state: u64, i: u64) {
    fire_task(H_TASK_RELEASE, state, i)
}

fn shm_demand(state: u64, cur: u64, page: u64, err: u64) -> u64 {
    let handler: u64 = table[H_SHM_DEMAND as usize]
    if handler == 0 {
        return 0
    }
    let call: fn(u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64) -> u64
    return call(state, cur, page, err)
}

fn read_at(state: u64, ino: u64, off: u64, dst: u64, len: u64) -> u64 {
    return fire_io(H_READ_AT, state, ino, off, dst, len)
}

fn read_at_wide(state: u64, ino: u64, off: u64, dst: u64, len: u64) -> u64 {
    return fire_io(H_READ_AT_WIDE, state, ino, off, dst, len)
}

fn write_at(state: u64, ino: u64, off: u64, src: u64, len: u64) -> u64 {
    return fire_io(H_WRITE_AT, state, ino, off, src, len)
}

fn swap_file(state: u64) -> u64 {
    let handler: u64 = table[H_SWAP_FILE as usize]
    if handler == 0 {
        return 0
    }
    let call: fn(u64) -> u64 = handler as fn(u64) -> u64
    return call(state)
}
