profile kernel

import bus.bus
import fs.file
import fs.fs
import fs.unixsock
import fs.procfs
import fs.fsreg
import fs.devfs
import fs.vfsops
import ipc.uio
import bus.slots
import sched.proc.prochooks
import sched.taskconst
import sched.taskslot

export { install }

fn hook_task_reset(state: u64, i: u64) {
    uio.reset(state, i)
}

fn hook_task_files(state: u64, i: u64) {
    file.init_task(state, i)
}

fn hook_task_release(state: u64, i: u64) {
    let pid: u64 = taskslot.tget(state, i, taskconst.T_PID)
    file.close_all(state, i)
    bus.forget_task(state, i, pid)
    slots.forget_task(state, pid)
}

fn hook_shm_demand(state: u64, cur: u64, page: u64, err: u64) -> u64 {
    return unixsock.shm_demand(state, cur, page, err)
}

fn hook_read_at(state: u64, ino: u64, off: u64, dst: u64, len: u64) -> u64 {
    return fs.read_at(state, ino, off, dst, len)
}

fn hook_read_at_wide(state: u64, ino: u64, off: u64, dst: u64, len: u64) -> u64 {
    return fs.read_at_wide(state, ino, off, dst, len)
}

fn hook_write_at(state: u64, ino: u64, off: u64, src: u64, len: u64) -> u64 {
    return fs.write_at(state, ino, off, src, len)
}

fn hook_swap_file(state: u64) -> u64 {
    var path: [u8; 10] = "/swapfile\0"
    let ino: u64 = fs.path(state, (&path[0]) as u64)
    if ino != 0 {
        return ino
    }
    return fs.create_path(state, (&path[0]) as u64, fs.T_FILE)
}

fn hook_proc_ops() -> vfsops.Ops {
    return procfs.ops()
}

fn hook_proc_node_root(state: u64) -> u64 {
    return procfs.node_root(state)
}

fn hook_proc_sfs_root(state: u64) -> u64 {
    return procfs.sfs_root(state)
}

fn hook_dev_ops() -> vfsops.Ops {
    return devfs.ops()
}

fn hook_dev_node_root(state: u64) -> u64 {
    return devfs.node_root(state)
}

fn install(state: u64) {
    fsreg.bind_slot(fsreg.H_DEV_OPS, hook_dev_ops as u64)
    fsreg.bind_slot(fsreg.H_DEV_NODE_ROOT, hook_dev_node_root as u64)
    fsreg.bind_slot(fsreg.H_PROC_OPS, hook_proc_ops as u64)
    fsreg.bind_slot(fsreg.H_PROC_NODE_ROOT, hook_proc_node_root as u64)
    fsreg.bind_slot(fsreg.H_PROC_SFS_ROOT, hook_proc_sfs_root as u64)
    prochooks.bind(prochooks.H_TASK_RESET, hook_task_reset as u64)
    prochooks.bind(prochooks.H_TASK_FILES, hook_task_files as u64)
    prochooks.bind(prochooks.H_TASK_RELEASE, hook_task_release as u64)
    prochooks.bind(prochooks.H_SHM_DEMAND, hook_shm_demand as u64)
    prochooks.bind(prochooks.H_READ_AT, hook_read_at as u64)
    prochooks.bind(prochooks.H_READ_AT_WIDE, hook_read_at_wide as u64)
    prochooks.bind(prochooks.H_WRITE_AT, hook_write_at as u64)
    prochooks.bind(prochooks.H_SWAP_FILE, hook_swap_file as u64)
}
