import lib.kstate

export { task_at, tget, tset }

fn task_at(state: u64, i: u64) -> u64 {
    return state + kstate.TASK_OFF + i * kstate.TASK_BYTES
}

fn tget(state: u64, i: u64, field: u64) -> u64 {
    return __mmio_read64((state + kstate.TASK_OFF + i * kstate.TASK_BYTES + field) as *mut u64)
}

fn tset(state: u64, i: u64, field: u64, v: u64) {
    __mmio_write64((state + kstate.TASK_OFF + i * kstate.TASK_BYTES + field) as *mut u64, v)
}
