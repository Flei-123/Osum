profile kernel

import lib.kstate
import lib.procw
import sched.time
import sched.rand
import sched.randseed

export { render }

static mut K_STATE: [u8; 6] = "state\0"
static mut K_BITS: [u8; 13] = "entropy_bits\0"
static mut K_NEED: [u8; 12] = "needed_bits\0"
static mut K_CPU: [u8; 16] = "source.cpu_bits\0"
static mut K_JIT: [u8; 19] = "source.jitter_bits\0"
static mut K_SEED: [u8; 17] = "source.seed_bits\0"
static mut K_IRQ: [u8; 16] = "source.irq_bits\0"
static mut K_RDRAND: [u8; 11] = "cpu.rdrand\0"
static mut K_RDSEED: [u8; 11] = "cpu.rdseed\0"
static mut K_TRUST: [u8; 12] = "cpu.trusted\0"
static mut K_JMODE: [u8; 12] = "jitter.mode\0"
static mut K_JSAMP: [u8; 15] = "jitter.samples\0"
static mut K_JFAIL: [u8; 16] = "jitter.failures\0"
static mut K_ISAMP: [u8; 12] = "irq.samples\0"
static mut K_IFAIL: [u8; 13] = "irq.failures\0"
static mut K_MIXED: [u8; 18] = "pool.mixed_octets\0"
static mut K_GEN: [u8; 16] = "drbg.generation\0"
static mut K_RESEED: [u8; 13] = "drbg.reseeds\0"
static mut K_OUT: [u8; 14] = "octets_issued\0"
static mut K_SFILE: [u8; 10] = "seed.file\0"
static mut K_SCOUNT: [u8; 13] = "seed.counter\0"
static mut K_AFTER: [u8; 15] = "ready_after_us\0"
static mut K_SSAVED: [u8; 11] = "seed.saved\0"
static mut V_READY: [u8; 6] = "ready\0"
static mut V_WAIT: [u8; 16] = "not-initialised\0"
static mut V_OFF: [u8; 4] = "off\0"
static mut V_ON: [u8; 3] = "on\0"
static mut V_STUCK: [u8; 6] = "stuck\0"

fn bits(units: u64) -> u64 {
    return units / rand.UNITS_PER_BIT
}

fn render(state: u64, out: u64, cap: u64) -> u64 {
    procw.begin(out, cap)
    if rand.ready(state) != 0 {
        procw.line_text((&K_STATE[0]) as u64, (&V_READY[0]) as u64)
    } else {
        procw.line_text((&K_STATE[0]) as u64, (&V_WAIT[0]) as u64)
    }
    let total: u64 = rand.stat(state, rand.S_UNITS_CPU) + rand.stat(state, rand.S_UNITS_JITTER) + rand.stat(state, rand.S_UNITS_SEED)
    procw.line_num((&K_BITS[0]) as u64, bits(total))
    let khz: u64 = time.khz(state)
    let ready_tsc: u64 = rand.stat(state, rand.S_READY_TSC)
    if rand.ready(state) != 0 && khz != 0 && ready_tsc > kstate.get(state, kstate.BM_BASE + 8) {
        procw.line_num((&K_AFTER[0]) as u64, ((ready_tsc - kstate.get(state, kstate.BM_BASE + 8)) * 1000) / khz)
    }
    procw.line_num((&K_NEED[0]) as u64, rand.stat(state, rand.S_PENDING_BITS))
    procw.line_num((&K_CPU[0]) as u64, bits(rand.stat(state, rand.S_UNITS_CPU)))
    procw.line_num((&K_JIT[0]) as u64, bits(rand.stat(state, rand.S_UNITS_JITTER)))
    procw.line_num((&K_SEED[0]) as u64, bits(rand.stat(state, rand.S_UNITS_SEED)))
    procw.line_num((&K_IRQ[0]) as u64, bits(rand.stat(state, rand.S_UNITS_IRQ)))
    let caps: u64 = rand.stat(state, rand.S_CPU_CAPS)
    procw.line_num((&K_RDRAND[0]) as u64, caps & 1)
    procw.line_num((&K_RDSEED[0]) as u64, (caps >> 1) & 1)
    procw.line_num((&K_TRUST[0]) as u64, rand.stat(state, rand.S_TRUST_CPU))
    let jm: u64 = rand.stat(state, rand.S_JIT_MODE)
    if jm == rand.JIT_OFF {
        procw.line_text((&K_JMODE[0]) as u64, (&V_OFF[0]) as u64)
    } else if jm == rand.JIT_STUCK {
        procw.line_text((&K_JMODE[0]) as u64, (&V_STUCK[0]) as u64)
    } else {
        procw.line_text((&K_JMODE[0]) as u64, (&V_ON[0]) as u64)
    }
    procw.line_num((&K_JSAMP[0]) as u64, rand.stat(state, rand.S_JIT_SAMPLES))
    procw.line_num((&K_JFAIL[0]) as u64, rand.stat(state, rand.S_JIT_FAILS))
    procw.line_num((&K_ISAMP[0]) as u64, rand.stat(state, rand.S_IRQ_SAMPLES))
    procw.line_num((&K_IFAIL[0]) as u64, rand.stat(state, rand.S_IRQ_FAILS))
    procw.line_num((&K_MIXED[0]) as u64, rand.stat(state, rand.S_MIXED_BYTES))
    procw.line_num((&K_GEN[0]) as u64, rand.stat(state, rand.S_GENERATION))
    procw.line_num((&K_RESEED[0]) as u64, rand.stat(state, rand.S_RESEEDS))
    procw.line_num((&K_OUT[0]) as u64, rand.stat(state, rand.S_BYTES_OUT))
    procw.line_text((&K_SFILE[0]) as u64, randseed.status_text())
    procw.line_num((&K_SSAVED[0]) as u64, randseed.saved())
    procw.line_num((&K_SCOUNT[0]) as u64, randseed.counter())
    return procw.used()
}
