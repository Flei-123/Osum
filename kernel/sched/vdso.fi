import lib.kstate
import mm.mmframe
import arch.arch
import libc.regio
import sched.vdsoimg

export { VDSO_ADDR, peek, frame, publish }

const VDSO_ADDR: u64 = 0x53600000
const PAGE_BYTES: u64 = 4096
const DATA_OFFSET: u64 = 0xF00
const SEQ_AT: u64 = 0
const KHZ_AT: u64 = 8
const TSC0_AT: u64 = 16
const REAL_BASE_AT: u64 = 24
const REAL_OK_AT: u64 = 32
const MULT_AT: u64 = 40
const KHZ_PER_GHZ: u64 = 1000000
const MULT_BITS: u64 = 64

static mut image_frame: u64 = 0

fn peek() -> u64 {
    return image_frame
}

fn frame(state: u64) -> u64 {
    if image_frame != 0 {
        return image_frame
    }
    let f: u64 = mmframe.frame_alloc(state)
    if f == 0 {
        return 0
    }
    arch.fill_words(f, 0, PAGE_BYTES / 8)
    vdsoimg.write_image(f)
    image_frame = f
    return f
}

fn ns_multiplier(khz: u64) -> u64 {
    if khz <= KHZ_PER_GHZ {
        return 0
    }
    var rem: u64 = KHZ_PER_GHZ
    var quot: u64 = 0
    var bit: u64 = 0
    while bit < MULT_BITS {
        rem = rem << 1
        quot = quot << 1
        if rem >= khz {
            rem = rem - khz
            quot = quot | 1
        }
        bit = bit + 1
    }
    if rem != 0 {
        quot = quot + 1
    }
    return quot
}

fn publish(khz: u64, tsc0: u64, real_base: u64, real_ok: u64) {
    let f: u64 = image_frame
    if f == 0 {
        return
    }
    let data: u64 = f + DATA_OFFSET
    let seq: u64 = regio.read64(data + SEQ_AT)
    regio.write64(data + SEQ_AT, seq + 1)
    regio.write64(data + KHZ_AT, khz)
    regio.write64(data + TSC0_AT, tsc0)
    regio.write64(data + REAL_BASE_AT, real_base)
    regio.write64(data + REAL_OK_AT, real_ok)
    regio.write64(data + MULT_AT, ns_multiplier(khz))
    regio.write64(data + SEQ_AT, seq + 2)
}
