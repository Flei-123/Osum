    var s_hw: [u8; 7] = " hw=\0\0\0"
    var s_hi: [u8; 9] = " hwimg=\0\0"
    var s_fr: [u8; 11] = " rahmen=\0\0\0"
    var s_fb: [u8; 10] = " zurueck=\0"
    var s_c: [u8; 7] = " cnt=\0\0"
