
export {
    NO_RESTART, restartable, interrupted_result, rewind_target
}

const NO_RESTART: u64 = 0xFFFFFFFFFFFFFFFF
const SYSCALL_INSN_BYTES: u64 = 2
const EINTR_RESULT: u64 = 0xFFFFFFFFFFFFFFFC
const NR_READ: u64 = 0
const NR_WRITE: u64 = 1
const NR_PREAD64: u64 = 17
const NR_PWRITE64: u64 = 18
const NR_READV: u64 = 19
const NR_WRITEV: u64 = 20
const NR_SEMOP: u64 = 65
const NR_CONNECT: u64 = 42
const NR_ACCEPT: u64 = 43
const NR_SENDTO: u64 = 44
const NR_RECVFROM: u64 = 45
const NR_SENDMSG: u64 = 46
const NR_RECVMSG: u64 = 47
const NR_WAIT4: u64 = 61
const NR_MSGSND: u64 = 69
const NR_MSGRCV: u64 = 70
const NR_FLOCK: u64 = 73
const NR_FUTEX: u64 = 202
const NR_WAITID: u64 = 247
const NR_ACCEPT4: u64 = 288
const NR_PREADV: u64 = 295
const NR_PWRITEV: u64 = 296
const FUTEX_CMD_MASK: u64 = 127
const FUTEX_WAIT: u64 = 0
const FUTEX_WAIT_BITSET: u64 = 9

fn interrupted_result(result: u64) -> bool {
    return result == EINTR_RESULT
}

fn restartable(number: u64, futex_op: u64) -> bool {
    if number == NR_FUTEX {
        let cmd: u64 = futex_op & FUTEX_CMD_MASK
        return cmd == FUTEX_WAIT || cmd == FUTEX_WAIT_BITSET
    }
    if number <= NR_WRITEV {
        return number <= NR_WRITE || (number >= NR_PREAD64 && number <= NR_WRITEV)
    }
    if number >= NR_CONNECT && number <= NR_RECVMSG {
        return true
    }
    return number == NR_WAIT4 || number == NR_SEMOP || number == NR_MSGSND || number == NR_MSGRCV
        || number == NR_FLOCK || number == NR_WAITID || number == NR_ACCEPT4
        || number == NR_PREADV || number == NR_PWRITEV
}

fn rewind_target(rip: u64) -> u64 {
    return rip -% SYSCALL_INSN_BYTES
}
