
import serial
import lib.kstate
import sched.sched
import sched.taskconst
import sched.taskslot
import sched.proc.procfault
import sched.proc.procmap
import lib.errno
import arch.cpu
import sched.ctr
import arch.x86_64.guard
import libc.regio
import sched.ptrace
import sched.ptstate
import sched.sigrestart
import sched.sigsysinfo

export {
    init_task, clear_task, exec_reset, inherit, force_sigsys,
    send, send_task, send_timer, send_pid, send_pgid, send_tty, fault, alarm_check,
    check_sys, check_trap, greg_off, notify_tracer, pending, deliverable, interrupted,
    do_sigaction, do_sigprocmask, do_sigreturn, do_kill, do_pause,
    do_setpgid, do_getpgid, do_setsid, do_alarm, do_sigpending,
    do_setitimer, do_getitimer, do_sigaltstack, do_sigsuspend, do_sigtimedwait,
    exiting, stopped_count, handler_of, say_name, signal_of, lethal,
    SIGHUP, SIGINT, SIGQUIT, SIGILL, SIGTRAP, SIGABRT, SIGBUS, SIGFPE,
    SIGKILL, SIGUSR1, SIGSEGV, SIGUSR2, SIGPIPE, SIGALRM, SIGTERM,
    SIGCHLD, SIGCONT, SIGSTOP, SIGTSTP, SIGTTIN, SIGTTOU, SIGWINCH,
    NSIG, SIG_DFL, SIG_IGN, SIG_ERR,
    SIG_BLOCK, SIG_UNBLOCK, SIG_SETMASK,
    SA_NOCLDSTOP, SA_RESTART, SA_NODEFER, SA_RESETHAND, SA_SIGINFO
}

const SIGHUP: u64 = 1
const SIGINT: u64 = 2
const SIGQUIT: u64 = 3
const SIGILL: u64 = 4
const SIGTRAP: u64 = 5
const SIGABRT: u64 = 6
const SIGBUS: u64 = 7
const SIGFPE: u64 = 8
const SIGKILL: u64 = 9
const SIGUSR1: u64 = 10
const SIGSEGV: u64 = 11
const SIGUSR2: u64 = 12
const SIGPIPE: u64 = 13
const SIGALRM: u64 = 14
const SIGTERM: u64 = 15
const SIGCHLD: u64 = 17
const SIGCONT: u64 = 18
const SIGSTOP: u64 = 19
const SIGTSTP: u64 = 20
const SIGTTIN: u64 = 21
const SIGTTOU: u64 = 22
const SIGWINCH: u64 = 28
const NSIG: u64 = 65
const SIGSYS: u64 = 31
const SYS_SECCOMP_CODE: u64 = 1
const AUDIT_ARCH_X86_64: u64 = 0xC000003E
const SI_CALL_NR_OFF: u64 = 24
const SI_TIMER_CODE: u64 = 0xFFFFFFFE
static mut timer_marks: [u64; 256] = [0 as u64; 256]
const NSIG_OLD: u64 = 32

const SIG_DFL: u64 = 0
const SIG_IGN: u64 = 1
const SIG_ERR: u64 = 0xFFFFFFFFFFFFFFFF

const SIG_BLOCK: u64 = 0
const SIG_UNBLOCK: u64 = 1
const SIG_SETMASK: u64 = 2

const SA_NOCLDSTOP: u64 = 1
const SA_SIGINFO: u64 = 4
const SA_RESTART: u64 = 0x10000000
const SA_ONSTACK: u64 = 0x08000000
const SA_NODEFER: u64 = 0x40000000
const SA_RESETHAND: u64 = 0x80000000

const D_TERM: u64 = 0
const D_IGN: u64 = 1
const D_CORE: u64 = 2
const D_STOP: u64 = 3
const D_CONT: u64 = 4

const A_BYTES: u64 = 24
const A_HANDLER: u64 = 0
const A_FLAGS: u64 = 8
const A_MASK: u64 = 16
const A_TASK: u64 = 768

const SF_MAGIC: u64 = 0
const SF_MASK: u64 = 8
const SF_SIG: u64 = 16
const SF_CTX: u64 = 24
const SF_INFO: u64 = 200
const SF_UC: u64 = 328
const SF_BYTES: u64 = 1264
const MAGIC: u64 = 0x5349474E414C4B39

const REDZONE: u64 = 128

const C_R15: u64 = 0
const C_R11: u64 = 32
const C_R10: u64 = 40
const C_RDI: u64 = 64
const C_RSI: u64 = 72
const C_RDX: u64 = 96
const C_RCX: u64 = 104
const C_RAX: u64 = 112
const C_VECTOR: u64 = 120
const C_ERROR: u64 = 128
const C_RIP: u64 = 136
const C_CS: u64 = 144
const C_RFLAGS: u64 = 152
const C_RSP: u64 = 160
const C_SS: u64 = 168
const C_WORDS: u64 = 22

const F_R15: u64 = 0
const F_R14: u64 = 8
const F_R13: u64 = 16
const F_R12: u64 = 24
const F_RBP: u64 = 32
const F_RBX: u64 = 40
const F_R9: u64 = 48
const F_R8: u64 = 56
const F_R10: u64 = 64
const F_RDX: u64 = 72
const F_RSI: u64 = 80
const F_RDI: u64 = 88
const F_RAX: u64 = 96
const F_RIP: u64 = 104
const F_RFLAGS: u64 = 112
const F_RSP: u64 = 120

const V_TRAMP: u64 = 67
const V_IRET: u64 = 68

const USER_CS: u64 = 0x2B
const USER_SS: u64 = 0x23

fn vector(state: u64, i: u64) -> u64 {
    return __mmio_read64((kstate.get(state, kstate.VECTORS) + i * 8) as *mut u64)
}

fn neg(e: u64) -> u64 {
    return errno.neg(e)
}

fn act(state: u64, task: u64, sig: u64) -> u64 {
    if sig >= NSIG_OLD {
        return state + kstate.SIGRT_OFF + task * kstate.SIGRT_TASK + (sig - NSIG_OLD) * A_BYTES
    }
    return state + kstate.SIG_OFF + task * A_TASK + sig * A_BYTES
}

fn ctx_of(state: u64, task: u64) -> u64 {
    return state + kstate.SIGCTX_OFF + task * kstate.SIGCTX_BYTES
}

fn bit(sig: u64) -> u64 {
    if sig == 0 || sig >= NSIG {
        return 0
    }
    return 1 << (sig - 1)
}

fn uncatchable(sig: u64) -> bool {
    return sig == SIGKILL || sig == SIGSTOP
}

fn default_of(sig: u64) -> u64 {
    if sig == SIGCHLD || sig == SIGWINCH || sig == 23 {
        return D_IGN
    }
    if sig == SIGCONT {
        return D_CONT
    }
    if sig == SIGSTOP || sig == SIGTSTP || sig == SIGTTIN || sig == SIGTTOU {
        return D_STOP
    }
    if sig == SIGQUIT || sig == SIGILL || sig == SIGTRAP || sig == SIGABRT
    || sig == SIGBUS || sig == SIGFPE || sig == SIGSEGV || sig == 31 {
        return D_CORE
    }
    return D_TERM
}

fn say_name(sig: u64) {
    var names: [u8; 128] = "?  \0HUP\0INT\0QIT\0ILL\0TRP\0ABR\0BUS\0FPE\0KIL\0US1\0SEG\0US2\0PIP\0ALR\0TRM\0STK\0CHL\0CNT\0STP\0TSP\0TIN\0TOU\0URG\0XCP\0XFS\0VTA\0PRF\0WIN\0IO \0PWR\0SYS\0"
    var n: u64 = sig
    if n >= NSIG_OLD {
        n = 0
    }
    serial.puts((&names[0]) as u64 + n * 4)
}


fn clear_task(state: u64, task: u64) {
    if task >= kstate.MAX_TASKS {
        return
    }
    var i: u64 = 0
    while i < NSIG {
        regio.write64(act(state, task, i) + A_HANDLER, SIG_DFL)
        regio.write64(act(state, task, i) + A_FLAGS, 0)
        regio.write64(act(state, task, i) + A_MASK, 0)
        i = i + 1
    }
    taskslot.tset(state, task, taskconst.T_SIGPEND, 0)
    taskslot.tset(state, task, taskconst.T_SIGMASK, 0)
    taskslot.tset(state, task, taskconst.T_SIGRET, 0)
    taskslot.tset(state, task, taskconst.T_ALARM, 0)
    taskslot.tset(state, task, taskconst.T_ITIV, 0)
    taskslot.tset(state, task, taskconst.T_ALTSZ, 0)
    taskslot.tset(state, task, taskconst.T_STOPSIG, 0)
}

fn init_task(state: u64, task: u64) {
    clear_task(state, task)
    let pid: u64 = taskslot.tget(state, task, taskconst.T_PID)
    taskslot.tset(state, task, taskconst.T_PGID, pid)
    taskslot.tset(state, task, taskconst.T_SID, pid)
    taskslot.tset(state, task, taskconst.T_TGID, pid)
}

fn inherit(state: u64, parent: u64, child: u64) {
    var i: u64 = 0
    while i < NSIG {
        regio.write64(act(state, child, i) + A_HANDLER,
            regio.read64(act(state, parent, i) + A_HANDLER))
        regio.write64(act(state, child, i) + A_FLAGS,
            regio.read64(act(state, parent, i) + A_FLAGS))
        regio.write64(act(state, child, i) + A_MASK,
            regio.read64(act(state, parent, i) + A_MASK))
        i = i + 1
    }
    taskslot.tset(state, child, taskconst.T_SIGPEND, 0)
    taskslot.tset(state, child, taskconst.T_SIGRET, 0)
    taskslot.tset(state, child, taskconst.T_SIGMASK,
        taskslot.tget(state, parent, taskconst.T_SIGMASK))
    taskslot.tset(state, child, taskconst.T_PGID,
        taskslot.tget(state, parent, taskconst.T_PGID))
    taskslot.tset(state, child, taskconst.T_SID,
        taskslot.tget(state, parent, taskconst.T_SID))
    taskslot.tset(state, child, taskconst.T_TTY,
        taskslot.tget(state, parent, taskconst.T_TTY))
    taskslot.tset(state, child, taskconst.T_TGID,
        taskslot.tget(state, child, taskconst.T_PID))
}

fn exec_reset(state: u64, task: u64) {
    var i: u64 = 0
    while i < NSIG {
        if regio.read64(act(state, task, i) + A_HANDLER) != SIG_IGN {
            regio.write64(act(state, task, i) + A_HANDLER, SIG_DFL)
        }
        regio.write64(act(state, task, i) + A_FLAGS, 0)
        regio.write64(act(state, task, i) + A_MASK, 0)
        i = i + 1
    }
    taskslot.tset(state, task, taskconst.T_SIGRET, 0)
}

fn handler_of(state: u64, task: u64, sig: u64) -> u64 {
    if sig >= NSIG {
        return SIG_DFL
    }
    return regio.read64(act(state, task, sig) + A_HANDLER)
}

fn pending(state: u64, task: u64) -> u64 {
    return taskslot.tget(state, task, taskconst.T_SIGPEND)
}

fn deliverable(state: u64, task: u64) -> u64 {
    let t: u64 = state + kstate.TASK_OFF + task * kstate.TASK_BYTES
    var d: u64 = *((t + taskconst.T_SIGPEND) as *mut u64)
        & (0xFFFFFFFFFFFFFFFF -% *((t + taskconst.T_SIGMASK) as *mut u64))
    if (*((t + taskconst.T_KILLCODE) as *mut u64) & taskconst.KILL_SET) != 0 {
        d = d | bit(SIGKILL)
    }
    return d
}

fn interrupted(state: u64, task: u64) -> bool {
    return deliverable(state, task) != 0
}

fn stopped_count(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_STATE) == taskconst.S_STOP {
            c = c + 1
        }
        i = i + 1
    }
    return c
}


fn discarded(state: u64, task: u64, sig: u64) -> bool {
    if uncatchable(sig) {
        return false
    }
    if (taskslot.tget(state, task, taskconst.T_SIGMASK) & bit(sig)) != 0 {
        return false
    }
    if ptstate.traced(task) {
        return false
    }
    let h: u64 = handler_of(state, task, sig)
    return h == SIG_IGN || (h == SIG_DFL && default_of(sig) == D_IGN)
}

fn send_task(state: u64, task: u64, sig: u64) -> bool {
    return raise(state, task, sig, false)
}

fn force_sigsys(state: u64, task: u64, nr: u64, ip: u64, kill: bool) -> bool {
    sigsysinfo.put(task, nr, ip)
    let m: u64 = taskslot.tget(state, task, taskconst.T_SIGMASK)
    taskslot.tset(state, task, taskconst.T_SIGMASK, m & (0xFFFFFFFFFFFFFFFF -% bit(SIGSYS)))
    if kill || handler_of(state, task, SIGSYS) == SIG_IGN {
        regio.write64(act(state, task, SIGSYS) + A_HANDLER, SIG_DFL)
        regio.write64(act(state, task, SIGSYS) + A_FLAGS, 0)
    }
    return send_task(state, task, SIGSYS)
}

fn send_timer(state: u64, pid: u64, sig: u64) -> u64 {
    let i: u64 = sched.find_pid(state, pid)
    if i >= kstate.MAX_TASKS || !raise(state, i, sig, true) {
        return neg(errno.E_SRCH)
    }
    return 0
}

fn mark_origin(task: u64, sig: u64, from_timer: bool) {
    if from_timer {
        timer_marks[task as usize] = timer_marks[task as usize] | bit(sig)
    } else {
        timer_marks[task as usize] = timer_marks[task as usize] & (0xFFFFFFFFFFFFFFFF -% bit(sig))
    }
}

fn raise(state: u64, task: u64, sig: u64, from_timer: bool) -> bool {
    if task >= kstate.MAX_TASKS || sig == 0 || sig >= NSIG {
        return false
    }
    let st: u64 = taskslot.tget(state, task, taskconst.T_STATE)
    if st == taskconst.S_FREE || st == taskconst.S_ZOMBIE {
        return false
    }
    let flags: u64 = sched.irq_save()
    var pend: u64 = taskslot.tget(state, task, taskconst.T_SIGPEND)
    if sig == SIGCONT {
        pend = pend & (0xFFFFFFFFFFFFFFFF -% (bit(SIGSTOP) | bit(SIGTSTP)
                | bit(SIGTTIN) | bit(SIGTTOU)))
        if st == taskconst.S_STOP {
            if sched.state_cas(state, task, taskconst.S_STOP, taskconst.S_READY) {
                taskslot.tset(state, task, taskconst.T_STOPSIG, 0)
            }
        }
    }
    if sig == SIGSTOP || sig == SIGTSTP || sig == SIGTTIN || sig == SIGTTOU {
        pend = pend & (0xFFFFFFFFFFFFFFFF -% bit(SIGCONT))
    }
    if discarded(state, task, sig) {
        taskslot.tset(state, task, taskconst.T_SIGPEND, pend)
        sched.irq_restore(flags)
        kstate.add(state, kstate.SIG_SENT, 1)
        return true
    }
    mark_origin(task, sig, from_timer)
    taskslot.tset(state, task, taskconst.T_SIGPEND, pend | bit(sig))
    let now: u64 = taskslot.tget(state, task, taskconst.T_STATE)
    if now == taskconst.S_SLEEP || now == taskconst.S_WAIT || now == taskconst.S_POLL {
        sched.state_cas(state, task, now, taskconst.S_READY)
    }
    if sig == SIGKILL && now == taskconst.S_STOP {
        if sched.state_cas(state, task, taskconst.S_STOP, taskconst.S_READY) {
            taskslot.tset(state, task, taskconst.T_STOPSIG, 0)
        }
    }
    sched.irq_restore(flags)
    kstate.add(state, kstate.SIG_SENT, 1)
    sched.poll_kick_one(state, task)
    return true
}

fn send_pid(state: u64, pid: u64, sig: u64) -> u64 {
    let i: u64 = sched.find_pid(state, pid)
    if i >= kstate.MAX_TASKS {
        return neg(errno.E_SRCH)
    }
    if sig == 0 {
        return 0
    }
    if !send_task(state, i, sig) {
        return neg(errno.E_SRCH)
    }
    return 0
}

fn send_pgid(state: u64, pgid: u64, sig: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var hit: u64 = 0
    while i < n {
        let st: u64 = taskslot.tget(state, i, taskconst.T_STATE)
        if st != taskconst.S_FREE && st != taskconst.S_ZOMBIE
        && taskslot.tget(state, i, taskconst.T_KIND) == taskconst.K_USER
        && taskslot.tget(state, i, taskconst.T_PGID) == pgid {
            if send_task(state, i, sig) {
                hit = hit + 1
            }
        }
        i = i + 1
    }
    return hit
}

fn send_tty(state: u64, t: u64, zero_too: bool, sig: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var hit: u64 = 0
    while i < n {
        let st: u64 = taskslot.tget(state, i, taskconst.T_STATE)
        if st != taskconst.S_FREE && st != taskconst.S_ZOMBIE
        && taskslot.tget(state, i, taskconst.T_KIND) == taskconst.K_USER
        && (taskslot.tget(state, i, taskconst.T_TTY) == t + 1
            || (zero_too && taskslot.tget(state, i, taskconst.T_TTY) == 0)) {
            if send_task(state, i, sig) {
                hit = hit + 1
            }
        }
        i = i + 1
    }
    return hit
}

fn send_pgid_from(state: u64, sender: u64, pgid: u64, sig: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var hit: u64 = 0
    while i < n {
        let st: u64 = taskslot.tget(state, i, taskconst.T_STATE)
        if st != taskconst.S_FREE && st != taskconst.S_ZOMBIE
        && taskslot.tget(state, i, taskconst.T_KIND) == taskconst.K_USER
        && taskslot.tget(state, i, taskconst.T_PGID) == pgid {
            if ctr.may_signal(state, sender, i) {
                if send_task(state, i, sig) {
                    hit = hit + 1
                }
            }
        }
        i = i + 1
    }
    return hit
}

fn send(state: u64, task: u64, sig: u64) -> bool {
    return send_task(state, task, sig)
}

fn exiting(state: u64, task: u64) {
    let p: u64 = taskslot.tget(state, task, taskconst.T_PARENT)
    if p >= kstate.MAX_TASKS || p == task {
        return
    }
    if taskslot.tget(state, p, taskconst.T_KIND) != taskconst.K_USER {
        return
    }
    send_task(state, p, SIGCHLD)
}

fn signal_of(v: u64) -> u64 {
    if v == 0 {
        return SIGFPE
    }
    if v == 1 || v == 3 {
        return SIGTRAP
    }
    if v == 4 {
        return SIGSEGV
    }
    if v == 5 {
        return SIGSEGV
    }
    if v == 6 {
        return SIGILL
    }
    if v == 8 || v == 10 || v == 11 || v == 12 || v == 13 {
        return SIGSEGV
    }
    if v == 14 {
        return SIGSEGV
    }
    if v == 16 || v == 19 {
        return SIGFPE
    }
    if v == 17 {
        return SIGBUS
    }
    return SIGSEGV
}

fn fault(state: u64, task: u64, v: u64) -> u64 {
    let sig: u64 = signal_of(v)
    taskslot.tset(state, task, taskconst.T_FAULTS,
        taskslot.tget(state, task, taskconst.T_FAULTS) + 1)
    let m: u64 = taskslot.tget(state, task, taskconst.T_SIGMASK)
    taskslot.tset(state, task, taskconst.T_SIGMASK, m & (0xFFFFFFFFFFFFFFFF -% bit(sig)))
    if handler_of(state, task, sig) != SIG_DFL && (regio.read64(act(state, task, sig) + A_FLAGS) & SA_SIGINFO) == 0 {
        regio.write64(act(state, task, sig) + A_FLAGS,
            regio.read64(act(state, task, sig) + A_FLAGS) | SA_RESETHAND)
    }
    taskslot.tset(state, task, taskconst.T_KILLCODE, 128 + v)
    send_task(state, task, sig)
    return sig
}

fn lethal(state: u64, task: u64, sig: u64) -> bool {
    if uncatchable(sig) {
        return sig == SIGKILL
    }
    let h: u64 = handler_of(state, task, sig)
    if h != SIG_DFL {
        return false
    }
    let d: u64 = default_of(sig)
    return d == D_TERM || d == D_CORE
}

fn alarm_check(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    let now: u64 = kstate.get(state, kstate.TICKS)
    var i: u64 = 0
    var fired: u64 = 0
    while i < n {
        let due: u64 = taskslot.tget(state, i, taskconst.T_ALARM)
        if due != 0 && due <= now {
            taskslot.tset(state, i, taskconst.T_ALARM, 0)
            let iv: u64 = taskslot.tget(state, i, taskconst.T_ITIV)
            if iv != 0 {
                var nx: u64 = due + iv
                if nx <= now {
                    nx = now + iv
                }
                taskslot.tset(state, i, taskconst.T_ALARM, nx)
            }
            if send_task(state, i, SIGALRM) {
                fired = fired + 1
            }
        }
        i = i + 1
    }
    return fired
}


fn poke64(state: u64, task: u64, addr: u64, v: u64) -> bool {
    let phys: u64 = procmap.translate(state, task, addr)
    if phys == 0 {
        return false
    }
    guard.stac(state)
    __mmio_write64(phys as *mut u64, v)
    guard.clac(state)
    return true
}

fn peek64(state: u64, task: u64, addr: u64) -> u64 {
    let phys: u64 = procmap.translate(state, task, addr)
    if phys == 0 {
        return 0
    }
    guard.stac(state)
    let v: u64 = __mmio_read64(phys as *mut u64)
    guard.clac(state)
    return v
}


fn greg_off(i: u64) -> u64 {
    if i == 0 { return 56 }
    if i == 1 { return 48 }
    if i == 2 { return 40 }
    if i == 3 { return 32 }
    if i == 4 { return 24 }
    if i == 5 { return 16 }
    if i == 6 { return 8 }
    if i == 7 { return 0 }
    if i == 8 { return 64 }
    if i == 9 { return 72 }
    if i == 10 { return 80 }
    if i == 11 { return 88 }
    if i == 12 { return 96 }
    if i == 13 { return 112 }
    if i == 14 { return 104 }
    if i == 15 { return 160 }
    if i == 16 { return 136 }
    return 152
}

fn rewind_for_restart(ctx: u64, number: u64) {
    __mmio_write64((ctx + C_RIP) as *mut u64, sigrestart.rewind_target(__mmio_read64((ctx + C_RIP) as *mut u64)))
    __mmio_write64((ctx + C_RAX) as *mut u64, number)
}

fn deliver(state: u64, task: u64, sig: u64, ctx: u64, restart_nr: u64) -> bool {
    let h: u64 = handler_of(state, task, sig)
    if restart_nr != sigrestart.NO_RESTART && (regio.read64(act(state, task, sig) + A_FLAGS) & SA_RESTART) != 0 {
        rewind_for_restart(ctx, restart_nr)
    }
    let old_rsp: u64 = __mmio_read64((ctx + C_RSP) as *mut u64)
    var base: u64 = ((old_rsp -% REDZONE) -% SF_BYTES) & 0xFFFFFFFFFFFFFFF0
    let altsz: u64 = taskslot.tget(state, task, taskconst.T_ALTSZ)
    if altsz != 0 && (regio.read64(act(state, task, sig) + A_FLAGS) & SA_ONSTACK) != 0 {
        let altsp: u64 = taskslot.tget(state, task, taskconst.T_ALTSP)
        if old_rsp < altsp || old_rsp >= altsp +% altsz {
            base = ((altsp +% altsz) -% SF_BYTES) & 0xFFFFFFFFFFFFFFF0
        }
    }
    let ret: u64 = base -% 8
    if !procfault.user_ok(state, task, ret, SF_BYTES + 8) {
        return false
    }
    poke64(state, task, ret, vector(state, V_TRAMP))
    poke64(state, task, base + SF_MAGIC, MAGIC)
    var frame_mask: u64 = taskslot.tget(state, task, taskconst.T_SIGMASK)
    if taskslot.tget(state, task, taskconst.T_SUSP) != 0 {
        frame_mask = taskslot.tget(state, task, taskconst.T_SUSPMASK)
        taskslot.tset(state, task, taskconst.T_SUSP, 0)
    }
    poke64(state, task, base + SF_MASK, frame_mask)
    poke64(state, task, base + SF_SIG, sig)
    var i: u64 = 0
    while i < C_WORDS {
        poke64(state, task, base + SF_CTX + i * 8,
            __mmio_read64((ctx + i * 8) as *mut u64))
        i = i + 1
    }
    let fl: u64 = regio.read64(act(state, task, sig) + A_FLAGS)
    var m: u64 = taskslot.tget(state, task, taskconst.T_SIGMASK)
        | regio.read64(act(state, task, sig) + A_MASK)
    if (fl & SA_NODEFER) == 0 {
        m = m | bit(sig)
    }
    taskslot.tset(state, task, taskconst.T_SIGMASK, m)
    taskslot.tset(state, task, taskconst.T_SIGRET, base)
    if (fl & SA_RESETHAND) != 0 {
        regio.write64(act(state, task, sig) + A_HANDLER, SIG_DFL)
        regio.write64(act(state, task, sig) + A_FLAGS, fl & (0xFFFFFFFFFFFFFFFF -% SA_RESETHAND))
    }
    var kc: u64 = taskslot.tget(state, task, taskconst.T_KILLCODE)
    var is_fault: bool = false
    var vec: u64 = 0
    if kc >= 128 && kc < 160 {
        is_fault = true
        vec = kc - 128
    }
    var zi: u64 = 0
    while zi < (SF_BYTES - SF_INFO) / 8 {
        poke64(state, task, base + SF_INFO + zi * 8, 0)
        zi = zi + 1
    }
    var code: u64 = 0
    var addr: u64 = 0
    let errw: u64 = __mmio_read64((ctx + C_ERROR) as *mut u64)
    if is_fault {
        if vec == 14 {
            addr = errw >> 16
            if (errw & 1) != 0 {
                code = 2
            } else {
                code = 1
            }
        } else {
            addr = __mmio_read64((ctx + C_RIP) as *mut u64)
            if vec == 0 || vec == 6 {
                code = 1
            } else {
                code = 128
            }
        }
    }
    var info_addr: u64 = addr
    if sig == SIGSYS && sigsysinfo.take(task) {
        code = SYS_SECCOMP_CODE
        info_addr = sigsysinfo.ip_of(task)
        poke64(state, task, base + SF_INFO + SI_CALL_NR_OFF, sigsysinfo.nr_of(task) | (AUDIT_ARCH_X86_64 << 32))
    }
    poke64(state, task, base + SF_INFO, sig)
    poke64(state, task, base + SF_INFO + 8, code)
    poke64(state, task, base + SF_INFO + 16, info_addr)
    let ucb: u64 = base + SF_UC
    poke64(state, task, ucb + 296, taskslot.tget(state, task, taskconst.T_SIGMASK))
    var gi: u64 = 0
    while gi < 18 {
        poke64(state, task, ucb + 40 + gi * 8, __mmio_read64((ctx + greg_off(gi)) as *mut u64))
        gi = gi + 1
    }
    poke64(state, task, ucb + 40 + 18 * 8, 0x33)
    poke64(state, task, ucb + 40 + 19 * 8, errw & 0xFFFF)
    poke64(state, task, ucb + 40 + 20 * 8, __mmio_read64((ctx + C_VECTOR) as *mut u64))
    poke64(state, task, ucb + 40 + 22 * 8, addr)
    if is_fault {
        taskslot.tset(state, task, taskconst.T_KILLCODE, 0)
    }
    __mmio_write64((ctx + C_RIP) as *mut u64, h)
    __mmio_write64((ctx + C_RSP) as *mut u64, ret)
    __mmio_write64((ctx + C_RDI) as *mut u64, sig)
    __mmio_write64((ctx + C_RSI) as *mut u64, base + SF_INFO)
    __mmio_write64((ctx + C_RDX) as *mut u64, ucb)
    taskslot.tset(state, task, taskconst.T_SIGDEL,
        taskslot.tget(state, task, taskconst.T_SIGDEL) + 1)
    kstate.add(state, kstate.SIG_CAUGHT, 1)
    kstate.add(state, kstate.SIG_DELIVERED, 1)
    return true
}

fn do_default(state: u64, task: u64, sig: u64) -> bool {
    let what: u64 = default_of(sig)
    kstate.add(state, kstate.SIG_DEFAULT, 1)
    kstate.add(state, kstate.SIG_DELIVERED, 1)
    if what == D_IGN || what == D_CONT {
        return true
    }
    if what == D_STOP {
        taskslot.tset(state, task, taskconst.T_STOPSIG, sig)
        kstate.add(state, kstate.SIG_STOPS, 1)
        exiting(state, task)
        sched.wake_pid(state, taskslot.tget(state, task, taskconst.T_PID))
        sched.stop_sleep(state, bit(SIGCONT))
        return true
    }
    if taskslot.tget(state, task, taskconst.T_KILLCODE) == 0 {
        var s_dead: [u8; 15] = "signal: pid=\0\0\0"
        var s_by: [u8; 8] = " SIG\0\0\0\0"
        var s_end: [u8; 11] = " -- killed\0"
        serial.puts((&s_dead[0]) as u64)
        serial.dec(taskslot.tget(state, task, taskconst.T_PID))
        serial.puts((&s_by[0]) as u64)
        say_name(sig)
        serial.puts((&s_end[0]) as u64)
        serial.nl()
    }
    let forced_plain: bool = (taskslot.tget(state, task, taskconst.T_KILLCODE) & taskconst.KILL_PLAIN) != 0
    if forced_plain {
        taskslot.tset(state, task, taskconst.T_SIGLAST, 0)
    } else {
        taskslot.tset(state, task, taskconst.T_SIGLAST, sig | 256)
    }
    kstate.add(state, kstate.KILLED, 1)
    if !sched.kill_requested(state, task) {
        sched.kill_group(state, task, 128 + sig)
    }
    exiting(state, task)
    var code: u64 = 128 + sig
    let forced: u64 = taskslot.tget(state, task, taskconst.T_KILLCODE)
    if forced != 0 {
        code = forced & (0xFFFFFFFFFFFFFFFF -% (taskconst.KILL_SET | taskconst.KILL_PLAIN))
        taskslot.tset(state, task, taskconst.T_KILLCODE, 0)
    }
    sched.exit_task(state, code)
    return false
}

fn next_signal(state: u64, task: u64) -> u64 {
    let d: u64 = deliverable(state, task)
    if d == 0 {
        return 0
    }
    var s: u64 = 1
    while s < NSIG {
        if (d & bit(s)) != 0 {
            return s
        }
        s = s + 1
    }
    return 0
}

fn dispatch_signal(state: u64, task: u64, sig: u64, ctx: u64, restart_nr: u64) -> bool {
    taskslot.tset(state, task, taskconst.T_SIGLAST, sig)
    let h: u64 = handler_of(state, task, sig)
    if uncatchable(sig) {
        do_default(state, task, sig)
        return false
    }
    if h == SIG_IGN {
        kstate.add(state, kstate.SIG_DELIVERED, 1)
        return false
    }
    if h == SIG_DFL {
        do_default(state, task, sig)
        return false
    }
    if deliver(state, task, sig, ctx, restart_nr) {
        return true
    }
    do_default(state, task, SIGSEGV)
    return false
}

fn run_pending(state: u64, task: u64, ctx: u64, restart_nr: u64) -> bool {
    if kstate.mode_on(state, kstate.M_NOSIG) {
        return false
    }
    var rounds: u64 = 0
    while rounds < NSIG {
        let raw: u64 = next_signal(state, task)
        if raw == 0 {
            return false
        }
        taskslot.tset(state, task, taskconst.T_SIGPEND,
            taskslot.tget(state, task, taskconst.T_SIGPEND)
            & (0xFFFFFFFFFFFFFFFF -% bit(raw)))
        notify_tracer(state, task, raw)
        let sig: u64 = ptrace.signal_stop(state, task, raw)
        reload_ctx(task, ctx)
        if sig != 0 && dispatch_signal(state, task, sig, ctx, restart_nr) {
            return true
        }
        rounds = rounds + 1
    }
    return false
}

fn notify_tracer(state: u64, task: u64, sig: u64) {
    if !ptstate.traced(task) || sig == SIGKILL {
        return
    }
    send_task(state, ptstate.tracer_slot(task), SIGCHLD)
}

fn reload_ctx(task: u64, ctx: u64) {
    if !ptstate.traced(task) {
        return
    }
    let frame: u64 = ptstate.get(task, ptstate.F_FRAME)
    if frame == 0 || frame == ctx || ptstate.get(task, ptstate.F_LAYOUT) != ptrace.LAYOUT_SYSCALL {
        return
    }
    load_ctx(frame, ctx)
}

fn load_ctx(frame: u64, c: u64) {
    var i: u64 = 0
    while i < C_WORDS {
        __mmio_write64((c + i * 8) as *mut u64, 0)
        i = i + 1
    }
    __mmio_write64((c + 0) as *mut u64, __mmio_read64((frame + F_R15) as *mut u64))
    __mmio_write64((c + 8) as *mut u64, __mmio_read64((frame + F_R14) as *mut u64))
    __mmio_write64((c + 16) as *mut u64, __mmio_read64((frame + F_R13) as *mut u64))
    __mmio_write64((c + 24) as *mut u64, __mmio_read64((frame + F_R12) as *mut u64))
    __mmio_write64((c + C_R10) as *mut u64, __mmio_read64((frame + F_R10) as *mut u64))
    __mmio_write64((c + 48) as *mut u64, __mmio_read64((frame + F_R9) as *mut u64))
    __mmio_write64((c + 56) as *mut u64, __mmio_read64((frame + F_R8) as *mut u64))
    __mmio_write64((c + C_RDI) as *mut u64, __mmio_read64((frame + F_RDI) as *mut u64))
    __mmio_write64((c + C_RSI) as *mut u64, __mmio_read64((frame + F_RSI) as *mut u64))
    __mmio_write64((c + 80) as *mut u64, __mmio_read64((frame + F_RBP) as *mut u64))
    __mmio_write64((c + 88) as *mut u64, __mmio_read64((frame + F_RBX) as *mut u64))
    __mmio_write64((c + C_RDX) as *mut u64, __mmio_read64((frame + F_RDX) as *mut u64))
    __mmio_write64((c + C_RAX) as *mut u64, __mmio_read64((frame + F_RAX) as *mut u64))
    __mmio_write64((c + C_RIP) as *mut u64, __mmio_read64((frame + F_RIP) as *mut u64))
    __mmio_write64((c + C_CS) as *mut u64, USER_CS)
    __mmio_write64((c + C_RFLAGS) as *mut u64, __mmio_read64((frame + F_RFLAGS) as *mut u64))
    __mmio_write64((c + C_RSP) as *mut u64, __mmio_read64((frame + F_RSP) as *mut u64))
    __mmio_write64((c + C_SS) as *mut u64, USER_SS)
}

fn restart_number(number: u64, frame: u64) -> u64 {
    if sigrestart.interrupted_result(__mmio_read64((frame + F_RAX) as *mut u64)) && sigrestart.restartable(number, __mmio_read64((frame + F_RSI) as *mut u64)) {
        return number
    }
    return sigrestart.NO_RESTART
}

fn restart_in_frame(frame: u64, number: u64) {
    __mmio_write64((frame + F_RIP) as *mut u64, sigrestart.rewind_target(__mmio_read64((frame + F_RIP) as *mut u64)))
    __mmio_write64((frame + F_RAX) as *mut u64, number)
}

fn check_sys(state: u64, task: u64, frame: u64, number: u64) {
    if taskslot.tget(state, task, taskconst.T_KIND) != taskconst.K_USER {
        return
    }
    if deliverable(state, task) == 0 {
        suspend_done(state, task)
        return
    }
    let c: u64 = ctx_of(state, task)
    load_ctx(frame, c)
    ptrace.note_frame(task, frame, ptrace.LAYOUT_SYSCALL)
    let restart_nr: u64 = restart_number(number, frame)
    if !run_pending(state, task, c, restart_nr) {
        if restart_nr != sigrestart.NO_RESTART {
            restart_in_frame(frame, restart_nr)
        }
        suspend_done(state, task)
        return
    }
    __mmio_write64((frame + F_RIP) as *mut u64, __mmio_read64((c + C_RIP) as *mut u64))
    __mmio_write64((frame + F_RSP) as *mut u64, __mmio_read64((c + C_RSP) as *mut u64))
    __mmio_write64((frame + F_RDI) as *mut u64, __mmio_read64((c + C_RDI) as *mut u64))
    __mmio_write64((frame + F_RSI) as *mut u64, __mmio_read64((c + C_RSI) as *mut u64))
    __mmio_write64((frame + F_RDX) as *mut u64, __mmio_read64((c + C_RDX) as *mut u64))
}

fn check_trap(state: u64, task: u64, frame: u64) {
    if taskslot.tget(state, task, taskconst.T_KIND) != taskconst.K_USER {
        return
    }
    let cs: u64 = __mmio_read64((frame + C_CS) as *mut u64)
    if (cs & 3) != 3 {
        return
    }
    if deliverable(state, task) == 0 {
        return
    }
    ptrace.note_frame(task, frame, ptrace.LAYOUT_TRAP)
    run_pending(state, task, frame, sigrestart.NO_RESTART)
}


fn do_sigaction(state: u64, task: u64, sig: u64, na: u64, oa: u64) -> u64 {
    if sig == 0 || sig >= NSIG {
        return neg(errno.E_INVAL)
    }
    if uncatchable(sig) && na != 0 {
        return neg(errno.E_INVAL)
    }
    if oa != 0 {
        if !procfault.user_ok(state, task, oa, 32) {
            return neg(errno.E_FAULT)
        }
        poke64(state, task, oa + 0, regio.read64(act(state, task, sig) + A_HANDLER))
        poke64(state, task, oa + 8, regio.read64(act(state, task, sig) + A_FLAGS))
        poke64(state, task, oa + 16, 0)
        poke64(state, task, oa + 24, regio.read64(act(state, task, sig) + A_MASK))
    }
    if na != 0 {
        if !procfault.user_ok(state, task, na, 32) {
            return neg(errno.E_FAULT)
        }
        let h: u64 = peek64(state, task, na + 0)
        let f: u64 = peek64(state, task, na + 8)
        let m: u64 = peek64(state, task, na + 24)
        regio.write64(act(state, task, sig) + A_HANDLER, h)
        regio.write64(act(state, task, sig) + A_FLAGS, f)
        regio.write64(act(state, task, sig) + A_MASK, m)
        if h == SIG_IGN {
            taskslot.tset(state, task, taskconst.T_SIGPEND,
                taskslot.tget(state, task, taskconst.T_SIGPEND)
                & (0xFFFFFFFFFFFFFFFF -% bit(sig)))
        }
    }
    return 0
}

fn do_sigprocmask(state: u64, task: u64, how: u64, set: u64,
    old: u64) -> u64 {
    if old != 0 {
        if !procfault.user_ok(state, task, old, 8) {
            return neg(errno.E_FAULT)
        }
        poke64(state, task, old, taskslot.tget(state, task, taskconst.T_SIGMASK))
    }
    if set == 0 {
        return 0
    }
    if !procfault.user_ok(state, task, set, 8) {
        return neg(errno.E_FAULT)
    }
    let v: u64 = peek64(state, task, set)
    var m: u64 = taskslot.tget(state, task, taskconst.T_SIGMASK)
    if how == SIG_BLOCK {
        m = m | v
    } else {
        if how == SIG_UNBLOCK {
            m = m & (0xFFFFFFFFFFFFFFFF -% v)
        } else {
            if how == SIG_SETMASK {
                m = v
            } else {
                return neg(errno.E_INVAL)
            }
        }
    }
    m = m & (0xFFFFFFFFFFFFFFFF -% (bit(SIGKILL) | bit(SIGSTOP)))
    taskslot.tset(state, task, taskconst.T_SIGMASK, m)
    return 0
}

fn do_sigpending(state: u64, task: u64, out: u64) -> u64 {
    if !procfault.user_ok(state, task, out, 8) {
        return neg(errno.E_FAULT)
    }
    poke64(state, task, out, taskslot.tget(state, task, taskconst.T_SIGPEND))
    return 0
}

fn do_sigreturn(state: u64, task: u64, frame: u64) -> u64 {
    let base: u64 = __mmio_read64((frame + F_RSP) as *mut u64)
    let noted: u64 = taskslot.tget(state, task, taskconst.T_SIGRET)
    if noted == 0 || base != noted {
        return neg(errno.E_FAULT)
    }
    if !procfault.user_ok(state, task, base, SF_BYTES) {
        return neg(errno.E_FAULT)
    }
    if peek64(state, task, base + SF_MAGIC) != MAGIC {
        return neg(errno.E_FAULT)
    }
    let c: u64 = ctx_of(state, task)
    var i: u64 = 0
    while i < C_WORDS {
        __mmio_write64((c + i * 8) as *mut u64,
            peek64(state, task, base + SF_CTX + i * 8))
        i = i + 1
    }
    var gk: u64 = 0
    while gk < 18 {
        __mmio_write64((c + greg_off(gk)) as *mut u64, peek64(state, task, base + SF_UC + 40 + gk * 8))
        gk = gk + 1
    }
    let fl: u64 = __mmio_read64((c + C_RFLAGS) as *mut u64)
    __mmio_write64((c + C_RFLAGS) as *mut u64, (fl & 0x00000CD5) | 0x202)
    __mmio_write64((c + C_CS) as *mut u64, USER_CS)
    __mmio_write64((c + C_SS) as *mut u64, USER_SS)
    taskslot.tset(state, task, taskconst.T_SIGMASK,
        peek64(state, task, base + SF_MASK)
        & (0xFFFFFFFFFFFFFFFF -% (bit(SIGKILL) | bit(SIGSTOP))))
    taskslot.tset(state, task, taskconst.T_SIGRET, 0)
    ptrace.note_frame(task, c, ptrace.LAYOUT_TRAP)
    run_pending(state, task, c, sigrestart.NO_RESTART)
    asm("call rax", in("rax") vector(state, V_IRET), in("rdi") c,
        clobber("memory"))
    return 0
}

fn do_kill(state: u64, task: u64, pid: u64, sig: u64) -> u64 {
    if sig >= NSIG {
        return neg(errno.E_INVAL)
    }
    if (pid & 0x8000000000000000) == 0 && pid != 0 {
        let z: u64 = sched.find_pid(state, pid)
        if z < kstate.MAX_TASKS {
            if !ctr.may_signal(state, task, z) {
                ctr.note_escape(state)
                return neg(errno.E_SRCH)
            }
        }
    }
    if pid == 0 {
        let g: u64 = taskslot.tget(state, task, taskconst.T_PGID)
        if send_pgid_from(state, task, g, sig) == 0 {
            return neg(errno.E_SRCH)
        }
        return 0
    }
    if (pid & 0x8000000000000000) != 0 {
        let g: u64 = 0 -% pid
        if g == 1 {
            let n: u64 = kstate.get(state, kstate.TASKS)
            var i: u64 = 0
            var hit: u64 = 0
            while i < n {
                if i != task && taskslot.tget(state, i, taskconst.T_KIND) == taskconst.K_USER {
                    if ctr.may_signal(state, task, i) {
                        if send_task(state, i, sig) {
                            hit = hit + 1
                        }
                    }
                }
                i = i + 1
            }
            if hit == 0 {
                return neg(errno.E_SRCH)
            }
            return 0
        }
        if send_pgid_from(state, task, g, sig) == 0 {
            return neg(errno.E_SRCH)
        }
        return 0
    }
    return send_pid(state, pid, sig)
}

fn do_pause(state: u64, task: u64) -> u64 {
    var rounds: u64 = 0
    while rounds < 6000 {
        if deliverable(state, task) != 0 {
            return neg(errno.E_INTR)
        }
        sched.sleep_ticks(state, 1)
        rounds = rounds + 1
    }
    return neg(errno.E_INTR)
}

fn do_alarm(state: u64, task: u64, secs: u64) -> u64 {
    let now: u64 = kstate.get(state, kstate.TICKS)
    let old: u64 = taskslot.tget(state, task, taskconst.T_ALARM)
    var left: u64 = 0
    if old > now {
        left = (old -% now) / 100
    }
    taskslot.tset(state, task, taskconst.T_ITIV, 0)
    if secs == 0 {
        taskslot.tset(state, task, taskconst.T_ALARM, 0)
    } else {
        taskslot.tset(state, task, taskconst.T_ALARM, now +% (secs *% 100))
    }
    return left
}


fn do_setpgid(state: u64, task: u64, pid: u64, pgid: u64) -> u64 {
    var t: u64 = task
    if pid != 0 {
        t = sched.find_pid(state, pid)
        if t >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
    }
    var g: u64 = pgid
    if g == 0 {
        g = taskslot.tget(state, t, taskconst.T_PID)
    }
    if taskslot.tget(state, t, taskconst.T_SID) != taskslot.tget(state, task, taskconst.T_SID) {
        return neg(errno.E_PERM)
    }
    taskslot.tset(state, t, taskconst.T_PGID, g)
    return 0
}

fn do_getpgid(state: u64, task: u64, pid: u64) -> u64 {
    var t: u64 = task
    if pid != 0 {
        t = sched.find_pid(state, pid)
        if t >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
    }
    return taskslot.tget(state, t, taskconst.T_PGID)
}

fn do_setsid(state: u64, task: u64) -> u64 {
    let pid: u64 = taskslot.tget(state, task, taskconst.T_PID)
    if taskslot.tget(state, task, taskconst.T_PGID) == pid
    && taskslot.tget(state, task, taskconst.T_SID) == pid {
        return neg(errno.E_PERM)
    }
    taskslot.tset(state, task, taskconst.T_SID, pid)
    taskslot.tset(state, task, taskconst.T_PGID, pid)
    taskslot.tset(state, task, taskconst.T_TTY, 0)
    return pid
}


fn suspend_done(state: u64, task: u64) {
    if taskslot.tget(state, task, taskconst.T_SUSP) != 0 {
        taskslot.tset(state, task, taskconst.T_SIGMASK, taskslot.tget(state, task, taskconst.T_SUSPMASK))
        taskslot.tset(state, task, taskconst.T_SUSP, 0)
    }
}

fn tv_ticks(sec: u64, usec: u64) -> u64 {
    if sec == 0 && usec == 0 {
        return 0
    }
    var s: u64 = sec
    if s > 100000000 {
        s = 100000000
    }
    let t: u64 = (s * 1000 + (usec + 999) / 1000 + 9) / 10
    if t == 0 {
        return 1
    }
    return t
}

fn put_tv(state: u64, task: u64, addr: u64, ticks: u64) {
    let ms: u64 = ticks * 10
    poke64(state, task, addr, ms / 1000)
    poke64(state, task, addr + 8, (ms % 1000) * 1000)
}

fn put_itimer(state: u64, task: u64, addr: u64) {
    let now: u64 = kstate.get(state, kstate.TICKS)
    let due: u64 = taskslot.tget(state, task, taskconst.T_ALARM)
    var left: u64 = 0
    if due > now {
        left = due - now
    }
    put_tv(state, task, addr, taskslot.tget(state, task, taskconst.T_ITIV))
    put_tv(state, task, addr + 16, left)
}

fn do_getitimer(state: u64, task: u64, which: u64, cur: u64) -> u64 {
    if which != 0 {
        return neg(errno.E_INVAL)
    }
    if !procfault.user_ok(state, task, cur, 32) {
        return neg(errno.E_FAULT)
    }
    put_itimer(state, task, cur)
    return 0
}

fn do_setitimer(state: u64, task: u64, which: u64, newp: u64, oldp: u64) -> u64 {
    if which != 0 {
        return neg(errno.E_INVAL)
    }
    if !procfault.user_ok(state, task, newp, 32) {
        return neg(errno.E_FAULT)
    }
    if oldp != 0 {
        if !procfault.user_ok(state, task, oldp, 32) {
            return neg(errno.E_FAULT)
        }
        put_itimer(state, task, oldp)
    }
    let isec: u64 = peek64(state, task, newp)
    let iusec: u64 = peek64(state, task, newp + 8)
    let vsec: u64 = peek64(state, task, newp + 16)
    let vusec: u64 = peek64(state, task, newp + 24)
    if iusec >= 1000000 || vusec >= 1000000 || isec >= 0x8000000000000000 || vsec >= 0x8000000000000000 {
        return neg(errno.E_INVAL)
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    let val: u64 = tv_ticks(vsec, vusec)
    if val == 0 {
        taskslot.tset(state, task, taskconst.T_ALARM, 0)
        taskslot.tset(state, task, taskconst.T_ITIV, 0)
        return 0
    }
    taskslot.tset(state, task, taskconst.T_ITIV, tv_ticks(isec, iusec))
    taskslot.tset(state, task, taskconst.T_ALARM, now +% val)
    return 0
}

fn do_sigaltstack(state: u64, task: u64, ss: u64, old: u64) -> u64 {
    let sp: u64 = taskslot.tget(state, task, taskconst.T_ALTSP)
    let sz: u64 = taskslot.tget(state, task, taskconst.T_ALTSZ)
    if old != 0 {
        if !procfault.user_ok(state, task, old, 24) {
            return neg(errno.E_FAULT)
        }
        var fl: u64 = 0
        if sz == 0 {
            fl = 2
        } else {
            let rsp: u64 = taskslot.tget(state, task, taskconst.T_SIGRET)
            if rsp != 0 && rsp >= sp && rsp < sp +% sz {
                fl = 1
            }
        }
        poke64(state, task, old, sp)
        poke64(state, task, old + 8, fl)
        poke64(state, task, old + 16, sz)
    }
    if ss != 0 {
        if !procfault.user_ok(state, task, ss, 24) {
            return neg(errno.E_FAULT)
        }
        let nsp: u64 = peek64(state, task, ss)
        let nfl: u64 = peek64(state, task, ss + 8) & 0xFFFFFFFF
        let nsz: u64 = peek64(state, task, ss + 16)
        if (nfl & 2) != 0 {
            taskslot.tset(state, task, taskconst.T_ALTSZ, 0)
            return 0
        }
        if nsz < 2048 {
            return neg(errno.E_NOMEM)
        }
        taskslot.tset(state, task, taskconst.T_ALTSP, nsp)
        taskslot.tset(state, task, taskconst.T_ALTSZ, nsz)
    }
    return 0
}

fn do_sigtimedwait(state: u64, task: u64, setp: u64, infop: u64, tsp: u64, size: u64) -> u64 {
    if size != 8 {
        return neg(errno.E_INVAL)
    }
    if !procfault.user_ok(state, task, setp, 8) {
        return neg(errno.E_FAULT)
    }
    let want: u64 = peek64(state, task, setp) & (0xFFFFFFFFFFFFFFFF -% (bit(SIGKILL) | bit(SIGSTOP)))
    var forever: bool = true
    var left: u64 = 0
    if tsp != 0 {
        if !procfault.user_ok(state, task, tsp, 16) {
            return neg(errno.E_FAULT)
        }
        let sec: u64 = peek64(state, task, tsp)
        let nsec: u64 = peek64(state, task, tsp + 8)
        if nsec >= 1000000000 || sec > 0x7FFFFFFFFFFFFFFF {
            return neg(errno.E_INVAL)
        }
        forever = false
        var s2: u64 = sec
        if s2 > 86400 {
            s2 = 86400
        }
        left = s2 * 100 + (nsec + 9999999) / 10000000
    }
    if infop != 0 && !procfault.user_ok(state, task, infop, 128) {
        return neg(errno.E_FAULT)
    }
    while true {
        let hit: u64 = taskslot.tget(state, task, taskconst.T_SIGPEND) & want
        if hit != 0 {
            var sig: u64 = 1
            while sig < NSIG && (hit & bit(sig)) == 0 {
                sig = sig + 1
            }
            taskslot.tset(state, task, taskconst.T_SIGPEND,
                taskslot.tget(state, task, taskconst.T_SIGPEND) & (0xFFFFFFFFFFFFFFFF -% bit(sig)))
            if infop != 0 {
                var k: u64 = 0
                while k < 16 {
                    poke64(state, task, infop + k * 8, 0)
                    k = k + 1
                }
                poke64(state, task, infop, sig)
                if (timer_marks[task as usize] & bit(sig)) != 0 {
                    poke64(state, task, infop + 8, SI_TIMER_CODE)
                }
            }
            return sig
        }
        if deliverable(state, task) != 0 {
            return neg(errno.E_INTR)
        }
        if !forever {
            if left == 0 {
                return neg(errno.E_AGAIN)
            }
            left = left - 1
        }
        sched.sleep_ticks(state, 1)
    }
    return neg(errno.E_AGAIN)
}

fn do_sigsuspend(state: u64, task: u64, maskp: u64, size: u64) -> u64 {
    if size != 8 {
        return neg(errno.E_INVAL)
    }
    if !procfault.user_ok(state, task, maskp, 8) {
        return neg(errno.E_FAULT)
    }
    let tmp: u64 = peek64(state, task, maskp) & (0xFFFFFFFFFFFFFFFF -% (bit(SIGKILL) | bit(SIGSTOP)))
    taskslot.tset(state, task, taskconst.T_SUSPMASK, taskslot.tget(state, task, taskconst.T_SIGMASK))
    taskslot.tset(state, task, taskconst.T_SUSP, 1)
    taskslot.tset(state, task, taskconst.T_SIGMASK, tmp)
    var rounds: u64 = 0
    while rounds < 6000 {
        if deliverable(state, task) != 0 {
            return neg(errno.E_INTR)
        }
        sched.sleep_ticks(state, 1)
        rounds = rounds + 1
    }
    suspend_done(state, task)
    return neg(errno.E_INTR)
}
