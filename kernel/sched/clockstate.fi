profile kernel

import lib.kstate
import sched.time
import ntp.bounds
import ntp.abi

export {
    CS_UNSET, CS_FROM_RTC, CS_SET,
    state_of, trusted,
}

const CS_UNSET: u64 = 0
const CS_FROM_RTC: u64 = 1
const CS_SET: u64 = 2

fn state_of(state: u64) -> u64 {
    if time.clock_moved_get(state) != 0 {
        return CS_SET
    }
    let now: u64 = time.now_sec(state)
    if now >= bounds.FLOOR_UTC && now <= bounds.CEILING_UTC {
        return CS_FROM_RTC
    }
    return CS_UNSET
}

fn trusted(state: u64) -> bool {
    return state_of(state) != CS_UNSET
}
