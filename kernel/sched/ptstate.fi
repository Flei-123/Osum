import lib.kstate
import sched.taskconst
import sched.taskslot

export {
    get, set, clear, cell, traced, tracer_slot, find_report, claim_fresh, reportable, tracee_count,
    F_TRACER, F_HOLD, F_FRESH, F_CODE, F_MODE, F_INJECT, F_OPTS, F_FRAME, F_LAYOUT, F_ORIG, F_KIND, F_SEIZED, F_EVENT, F_INTERRUPT, F_ZREP, F_INITSTOP, F_PENDEV,
    MODE_CONT, MODE_SYSCALL, MODE_STEP, KIND_SIGNAL, KIND_ENTER, KIND_EXIT, KILL_BIT
}

const FIELDS: u64 = 18
const SLOTS: u64 = 256

const F_TRACER: u64 = 0
const F_HOLD: u64 = 1
const F_FRESH: u64 = 2
const F_CODE: u64 = 3
const F_MODE: u64 = 4
const F_INJECT: u64 = 5
const F_OPTS: u64 = 6
const F_FRAME: u64 = 7
const F_LAYOUT: u64 = 8
const F_ORIG: u64 = 9
const F_KIND: u64 = 10
const F_SEIZED: u64 = 11
const F_EVENT: u64 = 12
const F_INTERRUPT: u64 = 13
const F_ZREP: u64 = 14
const F_INITSTOP: u64 = 15
const F_PENDEV: u64 = 16

const MODE_CONT: u64 = 0
const MODE_SYSCALL: u64 = 1
const MODE_STEP: u64 = 2

const KIND_SIGNAL: u64 = 0
const KIND_ENTER: u64 = 1
const KIND_EXIT: u64 = 2

const KILL_BIT: u64 = 256

static mut table: [u64; 4608] = [0 as u64; 4608]

fn get(slot: u64, field: u64) -> u64 {
    if slot >= SLOTS {
        return 0
    }
    return table[(slot * FIELDS + field) as usize]
}

fn set(slot: u64, field: u64, value: u64) {
    if slot >= SLOTS {
        return
    }
    table[(slot * FIELDS + field) as usize] = value
}

fn clear(slot: u64) {
    var field: u64 = 0
    while field < FIELDS {
        set(slot, field, 0)
        field = field + 1
    }
}

fn cell(slot: u64) -> u64 {
    return (&table[(slot * FIELDS + F_HOLD) as usize]) as u64
}

fn traced(slot: u64) -> bool {
    return get(slot, F_TRACER) != 0
}

fn tracer_slot(slot: u64) -> u64 {
    let t: u64 = get(slot, F_TRACER)
    if t == 0 {
        return SLOTS
    }
    return t - 1
}

fn wanted(state: u64, slot: u64, tracer: u64, want: u64) -> bool {
    if get(slot, F_TRACER) != tracer + 1 {
        return false
    }
    return want == 0 || taskslot.tget(state, slot, taskconst.T_PID) == want
}

fn reportable(slot: u64) -> bool {
    return (get(slot, F_HOLD) != 0 && get(slot, F_FRESH) != 0) || get(slot, F_ZREP) != 0
}

fn find_report(state: u64, tracer: u64, want: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if wanted(state, i, tracer, want) && reportable(i) {
            return i
        }
        i = i + 1
    }
    return SLOTS
}

fn claim_fresh(slot: u64) -> u64 {
    if get(slot, F_FRESH) == 0 {
        return 0
    }
    set(slot, F_FRESH, 0)
    return get(slot, F_CODE)
}

fn tracee_count(state: u64, tracer: u64, want: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var count: u64 = 0
    var i: u64 = 0
    while i < n {
        if wanted(state, i, tracer, want) {
            count = count + 1
        }
        i = i + 1
    }
    return count
}
