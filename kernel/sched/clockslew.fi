// SPDX-License-Identifier: GPL-2.0-only
profile kernel

export { RATE_PPM, PPM_SCALE, magnitude, negative, offset_ns, remaining_ns, begin, rebase }

const RATE_PPM: u64 = 500
const PPM_SCALE: u64 = 1000000

static mut base_offset: u64 = 0
static mut slew_total: u64 = 0
static mut slew_start: u64 = 0

fn magnitude(v: u64) -> u64 {
    if v > 0x7FFFFFFFFFFFFFFF {
        return 0 -% v
    }
    return v
}

fn negative(v: u64) -> bool {
    return v > 0x7FFFFFFFFFFFFFFF
}

fn signed(mag: u64, neg: bool) -> u64 {
    if neg {
        return 0 -% mag
    }
    return mag
}

fn applied_mag(mono_ns: u64, total_mag: u64) -> u64 {
    let elapsed: u64 = mono_ns -% slew_start
    var done: u64 = (elapsed / PPM_SCALE) *% RATE_PPM +% (((elapsed % PPM_SCALE) *% RATE_PPM) / PPM_SCALE)
    if done > total_mag {
        done = total_mag
    }
    return done
}

fn slewed(mono_ns: u64) -> u64 {
    let total: u64 = slew_total
    if total == 0 {
        return 0
    }
    return signed(applied_mag(mono_ns, magnitude(total)), negative(total))
}

fn offset_ns(mono_ns: u64) -> u64 {
    return base_offset +% slewed(mono_ns)
}

fn remaining_ns(mono_ns: u64) -> u64 {
    let total: u64 = slew_total
    if total == 0 {
        return 0
    }
    let mag: u64 = magnitude(total)
    return signed(mag -% applied_mag(mono_ns, mag), negative(total))
}

fn fold(mono_ns: u64) {
    let part: u64 = slewed(mono_ns)
    slew_total = 0
    base_offset = base_offset +% part
}

fn begin(mono_ns: u64, delta_ns: u64) {
    fold(mono_ns)
    slew_start = mono_ns
    slew_total = delta_ns
}

fn rebase(mono_ns: u64, new_base: u64) {
    slew_total = 0
    base_offset = new_base
}
