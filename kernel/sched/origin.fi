
profile kernel

import lib.kstate
import sched.sched
import sched.taskslot
import fs.fs

export {
    LEN, LABEL_MAX, at, is_empty, clear, inherit, derive, set_self, byte_at,
    valid_char, same_app, probe, B_NONE, B_APP, B_SYSTEM,
}

const LEN: u64 = 32
const LABEL_MAX: u64 = 23

fn at(state: u64, t: u64) -> u64 {
    return taskslot.task_at(state, t) + sched.T_ORIGIN
}

fn byte_at(state: u64, t: u64, i: u64) -> u64 {
    if t >= kstate.MAX_TASKS || i >= LEN {
        return 0
    }
    return kstate.get8(at(state, t) + i)
}

fn is_empty(state: u64, t: u64) -> bool {
    if t >= kstate.MAX_TASKS {
        return true
    }
    return kstate.get8(at(state, t)) == 0
}

fn clear(state: u64, t: u64) {
    if t >= kstate.MAX_TASKS {
        return
    }
    var k: u64 = 0
    while k < LEN {
        kstate.set8(at(state, t) + k, 0 as u8)
        k = k + 1
    }
}

fn inherit(state: u64, parent: u64, child: u64) {
    if parent >= kstate.MAX_TASKS || child >= kstate.MAX_TASKS {
        return
    }
    var k: u64 = 0
    while k < LEN {
        kstate.set8(at(state, child) + k,
            kstate.get8(at(state, parent) + k) as u8)
        k = k + 1
    }
}

fn valid_char(c: u64) -> bool {
    if c >= 97 && c <= 122 {
        return true
    }
    if c >= 65 && c <= 90 {
        return true
    }
    if c >= 48 && c <= 57 {
        return true
    }
    return c == 46 || c == 95 || c == 45 || c == 58
}

fn put(state: u64, t: u64, i: u64, c: u64) {
    kstate.set8(at(state, t) + i, c as u8)
}

const B_NONE: u64 = 0
const B_APP: u64 = 1
const B_SYSTEM: u64 = 2

fn seg_end(path: u64) -> u64 {
    if kstate.get8(path) != 47 || kstate.get8(path + 1) != 97
        || kstate.get8(path + 2) != 112 || kstate.get8(path + 3) != 112
        || kstate.get8(path + 4) != 115 || kstate.get8(path + 5) != 47 {
        return 0
    }
    var e: u64 = 6
    var going: bool = true
    while going {
        let c: u64 = kstate.get8(path + e)
        if c == 0 || c == 47 || e > 6 + 200 {
            going = false
        } else {
            e = e + 1
        }
    }
    if kstate.get8(path + e) != 47 {
        return 0
    }
    return e
}

fn suffix_len(path: u64, e: u64) -> u64 {
    let seg: u64 = e - 6
    if seg >= 5 {
        let d: u64 = path + e - 5
        if kstate.get8(d) == 46 && kstate.get8(d + 1) == 112
            && kstate.get8(d + 2) == 114 && kstate.get8(d + 3) == 111
            && kstate.get8(d + 4) == 103 {
            return 5
        }
    }
    if seg >= 4 {
        let d2: u64 = path + e - 4
        if kstate.get8(d2) == 46 && kstate.get8(d2 + 1) == 111
            && kstate.get8(d2 + 2) == 115 && kstate.get8(d2 + 3) == 112 {
            return 4
        }
    }
    return 0
}

fn probe(state: u64, path: u64) -> u64 {
    let e: u64 = seg_end(path)
    if e == 0 {
        return B_NONE
    }
    let sl: u64 = suffix_len(path, e)
    if sl == 0 || e - 6 <= sl {
        return B_NONE
    }
    if e + 8 > 200 {
        return B_APP
    }
    var pb: [u8; 216] = [0 as u8; 216]
    let pp: u64 = (&pb[0 as usize]) as u64
    var k: u64 = 0
    while k <= e {
        kstate.set8(pp + k, kstate.get8(path + k) as u8)
        k = k + 1
    }
    kstate.set8(pp + e + 1, 83 as u8)
    kstate.set8(pp + e + 2, 89 as u8)
    kstate.set8(pp + e + 3, 83 as u8)
    kstate.set8(pp + e + 4, 84 as u8)
    kstate.set8(pp + e + 5, 69 as u8)
    kstate.set8(pp + e + 6, 77 as u8)
    kstate.set8(pp + e + 7, 0 as u8)
    let ino: u64 = fs.path(state, pp)
    if ino != 0 && fs.inode_uid(state, ino) == 0 {
        return B_SYSTEM
    }
    return B_APP
}

fn derive(state: u64, parent: u64, t: u64, path: u64, kind: u64) {
    if t >= kstate.MAX_TASKS {
        return
    }
    clear(state, t)
    if parent < kstate.MAX_TASKS && !is_empty(state, parent) {
        inherit(state, parent, t)
        return
    }
    if kind != B_APP {
        return
    }
    let e: u64 = seg_end(path)
    if e == 0 {
        return
    }
    let sl: u64 = suffix_len(path, e)
    if sl == 0 || e - 6 <= sl {
        return
    }
    let nlen: u64 = e - 6 - sl
    put(state, t, 0, 97)
    put(state, t, 1, 112)
    put(state, t, 2, 112)
    put(state, t, 3, 58)
    var ok: bool = nlen <= LABEL_MAX - 4
    var k: u64 = 0
    while ok && k < nlen {
        if !valid_char(kstate.get8(path + 6 + k)) {
            ok = false
        }
        k = k + 1
    }
    if !ok {
        put(state, t, 4, 63)
        put(state, t, 5, 0)
        return
    }
    k = 0
    while k < nlen {
        put(state, t, 4 + k, kstate.get8(path + 6 + k))
        k = k + 1
    }
    put(state, t, 4 + nlen, 0)
}

fn set_self(state: u64, me: u64, src: u64, n: u64) -> u64 {
    if me >= kstate.MAX_TASKS {
        return 1
    }
    if !is_empty(state, me) {
        return 1
    }
    if n == 0 || n > LABEL_MAX {
        return 2
    }
    var k: u64 = 0
    while k < n {
        if !valid_char(kstate.get8(src + k)) {
            return 2
        }
        k = k + 1
    }
    if n == 4 && kstate.get8(src) == 117 && kstate.get8(src + 1) == 115
        && kstate.get8(src + 2) == 101 && kstate.get8(src + 3) == 114 {
        return 2
    }
    k = 0
    while k < n {
        put(state, me, k, kstate.get8(src + k))
        k = k + 1
    }
    put(state, me, n, 0)
    return 0
}

fn same_app(state: u64, t: u64, name: u64, n: u64) -> bool {
    if is_empty(state, t) {
        return true
    }
    if byte_at(state, t, 0) != 97 || byte_at(state, t, 1) != 112
        || byte_at(state, t, 2) != 112 || byte_at(state, t, 3) != 58 {
        return false
    }
    if n + 4 >= LEN {
        return false
    }
    var k: u64 = 0
    while k < n {
        if byte_at(state, t, 4 + k) != kstate.get8(name + k) {
            return false
        }
        k = k + 1
    }
    return byte_at(state, t, 4 + n) == 0
}
