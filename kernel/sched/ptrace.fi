import sched.sched
import sched.ptstate
import sched.taskconst
import sched.taskslot
import libc.regio

export {
    note_frame, syscall_enter, syscall_exit, signal_stop, apply_step_flag, stops_enter, stops_exit,
    LAYOUT_SYSCALL, LAYOUT_TRAP, OPT_SYSGOOD, OPT_TRACEEXEC, SIGTRAP_NUM, ORIG_NONE, ENOSYS_RESULT
}

const SIGKILL_NUM: u64 = 9
const SIGTRAP_NUM: u64 = 5
const SYS_EXECVE: u64 = 59
const SYSGOOD_FLAG: u64 = 0x80
const EVENT_SHIFT: u64 = 8
const EVENT_EXEC: u64 = 4
const EVENT_STOP: u64 = 128
const SIGCONT_NUM: u64 = 18
const FAULT_CODE_FIRST: u64 = 128
const FAULT_CODE_END: u64 = 160

const OPT_SYSGOOD: u64 = 1
const OPT_TRACEEXEC: u64 = 16

const LAYOUT_SYSCALL: u64 = 0
const LAYOUT_TRAP: u64 = 1

const RFLAGS_SYSCALL: u64 = 112
const RFLAGS_TRAP: u64 = 152
const FLAG_TRAP: u64 = 0x100

const ORIG_NONE: u64 = 0xFFFFFFFFFFFFFFFF
const ENOSYS_RESULT: u64 = 0xFFFFFFFFFFFFFFDA

fn note_frame(task: u64, frame: u64, layout: u64) {
    if !ptstate.traced(task) {
        return
    }
    ptstate.set(task, ptstate.F_FRAME, frame)
    ptstate.set(task, ptstate.F_LAYOUT, layout)
}

fn flags_offset(layout: u64) -> u64 {
    if layout == LAYOUT_TRAP {
        return RFLAGS_TRAP
    }
    return RFLAGS_SYSCALL
}

fn apply_step_flag(task: u64, stepping: bool) {
    let frame: u64 = ptstate.get(task, ptstate.F_FRAME)
    if frame == 0 {
        return
    }
    let off: u64 = flags_offset(ptstate.get(task, ptstate.F_LAYOUT))
    var flags: u64 = regio.read64_at(frame, off)
    flags = flags & (0xFFFFFFFFFFFFFFFF -% FLAG_TRAP)
    if stepping {
        flags = flags | FLAG_TRAP
    }
    regio.write64_at(frame, off, flags)
}

fn stop(state: u64, task: u64, code: u64, kind: u64) -> u64 {
    ptstate.set(task, ptstate.F_CODE, code)
    ptstate.set(task, ptstate.F_KIND, kind)
    ptstate.set(task, ptstate.F_INJECT, 0)
    sched.ptrace_park(state)
    return ptstate.get(task, ptstate.F_INJECT)
}

fn syscall_code(task: u64) -> u64 {
    if (ptstate.get(task, ptstate.F_OPTS) & OPT_SYSGOOD) != 0 {
        return SIGTRAP_NUM | SYSGOOD_FLAG
    }
    return SIGTRAP_NUM
}

fn stops_enter(task: u64) -> bool {
    return ptstate.get(task, ptstate.F_MODE) == ptstate.MODE_SYSCALL
}

fn stops_exit(task: u64, number: u64, result: u64) -> bool {
    if stops_enter(task) {
        return true
    }
    return number == SYS_EXECVE && result == 0 && exec_code(task) != 0
}

fn syscall_enter(state: u64, task: u64, frame: u64, number: u64) -> u64 {
    if !stops_enter(task) {
        return number
    }
    note_frame(task, frame, LAYOUT_SYSCALL)
    ptstate.set(task, ptstate.F_ORIG, number)
    stop(state, task, syscall_code(task), ptstate.KIND_ENTER)
    return ptstate.get(task, ptstate.F_ORIG)
}

fn exec_code(task: u64) -> u64 {
    if (ptstate.get(task, ptstate.F_OPTS) & OPT_TRACEEXEC) != 0 {
        return SIGTRAP_NUM | (EVENT_EXEC << EVENT_SHIFT)
    }
    if ptstate.get(task, ptstate.F_SEIZED) != 0 {
        return 0
    }
    return SIGTRAP_NUM
}

fn syscall_exit(state: u64, task: u64, frame: u64, number: u64, result: u64) {
    note_frame(task, frame, LAYOUT_SYSCALL)
    if number == SYS_EXECVE && result == 0 {
        let code: u64 = exec_code(task)
        if code != 0 {
            ptstate.set(task, ptstate.F_ORIG, ORIG_NONE)
            stop(state, task, code, ptstate.KIND_SIGNAL)
        }
    }
    if !stops_enter(task) {
        return
    }
    ptstate.set(task, ptstate.F_ORIG, number)
    stop(state, task, syscall_code(task), ptstate.KIND_EXIT)
}

fn signal_stop(state: u64, task: u64, sig: u64) -> u64 {
    if !ptstate.traced(task) || sig == SIGKILL_NUM {
        return sig
    }
    ptstate.set(task, ptstate.F_ORIG, ORIG_NONE)
    if sig == SIGCONT_NUM && ptstate.get(task, ptstate.F_INTERRUPT) != 0 {
        ptstate.set(task, ptstate.F_INTERRUPT, 0)
        stop(state, task, SIGTRAP_NUM | (EVENT_STOP << EVENT_SHIFT), ptstate.KIND_SIGNAL)
        return 0
    }
    let inject: u64 = stop(state, task, sig, ptstate.KIND_SIGNAL)
    drop_fault_code(state, task, inject, sig)
    return inject
}

fn drop_fault_code(state: u64, task: u64, inject: u64, sig: u64) {
    let kc: u64 = taskslot.tget(state, task, taskconst.T_KILLCODE)
    if inject != sig && kc >= FAULT_CODE_FIRST && kc < FAULT_CODE_END {
        taskslot.tset(state, task, taskconst.T_KILLCODE, 0)
    }
}
