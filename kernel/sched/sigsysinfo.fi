export { put, take, nr_of, ip_of }

const SLOTS: u64 = 256

static mut armed: [u64; 256] = [0 as u64; 256]
static mut call_nr: [u64; 256] = [0 as u64; 256]
static mut call_ip: [u64; 256] = [0 as u64; 256]

fn put(task: u64, nr: u64, ip: u64) {
    if task >= SLOTS {
        return
    }
    call_nr[task as usize] = nr
    call_ip[task as usize] = ip
    armed[task as usize] = 1
}

fn take(task: u64) -> bool {
    if task >= SLOTS || armed[task as usize] == 0 {
        return false
    }
    armed[task as usize] = 0
    return true
}

fn nr_of(task: u64) -> u64 {
    return call_nr[task as usize]
}

fn ip_of(task: u64) -> u64 {
    return call_ip[task as usize]
}
