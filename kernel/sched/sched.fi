    init, create, start, schedule, on_tick, fast_tick, yield_now, sleep_ticks, sleep_fine, poll_sleep_fine, idle_wait,
    dead_sleeps, exit_task, reap, claim_zombie, reap_claimed, lock_gone, kill_current, wake_pid, wait_sleep,
    stopped_child, stop_claim, find_pid, current, stack_high, guard_faults, guard_last_pid, guard_last_depth,
    guard_broken, trace_push, trace_dump, dump_tasks, ready_count, alive_count, irq_save, irq_restore,
    set_kernel_stack, adopt, enter_task, set_idle, zombies, reap_all, free_slots, cpu_of, cpu_mask, clear_signals,
    set_affinity, affinity, ring3_foreign, gs_report, gs_ready, gs_error, ring3_cores, gs_expected, gs_check,
    kstack_here, kstack_again, ring3_all_set, ring3_all_get, hier, gs_lie_set, gs_lie_get, r3blind_set, r3blind_an,
    ring3_report, syscalls_of, syscalls_sum, core_count, ring3_procs, poll_seq, poll_kick, poll_kick_one,
    sleep_ticks_unless, wake_sleeper, poll_sleep, groups_count, groups_at, groups_has, groups_set, groups_clear,
    groups_inherit, session_identity, fpu_area, fpu_set_area, fpu_inherit, fpu_reset, fsbase_apply, state_cas,
    schedule_locked, kill_requested, stop_sleep, kill_other, group_of, group_live, kill_group,
    ptrace_park, ptrace_release
}

const GUARD_PAINT: u64 = 0xC0DEFACEC0DEFACE

const V_SWITCH: u64 = 55
const V_GUARD: u64 = 57
const V_TASK_MAIN: u64 = 62

fn vector(state: u64, i: u64) -> u64 {
    return __mmio_read64((kstate.get(state, kstate.VECTORS) + i * 8) as *mut u64)
}

fn state_cas(state: u64, i: u64, from: u64, to: u64) -> bool {
    if i >= kstate.MAX_TASKS {
        return false
    }
    let won: bool = atomic.cas(taskslot.task_at(state, i) + taskconst.T_STATE, from, to) == from
    if won && to == taskconst.S_READY {
        let ap_wake: u64 = policy.acct_addr(taskslot.task_at(state, i) + taskconst.T_ORIGIN, policy.A_WAKE)
        if ap_wake != 0 {
            atomic.fetch_add(ap_wake, 1)
        }
        kick_one(state, i)
    }
    return won
}

fn kill_requested(state: u64, i: u64) -> bool {
    return (taskslot.tget(state, i, taskconst.T_KILLCODE) & taskconst.KILL_SET) != 0
}

fn groups_slot(state: u64, i: u64, k: u64) -> u64 {
    return state + kstate.MU_OFF + kstate.MU_GRP
        + (i * kstate.MU_GRPMAX + k) * 8
}

fn groups_count(state: u64, i: u64) -> u64 {
    let n: u64 = taskslot.tget(state, i, taskconst.T_NGROUPS)
    if n > taskconst.GROUPS_MAX {
        return taskconst.GROUPS_MAX
    }
    return n
}

fn groups_at(state: u64, i: u64, k: u64) -> u64 {
    if k >= taskconst.GROUPS_MAX {
        return 0
    }
    return __mmio_read64(groups_slot(state, i, k) as *mut u64)
}

fn groups_has(state: u64, i: u64, gid: u64) -> bool {
    let n: u64 = groups_count(state, i)
    var k: u64 = 0
    while k < n {
        if groups_at(state, i, k) == gid {
            return true
        }
        k = k + 1
    }
    return false
}

fn groups_clear(state: u64, i: u64) {
    taskslot.tset(state, i, taskconst.T_NGROUPS, 0)
    var k: u64 = 0
    while k < taskconst.GROUPS_MAX {
        __mmio_write64(groups_slot(state, i, k) as *mut u64, 0)
        k = k + 1
    }
}

fn groups_set(state: u64, i: u64, src: u64, n: u64) -> bool {
    if n > taskconst.GROUPS_MAX {
        return false
    }
    groups_clear(state, i)
    var k: u64 = 0
    while k < n {
        __mmio_write64(groups_slot(state, i, k) as *mut u64,
            __mmio_read64((src + k * 8) as *mut u64))
        k = k + 1
    }
    taskslot.tset(state, i, taskconst.T_NGROUPS, n)
    return true
}

fn groups_inherit(state: u64, kind: u64, parent_kind: u64) {
    let n: u64 = groups_count(state, parent_kind)
    var k: u64 = 0
    while k < taskconst.GROUPS_MAX {
        var v: u64 = 0
        if k < n {
            v = groups_at(state, parent_kind, k)
        }
        __mmio_write64(groups_slot(state, kind, k) as *mut u64, v)
        k = k + 1
    }
    taskslot.tset(state, kind, taskconst.T_NGROUPS, n)
}

fn session_identity(state: u64, slot: u64) {
    let uid: u64 = kstate.get(state, kstate.K11_OFF + kstate.SP_UID)
    if uid == 0 {
        return
    }
    var donor: u64 = kstate.MAX_TASKS
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if i != slot && taskslot.tget(state, i, taskconst.T_STATE) != taskconst.S_FREE
            && taskslot.tget(state, i, taskconst.T_UID) == uid
            && taskslot.tget(state, i, taskconst.T_EUID) == uid
            && taskslot.tget(state, i, taskconst.T_SUID) == uid {
            donor = i
            i = n
        } else {
            i = i + 1
        }
    }
    taskslot.tset(state, slot, taskconst.T_UID, uid)
    taskslot.tset(state, slot, taskconst.T_EUID, uid)
    taskslot.tset(state, slot, taskconst.T_SUID, uid)
    if donor < kstate.MAX_TASKS {
        taskslot.tset(state, slot, taskconst.T_GID, taskslot.tget(state, donor, taskconst.T_GID))
        taskslot.tset(state, slot, taskconst.T_EGID, taskslot.tget(state, donor, taskconst.T_EGID))
        taskslot.tset(state, slot, taskconst.T_SGID, taskslot.tget(state, donor, taskconst.T_SGID))
        taskslot.tset(state, slot, taskconst.T_UMASK, taskslot.tget(state, donor, taskconst.T_UMASK))
        groups_inherit(state, slot, donor)
    } else {
        taskslot.tset(state, slot, taskconst.T_GID, uid)
        taskslot.tset(state, slot, taskconst.T_EGID, uid)
        taskslot.tset(state, slot, taskconst.T_SGID, uid)
        taskslot.tset(state, slot, taskconst.T_UMASK, 18)
        groups_clear(state, slot)
    }
}

fn current(state: u64) -> u64 {
    return *((state + kstate.CPU_OFF + cpu.here(state) * kstate.CPU_BYTES + cpu.C_CUR) as *mut u64)
}

const TC_CPU: u64 = 0
const TC_MASK: u64 = 8
const TC_AFF: u64 = 16

fn tc_set(state: u64, i: u64, field: u64, v: u64) {
    __mmio_write64((state + kstate.TCPU_OFF + i * kstate.TCPU_BYTES + field)
        as *mut u64, v)
}

fn tc_get(state: u64, i: u64, field: u64) -> u64 {
    return __mmio_read64((state + kstate.TCPU_OFF + i * kstate.TCPU_BYTES
            +field) as *mut u64)
}

fn cpu_of(state: u64, i: u64) -> u64 {
    return tc_get(state, i, TC_CPU)
}

fn cpu_mask(state: u64, i: u64) -> u64 {
    return tc_get(state, i, TC_MASK)
}

fn set_affinity(state: u64, i: u64, c: u64) {
    tc_set(state, i, TC_AFF, c)
}

fn affinity(state: u64, i: u64) -> u64 {
    return tc_get(state, i, TC_AFF)
}

fn may_run(state: u64, i: u64, me: u64) -> bool {
    let a: u64 = tc_get(state, i, TC_AFF)
    return a == taskconst.ANY_CPU || a == me
}

fn ring3_allowed(state: u64, i: u64, me: u64) -> bool {
    if taskslot.tget(state, i, taskconst.T_KIND) != taskconst.K_USER {
        return true
    }
    if r3blind != 0 {
        return true
    }
    if ring3_all == 0 {
        return me == 0
    }
    return me == 0 || gs_ready(state, me)
}

static mut ring3_all: u64 = 1
static mut gs_lie: u64 = 0
static mut r3blind: u64 = 0

fn gs_lie_set(v: u64) {
    gs_lie = v
}

fn gs_lie_get() -> u64 {
    return gs_lie
}

fn r3blind_set(v: u64) {
    r3blind = v
}

fn r3blind_an() -> u64 {
    return r3blind
}

fn ring3_all_set(v: u64) {
    ring3_all = v
}

fn ring3_all_get() -> u64 {
    return ring3_all
}

static mut gs_good: [u64; 8] = [0 as u64; 8]

fn gs_report(state: u64, me: u64, is_good: bool) {
    if me >= 8 {
        return
    }
    if is_good {
        gs_good[me as usize] = 1
    } else {
        gs_good[me as usize] = 2
    }
}

fn kstack_again(state: u64) {
    set_kernel_stack(state, taskslot.tget(state, current(state), taskconst.T_KTOP))
}

fn kstack_here(state: u64) -> u64 {
    return cpu.get(state, cpu.here(state), cpu.C_KSTACK)
}

fn hier(state: u64) -> u64 {
    return cpu.here(state)
}

fn gs_expected(state: u64) -> u64 {
    return cpu.record(state, cpu.here(state))
}

fn gs_check(state: u64, baseline: u64) -> bool {
    let me: u64 = cpu.here(state)
    let is_good: bool = baseline == cpu.record(state, me)
    gs_report(state, me, is_good)
    return is_good
}

fn gs_ready(state: u64, me: u64) -> bool {
    if me >= 8 {
        return false
    }
    return gs_good[me as usize] == 1
}

fn gs_error(state: u64) -> u64 {
    var i: u64 = 0
    var c: u64 = 0
    while i < 8 {
        if gs_good[i as usize] == 2 {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn ring3_cores(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var mask_union: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_KIND) == taskconst.K_USER {
            mask_union = mask_union | tc_get(state, i, TC_MASK)
        }
        i = i + 1
    }
    var c: u64 = 0
    var b: u64 = 0
    while b < 8 {
        if ((mask_union >> b) & 1) != 0 {
            c = c + 1
        }
        b = b + 1
    }
    return c
}

fn core_count(state: u64) -> u64 {
    return cpu.count(state)
}

fn syscalls_of(state: u64, k: u64) -> u64 {
    if k >= kstate.MAX_CPUS {
        return 0
    }
    return cpu.get(state, k, cpu.C_SYSCALLS)
}

fn syscalls_sum(state: u64) -> u64 {
    var k: u64 = 0
    var n: u64 = 0
    while k < cpu.count(state) {
        n = n + cpu.get(state, k, cpu.C_SYSCALLS)
        k = k + 1
    }
    return n
}

fn ring3_procs(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var c: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_KIND) == taskconst.K_USER
        && taskslot.tget(state, i, taskconst.T_STATE) != taskconst.S_FREE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn bits_in(v: u64) -> u64 {
    var b: u64 = 0
    var c: u64 = 0
    while b < 64 {
        if ((v >> b) & 1) != 0 {
            c = c + 1
        }
        b = b + 1
    }
    return c
}

fn ring3_report(state: u64) {
    var s_p: [u8; 9] = "r3: pid=\0"
    var s_k: [u8; 8] = "  core=\0"
    var s_m: [u8; 8] = "  mask=\0"
    var s_n: [u8; 5] = "  n=\0"
    var s_r: [u8; 9] = "  runs=\0\0"
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var all_mask: u64 = 0
    var proc_count: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_KIND) == taskconst.K_USER
        && taskslot.tget(state, i, taskconst.T_STATE) != taskconst.S_FREE {
            let m: u64 = tc_get(state, i, TC_MASK)
            all_mask = all_mask | m
            proc_count = proc_count + 1
            let z: u64 = serial.line_at()
            serial.puts((&s_p[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_PID))
            serial.puts((&s_k[0]) as u64)
            serial.dec(tc_get(state, i, TC_CPU))
            serial.puts((&s_m[0]) as u64)
            serial.hex(m)
            serial.puts((&s_n[0]) as u64)
            serial.dec(bits_in(m))
            serial.puts((&s_r[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_RUNS))
            serial.nl()
            serial.line_clear(z)
        }
        i = i + 1
    }
    let z2: u64 = serial.line_at()
    var s_g: [u8; 12] = "r3: procs=\0\0"
    var s_gk: [u8; 9] = "  cores=\0"
    var s_gn: [u8; 5] = "  n=\0"
    var s_gf: [u8; 12] = "  foreign=\0\0"
    var s_ga: [u8; 7] = "  all=\0"
    serial.puts((&s_g[0]) as u64)
    serial.dec(proc_count)
    serial.puts((&s_gk[0]) as u64)
    serial.hex(all_mask)
    serial.puts((&s_gn[0]) as u64)
    serial.dec(bits_in(all_mask))
    serial.puts((&s_gf[0]) as u64)
    serial.dec(ring3_foreign(state))
    serial.puts((&s_ga[0]) as u64)
    serial.dec(ring3_all)
    serial.nl()
    serial.line_clear(z2)
    let z3: u64 = serial.line_at()
    var s_s: [u8; 14] = "r3: syscalls \0"
    var s_c: [u8; 3] = " c\0"
    var s_e: [u8; 2] = "=\0"
    var s_su: [u8; 8] = "  sum=\0\0"
    var s_ab: [u8; 9] = "  diff=\0\0"
    serial.puts((&s_s[0]) as u64)
    let ks0: u64 = kstate.get(state, kstate.SYSCALLS)
    var k: u64 = 0
    var sum: u64 = 0
    while k < cpu.count(state) {
        let v: u64 = cpu.get(state, k, cpu.C_SYSCALLS)
        sum = sum + v
        serial.puts((&s_c[0]) as u64)
        serial.dec(k)
        serial.puts((&s_e[0]) as u64)
        serial.dec(v)
        k = k + 1
    }
    serial.puts((&s_su[0]) as u64)
    serial.dec(sum)
    serial.puts((&s_ab[0]) as u64)
    let ks1: u64 = kstate.get(state, kstate.SYSCALLS)
    let hi: u64 = ks1 + cpu.count(state)
    if sum < ks0 {
        serial.dec(ks0 - sum)
    } else if sum > hi {
        serial.dec(sum - hi)
    } else {
        serial.dec(0)
    }
    serial.nl()
    serial.line_clear(z3)
}

fn ring3_foreign(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var c: u64 = 0
    while i < n {
        let on_cpu: u64 = tc_get(state, i, TC_CPU)
        if taskslot.tget(state, i, taskconst.T_KIND) == taskconst.K_USER && on_cpu != 0
        && on_cpu < kstate.MAX_CPUS {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn irq_save() -> u64 {
    return asm("pushfq\npop rax\ncli", out("rax"))
}

fn irq_restore(flags: u64) {
    if (flags & 0x200) != 0 {
        asm("sti")
    }
}

fn trace_push(state: u64, v: u64) {
    let n: u64 = kstate.get(state, kstate.TRACE_LEN)
    if n < kstate.TRACE_MAX {
        kstate.set8(state + kstate.TRACE_OFF + n, (v & 0xFF) as u8)
        kstate.set(state, kstate.TRACE_LEN, n + 1)
    }
}

fn trace_dump(state: u64, label: u64, limit: u64) {
    var n: u64 = kstate.get(state, kstate.TRACE_LEN)
    if limit != 0 && n > limit {
        n = limit
    }
    serial.puts(label)
    var i: u64 = 0
    while i < n {
        serial.dec(kstate.get8(state + kstate.TRACE_OFF + i))
        serial.put(32 as u8)
        i = i + 1
    }
    serial.nl()
}

fn init(state: u64) {
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        taskslot.tset(state, i, taskconst.T_STATE, taskconst.S_FREE)
        i = i + 1
    }
    kstate.set(state, kstate.TASKS, 1)
    kstate.set(state, kstate.NEXT_PID, 2)
    var l: u64 = 0
    while l < kstate.LOCK_COUNT {
        atomic.lock_init(state, l)
        l = l + 1
    }
    var c: u64 = 0
    while c < kstate.MAX_CPUS {
        cpu.set(state, c, cpu.C_CUR, 0)
        c = c + 1
    }
    kstate.set(state, kstate.PREEMPT, 1)
    taskslot.tset(state, 0, taskconst.T_STATE, taskconst.S_RUN)
    taskslot.tset(state, 0, taskconst.T_PID, 1)
    taskslot.tset(state, 0, taskconst.T_PRIO, 2)
    taskslot.tset(state, 0, taskconst.T_BUDGET, 2)
    taskslot.tset(state, 0, taskconst.T_KIND, taskconst.K_BOOT)
    taskslot.tset(state, 0, taskconst.T_PGID, 1)
    taskslot.tset(state, 0, taskconst.T_SID, 1)
    taskslot.tset(state, 0, taskconst.T_TGID, 1)
    taskslot.tset(state, 0, taskconst.T_KTOP, vector(state, 61))
    taskslot.tset(state, 0, taskconst.T_CR3, kstate.get(state, kstate.KPML4))
    var t: u64 = 0
    while t < kstate.MAX_TASKS {
        tc_set(state, t, TC_AFF, taskconst.ANY_CPU)
        t = t + 1
    }
    tc_set(state, 0, TC_AFF, 0)
    taskslot.tset(state, 0, taskconst.T_FPU, fpu.area_new(state))
    set_kernel_stack(state, vector(state, 61))
    trace_push(state, 1)
}

fn set_idle(state: u64, i: u64) {
    kstate.set(state, kstate.IDLE, i)
    cpu.set(state, cpu.here(state), cpu.C_IDLE, i)
}

fn adopt(state: u64, kind: u64, prio: u64, ktop: u64) -> u64 {
    let vec_area: u64 = fpu.area_new(state)
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    var i: u64 = 1
    var slot: u64 = 0
    while i < kstate.MAX_TASKS {
        if taskslot.tget(state, i, taskconst.T_STATE) == taskconst.S_FREE {
            slot = i
            i = kstate.MAX_TASKS
        } else {
            i = i + 1
        }
    }
    if slot == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        fpu.area_free(state, vec_area)
        return 0
    }
    var j: u64 = 0
    while j < kstate.TASK_BYTES / 8 {
        __mmio_write64((taskslot.task_at(state, slot) + j * 8) as *mut u64, 0)
        j = j + 1
    }
    taskslot.tset(state, slot, taskconst.T_PID, kstate.add(state, kstate.NEXT_PID, 1) - 1)
    taskslot.tset(state, slot, taskconst.T_BORN, kstate.get(state, kstate.TICKS))
    taskslot.tset(state, slot, taskconst.T_FPU, vec_area)
    taskslot.tset(state, slot, taskconst.T_KTOP, ktop)
    taskslot.tset(state, slot, taskconst.T_PRIO, prio)
    taskslot.tset(state, slot, taskconst.T_BUDGET, prio)
    taskslot.tset(state, slot, taskconst.T_KIND, kind)
    taskslot.tset(state, slot, taskconst.T_CR3, kstate.get(state, kstate.KPML4))
    taskslot.tset(state, slot, taskconst.T_STATE, taskconst.S_RUN)
    tc_set(state, slot, TC_CPU, cpu.here(state))
    tc_set(state, slot, TC_MASK, 1 << cpu.here(state))
    tc_set(state, slot, 24, 0)
    tc_set(state, slot, TC_AFF, cpu.here(state))
    clear_signals(state, slot)
    if slot + 1 > kstate.get(state, kstate.TASKS) {
        kstate.set(state, kstate.TASKS, slot + 1)
    }
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return slot
}

fn frame_build(state: u64, ktop: u64, entry: u64, a0: u64, a1: u64,
    a2: u64) -> u64 {
    let base: u64 = ktop - 144
    var i: u64 = 0
    while i < 18 {
        __mmio_write64((base + i * 8) as *mut u64, 0)
        i = i + 1
    }
    __mmio_write64(base as *mut u64, 0x002)
    __mmio_write64((base + 72) as *mut u64, a0)
    __mmio_write64((base + 80) as *mut u64, a1)
    __mmio_write64((base + 104) as *mut u64, a2)
    __mmio_write64((base + 128) as *mut u64, entry)
    __mmio_write64((base + 136) as *mut u64, vector(state, V_GUARD))
    return base
}

fn create(state: u64, kind: u64, prio: u64, arg: u64, entry: u64) -> u64 {
    let raw_base: u64 = mmframe.frame_run(state, taskconst.KSTACK_FRAMES + 1)
    if raw_base == 0 {
        return 0
    }
    let stack: u64 = raw_base + mmframe.FRAME_SIZE
    guard_paint(stack)
    let vec_area: u64 = fpu.area_new(state)
    if vec_area == 0 && fpu.enabled(state) {
        free_stack(state, stack)
        return 0
    }
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    var i: u64 = 1
    var slot: u64 = 0
    while i < kstate.MAX_TASKS {
        if taskslot.tget(state, i, taskconst.T_STATE) == taskconst.S_FREE {
            slot = i
            i = kstate.MAX_TASKS
        } else {
            i = i + 1
        }
    }
    if slot == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        free_stack(state, stack)
        fpu.area_free(state, vec_area)
        return 0
    }
    let ktop: u64 = stack + taskconst.KSTACK_FRAMES * mmframe.FRAME_SIZE
    arch.fill_words(stack, taskconst.STACK_PAINT, taskconst.KSTACK_FRAMES * mmframe.FRAME_SIZE / 8)
    var real_entry: u64 = entry
    if real_entry == 0 {
        real_entry = vector(state, V_TASK_MAIN)
    }
    var j: u64 = 0
    while j < kstate.TASK_BYTES / 8 {
        __mmio_write64((taskslot.task_at(state, slot) + j * 8) as *mut u64, 0)
        j = j + 1
    }
    taskslot.tset(state, slot, taskconst.T_PID, kstate.add(state, kstate.NEXT_PID, 1) - 1)
    taskslot.tset(state, slot, taskconst.T_BORN, kstate.get(state, kstate.TICKS))
    taskslot.tset(state, slot, taskconst.T_KSTACK, stack)
    taskslot.tset(state, slot, taskconst.T_FPU, vec_area)
    taskslot.tset(state, slot, taskconst.T_KTOP, ktop)
    taskslot.tset(state, slot, taskconst.T_PRIO, prio)
    taskslot.tset(state, slot, taskconst.T_BUDGET, prio)
    taskslot.tset(state, slot, taskconst.T_KIND, kind)
    taskslot.tset(state, slot, taskconst.T_ARG, arg)
    taskslot.tset(state, slot, taskconst.T_PARENT, current(state))
    let par: u64 = current(state)
    taskslot.tset(state, slot, taskconst.T_UID, taskslot.tget(state, par, taskconst.T_UID))
    taskslot.tset(state, slot, taskconst.T_GID, taskslot.tget(state, par, taskconst.T_GID))
    taskslot.tset(state, slot, taskconst.T_EUID, taskslot.tget(state, par, taskconst.T_EUID))
    taskslot.tset(state, slot, taskconst.T_EGID, taskslot.tget(state, par, taskconst.T_EGID))
    taskslot.tset(state, slot, taskconst.T_SUID, taskslot.tget(state, par, taskconst.T_SUID))
    taskslot.tset(state, slot, taskconst.T_SGID, taskslot.tget(state, par, taskconst.T_SGID))
    taskslot.tset(state, slot, taskconst.T_UMASK, taskslot.tget(state, par, taskconst.T_UMASK))
    prstate.inherit_fork(state, slot, par)
    groups_inherit(state, slot, par)
    if taskslot.tget(state, par, taskconst.T_EXAS) != 0 {
        session_identity(state, slot)
    }
    taskslot.tset(state, slot, taskconst.T_CR3, kstate.get(state, kstate.KPML4))
    taskslot.tset(state, slot, taskconst.T_CWD, kstate.get(state, kstate.FS_ROOT))
    taskslot.tset(state, slot, taskconst.T_RSP, frame_build(state, ktop, real_entry, state,
            slot, kind))
    taskslot.tset(state, slot, taskconst.T_STATE, taskconst.S_NEW)
    if slot + 1 > kstate.get(state, kstate.TASKS) {
        kstate.set(state, kstate.TASKS, slot + 1)
    }
    tc_set(state, slot, TC_CPU, kstate.MAX_CPUS)
    tc_set(state, slot, TC_MASK, 0)
    if kind == taskconst.K_USER && ring3_all == 0 {
        tc_set(state, slot, TC_AFF, 0)
    } else {
        tc_set(state, slot, TC_AFF, taskconst.ANY_CPU)
    }
    clear_signals(state, slot)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return slot
}

const SIG_SLOTS: u64 = 32
const SIG_ENTRY: u64 = 24

fn clear_signals(state: u64, i: u64) {
    if i >= kstate.MAX_TASKS {
        return
    }
    let base: u64 = state + kstate.SIG_OFF + i * (SIG_SLOTS * SIG_ENTRY)
    var k: u64 = 0
    while k < (SIG_SLOTS * SIG_ENTRY) / 8 {
        __mmio_write64((base + k * 8) as *mut u64, 0)
        k = k + 1
    }
    let rt: u64 = state + kstate.SIGRT_OFF + i * kstate.SIGRT_TASK
    var q: u64 = 0
    while q < kstate.SIGRT_TASK / 8 {
        __mmio_write64((rt + q * 8) as *mut u64, 0)
        q = q + 1
    }
    taskslot.tset(state, i, taskconst.T_SIGPEND, 0)
    taskslot.tset(state, i, taskconst.T_SIGMASK, 0)
    taskslot.tset(state, i, taskconst.T_SIGRET, 0)
    taskslot.tset(state, i, taskconst.T_ALARM, 0)
    taskslot.tset(state, i, taskconst.T_ITIV, 0)
    taskslot.tset(state, i, taskconst.T_ALTSP, 0)
    taskslot.tset(state, i, taskconst.T_ALTSZ, 0)
    taskslot.tset(state, i, taskconst.T_SUSP, 0)
    taskslot.tset(state, i, taskconst.T_STOPSIG, 0)
    taskslot.tset(state, i, taskconst.T_SIGLAST, 0)
    ptstate.clear(i)
    let pid: u64 = taskslot.tget(state, i, taskconst.T_PID)
    taskslot.tset(state, i, taskconst.T_PGID, pid)
    taskslot.tset(state, i, taskconst.T_SID, pid)
    taskslot.tset(state, i, taskconst.T_TGID, pid)
}

fn free_stack(state: u64, stack: u64) {
    if stack == 0 {
        return
    }
    var k: u64 = 0
    while k < taskconst.KSTACK_FRAMES + 1 {
        mmframe.frame_free(state, stack - mmframe.FRAME_SIZE + k * mmframe.FRAME_SIZE)
        k = k + 1
    }
}

fn guard_paint(stack: u64) {
    arch.fill_words(stack - mmframe.FRAME_SIZE, GUARD_PAINT, mmframe.FRAME_SIZE / 8)
}

static mut watch_breaks: u64 = 0
static mut watch_pid: u64 = 0
static mut watch_depth: u64 = 0

fn guard_broken(state: u64, i: u64) -> bool {
    let stack: u64 = taskslot.tget(state, i, taskconst.T_KSTACK)
    if stack == 0 {
        return false
    }
    let g: u64 = stack - mmframe.FRAME_SIZE
    if __mmio_read64((stack - 8) as *mut u64) != GUARD_PAINT {
        return true
    }
    return __mmio_read64(g as *mut u64) != GUARD_PAINT
}

fn guard_depth(state: u64, i: u64) -> u64 {
    let stack: u64 = taskslot.tget(state, i, taskconst.T_KSTACK)
    if stack == 0 {
        return 0
    }
    let g: u64 = stack - mmframe.FRAME_SIZE
    var p: u64 = stack
    while p > g {
        p = p - 8
        if __mmio_read64(p as *mut u64) != GUARD_PAINT {
            return stack - p
        }
    }
    return 0
}

fn guard_check(state: u64, i: u64) {
    if !guard_broken(state, i) {
        return
    }
    var s_a: [u8; 29] = "KERNEL STACK OVERFLOW: task \0"
    var s_p: [u8; 7] = "  pid=\0"
    var s_t: [u8; 9] = "  depth=\0"
    var s_k: [u8; 10] = "  kstack=\0"
    watch_breaks = watch_breaks + 1
    watch_pid = taskslot.tget(state, i, taskconst.T_PID)
    watch_depth = guard_depth(state, i)
    serial.puts((&s_a[0]) as u64)
    serial.dec(i)
    serial.puts((&s_p[0]) as u64)
    serial.dec(watch_pid)
    serial.puts((&s_t[0]) as u64)
    serial.dec(watch_depth)
    serial.puts((&s_k[0]) as u64)
    serial.hex(taskslot.tget(state, i, taskconst.T_KSTACK))
    serial.nl()
    guard_paint(taskslot.tget(state, i, taskconst.T_KSTACK))
}

fn guard_faults() -> u64 {
    return watch_breaks
}

fn guard_last_pid() -> u64 {
    return watch_pid
}

fn guard_last_depth() -> u64 {
    return watch_depth
}

fn stack_high(state: u64, i: u64) -> u64 {
    let base: u64 = taskslot.tget(state, i, taskconst.T_KSTACK)
    let ktop: u64 = taskslot.tget(state, i, taskconst.T_KTOP)
    if base == 0 || ktop <= base {
        return 0
    }
    var p: u64 = base
    while p < ktop {
        if __mmio_read64(p as *mut u64) != taskconst.STACK_PAINT {
            return ktop - p
        }
        p = p + 8
    }
    return 0
}

fn start(state: u64, i: u64) -> bool {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if taskslot.tget(state, i, taskconst.T_STATE) != taskconst.S_NEW {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return false
    }
    taskslot.tset(state, i, taskconst.T_STATE, taskconst.S_READY)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    kick_one(state, i)
    return true
}

fn set_kernel_stack(state: u64, ktop: u64) {
    let me: u64 = cpu.here(state)
    cpu.set(state, me, cpu.C_KSTACK, ktop)
    var tss: u64 = cpu.get(state, me, cpu.C_TSSADDR)
    if tss == 0 {
        tss = kstate.get(state, kstate.TSS)
    }
    if tss != 0 {
        __mmio_write64((tss + 4) as *mut u64, ktop)
    }
    if me == 0 {
        kstate.set(state, kstate.KSTACK_CUR, ktop)
    }
}

fn enter_task(state: u64) {
    atomic.lock_give(state, atomic.L_SCHED)
    asm("sti")
}

fn ready_count(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_KIND) != taskconst.K_IDLE && taskslot.tget(state, i, taskconst.T_STATE) == taskconst.S_READY {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn zombies(state: u64, kind: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_KIND) == kind && taskslot.tget(state, i, taskconst.T_STATE) == taskconst.S_ZOMBIE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn free_slots(state: u64) -> u64 {
    var i: u64 = 1
    var c: u64 = 0
    while i < kstate.MAX_TASKS {
        if taskslot.tget(state, i, taskconst.T_STATE) == taskconst.S_FREE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn reap_all(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var c: u64 = 0
    while i < n {
        if reap(state, i) {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn alive_count(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        let st: u64 = taskslot.tget(state, i, taskconst.T_STATE)
        if st != taskconst.S_FREE && st != taskconst.S_ZOMBIE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn pick(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    let cur: u64 = current(state)
    let me: u64 = cpu.here(state)
    let myidle: u64 = cpu.get(state, me, cpu.C_IDLE)
    if me != 0 && myidle != 0 && cpu.get(state, me, cpu.C_PARKREQ) != 0 {
        return myidle
    }
    var k: u64 = 1
    while k <= n {
        let i: u64 = (cur + k) % n
        if taskslot.tget(state, i, taskconst.T_KIND) != taskconst.K_IDLE && taskslot.tget(state, i, taskconst.T_STATE) == taskconst.S_READY
        && may_run(state, i, me) && ring3_allowed(state, i, me) {
            return i
        }
        k = k + 1
    }
    if taskslot.tget(state, cur, taskconst.T_STATE) == taskconst.S_RUN {
        return cur
    }
    return myidle
}

fn switch_to(state: u64, from: u64, to: u64) {
    let me: u64 = cpu.here(state)
    cpu.set(state, me, cpu.C_CUR, to)
    cpu.add(state, me, cpu.C_SWITCHES, 1)
    if taskslot.tget(state, to, taskconst.T_KIND) != taskconst.K_IDLE {
        cpu.add(state, me, cpu.C_PICKS, 1)
    }
    tc_set(state, to, TC_CPU, me)
    tc_set(state, to, TC_MASK, tc_get(state, to, TC_MASK) | (1 << me))
    if me != 0 && taskslot.tget(state, to, taskconst.T_KIND) != taskconst.K_IDLE && cpu.x_get(state, me, cpu.X_HALTED) != 0
    && !kstate.mode_on(state, kstate.M_APSLOW) {
        cpu.x_set(state, me, cpu.X_HALTED, 0)
        cpu.x_set(state, me, cpu.X_PEND, 0)
        hrt.rate_here(state, 1)
    }
    kstate.add(state, kstate.SWITCHES, 1)
    taskslot.tset(state, to, taskconst.T_RUNS, taskslot.tget(state, to, taskconst.T_RUNS) + 1)
    trace_push(state, taskslot.tget(state, to, taskconst.T_PID))
    let cr3: u64 = taskslot.tget(state, to, taskconst.T_CR3)
    if cr3 != 0 {
        let now: u64 = asm("mov rax, cr3", out("rax"))
        if cr3 != now {
            asm("mov cr3, rax", in("rax") cr3, clobber("memory"))
        }
    }
    set_kernel_stack(state, taskslot.tget(state, to, taskconst.T_KTOP))
    fpu.switch(state, me, fpu_area(state, from), fpu_area(state, to))
    fsbase_apply(state, to)
    asm("call rax", in("rax") vector(state, V_SWITCH),
        in("rdi") taskslot.task_at(state, from) + taskconst.T_RSP,
        in("rsi") taskslot.tget(state, to, taskconst.T_RSP), clobber("memory"))
}

fn fsbase_apply(state: u64, i: u64) {
    if i >= kstate.MAX_TASKS {
        return
    }
    let b: u64 = taskslot.tget(state, i, taskconst.T_FSBASE)
    msr.wr(state, MSR_FS_BASE, b)
    msr.wr(state, MSR_KERNEL_GS_BASE, taskslot.tget(state, i, taskconst.T_GSBASE))
}

const MSR_FS_BASE: u64 = 0xC0000100
const MSR_KERNEL_GS_BASE: u64 = 0xC0000102

fn fpu_area(state: u64, i: u64) -> u64 {
    if i >= kstate.MAX_TASKS {
        return 0
    }
    return taskslot.tget(state, i, taskconst.T_FPU)
}

fn fpu_set_area(state: u64, i: u64, area: u64) {
    if i < kstate.MAX_TASKS {
        taskslot.tset(state, i, taskconst.T_FPU, area)
    }
}

fn fpu_inherit(state: u64, parent: u64, child: u64) {
    fpu.sync_here(state, fpu_area(state, parent))
    fpu.area_copy(state, fpu_area(state, child), fpu_area(state, parent))
}

fn fpu_reset(state: u64, i: u64) {
    let a: u64 = fpu_area(state, i)
    if a == 0 {
        return
    }
    fpu.area_init(state, a)
    fpu.adopt_now(state, a)
}

fn schedule(state: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    schedule_locked(state)
    irq_restore(flags)
}

const CTR_BYTES_: u64 = 256
const X_CPUSH_: u64 = 40
const X_CPUTICK_: u64 = 48

fn ctr_share_of(state: u64, t: u64) -> u64 {
    if t >= kstate.MAX_TASKS {
        return 0
    }
    let c: u64 = taskslot.tget(state, t, taskconst.T_CTR)
    if c == 0 || c >= 8 {
        return 0
    }
    return kstate.get(state, kstate.CTR_OFF + c * CTR_BYTES_ + X_CPUSH_)
}

fn ctr_tick(state: u64, t: u64) {
    if t >= kstate.MAX_TASKS {
        return
    }
    let c: u64 = taskslot.tget(state, t, taskconst.T_CTR)
    if c == 0 || c >= 8 {
        return
    }
    let a: u64 = kstate.CTR_OFF + c * CTR_BYTES_ + X_CPUTICK_
    kstate.set(state, a, kstate.get(state, a) + 1)
}

fn budget_for(state: u64, t: u64) -> u64 {
    let p: u64 = taskslot.tget(state, t, taskconst.T_PRIO)
    let sh: u64 = ctr_share_of(state, t)
    if sh == 0 || sh >= 100 {
        return p
    }
    let b: u64 = (p * sh) / 100
    if b == 0 {
        return 1
    }
    return b
}

fn schedule_locked(state: u64) {
    let cur: u64 = current(state)
    let next: u64 = pick(state)
    if next == cur {
        taskslot.tset(state, cur, taskconst.T_STATE, taskconst.S_RUN)
        taskslot.tset(state, cur, taskconst.T_BUDGET, budget_for(state, cur))
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    let next_rsp: u64 = taskslot.tget(state, next, taskconst.T_RSP)
    if next_rsp < 0x1000 || taskslot.tget(state, next, taskconst.T_STATE) == taskconst.S_RUN {
        asm("ud2", in("rdi") next, in("rsi") next_rsp,
            in("rdx") taskslot.tget(state, next, taskconst.T_STATE), in("rcx") taskslot.tget(state, next, taskconst.T_KIND),
            in("r8") cpu.here(state), in("r9") cur,
            in("r10") tc_get(state, next, TC_CPU), clobber("memory"))
    }
    if taskslot.tget(state, cur, taskconst.T_STATE) == taskconst.S_RUN {
        taskslot.tset(state, cur, taskconst.T_STATE, taskconst.S_READY)
    }
    taskslot.tset(state, next, taskconst.T_STATE, taskconst.S_RUN)
    taskslot.tset(state, next, taskconst.T_BUDGET, budget_for(state, next))
    ctr_tick(state, cur)
    switch_to(state, cur, next)
    atomic.lock_give(state, atomic.L_SCHED)
}

fn yield_now(state: u64) {
    schedule(state)
}

fn pat_here(state: u64, me: u64) {
    if me >= 63 {
        return
    }
    let patv: u64 = kstate.get(state, 0x3C000 + 0x938)
    if patv == 0 {
        return
    }
    let bit: u64 = 1 << me
    if (kstate.get(state, 0x3C000 + 0x940) & bit) != 0 {
        return
    }
    if msr.wr(state, 0x277, patv) {
        let c: u64 = asm("mov rax, cr3", out("rax"))
        asm("mov cr3, rax", in("rax") c)
        asm("wbinvd")
    }
    atomic.fetch_add(state + 0x3C000 + 0x940, bit)
}

fn kick_one(state: u64, i: u64) {
    if kstate.mode_on(state, kstate.M_NOKICK) {
        return
    }
    let nc: u64 = cpu.count(state)
    if nc <= 1 {
        return
    }
    let me: u64 = cpu.here(state)
    if me < 8 && desk_hlt[me as usize] != 0 {
        return
    }
    let cur: u64 = current(state)
    if cur >= kstate.MAX_TASKS || taskslot.tget(state, cur, taskconst.T_KIND) == taskconst.K_IDLE || cur == i {
        return
    }
    var k: u64 = 1
    while k < nc && k < 8 {
        if k != me && cpu.get(state, k, cpu.C_ONLINE) != 0 && cpu.x_get(state, k, cpu.X_HALTED) != 0
        && cpu.x_get(state, k, cpu.X_PEND) == 0 && may_run(state, i, k) && ring3_allowed(state, i, k) {
            cpu.x_set(state, k, cpu.X_PEND, 1)
            cpu.x_add(state, k, cpu.X_KICKTX, 1)
            apic.ipi(state, cpu.apic_id(state, k), apic.VEC_TIMER | 0x4000)
            return
        }
        k = k + 1
    }
}

fn kick_idle_cores(state: u64) {
    if kstate.mode_on(state, kstate.M_NOKICK) {
        return
    }
    let nc: u64 = cpu.count(state)
    if nc <= 1 {
        return
    }
    var sleeping: u64 = 0
    var k: u64 = 1
    while k < nc && k < 8 {
        if cpu.get(state, k, cpu.C_ONLINE) != 0 && cpu.x_get(state, k, cpu.X_HALTED) != 0
        && cpu.x_get(state, k, cpu.X_PEND) == 0 {
            sleeping = sleeping | (1 << k)
        }
        k = k + 1
    }
    if sleeping == 0 {
        return
    }
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n && sleeping != 0 {
        if taskslot.tget(state, i, taskconst.T_STATE) == taskconst.S_READY && taskslot.tget(state, i, taskconst.T_KIND) != taskconst.K_IDLE {
            var j: u64 = 1
            while j < nc && j < 8 {
                if (sleeping & (1 << j)) != 0 && may_run(state, i, j) && ring3_allowed(state, i, j) {
                    cpu.x_set(state, j, cpu.X_PEND, 1)
                    cpu.x_add(state, j, cpu.X_KICKTX, 1)
                    apic.ipi(state, cpu.apic_id(state, j), apic.VEC_TIMER | 0x4000)
                    sleeping = sleeping ^ (1 << j)
                    j = 8
                } else {
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
}

fn wake_due(state: u64) -> u64 {
    let now: u64 = kstate.get(state, kstate.TICKS)
    var now_ns: u64 = 0
    if hrt.pending_any() {
        now_ns = time.mono_ns(state)
    }
    let n: u64 = kstate.get(state, kstate.TASKS)
    var woke: u64 = 0
    var fine_left: bool = false
    var i: u64 = 0
    while i < n {
        let ts: u64 = taskslot.tget(state, i, taskconst.T_STATE)
        if ts == taskconst.S_SLEEP || ts == taskconst.S_POLL {
            if taskslot.tget(state, i, taskconst.T_WAKE) <= now || hrt.due(i, now_ns) {
                if state_cas(state, i, ts, taskconst.S_READY) {
                    woke = woke + 1
                }
            } else if hrt.wake_of(i) != 0 {
                fine_left = true
            }
        }
        i = i + 1
    }
    if now_ns != 0 && !fine_left {
        hrt.clear_pending()
    }
    return woke
}

fn fast_tick(state: u64) {
    if !hrt.pending_any() {
        hrt.relax_here(state)
        return
    }
    let me: u64 = cpu.here(state)
    atomic.lock_take(state, atomic.L_SCHED, me)
    let woke: u64 = wake_due(state)
    if woke == 0 || kstate.get(state, kstate.PREEMPT) == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    kick_idle_cores(state)
    schedule_locked(state)
}

fn on_tick(state: u64) {
    let me: u64 = cpu.here(state)
    cpu.add(state, me, cpu.C_TICKS, 1)
    pat_here(state, me)
    fbmtrr.here(state, me)
    atomic.lock_take(state, atomic.L_SCHED, me)
    let _w: u64 = wake_due(state)
    let cur: u64 = current(state)
    var tick_to: u64 = cur
    var in_wait: bool = false
    if me < 8 && desk_hlt[me as usize] != 0 {
        in_wait = true
        var it: u64 = cpu.get(state, me, cpu.C_IDLE)
        if it == 0 {
            it = kstate.get(state, kstate.IDLE)
        }
        if it != 0 && it < kstate.MAX_TASKS {
            tick_to = it
        }
    }
    taskslot.tset(state, tick_to, taskconst.T_TICKS, taskslot.tget(state, tick_to, taskconst.T_TICKS) + 1)
    let ap_cpu: u64 = policy.acct_addr(taskslot.task_at(state, tick_to) + taskconst.T_ORIGIN, policy.A_CPU)
    if ap_cpu != 0 {
        atomic.fetch_add(ap_cpu, 1)
    }
    let idle_now: bool = taskslot.tget(state, cur, taskconst.T_KIND) == taskconst.K_IDLE || in_wait
    if idle_now {
        cpu.add(state, me, cpu.C_IDLETICKS, 1)
    }
    let tsc_now: u64 = apic.tsc()
    let tsc_last: u64 = cpu.x_get(state, me, cpu.X_LASTTSC)
    if tsc_last != 0 && tsc_now > tsc_last {
        cpu.x_add(state, me, cpu.X_TOTCYC, tsc_now - tsc_last)
        if idle_now {
            cpu.x_add(state, me, cpu.X_IDLECYC, tsc_now - tsc_last)
        }
    }
    cpu.x_set(state, me, cpu.X_LASTTSC, tsc_now)
    if me != 0 && cpu.x_get(state, me, cpu.X_PEND) != 0 {
        cpu.x_add(state, me, cpu.X_KICKRX, 1)
    }
    if !idle_now {
        kick_idle_cores(state)
    }
    guard_check(state, cur)
    if kstate.get(state, kstate.PREEMPT) == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    let budget: u64 = taskslot.tget(state, cur, taskconst.T_BUDGET)
    if budget > 1 {
        taskslot.tset(state, cur, taskconst.T_BUDGET, budget - 1)
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    taskslot.tset(state, cur, taskconst.T_BUDGET, 0)
    schedule_locked(state)
}

fn timer_tot(state: u64) -> bool {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return false
    }
    let k: u64 = cpu.here(state)
    let now_ticks: u64 = kstate.get(state, kstate.TICKS)
    let t: u64 = apic.tsc()
    let mark_ticks: u64 = cpu.get(state, k, cpu.C_TOTMARKE)
    if now_ticks != mark_ticks {
        let time0: u64 = cpu.get(state, k, cpu.C_TOTZEIT)
        if mark_ticks != 0 && time0 != 0 && t > time0 && now_ticks > mark_ticks {
            var d: u64 = (t - time0) / (now_ticks - mark_ticks)
            let per0: u64 = cpu.get(state, k, cpu.C_TOTPER)
            if per0 == 0 {
                cpu.set(state, k, cpu.C_TOTPER, d)
            } else {
                if d > per0 * 4 {
                    d = per0 * 4
                }
                cpu.set(state, k, cpu.C_TOTPER, (per0 * 3 + d) / 4)
            }
        }
        cpu.set(state, k, cpu.C_TOTMARKE, now_ticks)
        cpu.set(state, k, cpu.C_TOTZEIT, t)
        return false
    }
    let mark_time: u64 = cpu.get(state, k, cpu.C_TOTZEIT)
    if mark_time == 0 {
        cpu.set(state, k, cpu.C_TOTZEIT, t)
        return false
    }
    var limit: u64 = hz / 3
    let per: u64 = cpu.get(state, k, cpu.C_TOTPER)
    if per != 0 && per * 8 > limit {
        limit = per * 8
    }
    if t > mark_time && t - mark_time > limit {
        cpu.add(state, k, cpu.C_TOTZAHL, 1)
        return true
    }
    return false
}

fn dead_sleeps(state: u64) -> u64 {
    var sum: u64 = 0
    var k: u64 = 0
    while k < cpu.count(state) {
        sum = sum + cpu.get(state, k, cpu.C_TOTZAHL)
        k = k + 1
    }
    return sum
}

static mut desk_hlt: [u64; 8] = [0 as u64; 8]

fn idle_wait(state: u64) {
    let me: u64 = cpu.here(state)
    if me >= 8 {
        return
    }
    desk_hlt[me as usize] = 1
    asm("sti\nhlt")
    desk_hlt[me as usize] = 0
}

static mut tot_last: [u64; 8] = [0 as u64; 8]
static mut tot_waits: u64 = 0

fn sleep_tot(state: u64, ticks: u64) {
    let me: u64 = cpu.here(state)
    var hz: u64 = apic.tsc_hz(state)
    if me >= 8 || hz < 100000000 || hz > 10000000000 {
        yield_now(state)
        return
    }
    var per: u64 = hz / 100
    let seen: u64 = cpu.get(state, me, cpu.C_TOTPER)
    if seen > per {
        per = seen
    }
    if per > hz / 10 {
        per = hz / 10
    }
    var n: u64 = ticks
    if n > 2 {
        n = 2
    }
    let t0: u64 = kstate.get(state, kstate.TICKS)
    let next: u64 = tot_last[me as usize] + n * per
    tot_waits = tot_waits + 1
    var guard: u64 = 0
    while apic.tsc() < next && kstate.get(state, kstate.TICKS) == t0 && guard < 4 {
        yield_now(state)
        if apic.tsc() < next && kstate.get(state, kstate.TICKS) == t0 {
            let fl: u64 = irq_save()
            asm("sti\nhlt")
            irq_restore(fl)
        }
        guard = guard + 1
    }
    tot_last[me as usize] = apic.tsc()
}

fn sleep_ticks(state: u64, ticks: u64) {
    if ticks == 0 {
        yield_now(state)
        return
    }
    if timer_tot(state) {
        sleep_tot(state, ticks)
        return
    }
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    taskslot.tset(state, cur, taskconst.T_WAKE, kstate.get(state, kstate.TICKS) + ticks)
    hrt.set_wake(cur, 0)
    taskslot.tset(state, cur, taskconst.T_STATE, taskconst.S_SLEEP)
    schedule_locked(state)
    irq_restore(flags)
}

fn sleep_ticks_unless(state: u64, slot: u64, seen: u64, ticks: u64) {
    if timer_tot(state) {
        sleep_tot(state, ticks)
        return
    }
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if kstate.get(state, slot) != seen {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return
    }
    let cur: u64 = current(state)
    taskslot.tset(state, cur, taskconst.T_WAKE, kstate.get(state, kstate.TICKS) + ticks)
    hrt.set_wake(cur, 0)
    taskslot.tset(state, cur, taskconst.T_STATE, taskconst.S_SLEEP)
    schedule_locked(state)
    irq_restore(flags)
}

fn wake_sleeper(state: u64, task: u64) {
    if task >= kstate.MAX_TASKS {
        return
    }
    if taskslot.tget(state, task, taskconst.T_STATE) == taskconst.S_SLEEP {
        state_cas(state, task, taskconst.S_SLEEP, taskconst.S_READY)
    }
}

fn sleep_fine(state: u64, fine: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    let now_ns: u64 = time.mono_ns(state)
    var rel: u64 = 0
    if fine > now_ns {
        rel = fine - now_ns
    }
    taskslot.tset(state, cur, taskconst.T_WAKE, kstate.get(state, kstate.TICKS) + hrt.ticks_for(rel))
    hrt.set_wake(cur, fine)
    hrt.arm_here(state)
    taskslot.tset(state, cur, taskconst.T_STATE, taskconst.S_SLEEP)
    schedule_locked(state)
    irq_restore(flags)
}

fn wait_sleep(state: u64, want: u64, untraced: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_STATE) == taskconst.S_ZOMBIE && taskslot.tget(state, i, taskconst.T_PARENT) == cur
            && (want == 0 || taskslot.tget(state, i, taskconst.T_PID) == want) && !group_live(state, i) {
            atomic.lock_give(state, atomic.L_SCHED)
            irq_restore(flags)
            return
        }
        if ptstate.get(i, ptstate.F_TRACER) == cur + 1 && ptstate.reportable(i)
            && (want == 0 || taskslot.tget(state, i, taskconst.T_PID) == want) {
            atomic.lock_give(state, atomic.L_SCHED)
            irq_restore(flags)
            return
        }
        if untraced != 0 && taskslot.tget(state, i, taskconst.T_PARENT) == cur && (want == 0 || taskslot.tget(state, i, taskconst.T_PID) == want)
            && stop_unreported(taskslot.tget(state, i, taskconst.T_STOPSIG)) {
            atomic.lock_give(state, atomic.L_SCHED)
            irq_restore(flags)
            return
        }
        i = i + 1
    }
    taskslot.tset(state, cur, taskconst.T_WAITPID, want)
    taskslot.tset(state, cur, taskconst.T_STATE, taskconst.S_WAIT)
    schedule_locked(state)
    irq_restore(flags)
}

const STOP_REPORTED: u64 = 256

fn stop_unreported(stopsig: u64) -> bool {
    return stopsig != 0 && (stopsig & STOP_REPORTED) == 0
}

fn stopped_child(state: u64, me: u64, want: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_PARENT) == me && (want == 0 || taskslot.tget(state, i, taskconst.T_PID) == want)
            && stop_unreported(taskslot.tget(state, i, taskconst.T_STOPSIG)) {
            return i
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

fn stop_claim(state: u64, task: u64) -> u64 {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let sig: u64 = taskslot.tget(state, task, taskconst.T_STOPSIG)
    var claimed: u64 = 0
    if stop_unreported(sig) {
        taskslot.tset(state, task, taskconst.T_STOPSIG, sig | STOP_REPORTED)
        claimed = sig
    }
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return claimed
}

fn stop_sleep(state: u64, contbit: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    if (taskslot.tget(state, cur, taskconst.T_SIGPEND) & contbit) != 0 {
        taskslot.tset(state, cur, taskconst.T_STOPSIG, 0)
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return
    }
    taskslot.tset(state, cur, taskconst.T_STATE, taskconst.S_STOP)
    schedule_locked(state)
    irq_restore(flags)
}

fn ptrace_park(state: u64) {
    var first: bool = true
    while true {
        let flags: u64 = irq_save()
        atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
        let cur: u64 = current(state)
        if first {
            ptstate.set(cur, ptstate.F_HOLD, 1)
            ptstate.set(cur, ptstate.F_FRESH, 1)
            wake_pid(state, taskslot.tget(state, cur, taskconst.T_PID))
            first = false
        }
        let killed: bool = (taskslot.tget(state, cur, taskconst.T_SIGPEND) & ptstate.KILL_BIT) != 0
        if ptstate.get(cur, ptstate.F_HOLD) == 0 || killed {
            ptstate.set(cur, ptstate.F_HOLD, 0)
            atomic.lock_give(state, atomic.L_SCHED)
            irq_restore(flags)
            return
        }
        taskslot.tset(state, cur, taskconst.T_STATE, taskconst.S_STOP)
        schedule_locked(state)
        irq_restore(flags)
    }
}

fn ptrace_release(state: u64, task: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    ptstate.set(task, ptstate.F_HOLD, 0)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    state_cas(state, task, taskconst.S_STOP, taskconst.S_READY)
}

fn ptrace_gone(state: u64, task: u64) {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if ptstate.get(i, ptstate.F_TRACER) == task + 1 {
            ptstate.set(i, ptstate.F_TRACER, 0)
            ptstate.set(i, ptstate.F_HOLD, 0)
            ptstate.set(i, ptstate.F_MODE, 0)
            state_cas(state, i, taskconst.S_STOP, taskconst.S_READY)
        }
        i = i + 1
    }
    ptstate.set(task, ptstate.F_HOLD, 0)
    let tracer: u64 = ptstate.tracer_slot(task)
    if tracer < kstate.MAX_TASKS && tracer != taskslot.tget(state, task, taskconst.T_PARENT) {
        ptstate.set(task, ptstate.F_ZREP, 1)
        return
    }
    ptstate.set(task, ptstate.F_TRACER, 0)
}

fn wake_pid(state: u64, pid: u64) {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_STATE) == taskconst.S_WAIT {
            let w: u64 = taskslot.tget(state, i, taskconst.T_WAITPID)
            if w == 0 || w == pid {
                state_cas(state, i, taskconst.S_WAIT, taskconst.S_READY)
            }
        }
        i = i + 1
    }
}

fn poll_seq(state: u64) -> u64 {
    return kstate.get(state, kstate.POLLSEQ)
}

fn poll_kick(state: u64) {
    kstate.add(state, kstate.POLLSEQ, 1)
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_STATE) == taskconst.S_POLL {
            state_cas(state, i, taskconst.S_POLL, taskconst.S_READY)
        }
        i = i + 1
    }
}

fn poll_kick_one(state: u64, task: u64) {
    kstate.add(state, kstate.POLLSEQ, 1)
    if task >= kstate.MAX_TASKS {
        return
    }
    if taskslot.tget(state, task, taskconst.T_STATE) == taskconst.S_POLL {
        state_cas(state, task, taskconst.S_POLL, taskconst.S_READY)
    }
}

fn poll_sleep(state: u64, seen: u64, deadline: u64) {
    poll_sleep_fine(state, seen, deadline, 0)
}

fn poll_sleep_fine(state: u64, seen: u64, deadline: u64, fine: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if kstate.get(state, kstate.POLLSEQ) != seen {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return
    }
    let cur: u64 = current(state)
    taskslot.tset(state, cur, taskconst.T_POLLSEQ, seen)
    taskslot.tset(state, cur, taskconst.T_WAKE, deadline)
    hrt.set_wake(cur, fine)
    if fine != 0 {
        hrt.arm_here(state)
    }
    taskslot.tset(state, cur, taskconst.T_STATE, taskconst.S_POLL)
    atomic.barrier()
    if kstate.get(state, kstate.POLLSEQ) != seen {
        taskslot.tset(state, cur, taskconst.T_STATE, taskconst.S_RUN)
        hrt.set_wake(cur, 0)
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return
    }
    schedule_locked(state)
    irq_restore(flags)
}

fn find_pid(state: u64, pid: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_STATE) != taskconst.S_FREE && taskslot.tget(state, i, taskconst.T_PID) == pid {
            return i
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

const LOCK_NOSLOT: u64 = 0xFFFF

fn lock_gone(state: u64, task: u64) {
    let sp: u64 = kstate.K11_OFF
    if kstate.get(state, sp + kstate.SP_ON) == 0 {
        return
    }
    if kstate.get(state, sp + kstate.SP_SLOT) != task {
        return
    }
    kstate.set(state, sp + kstate.SP_PID, 0)
    kstate.set(state, sp + kstate.SP_SLOT, LOCK_NOSLOT)
}

fn exit_task(state: u64, code: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    taskslot.tset(state, cur, taskconst.T_EXIT, code)
    taskslot.tset(state, cur, taskconst.T_END, kstate.get(state, kstate.TICKS))
    lock_gone(state, cur)
    ptrace_gone(state, cur)
    taskslot.tset(state, cur, taskconst.T_STATE, taskconst.S_ZOMBIE)
    reparent(state, cur)
    wake_pid(state, taskslot.tget(state, cur, taskconst.T_PID))
    wake_pid(state, group_of(state, cur))
    schedule_locked(state)
    irq_restore(flags)
    while true {
        asm("hlt")
    }
}

fn kill_other(state: u64, i: u64, pid: u64, code: u64) -> u64 {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if i >= kstate.MAX_TASKS || taskslot.tget(state, i, taskconst.T_PID) != pid {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return taskconst.KILL_GONE
    }
    let st: u64 = taskslot.tget(state, i, taskconst.T_STATE)
    if st == taskconst.S_FREE || st == taskconst.S_ZOMBIE || st == taskconst.S_REAPING || st == taskconst.S_NEW {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return taskconst.KILL_GONE
    }
    if st == taskconst.S_RUN || i == current(state) {
        taskslot.tset(state, i, taskconst.T_KILLCODE, code | taskconst.KILL_SET)
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return taskconst.KILL_LATER
    }
    taskslot.tset(state, i, taskconst.T_KILLCODE, 0)
    let plain: bool = (code & taskconst.KILL_PLAIN) != 0
    let ecode: u64 = code & (0xFFFFFFFFFFFFFFFF -% taskconst.KILL_PLAIN)
    taskslot.tset(state, i, taskconst.T_EXIT, ecode)
    if !plain && ecode > 128 && ecode < 192 {
        taskslot.tset(state, i, taskconst.T_SIGLAST, ((ecode - 128) & 127) | 256)
    }
    taskslot.tset(state, i, taskconst.T_END, kstate.get(state, kstate.TICKS))
    lock_gone(state, i)
    ptrace_gone(state, i)
    taskslot.tset(state, i, taskconst.T_STATE, taskconst.S_ZOMBIE)
    reparent(state, i)
    wake_pid(state, pid)
    wake_pid(state, group_of(state, i))
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return taskconst.KILL_DONE
}

fn group_of(state: u64, i: u64) -> u64 {
    let g: u64 = taskslot.tget(state, i, taskconst.T_TGID)
    if g == 0 {
        return taskslot.tget(state, i, taskconst.T_PID)
    }
    return g
}

fn is_group_member(state: u64, i: u64, j: u64, g: u64) -> bool {
    if j == i || taskslot.tget(state, j, taskconst.T_KIND) != taskconst.K_USER || taskslot.tget(state, j, taskconst.T_TGID) != g {
        return false
    }
    let st: u64 = taskslot.tget(state, j, taskconst.T_STATE)
    return st != taskconst.S_FREE && st != taskconst.S_ZOMBIE && st != taskconst.S_REAPING
}

fn group_live(state: u64, i: u64) -> bool {
    let g: u64 = group_of(state, i)
    let n: u64 = kstate.get(state, kstate.TASKS)
    var j: u64 = 0
    while j < n {
        if is_group_member(state, i, j, g) {
            return true
        }
        j = j + 1
    }
    return false
}

fn kill_group(state: u64, i: u64, code: u64) {
    let g: u64 = group_of(state, i)
    let n: u64 = kstate.get(state, kstate.TASKS)
    var j: u64 = 0
    while j < n {
        if is_group_member(state, i, j, g) {
            let _r: u64 = kill_other(state, j, taskslot.tget(state, j, taskconst.T_PID), code)
        }
        j = j + 1
    }
}

fn reparent(state: u64, dying: u64) {
    let slot: u64 = kstate.get(state, kstate.K13_OFF + kstate.U_INITSLOT)
    var init: u64 = kstate.MAX_TASKS
    if slot != 0 {
        init = slot - 1
    }
    if init == dying {
        return
    }
    let heir: u64 = prstate.subreaper_for(state, dying, init)
    if heir >= kstate.MAX_TASKS {
        return
    }
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_STATE) != taskconst.S_FREE {
            if taskslot.tget(state, i, taskconst.T_PARENT) == dying && i != dying {
                taskslot.tset(state, i, taskconst.T_PARENT, heir)
                kstate.add(state, kstate.K13_OFF + kstate.U_ORPHANS, 1)
            }
        }
        i = i + 1
    }
}

fn on_a_core(state: u64, i: u64) -> bool {
    let n: u64 = cpu.count(state)
    var c: u64 = 0
    while c < n {
        if cpu.get(state, c, cpu.C_CUR) == i {
            return true
        }
        c = c + 1
    }
    return false
}

fn claim_zombie(state: u64, i: u64) -> bool {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if taskslot.tget(state, i, taskconst.T_STATE) != taskconst.S_ZOMBIE || on_a_core(state, i) {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return false
    }
    taskslot.tset(state, i, taskconst.T_STATE, taskconst.S_REAPING)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return true
}

fn reap(state: u64, i: u64) -> bool {
    return reap_in(state, i, taskconst.S_ZOMBIE)
}

fn reap_claimed(state: u64, i: u64) -> bool {
    return reap_in(state, i, taskconst.S_REAPING)
}

fn reap_in(state: u64, i: u64, want: u64) -> bool {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if taskslot.tget(state, i, taskconst.T_STATE) != want || on_a_core(state, i) {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return false
    }
    let stack: u64 = taskslot.tget(state, i, taskconst.T_KSTACK)
    let vec_area: u64 = taskslot.tget(state, i, taskconst.T_FPU)
    taskslot.tset(state, i, taskconst.T_FPU, 0)
    taskslot.tset(state, i, taskconst.T_KSTACK, 0)
    taskslot.tset(state, i, taskconst.T_STATE, taskconst.S_FREE)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    if stack != 0 {
        free_stack(state, stack)
    }
    if vec_area != 0 {
        fpu.drop_owner(state, vec_area)
        fpu.area_free(state, vec_area)
    }
    return true
}

fn kill_current(state: u64, pid_vector: u64, err: u64, cr2: u64, rip: u64) {
    var s_kill: [u8; 13] = "user fault: \0"
    var s_pid: [u8; 6] = "pid=\0\0"
    var s_vec: [u8; 10] = "  vector=\0"
    var s_err: [u8; 7] = "  err=\0"
    var s_cr2: [u8; 7] = "  cr2=\0"
    var s_rip: [u8; 7] = "  rip=\0"
    var s_dead: [u8; 20] = "  -- process killed\0"
    let cur: u64 = current(state)
    serial.puts((&s_kill[0]) as u64)
    serial.puts((&s_pid[0]) as u64)
    serial.dec(taskslot.tget(state, cur, taskconst.T_PID))
    serial.puts((&s_vec[0]) as u64)
    serial.dec(pid_vector)
    serial.puts((&s_err[0]) as u64)
    serial.hex(err)
    serial.puts((&s_cr2[0]) as u64)
    serial.hex(cr2)
    serial.puts((&s_rip[0]) as u64)
    serial.hex(rip)
    serial.puts((&s_dead[0]) as u64)
    serial.nl()
    kstate.add(state, kstate.KILLED, 1)
    taskslot.tset(state, cur, taskconst.T_FAULTS, taskslot.tget(state, cur, taskconst.T_FAULTS) + 1)
    exit_task(state, 128 + pid_vector)
}

fn dump_tasks(state: u64) {
    var s_row: [u8; 7] = "task: \0"
    var s_pid: [u8; 5] = "pid=\0"
    var s_kind: [u8; 8] = "  kind=\0"
    var s_prio: [u8; 8] = "  prio=\0"
    var s_state: [u8; 9] = "  state=\0"
    var s_runs: [u8; 8] = "  runs=\0"
    var s_ticks: [u8; 9] = "  ticks=\0"
    var s_work: [u8; 8] = "  work=\0"
    var s_end: [u8; 7] = "  end=\0"
    var s_exit: [u8; 8] = "  exit=\0"
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if taskslot.tget(state, i, taskconst.T_STATE) != taskconst.S_FREE {
            serial.puts((&s_row[0]) as u64)
            serial.puts((&s_pid[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_PID))
            serial.puts((&s_kind[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_KIND))
            serial.puts((&s_prio[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_PRIO))
            serial.puts((&s_state[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_STATE))
            serial.puts((&s_runs[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_RUNS))
            serial.puts((&s_ticks[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_TICKS))
            serial.puts((&s_work[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_WORK))
            serial.puts((&s_end[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_END))
            serial.puts((&s_exit[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_EXIT))
            serial.nl()
        }
        i = i + 1
    }
}
