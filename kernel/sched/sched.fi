// SPDX-License-Identifier: GPL-2.0-only
// kernel/sched.fi -- round 62: tasks and the scheduler.
//
// Round 59 had one thread of control: `kernel_main` ran from top to
// bottom, and the only thing that ever took the processor away from it
// was an interrupt that gave it straight back. From here on the kernel
// has TASKS, and the timer takes the processor away for good.
//
// A task is 256 octets in the data area (`kstate.TASK_OFF`) plus a
// KERNEL STACK OF ITS OWN out of the frame allocator. Everything a task
// needs in order to be interrupted in the middle and continued later
// lives on that stack; the task record only holds the stack pointer.
// That is the whole trick of a context switch, and `switch.s` does the
// six lines that a language cannot do.
//
// THE PLAN: weighted round robin. Every ready task gets a turn, in the
// order of the table, and the length of the turn is its priority in timer
// ticks. Priority 3 therefore gets three times the processor of priority
// 1 -- and nothing starves, which is what a strict priority order would
// do. The proof is in `tools/kernel/run.sh`: three workers with the
// priorities 1, 2 and 3 do the same amount of work, and the one with the
// highest priority is done first.
//
// THE COUNTER-CHECK belongs to it: with `nopreempt` on the command line
// the timer does not switch, and the same three workers run one after the
// other -- each one scheduled exactly ONCE. Interleaving that a spin loop
// produces on its own would show up here.

import serial
import lib.kstate
import mm.mem
import sync.atomic
import arch.cpu
import arch.x86_64.fpu
import arch.msr
import gfx.fbmtrr
import arch.x86_64.apic
import apprights.policy

export {
    init, create, start, schedule, on_tick, yield_now, sleep_ticks, idle_wait,
    dead_sleeps,
    exit_task, reap, claim_zombie, reap_claimed, S_REAPING, lock_gone,
    kill_current, wake_pid, wait_sleep, stopped_child, stop_claim, find_pid, current, tget, tset, task_at,
    stack_high, STACK_PAINT,
    guard_faults, guard_last_pid, guard_last_depth, guard_broken,
    trace_push, trace_dump, dump_tasks, ready_count, alive_count,
    irq_save, irq_restore, set_kernel_stack,
    adopt, enter_task, set_idle, zombies, reap_all, free_slots, cpu_of, cpu_mask,
    clear_signals,
    set_affinity, affinity, ANY_CPU, ring3_foreign,
    gs_report, gs_ready, gs_error, ring3_cores, gs_expected, gs_check,
    kstack_here, kstack_again, ring3_all_set, ring3_all_get, hier,
    gs_lie_set, gs_lie_get, r3blind_set, r3blind_an,
    ring3_report, syscalls_of, syscalls_sum, core_count, ring3_procs,
    T_STATE, T_PID, T_RSP, T_KSTACK, T_KTOP, T_PRIO, T_BUDGET, T_WORK,
    T_WAKE, T_CR3, T_PARENT, T_EXIT, T_RUNS, T_ENTRY, T_USTACK, T_KIND,
    T_WAITPID, T_TICKS, T_PDPT, T_PD, T_PT, T_DATA, T_CWD, T_ARG,
    T_END, T_BORN, T_FD, T_FDOFF, T_FAULTS, FD_SLOTS, T_BRK, T_MMAP,
    S_FREE, S_READY, S_RUN, S_SLEEP, S_WAIT, S_ZOMBIE, S_NEW, S_STOP,
    T_SIGPEND, T_SIGMASK, T_SIGLAST, T_PGID, T_SID, T_TTY, T_SIGDEL, T_STOPSIG,
    T_ITIV, T_ALTSP, T_ALTSZ, T_SUSP, T_SUSPMASK, T_RESV, T_RESNEXT, T_COMMA, T_COMMB,
    T_SIGRET, T_ALARM, T_TGID, T_SHARED, T_FUTEX, T_FUTEXVAL, T_FDOWN,
    T_KILLCODE, T_UID, T_GID, T_EUID, T_EGID, T_SUID,
    T_SGID, T_UMASK, K_BOOT, K_IDLE, K_WORKER, K_USER,
    K_GRIND, KSTACK_FRAMES, K_NETD, K_AIO, K_VEC, K_YIELD, K_ARGON, K_WLAN, T_BIG, T_LAZY,
    T_NETV, T_NETOK, NETOK_MAX, T_DISKR, T_DISKW,
    S_POLL, T_POLLSEQ, poll_seq, poll_kick, poll_kick_one, poll_sleep,
    POLL_FOREVER,
    // ---- RUNDE MULTIUSER ----
    T_NGROUPS, groups_count, groups_at, groups_has, groups_set,
    groups_clear, groups_inherit, GROUPS_MAX,
    // ---- ROUND SESSUID ----
    T_EXAS, session_identity,
    // ---- RUNDE AVX ----
    T_FPU, fpu_area, fpu_set_area, fpu_inherit, fpu_reset,
    // ---- RUNDE LAUFZEIT ----
    T_FSBASE, T_GSBASE, fsbase_apply,
    // ---- DELL STABILITY ----
    state_cas, schedule_locked, KILL_SET, KILL_PLAIN, kill_requested, stop_sleep, kill_other, KILL_DONE, KILL_LATER, KILL_GONE, group_of, group_live, kill_group,
    // ---- RUNDE O-CONTAINER ----
    T_CTR,
    // ---- RUNDE SPEICHERDRUCK (K-002) ----
    T_UPAGES, T_OOMSAFE,
    // ---- AB-003 ----
    T_ORIGIN,
}

// ------------------------------------------------------ the task record

const T_STATE: u64 = 0 // one of the S_* below
const T_PID: u64 = 8
const T_RSP: u64 = 16 // where the switch left the stack pointer
const T_KSTACK: u64 = 24 // lowest octet of the kernel stack
const T_KTOP: u64 = 32 // upper end of it
const T_PRIO: u64 = 40 // 1..3, also the length of a turn in ticks
const T_BUDGET: u64 = 48 // ticks left in this turn
const T_WORK: u64 = 56 // what the task counted up itself; in a
// process before its start: its argument
const T_WAKE: u64 = 64 // tick at which a sleeper is due
const T_CR3: u64 = 72 // its address space
const T_PARENT: u64 = 80 // index of the creator
const T_EXIT: u64 = 88 // the code it left with
const T_RUNS: u64 = 96 // how often it got the processor
const T_ENTRY: u64 = 104 // rip in ring 3
const T_USTACK: u64 = 112 // rsp in ring 3
const T_KIND: u64 = 120 // K_* below
const T_WAITPID: u64 = 128 // which child it is waiting for
const T_TICKS: u64 = 136 // timer ticks spent in this task
const T_PDPT: u64 = 144 // the four frames of its page tables
const T_PD: u64 = 152
const T_PT: u64 = 160
const T_DATA: u64 = 168 // its private data page (physical)
const T_CWD: u64 = 176 // inode of the working directory
const T_ARG: u64 = 184 // which program of uprog.fi (proc.fi)
const T_END: u64 = 192 // tick at which it ended
// r146: T_BORN = the tick at which the task was created (age for SYS_PSTAT). It takes the first of the
// three dead descriptor words (T_FD, 200..223): the descriptors moved to kernel/file.fi in round K4 and
// nothing reads or writes T_FD since. The record is zeroed on creation, both creators set T_BORN.
const T_BORN: u64 = 200
const T_FD: u64 = 200 // (dead since K4; first word = T_BORN) three open files: inode + 1, 0 = closed
const T_FDOFF: u64 = 224 // and the read/write position of each
const T_FAULTS: u64 = 248 // faults it caused

// ROUND K4. A record is 512 octets now (`kstate.TASK_BYTES`), and what the
// new half holds is what a POSIX process has besides its code: where its
// program break stands and how far its mmap area has grown down. The
// DESCRIPTORS moved out of the record altogether -- `kernel/file.fi`
// keeps them, because `dup2` and `fork` need two descriptors to be able to
// mean ONE open file, and an inode in the record cannot do that.
const T_BRK: u64 = 256 // `brk`, 0 = the process has never asked
const T_MMAP: u64 = 264 // the lower end of the mmap area, 0 = none yet

const T_SIGPEND: u64 = 272
const T_SIGMASK: u64 = 280 // blockierte Signale
const T_SIGLAST: u64 = 288 // das zuletzt zugestellte
const T_PGID: u64 = 296 // Prozessgruppe (0 = die eigene pid)
const T_SID: u64 = 304 // Sitzung
const T_TTY: u64 = 312 // beherrschendes Terminal + 1, 0 = keines
const T_SIGDEL: u64 = 320 // wie viele Signale zugestellt wurden
const T_STOPSIG: u64 = 328
const T_SIGRET: u64 = 336
const T_ALARM: u64 = 344
const T_TGID: u64 = 352 // Fadengruppe (clone), 0 = die eigene pid
const T_SHARED: u64 = 360
const T_FUTEX: u64 = 368
const T_FUTEXVAL: u64 = 376
const T_KILLCODE: u64 = 384

const T_UID: u64 = 392 // die echte Benutzerkennung
const T_GID: u64 = 400 // die echte Gruppenkennung
const T_EUID: u64 = 408
const T_EGID: u64 = 416
const T_SUID: u64 = 424 // die gesicherte (setuid-Bit, `su`)
const T_SGID: u64 = 432
const T_UMASK: u64 = 440 // was `open`/`mkdir` abziehen
const T_BIG: u64 = 448

// ------------------------------------------- ROUND NETVIEW: THE NETWORK
//
// WHICH NETWORK THIS PROCESS SEES. 0 = the wire, and 0 is what
// `sched.create` leaves behind when it zeroes the record -- so every
// process that existed before this round, and every process started
// without anybody saying otherwise, goes on seeing exactly what it saw.
// The four values and what they mean are in `kernel/netview.fi`; the
// only thing the scheduler knows about them is that they are a number in
// a slot.
//
// AND THE LIST OF DESTINATIONS the `filtered` view lets through, six
// words, 0 = empty. They stand HERE and not in a table of their own for
// the reason round K13 gave for the six identity words twelve lines
// above: an attribute of a process belongs in the record of that
// process, and a second table beside the task table is a second place
// to forget to clear.
//
// The record has been 512 octets since round K4.
const T_NETV: u64 = 456
const T_NETOK: u64 = 464
const NETOK_MAX: u64 = 6

const T_POLLSEQ: u64 = 504

// ------------------------------------- RUNDE MULTIUSER: DIE ZUSATZGRUPPEN
const T_NGROUPS: u64 = 512

// ROUND SESSUID: ONE PENDING "START THE CHILD AS THE SESSION USER" MARK
// PER TASK. 520 is a free word (512 + 8; the group LIST lives in the MU
// table, not in the record). `SYS_OSUM_EXECAS` (1005, sys.fi) sets it on
// the CALLER for the length of one `exec` and clears it again;
// `create` below reads it from `current` and hands the child the
// identity of the signed-in user instead of the caller's. It is a word
// of the task and not a word of the machine on purpose: two callers in
// `exec` at the same moment cannot take each other's mark, and a mark
// that is lost can only leave the child with the caller's own identity
// -- never with a stranger's.
const T_EXAS: u64 = 520

const T_DISKR: u64 = 536
const T_DISKW: u64 = 544

const T_FPU: u64 = 640

const T_FSBASE: u64 = 648
const T_GSBASE: u64 = 528

// RUNDE O-CONTAINER: IN WELCHEM CONTAINER DIESE AUFGABE LAEUFT.
const T_CTR: u64 = 656

// ==================================================== RUNDE SPEICHERDRUCK
const T_UPAGES: u64 = 664
const T_OOMSAFE: u64 = 672
// ==================================================== AB-003
//
// WHERE THE PROCESS COMES FROM: 32 octets, a zero-terminated label such
// as `app:notes` or `jarvis`, empty = the system / the user. Written only
// by `kernel/sched/origin.fi` (the rules are there). 688..719, behind
// T_OOMSAFE (672) and a free word, far below TASK_BYTES (1024); the
// record is zeroed on creation, so every task starts empty.
const T_ORIGIN: u64 = 688
// RUNDE EVENTS (signals): 720..759, behind T_ORIGIN (688..719), far below TASK_BYTES (1024). Zeroed in `clear_signals`.
const T_ITIV: u64 = 720 // setitimer(ITIMER_REAL): the interval in ticks, 0 = one-shot
const T_ALTSP: u64 = 728 // sigaltstack: base of the alternate signal stack
const T_ALTSZ: u64 = 736 // its size, 0 = none
const T_SUSP: u64 = 744 // sigsuspend: 1 = the signal mask is a temporary one, T_SUSPMASK is the one to give back
const T_SUSPMASK: u64 = 752
const T_RESV: u64 = 768 // RUNDE LIMITS3: 15 pairs (start, length) of PROT_NONE reservations above 4 GiB, 768..1007 (kernel/sys/sys.fi res_*)
// RUNDE LC1: the process name (prctl PR_SET_NAME/PR_GET_NAME, /proc/<pid>/status Name): 15 characters + NUL in two free words
// (680 = characters 0..7, 760 = characters 8..14; the 16th octet is the implicit NUL). Zero = never set (status falls back to the kind name).
const T_COMMA: u64 = 680
const T_COMMB: u64 = 760
const T_LAZY: u64 = 992
const T_RESNEXT: u64 = 1008 // their bump pointer; zeroed with the record (create) and by exec
// LC-001 (CLONE_FILES): whose descriptor table this task uses. Bits 0..15 = slot + 1 of the table owner
// (0 = its own table), 16..47 = the owner's pid at share time, bit 63 = this task let go of the table
// (see file.owner / file.release_use). Zeroed with the record by create.
const T_FDOWN: u64 = 1016
const GROUPS_MAX: u64 = 16

// The three descriptor slots of round 62. Nothing writes them any more;
// they stay named so that a reader of a task dump knows what the hole in
// the middle of the record was.
const FD_SLOTS: u64 = 3

const S_FREE: u64 = 0
const S_READY: u64 = 1
const S_RUN: u64 = 2
const S_SLEEP: u64 = 3
const S_WAIT: u64 = 4
const S_ZOMBIE: u64 = 5
// Under construction: the record exists, the stack exists, and the
// scheduler must NOT take it yet. Round 62 learned this the hard way --
// `proc.create` fills in the address space and the entry point AFTER the
// task record, and a timer interrupt in between started a process whose
// rip was still zero. A task becomes runnable when its creator says so,
// and not a moment earlier.
const S_NEW: u64 = 6
const S_STOP: u64 = 7
const S_POLL: u64 = 8
// BEING REAPED (27.09.2026). Exactly one reaper has claimed the zombie with
// `claim_zombie` and is giving its address space back. Before this state
// existed, "is it a zombie? then proc.reap" was a check and an act without a
// lock in between: the parent's wait4, the desktop's launcher loop and the
// kernel's wait loops could all reap the SAME task at once on different
// cores. Every frame of its address space went back to the free list twice,
// was handed out twice, and a page table ended up holding a new program's
// code (#GP in proc.free_space, VM with 4 cores, and the Dell crashes).
const S_REAPING: u64 = 9
const POLL_FOREVER: u64 = 0xFFFFFFFFFFFFFFFF

const K_BOOT: u64 = 0
const K_IDLE: u64 = 1
const K_WORKER: u64 = 2
const K_USER: u64 = 3
// ROUND K5. A kernel task that does ARITHMETIC and nothing else. The
// worker of round 62 spins on `pause`, which is the right instruction for
// showing that a task is interruptible and the wrong one for measuring
// how fast four cores are: QEMU's translator leaves the emulation loop at
// every `pause`, so eight such tasks on four cores are eight tasks
// waiting on the emulator, not on the processor.
const K_GRIND: u64 = 4
// ROUND K8: the task that moves frames between the card and the TCP/IP
// stack. It is a task and not a loop inside a system call because a
// `ping` from the other side has to be answered while every process in
// this system is waiting for something else. Its body is
// `inet.netd_body`, reached through `tasks.main` like every other kernel
// task.
const K_NETD: u64 = 5
const K_AIO: u64 = 6
const K_VEC: u64 = 7
const K_YIELD: u64 = 8
const K_ARGON: u64 = 9
const K_WLAN: u64 = 10

// ROUND 62 had two, and two were enough for what a system call did then:
// write an octet, look up an inode, hand a page back. ROUND K1 made the
// deepest system call much deeper --
//
//   syscall_entry -> sys.entry -> do_exec -> elf.spawn -> elf.load
//                 -> elf.segment -> fs.read_at -> blk.read -> ata_read
//
// -- and it overflowed, in a way worth writing down because it is the
// kind of bug that looks like something else: the stack ran off its lower
// end into the frame below, a `ret` picked up an octet of a neighbouring
// page as a return address, and the machine died at a #GP or a #UD whose
// rip was an address in its own stack, with a register dump that pointed
// at the ATA driver. The driver was innocent. It was simply the deepest
// thing on the stack when it broke.
//
//     osum: kstack deepest=16384 of 16384
//
//     *** EXCEPTION 6 #UD  rip=0x9fc42  rsp=0x506ff8
//
//   sys.dispatch -> do_read -> vfs_read -> vfs.v_read -> fat.read
//                -> blk.read_on -> usb.msc_read -> usb.bot
//                -> xhci.bulk -> xhci.wait_ep -> xhci.drain
//
//   user fault: pid=4  vector=14  err=0x15  cr2=0xd70  rip=0xd70
//     spur rsp=0x40079dd0  phys=0x3169dd0  kstack=0x2eca000
//         0x573068 0x573068 0x505fd0 0x505fd0 0x527000 0x3169f00 ...
const KSTACK_FRAMES: u64 = 32

// What an untouched octet of kernel stack looks like.
const STACK_PAINT: u64 = 0x5A5A5A5A5A5A5A5A

const GUARD_PAINT: u64 = 0xC0DEFACEC0DEFACE

// Indices in the table out of isr.s.
const V_SWITCH: u64 = 55
const V_GUARD: u64 = 57
const V_TASK_MAIN: u64 = 62

fn vector(state: u64, i: u64) -> u64 {
    return __mmio_read64((kstate.get(state, kstate.VECTORS) + i * 8) as *mut u64)
}

// ------------------------------------------------------- the accesses

fn task_at(state: u64, i: u64) -> u64 {
    return state + kstate.TASK_OFF + i * kstate.TASK_BYTES
}

fn tget(state: u64, i: u64, field: u64) -> u64 {
    return __mmio_read64((task_at(state, i) + field) as *mut u64)
}

fn tset(state: u64, i: u64, field: u64, v: u64) {
    __mmio_write64((task_at(state, i) + field) as *mut u64, v)
}

// DELL STABILITY (08.10.2026): THE LOCK-FREE WAKE-UPS MUST NOT OVERWRITE A
// STATE THEY DID NOT SEE. `wake_pid`, `poll_kick`, `send_task` and the timer
// used to read "S_WAIT" and then store "S_READY" with two plain accesses. In
// between, the sleeper could have been woken by someone else and scheduled
// on another core (S_RUN): the store then turned a RUNNING task into a READY
// one, a third core picked it up with the stack pointer of its last switch,
// and two cores ran on one kernel stack (garbage return addresses, #GP/#UD).
// The change is one atomic compare-and-swap: it takes effect only if the
// state is still the one the caller looked at.
fn state_cas(state: u64, i: u64, from: u64, to: u64) -> bool {
    if i >= kstate.MAX_TASKS {
        return false
    }
    let won: bool = atomic.cas(task_at(state, i) + T_STATE, from, to) == from
    if won && to == S_READY {
        // AR-2b: a blocked task of an app became ready again = one wakeup of that app.
        let ap_wake: u64 = policy.acct_addr(task_at(state, i) + T_ORIGIN, policy.A_WAKE)
        if ap_wake != 0 {
            atomic.fetch_add(ap_wake, 1)
        }
        // W-SMP3: a task became READY while THIS core is busy -> wake one sleeping application core now (not at core 0's next tick).
        kick_one(state, i)
    }
    return won
}

// `kill_pid` could not end the task at once because it was running on
// another core: the request is carried in T_KILLCODE (KILL_SET + exit code)
// and the task ends itself at its next trap / system call return.
const KILL_SET: u64 = 0x4000000000000000

// An exit_group() status is a plain exit code, never "died of a signal": a status in 129..191 must not turn into WTERMSIG.
const KILL_PLAIN: u64 = 0x2000000000000000

fn kill_requested(state: u64, i: u64) -> bool {
    return (tget(state, i, T_KILLCODE) & KILL_SET) != 0
}

// ----------------------------- RUNDE MULTIUSER: die Zusatzgruppen
fn groups_slot(state: u64, i: u64, k: u64) -> u64 {
    return state + kstate.MU_OFF + kstate.MU_GRP
        + (i * kstate.MU_GRPMAX + k) * 8
}

fn groups_count(state: u64, i: u64) -> u64 {
    let n: u64 = tget(state, i, T_NGROUPS)
    if n > GROUPS_MAX {
        return GROUPS_MAX
    }
    return n
}

fn groups_at(state: u64, i: u64, k: u64) -> u64 {
    if k >= GROUPS_MAX {
        return 0
    }
    return __mmio_read64(groups_slot(state, i, k) as *mut u64)
}

fn groups_has(state: u64, i: u64, gid: u64) -> bool {
    let n: u64 = groups_count(state, i)
    var k: u64 = 0
    while k < n {
        if groups_at(state, i, k) == gid {
            return true
        }
        k = k + 1
    }
    return false
}

fn groups_clear(state: u64, i: u64) {
    tset(state, i, T_NGROUPS, 0)
    var k: u64 = 0
    while k < GROUPS_MAX {
        __mmio_write64(groups_slot(state, i, k) as *mut u64, 0)
        k = k + 1
    }
}

fn groups_set(state: u64, i: u64, src: u64, n: u64) -> bool {
    if n > GROUPS_MAX {
        return false
    }
    groups_clear(state, i)
    var k: u64 = 0
    while k < n {
        __mmio_write64(groups_slot(state, i, k) as *mut u64,
            __mmio_read64((src + k * 8) as *mut u64))
        k = k + 1
    }
    tset(state, i, T_NGROUPS, n)
    return true
}

fn groups_inherit(state: u64, kind: u64, parent_kind: u64) {
    let n: u64 = groups_count(state, parent_kind)
    var k: u64 = 0
    while k < GROUPS_MAX {
        var v: u64 = 0
        if k < n {
            v = groups_at(state, parent_kind, k)
        }
        __mmio_write64(groups_slot(state, kind, k) as *mut u64, v)
        k = k + 1
    }
    tset(state, kind, T_NGROUPS, n)
}

// ROUND SESSUID: THE IDENTITY OF THE PERSON WHO IS SIGNED IN.
//
// `glogin` records the session owner (SYS_OSUM_SPERRE op 7 -> SP_UID,
// root only) and then drops to that user itself. The taskbar and the
// start menu are started by the kernel BEFORE anybody signs in and stay
// root, and everything they started used to stay root with them. A
// child that `SYS_OSUM_EXECAS` starts for the session gets this
// identity: uid/euid/suid = SP_UID, and the rest of it (gid, umask,
// supplementary groups) from a LIVING task that already carries exactly
// that uid -- the desktop `glogin` started. Without such a donor the
// child gets gid = uid, umask 022 and NO groups. The groups of the
// caller (root) are never copied: that would be the privilege the
// whole thing takes away.
//
// No session (SP_UID == 0: an image without sign-in) changes nothing --
// the child keeps the caller's identity, as before this round.
fn session_identity(state: u64, slot: u64) {
    let uid: u64 = kstate.get(state, kstate.K11_OFF + kstate.SP_UID)
    if uid == 0 {
        return
    }
    var donor: u64 = kstate.MAX_TASKS
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if i != slot && tget(state, i, T_STATE) != S_FREE
            && tget(state, i, T_UID) == uid
            && tget(state, i, T_EUID) == uid
            && tget(state, i, T_SUID) == uid {
            donor = i
            i = n
        } else {
            i = i + 1
        }
    }
    tset(state, slot, T_UID, uid)
    tset(state, slot, T_EUID, uid)
    tset(state, slot, T_SUID, uid)
    if donor < kstate.MAX_TASKS {
        tset(state, slot, T_GID, tget(state, donor, T_GID))
        tset(state, slot, T_EGID, tget(state, donor, T_EGID))
        tset(state, slot, T_SGID, tget(state, donor, T_SGID))
        tset(state, slot, T_UMASK, tget(state, donor, T_UMASK))
        groups_inherit(state, slot, donor)
    } else {
        tset(state, slot, T_GID, uid)
        tset(state, slot, T_EGID, uid)
        tset(state, slot, T_SGID, uid)
        tset(state, slot, T_UMASK, 18)
        groups_clear(state, slot)
    }
}

// ROUND K5. This used to be one word for the whole machine
// (`kstate.CURRENT`). With four cores it has to be one word PER CORE --
// a scheduler that reads a single global "the running task" hands the
// same task to two processors, and then two stacks are one stack.
fn current(state: u64) -> u64 {
    return cpu.get(state, cpu.here(state), cpu.C_CUR)
}

// The second table round K5 needs: which core last ran a task, and which
// cores have ever run it. It lies beside the task table rather than in it
// because the task record is exactly full (248 + 8 = 256 = TASK_BYTES).
const TC_CPU: u64 = 0
const TC_MASK: u64 = 8
const TC_AFF: u64 = 16 // the only core that may run this task
const ANY_CPU: u64 = 99 // ... or this, when any of them may

fn tc_set(state: u64, i: u64, field: u64, v: u64) {
    __mmio_write64((state + kstate.TCPU_OFF + i * kstate.TCPU_BYTES + field)
        as *mut u64, v)
}

fn tc_get(state: u64, i: u64, field: u64) -> u64 {
    return __mmio_read64((state + kstate.TCPU_OFF + i * kstate.TCPU_BYTES
            +field) as *mut u64)
}

fn cpu_of(state: u64, i: u64) -> u64 {
    return tc_get(state, i, TC_CPU)
}

fn cpu_mask(state: u64, i: u64) -> u64 {
    return tc_get(state, i, TC_MASK)
}

// AFFINITY, and round K5 needs exactly one of it. Task 0 is
// `kernel_main` itself, and three things it does afterwards belong to the
// BOOT processor and to no other: the excursion into ring 3 (whose MSRs
// `user.setup` wrote on the boot processor alone), the word `isr.s` reads
// the kernel stack out of, and the two static save slots of `enter_user`.
// Without this, `kernel_main` migrates to whichever core happens to be
// free -- which is what a scheduler is supposed to do, and which broke
// the run in one attempt out of six until the reason was found.
fn set_affinity(state: u64, i: u64, c: u64) {
    tc_set(state, i, TC_AFF, c)
}

fn affinity(state: u64, i: u64) -> u64 {
    return tc_get(state, i, TC_AFF)
}

fn may_run(state: u64, i: u64, me: u64) -> bool {
    let a: u64 = tc_get(state, i, TC_AFF)
    return a == ANY_CPU || a == me
}

fn ring3_allowed(state: u64, i: u64, me: u64) -> bool {
    if tget(state, i, T_KIND) != K_USER {
        return true
    }
    if r3blind != 0 {
        return true
    }
    if ring3_all == 0 {
        return me == 0
    }
    return me == 0 || gs_ready(state, me)
}

static mut ring3_all: u64 = 1
static mut gs_lie: u64 = 0
static mut r3blind: u64 = 0

fn gs_lie_set(v: u64) {
    gs_lie = v
}

fn gs_lie_get() -> u64 {
    return gs_lie
}

fn r3blind_set(v: u64) {
    r3blind = v
}

fn r3blind_an() -> u64 {
    return r3blind
}

fn ring3_all_set(v: u64) {
    ring3_all = v
}

fn ring3_all_get() -> u64 {
    return ring3_all
}

static mut gs_good: [u64; 8] = [0 as u64; 8]

fn gs_report(state: u64, me: u64, is_good: bool) {
    if me >= 8 {
        return
    }
    if is_good {
        gs_good[me as usize] = 1
    } else {
        gs_good[me as usize] = 2
    }
}

fn kstack_again(state: u64) {
    set_kernel_stack(state, tget(state, current(state), T_KTOP))
}

fn kstack_here(state: u64) -> u64 {
    return cpu.get(state, cpu.here(state), cpu.C_KSTACK)
}

fn hier(state: u64) -> u64 {
    return cpu.here(state)
}

fn gs_expected(state: u64) -> u64 {
    return cpu.record(state, cpu.here(state))
}

fn gs_check(state: u64, baseline: u64) -> bool {
    let me: u64 = cpu.here(state)
    let is_good: bool = baseline == cpu.record(state, me)
    gs_report(state, me, is_good)
    return is_good
}

fn gs_ready(state: u64, me: u64) -> bool {
    if me >= 8 {
        return false
    }
    return gs_good[me as usize] == 1
}

fn gs_error(state: u64) -> u64 {
    var i: u64 = 0
    var c: u64 = 0
    while i < 8 {
        if gs_good[i as usize] == 2 {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn ring3_cores(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var mask_union: u64 = 0
    while i < n {
        if tget(state, i, T_KIND) == K_USER {
            mask_union = mask_union | tc_get(state, i, TC_MASK)
        }
        i = i + 1
    }
    var c: u64 = 0
    var b: u64 = 0
    while b < 8 {
        if ((mask_union >> b) & 1) != 0 {
            c = c + 1
        }
        b = b + 1
    }
    return c
}

fn core_count(state: u64) -> u64 {
    return cpu.count(state)
}

fn syscalls_of(state: u64, k: u64) -> u64 {
    if k >= kstate.MAX_CPUS {
        return 0
    }
    return cpu.get(state, k, cpu.C_SYSCALLS)
}

fn syscalls_sum(state: u64) -> u64 {
    var k: u64 = 0
    var n: u64 = 0
    while k < cpu.count(state) {
        n = n + cpu.get(state, k, cpu.C_SYSCALLS)
        k = k + 1
    }
    return n
}

fn ring3_procs(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var c: u64 = 0
    while i < n {
        if tget(state, i, T_KIND) == K_USER
        && tget(state, i, T_STATE) != S_FREE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn bits_in(v: u64) -> u64 {
    var b: u64 = 0
    var c: u64 = 0
    while b < 64 {
        if ((v >> b) & 1) != 0 {
            c = c + 1
        }
        b = b + 1
    }
    return c
}

fn ring3_report(state: u64) {
    var s_p: [u8; 9] = "r3: pid=\0"
    var s_k: [u8; 8] = "  core=\0"
    var s_m: [u8; 8] = "  mask=\0"
    var s_n: [u8; 5] = "  n=\0"
    var s_r: [u8; 9] = "  runs=\0\0"
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var all_mask: u64 = 0
    var proc_count: u64 = 0
    while i < n {
        if tget(state, i, T_KIND) == K_USER
        && tget(state, i, T_STATE) != S_FREE {
            let m: u64 = tc_get(state, i, TC_MASK)
            all_mask = all_mask | m
            proc_count = proc_count + 1
            let z: u64 = serial.line_at(cpu.here(state))
            serial.puts((&s_p[0]) as u64)
            serial.dec(tget(state, i, T_PID))
            serial.puts((&s_k[0]) as u64)
            serial.dec(tc_get(state, i, TC_CPU))
            serial.puts((&s_m[0]) as u64)
            serial.hex(m)
            serial.puts((&s_n[0]) as u64)
            serial.dec(bits_in(m))
            serial.puts((&s_r[0]) as u64)
            serial.dec(tget(state, i, T_RUNS))
            serial.nl()
            serial.line_clear(z)
        }
        i = i + 1
    }
    let z2: u64 = serial.line_at(cpu.here(state))
    var s_g: [u8; 12] = "r3: procs=\0\0"
    var s_gk: [u8; 9] = "  cores=\0"
    var s_gn: [u8; 5] = "  n=\0"
    var s_gf: [u8; 12] = "  foreign=\0\0"
    var s_ga: [u8; 7] = "  all=\0"
    serial.puts((&s_g[0]) as u64)
    serial.dec(proc_count)
    serial.puts((&s_gk[0]) as u64)
    serial.hex(all_mask)
    serial.puts((&s_gn[0]) as u64)
    serial.dec(bits_in(all_mask))
    serial.puts((&s_gf[0]) as u64)
    serial.dec(ring3_foreign(state))
    serial.puts((&s_ga[0]) as u64)
    serial.dec(ring3_all)
    serial.nl()
    serial.line_clear(z2)
    let z3: u64 = serial.line_at(cpu.here(state))
    var s_s: [u8; 14] = "r3: syscalls \0"
    var s_c: [u8; 3] = " c\0"
    var s_e: [u8; 2] = "=\0"
    var s_su: [u8; 8] = "  sum=\0\0"
    var s_ab: [u8; 9] = "  diff=\0\0"
    serial.puts((&s_s[0]) as u64)
    // A-006 (24.09.2026): the global counter is read BEFORE and AFTER the
    // per-core ones, not once afterwards. The other cores keep making
    // system calls while this line is printed; one read at the end
    // measured the time the printing took (abw=247 / 208 with -smp 4/8),
    // not a lost count. isr.s counts per core on ENTRY, sys.dispatch
    // globally a few instructions later, so at every instant
    //     global <= per-core sum <= global + (calls between the two) .
    // Read as  ks0 <= sum <= ks1 + cores  the promise is exact and the
    // printing does not enter it; `abw` is the distance outside that window.
    let ks0: u64 = kstate.get(state, kstate.SYSCALLS)
    var k: u64 = 0
    var sum: u64 = 0
    while k < cpu.count(state) {
        let v: u64 = cpu.get(state, k, cpu.C_SYSCALLS)
        sum = sum + v
        serial.puts((&s_c[0]) as u64)
        serial.dec(k)
        serial.puts((&s_e[0]) as u64)
        serial.dec(v)
        k = k + 1
    }
    serial.puts((&s_su[0]) as u64)
    serial.dec(sum)
    serial.puts((&s_ab[0]) as u64)
    let ks1: u64 = kstate.get(state, kstate.SYSCALLS)
    let hi: u64 = ks1 + cpu.count(state)
    if sum < ks0 {
        serial.dec(ks0 - sum)
    } else if sum > hi {
        serial.dec(sum - hi)
    } else {
        serial.dec(0)
    }
    serial.nl()
    serial.line_clear(z3)
}

fn ring3_foreign(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var c: u64 = 0
    while i < n {
        let on_cpu: u64 = tc_get(state, i, TC_CPU)
        if tget(state, i, T_KIND) == K_USER && on_cpu != 0
        && on_cpu < kstate.MAX_CPUS {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// ------------------------------------------------- the interrupt flag

// A critical section in a kernel is not a lock -- on one processor it is
// the interrupt flag. `irq_save` turns interrupts off AND says whether
// they were on; `irq_restore` puts back exactly that state. Plain
// `cli`/`sti` would switch them on in places where they have to stay off
// (inside an interrupt handler, for instance).
// ROUND K5: still true, and no longer SUFFICIENT. Turning interrupts off
// keeps the OTHER cores out of nothing at all; what it protects is this
// core against its own interrupt handler. Every place that used to make
// do with it and touches shared state now takes a lock as well -- and
// takes it with interrupts already off, because a handler that waits for
// a lock its own core holds waits for ever.
fn irq_save() -> u64 {
    return asm("pushfq\npop rax\ncli", out("rax"))
}

fn irq_restore(flags: u64) {
    if (flags & 0x200) != 0 {
        asm("sti")
    }
}

// ------------------------------------------------------------ the trace

// One octet per turn: which pid got the processor. That is the evidence
// for interleaving -- not a claim of the kernel but the list of the
// switches it really made.
fn trace_push(state: u64, v: u64) {
    let n: u64 = kstate.get(state, kstate.TRACE_LEN)
    if n < kstate.TRACE_MAX {
        kstate.set8(state + kstate.TRACE_OFF + n, (v & 0xFF) as u8)
        kstate.set(state, kstate.TRACE_LEN, n + 1)
    }
}

fn trace_dump(state: u64, label: u64, limit: u64) {
    var n: u64 = kstate.get(state, kstate.TRACE_LEN)
    if limit != 0 && n > limit {
        n = limit
    }
    serial.puts(label)
    var i: u64 = 0
    while i < n {
        serial.dec(kstate.get8(state + kstate.TRACE_OFF + i))
        serial.put(32 as u8)
        i = i + 1
    }
    serial.nl()
}

// ------------------------------------------------------------ creating

// Task 0 is the one that is already running: `kernel_main` itself. It
// gets a record so that the switch has somewhere to put its stack
// pointer -- its stack is the one out of boot.s.
fn init(state: u64) {
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        tset(state, i, T_STATE, S_FREE)
        i = i + 1
    }
    kstate.set(state, kstate.TASKS, 1)
    kstate.set(state, kstate.NEXT_PID, 2)
    var l: u64 = 0
    while l < kstate.LOCK_COUNT {
        atomic.lock_init(state, l)
        l = l + 1
    }
    var c: u64 = 0
    while c < kstate.MAX_CPUS {
        cpu.set(state, c, cpu.C_CUR, 0)
        c = c + 1
    }
    kstate.set(state, kstate.PREEMPT, 1)
    tset(state, 0, T_STATE, S_RUN)
    tset(state, 0, T_PID, 1)
    tset(state, 0, T_PRIO, 2)
    tset(state, 0, T_BUDGET, 2)
    tset(state, 0, T_KIND, K_BOOT)
    tset(state, 0, T_PGID, 1)
    tset(state, 0, T_SID, 1)
    tset(state, 0, T_TGID, 1)
    tset(state, 0, T_KTOP, vector(state, 61))
    tset(state, 0, T_CR3, kstate.get(state, kstate.KPML4))
    var t: u64 = 0
    while t < kstate.MAX_TASKS {
        tc_set(state, t, TC_AFF, ANY_CPU)
        t = t + 1
    }
    // The one task in this kernel that is not allowed to move.
    tc_set(state, 0, TC_AFF, 0)
    tset(state, 0, T_FPU, fpu.area_new(state))
    set_kernel_stack(state, vector(state, 61))
    trace_push(state, 1)
}

// The idle task of the BOOT processor. Kept in `kstate.IDLE` as before
// (several counters read it) and in the per-core record, because from
// round K5 on every core has one of its own.
fn set_idle(state: u64, i: u64) {
    kstate.set(state, kstate.IDLE, i)
    cpu.set(state, cpu.here(state), cpu.C_IDLE, i)
}

// A record for a context that is ALREADY running -- the way `init` gives
// task 0 to `kernel_main`, only later and for a core that has just come
// up. Its stack is not one the frame allocator handed out for a task, so
// T_KSTACK stays zero and `reap` will not give it back.
fn adopt(state: u64, kind: u64, prio: u64, ktop: u64) -> u64 {
    let vec_area: u64 = fpu.area_new(state)
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    var i: u64 = 1
    var slot: u64 = 0
    while i < kstate.MAX_TASKS {
        if tget(state, i, T_STATE) == S_FREE {
            slot = i
            i = kstate.MAX_TASKS
        } else {
            i = i + 1
        }
    }
    if slot == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        fpu.area_free(state, vec_area)
        return 0
    }
    var j: u64 = 0
    while j < kstate.TASK_BYTES / 8 {
        __mmio_write64((task_at(state, slot) + j * 8) as *mut u64, 0)
        j = j + 1
    }
    tset(state, slot, T_PID, kstate.add(state, kstate.NEXT_PID, 1) - 1)
    tset(state, slot, T_BORN, kstate.get(state, kstate.TICKS))
    tset(state, slot, T_FPU, vec_area)
    tset(state, slot, T_KTOP, ktop)
    tset(state, slot, T_PRIO, prio)
    tset(state, slot, T_BUDGET, prio)
    tset(state, slot, T_KIND, kind)
    tset(state, slot, T_CR3, kstate.get(state, kstate.KPML4))
    tset(state, slot, T_STATE, S_RUN)
    tc_set(state, slot, TC_CPU, cpu.here(state))
    tc_set(state, slot, TC_MASK, 1 << cpu.here(state))
    tc_set(state, slot, 24, 0) // RUNDE UNTERBAU: no FD_CLOEXEC marks from the slot's previous task
    tc_set(state, slot, TC_AFF, cpu.here(state))
    clear_signals(state, slot)
    if slot + 1 > kstate.get(state, kstate.TASKS) {
        kstate.set(state, kstate.TASKS, slot + 1)
    }
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return slot
}

// The initial stack of a task that has never run. It is built so that it
// looks EXACTLY like a task the switch stepped out of a moment ago -- see
// the layout in switch.s. That way `context_switch` needs no special case
// for a first start.
fn frame_build(state: u64, ktop: u64, entry: u64, a0: u64, a1: u64,
    a2: u64) -> u64 {
    let base: u64 = ktop - 144
    var i: u64 = 0
    while i < 18 {
        __mmio_write64((base + i * 8) as *mut u64, 0)
        i = i + 1
    }
    // ROUND K5: IF OFF, not on. A task that has never run starts with
    // the run queue lock held -- the core that switched to it took it and
    // could not give it back, because giving it back before the switch
    // would let a third core pick up a task whose registers are not saved
    // yet. `enter_task`, the first line of every task body, gives the
    // lock back and only THEN switches interrupts on. Starting with them
    // on would let this core's own timer interrupt run into a lock this
    // core holds.
    __mmio_write64(base as *mut u64, 0x002) // rflags: IF off until enter_task
    __mmio_write64((base + 72) as *mut u64, a0) // rdi
    __mmio_write64((base + 80) as *mut u64, a1) // rsi
    __mmio_write64((base + 104) as *mut u64, a2) // rdx
    __mmio_write64((base + 128) as *mut u64, entry) // where `ret` goes
    __mmio_write64((base + 136) as *mut u64, vector(state, V_GUARD))
    return base
}

// A new task. `entry` is the address of the Firn function it starts in
// (out of the table in isr.s, because Firn cannot name the address of a
// function of its own in the kernel profile); it gets `state`, its index
// and `kind` as arguments. Returns the index, or 0 when the table is
// full -- index 0 is `kernel_main` and can never be handed out.
// ROUND K5: the stack is fetched BEFORE the run queue lock is taken, and
// that order is not cosmetic. The frame allocator has a lock of its own
// now; a core that held the run queue and then asked for a frame would be
// holding two locks in an order that another core takes the other way
// round the moment it faults in an interrupt. The rule this kernel keeps
// is the simplest one that cannot deadlock: NO LOCK IS EVER HELD WHILE
// ANOTHER IS TAKEN.
fn create(state: u64, kind: u64, prio: u64, arg: u64, entry: u64) -> u64 {
    let raw_base: u64 = mem.frame_run(state, KSTACK_FRAMES + 1)
    if raw_base == 0 {
        return 0
    }
    let stack: u64 = raw_base + mem.FRAME_SIZE
    guard_paint(stack)
    let vec_area: u64 = fpu.area_new(state)
    if vec_area == 0 && fpu.enabled(state) {
        free_stack(state, stack)
        return 0
    }
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    var i: u64 = 1
    var slot: u64 = 0
    while i < kstate.MAX_TASKS {
        if tget(state, i, T_STATE) == S_FREE {
            slot = i
            i = kstate.MAX_TASKS
        } else {
            i = i + 1
        }
    }
    if slot == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        free_stack(state, stack)
        fpu.area_free(state, vec_area)
        return 0
    }
    let ktop: u64 = stack + KSTACK_FRAMES * mem.FRAME_SIZE
    // ROUND K1: paint it, so that afterwards it can be said how much of
    // it was ever used. `frame_build` writes over the top 136 octets of
    // this in a moment; everything below is the measurement.
    var w: u64 = stack
    while w < ktop {
        __mmio_write64(w as *mut u64, STACK_PAINT)
        w = w + 8
    }
    var real_entry: u64 = entry
    if real_entry == 0 {
        real_entry = vector(state, V_TASK_MAIN)
    }
    var j: u64 = 0
    while j < kstate.TASK_BYTES / 8 {
        __mmio_write64((task_at(state, slot) + j * 8) as *mut u64, 0)
        j = j + 1
    }
    tset(state, slot, T_PID, kstate.add(state, kstate.NEXT_PID, 1) - 1)
    tset(state, slot, T_BORN, kstate.get(state, kstate.TICKS))
    tset(state, slot, T_KSTACK, stack)
    tset(state, slot, T_FPU, vec_area)
    tset(state, slot, T_KTOP, ktop)
    tset(state, slot, T_PRIO, prio)
    tset(state, slot, T_BUDGET, prio)
    tset(state, slot, T_KIND, kind)
    tset(state, slot, T_ARG, arg)
    tset(state, slot, T_PARENT, current(state))
    let par: u64 = current(state)
    tset(state, slot, T_UID, tget(state, par, T_UID))
    tset(state, slot, T_GID, tget(state, par, T_GID))
    tset(state, slot, T_EUID, tget(state, par, T_EUID))
    tset(state, slot, T_EGID, tget(state, par, T_EGID))
    tset(state, slot, T_SUID, tget(state, par, T_SUID))
    tset(state, slot, T_SGID, tget(state, par, T_SGID))
    tset(state, slot, T_UMASK, tget(state, par, T_UMASK))
    groups_inherit(state, slot, par)
    // ROUND SESSUID: a root caller that asked for `SYS_OSUM_EXECAS` mode 0
    // gets a child that belongs to the person at the keyboard.
    if tget(state, par, T_EXAS) != 0 {
        session_identity(state, slot)
    }
    tset(state, slot, T_CR3, kstate.get(state, kstate.KPML4))
    tset(state, slot, T_CWD, kstate.get(state, kstate.FS_ROOT))
    tset(state, slot, T_RSP, frame_build(state, ktop, real_entry, state,
            slot, kind))
    tset(state, slot, T_STATE, S_NEW)
    if slot + 1 > kstate.get(state, kstate.TASKS) {
        kstate.set(state, kstate.TASKS, slot + 1)
    }
    tc_set(state, slot, TC_CPU, kstate.MAX_CPUS)
    tc_set(state, slot, TC_MASK, 0)
    if kind == K_USER && ring3_all == 0 {
        tc_set(state, slot, TC_AFF, 0)
    } else {
        tc_set(state, slot, TC_AFF, ANY_CPU)
    }
    clear_signals(state, slot)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return slot
}

const SIG_SLOTS: u64 = 32
const SIG_ENTRY: u64 = 24

fn clear_signals(state: u64, i: u64) {
    if i >= kstate.MAX_TASKS {
        return
    }
    let base: u64 = state + kstate.SIG_OFF + i * (SIG_SLOTS * SIG_ENTRY)
    var k: u64 = 0
    while k < (SIG_SLOTS * SIG_ENTRY) / 8 {
        __mmio_write64((base + k * 8) as *mut u64, 0)
        k = k + 1
    }
    let rt: u64 = state + kstate.SIGRT_OFF + i * kstate.SIGRT_TASK
    var q: u64 = 0
    while q < kstate.SIGRT_TASK / 8 {
        __mmio_write64((rt + q * 8) as *mut u64, 0)
        q = q + 1
    }
    tset(state, i, T_SIGPEND, 0)
    tset(state, i, T_SIGMASK, 0)
    tset(state, i, T_SIGRET, 0)
    tset(state, i, T_ALARM, 0)
    tset(state, i, T_ITIV, 0)
    tset(state, i, T_ALTSP, 0)
    tset(state, i, T_ALTSZ, 0)
    tset(state, i, T_SUSP, 0)
    tset(state, i, T_STOPSIG, 0)
    tset(state, i, T_SIGLAST, 0) // RUNDE UNTERBAU: bit 8 ("died of a signal") must not outlive the task in this slot
    let pid: u64 = tget(state, i, T_PID)
    tset(state, i, T_PGID, pid)
    tset(state, i, T_SID, pid)
    tset(state, i, T_TGID, pid)
}

fn free_stack(state: u64, stack: u64) {
    if stack == 0 {
        return
    }
    var k: u64 = 0
    while k < KSTACK_FRAMES + 1 {
        mem.frame_free(state, stack - mem.FRAME_SIZE + k * mem.FRAME_SIZE)
        k = k + 1
    }
}

fn guard_paint(stack: u64) {
    let g: u64 = stack - mem.FRAME_SIZE
    var w: u64 = g
    while w < stack {
        __mmio_write64(w as *mut u64, GUARD_PAINT)
        w = w + 8
    }
}

static mut watch_breaks: u64 = 0
static mut watch_pid: u64 = 0
static mut watch_depth: u64 = 0

fn guard_broken(state: u64, i: u64) -> bool {
    let stack: u64 = tget(state, i, T_KSTACK)
    if stack == 0 {
        return false
    }
    let g: u64 = stack - mem.FRAME_SIZE
    if __mmio_read64((stack - 8) as *mut u64) != GUARD_PAINT {
        return true
    }
    return __mmio_read64(g as *mut u64) != GUARD_PAINT
}

fn guard_depth(state: u64, i: u64) -> u64 {
    let stack: u64 = tget(state, i, T_KSTACK)
    if stack == 0 {
        return 0
    }
    let g: u64 = stack - mem.FRAME_SIZE
    var p: u64 = stack
    while p > g {
        p = p - 8
        if __mmio_read64(p as *mut u64) != GUARD_PAINT {
            return stack - p
        }
    }
    return 0
}

fn guard_check(state: u64, i: u64) {
    if !guard_broken(state, i) {
        return
    }
    var s_a: [u8; 29] = "KERNEL STACK OVERFLOW: task \0"
    var s_p: [u8; 7] = "  pid=\0"
    var s_t: [u8; 9] = "  depth=\0"
    var s_k: [u8; 10] = "  kstack=\0"
    watch_breaks = watch_breaks + 1
    watch_pid = tget(state, i, T_PID)
    watch_depth = guard_depth(state, i)
    serial.puts((&s_a[0]) as u64)
    serial.dec(i)
    serial.puts((&s_p[0]) as u64)
    serial.dec(watch_pid)
    serial.puts((&s_t[0]) as u64)
    serial.dec(watch_depth)
    serial.puts((&s_k[0]) as u64)
    serial.hex(tget(state, i, T_KSTACK))
    serial.nl()
    guard_paint(tget(state, i, T_KSTACK))
}

fn guard_faults() -> u64 {
    return watch_breaks
}

fn guard_last_pid() -> u64 {
    return watch_pid
}

fn guard_last_depth() -> u64 {
    return watch_depth
}

// ROUND K1: the deepest this task's kernel stack has ever been, in
// octets. The paint of `create` is looked for from the LOWER end
// upwards; the first octet that is not paint any more is the deepest
// point anything ever wrote to. A task that overflowed its stack reports
// the full size -- and that is the number that has to stay below it.
fn stack_high(state: u64, i: u64) -> u64 {
    let base: u64 = tget(state, i, T_KSTACK)
    let ktop: u64 = tget(state, i, T_KTOP)
    if base == 0 || ktop <= base {
        return 0
    }
    var p: u64 = base
    while p < ktop {
        if __mmio_read64(p as *mut u64) != STACK_PAINT {
            return ktop - p
        }
        p = p + 8
    }
    return 0
}

// Now it may run. Whoever created the task decides when it is complete.
fn start(state: u64, i: u64) -> bool {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if tget(state, i, T_STATE) != S_NEW {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return false
    }
    tset(state, i, T_STATE, S_READY)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    kick_one(state, i)
    return true
}

fn set_kernel_stack(state: u64, ktop: u64) {
    let me: u64 = cpu.here(state)
    cpu.set(state, me, cpu.C_KSTACK, ktop)
    var tss: u64 = cpu.get(state, me, cpu.C_TSSADDR)
    if tss == 0 {
        tss = kstate.get(state, kstate.TSS)
    }
    if tss != 0 {
        __mmio_write64((tss + 4) as *mut u64, ktop)
    }
    if me == 0 {
        kstate.set(state, kstate.KSTACK_CUR, ktop)
    }
}

// The first line of every task body (`tasks.main`, `proc.user_start`).
// See `frame_build`: the lock comes from the core that started this task.
fn enter_task(state: u64) {
    atomic.lock_give(state, atomic.L_SCHED)
    asm("sti")
}

// -------------------------------------------------------- the decision

fn ready_count(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if tget(state, i, T_KIND) != K_IDLE && tget(state, i, T_STATE) == S_READY {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// How many corpses of a kind are lying about. The boot processor waits on
// this while the other cores work the tasks off.
fn zombies(state: u64, kind: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if tget(state, i, T_KIND) == kind && tget(state, i, T_STATE) == S_ZOMBIE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// DELL ROUND: how many slots of the task table are free (slot 0 is never
// given out). 0 means every further program is refused.
fn free_slots(state: u64) -> u64 {
    var i: u64 = 1
    var c: u64 = 0
    while i < kstate.MAX_TASKS {
        if tget(state, i, T_STATE) == S_FREE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn reap_all(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var c: u64 = 0
    while i < n {
        if reap(state, i) {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// Everything that is not free and not a corpse.
fn alive_count(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        let st: u64 = tget(state, i, T_STATE)
        if st != S_FREE && st != S_ZOMBIE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// Round robin: from the current task onwards, the first ready one. The
// idle task is skipped -- it only gets the processor when nobody else
// wants it.
// ROUND K5: two changes, both forced by the second core. EVERY idle task
// is skipped, not only the one whose index stood in `kstate.IDLE` -- each
// core has one now. And what is returned when nothing is ready is THIS
// core's idle task, not the boot processor's; two cores on one idle task
// would be two cores on one stack.
//
// Only the caller of this function under the run queue lock may act on
// the answer. A task that is S_READY here is claimed by the caller before
// the lock is given up, which is what keeps two cores from taking it.
fn pick(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    let cur: u64 = current(state)
    let me: u64 = cpu.here(state)
    let myidle: u64 = cpu.get(state, me, cpu.C_IDLE)
    // DD-12 (K-004c): a core that has been asked to park (S3) takes no
    // new task; what it runs now goes back to the queue at this switch
    // and the other cores pick it up. The boot processor is never parked.
    if me != 0 && myidle != 0 && cpu.get(state, me, cpu.C_PARKREQ) != 0 {
        return myidle
    }
    var k: u64 = 1
    while k <= n {
        let i: u64 = (cur + k) % n
        if tget(state, i, T_KIND) != K_IDLE && tget(state, i, T_STATE) == S_READY
        && may_run(state, i, me) && ring3_allowed(state, i, me) {
            return i
        }
        k = k + 1
    }
    if tget(state, cur, T_STATE) == S_RUN {
        return cur
    }
    return myidle
}

// The switch itself. Everything that is per task and lives outside the
// task record is put in place here: the address space, the kernel stack
// for the next entry out of ring 3 -- and only then the stack pointer.
fn switch_to(state: u64, from: u64, to: u64) {
    let me: u64 = cpu.here(state)
    cpu.set(state, me, cpu.C_CUR, to)
    cpu.add(state, me, cpu.C_SWITCHES, 1)
    if tget(state, to, T_KIND) != K_IDLE {
        cpu.add(state, me, cpu.C_PICKS, 1)
    }
    tc_set(state, to, TC_CPU, me)
    tc_set(state, to, TC_MASK, tc_get(state, to, TC_MASK) | (1 << me))
    if me != 0 && tget(state, to, T_KIND) != K_IDLE && cpu.x_get(state, me, cpu.X_HALTED) != 0
    && !kstate.mode_on(state, kstate.M_APSLOW) {
        cpu.x_set(state, me, cpu.X_HALTED, 0)
        cpu.x_set(state, me, cpu.X_PEND, 0)
        apic.timer_rate(state, 1)
    }
    kstate.add(state, kstate.SWITCHES, 1)
    tset(state, to, T_RUNS, tget(state, to, T_RUNS) + 1)
    trace_push(state, tget(state, to, T_PID))
    let cr3: u64 = tget(state, to, T_CR3)
    if cr3 != 0 {
        let now: u64 = asm("mov rax, cr3", out("rax"))
        if cr3 != now {
            asm("mov cr3, rax", in("rax") cr3, clobber("memory"))
        }
    }
    set_kernel_stack(state, tget(state, to, T_KTOP))
    fpu.switch(state, me, fpu_area(state, from), fpu_area(state, to))
    fsbase_apply(state, to)
    asm("call rax", in("rax") vector(state, V_SWITCH),
        in("rdi") task_at(state, from) + T_RSP,
        in("rsi") tget(state, to, T_RSP), clobber("memory"))
}

fn fsbase_apply(state: u64, i: u64) {
    if i >= kstate.MAX_TASKS {
        return
    }
    let b: u64 = tget(state, i, T_FSBASE)
    msr.wr(state, MSR_FS_BASE, b)
    msr.wr(state, MSR_KERNEL_GS_BASE, tget(state, i, T_GSBASE))
}

const MSR_FS_BASE: u64 = 0xC0000100
const MSR_KERNEL_GS_BASE: u64 = 0xC0000102

fn fpu_area(state: u64, i: u64) -> u64 {
    if i >= kstate.MAX_TASKS {
        return 0
    }
    return tget(state, i, T_FPU)
}

fn fpu_set_area(state: u64, i: u64, area: u64) {
    if i < kstate.MAX_TASKS {
        tset(state, i, T_FPU, area)
    }
}

fn fpu_inherit(state: u64, parent: u64, child: u64) {
    fpu.sync_here(state, fpu_area(state, parent))
    fpu.area_copy(state, fpu_area(state, child), fpu_area(state, parent))
}

fn fpu_reset(state: u64, i: u64) {
    let a: u64 = fpu_area(state, i)
    if a == 0 {
        return
    }
    fpu.area_init(state, a)
    fpu.adopt_now(state, a)
}

// Give the processor away. Comes back when this task is scheduled again
// -- or never, if it is a corpse by then.
//
// ROUND K5, AND THIS IS THE HEART OF IT. The run queue lock is taken here
// and is NOT given back here: it is given back by whoever the processor
// switches TO, in that task's own `schedule_locked` right after its
// `switch_to` came back, or -- for a task that has never run -- in
// `enter_task`, its first line.
//
// The reason is one race and there is no cheaper cure. If the lock were
// given back before `switch_to`, another core could pick up the task this
// core has just marked S_READY -- while this core is still executing on
// that task's stack, inside `context_switch`, with its registers not yet
// written down. Two cores, one stack. Holding the lock across the switch
// means: while any core is between "I have chosen" and "the registers are
// saved", no other core is choosing anything.
fn schedule(state: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    schedule_locked(state)
    irq_restore(flags)
}

// The run queue lock must be held. On return it is held again -- by this
// task, on whichever core resumed it.
// ================================ RUNDE O-CONTAINER: DER CPU-ANTEIL
const CTR_BYTES_: u64 = 256
const X_CPUSH_: u64 = 40
const X_CPUTICK_: u64 = 48

fn ctr_share_of(state: u64, t: u64) -> u64 {
    if t >= kstate.MAX_TASKS {
        return 0
    }
    let c: u64 = tget(state, t, T_CTR)
    if c == 0 || c >= 8 {
        return 0
    }
    return kstate.get(state, kstate.CTR_OFF + c * CTR_BYTES_ + X_CPUSH_)
}

fn ctr_tick(state: u64, t: u64) {
    if t >= kstate.MAX_TASKS {
        return
    }
    let c: u64 = tget(state, t, T_CTR)
    if c == 0 || c >= 8 {
        return
    }
    let a: u64 = kstate.CTR_OFF + c * CTR_BYTES_ + X_CPUTICK_
    kstate.set(state, a, kstate.get(state, a) + 1)
}

fn budget_for(state: u64, t: u64) -> u64 {
    let p: u64 = tget(state, t, T_PRIO)
    let sh: u64 = ctr_share_of(state, t)
    if sh == 0 || sh >= 100 {
        return p
    }
    let b: u64 = (p * sh) / 100
    if b == 0 {
        return 1
    }
    return b
}

fn schedule_locked(state: u64) {
    let cur: u64 = current(state)
    let next: u64 = pick(state)
    if next == cur {
        // r378 (06.10.2026): `cur` may be READY here and still be the task that
        // is running. A task that went to sleep (S_WAIT, S_SLEEP, S_POLL) is
        // made READY by `wake_pid` / `poll_kick` WITHOUT the lock, and when that
        // happens between its state write and this pick, `pick` finds it again
        // (the loop ends at cur). Without the line below it returned with the
        // state READY: a second core then picked the task that was running on
        // this one, with the stack pointer of its LAST switch, and two cores ran
        // on one kernel stack (#UD / #GP at garbage return addresses, 2 of 12
        // boots with 4 cores and two spawns at once).
        tset(state, cur, T_STATE, S_RUN)
        tset(state, cur, T_BUDGET, budget_for(state, cur))
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    // GUARD (27.09.2026): the VM showed a #DF with rsp near 0 on core 3 --
    // a core had loaded a task whose saved stack pointer was 0, i.e. a
    // task that was never switched out (running on another core, or an
    // adopted idle task). Stop right here with the evidence in the
    // registers instead of running on page 0 until something faults:
    // rdi = next, rsi = its T_RSP, rdx = its state, rcx = its kind,
    // r8 = this core, r9 = cur, r10 = the core it last ran on.
    let next_rsp: u64 = tget(state, next, T_RSP)
    if next_rsp < 0x1000 || tget(state, next, T_STATE) == S_RUN {
        asm("ud2", in("rdi") next, in("rsi") next_rsp,
            in("rdx") tget(state, next, T_STATE), in("rcx") tget(state, next, T_KIND),
            in("r8") cpu.here(state), in("r9") cur,
            in("r10") tc_get(state, next, TC_CPU), clobber("memory"))
    }
    if tget(state, cur, T_STATE) == S_RUN {
        tset(state, cur, T_STATE, S_READY)
    }
    tset(state, next, T_STATE, S_RUN)
    tset(state, next, T_BUDGET, budget_for(state, next))
    ctr_tick(state, cur)
    switch_to(state, cur, next)
    atomic.lock_give(state, atomic.L_SCHED)
}

fn yield_now(state: u64) {
    schedule(state)
}

// --------------------------------------------------------- the timer

// Called out of the interrupt handler, after the end-of-interrupt. Two
// jobs: wake what is due, and take the processor away when the turn is
// over.
// Called out of the interrupt handler, on EVERY core, with interrupts
// already off -- which is why the lock may be taken here at all.
// vboxlag: the PAT register is per core. The boot core sets index 4 to write-combining when the screen comes up (`fb.pat_setup`), the
// other cores were started earlier and still have write-back there. Every core copies the value in its next tick (once; bit per core).
// The offsets are `fb.FB_OFF + S_PATVAL / S_PATDONE`.
fn pat_here(state: u64, me: u64) {
    if me >= 63 {
        return
    }
    let patv: u64 = kstate.get(state, 0x3C000 + 0x938)
    if patv == 0 {
        return
    }
    let bit: u64 = 1 << me
    if (kstate.get(state, 0x3C000 + 0x940) & bit) != 0 {
        return
    }
    if msr.wr(state, 0x277, patv) {
        // the mappings were made under the old value on this core: drop its translations and its cache lines once
        let c: u64 = asm("mov rax, cr3", out("rax"))
        asm("mov cr3, rax", in("rax") c)
        asm("wbinvd")
    }
    atomic.fetch_add(state + 0x3C000 + 0x940, bit)
}

// W-SMP2: THE KICK. Application cores that have nothing to do sleep in `hlt` with a 10 Hz tick (W-TSC); nothing woke them when a task
// became READY, so core 0 took everything and the others stayed at 0 %. Called from the boot core's timer tick (scheduler lock held)
// when core 0 itself is busy: for every READY task that a sleeping core may run, send ONE timer-vector IPI to such a core. The ISR is
// the normal tick (harmless: counted in C_TICKS), the core leaves `hlt`, and its idle loop calls `yield_now` -> `pick` takes the task.
// A core with a kick pending is not kicked again; `nokick` on the command line switches all of it off (counter-proof).
// W-SMP3: the DIRECT kick -- the same IPI as `kick_idle_cores`, but for ONE task that just became READY (`state_cas` to READY, `start`).
// Only when the calling core is busy with a real task: an idle core takes the new task itself, so a quiet desktop sends none (idle budget).
fn kick_one(state: u64, i: u64) {
    if kstate.mode_on(state, kstate.M_NOKICK) {
        return
    }
    let nc: u64 = cpu.count(state)
    if nc <= 1 {
        return
    }
    let me: u64 = cpu.here(state)
    if me < 8 && desk_hlt[me as usize] != 0 {
        return
    }
    let cur: u64 = current(state)
    if cur >= kstate.MAX_TASKS || tget(state, cur, T_KIND) == K_IDLE || cur == i {
        return
    }
    var k: u64 = 1
    while k < nc && k < 8 {
        if k != me && cpu.get(state, k, cpu.C_ONLINE) != 0 && cpu.x_get(state, k, cpu.X_HALTED) != 0
        && cpu.x_get(state, k, cpu.X_PEND) == 0 && may_run(state, i, k) && ring3_allowed(state, i, k) {
            cpu.x_set(state, k, cpu.X_PEND, 1)
            cpu.x_add(state, k, cpu.X_KICKTX, 1)
            apic.ipi(state, cpu.apic_id(state, k), apic.VEC_TIMER | 0x4000)
            return
        }
        k = k + 1
    }
}

fn kick_idle_cores(state: u64) {
    if kstate.mode_on(state, kstate.M_NOKICK) {
        return
    }
    let nc: u64 = cpu.count(state)
    if nc <= 1 {
        return
    }
    var sleeping: u64 = 0
    var k: u64 = 1
    while k < nc && k < 8 {
        if cpu.get(state, k, cpu.C_ONLINE) != 0 && cpu.x_get(state, k, cpu.X_HALTED) != 0
        && cpu.x_get(state, k, cpu.X_PEND) == 0 {
            sleeping = sleeping | (1 << k)
        }
        k = k + 1
    }
    if sleeping == 0 {
        return
    }
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n && sleeping != 0 {
        if tget(state, i, T_STATE) == S_READY && tget(state, i, T_KIND) != K_IDLE {
            var j: u64 = 1
            while j < nc && j < 8 {
                if (sleeping & (1 << j)) != 0 && may_run(state, i, j) && ring3_allowed(state, i, j) {
                    cpu.x_set(state, j, cpu.X_PEND, 1)
                    cpu.x_add(state, j, cpu.X_KICKTX, 1)
                    apic.ipi(state, cpu.apic_id(state, j), apic.VEC_TIMER | 0x4000)
                    sleeping = sleeping ^ (1 << j)
                    j = 8
                } else {
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
}

fn on_tick(state: u64) {
    let me: u64 = cpu.here(state)
    cpu.add(state, me, cpu.C_TICKS, 1)
    pat_here(state, me)
    fbmtrr.here(state, me)
    atomic.lock_take(state, atomic.L_SCHED, me)
    let now: u64 = kstate.get(state, kstate.TICKS)
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        let ts: u64 = tget(state, i, T_STATE)
        if (ts == S_SLEEP || ts == S_POLL) && tget(state, i, T_WAKE) <= now {
            state_cas(state, i, ts, S_READY)
        }
        i = i + 1
    }
    let cur: u64 = current(state)
    // 04.10.2026 (Dell): a tick that falls into `idle_wait` belongs to the
    // core's IDLE task, not to the boot task that is waiting -- otherwise
    // `ps` and the taskbar's CPU gauge both call a waiting desktop "busy".
    var tick_to: u64 = cur
    var in_wait: bool = false
    if me < 8 && desk_hlt[me as usize] != 0 {
        in_wait = true
        var it: u64 = cpu.get(state, me, cpu.C_IDLE)
        if it == 0 {
            it = kstate.get(state, kstate.IDLE)
        }
        if it != 0 && it < kstate.MAX_TASKS {
            tick_to = it
        }
    }
    tset(state, tick_to, T_TICKS, tget(state, tick_to, T_TICKS) + 1)
    // AR-2b: the same tick, booked to the app whose label the task carries (unlabelled: one byte compare).
    let ap_cpu: u64 = policy.acct_addr(task_at(state, tick_to) + T_ORIGIN, policy.A_CPU)
    if ap_cpu != 0 {
        atomic.fetch_add(ap_cpu, 1)
    }
    let idle_now: bool = tget(state, cur, T_KIND) == K_IDLE || in_wait
    if idle_now {
        cpu.add(state, me, cpu.C_IDLETICKS, 1)
    }
    // W-SMP2: TIME-weighted accounting. An idle application core ticks at 10 Hz and a busy one at 100 Hz, so tick counts of
    // different cores must not be added up; the cycles since this core's previous tick are booked to what it was doing now.
    let tsc_now: u64 = apic.tsc()
    let tsc_last: u64 = cpu.x_get(state, me, cpu.X_LASTTSC)
    if tsc_last != 0 && tsc_now > tsc_last {
        cpu.x_add(state, me, cpu.X_TOTCYC, tsc_now - tsc_last)
        if idle_now {
            cpu.x_add(state, me, cpu.X_IDLECYC, tsc_now - tsc_last)
        }
    }
    cpu.x_set(state, me, cpu.X_LASTTSC, tsc_now)
    if me != 0 && cpu.x_get(state, me, cpu.X_PEND) != 0 {
        cpu.x_add(state, me, cpu.X_KICKRX, 1)
    }
    if !idle_now {
        kick_idle_cores(state)
    }
    guard_check(state, cur)
    if kstate.get(state, kstate.PREEMPT) == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    let budget: u64 = tget(state, cur, T_BUDGET)
    if budget > 1 {
        tset(state, cur, T_BUDGET, budget - 1)
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    tset(state, cur, T_BUDGET, 0)
    schedule_locked(state)
}

// ---------------------------------------------------------- blocking

fn timer_tot(state: u64) -> bool {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return false
    }
    let k: u64 = cpu.here(state)
    let now_ticks: u64 = kstate.get(state, kstate.TICKS)
    let t: u64 = apic.tsc()
    let mark_ticks: u64 = cpu.get(state, k, cpu.C_TOTMARKE)
    if now_ticks != mark_ticks {
        // r1268 (VirtualBox boss VM, 1 vCPU, 100 % host burn): `tsc_hz` is calibrated
        // against the emulated PIT and came out 10x too low (198 MHz, the counter really
        // runs ~2.1 GHz), so "hz / 3" was ~30 ms of real time, i.e. three ticks. Every short
        // stall declared the timer dead and `sleep_ticks` of the terminal reader spun in
        // `yield_now` for ever (13 million refusals in 100 s). The wait for a dead timer is
        // therefore measured in ticks as seen on THIS core: a smoothed cycles-per-tick
        // value (C_TOTPER) from the observations below; the gap must exceed eight of them.
        let time0: u64 = cpu.get(state, k, cpu.C_TOTZEIT)
        if mark_ticks != 0 && time0 != 0 && t > time0 && now_ticks > mark_ticks {
            var d: u64 = (t - time0) / (now_ticks - mark_ticks)
            let per0: u64 = cpu.get(state, k, cpu.C_TOTPER)
            if per0 == 0 {
                cpu.set(state, k, cpu.C_TOTPER, d)
            } else {
                if d > per0 * 4 {
                    d = per0 * 4
                }
                cpu.set(state, k, cpu.C_TOTPER, (per0 * 3 + d) / 4)
            }
        }
        cpu.set(state, k, cpu.C_TOTMARKE, now_ticks)
        cpu.set(state, k, cpu.C_TOTZEIT, t)
        return false
    }
    let mark_time: u64 = cpu.get(state, k, cpu.C_TOTZEIT)
    if mark_time == 0 {
        cpu.set(state, k, cpu.C_TOTZEIT, t)
        return false
    }
    var limit: u64 = hz / 3
    let per: u64 = cpu.get(state, k, cpu.C_TOTPER)
    if per != 0 && per * 8 > limit {
        limit = per * 8
    }
    if t > mark_time && t - mark_time > limit {
        cpu.add(state, k, cpu.C_TOTZAHL, 1)
        return true
    }
    return false
}

fn dead_sleeps(state: u64) -> u64 {
    var sum: u64 = 0
    var k: u64 = 0
    while k < cpu.count(state) {
        sum = sum + cpu.get(state, k, cpu.C_TOTZAHL)
        k = k + 1
    }
    return sum
}

// `ticks` timer ticks, 10 ms each at 100 Hz. Zero is a yield.
// 04.10.2026 (DELL): THE DESKTOP LOOP MUST NOT SPIN. The desktop loop runs in
// the boot task and its `sleep_ticks` hands the core straight back (measured:
// 97 % of core 0 in 30 s with nothing on the screen, ~8 rounds per tick, the
// core's idle task never ran; the taskbar's "CPU 100 %" reads exactly this
// core). `idle_wait` waits for the next interrupt (timer: 10 ms; a key or a
// pointer packet comes sooner) and tells `on_tick` that the core was idle.
static mut desk_hlt: [u64; 8] = [0 as u64; 8]

fn idle_wait(state: u64) {
    let me: u64 = cpu.here(state)
    if me >= 8 {
        return
    }
    desk_hlt[me as usize] = 1
    asm("sti\nhlt")
    desk_hlt[me as usize] = 0
}

// r1307 (W-STALLFIX): RATE-LIMITED SLEEP WHILE THE TIMER WATCHDOG FIRES.
// Under VirtualBox/NEM an exit storm lets the guest's virtual clock lag minutes behind the real one (VirtSync catch-up): the ticks
// then arrive late, `timer_tot` turns true, and the old answer -- a bare `yield_now` -- made every sleeper (desktop loop, taskbar,
// starter, terminal reader) run its full poll round as fast as it could. Each round costs port/MMIO exits (50-100 us each in NEM),
// which deepens the lag: self-reinforcing, only Pause/Resume broke it. Now the rounds of one core are spaced `min(ticks, 2)` tick
// lengths apart on the TSC (one tick = max(hz / 100, the smoothed cycles-per-tick seen on this core)), the wait is `pause` (no exit)
// in 1 ms slices with a `yield_now` between them (other ready tasks still run), and it ends early the moment a tick arrives. A
// really dead timer is still survived (sleepers come back after at most two tick lengths), but at <= 100 rounds/s per core.
// `tot_last` = TSC stamp of the last round let through on this core (shared by all tasks of the core: their sum is limited).
static mut tot_last: [u64; 8] = [0 as u64; 8]
static mut tot_waits: u64 = 0

fn sleep_tot(state: u64, ticks: u64) {
    let me: u64 = cpu.here(state)
    var hz: u64 = apic.tsc_hz(state)
    if me >= 8 || hz < 100000000 || hz > 10000000000 {
        yield_now(state)
        return
    }
    var per: u64 = hz / 100
    let seen: u64 = cpu.get(state, me, cpu.C_TOTPER)
    if seen > per {
        per = seen
    }
    if per > hz / 10 {
        per = hz / 10
    }
    var n: u64 = ticks
    if n > 2 {
        n = 2
    }
    let t0: u64 = kstate.get(state, kstate.TICKS)
    let next: u64 = tot_last[me as usize] + n * per
    tot_waits = tot_waits + 1
    // r1321 (boss VM freeze after a click, 20.10.2026): the old wait spun on `pause` for the whole span with
    // interrupts OFF (a syscall sleeper, e.g. nanosleep). Dump of the frozen boss VM: vCPU2 sat in this
    // loop for 22 minutes without a single exit, vCPU0/1 halted, VirtSync "catchup" lag 1310 s and growing,
    // all TM counters frozen -- only Pause/Resume woke it. VirtualBox catches its virtual-sync clock up while
    // vCPUs are IDLE (HLT), never while one burns exit-free: so the wait now HALTS (interrupts on for the
    // halt only) and wakes with the next interrupt (BSP tick 10 ms, AP tick 100 ms, IPIs, input), after a
    // `yield_now` that lets other ready tasks of the core run first. Never more than two tick lengths.
    var guard: u64 = 0
    while apic.tsc() < next && kstate.get(state, kstate.TICKS) == t0 && guard < 4 {
        yield_now(state)
        if apic.tsc() < next && kstate.get(state, kstate.TICKS) == t0 {
            let fl: u64 = irq_save()
            asm("sti\nhlt")
            irq_restore(fl)
        }
        guard = guard + 1
    }
    tot_last[me as usize] = apic.tsc()
}

fn sleep_ticks(state: u64, ticks: u64) {
    if ticks == 0 {
        yield_now(state)
        return
    }
    if timer_tot(state) {
        sleep_tot(state, ticks)
        return
    }
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    tset(state, cur, T_WAKE, kstate.get(state, kstate.TICKS) + ticks)
    tset(state, cur, T_STATE, S_SLEEP)
    schedule_locked(state)
    irq_restore(flags)
}

// Go to sleep until a child `want` (0 = any) changes. State and the
// switch happen under ONE hold of L_SCHED (27.09.2026). wait4 used to write
// S_WAIT without the lock and call `schedule` afterwards: a child exiting on
// another core in that gap woke the parent (S_READY) while it was still
// running here, a third core picked it up with the stack pointer of its LAST
// switch, and two cores ran on one kernel stack -- #GP/#DF at garbage return
// addresses right after a script started a program (VM, 4 cores: every time).
fn wait_sleep(state: u64, want: u64, untraced: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    // A child that died between the caller's look and this lock has
    // already called wake_pid -- nobody would wake us again.
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) == S_ZOMBIE && tget(state, i, T_PARENT) == cur
            && (want == 0 || tget(state, i, T_PID) == want) && !group_live(state, i) {
            atomic.lock_give(state, atomic.L_SCHED)
            irq_restore(flags)
            return
        }
        if untraced != 0 && tget(state, i, T_PARENT) == cur && (want == 0 || tget(state, i, T_PID) == want)
            && stop_unreported(tget(state, i, T_STOPSIG)) {
            atomic.lock_give(state, atomic.L_SCHED)
            irq_restore(flags)
            return
        }
        i = i + 1
    }
    tset(state, cur, T_WAITPID, want)
    tset(state, cur, T_STATE, S_WAIT)
    schedule_locked(state)
    irq_restore(flags)
}

const STOP_REPORTED: u64 = 256

fn stop_unreported(stopsig: u64) -> bool {
    return stopsig != 0 && (stopsig & STOP_REPORTED) == 0
}

fn stopped_child(state: u64, me: u64, want: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_PARENT) == me && (want == 0 || tget(state, i, T_PID) == want)
            && stop_unreported(tget(state, i, T_STOPSIG)) {
            return i
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

fn stop_claim(state: u64, task: u64) -> u64 {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let sig: u64 = tget(state, task, T_STOPSIG)
    var claimed: u64 = 0
    if stop_unreported(sig) {
        tset(state, task, T_STOPSIG, sig | STOP_REPORTED)
        claimed = sig
    }
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return claimed
}

// SIGSTOP & co: S_STOP and the switch under one hold of L_SCHED. `contbit`
// is the pending-signal bit of SIGCONT: one that arrived before we got the
// lock must not be slept through.
fn stop_sleep(state: u64, contbit: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    if (tget(state, cur, T_SIGPEND) & contbit) != 0 {
        tset(state, cur, T_STOPSIG, 0)
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return
    }
    tset(state, cur, T_STATE, S_STOP)
    schedule_locked(state)
    irq_restore(flags)
}

// Whoever waits for this pid becomes ready again.
fn wake_pid(state: u64, pid: u64) {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) == S_WAIT {
            let w: u64 = tget(state, i, T_WAITPID)
            if w == 0 || w == pid {
                state_cas(state, i, S_WAIT, S_READY)
            }
        }
        i = i + 1
    }
}

// ------------------------------------------------- RUNDE POLL: WECKEN
fn poll_seq(state: u64) -> u64 {
    return kstate.get(state, kstate.POLLSEQ)
}

fn poll_kick(state: u64) {
    kstate.add(state, kstate.POLLSEQ, 1)
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) == S_POLL {
            state_cas(state, i, S_POLL, S_READY)
        }
        i = i + 1
    }
}

fn poll_kick_one(state: u64, task: u64) {
    kstate.add(state, kstate.POLLSEQ, 1)
    if task >= kstate.MAX_TASKS {
        return
    }
    if tget(state, task, T_STATE) == S_POLL {
        state_cas(state, task, S_POLL, S_READY)
    }
}

fn poll_sleep(state: u64, seen: u64, deadline: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if kstate.get(state, kstate.POLLSEQ) != seen {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return
    }
    let cur: u64 = current(state)
    tset(state, cur, T_POLLSEQ, seen)
    tset(state, cur, T_WAKE, deadline)
    tset(state, cur, T_STATE, S_POLL)
    schedule_locked(state)
    irq_restore(flags)
}

fn find_pid(state: u64, pid: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) != S_FREE && tget(state, i, T_PID) == pid {
            return i
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

// ------------------------------------------------------------ the end

// r389 (06.10.2026): THE LOCKER DIES, THE LOCK MUST FORGET ITS SLOT AT ONCE.
// While the screen is locked `SP_SLOT` names the task slot of the locker and
// `osum_sperre` op 4 ("be the locker") accepts the task that stands in that
// slot. After the locker was killed the kernel's guard (`sperre_wache`) needs up
// to 32 turns to start a new one, and the zombie reaper frees the slot within
// ~16: a process that landed in the freed slot passed op 4 (slot equal, old pid
// gone) and could open the lock with op 2, no password. Whoever ends a task
// calls this under the same hold of L_SCHED: if the task is the one the lock
// names, pid and slot are cleared to a slot no task can have. The lock stays ON
// (nobody is allowed to draw: `wm.darf` is false without a locker) and the guard
// starts a new locker as before, because the pid is 0 now.
const LOCK_NOSLOT: u64 = 0xFFFF

fn lock_gone(state: u64, task: u64) {
    let sp: u64 = kstate.K11_OFF
    if kstate.get(state, sp + kstate.SP_ON) == 0 {
        return
    }
    if kstate.get(state, sp + kstate.SP_SLOT) != task {
        return
    }
    kstate.set(state, sp + kstate.SP_PID, 0)
    kstate.set(state, sp + kstate.SP_SLOT, LOCK_NOSLOT)
}

// A task ends. It stays in the table as a corpse until its creator picks
// up the exit code -- otherwise `wait` would have nothing left to read.
// Its kernel stack is the one this function is standing on and is
// therefore NOT freed here; that happens in the reaper.
fn exit_task(state: u64, code: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    tset(state, cur, T_EXIT, code)
    tset(state, cur, T_END, kstate.get(state, kstate.TICKS))
    lock_gone(state, cur)
    tset(state, cur, T_STATE, S_ZOMBIE)
    reparent(state, cur)
    wake_pid(state, tget(state, cur, T_PID))
    wake_pid(state, group_of(state, cur))
    schedule_locked(state)
    irq_restore(flags)
    // The scheduler never comes back to a corpse. If it does, something
    // is broken enough that going on would be worse.
    while true {
        asm("hlt")
    }
}

// DELL STABILITY (08.10.2026): `kill` of ANOTHER task.
//
// Before: `uio.kill_pid` wrote S_ZOMBIE into the victim without the run queue
// lock, whatever the victim was doing. A victim that was RUNNING on another
// core became a corpse while that core still stood on its kernel stack; the
// parent's wait4 (or the desktop loop) then reaped the corpse on a third core,
// the stack frames went back to the frame allocator, and `create` painted them
// with STACK_PAINT while the victim's core was still executing on them. The
// Dell saw that as `ret` to 0x5A5A5A5A5A5A5A5A (stack scan in the panic report:
// reap -> fd_free -> lock_take -> context_switch, RIP in .bss); the VM series
// (tools/stab/crash.sh) shows the same as #GP at a painted return address.
//
// Now, under ONE hold of L_SCHED:
//   * not running (READY, SLEEP, WAIT, POLL, STOP): its stack is quiet, it is
//     made a corpse right here -- as before, but also reparenting its children
//     (`exit_task` always did, `kill_pid` never did);
//   * running (S_RUN, on any core): nothing is torn down. The request goes
//     into T_KILLCODE (KILL_SET + code) and the victim ends ITSELF in
//     `exit_task`, at its next trap or system call return (`signal.deliverable`
//     reports SIGKILL for it).
const KILL_DONE: u64 = 0
const KILL_LATER: u64 = 1
const KILL_GONE: u64 = 2

fn kill_other(state: u64, i: u64, pid: u64, code: u64) -> u64 {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if i >= kstate.MAX_TASKS || tget(state, i, T_PID) != pid {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return KILL_GONE
    }
    let st: u64 = tget(state, i, T_STATE)
    if st == S_FREE || st == S_ZOMBIE || st == S_REAPING || st == S_NEW {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return KILL_GONE
    }
    if st == S_RUN || i == current(state) {
        tset(state, i, T_KILLCODE, code | KILL_SET)
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return KILL_LATER
    }
    tset(state, i, T_KILLCODE, 0)
    let plain: bool = (code & KILL_PLAIN) != 0
    let ecode: u64 = code & (0xFFFFFFFFFFFFFFFF -% KILL_PLAIN)
    tset(state, i, T_EXIT, ecode)
    // RUNDE UNTERBAU: a kill code 128 + n is "died of signal n" (bit 8 of T_SIGLAST, read by `wait4`)
    if !plain && ecode > 128 && ecode < 192 {
        tset(state, i, T_SIGLAST, ((ecode - 128) & 127) | 256)
    }
    tset(state, i, T_END, kstate.get(state, kstate.TICKS))
    lock_gone(state, i)
    tset(state, i, T_STATE, S_ZOMBIE)
    reparent(state, i)
    wake_pid(state, pid)
    wake_pid(state, group_of(state, i))
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return KILL_DONE
}

fn group_of(state: u64, i: u64) -> u64 {
    let g: u64 = tget(state, i, T_TGID)
    if g == 0 {
        return tget(state, i, T_PID)
    }
    return g
}

fn is_group_member(state: u64, i: u64, j: u64, g: u64) -> bool {
    if j == i || tget(state, j, T_KIND) != K_USER || tget(state, j, T_TGID) != g {
        return false
    }
    let st: u64 = tget(state, j, T_STATE)
    return st != S_FREE && st != S_ZOMBIE && st != S_REAPING
}

fn group_live(state: u64, i: u64) -> bool {
    let g: u64 = group_of(state, i)
    let n: u64 = kstate.get(state, kstate.TASKS)
    var j: u64 = 0
    while j < n {
        if is_group_member(state, i, j, g) {
            return true
        }
        j = j + 1
    }
    return false
}

fn kill_group(state: u64, i: u64, code: u64) {
    let g: u64 = group_of(state, i)
    let n: u64 = kstate.get(state, kstate.TASKS)
    var j: u64 = 0
    while j < n {
        if is_group_member(state, i, j, g) {
            let _r: u64 = kill_other(state, j, tget(state, j, T_PID), code)
        }
        j = j + 1
    }
}

fn reparent(state: u64, dying: u64) {
    let slot: u64 = kstate.get(state, kstate.K13_OFF + kstate.U_INITSLOT)
    if slot == 0 {
        return
    }
    let init: u64 = slot - 1
    if init == dying {
        return
    }
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) != S_FREE {
            if tget(state, i, T_PARENT) == dying && i != dying {
                tset(state, i, T_PARENT, init)
                kstate.add(state, kstate.K13_OFF + kstate.U_ORPHANS, 1)
            }
        }
        i = i + 1
    }
}

// The corpse is cleared away: its kernel stack goes back to the frame
// allocator, its slot into the table. Whoever calls this must have picked
// up the exit code beforehand -- and must not be standing on that stack,
// which is why a task can never reap itself.
// ROUND K5: the slot is released under the run queue lock, the FRAMES
// are given back afterwards, outside it. Same rule as in `create` and for
// the same reason -- the two locks of this kernel are never nested.
// Claim a zombie for reaping. Only the caller that gets `true` may free
// anything of it; everyone else must leave it alone.
// DELL STABILITY: is task `i` the current task of ANY core? A corpse whose kernel
// stack a core still stands on must not be torn down (the frames would go to
// the allocator and be repainted under that core). `kill_other` no longer makes
// such corpses; this is the second line, and a stop with evidence instead of a
// panic: the reap is refused and tried again later.
fn on_a_core(state: u64, i: u64) -> bool {
    let n: u64 = cpu.count(state)
    var c: u64 = 0
    while c < n {
        if cpu.get(state, c, cpu.C_CUR) == i {
            return true
        }
        c = c + 1
    }
    return false
}

fn claim_zombie(state: u64, i: u64) -> bool {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if tget(state, i, T_STATE) != S_ZOMBIE || on_a_core(state, i) {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return false
    }
    tset(state, i, T_STATE, S_REAPING)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return true
}

fn reap(state: u64, i: u64) -> bool {
    return reap_in(state, i, S_ZOMBIE)
}

// The second half after `claim_zombie`: kernel stack, vector area, slot.
fn reap_claimed(state: u64, i: u64) -> bool {
    return reap_in(state, i, S_REAPING)
}

fn reap_in(state: u64, i: u64, want: u64) -> bool {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if tget(state, i, T_STATE) != want || on_a_core(state, i) {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return false
    }
    let stack: u64 = tget(state, i, T_KSTACK)
    let vec_area: u64 = tget(state, i, T_FPU)
    tset(state, i, T_FPU, 0)
    tset(state, i, T_KSTACK, 0)
    tset(state, i, T_STATE, S_FREE)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    if stack != 0 {
        free_stack(state, stack)
    }
    if vec_area != 0 {
        fpu.drop_owner(state, vec_area)
        fpu.area_free(state, vec_area)
    }
    return true
}

// A fault in ring 3 kills the process, not the kernel. This is the point
// at which an operating system differs from the kernel of round 59: there
// the machine stopped at every exception, and rightly so -- there was
// nobody else the fault could belong to.
fn kill_current(state: u64, pid_vector: u64, err: u64, cr2: u64, rip: u64) {
    var s_kill: [u8; 13] = "user fault: \0"
    var s_pid: [u8; 6] = "pid=\0\0"
    var s_vec: [u8; 10] = "  vector=\0"
    var s_err: [u8; 7] = "  err=\0"
    var s_cr2: [u8; 7] = "  cr2=\0"
    var s_rip: [u8; 7] = "  rip=\0"
    var s_dead: [u8; 20] = "  -- process killed\0"
    let cur: u64 = current(state)
    serial.puts((&s_kill[0]) as u64)
    serial.puts((&s_pid[0]) as u64)
    serial.dec(tget(state, cur, T_PID))
    serial.puts((&s_vec[0]) as u64)
    serial.dec(pid_vector)
    serial.puts((&s_err[0]) as u64)
    serial.hex(err)
    serial.puts((&s_cr2[0]) as u64)
    serial.hex(cr2)
    serial.puts((&s_rip[0]) as u64)
    serial.hex(rip)
    serial.puts((&s_dead[0]) as u64)
    serial.nl()
    kstate.add(state, kstate.KILLED, 1)
    tset(state, cur, T_FAULTS, tget(state, cur, T_FAULTS) + 1)
    // 128 + vector, the way a system with signals would count it.
    exit_task(state, 128 + pid_vector)
}

// ------------------------------------------------------------ the view

fn dump_tasks(state: u64) {
    var s_row: [u8; 7] = "task: \0"
    var s_pid: [u8; 5] = "pid=\0"
    var s_kind: [u8; 8] = "  kind=\0"
    var s_prio: [u8; 8] = "  prio=\0"
    var s_state: [u8; 9] = "  state=\0"
    var s_runs: [u8; 8] = "  runs=\0"
    var s_ticks: [u8; 9] = "  ticks=\0"
    var s_work: [u8; 8] = "  work=\0"
    var s_end: [u8; 7] = "  end=\0"
    var s_exit: [u8; 8] = "  exit=\0"
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) != S_FREE {
            serial.puts((&s_row[0]) as u64)
            serial.puts((&s_pid[0]) as u64)
            serial.dec(tget(state, i, T_PID))
            serial.puts((&s_kind[0]) as u64)
            serial.dec(tget(state, i, T_KIND))
            serial.puts((&s_prio[0]) as u64)
            serial.dec(tget(state, i, T_PRIO))
            serial.puts((&s_state[0]) as u64)
            serial.dec(tget(state, i, T_STATE))
            serial.puts((&s_runs[0]) as u64)
            serial.dec(tget(state, i, T_RUNS))
            serial.puts((&s_ticks[0]) as u64)
            serial.dec(tget(state, i, T_TICKS))
            serial.puts((&s_work[0]) as u64)
            serial.dec(tget(state, i, T_WORK))
            serial.puts((&s_end[0]) as u64)
            serial.dec(tget(state, i, T_END))
            serial.puts((&s_exit[0]) as u64)
            serial.dec(tget(state, i, T_EXIT))
            serial.nl()
        }
        i = i + 1
    }
}
