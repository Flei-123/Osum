// kernel/wach.fi -- RUNDE WACH (K-018, Abschluss): DER WIEDERANLAUF.
//     +0   rflags
//     +8   r15  +16 r14  +24 r13  +32 r12  +40 r11  +48 r10
//     +56  r9   +64 r8   +72 rdi  +80 rsi  +88 rbp  +96 rbx
//     +104 rdx  +112 rcx +120 rax
//     +128 die Ruecksprungadresse

import lib.kstate
import serial
import mm.mem
import block.blk
import ldr.bootmod
import sched.susp
import sched.sched
import sched.proc
import arch.x86_64.fpu
import arch.arch

const W_READY: u64 = 0
const W_SAVED: u64 = 8 // wie viele Aufgaben ins Abbild gingen
const W_BACK: u64 = 16 // wie viele zurueckgeholt wurden
const W_RESUMED: u64 = 24
const W_KFRAMES: u64 = 32 // wie viele Kernstapelrahmen gesichert wurden
const W_KBACK: u64 = 40
const W_DFRAMES: u64 = 48 // Datenrahmen im Abbild
const W_DBACK: u64 = 56 // und zurueck
const W_WHY: u64 = 64 // warum der Wiederanlauf nichts tat
const W_SUM: u64 = 72
const W_LBA: u64 = 80
const W_BLOCKS: u64 = 88 // wie viele Bloecke er belegt
const W_TICKS0: u64 = 96 // Zeitgeberstand beim Sichern
const W_PIDS: u64 = 104
const W_PID0: u64 = 112
const W_PID1: u64 = 120
const W_PID2: u64 = 128
const W_PID3: u64 = 136
const W_SUM0: u64 = 144
const W_STEP0: u64 = 152
const W_RUNS: u64 = 160
const W_ZYK: u64 = 168 // welcher Zyklus
const W_FAIL: u64 = 176 // woran der Wiederanlauf scheiterte
const W_PTFRAMES: u64 = 184

// Warum kein Wiederanlauf stattfand.
const WW_OK: u64 = 0
const WW_OFF: u64 = 1 // `nowach` -- bewusst abgeschaltet
const WW_NOIMG: u64 = 2
const WW_MAGIC: u64 = 3
const WW_READ: u64 = 4
const WW_SLOT: u64 = 5
const WW_FRAME: u64 = 6
const WW_SPACE: u64 = 7

const TS_MAGIC: u64 = 0
const TS_PID: u64 = 8
const TS_STATE: u64 = 16
const TS_PRIO: u64 = 24
const TS_RSP: u64 = 32
const TS_KSTACK: u64 = 40 // physisch == virtuell (Identitaetsabbildung)
const TS_KTOP: u64 = 48
const TS_ENTRY: u64 = 56
const TS_USTACK: u64 = 64
const TS_KIND: u64 = 72
const TS_ARG: u64 = 80
const TS_WORK: u64 = 88
const TS_WAKE: u64 = 96
const TS_DATA: u64 = 104 // die private Datenseite, physisch
const TS_NDATA: u64 = 112
const TS_DOFF: u64 = 120
const TS_UID: u64 = 128
const TS_GID: u64 = 136
const TS_PGID: u64 = 144
const TS_SID: u64 = 152
const TS_BYTES: u64 = 160

const WACH_MAGIC: u64 = 0x5741434854534B21 // "WACHTSK!"
const WACH_HEAD: u64 = 0x5741434848454421 // "WACHHED!"
const WACH_USERTAG: u64 = 0x5741434855534552 // "WACHUSER"

const MAX_SAVE: u64 = 8

const PG_VIRT: u64 = 0
const PG_PHYS: u64 = 8
const PG_BYTES: u64 = 16
const MAX_PAGES: u64 = 448

const W_TASKS: u64 = 0x1000
const W_PAGES: u64 = 0x3000

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.WACH_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.WACH_OFF + off, v)
}

fn tsl(state: u64, n: u64) -> u64 {
    return state + kstate.WACH_OFF + W_TASKS + n * TS_BYTES
}

fn pgl(state: u64, n: u64) -> u64 {
    return state + kstate.WACH_OFF + W_PAGES + n * PG_BYTES
}

fn tsget(state: u64, n: u64, f: u64) -> u64 {
    return __mmio_read64((tsl(state, n) + f) as *mut u64)
}

fn tsset(state: u64, n: u64, f: u64, v: u64) {
    __mmio_write64((tsl(state, n) + f) as *mut u64, v)
}

fn pgget(state: u64, n: u64, f: u64) -> u64 {
    return __mmio_read64((pgl(state, n) + f) as *mut u64)
}

fn pgset(state: u64, n: u64, f: u64, v: u64) {
    __mmio_write64((pgl(state, n) + f) as *mut u64, v)
}

fn ready(state: u64) -> u64 {
    return g(state, W_READY)
}

fn resumed(state: u64) -> u64 {
    return g(state, W_RESUMED)
}

fn count(state: u64) -> u64 {
    return g(state, W_BACK)
}

fn tasks_in_image(state: u64) -> u64 {
    return g(state, W_SAVED)
}

fn tasks_back(state: u64) -> u64 {
    return g(state, W_BACK)
}

fn frames_taken(state: u64) -> u64 {
    return g(state, W_KBACK) + g(state, W_PTFRAMES)
}

// ==================================================================
// WELCHE AUFGABEN UEBERHAUPT GESICHERT WERDEN
fn saveable(state: u64, i: u64) -> bool {
    let st: u64 = sched.tget(state, i, sched.T_STATE)
    if st == sched.S_FREE || st == sched.S_ZOMBIE {
        return false
    }
    if sched.tget(state, i, sched.T_KIND) != sched.K_USER {
        return false
    }
    if sched.tget(state, i, sched.T_SHARED) != 0 {
        return false
    }
    let cr3: u64 = sched.tget(state, i, sched.T_CR3)
    if cr3 == 0 || cr3 == kstate.get(state, kstate.KPML4) {
        return false
    }
    if sched.tget(state, i, sched.T_KSTACK) == 0 {
        return false
    }
    return true
}

// ==================================================================
// DAS SICHERN

fn kstack_frames() -> u64 {
    return sched.KSTACK_FRAMES + 1
}

fn part_blocks(tasks: u64, pages: u64) -> u64 {
    let head: u64 = 1
    let saetze: u64 = (tasks * TS_BYTES + 511) / 512
    let board: u64 = (pages * PG_BYTES + 511) / 512
    let stack: u64 = tasks * kstack_frames() * 8
    return head + saetze + board + stack
}

fn collect(state: u64) -> u64 {
    var n: u64 = 0
    var seiten: u64 = 0
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        if saveable(state, i) && n < MAX_SAVE {
            let c: u64 = proc.frame_count(state, i)
            if seiten + c <= MAX_PAGES {
                tsset(state, n, TS_MAGIC, WACH_MAGIC)
                tsset(state, n, TS_PID, sched.tget(state, i, sched.T_PID))
                tsset(state, n, TS_STATE, sched.tget(state, i, sched.T_STATE))
                tsset(state, n, TS_PRIO, sched.tget(state, i, sched.T_PRIO))
                tsset(state, n, TS_RSP, sched.tget(state, i, sched.T_RSP))
                tsset(state, n, TS_KSTACK, sched.tget(state, i, sched.T_KSTACK))
                tsset(state, n, TS_KTOP, sched.tget(state, i, sched.T_KTOP))
                tsset(state, n, TS_ENTRY, sched.tget(state, i, sched.T_ENTRY))
                tsset(state, n, TS_USTACK, sched.tget(state, i, sched.T_USTACK))
                tsset(state, n, TS_KIND, sched.tget(state, i, sched.T_KIND))
                tsset(state, n, TS_ARG, sched.tget(state, i, sched.T_ARG))
                tsset(state, n, TS_WORK, sched.tget(state, i, sched.T_WORK))
                tsset(state, n, TS_WAKE, sched.tget(state, i, sched.T_WAKE))
                tsset(state, n, TS_DATA, sched.tget(state, i, sched.T_DATA))
                tsset(state, n, TS_NDATA, c)
                tsset(state, n, TS_DOFF, seiten)
                tsset(state, n, TS_UID, sched.tget(state, i, sched.T_UID))
                tsset(state, n, TS_GID, sched.tget(state, i, sched.T_GID))
                tsset(state, n, TS_PGID, sched.tget(state, i, sched.T_PGID))
                tsset(state, n, TS_SID, sched.tget(state, i, sched.T_SID))
                var k: u64 = 0
                while k < c {
                    pgset(state, seiten + k, PG_VIRT,
                        proc.frame_virt_at(state, i, k))
                    pgset(state, seiten + k, PG_PHYS,
                        proc.frame_at(state, i, k))
                    k = k + 1
                }
                var s_w: [u8; 13] = "wach: sich. \0"
                var s_pd: [u8; 6] = " pid=\0"
                var s_st: [u8; 5] = " st=\0"
                var s_pr: [u8; 7] = " prog=\0"
                var s_sn: [u8; 9] = " seiten=\0"
                serial.puts((&s_w[0]) as u64)
                serial.puts((&s_pd[0]) as u64)
                serial.dec(sched.tget(state, i, sched.T_PID))
                serial.puts((&s_st[0]) as u64)
                serial.dec(sched.tget(state, i, sched.T_STATE))
                serial.puts((&s_pr[0]) as u64)
                serial.dec(sched.tget(state, i, sched.T_ARG))
                serial.puts((&s_sn[0]) as u64)
                serial.dec(c)
                serial.nl()
                seiten = seiten + c
                n = n + 1
            }
        }
        i = i + 1
    }
    s(state, W_DFRAMES, seiten)
    return n
}

fn save_tasks(state: u64, dev: u64, base: u64, b: u64) -> bool {
    s(state, W_READY, 1)
    s(state, W_SAVED, 0)
    s(state, W_KFRAMES, 0)
    let n: u64 = collect(state)
    let pages: u64 = g(state, W_DFRAMES)
    if n == 0 {
        s(state, W_SAVED, 0)
    }
    var sum: u64 = bootmod.crc32_start()
    let saetze: u64 = (n * TS_BYTES + 511) / 512
    let board: u64 = (pages * PG_BYTES + 511) / 512

    // ---- die Aufgabensaetze
    var blkn: u64 = 0
    while blkn < saetze {
        var i: u64 = 0
        while i < 512 {
            kstate.set8(b + i, 0 as u8)
            i = i + 1
        }
        i = 0
        while i < 512 {
            let off: u64 = blkn * 512 + i
            if off < n * TS_BYTES {
                kstate.set8(b + i,
                    kstate.get8(state + kstate.WACH_OFF + W_TASKS + off) as u8)
            }
            i = i + 1
        }
        sum = bootmod.crc32_feed(sum, b, 512)
        if !blk.write_on(state, dev, base + 1 + blkn, b) {
            return false
        }
        blkn = blkn + 1
    }

    // ---- die Seitentafel
    blkn = 0
    while blkn < board {
        var i: u64 = 0
        while i < 512 {
            kstate.set8(b + i, 0 as u8)
            i = i + 1
        }
        i = 0
        while i < 512 {
            let off: u64 = blkn * 512 + i
            if off < pages * PG_BYTES {
                kstate.set8(b + i,
                    kstate.get8(state + kstate.WACH_OFF + W_PAGES + off) as u8)
            }
            i = i + 1
        }
        sum = bootmod.crc32_feed(sum, b, 512)
        if !blk.write_on(state, dev, base + 1 + saetze + blkn, b) {
            return false
        }
        blkn = blkn + 1
    }

    let kf: u64 = kstack_frames()
    let stack_lba: u64 = base + 1 + saetze + board
    var kframes: u64 = 0
    var t: u64 = 0
    while t < n {
        let bottom: u64 = tsget(state, t, TS_KSTACK) - mem.FRAME_SIZE
        var f: u64 = 0
        while f < kf {
            let pa: u64 = bottom + f * mem.FRAME_SIZE
            var bn: u64 = 0
            while bn < 8 {
                var i: u64 = 0
                while i < 512 {
                    kstate.set8(b + i, kstate.get8(pa + bn * 512 + i) as u8)
                    i = i + 1
                }
                sum = bootmod.crc32_feed(sum, b, 512)
                if !blk.write_on(state, dev,
                    stack_lba + (t * kf + f) * 8 + bn, b) {
                    return false
                }
                bn = bn + 1
            }
            kframes = kframes + 1
            f = f + 1
        }
        t = t + 1
    }
    s(state, W_KFRAMES, kframes)

    var i: u64 = 0
    while i < 512 {
        kstate.set8(b + i, 0 as u8)
        i = i + 1
    }
    __mmio_write64(b as *mut u64, WACH_HEAD)
    __mmio_write64((b + 8) as *mut u64, n)
    __mmio_write64((b + 16) as *mut u64, pages)
    __mmio_write64((b + 24) as *mut u64, bootmod.crc32_end(sum))
    __mmio_write64((b + 32) as *mut u64, kframes)
    __mmio_write64((b + 40) as *mut u64, kstate.get(state, kstate.TICKS))
    __mmio_write64((b + 48) as *mut u64, g(state, W_STEP0))
    __mmio_write64((b + 56) as *mut u64, g(state, W_SUM0))
    if !blk.write_on(state, dev, base + B_PART, b) {
        return false
    }
    s(state, W_SAVED, n)
    s(state, W_TICKS0, kstate.get(state, kstate.TICKS))
    s(state, W_LBA, base)
    s(state, W_BLOCKS, part_blocks(n, pages))
    s(state, W_SUM, bootmod.crc32_end(sum))
    return true
}

const B_PART: u64 = 0

// ==================================================================
// DER WIEDERANLAUF
// WAS HIER GESCHIEHT, je Aufgabe:

fn restore_tasks(state: u64, dev: u64, base: u64, b: u64) -> bool {
    s(state, W_BACK, 0)
    s(state, W_KBACK, 0)
    s(state, W_PTFRAMES, 0)
    s(state, W_RESUMED, 0)
    s(state, W_WHY, WW_OK)
    if kstate.mode_on(state, kstate.M_NOWACH) {
        s(state, W_WHY, WW_OFF)
        return false
    }
    if !blk.read_on(state, dev, base + B_PART, b) {
        s(state, W_WHY, WW_READ)
        return false
    }
    if __mmio_read64(b as *mut u64) != WACH_HEAD {
        s(state, W_WHY, WW_MAGIC)
        return false
    }
    let n: u64 = __mmio_read64((b + 8) as *mut u64)
    let pages: u64 = __mmio_read64((b + 16) as *mut u64)
    let want: u64 = __mmio_read64((b + 24) as *mut u64)
    let kfr: u64 = __mmio_read64((b + 32) as *mut u64)
    let ticks0: u64 = __mmio_read64((b + 40) as *mut u64)
    s(state, W_STEP0, __mmio_read64((b + 48) as *mut u64))
    s(state, W_SUM0, __mmio_read64((b + 56) as *mut u64))
    s(state, W_TICKS0, ticks0)
    if n == 0 {
        s(state, W_WHY, WW_NOIMG)
        return false
    }
    if n > MAX_SAVE || pages > MAX_PAGES {
        s(state, W_WHY, WW_MAGIC)
        return false
    }
    let saetze: u64 = (n * TS_BYTES + 511) / 512
    let board: u64 = (pages * PG_BYTES + 511) / 512
    let kf: u64 = kstack_frames()
    let stack_lba: u64 = base + 1 + saetze + board

    var sum: u64 = bootmod.crc32_start()
    let total: u64 = saetze + board + n * kf * 8
    var i: u64 = 0
    while i < total {
        if !blk.read_on(state, dev, base + 1 + i, b) {
            s(state, W_WHY, WW_READ)
            return false
        }
        sum = bootmod.crc32_feed(sum, b, 512)
        i = i + 1
    }
    if bootmod.crc32_end(sum) != want {
        s(state, W_WHY, WW_MAGIC)
        return false
    }

    var blkn: u64 = 0
    while blkn < saetze {
        if !blk.read_on(state, dev, base + 1 + blkn, b) {
            s(state, W_WHY, WW_READ)
            return false
        }
        i = 0
        while i < 512 {
            let off: u64 = blkn * 512 + i
            if off < n * TS_BYTES {
                kstate.set8(state + kstate.WACH_OFF + W_TASKS + off,
                    kstate.get8(b + i) as u8)
            }
            i = i + 1
        }
        blkn = blkn + 1
    }
    blkn = 0
    while blkn < board {
        if !blk.read_on(state, dev, base + 1 + saetze + blkn, b) {
            s(state, W_WHY, WW_READ)
            return false
        }
        i = 0
        while i < 512 {
            let off: u64 = blkn * 512 + i
            if off < pages * PG_BYTES {
                kstate.set8(state + kstate.WACH_OFF + W_PAGES + off,
                    kstate.get8(b + i) as u8)
            }
            i = i + 1
        }
        blkn = blkn + 1
    }

    // ---- JE AUFGABE: STAPEL, PLATZ, ADRESSRAUM, LAUFLISTE
    var back: u64 = 0
    var kback: u64 = 0
    var dback: u64 = 0
    var t: u64 = 0
    while t < n {
        if tsget(state, t, TS_MAGIC) != WACH_MAGIC {
            s(state, W_WHY, WW_MAGIC)
            return false
        }
        // 1. DIE KERNSTAPELRAHMEN AN IHRE ALTEN ADRESSEN.
        let bottom: u64 = tsget(state, t, TS_KSTACK) - mem.FRAME_SIZE
        var f: u64 = 0
        var stack_ok: u64 = 1
        while f < kf {
            let pa: u64 = bottom + f * mem.FRAME_SIZE
            if !mem.reserve_frame(state, pa) {
                stack_ok = 0
            }
            f = f + 1
        }
        if stack_ok == 0 {
            s(state, W_WHY, WW_FRAME)
            s(state, W_FAIL, tsget(state, t, TS_PID))
            return false
        }
        // die Oktette
        f = 0
        while f < kf {
            let pa: u64 = bottom + f * mem.FRAME_SIZE
            var bn: u64 = 0
            while bn < 8 {
                if !blk.read_on(state, dev,
                    stack_lba + (t * kf + f) * 8 + bn, b) {
                    s(state, W_WHY, WW_READ)
                    return false
                }
                i = 0
                while i < 512 {
                    kstate.set8(pa + bn * 512 + i, kstate.get8(b + i) as u8)
                    i = i + 1
                }
                bn = bn + 1
            }
            kback = kback + 1
            f = f + 1
        }

        var slot: u64 = 0
        var k: u64 = 1
        while k < kstate.MAX_TASKS {
            if slot == 0 && sched.tget(state, k, sched.T_STATE) == sched.S_FREE {
                slot = k
            }
            k = k + 1
        }
        if slot == 0 {
            s(state, W_WHY, WW_SLOT)
            return false
        }
        var j: u64 = 0
        while j < kstate.TASK_BYTES / 8 {
            __mmio_write64((sched.task_at(state, slot) + j * 8) as *mut u64, 0)
            j = j + 1
        }
        sched.tset(state, slot, sched.T_PID, tsget(state, t, TS_PID))
        sched.tset(state, slot, sched.T_PRIO, tsget(state, t, TS_PRIO))
        sched.tset(state, slot, sched.T_BUDGET, tsget(state, t, TS_PRIO))
        sched.tset(state, slot, sched.T_KIND, tsget(state, t, TS_KIND))
        sched.tset(state, slot, sched.T_ARG, tsget(state, t, TS_ARG))
        sched.tset(state, slot, sched.T_WORK, tsget(state, t, TS_WORK))
        sched.tset(state, slot, sched.T_ENTRY, tsget(state, t, TS_ENTRY))
        sched.tset(state, slot, sched.T_USTACK, tsget(state, t, TS_USTACK))
        sched.tset(state, slot, sched.T_KSTACK, tsget(state, t, TS_KSTACK))
        sched.tset(state, slot, sched.T_KTOP, tsget(state, t, TS_KTOP))
        sched.tset(state, slot, sched.T_RSP, tsget(state, t, TS_RSP))
        sched.tset(state, slot, sched.T_UID, tsget(state, t, TS_UID))
        sched.tset(state, slot, sched.T_GID, tsget(state, t, TS_GID))
        sched.tset(state, slot, sched.T_EUID, tsget(state, t, TS_UID))
        sched.tset(state, slot, sched.T_EGID, tsget(state, t, TS_GID))
        sched.tset(state, slot, sched.T_PGID, tsget(state, t, TS_PGID))
        sched.tset(state, slot, sched.T_SID, tsget(state, t, TS_SID))
        sched.tset(state, slot, sched.T_PARENT, 0)

        let frei_vor_pt: u64 = mem.frames_free(state)
        let space: u64 = proc.space_build_empty(state, slot)
        if space == 0 {
            s(state, W_WHY, WW_SPACE)
            return false
        }
        sched.tset(state, slot, sched.T_CR3, space)
        sched.tset(state, slot, sched.T_DATA, tsget(state, t, TS_DATA))
        let doff: u64 = tsget(state, t, TS_DOFF)
        let nd: u64 = tsget(state, t, TS_NDATA)
        var d: u64 = 0
        while d < nd {
            let va: u64 = pgget(state, doff + d, PG_VIRT)
            let pa: u64 = pgget(state, doff + d, PG_PHYS)
            if va != 0 && pa != 0 {
                if proc.map_restored(state, slot, va, pa) {
                    dback = dback + 1
                }
            }
            d = d + 1
        }

        let area: u64 = fpu.area_new(state)
        if area != 0 {
            sched.fpu_set_area(state, slot, area)
        }
        let frei_nach_pt: u64 = mem.frames_free(state)
        if frei_vor_pt > frei_nach_pt {
            s(state, W_PTFRAMES,
                g(state, W_PTFRAMES) + (frei_vor_pt - frei_nach_pt))
        }

        // 4. IN DIE LAUFLISTE.
        let st: u64 = tsget(state, t, TS_STATE)
        if st == sched.S_SLEEP || st == sched.S_READY || st == sched.S_RUN {
            sched.tset(state, slot, sched.T_STATE, sched.S_READY)
        } else {
            sched.tset(state, slot, sched.T_STATE, sched.S_STOP)
        }
        if slot + 1 > kstate.get(state, kstate.TASKS) {
            kstate.set(state, kstate.TASKS, slot + 1)
        }
        if back < 4 {
            s(state, W_PID0 + back * 8, tsget(state, t, TS_PID))
        }
        back = back + 1
        t = t + 1
    }
    s(state, W_BACK, back)
    s(state, W_KBACK, kback)
    s(state, W_DBACK, dback)
    s(state, W_RESUMED, 1)
    var maxpid: u64 = kstate.get(state, kstate.NEXT_PID)
    t = 0
    while t < n {
        if tsget(state, t, TS_PID) + 1 > maxpid {
            maxpid = tsget(state, t, TS_PID) + 1
        }
        t = t + 1
    }
    kstate.set(state, kstate.NEXT_PID, maxpid)
    return true
}

fn why_name(w: u64) {
    var s0: [u8; 3] = "ok\0"
    var s1: [u8; 13] = "abgeschaltet\0"
    var s2: [u8; 21] = "kein Aufgabenteil\0\0\0\0"
    var s3: [u8; 16] = "Kennung falsch\0\0"
    var s4: [u8; 14] = "Lesefehler\0\0\0\0"
    var s5: [u8; 20] = "kein Aufgabenplatz\0\0"
    var s6: [u8; 18] = "Rahmen belegt\0\0\0\0\0"
    var s7: [u8; 20] = "kein Adressraum\0\0\0\0\0"
    if w == WW_OK { serial.puts((&s0[0]) as u64) }
    if w == WW_OFF { serial.puts((&s1[0]) as u64) }
    if w == WW_NOIMG { serial.puts((&s2[0]) as u64) }
    if w == WW_MAGIC { serial.puts((&s3[0]) as u64) }
    if w == WW_READ { serial.puts((&s4[0]) as u64) }
    if w == WW_SLOT { serial.puts((&s5[0]) as u64) }
    if w == WW_FRAME { serial.puts((&s6[0]) as u64) }
    if w == WW_SPACE { serial.puts((&s7[0]) as u64) }
}

fn bericht(state: u64) {
    var s_t: [u8; 14] = "wach: zurueck\0"
    var s_a: [u8; 11] = " aufgaben=\0"
    var s_k: [u8; 10] = " kstapel=\0"
    var s_d: [u8; 9] = " seiten=\0"
    var s_pt: [u8; 9] = " tafeln=\0"
    var s_w: [u8; 6] = " why=\0"
    serial.puts((&s_t[0]) as u64)
    serial.puts((&s_a[0]) as u64)
    serial.dec(g(state, W_BACK))
    serial.puts((&s_k[0]) as u64)
    serial.dec(g(state, W_KBACK))
    serial.puts((&s_d[0]) as u64)
    serial.dec(g(state, W_DBACK))
    serial.puts((&s_pt[0]) as u64)
    serial.dec(g(state, W_PTFRAMES))
    serial.puts((&s_w[0]) as u64)
    why_name(g(state, W_WHY))
    serial.nl()
}

fn running(state: u64) -> u64 {
    var c: u64 = 0
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        if sched.tget(state, i, sched.T_KIND) == sched.K_USER {
            if sched.tget(state, i, sched.T_RUNS) > 0 {
                c = c + 1
            }
        }
        i = i + 1
    }
    return c
}

fn measure(state: u64) {
    var s_t: [u8; 14] = "wach: messung\0"
    var s_s: [u8; 10] = " gesich.=\0"
    var s_b: [u8; 10] = " zurueck=\0"
    var s_r: [u8; 11] = " gelaufen=\0"
    var s_m: [u8; 10] = " maxsave=\0"
    serial.puts((&s_t[0]) as u64)
    serial.puts((&s_s[0]) as u64)
    serial.dec(g(state, W_SAVED))
    serial.puts((&s_b[0]) as u64)
    serial.dec(g(state, W_BACK))
    serial.puts((&s_r[0]) as u64)
    serial.dec(running(state))
    serial.puts((&s_m[0]) as u64)
    serial.dec(MAX_SAVE)
    serial.nl()
}

fn arm(state: u64, zyk: u64) {
    var s_t: [u8; 21] = "wach: == arm zyklus \0"
    var s_p: [u8; 18] = "wach: prozesse n=\0"
    var s_v: [u8; 15] = "wach: vorher \0\0"
    var s_r: [u8; 9] = " runden=\0"
    var s_s: [u8; 8] = " summe=\0"
    var s_pid: [u8; 7] = " pids=\0"

    s(state, W_ZYK, zyk)
    serial.puts((&s_t[0]) as u64)
    serial.dec(zyk)
    serial.nl()

    let a: u64 = proc.create(state, 65, 4000, 2)
    let b2: u64 = proc.create(state, 65, 4000, 2)
    let c: u64 = proc.create(state, 65, 4000, 2)
    var n: u64 = 0
    if a != 0 { n = n + 1 }
    if b2 != 0 { n = n + 1 }
    if c != 0 { n = n + 1 }
    serial.puts((&s_p[0]) as u64)
    serial.dec(n)
    serial.puts((&s_pid[0]) as u64)
    if a != 0 { serial.dec(sched.tget(state, a, sched.T_PID)) }
    var komma: [u8; 2] = ",\0"
    if b2 != 0 {
        serial.puts((&komma[0]) as u64)
        serial.dec(sched.tget(state, b2, sched.T_PID))
    }
    if c != 0 {
        serial.puts((&komma[0]) as u64)
        serial.dec(sched.tget(state, c, sched.T_PID))
    }
    serial.nl()

    // Sie sollen wirklich gelaufen sein, bevor gesichert wird.
    sched.sleep_ticks(state, 60)

    var runden: u64 = 0
    var sum_value: u64 = 0
    if a != 0 {
        let pa: u64 = proc.translate(state, a, 0x40000000)
        if pa != 0 {
            sum_value = __mmio_read64((pa + 8) as *mut u64)
            runden = __mmio_read64((pa + 24) as *mut u64)
        }
    }
    s(state, W_SUM0, sum_value)
    s(state, W_STEP0, runden)
    serial.puts((&s_v[0]) as u64)
    serial.puts((&s_r[0]) as u64)
    serial.dec(runden)
    serial.puts((&s_s[0]) as u64)
    serial.dec(sum_value)
    serial.nl()
}

fn check(state: u64) {
    var s_t: [u8; 17] = "wach: == pruef\0\0\0"
    var s_w: [u8; 15] = "wach: weiter \0\0"
    var s_v: [u8; 9] = " vorher=\0"
    var s_n: [u8; 10] = " nachher=\0"
    var s_s: [u8; 8] = " summe=\0"
    var s_so: [u8; 7] = " soll=\0"
    var s_ok: [u8; 20] = "wach: weiterlauf=\0\0\0"
    var s_l: [u8; 11] = " gelaufen=\0"
    var s_p: [u8; 11] = " prozesse=\0"
    var s_a: [u8; 8] = " alle=\0\0"

    serial.puts((&s_t[0]) as u64)
    serial.nl()
    bericht(state)
    if g(state, W_BACK) == 0 {
        serial.puts((&s_ok[0]) as u64)
        serial.dec(0)
        serial.nl()
        return
    }

    sched.sleep_ticks(state, 80)

    // JE PROZESS: laeuft er, und rechnet er richtig?
    var gelaufen: u64 = 0
    var go_on: u64 = 0
    var prozesse: u64 = 0
    var first_before: u64 = g(state, W_STEP0)
    var first_after: u64 = 0
    var first_sum: u64 = 0
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        if sched.tget(state, i, sched.T_KIND) == sched.K_USER
            && sched.tget(state, i, sched.T_STATE) != sched.S_FREE
            && sched.tget(state, i, sched.T_CR3) != 0
            && sched.tget(state, i, sched.T_CR3)
                != kstate.get(state, kstate.KPML4) {
            let pa: u64 = proc.translate(state, i, 0x40000000)
            if pa != 0 {
                if __mmio_read64(pa as *mut u64) == WACH_USERTAG {
                    prozesse = prozesse + 1
                    if sched.tget(state, i, sched.T_RUNS) > 0 {
                        gelaufen = gelaufen + 1
                    }
                    let su: u64 = __mmio_read64((pa + 8) as *mut u64)
                    let sc: u64 = __mmio_read64((pa + 16) as *mut u64)
                    let ru: u64 = __mmio_read64((pa + 24) as *mut u64)
                    var soll: u64 = 0
                    if sc > 0 {
                        let nn: u64 = sc - 1
                        soll = nn * (nn + 1) / 2
                    }
                    if ru > first_before && su == soll && su > 0 {
                        go_on = go_on + 1
                    }
                    if first_after == 0 {
                        first_after = ru
                        first_sum = su
                    }
                }
            }
        }
        i = i + 1
    }

    var soll0: u64 = 0
    if first_after > 0 {
        soll0 = first_sum
    }
    serial.puts((&s_w[0]) as u64)
    serial.puts((&s_v[0]) as u64)
    serial.dec(first_before)
    serial.puts((&s_n[0]) as u64)
    serial.dec(first_after)
    serial.puts((&s_s[0]) as u64)
    serial.dec(first_sum)
    serial.puts((&s_so[0]) as u64)
    serial.dec(soll0)
    serial.nl()

    var every: u64 = 0
    if go_on > 0 && go_on == prozesse {
        every = 1
    }
    s(state, W_RUNS, go_on)
    serial.puts((&s_ok[0]) as u64)
    serial.dec(go_on)
    serial.puts((&s_l[0]) as u64)
    serial.dec(gelaufen)
    serial.puts((&s_p[0]) as u64)
    serial.dec(prozesse)
    serial.puts((&s_a[0]) as u64)
    serial.dec(every)
    serial.nl()
}
