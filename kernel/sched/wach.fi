
import lib.kstate
import serial
import mm.mmframe
import block.blk
import ldr.bootmod
import sched.susp
import sched.sched
import sched.taskconst
import sched.taskslot
import sync.atomic
import sched.proc.procmap
import sched.proc.procpt
import sched.proc.procspace
import arch.x86_64.fpu
import arch.arch
import arch.cpu

const W_READY: u64 = 0
const W_SAVED: u64 = 8
const W_BACK: u64 = 16
const W_RESUMED: u64 = 24
const W_KFRAMES: u64 = 32
const W_KBACK: u64 = 40
const W_DFRAMES: u64 = 48
const W_DBACK: u64 = 56
const W_WHY: u64 = 64
const W_SUM: u64 = 72
const W_LBA: u64 = 80
const W_BLOCKS: u64 = 88
const W_TICKS0: u64 = 96
const W_PIDS: u64 = 104
const W_PID0: u64 = 112
const W_PID1: u64 = 120
const W_PID2: u64 = 128
const W_PID3: u64 = 136
const W_SUM0: u64 = 144
const W_STEP0: u64 = 152
const W_RUNS: u64 = 160
const W_ZYK: u64 = 168
const W_FAIL: u64 = 176
const W_PTFRAMES: u64 = 184

const WW_OK: u64 = 0
const WW_OFF: u64 = 1
const WW_NOIMG: u64 = 2
const WW_MAGIC: u64 = 3
const WW_READ: u64 = 4
const WW_SLOT: u64 = 5
const WW_FRAME: u64 = 6
const WW_SPACE: u64 = 7

const TS_MAGIC: u64 = 0
const TS_PID: u64 = 8
const TS_STATE: u64 = 16
const TS_PRIO: u64 = 24
const TS_RSP: u64 = 32
const TS_KSTACK: u64 = 40
const TS_KTOP: u64 = 48
const TS_ENTRY: u64 = 56
const TS_USTACK: u64 = 64
const TS_KIND: u64 = 72
const TS_ARG: u64 = 80
const TS_WORK: u64 = 88
const TS_WAKE: u64 = 96
const TS_DATA: u64 = 104
const TS_NDATA: u64 = 112
const TS_DOFF: u64 = 120
const TS_UID: u64 = 128
const TS_GID: u64 = 136
const TS_PGID: u64 = 144
const TS_SID: u64 = 152
const TS_BYTES: u64 = 160

const WACH_MAGIC: u64 = 0x5741434854534B21
const WACH_HEAD: u64 = 0x5741434848454421
const WACH_USERTAG: u64 = 0x5741434855534552

const MAX_SAVE: u64 = 8

const PG_VIRT: u64 = 0
const PG_PHYS: u64 = 8
const PG_BYTES: u64 = 16
const MAX_PAGES: u64 = 448

const W_TASKS: u64 = 0x1000
const W_PAGES: u64 = 0x3000

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.WACH_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.WACH_OFF + off, v)
}

fn tsl(state: u64, n: u64) -> u64 {
    return state + kstate.WACH_OFF + W_TASKS + n * TS_BYTES
}

fn pgl(state: u64, n: u64) -> u64 {
    return state + kstate.WACH_OFF + W_PAGES + n * PG_BYTES
}

fn tsget(state: u64, n: u64, f: u64) -> u64 {
    return __mmio_read64((tsl(state, n) + f) as *mut u64)
}

fn tsset(state: u64, n: u64, f: u64, v: u64) {
    __mmio_write64((tsl(state, n) + f) as *mut u64, v)
}

fn pgget(state: u64, n: u64, f: u64) -> u64 {
    return __mmio_read64((pgl(state, n) + f) as *mut u64)
}

fn pgset(state: u64, n: u64, f: u64, v: u64) {
    __mmio_write64((pgl(state, n) + f) as *mut u64, v)
}

fn ready(state: u64) -> u64 {
    return g(state, W_READY)
}

fn resumed(state: u64) -> u64 {
    return g(state, W_RESUMED)
}

fn count(state: u64) -> u64 {
    return g(state, W_BACK)
}

fn tasks_in_image(state: u64) -> u64 {
    return g(state, W_SAVED)
}

fn tasks_back(state: u64) -> u64 {
    return g(state, W_BACK)
}

fn frames_taken(state: u64) -> u64 {
    return g(state, W_KBACK) + g(state, W_PTFRAMES)
}

fn saveable(state: u64, i: u64) -> bool {
    let st: u64 = taskslot.tget(state, i, taskconst.T_STATE)
    if st == taskconst.S_FREE || st == taskconst.S_ZOMBIE {
        return false
    }
    if taskslot.tget(state, i, taskconst.T_KIND) != taskconst.K_USER {
        return false
    }
    if taskslot.tget(state, i, taskconst.T_SHARED) != 0 {
        return false
    }
    let cr3: u64 = taskslot.tget(state, i, taskconst.T_CR3)
    if cr3 == 0 || cr3 == kstate.get(state, kstate.KPML4) {
        return false
    }
    if taskslot.tget(state, i, taskconst.T_KSTACK) == 0 {
        return false
    }
    return true
}


fn kstack_frames() -> u64 {
    return taskconst.KSTACK_FRAMES + 1
}

fn part_blocks(tasks: u64, pages: u64) -> u64 {
    let head: u64 = 1
    let saetze: u64 = (tasks * TS_BYTES + 511) / 512
    let board: u64 = (pages * PG_BYTES + 511) / 512
    let stack: u64 = tasks * kstack_frames() * 8
    return head + saetze + board + stack
}

fn reserve_blocks() -> u64 {
    return part_blocks(MAX_SAVE, MAX_PAGES) + 1
}

static mut frozen_state: [u64; 256] = [0 as u64; 256]
static mut frozen_mark: [u64; 256] = [0 as u64; 256]

const FREEZE_MS: u64 = 400
const BURNERS: u64 = 3
const BURN_USERTAG: u64 = 0x4255524e55534552
const FREEZE_FALLBACK_CYCLES: u64 = 1200000000

fn on_other_core(state: u64, i: u64) -> bool {
    let me: u64 = cpu.here(state)
    let n: u64 = cpu.count(state)
    var c: u64 = 0
    while c < n {
        if c != me && cpu.get(state, c, cpu.C_CUR) == i {
            return true
        }
        c = c + 1
    }
    return false
}

static mut th_restored: u64 = 0
static mut th_orphans: u64 = 0
static mut fz_limit: u64 = 0
static mut fz_marked: u64 = 0
static mut fz_running: u64 = 0
static mut fz_stray: u64 = 0
static mut fz_waited: u64 = 0
static mut fz_timeout: u64 = 0

fn on_any_core(state: u64, i: u64) -> bool {
    let n: u64 = cpu.count(state)
    var c: u64 = 0
    while c < n {
        if cpu.get(state, c, cpu.C_CUR) == i {
            return true
        }
        c = c + 1
    }
    return false
}

fn count_running(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        if frozen_mark[i as usize] != 0 && on_other_core(state, i) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn thaw(state: u64) {
    let legacy: bool = kstate.mode_on(state, kstate.M_OLDTHAW)
    th_restored = 0
    th_orphans = 0
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        if frozen_mark[i as usize] != 0 {
            var st: u64 = frozen_state[i as usize]
            if st == taskconst.S_RUN && !legacy && !on_any_core(state, i) {
                st = taskconst.S_READY
            }
            taskslot.tset(state, i, taskconst.T_STATE, st)
            frozen_mark[i as usize] = 0
            th_restored = th_restored + 1
            if st == taskconst.S_RUN && !on_any_core(state, i) {
                th_orphans = th_orphans + 1
            }
        }
        i = i + 1
    }
    atomic.lock_give(state, atomic.L_SCHED)
}

fn mark_frozen(state: u64, i: u64) -> bool {
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let st: u64 = taskslot.tget(state, i, taskconst.T_STATE)
    var marked: bool = false
    if st != taskconst.S_FREE && st != taskconst.S_ZOMBIE {
        frozen_state[i as usize] = st
        frozen_mark[i as usize] = 1
        taskslot.tset(state, i, taskconst.T_STATE, taskconst.S_STOP)
        marked = true
    }
    atomic.lock_give(state, atomic.L_SCHED)
    return marked
}

fn freeze(state: u64, limit: u64) -> bool {
    var seiten: u64 = 0
    var n: u64 = 0
    var i: u64 = 0
    fz_limit = limit
    fz_marked = 0
    fz_running = 0
    fz_stray = 0
    fz_waited = 0
    fz_timeout = 0
    while i < kstate.MAX_TASKS {
        frozen_mark[i as usize] = 0
        if saveable(state, i) && n < limit {
            let c: u64 = procpt.frame_count(state, i)
            if seiten + c <= MAX_PAGES && mark_frozen(state, i) {
                seiten = seiten + c
                n = n + 1
            }
        }
        i = i + 1
    }
    fz_marked = n
    if cpu.count(state) <= 1 {
        return true
    }
    fz_running = count_running(state)
    if kstate.mode_on(state, kstate.M_NOFREEZEWAIT) {
        fz_stray = fz_running
        return true
    }
    var budget: u64 = kstate.get(state, kstate.TIME_KHZ) * FREEZE_MS
    if budget == 0 {
        budget = FREEZE_FALLBACK_CYCLES
    }
    let t0: u64 = arch.cycles()
    while true {
        let busy: u64 = count_running(state)
        let forced: bool = kstate.mode_on(state, kstate.M_FREEZETMO) && busy < fz_running
        if busy == 0 && !forced {
            fz_waited = arch.cycles() - t0
            return true
        }
        if forced || arch.cycles() - t0 > budget {
            fz_waited = arch.cycles() - t0
            fz_stray = busy
            fz_timeout = 1
            thaw(state)
            return false
        }
        arch.pause()
    }
    return false
}

fn task_limit(state: u64, base: u64) -> u64 {
    let total: u64 = susp.blocks(state)
    if total <= base + 24 {
        return 0
    }
    let per_task: u64 = kstack_frames() * 8 + 1
    let fit: u64 = (total - base - 24) / per_task
    if fit < MAX_SAVE {
        return fit
    }
    return MAX_SAVE
}

fn freeze_report(state: u64) {
    var s_f: [u8; 21] = "wake: freeze marked=\0"
    var s_r: [u8; 10] = " running=\0"
    var s_s: [u8; 8] = " stray=\0"
    var s_w: [u8; 12] = " waited_ms=\0"
    var s_t: [u8; 10] = " timeout=\0"
    var s_c: [u8; 8] = " cores=\0"
    var s_lm: [u8; 8] = " limit=\0"
    var s_th: [u8; 11] = " restored=\0"
    var s_or: [u8; 10] = " orphans=\0"
    var wms: u64 = 0
    let khz: u64 = kstate.get(state, kstate.TIME_KHZ)
    if khz != 0 {
        wms = fz_waited / khz
    }
    let z: u64 = serial.line_at()
    serial.puts((&s_f[0]) as u64)
    serial.dec(fz_marked)
    serial.puts((&s_r[0]) as u64)
    serial.dec(fz_running)
    serial.puts((&s_s[0]) as u64)
    serial.dec(fz_stray)
    serial.puts((&s_w[0]) as u64)
    serial.dec(wms)
    serial.puts((&s_t[0]) as u64)
    serial.dec(fz_timeout)
    serial.puts((&s_c[0]) as u64)
    serial.dec(cpu.count(state))
    serial.puts((&s_lm[0]) as u64)
    serial.dec(fz_limit)
    if fz_timeout != 0 {
        serial.puts((&s_th[0]) as u64)
        serial.dec(th_restored)
        serial.puts((&s_or[0]) as u64)
        serial.dec(th_orphans)
    }
    serial.nl()
    serial.line_clear(z)
}

fn collect(state: u64) -> u64 {
    var n: u64 = 0
    var seiten: u64 = 0
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        if frozen_mark[i as usize] != 0 {
            let c: u64 = procpt.frame_count(state, i)
            tsset(state, n, TS_MAGIC, WACH_MAGIC)
            tsset(state, n, TS_PID, taskslot.tget(state, i, taskconst.T_PID))
            tsset(state, n, TS_STATE, frozen_state[i as usize])
            tsset(state, n, TS_PRIO, taskslot.tget(state, i, taskconst.T_PRIO))
            tsset(state, n, TS_RSP, taskslot.tget(state, i, taskconst.T_RSP))
            tsset(state, n, TS_KSTACK, taskslot.tget(state, i, taskconst.T_KSTACK))
            tsset(state, n, TS_KTOP, taskslot.tget(state, i, taskconst.T_KTOP))
            tsset(state, n, TS_ENTRY, taskslot.tget(state, i, taskconst.T_ENTRY))
            tsset(state, n, TS_USTACK, taskslot.tget(state, i, taskconst.T_USTACK))
            tsset(state, n, TS_KIND, taskslot.tget(state, i, taskconst.T_KIND))
            tsset(state, n, TS_ARG, taskslot.tget(state, i, taskconst.T_ARG))
            tsset(state, n, TS_WORK, taskslot.tget(state, i, taskconst.T_WORK))
            tsset(state, n, TS_WAKE, taskslot.tget(state, i, taskconst.T_WAKE))
            tsset(state, n, TS_DATA, taskslot.tget(state, i, taskconst.T_DATA))
            tsset(state, n, TS_NDATA, c)
            tsset(state, n, TS_DOFF, seiten)
            tsset(state, n, TS_UID, taskslot.tget(state, i, taskconst.T_UID))
            tsset(state, n, TS_GID, taskslot.tget(state, i, taskconst.T_GID))
            tsset(state, n, TS_PGID, taskslot.tget(state, i, taskconst.T_PGID))
            tsset(state, n, TS_SID, taskslot.tget(state, i, taskconst.T_SID))
            var k: u64 = 0
            while k < c {
                pgset(state, seiten + k, PG_VIRT,
                    procpt.frame_virt_at(state, i, k))
                pgset(state, seiten + k, PG_PHYS,
                    procpt.frame_at(state, i, k))
                k = k + 1
            }
            var s_w: [u8; 13] = "wake: saved \0"
            var s_pd: [u8; 6] = " pid=\0"
            var s_st: [u8; 5] = " st=\0"
            var s_pr: [u8; 7] = " prog=\0"
            var s_sn: [u8; 8] = " pages=\0"
            let z: u64 = serial.line_at()
            serial.puts((&s_w[0]) as u64)
            serial.puts((&s_pd[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_PID))
            serial.puts((&s_st[0]) as u64)
            serial.dec(frozen_state[i as usize])
            serial.puts((&s_pr[0]) as u64)
            serial.dec(taskslot.tget(state, i, taskconst.T_ARG))
            serial.puts((&s_sn[0]) as u64)
            serial.dec(c)
            serial.nl()
            serial.line_clear(z)
            seiten = seiten + c
            n = n + 1
        }
        i = i + 1
    }
    s(state, W_DFRAMES, seiten)
    return n
}

fn save_tasks(state: u64, dev: u64, base: u64, b: u64) -> bool {
    let ok: bool = write_image(state, dev, base, b)
    var s_i: [u8; 22] = "wake: image written=\0\0"
    var s_n: [u8; 8] = " tasks=\0"
    var s_p: [u8; 8] = " phase=\0"
    var s_b: [u8; 7] = " base=\0"
    var s_l: [u8; 6] = " lba=\0"
    let z: u64 = serial.line_at()
    serial.puts((&s_i[0]) as u64)
    if ok {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_n[0]) as u64)
    serial.dec(g(state, W_SAVED))
    serial.puts((&s_p[0]) as u64)
    serial.dec(save_phase)
    serial.puts((&s_b[0]) as u64)
    serial.dec(base)
    serial.puts((&s_l[0]) as u64)
    serial.dec(save_lba)
    serial.nl()
    serial.line_clear(z)
    return ok
}

static mut save_phase: u64 = 0
static mut save_lba: u64 = 0

fn put_block(state: u64, dev: u64, lba: u64, src: u64) -> bool {
    save_lba = lba
    return blk.write_on(state, dev, lba, src)
}

fn write_image(state: u64, dev: u64, base: u64, b: u64) -> bool {
    s(state, W_READY, 1)
    s(state, W_SAVED, 0)
    s(state, W_KFRAMES, 0)
    save_phase = 1
    let freeze_flags: u64 = arch.irq_save()
    let frozen: bool = freeze(state, task_limit(state, base))
    freeze_report(state)
    if !frozen {
        arch.irq_restore(freeze_flags)
        return false
    }
    let n: u64 = collect(state)
    arch.irq_restore(freeze_flags)
    let pages: u64 = g(state, W_DFRAMES)
    if n == 0 {
        s(state, W_SAVED, 0)
    }
    var sum: u64 = bootmod.crc32_start()
    let saetze: u64 = (n * TS_BYTES + 511) / 512
    let board: u64 = (pages * PG_BYTES + 511) / 512

    save_phase = 2
    var blkn: u64 = 0
    while blkn < saetze {
        var i: u64 = 0
        while i < 512 {
            kstate.set8(b + i, 0 as u8)
            i = i + 1
        }
        i = 0
        while i < 512 {
            let off: u64 = blkn * 512 + i
            if off < n * TS_BYTES {
                kstate.set8(b + i,
                    kstate.get8(state + kstate.WACH_OFF + W_TASKS + off) as u8)
            }
            i = i + 1
        }
        sum = bootmod.crc32_feed(sum, b, 512)
        if !put_block(state, dev, base + 1 + blkn, b) {
            return false
        }
        blkn = blkn + 1
    }

    save_phase = 3
    blkn = 0
    while blkn < board {
        var i: u64 = 0
        while i < 512 {
            kstate.set8(b + i, 0 as u8)
            i = i + 1
        }
        i = 0
        while i < 512 {
            let off: u64 = blkn * 512 + i
            if off < pages * PG_BYTES {
                kstate.set8(b + i,
                    kstate.get8(state + kstate.WACH_OFF + W_PAGES + off) as u8)
            }
            i = i + 1
        }
        sum = bootmod.crc32_feed(sum, b, 512)
        if !put_block(state, dev, base + 1 + saetze + blkn, b) {
            return false
        }
        blkn = blkn + 1
    }

    save_phase = 4
    let kf: u64 = kstack_frames()
    let stack_lba: u64 = base + 1 + saetze + board
    var kframes: u64 = 0
    var t: u64 = 0
    while t < n {
        let bottom: u64 = tsget(state, t, TS_KSTACK) - mmframe.FRAME_SIZE
        var f: u64 = 0
        while f < kf {
            let pa: u64 = bottom + f * mmframe.FRAME_SIZE
            var bn: u64 = 0
            while bn < 8 {
                var i: u64 = 0
                while i < 512 {
                    kstate.set8(b + i, kstate.get8(mmframe.kva(pa) + bn * 512 + i) as u8)
                    i = i + 1
                }
                sum = bootmod.crc32_feed(sum, b, 512)
                if !put_block(state, dev,
                    stack_lba + (t * kf + f) * 8 + bn, b) {
                    return false
                }
                bn = bn + 1
            }
            kframes = kframes + 1
            f = f + 1
        }
        t = t + 1
    }
    s(state, W_KFRAMES, kframes)

    var i: u64 = 0
    while i < 512 {
        kstate.set8(b + i, 0 as u8)
        i = i + 1
    }
    save_phase = 5
    __mmio_write64(b as *mut u64, WACH_HEAD)
    __mmio_write64((b + 8) as *mut u64, n)
    __mmio_write64((b + 16) as *mut u64, pages)
    __mmio_write64((b + 24) as *mut u64, bootmod.crc32_end(sum))
    __mmio_write64((b + 32) as *mut u64, kframes)
    __mmio_write64((b + 40) as *mut u64, kstate.get(state, kstate.TICKS))
    __mmio_write64((b + 48) as *mut u64, g(state, W_STEP0))
    __mmio_write64((b + 56) as *mut u64, g(state, W_SUM0))
    if !put_block(state, dev, base + B_PART, b) {
        return false
    }
    s(state, W_SAVED, n)
    s(state, W_TICKS0, kstate.get(state, kstate.TICKS))
    s(state, W_LBA, base)
    s(state, W_BLOCKS, part_blocks(n, pages))
    s(state, W_SUM, bootmod.crc32_end(sum))
    save_phase = 6
    return true
}

const B_PART: u64 = 0


fn restore_tasks(state: u64, dev: u64, base: u64, b: u64) -> bool {
    s(state, W_BACK, 0)
    s(state, W_KBACK, 0)
    s(state, W_PTFRAMES, 0)
    s(state, W_RESUMED, 0)
    s(state, W_WHY, WW_OK)
    if kstate.mode_on(state, kstate.M_NOWACH) {
        s(state, W_WHY, WW_OFF)
        return false
    }
    if !blk.read_on(state, dev, base + B_PART, b) {
        s(state, W_WHY, WW_READ)
        return false
    }
    if __mmio_read64(b as *mut u64) != WACH_HEAD {
        s(state, W_WHY, WW_MAGIC)
        return false
    }
    let n: u64 = __mmio_read64((b + 8) as *mut u64)
    let pages: u64 = __mmio_read64((b + 16) as *mut u64)
    let want: u64 = __mmio_read64((b + 24) as *mut u64)
    let kfr: u64 = __mmio_read64((b + 32) as *mut u64)
    let ticks0: u64 = __mmio_read64((b + 40) as *mut u64)
    s(state, W_STEP0, __mmio_read64((b + 48) as *mut u64))
    s(state, W_SUM0, __mmio_read64((b + 56) as *mut u64))
    s(state, W_TICKS0, ticks0)
    if n == 0 {
        s(state, W_WHY, WW_NOIMG)
        return false
    }
    if n > MAX_SAVE || pages > MAX_PAGES {
        s(state, W_WHY, WW_MAGIC)
        return false
    }
    let saetze: u64 = (n * TS_BYTES + 511) / 512
    let board: u64 = (pages * PG_BYTES + 511) / 512
    let kf: u64 = kstack_frames()
    let stack_lba: u64 = base + 1 + saetze + board

    var sum: u64 = bootmod.crc32_start()
    let total: u64 = saetze + board + n * kf * 8
    var i: u64 = 0
    while i < total {
        if !blk.read_on(state, dev, base + 1 + i, b) {
            s(state, W_WHY, WW_READ)
            return false
        }
        sum = bootmod.crc32_feed(sum, b, 512)
        i = i + 1
    }
    if bootmod.crc32_end(sum) != want {
        s(state, W_WHY, WW_MAGIC)
        return false
    }

    var blkn: u64 = 0
    while blkn < saetze {
        if !blk.read_on(state, dev, base + 1 + blkn, b) {
            s(state, W_WHY, WW_READ)
            return false
        }
        i = 0
        while i < 512 {
            let off: u64 = blkn * 512 + i
            if off < n * TS_BYTES {
                kstate.set8(state + kstate.WACH_OFF + W_TASKS + off,
                    kstate.get8(b + i) as u8)
            }
            i = i + 1
        }
        blkn = blkn + 1
    }
    blkn = 0
    while blkn < board {
        if !blk.read_on(state, dev, base + 1 + saetze + blkn, b) {
            s(state, W_WHY, WW_READ)
            return false
        }
        i = 0
        while i < 512 {
            let off: u64 = blkn * 512 + i
            if off < pages * PG_BYTES {
                kstate.set8(state + kstate.WACH_OFF + W_PAGES + off,
                    kstate.get8(b + i) as u8)
            }
            i = i + 1
        }
        blkn = blkn + 1
    }

    var back: u64 = 0
    var kback: u64 = 0
    var dback: u64 = 0
    var t: u64 = 0
    while t < n {
        if tsget(state, t, TS_MAGIC) != WACH_MAGIC {
            s(state, W_WHY, WW_MAGIC)
            return false
        }
        let bottom: u64 = tsget(state, t, TS_KSTACK) - mmframe.FRAME_SIZE
        var f: u64 = 0
        var stack_ok: u64 = 1
        while f < kf {
            let pa: u64 = bottom + f * mmframe.FRAME_SIZE
            if !mmframe.reserve_frame(state, pa) {
                stack_ok = 0
            }
            f = f + 1
        }
        if stack_ok == 0 {
            s(state, W_WHY, WW_FRAME)
            s(state, W_FAIL, tsget(state, t, TS_PID))
            return false
        }
        f = 0
        while f < kf {
            let pa: u64 = bottom + f * mmframe.FRAME_SIZE
            var bn: u64 = 0
            while bn < 8 {
                if !blk.read_on(state, dev,
                    stack_lba + (t * kf + f) * 8 + bn, b) {
                    s(state, W_WHY, WW_READ)
                    return false
                }
                i = 0
                while i < 512 {
                    kstate.set8(mmframe.kva(pa) + bn * 512 + i, kstate.get8(b + i) as u8)
                    i = i + 1
                }
                bn = bn + 1
            }
            kback = kback + 1
            f = f + 1
        }

        var slot: u64 = 0
        var k: u64 = 1
        while k < kstate.MAX_TASKS {
            if slot == 0 && taskslot.tget(state, k, taskconst.T_STATE) == taskconst.S_FREE {
                slot = k
            }
            k = k + 1
        }
        if slot == 0 {
            s(state, W_WHY, WW_SLOT)
            return false
        }
        var j: u64 = 0
        while j < kstate.TASK_BYTES / 8 {
            __mmio_write64((taskslot.task_at(state, slot) + j * 8) as *mut u64, 0)
            j = j + 1
        }
        taskslot.tset(state, slot, taskconst.T_PID, tsget(state, t, TS_PID))
        taskslot.tset(state, slot, taskconst.T_PRIO, tsget(state, t, TS_PRIO))
        taskslot.tset(state, slot, taskconst.T_BUDGET, tsget(state, t, TS_PRIO))
        taskslot.tset(state, slot, taskconst.T_KIND, tsget(state, t, TS_KIND))
        taskslot.tset(state, slot, taskconst.T_ARG, tsget(state, t, TS_ARG))
        taskslot.tset(state, slot, taskconst.T_WORK, tsget(state, t, TS_WORK))
        taskslot.tset(state, slot, taskconst.T_ENTRY, tsget(state, t, TS_ENTRY))
        taskslot.tset(state, slot, taskconst.T_USTACK, tsget(state, t, TS_USTACK))
        taskslot.tset(state, slot, taskconst.T_KSTACK, tsget(state, t, TS_KSTACK))
        taskslot.tset(state, slot, taskconst.T_KTOP, tsget(state, t, TS_KTOP))
        taskslot.tset(state, slot, taskconst.T_RSP, tsget(state, t, TS_RSP))
        taskslot.tset(state, slot, taskconst.T_UID, tsget(state, t, TS_UID))
        taskslot.tset(state, slot, taskconst.T_GID, tsget(state, t, TS_GID))
        taskslot.tset(state, slot, taskconst.T_EUID, tsget(state, t, TS_UID))
        taskslot.tset(state, slot, taskconst.T_EGID, tsget(state, t, TS_GID))
        taskslot.tset(state, slot, taskconst.T_PGID, tsget(state, t, TS_PGID))
        taskslot.tset(state, slot, taskconst.T_SID, tsget(state, t, TS_SID))
        taskslot.tset(state, slot, taskconst.T_PARENT, 0)

        let frei_vor_pt: u64 = mmframe.frames_free(state)
        let space: u64 = procpt.space_build_empty(state, slot)
        if space == 0 {
            s(state, W_WHY, WW_SPACE)
            return false
        }
        taskslot.tset(state, slot, taskconst.T_CR3, space)
        taskslot.tset(state, slot, taskconst.T_DATA, tsget(state, t, TS_DATA))
        let doff: u64 = tsget(state, t, TS_DOFF)
        let nd: u64 = tsget(state, t, TS_NDATA)
        var d: u64 = 0
        while d < nd {
            let va: u64 = pgget(state, doff + d, PG_VIRT)
            let pa: u64 = pgget(state, doff + d, PG_PHYS)
            if va != 0 && pa != 0 {
                if procmap.map_restored(state, slot, va, pa) {
                    dback = dback + 1
                }
            }
            d = d + 1
        }

        let area: u64 = fpu.area_new(state)
        if area != 0 {
            sched.fpu_set_area(state, slot, area)
        }
        let frei_nach_pt: u64 = mmframe.frames_free(state)
        if frei_vor_pt > frei_nach_pt {
            s(state, W_PTFRAMES,
                g(state, W_PTFRAMES) + (frei_vor_pt - frei_nach_pt))
        }

        let st: u64 = tsget(state, t, TS_STATE)
        if st == taskconst.S_SLEEP || st == taskconst.S_READY || st == taskconst.S_RUN {
            taskslot.tset(state, slot, taskconst.T_STATE, taskconst.S_READY)
        } else {
            taskslot.tset(state, slot, taskconst.T_STATE, taskconst.S_STOP)
        }
        if slot + 1 > kstate.get(state, kstate.TASKS) {
            kstate.set(state, kstate.TASKS, slot + 1)
        }
        if back < 4 {
            s(state, W_PID0 + back * 8, tsget(state, t, TS_PID))
        }
        back = back + 1
        t = t + 1
    }
    s(state, W_BACK, back)
    s(state, W_KBACK, kback)
    s(state, W_DBACK, dback)
    s(state, W_RESUMED, 1)
    var maxpid: u64 = kstate.get(state, kstate.NEXT_PID)
    t = 0
    while t < n {
        if tsget(state, t, TS_PID) + 1 > maxpid {
            maxpid = tsget(state, t, TS_PID) + 1
        }
        t = t + 1
    }
    kstate.set(state, kstate.NEXT_PID, maxpid)
    return true
}

fn why_name(w: u64) {
    var s0: [u8; 3] = "ok\0"
    var s1: [u8; 9] = "disabled\0"
    var s2: [u8; 16] = "no task part\0\0\0\0"
    var s3: [u8; 10] = "id wrong\0\0"
    var s4: [u8; 14] = "read error\0\0\0\0"
    var s5: [u8; 14] = "no task slot\0\0"
    var s6: [u8; 15] = "frame busy\0\0\0\0\0"
    var s7: [u8; 21] = "no address space\0\0\0\0\0"
    if w == WW_OK { serial.puts((&s0[0]) as u64) }
    if w == WW_OFF { serial.puts((&s1[0]) as u64) }
    if w == WW_NOIMG { serial.puts((&s2[0]) as u64) }
    if w == WW_MAGIC { serial.puts((&s3[0]) as u64) }
    if w == WW_READ { serial.puts((&s4[0]) as u64) }
    if w == WW_SLOT { serial.puts((&s5[0]) as u64) }
    if w == WW_FRAME { serial.puts((&s6[0]) as u64) }
    if w == WW_SPACE { serial.puts((&s7[0]) as u64) }
}

fn bericht(state: u64) {
    var s_t: [u8; 11] = "wake: back\0"
    var s_a: [u8; 8] = " tasks=\0"
    var s_k: [u8; 9] = " kstack=\0"
    var s_d: [u8; 8] = " pages=\0"
    var s_pt: [u8; 9] = " tables=\0"
    var s_w: [u8; 6] = " why=\0"
    serial.puts((&s_t[0]) as u64)
    serial.puts((&s_a[0]) as u64)
    serial.dec(g(state, W_BACK))
    serial.puts((&s_k[0]) as u64)
    serial.dec(g(state, W_KBACK))
    serial.puts((&s_d[0]) as u64)
    serial.dec(g(state, W_DBACK))
    serial.puts((&s_pt[0]) as u64)
    serial.dec(g(state, W_PTFRAMES))
    serial.puts((&s_w[0]) as u64)
    why_name(g(state, W_WHY))
    serial.nl()
}

fn running(state: u64) -> u64 {
    var c: u64 = 0
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        if taskslot.tget(state, i, taskconst.T_KIND) == taskconst.K_USER {
            if taskslot.tget(state, i, taskconst.T_RUNS) > 0 {
                c = c + 1
            }
        }
        i = i + 1
    }
    return c
}

fn measure(state: u64) {
    var s_t: [u8; 14] = "wake: measure\0"
    var s_s: [u8; 8] = " saved=\0"
    var s_b: [u8; 7] = " back=\0"
    var s_r: [u8; 6] = " ran=\0"
    var s_m: [u8; 10] = " maxsave=\0"
    serial.puts((&s_t[0]) as u64)
    serial.puts((&s_s[0]) as u64)
    serial.dec(g(state, W_SAVED))
    serial.puts((&s_b[0]) as u64)
    serial.dec(g(state, W_BACK))
    serial.puts((&s_r[0]) as u64)
    serial.dec(running(state))
    serial.puts((&s_m[0]) as u64)
    serial.dec(MAX_SAVE)
    serial.nl()
}

fn arm(state: u64, zyk: u64) {
    var s_t: [u8; 20] = "wake: == arm cycle \0"
    var s_p: [u8; 15] = "wake: procs n=\0"
    var s_v: [u8; 15] = "wake: before \0\0"
    var s_r: [u8; 9] = " rounds=\0"
    var s_s: [u8; 6] = " sum=\0"
    var s_pid: [u8; 7] = " pids=\0"

    s(state, W_ZYK, zyk)
    serial.puts((&s_t[0]) as u64)
    serial.dec(zyk)
    serial.nl()

    let a: u64 = procspace.create(state, 65, 4000, 2)
    let b2: u64 = procspace.create(state, 65, 4000, 2)
    let c: u64 = procspace.create(state, 65, 4000, 2)
    if kstate.mode_on(state, kstate.M_WACHBURN) {
        var burners: u64 = 0
        var attempts: u64 = 0
        while burners < BURNERS && attempts < BURNERS * 2 {
            if procspace.create(state, 68, 4000000000, 2) != 0 {
                burners = burners + 1
            }
            attempts = attempts + 1
        }
        var s_bn: [u8; 15] = "wake: burn n=\0\0"
        let zb: u64 = serial.line_at()
        serial.puts((&s_bn[0]) as u64)
        serial.dec(burners)
        serial.nl()
        serial.line_clear(zb)
    }
    var n: u64 = 0
    if a != 0 { n = n + 1 }
    if b2 != 0 { n = n + 1 }
    if c != 0 { n = n + 1 }
    let fp: u64 = arch.irq_save()
    let zp: u64 = serial.line_at()
    serial.puts((&s_p[0]) as u64)
    serial.dec(n)
    serial.puts((&s_pid[0]) as u64)
    if a != 0 { serial.dec(taskslot.tget(state, a, taskconst.T_PID)) }
    var komma: [u8; 2] = ",\0"
    if b2 != 0 {
        serial.puts((&komma[0]) as u64)
        serial.dec(taskslot.tget(state, b2, taskconst.T_PID))
    }
    if c != 0 {
        serial.puts((&komma[0]) as u64)
        serial.dec(taskslot.tget(state, c, taskconst.T_PID))
    }
    serial.nl()
    serial.line_clear(zp)
    arch.irq_restore(fp)

    sched.sleep_ticks(state, 60)

    var runden: u64 = 0
    var sum_value: u64 = 0
    if a != 0 {
        let pa: u64 = procmap.translate(state, a, 0x40000000)
        if pa != 0 {
            sum_value = __mmio_read64((pa + 8) as *mut u64)
            runden = __mmio_read64((pa + 24) as *mut u64)
        }
    }
    s(state, W_SUM0, sum_value)
    s(state, W_STEP0, runden)
    let fv: u64 = arch.irq_save()
    let zv: u64 = serial.line_at()
    serial.puts((&s_v[0]) as u64)
    serial.puts((&s_r[0]) as u64)
    serial.dec(runden)
    serial.puts((&s_s[0]) as u64)
    serial.dec(sum_value)
    serial.nl()
    serial.line_clear(zv)
    arch.irq_restore(fv)
}

static mut burn_before: [u64; 256] = [0 as u64; 256]

fn burner_sample(state: u64, record: bool) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        if taskslot.tget(state, i, taskconst.T_KIND) == taskconst.K_USER
            && taskslot.tget(state, i, taskconst.T_STATE) != taskconst.S_FREE
            && taskslot.tget(state, i, taskconst.T_CR3) != 0
            && taskslot.tget(state, i, taskconst.T_CR3)
                != kstate.get(state, kstate.KPML4) {
            let pa: u64 = procmap.translate(state, i, 0x40000000)
            if pa != 0 && __mmio_read64(pa as *mut u64) == BURN_USERTAG {
                let rounds: u64 = __mmio_read64((pa + 8) as *mut u64)
                if record {
                    burn_before[i as usize] = rounds
                    n = n + 1
                } else if rounds > burn_before[i as usize] && burn_before[i as usize] > 0 {
                    n = n + 1
                }
            }
        }
        i = i + 1
    }
    return n
}

fn burner_report(state: u64, found: u64, rising: u64) {
    var s_b: [u8; 21] = "wake: burners found=\0"
    var s_r: [u8; 9] = " rising=\0"
    let z: u64 = serial.line_at()
    serial.puts((&s_b[0]) as u64)
    serial.dec(found)
    serial.puts((&s_r[0]) as u64)
    serial.dec(rising)
    serial.nl()
    serial.line_clear(z)
}

fn check(state: u64) {
    var s_t: [u8; 17] = "wake: == check\0\0\0"
    var s_w: [u8; 15] = "wake: resume \0\0"
    var s_v: [u8; 9] = " before=\0"
    var s_n: [u8; 8] = " after=\0"
    var s_s: [u8; 6] = " sum=\0"
    var s_so: [u8; 7] = " want=\0"
    var s_ok: [u8; 17] = "wake: resumed=\0\0\0"
    var s_l: [u8; 6] = " ran=\0"
    var s_p: [u8; 8] = " procs=\0"
    var s_a: [u8; 7] = " all=\0\0"

    serial.puts((&s_t[0]) as u64)
    serial.nl()
    bericht(state)
    if g(state, W_BACK) == 0 {
        serial.puts((&s_ok[0]) as u64)
        serial.dec(0)
        serial.nl()
        return
    }

    let burners_found: u64 = burner_sample(state, true)
    sched.sleep_ticks(state, 80)
    let burners_rising: u64 = burner_sample(state, false)
    if burners_found > 0 {
        burner_report(state, burners_found, burners_rising)
    }

    var gelaufen: u64 = 0
    var go_on: u64 = 0
    var prozesse: u64 = 0
    var first_before: u64 = g(state, W_STEP0)
    var first_after: u64 = 0
    var first_sum: u64 = 0
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        if taskslot.tget(state, i, taskconst.T_KIND) == taskconst.K_USER
            && taskslot.tget(state, i, taskconst.T_STATE) != taskconst.S_FREE
            && taskslot.tget(state, i, taskconst.T_CR3) != 0
            && taskslot.tget(state, i, taskconst.T_CR3)
                != kstate.get(state, kstate.KPML4) {
            let pa: u64 = procmap.translate(state, i, 0x40000000)
            if pa != 0 {
                if __mmio_read64(pa as *mut u64) == WACH_USERTAG {
                    prozesse = prozesse + 1
                    if taskslot.tget(state, i, taskconst.T_RUNS) > 0 {
                        gelaufen = gelaufen + 1
                    }
                    let su: u64 = __mmio_read64((pa + 8) as *mut u64)
                    let sc: u64 = __mmio_read64((pa + 16) as *mut u64)
                    let ru: u64 = __mmio_read64((pa + 24) as *mut u64)
                    var soll: u64 = 0
                    if sc > 0 {
                        let nn: u64 = sc - 1
                        soll = nn * (nn + 1) / 2
                    }
                    if ru > first_before && su == soll && su > 0 {
                        go_on = go_on + 1
                    }
                    if first_after == 0 {
                        first_after = ru
                        first_sum = su
                    }
                }
            }
        }
        i = i + 1
    }

    var soll0: u64 = 0
    if first_after > 0 {
        soll0 = first_sum
    }
    serial.puts((&s_w[0]) as u64)
    serial.puts((&s_v[0]) as u64)
    serial.dec(first_before)
    serial.puts((&s_n[0]) as u64)
    serial.dec(first_after)
    serial.puts((&s_s[0]) as u64)
    serial.dec(first_sum)
    serial.puts((&s_so[0]) as u64)
    serial.dec(soll0)
    serial.nl()

    var every: u64 = 0
    if go_on > 0 && go_on == prozesse {
        every = 1
    }
    s(state, W_RUNS, go_on)
    serial.puts((&s_ok[0]) as u64)
    serial.dec(go_on)
    serial.puts((&s_l[0]) as u64)
    serial.dec(gelaufen)
    serial.puts((&s_p[0]) as u64)
    serial.dec(prozesse)
    serial.puts((&s_a[0]) as u64)
    serial.dec(every)
    serial.nl()
}
