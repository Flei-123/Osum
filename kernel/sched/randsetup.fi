profile kernel

import lib.kstate
import serial
import diag.cmdopt
import sched.rand

export { start, report }

static mut W_NOTRUST: [u8; 15] = "randnotrustcpu\0"
static mut W_NOJITTER: [u8; 13] = "randnojitter\0"
static mut W_STUCK: [u8; 16] = "randjitterstuck\0"
static mut L_READY: [u8; 13] = "rand: ready=\0"
static mut L_BITS: [u8; 7] = " bits=\0"
static mut L_CPU: [u8; 6] = " cpu=\0"
static mut L_JIT: [u8; 9] = " jitter=\0"
static mut L_SEED: [u8; 7] = " seed=\0"
static mut L_IRQ: [u8; 6] = " irq=\0"
static mut L_CAPS: [u8; 7] = " caps=\0"
static mut L_TRUST: [u8; 8] = " trust=\0"
static mut L_MODE: [u8; 6] = " jit=\0"
static mut L_JFAIL: [u8; 8] = " jfail=\0"
static mut L_JSAMP: [u8; 11] = " jsamples=\0"

fn start(state: u64) {
    var trust: u64 = 1
    var jitter: u64 = rand.JIT_ON
    if cmdopt.has(state, (&W_NOTRUST[0]) as u64) {
        trust = 0
    }
    if cmdopt.has(state, (&W_NOJITTER[0]) as u64) {
        jitter = rand.JIT_OFF
    }
    if cmdopt.has(state, (&W_STUCK[0]) as u64) {
        jitter = rand.JIT_STUCK
    }
    rand.configure(state, trust, jitter)
    rand.init(state)
}

fn field(label: u64, v: u64) {
    serial.puts(label)
    serial.dec(v)
}

fn report(state: u64) {
    let units: u64 = rand.stat(state, rand.S_UNITS_CPU) + rand.stat(state, rand.S_UNITS_JITTER)
        + rand.stat(state, rand.S_UNITS_SEED)
    field((&L_READY[0]) as u64, rand.ready(state))
    field((&L_BITS[0]) as u64, units / rand.UNITS_PER_BIT)
    field((&L_CPU[0]) as u64, rand.stat(state, rand.S_UNITS_CPU) / rand.UNITS_PER_BIT)
    field((&L_JIT[0]) as u64, rand.stat(state, rand.S_UNITS_JITTER) / rand.UNITS_PER_BIT)
    field((&L_SEED[0]) as u64, rand.stat(state, rand.S_UNITS_SEED) / rand.UNITS_PER_BIT)
    field((&L_IRQ[0]) as u64, rand.stat(state, rand.S_UNITS_IRQ) / rand.UNITS_PER_BIT)
    field((&L_CAPS[0]) as u64, rand.stat(state, rand.S_CPU_CAPS))
    field((&L_TRUST[0]) as u64, rand.stat(state, rand.S_TRUST_CPU))
    field((&L_MODE[0]) as u64, rand.stat(state, rand.S_JIT_MODE))
    field((&L_JSAMP[0]) as u64, rand.stat(state, rand.S_JIT_SAMPLES))
    field((&L_JFAIL[0]) as u64, rand.stat(state, rand.S_JIT_FAILS))
    serial.nl()
}
