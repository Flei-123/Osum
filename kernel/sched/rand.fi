profile kernel

import lib.kstate
import sched.time
import sync.atomic
import entropy.pool
import entropy.drbg
import entropy.health

export {
    init, configure, settle, poll, seed, bytes, stir, mix, credit_seed, export_seed,
    ready, hardware, seed_hex, fixed_set, stat, RESEED, READY_UNITS, UNITS_PER_BIT, SEED_FILE_BITS,
    JIT_OFF, JIT_ON, JIT_STUCK,
    S_UNITS_CPU, S_UNITS_JITTER, S_UNITS_SEED, S_UNITS_IRQ, S_JIT_SAMPLES, S_JIT_FAILS,
    S_IRQ_SAMPLES, S_IRQ_FAILS, S_GENERATION, S_RESEEDS, S_CPU_CAPS, S_TRUST_CPU,
    S_JIT_MODE, S_READY_TSC, S_MIXED_BYTES, S_BYTES_OUT, S_PENDING_BITS,
}

const K_RING: u64 = 96
const K_REPORT: u64 = 256
const RING_WORDS: u64 = 8
const WORD: u64 = 8
const REPORT_BYTES: u64 = 16

const M32: u64 = 0xFFFFFFFF
const GOLD: u64 = 0x9E3779B97F4A7C15
const RESEED: u64 = 4096

const UNITS_PER_BIT: u64 = 16
const READY_BITS: u64 = 256
const READY_UNITS: u64 = READY_BITS * UNITS_PER_BIT
const CPU_SEED_BITS: u64 = 256
const CPU_RDRAND_BITS: u64 = 128
const SEED_FILE_BITS: u64 = 128
const IRQ_CAP_BITS: u64 = 64
const IRQ_EVENTS_PER_UNIT: u64 = 8
const JITTER_SAMPLES_PER_UNIT: u64 = 2
const JITTER_BATCH: u64 = 1024
const JITTER_WORK: u64 = 12
const JITTER_MEM_WORDS: u64 = 64
const JITTER_MEM_MASK: u64 = 63
const JITTER_FLUSH_WORDS: u64 = 32
const JITTER_SAMPLE_MASK: u64 = 0xFFFF
const JITTER_STUCK_VALUE: u64 = 0x2A2A
const JITTER_INIT_BATCHES: u64 = 24
const SETTLE_BATCHES: u64 = 48
const RDSEED_WORDS: u64 = 4
const RDRAND_WORDS: u64 = 4
const HW_RETRIES: u64 = 16
const CPUID_LEAF7_RDSEED: u64 = 0x40000
const CPUID_LEAF1_RDRAND: u64 = 0x40000000
const IRQ_SAMPLE_MASK: u64 = 0xFFF
const MIX_BLOCK_BYTES: u64 = 256
const SEED_BYTES: u64 = 64
const KEY_BYTES: u64 = 32

const JIT_OFF: u64 = 0
const JIT_ON: u64 = 1
const JIT_STUCK: u64 = 2

const S_UNITS_CPU: u64 = 0
const S_UNITS_JITTER: u64 = 1
const S_UNITS_SEED: u64 = 2
const S_UNITS_IRQ: u64 = 3
const S_JIT_SAMPLES: u64 = 4
const S_JIT_FAILS: u64 = 5
const S_IRQ_SAMPLES: u64 = 6
const S_IRQ_FAILS: u64 = 7
const S_GENERATION: u64 = 8
const S_RESEEDS: u64 = 9
const S_CPU_CAPS: u64 = 10
const S_TRUST_CPU: u64 = 11
const S_JIT_MODE: u64 = 12
const S_READY_TSC: u64 = 13
const S_MIXED_BYTES: u64 = 14
const S_BYTES_OUT: u64 = 15
const S_PENDING_BITS: u64 = 16

static mut POOL: pool.Pool = pool.Pool { chain: [0; 32], mixed: 0, extracts: 0 }
static mut DRBG: drbg.Drbg = drbg.Drbg { key: [0; 32], generation: 0, since_reseed: 0 }
static mut HEALTH_JIT: health.Health = health.Health { rct_value: 0, rct_run: 0, apt_value: 0, apt_seen: 0, apt_hits: 0, samples: 0, failures: 0 }
static mut HEALTH_IRQ: health.Health = health.Health { rct_value: 0, rct_run: 0, apt_value: 0, apt_seen: 0, apt_hits: 0, samples: 0, failures: 0 }
static mut JIT_MEM: [u64; 64] = [0; 64]
static mut LOCK: u64 = 0
static mut units_cpu: u64 = 0
static mut units_jitter: u64 = 0
static mut units_seed: u64 = 0
static mut units_irq: u64 = 0
static mut irq_events: u64 = 0
static mut irq_last: u64 = 0
static mut reseeds: u64 = 0
static mut cpu_caps: u64 = 0
static mut trust_cpu: u64 = 1
static mut jit_mode: u64 = 1
static mut ready_tsc: u64 = 0

fn base(state: u64) -> u64 {
    return state + kstate.RANDOM_OFF
}

fn wget(p: u64) -> u64 {
    return __mmio_read64(p as *mut u64)
}

fn wset(p: u64, v: u64) {
    __mmio_write64(p as *mut u64, v)
}

fn lock_take() {
    while atomic.cas((&LOCK) as u64, 0, 1) != 0 {
        atomic.pause()
    }
}

fn lock_give() {
    atomic.store((&LOCK) as u64, 0)
}

fn units_total() -> u64 {
    var irq: u64 = atomic.load((&units_irq) as u64)
    let cap: u64 = IRQ_CAP_BITS * UNITS_PER_BIT
    if irq > cap {
        irq = cap
    }
    return atomic.load((&units_cpu) as u64) + atomic.load((&units_jitter) as u64)
        + atomic.load((&units_seed) as u64) + irq
}

fn ready(state: u64) -> u64 {
    return kstate.get(state, kstate.RANDOM_READY)
}

fn hardware(state: u64) -> u64 {
    return kstate.get(state, kstate.RANDOM_HW)
}

fn has_rdseed() -> bool {
    var b: u64 = 0
    asm("push rbx\nmov eax, 7\nxor ecx, ecx\ncpuid\nmov rax, rbx\npop rbx",
        out("rax") & b, clobber("rcx"), clobber("rdx"))
    return (b & CPUID_LEAF7_RDSEED) != 0
}

fn has_rdrand() -> bool {
    var c: u64 = 0
    asm("push rbx\nmov eax, 1\ncpuid\nmov rax, rcx\npop rbx",
        out("rax") & c, clobber("rcx"), clobber("rdx"))
    return (c & CPUID_LEAF1_RDRAND) != 0
}

fn rdrand64(out: u64) -> bool {
    var v: u64 = 0
    var ok: u64 = 0
    asm("xor edx, edx\nrdrand rax\nsetc dl", out("rax") & v, out("rdx") & ok)
    if ok == 0 {
        return false
    }
    wset(out, v)
    return true
}

fn rdseed64(out: u64) -> bool {
    var v: u64 = 0
    var ok: u64 = 0
    asm("xor edx, edx\nrdseed rax\nsetc dl", out("rax") & v, out("rdx") & ok)
    if ok == 0 {
        return false
    }
    wset(out, v)
    return true
}

fn hw_words(use_seed: bool, dst: u64, words: u64) -> u64 {
    var got: u64 = 0
    var tries: u64 = 0
    while got < words && tries < words * HW_RETRIES {
        var ok: bool = false
        if use_seed {
            ok = rdseed64(dst + got * WORD)
        } else {
            ok = rdrand64(dst + got * WORD)
        }
        if ok {
            got = got + 1
        }
        tries = tries + 1
    }
    return got
}

fn fold_ring(state: u64) {
    var extra: [u64; 4] = [0; 4]
    extra[0] = time.tsc()
    extra[1] = kstate.get(state, kstate.TIME_BOOT)
    extra[2] = kstate.get(state, kstate.RANDOM_STIRS)
    extra[3] = kstate.get(state, kstate.TICKS)
    pool.pool_mix(&POOL, base(state) + K_RING, (RING_WORDS * WORD) as usize)
    pool.pool_mix(&POOL, (&extra[0]) as u64, (4 * WORD) as usize)
}

fn mix_cpu_words(state: u64) {
    var w: [u64; 2] = [0; 2]
    if cpu_caps != 0 && hw_words(false, (&w[0]) as u64, 2) == 2 {
        pool.pool_mix(&POOL, (&w[0]) as u64, (2 * WORD) as usize)
    }
    w[0] = 0
    w[1] = 0
}

fn reseed_from_pool(state: u64) {
    var seed32: [u8; 32] = [0; 32]
    fold_ring(state)
    mix_cpu_words(state)
    pool.pool_extract(&POOL, (&seed32[0]) as u64)
    drbg.drbg_reseed(&DRBG, (&seed32[0]) as u64)
    var i: usize = 0
    while i < 32 {
        seed32[i] = 0
        i = i + 1
    }
    reseeds = reseeds + 1
}

fn try_ready(state: u64) -> bool {
    if kstate.get(state, kstate.RANDOM_READY) != 0 {
        return true
    }
    if units_total() < READY_UNITS {
        return false
    }
    lock_take()
    if kstate.get(state, kstate.RANDOM_READY) == 0 {
        reseed_from_pool(state)
        drbg.drbg_generate(&DRBG, base(state) + K_REPORT, REPORT_BYTES as usize)
        ready_tsc = time.tsc()
        kstate.set(state, kstate.RANDOM_READY, 1)
    }
    lock_give()
    return true
}

fn seed_cpu(state: u64) {
    var w: [u64; 4] = [0; 4]
    var caps: u64 = 0
    var units: u64 = 0
    if has_rdseed() {
        caps = caps | 2
    }
    if has_rdrand() {
        caps = caps | 1
    }
    cpu_caps = caps
    kstate.set(state, kstate.RANDOM_HW, 0)
    if caps != 0 {
        kstate.set(state, kstate.RANDOM_HW, 1)
    }
    lock_take()
    if (caps & 2) != 0 && hw_words(true, (&w[0]) as u64, RDSEED_WORDS) == RDSEED_WORDS {
        pool.pool_mix(&POOL, (&w[0]) as u64, (RDSEED_WORDS * WORD) as usize)
        units = CPU_SEED_BITS * UNITS_PER_BIT
    } else if (caps & 1) != 0 && hw_words(false, (&w[0]) as u64, RDRAND_WORDS) == RDRAND_WORDS {
        pool.pool_mix(&POOL, (&w[0]) as u64, (RDRAND_WORDS * WORD) as usize)
        units = CPU_RDRAND_BITS * UNITS_PER_BIT
    }
    lock_give()
    var i: usize = 0
    while i < 4 {
        w[i] = 0
        i = i + 1
    }
    if trust_cpu != 0 {
        atomic.store((&units_cpu) as u64, units)
    }
}

fn jitter_batch(samples: u64) {
    var good: u64 = 0
    var tainted: bool = false
    var acc: u64 = time.tsc()
    var block: [u64; 32] = [0; 32]
    var fill: u64 = 0
    var i: u64 = 0
    lock_take()
    while i < samples {
        let t0: u64 = time.tsc()
        var k: u64 = 0
        while k < JITTER_WORK {
            acc = (acc ^ JIT_MEM[((acc >> 7) & JITTER_MEM_MASK) as usize]) *% GOLD
            JIT_MEM[((acc >> 13) & JITTER_MEM_MASK) as usize] = acc
            k = k + 1
        }
        var delta: u64 = time.tsc() -% t0
        if jit_mode == JIT_STUCK {
            delta = JITTER_STUCK_VALUE
        }
        block[fill as usize] = delta
        fill = fill + 1
        if health.health_feed(&HEALTH_JIT, delta & JITTER_SAMPLE_MASK) {
            good = good + 1
        } else {
            tainted = true
        }
        if fill == JITTER_FLUSH_WORDS {
            pool.pool_mix(&POOL, (&block[0]) as u64, (MIX_BLOCK_BYTES) as usize)
            fill = 0
        }
        i = i + 1
    }
    if fill > 0 {
        pool.pool_mix(&POOL, (&block[0]) as u64, (fill * WORD) as usize)
    }
    lock_give()
    if !tainted {
        atomic.fetch_add((&units_jitter) as u64, good / JITTER_SAMPLES_PER_UNIT)
    }
}

fn configure(state: u64, trust: u64, jitter: u64) {
    trust_cpu = trust
    jit_mode = jitter
}

fn init(state: u64) {
    let b: u64 = base(state)
    var i: u64 = 0
    while i < RING_WORDS {
        wset(b + K_RING + i * WORD, 0)
        i = i + 1
    }
    i = 0
    while i < REPORT_BYTES {
        kstate.set8(b + K_REPORT + i, 0 as u8)
        i = i + 1
    }
    kstate.set(state, kstate.RANDOM_READY, 0)
    kstate.set(state, kstate.RANDOM_STIRS, 0)
    kstate.set(state, kstate.RANDOM_BYTES, 0)
    atomic.store((&units_cpu) as u64, 0)
    atomic.store((&units_jitter) as u64, 0)
    atomic.store((&units_seed) as u64, 0)
    atomic.store((&units_irq) as u64, 0)
    seed_cpu(state)
    if jit_mode != JIT_OFF {
        var batch: u64 = 0
        while batch < JITTER_INIT_BATCHES && units_total() < READY_UNITS {
            jitter_batch(JITTER_BATCH)
            batch = batch + 1
        }
    }
    let _r: bool = try_ready(state)
}

fn poll(state: u64) {
    if kstate.get(state, kstate.RANDOM_READY) != 0 {
        return
    }
    if jit_mode != JIT_OFF {
        jitter_batch(JITTER_BATCH)
    }
    let _r: bool = try_ready(state)
}

fn settle(state: u64) -> bool {
    var batch: u64 = 0
    while batch < SETTLE_BATCHES && kstate.get(state, kstate.RANDOM_READY) == 0 && jit_mode != JIT_OFF {
        poll(state)
        batch = batch + 1
    }
    return kstate.get(state, kstate.RANDOM_READY) != 0
}

fn seed(state: u64) {
    poll(state)
}

fn stir(state: u64, v: u64) {
    let n: u64 = kstate.add(state, kstate.RANDOM_STIRS, 1)
    let p: u64 = base(state) + K_RING + (n % RING_WORDS) * WORD
    var w: u64 = wget(p)
    w = (w ^ v) *% GOLD
    w = w ^ (w >> 29)
    w = w +% (v << 13)
    wset(p, w)
    let sample: u64 = (v -% irq_last) & IRQ_SAMPLE_MASK
    irq_last = v
    if health.health_feed(&HEALTH_IRQ, sample) {
        irq_events = irq_events + 1
        if irq_events % IRQ_EVENTS_PER_UNIT == 0 {
            atomic.fetch_add((&units_irq) as u64, 1)
        }
    }
}

fn mix(state: u64, src: u64, n: u64) {
    lock_take()
    pool.pool_mix(&POOL, src, (n as usize) as usize)
    lock_give()
    kstate.add(state, kstate.RANDOM_STIRS, 1)
}

fn credit_seed(state: u64, src: u64, n: u64, bits: u64) {
    mix(state, src, n)
    atomic.fetch_add((&units_seed) as u64, bits * UNITS_PER_BIT)
    let _r: bool = try_ready(state)
}

fn export_seed(state: u64, dst: u64) -> bool {
    lock_take()
    let strong: bool = kstate.get(state, kstate.RANDOM_READY) != 0 || atomic.load((&units_seed) as u64) != 0
    if kstate.get(state, kstate.RANDOM_READY) != 0 {
        drbg.drbg_generate(&DRBG, dst, SEED_BYTES as usize)
    } else {
        pool.pool_extract(&POOL, dst)
        pool.pool_extract(&POOL, dst + KEY_BYTES)
    }
    lock_give()
    return strong
}

fn fixed_set(state: u64, v: u64) {
    kstate.set(state, kstate.RANDOM_FIXED, v)
}

fn seed_hex(state: u64, i: u64) -> u64 {
    if i >= REPORT_BYTES {
        return 0
    }
    return kstate.get8(base(state) + K_REPORT + i)
}

fn bytes(state: u64, dst: u64, n: u64) -> u64 {
    if kstate.get(state, kstate.RANDOM_FIXED) != 0 {
        var f: u64 = 0
        while f < n {
            kstate.set8(dst + f, 0x5A as u8)
            f = f + 1
        }
        kstate.add(state, kstate.RANDOM_BYTES, n)
        return n
    }
    if kstate.get(state, kstate.RANDOM_READY) == 0 {
        poll(state)
        if kstate.get(state, kstate.RANDOM_READY) == 0 {
            return 0
        }
    }
    lock_take()
    if DRBG.since_reseed >= RESEED {
        reseed_from_pool(state)
    }
    drbg.drbg_generate(&DRBG, dst, n as usize)
    lock_give()
    kstate.add(state, kstate.RANDOM_BYTES, n)
    return n
}

fn stat(state: u64, which: u64) -> u64 {
    if which == S_UNITS_CPU {
        return atomic.load((&units_cpu) as u64)
    }
    if which == S_UNITS_JITTER {
        return atomic.load((&units_jitter) as u64)
    }
    if which == S_UNITS_SEED {
        return atomic.load((&units_seed) as u64)
    }
    if which == S_UNITS_IRQ {
        return atomic.load((&units_irq) as u64)
    }
    if which == S_JIT_SAMPLES {
        return HEALTH_JIT.samples
    }
    if which == S_JIT_FAILS {
        return HEALTH_JIT.failures
    }
    if which == S_IRQ_SAMPLES {
        return HEALTH_IRQ.samples
    }
    if which == S_IRQ_FAILS {
        return HEALTH_IRQ.failures
    }
    if which == S_GENERATION {
        return DRBG.generation
    }
    if which == S_RESEEDS {
        return reseeds
    }
    if which == S_CPU_CAPS {
        return cpu_caps
    }
    if which == S_TRUST_CPU {
        return trust_cpu
    }
    if which == S_JIT_MODE {
        return jit_mode
    }
    if which == S_READY_TSC {
        return ready_tsc
    }
    if which == S_MIXED_BYTES {
        return POOL.mixed
    }
    if which == S_BYTES_OUT {
        return kstate.get(state, kstate.RANDOM_BYTES)
    }
    if which == S_PENDING_BITS {
        let total: u64 = units_total()
        if total >= READY_UNITS {
            return 0
        }
        return (READY_UNITS - total) / UNITS_PER_BIT
    }
    return 0
}
