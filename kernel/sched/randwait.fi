profile kernel

import sched.sched
import sched.rand

export { wait_ready }

fn wait_ready(state: u64, nonblock: bool) -> bool {
    if rand.ready(state) != 0 {
        return true
    }
    rand.poll(state)
    while rand.ready(state) == 0 {
        if nonblock {
            return false
        }
        sched.yield_now(state)
        rand.poll(state)
    }
    return true
}
