export { put, take, pid_uid_of, status_of, code_of, CLD_EXITED, CLD_KILLED, CLD_STOPPED, SI_STATUS_OFF }

const SLOTS: u64 = 512
const CLD_EXITED: u64 = 1
const CLD_KILLED: u64 = 2
const CLD_STOPPED: u64 = 5
const SI_STATUS_OFF: u64 = 24
const UID_SHIFT: u64 = 32
const PID_MASK: u64 = 0xFFFFFFFF

static mut armed: [u64; 512] = [0 as u64; 512]
static mut child_pid_uid: [u64; 512] = [0 as u64; 512]
static mut child_status: [u64; 512] = [0 as u64; 512]
static mut child_code: [u64; 512] = [0 as u64; 512]

fn put(parent: u64, pid: u64, uid: u64, code: u64, status: u64) {
    if parent >= SLOTS {
        return
    }
    child_pid_uid[parent as usize] = (pid & PID_MASK) | (uid << UID_SHIFT)
    child_status[parent as usize] = status
    child_code[parent as usize] = code
    armed[parent as usize] = 1
}

fn take(parent: u64) -> bool {
    if parent >= SLOTS || armed[parent as usize] == 0 {
        return false
    }
    armed[parent as usize] = 0
    return true
}

fn pid_uid_of(parent: u64) -> u64 {
    return child_pid_uid[parent as usize]
}

fn status_of(parent: u64) -> u64 {
    return child_status[parent as usize]
}

fn code_of(parent: u64) -> u64 {
    return child_code[parent as usize]
}
