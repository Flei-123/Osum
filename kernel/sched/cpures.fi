profile kernel

import serial
import lib.kstate
import arch.cpu
import acpi.acpi

export { setup, reserved, reserved_cpu, active }

const NONE: u64 = 0xFFFF
const MIN_CPUS_AUTO: u64 = 3
const MIN_CPUS_FORCED: u64 = 2
const MAX_CPUS: u64 = kstate.MAX_CPUS
const OEM_LEN: u64 = 6

static mut reserved_id: u64 = 0xFFFF

fn oem_matches(p: u64) -> bool {
    var want: [u8; 6] = "VBOX  "
    if p == 0 {
        return false
    }
    var i: u64 = 0
    while i < OEM_LEN {
        if kstate.get8(p + i) != want[i as usize] as u64 {
            return false
        }
        i = i + 1
    }
    return true
}

fn oem_is_vbox(state: u64) -> bool {
    return oem_matches(acpi.oem(state)) || oem_matches(acpi.madt_oem(state))
}

fn show_oem(label: u64, p: u64) {
    var buf: [u8; 7] = "      \0"
    if p == 0 {
        return
    }
    var i: u64 = 0
    while i < OEM_LEN {
        buf[i as usize] = kstate.get8(p + i) as u8
        i = i + 1
    }
    serial.puts(label)
    serial.puts((&buf[0]) as u64)
}

fn wanted(state: u64, n: u64) -> bool {
    if kstate.mode_on(state, kstate.M_NOVBRES) {
        return false
    }
    if kstate.mode_on(state, kstate.M_VBRES) {
        return n >= MIN_CPUS_FORCED
    }
    return n >= MIN_CPUS_AUTO && oem_is_vbox(state)
}

fn setup(state: u64, n: u64) {
    var s_on: [u8; 20] = "smp: reserved vcpu=\0"
    var s_rs: [u8; 16] = "smp: oem rsdp=\0\0"
    var s_md: [u8; 7] = " madt=\0"
    reserved_id = NONE
    show_oem((&s_rs[0]) as u64, acpi.oem(state))
    show_oem((&s_md[0]) as u64, acpi.madt_oem(state))
    serial.nl()
    if n > MAX_CPUS || !wanted(state, n) {
        return
    }
    reserved_id = n - 1
    serial.puts((&s_on[0]) as u64)
    serial.dec(reserved_id)
    serial.nl()
}

fn reserved(me: u64) -> bool {
    return me == reserved_id
}

fn reserved_cpu() -> u64 {
    return reserved_id
}

fn active() -> bool {
    return reserved_id != NONE
}
