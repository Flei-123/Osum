profile kernel

import serial
import lib.kstate
import arch.cpu
import acpi.acpi

export { setup, reserved, reserved_cpu, active }

const NONE: u64 = 0xFFFF
const MIN_CPUS_AUTO: u64 = 3
const MIN_CPUS_FORCED: u64 = 2
const MAX_CPUS: u64 = 8
const OEM_LEN: u64 = 6

static mut reserved_id: u64 = 0xFFFF

fn oem_is_vbox(state: u64) -> bool {
    var want: [u8; 6] = "VBOX  "
    let p: u64 = acpi.oem(state)
    if p == 0 {
        return false
    }
    var i: u64 = 0
    while i < OEM_LEN {
        if kstate.get8(p + i) != want[i as usize] as u64 {
            return false
        }
        i = i + 1
    }
    return true
}

fn wanted(state: u64, n: u64) -> bool {
    if kstate.mode_on(state, kstate.M_NOVBRES) {
        return false
    }
    if kstate.mode_on(state, kstate.M_VBRES) {
        return n >= MIN_CPUS_FORCED
    }
    return n >= MIN_CPUS_AUTO && oem_is_vbox(state)
}

fn setup(state: u64, n: u64) {
    var s_on: [u8; 20] = "smp: reserved vcpu=\0"
    reserved_id = NONE
    if n > MAX_CPUS || !wanted(state, n) {
        return
    }
    reserved_id = n - 1
    serial.puts((&s_on[0]) as u64)
    serial.dec(reserved_id)
    serial.nl()
}

fn reserved(me: u64) -> bool {
    return me == reserved_id
}

fn reserved_cpu() -> u64 {
    return reserved_id
}

fn active() -> bool {
    return reserved_id != NONE
}
