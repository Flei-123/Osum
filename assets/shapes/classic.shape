# classic.shape -- Osum form tokens, installed as /etc/shapes/classic
#
# ROUND LOOK, layer four of the token system: FORM, not colour.
#
# THIS FILE IS NOT A DESIGN.  It is the behaviour of every round before
# round LOOK, written down -- every number was read out of the painting
# routine it used to sit in (border=1 from `wlibc.frame`, ctrl_h=26 and
# pad_x=12 from `wlib.button`, row=20 from `wlib.zeilen_hoehe`, gap=8
# from `want_gap`; there was no radius and no shadow, and every
# separating line was solid).
#
# It exists to PROVE THAT NOTHING BROKE: a machine on `shape=classic`
# must draw the same picture as the same machine before this round, and
# tools/look/run.sh measures exactly that.  A round that adds a second
# appearance without showing the first one untouched has not added an
# appearance, it has replaced one.
#
# Sizes are pixels; `shadow` and `divider` are per hundred.
# The reasoning behind every number is in docs/ROUNDLOOK.md, section C.
#
# ROUND SOFTUI added nine tokens and every one of them is set here to
# the behaviour that was already in the code, so this file still says
# exactly what it said before: THIS IS NOT A DESIGN, THIS IS THE PAST.
#
#   spacing_xs=2   the inner edge of `wlibc.frame`
#   spacing_s=6    the gap between two controls in the settings page --
#                  the `6` that stood in six `wlib.box_v` calls
#   spacing_m=10   the padding of a page box -- the `10` next to it
#   spacing_l=12   pad_x
#   grad=0         one flat fill, which is what `fb.fill` did
#   tone=100       the focused title bar is the accent -- round THEME
#   shadow_off=0   there was no shadow at all, focused or not
#   caption=0      one red close box with a white cross -- round K10
#
# tools/look/run.sh section D and tools/softui/run.sh section A measure
# that a machine on `shape=classic` draws the same picture it drew
# before this round, pixel for pixel.
#
# ROUND GLAS: `radius_window`, `radius_panel`, `radius_button` and
# `radius_input` below are from now on the STARTING VALUE of the corner
# radius and no longer the last word.  A line `radius=<0..24>` in
# /etc/theme.conf -- which is what the slider on the "Darstellung" page
# writes -- overrides all four of them at once, in `wlibc.glas_metrics`,
# AFTER this file has been read.  Nothing in this file changes because
# of that: a machine whose /etc/theme.conf has no `radius=` line draws
# exactly the four numbers written here.
#
name=Classic
radius_window=0
radius_panel=0
radius_button=0
radius_input=0
border=1
pad_x=12
pad_y=4
gap=8
row=20
ctrl_h=26
shadow=0
shadow_r=0
divider=100
focus=1
spacing_xs=2
spacing_s=6
spacing_m=10
spacing_l=12
grad=0
tone=100
shadow_off=0
shadow_off_r=0
caption=0
