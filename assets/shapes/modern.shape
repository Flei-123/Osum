# modern.shape -- Osum form tokens, installed as /etc/shapes/modern
#
# ROUND LOOK.  The Windows-11-shaped set: visible corner radii, room
# inside the controls, soft shadows, quiet separating lines.
#
# NOTHING HERE WAS INVENTED.  Every number names a step off a scale that
# /root/jarvis/plugins/ui-ux-pro-max/.claude/skills/design-system ships:
#
#   radius_window=8  radius_panel=8   radius-lg   (primitive-tokens.md)
#   radius_button=6  radius_input=6   radius-md, which is what
#                                     --button-radius and --input-radius
#                                     resolve to (component-tokens.md)
#   pad_x=16                          the `default` button row
#                                     (component-specs.md)
#   pad_y=7                           (32 - 18) / 2, what is left round a
#                                     15-pixel line in a 32-pixel control
#   gap=12                            --space-3, the 4-pixel unit
#   row=24                            a 15-pixel line plus --space-1
#                                     above and below, on the 4-grid
#   ctrl_h=32                         the `sm` button row -- NOT the
#                                     `default` row (40), see below
#   shadow=22 shadow_r=6              --shadow-md is 0 4px 6px -1px at
#                                     10 % twice over
#   divider=45                        the one number with no source in
#                                     the skill; measured instead --
#                                     1.7:1 against the surface in
#                                     day/light, 1.6:1 in night/dark
#   border=1                          UNCHANGED, deliberately: a modern
#                                     interface has quieter borders, not
#                                     thicker ones
#   focus=2                           the one thing that gets LOUDER,
#                                     because it is the only thing here
#                                     a keyboard user depends on
#
# WHY 32 AND NOT 40.  The skill's `default` button is 40 pixels high with
# 16 of horizontal padding.  The settings program's Darstellung page has
# fourteen controls; at 40 each it is 720 pixels tall on a 600-pixel
# screen.  The `sm` row fits and is still a 23 % bigger click target
# than classic's 26.  Measured, not guessed -- docs/ROUNDLOOK.md, D.
name=Modern
radius_window=8
radius_panel=8
radius_button=6
radius_input=6
border=1
pad_x=16
pad_y=7
gap=12
row=24
ctrl_h=32
shadow=22
shadow_r=6
divider=45
focus=2
