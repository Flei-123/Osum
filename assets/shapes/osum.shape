# osum.shape -- die Hausform von OrientOS, installiert als /etc/shapes/osum
#
# RUNDE OBERFLAECHE.  Runde LOOK hat zwei Formsaetze mitgebracht:
# `classic` (ausdruecklich "das ist keine Gestaltung, das ist die
# Vergangenheit") und `modern` (ein erster Versuch, nach der Tabelle aus
# design-system/references/component-specs.md).  Was fehlte, war ein
# Satz, der sich an EINE Regel haelt und den man deshalb pruefen kann.
#
# DIE REGEL: JEDE LAENGE HIER IST EIN VIELFACHES VON VIER.
#
# Das ist keine Zierde.  Es ist die einzige Eigenschaft eines
# Abstandssystems, die man von aussen NACHZAEHLEN kann -- und
# `tools/design/messen.py` zaehlt sie: aus den Rechtecken, die die
# Programme selbst melden.  Vor dieser Runde lagen 20 Prozent aller
# gemeldeten Laengen auf dem Viererraster, also genau so viele, wie der
# Zufall liefert.  Eine Zahl, die man mit Wuerfeln erreicht, beschreibt
# kein System.
#
# WO DIE ZAHLEN HERKOMMEN.  Aus
# /root/jarvis/plugins/ui-ux-pro-max/.claude/skills/design-system:
# primitive-tokens.md (Raster 4, Radien 2/4/6/8/12/16, Dauern
# 150/200/300 ms) und component-specs.md (Knopf und Feld: sm = 32 px
# hoch, 12 px Innenabstand; default = 40/16).  Gewaehlt ist die Zeile
# DAZWISCHEN -- 32 hoch, 16 innen --, und zwar aus dem Grund, den Runde
# LOOK schon aufgeschrieben hat: die Seiten dieses Systems sind fuer
# Fenster von 400 bis 800 Bildpunkten gesetzt, und bei 40 Bildpunkten je
# Bedienelement ist die Seite "Darstellung" hoeher als der Bildschirm.
# Ein Entwurfssystem ist ein Satz Zahlen zum Nachdenken und keiner zum
# Gehorchen.
#
# ==================================================================
# 1. DIE ECKEN, NACH ROLLE UND NICHT NACH GESCHMACK
#
# Fenster > Tafel > Knopf > Feld.  Das ist die Reihenfolge, die Fluent,
# HIG, Material 3 und Adwaita alle vier einhalten, und sie hat einen
# Grund: der Radius sagt, wie GROSS eine Flaeche ist.  Ein Eingabefeld
# mit dem Radius eines Fensters sieht aus wie eine Tablette.
#
# 12 und nicht 16: der Eckenrasterer kostet 4*r*r Deckungsproben
# (kernel/user/wlibc.fi, `corner_cov`), und die Taskleiste malt sich
# selbst in einem Streifen von 800x81.  12 sind 576 Proben je Rechteck,
# 16 waeren 1024.
# Der Name, den das Einstellungsfenster anzeigt.  Er fehlte in der
# ersten Fassung dieser Datei, und die Leiste meldete `shape file=osum
# name=` -- eine Form ohne Namen.  Gefunden hat es der Lauf auf
# 3440x1440, nicht das Auge.
name=OrientOS
radius_window=12
radius_panel=10
radius_button=8
radius_input=6

# EIN Bildpunkt Rahmen, und die Hoehe kommt aus Flaeche und Schatten.
# Das ist der eigentliche Unterschied zu `classic`: dort trennt eine
# Linie zwei Dinge, hier tut es der Abstand.
border=1

# ==================================================================
# 2. DIE ABSTAENDE, ALLE AUF DEM VIERERRASTER
#
# spacing_xs   innerhalb eines Bedienelements
# spacing_s    zwischen zwei Elementen einer Gruppe
# spacing_m    zwischen zwei Gruppen -- der Innenabstand einer Karte
# spacing_l    zwischen zwei Karten, der Rand einer Seite
pad_x=16
pad_y=8
gap=12
spacing_xs=4
spacing_s=8
spacing_m=16
spacing_l=24

# ==================================================================
# 3. DIE HOEHEN
#
# ctrl_h=32 ist die Zusage "was man anfasst, ist mindestens 32 hoch"
# (wlibc.HIT_MIN).  Daraus leitet wlib das Kaestchen (28) und die
# Menueleiste (30) ab -- eine Zahl in der Datei, feste Verhaeltnisse im
# Code.
#
# row=28: eine Listenzeile.  15 Bildpunkte Schrift in 28 Bildpunkten
# Zeile sind 6 oben und 7 unten -- Luft, die `classic` mit row=20 nicht
# hatte (dort war es 0 und 1, weshalb die Listen dieses Systems immer
# gedraengt aussahen).  28 statt 32, weil eine Liste dichter sein darf
# als ein Knopf: man liest sie, man trifft sie nicht einzeln.
row=28
ctrl_h=32

# ==================================================================
# 4. DIE HOEHE UEBER DER FLAECHE
#
# EINE Staerke und EINE Reichweite; die fuenf Stufen (Flaeche, Karte,
# Ueberlagerung, Dialog, Fenster) rechnet `wlibc.elev_strength` daraus.
# 32 von 100 ist der Wert, bei dem der Schatten unter einem Fenster auf
# dem hellen Schreibtisch dieses Systems gerade sichtbar wird, ohne dass
# die Kante schmutzig aussieht -- gemessen, nicht geschaetzt: der
# Helligkeitsabfall in der ersten Zeile unter dem Fenster betraegt damit
# etwa 30 von 255.
shadow=32
shadow_r=8
shadow_off=12
shadow_off_r=4

# Eine Trennlinie ist ein FUENFTEL sichtbar und keine schwarze Kante.
# Wo `classic` 100 sagt (also volle Deckkraft), sagt jedes der vier
# Systeme, gegen die diese Runde misst, zwischen 8 und 25 Prozent.
divider=20

# Der Fokusring ist ZWEI Bildpunkte.  Einer verschwindet auf jedem
# Bildschirm mit Skalierung; zwei ist die Zahl aus
# states-and-variants.md ("Ring width 2px").
focus=2

# ==================================================================
# 5. DER TON
#
# tone=0: die Titelleiste des vorderen Fensters ist eine FLAECHE und
# nicht der Akzent.  Justins Satz dazu: "der heutige Stil schreit mit
# sattem Blau in jeder Titelleiste".  Der Akzent bleibt fuer das EINE
# Element, in dem man gerade arbeitet.
tone=0
# Ein sehr flacher Verlauf, damit die Leiste eine Flaeche ist und keine
# Folie.  5 von 255 Helligkeitsstufen ueber die ganze Hoehe.
grad=5
# Die drei Fensterknoepfe und nicht das eine rote Kaestchen.
caption=1

# ==================================================================
# 6. SCHRIFT UND ZEIT -- die zwei Marken dieser Runde
#
# font: die GRUNDgroesse.  Die fuenf Stufen (Hilfstext, Text, betont,
# Titel, Ueberschrift) sind Abstaende darauf -- 12/15/15/18/24 --, und
# die Zeilenhoehen daraus auf das Viererraster aufgerundet: 16/20/20/
# 24/32.  Eine Zahl hier, fuenf Rollen im Code, nichts, was auseinander
# laufen kann.
font=15
# motion: die Grunddauer.  Schnell = 3/4, langsam = 5/4, also 120/160/
# 200 ms.  Unter 100 wirkt es wie ein Sprung, ueber 300 wie Zaehigkeit.
motion=160

# ==================================================================
# 7. DAS AUFHEBEN BEIM VERSCHIEBEN -- die drei Marken der Runde ZIEH
#
# Justins Wunsch: beim Ziehen wird das Fenster leicht groesser ("als
# wuerde man es aufheben"), der Pivot liegt an der angefassten Stelle
# statt in der Mitte, und es zieht mit Traegheit nach und pendelt beim
# Absetzen aus.  Jede der drei Wirkungen ist EINZELN schaltbar und in
# der Staerke regelbar -- und zwar, weil jede Zahl beides ist: 0 heisst
# aus, sonst ist sie die Staerke.  Eine Marke weniger als ein
# Schalter-plus-Regler-Paar, und ein Zustand weniger, der auseinander
# laufen kann.
#
# lift=50: 105 Prozent.  Das ist GENAU die Zahl, auf der die
# Kostenmessung steht -- ein Fenster von 900x650 unskaliert kopieren
# kostet 0,18 ms, auf 105 Prozent skaliert 1,04 ms von 16,7 ms Budget
# (6,2 Prozent).  Mehr ist bezahlbar, aber 105 Prozent sind die Grenze,
# an der man das Aufheben SIEHT, ohne dass das Fenster springt.
lift=50
#
# tilt=100: der angefasste Punkt bleibt unter dem Zeiger, das Fenster
# waechst von ihm weg.  Das ist die ganze Wahrnehmung "ich halte es an
# dieser Ecke".  Bei 0 waechst es mittig, und dann rutscht einem die
# angefasste Stelle unter dem Finger weg.
tilt=100
#
# swing=35: der Nachzug.  Er wirkt auf den VERSATZ des Bildes gegen die
# wahre Fensterlage und nicht auf die Lage selbst -- das Fenster steht,
# wo der Zeiger es hinzieht, und nur sein Bild haengt hinterher.  35
# ist die Staerke, bei der man die Traegheit sieht und das Fenster
# trotzdem zielgenau ablegen kann.
swing=35
