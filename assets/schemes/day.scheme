# day.scheme -- Osum colour scheme, installed as /etc/schemas/day
#
# LAYER 1 OF THE TOKEN SYSTEM AND NOTHING ELSE.  A scheme file holds
# raw ramps.  It does not say what a button looks like; no component
# ever names a key from this file.  What a button looks like is decided
# by the semantic layer, and the semantic layer is bound twice -- once
# for light, once for dark -- out of the SAME ramp below.  That is why
# a scheme does not come in two files.
#
# `mode` is the mode this scheme was drawn for, not a restriction.
# Switching to dark keeps the scheme and rebinds the semantics.
#
# Source: ui-ux-pro-max palette 30, "Knowledge Base/Documentation"
# (#475569 / #2563EB, "neutral grey + link blue").  Chosen because it
# is the only entry in that file whose subject is reading text in
# windows all day, which is what a desktop is.  The neutral ramp is
# Tailwind Slate, the ramp that palette -- and about a hundred others
# in the same file -- is built on.
name=Slate Day
mode=light
contrast=normal

neutral0=ffffff
neutral50=f8fafc
neutral100=f1f5f9
neutral200=e2e8f0
neutral300=cbd5e1
neutral400=94a3b8
neutral500=64748b
neutral600=475569
neutral700=334155
neutral800=1e293b
neutral900=0f172a
neutral950=020617
neutral1000=000000

accent=2563eb
danger=dc2626
warning=b45309
success=15803d
