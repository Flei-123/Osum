# paper.scheme -- Osum colour scheme, installed as /etc/schemas/paper
#
# The second light scheme, and it is warm where `day` is cool.  Source:
# ui-ux-pro-max palette 4, "E-commerce Luxury" (#1C1917 / #A16207,
# "premium dark + gold accent"), whose neutral ramp is Tailwind Stone.
# The accent from that palette is #A16207; the palette file notes that
# it was already moved once from #CA8A04 to clear 3:1, and this scheme
# keeps the moved value rather than the pretty one.
name=Warm Paper
mode=light
contrast=normal

neutral0=ffffff
neutral50=fafaf9
neutral100=f5f5f4
neutral200=e7e5e4
neutral300=d6d3d1
neutral400=a8a29e
neutral500=78716c
neutral600=57534e
neutral700=44403c
neutral800=292524
neutral900=1c1917
neutral950=0c0a09
neutral1000=000000

accent=a16207
danger=b91c1c
warning=a16207
success=15803d
