# contrast.scheme -- Osum colour scheme, installed as /etc/schemas/contrast
#
# THE ACCESSIBILITY SCHEME.  `contrast=high` is not decoration: it
# selects a THIRD binding of the semantic layer, next to light and
# dark.  In that binding the border IS the text colour, secondary text
# is primary text, and the raised and sunken surfaces collapse onto the
# surface -- depth is drawn with lines instead of with three greys that
# a washed-out display turns into one.
#
# Source: ui-ux-pro-max palette 13, "Government/Public Service"
# (#0F172A / #0369A1, "high contrast navy + blue").  The accent is
# darkened from that palette's #0369A1 to #01497c so that white on it
# clears 7:1 (WCAG AAA) and not merely 4.5:1; the stricter target is
# the entire point of this scheme.
#
# The neutral ramp is pure grey.  A tinted ramp is a nicer picture and
# a worse promise: the tint is the first thing a failing display eats.
name=High Contrast
mode=light
contrast=high

neutral0=ffffff
neutral50=ffffff
neutral100=f0f0f0
neutral200=d0d0d0
neutral300=b0b0b0
neutral400=8a8a8a
neutral500=595959
neutral600=3d3d3d
neutral700=262626
neutral800=141414
neutral900=000000
neutral950=000000
neutral1000=000000

accent=01497c
danger=a80000
warning=6b3b00
success=005c2e
