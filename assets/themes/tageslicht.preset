# tageslicht.preset -- an Osum appearance preset, installed as /etc/themes/tageslicht
#
# ROUND THEMESTORE.  A preset is not a fifth token layer.  It is a
# SHORTHAND: seven lines that name a value on each of the axes the
# system already has, so that one click sets all of them at once.
#
#   scheme   layer 1, the raw ramps      -- /etc/schemas/<scheme>
#   mode     which binding of layer 2    -- light | dark | auto
#   shape    the form tokens of LOOK     -- /etc/shapes/<shape>
#   accent   the accent, or empty for the scheme's own
#   edge     which side the taskbar sits on
#   align    where its buttons start
#
# THESE SEVEN KEYS ARE THE WHOLE VOCABULARY.  `vorlage.fi` refuses any
# other key and counts it, so a preset that arrives from somewhere else
# cannot smuggle anything in: there is nothing in this file a program
# could act on except how the screen looks.
#
# The default. Slate on white, link blue, round corners -- what the
# system boots into if nobody chooses anything.
#
# Measured with tools/theme/model.py before it was written:
#   text on background 17.06:1, worst text pairing 4.61:1,
#   pairings below their WCAG limit: 0
name=Tageslicht
scheme=day
mode=light
shape=modern
accent=
edge=bottom
align=left
