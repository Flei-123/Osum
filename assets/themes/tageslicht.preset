# tageslicht.preset -- an Osum appearance preset, installed as /etc/themes/tageslicht
#
# ROUND THEMESTORE.  A preset is not a fifth token layer.  It is a
# SHORTHAND: seven lines that name a value on each of the axes the
# system already has, so that one click sets all of them at once.
#
#   scheme   layer 1, the raw ramps      -- /etc/schemas/<scheme>
#   mode     which binding of layer 2    -- light | dark | auto
#   shape    the form tokens of LOOK     -- /etc/shapes/<shape>
#   accent   the accent, or empty for the scheme's own
#   edge     which side the taskbar sits on
#   align    where its buttons start
#
# THESE SEVEN KEYS ARE THE WHOLE VOCABULARY.  `vorlage.fi` refuses any
# other key and counts it, so a preset that arrives from somewhere else
# cannot smuggle anything in: there is nothing in this file a program
# could act on except how the screen looks.
#
# The default. Slate on white, link blue, round corners -- what the
# system boots into if nobody chooses anything.
#
# ROUND FARBE: `dark_scheme=midnight` -- THE DARK MODE OF THIS PRESET
# USES THE NEUTRAL RAMP, NOT THE BLUE ONE.
#
# A scheme carries ONE ramp; `mode=dark` reads the other end of it, it
# does not swap it.  So before this round `tageslicht` in dark mode was
# Slate read from below -- and Slate is a BLUE grey:
#
#     #0f172a  blue-minus-red +27      #1e293b  +29
#
# Measured against what other systems do in dark mode:
#
#     Windows 11   0        GNOME 46   0        KDE 6   +6
#
# and against the Zinc ramp this system already ships:
#
#     #18181b  +3           #27272a   +2
#
# `dark_scheme` names the scheme that applies when the mode is dark, so
# the light half stays Slate-on-white (which is what makes a light
# theme look crisp) and the dark half is neutral grey.
#
# Measured with tools/theme/model.py before it was written:
#   text on background 17.06:1, worst text pairing 4.61:1,
#   pairings below their WCAG limit: 0
# RUNDE GLAS -- die vier Zahlen dieser Vorlage, und warum:
#
# Die Vorgabe bleibt DECKEND. Das ist die Darstellung, in die eine
# Maschine bootet, wenn niemand etwas waehlt, und sie muss auf einem
# beliebigen Hintergrundbild lesbar sein, ohne dass jemand nachmisst.
# radius=12 ist der Wert, den `osum.shape` ohnehin fuer das Fenster
# setzt -- hier steht er ausgeschrieben, damit man an DIESER Datei
# sieht, welche Rundung man bekommt.
#
# Jede der vier ist eine ZAHL und sonst nichts. `radius` 0..24,
# `taskbar_alpha` und `window_alpha` 0..100 Prozent (100 = deckend
# wie vor dieser Runde), `taskbar_blur` 0..16 (0 = aus). Ein Wert,
# der keine Zahl ist, wird von `template.parse_key` als schlecht
# gezaehlt und nicht stillschweigend als 0 gelesen.
#
name=Tageslicht
scheme=day
dark_scheme=midnight
mode=light
shape=osum
accent=
edge=bottom
align=left
radius=12
taskbar_alpha=100
window_alpha=100
taskbar_blur=0
