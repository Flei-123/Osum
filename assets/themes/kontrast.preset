# kontrast.preset -- an Osum appearance preset, installed as /etc/themes/kontrast
#
# ROUND THEMESTORE.  A preset is not a fifth token layer.  It is a
# SHORTHAND: eleven lines that name a value on each of the axes the
# system already has, so that one click sets all of them at once.
#
#   scheme   layer 1, the raw ramps      -- /etc/schemas/<scheme>
#   mode     which binding of layer 2    -- light | dark | auto
#   shape    the form tokens of LOOK     -- /etc/shapes/<shape>
#   accent   the accent, or empty for the scheme's own
#   edge     which side the taskbar sits on
#   align    where its buttons start
#
# ROUND GLAS added four more axes, and they are all NUMBERS:
#
#   radius         corner rounding in pixels  -- 0..24, clamped
#   taskbar_alpha  taskbar opacity in percent -- 0..100, 100 = opaque
#   window_alpha   window opacity in percent  -- 0..100, 100 = opaque
#   taskbar_blur   frosted glass radius       -- 0..16, 0 = off
#
# THESE ELEVEN KEYS ARE THE WHOLE VOCABULARY.  `vorlage.fi` refuses any
# other key and counts it, so a preset that arrives from somewhere else
# cannot smuggle anything in: there is nothing in this file a program
# could act on except how the screen looks.  The four keys GLAS added
# are numbers out of a clamped range, never free-form text -- that is
# exactly why the promise survived their arrival.
#
# The accessibility set. `contrast=high` selects a THIRD binding of
# the semantic layer: the border IS the text colour and the raised and
# sunken surfaces collapse onto the surface. Square, because a corner
# radius eats the border it is drawn from.
#
# Measured with tools/theme/model.py before it was written:
#   text on background 21.00:1, worst text pairing 7.88:1,
#   pairings below their WCAG limit: 0
# RUNDE GLAS -- die vier Zahlen dieser Vorlage, und warum:
#
# DER BARRIEREFREIE SATZ MISCHT NICHT. Durchsicht ist ein Kontrast
# gegen ein unbekanntes Bild, und `contrast=high` gibt eine Zusage
# von 7:1 gegen eine BEKANNTE Flaeche. Beides zugleich geht nicht,
# und dann gilt die Zusage. radius=0 aus demselben Grund wie oben:
# eine Rundung frisst den Rahmen, aus dem sie gemalt wird.
#
# Jede der vier ist eine ZAHL und sonst nichts. `radius` 0..24,
# `taskbar_alpha` und `window_alpha` 0..100 Prozent (100 = deckend
# wie vor dieser Runde), `taskbar_blur` 0..16 (0 = aus). Ein Wert,
# der keine Zahl ist, wird von `template.parse_key` als schlecht
# gezaehlt und nicht stillschweigend als 0 gelesen.
#
name=Hoher Kontrast
scheme=contrast
mode=light
shape=classic
accent=
edge=bottom
align=left
radius=0
taskbar_alpha=100
window_alpha=100
taskbar_blur=0
