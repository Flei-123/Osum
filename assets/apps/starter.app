# /usr/share/apps/starter.app -- der Starter selbst.
#
# Er steht in seinem eigenen Verzeichnis, und das ist kein Versehen:
# was auffindbar sein soll, steht hier; ein Programm, das sich selbst
# ausnimmt, waere eine Ausnahme, die man erklaeren muesste.
name=Starten
info=Programme suchen und starten
exec=/bin/starter
icon=6a7a8a
keys=start,starter,programme,anwendungen,suche,suchen,menue
