# pkg/rezepte/wayland.rezept -- DER WAYLAND-SERVER ALS EIGENES PAKET.
#
# Vorgabe von Justin (14.09.2026) und Hausregel aus
# /root/osum-roadmap/FREMDSOFTWARE.md: "Kein Ballast im
# Standardabbild. Alles Optionale kommt aus dem Store."
#
# WAS IN DIESEM PAKET IST, und es ist ausschliesslich EIGENER CODE:
#
#   /bin/wayd   der Server selbst, uebersetzt aus kernel/user/wayd.fi
#               und kernel/user/wlproto.fi -- Firn, in diesem Repo
#               geschrieben. KEIN fremder Programmtext.
#
# WAS NICHT DARIN IST, und das ist der Punkt: libwayland-client. Die
# gehoert dem ANWENDUNGSPROGRAMM, nicht dem Server. Ein Client bringt
# sie selbst mit (statisch gelinkt oder als eigenes Paket); der Server
# braucht sie nicht, weil er die Gegenseite des Protokolls spricht und
# nicht dieselbe.
#
# Das Protokoll selbst ist eine SPEZIFIKATION in XML (wayland.xml,
# xdg-shell.xml). Aus ihr erzeugt tools/wayland/gen.py den Firn-Code.
# Eine Spezifikation zu lesen ist kein Uebernehmen von Fremdcode --
# sonst waere jeder TCP-Stapel fremder Code, weil es RFC 793 gibt.
#
# Bauen:
#   python3 pkg/opk.py bauen pkg/rezepte/wayland.rezept -o wayland-1.0.0.opk
name=wayland
fassung=1.0.0
titel=Wayland-Server
info=Uebersetzt das Wayland-Protokoll auf den Fensterserver von OrientOS
keys=wayland,wayd,gui,fremd,linux
handle=dienst
datei=start ../../../os-wayland-bin/wayd
