# pakete/stickwr/ACTIONS -- the action manifest of the USB stick writer `stickwr` (D7).
# Installed as /apps/stickwr.prog/ACTIONS; read by orient-bus.
# Format: docs/ACTION-BUS.md, section 3.
manifest 1
app stickwr
title "USB stick writer"

action stickwr.write critical "Write an image file onto a USB stick (ERASES what is on the stick)"
  arg image string required "The path of the .img or .iso file"
  arg target string required "The stick: /dev/usb0 .. /dev/usb3 (nothing else is accepted)"
  returns written int "How many octets were written"
  returns blocks int "How many writes of 64 KiB it took"
  returns verified int "1 = the stick was read back and is equal to the image"
  dryrun

action stickwr.writefile critical "Write this image onto the first USB stick (ERASES the stick)"
  arg path string required "The path of the .img or .iso file"
  returns written int "How many octets were written"
  returns blocks int "How many writes of 64 KiB it took"
  returns verified int "1 = the stick was read back and is equal to the image"
  menu file "Write to USB stick"
  menuext img iso
  dryrun

event stickwr.written "Sent after an image was written and verified"
  field written int "How many octets were written"
