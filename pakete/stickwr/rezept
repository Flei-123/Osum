# pakete/stickwr/rezept -- the USB stick writer as a package (program + action manifest).
#
# Ring-3 program `stickwr` (kernel/user/stickwr.fi): writes a .img/.iso onto /dev/usb0..3 only,
# ejects the mounted stick first, writes 64 KiB blocks, reads back and compares. Bus service
# `a.stickwr`; its two actions are level `critical` (the broker asks the user every time).
#
# Gebaut wird mit: bash pakete/bauen.sh
name=stickwr
fassung=0.1.0
titel=USB stick writer
info=Write an image file (.img/.iso) onto a USB stick, with eject, verify and a hard guard against any other disk.
keys=usb,stick,image,iso,write,flash
datei=bin/stickwr bau/stickwr.elf
datei=ACTIONS ACTIONS
