# pakete/wmplug-regel/rezept -- DIE FENSTERREGEL-ENGINE ALS PAKET.
#
# Zwei Dateien: das Programm und sein Regelwerk. Die Regeln gehoeren
# nach /etc und nicht in das Programm -- wer "Rechner immer auf Flaeche
# 2, schwebend, zentriert" aendern will, soll eine Zeile aendern und
# kein Programm neu bauen.
#
# Auch dieses Paket gibt sich KEINE Rechte: `regel` braucht 0x301
# (Fenster sehen, Fenster setzen, Fokus setzen) und bekommt sie erst
# durch `wmplug enable regel` aus /etc/wmplug.conf.
#
# Gebaut wird mit: bash pakete/bauen.sh
name=wmplug-regel
fassung=1.0.0
titel=Fensterregeln
info=Legt neue Fenster nach Regeln an ihren Platz: Arbeitsflaeche, schwebend oder gekachelt, zentriert. Liest /etc/wmregeln.conf und wirkt ueber WM_PLUG_ACT. Braucht die Rechte 0x301.
keys=regel,fenster,flaeche,plugin,wmplug,zentriert
datei=bin/plugregel bau/plugregel.elf
datei=etc/wmregeln.conf ../../etc/wmregeln.conf
