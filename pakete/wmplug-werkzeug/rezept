# pakete/wmplug-werkzeug/rezept -- DIE VERWALTUNG SELBST ALS PAKET.
#
# Kein zweites Format: das hier liest `pkg/opk.py` auf dem Wirt und
# `/bin/opk` (kernel/user/opk.fi) auf dem Geraet, Zeile fuer Zeile
# dieselbe Form wie das Treiberrezept in tools/module/paket.sh.
#
# Die Nutzlast sind zwei Dateien: das Programm und seine Vorgabe-
# konfiguration. Die conf gehoert MIT ins Paket -- ein `wmplug enable`
# ohne /etc/wmplug.conf kann nichts gewaehren, und eine Verwaltung, die
# ihre eigene Datei nicht mitbringt, ist eine halbe Auslieferung.
#
# Gebaut wird mit: bash pakete/bauen.sh
name=wmplug
fassung=1.0.0
titel=Fenstererweiterungen verwalten
info=Zeigt die angemeldeten Ring-3-Erweiterungen des Fensterservers mit ihren Rechten und Zaehlern und gewaehrt oder entzieht Rechte zur Laufzeit. Braucht einen Kern mit Plugin-Schnittstelle 1 (WM_PLUG_INFO 2121).
keys=wmplug,plugin,erweiterung,fenster,rechte,verwaltung
datei=bin/wmplug bau/wmplug.elf
datei=etc/wmplug.conf ../../etc/wmplug.conf
