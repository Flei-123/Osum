# pakete/fvviewer/rezept -- THE FREEVIEWER VIEWER AS A STORE PACKAGE.
#
# A bundle, like the apps of tools/loader/pakete.sh: opk turns exactly
# these three files into /apps/fvviewer.osp/{start,INFO,symbol}.
#   start   the Ring-3 program (kernel/user/fvviewer.fi, built by W3b)
#   INFO    manifest v2 (osdk.py check), net=real + perm=net
#   symbol  OSYM from symbol.txt (tools/k15/icon.py)
# The program checks no rights: netview enforces net= from INFO.
#
# Built by: bash pakete/bauen.sh  (needs kernel/user/fvviewer.fi; without
# it the package step is skipped and said so -- no placeholder ELF).
name=fvviewer
fassung=1.0.0
titel=FreeViewer
info=Fernwartung: fremden Bildschirm ansehen und steuern (FreeViewer-Relay)
keys=freeviewer,fernwartung,remote,desktop,viewer,fernzugriff
handle=fenster
datei=start bau/fvviewer.elf
datei=INFO INFO
datei=symbol bau/symbol
