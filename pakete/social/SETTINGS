# pakete/social/SETTINGS -- the settings page "Activity" of the social layer (docs/SETTINGS-MANIFEST.md).
# Installed as /apps/social.prog/SETTINGS; read by the Settings window at its start (r149).
manifest 1
app social

page activity settings.pkg.social.title share accounts
  column left
  note settings.pkg.social.help 2
  field share_activity bool settings.pkg.social.share
    read social.status
    write social.privacy.set
  field presence status settings.pkg.social.presence
    read social.status
  field activity status settings.pkg.social.activity
    read social.status
  field refresh action settings.pkg.social.refresh
    write social.refresh
