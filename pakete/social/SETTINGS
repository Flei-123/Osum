# pakete/social/SETTINGS -- the settings page "Activity" of the social layer (docs/SETTINGS-MANIFEST.md).
# Installed as /apps/social.prog/SETTINGS; read by the Settings window at its start (r149).
manifest 1
app social

page activity settings.pkg.social.title share accounts
  column left
  note settings.pkg.social.help 2
  field share_activity bool settings.pkg.social.share
    read social.status
    write social.privacy.set
  field presence status settings.pkg.social.presence
    read social.status
  field activity status settings.pkg.social.activity
    read social.status
  field refresh action settings.pkg.social.refresh
    write social.refresh

page rights settings.pkg.social.rights.title share accounts
  column left
  note settings.pkg.social.rights.help 3
  field app.1 status settings.pkg.social.app
    read social.apps.list
  field app.2 status settings.pkg.social.app
    read social.apps.list
  field app.3 status settings.pkg.social.app
    read social.apps.list
  field app.4 status settings.pkg.social.app
    read social.apps.list
  field allow text settings.pkg.social.allow
    write social.apps.allow
  field deny text settings.pkg.social.deny
    write social.apps.deny

page privacy settings.pkg.social.privacy.title share accounts
  column left
  note settings.pkg.social.privacy.help 2
  field invites_from status settings.pkg.social.invites
    read social.privacy.get
  field from text settings.pkg.social.invites.set
    write social.privacy.invites
  field hide.1 status settings.pkg.social.hidden
    read social.privacy.get
  field hide.2 status settings.pkg.social.hidden
    read social.privacy.get
  field hide.3 status settings.pkg.social.hidden
    read social.privacy.get
  field entry text settings.pkg.social.hide
    write social.privacy.hide
  field show text settings.pkg.social.show
    write social.privacy.show
