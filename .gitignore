# Der festgenagelte Uebersetzer wird gebaut, nicht eingecheckt.
# Eingecheckt ist nur vendor/firn/COMMIT und das Bauskript.
/vendor/firn/bin/
/vendor/firn/lib/
/vendor/firn/.gebaut

# Die Protokolle der Abnahme.
/.test-work/

# Uebersetzungsreste
*.o
*.mb
*.img
__pycache__/
*.pyc
# Round NETVIEW: the scratch logs of a measuring run belong to the run,
# not to the tree. They were swept in once by a `git add -A` and it took
# a commit to get them back out.
.nvlogs/

# Round TUNNEL: the oracle binary and its build directory.
/.probe/
/.initwork/

# RUNDE DESIGN-2: die Aufnahmen der Runde (gross, reproduzierbar)
.design2-shots/
.certus-bau/

# RUNDE TUERSCHLOSS: die PPM-Zwischenstufen der Bildsuche. Das PNG
# daneben ist der Beleg; das PPM ist nur das Format, das searchtext.py
# liest, und es ist viermal so gross.
*.ppm

# Runde ENERGIE: die Laeufe der Abnahme gehoeren zum Lauf, nicht zum Baum.
# Was BLEIBEN soll, liegt in belege/ -- Bilder und die herausgezogenen
# Belegzeilen. Die 1-MB-Mitschnitte und die Abbilder nicht.
/pruef/laeufe/
/pruef/shots/
/pruef/osum.mb
/pruef/root.img

# tools/aml/pflichtenheft.py uebersetzt die ASL-Quellen unter
# tools/aml/asl/ bei jedem Lauf neu. Im Repo steht der QUELLTEXT.
tools/aml/asl/*.aml
tools/aml/brett/
tools/acpiev/asl/*.aml

# RUNDE LOGIND: die Kladde der Messlaeufe (Bauprotokolle, Zwischenstaende).
# Was BELEGT, liegt in belege/logind/ und ist eingecheckt; das hier ist
# der Krims der Laeufe und gehoert nicht in den Baum -- derselbe Grund
# wie bei .nvlogs/ darueber.
/.logind-mess/
# Der ROHE Mitschnitt des Abmelde-Laufs (130 kB, und zwei Prozesse
# schreiben darin zeichenweise ineinander -- siehe RUNDE-LOGIND.md 4.5).
# Was BELEGT, steht gefiltert in belege/logind/abmelden-belegzeilen.txt.
/belege/logind/abmelden-klick.txt
/belege/logind/abmelden-qemu.txt

# RUNDE GUI-EDITOR: die Aufnahmen der Runde. Reproduzierbar mit
# `bash tools/guieditor/run.sh` -- gross und deshalb nicht im Baum,
# genau wie .design2-shots/ und .explorer2-shots/.
.editor-shots/
