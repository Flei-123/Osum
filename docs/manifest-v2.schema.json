{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "orientos.manifest/2",
 "title": "OrientOS app manifest v2 (normalized form of the INFO file)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "id",
  "name",
  "info",
  "keys",
  "version",
  "revision",
  "kind",
  "outputs",
  "menu",
  "permissions",
  "services"
 ],
 "allOf": [
  {
   "if": {
    "properties": {
     "outputs": {
      "contains": {
       "const": "native"
      }
     }
    }
   },
   "then": {
    "required": [
     "native"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "outputs": {
      "contains": {
       "const": "web"
      }
     }
    }
   },
   "then": {
    "required": [
     "web"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "service"
     }
    }
   },
   "then": {
    "required": [
     "service"
    ],
    "properties": {
     "outputs": {
      "const": [
       "native"
      ]
     }
    }
   }
  }
 ],
 "properties": {
  "schema": {
   "const": "orientos.manifest/2"
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*){1,5}$"
  },
  "name": {
   "type": "string",
   "minLength": 1,
   "maxLength": 31
  },
  "info": {
   "type": "string",
   "minLength": 1,
   "maxLength": 80
  },
  "keys": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "version": {
   "type": "string",
   "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
  },
  "revision": {
   "type": "integer",
   "minimum": 0,
   "maximum": 999999
  },
  "author": {
   "type": "string"
  },
  "license": {
   "type": "string"
  },
  "min_os": {
   "type": "string",
   "pattern": "^\\d{1,6}(\\.\\d{1,6}){0,2}$"
  },
  "kind": {
   "enum": [
    "gui",
    "app",
    "service"
   ]
  },
  "outputs": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "enum": [
     "native",
     "web"
    ]
   }
  },
  "menu": {
   "enum": [
    "show",
    "hidden"
   ]
  },
  "icon": {
   "type": "string",
   "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
  },
  "hide_if": {
   "type": "string"
  },
  "sandbox": {
   "const": "files"
  },
  "permissions": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "enum": [
     "net",
     "notify",
     "clipboard.read",
     "clipboard.write",
     "mic",
     "fs.home",
     "audio.play",
     "hotkey",
     "window.float",
     "files.open",
     "files.save",
     "dialog",
     "storage"
    ]
   }
  },
  "services": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "enum": [
     "file.open",
     "file.save",
     "clipboard.read",
     "clipboard.write",
     "dialog",
     "storage",
     "notify"
    ]
   }
  },
  "service": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9.]{0,15}$"
   }
  },
  "opens": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9]{1,8}$"
   }
  },
  "needs": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^(os|app:[a-z][a-z0-9.-]*)>=\\d{1,6}(\\.\\d{1,6}){0,2}$"
   }
  },
  "actions": {
   "type": "string"
  },
  "native": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "entry"
   ],
   "properties": {
    "entry": {
     "type": "string",
     "minLength": 1
    },
    "net": {
     "enum": [
      "real",
      "filtered",
      "faked",
      "none"
     ]
    }
   }
  },
  "web": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "entry",
    "memory_mib",
    "capabilities"
   ],
   "properties": {
    "entry": {
     "type": "string",
     "pattern": "^[A-Za-z0-9._-]{1,48}\\.wasm$"
    },
    "font": {
     "type": "string",
     "pattern": "^[A-Za-z0-9._-]{1,48}\\.ttf$"
    },
    "memory_mib": {
     "type": "integer",
     "minimum": 16,
     "maximum": 4096
    },
    "capabilities": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "services",
       "fetch"
      ]
     }
    }
   }
  },
  "custom": {
   "type": "object",
   "propertyNames": {
    "pattern": "^x-"
   },
   "additionalProperties": {
    "type": "string"
   }
  }
 }
}
