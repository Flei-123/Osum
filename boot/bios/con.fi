import mem
import ctx
import bios

export { say, say_num, clear, put }

fn serial(ch: u64) {
    var spin: u64 = 0
    while spin < 20000 && (bios.inb(0x3FD) & 0x20) == 0 {
        spin = spin + 1
    }
    bios.outb(0x3F8, ch)
}

fn put(c: u64, ch: u64) {
    if ch == 10 {
        serial(13)
    }
    serial(ch)
    if mem.get64(c + ctx.C_GOP) == 0 {
        if ch == 10 {
            bios.teletype(13)
        }
        bios.teletype(ch)
    }
}

fn say(c: u64, s: u64) {
    var i: u64 = 0
    while mem.get8(s + i) != 0 {
        put(c, mem.get8(s + i))
        i = i + 1
    }
}

fn say_num(c: u64, n: u64) {
    var digits: [u8; 24] = "000000000000000000000000"
    var k: u64 = 0
    var v: u64 = n
    if v == 0 {
        put(c, 48)
        return
    }
    while v > 0 {
        mem.set8((&digits[0]) as u64 + k, 48 + v % 10)
        v = v / 10
        k = k + 1
    }
    while k > 0 {
        k = k - 1
        put(c, mem.get8((&digits[0]) as u64 + k))
    }
}

fn clear(c: u64) {
    if mem.get64(c + ctx.C_GOP) != 0 {
        mem.set64(c + ctx.C_GOP, 0)
    }
    bios.set_mode3()
}
