import mem
import ctx
import splash

export { show, tick }

const TICK_COUNTER: u64 = 0x46C
const TICKS_PER_FRAME: u64 = 2

fn show(c: u64) {
    if mem.get64(c + ctx.C_GOP) == 0 {
        return
    }
    splash.paint(c)
    mem.set64(c + ctx.C_TIMER, mem.get32(TICK_COUNTER))
}

fn tick(c: u64) {
    if !splash.active(c) {
        return
    }
    let now: u64 = mem.get32(TICK_COUNTER)
    let last: u64 = mem.get64(c + ctx.C_TIMER)
    if now - last < TICKS_PER_FRAME && now >= last {
        return
    }
    mem.set64(c + ctx.C_TIMER, now)
    splash.step(c)
}
