import mem
import ctx
import plat
import bios
import con
import fsys
import cfg
import limine_cfg
import menu
import elf32
import tramp
import mbcore
import mbfb
import video

extern fn osboot_handoff(page: u64, entry: u64, mbi: u64);

const CTX_ADDR: u64 = 0x68000
const DESC_SIZE: u64 = 48

fn fail(c: u64, what: u64, detail: u64) {
    var pre: [u8; 16] = "osboot: error: \0"
    var sp: [u8; 2] = " \0"
    var nl: [u8; 2] = "\n\0"
    con.say(c, (&pre[0]) as u64)
    con.say(c, what)
    if detail != 0 {
        con.say(c, (&sp[0]) as u64)
        con.say(c, detail)
    }
    con.say(c, (&nl[0]) as u64)
}

fn give_up(c: u64) {
    var post: [u8; 24] = "osboot: halting in 5 s\n\0"
    con.say(c, (&post[0]) as u64)
    bios.sleep_ms(5000)
}

fn fail_num(c: u64, what: u64, n: u64) {
    var pre: [u8; 16] = "osboot: error: \0"
    var nl: [u8; 2] = "\n\0"
    con.say(c, (&pre[0]) as u64)
    con.say(c, what)
    con.say_num(c, n)
    con.say(c, (&nl[0]) as u64)
    give_up(c)
}

fn load_modules(c: u64, e: u64, mbi: u64, tp: u64) -> bool {
    var s_mod: [u8; 20] = "cannot load module:\0"
    var s_room: [u8; 23] = "module table full, at:\0"
    let n: u64 = mem.get64(e + ctx.E_NMODS)
    var i: u64 = 0
    while i < n {
        let path: u64 = mem.get64(e + ctx.E_MODS + i * 8)
        let buf: u64 = fsys.load(c, path, 0)
        if buf == 0 || tramp.overlaps(tp, buf, fsys.last_size(c)) {
            fail(c, (&s_mod[0]) as u64, path)
            return false
        }
        if !mbcore.add_module(mbi, buf, fsys.last_size(c), path) {
            fail(c, (&s_room[0]) as u64, path)
            return false
        }
        i = i + 1
    }
    return true
}

fn try_entry(c: u64, idx: u64, ndesc: u64) {
    var s_nokern: [u8; 18] = "kernel not found:\0"
    var s_notelf: [u8; 30] = "kernel is not an ELF32 image:\0"
    var s_notmb: [u8; 32] = "kernel has no multiboot header:\0"
    var s_range: [u8; 33] = "kernel memory range is not free:\0"
    var s_mem: [u8; 18] = "out of low memory\0"
    var s_novid: [u8; 39] = "osboot: no VBE framebuffer, text only\n\0"
    var s_go: [u8; 16] = "\nosboot: start \0"
    var nl: [u8; 2] = "\n\0"
    let e: u64 = cfg.entry(c, idx)
    let kpath: u64 = mem.get64(e + ctx.E_KERNEL)
    let kbuf: u64 = fsys.load(c, kpath, 0)
    if kbuf == 0 {
        fail(c, (&s_nokern[0]) as u64, kpath)
        return
    }
    let ksize: u64 = fsys.last_size(c)
    let tp: u64 = tramp.create(c)
    if tp == 0 {
        fail(c, (&s_mem[0]) as u64, 0)
        return
    }
    let r: u64 = elf32.load(tp, kbuf, ksize)
    if r == elf32.ERR_NOT_ELF {
        fail(c, (&s_notelf[0]) as u64, kpath)
        return
    }
    if r == elf32.ERR_NOT_MB {
        fail(c, (&s_notmb[0]) as u64, kpath)
        return
    }
    if r == elf32.ERR_RANGE {
        fail(c, (&s_range[0]) as u64, kpath)
        return
    }
    let entry: u64 = mem.get32(kbuf + 24)
    let mbi: u64 = mbcore.create(c)
    if mbi == 0 {
        fail(c, (&s_mem[0]) as u64, 0)
        return
    }
    mbcore.set_cmdline(mbi, mem.get64(e + ctx.E_CMDLINE))
    if !load_modules(c, e, mbi, tp) {
        return
    }
    if mbcore.reserved(tp, mbi) || tramp.overlaps(tp, kbuf, ksize) {
        fail(c, (&s_range[0]) as u64, kpath)
        return
    }
    if !tramp.map_ok(tp, mbcore.map_buffer(), ndesc * DESC_SIZE, DESC_SIZE) {
        fail(c, (&s_range[0]) as u64, kpath)
        return
    }
    con.say(c, (&s_go[0]) as u64)
    con.say(c, mem.get64(e + ctx.E_TITLE))
    con.say(c, (&nl[0]) as u64)
    if !video.init(c) {
        con.say(c, (&s_novid[0]) as u64)
    } else {
        mbfb.setup(c, mbi)
    }
    mbcore.convert(mbi, ndesc * DESC_SIZE, DESC_SIZE)
    osboot_handoff(tp, entry, mbi)
}

fn next_untried(c: u64) -> u64 {
    let n: u64 = mem.get64(c + ctx.C_NENT)
    let tried: u64 = mem.get64(c + ctx.C_TRIED)
    var i: u64 = 0
    while i < n {
        if ((tried >> i) & 1) == 0 {
            return i
        }
        i = i + 1
    }
    return 0xFFFFFFFF
}

fn pick_entry(c: u64) -> u64 {
    if mem.get64(c + ctx.C_MENU) == 1 {
        return menu.choose_shown(c)
    }
    if menu.key_window(c, mem.get64(c + ctx.C_KEYWAIT)) {
        return menu.choose_forced(c)
    }
    return mem.get64(c + ctx.C_DEFAULT) - 1
}

fn prepare_memory(c: u64) -> u64 {
    var s_nomem: [u8; 30] = "no usable memory above 32 MiB\0"
    let n: u64 = bios.e820(c)
    if n == 0 || !plat.init(c, bios.DESC_BASE, n) {
        fail(c, (&s_nomem[0]) as u64, 0)
        return 0
    }
    if !mbcore.alloc_map(c) {
        fail(c, (&s_nomem[0]) as u64, 0)
        return 0
    }
    mem.copy(mbcore.map_buffer(), bios.DESC_BASE, n * DESC_SIZE)
    return n
}

fn boot(c: u64) {
    var s_banner: [u8; 15] = "osboot (bios)\n\0"
    var s_root: [u8; 29] = "boot volume cannot be opened\0"
    var s_cfgpath: [u8; 12] = "/osboot.cfg\0"
    var s_nocfg: [u8; 18] = "config not found:\0"
    var s_badcfg: [u8; 24] = "config is broken, line \0"
    var s_limpath: [u8; 13] = "/limine.conf\0"
    var s_noent: [u8; 31] = "no multiboot1 entry in config:\0"
    con.say(c, (&s_banner[0]) as u64)
    let ndesc: u64 = prepare_memory(c)
    if ndesc == 0 {
        return
    }
    if !fsys.open_root(c) {
        fail(c, (&s_root[0]) as u64, 0)
        give_up(c)
        return
    }
    cfg.defaults(c)
    let cbuf: u64 = fsys.load(c, (&s_cfgpath[0]) as u64, 0)
    if cbuf != 0 && !cfg.parse(c, cbuf, fsys.last_size(c)) {
        fail_num(c, (&s_badcfg[0]) as u64, cfg.bad_line())
        return
    }
    if mem.get64(c + ctx.C_NENT) == 0 {
        let lbuf: u64 = fsys.load(c, (&s_limpath[0]) as u64, 0)
        if lbuf == 0 {
            fail(c, (&s_nocfg[0]) as u64, (&s_cfgpath[0]) as u64)
            give_up(c)
            return
        }
        if limine_cfg.parse(c, lbuf, fsys.last_size(c)) == 0 {
            fail(c, (&s_noent[0]) as u64, (&s_limpath[0]) as u64)
            give_up(c)
            return
        }
    }
    var idx: u64 = pick_entry(c)
    while true {
        mem.set64(c + ctx.C_TRIED, mem.get64(c + ctx.C_TRIED) | (1 << idx))
        try_entry(c, idx, ndesc)
        let next: u64 = next_untried(c)
        if next == 0xFFFFFFFF {
            give_up(c)
            return
        }
        idx = menu.choose_fallback(c, next)
    }
}

#[export_c]
fn bios_main() {
    let c: u64 = CTX_ADDR
    mem.zero(c, ctx.CTX_PAGES * 4096)
    mem.set64(c + ctx.C_DRIVE, mem.get8(0x6080))
    mem.set64(c + ctx.C_ESP, mem.get32(0x6084))
    boot(c)
    while true {
        bios.sleep_ms(1000)
    }
}
