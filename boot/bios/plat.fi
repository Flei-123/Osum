import mem
import ctx

export { init, alloc_code, alloc_data, alloc_high }

const BASE: u64 = 0x2000000
const CEILING: u64 = 0x3E000000

fn init(c: u64, desc: u64, count: u64) -> bool {
    var i: u64 = 0
    while i < count {
        let d: u64 = desc + i * 48
        let b: u64 = mem.get64(d + 8)
        let z: u64 = b + mem.get64(d + 24) * 4096
        if mem.get32(d) == 7 && b <= BASE && z > BASE + 0x1000000 {
            var top: u64 = z
            if top > CEILING {
                top = CEILING
            }
            mem.set64(c + ctx.C_BUMP, BASE)
            mem.set64(c + ctx.C_LIMIT, top)
            return true
        }
        i = i + 1
    }
    return false
}

fn bump(c: u64, pages: u64) -> u64 {
    let p: u64 = mem.get64(c + ctx.C_BUMP)
    if p + pages * 4096 > mem.get64(c + ctx.C_LIMIT) {
        return 0
    }
    mem.set64(c + ctx.C_BUMP, p + pages * 4096)
    return p
}

fn alloc_code(c: u64, pages: u64) -> u64 {
    return bump(c, pages)
}

fn alloc_data(c: u64, pages: u64) -> u64 {
    return bump(c, pages)
}

fn alloc_high(c: u64, pages: u64) -> u64 {
    return bump(c, pages)
}
