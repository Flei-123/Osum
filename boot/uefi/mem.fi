export { get8, get16, get32, get64, set8, set16, set32, set64, copy, zero, strlen, streq }

fn get8(p: u64) -> u64 {
    return __mmio_read8(p as *mut u8) as u64
}

fn get16(p: u64) -> u64 {
    return __mmio_read16(p as *mut u16) as u64
}

fn get32(p: u64) -> u64 {
    return __mmio_read32(p as *mut u32) as u64
}

fn get64(p: u64) -> u64 {
    return __mmio_read64(p as *mut u64)
}

fn set8(p: u64, v: u64) {
    __mmio_write8(p as *mut u8, v as u8)
}

fn set16(p: u64, v: u64) {
    __mmio_write16(p as *mut u16, v as u16)
}

fn set32(p: u64, v: u64) {
    __mmio_write32(p as *mut u32, v as u32)
}

fn set64(p: u64, v: u64) {
    __mmio_write64(p as *mut u64, v)
}

fn copy(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i + 8 <= n {
        set64(dst + i, get64(src + i))
        i = i + 8
    }
    while i < n {
        set8(dst + i, get8(src + i))
        i = i + 1
    }
}

fn zero(dst: u64, n: u64) {
    var i: u64 = 0
    while i + 8 <= n {
        set64(dst + i, 0)
        i = i + 8
    }
    while i < n {
        set8(dst + i, 0)
        i = i + 1
    }
}

fn strlen(p: u64) -> u64 {
    var n: u64 = 0
    while get8(p + n) != 0 {
        n = n + 1
    }
    return n
}

fn streq(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while get8(a + i) == get8(b + i) {
        if get8(a + i) == 0 {
            return true
        }
        i = i + 1
    }
    return false
}
