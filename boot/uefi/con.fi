import mem
import efi

export { say, say_num, say_hex, clear, key, hide, reveal, menu_key_pressed, KEY_ESC, KEY_F8 }

const WCAP: u64 = 360
const KEY_ESC: u64 = 0x10017
const KEY_F8: u64 = 0x10012
const SHIFT_VALID: u64 = 0x80000000
const SHIFT_ANY: u64 = 3

fn flush(c: u64, n: u64) {
    let w: u64 = c + efi.C_WBUF
    mem.set16(w + n * 2, 0)
    let con: u64 = mem.get64(c + efi.C_CON)
    efi.call2(mem.get64(con + 8), con, w)
}

fn say(c: u64, s: u64) {
    let w: u64 = c + efi.C_WBUF
    var n: u64 = 0
    var i: u64 = 0
    while mem.get8(s + i) != 0 {
        let ch: u64 = mem.get8(s + i)
        if ch == 10 {
            mem.set16(w + n * 2, 13)
            n = n + 1
        }
        mem.set16(w + n * 2, ch)
        n = n + 1
        if n >= WCAP {
            flush(c, n)
            n = 0
        }
        i = i + 1
    }
    flush(c, n)
}

fn say_num(c: u64, v: u64) {
    let w: u64 = c + efi.C_WBUF
    var digits: u64 = 1
    var t: u64 = v
    while t >= 10 {
        t = t / 10
        digits = digits + 1
    }
    var i: u64 = digits
    t = v
    while i > 0 {
        i = i - 1
        mem.set16(w + i * 2, 48 + t % 10)
        t = t / 10
    }
    flush(c, digits)
}

fn say_hex(c: u64, v: u64) {
    let w: u64 = c + efi.C_WBUF
    mem.set16(w, 48)
    mem.set16(w + 2, 120)
    var i: u64 = 0
    while i < 16 {
        let nib: u64 = (v >> ((15 - i) * 4)) & 15
        if nib < 10 {
            mem.set16(w + 4 + i * 2, 48 + nib)
        } else {
            mem.set16(w + 4 + i * 2, 87 + nib)
        }
        i = i + 1
    }
    flush(c, 18)
}

fn clear(c: u64) {
    let con: u64 = mem.get64(c + efi.C_CON)
    efi.call1(mem.get64(con + 48), con)
}

fn key(c: u64) -> u64 {
    let cin: u64 = mem.get64(c + efi.C_CONIN)
    mem.set64(efi.out_addr(c, 6), 0)
    if efi.call2(mem.get64(cin + 8), cin, efi.out_addr(c, 6)) != 0 {
        return 0
    }
    let k: u64 = efi.out(c, 6)
    let uni: u64 = (k >> 16) & 0xFFFF
    if uni != 0 {
        return uni
    }
    return 0x10000 + (k & 0xFFFF)
}

fn set_attr(c: u64, attr: u64) {
    let con: u64 = mem.get64(c + efi.C_CON)
    efi.call2(mem.get64(con + 40), con, attr)
}

fn hide(c: u64) {
    set_attr(c, 0)
}

fn reveal(c: u64) {
    set_attr(c, 7)
}

fn ex_protocol(c: u64) -> u64 {
    let known: u64 = mem.get64(c + efi.C_EX)
    if known != 0 {
        return known
    }
    let handle: u64 = mem.get64(mem.get64(c + efi.C_ST) + 40)
    if efi.call3(efi.bs_fn(c, 152), handle, efi.guid(c, 0x46987762dd9e7534, 0xaa25a61785f5148c), efi.out_addr(c, 0)) != 0 {
        mem.set64(c + efi.C_EX, 1)
        return 1
    }
    mem.set64(c + efi.C_EX, efi.out(c, 0))
    return efi.out(c, 0)
}

fn menu_key_pressed(c: u64) -> bool {
    let ex: u64 = ex_protocol(c)
    var n: u64 = 0
    while ex > 1 && n < 8 {
        let data: u64 = c + efi.C_KEYX
        mem.zero(data, 16)
        if efi.call2(mem.get64(ex + 8), ex, data) != 0 {
            return false
        }
        let scan: u64 = mem.get16(data)
        let shift: u64 = mem.get32(data + 4)
        if scan == 0x17 || scan == 0x12 {
            return true
        }
        if (shift & SHIFT_VALID) != 0 && (shift & SHIFT_ANY) != 0 {
            return true
        }
        n = n + 1
    }
    if ex > 1 {
        return false
    }
    let k: u64 = key(c)
    return k == KEY_ESC || k == KEY_F8
}
