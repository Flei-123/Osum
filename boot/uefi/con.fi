import mem
import efi

export { say, say_num, say_hex, clear, key }

const WCAP: u64 = 360

fn flush(c: u64, n: u64) {
    let w: u64 = c + efi.C_WBUF
    mem.set16(w + n * 2, 0)
    let con: u64 = mem.get64(c + efi.C_CON)
    efi.call2(mem.get64(con + 8), con, w)
}

fn say(c: u64, s: u64) {
    let w: u64 = c + efi.C_WBUF
    var n: u64 = 0
    var i: u64 = 0
    while mem.get8(s + i) != 0 {
        let ch: u64 = mem.get8(s + i)
        if ch == 10 {
            mem.set16(w + n * 2, 13)
            n = n + 1
        }
        mem.set16(w + n * 2, ch)
        n = n + 1
        if n >= WCAP {
            flush(c, n)
            n = 0
        }
        i = i + 1
    }
    flush(c, n)
}

fn say_num(c: u64, v: u64) {
    let w: u64 = c + efi.C_WBUF
    var digits: u64 = 1
    var t: u64 = v
    while t >= 10 {
        t = t / 10
        digits = digits + 1
    }
    var i: u64 = digits
    t = v
    while i > 0 {
        i = i - 1
        mem.set16(w + i * 2, 48 + t % 10)
        t = t / 10
    }
    flush(c, digits)
}

fn say_hex(c: u64, v: u64) {
    let w: u64 = c + efi.C_WBUF
    mem.set16(w, 48)
    mem.set16(w + 2, 120)
    var i: u64 = 0
    while i < 16 {
        let nib: u64 = (v >> ((15 - i) * 4)) & 15
        if nib < 10 {
            mem.set16(w + 4 + i * 2, 48 + nib)
        } else {
            mem.set16(w + 4 + i * 2, 87 + nib)
        }
        i = i + 1
    }
    flush(c, 18)
}

fn clear(c: u64) {
    let con: u64 = mem.get64(c + efi.C_CON)
    efi.call1(mem.get64(con + 48), con)
}

fn key(c: u64) -> u64 {
    let cin: u64 = mem.get64(c + efi.C_CONIN)
    mem.set64(efi.out_addr(c, 6), 0)
    if efi.call2(mem.get64(cin + 8), cin, efi.out_addr(c, 6)) != 0 {
        return 0
    }
    let k: u64 = efi.out(c, 6)
    let uni: u64 = (k >> 16) & 0xFFFF
    if uni != 0 {
        return uni
    }
    return 0x10000 + (k & 0xFFFF)
}
