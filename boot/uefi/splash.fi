import mem
import efi
import con

export { set_logo, show, tick, wait, active }

const LOGO_MAGIC: u64 = 0x314C424F
const LOGO_HEADER: u64 = 12
const TIMER_PERIODIC: u64 = 1
const TIMER_100NS: u64 = 800000
const EVT_TIMER: u64 = 0x80000000
const DOT_X: u64 = 0x050005101B201B10
const DOT_Y: u64 = 0x05101B201B100500
const STEP_US: u64 = 10000

fn scale(c: u64) -> u64 {
    let s: u64 = (mem.get64(c + efi.C_SH) + 540) / 1080
    if s == 0 {
        return 1
    }
    return s
}

fn pack(c: u64, r: u64, g: u64, b: u64) -> u64 {
    return (r << mem.get64(c + efi.C_RSH)) | (g << mem.get64(c + efi.C_GSH)) | (b << mem.get64(c + efi.C_BSH))
}

fn put(c: u64, x: u64, y: u64, v: u64) {
    if x < mem.get64(c + efi.C_SW) && y < mem.get64(c + efi.C_SH) {
        mem.set32(mem.get64(c + efi.C_FB) + (y * mem.get64(c + efi.C_PITCH) + x) * 4, v)
    }
}

fn fill_screen(c: u64, v: u64) {
    let w: u64 = mem.get64(c + efi.C_SW)
    let h: u64 = mem.get64(c + efi.C_SH)
    var y: u64 = 0
    while y < h {
        var x: u64 = 0
        let row: u64 = mem.get64(c + efi.C_FB) + y * mem.get64(c + efi.C_PITCH) * 4
        while x < w {
            mem.set32(row + x * 4, v)
            x = x + 1
        }
        y = y + 1
    }
}

fn logo_w(c: u64) -> u64 {
    let l: u64 = mem.get64(c + efi.C_LOGO)
    if l == 0 {
        return 0
    }
    return mem.get32(l + 4)
}

fn logo_h(c: u64) -> u64 {
    let l: u64 = mem.get64(c + efi.C_LOGO)
    if l == 0 {
        return 0
    }
    return mem.get32(l + 8)
}

fn set_logo(c: u64, buf: u64, size: u64) -> bool {
    if buf == 0 || size < LOGO_HEADER || mem.get32(buf) != LOGO_MAGIC {
        return false
    }
    let w: u64 = mem.get32(buf + 4)
    let h: u64 = mem.get32(buf + 8)
    if w == 0 || h == 0 || w > 2048 || h > 2048 || LOGO_HEADER + w * h * 4 > size {
        return false
    }
    mem.set64(c + efi.C_LOGO, buf)
    return true
}

fn block_top(c: u64) -> u64 {
    let sc: u64 = scale(c)
    var total: u64 = 40 * sc
    if logo_h(c) != 0 {
        total = total + logo_h(c) * sc + 48 * sc
    }
    let sh: u64 = mem.get64(c + efi.C_SH)
    if total >= sh {
        return 0
    }
    return (sh - total) / 2
}

fn spinner_center_y(c: u64) -> u64 {
    let sc: u64 = scale(c)
    var y: u64 = block_top(c) + 20 * sc
    if logo_h(c) != 0 {
        y = y + logo_h(c) * sc + 48 * sc
    }
    return y
}

fn draw_logo(c: u64) {
    let l: u64 = mem.get64(c + efi.C_LOGO)
    if l == 0 {
        return
    }
    let sc: u64 = scale(c)
    let w: u64 = logo_w(c)
    let h: u64 = logo_h(c)
    let left: u64 = (mem.get64(c + efi.C_SW) - w * sc) / 2
    let top: u64 = block_top(c)
    var y: u64 = 0
    while y < h {
        var x: u64 = 0
        while x < w {
            let p: u64 = l + LOGO_HEADER + (y * w + x) * 4
            let a: u64 = mem.get8(p + 3)
            if a != 0 {
                let v: u64 = pack(c, mem.get8(p) * a / 255, mem.get8(p + 1) * a / 255, mem.get8(p + 2) * a / 255)
                var dy: u64 = 0
                while dy < sc {
                    var dx: u64 = 0
                    while dx < sc {
                        put(c, left + x * sc + dx, top + y * sc + dy, v)
                        dx = dx + 1
                    }
                    dy = dy + 1
                }
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn draw_dot(c: u64, cx: u64, cy: u64, r: u64, level: u64) {
    let v: u64 = pack(c, level, level, level)
    var yy: u64 = 0
    while yy <= 2 * r {
        var xx: u64 = 0
        while xx <= 2 * r {
            var ax: u64 = 0
            if xx >= r {
                ax = xx - r
            } else {
                ax = r - xx
            }
            var ay: u64 = 0
            if yy >= r {
                ay = yy - r
            } else {
                ay = r - yy
            }
            if ax * ax + ay * ay <= r * r + 1 {
                put(c, cx + xx - r, cy + yy - r, v)
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
}

fn draw_spinner(c: u64, head: u64) {
    let sc: u64 = scale(c)
    let cx: u64 = mem.get64(c + efi.C_SW) / 2
    let cy: u64 = spinner_center_y(c)
    var i: u64 = 0
    while i < 8 {
        let d: u64 = (head + 8 - i) % 8
        let ox: u64 = cx - 16 * sc + ((DOT_X >> (i * 8)) & 255) * sc
        let oy: u64 = cy - 16 * sc + ((DOT_Y >> (i * 8)) & 255) * sc
        draw_dot(c, ox, oy, 3 * sc, 255 - 30 * d)
        i = i + 1
    }
}

fn active(c: u64) -> bool {
    return mem.get64(c + efi.C_SPLASH) != 0
}

fn show(c: u64) {
    if mem.get64(c + efi.C_GOP) == 0 {
        return
    }
    fill_screen(c, 0)
    draw_logo(c)
    mem.set64(c + efi.C_FRAME, 0)
    draw_spinner(c, 0)
    mem.set64(c + efi.C_SPLASH, 1)
    if mem.get64(c + efi.C_TIMER) == 0 {
        mem.set64(efi.out_addr(c, 1), 0)
        if efi.call5(efi.bs_fn(c, 80), EVT_TIMER, 0, 0, 0, efi.out_addr(c, 1)) == 0 {
            let ev: u64 = efi.out(c, 1)
            efi.call3(efi.bs_fn(c, 88), ev, TIMER_PERIODIC, TIMER_100NS)
            mem.set64(c + efi.C_TIMER, ev)
        }
    }
}

fn tick(c: u64) {
    if mem.get64(c + efi.C_SPLASH) == 0 {
        return
    }
    let ev: u64 = mem.get64(c + efi.C_TIMER)
    if ev != 0 && efi.call1(efi.bs_fn(c, 120), ev) != 0 {
        return
    }
    let f: u64 = mem.get64(c + efi.C_FRAME) + 1
    mem.set64(c + efi.C_FRAME, f)
    draw_spinner(c, f % 8)
}

fn wait(c: u64, ms: u64) -> bool {
    var left: u64 = ms * 1000
    while true {
        tick(c)
        if con.menu_key_pressed(c) {
            return true
        }
        if left == 0 {
            return false
        }
        var step: u64 = STEP_US
        if left < step {
            step = left
        }
        efi.stall(c, step)
        left = left - step
    }
    return false
}
