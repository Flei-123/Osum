import mem
import efi
import cfg

export { parse }

static mut cur_proto_ok: u64 = 0
static mut skipping: u64 = 0

fn skip_blank(p: u64) -> u64 {
    var i: u64 = 0
    while mem.get8(p + i) == 32 || mem.get8(p + i) == 9 {
        i = i + 1
    }
    return p + i
}

fn trim_end(p: u64) {
    var n: u64 = mem.strlen(p)
    while n > 0 && (mem.get8(p + n - 1) == 32 || mem.get8(p + n - 1) == 9) {
        n = n - 1
        mem.set8(p + n, 0)
    }
}

fn strip_boot(v: u64) -> u64 {
    var s_a: [u8; 8] = "boot():\0"
    var s_b: [u8; 8] = "boot://\0"
    var i: u64 = 0
    var same_a: bool = true
    var same_b: bool = true
    while i < 7 {
        if mem.get8(v + i) != (s_a[i as usize] as u64) {
            same_a = false
        }
        if mem.get8(v + i) != (s_b[i as usize] as u64) {
            same_b = false
        }
        i = i + 1
    }
    if same_a || same_b {
        return v + 7
    }
    return v
}

fn last_entry(c: u64) -> u64 {
    return cfg.entry(c, mem.get64(c + efi.C_NENT) - 1)
}

fn close_entry(c: u64) {
    let n: u64 = mem.get64(c + efi.C_NENT)
    if n == 0 || skipping != 0 {
        return
    }
    let e: u64 = last_entry(c)
    if mem.get64(e + efi.E_KERNEL) == 0 || cur_proto_ok == 0 {
        mem.set64(c + efi.C_NENT, n - 1)
    }
}

fn open_entry(c: u64, p: u64) {
    close_entry(c)
    var i: u64 = 0
    while mem.get8(p + i) == 47 {
        i = i + 1
    }
    let title: u64 = skip_blank(p + i)
    let n: u64 = mem.get64(c + efi.C_NENT)
    cur_proto_ok = 0
    skipping = 0
    if n >= efi.MAX_ENTRIES {
        skipping = 1
        return
    }
    mem.zero(cfg.entry(c, n), efi.ENTRY_SIZE)
    mem.set64(cfg.entry(c, n) + efi.E_TITLE, title)
    mem.set64(c + efi.C_NENT, n + 1)
}

fn entry_key(c: u64, k: u64, v: u64) {
    var s_path: [u8; 5] = "path\0"
    var s_kpath: [u8; 12] = "kernel_path\0"
    var s_mpath: [u8; 12] = "module_path\0"
    var s_cmd: [u8; 8] = "cmdline\0"
    var s_kcmd: [u8; 15] = "kernel_cmdline\0"
    var s_proto: [u8; 9] = "protocol\0"
    var s_mb1: [u8; 11] = "multiboot1\0"
    let n: u64 = mem.get64(c + efi.C_NENT)
    if n == 0 || skipping != 0 {
        return
    }
    let e: u64 = last_entry(c)
    if cfg.is_key(k, (&s_path[0]) as u64) || cfg.is_key(k, (&s_kpath[0]) as u64) {
        mem.set64(e + efi.E_KERNEL, strip_boot(v))
    } else if cfg.is_key(k, (&s_mpath[0]) as u64) {
        let m: u64 = mem.get64(e + efi.E_NMODS)
        if m < efi.MAX_MODS {
            mem.set64(e + efi.E_MODS + m * 8, strip_boot(v))
            mem.set64(e + efi.E_NMODS, m + 1)
        }
    } else if cfg.is_key(k, (&s_cmd[0]) as u64) || cfg.is_key(k, (&s_kcmd[0]) as u64) {
        mem.set64(e + efi.E_CMDLINE, v)
    } else if cfg.is_key(k, (&s_proto[0]) as u64) {
        if cfg.is_key(v, (&s_mb1[0]) as u64) {
            cur_proto_ok = 1
        } else {
            cur_proto_ok = 0
        }
    }
}

fn global_key(c: u64, k: u64, v: u64) {
    var s_timeout: [u8; 8] = "timeout\0"
    var s_default: [u8; 14] = "default_entry\0"
    if cfg.is_key(k, (&s_timeout[0]) as u64) {
        let t: u64 = cfg.number(v)
        if t != 0xFFFFFFFF {
            mem.set64(c + efi.C_TIMEOUT, t)
        }
    } else if cfg.is_key(k, (&s_default[0]) as u64) {
        let d: u64 = cfg.number(v)
        if d != 0xFFFFFFFF && d != 0 {
            mem.set64(c + efi.C_DEFAULT, d)
        }
    }
}

fn line(c: u64, raw: u64) {
    let p: u64 = skip_blank(raw)
    if mem.get8(p) == 0 || mem.get8(p) == 35 {
        return
    }
    trim_end(p)
    if mem.get8(p) == 47 {
        open_entry(c, p)
        return
    }
    var i: u64 = 0
    while mem.get8(p + i) != 0 && mem.get8(p + i) != 58 {
        i = i + 1
    }
    if mem.get8(p + i) != 58 {
        return
    }
    mem.set8(p + i, 0)
    let v: u64 = skip_blank(p + i + 1)
    trim_end(p)
    if mem.get64(c + efi.C_NENT) == 0 {
        global_key(c, p, v)
    } else {
        entry_key(c, p, v)
    }
}

fn parse(c: u64, buf: u64, size: u64) -> u64 {
    mem.set64(c + efi.C_NENT, 0)
    skipping = 0
    cur_proto_ok = 0
    var start: u64 = 0
    var i: u64 = 0
    while i <= size {
        let ch: u64 = mem.get8(buf + i)
        if ch == 13 {
            mem.set8(buf + i, 0)
        }
        if ch == 10 || i == size {
            mem.set8(buf + i, 0)
            line(c, buf + start)
            start = i + 1
        }
        i = i + 1
    }
    close_entry(c)
    let n: u64 = mem.get64(c + efi.C_NENT)
    if mem.get64(c + efi.C_DEFAULT) > n {
        mem.set64(c + efi.C_DEFAULT, 1)
    }
    return n
}
