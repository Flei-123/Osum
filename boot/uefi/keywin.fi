import mem
import ctx
import efi
import con
import anim

export { open, wait }

const EVT_TIMER: u64 = 0x80000000
const TIMER_RELATIVE: u64 = 2
const UNITS_PER_MS: u64 = 10000
const STEP_US: u64 = 10000

fn open(c: u64, ms: u64) {
    mem.set64(c + ctx.C_KEYHIT, 0)
    mem.set64(c + ctx.C_WINEV, 0)
    if ms == 0 {
        return
    }
    mem.set64(efi.out_addr(c, 1), 0)
    if efi.call5(efi.bs_fn(c, 80), EVT_TIMER, 0, 0, 0, efi.out_addr(c, 1)) != 0 {
        return
    }
    let ev: u64 = efi.out(c, 1)
    if efi.call3(efi.bs_fn(c, 88), ev, TIMER_RELATIVE, ms * UNITS_PER_MS) != 0 {
        return
    }
    mem.set64(c + ctx.C_WINEV, ev)
}

fn expired(c: u64) -> bool {
    let ev: u64 = mem.get64(c + ctx.C_WINEV)
    if ev == 0 {
        return true
    }
    return efi.call1(efi.bs_fn(c, 120), ev) == 0
}

fn wait(c: u64) -> bool {
    while true {
        anim.tick(c)
        if mem.get64(c + ctx.C_KEYHIT) != 0 || con.menu_key_pressed(c) {
            mem.set64(c + ctx.C_KEYHIT, 1)
            return true
        }
        if expired(c) {
            return false
        }
        efi.stall(c, STEP_US)
    }
    return false
}
