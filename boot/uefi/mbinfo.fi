import mem
import ctx
import efi
import tramp
import plat
import mbcore

export { overlaps_own, copy_rsdp, prepare_map, finish }

fn guid_is(p: u64, lo: u64, hi: u64) -> bool {
    return mem.get64(p) == lo && mem.get64(p + 8) == hi
}

fn copy_rsdp(c: u64) -> u64 {
    let st: u64 = mem.get64(c + ctx.C_ST)
    let n: u64 = mem.get64(st + 104)
    let tab: u64 = mem.get64(st + 112)
    var found: u64 = 0
    var i: u64 = 0
    while i < n {
        let e: u64 = tab + i * 24
        if guid_is(e, 0x11d3e4f18868e871, 0xc3c3c3c7800022bc) {
            found = mem.get64(e + 16)
        } else if found == 0 && guid_is(e, 0x11d32d88eb9d2d30, 0x4dc13f279000169a) {
            found = mem.get64(e + 16)
        }
        i = i + 1
    }
    if found == 0 {
        return 0
    }
    let page: u64 = plat.alloc_acpi(c, 1)
    if page == 0 {
        return found
    }
    mem.zero(page, 4096)
    var len: u64 = 20
    if mem.get8(found + 15) >= 2 {
        len = mem.get32(found + 20)
        if len < 36 || len > 4096 {
            len = 36
        }
    }
    mem.copy(page, found, len)
    return page
}

fn prepare_map(c: u64) -> bool {
    return mbcore.alloc_map(c)
}

fn overlaps_own(t: u64, mbi: u64) -> bool {
    return mbcore.reserved(t, mbi)
}

fn finish(c: u64, mbi: u64, t: u64) -> u64 {
    var tries: u64 = 0
    while tries < 4 {
        mem.set64(efi.out_addr(c, 0), 16 * 4096)
        if efi.call5(efi.bs_fn(c, 56), efi.out_addr(c, 0), mbcore.map_buffer(), efi.out_addr(c, 1), efi.out_addr(c, 2), efi.out_addr(c, 3)) == 0 {
            if !tramp.map_ok(t, mbcore.map_buffer(), efi.out(c, 0), efi.out(c, 2)) {
                return 2
            }
            mbcore.convert(mbi, efi.out(c, 0), efi.out(c, 2))
            if efi.call2(efi.bs_fn(c, 232), mem.get64(c + ctx.C_IMG), efi.out(c, 1)) == 0 {
                return 0
            }
        }
        tries = tries + 1
    }
    return 1
}
