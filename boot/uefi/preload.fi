import mem
import ctx
import efi
import cfg
import fsys

export { run, take, discard }

const NONE: u64 = 0

fn discard(c: u64) {
    let buf: u64 = mem.get64(c + ctx.C_PRE_BUF)
    if buf != 0 {
        fsys.free_pages(c, buf, mem.get64(c + ctx.C_PRE_SIZE))
    }
    mem.set64(c + ctx.C_PRE_BUF, 0)
    mem.set64(c + ctx.C_PRE_IDX, NONE)
}

fn run(c: u64, idx: u64) {
    if idx >= mem.get64(c + ctx.C_NENT) {
        return
    }
    let kpath: u64 = mem.get64(cfg.entry(c, idx) + ctx.E_KERNEL)
    mem.set64(c + ctx.C_POLLKEY, 1)
    let buf: u64 = fsys.load_module(c, kpath, 0xFFFFFFFF)
    mem.set64(c + ctx.C_POLLKEY, 0)
    if buf == 0 {
        return
    }
    mem.set64(c + ctx.C_PRE_BUF, buf)
    mem.set64(c + ctx.C_PRE_SIZE, fsys.last_size(c))
    mem.set64(c + ctx.C_PRE_IDX, idx + 1)
}

fn take(c: u64, idx: u64, kpath: u64) -> u64 {
    if mem.get64(c + ctx.C_PRE_IDX) != idx + 1 {
        discard(c)
        return fsys.load_module(c, kpath, 0xFFFFFFFF)
    }
    let buf: u64 = mem.get64(c + ctx.C_PRE_BUF)
    fsys.set_last_size(c, mem.get64(c + ctx.C_PRE_SIZE))
    mem.set64(c + ctx.C_PRE_BUF, 0)
    mem.set64(c + ctx.C_PRE_IDX, NONE)
    return buf
}
