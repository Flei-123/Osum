import mem

export { C_ST, C_IMG, C_BS, C_CON, C_CONIN, C_ROOT, C_OUT, C_WBUF, C_ENTRIES, C_NENT, C_TIMEOUT, C_DEFAULT, C_RES_W, C_RES_H, C_CFG, C_CFGLEN, CTX_PAGES, ENTRY_SIZE, MAX_ENTRIES,
    E_TITLE, E_KERNEL, E_CMDLINE, E_NMODS, E_MODS, MAX_MODS,
    LOW_LIMIT, ANY_PAGES, MAX_ADDRESS, AT_ADDRESS, LOADER_CODE, LOADER_DATA, ACPI_RECLAIM, LOAD_ERROR, NOT_READY,
    call1, call2, call3, call4, call5, bs, bs_fn, alloc_at, alloc_below, stall, out, out_addr, guid }

extern fn efi_call(f: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> u64;

const C_ST: u64 = 0
const C_IMG: u64 = 8
const C_BS: u64 = 16
const C_CON: u64 = 24
const C_CONIN: u64 = 32
const C_ROOT: u64 = 40
const C_NENT: u64 = 48
const C_TIMEOUT: u64 = 56
const C_DEFAULT: u64 = 64
const C_RES_W: u64 = 72
const C_RES_H: u64 = 80
const C_CFG: u64 = 88
const C_CFGLEN: u64 = 96
const C_OUT: u64 = 128
const C_GUID: u64 = 192
const C_WBUF: u64 = 256
const C_ENTRIES: u64 = 1024
const ENTRY_SIZE: u64 = 96
const MAX_ENTRIES: u64 = 16
const E_TITLE: u64 = 0
const E_KERNEL: u64 = 8
const E_CMDLINE: u64 = 16
const E_NMODS: u64 = 24
const E_MODS: u64 = 32
const MAX_MODS: u64 = 8
const CTX_PAGES: u64 = 2

const LOW_LIMIT: u64 = 0x3FFFFFFF
const LOW_START: u64 = 0x2000000
const LOW_END: u64 = 0x30000000
const ANY_PAGES: u64 = 0
const MAX_ADDRESS: u64 = 1
const AT_ADDRESS: u64 = 2
const LOADER_CODE: u64 = 1
const LOADER_DATA: u64 = 2
const ACPI_RECLAIM: u64 = 9
const LOAD_ERROR: u64 = 0x8000000000000001
const NOT_READY: u64 = 0x8000000000000006

fn call1(f: u64, a: u64) -> u64 {
    return efi_call(f, a, 0, 0, 0, 0, 0)
}

fn call2(f: u64, a: u64, b: u64) -> u64 {
    return efi_call(f, a, b, 0, 0, 0, 0)
}

fn call3(f: u64, a: u64, b: u64, c3: u64) -> u64 {
    return efi_call(f, a, b, c3, 0, 0, 0)
}

fn call4(f: u64, a: u64, b: u64, c3: u64, d: u64) -> u64 {
    return efi_call(f, a, b, c3, d, 0, 0)
}

fn call5(f: u64, a: u64, b: u64, c3: u64, d: u64, e: u64) -> u64 {
    return efi_call(f, a, b, c3, d, e, 0)
}

fn bs(c: u64) -> u64 {
    return mem.get64(c + C_BS)
}

fn bs_fn(c: u64, off: u64) -> u64 {
    return mem.get64(bs(c) + off)
}

fn out(c: u64, i: u64) -> u64 {
    return mem.get64(c + C_OUT + i * 8)
}

fn out_addr(c: u64, i: u64) -> u64 {
    return c + C_OUT + i * 8
}

fn guid(c: u64, lo: u64, hi: u64) -> u64 {
    mem.set64(c + C_GUID, lo)
    mem.set64(c + C_GUID + 8, hi)
    return c + C_GUID
}

fn alloc_at(c: u64, addr: u64, pages: u64, kind: u64) -> bool {
    mem.set64(out_addr(c, 7), addr)
    return call4(bs_fn(c, 40), AT_ADDRESS, kind, pages, out_addr(c, 7)) == 0
}

fn alloc_low(c: u64, pages: u64, kind: u64) -> u64 {
    var a: u64 = LOW_START
    while a + pages * 4096 <= LOW_END {
        if alloc_at(c, a, pages, kind) {
            return a
        }
        a = a + 0x100000
    }
    return 0
}

fn alloc_below(c: u64, limit: u64, pages: u64, kind: u64) -> u64 {
    if limit == LOW_LIMIT {
        return alloc_low(c, pages, kind)
    }
    mem.set64(out_addr(c, 7), limit)
    if call4(bs_fn(c, 40), MAX_ADDRESS, kind, pages, out_addr(c, 7)) != 0 {
        return 0
    }
    return out(c, 7)
}

fn stall(c: u64, us: u64) {
    call1(bs_fn(c, 248), us)
}
