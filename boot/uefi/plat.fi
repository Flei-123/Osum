import efi

export { alloc_code, alloc_data, alloc_acpi, alloc_high }

fn alloc_code(c: u64, pages: u64) -> u64 {
    return efi.alloc_below(c, efi.LOW_LIMIT, pages, efi.LOADER_CODE)
}

fn alloc_data(c: u64, pages: u64) -> u64 {
    return efi.alloc_below(c, efi.LOW_LIMIT, pages, efi.LOADER_DATA)
}

fn alloc_acpi(c: u64, pages: u64) -> u64 {
    return efi.alloc_below(c, efi.LOW_LIMIT, pages, efi.ACPI_RECLAIM)
}

fn alloc_high(c: u64, pages: u64) -> u64 {
    return efi.alloc_below(c, 0xFFFFFFFF, pages, efi.LOADER_DATA)
}
