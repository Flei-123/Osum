import mem
import efi
import con
import cfg

export { choose }

const TICK_US: u64 = 50000
const KEY_UP: u64 = 0x10001
const KEY_DOWN: u64 = 0x10002

fn draw(c: u64, sel: u64, left: u64) {
    var head: [u8; 15] = "Boot entries:\n\0"
    var mark: [u8; 5] = "  > \0"
    var blank: [u8; 5] = "    \0"
    var dot: [u8; 3] = ". \0"
    var nl: [u8; 2] = "\n\0"
    var t1: [u8; 26] = "\nEnter boots, digits pick\0"
    var t2: [u8; 11] = ", booting \0"
    var t3: [u8; 5] = " in \0"
    var t4: [u8; 3] = "s\n\0"
    con.clear(c)
    con.say(c, (&head[0]) as u64)
    let n: u64 = mem.get64(c + efi.C_NENT)
    var i: u64 = 0
    while i < n {
        if i == sel {
            con.say(c, (&mark[0]) as u64)
        } else {
            con.say(c, (&blank[0]) as u64)
        }
        con.say_num(c, i + 1)
        con.say(c, (&dot[0]) as u64)
        con.say(c, mem.get64(cfg.entry(c, i) + efi.E_TITLE))
        con.say(c, (&nl[0]) as u64)
        i = i + 1
    }
    con.say(c, (&t1[0]) as u64)
    if left != 0xFFFFFFFF {
        con.say(c, (&t2[0]) as u64)
        con.say_num(c, sel + 1)
        con.say(c, (&t3[0]) as u64)
        con.say_num(c, (left + 19) / 20)
    }
    con.say(c, (&t4[0]) as u64)
}

fn choose(c: u64) -> u64 {
    let n: u64 = mem.get64(c + efi.C_NENT)
    var sel: u64 = mem.get64(c + efi.C_DEFAULT) - 1
    let timeout: u64 = mem.get64(c + efi.C_TIMEOUT)
    if timeout == 0 {
        return sel
    }
    var left: u64 = timeout * 20
    draw(c, sel, left)
    while true {
        let k: u64 = con.key(c)
        if k == 13 {
            return sel
        }
        if k >= 49 && k <= 57 && k - 49 < n {
            return k - 49
        }
        if k != 0 {
            left = 0xFFFFFFFF
            if k == KEY_UP && sel > 0 {
                sel = sel - 1
            }
            if k == KEY_DOWN && sel + 1 < n {
                sel = sel + 1
            }
            draw(c, sel, left)
        } else if left != 0xFFFFFFFF {
            if left == 0 {
                return sel
            }
            left = left - 1
            if left % 20 == 0 {
                draw(c, sel, left)
            }
        }
        efi.stall(c, TICK_US)
    }
    return sel
}
