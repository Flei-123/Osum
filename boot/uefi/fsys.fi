import mem
import ctx
import efi
import splash
import anim
import inflate
import con

export { open_root, wide_path, load, load_module, last_size, set_last_size, free_pages, stat }

const CHUNK: u64 = 0x400000
const SPLASH_CHUNK: u64 = 0x40000
const SLOT_SIZE: u64 = 5
const INFO_SIZE_OFF: u64 = 8
const INFO_MTIME_OFF: u64 = 56
const SECONDS_PER_DAY: u64 = 86400

fn open_root(c: u64) -> bool {
    let hp: u64 = efi.bs_fn(c, 152)
    let img: u64 = mem.get64(c + ctx.C_IMG)
    if efi.call3(hp, img, efi.guid(c, 0x11d295625b1b31a1, 0x3b7269c9a0003f8e), efi.out_addr(c, 0)) != 0 {
        return false
    }
    let dev: u64 = mem.get64(efi.out(c, 0) + 24)
    if efi.call3(hp, dev, efi.guid(c, 0x11d26459964e5b22, 0x3b7269c9a000398e), efi.out_addr(c, 0)) != 0 {
        return false
    }
    let sfs: u64 = efi.out(c, 0)
    if efi.call2(mem.get64(sfs + 8), sfs, efi.out_addr(c, 0)) != 0 {
        return false
    }
    mem.set64(c + ctx.C_ROOT, efi.out(c, 0))
    return true
}

fn wide_path(c: u64, path: u64) -> u64 {
    let w: u64 = c + ctx.C_WBUF
    var i: u64 = 0
    while mem.get8(path + i) != 0 && i < 300 {
        var ch: u64 = mem.get8(path + i)
        if ch == 47 {
            ch = 92
        }
        mem.set16(w + i * 2, ch)
        i = i + 1
    }
    mem.set16(w + i * 2, 0)
    return w
}

fn last_size(c: u64) -> u64 {
    return efi.out(c, SLOT_SIZE)
}

fn set_last_size(c: u64, size: u64) {
    mem.set64(efi.out_addr(c, SLOT_SIZE), size)
}

fn load(c: u64, path: u64, limit: u64) -> u64 {
    let root: u64 = mem.get64(c + ctx.C_ROOT)
    if efi.call5(mem.get64(root + 8), root, efi.out_addr(c, 0), wide_path(c, path), 1, 0) != 0 {
        return 0
    }
    let f: u64 = efi.out(c, 0)
    efi.call2(mem.get64(f + 56), f, 0xFFFFFFFFFFFFFFFF)
    efi.call2(mem.get64(f + 48), f, efi.out_addr(c, 1))
    let size: u64 = efi.out(c, 1)
    efi.call2(mem.get64(f + 56), f, 0)
    let buf: u64 = efi.alloc_below(c, limit, (size + 4096) / 4096, efi.LOADER_DATA)
    if buf == 0 {
        efi.call1(mem.get64(f + 16), f)
        return 0
    }
    var done: u64 = 0
    var ok: bool = true
    while done < size && ok {
        var n: u64 = size - done
        var cap: u64 = CHUNK
        if splash.active(c) {
            cap = SPLASH_CHUNK
        }
        if n > cap {
            n = cap
        }
        mem.set64(efi.out_addr(c, 1), n)
        if efi.call3(mem.get64(f + 32), f, efi.out_addr(c, 1), buf + done) != 0 {
            ok = false
        } else if efi.out(c, 1) == 0 {
            ok = false
        } else {
            done = done + efi.out(c, 1)
            anim.tick(c)
            if mem.get64(c + ctx.C_POLLKEY) != 0 && done < size && con.menu_key_pressed(c) {
                mem.set64(c + ctx.C_KEYHIT, 1)
                ok = false
            }
        }
    }
    efi.call1(mem.get64(f + 16), f)
    if !ok {
        free_pages(c, buf, size)
        return 0
    }
    mem.set8(buf + size, 0)
    mem.set64(efi.out_addr(c, SLOT_SIZE), size)
    return buf
}

fn free_pages(c: u64, addr: u64, bytes: u64) {
    efi.call2(efi.bs_fn(c, 48), addr, (bytes + 4096) / 4096)
}

fn time_key(t: u64) -> u64 {
    let days: u64 = (mem.get16(t) * 12 + mem.get8(t + 2)) * 31 + mem.get8(t + 3)
    return days * SECONDS_PER_DAY + mem.get8(t + 4) * 3600 + mem.get8(t + 5) * 60 + mem.get8(t + 6)
}

fn stat(c: u64, path: u64) -> bool {
    let root: u64 = mem.get64(c + ctx.C_ROOT)
    if efi.call5(mem.get64(root + 8), root, efi.out_addr(c, 0), wide_path(c, path), 1, 0) != 0 {
        return false
    }
    let f: u64 = efi.out(c, 0)
    let info: u64 = c + ctx.C_INFO
    mem.set64(efi.out_addr(c, 1), ctx.INFO_BYTES)
    let r: u64 = efi.call4(mem.get64(f + 64), f, efi.guid(c, 0x11d26d3f09576e92, 0x3b7269c9a000398e), efi.out_addr(c, 1), info)
    efi.call1(mem.get64(f + 16), f)
    if r != 0 {
        return false
    }
    mem.set64(c + ctx.C_STAT_SIZE, mem.get64(info + INFO_SIZE_OFF))
    mem.set64(c + ctx.C_STAT_TIME, time_key(info + INFO_MTIME_OFF))
    return true
}

fn gz_older_than_raw(c: u64, path: u64, gz_path: u64) -> bool {
    if !stat(c, path) {
        return false
    }
    let raw_time: u64 = mem.get64(c + ctx.C_STAT_TIME)
    if !stat(c, gz_path) {
        return true
    }
    return mem.get64(c + ctx.C_STAT_TIME) < raw_time
}

fn raw_size_or_zero(c: u64, path: u64) -> u64 {
    if !stat(c, path) {
        return 0
    }
    return mem.get64(c + ctx.C_STAT_SIZE)
}

fn gunzip_file(c: u64, gz: u64, gz_size: u64, raw_size: u64, limit: u64) -> u64 {
    let out: u64 = efi.alloc_below(c, limit, (raw_size + 4096) / 4096, efi.LOADER_DATA)
    let scratch: u64 = efi.alloc_below(c, 0xFFFFFFFF, inflate.SCRATCH_PAGES, efi.LOADER_DATA)
    var got: u64 = 0
    if out != 0 && scratch != 0 {
        got = inflate.gunzip(gz, gz_size, out, raw_size, scratch)
    }
    if scratch != 0 {
        free_pages(c, scratch, inflate.SCRATCH_PAGES * 4096 - 4096)
    }
    if got == raw_size {
        mem.set8(out + raw_size, 0)
        mem.set64(efi.out_addr(c, SLOT_SIZE), raw_size)
        return out
    }
    if out != 0 {
        free_pages(c, out, raw_size)
    }
    return 0
}

fn say_gunzip(c: u64, path: u64) {
    var s_pre: [u8; 16] = "osboot: gunzip \0"
    var s_nl: [u8; 2] = "\n\0"
    con.say(c, (&s_pre[0]) as u64)
    con.say(c, path)
    con.say(c, (&s_nl[0]) as u64)
}

fn load_module(c: u64, path: u64, limit: u64) -> u64 {
    var gz_path: [u8; 128] = [0 as u8; 128]
    let gp: u64 = (&gz_path[0]) as u64
    let n: u64 = mem.strlen(path)
    if n > 120 {
        return load(c, path, limit)
    }
    mem.copy(gp, path, n)
    mem.set8(gp + n, 46)
    mem.set8(gp + n + 1, 103)
    mem.set8(gp + n + 2, 122)
    mem.set8(gp + n + 3, 0)
    if gz_older_than_raw(c, path, gp) {
        return load(c, path, limit)
    }
    let gz: u64 = load(c, gp, 0xFFFFFFFF)
    if gz == 0 {
        return load(c, path, limit)
    }
    let gz_size: u64 = last_size(c)
    let raw_size: u64 = inflate.isize(gz, gz_size)
    let on_disk: u64 = raw_size_or_zero(c, path)
    var out: u64 = 0
    if raw_size != 0 && (on_disk == 0 || on_disk == raw_size) {
        out = gunzip_file(c, gz, gz_size, raw_size, limit)
    }
    free_pages(c, gz, gz_size)
    if out == 0 {
        return load(c, path, limit)
    }
    say_gunzip(c, path)
    return out
}
