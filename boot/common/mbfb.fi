import mem
import ctx

export { setup }

fn setup(c: u64, mbi: u64) -> bool {
    if mem.get64(c + ctx.C_GOP) == 0 {
        return false
    }
    let r_bits: u64 = mem.get64(c + ctx.C_RBITS)
    let g_bits: u64 = mem.get64(c + ctx.C_GBITS)
    let b_bits: u64 = mem.get64(c + ctx.C_BBITS)
    mem.set64(mbi + 88, mem.get64(c + ctx.C_FB))
    mem.set32(mbi + 96, mem.get64(c + ctx.C_PITCH) * 4)
    mem.set32(mbi + 100, mem.get64(c + ctx.C_SW))
    mem.set32(mbi + 104, mem.get64(c + ctx.C_SH))
    mem.set8(mbi + 108, 32)
    mem.set8(mbi + 109, 1)
    mem.set8(mbi + 110, mem.get64(c + ctx.C_RSH))
    mem.set8(mbi + 111, r_bits)
    mem.set8(mbi + 112, mem.get64(c + ctx.C_GSH))
    mem.set8(mbi + 113, g_bits)
    mem.set8(mbi + 114, mem.get64(c + ctx.C_BSH))
    mem.set8(mbi + 115, b_bits)
    mem.set32(mbi, mem.get32(mbi) | 0x1000)
    return true
}
