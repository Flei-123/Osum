// SPDX-License-Identifier: GPL-2.0-only
profile app

import font.ttf

export {
    MIN_PX, MAX_PX, SLOTS,
    enable, enabled, reset, zone_height, vfactor
}

const MIN_PX: u64 = 6
const MAX_PX: u64 = 24
const SLOTS: u64 = 12
const ZONES: u64 = 3
const CP_XHEIGHT: u32 = 0x78 as u32
const CP_CAP: u32 = 0x48 as u32
const CP_ASCENDER: u32 = 0x64 as u32

static mut s_zone: [i32; 36] = [0; 36]
static mut s_ready: [u64; 12] = [0; 12]
static mut s_enabled: u64 = 1

fn enable(v: u64) {
    s_enabled = v
}

fn enabled() -> bool {
    return s_enabled != 0
}

fn reset() {
    var i: usize = 0
    while i < 12 {
        s_ready[i] = 0
        i = i + 1
    }
}

fn top_of(f: *mut ttf.Font, cp: u32) -> i32 {
    let g: u32 = ttf.font_glyph_for(f, cp)
    if g == 0 as u32 {
        return 0
    }
    var x0: i32 = 0
    var y0: i32 = 0
    var x1: i32 = 0
    var y1: i32 = 0
    if !ttf.font_glyph_bbox(f, g, &x0, &y0, &x1, &y1) {
        return 0
    }
    return y1
}

fn ensure(slot: u64, f: *mut ttf.Font) {
    if s_ready[slot as usize] != 0 {
        return
    }
    s_ready[slot as usize] = 1
    let b: usize = (slot * ZONES) as usize
    let xh: i32 = top_of(f, CP_XHEIGHT)
    let cap: i32 = top_of(f, CP_CAP)
    let asc: i32 = top_of(f, CP_ASCENDER)
    s_zone[b] = 0
    s_zone[b + 1] = 0
    s_zone[b + 2] = 0
    if xh > 0 && cap > xh && asc >= xh {
        s_zone[b] = xh
        s_zone[b + 1] = cap
        s_zone[b + 2] = asc
    }
}

fn zone_height(slot: u64, f: *mut ttf.Font, which: u64) -> i32 {
    if slot >= SLOTS || which >= ZONES {
        return 0
    }
    ensure(slot, f)
    return s_zone[(slot * ZONES + which) as usize]
}

#[allow_fp]
fn vfactor(slot: u64, f: *mut ttf.Font, px: u64, top: i32) -> f64 {
    if !enabled() || px < MIN_PX || px > MAX_PX || top <= 0 || slot >= SLOTS {
        return 1.0
    }
    ensure(slot, f)
    let upem: i32 = ttf.font_upem(f) as i32
    if upem <= 0 {
        return 1.0
    }
    let tol: i32 = upem / 48
    var best: i32 = 0
    var best_d: i32 = tol + 1
    var z: u64 = 0
    while z < ZONES {
        let h: i32 = s_zone[(slot * ZONES + z) as usize]
        if h > 0 {
            var d: i32 = top - h
            if d < 0 {
                d = 0 - d
            }
            if d < best_d {
                best_d = d
                best = h
            }
        }
        z = z + 1
    }
    if best == 0 {
        return 1.0
    }
    let px_h: f64 = (best as f64) * (px as f64) / (upem as f64)
    let rows: f64 = ((px_h + 0.5) as i64) as f64
    if rows < 1.0 {
        return 1.0
    }
    return rows / px_h
}
