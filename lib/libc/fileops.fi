import libc.io
import libc.errno

export { exists, is_directory, read_all, write_file, copy_file }

const CHUNK: u64 = 4096

fn exists(path: u64) -> bool {
    return !errno.failed(io.stat_mode(path))
}

fn is_directory(path: u64) -> bool {
    let mode: u64 = io.stat_mode(path)
    if errno.failed(mode) {
        return false
    }
    return io.is_dir_mode(mode)
}

fn read_all(path: u64, buf: u64, cap: u64) -> u64 {
    let fd: u64 = io.open(path, 0)
    if errno.failed(fd) {
        return fd
    }
    let n: u64 = io.read_full(fd, buf, cap)
    io.close(fd)
    return n
}

fn write_file(path: u64, buf: u64, n: u64) -> u64 {
    let fd: u64 = io.create(path)
    if errno.failed(fd) {
        return fd
    }
    let done: u64 = io.write_all(fd, buf, n)
    io.close(fd)
    return done
}

fn copy_file(src: u64, dst: u64) -> u64 {
    var chunk: [u8; 4096] = [0 as u8; 4096]
    let from: u64 = io.open(src, 0)
    if errno.failed(from) {
        return from
    }
    let to: u64 = io.create(dst)
    if errno.failed(to) {
        io.close(from)
        return to
    }
    var total: u64 = 0
    var going: bool = true
    while going {
        let got: u64 = io.read(from, (&chunk[0]) as u64, CHUNK)
        if errno.failed(got) {
            total = got
            going = false
        } else if got == 0 {
            going = false
        } else {
            let put: u64 = io.write_all(to, (&chunk[0]) as u64, got)
            if errno.failed(put) {
                total = put
                going = false
            } else {
                total = total + put
            }
        }
    }
    io.close(from)
    io.close(to)
    return total
}
