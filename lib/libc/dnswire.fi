
export {
    q_build, q_qlen, ans_check, case_only,
    name_at, name_end,
    rcode, ancount, cnames, ttl, aa, tc,
    T_A, T_AAAA, T_CNAME, T_NS, C_IN, HDR,
    MAX_NAME, MAX_JUMPS,
    R_OK, R_FORMAT, R_NXDOMAIN, R_NODATA, R_SERVFAIL, R_REFUSED,
    R_TRUNC, R_MISMATCH, R_LOOP, R_TOOLONG, R_NOTQUERY, R_BADNAME
}

const T_A: u64 = 1
const T_NS: u64 = 2
const T_CNAME: u64 = 5
const T_AAAA: u64 = 28
const C_IN: u64 = 1
const HDR: u64 = 12

const MAX_NAME: u64 = 255
const MAX_LABEL: u64 = 63
const MAX_JUMPS: u64 = 8
const MAX_CHASE: u64 = 8

const R_OK: u64 = 0
const R_FORMAT: u64 = 1
const R_NXDOMAIN: u64 = 2
const R_NODATA: u64 = 3
const R_SERVFAIL: u64 = 4
const R_REFUSED: u64 = 5
const R_TRUNC: u64 = 6
const R_MISMATCH: u64 = 7
const R_LOOP: u64 = 8
const R_TOOLONG: u64 = 9 // Name ueber 255
const R_NOTQUERY: u64 = 10
const R_BADNAME: u64 = 11

static mut L_RCODE: u64 = 0
static mut L_AN: u64 = 0
static mut L_CN: u64 = 0
static mut L_TTL: u64 = 0
static mut L_AA: u64 = 0
static mut L_TC: u64 = 0
static mut CUR: [u8; 264] = [0 as u8; 264]
static mut OWN: [u8; 264] = [0 as u8; 264]

fn rcode() -> u64 { return L_RCODE }
fn ancount() -> u64 { return L_AN }
fn cnames() -> u64 { return L_CN }
fn ttl() -> u64 { return L_TTL }
fn aa() -> u64 { return L_AA }
fn tc() -> u64 { return L_TC }

fn ld8(p: u64, i: u64) -> u64 {
    return __mmio_read8((p + i) as *mut u8) as u64
}

fn st8(p: u64, i: u64, v: u64) {
    __mmio_write8((p + i) as *mut u8, (v & 255) as u8)
}

fn ld16(p: u64, i: u64) -> u64 {
    return (ld8(p, i) << 8) | ld8(p, i + 1)
}

fn ld32(p: u64, i: u64) -> u64 {
    return (ld16(p, i) << 16) | ld16(p, i + 2)
}

fn lower(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

fn is_alpha(c: u64) -> bool {
    if c >= 65 && c <= 90 { return true }
    if c >= 97 && c <= 122 { return true }
    return false
}

fn slen(p: u64) -> u64 {
    var n: u64 = 0
    while ld8(p, n) != 0 {
        n = n + 1
    }
    return n
}

// ------------------------------------------------------- die Anfrage
fn q_build(buf: u64, cap: u64, txid: u64, name: u64, qtype: u64,
    rnd: u64) -> u64 {
    let nl: u64 = slen(name)
    if nl == 0 || nl > MAX_NAME {
        return 0
    }
    if cap < HDR + nl + 2 + 4 {
        return 0
    }
    st8(buf, 0, (txid >> 8) & 255)
    st8(buf, 1, txid & 255)
    st8(buf, 2, 1)
    st8(buf, 3, 0)
    st8(buf, 4, 0)
    st8(buf, 5, 1) // QDCOUNT = 1
    var i: u64 = 6
    while i < HDR {
        st8(buf, i, 0)
        i = i + 1
    }
    var at: u64 = HDR
    var pos: u64 = 0
    var letter: u64 = 0
    var ende: u64 = nl
    if ld8(name, ende - 1) == 46 {
        ende = ende - 1
    }
    if ende == 0 {
        return 0
    }
    while pos < ende {
        var e: u64 = pos
        while e < ende && ld8(name, e) != 46 {
            e = e + 1
        }
        let ll: u64 = e - pos
        if ll == 0 || ll > MAX_LABEL {
            return 0
        }
        st8(buf, at, ll)
        at = at + 1
        var k: u64 = 0
        while k < ll {
            var c: u64 = ld8(name, pos + k)
            if c < 33 || c > 126 {
                return 0
            }
            if is_alpha(c) {
                let bit: u64 = (ld8(rnd, (letter >> 3) & 31)
                    >> (letter & 7)) & 1
                if bit == 1 {
                    c = lower(c) - 32
                } else {
                    c = lower(c)
                }
                letter = letter + 1
            }
            st8(buf, at, c)
            at = at + 1
            k = k + 1
        }
        pos = e + 1
    }
    st8(buf, at, 0)
    at = at + 1
    st8(buf, at, (qtype >> 8) & 255)
    st8(buf, at + 1, qtype & 255)
    st8(buf, at + 2, 0)
    st8(buf, at + 3, C_IN & 255)
    at = at + 4
    if at > cap {
        return 0
    }
    return at
}

fn q_qlen(qlen: u64) -> u64 {
    if qlen < HDR {
        return 0
    }
    return qlen - HDR
}

// -------------------------------------------------------- die Namen

fn name_end(msg: u64, len: u64, at: u64) -> u64 {
    var i: u64 = at
    while i < len {
        let c: u64 = ld8(msg, i)
        if c == 0 {
            return i + 1
        }
        if (c & 192) == 192 {
            if i + 1 >= len {
                return 0
            }
            return i + 2
        }
        if (c & 192) != 0 {
            return 0
        }
        i = i + 1 + c
    }
    return 0
}

fn name_at(msg: u64, len: u64, at: u64, out: u64, outmax: u64) -> u64 {
    var i: u64 = at
    var n: u64 = 0
    var jumps: u64 = 0
    var limit: u64 = at
    while true {
        if i >= len {
            return 0
        }
        let c: u64 = ld8(msg, i)
        if c == 0 {
            if n == 0 {
                if outmax < 2 {
                    return 0
                }
                st8(out, 0, 46)
                st8(out, 1, 0)
                return 1
            }
            st8(out, n, 0)
            return n
        }
        if (c & 192) == 192 {
            if i + 1 >= len {
                return 0
            }
            let target: u64 = ((c & 63) << 8) | ld8(msg, i + 1)
            // SCHRANKE 1: strikt rueckwaerts.
            if target >= limit {
                return 0
            }
            jumps = jumps + 1
            if jumps > MAX_JUMPS {
                return 0
            }
            limit = target
            i = target
            continue
        }
        if (c & 192) != 0 {
            return 0
        }
        if i + 1 + c > len {
            return 0
        }
        if c > MAX_LABEL {
            return 0
        }
        if n + c + 2 > outmax || n + c + 1 > MAX_NAME {
            return 0
        }
        if n > 0 {
            st8(out, n, 46)
            n = n + 1
        }
        var k: u64 = 0
        while k < c {
            st8(out, n + k, lower(ld8(msg, i + 1 + k)))
            k = k + 1
        }
        n = n + c
        i = i + 1 + c
    }
    return 0
}

fn text_eq(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while true {
        let x: u64 = lower(ld8(a, i))
        let y: u64 = lower(ld8(b, i))
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

// A reply that matches our query in every octet EXCEPT the letter case of the
// question name (id equal, QR set, one question). Some NAT DNS proxies (seen:
// VirtualBox NAT in the Boss VM) rebuild the question in lower case, which
// the strict 0x20 check in `ans_check` rejects as a mismatch. The resolver
// uses this to decide that the server does not echo the case and to retry
// WITHOUT 0x20 (the same fallback Unbound uses). id, source port and server
// address are still checked.
fn case_only(msg: u64, len: u64, q: u64, qlen: u64) -> bool {
    if len < HDR || qlen < HDR + 5 {
        return false
    }
    if ld16(msg, 0) != ld16(q, 0) {
        return false
    }
    if (ld16(msg, 2) & 0x8000) == 0 || ld16(msg, 4) != 1 {
        return false
    }
    let ql: u64 = qlen - HDR
    if len < HDR + ql {
        return false
    }
    var i: u64 = 0
    while i < ql {
        if lower(ld8(msg, HDR + i)) != lower(ld8(q, HDR + i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// -------------------------------------------------------- die Antwort
fn ans_check(msg: u64, len: u64, q: u64, qlen: u64, want: u64,
    out: u64) -> u64 {
    L_RCODE = 0
    L_AN = 0
    L_CN = 0
    L_TTL = 0
    L_AA = 0
    L_TC = 0
    if len < HDR || qlen < HDR + 5 {
        return R_FORMAT
    }
    if ld16(msg, 0) != ld16(q, 0) {
        return R_MISMATCH // die Kennung
    }
    let fl: u64 = ld16(msg, 2)
    if (fl & 0x8000) == 0 {
        return R_NOTQUERY
    }
    if ((fl >> 11) & 15) != 0 {
        return R_NOTQUERY // fremder Opcode
    }
    if (fl & 0x0400) != 0 { L_AA = 1 }
    if (fl & 0x0200) != 0 { L_TC = 1 }
    L_RCODE = fl & 15
    if ld16(msg, 4) != 1 {
        return R_MISMATCH
    }
    let ql: u64 = qlen - HDR
    if len < HDR + ql {
        return R_MISMATCH
    }
    var i: u64 = 0
    while i < ql {
        if ld8(msg, HDR + i) != ld8(q, HDR + i) {
            return R_MISMATCH
        }
        i = i + 1
    }
    if L_TC == 1 {
        return R_TRUNC
    }
    if L_RCODE == 3 {
        return R_NXDOMAIN
    }
    if L_RCODE == 2 {
        return R_SERVFAIL
    }
    if L_RCODE == 5 {
        return R_REFUSED
    }
    if L_RCODE != 0 {
        return R_FORMAT
    }
    let an: u64 = ld16(msg, 6)
    L_AN = an
    if an == 0 {
        return R_NODATA
    }
    if name_at(q, qlen, HDR, (&CUR[0 as usize]) as u64, 264) == 0 {
        return R_BADNAME
    }
    var chase: u64 = 0
    while chase <= MAX_CHASE {
        var at: u64 = HDR + ql
        var k: u64 = 0
        var gefunden: bool = false
        var more: bool = false
        while k < an {
            let ne: u64 = name_end(msg, len, at)
            if ne == 0 {
                return R_FORMAT
            }
            if name_at(msg, len, at, (&OWN[0 as usize]) as u64, 264) == 0 {
                return R_LOOP
            }
            if ne + 10 > len {
                return R_FORMAT
            }
            let typ: u64 = ld16(msg, ne)
            let kls: u64 = ld16(msg, ne + 2)
            let t: u64 = ld32(msg, ne + 4)
            let rl: u64 = ld16(msg, ne + 8)
            let rd: u64 = ne + 10
            if rd + rl > len {
                return R_FORMAT
            }
            if kls == C_IN
                && text_eq((&OWN[0 as usize]) as u64,
                    (&CUR[0 as usize]) as u64) {
                if typ == want {
                    var need: u64 = 4
                    if want == T_AAAA {
                        need = 16
                    }
                    if rl != need {
                        return R_FORMAT
                    }
                    var m: u64 = 0
                    while m < need {
                        st8(out, m, ld8(msg, rd + m))
                        m = m + 1
                    }
                    L_TTL = t
                    gefunden = true
                    break
                }
                if typ == T_CNAME && want != T_CNAME {
                    if name_at(msg, len, rd, (&CUR[0 as usize]) as u64, 264)
                        == 0 {
                        return R_LOOP
                    }
                    L_CN = L_CN + 1
                    more = true
                    break
                }
            }
            at = ne + 10 + rl
            k = k + 1
        }
        if gefunden {
            return R_OK
        }
        if !more {
            return R_NODATA
        }
        chase = chase + 1
    }
    return R_LOOP
}
