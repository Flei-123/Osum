}

fn order_cleanup(arg: u64) -> u64 {
    locks.store((&x_order) as u64, locks.load((&x_order) as u64) * 10 + arg)
    return 0
}

fn exit_cleanup_body(arg: u64) -> u64 {
    pthread.cleanup_push(order_cleanup, 1)
    pthread.cleanup_push(order_cleanup, 2)
    pthread.cleanup_pop(false)
    pthread.cleanup_push(order_cleanup, 3)
    pthread.exit(33)
    return 0
}

fn noop_cleanup(arg: u64) -> u64 {
    return 0
}

fn quick_body(arg: u64) -> u64 {
    return 4
}

fn run_cancel_misc() -> bool {
    var ok: bool = true
    reset_flags()
    var old: u64 = 99
    if pthread.setcanceltype(pthread.CANCEL_ASYNCHRONOUS, 0) != errno.E_INVAL || pthread.setcanceltype(pthread.CANCEL_DEFERRED, (&old) as u64) != 0 || old != pthread.CANCEL_DEFERRED {
        ok = false
    }
    if pthread.setcancelstate(7, 0) != errno.E_INVAL {
        ok = false
    }
    var t: u64 = 0
    if pthread.create((&t) as u64, quick_body, 0) != 0 {
        return false
    }
    var waited: u64 = 0
    while !threads.is_done(t) && waited < 2000 {
        pause_ms(2)
        waited = waited + 1
    }
    var rv: u64 = 0
    if pthread.cancel(t) != 0 || pthread.join(t, (&rv) as u64) != 0 || rv != 4 {
        ok = false
    }
    var e: u64 = 0
    if pthread.create((&e) as u64, exit_cleanup_body, 0) != 0 {
        return false
    }
    if pthread.join(e, (&rv) as u64) != 0 || rv != 33 || locks.load((&x_order) as u64) != 31 {
        ok = false
    }
    if pthread.cleanup_pop(false) != errno.E_INVAL {
        ok = false
    }
    var k: u64 = 0
    while k < 8 {
        if pthread.cleanup_push(noop_cleanup, k) != 0 {
            ok = false
        }
        k = k + 1
    }
    if pthread.cleanup_push(noop_cleanup, 9) != errno.E_NOMEM {
        ok = false
    }
    k = 0
    while k < 8 {
        if pthread.cleanup_pop(false) != 0 {
            ok = false
        }
        k = k + 1
    }
    return ok
}

fn count_cleanup(arg: u64) -> u64 {
