fn disabled_body(arg: u64) -> u64 {
    var old: u64 = 99
    pthread.setcancelstate(pthread.CANCEL_DISABLE, (&old) as u64)
    locks.store((&x_ready) as u64, old + 1)
    pthread.sleep_ns(150 * MS)
    locks.store((&x_done) as u64, 1)
    pthread.setcancelstate(pthread.CANCEL_ENABLE, (&old) as u64)
    pthread.testcancel()
    locks.store((&x_after) as u64, 1)
    return 7
}

fn run_cancel_disabled() -> bool {
    var ok: bool = true
    reset_flags()
    var t: u64 = 0
