fn start_victim(body: fn(u64) -> u64, arg: u64) -> u64 {
    reset_flags()
    var t: u64 = 0
    if pthread.create((&t) as u64, body, arg) != 0 {
        return 0
    }
    if !probecount.wait_for((&x_flag) as u64, 1) {
        return 0
    }
    pause_ms(40)
    return t
}

fn reap_canceled(t: u64) -> bool {
    if t == 0 {
        return false
    }
    let t0: u64 = locks.now_ns()
    var ok: bool = pthread.cancel(t) == 0
    var rv: u64 = 0
    if pthread.join(t, (&rv) as u64) != 0 || rv != pthread.CANCELED || locks.now_ns() - t0 > 1500 * MS {
        ok = false
    }
    return ok && locks.load((&x_cleaned) as u64) == 1 && locks.load((&x_after) as u64) == 0
}

fn sem_victim(arg: u64) -> u64 {
    pthread.cleanup_push(count_cleanup, 0)
    locks.store((&x_flag) as u64, 1)
    if arg == 0 {
        semaphore.wait(sem_addr())
    } else {
        semaphore.timed_wait(sem_addr(), 5000 * MS)
    }
    locks.store((&x_after) as u64, 1)
    return 7
}

fn run_cancel_sem() -> bool {
    var ok: bool = true
    var mode: u64 = 0
    while mode < 2 {
        semaphore.init(sem_addr(), 0)
        let t: u64 = start_victim(sem_victim, mode)
        if semaphore.waiters(sem_addr()) != 1 {
            ok = false
        }
        if !reap_canceled(t) {
            ok = false
        }
        if semaphore.waiters(sem_addr()) != 0 || semaphore.value(sem_addr()) != 0 {
            ok = false
        }
        if !semaphore.post(sem_addr()) || !semaphore.try_wait(sem_addr()) {
            ok = false
        }
        mode = mode + 1
    }
    return ok
}

fn rw_victim(arg: u64) -> u64 {
    pthread.cleanup_push(count_cleanup, 0)
    locks.store((&x_flag) as u64, 1)
    if arg == 0 {
        rwlock.rdlock(rwc_addr())
    } else {
        if arg == 1 {
            rwlock.wrlock(rwc_addr())
        } else {
            if arg == 2 {
                rwlock.timedrdlock(rwc_addr(), 5000 * MS)
            } else {
                rwlock.timedwrlock(rwc_addr(), 5000 * MS)
            }
        }
    }
    locks.store((&x_after) as u64, 1)
    return 7
}

fn late_reader_body(arg: u64) -> u64 {
    if rwlock.timedrdlock(rwc_addr(), 2000 * MS) == 0 {
        locks.store((&x_done) as u64, 1)
        rwlock.unlock(rwc_addr())
    } else {
