// SPDX-License-Identifier: MIT
export {
    ld8, st8, ld16, ld32, ld64, st16, st32, st64,
    ld16_be, ld32_be, ld64_be, st16_be, st32_be, st64_be, zero, load_byte, store_byte, ld8_idx, st8_idx, ld32_idx,
    le16, le32, le64, put16, put32, copy, cstr_len
}

fn ld8(p: u64, i: u64) -> u64 {
    return (*((p + i) as *mut u8)) as u64
}

fn st8(p: u64, i: u64, v: u64) {
    *((p + i) as *mut u8) = (v & 255) as u8
}

fn ld16(p: u64, i: u64) -> u64 {
    return ld8(p, i) | (ld8(p, i + 1) << 8)
}

fn ld32(p: u64, i: u64) -> u64 {
    return ld16(p, i) | (ld16(p, i + 2) << 16)
}

fn ld64(p: u64, i: u64) -> u64 {
    return ld32(p, i) | (ld32(p, i + 4) << 32)
}

fn st16(p: u64, i: u64, v: u64) {
    st8(p, i, v)
    st8(p, i + 1, v >> 8)
}

fn st32(p: u64, i: u64, v: u64) {
    st16(p, i, v)
    st16(p, i + 2, v >> 16)
}

fn st64(p: u64, i: u64, v: u64) {
    st32(p, i, v)
    st32(p, i + 4, v >> 32)
}

fn ld16_be(p: u64, i: u64) -> u64 {
    return (ld8(p, i) << 8) | ld8(p, i + 1)
}

fn ld32_be(p: u64, i: u64) -> u64 {
    return (ld16_be(p, i) << 16) | ld16_be(p, i + 2)
}

fn ld64_be(p: u64, i: u64) -> u64 {
    return (ld32_be(p, i) << 32) | ld32_be(p, i + 4)
}

fn st16_be(p: u64, i: u64, v: u64) {
    st8(p, i, v >> 8)
    st8(p, i + 1, v)
}

fn st32_be(p: u64, i: u64, v: u64) {
    st16_be(p, i, v >> 16)
    st16_be(p, i + 2, v)
}

fn st64_be(p: u64, i: u64, v: u64) {
    st32_be(p, i, v >> 32)
    st32_be(p, i + 4, v)
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        st8(p, i, 0)
        i = i + 1
    }
}

fn load_byte(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn store_byte(p: u64, i: usize, v: u8) {
    *((p + i as u64) as *mut u8) = v
}

fn ld8_idx(p: u64, i: usize) -> u64 {
    let b: u8 = *((p + i as u64) as *mut u8)
    return b as u64
}

fn st8_idx(p: u64, i: usize, v: u64) {
    *((p + i as u64) as *mut u8) = (v & 255) as u8
}

fn ld32_idx(p: u64, i: usize) -> u64 {
    return ld8_idx(p, i) | (ld8_idx(p, i + 1) << 8) | (ld8_idx(p, i + 2) << 16) | (ld8_idx(p, i + 3) << 24)
}

fn le16(p: u64) -> u64 {
    return ld8(p, 0) | (ld8(p, 1) << 8)
}

fn le32(p: u64) -> u64 {
    return le16(p) | (le16(p + 2) << 16)
}

fn le64(p: u64) -> u64 {
    return le32(p) | (le32(p + 4) << 32)
}

fn put16(p: u64, v: u64) {
    st8(p, 0, v)
    st8(p, 1, v >> 8)
}

fn put32(p: u64, v: u64) {
    put16(p, v & 0xFFFF)
    put16(p + 2, (v >> 16) & 0xFFFF)
}

fn copy(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        st8(dst, i, ld8(src, i))
        i = i + 1
    }
}

fn cstr_len(p: u64) -> u64 {
    var n: u64 = 0
    while ld8(p, n) != 0 {
        n = n + 1
    }
    return n
}
