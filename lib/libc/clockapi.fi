import libc.kcall
import libc.clockabi
import libc.errno

export { clock_is_trusted, ticks, uptime_sec, sleep_ms, TICK_MS }

const BAD_RESULT: u64 = 0xFFFFFFFFFFFFF000
const INFO_TICKS: u64 = 0
const INFO_UPTIME: u64 = 1
const TICK_MS: u64 = 10

static mut STAMP: [u8; 16] = [0 as u8; 16]

fn clock_is_trusted() -> bool {
    return kcall.sys2(kcall.SYS_CLOCK_GETTIME, clockabi.CLOCK_CHECKED, (&STAMP[0 as usize]) as u64) <= BAD_RESULT
}

fn ticks() -> u64 {
    return kcall.sys3(kcall.SYS_OSUM_SYSINFO, INFO_TICKS, 0, 0)
}

fn uptime_sec() -> u64 {
    return kcall.sys3(kcall.SYS_OSUM_SYSINFO, INFO_UPTIME, 0, 0)
}

fn sleep_ms(ms: u64) -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    ts[0] = ms / 1000
    ts[1] = (ms % 1000) * 1000000
    return errno.check(kcall.sys2(kcall.SYS_NANOSLEEP, (&ts[0]) as u64, 0))
}
