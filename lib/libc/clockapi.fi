import libc.kcall
import ntp.abi

export { clock_is_trusted }

const BAD_RESULT: u64 = 0xFFFFFFFFFFFFF000

static mut STAMP: [u8; 16] = [0 as u8; 16]

fn clock_is_trusted() -> bool {
    return kcall.sys2(kcall.SYS_CLOCK_GETTIME, abi.CLOCK_CHECKED, (&STAMP[0 as usize]) as u64) <= BAD_RESULT
}
