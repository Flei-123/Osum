// SPDX-License-Identifier: MIT
import libc.threads
import libc.locks
import libc.probecount
import libc.semaphore
import libc.once
import libc.errno

export { run_all, passed_count, failed_total }

const MS: u64 = 1000000
const SEM_WAITERS: u64 = 3
const PC_ITEMS: u64 = 400
const ONCE_CALLERS: u64 = 6
const BIN_WORKERS: u64 = 4
const BIN_ROUNDS: u64 = 1500

static mut word: u64 = 0
static mut cv_word: u64 = 0
static mut cv_mutex: u64 = 0
static mut cv_signaled: u64 = 0
static mut hold_mutex: u64 = 0
static mut hold_flag: u64 = 0
static mut sem_a: u64 = 0
static mut sem_b: u64 = 0
static mut sem_done: u64 = 0
static mut wake_stamp: u64 = 0
static mut post_stamp: u64 = 0
static mut pc_sem: u64 = 0
static mut pc_taken: u64 = 0
static mut bin_sem: u64 = 0
static mut bin_total: u64 = 0
static mut once_word: u64 = 0
static mut once_runs: u64 = 0
static mut once_won: u64 = 0
static mut once_seen_early: u64 = 0
static mut once_value: u64 = 0

fn check(ok: bool) {
    probecount.record(ok)
}

fn pause_ms(ms: u64) {
    threads.sleep_ms(ms)
}

fn run_futex_timeout() -> bool {
    var ok: bool = true
    locks.store((&word) as u64, 5)
    let t0: u64 = locks.now_ns()
    let r: u64 = locks.futex_wait_ns((&word) as u64, 5, 50 * MS)
    let spent: u64 = locks.now_ns() - t0
    if !locks.timed_out(r) || spent < 40 * MS || spent > 900 * MS {
        ok = false
    }
    let r2: u64 = locks.futex_wait_ns((&word) as u64, 6, 50 * MS)
    if r2 != 0 -% errno.E_AGAIN {
        ok = false
    }
    let t1: u64 = locks.now_ns()
    let r3: u64 = locks.futex_wait_ns((&word) as u64, 5, 0)
    if !locks.timed_out(r3) || locks.now_ns() - t1 > 400 * MS {
        ok = false
    }
    return ok
}

fn cv_timed_waiter(arg: u64) -> u64 {
    locks.mutex_take((&cv_mutex) as u64)
    locks.store((&cv_signaled) as u64, 1)
    let r: u64 = locks.cond_timedwait((&cv_word) as u64, (&cv_mutex) as u64, 5000 * MS)
    locks.mutex_give((&cv_mutex) as u64)
    return r + 1
}

fn run_cond_timedwait() -> bool {
    var ok: bool = true
    locks.mutex_take((&cv_mutex) as u64)
    let t0: u64 = locks.now_ns()
    let r: u64 = locks.cond_timedwait((&cv_word) as u64, (&cv_mutex) as u64, 60 * MS)
    let spent: u64 = locks.now_ns() - t0
    if r != errno.E_TIMEDOUT || spent < 45 * MS || spent > 900 * MS {
        ok = false
    }
    if locks.mutex_try((&cv_mutex) as u64) {
        ok = false
    }
    locks.mutex_give((&cv_mutex) as u64)

    locks.store((&cv_signaled) as u64, 0)
    let h: u64 = threads.spawn(cv_timed_waiter, 0)
    if h == 0 {
        return false
    }
    var waited: u64 = 0
    while locks.load((&cv_signaled) as u64) == 0 && waited < 3000 {
        pause_ms(1)
        waited = waited + 1
    }
    pause_ms(40)
    locks.mutex_take((&cv_mutex) as u64)
    locks.cond_signal((&cv_word) as u64)
    locks.mutex_give((&cv_mutex) as u64)
    let t1: u64 = locks.now_ns()
    let got: u64 = threads.join(h)
    if got != 1 || locks.now_ns() - t1 > 1500 * MS {
        ok = false
    }
    return ok
}

fn holder(arg: u64) -> u64 {
    locks.mutex_take((&hold_mutex) as u64)
    locks.store((&hold_flag) as u64, 1)
    pause_ms(arg)
    locks.mutex_give((&hold_mutex) as u64)
    return 1
}

fn run_mutex_timedlock() -> bool {
    var ok: bool = true
    if locks.mutex_timedlock((&hold_mutex) as u64, 10 * MS) != 0 {
        ok = false
    }
    locks.mutex_give((&hold_mutex) as u64)
    locks.store((&hold_flag) as u64, 0)
    let h: u64 = threads.spawn(holder, 250)
    if h == 0 {
        return false
    }
    var waited: u64 = 0
    while locks.load((&hold_flag) as u64) == 0 && waited < 3000 {
        pause_ms(1)
        waited = waited + 1
    }
    let t0: u64 = locks.now_ns()
    let r: u64 = locks.mutex_timedlock((&hold_mutex) as u64, 50 * MS)
    let spent: u64 = locks.now_ns() - t0
    if r != errno.E_TIMEDOUT || spent < 40 * MS || spent > 220 * MS {
        ok = false
    }
    let t1: u64 = locks.now_ns()
    if locks.mutex_timedlock((&hold_mutex) as u64, 5000 * MS) != 0 {
        ok = false
    }
    if locks.now_ns() - t1 > 2000 * MS {
        ok = false
    }
    locks.mutex_give((&hold_mutex) as u64)
    threads.join(h)
    return ok
}

fn sem_waiter(arg: u64) -> u64 {
    semaphore.wait((&sem_a) as u64)
    locks.fetch_add((&sem_done) as u64, 1)
    return arg + 1
}

fn sem_stamper(arg: u64) -> u64 {
    semaphore.wait((&sem_b) as u64)
    locks.store((&wake_stamp) as u64, locks.now_ns())
    return 1
}

fn run_semaphore_basic() -> bool {
    var ok: bool = true
    semaphore.init((&sem_a) as u64, 0)
    if semaphore.try_wait((&sem_a) as u64) || semaphore.value((&sem_a) as u64) != 0 {
        ok = false
    }
    var handles: [u64; 3] = [0; 3]
    var k: u64 = 0
    while k < SEM_WAITERS {
        handles[k as usize] = threads.spawn(sem_waiter, k)
        if handles[k as usize] == 0 {
            return false
        }
        k = k + 1
    }
    var waited: u64 = 0
    while semaphore.waiters((&sem_a) as u64) < SEM_WAITERS && waited < 3000 {
        pause_ms(1)
        waited = waited + 1
    }
    pause_ms(30)
    if locks.load((&sem_done) as u64) != 0 || semaphore.waiters((&sem_a) as u64) != SEM_WAITERS {
        ok = false
    }
    k = 0
    while k < SEM_WAITERS {
        if !semaphore.post((&sem_a) as u64) {
            ok = false
        }
        k = k + 1
    }
    var total: u64 = 0
    k = 0
    while k < SEM_WAITERS {
        total = total + threads.join(handles[k as usize])
        k = k + 1
    }
    if total != 6 || locks.load((&sem_done) as u64) != SEM_WAITERS {
        ok = false
    }
    if semaphore.value((&sem_a) as u64) != 0 || semaphore.waiters((&sem_a) as u64) != 0 {
        ok = false
    }
    semaphore.init((&sem_a) as u64, 2)
    if !semaphore.try_wait((&sem_a) as u64) || !semaphore.try_wait((&sem_a) as u64) || semaphore.try_wait((&sem_a) as u64) {
        ok = false
    }
    return ok
}

fn run_semaphore_timed() -> bool {
    var ok: bool = true
    semaphore.init((&sem_a) as u64, 0)
    let t0: u64 = locks.now_ns()
    let r: u64 = semaphore.timed_wait((&sem_a) as u64, 60 * MS)
    let spent: u64 = locks.now_ns() - t0
    if r != errno.E_TIMEDOUT || spent < 45 * MS || spent > 900 * MS {
        ok = false
    }
    if semaphore.waiters((&sem_a) as u64) != 0 || semaphore.value((&sem_a) as u64) != 0 {
        ok = false
    }
    semaphore.post((&sem_a) as u64)
    if semaphore.timed_wait((&sem_a) as u64, 60 * MS) != 0 {
        ok = false
    }
    return ok
}

fn run_semaphore_wake() -> bool {
    semaphore.init((&sem_b) as u64, 0)
    locks.store((&wake_stamp) as u64, 0)
    let h: u64 = threads.spawn(sem_stamper, 0)
    if h == 0 {
        return false
    }
    var waited: u64 = 0
    while semaphore.waiters((&sem_b) as u64) < 1 && waited < 3000 {
        pause_ms(1)
        waited = waited + 1
    }
    pause_ms(40)
    let t0: u64 = locks.now_ns()
    semaphore.post((&sem_b) as u64)
    threads.join(h)
    let stamp: u64 = locks.load((&wake_stamp) as u64)
    return stamp >= t0 && stamp - t0 < 500 * MS
}

fn pc_consumer(arg: u64) -> u64 {
    var i: u64 = 0
    while i < PC_ITEMS / 2 {
        semaphore.wait((&pc_sem) as u64)
        locks.fetch_add((&pc_taken) as u64, 1)
        i = i + 1
    }
    return 1
}

fn run_semaphore_producer_consumer() -> bool {
    semaphore.init((&pc_sem) as u64, 0)
    locks.store((&pc_taken) as u64, 0)
    let a: u64 = threads.spawn(pc_consumer, 0)
    let b: u64 = threads.spawn(pc_consumer, 1)
    if a == 0 || b == 0 {
        return false
    }
    var i: u64 = 0
    while i < PC_ITEMS {
        semaphore.post((&pc_sem) as u64)
        if i % 16 == 0 {
            threads.yield_now()
        }
        i = i + 1
    }
    let total: u64 = threads.join(a) + threads.join(b)
    return total == 2 && locks.load((&pc_taken) as u64) == PC_ITEMS && semaphore.value((&pc_sem) as u64) == 0 && semaphore.waiters((&pc_sem) as u64) == 0
}

fn bin_worker(arg: u64) -> u64 {
    var i: u64 = 0
    while i < BIN_ROUNDS {
        semaphore.wait((&bin_sem) as u64)
        let v: u64 = bin_total
        if i % 4 == 0 {
            threads.yield_now()
        }
        bin_total = v + 1
        semaphore.post((&bin_sem) as u64)
        i = i + 1
    }
    return 1
}

fn run_semaphore_exclusion() -> bool {
    semaphore.init((&bin_sem) as u64, 1)
    bin_total = 0
    var handles: [u64; 4] = [0; 4]
    var k: u64 = 0
    while k < BIN_WORKERS {
        handles[k as usize] = threads.spawn(bin_worker, k)
        if handles[k as usize] == 0 {
            return false
        }
        k = k + 1
    }
    var sum: u64 = 0
    k = 0
    while k < BIN_WORKERS {
        sum = sum + threads.join(handles[k as usize])
        k = k + 1
    }
    return sum == BIN_WORKERS && bin_total == BIN_WORKERS * BIN_ROUNDS
}

fn once_body(arg: u64) -> u64 {
    locks.fetch_add((&once_runs) as u64, 1)
    pause_ms(40)
    locks.store((&once_value) as u64, arg)
    return 0
}

fn once_caller(arg: u64) -> u64 {
    if once.call((&once_word) as u64, once_body, 77) {
        locks.fetch_add((&once_won) as u64, 1)
    }
    if locks.load((&once_value) as u64) != 77 {
        locks.fetch_add((&once_seen_early) as u64, 1)
    }
    return 1
}

fn run_once() -> bool {
    locks.store((&once_word) as u64, 0)
    var handles: [u64; 6] = [0; 6]
    var k: u64 = 0
    while k < ONCE_CALLERS {
        handles[k as usize] = threads.spawn(once_caller, k)
        if handles[k as usize] == 0 {
            return false
        }
        k = k + 1
    }
    var sum: u64 = 0
    k = 0
    while k < ONCE_CALLERS {
        sum = sum + threads.join(handles[k as usize])
        k = k + 1
    }
    if once.call((&once_word) as u64, once_body, 99) {
        return false
    }
    return sum == ONCE_CALLERS
        && locks.load((&once_runs) as u64) == 1
        && locks.load((&once_won) as u64) == 1
        && locks.load((&once_seen_early) as u64) == 0
        && once.is_done((&once_word) as u64)
        && locks.load((&once_value) as u64) == 77
}

fn run_all() -> u64 {
    check(run_futex_timeout())
    check(run_cond_timedwait())
    check(run_mutex_timedlock())
    check(run_semaphore_basic())
    check(run_semaphore_timed())
    check(run_semaphore_wake())
    check(run_semaphore_producer_consumer())
    check(run_semaphore_exclusion())
    check(run_once())
    return probecount.failed()
}

fn passed_count() -> u64 {
    return probecount.passed()
}

fn failed_total() -> u64 {
    return probecount.failed()
}
