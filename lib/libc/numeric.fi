// SPDX-License-Identifier: MIT
export { imin, imax, umin, umax, iclamp, uclamp, iabs, yes }

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn umin(a: u64, b: u64) -> u64 {
    if a < b {
        return a
    }
    return b
}

fn umax(a: u64, b: u64) -> u64 {
    if a > b {
        return a
    }
    return b
}

fn iclamp(v: i64, lo: i64, hi: i64) -> i64 {
    return imin(imax(v, lo), hi)
}

fn uclamp(v: u64, lo: u64, hi: u64) -> u64 {
    return umin(umax(v, lo), hi)
}

fn iabs(v: i64) -> i64 {
    if v < 0 {
        return 0 - v
    }
    return v
}

fn yes(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}
