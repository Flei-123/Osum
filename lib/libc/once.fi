import libc.locks

export { call, is_done }

const STATE_RUNNING: u64 = 1
const STATE_DONE: u64 = 2

fn is_done(p: u64) -> bool {
    return locks.load(p) == STATE_DONE
}

fn call(p: u64, body: fn(u64) -> u64, arg: u64) -> bool {
    if is_done(p) {
        return false
    }
    if locks.cas(p, 0, STATE_RUNNING) == 0 {
        body(arg)
        locks.store(p, STATE_DONE)
        locks.futex_wake(p, locks.WAKE_ALL)
        return true
    }
    while !is_done(p) {
        locks.futex_wait(p, STATE_RUNNING)
    }
    return false
}
