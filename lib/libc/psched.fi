// SPDX-License-Identifier: MIT
import libc.kcall
import libc.errno
import libc.threads
import libc.octets

export { CLOCK_THREAD_CPUTIME, get_priority_min, get_priority_max, getaffinity, setaffinity, getcpu, thread_getschedparam, thread_setschedparam, thread_cpuclock }

const CLOCK_THREAD_CPUTIME: u64 = 3

fn failure(r: u64) -> u64 {
    if errno.is_error(r) {
        return 0 -% r
    }
    return 0
}

fn tid_of(t: u64) -> u64 {
    if t == 0 {
        return threads.self_id()
    }
    return threads.thread_id(t)
}

fn get_priority_min(policy: u64) -> u64 {
    return kcall.sys1(kcall.SYS_SCHED_GET_PRIORITY_MIN, policy)
}

fn get_priority_max(policy: u64) -> u64 {
    return kcall.sys1(kcall.SYS_SCHED_GET_PRIORITY_MAX, policy)
}

fn getaffinity(pid: u64, size: u64, mask: u64) -> u64 {
    return failure(kcall.sys3(kcall.SYS_SCHED_GETAFFINITY, pid, size, mask))
}

fn setaffinity(pid: u64, size: u64, mask: u64) -> u64 {
    return failure(kcall.sys3(kcall.SYS_SCHED_SETAFFINITY, pid, size, mask))
}

fn getcpu() -> u64 {
    var cpu: u64 = 0
    let r: u64 = kcall.sys3(kcall.SYS_GETCPU, (&cpu) as u64, 0, 0)
    if errno.is_error(r) {
        return 0
    }
    return cpu & 0xFFFFFFFF
}

fn thread_getschedparam(t: u64, policy_out: u64, param_out: u64) -> u64 {
    if t != 0 && threads.is_done(t) {
        return errno.E_SRCH
    }
    let tid: u64 = tid_of(t)
    let policy: u64 = kcall.sys1(kcall.SYS_SCHED_GETSCHEDULER, tid)
    if errno.is_error(policy) {
        return 0 -% policy
    }
    let r: u64 = failure(kcall.sys2(kcall.SYS_SCHED_GETPARAM, tid, param_out))
    if r != 0 {
        return r
    }
    octets.st32(policy_out, 0, policy)
    return 0
}

fn thread_setschedparam(t: u64, policy: u64, param: u64) -> u64 {
    if t != 0 && threads.is_done(t) {
        return errno.E_SRCH
    }
    return failure(kcall.sys3(kcall.SYS_SCHED_SETSCHEDULER, tid_of(t), policy, param))
}

fn thread_cpuclock(t: u64, out: u64) -> u64 {
    if t != 0 && threads.is_done(t) {
        return errno.E_SRCH
    }
    octets.st32(out, 0, CLOCK_THREAD_CPUTIME)
    return 0
}
