import libc.threads
import libc.locks
import libc.semaphore
import libc.once
import libc.pmutex
import libc.pcond
import libc.pcancel
import libc.pattr
import libc.rwlock
import libc.barrier
import libc.errno
import libc.octets

export { BARRIER_SERIAL_THREAD, CANCELED, KEYS_MAX, MUTEX_NORMAL, MUTEX_RECURSIVE, MUTEX_ERRORCHECK, CREATE_JOINABLE, CREATE_DETACHED, CANCEL_ENABLE, CANCEL_DISABLE, CANCEL_DEFERRED, CANCEL_ASYNCHRONOUS,
    create, create_attr, join, detach, self, equal, exit, yield_now, sleep_ns,
    attr_init, attr_destroy, attr_setstacksize, attr_getstacksize, attr_setdetachstate, attr_getdetachstate,
    mutexattr_init, mutexattr_destroy, mutexattr_settype, mutexattr_gettype, mutex_init_attr,
    cancel, setcancelstate, setcanceltype, testcancel, cleanup_push, cleanup_pop,
    mutex_init, mutex_destroy, mutex_lock, mutex_trylock, mutex_timedlock, mutex_unlock,
    cond_init, cond_destroy, cond_wait, cond_timedwait, cond_signal, cond_broadcast,
    key_create, key_delete, setspecific, getspecific, once_call,
    rwlock_init, rwlock_destroy, rwlock_rdlock, rwlock_wrlock, rwlock_tryrdlock, rwlock_trywrlock,
    rwlock_timedrdlock, rwlock_timedwrlock, rwlock_unlock,
    barrier_init, barrier_destroy, barrier_wait }

const BARRIER_SERIAL_THREAD: u64 = 0xFFFFFFFFFFFFFFFF
const KEYS_MAX: u64 = 56
const CANCELED: u64 = 0xFFFFFFFFFFFFFFFF
const MUTEX_NORMAL: u64 = 0
const MUTEX_RECURSIVE: u64 = 1
const MUTEX_ERRORCHECK: u64 = 2
const CREATE_JOINABLE: u64 = 0
const CREATE_DETACHED: u64 = 1
const CANCEL_ENABLE: u64 = 0
const CANCEL_DISABLE: u64 = 1
const CANCEL_DEFERRED: u64 = 0
const CANCEL_ASYNCHRONOUS: u64 = 1

fn store_out(out: u64, value: u64) {
    if out != 0 {
        octets.st64(out, 0, value)
    }
}

fn create(out: u64, body: fn(u64) -> u64, arg: u64) -> u64 {
    let handle: u64 = threads.spawn(body, arg)
    if handle == 0 {
        return errno.E_AGAIN
    }
    store_out(out, handle)
    return 0
}

fn create_attr(out: u64, attr: u64, body: fn(u64) -> u64, arg: u64) -> u64 {
    var stack: u64 = threads.STACK_DEFAULT
    var detached: bool = false
    if attr != 0 {
        var state: u64 = 0
        pattr.thread_getstacksize(attr, (&stack) as u64)
        pattr.thread_getdetachstate(attr, (&state) as u64)
        detached = state == pattr.CREATE_DETACHED
    }
    let handle: u64 = threads.spawn_sized(body, arg, stack)
    if handle == 0 {
        return errno.E_AGAIN
    }
    store_out(out, handle)
    if detached {
        threads.detach(handle)
    }
    return 0
}

fn join(t: u64, retval_out: u64) -> u64 {
    if t == 0 {
        return errno.E_INVAL
    }
    if t == threads.current() {
        return errno.E_DEADLK
    }
    if threads.is_detached(t) {
        return errno.E_INVAL
    }
    store_out(retval_out, pcancel.join(t))
    return 0
}

fn detach(t: u64) -> u64 {
    if t == 0 {
        return errno.E_SRCH
    }
    if threads.detach(t) != 0 {
        return errno.E_INVAL
    }
    return 0
}

fn self() -> u64 {
    return threads.current()
}

fn equal(a: u64, b: u64) -> bool {
    return a == b
}

fn exit(retval: u64) {
    pcancel.run_cleanups()
    threads.thread_exit(retval)
}

fn sleep_ns(ns: u64) -> u64 {
    return pcancel.sleep_ns(ns)
}

fn attr_init(a: u64) -> u64 {
    return pattr.thread_init(a)
}

fn attr_destroy(a: u64) -> u64 {
    return pattr.thread_destroy(a)
}

fn attr_setstacksize(a: u64, bytes: u64) -> u64 {
    return pattr.thread_setstacksize(a, bytes)
}

fn attr_getstacksize(a: u64, out: u64) -> u64 {
    return pattr.thread_getstacksize(a, out)
}

fn attr_setdetachstate(a: u64, state: u64) -> u64 {
    return pattr.thread_setdetachstate(a, state)
}

fn attr_getdetachstate(a: u64, out: u64) -> u64 {
    return pattr.thread_getdetachstate(a, out)
}

fn mutexattr_init(a: u64) -> u64 {
    return pattr.mutex_init(a)
}

fn mutexattr_destroy(a: u64) -> u64 {
    return pattr.mutex_destroy(a)
}

fn mutexattr_settype(a: u64, kind: u64) -> u64 {
    return pattr.mutex_settype(a, kind)
}

fn mutexattr_gettype(a: u64, out: u64) -> u64 {
    return pattr.mutex_gettype(a, out)
}

fn cancel(t: u64) -> u64 {
    return pcancel.request(t)
}

fn setcancelstate(state: u64, old_out: u64) -> u64 {
    return pcancel.setstate(state, old_out)
}

fn setcanceltype(kind: u64, old_out: u64) -> u64 {
    return pcancel.settype(kind, old_out)
}

fn testcancel() {
    pcancel.testcancel()
}

fn cleanup_push(body: fn(u64) -> u64, arg: u64) -> u64 {
    return pcancel.cleanup_push(body as u64, arg)
}

fn cleanup_pop(run: bool) -> u64 {
    return pcancel.cleanup_pop(run)
}

fn yield_now() -> u64 {
    threads.yield_now()
    return 0
}

fn mutex_init(m: u64) -> u64 {
    return pmutex.init(m, pmutex.KIND_NORMAL)
}

fn mutex_init_attr(m: u64, attr: u64) -> u64 {
    if attr == 0 {
        return pmutex.init(m, pmutex.KIND_NORMAL)
    }
    var kind: u64 = 0
    pattr.mutex_gettype(attr, (&kind) as u64)
    return pmutex.init(m, kind)
}

fn mutex_destroy(m: u64) -> u64 {
    return pmutex.destroy(m)
}

fn mutex_lock(m: u64) -> u64 {
    return pmutex.lock(m)
}

fn mutex_trylock(m: u64) -> u64 {
    return pmutex.trylock(m)
}

fn mutex_timedlock(m: u64, deadline_ns: u64) -> u64 {
    return pmutex.timedlock(m, locks.remaining(deadline_ns))
}

fn mutex_unlock(m: u64) -> u64 {
    return pmutex.unlock(m)
}

fn cond_init(cv: u64) -> u64 {
    locks.store(cv, 0)
    return 0
}

fn cond_destroy(cv: u64) -> u64 {
    return 0
}

fn cond_wait(cv: u64, m: u64) -> u64 {
    return pcond.wait(cv, m)
}

fn cond_timedwait(cv: u64, m: u64, deadline_ns: u64) -> u64 {
    return pcond.timedwait(cv, m, deadline_ns)
}

fn cond_signal(cv: u64) -> u64 {
    locks.cond_signal(cv)
    return 0
}

fn cond_broadcast(cv: u64) -> u64 {
    locks.cond_broadcast(cv)
    return 0
}

fn key_create(out: u64, destructor: u64) -> u64 {
    var key: u64 = 0
    if destructor == 0 {
        key = threads.key_create_plain()
    } else {
        key = threads.key_create(destructor as fn(u64) -> u64)
    }
    if key == 0 {
        return errno.E_AGAIN
    }
    store_out(out, key)
    return 0
}

fn key_delete(key: u64) -> u64 {
    if threads.key_delete(key) != 0 {
        return errno.E_INVAL
    }
    return 0
}

fn setspecific(key: u64, value: u64) -> u64 {
    if threads.key_set(key, value) != 0 {
        return errno.E_INVAL
    }
    return 0
}

fn getspecific(key: u64) -> u64 {
    return threads.key_get(key)
}

fn once_call(control: u64, body: fn(u64) -> u64, arg: u64) -> u64 {
    once.call(control, body, arg)
    return 0
}

fn rwlock_init(l: u64) -> u64 {
    rwlock.init(l)
    return 0
}

fn rwlock_destroy(l: u64) -> u64 {
    if locks.load(l) != 0 {
        return errno.E_BUSY
    }
    return 0
}

fn rwlock_rdlock(l: u64) -> u64 {
    rwlock.rdlock(l)
    return 0
}

fn rwlock_wrlock(l: u64) -> u64 {
    rwlock.wrlock(l)
    return 0
}

fn rwlock_tryrdlock(l: u64) -> u64 {
    if rwlock.tryrdlock(l) {
        return 0
    }
    return errno.E_BUSY
}

fn rwlock_trywrlock(l: u64) -> u64 {
    if rwlock.trywrlock(l) {
        return 0
    }
    return errno.E_BUSY
}

fn rwlock_timedrdlock(l: u64, deadline_ns: u64) -> u64 {
    return rwlock.timedrdlock(l, locks.remaining(deadline_ns))
}

fn rwlock_timedwrlock(l: u64, deadline_ns: u64) -> u64 {
    return rwlock.timedwrlock(l, locks.remaining(deadline_ns))
}

fn rwlock_unlock(l: u64) -> u64 {
    return rwlock.unlock(l)
}

fn barrier_init(b: u64, threshold: u64) -> u64 {
    return barrier.init(b, threshold)
}

fn barrier_destroy(b: u64) -> u64 {
    return barrier.destroy(b)
}

fn barrier_wait(b: u64) -> u64 {
    let r: u64 = barrier.wait(b)
    if r == barrier.SERIAL {
        return BARRIER_SERIAL_THREAD
    }
    if r == barrier.DESTROYED {
        return errno.E_INVAL
    }
    return 0
}
