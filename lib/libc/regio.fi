// SPDX-License-Identifier: MIT
export {
    read8, read16, read32, read64, write8, write16, write32, write64,
    read8_at, read16_at, read32_at, read64_at, write8_at, write32_at, write64_at
}

fn read8(a: u64) -> u64 {
    return __mmio_read8(a as *mut u8) as u64
}

fn read16(a: u64) -> u64 {
    return __mmio_read16(a as *mut u16) as u64
}

fn read32(a: u64) -> u64 {
    return __mmio_read32(a as *mut u32) as u64
}

fn read64(a: u64) -> u64 {
    return __mmio_read64(a as *mut u64)
}

fn write8(a: u64, v: u64) {
    __mmio_write8(a as *mut u8, v as u8)
}

fn write16(a: u64, v: u64) {
    __mmio_write16(a as *mut u16, v as u16)
}

fn write32(a: u64, v: u64) {
    __mmio_write32(a as *mut u32, v as u32)
}

fn write64(a: u64, v: u64) {
    __mmio_write64(a as *mut u64, v)
}

fn read8_at(p: u64, o: u64) -> u64 {
    return __mmio_read8((p + o) as *mut u8) as u64
}

fn read16_at(p: u64, o: u64) -> u64 {
    return __mmio_read16((p + o) as *mut u16) as u64
}

fn read32_at(p: u64, o: u64) -> u64 {
    return __mmio_read32((p + o) as *mut u32) as u64
}

fn read64_at(p: u64, o: u64) -> u64 {
    return __mmio_read64((p + o) as *mut u64)
}

fn write8_at(p: u64, o: u64, v: u64) {
    __mmio_write8((p + o) as *mut u8, (v & 255) as u8)
}

fn write32_at(p: u64, o: u64, v: u64) {
    __mmio_write32((p + o) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn write64_at(p: u64, o: u64, v: u64) {
    __mmio_write64((p + o) as *mut u64, v)
}
