import libc.threads
import libc.kcall
import libc.locks

export { run_main_exit, DTOR_MARK, LATE_MARK, EXIT_CODE, LATE_CODE }

const EXIT_CODE: u64 = 7
const LATE_CODE: u64 = 99
const SLEEPER_MS: u64 = 1500
const STDOUT: u64 = 1

static mut DTOR_MARK: [u8; 14] = "threxit dtor\n\0"
static mut LATE_MARK: [u8; 14] = "threxit late\n\0"

fn put(mark: u64) {
    kcall.sys3(kcall.SYS_WRITE, STDOUT, mark, 13)
}

fn dtor(value: u64) -> u64 {
    put((&DTOR_MARK[0]) as u64)
    return 0
}

fn sleeper(arg: u64) -> u64 {
    threads.sleep_ms(SLEEPER_MS)
    put((&LATE_MARK[0]) as u64)
    kcall.sys1(kcall.SYS_EXIT_GROUP, LATE_CODE)
    return 0
}

fn run_main_exit() -> u64 {
    let key: u64 = threads.key_create(dtor)
    threads.key_set(key, 1)
    let h: u64 = threads.spawn(sleeper, 0)
    if h == 0 || key == 0 {
        return 1
    }
    threads.sleep_ms(50)
    threads.thread_exit(EXIT_CODE)
    return 2
}
