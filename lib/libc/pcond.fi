import libc.locks
import libc.pmutex
import libc.pcancel
import libc.errno

export { init_clock, wait, timedwait }

const WORD_MASK: u64 = 0xFFFFFFFF
const WALL_FLAG: u64 = 0x8000000000000000

fn init_clock(cv: u64, clock: u64) {
    if clock == locks.CLOCK_REALTIME {
        locks.store(cv, WALL_FLAG)
    } else {
        locks.store(cv, 0)
    }
}

fn monotonic_deadline(cv: u64, deadline_ns: u64) -> u64 {
    if (locks.load(cv) & WALL_FLAG) == 0 {
        return deadline_ns
    }
    let wall: u64 = locks.wall_ns()
    if deadline_ns <= wall {
        return 0
    }
    return locks.deadline_after(deadline_ns - wall)
}

fn block_until(cv: u64, seq: u64, timed: bool, deadline: u64) -> u64 {
    pcancel.wait_begin(cv)
    var result: u64 = 0
    var going: bool = true
    while going {
        if pcancel.due() {
            going = false
        } else {
            var slice: u64 = pcancel.SLICE_NS
            if timed {
                let left: u64 = locks.remaining(deadline)
                if left == 0 {
                    result = errno.E_TIMEDOUT
                    going = false
                } else {
                    if left < slice {
                        slice = left
                    }
                }
            }
            if going && !locks.timed_out(locks.futex_wait_ns(cv, seq, slice)) {
                going = false
            }
        }
    }
    pcancel.wait_end()
    return result
}

fn enter(m: u64, depth_out: u64) -> u64 {
    pcancel.testcancel()
    return pmutex.cond_enter(m, depth_out)
}

fn leave(m: u64, depth: u64) {
    pmutex.cond_leave(m, depth)
    pcancel.testcancel()
}

fn wait(cv: u64, m: u64) -> u64 {
    let seq: u64 = locks.load(cv) & WORD_MASK
    var depth: u64 = 1
    let r: u64 = enter(m, (&depth) as u64)
    if r != 0 {
        return r
    }
    block_until(cv, seq, false, 0)
    leave(m, depth)
    return 0
}

fn timedwait(cv: u64, m: u64, deadline_ns: u64) -> u64 {
    let seq: u64 = locks.load(cv) & WORD_MASK
    var depth: u64 = 1
    let r: u64 = enter(m, (&depth) as u64)
    if r != 0 {
        return r
    }
    let result: u64 = block_until(cv, seq, true, monotonic_deadline(cv, deadline_ns))
    leave(m, depth)
    return result
}
