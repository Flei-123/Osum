// lib/libc/kcall.fi -- round K4: the door out of a process.
//
// The file is not called `syscall.fi`, and that is not a matter of taste:
// `syscall` is a KEYWORD of Firn (`compiler/src/lexer.rs`,
// `TokKind::KwSyscall`), so `import libc.syscall` stops at the dot
// before it and the module cannot be found. `kcall` is the call into the
// kernel.
//
// This is the bottom of the Osum libc and the only file in it that
// contains an instruction of the machine. Everything above it is ordinary
// Firn: buffers, descriptors, an allocator, text.
//
// THE AGREEMENT, and it is Linux's on purpose (`kernel/sys.fi`):
//
//     rax = the number
//     rdi rsi rdx r10 r8 r9 = up to six arguments
//     rax = the result, or a NEGATIVE error number
//     rcx and r11 are destroyed by the processor itself
//
// Why r10 and not rcx for the fourth argument: `syscall` puts the return
// address into rcx before the kernel sees anything, so the C calling
// convention's fourth register is not available and Linux moved it one
// aside. Osum follows, because the point of following is that a program
// built for Linux works here without a translation layer.
//
// WHY THERE IS NO `sys6`. A Firn function takes at most six arguments
// (firnc1 refuses more, exit code 6), and a `sys6` would need seven with
// the number. The one call that really has six arguments is `mmap`, and
// it gets a door of its own below in which two of them are constants.

export {
    sys0, sys1, sys2, sys3, sys4, map_anon,
    sock_send, sock_recv, SYS_READ, SYS_WRITE, SYS_OPEN, SYS_CLOSE,
    SYS_STAT, SYS_FSTAT, SYS_LSEEK, SYS_MMAP, SYS_MUNMAP, SYS_BRK,
    SYS_PIPE, SYS_YIELD, SYS_DUP, SYS_DUP2, SYS_NANOSLEEP, SYS_GETPID,
    SYS_FORK, SYS_EXECVE, SYS_EXIT, SYS_WAIT4, SYS_GETCWD, SYS_MKDIR,
    SYS_UNLINK, SYS_GETPPID, SYS_GETDENTS64, SYS_EXIT_GROUP, SYS_OSUM_SPAWN, SYS_OSUM_EXEC,
    SYS_CHDIR, SYS_OSUM_SYSINFO, SYS_OSUM_PSTAT, SYS_OSUM_KILL, SYS_RT_SIGACTION, SYS_RT_SIGPROCMASK,
    SYS_RT_SIGRETURN, SYS_IOCTL, SYS_PAUSE, SYS_ALARM, SYS_CLONE, SYS_KILL,
    SYS_GETTIMEOFDAY, SYS_SETPGID, SYS_GETPGRP, SYS_SETSID, SYS_GETPGID, SYS_RT_SIGPENDING,
    SYS_GETTID, SYS_TIME, SYS_FUTEX, SYS_CLOCK_GETTIME, SYS_CLOCK_GETRES, SYS_CLOCK_NANOSLEEP,
    SYS_TGKILL, SYS_GETRANDOM, SYS_OSUM_PTY, SYS_OSUM_TTYINFO, SYS_OSUM_SIGINFO, SYS_OSUM_SETENV,
    SYS_OSUM_MOUNT, SYS_MOUNT, SYS_UMOUNT2, SYS_RENAME, SYS_OSUM_MNTSTAT, SYS_SOCKET,
    SYS_CONNECT, SYS_ACCEPT, SYS_SENDTO, SYS_RECVFROM, SYS_SHUTDOWN, SYS_BIND,
    SYS_OSUM_FTYPE, SYS_OSUM_FOPEN, SYS_OSUM_FLIST, SYS_OSUM_FREG,
    SYS_OSUM_PWRGET, SYS_OSUM_PWRSET, SYS_OSUM_PWRSTR, SYS_OSUM_PMON,
    SYS_VM_CREATE, SYS_VM_RUN,
    SYS_VM_STAT, SYS_VM_KILL, SYS_VM_VALUE, SYS_LISTEN, SYS_GETSOCKNAME, SYS_GETPEERNAME,
    SYS_SETSOCKOPT, SYS_GETSOCKOPT, SYS_ACCEPT4, SYS_ACCESS, SYS_CHMOD, SYS_FCHMOD,
    SYS_CHOWN, SYS_FCHOWN, SYS_LCHOWN, SYS_UMASK, SYS_GETUID, SYS_GETGID,
    SYS_SETUID, SYS_SETGID, SYS_GETEUID, SYS_GETEGID, SYS_SETREUID, SYS_SETREGID,
    SYS_SETRESUID, SYS_GETRESUID, SYS_SETRESGID, SYS_GETRESGID, SYS_REBOOT, SYS_FCHOWNAT,
    SYS_FCHMODAT, SYS_FACCESSAT, SYS_OSUM_USERINFO, O_RDONLY, O_WRONLY, O_RDWR,
    O_CREAT, O_EXCL, O_TRUNC, O_APPEND, O_DIRECTORY, SEEK_SET,
    SEEK_CUR, SEEK_END, WNOHANG, PROT_READ, PROT_WRITE, PROT_EXEC,
    MAP_PRIVATE, MAP_ANONYMOUS, IN, OUT, ERR
}

// The numbers of Linux x86-64. `docs/ROUNDK4.md` lists them against the
// kernel's table and names every place where Osum differs.
const SYS_READ: u64 = 0
const SYS_WRITE: u64 = 1
const SYS_OPEN: u64 = 2
const SYS_CLOSE: u64 = 3
const SYS_STAT: u64 = 4
const SYS_FSTAT: u64 = 5
const SYS_LSEEK: u64 = 8
const SYS_MMAP: u64 = 9
const SYS_MUNMAP: u64 = 11
const SYS_BRK: u64 = 12
const SYS_PIPE: u64 = 22
const SYS_YIELD: u64 = 24
const SYS_DUP: u64 = 32
const SYS_DUP2: u64 = 33
const SYS_NANOSLEEP: u64 = 35
const SYS_GETPID: u64 = 39
const SYS_FORK: u64 = 57
const SYS_EXECVE: u64 = 59
const SYS_EXIT: u64 = 60
const SYS_WAIT4: u64 = 61
const SYS_GETCWD: u64 = 79
// Round K6: a working directory per process, and `getcwd` answers out of
// it instead of answering "/".
const SYS_CHDIR: u64 = 80
const SYS_MKDIR: u64 = 83
const SYS_UNLINK: u64 = 87
const SYS_GETPPID: u64 = 110
const SYS_GETDENTS64: u64 = 217
const SYS_EXIT_GROUP: u64 = 231

// Osum's own, far above anything Linux hands out. `docs/ROUNDK6.md`
// says why the last three are here and not at Linux's 99 and 62: they
// are not those calls. There are no signals in this system, so `kill`
// takes an EXIT CODE, and `sysinfo` answers one number instead of
// filling a struct.
const SYS_OSUM_SPAWN: u64 = 1000
const SYS_OSUM_EXEC: u64 = 1001
const SYS_OSUM_SYSINFO: u64 = 1002
const SYS_OSUM_PSTAT: u64 = 1003
const SYS_OSUM_KILL: u64 = 1004


// ============================================================= RUNDE K9
//
// Signale, Terminals, Uhr und Zufall -- die Nummern von Linux x86-64,
// und die drei, die Linux nicht hat, im Hunderterblock dieser Runde
// (`kernel/sys.fi` fuehrt die Karte, wer welchen Bereich belegt).
// `tools/posix/run.sh`, Abschnitt 1, vergleicht diese Liste Zeile fuer
// Zeile mit der des Kernels: zwei Tabellen, die sich unterscheiden, sind
// ein Programm, das `sigaction` ruft und `ioctl` bekommt.
const SYS_RT_SIGACTION: u64 = 13
const SYS_RT_SIGPROCMASK: u64 = 14
const SYS_RT_SIGRETURN: u64 = 15
const SYS_IOCTL: u64 = 16
const SYS_PAUSE: u64 = 34
const SYS_ALARM: u64 = 37
const SYS_CLONE: u64 = 56
const SYS_KILL: u64 = 62
const SYS_GETTIMEOFDAY: u64 = 96
const SYS_SETPGID: u64 = 109
const SYS_GETPGRP: u64 = 111
const SYS_SETSID: u64 = 112
const SYS_GETPGID: u64 = 121
const SYS_RT_SIGPENDING: u64 = 127
const SYS_GETTID: u64 = 186
const SYS_TIME: u64 = 201
const SYS_FUTEX: u64 = 202
const SYS_CLOCK_GETTIME: u64 = 228
const SYS_CLOCK_GETRES: u64 = 229
const SYS_CLOCK_NANOSLEEP: u64 = 230
const SYS_TGKILL: u64 = 234
const SYS_GETRANDOM: u64 = 318
// RUNDE K12: die Gastmaschinen (`kernel/hv.fi`, `kernel/sys.fi`).
// Sie stehen hier, weil `tools/posix/run.sh` Kernel und libc Zeile fuer
// Zeile gegeneinander haelt: zwei Tabellen, die auseinanderlaufen, sind
// ein Programm, das nach `vm_run` fragt und `vm_stat` bekommt. Ihre
// FEHLER sind die der nativen ABI (`kernel/cap.fi`) und nicht die von
// errno -- diese fuenf Aufrufe arbeiten auf Handles.
const SYS_VM_CREATE: u64 = 1500
const SYS_VM_RUN: u64 = 1501
const SYS_VM_STAT: u64 = 1502
const SYS_VM_KILL: u64 = 1503
const SYS_VM_VALUE: u64 = 1504

const SYS_OSUM_PTY: u64 = 1100
const SYS_OSUM_TTYINFO: u64 = 1101
const SYS_OSUM_SIGINFO: u64 = 1102

// RUNDE K11. `setenv` legt den Umgebungsblock fest, den jedes danach
// gestartete Programm auf seiner Argumentseite findet; `mount` fragt nach
// (0), haengt ein (1) oder haengt aus (2). Diese Liste und die in
// `kernel/sys.fi` sind ZWEI Kopien derselben Sache, und Abschnitt 1 von
// tools/posix/run.sh haelt sie Name fuer Name gegeneinander -- der Tag,
// an dem sie auseinanderlaufen, ist der Tag, an dem eine Nummer zwei
// Dinge bedeutet.
// ---------------------------------------------------------- RUNDE K13
//
// Benutzer und Rechte. Die Nummern sind die von Linux x86-64, und sie
// stehen hier ein zweites Mal -- `kernel/sys.fi` hat dieselbe Liste, und
// Abschnitt 7 von `./test.sh` haelt beide Namen fuer Namen gegeneinander.
// Zwei Tafeln, die sich unterscheiden, waeren ein Programm, das nach
// `geteuid` fragt und `getegid` bekommt.
const SYS_ACCESS: u64 = 21
const SYS_CHMOD: u64 = 90
const SYS_FCHMOD: u64 = 91
const SYS_CHOWN: u64 = 92
const SYS_FCHOWN: u64 = 93
const SYS_LCHOWN: u64 = 94
const SYS_UMASK: u64 = 95
const SYS_GETUID: u64 = 102
const SYS_GETGID: u64 = 104
const SYS_SETUID: u64 = 105
const SYS_SETGID: u64 = 106
const SYS_GETEUID: u64 = 107
const SYS_GETEGID: u64 = 108
const SYS_SETREUID: u64 = 113
const SYS_SETREGID: u64 = 114
const SYS_SETRESUID: u64 = 117
const SYS_GETRESUID: u64 = 118
const SYS_SETRESGID: u64 = 119
const SYS_GETRESGID: u64 = 120
const SYS_REBOOT: u64 = 169
const SYS_FCHOWNAT: u64 = 260
const SYS_FCHMODAT: u64 = 268
const SYS_FACCESSAT: u64 = 269
// Die einzige eigene Nummer dieser Runde: sie gibt die Zaehler der
// Benutzerschicht nach Ring 3, und Linux hat nichts, was sie
// beantworten koennte.
const SYS_OSUM_USERINFO: u64 = 1600

const SYS_OSUM_SETENV: u64 = 1400
const SYS_OSUM_MOUNT: u64 = 1401

// ROUNDE K14: die VFS-Schicht. Drei Linux-Nummern (mount, umount2,
// rename) und eine eigene aus dem Hunderterblock 1700, den diese Runde
// zugeteilt bekommen hat. Abschnitt 1 von tools/posix/run.sh haelt
// diese Liste Name fuer Name gegen `kernel/sys.fi` -- eine Nummer, die
// hier fehlt, faellt dort auf.
const SYS_MOUNT: u64 = 165
const SYS_UMOUNT2: u64 = 166
const SYS_RENAME: u64 = 82
const SYS_OSUM_MNTSTAT: u64 = 1700
// RUNDE K16: womit man eine Datei oeffnet (`kernel/ftype.fi`). Die vier
// Nummern stehen hier ein zweites Mal, weil `tools/posix/run.sh` die
// beiden Listen gegeneinander haelt -- eine libc, die eine andere Zahl
// fuehrt als der Kern, faellt dort auf und nicht in einem Programm.
const SYS_OSUM_FTYPE: u64 = 1900
const SYS_OSUM_FOPEN: u64 = 1901
const SYS_OSUM_FLIST: u64 = 1902
const SYS_OSUM_FREG: u64 = 1903
// RUNDE K18: die Energieschicht (`kernel/pwr.fi`, `kernel/batt.fi`).
// Aus demselben Grund wie die vier darueber: `tools/posix/run.sh` haelt
// die Liste des Kerns gegen diese hier, und eine libc, die eine andere
// Zahl fuehrt als der Kern, waere ein Programm, das nach dem Profil
// fragt und die Helligkeit bekommt.
const SYS_OSUM_PWRGET: u64 = 1750
const SYS_OSUM_PWRSET: u64 = 1751
const SYS_OSUM_PWRSTR: u64 = 1752

// ROUND POWERMON: where the battery goes. Same rule as the three above,
// and `tools/posix/run.sh` is what enforces it -- it holds every
// `const SYS_...` in `kernel/sys.fi` against this file and counts the
// ones that differ. This round forgot the line and the count was one.
const SYS_OSUM_PMON: u64 = 1830

const O_RDONLY: u64 = 0
const O_WRONLY: u64 = 1
const O_RDWR: u64 = 2
const O_CREAT: u64 = 64
const O_EXCL: u64 = 128
const O_TRUNC: u64 = 512
const O_APPEND: u64 = 1024
const O_DIRECTORY: u64 = 65536

const SEEK_SET: u64 = 0
const SEEK_CUR: u64 = 1
const SEEK_END: u64 = 2

const WNOHANG: u64 = 1

const PROT_READ: u64 = 1
const PROT_WRITE: u64 = 2
const PROT_EXEC: u64 = 4
const MAP_PRIVATE: u64 = 2
const MAP_ANONYMOUS: u64 = 32

const IN: u64 = 0
const OUT: u64 = 1
const ERR: u64 = 2

// ROUND K8. The socket calls, Linux's numbers again (`kernel/sys.fi`).
const SYS_SOCKET: u64 = 41
const SYS_CONNECT: u64 = 42
const SYS_ACCEPT: u64 = 43
const SYS_SENDTO: u64 = 44
const SYS_RECVFROM: u64 = 45
const SYS_SHUTDOWN: u64 = 48
const SYS_BIND: u64 = 49
const SYS_LISTEN: u64 = 50
const SYS_GETSOCKNAME: u64 = 51
const SYS_GETPEERNAME: u64 = 52
const SYS_SETSOCKOPT: u64 = 54
const SYS_GETSOCKOPT: u64 = 55
const SYS_ACCEPT4: u64 = 288

fn sys0(number: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, clobber("rcx"),
        clobber("r11"), clobber("memory"))
}

fn sys1(number: u64, a0: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        clobber("rcx"), clobber("r11"), clobber("memory"))
}

fn sys2(number: u64, a0: u64, a1: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, clobber("rcx"), clobber("r11"), clobber("memory"))
}

fn sys3(number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

fn sys4(number: u64, a0: u64, a1: u64, a2: u64, a3: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, in("r10") a3, clobber("rcx"),
        clobber("r11"), clobber("memory"))
}

// ROUND K8: the two calls that really need SIX arguments, and the reason
// there is no `sys6` for them is at the top of this file -- a Firn
// function takes at most six, and the number would be the seventh. So
// the flag word is nailed to zero here: this libc has no MSG_PEEK, no
// MSG_DONTWAIT and no MSG_OOB, and a wrapper that pretended otherwise
// would be a lie the kernel would then have to answer.
fn sock_send(fd: u64, buf: u64, len: u64, addr: u64, alen: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") SYS_SENDTO, in("rdi") fd,
        in("rsi") buf, in("rdx") len, in("r10") 0, in("r8") addr,
        in("r9") alen, clobber("rcx"), clobber("r11"), clobber("memory"))
}

fn sock_recv(fd: u64, buf: u64, len: u64, addr: u64, lenp: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") SYS_RECVFROM, in("rdi") fd,
        in("rsi") buf, in("rdx") len, in("r10") 0, in("r8") addr,
        in("r9") lenp, clobber("rcx"), clobber("r11"), clobber("memory"))
}

// The one call with six arguments. The address is a wish and this libc has
// none, the descriptor is -1 and the offset 0 -- which is what
// MAP_ANONYMOUS means everywhere.
fn map_anon(len: u64, prot: u64, flags: u64) -> u64 {
    let no_fd: u64 = 0 -% 1
    return asm("syscall", out("rax"), in("rax") SYS_MMAP, in("rdi") 0,
        in("rsi") len, in("rdx") prot, in("r10") flags, in("r8") no_fd,
        in("r9") 0, clobber("rcx"), clobber("r11"), clobber("memory"))
}
