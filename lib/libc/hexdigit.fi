// SPDX-License-Identifier: MIT
export { char_of, upper_char_of, value_of, NOT_HEX }

const NOT_HEX: u64 = 16

fn char_of(v: u64) -> u64 {
    if v < 10 {
        return v + 48
    }
    return v + 87
}

fn upper_char_of(v: u64) -> u64 {
    if v < 10 {
        return v + 48
    }
    return v + 55
}

fn value_of(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    return NOT_HEX
}
