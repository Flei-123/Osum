import libc.threads
import libc.locks
import libc.pmutex
import libc.errno
import libc.octets

export { THREAD_ATTR_BYTES, MUTEX_ATTR_BYTES, COND_ATTR_BYTES, RWLOCK_ATTR_BYTES, thread_getguardsize, thread_getstack, thread_getschedparam, thread_setschedparam, thread_fill, cond_init, cond_destroy, cond_setclock, cond_getclock, rwlock_init, rwlock_destroy, STACK_LIMIT, CREATE_JOINABLE, CREATE_DETACHED, thread_init, thread_destroy, thread_setstacksize, thread_getstacksize, thread_setdetachstate, thread_getdetachstate, mutex_init, mutex_destroy, mutex_settype, mutex_gettype }

const THREAD_ATTR_BYTES: u64 = 40
const MUTEX_ATTR_BYTES: u64 = 8
const COND_ATTR_BYTES: u64 = 8
const RWLOCK_ATTR_BYTES: u64 = 8
const OFF_STACK_SIZE: u64 = 0
const OFF_DETACH: u64 = 8
const OFF_STACK_ADDR: u64 = 16
const OFF_GUARD: u64 = 24
const OFF_PRIORITY: u64 = 32
const GUARD_DEFAULT: u64 = 4096
const STACK_LIMIT: u64 = 1073741824
const CREATE_JOINABLE: u64 = 0
const CREATE_DETACHED: u64 = 1

fn thread_init(a: u64) -> u64 {
    octets.st64(a, OFF_STACK_SIZE, threads.STACK_DEFAULT)
    octets.st64(a, OFF_DETACH, CREATE_JOINABLE)
    octets.st64(a, OFF_STACK_ADDR, 0)
    octets.st64(a, OFF_GUARD, GUARD_DEFAULT)
    octets.st64(a, OFF_PRIORITY, 0)
    return 0
}

fn thread_destroy(a: u64) -> u64 {
    var off: u64 = 0
    while off < THREAD_ATTR_BYTES {
        octets.st64(a, off, 0)
        off = off + 8
    }
    return 0
}

fn thread_setstacksize(a: u64, bytes: u64) -> u64 {
    if bytes < threads.STACK_MIN || bytes > STACK_LIMIT {
        return errno.E_INVAL
    }
    octets.st64(a, 0, bytes)
    return 0
}

fn thread_getstacksize(a: u64, out: u64) -> u64 {
    octets.st64(out, 0, octets.ld64(a, 0))
    return 0
}

fn thread_setdetachstate(a: u64, state: u64) -> u64 {
    if state != CREATE_JOINABLE && state != CREATE_DETACHED {
        return errno.E_INVAL
    }
    octets.st64(a, 8, state)
    return 0
}

fn thread_getdetachstate(a: u64, out: u64) -> u64 {
    octets.st64(out, 0, octets.ld64(a, 8))
    return 0
}

fn mutex_init(a: u64) -> u64 {
    octets.st64(a, 0, pmutex.KIND_NORMAL)
    return 0
}

fn mutex_destroy(a: u64) -> u64 {
    octets.st64(a, 0, 0)
    return 0
}

fn mutex_settype(a: u64, kind: u64) -> u64 {
    if kind > pmutex.KIND_ERRORCHECK {
        return errno.E_INVAL
    }
    octets.st64(a, 0, kind)
    return 0
}

fn mutex_gettype(a: u64, out: u64) -> u64 {
    octets.st64(out, 0, octets.ld64(a, 0))
    return 0
}

fn thread_getguardsize(a: u64, out: u64) -> u64 {
    octets.st64(out, 0, octets.ld64(a, OFF_GUARD))
    return 0
}

fn thread_getstack(a: u64, addr_out: u64, size_out: u64) -> u64 {
    octets.st64(addr_out, 0, octets.ld64(a, OFF_STACK_ADDR))
    octets.st64(size_out, 0, octets.ld64(a, OFF_STACK_SIZE))
    return 0
}

fn thread_getschedparam(a: u64, param: u64) -> u64 {
    octets.st32(param, 0, octets.ld64(a, OFF_PRIORITY))
    return 0
}

fn thread_setschedparam(a: u64, param: u64) -> u64 {
    octets.st64(a, OFF_PRIORITY, octets.ld32(param, 0))
    return 0
}

fn thread_fill(a: u64, stack_addr: u64, stack_size: u64, detached: bool) {
    octets.st64(a, OFF_STACK_SIZE, stack_size)
    octets.st64(a, OFF_STACK_ADDR, stack_addr)
    octets.st64(a, OFF_GUARD, 0)
    if detached {
        octets.st64(a, OFF_DETACH, CREATE_DETACHED)
    } else {
        octets.st64(a, OFF_DETACH, CREATE_JOINABLE)
    }
}

fn cond_init(a: u64) -> u64 {
    octets.st64(a, 0, locks.CLOCK_MONOTONIC)
    return 0
}

fn cond_destroy(a: u64) -> u64 {
    octets.st64(a, 0, 0)
    return 0
}

fn cond_setclock(a: u64, clock: u64) -> u64 {
    if clock != locks.CLOCK_REALTIME && clock != locks.CLOCK_MONOTONIC {
        return errno.E_INVAL
    }
    octets.st64(a, 0, clock)
    return 0
}

fn cond_getclock(a: u64, out: u64) -> u64 {
    octets.st64(out, 0, octets.ld64(a, 0))
    return 0
}

fn rwlock_init(a: u64) -> u64 {
    octets.st64(a, 0, 0)
    return 0
}

fn rwlock_destroy(a: u64) -> u64 {
    octets.st64(a, 0, 0)
    return 0
}
