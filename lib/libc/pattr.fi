import libc.threads
import libc.pmutex
import libc.errno
import libc.octets

export { THREAD_ATTR_BYTES, MUTEX_ATTR_BYTES, STACK_LIMIT, CREATE_JOINABLE, CREATE_DETACHED, thread_init, thread_destroy, thread_setstacksize, thread_getstacksize, thread_setdetachstate, thread_getdetachstate, mutex_init, mutex_destroy, mutex_settype, mutex_gettype }

const THREAD_ATTR_BYTES: u64 = 16
const MUTEX_ATTR_BYTES: u64 = 8
const STACK_LIMIT: u64 = 1073741824
const CREATE_JOINABLE: u64 = 0
const CREATE_DETACHED: u64 = 1

fn thread_init(a: u64) -> u64 {
    octets.st64(a, 0, threads.STACK_DEFAULT)
    octets.st64(a, 8, CREATE_JOINABLE)
    return 0
}

fn thread_destroy(a: u64) -> u64 {
    octets.st64(a, 0, 0)
    octets.st64(a, 8, 0)
    return 0
}

fn thread_setstacksize(a: u64, bytes: u64) -> u64 {
    if bytes < threads.STACK_MIN || bytes > STACK_LIMIT {
        return errno.E_INVAL
    }
    octets.st64(a, 0, bytes)
    return 0
}

fn thread_getstacksize(a: u64, out: u64) -> u64 {
    octets.st64(out, 0, octets.ld64(a, 0))
    return 0
}

fn thread_setdetachstate(a: u64, state: u64) -> u64 {
    if state != CREATE_JOINABLE && state != CREATE_DETACHED {
        return errno.E_INVAL
    }
    octets.st64(a, 8, state)
    return 0
}

fn thread_getdetachstate(a: u64, out: u64) -> u64 {
    octets.st64(out, 0, octets.ld64(a, 8))
    return 0
}

fn mutex_init(a: u64) -> u64 {
    octets.st64(a, 0, pmutex.KIND_NORMAL)
    return 0
}

fn mutex_destroy(a: u64) -> u64 {
    octets.st64(a, 0, 0)
    return 0
}

fn mutex_settype(a: u64, kind: u64) -> u64 {
    if kind > pmutex.KIND_ERRORCHECK {
        return errno.E_INVAL
    }
    octets.st64(a, 0, kind)
    return 0
}

fn mutex_gettype(a: u64, out: u64) -> u64 {
    octets.st64(out, 0, octets.ld64(a, 0))
    return 0
}
