// SPDX-License-Identifier: MIT
// lib/libc/io.fi -- round K4: files, descriptors and directories.
//
// One layer above the raw call, and what it adds is the behaviour a Unix
// program takes for granted and a raw system call does not give:
//
//   * `write` MAY write less than it was asked to. Every program that
//     ignores that has a bug that shows up on the day a pipe fills up.
//     `write_all` is the loop, written once.
//   * `read` may give less as well, and 0 means the END, not an error.
//     `read_full` is the other loop.
//   * a failed call returns -1 and the reason is in `errno`
//     (`libc.errno`), instead of a negative number the caller has to
//     decode itself.
//   * a directory is READ, not listed: `dir_read` hands out one entry per
//     call out of a buffer it refills from `getdents64`.

import libc.kcall
import libc.errno
import libc.text

export {
    open, create, close, read, write, write_all, read_full, write_text,
    seek, tell, size_of, stat_into, stat_size, stat_mode, is_dir_mode,
    fstat_into, unlink, make_dir, remove_dir, rename, dup, dup2, pipe, dir_open, dir_read,
    dir_name, dir_kind, dir_reclen, cwd,
    // ------------------------------------------------- RUNDE POLL
    poll, poll_set, poll_fd, poll_revents, poll_ready,
    PFD_BYTES, POLLIN, POLLPRI, POLLOUT, POLLERR, POLLHUP, POLLNVAL,
    POLL_FOREVER,
    STAT_BYTES, ST_MODE, ST_SIZE, ST_INO, S_IFMT, S_IFREG, S_IFDIR,
    S_IFIFO, S_IFCHR, DT_DIR, DT_REG, D_RECLEN, D_TYPE, D_NAME,
    // -------------------------------------------------- RUNDE OFS3
    lstat_into, stat_mtime, stat_ctime, stat_atime, stat_nlink,
    stat_mode_of, now_sec,
    symlink, readlink, is_link_mode, set_times, touch_now,
    ST_MTIME, ST_CTIME, ST_ATIME, ST_NLINK, S_IFLNK, DT_LNK,
    // ------------------------------------------------ RUNDE ASYNC
    fsync,
    aio_read, aio_write, aio_open, aio_close, aio_fsync, aio_poll,
    aio_wait, aio_cancel, aio_state, aio_version,
    aio_id, aio_udata, aio_result, aio_op,
    CQE_BYTES, AOP_READ, AOP_WRITE, AOP_OPEN, AOP_CLOSE, AOP_FSYNC,
    AOP_POLL,
    AQ_NEW, AQ_RUN, AQ_DONE, AQ_CANCEL, AQ_FAIL, AQ_WAIT, AIO_FOREVER
}

const STAT_BYTES: u64 = 144
const ST_INO: u64 = 8
const ST_MODE: u64 = 24
const ST_SIZE: u64 = 48

const S_IFMT: u64 = 61440 // 0o170000
const S_IFREG: u64 = 32768
const S_IFDIR: u64 = 16384
const S_IFIFO: u64 = 4096
const S_IFCHR: u64 = 8192
const S_IFLNK: u64 = 40960 // 0o120000

const ST_NLINK: u64 = 16
const ST_ATIME: u64 = 72
const ST_MTIME: u64 = 88
const ST_CTIME: u64 = 104

const DT_DIR: u64 = 4
const DT_REG: u64 = 8
const DT_LNK: u64 = 10

// `struct linux_dirent64`: the name begins at 19, the record length at 16.
const D_RECLEN: u64 = 16
const D_TYPE: u64 = 18
const D_NAME: u64 = 19

// ================================================== RUNDE ASYNC
const CQE_BYTES: u64 = 32
const AOP_READ: u64 = 1
const AOP_WRITE: u64 = 2
const AOP_OPEN: u64 = 3
const AOP_CLOSE: u64 = 4
const AOP_FSYNC: u64 = 5
const AOP_POLL: u64 = 6
// Die Zustaende eines Auftrags.
const AQ_NEW: u64 = 1 // angelegt
const AQ_RUN: u64 = 2 // laeuft
const AQ_DONE: u64 = 3 // fertig
const AQ_CANCEL: u64 = 4 // abgebrochen
const AQ_FAIL: u64 = 5 // fehlgeschlagen
const AQ_WAIT: u64 = 6
const AIO_FOREVER: u64 = 0xFFFFFFFFFFFFFFFF

fn aio_version() -> u64 {
    return kcall.sys0(kcall.AIO_VERSION)
}

fn aio_read(fd: u64, buf: u64, n: u64, udata: u64) -> u64 {
    return errno.check(kcall.aio_submit_call(AOP_READ, fd, buf, n, udata))
}

fn aio_write(fd: u64, buf: u64, n: u64, udata: u64) -> u64 {
    return errno.check(kcall.aio_submit_call(AOP_WRITE, fd, buf, n, udata))
}

fn aio_open(path: u64, flags: u64, udata: u64) -> u64 {
    return errno.check(kcall.aio_submit_call(AOP_OPEN, 0, path, flags,
        udata))
}

fn aio_close(fd: u64, udata: u64) -> u64 {
    return errno.check(kcall.aio_submit_call(AOP_CLOSE, fd, 0, 0, udata))
}

fn aio_fsync(fd: u64, udata: u64) -> u64 {
    return errno.check(kcall.aio_submit_call(AOP_FSYNC, fd, 0, 0, udata))
}

fn aio_poll(fd: u64, events: u64, udata: u64) -> u64 {
    return errno.check(kcall.aio_submit_call(AOP_POLL, fd, 0, events,
        udata))
}

fn aio_wait(out: u64, max: u64, timeout_ms: u64, mindestens: u64) -> u64 {
    return errno.check(kcall.sys4(kcall.AIO_WAIT, out, max, timeout_ms,
        mindestens))
}

fn aio_cancel(id: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.AIO_CANCEL, id))
}

fn aio_state(id: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.AIO_STATE, id))
}

fn aio_id(cqe: u64, i: u64) -> u64 {
    return __mmio_read64((cqe + i * CQE_BYTES) as *mut u64)
}

fn aio_udata(cqe: u64, i: u64) -> u64 {
    return __mmio_read64((cqe + i * CQE_BYTES + 8) as *mut u64)
}

fn aio_result(cqe: u64, i: u64) -> u64 {
    return __mmio_read64((cqe + i * CQE_BYTES + 16) as *mut u64)
}

fn aio_op(cqe: u64, i: u64) -> u64 {
    return __mmio_read64((cqe + i * CQE_BYTES + 24) as *mut u64)
}

fn fsync(fd: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.SYS_FSYNC, fd))
}

// -------------------------------------------------------- descriptors

fn open(path: u64, flags: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_OPEN, path, flags))
}

// The two flags every "write me a file" wants: make it if it is not there,
// throw away what is in it if it is.
fn create(path: u64) -> u64 {
    let flags: u64 = kcall.O_WRONLY | kcall.O_CREAT | kcall.O_TRUNC
    return errno.check(kcall.sys2(kcall.SYS_OPEN, path, flags))
}

fn close(fd: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.SYS_CLOSE, fd))
}

fn read(fd: u64, buf: u64, n: u64) -> u64 {
    return errno.check(kcall.sys3(kcall.SYS_READ, fd, buf, n))
}

fn write(fd: u64, buf: u64, n: u64) -> u64 {
    return errno.check(kcall.sys3(kcall.SYS_WRITE, fd, buf, n))
}

// Everything, or -1. A short write is not an error and not the end: it is
// the normal case on a pipe, and this is the loop that deals with it.
fn write_all(fd: u64, buf: u64, n: u64) -> u64 {
    var done: u64 = 0
    while done < n {
        let r: u64 = write(fd, buf + done, n - done)
        if errno.failed(r) {
            return r
        }
        if r == 0 {
            return done
        }
        done = done + r
    }
    return done
}

// Reads until the buffer is full or the source is at its end. Returns how
// many octets arrived -- 0 is the end of the file, not a failure.
fn read_full(fd: u64, buf: u64, n: u64) -> u64 {
    var done: u64 = 0
    var going: bool = true
    while going {
        if done >= n {
            going = false
        } else {
            let r: u64 = read(fd, buf + done, n - done)
            if errno.failed(r) {
                return r
            }
            if r == 0 {
                going = false
            } else {
                done = done + r
            }
        }
    }
    return done
}

fn write_text(fd: u64, p: u64) -> u64 {
    return write_all(fd, p, text.length(p))
}

fn seek(fd: u64, off: u64, whence: u64) -> u64 {
    return errno.check(kcall.sys3(kcall.SYS_LSEEK, fd, off, whence))
}

fn tell(fd: u64) -> u64 {
    return seek(fd, 0, kcall.SEEK_CUR)
}

fn dup(fd: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.SYS_DUP, fd))
}

fn dup2(from: u64, to: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_DUP2, from, to))
}

// `out` takes two `int`s: the reading end first, the writing end second.
fn pipe(out: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.SYS_PIPE, out))
}

fn unlink(path: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.SYS_UNLINK, path))
}

fn remove_dir(path: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.SYS_RMDIR, path))
}

fn make_dir(path: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_MKDIR, path, 493))
}

// ================================================== RUNDE EXPLORER-2
fn rename(alt: u64, new_path: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_RENAME, alt, new_path))
}

fn cwd(buf: u64, n: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_GETCWD, buf, n))
}

// --------------------------------------------------------------- stat

fn stat_into(path: u64, buf: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_STAT, path, buf))
}

fn fstat_into(fd: u64, buf: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_FSTAT, fd, buf))
}

// How big the file is, or -1. The structure lives on the stack for the
// length of the call -- a program that only wants the size should not have
// to know that a `struct stat` is 144 octets.
fn size_of(path: u64) -> u64 {
    var st: [u8; 144] = [0 as u8; 144]
    let r: u64 = stat_into(path, (&st[0]) as u64)
    if errno.failed(r) {
        return r
    }
    return __mmio_read64(((&st[0]) as u64 + ST_SIZE) as *mut u64)
}

fn stat_mode(path: u64) -> u64 {
    var st: [u8; 144] = [0 as u8; 144]
    let r: u64 = stat_into(path, (&st[0]) as u64)
    if errno.failed(r) {
        return r
    }
    return __mmio_read32(((&st[0]) as u64 + ST_MODE) as *mut u32) as u64
}

fn stat_size(buf: u64) -> u64 {
    return __mmio_read64((buf + ST_SIZE) as *mut u64)
}

fn stat_mode_of(buf: u64) -> u64 {
    return __mmio_read32((buf + ST_MODE) as *mut u32) as u64
}

fn is_dir_mode(mode: u64) -> bool {
    return (mode & S_IFMT) == S_IFDIR
}

// ========================================================== RUNDE OFS3

fn is_link_mode(mode: u64) -> bool {
    return (mode & S_IFMT) == S_IFLNK
}

fn lstat_into(path: u64, buf: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_LSTAT, path, buf))
}

fn stat_mtime(buf: u64) -> u64 {
    return __mmio_read64((buf + ST_MTIME) as *mut u64)
}

fn stat_ctime(buf: u64) -> u64 {
    return __mmio_read64((buf + ST_CTIME) as *mut u64)
}

fn stat_atime(buf: u64) -> u64 {
    return __mmio_read64((buf + ST_ATIME) as *mut u64)
}

fn stat_nlink(buf: u64) -> u64 {
    return __mmio_read64((buf + ST_NLINK) as *mut u64)
}

fn symlink(target: u64, wo: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_SYMLINK, target, wo))
}

fn readlink(path: u64, buf: u64, n: u64) -> u64 {
    let r: u64 = errno.check(kcall.sys3(kcall.SYS_READLINK, path, buf, n))
    if !errno.failed(r) && r < n {
        *((buf + r) as *mut u8) = 0 as u8
    }
    return r
}

fn set_times(path: u64, zeiten: u64) -> u64 {
    return errno.check(kcall.sys4(kcall.SYS_UTIMENSAT, 0 -% 100, path,
            zeiten, 0))
}

fn touch_now(path: u64) -> u64 {
    return set_times(path, 0)
}

fn now_sec() -> u64 {
    return kcall.sys1(kcall.SYS_TIME, 0)
}

// ---------------------------------------------------------- directories

// A directory is opened like a file, with the flag that says it must be
// one. Reading it is `getdents64`, and the caller walks the records with
// `dir_name` and `dir_kind`.
fn dir_open(path: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_OPEN, path,
            kcall.O_DIRECTORY))
}

// Fills `buf` with as many records as fit. 0 = the directory is at its
// end. The caller walks the records itself:
//
//     var at: u64 = 0
//     while at < n {
//         say(io.dir_name(base + at))
//         at = at + io.dir_reclen(base + at)
//     }
fn dir_read(fd: u64, buf: u64, n: u64) -> u64 {
    return errno.check(kcall.sys3(kcall.SYS_GETDENTS64, fd, buf, n))
}

fn dir_name(rec: u64) -> u64 {
    return rec + D_NAME
}

fn dir_kind(rec: u64) -> u64 {
    return (*((rec + D_TYPE) as *mut u8)) as u64
}

// How long this record is. What walks the buffer -- a reader that counted
// on a fixed size would be wrong at the first long name.
fn dir_reclen(rec: u64) -> u64 {
    return __mmio_read16((rec + D_RECLEN) as *mut u16) as u64
}

// ================================================== RUNDE POLL
const PFD_BYTES: u64 = 8
const POLLIN: u64 = 1
const POLLPRI: u64 = 2
const POLLOUT: u64 = 4
const POLLERR: u64 = 8
const POLLHUP: u64 = 16
const POLLNVAL: u64 = 32
const POLL_FOREVER: u64 = 0xFFFFFFFFFFFFFFFF

fn st8(p: u64, off: u64, v: u64) {
    __mmio_write8((p + off) as *mut u8, (v & 255) as u8)
}

fn ld8(p: u64, off: u64) -> u64 {
    return __mmio_read8((p + off) as *mut u8) as u64
}

fn poll_set(fds: u64, i: u64, fd: u64, events: u64) {
    let a: u64 = fds + i * PFD_BYTES
    st8(a, 0, fd)
    st8(a, 1, fd >> 8)
    st8(a, 2, fd >> 16)
    st8(a, 3, fd >> 24)
    st8(a, 4, events)
    st8(a, 5, events >> 8)
    st8(a, 6, 0)
    st8(a, 7, 0)
}

fn poll_fd(fds: u64, i: u64) -> u64 {
    let a: u64 = fds + i * PFD_BYTES
    return ld8(a, 0) | (ld8(a, 1) << 8) | (ld8(a, 2) << 16) | (ld8(a, 3) << 24)
}

fn poll_revents(fds: u64, i: u64) -> u64 {
    let a: u64 = fds + i * PFD_BYTES
    return ld8(a, 6) | (ld8(a, 7) << 8)
}

fn poll_ready(fds: u64, i: u64, what: u64) -> bool {
    return (poll_revents(fds, i) & what) != 0
}

fn poll(fds: u64, nfds: u64, timeout_ms: u64) -> u64 {
    return errno.check(kcall.sys3(kcall.SYS_POLL, fds, nfds, timeout_ms))
}
