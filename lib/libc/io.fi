// SPDX-License-Identifier: MIT
// lib/libc/io.fi -- round K4: files, descriptors and directories.
//
// One layer above the raw call, and what it adds is the behaviour a Unix
// program takes for granted and a raw system call does not give:
//
//   * `write` MAY write less than it was asked to. Every program that
//     ignores that has a bug that shows up on the day a pipe fills up.
//     `write_all` is the loop, written once.
//   * `read` may give less as well, and 0 means the END, not an error.
//     `read_full` is the other loop.
//   * a failed call returns -1 and the reason is in `errno`
//     (`libc.errno`), instead of a negative number the caller has to
//     decode itself.
//   * a directory is READ, not listed: `dir_read` hands out one entry per
//     call out of a buffer it refills from `getdents64`.

import libc.kcall
import libc.errno
import libc.text

export {
    open, create, close, read, write, write_all, read_full, write_text,
    seek, tell, size_of, stat_into, stat_size, stat_mode, is_dir_mode,
    fstat_into, unlink, make_dir, dup, dup2, pipe, dir_open, dir_read,
    dir_name, dir_kind, dir_reclen, cwd,
    // ------------------------------------------------- RUNDE POLL
    poll, poll_set, poll_fd, poll_revents, poll_ready,
    PFD_BYTES, POLLIN, POLLPRI, POLLOUT, POLLERR, POLLHUP, POLLNVAL,
    POLL_FOREVER,
    STAT_BYTES, ST_MODE, ST_SIZE, ST_INO, S_IFMT, S_IFREG, S_IFDIR,
    S_IFIFO, S_IFCHR, DT_DIR, DT_REG, D_RECLEN, D_TYPE, D_NAME,
    // -------------------------------------------------- RUNDE OFS3
    lstat_into, stat_mtime, stat_ctime, stat_atime, stat_nlink,
    stat_mode_of, now_sec,
    symlink, readlink, is_link_mode, set_times, touch_now,
    ST_MTIME, ST_CTIME, ST_ATIME, ST_NLINK, S_IFLNK, DT_LNK,
    // ------------------------------------------------ RUNDE ASYNC
    fsync,
    aio_read, aio_write, aio_open, aio_close, aio_fsync, aio_poll,
    aio_wait, aio_cancel, aio_state, aio_version,
    aio_id, aio_udata, aio_result, aio_op,
    CQE_BYTES, AOP_READ, AOP_WRITE, AOP_OPEN, AOP_CLOSE, AOP_FSYNC,
    AOP_POLL,
    AQ_NEW, AQ_RUN, AQ_DONE, AQ_CANCEL, AQ_FAIL, AQ_WAIT, AIO_FOREVER,
    // ------------------------------------------------- RUNDE RING
    ring_setup, ring_map, ring_close, ring_enter, ring_kick,
    ring_put, ring_reap, ring_room, ring_ready, ring_wake_needed,
    ring_sqe, ring_cqe, ring_dropped, ring_over, ring_bytes, ring_nr,
    ring_version,
    RH_MAGIC, RH_VERSION, RH_SQE, RH_CQE, RH_SQMASK, RH_CQMASK,
    RH_SQOFF, RH_CQOFF, RH_SQHEAD, RH_SQTAIL, RH_CQHEAD, RH_CQTAIL,
    RH_FLAGS, RH_DROPPED, RH_OVER, RH_BYTES, RH_ID,
    SQE_BYTES, RING_MAGIC, RF_WAKEUP
}

const STAT_BYTES: u64 = 144
const ST_INO: u64 = 8
const ST_MODE: u64 = 24
const ST_SIZE: u64 = 48

const S_IFMT: u64 = 61440 // 0o170000
const S_IFREG: u64 = 32768
const S_IFDIR: u64 = 16384
const S_IFIFO: u64 = 4096
const S_IFCHR: u64 = 8192
// RUNDE OFS3: der symbolische Verweis, mit der Zahl von Unix.
const S_IFLNK: u64 = 40960 // 0o120000

// RUNDE OFS3: DIE DREI ZEITEN WAREN IMMER SCHON IN `struct stat` -- als
// Nullen. Der Kernel fuellt sie seit dieser Runde; die Versaetze sind die
// von Linux x86-64 und haben sich nicht bewegt.
const ST_NLINK: u64 = 16
const ST_ATIME: u64 = 72
const ST_MTIME: u64 = 88
const ST_CTIME: u64 = 104

const DT_DIR: u64 = 4
const DT_REG: u64 = 8
const DT_LNK: u64 = 10

// `struct linux_dirent64`: the name begins at 19, the record length at 16.
const D_RECLEN: u64 = 16
const D_TYPE: u64 = 18
const D_NAME: u64 = 19

// ================================================== RUNDE ASYNC
//
// AUFTRAEGE ABGEBEN, SPAETER AUF FERTIGMELDUNGEN WARTEN.
//
// Der Unterschied zu `poll`: `poll` sagt, was jetzt MOEGLICH waere --
// danach muss das Programm die Arbeit noch selbst tun. Ein Auftrag ist
// die Arbeit; die Fertigmeldung sagt, dass sie GETAN ist. Fuer eine
// gewoehnliche Datei ist das der einzige Weg, der etwas bedeutet: eine
// Datei ist immer "bereit", und ein `poll` darauf ist keine Auskunft.
//
//     var cqe: [u8; 64] = [0 as u8; 64]      // zwei Meldungen
//     let a: u64 = io.aio_read(fd, puffer, 4096, 1)
//     let b: u64 = io.aio_read(fd2, puffer2, 4096, 2)
//     let n: u64 = io.aio_wait((&cqe[0]) as u64, 2, io.AIO_FOREVER, 2)
//     // io.aio_udata(cqe, 0) sagt, welcher der beiden es war,
//     // io.aio_result(cqe, 0), wie viele Oktette es geworden sind.
//
// Eine Fertigmeldung ist 32 Oktett: Kennung, Kennzahl des Programms,
// Ergebnis, Art -- vier Worte, und genau diese Form bekommt in Runde
// RING der Completion-Ring im geteilten Speicher. Wer heute `aio_wait`
// benutzt, muss dafuer nichts umschreiben ausser dem Abholweg.
//
// DAS ERGEBNIS STEHT IN DER MELDUNG, NICHT IM RUECKGABEWERT DER ABGABE.
// `aio_read` gibt eine KENNUNG zurueck (oder einen negativen Fehler,
// wenn die Abgabe selbst scheitert -- volle Warteschlange, falscher
// Deskriptor). Ob das Lesen geklappt hat, sagt erst `aio_result`.
const CQE_BYTES: u64 = 32
const AOP_READ: u64 = 1
const AOP_WRITE: u64 = 2
const AOP_OPEN: u64 = 3
const AOP_CLOSE: u64 = 4
const AOP_FSYNC: u64 = 5
const AOP_POLL: u64 = 6
// Die Zustaende eines Auftrags.
const AQ_NEW: u64 = 1 // angelegt
const AQ_RUN: u64 = 2 // laeuft
const AQ_DONE: u64 = 3 // fertig
const AQ_CANCEL: u64 = 4 // abgebrochen
const AQ_FAIL: u64 = 5 // fehlgeschlagen
const AQ_WAIT: u64 = 6 // wartet auf ein Ereignis (nur `aio_poll`)
// Warten, bis wirklich etwas fertig wird -- wie `POLL_FOREVER`.
const AIO_FOREVER: u64 = 0xFFFFFFFFFFFFFFFF

// ==================================================== RUNDE RING
//
// DER COMPLETION-RING IM GETEILTEN SPEICHER, VON EINEM PROGRAMM AUS.
//
// DER UNTERSCHIED ZU `aio_*` IN EINEM SATZ: dort ist jede Abgabe und
// jede Abholung ein Systemaufruf, hier ist beides ein Schreib- bzw.
// Lesezugriff auf eigenen Speicher.
//
// DER ABLAUF, und mehr ist es nicht:
//
//     let h: u64 = io.ring_setup(32)          // einmal
//     let r: u64 = io.ring_map(h)             // einmal
//     ...
//     io.ring_put(r, io.AOP_READ, fd, puffer, 4096, 1)
//     io.ring_put(r, io.AOP_READ, fd2, puffer2, 4096, 2)
//     io.ring_kick(h, r)        // NUR wenn die Weckflagge steht
//     io.ring_enter(h, 0, 2, io.AIO_FOREVER)   // oder abfragen
//     while io.ring_reap(r, (&cqe[0]) as u64) == 1 { ... }
//
// `ring_reap` liefert DENSELBEN 32-Oktett-Satz wie `aio_wait`, also
// funktionieren `aio_id`, `aio_udata`, `aio_result` und `aio_op`
// unveraendert weiter. Wer von `aio_wait` auf den Ring umzieht, aendert
// den Abholweg und keine Auswertung.
//
// DIE WECKREGEL, UND SIE IST PFLICHT. Wenn niemand mehr wach ist, merkt
// auch niemand, dass etwas im Ring liegt. Deshalb gilt fuer JEDES
// Programm, das ohne `ring_enter` abgibt, diese Reihenfolge:
//
//     1. Abgabesatz schreiben          (ring_put)
//     2. Schwanz schieben              (ring_put, letzte Zeile)
//     3. DANACH die Flagge lesen       (ring_wake_needed)
//     4. steht sie: anstossen          (ring_kick)
//
// Wer 3 vor 2 macht, baut sich den Haenger selbst. Der Kern macht es
// spiegelbildlich (Flagge setzen, Schranke, NOCH EINMAL nachsehen), und
// erst beide Haelften zusammen schliessen das Fenster.
//
// Das Netz darunter: die Arbeitsfaeden schlafen ohnehin nur mit einer
// Frist von einer Sekunde. Ein Programm, das die Regel missachtet,
// haengt also nicht -- es ist nur bis zu einer Sekunde langsam. Das ist
// die unangenehmste Sorte Fehler, weil sie in keinem Test auffaellt;
// deshalb steht die Regel hier so ausfuehrlich.
const RH_MAGIC: u64 = 0x00
const RH_VERSION: u64 = 0x08
const RH_SQE: u64 = 0x10
const RH_CQE: u64 = 0x18
const RH_SQMASK: u64 = 0x20
const RH_CQMASK: u64 = 0x28
const RH_SQOFF: u64 = 0x30
const RH_CQOFF: u64 = 0x38
const RH_SQHEAD: u64 = 0x40 // der Kern schreibt
const RH_SQTAIL: u64 = 0x48 // das Programm schreibt
const RH_CQHEAD: u64 = 0x50 // das Programm schreibt
const RH_CQTAIL: u64 = 0x58 // der Kern schreibt
const RH_FLAGS: u64 = 0x60
const RH_DROPPED: u64 = 0x68
const RH_OVER: u64 = 0x70
const RH_BYTES: u64 = 0x78
const RH_ID: u64 = 0x80
const SQE_BYTES: u64 = 64
const RING_MAGIC: u64 = 0x474E4952204D5553
const RF_WAKEUP: u64 = 1

fn rld(p: u64, off: u64) -> u64 {
    return __mmio_read64((p + off) as *mut u64)
}

fn rst(p: u64, off: u64, v: u64) {
    __mmio_write64((p + off) as *mut u64, v)
}

fn ring_version() -> u64 {
    return kcall.sys0(kcall.RING_VERSION)
}

// `saetze` MUSS eine Zweierpotenz zwischen 4 und 128 sein. Der
// Fertigring wird doppelt so lang -- und genau deshalb kann er nicht
// ueberlaufen: es gibt nie mehr Meldungen als abgegebene Auftraege.
fn ring_setup(saetze: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.RING_SETUP, saetze, 0))
}

fn ring_map(h: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.RING_MAP, h))
}

fn ring_close(h: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.RING_CLOSE, h))
}

// Anstossen und/oder blockierend warten. `abgeben` Saetze werden JETZT
// geerntet; danach wird gewartet, bis `mindestens` Fertigmeldungen im
// Ring stehen. Beides darf 0 sein -- dann ist es der reine Anstoss.
fn ring_enter(h: u64, abgeben: u64, mindestens: u64,
    timeout_ms: u64) -> u64 {
    return errno.check(kcall.sys4(kcall.RING_ENTER, h, abgeben,
        mindestens, timeout_ms))
}

// Ist der Ring wirklich einer? Ein Speicherbereich ohne diese Kennung
// ist keiner.
fn ring_ready(r: u64) -> bool {
    return rld(r, RH_MAGIC) == RING_MAGIC
}

fn ring_sqe(r: u64) -> u64 {
    return rld(r, RH_SQE)
}

fn ring_cqe(r: u64) -> u64 {
    return rld(r, RH_CQE)
}

fn ring_bytes(r: u64) -> u64 {
    return rld(r, RH_BYTES)
}

fn ring_nr(r: u64) -> u64 {
    return rld(r, RH_ID)
}

// Verworfene Abgabesaetze und Fertigmeldungen ohne Platz. BEIDE muessen
// null bleiben; steht dort etwas, hat das Programm etwas falsch
// gemacht, und der Kern sagt es ihm hier, statt es zu verschlucken.
fn ring_dropped(r: u64) -> u64 {
    return rld(r, RH_DROPPED)
}

fn ring_over(r: u64) -> u64 {
    return rld(r, RH_OVER)
}

// Wie viele Saetze noch in den Abgabering passen.
fn ring_room(r: u64) -> u64 {
    let n: u64 = rld(r, RH_SQE)
    return n -% (rld(r, RH_SQTAIL) -% rld(r, RH_SQHEAD))
}

fn ring_wake_needed(r: u64) -> bool {
    return (rld(r, RH_FLAGS) & RF_WAKEUP) != 0
}

// EINEN ABGABESATZ HINLEGEN. Gibt 0, wenn kein Platz mehr ist -- dann
// muss erst abgeholt oder angestossen werden.
//
// Erst der Satz, DANN der Schwanz: auf x86-64 kommt ein Schreibzugriff
// nie vor einen aelteren (TSO), also sieht der Kern nie einen Schwanz,
// der auf einen halb geschriebenen Satz zeigt.
fn ring_put(r: u64, op: u64, fd: u64, buf: u64, len: u64,
    udata: u64) -> u64 {
    if ring_room(r) == 0 {
        return 0
    }
    let t: u64 = rld(r, RH_SQTAIL)
    let e: u64 = r + rld(r, RH_SQOFF) + (t & rld(r, RH_SQMASK)) * SQE_BYTES
    rst(e, 0, op)
    rst(e, 8, fd)
    rst(e, 16, buf)
    rst(e, 24, len)
    rst(e, 32, udata)
    rst(e, 40, 0)
    rst(r, RH_SQTAIL, t +% 1)
    return 1
}

// Die Weckregel in einer Zeile: nur anstossen, wenn die Flagge steht.
fn ring_kick(h: u64, r: u64) -> u64 {
    if ring_wake_needed(r) {
        return ring_enter(h, 0, 0, 0)
    }
    return 0
}

// EINE FERTIGMELDUNG ABHOLEN -- OHNE SYSTEMAUFRUF. Nach `out` kommen
// dieselben vier Worte wie von `aio_wait`, also lesen `aio_id`,
// `aio_udata`, `aio_result` und `aio_op` sie unveraendert.
fn ring_reap(r: u64, out: u64) -> u64 {
    let h: u64 = rld(r, RH_CQHEAD)
    if h == rld(r, RH_CQTAIL) {
        return 0
    }
    let e: u64 = r + rld(r, RH_CQOFF) + (h & rld(r, RH_CQMASK)) * CQE_BYTES
    rst(out, 0, rld(e, 0))
    rst(out, 8, rld(e, 8))
    rst(out, 16, rld(e, 16))
    rst(out, 24, rld(e, 24))
    rst(r, RH_CQHEAD, h +% 1)
    return 1
}

fn aio_version() -> u64 {
    return kcall.sys0(kcall.AIO_VERSION)
}

fn aio_read(fd: u64, buf: u64, n: u64, udata: u64) -> u64 {
    return errno.check(kcall.aio_submit_call(AOP_READ, fd, buf, n, udata))
}

fn aio_write(fd: u64, buf: u64, n: u64, udata: u64) -> u64 {
    return errno.check(kcall.aio_submit_call(AOP_WRITE, fd, buf, n, udata))
}

// Der Pfad wird BEI DER ABGABE in den Kern kopiert -- der Puffer darf
// danach sofort wieder etwas anderes enthalten.
fn aio_open(path: u64, flags: u64, udata: u64) -> u64 {
    return errno.check(kcall.aio_submit_call(AOP_OPEN, 0, path, flags,
        udata))
}

fn aio_close(fd: u64, udata: u64) -> u64 {
    return errno.check(kcall.aio_submit_call(AOP_CLOSE, fd, 0, 0, udata))
}

fn aio_fsync(fd: u64, udata: u64) -> u64 {
    return errno.check(kcall.aio_submit_call(AOP_FSYNC, fd, 0, 0, udata))
}

// DIE BRUECKE VON READINESS AUF COMPLETION: ein Auftrag, der fertig
// wird, sobald auf diesem Deskriptor eines der Ereignisse aus `events`
// moeglich waere. Damit kann ein Programm, das nur Fertigmeldungen
// kennt, auf Rohre, Steckdosen und Terminals warten, ohne `poll` je
// aufzurufen. Das Ergebnis der Meldung ist die `revents`-Maske.
fn aio_poll(fd: u64, events: u64, udata: u64) -> u64 {
    return errno.check(kcall.aio_submit_call(AOP_POLL, fd, 0, events,
        udata))
}

// Fertigmeldungen abholen. `max` Meldungen passen nach `out` (je
// CQE_BYTES); zurueck kommt, wie viele es geworden sind.
//   timeout_ms > 0   hoechstens so lange warten, danach -ETIMEDOUT
//   timeout_ms == 0  nur nachsehen; nichts da heisst 0
//   AIO_FOREVER      warten, bis etwas kommt
// `mindestens` ist `min_complete` von io_uring: erst zurueckkommen,
// wenn so viele da sind. Damit kostet ein Stapel von sechzehn
// Auftraegen EINEN Aufruf statt sechzehn.
fn aio_wait(out: u64, max: u64, timeout_ms: u64, mindestens: u64) -> u64 {
    return errno.check(kcall.sys4(kcall.AIO_WAIT, out, max, timeout_ms,
        mindestens))
}

// Abbrechen ist eine BITTE, kein Befehl: ein Auftrag, der schon laeuft,
// wird markiert und von seinem Arbeitsfaden gemeldet -- mit
// -ECANCELED, und genau einmal.
fn aio_cancel(id: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.AIO_CANCEL, id))
}

fn aio_state(id: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.AIO_STATE, id))
}

// Die vier Felder einer Fertigmeldung. Firn hat keine Struktur ueber
// Ring-3-Grenzen hinweg, also ist der Puffer ein Feld aus Oktetten und
// die Zugriffe darauf stehen hier -- an EINER Stelle, statt in jedem
// Programm noch einmal.
fn aio_id(cqe: u64, i: u64) -> u64 {
    return __mmio_read64((cqe + i * CQE_BYTES) as *mut u64)
}

fn aio_udata(cqe: u64, i: u64) -> u64 {
    return __mmio_read64((cqe + i * CQE_BYTES + 8) as *mut u64)
}

fn aio_result(cqe: u64, i: u64) -> u64 {
    return __mmio_read64((cqe + i * CQE_BYTES + 16) as *mut u64)
}

fn aio_op(cqe: u64, i: u64) -> u64 {
    return __mmio_read64((cqe + i * CQE_BYTES + 24) as *mut u64)
}

// RUNDE ASYNC: den Zwischenspeicher der Platte auf den Traeger druecken.
// Es gab ihn bis dahin nicht -- und ohne ihn ist "geschrieben" eine
// Aussage ueber einen Zwischenspeicher und nicht ueber die Platte.
fn fsync(fd: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.SYS_FSYNC, fd))
}

// -------------------------------------------------------- descriptors

fn open(path: u64, flags: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_OPEN, path, flags))
}

// The two flags every "write me a file" wants: make it if it is not there,
// throw away what is in it if it is.
fn create(path: u64) -> u64 {
    let flags: u64 = kcall.O_WRONLY | kcall.O_CREAT | kcall.O_TRUNC
    return errno.check(kcall.sys2(kcall.SYS_OPEN, path, flags))
}

fn close(fd: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.SYS_CLOSE, fd))
}

fn read(fd: u64, buf: u64, n: u64) -> u64 {
    return errno.check(kcall.sys3(kcall.SYS_READ, fd, buf, n))
}

fn write(fd: u64, buf: u64, n: u64) -> u64 {
    return errno.check(kcall.sys3(kcall.SYS_WRITE, fd, buf, n))
}

// Everything, or -1. A short write is not an error and not the end: it is
// the normal case on a pipe, and this is the loop that deals with it.
fn write_all(fd: u64, buf: u64, n: u64) -> u64 {
    var done: u64 = 0
    while done < n {
        let r: u64 = write(fd, buf + done, n - done)
        if errno.failed(r) {
            return r
        }
        if r == 0 {
            return done
        }
        done = done + r
    }
    return done
}

// Reads until the buffer is full or the source is at its end. Returns how
// many octets arrived -- 0 is the end of the file, not a failure.
fn read_full(fd: u64, buf: u64, n: u64) -> u64 {
    var done: u64 = 0
    var going: bool = true
    while going {
        if done >= n {
            going = false
        } else {
            let r: u64 = read(fd, buf + done, n - done)
            if errno.failed(r) {
                return r
            }
            if r == 0 {
                going = false
            } else {
                done = done + r
            }
        }
    }
    return done
}

fn write_text(fd: u64, p: u64) -> u64 {
    return write_all(fd, p, text.length(p))
}

fn seek(fd: u64, off: u64, whence: u64) -> u64 {
    return errno.check(kcall.sys3(kcall.SYS_LSEEK, fd, off, whence))
}

fn tell(fd: u64) -> u64 {
    return seek(fd, 0, kcall.SEEK_CUR)
}

fn dup(fd: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.SYS_DUP, fd))
}

fn dup2(from: u64, to: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_DUP2, from, to))
}

// `out` takes two `int`s: the reading end first, the writing end second.
fn pipe(out: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.SYS_PIPE, out))
}

fn unlink(path: u64) -> u64 {
    return errno.check(kcall.sys1(kcall.SYS_UNLINK, path))
}

fn make_dir(path: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_MKDIR, path, 493))
}

fn cwd(buf: u64, n: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_GETCWD, buf, n))
}

// --------------------------------------------------------------- stat

fn stat_into(path: u64, buf: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_STAT, path, buf))
}

fn fstat_into(fd: u64, buf: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_FSTAT, fd, buf))
}

// How big the file is, or -1. The structure lives on the stack for the
// length of the call -- a program that only wants the size should not have
// to know that a `struct stat` is 144 octets.
fn size_of(path: u64) -> u64 {
    var st: [u8; 144] = [0 as u8; 144]
    let r: u64 = stat_into(path, (&st[0]) as u64)
    if errno.failed(r) {
        return r
    }
    return __mmio_read64(((&st[0]) as u64 + ST_SIZE) as *mut u64)
}

fn stat_mode(path: u64) -> u64 {
    var st: [u8; 144] = [0 as u8; 144]
    let r: u64 = stat_into(path, (&st[0]) as u64)
    if errno.failed(r) {
        return r
    }
    return __mmio_read32(((&st[0]) as u64 + ST_MODE) as *mut u32) as u64
}

fn stat_size(buf: u64) -> u64 {
    return __mmio_read64((buf + ST_SIZE) as *mut u64)
}

// RUNDE OFS3: die Art aus einem SCHON GEFUELLTEN Puffer. `stat_mode`
// darueber macht selbst einen Systemaufruf und kann deshalb nicht sagen,
// was ein `lstat` gefunden hat.
fn stat_mode_of(buf: u64) -> u64 {
    return __mmio_read32((buf + ST_MODE) as *mut u32) as u64
}

fn is_dir_mode(mode: u64) -> bool {
    return (mode & S_IFMT) == S_IFDIR
}

// ========================================================== RUNDE OFS3

fn is_link_mode(mode: u64) -> bool {
    return (mode & S_IFMT) == S_IFLNK
}

// `lstat`: wie `stat`, aber es folgt dem letzten Verweis NICHT. Wer
// wissen will, OB etwas ein Verweis ist, muss diesen hier nehmen -- `stat`
// beantwortet die Frage nach dem ZIEL und kann deshalb nie `l` sagen.
fn lstat_into(path: u64, buf: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_LSTAT, path, buf))
}

fn stat_mtime(buf: u64) -> u64 {
    return __mmio_read64((buf + ST_MTIME) as *mut u64)
}

fn stat_ctime(buf: u64) -> u64 {
    return __mmio_read64((buf + ST_CTIME) as *mut u64)
}

fn stat_atime(buf: u64) -> u64 {
    return __mmio_read64((buf + ST_ATIME) as *mut u64)
}

fn stat_nlink(buf: u64) -> u64 {
    return __mmio_read64((buf + ST_NLINK) as *mut u64)
}

// Einen symbolischen Verweis anlegen: `wo` zeigt danach auf `ziel`.
// Die Reihenfolge ist die von POSIX (erst das Ziel), und sie ist genau
// andersherum als bei `cp` -- das ist nicht schoen, aber es ist die, die
// jedes Unix hat.
fn symlink(ziel: u64, wo: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_SYMLINK, ziel, wo))
}

// Das Ziel eines Verweises. Gibt die Zahl der Oktette OHNE Null zurueck;
// die Null anzuhaengen ist Sache des Aufrufers, und deshalb steht sie
// hier gleich mit drin.
fn readlink(path: u64, buf: u64, n: u64) -> u64 {
    let r: u64 = errno.check(kcall.sys3(kcall.SYS_READLINK, path, buf, n))
    if !errno.failed(r) && r < n {
        *((buf + r) as *mut u8) = 0 as u8
    }
    return r
}

// Die Zeiten setzen. `zeiten` ist ein Feld aus zwei `timespec`
// (Sekunden, Nanosekunden): erst die Zugriffs-, dann die Aenderungszeit.
// 0 heisst "auf jetzt".
fn set_times(path: u64, zeiten: u64) -> u64 {
    // AT_FDCWD ist -100. Dieser Kernel wertet den Deskriptor nicht aus,
    // aber die Zahl steht hier richtig, damit derselbe Aufruf auf einem
    // Linux dasselbe taete.
    return errno.check(kcall.sys4(kcall.SYS_UTIMENSAT, 0 -% 100, path,
            zeiten, 0))
}

fn touch_now(path: u64) -> u64 {
    return set_times(path, 0)
}

// Die Uhr, in Sekunden seit 1970 -- dieselbe Zahl, die im Inode steht.
// `time(2)` von Linux: ein Aufruf, ein Wort, kein Puffer.
fn now_sec() -> u64 {
    return kcall.sys1(kcall.SYS_TIME, 0)
}

// ---------------------------------------------------------- directories

// A directory is opened like a file, with the flag that says it must be
// one. Reading it is `getdents64`, and the caller walks the records with
// `dir_name` and `dir_kind`.
fn dir_open(path: u64) -> u64 {
    return errno.check(kcall.sys2(kcall.SYS_OPEN, path,
            kcall.O_DIRECTORY))
}

// Fills `buf` with as many records as fit. 0 = the directory is at its
// end. The caller walks the records itself:
//
//     var at: u64 = 0
//     while at < n {
//         say(io.dir_name(base + at))
//         at = at + io.dir_reclen(base + at)
//     }
fn dir_read(fd: u64, buf: u64, n: u64) -> u64 {
    return errno.check(kcall.sys3(kcall.SYS_GETDENTS64, fd, buf, n))
}

fn dir_name(rec: u64) -> u64 {
    return rec + D_NAME
}

fn dir_kind(rec: u64) -> u64 {
    return (*((rec + D_TYPE) as *mut u8)) as u64
}

// How long this record is. What walks the buffer -- a reader that counted
// on a fixed size would be wrong at the first long name.
fn dir_reclen(rec: u64) -> u64 {
    return __mmio_read16((rec + D_RECLEN) as *mut u16) as u64
}

// ================================================== RUNDE POLL
//
// AUF MEHRERE DESKRIPTOREN GLEICHZEITIG WARTEN. Ohne diesen Aufruf
// kann ein Programm dieses Systems auf genau eine Sache warten, und
// jeder Helfer, der ein Netz UND ein Kind bedient, muss auf zwei
// warten.
//
//     var fds: [u8; 16] = [0 as u8; 16]      // zwei Eintraege
//     io.poll_set((&fds[0]) as u64, 0, r0, io.POLLIN)
//     io.poll_set((&fds[0]) as u64, 1, r1, io.POLLIN)
//     let n: u64 = io.poll((&fds[0]) as u64, 2, 500)
//     if io.poll_ready((&fds[0]) as u64, 0, io.POLLIN) { ... }
//
// `struct pollfd` ist acht Oktette und hat die Form von Linux:
// fd (i32) bei 0, events (i16) bei 4, revents (i16) bei 6. Firn hat
// keine Struktur ueber Ring-3-Grenzen hinweg, also ist der Puffer ein
// Feld aus Oktetten und die vier Zugriffe darauf stehen hier -- an
// EINER Stelle, statt in jedem Programm noch einmal.
const PFD_BYTES: u64 = 8
const POLLIN: u64 = 1
const POLLPRI: u64 = 2
const POLLOUT: u64 = 4
const POLLERR: u64 = 8
const POLLHUP: u64 = 16
const POLLNVAL: u64 = 32
// `timeout` unter null: warten, bis wirklich etwas geschieht.
const POLL_FOREVER: u64 = 0xFFFFFFFFFFFFFFFF

fn st8(p: u64, off: u64, v: u64) {
    __mmio_write8((p + off) as *mut u8, (v & 255) as u8)
}

fn ld8(p: u64, off: u64) -> u64 {
    return __mmio_read8((p + off) as *mut u8) as u64
}

// Eintrag `i` besetzen: Deskriptor und die Ereignisse, auf die gewartet
// wird. `revents` wird dabei geleert -- ein Programm, das denselben
// Puffer noch einmal benutzt, saehe sonst die Antwort des letzten Laufs.
fn poll_set(fds: u64, i: u64, fd: u64, events: u64) {
    let a: u64 = fds + i * PFD_BYTES
    st8(a, 0, fd)
    st8(a, 1, fd >> 8)
    st8(a, 2, fd >> 16)
    st8(a, 3, fd >> 24)
    st8(a, 4, events)
    st8(a, 5, events >> 8)
    st8(a, 6, 0)
    st8(a, 7, 0)
}

fn poll_fd(fds: u64, i: u64) -> u64 {
    let a: u64 = fds + i * PFD_BYTES
    return ld8(a, 0) | (ld8(a, 1) << 8) | (ld8(a, 2) << 16) | (ld8(a, 3) << 24)
}

fn poll_revents(fds: u64, i: u64) -> u64 {
    let a: u64 = fds + i * PFD_BYTES
    return ld8(a, 6) | (ld8(a, 7) << 8)
}

// Ist bei Eintrag `i` eines der Bits in `what` gemeldet worden?
fn poll_ready(fds: u64, i: u64, what: u64) -> bool {
    return (poll_revents(fds, i) & what) != 0
}

// Der Aufruf selbst. Zurueck kommt die ZAHL der Deskriptoren mit einem
// Ereignis, 0 beim Zeitablauf -- und -1 mit `errno` im Fehlerfall, wie
// alles in dieser Datei.
fn poll(fds: u64, nfds: u64, timeout_ms: u64) -> u64 {
    return errno.check(kcall.sys3(kcall.SYS_POLL, fds, nfds, timeout_ms))
}
