// SPDX-License-Identifier: MIT
import libc.locks
import libc.threads
import libc.errno
import libc.pcancel

export { BYTES, SERIAL, DESTROYED, init, wait, destroy, count, arrived, busy, generation }

const BYTES: u64 = 32
const SERIAL: u64 = 1
const DESTROYED: u64 = 2
const OFF_COUNT: u64 = 0
const OFF_GEN: u64 = 16
const OFF_BUSY: u64 = 24
const WORD_MASK: u64 = 0xFFFFFFFF
const ARRIVAL_ONE: u64 = 0x100000000
const DRAIN_LIMIT: u64 = 2000
const TRIPPED: u64 = 0xFFFFFFFFFFFFFFFF

fn init(p: u64, threshold: u64) -> u64 {
    if threshold == 0 {
        return errno.E_INVAL
    }
    locks.store(p + OFF_COUNT, threshold)
    locks.store(p + OFF_GEN, 0)
    locks.store(p + OFF_BUSY, 0)
    return 0
}

fn count(p: u64) -> u64 {
    return locks.load(p + OFF_COUNT)
}

fn arrived(p: u64) -> u64 {
    return locks.load(p + OFF_GEN) >> 32
}

fn busy(p: u64) -> u64 {
    return locks.load(p + OFF_BUSY)
}

fn generation(p: u64) -> u64 {
    return locks.load(p + OFF_GEN) & WORD_MASK
}

fn leave(p: u64) {
    locks.fetch_add(p + OFF_BUSY, 0 -% 1)
}

fn arrive(p: u64) -> u64 {
    while true {
        let v: u64 = locks.load(p + OFF_GEN)
        if (v >> 32) + 1 >= locks.load(p + OFF_COUNT) {
            if locks.cas(p + OFF_GEN, v, (v + 1) & WORD_MASK) == v {
                return TRIPPED
            }
        } else {
            if locks.cas(p + OFF_GEN, v, v + ARRIVAL_ONE) == v {
                return v & WORD_MASK
            }
        }
    }
    return 0
}

fn withdraw(p: u64, gen: u64) -> bool {
    while true {
        let v: u64 = locks.load(p + OFF_GEN)
        if (v & WORD_MASK) != gen || (v >> 32) == 0 {
            return false
        }
        if locks.cas(p + OFF_GEN, v, v - ARRIVAL_ONE) == v {
            return true
        }
    }
    return false
}

fn wait(p: u64) -> u64 {
    if locks.load(p + OFF_COUNT) == 0 {
        return DESTROYED
    }
    locks.fetch_add(p + OFF_BUSY, 1)
    let gen: u64 = arrive(p)
    if gen == TRIPPED {
        locks.futex_wake(p + OFF_GEN, locks.WAKE_ALL)
        leave(p)
        return SERIAL
    }
    while generation(p) == gen {
        if pcancel.wait_on(p + OFF_GEN, gen) && withdraw(p, gen) {
            leave(p)
            pcancel.act()
        }
    }
    leave(p)
    return 0
}

fn destroy(p: u64) -> u64 {
    if arrived(p) != 0 {
        return errno.E_BUSY
    }
    var spins: u64 = 0
    while locks.load(p + OFF_BUSY) != 0 {
        if spins >= DRAIN_LIMIT {
            return errno.E_BUSY
        }
        threads.yield_now()
        spins = spins + 1
    }
    locks.store(p + OFF_COUNT, 0)
    return 0
}
