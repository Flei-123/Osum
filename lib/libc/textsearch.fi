import libc.text

export { starts_with, ends_with, find_text, equal_fold }

fn starts_with(p: u64, prefix: u64) -> bool {
    return text.equal_n(p, prefix, text.length(prefix)) && text.length(p) >= text.length(prefix)
}

fn ends_with(p: u64, suffix: u64) -> bool {
    let lp: u64 = text.length(p)
    let ls: u64 = text.length(suffix)
    if ls > lp {
        return false
    }
    return text.equal(p + lp - ls, suffix)
}

fn find_text(hay: u64, needle: u64) -> u64 {
    let ln: u64 = text.length(needle)
    let lh: u64 = text.length(hay)
    if ln == 0 {
        return hay
    }
    if ln > lh {
        return 0
    }
    var i: u64 = 0
    while i + ln <= lh {
        if text.equal_n(hay + i, needle, ln) {
            return hay + i
        }
        i = i + 1
    }
    return 0
}

fn equal_fold(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while true {
        let x: u64 = text.lower((*((a + i) as *mut u8)) as u64)
        let y: u64 = text.lower((*((b + i) as *mut u8)) as u64)
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return true
}
