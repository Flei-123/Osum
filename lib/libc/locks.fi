import libc.kcall

export { load, store, cas, fetch_add, spin_try, spin_take, spin_give, mutex_try, mutex_take, mutex_give, cond_wait, cond_signal, cond_broadcast, futex_wait, futex_wake }

const FUTEX_WAIT: u64 = 128
const FUTEX_WAKE: u64 = 129
const WAKE_ALL: u64 = 0x7FFFFFFF
const WORD_MASK: u64 = 0xFFFFFFFF

fn cas(p: u64, expect: u64, want: u64) -> u64 {
    return __atomic_swap(p as *mut u64, expect, want)
}

fn fetch_add(p: u64, delta: u64) -> u64 {
    return __atomic_add(p as *mut u64, delta)
}

fn load(p: u64) -> u64 {
    return __atomic_add(p as *mut u64, 0)
}

fn store(p: u64, v: u64) {
    var going: bool = true
    while going {
        let old: u64 = load(p)
        if cas(p, old, v) == old {
            going = false
        }
    }
}

fn spin_try(p: u64) -> bool {
    return cas(p, 0, 1) == 0
}

fn spin_take(p: u64) {
    while !spin_try(p) {
        give_way()
    }
}

fn spin_give(p: u64) {
    store(p, 0)
}

fn give_way() {
    kcall.sys0(kcall.SYS_YIELD)
}

fn futex_wait(p: u64, expect: u64) -> u64 {
    return kcall.sys4(kcall.SYS_FUTEX, p, FUTEX_WAIT, expect, 0)
}

fn futex_wake(p: u64, count: u64) -> u64 {
    return kcall.sys4(kcall.SYS_FUTEX, p, FUTEX_WAKE, count, 0)
}

fn mutex_try(p: u64) -> bool {
    return cas(p, 0, 1) == 0
}

fn mutex_take(p: u64) {
    var seen: u64 = cas(p, 0, 1)
    if seen == 0 {
        return
    }
    while true {
        if seen == 2 || cas(p, 1, 2) != 0 {
            futex_wait(p, 2)
        }
        seen = cas(p, 0, 2)
        if seen == 0 {
            return
        }
    }
}

fn mutex_give(p: u64) {
    if cas(p, 1, 0) == 1 {
        return
    }
    store(p, 0)
    futex_wake(p, 1)
}

fn cond_wait(cv: u64, mutex: u64) {
    let seq: u64 = load(cv) & WORD_MASK
    mutex_give(mutex)
    futex_wait(cv, seq)
    mutex_take(mutex)
}

fn cond_signal(cv: u64) {
    fetch_add(cv, 1)
    futex_wake(cv, 1)
}

fn cond_broadcast(cv: u64) {
    fetch_add(cv, 1)
    futex_wake(cv, WAKE_ALL)
}
