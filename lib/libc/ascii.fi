// SPDX-License-Identifier: MIT
export { lower, is_digit, is_blank }

fn lower(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

fn is_digit(c: u64) -> bool {
    return c >= 48 && c <= 57
}

fn is_blank(c: u64) -> bool {
    return c == 32 || c == 9 || c == 13
}
