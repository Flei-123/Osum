import libc.locks
import libc.threads

export { record, passed, failed, wait_for }

const POLL_LIMIT: u64 = 3000

static mut pass_total: u64 = 0
static mut fail_total: u64 = 0

fn record(ok: bool) {
    if ok {
        pass_total = pass_total + 1
    } else {
        fail_total = fail_total + 1
    }
}

fn passed() -> u64 {
    return pass_total
}

fn failed() -> u64 {
    return fail_total
}

fn wait_for(p: u64, want: u64) -> bool {
    var waited: u64 = 0
    while locks.load(p) < want && waited < POLL_LIMIT {
        threads.sleep_ms(1)
        waited = waited + 1
    }
    return locks.load(p) >= want
}
