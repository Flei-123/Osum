// SPDX-License-Identifier: MIT
export { record, passed, failed }

static mut pass_total: u64 = 0
static mut fail_total: u64 = 0

fn record(ok: bool) {
    if ok {
        pass_total = pass_total + 1
    } else {
        fail_total = fail_total + 1
    }
}

fn passed() -> u64 {
    return pass_total
}

fn failed() -> u64 {
    return fail_total
}
