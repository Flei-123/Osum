import libc.kcall
import libc.errno
import libc.threads
import libc.octets

export { NAME_MAX, SIG_BLOCK, SIG_UNBLOCK, SIG_SETMASK, sigmask, setname }

const NAME_MAX: u64 = 15
const SIG_BLOCK: u64 = 0
const SIG_UNBLOCK: u64 = 1
const SIG_SETMASK: u64 = 2
const PR_SET_NAME: u64 = 15
const SIGSET_BYTES: u64 = 8

fn name_length(name: u64) -> u64 {
    var n: u64 = 0
    while n <= NAME_MAX && octets.ld8(name, n) != 0 {
        n = n + 1
    }
    return n
}

fn sigmask(how: u64, set: u64, old: u64) -> u64 {
    let r: u64 = kcall.sys4(kcall.SYS_RT_SIGPROCMASK, how, set, old, SIGSET_BYTES)
    if errno.is_error(r) {
        return 0 -% r
    }
    return 0
}

fn setname(t: u64, name: u64) -> u64 {
    if name_length(name) > NAME_MAX {
        return errno.E_RANGE
    }
    if t != threads.current() {
        return errno.E_NOSYS
    }
    let r: u64 = kcall.sys2(kcall.SYS_PRCTL, PR_SET_NAME, name)
    if errno.is_error(r) {
        return 0 -% r
    }
    return 0
}
