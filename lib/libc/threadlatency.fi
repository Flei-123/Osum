import libc.threads
import libc.clockapi

export { join_latency_ok, worst_ticks }

const THREAD_MS: u64 = 30
const ROUNDS: u64 = 6
const BUDGET_TICKS: u64 = 40

static mut worst: u64 = 0

fn sleeper(arg: u64) -> u64 {
    threads.sleep_ms(THREAD_MS)
    return arg
}

fn join_latency_ok() -> bool {
    var i: u64 = 0
    worst = 0
    while i < ROUNDS {
        let t0: u64 = clockapi.ticks()
        let h: u64 = threads.spawn(sleeper, i)
        if h == 0 {
            return false
        }
        if threads.join(h) != i {
            return false
        }
        let used: u64 = clockapi.ticks() - t0
        if used > worst {
            worst = used
        }
        i = i + 1
    }
    return worst <= BUDGET_TICKS
}

fn worst_ticks() -> u64 {
    return worst
}
