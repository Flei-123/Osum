import libc.text
import libc.octets

export { base_name, parent_length, is_absolute, extension, join }

fn base_name(p: u64) -> u64 {
    var i: u64 = text.length(p)
    while i > 0 {
        i = i - 1
        if *((p + i) as *mut u8) == 47 as u8 {
            return p + i + 1
        }
    }
    return p
}

fn parent_length(p: u64) -> u64 {
    let at: u64 = base_name(p) - p
    if at <= 1 {
        return at
    }
    return at - 1
}

fn is_absolute(p: u64) -> bool {
    return *(p as *mut u8) == 47 as u8
}

fn extension(p: u64) -> u64 {
    let base: u64 = base_name(p)
    var i: u64 = text.length(base)
    while i > 0 {
        i = i - 1
        if *((base + i) as *mut u8) == 46 as u8 {
            return base + i + 1
        }
    }
    return 0
}

fn join(out: u64, cap: u64, a: u64, b: u64) -> u64 {
    let la: u64 = text.length(a)
    let lb: u64 = text.length(b)
    if is_absolute(b) || la == 0 {
        if lb + 1 > cap {
            return 0 -% 1
        }
        copy_bytes(out, b, lb + 1)
        return lb
    }
    var slash: u64 = 1
    if *((a + la - 1) as *mut u8) == 47 as u8 {
        slash = 0
    }
    if la + slash + lb + 1 > cap {
        return 0 -% 1
    }
    copy_bytes(out, a, la)
    if slash == 1 {
        *((out + la) as *mut u8) = 47 as u8
    }
    copy_bytes(out + la + slash, b, lb + 1)
    return la + slash + lb
}

fn copy_bytes(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        octets.st8(dst, i, octets.ld8(src, i))
        i = i + 1
    }
}
