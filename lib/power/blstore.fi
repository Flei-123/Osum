// SPDX-License-Identifier: GPL-2.0-only
export { Saver, saver_new, parse, format, track, NONE, MIN_PCT, MAX_PCT, SETTLE_ROUNDS }

const NONE: u64 = 0xFFFFFFFF
const MIN_PCT: u64 = 5
const MAX_PCT: u64 = 100
const SETTLE_ROUNDS: u64 = 8

struct Saver {
    last: u64,
    saved: u64,
    stable: u64,
}

static mut k_percent: [u8; 8] = "percent\0"

fn saver_new(initial: u64) -> Saver {
    return Saver { last: initial, saved: initial, stable: 0 }
}

fn b8(p: u64, i: u64) -> u8 {
    return *((p + i) as *mut u8)
}

fn is_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn parse(text: u64) -> u64 {
    var at: u64 = 0
    while b8(text, at) != 0 as u8 {
        var i: u64 = 0
        while b8((&k_percent[0 as usize]) as u64, i) != 0 as u8 && b8(text, at + i) == b8((&k_percent[0 as usize]) as u64, i) {
            i = i + 1
        }
        if b8((&k_percent[0 as usize]) as u64, i) == 0 as u8 && b8(text, at + i) == 61 as u8 {
            var p: u64 = at + i + 1
            if !is_digit(b8(text, p)) {
                return NONE
            }
            var v: u64 = 0
            while is_digit(b8(text, p)) {
                if v < 100000 {
                    v = v * 10 + ((b8(text, p) as u64) - 48)
                }
                p = p + 1
            }
            if v < MIN_PCT || v > MAX_PCT {
                return NONE
            }
            return v
        }
        while b8(text, at) != 0 as u8 && b8(text, at) != 10 as u8 {
            at = at + 1
        }
        if b8(text, at) == 10 as u8 {
            at = at + 1
        }
    }
    return NONE
}

fn format(pct: u64, out: u64, cap: u64) -> u64 {
    if cap < 16 || pct < MIN_PCT || pct > MAX_PCT {
        return 0
    }
    var n: u64 = 0
    while b8((&k_percent[0 as usize]) as u64, n) != 0 as u8 {
        *((out + n) as *mut u8) = b8((&k_percent[0 as usize]) as u64, n)
        n = n + 1
    }
    *((out + n) as *mut u8) = 61 as u8
    n = n + 1
    if pct >= 100 {
        *((out + n) as *mut u8) = 49 as u8
        *((out + n + 1) as *mut u8) = 48 as u8
        *((out + n + 2) as *mut u8) = 48 as u8
        n = n + 3
    } else if pct >= 10 {
        *((out + n) as *mut u8) = (48 + pct / 10) as u8
        *((out + n + 1) as *mut u8) = (48 + pct % 10) as u8
        n = n + 2
    } else {
        *((out + n) as *mut u8) = (48 + pct) as u8
        n = n + 1
    }
    *((out + n) as *mut u8) = 10 as u8
    n = n + 1
    *((out + n) as *mut u8) = 0 as u8
    return n
}

fn track(s: *mut Saver, pct: u64) -> bool {
    if pct < MIN_PCT || pct > MAX_PCT {
        return false
    }
    if pct != (*s).last {
        (*s).last = pct
        (*s).stable = 0
        return false
    }
    if pct == (*s).saved {
        return false
    }
    (*s).stable = (*s).stable + 1
    if (*s).stable < SETTLE_ROUNDS {
        return false
    }
    (*s).saved = pct
    (*s).stable = 0
    return true
}
