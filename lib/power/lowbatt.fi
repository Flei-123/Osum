export {
    level, decide,
    EVENT_NONE, EVENT_WARN, EVENT_SHUTDOWN,
    LEVEL_OK, LEVEL_WARN, LEVEL_CRITICAL,
    WARN_PERCENT, SHUTDOWN_PERCENT, RESET_PERCENT
}

const LEVEL_OK: u64 = 0
const LEVEL_WARN: u64 = 1
const LEVEL_CRITICAL: u64 = 2

const EVENT_NONE: u64 = 0
const EVENT_WARN: u64 = 1
const EVENT_SHUTDOWN: u64 = 2

const WARN_PERCENT: u64 = 10
const SHUTDOWN_PERCENT: u64 = 5
const RESET_PERCENT: u64 = 15

fn level(valid: bool, discharging: bool, percent: u64) -> u64 {
    if !valid || !discharging {
        return LEVEL_OK
    }
    if percent <= SHUTDOWN_PERCENT {
        return LEVEL_CRITICAL
    }
    if percent <= WARN_PERCENT {
        return LEVEL_WARN
    }
    return LEVEL_OK
}

fn decide(current: u64, percent: u64, discharging: bool, seen: *mut u64) -> u64 {
    if current == LEVEL_OK {
        if !discharging || percent >= RESET_PERCENT {
            *seen = LEVEL_OK
        }
        return EVENT_NONE
    }
    if current <= *seen {
        return EVENT_NONE
    }
    *seen = current
    if current == LEVEL_CRITICAL {
        return EVENT_SHUTDOWN
    }
    return EVENT_WARN
}
