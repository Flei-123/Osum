export { IMAGE_RESERVE_BLOCKS, GPT_TAIL_BLOCKS, image_base, last_data_block }

const IMAGE_RESERVE_BLOCKS: u64 = 4096
const GPT_TAIL_BLOCKS: u64 = 33

fn image_base(disk_blocks: u64) -> u64 {
    if disk_blocks <= IMAGE_RESERVE_BLOCKS + GPT_TAIL_BLOCKS {
        return 0
    }
    return disk_blocks - GPT_TAIL_BLOCKS - IMAGE_RESERVE_BLOCKS
}

fn last_data_block(disk_blocks: u64) -> u64 {
    return disk_blocks - 1 - GPT_TAIL_BLOCKS - IMAGE_RESERVE_BLOCKS
}
