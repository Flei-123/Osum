import std.rt
import vulkan.vkobj

export { vkCreatePipelineCache, vkDestroyPipelineCache, vkGetPipelineCacheData, vkMergePipelineCaches, vkCreateBufferView, vkDestroyBufferView }

#[export_c]
fn vkCreatePipelineCache(dev: u64, info: u64, alloc: u64, out: u64) -> i32 {
    let h: u64 = vkobj.obj_new(vkobj.K_PCACHE)
    if h == 0 as u64 { return -1 }
    rt.st64(out, 0, h)
    return 0
}

#[export_c]
fn vkDestroyPipelineCache(dev: u64, cache: u64, alloc: u64) {
    vkobj.obj_free(cache, vkobj.K_PCACHE)
}

#[export_c]
fn vkGetPipelineCacheData(dev: u64, cache: u64, size: u64, data: u64) -> i32 {
    if size != 0 as u64 { rt.st64(size, 0, 0 as u64) }
    return 0
}

#[export_c]
fn vkMergePipelineCaches(dev: u64, dst: u64, count: u32, srcs: u64) -> i32 {
    return 0
}

#[export_c]
fn vkCreateBufferView(dev: u64, info: u64, alloc: u64, out: u64) -> i32 {
    rt.st64(out, 0, 0 as u64)
    return -8
}

#[export_c]
fn vkDestroyBufferView(dev: u64, view: u64, alloc: u64) {
}
