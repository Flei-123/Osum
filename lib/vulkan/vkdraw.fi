import std.rt
import vulkan.vkobj
import vulkan.vkcmd

export { vkCmdBeginRendering, vkCmdEndRendering, vkCmdBindPipeline, vkCmdBindVertexBuffers, vkCmdBindIndexBuffer, vkCmdBindDescriptorSets, vkCmdPushConstants, vkCmdSetViewport, vkCmdSetScissor, vkCmdDraw, vkCmdDrawIndexed }

const PUSH_CHUNK: u64 = 40

#[export_c]
fn vkCmdBeginRendering(cb: u64, info: u64) {
    let r: u64 = vkcmd.rec_new(cb, vkcmd.OP_BEGIN_RENDERING)
    if r == 0 as u64 { return }
    let ncolor: u32 = rt.ld32(info + 44 as u64, 0)
    let pcolor: u64 = rt.ld64(info + 48 as u64, 0)
    let pdepth: u64 = rt.ld64(info + 56 as u64, 0)
    if ncolor != 0 as u32 && pcolor != 0 as u64 {
        rt.st64(r, 1, rt.ld64(pcolor + 16 as u64, 0))
        rt.st64(r, 2, (rt.ld32(pcolor + 52 as u64, 0) as u64) | ((rt.ld32(pcolor + 56 as u64, 0) as u64) << 32 as u64))
        rt.st64(r, 3, (rt.ld32(pcolor + 60 as u64, 0) as u64) | ((rt.ld32(pcolor + 64 as u64, 0) as u64) << 32 as u64))
        rt.st64(r, 4, rt.ld32(pcolor + 44 as u64, 0) as u64)
    }
    if pdepth != 0 as u64 {
        rt.st64(r, 5, rt.ld64(pdepth + 16 as u64, 0))
        rt.st64(r, 6, rt.ld32(pdepth + 52 as u64, 0) as u64)
        rt.st64(r, 4, rt.ld64(r, 4) | ((rt.ld32(pdepth + 44 as u64, 0) as u64) << 8 as u64))
    }
    let ax: u64 = (rt.ld32(info + 20 as u64, 0) as u64) & 0xFFFF as u64
    let pstencil: u64 = rt.ld64(info + 64 as u64, 0)
    let ay: u64 = (rt.ld32(info + 24 as u64, 0) as u64) & 0xFFFF as u64
    let aw: u64 = (rt.ld32(info + 28 as u64, 0) as u64) & 0xFFFF as u64
    let ah: u64 = (rt.ld32(info + 32 as u64, 0) as u64) & 0xFFFF as u64
    rt.st64(r, 7, ax | (ay << 16 as u64) | (aw << 32 as u64) | (ah << 48 as u64))
    if pstencil != 0 as u64 {
        let s: u64 = vkcmd.rec_new(cb, vkcmd.OP_BEGIN_STENCIL)
        if s == 0 as u64 { return }
        rt.st64(s, 1, rt.ld64(pstencil + 16 as u64, 0))
        rt.st64(s, 2, rt.ld32(pstencil + 44 as u64, 0) as u64)
        rt.st64(s, 3, rt.ld32(pstencil + 56 as u64, 0) as u64)
    }
}

#[export_c]
fn vkCmdEndRendering(cb: u64) {
    vkcmd.rec_new(cb, vkcmd.OP_END_RENDERING)
}

#[export_c]
fn vkCmdBindPipeline(cb: u64, point: u32, pipe: u64) {
    let r: u64 = vkcmd.rec_new(cb, vkcmd.OP_BIND_PIPELINE)
    if r == 0 as u64 { return }
    rt.st64(r, 1, pipe)
}

#[export_c]
fn vkCmdBindVertexBuffers(cb: u64, first: u32, count: u32, bufs: u64, offsets: u64) {
    var i: u32 = 0 as u32
    while i < count {
        let r: u64 = vkcmd.rec_new(cb, vkcmd.OP_BIND_VERTEX)
        if r == 0 as u64 { return }
        rt.st64(r, 1, (first + i) as u64)
        rt.st64(r, 2, rt.ld64(bufs, i as usize))
        rt.st64(r, 3, rt.ld64(offsets, i as usize))
        i = i + 1 as u32
    }
}

#[export_c]
fn vkCmdBindIndexBuffer(cb: u64, buf: u64, offset: u64, itype: u32) {
    let r: u64 = vkcmd.rec_new(cb, vkcmd.OP_BIND_INDEX)
    if r == 0 as u64 { return }
    rt.st64(r, 1, buf)
    rt.st64(r, 2, offset)
    rt.st64(r, 3, itype as u64)
}

#[export_c]
fn vkCmdBindDescriptorSets(cb: u64, point: u32, layout: u64, first: u32, count: u32, sets: u64, dynCount: u32, dyn: u64) {
    var i: u32 = 0 as u32
    var used: u32 = 0 as u32
    while i < count {
        let r: u64 = vkcmd.rec_new(cb, vkcmd.OP_BIND_SET)
        if r == 0 as u64 { return }
        rt.st64(r, 1, (first + i) as u64)
        let set: u64 = rt.ld64(sets, i as usize)
        rt.st64(r, 2, set)
        let mask: u64 = vkobj.obj_get(set, vkobj.K_DSET, 1)
        rt.st64(r, 3, mask)
        var k: u64 = 0 as u64
        var b: u64 = 0 as u64
        while b < 8 as u64 {
            if ((mask >> b) & 1 as u64) != 0 as u64 {
                if used < dynCount && k < 4 as u64 { rt.st64(r, 4 + (k as usize), rt.ld32(dyn, used as usize) as u64) }
                used = used + 1 as u32
                k = k + 1 as u64
            }
            b = b + 1 as u64
        }
        i = i + 1 as u32
    }
}

#[export_c]
fn vkCmdPushConstants(cb: u64, layout: u64, stages: u32, offset: u32, size: u32, data: u64) {
    var done: u64 = 0 as u64
    while done < (size as u64) {
        var n: u64 = (size as u64) - done
        if n > PUSH_CHUNK { n = PUSH_CHUNK }
        let r: u64 = vkcmd.rec_new(cb, vkcmd.OP_PUSH)
        if r == 0 as u64 { return }
        rt.st64(r, 1, (offset as u64) + done)
        rt.st64(r, 2, n)
        rt.mem_copy(r + 24 as u64, data + done, n as usize)
        done = done + n
    }
}

#[export_c]
fn vkCmdSetViewport(cb: u64, first: u32, count: u32, viewports: u64) {
    if count == 0 as u32 { return }
    let r: u64 = vkcmd.rec_new(cb, vkcmd.OP_VIEWPORT)
    if r == 0 as u64 { return }
    rt.mem_copy(r + 8 as u64, viewports, 24)
}

#[export_c]
fn vkCmdSetScissor(cb: u64, first: u32, count: u32, rects: u64) {
    if count == 0 as u32 { return }
    let r: u64 = vkcmd.rec_new(cb, vkcmd.OP_SCISSOR)
    if r == 0 as u64 { return }
    rt.mem_copy(r + 8 as u64, rects, 16)
}

#[export_c]
fn vkCmdDraw(cb: u64, vertexCount: u32, instanceCount: u32, firstVertex: u32, firstInstance: u32) {
    let r: u64 = vkcmd.rec_new(cb, vkcmd.OP_DRAW)
    if r == 0 as u64 { return }
    rt.st64(r, 1, vertexCount as u64)
    rt.st64(r, 2, instanceCount as u64)
    rt.st64(r, 3, firstVertex as u64)
    rt.st64(r, 4, firstInstance as u64)
}

#[export_c]
fn vkCmdDrawIndexed(cb: u64, indexCount: u32, instanceCount: u32, firstIndex: u32, vertexOffset: i32, firstInstance: u32) {
    let r: u64 = vkcmd.rec_new(cb, vkcmd.OP_DRAW_INDEXED)
    if r == 0 as u64 { return }
    rt.st64(r, 1, indexCount as u64)
    rt.st64(r, 2, instanceCount as u64)
    rt.st64(r, 3, firstIndex as u64)
    rt.st64(r, 4, (vertexOffset as i64) as u64)
    rt.st64(r, 5, firstInstance as u64)
}
