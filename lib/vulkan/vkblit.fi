import std.rt
import vulkan.vkobj
import vulkan.vkres
import vulkan.vkcmd

export { vkCmdBlitImage, exec_blit }

fn pack2(a: u32, b: u32) -> u64 {
    return (a as u64) | ((b as u64) << 32 as u64)
}

#[export_c]
fn vkCmdBlitImage(cb: u64, src: u64, srcLayout: u32, dst: u64, dstLayout: u32, count: u32, regions: u64, filter: u32) {
    var i: u32 = 0 as u32
    while i < count {
        let g: u64 = regions + (i as u64) * 80 as u64
        let r: u64 = vkcmd.rec_new(cb, vkcmd.OP_BLIT)
        if r == 0 as u64 { return }
        rt.st64(r, 1, src)
        rt.st64(r, 2, dst)
        rt.st64(r, 3, pack2(rt.ld32(g + 16 as u64, 0), rt.ld32(g + 20 as u64, 0)))
        rt.st64(r, 4, pack2(rt.ld32(g + 28 as u64, 0), rt.ld32(g + 32 as u64, 0)))
        rt.st64(r, 5, pack2(rt.ld32(g + 56 as u64, 0), rt.ld32(g + 60 as u64, 0)))
        rt.st64(r, 6, pack2(rt.ld32(g + 68 as u64, 0), rt.ld32(g + 72 as u64, 0)))
        rt.st64(r, 7, filter as u64)
        i = i + 1 as u32
    }
}

fn lo32(v: u64) -> i64 {
    return (v & 0xFFFFFFFF as u64) as u32 as i32 as i64
}

fn hi32(v: u64) -> i64 {
    return (v >> 32 as u64) as u32 as i32 as i64
}

fn abs64(v: i64) -> i64 {
    if v < 0 as i64 { return 0 as i64 - v }
    return v
}

fn floor_div(num: i64, den: i64) -> i64 {
    if num >= 0 as i64 { return num / den }
    return 0 as i64 - ((0 as i64 - num + den - 1 as i64) / den)
}

fn clamp64(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn min64(a: i64, b: i64) -> i64 {
    if a < b { return a }
    return b
}

fn max64(a: i64, b: i64) -> i64 {
    if a > b { return a }
    return b
}

fn texel(p: u64, w: i64, x: i64, y: i64) -> u32 {
    return rt.ld32(p, (y * w + x) as usize)
}

fn mix_channel(a: u32, b: u32, c: u32, d: u32, sh: u32, fx: i64, fy: i64) -> u32 {
    let ca: i64 = ((a >> sh) & 255 as u32) as i64
    let cb: i64 = ((b >> sh) & 255 as u32) as i64
    let cc: i64 = ((c >> sh) & 255 as u32) as i64
    let cd: i64 = ((d >> sh) & 255 as u32) as i64
    let top: i64 = ca * (256 as i64 - fx) + cb * fx
    let bot: i64 = cc * (256 as i64 - fx) + cd * fx
    let v: i64 = (top * (256 as i64 - fy) + bot * fy + 32768 as i64) / 65536 as i64
    return (clamp64(v, 0 as i64, 255 as i64) as u32) << sh
}

fn swap_rb_px(v: u32) -> u32 {
    return (v & 0xFF00FF00 as u32) | ((v >> 16 as u32) & 255 as u32) | ((v & 255 as u32) << 16 as u32)
}

fn exec_blit(rec: u64) {
    let src: u64 = rt.ld64(rec, 1)
    let dst: u64 = rt.ld64(rec, 2)
    let sp: u64 = vkres.res_addr(vkobj.K_IMAGE, src)
    let dp: u64 = vkres.res_addr(vkobj.K_IMAGE, dst)
    if sp == 0 as u64 || dp == 0 as u64 { return }
    let sfmt: u32 = vkobj.obj_get(src, vkobj.K_IMAGE, 4) as u32
    let dfmt: u32 = vkobj.obj_get(dst, vkobj.K_IMAGE, 4) as u32
    if vkres.image_bpp(sfmt) != 4 as u64 || vkres.image_bpp(dfmt) != 4 as u64 { return }
    if sfmt == 126 as u32 || dfmt == 126 as u32 { return }
    let sw: i64 = vkobj.obj_get(src, vkobj.K_IMAGE, 2) as i64
    let sh: i64 = vkobj.obj_get(src, vkobj.K_IMAGE, 3) as i64
    let dw: i64 = vkobj.obj_get(dst, vkobj.K_IMAGE, 2) as i64
    let dh: i64 = vkobj.obj_get(dst, vkobj.K_IMAGE, 3) as i64
    let sx0: i64 = lo32(rt.ld64(rec, 3))
    let sy0: i64 = hi32(rt.ld64(rec, 3))
    let sx1: i64 = lo32(rt.ld64(rec, 4))
    let sy1: i64 = hi32(rt.ld64(rec, 4))
    let dx0: i64 = lo32(rt.ld64(rec, 5))
    let dy0: i64 = hi32(rt.ld64(rec, 5))
    let dx1: i64 = lo32(rt.ld64(rec, 6))
    let dy1: i64 = hi32(rt.ld64(rec, 6))
    let linear: bool = rt.ld64(rec, 7) == 1 as u64
    let adw: i64 = abs64(dx1 - dx0)
    let adh: i64 = abs64(dy1 - dy0)
    if adw == 0 as i64 || adh == 0 as i64 { return }
    let dminx: i64 = min64(dx0, dx1)
    let dminy: i64 = min64(dy0, dy1)
    if dminx < 0 as i64 || dminy < 0 as i64 || dminx + adw > dw || dminy + adh > dh { return }
    let sminx: i64 = min64(sx0, sx1)
    let sminy: i64 = min64(sy0, sy1)
    let smaxx: i64 = max64(sx0, sx1)
    let smaxy: i64 = max64(sy0, sy1)
    if sminx < 0 as i64 || sminy < 0 as i64 || smaxx > sw || smaxy > sh { return }
    if smaxx == sminx || smaxy == sminy { return }
    let swap: bool = sfmt != dfmt
    let ddx: i64 = 1 as i64
    var y: i64 = 0 as i64
    while y < adh {
        var ty: i64 = dy0 + y
        if dy1 < dy0 { ty = dy0 - 1 as i64 - y }
        let numy: i64 = sy0 * 2 as i64 * adh + (2 as i64 * y + 1 as i64) * (sy1 - sy0)
        let deny: i64 = 2 as i64 * adh
        var x: i64 = 0 as i64
        while x < adw {
            var tx: i64 = dx0 + x
            if dx1 < dx0 { tx = dx0 - 1 as i64 - x }
            let numx: i64 = sx0 * 2 as i64 * adw + (2 as i64 * x + 1 as i64) * (sx1 - sx0)
            let denx: i64 = 2 as i64 * adw
            var px: u32 = 0 as u32
            if !linear {
                let cx: i64 = clamp64(floor_div(numx, denx), sminx, smaxx - 1 as i64)
                let cy: i64 = clamp64(floor_div(numy, deny), sminy, smaxy - 1 as i64)
                px = texel(sp, sw, cx, cy)
            } else {
                let fxp: i64 = floor_div(numx * 256 as i64, denx) - 128 as i64
                let fyp: i64 = floor_div(numy * 256 as i64, deny) - 128 as i64
                let ix: i64 = floor_div(fxp, 256 as i64)
                let iy: i64 = floor_div(fyp, 256 as i64)
                let fx: i64 = fxp - ix * 256 as i64
                let fy: i64 = fyp - iy * 256 as i64
                let x0: i64 = clamp64(ix, sminx, smaxx - 1 as i64)
                let x1: i64 = clamp64(ix + 1 as i64, sminx, smaxx - 1 as i64)
                let y0: i64 = clamp64(iy, sminy, smaxy - 1 as i64)
                let y1: i64 = clamp64(iy + 1 as i64, sminy, smaxy - 1 as i64)
                let a: u32 = texel(sp, sw, x0, y0)
                let b: u32 = texel(sp, sw, x1, y0)
                let c: u32 = texel(sp, sw, x0, y1)
                let d: u32 = texel(sp, sw, x1, y1)
                px = mix_channel(a, b, c, d, 0 as u32, fx, fy) | mix_channel(a, b, c, d, 8 as u32, fx, fy) | mix_channel(a, b, c, d, 16 as u32, fx, fy) | mix_channel(a, b, c, d, 24 as u32, fx, fy)
            }
            if swap { px = swap_rb_px(px) }
            rt.st32(dp, (ty * dw + tx) as usize, px)
            x = x + ddx
        }
        y = y + 1 as i64
    }
}
