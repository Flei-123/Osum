import std.rt
import vulkan.vkobj

export { vkCreateCommandPool, vkDestroyCommandPool, vkResetCommandPool, vkAllocateCommandBuffers, vkFreeCommandBuffers, vkBeginCommandBuffer, vkEndCommandBuffer, vkResetCommandBuffer, vkCmdClearColorImage, vkCmdCopyBuffer, vkCmdCopyImageToBuffer, vkCmdCopyBufferToImage, vkCmdFillBuffer, vkCmdPipelineBarrier, OP_CLEAR, OP_COPY_BUFFER, OP_IMAGE_TO_BUFFER, OP_BUFFER_TO_IMAGE, OP_FILL, CMD_WORDS, CMD_CAP }

const OP_CLEAR: u64 = 1
const OP_COPY_BUFFER: u64 = 2
const OP_IMAGE_TO_BUFFER: u64 = 3
const OP_BUFFER_TO_IMAGE: u64 = 4
const OP_FILL: u64 = 5
const CMD_WORDS: usize = 8
const CMD_CAP: usize = 4096

#[export_c]
fn vkCreateCommandPool(dev: u64, info: u64, alloc: u64, out: u64) -> i32 {
    let h: u64 = vkobj.obj_new(vkobj.K_POOL)
    if h == 0 as u64 { return -1 }
    rt.st64(out, 0, h)
    return 0
}

#[export_c]
fn vkDestroyCommandPool(dev: u64, pool: u64, alloc: u64) {
    vkobj.obj_free(pool, vkobj.K_POOL)
}

#[export_c]
fn vkResetCommandPool(dev: u64, pool: u64, flags: u32) -> i32 {
    return 0
}

#[export_c]
fn vkAllocateCommandBuffers(dev: u64, info: u64, out: u64) -> i32 {
    let n: u32 = rt.ld32(info + 28 as u64, 0)
    var i: u32 = 0 as u32
    while i < n {
        let h: u64 = vkobj.obj_new(vkobj.K_CMDBUF)
        if h == 0 as u64 { return -1 }
        let list: u64 = rt.heap_alloc(CMD_CAP * CMD_WORDS * 8)
        vkobj.obj_set(h, vkobj.K_CMDBUF, 0, list)
        rt.st64(out, i as usize, h)
        i = i + 1 as u32
    }
    return 0
}

#[export_c]
fn vkFreeCommandBuffers(dev: u64, pool: u64, count: u32, bufs: u64) {
    var i: u32 = 0 as u32
    while i < count {
        let h: u64 = rt.ld64(bufs, i as usize)
        let list: u64 = vkobj.obj_get(h, vkobj.K_CMDBUF, 0)
        if list != 0 as u64 { rt.heap_free(list, CMD_CAP * CMD_WORDS * 8) }
        vkobj.obj_free(h, vkobj.K_CMDBUF)
        i = i + 1 as u32
    }
}

#[export_c]
fn vkBeginCommandBuffer(cb: u64, info: u64) -> i32 {
    vkobj.obj_set(cb, vkobj.K_CMDBUF, 1, 0 as u64)
    return 0
}

#[export_c]
fn vkEndCommandBuffer(cb: u64) -> i32 {
    return 0
}

#[export_c]
fn vkResetCommandBuffer(cb: u64, flags: u32) -> i32 {
    vkobj.obj_set(cb, vkobj.K_CMDBUF, 1, 0 as u64)
    return 0
}

fn rec_new(cb: u64, op: u64) -> u64 {
    let list: u64 = vkobj.obj_get(cb, vkobj.K_CMDBUF, 0)
    let n: u64 = vkobj.obj_get(cb, vkobj.K_CMDBUF, 1)
    if list == 0 as u64 { return 0 as u64 }
    if n >= (CMD_CAP as u64) { return 0 as u64 }
    vkobj.obj_set(cb, vkobj.K_CMDBUF, 1, n + 1 as u64)
    let r: u64 = list + n * (CMD_WORDS as u64) * 8 as u64
    rt.mem_set(r, 0 as u8, CMD_WORDS * 8)
    rt.st64(r, 0, op)
    return r
}

#[export_c]
fn vkCmdClearColorImage(cb: u64, img: u64, layout: u32, color: u64, rangeCount: u32, ranges: u64) {
    let r: u64 = rec_new(cb, OP_CLEAR)
    if r == 0 as u64 { return }
    rt.st64(r, 1, img)
    rt.st64(r, 2, rt.ld64(color, 0))
    rt.st64(r, 3, rt.ld64(color, 1))
}

#[export_c]
fn vkCmdCopyBuffer(cb: u64, src: u64, dst: u64, count: u32, regions: u64) {
    var i: u32 = 0 as u32
    while i < count {
        let r: u64 = rec_new(cb, OP_COPY_BUFFER)
        if r == 0 as u64 { return }
        rt.st64(r, 1, src)
        rt.st64(r, 2, dst)
        rt.st64(r, 3, rt.ld64(regions + (i as u64) * 24 as u64, 0))
        rt.st64(r, 4, rt.ld64(regions + (i as u64) * 24 as u64, 1))
        rt.st64(r, 5, rt.ld64(regions + (i as u64) * 24 as u64, 2))
        i = i + 1 as u32
    }
}

fn rec_image_copy(cb: u64, op: u64, img: u64, buf: u64, count: u32, regions: u64) {
    var i: u32 = 0 as u32
    while i < count {
        let g: u64 = regions + (i as u64) * 56 as u64
        let r: u64 = rec_new(cb, op)
        if r == 0 as u64 { return }
        rt.st64(r, 1, img)
        rt.st64(r, 2, buf)
        rt.st64(r, 3, rt.ld64(g, 0))
        rt.st64(r, 4, (rt.ld32(g + 8 as u64, 0) as u64) | ((rt.ld32(g + 12 as u64, 0) as u64) << 32 as u64))
        rt.st64(r, 5, (rt.ld32(g + 32 as u64, 0) as u64) | ((rt.ld32(g + 36 as u64, 0) as u64) << 32 as u64))
        rt.st64(r, 6, (rt.ld32(g + 44 as u64, 0) as u64) | ((rt.ld32(g + 48 as u64, 0) as u64) << 32 as u64))
        i = i + 1 as u32
    }
}

#[export_c]
fn vkCmdCopyImageToBuffer(cb: u64, img: u64, layout: u32, buf: u64, count: u32, regions: u64) {
    rec_image_copy(cb, OP_IMAGE_TO_BUFFER, img, buf, count, regions)
}

#[export_c]
fn vkCmdCopyBufferToImage(cb: u64, buf: u64, img: u64, layout: u32, count: u32, regions: u64) {
    rec_image_copy(cb, OP_BUFFER_TO_IMAGE, img, buf, count, regions)
}

#[export_c]
fn vkCmdFillBuffer(cb: u64, buf: u64, offset: u64, size: u64, data: u32) {
    let r: u64 = rec_new(cb, OP_FILL)
    if r == 0 as u64 { return }
    rt.st64(r, 1, buf)
    rt.st64(r, 2, offset)
    rt.st64(r, 3, size)
    rt.st64(r, 4, data as u64)
}

#[export_c]
fn vkCmdPipelineBarrier(cb: u64, srcStage: u32, dstStage: u32, deps: u32, memCount: u32, mems: u64, bufCount: u32, bufs: u64, imgCount: u32, imgs: u64) {
}
