import std.rt
import vulkan.vkobj
import vulkan.vkwsi

export { vkEnumerateInstanceVersion, vkEnumerateInstanceExtensionProperties, vkEnumerateInstanceLayerProperties, vkCreateInstance, vkDestroyInstance, vkEnumeratePhysicalDevices, vkGetPhysicalDeviceProperties, vkGetPhysicalDeviceMemoryProperties, vkGetPhysicalDeviceQueueFamilyProperties, vkGetPhysicalDeviceFeatures, vkGetPhysicalDeviceFormatProperties, vkEnumerateDeviceExtensionProperties, vkCreateDevice, vkDestroyDevice, vkGetDeviceQueue, vkDeviceWaitIdle, API_VERSION, DEVICE_NAME }

const API_VERSION: u32 = 0x00403000
static mut DEVICE_NAME: [u8; 16] = "OrientOS SWR\0\0\0\0"

#[export_c]
fn vkEnumerateInstanceVersion(out: u64) -> i32 {
    rt.st32(out, 0, API_VERSION)
    return 0
}

fn ext_list(kind: u64, count: u64, props: u64) -> i32 {
    let n: u32 = vkwsi.ext_count(kind)
    if props == 0 as u64 {
        rt.st32(count, 0, n)
        return 0
    }
    var cap: u32 = rt.ld32(count, 0)
    var r: i32 = 0
    if cap < n { r = 5 } else { cap = n }
    var i: u32 = 0 as u32
    while i < cap {
        vkwsi.ext_fill(kind, i, props + (i as u64) * 260 as u64)
        i = i + 1 as u32
    }
    rt.st32(count, 0, cap)
    return r
}

#[export_c]
fn vkEnumerateInstanceExtensionProperties(layer: u64, count: u64, props: u64) -> i32 {
    return ext_list(vkwsi.EXT_INSTANCE, count, props)
}

#[export_c]
fn vkEnumerateInstanceLayerProperties(count: u64, props: u64) -> i32 {
    rt.st32(count, 0, 0 as u32)
    return 0
}

#[export_c]
fn vkCreateInstance(info: u64, alloc: u64, out: u64) -> i32 {
    let h: u64 = vkobj.obj_new(vkobj.K_INSTANCE)
    if h == 0 as u64 { return -1 }
    rt.st64(out, 0, h)
    return 0
}

#[export_c]
fn vkDestroyInstance(inst: u64, alloc: u64) {
    vkobj.obj_free(inst, vkobj.K_INSTANCE)
}

#[export_c]
fn vkEnumeratePhysicalDevices(inst: u64, count: u64, devs: u64) -> i32 {
    if vkobj.obj_addr(inst, vkobj.K_INSTANCE) == 0 as u64 { return -3 }
    if devs == 0 as u64 {
        rt.st32(count, 0, 1 as u32)
        return 0
    }
    if rt.ld32(count, 0) == 0 as u32 { return 5 }
    var h: u64 = vkobj.obj_get(inst, vkobj.K_INSTANCE, 0)
    if h == 0 as u64 {
        h = vkobj.obj_new(vkobj.K_PHYS)
        vkobj.obj_set(inst, vkobj.K_INSTANCE, 0, h)
    }
    rt.st64(devs, 0, h)
    rt.st32(count, 0, 1 as u32)
    return 0
}

#[export_c]
fn vkGetPhysicalDeviceProperties(phys: u64, out: u64) {
    rt.mem_set(out, 0 as u8, 824)
    rt.st32(out, 0, API_VERSION)
    rt.st32(out + 4 as u64, 0, 1 as u32)
    rt.st32(out + 8 as u64, 0, 0x10005 as u32)
    rt.st32(out + 12 as u64, 0, 1 as u32)
    rt.st32(out + 16 as u64, 0, 4 as u32)
    var i: usize = 0
    while i < 13 {
        rt.st8(out + 20 as u64, i, DEVICE_NAME[i])
        i = i + 1
    }
    rt.st32(out + 296 as u64, 0, 8192 as u32)
    rt.st32(out + 300 as u64, 0, 8192 as u32)
    rt.st32(out + 304 as u64, 0, 2048 as u32)
    rt.st32(out + 308 as u64, 0, 8192 as u32)
    rt.st32(out + 312 as u64, 0, 8192 as u32)
}

#[export_c]
fn vkGetPhysicalDeviceMemoryProperties(phys: u64, out: u64) {
    rt.mem_set(out, 0 as u8, 520)
    rt.st32(out, 0, 1 as u32)
    rt.st32(out + 4 as u64, 0, 0xF as u32)
    rt.st32(out + 8 as u64, 0, 0 as u32)
    rt.st32(out + 260 as u64, 0, 1 as u32)
    rt.st64(out + 264 as u64, 0, 0x40000000 as u64)
    rt.st32(out + 272 as u64, 0, 1 as u32)
}

#[export_c]
fn vkGetPhysicalDeviceQueueFamilyProperties(phys: u64, count: u64, props: u64) {
    if props == 0 as u64 {
        rt.st32(count, 0, 1 as u32)
        return
    }
    if rt.ld32(count, 0) == 0 as u32 { return }
    rt.mem_set(props, 0 as u8, 24)
    rt.st32(props, 0, 0xD as u32)
    rt.st32(props + 4 as u64, 0, 1 as u32)
    rt.st32(props + 8 as u64, 0, 64 as u32)
    rt.st32(props + 12 as u64, 0, 1 as u32)
    rt.st32(props + 16 as u64, 0, 1 as u32)
    rt.st32(props + 20 as u64, 0, 1 as u32)
    rt.st32(count, 0, 1 as u32)
}

#[export_c]
fn vkGetPhysicalDeviceFeatures(phys: u64, out: u64) {
    rt.mem_set(out, 0 as u8, 220)
}

#[export_c]
fn vkGetPhysicalDeviceFormatProperties(phys: u64, format: u32, out: u64) {
    rt.mem_set(out, 0 as u8, 12)
    if format == 37 as u32 {
        rt.st32(out, 0, 0xC000 as u32)
        rt.st32(out + 4 as u64, 0, 0xC000 as u32)
    }
    if format == 44 as u32 {
        rt.st32(out, 0, 0xC000 as u32)
        rt.st32(out + 4 as u64, 0, 0xC000 as u32)
    }
    if format == 9 as u32 {
        rt.st32(out, 0, 0xC000 as u32)
        rt.st32(out + 4 as u64, 0, 0xC000 as u32)
    }
}

#[export_c]
fn vkEnumerateDeviceExtensionProperties(phys: u64, layer: u64, count: u64, props: u64) -> i32 {
    return ext_list(vkwsi.EXT_DEVICE, count, props)
}

#[export_c]
fn vkCreateDevice(phys: u64, info: u64, alloc: u64, out: u64) -> i32 {
    let h: u64 = vkobj.obj_new(vkobj.K_DEVICE)
    if h == 0 as u64 { return -1 }
    let q: u64 = vkobj.obj_new(vkobj.K_QUEUE)
    vkobj.obj_set(h, vkobj.K_DEVICE, 0, q)
    rt.st64(out, 0, h)
    return 0
}

#[export_c]
fn vkDestroyDevice(dev: u64, alloc: u64) {
    vkobj.obj_free(vkobj.obj_get(dev, vkobj.K_DEVICE, 0), vkobj.K_QUEUE)
    vkobj.obj_free(dev, vkobj.K_DEVICE)
}

#[export_c]
fn vkGetDeviceQueue(dev: u64, family: u32, index: u32, out: u64) {
    rt.st64(out, 0, vkobj.obj_get(dev, vkobj.K_DEVICE, 0))
}

#[export_c]
fn vkDeviceWaitIdle(dev: u64) -> i32 {
    return 0
}
