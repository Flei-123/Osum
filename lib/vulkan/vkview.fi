import std.rt
import vulkan.vkobj

export { vkCreateImageView, vkDestroyImageView, vkCreateSampler, vkDestroySampler }

#[export_c]
fn vkCreateImageView(dev: u64, info: u64, alloc: u64, out: u64) -> i32 {
    let img: u64 = rt.ld64(info + 24 as u64, 0)
    if vkobj.obj_addr(img, vkobj.K_IMAGE) == 0 as u64 { return -3 }
    let h: u64 = vkobj.obj_new(vkobj.K_VIEW)
    if h == 0 as u64 { return -1 }
    vkobj.obj_set(h, vkobj.K_VIEW, 0, img)
    vkobj.obj_set(h, vkobj.K_VIEW, 1, rt.ld32(info + 36 as u64, 0) as u64)
    rt.st64(out, 0, h)
    return 0
}

#[export_c]
fn vkDestroyImageView(dev: u64, view: u64, alloc: u64) {
    vkobj.obj_free(view, vkobj.K_VIEW)
}

#[export_c]
fn vkCreateSampler(dev: u64, info: u64, alloc: u64, out: u64) -> i32 {
    let h: u64 = vkobj.obj_new(vkobj.K_SAMPLER)
    if h == 0 as u64 { return -1 }
    vkobj.obj_set(h, vkobj.K_SAMPLER, 0, rt.ld32(info + 20 as u64, 0) as u64)
    vkobj.obj_set(h, vkobj.K_SAMPLER, 1, rt.ld32(info + 24 as u64, 0) as u64)
    rt.st64(out, 0, h)
    return 0
}

#[export_c]
fn vkDestroySampler(dev: u64, sampler: u64, alloc: u64) {
    vkobj.obj_free(sampler, vkobj.K_SAMPLER)
}
