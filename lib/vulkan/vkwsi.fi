import std.rt
import vulkan.vkobj
import vulkan.vkres

export { vkCreateHeadlessSurfaceEXT, vkDestroySurfaceKHR, vkGetPhysicalDeviceSurfaceSupportKHR, vkGetPhysicalDeviceSurfaceCapabilitiesKHR, vkGetPhysicalDeviceSurfaceFormatsKHR, vkGetPhysicalDeviceSurfacePresentModesKHR, vkCreateSwapchainKHR, vkDestroySwapchainKHR, vkGetSwapchainImagesKHR, vkAcquireNextImageKHR, vkQueuePresentKHR, vkOsumSetSurfaceSinkOSUM, vkOsumGetPresentCountOSUM, ext_fill, ext_count, EXT_INSTANCE, EXT_DEVICE }

const EXT_INSTANCE: u64 = 0
const EXT_DEVICE: u64 = 1

const S_SINK: usize = 0
const S_STRIDE: usize = 1
const S_PRESENTS: usize = 2

const C_COUNT: usize = 0
const C_IMAGES: usize = 1
const C_SIZE: usize = 2
const C_FORMAT: usize = 3
const C_NEXT: usize = 4
const C_SURFACE: usize = 5

fn ext_count(kind: u64) -> u32 {
    if kind == EXT_INSTANCE { return 2 as u32 }
    return 1 as u32
}

static mut NAME_SURFACE: [u8; 16] = "VK_KHR_surface\0\0"
static mut NAME_HEADLESS: [u8; 24] = "VK_EXT_headless_surface\0"
static mut NAME_SWAPCHAIN: [u8; 20] = "VK_KHR_swapchain\0\0\0\0"

fn name_byte(which: u64, i: usize) -> u8 {
    if which == 0 as u64 { return NAME_SURFACE[i] }
    if which == 1 as u64 { return NAME_HEADLESS[i] }
    return NAME_SWAPCHAIN[i]
}

fn copy_name(out: u64, which: u64, n: usize) {
    var i: usize = 0
    while i < n {
        rt.st8(out, i, name_byte(which, i))
        i = i + 1
    }
}

fn ext_fill(kind: u64, i: u32, out: u64) {
    rt.mem_set(out, 0 as u8, 260)
    if kind == EXT_INSTANCE {
        if i == 0 as u32 {
            copy_name(out, 0 as u64, 14)
            rt.st32(out + 256 as u64, 0, 25 as u32)
        } else {
            copy_name(out, 1 as u64, 23)
            rt.st32(out + 256 as u64, 0, 1 as u32)
        }
        return
    }
    copy_name(out, 2 as u64, 16)
    rt.st32(out + 256 as u64, 0, 70 as u32)
}

#[export_c]
fn vkCreateHeadlessSurfaceEXT(inst: u64, info: u64, alloc: u64, out: u64) -> i32 {
    let h: u64 = vkobj.obj_new(vkobj.K_SURFACE)
    if h == 0 as u64 { return -1 }
    rt.st64(out, 0, h)
    return 0
}

#[export_c]
fn vkDestroySurfaceKHR(inst: u64, surface: u64, alloc: u64) {
    vkobj.obj_free(surface, vkobj.K_SURFACE)
}

#[export_c]
fn vkGetPhysicalDeviceSurfaceSupportKHR(phys: u64, family: u32, surface: u64, out: u64) -> i32 {
    if vkobj.obj_addr(surface, vkobj.K_SURFACE) == 0 as u64 { return -1000000000 }
    rt.st32(out, 0, 1 as u32)
    return 0
}

#[export_c]
fn vkGetPhysicalDeviceSurfaceCapabilitiesKHR(phys: u64, surface: u64, out: u64) -> i32 {
    if vkobj.obj_addr(surface, vkobj.K_SURFACE) == 0 as u64 { return -1000000000 }
    rt.mem_set(out, 0 as u8, 52)
    rt.st32(out, 0, 2 as u32)
    rt.st32(out + 4 as u64, 0, 8 as u32)
    rt.st32(out + 8 as u64, 0, 0xFFFFFFFF as u32)
    rt.st32(out + 12 as u64, 0, 0xFFFFFFFF as u32)
    rt.st32(out + 16 as u64, 0, 1 as u32)
    rt.st32(out + 20 as u64, 0, 1 as u32)
    rt.st32(out + 24 as u64, 0, 8192 as u32)
    rt.st32(out + 28 as u64, 0, 8192 as u32)
    rt.st32(out + 32 as u64, 0, 1 as u32)
    rt.st32(out + 36 as u64, 0, 1 as u32)
    rt.st32(out + 40 as u64, 0, 1 as u32)
    rt.st32(out + 44 as u64, 0, 1 as u32)
    rt.st32(out + 48 as u64, 0, 0x1F as u32)
    return 0
}

fn list_out(count: u64, props: u64, n: u32) -> i32 {
    if props == 0 as u64 {
        rt.st32(count, 0, n)
        return 0
    }
    var cap: u32 = rt.ld32(count, 0)
    var r: i32 = 0
    if cap < n { r = 5 } else { cap = n }
    rt.st32(count, 0, cap)
    return r
}

#[export_c]
fn vkGetPhysicalDeviceSurfaceFormatsKHR(phys: u64, surface: u64, count: u64, props: u64) -> i32 {
    if vkobj.obj_addr(surface, vkobj.K_SURFACE) == 0 as u64 { return -1000000000 }
    let r: i32 = list_out(count, props, 2 as u32)
    if props == 0 as u64 { return r }
    let n: u32 = rt.ld32(count, 0)
    if n >= 1 as u32 {
        rt.st32(props, 0, 44 as u32)
        rt.st32(props + 4 as u64, 0, 0 as u32)
    }
    if n >= 2 as u32 {
        rt.st32(props + 8 as u64, 0, 37 as u32)
        rt.st32(props + 12 as u64, 0, 0 as u32)
    }
    return r
}

#[export_c]
fn vkGetPhysicalDeviceSurfacePresentModesKHR(phys: u64, surface: u64, count: u64, props: u64) -> i32 {
    if vkobj.obj_addr(surface, vkobj.K_SURFACE) == 0 as u64 { return -1000000000 }
    let r: i32 = list_out(count, props, 2 as u32)
    if props == 0 as u64 { return r }
    let n: u32 = rt.ld32(count, 0)
    if n >= 1 as u32 { rt.st32(props, 0, 2 as u32) }
    if n >= 2 as u32 { rt.st32(props + 4 as u64, 0, 0 as u32) }
    return r
}

#[export_c]
fn vkCreateSwapchainKHR(dev: u64, info: u64, alloc: u64, out: u64) -> i32 {
    let surface: u64 = rt.ld64(info + 24 as u64, 0)
    let want: u32 = rt.ld32(info + 32 as u64, 0)
    let format: u32 = rt.ld32(info + 36 as u64, 0)
    let w: u64 = rt.ld32(info + 44 as u64, 0) as u64
    let h: u64 = rt.ld32(info + 48 as u64, 0) as u64
    if vkobj.obj_addr(surface, vkobj.K_SURFACE) == 0 as u64 { return -1000000000 }
    if w == 0 as u64 { return -1 }
    if h == 0 as u64 { return -1 }
    if w > 8192 as u64 { return -1 }
    if h > 8192 as u64 { return -1 }
    if format != 44 as u32 && format != 37 as u32 { return -11 }
    var n: u32 = want
    if n < 2 as u32 { n = 2 as u32 }
    if n > 8 as u32 { n = 8 as u32 }
    let sc: u64 = vkobj.obj_new(vkobj.K_SWAPCHAIN)
    if sc == 0 as u64 { return -1 }
    let arr: u64 = rt.heap_alloc(64)
    if arr == 0 as u64 {
        vkobj.obj_free(sc, vkobj.K_SWAPCHAIN)
        return -1
    }
    var i: u32 = 0 as u32
    while i < n {
        let img: u64 = vkres.res_image_new(w, h, format)
        if img == 0 as u64 {
            var j: u32 = 0 as u32
            while j < i {
                vkres.res_image_free(rt.ld64(arr, j as usize))
                j = j + 1 as u32
            }
            rt.heap_free(arr, 64)
            vkobj.obj_free(sc, vkobj.K_SWAPCHAIN)
            return -1
        }
        rt.st64(arr, i as usize, img)
        i = i + 1 as u32
    }
    vkobj.obj_set(sc, vkobj.K_SWAPCHAIN, C_COUNT, n as u64)
    vkobj.obj_set(sc, vkobj.K_SWAPCHAIN, C_IMAGES, arr)
    vkobj.obj_set(sc, vkobj.K_SWAPCHAIN, C_SIZE, w | (h << 32 as u64))
    vkobj.obj_set(sc, vkobj.K_SWAPCHAIN, C_FORMAT, format as u64)
    vkobj.obj_set(sc, vkobj.K_SWAPCHAIN, C_NEXT, 0 as u64)
    vkobj.obj_set(sc, vkobj.K_SWAPCHAIN, C_SURFACE, surface)
    rt.st64(out, 0, sc)
    return 0
}

#[export_c]
fn vkDestroySwapchainKHR(dev: u64, sc: u64, alloc: u64) {
    let n: u64 = vkobj.obj_get(sc, vkobj.K_SWAPCHAIN, C_COUNT)
    let arr: u64 = vkobj.obj_get(sc, vkobj.K_SWAPCHAIN, C_IMAGES)
    if arr != 0 as u64 {
        var i: u64 = 0 as u64
        while i < n {
            vkres.res_image_free(rt.ld64(arr, i as usize))
            i = i + 1 as u64
        }
        rt.heap_free(arr, 64)
    }
    vkobj.obj_free(sc, vkobj.K_SWAPCHAIN)
}

#[export_c]
fn vkGetSwapchainImagesKHR(dev: u64, sc: u64, count: u64, images: u64) -> i32 {
    let n: u32 = vkobj.obj_get(sc, vkobj.K_SWAPCHAIN, C_COUNT) as u32
    let arr: u64 = vkobj.obj_get(sc, vkobj.K_SWAPCHAIN, C_IMAGES)
    if arr == 0 as u64 { return -1000000000 }
    if images == 0 as u64 {
        rt.st32(count, 0, n)
        return 0
    }
    var cap: u32 = rt.ld32(count, 0)
    var r: i32 = 0
    if cap < n { r = 5 } else { cap = n }
    var i: u32 = 0 as u32
    while i < cap {
        rt.st64(images, i as usize, rt.ld64(arr, i as usize))
        i = i + 1 as u32
    }
    rt.st32(count, 0, cap)
    return r
}

#[export_c]
fn vkAcquireNextImageKHR(dev: u64, sc: u64, timeout: u64, sem: u64, fence: u64, out: u64) -> i32 {
    let n: u64 = vkobj.obj_get(sc, vkobj.K_SWAPCHAIN, C_COUNT)
    if n == 0 as u64 { return -1000000000 }
    let i: u64 = vkobj.obj_get(sc, vkobj.K_SWAPCHAIN, C_NEXT)
    vkobj.obj_set(sc, vkobj.K_SWAPCHAIN, C_NEXT, (i + 1 as u64) % n)
    rt.st32(out, 0, i as u32)
    if fence != 0 as u64 { vkobj.obj_set(fence, vkobj.K_FENCE, 0, 1 as u64) }
    return 0
}

fn sink_write(sc: u64, index: u64) {
    let surface: u64 = vkobj.obj_get(sc, vkobj.K_SWAPCHAIN, C_SURFACE)
    let dst: u64 = vkobj.obj_get(surface, vkobj.K_SURFACE, S_SINK)
    if dst == 0 as u64 { return }
    let stride: u64 = vkobj.obj_get(surface, vkobj.K_SURFACE, S_STRIDE)
    let size: u64 = vkobj.obj_get(sc, vkobj.K_SWAPCHAIN, C_SIZE)
    let w: u64 = size & 0xFFFFFFFF as u64
    let h: u64 = size >> 32 as u64
    let format: u64 = vkobj.obj_get(sc, vkobj.K_SWAPCHAIN, C_FORMAT)
    let arr: u64 = vkobj.obj_get(sc, vkobj.K_SWAPCHAIN, C_IMAGES)
    let src: u64 = vkres.res_addr(vkobj.K_IMAGE, rt.ld64(arr, index as usize))
    if src == 0 as u64 { return }
    var y: u64 = 0 as u64
    while y < h {
        let s: u64 = src + y * w * 4 as u64
        let d: u64 = dst + y * stride
        if format == 44 as u64 {
            rt.mem_copy(d, s, (w * 4 as u64) as usize)
        } else {
            var x: u64 = 0 as u64
            while x < w {
                let o: usize = (x * 4 as u64) as usize
                rt.st8(d, o, rt.ld8(s, o + 2))
                rt.st8(d, o + 1, rt.ld8(s, o + 1))
                rt.st8(d, o + 2, rt.ld8(s, o))
                rt.st8(d, o + 3, rt.ld8(s, o + 3))
                x = x + 1 as u64
            }
        }
        y = y + 1 as u64
    }
}

#[export_c]
fn vkQueuePresentKHR(queue: u64, info: u64) -> i32 {
    let n: u32 = rt.ld32(info + 32 as u64, 0)
    let scs: u64 = rt.ld64(info + 40 as u64, 0)
    let idx: u64 = rt.ld64(info + 48 as u64, 0)
    let res: u64 = rt.ld64(info + 56 as u64, 0)
    var i: u32 = 0 as u32
    var worst: i32 = 0
    while i < n {
        let sc: u64 = rt.ld64(scs, i as usize)
        let index: u64 = rt.ld32(idx, i as usize) as u64
        var r: i32 = 0
        if vkobj.obj_addr(sc, vkobj.K_SWAPCHAIN) == 0 as u64 {
            r = -1000000000
        } else {
            if index >= vkobj.obj_get(sc, vkobj.K_SWAPCHAIN, C_COUNT) {
                r = -1000000000
            } else {
                sink_write(sc, index)
                let surface: u64 = vkobj.obj_get(sc, vkobj.K_SWAPCHAIN, C_SURFACE)
                vkobj.obj_set(surface, vkobj.K_SURFACE, S_PRESENTS, vkobj.obj_get(surface, vkobj.K_SURFACE, S_PRESENTS) + 1 as u64)
            }
        }
        if res != 0 as u64 { rt.st32(res, i as usize, r as u32) }
        if r != 0 { worst = r }
        i = i + 1 as u32
    }
    return worst
}

#[export_c]
fn vkOsumSetSurfaceSinkOSUM(surface: u64, dst: u64, stride: u64) -> i32 {
    if vkobj.obj_addr(surface, vkobj.K_SURFACE) == 0 as u64 { return -1000000000 }
    vkobj.obj_set(surface, vkobj.K_SURFACE, S_SINK, dst)
    vkobj.obj_set(surface, vkobj.K_SURFACE, S_STRIDE, stride)
    return 0
}

#[export_c]
fn vkOsumGetPresentCountOSUM(surface: u64) -> u64 {
    return vkobj.obj_get(surface, vkobj.K_SURFACE, S_PRESENTS)
}
