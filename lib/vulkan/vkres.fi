import std.rt
import vulkan.vkobj

export { vkAllocateMemory, vkFreeMemory, vkMapMemory, vkUnmapMemory, vkFlushMappedMemoryRanges, vkInvalidateMappedMemoryRanges, vkCreateBuffer, vkDestroyBuffer, vkGetBufferMemoryRequirements, vkBindBufferMemory, vkCreateImage, vkDestroyImage, vkGetImageMemoryRequirements, vkBindImageMemory, res_addr, image_bpp, unorm8 }

fn unorm8(c: f32) -> u32 {
    var v: f32 = c
    if v < 0.0f { v = 0.0f }
    if v > 1.0f { v = 1.0f }
    return ((v * 255.0f + 0.5f) as i32) as u32
}

fn align16(n: u64) -> u64 {
    return (n + 15 as u64) & (0xFFFFFFFFFFFFFFF0 as u64)
}

fn image_bpp(format: u32) -> u64 {
    if format == 37 as u32 { return 4 as u64 }
    if format == 44 as u32 { return 4 as u64 }
    if format == 126 as u32 { return 4 as u64 }
    return 0 as u64
}

#[export_c]
fn vkAllocateMemory(dev: u64, info: u64, alloc: u64, out: u64) -> i32 {
    let size: u64 = rt.ld64(info + 16 as u64, 0)
    if size == 0 as u64 { return -1 }
    if size > (0x40000000 as u64) { return -1 }
    let h: u64 = vkobj.obj_new(vkobj.K_MEMORY)
    if h == 0 as u64 { return -1 }
    let p: u64 = rt.heap_alloc(size as usize)
    if p == 0 as u64 {
        vkobj.obj_free(h, vkobj.K_MEMORY)
        return -1
    }
    rt.mem_set(p, 0 as u8, size as usize)
    vkobj.obj_set(h, vkobj.K_MEMORY, 0, p)
    vkobj.obj_set(h, vkobj.K_MEMORY, 1, size)
    rt.st64(out, 0, h)
    return 0
}

#[export_c]
fn vkFreeMemory(dev: u64, mem: u64, alloc: u64) {
    let p: u64 = vkobj.obj_get(mem, vkobj.K_MEMORY, 0)
    let n: u64 = vkobj.obj_get(mem, vkobj.K_MEMORY, 1)
    if p != 0 as u64 { rt.heap_free(p, n as usize) }
    vkobj.obj_free(mem, vkobj.K_MEMORY)
}

#[export_c]
fn vkMapMemory(dev: u64, mem: u64, offset: u64, size: u64, flags: u32, out: u64) -> i32 {
    let p: u64 = vkobj.obj_get(mem, vkobj.K_MEMORY, 0)
    let n: u64 = vkobj.obj_get(mem, vkobj.K_MEMORY, 1)
    if p == 0 as u64 { return -5 }
    if offset >= n { return -5 }
    rt.st64(out, 0, p + offset)
    return 0
}

#[export_c]
fn vkUnmapMemory(dev: u64, mem: u64) {
}

#[export_c]
fn vkFlushMappedMemoryRanges(dev: u64, count: u32, ranges: u64) -> i32 {
    return 0
}

#[export_c]
fn vkInvalidateMappedMemoryRanges(dev: u64, count: u32, ranges: u64) -> i32 {
    return 0
}

#[export_c]
fn vkCreateBuffer(dev: u64, info: u64, alloc: u64, out: u64) -> i32 {
    let size: u64 = rt.ld64(info + 24 as u64, 0)
    let usage: u32 = rt.ld32(info + 32 as u64, 0)
    let h: u64 = vkobj.obj_new(vkobj.K_BUFFER)
    if h == 0 as u64 { return -1 }
    vkobj.obj_set(h, vkobj.K_BUFFER, 2, size)
    vkobj.obj_set(h, vkobj.K_BUFFER, 3, usage as u64)
    rt.st64(out, 0, h)
    return 0
}

#[export_c]
fn vkDestroyBuffer(dev: u64, buf: u64, alloc: u64) {
    vkobj.obj_free(buf, vkobj.K_BUFFER)
}

#[export_c]
fn vkGetBufferMemoryRequirements(dev: u64, buf: u64, out: u64) {
    let size: u64 = vkobj.obj_get(buf, vkobj.K_BUFFER, 2)
    rt.st64(out, 0, align16(size))
    rt.st64(out, 1, 16 as u64)
    rt.st32(out + 16 as u64, 0, 1 as u32)
}

#[export_c]
fn vkBindBufferMemory(dev: u64, buf: u64, mem: u64, offset: u64) -> i32 {
    let n: u64 = vkobj.obj_get(mem, vkobj.K_MEMORY, 1)
    let size: u64 = vkobj.obj_get(buf, vkobj.K_BUFFER, 2)
    if n == 0 as u64 { return -1 }
    if offset + size > n { return -1 }
    vkobj.obj_set(buf, vkobj.K_BUFFER, 0, mem)
    vkobj.obj_set(buf, vkobj.K_BUFFER, 1, offset)
    return 0
}

#[export_c]
fn vkCreateImage(dev: u64, info: u64, alloc: u64, out: u64) -> i32 {
    let format: u32 = rt.ld32(info + 24 as u64, 0)
    let w: u32 = rt.ld32(info + 28 as u64, 0)
    let h2: u32 = rt.ld32(info + 32 as u64, 0)
    if image_bpp(format) == 0 as u64 { return -11 }
    if w == 0 as u32 { return -1 }
    if h2 == 0 as u32 { return -1 }
    let h: u64 = vkobj.obj_new(vkobj.K_IMAGE)
    if h == 0 as u64 { return -1 }
    vkobj.obj_set(h, vkobj.K_IMAGE, 2, w as u64)
    vkobj.obj_set(h, vkobj.K_IMAGE, 3, h2 as u64)
    vkobj.obj_set(h, vkobj.K_IMAGE, 4, format as u64)
    rt.st64(out, 0, h)
    return 0
}

#[export_c]
fn vkDestroyImage(dev: u64, img: u64, alloc: u64) {
    vkobj.obj_free(img, vkobj.K_IMAGE)
}

#[export_c]
fn vkGetImageMemoryRequirements(dev: u64, img: u64, out: u64) {
    let w: u64 = vkobj.obj_get(img, vkobj.K_IMAGE, 2)
    let h: u64 = vkobj.obj_get(img, vkobj.K_IMAGE, 3)
    let bpp: u64 = image_bpp(vkobj.obj_get(img, vkobj.K_IMAGE, 4) as u32)
    rt.st64(out, 0, align16(w * h * bpp))
    rt.st64(out, 1, 16 as u64)
    rt.st32(out + 16 as u64, 0, 1 as u32)
}

#[export_c]
fn vkBindImageMemory(dev: u64, img: u64, mem: u64, offset: u64) -> i32 {
    let n: u64 = vkobj.obj_get(mem, vkobj.K_MEMORY, 1)
    let w: u64 = vkobj.obj_get(img, vkobj.K_IMAGE, 2)
    let h: u64 = vkobj.obj_get(img, vkobj.K_IMAGE, 3)
    let bpp: u64 = image_bpp(vkobj.obj_get(img, vkobj.K_IMAGE, 4) as u32)
    if n == 0 as u64 { return -1 }
    if offset + w * h * bpp > n { return -1 }
    vkobj.obj_set(img, vkobj.K_IMAGE, 0, mem)
    vkobj.obj_set(img, vkobj.K_IMAGE, 1, offset)
    return 0
}

fn res_addr(kind: u64, h: u64) -> u64 {
    let mem: u64 = vkobj.obj_get(h, kind, 0)
    let off: u64 = vkobj.obj_get(h, kind, 1)
    let p: u64 = vkobj.obj_get(mem, vkobj.K_MEMORY, 0)
    if p == 0 as u64 { return 0 as u64 }
    return p + off
}
