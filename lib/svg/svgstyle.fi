// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import svg.svgmath
import svg.svgscan
import svg.svgnames
import svg.svggeom
import svg.svgstroke
import svg.svgfill

export {
    F_FILL_KIND, F_FILL_RGB, F_FILL_A, F_FILL_GRAD, F_FILL_OP, F_STROKE_KIND, F_STROKE_RGB, F_STROKE_A,
    F_STROKE_GRAD, F_STROKE_OP, F_WIDTH, F_CAP, F_JOIN, F_MITER, F_RULE, F_OPACITY, F_COLOR,
    MAX_DEPTH, PAINT_NONE, PAINT_SOLID, PAINT_GRAD,
    style_reset, push, pop, depth, get, set, ctm_apply, ctm_load,
    apply_prop, apply_style_attr, parse_transform, unsupported, unsup_add,
    grad_begin, grad_attr, grad_stop, grad_end, grad_count, grad_eval, grad_alpha, grad_device, grad_find,
    color_of, color_alpha, opacity_value
}

const F_FILL_KIND: i64 = 0
const F_FILL_RGB: i64 = 1
const F_FILL_A: i64 = 2
const F_FILL_GRAD: i64 = 3
const F_FILL_OP: i64 = 4
const F_STROKE_KIND: i64 = 5
const F_STROKE_RGB: i64 = 6
const F_STROKE_A: i64 = 7
const F_STROKE_GRAD: i64 = 8
const F_STROKE_OP: i64 = 9
const F_WIDTH: i64 = 10
const F_CAP: i64 = 11
const F_JOIN: i64 = 12
const F_MITER: i64 = 13
const F_RULE: i64 = 14
const F_OPACITY: i64 = 15
const F_COLOR: i64 = 16
const F_CTM: i64 = 17
const FIELDS: i64 = 24
const MAX_DEPTH: i64 = 24
const PAINT_NONE: i64 = 0
const PAINT_SOLID: i64 = 1
const PAINT_GRAD: i64 = 2
const MAX_GRAD: i64 = 8
const MAX_STOPS: i64 = 6

static mut frames: [i64; 576] = [0 as i64; 576]
static mut dep: i64 = 0
static mut unsup: i64 = 0

static mut g_hash: [i64; 8] = [0 as i64; 8]
static mut g_units: [i64; 8] = [0 as i64; 8]
static mut g_x1: [i64; 8] = [0 as i64; 8]
static mut g_y1: [i64; 8] = [0 as i64; 8]
static mut g_x2: [i64; 8] = [0 as i64; 8]
static mut g_y2: [i64; 8] = [0 as i64; 8]
static mut g_n: [i64; 8] = [0 as i64; 8]
static mut g_off: [i64; 48] = [0 as i64; 48]
static mut g_rgb: [i64; 48] = [0 as i64; 48]
static mut g_sa: [i64; 48] = [0 as i64; 48]
static mut g_count: i64 = 0
static mut g_cur: i64 = 0 - 1
static mut gv_x0: i64 = 0
static mut gv_y0: i64 = 0
static mut gv_dx: i64 = 0
static mut gv_dy: i64 = 1
static mut pk: i64 = 0
static mut prgb: i64 = 0
static mut pa: i64 = 255
static mut pgrad: i64 = 0 - 1

fn unsupported() -> i64 {
    return unsup
}

fn unsup_add() {
    unsup = unsup + 1
}

fn depth() -> i64 {
    return dep
}

fn get(f: i64) -> i64 {
    return frames[(dep * FIELDS + f) as usize]
}

fn set(f: i64, v: i64) {
    frames[(dep * FIELDS + f) as usize] = v
}

fn style_reset() {
    dep = 0
    unsup = 0
    g_count = 0
    g_cur = 0 - 1
    var i: i64 = 0
    while i < FIELDS {
        frames[i as usize] = 0
        i = i + 1
    }
    set(F_FILL_KIND, PAINT_SOLID)
    set(F_FILL_RGB, 0)
    set(F_FILL_A, 255)
    set(F_FILL_OP, 255)
    set(F_STROKE_KIND, PAINT_NONE)
    set(F_STROKE_A, 255)
    set(F_STROKE_OP, 255)
    set(F_WIDTH, 65536)
    set(F_CAP, svgstroke.CAP_BUTT)
    set(F_JOIN, svgstroke.JOIN_MITER)
    set(F_MITER, 262144)
    set(F_RULE, svgfill.NONZERO)
    set(F_OPACITY, 255)
    set(F_COLOR, 0)
    ctm_load(65536, 0, 0, 65536, 0, 0)
}

fn push() -> bool {
    if dep + 1 >= MAX_DEPTH {
        unsup = unsup + 1
        return false
    }
    var i: i64 = 0
    while i < FIELDS {
        frames[((dep + 1) * FIELDS + i) as usize] = frames[(dep * FIELDS + i) as usize]
        i = i + 1
    }
    dep = dep + 1
    return true
}

fn pop() {
    if dep > 0 {
        dep = dep - 1
    }
}

fn ctm_load(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) {
    set(F_CTM, a)
    set(F_CTM + 1, b)
    set(F_CTM + 2, c)
    set(F_CTM + 3, d)
    set(F_CTM + 4, e)
    set(F_CTM + 5, f)
}

fn ctm_apply() {
    svggeom.set_ctm(get(F_CTM), get(F_CTM + 1), get(F_CTM + 2), get(F_CTM + 3), get(F_CTM + 4), get(F_CTM + 5))
}

fn ctm_mul(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) {
    let ma: i64 = get(F_CTM)
    let mb: i64 = get(F_CTM + 1)
    let mc: i64 = get(F_CTM + 2)
    let md: i64 = get(F_CTM + 3)
    let me: i64 = get(F_CTM + 4)
    let mf: i64 = get(F_CTM + 5)
    ctm_load(svgmath.mul16(ma, a) + svgmath.mul16(mc, b),
             svgmath.mul16(mb, a) + svgmath.mul16(md, b),
             svgmath.mul16(ma, c) + svgmath.mul16(mc, d),
             svgmath.mul16(mb, c) + svgmath.mul16(md, d),
             svgmath.mul16(ma, e) + svgmath.mul16(mc, f) + me,
             svgmath.mul16(mb, e) + svgmath.mul16(md, f) + mf)
}

fn parse_transform(p: u64, n: u64) {
    svgscan.begin(p, n)
    while true {
        svgscan.skip_sep()
        if svgscan.at_end() {
            break
        }
        let start: u64 = svgscan.pos()
        while svgscan.peek() != 40 && !svgscan.at_end() {
            svgscan.advance()
        }
        let h: u64 = svgnames.hash_name(p + start, svgscan.pos() - start)
        if svgscan.at_end() {
            unsup = unsup + 1
            break
        }
        svgscan.advance()
        if h == svgnames.T_MATRIX {
            let a: i64 = svgscan.num()
            let b: i64 = svgscan.num()
            let c: i64 = svgscan.num()
            let d: i64 = svgscan.num()
            let e: i64 = svgscan.num()
            let f: i64 = svgscan.num()
            ctm_mul(a, b, c, d, e, f)
        } else if h == svgnames.T_TRANSLATE {
            let tx: i64 = svgscan.num()
            svgscan.skip_sep()
            var ty: i64 = 0
            if svgscan.peek() != 41 {
                ty = svgscan.num()
            }
            ctm_mul(65536, 0, 0, 65536, tx, ty)
        } else if h == svgnames.T_SCALE {
            let sx: i64 = svgscan.num()
            svgscan.skip_sep()
            var sy: i64 = sx
            if svgscan.peek() != 41 {
                sy = svgscan.num()
            }
            ctm_mul(sx, 0, 0, sy, 0, 0)
        } else if h == svgnames.T_ROTATE {
            let deg: i64 = svgscan.num()
            svgscan.skip_sep()
            var rx: i64 = 0
            var ry: i64 = 0
            if svgscan.peek() != 41 {
                rx = svgscan.num()
                ry = svgscan.num()
            }
            let ang: i64 = svgmath.rdiv(deg * svgmath.TURN, 360 * 65536)
            let cs: i64 = svgmath.cos16(ang)
            let sn: i64 = svgmath.sin16(ang)
            ctm_mul(65536, 0, 0, 65536, rx, ry)
            ctm_mul(cs, sn, 0 - sn, cs, 0, 0)
            ctm_mul(65536, 0, 0, 65536, 0 - rx, 0 - ry)
        } else {
            unsup = unsup + 1
        }
        while svgscan.peek() != 41 && !svgscan.at_end() {
            svgscan.advance()
        }
        svgscan.advance()
        if !svgscan.ok() {
            unsup = unsup + 1
            break
        }
    }
}

fn hex_val(c: u64) -> i64 {
    if c >= 48 && c <= 57 {
        return (c - 48) as i64
    }
    if c >= 97 && c <= 102 {
        return (c - 87) as i64
    }
    if c >= 65 && c <= 70 {
        return (c - 55) as i64
    }
    return 0 - 1
}

fn trim(p: u64, n: u64) {
    var s: u64 = 0
    var e: u64 = n
    while s < e && (__mmio_read8((p + s) as *mut u8)) as u64 <= 32 {
        s = s + 1
    }
    while e > s && (__mmio_read8((p + e - 1) as *mut u8)) as u64 <= 32 {
        e = e - 1
    }
    tr_p = p + s
    tr_n = e - s
}

static mut tr_p: u64 = 0
static mut tr_n: u64 = 0

fn named(h: u64) -> i64 {
    if h == svgnames.C_BLACK {
        return 0
    }
    if h == svgnames.C_WHITE {
        return 16777215
    }
    if h == svgnames.C_RED {
        return 16711680
    }
    if h == svgnames.C_GREEN {
        return 32768
    }
    if h == svgnames.C_BLUE {
        return 255
    }
    if h == svgnames.C_GRAY || h == svgnames.C_GREY {
        return 8421504
    }
    if h == svgnames.C_ORANGE {
        return 16753920
    }
    if h == svgnames.C_YELLOW {
        return 16776960
    }
    return 0 - 1
}

fn grad_find(h: i64) -> i64 {
    var i: i64 = 0
    while i < g_count {
        if g_hash[i as usize] == h {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn parse_paint(p0: u64, n0: u64) {
    trim(p0, n0)
    let p: u64 = tr_p
    let n: u64 = tr_n
    pk = 4
    pa = 255
    pgrad = 0 - 1
    if n == 0 {
        return
    }
    let c: u64 = (__mmio_read8(p as *mut u8)) as u64
    if c == 35 {
        var v: i64 = 0
        var k: u64 = 1
        var ok: bool = true
        while k < n {
            let hv: i64 = hex_val((__mmio_read8((p + k) as *mut u8)) as u64)
            if hv < 0 {
                ok = false
            }
            v = v * 16 + hv
            k = k + 1
        }
        if ok && n == 7 {
            pk = 1
            prgb = v
        } else if ok && n == 4 {
            pk = 1
            let r: i64 = (v >> 8) & 15
            let g: i64 = (v >> 4) & 15
            let b: i64 = v & 15
            prgb = (r * 17) * 65536 + (g * 17) * 256 + b * 17
        }
        return
    }
    if c == 117 {
        var k: u64 = 0
        while k < n && (__mmio_read8((p + k) as *mut u8)) as u64 != 35 {
            k = k + 1
        }
        var e: u64 = k + 1
        while e < n && (__mmio_read8((p + e) as *mut u8)) as u64 != 41 {
            e = e + 1
        }
        if k < n {
            pk = 3
            pgrad = grad_find(svgnames.hash_name(p + k + 1, e - k - 1) as i64)
        }
        return
    }
    if c == 114 && n > 4 {
        svgscan.begin(p + 4, n - 4)
        let r: i64 = svgscan.num() >> 16
        let g: i64 = svgscan.num() >> 16
        let b: i64 = svgscan.num() >> 16
        if svgscan.ok() {
            pk = 1
            prgb = svgmath.clamp(r, 0, 255) * 65536 + svgmath.clamp(g, 0, 255) * 256 + svgmath.clamp(b, 0, 255)
        }
        return
    }
    let h: u64 = svgnames.hash_name(p, n)
    if h == svgnames.V_NONE {
        pk = 0
        return
    }
    if h == svgnames.V_TRANSPARENT {
        pk = 1
        prgb = 0
        pa = 0
        return
    }
    if h == svgnames.V_CURRENT {
        pk = 1
        prgb = get(F_COLOR)
        return
    }
    let nv: i64 = named(h)
    if nv >= 0 {
        pk = 1
        prgb = nv
    }
}

fn opacity_of(p: u64, n: u64) -> i64 {
    svgscan.begin(p, n)
    let v: i64 = svgscan.num()
    if !svgscan.ok() {
        return 255
    }
    return svgmath.clamp(svgmath.mul16(v, 255), 0, 255)
}

fn apply_paint(is_fill: bool, p: u64, n: u64) {
    parse_paint(p, n)
    var kind: i64 = PAINT_NONE
    if pk == 1 {
        kind = PAINT_SOLID
    } else if pk == 3 {
        if pgrad >= 0 {
            kind = PAINT_GRAD
        } else {
            unsup = unsup + 1
        }
    } else if pk == 4 {
        unsup = unsup + 1
    }
    if is_fill {
        set(F_FILL_KIND, kind)
        if pk == 1 {
            set(F_FILL_RGB, prgb)
            set(F_FILL_A, pa)
        }
        set(F_FILL_GRAD, pgrad)
    } else {
        set(F_STROKE_KIND, kind)
        if pk == 1 {
            set(F_STROKE_RGB, prgb)
            set(F_STROKE_A, pa)
        }
        set(F_STROKE_GRAD, pgrad)
    }
}

fn apply_prop(h: u64, p: u64, n: u64) {
    if h == svgnames.A_COLOR {
        parse_paint(p, n)
        if pk == 1 {
            set(F_COLOR, prgb)
        }
    } else if h == svgnames.A_FILL {
        apply_paint(true, p, n)
    } else if h == svgnames.A_STROKE {
        apply_paint(false, p, n)
    } else if h == svgnames.A_STROKE_WIDTH {
        svgscan.begin(p, n)
        let v: i64 = svgscan.num()
        if svgscan.ok() {
            set(F_WIDTH, v)
        }
    } else if h == svgnames.A_LINECAP {
        let k: u64 = svgnames.hash_name(p, n)
        if k == svgnames.V_ROUND {
            set(F_CAP, svgstroke.CAP_ROUND)
        } else if k == svgnames.V_SQUARE {
            set(F_CAP, svgstroke.CAP_SQUARE)
        } else {
            set(F_CAP, svgstroke.CAP_BUTT)
        }
    } else if h == svgnames.A_LINEJOIN {
        let k: u64 = svgnames.hash_name(p, n)
        if k == svgnames.V_ROUND {
            set(F_JOIN, svgstroke.JOIN_ROUND)
        } else if k == svgnames.V_BEVEL {
            set(F_JOIN, svgstroke.JOIN_BEVEL)
        } else {
            set(F_JOIN, svgstroke.JOIN_MITER)
        }
    } else if h == svgnames.A_MITER {
        svgscan.begin(p, n)
        let v: i64 = svgscan.num()
        if svgscan.ok() && v >= 65536 {
            set(F_MITER, v)
        }
    } else if h == svgnames.A_FILL_RULE {
        if svgnames.hash_name(p, n) == svgnames.V_EVENODD {
            set(F_RULE, svgfill.EVENODD)
        } else {
            set(F_RULE, svgfill.NONZERO)
        }
    } else if h == svgnames.A_FILL_OPACITY {
        set(F_FILL_OP, opacity_of(p, n))
    } else if h == svgnames.A_STROKE_OPACITY {
        set(F_STROKE_OP, opacity_of(p, n))
    } else if h == svgnames.A_OPACITY {
        set(F_OPACITY, (get(F_OPACITY) * opacity_of(p, n) + 127) / 255)
    } else if h == svgnames.A_TRANSFORM {
        parse_transform(p, n)
    }
}

fn is_prop(h: u64) -> bool {
    return h == svgnames.A_COLOR || h == svgnames.A_FILL || h == svgnames.A_STROKE || h == svgnames.A_STROKE_WIDTH ||
        h == svgnames.A_LINECAP || h == svgnames.A_LINEJOIN || h == svgnames.A_MITER || h == svgnames.A_FILL_RULE ||
        h == svgnames.A_FILL_OPACITY || h == svgnames.A_STROKE_OPACITY || h == svgnames.A_OPACITY
}

fn apply_style_attr(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        var ns: u64 = i
        while i < n && (__mmio_read8((p + i) as *mut u8)) as u64 != 58 {
            i = i + 1
        }
        if i >= n {
            break
        }
        trim(p + ns, i - ns)
        let h: u64 = svgnames.hash_name(tr_p, tr_n)
        i = i + 1
        let vs: u64 = i
        while i < n && (__mmio_read8((p + i) as *mut u8)) as u64 != 59 {
            i = i + 1
        }
        trim(p + vs, i - vs)
        if is_prop(h) {
            apply_prop(h, tr_p, tr_n)
        }
        i = i + 1
    }
}

fn grad_begin(h: i64) {
    if g_count >= MAX_GRAD {
        unsup = unsup + 1
        g_cur = 0 - 1
        return
    }
    g_cur = g_count
    g_count = g_count + 1
    g_hash[g_cur as usize] = h
    g_units[g_cur as usize] = 0
    g_x1[g_cur as usize] = 0
    g_y1[g_cur as usize] = 0
    g_x2[g_cur as usize] = 65536
    g_y2[g_cur as usize] = 0
    g_n[g_cur as usize] = 0
}

fn grad_attr(h: u64, p: u64, n: u64) {
    if g_cur < 0 {
        return
    }
    let g: usize = g_cur as usize
    if h == svgnames.A_UNITS {
        if svgnames.hash_name(p, n) == svgnames.V_USER {
            g_units[g] = 1
        }
        return
    }
    if h == svgnames.A_GTRANSFORM {
        unsup = unsup + 1
        return
    }
    svgscan.begin(p, n)
    let v: i64 = svgscan.num()
    if !svgscan.ok() {
        return
    }
    if h == svgnames.A_X1 {
        g_x1[g] = v
    } else if h == svgnames.A_Y1 {
        g_y1[g] = v
    } else if h == svgnames.A_X2 {
        g_x2[g] = v
    } else if h == svgnames.A_Y2 {
        g_y2[g] = v
    }
}

fn grad_stop(off: i64, rgb: i64, sa: i64) {
    if g_cur < 0 {
        return
    }
    let n: i64 = g_n[g_cur as usize]
    if n >= MAX_STOPS {
        unsup = unsup + 1
        return
    }
    g_off[(g_cur * MAX_STOPS + n) as usize] = svgmath.clamp(off, 0, 65536)
    g_rgb[(g_cur * MAX_STOPS + n) as usize] = rgb
    g_sa[(g_cur * MAX_STOPS + n) as usize] = sa
    g_n[g_cur as usize] = n + 1
}

fn grad_end() {
    g_cur = 0 - 1
}

fn grad_count() -> i64 {
    return g_count
}

fn grad_device(g: i64, bx0: i64, by0: i64, bx1: i64, by1: i64) {
    var ax: i64 = 0
    var ay: i64 = 0
    var bx: i64 = 0
    var by: i64 = 0
    if g_units[g as usize] == 1 {
        ax = svggeom.dev_x(g_x1[g as usize], g_y1[g as usize])
        ay = svggeom.dev_y(g_x1[g as usize], g_y1[g as usize])
        bx = svggeom.dev_x(g_x2[g as usize], g_y2[g as usize])
        by = svggeom.dev_y(g_x2[g as usize], g_y2[g as usize])
    } else {
        let w: i64 = bx1 - bx0
        let h: i64 = by1 - by0
        ax = bx0 + svgmath.mul16(g_x1[g as usize], w)
        ay = by0 + svgmath.mul16(g_y1[g as usize], h)
        bx = bx0 + svgmath.mul16(g_x2[g as usize], w)
        by = by0 + svgmath.mul16(g_y2[g as usize], h)
    }
    gv_x0 = ax
    gv_y0 = ay
    gv_dx = bx - ax
    gv_dy = by - ay
}

static mut ge_rgb: i64 = 0
static mut ge_a: i64 = 0

fn lerp(a: i64, b: i64, t: i64) -> i64 {
    return a + svgmath.mul16(b - a, t)
}

fn grad_eval(g: i64, px: i64, py: i64) -> i64 {
    let n: i64 = g_n[g as usize]
    if n == 0 {
        ge_rgb = 0
        ge_a = 0
        return 0
    }
    let den: i64 = gv_dx * gv_dx + gv_dy * gv_dy
    var t: i64 = 0
    if den > 0 {
        t = svgmath.clamp(svgmath.rdiv(((px - gv_x0) * gv_dx + (py - gv_y0) * gv_dy) * 65536, den), 0, 65536)
    }
    let base: i64 = g * MAX_STOPS
    if t <= g_off[base as usize] {
        ge_rgb = g_rgb[base as usize]
        ge_a = g_sa[base as usize]
        return ge_rgb
    }
    var i: i64 = 0
    while i + 1 < n {
        let o0: i64 = g_off[(base + i) as usize]
        let o1: i64 = g_off[(base + i + 1) as usize]
        if t <= o1 {
            var u: i64 = 65536
            if o1 > o0 {
                u = svgmath.div16(t - o0, o1 - o0)
            }
            let c0: i64 = g_rgb[(base + i) as usize]
            let c1: i64 = g_rgb[(base + i + 1) as usize]
            let r: i64 = lerp((c0 >> 16) & 255, (c1 >> 16) & 255, u)
            let gg: i64 = lerp((c0 >> 8) & 255, (c1 >> 8) & 255, u)
            let b: i64 = lerp(c0 & 255, c1 & 255, u)
            ge_rgb = r * 65536 + gg * 256 + b
            ge_a = lerp(g_sa[(base + i) as usize], g_sa[(base + i + 1) as usize], u)
            return ge_rgb
        }
        i = i + 1
    }
    ge_rgb = g_rgb[(base + n - 1) as usize]
    ge_a = g_sa[(base + n - 1) as usize]
    return ge_rgb
}

fn grad_alpha() -> i64 {
    return ge_a
}

fn color_of(p: u64, n: u64) -> i64 {
    parse_paint(p, n)
    if pk == 1 {
        return prgb
    }
    return 0 - 1
}

fn color_alpha() -> i64 {
    return pa
}

fn opacity_value(p: u64, n: u64) -> i64 {
    return opacity_of(p, n)
}
