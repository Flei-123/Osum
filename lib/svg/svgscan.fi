profile kernel

import svg.svgmath

export {
    begin, at_end, peek, advance, pos, set_pos, byte_at, left, ok, clear_ok,
    skip_ws, skip_sep, is_digit, is_num_start, num, flag
}

static mut s_p: u64 = 0
static mut s_n: u64 = 0
static mut s_i: u64 = 0
static mut s_ok: u64 = 1

fn begin(p: u64, n: u64) {
    s_p = p
    s_n = n
    s_i = 0
    s_ok = 1
}

fn at_end() -> bool {
    return s_i >= s_n
}

fn left() -> u64 {
    if s_i >= s_n {
        return 0
    }
    return s_n - s_i
}

fn byte_at(i: u64) -> u64 {
    if i >= s_n {
        return 0
    }
    return (__mmio_read8((s_p + i) as *mut u8)) as u64
}

fn peek() -> u64 {
    return byte_at(s_i)
}

fn advance() {
    if s_i < s_n {
        s_i = s_i + 1
    }
}

fn pos() -> u64 {
    return s_i
}

fn set_pos(i: u64) {
    s_i = i
}

fn ok() -> bool {
    return s_ok != 0
}

fn clear_ok() {
    s_ok = 1
}

fn is_ws(c: u64) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn is_digit(c: u64) -> bool {
    return c >= 48 && c <= 57
}

fn is_num_start(c: u64) -> bool {
    return is_digit(c) || c == 46 || c == 43 || c == 45
}

fn skip_ws() {
    while s_i < s_n && is_ws(peek()) {
        s_i = s_i + 1
    }
}

fn skip_sep() {
    skip_ws()
    if peek() == 44 {
        s_i = s_i + 1
    }
    skip_ws()
}

fn pow10(k: i64) -> i64 {
    var r: i64 = 1
    var i: i64 = 0
    while i < k {
        r = r * 10
        i = i + 1
    }
    return r
}

fn num() -> i64 {
    skip_sep()
    var neg: bool = false
    var c: u64 = peek()
    if c == 43 || c == 45 {
        neg = c == 45
        advance()
        c = peek()
    }
    var ip: i64 = 0
    var digits: i64 = 0
    while is_digit(peek()) {
        if ip < 100000000 {
            ip = ip * 10 + (peek() - 48) as i64
        }
        digits = digits + 1
        advance()
    }
    var fnum: i64 = 0
    var fden: i64 = 1
    if peek() == 46 {
        advance()
        while is_digit(peek()) {
            if fden < 1000000000 {
                fnum = fnum * 10 + (peek() - 48) as i64
                fden = fden * 10
            }
            digits = digits + 1
            advance()
        }
    }
    if digits == 0 {
        s_ok = 0
        return 0
    }
    var v: i64 = ip * 65536 + svgmath.rdiv(fnum * 65536, fden)
    let e: u64 = peek()
    if e == 101 || e == 69 {
        let save: u64 = s_i
        advance()
        var eneg: bool = false
        if peek() == 43 || peek() == 45 {
            eneg = peek() == 45
            advance()
        }
        if is_digit(peek()) {
            var ex: i64 = 0
            while is_digit(peek()) {
                if ex < 40 {
                    ex = ex * 10 + (peek() - 48) as i64
                }
                advance()
            }
            if ex > 8 {
                ex = 8
            }
            if eneg {
                v = svgmath.rdiv(v, pow10(ex))
            } else {
                v = v * pow10(ex)
            }
        } else {
            s_i = save
        }
    }
    if neg {
        return 0 - v
    }
    return v
}

fn flag() -> i64 {
    skip_sep()
    let c: u64 = peek()
    if c == 48 || c == 49 {
        advance()
        return (c - 48) as i64
    }
    s_ok = 0
    return 0
}
