import hwinv.buf

export { reset_scan, feed_pci, feed_usb, feed_fw,
    pci_total, n_ahci, n_nvme, n_raid, n_ide, raid_intel, gpu_vendor, gpu_device, n_gpu,
    wlan_vendor, wlan_device, n_wlan, n_eth, eth_vendor, eth_device, n_audio, audio_vendor, audio_device,
    n_i2c, n_serial_other, n_xhci, n_ehci, n_mei, usb_total, usb_kbd, usb_mouse, usb_camera, usb_bt,
    usb_hid, fw_uefi, fw_seen }

static mut c: [u64; 40] = [0 as u64; 40]

const PCI_TOTAL: u64 = 0
const AHCI: u64 = 1
const NVME: u64 = 2
const RAID: u64 = 3
const IDE: u64 = 4
const RAID_INTEL: u64 = 5
const GPU_V: u64 = 6
const GPU_D: u64 = 7
const GPU_N: u64 = 8
const WLAN_V: u64 = 9
const WLAN_D: u64 = 10
const WLAN_N: u64 = 11
const ETH_N: u64 = 12
const ETH_V: u64 = 13
const ETH_D: u64 = 14
const AUDIO_N: u64 = 15
const AUDIO_V: u64 = 16
const AUDIO_D: u64 = 17
const I2C_N: u64 = 18
const SERIAL_OTHER: u64 = 19
const XHCI: u64 = 20
const EHCI: u64 = 21
const MEI: u64 = 22
const USB_TOTAL: u64 = 23
const USB_KBD: u64 = 24
const USB_MOUSE: u64 = 25
const USB_CAM: u64 = 26
const USB_BT: u64 = 27
const USB_HID: u64 = 28
const FW_UEFI: u64 = 29
const FW_SEEN: u64 = 30

fn reset_scan() {
    var i: u64 = 0
    while i < 40 {
        c[i as usize] = 0
        i = i + 1
    }
}

fn pci_total() -> u64 { return c[PCI_TOTAL as usize] }
fn n_ahci() -> u64 { return c[AHCI as usize] }
fn n_nvme() -> u64 { return c[NVME as usize] }
fn n_raid() -> u64 { return c[RAID as usize] }
fn n_ide() -> u64 { return c[IDE as usize] }
fn raid_intel() -> u64 { return c[RAID_INTEL as usize] }
fn gpu_vendor() -> u64 { return c[GPU_V as usize] }
fn gpu_device() -> u64 { return c[GPU_D as usize] }
fn n_gpu() -> u64 { return c[GPU_N as usize] }
fn wlan_vendor() -> u64 { return c[WLAN_V as usize] }
fn wlan_device() -> u64 { return c[WLAN_D as usize] }
fn n_wlan() -> u64 { return c[WLAN_N as usize] }
fn n_eth() -> u64 { return c[ETH_N as usize] }
fn eth_vendor() -> u64 { return c[ETH_V as usize] }
fn eth_device() -> u64 { return c[ETH_D as usize] }
fn n_audio() -> u64 { return c[AUDIO_N as usize] }
fn audio_vendor() -> u64 { return c[AUDIO_V as usize] }
fn audio_device() -> u64 { return c[AUDIO_D as usize] }
fn n_i2c() -> u64 { return c[I2C_N as usize] }
fn n_serial_other() -> u64 { return c[SERIAL_OTHER as usize] }
fn n_xhci() -> u64 { return c[XHCI as usize] }
fn n_ehci() -> u64 { return c[EHCI as usize] }
fn n_mei() -> u64 { return c[MEI as usize] }
fn usb_total() -> u64 { return c[USB_TOTAL as usize] }
fn usb_kbd() -> u64 { return c[USB_KBD as usize] }
fn usb_mouse() -> u64 { return c[USB_MOUSE as usize] }
fn usb_camera() -> u64 { return c[USB_CAM as usize] }
fn usb_bt() -> u64 { return c[USB_BT as usize] }
fn usb_hid() -> u64 { return c[USB_HID as usize] }
fn fw_uefi() -> u64 { return c[FW_UEFI as usize] }
fn fw_seen() -> u64 { return c[FW_SEEN as usize] }

fn bump(i: u64) {
    c[i as usize] = c[i as usize] + 1
}

fn first(slot_n: u64, slot_v: u64, slot_d: u64, ven: u64, dev: u64) {
    if c[slot_n as usize] == 0 {
        c[slot_v as usize] = ven
        c[slot_d as usize] = dev
    }
    bump(slot_n)
}

fn serial_io_i2c(dev: u64) -> bool {
    return (dev >= 0x9d60 && dev <= 0x9d65) || (dev >= 0xa160 && dev <= 0xa163) || (dev >= 0x9ea8 && dev <= 0x9eab)
        || (dev >= 0x02e8 && dev <= 0x02eb) || (dev >= 0x43e8 && dev <= 0x43eb) || (dev >= 0xa0e8 && dev <= 0xa0eb)
}

fn pci_line(l: u64, n: u64) {
    if n < 22 || buf.ld(l, 2) != 58 || buf.ld(l, 5) != 46 {
        return
    }
    let cls: u64 = buf.hex_at(l, 8, 4)
    let ven: u64 = buf.hex_at(l, 13, 4)
    let dev: u64 = buf.hex_at(l, 18, 4)
    bump(PCI_TOTAL)
    if cls == 0x0106 {
        bump(AHCI)
    } else if cls == 0x0108 {
        bump(NVME)
    } else if cls == 0x0104 {
        bump(RAID)
        if ven == 0x8086 {
            bump(RAID_INTEL)
        }
    } else if cls == 0x0101 {
        bump(IDE)
    } else if (cls >> 8) == 0x03 {
        first(GPU_N, GPU_V, GPU_D, ven, dev)
    } else if cls == 0x0280 {
        first(WLAN_N, WLAN_V, WLAN_D, ven, dev)
    } else if cls == 0x0200 {
        first(ETH_N, ETH_V, ETH_D, ven, dev)
    } else if cls == 0x0403 || cls == 0x0401 {
        first(AUDIO_N, AUDIO_V, AUDIO_D, ven, dev)
    } else if cls == 0x0c03 {
        bump(XHCI)
    } else if cls == 0x0780 {
        bump(MEI)
    } else if cls == 0x1180 && ven == 0x8086 {
        if serial_io_i2c(dev) {
            bump(I2C_N)
        } else {
            bump(SERIAL_OTHER)
        }
    }
}

fn usb_line(l: u64, n: u64) {
    var w_id: [u8; 7] = " port=\0"
    var w_kbd: [u8; 16] = "driver=keyboard\0"
    var w_mouse: [u8; 13] = "driver=mouse\0"
    var w_hid: [u8; 11] = "driver=hid\0"
    var w_vid: [u8; 5] = "=0e/\0"
    var w_bt: [u8; 9] = "e0/01/01\0"
    if !buf.contains(l, n, (&w_id[0]) as u64) {
        return
    }
    bump(USB_TOTAL)
    if buf.contains(l, n, (&w_kbd[0]) as u64) {
        bump(USB_KBD)
    }
    if buf.contains(l, n, (&w_mouse[0]) as u64) {
        bump(USB_MOUSE)
    }
    if buf.contains(l, n, (&w_hid[0]) as u64) {
        bump(USB_HID)
    }
    if buf.contains(l, n, (&w_bt[0]) as u64) {
        bump(USB_BT)
    }
    if buf.contains(l, n, (&w_vid[0]) as u64) {
        bump(USB_CAM)
    }
}

fn fw_line(l: u64, n: u64) {
    var w_bm: [u8; 12] = "boot_mode: \0"
    var w_uefi: [u8; 5] = "UEFI\0"
    if buf.contains(l, n, (&w_bm[0]) as u64) {
        bump(FW_SEEN)
        if buf.contains(l, n, (&w_uefi[0]) as u64) {
            bump(FW_UEFI)
        }
    }
}

fn each(p: u64, n: u64, kind: u64) {
    var at: u64 = 0
    while at < n {
        let e: u64 = buf.line_end(p, at, n)
        if kind == 0 {
            pci_line(p + at, e - at)
        } else if kind == 1 {
            usb_line(p + at, e - at)
        } else {
            fw_line(p + at, e - at)
        }
        at = e + 1
    }
}

fn feed_pci(p: u64, n: u64) { each(p, n, 0) }
fn feed_usb(p: u64, n: u64) { each(p, n, 1) }
fn feed_fw(p: u64, n: u64) { each(p, n, 2) }
