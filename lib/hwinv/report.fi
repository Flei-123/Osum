// SPDX-License-Identifier: GPL-2.0-only
import hwinv.buf
import hwinv.scan
import hwinv.names

export { build, VERSION }

const VERSION: u64 = 1

fn key(k: u64) {
    var tag: [u8; 8] = "hwinv: \0"
    var eq: [u8; 2] = "=\0"
    buf.put_s((&tag[0]) as u64)
    buf.put_s(k)
    buf.put_s((&eq[0]) as u64)
}

fn id_pair(ven: u64, dev: u64) {
    var colon: [u8; 2] = ":\0"
    buf.put_hex(ven, 4)
    buf.put_s((&colon[0]) as u64)
    buf.put_hex(dev, 4)
}

fn sp() {
    var s: [u8; 2] = " \0"
    buf.put_s((&s[0]) as u64)
}

fn storage_kinds() {
    var ahci: [u8; 5] = "ahci\0"
    var nvme: [u8; 5] = "nvme\0"
    var raid: [u8; 5] = "raid\0"
    var ide: [u8; 4] = "ide\0"
    var none: [u8; 5] = "none\0"
    var plus: [u8; 2] = "+\0"
    var first: bool = true
    if scan.n_ahci() > 0 {
        buf.put_s((&ahci[0]) as u64)
        first = false
    }
    if scan.n_nvme() > 0 {
        if !first { buf.put_s((&plus[0]) as u64) }
        buf.put_s((&nvme[0]) as u64)
        first = false
    }
    if scan.n_raid() > 0 {
        if !first { buf.put_s((&plus[0]) as u64) }
        buf.put_s((&raid[0]) as u64)
        first = false
    }
    if scan.n_ide() > 0 {
        if !first { buf.put_s((&plus[0]) as u64) }
        buf.put_s((&ide[0]) as u64)
        first = false
    }
    if first {
        buf.put_s((&none[0]) as u64)
    }
}

fn storage_verdict() {
    var ok: [u8; 3] = "ok\0"
    var rst: [u8; 61] = "raid-rst-nvme-hidden (BIOS: set SATA mode to AHCI, not RAID)\0"
    var raid: [u8; 26] = "raid-controller-no-driver\0"
    var nodisk: [u8; 8] = "no-disk\0"
    if scan.raid_intel() > 0 && scan.n_nvme() == 0 {
        buf.put_s((&rst[0]) as u64)
    } else if scan.n_raid() > 0 && scan.n_nvme() == 0 && scan.n_ahci() == 0 {
        buf.put_s((&raid[0]) as u64)
    } else if scan.n_nvme() > 0 || scan.n_ahci() > 0 || scan.n_ide() > 0 {
        buf.put_s((&ok[0]) as u64)
    } else {
        buf.put_s((&nodisk[0]) as u64)
    }
}

fn firmware() {
    var uefi: [u8; 5] = "UEFI\0"
    var bios: [u8; 5] = "BIOS\0"
    var unk: [u8; 8] = "unknown\0"
    if scan.fw_seen() == 0 {
        buf.put_s((&unk[0]) as u64)
    } else if scan.fw_uefi() > 0 {
        buf.put_s((&uefi[0]) as u64)
    } else {
        buf.put_s((&bios[0]) as u64)
    }
}

fn pointing() {
    var i2c: [u8; 13] = "i2c-possible\0"
    var usb: [u8; 4] = "usb\0"
    var none: [u8; 16] = "ps2-or-unlisted\0"
    if scan.usb_mouse() > 0 || scan.usb_hid() > 0 {
        buf.put_s((&usb[0]) as u64)
        sp()
    }
    if scan.n_i2c() > 0 {
        buf.put_s((&i2c[0]) as u64)
    } else {
        buf.put_s((&none[0]) as u64)
    }
}

fn dev_line(k: u64, n: u64, ven: u64, dev: u64, with_names: u64) {
    var none: [u8; 5] = "none\0"
    var drv: [u8; 8] = "driver=\0"
    key(k)
    if n == 0 {
        buf.put_s((&none[0]) as u64)
        buf.put_nl()
        return
    }
    id_pair(ven, dev)
    sp()
    if with_names == 1 {
        names.put_wlan_name(ven, dev)
        sp()
        buf.put_s((&drv[0]) as u64)
        names.put_wlan_driver(ven, dev)
    } else if with_names == 2 {
        names.put_gpu_name(ven, dev)
    }
    buf.put_nl()
}

fn count_line(k: u64, n: u64) {
    key(k)
    buf.put_dec(n)
    buf.put_nl()
}

fn build(pci_p: u64, pci_n: u64, usb_p: u64, usb_n: u64, fw_p: u64, fw_n: u64) -> u64 {
    var k_ver: [u8; 8] = "version\0"
    var k_fw: [u8; 9] = "firmware\0"
    var k_pci: [u8; 12] = "pci_devices\0"
    var k_st: [u8; 8] = "storage\0"
    var k_sv: [u8; 16] = "storage_verdict\0"
    var k_gpu: [u8; 4] = "gpu\0"
    var k_wl: [u8; 5] = "wlan\0"
    var k_eth: [u8; 9] = "ethernet\0"
    var k_au: [u8; 6] = "audio\0"
    var k_i2c: [u8; 13] = "serialio_i2c\0"
    var k_pt: [u8; 9] = "pointing\0"
    var k_xh: [u8; 5] = "xhci\0"
    var k_usb: [u8; 12] = "usb_devices\0"
    var k_kbd: [u8; 8] = "usb_kbd\0"
    var k_cam: [u8; 11] = "usb_camera\0"
    var k_bt: [u8; 7] = "usb_bt\0"
    var k_mei: [u8; 3] = "me\0"
    var h_pci: [u8; 11] = "== pci ==\n\0"
    var h_usb: [u8; 11] = "== usb ==\n\0"
    var h_fw: [u8; 16] = "== firmware ==\n\0"
    buf.reset_out()
    scan.reset_scan()
    scan.feed_pci(pci_p, pci_n)
    scan.feed_usb(usb_p, usb_n)
    scan.feed_fw(fw_p, fw_n)
    key((&k_ver[0]) as u64)
    buf.put_dec(VERSION)
    buf.put_nl()
    key((&k_fw[0]) as u64)
    firmware()
    buf.put_nl()
    count_line((&k_pci[0]) as u64, scan.pci_total())
    key((&k_st[0]) as u64)
    storage_kinds()
    buf.put_nl()
    key((&k_sv[0]) as u64)
    storage_verdict()
    buf.put_nl()
    dev_line((&k_gpu[0]) as u64, scan.n_gpu(), scan.gpu_vendor(), scan.gpu_device(), 2)
    dev_line((&k_wl[0]) as u64, scan.n_wlan(), scan.wlan_vendor(), scan.wlan_device(), 1)
    dev_line((&k_eth[0]) as u64, scan.n_eth(), scan.eth_vendor(), scan.eth_device(), 0)
    dev_line((&k_au[0]) as u64, scan.n_audio(), scan.audio_vendor(), scan.audio_device(), 0)
    count_line((&k_i2c[0]) as u64, scan.n_i2c())
    key((&k_pt[0]) as u64)
    pointing()
    buf.put_nl()
    count_line((&k_xh[0]) as u64, scan.n_xhci())
    count_line((&k_mei[0]) as u64, scan.n_mei())
    count_line((&k_usb[0]) as u64, scan.usb_total())
    count_line((&k_kbd[0]) as u64, scan.usb_kbd())
    count_line((&k_cam[0]) as u64, scan.usb_camera())
    count_line((&k_bt[0]) as u64, scan.usb_bt())
    buf.put_s((&h_pci[0]) as u64)
    copy_raw(pci_p, pci_n)
    buf.put_s((&h_usb[0]) as u64)
    copy_raw(usb_p, usb_n)
    buf.put_s((&h_fw[0]) as u64)
    copy_raw(fw_p, fw_n)
    return buf.out_len()
}

fn copy_raw(p: u64, n: u64) {
    var i: u64 = 0
    var one: [u8; 2] = " \0"
    while i < n {
        one[0] = buf.ld(p, i) as u8
        buf.put_s((&one[0]) as u64)
        i = i + 1
    }
}
