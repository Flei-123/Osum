import hwinv.buf

export { put_wlan_name, put_gpu_name, put_wlan_driver }

fn put_wlan_name(ven: u64, dev: u64) {
    var intel: [u8; 7] = "intel-\0"
    var unk: [u8; 8] = "unknown\0"
    var n8265: [u8; 5] = "8265\0"
    var n8260: [u8; 5] = "8260\0"
    var n7265: [u8; 5] = "7265\0"
    var n7260: [u8; 5] = "7260\0"
    var n9260: [u8; 5] = "9260\0"
    var n9560: [u8; 5] = "9560\0"
    var nax201: [u8; 6] = "ax201\0"
    var nax200: [u8; 6] = "ax200\0"
    var nax210: [u8; 6] = "ax210\0"
    if ven != 0x8086 {
        buf.put_s((&unk[0]) as u64)
        return
    }
    buf.put_s((&intel[0]) as u64)
    if dev == 0x24fd || dev == 0x24fb {
        buf.put_s((&n8265[0]) as u64)
    } else if dev == 0x24f3 || dev == 0x24f4 {
        buf.put_s((&n8260[0]) as u64)
    } else if dev == 0x095a || dev == 0x095b {
        buf.put_s((&n7265[0]) as u64)
    } else if dev == 0x08b1 || dev == 0x08b2 {
        buf.put_s((&n7260[0]) as u64)
    } else if dev == 0x2526 {
        buf.put_s((&n9260[0]) as u64)
    } else if dev == 0xa370 || dev == 0x9df0 || dev == 0x30dc {
        buf.put_s((&n9560[0]) as u64)
    } else if dev == 0x02f0 || dev == 0x06f0 || dev == 0xa0f0 || dev == 0x34f0 || dev == 0x43f0 {
        buf.put_s((&nax201[0]) as u64)
    } else if dev == 0x2723 {
        buf.put_s((&nax200[0]) as u64)
    } else if dev == 0x2725 {
        buf.put_s((&nax210[0]) as u64)
    } else {
        buf.put_s((&unk[0]) as u64)
    }
}

fn put_wlan_driver(ven: u64, dev: u64) {
    var probe: [u8; 11] = "probe-only\0"
    var none: [u8; 5] = "none\0"
    if ven == 0x8086 && (dev == 0x2723 || dev == 0x02f0 || dev == 0x06f0 || dev == 0xa0f0 || dev == 0x34f0 || dev == 0x43f0) {
        buf.put_s((&probe[0]) as u64)
    } else {
        buf.put_s((&none[0]) as u64)
    }
}

fn put_gpu_name(ven: u64, dev: u64) {
    var hd620: [u8; 12] = "intel-hd620\0"
    var hd: [u8; 10] = "intel-gen\0"
    var qemu: [u8; 5] = "qemu\0"
    var unk: [u8; 8] = "unknown\0"
    if ven == 0x8086 && (dev == 0x5916 || dev == 0x5917) {
        buf.put_s((&hd620[0]) as u64)
    } else if ven == 0x8086 {
        buf.put_s((&hd[0]) as u64)
    } else if ven == 0x1234 || ven == 0x1af4 || ven == 0x15ad {
        buf.put_s((&qemu[0]) as u64)
    } else {
        buf.put_s((&unk[0]) as u64)
    }
}
