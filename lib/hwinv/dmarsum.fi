// SPDX-License-Identifier: GPL-2.0-only
import hwinv.buf

export { feed, seen, present, drhd, rmrr, intr_remap, optin, translation }

static mut v: [u64; 8] = [0 as u64; 8]

const SEEN: u64 = 0
const PRESENT: u64 = 1
const DRHD: u64 = 2
const RMRR: u64 = 3
const IR: u64 = 4
const OPTIN: u64 = 5
const TRANS: u64 = 6

fn num_after(p: u64, n: u64, at: u64, e: u64, k: u64) -> u64 {
    var kl: u64 = 0
    while buf.ld(k, kl) != 0 {
        kl = kl + 1
    }
    var i: u64 = at
    while i + kl < e {
        var j: u64 = 0
        while j < kl && buf.ld(p, i + j) == buf.ld(k, j) {
            j = j + 1
        }
        if j == kl {
            var x: u64 = 0
            var q: u64 = i + kl
            while q < e && buf.ld(p, q) >= 48 && buf.ld(p, q) <= 57 {
                x = x * 10 + buf.ld(p, q) - 48
                q = q + 1
            }
            return x
        }
        i = i + 1
    }
    return 0
}

fn feed(p: u64, n: u64) {
    var w_none: [u8; 11] = "dmar: none\0"
    var w_pres: [u8; 14] = "dmar: present\0"
    var w_cnt: [u8; 13] = "dmar: counts\0"
    var w_unit: [u8; 12] = "dmar: unit \0"
    var k_dr: [u8; 6] = "drhd=\0"
    var k_rm: [u8; 6] = "rmrr=\0"
    var k_ir: [u8; 12] = "intr_remap=\0"
    var k_op: [u8; 11] = "dma_optin=\0"
    var k_on: [u8; 16] = "translation=on\0\0"
    var k_off: [u8; 16] = "translation=off\0"
    var i: u64 = 0
    while i < 8 {
        v[i as usize] = 0
        i = i + 1
    }
    if n == 0 {
        return
    }
    v[SEEN as usize] = 1
    var at: u64 = 0
    while at < n {
        let e: u64 = buf.line_end(p, at, n)
        let l: u64 = e - at
        if buf.contains(p + at, l, (&w_none[0]) as u64) {
            v[PRESENT as usize] = 0
        }
        if buf.contains(p + at, l, (&w_pres[0]) as u64) {
            v[PRESENT as usize] = 1
            v[IR as usize] = num_after(p, n, at, e, (&k_ir[0]) as u64)
            v[OPTIN as usize] = num_after(p, n, at, e, (&k_op[0]) as u64)
        }
        if buf.contains(p + at, l, (&w_cnt[0]) as u64) {
            v[DRHD as usize] = num_after(p, n, at, e, (&k_dr[0]) as u64)
            v[RMRR as usize] = num_after(p, n, at, e, (&k_rm[0]) as u64)
        }
        if buf.contains(p + at, l, (&w_unit[0]) as u64) {
            if buf.contains(p + at, l, (&k_on[0]) as u64) {
                v[TRANS as usize] = 2
            } else if buf.contains(p + at, l, (&k_off[0]) as u64) {
                if v[TRANS as usize] == 0 {
                    v[TRANS as usize] = 1
                }
            }
        }
        at = e + 1
    }
}

fn seen() -> u64 { return v[SEEN as usize] }
fn present() -> u64 { return v[PRESENT as usize] }
fn drhd() -> u64 { return v[DRHD as usize] }
fn rmrr() -> u64 { return v[RMRR as usize] }
fn intr_remap() -> u64 { return v[IR as usize] }
fn optin() -> u64 { return v[OPTIN as usize] }
fn translation() -> u64 { return v[TRANS as usize] }
