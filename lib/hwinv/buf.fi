// SPDX-License-Identifier: GPL-2.0-only
export { reset_out, put_s, put_dec, put_hex, put_nl, out_ptr, out_len, ld, contains, line_end, hex_at }

const CAP: u64 = 6144

static mut out: [u8; 6144] = [0 as u8; 6144]
static mut out_n: u64 = 0

fn ld(p: u64, i: u64) -> u64 {
    let b: u8 = *((p + i) as *mut u8)
    return b as u64
}

fn reset_out() {
    out_n = 0
}

fn out_ptr() -> u64 {
    return (&out[0]) as u64
}

fn out_len() -> u64 {
    return out_n
}

fn put_c(c: u64) {
    if out_n + 1 < CAP {
        out[out_n as usize] = c as u8
        out_n = out_n + 1
    }
}

fn put_s(s: u64) {
    var i: u64 = 0
    while ld(s, i) != 0 {
        put_c(ld(s, i))
        i = i + 1
    }
}

fn put_nl() {
    put_c(10)
}

fn put_dec(v: u64) {
    var tmp: [u8; 20] = [0 as u8; 20]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        put_c(48)
        return
    }
    while x > 0 {
        tmp[n as usize] = (48 + x % 10) as u8
        n = n + 1
        x = x / 10
    }
    while n > 0 {
        n = n - 1
        put_c(tmp[n as usize] as u64)
    }
}

fn put_hex(v: u64, digits: u64) {
    var i: u64 = digits
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * 4)) & 15
        if d < 10 {
            put_c(48 + d)
        } else {
            put_c(87 + d)
        }
    }
}

fn hex_at(p: u64, off: u64, n: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < n {
        let c: u64 = ld(p, off + i)
        var d: u64 = 0
        if c >= 48 && c <= 57 {
            d = c - 48
        } else if c >= 97 && c <= 102 {
            d = c - 87
        } else if c >= 65 && c <= 70 {
            d = c - 55
        }
        v = v * 16 + d
        i = i + 1
    }
    return v
}

fn contains(p: u64, n: u64, w: u64) -> bool {
    var wl: u64 = 0
    while ld(w, wl) != 0 {
        wl = wl + 1
    }
    if wl == 0 || wl > n {
        return false
    }
    var i: u64 = 0
    while i + wl <= n {
        var j: u64 = 0
        while j < wl && ld(p, i + j) == ld(w, j) {
            j = j + 1
        }
        if j == wl {
            return true
        }
        i = i + 1
    }
    return false
}

fn line_end(p: u64, at: u64, n: u64) -> u64 {
    var e: u64 = at
    while e < n && ld(p, e) != 10 {
        e = e + 1
    }
    return e
}
