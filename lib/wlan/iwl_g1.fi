import wlan.iwl_probe
import wlan.iwl_pwr
import wlan.iwl_le

export {
    Prog, prog_new, prog_add, prog_len, prog_kind, prog_addr, prog_val, prog_run,
    prog_rx_init, prog_tx_init, prog_tx_cmd_init, prog_tx_linux, prog_scd_init, prog_txq_enable, prog_rx_wptr, prog_tx_doorbell,
    rx_stop, rx_status_closed, rx_bd_put, rx_cfg_value,
    K_DIRECT, K_PRPH, K_SRAM, K_PRPH_SET, K_CSR, K_CSR8,
    FH_RCSR_RBDCB_WPTR, FH_RCSR_FLUSH_RB_REQ, FH_RSCSR_RDPTR, INT_COALESCING_DEFAULT,
    FH_KW_MEM_ADDR_REG, FH_RSCSR_STTS_WPTR, FH_RSCSR_RBDCB_BASE, FH_RSCSR_RBDCB_WPTR, FH_RCSR_CONFIG, FH_RSSR_RX_STATUS,
    FH_TCSR_BASE, FH_TX_CHICKEN, CSR_INT_COALESCING, HBUS_TARG_WRPTR, HBUS_MEM_WADDR, HBUS_MEM_WDAT,
    SCD_SRAM_BASE_ADDR, SCD_DRAM_BASE_ADDR, SCD_TXFACT, SCD_CHAINEXT_EN, SCD_GP_CTRL,
    RX_BD_COUNT, RX_BD_LOG2, RX_STTS_SIZE, SCD_FIFO_CMD,
    cbbc_reg, scd_status_reg, scd_rdptr_reg, scd_ctx_offset, rx_cfg_enable,
    E_G1_PROG, E_G1_ACCESS, E_G1_IDLE
}

const FH_KW_MEM_ADDR_REG: u64 = 0x197C
const FH_MEM_CBBC_0_15: u64 = 0x19D0
const FH_MEM_CBBC_16_19: u64 = 0x1BF0
const FH_MEM_CBBC_20_31: u64 = 0x1B20
const FH_RSCSR_STTS_WPTR: u64 = 0x1BC0
const FH_RSCSR_RBDCB_BASE: u64 = 0x1BC4
const FH_RSCSR_RBDCB_WPTR: u64 = 0x1BC8
const FH_RCSR_CONFIG: u64 = 0x1C00
const FH_RCSR_RBDCB_WPTR: u64 = 0x1C08
const FH_RCSR_FLUSH_RB_REQ: u64 = 0x1C10
const FH_RSCSR_RDPTR: u64 = 0x1BCC
const FH_RSSR_RX_STATUS: u64 = 0x1C44
const FH_RSSR_CHNL0_IDLE: u64 = 0x01000000
const FH_TCSR_BASE: u64 = 0x1D00
const FH_TCSR_CHNL_NUM: u64 = 8
const FH_TX_CHICKEN: u64 = 0x1E98
const FH_TX_CHICKEN_AUTO_RETRY: u64 = 0x2
const TCSR_ENABLE: u64 = 0x80000000
const TCSR_CREDIT_ENABLE: u64 = 0x8
const CSR_INT_COALESCING: u64 = 0x004
const INT_COALESCING_DEFAULT: u64 = 0x40
const HBUS_TARG_WRPTR: u64 = 0x460
const HBUS_MEM_WADDR: u64 = 0x410
const HBUS_MEM_WDAT: u64 = 0x418

const SCD_BASE: u64 = 0xA02C00
const SCD_SRAM_BASE_ADDR: u64 = 0xA02C00
const SCD_DRAM_BASE_ADDR: u64 = 0xA02C08
const SCD_TXFACT: u64 = 0xA02C10
const SCD_CHAINEXT_EN: u64 = 0xA02E44
const SCD_GP_CTRL: u64 = 0xA02DA8
const SCD_QUEUE_RDPTR_BASE: u64 = 0xA02C68
const SCD_QUEUE_STATUS_BASE: u64 = 0xA02D0C
const SCD_CONTEXT_MEM: u64 = 0x600
const SCD_GP_ENABLE_31: u64 = 0x1
const SCD_GP_AUTO_ACTIVE: u64 = 0x40000
const SCD_STTS_ACTIVE: u64 = 3
const SCD_STTS_TXF: u64 = 0
const SCD_STTS_WSL: u64 = 4
const SCD_STTS_MSK: u64 = 0x017F0000
const SCD_WIN_SIZE: u64 = 64
const SCD_FRAME_LIMIT: u64 = 64
const SCD_FIFO_CMD: u64 = 7
const SCD_TXFACT_ALL: u64 = 0xFF

const RX_BD_COUNT: u64 = 256
const RX_BD_LOG2: u64 = 8
const RX_STTS_SIZE: u64 = 16
const RX_RB_TIMEOUT: u64 = 0x11
const RX_CFG_ENABLE: u64 = 0x80000000
const RX_CFG_IGNORE_RXF_EMPTY: u64 = 0x4
const RX_CFG_IRQ_HOST: u64 = 0x1000
const RX_CFG_RB_4K: u64 = 0x0

const K_DIRECT: u64 = 0
const K_PRPH: u64 = 1
const K_SRAM: u64 = 2
const K_PRPH_SET: u64 = 3
const K_CSR: u64 = 4
const K_CSR8: u64 = 5

const PROG_MAX: usize = 96

const E_G1_PROG: i64 = -60
const E_G1_ACCESS: i64 = -61
const E_G1_IDLE: i64 = -62

struct Prog {
    n: usize,
    kind: [u64; 96],
    addr: [u64; 96],
    val: [u64; 96]
}

fn prog_new() -> Prog {
    var g: Prog = Prog { n: 0, kind: [0; 96], addr: [0; 96], val: [0; 96] }
    return g
}

fn prog_add(g: *mut Prog, k: u64, a: u64, v: u64) -> bool { return add(g, k, a, v) }

fn prog_len(g: *mut Prog) -> usize { return (*g).n }
fn prog_kind(g: *mut Prog, i: usize) -> u64 { return (*g).kind[i] }
fn prog_addr(g: *mut Prog, i: usize) -> u64 { return (*g).addr[i] }
fn prog_val(g: *mut Prog, i: usize) -> u64 { return (*g).val[i] }

fn add(g: *mut Prog, k: u64, a: u64, v: u64) -> bool {
    if (*g).n >= PROG_MAX { return false }
    let i: usize = (*g).n
    (*g).kind[i] = k
    (*g).addr[i] = a
    (*g).val[i] = v & 0xFFFFFFFF
    (*g).n = i + 1
    return true
}

fn cbbc_reg(q: u64) -> u64 {
    if q < 16 { return FH_MEM_CBBC_0_15 + 4 * q }
    if q < 20 { return FH_MEM_CBBC_16_19 + 4 * (q - 16) }
    return FH_MEM_CBBC_20_31 + 4 * (q - 20)
}

fn scd_status_reg(q: u64) -> u64 { return SCD_QUEUE_STATUS_BASE + 4 * q }
fn scd_rdptr_reg(q: u64) -> u64 { return SCD_QUEUE_RDPTR_BASE + 4 * q }
fn scd_ctx_offset(q: u64) -> u64 { return SCD_CONTEXT_MEM + 8 * q }

fn rx_cfg_value(rb_size_code: u64) -> u64 {
    return RX_CFG_ENABLE | RX_CFG_IGNORE_RXF_EMPTY | RX_CFG_IRQ_HOST | (rb_size_code << 16) | (RX_RB_TIMEOUT << 4) | (RX_BD_LOG2 << 20)
}
fn rx_cfg_enable() -> u64 { return rx_cfg_value(0) }

fn prog_rx_init(g: *mut Prog, bd_bus: u64, stts_bus: u64) -> bool {
    if bd_bus & 0xFF != 0 || stts_bus & 0xF != 0 { return false }
    var ok: bool = add(g, K_DIRECT, FH_RCSR_CONFIG, 0)
    ok = ok && add(g, K_DIRECT, FH_RCSR_RBDCB_WPTR, 0)
    ok = ok && add(g, K_DIRECT, FH_RCSR_FLUSH_RB_REQ, 0)
    ok = ok && add(g, K_DIRECT, FH_RSCSR_RDPTR, 0)
    ok = ok && add(g, K_DIRECT, FH_RSCSR_RBDCB_WPTR, 0)
    ok = ok && add(g, K_DIRECT, FH_RSCSR_RBDCB_BASE, bd_bus >> 8)
    ok = ok && add(g, K_DIRECT, FH_RSCSR_STTS_WPTR, stts_bus >> 4)
    ok = ok && add(g, K_DIRECT, FH_RCSR_CONFIG, rx_cfg_enable())
    ok = ok && add(g, K_CSR8, CSR_INT_COALESCING, INT_COALESCING_DEFAULT)
    return ok
}

fn prog_tx_init(g: *mut Prog, kw_bus: u64, cmd_ring: u64, cmd_q: u64, data_ring: u64, data_q: u64) -> bool {
    if kw_bus & 0xF != 0 || cmd_ring & 0xFF != 0 || data_ring & 0xFF != 0 { return false }
    var ok: bool = add(g, K_DIRECT, FH_KW_MEM_ADDR_REG, kw_bus >> 4)
    ok = ok && add(g, K_DIRECT, cbbc_reg(cmd_q), cmd_ring >> 8)
    ok = ok && add(g, K_DIRECT, cbbc_reg(data_q), data_ring >> 8)
    return ok
}

fn prog_tx_linux(g: *mut Prog, kw_bus: u64, ring_bus: u64) -> bool {
    if kw_bus & 0xF != 0 || ring_bus & 0xFF != 0 { return false }
    var ok: bool = add(g, K_PRPH, SCD_TXFACT, 0)
    ok = ok && add(g, K_DIRECT, FH_KW_MEM_ADDR_REG, kw_bus >> 4)
    var q: u64 = 0
    while q < 31 {
        ok = ok && add(g, K_DIRECT, cbbc_reg(q), ring_bus >> 8)
        q = q + 1
    }
    ok = ok && add(g, K_PRPH_SET, SCD_GP_CTRL, SCD_GP_AUTO_ACTIVE | SCD_GP_ENABLE_31)
    return ok
}

fn prog_tx_cmd_init(g: *mut Prog, kw_bus: u64, cmd_ring: u64, cmd_q: u64) -> bool {
    if kw_bus & 0xF != 0 || cmd_ring & 0xFF != 0 { return false }
    var ok: bool = add(g, K_DIRECT, FH_KW_MEM_ADDR_REG, kw_bus >> 4)
    ok = ok && add(g, K_DIRECT, cbbc_reg(cmd_q), cmd_ring >> 8)
    return ok
}

fn prog_scd_init(g: *mut Prog, bc_bus: u64) -> bool {
    if bc_bus & 0x3FF != 0 { return false }
    var ok: bool = add(g, K_PRPH, SCD_DRAM_BASE_ADDR, bc_bus >> 10)
    ok = ok && add(g, K_PRPH, SCD_CHAINEXT_EN, 0)
    ok = ok && add(g, K_PRPH_SET, SCD_GP_CTRL, SCD_GP_AUTO_ACTIVE | SCD_GP_ENABLE_31)
    ok = ok && add(g, K_DIRECT, FH_TX_CHICKEN, FH_TX_CHICKEN_AUTO_RETRY)
    var c: u64 = 0
    while c < FH_TCSR_CHNL_NUM {
        ok = ok && add(g, K_DIRECT, FH_TCSR_BASE + 0x20 * c, TCSR_ENABLE | TCSR_CREDIT_ENABLE)
        c = c + 1
    }
    ok = ok && add(g, K_PRPH, SCD_TXFACT, SCD_TXFACT_ALL)
    return ok
}

fn prog_txq_enable(g: *mut Prog, scd_base: u64, q: u64, fifo: u64) -> bool {
    var ok: bool = add(g, K_PRPH, scd_status_reg(q), 0)
    ok = ok && add(g, K_DIRECT, HBUS_TARG_WRPTR, q << 8)
    ok = ok && add(g, K_PRPH, scd_rdptr_reg(q), 0)
    ok = ok && add(g, K_SRAM, scd_base + scd_ctx_offset(q), 0)
    ok = ok && add(g, K_SRAM, scd_base + scd_ctx_offset(q) + 4, (SCD_FRAME_LIMIT << 16) | SCD_WIN_SIZE)
    ok = ok && add(g, K_PRPH, scd_status_reg(q), (1 << SCD_STTS_ACTIVE) | (fifo << SCD_STTS_TXF) | (1 << SCD_STTS_WSL) | SCD_STTS_MSK)
    return ok
}

fn prog_rx_wptr(g: *mut Prog, restocked: u64) -> bool {
    return add(g, K_DIRECT, FH_RSCSR_RBDCB_WPTR, restocked & 0xFFF8)
}

fn prog_tx_doorbell(g: *mut Prog, q: u64, wr: u64) -> bool {
    return add(g, K_DIRECT, HBUS_TARG_WRPTR, wr | (q << 8))
}

fn sram_write(p: *mut iwl_probe.Probe, addr: u64, v: u64) {
    iwl_pwr.wr(p, HBUS_MEM_WADDR, addr)
    iwl_pwr.wr(p, HBUS_MEM_WDAT, v)
}

fn prog_run(p: *mut iwl_probe.Probe, g: *mut Prog) -> i64 {
    if iwl_pwr.mac_access_get(p) != 0 { return E_G1_ACCESS }
    var i: usize = 0
    while i < (*g).n {
        let k: u64 = (*g).kind[i]
        let a: u64 = (*g).addr[i]
        let v: u64 = (*g).val[i]
        if k == K_DIRECT || k == K_CSR {
            iwl_pwr.wr(p, a, v)
        } else if k == K_CSR8 {
            iwl_pwr.wr(p, a, (iwl_pwr.rd(p, a) & 0xFFFFFF00) | (v & 0xFF))
        } else if k == K_PRPH {
            iwl_pwr.prph_wr(p, a, v)
        } else if k == K_PRPH_SET {
            iwl_pwr.prph_wr(p, a, iwl_pwr.prph_rd(p, a) | v)
        } else if k == K_SRAM {
            sram_write(p, a, v)
        } else {
            iwl_pwr.mac_access_put(p)
            return E_G1_PROG
        }
        i = i + 1
    }
    iwl_pwr.mac_access_put(p)
    return 0
}

fn rx_stop(p: *mut iwl_probe.Probe) -> i64 {
    if iwl_pwr.mac_access_get(p) != 0 { return E_G1_ACCESS }
    iwl_pwr.wr(p, FH_RCSR_CONFIG, 0)
    let idle: bool = iwl_pwr.poll(p, FH_RSSR_RX_STATUS, FH_RSSR_CHNL0_IDLE, FH_RSSR_CHNL0_IDLE)
    iwl_pwr.mac_access_put(p)
    if !idle { return E_G1_IDLE }
    return 0
}

fn rx_bd_put(bd: u64, idx: u64, rb_bus: u64) { iwl_le.st32(bd, 4 * (idx & (RX_BD_COUNT - 1)), rb_bus >> 8) }

fn rx_status_closed(stts: u64) -> u64 { return iwl_le.ld16(stts, 0) & 0xFFF }
