
export {
    Device, device_new, board_set, ccmp_capable_set,
    send, receive, channel_set, key_set,
    ready, channel_of, kann_ccmp_von, address_of, addr_set,
    counter_sent, counter_recv, counter_dropped,
    KEY_PTK, KEY_GTK, KEY_OFF,
    MAX_FRAME
}

const MAX_FRAME: usize = 2400

const KEY_OFF: u64 = 0
const KEY_PTK: u64 = 1
const KEY_GTK: u64 = 2

// ==================================================================
// DIE TAFEL
// ==================================================================
struct Board {
    send: fn(u64, u64, usize) -> i64,
    // empfangen(ctx, puffer, platz) -> Laenge, 0 = nichts da, < 0 Fehler
    receive: fn(u64, u64, usize) -> i64,
    channel_set: fn(u64, u64, u64) -> i64,
    // schluessel_setzen(ctx, art, kennung, schluessel, laenge) -> 0 / < 0
    key_set: fn(u64, u64, u64, u64, usize) -> i64
}

fn empty_send(ctx: u64, pkt: u64, len: usize) -> i64 { return -1 }
fn empty_recv(ctx: u64, buf: u64, room: usize) -> i64 { return -1 }
fn empty_channel(ctx: u64, channel: u64, band: u64) -> i64 { return -1 }
fn empty_key(ctx: u64, art: u64, kennung: u64, k: u64,
    len: usize) -> i64 { return -1 }

struct Device {
    board: Board,
    ctx: u64,
    adr: [u8; 6],
    channel: u64,
    band: u64,
    kann_ccmp: bool,
    ready: bool,
    n_sent: u64,
    n_received: u64,
    n_dropped: u64
}

fn device_new() -> Device {
    var g: Device = Device {
        board: Board { send: empty_send, receive: empty_recv,
                       channel_set: empty_channel,
                       key_set: empty_key },
        ctx: 0,
        adr: [0; 6],
        channel: 0,
        band: 0,
        kann_ccmp: false,
        ready: false,
        n_sent: 0,
        n_received: 0,
        n_dropped: 0
    }
    return g
}

fn board_set(g: *mut Device, ctx: u64,
    send: fn(u64, u64, usize) -> i64,
    receive: fn(u64, u64, usize) -> i64,
    channel_set: fn(u64, u64, u64) -> i64,
    key_set: fn(u64, u64, u64, u64, usize) -> i64,
    kann_ccmp: bool) -> bool {
    (*g).board.send = send
    (*g).board.receive = receive
    (*g).board.channel_set = channel_set
    (*g).board.key_set = key_set
    (*g).ctx = ctx
    (*g).kann_ccmp = kann_ccmp
    (*g).ready = true
    return true
}

fn addr_set(g: *mut Device, a: u64) {
    var i: usize = 0
    while i < 6 {
        (*g).adr[i] = *((a + i as u64) as *mut u8)
        i = i + 1
    }
}

fn address_of(g: *mut Device, out: u64) {
    var i: usize = 0
    while i < 6 {
        *((out + i as u64) as *mut u8) = (*g).adr[i]
        i = i + 1
    }
}

fn ready(g: *mut Device) -> bool { return (*g).ready }
fn channel_of(g: *mut Device) -> u64 { return (*g).channel }
fn kann_ccmp_von(g: *mut Device) -> bool { return (*g).kann_ccmp }
fn ccmp_capable_set(g: *mut Device, on: bool) { (*g).kann_ccmp = on }
fn counter_sent(g: *mut Device) -> u64 { return (*g).n_sent }
fn counter_recv(g: *mut Device) -> u64 { return (*g).n_received }
fn counter_dropped(g: *mut Device) -> u64 { return (*g).n_dropped }

fn send(g: *mut Device, pkt: u64, len: usize) -> i64 {
    if !(*g).ready { return -1 }
    if len < 10 || len > MAX_FRAME {
        (*g).n_dropped = (*g).n_dropped + 1
        return -1
    }
    let t: Board = (*g).board
    let r: i64 = t.send((*g).ctx, pkt, len)
    if r > 0 { (*g).n_sent = (*g).n_sent + 1 }
    return r
}

fn receive(g: *mut Device, buf: u64, room: usize) -> i64 {
    if !(*g).ready { return -1 }
    if room == 0 { return -1 }
    let t: Board = (*g).board
    let r: i64 = t.receive((*g).ctx, buf, room)
    if r > 0 {
        if (r as usize) < 10 {
            (*g).n_dropped = (*g).n_dropped + 1
            return 0
        }
        (*g).n_received = (*g).n_received + 1
    }
    return r
}

fn channel_set(g: *mut Device, channel: u64, band: u64) -> i64 {
    if !(*g).ready { return -1 }
    let t: Board = (*g).board
    let r: i64 = t.channel_set((*g).ctx, channel, band)
    if r >= 0 {
        (*g).channel = channel
        (*g).band = band
    }
    return r
}

fn key_set(g: *mut Device, art: u64, kennung: u64,
    key: u64, len: usize) -> i64 {
    if !(*g).ready { return -1 }
    if art != KEY_OFF {
        if len != 16 { return -1 }
        if key == 0 { return -1 }
    }
    if kennung > 3 { return -1 }
    let t: Board = (*g).board
    return t.key_set((*g).ctx, art, kennung, key, len)
}
