import wlan.device
import wlan.frame
import wlan.iwl_buf
import wlan.iwl_le
import wlan.iwl_fwcaps
import wlan.iwl_mvm
import wlan.iwl_mvm_crypt
import wlan.iwl_mvm_ctx
import wlan.iwl_mvm_rs
import wlan.iwl_mvm_scan
import wlan.iwl_mvm_sta
import wlan.iwl_mvm_te
import wlan.iwl_mvm_tx
import wlan.iwl_mvm_txq

export {
    Mvm, Transport, mvm_new, ops_attach, ops_setup, ops_scan_start, ops_scan_state,
    ops_peer_add, ops_peer_remove, ops_associated, ops_poll_one, ops_rssi, ops_rx_channel,
    ops_keys_sent, ops_cmd_count, ops_set_hw_crypto, ops_sync_board, ops_set_queues, ops_set_address,
    ops_default_channels, ops_set_caps, ops_caps,
    ops_fail_step, ops_fail_rc, ops_fail_cmd, ops_ok_steps, ops_rx_stat, RXS_COUNT,
    STEP_NONE, STEP_PHY_CTX, STEP_MAC_CTX, STEP_BINDING, STEP_SCAN_CFG, STEP_SCAN_REQ, STEP_AUX_STA,
    SCAN_IDLE, SCAN_RUNNING, SCAN_DONE, SCAN_ABORTED,
    E_OPS_STATE, E_OPS_FW, E_OPS_ARGS, STA_AP, STA_AUX, MAX_CHANNELS
}

const SCAN_IDLE: u64 = 0
const SCAN_RUNNING: u64 = 1
const SCAN_DONE: u64 = 2
const SCAN_ABORTED: u64 = 3

const STEP_NONE: u64 = 0
const STEP_PHY_CTX: u64 = 1
const STEP_MAC_CTX: u64 = 2
const STEP_BINDING: u64 = 3
const STEP_SCAN_CFG: u64 = 4
const STEP_SCAN_REQ: u64 = 5
const STEP_AUX_STA: u64 = 6

const E_OPS_STATE: i64 = -60
const E_OPS_FW: i64 = -61
const E_OPS_ARGS: i64 = -62

const STA_AP: u64 = 0
const STA_AUX: u64 = 1
const SESSION_TU: u64 = 800
const SESSION_MAX_DELAY: u64 = 500
const SCAN_CFG_RATES: u64 = 0x0FFF0FFF
const SCAN_CFG_CHAN_FLAGS: u64 = 0xF
const MAC_ID: u64 = 0
const PHY_ID: u64 = 0
const BIND_ID: u64 = 0
const MAX_CHANNELS: u64 = 40
const RXS_COUNT: u64 = 16
const RXS_MPDU: u64 = 0
const RXS_DATA: u64 = 1
const RXS_PROT: u64 = 2
const RXS_DEC_OK: u64 = 3
const RXS_DROP_MIC: u64 = 4
const RXS_DROP_RAW: u64 = 5
const RXS_GROUP: u64 = 6
const RXS_DELIVERED: u64 = 7
const RXS_DROP_SHORT: u64 = 8
const RXS_BAD_CRC: u64 = 9
const RXS_LAST_STATUS: u64 = 10
const RXS_LAST_LEN: u64 = 11
const RXS_LAST_FC: u64 = 12
const RXS_MGMT: u64 = 13
const MAC_FILTER_ACCEPT_GRP: u64 = 4

const CMD_REMOVE_STA: u64 = 0x19
const CMD_PHY_CTX: u64 = 0x08
const CMD_BUF: usize = 2600
const RX_BUF: usize = 2600
const RATE_6M_OFDM: u64 = 0x400D
const PHY_TX_CHAINS: u64 = 3
const PHY_RX_VALID: u64 = 3
const FRAME_PAD: u64 = 2

struct Transport {
    submit: fn(u64, u64, usize) -> i64,
    poll: fn(u64, u64, usize) -> i64
}

struct Mvm {
    tr: Transport,
    tctx: u64,
    mac: [u8; 6],
    bssid: [u8; 6],
    channel: u64,
    cmd_queue: u64,
    tx_queue: u64,
    slot: u64,
    hw_crypto: bool,
    ptk: [u8; 16],
    tx_pn: u64,
    ctx_ready: bool,
    peer_added: bool,
    lq_sent: bool,
    ptk_set: bool,
    queue_msk: u64,
    scan_state: u64,
    scan_uid: u64,
    scan_status: u64,
    rssi: i64,
    rx_channel: u64,
    cmds: u64,
    keys_sent: u64,
    fail_step: u64,
    fail_rc: i64,
    fail_cmd: u64,
    ok_steps: u64,
    caps: [u64; 16],
    rxs: [u64; 16],
    aid: u64,
    grp_pass: bool,
    cmd: [u8; 2600],
    rx: [u8; 2600]
}

fn dead_submit(ctx: u64, buf: u64, len: usize) -> i64 { return -1 }
fn dead_poll(ctx: u64, buf: u64, room: usize) -> i64 { return -1 }

fn mvm_new() -> Mvm {
    var o: Mvm = Mvm {
        tr: Transport { submit: dead_submit, poll: dead_poll },
        tctx: 0, mac: [0; 6], bssid: [0; 6], channel: 1,
        cmd_queue: 0, tx_queue: 2, slot: 0, hw_crypto: false, ptk: [0; 16], tx_pn: 0,
        ctx_ready: false, peer_added: false, lq_sent: false, ptk_set: false, queue_msk: iwl_mvm_txq.QUEUE_MSK_LEGACY,
        scan_state: 0, scan_uid: 0, scan_status: 0,
        rssi: 0, rx_channel: 0, cmds: 0, keys_sent: 0,
        fail_step: 0, fail_rc: 0, fail_cmd: 0, ok_steps: 0,
        caps: [0; 16], rxs: [0; 16], aid: 0, grp_pass: false, cmd: [0; 2600], rx: [0; 2600]
    }
    iwl_fwcaps.caps_default((&o.caps[0]) as *mut u64)
    return o
}

fn ops_set_caps(o: *mut Mvm, w: *mut u64) {
    var i: u64 = 0
    while i < iwl_fwcaps.CAPS_WORDS {
        (*o).caps[i as usize] = iwl_fwcaps.caps_get(w, i)
        i = i + 1
    }
}
fn ops_caps(o: *mut Mvm) -> *mut u64 { return (&(*o).caps[0]) as *mut u64 }

fn ops_rx_stat(o: *mut Mvm, i: u64) -> u64 {
    if i >= RXS_COUNT { return 0 }
    return (*o).rxs[i as usize]
}
fn rxs_add(o: *mut Mvm, i: u64) { (*o).rxs[i as usize] = (*o).rxs[i as usize] + 1 }

fn ops_set_hw_crypto(o: *mut Mvm, on: bool) { (*o).hw_crypto = on }
fn quirk_on(o: *mut Mvm, q: u64) -> bool { return iwl_fwcaps.caps_quirk(ops_caps(o), q) }
fn hwc_on(o: *mut Mvm) -> bool { return (*o).hw_crypto || quirk_on(o, iwl_fwcaps.Q_HWC) }
fn clear_path(o: *mut Mvm) -> bool { return hwc_on(o) || quirk_on(o, iwl_fwcaps.Q_PLAIN) }
fn ops_sync_board(g: *mut device.Device, o: *mut Mvm) { device.ccmp_capable_set(g, clear_path(o)) }
fn ops_set_queues(o: *mut Mvm, cmd_queue: u64, tx_queue: u64) {
    (*o).cmd_queue = cmd_queue
    (*o).tx_queue = tx_queue
}
fn ops_scan_state(o: *mut Mvm) -> u64 { return (*o).scan_state }
fn ops_rssi(o: *mut Mvm) -> i64 { return (*o).rssi }
fn ops_rx_channel(o: *mut Mvm) -> u64 { return (*o).rx_channel }
fn ops_keys_sent(o: *mut Mvm) -> u64 { return (*o).keys_sent }
fn ops_cmd_count(o: *mut Mvm) -> u64 { return (*o).cmds }
fn ops_fail_step(o: *mut Mvm) -> u64 { return (*o).fail_step }
fn ops_fail_rc(o: *mut Mvm) -> i64 { return (*o).fail_rc }
fn ops_fail_cmd(o: *mut Mvm) -> u64 { return (*o).fail_cmd }
fn ops_ok_steps(o: *mut Mvm) -> u64 { return (*o).ok_steps }

fn step_result(o: *mut Mvm, step: u64, r: i64) -> i64 {
    if r < 0 {
        (*o).fail_step = step
        (*o).fail_rc = r
        (*o).fail_cmd = iwl_le.ld8(cmd_addr(o), 0)
        return r
    }
    (*o).ok_steps = (*o).ok_steps | (1 << step)
    if (*o).fail_step == step {
        (*o).fail_step = 0
        (*o).fail_rc = 0
    }
    return r
}

fn ops_set_address(o: *mut Mvm, mac: u64) {
    var i: usize = 0
    while i < 6 {
        (*o).mac[i] = *((mac + i as u64) as *mut u8)
        i = i + 1
    }
}

fn cmd_addr(o: *mut Mvm) -> u64 { return (&(*o).cmd[0]) as u64 }
fn rx_addr(o: *mut Mvm) -> u64 { return (&(*o).rx[0]) as u64 }
fn mac_addr(o: *mut Mvm) -> u64 { return (&(*o).mac[0]) as u64 }
fn bssid_addr(o: *mut Mvm) -> u64 { return (&(*o).bssid[0]) as u64 }

fn next_slot(o: *mut Mvm) -> u64 {
    (*o).slot = ((*o).slot + 1) & 0xFF
    return (*o).slot
}

fn submit(o: *mut Mvm, len: u64) -> i64 {
    (*o).cmds = (*o).cmds + 1
    let t: Transport = (*o).tr
    let r: i64 = t.submit((*o).tctx, cmd_addr(o), len as usize)
    if r < 0 { return r }
    if r > 0 { return E_OPS_FW }
    return 0
}

fn ops_attach(g: *mut device.Device, o: *mut Mvm, tctx: u64,
    submit_fn: fn(u64, u64, usize) -> i64,
    poll_fn: fn(u64, u64, usize) -> i64) -> bool {
    (*o).tr = Transport { submit: submit_fn, poll: poll_fn }
    (*o).tctx = tctx
    let ok: bool = device.board_set(g, o as u64, o_send, o_receive,
        o_channel, o_key, clear_path(o))
    if ok { device.addr_set(g, mac_addr(o)) }
    return ok
}

fn band_of(channel: u64) -> u64 {
    if channel <= 14 { return 1 }
    return 0
}

fn phy_cmd(o: *mut Mvm, action: u64, channel: u64) -> i64 {
    let rx: u64 = iwl_mvm.mvm_rx_chain(PHY_RX_VALID, 1, 1)
    var n: u64 = 0
    if iwl_fwcaps.caps_quirk(ops_caps(o), iwl_fwcaps.Q_OLD_PHY) {
        n = iwl_mvm.mvm_phy_ctx_wide(cmd_addr(o), (*o).cmd_queue, next_slot(o),
            PHY_ID, 0, action, band_of(channel), channel, 0, 0, PHY_TX_CHAINS, rx)
    } else {
        n = iwl_mvm.mvm_phy_ctx(cmd_addr(o), (*o).cmd_queue, next_slot(o),
            PHY_ID, 0, action, band_of(channel), channel, 0, 0, PHY_TX_CHAINS, rx)
    }
    return submit(o, n)
}

fn submit_long(o: *mut Mvm, len: u64) -> i64 {
    if iwl_fwcaps.caps_quirk(ops_caps(o), iwl_fwcaps.Q_OLD_HDR) { return submit(o, len) }
    return submit(o, iwl_buf.widen(cmd_addr(o), len, iwl_buf.GROUP_LONG))
}

fn scan_cfg_pad(o: *mut Mvm, len: u64, nchan: u64) -> u64 {
    let slots: u64 = iwl_fwcaps.caps_get(ops_caps(o), iwl_fwcaps.W_SCAN_SLOTS)
    if slots <= nchan { return len }
    iwl_le.zero(cmd_addr(o) + len, slots - nchan)
    return len + (slots - nchan)
}

fn mac_filter(o: *mut Mvm) -> u64 {
    if (*o).grp_pass { return MAC_FILTER_ACCEPT_GRP }
    return 0
}

fn mac_cmd(o: *mut Mvm, action: u64, assoc: bool, aid: u64) -> i64 {
    let a: u64 = cmd_addr(o)
    let n: u64 = iwl_mvm_ctx.mvm_mac_ctx(a, (*o).cmd_queue, next_slot(o),
        iwl_mvm_ctx.mvm_id_color(MAC_ID, 0), action, iwl_mvm_ctx.MAC_TYPE_BSS_STA, 0,
        mac_addr(o), bssid_addr(o), 0xF, 0xFF, 0, 0, 0, mac_filter(o), 1)
    iwl_mvm_ctx.mvm_mac_ac(a, 0, 15, 1023, 3, 2, 0)
    iwl_mvm_ctx.mvm_mac_ac(a, 1, 15, 1023, 7, 3, 0)
    iwl_mvm_ctx.mvm_mac_ac(a, 2, 7, 15, 2, 1, 3008)
    iwl_mvm_ctx.mvm_mac_ac(a, 3, 3, 7, 2, 0, 1504)
    var is_assoc: u64 = 0
    if assoc { is_assoc = 1 }
    iwl_mvm_ctx.mvm_mac_sta(a, is_assoc, 0, 0, 100, 1, 0, 0, aid, 0)
    return submit(o, n)
}

fn bind_cmd(o: *mut Mvm) -> i64 {
    let n: u64 = iwl_mvm_ctx.mvm_binding(cmd_addr(o), (*o).cmd_queue, next_slot(o),
        iwl_mvm_ctx.mvm_id_color(BIND_ID, 0), iwl_mvm_ctx.CTXT_ADD,
        iwl_mvm_ctx.mvm_id_color(MAC_ID, 0), iwl_mvm_ctx.CTXT_INVALID,
        iwl_mvm_ctx.CTXT_INVALID, iwl_mvm_ctx.mvm_id_color(PHY_ID, 0))
    return submit(o, n)
}

fn scan_cfg_cmd(o: *mut Mvm) -> i64 {
    var chans: [u8; 40] = [0; 40]
    let n: u64 = ops_default_channels((&chans[0]) as u64)
    let flags: u64 = iwl_mvm_scan.SCAN_CFG_ACTIVATE | iwl_mvm_scan.SCAN_CFG_ALLOW_CHUB_REQS
        | iwl_mvm_scan.SCAN_CFG_SET_AUX_STA_ID | iwl_mvm_scan.SCAN_CFG_CLEAR_FRAGMENTED | iwl_mvm_scan.SCAN_CFG_SET_TX_CHAINS
        | iwl_mvm_scan.SCAN_CFG_SET_RX_CHAINS | iwl_mvm_scan.SCAN_CFG_SET_ALL_TIMES
        | iwl_mvm_scan.SCAN_CFG_SET_CHANNEL_FLAGS | iwl_mvm_scan.SCAN_CFG_SET_LEGACY_RATES
        | iwl_mvm_scan.SCAN_CFG_SET_MAC_ADDR
    let len: u64 = iwl_mvm_scan.mvm_scan_cfg(cmd_addr(o), (*o).cmd_queue, next_slot(o),
        flags, 3, 3, SCAN_CFG_RATES, 0, 0, 10, 110, 44, 90, mac_addr(o), STA_AUX, SCAN_CFG_CHAN_FLAGS,
        (&chans[0]) as u64, n)
    return submit_long(o, scan_cfg_pad(o, len, n))
}

const STA_TID_DISABLE_ALL: u64 = 0xFFFF
const STA_FLAGS_MSK_LINUX: u64 = 0x3C020000

fn sta_tune(o: *mut Mvm) {
    if !quirk_on(o, iwl_fwcaps.Q_STA) { return }
    iwl_le.st16(cmd_addr(o), iwl_buf.HDR + 2, STA_TID_DISABLE_ALL)
    iwl_le.st32(cmd_addr(o), iwl_buf.HDR + 24, STA_FLAGS_MSK_LINUX)
}

fn sta_len(o: *mut Mvm, n: u64) -> u64 {
    if iwl_fwcaps.caps_sta_v8(ops_caps(o)) { return iwl_mvm_sta.sta_v8(cmd_addr(o), n, iwl_mvm_sta.STA_TYPE_LINK) }
    return n
}

fn aux_cmd(o: *mut Mvm) -> i64 {
    if dqa_on(o) {
        let rd: i64 = submit(o, iwl_mvm_txq.mvm_dqa_enable(cmd_addr(o), (*o).cmd_queue, next_slot(o), (*o).cmd_queue))
        if rd < 0 { return rd }
        let q: u64 = iwl_mvm_txq.mvm_scd_cfg_fifo(cmd_addr(o), (*o).cmd_queue, next_slot(o), STA_AUX, iwl_mvm_txq.TID_ALL,
            iwl_mvm_txq.AUX_QUEUE, iwl_mvm_txq.SCD_ACTION_ENABLE, 0, iwl_mvm_txq.TX_FIFO_MCAST)
        let rq: i64 = submit(o, q)
        if rq < 0 { return rq }
    }
    let n: u64 = iwl_mvm_sta.mvm_aux_sta(cmd_addr(o), (*o).cmd_queue, next_slot(o), STA_AUX,
        iwl_mvm_txq.queue_msk_of(iwl_mvm_txq.AUX_QUEUE), iwl_fwcaps.caps_sta_v8(ops_caps(o)))
    return submit(o, n)
}

fn step_done(o: *mut Mvm, step: u64) -> bool { return ((*o).ok_steps & (1 << step)) != 0 }

fn ops_setup(o: *mut Mvm) -> i64 {
    if (*o).ctx_ready { return 0 }
    var r: i64 = 0
    if !step_done(o, STEP_AUX_STA) {
        r = step_result(o, STEP_AUX_STA, aux_cmd(o))
        if r < 0 { return r }
    }
    if !step_done(o, STEP_PHY_CTX) {
        r = step_result(o, STEP_PHY_CTX, phy_cmd(o, 1, (*o).channel))
        if r < 0 { return r }
    }
    if !step_done(o, STEP_MAC_CTX) {
        r = step_result(o, STEP_MAC_CTX, mac_cmd(o, iwl_mvm_ctx.CTXT_ADD, false, 0))
        if r < 0 { return r }
    }
    if !step_done(o, STEP_BINDING) {
        r = step_result(o, STEP_BINDING, bind_cmd(o))
        if r < 0 { return r }
    }
    if !step_done(o, STEP_SCAN_CFG) {
        r = step_result(o, STEP_SCAN_CFG, scan_cfg_cmd(o))
        if r < 0 { return r }
    }
    (*o).ctx_ready = true
    return 0
}

fn ops_default_channels(out: u64) -> u64 {
    var n: u64 = 0
    var c: u64 = 1
    while c <= 11 {
        iwl_le.st8(out, n, c)
        n = n + 1
        c = c + 1
    }
    c = 36
    while c <= 64 {
        iwl_le.st8(out, n, c)
        n = n + 1
        c = c + 4
    }
    c = 100
    while c <= 140 {
        iwl_le.st8(out, n, c)
        n = n + 1
        c = c + 4
    }
    c = 149
    while c <= 165 {
        iwl_le.st8(out, n, c)
        n = n + 1
        c = c + 4
    }
    return n
}

fn ops_scan_start(o: *mut Mvm, ssid: u64, ssid_len: u64) -> i64 {
    if !(*o).ctx_ready { return E_OPS_STATE }
    if ssid_len > 32 { return E_OPS_ARGS }
    var chans: [u8; 40] = [0; 40]
    let nchan: u64 = ops_default_channels((&chans[0]) as u64)
    var preq: [u8; 48] = [0; 48]
    var i: u64 = 0
    iwl_le.st8((&preq[0]) as u64, 0, 0x40)
    while i < 6 {
        iwl_le.st8((&preq[0]) as u64, 4 + i, 0xFF)
        iwl_le.st8((&preq[0]) as u64, 10 + i, (*o).mac[i as usize] as u64)
        iwl_le.st8((&preq[0]) as u64, 16 + i, 0xFF)
        i = i + 1
    }
    i = 0
    while i < 2 {
        let at: u64 = 24 + (i * 10)
        iwl_le.st8((&preq[0]) as u64, at, 1)
        iwl_le.st8((&preq[0]) as u64, at + 1, 8)
        iwl_le.st8((&preq[0]) as u64, at + 2, 0x8C)
        iwl_le.st8((&preq[0]) as u64, at + 3, 0x12)
        iwl_le.st8((&preq[0]) as u64, at + 4, 0x98)
        iwl_le.st8((&preq[0]) as u64, at + 5, 0x24)
        iwl_le.st8((&preq[0]) as u64, at + 6, 0xB0)
        iwl_le.st8((&preq[0]) as u64, at + 7, 0x48)
        iwl_le.st8((&preq[0]) as u64, at + 8, 0x60)
        iwl_le.st8((&preq[0]) as u64, at + 9, 0x6C)
        i = i + 1
    }
    (*o).scan_uid = (*o).scan_uid + 1
    let a: u64 = cmd_addr(o)
    var gen: u64 = iwl_mvm_scan.SCAN_GEN_PASS_ALL | iwl_mvm_scan.SCAN_GEN_ITER_COMPLETE
    if ssid_len != 0 { gen = gen | iwl_mvm_scan.SCAN_GEN_MULTIPLE_SSID }
    var ch_flags: u64 = 0
    if ssid_len != 0 && !iwl_fwcaps.caps_quirk(ops_caps(o), iwl_fwcaps.Q_OLD_SSID) { ch_flags = 1 }
    let ver: u64 = iwl_fwcaps.caps_get(ops_caps(o), iwl_fwcaps.W_SCAN_VER)
    var slots: u64 = iwl_fwcaps.caps_get(ops_caps(o), iwl_fwcaps.W_SCAN_SLOTS)
    if slots < nchan { slots = nchan }
    var len: u64 = 0
    if ver >= 7 {
        var budget: u64 = iwl_mvm_scan.SCAN_BUDGET_FULL
        if ssid_len != 0 { budget = iwl_mvm_scan.SCAN_BUDGET_DIRECTED }
        len = iwl_mvm_scan.mvm_scan_req7(a, (*o).cmd_queue, next_slot(o), 0, (*o).scan_uid, gen, MAC_ID,
            10, 110, 44, 2, 10, budget, 0, 0, 6, 0, nchan, slots)
    } else {
        len = iwl_mvm_scan.mvm_scan_req(a, (*o).cmd_queue, next_slot(o), 0, (*o).scan_uid,
            0, gen, MAC_ID, 0, 30, 110, 44, 0, 0, 2, 1, nchan)
        slots = nchan
    }
    let head: u64 = iwl_mvm_scan.scan_head_len(ver)
    i = 0
    while i < nchan {
        iwl_mvm_scan.mvm_scan_chan_at(a, head, i, ch_flags, iwl_le.ld8((&chans[0]) as u64, i), 1, 0)
        i = i + 1
    }
    iwl_mvm_scan.mvm_scan_tail_at(a, head + (slots * iwl_mvm_scan.SCAN_CHAN_LEN), 0, 0, 1, (&preq[0]) as u64, 24, 10, 10, 0, ssid, ssid_len)
    (*o).scan_state = SCAN_RUNNING
    (*o).scan_status = 0
    let r: i64 = step_result(o, STEP_SCAN_REQ, submit_long(o, len))
    if r < 0 { (*o).scan_state = SCAN_IDLE }
    return r
}

fn dqa_on(o: *mut Mvm) -> bool {
    let w: *mut u64 = ops_caps(o)
    return iwl_fwcaps.caps_known(w) && iwl_fwcaps.caps_dqa(w) && !iwl_fwcaps.caps_quirk(w, iwl_fwcaps.Q_OLD_TXQ)
}

fn scd_cmd(o: *mut Mvm, action: u64) -> i64 {
    let n: u64 = iwl_mvm_txq.mvm_scd_cfg(cmd_addr(o), (*o).cmd_queue, next_slot(o), STA_AP, iwl_mvm_txq.TID_ALL,
        iwl_mvm_txq.DATA_QUEUE, action, 0)
    return submit(o, n)
}

fn session_cmd(o: *mut Mvm) -> i64 {
    let n: u64 = iwl_mvm_te.mvm_time_event(cmd_addr(o), (*o).cmd_queue, next_slot(o),
        iwl_mvm_ctx.mvm_id_color(MAC_ID, 0), iwl_mvm_te.TE_ACTION_ADD, iwl_mvm_te.TE_BSS_STA_AGGRESSIVE_ASSOC,
        SESSION_TU, SESSION_MAX_DELAY, iwl_mvm_te.TE_POLICY_SESSION)
    return submit(o, n)
}

fn ops_peer_add(o: *mut Mvm, bssid: u64) -> i64 {
    if !(*o).ctx_ready { return E_OPS_STATE }
    if (*o).peer_added {
        let rr: i64 = ops_peer_remove(o)
        if rr < 0 { return rr }
    }
    var i: usize = 0
    while i < 6 {
        (*o).bssid[i] = *((bssid + i as u64) as *mut u8)
        i = i + 1
    }
    var msk: u64 = iwl_mvm_txq.QUEUE_MSK_LEGACY
    if dqa_on(o) {
        let q: i64 = scd_cmd(o, iwl_mvm_txq.SCD_ACTION_ENABLE)
        if q < 0 { return q }
        msk = iwl_mvm_txq.queue_msk_of(iwl_mvm_txq.DATA_QUEUE)
    }
    (*o).queue_msk = msk
    let n: u64 = iwl_mvm.mvm_add_sta(cmd_addr(o), (*o).cmd_queue, next_slot(o), 0,
        iwl_mvm_ctx.mvm_id_color(MAC_ID, 0), bssid_addr(o), STA_AP, 0, 0, 0, msk)
    sta_tune(o)
    let r: i64 = submit(o, sta_len(o, n))
    if r < 0 { return r }
    (*o).peer_added = true
    let m: i64 = mac_cmd(o, iwl_mvm_ctx.CTXT_MODIFY, false, 0)
    if m < 0 { return m }
    return session_cmd(o)
}

fn ops_associated(o: *mut Mvm, aid: u64) -> i64 {
    if !(*o).peer_added { return E_OPS_STATE }
    (*o).aid = aid
    let n: u64 = iwl_mvm.mvm_add_sta(cmd_addr(o), (*o).cmd_queue, next_slot(o), 1,
        iwl_mvm_ctx.mvm_id_color(MAC_ID, 0), bssid_addr(o), STA_AP, 0, 0, aid, (*o).queue_msk)
    sta_tune(o)
    let r: i64 = submit(o, sta_len(o, n))
    if r < 0 { return r }
    let m: i64 = mac_cmd(o, iwl_mvm_ctx.CTXT_MODIFY, true, aid)
    if m < 0 { return m }
    return lq_send(o)
}

fn lq_send(o: *mut Mvm) -> i64 {
    if !iwl_fwcaps.caps_quirk(ops_caps(o), iwl_fwcaps.Q_LQ) { return 0 }
    let n: u64 = iwl_mvm_rs.mvm_lq_cmd(cmd_addr(o), (*o).cmd_queue, next_slot(o), STA_AP, iwl_mvm_rs.RATE_LEGACY_6M_ANT_A)
    let r: i64 = submit(o, n)
    if r < 0 { return r }
    (*o).lq_sent = true
    return 0
}

fn sta_rate_ok(o: *mut Mvm, fcv: u64) -> bool {
    if !(*o).lq_sent || !(*o).ptk_set { return false }
    if !iwl_fwcaps.caps_quirk(ops_caps(o), iwl_fwcaps.Q_LQ) { return false }
    return frame.art(fcv) == frame.KIND_DATA && frame.geschuetzt(fcv)
}

fn ops_peer_remove(o: *mut Mvm) -> i64 {
    if !(*o).peer_added { return 0 }
    let a: u64 = cmd_addr(o)
    iwl_le.zero(a, iwl_buf.HDR + 4)
    iwl_buf.hdr(a, CMD_REMOVE_STA, (*o).cmd_queue, next_slot(o))
    iwl_le.st8(a, iwl_buf.HDR, STA_AP)
    let r: i64 = submit(o, iwl_buf.HDR + 4)
    (*o).peer_added = false
    (*o).lq_sent = false
    (*o).ptk_set = false
    if (*o).queue_msk != iwl_mvm_txq.QUEUE_MSK_LEGACY {
        let _q: i64 = scd_cmd(o, iwl_mvm_txq.SCD_ACTION_DISABLE)
        (*o).queue_msk = iwl_mvm_txq.QUEUE_MSK_LEGACY
    }
    return r
}

fn o_channel(ctx: u64, channel: u64, band: u64) -> i64 {
    let o: *mut Mvm = ctx as *mut Mvm
    if !(*o).ctx_ready { return E_OPS_STATE }
    if channel == 0 || channel > 196 { return E_OPS_ARGS }
    let r: i64 = phy_cmd(o, 2, channel)
    if r < 0 { return r }
    (*o).channel = channel
    return 0
}

fn o_key(ctx: u64, art: u64, id: u64, key: u64, len: usize) -> i64 {
    let o: *mut Mvm = ctx as *mut Mvm
    if art == device.KEY_OFF {
        (*o).ptk_set = false
        (*o).tx_pn = 0
        (*o).grp_pass = false
        if hwc_on(o) { return ops_peer_remove(o) }
        return 0
    }
    if art == device.KEY_PTK {
        (*o).ptk_set = true
        (*o).tx_pn = 0
        var k: usize = 0
        while k < 16 && len >= 16 {
            (*o).ptk[k] = *((key + k as u64) as *mut u8)
            k = k + 1
        }
    }
    if !hwc_on(o) { return 0 }
    if !(*o).peer_added { return E_OPS_STATE }
    var pn: [u8; 6] = [0; 6]
    var offset: u64 = 0
    var multicast: bool = false
    if art == device.KEY_GTK {
        offset = 1 + (id & 3)
        multicast = true
    }
    let n: u64 = iwl_mvm.mvm_sta_key_ccmp(cmd_addr(o), (*o).cmd_queue, next_slot(o), STA_AP,
        offset, id, multicast, key, (&pn[0]) as u64)
    (*o).keys_sent = (*o).keys_sent + 1
    var kr: i64 = 0
    if !iwl_fwcaps.caps_tkip_mic(ops_caps(o)) { kr = submit(o, iwl_buf.HDR + 64) } else { kr = submit(o, n) }
    if kr < 0 || art != device.KEY_GTK { return kr }
    (*o).grp_pass = true
    return mac_cmd(o, iwl_mvm_ctx.CTXT_MODIFY, true, (*o).aid)
}

fn o_send(ctx: u64, frame_ptr: u64, len: usize) -> i64 {
    let o: *mut Mvm = ctx as *mut Mvm
    if !(*o).ctx_ready { return E_OPS_STATE }
    if len < 10 || len > 2400 { return E_OPS_ARGS }
    let fcv: u64 = frame.fc(frame_ptr, len)
    var flags: u64 = iwl_mvm_tx.TX_FLG_ACK
    if frame.art(fcv) == frame.KIND_MGMT { flags = flags | iwl_mvm_tx.TX_FLG_SEQ_CTL }
    var pad: u64 = 0
    var hl: u64 = 0
    let hli: i64 = frame.header_len(frame_ptr, len)
    if hli > 0 { hl = hli as u64 }
    if hl != 0 && (hl & 3) != 0 && (len as u64) > hl {
        pad = FRAME_PAD
        flags = flags | iwl_mvm_tx.TX_FLG_MH_PAD
    }
    var sec: u64 = 0
    var keyp: u64 = 0
    if (*o).hw_crypto && frame.geschuetzt(fcv) { sec = 1 }
    var protect: bool = false
    if quirk_on(o, iwl_fwcaps.Q_HWC) && (*o).ptk_set && frame.art(fcv) == frame.KIND_DATA && !frame.geschuetzt(fcv) && hl != 0 && !iwl_mvm_crypt.tx_is_eapol(frame_ptr, len as u64, hl) {
        protect = true
        sec = iwl_mvm_crypt.SEC_CCM
        keyp = (&(*o).ptk[0]) as u64
    }
    var flen: u64 = len as u64
    if protect { flen = flen + iwl_mvm_crypt.CCMP_HDR }
    var offload: u64 = 0
    var tid: u64 = 0
    var pm_timeout: u64 = 0
    if iwl_fwcaps.caps_quirk(ops_caps(o), iwl_fwcaps.Q_TX_OFF) {
        if pad != 0 { offload = iwl_mvm_tx.OFFLOAD_PAD }
        tid = iwl_mvm_tx.tx_tid_of(frame_ptr, len)
        pm_timeout = iwl_mvm_tx.tx_pm_timeout_of(frame_ptr, len, hl)
    }
    if quirk_on(o, iwl_fwcaps.Q_DQ) && frame.art(fcv) == frame.KIND_DATA { tid = 0 }
    var rate: u64 = RATE_6M_OFDM
    if sta_rate_ok(o, fcv) {
        flags = flags | iwl_mvm_tx.TX_FLG_STA_RATE
        rate = 0
    }
    var total: u64 = iwl_mvm_tx.mvm_tx_cmd(cmd_addr(o), (*o).tx_queue, next_slot(o), offload, flags,
        rate, STA_AP, sec, 0, keyp, 0xFFFFFFFF, 0, 60, 15, tid, pm_timeout, frame_ptr, len as u64)
    if protect {
        (*o).tx_pn = (*o).tx_pn + 1
        iwl_mvm_crypt.tx_protect(cmd_addr(o) + iwl_mvm_tx.TX_CMD_LEN, hl, len as u64, (*o).tx_pn)
        iwl_le.st16(cmd_addr(o), iwl_buf.HDR, flen)
        total = total + iwl_mvm_crypt.CCMP_HDR
    }
    if pad != 0 {
        let base: u64 = iwl_mvm_tx.TX_CMD_LEN
        var i: u64 = flen
        while i > hl {
            iwl_le.st8(cmd_addr(o), base + i + pad - 1, iwl_le.ld8(cmd_addr(o), base + i - 1))
            i = i - 1
        }
        iwl_le.st8(cmd_addr(o), base + hl, 0)
        iwl_le.st8(cmd_addr(o), base + hl + 1, 0)
    }
    (*o).cmds = (*o).cmds + 1
    let t: Transport = (*o).tr
    let r: i64 = t.submit((*o).tctx, cmd_addr(o), (total + pad) as usize)
    if r < 0 { return r }
    return len as i64
}

fn parse_phy(o: *mut Mvm, n: usize) {
    let a: u64 = rx_addr(o)
    let h: u64 = iwl_buf.HDR
    if (n as u64) < h + 60 { return }
    (*o).rx_channel = iwl_le.ld16(a, h + 22)
    let e: u64 = iwl_le.ld32(a, h + 24 + 4)
    var best: u64 = 0
    var k: u64 = 0
    while k < 3 {
        let v: u64 = (e >> (k * 8)) & 0xFF
        if v != 0 && (best == 0 || v < best) { best = v }
        k = k + 1
    }
    if best == 0 {
        (*o).rssi = -127
    } else {
        (*o).rssi = 0 - (best as i64)
    }
}

fn parse_scan_done(o: *mut Mvm, n: usize) {
    if (n as u64) < iwl_buf.HDR + 8 { return }
    let a: u64 = rx_addr(o)
    let fw_uid: u64 = iwl_mvm_scan.mvm_scan_complete_uid(a)
    if fw_uid != (*o).scan_uid && fw_uid + 1 != (*o).scan_uid { return }
    if iwl_mvm_scan.mvm_scan_complete_status(a) == iwl_mvm_scan.SCAN_COMPLETED {
        (*o).scan_state = SCAN_DONE
    } else {
        (*o).scan_state = SCAN_ABORTED
    }
}

fn rx_mpdu(o: *mut Mvm, out: u64, bytes: u64, a: u64, h: u64, n: u64) -> i64 {
    rxs_add(o, RXS_MPDU)
    var status: u64 = 0
    if h + 4 + bytes + 4 <= n { status = iwl_le.ld32(a, h + 4 + bytes) }
    (*o).rxs[RXS_LAST_STATUS as usize] = status
    (*o).rxs[RXS_LAST_LEN as usize] = bytes
    if bytes < 10 {
        rxs_add(o, RXS_DROP_SHORT)
        return bytes as i64
    }
    let fcv: u64 = frame.fc(out, bytes as usize)
    (*o).rxs[RXS_LAST_FC as usize] = fcv
    if (status & 1) == 0 { rxs_add(o, RXS_BAD_CRC) }
    if frame.art(fcv) != frame.KIND_DATA {
        rxs_add(o, RXS_MGMT)
        return bytes as i64
    }
    rxs_add(o, RXS_DATA)
    if (iwl_le.ld8(out, 4) & 1) != 0 { rxs_add(o, RXS_GROUP) }
    if !frame.geschuetzt(fcv) {
        rxs_add(o, RXS_DELIVERED)
        return bytes as i64
    }
    rxs_add(o, RXS_PROT)
    if !(quirk_on(o, iwl_fwcaps.Q_HWC) && (*o).ptk_set) {
        rxs_add(o, RXS_DELIVERED)
        return bytes as i64
    }
    let v: u64 = iwl_mvm_crypt.rx_verdict(out, bytes, status)
    if v == iwl_mvm_crypt.RX_DROP_MIC {
        rxs_add(o, RXS_DROP_MIC)
        return -2
    }
    if v == iwl_mvm_crypt.RX_DROP_RAW {
        rxs_add(o, RXS_DROP_RAW)
        return -2
    }
    rxs_add(o, RXS_DEC_OK)
    rxs_add(o, RXS_DELIVERED)
    return iwl_mvm_crypt.rx_unprotect(out, bytes) as i64
}

fn ops_poll_one(o: *mut Mvm, out: u64, room: usize) -> i64 {
    let t: Transport = (*o).tr
    let n: i64 = t.poll((*o).tctx, rx_addr(o), RX_BUF)
    if n <= 0 { return n }
    let a: u64 = rx_addr(o)
    let cmd: u64 = iwl_le.ld8(a, 0)
    if cmd == 0xC0 {
        parse_phy(o, n as usize)
        return -2
    }
    if cmd == iwl_mvm_scan.CMD_SCAN_COMPLETE_UMAC {
        parse_scan_done(o, n as usize)
        return -2
    }
    if cmd == iwl_mvm.CMD_RX_MPDU {
        let h: u64 = iwl_buf.HDR
        if (n as u64) < h + 4 { return -2 }
        let bytes: u64 = iwl_le.ld16(a, h)
        if bytes == 0 || h + 4 + bytes > (n as u64) || (bytes as usize) > room { return -2 }
        iwl_le.copy(out, a + h + 4, bytes)
        return rx_mpdu(o, out, bytes, a, h, n as u64)
    }
    return -2
}

fn o_receive(ctx: u64, buf: u64, room: usize) -> i64 {
    let o: *mut Mvm = ctx as *mut Mvm
    var guard: u64 = 0
    while guard < 32 {
        let r: i64 = ops_poll_one(o, buf, room)
        if r != -2 { return r }
        guard = guard + 1
    }
    return 0
}
