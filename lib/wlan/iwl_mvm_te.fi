import wlan.iwl_buf
import wlan.iwl_le
import libc.octets

export {
    CMD_TIME_EVENT, TE_CMD_LEN, TE_ACTION_ADD, TE_BSS_STA_AGGRESSIVE_ASSOC, TE_POLICY_SESSION, mvm_time_event
}

const CMD_TIME_EVENT: u64 = 0x29
const TE_CMD_LEN: u64 = iwl_buf.HDR + 36
const TE_ACTION_ADD: u64 = 1
const TE_BSS_STA_AGGRESSIVE_ASSOC: u64 = 0
const TE_POLICY_SESSION: u64 = 0x803

fn mvm_time_event(a: u64, qid: u64, slot: u64, id_color: u64, action: u64, id: u64, duration: u64, max_delay: u64,
                  policy: u64) -> u64 {
    let h: u64 = iwl_buf.HDR
    octets.zero(a, TE_CMD_LEN)
    iwl_buf.hdr(a, CMD_TIME_EVENT, qid, slot)
    octets.st32(a, h, id_color)
    octets.st32(a, h + 4, action)
    octets.st32(a, h + 8, id)
    octets.st32(a, h + 12, 0)
    octets.st32(a, h + 16, max_delay)
    octets.st32(a, h + 20, 0)
    octets.st32(a, h + 24, 1)
    octets.st32(a, h + 28, duration)
    octets.st8(a, h + 32, 1)
    octets.st8(a, h + 33, 0)
    octets.st16(a, h + 34, policy)
    return TE_CMD_LEN
}
