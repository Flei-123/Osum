// ==================================================================
// KEIN ALLOKATOR
// ==================================================================
import libc.octets


export {
    // LLC/SNAP
    snap_build, snap_parse, SNAP_LEN,
    ET_IPV4, ET_IPV6, ET_ARP, ET_EAPOL,
    // Pruefsummen
    sum16, sum16_check,
    // IPv4
    ipv4_build, Ipv4, ipv4_new, ipv4_parse, IPV4_MIN,
    P_UDP, P_TCP, P_ICMP,
    // UDP
    udp_build, Udp, udp_new, udp_parse, UDP_LEN,
    // DHCP
    Dhcp, dhcp_new, dhcp_discover_build, dhcp_request_build,
    dhcp_parse, dhcp_option_find,
    D_DISCOVER, D_OFFER, D_REQUEST, D_ACK, D_NAK,
    O_MASKE, O_TOR, O_DNS, O_ART, O_SERVER, O_MIETE, O_ANGEFRAGT, O_ENDE,
    // TCP
    Tcp, tcp_new, tcp_build, tcp_parse,
    T_FIN, T_SYN, T_RST, T_PSH, T_ACK,
    http_get_build, http_status_of, http_body_offset
}

// ==================================================================
// KLEINE HELFER
// ==================================================================

fn be16(p: u64, i: usize) -> u64 {
    return ((octets.load_byte(p, i) as u64) << 8) | (octets.load_byte(p, i + 1) as u64)
}

fn be32(p: u64, i: usize) -> u64 {
    return ((octets.load_byte(p, i) as u64) << 24) | ((octets.load_byte(p, i + 1) as u64) << 16)
        | ((octets.load_byte(p, i + 2) as u64) << 8) | (octets.load_byte(p, i + 3) as u64)
}

fn put16(p: u64, i: usize, v: u64) {
    octets.store_byte(p, i, ((v >> 8) & 255) as u8)
    octets.store_byte(p, i + 1, (v & 255) as u8)
}

fn put32(p: u64, i: usize, v: u64) {
    octets.store_byte(p, i, ((v >> 24) & 255) as u8)
    octets.store_byte(p, i + 1, ((v >> 16) & 255) as u8)
    octets.store_byte(p, i + 2, ((v >> 8) & 255) as u8)
    octets.store_byte(p, i + 3, (v & 255) as u8)
}

fn copy(dst: u64, src: u64, n: usize) {
    var i: usize = 0
    while i < n {
        octets.store_byte(dst, i, octets.load_byte(src, i))
        i = i + 1
    }
}

// ==================================================================
// LLC/SNAP -- RFC 1042
// ==================================================================
//     aa aa 03 00 00 00 08 00    (IPv4)
//     aa aa 03 00 00 00 86 dd    (IPv6)
//     aa aa 03 00 00 00 80 f3    (AARP)

const SNAP_LEN: usize = 8

const ET_IPV4: u64 = 0x0800
const ET_IPV6: u64 = 0x86DD
const ET_ARP: u64 = 0x0806
const ET_EAPOL: u64 = 0x888E

fn snap_build(out: u64, ethertype: u64) -> usize {
    octets.store_byte(out, 0, 0xAA as u8)
    octets.store_byte(out, 1, 0xAA as u8)
    octets.store_byte(out, 2, 0x03 as u8)
    octets.store_byte(out, 3, 0 as u8)
    octets.store_byte(out, 4, 0 as u8)
    octets.store_byte(out, 5, 0 as u8)
    put16(out, 6, ethertype)
    return SNAP_LEN
}

fn snap_parse(p: u64, n: usize) -> u64 {
    if n < SNAP_LEN { return 0 }
    if octets.load_byte(p, 0) != 0xAA as u8 { return 0 }
    if octets.load_byte(p, 1) != 0xAA as u8 { return 0 }
    if octets.load_byte(p, 2) != 0x03 as u8 { return 0 }
    if octets.load_byte(p, 3) != 0 as u8 { return 0 }
    if octets.load_byte(p, 4) != 0 as u8 { return 0 }
    if octets.load_byte(p, 5) != 0 as u8 { return 0 }
    return be16(p, 6)
}

// ==================================================================
// DIE PRUEFSUMME, RFC 1071
// ==================================================================

fn sum16(p: u64, n: usize, start: u64) -> u64 {
    var s: u64 = start
    var i: usize = 0
    while i + 1 < n {
        s = s + be16(p, i)
        i = i + 2
    }
    if i < n {
        s = s + ((octets.load_byte(p, i) as u64) << 8)
    }
    while (s >> 16) != 0 {
        s = (s & 0xFFFF) + (s >> 16)
    }
    return (~s) & 0xFFFF
}

fn sum16_check(p: u64, n: usize, start: u64) -> bool {
    return sum16(p, n, start) == 0
}

// ==================================================================
// IPv4 -- RFC 791
// ==================================================================

const IPV4_MIN: usize = 20
const P_ICMP: u64 = 1
const P_TCP: u64 = 6
const P_UDP: u64 = 17

struct Ipv4 {
    ihl: usize,        // Kopflaenge in Oktetten
    gesamt: usize,     // Gesamtlaenge laut Kopf
    proto: u64,
    source: u64,
    dest: u64,
    payload: u64,
    payload_len: usize,
    sum_ok: bool
}

fn ipv4_new() -> Ipv4 {
    var i: Ipv4 = Ipv4 {
        ihl: 0, gesamt: 0, proto: 0, source: 0, dest: 0,
        payload: 0, payload_len: 0, sum_ok: false
    }
    return i
}

fn ipv4_build(out: u64, source: u64, dest: u64, proto: u64,
    payload_len: usize, kennung: u64) -> usize {
    octets.store_byte(out, 0, 0x45 as u8)          // Fassung 4, IHL 5
    octets.store_byte(out, 1, 0 as u8)             // kein Dienstgueteverkehr
    put16(out, 2, (IPV4_MIN + payload_len) as u64)
    put16(out, 4, kennung)
    put16(out, 6, 0x4000)
    octets.store_byte(out, 8, 64 as u8)            // Lebenszeit
    octets.store_byte(out, 9, (proto & 255) as u8)
    put16(out, 10, 0)                // Pruefsummenfeld erst null
    put32(out, 12, source)
    put32(out, 16, dest)
    put16(out, 10, sum16(out, IPV4_MIN, 0))
    return IPV4_MIN
}

fn ipv4_parse(v: *mut Ipv4, p: u64, n: usize) -> bool {
    if n < IPV4_MIN { return false }
    if (octets.load_byte(p, 0) >> 4) != 4 as u8 { return false }
    let ihl: usize = ((octets.load_byte(p, 0) & 15) as usize) * 4
    if ihl < IPV4_MIN { return false }
    if ihl > n { return false }
    let gesamt: usize = be16(p, 2) as usize
    if gesamt < ihl { return false }
    if gesamt > n { return false }
    (*v).ihl = ihl
    (*v).gesamt = gesamt
    (*v).proto = octets.load_byte(p, 9) as u64
    (*v).source = be32(p, 12)
    (*v).dest = be32(p, 16)
    (*v).payload = p + ihl as u64
    (*v).payload_len = gesamt - ihl
    (*v).sum_ok = sum16_check(p, ihl, 0)
    return true
}

fn pseudo_sum(source: u64, dest: u64, proto: u64,
    len: usize) -> u64 {
    var s: u64 = 0
    s = s + ((source >> 16) & 0xFFFF) + (source & 0xFFFF)
    s = s + ((dest >> 16) & 0xFFFF) + (dest & 0xFFFF)
    s = s + proto
    s = s + (len as u64)
    return s
}

// ==================================================================
// UDP -- RFC 768
// ==================================================================

const UDP_LEN: usize = 8

struct Udp {
    source: u64,
    dest: u64,
    len: usize,
    payload: u64,
    payload_len: usize,
    sum_ok: bool
}

fn udp_new() -> Udp {
    var u: Udp = Udp {
        source: 0, dest: 0, len: 0, payload: 0, payload_len: 0,
        sum_ok: false
    }
    return u
}

fn udp_build(out: u64, qip: u64, zip: u64, qport: u64, zport: u64,
    payload_len: usize) -> usize {
    put16(out, 0, qport)
    put16(out, 2, zport)
    put16(out, 4, (UDP_LEN + payload_len) as u64)
    put16(out, 6, 0)
    let ps: u64 = pseudo_sum(qip, zip, P_UDP, UDP_LEN + payload_len)
    var s: u64 = sum16(out, UDP_LEN + payload_len, ps)
    if s == 0 { s = 0xFFFF }
    put16(out, 6, s)
    return UDP_LEN
}

fn udp_parse(u: *mut Udp, p: u64, n: usize, qip: u64,
    zip: u64) -> bool {
    if n < UDP_LEN { return false }
    let len: usize = be16(p, 4) as usize
    if len < UDP_LEN { return false }
    if len > n { return false }
    (*u).source = be16(p, 0)
    (*u).dest = be16(p, 2)
    (*u).len = len
    (*u).payload = p + UDP_LEN as u64
    (*u).payload_len = len - UDP_LEN
    if be16(p, 6) == 0 {
        (*u).sum_ok = true
    } else {
        let ps: u64 = pseudo_sum(qip, zip, P_UDP, len)
        (*u).sum_ok = sum16_check(p, len, ps)
    }
    return true
}

// ==================================================================
// DHCP -- RFC 2131 und RFC 2132
// ==================================================================

const D_DISCOVER: u64 = 1
const D_OFFER: u64 = 2
const D_REQUEST: u64 = 3
const D_ACK: u64 = 5
const D_NAK: u64 = 6

const O_MASKE: u64 = 1
const O_TOR: u64 = 3
const O_DNS: u64 = 6
const O_ANGEFRAGT: u64 = 50
const O_MIETE: u64 = 51
const O_ART: u64 = 53
const O_SERVER: u64 = 54
const O_ENDE: u64 = 255

const DHCP_FEST: usize = 236   // bis einschliesslich sname/file
const DHCP_MIN: usize = 240

struct Dhcp {
    op: u64,
    xid: u64,
    yiaddr: u64,
    siaddr: u64,
    art: u64,          // Option 53
    maske: u64,        // Option 1
    tor: u64,          // Option 3
    dns: u64,
    server: u64,       // Option 54
    miete: u64,        // Option 51
    opt: u64,
    opt_len: usize
}

fn dhcp_new() -> Dhcp {
    var d: Dhcp = Dhcp {
        op: 0, xid: 0, yiaddr: 0, siaddr: 0, art: 0, maske: 0,
        tor: 0, dns: 0, server: 0, miete: 0, opt: 0, opt_len: 0
    }
    return d
}

fn dhcp_head(out: u64, xid: u64, mac: u64) {
    var i: usize = 0
    while i < DHCP_MIN {
        octets.store_byte(out, i, 0 as u8)
        i = i + 1
    }
    octets.store_byte(out, 0, 1 as u8)       // op: Anfrage
    octets.store_byte(out, 1, 1 as u8)       // htype: Ethernet
    octets.store_byte(out, 2, 6 as u8)       // hlen
    octets.store_byte(out, 3, 0 as u8)       // hops
    put32(out, 4, xid)
    put16(out, 8, 0)           // secs
    put16(out, 10, 0)
    copy(out + 28, mac, 6)     // chaddr
    octets.store_byte(out, 236, 99 as u8)
    octets.store_byte(out, 237, 130 as u8)
    octets.store_byte(out, 238, 83 as u8)
    octets.store_byte(out, 239, 99 as u8)
}

fn dhcp_discover_build(out: u64, xid: u64, mac: u64) -> usize {
    dhcp_head(out, xid, mac)
    var at: usize = DHCP_MIN
    octets.store_byte(out, at, O_ART as u8)
    octets.store_byte(out, at + 1, 1 as u8)
    octets.store_byte(out, at + 2, D_DISCOVER as u8)
    at = at + 3
    // Was wir wissen wollen: Maske, Tor, DNS.
    octets.store_byte(out, at, 55 as u8)
    octets.store_byte(out, at + 1, 3 as u8)
    octets.store_byte(out, at + 2, O_MASKE as u8)
    octets.store_byte(out, at + 3, O_TOR as u8)
    octets.store_byte(out, at + 4, O_DNS as u8)
    at = at + 5
    octets.store_byte(out, at, O_ENDE as u8)
    at = at + 1
    return at
}

fn dhcp_request_build(out: u64, xid: u64, mac: u64, angefragt: u64,
    server: u64) -> usize {
    dhcp_head(out, xid, mac)
    var at: usize = DHCP_MIN
    octets.store_byte(out, at, O_ART as u8)
    octets.store_byte(out, at + 1, 1 as u8)
    octets.store_byte(out, at + 2, D_REQUEST as u8)
    at = at + 3
    octets.store_byte(out, at, O_ANGEFRAGT as u8)
    octets.store_byte(out, at + 1, 4 as u8)
    put32(out, at + 2, angefragt)
    at = at + 6
    octets.store_byte(out, at, O_SERVER as u8)
    octets.store_byte(out, at + 1, 4 as u8)
    put32(out, at + 2, server)
    at = at + 6
    octets.store_byte(out, at, 55 as u8)
    octets.store_byte(out, at + 1, 3 as u8)
    octets.store_byte(out, at + 2, O_MASKE as u8)
    octets.store_byte(out, at + 3, O_TOR as u8)
    octets.store_byte(out, at + 4, O_DNS as u8)
    at = at + 5
    octets.store_byte(out, at, O_ENDE as u8)
    at = at + 1
    return at
}

fn dhcp_option_find(p: u64, n: usize, search: u64, out: u64,
    max: usize) -> i64 {
    var i: usize = 0
    while i < n {
        let t: u64 = octets.load_byte(p, i) as u64
        if t == O_ENDE { return -1 }
        if t == 0 {
            i = i + 1
        } else {
            if i + 1 >= n { return -1 }
            let l: usize = octets.load_byte(p, i + 1) as usize
            if i + 2 + l > n { return -1 }
            if t == search {
                var k: usize = 0
                while k < l && k < max {
                    octets.store_byte(out, k, octets.load_byte(p, i + 2 + k))
                    k = k + 1
                }
                return l as i64
            }
            i = i + 2 + l
        }
    }
    return -1
}

fn opt_u32(p: u64, n: usize, search: u64) -> u64 {
    var b: [u8; 8] = [0; 8]
    let l: i64 = dhcp_option_find(p, n, search, (&b[0]) as u64, 8)
    if l < 4 || (l % 4) != 0 { return 0 }
    return be32((&b[0]) as u64, 0)
}

fn dhcp_parse(d: *mut Dhcp, p: u64, n: usize) -> bool {
    if n < DHCP_MIN { return false }
    if octets.load_byte(p, 236) != 99 as u8 { return false }
    if octets.load_byte(p, 237) != 130 as u8 { return false }
    if octets.load_byte(p, 238) != 83 as u8 { return false }
    if octets.load_byte(p, 239) != 99 as u8 { return false }
    (*d).op = octets.load_byte(p, 0) as u64
    (*d).xid = be32(p, 4)
    (*d).yiaddr = be32(p, 16)
    (*d).siaddr = be32(p, 20)
    let op: u64 = p + DHCP_MIN as u64
    let on: usize = n - DHCP_MIN
    (*d).opt = op
    (*d).opt_len = on
    var b: [u8; 8] = [0; 8]
    let l: i64 = dhcp_option_find(op, on, O_ART, (&b[0]) as u64, 8)
    if l == 1 { (*d).art = b[0] as u64 } else { (*d).art = 0 }
    (*d).maske = opt_u32(op, on, O_MASKE)
    (*d).tor = opt_u32(op, on, O_TOR)
    (*d).dns = opt_u32(op, on, O_DNS)
    (*d).server = opt_u32(op, on, O_SERVER)
    (*d).miete = opt_u32(op, on, O_MIETE)
    return true
}

const T_FIN: u64 = 1
const T_SYN: u64 = 2
const T_RST: u64 = 4
const T_PSH: u64 = 8
const T_ACK: u64 = 16

const TCP_MIN: usize = 20

struct Tcp {
    source: u64,
    dest: u64,
    seq: u64,
    ack: u64,
    off: usize,
    flags: u64,
    window: u64,
    payload: u64,
    payload_len: usize,
    sum_ok: bool
}

fn tcp_new() -> Tcp {
    var t: Tcp = Tcp {
        source: 0, dest: 0, seq: 0, ack: 0, off: 0, flags: 0,
        window: 0, payload: 0, payload_len: 0, sum_ok: false
    }
    return t
}

fn tcp_build(out: u64, qip: u64, zip: u64, qport: u64, zport: u64,
    seq: u64, ack: u64, flags: u64, payload_len: usize) -> usize {
    put16(out, 0, qport)
    put16(out, 2, zport)
    put32(out, 4, seq)
    put32(out, 8, ack)
    octets.store_byte(out, 12, 0x50 as u8)      // Datenversatz 5, keine Optionen
    octets.store_byte(out, 13, (flags & 255) as u8)
    put16(out, 14, 8192)
    put16(out, 16, 0)
    put16(out, 18, 0)
    let ps: u64 = pseudo_sum(qip, zip, P_TCP, TCP_MIN + payload_len)
    put16(out, 16, sum16(out, TCP_MIN + payload_len, ps))
    return TCP_MIN
}

fn tcp_parse(t: *mut Tcp, p: u64, n: usize, qip: u64,
    zip: u64) -> bool {
    if n < TCP_MIN { return false }
    let off: usize = ((octets.load_byte(p, 12) >> 4) as usize) * 4
    if off < TCP_MIN { return false }
    if off > n { return false }
    (*t).source = be16(p, 0)
    (*t).dest = be16(p, 2)
    (*t).seq = be32(p, 4)
    (*t).ack = be32(p, 8)
    (*t).off = off
    (*t).flags = (octets.load_byte(p, 13) as u64) & 255
    (*t).window = be16(p, 14)
    (*t).payload = p + off as u64
    (*t).payload_len = n - off
    let ps: u64 = pseudo_sum(qip, zip, P_TCP, n)
    (*t).sum_ok = sum16_check(p, n, ps)
    return true
}

fn lit(out: u64, at: usize, w: u64) -> usize {
    var i: usize = 0
    while octets.load_byte(w, i) != 0 as u8 {
        octets.store_byte(out, at + i, octets.load_byte(w, i))
        i = i + 1
    }
    return at + i
}

// GET <pfad> HTTP/1.0\r\nHost: <wirt>\r\n\r\n
fn http_get_build(out: u64, url_path: u64, url_path_len: usize, wirt: u64,
    wirt_len: usize) -> usize {
    var g: [u8; 5] = "GET \0"
    var at: usize = lit(out, 0, (&g[0]) as u64)
    var i: usize = 0
    while i < url_path_len {
        octets.store_byte(out, at + i, octets.load_byte(url_path, i))
        i = i + 1
    }
    at = at + url_path_len
    var h1: [u8; 18] = " HTTP/1.0\r\nHost: \0"
    at = lit(out, at, (&h1[0]) as u64)
    i = 0
    while i < wirt_len {
        octets.store_byte(out, at + i, octets.load_byte(wirt, i))
        i = i + 1
    }
    at = at + wirt_len
    var h2: [u8; 5] = "\r\n\r\n\0"
    at = lit(out, at, (&h2[0]) as u64)
    return at
}

fn http_status_of(p: u64, n: usize) -> u64 {
    if n < 12 { return 0 }
    if octets.load_byte(p, 0) != 72 as u8 { return 0 }   // H
    if octets.load_byte(p, 1) != 84 as u8 { return 0 }   // T
    if octets.load_byte(p, 2) != 84 as u8 { return 0 }   // T
    if octets.load_byte(p, 3) != 80 as u8 { return 0 }   // P
    if octets.load_byte(p, 4) != 47 as u8 { return 0 }   // /
    var i: usize = 5
    while i < n && octets.load_byte(p, i) != 32 as u8 { i = i + 1 }
    if i >= n { return 0 }
    i = i + 1
    var v: u64 = 0
    var z: usize = 0
    while i < n && z < 3 {
        let c: u8 = octets.load_byte(p, i)
        if c < 48 as u8 || c > 57 as u8 { return 0 }
        v = v * 10 + ((c as u64) - 48)
        i = i + 1
        z = z + 1
    }
    if z != 3 { return 0 }
    return v
}

fn http_body_offset(p: u64, n: usize) -> i64 {
    var i: usize = 0
    while i + 3 < n {
        if octets.load_byte(p, i) == 13 as u8 && octets.load_byte(p, i + 1) == 10 as u8
            && octets.load_byte(p, i + 2) == 13 as u8 && octets.load_byte(p, i + 3) == 10 as u8 {
            return (i + 4) as i64
        }
        i = i + 1
    }
    return -1
}
