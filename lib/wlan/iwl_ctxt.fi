// SPDX-License-Identifier: GPL-2.0-only
// lib/wlan/iwl_ctxt.fi -- iwlwifi gen2 context info + TFD / command queue structures (M3/M4 prep).
//
// Pure memory codec: the caller hands in zeroed DMA-able buffers (as u64 addresses) and gets the
// byte layout the device would read. Layout numbers (struct iwl_context_info, struct iwl_tfd,
// iwl_cmd_header, HBUS_TARG_WRPTR encoding) are from memory of pcie/ctxt-info.c, iwl-context-info.h,
// iwl-fh.h, pcie/tx.c; NOT confirmed against the source or the laptop. The gate checks round trips,
// bounds and no-overlap of the layout table -- it cannot prove Intel agrees. No allocator.

import wlan.iwl_fw

export {
    CTXT_SIZE, CTXT_OFF_DRAM, CTXT_DRAM_N, TFD_SIZE, TFD_MAX_TBS, CMD_SLOTS,
    ctxt_init, ctxt_fill_dram, ctxt_set_rbd, ctxt_set_hcmd, ctxt_dram_add, ctxt_check, ctxt_ctrl_flags,
    tfd_clear, tfd_add_tb, tfd_num_tbs, tfd_tb_addr, tfd_tb_len,
    Txq, txq_new, txq_free, txq_push, txq_reclaim, txq_wrptr_reg, txq_used,
    cmd_hdr_put, cmd_seq, cmd_wide_id,
    E_CT_ALIGN, E_CT_FULL, E_TQ_FULL, E_TQ_TB, E_TQ_EMPTY
}

const CTXT_SIZE: usize = 1776
const CTXT_OFF_CTRL: usize = 8
const CTXT_OFF_RBD: usize = 24     // free_rbd_addr, used_rbd_addr, status_wr_ptr (3 x le64)
const CTXT_OFF_HCMD: usize = 48    // cmd_queue_addr le64, cmd_queue_size u8
const CTXT_OFF_DRAM: usize = 176   // umac_img[64], lmac_img[64], virtual_img[64] (le64 each)
const CTXT_DRAM_N: usize = 64

const CF_TFD_LONG: u64 = 0x100
const CF_RB_CB_POS: u64 = 4
const CF_RB_SIZE_POS: u64 = 9
const RB_SIZE_4K: u64 = 4

const TFD_SIZE: usize = 128
const TFD_MAX_TBS: u64 = 20
const CMD_SLOTS: u64 = 32

const E_CT_ALIGN: i64 = -30
const E_CT_FULL: i64 = -31
const E_TQ_FULL: i64 = -32
const E_TQ_TB: i64 = -33
const E_TQ_EMPTY: i64 = -34

fn st8(a: u64, o: usize, v: u64) { *((a + o as u64) as *mut u8) = (v & 255) as u8 }
fn ld8(a: u64, o: usize) -> u64 { let b: u8 = *((a + o as u64) as *mut u8)
    return b as u64 }
fn st16(a: u64, o: usize, v: u64) { st8(a, o, v)
    st8(a, o + 1, v >> 8) }
fn st32(a: u64, o: usize, v: u64) { st16(a, o, v)
    st16(a, o + 2, v >> 16) }
fn st64(a: u64, o: usize, v: u64) { st32(a, o, v)
    st32(a, o + 4, v >> 32) }
fn ld16(a: u64, o: usize) -> u64 { return ld8(a, o) | (ld8(a, o + 1) << 8) }
fn ld32(a: u64, o: usize) -> u64 { return ld16(a, o) | (ld16(a, o + 2) << 16) }
fn ld64(a: u64, o: usize) -> u64 { return ld32(a, o) | (ld32(a, o + 4) << 32) }

fn zero(a: u64, n: usize) {
    var i: usize = 0
    while i < n { st8(a, i, 0)
        i = i + 1 }
}

// ---- context info (one 4 KiB page, device reads it after CSR_CTXT_INFO_BA is written) ----

fn ctxt_ctrl_flags(rb_cb_log2: u64) -> u64 {
    return CF_TFD_LONG | (RB_SIZE_4K << CF_RB_SIZE_POS) | (rb_cb_log2 << CF_RB_CB_POS)
}

// version{mac_id = low 16 bits of hw_rev, version 0, size in dwords}, control flags, rest zero.
fn ctxt_init(buf: u64, hw_rev: u64, rb_cb_log2: u64) {
    zero(buf, CTXT_SIZE)
    st16(buf, 0, hw_rev)
    st16(buf, 2, 0)
    st16(buf, 4, (CTXT_SIZE / 4) as u64)
    st32(buf, CTXT_OFF_CTRL, ctxt_ctrl_flags(rb_cb_log2))
}

fn aligned4k(a: u64) -> bool { return a & 0xFFF == 0 }

fn ctxt_set_rbd(buf: u64, free_ring: u64, used_ring: u64, status: u64) -> i64 {
    if !aligned4k(free_ring) || !aligned4k(used_ring) || status & 0xF != 0 { return E_CT_ALIGN }
    st64(buf, CTXT_OFF_RBD, free_ring)
    st64(buf, CTXT_OFF_RBD + 8, used_ring)
    st64(buf, CTXT_OFF_RBD + 16, status)
    return 0
}

fn ctxt_set_hcmd(buf: u64, tfd_ring: u64, size_code: u64) -> i64 {
    if !aligned4k(tfd_ring) { return E_CT_ALIGN }
    st64(buf, CTXT_OFF_HCMD, tfd_ring)
    st8(buf, CTXT_OFF_HCMD + 8, size_code)
    return 0
}

// list: 0 = umac_img (CPU2), 1 = lmac_img (CPU1), 2 = virtual_img (paging). idx < 64.
fn ctxt_dram_add(buf: u64, list: u64, idx: usize, bus: u64) -> i64 {
    if idx >= CTXT_DRAM_N { return E_CT_FULL }
    if !aligned4k(bus) { return E_CT_ALIGN }
    st64(buf, CTXT_OFF_DRAM + (list as usize) * CTXT_DRAM_N * 8 + idx * 8, bus)
    return 0
}

// Map the parsed image `img` into the three DRAM lists. `bus` points to an array of u64 bus
// addresses, one per section in image order (the caller's DMA copies of the section data).
// LMAC -> lmac_img (list 1), UMAC -> umac_img (list 0), PAGING -> virtual_img (list 2).
fn ctxt_fill_dram(buf: u64, f: *mut iwl_fw.FwInfo, img: usize, bus: u64) -> i64 {
    var cnt: [usize; 3] = [0; 3]
    let n: usize = iwl_fw.fw_sec_count(f, img)
    var i: usize = 0
    while i < n {
        let k: u64 = iwl_fw.fw_sec_kind(f, img, i)
        var list: u64 = 0
        if k == iwl_fw.KIND_LMAC {
            list = 1
        } else if k == iwl_fw.KIND_PAGING {
            list = 2
        }
        let r: i64 = ctxt_dram_add(buf, list, cnt[k as usize], ld64(bus, i * 8))
        if r != 0 { return r }
        cnt[k as usize] = cnt[k as usize] + 1
        i = i + 1
    }
    return 0
}

// Sanity of a built page: size word, mac_id, rings set, at least one lmac + one umac image.
fn ctxt_check(buf: u64, hw_rev: u64) -> bool {
    if ld16(buf, 4) != (CTXT_SIZE / 4) as u64 { return false }
    if ld16(buf, 0) != (hw_rev & 0xFFFF) { return false }
    if ld64(buf, CTXT_OFF_RBD) == 0 || ld64(buf, CTXT_OFF_HCMD) == 0 { return false }
    if ld64(buf, CTXT_OFF_DRAM + CTXT_DRAM_N * 8) == 0 { return false }    // lmac_img[0]
    if ld64(buf, CTXT_OFF_DRAM) == 0 { return false }                      // umac_img[0]
    return true
}

// ---- TFD: 128 octets = 3 reserved + num_tbs + 20 x {lo le32, hi_n_len le16} + pad ----

fn tfd_clear(t: u64) { zero(t, TFD_SIZE) }
fn tfd_num_tbs(t: u64) -> u64 { return ld8(t, 3) & 0x1F }

// Append one buffer: 36-bit address (hi nibble in hi_n_len), length < 4096 in the upper 12 bits.
fn tfd_add_tb(t: u64, addr: u64, len: u64) -> i64 {
    let n: u64 = tfd_num_tbs(t)
    if n >= TFD_MAX_TBS { return E_TQ_TB }
    if len == 0 || len >= 4096 || (addr >> 36) != 0 { return E_TQ_TB }
    let o: usize = 4 + (n as usize) * 6
    st32(t, o, addr & 0xFFFFFFFF)
    st16(t, o + 4, ((addr >> 32) & 0xF) | (len << 4))
    st8(t, 3, n + 1)
    return n as i64
}

fn tfd_tb_addr(t: u64, i: u64) -> u64 {
    let o: usize = 4 + (i as usize) * 6
    return ld32(t, o) | ((ld16(t, o + 4) & 0xF) << 32)
}
fn tfd_tb_len(t: u64, i: u64) -> u64 {
    return ld16(t, 4 + (i as usize) * 6 + 4) >> 4
}

// ---- ring of TFDs (command queue = 32 slots; data queues use the same code) ----

struct Txq {
    base: u64,        // address of slot 0 (TFD ring)
    n: u64,           // slots, power of two
    wr: u64,          // write pointer (next slot to fill)
    rd: u64,          // read pointer (next slot to reclaim)
    id: u64
}

fn txq_new(base: u64, n: u64, id: u64) -> Txq {
    var q: Txq = Txq { base: base, n: n, wr: 0, rd: 0, id: id }
    return q
}

fn txq_used(q: *mut Txq) -> u64 { return ((*q).wr + (*q).n - (*q).rd) & ((*q).n - 1) }
// one slot is always kept empty so full != empty
fn txq_free(q: *mut Txq) -> u64 { return (*q).n - 1 - txq_used(q) }

// Fill the next TFD with one buffer; returns the slot index or E_TQ_*. Does not ring the doorbell.
fn txq_push(q: *mut Txq, addr: u64, len: u64) -> i64 {
    if txq_free(q) == 0 { return E_TQ_FULL }
    let slot: u64 = (*q).wr
    let t: u64 = (*q).base + slot * TFD_SIZE as u64
    tfd_clear(t)
    let r: i64 = tfd_add_tb(t, addr, len)
    if r < 0 { return r }
    (*q).wr = (slot + 1) & ((*q).n - 1)
    return slot as i64
}

// The device reported progress up to `to` (exclusive): clear the TFDs and advance rd.
fn txq_reclaim(q: *mut Txq, to: u64) -> i64 {
    if to >= (*q).n { return E_TQ_EMPTY }
    var steps: u64 = ((to + (*q).n - (*q).rd) & ((*q).n - 1))
    if steps > txq_used(q) { return E_TQ_EMPTY }
    while steps > 0 {
        tfd_clear((*q).base + (*q).rd * TFD_SIZE as u64)
        (*q).rd = ((*q).rd + 1) & ((*q).n - 1)
        steps = steps - 1
    }
    return 0
}

// Value for HBUS_TARG_WRPTR: write index | (queue id << 8).
fn txq_wrptr_reg(q: *mut Txq) -> u64 { return (*q).wr | ((*q).id << 8) }

// ---- host command header (iwl_cmd_header: cmd u8, group u8, sequence le16 = queue<<8 | slot) ----

fn cmd_seq(qid: u64, slot: u64) -> u64 { return ((qid & 0xFF) << 8) | (slot & 0xFF) }
fn cmd_wide_id(group: u64, cmd: u64) -> u64 { return ((group & 0xFF) << 8) | (cmd & 0xFF) }

fn cmd_hdr_put(a: u64, group: u64, cmd: u64, qid: u64, slot: u64) {
    st8(a, 0, cmd)
    st8(a, 1, group)
    st16(a, 2, cmd_seq(qid, slot))
}
