import wlan.iwl_probe
import wlan.iwl_fw
import wlan.iwl_fh8000
import wlan.iwl_fh7000

export { fh_load }

fn fh_load(p: *mut iwl_probe.Probe, f: *mut iwl_fw.FwInfo, blob: u64, img: usize,
           bounce: u64, bphys: u64, bsize: u64, st: *mut iwl_fh8000.FhStat) -> i64 {
    if (*p).fam == iwl_probe.FAM_7000 { return iwl_fh7000.fh_load(p, f, blob, img, bounce, bphys, bsize, st) }
    return iwl_fh8000.fh_load(p, f, blob, img, bounce, bphys, bsize, st)
}
