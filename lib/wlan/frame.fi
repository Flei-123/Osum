// ==================================================================
// DER RAHMENKOPF, IEEE 802.11-2016 9.2.3
// ==================================================================

export {
    IeIter, ie_begin, ie_next,
    fc, art, untertyp, tods, fromds, geschuetzt, ordnung, wiederholung,
    header_len, body_offset, adr1, adr2, adr3, seq, bruchstueck,
    qos_tid, hat_qos, hat_adr4,
    KIND_MGMT, KIND_CTRL, KIND_DATA,
    UT_ASSOC_ANFRAGE, UT_ASSOC_REPLY, UT_PROBE_ANFRAGE,
    UT_PROBE_REPLY, UT_BEACON, UT_DISASSOC, UT_AUTH, UT_DEAUTH,
    UT_ACTION,
    IE_SSID, IE_RATEN, IE_DS, IE_TIM, IE_LAND, IE_HT_FAEHIG, IE_RSN,
    IE_HT_BETRIEB, IE_ERWEITERTE_RATEN, IE_VHT_BETRIEB, IE_HERSTELLER,
    IE_ERWEITERUNG,
    MIN_HEADER
}

const MIN_HEADER: usize = 24

const KIND_MGMT: u64 = 0
const KIND_CTRL: u64 = 1
const KIND_DATA: u64 = 2

const UT_ASSOC_ANFRAGE: u64 = 0
const UT_ASSOC_REPLY: u64 = 1
const UT_PROBE_ANFRAGE: u64 = 4
const UT_PROBE_REPLY: u64 = 5
const UT_BEACON: u64 = 8
const UT_DISASSOC: u64 = 10
const UT_AUTH: u64 = 11
const UT_DEAUTH: u64 = 12
const UT_ACTION: u64 = 13

const IE_SSID: u64 = 0
const IE_RATEN: u64 = 1
const IE_DS: u64 = 3
const IE_TIM: u64 = 5
const IE_LAND: u64 = 7
const IE_HT_FAEHIG: u64 = 45
const IE_RSN: u64 = 48
const IE_ERWEITERTE_RATEN: u64 = 50
const IE_HT_BETRIEB: u64 = 61
const IE_VHT_BETRIEB: u64 = 192
const IE_HERSTELLER: u64 = 221
const IE_ERWEITERUNG: u64 = 255

fn ld8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn le16(p: u64, i: usize) -> u64 {
    return (ld8(p, i) as u64) | ((ld8(p, i + 1) as u64) << 8)
}

fn fc(p: u64, n: usize) -> u64 {
    if n < 2 {
        return 0
    }
    return le16(p, 0)
}

fn art(f: u64) -> u64 {
    return (f >> 2) & 3
}

fn untertyp(f: u64) -> u64 {
    return (f >> 4) & 15
}

fn tods(f: u64) -> bool {
    return (f & 256) != 0
}

fn fromds(f: u64) -> bool {
    return (f & 512) != 0
}

fn wiederholung(f: u64) -> bool {
    return (f & 2048) != 0
}

fn geschuetzt(f: u64) -> bool {
    return (f & 16384) != 0
}

fn ordnung(f: u64) -> bool {
    return (f & 32768) != 0
}

fn hat_adr4(f: u64) -> bool {
    return tods(f) && fromds(f)
}

fn hat_qos(f: u64) -> bool {
    if art(f) != KIND_DATA {
        return false
    }
    return (untertyp(f) & 8) != 0
}

fn header_len(p: u64, n: usize) -> i64 {
    if n < 2 {
        return -1
    }
    let f: u64 = le16(p, 0)
    if (f & 3) != 0 {
        return -1 // Protokollversion
    }
    let a: u64 = art(f)
    if a == KIND_CTRL || a == 3 {
        return -1
    }
    var l: usize = MIN_HEADER
    if a == KIND_DATA {
        if hat_adr4(f) {
            l = l + 6
        }
        if hat_qos(f) {
            l = l + 2
        }
    }
    if ordnung(f) {
        if a == KIND_MGMT || (a == KIND_DATA && hat_qos(f)) {
            l = l + 4
        }
    }
    if n < l {
        return -1
    }
    return l as i64
}

fn body_offset(p: u64, n: usize) -> i64 {
    return header_len(p, n)
}

fn adr1(p: u64, n: usize) -> u64 {
    if n < 10 {
        return 0
    }
    return p + 4
}

fn adr2(p: u64, n: usize) -> u64 {
    if n < 16 {
        return 0
    }
    return p + 10
}

fn adr3(p: u64, n: usize) -> u64 {
    if n < 22 {
        return 0
    }
    return p + 16
}

fn seq(p: u64, n: usize) -> i64 {
    if n < 24 {
        return -1
    }
    return ((le16(p, 22) >> 4) & 4095) as i64
}

fn bruchstueck(p: u64, n: usize) -> i64 {
    if n < 24 {
        return -1
    }
    return (le16(p, 22) & 15) as i64
}

fn qos_tid(p: u64, n: usize) -> i64 {
    if n < 2 {
        return -1
    }
    let f: u64 = le16(p, 0)
    if !hat_qos(f) {
        return -1
    }
    var at: usize = MIN_HEADER
    if hat_adr4(f) {
        at = at + 6
    }
    if n < at + 2 {
        return -1
    }
    return (ld8(p, at) as u64 & 15) as i64
}

// ==================================================================
// DIE INFORMATIONSELEMENTE
// ==================================================================
struct IeIter {
    p: u64,
    n: usize,
    at: usize,
    id: u64,
    ext: u64,
    length: usize,
    payload: u64,
    broken: bool,
}

fn ie_begin(p: u64, n: usize, at: usize) -> IeIter {
    return IeIter { p: p, n: n, at: at, id: 0, ext: 0, length: 0,
        payload: 0, broken: false }
}

fn ie_next(it: *mut IeIter) -> bool {
    let at: usize = (*it).at
    let n: usize = (*it).n
    if at >= n {
        return false
    }
    if at + 2 > n {
        (*it).broken = true
        (*it).at = n
        return false
    }
    let id: u64 = ld8((*it).p, at) as u64
    let l: usize = ld8((*it).p, at + 1) as usize
    if at + 2 + l > n {
        (*it).broken = true
        (*it).at = n
        return false
    }
    (*it).id = id
    (*it).length = l
    if l > 0 {
        (*it).payload = (*it).p + (at as u64) + 2
    } else {
        (*it).payload = 0
    }
    (*it).ext = 0
    if id == IE_ERWEITERUNG {
        if l < 1 {
            (*it).broken = true
            (*it).at = n
            return false
        }
        (*it).ext = ld8((*it).p, at + 2) as u64
        (*it).length = l - 1
        if l - 1 > 0 {
            (*it).payload = (*it).p + (at as u64) + 3
        } else {
            (*it).payload = 0
        }
    }
    (*it).at = at + 2 + l
    return true
}
