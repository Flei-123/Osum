// SPDX-License-Identifier: GPL-2.0-only
export {
    Plan, plan_new, plan_event, plan_count, plan_op, plan_arg, plan_clear,
    plan_phase, plan_sta, plan_keys,
    EV_UP, EV_SCAN, EV_SCAN_DONE, EV_JOIN_OPEN, EV_JOIN_RSN, EV_AUTH_OK, EV_ASSOC_OK,
    EV_PTK, EV_GTK, EV_AUTHORIZE, EV_LEAVE, EV_DOWN,
    OP_START, OP_STOP, OP_ADD_INTERFACE, OP_REMOVE_INTERFACE, OP_HW_SCAN, OP_CANCEL_HW_SCAN,
    OP_ADD_CHANCTX, OP_REMOVE_CHANCTX, OP_ASSIGN_VIF_CHANCTX, OP_UNASSIGN_VIF_CHANCTX,
    OP_STA_STATE, OP_MGD_PREPARE_TX, OP_MGD_COMPLETE_TX, OP_BSS_INFO_CHANGED, OP_VIF_CFG_CHANGED,
    OP_CONF_TX, OP_SET_KEY, OP_FLUSH,
    STA_NOTEXIST, STA_NONE, STA_AUTH, STA_ASSOC, STA_AUTHORIZED,
    PH_DOWN, PH_IDLE, PH_SCAN, PH_JOIN, PH_AUTH, PH_ASSOC, PH_RUN,
    KEY_SET_PAIRWISE, KEY_SET_GROUP, KEY_DEL_PAIRWISE, KEY_DEL_GROUP,
    BSS_BSSID, BSS_QOS, CFG_ASSOC, E_ORDER, E_FULL, MAX_OPS
}

const EV_UP: u64 = 1
const EV_SCAN: u64 = 2
const EV_SCAN_DONE: u64 = 3
const EV_JOIN_OPEN: u64 = 4
const EV_JOIN_RSN: u64 = 5
const EV_AUTH_OK: u64 = 6
const EV_ASSOC_OK: u64 = 7
const EV_PTK: u64 = 8
const EV_GTK: u64 = 9
const EV_AUTHORIZE: u64 = 10
const EV_LEAVE: u64 = 11
const EV_DOWN: u64 = 12

const OP_START: u64 = 1
const OP_STOP: u64 = 2
const OP_ADD_INTERFACE: u64 = 3
const OP_REMOVE_INTERFACE: u64 = 4
const OP_HW_SCAN: u64 = 5
const OP_CANCEL_HW_SCAN: u64 = 6
const OP_ADD_CHANCTX: u64 = 7
const OP_REMOVE_CHANCTX: u64 = 8
const OP_ASSIGN_VIF_CHANCTX: u64 = 9
const OP_UNASSIGN_VIF_CHANCTX: u64 = 10
const OP_STA_STATE: u64 = 11
const OP_MGD_PREPARE_TX: u64 = 12
const OP_MGD_COMPLETE_TX: u64 = 13
const OP_BSS_INFO_CHANGED: u64 = 14
const OP_VIF_CFG_CHANGED: u64 = 15
const OP_CONF_TX: u64 = 16
const OP_SET_KEY: u64 = 17
const OP_FLUSH: u64 = 18

const STA_NOTEXIST: u64 = 0
const STA_NONE: u64 = 1
const STA_AUTH: u64 = 2
const STA_ASSOC: u64 = 3
const STA_AUTHORIZED: u64 = 4

const PH_DOWN: u64 = 0
const PH_IDLE: u64 = 1
const PH_SCAN: u64 = 2
const PH_JOIN: u64 = 3
const PH_AUTH: u64 = 4
const PH_ASSOC: u64 = 5
const PH_RUN: u64 = 6

const KEY_SET_PAIRWISE: u64 = 1
const KEY_SET_GROUP: u64 = 2
const KEY_DEL_PAIRWISE: u64 = 3
const KEY_DEL_GROUP: u64 = 4

const BSS_BSSID: u64 = 0x2
const BSS_QOS: u64 = 0x200
const CFG_ASSOC: u64 = 0x1
const AC_COUNT: u64 = 4
const ARG_SHIFT: u64 = 8

const E_ORDER: i64 = -1
const E_FULL: i64 = -2
const MAX_OPS: usize = 32

struct Plan {
    phase: u64,
    sta: u64,
    rsn: bool,
    ptk: bool,
    gtk: bool,
    full: bool,
    n: usize,
    ops: [u64; 32]
}

fn plan_new() -> Plan {
    return Plan { phase: PH_DOWN, sta: STA_NOTEXIST, rsn: false, ptk: false, gtk: false, full: false, n: 0, ops: [0; 32] }
}

fn plan_count(p: *mut Plan) -> usize { return (*p).n }
fn plan_op(p: *mut Plan, i: usize) -> u64 { return (*p).ops[i] & 0xFF }
fn plan_arg(p: *mut Plan, i: usize) -> u64 { return (*p).ops[i] >> ARG_SHIFT }
fn plan_phase(p: *mut Plan) -> u64 { return (*p).phase }
fn plan_sta(p: *mut Plan) -> u64 { return (*p).sta }

fn plan_keys(p: *mut Plan) -> u64 {
    var k: u64 = 0
    if (*p).ptk { k = k + 1 }
    if (*p).gtk { k = k + 1 }
    return k
}

fn plan_clear(p: *mut Plan) {
    (*p).n = 0
    (*p).full = false
}

fn emit(p: *mut Plan, op: u64, arg: u64) {
    if (*p).n >= MAX_OPS {
        (*p).full = true
        return
    }
    (*p).ops[(*p).n] = op | (arg << ARG_SHIFT)
    (*p).n = (*p).n + 1
}

fn sta_up(p: *mut Plan, target: u64) {
    while (*p).sta < target {
        (*p).sta = (*p).sta + 1
        emit(p, OP_STA_STATE, (*p).sta)
    }
}

fn sta_down(p: *mut Plan, target: u64) {
    while (*p).sta > target {
        (*p).sta = (*p).sta - 1
        emit(p, OP_STA_STATE, (*p).sta)
    }
}

fn drop_keys(p: *mut Plan) {
    if (*p).ptk { emit(p, OP_SET_KEY, KEY_DEL_PAIRWISE) }
    if (*p).gtk { emit(p, OP_SET_KEY, KEY_DEL_GROUP) }
    (*p).ptk = false
    (*p).gtk = false
}

fn leave(p: *mut Plan) {
    if (*p).phase == PH_SCAN {
        emit(p, OP_CANCEL_HW_SCAN, 0)
        (*p).phase = PH_IDLE
        return
    }
    if (*p).phase < PH_JOIN { return }
    emit(p, OP_FLUSH, 0)
    sta_down(p, STA_ASSOC)
    drop_keys(p)
    sta_down(p, STA_NONE)
    if (*p).phase >= PH_ASSOC { emit(p, OP_VIF_CFG_CHANGED, 0) }
    if (*p).phase == PH_JOIN || (*p).phase == PH_AUTH { emit(p, OP_MGD_COMPLETE_TX, 0) }
    sta_down(p, STA_NOTEXIST)
    emit(p, OP_UNASSIGN_VIF_CHANCTX, 0)
    emit(p, OP_REMOVE_CHANCTX, 0)
    (*p).phase = PH_IDLE
}

fn join(p: *mut Plan, rsn: bool) {
    if (*p).phase == PH_SCAN { emit(p, OP_CANCEL_HW_SCAN, 0) }
    (*p).rsn = rsn
    emit(p, OP_ADD_CHANCTX, 0)
    emit(p, OP_ASSIGN_VIF_CHANCTX, 0)
    emit(p, OP_BSS_INFO_CHANGED, BSS_BSSID)
    sta_up(p, STA_NONE)
    emit(p, OP_MGD_PREPARE_TX, 0)
    (*p).phase = PH_JOIN
}

fn assoc(p: *mut Plan) {
    var ac: u64 = 0
    while ac < AC_COUNT {
        emit(p, OP_CONF_TX, ac)
        ac = ac + 1
    }
    sta_up(p, STA_ASSOC)
    emit(p, OP_VIF_CFG_CHANGED, CFG_ASSOC)
    emit(p, OP_BSS_INFO_CHANGED, BSS_QOS)
    emit(p, OP_MGD_COMPLETE_TX, 0)
    (*p).phase = PH_ASSOC
}

fn down(p: *mut Plan) {
    leave(p)
    emit(p, OP_REMOVE_INTERFACE, 0)
    emit(p, OP_STOP, 0)
    (*p).phase = PH_DOWN
}

fn key_event(p: *mut Plan, ev: u64) -> bool {
    if ev == EV_PTK {
        if (*p).phase != PH_ASSOC || !(*p).rsn { return false }
        emit(p, OP_SET_KEY, KEY_SET_PAIRWISE)
        (*p).ptk = true
        return true
    }
    if (*p).phase != PH_ASSOC && (*p).phase != PH_RUN { return false }
    if !(*p).rsn { return false }
    emit(p, OP_SET_KEY, KEY_SET_GROUP)
    (*p).gtk = true
    return true
}

fn link_event(p: *mut Plan, ev: u64) -> bool {
    let ph: u64 = (*p).phase
    if ev == EV_UP {
        if ph != PH_DOWN { return false }
        emit(p, OP_START, 0)
        emit(p, OP_ADD_INTERFACE, 0)
        (*p).phase = PH_IDLE
        return true
    }
    if ev == EV_SCAN {
        if ph != PH_IDLE { return false }
        emit(p, OP_HW_SCAN, 0)
        (*p).phase = PH_SCAN
        return true
    }
    if ev == EV_SCAN_DONE {
        if ph != PH_SCAN { return false }
        (*p).phase = PH_IDLE
        return true
    }
    if ev == EV_JOIN_OPEN || ev == EV_JOIN_RSN {
        if ph != PH_IDLE && ph != PH_SCAN { return false }
        join(p, ev == EV_JOIN_RSN)
        return true
    }
    return false
}

fn session_event(p: *mut Plan, ev: u64) -> bool {
    let ph: u64 = (*p).phase
    if ev == EV_AUTH_OK {
        if ph != PH_JOIN { return false }
        sta_up(p, STA_AUTH)
        emit(p, OP_MGD_COMPLETE_TX, 0)
        emit(p, OP_MGD_PREPARE_TX, 0)
        (*p).phase = PH_AUTH
        return true
    }
    if ev == EV_ASSOC_OK {
        if ph != PH_AUTH { return false }
        assoc(p)
        return true
    }
    if ev == EV_AUTHORIZE {
        if ph != PH_ASSOC { return false }
        if (*p).rsn && !(*p).ptk { return false }
        sta_up(p, STA_AUTHORIZED)
        (*p).phase = PH_RUN
        return true
    }
    if ev == EV_LEAVE {
        if ph == PH_DOWN { return false }
        leave(p)
        return true
    }
    if ev == EV_DOWN {
        if ph == PH_DOWN { return false }
        down(p)
        return true
    }
    return false
}

fn plan_event(p: *mut Plan, ev: u64) -> i64 {
    let before: usize = (*p).n
    var ok: bool = false
    if ev == EV_PTK || ev == EV_GTK {
        ok = key_event(p, ev)
    } else if ev <= EV_JOIN_RSN {
        ok = link_event(p, ev)
    } else {
        ok = session_event(p, ev)
    }
    if !ok { return E_ORDER }
    if (*p).full { return E_FULL }
    return ((*p).n - before) as i64
}
