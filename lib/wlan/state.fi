// ==================================================================
// DAS EREIGNISALPHABET
// ==================================================================

export {
    Lauf, lauf_new, begin, event, verbunden, may_pass_data,
    Z_OFF, Z_SUCHT, Z_GEFUNDEN, Z_AUTH, Z_ASSOZ,
    Z_M1, Z_M2, Z_M3, Z_VERBUNDEN, Z_ERROR,
    G_KEIN, G_REIHENFOLGE, G_ABGELEHNT, G_TIME, G_DEAUTH,
    G_WIEDERHOLUNG, G_MIC, G_UNBEKANNT
}

const Z_OFF: u64 = 0
const Z_SUCHT: u64 = 1
const Z_GEFUNDEN: u64 = 2
const Z_AUTH: u64 = 3
const Z_ASSOZ: u64 = 4
const Z_M1: u64 = 5       // Nachricht 1 ist da
const Z_M2: u64 = 6       // Nachricht 2 ist raus
const Z_M3: u64 = 7
const Z_VERBUNDEN: u64 = 8
const Z_ERROR: u64 = 9

const G_KEIN: u64 = 0
const G_REIHENFOLGE: u64 = 1
const G_ABGELEHNT: u64 = 2
const G_TIME: u64 = 3
const G_DEAUTH: u64 = 4
const G_WIEDERHOLUNG: u64 = 5
const G_MIC: u64 = 6
const G_UNBEKANNT: u64 = 7

struct Lauf {
    machine_state: u64,
    reason: u64,
    key_installed: bool,
    schritte: u64,
    installationen: u64,
}

fn lauf_new() -> Lauf {
    return Lauf { machine_state: Z_OFF, reason: G_KEIN,
        key_installed: false, schritte: 0,
        installationen: 0 }
}

fn begin(l: *mut Lauf) {
    (*l).machine_state = Z_OFF
    (*l).reason = G_KEIN
    (*l).key_installed = false
    (*l).schritte = 0
    (*l).installationen = 0
}

fn abort(l: *mut Lauf, reason: u64) {
    if (*l).machine_state != Z_ERROR {
        (*l).machine_state = Z_ERROR
        (*l).reason = reason
    }
    (*l).key_installed = false
}

fn event(l: *mut Lauf, e: u8) {
    (*l).schritte = (*l).schritte + 1
    if (*l).machine_state == Z_ERROR {
        return
    }
    let c: u64 = e as u64

    if c == 100 { // 'd'
        if (*l).machine_state == Z_OFF {
            abort(l, G_REIHENFOLGE)
        } else {
            abort(l, G_DEAUTH)
        }
        return
    }
    if c == 116 { // 't'
        if (*l).machine_state == Z_OFF || (*l).machine_state == Z_VERBUNDEN {
            abort(l, G_REIHENFOLGE)
        } else {
            abort(l, G_TIME)
        }
        return
    }
    if c == 120 { // 'x'
        abort(l, G_MIC)
        return
    }

    if (*l).machine_state == Z_OFF {
        if c == 115 { // 's'
            (*l).machine_state = Z_SUCHT
            return
        }
        abort(l, G_REIHENFOLGE)
        return
    }
    if (*l).machine_state == Z_SUCHT {
        if c == 98 { // 'b'
            (*l).machine_state = Z_GEFUNDEN
            return
        }
        if c == 115 { // 's' -- weitersuchen ist erlaubt
            return
        }
        abort(l, G_REIHENFOLGE)
        return
    }
    if (*l).machine_state == Z_GEFUNDEN {
        if c == 97 { // 'a'
            (*l).machine_state = Z_AUTH
            return
        }
        if c == 65 { // 'A'
            abort(l, G_ABGELEHNT)
            return
        }
        if c == 98 {
            return
        }
        abort(l, G_REIHENFOLGE)
        return
    }
    if (*l).machine_state == Z_AUTH {
        if c == 99 { // 'c'
            (*l).machine_state = Z_ASSOZ
            return
        }
        if c == 67 { // 'C'
            abort(l, G_ABGELEHNT)
            return
        }
        if c == 97 { // 'a' -- zweimal authentifiziert
            abort(l, G_WIEDERHOLUNG)
            return
        }
        abort(l, G_REIHENFOLGE)
        return
    }
    if (*l).machine_state == Z_ASSOZ {
        if c == 49 { // '1'
            (*l).machine_state = Z_M1
            return
        }
        if c == 99 { // 'c' -- zweimal assoziiert
            abort(l, G_WIEDERHOLUNG)
            return
        }
        abort(l, G_REIHENFOLGE)
        return
    }
    if (*l).machine_state == Z_M1 {
        if c == 50 { // '2'
            (*l).machine_state = Z_M2
            return
        }
        if c == 49 { // '1' noch einmal
            abort(l, G_WIEDERHOLUNG)
            return
        }
        abort(l, G_REIHENFOLGE)
        return
    }
    if (*l).machine_state == Z_M2 {
        if c == 51 { // '3'
            (*l).machine_state = Z_M3
            return
        }
        if c == 50 { // '2' noch einmal
            abort(l, G_WIEDERHOLUNG)
            return
        }
        if c == 49 { // '1' -- rueckwaerts
            abort(l, G_WIEDERHOLUNG)
            return
        }
        abort(l, G_REIHENFOLGE)
        return
    }
    if (*l).machine_state == Z_M3 {
        if c == 52 { // '4'
            (*l).machine_state = Z_VERBUNDEN
            (*l).key_installed = true
            (*l).installationen = (*l).installationen + 1
            return
        }
        if c == 51 {
            abort(l, G_WIEDERHOLUNG)
            return
        }
        abort(l, G_REIHENFOLGE)
        return
    }
    if (*l).machine_state == Z_VERBUNDEN {
        abort(l, G_REIHENFOLGE)
        return
    }
    abort(l, G_UNBEKANNT)
}

fn verbunden(l: *mut Lauf) -> bool {
    return (*l).machine_state == Z_VERBUNDEN
}

fn may_pass_data(l: *mut Lauf) -> bool {
    return (*l).machine_state == Z_VERBUNDEN && (*l).key_installed
}
