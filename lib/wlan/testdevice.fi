// ==================================================================
// KEIN ALLOKATOR
// ==================================================================

import wlan.device

export {
    Check, check_new, anhaengen,
    einspeisen, inject_clear,
    sent_count, sent_get, sent_clear, clear_both,
    key_count, key_kind_of, key_get,
    chan_set, chan_count,
    p_send, p_receive, p_chan, p_key
}

const MAX_FRAME: usize = 2400
const MAX_HOLD: usize = 8
const MAX_KEYS: usize = 4

struct Check {
    tx: [u8; 19200],          // MAX_HALTEN * MAX_RAHMEN
    tx_len: [usize; 8],
    tx_n: usize,
    rx: [u8; 19200],
    rx_len: [usize; 8],
    rx_n: usize,
    rx_gelesen: usize,
    sk: [u8; 64],             // MAX_KEYS * 16
    sk_art: [u64; 4],
    sk_kennung: [u64; 4],
    sk_n: usize,
    chan: u64,
    band: u64,
    chan_n: usize
}

fn check_new() -> Check {
    var p: Check = Check {
        tx: [0; 19200], tx_len: [0; 8], tx_n: 0,
        rx: [0; 19200], rx_len: [0; 8], rx_n: 0, rx_gelesen: 0,
        sk: [0; 64], sk_art: [0; 4], sk_kennung: [0; 4], sk_n: 0,
        chan: 0, band: 0, chan_n: 0
    }
    return p
}

fn p_send(ctx: u64, frame_buf: u64, len: usize) -> i64 {
    let p: *mut Check = ctx as *mut Check
    if (*p).tx_n >= MAX_HOLD { return -1 }
    if len > MAX_FRAME { return -1 }
    let basis: usize = (*p).tx_n * MAX_FRAME
    var i: usize = 0
    while i < len {
        (*p).tx[basis + i] = *((frame_buf + i as u64) as *mut u8)
        i = i + 1
    }
    (*p).tx_len[(*p).tx_n] = len
    (*p).tx_n = (*p).tx_n + 1
    return len as i64
}

fn p_receive(ctx: u64, buffer: u64, space: usize) -> i64 {
    let p: *mut Check = ctx as *mut Check
    if (*p).rx_gelesen >= (*p).rx_n { return 0 }
    let k: usize = (*p).rx_gelesen
    let len: usize = (*p).rx_len[k]
    if len > space { return -1 }
    let basis: usize = k * MAX_FRAME
    var i: usize = 0
    while i < len {
        *((buffer + i as u64) as *mut u8) = (*p).rx[basis + i]
        i = i + 1
    }
    (*p).rx_gelesen = (*p).rx_gelesen + 1
    return len as i64
}

fn p_chan(ctx: u64, chan: u64, band: u64) -> i64 {
    let p: *mut Check = ctx as *mut Check
    if chan == 0 || chan > 196 { return -1 }
    (*p).chan = chan
    (*p).band = band
    (*p).chan_n = (*p).chan_n + 1
    return 0
}

fn p_key(ctx: u64, art: u64, kennung: u64, key: u64,
    len: usize) -> i64 {
    let p: *mut Check = ctx as *mut Check
    if art == device.KEY_OFF {
        var j: usize = 0
        while j < MAX_KEYS * 16 {
            (*p).sk[j] = 0 as u8
            j = j + 1
        }
        (*p).sk_n = 0
        return 0
    }
    if (*p).sk_n >= MAX_KEYS { return -1 }
    if len != 16 { return -1 }
    let basis: usize = (*p).sk_n * 16
    var i: usize = 0
    while i < 16 {
        (*p).sk[basis + i] = *((key + i as u64) as *mut u8)
        i = i + 1
    }
    (*p).sk_art[(*p).sk_n] = art
    (*p).sk_kennung[(*p).sk_n] = kennung
    (*p).sk_n = (*p).sk_n + 1
    return 0
}

fn anhaengen(g: *mut device.Device, p: *mut Check, kann_ccmp: bool) -> bool {
    return device.board_set(g, p as u64, p_send, p_receive,
        p_chan, p_key, kann_ccmp)
}

// ------------------------------------------------------------------
// Was der Testlaeufer braucht
// ------------------------------------------------------------------

fn einspeisen(p: *mut Check, frame_buf: u64, len: usize) -> bool {
    if (*p).rx_n >= MAX_HOLD { return false }
    if len > MAX_FRAME { return false }
    let basis: usize = (*p).rx_n * MAX_FRAME
    var i: usize = 0
    while i < len {
        (*p).rx[basis + i] = *((frame_buf + i as u64) as *mut u8)
        i = i + 1
    }
    (*p).rx_len[(*p).rx_n] = len
    (*p).rx_n = (*p).rx_n + 1
    return true
}

fn inject_clear(p: *mut Check) {
    (*p).rx_n = 0
    (*p).rx_gelesen = 0
}

fn sent_count(p: *mut Check) -> usize { return (*p).tx_n }

fn sent_get(p: *mut Check, k: usize, out: u64, space: usize) -> i64 {
    if k >= (*p).tx_n { return -1 }
    let len: usize = (*p).tx_len[k]
    if len > space { return -1 }
    let basis: usize = k * MAX_FRAME
    var i: usize = 0
    while i < len {
        *((out + i as u64) as *mut u8) = (*p).tx[basis + i]
        i = i + 1
    }
    return len as i64
}

fn sent_clear(p: *mut Check) { (*p).tx_n = 0 }

fn key_count(p: *mut Check) -> usize { return (*p).sk_n }

fn key_kind_of(p: *mut Check, k: usize) -> u64 {
    if k >= (*p).sk_n { return 0 }
    return (*p).sk_art[k]
}

fn key_get(p: *mut Check, k: usize, out: u64) -> bool {
    if k >= (*p).sk_n { return false }
    let basis: usize = k * 16
    var i: usize = 0
    while i < 16 {
        *((out + i as u64) as *mut u8) = (*p).sk[basis + i]
        i = i + 1
    }
    return true
}

fn clear_both(p: *mut Check) {
    (*p).tx_n = 0
    (*p).rx_n = 0
    (*p).rx_gelesen = 0
}

fn chan_set(p: *mut Check) -> u64 { return (*p).chan }
fn chan_count(p: *mut Check) -> usize { return (*p).chan_n }
