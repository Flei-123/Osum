import wlan.iwl_buf

export {
    CMD_SCAN_CFG, CMD_SCAN_REQ_UMAC, CMD_SCAN_ABORT_UMAC, CMD_SCAN_COMPLETE_UMAC, CMD_SCAN_ITER_COMPLETE_UMAC,
    SCAN_CFG_ACTIVATE, SCAN_CFG_SET_TX_CHAINS, SCAN_CFG_SET_RX_CHAINS, SCAN_CFG_SET_ALL_TIMES, SCAN_CFG_SET_CHANNEL_FLAGS,
    SCAN_CFG_SET_LEGACY_RATES, SCAN_CFG_SET_MAC_ADDR, SCAN_CFG_FIXED_LEN, SCAN_REQ_HEAD_LEN, SCAN_CHAN_LEN, SCAN_TAIL_LEN,
    SCAN_GEN_PASS_ALL, SCAN_GEN_PASSIVE, SCAN_GEN_ITER_COMPLETE, SCAN_GEN_MULTIPLE_SSID, SCAN_FLAG_START_NOTIF,
    SCAN_COMPLETED, SCAN_ABORTED, SCAN_PROBE_BUF_LEN, SCAN_MAX_CHANNELS,
    mvm_scan_cfg, mvm_scan_req, mvm_scan_chan, mvm_scan_tail, mvm_scan_abort, mvm_scan_complete_uid, mvm_scan_complete_status
}

const CMD_SCAN_CFG: u64 = 0x0C
const CMD_SCAN_REQ_UMAC: u64 = 0x0D
const CMD_SCAN_ABORT_UMAC: u64 = 0x0E
const CMD_SCAN_COMPLETE_UMAC: u64 = 0x0F
const CMD_SCAN_ITER_COMPLETE_UMAC: u64 = 0xB5

const SCAN_CFG_ACTIVATE: u64 = 0x1
const SCAN_CFG_SET_TX_CHAINS: u64 = 0x100
const SCAN_CFG_SET_RX_CHAINS: u64 = 0x200
const SCAN_CFG_SET_ALL_TIMES: u64 = 0x800
const SCAN_CFG_SET_CHANNEL_FLAGS: u64 = 0x2000
const SCAN_CFG_SET_LEGACY_RATES: u64 = 0x4000
const SCAN_CFG_SET_MAC_ADDR: u64 = 0x8000

const SCAN_GEN_PASS_ALL: u64 = 0x4
const SCAN_GEN_PASSIVE: u64 = 0x8
const SCAN_GEN_ITER_COMPLETE: u64 = 0x20
const SCAN_GEN_MULTIPLE_SSID: u64 = 0x40
const SCAN_FLAG_START_NOTIF: u64 = 0x2

const SCAN_COMPLETED: u64 = 1
const SCAN_ABORTED: u64 = 2

const SCAN_CFG_FIXED_LEN: u64 = iwl_buf.HDR + 36
const SCAN_REQ_HEAD_LEN: u64 = iwl_buf.HDR + 36
const SCAN_CHAN_LEN: u64 = 8
const SCAN_PROBE_BUF_LEN: u64 = 512
const SCAN_DIRECT_LEN: u64 = 34
const SCAN_DIRECT_MAX: u64 = 20
const SCAN_TAIL_LEN: u64 = 8 + 4 + 4 + 8 + 4 + SCAN_PROBE_BUF_LEN + (SCAN_DIRECT_LEN * SCAN_DIRECT_MAX)
const SCAN_MAX_CHANNELS: u64 = 40

fn mvm_scan_cfg(a: u64, qid: u64, slot: u64, flags: u64, tx_chains: u64, rx_chains: u64, rates: u64, ooc_time: u64, suspend: u64,
                dwell_active: u64, dwell_passive: u64, dwell_frag: u64, dwell_ext: u64, mac: u64, bcast_sta: u64,
                chan_flags: u64, chans: u64, nchan: u64) -> u64 {
    let h: u64 = iwl_buf.HDR
    iwl_buf.zero(a, SCAN_CFG_FIXED_LEN + nchan)
    iwl_buf.hdr(a, CMD_SCAN_CFG, qid, slot)
    iwl_buf.st32(a, h, flags | (nchan << 26))
    iwl_buf.st32(a, h + 4, tx_chains)
    iwl_buf.st32(a, h + 8, rx_chains)
    iwl_buf.st32(a, h + 12, rates)
    iwl_buf.st32(a, h + 16, ooc_time)
    iwl_buf.st32(a, h + 20, suspend)
    iwl_buf.st8(a, h + 24, dwell_active)
    iwl_buf.st8(a, h + 25, dwell_passive)
    iwl_buf.st8(a, h + 26, dwell_frag)
    iwl_buf.st8(a, h + 27, dwell_ext)
    var i: u64 = 0
    while i < 6 {
        iwl_buf.st8(a, h + 28 + i, iwl_buf.ld8(mac, i))
        i = i + 1
    }
    iwl_buf.st8(a, h + 34, bcast_sta)
    iwl_buf.st8(a, h + 35, chan_flags)
    i = 0
    while i < nchan {
        iwl_buf.st8(a, h + 36 + i, iwl_buf.ld8(chans, i))
        i = i + 1
    }
    return SCAN_CFG_FIXED_LEN + nchan
}

fn mvm_scan_req(a: u64, qid: u64, slot: u64, flags: u64, uid: u64, ooc_priority: u64, general_flags: u64, start_mac_id: u64,
                dwell_ext: u64, dwell_active: u64, dwell_passive: u64, dwell_frag: u64, max_out: u64, suspend: u64,
                priority: u64, chan_flags: u64, nchan: u64) -> u64 {
    let h: u64 = iwl_buf.HDR
    iwl_buf.zero(a, SCAN_REQ_HEAD_LEN + (nchan * SCAN_CHAN_LEN) + SCAN_TAIL_LEN)
    iwl_buf.hdr(a, CMD_SCAN_REQ_UMAC, qid, slot)
    iwl_buf.st32(a, h, flags)
    iwl_buf.st32(a, h + 4, uid)
    iwl_buf.st32(a, h + 8, ooc_priority)
    iwl_buf.st16(a, h + 12, general_flags)
    iwl_buf.st8(a, h + 15, start_mac_id)
    iwl_buf.st8(a, h + 16, dwell_ext)
    iwl_buf.st8(a, h + 17, dwell_active)
    iwl_buf.st8(a, h + 18, dwell_passive)
    iwl_buf.st8(a, h + 19, dwell_frag)
    iwl_buf.st32(a, h + 20, max_out)
    iwl_buf.st32(a, h + 24, suspend)
    iwl_buf.st32(a, h + 28, priority)
    iwl_buf.st8(a, h + 32, chan_flags)
    iwl_buf.st8(a, h + 33, nchan)
    return SCAN_REQ_HEAD_LEN + (nchan * SCAN_CHAN_LEN) + SCAN_TAIL_LEN
}

fn mvm_scan_chan(a: u64, idx: u64, flags: u64, channel: u64, iter_count: u64, iter_interval: u64) {
    let o: u64 = SCAN_REQ_HEAD_LEN + (idx * SCAN_CHAN_LEN)
    iwl_buf.st32(a, o, flags)
    iwl_buf.st8(a, o + 4, channel)
    iwl_buf.st8(a, o + 5, iter_count)
    iwl_buf.st16(a, o + 6, iter_interval)
}

fn seg(a: u64, o: u64, offset: u64, len: u64) {
    iwl_buf.st16(a, o, offset)
    iwl_buf.st16(a, o + 2, len)
}

fn mvm_scan_tail(a: u64, nchan: u64, delay: u64, sched_interval: u64, sched_iters: u64, preq: u64,
                 mh: u64, b0: u64, b1: u64, cm: u64, ssid: u64, ssid_len: u64) {
    let t: u64 = SCAN_REQ_HEAD_LEN + (nchan * SCAN_CHAN_LEN)
    iwl_buf.st16(a, t, sched_interval)
    iwl_buf.st8(a, t + 2, sched_iters)
    iwl_buf.st16(a, t + 8, delay)
    seg(a, t + 12, 0, mh)
    seg(a, t + 16, mh, b0)
    seg(a, t + 20, mh + b0, b1)
    seg(a, t + 24, mh + b0 + b1, cm)
    let total: u64 = mh + b0 + b1 + cm
    var i: u64 = 0
    while i < total {
        iwl_buf.st8(a, t + 28 + i, iwl_buf.ld8(preq, i))
        i = i + 1
    }
    if ssid_len != 0 {
        let d: u64 = t + 28 + SCAN_PROBE_BUF_LEN
        iwl_buf.st8(a, d, 0)
        iwl_buf.st8(a, d + 1, ssid_len)
        i = 0
        while i < ssid_len {
            iwl_buf.st8(a, d + 2 + i, iwl_buf.ld8(ssid, i))
            i = i + 1
        }
    }
}

fn mvm_scan_abort(a: u64, qid: u64, slot: u64, uid: u64) -> u64 {
    iwl_buf.zero(a, iwl_buf.HDR + 8)
    iwl_buf.hdr(a, CMD_SCAN_ABORT_UMAC, qid, slot)
    iwl_buf.st32(a, iwl_buf.HDR, uid)
    return iwl_buf.HDR + 8
}

fn mvm_scan_complete_uid(p: u64) -> u64 { return iwl_buf.ld32(p, iwl_buf.HDR) }
fn mvm_scan_complete_status(p: u64) -> u64 { return iwl_buf.ld8(p, iwl_buf.HDR + 6) }
