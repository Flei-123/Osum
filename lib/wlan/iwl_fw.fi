// SPDX-License-Identifier: GPL-2.0-only
// lib/wlan/iwl_fw.fi -- iwlwifi firmware (.ucode) TLV parser + section splitter (W-AX201 M3 prep).
//
// Input: the blob in memory (the file is NOT in the repo, see docs/WLAN-AX201.md section 3).
// Output: FwInfo = flags/api/capa words + the SEC_RT and SEC_INIT section lists, each section
// classified LMAC (CPU1) / UMAC (CPU2) / PAGING by the two separator markers, exactly the split
// the Linux loader (pcie/ctxt-info.c iwl_pcie_init_fw_sec) uses. Never reads outside [blob, blob+len).
//
// TLV type numbers and the separator values are from memory of iwl-fw-file.h / iwl-drv.c: they
// are checked against the real blob only when WLAN_AX201_FW is given (tools/wlan/iwlfw.sh); the
// synthetic gate checks the parser against ITSELF (it proves bounds + classification logic, not
// that Intel uses these numbers). No allocator, no syscall.

export {
    FwInfo, fwinfo_new, fw_parse, fw_sec_count, fw_sec_off, fw_sec_len, fw_sec_addr, fw_sec_kind,
    fw_kind_count, fw_has_api, fw_has_capa, fw_cmd_ver, fw_notif_ver, fw_calib_ev, fw_calib_fl, fw_tx_ant, fw_rx_ant, CALIB_REGULAR, CALIB_INIT, TLV_N_SCAN_CHANNELS,
    TLV_DEF_CALIB, TLV_CMD_VERSIONS,
    IMG_RT, IMG_INIT, KIND_LMAC, KIND_UMAC, KIND_PAGING, SEC_MAX,
    SEP_CPU, SEP_PAGING,
    TLV_FLAGS, TLV_SEC_RT, TLV_SEC_INIT, TLV_SEC_WOWLAN, TLV_PHY_SKU, TLV_NUM_OF_CPU,
    TLV_API_CHANGES_SET, TLV_ENABLED_CAPABILITIES, TLV_PAGING, TLV_FW_VERSION, TLV_IML,
    E_FW_HDR, E_FW_TLV, E_FW_SEC, E_FW_NORT
}

const IMG_RT: usize = 0
const IMG_INIT: usize = 1
const CALIB_REGULAR: u64 = 0
const CALIB_INIT: u64 = 1
const KIND_LMAC: u64 = 0
const KIND_UMAC: u64 = 1
const KIND_PAGING: u64 = 2
const SEC_MAX: usize = 32          // per image (Linux IWL_UCODE_SECTION_MAX is 16 + 2 separators)

const SEP_CPU: u64 = 0xFFFFCCCC    // CPU1_CPU2_SEPARATOR_SECTION
const SEP_PAGING: u64 = 0xAAAABBBB // PAGING_SEPARATOR_SECTION

const TLV_FLAGS: u64 = 18
const TLV_SEC_RT: u64 = 19
const TLV_SEC_INIT: u64 = 20
const TLV_SEC_WOWLAN: u64 = 21
const TLV_DEF_CALIB: u64 = 22
const TLV_PHY_SKU: u64 = 23
const TLV_NUM_OF_CPU: u64 = 27
const TLV_API_CHANGES_SET: u64 = 29
const TLV_ENABLED_CAPABILITIES: u64 = 30
const TLV_N_SCAN_CHANNELS: u64 = 31
const TLV_PAGING: u64 = 32
const TLV_FW_VERSION: u64 = 37
const TLV_CMD_VERSIONS: u64 = 48
const TLV_IML: u64 = 52

const E_FW_HDR: i64 = -10   // bad magic / too short
const E_FW_TLV: i64 = -11   // TLV runs past the end
const E_FW_SEC: i64 = -12   // section TLV shorter than its 4-octet address, or too many sections
const E_FW_NORT: i64 = -13  // no runtime (SEC_RT) section at all

struct FwInfo {
    ver: u64,
    n_tlv: u64,
    flags: u64,
    phy_sku: u64,
    calib_ev: [u64; 3],
    calib_fl: [u64; 3],
    num_cpu: u64,
    api0: u64,          // API_CHANGES_SET with api_index 0 (OR of all such TLVs)
    capa0: u64,         // ENABLED_CAPABILITIES with api_index 0
    n_scan_ch: u64,
    cmd_ver: [u8; 256],
    notif_ver: [u8; 256],
    paging_size: u64,   // TLV_PAGING (le32 paging block size)
    iml_off: u64,       // blob offset of the IML TLV data, 0 = none
    iml_len: u64,
    n_sec: [u64; 2],            // sections per image
    n_kind: [u64; 6],           // [img * 3 + kind]
    s_off: [u64; 64],           // [img * SEC_MAX + i] blob offset of section DATA (after the address word)
    s_len: [u64; 64],           // data length
    s_addr: [u64; 64],          // device address word
    s_kind: [u64; 64]
}

fn fwinfo_new() -> FwInfo {
    var f: FwInfo = FwInfo {
        ver: 0, n_tlv: 0, flags: 0, phy_sku: 0, calib_ev: [0; 3], calib_fl: [0; 3], num_cpu: 0, api0: 0, capa0: 0, n_scan_ch: 0, cmd_ver: [0; 256], notif_ver: [0; 256], paging_size: 0,
        iml_off: 0, iml_len: 0, n_sec: [0; 2], n_kind: [0; 6],
        s_off: [0; 64], s_len: [0; 64], s_addr: [0; 64], s_kind: [0; 64]
    }
    return f
}

fn ld8(p: u64, o: usize) -> u64 {
    let b: u8 = *((p + o as u64) as *mut u8)
    return b as u64
}

fn ld32(p: u64, o: usize) -> u64 {
    return ld8(p, o) | (ld8(p, o + 1) << 8) | (ld8(p, o + 2) << 16) | (ld8(p, o + 3) << 24)
}

// Append one section of image `img`. phase is advanced by the separators (0 LMAC, 1 UMAC, 2 PAGING).
fn add_sec(f: *mut FwInfo, img: usize, phase: *mut u64, data: usize, l: u64, blob: u64) -> i64 {
    if l < 4 { return E_FW_SEC }
    let addr: u64 = ld32(blob, data)
    if addr == SEP_CPU {
        if *phase == 0 { *phase = 1 }
        return 0
    }
    if addr == SEP_PAGING {
        *phase = 2
        return 0
    }
    let n: usize = (*f).n_sec[img] as usize
    if n >= SEC_MAX { return E_FW_SEC }
    let k: usize = img * SEC_MAX + n
    (*f).s_off[k] = (data + 4) as u64
    (*f).s_len[k] = l - 4
    (*f).s_addr[k] = addr
    (*f).s_kind[k] = *phase
    (*f).n_sec[img] = (n + 1) as u64
    let kk: usize = img * 3 + (*phase) as usize
    (*f).n_kind[kk] = (*f).n_kind[kk] + 1
    return 0
}

// Parse the whole container. Returns 0 or E_FW_*. `f` is only meaningful on 0.
fn fw_parse(blob: u64, len: usize, f: *mut FwInfo) -> i64 {
    if len < 80 { return E_FW_HDR }
    if ld32(blob, 0) != 0 || ld32(blob, 4) != 0x0A4C5749 { return E_FW_HDR }
    *f = fwinfo_new()
    (*f).ver = ld32(blob, 72)
    var ph_rt: u64 = 0
    var ph_in: u64 = 0
    var o: usize = 80
    while o < len {
        if len - o < 8 { return E_FW_TLV }
        let t: u64 = ld32(blob, o)
        let l: u64 = ld32(blob, o + 4)
        let padded: u64 = (l + 3) & 0xFFFFFFFC
        if padded > (len - o - 8) as u64 { return E_FW_TLV }
        let d: usize = o + 8
        if t == TLV_SEC_RT {
            let r: i64 = add_sec(f, IMG_RT, &ph_rt, d, l, blob)
            if r != 0 { return r }
        } else if t == TLV_SEC_INIT {
            let r2: i64 = add_sec(f, IMG_INIT, &ph_in, d, l, blob)
            if r2 != 0 { return r2 }
        } else if t == TLV_FLAGS && l >= 4 {
            (*f).flags = ld32(blob, d)
        } else if t == TLV_PHY_SKU && l >= 4 {
            (*f).phy_sku = ld32(blob, d)
        } else if t == TLV_DEF_CALIB && l >= 12 {
            let ct: u64 = ld32(blob, d)
            if ct < 3 {
                (*f).calib_ev[ct as usize] = ld32(blob, d + 4)
                (*f).calib_fl[ct as usize] = ld32(blob, d + 8)
            }
        } else if t == TLV_NUM_OF_CPU && l >= 4 {
            (*f).num_cpu = ld32(blob, d)
        } else if t == TLV_PAGING && l >= 4 {
            (*f).paging_size = ld32(blob, d)
        } else if t == TLV_API_CHANGES_SET && l >= 8 {
            if ld32(blob, d) == 0 { (*f).api0 = (*f).api0 | ld32(blob, d + 4) }
        } else if t == TLV_ENABLED_CAPABILITIES && l >= 8 {
            if ld32(blob, d) == 0 { (*f).capa0 = (*f).capa0 | ld32(blob, d + 4) }
        } else if t == TLV_N_SCAN_CHANNELS && l >= 4 {
            (*f).n_scan_ch = ld32(blob, d)
        } else if t == TLV_CMD_VERSIONS {
            var q: u64 = 0
            while q + 4 <= l {
                if ld8(blob, d + q as usize) == 0 {
                    let c: usize = ld8(blob, d + q as usize + 1) as usize
                    (*f).cmd_ver[c] = (ld8(blob, d + q as usize + 2) + 1) as u8
                    (*f).notif_ver[c] = (ld8(blob, d + q as usize + 3) + 1) as u8
                }
                q = q + 4
            }
        } else if t == TLV_IML {
            (*f).iml_off = d as u64
            (*f).iml_len = l
        }
        (*f).n_tlv = (*f).n_tlv + 1
        o = d + padded as usize
    }
    if (*f).n_sec[IMG_RT] == 0 { return E_FW_NORT }
    return 0
}

fn fw_sec_count(f: *mut FwInfo, img: usize) -> usize { return (*f).n_sec[img] as usize }
fn fw_sec_off(f: *mut FwInfo, img: usize, i: usize) -> u64 { return (*f).s_off[img * SEC_MAX + i] }
fn fw_sec_len(f: *mut FwInfo, img: usize, i: usize) -> u64 { return (*f).s_len[img * SEC_MAX + i] }
fn fw_sec_addr(f: *mut FwInfo, img: usize, i: usize) -> u64 { return (*f).s_addr[img * SEC_MAX + i] }
fn fw_sec_kind(f: *mut FwInfo, img: usize, i: usize) -> u64 { return (*f).s_kind[img * SEC_MAX + i] }
fn fw_kind_count(f: *mut FwInfo, img: usize, kind: u64) -> u64 { return (*f).n_kind[img * 3 + kind as usize] }
fn fw_has_api(f: *mut FwInfo, bit: u64) -> bool { return bit < 32 && ((*f).api0 >> bit) & 1 == 1 }
fn fw_has_capa(f: *mut FwInfo, bit: u64) -> bool { return bit < 32 && ((*f).capa0 >> bit) & 1 == 1 }
fn fw_cmd_ver(f: *mut FwInfo, cmd: u64) -> i64 { return ((*f).cmd_ver[(cmd & 0xFF) as usize] as i64) - 1 }
fn fw_notif_ver(f: *mut FwInfo, cmd: u64) -> i64 { return ((*f).notif_ver[(cmd & 0xFF) as usize] as i64) - 1 }
fn fw_calib_ev(f: *mut FwInfo, ucode_type: u64) -> u64 {
    if ucode_type >= 3 { return 0 }
    return (*f).calib_ev[ucode_type as usize]
}
fn fw_calib_fl(f: *mut FwInfo, ucode_type: u64) -> u64 {
    if ucode_type >= 3 { return 0 }
    return (*f).calib_fl[ucode_type as usize]
}
fn fw_tx_ant(f: *mut FwInfo) -> u64 { return ((*f).phy_sku >> 16) & 0xF }
fn fw_rx_ant(f: *mut FwInfo) -> u64 { return ((*f).phy_sku >> 20) & 0xF }
