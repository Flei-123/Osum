// SPDX-License-Identifier: GPL-2.0-only
// lib/wlan/scanfmt.fi -- scan results as text lines (for /proc/wlan, `wlan scan`), chip independent.
//
// One line per network found in a connect.Sitzung:   "<ssid> ch=<n> sec=<name> rssi=<dBm>\n"
// The SSID comes from the air, so it is untrusted: every octet outside 0x21..0x7E becomes '?'
// (a newline or a space in an SSID must not forge a second line or a second field), and the
// output never goes past `cap`. Returns the number of octets written (no terminator).

import wlan.connect
import wlan.beacon

export { scan_lines }

fn put8(out: u64, i: usize, c: u64) {
    *((out + i as u64) as *mut u8) = (c & 255) as u8
}

// Writes `s` (zero-terminated literal pointer) at out[n..]; returns the new length.
fn put_str(out: u64, n: usize, cap: usize, s: u64) -> usize {
    var k: usize = n
    var i: usize = 0
    while true {
        let c: u8 = *((s + i as u64) as *mut u8)
        if c == 0 { break }
        if k >= cap { return k }
        put8(out, k, c as u64)
        k = k + 1
        i = i + 1
    }
    return k
}

fn put_dec(out: u64, n: usize, cap: usize, v: u64) -> usize {
    var tmp: [u8; 20] = [0; 20]
    var t: usize = 0
    var x: u64 = v
    if x == 0 {
        tmp[0] = 48
        t = 1
    }
    while x > 0 {
        tmp[t] = (48 + (x % 10)) as u8
        x = x / 10
        t = t + 1
    }
    var k: usize = n
    while t > 0 {
        t = t - 1
        if k >= cap { return k }
        put8(out, k, tmp[t] as u64)
        k = k + 1
    }
    return k
}


fn scan_lines(s: *mut connect.Session, out: u64, cap: usize) -> usize {
    var open: [u8; 5] = "open\0"
    var wep: [u8; 4] = "wep\0"
    var wpa: [u8; 4] = "wpa\0"
    var wpa2: [u8; 5] = "wpa2\0"
    var trans: [u8; 11] = "wpa2+wpa3\0\0"
    var wpa3: [u8; 5] = "wpa3\0"
    var owe: [u8; 4] = "owe\0"
    var unk: [u8; 8] = "unknown\0"
    var l_ch: [u8; 5] = " ch=\0"
    var l_sec: [u8; 6] = " sec=\0"
    var l_rssi: [u8; 7] = " rssi=\0"
    var l_neg: [u8; 2] = "-\0"
    var nm: [u8; 33] = [0; 33]
    var n: usize = 0
    var k: usize = 0
    while k < connect.net_count(s) {
        let sl: usize = connect.net_ssid_len(s, k)
        let _g: bool = connect.net_ssid_get(s, k, (&nm[0]) as u64)
        // keep a whole line or none: need room for ssid + the longest tail (" ch=255 sec=wpa2+wpa3 rssi=-127\n" = 33)
        if n + sl + 40 > cap { break }
        var i: usize = 0
        while i < sl {
            var c: u64 = nm[i] as u64
            if c < 0x21 || c > 0x7E { c = 63 }
            put8(out, n, c)
            n = n + 1
            i = i + 1
        }
        n = put_str(out, n, cap, (&l_ch[0]) as u64)
        n = put_dec(out, n, cap, connect.net_channel_of(s, k))
        n = put_str(out, n, cap, (&l_sec[0]) as u64)
        let sc: u64 = connect.net_security_of(s, k)
        if sc == beacon.SELF_OPEN {
            n = put_str(out, n, cap, (&open[0]) as u64)
        } else if sc == beacon.SELF_WEP {
            n = put_str(out, n, cap, (&wep[0]) as u64)
        } else if sc == beacon.SELF_WPA {
            n = put_str(out, n, cap, (&wpa[0]) as u64)
        } else if sc == beacon.SELF_WPA2 {
            n = put_str(out, n, cap, (&wpa2[0]) as u64)
        } else if sc == beacon.SELF_UEBERGANG {
            n = put_str(out, n, cap, (&trans[0]) as u64)
        } else if sc == beacon.SELF_WPA3 {
            n = put_str(out, n, cap, (&wpa3[0]) as u64)
        } else if sc == beacon.SELF_OWE {
            n = put_str(out, n, cap, (&owe[0]) as u64)
        } else {
            n = put_str(out, n, cap, (&unk[0]) as u64)
        }
        n = put_str(out, n, cap, (&l_rssi[0]) as u64)
        let r: i64 = connect.net_rssi_of(s, k)
        if r < 0 {
            n = put_str(out, n, cap, (&l_neg[0]) as u64)
            n = put_dec(out, n, cap, (0 - r) as u64)
        } else {
            n = put_dec(out, n, cap, r as u64)
        }
        put8(out, n, 10)
        n = n + 1
        k = k + 1
    }
    return n
}
