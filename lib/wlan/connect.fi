// ==================================================================
// WAS HIER ZUSAMMENKOMMT
// ==================================================================

import wlan.device
import wlan.frame
import wlan.beacon
import wlan.wpa
import wlan.ccmp
import wlan.state

export {
    Session, session_new, rx_key,
    suchlauf_beginnen, beacon_aufnehmen, net_count, net_ssid_len,
    net_ssid_get, net_channel_of, net_security_of, net_rssi_of,
    net_choose, chosen_of, auth_angenommen, assoz_angenommen,
    nachricht1_behandeln, nachricht3_behandeln,
    identity_set, pmk_set, akm_set,
    data_send, data_receive, trennen,
    is_connected, may_data, state_of, reason_from,
    F_KEIN, F_NO_DEVICE, F_TOO_SHORT, F_NICHT_UNSER, F_MIC, F_KEY,
    F_STATE, F_UNSICHER, F_FULL, F_CCMP,
    MAX_NETZE
}

const MAX_NETZE: usize = 8
const MAX_SSID: usize = 32
const MAX_FRAME: usize = 2400

const F_KEIN: u64 = 0
const F_NO_DEVICE: u64 = 1
const F_TOO_SHORT: u64 = 2
const F_NICHT_UNSER: u64 = 3
const F_MIC: u64 = 4
const F_KEY: u64 = 5
const F_STATE: u64 = 6
const F_UNSICHER: u64 = 7
const F_FULL: u64 = 8
const F_CCMP: u64 = 9

struct Session {
    lauf: state.Lauf,
    ssid: [u8; 256],          // MAX_NETZE * MAX_SSID
    ssid_len: [usize; 8],
    chan: [u64; 8],
    sicherheit: [u64; 8],
    rssi: [i64; 8],
    n_netze: usize,
    gewaehlt: i64,

    spa: [u8; 6],
    aa: [u8; 6],

    pmk: [u8; 32],
    ptk: [u8; 48],
    anonce: [u8; 32],
    snonce: [u8; 32],
    gtk: [u8; 16],
    gtk_len: usize,
    hat_ptk: bool,
    akm: u64,
    pn: [u8; 6],
    err_code: u64
}

fn session_new() -> Session {
    var s: Session = Session {
        lauf: state.lauf_new(),
        ssid: [0; 256], ssid_len: [0; 8], chan: [0; 8],
        sicherheit: [0; 8], rssi: [0; 8], n_netze: 0, gewaehlt: -1,
        spa: [0; 6], aa: [0; 6],
        pmk: [0; 32], ptk: [0; 48], anonce: [0; 32], snonce: [0; 32],
        gtk: [0; 16], gtk_len: 0, hat_ptk: false, akm: 0,
        pn: [0; 6], err_code: 0
    }
    return s
}

fn identity_set(s: *mut Session, spa: u64, aa: u64) {
    var i: usize = 0
    while i < 6 {
        (*s).spa[i] = *((spa + i as u64) as *mut u8)
        (*s).aa[i] = *((aa + i as u64) as *mut u8)
        i = i + 1
    }
}

fn pmk_set(s: *mut Session, pmk: u64) {
    var i: usize = 0
    while i < 32 {
        (*s).pmk[i] = *((pmk + i as u64) as *mut u8)
        i = i + 1
    }
}

fn akm_set(s: *mut Session, akm: u64) {
    (*s).akm = akm
}

fn ld8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn st8(p: u64, i: usize, v: u8) {
    *((p + i as u64) as *mut u8) = v
}

// ==================================================================
// SUCHLAUF
// ==================================================================

fn suchlauf_beginnen(s: *mut Session, g: *mut device.Device) -> bool {
    if !device.ready(g) {
        (*s).err_code = F_NO_DEVICE
        return false
    }
    (*s).n_netze = 0
    (*s).gewaehlt = -1
    state.begin(&(*s).lauf)
    state.event(&(*s).lauf, 115)   // 's'
    return true
}

fn beacon_aufnehmen(s: *mut Session, p: u64, n: usize, rssi: i64) -> bool {
    var b: beacon.Network = beacon.network_new()
    if !beacon.zerlege(&b, p, n) {
        (*s).err_code = F_TOO_SHORT
        return false
    }
    if b.ssid_len == 0 || b.ssid_len > MAX_SSID {
        return false
    }
    // Schon da?
    var k: usize = 0
    while k < (*s).n_netze {
        if (*s).ssid_len[k] == b.ssid_len {
            var equal: bool = true
            var i: usize = 0
            while i < b.ssid_len {
                if (*s).ssid[k * MAX_SSID + i] != b.ssid[i] {
                    equal = false
                }
                i = i + 1
            }
            if equal {
                if rssi > (*s).rssi[k] {
                    (*s).rssi[k] = rssi
                    (*s).chan[k] = b.chan
                }
                return true
            }
        }
        k = k + 1
    }
    if (*s).n_netze >= MAX_NETZE {
        (*s).err_code = F_FULL
        return false
    }
    let j: usize = (*s).n_netze
    var i2: usize = 0
    while i2 < b.ssid_len {
        (*s).ssid[j * MAX_SSID + i2] = b.ssid[i2]
        i2 = i2 + 1
    }
    (*s).ssid_len[j] = b.ssid_len
    (*s).chan[j] = b.chan
    (*s).sicherheit[j] = b.sicherheit
    (*s).rssi[j] = rssi
    (*s).n_netze = j + 1
    state.event(&(*s).lauf, 98)    // 'b'
    return true
}

fn net_count(s: *mut Session) -> usize { return (*s).n_netze }

fn net_ssid_len(s: *mut Session, k: usize) -> usize {
    if k >= (*s).n_netze { return 0 }
    return (*s).ssid_len[k]
}

fn net_ssid_get(s: *mut Session, k: usize, out: u64) -> bool {
    if k >= (*s).n_netze { return false }
    var i: usize = 0
    while i < (*s).ssid_len[k] {
        st8(out, i, (*s).ssid[k * MAX_SSID + i])
        i = i + 1
    }
    return true
}

fn net_channel_of(s: *mut Session, k: usize) -> u64 {
    if k >= (*s).n_netze { return 0 }
    return (*s).chan[k]
}

fn net_security_of(s: *mut Session, k: usize) -> u64 {
    if k >= (*s).n_netze { return 0 }
    return (*s).sicherheit[k]
}

fn net_rssi_of(s: *mut Session, k: usize) -> i64 {
    if k >= (*s).n_netze { return 0 }
    return (*s).rssi[k]
}

fn net_choose(s: *mut Session, g: *mut device.Device, k: usize) -> bool {
    if k >= (*s).n_netze {
        (*s).err_code = F_STATE
        return false
    }
    let sich: u64 = (*s).sicherheit[k]
    if sich != beacon.SELF_WPA2 && sich != beacon.SELF_WPA3
        && sich != beacon.SELF_UEBERGANG {
        (*s).err_code = F_UNSICHER
        return false
    }
    if device.channel_set(g, (*s).chan[k], 2) < 0 {
        (*s).err_code = F_NO_DEVICE
        return false
    }
    (*s).gewaehlt = k as i64
    return true
}

fn chosen_of(s: *mut Session) -> i64 { return (*s).gewaehlt }

fn auth_angenommen(s: *mut Session, angenommen: bool) {
    if angenommen {
        state.event(&(*s).lauf, 97)    // 'a'
    } else {
        state.event(&(*s).lauf, 65)    // 'A'
    }
}

fn assoz_angenommen(s: *mut Session, angenommen: bool) {
    if angenommen {
        state.event(&(*s).lauf, 99)    // 'c'
    } else {
        state.event(&(*s).lauf, 67)    // 'C'
    }
}

// ==================================================================
// DER HANDSCHLAG
// ==================================================================

fn nachricht1_behandeln(s: *mut Session, g: *mut device.Device,
    eapol: u64, elen: usize, snonce: u64,
    aus: u64, ausmax: usize) -> i64 {
    var e: wpa.Eapol = wpa.eapol_new()
    if !wpa.eapol_zerlege(&e, eapol, elen) {
        (*s).err_code = F_TOO_SHORT
        return -1
    }
    if !e.paarweise || !e.ack || e.hat_mic {
        (*s).err_code = F_NICHT_UNSER
        return -1
    }
    var i: usize = 0
    while i < 32 {
        (*s).anonce[i] = ld8(e.nonce, i)
        (*s).snonce[i] = ld8(snonce, i)
        i = i + 1
    }
    if !wpa.ptk_ableiten((&(*s).pmk[0]) as u64, 32,
        (&(*s).aa[0]) as u64, (&(*s).spa[0]) as u64,
        (&(*s).anonce[0]) as u64, (&(*s).snonce[0]) as u64,
        (*s).akm, (&(*s).ptk[0]) as u64, 48) {
        (*s).err_code = F_KEY
        return -1
    }
    (*s).hat_ptk = true
    state.event(&(*s).lauf, 49)    // '1'
    state.event(&(*s).lauf, 50)    // '2'
    return 48
}

fn nachricht3_behandeln(s: *mut Session, g: *mut device.Device,
    eapol: u64, elen: usize) -> bool {
    if !(*s).hat_ptk {
        (*s).err_code = F_STATE
        return false
    }
    var e: wpa.Eapol = wpa.eapol_new()
    if !wpa.eapol_zerlege(&e, eapol, elen) {
        (*s).err_code = F_TOO_SHORT
        return false
    }
    if !wpa.mic_check((&(*s).ptk[0]) as u64, 16, eapol, elen, (*s).akm) {
        // The frame is dropped, the run is NOT touched: anybody on the air can forge a
        // message 3, and a forged one must not abort a handshake in progress (the real
        // message 3 can still arrive; the machine stays in its state).
        (*s).err_code = F_MIC
        return false
    }
    var payload: [u8; 512] = [0; 512]
    let dn: i64 = wpa.key_data_unwrap(
        (&(*s).ptk[16]) as u64, 16,
        e.data, e.data_len,
        (&payload[0]) as u64, 512)
    if dn < 0 {
        (*s).err_code = F_KEY
        return false
    }
    var number: u64 = 0
    let gl: i64 = wpa.gtk_find((&payload[0]) as u64, dn as usize,
        (&(*s).gtk[0]) as u64, 16, &number)
    if gl < 0 {
        (*s).err_code = F_KEY
        return false
    }
    (*s).gtk_len = gl as usize
    state.event(&(*s).lauf, 51)    // '3'

    if device.key_set(g, device.KEY_PTK, 0,
        (&(*s).ptk[32]) as u64, 16) < 0 {
        (*s).err_code = F_NO_DEVICE
        return false
    }
    if device.key_set(g, device.KEY_GTK, number,
        (&(*s).gtk[0]) as u64, (*s).gtk_len) < 0 {
        (*s).err_code = F_NO_DEVICE
        return false
    }
    state.event(&(*s).lauf, 52)    // '4'
    return true
}

// ==================================================================
// DATEN
// ==================================================================

fn data_send(s: *mut Session, g: *mut device.Device,
    frame_buf: u64, rlen: usize, buffer: u64, pmax: usize) -> i64 {
    if !state.may_pass_data(&(*s).lauf) {
        (*s).err_code = F_STATE
        return -1
    }
    // Die Paketnummer hochzaehlen, hoechstwertig zuerst.
    var i: i64 = 5
    while i >= 0 {
        let v: u64 = ((*s).pn[i as usize] as u64) + 1
        (*s).pn[i as usize] = (v & 255) as u8
        if v < 256 { i = -1 } else { i = i - 1 }
    }
    if device.kann_ccmp_von(g) {
        return device.send(g, frame_buf, rlen)
    }
    let n: i64 = ccmp.protect((&(*s).ptk[32]) as u64,
        (&(*s).pn[0]) as u64, frame_buf, rlen, buffer, pmax)
    if n < 0 {
        (*s).err_code = F_CCMP
        return -1
    }
    return device.send(g, buffer, n as usize)
}

fn rx_key(s: *mut Session, p: u64) -> u64 {
    if (ld8(p, 4) & 1) == 0 { return (&(*s).ptk[32]) as u64 }
    if (*s).gtk_len < 16 { return 0 }
    return (&(*s).gtk[0]) as u64
}

fn data_receive(s: *mut Session, g: *mut device.Device,
    buf: u64, bufmax: usize, out: u64, outmax: usize) -> i64 {
    let n: i64 = device.receive(g, buf, bufmax)
    if n <= 0 { return n }
    if !state.may_pass_data(&(*s).lauf) {
        (*s).err_code = F_STATE
        return -1
    }
    if device.kann_ccmp_von(g) {
        var i: usize = 0
        while i < (n as usize) && i < outmax {
            st8(out, i, ld8(buf, i))
            i = i + 1
        }
        return n
    }
    let tk: u64 = rx_key(s, buf)
    if tk == 0 { return -1 }
    let m: i64 = ccmp.unprotect(tk, buf,
        n as usize, out, outmax)
    if m < 0 {
        (*s).err_code = F_CCMP
        return -1
    }
    return m
}

fn trennen(s: *mut Session, g: *mut device.Device) {
    device.key_set(g, device.KEY_OFF, 0, 0, 0)
    state.event(&(*s).lauf, 100)   // 'd'
    (*s).hat_ptk = false
    (*s).gtk_len = 0
    var i: usize = 0
    while i < 48 {
        (*s).ptk[i] = 0 as u8
        i = i + 1
    }
    i = 0
    while i < 16 {
        (*s).gtk[i] = 0 as u8
        i = i + 1
    }
}

fn is_connected(s: *mut Session) -> bool {
    return state.verbunden(&(*s).lauf)
}

fn may_data(s: *mut Session) -> bool {
    return state.may_pass_data(&(*s).lauf)
}

fn state_of(s: *mut Session) -> u64 { return (*s).lauf.machine_state }
fn reason_from(s: *mut Session) -> u64 { return (*s).err_code }
