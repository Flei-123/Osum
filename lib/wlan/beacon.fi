
import wlan.frame

export {
    Network, network_new, zerlege, rssi_set, set_band,
    SELF_OPEN, SELF_WEP, SELF_WPA, SELF_WPA2, SELF_UEBERGANG,
    SELF_WPA3, SELF_OWE,
    CH_KEINE, CH_WEP40, CH_TKIP, CH_CCMP128, CH_WEP104, CH_BIP,
    CH_GCMP128, CH_GCMP256, CH_CCMP256,
    AKM_8021X, AKM_PSK, AKM_FT_8021X, AKM_FT_PSK, AKM_8021X_SHA256,
    AKM_PSK_SHA256, AKM_SAE, AKM_FT_SAE, AKM_OWE,
    PMF_NEIN, PMF_FAEHIG, PMF_PFLICHT,
    SSID_MAX
}

const SSID_MAX: usize = 32

const SELF_OPEN: u64 = 0
const SELF_WEP: u64 = 1
const SELF_WPA: u64 = 2
const SELF_WPA2: u64 = 3
const SELF_UEBERGANG: u64 = 4 // WPA2 und WPA3 nebeneinander
const SELF_WPA3: u64 = 5
const SELF_OWE: u64 = 6

// Chiffren, IEEE 802.11-2016 Tabelle 9-131, OUI 00-0F-AC.
const CH_KEINE: u64 = 0 // "nimm die Gruppenchiffre"
const CH_WEP40: u64 = 1
const CH_TKIP: u64 = 2
const CH_CCMP128: u64 = 4
const CH_WEP104: u64 = 5
const CH_BIP: u64 = 6
const CH_GCMP128: u64 = 8
const CH_GCMP256: u64 = 9
const CH_CCMP256: u64 = 10

// Anmeldeverfahren, Tabelle 9-133.
const AKM_8021X: u64 = 1
const AKM_PSK: u64 = 2
const AKM_FT_8021X: u64 = 3
const AKM_FT_PSK: u64 = 4
const AKM_8021X_SHA256: u64 = 5
const AKM_PSK_SHA256: u64 = 6
const AKM_SAE: u64 = 8
const AKM_FT_SAE: u64 = 9
const AKM_OWE: u64 = 18

const PMF_NEIN: u64 = 0
const PMF_FAEHIG: u64 = 1
const PMF_PFLICHT: u64 = 2

struct Network {
    bssid: [u8; 6],
    ssid: [u8; 32],
    ssid_len: usize,
    ssid_verborgen: bool,
    chan: u64,
    band: u64,
    intervall: u64,
    faehigkeiten: u64,
    sicherheit: u64,
    paar_chiffre: u64,
    gruppen_chiffre: u64,
    akm: u64,
    pmf: u64,
    hat_rsn: bool,
    hat_wpa: bool,
    rssi: i64,
}

fn network_new() -> Network {
    return Network { bssid: [0 as u8; 6], ssid: [0 as u8; 32],
        ssid_len: 0, ssid_verborgen: true, chan: 0, band: 0,
        intervall: 0, faehigkeiten: 0, sicherheit: SELF_OPEN,
        paar_chiffre: CH_KEINE, gruppen_chiffre: CH_KEINE, akm: 0,
        pmf: PMF_NEIN, hat_rsn: false, hat_wpa: false, rssi: 0 }
}

fn ld8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn le16(p: u64, i: usize) -> u64 {
    return (ld8(p, i) as u64) | ((ld8(p, i + 1) as u64) << 8)
}

fn rssi_set(nz: *mut Network, dbm: i64) {
    (*nz).rssi = dbm
}

fn set_band(nz: *mut Network, band: u64) {
    (*nz).band = band
}

// Rueckgabe -1: fremde OUI.
fn waehler(p: u64, i: usize, oui0: u64, oui1: u64, oui2: u64) -> i64 {
    if (ld8(p, i) as u64) != oui0 { return -1 }
    if (ld8(p, i + 1) as u64) != oui1 { return -1 }
    if (ld8(p, i + 2) as u64) != oui2 { return -1 }
    return (ld8(p, i + 3) as u64) as i64
}

fn chiffre_rang(c: u64) -> u64 {
    if c == CH_GCMP256 { return 6 }
    if c == CH_CCMP256 { return 5 }
    if c == CH_GCMP128 { return 4 }
    if c == CH_CCMP128 { return 3 }
    if c == CH_TKIP { return 2 }
    if c == CH_WEP104 { return 1 }
    if c == CH_WEP40 { return 1 }
    return 0
}

fn akm_rang(a: u64) -> u64 {
    if a == AKM_SAE { return 6 }
    if a == AKM_FT_SAE { return 5 }
    if a == AKM_OWE { return 4 }
    if a == AKM_PSK_SHA256 { return 3 }
    if a == AKM_PSK { return 2 }
    if a == AKM_FT_PSK { return 2 }
    if a == AKM_8021X_SHA256 { return 1 }
    if a == AKM_8021X { return 1 }
    if a == AKM_FT_8021X { return 1 }
    return 0
}

// ==================================================================
// DAS RSN-ELEMENT, IEEE 802.11-2016 9.4.2.25
// ==================================================================
fn rsn_zerlege(nz: *mut Network, p: u64, n: usize) -> bool {
    if n < 2 {
        return false
    }
    if le16(p, 0) != 1 {
        return false
    }
    (*nz).hat_rsn = true
    var at: usize = 2

    (*nz).gruppen_chiffre = CH_CCMP128
    if at + 4 <= n {
        let g: i64 = waehler(p, at, 0, 0x0F, 0xAC)
        if g >= 0 {
            (*nz).gruppen_chiffre = g as u64
        }
        at = at + 4
    } else {
        return true
    }

    // Paarchiffren.
    (*nz).paar_chiffre = CH_CCMP128
    if at + 2 > n {
        return true
    }
    let pn: usize = le16(p, at) as usize
    at = at + 2
    if at + pn * 4 > n {
        return false // das Laengenfeld luegt
    }
    var best: u64 = 0
    var besti: u64 = CH_KEINE
    var i: usize = 0
    while i < pn {
        let c: i64 = waehler(p, at + i * 4, 0, 0x0F, 0xAC)
        if c >= 0 {
            let r: u64 = chiffre_rang(c as u64)
            if r > best {
                best = r
                besti = c as u64
            }
        }
        i = i + 1
    }
    if best > 0 {
        (*nz).paar_chiffre = besti
    }
    at = at + pn * 4

    // Anmeldeverfahren.
    if at + 2 > n {
        return true
    }
    let an: usize = le16(p, at) as usize
    at = at + 2
    if at + an * 4 > n {
        return false
    }
    var abest: u64 = 0
    var abesti: u64 = 0
    var hat_sae: bool = false
    var hat_psk: bool = false
    var hat_owe: bool = false
    i = 0
    while i < an {
        let a: i64 = waehler(p, at + i * 4, 0, 0x0F, 0xAC)
        if a >= 0 {
            let av: u64 = a as u64
            if av == AKM_SAE || av == AKM_FT_SAE { hat_sae = true }
            if av == AKM_PSK || av == AKM_PSK_SHA256
                || av == AKM_FT_PSK { hat_psk = true }
            if av == AKM_OWE { hat_owe = true }
            let r: u64 = akm_rang(av)
            if r > abest {
                abest = r
                abesti = av
            }
        }
        i = i + 1
    }
    (*nz).akm = abesti
    at = at + an * 4

    // RSN-Faehigkeiten: Bit 6 heisst "kann geschuetzte
    // Verwaltungsrahmen", Bit 7 heisst "verlangt sie".
    if at + 2 <= n {
        let cap: u64 = le16(p, at)
        if (cap & 128) != 0 {
            (*nz).pmf = PMF_PFLICHT
        } else {
            if (cap & 64) != 0 {
                (*nz).pmf = PMF_FAEHIG
            }
        }
        at = at + 2
    }

    if hat_owe {
        (*nz).sicherheit = SELF_OWE
    } else {
        if hat_sae && hat_psk {
            (*nz).sicherheit = SELF_UEBERGANG
        } else {
            if hat_sae {
                (*nz).sicherheit = SELF_WPA3
            } else {
                (*nz).sicherheit = SELF_WPA2
            }
        }
    }
    return true
}

fn wpa_zerlege(nz: *mut Network, p: u64, n: usize) -> bool {
    if n < 2 {
        return false
    }
    if le16(p, 0) != 1 {
        return false
    }
    (*nz).hat_wpa = true
    var at: usize = 2
    if at + 4 <= n {
        let g: i64 = waehler(p, at, 0, 0x50, 0xF2)
        if g >= 0 {
            (*nz).gruppen_chiffre = g as u64
        }
        at = at + 4
    }
    if at + 2 <= n {
        let pn: usize = le16(p, at) as usize
        at = at + 2
        if at + pn * 4 > n {
            return false
        }
        var best: u64 = 0
        var besti: u64 = CH_KEINE
        var i: usize = 0
        while i < pn {
            let c: i64 = waehler(p, at + i * 4, 0, 0x50, 0xF2)
            if c >= 0 {
                let r: u64 = chiffre_rang(c as u64)
                if r > best {
                    best = r
                    besti = c as u64
                }
            }
            i = i + 1
        }
        if best > 0 {
            (*nz).paar_chiffre = besti
        }
        at = at + pn * 4
    }
    if at + 2 <= n {
        let an: usize = le16(p, at) as usize
        at = at + 2
        if at + an * 4 > n {
            return false
        }
        var i: usize = 0
        while i < an {
            let a: i64 = waehler(p, at + i * 4, 0, 0x50, 0xF2)
            if a >= 0 {
                if (a as u64) == AKM_PSK {
                    (*nz).akm = AKM_PSK
                }
                if (a as u64) == AKM_8021X && (*nz).akm == 0 {
                    (*nz).akm = AKM_8021X
                }
            }
            i = i + 1
        }
    }
    if !(*nz).hat_rsn {
        (*nz).sicherheit = SELF_WPA
    }
    return true
}

// ==================================================================
// DER GANZE BEACON
// ==================================================================
fn zerlege(nz: *mut Network, p: u64, n: usize) -> bool {
    let kl: i64 = frame.header_len(p, n)
    if kl < 0 {
        return false
    }
    let f: u64 = frame.fc(p, n)
    if frame.art(f) != frame.KIND_MGMT {
        return false
    }
    let ut: u64 = frame.untertyp(f)
    if ut != frame.UT_BEACON && ut != frame.UT_PROBE_REPLY {
        return false
    }
    let head: usize = kl as usize
    // Zeitstempel, Intervall, Faehigkeiten.
    if n < head + 12 {
        return false
    }
    let a3: u64 = frame.adr3(p, n)
    if a3 == 0 {
        return false
    }
    var i: usize = 0
    while i < 6 {
        (*nz).bssid[i] = ld8(a3, i)
        i = i + 1
    }
    (*nz).intervall = le16(p, head + 8)
    (*nz).faehigkeiten = le16(p, head + 10)
    let privacy: bool = ((*nz).faehigkeiten & 16) != 0

    var it: frame.IeIter = frame.ie_begin(p, n, head + 12)
    var ht_chan: u64 = 0
    while frame.ie_next(&it) {
        if it.id == frame.IE_SSID {
            if it.length > SSID_MAX {
                return false
            }
            (*nz).ssid_len = it.length
            var all_zero: bool = true
            i = 0
            while i < it.length {
                let c: u8 = ld8(it.payload, i)
                (*nz).ssid[i] = c
                if c != 0 as u8 {
                    all_zero = false
                }
                i = i + 1
            }
            (*nz).ssid_verborgen = it.length == 0 || all_zero
        }
        if it.id == frame.IE_DS && it.length >= 1 {
            (*nz).chan = ld8(it.payload, 0) as u64
        }
        if it.id == frame.IE_HT_BETRIEB && it.length >= 1 {
            ht_chan = ld8(it.payload, 0) as u64
        }
        if it.id == frame.IE_RSN {
            if !rsn_zerlege(nz, it.payload, it.length) {
                return false
            }
        }
        if it.id == frame.IE_HERSTELLER && it.length >= 4 {
            // 00-50-F2, Typ 1: das alte WPA-Element.
            if (ld8(it.payload, 0) as u64) == 0
                && (ld8(it.payload, 1) as u64) == 0x50
                && (ld8(it.payload, 2) as u64) == 0xF2
                && (ld8(it.payload, 3) as u64) == 1 {
                if !wpa_zerlege(nz, it.payload + 4, it.length - 4) {
                    return false
                }
            }
        }
    }
    if it.broken {
        return false
    }
    if (*nz).chan == 0 {
        (*nz).chan = ht_chan
    }
    if (*nz).band == 0 {
        if (*nz).chan >= 1 && (*nz).chan <= 14 {
            (*nz).band = 1
        } else {
            if (*nz).chan > 14 {
                (*nz).band = 2
            }
        }
    }
    if !(*nz).hat_rsn && !(*nz).hat_wpa {
        if privacy {
            (*nz).sicherheit = SELF_WEP
        } else {
            (*nz).sicherheit = SELF_OPEN
        }
    }
    return true
}
