// SPDX-License-Identifier: GPL-2.0-only
import wlan.iwl_buf
import wlan.iwl_le
import wlan.iwl_fwcaps

export {
    DATA_QUEUE, SCD_CFG_LEN, SCD_ACTION_DISABLE, SCD_ACTION_ENABLE, TX_FIFO_BE, TID_ALL, BC_TABLE_BYTES, BC_DUP_BELOW,
    QUEUE_MSK_LEGACY, queue_msk_of, mvm_scd_cfg, bc_entry, bc_store, scd_cfg_check
}

const DATA_QUEUE: u64 = 4
const SCD_CFG_LEN: u64 = iwl_buf.HDR + 12
const SCD_ACTION_DISABLE: u64 = 0
const SCD_ACTION_ENABLE: u64 = 1
const TX_FIFO_BE: u64 = 1
const TID_ALL: u64 = 8
const BC_TABLE_BYTES: u64 = 640
const BC_DUP_BELOW: u64 = 64
const QUEUE_MSK_LEGACY: u64 = 0xF
const SCD_WINDOW: u64 = 64

fn queue_msk_of(q: u64) -> u64 { return 1 << q }

fn mvm_scd_cfg(a: u64, qid: u64, slot: u64, sta_id: u64, tid: u64, queue: u64, action: u64, ssn: u64) -> u64 {
    let h: u64 = iwl_buf.HDR
    iwl_le.zero(a, SCD_CFG_LEN)
    iwl_buf.hdr(a, iwl_fwcaps.CMD_SCD_QUEUE_CFG, qid, slot)
    iwl_le.st8(a, h + 1, sta_id)
    iwl_le.st8(a, h + 2, tid)
    iwl_le.st8(a, h + 3, queue)
    iwl_le.st8(a, h + 4, action)
    iwl_le.st8(a, h + 5, 0)
    iwl_le.st8(a, h + 6, TX_FIFO_BE)
    iwl_le.st8(a, h + 7, SCD_WINDOW)
    iwl_le.st16(a, h + 8, ssn)
    return SCD_CFG_LEN
}

fn scd_cfg_check(a: u64, n: u64) -> bool {
    let h: u64 = iwl_buf.HDR
    if n != SCD_CFG_LEN { return false }
    if iwl_le.ld8(a, h + 3) >= 32 { return false }
    if iwl_le.ld8(a, h + 4) > 1 { return false }
    if iwl_le.ld8(a, h + 5) != 0 { return false }
    if iwl_le.ld8(a, h + 6) > 7 { return false }
    if iwl_le.ld8(a, h + 7) != SCD_WINDOW { return false }
    if iwl_le.ld16(a, h + 10) != 0 { return false }
    return true
}

fn bc_entry(flen: u64, sec_ctl: u64, sta_id: u64) -> u64 {
    var bytes: u64 = flen + 4
    if sec_ctl == 1 { bytes = bytes + 8 }
    return ((bytes + 3) / 4) | ((sta_id & 0xF) << 12)
}

fn bc_store(bc: u64, queue: u64, idx: u64, entry: u64) {
    let base: u64 = bc + queue * BC_TABLE_BYTES
    iwl_le.st16(base, idx * 2, entry)
    if idx < BC_DUP_BELOW { iwl_le.st16(base, (idx + 256) * 2, entry) }
}
