import wlan.frame
import wlan.iwl_le

export { CCMP_HDR, CCMP_MIC, SEC_CCM, tx_is_eapol, tx_protect, rx_unprotect }

const CCMP_HDR: u64 = 8
const CCMP_MIC: u64 = 8
const SEC_CCM: u64 = 2
const FC_PROTECTED: u64 = 0x40
const CCMP_EXT_IV: u64 = 0x20
const LLC_ETHERTYPE_AT: u64 = 6

fn tx_is_eapol(frame_ptr: u64, n: u64, hl: u64) -> bool {
    if hl == 0 || n < hl + 8 { return false }
    return iwl_le.ld8(frame_ptr, hl + LLC_ETHERTYPE_AT) == 0x88 && iwl_le.ld8(frame_ptr, hl + LLC_ETHERTYPE_AT + 1) == 0x8E
}

fn tx_protect(buf: u64, hl: u64, n: u64, pn: u64) {
    var i: u64 = n
    while i > hl {
        iwl_le.st8(buf, i + CCMP_HDR - 1, iwl_le.ld8(buf, i - 1))
        i = i - 1
    }
    iwl_le.st8(buf, hl, pn)
    iwl_le.st8(buf, hl + 1, pn >> 8)
    iwl_le.st8(buf, hl + 2, 0)
    iwl_le.st8(buf, hl + 3, CCMP_EXT_IV)
    iwl_le.st8(buf, hl + 4, pn >> 16)
    iwl_le.st8(buf, hl + 5, pn >> 24)
    iwl_le.st8(buf, hl + 6, pn >> 32)
    iwl_le.st8(buf, hl + 7, pn >> 40)
    iwl_le.st8(buf, 1, iwl_le.ld8(buf, 1) | FC_PROTECTED)
}

fn rx_unprotect(buf: u64, n: u64) -> u64 {
    let fcv: u64 = frame.fc(buf, n as usize)
    if frame.art(fcv) != frame.KIND_DATA || !frame.geschuetzt(fcv) { return n }
    let hli: i64 = frame.header_len(buf, n as usize)
    if hli <= 0 { return n }
    let hl: u64 = hli as u64
    if n < hl + CCMP_HDR + CCMP_MIC { return n }
    let body: u64 = n - hl - CCMP_HDR - CCMP_MIC
    var i: u64 = 0
    while i < body {
        iwl_le.st8(buf, hl + i, iwl_le.ld8(buf, hl + CCMP_HDR + i))
        i = i + 1
    }
    iwl_le.st8(buf, 1, iwl_le.ld8(buf, 1) & 0xBF)
    return hl + body
}
