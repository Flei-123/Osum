import wlan.frame
import wlan.iwl_le
import libc.octets

export { CCMP_HDR, CCMP_MIC, SEC_CCM, RX_PASS, RX_STRIP, RX_DROP_MIC, RX_DROP_RAW, rx_hw_decrypted, tx_is_eapol, tx_protect, rx_unprotect, rx_verdict }

const CCMP_HDR: u64 = 8
const CCMP_MIC: u64 = 8
const SEC_CCM: u64 = 2
const FC_PROTECTED: u64 = 0x40
const CCMP_EXT_IV: u64 = 0x20
const LLC_ETHERTYPE_AT: u64 = 6
const ST_MIC_OK: u64 = 0x40
const ST_SEC_MSK: u64 = 0x700
const ST_SEC_CCM: u64 = 0x200
const RX_PASS: u64 = 0
const RX_STRIP: u64 = 1
const RX_DROP_MIC: u64 = 2
const RX_DROP_RAW: u64 = 3

fn tx_is_eapol(frame_ptr: u64, n: u64, hl: u64) -> bool {
    if hl == 0 || n < hl + 8 { return false }
    return octets.ld8(frame_ptr, hl + LLC_ETHERTYPE_AT) == 0x88 && octets.ld8(frame_ptr, hl + LLC_ETHERTYPE_AT + 1) == 0x8E
}

fn tx_protect(buf: u64, hl: u64, n: u64, pn: u64) {
    var i: u64 = n
    while i > hl {
        octets.st8(buf, i + CCMP_HDR - 1, octets.ld8(buf, i - 1))
        i = i - 1
    }
    octets.st8(buf, hl, pn)
    octets.st8(buf, hl + 1, pn >> 8)
    octets.st8(buf, hl + 2, 0)
    octets.st8(buf, hl + 3, CCMP_EXT_IV)
    octets.st8(buf, hl + 4, pn >> 16)
    octets.st8(buf, hl + 5, pn >> 24)
    octets.st8(buf, hl + 6, pn >> 32)
    octets.st8(buf, hl + 7, pn >> 40)
    octets.st8(buf, 1, octets.ld8(buf, 1) | FC_PROTECTED)
}

fn rx_unprotect(buf: u64, n: u64) -> u64 {
    let fcv: u64 = frame.fc(buf, n as usize)
    if frame.art(fcv) != frame.KIND_DATA || !frame.geschuetzt(fcv) { return n }
    let hli: i64 = frame.header_len(buf, n as usize)
    if hli <= 0 { return n }
    let hl: u64 = hli as u64
    if n < hl + CCMP_HDR + CCMP_MIC { return n }
    let body: u64 = n - hl - CCMP_HDR - CCMP_MIC
    var i: u64 = 0
    while i < body {
        octets.st8(buf, hl + i, octets.ld8(buf, hl + CCMP_HDR + i))
        i = i + 1
    }
    octets.st8(buf, 1, octets.ld8(buf, 1) & 0xBF)
    return hl + body
}

fn rx_hw_decrypted(status: u64) -> bool {
    return (status & ST_SEC_MSK) == ST_SEC_CCM && (status & ST_MIC_OK) != 0
}

fn rx_verdict(buf: u64, n: u64, status: u64) -> u64 {
    let fcv: u64 = frame.fc(buf, n as usize)
    if frame.art(fcv) != frame.KIND_DATA || !frame.geschuetzt(fcv) { return RX_PASS }
    if (status & ST_SEC_MSK) != ST_SEC_CCM { return RX_DROP_RAW }
    if (status & ST_MIC_OK) == 0 { return RX_DROP_MIC }
    return RX_STRIP
}
