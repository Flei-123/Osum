import wlan.iwl_le
import wlan.iwl_w
import wlan.iwl_sbrender
import wlan.iwl_rxscan
import wlan.iwl_pollrec
import wlan.iwl_rxexp_tab

export {
    Diag, diag_new, diag_phase, diag_fail, diag_hw, diag_fw, diag_cmd, diag_notif, diag_rings, diag_nvm, diag_calib,
    diag_armed, diag_render, diag_more, phase_name, err_text, diag_mark, diag_snap, diag_snap2, diag_alive, diag_pm, diag_pci, diag_own, diag_fhfail, diag_fwmiss, diag_trace, diag_rx, diag_x2, diag_poll, step_name,
    ST_NONE, ST_FW_FILE, ST_FW_PARSE, ST_DMA, ST_POWER_INIT, ST_CQ_INIT, ST_FH_INIT, ST_ALIVE_INIT, ST_NVM, ST_INIT_STOP,
    ST_POWER_RT, ST_FH_RT, ST_ALIVE_RT, ST_RT_STAGE, ST_INIT_IMG,
    PH_IDLE, PH_PCI, PH_FW_LOAD_INIT, PH_INIT_ALIVE, PH_NVM, PH_INIT_COMPLETE, PH_FW_LOAD_RT, PH_RT_ALIVE, PH_READY, PH_FAILED,
    NVM_PENDING, NVM_OK, NVM_SKIPPED, NVM_FAILED
}

const PH_IDLE: u64 = 0
const PH_PCI: u64 = 1
const PH_FW_LOAD_INIT: u64 = 2
const PH_INIT_ALIVE: u64 = 3
const PH_NVM: u64 = 4
const PH_INIT_COMPLETE: u64 = 5
const PH_FW_LOAD_RT: u64 = 6
const PH_RT_ALIVE: u64 = 7
const PH_READY: u64 = 8
const PH_FAILED: u64 = 9

const ST_NONE: u64 = 0
const ST_FW_FILE: u64 = 1
const ST_FW_PARSE: u64 = 2
const ST_DMA: u64 = 3
const ST_POWER_INIT: u64 = 4
const ST_CQ_INIT: u64 = 5
const ST_FH_INIT: u64 = 6
const ST_ALIVE_INIT: u64 = 7
const ST_NVM: u64 = 8
const ST_INIT_STOP: u64 = 9
const ST_POWER_RT: u64 = 10
const ST_FH_RT: u64 = 11
const ST_ALIVE_RT: u64 = 12
const ST_RT_STAGE: u64 = 13
const ST_INIT_IMG: u64 = 14

const NVM_PENDING: u64 = 0
const NVM_OK: u64 = 1
const NVM_SKIPPED: u64 = 2
const NVM_FAILED: u64 = 3

struct Diag {
    phase: u64,
    failed_at: u64,
    armed: u64,
    init_alive: u64,
    rt_alive: u64,
    err: i64,
    hw_rev: u64,
    rf_id: u64,
    fw_ver: u64,
    fw_size: u64,
    nvm_state: u64,
    nvm_bytes: u64,
    nvm_secs: u64,
    calib_n: u64,
    calib_bytes: u64,
    replayed: u64,
    last_cmd: u64,
    last_notif: u64,
    cmds: u64,
    notifs: u64,
    rx_head: u64,
    tx_head: u64,
    seen: u64,
    t: [u64; 10],
    fw_name: [u8; 64],
    fw_sha: [u8; 32],
    step: u64,
    fail_step: u64,
    snapped: u64,
    regs: [u64; 8],
    fh_sec: u64,
    fh_chunks: u64,
    fh_bytes: u64,
    fh_valid: u64,
    fh_dst: u64,
    fh_phys: u64,
    fh_cnt: u64,
    snapped2: u64,
    regs2: [u64; 8],
    pci_valid: u64,
    pci_cmd: u64,
    pci_bar: u64,
    pci_size: u64,
    own_valid: u64,
    own_hwif: u64,
    own_mbox: u64,
    own_rc: i64,
    alive_valid: u64,
    alive: [u64; 16],
    pm_valid: u64,
    pm: [u64; 16],
    tr_valid: u64,
    tr: [u64; 192],
    rx_valid: u64,
    rx: [u64; 26],
    x2_valid: u64,
    poll_valid: u64,
    poll: [u64; 360],
    x2: [u64; 136],
    miss: [u8; 64]
}

fn diag_new() -> Diag {
    var d: Diag = Diag {
        phase: 0, failed_at: 0, armed: 0, init_alive: 0, rt_alive: 0, err: 0, hw_rev: 0, rf_id: 0, fw_ver: 0, fw_size: 0,
        nvm_state: 0, nvm_bytes: 0, nvm_secs: 0, calib_n: 0, calib_bytes: 0, replayed: 0, last_cmd: 0, last_notif: 0,
        cmds: 0, notifs: 0, rx_head: 0, tx_head: 0, seen: 0, t: [0; 10], fw_name: [0 as u8; 64], fw_sha: [0 as u8; 32],
        step: 0, fail_step: 0, snapped: 0, regs: [0; 8], fh_sec: 0, fh_chunks: 0, fh_bytes: 0, fh_valid: 0, fh_dst: 0, fh_phys: 0, fh_cnt: 0, snapped2: 0, regs2: [0; 8], pci_valid: 0, pci_cmd: 0, pci_bar: 0, pci_size: 0, own_valid: 0, own_hwif: 0, own_mbox: 0, own_rc: 0, alive_valid: 0, alive: [0; 16], pm_valid: 0, pm: [0; 16], tr_valid: 0, tr: [0; 192], rx_valid: 0, rx: [0; 26], x2_valid: 0, x2: [0; 136], poll_valid: 0, poll: [0; 360], miss: [0 as u8; 64]
    }
    return d
}

fn diag_phase(d: *mut Diag, ph: u64, now: u64) {
    (*d).phase = ph
    (*d).t[ph as usize] = now
    (*d).seen = (*d).seen | (1 << ph)
    if ph == PH_INIT_ALIVE { (*d).init_alive = 1 }
    if ph == PH_RT_ALIVE { (*d).rt_alive = 1 }
}

fn diag_mark(d: *mut Diag, st: u64) {
    (*d).step = st
}

fn diag_snap(d: *mut Diag, src: u64) {
    var i: u64 = 0
    while i < 8 {
        (*d).regs[i as usize] = *((src + i * 8) as *mut u64)
        i = i + 1
    }
    (*d).snapped = 1
}

fn diag_snap2(d: *mut Diag, src: u64) {
    var i: u64 = 0
    while i < 8 {
        (*d).regs2[i as usize] = *((src + i * 8) as *mut u64)
        i = i + 1
    }
    (*d).snapped2 = 1
}

fn diag_trace(d: *mut Diag, src: u64) {
    var i: u64 = 0
    while i < 192 {
        (*d).tr[i as usize] = *((src + i * 8) as *mut u64)
        i = i + 1
    }
    (*d).tr_valid = 1
}

fn diag_rx(d: *mut Diag, src: u64) {
    var i: u64 = 0
    while i < iwl_rxscan.WORDS {
        (*d).rx[i as usize] = *((src + i * 8) as *mut u64)
        i = i + 1
    }
    (*d).rx_valid = 1
}

fn diag_x2(d: *mut Diag, src: u64) {
    var i: u64 = 0
    while i < iwl_rxexp_tab.TAB_WORDS {
        (*d).x2[i as usize] = *((src + i * 8) as *mut u64)
        i = i + 1
    }
    (*d).x2_valid = 1
}

fn diag_poll(d: *mut Diag, src: u64) {
    var i: u64 = 0
    while i < iwl_pollrec.POLL_WORDS {
        (*d).poll[i as usize] = *((src + i * 8) as *mut u64)
        i = i + 1
    }
    (*d).poll_valid = 1
}

fn diag_pm(d: *mut Diag, src: u64) {
    var i: u64 = 0
    while i < 16 {
        (*d).pm[i as usize] = *((src + i * 8) as *mut u64)
        i = i + 1
    }
    (*d).pm_valid = 1
}

fn diag_alive(d: *mut Diag, src: u64) {
    var i: u64 = 0
    while i < 16 {
        (*d).alive[i as usize] = *((src + i * 8) as *mut u64)
        i = i + 1
    }
    (*d).alive_valid = 1
}

fn diag_pci(d: *mut Diag, cmd: u64, bar: u64, size: u64) {
    (*d).pci_cmd = cmd
    (*d).pci_bar = bar
    (*d).pci_size = size
    (*d).pci_valid = 1
}

fn diag_own(d: *mut Diag, hwif: u64, mbox: u64, rc: i64) {
    (*d).own_hwif = hwif
    (*d).own_mbox = mbox
    (*d).own_rc = rc
    (*d).own_valid = 1
}

fn diag_fhfail(d: *mut Diag, sec: u64, chunks: u64, bytes: u64, dst: u64, phys: u64, cnt: u64) {
    (*d).fh_dst = dst
    (*d).fh_phys = phys
    (*d).fh_cnt = cnt
    (*d).fh_sec = sec
    (*d).fh_chunks = chunks
    (*d).fh_bytes = bytes
    (*d).fh_valid = 1
}

fn diag_fwmiss(d: *mut Diag, name: u64) {
    var i: u64 = 0
    while i < 63 {
        let c: u64 = iwl_le.ld8(name, i)
        (*d).miss[i as usize] = c as u8
        if c == 0 { i = 64 } else { i = i + 1 }
    }
    (*d).miss[63] = 0 as u8
}

fn diag_fail(d: *mut Diag, code: i64, now: u64) {
    if (*d).phase != PH_FAILED {
        (*d).failed_at = (*d).phase
        (*d).fail_step = (*d).step
    }
    (*d).err = code
    diag_phase(d, PH_FAILED, now)
}

fn diag_hw(d: *mut Diag, rev: u64, rf: u64) {
    (*d).hw_rev = rev
    (*d).rf_id = rf
}

fn diag_fw(d: *mut Diag, name: u64, ver: u64, size: u64, sha: u64) {
    var i: u64 = 0
    while i < 63 {
        let c: u64 = iwl_le.ld8(name, i)
        (*d).fw_name[i as usize] = c as u8
        if c == 0 { i = 64 } else { i = i + 1 }
    }
    (*d).fw_name[63] = 0 as u8
    (*d).fw_ver = ver
    (*d).fw_size = size
    i = 0
    while i < 32 {
        (*d).fw_sha[i as usize] = iwl_le.ld8(sha, i) as u8
        i = i + 1
    }
}

fn diag_cmd(d: *mut Diag, id: u64) {
    (*d).last_cmd = id
    (*d).cmds = (*d).cmds + 1
}

fn diag_notif(d: *mut Diag, id: u64) {
    (*d).last_notif = id
    (*d).notifs = (*d).notifs + 1
}

fn diag_rings(d: *mut Diag, rx: u64, tx: u64) {
    (*d).rx_head = rx
    (*d).tx_head = tx
}

fn diag_nvm(d: *mut Diag, state: u64, bytes: u64, secs: u64) {
    (*d).nvm_state = state
    (*d).nvm_bytes = bytes
    (*d).nvm_secs = secs
}

fn diag_calib(d: *mut Diag, n: u64, bytes: u64, replayed: u64) {
    (*d).calib_n = n
    (*d).calib_bytes = bytes
    (*d).replayed = replayed
}

fn diag_armed(d: *mut Diag, on: bool) {
    if on { (*d).armed = 1 } else { (*d).armed = 0 }
}


fn phase_name(ph: u64, out: u64) {
    var s0: [u8; 5] = "idle\0"
    var s1: [u8; 4] = "pci\0"
    var s2: [u8; 13] = "fw_load_init\0"
    var s3: [u8; 11] = "init_alive\0"
    var s4: [u8; 4] = "nvm\0"
    var s5: [u8; 14] = "init_complete\0"
    var s6: [u8; 11] = "fw_load_rt\0"
    var s7: [u8; 9] = "rt_alive\0"
    var s8: [u8; 6] = "ready\0"
    var s9: [u8; 7] = "failed\0"
    var sx: [u8; 8] = "unknown\0"
    var src: u64 = (&sx[0]) as u64
    if ph == PH_IDLE { src = (&s0[0]) as u64 }
    if ph == PH_PCI { src = (&s1[0]) as u64 }
    if ph == PH_FW_LOAD_INIT { src = (&s2[0]) as u64 }
    if ph == PH_INIT_ALIVE { src = (&s3[0]) as u64 }
    if ph == PH_NVM { src = (&s4[0]) as u64 }
    if ph == PH_INIT_COMPLETE { src = (&s5[0]) as u64 }
    if ph == PH_FW_LOAD_RT { src = (&s6[0]) as u64 }
    if ph == PH_RT_ALIVE { src = (&s7[0]) as u64 }
    if ph == PH_READY { src = (&s8[0]) as u64 }
    if ph == PH_FAILED { src = (&s9[0]) as u64 }
    var i: u64 = 0
    while iwl_le.ld8(src, i) != 0 {
        iwl_le.st8(out, i, iwl_le.ld8(src, i))
        i = i + 1
    }
    iwl_le.st8(out, i, 0)
}

fn step_name(st: u64, out: u64) {
    var n0: [u8; 5] = "none\0"
    var n1: [u8; 8] = "fw_file\0"
    var n2: [u8; 9] = "fw_parse\0"
    var n3: [u8; 10] = "dma_alloc\0"
    var n4: [u8; 14] = "power_up_init\0"
    var n5: [u8; 8] = "cq_init\0"
    var n6: [u8; 8] = "fh_init\0"
    var n7: [u8; 11] = "alive_init\0"
    var n8: [u8; 4] = "nvm\0"
    var n9: [u8; 10] = "init_stop\0"
    var n10: [u8; 12] = "power_up_rt\0"
    var n11: [u8; 6] = "fh_rt\0"
    var n12: [u8; 9] = "alive_rt\0"
    var n13: [u8; 9] = "rt_stage\0"
    var n14: [u8; 9] = "init_img\0"
    var src: u64 = (&n0[0]) as u64
    if st == ST_FW_FILE { src = (&n1[0]) as u64 }
    if st == ST_FW_PARSE { src = (&n2[0]) as u64 }
    if st == ST_DMA { src = (&n3[0]) as u64 }
    if st == ST_POWER_INIT { src = (&n4[0]) as u64 }
    if st == ST_CQ_INIT { src = (&n5[0]) as u64 }
    if st == ST_FH_INIT { src = (&n6[0]) as u64 }
    if st == ST_ALIVE_INIT { src = (&n7[0]) as u64 }
    if st == ST_NVM { src = (&n8[0]) as u64 }
    if st == ST_INIT_STOP { src = (&n9[0]) as u64 }
    if st == ST_POWER_RT { src = (&n10[0]) as u64 }
    if st == ST_FH_RT { src = (&n11[0]) as u64 }
    if st == ST_ALIVE_RT { src = (&n12[0]) as u64 }
    if st == ST_RT_STAGE { src = (&n13[0]) as u64 }
    if st == ST_INIT_IMG { src = (&n14[0]) as u64 }
    var i: u64 = 0
    while iwl_le.ld8(src, i) != 0 {
        iwl_le.st8(out, i, iwl_le.ld8(src, i))
        i = i + 1
    }
    iwl_le.st8(out, i, 0)
}

fn err_text(code: i64, out: u64) {
    var e0: [u8; 3] = "ok\0"
    var e2: [u8; 16] = "vendor mismatch\0"
    var e3: [u8; 19] = "unsupported device\0"
    var e4: [u8; 8] = "bad BAR\0"
    var e5: [u8; 23] = "device does not answer\0"
    var e20: [u8; 33] = "bus master did not stop / no dev\0"
    var e21: [u8; 29] = "clock not ready / no BAR map\0"
    var e22: [u8; 23] = "MAC access not granted\0"
    var e30: [u8; 14] = "ALIVE timeout\0"
    var e31: [u8; 21] = "ALIVE hardware error\0"
    var e32: [u8; 21] = "ALIVE software error\0"
    var e40: [u8; 22] = "firmware file missing\0"
    var e41: [u8; 22] = "firmware parse failed\0"
    var e42: [u8; 14] = "no DMA memory\0"
    var e43: [u8; 33] = "firmware image has empty section\0"
    var e44: [u8; 26] = "FH MAC access not granted\0"
    var e45: [u8; 22] = "FH end-of-TFD timeout\0"
    var e50: [u8; 22] = "short firmware packet\0"
    var e60: [u8; 30] = "command queue not implemented\0"
    var e61: [u8; 20] = "command send failed\0"
    var e62: [u8; 23] = "firmware reply timeout\0"
    var e63: [u8; 17] = "NVM read refused\0"
    var e64: [u8; 20] = "NVM offset mismatch\0"
    var e65: [u8; 16] = "NVM buffer full\0"
    var e66: [u8; 23] = "calibration store full\0"
    var e67: [u8; 23] = "calibration packet bad\0"
    var e68: [u8; 20] = "receive path failed\0"
    var e69: [u8; 22] = "NVM section too short\0"
    var e23: [u8; 24] = "NIC not ready (prepare)\0"
    var e70: [u8; 16] = "command too big\0"
    var ex: [u8; 8] = "unknown\0"
    var src: u64 = (&ex[0]) as u64
    if code == 0 { src = (&e0[0]) as u64 }
    if code == -2 { src = (&e2[0]) as u64 }
    if code == -3 { src = (&e3[0]) as u64 }
    if code == -4 { src = (&e4[0]) as u64 }
    if code == -5 { src = (&e5[0]) as u64 }
    if code == -20 { src = (&e20[0]) as u64 }
    if code == -21 { src = (&e21[0]) as u64 }
    if code == -22 { src = (&e22[0]) as u64 }
    if code == -23 { src = (&e23[0]) as u64 }
    if code == -30 { src = (&e30[0]) as u64 }
    if code == -31 { src = (&e31[0]) as u64 }
    if code == -32 { src = (&e32[0]) as u64 }
    if code == -40 { src = (&e40[0]) as u64 }
    if code == -41 { src = (&e41[0]) as u64 }
    if code == -42 { src = (&e42[0]) as u64 }
    if code == -43 { src = (&e43[0]) as u64 }
    if code == -44 { src = (&e44[0]) as u64 }
    if code == -45 { src = (&e45[0]) as u64 }
    if code == -50 { src = (&e50[0]) as u64 }
    if code == -60 { src = (&e60[0]) as u64 }
    if code == -61 { src = (&e61[0]) as u64 }
    if code == -62 { src = (&e62[0]) as u64 }
    if code == -63 { src = (&e63[0]) as u64 }
    if code == -64 { src = (&e64[0]) as u64 }
    if code == -65 { src = (&e65[0]) as u64 }
    if code == -66 { src = (&e66[0]) as u64 }
    if code == -67 { src = (&e67[0]) as u64 }
    if code == -68 { src = (&e68[0]) as u64 }
    if code == -69 { src = (&e69[0]) as u64 }
    if code == -70 { src = (&e70[0]) as u64 }
    var i: u64 = 0
    while iwl_le.ld8(src, i) != 0 {
        iwl_le.st8(out, i, iwl_le.ld8(src, i))
        i = i + 1
    }
    iwl_le.st8(out, i, 0)
}

fn yes_no(w: *mut iwl_w.W, v: u64) {
    var y: [u8; 4] = "yes\0"
    var n: [u8; 3] = "no\0"
    if v != 0 { iwl_w.w_s(w, (&y[0]) as u64) } else { iwl_w.w_s(w, (&n[0]) as u64) }
}

fn nvm_name(w: *mut iwl_w.W, v: u64) {
    var a: [u8; 8] = "pending\0"
    var b: [u8; 3] = "ok\0"
    var c: [u8; 8] = "skipped\0"
    var e: [u8; 7] = "failed\0"
    if v == NVM_OK { iwl_w.w_s(w, (&b[0]) as u64) } else if v == NVM_SKIPPED { iwl_w.w_s(w, (&c[0]) as u64) } else if v == NVM_FAILED { iwl_w.w_s(w, (&e[0]) as u64) } else { iwl_w.w_s(w, (&a[0]) as u64) }
}

fn render_fail(w: *mut iwl_w.W, d: *mut Diag) {
    var k_step: [u8; 11] = "fail_step=\0"
    var k_why: [u8; 10] = "fail_why=\0"
    var k_rc: [u8; 5] = " rc=\0"
    var k_regs: [u8; 11] = "fail_regs=\0"
    var k_fh: [u8; 9] = "fail_fh=\0"
    var k_fw: [u8; 9] = "fail_fw=\0"
    var k_nf: [u8; 14] = "fw not found \0"
    var r_n: [u8; 6] = "hwif=\0"
    var r_i: [u8; 6] = " int=\0"
    var r_m: [u8; 7] = " mask=\0"
    var r_f: [u8; 8] = " fhint=\0"
    var r_r: [u8; 6] = " rst=\0"
    var r_g: [u8; 5] = " gp=\0"
    var r_v: [u8; 6] = " rev=\0"
    var r_p: [u8; 6] = " gp1=\0"
    var f_s: [u8; 5] = "sec=\0"
    var f_c: [u8; 9] = " chunks=\0"
    var f_b: [u8; 8] = " bytes=\0"
    var k_hw: [u8; 9] = "fail_hw=\0"
    var k_x: [u8; 10] = "fail_fhr=\0"
    var k_al: [u8; 12] = "fail_alive=\0"
    var a_i: [u8; 5] = "int=\0"
    var a_f: [u8; 8] = " fhint=\0"
    var a_g: [u8; 6] = " gp1=\0"
    var a_h: [u8; 6] = " gp2=\0"
    var a_c: [u8; 7] = " cpu1=\0"
    var a_d: [u8; 7] = " cpu2=\0"
    var a_w: [u8; 6] = " wfp=\0"
    var a_s: [u8; 7] = " seen=\0"
    var k_al2: [u8; 13] = "fail_alive2=\0"
    var k_pm: [u8; 9] = "fail_pm=\0"
    var m_r: [u8; 5] = "rev=\0"
    var m_s: [u8; 6] = " sub=\0"
    var m_p: [u8; 8] = " pmcsr=\0"
    var m_l: [u8; 6] = " lnk=\0"
    var m_rp: [u8; 5] = " rp=\0"
    var m_rl: [u8; 8] = " rplnk=\0"
    var m_g: [u8; 9] = " warmgp=\0"
    var m_h: [u8; 7] = " hwif=\0"
    var m_1: [u8; 6] = " gp1=\0"
    var m_2: [u8; 6] = " gp2=\0"
    var m_v: [u8; 6] = " hwr=\0"
    var m_ar: [u8; 2] = ">\0"
    var b_l: [u8; 6] = "load=\0"
    var b_1: [u8; 7] = " hdr1=\0"
    var b_2: [u8; 7] = " hdr2=\0"
    var b_c: [u8; 7] = " sbcf=\0"
    var b_m: [u8; 6] = " img=\0"
    var b_n1: [u8; 6] = " sc1=\0"
    var b_n2: [u8; 6] = " sc2=\0"
    var b_i0: [u8; 5] = "none\0"
    var b_i1: [u8; 5] = "init\0"
    var b_i2: [u8; 3] = "rt\0"
    var h_c: [u8; 8] = "pcicmd=\0"
    var k_own: [u8; 10] = "fail_own=\0"
    var o_h: [u8; 6] = "hwif=\0"
    var o_m: [u8; 7] = " mbox=\0"
    var o_r: [u8; 5] = " rc=\0"
    var o_p: [u8; 9] = " pcicmd=\0"
    var h_b: [u8; 7] = " bar0=\0"
    var h_z: [u8; 8] = " barsz=\0"
    var x_t: [u8; 6] = "tssr=\0"
    var x_c: [u8; 7] = " cfg9=\0"
    var x_s: [u8; 7] = " sts9=\0"
    var x_a: [u8; 7] = " sram=\0"
    var x_0: [u8; 6] = " td0=\0"
    var x_1: [u8; 6] = " td1=\0"
    var x_u: [u8; 7] = " ucod=\0"
    var x_g: [u8; 5] = " gp=\0"
    var f_d: [u8; 6] = " dst=\0"
    var f_p: [u8; 7] = " phys=\0"
    var f_n: [u8; 6] = " cnt=\0"
    var nm: [u8; 48] = [0 as u8; 48]
    iwl_w.w_s(w, (&k_step[0]) as u64)
    step_name((*d).fail_step, (&nm[0]) as u64)
    iwl_w.w_s(w, (&nm[0]) as u64)
    iwl_w.w_nl(w)
    iwl_w.w_s(w, (&k_why[0]) as u64)
    err_text((*d).err, (&nm[0]) as u64)
    iwl_w.w_s(w, (&nm[0]) as u64)
    iwl_w.w_s(w, (&k_rc[0]) as u64)
    iwl_w.w_int(w, (*d).err)
    iwl_w.w_nl(w)
    if (*d).rx_valid != 0 {
        iwl_rxscan.render(w, (&(*d).rx[0]) as u64)
    }
    if (*d).x2_valid != 0 || (*d).poll_valid != 0 {
        var k_more: [u8; 25] = "fail_more=/proc/wlanpoll\0"
        iwl_w.w_s(w, (&k_more[0]) as u64)
        iwl_w.w_nl(w)
    }
    if (*d).tr_valid != 0 && iwl_sbrender.has_data((&(*d).tr[0]) as u64) {
        iwl_sbrender.render(w, (&(*d).tr[0]) as u64)
    }
    if (*d).snapped != 0 {
        iwl_w.w_s(w, (&k_regs[0]) as u64)
        iwl_w.w_s(w, (&r_n[0]) as u64)
        iwl_w.w_hex(w, (*d).regs[0], 8)
        iwl_w.w_s(w, (&r_i[0]) as u64)
        iwl_w.w_hex(w, (*d).regs[1], 8)
        iwl_w.w_s(w, (&r_m[0]) as u64)
        iwl_w.w_hex(w, (*d).regs[2], 8)
        iwl_w.w_s(w, (&r_f[0]) as u64)
        iwl_w.w_hex(w, (*d).regs[3], 8)
        iwl_w.w_s(w, (&r_r[0]) as u64)
        iwl_w.w_hex(w, (*d).regs[4], 8)
        iwl_w.w_s(w, (&r_g[0]) as u64)
        iwl_w.w_hex(w, (*d).regs[5], 8)
        iwl_w.w_s(w, (&r_v[0]) as u64)
        iwl_w.w_hex(w, (*d).regs[6], 8)
        iwl_w.w_s(w, (&r_p[0]) as u64)
        iwl_w.w_hex(w, (*d).regs[7], 8)
        iwl_w.w_nl(w)
    }
    if (*d).fh_valid != 0 {
        iwl_w.w_s(w, (&k_fh[0]) as u64)
        iwl_w.w_s(w, (&f_s[0]) as u64)
        iwl_w.w_dec(w, (*d).fh_sec)
        iwl_w.w_s(w, (&f_c[0]) as u64)
        iwl_w.w_dec(w, (*d).fh_chunks)
        iwl_w.w_s(w, (&f_b[0]) as u64)
        iwl_w.w_dec(w, (*d).fh_bytes)
        iwl_w.w_s(w, (&f_d[0]) as u64)
        iwl_w.w_hex(w, (*d).fh_dst, 8)
        iwl_w.w_s(w, (&f_p[0]) as u64)
        iwl_w.w_hex(w, (*d).fh_phys, 9)
        iwl_w.w_s(w, (&f_n[0]) as u64)
        iwl_w.w_hex(w, (*d).fh_cnt, 6)
        iwl_w.w_nl(w)
    }
    if (*d).own_valid != 0 {
        iwl_w.w_s(w, (&k_own[0]) as u64)
        iwl_w.w_s(w, (&o_h[0]) as u64)
        iwl_w.w_hex(w, (*d).own_hwif, 8)
        iwl_w.w_s(w, (&o_m[0]) as u64)
        iwl_w.w_hex(w, (*d).own_mbox, 8)
        iwl_w.w_s(w, (&o_r[0]) as u64)
        iwl_w.w_int(w, (*d).own_rc)
        iwl_w.w_s(w, (&o_p[0]) as u64)
        iwl_w.w_hex(w, (*d).pci_cmd, 4)
        iwl_w.w_nl(w)
    }
    if (*d).pci_valid != 0 {
        iwl_w.w_s(w, (&k_hw[0]) as u64)
        iwl_w.w_s(w, (&h_c[0]) as u64)
        iwl_w.w_hex(w, (*d).pci_cmd, 4)
        iwl_w.w_s(w, (&h_b[0]) as u64)
        iwl_w.w_hex(w, (*d).pci_bar, 9)
        iwl_w.w_s(w, (&h_z[0]) as u64)
        iwl_w.w_hex(w, (*d).pci_size, 8)
        iwl_w.w_nl(w)
    }
    if (*d).snapped2 != 0 {
        iwl_w.w_s(w, (&k_x[0]) as u64)
        iwl_w.w_s(w, (&x_t[0]) as u64)
        iwl_w.w_hex(w, (*d).regs2[0], 8)
        iwl_w.w_s(w, (&x_c[0]) as u64)
        iwl_w.w_hex(w, (*d).regs2[1], 8)
        iwl_w.w_s(w, (&x_s[0]) as u64)
        iwl_w.w_hex(w, (*d).regs2[2], 8)
        iwl_w.w_s(w, (&x_a[0]) as u64)
        iwl_w.w_hex(w, (*d).regs2[3], 8)
        iwl_w.w_s(w, (&x_0[0]) as u64)
        iwl_w.w_hex(w, (*d).regs2[4], 8)
        iwl_w.w_s(w, (&x_1[0]) as u64)
        iwl_w.w_hex(w, (*d).regs2[5], 8)
        iwl_w.w_s(w, (&x_u[0]) as u64)
        iwl_w.w_hex(w, (*d).regs2[6], 8)
        iwl_w.w_s(w, (&x_g[0]) as u64)
        iwl_w.w_hex(w, (*d).regs2[7], 8)
        iwl_w.w_nl(w)
    }
    if (*d).alive_valid != 0 {
        iwl_w.w_s(w, (&k_al[0]) as u64)
        iwl_w.w_s(w, (&a_i[0]) as u64)
        iwl_w.w_hex(w, (*d).alive[0], 8)
        iwl_w.w_s(w, (&a_f[0]) as u64)
        iwl_w.w_hex(w, (*d).alive[1], 8)
        iwl_w.w_s(w, (&a_g[0]) as u64)
        iwl_w.w_hex(w, (*d).alive[2], 8)
        iwl_w.w_s(w, (&a_h[0]) as u64)
        iwl_w.w_hex(w, (*d).alive[3], 8)
        iwl_w.w_s(w, (&a_c[0]) as u64)
        iwl_w.w_hex(w, (*d).alive[4], 8)
        iwl_w.w_s(w, (&a_d[0]) as u64)
        iwl_w.w_hex(w, (*d).alive[5], 8)
        iwl_w.w_s(w, (&a_w[0]) as u64)
        iwl_w.w_hex(w, (*d).alive[6], 8)
        iwl_w.w_s(w, (&a_s[0]) as u64)
        iwl_w.w_hex(w, (*d).alive[7], 8)
        iwl_w.w_nl(w)
        iwl_w.w_s(w, (&k_al2[0]) as u64)
        iwl_w.w_s(w, (&b_l[0]) as u64)
        iwl_w.w_hex(w, (*d).alive[8], 8)
        iwl_w.w_s(w, (&b_1[0]) as u64)
        iwl_w.w_hex(w, (*d).alive[9], 8)
        iwl_w.w_s(w, (&b_2[0]) as u64)
        iwl_w.w_hex(w, (*d).alive[10], 8)
        iwl_w.w_s(w, (&b_c[0]) as u64)
        iwl_w.w_hex(w, (*d).alive[11], 8)
        iwl_w.w_s(w, (&b_m[0]) as u64)
        if (*d).alive[12] == 1 { iwl_w.w_s(w, (&b_i1[0]) as u64) } else if (*d).alive[12] == 2 { iwl_w.w_s(w, (&b_i2[0]) as u64) } else { iwl_w.w_s(w, (&b_i0[0]) as u64) }
        iwl_w.w_s(w, (&b_n1[0]) as u64)
        iwl_w.w_dec(w, (*d).alive[13])
        iwl_w.w_s(w, (&b_n2[0]) as u64)
        iwl_w.w_dec(w, (*d).alive[14])
        iwl_w.w_nl(w)
    }
    if (*d).pm_valid != 0 {
        iwl_w.w_s(w, (&k_pm[0]) as u64)
        iwl_w.w_s(w, (&m_r[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[0], 2)
        iwl_w.w_s(w, (&m_s[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[1], 8)
        iwl_w.w_s(w, (&m_p[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[2], 4)
        iwl_w.w_s(w, (&m_ar[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[3], 4)
        iwl_w.w_s(w, (&m_l[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[4], 4)
        iwl_w.w_s(w, (&m_ar[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[5], 4)
        iwl_w.w_s(w, (&m_rp[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[6], 4)
        iwl_w.w_s(w, (&m_rl[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[7], 4)
        iwl_w.w_s(w, (&m_ar[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[8], 4)
        iwl_w.w_s(w, (&m_g[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[9], 8)
        iwl_w.w_s(w, (&m_h[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[10], 8)
        iwl_w.w_s(w, (&m_1[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[11], 8)
        iwl_w.w_s(w, (&m_2[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[12], 8)
        iwl_w.w_s(w, (&m_v[0]) as u64)
        iwl_w.w_hex(w, (*d).pm[13], 8)
        iwl_w.w_nl(w)
    }
    if (*d).miss[0] != 0 as u8 {
        iwl_w.w_s(w, (&k_fw[0]) as u64)
        iwl_w.w_s(w, (&k_nf[0]) as u64)
        iwl_w.w_s(w, (&(*d).miss[0]) as u64)
        iwl_w.w_nl(w)
    }
}

fn diag_more(d: *mut Diag, a: u64, cap: u64) -> u64 {
    var w: iwl_w.W = iwl_w.W { a: a, cap: cap, n: 0 }
    if (*d).x2_valid != 0 && iwl_rxexp_tab.has_data((&(*d).x2[0]) as u64) {
        iwl_rxexp_tab.render(&w, (&(*d).x2[0]) as u64)
    }
    if (*d).poll_valid != 0 && iwl_pollrec.has_data((&(*d).poll[0]) as u64) {
        iwl_pollrec.render(&w, (&(*d).poll[0]) as u64)
    }
    return w.n
}

fn diag_render(d: *mut Diag, a: u64, cap: u64) -> u64 {
    var k_phase: [u8; 7] = "phase=\0"
    var k_fail: [u8; 11] = "failed_at=\0"
    var k_armed: [u8; 7] = "armed=\0"
    var k_alive: [u8; 7] = "alive=\0"
    var k_ia: [u8; 13] = " init_alive=\0"
    var k_ra: [u8; 11] = " rt_alive=\0"
    var k_err: [u8; 5] = "err=\0"
    var k_et: [u8; 10] = "err_text=\0"
    var k_hw: [u8; 12] = "hw_rev=0x\0\0\0"
    var k_rf: [u8; 10] = " rf_id=0x\0"
    var k_fn: [u8; 9] = "fw_name=\0"
    var k_fs: [u8; 8] = "fw_sha=\0"
    var k_fv: [u8; 9] = " fw_ver=\0"
    var k_fz: [u8; 10] = " fw_size=\0"
    var k_nvm: [u8; 5] = "nvm=\0"
    var k_nb: [u8; 8] = " bytes=\0"
    var k_ns: [u8; 7] = " secs=\0"
    var k_cal: [u8; 7] = "calib=\0"
    var k_cb: [u8; 8] = " bytes=\0"
    var k_cr: [u8; 11] = " replayed=\0"
    var k_rx: [u8; 9] = "rx_head=\0"
    var k_tx: [u8; 10] = " tx_head=\0"
    var k_lc: [u8; 12] = "last_cmd=0x\0"
    var k_ln: [u8; 15] = " last_notif=0x\0"
    var k_cn: [u8; 7] = " cmds=\0"
    var k_nn: [u8; 9] = " notifs=\0"
    var k_t: [u8; 4] = "t_\0\0"
    var k_ms: [u8; 4] = "ms\0\0"
    var nm: [u8; 48] = [0 as u8; 48]
    var w: iwl_w.W = iwl_w.W { a: a, cap: cap, n: 0 }
    iwl_w.w_s(&w, (&k_phase[0]) as u64)
    phase_name((*d).phase, (&nm[0]) as u64)
    iwl_w.w_s(&w, (&nm[0]) as u64)
    iwl_w.w_nl(&w)
    if (*d).phase == PH_FAILED {
        iwl_w.w_s(&w, (&k_fail[0]) as u64)
        phase_name((*d).failed_at, (&nm[0]) as u64)
        iwl_w.w_s(&w, (&nm[0]) as u64)
        iwl_w.w_nl(&w)
        render_fail(&w, d)
    }
    iwl_w.w_s(&w, (&k_armed[0]) as u64)
    yes_no(&w, (*d).armed)
    iwl_w.w_nl(&w)
    iwl_w.w_s(&w, (&k_alive[0]) as u64)
    yes_no(&w, (*d).init_alive | (*d).rt_alive)
    iwl_w.w_s(&w, (&k_ia[0]) as u64)
    yes_no(&w, (*d).init_alive)
    iwl_w.w_s(&w, (&k_ra[0]) as u64)
    yes_no(&w, (*d).rt_alive)
    iwl_w.w_nl(&w)
    iwl_w.w_s(&w, (&k_err[0]) as u64)
    iwl_w.w_int(&w, (*d).err)
    iwl_w.w_nl(&w)
    iwl_w.w_s(&w, (&k_et[0]) as u64)
    err_text((*d).err, (&nm[0]) as u64)
    iwl_w.w_s(&w, (&nm[0]) as u64)
    iwl_w.w_nl(&w)
    iwl_w.w_s(&w, (&k_hw[0]) as u64)
    iwl_w.w_hex(&w, (*d).hw_rev, 8)
    iwl_w.w_s(&w, (&k_rf[0]) as u64)
    iwl_w.w_hex(&w, (*d).rf_id, 8)
    iwl_w.w_nl(&w)
    iwl_w.w_s(&w, (&k_fn[0]) as u64)
    iwl_w.w_s(&w, (&(*d).fw_name[0]) as u64)
    iwl_w.w_s(&w, (&k_fv[0]) as u64)
    iwl_w.w_dec(&w, (*d).fw_ver)
    iwl_w.w_s(&w, (&k_fz[0]) as u64)
    iwl_w.w_dec(&w, (*d).fw_size)
    iwl_w.w_nl(&w)
    iwl_w.w_s(&w, (&k_fs[0]) as u64)
    var i: u64 = 0
    while i < 32 {
        iwl_w.w_hex(&w, (*d).fw_sha[i as usize] as u64, 2)
        i = i + 1
    }
    iwl_w.w_nl(&w)
    iwl_w.w_s(&w, (&k_nvm[0]) as u64)
    nvm_name(&w, (*d).nvm_state)
    iwl_w.w_s(&w, (&k_nb[0]) as u64)
    iwl_w.w_dec(&w, (*d).nvm_bytes)
    iwl_w.w_s(&w, (&k_ns[0]) as u64)
    iwl_w.w_dec(&w, (*d).nvm_secs)
    iwl_w.w_nl(&w)
    iwl_w.w_s(&w, (&k_cal[0]) as u64)
    iwl_w.w_dec(&w, (*d).calib_n)
    iwl_w.w_s(&w, (&k_cb[0]) as u64)
    iwl_w.w_dec(&w, (*d).calib_bytes)
    iwl_w.w_s(&w, (&k_cr[0]) as u64)
    iwl_w.w_dec(&w, (*d).replayed)
    iwl_w.w_nl(&w)
    iwl_w.w_s(&w, (&k_rx[0]) as u64)
    iwl_w.w_dec(&w, (*d).rx_head)
    iwl_w.w_s(&w, (&k_tx[0]) as u64)
    iwl_w.w_dec(&w, (*d).tx_head)
    iwl_w.w_nl(&w)
    iwl_w.w_s(&w, (&k_lc[0]) as u64)
    iwl_w.w_hex(&w, (*d).last_cmd, 2)
    iwl_w.w_s(&w, (&k_ln[0]) as u64)
    iwl_w.w_hex(&w, (*d).last_notif, 2)
    iwl_w.w_s(&w, (&k_cn[0]) as u64)
    iwl_w.w_dec(&w, (*d).cmds)
    iwl_w.w_s(&w, (&k_nn[0]) as u64)
    iwl_w.w_dec(&w, (*d).notifs)
    iwl_w.w_nl(&w)
    var ph: u64 = 0
    while ph < 10 {
        if ((*d).seen >> ph) & 1 != 0 {
            iwl_w.w_s(&w, (&k_t[0]) as u64)
            phase_name(ph, (&nm[0]) as u64)
            iwl_w.w_s(&w, (&nm[0]) as u64)
            iwl_w.w_ch(&w, 61)
            iwl_w.w_dec(&w, (*d).t[ph as usize])
            iwl_w.w_s(&w, (&k_ms[0]) as u64)
            iwl_w.w_nl(&w)
        }
        ph = ph + 1
    }
    iwl_le.st8(a, w.n, 0)
    return w.n
}
