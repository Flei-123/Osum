// SPDX-License-Identifier: GPL-2.0-only
import wlan.iwl_le

export {
    Diag, diag_new, diag_phase, diag_fail, diag_hw, diag_fw, diag_cmd, diag_notif, diag_rings, diag_nvm, diag_calib,
    diag_armed, diag_render, phase_name, err_text,
    PH_IDLE, PH_PCI, PH_FW_LOAD_INIT, PH_INIT_ALIVE, PH_NVM, PH_INIT_COMPLETE, PH_FW_LOAD_RT, PH_RT_ALIVE, PH_READY, PH_FAILED,
    NVM_PENDING, NVM_OK, NVM_SKIPPED, NVM_FAILED
}

const PH_IDLE: u64 = 0
const PH_PCI: u64 = 1
const PH_FW_LOAD_INIT: u64 = 2
const PH_INIT_ALIVE: u64 = 3
const PH_NVM: u64 = 4
const PH_INIT_COMPLETE: u64 = 5
const PH_FW_LOAD_RT: u64 = 6
const PH_RT_ALIVE: u64 = 7
const PH_READY: u64 = 8
const PH_FAILED: u64 = 9

const NVM_PENDING: u64 = 0
const NVM_OK: u64 = 1
const NVM_SKIPPED: u64 = 2
const NVM_FAILED: u64 = 3

struct Diag {
    phase: u64,
    failed_at: u64,
    armed: u64,
    init_alive: u64,
    rt_alive: u64,
    err: i64,
    hw_rev: u64,
    rf_id: u64,
    fw_ver: u64,
    fw_size: u64,
    nvm_state: u64,
    nvm_bytes: u64,
    nvm_secs: u64,
    calib_n: u64,
    calib_bytes: u64,
    replayed: u64,
    last_cmd: u64,
    last_notif: u64,
    cmds: u64,
    notifs: u64,
    rx_head: u64,
    tx_head: u64,
    seen: u64,
    t: [u64; 10],
    fw_name: [u8; 64],
    fw_sha: [u8; 32]
}

fn diag_new() -> Diag {
    var d: Diag = Diag {
        phase: 0, failed_at: 0, armed: 0, init_alive: 0, rt_alive: 0, err: 0, hw_rev: 0, rf_id: 0, fw_ver: 0, fw_size: 0,
        nvm_state: 0, nvm_bytes: 0, nvm_secs: 0, calib_n: 0, calib_bytes: 0, replayed: 0, last_cmd: 0, last_notif: 0,
        cmds: 0, notifs: 0, rx_head: 0, tx_head: 0, seen: 0, t: [0; 10], fw_name: [0 as u8; 64], fw_sha: [0 as u8; 32]
    }
    return d
}

fn diag_phase(d: *mut Diag, ph: u64, now: u64) {
    (*d).phase = ph
    (*d).t[ph as usize] = now
    (*d).seen = (*d).seen | (1 << ph)
    if ph == PH_INIT_ALIVE { (*d).init_alive = 1 }
    if ph == PH_RT_ALIVE { (*d).rt_alive = 1 }
}

fn diag_fail(d: *mut Diag, code: i64, now: u64) {
    if (*d).phase != PH_FAILED {
        (*d).failed_at = (*d).phase
    }
    (*d).err = code
    diag_phase(d, PH_FAILED, now)
}

fn diag_hw(d: *mut Diag, rev: u64, rf: u64) {
    (*d).hw_rev = rev
    (*d).rf_id = rf
}

fn diag_fw(d: *mut Diag, name: u64, ver: u64, size: u64, sha: u64) {
    var i: u64 = 0
    while i < 63 {
        let c: u64 = iwl_le.ld8(name, i)
        (*d).fw_name[i as usize] = c as u8
        if c == 0 { i = 64 } else { i = i + 1 }
    }
    (*d).fw_name[63] = 0 as u8
    (*d).fw_ver = ver
    (*d).fw_size = size
    i = 0
    while i < 32 {
        (*d).fw_sha[i as usize] = iwl_le.ld8(sha, i) as u8
        i = i + 1
    }
}

fn diag_cmd(d: *mut Diag, id: u64) {
    (*d).last_cmd = id
    (*d).cmds = (*d).cmds + 1
}

fn diag_notif(d: *mut Diag, id: u64) {
    (*d).last_notif = id
    (*d).notifs = (*d).notifs + 1
}

fn diag_rings(d: *mut Diag, rx: u64, tx: u64) {
    (*d).rx_head = rx
    (*d).tx_head = tx
}

fn diag_nvm(d: *mut Diag, state: u64, bytes: u64, secs: u64) {
    (*d).nvm_state = state
    (*d).nvm_bytes = bytes
    (*d).nvm_secs = secs
}

fn diag_calib(d: *mut Diag, n: u64, bytes: u64, replayed: u64) {
    (*d).calib_n = n
    (*d).calib_bytes = bytes
    (*d).replayed = replayed
}

fn diag_armed(d: *mut Diag, on: bool) {
    if on { (*d).armed = 1 } else { (*d).armed = 0 }
}

struct W {
    a: u64,
    cap: u64,
    n: u64
}

fn w_ch(w: *mut W, c: u64) {
    if (*w).n + 1 < (*w).cap {
        iwl_le.st8((*w).a, (*w).n, c)
        (*w).n = (*w).n + 1
    }
}

fn w_s(w: *mut W, s: u64) {
    var i: u64 = 0
    while iwl_le.ld8(s, i) != 0 {
        w_ch(w, iwl_le.ld8(s, i))
        i = i + 1
    }
}

fn w_dec(w: *mut W, v: u64) {
    var tmp: [u8; 20] = [0 as u8; 20]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        w_ch(w, 48)
        return
    }
    while x != 0 {
        tmp[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        w_ch(w, tmp[n as usize] as u64)
    }
}

fn w_int(w: *mut W, v: i64) {
    if v < 0 {
        w_ch(w, 45)
        w_dec(w, (0 - v) as u64)
    } else {
        w_dec(w, v as u64)
    }
}

fn hexd(v: u64) -> u64 {
    if v < 10 { return 48 + v }
    return 87 + v
}

fn w_hex(w: *mut W, v: u64, digits: u64) {
    var i: u64 = digits
    while i > 0 {
        i = i - 1
        w_ch(w, hexd((v >> (i * 4)) & 15))
    }
}

fn w_nl(w: *mut W) { w_ch(w, 10) }

fn phase_name(ph: u64, out: u64) {
    var s0: [u8; 5] = "idle\0"
    var s1: [u8; 4] = "pci\0"
    var s2: [u8; 13] = "fw_load_init\0"
    var s3: [u8; 11] = "init_alive\0"
    var s4: [u8; 4] = "nvm\0"
    var s5: [u8; 14] = "init_complete\0"
    var s6: [u8; 11] = "fw_load_rt\0"
    var s7: [u8; 9] = "rt_alive\0"
    var s8: [u8; 6] = "ready\0"
    var s9: [u8; 7] = "failed\0"
    var sx: [u8; 8] = "unknown\0"
    var src: u64 = (&sx[0]) as u64
    if ph == PH_IDLE { src = (&s0[0]) as u64 }
    if ph == PH_PCI { src = (&s1[0]) as u64 }
    if ph == PH_FW_LOAD_INIT { src = (&s2[0]) as u64 }
    if ph == PH_INIT_ALIVE { src = (&s3[0]) as u64 }
    if ph == PH_NVM { src = (&s4[0]) as u64 }
    if ph == PH_INIT_COMPLETE { src = (&s5[0]) as u64 }
    if ph == PH_FW_LOAD_RT { src = (&s6[0]) as u64 }
    if ph == PH_RT_ALIVE { src = (&s7[0]) as u64 }
    if ph == PH_READY { src = (&s8[0]) as u64 }
    if ph == PH_FAILED { src = (&s9[0]) as u64 }
    var i: u64 = 0
    while iwl_le.ld8(src, i) != 0 {
        iwl_le.st8(out, i, iwl_le.ld8(src, i))
        i = i + 1
    }
    iwl_le.st8(out, i, 0)
}

fn err_text(code: i64, out: u64) {
    var e0: [u8; 3] = "ok\0"
    var e2: [u8; 16] = "vendor mismatch\0"
    var e3: [u8; 19] = "unsupported device\0"
    var e4: [u8; 8] = "bad BAR\0"
    var e5: [u8; 23] = "device does not answer\0"
    var e20: [u8; 33] = "bus master did not stop / no dev\0"
    var e21: [u8; 29] = "clock not ready / no BAR map\0"
    var e22: [u8; 23] = "MAC access not granted\0"
    var e30: [u8; 14] = "ALIVE timeout\0"
    var e31: [u8; 21] = "ALIVE hardware error\0"
    var e32: [u8; 21] = "ALIVE software error\0"
    var e40: [u8; 22] = "firmware file missing\0"
    var e41: [u8; 22] = "firmware parse failed\0"
    var e42: [u8; 14] = "no DMA memory\0"
    var e43: [u8; 33] = "firmware image has empty section\0"
    var e44: [u8; 26] = "FH MAC access not granted\0"
    var e45: [u8; 22] = "FH end-of-TFD timeout\0"
    var e50: [u8; 22] = "short firmware packet\0"
    var e60: [u8; 30] = "command queue not implemented\0"
    var e61: [u8; 20] = "command send failed\0"
    var e62: [u8; 23] = "firmware reply timeout\0"
    var e63: [u8; 17] = "NVM read refused\0"
    var e64: [u8; 20] = "NVM offset mismatch\0"
    var e65: [u8; 16] = "NVM buffer full\0"
    var e66: [u8; 23] = "calibration store full\0"
    var e67: [u8; 23] = "calibration packet bad\0"
    var e68: [u8; 20] = "receive path failed\0"
    var e69: [u8; 22] = "NVM section too short\0"
    var e70: [u8; 16] = "command too big\0"
    var ex: [u8; 8] = "unknown\0"
    var src: u64 = (&ex[0]) as u64
    if code == 0 { src = (&e0[0]) as u64 }
    if code == -2 { src = (&e2[0]) as u64 }
    if code == -3 { src = (&e3[0]) as u64 }
    if code == -4 { src = (&e4[0]) as u64 }
    if code == -5 { src = (&e5[0]) as u64 }
    if code == -20 { src = (&e20[0]) as u64 }
    if code == -21 { src = (&e21[0]) as u64 }
    if code == -22 { src = (&e22[0]) as u64 }
    if code == -30 { src = (&e30[0]) as u64 }
    if code == -31 { src = (&e31[0]) as u64 }
    if code == -32 { src = (&e32[0]) as u64 }
    if code == -40 { src = (&e40[0]) as u64 }
    if code == -41 { src = (&e41[0]) as u64 }
    if code == -42 { src = (&e42[0]) as u64 }
    if code == -43 { src = (&e43[0]) as u64 }
    if code == -44 { src = (&e44[0]) as u64 }
    if code == -45 { src = (&e45[0]) as u64 }
    if code == -50 { src = (&e50[0]) as u64 }
    if code == -60 { src = (&e60[0]) as u64 }
    if code == -61 { src = (&e61[0]) as u64 }
    if code == -62 { src = (&e62[0]) as u64 }
    if code == -63 { src = (&e63[0]) as u64 }
    if code == -64 { src = (&e64[0]) as u64 }
    if code == -65 { src = (&e65[0]) as u64 }
    if code == -66 { src = (&e66[0]) as u64 }
    if code == -67 { src = (&e67[0]) as u64 }
    if code == -68 { src = (&e68[0]) as u64 }
    if code == -69 { src = (&e69[0]) as u64 }
    if code == -70 { src = (&e70[0]) as u64 }
    var i: u64 = 0
    while iwl_le.ld8(src, i) != 0 {
        iwl_le.st8(out, i, iwl_le.ld8(src, i))
        i = i + 1
    }
    iwl_le.st8(out, i, 0)
}

fn yes_no(w: *mut W, v: u64) {
    var y: [u8; 4] = "yes\0"
    var n: [u8; 3] = "no\0"
    if v != 0 { w_s(w, (&y[0]) as u64) } else { w_s(w, (&n[0]) as u64) }
}

fn nvm_name(w: *mut W, v: u64) {
    var a: [u8; 8] = "pending\0"
    var b: [u8; 3] = "ok\0"
    var c: [u8; 8] = "skipped\0"
    var e: [u8; 7] = "failed\0"
    if v == NVM_OK { w_s(w, (&b[0]) as u64) } else if v == NVM_SKIPPED { w_s(w, (&c[0]) as u64) } else if v == NVM_FAILED { w_s(w, (&e[0]) as u64) } else { w_s(w, (&a[0]) as u64) }
}

fn diag_render(d: *mut Diag, a: u64, cap: u64) -> u64 {
    var k_phase: [u8; 7] = "phase=\0"
    var k_fail: [u8; 11] = "failed_at=\0"
    var k_armed: [u8; 7] = "armed=\0"
    var k_alive: [u8; 7] = "alive=\0"
    var k_ia: [u8; 13] = " init_alive=\0"
    var k_ra: [u8; 11] = " rt_alive=\0"
    var k_err: [u8; 5] = "err=\0"
    var k_et: [u8; 10] = "err_text=\0"
    var k_hw: [u8; 12] = "hw_rev=0x\0\0\0"
    var k_rf: [u8; 10] = " rf_id=0x\0"
    var k_fn: [u8; 9] = "fw_name=\0"
    var k_fs: [u8; 8] = "fw_sha=\0"
    var k_fv: [u8; 9] = " fw_ver=\0"
    var k_fz: [u8; 10] = " fw_size=\0"
    var k_nvm: [u8; 5] = "nvm=\0"
    var k_nb: [u8; 8] = " bytes=\0"
    var k_ns: [u8; 7] = " secs=\0"
    var k_cal: [u8; 7] = "calib=\0"
    var k_cb: [u8; 8] = " bytes=\0"
    var k_cr: [u8; 11] = " replayed=\0"
    var k_rx: [u8; 9] = "rx_head=\0"
    var k_tx: [u8; 10] = " tx_head=\0"
    var k_lc: [u8; 12] = "last_cmd=0x\0"
    var k_ln: [u8; 15] = " last_notif=0x\0"
    var k_cn: [u8; 7] = " cmds=\0"
    var k_nn: [u8; 9] = " notifs=\0"
    var k_t: [u8; 4] = "t_\0\0"
    var k_ms: [u8; 4] = "ms\0\0"
    var nm: [u8; 48] = [0 as u8; 48]
    var w: W = W { a: a, cap: cap, n: 0 }
    w_s(&w, (&k_phase[0]) as u64)
    phase_name((*d).phase, (&nm[0]) as u64)
    w_s(&w, (&nm[0]) as u64)
    w_nl(&w)
    if (*d).phase == PH_FAILED {
        w_s(&w, (&k_fail[0]) as u64)
        phase_name((*d).failed_at, (&nm[0]) as u64)
        w_s(&w, (&nm[0]) as u64)
        w_nl(&w)
    }
    w_s(&w, (&k_armed[0]) as u64)
    yes_no(&w, (*d).armed)
    w_nl(&w)
    w_s(&w, (&k_alive[0]) as u64)
    yes_no(&w, (*d).init_alive | (*d).rt_alive)
    w_s(&w, (&k_ia[0]) as u64)
    yes_no(&w, (*d).init_alive)
    w_s(&w, (&k_ra[0]) as u64)
    yes_no(&w, (*d).rt_alive)
    w_nl(&w)
    w_s(&w, (&k_err[0]) as u64)
    w_int(&w, (*d).err)
    w_nl(&w)
    w_s(&w, (&k_et[0]) as u64)
    err_text((*d).err, (&nm[0]) as u64)
    w_s(&w, (&nm[0]) as u64)
    w_nl(&w)
    w_s(&w, (&k_hw[0]) as u64)
    w_hex(&w, (*d).hw_rev, 8)
    w_s(&w, (&k_rf[0]) as u64)
    w_hex(&w, (*d).rf_id, 8)
    w_nl(&w)
    w_s(&w, (&k_fn[0]) as u64)
    w_s(&w, (&(*d).fw_name[0]) as u64)
    w_s(&w, (&k_fv[0]) as u64)
    w_dec(&w, (*d).fw_ver)
    w_s(&w, (&k_fz[0]) as u64)
    w_dec(&w, (*d).fw_size)
    w_nl(&w)
    w_s(&w, (&k_fs[0]) as u64)
    var i: u64 = 0
    while i < 32 {
        w_hex(&w, (*d).fw_sha[i as usize] as u64, 2)
        i = i + 1
    }
    w_nl(&w)
    w_s(&w, (&k_nvm[0]) as u64)
    nvm_name(&w, (*d).nvm_state)
    w_s(&w, (&k_nb[0]) as u64)
    w_dec(&w, (*d).nvm_bytes)
    w_s(&w, (&k_ns[0]) as u64)
    w_dec(&w, (*d).nvm_secs)
    w_nl(&w)
    w_s(&w, (&k_cal[0]) as u64)
    w_dec(&w, (*d).calib_n)
    w_s(&w, (&k_cb[0]) as u64)
    w_dec(&w, (*d).calib_bytes)
    w_s(&w, (&k_cr[0]) as u64)
    w_dec(&w, (*d).replayed)
    w_nl(&w)
    w_s(&w, (&k_rx[0]) as u64)
    w_dec(&w, (*d).rx_head)
    w_s(&w, (&k_tx[0]) as u64)
    w_dec(&w, (*d).tx_head)
    w_nl(&w)
    w_s(&w, (&k_lc[0]) as u64)
    w_hex(&w, (*d).last_cmd, 2)
    w_s(&w, (&k_ln[0]) as u64)
    w_hex(&w, (*d).last_notif, 2)
    w_s(&w, (&k_cn[0]) as u64)
    w_dec(&w, (*d).cmds)
    w_s(&w, (&k_nn[0]) as u64)
    w_dec(&w, (*d).notifs)
    w_nl(&w)
    var ph: u64 = 0
    while ph < 10 {
        if ((*d).seen >> ph) & 1 != 0 {
            w_s(&w, (&k_t[0]) as u64)
            phase_name(ph, (&nm[0]) as u64)
            w_s(&w, (&nm[0]) as u64)
            w_ch(&w, 61)
            w_dec(&w, (*d).t[ph as usize])
            w_s(&w, (&k_ms[0]) as u64)
            w_nl(&w)
        }
        ph = ph + 1
    }
    iwl_le.st8(a, w.n, 0)
    return w.n
}
