import wlan.iwl_le
import libc.octets

export {
    TxResp, txresp_new, txresp_parse, txresp_count, txresp_ok, txresp_fail, txresp_status, txresp_frames,
    txresp_fail_frame, txresp_fail_rts, txresp_rate, txresp_media, txresp_ssn, txresp_first_bad, txresp_ra_tid
}

const OFF_FRAME_COUNT: u64 = 0
const OFF_FAIL_RTS: u64 = 2
const OFF_FAIL_FRAME: u64 = 3
const OFF_RATE: u64 = 4
const OFF_MEDIA: u64 = 8
const OFF_RA_TID: u64 = 33
const OFF_STATUS: u64 = 36
const OFF_SSN: u64 = 40
const SSN_MASK: u64 = 0xFFF
const MIN_LEN: u64 = 44
const STATUS_MASK: u64 = 0xFF
const STATUS_SUCCESS: u64 = 1

struct TxResp {
    count: u64,
    ok: u64,
    fail: u64,
    status: u64,
    frames: u64,
    fail_frame: u64,
    fail_rts: u64,
    rate: u64,
    media: u64,
    ssn: u64,
    first_bad: u64,
    ra_tid: u64
}

fn txresp_new() -> TxResp {
    var t: TxResp = TxResp { count: 0, ok: 0, fail: 0, status: 0, frames: 0, fail_frame: 0, fail_rts: 0, rate: 0, media: 0, ssn: 0, first_bad: 0, ra_tid: 0 }
    return t
}

fn txresp_parse(t: *mut TxResp, p: u64, n: u64) {
    if n < MIN_LEN { return }
    let st: u64 = octets.ld16(p, OFF_STATUS) & STATUS_MASK
    (*t).count = (*t).count + 1
    if st == STATUS_SUCCESS {
        (*t).ok = (*t).ok + 1
    } else {
        (*t).fail = (*t).fail + 1
        if (*t).first_bad == 0 { (*t).first_bad = st }
    }
    (*t).status = octets.ld16(p, OFF_STATUS)
    (*t).frames = octets.ld8(p, OFF_FRAME_COUNT)
    (*t).fail_rts = octets.ld8(p, OFF_FAIL_RTS)
    (*t).fail_frame = octets.ld8(p, OFF_FAIL_FRAME)
    (*t).rate = octets.ld32(p, OFF_RATE)
    (*t).media = octets.ld16(p, OFF_MEDIA)
    (*t).ssn = octets.ld32(p, OFF_SSN) & SSN_MASK
    (*t).ra_tid = octets.ld8(p, OFF_RA_TID)
}

fn txresp_count(t: *mut TxResp) -> u64 { return (*t).count }
fn txresp_ok(t: *mut TxResp) -> u64 { return (*t).ok }
fn txresp_fail(t: *mut TxResp) -> u64 { return (*t).fail }
fn txresp_status(t: *mut TxResp) -> u64 { return (*t).status }
fn txresp_frames(t: *mut TxResp) -> u64 { return (*t).frames }
fn txresp_fail_frame(t: *mut TxResp) -> u64 { return (*t).fail_frame }
fn txresp_fail_rts(t: *mut TxResp) -> u64 { return (*t).fail_rts }
fn txresp_rate(t: *mut TxResp) -> u64 { return (*t).rate }
fn txresp_media(t: *mut TxResp) -> u64 { return (*t).media }
fn txresp_ssn(t: *mut TxResp) -> u64 { return (*t).ssn }
fn txresp_first_bad(t: *mut TxResp) -> u64 { return (*t).first_bad }
fn txresp_ra_tid(t: *mut TxResp) -> u64 { return (*t).ra_tid }
