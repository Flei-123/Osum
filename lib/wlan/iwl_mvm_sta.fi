import wlan.iwl_buf
import wlan.iwl_le
import wlan.iwl_mvm
import wlan.iwl_mvm_ctx

export { STA_LEN_V7, STA_LEN_V8, STA_TYPE_LINK, STA_TYPE_AUX, MAC_INDEX_AUX, TID_DISABLE_ALL, sta_v8, mvm_aux_sta }

const STA_LEN_V7: u64 = 44
const STA_LEN_V8: u64 = 48
const STA_TYPE_LINK: u64 = 0
const STA_TYPE_AUX: u64 = 4
const MAC_INDEX_AUX: u64 = 4
const TID_DISABLE_ALL: u64 = 0xFFFF
const OFF_TID_DISABLE: u64 = 2
const OFF_STA_TYPE: u64 = 35

fn sta_v8(a: u64, len: u64, sta_type: u64) -> u64 {
    let full: u64 = iwl_buf.HDR + STA_LEN_V8
    if len < full { iwl_le.zero(a + len, full - len) }
    iwl_le.st8(a, iwl_buf.HDR + OFF_STA_TYPE, sta_type)
    return full
}

fn mvm_aux_sta(a: u64, qid: u64, slot: u64, sta_id: u64, queue_msk: u64, v8: bool) -> u64 {
    var none: [u8; 6] = [0; 6]
    var n: u64 = iwl_mvm.mvm_add_sta(a, qid, slot, 0, iwl_mvm_ctx.mvm_id_color(MAC_INDEX_AUX, 0),
        (&none[0]) as u64, sta_id, 0, 0, 0, queue_msk)
    iwl_le.st16(a, iwl_buf.HDR + OFF_TID_DISABLE, TID_DISABLE_ALL)
    if v8 { n = sta_v8(a, n, STA_TYPE_AUX) }
    return n
}
