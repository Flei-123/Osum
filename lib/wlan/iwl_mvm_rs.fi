import wlan.iwl_buf
import wlan.iwl_le
import libc.octets

export { CMD_LQ, LQ_LEN, LQ_RATES, RATE_LEGACY_6M_ANT_A, mvm_lq_cmd }

const CMD_LQ: u64 = 0x4E
const LQ_RATES: u64 = 16
const LQ_LEN: u64 = iwl_buf.HDR + 88
const LQ_FLAGS_COLOR_1: u64 = 2
const LQ_ANT_A: u64 = 1
const LQ_ANT_AB: u64 = 3
const LQ_AGG_TIME_LIMIT: u64 = 4000
const LQ_AGG_DISABLE_START: u64 = 3
const LQ_AGG_FRAME_LIMIT: u64 = 63
const RATE_LEGACY_6M_ANT_A: u64 = 0x400D

fn mvm_lq_cmd(a: u64, qid: u64, slot: u64, sta_id: u64, rate: u64) -> u64 {
    let h: u64 = iwl_buf.HDR
    octets.zero(a, LQ_LEN)
    iwl_buf.hdr(a, CMD_LQ, qid, slot)
    octets.st8(a, h, sta_id)
    octets.st8(a, h + 4, LQ_FLAGS_COLOR_1)
    octets.st8(a, h + 6, LQ_ANT_A)
    octets.st8(a, h + 7, LQ_ANT_AB)
    octets.st16(a, h + 12, LQ_AGG_TIME_LIMIT)
    octets.st8(a, h + 14, LQ_AGG_DISABLE_START)
    octets.st8(a, h + 15, LQ_AGG_FRAME_LIMIT)
    var i: u64 = 0
    while i < LQ_RATES {
        octets.st32(a, h + 20 + i * 4, rate)
        i = i + 1
    }
    return LQ_LEN
}
