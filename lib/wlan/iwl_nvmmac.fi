import wlan.iwl_le

export { MAO_MIN_LEN, MAO_MAC_OFF, mao_mac, mac_valid }

const MAO_MIN_LEN: u64 = 8
const MAO_MAC_OFF: u64 = 2

fn mac_valid(m: u64) -> bool {
    if (iwl_le.ld8(m, 0) & 1) != 0 { return false }
    var any: u64 = 0
    var i: u64 = 0
    while i < 6 {
        any = any | iwl_le.ld8(m, i)
        i = i + 1
    }
    if any == 0 { return false }
    if iwl_le.ld8(m, 0) == 0x02 && iwl_le.ld8(m, 1) == 0xCC && iwl_le.ld8(m, 2) == 0xAA
        && iwl_le.ld8(m, 3) == 0xFF && iwl_le.ld8(m, 4) == 0xEE && iwl_le.ld8(m, 5) == 0x00 { return false }
    return true
}

fn mao_mac(sec: u64, len: u64, out: u64) -> bool {
    if len < MAO_MIN_LEN { return false }
    if !mac_valid(sec + MAO_MAC_OFF) { return false }
    iwl_le.copy(out, sec + MAO_MAC_OFF, 6)
    return true
}
