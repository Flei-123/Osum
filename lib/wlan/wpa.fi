import crypto.sha1
import crypto.pbkdf2_job
import crypto.sha256
import crypto.aes
import libc.octets

export {
    Eapol, eapol_new, eapol_zerlege, eapol_mic_offset,
    pmk_off_password, pmk_job_start, ptk_ableiten, mic_compute, mic_check,
    key_data_unwrap, gtk_find,
    KCK_LEN, KEK_LEN, TK_LEN, PTK_LEN, NONCE_LEN, MIC_LEN,
    EAPOL_HEADER, EAPOL_COMMIT,
    MIC_HMAC_SHA1, MIC_AES_CMAC, MIC_UNBEKANNT
}

const NONCE_LEN: usize = 32
const KCK_LEN: usize = 16
const KEK_LEN: usize = 16
const TK_LEN: usize = 16
const PTK_LEN: usize = 48
const MIC_LEN: usize = 16

const EAPOL_HEADER: usize = 4
const EAPOL_COMMIT: usize = 95

const MIC_UNBEKANNT: u64 = 0
const MIC_HMAC_SHA1: u64 = 1
const MIC_AES_CMAC: u64 = 2

fn be16(p: u64, i: usize) -> u64 {
    return ((octets.load_byte(p, i) as u64) << 8) | (octets.load_byte(p, i + 1) as u64)
}

//   0    EAPOL-Version            1
//   1    EAPOL-Typ                1   3 = EAPOL-Key
//   2    Rumpflaenge              2
//   4    Deskriptortyp            1   2 = RSN, 254 = WPA
//   5    Key Information          2
//   7    Key Length               2
//   9    Replay Counter           8
//   17   Key Nonce               32
//   49   Key IV                  16
//   65   Key RSC                  8
//   73   Reserviert               8
//   81   Key MIC                 16
//   97   Key Data Length          2
//   99   Key Data                 n
struct Eapol {
    version: u64,
    typ: u64,
    body_len: usize,
    deskriptor: u64,
    key_info: u64,
    desc_version: u64,
    key_len: u64,
    counter_lo: u64,
    nonce: u64,
    rsc: u64,
    mic: u64,
    data: u64,      // pointer INTO the frame
    data_len: usize,
    paarweise: bool,
    installieren: bool,
    ack: bool,
    hat_mic: bool,
    secure: bool,
    failed: bool,
    anforderung: bool,
    data_encrypted: bool,
    nachricht: u64,
    gesamt: usize,
}

fn eapol_new() -> Eapol {
    return Eapol { version: 0, typ: 0, body_len: 0, deskriptor: 0,
        key_info: 0, desc_version: 0, key_len: 0, counter_lo: 0,
        nonce: 0, rsc: 0, mic: 0, data: 0, data_len: 0,
        paarweise: false, installieren: false, ack: false,
        hat_mic: false, secure: false, failed: false,
        anforderung: false, data_encrypted: false,
        nachricht: 0, gesamt: 0 }
}

fn eapol_mic_offset() -> usize {
    return EAPOL_HEADER + 77
}

fn eapol_zerlege(e: *mut Eapol, p: u64, n: usize) -> bool {
    if n < EAPOL_HEADER + EAPOL_COMMIT {
        return false
    }
    (*e).version = octets.load_byte(p, 0) as u64
    (*e).typ = octets.load_byte(p, 1) as u64
    if (*e).typ != 3 {
        return false // kein EAPOL-Key
    }
    (*e).body_len = be16(p, 2) as usize
    if EAPOL_HEADER + (*e).body_len > n {
        return false
    }
    if (*e).body_len < EAPOL_COMMIT {
        return false
    }
    (*e).deskriptor = octets.load_byte(p, 4) as u64
    if (*e).deskriptor != 2 && (*e).deskriptor != 254 {
        return false
    }
    let ki: u64 = be16(p, 5)
    (*e).key_info = ki
    (*e).desc_version = ki & 7
    (*e).key_len = be16(p, 7)
    (*e).counter_lo = ((octets.load_byte(p, 13) as u64) << 24)
        | ((octets.load_byte(p, 14) as u64) << 16)
        | ((octets.load_byte(p, 15) as u64) << 8)
        | (octets.load_byte(p, 16) as u64)
    (*e).nonce = p + 17
    (*e).rsc = p + 65
    (*e).mic = p + 81
    let dl: usize = be16(p, 97) as usize
    if EAPOL_HEADER + EAPOL_COMMIT + dl > EAPOL_HEADER + (*e).body_len {
        return false
    }
    if EAPOL_HEADER + EAPOL_COMMIT + dl > n {
        return false
    }
    (*e).data_len = dl
    if dl > 0 {
        (*e).data = p + (EAPOL_HEADER as u64) + (EAPOL_COMMIT as u64)
    } else {
        (*e).data = 0
    }
    (*e).gesamt = EAPOL_HEADER + EAPOL_COMMIT + dl

    (*e).paarweise = (ki & 8) != 0
    (*e).installieren = (ki & 64) != 0
    (*e).ack = (ki & 128) != 0
    (*e).hat_mic = (ki & 256) != 0
    (*e).secure = (ki & 512) != 0
    (*e).failed = (ki & 1024) != 0
    (*e).anforderung = (ki & 2048) != 0
    (*e).data_encrypted = (ki & 4096) != 0

    (*e).nachricht = 0
    if (*e).paarweise {
        if (*e).ack && !(*e).hat_mic {
            (*e).nachricht = 1
        }
        if !(*e).ack && (*e).hat_mic && !(*e).secure {
            (*e).nachricht = 2
        }
        if (*e).ack && (*e).hat_mic {
            (*e).nachricht = 3
        }
        if !(*e).ack && (*e).hat_mic && (*e).secure {
            (*e).nachricht = 4
        }
    }
    return true
}

// ==================================================================
// DIE ABLEITUNGEN
// ==================================================================

// PMK = PBKDF2-HMAC-SHA1(Passwort, SSID, 4096, 32).
fn pmk_off_password(pw: u64, pwlen: usize, ssid: u64, ssidlen: usize,
    out: u64) -> bool {
    if pwlen < 8 || pwlen > 63 {
        return false
    }
    if ssidlen > 32 {
        return false
    }
    return sha1.pbkdf2(pw, pwlen, ssid, ssidlen, 4096, out, 32)
}

fn pmk_job_start(j: *mut pbkdf2_job.Pbkdf2Job, pw: u64, pwlen: usize, ssid: u64, ssidlen: usize,
    out: u64) -> bool {
    if pwlen < 8 || pwlen > 63 { return false }
    if ssidlen > 32 { return false }
    return pbkdf2_job.pbkdf2_job_start(j, pw, pwlen, ssid, ssidlen, 4096, out, 32)
}

fn kdf_sha256(key: u64, klen: usize, label: u64, llen: usize,
    data: u64, dlen: usize, out: u64, outlen: usize) -> bool {
    if outlen > 128 || llen > 64 || dlen > 256 {
        return false
    }
    var buf: [u8; 326] = [0 as u8; 326]
    let gesamt: usize = 2 + llen + dlen + 2
    var i: usize = 0
    while i < llen {
        buf[2 + i] = octets.load_byte(label, i)
        i = i + 1
    }
    i = 0
    while i < dlen {
        buf[2 + llen + i] = octets.load_byte(data, i)
        i = i + 1
    }
    let bits: u64 = (outlen as u64) * 8
    buf[2 + llen + dlen] = (bits & 255) as u8
    buf[2 + llen + dlen + 1] = ((bits >> 8) & 255) as u8

    var blk: [u8; 32] = [0 as u8; 32]
    var pos: usize = 0
    var c: u64 = 1
    while pos < outlen {
        buf[0] = (c & 255) as u8
        buf[1] = ((c >> 8) & 255) as u8
        sha256.hmac(key, klen, (&buf[0]) as u64, gesamt,
            (&blk[0]) as u64)
        var j: usize = 0
        while j < 32 && pos + j < outlen {
            octets.store_byte(out, pos + j, blk[j])
            j = j + 1
        }
        pos = pos + 32
        c = c + 1
    }
    return true
}

// Welches Verfahren zu welchem Anmeldeverfahren gehoert.
fn ist_sha256_akm(akm: u64) -> bool {
    return akm == 5 || akm == 6 || akm == 8 || akm == 9 || akm == 18
}

// PTK = PRF(PMK, "Pairwise key expansion", min||max||min||max).
fn ptk_ableiten(pmk: u64, pmklen: usize, aa: u64, spa: u64,
    anonce: u64, snonce: u64, akm: u64, out: u64,
    outlen: usize) -> bool {
    if pmklen == 0 || pmklen > 64 {
        return false
    }
    if outlen < 16 || outlen > 128 {
        return false
    }
    var data: [u8; 76] = [0 as u8; 76]
    var kleiner: u64 = aa
    var groesser: u64 = spa
    var i: usize = 0
    var entschieden: bool = false
    while i < 6 {
        if !entschieden {
            let x: u8 = octets.load_byte(aa, i)
            let y: u8 = octets.load_byte(spa, i)
            if x < y {
                kleiner = aa
                groesser = spa
                entschieden = true
            }
            if x > y {
                kleiner = spa
                groesser = aa
                entschieden = true
            }
        }
        i = i + 1
    }
    i = 0
    while i < 6 {
        data[i] = octets.load_byte(kleiner, i)
        data[6 + i] = octets.load_byte(groesser, i)
        i = i + 1
    }
    var nk: u64 = anonce
    var ng: u64 = snonce
    entschieden = false
    i = 0
    while i < NONCE_LEN {
        if !entschieden {
            let x: u8 = octets.load_byte(anonce, i)
            let y: u8 = octets.load_byte(snonce, i)
            if x < y {
                nk = anonce
                ng = snonce
                entschieden = true
            }
            if x > y {
                nk = snonce
                ng = anonce
                entschieden = true
            }
        }
        i = i + 1
    }
    i = 0
    while i < NONCE_LEN {
        data[12 + i] = octets.load_byte(nk, i)
        data[12 + NONCE_LEN + i] = octets.load_byte(ng, i)
        i = i + 1
    }

    var tag: [u8; 23] = "Pairwise key expansion\0"
    if ist_sha256_akm(akm) {
        return kdf_sha256(pmk, pmklen, (&tag[0]) as u64, 22,
            (&data[0]) as u64, 76, out, outlen)
    }
    return sha1.prf(pmk, pmklen, (&tag[0]) as u64, 22,
        (&data[0]) as u64, 76, out, outlen)
}

// ==================================================================
// DER PRUEFWERT
// ==================================================================
fn mic_verfahren(akm: u64) -> u64 {
    if akm == 1 || akm == 2 || akm == 3 || akm == 4 {
        return MIC_HMAC_SHA1
    }
    if ist_sha256_akm(akm) {
        return MIC_AES_CMAC
    }
    return MIC_UNBEKANNT
}

const EAPOL_MAX: usize = 2048

fn mic_compute(kck: u64, kcklen: usize, eapol: u64, elen: usize,
    akm: u64, out: u64) -> bool {
    if elen < EAPOL_HEADER + EAPOL_COMMIT || elen > EAPOL_MAX {
        return false
    }
    if kcklen != KCK_LEN {
        return false
    }
    let v: u64 = mic_verfahren(akm)
    if v == MIC_UNBEKANNT {
        return false
    }
    var buf: [u8; 2048] = [0 as u8; 2048]
    var i: usize = 0
    while i < elen {
        buf[i] = octets.load_byte(eapol, i)
        i = i + 1
    }
    let mo: usize = eapol_mic_offset()
    i = 0
    while i < MIC_LEN {
        buf[mo + i] = 0 as u8
        i = i + 1
    }
    if v == MIC_HMAC_SHA1 {
        var full: [u8; 20] = [0 as u8; 20]
        sha1.hmac(kck, kcklen, (&buf[0]) as u64, elen,
            (&full[0]) as u64)
        i = 0
        while i < MIC_LEN {
            octets.store_byte(out, i, full[i])
            i = i + 1
        }
        return true
    }
    return aes.cmac(kck, kcklen, (&buf[0]) as u64, elen, out)
}

fn mic_check(kck: u64, kcklen: usize, eapol: u64, elen: usize,
    akm: u64) -> bool {
    var soll: [u8; 16] = [0 as u8; 16]
    if !mic_compute(kck, kcklen, eapol, elen, akm, (&soll[0]) as u64) {
        return false
    }
    let mo: usize = eapol_mic_offset()
    if elen < mo + MIC_LEN {
        return false
    }
    var diff: u64 = 0
    var i: usize = 0
    while i < MIC_LEN {
        diff = diff | ((soll[i] ^ octets.load_byte(eapol, mo + i)) as u64)
        i = i + 1
    }
    return diff == 0
}

// ==================================================================
// DIE SCHLUESSELDATEN
// ==================================================================
//   0xDD  Laenge  00-0F-AC  Typ  Inhalt
fn key_data_unwrap(kek: u64, keklen: usize, payload: u64,
    dlen: usize, out: u64, outmax: usize) -> i64 {
    if dlen < 24 || dlen % 8 != 0 || dlen > 264 {
        return -1
    }
    if dlen - 8 > outmax {
        return -1
    }
    if !aes.key_unwrap(kek, keklen, payload, dlen, out) {
        return -1
    }
    return (dlen - 8) as i64
}

fn gtk_find(payload: u64, dlen: usize, out: u64, outmax: usize,
    number: *mut u64) -> i64 {
    var at: usize = 0
    while at + 2 <= dlen {
        let id: u64 = octets.load_byte(payload, at) as u64
        let l: usize = octets.load_byte(payload, at + 1) as usize
        if at + 2 + l > dlen {
            return -1
        }
        if id == 0xDD && l >= 6 {
            if (octets.load_byte(payload, at + 2) as u64) == 0
                && (octets.load_byte(payload, at + 3) as u64) == 0x0F
                && (octets.load_byte(payload, at + 4) as u64) == 0xAC
                && (octets.load_byte(payload, at + 5) as u64) == 1 {
                let kl: usize = l - 6
                if kl == 0 || kl > outmax {
                    return -1
                }
                *number = (octets.load_byte(payload, at + 6) as u64) & 3
                var i: usize = 0
                while i < kl {
                    octets.store_byte(out, i, octets.load_byte(payload, at + 8 + i))
                    i = i + 1
                }
                return kl as i64
            }
        }
        if id == 0 && l == 0 {
            return -1
        }
        at = at + 2 + l
    }
    return -1
}
