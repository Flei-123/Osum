export {
    Rule, rule_new, etsi_rule, may_send, may_active_find,
    to_freq, off_freq, band_from_freq,
    BAND_24, BAND_5, BAND_6, DFS_MISSING
}

const BAND_24: u64 = 1
const BAND_5: u64 = 2
const BAND_6: u64 = 3

const DFS_MISSING: bool = true

struct Rule {
    dbm: u64,
    dfs: bool,
    indoor_only: bool,
    passive_only: bool,
}

fn rule_new() -> Rule {
    return Rule { dbm: 0, dfs: false, indoor_only: false,
        passive_only: false }
}

// ------------------------------------------------- Kanal -> Frequenz
fn to_freq(chan: u64, band: u64) -> i64 {
    if band == BAND_24 {
        if chan >= 1 && chan <= 13 {
            return (2407 + chan * 5) as i64
        }
        if chan == 14 {
            return 2484
        }
        return -1
    }
    if band == BAND_5 {
        if chan >= 32 && chan <= 177 {
            return (5000 + chan * 5) as i64
        }
        return -1
    }
    if band == BAND_6 {
        if chan == 2 {
            return 5935
        }
        if chan >= 1 && chan <= 233 {
            return (5950 + chan * 5) as i64
        }
        return -1
    }
    return -1
}

// ------------------------------------------------- Frequenz -> Kanal
fn off_freq(mhz: u64) -> i64 {
    if mhz == 2484 {
        return 14
    }
    if mhz >= 2412 && mhz <= 2472 && (mhz - 2412) % 5 == 0 {
        return ((mhz - 2412) / 5 + 1) as i64
    }
    if mhz == 5935 {
        return 2
    }
    if mhz >= 5160 && mhz <= 5885 && mhz % 5 == 0 {
        return ((mhz - 5000) / 5) as i64
    }
    if mhz >= 5955 && mhz <= 7115 && (mhz - 5950) % 5 == 0 {
        return ((mhz - 5950) / 5) as i64
    }
    return -1
}

fn band_from_freq(mhz: u64) -> u64 {
    if mhz >= 2400 && mhz <= 2500 {
        return BAND_24
    }
    if mhz >= 5150 && mhz <= 5895 {
        return BAND_5
    }
    if mhz >= 5925 && mhz <= 7125 {
        return BAND_6
    }
    return 0
}

fn etsi_rule(band: u64, chan: u64, r: *mut Rule) -> bool {
    (*r).dbm = 0
    (*r).dfs = false
    (*r).indoor_only = false
    (*r).passive_only = false

    if band == BAND_24 {
        if chan >= 1 && chan <= 13 {
            (*r).dbm = 20
            return true
        }
        return false
    }

    if band == BAND_5 {
        if chan >= 36 && chan <= 48 && (chan - 36) % 4 == 0 {
            (*r).dbm = 23
            (*r).indoor_only = true
            return true
        }
        if chan >= 52 && chan <= 64 && (chan - 52) % 4 == 0 {
            (*r).dbm = 23
            (*r).indoor_only = true
            (*r).dfs = true
            (*r).passive_only = true
            return true
        }
        if chan >= 100 && chan <= 140 && (chan - 100) % 4 == 0 {
            (*r).dbm = 30
            (*r).dfs = true
            (*r).passive_only = true
            return true
        }
        return false
    }

    if band == BAND_6 {
        if chan >= 1 && chan <= 93 && chan % 4 == 1 {
            (*r).dbm = 23
            (*r).indoor_only = true
            return true
        }
        return false
    }

    return false
}

fn may_send(band: u64, chan: u64) -> bool {
    var r: Rule = rule_new()
    if !etsi_rule(band, chan, &r) {
        return false
    }
    if r.dfs && DFS_MISSING {
        return false
    }
    return true
}

fn may_active_find(band: u64, chan: u64) -> bool {
    var r: Rule = rule_new()
    if !etsi_rule(band, chan, &r) {
        return false
    }
    if r.passive_only {
        return false
    }
    if r.dfs && DFS_MISSING {
        return false
    }
    return true
}
