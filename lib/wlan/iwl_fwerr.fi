import wlan.iwl_probe
import wlan.iwl_pwr

export { FwErr, fwerr_new, fwerr_capture, fwerr_capture_umac, fwerr_count, fwerr_ptr, fwerr_word, fwerr_valid_ptr, MEM_RADDR, MEM_RDAT, W_VALID, W_ID, W_BLINK2, W_ILINK1, W_DATA1, W_DATA2, W_HCMD }

const MEM_RADDR: u64 = 0x40C
const MEM_RDAT: u64 = 0x41C
const SRAM_MIN: u64 = 0x400000
const SRAM_MAX: u64 = 0x900000
const W_VALID: u64 = 0
const W_ID: u64 = 1
const W_BLINK2: u64 = 2
const W_ILINK1: u64 = 3
const W_DATA1: u64 = 4
const W_DATA2: u64 = 5
const W_HCMD: u64 = 6

struct FwErr {
    ptr: u64,
    count: u64,
    w: [u64; 7]
}

fn umac_word(k: u64) -> u64 {
    if k == W_VALID { return 0 }
    if k == W_ID { return 1 }
    if k == W_BLINK2 { return 3 }
    if k == W_ILINK1 { return 4 }
    if k == W_DATA1 { return 6 }
    if k == W_DATA2 { return 7 }
    return 13
}

fn table_word(k: u64) -> u64 {
    if k == W_VALID { return 0 }
    if k == W_ID { return 1 }
    if k == W_BLINK2 { return 4 }
    if k == W_ILINK1 { return 5 }
    if k == W_DATA1 { return 7 }
    if k == W_DATA2 { return 8 }
    return 23
}

fn fwerr_new() -> FwErr {
    var e: FwErr = FwErr { ptr: 0, count: 0, w: [0 as u64; 7] }
    return e
}

fn fwerr_valid_ptr(ptr: u64) -> bool {
    return ptr >= SRAM_MIN && ptr < SRAM_MAX && (ptr & 3) == 0
}

fn fwerr_capture(p: *mut iwl_probe.Probe, ptr: u64, e: *mut FwErr) -> bool {
    return capture_table(p, ptr, e, false)
}

fn fwerr_capture_umac(p: *mut iwl_probe.Probe, ptr: u64, e: *mut FwErr) -> bool {
    return capture_table(p, ptr, e, true)
}

fn capture_table(p: *mut iwl_probe.Probe, ptr: u64, e: *mut FwErr, umac: bool) -> bool {
    (*e).ptr = ptr
    (*e).count = 0
    if !fwerr_valid_ptr(ptr) { return false }
    if iwl_pwr.mac_access_get(p) < 0 { return false }
    var i: u64 = 0
    while i < 7 {
        var word: u64 = table_word(i)
        if umac { word = umac_word(i) }
        iwl_pwr.wr(p, MEM_RADDR, ptr + word * 4)
        (*e).w[i as usize] = iwl_pwr.rd(p, MEM_RDAT)
        i = i + 1
    }
    iwl_pwr.mac_access_put(p)
    (*e).count = 7
    return true
}

fn fwerr_count(e: *mut FwErr) -> u64 { return (*e).count }
fn fwerr_ptr(e: *mut FwErr) -> u64 { return (*e).ptr }
fn fwerr_word(e: *mut FwErr, k: u64) -> u64 { return (*e).w[k as usize] }
