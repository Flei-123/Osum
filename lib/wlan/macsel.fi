import wlan.device
import wlan.iwl_ops
import wlan.macplan

export { setup, scan_start, scan_state, rssi, peer_add, auth_ok, associated, authorize }

fn setup(g: *mut device.Device, o: *mut iwl_ops.Mvm) -> i64 {
    if !device.lifecycle_on(g) { return iwl_ops.ops_setup(o) }
    var mac: [u8; 6] = [0; 6]
    device.address_of(g, (&mac[0]) as u64)
    if device.lifecycle(g, device.LC_SET_ADDR, (&mac[0]) as u64) < 0 { return -1 }
    return device.lifecycle(g, macplan.EV_UP, 0)
}

fn scan_start(g: *mut device.Device, o: *mut iwl_ops.Mvm, ssid: u64, ssid_len: u64) -> i64 {
    if !device.lifecycle_on(g) { return iwl_ops.ops_scan_start(o, ssid, ssid_len) }
    return device.lifecycle(g, macplan.EV_SCAN, 0)
}

fn scan_state(g: *mut device.Device, o: *mut iwl_ops.Mvm) -> u64 {
    if !device.lifecycle_on(g) { return iwl_ops.ops_scan_state(o) }
    return device.lifecycle(g, device.LC_QUERY_SCAN, 0) as u64
}

fn rssi(g: *mut device.Device, o: *mut iwl_ops.Mvm) -> i64 {
    if !device.lifecycle_on(g) { return iwl_ops.ops_rssi(o) }
    return device.lifecycle(g, device.LC_QUERY_RSSI, 0)
}

fn peer_add(g: *mut device.Device, o: *mut iwl_ops.Mvm, bssid: u64) -> i64 {
    if !device.lifecycle_on(g) { return iwl_ops.ops_peer_add(o, bssid) }
    if device.lifecycle(g, device.LC_SET_BSSID, bssid) < 0 { return -1 }
    return device.lifecycle(g, macplan.EV_JOIN_RSN, 0)
}

fn auth_ok(g: *mut device.Device) -> i64 {
    if !device.lifecycle_on(g) { return 0 }
    return device.lifecycle(g, macplan.EV_AUTH_OK, 0)
}

fn associated(g: *mut device.Device, o: *mut iwl_ops.Mvm, aid: u64) -> i64 {
    if !device.lifecycle_on(g) { return iwl_ops.ops_associated(o, aid) }
    if device.lifecycle(g, device.LC_SET_AID, aid) < 0 { return -1 }
    return device.lifecycle(g, macplan.EV_ASSOC_OK, 0)
}

fn authorize(g: *mut device.Device) -> i64 {
    if !device.lifecycle_on(g) { return 0 }
    return device.lifecycle(g, macplan.EV_AUTHORIZE, 0)
}
