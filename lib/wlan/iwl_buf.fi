import wlan.iwl_le
import libc.octets

export { HDR, HDR_WIDE, GROUP_LONG, hdr, widen, wide_group, hdr_len }

const HDR: u64 = 4
const HDR_WIDE: u64 = 8
const GROUP_LONG: u64 = 1

fn hdr(a: u64, cmd: u64, qid: u64, slot: u64) {
    octets.st8(a, 0, cmd)
    octets.st8(a, 1, 0)
    octets.st16(a, 2, ((qid & 0x1F) << 8) | (slot & 0xFF))
}

fn widen(a: u64, len: u64, group: u64) -> u64 {
    if len < HDR { return len }
    var i: u64 = len
    while i > HDR {
        i = i - 1
        octets.st8(a, i + (HDR_WIDE - HDR), octets.ld8(a, i))
    }
    octets.st8(a, 1, group)
    octets.st16(a, 4, len - HDR)
    octets.st8(a, 6, 0)
    octets.st8(a, 7, 0)
    return len + (HDR_WIDE - HDR)
}

fn wide_group(a: u64) -> u64 { return octets.ld8(a, 1) }

fn hdr_len(a: u64) -> u64 {
    if octets.ld8(a, 1) != 0 { return HDR_WIDE }
    return HDR
}
