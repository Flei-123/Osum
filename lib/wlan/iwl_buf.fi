// SPDX-License-Identifier: GPL-2.0-only
export { HDR, st8, ld8, st16, st32, st64, ld16, ld32, zero, hdr }

const HDR: u64 = 4

fn st8(a: u64, o: u64, v: u64) { *((a + o) as *mut u8) = (v & 255) as u8 }
fn ld8(a: u64, o: u64) -> u64 { let b: u8 = *((a + o) as *mut u8)
    return b as u64 }
fn st16(a: u64, o: u64, v: u64) { st8(a, o, v)
    st8(a, o + 1, v >> 8) }
fn st32(a: u64, o: u64, v: u64) { st16(a, o, v)
    st16(a, o + 2, v >> 16) }
fn st64(a: u64, o: u64, v: u64) { st32(a, o, v)
    st32(a, o + 4, v >> 32) }
fn ld16(a: u64, o: u64) -> u64 { return ld8(a, o) | (ld8(a, o + 1) << 8) }
fn ld32(a: u64, o: u64) -> u64 { return ld16(a, o) | (ld16(a, o + 2) << 16) }

fn zero(a: u64, n: u64) {
    var i: u64 = 0
    while i < n { st8(a, i, 0)
        i = i + 1 }
}

fn hdr(a: u64, cmd: u64, qid: u64, slot: u64) {
    st8(a, 0, cmd)
    st8(a, 1, 0)
    st16(a, 2, ((qid & 0x1F) << 8) | (slot & 0xFF))
}
