export { arp_probe_build, ARP_PROBE_LEN }

const ARP_PROBE_LEN: usize = 42

fn put(p: u64, i: usize, v: u64) {
    *((p + i as u64) as *mut u8) = (v & 255) as u8
}

fn get(p: u64, i: usize) -> u64 {
    let b: u8 = *((p + i as u64) as *mut u8)
    return b as u64
}

fn put_ip(p: u64, i: usize, ip: u64) {
    put(p, i, ip >> 24)
    put(p, i + 1, ip >> 16)
    put(p, i + 2, ip >> 8)
    put(p, i + 3, ip)
}

fn arp_probe_build(out: u64, mac: u64, src_ip: u64, dst_ip: u64) -> usize {
    var i: usize = 0
    while i < 6 {
        put(out, i, 255)
        put(out, 6 + i, get(mac, i))
        put(out, 32 + i, 0)
        put(out, 22 + i, get(mac, i))
        i = i + 1
    }
    put(out, 12, 8)
    put(out, 13, 6)
    put(out, 14, 0)
    put(out, 15, 1)
    put(out, 16, 8)
    put(out, 17, 0)
    put(out, 18, 6)
    put(out, 19, 4)
    put(out, 20, 0)
    put(out, 21, 1)
    put_ip(out, 28, src_ip)
    put_ip(out, 38, dst_ip)
    return ARP_PROBE_LEN
}
