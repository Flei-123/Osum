import libc.octets

export { arp_probe_build, ARP_PROBE_LEN }

const ARP_PROBE_LEN: usize = 42

fn put_ip(p: u64, i: usize, ip: u64) {
    octets.st8_idx(p, i, ip >> 24)
    octets.st8_idx(p, i + 1, ip >> 16)
    octets.st8_idx(p, i + 2, ip >> 8)
    octets.st8_idx(p, i + 3, ip)
}

fn arp_probe_build(out: u64, mac: u64, src_ip: u64, dst_ip: u64) -> usize {
    var i: usize = 0
    while i < 6 {
        octets.st8_idx(out, i, 255)
        octets.st8_idx(out, 6 + i, octets.ld8_idx(mac, i))
        octets.st8_idx(out, 32 + i, 0)
        octets.st8_idx(out, 22 + i, octets.ld8_idx(mac, i))
        i = i + 1
    }
    octets.st8_idx(out, 12, 8)
    octets.st8_idx(out, 13, 6)
    octets.st8_idx(out, 14, 0)
    octets.st8_idx(out, 15, 1)
    octets.st8_idx(out, 16, 8)
    octets.st8_idx(out, 17, 0)
    octets.st8_idx(out, 18, 6)
    octets.st8_idx(out, 19, 4)
    octets.st8_idx(out, 20, 0)
    octets.st8_idx(out, 21, 1)
    put_ip(out, 28, src_ip)
    put_ip(out, 38, dst_ip)
    return ARP_PROBE_LEN
}
