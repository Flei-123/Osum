import wlan.iwl_le

export { W, w_ch, w_s, w_dec, w_int, w_hex, w_nl }

struct W {
    a: u64,
    cap: u64,
    n: u64
}

fn w_ch(w: *mut W, c: u64) {
    if (*w).n + 1 < (*w).cap {
        iwl_le.st8((*w).a, (*w).n, c)
        (*w).n = (*w).n + 1
    }
}

fn w_s(w: *mut W, s: u64) {
    var i: u64 = 0
    while iwl_le.ld8(s, i) != 0 {
        w_ch(w, iwl_le.ld8(s, i))
        i = i + 1
    }
}

fn w_dec(w: *mut W, v: u64) {
    var tmp: [u8; 20] = [0 as u8; 20]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        w_ch(w, 48)
        return
    }
    while x != 0 {
        tmp[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        w_ch(w, tmp[n as usize] as u64)
    }
}

fn w_int(w: *mut W, v: i64) {
    if v < 0 {
        w_ch(w, 45)
        w_dec(w, (0 - v) as u64)
    } else {
        w_dec(w, v as u64)
    }
}

fn hexd(v: u64) -> u64 {
    if v < 10 { return 48 + v }
    return 87 + v
}

fn w_hex(w: *mut W, v: u64, digits: u64) {
    var i: u64 = digits
    while i > 0 {
        i = i - 1
        w_ch(w, hexd((v >> (i * 4)) & 15))
    }
}

fn w_nl(w: *mut W) { w_ch(w, 10) }
