// SPDX-License-Identifier: GPL-2.0-only
// lib/wlan/iwl_pwr.fi -- iwlwifi gen2 (Qu/QuZ/AX200) power/reset/PRPH sequences, milestone M2.
//
// Every register access goes through the Mmio table of iwl_probe.fi, so the host gate runs the
// REAL sequence against a CSR model that enforces the hardware handshakes (tools/wlan/iwlpwr.fi).
// Bit values and the order are from memory of iwl-csr.h + pcie/trans.c (iwl_pcie_apm_stop_master,
// iwl_pcie_apm_init, iwl_trans_grab_nic_access, iwl_read/write_prph_no_grab) and are NOT yet
// confirmed on the laptop -- the model proves ORDER and handshake logic, not Intel's numbering.
// Polling is bounded by a read count (POLL_MAX); the kernel glue's rd32 hook is expected to add
// the real udelay (the library has no clock).

import wlan.iwl_probe

export {
    rd, wr, poll, set_bits, stop_master, sw_reset, apm_init, mac_access_get, mac_access_put,
    prph_rd, prph_wr, int_disable, power_up, fw_kick, prepare_card, settle, snap_regs, snap_fh, snap_alive, snap_warm, nic_config,
    prph_wr_win, prph_or_win,
    E_PWR_MASTER, E_PWR_CLOCK, E_PWR_ACCESS, E_PWR_NOTREADY, POLL_MAX, SNAP_N,
    CSR_INT_MASK, CSR_FH_INT_STATUS, CSR_CTXT_INFO_BA, CSR_CTXT_INFO_BA_HI,
    HBUS_WADDR, HBUS_WDAT, HBUS_RADDR, HBUS_RDAT, HBUS_WRPTR, UREG_CPU_INIT_RUN,
    RESET_SW, RESET_STOP_MASTER, RESET_MASTER_DISABLED,
    GP_CLOCK_READY, GP_INIT_DONE, GP_ACCESS_REQ, GP_SLEEP
}

const CSR_INT_MASK: u64 = 0x00C
const CSR_MBOX_SET: u64 = 0x088
const CSR_GIO_CHICKEN: u64 = 0x100
const CSR_DBG_HPET: u64 = 0x240
const CSR_DBG_LINK_PWR: u64 = 0x250
const CSR_UCODE_GP1: u64 = 0x054
const CSR_UCODE_GP2: u64 = 0x058
const PRPH_SB_CPU1: u64 = 0xA01E30
const PRPH_SB_CPU2: u64 = 0xA01E34
const PRPH_WFPM_GP2: u64 = 0xA030B4
const PRPH_SB_MODIFY_CFG: u64 = 0xA03088
const FH_CPU1_HDR_ADDR: u64 = 0x1E78
const FH_CPU2_HDR_ADDR: u64 = 0x1E7C
const HWIF_NIC_READY: u64 = 0x00400000
const HWIF_PREPARE: u64 = 0x08000000
const HWIF_HAP_WAKE_L1A: u64 = 0x00080000
const LINK_PWR_DISABLED: u64 = 0x80000000
const GIO_L1A_NO_L0S_RX: u64 = 0x00800000
const CSR_GIO_REG: u64 = 0x03C
const GIO_L0S_DISABLED: u64 = 0x2
const HPET_VAL: u64 = 0xFFFF0000
const MBOX_OS_ALIVE: u64 = 0x20
const READY_POLL: u64 = 2000
const PREPARE_ROUNDS: u64 = 10
const PREPARE_POLL: u64 = 20000
const RESET_SETTLE: u64 = 8000
const SNAP_N: u64 = 8
const HWIF_NIC_CFG_MASK: u64 = 0x0000F30F
const HWIF_RADIO_MAC_SI: u64 = 0x00000300
const FH_TSSR_TX_STATUS: u64 = 0x1EB0
const FH_TCSR_CFG9: u64 = 0x1E20
const FH_TCSR_STS9: u64 = 0x1E28
const FH_SRAM9: u64 = 0x19C8
const FH_TFDIB0_9: u64 = 0x1948
const FH_TFDIB1_9: u64 = 0x194C
const FH_LOAD_STATUS: u64 = 0x1AF0
const CSR_FH_INT_STATUS: u64 = 0x010
const CSR_CTXT_INFO_BA: u64 = 0x040
const CSR_CTXT_INFO_BA_HI: u64 = 0x044

const HBUS_WADDR: u64 = 0x444
const HBUS_RADDR: u64 = 0x448
const HBUS_WDAT: u64 = 0x44C
const HBUS_RDAT: u64 = 0x450
const HBUS_WRPTR: u64 = 0x460

const UREG_CPU_INIT_RUN: u64 = 0xA05C44

const RESET_SW: u64 = 0x80
const RESET_STOP_MASTER: u64 = 0x200
const RESET_MASTER_DISABLED: u64 = 0x100

const GP_CLOCK_READY: u64 = 0x1
const GP_INIT_DONE: u64 = 0x4
const GP_ACCESS_REQ: u64 = 0x8
const GP_SLEEP: u64 = 0x10

const INT_ALIVE: u64 = 0x1
const INT_WAKEUP: u64 = 0x2
const PRPH_MASK: u64 = 0xFFFFF
const PRPH_DWORD: u64 = 0x03000000   // 4-octet access: (3 << 24)

const POLL_MAX: u64 = 25000

const E_PWR_MASTER: i64 = -20
const E_PWR_CLOCK: i64 = -21
const E_PWR_ACCESS: i64 = -22
const E_PWR_NOTREADY: i64 = -23

fn rd(p: *mut iwl_probe.Probe, off: u64) -> u64 {
    let m: iwl_probe.Mmio = (*p).m
    (*p).reads = (*p).reads + 1
    return m.rd32((*p).ctx, off) & 0xFFFFFFFF
}

fn wr(p: *mut iwl_probe.Probe, off: u64, v: u64) {
    let m: iwl_probe.Mmio = (*p).m
    (*p).writes = (*p).writes + 1
    m.wr32((*p).ctx, off, v & 0xFFFFFFFF)
}

fn set_bits(p: *mut iwl_probe.Probe, off: u64, bits: u64) {
    wr(p, off, rd(p, off) | bits)
}

fn clr_bits(p: *mut iwl_probe.Probe, off: u64, bits: u64) {
    wr(p, off, rd(p, off) & (0xFFFFFFFF ^ bits))
}

// Poll `off` until (value & mask) == want. true = reached, false = POLL_MAX reads used.
fn poll(p: *mut iwl_probe.Probe, off: u64, mask: u64, want: u64) -> bool {
    var i: u64 = 0
    while i < POLL_MAX {
        if rd(p, off) & mask == want { return true }
        i = i + 1
    }
    return false
}

// Mask all interrupts and ack whatever is pending (iwl_disable_interrupts).
fn int_disable(p: *mut iwl_probe.Probe) {
    wr(p, CSR_INT_MASK, 0)
    wr(p, iwl_probe.CSR_INT, 0xFFFFFFFF)
    wr(p, CSR_FH_INT_STATUS, 0xFFFFFFFF)
}

// Stop bus-master DMA before a reset; the device must report MASTER_DISABLED.
fn stop_master(p: *mut iwl_probe.Probe) -> i64 {
    set_bits(p, iwl_probe.CSR_RESET, RESET_STOP_MASTER)
    if !poll(p, iwl_probe.CSR_RESET, RESET_MASTER_DISABLED, RESET_MASTER_DISABLED) { return E_PWR_MASTER }
    return 0
}

fn settle(p: *mut iwl_probe.Probe, n: u64) {
    var i: u64 = 0
    while i < n {
        let _v: u64 = rd(p, iwl_probe.CSR_HW_REV)
        i = i + 1
    }
}

fn sw_reset(p: *mut iwl_probe.Probe) {
    set_bits(p, iwl_probe.CSR_RESET, RESET_SW)
    settle(p, RESET_SETTLE)
}

fn hw_ready(p: *mut iwl_probe.Probe, polls: u64) -> bool {
    set_bits(p, iwl_probe.CSR_HW_IF_CONFIG, HWIF_NIC_READY)
    var i: u64 = 0
    while i < polls {
        if rd(p, iwl_probe.CSR_HW_IF_CONFIG) & HWIF_NIC_READY != 0 {
            set_bits(p, CSR_MBOX_SET, MBOX_OS_ALIVE)
            return true
        }
        i = i + 1
    }
    return false
}

fn prepare_card(p: *mut iwl_probe.Probe) -> i64 {
    if hw_ready(p, READY_POLL) { return 0 }
    set_bits(p, CSR_DBG_LINK_PWR, LINK_PWR_DISABLED)
    settle(p, READY_POLL)
    var it: u64 = 0
    while it < PREPARE_ROUNDS {
        set_bits(p, iwl_probe.CSR_HW_IF_CONFIG, HWIF_PREPARE)
        if hw_ready(p, PREPARE_POLL) { return 0 }
        it = it + 1
    }
    return E_PWR_NOTREADY
}

fn snap_regs(p: *mut iwl_probe.Probe, out: u64) {
    *((out) as *mut u64) = rd(p, iwl_probe.CSR_HW_IF_CONFIG)
    *((out + 8) as *mut u64) = rd(p, iwl_probe.CSR_INT)
    *((out + 16) as *mut u64) = rd(p, CSR_INT_MASK)
    *((out + 24) as *mut u64) = rd(p, CSR_FH_INT_STATUS)
    *((out + 32) as *mut u64) = rd(p, iwl_probe.CSR_RESET)
    *((out + 40) as *mut u64) = rd(p, iwl_probe.CSR_GP_CNTRL)
    *((out + 48) as *mut u64) = rd(p, iwl_probe.CSR_HW_REV)
    *((out + 56) as *mut u64) = rd(p, CSR_UCODE_GP1)
}

fn prph_wr_win(p: *mut iwl_probe.Probe, addr: u64, v: u64) -> i64 {
    let r: i64 = mac_access_get(p)
    if r != 0 {
        mac_access_put(p)
        return r
    }
    prph_wr(p, addr, v)
    mac_access_put(p)
    return 0
}

fn prph_or_win(p: *mut iwl_probe.Probe, addr: u64, bits: u64) -> i64 {
    let r: i64 = mac_access_get(p)
    if r != 0 {
        mac_access_put(p)
        return r
    }
    let cur: u64 = prph_rd(p, addr)
    prph_wr(p, addr, cur | bits)
    mac_access_put(p)
    return 0
}

fn nic_config(p: *mut iwl_probe.Probe, phy_sku: u64) -> i64 {
    if iwl_probe.has_ctxinfo((*p).fam) { return 0 }
    let rev: u64 = rd(p, iwl_probe.CSR_HW_REV)
    let rtype: u64 = phy_sku & 0x3
    let rstep: u64 = (phy_sku >> 2) & 0x3
    let rdash: u64 = (phy_sku >> 4) & 0x3
    let val: u64 = (rev & 0xF) | (rtype << 10) | (rdash << 12) | (rstep << 14)
    let cur: u64 = rd(p, iwl_probe.CSR_HW_IF_CONFIG)
    wr(p, iwl_probe.CSR_HW_IF_CONFIG, (cur & (0xFFFFFFFF ^ (HWIF_NIC_CFG_MASK | HWIF_RADIO_MAC_SI))) | val)
    return 0
}

fn snap_alive(p: *mut iwl_probe.Probe, out: u64) {
    *((out) as *mut u64) = rd(p, iwl_probe.CSR_INT)
    *((out + 8) as *mut u64) = rd(p, CSR_FH_INT_STATUS)
    *((out + 16) as *mut u64) = rd(p, CSR_UCODE_GP1)
    *((out + 24) as *mut u64) = rd(p, CSR_UCODE_GP2)
    *((out + 32) as *mut u64) = 0
    *((out + 40) as *mut u64) = 0
    *((out + 48) as *mut u64) = 0
    *((out + 64) as *mut u64) = 0
    *((out + 72) as *mut u64) = 0
    *((out + 80) as *mut u64) = 0
    *((out + 88) as *mut u64) = 0
    let r: i64 = mac_access_get(p)
    if r == 0 {
        *((out + 64) as *mut u64) = rd(p, FH_LOAD_STATUS)
        *((out + 72) as *mut u64) = prph_rd(p, FH_CPU1_HDR_ADDR)
        *((out + 80) as *mut u64) = prph_rd(p, FH_CPU2_HDR_ADDR)
        *((out + 88) as *mut u64) = prph_rd(p, PRPH_SB_MODIFY_CFG)
        *((out + 32) as *mut u64) = prph_rd(p, PRPH_SB_CPU1)
        *((out + 40) as *mut u64) = prph_rd(p, PRPH_SB_CPU2)
        *((out + 48) as *mut u64) = prph_rd(p, PRPH_WFPM_GP2)
        mac_access_put(p)
    }
}

fn snap_warm(p: *mut iwl_probe.Probe, out: u64) {
    *((out) as *mut u64) = rd(p, iwl_probe.CSR_GP_CNTRL)
    *((out + 8) as *mut u64) = rd(p, iwl_probe.CSR_HW_IF_CONFIG)
    *((out + 16) as *mut u64) = rd(p, CSR_UCODE_GP1)
    *((out + 24) as *mut u64) = rd(p, CSR_UCODE_GP2)
    *((out + 32) as *mut u64) = rd(p, iwl_probe.CSR_HW_REV)
}

fn snap_fh(p: *mut iwl_probe.Probe, out: u64) {
    let r: i64 = mac_access_get(p)
    *((out) as *mut u64) = rd(p, FH_TSSR_TX_STATUS)
    *((out + 8) as *mut u64) = rd(p, FH_TCSR_CFG9)
    *((out + 16) as *mut u64) = rd(p, FH_TCSR_STS9)
    *((out + 24) as *mut u64) = rd(p, FH_SRAM9)
    *((out + 32) as *mut u64) = rd(p, FH_TFDIB0_9)
    *((out + 40) as *mut u64) = rd(p, FH_TFDIB1_9)
    *((out + 48) as *mut u64) = rd(p, FH_LOAD_STATUS)
    *((out + 56) as *mut u64) = rd(p, iwl_probe.CSR_GP_CNTRL)
    if r == 0 { mac_access_put(p) }
}

// Request the clock: INIT_DONE, then wait for MAC_CLOCK_READY.
fn apm_init(p: *mut iwl_probe.Probe) -> i64 {
    set_bits(p, CSR_GIO_CHICKEN, GIO_L1A_NO_L0S_RX)
    set_bits(p, CSR_DBG_HPET, HPET_VAL)
    set_bits(p, iwl_probe.CSR_HW_IF_CONFIG, HWIF_HAP_WAKE_L1A)
    set_bits(p, CSR_GIO_REG, GIO_L0S_DISABLED)
    set_bits(p, iwl_probe.CSR_GP_CNTRL, GP_INIT_DONE)
    if !poll(p, iwl_probe.CSR_GP_CNTRL, GP_CLOCK_READY, GP_CLOCK_READY) { return E_PWR_CLOCK }
    return 0
}

// PRPH (periphery) registers are only reachable while MAC_ACCESS_REQ is granted:
// clock ready AND not going to sleep.
fn mac_access_get(p: *mut iwl_probe.Probe) -> i64 {
    set_bits(p, iwl_probe.CSR_GP_CNTRL, GP_ACCESS_REQ)
    if !poll(p, iwl_probe.CSR_GP_CNTRL, GP_CLOCK_READY | GP_SLEEP, GP_CLOCK_READY) { return E_PWR_ACCESS }
    return 0
}

fn mac_access_put(p: *mut iwl_probe.Probe) {
    clr_bits(p, iwl_probe.CSR_GP_CNTRL, GP_ACCESS_REQ)
}

// Caller MUST hold mac access (mac_access_get). 20-bit address, 4-octet access.
fn prph_rd(p: *mut iwl_probe.Probe, addr: u64) -> u64 {
    wr(p, HBUS_RADDR, (addr & PRPH_MASK) | PRPH_DWORD)
    return rd(p, HBUS_RDAT)
}

fn prph_wr(p: *mut iwl_probe.Probe, addr: u64, v: u64) {
    wr(p, HBUS_WADDR, (addr & PRPH_MASK) | PRPH_DWORD)
    wr(p, HBUS_WDAT, v)
}

// Full M2 bring-up: interrupts off, master stop, reset, clock. Leaves the device clocked, quiet,
// mac access released. Returns 0 or E_PWR_*.
fn power_up(p: *mut iwl_probe.Probe) -> i64 {
    let _ready: i64 = prepare_card(p)
    int_disable(p)
    var r: i64 = stop_master(p)
    if r != 0 { return r }
    sw_reset(p)
    r = apm_init(p)
    if r != 0 { return r }
    int_disable(p)
    return 0
}

// Hand the context-info DMA address to the device, unmask ALIVE, start the CPU(s).
// `ba` is the (64-bit) bus address of the context info page.
fn fw_kick(p: *mut iwl_probe.Probe, ba: u64) -> i64 {
    wr(p, CSR_CTXT_INFO_BA, ba & 0xFFFFFFFF)
    wr(p, CSR_CTXT_INFO_BA_HI, ba >> 32)
    wr(p, CSR_INT_MASK, INT_ALIVE | INT_WAKEUP)
    let r: i64 = mac_access_get(p)
    if r != 0 { return r }
    prph_wr(p, UREG_CPU_INIT_RUN, 1)
    mac_access_put(p)
    return 0
}
