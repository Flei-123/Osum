import wlan.iwl_w
import wlan.iwl_rxscan

export {
    Tab, tab_new, tab_add, tab_count, tab_last_alive, tab_ptr, render, has_data, name_of,
    MAX_ROWS, ROW_WORDS, TAB_WORDS,
    X_BASE, X_MASK, X_INTX_OFF, X_INTX_ON, X_COAL, X_DRAM, X_WPTR, X_NIC, X_APM, X_MSI, X_SHAD, X_GP1, X_TX, X_DLY
}

const MAX_ROWS: u64 = 16
const ROW_WORDS: u64 = 8
const TAB_WORDS: u64 = 136

const X_BASE: u64 = 0
const X_MASK: u64 = 1
const X_INTX_OFF: u64 = 2
const X_INTX_ON: u64 = 3
const X_COAL: u64 = 4
const X_DRAM: u64 = 5
const X_WPTR: u64 = 6
const X_NIC: u64 = 7
const X_APM: u64 = 8
const X_MSI: u64 = 9
const X_SHAD: u64 = 10
const X_GP1: u64 = 11
const X_TX: u64 = 12
const X_DLY: u64 = 13

struct Tab {
    w: [u64; 136]
}

fn tab_new() -> Tab {
    var t: Tab = Tab { w: [0; 136] }
    return t
}

fn tab_ptr(t: *mut Tab) -> u64 { return (&(*t).w[0]) as u64 }

fn tab_count(t: *mut Tab) -> u64 { return (*t).w[0] }

fn tab_last_alive(t: *mut Tab) -> u64 {
    let n: u64 = (*t).w[0]
    if n == 0 { return 0 }
    return (*t).w[(1 + (n - 1) * ROW_WORDS + 7) as usize]
}

fn tab_add(t: *mut Tab, id: u64, int_v: u64, fh_v: u64, cpu1: u64, cpu2: u64, rx_state: u64, rx_nz: u64, alive: u64) {
    let n: u64 = (*t).w[0]
    if n >= MAX_ROWS { return }
    let b: u64 = 1 + n * ROW_WORDS
    (*t).w[b as usize] = id
    (*t).w[(b + 1) as usize] = int_v
    (*t).w[(b + 2) as usize] = fh_v
    (*t).w[(b + 3) as usize] = cpu1
    (*t).w[(b + 4) as usize] = cpu2
    (*t).w[(b + 5) as usize] = rx_state
    (*t).w[(b + 6) as usize] = rx_nz
    (*t).w[(b + 7) as usize] = alive
    (*t).w[0] = n + 1
}

fn at(words: u64, i: u64) -> u64 {
    return *((words + i * 8) as *mut u64)
}

fn has_data(words: u64) -> bool { return at(words, 0) != 0 }

fn name_of(id: u64, out: u64) {
    var n0: [u8; 5] = "base\0"
    var n1: [u8; 5] = "mask\0"
    var n2: [u8; 6] = "intx0\0"
    var n3: [u8; 6] = "intx1\0"
    var n4: [u8; 5] = "coal\0"
    var n5: [u8; 5] = "dram\0"
    var n6: [u8; 5] = "wptr\0"
    var n7: [u8; 4] = "nic\0"
    var n8: [u8; 4] = "apm\0"
    var n9: [u8; 4] = "msi\0"
    var n10: [u8; 5] = "shad\0"
    var n11: [u8; 4] = "gp1\0"
    var n12: [u8; 3] = "tx\0"
    var n13: [u8; 4] = "dly\0"
    var nx: [u8; 2] = "?\0"
    var src: u64 = (&nx[0]) as u64
    if id == X_BASE { src = (&n0[0]) as u64 }
    if id == X_MASK { src = (&n1[0]) as u64 }
    if id == X_INTX_OFF { src = (&n2[0]) as u64 }
    if id == X_INTX_ON { src = (&n3[0]) as u64 }
    if id == X_COAL { src = (&n4[0]) as u64 }
    if id == X_DRAM { src = (&n5[0]) as u64 }
    if id == X_WPTR { src = (&n6[0]) as u64 }
    if id == X_NIC { src = (&n7[0]) as u64 }
    if id == X_APM { src = (&n8[0]) as u64 }
    if id == X_MSI { src = (&n9[0]) as u64 }
    if id == X_SHAD { src = (&n10[0]) as u64 }
    if id == X_GP1 { src = (&n11[0]) as u64 }
    if id == X_TX { src = (&n12[0]) as u64 }
    if id == X_DLY { src = (&n13[0]) as u64 }
    var i: u64 = 0
    while *((src + i) as *mut u8) != 0 {
        *((out + i) as *mut u8) = *((src + i) as *mut u8)
        i = i + 1
    }
    *((out + i) as *mut u8) = 0
}

fn put_rx(w: *mut iwl_w.W, st: u64) {
    var s0: [u8; 3] = "no\0"
    var s1: [u8; 6] = "empty\0"
    var s2: [u8; 6] = "silen\0"
    var s3: [u8; 5] = "stts\0"
    var s4: [u8; 6] = "other\0"
    var src: u64 = (&s0[0]) as u64
    if st == iwl_rxscan.RX_EMPTY { src = (&s1[0]) as u64 }
    if st == iwl_rxscan.RX_ALIVE_SILENT { src = (&s2[0]) as u64 }
    if st == iwl_rxscan.RX_ALIVE_STTS { src = (&s3[0]) as u64 }
    if st == iwl_rxscan.RX_OTHER { src = (&s4[0]) as u64 }
    iwl_w.w_s(w, src)
}

fn render(w: *mut iwl_w.W, words: u64) {
    var k_x: [u8; 11] = "fail_exp2=\0"
    var k_i: [u8; 4] = " i=\0"
    var k_f: [u8; 4] = " f=\0"
    var k_c1: [u8; 5] = " c1=\0"
    var k_c2: [u8; 5] = " c2=\0"
    var k_rx: [u8; 5] = " rx=\0"
    var k_a: [u8; 4] = " a=\0"
    var nm: [u8; 8] = [0 as u8; 8]
    var i: u64 = 0
    let n: u64 = at(words, 0)
    while i < n {
        let b: u64 = 1 + i * ROW_WORDS
        iwl_w.w_s(w, (&k_x[0]) as u64)
        name_of(at(words, b), (&nm[0]) as u64)
        iwl_w.w_s(w, (&nm[0]) as u64)
        iwl_w.w_s(w, (&k_i[0]) as u64)
        iwl_w.w_hex(w, at(words, b + 1), 8)
        iwl_w.w_s(w, (&k_f[0]) as u64)
        iwl_w.w_hex(w, at(words, b + 2), 8)
        iwl_w.w_s(w, (&k_c1[0]) as u64)
        iwl_w.w_hex(w, at(words, b + 3), 8)
        iwl_w.w_s(w, (&k_c2[0]) as u64)
        iwl_w.w_hex(w, at(words, b + 4), 8)
        iwl_w.w_s(w, (&k_rx[0]) as u64)
        put_rx(w, at(words, b + 5))
        iwl_w.w_ch(w, 47)
        iwl_w.w_dec(w, at(words, b + 6))
        iwl_w.w_s(w, (&k_a[0]) as u64)
        iwl_w.w_dec(w, at(words, b + 7))
        iwl_w.w_nl(w)
        i = i + 1
    }
}
