import wlan.iwl_buf

export {
    CMD_MAC_CONTEXT, CMD_BINDING_CONTEXT, CTXT_ADD, CTXT_MODIFY, CTXT_REMOVE, CTXT_INVALID, MAC_TYPE_BSS_STA,
    MAC_CMD_LEN, BINDING_CMD_LEN, AC_COUNT,
    mvm_id_color, mvm_mac_ctx, mvm_mac_ac, mvm_mac_sta, mvm_binding
}

const CMD_MAC_CONTEXT: u64 = 0x28
const CMD_BINDING_CONTEXT: u64 = 0x2B

const CTXT_ADD: u64 = 1
const CTXT_MODIFY: u64 = 2
const CTXT_REMOVE: u64 = 3
const CTXT_INVALID: u64 = 0xFFFFFFFF

const MAC_TYPE_BSS_STA: u64 = 5
const AC_COUNT: u64 = 5

const MAC_COMMON_LEN: u64 = 100
const MAC_UNION_LEN: u64 = 48
const MAC_CMD_LEN: u64 = iwl_buf.HDR + MAC_COMMON_LEN + MAC_UNION_LEN
const BINDING_CMD_LEN: u64 = iwl_buf.HDR + 24

fn mvm_id_color(id: u64, color: u64) -> u64 { return (id & 0xFF) | ((color & 0xFF) << 8) }

fn copy_mac(a: u64, o: u64, mac: u64) {
    var i: u64 = 0
    while i < 6 {
        iwl_buf.st8(a, o + i, iwl_buf.ld8(mac, i))
        i = i + 1
    }
}

fn mvm_mac_ctx(a: u64, qid: u64, slot: u64, id_color: u64, action: u64, mac_type: u64, tsf_id: u64, node: u64, bssid: u64,
               cck: u64, ofdm: u64, prot: u64, short_pre: u64, short_slot: u64, filter: u64, qos: u64) -> u64 {
    let h: u64 = iwl_buf.HDR
    iwl_buf.zero(a, MAC_CMD_LEN)
    iwl_buf.hdr(a, CMD_MAC_CONTEXT, qid, slot)
    iwl_buf.st32(a, h, id_color)
    iwl_buf.st32(a, h + 4, action)
    iwl_buf.st32(a, h + 8, mac_type)
    iwl_buf.st32(a, h + 12, tsf_id)
    copy_mac(a, h + 16, node)
    copy_mac(a, h + 24, bssid)
    iwl_buf.st32(a, h + 32, cck)
    iwl_buf.st32(a, h + 36, ofdm)
    iwl_buf.st32(a, h + 40, prot)
    iwl_buf.st32(a, h + 44, short_pre)
    iwl_buf.st32(a, h + 48, short_slot)
    iwl_buf.st32(a, h + 52, filter)
    iwl_buf.st32(a, h + 56, qos)
    return MAC_CMD_LEN
}

fn mvm_mac_ac(a: u64, ac: u64, cw_min: u64, cw_max: u64, aifsn: u64, fifos: u64, txop: u64) {
    let o: u64 = iwl_buf.HDR + 60 + (ac * 8)
    iwl_buf.st16(a, o, cw_min)
    iwl_buf.st16(a, o + 2, cw_max)
    iwl_buf.st8(a, o + 4, aifsn)
    iwl_buf.st8(a, o + 5, fifos)
    iwl_buf.st16(a, o + 6, txop)
}

fn mvm_mac_sta(a: u64, is_assoc: u64, dtim_time: u64, dtim_tsf: u64, bi: u64, dtim_interval: u64, data_policy: u64,
               listen_interval: u64, assoc_id: u64, beacon_arrive: u64) {
    let o: u64 = iwl_buf.HDR + MAC_COMMON_LEN
    iwl_buf.st32(a, o, is_assoc)
    iwl_buf.st32(a, o + 4, dtim_time)
    iwl_buf.st64(a, o + 8, dtim_tsf)
    iwl_buf.st32(a, o + 16, bi)
    iwl_buf.st32(a, o + 24, dtim_interval)
    iwl_buf.st32(a, o + 28, data_policy)
    iwl_buf.st32(a, o + 32, listen_interval)
    iwl_buf.st32(a, o + 36, assoc_id)
    iwl_buf.st32(a, o + 40, beacon_arrive)
}

fn mvm_binding(a: u64, qid: u64, slot: u64, id_color: u64, action: u64, mac0: u64, mac1: u64, mac2: u64, phy_id_color: u64) -> u64 {
    let h: u64 = iwl_buf.HDR
    iwl_buf.zero(a, BINDING_CMD_LEN)
    iwl_buf.hdr(a, CMD_BINDING_CONTEXT, qid, slot)
    iwl_buf.st32(a, h, id_color)
    iwl_buf.st32(a, h + 4, action)
    iwl_buf.st32(a, h + 8, mac0)
    iwl_buf.st32(a, h + 12, mac1)
    iwl_buf.st32(a, h + 16, mac2)
    iwl_buf.st32(a, h + 20, phy_id_color)
    return BINDING_CMD_LEN
}
