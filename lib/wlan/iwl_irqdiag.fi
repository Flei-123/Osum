import wlan.iwl_w
import wlan.iwl_probe
import wlan.iwl_pwr
import wlan.iwl_cmdq
import wlan.iwl_rfkill

export {
    IRQ_WORDS, take_csr, put, at, has_data, render,
    W_PCI_VALID, W_PCMD, W_PSTS, W_PLINE, W_PPIN, W_PMSI, W_PMSIX, W_PDEVCTL, W_PDEVSTA, W_PLNKCTL, W_PLNKSTA,
    W_RP_BDF, W_RP_CMD, W_RP_STS, W_RP_BCTL, W_RP_LNKCTL, W_RP_DEVSTA
}

const IRQ_WORDS: u64 = 48
const W_VALID: u64 = 0
const W_GP: u64 = 1
const W_GP1: u64 = 2
const W_GP2: u64 = 3
const W_MBOX: u64 = 4
const W_MBXC: u64 = 5
const W_SHADOW: u64 = 6
const W_INT: u64 = 7
const W_MASK: u64 = 8
const W_FHINT: u64 = 9
const W_BASE: u64 = 10
const W_EXPBASE: u64 = 11
const W_STTS: u64 = 12
const W_EXPSTTS: u64 = 13
const W_SB1: u64 = 14
const W_SB2: u64 = 15
const W_HDR1: u64 = 16
const W_HDR2: u64 = 17
const W_MACRC: u64 = 18
const W_PCI_VALID: u64 = 20
const W_PCMD: u64 = 21
const W_PSTS: u64 = 22
const W_PLINE: u64 = 23
const W_PPIN: u64 = 24
const W_PMSI: u64 = 25
const W_PMSIX: u64 = 26
const W_PDEVCTL: u64 = 27
const W_PDEVSTA: u64 = 28
const W_PLNKCTL: u64 = 29
const W_PLNKSTA: u64 = 30
const W_RP_BDF: u64 = 31
const W_RP_CMD: u64 = 32
const W_RP_STS: u64 = 33
const W_RP_BCTL: u64 = 34
const W_RP_LNKCTL: u64 = 35
const W_RP_DEVSTA: u64 = 36
const CSR_MBXC: u64 = 0x430
const CSR_SHADOW: u64 = 0x0A8
const CSR_GP1: u64 = 0x054
const CSR_GP2: u64 = 0x058
const FH_STTS: u64 = 0x1BC0
const FH_BASE: u64 = 0x1BC4
const FH_HDR1: u64 = 0x1E78
const FH_HDR2: u64 = 0x1E7C
const PRPH_SB1: u64 = 0xA01E30
const PRPH_SB2: u64 = 0xA01E34

fn at(words: u64, i: u64) -> u64 {
    return *((words + i * 8) as *mut u64)
}

fn put(out: u64, i: u64, v: u64) {
    *((out + i * 8) as *mut u64) = v
}

fn has_data(words: u64) -> bool {
    return at(words, W_VALID) != 0
}

fn take_csr(p: *mut iwl_probe.Probe, c: *mut iwl_cmdq.Cq, out: u64) {
    put(out, W_VALID, 1)
    put(out, W_GP, iwl_pwr.rd(p, iwl_probe.CSR_GP_CNTRL))
    put(out, W_GP1, iwl_pwr.rd(p, CSR_GP1))
    put(out, W_GP2, iwl_pwr.rd(p, CSR_GP2))
    put(out, W_MBOX, iwl_pwr.rd(p, iwl_probe.CSR_MBOX_SET))
    put(out, W_MBXC, iwl_pwr.rd(p, CSR_MBXC))
    put(out, W_SHADOW, iwl_pwr.rd(p, CSR_SHADOW))
    put(out, W_INT, iwl_pwr.rd(p, iwl_probe.CSR_INT))
    put(out, W_MASK, iwl_pwr.rd(p, iwl_pwr.CSR_INT_MASK))
    put(out, W_FHINT, iwl_pwr.rd(p, iwl_pwr.CSR_FH_INT_STATUS))
    put(out, W_EXPBASE, (*c).rx_bd >> 8)
    put(out, W_EXPSTTS, (*c).rx_stts >> 4)
    let mrc: i64 = iwl_pwr.mac_access_get(p)
    put(out, W_MACRC, (mrc as u64) & 0xFFFF)
    put(out, W_BASE, iwl_pwr.rd(p, FH_BASE))
    put(out, W_STTS, iwl_pwr.rd(p, FH_STTS))
    put(out, W_HDR1, iwl_pwr.rd(p, FH_HDR1))
    put(out, W_HDR2, iwl_pwr.rd(p, FH_HDR2))
    if mrc == 0 {
        put(out, W_SB1, iwl_pwr.prph_rd(p, PRPH_SB1) & 0xFFFFFFFF)
        put(out, W_SB2, iwl_pwr.prph_rd(p, PRPH_SB2) & 0xFFFFFFFF)
        iwl_pwr.mac_access_put(p)
    }
}

fn kv(w: *mut iwl_w.W, key: u64, v: u64, digits: u64) {
    iwl_w.w_s(w, key)
    iwl_w.w_hex(w, v, digits)
}

fn match_name(w: *mut iwl_w.W, got: u64, want: u64) {
    var k_ok: [u8; 4] = " ok\0"
    var k_bad: [u8; 5] = " BAD\0"
    if got == want { iwl_w.w_s(w, (&k_ok[0]) as u64) } else { iwl_w.w_s(w, (&k_bad[0]) as u64) }
}

fn render_pci(w: *mut iwl_w.W, words: u64) {
    var k_h: [u8; 17] = "fail_irq=pcicmd=\0"
    var k_s: [u8; 9] = " pcists=\0"
    var k_x: [u8; 7] = " intx=\0"
    var k_l: [u8; 7] = " line=\0"
    var k_p: [u8; 6] = " pin=\0"
    var k_m: [u8; 6] = " msi=\0"
    var k_mx: [u8; 7] = " msix=\0"
    var k_dc: [u8; 9] = " devctl=\0"
    var k_ds: [u8; 9] = " devsta=\0"
    var k_lc: [u8; 9] = " lnkctl=\0"
    var k_ls: [u8; 9] = " lnksta=\0"
    var k_rp: [u8; 16] = "fail_irqrp=bdf=\0"
    var k_rc: [u8; 6] = " cmd=\0"
    var k_rs: [u8; 6] = " sts=\0"
    var k_rb: [u8; 7] = " bctl=\0"
    var k_rl: [u8; 9] = " lnkctl=\0"
    var k_rd: [u8; 9] = " devsta=\0"
    var k_no: [u8; 5] = "none\0"
    iwl_w.w_s(w, (&k_h[0]) as u64)
    iwl_w.w_hex(w, at(words, W_PCMD), 4)
    kv(w, (&k_s[0]) as u64, at(words, W_PSTS), 4)
    iwl_w.w_s(w, (&k_x[0]) as u64)
    iwl_w.w_dec(w, (at(words, W_PSTS) >> 3) & 1)
    kv(w, (&k_l[0]) as u64, at(words, W_PLINE), 2)
    kv(w, (&k_p[0]) as u64, at(words, W_PPIN), 2)
    kv(w, (&k_m[0]) as u64, at(words, W_PMSI), 4)
    kv(w, (&k_mx[0]) as u64, at(words, W_PMSIX), 4)
    kv(w, (&k_dc[0]) as u64, at(words, W_PDEVCTL), 4)
    kv(w, (&k_ds[0]) as u64, at(words, W_PDEVSTA), 4)
    kv(w, (&k_lc[0]) as u64, at(words, W_PLNKCTL), 4)
    kv(w, (&k_ls[0]) as u64, at(words, W_PLNKSTA), 4)
    iwl_w.w_nl(w)
    iwl_w.w_s(w, (&k_rp[0]) as u64)
    let rp: u64 = at(words, W_RP_BDF)
    if rp == 0 {
        iwl_w.w_s(w, (&k_no[0]) as u64)
    } else {
        iwl_w.w_hex(w, (rp >> 8) & 0xFF, 2)
        iwl_w.w_ch(w, 58)
        iwl_w.w_hex(w, (rp >> 3) & 0x1F, 2)
        iwl_w.w_ch(w, 46)
        iwl_w.w_hex(w, rp & 7, 1)
        kv(w, (&k_rc[0]) as u64, at(words, W_RP_CMD), 4)
        kv(w, (&k_rs[0]) as u64, at(words, W_RP_STS), 4)
        kv(w, (&k_rb[0]) as u64, at(words, W_RP_BCTL), 4)
        kv(w, (&k_rl[0]) as u64, at(words, W_RP_LNKCTL), 4)
        kv(w, (&k_rd[0]) as u64, at(words, W_RP_DEVSTA), 4)
    }
    iwl_w.w_nl(w)
}

fn render_csr(w: *mut iwl_w.W, words: u64) {
    var k_h: [u8; 10] = "fail_csr=\0"
    var k_rk: [u8; 9] = " rfkill=\0"
    var k_g1: [u8; 6] = " gp1=\0"
    var k_g2: [u8; 6] = " gp2=\0"
    var k_mb: [u8; 7] = " mbox=\0"
    var k_mc: [u8; 7] = " mbxc=\0"
    var k_sh: [u8; 9] = " shadow=\0"
    var k_in: [u8; 6] = " int=\0"
    var k_mk: [u8; 7] = " mask=\0"
    var k_fh: [u8; 8] = " fhint=\0"
    var k_on: [u8; 3] = "on\0"
    var k_off: [u8; 4] = "off\0"
    var k_gp: [u8; 4] = "gp=\0"
    iwl_w.w_s(w, (&k_h[0]) as u64)
    kv(w, (&k_gp[0]) as u64, at(words, W_GP), 8)
    iwl_w.w_s(w, (&k_rk[0]) as u64)
    if iwl_rfkill.hw_set(at(words, W_GP)) { iwl_w.w_s(w, (&k_on[0]) as u64) } else { iwl_w.w_s(w, (&k_off[0]) as u64) }
    kv(w, (&k_g1[0]) as u64, at(words, W_GP1), 8)
    kv(w, (&k_g2[0]) as u64, at(words, W_GP2), 8)
    kv(w, (&k_mb[0]) as u64, at(words, W_MBOX), 8)
    kv(w, (&k_mc[0]) as u64, at(words, W_MBXC), 8)
    kv(w, (&k_sh[0]) as u64, at(words, W_SHADOW), 8)
    kv(w, (&k_in[0]) as u64, at(words, W_INT), 8)
    kv(w, (&k_mk[0]) as u64, at(words, W_MASK), 8)
    kv(w, (&k_fh[0]) as u64, at(words, W_FHINT), 8)
    iwl_w.w_nl(w)
}

fn render_rxh(w: *mut iwl_w.W, words: u64) {
    var k_h: [u8; 15] = "fail_rxh=base=\0"
    var k_eb: [u8; 6] = " exp=\0"
    var k_st: [u8; 7] = " stts=\0"
    var k_s1: [u8; 6] = " sb1=\0"
    var k_s2: [u8; 6] = " sb2=\0"
    var k_h1: [u8; 7] = " hdr1=\0"
    var k_h2: [u8; 7] = " hdr2=\0"
    var k_mr: [u8; 8] = " macrc=\0"
    iwl_w.w_s(w, (&k_h[0]) as u64)
    iwl_w.w_hex(w, at(words, W_BASE), 8)
    kv(w, (&k_eb[0]) as u64, at(words, W_EXPBASE), 8)
    match_name(w, at(words, W_BASE), at(words, W_EXPBASE))
    kv(w, (&k_st[0]) as u64, at(words, W_STTS), 8)
    kv(w, (&k_eb[0]) as u64, at(words, W_EXPSTTS), 8)
    match_name(w, at(words, W_STTS), at(words, W_EXPSTTS))
    kv(w, (&k_s1[0]) as u64, at(words, W_SB1), 8)
    kv(w, (&k_s2[0]) as u64, at(words, W_SB2), 8)
    kv(w, (&k_h1[0]) as u64, at(words, W_HDR1), 8)
    kv(w, (&k_h2[0]) as u64, at(words, W_HDR2), 8)
    kv(w, (&k_mr[0]) as u64, at(words, W_MACRC), 4)
    iwl_w.w_nl(w)
}

fn render(w: *mut iwl_w.W, words: u64) {
    if at(words, W_PCI_VALID) != 0 { render_pci(w, words) }
    render_csr(w, words)
    render_rxh(w, words)
}
