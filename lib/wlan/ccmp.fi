// ==================================================================
// WAS CCMP IST
// ==================================================================
//     [ 802.11-Kopf ] [ Klartext ]
//
// wird
//
//     [ 802.11-Kopf ] [ CCMP-Kopf, 8 ] [ Schluesseltext ] [ MIC, 8 ]

import wlan.frame
import crypto.aes
import libc.octets

export {
    protect, unprotect, ccmp_header_build, pn_off_header,
    replay_check,
    CCMP_HEADER, CCMP_MIC, CCMP_MEHR, PN_LEN
}

const CCMP_HEADER: usize = 8
const CCMP_MIC: usize = 8
const CCMP_MEHR: usize = 16 // Kopf + MIC
const PN_LEN: usize = 6
const AAD_MAX: usize = 30
const NONCE_LEN: usize = 13

fn le16(p: u64, i: usize) -> u64 {
    return (octets.load_byte(p, i) as u64) | ((octets.load_byte(p, i + 1) as u64) << 8)
}

fn aad_and_nonce(p: u64, n: usize, pn: u64, aad: *mut [u8; 30],
    nonce: *mut [u8; 13]) -> i64 {
    let kl: i64 = frame.header_len(p, n)
    if kl < 0 {
        return -1
    }
    var f: u64 = frame.fc(p, n)
    let a: u64 = frame.art(f)
    let ut: u64 = frame.untertyp(f)
    let adr4: bool = frame.hat_adr4(f)
    var qos: bool = false

    var i: usize = 0
    while i < NONCE_LEN {
        (*nonce)[i] = 0 as u8
        i = i + 1
    }

    if a == frame.KIND_DATA {
        f = f & 65423 // ~0x0070: die Untertyp-Bits 4, 5, 6
        if (ut & 8) != 0 {
            qos = true
            f = f & 32767 // ~0x8000: das Ordnungsbit
            var qat: usize = frame.MIN_HEADER
            if adr4 {
                qat = qat + 6
            }
            if n < qat + 2 {
                return -1
            }
            (*nonce)[0] = (octets.load_byte(p, qat) as u64 & 15) as u8
        }
    } else {
        if a == frame.KIND_MGMT {
            (*nonce)[0] = ((*nonce)[0] as u64 | 16) as u8
        } else {
            return -1
        }
    }
    // ~(0x0800 | 0x1000 | 0x2000) = Wiederholung, Stromsparen, mehr
    f = f & 51199
    f = f | 16384 // geschuetzt

    (*aad)[0] = (f & 255) as u8
    (*aad)[1] = ((f >> 8) & 255) as u8
    if n < 22 {
        return -1
    }
    i = 0
    while i < 18 {
        (*aad)[2 + i] = octets.load_byte(p, 4 + i)
        i = i + 1
    }
    if n < 24 {
        return -1
    }
    let sc: u64 = le16(p, 22) & 15
    (*aad)[20] = (sc & 255) as u8
    (*aad)[21] = ((sc >> 8) & 255) as u8
    var at: usize = 22
    if adr4 {
        if n < 30 {
            return -1
        }
        i = 0
        while i < 6 {
            (*aad)[at + i] = octets.load_byte(p, 24 + i)
            i = i + 1
        }
        at = at + 6
    }
    if qos {
        var qat: usize = frame.MIN_HEADER
        if adr4 {
            qat = qat + 6
        }
        var q0: u64 = octets.load_byte(p, qat) as u64
        q0 = q0 & 143 // ~0x70
        q0 = q0 & 127 // ~0x80 (A-MSDU)
        (*aad)[at] = q0 as u8
        (*aad)[at + 1] = 0 as u8
        at = at + 2
    }

    // Die Nonce: Kennzeichen, Senderadresse, Paketnummer
    // HOECHSTWERTIG ZUERST.
    let a2: u64 = frame.adr2(p, n)
    if a2 == 0 {
        return -1
    }
    i = 0
    while i < 6 {
        (*nonce)[1 + i] = octets.load_byte(a2, i)
        i = i + 1
    }
    i = 0
    while i < PN_LEN {
        (*nonce)[7 + i] = octets.load_byte(pn, i)
        i = i + 1
    }
    return at as i64
}

fn ccmp_header_build(pn: u64, kid: u64, out: u64) {
    octets.store_byte(out, 0, octets.load_byte(pn, 5)) // PN0
    octets.store_byte(out, 1, octets.load_byte(pn, 4)) // PN1
    octets.store_byte(out, 2, 0 as u8)
    octets.store_byte(out, 3, (32 | ((kid & 3) << 6)) as u8)
    octets.store_byte(out, 4, octets.load_byte(pn, 3)) // PN2
    octets.store_byte(out, 5, octets.load_byte(pn, 2)) // PN3
    octets.store_byte(out, 6, octets.load_byte(pn, 1)) // PN4
    octets.store_byte(out, 7, octets.load_byte(pn, 0)) // PN5
}

fn pn_off_header(head: u64, out: u64) -> bool {
    if (octets.load_byte(head, 3) as u64 & 32) == 0 {
        return false
    }
    octets.store_byte(out, 0, octets.load_byte(head, 7)) // PN5
    octets.store_byte(out, 1, octets.load_byte(head, 6)) // PN4
    octets.store_byte(out, 2, octets.load_byte(head, 5)) // PN3
    octets.store_byte(out, 3, octets.load_byte(head, 4)) // PN2
    octets.store_byte(out, 4, octets.load_byte(head, 1)) // PN1
    octets.store_byte(out, 5, octets.load_byte(head, 0)) // PN0
    return true
}

fn replay_check(fresh: u64, zuletzt: u64) -> bool {
    var i: usize = 0
    while i < PN_LEN {
        let a: u8 = octets.load_byte(fresh, i)
        let b: u8 = octets.load_byte(zuletzt, i)
        if a > b {
            return true
        }
        if a < b {
            return false
        }
        i = i + 1
    }
    return false
}

// ==================================================================
// SCHUETZEN
// ==================================================================
fn protect(tk: u64, pn: u64, p: u64, n: usize, out: u64,
    outmax: usize) -> i64 {
    let kl: i64 = frame.header_len(p, n)
    if kl < 0 {
        return -1
    }
    let head: usize = kl as usize
    if n < head {
        return -1
    }
    let nutz: usize = n - head
    if n + CCMP_MEHR > outmax {
        return -1
    }
    var aad: [u8; 30] = [0 as u8; 30]
    var nonce: [u8; 13] = [0 as u8; 13]
    let al: i64 = aad_and_nonce(p, n, pn, &aad, &nonce)
    if al < 0 {
        return -1
    }
    var k: aes.Key = aes.key_new()
    if !aes.key_set(&k, tk, 16) {
        return -1
    }
    var i: usize = 0
    while i < head {
        octets.store_byte(out, i, octets.load_byte(p, i))
        i = i + 1
    }
    let f: u64 = frame.fc(p, n) | 16384
    octets.store_byte(out, 0, (f & 255) as u8)
    octets.store_byte(out, 1, ((f >> 8) & 255) as u8)
    ccmp_header_build(pn, 0, out + (head as u64))
    if !aes.ccm_encrypt(&k, (&nonce[0]) as u64, NONCE_LEN,
        (&aad[0]) as u64, al as usize, p + (head as u64), nutz,
        CCMP_MIC, out + ((head + CCMP_HEADER) as u64)) {
        return -1
    }
    return (n + CCMP_MEHR) as i64
}

// ==================================================================
// ENTSCHUETZEN
// ==================================================================
fn unprotect(tk: u64, p: u64, n: usize, out: u64,
    outmax: usize) -> i64 {
    let kl: i64 = frame.header_len(p, n)
    if kl < 0 {
        return -1
    }
    let head: usize = kl as usize
    if n < head + CCMP_MEHR {
        return -1
    }
    let f: u64 = frame.fc(p, n)
    if !frame.geschuetzt(f) {
        return -1
    }
    var pn: [u8; 6] = [0 as u8; 6]
    if !pn_off_header(p + (head as u64), (&pn[0]) as u64) {
        return -1
    }
    var aad: [u8; 30] = [0 as u8; 30]
    var nonce: [u8; 13] = [0 as u8; 13]
    let al: i64 = aad_and_nonce(p, n, (&pn[0]) as u64, &aad, &nonce)
    if al < 0 {
        return -1
    }
    let clen: usize = n - head - CCMP_HEADER
    if head + clen - CCMP_MIC > outmax {
        return -1
    }
    var k: aes.Key = aes.key_new()
    if !aes.key_set(&k, tk, 16) {
        return -1
    }
    var i: usize = 0
    while i < head {
        octets.store_byte(out, i, octets.load_byte(p, i))
        i = i + 1
    }
    let fk: u64 = f & 49151 // ~0x4000
    octets.store_byte(out, 0, (fk & 255) as u8)
    octets.store_byte(out, 1, ((fk >> 8) & 255) as u8)
    if !aes.ccm_decrypt(&k, (&nonce[0]) as u64, NONCE_LEN,
        (&aad[0]) as u64, al as usize, p + ((head + CCMP_HEADER) as u64),
        clen, CCMP_MIC, out + (head as u64)) {
        return -1
    }
    return (head + clen - CCMP_MIC) as i64
}
