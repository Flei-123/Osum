import wlan.device
import wlan.frame
import wlan.llc
import wlan.connect
import wlan.iwl_le
import wlan.regtrace

export {
    Lease, lease_new, dhcp_acquire, discover_frame, request_frame, reply_parse,
    E_DHCP_SEND, E_DHCP_NO_OFFER, E_DHCP_NO_ACK, E_DHCP_NAK, E_DHCP_STATE
}

const E_DHCP_SEND: i64 = -200
const E_DHCP_NO_OFFER: i64 = -201
const E_DHCP_NO_ACK: i64 = -202
const E_DHCP_NAK: i64 = -203
const E_DHCP_STATE: i64 = -204

const HDR_LEN: u64 = 24
const IP_AT: u64 = 32
const UDP_AT: u64 = 52
const DHCP_AT: u64 = 60
const BROADCAST: u64 = 0xFFFFFFFF
const ROUND_WAIT: u64 = 6000
const SEND_ROUNDS: u64 = 3
const SETTLE_IDLES: u64 = 10
const BUF: usize = 2400
const NOTE_REPLY: u64 = 1
const NOTE_REQUEST: u64 = 2
const NOTE_LEN: u64 = 40

struct Lease {
    ip: u64,
    mask: u64,
    gateway: u64,
    dns: u64,
    server: u64,
    kind: u64,
    xid: u64
}

fn note(tag: u64, art: u64, a: u64, b: u64, c: u64, xid: u64) {
    if !regtrace.is_on() { return }
    var nb: [u8; 40] = [0; 40]
    let p: u64 = (&nb[0]) as u64
    iwl_le.st8(p, 0, 0xDD)
    iwl_le.st8(p, 1, tag)
    iwl_le.st32(p, 4, xid)
    iwl_le.st32(p, 8, a)
    iwl_le.st32(p, 12, b)
    iwl_le.st32(p, 16, c)
    iwl_le.st32(p, 20, art)
    regtrace.rec_host(regtrace.K_HDATA, p, NOTE_LEN)
}

fn lease_new() -> Lease {
    return Lease { ip: 0, mask: 0, gateway: 0, dns: 0, server: 0, kind: 0, xid: 0 }
}

fn head(out: u64, sa: u64, bssid: u64) {
    iwl_le.zero(out, HDR_LEN)
    iwl_le.st8(out, 0, 0x08)
    iwl_le.st8(out, 1, 0x01)
    var i: u64 = 0
    while i < 6 {
        iwl_le.st8(out, 4 + i, iwl_le.ld8(bssid, i))
        iwl_le.st8(out, 10 + i, iwl_le.ld8(sa, i))
        iwl_le.st8(out, 16 + i, 0xFF)
        i = i + 1
    }
}

fn wrap(out: u64, sa: u64, bssid: u64, dl: usize, ident: u64) -> usize {
    head(out, sa, bssid)
    llc.snap_build(out + HDR_LEN, llc.ET_IPV4)
    llc.udp_build(out + UDP_AT, 0, BROADCAST, 68, 67, dl)
    llc.ipv4_build(out + IP_AT, 0, BROADCAST, llc.P_UDP, 8 + dl, ident)
    return (DHCP_AT as usize) + dl
}

fn discover_frame(out: u64, sa: u64, bssid: u64, xid: u64) -> usize {
    let dl: usize = llc.dhcp_discover_build(out + DHCP_AT, xid, sa)
    return wrap(out, sa, bssid, dl, 1)
}

fn request_frame(out: u64, sa: u64, bssid: u64, xid: u64, wanted: u64, server: u64) -> usize {
    let dl: usize = llc.dhcp_request_build(out + DHCP_AT, xid, sa, wanted, server)
    return wrap(out, sa, bssid, dl, 2)
}

fn reply_parse(p: u64, n: usize, xid: u64, lease: *mut Lease) -> bool {
    let hl: i64 = frame.header_len(p, n)
    if hl < 0 { return false }
    let h: usize = hl as usize
    if n < h + llc.SNAP_LEN + llc.IPV4_MIN { return false }
    if llc.snap_parse(p + h as u64, n - h) != llc.ET_IPV4 { return false }
    let at: usize = h + llc.SNAP_LEN
    var ip: llc.Ipv4 = llc.ipv4_new()
    if !llc.ipv4_parse(&ip, p + at as u64, n - at) { return false }
    if !ip.sum_ok || ip.proto != llc.P_UDP { return false }
    var ud: llc.Udp = llc.udp_new()
    if !llc.udp_parse(&ud, ip.payload, ip.payload_len, ip.source, ip.dest) { return false }
    if !ud.sum_ok || ud.dest != 68 { return false }
    var dh: llc.Dhcp = llc.dhcp_new()
    if !llc.dhcp_parse(&dh, ud.payload, ud.payload_len) { return false }
    if dh.xid != xid { return false }
    if dh.yiaddr == 0 && dh.art != llc.D_NAK { return false }
    note(NOTE_REPLY, dh.art, dh.yiaddr, dh.server, dh.maske, dh.xid)
    (*lease).ip = dh.yiaddr
    (*lease).mask = dh.maske
    (*lease).gateway = dh.tor
    (*lease).dns = dh.dns
    (*lease).server = dh.server
    (*lease).kind = dh.art
    (*lease).xid = xid
    return true
}

fn wait_reply(s: *mut connect.Session, g: *mut device.Device, idle: fn(u64) -> u64, idle_ctx: u64,
    xid: u64, lease: *mut Lease, raw: u64, plain: u64, want_offer: bool) -> bool {
    var tries: u64 = 0
    while tries < ROUND_WAIT {
        let n: i64 = connect.data_receive(s, g, raw, BUF, plain, BUF)
        if n > 0 {
            var got: Lease = lease_new()
            if reply_parse(plain, n as usize, xid, &got) && kind_wanted(got.kind, want_offer) {
                *lease = got
                return true
            }
        } else {
            idle(idle_ctx)
            tries = tries + 1
        }
    }
    return false
}

fn kind_wanted(kind: u64, want_offer: bool) -> bool {
    if want_offer { return kind == llc.D_OFFER }
    return kind == llc.D_ACK || kind == llc.D_NAK
}

fn settle(idle: fn(u64) -> u64, idle_ctx: u64) {
    var i: u64 = 0
    while i < SETTLE_IDLES {
        idle(idle_ctx)
        i = i + 1
    }
}

fn exchange(s: *mut connect.Session, g: *mut device.Device, idle: fn(u64) -> u64, idle_ctx: u64,
    xid: u64, lease: *mut Lease, frame: u64, flen: usize, prot: u64, raw: u64, plain: u64,
    want_offer: bool) -> i64 {
    var round: u64 = 0
    while round < SEND_ROUNDS {
        note(NOTE_REQUEST, round, (*lease).ip, (*lease).server, flen as u64, xid)
        if connect.data_send(s, g, frame, flen, prot, BUF) < 0 { return E_DHCP_SEND }
        if wait_reply(s, g, idle, idle_ctx, xid, lease, raw, plain, want_offer) { return 0 }
        round = round + 1
    }
    return 1
}

#[allow_escape]
fn dhcp_acquire(s: *mut connect.Session, g: *mut device.Device, idle: fn(u64) -> u64, idle_ctx: u64,
    xid: u64, lease: *mut Lease) -> i64 {
    if !connect.may_data(s) { return E_DHCP_STATE }
    var mac: [u8; 6] = [0; 6]
    device.address_of(g, (&mac[0]) as u64)
    let sa: u64 = (&mac[0]) as u64
    let bssid: u64 = (&(*s).aa[0]) as u64
    var out: [u8; 400] = [0; 400]
    var prot: [u8; 2400] = [0; 2400]
    var raw: [u8; 2400] = [0; 2400]
    var plain: [u8; 2400] = [0; 2400]
    let o: u64 = (&out[0]) as u64
    let dl: usize = discover_frame(o, sa, bssid, xid)
    settle(idle, idle_ctx)
    let er: i64 = exchange(s, g, idle, idle_ctx, xid, lease, o, dl, (&prot[0]) as u64, (&raw[0]) as u64, (&plain[0]) as u64, true)
    if er < 0 { return er }
    if er > 0 { return E_DHCP_NO_OFFER }
    let rl: usize = request_frame(o, sa, bssid, xid, (*lease).ip, (*lease).server)
    let qr: i64 = exchange(s, g, idle, idle_ctx, xid, lease, o, rl, (&prot[0]) as u64, (&raw[0]) as u64, (&plain[0]) as u64, false)
    if qr < 0 { return qr }
    if qr > 0 { return E_DHCP_NO_ACK }
    if (*lease).kind == llc.D_NAK { return E_DHCP_NAK }
    return 0
}
