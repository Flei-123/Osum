// SPDX-License-Identifier: GPL-2.0-only
import wlan.iwl_fw

export {
    CAPS_WORDS, CAPS_KNOWN, CAPS_DQA, CAPS_UMAC_SCAN,
    W_QUIRKS, Q_OLD_SCAN, Q_OLD_SLOT, Q_OLD_SSID, Q_OLD_MAC, Q_OLD_TXQ, Q_OLD_LOSS, Q_OLD_PHY, caps_quirk, caps_apply_quirks,
    W_SCAN_VER, W_SCAN_SLOTS, W_TX_VER, W_STA_VER, W_SCD_VER, W_FLAGS, W_API0, W_CAPA0,
    CMD_SCAN_REQ, CMD_ADD_STA, CMD_TX, CMD_SCD_QUEUE_CFG,
    caps_default, caps_fill, caps_get, caps_set, caps_known, caps_dqa
}

const CAPS_WORDS: u64 = 16
const CAPS_KNOWN: u64 = 1
const CAPS_DQA: u64 = 2
const CAPS_UMAC_SCAN: u64 = 4

const W_SCAN_VER: u64 = 0
const W_SCAN_SLOTS: u64 = 1
const W_TX_VER: u64 = 2
const W_STA_VER: u64 = 3
const W_SCD_VER: u64 = 4
const W_FLAGS: u64 = 5
const W_API0: u64 = 6
const W_CAPA0: u64 = 7
const W_QUIRKS: u64 = 8

const Q_OLD_SCAN: u64 = 1
const Q_OLD_SLOT: u64 = 2
const Q_OLD_SSID: u64 = 4
const Q_OLD_MAC: u64 = 8
const Q_OLD_TXQ: u64 = 16
const Q_OLD_LOSS: u64 = 32
const Q_OLD_PHY: u64 = 64

const CMD_SCAN_REQ: u64 = 0x0D
const CMD_ADD_STA: u64 = 0x18
const CMD_TX: u64 = 0x1C
const CMD_SCD_QUEUE_CFG: u64 = 0x1D
const CAPA_UMAC_SCAN: u64 = 2
const CAPA_DQA: u64 = 12

fn caps_get(w: *mut u64, i: u64) -> u64 { return *((w as u64 + i * 8) as *mut u64) }
fn caps_set(w: *mut u64, i: u64, v: u64) { *((w as u64 + i * 8) as *mut u64) = v }

fn caps_default(w: *mut u64) {
    var i: u64 = 0
    while i < CAPS_WORDS {
        caps_set(w, i, 0)
        i = i + 1
    }
    caps_set(w, W_SCAN_VER, 1)
    caps_set(w, W_STA_VER, 0)
}

fn ver_or(f: *mut iwl_fw.FwInfo, cmd: u64, dflt: u64) -> u64 {
    let v: i64 = iwl_fw.fw_cmd_ver(f, cmd)
    if v < 0 { return dflt }
    return v as u64
}

fn caps_fill(w: *mut u64, f: *mut iwl_fw.FwInfo) {
    caps_default(w)
    var fl: u64 = CAPS_KNOWN
    if iwl_fw.fw_has_capa(f, CAPA_DQA) { fl = fl | CAPS_DQA }
    if iwl_fw.fw_has_capa(f, CAPA_UMAC_SCAN) { fl = fl | CAPS_UMAC_SCAN }
    caps_set(w, W_FLAGS, fl)
    caps_set(w, W_SCAN_VER, ver_or(f, CMD_SCAN_REQ, 1))
    caps_set(w, W_SCAN_SLOTS, (*f).n_scan_ch)
    caps_set(w, W_TX_VER, ver_or(f, CMD_TX, 0))
    caps_set(w, W_STA_VER, ver_or(f, CMD_ADD_STA, 0))
    caps_set(w, W_SCD_VER, ver_or(f, CMD_SCD_QUEUE_CFG, 0))
    caps_set(w, W_API0, (*f).api0)
    caps_set(w, W_CAPA0, (*f).capa0)
}

fn caps_known(w: *mut u64) -> bool { return (caps_get(w, W_FLAGS) & CAPS_KNOWN) != 0 }
fn caps_dqa(w: *mut u64) -> bool { return (caps_get(w, W_FLAGS) & CAPS_DQA) != 0 }

fn caps_quirk(w: *mut u64, q: u64) -> bool { return (caps_get(w, W_QUIRKS) & q) != 0 }

fn caps_apply_quirks(w: *mut u64, q: u64) {
    caps_set(w, W_QUIRKS, q)
    if (q & Q_OLD_SCAN) != 0 { caps_set(w, W_SCAN_VER, 1) }
    if (q & Q_OLD_SLOT) != 0 { caps_set(w, W_SCAN_SLOTS, 0) }
}
