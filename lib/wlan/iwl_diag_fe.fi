import wlan.iwl_w

export { FeCopy, fe_copy_new, fe_copy_set, fe_render, fe_send_render }

const FE_WORDS: u64 = 7

struct FeCopy {
    state: u64,
    ptr: u64,
    w: [u64; 7]
}

fn fe_copy_new() -> FeCopy {
    var c: FeCopy = FeCopy { state: 0, ptr: 0, w: [0; 7] }
    return c
}

fn fe_copy_set(c: *mut FeCopy, ptr: u64, got: bool, src: u64) {
    (*c).ptr = ptr
    (*c).state = 1
    if got { (*c).state = 2 }
    var i: u64 = 0
    while i < FE_WORDS {
        (*c).w[i as usize] = 0
        if got { (*c).w[i as usize] = *((src + i * 8) as *mut u64) }
        i = i + 1
    }
}

fn put_kv(w: *mut iwl_w.W, key: u64, v: u64) {
    iwl_w.w_s(w, key)
    iwl_w.w_hex(w, v, 8)
}

fn fe_render(w: *mut iwl_w.W, head: u64, c: *mut FeCopy) {
    var k_id: [u8; 7] = " id=0x\0"
    var k_va: [u8; 10] = " valid=0x\0"
    var k_b2: [u8; 11] = " blink2=0x\0"
    var k_i1: [u8; 11] = " ilink1=0x\0"
    var k_d1: [u8; 10] = " data1=0x\0"
    var k_d2: [u8; 10] = " data2=0x\0"
    var k_hc: [u8; 9] = " hcmd=0x\0"
    var k_no: [u8; 8] = " unread\0"
    if (*c).state == 0 { return }
    iwl_w.w_s(w, head)
    iwl_w.w_hex(w, (*c).ptr, 8)
    if (*c).state == 2 {
        put_kv(w, (&k_va[0]) as u64, (*c).w[0])
        put_kv(w, (&k_id[0]) as u64, (*c).w[1])
        put_kv(w, (&k_b2[0]) as u64, (*c).w[2])
        put_kv(w, (&k_i1[0]) as u64, (*c).w[3])
        put_kv(w, (&k_d1[0]) as u64, (*c).w[4])
        put_kv(w, (&k_d2[0]) as u64, (*c).w[5])
        put_kv(w, (&k_hc[0]) as u64, (*c).w[6])
    } else {
        iwl_w.w_s(w, (&k_no[0]) as u64)
    }
    iwl_w.w_nl(w)
}

fn fe_send_render(w: *mut iwl_w.W, rc: i64, cmd: u64) {
    var k_s: [u8; 12] = "fail_send=\0\0"
    var k_c: [u8; 8] = " cmd=0x\0"
    iwl_w.w_s(w, (&k_s[0]) as u64)
    iwl_w.w_int(w, rc)
    iwl_w.w_s(w, (&k_c[0]) as u64)
    iwl_w.w_hex(w, cmd, 2)
    iwl_w.w_nl(w)
}
