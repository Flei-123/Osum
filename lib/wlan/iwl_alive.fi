import wlan.iwl_probe
import wlan.iwl_pwr

export {
    alive_wait_for, alive_wait_poll, alive_new, alive_hooks, boot_fw, AliveCtx, Hooks,
    E_ALIVE_TIMEOUT, E_ALIVE_HW, E_ALIVE_SW,
    INT_ALIVE_BIT, INT_FH_RX, INT_SW_ERR, INT_HW_ERR,
    LIMIT_MS, SLICE_ROUNDS, SLICE_STRIDE, MAX_SLICES
}

const INT_ALIVE_BIT: u64 = 0x1
const INT_FH_RX: u64 = 0x80000000
const INT_SW_ERR: u64 = 0x02000000
const INT_HW_ERR: u64 = 0x20000000
const ACCEPT_LEGACY: u64 = 0x1
const ACCEPT_ALL: u64 = 0x80000001

const SLICE_ROUNDS: u64 = 50
const SLICE_STRIDE: u64 = 1000
const MAX_SLICES: u64 = 24
const LIMIT_MS: u64 = 2500
const WAIT_MORE: i64 = 1

const E_ALIVE_TIMEOUT: i64 = -30
const E_ALIVE_HW: i64 = -31
const E_ALIVE_SW: i64 = -32

struct Hooks {
    now: fn(u64) -> u64,
    peek: fn(u64) -> u64
}

struct AliveCtx {
    h: Hooks,
    now_ctx: u64,
    peek_ctx: u64,
    limit_ms: u64,
    seen: u64,
    waited_ms: u64,
    slices: u64
}

fn no_now(c: u64) -> u64 { return 0 }
fn no_peek(c: u64) -> u64 { return 0 }

fn alive_new() -> AliveCtx {
    var a: AliveCtx = AliveCtx {
        h: Hooks { now: no_now, peek: no_peek },
        now_ctx: 0, peek_ctx: 0, limit_ms: LIMIT_MS, seen: 0, waited_ms: 0, slices: 0
    }
    return a
}

fn alive_hooks(a: *mut AliveCtx, now: fn(u64) -> u64, now_ctx: u64, peek: fn(u64) -> u64, peek_ctx: u64) {
    (*a).h.now = now
    (*a).h.peek = peek
    (*a).now_ctx = now_ctx
    (*a).peek_ctx = peek_ctx
}

fn rd_int(p: *mut iwl_probe.Probe) -> u64 {
    let m: iwl_probe.Mmio = (*p).m
    (*p).reads = (*p).reads + 1
    return m.rd32((*p).ctx, iwl_probe.CSR_INT) & 0xFFFFFFFF
}

fn ack_int(p: *mut iwl_probe.Probe, bits: u64) {
    let m: iwl_probe.Mmio = (*p).m
    (*p).writes = (*p).writes + 1
    m.wr32((*p).ctx, iwl_probe.CSR_INT, bits)
}

fn judge(p: *mut iwl_probe.Probe, a: *mut AliveCtx, v: u64, accept: u64) -> i64 {
    (*a).seen = (*a).seen | v
    if v == 0xFFFFFFFF { return E_ALIVE_HW }
    if v & INT_HW_ERR != 0 {
        ack_int(p, INT_HW_ERR)
        return E_ALIVE_HW
    }
    if v & INT_SW_ERR != 0 {
        ack_int(p, INT_SW_ERR)
        return E_ALIVE_SW
    }
    if v & accept != 0 {
        ack_int(p, v & accept)
        return 0
    }
    return WAIT_MORE
}

fn alive_slice(p: *mut iwl_probe.Probe, a: *mut AliveCtx) -> i64 {
    let h: Hooks = (*a).h
    var i: u64 = 0
    while i < SLICE_ROUNDS {
        let r: i64 = judge(p, a, rd_int(p), ACCEPT_ALL)
        if r != WAIT_MORE { return r }
        if h.peek((*a).peek_ctx) != 0 { return 0 }
        iwl_pwr.settle(p, SLICE_STRIDE)
        i = i + 1
    }
    return E_ALIVE_TIMEOUT
}

fn alive_wait_for(p: *mut iwl_probe.Probe, a: *mut AliveCtx) -> i64 {
    let h: Hooks = (*a).h
    let t0: u64 = h.now((*a).now_ctx)
    var s: u64 = 0
    while s < MAX_SLICES {
        let r: i64 = alive_slice(p, a)
        (*a).slices = s + 1
        let waited: u64 = h.now((*a).now_ctx) - t0
        (*a).waited_ms = waited
        if r != E_ALIVE_TIMEOUT { return r }
        if waited >= (*a).limit_ms { return E_ALIVE_TIMEOUT }
        s = s + 1
    }
    return E_ALIVE_TIMEOUT
}

fn alive_wait_poll(p: *mut iwl_probe.Probe, a: *mut AliveCtx) -> i64 {
    var i: u64 = 0
    while i < iwl_pwr.POLL_MAX {
        let r: i64 = judge(p, a, rd_int(p), ACCEPT_LEGACY)
        if r != WAIT_MORE { return r }
        i = i + 1
    }
    return E_ALIVE_TIMEOUT
}

fn boot_fw(p: *mut iwl_probe.Probe, ba: u64, a: *mut AliveCtx) -> i64 {
    var r: i64 = iwl_pwr.power_up(p)
    if r != 0 { return r }
    r = iwl_pwr.fw_kick(p, ba)
    if r != 0 { return r }
    r = alive_wait_for(p, a)
    if r != 0 {
        iwl_pwr.int_disable(p)
    }
    return r
}
