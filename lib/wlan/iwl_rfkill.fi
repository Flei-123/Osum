import wlan.iwl_w

export { hw_set, render_state, GP_HW_RF_KILL_SW }

const GP_HW_RF_KILL_SW: u64 = 0x08000000

fn hw_set(gp: u64) -> bool {
    return (gp & GP_HW_RF_KILL_SW) == 0
}

fn render_state(w: *mut iwl_w.W, gp: u64) {
    var k_hw: [u8; 4] = "hw=\0"
    var k_on: [u8; 3] = "on\0"
    var k_off: [u8; 4] = "off\0"
    var k_gp: [u8; 5] = " gp=\0"
    iwl_w.w_s(w, (&k_hw[0]) as u64)
    if hw_set(gp) { iwl_w.w_s(w, (&k_on[0]) as u64) } else { iwl_w.w_s(w, (&k_off[0]) as u64) }
    iwl_w.w_s(w, (&k_gp[0]) as u64)
    iwl_w.w_hex(w, gp, 8)
}
