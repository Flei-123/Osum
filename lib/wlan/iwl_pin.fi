// SPDX-License-Identifier: GPL-2.0-only
// lib/wlan/iwl_pin.fi -- SHA-256 pins of the Intel family-8000 firmware files (linux-firmware, 23.10.2026).
// The blobs are NEVER committed; the kernel glue hashes the file it read and logs whether the digest is
// a known one. A mismatch is only logged (Intel's boot ROM verifies the signature itself); the pin tells
// the boss and the report which exact file a measurement was made with. Licence of the files:
// docs/WLAN-8265.md section 3.

export { hex_digest, pin_api, pin_family, PIN_N }

const PIN_N: u64 = 4

fn hexc(v: u64) -> u8 {
    if v < 10 { return (48 + v) as u8 }
    return (87 + v) as u8
}

fn hex_digest(d: u64, out: u64) {
    var i: usize = 0
    while i < 32 {
        let bb: u8 = *((d + i as u64) as *mut u8)
        let b: u64 = bb as u64
        *((out + (i * 2) as u64) as *mut u8) = hexc(b >> 4)
        *((out + (i * 2 + 1) as u64) as *mut u8) = hexc(b & 15)
        i = i + 1
    }
    *((out + 64) as *mut u8) = 0 as u8
}

fn same64(a: u64, b: u64) -> bool {
    var i: u64 = 0
    var diff: u64 = 0
    while i < 64 {
        let xb: u8 = *((a + i) as *mut u8)
        let yb: u8 = *((b + i) as *mut u8)
        let x: u64 = xb as u64
        let y: u64 = yb as u64
        diff = diff | (x ^ y)
        i = i + 1
    }
    return diff == 0
}

fn pin0(h: u64) -> bool {
    let p: [u8; 65] = "1336afcd028ed094d1fe33893c84c273bb5711be52970040344a75a12f276d56\0"
    return same64(h, (&p[0]) as u64)
}

fn pin1(h: u64) -> bool {
    let p: [u8; 65] = "85566f9473b0774209b8351c2daeea8d5c20116f880082b64af819ca54e3b9f7\0"
    return same64(h, (&p[0]) as u64)
}

fn pin2(h: u64) -> bool {
    let p: [u8; 65] = "479931721f5e168d69d67c297c11738acd75da390adb94f96030a1055f4cf57a\0"
    return same64(h, (&p[0]) as u64)
}

fn pin3(h: u64) -> bool {
    let p: [u8; 65] = "5476ec3e48825739c4d19a0a690ee72f05717bca797214065037f2077c0249ce\0"
    return same64(h, (&p[0]) as u64)
}

// -> API version of the pinned file (36 / 34), 0 = digest not pinned. `hex` = 64 lower-case hex digits.
fn pin_api(hex: u64) -> u64 {
    if pin0(hex) { return 36 }
    if pin1(hex) { return 34 }
    if pin2(hex) { return 36 }
    if pin3(hex) { return 34 }
    return 0
}

// -> 8265 (file iwlwifi-8265-NN) / 8000 (iwlwifi-8000C-NN) / 0
fn pin_family(hex: u64) -> u64 {
    if pin0(hex) || pin1(hex) { return 8265 }
    if pin2(hex) || pin3(hex) { return 8000 }
    return 0
}
