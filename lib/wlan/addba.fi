import libc.octets

export { is_request, build_decline, STATUS_DECLINED, RESPONSE_LEN }

const FC_ACTION: u64 = 0xD0
const CAT_BLOCK_ACK: u64 = 3
const ACTION_REQUEST: u64 = 0
const ACTION_RESPONSE: u64 = 1
const HDR: u64 = 24
const REQUEST_MIN: u64 = 33
const RESPONSE_LEN: u64 = 33
const STATUS_DECLINED: u64 = 37

fn is_request(frame: u64, n: u64) -> bool {
    if n < REQUEST_MIN { return false }
    if (octets.ld8(frame, 0) & 0xFC) != FC_ACTION { return false }
    if octets.ld8(frame, HDR) != CAT_BLOCK_ACK { return false }
    return octets.ld8(frame, HDR + 1) == ACTION_REQUEST
}

fn copy6(dst: u64, doff: u64, src: u64, soff: u64) {
    var i: u64 = 0
    while i < 6 {
        octets.st8(dst, doff + i, octets.ld8(src, soff + i))
        i = i + 1
    }
}

fn build_decline(req: u64, own: u64, out: u64) -> u64 {
    octets.zero(out, RESPONSE_LEN)
    octets.st8(out, 0, FC_ACTION)
    copy6(out, 4, req, 10)
    copy6(out, 10, own, 0)
    copy6(out, 16, req, 16)
    octets.st8(out, HDR, CAT_BLOCK_ACK)
    octets.st8(out, HDR + 1, ACTION_RESPONSE)
    octets.st8(out, HDR + 2, octets.ld8(req, HDR + 2))
    octets.st8(out, HDR + 3, STATUS_DECLINED)
    octets.st8(out, HDR + 4, 0)
    octets.st8(out, HDR + 5, octets.ld8(req, HDR + 3))
    octets.st8(out, HDR + 6, octets.ld8(req, HDR + 4))
    octets.st8(out, HDR + 7, octets.ld8(req, HDR + 5))
    octets.st8(out, HDR + 8, octets.ld8(req, HDR + 6))
    return RESPONSE_LEN
}
