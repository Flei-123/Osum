// ========================================================== DIE KETTE
//
//   Passphrase --scrypt--> HAUPTSCHLUESSEL --HKDF--> fuenf Unterschluessel
//     NAME = HMAC-SHA256(K_NAME, P)
// ================================================================ EHRLICH

import crypto.sha256
import crypto.chacha
import crypto.scrypt
import crypto.hkdf
import libc.octets

export {
    SALTLEN, KEYLEN, NAMELEN, TAGLEN, BUNDLEN,
    K_INHALT, K_NAME, K_SIEGEL, K_VAULT, K_CHECK,
    bund_ableiten, bundle_off_main, bund_key, bundle_delete, bundle_eq,
    block_name, block_name_naiv, block_siegeln, block_open,
    code_write, code_read, CODELEN,
    secret_seal, secret_open,
    envelope_write, envelope_read, HUELLELEN
}

const SALTLEN: u64 = 16
const KEYLEN: u64 = 32
const NAMELEN: u64 = 32
const TAGLEN: u64 = 16
const BUNDLEN: u64 = 160 // fuenf Unterschluessel zu 32

const K_INHALT: u64 = 0
const K_NAME: u64 = 1
const K_SIEGEL: u64 = 2
const K_VAULT: u64 = 3
const K_CHECK: u64 = 4

fn bund_key(bund: u64, which: u64) -> u64 {
    return bund + which * KEYLEN
}

fn bund_ableiten(bund: u64, pw: u64, plen: u64, salt: u64,
    n: u64, r: u64, mem: u64, memlen: u64) -> bool {
    var mk: [u8; 32] = [0 as u8; 32]
    let mkp: u64 = (&mk[0]) as u64
    if !scrypt.scrypt(pw, plen, salt, SALTLEN, n, r, 1, mkp, KEYLEN,
        mem, memlen) {
        return false
    }
    let ok: bool = bundle_off_main(bund, mkp, salt)
    var i: u64 = 0
    while i < 32 {
        octets.st8(mkp, i, 0)
        i = i + 1
    }
    return ok
}

fn bundle_off_main(bund: u64, mk: u64, salt: u64) -> bool {
    var etikett: [u8; 25] = "osum sync v1 unterkette\0\0"
    var prk: [u8; 32] = [0 as u8; 32]
    let prkp: u64 = (&prk[0]) as u64
    hkdf.hkdf_extract(salt, SALTLEN as usize, mk, KEYLEN as usize, prkp)
    let r: bool = hkdf.hkdf_expand(prkp, (&etikett[0]) as u64, 23,
        bund, BUNDLEN as usize)
    var i: u64 = 0
    while i < 32 {
        octets.st8(prkp, i, 0)
        i = i + 1
    }
    return r
}

fn bundle_delete(bund: u64) {
    var i: u64 = 0
    while i < BUNDLEN {
        octets.st8(bund, i, 0)
        i = i + 1
    }
}

fn bundle_eq(a: u64, b: u64, n: u64) -> bool {
    var d: u64 = 0
    var i: u64 = 0
    while i < n {
        d = d | (octets.ld8(a, i) ^ octets.ld8(b, i))
        i = i + 1
    }
    return d == 0
}

// ------------------------------------------------------ die Blocknamen

// DER RICHTIGE: HMAC-SHA256(K_NAME, P).
fn block_name(namekey: u64, p: u64, n: u64, out: u64) {
    sha256.hmac(namekey, KEYLEN as usize, p, n as usize, out)
}

fn block_name_naiv(p: u64, n: u64, out: u64) {
    sha256.hash(p, n as usize, out)
}

// ------------------------------------------------------- der Blocksiegel

fn block_key(inhaltkey: u64, name: u64, out: u64) {
    sha256.hmac(inhaltkey, KEYLEN as usize, name, NAMELEN as usize, out)
}

fn block_nonce(inhaltkey: u64, name: u64, out24: u64) {
    var before: [u8; 38] = [0 as u8; 38]
    let vp: u64 = (&before[0]) as u64
    var m: [u8; 6] = "nonce\0"
    var i: u64 = 0
    while i < 5 {
        octets.st8(vp, i, octets.ld8((&m[0]) as u64, i))
        i = i + 1
    }
    i = 0
    while i < NAMELEN {
        octets.st8(vp, 5 + i, octets.ld8(name, i))
        i = i + 1
    }
    var full: [u8; 32] = [0 as u8; 32]
    sha256.hmac(inhaltkey, KEYLEN as usize, vp, (5 + NAMELEN) as usize,
        (&full[0]) as u64)
    i = 0
    while i < 24 {
        octets.st8(out24, i, octets.ld8((&full[0]) as u64, i))
        i = i + 1
    }
}

fn block_siegeln(inhaltkey: u64, name: u64, p: u64, n: u64,
    out: u64) -> u64 {
    if n == 0 {
        return 0
    }
    var kb: [u8; 32] = [0 as u8; 32]
    var nc: [u8; 24] = [0 as u8; 24]
    block_key(inhaltkey, name, (&kb[0]) as u64)
    block_nonce(inhaltkey, name, (&nc[0]) as u64)
    chacha.xaead_seal((&kb[0]) as u64, (&nc[0]) as u64, name,
        NAMELEN as usize, p, n as usize, out)
    var i: u64 = 0
    while i < 32 {
        octets.st8((&kb[0]) as u64, i, 0)
        i = i + 1
    }
    return n + TAGLEN
}

fn block_open(inhaltkey: u64, name: u64, ct: u64, n: u64,
    out: u64, got: *mut u64) -> bool {
    if n <= TAGLEN {
        return false
    }
    var kb: [u8; 32] = [0 as u8; 32]
    var nc: [u8; 24] = [0 as u8; 24]
    block_key(inhaltkey, name, (&kb[0]) as u64)
    block_nonce(inhaltkey, name, (&nc[0]) as u64)
    let ok: bool = chacha.xaead_open((&kb[0]) as u64, (&nc[0]) as u64,
        name, NAMELEN as usize, ct, n as usize, out)
    var i: u64 = 0
    while i < 32 {
        octets.st8((&kb[0]) as u64, i, 0)
        i = i + 1
    }
    if !ok {
        return false
    }
    *got = n - TAGLEN
    return true
}

// ------------------------------------------------------ ein Geheimnis
fn secret_seal(key: u64, nonce24: u64, aad: u64, aadlen: u64,
    p: u64, n: u64, out: u64) -> u64 {
    if n == 0 {
        return 0
    }
    chacha.xaead_seal(key, nonce24, aad, aadlen as usize, p, n as usize, out)
    return n + TAGLEN
}

fn secret_open(key: u64, nonce24: u64, aad: u64, aadlen: u64,
    ct: u64, n: u64, out: u64, got: *mut u64) -> bool {
    if n <= TAGLEN {
        return false
    }
    if !chacha.xaead_open(key, nonce24, aad, aadlen as usize, ct,
        n as usize, out) {
        return false
    }
    *got = n - TAGLEN
    return true
}

// ------------------------------------------ der Wiederherstellungscode
//     N7QK4-2M0XV-...-9GHTB
const CODELEN: u64 = 65 // 55 Zeichen + 10 Bindestriche
const CODEROH: u64 = 55

fn alpha(v: u64) -> u64 {
    var a: [u8; 33] = "0123456789ABCDEFGHJKMNPQRSTVWXYZ\0"
    return octets.ld8((&a[0]) as u64, v & 31)
}

fn unalpha(c: u64) -> i64 {
    var x: u64 = c
    if x >= 97 && x <= 122 {
        x = x - 32
    }
    if x == 73 || x == 76 {
        x = 49 // I, L -> 1
    }
    if x == 79 {
        x = 48 // O -> 0
    }
    var a: [u8; 33] = "0123456789ABCDEFGHJKMNPQRSTVWXYZ\0"
    var i: u64 = 0
    while i < 32 {
        if octets.ld8((&a[0]) as u64, i) == x {
            return i as i64
        }
        i = i + 1
    }
    return 0 - 1
}

fn code_write(key32: u64, out: u64) -> u64 {
    var roh: [u8; 34] = [0 as u8; 34]
    let rp: u64 = (&roh[0]) as u64
    var i: u64 = 0
    while i < 32 {
        octets.st8(rp, i, octets.ld8(key32, i))
        i = i + 1
    }
    var pr: [u8; 32] = [0 as u8; 32]
    sha256.hash(key32, 32, (&pr[0]) as u64)
    octets.st8(rp, 32, octets.ld8((&pr[0]) as u64, 0))
    octets.st8(rp, 33, octets.ld8((&pr[0]) as u64, 1))

    var at: u64 = 0
    var bitpuffer: u64 = 0
    var bits: u64 = 0
    var geschrieben: u64 = 0
    i = 0
    while i < 34 {
        bitpuffer = (bitpuffer << 8) | octets.ld8(rp, i)
        bits = bits + 8
        while bits >= 5 {
            bits = bits - 5
            let v: u64 = (bitpuffer >> bits) & 31
            if geschrieben > 0 && geschrieben % 5 == 0 {
                octets.st8(out, at, 45) // Bindestrich
                at = at + 1
            }
            octets.st8(out, at, alpha(v))
            at = at + 1
            geschrieben = geschrieben + 1
        }
        i = i + 1
    }
    if bits > 0 {
        let v: u64 = (bitpuffer << (5 - bits)) & 31
        if geschrieben > 0 && geschrieben % 5 == 0 {
            octets.st8(out, at, 45)
            at = at + 1
        }
        octets.st8(out, at, alpha(v))
        at = at + 1
        geschrieben = geschrieben + 1
    }
    return at
}

fn code_read(text: u64, len: u64, out: u64) -> bool {
    var roh: [u8; 34] = [0 as u8; 34]
    let rp: u64 = (&roh[0]) as u64
    var bitpuffer: u64 = 0
    var bits: u64 = 0
    var full: u64 = 0
    var char: u64 = 0
    var i: u64 = 0
    while i < len {
        let c: u64 = octets.ld8(text, i)
        i = i + 1
        if c == 45 || c == 32 || c == 9 || c == 13 || c == 10 {
            continue
        }
        let v: i64 = unalpha(c)
        if v < 0 {
            return false
        }
        char = char + 1
        if char > CODEROH {
            return false
        }
        bitpuffer = (bitpuffer << 5) | (v as u64)
        bits = bits + 5
        if bits >= 8 {
            bits = bits - 8
            if full >= 34 {
                return false
            }
            octets.st8(rp, full, (bitpuffer >> bits) & 255)
            full = full + 1
        }
    }
    if char != CODEROH || full != 34 {
        return false
    }
    if bits > 0 {
        if (bitpuffer & ((1 << bits) - 1)) != 0 {
            return false
        }
    }
    var pr: [u8; 32] = [0 as u8; 32]
    sha256.hash(rp, 32, (&pr[0]) as u64)
    if octets.ld8((&pr[0]) as u64, 0) != octets.ld8(rp, 32) {
        return false
    }
    if octets.ld8((&pr[0]) as u64, 1) != octets.ld8(rp, 33) {
        return false
    }
    var j: u64 = 0
    while j < 32 {
        octets.st8(out, j, octets.ld8(rp, j))
        j = j + 1
    }
    return true
}

// ------------------------------------------------------- die Huelle
//     Huelle = XChaCha20-Poly1305(einpackschluessel, nonce, AAD, MK)
const HUELLELEN: u64 = 48

fn envelope_write(einpack: u64, nonce24: u64, mk: u64, out: u64) {
    var aad: [u8; 20] = "osum sync v1 huelle\0"
    chacha.xaead_seal(einpack, nonce24, (&aad[0]) as u64, 19, mk, 32, out)
}

fn envelope_read(einpack: u64, nonce24: u64, envelope_wrapped: u64, out: u64) -> bool {
    var aad: [u8; 20] = "osum sync v1 huelle\0"
    return chacha.xaead_open(einpack, nonce24, (&aad[0]) as u64, 19,
        envelope_wrapped, HUELLELEN as usize, out)
}
