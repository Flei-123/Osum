import libc.octets
import ssam.wire

export {
    TC_SAM, TC_HID, TC_REG, TID_KIP, IID_KEYBOARD, IID_TOUCHPAD,
    CID_OUTPUT_REPORT, CID_GET_FEATURE, CID_SET_FEATURE, CID_GET_DESCRIPTOR,
    CID_FIRMWARE_VERSION, CID_DISPLAY_ON, CID_EVENT_ENABLE, CID_EVENT_DISABLE, CID_INPUT_REPORT,
    DESC_HID, DESC_REPORT, DESC_ATTRS, SLICE_CHUNK, SLICE_HDR_LEN, ATTRS_LEN, HID_DESC_LEN,
    put_get_descriptor, slice_offset, slice_length, slice_end, slice_data, slice_ok,
    put_event_params, event_status_ok,
    hid_desc_ok, hid_desc_report_len, attrs_length, attrs_vendor, attrs_product, attrs_version,
    is_input_report
}

const TC_SAM: u64 = 0x01
const TC_HID: u64 = 0x15
const TC_REG: u64 = 0x21
const TID_KIP: u64 = 0x02
const IID_KEYBOARD: u64 = 0x01
const IID_TOUCHPAD: u64 = 0x03

const CID_OUTPUT_REPORT: u64 = 0x01
const CID_GET_FEATURE: u64 = 0x02
const CID_SET_FEATURE: u64 = 0x03
const CID_GET_DESCRIPTOR: u64 = 0x04
const CID_INPUT_REPORT: u64 = 0x00

const CID_FIRMWARE_VERSION: u64 = 0x13
const CID_DISPLAY_ON: u64 = 0x16
const CID_EVENT_ENABLE: u64 = 0x01
const CID_EVENT_DISABLE: u64 = 0x02

const DESC_HID: u64 = 0
const DESC_REPORT: u64 = 1
const DESC_ATTRS: u64 = 2

const SLICE_CHUNK: u64 = 0x76
const SLICE_HDR_LEN: u64 = 10
const ATTRS_LEN: u64 = 32
const HID_DESC_LEN: u64 = 9
const HID_DT_HID: u64 = 0x21
const HID_DT_REPORT: u64 = 0x22

fn put_get_descriptor(dst: u64, entry: u64, offset: u64, length: u64) -> u64 {
    octets.st8(dst, 0, entry)
    octets.st32(dst, 1, offset)
    octets.st32(dst, 5, length)
    octets.st8(dst, 9, 0)
    return SLICE_HDR_LEN
}

fn slice_ok(p: u64, n: u64) -> bool {
    return n >= SLICE_HDR_LEN && octets.ld32(p, 5) <= n - SLICE_HDR_LEN
}

fn slice_offset(p: u64) -> u64 {
    return octets.ld32(p, 1)
}

fn slice_length(p: u64) -> u64 {
    return octets.ld32(p, 5)
}

fn slice_end(p: u64) -> bool {
    return octets.ld8(p, 9) != 0
}

fn slice_data(p: u64) -> u64 {
    return p + SLICE_HDR_LEN
}

fn put_event_params(dst: u64, tc: u64, iid: u64, flags: u64) -> u64 {
    octets.st8(dst, 0, tc)
    octets.st8(dst, 1, flags)
    octets.st16(dst, 2, tc)
    octets.st8(dst, 4, iid)
    return 5
}

fn event_status_ok(p: u64, n: u64) -> bool {
    return n >= 1 && octets.ld8(p, 0) == 0
}

fn hid_desc_ok(p: u64, n: u64) -> bool {
    return n >= HID_DESC_LEN && octets.ld8(p, 0) == HID_DESC_LEN && octets.ld8(p, 1) == HID_DT_HID
        && octets.ld8(p, 5) == 1 && octets.ld8(p, 6) == HID_DT_REPORT
}

fn hid_desc_report_len(p: u64) -> u64 {
    return octets.ld16(p, 7)
}

fn attrs_length(p: u64) -> u64 {
    return octets.ld32(p, 0)
}

fn attrs_vendor(p: u64) -> u64 {
    return octets.ld16(p, 4)
}

fn attrs_product(p: u64) -> u64 {
    return octets.ld16(p, 6)
}

fn attrs_version(p: u64) -> u64 {
    return octets.ld16(p, 8)
}

fn is_input_report(tc: u64, cid: u64) -> bool {
    return tc == TC_HID && cid == CID_INPUT_REPORT
}
