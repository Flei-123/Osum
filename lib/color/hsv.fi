// SPDX-License-Identifier: MPL-2.0
export {
    to_rgb, hue_of, sat_of, val_of,
}

fn scale255(v: u64) -> u64 {
    return (v * 255 + 50) / 100
}

fn pack(r: u64, g: u64, b: u64) -> u64 {
    return (scale255(r) << 16) | (scale255(g) << 8) | scale255(b)
}

fn to_rgb(h: u64, s: u64, v: u64) -> u64 {
    let hh: u64 = (h % 360) / 60
    let f: u64 = (h % 360) % 60
    let p: u64 = v * (100 - s) / 100
    let q: u64 = v * (100 - s * f / 60) / 100
    let t: u64 = v * (100 - s * (60 - f) / 60) / 100
    if hh == 0 {
        return pack(v, t, p)
    }
    if hh == 1 {
        return pack(q, v, p)
    }
    if hh == 2 {
        return pack(p, v, t)
    }
    if hh == 3 {
        return pack(p, q, v)
    }
    if hh == 4 {
        return pack(t, p, v)
    }
    return pack(v, p, q)
}

fn max3(r: u64, g: u64, b: u64) -> u64 {
    var m: u64 = r
    if g > m {
        m = g
    }
    if b > m {
        m = b
    }
    return m
}

fn min3(r: u64, g: u64, b: u64) -> u64 {
    var m: u64 = r
    if g < m {
        m = g
    }
    if b < m {
        m = b
    }
    return m
}

fn val_of(rgb: u64) -> u64 {
    return max3((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255) * 100 / 255
}

fn sat_of(rgb: u64) -> u64 {
    let mx: u64 = max3((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255)
    let mn: u64 = min3((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255)
    if mx == 0 {
        return 0
    }
    return (mx - mn) * 100 / mx
}

fn hue_of(rgb: u64) -> u64 {
    let r: u64 = (rgb >> 16) & 255
    let g: u64 = (rgb >> 8) & 255
    let b: u64 = rgb & 255
    let mx: u64 = max3(r, g, b)
    let mn: u64 = min3(r, g, b)
    let d: u64 = mx - mn
    if d == 0 {
        return 0
    }
    if mx == r {
        if g >= b {
            return 60 * (g - b) / d
        }
        return 360 - 60 * (b - g) / d
    }
    if mx == g {
        if b >= r {
            return 120 + 60 * (b - r) / d
        }
        return 120 - 60 * (r - b) / d
    }
    if r >= g {
        return 240 + 60 * (r - g) / d
    }
    return 240 - 60 * (g - r) / d
}
