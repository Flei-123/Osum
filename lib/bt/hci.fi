import usbnet.le

export {
    OP_RESET, OP_READ_VERSION, OP_READ_BD_ADDR, OP_WRITE_INQUIRY_MODE, OP_INQUIRY, OP_INQUIRY_CANCEL,
    EV_INQUIRY_COMPLETE, EV_INQUIRY_RESULT, EV_COMMAND_COMPLETE, EV_COMMAND_STATUS, EV_INQUIRY_RSSI,
    EV_EXTENDED_INQUIRY,
    GIAC_LAP, RSSI_NONE, INIT_STEPS, REC_SIZE, TAB_HDR, REC_ADDR, REC_RSSI, REC_NLEN, REC_COD, REC_NAME,
    NAME_MAX, KIND_OTHER, KIND_COMPUTER, KIND_PHONE, KIND_AUDIO, KIND_INPUT,
    build_command, build_inquiry, build_inquiry_cancel, init_opcode, build_init,
    event_code, event_plen, event_ok, cc_opcode, cc_status, cc_result, cs_opcode, cs_status, complete_status,
    version_hci, version_manufacturer,
    inq_ok, inq_count, inq_addr, inq_cod, inq_rssi, inq_eir,
    tab_size, tab_clear, tab_count, tab_rec, tab_add, tab_find,
    eir_name, fmt_addr, cod_kind, signed_rssi
}

const OP_RESET: u64 = 0x0C03
const OP_READ_VERSION: u64 = 0x1001
const OP_READ_BD_ADDR: u64 = 0x1009
const OP_WRITE_INQUIRY_MODE: u64 = 0x0C45
const OP_INQUIRY: u64 = 0x0401
const OP_INQUIRY_CANCEL: u64 = 0x0402

const EV_INQUIRY_COMPLETE: u64 = 0x01
const EV_INQUIRY_RESULT: u64 = 0x02
const EV_COMMAND_COMPLETE: u64 = 0x0E
const EV_COMMAND_STATUS: u64 = 0x0F
const EV_INQUIRY_RSSI: u64 = 0x22
const EV_EXTENDED_INQUIRY: u64 = 0x2F

const GIAC_LAP: u64 = 0x9E8B33
const RSSI_NONE: u64 = 127
const INIT_STEPS: u64 = 4
const MAX_PARAMS: u64 = 16

const REC_SIZE: u64 = 32
const TAB_HDR: u64 = 8
const REC_ADDR: u64 = 0
const REC_RSSI: u64 = 6
const REC_NLEN: u64 = 7
const REC_COD: u64 = 8
const REC_NAME: u64 = 12
const NAME_MAX: u64 = 19

const KIND_OTHER: u64 = 0
const KIND_COMPUTER: u64 = 1
const KIND_PHONE: u64 = 2
const KIND_AUDIO: u64 = 3
const KIND_INPUT: u64 = 4

const ENTRY_LEN: u64 = 14

fn build_command(dst: u64, op: u64, params: u64, n: u64) -> u64 {
    var len: u64 = n
    if len > MAX_PARAMS {
        len = MAX_PARAMS
    }
    le.put16(dst, 0, op)
    le.st8(dst, 2, len)
    var i: u64 = 0
    while i < len {
        le.st8(dst, 3 + i, le.ld8(params, i))
        i = i + 1
    }
    return 3 + len
}

fn build_inquiry(dst: u64, lap: u64, length: u64, max: u64) -> u64 {
    var p: [u8; 5] = [0 as u8; 5]
    let pp: u64 = (&p[0]) as u64
    le.st8(pp, 0, lap)
    le.st8(pp, 1, lap >> 8)
    le.st8(pp, 2, lap >> 16)
    le.st8(pp, 3, length)
    le.st8(pp, 4, max)
    return build_command(dst, OP_INQUIRY, pp, 5)
}

fn build_inquiry_cancel(dst: u64) -> u64 {
    return build_command(dst, OP_INQUIRY_CANCEL, 0, 0)
}

fn init_opcode(step: u64) -> u64 {
    if step == 0 { return OP_RESET }
    if step == 1 { return OP_READ_VERSION }
    if step == 2 { return OP_READ_BD_ADDR }
    if step == 3 { return OP_WRITE_INQUIRY_MODE }
    return 0
}

fn build_init(dst: u64, step: u64) -> u64 {
    let op: u64 = init_opcode(step)
    if op == 0 {
        return 0
    }
    var p: [u8; 1] = [1 as u8; 1]
    if op == OP_WRITE_INQUIRY_MODE {
        return build_command(dst, op, (&p[0]) as u64, 1)
    }
    return build_command(dst, op, 0, 0)
}

fn event_code(ev: u64) -> u64 {
    return le.ld8(ev, 0)
}

fn event_plen(ev: u64) -> u64 {
    return le.ld8(ev, 1)
}

fn event_ok(ev: u64, n: u64) -> bool {
    if n < 2 {
        return false
    }
    return 2 + event_plen(ev) <= n
}

fn cc_opcode(ev: u64) -> u64 {
    if event_plen(ev) < 4 {
        return 0
    }
    return le.get16(ev, 3)
}

fn cc_status(ev: u64) -> u64 {
    if event_plen(ev) < 4 {
        return 0xFF
    }
    return le.ld8(ev, 5)
}

fn cc_result(ev: u64) -> u64 {
    return ev + 6
}

fn cs_opcode(ev: u64) -> u64 {
    if event_plen(ev) < 4 {
        return 0
    }
    return le.get16(ev, 4)
}

fn cs_status(ev: u64) -> u64 {
    if event_plen(ev) < 4 {
        return 0xFF
    }
    return le.ld8(ev, 2)
}

fn complete_status(ev: u64) -> u64 {
    if event_plen(ev) < 1 {
        return 0xFF
    }
    return le.ld8(ev, 2)
}

fn version_hci(ev: u64) -> u64 {
    if event_plen(ev) < 12 {
        return 0
    }
    return le.ld8(ev, 6)
}

fn version_manufacturer(ev: u64) -> u64 {
    if event_plen(ev) < 12 {
        return 0
    }
    return le.get16(ev, 10)
}

fn inq_count(ev: u64) -> u64 {
    if event_plen(ev) < 1 {
        return 0
    }
    return le.ld8(ev, 2)
}

fn inq_ok(ev: u64) -> bool {
    let code: u64 = event_code(ev)
    let plen: u64 = event_plen(ev)
    if code == EV_EXTENDED_INQUIRY {
        return plen >= 1 + ENTRY_LEN && inq_count(ev) == 1
    }
    if code != EV_INQUIRY_RESULT && code != EV_INQUIRY_RSSI {
        return false
    }
    return plen >= 1 && 1 + inq_count(ev) * ENTRY_LEN <= plen
}

fn entry_at(ev: u64, i: u64) -> u64 {
    return ev + 3 + i * ENTRY_LEN
}

fn inq_addr(ev: u64, i: u64) -> u64 {
    return entry_at(ev, i)
}

fn inq_cod(ev: u64, i: u64) -> u64 {
    let e: u64 = entry_at(ev, i)
    var at: u64 = 8
    if event_code(ev) == EV_INQUIRY_RESULT {
        at = 9
    }
    return le.ld8(e, at) | (le.ld8(e, at + 1) << 8) | (le.ld8(e, at + 2) << 16)
}

fn inq_rssi(ev: u64, i: u64) -> u64 {
    if event_code(ev) == EV_INQUIRY_RESULT {
        return RSSI_NONE
    }
    return le.ld8(entry_at(ev, i), 13)
}

fn inq_eir(ev: u64) -> u64 {
    if event_code(ev) != EV_EXTENDED_INQUIRY {
        return 0
    }
    return entry_at(ev, 0) + ENTRY_LEN
}

fn signed_rssi(v: u64) -> i64 {
    if v >= 128 {
        return (v as i64) - 256
    }
    return v as i64
}

fn tab_size(cap: u64) -> u64 {
    return TAB_HDR + cap * REC_SIZE
}

fn tab_clear(tab: u64, cap: u64) {
    le.zero(tab, tab_size(cap))
}

fn tab_count(tab: u64) -> u64 {
    return le.get64(tab, 0)
}

fn tab_rec(tab: u64, i: u64) -> u64 {
    return tab + TAB_HDR + i * REC_SIZE
}

fn same_addr(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while i < 6 {
        if le.ld8(a, i) != le.ld8(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn tab_find(tab: u64, addr: u64) -> u64 {
    let n: u64 = tab_count(tab)
    var i: u64 = 0
    while i < n {
        if same_addr(tab_rec(tab, i), addr) {
            return i
        }
        i = i + 1
    }
    return 0xFFFFFFFF
}

fn tab_add(tab: u64, cap: u64, addr: u64, cod: u64, rssi: u64, name: u64, nlen: u64) -> u64 {
    var idx: u64 = tab_find(tab, addr)
    if idx == 0xFFFFFFFF {
        let n: u64 = tab_count(tab)
        if n >= cap {
            return 0xFFFFFFFF
        }
        idx = n
        le.put64(tab, 0, n + 1)
        let r0: u64 = tab_rec(tab, idx)
        le.zero(r0, REC_SIZE)
        var k: u64 = 0
        while k < 6 {
            le.st8(r0, REC_ADDR + k, le.ld8(addr, k))
            k = k + 1
        }
    }
    let r: u64 = tab_rec(tab, idx)
    if cod != 0 {
        le.put32(r, REC_COD, cod)
    }
    if rssi != RSSI_NONE {
        le.st8(r, REC_RSSI, rssi)
    }
    if nlen > 0 {
        var m: u64 = nlen
        if m > NAME_MAX {
            m = NAME_MAX
        }
        var j: u64 = 0
        while j < m {
            le.st8(r, REC_NAME + j, le.ld8(name, j))
            j = j + 1
        }
        le.st8(r, REC_NAME + m, 0)
        le.st8(r, REC_NLEN, m)
    }
    return idx
}

fn eir_name(eir: u64, n: u64, dst: u64, max: u64) -> u64 {
    var at: u64 = 0
    while at + 1 < n {
        let len: u64 = le.ld8(eir, at)
        if len == 0 || at + 1 + len > n {
            return 0
        }
        let kind: u64 = le.ld8(eir, at + 1)
        if kind == 0x09 || kind == 0x08 {
            var m: u64 = len - 1
            if m > max {
                m = max
            }
            var i: u64 = 0
            while i < m {
                var c: u64 = le.ld8(eir, at + 2 + i)
                if c < 32 || c > 126 {
                    c = 63
                }
                le.st8(dst, i, c)
                i = i + 1
            }
            return m
        }
        at = at + 1 + len
    }
    return 0
}

fn hex_digit(v: u64) -> u64 {
    if v < 10 {
        return 48 + v
    }
    return 55 + v
}

fn fmt_addr(dst: u64, addr: u64) -> u64 {
    var o: u64 = 0
    var i: u64 = 6
    while i > 0 {
        i = i - 1
        let b: u64 = le.ld8(addr, i)
        le.st8(dst, o, hex_digit(b >> 4))
        le.st8(dst, o + 1, hex_digit(b & 15))
        o = o + 2
        if i > 0 {
            le.st8(dst, o, 58)
            o = o + 1
        }
    }
    le.st8(dst, o, 0)
    return o
}

fn cod_kind(cod: u64) -> u64 {
    let major: u64 = (cod >> 8) & 0x1F
    if major == 1 { return KIND_COMPUTER }
    if major == 2 { return KIND_PHONE }
    if major == 4 { return KIND_AUDIO }
    if major == 5 { return KIND_INPUT }
    return KIND_OTHER
}
