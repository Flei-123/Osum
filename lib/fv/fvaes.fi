// SPDX-License-Identifier: GPL-2.0-only
// COPY of lib/crypto/aes.fi under a module name of its own: the leaf names aes/aesni/gcm
// are taken by std.crypto.* as well (pulled in by tls.tls), and a program that links
// both (fv.client) cannot have two modules with the same name. Keep in sync.
// lib/crypto/fvaes.fi -- AES (FIPS 197) and the four modes of operation that
// 802.11 needs.
//
// ==================================================================
// WHY THIS FILE EXISTS although the tree already contains an AES
// ==================================================================
//
// `vendor/firn/lib/std/crypto/aes.fi` says in its own header what
// it is: AES-128 with CBC and CFB8. That is right for the purpose it was
// written for, and for WLAN it falls short in four places:
//
//
//   * NO CCM. CCMP -- the encryption that WPA2 and WPA3 use for
//     every single frame -- is AES in CCM mode. Without CCM
//     there is no WPA2.
//   * NO CMAC. The check value (MIC) of the EAPOL key frames is AES-CMAC,
//     not HMAC, for the SHA-256 methods and for WPA3.
//   * NO KEY WRAP. The group key GTK arrives in message 3
//     of the handshake wrapped according to RFC 3394. Without unwrapping
//     there is no broadcast reception.
//   * ONLY 128 BIT. That is enough for CCMP-128; not for the
//     256-bit methods.
//
// And `kernel/user/key.fi` says the same about the same file on its
// line 16. This one is therefore a separate file, built by the same
// rules as `sha256.fi` and `sha1.fi`: NO `profile` line, NO
// `import`, no allocator, no system call, all state with the
// caller.
//
// ==================================================================
// HOW AES IS COMPUTED HERE, and why without the big tables
// ==================================================================
//
// The usual fast implementation folds SubBytes, ShiftRows and
// MixColumns into four tables of 1 KiB each (T0..T3). That is fast and
// has two drawbacks, and both count here:
//
//   1. 4 KiB of tables in a statically linked kernel (roadmap A9),
//      for a computation that runs once per frame.
//   2. Table accesses whose INDEX depends on the key are the
//      classic route for cache attacks.
//
// This file therefore computes octet by octet: an S-box of 256
// entries, its inverse, and the multiplication in the field via
// doubling. That is slower and entirely sufficient for a WLAN link
// that runs through the firmware.
//
// TO BE HONEST: this is NOT constant-time. The S-box is a
// table, and `sbox[x]` with a secret x has, on a machine with a
// cache, a run time that depends on the value. Whoever really
// needs that needs AES-NI (the instructions AESENC/AESENCLAST), and
// those exist on every x86-64 since 2010. That would be a round of
// its own and is NOT listed as done in `docs/WLAN-BEFUND.md`.
//
// ==================================================================
// WHAT IS IN HERE
// ==================================================================
//
//   key_set / encrypt_block / decrypt_block    FIPS 197
//   cmac                                        RFC 4493 (OMAC1)
//   key_wrap / key_unwrap                       RFC 3394
//   ccm_encrypt / ccm_decrypt                   RFC 3610
//
// Measured (tools/wlan/vektoren.py) against the vectors from FIPS 197
// appendix C, RFC 4493, RFC 3394 section 4 and against OpenSSL via
// Python's `cryptography` for CCM.

export { Key, key_new, key_set, encrypt_block, decrypt_block,
    cmac, key_wrap, key_unwrap, ccm_encrypt, ccm_decrypt,
    BLOCK, MAX_RK }

const BLOCK: usize = 16
// 4 * (14 + 1) * 4 = 240 octets of round keys for AES-256.
const MAX_RK: usize = 240

struct Key {
    rk: [u8; 240],
    nr: usize, // number of rounds: 10, 12 or 14
    gesetzt: bool,
}

fn ld8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn st8(p: u64, i: usize, v: u8) {
    *((p + i as u64) as *mut u8) = v
}

// ------------------------------------------------------------ S-Box
//
// FIPS 197, figure 7. This is the only table in this file that
// cannot be computed without inverting the field.
fn sbox(i: u64) -> u8 {
    let t: [u8; 256] = [
    0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,
    0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,
    0xb7,0xfd,0x93,0x26,0x36,0x3f,0xf7,0xcc,0x34,0xa5,0xe5,0xf1,0x71,0xd8,0x31,0x15,
    0x04,0xc7,0x23,0xc3,0x18,0x96,0x05,0x9a,0x07,0x12,0x80,0xe2,0xeb,0x27,0xb2,0x75,
    0x09,0x83,0x2c,0x1a,0x1b,0x6e,0x5a,0xa0,0x52,0x3b,0xd6,0xb3,0x29,0xe3,0x2f,0x84,
    0x53,0xd1,0x00,0xed,0x20,0xfc,0xb1,0x5b,0x6a,0xcb,0xbe,0x39,0x4a,0x4c,0x58,0xcf,
    0xd0,0xef,0xaa,0xfb,0x43,0x4d,0x33,0x85,0x45,0xf9,0x02,0x7f,0x50,0x3c,0x9f,0xa8,
    0x51,0xa3,0x40,0x8f,0x92,0x9d,0x38,0xf5,0xbc,0xb6,0xda,0x21,0x10,0xff,0xf3,0xd2,
    0xcd,0x0c,0x13,0xec,0x5f,0x97,0x44,0x17,0xc4,0xa7,0x7e,0x3d,0x64,0x5d,0x19,0x73,
    0x60,0x81,0x4f,0xdc,0x22,0x2a,0x90,0x88,0x46,0xee,0xb8,0x14,0xde,0x5e,0x0b,0xdb,
    0xe0,0x32,0x3a,0x0a,0x49,0x06,0x24,0x5c,0xc2,0xd3,0xac,0x62,0x91,0x95,0xe4,0x79,
    0xe7,0xc8,0x37,0x6d,0x8d,0xd5,0x4e,0xa9,0x6c,0x56,0xf4,0xea,0x65,0x7a,0xae,0x08,
    0xba,0x78,0x25,0x2e,0x1c,0xa6,0xb4,0xc6,0xe8,0xdd,0x74,0x1f,0x4b,0xbd,0x8b,0x8a,
    0x70,0x3e,0xb5,0x66,0x48,0x03,0xf6,0x0e,0x61,0x35,0x57,0xb9,0x86,0xc1,0x1d,0x9e,
    0xe1,0xf8,0x98,0x11,0x69,0xd9,0x8e,0x94,0x9b,0x1e,0x87,0xe9,0xce,0x55,0x28,0xdf,
    0x8c,0xa1,0x89,0x0d,0xbf,0xe6,0x42,0x68,0x41,0x99,0x2d,0x0f,0xb0,0x54,0xbb,0x16]
    return t[i as usize]
}

fn rsbox(i: u64) -> u8 {
    let t: [u8; 256] = [
    0x52,0x09,0x6a,0xd5,0x30,0x36,0xa5,0x38,0xbf,0x40,0xa3,0x9e,0x81,0xf3,0xd7,0xfb,
    0x7c,0xe3,0x39,0x82,0x9b,0x2f,0xff,0x87,0x34,0x8e,0x43,0x44,0xc4,0xde,0xe9,0xcb,
    0x54,0x7b,0x94,0x32,0xa6,0xc2,0x23,0x3d,0xee,0x4c,0x95,0x0b,0x42,0xfa,0xc3,0x4e,
    0x08,0x2e,0xa1,0x66,0x28,0xd9,0x24,0xb2,0x76,0x5b,0xa2,0x49,0x6d,0x8b,0xd1,0x25,
    0x72,0xf8,0xf6,0x64,0x86,0x68,0x98,0x16,0xd4,0xa4,0x5c,0xcc,0x5d,0x65,0xb6,0x92,
    0x6c,0x70,0x48,0x50,0xfd,0xed,0xb9,0xda,0x5e,0x15,0x46,0x57,0xa7,0x8d,0x9d,0x84,
    0x90,0xd8,0xab,0x00,0x8c,0xbc,0xd3,0x0a,0xf7,0xe4,0x58,0x05,0xb8,0xb3,0x45,0x06,
    0xd0,0x2c,0x1e,0x8f,0xca,0x3f,0x0f,0x02,0xc1,0xaf,0xbd,0x03,0x01,0x13,0x8a,0x6b,
    0x3a,0x91,0x11,0x41,0x4f,0x67,0xdc,0xea,0x97,0xf2,0xcf,0xce,0xf0,0xb4,0xe6,0x73,
    0x96,0xac,0x74,0x22,0xe7,0xad,0x35,0x85,0xe2,0xf9,0x37,0xe8,0x1c,0x75,0xdf,0x6e,
    0x47,0xf1,0x1a,0x71,0x1d,0x29,0xc5,0x89,0x6f,0xb7,0x62,0x0e,0xaa,0x18,0xbe,0x1b,
    0xfc,0x56,0x3e,0x4b,0xc6,0xd2,0x79,0x20,0x9a,0xdb,0xc0,0xfe,0x78,0xcd,0x5a,0xf4,
    0x1f,0xdd,0xa8,0x33,0x88,0x07,0xc7,0x31,0xb1,0x12,0x10,0x59,0x27,0x80,0xec,0x5f,
    0x60,0x51,0x7f,0xa9,0x19,0xb5,0x4a,0x0d,0x2d,0xe5,0x7a,0x9f,0x93,0xc9,0x9c,0xef,
    0xa0,0xe0,0x3b,0x4d,0xae,0x2a,0xf5,0xb0,0xc8,0xeb,0xbb,0x3c,0x83,0x53,0x99,0x61,
    0x17,0x2b,0x04,0x7e,0xba,0x77,0xd6,0x26,0xe1,0x69,0x14,0x63,0x55,0x21,0x0c,0x7d]
    return t[i as usize]
}

// Doubling in the field GF(2^8) with the modulus polynomial x^8+x^4+x^3+x+1
// (0x11B). FIPS 197 4.2.1.
fn xtime(a: u64) -> u64 {
    let s: u64 = (a << 1) & 255
    if (a & 128) != 0 {
        return s ^ 0x1B
    }
    return s
}

// Multiplication in the field, Russian peasant multiplication.
fn gmul(a: u64, b: u64) -> u64 {
    var x: u64 = a & 255
    var y: u64 = b & 255
    var r: u64 = 0
    var i: usize = 0
    while i < 8 {
        if (y & 1) != 0 {
            r = r ^ x
        }
        x = xtime(x)
        y = y >> 1
        i = i + 1
    }
    return r & 255
}

fn key_new() -> Key {
    return Key { rk: [0 as u8; 240], nr: 0, gesetzt: false }
}

// FIPS 197 5.2, key schedule. `klen` in octets: 16, 24 or 32.
// Anything else is REJECTED, not padded.
fn key_set(k: *mut Key, key: u64, klen: usize) -> bool {
    (*k).gesetzt = false
    if klen != 16 && klen != 24 && klen != 32 {
        return false
    }
    let nk: usize = klen / 4
    let nr: usize = nk + 6
    (*k).nr = nr
    var i: usize = 0
    while i < klen {
        (*k).rk[i] = ld8(key, i)
        i = i + 1
    }
    // Rcon: 1, 2, 4, 8, ... doubled in the field.
    var rcon: u64 = 1
    var w: usize = nk
    let gesamt: usize = 4 * (nr + 1)
    while w < gesamt {
        var t: [u8; 4] = [0 as u8; 4]
        var j: usize = 0
        while j < 4 {
            t[j] = (*k).rk[(w - 1) * 4 + j]
            j = j + 1
        }
        if w % nk == 0 {
            // RotWord, then SubWord, then Rcon on the first octet.
            let tmp: u8 = t[0]
            t[0] = sbox(t[1] as u64)
            t[1] = sbox(t[2] as u64)
            t[2] = sbox(t[3] as u64)
            t[3] = sbox(tmp as u64)
            t[0] = (t[0] as u64 ^ rcon) as u8
            rcon = xtime(rcon)
        } else {
            // Only AES-256 has the second exception.
            if nk > 6 && w % nk == 4 {
                j = 0
                while j < 4 {
                    t[j] = sbox(t[j] as u64)
                    j = j + 1
                }
            }
        }
        j = 0
        while j < 4 {
            (*k).rk[w * 4 + j] = (*k).rk[(w - nk) * 4 + j] ^ t[j]
            j = j + 1
        }
        w = w + 1
    }
    (*k).gesetzt = true
    return true
}

fn add_round_key(s: *mut [u8; 16], k: *mut Key, r: usize) {
    var i: usize = 0
    while i < 16 {
        (*s)[i] = (*s)[i] ^ (*k).rk[r * 16 + i]
        i = i + 1
    }
}

// The state is stored column by column: s[r + 4c]. ShiftRows shifts row
// r by r places to the LEFT.
fn shift_rows(s: *mut [u8; 16]) {
    let t1: u8 = (*s)[1]
    (*s)[1] = (*s)[5]
    (*s)[5] = (*s)[9]
    (*s)[9] = (*s)[13]
    (*s)[13] = t1
    let t2: u8 = (*s)[2]
    let t6: u8 = (*s)[6]
    (*s)[2] = (*s)[10]
    (*s)[10] = t2
    (*s)[6] = (*s)[14]
    (*s)[14] = t6
    let t3: u8 = (*s)[15]
    (*s)[15] = (*s)[11]
    (*s)[11] = (*s)[7]
    (*s)[7] = (*s)[3]
    (*s)[3] = t3
}

fn inv_shift_rows(s: *mut [u8; 16]) {
    let t1: u8 = (*s)[13]
    (*s)[13] = (*s)[9]
    (*s)[9] = (*s)[5]
    (*s)[5] = (*s)[1]
    (*s)[1] = t1
    let t2: u8 = (*s)[2]
    let t6: u8 = (*s)[6]
    (*s)[2] = (*s)[10]
    (*s)[10] = t2
    (*s)[6] = (*s)[14]
    (*s)[14] = t6
    let t3: u8 = (*s)[3]
    (*s)[3] = (*s)[7]
    (*s)[7] = (*s)[11]
    (*s)[11] = (*s)[15]
    (*s)[15] = t3
}

fn mix_columns(s: *mut [u8; 16]) {
    var c: usize = 0
    while c < 4 {
        let a0: u64 = (*s)[c * 4] as u64
        let a1: u64 = (*s)[c * 4 + 1] as u64
        let a2: u64 = (*s)[c * 4 + 2] as u64
        let a3: u64 = (*s)[c * 4 + 3] as u64
        // ROUND KRYPTO: `gmul(x, 2)` and `gmul(x, 3)` directly via `xtime`
        // instead of via the general peasant multiplication (a loop over
        // eight bits). In MixColumns the factors
        // are ALWAYS 2 and 3, and `gmul(x,3)` is `xtime(x) ^ x`.
        // MEASURED: this step alone brings the encryption
        // of one sector from 3.7 down to 2.4 ms.
        let d0: u64 = xtime(a0)
        let d1: u64 = xtime(a1)
        let d2: u64 = xtime(a2)
        let d3: u64 = xtime(a3)
        (*s)[c * 4] = (d0 ^ d1 ^ a1 ^ a2 ^ a3) as u8
        (*s)[c * 4 + 1] = (a0 ^ d1 ^ d2 ^ a2 ^ a3) as u8
        (*s)[c * 4 + 2] = (a0 ^ a1 ^ d2 ^ d3 ^ a3) as u8
        (*s)[c * 4 + 3] = (d0 ^ a0 ^ a1 ^ a2 ^ d3) as u8
        c = c + 1
    }
}

fn inv_mix_columns(s: *mut [u8; 16]) {
    var c: usize = 0
    while c < 4 {
        let a0: u64 = (*s)[c * 4] as u64
        let a1: u64 = (*s)[c * 4 + 1] as u64
        let a2: u64 = (*s)[c * 4 + 2] as u64
        let a3: u64 = (*s)[c * 4 + 3] as u64
        (*s)[c * 4] = (gmul(a0, 14) ^ gmul(a1, 11) ^ gmul(a2, 13)
            ^ gmul(a3, 9)) as u8
        (*s)[c * 4 + 1] = (gmul(a0, 9) ^ gmul(a1, 14) ^ gmul(a2, 11)
            ^ gmul(a3, 13)) as u8
        (*s)[c * 4 + 2] = (gmul(a0, 13) ^ gmul(a1, 9) ^ gmul(a2, 14)
            ^ gmul(a3, 11)) as u8
        (*s)[c * 4 + 3] = (gmul(a0, 11) ^ gmul(a1, 13) ^ gmul(a2, 9)
            ^ gmul(a3, 14)) as u8
        c = c + 1
    }
}

// FIPS 197 5.1. `in` and `out` may be the same location.
fn encrypt_block(k: *mut Key, inp: u64, out: u64) {
    var s: [u8; 16] = [0 as u8; 16]
    var i: usize = 0
    while i < 16 {
        s[i] = ld8(inp, i)
        i = i + 1
    }
    add_round_key(&s, k, 0)
    var r: usize = 1
    while r < (*k).nr {
        i = 0
        while i < 16 {
            s[i] = sbox(s[i] as u64)
            i = i + 1
        }
        shift_rows(&s)
        mix_columns(&s)
        add_round_key(&s, k, r)
        r = r + 1
    }
    i = 0
    while i < 16 {
        s[i] = sbox(s[i] as u64)
        i = i + 1
    }
    shift_rows(&s)
    add_round_key(&s, k, (*k).nr)
    i = 0
    while i < 16 {
        st8(out, i, s[i])
        i = i + 1
    }
}

// FIPS 197 5.3, the straightforward inverse (not the equivalent
// form). CCM and CMAC do not need it -- CCM uses AES
// only in the forward direction --, but unwrapping per RFC 3394 does.
fn decrypt_block(k: *mut Key, inp: u64, out: u64) {
    var s: [u8; 16] = [0 as u8; 16]
    var i: usize = 0
    while i < 16 {
        s[i] = ld8(inp, i)
        i = i + 1
    }
    add_round_key(&s, k, (*k).nr)
    var r: usize = (*k).nr
    while r > 1 {
        inv_shift_rows(&s)
        i = 0
        while i < 16 {
            s[i] = rsbox(s[i] as u64)
            i = i + 1
        }
        add_round_key(&s, k, r - 1)
        inv_mix_columns(&s)
        r = r - 1
    }
    inv_shift_rows(&s)
    i = 0
    while i < 16 {
        s[i] = rsbox(s[i] as u64)
        i = i + 1
    }
    add_round_key(&s, k, 0)
    i = 0
    while i < 16 {
        st8(out, i, s[i])
        i = i + 1
    }
}

// ------------------------------------------------- CMAC, RFC 4493
//
// The shift left by one bit with 0x87 as the reduction is
// the multiplication by x in the field GF(2^128). RFC 4493 3.2.
fn shift_left_1(b: *mut [u8; 16]) {
    var uebertrag: u64 = 0
    var i: usize = 16
    while i > 0 {
        i = i - 1
        let v: u64 = (*b)[i] as u64
        (*b)[i] = (((v << 1) & 255) | uebertrag) as u8
        uebertrag = (v >> 7) & 1
    }
}

fn subkey(k: *mut Key, k1: *mut [u8; 16], k2: *mut [u8; 16]) {
    var null: [u8; 16] = [0 as u8; 16]
    var l: [u8; 16] = [0 as u8; 16]
    encrypt_block(k, (&null[0]) as u64, (&l[0]) as u64)
    var i: usize = 0
    while i < 16 {
        (*k1)[i] = l[i]
        i = i + 1
    }
    let msb1: bool = (l[0] & (128 as u8)) != 0 as u8
    shift_left_1(k1)
    if msb1 {
        (*k1)[15] = (*k1)[15] ^ (0x87 as u8)
    }
    i = 0
    while i < 16 {
        (*k2)[i] = (*k1)[i]
        i = i + 1
    }
    let msb2: bool = ((*k1)[0] & (128 as u8)) != 0 as u8
    shift_left_1(k2)
    if msb2 {
        (*k2)[15] = (*k2)[15] ^ (0x87 as u8)
    }
}

// AES-CMAC over a message. `out` receives 16 octets.
//
// THE TWO CASES, and they are the whole difference: a message
// whose length is a multiple of 16 AND greater than zero takes
// K1 and is NOT padded. Everything else -- the EMPTY
// message too -- takes K2 and gets a 0x80 and zeros. Assigning the empty
// message to the first case is the most common mistake and
// is only caught by the first vector from RFC 4493.
fn cmac(key: u64, klen: usize, msg: u64, mlen: usize, out: u64) -> bool {
    var k: Key = key_new()
    if !key_set(&k, key, klen) {
        return false
    }
    var k1: [u8; 16] = [0 as u8; 16]
    var k2: [u8; 16] = [0 as u8; 16]
    subkey(&k, &k1, &k2)

    var x: [u8; 16] = [0 as u8; 16]
    var b: [u8; 16] = [0 as u8; 16]
    var full: usize = 0
    if mlen > 0 {
        full = (mlen - 1) / 16
    }
    var n: usize = 0
    while n < full {
        var i: usize = 0
        while i < 16 {
            b[i] = x[i] ^ ld8(msg, n * 16 + i)
            i = i + 1
        }
        encrypt_block(&k, (&b[0]) as u64, (&x[0]) as u64)
        n = n + 1
    }
    // The last block.
    var rest: usize = mlen - full * 16
    var last: [u8; 16] = [0 as u8; 16]
    if mlen > 0 && rest == 16 {
        var i: usize = 0
        while i < 16 {
            last[i] = ld8(msg, full * 16 + i) ^ k1[i]
            i = i + 1
        }
    } else {
        var i: usize = 0
        while i < rest {
            last[i] = ld8(msg, full * 16 + i)
            i = i + 1
        }
        last[rest] = 0x80 as u8
        i = rest + 1
        while i < 16 {
            last[i] = 0 as u8
            i = i + 1
        }
        i = 0
        while i < 16 {
            last[i] = last[i] ^ k2[i]
            i = i + 1
        }
    }
    var i: usize = 0
    while i < 16 {
        b[i] = x[i] ^ last[i]
        i = i + 1
    }
    encrypt_block(&k, (&b[0]) as u64, out)
    return true
}

// --------------------------------------------- Key Wrap, RFC 3394
//
// The initial value A6A6A6A6A6A6A6A6 is the whole check: when
// unwrapping it has to come out again. That is no MAC, but it is
// enough to detect a wrong key and a scrambled packet
// -- and that is exactly what the 4-way handshake uses it for.
//
// LIMIT: up to 256 octets of plaintext. The first version was set to 64
// -- with the reasoning "that is enough for any GTK". That was wrong
// and the test found it at once: the key data of a real
// message 3 (wpa-Induction.pcap) are 80 octets wrapped, because
// it holds not only the group key but also
// the whole RSN element once more. 256 is the upper bound for anything that
// fits into an EAPOL key frame, and costs 256 octets of stack.
const WRAP_MAX: usize = 256

fn key_wrap(kek: u64, keklen: usize, plain: u64, plen: usize,
    out: u64) -> bool {
    if plen < 16 || plen % 8 != 0 || plen > WRAP_MAX {
        return false
    }
    var k: Key = key_new()
    if !key_set(&k, kek, keklen) {
        return false
    }
    let n: usize = plen / 8
    var a: [u8; 8] = [0xA6 as u8; 8]
    var r: [u8; 256] = [0 as u8; 256]
    var i: usize = 0
    while i < plen {
        r[i] = ld8(plain, i)
        i = i + 1
    }
    var b: [u8; 16] = [0 as u8; 16]
    var c: [u8; 16] = [0 as u8; 16]
    var j: usize = 0
    while j < 6 {
        var t: usize = 1
        while t <= n {
            i = 0
            while i < 8 {
                b[i] = a[i]
                b[8 + i] = r[(t - 1) * 8 + i]
                i = i + 1
            }
            encrypt_block(&k, (&b[0]) as u64, (&c[0]) as u64)
            let counter: u64 = (n * j + t) as u64
            i = 0
            while i < 8 {
                a[i] = c[i]
                i = i + 1
            }
            // The counter is placed on the LOWER octets of A,
            // most significant first; for n <= 8 it only touches the
            // last one. All eight anyway, so that it is also right for large n.
            //
            i = 0
            while i < 8 {
                a[7 - i] = a[7 - i] ^ (((counter >> (i as u64 * 8))
                    & 255) as u8)
                i = i + 1
            }
            i = 0
            while i < 8 {
                r[(t - 1) * 8 + i] = c[8 + i]
                i = i + 1
            }
            t = t + 1
        }
        j = j + 1
    }
    i = 0
    while i < 8 {
        st8(out, i, a[i])
        i = i + 1
    }
    i = 0
    while i < plen {
        st8(out, 8 + i, r[i])
        i = i + 1
    }
    return true
}

fn key_unwrap(kek: u64, keklen: usize, cipher: u64, clen: usize,
    out: u64) -> bool {
    if clen < 24 || clen % 8 != 0 || clen > WRAP_MAX + 8 {
        return false
    }
    var k: Key = key_new()
    if !key_set(&k, kek, keklen) {
        return false
    }
    let n: usize = clen / 8 - 1
    var a: [u8; 8] = [0 as u8; 8]
    var r: [u8; 256] = [0 as u8; 256]
    var i: usize = 0
    while i < 8 {
        a[i] = ld8(cipher, i)
        i = i + 1
    }
    i = 0
    while i < n * 8 {
        r[i] = ld8(cipher, 8 + i)
        i = i + 1
    }
    var b: [u8; 16] = [0 as u8; 16]
    var c: [u8; 16] = [0 as u8; 16]
    var j: usize = 6
    while j > 0 {
        j = j - 1
        var t: usize = n
        while t >= 1 {
            let counter: u64 = (n * j + t) as u64
            i = 0
            while i < 8 {
                b[i] = a[i]
                i = i + 1
            }
            i = 0
            while i < 8 {
                b[7 - i] = b[7 - i] ^ (((counter >> (i as u64 * 8))
                    & 255) as u8)
                i = i + 1
            }
            i = 0
            while i < 8 {
                b[8 + i] = r[(t - 1) * 8 + i]
                i = i + 1
            }
            decrypt_block(&k, (&b[0]) as u64, (&c[0]) as u64)
            i = 0
            while i < 8 {
                a[i] = c[i]
                r[(t - 1) * 8 + i] = c[8 + i]
                i = i + 1
            }
            t = t - 1
        }
    }
    // THE CHECK. Without it unwrapping is worthless.
    var gut: bool = true
    i = 0
    while i < 8 {
        if a[i] != 0xA6 as u8 {
            gut = false
        }
        i = i + 1
    }
    if !gut {
        return false
    }
    i = 0
    while i < n * 8 {
        st8(out, i, r[i])
        i = i + 1
    }
    return true
}

// ------------------------------------------------------ CCM, RFC 3610
//
// CCM is counter mode for encryption plus CBC-MAC for integrity,
// with the SAME key. That is normally a mistake; here it is
// proven safe, because the two computations have strictly separate input spaces
// through the flags in the first block.
//
// THE THREE NUMBERS that determine everything:
//   L   size of the length field, 2..8. Follows from the nonce:
//       L = 15 - nonce length.
//   M   size of the check value, even, 4..16.
//   n   length of the message, must fit into L octets.
//
// CCMP sets L = 2 (13-octet nonce) and M = 8. This function can do
// more, so that it can be measured against the general vectors.

fn ccm_check(nlen: usize, mlen: usize, m: usize) -> bool {
    if nlen < 7 || nlen > 13 {
        return false
    }
    if m < 4 || m > 16 || m % 2 != 0 {
        return false
    }
    let l: usize = 15 - nlen
    // Does the length fit into L octets? Always, for L >= 8.
    if l < 8 {
        var limit: u64 = 1
        var i: usize = 0
        while i < l {
            limit = limit * 256
            i = i + 1
        }
        if (mlen as u64) >= limit {
            return false
        }
    }
    return true
}

// Ein Schritt CBC-MAC: X = E(K, X xor block).
fn cbc_schritt(k: *mut Key, x: *mut [u8; 16], blk: *mut [u8; 16]) {
    var t: [u8; 16] = [0 as u8; 16]
    var i: usize = 0
    while i < 16 {
        t[i] = (*x)[i] ^ (*blk)[i]
        i = i + 1
    }
    encrypt_block(k, (&t[0]) as u64, (&(*x)[0]) as u64)
}

// The check value T over B0, the additional data and the message.
// `msg` is always the PLAINTEXT -- also when decrypting, which is why
// decryption happens first and the computation after it.
fn ccm_mac(k: *mut Key, nonce: u64, nlen: usize, aad: u64, alen: usize,
    msg: u64, mlen: usize, m: usize, t: u64) {
    let l: usize = 15 - nlen
    var x: [u8; 16] = [0 as u8; 16]
    var b: [u8; 16] = [0 as u8; 16]

    // B0: flags, nonce, length.
    var flags: u64 = ((m as u64 - 2) / 2) * 8 + (l as u64 - 1)
    if alen > 0 {
        flags = flags + 64
    }
    b[0] = flags as u8
    var i: usize = 0
    while i < nlen {
        b[1 + i] = ld8(nonce, i)
        i = i + 1
    }
    i = 0
    while i < l {
        b[15 - i] = (((mlen as u64) >> (i as u64 * 8)) & 255) as u8
        i = i + 1
    }
    cbc_schritt(k, &x, &b)

    // The additional data, with the length in front.
    // RFC 3610 lists three cases; only the first one is implemented here
    // (0 < a < 2^16 - 2^8), because 802.11 never has more than a few dozen
    // octets of AAD. Larger input is not computed wrongly,
    // but rejected by `ccm_encrypt`.
    if alen > 0 {
        i = 0
        while i < 16 {
            b[i] = 0 as u8
            i = i + 1
        }
        b[0] = (((alen as u64) >> 8) & 255) as u8
        b[1] = ((alen as u64) & 255) as u8
        var im_block: usize = 2
        var gelesen: usize = 0
        while gelesen < alen {
            b[im_block] = ld8(aad, gelesen)
            im_block = im_block + 1
            gelesen = gelesen + 1
            if im_block == 16 {
                cbc_schritt(k, &x, &b)
                im_block = 0
                i = 0
                while i < 16 {
                    b[i] = 0 as u8
                    i = i + 1
                }
            }
        }
        if im_block > 0 {
            i = im_block
            while i < 16 {
                b[i] = 0 as u8
                i = i + 1
            }
            cbc_schritt(k, &x, &b)
        }
    }

    // The message, padded with zeros.
    if mlen > 0 {
        var im_block: usize = 0
        var gelesen: usize = 0
        i = 0
        while i < 16 {
            b[i] = 0 as u8
            i = i + 1
        }
        while gelesen < mlen {
            b[im_block] = ld8(msg, gelesen)
            im_block = im_block + 1
            gelesen = gelesen + 1
            if im_block == 16 {
                cbc_schritt(k, &x, &b)
                im_block = 0
                i = 0
                while i < 16 {
                    b[i] = 0 as u8
                    i = i + 1
                }
            }
        }
        if im_block > 0 {
            i = im_block
            while i < 16 {
                b[i] = 0 as u8
                i = i + 1
            }
            cbc_schritt(k, &x, &b)
        }
    }
    var i2: usize = 0
    while i2 < m {
        st8(t, i2, x[i2])
        i2 = i2 + 1
    }
}

// The counter block A_i.
fn ccm_a(nonce: u64, nlen: usize, i: u64, a: *mut [u8; 16]) {
    let l: usize = 15 - nlen
    var j: usize = 0
    while j < 16 {
        (*a)[j] = 0 as u8
        j = j + 1
    }
    (*a)[0] = (l as u64 - 1) as u8
    j = 0
    while j < nlen {
        (*a)[1 + j] = ld8(nonce, j)
        j = j + 1
    }
    j = 0
    while j < l {
        (*a)[15 - j] = ((i >> (j as u64 * 8)) & 255) as u8
        j = j + 1
    }
}

// Counter mode over `n` octets from `src` to `dst`, starting at
// block `start`. For S_0 (the veil of the check value) `start`
// is set to 0 and exactly one block is needed.
fn ccm_ctr(k: *mut Key, nonce: u64, nlen: usize, start: u64,
    src: u64, dst: u64, n: usize) {
    var a: [u8; 16] = [0 as u8; 16]
    var s: [u8; 16] = [0 as u8; 16]
    var at: usize = 0
    var blk: u64 = start
    while at < n {
        ccm_a(nonce, nlen, blk, &a)
        encrypt_block(k, (&a[0]) as u64, (&s[0]) as u64)
        var i: usize = 0
        while i < 16 && at + i < n {
            st8(dst, at + i, ld8(src, at + i) ^ s[i])
            i = i + 1
        }
        at = at + 16
        blk = blk + 1
    }
}

const AAD_MAX: usize = 65280

// Output: `mlen` octets of ciphertext, then `m` octets of check value.
fn ccm_encrypt(k: *mut Key, nonce: u64, nlen: usize, aad: u64,
    alen: usize, msg: u64, mlen: usize, m: usize, out: u64) -> bool {
    if !(*k).gesetzt {
        return false
    }
    if !ccm_check(nlen, mlen, m) {
        return false
    }
    if alen > AAD_MAX {
        return false
    }
    var t: [u8; 16] = [0 as u8; 16]
    ccm_mac(k, nonce, nlen, aad, alen, msg, mlen, m, (&t[0]) as u64)
    // The check value is veiled with S_0, the message from S_1 on.
    var s0: [u8; 16] = [0 as u8; 16]
    var null: [u8; 16] = [0 as u8; 16]
    ccm_ctr(k, nonce, nlen, 0, (&null[0]) as u64, (&s0[0]) as u64, 16)
    ccm_ctr(k, nonce, nlen, 1, msg, out, mlen)
    var i: usize = 0
    while i < m {
        st8(out, mlen + i, t[i] ^ s0[i])
        i = i + 1
    }
    return true
}

// `clen` INCLUDES the check value. Output: `clen - m` octets.
// Returning false means: the check value does not match. Then `out`
// already holds decrypted nonsense -- the caller must
// NOT use it, and `ccmp.fi` does not either.
fn ccm_decrypt(k: *mut Key, nonce: u64, nlen: usize, aad: u64,
    alen: usize, ct: u64, clen: usize, m: usize, out: u64) -> bool {
    if !(*k).gesetzt {
        return false
    }
    if clen < m {
        return false
    }
    let mlen: usize = clen - m
    if !ccm_check(nlen, mlen, m) {
        return false
    }
    if alen > AAD_MAX {
        return false
    }
    ccm_ctr(k, nonce, nlen, 1, ct, out, mlen)
    var t: [u8; 16] = [0 as u8; 16]
    ccm_mac(k, nonce, nlen, aad, alen, out, mlen, m, (&t[0]) as u64)
    var s0: [u8; 16] = [0 as u8; 16]
    var null: [u8; 16] = [0 as u8; 16]
    ccm_ctr(k, nonce, nlen, 0, (&null[0]) as u64, (&s0[0]) as u64, 16)
    // Comparison WITHOUT early exit: the run time must not reveal
    // how many octets matched.
    var diff: u64 = 0
    var i: usize = 0
    while i < m {
        diff = diff | ((t[i] ^ s0[i] ^ ld8(ct, mlen + i)) as u64)
        i = i + 1
    }
    return diff == 0
}
