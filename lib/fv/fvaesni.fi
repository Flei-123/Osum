// SPDX-License-Identifier: GPL-2.0-only
// COPY of lib/crypto/aesni.fi under a module name of its own: the leaf names aes/aesni/gcm
// are taken by std.crypto.* as well (pulled in by tls.tls), and a program that links
// both (fv.client) cannot have two modules with the same name. Keep in sync.
// lib/crypto/fvaesni.fi -- AES on the machine's own instructions, round AESNI
// (K-020).
//
// ==================================================================
// WHY THIS FILE EXISTS
// ==================================================================
//
// `lib/crypto/fvaes.fi` computes octet by octet through an S-box.
// That is correct -- measured against FIPS 197, RFC 4493, RFC 3394 and OpenSSL
// -- and entirely sufficient for the purpose it was written for (WLAN,
// one AES per frame). For a DISK it is
// not:
//
//     XTS, one sector (512 octets)       897.87 us      0.544 MiB/s
//     one AES-256 block (16 octets)       25.37 us
//
// One megaoctet therefore costs about two seconds. The cause is
// not in `xts.fi`: of the 898 us of one sector, 32 * 25.37 =
// 812 us are the cipher itself. Measured with `aesbench` in the oracle, not
// estimated.
//
// Since 2010 every x86-64 has the instructions AESENC/AESENCLAST/AESDEC/
// AESDECLAST/AESKEYGENASSIST. One round of AES is thereby ONE instruction
// instead of sixteen S-box lookups, four ShiftRows permutations and
// four MixColumns columns.
//
// ==================================================================
// WHAT THIS FILE DOES NOT DO: IT DOES NOT REPLACE `fvaes.fi`
// ==================================================================
//
// `fvaes.fi` stays exactly as it is, for three reasons:
//
//   1. NOT EVERY MACHINE HAS THE INSTRUCTIONS. A kernel that executes AESENC without
//      checking dies with #UD on older hardware. The
//      fallback path is no concession, it is the normal case on
//      everything before Westmere.
//   2. WLAN AND SSH DEPEND ON THE SAME FILE. `fvaes.fi` carries CCM,
//      CMAC and key wrap; the WLAN acceptance is 171 assertions with a
//      real WPA2 capture in it. This round touches none of it.
//   3. THE TABLE VERSION IS THE COUNTER-PROOF. Two independent paths
//      that must deliver the same octet for octet are worth more
//      than one that has to be believed. `tools/aesni/run.sh` runs
//      exactly that (round trip, all three key lengths).
//
// The choice is therefore NOT made in this file but by the caller:
// `fvaesni.usable()` asks `cpuid`, and whoever does not get it keeps
// computing as before.
//
// ==================================================================
// WHY `asm` AND NO ASSEMBLER FILE, NO HAND ENCODING
// ==================================================================
//
// The task names three ways in this order: Firn directly, else
// a `.s` file modelled on `boot.s`, else the octets by
// hand. It was measured BEFORE building, and the first way holds:
// firnc translates `asm("aesenc xmm0,xmm1")` and `asm("pclmulqdq ...")`
// without further ado, and the results match byte for byte against an
// independent re-implementation (see docs/RUNDE-AESNI.md section 1).
// So there is no reason for the detour -- and the cheapest way
// is the one you do not build.
//
// ==================================================================
// THE RULES FOR `asm` IN THIS LANGUAGE, learned the hard way
// ==================================================================
//
//   * `rbx` IS NOT AVAILABLE. Firn keeps the frame in it. Every
//     `cpuid` saves it itself (`push rbx` / `pop rbx`) -- `rand.has_rdseed` and
//     `fpu.cpuid_*` do the same.
//   * THE LOOP BELONGS INSIDE THE BLOCK. `kernel/fb.fi` measured
//     it: one `asm` per small block, with the loop in Firn
//     around it, gave a factor of 1.9 instead of the expected 4 to 8 -- the
//     frame around the block cost more than the computation inside.
//     That is why `dec rcx / jnz` sits INSIDE the block here.
//   * NO xmm WITHOUT ENABLING IT. In ring 0 the first `movdqu`
//     is a #UD if CR4.OSFXSR is missing. The latch is called
//     `fpu.enabled(state)` and belongs to the caller in the kernel; this
//     file does not know `kstate` (it is meant to run on the host as well).
//
// ==================================================================
// HOW THE KEY SCHEDULE COMES ABOUT
// ==================================================================
//
// AESKEYGENASSIST delivers SubWord(RotWord(x)) xor Rcon in the upper
// 32 bits -- the rest (the three XOR chains) this file computes with
// `pshufd` and `pslldq` on the side. That is the usual method from
// Intel's application note AP-931.
//
// AES-192 IS THE UNPLEASANT CASE: its key is 24 octets, and
// an xmm holds 16. The schedule therefore comes about in words of six over
// two registers, and that is exactly where one miscalculates. THIS FILE DOES NOT
// COMPUTE THE SCHEDULE ITSELF: it takes the schedule that `fvaes.key_set`
// has already built -- the same 240 octets, measured against FIPS 197 --
// and only loads it into the registers. That makes the key schedule
// the same by construction as in the table version, for all three
// lengths, and the round trip can restrict itself to the COMPUTATION.
//
// FOR DECRYPTION an oddity of the instructions applies: AESDEC wants
// the round keys in the form that AESIMC (InvMixColumns) makes of them
// -- all except the first and the last. `dec_prepare`
// builds this second schedule once per key.
//
// ==================================================================
// HONESTLY
// ==================================================================
//
// E1 CONSTANT TIME. Unlike the table version this path is:
//    AESENC is an instruction with a fixed run time, there is no
//    table access whose address depends on the key. That is
//    a side benefit of this round and fixes red item 2 of
//    docs/RUNDE-KRYPTO.md -- but only on the AES-NI path; whoever
//    falls back keeps computing through the table.
// E2 NO CCM, NO CMAC, NO KEY WRAP here. This file can do
//    Bloecke, sonst nichts. Die Betriebsarten bleiben in `fvaes.fi`.
//    They could use these blocks; that is a round of its own
//    and is not claimed here.
// E3 THE 8-BLOCK LOOP IS BUILT FORWARD ONLY (`ctr`-style is not
//    needed). XTS needs the chaining through the tweak, and that depends
//    on the previous block -- so interleaving happens in `xts_enc8`,
//    where the eight tweaks are known BEFOREHAND.

export {
    usable, pclmul_usable,
    Enc, Dec, enc_from, dec_from,
    encrypt_block, decrypt_block,
    xts_sector_encrypt, xts_sector_decrypt,
    RK_BYTES
}

// 15 round keys of 16 octets each, kept aligned by the
// caller (a field in a struct is enough -- `movdqu` demands
// no alignment, and the few percent that `movdqa` would bring
// are not worth the crash on a misaligned address).
const RK_BYTES: usize = 240

struct Enc {
    rk: [u8; 240],
    nr: usize,
    ok: bool,
}

struct Dec {
    rk: [u8; 240],
    nr: usize,
    ok: bool,
}

fn ld8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn st8(p: u64, i: usize, v: u8) {
    *((p + i as u64) as *mut u8) = v
}

// ---------------------------------------------------------- `cpuid`
//
// Leaf 1, ECX: bit 25 is AES-NI, bit 1 is PCLMULQDQ. `rbx` carries
// the frame and is saved -- the same move as in
// `kernel/rand.fi` and `kernel/arch/x86_64/fpu.fi`.

fn cpuid_c(leaf: u64, sub: u64) -> u64 {
    return asm("push rbx\nmov eax, edi\nmov ecx, esi\ncpuid\nmov eax, ecx\npop rbx",
        in("rdi") leaf, in("rsi") sub, out("rax"),
        clobber("rcx"), clobber("rdx"))
}

fn cpuid_max() -> u64 {
    return asm("push rbx\nxor eax, eax\ncpuid\npop rbx",
        out("rax"), clobber("rcx"), clobber("rdx"))
}

// WHETHER THE MACHINE HAS THE INSTRUCTIONS. This is the one question that must be
// answered BEFORE any `aesenc`; an `aesenc` on a machine
// without AES-NI is a #UD, and in ring 0 that is the death of the kernel.
//
// Enabling the vector unit (CR4.OSFXSR) is NOT CHECKED BY THIS --
// it belongs to the kernel and lives in `fpu.enabled`. This
// file cannot see it because it does not know `kstate` (it also runs
// on the host, where CR4 belongs to the operating system). WHOEVER USES IT IN
// THE KERNEL MUST ASK BOTH.
// cpuid is a VM exit under a hypervisor: answer once per question (0 = not asked, 1 = yes, 2 = no).
static mut usable_memo: u64 = 0
static mut pclmul_memo: u64 = 0

fn usable() -> bool {
    if usable_memo != 0 {
        return usable_memo == 1
    }
    var yes: bool = false
    if cpuid_max() >= 1 {
        yes = (cpuid_c(1, 0) & 0x2000000) != 0
    }
    if yes {
        usable_memo = 1
    } else {
        usable_memo = 2
    }
    return yes
}

fn pclmul_usable() -> bool {
    if pclmul_memo != 0 {
        return pclmul_memo == 1
    }
    var yes: bool = false
    if cpuid_max() >= 1 {
        yes = (cpuid_c(1, 0) & 2) != 0
    }
    if yes {
        pclmul_memo = 1
    } else {
        pclmul_memo = 2
    }
    return yes
}

// ------------------------------------------------- the key schedules
//
// `rk` are the 240 octets from `fvaes.key_set`, `nr` the number of rounds
// (10, 12, 14). It is copied so that the caller may throw its key
// away without this structure pointing into the void.

fn enc_from(rk: u64, nr: usize) -> Enc {
    var e: Enc = Enc { rk: [0 as u8; 240], nr: 0, ok: false }
    if nr != 10 && nr != 12 && nr != 14 {
        return e
    }
    var i: usize = 0
    while i < (nr + 1) * 16 {
        e.rk[i] = ld8(rk, i)
        i = i + 1
    }
    e.nr = nr
    e.ok = true
    return e
}

// AESDEC wants the round keys in REVERSED order and --
// except for the first and the last -- passed through AESIMC. Exactly that
// is what this function builds, once per key instead of once per block.
//
// Without the AESIMC, AESDEC computes something that is stable, looks random
// and has nothing to do with AES -- the round trip in
// `tools/aesni/run.sh` catches exactly that.
fn dec_from(rk: u64, nr: usize) -> Dec {
    var d: Dec = Dec { rk: [0 as u8; 240], nr: 0, ok: false }
    if nr != 10 && nr != 12 && nr != 14 {
        return d
    }
    // The last round key becomes the first, unrotated.
    var i: usize = 0
    while i < 16 {
        d.rk[i] = ld8(rk, nr * 16 + i)
        i = i + 1
    }
    // The middle ones, backwards, each through AESIMC.
    var r: usize = 1
    while r < nr {
        let src: u64 = rk + ((nr - r) * 16) as u64
        let dst: u64 = (&d.rk[r * 16]) as u64
        asm("movdqu xmm0,[rdi]\naesimc xmm0,xmm0\nmovdqu [rsi],xmm0",
            in("rdi") src, in("rsi") dst, clobber("memory"))
        r = r + 1
    }
    // The first becomes the last, unrotated.
    i = 0
    while i < 16 {
        d.rk[nr * 16 + i] = ld8(rk, i)
        i = i + 1
    }
    d.nr = nr
    d.ok = true
    return d
}

// ------------------------------------------------------- one block
//
// The number of rounds is fixed as soon as the key is set, so there are
// three blocks instead of a loop with a variable count. One
// `aesenc` more or less is the difference between AES-128 and
// AES-256, and a loop around it would cost a jump per round.

fn enc1_10(rk: u64, inp: u64, out: u64) {
    asm("movdqu xmm0,[rsi]\nmovdqu xmm1,[rdi]\npxor xmm0,xmm1\nmovdqu xmm1,[rdi+16]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+32]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+48]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+64]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+80]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+96]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+112]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+128]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+144]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+160]\naesenclast xmm0,xmm1\nmovdqu [rdx],xmm0",
        in("rdi") rk, in("rsi") inp, in("rdx") out, clobber("memory"))
}

fn enc1_12(rk: u64, inp: u64, out: u64) {
    asm("movdqu xmm0,[rsi]\nmovdqu xmm1,[rdi]\npxor xmm0,xmm1\nmovdqu xmm1,[rdi+16]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+32]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+48]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+64]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+80]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+96]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+112]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+128]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+144]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+160]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+176]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+192]\naesenclast xmm0,xmm1\nmovdqu [rdx],xmm0",
        in("rdi") rk, in("rsi") inp, in("rdx") out, clobber("memory"))
}

fn enc1_14(rk: u64, inp: u64, out: u64) {
    asm("movdqu xmm0,[rsi]\nmovdqu xmm1,[rdi]\npxor xmm0,xmm1\nmovdqu xmm1,[rdi+16]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+32]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+48]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+64]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+80]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+96]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+112]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+128]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+144]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+160]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+176]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+192]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+208]\naesenc xmm0,xmm1\nmovdqu xmm1,[rdi+224]\naesenclast xmm0,xmm1\nmovdqu [rdx],xmm0",
        in("rdi") rk, in("rsi") inp, in("rdx") out, clobber("memory"))
}

fn dec1_10(rk: u64, inp: u64, out: u64) {
    asm("movdqu xmm0,[rsi]\nmovdqu xmm1,[rdi]\npxor xmm0,xmm1\nmovdqu xmm1,[rdi+16]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+32]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+48]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+64]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+80]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+96]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+112]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+128]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+144]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+160]\naesdeclast xmm0,xmm1\nmovdqu [rdx],xmm0",
        in("rdi") rk, in("rsi") inp, in("rdx") out, clobber("memory"))
}

fn dec1_12(rk: u64, inp: u64, out: u64) {
    asm("movdqu xmm0,[rsi]\nmovdqu xmm1,[rdi]\npxor xmm0,xmm1\nmovdqu xmm1,[rdi+16]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+32]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+48]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+64]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+80]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+96]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+112]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+128]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+144]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+160]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+176]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+192]\naesdeclast xmm0,xmm1\nmovdqu [rdx],xmm0",
        in("rdi") rk, in("rsi") inp, in("rdx") out, clobber("memory"))
}

fn dec1_14(rk: u64, inp: u64, out: u64) {
    asm("movdqu xmm0,[rsi]\nmovdqu xmm1,[rdi]\npxor xmm0,xmm1\nmovdqu xmm1,[rdi+16]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+32]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+48]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+64]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+80]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+96]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+112]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+128]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+144]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+160]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+176]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+192]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+208]\naesdec xmm0,xmm1\nmovdqu xmm1,[rdi+224]\naesdeclast xmm0,xmm1\nmovdqu [rdx],xmm0",
        in("rdi") rk, in("rsi") inp, in("rdx") out, clobber("memory"))
}

fn encrypt_block(e: *mut Enc, inp: u64, out: u64) -> bool {
    if !(*e).ok {
        return false
    }
    let rk: u64 = (&(*e).rk[0]) as u64
    if (*e).nr == 10 {
        enc1_10(rk, inp, out)
        return true
    }
    if (*e).nr == 12 {
        enc1_12(rk, inp, out)
        return true
    }
    enc1_14(rk, inp, out)
    return true
}

fn decrypt_block(d: *mut Dec, inp: u64, out: u64) -> bool {
    if !(*d).ok {
        return false
    }
    let rk: u64 = (&(*d).rk[0]) as u64
    if (*d).nr == 10 {
        dec1_10(rk, inp, out)
        return true
    }
    if (*d).nr == 12 {
        dec1_12(rk, inp, out)
        return true
    }
    dec1_14(rk, inp, out)
    return true
}

// =============================================================== XTS
//
// The tweak travels from block to block (T = T * alpha in the field
// GF(2^128), little endian). That is a chain -- block j+1 needs
// the tweak of block j --, and a chain cannot be
// interleaved.
//
// THAT IS WHY THE TWEAKS ARE COMPUTED BEFOREHAND. `xts_sector_encrypt`
// puts eight tweaks into an array, and the asm block then computes EIGHT
// AES blocks SIDE BY SIDE. That is the actual gain: AESENC has
// a latency of four cycles on today's machines, but a
// throughput of one per cycle. Eight independent chains fill the
// execution units; a single one leaves them three quarters idle.
//
// The tweak computation itself stays scalar. PCLMULQDQ could do it too
// -- but the multiplication by x is a shift by ONE bit,
// and that costs so little in scalar code that the measurement (section 4 of the
// report) showed no difference. PCLMULQDQ is therefore CHECKED
// (`pclmul_usable`) and NOT USED; the reason is written here so that
// nobody takes it for an oversight.

// The shift left by one bit across 16 octets, little
// endian, with 0x87 as the reduction -- word for word the same as
// `xts.gf_mul_alpha`, only over two u64 instead of sixteen u8.
fn tweak_next(t: *mut [u8; 16]) {
    var lo: u64 = 0
    var hi: u64 = 0
    var i: usize = 0
    while i < 8 {
        lo = lo | (((*t)[i] as u64) << (i as u64 * 8))
        hi = hi | (((*t)[i + 8] as u64) << (i as u64 * 8))
        i = i + 1
    }
    let carry: u64 = (hi >> 63) & 1
    hi = ((hi << 1) | ((lo >> 63) & 1)) & 0xFFFFFFFFFFFFFFFF
    lo = (lo << 1) & 0xFFFFFFFFFFFFFFFF
    if carry != 0 {
        lo = lo ^ 0x87
    }
    i = 0
    while i < 8 {
        (*t)[i] = ((lo >> (i as u64 * 8)) & 255) as u8
        (*t)[i + 8] = ((hi >> (i as u64 * 8)) & 255) as u8
        i = i + 1
    }
}

fn sector_tweak(sector: u64, t: *mut [u8; 16]) {
    var i: usize = 0
    while i < 8 {
        (*t)[i] = ((sector >> (i as u64 * 8)) & 255) as u8
        i = i + 1
    }
    while i < 16 {
        (*t)[i] = 0
        i = i + 1
    }
}

// EIGHT BLOCKS SIDE BY SIDE, encrypted.
//
// rdi = round keys, rsi = plaintext (128 octets), rdx = destination,
// rcx = eight tweaks (128 octets), r8 = number of aesenc rounds.
//
// xmm8..xmm15 carry the eight tweaks, xmm0..xmm7 the eight blocks.
// The sequence is the same as for one block, only eightfold: P xor T,
// then the rounds, then xor T.
fn xts_enc8(rk: u64, inp: u64, out: u64, tw: u64, nr: usize) {
    asm("movdqu xmm8,[rcx]\nmovdqu xmm9,[rcx+16]\nmovdqu xmm10,[rcx+32]\nmovdqu xmm11,[rcx+48]\nmovdqu xmm12,[rcx+64]\nmovdqu xmm13,[rcx+80]\nmovdqu xmm14,[rcx+96]\nmovdqu xmm15,[rcx+112]\nmovdqu xmm0,[rsi]\nmovdqu xmm1,[rsi+16]\nmovdqu xmm2,[rsi+32]\nmovdqu xmm3,[rsi+48]\nmovdqu xmm4,[rsi+64]\nmovdqu xmm5,[rsi+80]\nmovdqu xmm6,[rsi+96]\nmovdqu xmm7,[rsi+112]\npxor xmm0,xmm8\npxor xmm1,xmm9\npxor xmm2,xmm10\npxor xmm3,xmm11\npxor xmm4,xmm12\npxor xmm5,xmm13\npxor xmm6,xmm14\npxor xmm7,xmm15\nmovdqu xmm8,[rdi]\npxor xmm0,xmm8\npxor xmm1,xmm8\npxor xmm2,xmm8\npxor xmm3,xmm8\npxor xmm4,xmm8\npxor xmm5,xmm8\npxor xmm6,xmm8\npxor xmm7,xmm8\nmov rax,rdi\nadd rax,16\n1:\nmovdqu xmm8,[rax]\naesenc xmm0,xmm8\naesenc xmm1,xmm8\naesenc xmm2,xmm8\naesenc xmm3,xmm8\naesenc xmm4,xmm8\naesenc xmm5,xmm8\naesenc xmm6,xmm8\naesenc xmm7,xmm8\nadd rax,16\ndec r8\njnz 1b\nmovdqu xmm8,[rax]\naesenclast xmm0,xmm8\naesenclast xmm1,xmm8\naesenclast xmm2,xmm8\naesenclast xmm3,xmm8\naesenclast xmm4,xmm8\naesenclast xmm5,xmm8\naesenclast xmm6,xmm8\naesenclast xmm7,xmm8\nmovdqu xmm8,[rcx]\npxor xmm0,xmm8\nmovdqu xmm8,[rcx+16]\npxor xmm1,xmm8\nmovdqu xmm8,[rcx+32]\npxor xmm2,xmm8\nmovdqu xmm8,[rcx+48]\npxor xmm3,xmm8\nmovdqu xmm8,[rcx+64]\npxor xmm4,xmm8\nmovdqu xmm8,[rcx+80]\npxor xmm5,xmm8\nmovdqu xmm8,[rcx+96]\npxor xmm6,xmm8\nmovdqu xmm8,[rcx+112]\npxor xmm7,xmm8\nmovdqu [rdx],xmm0\nmovdqu [rdx+16],xmm1\nmovdqu [rdx+32],xmm2\nmovdqu [rdx+48],xmm3\nmovdqu [rdx+64],xmm4\nmovdqu [rdx+80],xmm5\nmovdqu [rdx+96],xmm6\nmovdqu [rdx+112],xmm7",
        in("rdi") rk, in("rsi") inp, in("rdx") out, in("rcx") tw,
        in("r8") (nr - 1) as u64,
        clobber("rax"), clobber("r8"), clobber("memory"))
}

// The same backwards. `rk` here is the schedule from `dec_from`.
fn xts_dec8(rk: u64, inp: u64, out: u64, tw: u64, nr: usize) {
    asm("movdqu xmm8,[rcx]\nmovdqu xmm9,[rcx+16]\nmovdqu xmm10,[rcx+32]\nmovdqu xmm11,[rcx+48]\nmovdqu xmm12,[rcx+64]\nmovdqu xmm13,[rcx+80]\nmovdqu xmm14,[rcx+96]\nmovdqu xmm15,[rcx+112]\nmovdqu xmm0,[rsi]\nmovdqu xmm1,[rsi+16]\nmovdqu xmm2,[rsi+32]\nmovdqu xmm3,[rsi+48]\nmovdqu xmm4,[rsi+64]\nmovdqu xmm5,[rsi+80]\nmovdqu xmm6,[rsi+96]\nmovdqu xmm7,[rsi+112]\npxor xmm0,xmm8\npxor xmm1,xmm9\npxor xmm2,xmm10\npxor xmm3,xmm11\npxor xmm4,xmm12\npxor xmm5,xmm13\npxor xmm6,xmm14\npxor xmm7,xmm15\nmovdqu xmm8,[rdi]\npxor xmm0,xmm8\npxor xmm1,xmm8\npxor xmm2,xmm8\npxor xmm3,xmm8\npxor xmm4,xmm8\npxor xmm5,xmm8\npxor xmm6,xmm8\npxor xmm7,xmm8\nmov rax,rdi\nadd rax,16\n1:\nmovdqu xmm8,[rax]\naesdec xmm0,xmm8\naesdec xmm1,xmm8\naesdec xmm2,xmm8\naesdec xmm3,xmm8\naesdec xmm4,xmm8\naesdec xmm5,xmm8\naesdec xmm6,xmm8\naesdec xmm7,xmm8\nadd rax,16\ndec r8\njnz 1b\nmovdqu xmm8,[rax]\naesdeclast xmm0,xmm8\naesdeclast xmm1,xmm8\naesdeclast xmm2,xmm8\naesdeclast xmm3,xmm8\naesdeclast xmm4,xmm8\naesdeclast xmm5,xmm8\naesdeclast xmm6,xmm8\naesdeclast xmm7,xmm8\nmovdqu xmm8,[rcx]\npxor xmm0,xmm8\nmovdqu xmm8,[rcx+16]\npxor xmm1,xmm8\nmovdqu xmm8,[rcx+32]\npxor xmm2,xmm8\nmovdqu xmm8,[rcx+48]\npxor xmm3,xmm8\nmovdqu xmm8,[rcx+64]\npxor xmm4,xmm8\nmovdqu xmm8,[rcx+80]\npxor xmm5,xmm8\nmovdqu xmm8,[rcx+96]\npxor xmm6,xmm8\nmovdqu xmm8,[rcx+112]\npxor xmm7,xmm8\nmovdqu [rdx],xmm0\nmovdqu [rdx+16],xmm1\nmovdqu [rdx+32],xmm2\nmovdqu [rdx+48],xmm3\nmovdqu [rdx+64],xmm4\nmovdqu [rdx+80],xmm5\nmovdqu [rdx+96],xmm6\nmovdqu [rdx+112],xmm7",
        in("rdi") rk, in("rsi") inp, in("rdx") out, in("rcx") tw,
        in("r8") (nr - 1) as u64,
        clobber("rax"), clobber("r8"), clobber("memory"))
}

// ONE SECTOR, encrypted.
//
// `e` is the schedule for the data (k1), `t0` the already finished tweak
// (T = AES-k2(sector number), computed by the caller -- this file
// does not know how the caller gets to k2).
//
// `n` MUST be a multiple of 16. There is NO ciphertext stealing
// here: a sector is always a multiple of 16, and the
// odd case stays in `xts.fi` with the table version. Whoever comes with
// an odd length gets `false` and not silently
// something wrong.
fn xts_run(rk: u64, nr: usize, t0: *mut [u8; 16], inp: u64, out: u64,
    n: usize, enc: bool) -> bool {
    if n < 16 || n % 16 != 0 {
        return false
    }
    var tw: [u8; 128] = [0 as u8; 128]
    var t: [u8; 16] = [0 as u8; 16]
    var i: usize = 0
    while i < 16 {
        t[i] = (*t0)[i]
        i = i + 1
    }
    let bloecke: usize = n / 16
    var j: usize = 0
    // Eight at a time, as long as eight are left.
    while j + 8 <= bloecke {
        var b: usize = 0
        while b < 8 {
            i = 0
            while i < 16 {
                tw[b * 16 + i] = t[i]
                i = i + 1
            }
            tweak_next(&t)
            b = b + 1
        }
        if enc {
            xts_enc8(rk, inp + (j * 16) as u64, out + (j * 16) as u64,
                (&tw[0]) as u64, nr)
        } else {
            xts_dec8(rk, inp + (j * 16) as u64, out + (j * 16) as u64,
                (&tw[0]) as u64, nr)
        }
        j = j + 8
    }
    // The rest one by one. A sector of 512 octets has 32 blocks and
    // divides evenly; so does 4096. This loop carries the lengths that
    // do not.
    while j < bloecke {
        var x: [u8; 16] = [0 as u8; 16]
        var y: [u8; 16] = [0 as u8; 16]
        i = 0
        while i < 16 {
            x[i] = ld8(inp + (j * 16) as u64, i) ^ t[i]
            i = i + 1
        }
        if enc {
            var e1: Enc = Enc { rk: [0 as u8; 240], nr: nr, ok: true }
            i = 0
            while i < (nr + 1) * 16 {
                e1.rk[i] = ld8(rk, i)
                i = i + 1
            }
            encrypt_block(&e1, (&x[0]) as u64, (&y[0]) as u64)
        } else {
            var d1: Dec = Dec { rk: [0 as u8; 240], nr: nr, ok: true }
            i = 0
            while i < (nr + 1) * 16 {
                d1.rk[i] = ld8(rk, i)
                i = i + 1
            }
            decrypt_block(&d1, (&x[0]) as u64, (&y[0]) as u64)
        }
        i = 0
        while i < 16 {
            st8(out + (j * 16) as u64, i, y[i] ^ t[i])
            i = i + 1
        }
        tweak_next(&t)
        j = j + 1
    }
    return true
}

fn xts_sector_encrypt(e: *mut Enc, t0: *mut [u8; 16], inp: u64,
    out: u64, n: usize) -> bool {
    if !(*e).ok {
        return false
    }
    return xts_run((&(*e).rk[0]) as u64, (*e).nr, t0, inp, out, n, true)
}

fn xts_sector_decrypt(d: *mut Dec, t0: *mut [u8; 16], inp: u64,
    out: u64, n: usize) -> bool {
    if !(*d).ok {
        return false
    }
    return xts_run((&(*d).rk[0]) as u64, (*d).nr, t0, inp, out, n, false)
}
