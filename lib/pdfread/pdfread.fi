// SPDX-License-Identifier: GPL-2.0-only
// lib/pdfread/pdfread.fi -- a PDF READER for OrientOS (DAILY-DRIVER r55).
//
// The file in, one page out as SVG text -- the picture itself is made by
// lib/svg (svg.svgimage), the same renderer the system icons use.
//
//     var d: pdfread.Doc = pdfread.doc_new()
//     if pdfread.doc_open(&d, ptr, len) { ... pdfread.doc_pages(&d) ... }
//     var svg: rt.Buf = rt.buf_new()
//     pdfread.doc_page_svg(&d, page, 1.0, &svg)
//
// WHAT IT UNDERSTANDS (docs/PDFVIEW.md has the list with its limits):
//   file structure   classic xref tables, xref streams, object streams,
//                    hybrid files, incremental updates (/Prev); a damaged
//                    file is rebuilt by scanning for "N G obj"
//   filters          Flate (with PNG predictors), ASCIIHex, ASCII85,
//                    RunLength, LZW
//   pages            the page tree with inherited MediaBox/CropBox/Resources/
//                    Rotate, content streams in an array, form XObjects
//   graphics         paths (fill, stroke, even-odd, clip), colours (Gray, RGB,
//                    CMYK, ICCBased by component count, Separation as tint),
//                    line width/cap/join/dash, opacity (ExtGState ca/CA),
//                    transformation matrices
//   text             simple and Type0 (Identity) fonts, widths from /Widths,
//                    /W and the 14 standard fonts, Unicode from ToUnicode,
//                    /Encoding (WinAnsi, MacRoman, Standard, Differences);
//                    drawn with the system face -- the glyph SHAPES are the
//                    system's, the POSITIONS are the file's
//   images           their places are listed (`doc_img_*`), the viewer draws
//                    them; shadings and patterns are NOT drawn
//   encryption       reported, not decoded
//
// Memory: heap_alloc/heap_free from std.rt, nothing else. No recursion deeper
// than 32 on the file's own structure (page tree, objects, forms).

import std.rt
import pdfread.pdfread.prbase
import pdfread.pdfread.prfont
import pdfread.pdfread.prpage
import pdfread.pdfread.prparse

export {
    doc_new, doc_open, doc_free, doc_pages, doc_page_size, doc_page_svg,
    doc_tcap_count, doc_tcap_word, doc_tcap_clear, WHICH_TEXT,
    doc_error, doc_img_count, doc_img_obj, doc_img_m,
    ERR_NONE, ERR_FORMAT, ERR_ENCRYPTED, ERR_NOPAGES, ERR_MEMORY,
    parse_val, skip_ws, K_NONE, K_BOOL, K_INT, K_REAL, K_STR, K_NAME,
    K_ARR, K_DICT, K_REF, K_STREAM,
    doc_object, doc_dict_get, doc_stream, doc_img_info, doc_obj_of,
    doc_img_rgba, doc_img_blit, doc_img_color, doc_styles,
}

fn doc_new() -> prbase.Doc {
    return prparse.doc_new()
}

fn doc_open(d: *mut prbase.Doc, data: u64, len: u64) -> bool {
    return prfont.doc_open(d, data, len)
}

fn doc_free(d: *mut prbase.Doc) {
    prfont.doc_free(d)
}

fn doc_pages(d: *mut prbase.Doc) -> u64 {
    return prparse.doc_pages(d)
}

fn doc_page_size(d: *mut prbase.Doc, page: u64, w: *mut f64, h: *mut f64) -> bool {
    return prpage.doc_page_size(d, page, w, h)
}

fn doc_page_svg(d: *mut prbase.Doc, page: u64, scale: f64, which: u32, out: *mut rt.Buf, wo: *mut u64, ho: *mut u64) -> bool {
    return prpage.doc_page_svg(d, page, scale, which, out, wo, ho)
}

fn doc_tcap_count(d: *mut prbase.Doc) -> u64 {
    return prparse.doc_tcap_count(d)
}

fn doc_tcap_word(d: *mut prbase.Doc, i: u64, k: u64) -> u32 {
    return prparse.doc_tcap_word(d, i, k)
}

fn doc_tcap_clear(d: *mut prbase.Doc) {
    prparse.doc_tcap_clear(d)
}

const WHICH_TEXT: u32 = prbase.WHICH_TEXT

fn doc_error(d: *mut prbase.Doc) -> u32 {
    return prparse.doc_error(d)
}

fn doc_img_count(d: *mut prbase.Doc) -> u64 {
    return prpage.doc_img_count(d)
}

fn doc_img_obj(d: *mut prbase.Doc, i: u64) -> u64 {
    return prpage.doc_img_obj(d, i)
}

fn doc_img_m(d: *mut prbase.Doc, i: u64, k: u64) -> f64 {
    return prpage.doc_img_m(d, i, k)
}

const ERR_NONE: u32 = prfont.ERR_NONE

const ERR_FORMAT: u32 = prfont.ERR_FORMAT

const ERR_ENCRYPTED: u32 = prfont.ERR_ENCRYPTED

const ERR_NOPAGES: u32 = prfont.ERR_NOPAGES

const ERR_MEMORY: u32 = prbase.ERR_MEMORY

fn parse_val(p0: u64, end: u64, v: *mut prbase.Val) -> u64 {
    return prparse.parse_val(p0, end, v)
}

fn skip_ws(p0: u64, end: u64) -> u64 {
    return prparse.skip_ws(p0, end)
}

const K_NONE: u32 = prbase.K_NONE

const K_BOOL: u32 = prbase.K_BOOL

const K_INT: u32 = prbase.K_INT

const K_REAL: u32 = prbase.K_REAL

const K_STR: u32 = prbase.K_STR

const K_NAME: u32 = prbase.K_NAME

const K_ARR: u32 = prbase.K_ARR

const K_DICT: u32 = prbase.K_DICT

const K_REF: u32 = prbase.K_REF

const K_STREAM: u32 = prbase.K_STREAM

fn doc_object(d: *mut prbase.Doc, num: u64, out: *mut prbase.Val) -> bool {
    return prparse.doc_object(d, num, out)
}

fn doc_dict_get(d: *mut prbase.Doc, dv: *mut prbase.Val, key: str, out: *mut prbase.Val) -> bool {
    return prparse.doc_dict_get(d, dv, key, out)
}

fn doc_stream(d: *mut prbase.Doc, v: *mut prbase.Val, out: *mut rt.Buf, imgf: *mut u32) -> bool {
    return prparse.doc_stream(d, v, out, imgf)
}

fn doc_img_info(d: *mut prbase.Doc, obj: u64, w: *mut u64, h: *mut u64, bpc: *mut u64, comps: *mut u64, smask: *mut u64, imagemask: *mut bool) -> bool {
    return prpage.doc_img_info(d, obj, w, h, bpc, comps, smask, imagemask)
}

fn doc_obj_of(d: *mut prbase.Doc, dv: *mut prbase.Val, key: str) -> u64 {
    return prparse.doc_obj_of(d, dv, key)
}

fn doc_img_rgba(d: *mut prbase.Doc, obj: u64, fillrgb: u32, out: *mut rt.Buf, wo: *mut u64, ho: *mut u64) -> bool {
    return prpage.doc_img_rgba(d, obj, fillrgb, out, wo, ho)
}

fn doc_img_blit(d: *mut prbase.Doc, i: u64, dst: u64, w: u64, h: u64) -> bool {
    return prpage.doc_img_blit(d, i, dst, w, h)
}

fn doc_img_color(d: *mut prbase.Doc, i: u64) -> u32 {
    return prpage.doc_img_color(d, i)
}

fn doc_styles(d: *mut prbase.Doc) -> u32 {
    return prparse.doc_styles(d)
}
