import gpu.intel.regs
import gpu.intel.bits
import gpu.intel.mode
import gpu.intel.timing

export { State, state_new, snapshot, bpc_of, cdclk_khz_of, cdclk_limit_khz_of, lanes_of }

const PLL0: u64 = 0

struct State {
    pipesrc_w: u64,
    pipesrc_h: u64,
    mode: mode.Mode,
    symbol_khz: u64,
    data_tu: u64,
    data_ppm: u64,
    transconf_edp: u64,
    pipeconf_a: u64,
    pipeconf_b: u64,
    ddi_func: u64,
    ddi_func_a: u64,
    ddi_buf: u64,
    tp_ctl: u64,
    tp_status: u64,
    aux_ctl: u64,
    dpll_ctrl1: u64,
    dpll_ctrl2: u64,
    dpll_status: u64,
    lcpll1: u64,
    cdclk_ctl: u64,
    dssm: u64,
    dfsm: u64,
    fuse_status: u64,
    plane_ctl: u64,
    plane_stride: u64,
    plane_size: u64,
    plane_surf: u64,
    pp_status: u64,
    pp_control: u64,
    pp_on_delays: u64,
    pp_off_delays: u64,
    pp_divisor: u64,
    blc_pch_ctl1: u64,
    blc_pch_ctl2: u64,
    blc_cpu_ctl2: u64,
    blc_cpu_ctl: u64,
    pw0: u64,
    pw1: u64,
    pw2: u64,
    pw3: u64,
    dc_state: u64,
    gmbus2: u64
}

fn state_new() -> State {
    var s: State = State { pipesrc_w: 0, pipesrc_h: 0, mode: mode.mode_new(), symbol_khz: 0, data_tu: 0, data_ppm: 0,
        transconf_edp: 0, pipeconf_a: 0, pipeconf_b: 0, ddi_func: 0, ddi_func_a: 0, ddi_buf: 0, tp_ctl: 0,
        tp_status: 0, aux_ctl: 0, dpll_ctrl1: 0, dpll_ctrl2: 0, dpll_status: 0, lcpll1: 0, cdclk_ctl: 0, dssm: 0,
        dfsm: 0, fuse_status: 0, plane_ctl: 0, plane_stride: 0, plane_size: 0, plane_surf: 0, pp_status: 0,
        pp_control: 0, pp_on_delays: 0, pp_off_delays: 0, pp_divisor: 0, blc_pch_ctl1: 0, blc_pch_ctl2: 0,
        blc_cpu_ctl2: 0, blc_cpu_ctl: 0, pw0: 0, pw1: 0, pw2: 0, pw3: 0, dc_state: 0, gmbus2: 0 }
    return s
}

fn bpc_of(func: u64) -> u64 {
    let f: u64 = (func >> bits.DDI_BPC_SHIFT) & bits.DDI_BPC_MASK
    if f == 0 {
        return 8
    }
    if f == 1 {
        return 10
    }
    if f == 2 {
        return 6
    }
    if f == 3 {
        return 12
    }
    return 0
}

fn lanes_of(func: u64) -> u64 {
    return ((func >> bits.DDI_LANES_SHIFT) & bits.DDI_LANES_MASK) + 1
}

fn cdclk_khz_of(ctl: u64) -> u64 {
    let sel: u64 = (ctl >> bits.CDCLK_SEL_SHIFT) & bits.CDCLK_SEL_MASK
    if sel == 0 {
        return 540000
    }
    if sel == 1 {
        return 450000
    }
    if sel == 2 {
        return 337500
    }
    return 675000
}

fn cdclk_limit_khz_of(dfsm: u64) -> u64 {
    let f: u64 = (dfsm >> bits.DFSM_CDLIMIT_SHIFT) & bits.DFSM_CDLIMIT_MASK
    if f == 0 {
        return 675000
    }
    if f == 1 {
        return 540000
    }
    if f == 2 {
        return 450000
    }
    return 337500
}

fn snapshot_display(rd: fn(u64) -> u64, s: *mut State) {
    let src: u64 = rd(regs.PIPESRC_A)
    (*s).pipesrc_w = ((src >> 16) & 0xffff) + 1
    (*s).pipesrc_h = (src & 0xffff) + 1
    (*s).transconf_edp = rd(regs.TRANSCONF_EDP)
    (*s).pipeconf_a = rd(regs.PIPECONF_A)
    (*s).pipeconf_b = rd(regs.PIPECONF_B)
    (*s).ddi_func = rd(regs.DDI_FUNC_CTL_EDP)
    (*s).ddi_func_a = rd(regs.DDI_FUNC_CTL_A)
    (*s).ddi_buf = rd(regs.DDI_BUF_CTL_A)
    (*s).tp_ctl = rd(regs.DP_TP_CTL_A)
    (*s).tp_status = rd(regs.DP_TP_STATUS_A)
    (*s).aux_ctl = rd(regs.AUX_CTL_A)
}

fn snapshot_clocks(rd: fn(u64) -> u64, s: *mut State) {
    (*s).dpll_ctrl1 = rd(regs.DPLL_CTRL1)
    (*s).dpll_ctrl2 = rd(regs.DPLL_CTRL2)
    (*s).dpll_status = rd(regs.DPLL_STATUS)
    (*s).lcpll1 = rd(regs.LCPLL1_CTL)
    (*s).cdclk_ctl = rd(regs.CDCLK_CTL)
    (*s).dssm = rd(regs.DSSM)
    (*s).dfsm = rd(regs.DFSM)
    (*s).fuse_status = rd(regs.FUSE_STATUS)
    (*s).pw0 = rd(regs.PWR_WELL_CTL1)
    (*s).pw1 = rd(regs.PWR_WELL_CTL2)
    (*s).pw2 = rd(regs.PWR_WELL_CTL3)
    (*s).pw3 = rd(regs.PWR_WELL_CTL4)
    (*s).dc_state = rd(regs.DC_STATE_EN)
}

fn snapshot_plane_panel(rd: fn(u64) -> u64, s: *mut State) {
    (*s).plane_ctl = rd(regs.PLANE_CTL_1_A)
    (*s).plane_stride = rd(regs.PLANE_STRIDE_1_A)
    (*s).plane_size = rd(regs.PLANE_SIZE_1_A)
    (*s).plane_surf = rd(regs.PLANE_SURF_1_A)
    (*s).pp_status = rd(regs.PP_STATUS)
    (*s).pp_control = rd(regs.PP_CONTROL)
    (*s).pp_on_delays = rd(regs.PP_ON_DELAYS)
    (*s).pp_off_delays = rd(regs.PP_OFF_DELAYS)
    (*s).pp_divisor = rd(regs.PP_DIVISOR)
    (*s).blc_pch_ctl1 = rd(regs.BLC_PCH_CTL1)
    (*s).blc_pch_ctl2 = rd(regs.BLC_PCH_CTL2)
    (*s).blc_cpu_ctl2 = rd(regs.BLC_CPU_CTL2)
    (*s).blc_cpu_ctl = rd(regs.BLC_CPU_CTL)
    (*s).gmbus2 = rd(regs.GMBUS2)
}

fn snapshot(rd: fn(u64) -> u64, s: *mut State) {
    snapshot_display(rd, s)
    snapshot_clocks(rd, s)
    snapshot_plane_panel(rd, s)
    (*s).symbol_khz = timing.link_symbol_khz((*s).dpll_ctrl1, PLL0)
    timing.read_mode(rd, regs.TRANS_EDP, (*s).symbol_khz, &(*s).mode)
    (*s).data_tu = timing.data_tu(rd(regs.TRANS_EDP + regs.T_DATA_M1))
    (*s).data_ppm = timing.data_ratio_ppm(rd(regs.TRANS_EDP + regs.T_DATA_M1), rd(regs.TRANS_EDP + regs.T_DATA_N1))
}
