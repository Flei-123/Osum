// SPDX-License-Identifier: GPL-2.0-only
import gpu.intel.regs
import gpu.intel.bits
import gpu.intel.mode

export { read_mode, link_symbol_khz, pixel_clock_khz, data_tu, data_ratio_ppm, RATE_UNKNOWN }

const LOW16: u64 = 0xffff
const M_MASK: u64 = 0xffffff
const TU_SHIFT: u64 = 25
const TU_MASK: u64 = 0x3f
const DPLL_FIELD_BITS: u64 = 6
const RATE_UNKNOWN: u64 = 0
const PPM: u64 = 1000000

fn lo(v: u64) -> u64 {
    return (v & LOW16) + 1
}

fn hi(v: u64) -> u64 {
    return ((v >> 16) & LOW16) + 1
}

fn link_symbol_khz(ctrl1: u64, pll: u64) -> u64 {
    let field: u64 = (ctrl1 >> (pll * DPLL_FIELD_BITS + bits.DPLL_RATE_SHIFT)) & bits.DPLL_RATE_MASK
    if field == 0 {
        return 540000
    }
    if field == 1 {
        return 270000
    }
    if field == 2 {
        return 162000
    }
    if field == 3 {
        return 324000
    }
    if field == 4 {
        return 216000
    }
    if field == 5 {
        return 432000
    }
    return RATE_UNKNOWN
}

fn pixel_clock_khz(link_m: u64, link_n: u64, symbol_khz: u64) -> u64 {
    if link_n == 0 || symbol_khz == 0 {
        return 0
    }
    return (link_m * symbol_khz + link_n / 2) / link_n
}

fn data_tu(data_m: u64) -> u64 {
    return ((data_m >> TU_SHIFT) & TU_MASK) + 1
}

fn data_ratio_ppm(data_m: u64, data_n: u64) -> u64 {
    let n: u64 = data_n & M_MASK
    if n == 0 {
        return 0
    }
    return ((data_m & M_MASK) * PPM + n / 2) / n
}

fn read_mode(rd: fn(u64) -> u64, base: u64, symbol_khz: u64, out: *mut mode.Mode) {
    let ht: u64 = rd(base + regs.T_HTOTAL)
    let hs: u64 = rd(base + regs.T_HSYNC)
    let vt: u64 = rd(base + regs.T_VTOTAL)
    let vs: u64 = rd(base + regs.T_VSYNC)
    (*out).hactive = lo(ht)
    (*out).htotal = hi(ht)
    (*out).hsync_start = lo(hs)
    (*out).hsync_end = hi(hs)
    (*out).vactive = lo(vt)
    (*out).vtotal = hi(vt)
    (*out).vsync_start = lo(vs)
    (*out).vsync_end = hi(vs)
    (*out).pclk_khz = pixel_clock_khz(rd(base + regs.T_LINK_M1) & M_MASK, rd(base + regs.T_LINK_N1) & M_MASK, symbol_khz)
}
