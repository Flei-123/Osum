export { Mode, mode_new, refresh_mhz, same_timing }

const KHZ_TO_MHZ_REFRESH: u64 = 1000000

struct Mode {
    hactive: u64,
    hsync_start: u64,
    hsync_end: u64,
    htotal: u64,
    vactive: u64,
    vsync_start: u64,
    vsync_end: u64,
    vtotal: u64,
    pclk_khz: u64
}

fn mode_new() -> Mode {
    var m: Mode = Mode { hactive: 0, hsync_start: 0, hsync_end: 0, htotal: 0, vactive: 0, vsync_start: 0,
        vsync_end: 0, vtotal: 0, pclk_khz: 0 }
    return m
}

fn refresh_mhz(m: *mut Mode) -> u64 {
    let total: u64 = (*m).htotal * (*m).vtotal
    if total == 0 {
        return 0
    }
    return ((*m).pclk_khz * KHZ_TO_MHZ_REFRESH + total / 2) / total
}

fn same_timing(a: *mut Mode, b: *mut Mode) -> bool {
    return (*a).hactive == (*b).hactive && (*a).hsync_start == (*b).hsync_start
        && (*a).hsync_end == (*b).hsync_end && (*a).htotal == (*b).htotal
        && (*a).vactive == (*b).vactive && (*a).vsync_start == (*b).vsync_start
        && (*a).vsync_end == (*b).vsync_end && (*a).vtotal == (*b).vtotal
}
