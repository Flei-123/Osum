// SPDX-License-Identifier: GPL-2.0-only
export { gen_x10, is_gen9, VENDOR_INTEL, GEN_NONE, GEN_SKL, GEN_KBL }

const VENDOR_INTEL: u64 = 0x8086
const GEN_NONE: u64 = 0
const GEN_SKL: u64 = 90
const GEN_KBL: u64 = 95
const SKL_HIGH: u64 = 0x19
const KBL_HIGH: u64 = 0x59
const KBL_EXTRA: u64 = 0x87c0
const MAX_LOW_BIT: u64 = 63
const SKL_MASK: u64 = 0x2c042cca6cec4c44
const KBL_MASK: u64 = 0x080000ca7cec4d44

fn in_mask(mask: u64, low: u64) -> bool {
    if low > MAX_LOW_BIT {
        return false
    }
    return ((mask >> low) & 1) == 1
}

fn gen_x10(vendor: u64, device: u64) -> u64 {
    if vendor != VENDOR_INTEL {
        return GEN_NONE
    }
    if device == KBL_EXTRA {
        return GEN_KBL
    }
    let high: u64 = (device >> 8) & 0xff
    let low: u64 = device & 0xff
    if high == SKL_HIGH && in_mask(SKL_MASK, low) {
        return GEN_SKL
    }
    if high == KBL_HIGH && in_mask(KBL_MASK, low) {
        return GEN_KBL
    }
    return GEN_NONE
}

fn is_gen9(vendor: u64, device: u64) -> bool {
    return gen_x10(vendor, device) != GEN_NONE
}
