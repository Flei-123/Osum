import gpu.intel.engregs

export { get, put, W_OK, W_NO_ACK, W_STUCK, ACK_POLLS, ACK_POLL_US }

const W_OK: u64 = 0
const W_NO_ACK: u64 = 1
const W_STUCK: u64 = 2
const ACK_POLLS: u64 = 50
const ACK_POLL_US: u64 = 20

fn ack_is(rd: fn(u64) -> u64, us: fn(u64) -> u64, ack: u64, want: u64) -> bool {
    var n: u64 = 0
    while n < ACK_POLLS {
        if (rd(ack) & engregs.FORCEWAKE_KERNEL) == want {
            return true
        }
        us(ACK_POLL_US)
        n = n + 1
    }
    return false
}

fn get(rd: fn(u64) -> u64, wr: fn(u64, u64) -> u64, us: fn(u64) -> u64, req: u64, ack: u64) -> u64 {
    wr(req, engregs.masked_on(engregs.FORCEWAKE_KERNEL))
    if ack_is(rd, us, ack, engregs.FORCEWAKE_KERNEL) {
        return W_OK
    }
    wr(req, engregs.masked_off(engregs.FORCEWAKE_KERNEL))
    return W_NO_ACK
}

fn put(rd: fn(u64) -> u64, wr: fn(u64, u64) -> u64, us: fn(u64) -> u64, req: u64, ack: u64) -> u64 {
    wr(req, engregs.masked_off(engregs.FORCEWAKE_KERNEL))
    if ack_is(rd, us, ack, 0) {
        return W_OK
    }
    return W_STUCK
}
