export {
    BCS_BASE, RING_TAIL, RING_HEAD, RING_START, RING_CTL, RING_ACTHD, RING_HWS_PGA, RING_MI_MODE,
    RING_RESET_CTL, RING_ELSP, RING_MODE, RING_CSB_BUF, RING_CSB_PTR, CSB_ENTRIES, CSB_ENTRY_BYTES,
    GDRST, GRDOM_FULL, GRDOM_RENDER, GRDOM_BLT,
    FORCEWAKE_GT, FORCEWAKE_ACK_GT, FORCEWAKE_RENDER, FORCEWAKE_ACK_RENDER, FORCEWAKE_KERNEL,
    STOP_RING, MODE_IDLE, RUN_LIST_ENABLE, RESET_REQUEST, RESET_READY, RESET_CAT_ERROR,
    masked_on, masked_off, eng
}

const BCS_BASE: u64 = 0x22000
const RING_TAIL: u64 = 0x30
const RING_HEAD: u64 = 0x34
const RING_START: u64 = 0x38
const RING_CTL: u64 = 0x3c
const RING_ACTHD: u64 = 0x74
const RING_HWS_PGA: u64 = 0x80
const RING_MI_MODE: u64 = 0x9c
const RING_RESET_CTL: u64 = 0xd0
const RING_ELSP: u64 = 0x230
const RING_MODE: u64 = 0x29c
const RING_CSB_BUF: u64 = 0x370
const RING_CSB_PTR: u64 = 0x3a0
const CSB_ENTRIES: u64 = 6
const CSB_ENTRY_BYTES: u64 = 8

const GDRST: u64 = 0x941c
const GRDOM_FULL: u64 = 0x1
const GRDOM_RENDER: u64 = 0x2
const GRDOM_BLT: u64 = 0x8

const FORCEWAKE_GT: u64 = 0xa188
const FORCEWAKE_ACK_GT: u64 = 0x130044
const FORCEWAKE_RENDER: u64 = 0xa278
const FORCEWAKE_ACK_RENDER: u64 = 0xd84
const FORCEWAKE_KERNEL: u64 = 0x1

const STOP_RING: u64 = 0x100
const MODE_IDLE: u64 = 0x200
const RUN_LIST_ENABLE: u64 = 0x8000
const RESET_REQUEST: u64 = 0x1
const RESET_READY: u64 = 0x2
const RESET_CAT_ERROR: u64 = 0x4

const MASK_SHIFT: u64 = 16
const LOW16: u64 = 0xffff

fn masked_on(bits: u64) -> u64 {
    return ((bits & LOW16) << MASK_SHIFT) | (bits & LOW16)
}

fn masked_off(bits: u64) -> u64 {
    return (bits & LOW16) << MASK_SHIFT
}

fn eng(base: u64, reg: u64) -> u64 {
    return base + reg
}
