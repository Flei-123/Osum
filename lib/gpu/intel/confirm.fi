export { Watchdog, wd_new, arm, confirm, tick, disarm, W_IDLE, W_ARMED, W_CONFIRMED, W_REVERTED }

const W_IDLE: u64 = 0
const W_ARMED: u64 = 1
const W_CONFIRMED: u64 = 2
const W_REVERTED: u64 = 3

struct Watchdog {
    state: u64,
    deadline_ms: u64,
    reverts: u64
}

fn wd_new() -> Watchdog {
    var w: Watchdog = Watchdog { state: W_IDLE, deadline_ms: 0, reverts: 0 }
    return w
}

fn arm(w: *mut Watchdog, now_ms: u64, timeout_ms: u64) -> bool {
    if timeout_ms == 0 || (*w).state == W_ARMED {
        return false
    }
    (*w).state = W_ARMED
    (*w).deadline_ms = now_ms + timeout_ms
    return true
}

fn confirm(w: *mut Watchdog) -> bool {
    if (*w).state != W_ARMED {
        return false
    }
    (*w).state = W_CONFIRMED
    return true
}

fn disarm(w: *mut Watchdog) {
    if (*w).state == W_ARMED {
        (*w).state = W_IDLE
    }
}

fn tick(w: *mut Watchdog, now_ms: u64, revert: fn()) -> bool {
    if (*w).state != W_ARMED || now_ms < (*w).deadline_ms {
        return false
    }
    revert()
    (*w).state = W_REVERTED
    (*w).reverts = (*w).reverts + 1
    return true
}
