import libc.octets
import gpu.intel.micmd

export { Ring, ring_new, ring_ctl, valid_size, space, emit, pad_qword, fits, RING_MIN, RING_MAX, RING_GAP }

const PAGE: u64 = 0x1000
const RING_MIN: u64 = 0x1000
const RING_MAX: u64 = 0x200000
const RING_NR_PAGES: u64 = 0x1ff000
const RING_VALID: u64 = 1
const RING_GAP: u64 = 8
const DWORD: u64 = 4
const QWORD_MASK: u64 = 7

struct Ring {
    cpu: u64,
    ggtt: u64,
    bytes: u64,
    tail: u64
}

fn valid_size(bytes: u64) -> bool {
    return bytes >= RING_MIN && bytes <= RING_MAX && (bytes & (PAGE - 1)) == 0
}

fn ring_new(cpu: u64, ggtt: u64, bytes: u64) -> Ring {
    var r: Ring = Ring { cpu: cpu, ggtt: ggtt, bytes: bytes, tail: 0 }
    return r
}

fn ring_ctl(bytes: u64) -> u64 {
    return ((bytes - PAGE) & RING_NR_PAGES) | RING_VALID
}

fn space(r: *mut Ring, head: u64) -> u64 {
    return (head + (*r).bytes - (*r).tail - RING_GAP) % (*r).bytes
}

fn fits(r: *mut Ring, head: u64, dwords: u64) -> bool {
    return dwords * DWORD + DWORD <= space(r, head)
}

fn emit(r: *mut Ring, v: u64) {
    octets.st32((*r).cpu, (*r).tail, v)
    (*r).tail = ((*r).tail + DWORD) % (*r).bytes
}

fn pad_qword(r: *mut Ring) {
    if ((*r).tail & QWORD_MASK) != 0 {
        emit(r, micmd.MI_NOOP)
    }
}
