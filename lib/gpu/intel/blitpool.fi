import gpu.intel.engregs
import gpu.intel.engine

export {
    layout, scratch_ggtt, cmd_cpu, is_elsp, engine_write_ok,
    POOL_PAGES, POOL_BYTES, RING_AT, CTX_AT, HWS_AT, CMD_AT, RING_BYTES, SEQNO_FLUSH_BYTES
}

const POOL_PAGES: u64 = 5
const POOL_BYTES: u64 = 0x5000
const RING_AT: u64 = 0x0
const CTX_AT: u64 = 0x1000
const HWS_AT: u64 = 0x3000
const CMD_AT: u64 = 0x4000
const RING_BYTES: u64 = 0x1000
const SCRATCH_OFFSET: u64 = 0x440
const SEQNO_FLUSH_BYTES: u64 = 64

fn layout(cpu: u64, ggtt: u64) -> engine.Layout {
    return engine.layout_new(engregs.BCS_BASE, engregs.GRDOM_BLT,
        cpu + RING_AT, ggtt + RING_AT, RING_BYTES,
        cpu + CTX_AT, ggtt + CTX_AT,
        cpu + HWS_AT, ggtt + HWS_AT)
}

fn scratch_ggtt(ggtt: u64) -> u64 {
    return ggtt + HWS_AT + SCRATCH_OFFSET
}

fn cmd_cpu(cpu: u64) -> u64 {
    return cpu + CMD_AT
}

fn is_elsp(off: u64) -> bool {
    return off == engregs.eng(engregs.BCS_BASE, engregs.RING_ELSP)
}

fn engine_write_ok(off: u64, value: u64) -> bool {
    let base: u64 = engregs.BCS_BASE
    if off == engregs.eng(base, engregs.RING_HWS_PGA) || off == engregs.eng(base, engregs.RING_MODE) {
        return true
    }
    if off == engregs.eng(base, engregs.RING_MI_MODE) || off == engregs.eng(base, engregs.RING_ELSP) {
        return true
    }
    if off == engregs.eng(base, engregs.RING_CSB_PTR) || off == engregs.eng(base, engregs.RING_RESET_CTL) {
        return true
    }
    if off == engregs.FORCEWAKE_GT {
        return true
    }
    return off == engregs.GDRST && (value & ~engregs.GRDOM_BLT) == 0
}
