export { Flushstat, flushstat_new, note, average }

struct Flushstat {
    count: u64,
    last: u64,
    max: u64,
    sum: u64,
    lines: u64
}

fn flushstat_new() -> Flushstat {
    var s: Flushstat = Flushstat { count: 0, last: 0, max: 0, sum: 0, lines: 0 }
    return s
}

fn note(s: *mut Flushstat, cycles: u64, lines: u64) {
    (*s).count = (*s).count + 1
    (*s).last = cycles
    (*s).sum = (*s).sum + cycles
    (*s).lines = (*s).lines + lines
    if cycles > (*s).max {
        (*s).max = cycles
    }
}

fn average(s: *mut Flushstat) -> u64 {
    if (*s).count == 0 {
        return 0
    }
    return (*s).sum / (*s).count
}
