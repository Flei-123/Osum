import gpu.intel.regs
import gpu.intel.bits

export { flip, flip_checked, aligned, F_OK, F_ARG, F_TIMEOUT, F_ROLLED_BACK, LIVE_POLLS, LIVE_POLL_US }

const F_OK: u64 = 0
const F_ARG: u64 = 1
const F_TIMEOUT: u64 = 2
const F_ROLLED_BACK: u64 = 3
const PAGE_OFFSET_MASK: u64 = 0xfff
const LIVE_POLLS: u64 = 40
const LIVE_POLL_US: u64 = 1000

fn aligned(surf: u64) -> bool {
    return (surf & PAGE_OFFSET_MASK) == 0 && surf <= bits.PLANE_SURF_MASK
}

fn live_is(rd: fn(u64) -> u64, us: fn(u64) -> u64, surf: u64) -> bool {
    var n: u64 = 0
    while n < LIVE_POLLS {
        if (rd(regs.PLANE_SURFLIVE_1_A) & bits.PLANE_SURF_MASK) == surf {
            return true
        }
        us(LIVE_POLL_US)
        n = n + 1
    }
    return false
}

fn flip(rd: fn(u64) -> u64, wr: fn(u64, u64) -> u64, us: fn(u64) -> u64, surf: u64) -> u64 {
    if !aligned(surf) {
        return F_ARG
    }
    wr(regs.PLANE_SURF_1_A, surf)
    if live_is(rd, us, surf) {
        return F_OK
    }
    return F_TIMEOUT
}

fn flip_checked(rd: fn(u64) -> u64, wr: fn(u64, u64) -> u64, us: fn(u64) -> u64, surf: u64, fallback: u64) -> u64 {
    let r: u64 = flip(rd, wr, us, surf)
    if r != F_TIMEOUT {
        return r
    }
    wr(regs.PLANE_SURF_1_A, fallback)
    live_is(rd, us, fallback)
    return F_ROLLED_BACK
}
