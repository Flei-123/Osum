export {
    mi, lri_header, store_dword_ggtt, MI_NOOP, MI_USER_INTERRUPT, MI_BATCH_BUFFER_END, MI_LRI_POSTED, MI_USE_GGTT,
    OP_NOOP, OP_USER_INTERRUPT, OP_BATCH_BUFFER_END, OP_STORE_DWORD_IMM, OP_LOAD_REGISTER_IMM, STORE_DWORDS
}

const MI_OPCODE_SHIFT: u64 = 23
const MI_USE_GGTT: u64 = 0x400000
const MI_LRI_POSTED: u64 = 0x1000
const OP_NOOP: u64 = 0x00
const OP_USER_INTERRUPT: u64 = 0x02
const OP_BATCH_BUFFER_END: u64 = 0x0a
const OP_STORE_DWORD_IMM: u64 = 0x20
const OP_LOAD_REGISTER_IMM: u64 = 0x22
const STORE_LEN_FIELD: u64 = 2
const STORE_DWORDS: u64 = 4

const MI_NOOP: u64 = 0
const MI_USER_INTERRUPT: u64 = 0x01000000
const MI_BATCH_BUFFER_END: u64 = 0x05000000

fn mi(opcode: u64, flags: u64) -> u64 {
    return (opcode << MI_OPCODE_SHIFT) | flags
}

fn store_dword_ggtt() -> u64 {
    return mi(OP_STORE_DWORD_IMM, STORE_LEN_FIELD) | MI_USE_GGTT
}

fn lri_header(count: u64, posted: bool) -> u64 {
    var h: u64 = mi(OP_LOAD_REGISTER_IMM, 2 * count - 1)
    if posted {
        h = h | MI_LRI_POSTED
    }
    return h
}
