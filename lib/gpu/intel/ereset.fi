import gpu.intel.engregs

export { reset, R_OK, R_FORCED, R_STUCK, READY_POLLS, GDRST_POLLS, POLL_US }

const R_OK: u64 = 0
const R_FORCED: u64 = 1
const R_STUCK: u64 = 2
const READY_POLLS: u64 = 35
const GDRST_POLLS: u64 = 50
const POLL_US: u64 = 20

fn wait_ready(rd: fn(u64) -> u64, us: fn(u64) -> u64, ctl: u64) -> bool {
    var n: u64 = 0
    while n < READY_POLLS {
        if (rd(ctl) & engregs.RESET_READY) != 0 {
            return true
        }
        us(POLL_US)
        n = n + 1
    }
    return false
}

fn wait_cleared(rd: fn(u64) -> u64, us: fn(u64) -> u64, domain: u64) -> bool {
    var n: u64 = 0
    while n < GDRST_POLLS {
        if (rd(engregs.GDRST) & domain) == 0 {
            return true
        }
        us(POLL_US)
        n = n + 1
    }
    return false
}

fn reset(rd: fn(u64) -> u64, wr: fn(u64, u64) -> u64, us: fn(u64) -> u64, base: u64, domain: u64) -> u64 {
    let ctl: u64 = engregs.eng(base, engregs.RING_RESET_CTL)
    wr(ctl, engregs.masked_on(engregs.RESET_REQUEST))
    let ready: bool = wait_ready(rd, us, ctl)
    wr(engregs.GDRST, domain)
    let cleared: bool = wait_cleared(rd, us, domain)
    wr(ctl, engregs.masked_off(engregs.RESET_REQUEST))
    if !cleared {
        return R_STUCK
    }
    if !ready {
        return R_FORCED
    }
    return R_OK
}
