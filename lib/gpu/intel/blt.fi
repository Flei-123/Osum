import libc.octets

export {
    fill, copy, flush, rect_ok, rects_disjoint,
    FILL_DWORDS, COPY_DWORDS, FLUSH_DWORDS, MAX_COORD, MAX_PITCH, PIXEL_BYTES,
    CMD_XY_COLOR_BLT, CMD_XY_SRC_COPY_BLT, CMD_MI_FLUSH_DW
}

const CMD_XY_COLOR_BLT: u64 = 0x54300005
const CMD_XY_SRC_COPY_BLT: u64 = 0x54f00008
const CMD_MI_FLUSH_DW: u64 = 0x13204001
const FLUSH_USE_GTT: u64 = 0x4
const DEPTH_32: u64 = 0x3000000
const ROP_SRC_COPY: u64 = 0xcc0000
const ROP_COLOR_COPY: u64 = 0xf00000
const FILL_DWORDS: u64 = 7
const COPY_DWORDS: u64 = 10
const FLUSH_DWORDS: u64 = 4
const MAX_COORD: u64 = 0x7fff
const MAX_PITCH: u64 = 0x7fff
const PIXEL_BYTES: u64 = 4
const DWORD: u64 = 4
const COORD_SHIFT: u64 = 16
const LOW32: u64 = 0xffffffff
const ADDR_ALIGN_MASK: u64 = 3

fn put(out: u64, index: u64, v: u64) {
    octets.st32(out, index * DWORD, v & LOW32)
}

fn xy(x: u64, y: u64) -> u64 {
    return (y << COORD_SHIFT) | x
}

fn fill(out: u64, dst: u64, pitch: u64, x1: u64, y1: u64, x2: u64, y2: u64, color: u64) -> u64 {
    put(out, 0, CMD_XY_COLOR_BLT)
    put(out, 1, DEPTH_32 | ROP_COLOR_COPY | pitch)
    put(out, 2, xy(x1, y1))
    put(out, 3, xy(x2, y2))
    put(out, 4, dst)
    put(out, 5, dst >> 32)
    put(out, 6, color)
    return FILL_DWORDS
}

fn copy(out: u64, dst: u64, dst_pitch: u64, x1: u64, y1: u64, x2: u64, y2: u64, src: u64, src_pitch: u64, sx: u64, sy: u64) -> u64 {
    put(out, 0, CMD_XY_SRC_COPY_BLT)
    put(out, 1, DEPTH_32 | ROP_SRC_COPY | dst_pitch)
    put(out, 2, xy(x1, y1))
    put(out, 3, xy(x2, y2))
    put(out, 4, dst)
    put(out, 5, dst >> 32)
    put(out, 6, xy(sx, sy))
    put(out, 7, src_pitch)
    put(out, 8, src)
    put(out, 9, src >> 32)
    return COPY_DWORDS
}

fn flush(out: u64, scratch: u64) -> u64 {
    put(out, 0, CMD_MI_FLUSH_DW)
    put(out, 1, scratch | FLUSH_USE_GTT)
    put(out, 2, 0)
    put(out, 3, 0)
    return FLUSH_DWORDS
}

fn rect_ok(pitch: u64, bytes: u64, x1: u64, y1: u64, x2: u64, y2: u64) -> bool {
    if pitch == 0 || pitch > MAX_PITCH || (pitch & ADDR_ALIGN_MASK) != 0 {
        return false
    }
    if x2 <= x1 || y2 <= y1 || x2 > MAX_COORD || y2 > MAX_COORD {
        return false
    }
    if x2 * PIXEL_BYTES > pitch {
        return false
    }
    return y2 * pitch <= bytes
}

fn rects_disjoint(ax1: u64, ay1: u64, ax2: u64, ay2: u64, bx1: u64, by1: u64, bx2: u64, by2: u64) -> bool {
    return ax2 <= bx1 || bx2 <= ax1 || ay2 <= by1 || by2 <= ay1
}
