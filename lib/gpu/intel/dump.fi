import libc.octets
import hwinv.buf
import gpu.intel.bits
import gpu.intel.mode
import gpu.intel.state

export { dump, LABEL_COUNT }

const LABEL_COUNT: u64 = 75
const HEX_DIGITS: u64 = 8

static EQ_DEC: [u8; 2] = "=\0"
static EQ_HEX: [u8; 4] = "=0x\0"
static LABELS: [u8; 880] = "pipesrc_w\0pipesrc_h\0hactive\0hsync_start\0hsync_end\0htotal\0vactive\0vsync_start\0vsync_end\0vtotal\0pclk_khz\0refresh_mhz\0link_symbol_khz\0data_tu\0data_ratio_ppm\0transconf_edp\0edp_enabled\0pipeconf_a\0pipeconf_b\0ddi_func_edp\0ddi_func_enabled\0ddi_mode\0ddi_bpc\0ddi_pipe\0ddi_lanes\0hsync_positive\0vsync_positive\0ddi_func_a\0ddi_buf_a\0ddi_buf_enabled\0ddi_buf_lanes\0dp_tp_ctl_a\0dp_tp_status_a\0dp_mst\0dp_enhanced\0dp_pattern\0aux_ctl_a\0dpll_ctrl1\0dpll_ctrl2\0dpll_status\0dpll0_locked\0lcpll1_ctl\0lcpll1_enabled\0lcpll1_locked\0cdclk_ctl\0cdclk_khz\0dssm\0dfsm\0cdclk_limit_khz\0fuse_status\0plane_ctl_1_a\0plane_enabled\0plane_format\0plane_tiling\0plane_stride_bytes\0plane_width\0plane_height\0plane_surf\0pp_status\0panel_on\0pp_sequence\0pp_control\0pp_off_delay_100us\0blc_pch_ctl1\0blc_pwm_enabled\0blc_period\0blc_duty\0blc_cpu_ctl2\0blc_cpu_ctl\0pwr_well_ctl1\0pwr_well_ctl2\0pwr_well_ctl3\0pwr_well_ctl4\0dc_state_en\0gmbus2\0"

fn flag(v: u64, mask: u64) -> u64 {
    if (v & mask) != 0 {
        return 1
    }
    return 0
}

fn put_label(index: u64) {
    var at: u64 = 0
    var n: u64 = 0
    let base: u64 = (&LABELS[0]) as u64
    while n < index {
        while octets.ld8(base, at) != 0 {
            at = at + 1
        }
        at = at + 1
        n = n + 1
    }
    buf.put_s(base + at)
}

fn kv_dec(index: u64, v: u64) {
    put_label(index)
    buf.put_s((&EQ_DEC[0]) as u64)
    buf.put_dec(v)
    buf.put_nl()
}

fn kv_hex(index: u64, v: u64) {
    put_label(index)
    buf.put_s((&EQ_HEX[0]) as u64)
    buf.put_hex(v, HEX_DIGITS)
    buf.put_nl()
}

fn dump_part0(s: *mut state.State) {
    kv_dec(0, (*s).pipesrc_w)
    kv_dec(1, (*s).pipesrc_h)
    kv_dec(2, (*s).mode.hactive)
    kv_dec(3, (*s).mode.hsync_start)
    kv_dec(4, (*s).mode.hsync_end)
    kv_dec(5, (*s).mode.htotal)
    kv_dec(6, (*s).mode.vactive)
    kv_dec(7, (*s).mode.vsync_start)
    kv_dec(8, (*s).mode.vsync_end)
    kv_dec(9, (*s).mode.vtotal)
    kv_dec(10, (*s).mode.pclk_khz)
    kv_dec(11, mode.refresh_mhz(&(*s).mode))
    kv_dec(12, (*s).symbol_khz)
    kv_dec(13, (*s).data_tu)
    kv_dec(14, (*s).data_ppm)
    kv_hex(15, (*s).transconf_edp)
    kv_dec(16, flag((*s).transconf_edp, bits.ENABLE))
    kv_hex(17, (*s).pipeconf_a)
    kv_hex(18, (*s).pipeconf_b)
    kv_hex(19, (*s).ddi_func)
    kv_dec(20, flag((*s).ddi_func, bits.ENABLE))
    kv_dec(21, ((*s).ddi_func >> bits.DDI_MODE_SHIFT) & bits.DDI_MODE_MASK)
    kv_dec(22, state.bpc_of((*s).ddi_func))
    kv_dec(23, ((*s).ddi_func >> bits.DDI_PIPE_SHIFT) & bits.DDI_PIPE_MASK)
    kv_dec(24, state.lanes_of((*s).ddi_func))
    kv_dec(25, flag((*s).ddi_func, bits.DDI_PHSYNC))
    kv_dec(26, flag((*s).ddi_func, bits.DDI_PVSYNC))
}

fn dump_part1(s: *mut state.State) {
    kv_hex(27, (*s).ddi_func_a)
    kv_hex(28, (*s).ddi_buf)
    kv_dec(29, flag((*s).ddi_buf, bits.ENABLE))
    kv_dec(30, state.lanes_of((*s).ddi_buf))
    kv_hex(31, (*s).tp_ctl)
    kv_hex(32, (*s).tp_status)
    kv_dec(33, flag((*s).tp_ctl, bits.DP_TP_MST))
    kv_dec(34, flag((*s).tp_ctl, bits.DP_TP_ENHANCED))
    kv_dec(35, ((*s).tp_ctl >> bits.DP_TP_PATTERN_SHIFT) & bits.DP_TP_PATTERN_MASK)
    kv_hex(36, (*s).aux_ctl)
    kv_hex(37, (*s).dpll_ctrl1)
    kv_hex(38, (*s).dpll_ctrl2)
    kv_hex(39, (*s).dpll_status)
    kv_dec(40, flag((*s).dpll_status, bits.DPLL_LOCK))
    kv_hex(41, (*s).lcpll1)
    kv_dec(42, flag((*s).lcpll1, bits.ENABLE))
    kv_dec(43, flag((*s).lcpll1, bits.STATE))
    kv_hex(44, (*s).cdclk_ctl)
    kv_dec(45, state.cdclk_khz_of((*s).cdclk_ctl))
    kv_hex(46, (*s).dssm)
    kv_hex(47, (*s).dfsm)
    kv_dec(48, state.cdclk_limit_khz_of((*s).dfsm))
    kv_hex(49, (*s).fuse_status)
    kv_hex(50, (*s).plane_ctl)
    kv_dec(51, flag((*s).plane_ctl, bits.ENABLE))
    kv_dec(52, ((*s).plane_ctl >> bits.PLANE_FORMAT_SHIFT) & bits.PLANE_FORMAT_MASK)
    kv_dec(53, ((*s).plane_ctl >> bits.PLANE_TILING_SHIFT) & bits.PLANE_TILING_MASK)
}

fn dump_part2(s: *mut state.State) {
    kv_dec(54, (*s).plane_stride * bits.PLANE_STRIDE_UNIT)
    kv_dec(55, ((*s).plane_size & 0xffff) + 1)
    kv_dec(56, (((*s).plane_size >> 16) & 0xffff) + 1)
    kv_hex(57, (*s).plane_surf & bits.PLANE_SURF_MASK)
    kv_hex(58, (*s).pp_status)
    kv_dec(59, flag((*s).pp_status, bits.PP_ON))
    kv_dec(60, (*s).pp_status & bits.PP_SEQ_MASK)
    kv_hex(61, (*s).pp_control)
    kv_dec(62, ((*s).pp_off_delays >> bits.PP_DELAY_SHIFT) & bits.PP_DELAY_MASK)
    kv_hex(63, (*s).blc_pch_ctl1)
    kv_dec(64, flag((*s).blc_pch_ctl1, bits.ENABLE))
    kv_dec(65, ((*s).blc_pch_ctl2 >> bits.BLC_PERIOD_SHIFT) & bits.BLC_DUTY_MASK)
    kv_dec(66, (*s).blc_pch_ctl2 & bits.BLC_DUTY_MASK)
    kv_hex(67, (*s).blc_cpu_ctl2)
    kv_hex(68, (*s).blc_cpu_ctl)
    kv_hex(69, (*s).pw0)
    kv_hex(70, (*s).pw1)
    kv_hex(71, (*s).pw2)
    kv_hex(72, (*s).pw3)
    kv_hex(73, (*s).dc_state)
    kv_hex(74, (*s).gmbus2)
}

fn dump(s: *mut state.State) {
    dump_part0(s)
    dump_part1(s)
    dump_part2(s)
}
