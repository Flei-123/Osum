import std.rt

export { cmp_f32, cmp_u32, stencil_pass, stencil_next, SO_FUNC, SO_FAIL, SO_PASS, SO_DFAIL, SO_CMASK, SO_WMASK, SO_REF, SO_WORDS }

const SO_FUNC: usize = 0
const SO_FAIL: usize = 1
const SO_PASS: usize = 2
const SO_DFAIL: usize = 3
const SO_CMASK: usize = 4
const SO_WMASK: usize = 5
const SO_REF: usize = 6
const SO_WORDS: usize = 7

fn cmp_f32(func: i32, a: f32, b: f32) -> bool {
    if func == 1 { return a < b }
    if func == 2 { return a == b }
    if func == 3 { return a <= b }
    if func == 4 { return a > b }
    if func == 5 { return a != b }
    if func == 6 { return a >= b }
    if func == 7 { return true }
    return false
}

fn cmp_u32(func: i32, a: u32, b: u32) -> bool {
    if func == 1 { return a < b }
    if func == 2 { return a == b }
    if func == 3 { return a <= b }
    if func == 4 { return a > b }
    if func == 5 { return a != b }
    if func == 6 { return a >= b }
    if func == 7 { return true }
    return false
}

fn stencil_pass(sp: u64, stored: u32) -> bool {
    let mask: u32 = rt.ld32(sp, SO_CMASK) & 255 as u32
    let reference: u32 = rt.ld32(sp, SO_REF) & mask
    return cmp_u32(rt.ld32(sp, SO_FUNC) as i32, reference, stored & mask)
}

fn stencil_next(sp: u64, which: usize, stored: u32) -> u32 {
    let op: u32 = rt.ld32(sp, which)
    let wmask: u32 = rt.ld32(sp, SO_WMASK) & 255 as u32
    var v: u32 = stored
    if op == 1 as u32 { v = 0 as u32 }
    if op == 2 as u32 { v = rt.ld32(sp, SO_REF) & 255 as u32 }
    if op == 3 as u32 { if stored < 255 as u32 { v = stored + 1 as u32 } }
    if op == 4 as u32 { if stored > 0 as u32 { v = stored - 1 as u32 } }
    if op == 5 as u32 { v = 255 as u32 - (stored & 255 as u32) }
    if op == 6 as u32 { v = (stored + 1 as u32) & 255 as u32 }
    if op == 7 as u32 { v = (stored + 255 as u32) & 255 as u32 }
    return (stored & (255 as u32 - wmask)) | (v & wmask)
}
