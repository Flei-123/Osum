// lib/gpu/swr/clip.fi -- clip-space polygon clipping for the SWR rasterizer: near plane (z >= 0), w >= 1e-6 and the x/y guard band (|x|, |y| <= GUARD w)
// vertices are STRIDE f64 each: x y z w u v r g b a; every attribute is linear in clip space, so lerping them is perspective correct
import std.rt

export { clip_poly, STRIDE, MAXV, GUARD, NPLANES_NEAR, NPLANES_ALL }

const STRIDE: usize = 10
const MAXV: usize = 12
const GUARD: f64 = 16.0
const NPLANES_NEAR: usize = 2
const NPLANES_ALL: usize = 6

fn ld(p: u64, i: usize) -> f64 {
    return *((p + (i as u64) * (8 as u64)) as *mut f64)
}

fn st(p: u64, i: usize, v: f64) {
    *((p + (i as u64) * (8 as u64)) as *mut f64) = v
}

fn dist(p: u64, v: usize, plane: i32) -> f64 {
    let o: usize = v * STRIDE
    if plane == 0 { return ld(p, o + 2) }
    if plane == 1 { return ld(p, o + 3) - 0.000001 }
    let w: f64 = ld(p, o + 3) * GUARD
    if plane == 2 { return w - ld(p, o) }
    if plane == 3 { return w + ld(p, o) }
    if plane == 4 { return w - ld(p, o + 1) }
    return w + ld(p, o + 1)
}

fn copy_v(src: u64, s: usize, dst: u64, d: usize) {
    var k: usize = 0
    while k < STRIDE {
        st(dst, d * STRIDE + k, ld(src, s * STRIDE + k))
        k = k + 1
    }
}

// dst vertex = inside + t * (outside - inside); always from the inside vertex so both triangles sharing an edge get the same point
fn cut_v(src: u64, inside: usize, outside: usize, t: f64, dst: u64, d: usize) {
    var k: usize = 0
    while k < STRIDE {
        let a: f64 = ld(src, inside * STRIDE + k)
        let b: f64 = ld(src, outside * STRIDE + k)
        st(dst, d * STRIDE + k, a + t * (b - a))
        k = k + 1
    }
}

fn clip_plane(src: u64, n: usize, dst: u64, plane: i32) -> usize {
    var m: usize = 0
    var i: usize = 0
    while i < n {
        var j: usize = i + 1
        if j == n { j = 0 }
        let di: f64 = dist(src, i, plane)
        let dj: f64 = dist(src, j, plane)
        let ii: bool = di >= 0.0
        let ij: bool = dj >= 0.0
        if ii {
            copy_v(src, i, dst, m)
            m = m + 1
        }
        if (ii && !ij) || (!ii && ij) {
            if ii { cut_v(src, i, j, di / (di - dj), dst, m) } else { cut_v(src, j, i, dj / (dj - di), dst, m) }
            m = m + 1
        }
        i = i + 1
    }
    return m
}

// polygon of n vertices in a; scratch b (MAXV vertices); result (0 .. 9 vertices) is left in a; planes: NPLANES_NEAR or NPLANES_ALL (even)
fn clip_poly(a: u64, b: u64, n: usize, planes: usize) -> usize {
    var all_in: bool = true
    var i: usize = 0
    while i < n {
        var pl: usize = 0
        while pl < planes {
            if !(dist(a, i, pl as i32) >= 0.0) { all_in = false }
            pl = pl + 1
        }
        i = i + 1
    }
    if all_in { return n }
    var m: usize = n
    var pl: usize = 0
    while pl < planes {
        if pl % 2 == 0 { m = clip_plane(a, m, b, pl as i32) } else { m = clip_plane(b, m, a, pl as i32) }
        if m == 0 { return 0 }
        pl = pl + 1
    }
    return m
}
