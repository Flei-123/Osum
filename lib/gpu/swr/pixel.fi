// SPDX-License-Identifier: GPL-2.0-only
import std.rt

export { blend_over, blend_premul, bilinear, floor_i32 }

fn floor_i32(x: f32) -> i32 {
    var t: i32 = x as i32
    if (t as f32) > x { t = t - 1 }
    return t
}

fn chan_over(s: u32, d: u32, sa: u32) -> u32 {
    return (s * sa + d * (255 as u32 - sa) + 127 as u32) / 255 as u32
}

fn blend_over(src: u32, dst: u32) -> u32 {
    let sa: u32 = src >> 24 as u32
    let da: u32 = dst >> 24 as u32
    let r: u32 = chan_over(src & 255 as u32, dst & 255 as u32, sa)
    let g: u32 = chan_over((src >> 8 as u32) & 255 as u32, (dst >> 8 as u32) & 255 as u32, sa)
    let b: u32 = chan_over((src >> 16 as u32) & 255 as u32, (dst >> 16 as u32) & 255 as u32, sa)
    let a: u32 = sa + (da * (255 as u32 - sa) + 127 as u32) / 255 as u32
    return r | (g << 8 as u32) | (b << 16 as u32) | (a << 24 as u32)
}

fn chan_premul(s: u32, d: u32, sa: u32) -> u32 {
    let v: u32 = s + (d * (255 as u32 - sa) + 127 as u32) / 255 as u32
    if v > 255 as u32 { return 255 as u32 }
    return v
}

// source over with a premultiplied source colour: dst' = src + dst * (1 - src.a)
fn blend_premul(src: u32, dst: u32) -> u32 {
    let sa: u32 = src >> 24 as u32
    let r: u32 = chan_premul(src & 255 as u32, dst & 255 as u32, sa)
    let g: u32 = chan_premul((src >> 8 as u32) & 255 as u32, (dst >> 8 as u32) & 255 as u32, sa)
    let b: u32 = chan_premul((src >> 16 as u32) & 255 as u32, (dst >> 16 as u32) & 255 as u32, sa)
    let a: u32 = chan_premul(sa, dst >> 24 as u32, sa)
    return r | (g << 8 as u32) | (b << 16 as u32) | (a << 24 as u32)
}

fn lerp_chan(c00: u32, c10: u32, c01: u32, c11: u32, wx: u32, wy: u32) -> u32 {
    let top: u32 = c00 * (256 as u32 - wx) + c10 * wx
    let bot: u32 = c01 * (256 as u32 - wx) + c11 * wx
    return (top * (256 as u32 - wy) + bot * wy + 32768 as u32) >> 16 as u32
}

fn bilinear(tex: u64, tw: i32, th: i32, u: f32, v: f32) -> u32 {
    let fx: f32 = u * (tw as f32) - 0.5f
    let fy: f32 = v * (th as f32) - 0.5f
    let ix: i32 = floor_i32(fx)
    let iy: i32 = floor_i32(fy)
    let wx: u32 = ((fx - (ix as f32)) * 256.0f) as u32
    let wy: u32 = ((fy - (iy as f32)) * 256.0f) as u32
    let x0: usize = (ix & (tw - 1)) as usize
    let x1: usize = ((ix + 1) & (tw - 1)) as usize
    let y0: usize = (iy & (th - 1)) as usize
    let y1: usize = ((iy + 1) & (th - 1)) as usize
    let twu: usize = tw as usize
    let p00: u32 = rt.ld32(tex, y0 * twu + x0)
    let p10: u32 = rt.ld32(tex, y0 * twu + x1)
    let p01: u32 = rt.ld32(tex, y1 * twu + x0)
    let p11: u32 = rt.ld32(tex, y1 * twu + x1)
    var out: u32 = 0 as u32
    var s: u32 = 0 as u32
    while s < 32 as u32 {
        let m: u32 = 255 as u32
        let c: u32 = lerp_chan((p00 >> s) & m, (p10 >> s) & m, (p01 >> s) & m, (p11 >> s) & m, wx, wy)
        out = out | (c << s)
        s = s + 8 as u32
    }
    return out
}
