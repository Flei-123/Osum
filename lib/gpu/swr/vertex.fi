// SPDX-License-Identifier: GPL-2.0-only
// lib/gpu/swr/vertex.fi -- SWR vertex stage: runs a lowered SPIR-V vertex shader (lower.lower_stage EM_VERTEX) once per vertex.
// Registers: attribute location k = r(4k..4k+3), Position r36..r39, output location 0 = r40.. (u, v), output location 1 = r44.. (colour rgba), flat outputs location k = r(40 + 4k),
// constants through Frame.ubo (OP_LDU). Results go to the frame vertex buffer (raster.vtx_put layout).

import std.rt
import gpu.swr.raster

export { vs_run, VS_ATTR_MAX }

const VS_ATTR_MAX: usize = 36

// attrs: f32 [nverts * stride], stride <= VS_ATTR_MAX; vertex i of the batch goes to vertex buffer slot first + i
fn vs_run(f: *mut raster.Frame, prog: u64, attrs: u64, stride: usize, nverts: usize, first: usize) {
    let base: u64 = rt.heap_alloc(raster.WORK)
    var v0: usize = 0
    while v0 < nverts {
        var n: usize = nverts - v0
        if n > raster.LANES { n = raster.LANES }
        var l: usize = 0
        while l < n {
            var c: usize = 0
            while c < stride {
                raster.st_f32(raster.rg(base, c, l), 0, raster.ld_f32(attrs, (v0 + l) * stride + c))
                c = c + 1
            }
            l = l + 1
        }
        raster.vm_run(f, prog, base, n)
        l = 0
        while l < n {
            raster.vtx_put(f, first + v0 + l,
                raster.ld_f32(raster.rg(base, 36, l), 0), raster.ld_f32(raster.rg(base, 37, l), 0),
                raster.ld_f32(raster.rg(base, 38, l), 0), raster.ld_f32(raster.rg(base, 39, l), 0),
                raster.ld_f32(raster.rg(base, 40, l), 0), raster.ld_f32(raster.rg(base, 41, l), 0),
                raster.ld_f32(raster.rg(base, 44, l), 0), raster.ld_f32(raster.rg(base, 45, l), 0),
                raster.ld_f32(raster.rg(base, 46, l), 0), raster.ld_f32(raster.rg(base, 47, l), 0))
            var q: usize = 0
            while q < (*f).nflat as usize {
                raster.st_f32((*f).vbuf, (first + v0 + l) * raster.VSTRIDE + raster.FLAT0 + q, raster.ld_f32(raster.rg(base, 40 + q, l), 0))
                q = q + 1
            }
            l = l + 1
        }
        v0 = v0 + n
    }
    rt.heap_free(base, raster.WORK)
}
