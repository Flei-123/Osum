import crypto.blake2s

export { seedfile_encode, seedfile_decode, SEEDFILE_SIZE, SEEDFILE_SEED, SEEDFILE_KEY }

const SEEDFILE_SEED: usize = 64
const SEEDFILE_KEY: usize = 32
const SEEDFILE_MAGIC: usize = 8
const SEEDFILE_COUNTER: usize = 8
const SEEDFILE_BODY: usize = 80
const SEEDFILE_MAC: usize = 32
const SEEDFILE_SIZE: usize = 112

fn put64(p: u64, at: usize, v: u64) {
    var i: usize = 0
    while i < 8 {
        *((p + (at + i) as u64) as *mut u8) = ((v >> ((i as u64) * 8)) & 255) as u8
        i = i + 1
    }
}

fn get64(p: u64, at: usize) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while i < 8 {
        v = v | ((*((p + (at + i) as u64) as *mut u8)) as u64) << ((i as u64) * 8)
        i = i + 1
    }
    return v
}

fn magic_at(i: usize) -> u8 {
    var m: [u8; 8] = [79, 83, 82, 78, 68, 83, 68, 49]
    return m[i]
}

fn seedfile_encode(counter: u64, seed: u64, key: u64, out: u64) -> bool {
    var i: usize = 0
    while i < SEEDFILE_MAGIC {
        *((out + i as u64) as *mut u8) = magic_at(i)
        i = i + 1
    }
    put64(out, SEEDFILE_MAGIC, counter)
    i = 0
    while i < SEEDFILE_SEED {
        *((out + (SEEDFILE_MAGIC + SEEDFILE_COUNTER + i) as u64) as *mut u8) = *((seed + i as u64) as *mut u8)
        i = i + 1
    }
    return blake2s.hmac_blake2s(key, SEEDFILE_KEY, out, SEEDFILE_BODY, out + SEEDFILE_BODY as u64)
}

fn seedfile_decode(buf: u64, n: usize, key: u64, seed_out: u64, counter_out: u64) -> bool {
    if n != SEEDFILE_SIZE {
        return false
    }
    var i: usize = 0
    while i < SEEDFILE_MAGIC {
        if *((buf + i as u64) as *mut u8) != magic_at(i) {
            return false
        }
        i = i + 1
    }
    var mac: [u8; 32] = [0; 32]
    if !blake2s.hmac_blake2s(key, SEEDFILE_KEY, buf, SEEDFILE_BODY, (&mac[0]) as u64) {
        return false
    }
    if !blake2s.mac_equal((&mac[0]) as u64, buf + SEEDFILE_BODY as u64, SEEDFILE_MAC) {
        return false
    }
    i = 0
    while i < SEEDFILE_SEED {
        *((seed_out + i as u64) as *mut u8) = *((buf + (SEEDFILE_MAGIC + SEEDFILE_COUNTER + i) as u64) as *mut u8)
        i = i + 1
    }
    *(counter_out as *mut u64) = get64(buf, SEEDFILE_MAGIC)
    return true
}
