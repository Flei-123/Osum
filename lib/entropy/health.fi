export { Health, health_new, health_feed, HEALTH_RCT_CUTOFF, HEALTH_APT_WINDOW, HEALTH_APT_CUTOFF }

const HEALTH_RCT_CUTOFF: u64 = 21
const HEALTH_APT_WINDOW: u64 = 512
const HEALTH_APT_CUTOFF: u64 = 410

struct Health {
    rct_value: u64,
    rct_run: u64,
    apt_value: u64,
    apt_seen: u64,
    apt_hits: u64,
    samples: u64,
    failures: u64
}

fn health_new() -> Health {
    return Health { rct_value: 0, rct_run: 0, apt_value: 0, apt_seen: 0,
        apt_hits: 0, samples: 0, failures: 0 }
}

fn health_feed(h: *mut Health, sample: u64) -> bool {
    var healthy: bool = true
    (*h).samples = (*h).samples + 1
    if (*h).rct_run > 0 && sample == (*h).rct_value {
        (*h).rct_run = (*h).rct_run + 1
        if (*h).rct_run >= HEALTH_RCT_CUTOFF {
            healthy = false
            (*h).rct_run = 1
        }
    } else {
        (*h).rct_value = sample
        (*h).rct_run = 1
    }
    if (*h).apt_seen == 0 {
        (*h).apt_value = sample
        (*h).apt_hits = 1
        (*h).apt_seen = 1
    } else {
        (*h).apt_seen = (*h).apt_seen + 1
        if sample == (*h).apt_value {
            (*h).apt_hits = (*h).apt_hits + 1
            if (*h).apt_hits >= HEALTH_APT_CUTOFF {
                healthy = false
                (*h).apt_hits = 0
            }
        }
        if (*h).apt_seen >= HEALTH_APT_WINDOW {
            (*h).apt_seen = 0
        }
    }
    if !healthy {
        (*h).failures = (*h).failures + 1
    }
    return healthy
}
