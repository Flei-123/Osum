import crypto.blake2s

export { Pool, pool_new, pool_mix, pool_extract, POOL_DIGEST }

const POOL_DIGEST: usize = 32
const TAG_MIX: u64 = 0x4D
const TAG_EXTRACT: u64 = 0x58
const TAG_ADVANCE: u64 = 0x41

struct Pool {
    chain: [u8; 32],
    mixed: u64,
    extracts: u64
}

fn pool_new() -> Pool {
    return Pool { chain: [0; 32], mixed: 0, extracts: 0 }
}

fn pool_step(p: *mut Pool, tag: u64, data: u64, n: usize, out: u64) {
    var s: blake2s.Blake2s = blake2s.blake2s_new()
    var head: [u8; 9] = [0; 9]
    var i: usize = 0
    head[0] = tag as u8
    while i < 8 {
        head[1 + i] = (((n as u64) >> ((i as u64) * 8)) & 255) as u8
        i = i + 1
    }
    blake2s.blake2s_update(&s, (&(*p).chain[0]) as u64, 32)
    blake2s.blake2s_update(&s, (&head[0]) as u64, 9)
    if n > 0 {
        blake2s.blake2s_update(&s, data, n)
    }
    blake2s.blake2s_final(&s, out)
}

fn pool_mix(p: *mut Pool, data: u64, n: usize) {
    var next: [u8; 32] = [0; 32]
    pool_step(p, TAG_MIX, data, n, (&next[0]) as u64)
    var i: usize = 0
    while i < 32 {
        (*p).chain[i] = next[i]
        next[i] = 0
        i = i + 1
    }
    (*p).mixed = (*p).mixed + n as u64
}

fn pool_extract(p: *mut Pool, out: u64) {
    var next: [u8; 32] = [0; 32]
    pool_step(p, TAG_EXTRACT, 0, 0, out)
    pool_step(p, TAG_ADVANCE, 0, 0, (&next[0]) as u64)
    var i: usize = 0
    while i < 32 {
        (*p).chain[i] = next[i]
        next[i] = 0
        i = i + 1
    }
    (*p).extracts = (*p).extracts + 1
}
