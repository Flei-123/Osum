// SPDX-License-Identifier: GPL-2.0-only
export {
    check, op_word,
    OP_INIT, OP_CREATE, OP_DELETE, OP_FORMAT,
    R_OK, R_SYSTEM, R_BUSY, R_MOUNTED, R_HAS_TABLE, R_UNCONFIRMED
}

const OP_INIT: u64 = 1
const OP_CREATE: u64 = 2
const OP_DELETE: u64 = 3
const OP_FORMAT: u64 = 4

const R_OK: u64 = 0
const R_SYSTEM: u64 = 1
const R_BUSY: u64 = 2
const R_MOUNTED: u64 = 3
const R_HAS_TABLE: u64 = 4
const R_UNCONFIRMED: u64 = 5

static mut W_INIT: [u8; 5] = "init\0"
static mut W_CREATE: [u8; 7] = "create\0"
static mut W_DELETE: [u8; 7] = "delete\0"
static mut W_FORMAT: [u8; 7] = "format\0"
static mut W_NONE: [u8; 5] = "none\0"

fn op_word(op: u64) -> u64 {
    if op == OP_INIT {
        return (&W_INIT[0]) as u64
    }
    if op == OP_CREATE {
        return (&W_CREATE[0]) as u64
    }
    if op == OP_DELETE {
        return (&W_DELETE[0]) as u64
    }
    if op == OP_FORMAT {
        return (&W_FORMAT[0]) as u64
    }
    return (&W_NONE[0]) as u64
}

fn check(op: u64, system_disk: bool, disk_busy: bool, part_mounted: bool, has_table: bool, confirmed: bool) -> u64 {
    if system_disk {
        return R_SYSTEM
    }
    if op == OP_INIT {
        if disk_busy {
            return R_BUSY
        }
        if has_table {
            return R_HAS_TABLE
        }
    }
    if (op == OP_DELETE || op == OP_FORMAT) && part_mounted {
        return R_MOUNTED
    }
    if !confirmed {
        return R_UNCONFIRMED
    }
    return R_OK
}
