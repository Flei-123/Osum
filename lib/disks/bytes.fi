// SPDX-License-Identifier: GPL-2.0-only
export { ld8, st8, le16, le32, le64, put16, put32, put64, zero, copy }

fn ld8(p: u64, i: u64) -> u64 {
    return (*((p + i) as *mut u8)) as u64
}

fn st8(p: u64, v: u64) {
    *(p as *mut u8) = v as u8
}

fn le16(p: u64) -> u64 {
    return ld8(p, 0) | (ld8(p, 1) << 8)
}

fn le32(p: u64) -> u64 {
    return le16(p) | (le16(p + 2) << 16)
}

fn le64(p: u64) -> u64 {
    return le32(p) | (le32(p + 4) << 32)
}

fn put16(p: u64, v: u64) {
    st8(p, v & 255)
    st8(p + 1, (v >> 8) & 255)
}

fn put32(p: u64, v: u64) {
    put16(p, v & 65535)
    put16(p + 2, (v >> 16) & 65535)
}

fn put64(p: u64, v: u64) {
    put32(p, v & 4294967295)
    put32(p + 4, (v >> 32) & 4294967295)
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        st8(p + i, 0)
        i = i + 1
    }
}

fn copy(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        st8(dst + i, ld8(src, i))
        i = i + 1
    }
}
