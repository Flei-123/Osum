import libc.octets

export { st8, put16, put32, put64, zero, copy }

fn st8(p: u64, v: u64) {
    *(p as *mut u8) = v as u8
}

fn put16(p: u64, v: u64) {
    st8(p, v & 255)
    st8(p + 1, (v >> 8) & 255)
}

fn put32(p: u64, v: u64) {
    put16(p, v & 65535)
    put16(p + 2, (v >> 16) & 65535)
}

fn put64(p: u64, v: u64) {
    put32(p, v & 4294967295)
    put32(p + 4, (v >> 32) & 4294967295)
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        st8(p + i, 0)
        i = i + 1
    }
}

fn copy(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        st8(dst + i, octets.ld8(src, i))
        i = i + 1
    }
}
