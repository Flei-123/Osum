// SPDX-License-Identifier: GPL-2.0-only
// lib/apprights/policy.fi -- per-app right grants (W-APPRIGHTS stage 1, docs/APP-RECHTE-ENERGIE.md).
//
// No profile line: importable from the kernel and from host tests. No heap, no str.
//
// MODEL. A task that runs for an app carries the sticky kernel label "app:<name>" (kernel/sched/origin.fi).
// This table holds, per app name, the rights the PERSON granted. Default = nothing granted. A label that is
// not "app:..." (empty = the person's own tools, "jarvis", ...) is never gated by this table.
// The table is changed only by an unlabelled caller; that check lives in the kernel (sys.fi do_origin), not here.

export {
    P_MIC, P_CAMERA, P_NET, P_FS_HOME, P_NOTIFY, P_CLIP_READ, P_CLIP_WRITE, P_AUDIO_PLAY,
    P_LOCATION, P_CONTACTS, P_PHONE, P_WINDOW_FLOAT, P_ALL, P_SAFE, NAME_MAX, MAX_APPS,
    E_OK, E_FULL, E_BADNAME, E_CEIL, CEIL_NONE,
    set_ceiling, get_ceiling, has_ceiling,
    A_CPU, A_WAKE, A_TX, A_RX, acct_addr, acct_get, acct_clear, slot_used, slot_name,
    name_ok, label_app, app_slot, set_mask, get_mask, grant, revoke, label_allows, reset, count, bit_of, name_of_bit,
}

const P_MIC: u64 = 1
const P_CAMERA: u64 = 2
const P_NET: u64 = 4
const P_FS_HOME: u64 = 8
const P_NOTIFY: u64 = 16
const P_CLIP_READ: u64 = 32
const P_CLIP_WRITE: u64 = 64
const P_AUDIO_PLAY: u64 = 128
const P_LOCATION: u64 = 256
const P_CONTACTS: u64 = 512
const P_PHONE: u64 = 1024
// W-WINOPTS S2: the window may take the layer L_FLOAT (always on top of the ordinary windows, BELOW task bar and lock screen).
// Sensitive like the microphone: NOT in P_SAFE, so there is no automatic grant -- the person allows it.
const P_WINDOW_FLOAT: u64 = 2048
const P_ALL: u64 = 4095
// AR-3: the NON-SENSITIVE rights. A package installed from a signed source gets those it declares in perm= granted
// automatically (like Android's "normal" permissions); everything else (mic, camera, fs.home, location, contacts,
// phone, window.float) stays default deny until the person allows it. net 4 + notify 16 + clipboard.read 32 +
// clipboard.write 64 + audio.play 128.
const P_SAFE: u64 = 244

const NAME_MAX: u64 = 19 // "app:" + 19 = the 23 characters of a label (origin.LABEL_MAX)
const MAX_APPS: u64 = 16
const SLOT: u64 = 24 // octets per name in the table (19 + zero, padded)

const E_OK: u64 = 0
const E_FULL: u64 = 1
const E_BADNAME: u64 = 2
const E_CEIL: u64 = 3 // the grant asks for a right the manifest did not declare

// CEILING (AR-2). The manifest of an installed app declares what it MAY ever get (`perm=`). A loader registers that
// set per app; a grant above it is refused (E_CEIL). An app with NO registered ceiling (never looked at) is only
// limited by the default deny of the grant table. An app whose manifest has no `perm=` is registered with ceiling 0.
const CEIL_NONE: u64 = 4096 // get_ceiling(): "no ceiling registered" (outside P_ALL)

static mut names: [u8; 384] = [0 as u8; 384]
static mut masks: [u64; 16] = [0 as u64; 16]
static mut used: [u64; 16] = [0 as u64; 16]
static mut ceils: [u64; 16] = [0 as u64; 16]
static mut ceilset: [u64; 16] = [0 as u64; 16]

// PER-APP COUNTERS (AR-2b). Four words per table slot, booked by the kernel at the places where the work happens:
// A_CPU timer ticks charged to a task of the app, A_WAKE blocked->ready transitions of its tasks (wakeups),
// A_TX / A_RX payload octets its sockets handed to / took from the stack. Children inherit the label, so they count
// for the app. Callers add through acct_addr() with an atomic add (several cores book at once). The slot is
// zeroed when it is allocated; an app without a slot (table full, never registered) is not counted.
const A_CPU: u64 = 0
const A_WAKE: u64 = 1
const A_TX: u64 = 2
const A_RX: u64 = 3
static mut acct: [u64; 64] = [0 as u64; 64]

fn rd(p: u64, i: u64) -> u64 {
    let c: u8 = *((p + i) as *mut u8)
    return c as u64
}

fn slen(p: u64) -> u64 {
    var n: u64 = 0
    while n < 64 && rd(p, n) != 0 {
        n = n + 1
    }
    return n
}

// If `label` is "app:<name>" return a pointer to <name>, else 0.
fn label_app(label: u64) -> u64 {
    if rd(label, 0) == 97 && rd(label, 1) == 112 && rd(label, 2) == 112 && rd(label, 3) == 58 {
        if rd(label, 4) == 0 {
            return 0
        }
        return label + 4
    }
    return 0
}

fn name_char_ok(c: u64) -> bool {
    if c >= 97 && c <= 122 {
        return true
    }
    if c >= 65 && c <= 90 {
        return true
    }
    if c >= 48 && c <= 57 {
        return true
    }
    return c == 46 || c == 95 || c == 45
}

fn name_ok(name: u64) -> bool {
    let n: u64 = slen(name)
    if n == 0 || n > NAME_MAX {
        return false
    }
    var i: u64 = 0
    while i < n {
        if !name_char_ok(rd(name, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn same(slot: u64, name: u64) -> bool {
    var i: u64 = 0
    while i <= NAME_MAX {
        let a: u64 = names[(slot * SLOT + i) as usize] as u64
        let b: u64 = rd(name, i)
        if a != b {
            return false
        }
        if a == 0 {
            return true
        }
        i = i + 1
    }
    return true
}

// Slot of `name` or MAX_APPS when it has none.
fn app_slot(name: u64) -> u64 {
    var s: u64 = 0
    while s < MAX_APPS {
        if used[s as usize] != 0 && same(s, name) {
            return s
        }
        s = s + 1
    }
    return MAX_APPS
}

// Slot of `name`, allocated when it has none. MAX_APPS = table full (or bad name).
fn slot_for(name: u64) -> u64 {
    var s: u64 = app_slot(name)
    if s < MAX_APPS {
        return s
    }
    s = 0
    while s < MAX_APPS && used[s as usize] != 0 {
        s = s + 1
    }
    if s >= MAX_APPS {
        return MAX_APPS
    }
    var i: u64 = 0
    while i <= NAME_MAX {
        names[(s * SLOT + i) as usize] = rd(name, i) as u8
        i = i + 1
    }
    used[s as usize] = 1
    masks[s as usize] = 0
    ceils[s as usize] = 0
    ceilset[s as usize] = 0
    acct_clear(s)
    return s
}

fn acct_clear(slot: u64) {
    if slot >= MAX_APPS {
        return
    }
    var f: u64 = 0
    while f < 4 {
        acct[(slot * 4 + f) as usize] = 0
        f = f + 1
    }
}

// Address of one counter of the app that `label` ("app:<name>") names; 0 = not an app label or no slot.
// Hot path (timer tick): an unlabelled task costs one byte compare.
fn acct_addr(label: u64, field: u64) -> u64 {
    if rd(label, 0) != 97 {
        return 0
    }
    let app: u64 = label_app(label)
    if app == 0 || field >= 4 {
        return 0
    }
    let s: u64 = app_slot(app)
    if s >= MAX_APPS {
        return 0
    }
    return ((&acct[0]) as u64) + (s * 4 + field) * 8
}

fn acct_get(slot: u64, field: u64) -> u64 {
    if slot >= MAX_APPS || field >= 4 {
        return 0
    }
    return acct[(slot * 4 + field) as usize]
}

fn slot_used(slot: u64) -> bool {
    return slot < MAX_APPS && used[slot as usize] != 0
}

// Zero-terminated name of a used slot (pointer into the table), 0 when free.
fn slot_name(slot: u64) -> u64 {
    if !slot_used(slot) {
        return 0
    }
    return ((&names[0]) as u64) + slot * SLOT
}

fn set_ceiling(name: u64, ceil: u64) -> u64 {
    if !name_ok(name) {
        return E_BADNAME
    }
    let s: u64 = slot_for(name)
    if s >= MAX_APPS {
        return E_FULL
    }
    ceils[s as usize] = ceil & P_ALL
    ceilset[s as usize] = 1
    // a lowered ceiling takes rights away at once
    masks[s as usize] = masks[s as usize] & ceils[s as usize]
    return E_OK
}

fn has_ceiling(name: u64) -> bool {
    let s: u64 = app_slot(name)
    if s >= MAX_APPS {
        return false
    }
    return ceilset[s as usize] != 0
}

fn get_ceiling(name: u64) -> u64 {
    let s: u64 = app_slot(name)
    if s >= MAX_APPS || ceilset[s as usize] == 0 {
        return CEIL_NONE
    }
    return ceils[s as usize]
}

fn set_mask(name: u64, mask: u64) -> u64 {
    if !name_ok(name) {
        return E_BADNAME
    }
    var s: u64 = app_slot(name)
    if s < MAX_APPS && ceilset[s as usize] != 0 {
        if ((mask & P_ALL) & (P_ALL - ceils[s as usize])) != 0 {
            return E_CEIL
        }
    }
    if s >= MAX_APPS {
        s = 0
        while s < MAX_APPS && used[s as usize] != 0 {
            s = s + 1
        }
        if s >= MAX_APPS {
            return E_FULL
        }
        var i: u64 = 0
        while i <= NAME_MAX {
            names[(s * SLOT + i) as usize] = rd(name, i) as u8
            i = i + 1
        }
        used[s as usize] = 1
        ceilset[s as usize] = 0
        ceils[s as usize] = 0
        acct_clear(s)
    }
    masks[s as usize] = mask & P_ALL
    return E_OK
}

fn get_mask(name: u64) -> u64 {
    let s: u64 = app_slot(name)
    if s >= MAX_APPS {
        return 0
    }
    return masks[s as usize]
}

fn grant(name: u64, bits: u64) -> u64 {
    return set_mask(name, get_mask(name) | bits)
}

fn revoke(name: u64, bits: u64) -> u64 {
    return set_mask(name, get_mask(name) & (P_ALL - (bits & P_ALL)))
}

// The one question the kernel asks. true = go ahead.
fn label_allows(label: u64, bit: u64) -> bool {
    let app: u64 = label_app(label)
    if app == 0 {
        return true
    }
    return (get_mask(app) & bit) != 0
}

fn reset() {
    var s: u64 = 0
    while s < MAX_APPS {
        used[s as usize] = 0
        masks[s as usize] = 0
        ceils[s as usize] = 0
        ceilset[s as usize] = 0
        acct_clear(s)
        s = s + 1
    }
}

fn count() -> u64 {
    var n: u64 = 0
    var s: u64 = 0
    while s < MAX_APPS {
        if used[s as usize] != 0 {
            n = n + 1
        }
        s = s + 1
    }
    return n
}

// Right names <-> bits, for the CLI and the config file. Zero-terminated strings.
static mut r_mic: [u8; 4] = "mic\0"
static mut r_camera: [u8; 7] = "camera\0"
static mut r_net: [u8; 4] = "net\0"
static mut r_fs: [u8; 8] = "fs.home\0"
static mut r_notify: [u8; 7] = "notify\0"
static mut r_clipr: [u8; 15] = "clipboard.read\0"
static mut r_clipw: [u8; 16] = "clipboard.write\0"
static mut r_audio: [u8; 11] = "audio.play\0"
static mut r_loc: [u8; 9] = "location\0"
static mut r_con: [u8; 9] = "contacts\0"
static mut r_phone: [u8; 6] = "phone\0"
static mut r_float: [u8; 13] = "window.float\0"

fn eq(p: u64, q: u64) -> bool {
    var i: u64 = 0
    while i < 40 {
        let a: u64 = rd(p, i)
        if a != rd(q, i) {
            return false
        }
        if a == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn name_at(i: u64) -> u64 {
    if i == 0 {
        return (&r_mic[0]) as u64
    }
    if i == 1 {
        return (&r_camera[0]) as u64
    }
    if i == 2 {
        return (&r_net[0]) as u64
    }
    if i == 3 {
        return (&r_fs[0]) as u64
    }
    if i == 4 {
        return (&r_notify[0]) as u64
    }
    if i == 5 {
        return (&r_clipr[0]) as u64
    }
    if i == 6 {
        return (&r_clipw[0]) as u64
    }
    if i == 7 {
        return (&r_audio[0]) as u64
    }
    if i == 8 {
        return (&r_loc[0]) as u64
    }
    if i == 9 {
        return (&r_con[0]) as u64
    }
    if i == 10 {
        return (&r_phone[0]) as u64
    }
    if i == 11 {
        return (&r_float[0]) as u64
    }
    return 0
}

// 0 = unknown name
fn bit_of(name: u64) -> u64 {
    var i: u64 = 0
    while i < 12 {
        if eq(name, name_at(i)) {
            return 1 << i
        }
        i = i + 1
    }
    return 0
}

// Pointer to the name of a single bit (0 if not exactly one right bit).
fn name_of_bit(bit: u64) -> u64 {
    var i: u64 = 0
    while i < 12 {
        if bit == (1 << i) {
            return name_at(i)
        }
        i = i + 1
    }
    return 0
}
