export { absv, isqrt, sdiv, clamp }

fn absv(v: i64) -> i64 {
    if v < 0 { return 0 - v }
    return v
}

fn isqrt(v: i64) -> i64 {
    if v <= 0 { return 0 }
    var x: i64 = v
    var y: i64 = (x + 1) / 2
    while y < x {
        x = y
        y = (x + v / x) / 2
    }
    return x
}

fn sdiv(a: i64, b: i64) -> i64 {
    if a < 0 { return 0 - ((0 - a) / b) }
    return a / b
}

fn clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}
