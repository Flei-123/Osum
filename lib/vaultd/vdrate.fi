// SPDX-License-Identifier: MPL-2.0
export { Bucket, bucket_new, take, BURST, REFILL_TICKS }

const BURST: u64 = 10
const REFILL_TICKS: u64 = 600

struct Bucket {
    tokens: u64,
    last: u64,
}

fn bucket_new(now: u64) -> Bucket {
    return Bucket { tokens: BURST, last: now }
}

fn take(b: *mut Bucket, now: u64) -> bool {
    if now > (*b).last {
        let gained: u64 = (now - (*b).last) / REFILL_TICKS
        if gained > 0 {
            var t: u64 = (*b).tokens + gained
            if t > BURST {
                t = BURST
            }
            (*b).tokens = t
            (*b).last = (*b).last + gained * REFILL_TICKS
        }
    } else {
        (*b).last = now
    }
    if (*b).tokens == 0 {
        return false
    }
    (*b).tokens = (*b).tokens - 1
    return true
}
