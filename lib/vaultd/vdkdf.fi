import std.rt
import std.fs
import vault.vlayout
import vaultd.vdsess
import vaultd.vdwire

export { load, CONF_PATH }

const CONF_PATH: str = "/etc/vault/kdf"

fn load(path: str) -> vdsess.Kdf {
    var k: vdsess.Kdf = vdsess.kdf_default()
    var raw: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file(path, &raw) catch 0
    if got > 0 {
        let txt: str = rt.buf_str(&raw)
        let kib: usize = vdwire.num_get(txt, "kib", 0) as usize
        let passes: usize = vdwire.num_get(txt, "passes", 0) as usize
        let lanes: usize = vdwire.num_get(txt, "lanes", 0) as usize
        if vlayout.kdf_params_ok(passes, lanes, kib) {
            k = vdsess.Kdf { kib: kib, passes: passes, lanes: lanes }
        }
    }
    rt.buf_free(&raw)
    return k
}
