import std.rt
import std.cborread
import vault.vrecord
import vault.vcodes
import vaultd.vdsess
import vaultd.vdwire

export { ok, fail, fail_rc, fail_store, code_name, store_code, field_hex, id_hex, REPLY_SOFT_MAX }

const REPLY_SOFT_MAX: usize = 1200

fn ok(out: *mut rt.Buf) {
    vdwire.put_kv(out, "ok", "1")
}

fn fail(out: *mut rt.Buf, code: str) {
    rt.buf_clear(out)
    vdwire.put_kv(out, "ok", "0")
    vdwire.put_kv(out, "err", code)
}

fn code_name(rc: i32) -> str {
    if rc == vdsess.R_WAIT {
        return "wait"
    }
    if rc == vdsess.R_BAD {
        return "bad"
    }
    if rc == vdsess.R_DAMAGED {
        return "damaged"
    }
    if rc == vdsess.R_NONE {
        return "none"
    }
    if rc == vdsess.R_ROLLBACK {
        return "rollback"
    }
    if rc == vdsess.R_IO {
        return "io"
    }
    if rc == vdsess.R_EXISTS {
        return "exists"
    }
    if rc == vdsess.R_SHORT {
        return "short"
    }
    if rc == vdsess.R_LOCKED {
        return "locked"
    }
    return "arg"
}

fn fail_rc(out: *mut rt.Buf, rc: i32, wait: u64) {
    fail(out, code_name(rc))
    if rc == vdsess.R_WAIT {
        vdwire.put_num(out, "wait", wait)
    }
}

fn store_code(rc: i32) -> str {
    if rc == vcodes.VR_E_DUP {
        return "dup"
    }
    if rc == vcodes.VR_E_SCHEMA {
        return "schema"
    }
    if rc == vcodes.VR_E_NEWER {
        return "newer"
    }
    if rc == vcodes.VR_E_LIMIT {
        return "limit"
    }
    if rc == vcodes.VR_E_NOTFOUND {
        return "notfound"
    }
    return "store"
}

fn fail_store(out: *mut rt.Buf, rc: i32) {
    fail(out, store_code(rc))
}

fn field_hex(out: *mut rt.Buf, p: u64, n: usize, pos: usize, key: u64, cap: usize) {
    var it: cborread.Item = cborread.item_zero()
    if vrecord.field(p, n, pos, key, &it) && it.kind == cborread.K_TEXT {
        var l: usize = it.len
        if l > cap {
            l = cap
        }
        vdwire.put_hex(out, it.ptr, l)
    }
}

fn id_hex(out: *mut rt.Buf, p: u64, n: usize, pos: usize) {
    let ip: u64 = vrecord.id_ptr(p, n, pos)
    if ip != 0 {
        vdwire.put_hex(out, ip, vrecord.ID_LEN)
    }
}
