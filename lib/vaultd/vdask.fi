import std.rt
import std.cborread
import vault.vrecord

export { ANSWER_ALLOW, ANSWER_DENY, ANSWER_TIMEOUT, ANSWER_NO_UI, TEXT_CAP, field_text, first_origin,
    deny_code }

const ANSWER_ALLOW: u64 = 1
const ANSWER_DENY: u64 = 0
const ANSWER_TIMEOUT: u64 = 2
const ANSWER_NO_UI: u64 = 3
const TEXT_CAP: usize = 100

fn push_clean(out: *mut rt.Buf, p: u64, n: usize) {
    var l: usize = n
    var cut: bool = false
    if l > TEXT_CAP {
        l = TEXT_CAP
        cut = true
    }
    var i: usize = 0
    while i < l {
        var c: u8 = rt.ld8(p, i) as u8
        if c < 32 as u8 || c == 127 as u8 {
            c = 63 as u8
        }
        rt.buf_push(out, c)
        i = i + 1
    }
    if cut {
        rt.buf_push(out, 46 as u8)
        rt.buf_push(out, 46 as u8)
        rt.buf_push(out, 46 as u8)
    }
}

fn field_text(p: u64, n: usize, pos: usize, key: u64, out: *mut rt.Buf) {
    var it: cborread.Item = cborread.item_zero()
    if vrecord.field(p, n, pos, key, &it) && it.kind == cborread.K_TEXT {
        push_clean(out, it.ptr, it.len)
    }
}

fn first_origin(p: u64, n: usize, pos: usize, out: *mut rt.Buf) {
    var o: cborread.Item = cborread.item_zero()
    if vrecord.field(p, n, pos, vrecord.K_ORIGINS, &o) && o.kind == cborread.K_ARRAY && o.val > 0 {
        var e: cborread.Item = cborread.item_zero()
        if cborread.read_head(p, n, o.end, 0, &e) == cborread.CB_OK && e.kind == cborread.K_TEXT {
            push_clean(out, e.ptr, e.len)
        }
    }
}

fn deny_code(answer: u64) -> str {
    if answer == ANSWER_TIMEOUT {
        return "timeout"
    }
    if answer == ANSWER_NO_UI {
        return "noprompt"
    }
    return "declined"
}
