// SPDX-License-Identifier: MPL-2.0
export { Hooks, hooks_default, PIN_OK, PIN_WRONG, PIN_LOCKED, PIN_NOPIN, PIN_DISABLED, PIN_ERR,
    PIN_FORMAT }

const PIN_OK: u64 = 0
const PIN_WRONG: u64 = 1
const PIN_LOCKED: u64 = 2
const PIN_NOPIN: u64 = 3
const PIN_DISABLED: u64 = 4
const PIN_ERR: u64 = 5
const PIN_FORMAT: u64 = 6

struct Hooks {
    tpm_exec: fn(u64, u64, u64, u64) -> u64,
    tpm_ready: bool,
    pin_check: fn(u64, u64, u64) -> u64,
}

fn no_tpm(cmd: u64, clen: u64, rsp: u64, rcap: u64) -> u64 {
    return 0
}

fn no_pin(name: u64, pin: u64, wait_out: u64) -> u64 {
    return PIN_NOPIN
}

fn hooks_default() -> Hooks {
    return Hooks { tpm_exec: no_tpm, tpm_ready: false, pin_check: no_pin }
}
