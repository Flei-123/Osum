import std.rt

export { CL_USER, CL_CERTUS, CL_OTHER, OP_STATUS, OP_CREATE, OP_UNLOCK, OP_LOCK, OP_LIST, OP_FIND,
    OP_PUT, OP_DELETE, OP_PASSWD, OP_RECOVERY, OP_REVEAL, OP_TPMENROLL, OP_TPMDROP, OP_UNKNOWN, lookup, class_ok, is_secret,
    class_of_origin }

const CL_USER: u64 = 1
const CL_CERTUS: u64 = 2
const CL_OTHER: u64 = 3

const OP_UNKNOWN: u64 = 0
const OP_STATUS: u64 = 1
const OP_CREATE: u64 = 2
const OP_UNLOCK: u64 = 3
const OP_LOCK: u64 = 4
const OP_LIST: u64 = 5
const OP_FIND: u64 = 6
const OP_PUT: u64 = 7
const OP_DELETE: u64 = 8
const OP_PASSWD: u64 = 9
const OP_RECOVERY: u64 = 10
const OP_REVEAL: u64 = 11
const OP_TPMENROLL: u64 = 12
const OP_TPMDROP: u64 = 13

const M_USER: u64 = 1
const M_CERTUS: u64 = 2
const M_OTHER: u64 = 4

struct Row {
    name: str,
    op: u64,
    mask: u64,
    secret: bool,
}

fn rows() -> [Row; 13] {
    return [
        Row { name: "status", op: OP_STATUS, mask: 7, secret: false },
        Row { name: "create", op: OP_CREATE, mask: M_USER, secret: true },
        Row { name: "unlock", op: OP_UNLOCK, mask: M_USER, secret: true },
        Row { name: "lock", op: OP_LOCK, mask: M_USER, secret: false },
        Row { name: "list", op: OP_LIST, mask: M_USER | M_CERTUS, secret: false },
        Row { name: "find", op: OP_FIND, mask: M_USER | M_CERTUS, secret: true },
        Row { name: "put", op: OP_PUT, mask: M_USER | M_CERTUS, secret: true },
        Row { name: "delete", op: OP_DELETE, mask: M_USER, secret: true },
        Row { name: "passwd", op: OP_PASSWD, mask: M_USER, secret: true },
        Row { name: "recovery", op: OP_RECOVERY, mask: M_USER, secret: true },
        Row { name: "reveal", op: OP_REVEAL, mask: M_USER, secret: true },
        Row { name: "tpmenroll", op: OP_TPMENROLL, mask: M_USER, secret: true },
        Row { name: "tpmdrop", op: OP_TPMDROP, mask: M_USER, secret: true }
    ]
}

fn lookup(name: str) -> u64 {
    let t: [Row; 13] = rows()
    var i: usize = 0
    while i < 13 {
        if t[i].name == name {
            return t[i].op
        }
        i = i + 1
    }
    return OP_UNKNOWN
}

fn class_bit(class: u64) -> u64 {
    if class == CL_USER {
        return M_USER
    }
    if class == CL_CERTUS {
        return M_CERTUS
    }
    return M_OTHER
}

fn class_ok(op: u64, class: u64) -> bool {
    let t: [Row; 13] = rows()
    var i: usize = 0
    while i < 13 {
        if t[i].op == op {
            return (t[i].mask & class_bit(class)) != 0
        }
        i = i + 1
    }
    return false
}

fn is_secret(op: u64) -> bool {
    let t: [Row; 13] = rows()
    var i: usize = 0
    while i < 13 {
        if t[i].op == op {
            return t[i].secret
        }
        i = i + 1
    }
    return true
}

fn class_of_origin(label: str) -> u64 {
    if label.n == 0 {
        return CL_USER
    }
    if label == "app:certus" {
        return CL_CERTUS
    }
    return CL_OTHER
}
