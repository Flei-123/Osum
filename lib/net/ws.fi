// SPDX-License-Identifier: GPL-2.0-only
// lib/net/ws.fi -- WebSocket client framing (RFC 6455), no I/O.
//
// WHAT THIS IS. The wire format of a WebSocket CLIENT, as a pure state
// machine over byte buffers. It never opens a socket, never reads, never
// writes: the caller moves the octets (TCP socket, TLS stream, a test
// buffer). The same file runs in a ring-3 program on OrientOS, in a host
// test against Python's `websockets`, and later behind TLS, unchanged.
//
// RULES OF THIS FILE (same as lib/crypto/sha1.fi): no `profile` line, no
// allocator, no system call. All memory belongs to the caller.
//
// WHAT IT CAN
//   * HTTP upgrade request (`build_request`) and the check of the answer
//     (`check_response`: status 101, Upgrade, Connection, and the
//     Sec-WebSocket-Accept value = base64(SHA-1(key + GUID)))
//   * masked client frames (`encode`): text/binary/continuation/ping/pong/
//     close, payload lengths 7 / 16 / 64 bit
//   * incremental receive (`feed` + `take`): frame header split over any
//     number of reads, payload streamed straight into the message buffer,
//     fragmentation (continuation frames) reassembled, control frames
//     (ping/pong/close) may be interleaved between fragments
// WHAT IT DOES NOT: extensions (permessage-deflate is never offered, so a
// conforming server never uses it), subprotocols, UTF-8 validation.
//
// HOW TO RECEIVE
//     var w: Ws = ws.ws_new()
//     ws.init(&w, msgbuf, msgcap)
//     off = <octets of the HTTP header, from check_response>
//     while off < n {
//         off = off + ws.feed(&w, buf + off, n - off)
//         ev = ws.event(&w)           // 0 = nothing yet
//         if ev != 0 { use ws.msg_ptr(&w), ws.msg_len(&w); ws.take(&w) }
//     }
// `feed` stops after one finished message, so ONE event is pending at a
// time and the caller must `take` it before feeding more.

import std.crypto.sha1

export { Ws, ws_new, init, build_request, check_response, encode, feed,
    event, take, msg_ptr, msg_len, failed, b64_encode, accept_key,
    EV_NONE, EV_TEXT, EV_BINARY, EV_CLOSE, EV_PING, EV_PONG, EV_ERROR,
    OP_CONT, OP_TEXT, OP_BINARY, OP_CLOSE, OP_PING, OP_PONG }

const OP_CONT: u64 = 0
const OP_TEXT: u64 = 1
const OP_BINARY: u64 = 2
const OP_CLOSE: u64 = 8
const OP_PING: u64 = 9
const OP_PONG: u64 = 10

const EV_NONE: u64 = 0
const EV_TEXT: u64 = 1
const EV_BINARY: u64 = 2
const EV_CLOSE: u64 = 8
const EV_PING: u64 = 9
const EV_PONG: u64 = 10
const EV_ERROR: u64 = 255

const BAD: u64 = 0xFFFFFFFFFFFFFFFF

// parser states
const S_HDR: u64 = 0 // collecting the 2..14 header octets
const S_BODY: u64 = 1 // streaming the payload
const S_DONE: u64 = 2 // an event is pending
const S_FAIL: u64 = 3 // protocol error or buffer too small

struct Ws {
    msg: u64, // message buffer (caller memory)
    cap: u64,
    mlen: u64, // octets of the message so far
    mop: u64, // opcode of the message being assembled (1 or 2), 0 = none
    ctl: [u8; 128], // payload of a control frame
    clen: u64,
    hdr: [u8; 16],
    hlen: u64,
    state: u64,
    fop: u64, // opcode of the current frame
    ffin: bool,
    fmask: bool,
    mkey: [u8; 4],
    plen: u64, // payload length of the current frame
    pgot: u64,
    ev: u64, // pending event
}

fn ws_new() -> Ws {
    return Ws { msg: 0, cap: 0, mlen: 0, mop: 0, ctl: [0 as u8; 128], clen: 0,
        hdr: [0 as u8; 16], hlen: 0, state: 0, fop: 0, ffin: false,
        fmask: false, mkey: [0 as u8; 4], plen: 0, pgot: 0, ev: 0 }
}

fn init(w: *mut Ws, msg: u64, cap: u64) {
    (*w).msg = msg
    (*w).cap = cap
    (*w).mlen = 0
    (*w).mop = 0
    (*w).clen = 0
    (*w).hlen = 0
    (*w).state = S_HDR
    (*w).ev = EV_NONE
}

fn ld8(p: u64, i: u64) -> u64 {
    return (*((p + i) as *mut u8)) as u64
}

fn st8(p: u64, i: u64, v: u64) {
    *((p + i) as *mut u8) = (v & 255) as u8
}

// ------------------------------------------------------------- base64

static mut B64: [u8; 65] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\0"

fn b64_at(v: u64) -> u64 {
    return B64[(v & 63) as usize] as u64
}

// Standard base64 with padding. Writes ceil(n/3)*4 octets, returns that.
fn b64_encode(src: u64, n: u64, dst: u64) -> u64 {
    var i: u64 = 0
    var o: u64 = 0
    while i + 3 <= n {
        let v: u64 = (ld8(src, i) << 16) | (ld8(src, i + 1) << 8) | ld8(src, i + 2)
        st8(dst, o, b64_at(v >> 18))
        st8(dst, o + 1, b64_at(v >> 12))
        st8(dst, o + 2, b64_at(v >> 6))
        st8(dst, o + 3, b64_at(v))
        i = i + 3
        o = o + 4
    }
    let rest: u64 = n - i
    if rest == 1 {
        let v1: u64 = ld8(src, i) << 16
        st8(dst, o, b64_at(v1 >> 18))
        st8(dst, o + 1, b64_at(v1 >> 12))
        st8(dst, o + 2, 61)
        st8(dst, o + 3, 61)
        o = o + 4
    } else if rest == 2 {
        let v2: u64 = (ld8(src, i) << 16) | (ld8(src, i + 1) << 8)
        st8(dst, o, b64_at(v2 >> 18))
        st8(dst, o + 1, b64_at(v2 >> 12))
        st8(dst, o + 2, b64_at(v2 >> 6))
        st8(dst, o + 3, 61)
        o = o + 4
    }
    return o
}

static mut GUID: [u8; 37] = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11\0"

// base64(SHA-1(key || GUID)) for the 24 octets of a Sec-WebSocket-Key at
// `key`; 28 octets are written to `out`.
fn accept_key(key: u64, out: u64) {
    var buf: [u8; 64] = [0 as u8; 64]
    var i: u64 = 0
    while i < 24 {
        buf[i as usize] = ld8(key, i) as u8
        i = i + 1
    }
    while i < 60 {
        buf[i as usize] = GUID[(i - 24) as usize]
        i = i + 1
    }
    var d: [u8; 20] = [0 as u8; 20]
    sha1.sha1((&buf[0]) as u64, 60, (&d[0]) as u64)
    let _n: u64 = b64_encode((&d[0]) as u64, 20, out)
}

// ----------------------------------------------------------- handshake

fn put_str(out: u64, o: u64, cap: u64, s: u64, n: u64) -> u64 {
    if o > cap || o + n > cap {
        return cap + 1
    }
    var i: u64 = 0
    while i < n {
        st8(out, o + i, ld8(s, i))
        i = i + 1
    }
    return o + n
}

static mut H_GET: [u8; 5] = "GET \0"
static mut H_V: [u8; 18] = " HTTP/1.1\r\nHost: \0"
static mut H_UP: [u8; 69] = "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\0"
static mut H_KEY: [u8; 22] = "\r\nSec-WebSocket-Key: \0"
static mut H_END: [u8; 5] = "\r\n\r\n\0"

// Builds the upgrade request. `host`/`path` are not NUL-terminated, `key`
// is the 24-octet base64 Sec-WebSocket-Key (16 random octets, base64'd by
// the caller via b64_encode). Returns the length, 0 if `cap` is too small.
fn build_request(out: u64, cap: u64, host: u64, hlen: u64, path: u64,
    plen: u64, key: u64) -> u64 {
    var o: u64 = 0
    o = put_str(out, o, cap, (&H_GET[0]) as u64, 4)
    o = put_str(out, o, cap, path, plen)
    o = put_str(out, o, cap, (&H_V[0]) as u64, 17)
    o = put_str(out, o, cap, host, hlen)
    o = put_str(out, o, cap, (&H_UP[0]) as u64, 68)
    o = put_str(out, o, cap, (&H_KEY[0]) as u64, 21)
    o = put_str(out, o, cap, key, 24)
    o = put_str(out, o, cap, (&H_END[0]) as u64, 4)
    if o > cap {
        return 0
    }
    return o
}

fn lower(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

// Case-insensitive: does `s` (n octets) occur at offset `at` of p[0..avail]?
fn at_ci(p: u64, avail: u64, at: u64, s: u64, n: u64) -> bool {
    if at + n > avail {
        return false
    }
    var i: u64 = 0
    while i < n {
        if lower(ld8(p, at + i)) != lower(ld8(s, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

static mut R_101: [u8; 13] = "HTTP/1.1 101\0"
static mut R_UP: [u8; 19] = "upgrade: websocket\0"
static mut R_CN: [u8; 20] = "connection: upgrade\0"
static mut R_AC: [u8; 23] = "sec-websocket-accept: \0"

// Checks the server's answer to the upgrade request.
//   > 0   complete and valid; the value is the header length, any octets
//         after it are already WebSocket frames
//   0     header not complete yet (read more)
//   BAD   invalid -- test with failed()
fn check_response(p: u64, n: u64, key: u64) -> u64 {
    var end: u64 = 0
    var i: u64 = 0
    while i + 4 <= n {
        if ld8(p, i) == 13 && ld8(p, i + 1) == 10 && ld8(p, i + 2) == 13 && ld8(p, i + 3) == 10 {
            end = i + 4
            i = n
        } else {
            i = i + 1
        }
    }
    if end == 0 {
        if n > 8192 {
            return BAD
        }
        return 0
    }
    if !at_ci(p, end, 0, (&R_101[0]) as u64, 12) {
        return BAD
    }
    var acc: [u8; 28] = [0 as u8; 28]
    accept_key(key, (&acc[0]) as u64)
    var up: bool = false
    var cn: bool = false
    var ac: bool = false
    var l: u64 = 0
    while l < end {
        var e: u64 = l
        while e + 1 < end && !(ld8(p, e) == 13 && ld8(p, e + 1) == 10) {
            e = e + 1
        }
        if at_ci(p, e, l, (&R_UP[0]) as u64, 18) {
            up = true
        }
        if at_ci(p, e, l, (&R_CN[0]) as u64, 19) {
            cn = true
        }
        if at_ci(p, e, l, (&R_AC[0]) as u64, 22) {
            // the 28 octets after "...accept: " must equal the computed key
            var same: bool = true
            var k: u64 = 0
            while k < 28 {
                if l + 22 + k >= e || ld8(p, l + 22 + k) != (acc[k as usize] as u64) {
                    same = false
                }
                k = k + 1
            }
            ac = same
        }
        l = e + 2
    }
    if up && cn && ac {
        return end
    }
    return BAD
}

fn failed(r: u64) -> bool {
    return r == BAD
}

// --------------------------------------------------------------- encode

// Encodes ONE masked client frame into `out`. `fin` false starts/continues
// a fragmented message (the first frame carries the real opcode, later
// ones OP_CONT). `mask` = 4 random octets (low 32 bits). Returns the frame
// length; 0 if `cap` is too small or a control frame is fragmented/over
// 125 octets.
fn encode(op: u64, fin: bool, payload: u64, n: u64, mask: u64, out: u64,
    cap: u64) -> u64 {
    if op >= 8 && (n > 125 || !fin) {
        return 0
    }
    var h: u64 = 2
    if n >= 65536 {
        h = 10
    } else if n >= 126 {
        h = 4
    }
    if h + 4 + n > cap {
        return 0
    }
    var b0: u64 = op & 15
    if fin {
        b0 = b0 | 128
    }
    st8(out, 0, b0)
    if n < 126 {
        st8(out, 1, 128 | n)
    } else if n < 65536 {
        st8(out, 1, 128 | 126)
        st8(out, 2, n >> 8)
        st8(out, 3, n)
    } else {
        st8(out, 1, 128 | 127)
        var s: u64 = 0
        while s < 8 {
            st8(out, 2 + s, n >> (56 - s * 8))
            s = s + 1
        }
    }
    var m: u64 = 0
    while m < 4 {
        st8(out, h + m, mask >> (24 - m * 8))
        m = m + 1
    }
    var i: u64 = 0
    while i < n {
        st8(out, h + 4 + i, ld8(payload, i) ^ ld8(out, h + (i & 3)))
        i = i + 1
    }
    return h + 4 + n
}

// -------------------------------------------------------------- receive

fn fail(w: *mut Ws) {
    (*w).state = S_FAIL
}

// Header length implied by the first two octets (0 while unknown).
fn hdr_need(w: *mut Ws) -> u64 {
    if (*w).hlen < 2 {
        return 0
    }
    let b1: u64 = (*w).hdr[1] as u64
    var ext: u64 = 0
    let l7: u64 = b1 & 127
    if l7 == 126 {
        ext = 2
    } else if l7 == 127 {
        ext = 8
    }
    var m: u64 = 0
    if (b1 & 128) != 0 {
        m = 4
    }
    return 2 + ext + m
}

// Header complete: set up the payload phase. Returns false on error.
fn hdr_done(w: *mut Ws) -> bool {
    let b0: u64 = (*w).hdr[0] as u64
    let b1: u64 = (*w).hdr[1] as u64
    if (b0 & 0x70) != 0 {
        return false // RSV bits: no extension was negotiated
    }
    (*w).ffin = (b0 & 128) != 0
    (*w).fop = b0 & 15
    (*w).fmask = (b1 & 128) != 0
    let l7: u64 = b1 & 127
    var at: u64 = 2
    var len: u64 = l7
    if l7 == 126 {
        len = (((*w).hdr[2] as u64) << 8) | ((*w).hdr[3] as u64)
        at = 4
    } else if l7 == 127 {
        len = 0
        var i: u64 = 0
        while i < 8 {
            len = (len << 8) | ((*w).hdr[(2 + i) as usize] as u64)
            i = i + 1
        }
        at = 10
        if (len >> 63) != 0 {
            return false
        }
    }
    if (*w).fmask {
        var k: u64 = 0
        while k < 4 {
            (*w).mkey[k as usize] = (*w).hdr[(at + k) as usize]
            k = k + 1
        }
    }
    (*w).plen = len
    (*w).pgot = 0
    let op: u64 = (*w).fop
    if op >= 8 {
        if len > 125 || !(*w).ffin {
            return false
        }
        if op != OP_CLOSE && op != OP_PING && op != OP_PONG {
            return false
        }
        (*w).clen = 0
    } else if op == OP_CONT {
        if (*w).mop == 0 {
            return false
        }
    } else if op == OP_TEXT || op == OP_BINARY {
        if (*w).mop != 0 {
            return false // a new message while one is still open
        }
        (*w).mop = op
        (*w).mlen = 0
    } else {
        return false
    }
    if len == 0 {
        finish_frame(w)
    } else {
        (*w).state = S_BODY
    }
    return true
}

// A frame's payload is complete.
fn finish_frame(w: *mut Ws) {
    let op: u64 = (*w).fop
    (*w).hlen = 0
    if op >= 8 {
        (*w).ev = op
        (*w).state = S_DONE
        return
    }
    if (*w).ffin {
        (*w).ev = (*w).mop
        (*w).mop = 0
        (*w).state = S_DONE
        return
    }
    (*w).state = S_HDR
}

// Feeds up to n octets; returns how many were consumed. Stops right after
// a finished message / control frame (see `event`). A protocol error or a
// message that does not fit the buffer sets the failed state.
fn feed(w: *mut Ws, p: u64, n: u64) -> u64 {
    var used: u64 = 0
    while used < n && (*w).state != S_DONE && (*w).state != S_FAIL {
        if (*w).state == S_HDR {
            (*w).hdr[(*w).hlen as usize] = ld8(p, used) as u8
            (*w).hlen = (*w).hlen + 1
            used = used + 1
            let need: u64 = hdr_need(w)
            if need != 0 && (*w).hlen >= need {
                if !hdr_done(w) {
                    fail(w)
                }
            }
        } else {
            // S_BODY: copy what is there in one go
            var take_n: u64 = (*w).plen - (*w).pgot
            if take_n > n - used {
                take_n = n - used
            }
            let op: u64 = (*w).fop
            var dst: u64 = 0
            var room: u64 = 0
            if op >= 8 {
                dst = ((&(*w).ctl[0]) as u64) + (*w).clen
                room = 128 - (*w).clen
            } else {
                dst = (*w).msg + (*w).mlen
                room = (*w).cap - (*w).mlen
            }
            if take_n > room {
                fail(w)
                return used
            }
            var i: u64 = 0
            var mk: u64 = (*w).pgot
            while i < take_n {
                var b: u64 = ld8(p, used + i)
                if (*w).fmask {
                    b = b ^ ((*w).mkey[(mk & 3) as usize] as u64)
                    mk = mk + 1
                }
                st8(dst, i, b)
                i = i + 1
            }
            if op >= 8 {
                (*w).clen = (*w).clen + take_n
            } else {
                (*w).mlen = (*w).mlen + take_n
            }
            (*w).pgot = (*w).pgot + take_n
            used = used + take_n
            if (*w).pgot == (*w).plen {
                finish_frame(w)
            }
        }
    }
    return used
}

// The pending event (EV_*), EV_NONE if none, EV_ERROR after a protocol
// error (the connection must be dropped).
fn event(w: *mut Ws) -> u64 {
    if (*w).state == S_FAIL {
        return EV_ERROR
    }
    return (*w).ev
}

// Pointer/length of the pending event's payload: the control buffer for
// ping/pong/close, else the reassembled message.
fn msg_ptr(w: *mut Ws) -> u64 {
    if (*w).ev >= 8 {
        return (&(*w).ctl[0]) as u64
    }
    return (*w).msg
}

fn msg_len(w: *mut Ws) -> u64 {
    if (*w).ev >= 8 {
        return (*w).clen
    }
    return (*w).mlen
}

// Acknowledges the pending event; the next `feed` continues.
fn take(w: *mut Ws) {
    if (*w).state == S_DONE {
        (*w).state = S_HDR
        (*w).ev = EV_NONE
        (*w).hlen = 0
        if (*w).mop == 0 {
            (*w).mlen = 0
        }
    }
}
