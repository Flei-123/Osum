import std.rt

export { fnv64, band_hash, BANDS }

const FNV_OFFSET: u64 = 14695981039346656037
const FNV_PRIME: u64 = 1099511628211
const WORD: usize = 8

fn fnv64(p: u64, n: usize) -> u64 {
    var h: u64 = FNV_OFFSET
    var i: usize = 0
    while i + WORD <= n {
        h = (h ^ *((p + i as u64) as *mut u64)) *% FNV_PRIME
        i = i + WORD
    }
    while i < n {
        h = (h ^ (rt.ld8(p, i) as u64)) *% FNV_PRIME
        i = i + 1
    }
    return h
}

const BANDS: usize = 16

fn band_hash(p: u64, n: usize, band: usize) -> u64 {
    let size: usize = n / BANDS
    return fnv64(p + (band * size) as u64, size)
}
