import std.rt

export { push, parse_hash, TAG_JPEG, TAG_SAME, LEN }

const DIGITS: usize = 20
const LEN: usize = DIGITS + 2
const TAG_JPEG: u8 = 74
const TAG_SAME: u8 = 83
const NEWLINE: u8 = 10
const ASCII_ZERO: u8 = 48
const DECIMAL_BASE: u64 = 10

fn push(out: *mut rt.Buf, tag: u8, hash: u64) {
    var digits: [u8; 20] = [ASCII_ZERO; 20]
    var rest: u64 = hash
    var k: usize = DIGITS
    while k > 0 && rest > 0 {
        k = k - 1
        digits[k] = (ASCII_ZERO as u64 + rest % DECIMAL_BASE) as u8
        rest = rest / DECIMAL_BASE
    }
    rt.buf_push(out, tag)
    rt.buf_push_bytes(out, (&digits[0]) as u64, DIGITS)
    rt.buf_push(out, NEWLINE)
}

fn parse_hash(p: u64, n: usize) -> u64 {
    var v: u64 = 0
    var i: usize = 1
    while i < n && i <= DIGITS {
        v = v * DECIMAL_BASE + (rt.ld8(p, i) as u64 - ASCII_ZERO as u64)
        i = i + 1
    }
    return v
}
