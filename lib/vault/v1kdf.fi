import std.rt
import std.crypto.hmac

export { pbkdf2_sha256 }

fn pbkdf2_sha256(pw: u64, plen: usize, salt: u64, slen: usize, iters: u64, out: u64) -> bool {
    if slen > 64 || iters == 0 as u64 {
        return false
    }
    var first: [u8; 68] = [0; 68]
    var u: [u8; 32] = [0; 32]
    var acc: [u8; 32] = [0; 32]
    var i: usize = 0
    while i < slen {
        first[i] = rt.ld8(salt, i)
        i = i + 1
    }
    first[slen + 3] = 1 as u8
    hmac.hmac_sha256(pw, plen, (&first[0]) as u64, slen + 4, (&u[0]) as u64)
    i = 0
    while i < 32 {
        acc[i] = u[i]
        i = i + 1
    }
    var r: u64 = 1
    while r < iters {
        hmac.hmac_sha256(pw, plen, (&u[0]) as u64, 32, (&u[0]) as u64)
        i = 0
        while i < 32 {
            acc[i] = acc[i] ^ u[i]
            i = i + 1
        }
        r = r + 1 as u64
    }
    rt.mem_copy(out, (&acc[0]) as u64, 32)
    rt.mem_set((&u[0]) as u64, 0 as u8, 32)
    rt.mem_set((&acc[0]) as u64, 0 as u8, 32)
    return true
}
