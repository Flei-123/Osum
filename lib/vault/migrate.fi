// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.fs
import vault.vlayout
import vault.vcodes
import vault.container
import vault.v1read
import vault.v1import

export { migrate_buffer, migrate_file }

fn same_bytes(a: *mut rt.Buf, b: *mut rt.Buf) -> bool {
    return rt.buf_len(a) == rt.buf_len(b)
        && rt.mem_eq(rt.buf_ptr(a), rt.buf_ptr(b), rt.buf_len(a))
}

fn wipe_free(b: *mut rt.Buf) {
    rt.mem_set(rt.buf_ptr(b), 0 as u8, rt.buf_len(b))
    rt.buf_free(b)
}

fn migrate_buffer(v1: u64, v1n: usize, pw: u64, pwn: usize, kib: usize, passes: usize,
    lanes: usize, now: u64, out: *mut rt.Buf, st: *mut v1import.Stats) -> i32 {
    var plain: rt.Buf = rt.buf_new()
    var rc: i32 = v1read.v1_open(pw, pwn, v1, v1n, &plain)
    if rc != vlayout.VC_OK {
        wipe_free(&plain)
        return rc
    }
    var store: rt.Buf = rt.buf_new()
    rc = v1import.import_plain(rt.buf_ptr(&plain), rt.buf_len(&plain), now, &store, st)
    wipe_free(&plain)
    if rc != vcodes.VR_OK {
        wipe_free(&store)
        return rc
    }
    rc = container.create(out, rt.buf_ptr(&store), rt.buf_len(&store), pw, pwn, kib,
        passes, lanes, vlayout.FLAG_PASSKEYS, 0)
    if rc != vlayout.VC_OK {
        wipe_free(&store)
        return rc
    }
    var check: rt.Buf = rt.buf_new()
    rc = container.open_pw(rt.buf_ptr(out), rt.buf_len(out), vlayout.SLOT_PW, pw, pwn,
        &check, 0)
    if rc == vlayout.VC_OK && !same_bytes(&check, &store) {
        rc = vlayout.VC_E_TAG
    }
    wipe_free(&check)
    wipe_free(&store)
    if rc != vlayout.VC_OK {
        rt.buf_free(out)
        (*out) = rt.buf_new()
    }
    return rc
}

fn migrate_file(v1_path: str, v2_path: str, pw: u64, pwn: usize, kib: usize,
    passes: usize, lanes: usize, now: u64, st: *mut v1import.Stats) -> i32 {
    var raw: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file(v1_path, &raw) catch 0
    if got == 0 {
        rt.buf_free(&raw)
        return vlayout.VC_E_IO
    }
    var img: rt.Buf = rt.buf_new()
    let rc: i32 = migrate_buffer(rt.buf_ptr(&raw), rt.buf_len(&raw), pw, pwn, kib,
        passes, lanes, now, &img, st)
    rt.buf_free(&raw)
    if rc != vlayout.VC_OK {
        rt.buf_free(&img)
        return rc
    }
    let src: i32 = container.file_save(v2_path, &img)
    rt.buf_free(&img)
    return src
}
