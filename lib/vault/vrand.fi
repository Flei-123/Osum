import std.rt
import std.crypto.random

export { fill, det_enable, det_disable, det_active }

static mut det_on: bool = false
static mut det_ascii: bool = false
static mut det_state: u64 = 0

fn det_enable(seed: u64, ascii: bool) {
    det_on = true
    det_ascii = ascii
    det_state = seed
    if seed == 0 {
        det_state = 88172645463325252
    }
}

fn det_disable() {
    det_on = false
    det_ascii = false
    det_state = 0
}

fn det_active() -> bool {
    return det_on
}

fn step() -> u64 {
    var x: u64 = det_state
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    det_state = x
    return x
}

fn fill(p: u64, n: usize) -> bool {
    if det_on {
        var i: usize = 0
        while i < n {
            let b: u64 = (step() >> 24) & 255
            if det_ascii {
                rt.st8(p, i, (97 + b % 26) as u8)
            } else {
                rt.st8(p, i, b as u8)
            }
            i = i + 1
        }
        return true
    }
    return random.random_bytes(p, n)
}
