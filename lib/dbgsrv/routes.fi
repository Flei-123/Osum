// SPDX-License-Identifier: GPL-2.0-only
export { route_find, route_count, names_ptr, names_len, target_ptr, target_len, line_span }

static mut NAMES: [u8; 126] = "/wlan\n/drivers\n/net\n/pci\n/usb\n/lspci\n/lspci/v\n/dmesg\n/klog\n/svclog\n/dbgsrvlog\n/wlanctl/status\n/wlanctl/dump\n/version\n/uptime\n\0"
static mut TARGETS: [u8; 263] = "F:/proc/wlan\nF:/proc/drivers\nF:/proc/net\nF:/proc/pci\nF:/proc/usb\nX:/bin/lspci\nX:/bin/lspci -v\nX:/bin/log -n 400\nF:/proc/klog\nF:/var/log/jarvisd.log\nF:/var/log/dbgsrv.log\nX:/bin/wlanctl status\nX:/bin/wlanctl dump>/tmp/wlan-dump.txt\nF:/proc/version\nF:/proc/uptime\n\0"

fn ld8(p: u64, i: u64) -> u64 {
    return (*((p + i) as *mut u8)) as u64
}

fn names_ptr() -> u64 {
    return (&NAMES[0 as usize]) as u64
}

fn names_len() -> u64 {
    return 125
}

fn target_ptr() -> u64 {
    return (&TARGETS[0 as usize]) as u64
}

fn target_len() -> u64 {
    return 262
}

fn route_count() -> u64 {
    return 15
}

fn line_span(table: u64, total: u64, idx: u64) -> u64 {
    var i: u64 = 0
    var line: u64 = 0
    var start: u64 = 0
    while i < total {
        if ld8(table, i) == 10 {
            if line == idx {
                return (start << 32) | (i - start)
            }
            line = line + 1
            start = i + 1
        }
        i = i + 1
    }
    return 0
}

fn route_find(path: u64, plen: u64) -> u64 {
    var idx: u64 = 0
    while idx < route_count() {
        let s: u64 = line_span(names_ptr(), names_len(), idx)
        if (s & 0xFFFFFFFF) == plen {
            var k: u64 = 0
            var same: bool = true
            while k < plen {
                if ld8(names_ptr(), (s >> 32) + k) != ld8(path, k) {
                    same = false
                }
                k = k + 1
            }
            if same {
                return idx + 1
            }
        }
        idx = idx + 1
    }
    return 0
}
