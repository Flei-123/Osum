export { private_ip, peer_allowed }

fn octet(a: u64, i: u64) -> u64 {
    return (a >> ((3 - i) * 8)) & 0xFF
}

fn private_ip(a: u64) -> bool {
    if (a >> 32) != 0 {
        return false
    }
    let o0: u64 = octet(a, 0)
    let o1: u64 = octet(a, 1)
    if o0 == 10 {
        return true
    }
    if o0 == 172 && o1 >= 16 && o1 <= 31 {
        return true
    }
    if o0 == 192 && o1 == 168 {
        return true
    }
    if o0 == 169 && o1 == 254 {
        return true
    }
    if o0 == 127 {
        return true
    }
    return false
}

fn peer_allowed(a: u64, force_public: bool) -> bool {
    if force_public {
        return false
    }
    return private_ip(a)
}
