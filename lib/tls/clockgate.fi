import ntp.abi

export { now_trusted, now_raw }

const SYS_CLOCK_GETTIME: i64 = 228
const CLOCK_REALTIME: i64 = 0

fn now_trusted() -> u64 {
    var ts: [i64; 2] = [0; 2]
    let r: i64 = syscall(SYS_CLOCK_GETTIME, abi.CLOCK_CHECKED as i64, (&ts[0]) as i64, 0, 0, 0, 0)
    if r < 0 {
        return 0
    }
    return ts[0] as u64
}

fn now_raw() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(SYS_CLOCK_GETTIME, CLOCK_REALTIME, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] as u64
}
