// SPDX-License-Identifier: GPL-2.0-only
export {
    MAGIC, HEADER_BYTES, RECORD_BYTES,
    T_DOWN, T_MOVE, T_UP, T_GESTURE,
    D_TOUCHSCREEN, D_TOUCHPAD, D_PEN,
    F_PALM, F_BARREL, F_ERASER, F_HOVER,
    G_TAP, G_LONG, G_DRAG_BEGIN, G_DRAG, G_DRAG_END, G_SCROLL, G_PINCH, G_SWIPE,
    SLOT_NONE,
    put_header, put_record, magic_ok, snapshot_bytes,
    header_count, header_dropped, header_seq,
    get_type, get_slot, get_device, get_flags,
    get_x_norm, get_y_norm, get_x_px, get_y_px,
    get_pressure, get_size, get_time, get_a, get_b
}

const MAGIC: u64 = 0x31564554
const HEADER_BYTES: u64 = 16
const RECORD_BYTES: u64 = 24

const T_DOWN: u64 = 1
const T_MOVE: u64 = 2
const T_UP: u64 = 3
const T_GESTURE: u64 = 4

const D_TOUCHSCREEN: u64 = 1
const D_TOUCHPAD: u64 = 2
const D_PEN: u64 = 3

const F_PALM: u64 = 1
const F_BARREL: u64 = 2
const F_ERASER: u64 = 4
const F_HOVER: u64 = 8

const G_TAP: u64 = 1
const G_LONG: u64 = 2
const G_DRAG_BEGIN: u64 = 3
const G_DRAG: u64 = 4
const G_DRAG_END: u64 = 5
const G_SCROLL: u64 = 6
const G_PINCH: u64 = 7
const G_SWIPE: u64 = 8

const SLOT_NONE: u64 = 0xFF

const O_TYPE: u64 = 0
const O_SLOT: u64 = 1
const O_DEVICE: u64 = 2
const O_FLAGS: u64 = 3
const O_XN: u64 = 4
const O_YN: u64 = 6
const O_XP: u64 = 8
const O_YP: u64 = 10
const O_PRESSURE: u64 = 12
const O_SIZE: u64 = 14
const O_TIME: u64 = 16
const O_A: u64 = 20
const O_B: u64 = 22

const H_COUNT: u64 = 4
const H_DROPPED: u64 = 8
const H_SEQ: u64 = 12

fn st8(p: u64, o: u64, v: u64) { *((p + o) as *mut u8) = (v & 255) as u8 }

fn ld8(p: u64, o: u64) -> u64 {
    let b: u8 = *((p + o) as *mut u8)
    return b as u64
}

fn st16(p: u64, o: u64, v: u64) {
    st8(p, o, v)
    st8(p, o + 1, v >> 8)
}

fn ld16(p: u64, o: u64) -> u64 {
    return ld8(p, o) | (ld8(p, o + 1) << 8)
}

fn st32(p: u64, o: u64, v: u64) {
    st16(p, o, v)
    st16(p, o + 2, v >> 16)
}

fn ld32(p: u64, o: u64) -> u64 {
    return ld16(p, o) | (ld16(p, o + 2) << 16)
}

fn rec(buf: u64, idx: u64) -> u64 {
    return buf + HEADER_BYTES + idx * RECORD_BYTES
}

fn sext16(v: u64) -> i64 {
    if v >= 0x8000 { return (v as i64) - 0x10000 }
    return v as i64
}

fn snapshot_bytes(count: u64) -> u64 {
    return HEADER_BYTES + count * RECORD_BYTES
}

fn put_header(buf: u64, count: u64, dropped: u64, seq: u64) {
    st32(buf, 0, MAGIC)
    st32(buf, H_COUNT, count)
    st32(buf, H_DROPPED, dropped)
    st32(buf, H_SEQ, seq)
}

fn magic_ok(buf: u64) -> bool {
    return ld32(buf, 0) == MAGIC
}

fn header_count(buf: u64) -> u64 { return ld32(buf, H_COUNT) }
fn header_dropped(buf: u64) -> u64 { return ld32(buf, H_DROPPED) }
fn header_seq(buf: u64) -> u64 { return ld32(buf, H_SEQ) }

fn put_record(buf: u64, idx: u64, type_: u64, slot: u64, device: u64, flags: u64,
              xn: u64, yn: u64, xp: u64, yp: u64, pressure: u64, size: u64,
              time_ms: u64, a: i64, b: i64) {
    let r: u64 = rec(buf, idx)
    st8(r, O_TYPE, type_)
    st8(r, O_SLOT, slot)
    st8(r, O_DEVICE, device)
    st8(r, O_FLAGS, flags)
    st16(r, O_XN, xn)
    st16(r, O_YN, yn)
    st16(r, O_XP, xp)
    st16(r, O_YP, yp)
    st16(r, O_PRESSURE, pressure)
    st16(r, O_SIZE, size)
    st32(r, O_TIME, time_ms)
    st16(r, O_A, (a as u64) & 0xFFFF)
    st16(r, O_B, (b as u64) & 0xFFFF)
}

fn get_type(buf: u64, idx: u64) -> u64 { return ld8(rec(buf, idx), O_TYPE) }
fn get_slot(buf: u64, idx: u64) -> u64 { return ld8(rec(buf, idx), O_SLOT) }
fn get_device(buf: u64, idx: u64) -> u64 { return ld8(rec(buf, idx), O_DEVICE) }
fn get_flags(buf: u64, idx: u64) -> u64 { return ld8(rec(buf, idx), O_FLAGS) }
fn get_x_norm(buf: u64, idx: u64) -> u64 { return ld16(rec(buf, idx), O_XN) }
fn get_y_norm(buf: u64, idx: u64) -> u64 { return ld16(rec(buf, idx), O_YN) }
fn get_x_px(buf: u64, idx: u64) -> u64 { return ld16(rec(buf, idx), O_XP) }
fn get_y_px(buf: u64, idx: u64) -> u64 { return ld16(rec(buf, idx), O_YP) }
fn get_pressure(buf: u64, idx: u64) -> u64 { return ld16(rec(buf, idx), O_PRESSURE) }
fn get_size(buf: u64, idx: u64) -> u64 { return ld16(rec(buf, idx), O_SIZE) }
fn get_time(buf: u64, idx: u64) -> u64 { return ld32(rec(buf, idx), O_TIME) }
fn get_a(buf: u64, idx: u64) -> i64 { return sext16(ld16(rec(buf, idx), O_A)) }
fn get_b(buf: u64, idx: u64) -> i64 { return sext16(ld16(rec(buf, idx), O_B)) }
