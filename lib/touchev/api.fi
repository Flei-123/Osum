// SPDX-License-Identifier: GPL-2.0-only
import touchev.record

export {
    SNAP_RECORDS, SNAP_BYTES,
    open, close, is_open, refill_from, poll, next_gesture,
    pending, dropped, bad_snapshots,
    ev_type, ev_slot, ev_device, ev_flags, ev_x, ev_y, ev_x_px, ev_y_px,
    ev_pressure, ev_size, ev_time, ev_a, ev_b,
    gesture_a, gesture_b
}

const SNAP_RECORDS: u64 = 128
const SNAP_BYTES: u64 = 3088

static mut snap: [u8; 3088] = [0; 3088]
static mut s_open: u64 = 0
static mut s_count: u64 = 0
static mut s_pos: u64 = 0
static mut s_cur: u64 = 0
static mut s_valid: u64 = 0
static mut s_dropped: u64 = 0
static mut s_bad: u64 = 0

fn base() -> u64 { return (&snap[0]) as u64 }

fn open() -> bool {
    s_open = 1
    s_count = 0
    s_pos = 0
    s_cur = 0
    s_valid = 0
    s_dropped = 0
    s_bad = 0
    return true
}

fn close() {
    s_open = 0
    s_count = 0
    s_pos = 0
    s_valid = 0
}

fn is_open() -> bool { return s_open != 0 }

fn copy_in(src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        let b: u8 = *((src + i) as *mut u8)
        snap[i as usize] = b
        i = i + 1
    }
}

fn refill_from(buf: u64, len: u64) -> bool {
    if s_open == 0 { return false }
    if len < record.HEADER_BYTES || !record.magic_ok(buf) {
        s_bad = s_bad + 1
        return false
    }
    let count: u64 = record.header_count(buf)
    if count > SNAP_RECORDS || record.snapshot_bytes(count) > len {
        s_bad = s_bad + 1
        return false
    }
    s_dropped = s_dropped + (s_count - s_pos) + record.header_dropped(buf)
    copy_in(buf, record.snapshot_bytes(count))
    s_count = count
    s_pos = 0
    s_valid = 0
    return true
}

fn pending() -> u64 { return s_count - s_pos }

fn poll() -> bool {
    if s_open == 0 { return false }
    if s_pos >= s_count {
        s_valid = 0
        return false
    }
    s_cur = s_pos
    s_pos = s_pos + 1
    s_valid = 1
    return true
}

fn next_gesture() -> u64 {
    while poll() {
        if record.get_type(base(), s_cur) == record.T_GESTURE {
            return record.get_flags(base(), s_cur)
        }
    }
    return 0
}

fn dropped() -> u64 { return s_dropped }
fn bad_snapshots() -> u64 { return s_bad }

fn ev_type() -> u64 { if s_valid == 0 { return 0 }; return record.get_type(base(), s_cur) }
fn ev_slot() -> u64 { if s_valid == 0 { return record.SLOT_NONE }; return record.get_slot(base(), s_cur) }
fn ev_device() -> u64 { if s_valid == 0 { return 0 }; return record.get_device(base(), s_cur) }
fn ev_flags() -> u64 { if s_valid == 0 { return 0 }; return record.get_flags(base(), s_cur) }
fn ev_x() -> u64 { if s_valid == 0 { return 0 }; return record.get_x_norm(base(), s_cur) }
fn ev_y() -> u64 { if s_valid == 0 { return 0 }; return record.get_y_norm(base(), s_cur) }
fn ev_x_px() -> u64 { if s_valid == 0 { return 0 }; return record.get_x_px(base(), s_cur) }
fn ev_y_px() -> u64 { if s_valid == 0 { return 0 }; return record.get_y_px(base(), s_cur) }
fn ev_pressure() -> u64 { if s_valid == 0 { return 0 }; return record.get_pressure(base(), s_cur) }
fn ev_size() -> u64 { if s_valid == 0 { return 0 }; return record.get_size(base(), s_cur) }
fn ev_time() -> u64 { if s_valid == 0 { return 0 }; return record.get_time(base(), s_cur) }
fn ev_a() -> i64 { if s_valid == 0 { return 0 }; return record.get_a(base(), s_cur) }
fn ev_b() -> i64 { if s_valid == 0 { return 0 }; return record.get_b(base(), s_cur) }
fn gesture_a() -> i64 { return ev_a() }
fn gesture_b() -> i64 { return ev_b() }
