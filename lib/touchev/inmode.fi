// SPDX-License-Identifier: GPL-2.0-only

export {
    REPORT_FEATURE, OP_SET_REPORT, MODE_PTP, SWITCH_ON, I2C_FRAME_MAX,
    put_bits, i2c_set_report, usb_wvalue
}

const REPORT_FEATURE: u64 = 3
const OP_SET_REPORT: u64 = 3
const MODE_PTP: u64 = 3
const SWITCH_ON: u64 = 1
const I2C_FRAME_MAX: u64 = 80
const RID_LONG: u64 = 15

fn st8(p: u64, o: u64, v: u64) { *((p + o) as *mut u8) = (v & 255) as u8 }

fn ld8(p: u64, o: u64) -> u64 {
    let b: u8 = *((p + o) as *mut u8)
    return b as u64
}

fn put_bits(buf: u64, off: u64, n: u64, v: u64) {
    var i: u64 = 0
    while i < n {
        if ((v >> i) & 1) != 0 {
            let at: u64 = off + i
            st8(buf, at / 8, ld8(buf, at / 8) | (1 << (at % 8)))
        }
        i = i + 1
    }
}

fn usb_wvalue(rid: u64) -> u64 {
    return (REPORT_FEATURE << 8) | rid
}

fn i2c_set_report(cmdreg: u64, datareg: u64, rid: u64, payload: u64, n: u64, out: u64) -> u64 {
    var at: u64 = 0
    st8(out, at, cmdreg & 255)
    at = at + 1
    st8(out, at, (cmdreg >> 8) & 255)
    at = at + 1
    var low: u64 = rid
    if rid >= RID_LONG {
        low = RID_LONG
    }
    st8(out, at, (REPORT_FEATURE << 4) | low)
    at = at + 1
    st8(out, at, OP_SET_REPORT)
    at = at + 1
    if rid >= RID_LONG {
        st8(out, at, rid)
        at = at + 1
    }
    st8(out, at, datareg & 255)
    at = at + 1
    st8(out, at, (datareg >> 8) & 255)
    at = at + 1
    var size: u64 = 2 + n
    if rid != 0 {
        size = size + 1
    }
    st8(out, at, size & 255)
    at = at + 1
    st8(out, at, (size >> 8) & 255)
    at = at + 1
    if rid != 0 {
        st8(out, at, rid)
        at = at + 1
    }
    var k: u64 = 0
    while k < n {
        st8(out, at, ld8(payload, k))
        at = at + 1
        k = k + 1
    }
    return at
}
