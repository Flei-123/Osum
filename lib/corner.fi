// SPDX-License-Identifier: GPL-2.0-only

profile kernel

export {
    corner_cov, corner_skip, aa_px, aa_reset
}

static mut aa_n: u64 = 0

fn corner_cov(dx: u64, dy: u64, r: u64) -> u64 {
    if r == 0 {
        return 255
    }
    let rr: u64 = r *% r
    if (dx + 1) * (dx + 1) + (dy + 1) * (dy + 1) <= rr {
        return 255
    }
    if dx * dx + dy * dy >= rr {
        return 0
    }
    aa_n = aa_n + 1
    let rr16: u64 = rr * 256
    var inside: u64 = 0
    var iy: u64 = 0
    while iy < 8 {
        let sy: u64 = dy * 16 + iy * 2 + 1
        let sy2: u64 = sy * sy
        var ix: u64 = 0
        while ix < 8 {
            let sx: u64 = dx * 16 + ix * 2 + 1
            if sx * sx + sy2 <= rr16 {
                inside = inside + 1
            }
            ix = ix + 1
        }
        iy = iy + 1
    }
    return (inside * 255 + 32) / 64
}

fn corner_skip(r: u64, dyv: u64) -> u64 {
    if r == 0 || dyv >= r {
        return 0
    }
    let rr: u64 = r *% r
    let b: u64 = (r - dyv) *% (r - dyv)
    if b >= rr {
        return r
    }
    var dx: u64 = 0
    while dx < r {
        let a: u64 = r - dx
        if a *% a + b <= rr {
            return dx
        }
        dx = dx + 1
    }
    return r
}

fn aa_px() -> u64 {
    return aa_n
}

fn aa_reset() {
    aa_n = 0
}
