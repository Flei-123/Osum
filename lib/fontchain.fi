profile app

import font.ttf

export {
    MAX_FACES, FIRST_CP, TAG_SHIFT,
    count, path_at, tag_of, face_of_tag, set_loaded, loaded, enable, enabled,
    register, reset, find, pair_kern
}

const MAX_FACES: u64 = 6
const FIRST_CP: u32 = 0xA0 as u32
const TAG_SHIFT: u32 = 24 as u32
const GID_MASK: u32 = 0xFFFFFF as u32
const TABLE_BYTES: u64 = 320

static mut s_defaults: [u8; 33] = "/lib/symbols.ttf\0/lib/emoji.ttf\0\0"
static mut s_table: [u8; 320] = [0 as u8; 320]
static mut s_booted: u64 = 0
static mut s_loaded: [u64; 6] = [0; 6]
static mut s_enabled: u64 = 1

fn boot() {
    if s_booted != 0 {
        return
    }
    s_booted = 1
    var i: u64 = 0
    while i < 33 {
        s_table[i as usize] = s_defaults[i as usize]
        i = i + 1
    }
    while i < TABLE_BYTES {
        s_table[i as usize] = 0 as u8
        i = i + 1
    }
}

fn reset() {
    s_booted = 0
    boot()
    var i: u64 = 0
    while i < MAX_FACES {
        s_loaded[i as usize] = 0
        i = i + 1
    }
}

fn rd(i: u64) -> u64 {
    boot()
    if i >= TABLE_BYTES {
        return 0
    }
    return s_table[i as usize] as u64
}

fn table_end() -> u64 {
    var at: u64 = 0
    while rd(at) != 0 {
        while rd(at) != 0 {
            at = at + 1
        }
        at = at + 1
    }
    return at
}

fn register(path: u64) -> bool {
    boot()
    if count() >= MAX_FACES || path == 0 {
        return false
    }
    var len: u64 = 0
    while *((path + len) as *mut u8) != 0 as u8 {
        len = len + 1
    }
    let at: u64 = table_end()
    if len == 0 || at + len + 2 > TABLE_BYTES {
        return false
    }
    var k: u64 = 0
    while k < len {
        s_table[(at + k) as usize] = *((path + k) as *mut u8)
        k = k + 1
    }
    s_table[(at + len) as usize] = 0 as u8
    s_table[(at + len + 1) as usize] = 0 as u8
    return true
}

fn path_start(i: u64) -> u64 {
    var at: u64 = 0
    var k: u64 = 0
    while k < i {
        while rd(at) != 0 {
            at = at + 1
        }
        at = at + 1
        k = k + 1
    }
    return at
}

fn count() -> u64 {
    var n: u64 = 0
    var at: u64 = 0
    while rd(at) != 0 && n < MAX_FACES {
        while rd(at) != 0 {
            at = at + 1
        }
        at = at + 1
        n = n + 1
    }
    return n
}

fn path_at(i: u64) -> u64 {
    if i >= count() {
        return 0
    }
    return ((&s_table[0]) as u64) + path_start(i)
}

fn tag_of(i: u64) -> u32 {
    return ((i + 1) as u32) << TAG_SHIFT
}

fn face_of_tag(gid: u32) -> u64 {
    let k: u32 = gid >> TAG_SHIFT
    if k == 0 as u32 {
        return 0xFFFFFFFFFFFFFFFF
    }
    return (k - 1 as u32) as u64
}

fn set_loaded(i: u64, v: u64) {
    if i < MAX_FACES {
        s_loaded[i as usize] = v
    }
}

fn loaded(i: u64) -> bool {
    return i < MAX_FACES && s_loaded[i as usize] != 0
}

fn enable(v: u64) {
    s_enabled = v
}

fn enabled() -> bool {
    return s_enabled != 0
}

fn face_ptr(base: u64, stride: u64, i: u64) -> *mut ttf.Font {
    return (base + i * stride) as *mut ttf.Font
}

fn find(base: u64, stride: u64, cp: u32, upem: u32) -> u32 {
    if !enabled() || cp < FIRST_CP {
        return 0 as u32
    }
    var i: u64 = 0
    let n: u64 = count()
    while i < n {
        if loaded(i) {
            let f: *mut ttf.Font = face_ptr(base, stride, i)
            if upem == 0 as u32 || ttf.font_upem(f) == upem {
                let g: u32 = ttf.font_glyph_for(f, cp)
                if g != 0 as u32 {
                    return (g & GID_MASK) | tag_of(i)
                }
            }
        }
        i = i + 1
    }
    return 0 as u32
}

fn pair_kern(base: u64, stride: u64, face: u64, c1: u32, c2: u32) -> i32 {
    if face >= count() || !loaded(face) {
        return 0
    }
    let f: *mut ttf.Font = face_ptr(base, stride, face)
    let g1: u32 = ttf.font_glyph_for(f, c1)
    let g2: u32 = ttf.font_glyph_for(f, c2)
    if g1 == 0 as u32 || g2 == 0 as u32 {
        return 0
    }
    return ttf.font_kern(f, g1, g2)
}
