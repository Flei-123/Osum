// lib/fui/trayaudio.fi -- fui.trayaudio: the texts of the sound and microphone tray icons, from the audio hub.
//
//     import fui.trayaudio
//     var b: rt.Buf = rt.buf_new()
//     if trayaudio.mic_tooltip(&hub, &b) { ... rt.buf_ptr(&b) is NUL terminated: "Microphone in use by Computer-Phone" }
//     trayaudio.volume_tooltip(&hub, hub.hub_default(&hub, hub.DIR_OUT), &b)   // "Lautsprecher: 50 %"
//
// The mic indicator shows when a program captures (or the systemwide mute is on); it names WHO, because a
// camera/mic light that does not say who is not worth much. Texts are German (UI language of OrientOS).
import std.rt
import audio.hub

export { mic_tooltip, volume_tooltip, mic_indicator }

fn push_c(b: *mut rt.Buf, p: u64) {
    var i: usize = 0
    while rt.ld8(p, i) != 0 as u8 {
        rt.buf_push(b, rt.ld8(p, i))
        i = i + 1
    }
}

fn push_s(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.length())
}

// 0 = no icon, 1 = microphone in use, 2 = muted.
fn mic_indicator(h: *mut hub.Hub) -> u64 {
    if hub.hub_mic_muted(h) {
        return 2
    }
    if hub.hub_mic_app_count(h) > 0 {
        return 1
    }
    return 0
}

// Fills `out` (NUL terminated) and returns whether the indicator is shown at all.
fn mic_tooltip(h: *mut hub.Hub, out: *mut rt.Buf) -> bool {
    rt.buf_clear(out)
    let state: u64 = mic_indicator(h)
    if state == 0 {
        rt.buf_push(out, 0 as u8)
        return false
    }
    if state == 2 {
        push_s(out, "Mikrofon ist stumm")
        rt.buf_push(out, 0 as u8)
        return true
    }
    let n: usize = hub.hub_mic_app_count(h)
    push_s(out, "Mikrofon wird verwendet von ")
    push_c(out, hub.hub_mic_app_name(h, 0))
    if n == 2 {
        push_s(out, " und ")
        push_c(out, hub.hub_mic_app_name(h, 1))
    } else if n == 3 {
        push_s(out, ", ")
        push_c(out, hub.hub_mic_app_name(h, 1))
        push_s(out, " und ")
        push_c(out, hub.hub_mic_app_name(h, 2))
    } else if n > 3 {
        push_s(out, ", ")
        push_c(out, hub.hub_mic_app_name(h, 1))
        push_s(out, " und ")
        rt.buf_push_dec_u64(out, (n - 2) as u64)
        push_s(out, " weiteren")
    }
    rt.buf_push(out, 0 as u8)
    return true
}

// "<device>: 50 %" or "<device>: stumm"; false when the device is unknown (no sound hardware).
fn volume_tooltip(h: *mut hub.Hub, dev: u64, out: *mut rt.Buf) -> bool {
    rt.buf_clear(out)
    let name: u64 = hub.hub_device_name(h, dev)
    if name == 0 {
        push_s(out, "Kein Audiogerät")
        rt.buf_push(out, 0 as u8)
        return false
    }
    push_c(out, name)
    push_s(out, ": ")
    if hub.hub_muted(h, dev) {
        push_s(out, "stumm")
    } else {
        rt.buf_push_dec_u64(out, hub.hub_volume(h, dev))
        push_s(out, " %")
    }
    rt.buf_push(out, 0 as u8)
    return true
}
