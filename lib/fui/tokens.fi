// SPDX-License-Identifier: MPL-2.0
// lib/fui/tokens.fi -- THE DESIGN TOKENS OF ORIENTOS (fUi gallery, integers only, no host).
//
// ========================================================= WHY
//
// The numbers of the look lived in four places: the shape files (radii, spacing, shadow),
// wlibc (colour roles), fuiscene (`sp(10)`, `sp(14)`: spacing typed into the painting code)
// and every popup (its own radius, its own shadow, its own blur). Two programs that wanted
// "a medium radius" or "the hover colour of the accent" had to guess. This module is the ONE
// place that answers: a name -> a number, for scale 1 and scale 2 alike.
//
// Pure integer functions, nothing imported: a kernel-profile program (no float, no heap) can
// use them as well as an `app`-profile scene program. Colours are 0xRRGGBB (NOT swapped; the
// caller swaps for its surface). Lengths are in points; multiply by the scale: `px(v, s)`.
//
//   import fui.tokens
//
// ========================================================= THE TOKENS
//
//   radius      R_SMALL 4 (tags, checkboxes) / R_MEDIUM 8 (buttons, fields, list items) /
//               R_LARGE 12 (cards, popups, menus)             -> `radius(level, s)`
//   spacing     SP_1..SP_6 = 4 8 12 16 24 32 (a 4 grid)       -> `space(step, s)`
//   elevation   3 levels: dy, blur radius, alpha percent      -> `elev_dy/elev_r/elev_alpha`
//   type        T_CAPTION 12 / T_BODY 15 / T_STRONG 15 / T_TITLE 18 / T_DISPLAY 24
//   motion      D_FAST 100 / D_NORMAL 160 / D_SLOW 300 ms; `ease_out`, `ease_in_out`
//   colour      neutrals light/dark (Fluent-like): `neutral(role, dark)`
//   accent      `acc_hover/acc_press/acc_ring/acc_disabled/acc_on` -- derived, so ANY accent
//               the user picks gets consistent states
//   glass       `glass_blur/glass_tint_pct/glass_noise` per surface kind (and 0 under `noglass`)
//
// Every state of every widget is one of five: NORMAL, HOVER, PRESS, FOCUS, OFF (`state_fill`
// returns the fill of a control for a state, so a button, a toggle, a slider handle and a list
// item agree on what "hovered" looks like).

export {
    px, radius, space, elev_dy, elev_r, elev_alpha, type_px, dur, ease_out, ease_in_out, ease_at,
    neutral, mix, acc_hover, acc_press, acc_ring, acc_disabled, acc_on, state_fill, contrast100,
    lum1000, glass_blur, glass_tint, glass_tint_pct, glass_noise, glass_on,
    R_SMALL, R_MEDIUM, R_LARGE, R_FULL,
    SP_1, SP_2, SP_3, SP_4, SP_5, SP_6,
    E_NONE, E_LOW, E_MID, E_HIGH,
    T_CAPTION, T_BODY, T_STRONG, T_TITLE, T_DISPLAY,
    D_FAST, D_NORMAL, D_SLOW,
    N_BASE, N_SURFACE, N_RAISED, N_FIELD, N_STROKE, N_TEXT, N_MUTED, N_DISABLED, N_HOVER, N_PRESS,
    ST_NORMAL, ST_HOVER, ST_PRESS, ST_FOCUS, ST_OFF,
    G_BAR, G_MENU, G_QS, G_TIP, G_TOAST,
}

// --------------------------------------------------------------- scale

// A length in points at an interface scale (1 or 2; 0 is read as 1).
fn px(v: u64, s: u64) -> u64 {
    if s == 0 {
        return v
    }
    return v * s
}

// --------------------------------------------------------------- radius

const R_SMALL: u64 = 0
const R_MEDIUM: u64 = 1
const R_LARGE: u64 = 2
const R_FULL: u64 = 3

// 4 / 8 / 12; R_FULL is "a pill": the caller passes half the shorter edge, this returns a cap
// big enough to be clamped by it (the corner rasteriser never goes above half an edge).
fn radius(level: u64, s: u64) -> u64 {
    if level == R_SMALL {
        return px(4, s)
    }
    if level == R_MEDIUM {
        return px(8, s)
    }
    if level == R_LARGE {
        return px(12, s)
    }
    return px(999, s)
}

// --------------------------------------------------------------- spacing

const SP_1: u64 = 1
const SP_2: u64 = 2
const SP_3: u64 = 3
const SP_4: u64 = 4
const SP_5: u64 = 5
const SP_6: u64 = 6

// 4 8 12 16 24 32. Step 0 is 0.
fn space(step: u64, s: u64) -> u64 {
    if step == 1 {
        return px(4, s)
    }
    if step == 2 {
        return px(8, s)
    }
    if step == 3 {
        return px(12, s)
    }
    if step == 4 {
        return px(16, s)
    }
    if step == 5 {
        return px(24, s)
    }
    if step == 6 {
        return px(32, s)
    }
    return 0
}

// --------------------------------------------------------------- elevation

const E_NONE: u64 = 0
const E_LOW: u64 = 1
const E_MID: u64 = 2
const E_HIGH: u64 = 3

// Vertical offset of a shadow, points: a card rests (2), a menu floats (4), a dialog hovers (8).
fn elev_dy(level: u64, s: u64) -> u64 {
    if level == E_LOW {
        return px(2, s)
    }
    if level == E_MID {
        return px(4, s)
    }
    if level == E_HIGH {
        return px(8, s)
    }
    return 0
}

// Reach (blur radius) of the shadow, points.
fn elev_r(level: u64, s: u64) -> u64 {
    if level == E_LOW {
        return px(6, s)
    }
    if level == E_MID {
        return px(12, s)
    }
    if level == E_HIGH {
        return px(24, s)
    }
    return 0
}

// Strength in percent. Shadows must be stronger on a dark surface to be seen at all.
fn elev_alpha(level: u64, dark: bool) -> u64 {
    if level == E_NONE {
        return 0
    }
    var a: u64 = 14
    if level == E_MID {
        a = 22
    }
    if level == E_HIGH {
        a = 32
    }
    if dark {
        return a + 14
    }
    return a
}

// --------------------------------------------------------------- type

const T_CAPTION: u64 = 0
const T_BODY: u64 = 1
const T_STRONG: u64 = 2
const T_TITLE: u64 = 3
const T_DISPLAY: u64 = 4

// Pixel size of a text role (the same five as wlibc TY_*; one source from now on).
fn type_px(role: u64, s: u64) -> u64 {
    if role == T_CAPTION {
        return px(12, s)
    }
    if role == T_BODY {
        return px(15, s)
    }
    if role == T_STRONG {
        return px(15, s)
    }
    if role == T_TITLE {
        return px(18, s)
    }
    return px(24, s)
}

// --------------------------------------------------------------- motion

const D_FAST: u64 = 100
const D_NORMAL: u64 = 160
const D_SLOW: u64 = 300

// A duration in ms (a hover fade is fast, a menu opening is normal, a page change is slow).
fn dur(kind: u64) -> u64 {
    if kind == D_FAST {
        return 100
    }
    if kind == D_SLOW {
        return 300
    }
    return 160
}

// Easing on thousandths: t 0..1000 in, progress 0..1000 out.
// ease_out = 1 - (1 - t)^3 (decelerates: things that appear), ease_in_out = smoothstep-like cubic.
fn ease_out(t: u64) -> u64 {
    var tt: u64 = t
    if tt > 1000 {
        tt = 1000
    }
    let u: u64 = 1000 - tt
    return 1000 - (u * u * u) / 1000000
}

fn ease_in_out(t: u64) -> u64 {
    var tt: u64 = t
    if tt > 1000 {
        tt = 1000
    }
    if tt < 500 {
        return (4 * tt * tt * tt) / 1000000
    }
    let u: u64 = 1000 - tt
    return 1000 - (4 * u * u * u) / 1000000
}

// Progress of an animation `elapsed` ms into `total` ms, eased out; 1000 when done.
fn ease_at(elapsed: u64, total: u64) -> u64 {
    if total == 0 || elapsed >= total {
        return 1000
    }
    return ease_out((elapsed * 1000) / total)
}

// --------------------------------------------------------------- colour

const N_BASE: u64 = 0 // the window background
const N_SURFACE: u64 = 1 // a card / panel on it
const N_RAISED: u64 = 2 // a menu / popup / dialog
const N_FIELD: u64 = 3 // a text box, a dropdown
const N_STROKE: u64 = 4 // borders and dividers
const N_TEXT: u64 = 5
const N_MUTED: u64 = 6 // secondary text
const N_DISABLED: u64 = 7 // disabled text
const N_HOVER: u64 = 8 // a hovered neutral control (list item, ghost button)
const N_PRESS: u64 = 9 // a pressed neutral control

// Fluent-like neutrals. Light: Windows 11 "Layer" greys (F3F3F3 base, white cards). Dark: the
// 202020 family. Both keep text/base >= 12:1 and muted/base >= 4.5:1 (tools/tokens/run.sh).
fn neutral(role: u64, dark: bool) -> u64 {
    if dark {
        if role == N_BASE {
            return 0x202020
        }
        if role == N_SURFACE {
            return 0x2B2B2B
        }
        if role == N_RAISED {
            return 0x323232
        }
        if role == N_FIELD {
            return 0x2D2D2D
        }
        if role == N_STROKE {
            return 0x454545
        }
        if role == N_TEXT {
            return 0xF5F5F5
        }
        if role == N_MUTED {
            return 0xA8A8A8
        }
        if role == N_DISABLED {
            return 0x6E6E6E
        }
        if role == N_HOVER {
            return 0x383838
        }
        return 0x2A2A2A
    }
    if role == N_BASE {
        return 0xF3F3F3
    }
    if role == N_SURFACE {
        return 0xFFFFFF
    }
    if role == N_RAISED {
        return 0xFCFCFC
    }
    if role == N_FIELD {
        return 0xFFFFFF
    }
    if role == N_STROKE {
        return 0xD6D6D6
    }
    if role == N_TEXT {
        return 0x1B1B1B
    }
    if role == N_MUTED {
        return 0x5E5E5E
    }
    if role == N_DISABLED {
        return 0xA0A0A0
    }
    if role == N_HOVER {
        return 0xEAEAEA
    }
    return 0xDEDEDE
}

fn ch_r(c: u64) -> u64 { return (c >> 16) & 255 }
fn ch_g(c: u64) -> u64 { return (c >> 8) & 255 }
fn ch_b(c: u64) -> u64 { return c & 255 }

fn rgb(r: u64, g: u64, b: u64) -> u64 {
    return (r << 16) | (g << 8) | b
}

// Linear mix of two colours: `pct` percent of `b`, the rest of `a`, rounded, per channel.
fn mix(a: u64, b: u64, pct: u64) -> u64 {
    var p: u64 = pct
    if p > 100 {
        p = 100
    }
    let q: u64 = 100 - p
    let r: u64 = (ch_r(a) * q + ch_r(b) * p + 50) / 100
    let g: u64 = (ch_g(a) * q + ch_g(b) * p + 50) / 100
    let bl: u64 = (ch_b(a) * q + ch_b(b) * p + 50) / 100
    return rgb(r, g, bl)
}

// Approximate relative luminance in thousandths (gamma 2 instead of the sRGB curve: within
// ~2 % of the real value for UI greys and blues, and integer only).
fn lum1000(c: u64) -> u64 {
    let lr: u64 = (ch_r(c) * ch_r(c)) / 255
    let lg: u64 = (ch_g(c) * ch_g(c)) / 255
    let lb: u64 = (ch_b(c) * ch_b(c)) / 255
    return (2126 * lr + 7152 * lg + 722 * lb) / 2550
}

// Contrast ratio in hundredths (450 = 4.5:1) from the approximate luminance.
fn contrast100(a: u64, b: u64) -> u64 {
    let la: u64 = lum1000(a) + 50
    let lb: u64 = lum1000(b) + 50
    var hi: u64 = la
    var lo: u64 = lb
    if lb > la {
        hi = lb
        lo = la
    }
    return (hi * 100) / lo
}

// --------------------------------------------------------------- accent states

// Light surface: the accent gets DARKER on hover and press (white text on it keeps contrast).
// Dark surface: LIGHTER on hover, and press falls back below the base (a pressed key sinks).
fn acc_hover(acc: u64, dark: bool) -> u64 {
    if dark {
        return mix(acc, 0xFFFFFF, 14)
    }
    return mix(acc, 0x000000, 8)
}

fn acc_press(acc: u64, dark: bool) -> u64 {
    if dark {
        return mix(acc, 0x000000, 14)
    }
    return mix(acc, 0x000000, 18)
}

// The focus ring: it must stand out from BOTH the accent fill and the surface, so it is the
// accent pushed hard away from the surface (dark -> pale, light -> deep).
fn acc_ring(acc: u64, dark: bool) -> u64 {
    if dark {
        return mix(acc, 0xFFFFFF, 55)
    }
    return mix(acc, 0x000000, 35)
}

// A disabled accent control: 38 % accent over the surface it sits on.
fn acc_disabled(acc: u64, dark: bool) -> u64 {
    return mix(neutral(N_SURFACE, dark), acc, 38)
}

// Text on the accent: white or black, whichever has the better contrast.
fn acc_on(acc: u64) -> u64 {
    if contrast100(acc, 0xFFFFFF) >= contrast100(acc, 0x000000) {
        return 0xFFFFFF
    }
    return 0x000000
}

const ST_NORMAL: u64 = 0
const ST_HOVER: u64 = 1
const ST_PRESS: u64 = 2
const ST_FOCUS: u64 = 3
const ST_OFF: u64 = 4

// THE FILL OF A CONTROL IN A STATE. `accent_fill` = a primary (accent) control, else a neutral
// one. Focus keeps the normal fill: the ring is what shows focus (`acc_ring`, 2 points).
fn state_fill(state: u64, accent_fill: bool, acc: u64, dark: bool) -> u64 {
    if accent_fill {
        if state == ST_HOVER {
            return acc_hover(acc, dark)
        }
        if state == ST_PRESS {
            return acc_press(acc, dark)
        }
        if state == ST_OFF {
            return acc_disabled(acc, dark)
        }
        return acc
    }
    if state == ST_HOVER {
        return neutral(N_HOVER, dark)
    }
    if state == ST_PRESS {
        return neutral(N_PRESS, dark)
    }
    if state == ST_OFF {
        return mix(neutral(N_SURFACE, dark), neutral(N_BASE, dark), 50)
    }
    return neutral(N_SURFACE, dark)
}

// --------------------------------------------------------------- glass (acrylic)

const G_BAR: u64 = 0 // task bar
const G_MENU: u64 = 1 // start menu, context menu
const G_QS: u64 = 2 // quick settings
const G_TIP: u64 = 3 // tooltip
const G_TOAST: u64 = 4 // toast

// Is frosting wanted at all? `off` is the user setting / kernel word `noglass`. Without it every
// surface falls back to its flat, opaque plate (the cheap path for slow machines).
fn glass_on(off: bool) -> bool {
    return !off
}

// Blur radius (box filter, two passes) in points per surface. Small popups need less: the
// blur cost grows with the area, and a 200x40 tooltip does not show a wide blur anyway.
fn glass_blur(kind: u64, s: u64, off: bool) -> u64 {
    if off {
        return 0
    }
    if kind == G_TIP || kind == G_TOAST {
        return px(4, s)
    }
    return px(8, s)
}

// The tint laid over the blurred backdrop: the raised neutral of the mode.
fn glass_tint(kind: u64, dark: bool) -> u64 {
    if kind == G_BAR {
        return neutral(N_BASE, dark)
    }
    return neutral(N_RAISED, dark)
}

// How much of the tint covers the backdrop, percent (the rest is blurred picture). Enough to keep
// text >= 4.5:1 on a busy wallpaper (tools/tokens/run.sh checks the worst case).
fn glass_tint_pct(kind: u64, dark: bool) -> u64 {
    if dark {
        return 78
    }
    if kind == G_BAR {
        return 72
    }
    return 82
}

// Amplitude of the grain in brightness steps (hides banding of the blurred gradient).
fn glass_noise(kind: u64) -> u64 {
    if kind == G_TIP || kind == G_TOAST {
        return 0
    }
    return 3
}
