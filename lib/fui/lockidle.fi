// SPDX-License-Identifier: MPL-2.0
// lib/fui/lockidle.fi -- the idle-lock choices of the Settings page (integers only, no host).
//
// Seven choices: Never, 1, 2, 5, 10, 15, 30 minutes. The setting itself is `lock.idle` on the
// action bus in SECONDS (0 = never, stored in /etc/sperre.conf as `leerlauf=`). The default is
// DEFAULT_SECS (10 minutes); it used to be 5 minutes and felt like "locks every 3 minutes".

export { secs_of, level_of, DEFAULT_SECS, LEVELS }

const LEVELS: u64 = 7
const DEFAULT_SECS: u64 = 600

// Seconds of one choice (index 0..6); out of range reads as "never".
fn secs_of(level: u64) -> u64 {
    if level == 1 {
        return 60
    }
    if level == 2 {
        return 120
    }
    if level == 3 {
        return 300
    }
    if level == 4 {
        return 600
    }
    if level == 5 {
        return 900
    }
    if level == 6 {
        return 1800
    }
    return 0
}

// The choice that shows a stored number of seconds: the nearest one (a value written by a script,
// e.g. 240, shows as "5 minutes" and not as "never"). 0 stays "never".
fn level_of(secs: u64) -> u64 {
    if secs == 0 {
        return 0
    }
    var best: u64 = 1
    var bestd: u64 = 0xFFFFFFFFFFFFFFFF
    var l: u64 = 1
    while l < LEVELS {
        let v: u64 = secs_of(l)
        var d: u64 = 0
        if v > secs {
            d = v - secs
        } else {
            d = secs - v
        }
        if d < bestd {
            bestd = d
            best = l
        }
        l = l + 1
    }
    return best
}
