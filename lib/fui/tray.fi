// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/tray.fi -- fui.tray: the model of the notification area (system tray) of the task bar.
//
// A program REGISTERS an item (icon, tooltip, context menu); the bar ASKS which items to draw where
// (`tray_at`), the user MOVES items between the bar and the overflow flyout (`tray_move`), and clicks
// become EVENTS for the owner (`tray_click`, `tray_pick`, `tray_event_pop`). The bar turns those events
// into action-bus messages to the owner; this file knows nothing about windows, pixels or the bus.
//
//     import fui.tray
// Texts are NUL terminated u64 pointers (the kernel profile has no `str`): a literal `"player\0"` in a
// `static mut [u8; N]`, or `(&buf[0]) as u64`.
//     var t: tray.Tray = tray.tray_new()
//     let id: u64 = tray.tray_register(&t, "player", 12, "Player", false)    // new apps start in the overflow
//     tray.tray_menu_add(&t, id, "Oeffnen", tray.ACT_OPEN, 0)
//     tray.tray_menu_add(&t, id, "Beenden", tray.ACT_QUIT, 0)
//     tray.tray_move(&t, id, tray.PLACE_BAR, 0)                              // drag out of the overflow to the bar
//     let n: usize = tray.tray_count(&t, tray.PLACE_BAR)
//     tray.tray_owner_gone(&t, "player")                                     // the process exited: items vanish
//
// RULES
// T1  System items (network, sound, battery, microphone: `system = true`) start in the bar, everything
//     else in the overflow. The user may move or hide both kinds; the model keeps the choice by owner name
//     + icon so it can be saved by the caller (`tray_place_of_owner`).
// T2  Order inside a place is the order of `tray_move` calls, stable; a new item goes last.
// T3  `tray_owner_gone` removes every item of an owner and returns how many (a crashed program leaves no ghost icon).
// T4  Fixed capacity: 32 items, 6 menu entries each, 32 queued events (oldest dropped). Strings are cut at
//     23 octets (owner, labels) and 63 (tooltip).
// T5  Not thread safe: the bar's thread owns it.
// T6  `tray_new()` hands out the ONE static block of the process (calling it again resets that block);
//     `tray_new_in(buf)` takes caller storage of TRAY_WORDS words for more than one tray.
// T7  Builds in `--profile=kernel` and `--profile=app` (tools/tray/run.sh compiles both).
// KERNEL PROFILE: no heap and no std.rt. The block is static storage (`tray_new`) or storage of the caller
// (`tray_new_in`, TRAY_WORDS words); the raw word/octet access below is plain pointer arithmetic.

export {
    Tray, TrayEvent, tray_new, tray_new_in, tray_free, TRAY_WORDS, tray_ok, tray_gen,
    tray_register, tray_unregister, tray_owner_gone, tray_count, tray_at, tray_place, tray_move,
    tray_set_icon, tray_icon, tray_set_tooltip, tray_tooltip, tray_set_badge, tray_badge, tray_owner, tray_is_system,
    tray_menu_add, tray_menu_clear, tray_menu_count, tray_menu_label, tray_menu_action, tray_menu_flags,
    tray_default_menu, tray_click, tray_pick, tray_event_pop, tray_event_count, tray_place_of_owner,
    PLACE_BAR, PLACE_OVERFLOW, PLACE_HIDDEN,
    ACT_OPEN, ACT_QUIT, ACT_SETTINGS, ACT_CUSTOM,
    EV_CLICK, EV_MENU, EV_PICK,
    BTN_LEFT, BTN_RIGHT, BTN_MIDDLE, MF_CHECKED, MF_DISABLED,
}

const PLACE_BAR: u64 = 1
const PLACE_OVERFLOW: u64 = 2
const PLACE_HIDDEN: u64 = 3

const ACT_OPEN: u64 = 1
const ACT_QUIT: u64 = 2
const ACT_SETTINGS: u64 = 3
const ACT_CUSTOM: u64 = 16 // owner defined actions start here

const EV_CLICK: u64 = 1 // a = item id, b = button  (left click on the icon: the owner opens its window)
const EV_MENU: u64 = 2 // a = item id             (right click: the bar shows `tray_menu_*` itself)
const EV_PICK: u64 = 3 // a = item id, b = action  (a menu entry was chosen)

const BTN_LEFT: u64 = 0
const BTN_RIGHT: u64 = 1
const BTN_MIDDLE: u64 = 2

const MF_CHECKED: u64 = 1
const MF_DISABLED: u64 = 2

const IMAX: usize = 32
const MENUMAX: usize = 6
const EVMAX: usize = 32
const NONE: usize = 65535

// header words
const H_NEXT: usize = 0
const H_GEN: usize = 1
const H_EV_W: usize = 2
const H_EV_R: usize = 3
const H_WORDS: usize = 8

// item record
const I_ID: usize = 0
const I_PLACE: usize = 1
const I_ORDER: usize = 2
const I_ICON: usize = 3
const I_BADGE: usize = 4
const I_SYS: usize = 5
const I_MENUN: usize = 6
const I_OWNER: usize = 8 // 3 words = 24 octets
const I_TIP: usize = 11 // 8 words = 64 octets
const I_MENU: usize = 19 // MENUMAX x 5 words: label (3 words), action, flags
const MENUW: usize = 5
const ITEMW: usize = 50

const O_ITEM: usize = H_WORDS
const O_EV: usize = O_ITEM + IMAX * ITEMW
const EVW: usize = 3
const TOTAL: usize = O_EV + EVMAX * EVW
const TRAY_WORDS: usize = TOTAL

static mut tray_store: [u64; 1704] = [0 as u64; 1704] // TOTAL words (checked by tray_new)
static mut m_open: [u8; 10] = "tray.open\0"
static mut m_settings: [u8; 14] = "tray.settings\0"
static mut m_quit: [u8; 10] = "tray.quit\0"
static mut renum_tmp: [u64; 32] = [0 as u64; 32] // IMAX words, scratch of renumber

fn ld64(p: u64, w: usize) -> u64 {
    return *((p + (w * 8) as u64) as *mut u64)
}

fn st64(p: u64, w: usize, v: u64) {
    *((p + (w * 8) as u64) as *mut u64) = v
}

fn ld8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn mem_set(p: u64, v: u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((p + i as u64) as *mut u8) = v
        i = i + 1
    }
}

fn mem_copy(dst: u64, src: u64, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst + i as u64) as *mut u8) = *((src + i as u64) as *mut u8)
        i = i + 1
    }
}

struct Tray {
    blk: u64, // 0 = could not be created
}

struct TrayEvent {
    kind: u64,
    a: u64,
    b: u64,
}

fn tray_new_in(buf: u64) -> Tray {
    if buf == 0 {
        return Tray { blk: 0 }
    }
    mem_set(buf, 0 as u8, TOTAL * 8)
    st64(buf, H_NEXT, 1)
    return Tray { blk: buf }
}

fn tray_new() -> Tray {
    return tray_new_in((&tray_store[0 as usize]) as u64)
}

// The storage is not owned (static or the caller's): free only detaches the handle.
fn tray_free(t: *mut Tray) {
    (*t).blk = 0
}

fn tray_ok(t: *mut Tray) -> bool {
    return (*t).blk != 0
}

// Counts every change; the bar polls this one word and repaints when it moved.
fn tray_gen(t: *mut Tray) -> u64 {
    return ld64((*t).blk, H_GEN)
}

fn bump(b: u64) {
    st64(b, H_GEN, ld64(b, H_GEN) + 1)
}

fn ibase(s: usize) -> usize {
    return O_ITEM + s * ITEMW
}

fn slot_of(b: u64, id: u64) -> usize {
    if id == 0 {
        return NONE
    }
    var s: usize = 0
    while s < IMAX {
        if ld64(b, ibase(s) + I_ID) == id {
            return s
        }
        s = s + 1
    }
    return NONE
}

fn cstr_set(dst: u64, src: u64, n: usize, cap: usize) {
    var m: usize = n
    if m > cap {
        m = cap
    }
    mem_set(dst, 0 as u8, cap + 1)
    mem_copy(dst, src, m)
}

fn cstr_len(p: u64) -> usize {
    var n: usize = 0
    while ld8(p, n) != 0 as u8 {
        n = n + 1
    }
    return n
}

// `s` is a NUL terminated text (u64 pointer); compares like a name cut at 23 octets.
fn cstr_eq_str(p: u64, s: u64) -> bool {
    var n: usize = cstr_len(s)
    if n > 23 {
        n = 23
    }
    var i: usize = 0
    while i < n {
        if ld8(p, i) != ld8(s, i) {
            return false
        }
        i = i + 1
    }
    return ld8(p, n) == 0 as u8
}

fn push_event(b: u64, kind: u64, a: u64, c: u64) {
    let w: u64 = ld64(b, H_EV_W)
    let r: u64 = ld64(b, H_EV_R)
    if w - r >= EVMAX as u64 {
        st64(b, H_EV_R, r + 1)
    }
    let at: usize = O_EV + ((w % EVMAX as u64) as usize) * EVW
    st64(b, at, kind)
    st64(b, at + 1, a)
    st64(b, at + 2, c)
    st64(b, H_EV_W, w + 1)
}

fn tray_event_count(t: *mut Tray) -> usize {
    return (ld64((*t).blk, H_EV_W) - ld64((*t).blk, H_EV_R)) as usize
}

fn tray_event_pop(t: *mut Tray, out: *mut TrayEvent) -> bool {
    let b: u64 = (*t).blk
    let r: u64 = ld64(b, H_EV_R)
    if b == 0 || r >= ld64(b, H_EV_W) {
        return false
    }
    let at: usize = O_EV + ((r % EVMAX as u64) as usize) * EVW
    (*out).kind = ld64(b, at)
    (*out).a = ld64(b, at + 1)
    (*out).b = ld64(b, at + 2)
    st64(b, H_EV_R, r + 1)
    return true
}

// Next order value of a place: after everything already there (T2).
fn last_order(b: u64, place: u64) -> u64 {
    var m: u64 = 0
    var s: usize = 0
    while s < IMAX {
        let at: usize = ibase(s)
        if ld64(b, at + I_ID) != 0 && ld64(b, at + I_PLACE) == place && ld64(b, at + I_ORDER) > m {
            m = ld64(b, at + I_ORDER)
        }
        s = s + 1
    }
    return m + 2
}

// Registers an item. System items start in the bar, all others in the overflow (T1). Returns the id or 0 (full).
fn tray_register(t: *mut Tray, owner: u64, icon: u64, tooltip: u64, system: bool) -> u64 {
    let b: u64 = (*t).blk
    if b == 0 {
        return 0
    }
    var s: usize = 0
    while s < IMAX && ld64(b, ibase(s) + I_ID) != 0 {
        s = s + 1
    }
    if s == IMAX {
        return 0
    }
    let at: usize = ibase(s)
    mem_set(b + (at * 8) as u64, 0 as u8, ITEMW * 8)
    let id: u64 = ld64(b, H_NEXT)
    st64(b, H_NEXT, id + 1)
    var place: u64 = PLACE_OVERFLOW
    if system {
        place = PLACE_BAR
        st64(b, at + I_SYS, 1)
    }
    st64(b, at + I_PLACE, place)
    st64(b, at + I_ORDER, last_order(b, place))
    st64(b, at + I_ICON, icon)
    cstr_set(b + ((at + I_OWNER) * 8) as u64, owner, cstr_len(owner), 23)
    cstr_set(b + ((at + I_TIP) * 8) as u64, tooltip, cstr_len(tooltip), 63)
    st64(b, at + I_ID, id) // last: the slot counts as used only now
    bump(b)
    return id
}

fn tray_unregister(t: *mut Tray, id: u64) -> bool {
    let b: u64 = (*t).blk
    let s: usize = slot_of(b, id)
    if s == NONE {
        return false
    }
    mem_set(b + (ibase(s) * 8) as u64, 0 as u8, ITEMW * 8)
    bump(b)
    return true
}

// T3: removes every item of an owner; returns how many were removed.
fn tray_owner_gone(t: *mut Tray, owner: u64) -> usize {
    let b: u64 = (*t).blk
    var n: usize = 0
    var s: usize = 0
    while s < IMAX {
        let at: usize = ibase(s)
        if ld64(b, at + I_ID) != 0 && cstr_eq_str(b + ((at + I_OWNER) * 8) as u64, owner) {
            mem_set(b + (at * 8) as u64, 0 as u8, ITEMW * 8)
            n = n + 1
        }
        s = s + 1
    }
    if n > 0 {
        bump(b)
    }
    return n
}

fn tray_count(t: *mut Tray, place: u64) -> usize {
    var n: usize = 0
    var s: usize = 0
    while s < IMAX {
        let at: usize = ibase(s)
        if ld64((*t).blk, at + I_ID) != 0 && ld64((*t).blk, at + I_PLACE) == place {
            n = n + 1
        }
        s = s + 1
    }
    return n
}

// The idx-th item of a place in display order; 0 = out of range. Orders are unique inside a place.
fn tray_at(t: *mut Tray, place: u64, idx: usize) -> u64 {
    let b: u64 = (*t).blk
    var lo: u64 = 0 // order of the previous pick
    var n: usize = 0
    while true {
        var best: u64 = 0
        var bo: u64 = 0
        var s: usize = 0
        while s < IMAX {
            let at: usize = ibase(s)
            let id: u64 = ld64(b, at + I_ID)
            if id != 0 && ld64(b, at + I_PLACE) == place {
                let o: u64 = ld64(b, at + I_ORDER)
                if o > lo && (best == 0 || o < bo) {
                    best = id
                    bo = o
                }
            }
            s = s + 1
        }
        if best == 0 {
            return 0
        }
        if n == idx {
            return best
        }
        n = n + 1
        lo = bo
    }
    return 0
}

fn tray_place(t: *mut Tray, id: u64) -> u64 {
    let s: usize = slot_of((*t).blk, id)
    if s == NONE {
        return 0
    }
    return ld64((*t).blk, ibase(s) + I_PLACE)
}

// Renumbers a place to 2, 4, 6 ... in the current order (keeps the order, opens gaps for inserting).
fn renumber(t: *mut Tray, place: u64) {
    let b: u64 = (*t).blk
    let n: usize = tray_count(t, place)
    let tmp: u64 = (&renum_tmp[0 as usize]) as u64
    var k: usize = 0
    while k < n {
        st64(tmp, k, tray_at(t, place, k))
        k = k + 1
    }
    k = 0
    while k < n {
        let s: usize = slot_of(b, ld64(tmp, k))
        if s != NONE {
            st64(b, ibase(s) + I_ORDER, ((k + 1) * 2) as u64)
        }
        k = k + 1
    }
}

// Drag and drop: puts the item into `place` at position `idx` (clamped to the end). Moving inside a place reorders.
fn tray_move(t: *mut Tray, id: u64, place: u64, idx: usize) -> bool {
    let b: u64 = (*t).blk
    let s: usize = slot_of(b, id)
    if s == NONE || place < PLACE_BAR || place > PLACE_HIDDEN {
        return false
    }
    let at: usize = ibase(s)
    let old: u64 = ld64(b, at + I_PLACE)
    // take it out of the old place (order of the others stays), then number the target without it
    st64(b, at + I_PLACE, 0)
    renumber(t, place)
    var pos: usize = idx
    let n: usize = tray_count(t, place)
    if pos > n {
        pos = n
    }
    st64(b, at + I_PLACE, place)
    st64(b, at + I_ORDER, (pos * 2 + 1) as u64)
    renumber(t, place)
    if old != place && old != 0 {
        renumber(t, old)
    }
    bump(b)
    return true
}

// Where the user put the first item of an owner (for saving the choice); 0 = none registered.
fn tray_place_of_owner(t: *mut Tray, owner: u64) -> u64 {
    let b: u64 = (*t).blk
    var s: usize = 0
    while s < IMAX {
        let at: usize = ibase(s)
        if ld64(b, at + I_ID) != 0 && cstr_eq_str(b + ((at + I_OWNER) * 8) as u64, owner) {
            return ld64(b, at + I_PLACE)
        }
        s = s + 1
    }
    return 0
}

fn tray_set_icon(t: *mut Tray, id: u64, icon: u64) -> bool {
    let s: usize = slot_of((*t).blk, id)
    if s == NONE {
        return false
    }
    if ld64((*t).blk, ibase(s) + I_ICON) != icon {
        st64((*t).blk, ibase(s) + I_ICON, icon)
        bump((*t).blk)
    }
    return true
}

fn tray_icon(t: *mut Tray, id: u64) -> u64 {
    let s: usize = slot_of((*t).blk, id)
    if s == NONE {
        return 0
    }
    return ld64((*t).blk, ibase(s) + I_ICON)
}

fn tray_set_tooltip(t: *mut Tray, id: u64, tip: u64) -> bool {
    let s: usize = slot_of((*t).blk, id)
    if s == NONE {
        return false
    }
    cstr_set((*t).blk + ((ibase(s) + I_TIP) * 8) as u64, tip, cstr_len(tip), 63)
    bump((*t).blk)
    return true
}

// NUL terminated tooltip inside the model (valid until the item goes); 0 = unknown id.
fn tray_tooltip(t: *mut Tray, id: u64) -> u64 {
    let s: usize = slot_of((*t).blk, id)
    if s == NONE {
        return 0
    }
    return (*t).blk + ((ibase(s) + I_TIP) * 8) as u64
}

fn tray_owner(t: *mut Tray, id: u64) -> u64 {
    let s: usize = slot_of((*t).blk, id)
    if s == NONE {
        return 0
    }
    return (*t).blk + ((ibase(s) + I_OWNER) * 8) as u64
}

fn tray_is_system(t: *mut Tray, id: u64) -> bool {
    let s: usize = slot_of((*t).blk, id)
    return s != NONE && ld64((*t).blk, ibase(s) + I_SYS) != 0
}

// A badge count (0 = none) drawn on the icon, e.g. unread messages.
fn tray_set_badge(t: *mut Tray, id: u64, n: u64) -> bool {
    let s: usize = slot_of((*t).blk, id)
    if s == NONE {
        return false
    }
    st64((*t).blk, ibase(s) + I_BADGE, n)
    bump((*t).blk)
    return true
}

fn tray_badge(t: *mut Tray, id: u64) -> u64 {
    let s: usize = slot_of((*t).blk, id)
    if s == NONE {
        return 0
    }
    return ld64((*t).blk, ibase(s) + I_BADGE)
}

// ---------------------------------------------------------------- context menu

fn mbase(s: usize, m: usize) -> usize {
    return ibase(s) + I_MENU + m * MENUW
}

fn tray_menu_add(t: *mut Tray, id: u64, label: u64, action: u64, flags: u64) -> bool {
    let b: u64 = (*t).blk
    let s: usize = slot_of(b, id)
    if s == NONE {
        return false
    }
    let n: usize = ld64(b, ibase(s) + I_MENUN) as usize
    if n >= MENUMAX {
        return false
    }
    let at: usize = mbase(s, n)
    cstr_set(b + (at * 8) as u64, label, cstr_len(label), 23)
    st64(b, at + 3, action)
    st64(b, at + 4, flags)
    st64(b, ibase(s) + I_MENUN, (n + 1) as u64)
    bump(b)
    return true
}

fn tray_menu_clear(t: *mut Tray, id: u64) {
    let s: usize = slot_of((*t).blk, id)
    if s != NONE {
        mem_set((*t).blk + (mbase(s, 0) * 8) as u64, 0 as u8, MENUMAX * MENUW * 8)
        st64((*t).blk, ibase(s) + I_MENUN, 0)
        bump((*t).blk)
    }
}

// The standard menu of a background app: Open, Settings, Quit.
fn tray_default_menu(t: *mut Tray, id: u64) {
    tray_menu_clear(t, id)
    tray_menu_add(t, id, (&m_open[0 as usize]) as u64, ACT_OPEN, 0)
    tray_menu_add(t, id, (&m_settings[0 as usize]) as u64, ACT_SETTINGS, 0)
    tray_menu_add(t, id, (&m_quit[0 as usize]) as u64, ACT_QUIT, 0)
}

fn tray_menu_count(t: *mut Tray, id: u64) -> usize {
    let s: usize = slot_of((*t).blk, id)
    if s == NONE {
        return 0
    }
    return ld64((*t).blk, ibase(s) + I_MENUN) as usize
}

fn tray_menu_label(t: *mut Tray, id: u64, m: usize) -> u64 {
    let s: usize = slot_of((*t).blk, id)
    if s == NONE || m >= tray_menu_count(t, id) {
        return 0
    }
    return (*t).blk + (mbase(s, m) * 8) as u64
}

fn tray_menu_action(t: *mut Tray, id: u64, m: usize) -> u64 {
    let s: usize = slot_of((*t).blk, id)
    if s == NONE || m >= tray_menu_count(t, id) {
        return 0
    }
    return ld64((*t).blk, mbase(s, m) + 3)
}

fn tray_menu_flags(t: *mut Tray, id: u64, m: usize) -> u64 {
    let s: usize = slot_of((*t).blk, id)
    if s == NONE || m >= tray_menu_count(t, id) {
        return 0
    }
    return ld64((*t).blk, mbase(s, m) + 4)
}

// ---------------------------------------------------------------- clicks

// A click on the icon. Left (and middle) = the owner gets EV_CLICK; right = EV_MENU for the bar to open the menu.
fn tray_click(t: *mut Tray, id: u64, button: u64) -> bool {
    let b: u64 = (*t).blk
    if slot_of(b, id) == NONE {
        return false
    }
    if button == BTN_RIGHT {
        push_event(b, EV_MENU, id, 0)
    } else {
        push_event(b, EV_CLICK, id, button)
    }
    return true
}

// A menu entry was chosen: the owner gets EV_PICK with the entry's action. A disabled entry is refused.
fn tray_pick(t: *mut Tray, id: u64, m: usize) -> bool {
    let b: u64 = (*t).blk
    if slot_of(b, id) == NONE || m >= tray_menu_count(t, id) {
        return false
    }
    if (tray_menu_flags(t, id, m) & MF_DISABLED) != 0 {
        return false
    }
    push_event(b, EV_PICK, id, tray_menu_action(t, id, m))
    return true
}
