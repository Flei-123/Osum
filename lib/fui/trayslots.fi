export {
    SLOT_COUNT, SLOT_NET, SLOT_SND, SLOT_BAT, SLOT_MIC,
    slots_reset, slots_valid_code, slots_load, order_code, hidden_mask,
    slot_is_hidden, slot_at, slot_pos, bar_count, over_count, bar_slot_at, over_slot_at,
    slot_bar_index, slot_over_index, slot_move
}

const SLOT_COUNT: usize = 4
const SLOT_NET: u64 = 1
const SLOT_SND: u64 = 2
const SLOT_BAT: u64 = 3
const SLOT_MIC: u64 = 4
const DEFAULT_CODE: u64 = 3214

static mut ord: [u64; 4] = [3 as u64, 2 as u64, 1 as u64, 4 as u64]
static mut hid: [u64; 5] = [0 as u64; 5]
static mut tmp_bar: [u64; 4] = [0 as u64; 4]
static mut tmp_over: [u64; 4] = [0 as u64; 4]

fn slots_reset() {
    slots_load(DEFAULT_CODE, 0)
}

fn digit_at(code: u64, pos: usize) -> u64 {
    var v: u64 = code
    var k: usize = SLOT_COUNT - 1
    while k > pos {
        v = v / 10
        k = k - 1
    }
    return v % 10
}

fn slots_valid_code(code: u64) -> bool {
    if code < 1000 || code > 9999 {
        return false
    }
    var seen: u64 = 0
    var p: usize = 0
    while p < SLOT_COUNT {
        let d: u64 = digit_at(code, p)
        if d < 1 || d > 4 {
            return false
        }
        if (seen & (1 << d)) != 0 {
            return false
        }
        seen = seen | (1 << d)
        p = p + 1
    }
    return true
}

fn slots_load(code: u64, mask: u64) {
    var use_code: u64 = code
    if !slots_valid_code(code) {
        use_code = DEFAULT_CODE
    }
    var p: usize = 0
    while p < SLOT_COUNT {
        ord[p] = digit_at(use_code, p)
        p = p + 1
    }
    var s: u64 = 1
    while s <= SLOT_COUNT as u64 {
        hid[s as usize] = (mask >> s) & 1
        s = s + 1
    }
}

fn order_code() -> u64 {
    return ord[0 as usize] * 1000 + ord[1 as usize] * 100 + ord[2 as usize] * 10 + ord[3 as usize]
}

fn hidden_mask() -> u64 {
    var m: u64 = 0
    var s: u64 = 1
    while s <= SLOT_COUNT as u64 {
        m = m | (hid[s as usize] << s)
        s = s + 1
    }
    return m
}

fn slot_is_hidden(slot: u64) -> bool {
    if slot < 1 || slot > SLOT_COUNT as u64 {
        return false
    }
    return hid[slot as usize] != 0
}

fn slot_at(pos: usize) -> u64 {
    if pos >= SLOT_COUNT {
        return 0
    }
    return ord[pos]
}

fn slot_pos(slot: u64) -> usize {
    var p: usize = 0
    while p < SLOT_COUNT {
        if ord[p] == slot {
            return p
        }
        p = p + 1
    }
    return SLOT_COUNT
}

fn count_by(hidden: u64) -> usize {
    var n: usize = 0
    var p: usize = 0
    while p < SLOT_COUNT {
        if hid[ord[p] as usize] == hidden {
            n = n + 1
        }
        p = p + 1
    }
    return n
}

fn bar_count() -> usize {
    return count_by(0)
}

fn over_count() -> usize {
    return count_by(1)
}

fn nth_by(hidden: u64, idx: usize) -> u64 {
    var n: usize = 0
    var p: usize = 0
    while p < SLOT_COUNT {
        if hid[ord[p] as usize] == hidden {
            if n == idx {
                return ord[p]
            }
            n = n + 1
        }
        p = p + 1
    }
    return 0
}

fn bar_slot_at(idx: usize) -> u64 {
    return nth_by(0, idx)
}

fn over_slot_at(idx: usize) -> u64 {
    return nth_by(1, idx)
}

fn slot_bar_index(slot: u64) -> usize {
    var n: usize = 0
    var p: usize = 0
    while p < SLOT_COUNT {
        if ord[p] == slot {
            return n
        }
        if hid[ord[p] as usize] == 0 {
            n = n + 1
        }
        p = p + 1
    }
    return SLOT_COUNT
}

fn slot_over_index(slot: u64) -> usize {
    var n: usize = 0
    var p: usize = 0
    while p < SLOT_COUNT {
        if ord[p] == slot {
            return n
        }
        if hid[ord[p] as usize] != 0 {
            n = n + 1
        }
        p = p + 1
    }
    return SLOT_COUNT
}

fn slot_move(slot: u64, to_overflow: bool, idx: usize) -> bool {
    if slot < 1 || slot > SLOT_COUNT as u64 {
        return false
    }
    let old_code: u64 = order_code()
    let old_mask: u64 = hidden_mask()
    var nb: usize = 0
    var no: usize = 0
    var p: usize = 0
    while p < SLOT_COUNT {
        let s: u64 = ord[p]
        if s != slot {
            if hid[s as usize] == 0 {
                tmp_bar[nb] = s
                nb = nb + 1
            } else {
                tmp_over[no] = s
                no = no + 1
            }
        }
        p = p + 1
    }
    if to_overflow {
        var at: usize = idx
        if at > no {
            at = no
        }
        var k: usize = no
        while k > at {
            tmp_over[k] = tmp_over[k - 1]
            k = k - 1
        }
        tmp_over[at] = slot
        no = no + 1
    } else {
        var at2: usize = idx
        if at2 > nb {
            at2 = nb
        }
        var k2: usize = nb
        while k2 > at2 {
            tmp_bar[k2] = tmp_bar[k2 - 1]
            k2 = k2 - 1
        }
        tmp_bar[at2] = slot
        nb = nb + 1
    }
    var w: usize = 0
    var i: usize = 0
    while i < nb {
        ord[w] = tmp_bar[i]
        hid[tmp_bar[i] as usize] = 0
        w = w + 1
        i = i + 1
    }
    i = 0
    while i < no {
        ord[w] = tmp_over[i]
        hid[tmp_over[i] as usize] = 1
        w = w + 1
        i = i + 1
    }
    return order_code() != old_code || hidden_mask() != old_mask
}
