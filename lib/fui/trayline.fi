export {
    F_OWNER, F_ICON, F_TIP, F_OPEN, F_SETTINGS, F_QUIT, F_C1_LABEL, F_C1_CMD, F_C2_LABEL, F_C2_CMD, FIELD_COUNT,
    SEP, NEWLINE, line_end, field_start, field_len, field_copy, field_num, field_is_empty, text_len
}

const F_OWNER: u64 = 0
const F_ICON: u64 = 1
const F_TIP: u64 = 2
const F_OPEN: u64 = 3
const F_SETTINGS: u64 = 4
const F_QUIT: u64 = 5
const F_C1_LABEL: u64 = 6
const F_C1_CMD: u64 = 7
const F_C2_LABEL: u64 = 8
const F_C2_CMD: u64 = 9
const FIELD_COUNT: u64 = 10
const SEP: u8 = 124 as u8
const NEWLINE: u8 = 10 as u8

fn byte_at(p: u64, i: u64) -> u8 {
    return *((p + i) as *mut u8)
}

fn text_len(p: u64) -> u64 {
    var n: u64 = 0
    while byte_at(p, n) != 0 as u8 {
        n = n + 1
    }
    return n
}

fn line_end(buf: u64, len: u64, from: u64) -> u64 {
    var e: u64 = from
    while e < len && byte_at(buf, e) != NEWLINE {
        e = e + 1
    }
    return e
}

fn field_start(buf: u64, from: u64, to: u64, idx: u64) -> u64 {
    var at: u64 = from
    var k: u64 = 0
    while k < idx && at < to {
        if byte_at(buf, at) == SEP {
            k = k + 1
        }
        at = at + 1
    }
    if k < idx {
        return to
    }
    return at
}

fn field_len(buf: u64, from: u64, to: u64, idx: u64) -> u64 {
    let s: u64 = field_start(buf, from, to, idx)
    var e: u64 = s
    while e < to && byte_at(buf, e) != SEP {
        e = e + 1
    }
    return e - s
}

fn field_is_empty(buf: u64, from: u64, to: u64, idx: u64) -> bool {
    return field_len(buf, from, to, idx) == 0
}

fn field_copy(buf: u64, from: u64, to: u64, idx: u64, dst: u64, cap: u64) {
    let s: u64 = field_start(buf, from, to, idx)
    var n: u64 = field_len(buf, from, to, idx)
    if n > cap {
        n = cap
    }
    var i: u64 = 0
    while i < n {
        *((dst + i) as *mut u8) = byte_at(buf, s + i)
        i = i + 1
    }
    *((dst + n) as *mut u8) = 0 as u8
}

fn field_num(buf: u64, from: u64, to: u64, idx: u64) -> u64 {
    let s: u64 = field_start(buf, from, to, idx)
    let n: u64 = field_len(buf, from, to, idx)
    var v: u64 = 0
    var i: u64 = 0
    while i < n {
        let c: u64 = byte_at(buf, s + i) as u64
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
        }
        i = i + 1
    }
    return v
}
