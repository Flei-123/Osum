// SPDX-License-Identifier: GPL-2.0-only
// lib/fui/traypower.fi -- fui.traypower: state and tooltip of the battery / mains tray item (L-006).
//
//     import fui.traypower
//     let st: u64 = traypower.state(have, pct, charging, on_mains)    // BV_* below
//     let n: u64 = traypower.tooltip(have, pct, charging, on_mains, buf, 96)   // NUL terminated, returns the length
//
// The four inputs are what the kernel reports (`osum_pwrget`: PG_BATPRESENT, PG_BATPERCENT, bit 1 of
// PG_BATSTATE, PG_AC) and nothing is worked out beyond them. A machine without battery has NO item (BV_NONE):
// a symbol stands for something the machine HAS. Texts come from set_text slots (English defaults).

export {
    state, tooltip, state_valid, tooltip_valid, glyph_plug, set_text,
    TX_NONE, TX_BATTERY, TX_PCT, TX_DISCHARGING, TX_CHARGING, TX_PLUGGED, TX_LOW, TX_CRITICAL, TX_UNKNOWN,
    BV_NONE, BV_DISCHARGING, BV_CHARGING, BV_PLUGGED, BV_LOW, BV_CRITICAL, BV_UNKNOWN,
    LOW_PCT, CRITICAL_PCT
}

const BV_NONE: u64 = 0 // no battery: no item
const BV_DISCHARGING: u64 = 1 // on battery
const BV_CHARGING: u64 = 2 // on mains and charging
const BV_PLUGGED: u64 = 3 // on mains, not charging (full)
const BV_LOW: u64 = 4 // on battery, 20 % or less
const BV_CRITICAL: u64 = 5 // on battery, 7 % or less
const BV_UNKNOWN: u64 = 6 // battery present, firmware gave no usable charge data

const LOW_PCT: u64 = 20
const CRITICAL_PCT: u64 = 7

const TX_NONE: u64 = 0
const TX_BATTERY: u64 = 1
const TX_PCT: u64 = 2
const TX_DISCHARGING: u64 = 3
const TX_CHARGING: u64 = 4
const TX_PLUGGED: u64 = 5
const TX_LOW: u64 = 6
const TX_CRITICAL: u64 = 7
const TX_UNKNOWN: u64 = 8
const TX_COUNT: u64 = 9
const TX_WIDTH: u64 = 48

static mut txt: [u8; 432] = [0 as u8; 432]
static mut txt_ready: u64 = 0

static mut d_none: [u8; 11] = "No battery\0"
static mut d_battery: [u8; 8] = "Battery\0"
static mut d_pct: [u8; 2] = "%\0"
static mut d_dis: [u8; 11] = "on battery\0"
static mut d_chg: [u8; 9] = "charging\0"
static mut d_plug: [u8; 11] = "plugged in\0"
static mut d_low: [u8; 12] = "battery low\0"
static mut d_crit: [u8; 17] = "battery critical\0"
static mut d_unknown: [u8; 17] = "charge unknown\0\0\0"

fn copy_text(id: u64, src: u64) {
    var i: u64 = 0
    while i + 1 < TX_WIDTH && *((src + i) as *mut u8) != 0 as u8 {
        txt[(id * TX_WIDTH + i) as usize] = *((src + i) as *mut u8)
        i = i + 1
    }
    txt[(id * TX_WIDTH + i) as usize] = 0 as u8
}

fn load_defaults() {
    txt_ready = 1
    copy_text(TX_NONE, (&d_none[0 as usize]) as u64)
    copy_text(TX_BATTERY, (&d_battery[0 as usize]) as u64)
    copy_text(TX_PCT, (&d_pct[0 as usize]) as u64)
    copy_text(TX_DISCHARGING, (&d_dis[0 as usize]) as u64)
    copy_text(TX_CHARGING, (&d_chg[0 as usize]) as u64)
    copy_text(TX_PLUGGED, (&d_plug[0 as usize]) as u64)
    copy_text(TX_LOW, (&d_low[0 as usize]) as u64)
    copy_text(TX_CRITICAL, (&d_crit[0 as usize]) as u64)
    copy_text(TX_UNKNOWN, (&d_unknown[0 as usize]) as u64)
}

fn set_text(id: u64, src: u64) {
    if id >= TX_COUNT || src == 0 {
        return
    }
    if txt_ready == 0 {
        load_defaults()
    }
    copy_text(id, src)
}

fn text_at(id: u64) -> u64 {
    if txt_ready == 0 {
        load_defaults()
    }
    return (&txt[(id * TX_WIDTH) as usize]) as u64
}

fn state(have: u64, pct: u64, charging: u64, on_mains: u64) -> u64 {
    if have == 0 {
        return BV_NONE
    }
    if charging != 0 {
        return BV_CHARGING
    }
    if on_mains != 0 {
        return BV_PLUGGED
    }
    if pct <= CRITICAL_PCT {
        return BV_CRITICAL
    }
    if pct <= LOW_PCT {
        return BV_LOW
    }
    return BV_DISCHARGING
}

fn state_valid(have: u64, valid: u64, pct: u64, charging: u64, on_mains: u64) -> u64 {
    if have != 0 && valid == 0 {
        return BV_UNKNOWN
    }
    return state(have, pct, charging, on_mains)
}

fn tooltip_valid(have: u64, valid: u64, pct: u64, charging: u64, on_mains: u64, out: u64, cap: u64) -> u64 {
    if cap == 0 {
        return 0
    }
    if state_valid(have, valid, pct, charging, on_mains) != BV_UNKNOWN {
        return tooltip(have, pct, charging, on_mains, out, cap)
    }
    var a: u64 = 0
    a = put_s(out, cap, a, text_at(TX_BATTERY))
    a = put(out, cap, a, 44 as u8)
    a = put(out, cap, a, 32 as u8)
    a = put_s(out, cap, a, text_at(TX_UNKNOWN))
    *((out + a) as *mut u8) = 0 as u8
    return a
}

// Does the item show the plug glyph? Exactly when the machine is on mains.
fn glyph_plug(st: u64) -> bool {
    return st == BV_CHARGING || st == BV_PLUGGED
}

fn put(out: u64, cap: u64, at: u64, c: u8) -> u64 {
    if at + 1 < cap {
        *((out + at) as *mut u8) = c
        return at + 1
    }
    return at
}

fn put_s(out: u64, cap: u64, at: u64, s: u64) -> u64 {
    var i: u64 = 0
    var a: u64 = at
    while *((s + i) as *mut u8) != 0 as u8 {
        a = put(out, cap, a, *((s + i) as *mut u8))
        i = i + 1
    }
    return a
}

fn put_dec(out: u64, cap: u64, at: u64, v: u64) -> u64 {
    var a: u64 = at
    if v >= 100 {
        a = put(out, cap, a, (48 + (v / 100) % 10) as u8)
    }
    if v >= 10 {
        a = put(out, cap, a, (48 + (v / 10) % 10) as u8)
    }
    return put(out, cap, a, (48 + v % 10) as u8)
}

fn tooltip(have: u64, pct: u64, charging: u64, on_mains: u64, out: u64, cap: u64) -> u64 {
    if cap == 0 {
        return 0
    }
    let st: u64 = state(have, pct, charging, on_mains)
    var a: u64 = 0
    if st == BV_NONE {
        a = put_s(out, cap, a, text_at(TX_NONE))
        *((out + a) as *mut u8) = 0 as u8
        return a
    }
    var p: u64 = pct
    if p > 100 {
        p = 100
    }
    a = put_s(out, cap, a, text_at(TX_BATTERY))
    a = put(out, cap, a, 32 as u8)
    a = put_dec(out, cap, a, p)
    a = put(out, cap, a, 32 as u8)
    a = put_s(out, cap, a, text_at(TX_PCT))
    a = put(out, cap, a, 44 as u8)
    a = put(out, cap, a, 32 as u8)
    if st == BV_CHARGING {
        a = put_s(out, cap, a, text_at(TX_CHARGING))
    } else if st == BV_PLUGGED {
        a = put_s(out, cap, a, text_at(TX_PLUGGED))
    } else if st == BV_CRITICAL {
        a = put_s(out, cap, a, text_at(TX_CRITICAL))
    } else if st == BV_LOW {
        a = put_s(out, cap, a, text_at(TX_LOW))
    } else {
        a = put_s(out, cap, a, text_at(TX_DISCHARGING))
    }
    *((out + a) as *mut u8) = 0 as u8
    return a
}
