import libc.octets

export {
    OK, CANCELED, NO_BACKEND, FAILED, BUSY, NOT_FOUND, INVALID,
    CAP_FILE_OPEN, CAP_FILE_SAVE, CAP_CLIP_WRITE, CAP_CLIP_READ, CAP_DIALOG, CAP_STORAGE, CAP_ASYNC_HOST,
    NAME_MAX, VALUE_MAX, PATH_MAX, has, status_name, valid_name, valid_key, store_dir, store_path,
}

const OK: u64 = 0
const CANCELED: u64 = 1
const NO_BACKEND: u64 = 2
const FAILED: u64 = 3
const BUSY: u64 = 4
const NOT_FOUND: u64 = 5
const INVALID: u64 = 6

const CAP_FILE_OPEN: u64 = 1
const CAP_FILE_SAVE: u64 = 2
const CAP_CLIP_WRITE: u64 = 4
const CAP_CLIP_READ: u64 = 8
const CAP_DIALOG: u64 = 16
const CAP_STORAGE: u64 = 32
const CAP_ASYNC_HOST: u64 = 64

const NAME_MAX: u64 = 64
const VALUE_MAX: u64 = 65536
const PATH_MAX: u64 = 160
const DOT: u64 = 46
const SLASH: u64 = 47

static mut STATUS_NAMES: [u8; 54] = "ok\0canceled\0no-backend\0failed\0busy\0not-found\0invalid\0\0"
static mut ROOT: [u8; 7] = "/data/\0"
static mut SUBDIR: [u8; 10] = "/services\0"

fn has(caps: u64, cap: u64) -> bool {
    return (caps & cap) == cap
}

fn status_name(status: u64) -> u64 {
    var at: u64 = 0
    var index: u64 = 0
    let table: u64 = (&STATUS_NAMES[0 as usize]) as u64
    var wanted: u64 = status
    if wanted > INVALID {
        wanted = FAILED
    }
    while index < wanted {
        while octets.ld8(table, at) != 0 {
            at = at + 1
        }
        at = at + 1
        index = index + 1
    }
    return table + at
}

fn name_char(c: u64) -> bool {
    if c >= 48 && c <= 57 {
        return true
    }
    if c >= 65 && c <= 90 {
        return true
    }
    if c >= 97 && c <= 122 {
        return true
    }
    return c == DOT || c == 45 || c == 95
}

fn valid_name(p: u64, n: u64) -> bool {
    if n == 0 || n > NAME_MAX {
        return false
    }
    if octets.ld8(p, 0) == DOT {
        return false
    }
    var i: u64 = 0
    while i < n {
        if !name_char(octets.ld8(p, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn valid_key(p: u64, n: u64) -> bool {
    return valid_name(p, n)
}

fn put_all(out: u64, at: u64, src: u64, n: u64) -> u64 {
    octets.copy(out + at, src, n)
    return at + n
}

fn store_dir(app: u64, app_len: u64, out: u64, max: u64) -> u64 {
    if !valid_name(app, app_len) {
        return 0
    }
    let root_len: u64 = 6
    let sub_len: u64 = 9
    if root_len + app_len + sub_len + 1 > max {
        return 0
    }
    var at: u64 = put_all(out, 0, (&ROOT[0 as usize]) as u64, root_len)
    at = put_all(out, at, app, app_len)
    at = put_all(out, at, (&SUBDIR[0 as usize]) as u64, sub_len)
    octets.st8(out, at, 0)
    return at
}

fn store_path(app: u64, app_len: u64, key: u64, key_len: u64, out: u64, max: u64) -> u64 {
    if !valid_key(key, key_len) {
        return 0
    }
    var at: u64 = store_dir(app, app_len, out, max)
    if at == 0 || at + 1 + key_len + 1 > max {
        return 0
    }
    octets.st8(out, at, SLASH)
    at = put_all(out, at + 1, key, key_len)
    octets.st8(out, at, 0)
    return at
}
