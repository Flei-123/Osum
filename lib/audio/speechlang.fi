profile kernel

import audio.speechphon
import audio.speechphon_de

export { select, set, current, to_phonemes, LANG_EN, LANG_DE, LANG_COUNT }

const LANG_EN: u64 = 0
const LANG_DE: u64 = 1
const LANG_COUNT: u64 = 2

static mut codes: [u8; 5] = "ende\0"
static mut cur: u64 = 0

fn set(id: u64) {
    if id < LANG_COUNT {
        cur = id
    } else {
        cur = LANG_EN
    }
}

fn current() -> u64 {
    return cur
}

fn select(code: u64) -> u64 {
    var id: u64 = 0
    while id < LANG_COUNT {
        if *((code) as *mut u8) == codes[(id * 2) as usize] && *((code + 1) as *mut u8) == codes[(id * 2 + 1) as usize] {
            let after: u8 = *((code + 2) as *mut u8)
            if after < 97 as u8 || after > 122 as u8 {
                cur = id
                return id
            }
        }
        id = id + 1
    }
    cur = LANG_EN
    return LANG_EN
}

fn to_phonemes(text: u64, out: u64, cap: u64) -> u64 {
    if cur == LANG_DE {
        return speechphon_de.to_phonemes(text, out, cap)
    }
    return speechphon.to_phonemes(text, out, cap)
}
