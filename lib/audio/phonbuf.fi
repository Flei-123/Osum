// SPDX-License-Identifier: MPL-2.0
profile kernel

export {
    begin, emit, emit_pause, count, at_out,
    PH_WORD, PH_COMMA, PH_STOP, PH_A, PH_E, PH_I, PH_O, PH_U, PH_SCHWA, PH_M, PH_N, PH_L, PH_R, PH_W, PH_Y,
    PH_S, PH_SH, PH_F, PH_H, PH_TH, PH_Z, PH_V, PH_P, PH_T, PH_K, PH_B, PH_D, PH_G,
    PH_AL, PH_EL, PH_IL, PH_OL, PH_UL, PH_UE, PH_UEL, PH_OE, PH_OEL, PH_CI, PH_CA, PH_NG, PH_COUNT
}

const PH_WORD: u8 = 0
const PH_COMMA: u8 = 1
const PH_STOP: u8 = 2
const PH_A: u8 = 3
const PH_E: u8 = 4
const PH_I: u8 = 5
const PH_O: u8 = 6
const PH_U: u8 = 7
const PH_SCHWA: u8 = 8
const PH_M: u8 = 9
const PH_N: u8 = 10
const PH_L: u8 = 11
const PH_R: u8 = 12
const PH_W: u8 = 13
const PH_Y: u8 = 14
const PH_S: u8 = 15
const PH_SH: u8 = 16
const PH_F: u8 = 17
const PH_H: u8 = 18
const PH_TH: u8 = 19
const PH_Z: u8 = 20
const PH_V: u8 = 21
const PH_P: u8 = 22
const PH_T: u8 = 23
const PH_K: u8 = 24
const PH_B: u8 = 25
const PH_D: u8 = 26
const PH_G: u8 = 27
const PH_AL: u8 = 28
const PH_EL: u8 = 29
const PH_IL: u8 = 30
const PH_OL: u8 = 31
const PH_UL: u8 = 32
const PH_UE: u8 = 33
const PH_UEL: u8 = 34
const PH_OE: u8 = 35
const PH_OEL: u8 = 36
const PH_CI: u8 = 37
const PH_CA: u8 = 38
const PH_NG: u8 = 39
const PH_COUNT: u64 = 40

static mut out_n: u64 = 0
static mut out_cap: u64 = 0
static mut out_p: u64 = 0

fn begin(out: u64, cap: u64) {
    out_n = 0
    out_cap = cap
    out_p = out
}

fn count() -> u64 {
    return out_n
}

fn at_out(i: u64) -> u8 {
    if i >= out_n {
        return 0 as u8
    }
    return *((out_p + i) as *mut u8)
}

fn emit(ph: u8) {
    if out_n < out_cap {
        *((out_p + out_n) as *mut u8) = ph
        out_n = out_n + 1
    }
}

fn emit_pause(ph: u8) {
    if out_n == 0 {
        return
    }
    let last: u8 = *((out_p + out_n - 1) as *mut u8)
    if last <= PH_STOP {
        if last < ph {
            *((out_p + out_n - 1) as *mut u8) = ph
        }
        return
    }
    emit(ph)
}
