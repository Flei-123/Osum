// SPDX-License-Identifier: MPL-2.0
// lib/audio/speechphon.fi -- audio.speechphon: letter-to-phoneme rules (English-like, rough) for the speech synthesizer.
profile kernel

import audio.phonbuf

export { to_phonemes }

static mut wbuf: [u8; 64] = [0 as u8; 64]

fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

fn is_letter(c: u8) -> bool {
    return c >= 97 as u8 && c <= 122 as u8
}

fn is_vowel(c: u8) -> bool {
    return c == 97 as u8 || c == 101 as u8 || c == 105 as u8 || c == 111 as u8 || c == 117 as u8
}

fn at(w: u64, i: u64, n: u64) -> u8 {
    if i >= n {
        return 0 as u8
    }
    return *((w + i) as *mut u8)
}

fn word_to_ph(w: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        let c: u8 = at(w, i, n)
        let nx: u8 = at(w, i + 1, n)
        var prev: u8 = 0 as u8
        if i > 0 {
            prev = at(w, i - 1, n)
        }
        if c == nx && !is_vowel(c) {
            i = i + 1
            continue
        }
        if c == 97 as u8 {
            phonbuf.emit(phonbuf.PH_A)
        } else if c == 101 as u8 {
            if nx == 101 as u8 {
                phonbuf.emit(phonbuf.PH_I)
                i = i + 2
                continue
            }
            if !(nx == 0 as u8 && n > 3 && !is_vowel(prev)) {
                phonbuf.emit(phonbuf.PH_E)
            }
        } else if c == 105 as u8 {
            phonbuf.emit(phonbuf.PH_I)
        } else if c == 111 as u8 {
            if nx == 111 as u8 {
                phonbuf.emit(phonbuf.PH_U)
                i = i + 2
                continue
            }
            phonbuf.emit(phonbuf.PH_O)
        } else if c == 117 as u8 {
            phonbuf.emit(phonbuf.PH_U)
        } else if c == 121 as u8 {
            if i == 0 {
                phonbuf.emit(phonbuf.PH_Y)
            } else {
                phonbuf.emit(phonbuf.PH_I)
            }
        } else if c == 98 as u8 {
            phonbuf.emit(phonbuf.PH_B)
        } else if c == 99 as u8 {
            if nx == 104 as u8 {
                phonbuf.emit(phonbuf.PH_T)
                phonbuf.emit(phonbuf.PH_SH)
                i = i + 2
                continue
            }
            if nx == 107 as u8 {
                phonbuf.emit(phonbuf.PH_K)
                i = i + 2
                continue
            }
            if nx == 101 as u8 || nx == 105 as u8 || nx == 121 as u8 {
                phonbuf.emit(phonbuf.PH_S)
            } else {
                phonbuf.emit(phonbuf.PH_K)
            }
        } else if c == 100 as u8 {
            phonbuf.emit(phonbuf.PH_D)
        } else if c == 102 as u8 {
            phonbuf.emit(phonbuf.PH_F)
        } else if c == 103 as u8 {
            phonbuf.emit(phonbuf.PH_G)
        } else if c == 104 as u8 {
            phonbuf.emit(phonbuf.PH_H)
        } else if c == 106 as u8 {
            phonbuf.emit(phonbuf.PH_D)
            phonbuf.emit(phonbuf.PH_SH)
        } else if c == 107 as u8 {
            phonbuf.emit(phonbuf.PH_K)
        } else if c == 108 as u8 {
            phonbuf.emit(phonbuf.PH_L)
        } else if c == 109 as u8 {
            phonbuf.emit(phonbuf.PH_M)
        } else if c == 110 as u8 {
            phonbuf.emit(phonbuf.PH_N)
            if nx == 103 as u8 && i + 2 == n {
                i = i + 2
                continue
            }
        } else if c == 112 as u8 {
            if nx == 104 as u8 {
                phonbuf.emit(phonbuf.PH_F)
                i = i + 2
                continue
            }
            phonbuf.emit(phonbuf.PH_P)
        } else if c == 113 as u8 {
            phonbuf.emit(phonbuf.PH_K)
            phonbuf.emit(phonbuf.PH_W)
            if nx == 117 as u8 {
                i = i + 2
                continue
            }
        } else if c == 114 as u8 {
            phonbuf.emit(phonbuf.PH_R)
        } else if c == 115 as u8 {
            if nx == 104 as u8 {
                phonbuf.emit(phonbuf.PH_SH)
                i = i + 2
                continue
            }
            phonbuf.emit(phonbuf.PH_S)
        } else if c == 116 as u8 {
            if nx == 104 as u8 {
                phonbuf.emit(phonbuf.PH_TH)
                i = i + 2
                continue
            }
            phonbuf.emit(phonbuf.PH_T)
        } else if c == 118 as u8 {
            phonbuf.emit(phonbuf.PH_V)
        } else if c == 119 as u8 {
            phonbuf.emit(phonbuf.PH_W)
            if nx == 104 as u8 {
                i = i + 2
                continue
            }
        } else if c == 120 as u8 {
            phonbuf.emit(phonbuf.PH_K)
            phonbuf.emit(phonbuf.PH_S)
        } else if c == 122 as u8 {
            phonbuf.emit(phonbuf.PH_Z)
        }
        i = i + 1
    }
}

fn digit_word(d: u64) {
    var n: u64 = 0
    var w: [u8; 6] = [0 as u8; 6]
    if d == 0 {
        w[0 as usize] = 122 as u8
        w[1 as usize] = 101 as u8
        w[2 as usize] = 114 as u8
        w[3 as usize] = 111 as u8
        n = 4
    } else if d == 1 {
        w[0 as usize] = 119 as u8
        w[1 as usize] = 117 as u8
        w[2 as usize] = 110 as u8
        n = 3
    } else if d == 2 {
        w[0 as usize] = 116 as u8
        w[1 as usize] = 117 as u8
        n = 2
    } else if d == 3 {
        w[0 as usize] = 116 as u8
        w[1 as usize] = 104 as u8
        w[2 as usize] = 114 as u8
        w[3 as usize] = 105 as u8
        n = 4
    } else if d == 4 {
        w[0 as usize] = 102 as u8
        w[1 as usize] = 111 as u8
        w[2 as usize] = 114 as u8
        n = 3
    } else if d == 5 {
        w[0 as usize] = 102 as u8
        w[1 as usize] = 105 as u8
        w[2 as usize] = 118 as u8
        n = 3
    } else if d == 6 {
        w[0 as usize] = 115 as u8
        w[1 as usize] = 105 as u8
        w[2 as usize] = 107 as u8
        w[3 as usize] = 115 as u8
        n = 4
    } else if d == 7 {
        w[0 as usize] = 115 as u8
        w[1 as usize] = 101 as u8
        w[2 as usize] = 118 as u8
        w[3 as usize] = 110 as u8
        n = 4
    } else if d == 8 {
        w[0 as usize] = 101 as u8
        w[1 as usize] = 116 as u8
        n = 2
    } else {
        w[0 as usize] = 110 as u8
        w[1 as usize] = 105 as u8
        w[2 as usize] = 110 as u8
        n = 3
    }
    phonbuf.emit_pause(phonbuf.PH_WORD)
    word_to_ph((&w[0 as usize]) as u64, n)
    phonbuf.emit_pause(phonbuf.PH_WORD)
}

fn to_phonemes(text: u64, out: u64, cap: u64) -> u64 {
    phonbuf.begin(out, cap)
    var wn: u64 = 0
    let wp: u64 = (&wbuf[0 as usize]) as u64
    var i: u64 = 0
    var guard: u64 = 0
    while guard < 512 {
        guard = guard + 1
        var c: u8 = *((text + i) as *mut u8)
        if c == 0 as u8 {
            break
        }
        i = i + 1
        if c == 195 as u8 {
            let d: u8 = *((text + i) as *mut u8)
            if d != 0 as u8 {
                i = i + 1
            }
            if d == 164 as u8 || d == 132 as u8 {
                c = 101 as u8
            } else if d == 182 as u8 || d == 150 as u8 {
                c = 111 as u8
            } else if d == 188 as u8 || d == 156 as u8 {
                c = 117 as u8
            } else if d == 159 as u8 {
                c = 115 as u8
            } else {
                c = 32 as u8
            }
        }
        c = lower(c)
        if is_letter(c) {
            if wn < 63 {
                *((wp + wn) as *mut u8) = c
                wn = wn + 1
            }
        } else {
            if wn > 0 {
                word_to_ph(wp, wn)
                wn = 0
            }
            if c >= 48 as u8 && c <= 57 as u8 {
                digit_word((c - 48 as u8) as u64)
            } else if c == 44 as u8 || c == 59 as u8 || c == 58 as u8 {
                phonbuf.emit_pause(phonbuf.PH_COMMA)
            } else if c == 46 as u8 || c == 33 as u8 || c == 63 as u8 {
                phonbuf.emit_pause(phonbuf.PH_STOP)
            } else {
                phonbuf.emit_pause(phonbuf.PH_WORD)
            }
        }
    }
    if wn > 0 {
        word_to_ph(wp, wn)
    }
    return phonbuf.count()
}
