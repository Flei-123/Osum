// SPDX-License-Identifier: MPL-2.0
// lib/audio/speechphon.fi -- audio.speechphon: letter-to-phoneme rules (English-like, rough) for the speech synthesizer.
profile kernel

export {
    to_phonemes, PH_WORD, PH_COMMA, PH_STOP, PH_A, PH_E, PH_I, PH_O, PH_U, PH_SCHWA, PH_M, PH_N, PH_L, PH_R, PH_W, PH_Y,
    PH_S, PH_SH, PH_F, PH_H, PH_TH, PH_Z, PH_V, PH_P, PH_T, PH_K, PH_B, PH_D, PH_G, PH_COUNT
}

const PH_WORD: u8 = 0
const PH_COMMA: u8 = 1
const PH_STOP: u8 = 2
const PH_A: u8 = 3
const PH_E: u8 = 4
const PH_I: u8 = 5
const PH_O: u8 = 6
const PH_U: u8 = 7
const PH_SCHWA: u8 = 8
const PH_M: u8 = 9
const PH_N: u8 = 10
const PH_L: u8 = 11
const PH_R: u8 = 12
const PH_W: u8 = 13
const PH_Y: u8 = 14
const PH_S: u8 = 15
const PH_SH: u8 = 16
const PH_F: u8 = 17
const PH_H: u8 = 18
const PH_TH: u8 = 19
const PH_Z: u8 = 20
const PH_V: u8 = 21
const PH_P: u8 = 22
const PH_T: u8 = 23
const PH_K: u8 = 24
const PH_B: u8 = 25
const PH_D: u8 = 26
const PH_G: u8 = 27
const PH_COUNT: u64 = 28

static mut wbuf: [u8; 64] = [0 as u8; 64]
static mut out_n: u64 = 0
static mut out_cap: u64 = 0
static mut out_p: u64 = 0

fn emit(ph: u8) {
    if out_n < out_cap {
        *((out_p + out_n) as *mut u8) = ph
        out_n = out_n + 1
    }
}

fn emit_pause(ph: u8) {
    if out_n == 0 {
        return
    }
    let last: u8 = *((out_p + out_n - 1) as *mut u8)
    if last <= PH_STOP {
        if last < ph {
            *((out_p + out_n - 1) as *mut u8) = ph
        }
        return
    }
    emit(ph)
}

fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 {
        return c + 32 as u8
    }
    return c
}

fn is_letter(c: u8) -> bool {
    return c >= 97 as u8 && c <= 122 as u8
}

fn is_vowel(c: u8) -> bool {
    return c == 97 as u8 || c == 101 as u8 || c == 105 as u8 || c == 111 as u8 || c == 117 as u8
}

fn at(w: u64, i: u64, n: u64) -> u8 {
    if i >= n {
        return 0 as u8
    }
    return *((w + i) as *mut u8)
}

fn word_to_ph(w: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        let c: u8 = at(w, i, n)
        let nx: u8 = at(w, i + 1, n)
        var prev: u8 = 0 as u8
        if i > 0 {
            prev = at(w, i - 1, n)
        }
        if c == nx && !is_vowel(c) {
            i = i + 1
            continue
        }
        if c == 97 as u8 {
            emit(PH_A)
        } else if c == 101 as u8 {
            if nx == 101 as u8 {
                emit(PH_I)
                i = i + 2
                continue
            }
            if !(nx == 0 as u8 && n > 3 && !is_vowel(prev)) {
                emit(PH_E)
            }
        } else if c == 105 as u8 {
            emit(PH_I)
        } else if c == 111 as u8 {
            if nx == 111 as u8 {
                emit(PH_U)
                i = i + 2
                continue
            }
            emit(PH_O)
        } else if c == 117 as u8 {
            emit(PH_U)
        } else if c == 121 as u8 {
            if i == 0 {
                emit(PH_Y)
            } else {
                emit(PH_I)
            }
        } else if c == 98 as u8 {
            emit(PH_B)
        } else if c == 99 as u8 {
            if nx == 104 as u8 {
                emit(PH_T)
                emit(PH_SH)
                i = i + 2
                continue
            }
            if nx == 107 as u8 {
                emit(PH_K)
                i = i + 2
                continue
            }
            if nx == 101 as u8 || nx == 105 as u8 || nx == 121 as u8 {
                emit(PH_S)
            } else {
                emit(PH_K)
            }
        } else if c == 100 as u8 {
            emit(PH_D)
        } else if c == 102 as u8 {
            emit(PH_F)
        } else if c == 103 as u8 {
            emit(PH_G)
        } else if c == 104 as u8 {
            emit(PH_H)
        } else if c == 106 as u8 {
            emit(PH_D)
            emit(PH_SH)
        } else if c == 107 as u8 {
            emit(PH_K)
        } else if c == 108 as u8 {
            emit(PH_L)
        } else if c == 109 as u8 {
            emit(PH_M)
        } else if c == 110 as u8 {
            emit(PH_N)
            if nx == 103 as u8 && i + 2 == n {
                i = i + 2
                continue
            }
        } else if c == 112 as u8 {
            if nx == 104 as u8 {
                emit(PH_F)
                i = i + 2
                continue
            }
            emit(PH_P)
        } else if c == 113 as u8 {
            emit(PH_K)
            emit(PH_W)
            if nx == 117 as u8 {
                i = i + 2
                continue
            }
        } else if c == 114 as u8 {
            emit(PH_R)
        } else if c == 115 as u8 {
            if nx == 104 as u8 {
                emit(PH_SH)
                i = i + 2
                continue
            }
            emit(PH_S)
        } else if c == 116 as u8 {
            if nx == 104 as u8 {
                emit(PH_TH)
                i = i + 2
                continue
            }
            emit(PH_T)
        } else if c == 118 as u8 {
            emit(PH_V)
        } else if c == 119 as u8 {
            emit(PH_W)
            if nx == 104 as u8 {
                i = i + 2
                continue
            }
        } else if c == 120 as u8 {
            emit(PH_K)
            emit(PH_S)
        } else if c == 122 as u8 {
            emit(PH_Z)
        }
        i = i + 1
    }
}

fn digit_word(d: u64) {
    var n: u64 = 0
    var w: [u8; 6] = [0 as u8; 6]
    if d == 0 {
        w[0 as usize] = 122 as u8
        w[1 as usize] = 101 as u8
        w[2 as usize] = 114 as u8
        w[3 as usize] = 111 as u8
        n = 4
    } else if d == 1 {
        w[0 as usize] = 119 as u8
        w[1 as usize] = 117 as u8
        w[2 as usize] = 110 as u8
        n = 3
    } else if d == 2 {
        w[0 as usize] = 116 as u8
        w[1 as usize] = 117 as u8
        n = 2
    } else if d == 3 {
        w[0 as usize] = 116 as u8
        w[1 as usize] = 104 as u8
        w[2 as usize] = 114 as u8
        w[3 as usize] = 105 as u8
        n = 4
    } else if d == 4 {
        w[0 as usize] = 102 as u8
        w[1 as usize] = 111 as u8
        w[2 as usize] = 114 as u8
        n = 3
    } else if d == 5 {
        w[0 as usize] = 102 as u8
        w[1 as usize] = 105 as u8
        w[2 as usize] = 118 as u8
        n = 3
    } else if d == 6 {
        w[0 as usize] = 115 as u8
        w[1 as usize] = 105 as u8
        w[2 as usize] = 107 as u8
        w[3 as usize] = 115 as u8
        n = 4
    } else if d == 7 {
        w[0 as usize] = 115 as u8
        w[1 as usize] = 101 as u8
        w[2 as usize] = 118 as u8
        w[3 as usize] = 110 as u8
        n = 4
    } else if d == 8 {
        w[0 as usize] = 101 as u8
        w[1 as usize] = 116 as u8
        n = 2
    } else {
        w[0 as usize] = 110 as u8
        w[1 as usize] = 105 as u8
        w[2 as usize] = 110 as u8
        n = 3
    }
    emit_pause(PH_WORD)
    word_to_ph((&w[0 as usize]) as u64, n)
    emit_pause(PH_WORD)
}

fn to_phonemes(text: u64, out: u64, cap: u64) -> u64 {
    out_n = 0
    out_cap = cap
    out_p = out
    var wn: u64 = 0
    let wp: u64 = (&wbuf[0 as usize]) as u64
    var i: u64 = 0
    var guard: u64 = 0
    while guard < 512 {
        guard = guard + 1
        var c: u8 = *((text + i) as *mut u8)
        if c == 0 as u8 {
            break
        }
        i = i + 1
        if c == 195 as u8 {
            let d: u8 = *((text + i) as *mut u8)
            if d != 0 as u8 {
                i = i + 1
            }
            if d == 164 as u8 || d == 132 as u8 {
                c = 101 as u8
            } else if d == 182 as u8 || d == 150 as u8 {
                c = 111 as u8
            } else if d == 188 as u8 || d == 156 as u8 {
                c = 117 as u8
            } else if d == 159 as u8 {
                c = 115 as u8
            } else {
                c = 32 as u8
            }
        }
        c = lower(c)
        if is_letter(c) {
            if wn < 63 {
                *((wp + wn) as *mut u8) = c
                wn = wn + 1
            }
        } else {
            if wn > 0 {
                word_to_ph(wp, wn)
                wn = 0
            }
            if c >= 48 as u8 && c <= 57 as u8 {
                digit_word((c - 48 as u8) as u64)
            } else if c == 44 as u8 || c == 59 as u8 || c == 58 as u8 {
                emit_pause(PH_COMMA)
            } else if c == 46 as u8 || c == 33 as u8 || c == 63 as u8 {
                emit_pause(PH_STOP)
            } else {
                emit_pause(PH_WORD)
            }
        }
    }
    if wn > 0 {
        word_to_ph(wp, wn)
    }
    return out_n
}
