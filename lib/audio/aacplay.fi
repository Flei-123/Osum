import std.rt
import media.audio.aac.aac_state
import media.audio.aac.aac_init
import media.audio.aac.aac_frame

export { aacplay_open, aacplay_adts, aacplay_free, aacplay_reset, aacplay_decode, aacplay_channels, aacplay_hz, FRAME_SAMPLES }

const FRAME_SAMPLES: u64 = 1024

fn alloc_state[T]() -> u64 {
    return rt.heap_alloc(size_of[T]())
}

fn session(h: u64) -> *mut aac_state.Aac {
    return h as *mut aac_state.Aac
}

fn aacplay_open(asc: u64, asc_len: usize) -> u64 {
    let h: u64 = alloc_state[aac_state.Aac]()
    if h == 0 { return 0 }
    *session(h) = aac_init.aac_new()
    if aac_init.aac_config(session(h), asc, asc_len) != 0 {
        rt.heap_free(h, state_size[aac_state.Aac]())
        return 0
    }
    return h
}

fn aacplay_adts(rate_idx: u32, chan_cfg: u32) -> u64 {
    let h: u64 = alloc_state[aac_state.Aac]()
    if h == 0 { return 0 }
    *session(h) = aac_init.aac_new()
    if aac_init.aac_config_adts(session(h), rate_idx, chan_cfg) != 0 {
        rt.heap_free(h, state_size[aac_state.Aac]())
        return 0
    }
    return h
}

fn state_size[T]() -> usize {
    return size_of[T]()
}

fn aacplay_free(h: u64) {
    aac_init.aac_free(session(h))
    rt.heap_free(h, state_size[aac_state.Aac]())
}

fn aacplay_reset(h: u64) {
    aac_init.aac_reset(session(h))
}

fn aacplay_decode(h: u64, data: u64, n: usize, pcm: u64) -> u64 {
    return aac_frame.aac_decode(session(h), data, n, pcm) as u64
}

fn aacplay_channels(h: u64) -> u64 {
    return aac_init.aac_channels(session(h)) as u64
}

fn aacplay_hz(h: u64) -> u64 {
    return aac_init.aac_hz(session(h)) as u64
}
