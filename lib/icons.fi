    if i == 22 { return 0xE043 }
    if i == 23 { return 0xE060 }
    if i == 24 { return 0xE061 }
    if i == 25 { return 0xE062 }
    if i == 26 { return 0xE063 }
    if i == 27 { return 0xE064 }
    if i == 28 { return 0xE065 }
    if i == 29 { return 0xE066 }
    if i == 30 { return 0xE067 }
    if i == 31 { return 0xE068 }
    if i == 32 { return 0xE080 }
