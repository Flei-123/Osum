    if i == 45 { return 0xE0A6 }
    if i == 46 { return 0xE0A7 }
    if i == 47 { return 0xE0A8 }
    if i == 48 { return 0xE0A9 }
    if i == 49 { return 0xE0AA }
    if i == 50 { return 0xE0AB }
    if i == 51 { return 0xE0AC }
    if i == 52 { return 0xE0C0 }
    if i == 53 { return 0xE0C1 }
    if i == 54 { return 0xE0C2 }
