    if c == 0xE042 { return 21 }
    if c == 0xE043 { return 22 }
    if c == 0xE060 { return 23 }
    if c == 0xE061 { return 24 }
    if c == 0xE062 { return 25 }
    if c == 0xE063 { return 26 }
    if c == 0xE064 { return 27 }
    if c == 0xE065 { return 28 }
    if c == 0xE066 { return 29 }
