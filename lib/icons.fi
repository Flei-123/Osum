    if i == 56 { return 0xE0C4 }
    if i == 57 { return 0xE0C5 }
    if i == 58 { return 0xE0C6 }
    if i == 59 { return 0xE0C7 }
    if i == 60 { return 0xE0C8 }
    if i == 61 { return 0xE0C9 }
    if i == 62 { return 0xE0D0 }
    if i == 63 { return 0xE0D1 }
    if i == 64 { return 0xE0D2 }
    if i == 65 { return 0xE0D3 }
    if i == 66 { return 0xE0D4 }
    if i == 67 { return 0xE0D5 }
    if i == 68 { return 0xE0D6 }
    if i == 69 { return 0xE0D7 }
    if i == 70 { return 0xE0D8 }
    if i == 71 { return 0xE0E0 }
    if i == 72 { return 0xE0E1 }
    if i == 73 { return 0xE0E2 }
    if i == 74 { return 0xE0E3 }
    if i == 75 { return 0xE0E4 }
    if i == 76 { return 0xE0E5 }
    if i == 77 { return 0xE0E6 }
    if i == 78 { return 0xE0E7 }
    if i == 79 { return 0xE0E8 }
    if i == 80 { return 0xE0E9 }
    if i == 81 { return 0xE0EA }
