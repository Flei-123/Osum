// lib/icons.fi -- GENERATED by tools/icons/build.py out of assets/icons/icons.map.
//
// DO NOT EDIT.  Change the map and run the builder; the test in
// tools/icons/run.sh rebuilds this file and fails if it differs from
// what is committed.
//
// One constant per icon name.  A code point never appears in drawing
// code -- `tools/icons/rawcp.py` counts the ones that do, and the
// answer has to stay 0.  The reason is plain: 0xE041 is a number with
// no meaning, `icons.WINDOW_MINIMISE` is a name that can be looked up.
//
// The glyphs live in assets/osum-icons.ttf, installed as /lib/icons.ttf,
// cut from Lucide (ISC, assets/icons/LICENSE.lucide).  See docs/ICONS.md.
//
//   names      45 (42 glyphs, 3 aliases)
//   font       13584 octets, cut from 680144
//   upm        1000, ascent 1000, descent 0

profile kernel

export {
    COUNT, FIRST, LAST, UPM,
    NETWORK_WIRED, NETWORK_OFFLINE, NETWORK_NO_INTERNET, NETWORK_FAKED,
    NETWORK_BLOCKED, NETWORK_FILTERED, BATTERY_FULL, BATTERY_MEDIUM,
    BATTERY_LOW, BATTERY_EMPTY, BATTERY_CHARGING, BATTERY_ABSENT,
    WINDOW_CLOSE, WINDOW_MINIMISE, WINDOW_MAXIMISE, WINDOW_RESTORE,
    ARROW_LEFT, ARROW_RIGHT, ARROW_UP, ARROW_DOWN,
    CHEVRON_LEFT, CHEVRON_RIGHT, CHEVRON_UP, CHEVRON_DOWN,
    NAV_REFRESH, NAV_BACK, NAV_FORWARD, NAV_UP,
    FILE_FOLDER, FILE_FOLDER_OPEN, FILE_FILE, FILE_TEXT,
    FILE_IMAGE, FILE_PROGRAM, FILE_DRIVE, SETTINGS,
    SEARCH, START, TRASH, WARNING,
    ERROR, SUCCESS, INFO, CHECK,
    MENU,
    is_icon, index_of, at_index
}

// How many names there are, and the range they live in. A caller that
// walks the whole set -- the test program, the sheet -- uses these
// instead of a number it typed in itself.
const COUNT: u64 = 42
const FIRST: u64 = 0xE000
const LAST: u64 = 0xE0A9
const UPM: u64 = 1000


// --- network
const NETWORK_WIRED           : u64 = 0xE000 // cable
const NETWORK_OFFLINE         : u64 = 0xE001 // unplug
const NETWORK_NO_INTERNET     : u64 = 0xE002 // cloud-off
const NETWORK_FAKED           : u64 = 0xE003 // venetian-mask
const NETWORK_BLOCKED         : u64 = 0xE004 // ban
const NETWORK_FILTERED        : u64 = 0xE005 // filter

// --- battery
const BATTERY_FULL            : u64 = 0xE020 // battery-full
const BATTERY_MEDIUM          : u64 = 0xE021 // battery-medium
const BATTERY_LOW             : u64 = 0xE022 // battery-low
const BATTERY_EMPTY           : u64 = 0xE023 // battery
const BATTERY_CHARGING        : u64 = 0xE024 // battery-charging
const BATTERY_ABSENT          : u64 = 0xE025 // battery-warning

// --- window
const WINDOW_CLOSE            : u64 = 0xE040 // x
const WINDOW_MINIMISE         : u64 = 0xE041 // minus
const WINDOW_MAXIMISE         : u64 = 0xE042 // square
const WINDOW_RESTORE          : u64 = 0xE043 // copy

// --- arrow
const ARROW_LEFT              : u64 = 0xE060 // arrow-left
const ARROW_RIGHT             : u64 = 0xE061 // arrow-right
const ARROW_UP                : u64 = 0xE062 // arrow-up
const ARROW_DOWN              : u64 = 0xE063 // arrow-down

// --- chevron
const CHEVRON_LEFT            : u64 = 0xE064 // chevron-left
const CHEVRON_RIGHT           : u64 = 0xE065 // chevron-right
const CHEVRON_UP              : u64 = 0xE066 // chevron-up
const CHEVRON_DOWN            : u64 = 0xE067 // chevron-down

// --- nav
const NAV_REFRESH             : u64 = 0xE068 // rotate-cw
const NAV_BACK                : u64 = 0xE060 // = ARROW_LEFT
const NAV_FORWARD             : u64 = 0xE061 // = ARROW_RIGHT
const NAV_UP                  : u64 = 0xE062 // = ARROW_UP

// --- file
const FILE_FOLDER             : u64 = 0xE080 // folder
const FILE_FOLDER_OPEN        : u64 = 0xE081 // folder-open
const FILE_FILE               : u64 = 0xE082 // file
const FILE_TEXT               : u64 = 0xE083 // file-text
const FILE_IMAGE              : u64 = 0xE084 // image
const FILE_PROGRAM            : u64 = 0xE085 // terminal
const FILE_DRIVE              : u64 = 0xE086 // hard-drive

// --- general
const SETTINGS                : u64 = 0xE0A0 // settings
const SEARCH                  : u64 = 0xE0A1 // search
const START                   : u64 = 0xE0A2 // layout-grid
const TRASH                   : u64 = 0xE0A3 // trash-2
const WARNING                 : u64 = 0xE0A4 // triangle-alert
const ERROR                   : u64 = 0xE0A5 // circle-x
const SUCCESS                 : u64 = 0xE0A6 // circle-check
const INFO                    : u64 = 0xE0A7 // info
const CHECK                   : u64 = 0xE0A8 // check
const MENU                    : u64 = 0xE0A9 // menu

// The position of an icon in the list, 0..COUNT-1, or COUNT if the
// code point is not one of ours.  A caller that walks all icons -- the
// test program, the sheet, a settings page -- needs a dense index; the
// code points are deliberately NOT dense, because they are an
// interface with room left in it.
//
// THE TOOLTIP TEXT IS NOT HERE.  It belongs in the message catalogue of
// round I18N under the key `<name>.tip` -- see locale/en/icons.  A
// name in the interface that is compiled into the drawing code cannot
// be translated, and an icon without a name cannot be read by anyone
// who does not already know what it means.
fn index_of(c: u64) -> u64 {
    if c == 0xE000 { return 0 }
    if c == 0xE001 { return 1 }
    if c == 0xE002 { return 2 }
    if c == 0xE003 { return 3 }
    if c == 0xE004 { return 4 }
    if c == 0xE005 { return 5 }
    if c == 0xE020 { return 6 }
    if c == 0xE021 { return 7 }
    if c == 0xE022 { return 8 }
    if c == 0xE023 { return 9 }
    if c == 0xE024 { return 10 }
    if c == 0xE025 { return 11 }
    if c == 0xE040 { return 12 }
    if c == 0xE041 { return 13 }
    if c == 0xE042 { return 14 }
    if c == 0xE043 { return 15 }
    if c == 0xE060 { return 16 }
    if c == 0xE061 { return 17 }
    if c == 0xE062 { return 18 }
    if c == 0xE063 { return 19 }
    if c == 0xE064 { return 20 }
    if c == 0xE065 { return 21 }
    if c == 0xE066 { return 22 }
    if c == 0xE067 { return 23 }
    if c == 0xE068 { return 24 }
    if c == 0xE080 { return 25 }
    if c == 0xE081 { return 26 }
    if c == 0xE082 { return 27 }
    if c == 0xE083 { return 28 }
    if c == 0xE084 { return 29 }
    if c == 0xE085 { return 30 }
    if c == 0xE086 { return 31 }
    if c == 0xE0A0 { return 32 }
    if c == 0xE0A1 { return 33 }
    if c == 0xE0A2 { return 34 }
    if c == 0xE0A3 { return 35 }
    if c == 0xE0A4 { return 36 }
    if c == 0xE0A5 { return 37 }
    if c == 0xE0A6 { return 38 }
    if c == 0xE0A7 { return 39 }
    if c == 0xE0A8 { return 40 }
    if c == 0xE0A9 { return 41 }
    return COUNT
}

// The other way round: the code point of the icon at position `i`.
fn at_index(i: u64) -> u64 {
    if i == 0 { return 0xE000 }
    if i == 1 { return 0xE001 }
    if i == 2 { return 0xE002 }
    if i == 3 { return 0xE003 }
    if i == 4 { return 0xE004 }
    if i == 5 { return 0xE005 }
    if i == 6 { return 0xE020 }
    if i == 7 { return 0xE021 }
    if i == 8 { return 0xE022 }
    if i == 9 { return 0xE023 }
    if i == 10 { return 0xE024 }
    if i == 11 { return 0xE025 }
    if i == 12 { return 0xE040 }
    if i == 13 { return 0xE041 }
    if i == 14 { return 0xE042 }
    if i == 15 { return 0xE043 }
    if i == 16 { return 0xE060 }
    if i == 17 { return 0xE061 }
    if i == 18 { return 0xE062 }
    if i == 19 { return 0xE063 }
    if i == 20 { return 0xE064 }
    if i == 21 { return 0xE065 }
    if i == 22 { return 0xE066 }
    if i == 23 { return 0xE067 }
    if i == 24 { return 0xE068 }
    if i == 25 { return 0xE080 }
    if i == 26 { return 0xE081 }
    if i == 27 { return 0xE082 }
    if i == 28 { return 0xE083 }
    if i == 29 { return 0xE084 }
    if i == 30 { return 0xE085 }
    if i == 31 { return 0xE086 }
    if i == 32 { return 0xE0A0 }
    if i == 33 { return 0xE0A1 }
    if i == 34 { return 0xE0A2 }
    if i == 35 { return 0xE0A3 }
    if i == 36 { return 0xE0A4 }
    if i == 37 { return 0xE0A5 }
    if i == 38 { return 0xE0A6 }
    if i == 39 { return 0xE0A7 }
    if i == 40 { return 0xE0A8 }
    if i == 41 { return 0xE0A9 }
    return 0
}

// Is this code point one of ours?  The drawing routine asks before it
// reaches for the icon font, so that a stray value ends up as a
// missing glyph and not as somebody else's letter.
fn is_icon(c: u64) -> bool {
    return c >= FIRST && c <= LAST
}
