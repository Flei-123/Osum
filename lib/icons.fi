    if c == 0xE0C9 { return 61 }
    if c == 0xE0D0 { return 62 }
    if c == 0xE0D1 { return 63 }
    if c == 0xE0D2 { return 64 }
    if c == 0xE0D3 { return 65 }
    if c == 0xE0D4 { return 66 }
    if c == 0xE0D5 { return 67 }
    if c == 0xE0D6 { return 68 }
    if c == 0xE0D7 { return 69 }
    if c == 0xE0D8 { return 70 }
