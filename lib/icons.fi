    if c == 0xE068 { return 31 }
    if c == 0xE080 { return 32 }
    if c == 0xE081 { return 33 }
    if c == 0xE082 { return 34 }
    if c == 0xE083 { return 35 }
    if c == 0xE084 { return 36 }
    if c == 0xE085 { return 37 }
    if c == 0xE086 { return 38 }
    if c == 0xE0A0 { return 39 }
    if c == 0xE0A1 { return 40 }
    if c == 0xE0A2 { return 41 }
    if c == 0xE0A3 { return 42 }
    if c == 0xE0A4 { return 43 }
    if c == 0xE0A5 { return 44 }
    if c == 0xE0A6 { return 45 }
    if c == 0xE0A7 { return 46 }
    if c == 0xE0A8 { return 47 }
    if c == 0xE0A9 { return 48 }
    if c == 0xE0AA { return 49 }
    if c == 0xE0AB { return 50 }
