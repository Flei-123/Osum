// SPDX-License-Identifier: GPL-2.0-only
// WCH CH336/CH339/CH396/CH397 USB 2.0 Ethernet (vendor class 0xFF), protocol half. See docs/WLAN-CH336.md.
// No allocator, no syscall: callers pass buffers.

export {
    supported, chip_name_get, tx_wrap, rx_status, rx_frame_len, rx_frame_off, rx_next, rx_pad_missing,
    rx_mode_cfg, media_cfg, link_up, an_done, maccfg_by_request, autoneg_by_request, bmcr_bad,
    VID_WCH, REQ_INFO, REQ_READ_REG, REQ_WRITE_REG, REQ_PHY_READ, REQ_PHY_WRITE, REQ_WRITE_MACCFG,
    REG_MAC_L, REG_MAC_H, REG_MAC_CFG, REG_HASH_HI, REG_HASH_LO, PHY_BASE,
    MII_BMCR, MII_BMSR, MII_ANAR, MII_LPA, MII_ID1, MII_ID2, MII_ANER, REQ_AUTONEG, AUTONEG_ON, BMCR_KICK,
    FRAME_MIN, FRAME_MAX, RX_MAX, OVERHEAD, RX_OK, RX_MORE, RX_BAD, FW_MACCFG_REQ
}

const VID_WCH: u64 = 0x1A86
const REQ_INFO: u64 = 0x10
const REQ_READ_REG: u64 = 0x11
const REQ_WRITE_REG: u64 = 0x12
const REQ_PHY_READ: u64 = 0x15
const REQ_PHY_WRITE: u64 = 0x16
const REQ_WRITE_MACCFG: u64 = 0x1E
const REQ_AUTONEG: u64 = 0x1F
const AUTONEG_ON: u64 = 0xFA00
const BMCR_KICK: u64 = 0x1200
const REG_MAC_L: u64 = 0x40000714
const REG_MAC_H: u64 = 0x40000710
const REG_MAC_CFG: u64 = 0x40000700
const REG_HASH_HI: u64 = 0x40000730
const REG_HASH_LO: u64 = 0x40000734
const PHY_BASE: u64 = 0x740
const MII_BMCR: u64 = 0
const MII_BMSR: u64 = 1
const MII_ANAR: u64 = 4
const MII_LPA: u64 = 5
const MII_ID1: u64 = 2
const MII_ID2: u64 = 3
const MII_ANER: u64 = 6
const FW_MACCFG_REQ: u64 = 0x37

const CFG_PS: u64 = 0x80
const CFG_FD: u64 = 0x100
const CFG_RA: u64 = 0x80000
const CFG_PAM: u64 = 0x100000
const CFG_PUF: u64 = 0x200000
const CFG_PBD: u64 = 0x400000

const FRAME_MIN: usize = 60
const FRAME_MAX: usize = 1518
const RX_MAX: usize = 1522
const OVERHEAD: usize = 8

const RX_OK: u64 = 0
const RX_MORE: u64 = 1
const RX_BAD: u64 = 2

fn supported(vid: u64, pid: u64) -> bool {
    if vid != VID_WCH { return false }
    return pid == 0x5394 || pid == 0x5395 || pid == 0x5396 || pid == 0x5397
}

fn chip_name_get(pid: u64, out: u64) -> usize {
    var n: usize = 0
    if pid == 0x5394 { let t: [u8; 6] = "CH336\0"; n = cp(out, (&t[0]) as u64); return n }
    if pid == 0x5395 { let t: [u8; 6] = "CH339\0"; n = cp(out, (&t[0]) as u64); return n }
    if pid == 0x5396 { let t: [u8; 6] = "CH396\0"; n = cp(out, (&t[0]) as u64); return n }
    if pid == 0x5397 { let t: [u8; 6] = "CH397\0"; n = cp(out, (&t[0]) as u64); return n }
    let t: [u8; 8] = "unknown\0"
    return cp(out, (&t[0]) as u64)
}

fn cp(out: u64, s: u64) -> usize {
    var i: usize = 0
    while *((s + i as u64) as *mut u8) != 0 as u8 {
        *((out + i as u64) as *mut u8) = *((s + i as u64) as *mut u8)
        i = i + 1
    }
    *((out + i as u64) as *mut u8) = 0 as u8
    return i
}

fn st8(p: u64, o: usize, v: u64) { *((p + o as u64) as *mut u8) = (v & 255) as u8 }
fn ld8(p: u64, o: usize) -> u64 {
    let b: u8 = *((p + o as u64) as *mut u8)
    return b as u64
}

fn tx_wrap(frame: u64, n: usize, out: u64) -> usize {
    if n == 0 || n > FRAME_MAX { return 0 }
    var fl: usize = n
    if fl < FRAME_MIN { fl = FRAME_MIN }
    var total: usize = (OVERHEAD + fl + 3) & 0xFFFFFFFC
    if total == 512 || total == 1024 { total = total + 4 }
    let hl: usize = total - OVERHEAD
    st8(out, 0, hl as u64)
    st8(out, 1, (hl as u64) >> 8)
    st8(out, 2, 0)
    st8(out, 3, 0)
    var i: usize = 4
    while i < OVERHEAD { st8(out, i, 0); i = i + 1 }
    i = 0
    while i < n { st8(out, OVERHEAD + i, ld8(frame, i)); i = i + 1 }
    while i < hl { st8(out, OVERHEAD + i, 0); i = i + 1 }
    return total
}

fn rx_hdr(buf: u64, pos: usize) -> usize {
    return (ld8(buf, pos) | (ld8(buf, pos + 1) << 8) | (ld8(buf, pos + 2) << 16) | (ld8(buf, pos + 3) << 24)) as usize
}

fn rx_status(buf: u64, len: usize, pos: usize) -> u64 {
    if pos + OVERHEAD > len { return RX_MORE }
    let l: usize = rx_hdr(buf, pos)
    if l < FRAME_MIN || l > RX_MAX { return RX_BAD }
    if pos + OVERHEAD + l > len { return RX_MORE }
    return RX_OK
}

fn rx_frame_len(buf: u64, len: usize, pos: usize) -> usize {
    if rx_status(buf, len, pos) != RX_OK { return 0 }
    return rx_hdr(buf, pos)
}

fn rx_frame_off(pos: usize) -> usize { return pos + OVERHEAD }

fn rx_next(buf: u64, len: usize, pos: usize) -> usize {
    let l: usize = rx_frame_len(buf, len, pos)
    if l == 0 { return 0 }
    return pos + OVERHEAD + ((l + 3) & 0xFFFFFFFC)
}

fn rx_pad_missing(next: usize, len: usize) -> usize {
    if next > len { return next - len }
    return 0
}

fn rx_mode_cfg(cfg: u64) -> u64 {
    return (cfg | CFG_PBD | CFG_PUF | CFG_PAM) & (0xFFFFFFFF ^ CFG_RA)
}

fn link_up(bmsr: u64) -> bool { return (bmsr & 4) != 0 }
fn an_done(bmsr: u64) -> bool { return (bmsr & 0x20) != 0 }

fn media_cfg(cfg: u64, anar: u64, lpa: u64) -> u64 {
    let common: u64 = anar & lpa
    var fast: bool = false
    var full: bool = false
    if (common & 0x100) != 0 {
        fast = true
        full = true
    } else if (common & 0x80) != 0 {
        fast = true
    } else if (common & 0x40) != 0 {
        full = true
    }
    var v: u64 = cfg & (0xFFFFFFFF ^ (CFG_PS | CFG_FD))
    if fast { v = v | CFG_PS }
    if full { v = v | CFG_FD }
    return v
}

fn maccfg_by_request(fwver: u64) -> bool { return fwver >= FW_MACCFG_REQ }

fn autoneg_by_request(fwver: u64) -> bool { return fwver >= FW_MACCFG_REQ }

fn bmcr_bad(bmcr: u64) -> bool {
    if (bmcr & 0x0C00) != 0 { return true }
    if (bmcr & 0x4000) != 0 { return true }
    return (bmcr & 0x1000) == 0
}
