import usbnet.le

export {
    supported, family_of, tx_wrap, rx_step, link_class, link_full, early_timeout, early_timeout_reg, early_size,
    aggr_timer, ocp_index, rx_status_end, rx_status_frame, rx_status_skip, rx_status_bad,
    VID_REALTEK, REQ_REGS, MCU_PLA, MCU_USB, FAMILY_NONE, FAMILY_8152, FAMILY_8153A, FAMILY_8153B,
    LINK_DOWN, LINK_10, LINK_100, LINK_1000, FRAME_MAX, TX_DESC, RX_DESC, RX_BUF, RX_BUF_MAX, RMS_DEFAULT,
    PLA_IDR, PLA_RCR, PLA_RMS, PLA_RXFIFO_CTRL0, PLA_RXFIFO_CTRL1, PLA_RXFIFO_CTRL2, PLA_FMC, PLA_MAR, PLA_TEREDO_CFG,
    PLA_REALWOW_TIMER, PLA_TEREDO_TIMER, PLA_WDT6_CTRL, PLA_TCR0, PLA_TCR1, PLA_MTPS, PLA_TXFIFO_CTRL, PLA_CR, PLA_OOB_CTRL,
    PLA_CPCR, PLA_CRWECR, PLA_MISC_1, PLA_OCP_GPHY_BASE, PLA_SFF_STS_7, PLA_PHYSTATUS, PLA_BOOT_CTRL, PLA_MAC_PWR_CTRL3,
    USB_USB_CTRL, USB_BMU_RESET, USB_RX_BUF_TH, USB_RX_EARLY_TIMEOUT, USB_RX_EARLY_SIZE, USB_RX_EXTRA_AGGR_TMR,
    USB_TX_AGG, USB_TX_DMA, USB_UPT_RXDMA_OWN, USB_MSC_TIMER,
    RCR_AAP, RCR_APM, RCR_AM, RCR_AB, RCR_ACPT_ALL, RCR_DEFAULT, CR_RST, CR_RE, CR_TE, FMC_FCR_MCU_EN,
    AUTOLOAD_DONE, NOW_IS_OOB, LINK_LIST_READY, RXDY_GATED_EN, RE_INIT_LL, MCU_BORW_EN, CPCR_RX_VLAN, TCR0_AUTO_FIFO,
    RX_AGG_DISABLE, RX_ZERO_EN, BMU_RESET_BOTH, OWN_UPDATE_CLEAR, MCU_SPDWN_EN, IFG_MASK, IFG_96NS, IFG_144NS,
    TEREDO_CLEAR_OLD, WDT6_SET_MODE, MTPS_JUMBO, RXFIFO_THR1_NORMAL, RXFIFO_THR2_NORMAL, RXFIFO_THR3_NORMAL,
    TXFIFO_THR_NORMAL2, RXFIFO_THR2_HIGH, RXFIFO_THR3_HIGH, RXFIFO_THR2_FULL, RXFIFO_THR3_FULL, TX_AGG_MAX_THRESHOLD,
    RX_THR_HIGH, RX_THR_B, TX_DMA_DEFAULT, MSC_TIMER_VALUE, OCP_BASE_MII, OCP_PHY_STATUS, PHY_STAT_MASK, PHY_STAT_LAN_ON,
    MII_BMCR, MII_ADVERTISE, MII_CTRL1000, BMCR_PDOWN, BMCR_ANENABLE_RESTART, ADVERTISE_ALL, CTRL1000_FULL
}

const VID_REALTEK: u64 = 0x0BDA
const REQ_REGS: u64 = 0x05
const MCU_PLA: u64 = 0x0100
const MCU_USB: u64 = 0x0000

const FAMILY_NONE: u64 = 0
const FAMILY_8152: u64 = 1
const FAMILY_8153A: u64 = 2
const FAMILY_8153B: u64 = 3

const LINK_DOWN: u64 = 0
const LINK_10: u64 = 1
const LINK_100: u64 = 2
const LINK_1000: u64 = 3

const FRAME_MAX: u64 = 1536
const TX_DESC: u64 = 8
const RX_DESC: u64 = 24
const RX_BUF: u64 = 16384
const RX_BUF_MAX: u64 = 16384
const RMS_DEFAULT: u64 = 1522
const TX_FS: u64 = 0x80000000
const TX_LS: u64 = 0x40000000
const RX_LEN_MASK: u64 = 0x7FFF
const FCS: u64 = 4
const ZLEN: u64 = 60

const PLA_IDR: u64 = 0xC000
const PLA_RCR: u64 = 0xC010
const PLA_RMS: u64 = 0xC016
const PLA_RXFIFO_CTRL0: u64 = 0xC0A0
const PLA_RXFIFO_CTRL1: u64 = 0xC0A4
const PLA_RXFIFO_CTRL2: u64 = 0xC0A8
const PLA_FMC: u64 = 0xC0B4
const PLA_TEREDO_CFG: u64 = 0xC0BC
const PLA_MAR: u64 = 0xCD00
const PLA_TEREDO_TIMER: u64 = 0xD2CC
const PLA_REALWOW_TIMER: u64 = 0xD2E8
const PLA_BOOT_CTRL: u64 = 0xE004
const PLA_MAC_PWR_CTRL3: u64 = 0xE0CC
const PLA_WDT6_CTRL: u64 = 0xE428
const PLA_TCR0: u64 = 0xE610
const PLA_TCR1: u64 = 0xE612
const PLA_MTPS: u64 = 0xE615
const PLA_TXFIFO_CTRL: u64 = 0xE618
const PLA_CR: u64 = 0xE813
const PLA_CRWECR: u64 = 0xE81C
const PLA_OOB_CTRL: u64 = 0xE84F
const PLA_CPCR: u64 = 0xE854
const PLA_MISC_1: u64 = 0xE85A
const PLA_OCP_GPHY_BASE: u64 = 0xE86C
const PLA_SFF_STS_7: u64 = 0xE8DE
const PLA_PHYSTATUS: u64 = 0xE908

const USB_USB_CTRL: u64 = 0xD406
const USB_TX_AGG: u64 = 0xD40A
const USB_RX_BUF_TH: u64 = 0xD40C
const USB_RX_EARLY_TIMEOUT: u64 = 0xD42C
const USB_RX_EARLY_SIZE: u64 = 0xD42E
const USB_RX_EXTRA_AGGR_TMR: u64 = 0xD432
const USB_TX_DMA: u64 = 0xD434
const USB_UPT_RXDMA_OWN: u64 = 0xD437
const USB_BMU_RESET: u64 = 0xD4B0
const USB_MSC_TIMER: u64 = 0xCBFC

const RCR_AAP: u64 = 0x1
const RCR_APM: u64 = 0x2
const RCR_AM: u64 = 0x4
const RCR_AB: u64 = 0x8
const RCR_ACPT_ALL: u64 = 0xF
const RCR_DEFAULT: u64 = 0xE
const CR_RST: u64 = 0x10
const CR_RE: u64 = 0x08
const CR_TE: u64 = 0x04
const FMC_FCR_MCU_EN: u64 = 0x0001
const AUTOLOAD_DONE: u64 = 0x0002
const NOW_IS_OOB: u64 = 0x80
const LINK_LIST_READY: u64 = 0x02
const RXDY_GATED_EN: u64 = 0x0008
const RE_INIT_LL: u64 = 0x8000
const MCU_BORW_EN: u64 = 0x4000
const CPCR_RX_VLAN: u64 = 0x0040
const TCR0_AUTO_FIFO: u64 = 0x0080
const RX_AGG_DISABLE: u64 = 0x0010
const RX_ZERO_EN: u64 = 0x0080
const BMU_RESET_BOTH: u64 = 0x03
const OWN_UPDATE_CLEAR: u64 = 0x03
const MCU_SPDWN_EN: u64 = 0x4000
const IFG_MASK: u64 = 0x0308
const IFG_96NS: u64 = 0x0300
const IFG_144NS: u64 = 0x0200
const TEREDO_CLEAR_OLD: u64 = 0x80FF
const WDT6_SET_MODE: u64 = 0x0010
const MTPS_JUMBO: u64 = 192
const RXFIFO_THR1_NORMAL: u64 = 0x00080002
const RXFIFO_THR2_NORMAL: u64 = 0x00A0
const RXFIFO_THR3_NORMAL: u64 = 0x0110
const TXFIFO_THR_NORMAL2: u64 = 0x01000008
const RXFIFO_THR2_HIGH: u64 = 0x38
const RXFIFO_THR3_HIGH: u64 = 0x48
const RXFIFO_THR2_FULL: u64 = 0x60
const RXFIFO_THR3_FULL: u64 = 0x78
const TX_AGG_MAX_THRESHOLD: u64 = 0x03
const RX_THR_HIGH: u64 = 0x7A120180
const RX_THR_B: u64 = 0x00010001
const TX_DMA_DEFAULT: u64 = 0x00000101
const MSC_TIMER_VALUE: u64 = 0x0FFF

const OCP_BASE_MII: u64 = 0xA400
const OCP_PHY_STATUS: u64 = 0xA420
const PHY_STAT_MASK: u64 = 0x0007
const PHY_STAT_LAN_ON: u64 = 3
const MII_BMCR: u64 = 0
const MII_ADVERTISE: u64 = 4
const MII_CTRL1000: u64 = 9
const BMCR_PDOWN: u64 = 0x0800
const BMCR_ANENABLE_RESTART: u64 = 0x1200
const ADVERTISE_ALL: u64 = 0x01E1
const CTRL1000_FULL: u64 = 0x0200

const PHYST_LINK: u64 = 0x02
const PHYST_FULL: u64 = 0x01
const PHYST_1000: u64 = 0x10
const PHYST_100: u64 = 0x08

const RX_END: u64 = 0
const RX_FRAME: u64 = 1
const RX_SKIP: u64 = 2
const RX_BAD: u64 = 3

fn rx_status_end() -> u64 { return RX_END }
fn rx_status_frame() -> u64 { return RX_FRAME }
fn rx_status_skip() -> u64 { return RX_SKIP }
fn rx_status_bad() -> u64 { return RX_BAD }

fn supported(vid: u64, pid: u64) -> bool {
    if vid == 0x0BDA { return pid == 0x8152 || pid == 0x8153 }
    if vid == 0x045E { return pid == 0x07AB || pid == 0x07C6 }
    if vid == 0x04E8 { return pid == 0xA101 }
    if vid == 0x17EF { return pid == 0x304F || pid == 0x3054 || pid == 0x3062 || pid == 0x3069 }
    return false
}

fn family_of(tcr0: u64) -> u64 {
    let v: u64 = (tcr0 >> 16) & 0x7CF0
    if v == 0x4C00 || v == 0x4C10 { return FAMILY_8152 }
    if v == 0x5C00 || v == 0x5C10 || v == 0x5C20 || v == 0x5C30 { return FAMILY_8153A }
    if v == 0x6000 || v == 0x6010 { return FAMILY_8153B }
    return FAMILY_NONE
}

fn ocp_index(reg: u64) -> u64 { return OCP_BASE_MII + reg * 2 }

fn link_class(phystatus: u64) -> u64 {
    if (phystatus & PHYST_LINK) == 0 { return LINK_DOWN }
    if (phystatus & PHYST_1000) != 0 { return LINK_1000 }
    if (phystatus & PHYST_100) != 0 { return LINK_100 }
    return LINK_10
}

fn link_full(phystatus: u64) -> bool { return (phystatus & PHYST_FULL) != 0 }

fn aggr_timer(family: u64, usb_speed: u64) -> u64 {
    if family == FAMILY_8153B { return 15000 }
    if usb_speed >= 4 { return 85000 }
    if usb_speed == 3 { return 250000 }
    return 524280
}

fn early_timeout(family: u64, usb_speed: u64) -> u64 {
    if family == FAMILY_8153B { return 128 / 8 }
    return aggr_timer(family, usb_speed) / 8
}

fn early_timeout_reg(family: u64) -> u64 { return USB_RX_EARLY_TIMEOUT }

fn early_size(family: u64) -> u64 {
    let reserved: u64 = RMS_DEFAULT + RX_DESC + 8
    let room: u64 = RX_BUF - reserved
    if family == FAMILY_8153B { return room / 8 }
    return room / 4
}

fn tx_wrap(frame: u64, n: u64, out: u64) -> u64 {
    if n == 0 || n > FRAME_MAX { return 0 }
    le.put32(out, 0, n | TX_FS | TX_LS)
    le.put32(out, 4, 0)
    var i: u64 = 0
    while i < n {
        le.st8(out, TX_DESC + i, le.ld8(frame, i))
        i = i + 1
    }
    return TX_DESC + n
}

fn align8(v: u64) -> u64 { return (v + 7) & 0xFFFFFFF8 }

fn rx_step(buf: u64, len: u64, off: u64, res: u64) -> u64 {
    if off + RX_DESC >= len { return RX_END }
    let opts1: u64 = le.get32(buf, off)
    let pkt: u64 = opts1 & RX_LEN_MASK
    if pkt < ZLEN { return RX_END }
    if off + RX_DESC + pkt > len { return RX_END }
    le.put64(res, 0, align8(off + RX_DESC + pkt))
    if pkt - FCS > FRAME_MAX { return RX_SKIP }
    le.put64(res, 16, off + RX_DESC)
    le.put64(res, 24, pkt - FCS)
    return RX_FRAME
}
