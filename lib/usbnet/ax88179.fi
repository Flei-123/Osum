import usbnet.le

export {
    supported, tx_wrap, rx_step, rx_status_end, rx_status_frame, rx_status_skip, rx_status_bad,
    link_class, medium_for, bulkin_row, bulkin_sel, bulkin_len, padded, RX_RES_WORDS,
    VID_ASIX, ACCESS_MAC, ACCESS_PHY, PHY_ID, PHY_BMCR, PHY_PHYSR,
    REG_LINK_STATUS, REG_RX_CTL, REG_NODE_ID, REG_MEDIUM, REG_MONITOR, REG_PHYPWR, REG_QCTRL, REG_CLK, REG_RXCOE,
    REG_TXCOE, REG_WATER_LOW, REG_WATER_HIGH,
    PHYPWR_IPRL, CLK_ACS_BCS, RXCOE_ALL, TXCOE_ALL, WATER_HIGH, WATER_LOW, RX_CTL_RUN, MONITOR_DEFAULT, MEDIUM_DEFAULT,
    MEDIUM_BASE, MEDIUM_GIGA, MEDIUM_125MHZ, MEDIUM_PS, MEDIUM_FULL, BMCR_ANENABLE, BMCR_ANRESTART,
    LINK_DOWN, LINK_10, LINK_100, LINK_1000, FRAME_MAX, TX_HDR, RX_BUF_MAX
}

const VID_ASIX: u64 = 0x0B95
const ACCESS_MAC: u64 = 0x01
const ACCESS_PHY: u64 = 0x02
const PHY_ID: u64 = 0x03
const PHY_BMCR: u64 = 0x00
const PHY_PHYSR: u64 = 0x11

const REG_LINK_STATUS: u64 = 0x02
const REG_RX_CTL: u64 = 0x0B
const REG_NODE_ID: u64 = 0x10
const REG_MEDIUM: u64 = 0x22
const REG_MONITOR: u64 = 0x24
const REG_PHYPWR: u64 = 0x26
const REG_QCTRL: u64 = 0x2E
const REG_CLK: u64 = 0x33
const REG_RXCOE: u64 = 0x34
const REG_TXCOE: u64 = 0x35
const REG_WATER_LOW: u64 = 0x54
const REG_WATER_HIGH: u64 = 0x55

const PHYPWR_IPRL: u64 = 0x0020
const CLK_ACS_BCS: u64 = 0x03
const RXCOE_ALL: u64 = 0x67
const TXCOE_ALL: u64 = 0x67
const WATER_HIGH: u64 = 0x34
const WATER_LOW: u64 = 0x52
const RX_CTL_RUN: u64 = 0x03AA
const MONITOR_DEFAULT: u64 = 0x64

const MEDIUM_BASE: u64 = 0x0130
const MEDIUM_GIGA: u64 = 0x0001
const MEDIUM_FULL: u64 = 0x0002
const MEDIUM_125MHZ: u64 = 0x0008
const MEDIUM_PS: u64 = 0x0200
const MEDIUM_DEFAULT: u64 = 0x0133

const BMCR_ANENABLE: u64 = 0x1000
const BMCR_ANRESTART: u64 = 0x0200

const PHYSR_SPEED_MASK: u64 = 0xC000
const PHYSR_GIGA: u64 = 0x8000
const PHYSR_100: u64 = 0x4000
const PHYSR_FULL: u64 = 0x2000
const PHYSR_LINK: u64 = 0x0400

const LINK_DOWN: u64 = 0
const LINK_10: u64 = 1
const LINK_100: u64 = 2
const LINK_1000: u64 = 3

const USB_SS: u64 = 0x04
const USB_HS: u64 = 0x02

const FRAME_MAX: u64 = 1536
const TX_HDR: u64 = 8
const RX_BUF_MAX: u64 = 28672
const RXHDR_CRC_ERR: u64 = 0x20000000
const RXHDR_DROP_ERR: u64 = 0x80000000
const PKT_LEN_MASK: u64 = 0x1FFF

const RX_RES_WORDS: u64 = 4
const RX_END: u64 = 0
const RX_FRAME: u64 = 1
const RX_SKIP: u64 = 2
const RX_BAD: u64 = 3

fn rx_status_end() -> u64 { return RX_END }
fn rx_status_frame() -> u64 { return RX_FRAME }
fn rx_status_skip() -> u64 { return RX_SKIP }
fn rx_status_bad() -> u64 { return RX_BAD }

fn supported(vid: u64, pid: u64) -> bool {
    if vid == 0x0B95 { return pid == 0x1790 || pid == 0x178A }
    if vid == 0x04B4 { return pid == 0x3610 }
    if vid == 0x2001 { return pid == 0x4A00 }
    if vid == 0x0DF6 { return pid == 0x0072 }
    if vid == 0x04E8 { return pid == 0xA100 }
    if vid == 0x17EF { return pid == 0x304B }
    if vid == 0x050D { return pid == 0x0128 }
    if vid == 0x0930 { return pid == 0x0A13 }
    if vid == 0x0711 { return pid == 0x0179 }
    if vid == 0x07C9 { return pid == 0x000E || pid == 0x000F || pid == 0x0010 }
    return false
}

fn padded(pkt_len: u64) -> u64 { return (pkt_len + 7) & 0xFFF8 }

fn tx_wrap(frame: u64, n: u64, mps: u64, out: u64) -> u64 {
    if n == 0 || n > FRAME_MAX { return 0 }
    le.put32(out, 0, n)
    var h2: u64 = 0
    var pad: u64 = 0
    if mps != 0 && ((n + TX_HDR) % mps) == 0 {
        h2 = 0x80008000
        pad = 1
    }
    le.put32(out, 4, h2)
    var i: u64 = 0
    while i < n {
        le.st8(out, TX_HDR + i, le.ld8(frame, i))
        i = i + 1
    }
    if pad != 0 { le.st8(out, TX_HDR + n, 0) }
    return TX_HDR + n + pad
}

fn rx_step(buf: u64, len: u64, off: u64, idx: u64, res: u64) -> u64 {
    if len < 4 { return RX_END }
    let tail: u64 = le.get32(buf, len - 4)
    let cnt: u64 = tail & 0xFFFF
    let hoff: u64 = (tail >> 16) & 0xFFFF
    let body: u64 = len - 4
    if cnt == 0 || cnt * 4 + hoff > body { return RX_END }
    var i: u64 = idx
    while i < cnt {
        let meta: u64 = le.get32(buf, hoff + i * 4)
        i = i + 1
        let pl: u64 = (meta >> 16) & PKT_LEN_MASK
        if pl != 0 {
            let pp: u64 = padded(pl)
            if off + pp > hoff { return RX_BAD }
            le.put64(res, 0, off + pp)
            le.put64(res, 8, i)
            if (meta & (RXHDR_CRC_ERR | RXHDR_DROP_ERR)) != 0 || pl < 16 || pl - 2 > FRAME_MAX {
                return RX_SKIP
            }
            le.put64(res, 16, off + 2)
            le.put64(res, 24, pl - 2)
            return RX_FRAME
        }
    }
    return RX_END
}

fn bulkin_row(sel: u64) -> u64 {
    if sel == 0 { return 0xFF12004F07 }
    if sel == 1 { return 0xFF16032007 }
    if sel == 2 { return 0xFF1807AE07 }
    return 0x08184CCC07
}

fn bulkin_len(sel: u64) -> u64 {
    return 1024 * (((bulkin_row(sel) >> 24) & 0xFF) + 2)
}

fn link_class(physr: u64) -> u64 {
    if (physr & PHYSR_LINK) == 0 { return LINK_DOWN }
    let sp: u64 = physr & PHYSR_SPEED_MASK
    if sp == PHYSR_GIGA { return LINK_1000 }
    if sp == PHYSR_100 { return LINK_100 }
    return LINK_10
}

fn bulkin_sel(cls: u64, usb_link: u64) -> u64 {
    if cls == LINK_1000 {
        if (usb_link & USB_SS) != 0 { return 0 }
        if (usb_link & USB_HS) != 0 { return 1 }
        return 3
    }
    if cls == LINK_100 && (usb_link & (USB_SS | USB_HS)) != 0 { return 2 }
    return 3
}

fn medium_for(physr: u64) -> u64 {
    var m: u64 = MEDIUM_BASE
    let cls: u64 = link_class(physr)
    if cls == LINK_1000 { m = m | MEDIUM_GIGA | MEDIUM_125MHZ }
    if cls == LINK_100 { m = m | MEDIUM_PS }
    if (physr & PHYSR_FULL) != 0 { m = m | MEDIUM_FULL }
    return m
}
