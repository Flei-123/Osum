import libc.octets

export { get32, get64, put32, put64 }

fn get32(p: u64, i: u64) -> u64 {
    return octets.ld16(p, i) | (octets.ld16(p, i + 2) << 16)
}

fn put32(p: u64, i: u64, v: u64) {
    octets.st16(p, i, v)
    octets.st16(p, i + 2, v >> 16)
}

fn get64(p: u64, i: u64) -> u64 {
    return get32(p, i) | (get32(p, i + 4) << 32)
}

fn put64(p: u64, i: u64, v: u64) {
    put32(p, i, v)
    put32(p, i + 4, v >> 32)
}

