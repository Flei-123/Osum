// SPDX-License-Identifier: GPL-2.0-only
export { ld8, st8, get16, get32, get64, put16, put32, put64, zero }

fn ld8(p: u64, i: u64) -> u64 {
    let q: *mut u8 = (p + i) as *mut u8
    let v: u8 = *q
    return v as u64
}

fn st8(p: u64, i: u64, v: u64) {
    let q: *mut u8 = (p + i) as *mut u8
    *q = (v & 255) as u8
}

fn get16(p: u64, i: u64) -> u64 {
    return ld8(p, i) | (ld8(p, i + 1) << 8)
}

fn get32(p: u64, i: u64) -> u64 {
    return get16(p, i) | (get16(p, i + 2) << 16)
}

fn put16(p: u64, i: u64, v: u64) {
    st8(p, i, v)
    st8(p, i + 1, v >> 8)
}

fn put32(p: u64, i: u64, v: u64) {
    put16(p, i, v)
    put16(p, i + 2, v >> 16)
}

fn get64(p: u64, i: u64) -> u64 {
    return get32(p, i) | (get32(p, i + 4) << 32)
}

fn put64(p: u64, i: u64, v: u64) {
    put32(p, i, v)
    put32(p, i + 4, v >> 32)
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        st8(p, i, 0)
        i = i + 1
    }
}
