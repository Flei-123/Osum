import libc.octets

export {
    supported, tx_wrap, rx_frame_len, rx_frame_off, rx_next, setup_packet, req_read_mac, req_write_rxctl, req_write_medium,
    VID_ASIX, CMD_READ_NODE_ID, CMD_WRITE_RX_CTL, CMD_WRITE_MEDIUM_MODE, CMD_SW_RESET, CMD_SW_PHY_SELECT,
    FRAME_MAX, HDR, MAXPACKET,
    SWRESET_CLEAR, SWRESET_IPRL, SWRESET_PRL, SWRESET_IPPD, PHYSEL_EMBEDDED, RXCTL_SO, RXCTL_AB, RXCTL_DEFAULT, MEDIUM_DEFAULT
}

const VID_ASIX: u64 = 0x0B95
const CMD_WRITE_RX_CTL: u64 = 0x10
const CMD_READ_NODE_ID: u64 = 0x13
const CMD_WRITE_MEDIUM_MODE: u64 = 0x1B
const CMD_SW_RESET: u64 = 0x20
const CMD_SW_PHY_SELECT: u64 = 0x22
// values from the Asix protocol as known from the Linux driver (asix_devices.c), NOT checked on a real chip
const SWRESET_CLEAR: u64 = 0x00
const SWRESET_PRL: u64 = 0x08
const SWRESET_IPRL: u64 = 0x20
const SWRESET_IPPD: u64 = 0x40
const PHYSEL_EMBEDDED: u64 = 0x01
const RXCTL_AB: u64 = 0x0008
const RXCTL_SO: u64 = 0x0080
const RXCTL_DEFAULT: u64 = 0x0088
const MEDIUM_DEFAULT: u64 = 0x0336
const FRAME_MAX: usize = 1518
const HDR: usize = 4
const MAXPACKET: usize = 512
const SIZE_MASK: u64 = 0x7FF

fn supported(vid: u64, pid: u64) -> bool {
    if vid != VID_ASIX { return false }
    return pid == 0x7720 || pid == 0x772A || pid == 0x772B || pid == 0x7E2B
}

fn header_of(n: usize) -> u64 {
    let l: u64 = (n as u64) & SIZE_MASK
    return l | (((~l) & SIZE_MASK) << 16)
}

fn tx_wrap(frame: u64, n: usize, out: u64) -> usize {
    if n == 0 || n > FRAME_MAX { return 0 }
    let h: u64 = header_of(n)
    octets.st8_idx(out, 0, h)
    octets.st8_idx(out, 1, h >> 8)
    octets.st8_idx(out, 2, h >> 16)
    octets.st8_idx(out, 3, h >> 24)
    var i: usize = 0
    while i < n { octets.st8_idx(out, HDR + i, octets.ld8_idx(frame, i)); i = i + 1 }
    var total: usize = HDR + n
    if (total & (MAXPACKET - 1)) == 0 {
        octets.st8_idx(out, total, 0)
        octets.st8_idx(out, total + 1, 0)
        octets.st8_idx(out, total + 2, 0xFF)
        octets.st8_idx(out, total + 3, 0xFF)
        total = total + 4
    }
    return total
}

fn rx_frame_len(buf: u64, len: usize, pos: usize) -> usize {
    if pos + HDR > len { return 0 }
    let h: u64 = octets.ld8_idx(buf, pos) | (octets.ld8_idx(buf, pos + 1) << 8) | (octets.ld8_idx(buf, pos + 2) << 16) | (octets.ld8_idx(buf, pos + 3) << 24)
    let size: u64 = h & SIZE_MASK
    let inv: u64 = ((~h) >> 16) & SIZE_MASK
    if size != inv { return 0 }
    if size < 14 || size > (FRAME_MAX as u64) { return 0 }
    if pos + HDR + (size as usize) > len { return 0 }
    return size as usize
}

fn rx_frame_off(pos: usize) -> usize { return pos + HDR }

fn rx_next(buf: u64, len: usize, pos: usize) -> usize {
    let l: usize = rx_frame_len(buf, len, pos)
    if l == 0 { return 0 }
    return pos + HDR + ((l + 1) & 0xFFFFFFFE)
}

fn setup_packet(dst: u64, dir_in: bool, req: u64, value: u64, index: u64, length: u64) {
    var t: u64 = 0x40
    if dir_in { t = 0xC0 }
    octets.st8_idx(dst, 0, t)
    octets.st8_idx(dst, 1, req)
    octets.st8_idx(dst, 2, value)
    octets.st8_idx(dst, 3, value >> 8)
    octets.st8_idx(dst, 4, index)
    octets.st8_idx(dst, 5, index >> 8)
    octets.st8_idx(dst, 6, length)
    octets.st8_idx(dst, 7, length >> 8)
}

fn req_read_mac(dst: u64) { setup_packet(dst, true, CMD_READ_NODE_ID, 0, 0, 6) }
fn req_write_rxctl(dst: u64, v: u64) { setup_packet(dst, false, CMD_WRITE_RX_CTL, v, 0, 0) }
fn req_write_medium(dst: u64, v: u64) { setup_packet(dst, false, CMD_WRITE_MEDIUM_MODE, v, 0, 0) }
