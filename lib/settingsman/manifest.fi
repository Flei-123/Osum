}

// The adapter of a page: the packed names text names[0..len) holds one name per line (NUL also separates); the
// 0-terminated key's line number is its binding number. NONE when the key is not listed.
fn names_index(names: u64, len: u64, key: u64) -> u64 {
    var ix: u64 = 0
    var at: u64 = 0
    while at < len {
        var e: u64 = at
        while e < len && rd(names, e) != 10 && rd(names, e) != 0 {
            e = e + 1
        }
        var same: bool = true
        var i: u64 = 0
        while i < e - at && same {
            if rd(names, at + i) != rd(key, i) {
                same = false
            }
            i = i + 1
        }
        if same && e > at && rd(key, e - at) == 0 {
            return ix
        }
        at = e + 1
        ix = ix + 1
    }
    return NONE
}
