// SPDX-License-Identifier: MPL-2.0
import nav.route
import nav.stack

export { record, step_back, step_forward, count, position, load_current, can_back, can_forward }

const H: u64 = 0
const ROOT_LEN: u64 = 17

static mut root: [u8; 18] = "explorer://folder\0"
static mut uri: [u8; 272] = [0 as u8; 272]

fn can_back() -> bool {
    return stack.can_back(H)
}

fn can_forward() -> bool {
    return stack.can_forward(H)
}

fn count() -> u64 {
    return stack.size(H)
}

fn position() -> u64 {
    return stack.position(H)
}

fn append_seg(o: u64, p: u64, s: u64, n: u64) -> u64 {
    let u: u64 = (&uri[0]) as u64
    if o + 2 >= route.MAX_URI {
        return route.NONE
    }
    route.wr(u, o, 47)
    let w: u64 = route.enc_seg(u + o + 1, route.MAX_URI - o - 1, p + s, n)
    if w == route.NONE {
        return route.NONE
    }
    return o + 1 + w
}

fn record(p: u64) -> bool {
    let u: u64 = (&uri[0]) as u64
    var o: u64 = 0
    while o < ROOT_LEN {
        route.wr(u, o, route.rd((&root[0]) as u64, o))
        o = o + 1
    }
    var i: u64 = 0
    var s: u64 = 0
    var done: bool = false
    while !done {
        let c: u64 = route.rd(p, i)
        if c == 47 || c == 0 {
            if i > s {
                o = append_seg(o, p, s, i - s)
                if o == route.NONE {
                    return false
                }
            }
            s = i + 1
            if c == 0 {
                done = true
            }
        }
        i = i + 1
    }
    return stack.push(H, u, o)
}

fn load_current(out: u64, cap: u64) -> bool {
    let c: u64 = stack.current(H)
    let n: u64 = stack.current_len(H)
    if n == 0 {
        return false
    }
    let d: u64 = route.depth(c, n)
    var o: u64 = 0
    var i: u64 = 1
    while i < d {
        let so: u64 = route.seg_off(c, n, i)
        let sl: u64 = route.seg_len(c, n, i)
        if so == route.NONE || o + 2 >= cap {
            return false
        }
        route.wr(out, o, 47)
        o = o + 1
        let w: u64 = route.dec_seg(out + o, cap - o, c + so, sl)
        if w == route.NONE {
            return false
        }
        o = o + w
        i = i + 1
    }
    if o == 0 {
        route.wr(out, 0, 47)
        o = 1
    }
    route.wr(out, o, 0)
    return true
}

fn step_back(out: u64, cap: u64) -> bool {
    if !stack.back(H) {
        return false
    }
    return load_current(out, cap)
}

fn step_forward(out: u64, cap: u64) -> bool {
    if !stack.forward(H) {
        return false
    }
    return load_current(out, cap)
}
