// SPDX-License-Identifier: MPL-2.0
export {
    NONE, MAX_URI, scheme_len, path_start, path_len, valid, canon, depth, seg_off, seg_len,
    parent_len, is_prefix, same_path, query_off, query_get, enc_seg, dec_seg, lower, rd, wr,
}

const NONE: u64 = 4294967295
const MAX_URI: u64 = 255

fn rd(p: u64, i: u64) -> u64 {
    let c: u8 = *((p + i) as *mut u8)
    return c as u64
}

fn wr(p: u64, i: u64, c: u64) {
    *((p + i) as *mut u8) = (c & 255) as u8
}

fn is_lower(c: u64) -> bool {
    return c >= 97 && c <= 122
}

fn is_digit(c: u64) -> bool {
    return c >= 48 && c <= 57
}

fn is_hex(c: u64) -> bool {
    return is_digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

fn hex_val(c: u64) -> u64 {
    if is_digit(c) {
        return c - 48
    }
    if c >= 97 {
        return c - 87
    }
    return c - 55
}

fn lower(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

fn seg_char(c: u64) -> bool {
    return is_lower(c) || (c >= 65 && c <= 90) || is_digit(c) || c == 45 || c == 46 || c == 95 || c == 126 || c == 37
}

fn query_char(c: u64) -> bool {
    return seg_char(c) || c == 61 || c == 38
}

fn scheme_len(p: u64, n: u64) -> u64 {
    if n < 4 {
        return 0
    }
    if !is_lower(lower(rd(p, 0))) {
        return 0
    }
    var i: u64 = 0
    while i < n && i < 17 {
        let c: u64 = lower(rd(p, i))
        if c == 58 {
            if i == 0 || i + 2 >= n {
                return 0
            }
            if rd(p, i + 1) == 47 && rd(p, i + 2) == 47 {
                return i
            }
            return 0
        }
        if !(is_lower(c) || is_digit(c) || c == 45) {
            return 0
        }
        i = i + 1
    }
    return 0
}

fn path_start(p: u64, n: u64) -> u64 {
    let s: u64 = scheme_len(p, n)
    if s == 0 {
        return NONE
    }
    return s + 3
}

fn path_len(p: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < n {
        if rd(p, i) == 63 {
            return i
        }
        i = i + 1
    }
    return n
}

fn valid(p: u64, n: u64) -> bool {
    if n == 0 || n > MAX_URI {
        return false
    }
    let st: u64 = path_start(p, n)
    if st == NONE {
        return false
    }
    let e: u64 = path_len(p, n)
    var i: u64 = st
    var seg0: u64 = st
    while i <= e {
        var edge: bool = i == e
        if !edge {
            edge = rd(p, i) == 47
        }
        if edge {
            let l: u64 = i - seg0
            if l == 0 && e > st {
                return false
            }
            if l == 1 && rd(p, seg0) == 46 {
                return false
            }
            if l == 2 && rd(p, seg0) == 46 && rd(p, seg0 + 1) == 46 {
                return false
            }
            seg0 = i + 1
        } else {
            if !seg_char(rd(p, i)) {
                return false
            }
            if rd(p, i) == 37 {
                if i + 2 >= e {
                    return false
                }
                if !is_hex(rd(p, i + 1)) || !is_hex(rd(p, i + 2)) {
                    return false
                }
            }
        }
        i = i + 1
    }
    if e < n {
        var j: u64 = e + 1
        if j >= n {
            return false
        }
        while j < n {
            if !query_char(rd(p, j)) {
                return false
            }
            j = j + 1
        }
    }
    return true
}

fn canon(out: u64, cap: u64, p: u64, n: u64) -> u64 {
    if n == 0 || n > MAX_URI || cap < n + 2 {
        return 0
    }
    let sl: u64 = scheme_len(p, n)
    if sl == 0 {
        return 0
    }
    let e: u64 = path_len(p, n)
    var o: u64 = 0
    var i: u64 = 0
    while i < sl {
        wr(out, o, lower(rd(p, i)))
        o = o + 1
        i = i + 1
    }
    wr(out, o, 58)
    wr(out, o + 1, 47)
    wr(out, o + 2, 47)
    o = o + 3
    i = sl + 3
    var seg0: u64 = i
    var first: bool = true
    while i <= e {
        var edge: bool = i == e
        if !edge {
            edge = rd(p, i) == 47
        }
        if edge {
            let l: u64 = i - seg0
            if l > 0 {
                if !first {
                    wr(out, o, 47)
                    o = o + 1
                }
                var k: u64 = 0
                while k < l {
                    wr(out, o, rd(p, seg0 + k))
                    o = o + 1
                    k = k + 1
                }
                first = false
            }
            seg0 = i + 1
        }
        i = i + 1
    }
    if e < n {
        var j: u64 = e
        while j < n {
            wr(out, o, rd(p, j))
            o = o + 1
            j = j + 1
        }
    }
    wr(out, o, 0)
    if !valid(out, o) {
        return 0
    }
    return o
}

fn depth(p: u64, n: u64) -> u64 {
    let st: u64 = path_start(p, n)
    if st == NONE {
        return 0
    }
    let e: u64 = path_len(p, n)
    if e <= st {
        return 0
    }
    var d: u64 = 1
    var i: u64 = st
    while i < e {
        if rd(p, i) == 47 {
            d = d + 1
        }
        i = i + 1
    }
    return d
}

fn seg_off(p: u64, n: u64, idx: u64) -> u64 {
    let st: u64 = path_start(p, n)
    if st == NONE {
        return NONE
    }
    let e: u64 = path_len(p, n)
    if e <= st {
        return NONE
    }
    var k: u64 = 0
    var i: u64 = st
    var s0: u64 = st
    while i <= e {
        if i == e || rd(p, i) == 47 {
            if k == idx {
                return s0
            }
            k = k + 1
            s0 = i + 1
        }
        i = i + 1
    }
    return NONE
}

fn seg_len(p: u64, n: u64, idx: u64) -> u64 {
    let o: u64 = seg_off(p, n, idx)
    if o == NONE {
        return 0
    }
    let e: u64 = path_len(p, n)
    var i: u64 = o
    while i < e && rd(p, i) != 47 {
        i = i + 1
    }
    return i - o
}

fn parent_len(p: u64, n: u64) -> u64 {
    let d: u64 = depth(p, n)
    if d == 0 {
        return NONE
    }
    if d == 1 {
        return path_start(p, n)
    }
    let last: u64 = seg_off(p, n, d - 1)
    return last - 1
}

fn same_path(a: u64, na: u64, b: u64, nb: u64) -> bool {
    let ea: u64 = path_len(a, na)
    let eb: u64 = path_len(b, nb)
    if ea != eb {
        return false
    }
    var i: u64 = 0
    while i < ea {
        if rd(a, i) != rd(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn is_prefix(a: u64, na: u64, b: u64, nb: u64) -> bool {
    let ea: u64 = path_len(a, na)
    let eb: u64 = path_len(b, nb)
    if ea > eb {
        return false
    }
    var i: u64 = 0
    while i < ea {
        if rd(a, i) != rd(b, i) {
            return false
        }
        i = i + 1
    }
    if ea == eb {
        return true
    }
    if rd(b, ea) == 47 {
        return true
    }
    if ea > 0 && rd(a, ea - 1) == 47 {
        return true
    }
    return false
}

fn query_off(p: u64, n: u64) -> u64 {
    let e: u64 = path_len(p, n)
    if e >= n {
        return NONE
    }
    return e + 1
}

fn query_get(p: u64, n: u64, key: u64, klen: u64) -> u64 {
    let q: u64 = query_off(p, n)
    if q == NONE {
        return NONE
    }
    var i: u64 = q
    while i < n {
        var j: u64 = i
        while j < n && rd(p, j) != 61 && rd(p, j) != 38 {
            j = j + 1
        }
        var m: bool = j - i == klen
        if m {
            var k: u64 = 0
            while k < klen {
                if rd(p, i + k) != rd(key, k) {
                    m = false
                }
                k = k + 1
            }
        }
        if m && j < n && rd(p, j) == 61 {
            return j + 1
        }
        while j < n && rd(p, j) != 38 {
            j = j + 1
        }
        i = j + 1
    }
    return NONE
}

fn hex_digit(v: u64) -> u64 {
    if v > 9 {
        return 55 + v
    }
    return 48 + v
}

fn enc_seg(out: u64, cap: u64, p: u64, n: u64) -> u64 {
    var o: u64 = 0
    var i: u64 = 0
    while i < n {
        let c: u64 = rd(p, i)
        let plain: bool = is_lower(c) || (c >= 65 && c <= 90) || is_digit(c) || c == 45 || c == 95 || c == 126 || (c == 46 && n > 2)
        if plain {
            if o + 1 >= cap {
                return NONE
            }
            wr(out, o, c)
            o = o + 1
        } else {
            if o + 3 >= cap {
                return NONE
            }
            wr(out, o, 37)
            wr(out, o + 1, hex_digit(c / 16))
            wr(out, o + 2, hex_digit(c % 16))
            o = o + 3
        }
        i = i + 1
    }
    wr(out, o, 0)
    return o
}

fn dec_seg(out: u64, cap: u64, p: u64, n: u64) -> u64 {
    var o: u64 = 0
    var i: u64 = 0
    while i < n {
        let c: u64 = rd(p, i)
        if o + 1 >= cap {
            return NONE
        }
        if c == 37 {
            if i + 2 >= n {
                return NONE
            }
            if !is_hex(rd(p, i + 1)) || !is_hex(rd(p, i + 2)) {
                return NONE
            }
            wr(out, o, hex_val(rd(p, i + 1)) * 16 + hex_val(rd(p, i + 2)))
            i = i + 3
        } else {
            wr(out, o, c)
            i = i + 1
        }
        o = o + 1
    }
    wr(out, o, 0)
    return o
}
