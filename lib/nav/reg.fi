// SPDX-License-Identifier: MPL-2.0
import nav.route

export {
    NONE, UNMEASURED, MAX_DEPTH, MAX_ROUTES, MAX_REL, MAX_APPS, DEFAULT_LIMIT,
    F_ADVANCED, F_HIDDEN, F_DYNAMIC, F_HOME,
    E_HEADER, E_APP, E_ROUTE, E_DUP, E_NO_ROUTE, E_ITEM, E_NAME, E_FULL, E_POOL, E_NO_PARENT, E_DEPTH,
    E_SCHEME, E_DUP_APP, E_MISMATCH, E_LIMIT,
    reset, err_code, err_line, set_err, txn_begin, txn_rollback, app_add, app_limit_set, app_limit,
    route_add, route_kw, route_controls, related_add,
    count, app_count, app_name, app_root, app_find, find, resolve, rest_off, parent, child_count, child_at,
    depth, uri, uri_len, title_key, icon_name, order, flags, controls, kw_key, route_app,
    related_count, related_to, related_key, limit_set,
    lint, lint_count, lint_kind, lint_route, sidebar_count, sidebar_at, text_len,
    L_OVER, L_UNMEASURED, L_DUP_TITLE, L_DUP_ORDER, L_SIDEBAR, L_RELATED,
}

const NONE: u64 = 4294967295
const UNMEASURED: u64 = 65535
const MAX_DEPTH: u64 = 4
const MAX_ROUTES: u64 = 192
const MAX_REL: u64 = 96
const MAX_APPS: u64 = 8
const POOL_MAX: u64 = 20480
const DEFAULT_LIMIT: u64 = 8
const MAX_SIDEBAR: u64 = 12

const F_ADVANCED: u64 = 1
const F_HIDDEN: u64 = 2
const F_DYNAMIC: u64 = 4
const F_HOME: u64 = 8

const E_HEADER: u64 = 1
const E_APP: u64 = 2
const E_ROUTE: u64 = 3
const E_DUP: u64 = 4
const E_NO_ROUTE: u64 = 5
const E_ITEM: u64 = 6
const E_NAME: u64 = 7
const E_FULL: u64 = 8
const E_POOL: u64 = 9
const E_NO_PARENT: u64 = 10
const E_DEPTH: u64 = 11
const E_SCHEME: u64 = 12
const E_DUP_APP: u64 = 13
const E_MISMATCH: u64 = 14
const E_LIMIT: u64 = 15

const L_OVER: u64 = 1
const L_UNMEASURED: u64 = 2
const L_DUP_TITLE: u64 = 3
const L_DUP_ORDER: u64 = 4
const L_SIDEBAR: u64 = 5
const L_RELATED: u64 = 6

static mut pool: [u8; 20480] = [0 as u8; 20480]
static mut pool_n: u64 = 0
static mut r_uri: [u64; 192] = [0 as u64; 192]
static mut r_ulen: [u64; 192] = [0 as u64; 192]
static mut r_title: [u64; 192] = [0 as u64; 192]
static mut r_sym: [u64; 192] = [0 as u64; 192]
static mut r_order: [u64; 192] = [0 as u64; 192]
static mut r_flags: [u64; 192] = [0 as u64; 192]
static mut r_parent: [u64; 192] = [0 as u64; 192]
static mut r_depth: [u64; 192] = [0 as u64; 192]
static mut r_ctrl: [u64; 192] = [0 as u64; 192]
static mut r_kw: [u64; 192] = [0 as u64; 192]
static mut r_app: [u64; 192] = [0 as u64; 192]
static mut r_rel_first: [u64; 192] = [0 as u64; 192]
static mut r_rel_n: [u64; 192] = [0 as u64; 192]
static mut n_routes: u64 = 0
static mut rl_to: [u64; 96] = [0 as u64; 96]
static mut rl_key: [u64; 96] = [0 as u64; 96]
static mut n_rel: u64 = 0
static mut ap_name: [u64; 8] = [0 as u64; 8]
static mut ap_root: [u64; 8] = [0 as u64; 8]
static mut ap_limit: [u64; 8] = [0 as u64; 8]
static mut n_apps: u64 = 0
static mut b_routes: u64 = 0
static mut b_rel: u64 = 0
static mut b_apps: u64 = 0
static mut b_pool: u64 = 0
static mut global_limit: u64 = 0
static mut err: u64 = 0
static mut err_ln: u64 = 0
static mut rest: u64 = 0
static mut lt_kind: [u64; 64] = [0 as u64; 64]
static mut lt_route: [u64; 64] = [0 as u64; 64]
static mut n_lint: u64 = 0
static mut tmp: [u8; 320] = [0 as u8; 320]

fn reset() {
    pool_n = 0
    n_routes = 0
    n_rel = 0
    n_apps = 0
    b_routes = 0
    b_rel = 0
    b_apps = 0
    b_pool = 0
    global_limit = 0
    err = 0
    err_ln = 0
    rest = NONE
    n_lint = 0
}

fn err_code() -> u64 {
    return err
}

fn err_line() -> u64 {
    return err_ln
}

fn set_err(code: u64, line: u64) -> u64 {
    if err == 0 {
        err = code
        err_ln = line
    } else {
        if err_ln == 0 {
            err_ln = line
        }
    }
    return 0
}

fn txn_begin() {
    b_routes = n_routes
    b_rel = n_rel
    b_apps = n_apps
    b_pool = pool_n
    err = 0
    err_ln = 0
}

fn txn_rollback() {
    n_routes = b_routes
    n_rel = b_rel
    n_apps = b_apps
    pool_n = b_pool
    var i: u64 = 0
    while i < n_routes {
        if r_rel_first[(i) as usize] + r_rel_n[(i) as usize] > n_rel {
            r_rel_n[(i) as usize] = n_rel - r_rel_first[(i) as usize]
        }
        i = i + 1
    }
}

fn pool_ptr(off: u64) -> u64 {
    if off == 0 {
        return 0
    }
    return ((&pool[0]) as u64) + (off - 1)
}

fn text_len(p: u64) -> u64 {
    if p == 0 {
        return 0
    }
    var n: u64 = 0
    while route.rd(p, n) != 0 {
        n = n + 1
    }
    return n
}

fn put(p: u64, n: u64) -> u64 {
    if pool_n + n + 1 > POOL_MAX {
        return 0
    }
    let off: u64 = pool_n
    var i: u64 = 0
    while i < n {
        pool[(off + i) as usize] = (route.rd(p, i) & 255) as u8
        i = i + 1
    }
    pool[(off + n) as usize] = 0 as u8
    pool_n = off + n + 1
    return off + 1
}

fn str_eq(a: u64, na: u64, b: u64, nb: u64) -> bool {
    if na != nb {
        return false
    }
    var i: u64 = 0
    while i < na {
        if route.rd(a, i) != route.rd(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn name_ok(p: u64, n: u64, max: u64) -> bool {
    if n == 0 || n > max {
        return false
    }
    var i: u64 = 0
    while i < n {
        let c: u64 = route.rd(p, i)
        if !((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 46 || c == 45 || c == 95) {
            return false
        }
        i = i + 1
    }
    return true
}

fn count() -> u64 {
    return n_routes
}

fn app_count() -> u64 {
    return n_apps
}

fn app_name(a: u64) -> u64 {
    return pool_ptr(ap_name[(a) as usize])
}

fn app_root(a: u64) -> u64 {
    return ap_root[(a) as usize]
}

fn app_find(p: u64, n: u64) -> u64 {
    var a: u64 = 0
    while a < n_apps {
        let q: u64 = pool_ptr(ap_name[(a) as usize])
        if str_eq(q, text_len(q), p, n) {
            return a
        }
        a = a + 1
    }
    return NONE
}

fn app_limit_set(a: u64, n: u64) {
    ap_limit[(a) as usize] = n
}

fn app_limit(a: u64) -> u64 {
    if global_limit != 0 {
        return global_limit
    }
    let l: u64 = ap_limit[(a) as usize]
    if l == 0 {
        return DEFAULT_LIMIT
    }
    return l
}

fn limit_set(n: u64) {
    global_limit = n
}

fn new_route(u: u64, ul: u64, t: u64, tl: u64, s: u64, sl: u64, ord: u64, fl: u64, par: u64, dep: u64, ap: u64) -> u64 {
    if n_routes >= MAX_ROUTES {
        return set_err(E_FULL, 0) + NONE
    }
    let ou: u64 = put(u, ul)
    let ot: u64 = put(t, tl)
    let os: u64 = put(s, sl)
    if ou == 0 || ot == 0 || os == 0 {
        return set_err(E_POOL, 0) + NONE
    }
    let i: usize = n_routes as usize
    r_uri[i] = ou
    r_ulen[i] = ul
    r_title[i] = ot
    r_sym[i] = os
    r_order[i] = ord
    r_flags[i] = fl
    r_parent[i] = par
    r_depth[i] = dep
    r_ctrl[i] = UNMEASURED
    r_kw[i] = 0
    r_app[i] = ap
    r_rel_first[i] = n_rel
    r_rel_n[i] = 0
    n_routes = n_routes + 1
    return i as u64
}

fn app_add(name: u64, nl: u64, title: u64, tl: u64, sym: u64, sl: u64) -> u64 {
    if !name_ok(name, nl, 16) || !name_ok(title, tl, 64) || !name_ok(sym, sl, 40) {
        return set_err(E_NAME, 0)
    }
    if app_find(name, nl) != NONE {
        return set_err(E_DUP_APP, 0)
    }
    if n_apps >= MAX_APPS {
        return set_err(E_FULL, 0)
    }
    let on: u64 = put(name, nl)
    if on == 0 {
        return set_err(E_POOL, 0)
    }
    var k: u64 = 0
    while k < nl {
        route.wr((&tmp[0]) as u64, k, route.rd(name, k))
        k = k + 1
    }
    route.wr((&tmp[0]) as u64, nl, 58)
    route.wr((&tmp[0]) as u64, nl + 1, 47)
    route.wr((&tmp[0]) as u64, nl + 2, 47)
    let id: u64 = new_route((&tmp[0]) as u64, nl + 3, title, tl, sym, sl, 0, 0, NONE, 0, n_apps)
    if id == NONE {
        return 0
    }
    ap_name[(n_apps) as usize] = on
    ap_root[(n_apps) as usize] = id
    ap_limit[(n_apps) as usize] = 0
    n_apps = n_apps + 1
    return 1
}

fn find(p: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < n_routes {
        if r_ulen[(i) as usize] == n && str_eq(pool_ptr(r_uri[(i) as usize]), n, p, n) {
            return i
        }
        i = i + 1
    }
    return NONE
}

fn route_add(u: u64, ul: u64, t: u64, tl: u64, s: u64, sl: u64, ord: u64, fl: u64) -> u64 {
    if n_apps == 0 {
        return set_err(E_APP, 0) + NONE
    }
    let ap: u64 = n_apps - 1
    if !route.valid(u, ul) || route.query_off(u, ul) != NONE {
        return set_err(E_ROUTE, 0) + NONE
    }
    let sc: u64 = route.scheme_len(u, ul)
    let an: u64 = pool_ptr(ap_name[(ap) as usize])
    if !str_eq(u, sc, an, text_len(an)) {
        return set_err(E_SCHEME, 0) + NONE
    }
    var k: u64 = 0
    while k < sc {
        let c: u64 = route.rd(u, k)
        if c >= 65 && c <= 90 {
            return set_err(E_ROUTE, 0) + NONE
        }
        k = k + 1
    }
    let dep: u64 = route.depth(u, ul)
    if dep == 0 {
        return set_err(E_ROUTE, 0) + NONE
    }
    if dep > MAX_DEPTH {
        return set_err(E_DEPTH, 0) + NONE
    }
    if !name_ok(t, tl, 64) || !name_ok(s, sl, 40) {
        return set_err(E_NAME, 0) + NONE
    }
    var si: u64 = 0
    while si < dep {
        let o: u64 = route.seg_off(u, ul, si)
        if !name_ok(u + o, route.seg_len(u, ul, si), 40) {
            return set_err(E_NAME, 0) + NONE
        }
        si = si + 1
    }
    if find(u, ul) != NONE {
        return set_err(E_DUP, 0) + NONE
    }
    let pl: u64 = route.parent_len(u, ul)
    let par: u64 = find(u, pl)
    if par == NONE {
        return set_err(E_NO_PARENT, 0) + NONE
    }
    if r_flags[(par) as usize] / F_DYNAMIC % 2 == 1 {
        return set_err(E_NO_PARENT, 0) + NONE
    }
    return new_route(u, ul, t, tl, s, sl, ord, fl, par, dep, ap)
}

fn route_kw(id: u64, p: u64, n: u64) -> u64 {
    if !name_ok(p, n, 64) {
        return set_err(E_NAME, 0)
    }
    if r_kw[(id) as usize] != 0 {
        return set_err(E_ITEM, 0)
    }
    let o: u64 = put(p, n)
    if o == 0 {
        return set_err(E_POOL, 0)
    }
    r_kw[(id) as usize] = o
    return 1
}

fn route_controls(id: u64, n: u64) -> u64 {
    if r_ctrl[(id) as usize] != UNMEASURED || n >= UNMEASURED {
        return set_err(E_ITEM, 0)
    }
    r_ctrl[(id) as usize] = n
    return 1
}

fn related_add(id: u64, to: u64, tl: u64, key: u64, kl: u64) -> u64 {
    if !route.valid(to, tl) || route.query_off(to, tl) != NONE || !name_ok(key, kl, 64) {
        return set_err(E_NAME, 0)
    }
    if n_rel >= MAX_REL || r_rel_n[(id) as usize] >= 4 {
        return set_err(E_FULL, 0)
    }
    if r_rel_first[(id) as usize] + r_rel_n[(id) as usize] != n_rel {
        return set_err(E_ITEM, 0)
    }
    let ot: u64 = put(to, tl)
    let ok: u64 = put(key, kl)
    if ot == 0 || ok == 0 {
        return set_err(E_POOL, 0)
    }
    rl_to[(n_rel) as usize] = ot
    rl_key[(n_rel) as usize] = ok
    n_rel = n_rel + 1
    r_rel_n[(id) as usize] = r_rel_n[(id) as usize] + 1
    return 1
}

fn resolve(p: u64, n: u64) -> u64 {
    rest = NONE
    var best: u64 = NONE
    var bd: u64 = 0
    var i: u64 = 0
    while i < n_routes {
        let ru: u64 = pool_ptr(r_uri[(i) as usize])
        let rl: u64 = r_ulen[(i) as usize]
        var hit: bool = false
        if r_flags[(i) as usize] / F_DYNAMIC % 2 == 1 {
            hit = route.is_prefix(ru, rl, p, n)
        } else {
            hit = route.same_path(ru, rl, p, n)
        }
        if hit && (best == NONE || r_depth[(i) as usize] >= bd) {
            best = i
            bd = r_depth[(i) as usize]
        }
        i = i + 1
    }
    if best != NONE {
        let bl: u64 = r_ulen[(best) as usize]
        let pe: u64 = route.path_len(p, n)
        if pe > bl {
            rest = bl + 1
        }
    }
    return best
}

fn rest_off() -> u64 {
    return rest
}

fn parent(id: u64) -> u64 {
    return r_parent[(id) as usize]
}

fn depth(id: u64) -> u64 {
    return r_depth[(id) as usize]
}

fn uri(id: u64) -> u64 {
    return pool_ptr(r_uri[(id) as usize])
}

fn uri_len(id: u64) -> u64 {
    return r_ulen[(id) as usize]
}

fn title_key(id: u64) -> u64 {
    return pool_ptr(r_title[(id) as usize])
}

fn icon_name(id: u64) -> u64 {
    return pool_ptr(r_sym[(id) as usize])
}

fn order(id: u64) -> u64 {
    return r_order[(id) as usize]
}

fn flags(id: u64) -> u64 {
    return r_flags[(id) as usize]
}

fn controls(id: u64) -> u64 {
    return r_ctrl[(id) as usize]
}

fn kw_key(id: u64) -> u64 {
    return pool_ptr(r_kw[(id) as usize])
}

fn route_app(id: u64) -> u64 {
    return r_app[(id) as usize]
}

fn related_count(id: u64) -> u64 {
    return r_rel_n[(id) as usize]
}

fn related_to(id: u64, i: u64) -> u64 {
    return pool_ptr(rl_to[(r_rel_first[(id) as usize] + i) as usize])
}

fn related_key(id: u64, i: u64) -> u64 {
    return pool_ptr(rl_key[(r_rel_first[(id) as usize] + i) as usize])
}

fn before(a: u64, b: u64) -> bool {
    let oa: u64 = r_order[(a) as usize]
    let ob: u64 = r_order[(b) as usize]
    if oa != ob {
        return oa < ob
    }
    return a < b
}

fn child_count(id: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < n_routes {
        if r_parent[(i) as usize] == id {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn child_at(id: u64, idx: u64) -> u64 {
    var c: u64 = 0
    while c < n_routes {
        if r_parent[(c) as usize] == id {
            var rank: u64 = 0
            var s: u64 = 0
            while s < n_routes {
                if r_parent[(s) as usize] == id && s != c && before(s, c) {
                    rank = rank + 1
                }
                s = s + 1
            }
            if rank == idx {
                return c
            }
        }
        c = c + 1
    }
    return NONE
}

fn listed(id: u64) -> bool {
    let f: u64 = r_flags[(id) as usize]
    return f / F_ADVANCED % 2 == 0 && f / F_HIDDEN % 2 == 0
}

fn sidebar_count(app: u64) -> u64 {
    let root: u64 = ap_root[(app) as usize]
    var n: u64 = 0
    var i: u64 = 0
    while i < n_routes {
        if r_parent[(i) as usize] == root && listed(i) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn sidebar_at(app: u64, idx: u64) -> u64 {
    let root: u64 = ap_root[(app) as usize]
    var k: u64 = 0
    var j: u64 = 0
    while j < child_count(root) {
        let c: u64 = child_at(root, j)
        if listed(c) {
            if k == idx {
                return c
            }
            k = k + 1
        }
        j = j + 1
    }
    return NONE
}

fn lint_add(kind: u64, id: u64) {
    if n_lint < 64 {
        lt_kind[(n_lint) as usize] = kind
        lt_route[(n_lint) as usize] = id
        n_lint = n_lint + 1
    }
}

fn lint_count() -> u64 {
    return n_lint
}

fn lint_kind(i: u64) -> u64 {
    return lt_kind[(i) as usize]
}

fn lint_route(i: u64) -> u64 {
    return lt_route[(i) as usize]
}

fn lint(over: u64) -> u64 {
    n_lint = 0
    var i: u64 = 0
    while i < n_routes {
        let ap: u64 = r_app[(i) as usize]
        var lim: u64 = app_limit(ap)
        if over != 0 {
            lim = over
        }
        let fl: u64 = r_flags[(i) as usize]
        if r_parent[(i) as usize] != NONE && fl / F_ADVANCED % 2 == 0 {
            if r_ctrl[(i) as usize] == UNMEASURED {
                lint_add(L_UNMEASURED, i)
            } else {
                if r_ctrl[(i) as usize] > lim {
                    lint_add(L_OVER, i)
                }
            }
        }
        var j: u64 = i + 1
        while j < n_routes {
            if r_parent[(j) as usize] == r_parent[(i) as usize] && r_parent[(i) as usize] != NONE {
                let ti: u64 = title_key(i)
                let tj: u64 = title_key(j)
                if str_eq(ti, text_len(ti), tj, text_len(tj)) {
                    lint_add(L_DUP_TITLE, j)
                }
                if r_order[(i) as usize] == r_order[(j) as usize] {
                    lint_add(L_DUP_ORDER, j)
                }
            }
            j = j + 1
        }
        var r: u64 = 0
        while r < r_rel_n[(i) as usize] {
            let tp: u64 = related_to(i, r)
            if find(tp, text_len(tp)) == NONE && resolve(tp, text_len(tp)) == NONE {
                lint_add(L_RELATED, i)
            }
            r = r + 1
        }
        i = i + 1
    }
    var a: u64 = 0
    while a < n_apps {
        if sidebar_count(a) > MAX_SIDEBAR {
            lint_add(L_SIDEBAR, ap_root[(a) as usize])
        }
        a = a + 1
    }
    return n_lint
}
