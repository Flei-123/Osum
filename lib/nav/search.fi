// SPDX-License-Identifier: MPL-2.0
import nav.route
import nav.reg

export { ROW_BASE, clear, set, row_set, row_route, row_hint, row_hint_len, query, count_rows }

const ROW_BASE: u64 = 1048576
const POOL: u64 = 24576
const MAX_WORDS: u64 = 6

static mut pool: [u8; 24576] = [0 as u8; 24576]
static mut pool_n: u64 = 0
static mut t_off: [u64; 192] = [0 as u64; 192]
static mut t_len: [u64; 192] = [0 as u64; 192]
static mut k_off: [u64; 192] = [0 as u64; 192]
static mut k_len: [u64; 192] = [0 as u64; 192]
static mut w_row_route: [u64; 128] = [0 as u64; 128]
static mut w_row_off: [u64; 128] = [0 as u64; 128]
static mut w_row_len: [u64; 128] = [0 as u64; 128]
static mut w_row_hoff: [u64; 128] = [0 as u64; 128]
static mut w_row_hlen: [u64; 128] = [0 as u64; 128]
static mut n_rows: u64 = 0
static mut qpos: [u64; 6] = [0 as u64; 6]
static mut qlen: [u64; 6] = [0 as u64; 6]
static mut qn: u64 = 0
static mut hit_rank: [u64; 320] = [0 as u64; 320]
static mut hit_id: [u64; 320] = [0 as u64; 320]
static mut n_hit: u64 = 0

fn clear() {
    pool_n = 0
    n_rows = 0
    var i: u64 = 0
    while i < 192 {
        t_len[(i) as usize] = 0
        k_len[(i) as usize] = 0
        i = i + 1
    }
}

fn put(p: u64, n: u64) -> u64 {
    if pool_n + n + 1 > POOL {
        return 0
    }
    let off: u64 = pool_n
    var i: u64 = 0
    while i < n {
        pool[(off + i) as usize] = (route.lower(route.rd(p, i)) & 255) as u8
        i = i + 1
    }
    pool[(off + n) as usize] = 0 as u8
    pool_n = off + n + 1
    return off + 1
}

fn set(id: u64, t: u64, tl: u64, k: u64, kl: u64) -> bool {
    if id >= 192 {
        return false
    }
    let a: u64 = put(t, tl)
    if a == 0 {
        return false
    }
    t_off[(id) as usize] = a
    t_len[(id) as usize] = tl
    if kl == 0 {
        k_len[(id) as usize] = 0
        return true
    }
    let b: u64 = put(k, kl)
    if b == 0 {
        return false
    }
    k_off[(id) as usize] = b
    k_len[(id) as usize] = kl
    return true
}

fn count_rows() -> u64 {
    return n_rows
}

fn row_set(id: u64, text: u64, tl: u64, hint: u64, hl: u64) -> u64 {
    if n_rows >= 128 {
        return route.NONE
    }
    let a: u64 = put(text, tl)
    if a == 0 {
        return route.NONE
    }
    var hoff: u64 = 0
    if hl > 0 {
        hoff = put(hint, hl)
        if hoff == 0 {
            return route.NONE
        }
    }
    let r: u64 = n_rows
    w_row_route[(r) as usize] = id
    w_row_off[(r) as usize] = a
    w_row_len[(r) as usize] = tl
    w_row_hoff[(r) as usize] = hoff
    w_row_hlen[(r) as usize] = hl
    n_rows = n_rows + 1
    return r
}

fn row_route(r: u64) -> u64 {
    return w_row_route[(r) as usize]
}

fn row_hint(r: u64) -> u64 {
    if w_row_hoff[(r) as usize] == 0 {
        return 0
    }
    return ((&pool[0]) as u64) + (w_row_hoff[(r) as usize] - 1)
}

fn row_hint_len(r: u64) -> u64 {
    return w_row_hlen[(r) as usize]
}

fn is_sep(c: u64) -> bool {
    return c == 32 || c == 9 || c == 45 || c == 46 || c == 47 || c == 95 || c == 44 || c == 58
}

fn word_in(off: u64, len: u64, w: u64) -> bool {
    if off == 0 || len == 0 {
        return false
    }
    let base: u64 = ((&pool[0]) as u64) + (off - 1)
    let ql: u64 = qlen[(w) as usize]
    let qp: u64 = qpos[(w) as usize]
    var i: u64 = 0
    while i < len {
        if i == 0 || is_sep(route.rd(base, i - 1)) {
            if i + ql <= len {
                var m: bool = true
                var k: u64 = 0
                while k < ql && m {
                    if route.rd(base, i + k) != route.lower(route.rd(qp, k)) {
                        m = false
                    }
                    k = k + 1
                }
                if m {
                    return true
                }
            }
        }
        i = i + 1
    }
    return false
}

fn split_query(q: u64, n: u64) {
    qn = 0
    var i: u64 = 0
    var in_w: bool = false
    while i < n {
        let c: u64 = route.rd(q, i)
        if c == 32 || c == 9 {
            in_w = false
        } else {
            if !in_w && qn < MAX_WORDS {
                qpos[(qn) as usize] = q + i
                qlen[(qn) as usize] = 0
                qn = qn + 1
                in_w = true
            }
            if in_w {
                qlen[(qn - 1) as usize] = qlen[(qn - 1) as usize] + 1
            }
        }
        i = i + 1
    }
}

fn rank_of(id: u64) -> u64 {
    var all_title: bool = true
    var all_any: bool = true
    var w: u64 = 0
    while w < qn {
        let in_t: bool = word_in(t_off[(id) as usize], t_len[(id) as usize], w)
        let in_k: bool = word_in(k_off[(id) as usize], k_len[(id) as usize], w)
        if !in_t {
            all_title = false
        }
        if !in_t && !in_k {
            all_any = false
        }
        w = w + 1
    }
    if all_title {
        return 0
    }
    if all_any {
        return 1
    }
    return 9
}

fn row_rank(r: u64) -> u64 {
    var w: u64 = 0
    while w < qn {
        if !word_in(w_row_off[(r) as usize], w_row_len[(r) as usize], w) {
            return 9
        }
        w = w + 1
    }
    return 2
}

fn add_hit(rank: u64, id: u64) {
    if n_hit < 320 {
        hit_rank[(n_hit) as usize] = rank
        hit_id[(n_hit) as usize] = id
        n_hit = n_hit + 1
    }
}

fn query(q: u64, ql: u64, out: u64, cap: u64) -> u64 {
    n_hit = 0
    split_query(q, ql)
    if qn == 0 {
        return 0
    }
    var id: u64 = 0
    while id < reg.count() {
        if t_len[(id) as usize] > 0 && reg.flags(id) / reg.F_DYNAMIC % 2 == 0 {
            let r: u64 = rank_of(id)
            if r < 9 {
                add_hit(r, id)
            }
        }
        id = id + 1
    }
    var rw: u64 = 0
    while rw < n_rows {
        if row_rank(rw) < 9 {
            add_hit(2, ROW_BASE + rw)
        }
        rw = rw + 1
    }
    var rank: u64 = 0
    var o: u64 = 0
    while rank < 3 {
        var h: u64 = 0
        while h < n_hit && o < cap {
            if hit_rank[(h) as usize] == rank {
                *((out + o * 8) as *mut u64) = hit_id[(h) as usize]
                o = o + 1
            }
            h = h + 1
        }
        rank = rank + 1
    }
    return o
}
