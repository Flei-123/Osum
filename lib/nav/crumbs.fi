// SPDX-License-Identifier: MPL-2.0
import nav.route
import nav.reg

export {
    MAX, build, count, crumb_len, crumb_route, crumb_dynamic, crumb_seg_off, crumb_seg_len, fit,
}

const MAX: u64 = 24

static mut c_len: [u64; 24] = [0 as u64; 24]
static mut c_route: [u64; 24] = [0 as u64; 24]
static mut c_dyn: [u64; 24] = [0 as u64; 24]
static mut c_soff: [u64; 24] = [0 as u64; 24]
static mut c_slen: [u64; 24] = [0 as u64; 24]
static mut n: u64 = 0
static mut src: u64 = 0
static mut chain: [u64; 8] = [0 as u64; 8]

fn count() -> u64 {
    return n
}

fn crumb_len(i: u64) -> u64 {
    return c_len[(i) as usize]
}

fn crumb_route(i: u64) -> u64 {
    return c_route[(i) as usize]
}

fn crumb_dynamic(i: u64) -> bool {
    return c_dyn[(i) as usize] == 1
}

fn crumb_seg_off(i: u64) -> u64 {
    return c_soff[(i) as usize]
}

fn crumb_seg_len(i: u64) -> u64 {
    return c_slen[(i) as usize]
}

fn push_crumb(len: u64, rt: u64, dynamic: u64, soff: u64, slen: u64) {
    if n < MAX {
        c_len[(n) as usize] = len
        c_route[(n) as usize] = rt
        c_dyn[(n) as usize] = dynamic
        c_soff[(n) as usize] = soff
        c_slen[(n) as usize] = slen
        n = n + 1
    }
}

fn build(p: u64, plen: u64) -> u64 {
    n = 0
    src = p
    let id: u64 = reg.resolve(p, plen)
    if id == reg.NONE {
        return 0
    }
    var cn: u64 = 0
    var r: u64 = id
    while r != reg.NONE && cn < 8 {
        chain[(cn) as usize] = r
        cn = cn + 1
        r = reg.parent(r)
    }
    var k: u64 = cn
    while k > 0 {
        k = k - 1
        let rt: u64 = chain[(k) as usize]
        push_crumb(reg.uri_len(rt), rt, 0, 0, 0)
    }
    let rest: u64 = reg.rest_off()
    if rest != route.NONE {
        let pe: u64 = route.path_len(p, plen)
        var i: u64 = rest
        var s0: u64 = rest
        while i <= pe {
            if i == pe || route.rd(p, i) == 47 {
                if i > s0 {
                    push_crumb(i, id, 1, s0, i - s0)
                }
                s0 = i + 1
            }
            i = i + 1
        }
    }
    return n
}

fn fit(widths: u64, cnt: u64, avail: u64, sep: u64) -> u64 {
    if cnt == 0 {
        return 0
    }
    var used: u64 = *((widths + (cnt - 1) * 8) as *mut u64)
    var first: u64 = cnt - 1
    while first > 0 {
        let w: u64 = *((widths + (first - 1) * 8) as *mut u64)
        if used + sep + w > avail {
            return first
        }
        used = used + sep + w
        first = first - 1
    }
    return 0
}
