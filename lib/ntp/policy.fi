export {
    ACT_IGNORE, ACT_SLEW, ACT_STEP, ACT_REFUSE,
    DEADBAND_NS, SLEW_MAX_NS, PANIC_NS, TOLERANCE_NS, MIN_POLL_S, MAX_POLL_S,
    decide, retry_delay_s, kod_delay_s, abs_ns,
}

const ACT_IGNORE: u32 = 0
const ACT_SLEW: u32 = 1
const ACT_STEP: u32 = 2
const ACT_REFUSE: u32 = 3

const DEADBAND_NS: i64 = 1000000
const SLEW_MAX_NS: i64 = 128000000
const PANIC_NS: i64 = 1000000000000
const TOLERANCE_NS: i64 = 1000000000
const MIN_POLL_S: u64 = 64
const MAX_POLL_S: u64 = 3600

const FAST_ROUNDS: u64 = 6
const MEDIUM_ROUNDS: u64 = 12
const FAST_DELAY_S: u64 = 10
const MEDIUM_DELAY_S: u64 = 30
const SLOW_DELAY_S: u64 = 300

fn abs_ns(v: i64) -> i64 {
    if v < 0 {
        return 0 - v
    }
    return v
}

fn decide(offset_ns: i64, synced_before: bool) -> u32 {
    let a: i64 = abs_ns(offset_ns)
    if a < DEADBAND_NS {
        return ACT_IGNORE
    }
    if a <= SLEW_MAX_NS {
        return ACT_SLEW
    }
    if a <= PANIC_NS || !synced_before {
        return ACT_STEP
    }
    return ACT_REFUSE
}

fn retry_delay_s(round: u64) -> u64 {
    if round <= FAST_ROUNDS {
        return FAST_DELAY_S
    }
    if round <= MEDIUM_ROUNDS {
        return MEDIUM_DELAY_S
    }
    return SLOW_DELAY_S
}

fn kod_delay_s(current_s: u64) -> u64 {
    var next: u64 = current_s * 2
    if next < MIN_POLL_S {
        next = MIN_POLL_S
    }
    if next > MAX_POLL_S {
        next = MAX_POLL_S
    }
    return next
}
