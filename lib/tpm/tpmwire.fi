import std.rt
import libc.octets

export { TAG_NONE, TAG_SESS, RC_OK, RC_IO, cmd_begin, cmd_finish, put16, put32, put2b, put_pw_auth,
    get16, get32 }

const TAG_NONE: u64 = 0x8001
const TAG_SESS: u64 = 0x8002
const RC_OK: u64 = 0
const RC_IO: u64 = 0xFFFFFFFF

fn get16(p: u64, off: usize) -> u64 {
    return (octets.ld8_idx(p, off) << 8) | octets.ld8_idx(p, off + 1)
}

fn get32(p: u64, off: usize) -> u64 {
    return (get16(p, off) << 16) | get16(p, off + 2)
}

fn put16(b: *mut rt.Buf, v: u64) {
    rt.buf_push(b, ((v >> 8) & 255) as u8)
    rt.buf_push(b, (v & 255) as u8)
}

fn put32(b: *mut rt.Buf, v: u64) {
    put16(b, v >> 16)
    put16(b, v & 0xFFFF)
}

fn put2b(b: *mut rt.Buf, p: u64, n: usize) {
    put16(b, n as u64)
    if n > 0 {
        rt.buf_push_bytes(b, p, n)
    }
}

fn cmd_begin(b: *mut rt.Buf, tag: u64, cc: u64) {
    rt.buf_clear(b)
    put16(b, tag)
    put32(b, 0)
    put32(b, cc)
}

fn cmd_finish(b: *mut rt.Buf) {
    let n: usize = rt.buf_len(b)
    let p: u64 = rt.buf_ptr(b)
    octets.st8_idx(p, 2, (n as u64) >> 24)
    octets.st8_idx(p, 3, (n as u64) >> 16)
    octets.st8_idx(p, 4, (n as u64) >> 8)
    octets.st8_idx(p, 5, n as u64)
}

fn put_pw_auth(b: *mut rt.Buf) {
    put32(b, 9)
    put32(b, 0x40000009)
    put16(b, 0)
    rt.buf_push(b, 0 as u8)
    put16(b, 0)
}
