import std.rt
import std.net
import std.env
import tpm.tpmwire

export { connect, exec_sw, disconnect }

static mut conn: net.Conn = net.Conn { fd: -1, err: 0, peer: 0, peer_port: 0 }

fn connect() -> bool {
    let path: str = env.get("TPM_SOCK")
    if path.n == 0 {
        return false
    }
    let c: net.Conn = net.connect_unix(path.p as u64, path.n) catch net.Conn { fd: -1, err: 0, peer: 0, peer_port: 0 }
    conn = c
    return net.conn_is_open(&conn)
}

fn disconnect() {
    net.close(&conn)
}

fn exec_sw(cmd: u64, clen: u64, rsp: u64, rcap: u64) -> u64 {
    let w: usize = net.write_all(&conn, cmd, clen as usize) catch 0
    if w != clen as usize {
        return 0
    }
    let h: usize = net.read_full(&conn, rsp, 10) catch 0
    if h != 10 {
        return 0
    }
    let total: u64 = tpmwire.get32(rsp, 2)
    if total < 10 || total > rcap {
        return 0
    }
    if total > 10 {
        let r: usize = net.read_full(&conn, rsp + 10, (total - 10) as usize) catch 0
        if r != (total - 10) as usize {
            return 0
        }
    }
    return total
}
