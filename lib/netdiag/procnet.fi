// SPDX-License-Identifier: GPL-2.0-only
export { find, num_after, ip_after, line_end, NOT_FOUND }

const NOT_FOUND: u64 = 0xFFFFFFFFFFFFFFFF

fn ld8(p: u64, i: u64) -> u64 {
    return __mmio_read8((p + i) as *mut u8) as u64
}

fn find(p: u64, n: u64, key: u64, klen: u64) -> u64 {
    if klen == 0 || n < klen {
        return NOT_FOUND
    }
    var i: u64 = 0
    while i + klen <= n {
        var k: u64 = 0
        while k < klen && ld8(p, i + k) == ld8(key, k) {
            k = k + 1
        }
        if k == klen {
            return i + klen
        }
        i = i + 1
    }
    return NOT_FOUND
}

fn num_after(p: u64, n: u64, at: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = at
    while i < n {
        let c: u64 = ld8(p, i)
        if c < 48 || c > 57 {
            break
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

fn ip_after(p: u64, n: u64, at: u64) -> u64 {
    var v: u64 = 0
    var part: u64 = 0
    var dots: u64 = 0
    var digits: u64 = 0
    var i: u64 = at
    while i < n {
        let c: u64 = ld8(p, i)
        if c >= 48 && c <= 57 {
            part = part * 10 + (c - 48)
            if part > 255 {
                return 0
            }
            digits = digits + 1
        } else if c == 46 && dots < 3 && digits > 0 {
            v = (v << 8) | part
            part = 0
            digits = 0
            dots = dots + 1
        } else {
            break
        }
        i = i + 1
    }
    if dots != 3 || digits == 0 {
        return 0
    }
    return (v << 8) | part
}

fn line_end(p: u64, n: u64, at: u64) -> u64 {
    var i: u64 = at
    while i < n && ld8(p, i) != 10 {
        i = i + 1
    }
    return i
}
