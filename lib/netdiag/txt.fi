// SPDX-License-Identifier: GPL-2.0-only
export { ld8, st8, byte_at, str_at, dec_at, ip_at }

fn ld8(p: u64, i: u64) -> u64 {
    return __mmio_read8((p + i) as *mut u8) as u64
}

fn st8(p: u64, i: u64, v: u64) {
    __mmio_write8((p + i) as *mut u8, v as u8)
}

fn byte_at(p: u64, at: u64, cap: u64, v: u64) -> u64 {
    if at >= cap {
        return at
    }
    st8(p, at, v)
    return at + 1
}

fn str_at(p: u64, at: u64, cap: u64, q: u64) -> u64 {
    var a: u64 = at
    var k: u64 = 0
    while ld8(q, k) != 0 && k < 200 {
        a = byte_at(p, a, cap, ld8(q, k))
        k = k + 1
    }
    return a
}

fn dec_at(p: u64, at: u64, cap: u64, v: u64) -> u64 {
    var a: u64 = at
    var div: u64 = 1
    while v / div >= 10 {
        div = div * 10
    }
    while div > 0 {
        a = byte_at(p, a, cap, 48 + (v / div) % 10)
        div = div / 10
    }
    return a
}

fn ip_at(p: u64, at: u64, cap: u64, v: u64) -> u64 {
    var a: u64 = dec_at(p, at, cap, (v >> 24) & 255)
    a = byte_at(p, a, cap, 46)
    a = dec_at(p, a, cap, (v >> 16) & 255)
    a = byte_at(p, a, cap, 46)
    a = dec_at(p, a, cap, (v >> 8) & 255)
    a = byte_at(p, a, cap, 46)
    return dec_at(p, a, cap, v & 255)
}
