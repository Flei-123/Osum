import filelog.filelog

export { begin, text, num, ip, end }

static mut PATH_NET_LOG: [u8; 17] = "/var/log/net.log\0"

fn begin(tag: u64) {
    filelog.begin((&PATH_NET_LOG[0 as usize]) as u64, tag)
}

fn text(k: u64, val: u64) {
    filelog.text(k, val)
}

fn num(k: u64, v: u64) {
    filelog.num(k, v)
}

fn ip(k: u64, v: u64) {
    filelog.ip(k, v)
}

fn end() {
    filelog.end()
}
