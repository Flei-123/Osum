import libc.kcall
import netdiag.txt

export { alive_age_secs, NONE }

const NONE: u64 = 0xFFFFFFFF
const BAD: u64 = 0xFFFFFFFFFFFFF000

static mut PATH_ALIVE: [u8; 18] = "/var/jarvis/alive\0"
static mut BUF: [u8; 32] = [0 as u8; 32]

fn alive_age_secs(now_ms: u64) -> u64 {
    let fd: u64 = kcall.sys3(kcall.SYS_OPEN, (&PATH_ALIVE[0 as usize]) as u64, 0, 0)
    if fd > BAD {
        return NONE
    }
    let n: u64 = kcall.sys3(kcall.SYS_READ, fd, (&BUF[0 as usize]) as u64, 31)
    kcall.sys1(kcall.SYS_CLOSE, fd)
    if n > BAD || n == 0 {
        return NONE
    }
    var v: u64 = 0
    var i: u64 = 0
    while i < n && txt.ld8((&BUF[0 as usize]) as u64, i) >= 48 && txt.ld8((&BUF[0 as usize]) as u64, i) <= 57 {
        v = v * 10 + txt.ld8((&BUF[0 as usize]) as u64, i) - 48
        i = i + 1
    }
    if i == 0 {
        return NONE
    }
    if v > now_ms {
        return 0
    }
    return (now_ms - v) / 1000
}
