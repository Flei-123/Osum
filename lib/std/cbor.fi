// SPDX-License-Identifier: MPL-2.0
import std.rt

export { put_head, put_uint, put_int, put_bytes, put_text, put_text_raw,
    put_array, put_map, put_tag, put_bool, put_null, put_undefined,
    head_len, MAJ_UINT, MAJ_NINT, MAJ_BYTES, MAJ_TEXT, MAJ_ARRAY, MAJ_MAP,
    MAJ_TAG, MAJ_SIMPLE }

const MAJ_UINT: u64 = 0
const MAJ_NINT: u64 = 1
const MAJ_BYTES: u64 = 2
const MAJ_TEXT: u64 = 3
const MAJ_ARRAY: u64 = 4
const MAJ_MAP: u64 = 5
const MAJ_TAG: u64 = 6
const MAJ_SIMPLE: u64 = 7

fn head_len(arg: u64) -> usize {
    if arg < 24 {
        return 1
    }
    if arg < 256 {
        return 2
    }
    if arg < 65536 {
        return 3
    }
    if arg < 4294967296 {
        return 5
    }
    return 9
}

fn push_be(b: *mut rt.Buf, v: u64, k: usize) {
    var i: usize = k
    while i > 0 {
        i = i - 1
        rt.buf_push(b, ((v >> ((i * 8) as u64)) & 255) as u8)
    }
}

fn put_head(b: *mut rt.Buf, major: u64, arg: u64) {
    let m: u64 = major << 5
    if arg < 24 {
        rt.buf_push(b, (m | arg) as u8)
        return
    }
    if arg < 256 {
        rt.buf_push(b, (m | 24) as u8)
        push_be(b, arg, 1)
        return
    }
    if arg < 65536 {
        rt.buf_push(b, (m | 25) as u8)
        push_be(b, arg, 2)
        return
    }
    if arg < 4294967296 {
        rt.buf_push(b, (m | 26) as u8)
        push_be(b, arg, 4)
        return
    }
    rt.buf_push(b, (m | 27) as u8)
    push_be(b, arg, 8)
}

fn put_uint(b: *mut rt.Buf, v: u64) {
    put_head(b, MAJ_UINT, v)
}

fn put_int(b: *mut rt.Buf, v: i64) {
    if v >= 0 {
        put_head(b, MAJ_UINT, v as u64)
        return
    }
    put_head(b, MAJ_NINT, (-1 - v) as u64)
}

fn put_bytes(b: *mut rt.Buf, p: u64, n: usize) {
    put_head(b, MAJ_BYTES, n as u64)
    rt.buf_push_bytes(b, p, n)
}

fn put_text_raw(b: *mut rt.Buf, p: u64, n: usize) {
    put_head(b, MAJ_TEXT, n as u64)
    rt.buf_push_bytes(b, p, n)
}

fn put_text(b: *mut rt.Buf, s: str) {
    put_text_raw(b, s.p as u64, s.n)
}

fn put_array(b: *mut rt.Buf, count: usize) {
    put_head(b, MAJ_ARRAY, count as u64)
}

fn put_map(b: *mut rt.Buf, count: usize) {
    put_head(b, MAJ_MAP, count as u64)
}

fn put_tag(b: *mut rt.Buf, tag: u64) {
    put_head(b, MAJ_TAG, tag)
}

fn put_bool(b: *mut rt.Buf, v: bool) {
    if v {
        rt.buf_push(b, 245 as u8)
        return
    }
    rt.buf_push(b, 244 as u8)
}

fn put_null(b: *mut rt.Buf) {
    rt.buf_push(b, 246 as u8)
}

fn put_undefined(b: *mut rt.Buf) {
    rt.buf_push(b, 247 as u8)
}
