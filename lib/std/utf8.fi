import std.rt

export { utf8_valid }

fn cont(p: u64, i: usize) -> bool {
    return (rt.ld8(p, i) & 192 as u8) == 128 as u8
}

fn utf8_valid(p: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 128 as u8 {
            i = i + 1
        } else {
            if c >= 194 as u8 && c <= 223 as u8 {
                if i + 2 > n || !cont(p, i + 1) {
                    return false
                }
                i = i + 2
            } else {
                if c >= 224 as u8 && c <= 239 as u8 {
                    if i + 3 > n || !cont(p, i + 1) || !cont(p, i + 2) {
                        return false
                    }
                    let c1: u8 = rt.ld8(p, i + 1)
                    if c == 224 as u8 && c1 < 160 as u8 {
                        return false
                    }
                    if c == 237 as u8 && c1 > 159 as u8 {
                        return false
                    }
                    i = i + 3
                } else {
                    if c >= 240 as u8 && c <= 244 as u8 {
                        if i + 4 > n || !cont(p, i + 1) || !cont(p, i + 2)
                        || !cont(p, i + 3) {
                            return false
                        }
                        let c1: u8 = rt.ld8(p, i + 1)
                        if c == 240 as u8 && c1 < 144 as u8 {
                            return false
                        }
                        if c == 244 as u8 && c1 > 143 as u8 {
                            return false
                        }
                        i = i + 4
                    } else {
                        return false
                    }
                }
            }
        }
    }
    return true
}
