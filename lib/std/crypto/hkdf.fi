import std.crypto.hmac
import crypto.hkdfgen

export { hkdf_extract, hkdf_expand, hkdf, HKDF_HASH }

const HKDF_HASH: usize = 32

fn hkdf_extract(salt: u64, saltlen: usize, ikm: u64, ikmlen: usize, prk: u64) {
    hkdfgen.hkdf_extract(hmac.hmac_sha256, salt, saltlen, ikm, ikmlen, prk)
}

fn hkdf_expand(prk: u64, prklen: usize, info: u64, infolen: usize, out: u64, outlen: usize) -> bool {
    return hkdfgen.hkdf_expand(hmac.hmac_sha256, prk, prklen, info, infolen, out, outlen)
}

fn hkdf(salt: u64, saltlen: usize, ikm: u64, ikmlen: usize, info: u64, infolen: usize, out: u64,
    outlen: usize) -> bool {
    return hkdfgen.hkdf(hmac.hmac_sha256, salt, saltlen, ikm, ikmlen, info, infolen, out, outlen)
}
