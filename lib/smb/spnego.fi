import std.rt

export { wrap_init, wrap_response, parse_response, STATE_COMPLETED, STATE_INCOMPLETE, STATE_REJECT, STATE_NONE }

const STATE_COMPLETED: u64 = 0
const STATE_INCOMPLETE: u64 = 1
const STATE_REJECT: u64 = 2
const STATE_NONE: u64 = 99

fn len_size(n: usize) -> usize {
    if n < 128 {
        return 1
    }
    if n < 256 {
        return 2
    }
    return 3
}

fn put_len(out: *mut rt.Buf, n: usize) {
    if n < 128 {
        rt.buf_push(out, n as u8)
    } else if n < 256 {
        rt.buf_push(out, 129 as u8)
        rt.buf_push(out, n as u8)
    } else {
        rt.buf_push(out, 130 as u8)
        rt.buf_push(out, (n >> 8) as u8)
        rt.buf_push(out, (n & 255) as u8)
    }
}

fn tlv_size(content: usize) -> usize {
    return 1 + len_size(content) + content
}

fn put_header(out: *mut rt.Buf, tag: u8, content: usize) {
    rt.buf_push(out, tag)
    put_len(out, content)
}

fn wrap_init(token: u64, n: usize, out: *mut rt.Buf) {
    rt.buf_clear(out)
    let octets: usize = tlv_size(n)
    let mech_token: usize = tlv_size(octets)
    let mech_types: usize = 16
    let seq: usize = mech_types + mech_token
    let init: usize = tlv_size(seq)
    let init_tagged: usize = tlv_size(init)
    var oid: [u8; 8] = [6, 6, 43, 6, 1, 5, 5, 2]
    var ntlm_oid: [u8; 12] = [6, 10, 43, 6, 1, 4, 1, 130, 55, 2, 2, 10]
    put_header(out, 96 as u8, 8 + init_tagged)
    rt.buf_push_bytes(out, (&oid[0]) as u64, 8)
    put_header(out, 160 as u8, init)
    put_header(out, 48 as u8, seq)
    put_header(out, 160 as u8, 14)
    put_header(out, 48 as u8, 12)
    rt.buf_push_bytes(out, (&ntlm_oid[0]) as u64, 12)
    put_header(out, 162 as u8, octets)
    put_header(out, 4 as u8, n)
    rt.buf_push_bytes(out, token, n)
}

fn wrap_response(token: u64, n: usize, out: *mut rt.Buf) {
    rt.buf_clear(out)
    let octets: usize = tlv_size(n)
    let tagged: usize = tlv_size(octets)
    let seq: usize = tlv_size(tagged)
    put_header(out, 161 as u8, seq)
    put_header(out, 48 as u8, tagged)
    put_header(out, 162 as u8, octets)
    put_header(out, 4 as u8, n)
    rt.buf_push_bytes(out, token, n)
}

struct Der {
    tag: u8,
    start: usize,
    len: usize,
    next: usize,
}

fn der_read(p: u64, n: usize, at: usize, out: *mut Der) -> bool {
    if at + 2 > n {
        return false
    }
    let tag: u8 = rt.ld8(p, at)
    let first: usize = rt.ld8(p, at + 1) as usize
    var len: usize = first
    var start: usize = at + 2
    if first >= 128 {
        let count: usize = first - 128
        if count == 0 || count > 3 || start + count > n {
            return false
        }
        len = 0
        var i: usize = 0
        while i < count {
            len = len * 256 + rt.ld8(p, start + i) as usize
            i = i + 1
        }
        start = start + count
    }
    if start > n || len > n - start {
        return false
    }
    (*out).tag = tag
    (*out).start = start
    (*out).len = len
    (*out).next = start + len
    return true
}

fn der_new() -> Der {
    return Der { tag: 0 as u8, start: 0, len: 0, next: 0 }
}

fn parse_response(p: u64, n: usize, state: *mut u64, tok_at: *mut usize, tok_len: *mut usize) -> bool {
    var outer: Der = der_new()
    if !der_read(p, n, 0, &outer) || outer.tag != 161 as u8 {
        return false
    }
    var seq: Der = der_new()
    if !der_read(p, outer.next, outer.start, &seq) || seq.tag != 48 as u8 {
        return false
    }
    *state = 99
    *tok_at = 0
    *tok_len = 0
    var at: usize = seq.start
    while at < seq.next {
        var field: Der = der_new()
        if !der_read(p, seq.next, at, &field) {
            return false
        }
        var inner: Der = der_new()
        if field.len > 0 && !der_read(p, field.next, field.start, &inner) {
            return false
        }
        if field.tag == 160 as u8 {
            if inner.tag != 10 as u8 || inner.len != 1 {
                return false
            }
            *state = rt.ld8(p, inner.start) as u64
        } else if field.tag == 162 as u8 {
            if inner.tag != 4 as u8 {
                return false
            }
            *tok_at = inner.start
            *tok_len = inner.len
        }
        at = field.next
    }
    return true
}
