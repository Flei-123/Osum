import std.rt
import std.net
import smb.pack
import smb.wire
import smb.ntlm
import smb.spnego

export { connect, negotiate, login, tree_connect, tree_disconnect, logoff, set_signing,
    SIGNING_AUTO, SIGNING_OFF }

const SIGNING_AUTO: u64 = 0
const SIGNING_OFF: u64 = 1
const SEC_SIGNING_ENABLED: u64 = 1
const SEC_SIGNING_REQUIRED: u64 = 2
const SESSION_GUEST: u64 = 1
const SESSION_NULL: u64 = 2
const DIALECT_202: u64 = 514
const DIALECT_210: u64 = 528

static mut SIGNING_MODE: u64 = 0

fn set_signing(mode: u64) {
    SIGNING_MODE = mode
}

fn connect(s: *mut wire.Smb, addr: u32, port: u16, ms: u64) -> u64 {
    var failed: bool = false
    (*s).conn = net.connect_tcp(addr, port) catch | e | connect_failed(&failed)
    if failed {
        return wire.E_CONNECT
    }
    (*s).open = true
    let t: bool = net.set_timeout(&(*s).conn, ms) catch false
    return wire.E_OK
}

fn connect_failed(failed: *mut bool) -> net.Conn {
    *failed = true
    return net.Conn { fd: -1, err: 0, peer: 0 as u32, peer_port: 0 as u16 }
}

fn negotiate(s: *mut wire.Smb) -> u64 {
    var b: rt.Buf = rt.buf_new()
    pack.push16(&b, 36)
    pack.push16(&b, 2)
    pack.push16(&b, SEC_SIGNING_ENABLED)
    pack.push16(&b, 0)
    pack.push32(&b, 0)
    var guid: [u8; 16] = [0; 16]
    var i: usize = 0
    while i < 16 {
        guid[i] = ((i * 17 + 3) & 255) as u8
        i = i + 1
    }
    pack.push_raw(&b, (&guid[0]) as u64, 16)
    pack.push64(&b, 0)
    pack.push16(&b, DIALECT_202)
    pack.push16(&b, DIALECT_210)
    let code: u64 = wire.request(s, wire.CMD_NEGOTIATE, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    if code != wire.E_OK {
        return code
    }
    if (*s).status != wire.NT_SUCCESS {
        return wire.status_error((*s).status)
    }
    if wire.body_len(s) < 64 {
        return wire.E_PROTO
    }
    let body: u64 = wire.body_ptr(s)
    if pack.get16(body, 0) != 65 {
        return wire.E_PROTO
    }
    let mode: u64 = pack.get16(body, 2)
    (*s).dialect = pack.get16(body, 4)
    if (*s).dialect != DIALECT_202 && (*s).dialect != DIALECT_210 {
        return wire.E_PROTO
    }
    (*s).signing = false
    (*s).sign_wanted = SIGNING_MODE == SIGNING_AUTO && (mode & (SEC_SIGNING_ENABLED | SEC_SIGNING_REQUIRED)) != 0
    let max_read: u64 = pack.get32(body, 28)
    let max_write: u64 = pack.get32(body, 32)
    var cap: u64 = 61440
    if max_read < cap {
        cap = max_read
    }
    if max_write < cap {
        cap = max_write
    }
    if cap < 4096 {
        return wire.E_PROTO
    }
    (*s).max_io = cap as usize
    return wire.E_OK
}

fn session_setup(s: *mut wire.Smb, token: u64, n: usize) -> u64 {
    var b: rt.Buf = rt.buf_new()
    pack.push16(&b, 25)
    rt.buf_push(&b, 0 as u8)
    rt.buf_push(&b, SEC_SIGNING_ENABLED as u8)
    pack.push32(&b, 0)
    pack.push32(&b, 0)
    pack.push16(&b, 88)
    pack.push16(&b, n as u64)
    pack.push64(&b, 0)
    pack.push_raw(&b, token, n)
    let code: u64 = wire.request(s, wire.CMD_SESSION_SETUP, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    return code
}

fn login(s: *mut wire.Smb, user: u64, ulen: usize, domain: u64, dlen: usize,
    pw: u64, plen: usize) -> u64 {
    var st: ntlm.Ntlm = ntlm.ntlm_new()
    var raw: rt.Buf = rt.buf_new()
    var wrapped: rt.Buf = rt.buf_new()
    let code: u64 = login_steps(s, &st, &raw, &wrapped, user, ulen, domain, dlen, pw, plen)
    ntlm.ntlm_free(&st)
    rt.buf_free(&raw)
    rt.buf_free(&wrapped)
    return code
}

fn login_steps(s: *mut wire.Smb, st: *mut ntlm.Ntlm, raw: *mut rt.Buf, wrapped: *mut rt.Buf,
    user: u64, ulen: usize, domain: u64, dlen: usize, pw: u64, plen: usize) -> u64 {
    ntlm.negotiate_message(raw)
    spnego.wrap_init(rt.buf_ptr(raw), rt.buf_len(raw), wrapped)
    var code: u64 = session_setup(s, rt.buf_ptr(wrapped), rt.buf_len(wrapped))
    if code != wire.E_OK {
        return code
    }
    if (*s).status != wire.NT_MORE_PROCESSING {
        return wire.status_error((*s).status)
    }
    (*s).session_id = pack.get64(rt.buf_ptr(&(*s).rx), 40)
    if wire.body_len(s) < 8 {
        return wire.E_PROTO
    }
    let body: u64 = wire.body_ptr(s)
    let sec_off: usize = pack.get16(body, 4) as usize
    let sec_len: usize = pack.get16(body, 6) as usize
    if sec_off < wire.HEADER_SIZE || sec_off - wire.HEADER_SIZE + sec_len > wire.body_len(s) {
        return wire.E_PROTO
    }
    let sec: u64 = body + (sec_off - wire.HEADER_SIZE) as u64
    let at: usize = spnego.find_ntlm(sec, sec_len)
    if at >= sec_len {
        return wire.E_PROTO
    }
    if !ntlm.parse_challenge(st, sec + at as u64, sec_len - at) {
        return wire.E_PROTO
    }
    var host: [u8; 6] = "OSUM01"
    if !ntlm.authenticate_message(st, user, ulen, domain, dlen, (&host[0]) as u64, 6, pw, plen, raw) {
        return wire.E_IO
    }
    spnego.wrap_response(rt.buf_ptr(raw), rt.buf_len(raw), wrapped)
    code = session_setup(s, rt.buf_ptr(wrapped), rt.buf_len(wrapped))
    if code != wire.E_OK {
        return code
    }
    if (*s).status != wire.NT_SUCCESS {
        return wire.status_error((*s).status)
    }
    let flags: u64 = pack.get16(wire.body_ptr(s), 2)
    if (flags & (SESSION_GUEST | SESSION_NULL)) == 0 && (*s).sign_wanted {
        (*s).signing = true
        var i: usize = 0
        while i < 16 {
            (*s).sign_key[i] = (*st).session_key[i]
            i = i + 1
        }
    }
    return wire.E_OK
}

fn tree_connect(s: *mut wire.Smb, host: u64, hlen: usize, share: u64, slen: usize) -> u64 {
    var path: rt.Buf = rt.buf_new()
    var bs: [u8; 2] = [92, 92]
    var sep: [u8; 1] = [92]
    pack.push_utf16(&path, (&bs[0]) as u64, 2, false)
    pack.push_utf16(&path, host, hlen, false)
    pack.push_utf16(&path, (&sep[0]) as u64, 1, false)
    pack.push_utf16(&path, share, slen, false)
    var b: rt.Buf = rt.buf_new()
    pack.push16(&b, 9)
    pack.push16(&b, 0)
    pack.push16(&b, 72)
    pack.push16(&b, rt.buf_len(&path) as u64)
    pack.push_raw(&b, rt.buf_ptr(&path), rt.buf_len(&path))
    rt.buf_free(&path)
    let code: u64 = wire.request(s, wire.CMD_TREE_CONNECT, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    if code != wire.E_OK {
        return code
    }
    if (*s).status != wire.NT_SUCCESS {
        return wire.status_error((*s).status)
    }
    (*s).tree_id = pack.get32(rt.buf_ptr(&(*s).rx), 36)
    return wire.E_OK
}

fn simple_request(s: *mut wire.Smb, cmd: u64) -> u64 {
    var b: [u8; 4] = [4, 0, 0, 0]
    let code: u64 = wire.request(s, cmd, (&b[0]) as u64, 4)
    if code != wire.E_OK {
        return code
    }
    return wire.status_error((*s).status)
}

fn tree_disconnect(s: *mut wire.Smb) -> u64 {
    return simple_request(s, wire.CMD_TREE_DISCONNECT)
}

fn logoff(s: *mut wire.Smb) -> u64 {
    return simple_request(s, wire.CMD_LOGOFF)
}
