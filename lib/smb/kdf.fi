import std.rt
import std.crypto.hmac

export { derive }

fn derive(key: u64, label: u64, label_len: usize, ctx: u64, ctx_len: usize, out: u64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push(&b, 0 as u8)
    rt.buf_push(&b, 0 as u8)
    rt.buf_push(&b, 0 as u8)
    rt.buf_push(&b, 1 as u8)
    rt.buf_push_bytes(&b, label, label_len)
    rt.buf_push(&b, 0 as u8)
    rt.buf_push_bytes(&b, ctx, ctx_len)
    rt.buf_push(&b, 0 as u8)
    rt.buf_push(&b, 0 as u8)
    rt.buf_push(&b, 0 as u8)
    rt.buf_push(&b, 128 as u8)
    var mac: [u8; 32] = [0; 32]
    hmac.hmac_sha256(key, 16, rt.buf_ptr(&b), rt.buf_len(&b), (&mac[0]) as u64)
    rt.buf_free(&b)
    var i: usize = 0
    while i < 16 {
        rt.st8(out, i, mac[i])
        i = i + 1
    }
}
