// SPDX-License-Identifier: GPL-2.0-only
export { prefix_distance, max_edits }

const ROW: u64 = 66
const MIN_TYPO_LEN: u64 = 4
const LONG_TYPO_LEN: u64 = 7
const FAR: u64 = 99

static mut row_prev2: [u64; 66] = [0 as u64; 66]
static mut row_prev: [u64; 66] = [0 as u64; 66]
static mut row_cur: [u64; 66] = [0 as u64; 66]

fn at(p: u64, i: u64) -> u64 {
    return (*((p + i) as *mut u8)) as u64
}

fn min2(a: u64, b: u64) -> u64 {
    if a < b {
        return a
    }
    return b
}

fn max_edits(query_len: u64) -> u64 {
    if query_len < MIN_TYPO_LEN {
        return 0
    }
    if query_len < LONG_TYPO_LEN {
        return 1
    }
    return 2
}

fn cell(i: u64, j: u64, q: u64, t: u64) -> u64 {
    var cost: u64 = 1
    if at(q, i - 1) == at(t, j - 1) {
        cost = 0
    }
    var best: u64 = min2(row_prev[(j) as usize] + 1, row_cur[(j - 1) as usize] + 1)
    best = min2(best, row_prev[(j - 1) as usize] + cost)
    if i > 1 && j > 1 && at(q, i - 1) == at(t, j - 2) && at(q, i - 2) == at(t, j - 1) {
        best = min2(best, row_prev2[(j - 2) as usize] + 1)
    }
    return best
}

fn shift_rows(tn: u64) {
    var j: u64 = 0
    while j <= tn {
        row_prev2[(j) as usize] = row_prev[(j) as usize]
        row_prev[(j) as usize] = row_cur[(j) as usize]
        j = j + 1
    }
}

fn prefix_distance(q: u64, qn: u64, t: u64, tn: u64) -> u64 {
    if qn == 0 || qn >= ROW - 1 || tn >= ROW - 1 {
        return FAR
    }
    var j: u64 = 0
    while j <= tn {
        row_prev[(j) as usize] = j
        row_prev2[(j) as usize] = FAR
        j = j + 1
    }
    var i: u64 = 1
    while i <= qn {
        row_cur[0 as usize] = i
        j = 1
        while j <= tn {
            row_cur[(j) as usize] = cell(i, j, q, t)
            j = j + 1
        }
        shift_rows(tn)
        i = i + 1
    }
    var best: u64 = FAR
    j = 0
    while j <= tn {
        best = min2(best, row_prev[(j) as usize])
        j = j + 1
    }
    return best
}
