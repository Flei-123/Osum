// SPDX-License-Identifier: GPL-2.0-only
export { fold, initials, MAX_FOLD }

const MAX_FOLD: u64 = 64
const UTF8_LATIN1: u64 = 195

fn at(p: u64, i: u64) -> u64 {
    return (*((p + i) as *mut u8)) as u64
}

fn is_ascii_alnum(c: u64) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fn lower(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

fn latin1_base(b: u64) -> u64 {
    var c: u64 = b
    if c >= 128 && c <= 159 {
        c = c + 32
    }
    if c >= 160 && c <= 165 {
        return 97
    }
    if c == 167 {
        return 99
    }
    if c >= 168 && c <= 171 {
        return 101
    }
    if c >= 172 && c <= 175 {
        return 105
    }
    if c == 177 {
        return 110
    }
    if c >= 178 && c <= 182 {
        return 111
    }
    if c >= 185 && c <= 188 {
        return 117
    }
    if c == 189 || c == 191 {
        return 121
    }
    return 0
}

fn emit(dst: u64, starts: u64, n: u64, ch: u64, st: bool, max: u64) -> u64 {
    if n >= max {
        return n
    }
    *((dst + n) as *mut u8) = ch as u8
    var flag: u8 = 0 as u8
    if st {
        flag = 1 as u8
    }
    *((starts + n) as *mut u8) = flag
    return n + 1
}

fn emit_pair(dst: u64, starts: u64, n: u64, first: u64, second: u64, st: bool, max: u64) -> u64 {
    let m: u64 = emit(dst, starts, n, first, st, max)
    return emit(dst, starts, m, second, false, max)
}

fn fold_latin1(b: u64, dst: u64, starts: u64, n: u64, st: bool, max: u64) -> u64 {
    if b == 164 || b == 132 {
        return emit_pair(dst, starts, n, 97, 101, st, max)
    }
    if b == 182 || b == 150 {
        return emit_pair(dst, starts, n, 111, 101, st, max)
    }
    if b == 188 || b == 156 {
        return emit_pair(dst, starts, n, 117, 101, st, max)
    }
    if b == 159 {
        return emit_pair(dst, starts, n, 115, 115, st, max)
    }
    let base: u64 = latin1_base(b)
    if base == 0 {
        return n
    }
    return emit(dst, starts, n, base, st, max)
}

fn fold(src: u64, dst: u64, starts: u64, max: u64) -> u64 {
    var n: u64 = 0
    var st: bool = true
    var i: u64 = 0
    while at(src, i) != 0 && n < max {
        let c: u64 = at(src, i)
        if c < 128 {
            if is_ascii_alnum(c) {
                n = emit(dst, starts, n, lower(c), st, max)
                st = false
            } else {
                st = true
            }
            i = i + 1
        } else if c == UTF8_LATIN1 && at(src, i + 1) != 0 {
            n = fold_latin1(at(src, i + 1), dst, starts, n, st, max)
            st = false
            i = i + 2
        } else {
            n = emit(dst, starts, n, c, st, max)
            st = false
            i = i + 1
        }
    }
    *((dst + n) as *mut u8) = 0 as u8
    return n
}

fn initials(folded: u64, starts: u64, n: u64, out: u64) -> u64 {
    var m: u64 = 0
    var i: u64 = 0
    while i < n {
        if at(starts, i) != 0 {
            *((out + m) as *mut u8) = at(folded, i) as u8
            m = m + 1
        }
        i = i + 1
    }
    *((out + m) as *mut u8) = 0 as u8
    return m
}
