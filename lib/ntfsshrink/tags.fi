import disks.bytes

export { eq, ptr_of, len_of, T_NTFS, T_FVE, T_MAGIC, T_HIBER, T_RJ }

const T_NTFS: u64 = 0
const T_FVE: u64 = 1
const T_MAGIC: u64 = 2
const T_HIBER: u64 = 3
const T_RJ: u64 = 4

static mut TAG_NTFS: [u8; 9] = "NTFS    \0"
static mut TAG_FVE: [u8; 9] = "-FVE-FS-\0"
static mut TAG_MAGIC: [u8; 9] = "OSNTSHR1\0"
static mut TAG_HIBER: [u8; 13] = "hiberfil.sys\0"
static mut TAG_RJ: [u8; 9] = "OSNTRLC1\0"

fn ptr_of(id: u64) -> u64 {
    if id == T_NTFS {
        return (&TAG_NTFS[0 as usize]) as u64
    }
    if id == T_FVE {
        return (&TAG_FVE[0 as usize]) as u64
    }
    if id == T_MAGIC {
        return (&TAG_MAGIC[0 as usize]) as u64
    }
    if id == T_RJ {
        return (&TAG_RJ[0 as usize]) as u64
    }
    return (&TAG_HIBER[0 as usize]) as u64
}

fn len_of(id: u64) -> u64 {
    if id == T_HIBER {
        return 12
    }
    return 8
}

fn eq(p: u64, id: u64) -> bool {
    let q: u64 = ptr_of(id)
    let n: u64 = len_of(id)
    var i: u64 = 0
    while i < n {
        if bytes.ld8(p, i) != bytes.ld8(q, i) {
            return false
        }
        i = i + 1
    }
    return true
}
