import ntfsshrink.codes

export { word }

fn word(code: u64) -> str {
    if code == codes.E_IO {
        return "disk read or write failed"
    }
    if code == codes.E_NOT_NTFS {
        return "not an NTFS volume"
    }
    if code == codes.E_ENCRYPTED {
        return "volume is BitLocker encrypted: decrypt it in Windows first"
    }
    if code == codes.E_UNSUPPORTED {
        return "unsupported NTFS layout (sector or record size)"
    }
    if code == codes.E_CORRUPT {
        return "NTFS metadata is damaged: run chkdsk in Windows first"
    }
    if code == codes.E_DIRTY {
        return "volume is marked dirty: boot Windows and run chkdsk first"
    }
    if code == codes.E_HIBERNATED {
        return "Windows is hibernated or Fast Startup is on: shut down completely or turn Fast Startup off first"
    }
    if code == codes.E_LOG_UNCLEAN {
        return "NTFS journal is not clean: boot Windows, shut down, run chkdsk"
    }
    if code == codes.E_NO_SPACE {
        return "not enough free space at the end of the partition: data lies there"
    }
    if code == codes.E_RANGE {
        return "requested size is invalid: it must be smaller than now"
    }
    if code == codes.E_TABLE {
        return "partition table cannot be updated"
    }
    if code == codes.E_COMPLEX {
        return "NTFS metadata layout is too complex for the safe mode"
    }
    if code == codes.E_BADCLUS {
        return "volume has bad clusters recorded"
    }
    if code == codes.E_DONE {
        return "nothing to do: already this size"
    }
    if code == codes.E_UNMOVABLE {
        return "file or metadata data cannot be moved out of the area to be removed"
    }
    return "ok"
}
