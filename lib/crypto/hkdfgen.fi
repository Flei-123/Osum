import libc.octets
import libc.memcopy

export { hkdf_extract, hkdf_expand, hkdf, HKDF_HASH, INFO_MAX }

const HKDF_HASH: usize = 32
const INFO_MAX: usize = 192

fn hkdf_extract(mac: fn(u64, usize, u64, usize, u64), salt: u64, saltlen: usize, ikm: u64,
    ikmlen: usize, prk: u64) {
    mac(salt, saltlen, ikm, ikmlen, prk)
}

fn hkdf_expand(mac: fn(u64, usize, u64, usize, u64), prk: u64, prklen: usize, info: u64,
    infolen: usize, out: u64, outlen: usize) -> bool {
    if infolen > INFO_MAX || outlen > 255 * HKDF_HASH {
        return false
    }
    var work: [u8; 225] = [0 as u8; 225]
    var t: [u8; 32] = [0 as u8; 32]
    let wp: u64 = (&work[0]) as u64
    let tp: u64 = (&t[0]) as u64
    var done: usize = 0
    var counter: usize = 1
    while done < outlen {
        var at: usize = 0
        if counter > 1 {
            memcopy.copy(wp, tp, HKDF_HASH as u64)
            at = HKDF_HASH
        }
        memcopy.copy(wp + (at as u64), info, infolen as u64)
        at = at + infolen
        octets.store_byte(wp, at, (counter & 255) as u8)
        at = at + 1
        mac(prk, prklen, wp, at, tp)
        var k: usize = 0
        while k < HKDF_HASH && done + k < outlen {
            octets.store_byte(out, done + k, t[k])
            k = k + 1
        }
        done = done + k
        counter = counter + 1
    }
    return true
}

fn hkdf(mac: fn(u64, usize, u64, usize, u64), salt: u64, saltlen: usize, ikm: u64, ikmlen: usize,
    info: u64, infolen: usize, out: u64, outlen: usize) -> bool {
    var prk: [u8; 32] = [0 as u8; 32]
    hkdf_extract(mac, salt, saltlen, ikm, ikmlen, (&prk[0]) as u64)
    return hkdf_expand(mac, (&prk[0]) as u64, HKDF_HASH, info, infolen, out, outlen)
}
