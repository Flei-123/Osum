// lib/crypto/xts.fi -- XTS-AES (IEEE 1619-2007, NIST SP 800-38E),
// Runde KRYPTO.
// ============================================== WIE XTS RECHNET
// Dann, je Sektor:
// ========================================= DER RESTBLOCK (ciphertext stealing)
// ======================================== RUNDE AESNI (K-020): DAS TEMPO

import crypto.aes
import crypto.aesni
import libc.octets

export {
    encrypt, decrypt, sector_encrypt, sector_decrypt,
    forget, use_aesni, aesni_on, fuellungen, table_start, table_length,
    KEY_BYTES, BLOCK
}

const KEY_BYTES: usize = 64
const BLOCK: usize = 16

fn halves_equal(key: u64) -> bool {
    var diff: u64 = 0
    var i: usize = 0
    while i < 32 {
        diff = diff | ((octets.load_byte(key, i) as u64) ^ (octets.load_byte(key, i + 32) as u64))
        i = i + 1
    }
    return diff == 0
}

fn gf_mul_alpha(t: *mut [u8; 16]) {
    var carry: u64 = 0
    var i: usize = 0
    while i < 16 {
        let v: u64 = (*t)[i] as u64
        (*t)[i] = (((v << 1) | carry) & 255) as u8
        carry = (v >> 7) & 1
        i = i + 1
    }
    if carry != 0 {
        (*t)[0] = ((*t)[0] as u64 ^ 0x87) as u8
    }
}

fn block_op(k1: *mut aes.Key, t: *mut [u8; 16], inp: u64, out: u64,
    enc: bool) {
    var x: [u8; 16] = [0 as u8; 16]
    var i: usize = 0
    while i < 16 {
        x[i] = octets.load_byte(inp, i) ^ (*t)[i]
        i = i + 1
    }
    var y: [u8; 16] = [0 as u8; 16]
    if enc {
        aes.encrypt_block(k1, (&x[0]) as u64, (&y[0]) as u64)
    } else {
        aes.decrypt_block(k1, (&x[0]) as u64, (&y[0]) as u64)
    }
    i = 0
    while i < 16 {
        octets.store_byte(out, i, y[i] ^ (*t)[i])
        i = i + 1
    }
}

fn make_tweak(k2: *mut aes.Key, tweak: u64, t: *mut [u8; 16]) {
    aes.encrypt_block(k2, tweak, (t as u64))
}

// ============================ RUNDE KLEINKRAM2 (K-022): DIE SCHLUESSELTAFEL
const SLOTS: usize = 4

struct Slot {
    key: [u8; 64],
    enc: aesni.Enc,
    dec: aesni.Dec,
    tk2: aesni.Enc,
    voll: bool
}

static mut table: [Slot; 4] = [Slot {
    key: [0; 64],
    enc: aesni.Enc { rk: [0; 240], nr: 0, ok: false },
    dec: aesni.Dec { rk: [0; 240], nr: 0, ok: false },
    tk2: aesni.Enc { rk: [0; 240], nr: 0, ok: false },
    voll: false
}; 4]

static mut naechster: usize = 0

static mut treffer: usize = 0

static mut z_fuellungen: u64 = 0

fn fuellungen() -> u64 {
    return z_fuellungen
}

fn table_start() -> u64 {
    return (&table[0]) as u64
}

fn table_length() -> u64 {
    let schritt: u64 = (&table[1]) as u64 - (&table[0]) as u64
    return (SLOTS as u64) * schritt
}

// Alles vergessen -- JEDEN Platz. Ruft `krypto.lock_down`.
fn forget() {
    var s: usize = 0
    while s < SLOTS {
        var i: usize = 0
        while i < 64 {
            table[s].key[i] = 0
            i = i + 1
        }
        i = 0
        while i < 240 {
            table[s].enc.rk[i] = 0
            table[s].dec.rk[i] = 0
            table[s].tk2.rk[i] = 0
            i = i + 1
        }
        table[s].enc.ok = false
        table[s].dec.ok = false
        table[s].tk2.ok = false
        table[s].enc.nr = 0
        table[s].dec.nr = 0
        table[s].tk2.nr = 0
        table[s].voll = false
        s = s + 1
    }
    octets.zero(table_start(), table_length())
    naechster = 0
    treffer = 0
}

fn cache_hit(key: u64) -> bool {
    var gefunden: bool = false
    var wo: usize = 0
    var s: usize = 0
    while s < SLOTS {
        var diff: u64 = 0
        var i: usize = 0
        while i < 64 {
            diff = diff | ((table[s].key[i] as u64) ^ (octets.load_byte(key, i) as u64))
            i = i + 1
        }
        if table[s].voll && diff == 0 && !gefunden {
            gefunden = true
            wo = s
        }
        s = s + 1
    }
    if gefunden {
        treffer = wo
    }
    return gefunden
}

fn cache_fill(key: u64) -> bool {
    var k1: aes.Key = aes.key_new()
    var k2: aes.Key = aes.key_new()
    if !aes.key_set(&k1, key, 32) {
        return false
    }
    if !aes.key_set(&k2, key + 32, 32) {
        return false
    }
    let s: usize = naechster
    table[s].enc = aesni.enc_from((&k1.rk[0]) as u64, k1.nr)
    table[s].dec = aesni.dec_from((&k1.rk[0]) as u64, k1.nr)
    table[s].tk2 = aesni.enc_from((&k2.rk[0]) as u64, k2.nr)
    var i: usize = 0
    while i < 64 {
        table[s].key[i] = octets.load_byte(key, i)
        i = i + 1
    }
    table[s].voll = true
    treffer = s
    naechster = (s + 1) % SLOTS
    z_fuellungen = z_fuellungen + 1
    return true
}

static mut ni_select: u64 = 0

fn use_aesni(on: bool) {
    if on {
        ni_select = 1
    } else {
        ni_select = 2
    }
    forget()
}

fn aesni_on() -> bool {
    if ni_select == 2 {
        return false
    }
    return aesni.usable()
}

// ------------------------------------------------------- die Schnittstelle

fn encrypt(key: u64, tweak: u64, inp: u64, out: u64, n: usize) -> bool {
    if n < BLOCK { return false }
    if halves_equal(key) { return false }
    var k1: aes.Key = aes.key_new()
    var k2: aes.Key = aes.key_new()
    if !aes.key_set(&k1, key, 32) { return false }
    if !aes.key_set(&k2, key + 32, 32) { return false }
    var t: [u8; 16] = [0 as u8; 16]
    make_tweak(&k2, tweak, &t)

    let voll: usize = n / BLOCK
    let rest: usize = n % BLOCK
    var ganz: usize = voll
    if rest != 0 { ganz = voll - 1 }

    var j: usize = 0
    while j < ganz {
        block_op(&k1, &t, inp + (j * BLOCK) as u64,
            out + (j * BLOCK) as u64, true)
        gf_mul_alpha(&t)
        j = j + 1
    }
    if rest == 0 {
        return true
    }
    let pp: u64 = inp + (ganz * BLOCK) as u64
    let po: u64 = out + (ganz * BLOCK) as u64
    var cc: [u8; 16] = [0 as u8; 16]
    block_op(&k1, &t, pp, (&cc[0]) as u64, true)
    gf_mul_alpha(&t)
    var pm: [u8; 16] = [0 as u8; 16]
    var i: usize = 0
    while i < rest {
        pm[i] = octets.load_byte(pp + BLOCK as u64, i)
        i = i + 1
    }
    while i < BLOCK {
        pm[i] = cc[i]
        i = i + 1
    }
    block_op(&k1, &t, (&pm[0]) as u64, po, true)
    i = 0
    while i < rest {
        octets.store_byte(po + BLOCK as u64, i, cc[i])
        i = i + 1
    }
    return true
}

fn decrypt(key: u64, tweak: u64, inp: u64, out: u64, n: usize) -> bool {
    if n < BLOCK { return false }
    if halves_equal(key) { return false }
    var k1: aes.Key = aes.key_new()
    var k2: aes.Key = aes.key_new()
    if !aes.key_set(&k1, key, 32) { return false }
    if !aes.key_set(&k2, key + 32, 32) { return false }
    var t: [u8; 16] = [0 as u8; 16]
    make_tweak(&k2, tweak, &t)

    let voll: usize = n / BLOCK
    let rest: usize = n % BLOCK
    var ganz: usize = voll
    if rest != 0 { ganz = voll - 1 }

    var j: usize = 0
    while j < ganz {
        block_op(&k1, &t, inp + (j * BLOCK) as u64,
            out + (j * BLOCK) as u64, false)
        gf_mul_alpha(&t)
        j = j + 1
    }
    if rest == 0 {
        return true
    }
    var t2: [u8; 16] = [0 as u8; 16]
    var i: usize = 0
    while i < 16 {
        t2[i] = t[i]
        i = i + 1
    }
    gf_mul_alpha(&t2)
    let pi: u64 = inp + (ganz * BLOCK) as u64
    let po: u64 = out + (ganz * BLOCK) as u64
    var pm: [u8; 16] = [0 as u8; 16]
    block_op(&k1, &t2, pi, (&pm[0]) as u64, false)
    var cm: [u8; 16] = [0 as u8; 16]
    i = 0
    while i < rest {
        cm[i] = octets.load_byte(pi + BLOCK as u64, i)
        i = i + 1
    }
    while i < BLOCK {
        cm[i] = pm[i]
        i = i + 1
    }
    i = 0
    while i < rest {
        octets.store_byte(po + BLOCK as u64, i, pm[i])
        i = i + 1
    }
    block_op(&k1, &t, (&cm[0]) as u64, po, false)
    return true
}

fn sector_tweak(sector: u64, t: *mut [u8; 16]) {
    var i: usize = 0
    while i < 8 {
        (*t)[i] = ((sector >> (i as u64 * 8)) & 255) as u8
        i = i + 1
    }
    while i < 16 {
        (*t)[i] = 0
        i = i + 1
    }
}

fn sector_encrypt(key: u64, sector: u64, inp: u64, out: u64,
    n: usize) -> bool {
    var tw: [u8; 16] = [0 as u8; 16]
    sector_tweak(sector, &tw)
    if n % BLOCK == 0 && aesni_on() {
        if halves_equal(key) { return false }
        if !cache_hit(key) {
            if !cache_fill(key) { return false }
        }
        var t: [u8; 16] = [0 as u8; 16]
        if !aesni.encrypt_block(&table[treffer].tk2, (&tw[0]) as u64, (&t[0]) as u64) {
            return false
        }
        return aesni.xts_sector_encrypt(&table[treffer].enc, &t, inp, out, n)
    }
    return encrypt(key, (&tw[0]) as u64, inp, out, n)
}

fn sector_decrypt(key: u64, sector: u64, inp: u64, out: u64,
    n: usize) -> bool {
    var tw: [u8; 16] = [0 as u8; 16]
    sector_tweak(sector, &tw)
    if n % BLOCK == 0 && aesni_on() {
        if halves_equal(key) { return false }
        if !cache_hit(key) {
            if !cache_fill(key) { return false }
        }
        var t: [u8; 16] = [0 as u8; 16]
        if !aesni.encrypt_block(&table[treffer].tk2, (&tw[0]) as u64, (&t[0]) as u64) {
            return false
        }
        return aesni.xts_sector_decrypt(&table[treffer].dec, &t, inp, out, n)
    }
    return decrypt(key, (&tw[0]) as u64, inp, out, n)
}
