import std.rt
import std.md5

export { hmac_md5, HMAC_MD5_SIZE }

const HMAC_MD5_SIZE: usize = 16

fn hmac_md5(key: u64, keylen: usize, msg: u64, msglen: usize, out: u64) {
    var k: [u8; 64] = [0; 64]
    var i: usize = 0
    if keylen > 64 {
        md5.md5(key, keylen, (&k[0]) as u64)
    } else {
        while i < keylen {
            k[i] = rt.ld8(key, i)
            i = i + 1
        }
    }
    var ipad: [u8; 64] = [0; 64]
    var opad: [u8; 64] = [0; 64]
    i = 0
    while i < 64 {
        ipad[i] = k[i] ^ 54 as u8
        opad[i] = k[i] ^ 92 as u8
        i = i + 1
    }
    var inner: [u8; 16] = [0; 16]
    var s: md5.Md5 = md5.md5_new()
    md5.md5_update(&s, (&ipad[0]) as u64, 64)
    md5.md5_update(&s, msg, msglen)
    md5.md5_final(&s, (&inner[0]) as u64)
    var o: md5.Md5 = md5.md5_new()
    md5.md5_update(&o, (&opad[0]) as u64, 64)
    md5.md5_update(&o, (&inner[0]) as u64, 16)
    md5.md5_final(&o, out)
}
