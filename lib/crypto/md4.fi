import std.rt

export { md4, MD4_SIZE }

const MD4_SIZE: usize = 16
const M32: u64 = 4294967295

fn rotl(x: u64, n: u64) -> u64 {
    return ((x << n) | (x >> (32 as u64 - n))) & M32
}

fn round_f(x: u64, y: u64, z: u64) -> u64 {
    return (x & y) | ((x ^ M32) & z)
}

fn round_g(x: u64, y: u64, z: u64) -> u64 {
    return (x & y) | (x & z) | (y & z)
}

fn round_h(x: u64, y: u64, z: u64) -> u64 {
    return x ^ y ^ z
}

fn order_two(i: usize) -> usize {
    return (i % 4) * 4 + i / 4
}

fn order_three(i: usize) -> usize {
    let t: [usize; 16] = [0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15]
    return t[i]
}

fn block(h: *mut [u64; 4], p: u64) {
    var x: [u64; 16] = [0; 16]
    var i: usize = 0
    while i < 16 {
        x[i] = (rt.ld8(p, i * 4) as u64) | ((rt.ld8(p, i * 4 + 1) as u64) << 8)
            | ((rt.ld8(p, i * 4 + 2) as u64) << 16) | ((rt.ld8(p, i * 4 + 3) as u64) << 24)
        i = i + 1
    }
    var a: u64 = (*h)[0]
    var b: u64 = (*h)[1]
    var c: u64 = (*h)[2]
    var d: u64 = (*h)[3]
    let s1: [u64; 4] = [3, 7, 11, 19]
    let s2: [u64; 4] = [3, 5, 9, 13]
    let s3: [u64; 4] = [3, 9, 11, 15]
    i = 0
    while i < 16 {
        let t: u64 = rotl((a + round_f(b, c, d) + x[i]) & M32, s1[i % 4])
        a = d
        d = c
        c = b
        b = t
        i = i + 1
    }
    i = 0
    while i < 16 {
        let t: u64 = rotl((a + round_g(b, c, d) + x[order_two(i)] + 1518500249) & M32, s2[i % 4])
        a = d
        d = c
        c = b
        b = t
        i = i + 1
    }
    i = 0
    while i < 16 {
        let t: u64 = rotl((a + round_h(b, c, d) + x[order_three(i)] + 1859775393) & M32, s3[i % 4])
        a = d
        d = c
        c = b
        b = t
        i = i + 1
    }
    (*h)[0] = ((*h)[0] + a) & M32
    (*h)[1] = ((*h)[1] + b) & M32
    (*h)[2] = ((*h)[2] + c) & M32
    (*h)[3] = ((*h)[3] + d) & M32
}

fn md4(p: u64, n: usize, out: u64) {
    var h: [u64; 4] = [1732584193, 4023233417, 2562383102, 271733878]
    var at: usize = 0
    while n - at >= 64 {
        block(&h, p + at as u64)
        at = at + 64
    }
    var tail: [u8; 128] = [0; 128]
    var rest: usize = n - at
    var i: usize = 0
    while i < rest {
        tail[i] = rt.ld8(p, at + i)
        i = i + 1
    }
    tail[rest] = 128 as u8
    var total: usize = 64
    if rest >= 56 {
        total = 128
    }
    let bits: u64 = n as u64 * 8
    i = 0
    while i < 8 {
        tail[total - 8 + i] = ((bits >> (i as u64 * 8)) & 255 as u64) as u8
        i = i + 1
    }
    block(&h, (&tail[0]) as u64)
    if total == 128 {
        block(&h, (&tail[64]) as u64)
    }
    i = 0
    while i < 4 {
        var j: usize = 0
        while j < 4 {
            rt.st8(out, i * 4 + j, ((h[i] >> (j as u64 * 8)) & 255 as u64) as u8)
            j = j + 1
        }
        i = i + 1
    }
}
