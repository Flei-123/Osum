import crypto.sha256
import crypto.hkdfgen

export { hkdf_extract, hkdf_expand, hkdf, INFO_MAX, HKDF_PRK }

const HKDF_PRK: usize = 32
const INFO_MAX: usize = 192

fn hkdf_extract(salt: u64, slen: usize, ikm: u64, ilen: usize, prk: u64) {
    hkdfgen.hkdf_extract(sha256.hmac, salt, slen, ikm, ilen, prk)
}

fn hkdf_expand(prk: u64, prklen: usize, info: u64, ilen: usize, out: u64, olen: usize) -> bool {
    return hkdfgen.hkdf_expand(sha256.hmac, prk, prklen, info, ilen, out, olen)
}

fn hkdf(salt: u64, slen: usize, ikm: u64, ilen: usize, info: u64, nlen: usize, out: u64,
    olen: usize) -> bool {
    return hkdfgen.hkdf(sha256.hmac, salt, slen, ikm, ilen, info, nlen, out, olen)
}
