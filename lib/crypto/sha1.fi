// lib/crypto/sha1.fi -- SHA-1 (FIPS 180-4) und was WPA2 darauf baut.
// ==================================================================
// EHRLICH
// ==================================================================

export { Sha1, sha1_new, begin, update, finish, hash,
    hmac, hmac3, prf, pbkdf2, DIGEST, BLOCK, OUT_MAX }

const DIGEST: usize = 20
const BLOCK: usize = 64
const OUT_MAX: usize = 128
const M32: u64 = 4294967295

struct Sha1 {
    h: [u64; 5],
    buf: [u8; 64],
    have: usize, // Oktette, die in `buf` liegen
    nlo: u64,    // Oktette insgesamt, untere 64 Bit
    nhi: u64,    // Oktette insgesamt, obere 64 Bit
}

fn ld8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn st8(p: u64, i: usize, v: u8) {
    *((p + i as u64) as *mut u8) = v
}

fn rotl(x: u64, n: u64) -> u64 {
    return (((x << n) & M32) | ((x & M32) >> (32 - n))) & M32
}

fn sha1_new() -> Sha1 {
    return Sha1 { h: [0 as u64; 5], buf: [0 as u8; 64], have: 0,
        nlo: 0, nhi: 0 }
}

// FIPS 180-4 5.3.1.
fn begin(s: *mut Sha1) {
    (*s).h[0] = 0x67452301
    (*s).h[1] = 0xEFCDAB89
    (*s).h[2] = 0x98BADCFE
    (*s).h[3] = 0x10325476
    (*s).h[4] = 0xC3D2E1F0
    (*s).have = 0
    (*s).nlo = 0
    (*s).nhi = 0
}

fn compress(s: *mut Sha1, p: u64) {
    var w: [u64; 80] = [0 as u64; 80]
    var i: usize = 0
    while i < 16 {
        var v: u64 = 0
        var j: usize = 0
        while j < 4 {
            v = ((v << 8) | (ld8(p, i * 4 + j) as u64)) & M32
            j = j + 1
        }
        w[i] = v
        i = i + 1
    }
    i = 16
    while i < 80 {
        w[i] = rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1)
        i = i + 1
    }

    var a: u64 = (*s).h[0]
    var b: u64 = (*s).h[1]
    var c: u64 = (*s).h[2]
    var d: u64 = (*s).h[3]
    var e: u64 = (*s).h[4]

    i = 0
    while i < 80 {
        var f: u64 = 0
        var k: u64 = 0
        if i < 20 {
            f = (b & c) ^ ((~b) & d & M32)
            k = 0x5A827999
        } else {
            if i < 40 {
                f = b ^ c ^ d
                k = 0x6ED9EBA1
            } else {
                if i < 60 {
                    f = (b & c) ^ (b & d) ^ (c & d)
                    k = 0x8F1BBCDC
                } else {
                    f = b ^ c ^ d
                    k = 0xCA62C1D6
                }
            }
        }
        let t: u64 = (rotl(a, 5) +% f +% e +% k +% w[i]) & M32
        e = d
        d = c
        c = rotl(b, 30)
        b = a
        a = t
        i = i + 1
    }

    (*s).h[0] = ((*s).h[0] +% a) & M32
    (*s).h[1] = ((*s).h[1] +% b) & M32
    (*s).h[2] = ((*s).h[2] +% c) & M32
    (*s).h[3] = ((*s).h[3] +% d) & M32
    (*s).h[4] = ((*s).h[4] +% e) & M32
}

fn update(s: *mut Sha1, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        (*s).buf[(*s).have] = ld8(p, i)
        (*s).have = (*s).have + 1
        if (*s).have == BLOCK {
            compress(s, (&(*s).buf[0]) as u64)
            (*s).have = 0
        }
        i = i + 1
    }
    let old: u64 = (*s).nlo
    (*s).nlo = old +% (n as u64)
    if (*s).nlo < old {
        (*s).nhi = (*s).nhi +% 1
    }
}

fn finish(s: *mut Sha1, out: u64) {
    let lo: u64 = ((*s).nlo << 3)
    var pad: [u8; 1] = [128 as u8]
    update(s, (&pad[0]) as u64, 1)
    var zero: [u8; 1] = [0 as u8]
    while (*s).have != 56 {
        update(s, (&zero[0]) as u64, 1)
    }
    var len: [u8; 8] = [0 as u8; 8]
    var i: usize = 0
    while i < 8 {
        len[i] = ((lo >> ((7 - i) as u64 * 8)) & 255) as u8
        i = i + 1
    }
    update(s, (&len[0]) as u64, 8)
    i = 0
    while i < 5 {
        var j: usize = 0
        while j < 4 {
            st8(out, i * 4 + j, (((*s).h[i] >> ((3 - j) as u64 * 8))
                & 255) as u8)
            j = j + 1
        }
        i = i + 1
    }
}

fn hash(p: u64, n: usize, out: u64) {
    var s: Sha1 = sha1_new()
    begin(&s)
    update(&s, p, n)
    finish(&s, out)
}

// ---------------------------------------------------------------- HMAC
fn hmac3(key: u64, klen: usize, p1: u64, n1: usize, p2: u64, n2: usize,
    p3: u64, n3: usize, out: u64) {
    var k: [u8; 64] = [0 as u8; 64]
    if klen > BLOCK {
        var t: [u8; 20] = [0 as u8; 20]
        hash(key, klen, (&t[0]) as u64)
        var i: usize = 0
        while i < DIGEST {
            k[i] = t[i]
            i = i + 1
        }
    } else {
        var i: usize = 0
        while i < klen {
            k[i] = ld8(key, i)
            i = i + 1
        }
    }
    var ipad: [u8; 64] = [0 as u8; 64]
    var opad: [u8; 64] = [0 as u8; 64]
    var i: usize = 0
    while i < BLOCK {
        ipad[i] = (k[i] ^ (54 as u8))
        opad[i] = (k[i] ^ (92 as u8))
        i = i + 1
    }
    var inner: [u8; 20] = [0 as u8; 20]
    var s: Sha1 = sha1_new()
    begin(&s)
    update(&s, (&ipad[0]) as u64, BLOCK)
    update(&s, p1, n1)
    update(&s, p2, n2)
    update(&s, p3, n3)
    finish(&s, (&inner[0]) as u64)
    begin(&s)
    update(&s, (&opad[0]) as u64, BLOCK)
    update(&s, (&inner[0]) as u64, DIGEST)
    finish(&s, out)
}

fn hmac(key: u64, klen: usize, msg: u64, mlen: usize, out: u64) {
    hmac3(key, klen, msg, mlen, 0, 0, 0, 0, out)
}

// ------------------------------------------------- PRF, IEEE 802.11i
fn prf(key: u64, klen: usize, label: u64, llen: usize,
    data: u64, dlen: usize, out: u64, outlen: usize) -> bool {
    if outlen > OUT_MAX {
        return false
    }
    if llen > 64 {
        return false
    }
    var lb: [u8; 65] = [0 as u8; 65]
    var i: usize = 0
    while i < llen {
        lb[i] = ld8(label, i)
        i = i + 1
    }
    lb[llen] = 0 as u8

    var ctr: [u8; 1] = [0 as u8]
    var blk: [u8; 20] = [0 as u8; 20]
    var pos: usize = 0
    var c: usize = 0
    while pos < outlen {
        ctr[0] = c as u8
        hmac3(key, klen, (&lb[0]) as u64, llen + 1, data, dlen,
            (&ctr[0]) as u64, 1, (&blk[0]) as u64)
        var j: usize = 0
        while j < DIGEST && pos + j < outlen {
            st8(out, pos + j, blk[j])
            j = j + 1
        }
        pos = pos + DIGEST
        c = c + 1
    }
    return true
}

// ------------------------------------------------- PBKDF2, RFC 2898
fn pbkdf2(pw: u64, pwlen: usize, salt: u64, saltlen: usize,
    iters: usize, out: u64, outlen: usize) -> bool {
    if outlen > OUT_MAX || iters == 0 {
        return false
    }
    var idx: [u8; 4] = [0 as u8; 4]
    var u: [u8; 20] = [0 as u8; 20]
    var acc: [u8; 20] = [0 as u8; 20]
    var pos: usize = 0
    var blocknr: u64 = 1
    while pos < outlen {
        idx[0] = ((blocknr >> 24) & 255) as u8
        idx[1] = ((blocknr >> 16) & 255) as u8
        idx[2] = ((blocknr >> 8) & 255) as u8
        idx[3] = (blocknr & 255) as u8
        hmac3(pw, pwlen, salt, saltlen, (&idx[0]) as u64, 4, 0, 0,
            (&u[0]) as u64)
        var j: usize = 0
        while j < DIGEST {
            acc[j] = u[j]
            j = j + 1
        }
        var it: usize = 1
        while it < iters {
            hmac3(pw, pwlen, (&u[0]) as u64, DIGEST, 0, 0, 0, 0,
                (&u[0]) as u64)
            j = 0
            while j < DIGEST {
                acc[j] = acc[j] ^ u[j]
                j = j + 1
            }
            it = it + 1
        }
        j = 0
        while j < DIGEST && pos + j < outlen {
            st8(out, pos + j, acc[j])
            j = j + 1
        }
        pos = pos + DIGEST
        blocknr = blocknr + 1
    }
    return true
}
