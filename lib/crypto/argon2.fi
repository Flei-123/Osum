// lib/crypto/argon2.fi -- Argon2id nach RFC 9106, Runde KRYPTO.
// ====================================================== DIE RECHNUNG

import crypto.blake2b
import libc.octets

export { argon2id, argon2_any, argon2_ext, ARGON2_BLOCK, TYPE_ID, TYPE_I, TYPE_D,
    fill_segment, SYNC_POINTS, passes,
    prepare, prepare_ext, finish, geometrie_seglen, geometrie_ok }

const ARGON2_BLOCK: usize = 1024
const QWORDS: usize = 128 // 1024 / 8
const SYNC_POINTS: u64 = 4
const VERSION: u64 = 0x13

const TYPE_D: u64 = 0
const TYPE_I: u64 = 1
const TYPE_ID: u64 = 2

fn qget(blk: u64, i: u64) -> u64 {
    return *((blk + i * 8) as *mut u64)
}

fn qput(blk: u64, i: u64, v: u64) {
    *((blk + i * 8) as *mut u64) = v
}

fn put_le32(p: u64, off: u64, v: u64) {
    octets.st8(p, off, v & 255)
    octets.st8(p, off + 1, (v >> 8) & 255)
    octets.st8(p, off + 2, (v >> 16) & 255)
    octets.st8(p, off + 3, (v >> 24) & 255)
}

fn rotr64(x: u64, n: u64) -> u64 {
    if n == 0 { return x }
    return (x >> n) | (x << (64 - n))
}

//   a = a + b + 2 * (a_lo * b_lo)
fn gb(v: *mut [u64; 16], a: usize, b: usize, c: usize, d: usize) {
    let m1: u64 = ((*v)[a] & 0xFFFFFFFF) *% ((*v)[b] & 0xFFFFFFFF)
    (*v)[a] = (*v)[a] +% (*v)[b] +% (m1 +% m1)
    (*v)[d] = rotr64((*v)[d] ^ (*v)[a], 32)
    let m2: u64 = ((*v)[c] & 0xFFFFFFFF) *% ((*v)[d] & 0xFFFFFFFF)
    (*v)[c] = (*v)[c] +% (*v)[d] +% (m2 +% m2)
    (*v)[b] = rotr64((*v)[b] ^ (*v)[c], 24)
    let m3: u64 = ((*v)[a] & 0xFFFFFFFF) *% ((*v)[b] & 0xFFFFFFFF)
    (*v)[a] = (*v)[a] +% (*v)[b] +% (m3 +% m3)
    (*v)[d] = rotr64((*v)[d] ^ (*v)[a], 16)
    let m4: u64 = ((*v)[c] & 0xFFFFFFFF) *% ((*v)[d] & 0xFFFFFFFF)
    (*v)[c] = (*v)[c] +% (*v)[d] +% (m4 +% m4)
    (*v)[b] = rotr64((*v)[b] ^ (*v)[c], 63)
}

fn perm(v: *mut [u64; 16]) {
    gb(v, 0, 4, 8, 12)
    gb(v, 1, 5, 9, 13)
    gb(v, 2, 6, 10, 14)
    gb(v, 3, 7, 11, 15)
    gb(v, 0, 5, 10, 15)
    gb(v, 1, 6, 11, 12)
    gb(v, 2, 7, 8, 13)
    gb(v, 3, 4, 9, 14)
}

// Die Kompression G(X, Y), RFC 9106 3.4.
fn compress_g(dst: u64, x: u64, y: u64, xor_in: bool) {
    var r: [u64; 128] = [0; 128]
    var i: usize = 0
    while i < QWORDS {
        r[i] = qget(x, i as u64) ^ qget(y, i as u64)
        i = i + 1
    }
    var z: [u64; 128] = [0; 128]
    i = 0
    while i < QWORDS {
        z[i] = r[i]
        i = i + 1
    }
    // Zeilen: Wort z[16*row + k].
    var row: usize = 0
    while row < 8 {
        var v: [u64; 16] = [0; 16]
        var k: usize = 0
        while k < 16 {
            v[k] = z[row * 16 + k]
            k = k + 1
        }
        perm(&v)
        k = 0
        while k < 16 {
            z[row * 16 + k] = v[k]
            k = k + 1
        }
        row = row + 1
    }
    var col: usize = 0
    while col < 8 {
        var v: [u64; 16] = [0; 16]
        var k: usize = 0
        while k < 8 {
            v[k * 2] = z[k * 16 + col * 2]
            v[k * 2 + 1] = z[k * 16 + col * 2 + 1]
            k = k + 1
        }
        perm(&v)
        k = 0
        while k < 8 {
            z[k * 16 + col * 2] = v[k * 2]
            z[k * 16 + col * 2 + 1] = v[k * 2 + 1]
            k = k + 1
        }
        col = col + 1
    }
    i = 0
    while i < QWORDS {
        let out: u64 = z[i] ^ r[i]
        if xor_in {
            qput(dst, i as u64, qget(dst, i as u64) ^ out)
        } else {
            qput(dst, i as u64, out)
        }
        i = i + 1
    }
}

fn h_prime(inp: u64, ilen: usize, out: u64, olen: usize) -> bool {
    var pre: [u8; 4] = [0 as u8; 4]
    put_le32((&pre[0]) as u64, 0, olen as u64)
    if olen <= 64 {
        var s: blake2b.Blake2b = blake2b.blake2b_new_keyed(0, 0, olen)
        blake2b.blake2b_update(&s, (&pre[0]) as u64, 4)
        blake2b.blake2b_update(&s, inp, ilen)
        return blake2b.blake2b_final(&s, out)
    }
    var buf: [u8; 64] = [0 as u8; 64]
    var s: blake2b.Blake2b = blake2b.blake2b_new_keyed(0, 0, 64)
    blake2b.blake2b_update(&s, (&pre[0]) as u64, 4)
    blake2b.blake2b_update(&s, inp, ilen)
    if !blake2b.blake2b_final(&s, (&buf[0]) as u64) { return false }
    var pos: usize = 0
    var i: usize = 0
    while i < 32 {
        octets.st8(out, pos as u64, buf[i] as u64)
        pos = pos + 1
        i = i + 1
    }
    var rest: usize = olen - 32
    while rest > 64 {
        var s2: blake2b.Blake2b = blake2b.blake2b_new_keyed(0, 0, 64)
        blake2b.blake2b_update(&s2, (&buf[0]) as u64, 64)
        if !blake2b.blake2b_final(&s2, (&buf[0]) as u64) { return false }
        i = 0
        while i < 32 {
            octets.st8(out, pos as u64, buf[i] as u64)
            pos = pos + 1
            i = i + 1
        }
        rest = rest - 32
    }
    var s3: blake2b.Blake2b = blake2b.blake2b_new_keyed(0, 0, rest)
    blake2b.blake2b_update(&s3, (&buf[0]) as u64, 64)
    var last: [u8; 64] = [0 as u8; 64]
    if !blake2b.blake2b_final(&s3, (&last[0]) as u64) { return false }
    i = 0
    while i < rest {
        octets.st8(out, pos as u64, last[i] as u64)
        pos = pos + 1
        i = i + 1
    }
    return true
}

fn index_alpha(j1: u64, lane_len: u64, seg_len: u64, pass: u64,
    slice: u64, index: u64, same_lane: bool) -> u64 {
    var area: u64 = 0
    if pass == 0 {
        if slice == 0 {
            area = index - 1
        } else {
            if same_lane {
                area = slice * seg_len + index - 1
            } else {
                area = slice * seg_len
                if index == 0 {
                    area = area - 1
                }
            }
        }
    } else {
        if same_lane {
            area = lane_len - seg_len + index - 1
        } else {
            area = lane_len - seg_len
            if index == 0 {
                area = area - 1
            }
        }
    }
    let x: u64 = (j1 *% j1) >> 32
    let y: u64 = (area *% x) >> 32
    let zz: u64 = area - 1 - y
    var start: u64 = 0
    if pass != 0 && slice != SYNC_POINTS - 1 {
        start = (slice + 1) * seg_len
    }
    return (start + zz) % lane_len
}

fn geometrie_seglen(m_cost: u64, lanes: u64) -> u64 {
    return m_cost / (SYNC_POINTS * lanes)
}

fn geometrie_ok(t_cost: u64, m_cost: u64, lanes: u64, saltlen: usize,
    outlen: usize) -> bool {
    if t_cost < 1 || lanes < 1 { return false }
    if saltlen < 8 { return false }
    if outlen < 4 { return false }
    if m_cost < 8 * lanes { return false }
    if geometrie_seglen(m_cost, lanes) < 2 { return false }
    return true
}

// ============================================ DIE DURCHGAENGE, SERIELL
fn passes(mem: u64, t_cost: u64, lanes: u64, lane_len: u64,
    seg_len: u64, blocks: u64, atype: u64) -> bool {
    var zb: [u8; 1024] = [0 as u8; 1024]
    var ib: [u8; 1024] = [0 as u8; 1024]
    let zp: u64 = (&zb[0]) as u64
    let ip: u64 = (&ib[0]) as u64

    var pass: u64 = 0
    while pass < t_cost {
        var slice: u64 = 0
        while slice < SYNC_POINTS {
            var lane: u64 = 0
            while lane < lanes {
                fill_segment(mem, pass, slice, lane, lanes,
                    lane_len, seg_len, blocks, t_cost, atype, zp, ip)
                lane = lane + 1
            }
            slice = slice + 1
        }
        pass = pass + 1
    }

    return true
}

// ================================================== EIN SEGMENT
fn fill_segment(mem: u64, pass: u64, slice: u64, lane: u64,
    lanes: u64, lane_len: u64, seg_len: u64, blocks: u64,
    t_cost: u64, atype: u64, zp: u64, ip: u64) {
    var data_indep: bool = false
    if atype == TYPE_I { data_indep = true }
    if atype == TYPE_ID && pass == 0 && slice < 2 {
        data_indep = true
    }
    var start: u64 = 0
    if pass == 0 && slice == 0 { start = 2 }
    var index: u64 = start
    while index < seg_len {
        let cur: u64 = lane * lane_len + slice * seg_len + index
        var prev: u64 = 0
        if index == 0 && slice == 0 {
            prev = lane * lane_len + lane_len - 1
        } else {
            prev = cur - 1
        }
        var j1: u64 = 0
        var j2: u64 = 0
        if data_indep {
            // DER ADRESSBLOCK, RFC 9106 3.4.1.1.
            if index == start || index % 128 == 0 {
                var k: usize = 0
                while k < QWORDS {
                    qput(ip, k as u64, 0)
                    k = k + 1
                }
                qput(ip, 0, pass)
                qput(ip, 1, lane)
                qput(ip, 2, slice)
                qput(ip, 3, blocks)
                qput(ip, 4, t_cost)
                qput(ip, 5, atype)
                qput(ip, 6, index / 128 + 1)
                var zero: [u8; 1024] = [0 as u8; 1024]
                compress_g(zp, (&zero[0]) as u64, ip, false)
                var tmp: [u8; 1024] = [0 as u8; 1024]
                var q: usize = 0
                while q < QWORDS {
                    qput((&tmp[0]) as u64, q as u64,
                        qget(zp, q as u64))
                    q = q + 1
                }
                compress_g(zp, (&zero[0]) as u64,
                    (&tmp[0]) as u64, false)
            }
            let w: u64 = qget(zp, (index % 128) as u64)
            j1 = w & 0xFFFFFFFF
            j2 = (w >> 32) & 0xFFFFFFFF
        } else {
            let w: u64 = qget(
                mem + prev * (ARGON2_BLOCK as u64), 0)
            j1 = w & 0xFFFFFFFF
            j2 = (w >> 32) & 0xFFFFFFFF
        }
        var ref_lane: u64 = j2 % lanes
        if pass == 0 && slice == 0 { ref_lane = lane }
        let same: bool = ref_lane == lane
        let ref_index: u64 = index_alpha(j1, lane_len,
            seg_len, pass, slice, index, same)
        let ridx: u64 = ref_lane * lane_len + ref_index
        let refb: u64 = mem + ridx * (ARGON2_BLOCK as u64)
        let curb: u64 = mem + cur * (ARGON2_BLOCK as u64)
        let prevb: u64 = mem + prev * (ARGON2_BLOCK as u64)
        compress_g(curb, prevb, refb, pass != 0)
        index = index + 1
    }
}

// ================================================== Argon2id
fn argon2id(pwd: u64, pwdlen: usize, salt: u64, saltlen: usize,
    t_cost: u64, m_cost: u64, lanes: u64,
    mem: u64, out: u64, outlen: usize) -> bool {
    return argon2_any(pwd, pwdlen, salt, saltlen, t_cost, m_cost,
        lanes, mem, out, outlen, TYPE_ID)
}

fn prepare(pwd: u64, pwdlen: usize, salt: u64, saltlen: usize,
    t_cost: u64, m_cost: u64, lanes: u64,
    mem: u64, outlen: usize, atype: u64) -> bool {
    return prepare_ext(pwd, pwdlen, salt, saltlen, 0, 0, 0, 0,
        t_cost, m_cost, lanes, mem, outlen, atype)
}

fn prepare_ext(pwd: u64, pwdlen: usize, salt: u64, saltlen: usize,
    secret: u64, secretlen: usize, ad: u64, adlen: usize,
    t_cost: u64, m_cost: u64, lanes: u64,
    mem: u64, outlen: usize, atype: u64) -> bool {
    if t_cost < 1 || lanes < 1 { return false }
    if saltlen < 8 { return false }
    if outlen < 4 { return false }
    if m_cost < 8 * lanes { return false }

    let seg_len: u64 = m_cost / (SYNC_POINTS * lanes)
    if seg_len < 2 { return false }
    let lane_len: u64 = seg_len * SYNC_POINTS
    let blocks: u64 = lane_len * lanes

    // ---------------------------------------------- H0, RFC 9106 3.2
    var h0: [u8; 72] = [0 as u8; 72]
    var num: [u8; 4] = [0 as u8; 4]
    var s: blake2b.Blake2b = blake2b.blake2b_new_keyed(0, 0, 64)
    let np: u64 = (&num[0]) as u64
    put_le32(np, 0, lanes)
    blake2b.blake2b_update(&s, np, 4)
    put_le32(np, 0, outlen as u64)
    blake2b.blake2b_update(&s, np, 4)
    put_le32(np, 0, m_cost)
    blake2b.blake2b_update(&s, np, 4)
    put_le32(np, 0, t_cost)
    blake2b.blake2b_update(&s, np, 4)
    put_le32(np, 0, VERSION)
    blake2b.blake2b_update(&s, np, 4)
    put_le32(np, 0, atype)
    blake2b.blake2b_update(&s, np, 4)
    put_le32(np, 0, pwdlen as u64)
    blake2b.blake2b_update(&s, np, 4)
    if pwdlen > 0 { blake2b.blake2b_update(&s, pwd, pwdlen) }
    put_le32(np, 0, saltlen as u64)
    blake2b.blake2b_update(&s, np, 4)
    blake2b.blake2b_update(&s, salt, saltlen)
    put_le32(np, 0, secretlen as u64)
    blake2b.blake2b_update(&s, np, 4)
    if secretlen > 0 { blake2b.blake2b_update(&s, secret, secretlen) }
    put_le32(np, 0, adlen as u64)
    blake2b.blake2b_update(&s, np, 4)
    if adlen > 0 { blake2b.blake2b_update(&s, ad, adlen) }
    if !blake2b.blake2b_final(&s, (&h0[0]) as u64) { return false }

    var l: u64 = 0
    while l < lanes {
        // H'(H0 || 0 || lane) und H'(H0 || 1 || lane), je 1024 Oktette.
        put_le32((&h0[0]) as u64, 64, 0)
        put_le32((&h0[0]) as u64, 68, l)
        if !h_prime((&h0[0]) as u64, 72,
            mem + (l * lane_len) * (ARGON2_BLOCK as u64),
            ARGON2_BLOCK) {
            return false
        }
        put_le32((&h0[0]) as u64, 64, 1)
        if !h_prime((&h0[0]) as u64, 72,
            mem + (l * lane_len + 1) * (ARGON2_BLOCK as u64),
            ARGON2_BLOCK) {
            return false
        }
        l = l + 1
    }

    return true
}

fn finish(mem: u64, lanes: u64, lane_len: u64, out: u64,
    outlen: usize) -> bool {
    var fin: [u8; 1024] = [0 as u8; 1024]
    let fp: u64 = (&fin[0]) as u64
    var k: usize = 0
    while k < QWORDS {
        qput(fp, k as u64, qget(mem + (lane_len - 1) * (ARGON2_BLOCK as u64),
            k as u64))
        k = k + 1
    }
    var l2: u64 = 1
    while l2 < lanes {
        let lidx: u64 = l2 * lane_len + lane_len - 1
        let lb: u64 = mem + lidx * (ARGON2_BLOCK as u64)
        k = 0
        while k < QWORDS {
            qput(fp, k as u64, qget(fp, k as u64) ^ qget(lb, k as u64))
            k = k + 1
        }
        l2 = l2 + 1
    }
    return h_prime(fp, ARGON2_BLOCK, out, outlen)
}

fn argon2_any(pwd: u64, pwdlen: usize, salt: u64, saltlen: usize,
    t_cost: u64, m_cost: u64, lanes: u64,
    mem: u64, out: u64, outlen: usize, atype: u64) -> bool {
    return argon2_ext(pwd, pwdlen, salt, saltlen, 0, 0, 0, 0,
        t_cost, m_cost, lanes, mem, out, outlen, atype)
}

fn argon2_ext(pwd: u64, pwdlen: usize, salt: u64, saltlen: usize,
    secret: u64, secretlen: usize, ad: u64, adlen: usize,
    t_cost: u64, m_cost: u64, lanes: u64,
    mem: u64, out: u64, outlen: usize, atype: u64) -> bool {
    if !geometrie_ok(t_cost, m_cost, lanes, saltlen, outlen) {
        return false
    }
    let seg_len: u64 = geometrie_seglen(m_cost, lanes)
    let lane_len: u64 = seg_len * SYNC_POINTS
    let blocks: u64 = lane_len * lanes
    if !prepare_ext(pwd, pwdlen, salt, saltlen, secret, secretlen, ad, adlen,
        t_cost, m_cost, lanes, mem, outlen, atype) {
        return false
    }
    if !passes(mem, t_cost, lanes, lane_len, seg_len, blocks, atype) {
        return false
    }
    return finish(mem, lanes, lane_len, out, outlen)
}
