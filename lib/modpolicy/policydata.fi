profile kernel

export { KEYS_N, FLOOR_N, key_char, floor_char }

const KEYS_N: u64 = 2
const FLOOR_N: u64 = 0

static mut KEYS_HEX: [u8; 129] = "51dae5642cba5d80151eed35dc3f69546426860eac91f770326f57e54a22b88e1aa2255163bd8859d8bb2ebe911525094b881debfc9d6db9a4438eefb9e79d8d\0"
static mut FLOOR_HEX: [u8; 1] = "\0"

fn key_char(i: u64) -> u64 {
    return KEYS_HEX[i as usize] as u64
}

fn floor_char(i: u64) -> u64 {
    return FLOOR_HEX[i as usize] as u64
}
