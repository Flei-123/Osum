profile kernel

import modpolicy.policydata

export { key_total, key_byte, floor_total, floor_byte }

fn nibble(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    return 0
}

fn key_total() -> u64 {
    return policydata.KEYS_N
}

fn floor_total() -> u64 {
    return policydata.FLOOR_N
}

fn key_byte(k: u64, j: u64) -> u64 {
    let p: u64 = (k * 32 + j) * 2
    return nibble(policydata.key_char(p)) * 16 + nibble(policydata.key_char(p + 1))
}

fn floor_byte(e: u64, j: u64) -> u64 {
    let p: u64 = (e * 64 + j) * 2
    return nibble(policydata.floor_char(p)) * 16 + nibble(policydata.floor_char(p + 1))
}
