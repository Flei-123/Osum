import std.rt

export { apply }

const FILTER_NONE: u32 = 0
const FILTER_SUB: u32 = 1
const FILTER_UP: u32 = 2
const FILTER_AVERAGE: u32 = 3
const FILTER_PAETH: u32 = 4
const FILTER_COUNT: u32 = 5

fn iabs(v: i32) -> i32 {
    if v < 0 {
        return 0 - v
    }
    return v
}

fn paeth(a: u32, b: u32, c: u32) -> u32 {
    let p: i32 = (a as i32) + (b as i32) - (c as i32)
    let pa: i32 = iabs(p - (a as i32))
    let pb: i32 = iabs(p - (b as i32))
    let pc: i32 = iabs(p - (c as i32))
    if pa <= pb && pa <= pc {
        return a
    }
    if pb <= pc {
        return b
    }
    return c
}

fn predict(kind: u32, a: u32, b: u32, c: u32) -> u32 {
    if kind == FILTER_SUB {
        return a
    }
    if kind == FILTER_UP {
        return b
    }
    if kind == FILTER_AVERAGE {
        return (a + b) / 2
    }
    if kind == FILTER_PAETH {
        return paeth(a, b, c)
    }
    return 0
}

fn magnitude(v: u32) -> u32 {
    if v < 128 {
        return v
    }
    return 256 - v
}

fn load_left(p: u64, row: usize, i: usize) -> u32 {
    if i < 3 {
        return 0
    }
    return rt.ld8(p, row + 1 + i - 3) as u32
}

fn row_cost(p: u64, row: usize, above: usize, has_above: bool, bytes: usize, kind: u32) -> u32 {
    var cost: u32 = 0
    var i: usize = 0
    while i < bytes {
        let x: u32 = rt.ld8(p, row + 1 + i) as u32
        let a: u32 = load_left(p, row, i)
        var b: u32 = 0
        var c: u32 = 0
        if has_above {
            b = rt.ld8(p, above + 1 + i) as u32
            c = load_left(p, above, i)
        }
        cost = cost + magnitude((x + 256 - predict(kind, a, b, c)) & 255)
        i = i + 1
    }
    return cost
}

fn write_row(src: u64, dst: u64, row: usize, above: usize, has_above: bool, bytes: usize, kind: u32) {
    rt.st8(dst, row, kind as u8)
    var i: usize = 0
    while i < bytes {
        let x: u32 = rt.ld8(src, row + 1 + i) as u32
        let a: u32 = load_left(src, row, i)
        var b: u32 = 0
        var c: u32 = 0
        if has_above {
            b = rt.ld8(src, above + 1 + i) as u32
            c = load_left(src, above, i)
        }
        rt.st8(dst, row + 1 + i, ((x + 256 - predict(kind, a, b, c)) & 255) as u8)
        i = i + 1
    }
}

fn apply(out: *mut rt.Buf, raw: *mut rt.Buf, width: usize, height: usize) -> bool {
    let bytes: usize = width * 3
    let stride: usize = bytes + 1
    if !rt.buf_reserve(out, stride * height) {
        return false
    }
    rt.buf_set_len(out, stride * height)
    let src: u64 = (*raw).ptr as u64
    let dst: u64 = (*out).ptr as u64
    var y: usize = 0
    while y < height {
        let row: usize = y * stride
        var above: usize = 0
        if y > 0 {
            above = row - stride
        }
        let has_above: bool = y > 0
        var best: u32 = FILTER_NONE
        var best_cost: u32 = row_cost(src, row, above, has_above, bytes, FILTER_NONE)
        var kind: u32 = 1
        while kind < FILTER_COUNT {
            let cost: u32 = row_cost(src, row, above, has_above, bytes, kind)
            if cost < best_cost {
                best_cost = cost
                best = kind
            }
            kind = kind + 1
        }
        write_row(src, dst, row, above, has_above, bytes, best)
        y = y + 1
    }
    return true
}
