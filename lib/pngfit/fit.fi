import std.rt
import pngfit.png
import pngfit.scale

export { encode_within }

const MIN_SIDE: usize = 64

fn encode_within(out: *mut rt.Buf, width: usize, height: usize,
    raw: *mut rt.Buf, cap: usize) -> bool {
    var w: usize = width
    var h: usize = height
    while true {
        if !png.encode(out, w, h, raw) {
            return false
        }
        if (*out).len <= cap {
            return true
        }
        if w <= MIN_SIDE || h <= MIN_SIDE {
            return false
        }
        scale.halve(raw, w, h)
        w = scale.half_of(w)
        h = scale.half_of(h)
    }
    return false
}
