import std.rt
import pngfit.png
import pngfit.scale
import pngfit.quant

export { encode_within }

const MIN_SIDE: usize = 64
const STAGE_LOSSLESS: u32 = 0
const STAGE_QUANT2: u32 = 1
const STAGE_QUANT3: u32 = 2

fn encode_within(out: *mut rt.Buf, width: usize, height: usize,
    raw: *mut rt.Buf, cap: usize) -> bool {
    var w: usize = width
    var h: usize = height
    var stage: u32 = STAGE_LOSSLESS
    while true {
        if !png.encode(out, w, h, raw) {
            return false
        }
        if (*out).len <= cap {
            return true
        }
        if stage == STAGE_LOSSLESS {
            quant.drop_low_bits(raw, w, h, 2)
            stage = STAGE_QUANT2
        } else if stage == STAGE_QUANT2 {
            quant.drop_low_bits(raw, w, h, 3)
            stage = STAGE_QUANT3
        } else {
            if w <= MIN_SIDE || h <= MIN_SIDE {
                return false
            }
            scale.halve(raw, w, h)
            w = scale.half_of(w)
            h = scale.half_of(h)
        }
    }
    return false
}
