import std.rt

export { drop_low_bits }

fn drop_low_bits(raw: *mut rt.Buf, width: usize, height: usize, bits: u32) {
    let p: u64 = (*raw).ptr as u64
    let stride: usize = 1 + width * 3
    let keep: u32 = (255 >> bits) ^ 255
    var y: usize = 0
    while y < height {
        var i: usize = 0
        while i < width * 3 {
            let v: u32 = rt.ld8(p, y * stride + 1 + i) as u32
            rt.st8(p, y * stride + 1 + i, ((v & keep) | (v >> (8 - bits))) as u8)
            i = i + 1
        }
        y = y + 1
    }
}
