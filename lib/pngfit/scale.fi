import std.rt

export { halve, half_of }

fn half_of(n: usize) -> usize {
    return (n + 1) / 2
}

fn sample(p: u64, row_off: usize, x: usize, c: usize) -> u32 {
    return rt.ld8(p, row_off + 1 + x * 3 + c) as u32
}

fn halve(raw: *mut rt.Buf, width: usize, height: usize) {
    let p: u64 = (*raw).ptr as u64
    let new_w: usize = half_of(width)
    let new_h: usize = half_of(height)
    let src_stride: usize = 1 + width * 3
    let dst_stride: usize = 1 + new_w * 3
    var dy: usize = 0
    while dy < new_h {
        let r0: usize = dy * 2
        var r1: usize = r0 + 1
        if r1 >= height {
            r1 = r0
        }
        let dst: usize = dy * dst_stride
        rt.st8(p, dst, 0 as u8)
        var dx: usize = 0
        while dx < new_w {
            let x0: usize = dx * 2
            var x1: usize = x0 + 1
            if x1 >= width {
                x1 = x0
            }
            var c: usize = 0
            while c < 3 {
                let sum: u32 = sample(p, r0 * src_stride, x0, c)
                    + sample(p, r0 * src_stride, x1, c)
                    + sample(p, r1 * src_stride, x0, c)
                    + sample(p, r1 * src_stride, x1, c)
                rt.st8(p, dst + 1 + dx * 3 + c, ((sum + 2) / 4) as u8)
                c = c + 1
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
    rt.buf_set_len(raw, new_h * dst_stride)
}
