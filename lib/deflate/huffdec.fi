// SPDX-License-Identifier: MIT
profile kernel

import libc.kcall
import libc.errno

export {
    EOF, E_OK, E_INPUT, E_ROOM, E_FORMAT, E_IO,
    begin_mem, begin_fd, getbyte, bits, align, avail, fail, failed, ok, status,
    symbol, length_of, dist, fixed_trees, dynamic_trees,
    setup, len_base, len_extra, dist_base, dist_extra
}

const EOF: u64 = 0xFFFFFFFFFFFFFFFF
const E_OK: u64 = 0
const E_INPUT: u64 = 1
const E_ROOM: u64 = 2
const E_FORMAT: u64 = 3
const E_IO: u64 = 5

const IBUF: u64 = 4096
const MODE_MEM: u64 = 0
const MODE_FD: u64 = 1

static mut lbase: [u64; 30] = [0 as u64; 30]
static mut lext: [u64; 30] = [0 as u64; 30]
static mut dbase: [u64; 30] = [0 as u64; 30]
static mut dext: [u64; 30] = [0 as u64; 30]
static mut clorder: [u64; 19] = [0 as u64; 19]
static mut ready: u64 = 0

static mut lcnt: [u64; 16] = [0 as u64; 16]
static mut lsym: [u64; 288] = [0 as u64; 288]
static mut dcnt: [u64; 16] = [0 as u64; 16]
static mut dsym: [u64; 32] = [0 as u64; 32]
static mut lengths: [u64; 320] = [0 as u64; 320]

static mut ibuf: [u8; 4096] = [0 as u8; 4096]
static mut mode: u64 = 0
static mut src: u64 = 0
static mut spos: u64 = 0
static mut send: u64 = 0
static mut in_fd: u64 = 0
static mut ipos: u64 = 0
static mut ilen: u64 = 0
static mut bp: u64 = 0
static mut bn: u64 = 0
static mut oops: u64 = 0

fn begin_mem(p: u64, n: u64) {
    setup()
    mode = MODE_MEM
    src = p
    spos = 0
    send = n
    bp = 0
    bn = 0
    oops = E_OK
}

fn begin_fd(fd: u64) {
    setup()
    mode = MODE_FD
    in_fd = fd
    ipos = 0
    ilen = 0
    bp = 0
    bn = 0
    oops = E_OK
}

fn align() {
    bp = 0
    bn = 0
}

fn avail() -> u64 {
    return send - spos
}

fn fail(code: u64) {
    oops = code
}

fn failed() -> bool {
    return oops != E_OK
}

fn ok() -> bool {
    return oops == E_OK
}

fn status() -> u64 {
    return oops
}

fn getbyte() -> u64 {
    if mode == MODE_MEM {
        if spos >= send {
            oops = E_INPUT
            return 0
        }
        let b: u64 = (*((src + spos) as *mut u8)) as u64
        spos = spos + 1
        return b
    }
    if ipos >= ilen {
        let r: u64 = kcall.sys3(kcall.SYS_READ, in_fd, (&ibuf[0 as usize]) as u64, IBUF)
        if errno.is_error(r) {
            oops = E_IO
            return 0
        }
        if r == 0 {
            if oops == E_OK {
                oops = E_INPUT
            }
            return 0
        }
        ipos = 0
        ilen = r
    }
    let v: u64 = ibuf[(ipos) as usize] as u64
    ipos = ipos + 1
    return v
}

fn bits(need: u64) -> u64 {
    while bn < need {
        let b: u64 = getbyte()
        if oops != E_OK {
            return 0
        }
        bp = bp | (b << bn)
        bn = bn + 8
    }
    let v: u64 = bp & ((1 << need) - 1)
    bp = bp >> need
    bn = bn - need
    return v
}

fn setup() {
    if ready == 1 {
        return
    }
    ready = 1
    var b: u64 = 3
    var i: u64 = 0
    while i < 29 {
        var e: u64 = 0
        if i >= 8 {
            e = (i - 4) / 4
        }
        lext[(i) as usize] = e
        lbase[(i) as usize] = b
        b = b + (1 << e)
        i = i + 1
    }
    lbase[(28) as usize] = 258
    lext[(28) as usize] = 0
    b = 1
    i = 0
    while i < 30 {
        var e: u64 = 0
        if i >= 4 {
            e = (i - 2) / 2
        }
        dext[(i) as usize] = e
        dbase[(i) as usize] = b
        b = b + (1 << e)
        i = i + 1
    }
    clorder[0 as usize] = 16
    clorder[1 as usize] = 17
    clorder[2 as usize] = 18
    clorder[3 as usize] = 0
    clorder[4 as usize] = 8
    clorder[5 as usize] = 7
    clorder[6 as usize] = 9
    clorder[7 as usize] = 6
    clorder[8 as usize] = 10
    clorder[9 as usize] = 5
    clorder[10 as usize] = 11
    clorder[11 as usize] = 4
    clorder[12 as usize] = 12
    clorder[13 as usize] = 3
    clorder[14 as usize] = 13
    clorder[15 as usize] = 2
    clorder[16 as usize] = 14
    clorder[17 as usize] = 1
    clorder[18 as usize] = 15
}

fn construct(cnt: u64, sym: u64, from: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < 16 {
        __mmio_write64((cnt + i * 8) as *mut u64, 0)
        i = i + 1
    }
    i = 0
    while i < n {
        let l: u64 = lengths[(from + i) as usize]
        let at: u64 = cnt + l * 8
        __mmio_write64((at) as *mut u64, *((at) as *mut u64) + 1)
        i = i + 1
    }
    if *((cnt) as *mut u64) == n {
        return true
    }
    var left: u64 = 1
    var l: u64 = 1
    while l < 16 {
        left = left * 2
        let c: u64 = *((cnt + l * 8) as *mut u64)
        if c > left {
            return false
        }
        left = left - c
        l = l + 1
    }
    var offs: [u64; 16] = [0 as u64; 16]
    offs[1 as usize] = 0
    l = 1
    while l < 15 {
        offs[(l + 1) as usize] = offs[(l) as usize]
            + *((cnt + l * 8) as *mut u64)
        l = l + 1
    }
    i = 0
    while i < n {
        let ln: u64 = lengths[(from + i) as usize]
        if ln != 0 {
            __mmio_write64((sym + offs[(ln) as usize] * 8) as *mut u64, i)
            offs[(ln) as usize] = offs[(ln) as usize] + 1
        }
        i = i + 1
    }
    return true
}

fn decode(cnt: u64, sym: u64) -> u64 {
    var code: u64 = 0
    var first: u64 = 0
    var index: u64 = 0
    var len: u64 = 1
    while len < 16 {
        code = code | bits(1)
        if oops != E_OK {
            return EOF
        }
        let count: u64 = *((cnt + len * 8) as *mut u64)
        if code - first < count {
            return *((sym + (index + (code - first)) * 8) as *mut u64)
        }
        index = index + count
        first = (first + count) << 1
        code = code << 1
        len = len + 1
    }
    oops = E_FORMAT
    return EOF
}

fn fixed_trees() {
    var i: u64 = 0
    while i < 144 {
        lengths[(i) as usize] = 8
        i = i + 1
    }
    while i < 256 {
        lengths[(i) as usize] = 9
        i = i + 1
    }
    while i < 280 {
        lengths[(i) as usize] = 7
        i = i + 1
    }
    while i < 288 {
        lengths[(i) as usize] = 8
        i = i + 1
    }
    construct((&lcnt[0 as usize]) as u64, (&lsym[0 as usize]) as u64, 0, 288)
    i = 0
    while i < 30 {
        lengths[(i) as usize] = 5
        i = i + 1
    }
    construct((&dcnt[0 as usize]) as u64, (&dsym[0 as usize]) as u64, 0, 30)
}

fn dynamic_trees() -> bool {
    let hlit: u64 = bits(5) + 257
    let hdist: u64 = bits(5) + 1
    let hclen: u64 = bits(4) + 4
    if oops != E_OK {
        return false
    }
    if hlit > 286 || hdist > 30 {
        oops = E_FORMAT
        return false
    }
    var i: u64 = 0
    while i < 19 {
        lengths[(i) as usize] = 0
        i = i + 1
    }
    i = 0
    while i < hclen {
        lengths[(clorder[(i) as usize]) as usize] = bits(3)
        i = i + 1
    }
    if !construct((&lcnt[0 as usize]) as u64, (&lsym[0 as usize]) as u64,
        0, 19) {
        oops = E_FORMAT
        return false
    }
    var have: u64 = 0
    var out: [u64; 320] = [0 as u64; 320]
    while have < hlit + hdist {
        let s: u64 = decode((&lcnt[0 as usize]) as u64,
            (&lsym[0 as usize]) as u64)
        if s == EOF {
            return false
        }
        if s < 16 {
            out[(have) as usize] = s
            have = have + 1
        } else {
            var v: u64 = 0
            var rep: u64 = 0
            if s == 16 {
                if have == 0 {
                    oops = E_FORMAT
                    return false
                }
                v = out[(have - 1) as usize]
                rep = 3 + bits(2)
            } else if s == 17 {
                rep = 3 + bits(3)
            } else {
                rep = 11 + bits(7)
            }
            if oops != E_OK {
                return false
            }
            if have + rep > hlit + hdist {
                oops = E_FORMAT
                return false
            }
            while rep > 0 {
                out[(have) as usize] = v
                have = have + 1
                rep = rep - 1
            }
        }
    }
    i = 0
    while i < hlit + hdist {
        lengths[(i) as usize] = out[(i) as usize]
        i = i + 1
    }
    if !construct((&lcnt[0 as usize]) as u64, (&lsym[0 as usize]) as u64,
        0, hlit) {
        oops = E_FORMAT
        return false
    }
    if !construct((&dcnt[0 as usize]) as u64, (&dsym[0 as usize]) as u64,
        hlit, hdist) {
        oops = E_FORMAT
        return false
    }
    return true
}

fn symbol() -> u64 {
    return decode((&lcnt[0 as usize]) as u64, (&lsym[0 as usize]) as u64)
}

fn length_of(s: u64) -> u64 {
    let li: u64 = s - 257
    if li >= 29 {
        oops = E_FORMAT
        return 0
    }
    return lbase[(li) as usize] + bits(lext[(li) as usize])
}

fn dist() -> u64 {
    let ds: u64 = decode((&dcnt[0 as usize]) as u64, (&dsym[0 as usize]) as u64)
    if ds == EOF || ds >= 30 {
        oops = E_FORMAT
        return 0
    }
    let d: u64 = dbase[(ds) as usize] + bits(dext[(ds) as usize])
    if oops != E_OK {
        return 0
    }
    return d
}

fn len_base(i: u64) -> u64 {
    return lbase[(i) as usize]
}

fn len_extra(i: u64) -> u64 {
    return lext[(i) as usize]
}

fn dist_base(i: u64) -> u64 {
    return dbase[(i) as usize]
}

fn dist_extra(i: u64) -> u64 {
    return dext[(i) as usize]
}
