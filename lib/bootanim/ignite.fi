profile kernel

import bootanim.fx
import bootanim.canvas
import bootanim.logo
import bootanim.glow

export { render }

const SPARK_MS: i64 = 500
const TRACE_START: i64 = 300
const TRACE_MS: i64 = 1400
const FILL_START: i64 = 1500
const FILL_MS: i64 = 800
const PULSE_START: i64 = 2000
const PULSE_MS: i64 = 900
const HEAD_BAND: i64 = 56
const LINE: u64 = 0x7FD8FF
const HOT: u64 = 0xFFFFFF
const AURA: u64 = 0x2E6BFF

fn trace_px(cv: u64, x: i64, y: i64, sweep: i64, line_k: i64) -> i64 {
    let e: i64 = logo.edge(cv, x, y)
    if e == 0 {
        return 0
    }
    let dw: i64 = (*((cv + canvas.CV_LW) as *mut u64)) as i64
    let dh: i64 = (*((cv + canvas.CV_LH) as *mut u64)) as i64
    let a: i64 = fx.angle(x - dw / 2, y - dh / 2)
    if a > sweep {
        return 0
    }
    let head: i64 = fx.clamp(HEAD_BAND - (sweep - a), 0, HEAD_BAND) * fx.ONE / HEAD_BAND
    return e * (line_k + head) / 255
}

fn trace(cv: u64, cx: i64, cy: i64, sweep: i64, line_k: i64) {
    let dw: i64 = (*((cv + canvas.CV_LW) as *mut u64)) as i64
    let dh: i64 = (*((cv + canvas.CV_LH) as *mut u64)) as i64
    var y: i64 = 0
    while y < dh {
        var x: i64 = 0
        while x < dw {
            let k: i64 = trace_px(cv, x, y, sweep, line_k)
            canvas.add(cv, cx - dw / 2 + x, cy - dh / 2 + y, LINE, k)
            x = x + 1
        }
        y = y + 1
    }
}

fn head_spark(cv: u64, cx: i64, cy: i64, sweep: i64) {
    if sweep <= 0 || sweep >= fx.TURN {
        return
    }
    let r: i64 = canvas.unit(cv, 80)
    let hx: i64 = cx + fx.sin12(sweep) * r / fx.ONE
    let hy: i64 = cy - fx.cos12(sweep) * r / fx.ONE
    glow.glow(cv, glow.at(hx, hy), canvas.unit(cv, 22), canvas.unit(cv, 22), glow.paint(HOT, 3000))
}

fn render(cv: u64, t: i64, p: i64) {
    let cx: i64 = canvas.width(cv) / 2
    let cy: i64 = canvas.height(cv) / 2
    canvas.fill_rows(cv, 0, canvas.height(cv), 0)
    let spark: i64 = fx.span(t, 0, SPARK_MS)
    let fade: i64 = fx.ONE - fx.span(t, FILL_START, FILL_MS)
    let rs: i64 = canvas.unit(cv, 20) + canvas.unit(cv, 120) * spark / fx.ONE
    glow.glow(cv, glow.at(cx, cy), rs, rs, glow.paint(0xA8D8FF, spark * fade / fx.ONE))
    let pk: i64 = fx.span(t, PULSE_START, 400) * (2200 + 1900 * fx.pulse(t - PULSE_START, PULSE_MS) / fx.ONE) / fx.ONE
    glow.glow(cv, glow.at(cx, cy), canvas.unit(cv, 300), canvas.unit(cv, 300), glow.paint(AURA, pk))
    let sweep: i64 = fx.smooth(fx.span(t, TRACE_START, TRACE_MS)) * fx.TURN / fx.ONE
    let fill: i64 = fx.smooth(fx.span(t, FILL_START, FILL_MS))
    logo.draw(cv, cx, cy, fill, 0)
    trace(cv, cx, cy, sweep, fx.ONE - fill * 3 / 4)
    head_spark(cv, cx, cy, sweep)
}
