profile kernel

import bootanim.fx
import bootanim.canvas
import bootanim.glow
import bootanim.rings

export { PHASES, COOL, WARM, phase, draw }

const PHASES: i64 = 4
const COOL: u64 = 0
const WARM: u64 = 1
const BASE_REF: i64 = 150
const STEP_REF: i64 = 44
const STAGGER_MS: i64 = 150
const APPEAR_MS: i64 = 500
const SPIN_BASE_MS: i64 = 2400
const SPIN_STEP_MS: i64 = 700
const TRACK_LEVEL: i64 = 700

fn phase(p: i64, k: i64) -> i64 {
    return fx.clamp(p * PHASES - k * fx.ONE, 0, fx.ONE)
}

fn color(pal: u64, k: i64) -> u64 {
    if pal == WARM {
        return pick4(k, 0xFF8A50, 0xFFB060, 0xFFE0A0, 0xFFD080)
    }
    return pick4(k, 0x3A8BFF, 0x30D5FF, 0x3FFFC0, 0xFFB050)
}

fn pick4(k: i64, a: u64, b: u64, c: u64, d: u64) -> u64 {
    if k == 0 {
        return a
    }
    if k == 1 {
        return b
    }
    if k == 2 {
        return c
    }
    return d
}

fn one(cv: u64, center16: u64, t: i64, p: i64, pal: u64, k: i64) {
    let appear: i64 = fx.smooth(fx.span(t, k * STAGGER_MS, APPEAR_MS))
    if appear <= 0 {
        return
    }
    let h: i64 = canvas.height(cv)
    let r16: i64 = (BASE_REF + STEP_REF * k) * h * 16 / 1080 * (3 * fx.ONE + appear) / (4 * fx.ONE)
    let w16: i64 = fx.clamp((26 - 4 * k) * h / 1080, 8, 26 * h / 1080 + 8)
    var dir: i64 = 1
    if k % 2 == 1 {
        dir = 0 - 1
    }
    let start: i64 = dir * t * fx.TURN / (SPIN_BASE_MS + SPIN_STEP_MS * k)
    let len: i64 = phase(p, k) * fx.TURN / fx.ONE
    let c: u64 = color(pal, k)
    rings.ring(cv, rings.shape(r16, w16), rings.arc(start, len), glow.paint(c, TRACK_LEVEL * appear / fx.ONE), glow.paint(c, appear), center16)
}

fn draw(cv: u64, cx: i64, cy: i64, t: i64, p: i64, pal: u64) {
    let center16: u64 = ((cx * 16) as u64) | (((cy * 16) as u64) << 32)
    var k: i64 = 0
    while k < PHASES {
        one(cv, center16, t, p, pal, k)
        k = k + 1
    }
}
