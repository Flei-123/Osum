profile kernel

import bootanim.fx
import bootanim.canvas
import bootanim.glow

export { horizon, warmth, draw, sun_glow }

const HORIZON_NUM: i64 = 64
const NIGHT_TOP: u64 = 0x02040B
const DAWN_TOP: u64 = 0x101C3A
const NIGHT_LOW: u64 = 0x0A1430
const DUSK_LOW: u64 = 0x5A2C5E
const SUN_LOW: u64 = 0xF2893A
const SEA_NIGHT: u64 = 0x060A16
const SEA_WARM: u64 = 0x3A2238
const SEA_FLOOR: u64 = 0x020308
const GLOW_CORE: u64 = 0xFFB060
const GLOW_HALO: u64 = 0xC0507A

fn horizon(cv: u64) -> i64 {
    return canvas.height(cv) * HORIZON_NUM / 100
}

fn warmth(p: i64) -> i64 {
    return fx.smooth(p)
}

fn low_color(p: i64) -> u64 {
    let w: i64 = warmth(p)
    if w < fx.ONE / 2 {
        return canvas.mix(NIGHT_LOW, DUSK_LOW, w * 2)
    }
    return canvas.mix(DUSK_LOW, SUN_LOW, w * 2 - fx.ONE)
}

fn draw(cv: u64, p: i64) {
    let hy: i64 = horizon(cv)
    let top: u64 = canvas.mix(NIGHT_TOP, DAWN_TOP, warmth(p))
    canvas.row_gradient(cv, 0, hy, top, low_color(p))
    let sea_top: u64 = canvas.mix(SEA_NIGHT, SEA_WARM, warmth(p))
    canvas.row_gradient(cv, hy, canvas.height(cv), sea_top, SEA_FLOOR)
}

fn sun_glow(cv: u64, p: i64, cx: i64) {
    let hy: i64 = horizon(cv)
    let w: i64 = warmth(p)
    let rx: i64 = canvas.width(cv) * (300 + 400 * w / fx.ONE) / 1000
    let ry: i64 = canvas.height(cv) * (120 + 200 * w / fx.ONE) / 1000
    glow.glow(cv, glow.at(cx, hy), rx, ry, glow.paint(GLOW_HALO, 1400 + 1800 * w / fx.ONE))
    glow.glow(cv, glow.at(cx, hy), rx / 3, ry / 3, glow.paint(GLOW_CORE, 600 + 3000 * w / fx.ONE))
    glow.streak(cv, glow.at(cx, hy), rx, canvas.unit(cv, 3), glow.paint(GLOW_CORE, 1500 * w / fx.ONE))
}
