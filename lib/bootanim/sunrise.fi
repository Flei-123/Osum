profile kernel

import bootanim.fx
import bootanim.canvas
import bootanim.logo
import bootanim.sky
import bootanim.glow

export { render, rise_y, reflect }

const RISE_START: i64 = 200
const RISE_MS: i64 = 2600
const LAND_NUM: i64 = 40
const WARM_TINT: u64 = 0xFFB070
const REFLECT_K: i64 = 1300
const WAVE_MS: i64 = 900

fn rise(t: i64, p: i64) -> i64 {
    let by_time: i64 = fx.span(t, RISE_START, RISE_MS)
    let by_boot: i64 = fx.clamp(p * 5 / 4, 0, fx.ONE)
    return fx.ease_out(fx.clamp(by_time, 0, by_boot))
}

fn rise_y(cv: u64, k: i64) -> i64 {
    let dh: i64 = (*((cv + canvas.CV_LH) as *mut u64)) as i64
    let start: i64 = sky.horizon(cv) + dh / 2 + canvas.unit(cv, 8)
    let land: i64 = canvas.height(cv) * LAND_NUM / 100
    return fx.lerp(start, land, k)
}

fn reflect(cv: u64, cx: i64, ly: i64, t: i64, k: i64) {
    let dw: i64 = (*((cv + canvas.CV_LW) as *mut u64)) as i64
    let dh: i64 = (*((cv + canvas.CV_LH) as *mut u64)) as i64
    let hy: i64 = sky.horizon(cv)
    let depth: i64 = fx.clamp(canvas.height(cv) - hy, 1, canvas.height(cv))
    var y: i64 = 0
    while y < dh {
        let sy: i64 = ly - dh / 2 + y
        let ry: i64 = 2 * hy - sy
        if sy < hy && ry < canvas.height(cv) {
            let wave: i64 = fx.sin12(ry * 24 + t * fx.TURN / WAVE_MS) * canvas.unit(cv, 4) / fx.ONE
            let fade: i64 = k * (fx.ONE - fx.clamp((ry - hy) * fx.ONE * 3 / depth, 0, fx.ONE)) / fx.ONE
            var x: i64 = 0
            while x < dw {
                let a: i64 = logo.alpha(cv, x, y)
                canvas.add(cv, cx - dw / 2 + x + wave, ry, WARM_TINT, a * fade / 255)
                x = x + 1
            }
        }
        y = y + 1
    }
}

fn render(cv: u64, t: i64, p: i64) {
    let cx: i64 = canvas.width(cv) / 2
    let r: i64 = rise(t, p)
    let ly: i64 = rise_y(cv, r)
    sky.draw(cv, r)
    sky.sun_glow(cv, r, cx)
    glow.glow(cv, glow.at(cx, ly), canvas.unit(cv, 190), canvas.unit(cv, 190), glow.paint(WARM_TINT, 1800))
    let tint: u64 = WARM_TINT | (((140 * (fx.ONE - r) / fx.ONE) as u64) << 24)
    logo.draw_masked(cv, cx, ly, fx.ONE, tint, sky.horizon(cv))
    reflect(cv, cx, ly, t, REFLECT_K)
}
