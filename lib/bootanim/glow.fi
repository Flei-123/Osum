profile kernel

import bootanim.fx
import bootanim.canvas

export { paint, at, glow, streak }

fn paint(c: u64, k: i64) -> u64 {
    return (c & 0xFFFFFF) | ((fx.clamp(k, 0, 0xFFFFFF) as u64) << 32)
}

fn at(x: i64, y: i64) -> u64 {
    return ((x + 0x40000000) as u64) | (((y + 0x40000000) as u64) << 32)
}

fn px(p: u64) -> i64 {
    return ((p & 0xFFFFFFFF) as i64) - 0x40000000
}

fn py(p: u64) -> i64 {
    return ((p >> 32) as i64) - 0x40000000
}

fn falloff(q: i64) -> i64 {
    let inv: i64 = fx.ONE - q
    return inv * inv / fx.ONE
}

fn glow_row(cv: u64, y: i64, cx: i64, rx: i64, qy: i64, pt: u64) {
    let half: i64 = rx * fx.isqrt((fx.ONE - qy) * fx.ONE) / fx.ONE
    let x0: i64 = fx.clamp(cx - half, 0, canvas.width(cv))
    let x1: i64 = fx.clamp(cx + half + 1, 0, canvas.width(cv))
    let kx: i64 = (fx.ONE << 20) / (rx * rx)
    let k: i64 = (pt >> 32) as i64
    let c: u64 = pt & 0xFFFFFF
    var x: i64 = x0
    while x < x1 {
        let dx: i64 = x - cx
        let q: i64 = qy + ((dx * dx * kx) >> 20)
        if q < fx.ONE {
            canvas.add(cv, x, y, c, falloff(q) * k / fx.ONE)
        }
        x = x + 1
    }
}

fn glow(cv: u64, center: u64, rx: i64, ry: i64, pt: u64) {
    let k: i64 = (pt >> 32) as i64
    if rx <= 0 || ry <= 0 || k <= 0 {
        return
    }
    let cx: i64 = px(center)
    let cy: i64 = py(center)
    let y0: i64 = fx.clamp(cy - ry, 0, canvas.height(cv))
    let y1: i64 = fx.clamp(cy + ry, 0, canvas.height(cv))
    var y: i64 = y0
    while y < y1 {
        let dy: i64 = y - cy
        let qy: i64 = dy * dy * fx.ONE / (ry * ry)
        if qy < fx.ONE {
            glow_row(cv, y, cx, rx, qy, pt)
        }
        y = y + 1
    }
}

fn streak(cv: u64, center: u64, len: i64, thick: i64, pt: u64) {
    glow(cv, center, len, thick, pt)
    glow(cv, center, len / 4, thick * 3, paint(pt, ((pt >> 32) as i64) / 2))
}
