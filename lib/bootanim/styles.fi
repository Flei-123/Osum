profile kernel

import bootanim.fx
import bootanim.canvas
import bootanim.ignite
import bootanim.sunrise
import bootanim.swarm
import bootanim.reactor
import bootanim.mix

export { NONE, IGNITE, SUNRISE, PARTICLES, REACTOR, MIX, DEFAULT_STYLE, COUNT, name_word, from_word, parse, frame }

const NONE: u64 = 0
const IGNITE: u64 = 1
const SUNRISE: u64 = 2
const PARTICLES: u64 = 3
const REACTOR: u64 = 4
const MIX: u64 = 5
const COUNT: u64 = 5
const DEFAULT_STYLE: u64 = 5
const WORD_NONE: u64 = 0x656E6F6E
const WORD_SPINNER: u64 = 0x72656E6E697073
const WORD_IGNITE: u64 = 0x6574696E6769
const WORD_SUNRISE: u64 = 0x657369726E7573
const WORD_PARTICLE: u64 = 0x656C636974726170
const WORD_REACTOR: u64 = 0x726F7463616572
const WORD_MIX: u64 = 0x78696D
const WORD_MAX: u64 = 8

fn name_word(id: u64) -> u64 {
    if id == IGNITE {
        return WORD_IGNITE
    }
    if id == SUNRISE {
        return WORD_SUNRISE
    }
    if id == PARTICLES {
        return WORD_PARTICLE
    }
    if id == REACTOR {
        return WORD_REACTOR
    }
    if id == MIX {
        return WORD_MIX
    }
    return WORD_SPINNER
}

fn from_word(w: u64) -> u64 {
    var id: u64 = 1
    while id <= COUNT {
        if name_word(id) == w {
            return id
        }
        id = id + 1
    }
    if w == WORD_NONE || w == WORD_SPINNER {
        return NONE
    }
    return DEFAULT_STYLE
}

fn is_name_byte(b: u64) -> bool {
    return (b >= 97 && b <= 122) || (b >= 48 && b <= 57)
}

fn parse(p: u64) -> u64 {
    if p == 0 {
        return DEFAULT_STYLE
    }
    var w: u64 = 0
    var i: u64 = 0
    while i < WORD_MAX && is_name_byte((*((p + i) as *mut u8)) as u64) {
        w = w | (((*((p + i) as *mut u8)) as u64) << (i * 8))
        i = i + 1
    }
    if i == WORD_MAX && is_name_byte((*((p + i) as *mut u8)) as u64) {
        return DEFAULT_STYLE
    }
    return from_word(w)
}

fn render(cv: u64, id: u64, t: i64, p: i64) {
    if id == IGNITE {
        ignite.render(cv, t, p)
        return
    }
    if id == SUNRISE {
        sunrise.render(cv, t, p)
        return
    }
    if id == PARTICLES {
        swarm.render(cv, t, p)
        return
    }
    if id == REACTOR {
        reactor.render(cv, t, p)
        return
    }
    mix.render(cv, t, p)
}

fn frame(cv: u64, id: u64, t: i64, p: i64, fade: i64) {
    render(cv, id, t, fx.clamp(p, 0, fx.ONE))
    canvas.crossfade(cv, fade)
}
