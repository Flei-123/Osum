profile kernel

import bootanim.fx
import bootanim.canvas
import bootanim.logo
import bootanim.glow
import bootanim.sky
import bootanim.sunrise
import bootanim.phasering

export { render }

const LIFT_MS: i64 = 1800
const LIFT_START_NUM: i64 = 48
const LAND_NUM: i64 = 40
const WARM_TINT: u64 = 0xFFC080

fn render(cv: u64, t: i64, p: i64) {
    let cx: i64 = canvas.width(cv) / 2
    let h: i64 = canvas.height(cv)
    let lift: i64 = fx.ease_out(fx.span(t, 0, LIFT_MS))
    let ly: i64 = fx.lerp(h * LIFT_START_NUM / 100, h * LAND_NUM / 100, lift)
    let warm: i64 = fx.clamp(p * 9 / 10 + lift / 10, 0, fx.ONE)
    sky.draw(cv, warm)
    sky.sun_glow(cv, warm, cx)
    glow.glow(cv, glow.at(cx, ly), canvas.unit(cv, 200), canvas.unit(cv, 200), glow.paint(WARM_TINT, 1500))
    phasering.draw(cv, cx, ly, t, p, phasering.WARM)
    logo.draw_masked(cv, cx, ly, fx.smooth(fx.span(t, 0, 500)), 0, sky.horizon(cv))
    sunrise.reflect(cv, cx, ly, t, 900)
}
