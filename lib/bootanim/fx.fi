profile kernel

export { ONE, TURN, clamp, span, sin12, cos12, isqrt, angle, ease_out, smooth, hash, lerp, pulse }

const ONE: i64 = 4096
const TURN: i64 = 1024
const HALF_TURN: i64 = 512
const QUARTER_TURN: i64 = 256
const BHASKARA_DEN: i64 = 1310720
const ATAN_LINEAR: i64 = 128
const ATAN_BEND: i64 = 45

fn clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn span(t: i64, start: i64, length: i64) -> i64 {
    if length <= 0 {
        return ONE
    }
    return clamp((t - start) * ONE / length, 0, ONE)
}

fn lerp(a: i64, b: i64, k: i64) -> i64 {
    return a + (b - a) * k / ONE
}

fn sin12(a: i64) -> i64 {
    var u: i64 = a % TURN
    if u < 0 {
        u = u + TURN
    }
    var sign: i64 = 1
    if u >= HALF_TURN {
        u = u - HALF_TURN
        sign = 0 - 1
    }
    let q: i64 = u * (HALF_TURN - u)
    return sign * (16 * ONE * q / (BHASKARA_DEN - 4 * q))
}

fn cos12(a: i64) -> i64 {
    return sin12(a + QUARTER_TURN)
}

fn pulse(t: i64, period: i64) -> i64 {
    return (ONE + sin12(t * TURN / period)) / 2
}

fn isqrt(v: i64) -> i64 {
    if v <= 0 {
        return 0
    }
    var x: u64 = v as u64
    var r: u64 = 0
    var bit: u64 = 1 << 62
    while bit > x {
        bit = bit >> 2
    }
    while bit != 0 {
        if x >= r + bit {
            x = x - r - bit
            r = (r >> 1) + bit
        } else {
            r = r >> 1
        }
        bit = bit >> 2
    }
    return r as i64
}

fn octant(a: i64, b: i64) -> i64 {
    let r: i64 = a * ONE / b
    return (ATAN_LINEAR * r + ATAN_BEND * r * (ONE - r) / ONE) / ONE
}

fn angle(dx: i64, dy: i64) -> i64 {
    if dx == 0 && dy == 0 {
        return 0
    }
    let ax: i64 = clamp(dx, 0, dx) + clamp(0 - dx, 0, 0 - dx)
    let ay: i64 = clamp(dy, 0, dy) + clamp(0 - dy, 0, 0 - dy)
    var a: i64 = 0
    if ax >= ay {
        a = octant(ay, ax)
    } else {
        a = QUARTER_TURN - octant(ax, ay)
    }
    if dx < 0 {
        a = HALF_TURN - a
    }
    if dy < 0 {
        a = TURN - a
    }
    return (a + QUARTER_TURN) % TURN
}

fn ease_out(k: i64) -> i64 {
    let inv: i64 = ONE - clamp(k, 0, ONE)
    return ONE - inv * inv / ONE * inv / ONE
}

fn smooth(k: i64) -> i64 {
    let c: i64 = clamp(k, 0, ONE)
    return c * c / ONE * (3 * ONE - 2 * c) / ONE
}

fn hash(v: u64) -> u64 {
    var x: u64 = (v + 0x9E3779B9) & 0xFFFFFFFF
    x = ((x ^ (x >> 16)) *% 0x45D9F3B) & 0xFFFFFFFF
    x = ((x ^ (x >> 16)) *% 0x45D9F3B) & 0xFFFFFFFF
    return x ^ (x >> 16)
}
