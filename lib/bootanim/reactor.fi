profile kernel

import bootanim.fx
import bootanim.canvas
import bootanim.logo
import bootanim.glow
import bootanim.phasering

export { render }

const BG: u64 = 0x03060D
const HALO: u64 = 0x0A1A3A
const CORE: u64 = 0x2A6CFF
const CORE_PULSE_MS: i64 = 1100

fn render(cv: u64, t: i64, p: i64) {
    let cx: i64 = canvas.width(cv) / 2
    let cy: i64 = canvas.height(cv) / 2
    canvas.fill_rows(cv, 0, canvas.height(cv), BG)
    glow.glow(cv, glow.at(cx, cy), canvas.width(cv) * 6 / 10, canvas.height(cv) * 6 / 10, glow.paint(HALO, 3400))
    let core: i64 = 1400 + 1400 * fx.pulse(t, CORE_PULSE_MS) / fx.ONE
    glow.glow(cv, glow.at(cx, cy), canvas.unit(cv, 150), canvas.unit(cv, 150), glow.paint(CORE, core))
    phasering.draw(cv, cx, cy, t, p, phasering.COOL)
    logo.draw(cv, cx, cy, fx.smooth(fx.span(t, 0, 400)), 0)
}
