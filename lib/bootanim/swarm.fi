profile kernel

import bootanim.fx
import bootanim.canvas
import bootanim.logo
import bootanim.glow
import bootanim.particles

export { render }

const BG: u64 = 0x020308
const NEBULA: u64 = 0x0C1A40
const LOGO_START: i64 = 1700
const LOGO_MS: i64 = 600
const SPARK_END: i64 = 2000
const SPARK_FADE_MS: i64 = 800
const FLARE_START: i64 = 1500
const FLARE_RISE_MS: i64 = 300
const FLARE_FALL_START: i64 = 1900
const FLARE_FALL_MS: i64 = 1000
const FLARE_PEAK: i64 = 3400

fn render(cv: u64, t: i64, p: i64) {
    let cx: i64 = canvas.width(cv) / 2
    let cy: i64 = canvas.height(cv) / 2
    canvas.fill_rows(cv, 0, canvas.height(cv), BG)
    glow.glow(cv, glow.at(cx, cy), canvas.width(cv) / 2, canvas.height(cv) / 2, glow.paint(NEBULA, 3000))
    let lf: i64 = fx.smooth(fx.span(t, LOGO_START, LOGO_MS))
    glow.glow(cv, glow.at(cx, cy), canvas.unit(cv, 240), canvas.unit(cv, 240), glow.paint(0x2C60FF, lf * 2 / 3))
    logo.draw(cv, cx, cy, lf, 0)
    particles.draw(cv, t, fx.ONE - fx.span(t, SPARK_END, SPARK_FADE_MS))
    let fk: i64 = fx.span(t, FLARE_START, FLARE_RISE_MS) * (fx.ONE - fx.span(t, FLARE_FALL_START, FLARE_FALL_MS)) / fx.ONE
    particles.flare(cv, fk * FLARE_PEAK / fx.ONE)
}
