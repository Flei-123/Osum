// SPDX-License-Identifier: GPL-2.0-only
// lib/spirv/layout.fi -- struct member and array layout decorations of a parsed SPIR-V module (Offset, BuiltIn, ArrayStride).
// Queries scan the instruction list; the shaders handled here are small.

import std.rt
import spirv.spv
import spirv.parse

export { member_offset, member_builtin, array_stride, array_length, NONE }

const NONE: u32 = 0xFFFFFFFF
const DEC_ARRAYSTRIDE: u32 = 6
const DEC_BUILTIN: u32 = 11
const DEC_OFFSET: u32 = 35

fn member_dec(m: *mut parse.Module, st: u32, member: u32, dec: u32) -> u32 {
    var i: usize = 0
    while i < (*m).ninst {
        let p: usize = parse.inst_pos(m, i)
        if parse.op_at(m, p) == spv.OP_MEMBERDECORATE && parse.wc_at(m, p) >= 5 {
            if parse.w32(m, p + 1) == st && parse.w32(m, p + 2) == member && parse.w32(m, p + 3) == dec {
                return parse.w32(m, p + 4)
            }
        }
        i = i + 1
    }
    return NONE
}

fn member_offset(m: *mut parse.Module, st: u32, member: u32) -> u32 {
    return member_dec(m, st, member, DEC_OFFSET)
}

fn member_builtin(m: *mut parse.Module, st: u32, member: u32) -> u32 {
    return member_dec(m, st, member, DEC_BUILTIN)
}

fn array_stride(m: *mut parse.Module, arr: u32) -> u32 {
    var i: usize = 0
    while i < (*m).ninst {
        let p: usize = parse.inst_pos(m, i)
        if parse.op_at(m, p) == spv.OP_DECORATE && parse.wc_at(m, p) >= 4 {
            if parse.w32(m, p + 1) == arr && parse.w32(m, p + 2) == DEC_ARRAYSTRIDE { return parse.w32(m, p + 3) }
        }
        i = i + 1
    }
    return 0
}

fn array_length(m: *mut parse.Module, arr: u32) -> u32 {
    if parse.def_op(m, arr) != spv.OP_TYPEARRAY { return 0 }
    return parse.const_word(m, parse.w32(m, parse.def_pos(m, arr) + 3))
}
